package: {
    name: "core.db"
    version: "0.0.1"
    edition: "2026"
    description: "SQL connections, pools, and migrations."
    license: "MIT"
    outputs: {
        db: .Library{ entry: db }
    }
}

use {
    core: core
    // core.db is plain Core source over the Jet SQLite engine: the private
    // driver below holds the only engine connection, and connections,
    // scopes, row policies, pools and migrations are ordinary Jet values.
    prep: __core_db_prepare
    api: __core_db_vdbeapi
    conn: __core_db_conn
    base: __core_db_base
    os: __core_db_os
    math: core.math
    time: core.time
    rt: jet.runtime.time
    encoding: core.encoding
    core.encoding.[Dyn]
    stream: __core_encoding_stream
    json: core.encoding.json
    // A typed table's `query` is a data query over its rows.
    data: core.data
    core.data.[Query]
    // DBScope.live bindings share app's process-wide live registry.
    app
    app.[Live]
    // A row policy is asked as an account by its id.
    auth: core.auth
}

// core.db owns its SQL values, typed row selection and conversion. The private
// SQLite driver alone holds the engine connection; fallible row reads use DBError.

#Equatable
DBValue: enum {
    Null,
    Int(Int),
    Float(Float),
    Text(String),
    Bool(Bool),
    Blob([U8]),

    impl Display {
        display: fn(self) -> String { render_value(self) }
    }

    is_null: fn(self) -> Bool Never! {
        if self == .Null -> return true
        false
    }

    int: fn(self) -> Int Err! {
        if self == .Int(number) -> return Ok(number)
        Err("expected an int, got {render_value(self)}")
    }

    float: fn(self) -> Float Err! {
        if self == {
            .Float(number) -> Ok(number)
            .Int(number) -> Ok(Float{number})
            .Null | .Text(_) | .Bool(_) | .Blob(_) -> Err("expected a float, got {render_value(self)}")
        }
    }

    text: fn(self) -> String Err! {
        if self == .Text(text) -> return Ok(text.copy())
        Err("expected text, got {render_value(self)}")
    }

    bool: fn(self) -> Bool Err! {
        if self == {
            .Bool(value) -> Ok(value)
            .Int(number) -> {
                if number == 0 -> return Ok(false)
                if number == 1 -> return Ok(true)
                Err("expected a bool, got {render_value(self)}")
            }
            .Null | .Float(_) | .Text(_) | .Blob(_) -> Err("expected a bool, got {render_value(self)}")
        }
    }

    blob: fn(self) -> [U8] Err! {
        if self == .Blob(bytes) -> return Ok(bytes.copy())
        Err("expected a blob, got {render_value(self)}")
    }
}

#Equatable
priv PoolLifecycle: enum {
    Open,
    Draining,
    Drained,
}

// Receipts have always been opaque public values: the pool produces them;
// source owns their exact counters, equality and textual projection.
#Equatable
DBPoolReceipt: struct {
    lifecycle: PoolLifecycle,
    max: Int,
    available: Int,
    leased: Int,
    opening: Int,
    ready: Bool,
    acquires: Int,
    releases: Int,
    timeouts: Int,
    open_failures: Int,
    unhealthy: Int,
    replacements: Int,
    replacement_failures: Int,

    impl Display {
        display: fn(self) -> String { pool_receipt_text(self) }
    }

    impl Debug {
        debug: fn(&&self) -> String { pool_receipt_text(self) }
    }
}

pool_receipt_text: fn(receipt: DBPoolReceipt) -> String Never! {
    lifecycle: if receipt.lifecycle == {
        .Open -> "open"
        .Draining -> "draining"
        .Drained -> "drained"
    }
    ready: if receipt.ready -> 1 else -> 0
    "db.pool lifecycle={lifecycle} max={receipt.max} available={receipt.available} leased={receipt.leased} opening={receipt.opening} ready={ready} acquires={receipt.acquires} releases={receipt.releases} timeouts={receipt.timeouts} open_failures={receipt.open_failures} unhealthy={receipt.unhealthy} replacements={receipt.replacements} replacement_failures={receipt.replacement_failures}"
}

#Test("pool receipt text keeps every counter and lifecycle spelling") {
    receipt := DBPoolReceipt{
        lifecycle: .Open,
        max: 2,
        available: 1,
        leased: 0,
        opening: 1,
        ready: true,
        acquires: 3,
        releases: 4,
        timeouts: 5,
        open_failures: 6,
        unhealthy: 7,
        replacements: 8,
        replacement_failures: 9,
    }
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=open max=2 available=1 leased=0 opening=1 ready=1 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
    receipt.lifecycle = .Draining
    receipt.ready = false
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=draining max=2 available=1 leased=0 opening=1 ready=0 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
    receipt.lifecycle = .Drained
    assert_eq(pool_receipt_text(receipt), "db.pool lifecycle=drained max=2 available=1 leased=0 opening=1 ready=0 acquires=3 releases=4 timeouts=5 open_failures=6 unhealthy=7 replacements=8 replacement_failures=9")
}

// A database operation's failure. `Failed` carries the engine's or the API's
// message; `Exists` is `Table.add` finding a row that holds the key already,
// one the caller may read; `Denied` is a table's row policy refusing a write,
// or `Table.add` finding the key in a row the caller may not read.
#[Error, Equatable]
DBError: enum {
    Failed(String),
    Exists,
    Denied,

    // The failure in one line.
    message: fn(self) -> String {
        if self == {
            .Failed(text) -> text.copy()
            .Exists -> "a row with that key exists"
            .Denied -> "the table's row policy refused this write"
        }
    }

    impl Display {
        display: fn(self) -> String { self.message() }
    }

    impl Debug {
        debug: fn(&&self) -> String { self.message() }
    }
}

impl DBError -> Err { Err(self.message()) }

row_value: fn(row: [String:DBValue], column: String) -> DBValue DBError! {
    value: row.get(column) ?? return Err(db_error("missing column `{column}`"))
    Ok(value)
}

row_int: fn(row: [String:DBValue], column: String) -> Int DBError! {
    value: row_value(row, column)
    if value == {
        .Int(number) -> Ok(number)
        .Null | .Float(_) | .Text(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected an int, got {render_value(value)}"))
    }
}

row_float: fn(row: [String:DBValue], column: String) -> Float DBError! {
    value: row_value(row, column)
    if value == {
        .Float(number) -> Ok(number)
        .Int(number) -> Ok(Float{number})
        .Null | .Text(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected a float, got {render_value(value)}"))
    }
}

row_text: fn(row: [String:DBValue], column: String) -> String DBError! {
    value: row_value(row, column)
    if value == {
        .Text(text) -> Ok(text)
        .Null | .Int(_) | .Float(_) | .Bool(_) | .Blob(_) -> Err(db_error("expected text, got {render_value(value)}"))
    }
}

row_bool: fn(row: [String:DBValue], column: String) -> Bool DBError! {
    value: row_value(row, column)
    if value == {
        .Bool(boolean) -> Ok(boolean)
        .Int(number) -> {
            if number == 0 -> return Ok(false)
            if number == 1 -> return Ok(true)
            Err(db_error("expected a bool, got {number}"))
        }
        .Null | .Float(_) | .Text(_) | .Blob(_) -> Err(db_error("expected a bool, got {render_value(value)}"))
    }
}

render_value: fn(value: DBValue) -> String Never! {
    if value == {
        .Null -> "null"
        .Int(number) -> "{number}"
        .Float(number) -> __float_text(number)
        .Text(text) -> text
        .Bool(boolean) -> "{boolean}"
        .Blob(bytes) -> "{bytes}"
    }
}

// SQL values use the shortest decimal f64 display spelling, not Jet's debug
// spelling (which preserves ".0" and may use an exponent).
__float_text: fn(value: Float) -> String Never! {
    text: "{value}"
    raw: text.bytes()
    exponent_at := -1
    dot_at := -1
    loop i in 0..<raw.len() {
        if raw[i] == (U8{101}) -> exponent_at = i
        if raw[i] == (U8{46}) -> dot_at = i
    }
    if exponent_at < 0 {
        if raw.len() >= 2 && raw[raw.len() - 2] == (U8{46}) && raw[raw.len() - 1] == (U8{48}) {
            out := [U8]{}
            loop i in 0..<raw.len() - 2 -> out.push(raw[i])
            return String.from_bytes(out) ?? panic("decimal float text must be UTF-8")
        }
        return text
    }
    exponent := 0
    at := exponent_at + 1
    negative: raw[at] == (U8{45})
    if negative || raw[at] == (U8{43}) -> at += 1
    loop at < raw.len() {
        exponent = exponent * 10 + Int{raw[at]} - 48
        at += 1
    }
    if negative -> exponent = 0 - exponent
    start: if raw[0] == (U8{45}) -> 1 else -> 0
    point: if dot_at >= 0 -> dot_at - start else -> exponent_at - start
    count := exponent_at - start
    if dot_at >= 0 -> count -= 1
    end := exponent_at
    loop end > start && raw[end - 1] == (U8{48}) {
        end -= 1
        count -= 1
    }
    decimal: point + exponent
    out := [U8]{}
    if start == 1 -> out.push(U8{45})
    if decimal <= 0 {
        out.push(U8{48})
        out.push(U8{46})
        loop _ in 0..<0 - decimal -> out.push(U8{48})
    }
    loop digit in 0..<count {
        if decimal > 0 && digit == decimal -> out.push(U8{46})
        index := start + digit
        if dot_at >= 0 && index >= dot_at -> index += 1
        out.push(raw[index])
    }
    loop _ in count..<decimal -> out.push(U8{48})
    String.from_bytes(out) ?? panic("decimal float text must be UTF-8")
}

priv db_error: fn(message: String) -> DBError Never! { DBError.Failed(message.copy()) }

priv db_closed: fn() -> DBError Never! { db_error("database connection is closed") }

// Checked SQL: the template text with `?` placeholders plus its bound values.
// `SQL{"… {value} …"}` is a checked text literal whose holes stay values: each
// becomes one bound DBValue, never query text.
#Equatable
SQL: struct {
    text: String,
    values: [DBValue],

    raw: fn(text: String) -> SQL Never! { SQL{text: text.copy(), values: [DBValue]{}} }

    template: fn(self) -> String Never! { self.text.copy() }

    params: fn(self) -> [DBValue] Never! { self.values.copy() }

    impl Display {
        display: fn(self) -> String { self.text.copy() }
    }

    impl CheckedText {
        Error: Never,
        Hole: DBValue,

        // Every SQL text is accepted; its holes are what keeps a query safe.
        check: fn(_text: String) -[]> Never! { return Ok() }

        // A DBValue binds as-is; Int, Float, Bool and byte lists bind as their own
        // variant; anything else binds its display text.
        encode_hole: fn<T: Printable>(value: T) -[]> DBValue {
            if T == {
                DBValue -> value.copy()
                Int -> DBValue.Int(value)
                Float -> DBValue.Float(value)
                Bool -> DBValue.Bool(value)
                [U8] -> DBValue.Blob(value.copy())
                else -> DBValue.Text("{value}")
            }
        }

        build: fn(parts: [String], holes: [DBValue]) -[]> SQL { __sql_literal(parts, holes) }
    }
}

__sql_literal: fn(literals: [String], values: [DBValue]) -> SQL Never! {
    if literals.len() != values.len() + 1 {
        panic("typed SQL literal pieces do not match its holes")
    }
    text := literals[0].copy()
    loop index in 0..<values.len() -> text = "{text}?{literals[index + 1]}"
    SQL{text: text, values: values.copy()}
}

priv sql_raw: fn(text: String) -> SQL Never! { SQL{text: text.copy(), values: [DBValue]{}} }

// Row policies: a table plus either `true` (allow all) or `owner == user`.
#Equatable
RowPolicy: struct {
    table: String,
    owner: Bool,
}

priv policy_expression: fn(policy: RowPolicy) -> String Never! {
    if policy.owner -> "owner == user" else -> "true"
}

priv policy_predicate: fn(policy: RowPolicy) -> String Never! {
    if policy.owner -> "owner = ?" else -> "true"
}

policy: fn(table: String, expression: String) -[DB]> RowPolicy DBError! {
    name: table.trim()
    expr: expression.trim()
    name_raw: name.bytes()
    expr_raw: expr.bytes()
    if name_raw.len() == 0 || expr_raw.len() == 0 || name_raw.len() > 1048576 || expr_raw.len() > 1048576 || sql_has_control(name_raw, false) || sql_has_control(expr_raw, false) {
        return Err(db_error("row policy needs a table and expression"))
    }
    if !sql_identifier(name_raw) {
        return Err(db_error("row policy table must be a simple identifier"))
    }
    if expr == "true" -> return Ok(RowPolicy{table: name.copy(), owner: false})
    if expr == "owner == user" -> return Ok(RowPolicy{table: name.copy(), owner: true})
    Err(db_error("unsupported row policy expression `{expr}`; supported forms are `true` and `owner == user`"))
}

policy_show: fn(policy: RowPolicy) -> String Never! {
    "RowPolicy(table={policy.table}, expr={policy_expression(policy)})"
}

policy_allows: fn(policy: RowPolicy, *, user: String, owner: String) -> Bool Never! {
    if !policy.owner -> return true
    user == owner
}

policy_audit: fn(scope: DBScope) -[DB]> String Never! {
    "DBPolicy(table={scope.policy.table}, user={scope.user}, expr={policy_expression(scope.policy)}, predicate={policy_predicate(scope.policy)})"
}

priv sql_identifier: fn(raw: [U8]) -> Bool Never! {
    if raw.len() == 0 -> return false
    first: Int{raw[0]}
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) {
        return false
    }
    loop byte in raw {
        if !sql_word_byte(Int{byte}) -> return false
    }
    true
}

// ---- policy-scoped SQL ---------------------------------------------------
// Statements run through a scope are rewritten on bytes: one statement, no
// comments, one simple target table, and an owner predicate when required.

priv SQLToken: struct {
    start: Int,
    end: Int,
    word: String,
}

priv sql_word_byte: fn(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

priv sql_space: fn(byte: Int) -> Bool Never! { byte == 32 || (byte >= 9 && byte <= 13) }

priv sql_lower: fn(byte: U8) -> U8 Never! {
    value: Int{byte}
    if value >= 65 && value <= 90 -> return U8{value + 32}
    byte
}

priv sql_lower_text: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() -> out.push(sql_lower(byte))
    String.from_bytes(out) ?? ""
}

priv bytes_text: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    loop at in start..<end -> out.push(raw[at])
    String.from_bytes(out) ?? ""
}

priv sql_trimmed: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    first := start
    last := end
    loop first < last && sql_space(Int{raw[first]}) -> first += 1
    loop last > first && sql_space(Int{raw[last - 1]}) -> last -= 1
    bytes_text(raw, first, last)
}

priv sql_blank: fn(raw: [U8], start: Int, end: Int) -> Bool Never! {
    loop at in start..<end {
        if !sql_space(Int{raw[at]}) -> return false
    }
    true
}

priv sql_find: fn(raw: [U8], from: Int, byte: Int) -> Int Never! {
    loop at in from..<raw.len() {
        if (Int{raw[at]}) == byte -> return at
    }
    -1
}

// Control characters by Rust `char::is_control` on UTF-8 bytes: C0, DEL and
// C1 (C2 80-9F). `allow_whitespace` admits the whitespace controls.
priv sql_has_control: fn(raw: [U8], allow_whitespace: Bool) -> Bool Never! {
    loop at in 0..<raw.len() {
        byte: Int{raw[at]}
        whitespace: byte >= 9 && byte <= 13
        if byte < 32 && !(allow_whitespace && whitespace) -> return true
        if byte == 127 -> return true
        if byte == 194 && at + 1 < raw.len() {
            next: Int{raw[at + 1]}
            if next >= 128 && next <= 159 && !(allow_whitespace && next == 133) -> return true
        }
    }
    false
}

priv sql_skip_quoted: fn(raw: [U8], open: Int, quote: Int, limit: Int) -> Int Never! {
    at := open + 1
    loop at < limit {
        if {
            (Int{raw[at]}) == quote -> {
                if {
                    at + 1 < limit && (Int{raw[at + 1]}) == quote -> { at += 2 }
                    else -> { return at + 1 }
                }
            }
            else -> { at += 1 }
        }
    }
    at
}

priv sql_tokens: fn(raw: [U8]) -> [SQLToken] Never! {
    tokens := [SQLToken]{}
    at := 0
    loop at < raw.len() {
        byte: Int{raw[at]}
        if {
            byte == 39 -> { at = sql_skip_quoted(raw, at, 39, raw.len()) }
            sql_word_byte(byte) -> {
                start: at
                word := [U8]{}
                loop at < raw.len() && sql_word_byte(Int{raw[at]}) {
                    word.push(sql_lower(raw[at]))
                    at += 1
                }
                tokens.push(SQLToken{start: start, end: at, word: String.from_bytes(word) ?? ""})
            }
            else -> { at += 1 }
        }
    }
    tokens
}

priv sql_has_comment: fn(raw: [U8]) -> Bool Never! {
    at := 0
    loop at < raw.len() {
        byte: Int{raw[at]}
        if {
            byte == 39 -> { at = sql_skip_quoted(raw, at, 39, raw.len()) }
            else -> {
                if at + 1 < raw.len() {
                    next: Int{raw[at + 1]}
                    if (byte == 45 && next == 45) || (byte == 47 && next == 42) || (byte == 42 && next == 47) {
                        return true
                    }
                }
                at += 1
            }
        }
    }
    false
}

priv sql_word_index: fn(tokens: [SQLToken], word: String) -> Int Never! {
    loop index in 0..<tokens.len() {
        if tokens[index].word == word -> return index
    }
    -1
}

priv sql_count: fn(tokens: [SQLToken], word: String) -> Int Never! {
    count := 0
    loop token in tokens {
        if token.word == word -> count += 1
    }
    count
}

priv sql_clause_word: fn(word: String, with_where: Bool) -> Bool Never! {
    (with_where && word == "where") || word == "order" || word == "group" || word == "limit" || word == "offset" || word == "returning"
}

// First ORDER/GROUP/LIMIT/OFFSET/RETURNING token starting after `after`.
priv sql_clause_start: fn(tokens: [SQLToken], after: Int) -> Int Never! {
    loop token in tokens {
        if token.start > after && sql_clause_word(token.word, false) -> return token.start
    }
    -1
}

priv sql_target_index: fn(tokens: [SQLToken], kind: String) -> Int Never! {
    keyword: if {
        kind == "select" || kind == "delete" -> "from"
        kind == "insert" -> "into"
        else -> kind.copy()
    }
    found: sql_word_index(tokens, keyword)
    if found < 0 || found + 1 >= tokens.len() -> return -1
    found + 1
}

priv sql_simple_target: fn(raw: [U8], tokens: [SQLToken], kind: String) -> Bool Never! {
    selects: if kind == "select" -> 1 else -> 0
    froms: if kind == "select" || kind == "delete" -> 1 else -> 0
    words: [String]{"join", "union", "with", "except", "intersect", "conflict", "upsert", "replace"}
    loop word in words {
        if sql_count(tokens, word) > 0 -> return false
    }
    if sql_count(tokens, "select") > selects || sql_count(tokens, "from") > froms -> return false
    target: sql_target_index(tokens, kind)
    if target < 0 -> return false
    target_end: tokens[target].end
    first: target + 1
    if kind == "select" || kind == "delete" {
        clause := raw.len()
        loop index in first..<tokens.len() {
            if sql_clause_word(tokens[index].word, true) {
                clause = tokens[index].start
                break
            }
        }
        return sql_blank(raw, target_end, clause)
    }
    if kind == "update" {
        loop index in first..<tokens.len() {
            if tokens[index].word == "set" -> return sql_blank(raw, target_end, tokens[index].start)
        }
        return false
    }
    if kind == "insert" {
        return sql_count(tokens, "values") == 1 && sql_count(tokens, "select") == 0
    }
    false
}

priv sql_split_trimmed: fn(raw: [U8], start: Int, end: Int) -> [String] Never! {
    parts := [String]{}
    from := start
    loop at in start..<end {
        if (Int{raw[at]}) == 44 {
            parts.push(sql_trimmed(raw, from, at))
            from = at + 1
        }
    }
    parts.push(sql_trimmed(raw, from, end))
    parts
}

priv SQLInsertShape: struct {
    columns: Int,
    owner: Int,
}

priv sql_insert_shape: fn(raw: [U8], tokens: [SQLToken]) -> SQLInsertShape? Never! {
    into: sql_word_index(tokens, "into")
    if into < 0 || into + 1 >= tokens.len() -> return None
    values: sql_word_index(tokens, "values")
    if values < 0 -> return None
    column_start: sql_find(raw, tokens[into + 1].end, 40)
    if column_start < 0 -> return None
    column_end: sql_find(raw, column_start, 41)
    if column_end < 0 -> return None
    value_start: sql_find(raw, tokens[values].end, 40)
    if value_start < 0 -> return None
    value_end: sql_find(raw, value_start, 41)
    if value_end < 0 -> return None
    columns: sql_split_trimmed(raw, column_start + 1, column_end)
    cells: sql_split_trimmed(raw, value_start + 1, value_end)
    if columns.len() != cells.len() -> return None
    owner := -1
    loop index in 0..<columns.len() {
        column: columns[index].bytes()
        if column.len() == 0 -> return None
        loop byte in column {
            if !sql_word_byte(Int{byte}) -> return None
        }
        if cells[index] != "?" -> return None
        if owner < 0 && sql_lower_text(columns[index]) == "owner" -> owner = index
    }
    if owner < 0 -> return None
    Val(SQLInsertShape{columns: columns.len(), owner: owner})
}

priv sql_update_mutates_owner: fn(tokens: [SQLToken]) -> Bool Never! {
    set: sql_word_index(tokens, "set")
    if set < 0 -> return false
    first: set + 1
    loop index in first..<tokens.len() {
        if sql_clause_word(tokens[index].word, true) -> return false
        if tokens[index].word == "owner" -> return true
    }
    false
}

// Bound placeholders before `end`, skipping quoted text and [bracketed] names.
priv sql_placeholders: fn(raw: [U8], end: Int) -> Int Never! {
    count := 0
    at := 0
    loop at < end {
        byte: Int{raw[at]}
        if {
            byte == 39 || byte == 34 || byte == 96 -> { at = sql_skip_quoted(raw, at, byte, end) }
            byte == 91 -> {
                at += 1
                loop at < end && (Int{raw[at]}) != 93 -> at += 1
                if at < end -> at += 1
            }
            else -> {
                if byte == 63 -> count += 1
                at += 1
            }
        }
    }
    count
}

priv sql_is_migration_metadata: fn(raw: [U8]) -> Bool Never! {
    out := [U8]{}
    pending := false
    loop byte in raw {
        if {
            sql_space(Int{byte}) -> { pending = out.len() > 0 }
            else -> {
                if pending {
                    out.push(U8{32})
                    pending = false
                }
                out.push(sql_lower(byte))
            }
        }
    }
    text: String.from_bytes(out) ?? ""
    if text.starts_with("create table if not exists __jet_migrations") || text.starts_with("create table __jet_migrations") {
        return true
    }
    if text.starts_with("pragma table_info(__jet_migrations") || text.starts_with("insert into __jet_migrations") {
        return true
    }
    text.starts_with("select ") && text.contains(" from __jet_migrations")
}

priv policy_apply: fn(sql: SQL, policy: RowPolicy, user: String, allow_schema: Bool) -> SQL DBError! {
    raw: sql.text.bytes()
    if raw.len() > 1048576 || sql_find(raw, 0, 59) >= 0 || sql_has_control(raw, true) {
        return Err(db_error("policy-scoped SQL must be one statement without control characters"))
    }
    if sql_has_comment(raw) -> return Err(db_error("policy-scoped SQL cannot contain comments"))
    // An all-rows scope (`Store.all_rows`, a policy with no table) acts for
    // no user.
    user_raw: user.bytes()
    if policy.table != "" && (sql_blank(user_raw, 0, user_raw.len()) || user_raw.len() > 1048576 || sql_has_control(user_raw, false)) {
        return Err(db_error("policy user identity is empty, too long, or contains control characters"))
    }
    tokens: sql_tokens(raw)
    if tokens.len() == 0 -> return Err(db_error("policy-scoped SQL is empty"))
    if sql_is_migration_metadata(raw) {
        if !allow_schema -> return Err(db_error("migration metadata is managed only by db.migrate"))
        return Ok(sql.copy())
    }
    kind: tokens[0].word.copy()
    if kind != "select" && kind != "update" && kind != "delete" && kind != "insert" {
        if kind == "create" || kind == "alter" || kind == "drop" || kind == "pragma" || kind == "begin" || kind == "commit" || kind == "rollback" {
            if allow_schema -> return Ok(sql.copy())
            return Err(db_error("schema and transaction-control SQL is only allowed in db.migrate or through the scope transaction controls"))
        }
        return Err(db_error("row policy supports SELECT, INSERT, UPDATE, and DELETE only"))
    }
    if policy.table == "" -> return Ok(sql.copy())
    target: sql_target_index(tokens, kind)
    table: sql_lower_text(policy.table)
    // A row policy constrains the rows of its own table (#6070). SQL that
    // targets no table (`SELECT 1`) or another table runs unchanged, unless it
    // names the policy's table anywhere (a join, a subquery, a column read),
    // which would read its rows past the policy.
    if target < 0 || tokens[target].word != table {
        if sql_word_index(tokens, table) >= 0 {
            return Err(db_error("policy-scoped SQL that reads `{policy.table}` must target it as its one simple table"))
        }
        // copy: the caller keeps its SQL value; the scope runs this one.
        return Ok(sql.copy())
    }
    if !sql_simple_target(raw, tokens, kind) {
        return Err(db_error("policy-scoped SQL must name one simple target table without joins or subqueries"))
    }
    if !policy.owner -> return Ok(sql.copy())
    if kind == "insert" {
        shape: sql_insert_shape(raw, tokens) ?? return Err(db_error("owner policy requires INSERT columns and `?` values with an owner column"))
        if shape.columns != sql.values.len() {
            return Err(db_error("owner policy INSERT bind count does not match its columns"))
        }
        values := sql.values.copy()
        values[shape.owner] = DBValue.Text(user.copy())
        return Ok(SQL{text: sql.text.copy(), values: values})
    }
    if kind == "update" && sql_update_mutates_owner(tokens) {
        return Err(db_error("owner policy does not allow changing the owner column"))
    }
    where_index: sql_word_index(tokens, "where")
    insertion := -1
    if where_index >= 0 -> insertion = sql_clause_start(tokens, tokens[where_index].end)
    if insertion < 0 -> insertion = sql_clause_start(tokens, 0)
    if insertion < 0 -> insertion = raw.len()
    user_index: sql_placeholders(raw, insertion)
    if user_index > sql.values.len() {
        return Err(db_error("policy-scoped SQL bind count does not match its placeholders"))
    }
    values := [DBValue]{}
    loop index in 0..<sql.values.len() {
        if index == user_index -> values.push(DBValue.Text(user.copy()))
        values.push(sql.values[index].copy())
    }
    if user_index == sql.values.len() -> values.push(DBValue.Text(user.copy()))
    tail_start := insertion
    loop tail_start < raw.len() && sql_space(Int{raw[tail_start]}) -> tail_start += 1
    suffix: if tail_start >= raw.len() -> "" else -> " {bytes_text(raw, tail_start, raw.len())}"
    if where_index >= 0 {
        condition: sql_trimmed(raw, tokens[where_index].end, insertion)
        if condition.len() == 0 {
            return Err(db_error("policy-scoped SQL has an empty WHERE clause"))
        }
        return Ok(SQL{text: "{bytes_text(raw, 0, tokens[where_index].start)}WHERE ({condition}) AND owner = ?{suffix}", values: values})
    }
    head_end := insertion
    loop head_end > 0 && sql_space(Int{raw[head_end - 1]}) -> head_end -= 1
    Ok(SQL{text: "{bytes_text(raw, 0, head_end)} WHERE owner = ?{suffix}", values: values})
}

// ---- connections and scopes ----------------------------------------------

// One SQLite connection shared by a Store and every scope derived from
// it. `close` shuts the driver down in place for all of them. `path` is the
// location it was opened at, for display. `written` holds the tables written
// since the last begin or commit, so a rollback can re-run their live bindings.
// `open` numbers the transaction open on it (0: none), out of `began` so far.
// `call` is the mounted method's call (app.transactions) whose transaction
// that is (0: none, or one a `begin` opened); `ended` wakes the statements
// waiting for it to end (`db_free`).
priv DBState: struct {
    driver: DBDriver,
    path: String,
    // Names the store among the open ones, as its job outbox
    // (app.CallOutbox): its path, or for an in-memory database, one of its own.
    store: String,
    written: [DBWritten],
    ended: Condition,
    open: Int{0},
    began: Int{0},
    call: Int{0},

    // A write that changed `table` marks the live bindings that read it for a
    // re-run once the write is committed: at once outside a transaction, and
    // at the commit or rollback inside one. A binding re-run on another
    // connection before the commit reads the old rows, so a mark made before
    // the commit would leave that old result stored as current. `rows` are
    // the stored rows the write replaced, removed or added, or None when it
    // does not name them (DBWritten).
    priv wrote: fn(&self, table: String, rows: [String]?) Never! {
        if self.open == 0 {
            db_live_wrote(self.driver, table, rows)
            db_live_bump(self, table)
            return db_kept_written(self)
        }
        loop at in 0..<self.written.len() {
            if self.written[at].table == table {
                if self.written[at].rows == .Val(held) && rows == .Val(more) {
                    joined := held.copy()
                    joined.extend(more.copy())
                    self.written[at].rows = Val(joined)
                } else { self.written[at].rows = None }
                return
            }
        }
        self.written.push(DBWritten{table: table.copy(), rows: rows})
    }
}

// A table written in the open transaction. `rows` are the stored rows (each
// its `jet_row` text) its writes replaced, removed or added, or None once a
// write did not name them, as a SQL statement does not.
priv DBWritten: struct {
    table: String,
    rows: [String]?,
}

// The live bindings to re-run after a write to `table` (DBState.wrote): every
// binding that read the whole table, and each one whose read of it was
// narrowed by a condition over the field columns (`__query_filter`) that
// holds for one of `rows` that the write changed, before or after it. With no
// `rows` named, every binding that read the table re-runs.
priv db_live_wrote: fn(driver: &DBDriver, table: String, rows: [String]?) Never! {
    source: live_source(table)
    changed: rows ?? return app.__live_invalidate_all(source)
    reads: app.live_reads.narrowed(source)
    if reads.len() == 0 -> return app.live_reads.invalidate(source, [String]{})
    // Each changed row as a one-row table of its field columns.
    selects := [{sql: String, values: [DBValue]}]{}
    loop row in changed {
        tree: json.parse(row) ?? Dyn.Null
        columns := [String]{}
        values := [DBValue]{}
        loop field in table_fields(tree) {
            columns.push("? AS \"{field.column}\"")
            values.push(field.value.copy())
        }
        from: if columns.len() == 0 -> "" else -> " FROM (SELECT {columns.join(", ")})"
        selects.push({sql: "SELECT 1 AS held{from}", values: values})
    }
    held := [String]{}
    loop read in reads {
        loop select in selects {
            bound := select.values.copy()
            loop value in read.values -> bound.push(.Text(value.copy()))
            // A condition the engine can't judge re-runs its binding.
            if __driver_query(driver, "{select.sql} WHERE {read.condition}", bound) == .Ok(found) && found.len() == 0 {
                next
            }
            held.push(read.entry.copy())
            break
        }
    }
    app.live_reads.invalidate(source, held)
}

Store: struct {
    state: Shared<DBState>,

    with_policy: fn(self, policy: RowPolicy, user: String) -[DB]> DBScope Never! {
        DBScope{state: self.state.copy(), policy: RowPolicy{table: policy.table.copy(), owner: policy.owner}, user: user.copy()}
    }

    // The scope over every row: no row policy narrows what it reads or
    // writes, so a helper written for a `DBScope` serves a script's
    // connection as well as a server's policy scope.
    all_rows: fn(self) -> DBScope Never! {
        DBScope{state: self.state.copy(), policy: RowPolicy{table: "", owner: false}, user: ""}
    }

    close: fn(self) -[DB]> Bool Never! { db_shutdown(self.state) }

    // The typed table `name`: rows of type `T`, each found by the key that
    // the pure function `key` computes from it. It has no row policy until
    // `guard` gives it one. With `search`, the table keeps a search index:
    // the words of the text `search` gives for each row, which
    // `Table.search` looks words up in.
    table: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(self, name: String, key: &&fn(T) -[]> K, search: &&(fn(T) -[]> String)?{None}) -> Table<K, T> Never! {
        Table<K, T>{state: self.state.copy(), name: name.copy(), key_of: key.move(), search_of: search.move(), policy: None}
    }

    // An opened connection queries directly, meaning every row: `query`
    // needs DB.Read and `execute` DB.Write, as on its `all_rows()` scope.
    // `begin` opens a transaction; the `DBTransaction` it returns has to be
    // committed or rolled back.
    impl Driver {
        query: fn(self, sql: SQL) -[DB.Read]> [[String:DBValue]] DBError! {
            scope_query(self.all_rows(), sql, false)
        }

        query_one: fn(self, sql: SQL) -[DB.Read]> [String:DBValue]? DBError! {
            scope_query_one(self.all_rows(), sql)
        }

        execute: fn(self, sql: SQL) -[DB.Write]> Int DBError! {
            scope_execute(self.all_rows(), sql, false)
        }

        begin: fn(self) -[DB]> DBTransaction DBError! { db_begin(self.state, false) }
    }

    // One line: where the database lives and whether it is still open.
    impl Display {
        display: fn(self) -> String {
            guard: self.state.guard_edit()
            status: if driver_closed(guard.value.driver) -> "closed" else -> "open"
            "Store({guard.value.path}, {status})"
        }
    }
}

DBScope: struct {
    state: Shared<DBState>,
    policy: RowPolicy,
    user: String,

    // A live binding over one policy-checked SELECT. `app.state` reads
    // it; each re-run applies this scope's policy again, and a write to the
    // table it reads (or a rollback of one) re-runs it on the next read. The
    // user, the policy-applied SQL and its values identify the binding.
    live: fn(self, sql: SQL) -[DB.Read]> Live<[[String:DBValue]], DBError> DBError! {
        scoped: policy_apply(sql, self.policy, self.user, false) ?? return Err(err)
        tokens: sql_tokens(scoped.text.bytes())
        if tokens.len() == 0 || tokens[0].word != "select" {
            return Err(db_error("a live query must be one SELECT"))
        }
        key := [String]{app.__live_arg<String>(self.user), app.__live_arg<String>(scoped.text)}
        loop value in scoped.values -> key.push(app.__live_arg<DBValue>(value))
        scope: self.copy()
        query: sql.copy()
        Ok(app.__live_bind<[[String:DBValue]], DBError>(live_source(sql_table(scoped) ?? ""), key, fn() { scope_query(scope, query, false) }))
    }

    close: fn(self) -[DB]> Bool Never! { db_shutdown(self.state) }

    // A policy scope is the typed-SQL driver a generic `<T: Driver>` takes.
    impl Driver {
        query: fn(self, sql: SQL) -[DB.Read]> [[String:DBValue]] DBError! {
            scope_query(self, sql, false)
        }

        query_one: fn(self, sql: SQL) -[DB.Read]> [String:DBValue]? DBError! {
            scope_query_one(self, sql)
        }

        execute: fn(self, sql: SQL) -[DB.Write]> Int DBError! { scope_execute(self, sql, false) }

        begin: fn(self) -[DB]> DBTransaction DBError! { db_begin(self.state, false) }
    }
}

// An open transaction on a connection. It is `#SingleUse`: whoever began it
// has to `commit` or `rollback` it, on every path, before a function returns
// with success. Either call ends the transaction, even when it fails: a commit
// that fails is rolled back, and its error says so; the caller can't ignore it.
// One dropped while still open, by a canceled task or a stop unwinding past
// it, is rolled back: it writes nothing, and the connection can begin again.
#SingleUse DBTransaction: struct {
    priv state: Shared<DBState>,
    priv number: Int,

    commit: fn(&&self) -[DB]> DBError! { db_commit(self.state) }

    rollback: fn(&&self) -[DB]> DBError! { db_rollback(self.state) }

    impl Close {
        close: fn(&&self) {
            if !db_open_is(self.state, self.number) {
                return
            }
            db_rollback(self.state).drop("an unwind ended the transaction; no caller is left to report a failed rollback to")
        }
    }
}

// ---- typed tables ----------------------------------------------------------

// The column a typed table keeps each encoded row in, and the one key column
// of a table whose key is not a record.
TABLE_ROW_COLUMN: "jet_row"

TABLE_KEY_COLUMN: "key"

// The operation a table's row policy judges.
#Equatable
Op: enum {
    Read,
    Insert,
    Update,
    Delete,
}

// Whom a row policy is asked as: the account a task acts for
// (`app.as_caller`), by its id; the system, whose rights are the server's own
// (`app.as_system`: jobs, schedules, and a row policy's own reads); or no one,
// for a task that acts for neither, as a request with no signed-in caller
// does. No row policy limits `System`, and a guarded table never asks it.
#Equatable
Who: enum {
    Account(auth.AccountID),
    System,
    Anonymous,
}

// A typed table, from `store.table(name, key:)`. Each field of the key is a
// key column (a key that is not a record is the one column `key`) and those
// columns are the primary key; the column `jet_row` holds the row as its
// storage codec encodes it, `#Secret` fields included (its wire codec,
// `encode()`, leaves them off).
// The first write creates the table, and until then it reads as empty. Reads
// carry DB.Read and join a running live binding's read set; writes carry
// DB.Write and re-run the bindings that read the table (DBState.wrote).
//
// A table with a row policy (`guard`) asks it about every read and write, as
// the caller the task acts for (`Who`), unless that is the system: a read on
// the stored row, an add on the new row, a delete on the stored row, and a
// put that replaces a row on the stored row and on the new one, both of
// which must pass (a put of a new key is an insert). A row the policy refuses
// to read is never returned, and a refused write is `Denied`. The policy runs
// as the system and reads through a store on the same connection, so it
// sees the transaction's earlier writes; it runs before the write it judges,
// which it therefore cannot see.
//
// A table with a search function (`store.table(name, key:, search:)`) keeps
// a search index beside it, the table `<name>__jet_search`: one row for
// each word of each row's search text, under the row's encoded key. A write
// of a row replaces its words and a delete removes them, in the same
// transaction; `upgrade` indexes every stored row again, so rows written
// before the table had a search function are found too.
Table: struct<K: [Encode, Decode, Comparable], T: [Encode, Decode]> {
    priv state: Shared<DBState>,
    priv name: String,
    priv key_of: fn(T) -[]> K,
    priv search_of: (fn(T) -[]> String)?,
    priv policy: (fn(T, Op, Who, Store) -[DB.Read]> Bool DBError!)?,

    // This table judged by the row policy `policy`, in place of any it had.
    guard: fn(self, policy: &&fn(T, Op, Who, Store) -[DB.Read]> Bool DBError!) -> Table<K, T> Never! {
        Table<K, T>{state: self.state.copy(), name: self.name.copy(), key_of: self.key_of, search_of: self.search_of, policy: Val(policy.move())}
    }

    // This table again, over the same store, for a query to read later.
    priv again: fn(self) -> Table<K, T> Never! {
        Table<K, T>{state: self.state.copy(), name: self.name.copy(), key_of: self.key_of, search_of: self.search_of, policy: self.policy}
    }

    // The row whose key is `key`, or None, also when the policy refuses to
    // let the caller read it.
    get: fn(self, key: K) -[DB.Read]> T? DBError! {
        cells: table_cells(self.name, key.encode()) ?? return Err(err)
        if table_stored<K, T>(self, cells) == {
            .Val(row) -> {
                allowed: table_allows<K, T>(self, row.copy(), Op.Read) ?? return Err(err)
                if allowed -> return Ok(Val(row))
            }
            .None -> {}
            .Err(failure) -> return Err(failure)
        }
        Ok(None)
    }

    // Adds `row`, whose key no row may hold yet. A taken key is `Exists`
    // when the caller may read the row that holds it, and `Denied` when it
    // may not, as a refused write is, so a key a client chose (such as an
    // `app.new_id()`) tells it nothing of a row it can't see.
    add: fn(self, row: T) -[DB.Read, DB.Write]> T DBError! {
        allowed: table_allows<K, T>(self, row.copy(), Op.Insert) ?? return Err(err)
        if !allowed -> return Err(DBError.Denied)
        if self.policy == .Val(_) {
            cells: table_cells(self.name, self.key_of(row.copy()).encode()) ?? return Err(err)
            if table_stored<K, T>(self, cells) == {
                .Val(stored) -> {
                    seen: table_allows<K, T>(self, stored, Op.Read) ?? return Err(err)
                    return Err(if seen -> DBError.Exists else -> DBError.Denied)
                }
                .None -> {}
                .Err(failure) -> return Err(failure)
            }
        }
        table_write<K, T>(self, row, false)
    }

    // Adds `row`, or replaces the row that holds its key.
    put: fn(self, row: T) -[DB.Read, DB.Write]> T DBError! {
        if self.policy == .Val(_) {
            cells: table_cells(self.name, self.key_of(row.copy()).encode()) ?? return Err(err)
            allowed := false
            if table_stored<K, T>(self, cells) == {
                .Val(stored) -> {
                    allowed = table_allows<K, T>(self, stored, Op.Update) ?? return Err(err)
                    if allowed {
                        allowed = table_allows<K, T>(self, row.copy(), Op.Update) ?? return Err(err)
                    }
                }
                .None -> allowed = table_allows<K, T>(self, row.copy(), Op.Insert) ?? return Err(err)
                .Err(failure) -> return Err(failure)
            }
            if !allowed -> return Err(DBError.Denied)
        }
        table_write<K, T>(self, row, true)
    }

    // Removes the row whose key is `key`, if there is one.
    delete: fn(self, key: K) -[DB.Read, DB.Write]> DBError! {
        cells: table_cells(self.name, key.encode()) ?? return Err(err)
        if self.policy == .Val(_) {
            if table_stored<K, T>(self, cells) == {
                .Val(stored) -> {
                    allowed: table_allows<K, T>(self, stored, Op.Delete) ?? return Err(err)
                    if !allowed -> return Err(DBError.Denied)
                }
                .None -> return Ok()
                .Err(failure) -> return Err(failure)
            }
        }
        guard := self.state.guard_edit()
        call: app.transactions.current() ?? 0
        guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
        db_join(guard.value, self.state, call) ?? return Err(err)
        if !table_exists(guard.value.driver, self.name) -> return Ok()
        stored: __driver_query(guard.value.driver, "SELECT {TABLE_ROW_COLUMN} FROM \"{self.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        gone: table_texts(stored) ?? return Err(err)
        changed: __driver_execute(guard.value.driver, "DELETE FROM \"{self.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        if changed > 0 {
            if self.search_of == .Val(_) {
                table_unindex(guard.value.driver, self.name, cells) ?? return Err(err)
            }
            guard.value.wrote(self.name, Val(gone))
        }
        Ok()
    }

    // Every row the caller may read, in key order, as a data query. The
    // query is read as it is collected, judged by the row policy as the
    // caller this task acts for now, in key order too. A filter the compiler
    // writes as SQL over the field columns (`__query_filter`) narrows what the
    // read selects, and a live binding's read set to the rows it holds for.
    query: fn(self) -[DB.Read]> Query<T> DBError! {
        if !sql_identifier(self.name.bytes()) -> return Err(table_name_error(self.name))
        who: table_who()
        table: self.again()
        deferred: data.__query_narrowed<T>("table", fn(condition: String, values: [String]) {
            stored_rows: table_rows<K, T>(table, condition, table_bound(values), Val(values.copy())) ?? return Err(table_data_error(err))
            table_readable<K, T>(table, stored_rows, who)
        })
        Ok(deferred)
    }

    // The rows whose search text (the table's `search` function) holds
    // every word of `words`, which the caller may read, in key order, as a
    // data query. A word matches whole and caseless (`search_terms`), so
    // `Ship` finds "ship it" and `shi` does not. No words match every row.
    // It reads the table's search index once for the rows that hold every
    // word, then each of those rows; the row policy judges each, as the
    // caller this task acts for now. A live binding that searches re-runs
    // after any write to the table. A table made without `search` has no
    // index, and searching it is an error.
    search: fn(self, words: String) -[DB.Read]> Query<T> DBError! {
        if !sql_identifier(self.name.bytes()) -> return Err(table_name_error(self.name))
        if self.search_of == .None {
            return Err(db_error("table `{self.name}` has no search index: give `store.table` a `search` function"))
        }
        terms: search_terms(words)
        who: table_who()
        table: self.again()
        // The filter of a `.filter` step after the search runs on each row
        // the search gives, so the search does not narrow its read by it.
        deferred: data.__query_narrowed<T>("search", fn(_: String, _: [String]) {
            stored_rows: table_found<K, T>(table, terms.copy()) ?? return Err(table_data_error(err))
            table_readable<K, T>(table, stored_rows, who)
        })
        Ok(deferred)
    }

    // Rewrites each stored row that an older version of its row type wrote
    // into the current shape, and answers how many it rewrote. A row type's
    // `migration` block is its table's history: every read already decodes
    // an older row through it, and this stores what that read gives, so the
    // block's steps are the table's steps. A row already in the current shape
    // is left alone, so a second call rewrites none. A table with a search
    // function also indexes each row's search text again, so the rows
    // written before it had one, or before the function changed, are found
    // by their words. Each row is its own write: a failure part way leaves
    // every row readable, and calling again finishes. It is a schema step, so
    // it runs as the system: the row policy judges none of it.
    upgrade: fn(self) -[DB.Read, DB.Write]> Int DBError! {
        rows: table_rows<K, T>(self, "", [DBValue]{}, None) ?? return Err(err)
        rewritten := 0
        loop stored in rows {
            text: row_text(stored, TABLE_ROW_COLUMN) ?? return Err(err)
            row: table_decode<T>(stored) ?? return Err(err)
            cells: table_cells(self.name, self.key_of(row.copy()).encode()) ?? return Err(err)
            encoded: json.to_string(row.encode_stored()) ?? return Err(db_error("the row for table `{self.name}` does not encode: {err}"))
            terms: if self.search_of == .Val(text_of) -> Val(search_terms(text_of(row.copy()))) else -> None
            if encoded == text && terms == .None -> next
            guard := self.state.guard_edit()
            call: app.transactions.current() ?? 0
            guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
            db_join(guard.value, self.state, call) ?? return Err(err)
            if encoded != text {
                kept: table_columns(guard.value.driver, self.name, table_fields(row.encode_stored())) ?? return Err(err)
                sets := [String]{"{TABLE_ROW_COLUMN} = ?"}
                values := [DBValue]{.Text(encoded.copy())}
                loop field in kept {
                    sets.push("\"{field.column}\" = ?")
                    values.push(field.value.copy())
                }
                loop value in table_values(cells) -> values.push(value)
                _: __driver_execute(guard.value.driver, "UPDATE \"{self.name}\" SET {sets.join(", ")} WHERE {table_match(cells)}", values) ?? return Err(err)
                guard.value.wrote(self.name, Val([String]{text.copy(), encoded.copy()}))
                rewritten += 1
            }
            if terms == .Val(words) {
                indexed: table_index(guard.value.driver, self.name, cells, words) ?? return Err(err)
                if indexed -> guard.value.wrote(self.name, Val([String]{encoded}))
            }
        }
        Ok(rewritten)
    }
}

// The stored rows `filter` (a WHERE clause, empty for every row) selects,
// read without the row policy. The connection is held only for the read, so
// a policy that reads through the same store can run after it. `narrowed`
// says `filter` is a condition over the field columns alone
// (`__query_filter`) with these values, so the read joins a running
// binding's read set as the table narrowed by it (`table_read`).
priv table_rows: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, filter: String, values: [DBValue], narrowed: [String]?) -[DB.Read]> [[String:DBValue]] DBError! {
    if !sql_identifier(table.name.bytes()) -> return Err(table_name_error(table.name))
    guard := table.state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
    db_join(guard.value, table.state, call) ?? return Err(err)
    table_blob_known<K, T>(table, guard.value.store)
    if app.live_reads.running() -> db_live_watch(guard.value, table.state, table.name)
    every: "SELECT {TABLE_ROW_COLUMN} FROM \"{table.name}\""
    if filter.len() == 0 -> return table_read(guard.value.driver, table.name, every, values, None)
    if narrowed == .Val(bound) {
        read: {condition: filter.copy(), values: bound.copy()}
        if table_read(guard.value.driver, table.name, "{every} WHERE {filter}", values.copy(), Val(read)) == .Ok(rows) {
            return Ok(rows)
        }
        // A condition over a field column no write has added yet reads the
        // whole table, whose filter still decides each row.
        return table_read(guard.value.driver, table.name, every, [DBValue]{}, None)
    }
    table_read(guard.value.driver, table.name, "{every} WHERE {filter}", values, None)
}

// The stored row under the key `cells`, read without the row policy.
priv table_stored: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, cells: [{column: String, value: DBValue}]) -[DB.Read]> T? DBError! {
    rows: table_rows<K, T>(table, table_match(cells), table_values(cells), None) ?? return Err(err)
    if rows.len() == 0 -> return Ok(None)
    row: table_decode<T>(rows[0]) ?? return Err(err)
    Ok(Val(row))
}

// The stored rows' `jet_row` texts.
priv table_texts: fn(rows: [[String:DBValue]]) -> [String] DBError! {
    out := [String]{}
    loop stored in rows {
        text: row_text(stored, TABLE_ROW_COLUMN) ?? return Err(err)
        out.push(text)
    }
    Ok(out)
}

// The values a `__query_filter` condition binds, each as text: the
// condition casts the ones it compares as numbers.
priv table_bound: fn(values: [String]) -> [DBValue] Never! {
    out := [DBValue]{}
    loop value in values -> out.push(.Text(value.copy()))
    out
}

// A table's read failure as its query's collect reports it.
priv table_data_error: fn(failure: DBError) -> data.DataError Never! {
    data.data_error(data.DataErrorKind.IO, failure.message(), "table.query")
}

// Whom a row policy asks of the caller this task acts for.
priv table_who: fn() -> Who Never! {
    if app.callers.system() -> return Who.System
    if app.callers.account() == {
        .Val(account) -> Who.Account(account)
        .None -> Who.Anonymous
    }
}

// Whether the table's row policy lets the caller this task acts for do `op`
// to `row`.
priv table_allows: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, row: T, op: Op) -[DB.Read]> Bool DBError! {
    table_judge<K, T>(table, row, op, table_who())
}

// Whether the table's row policy lets `who` do `op` to `row`. A table with
// no policy, or the system, allows every operation. The policy runs as the
// system, so the tables it reads don't ask their own policies, and gets a
// store on the same connection.
priv table_judge: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, row: T, op: Op, who: Who) -[DB.Read]> Bool DBError! {
    judge: table.policy ?? return Ok(true)
    if who == Who.System -> return Ok(true)
    app.callers.begin_system()
    allowed: judge(row, op, who, Store{state: table.state.copy()}) ?? {
        app.callers.end()
        return Err(err)
    }
    app.callers.end()
    Ok(allowed)
}

// The rows of `stored_rows` that the row policy lets `who` read, decoded and
// in key order, as a table's `query` and `search` give them.
priv table_readable: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, stored_rows: [[String:DBValue]], who: Who) -[DB.Read]> [T] data.DataError! {
    keyed := [{key: K, row: T}]{}
    loop stored in stored_rows {
        row: table_decode<T>(stored) ?? return Err(table_data_error(err))
        keyed.push({key: table.key_of(row.copy()), row: row})
    }
    keyed.sort_by(fn(left: {key: K, row: T}, right: {key: K, row: T}) { left.key <=> right.key })
    out := [T]{}
    loop entry in keyed {
        allowed: table_judge<K, T>(table, entry.row.copy(), Op.Read, who) ?? return Err(table_data_error(err))
        if allowed -> out.push(entry.row.copy())
    }
    Ok(out)
}

// The column of a search index that holds one word of a row's search text,
// beside the row's key columns.
TABLE_WORD_COLUMN: "jet_word"

// The search index of the table `name` (Table).
priv table_index_name: fn(name: String) -> String Never! { "{name}__jet_search" }

// The words a search index keeps of `text`, and a search looks for: after
// case folding, each run of ASCII letters and digits and of text beyond
// ASCII, each once. It splits by bytes, so core.db needs no Unicode word
// tables: a word in another script stays whole, and punctuation beyond
// ASCII stays part of the word it touches.
priv search_terms: fn(text: String) -> [String] Never! {
    raw: text.casefold().bytes()
    terms := [String]{}
    start := 0
    loop at in 0..<(raw.len() + 1) {
        if at < raw.len() && search_word_byte(Int{raw[at]}) -> next
        if at > start {
            word: String.from_bytes(raw.slice(start, at)) ?? panic("a run of whole UTF-8 sequences stays UTF-8")
            if !terms.contains(word) -> terms.push(word)
        }
        start = at + 1
    }
    terms
}

// Whether a byte belongs to a word (`search_terms`): an ASCII letter or
// digit, or any byte of a sequence beyond ASCII.
priv search_word_byte: fn(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte >= 128
}

#Test("a search text's words are its caseless runs of letters and digits, each once") {
    assert_eq(search_terms("Ship it, SHIP the build-2!"), [String]{"ship", "it", "the", "build", "2"})
    assert_eq(search_terms("Café crème"), [String]{"café", "crème"})
    assert_eq(search_terms(" ,. "), [String]{})
}

// Makes `terms` the words the search index of table `name` keeps for the row
// under the key `cells`, creating the index on its first write, and answers
// whether they changed.
priv table_index: fn(driver: &DBDriver, name: String, cells: [{column: String, value: DBValue}], terms: [String]) -> Bool DBError! {
    index: table_index_name(name)
    columns := [String]{}
    loop cell in cells -> columns.push("\"{cell.column}\"")
    names: columns.join(", ")
    _: __driver_execute(driver, "CREATE TABLE IF NOT EXISTS \"{index}\" ({names}, {TABLE_WORD_COLUMN} TEXT NOT NULL, PRIMARY KEY ({names}, {TABLE_WORD_COLUMN}))", [DBValue]{}) ?? return Err(err)
    held: __driver_query(driver, "SELECT {TABLE_WORD_COLUMN} FROM \"{index}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
    kept := [String]{}
    loop stored in held {
        word: row_text(stored, TABLE_WORD_COLUMN) ?? return Err(err)
        kept.push(word)
    }
    same := kept.len() == terms.len()
    loop word in kept {
        if !terms.contains(word) -> same = false
    }
    if same -> return Ok(false)
    _: __driver_execute(driver, "DELETE FROM \"{index}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
    loop term in terms {
        values := table_values(cells)
        values.push(.Text(term.copy()))
        marks := [String]{}
        loop _ in 0..<values.len() -> marks.push("?")
        _: __driver_execute(driver, "INSERT INTO \"{index}\" ({names}, {TABLE_WORD_COLUMN}) VALUES ({marks.join(", ")})", values) ?? return Err(err)
    }
    Ok(true)
}

// Removes the words the search index of table `name` keeps for the row
// under the key `cells`.
priv table_unindex: fn(driver: &DBDriver, name: String, cells: [{column: String, value: DBValue}]) DBError! {
    index: table_index_name(name)
    if !table_exists(driver, index) -> return Ok()
    _: __driver_execute(driver, "DELETE FROM \"{index}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
    Ok()
}

// The stored rows of `table` whose search index holds every one of `terms`,
// read without the row policy: one read of the index for the keys that hold
// them all, then each of those rows by its key. Every row when `terms` is
// empty. The read joins a running live binding's read set as the whole
// table, since a write of any row may change what a search finds.
priv table_found: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, terms: [String]) -[DB.Read]> [[String:DBValue]] DBError! {
    if terms.len() == 0 -> return table_rows<K, T>(table, "", [DBValue]{}, None)
    guard := table.state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
    db_join(guard.value, table.state, call) ?? return Err(err)
    if app.live_reads.running() {
        db_live_watch(guard.value, table.state, table.name)
        app.live_reads.record(live_source(table.name))
    }
    index: table_index_name(table.name)
    if !table_exists(guard.value.driver, index) -> return Ok([[String:DBValue]]{})
    known: __driver_query(guard.value.driver, "PRAGMA table_info(\"{index}\")", [DBValue]{}) ?? return Err(err)
    keys := [String]{}
    quoted := [String]{}
    loop column in known {
        name: row_text(column, "name") ?? return Err(err)
        if name != TABLE_WORD_COLUMN {
            quoted.push("\"{name}\"")
            keys.push(name)
        }
    }
    marks := [String]{}
    values := [DBValue]{}
    loop term in terms {
        marks.push("?")
        values.push(.Text(term.copy()))
    }
    values.push(.Int(terms.len()))
    found: __driver_query(guard.value.driver, "SELECT {quoted.join(", ")} FROM \"{index}\" WHERE {TABLE_WORD_COLUMN} IN ({marks.join(", ")}) GROUP BY {quoted.join(", ")} HAVING COUNT(*) = ?", values) ?? return Err(err)
    out := [[String:DBValue]]{}
    loop held in found {
        cells := [{column: String, value: DBValue}]{}
        loop key in keys {
            value: row_value(held, key) ?? return Err(err)
            cells.push({column: key.copy(), value: value})
        }
        rows: __driver_query(guard.value.driver, "SELECT {TABLE_ROW_COLUMN} FROM \"{table.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
        out.extend(rows)
    }
    Ok(out)
}

// `add` (replace false) and `put` (replace true): creates the table on its
// first write, then inserts the row's storage encoding under its key columns,
// with its field columns (`table_fields`).
priv table_write: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, row: T, replace: Bool) -[DB.Read, DB.Write]> T DBError! {
    key: table.key_of(row.copy())
    cells: table_cells(table.name, key.encode()) ?? return Err(err)
    stored: row.encode_stored()
    encoded: json.to_string(stored) ?? return Err(db_error("the row for table `{table.name}` does not encode: {err}"))
    fields: table_fields(stored)
    columns := [String]{}
    loop cell in cells -> columns.push("\"{cell.column}\"")
    names: columns.join(", ")
    created := [String]{}
    loop field in fields -> created.push(", \"{field.column}\"")
    terms: if table.search_of == .Val(text_of) -> Val(search_terms(text_of(row.copy()))) else -> None
    guard := table.state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
    db_join(guard.value, table.state, call) ?? return Err(err)
    table_blob_known<K, T>(table, guard.value.store)
    _: __driver_execute(guard.value.driver, "CREATE TABLE IF NOT EXISTS \"{table.name}\" ({names}, {TABLE_ROW_COLUMN} TEXT NOT NULL{created.join("")}, PRIMARY KEY ({names}))", [DBValue]{}) ?? return Err(err)
    kept: table_columns(guard.value.driver, table.name, fields) ?? return Err(err)
    held: __driver_query(guard.value.driver, "SELECT {TABLE_ROW_COLUMN} FROM \"{table.name}\" WHERE {table_match(cells)}", table_values(cells)) ?? return Err(err)
    if !replace && held.len() > 0 -> return Err(DBError.Exists)
    changed := table_texts(held) ?? return Err(err)
    changed.push(encoded.copy())
    values := table_values(cells)
    values.push(DBValue.Text(encoded))
    columns.push(TABLE_ROW_COLUMN)
    loop field in kept {
        columns.push("\"{field.column}\"")
        values.push(field.value.copy())
    }
    marks := [String]{}
    loop _ in 0..<values.len() -> marks.push("?")
    verb: if replace -> "INSERT OR REPLACE" else -> "INSERT"
    _: __driver_execute(guard.value.driver, "{verb} INTO \"{table.name}\" ({columns.join(", ")}) VALUES ({marks.join(", ")})", values) ?? return Err(err)
    if terms == .Val(words) {
        _: table_index(guard.value.driver, table.name, cells, words) ?? return Err(err)
    }
    guard.value.wrote(table.name, Val(changed))
    Ok(row)
}

// Once a blob store is made (app.blobs), gives app the blob reader of
// `table`, in the store `store`, so that a blob's GET runs the read policy
// of a row that holds the blob's id (`table_blob_read`).
priv table_blob_known: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, store: String) Never! {
    guarded: table.policy == .Val(_)
    if !app.__blob_reader_wanted(store, table.name, guarded) {
        return
    }
    held: table.again()
    app.__blob_reader(store, table.name, guarded, fn(id: String) { table_blob_read<K, T>(held, id) })
}

// For the blob `id`: 1 when a row of `table` holds it and the row's read
// policy admits the caller, 0 when rows hold it and none admits the caller,
// and -1 when no row holds it or the table can't be read. A row holds the id
// when its stored text has it, in any field.
priv table_blob_read: fn<K: [Encode, Decode, Comparable], T: [Encode, Decode]>(table: Table<K, T>, id: String) -[DB.Read]> Int Never! {
    rows: table_rows<K, T>(table, "instr({TABLE_ROW_COLUMN}, ?) > 0", [DBValue]{.Text(id.copy())}, None) ?? return -1
    if rows.len() == 0 -> return -1
    loop stored in rows {
        row: table_decode<T>(stored) ?? next
        allowed: table_allows<K, T>(table, row, Op.Read) ?? next
        if allowed -> return 1
    }
    0
}

// The stored row's field columns, which a filter written as SQL compares
// (`__query_filter`): one per top-level scalar field of its encoding, named
// `jet_row.<field>`. A row that is not a record has none.
priv table_fields: fn(row: Dyn) -> [{column: String, value: DBValue}] Never! {
    cells := [{column: String, value: DBValue}]{}
    if !(row == .Object(_)) -> return cells
    loop entry in stream.object_entries(row) {
        if !sql_identifier(entry.key.bytes()) -> next
        if entry.value == {
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Text(_) -> {
                cells.push({column: "{TABLE_ROW_COLUMN}.{entry.key}", value: table_value(entry.value)})
            }
            .Bytes(_) | .Number(_) | .DateTime(_) | .Array(_) | .Object(_) -> {}
        }
    }
    cells
}

// The field columns of `fields` that table `name` has. A table has those of
// the first row written to it, as it was created; one created before it kept
// field columns has none, and a condition over a column it lacks reads the
// whole table (`table_rows`).
priv table_columns: fn(driver: &DBDriver, name: String, fields: [{column: String, value: DBValue}]) -> [{column: String, value: DBValue}] DBError! {
    known: __driver_query(driver, "PRAGMA table_info(\"{name}\")", [DBValue]{}) ?? return Err(err)
    names := [String]{}
    loop column in known -> names.push(row_text(column, "name") ?? "")
    kept := [{column: String, value: DBValue}]{}
    loop field in fields {
        if names.contains(field.column) {
            kept.push({column: field.column.copy(), value: field.value.copy()})
        }
    }
    Ok(kept)
}

// The key columns and values of an encoded key: one per field of a record
// key, else the one column `key`. A key field can't take the name of the
// row column, nor of a search index's word column.
priv table_cells: fn(name: String, key: Dyn) -> [{column: String, value: DBValue}] DBError! {
    if !sql_identifier(name.bytes()) -> return Err(table_name_error(name))
    cells := [{column: String, value: DBValue}]{}
    if !(key == .Object(_)) {
        cells.push({column: TABLE_KEY_COLUMN, value: table_value(key)})
        return Ok(cells)
    }
    loop entry in stream.object_entries(key) {
        if !sql_identifier(entry.key.bytes()) || entry.key == TABLE_ROW_COLUMN || entry.key == TABLE_WORD_COLUMN {
            return Err(db_error("table `{name}` cannot have the key column `{entry.key}`"))
        }
        cells.push({column: entry.key.copy(), value: table_value(entry.value)})
    }
    if cells.len() == 0 -> return Err(db_error("table `{name}` has a key with no fields"))
    Ok(cells)
}

// A key field's column value: a scalar as itself, anything else as its JSON
// text.
priv table_value: fn(value: Dyn) -> DBValue Never! {
    if value == {
        .Null -> DBValue.Null
        .Bool(flag) -> DBValue.Bool(flag)
        .Int(number) -> DBValue.Int(number)
        .Float(number) -> DBValue.Float(number)
        .Text(text) -> DBValue.Text(text)
        .Bytes(bytes) -> DBValue.Blob(bytes)
        .Number(_) | .DateTime(_) | .Array(_) | .Object(_) -> DBValue.Text(json.to_string(value) ?? panic("a decoded key field always encodes as JSON"))
    }
}

priv table_match: fn(cells: [{column: String, value: DBValue}]) -> String Never! {
    terms := [String]{}
    loop cell in cells -> terms.push("\"{cell.column}\" = ?")
    terms.join(" AND ")
}

priv table_values: fn(cells: [{column: String, value: DBValue}]) -> [DBValue] Never! {
    values := [DBValue]{}
    loop cell in cells -> values.push(cell.value.copy())
    values
}

priv table_name_error: fn(name: String) -> DBError Never! {
    db_error("`{name}` is not a table name: use letters, digits and `_`")
}

priv table_exists: fn(driver: &DBDriver, name: String) -> Bool Never! {
    found: __driver_query(driver, "SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?", [DBValue]{.Text(name.copy())}) ?? return false
    found.len() > 0
}

// A read of a typed table: a table no write has created yet holds no rows.
// Made while a live binding's source runs, it joins that binding's read set
// first (app.live_reads), even before the table exists, so the write that
// creates it re-runs the binding: as the whole table, or as the table
// narrowed by the stored-row `condition` that selects what it reads.
priv table_read: fn(driver: &DBDriver, name: String, sql: String, values: [DBValue], narrowed: {condition: String, values: [String]}?) -> [[String:DBValue]] DBError! {
    if app.live_reads.running() {
        if narrowed == .Val(read) {
            app.live_reads.record_where(live_source(name), read.condition, read.values)
        } else { app.live_reads.record(live_source(name)) }
    }
    if !table_exists(driver, name) -> return Ok([[String:DBValue]]{})
    __driver_query(driver, sql, values)
}

// A stored row, read back through its type's storage codec.
priv table_decode: fn<T: Decode>(stored: [String:DBValue]) -> T DBError! {
    text: row_text(stored, TABLE_ROW_COLUMN) ?? return Err(err)
    tree: json.parse(text) ?? return Err(db_error("a stored row is not JSON: {err}"))
    if tree.decode_stored<T>() == {
        .Ok(value) -> Ok(value)
        .Err(failures) -> Err(db_error("a stored row does not decode: {failures[0].reason}"))
    }
}

// The in-memory databases opened so far, which name each one's store.
priv DB_MEMORY_OPENED: Shared{0}

// A database file whose outbox keeps jobs is named to app.jobs as it opens,
// so a serving server takes from it the jobs no server holds, such as those
// a server that stopped left. Each database file is named to app.push as it
// opens, so the devices accounts register for pushes are kept in it, and to
// app.reply_cache, so the servers that share it share the replies a
// `.Public` cache policy keeps.
priv db_open: fn(path: String, failure: String) -> Store Never! {
    driver := __driver_open(path) ?? panic(failure)
    store := path.copy()
    if path == ":memory:" {
        opened := DB_MEMORY_OPENED.guard_edit()
        opened.value += 1
        store = ":memory: {opened.value}"
    }
    jobs: path != ":memory:" && table_exists(driver, "__jet_jobs")
    state: Shared{DBState{driver: driver.move(), path: path.copy(), store: store.copy(), written: [DBWritten]{}, ended: Condition.new()}}
    if jobs -> app.jobs.store(db_outbox(state, store))
    if path != ":memory:" -> app.push.store(db_push_devices(state, store))
    if path != ":memory:" -> app.reply_cache.store(db_kept_replies(state, store))
    Store{state: state}
}

open: fn(path: String) -[DB]> Store Never! { db_open(path, "database open failed") }

open_memory: fn() -[DB]> Store Never! { db_open(":memory:", "in-memory database open failed") }

// A `begin` waits for a call's transaction on the connection to end first
// (`db_free`); a call is one transaction already, so it can't begin one.
priv db_begin: fn(state: Shared<DBState>, immediate: Bool) -> DBTransaction DBError! {
    if app.transactions.current() != None {
        return Err(db_error("could not begin a transaction: a mounted method's call is one already, which commits when it succeeds"))
    }
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return Err(db_waited())
    db_join(guard.value, state, 0) ?? return Err(err)
    began: if immediate -> __driver_begin_immediate(guard.value.driver) else -> __driver_begin(guard.value.driver)
    if !began {
        return Err(db_error("could not begin a transaction: one is already open, or the database is busy"))
    }
    guard.value.written = [DBWritten]{}
    guard.value.began += 1
    guard.value.open = guard.value.began
    Ok(DBTransaction{state: state.copy(), number: guard.value.open})
}

// Whether transaction `number` is the one still open on `state`.
priv db_open_is: fn(state: Shared<DBState>, number: Int) -> Bool Never! {
    guard: state.guard_read()
    guard.value.open == number
}

// A commit that fails leaves the engine's transaction open, so it is rolled
// back before the failure is reported: the transaction ends either way.
// Either way every live binding over a table it wrote re-runs on its next
// read: after a commit it reads the committed rows, and after a failed one
// it drops anything read from the transaction's own uncommitted writes. The
// statements waiting for the transaction to end go on (`db_free`).
priv db_commit: fn(state: Shared<DBState>) DBError! {
    guard := state.guard_edit()
    guard.value.open = 0
    guard.value.call = 0
    guard.value.ended.notify_all()
    if driver_closed(guard.value.driver) {
        return Err(db_error("could not commit: the database is closed"))
    }
    committed: __driver_commit(guard.value.driver)
    if !committed -> _: __driver_rollback(guard.value.driver)
    loop written in guard.value.written {
        db_live_wrote(guard.value.driver, written.table, written.rows)
        if committed -> db_live_bump(guard.value, written.table)
    }
    if committed && guard.value.written.len() > 0 -> db_kept_written(guard.value)
    guard.value.written = [DBWritten]{}
    if !committed -> return Err(db_error("could not commit, so the transaction was rolled back"))
    Ok()
}

// A rollback undoes the writes since the last begin, so every live binding
// over a table they touched re-runs on its next read.
priv db_rollback: fn(state: Shared<DBState>) DBError! {
    guard := state.guard_edit()
    guard.value.open = 0
    guard.value.call = 0
    guard.value.ended.notify_all()
    if driver_closed(guard.value.driver) {
        return Err(db_error("could not roll back: the database is closed"))
    }
    rolled: __driver_rollback(guard.value.driver)
    loop written in guard.value.written {
        db_live_wrote(guard.value.driver, written.table, written.rows)
    }
    guard.value.written = [DBWritten]{}
    if !rolled -> return Err(db_error("could not roll back the transaction"))
    Ok()
}

// Each statement readies the connection it holds in two steps. A mounted
// method's call (app.transactions) runs as one IMMEDIATE transaction on each
// store it uses: its first statement on the connection begins one, once no
// other transaction is open there, and joins it to the call, which commits or
// rolls it back as it ends. While a call's transaction is open, another
// task's statement waits until it ends, so no statement outside the call
// reads its rows before they commit or writes among them. So a statement
// first waits on `db_ended` until `db_free` holds, then `db_join`s.
priv db_ended: fn(held: DBState) -> Condition Never! { held.ended.copy() }

// Whether a statement of call `call` (0: of no call) may run now.
priv db_free: fn(held: DBState, call: Int) -> Bool Never! {
    held.call == call || (held.call == 0 && (call == 0 || held.open == 0))
}

priv db_waited: fn() -> DBError Never! {
    db_error("the wait for another call's transaction ended early")
}

// Begins call `call`'s transaction on the connection when this is its first
// statement there. A store that stays busy past the connection's wait
// (another connection holds its write lock) refuses the call, and every
// later statement of the attempt fails at once; the framework then runs the
// call again. A webhook's call records its delivery's ID, and a schedule's
// call its due run, in the transaction it begins (`db_ran`); when the store
// has run that delivery or that run already, or keeps a reply under the
// call's request key, the call is repeated, every later statement of it
// fails at once, and the framework rolls it back and drops it.
priv db_join: fn(held: &DBState, state: Shared<DBState>, call: Int) DBError! {
    if driver_closed(held.driver) -> return Err(db_closed())
    if call == 0 -> return Ok()
    if app.transactions.repeated(call) -> return Err(db_repeated())
    if held.call == call -> return Ok()
    if app.transactions.refused(call) || !__driver_begin_immediate(held.driver) {
        app.transactions.refuse(call)
        return Err(db_error("the database is busy, so the call runs again"))
    }
    held.written = [DBWritten]{}
    held.began += 1
    held.open = held.began
    held.call = call
    app.transactions.join(call, fn(commit: Bool) { db_end(state, commit) }, db_outbox(state, held.store))
    if db_ran(held.driver, call) == {
        .Ok(ran) -> {
            if !ran -> return Ok()
            app.transactions.repeat(call)
            Err(db_repeated())
        }
        .Err(failure) -> {
            app.transactions.refuse(call)
            Err(failure)
        }
    }
}

priv db_repeated: fn() -> DBError Never! {
    db_error("the call's delivery, scheduled run or request has run already, so it is dropped")
}

// Whether the store has run call `call` already, as the webhook delivery
// (`db_delivered`), the schedule's run (`db_scheduled`) or the request
// (`db_requested`) it is; when not, records a delivery or a run in the
// call's transaction. False for any other call.
priv db_ran: fn(driver: &DBDriver, call: Int) -> Bool DBError! {
    if app.transactions.delivery(call) == .Val(delivery) -> return db_delivered(driver, delivery)
    if app.transactions.tick(call) == .Val(tick) -> return db_scheduled(driver, tick)
    if app.transactions.request(call) == .Val(request) -> return db_requested(driver, call, request)
    Ok(false)
}

// Whether the store has recorded a run of `tick`'s schedule due when it is
// or later; when not, records `tick` as the schedule's latest run, in the
// open transaction. The table `__jet_schedules` keeps one row per schedule.
// A rollback forgets it with the rest of the run, so a failed run is run
// again when a server starts while it is still the latest due.
priv db_scheduled: fn(driver: &DBDriver, tick: app.CallTick) -> Bool DBError! {
    _: __driver_execute(driver, "CREATE TABLE IF NOT EXISTS __jet_schedules (name TEXT PRIMARY KEY, due INTEGER NOT NULL)", [DBValue]{}) ?? return Err(err)
    if __driver_query_one(driver, "SELECT due FROM __jet_schedules WHERE name = ?", [DBValue]{.Text(tick.schedule.copy())}) == {
        .Ok(found) -> {
            if found == .Val(row) {
                if row.get("due") == .Val(.Int(due)) {
                    if due >= tick.due -> return Ok(true)
                }
            }
        }
        .Err(failure) -> return Err(failure)
    }
    _: __driver_execute(driver, "INSERT OR REPLACE INTO __jet_schedules (name, due) VALUES (?, ?)", [DBValue]{.Text(tick.schedule.copy()), .Int(tick.due)}) ?? return Err(err)
    Ok(false)
}

// A store keeps the ID of each webhook delivery it has run this long, in
// seconds: 30 days.
priv DB_DELIVERY_KEPT: 2592000

// Whether the store has run `delivery` in the 30 days before it came; when
// not, records it, in the open transaction, as run when it came, and forgets
// the deliveries kept longer. A rollback forgets it with the rest of the
// call, so a failed run is run again when the sender delivers it again.
priv db_delivered: fn(driver: &DBDriver, delivery: app.CallDelivery) -> Bool DBError! {
    _: __driver_execute(driver, "CREATE TABLE IF NOT EXISTS __jet_deliveries (id TEXT PRIMARY KEY, at INTEGER NOT NULL)", [DBValue]{}) ?? return Err(err)
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS __jet_deliveries_at ON __jet_deliveries (at)", [DBValue]{}) ?? return Err(err)
    _: __driver_execute(driver, "DELETE FROM __jet_deliveries WHERE at < ?", [DBValue]{.Int(delivery.at - DB_DELIVERY_KEPT)}) ?? return Err(err)
    if __driver_query_one(driver, "SELECT id FROM __jet_deliveries WHERE id = ?", [DBValue]{.Text(delivery.id.copy())}) == {
        .Ok(found) -> {
            if found != None -> return Ok(true)
        }
        .Err(failure) -> return Err(failure)
    }
    _: __driver_execute(driver, "INSERT INTO __jet_deliveries (id, at) VALUES (?, ?)", [DBValue]{.Text(delivery.id.copy()), .Int(delivery.at)}) ?? return Err(err)
    Ok(false)
}

// A store keeps the reply of each request it has run this long, in
// seconds: 24 hours.
priv DB_REQUEST_KEPT: 86400

// The table of the replies of requests a store has run, one row per
// account and request key.
priv DB_REQUESTS_TABLE: "CREATE TABLE IF NOT EXISTS __jet_requests (account TEXT NOT NULL, key TEXT NOT NULL, at INTEGER NOT NULL, reply TEXT NOT NULL, PRIMARY KEY (account, key))"

// Whether the store keeps a reply under `request`'s account and key from
// the 24 hours before it came; when it does, gives call `call` that reply.
// Forgets the replies kept longer.
priv db_requested: fn(driver: &DBDriver, call: Int, request: app.CallRequest) -> Bool DBError! {
    _: __driver_execute(driver, DB_REQUESTS_TABLE, [DBValue]{}) ?? return Err(err)
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS __jet_requests_at ON __jet_requests (at)", [DBValue]{}) ?? return Err(err)
    _: __driver_execute(driver, "DELETE FROM __jet_requests WHERE at < ?", [DBValue]{.Int(request.at - DB_REQUEST_KEPT)}) ?? return Err(err)
    if __driver_query_one(driver, "SELECT reply FROM __jet_requests WHERE account = ? AND key = ?", [DBValue]{.Text(request.account.copy()), .Text(request.key.copy())}) == {
        .Ok(found) -> {
            if found == .Val(row) {
                if row.get("reply") == .Val(.Text(reply)) {
                    app.transactions.answer(call, reply)
                    return Ok(true)
                }
            }
        }
        .Err(failure) -> return Err(failure)
    }
    Ok(false)
}

// Keeps `reply` as the reply of `request`: in the transaction of call
// `call`, or, for call 0, on its own once no call's transaction is open on
// the connection. False when the store couldn't. A request whose reply the
// store keeps already keeps that one.
priv db_request_keep: fn(state: Shared<DBState>, call: Int, request: app.CallRequest, reply: String) -> Bool Never! {
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return false
    if driver_closed(guard.value.driver) -> return false
    _: __driver_execute(guard.value.driver, DB_REQUESTS_TABLE, [DBValue]{}) ?? return false
    values: [DBValue]{.Text(request.account.copy()), .Text(request.key.copy()), .Int(request.at), .Text(reply.copy())}
    __driver_execute(guard.value.driver, "INSERT OR IGNORE INTO __jet_requests (account, key, at, reply) VALUES (?, ?, ?, ?)", values) == .Ok(_)
}

// Ends a call's transaction on `state`: commits it, or rolls it back when
// `commit` is false; false when that failed.
priv db_end: fn(state: Shared<DBState>, commit: Bool) -> Bool Never! {
    if commit -> return db_commit(state) == .Ok(_)
    db_rollback(state) == .Ok(_)
}

// The store's outbox (app.CallOutbox): the table `__jet_jobs`, a row for
// each job a committed call queued that hasn't run yet, found by its key and
// taken until its `due` time (Unix milliseconds). A job that failed every
// run keeps its row, which records the runs and the last error and is
// taken for good.
priv db_outbox: fn(state: Shared<DBState>, store: String) -> app.CallOutbox Never! {
    app.CallOutbox{
        store: store.copy(),
        now: fn() { db_job_now() },
        keep: fn(job: String, args: String, until: Int) { db_job_keep(state, job, args, until) },
        done: fn(key: String) { db_job_done(state, key) },
        failed: fn(key: String, runs: Int, error: String, until: Int) { db_job_failed(state, key, runs, error, until) },
        take: fn(names: [String], now: Int, until: Int) { db_job_take(state, names, now, until) },
        hold: fn(keys: [String], until: Int) { db_job_hold(state, keys, until) },
        answered: fn(call: Int, request: app.CallRequest, reply: String) { db_request_keep(state, call, request, reply) },
    }
}

// The time it is by the store's clock, the one SQLite's `'now'` reads, in
// Unix milliseconds.
priv db_job_now: fn() -> Int Never! { os.os_unix_ms() }

// Keeps job `job` with its encoded arguments, taken until `until`, in the
// transaction the call running on this task has open on the store; its
// key, a random one the store makes, or "" when that failed.
priv db_job_keep: fn(state: Shared<DBState>, job: String, args: String, until: Int) -> String Never! {
    guard := state.guard_edit()
    _: __driver_execute(guard.value.driver, "CREATE TABLE IF NOT EXISTS __jet_jobs (key TEXT PRIMARY KEY, job TEXT NOT NULL, args TEXT NOT NULL, runs INTEGER NOT NULL DEFAULT 0, error TEXT, due INTEGER NOT NULL)", [DBValue]{}) ?? return ""
    _: __driver_execute(guard.value.driver, "CREATE INDEX IF NOT EXISTS __jet_jobs_due ON __jet_jobs (due)", [DBValue]{}) ?? return ""
    _: __driver_execute(guard.value.driver, "INSERT INTO __jet_jobs (key, job, args, due) VALUES (lower(hex(randomblob(16))), ?, ?, ?)", [DBValue]{.Text(job.copy()), .Text(args.copy()), .Int(until)}) ?? return ""
    found: __driver_query_one(guard.value.driver, "SELECT key FROM __jet_jobs WHERE rowid = last_insert_rowid()", [DBValue]{}) ?? return ""
    row_text(found, "key") ?? ""
}

// Deletes the outbox row of key `key` in the call running on this task, as
// its job runs in that call: 1; 0 when another run has deleted it; -1 when
// the store couldn't.
priv db_job_done: fn(state: Shared<DBState>, key: String) -> Int Never! {
    guard := state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return -1
    if db_join(guard.value, state, call) == .Err(_) -> return -1
    __driver_execute(guard.value.driver, "DELETE FROM __jet_jobs WHERE key = ?", [DBValue]{.Text(key.copy())}) ?? -1
}

// Records on the outbox row of key `key` that its job ran `runs` times and
// failed each time, the last with `error`, and takes it until `until`;
// false when the store couldn't.
priv db_job_failed: fn(state: Shared<DBState>, key: String, runs: Int, error: String, until: Int) -> Bool Never! {
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return false
    if db_join(guard.value, state, 0) == .Err(_) -> return false
    __driver_execute(guard.value.driver, "UPDATE __jet_jobs SET runs = ?, error = ?, due = ? WHERE key = ?", [DBValue]{.Int(runs), .Text(error.copy()), .Int(until), .Text(key.copy())}) == .Ok(_)
}

// The outbox rows of keys `keys` are taken until `until`, unless they are
// taken longer; false when the store couldn't.
priv db_job_hold: fn(state: Shared<DBState>, keys: [String], until: Int) -> Bool Never! {
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return false
    if db_join(guard.value, state, 0) == .Err(_) -> return false
    values := [DBValue]{.Int(until), .Int(until)}
    loop key in keys -> values.push(.Text(key.copy()))
    __driver_execute(guard.value.driver, "UPDATE __jet_jobs SET due = ? WHERE due < ? AND key IN ({db_marks(keys.len())})", values) == .Ok(_)
}

// The most outbox rows one take takes.
priv DB_JOBS_TAKEN: 64

// Takes, in one IMMEDIATE transaction, the outbox rows of jobs named in
// `names` that are not taken at `now`, until `until`, and gives each; one
// that another server took first is left to it. Gives none when the store
// is busy or keeps no jobs, and None once it has closed.
priv db_job_take: fn(state: Shared<DBState>, names: [String], now: Int, until: Int) -> [app.CallQueued]? Never! {
    taken := [app.CallQueued]{}
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return Val(taken)
    if driver_closed(guard.value.driver) -> return None
    if !table_exists(guard.value.driver, "__jet_jobs") -> return Val(taken)
    sql: "SELECT key, job, args, runs FROM __jet_jobs WHERE due <= ? AND job IN ({db_marks(names.len())}) ORDER BY due LIMIT {DB_JOBS_TAKEN}"
    values := [DBValue]{.Int(now)}
    loop name in names -> values.push(.Text(name.copy()))
    due: __driver_query(guard.value.driver, sql, values) ?? return Val(taken)
    if due.len() == 0 || !__driver_begin_immediate(guard.value.driver) -> return Val(taken)
    rows: __driver_query(guard.value.driver, sql, values) ?? [[String:DBValue]]{}
    loop row in rows {
        key: row_text(row, "key") ?? next
        job: row_text(row, "job") ?? next
        args: row_text(row, "args") ?? next
        runs: row_int(row, "runs") ?? next
        changed: __driver_execute(guard.value.driver, "UPDATE __jet_jobs SET due = ? WHERE key = ?", [DBValue]{.Int(until), .Text(key.copy())}) ?? 0
        if changed == 1 -> taken.push(app.CallQueued{key: key, name: job, args: args, runs: runs})
    }
    if !__driver_commit(guard.value.driver) {
        _: __driver_rollback(guard.value.driver)
        return Val([app.CallQueued]{})
    }
    Val(taken)
}

// `count` SQL parameter marks, comma-separated.
priv db_marks: fn(count: Int) -> String Never! {
    marks := [String]{}
    loop _ in 0..<count -> marks.push("?")
    marks.join(", ")
}

// The store's push devices (app.PushDevices): the table `__jet_push_devices`,
// a row for each device an account registered, found by its service and
// token. Each statement runs in the call this task runs, if any.
priv db_push_devices: fn(state: Shared<DBState>, store: String) -> app.PushDevices Never! {
    app.PushDevices{
        store: store.copy(),
        add: fn(device: app.PushDevice) { db_push_add(state, device) },
        of: fn(account: String) { db_push_of(state, account) },
        forget: fn(service: String, token: String) { db_push_forget(state, service, token) },
    }
}

// Registers `device` in place of the row of its service and token; false
// when the store couldn't.
priv db_push_add: fn(state: Shared<DBState>, device: app.PushDevice) -> Bool Never! {
    guard := state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return false
    if db_join(guard.value, state, call) == .Err(_) -> return false
    _: __driver_execute(guard.value.driver, "CREATE TABLE IF NOT EXISTS __jet_push_devices (service TEXT NOT NULL, token TEXT NOT NULL, account TEXT NOT NULL, key TEXT NOT NULL, auth TEXT NOT NULL, PRIMARY KEY (service, token))", [DBValue]{}) ?? return false
    _: __driver_execute(guard.value.driver, "CREATE INDEX IF NOT EXISTS __jet_push_devices_account ON __jet_push_devices (account)", [DBValue]{}) ?? return false
    values: [DBValue]{.Text(device.service.copy()), .Text(device.token.copy()), .Text(device.account.copy()), .Text(device.key.copy()), .Text(device.auth.copy())}
    __driver_execute(guard.value.driver, "INSERT OR REPLACE INTO __jet_push_devices (service, token, account, key, auth) VALUES (?, ?, ?, ?, ?)", values) == .Ok(_)
}

// The devices `account` registered, in the order they registered; None
// when the store couldn't read them.
priv db_push_of: fn(state: Shared<DBState>, account: String) -> [app.PushDevice]? Never! {
    found := [app.PushDevice]{}
    guard := state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return None
    if db_join(guard.value, state, call) == .Err(_) -> return None
    if !table_exists(guard.value.driver, "__jet_push_devices") -> return Val(found)
    rows: __driver_query(guard.value.driver, "SELECT service, token, key, auth FROM __jet_push_devices WHERE account = ? ORDER BY rowid", [DBValue]{.Text(account.copy())}) ?? return None
    loop row in rows {
        service: row_text(row, "service") ?? next
        token: row_text(row, "token") ?? next
        key: row_text(row, "key") ?? next
        auth: row_text(row, "auth") ?? next
        found.push(app.PushDevice{account: account.copy(), service: service, token: token, key: key, auth: auth})
    }
    Val(found)
}

// Forgets the device of `service` and `token`; false when the store
// couldn't.
priv db_push_forget: fn(state: Shared<DBState>, service: String, token: String) -> Bool Never! {
    guard := state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return false
    if db_join(guard.value, state, call) == .Err(_) -> return false
    if !table_exists(guard.value.driver, "__jet_push_devices") -> return true
    __driver_execute(guard.value.driver, "DELETE FROM __jet_push_devices WHERE service = ? AND token = ?", [DBValue]{.Text(service.copy()), .Text(token.copy())}) == .Ok(_)
}

// The table of the replies a `.Public` cache policy keeps: a row for each,
// found by its key, with the instants it was kept and the last one it is
// fresh at, in Unix milliseconds by the store's clock.
priv DB_KEPT_REPLIES_TABLE: "CREATE TABLE IF NOT EXISTS __jet_kept_replies (key TEXT PRIMARY KEY, reply TEXT NOT NULL, kept INTEGER NOT NULL, fresh INTEGER NOT NULL)"

// The store's kept replies (app.KeptReplies), in the table
// `__jet_kept_replies`. Each statement runs on its own, once no call's
// transaction is open on the store, as a kept reply outlives the call that
// made it.
priv db_kept_replies: fn(state: Shared<DBState>, store: String) -> app.KeptReplies Never! {
    app.KeptReplies{
        store: store.copy(),
        find: fn(key: String) { db_kept_find(state, key) },
        keep: fn(key: String, reply: String, max_age_ms: Int, ran_ms: Int) { db_kept_keep(state, key, reply, max_age_ms, ran_ms) },
    }
}

// The reply kept under `key` while it is fresh by the store's clock, through
// the instant its max_age ends; None when there is none, or the store
// couldn't read it.
priv db_kept_find: fn(state: Shared<DBState>, key: String) -> app.KeptReply? Never! {
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return None
    if driver_closed(guard.value.driver) || !table_exists(guard.value.driver, "__jet_kept_replies") {
        return None
    }
    now: db_job_now()
    rows: __driver_query(guard.value.driver, "SELECT reply, kept FROM __jet_kept_replies WHERE key = ? AND fresh >= ?", [DBValue]{.Text(key.copy()), .Int(now)}) ?? return None
    if rows.len() == 0 -> return None
    reply: row_text(rows[0], "reply") ?? return None
    kept: row_int(rows[0], "kept") ?? return None
    Val(app.KeptReply{reply: reply, age_ms: now - kept})
}

// Keeps `reply`, whose run began `ran_ms` ago, under `key` for
// `max_age_ms`, in place of the row kept under it, and drops each row stale
// by now, so the table holds only fresh replies. A run that began no later
// than the last write the file took (the row under the key "",
// `db_kept_written`) may hold what it changed, so its reply is judged and
// not kept. False when the store couldn't keep or judge it.
priv db_kept_keep: fn(state: Shared<DBState>, key: String, reply: String, max_age_ms: Int, ran_ms: Int) -> Bool Never! {
    guard := state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? return false
    if driver_closed(guard.value.driver) -> return false
    _: __driver_execute(guard.value.driver, DB_KEPT_REPLIES_TABLE, [DBValue]{}) ?? return false
    _: __driver_execute(guard.value.driver, "CREATE INDEX IF NOT EXISTS __jet_kept_replies_fresh ON __jet_kept_replies (fresh)", [DBValue]{}) ?? return false
    now: db_job_now()
    written: __driver_query(guard.value.driver, "SELECT kept FROM __jet_kept_replies WHERE key = ''", [DBValue]{}) ?? return false
    if written.len() > 0 && (row_int(written[0], "kept") ?? now) >= now - ran_ms -> return true
    _: __driver_execute(guard.value.driver, "DELETE FROM __jet_kept_replies WHERE fresh < ?", [DBValue]{.Int(now)}) ?? return false
    fresh: if max_age_ms > 9223372036854775807 - now -> 9223372036854775807 else -> now + max_age_ms
    values: [DBValue]{.Text(key.copy()), .Text(reply.copy()), .Int(now), .Int(fresh)}
    __driver_execute(guard.value.driver, "INSERT OR REPLACE INTO __jet_kept_replies (key, reply, kept, fresh) VALUES (?, ?, ?, ?)", values) == .Ok(_)
}

// Once a write to a table of the database `held` reads commits: counts it
// for the replies this process keeps for itself (app.reply_cache.written),
// drops every reply the file keeps, as each may have read what the write
// changed, and marks the write's instant under the key "", so a run that
// began before it keeps nothing (`db_kept_keep`). A file that keeps no
// replies is left as it is.
priv db_kept_written: fn(held: &DBState) Never! {
    app.reply_cache.written()
    if driver_closed(held.driver) || !table_exists(held.driver, "__jet_kept_replies") {
        return
    }
    _: __driver_execute(held.driver, "DELETE FROM __jet_kept_replies", [DBValue]{}) ?? return
    values: [DBValue]{.Int(db_job_now()), .Int(9223372036854775807)}
    _: __driver_execute(held.driver, "INSERT INTO __jet_kept_replies (key, reply, kept, fresh) VALUES ('', '', ?, ?)", values) ?? return
}

#Codable
priv CallCount: struct {
    id: Int,
    count: Int,
}

// The table of the test below, and its row 1's count.
priv call_counts: fn(store: Store) -> Table<Int, CallCount> {
    store.table("counts", key: fn(row: CallCount) { row.id })
}

priv call_count: fn(counts: Table<Int, CallCount>) -> Int {
    row: counts.get(1) ?? panic("row 1 reads")
    row.count
}

#Test("a call's statements on a store are one transaction, which other tasks wait for") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    call: app.transactions.begin() ?? panic("no call is open")
    _: counts.put(CallCount{id: 1, count: 1}) ?? panic("the call writes")
    assert_eq(call_count(counts), 1)
    if store.begin() == {
        .Ok(opened) -> {
            opened.rollback() ?? panic("the rollback")
            panic("a call began a transaction of its own")
        }
        .Err(_) -> {}
    }
    reader: store.copy()
    waiting: task { call_count(call_counts(reader)) }
    assert(app.transactions.end(call, false))
    assert_eq(waiting.join() ?? panic("the waiting task reads"), 0)
    committed: app.transactions.begin() ?? panic("no call is open")
    _: counts.put(CallCount{id: 1, count: 2}) ?? panic("the call writes")
    assert(app.transactions.end(committed, true))
    assert_eq(call_count(counts), 2)
    opened: store.begin() ?? panic("no transaction is open")
    writes: store.copy()
    writer: task {
        later: app.transactions.begin() ?? panic("the task runs no call")
        _: call_counts(writes).put(CallCount{id: 1, count: 3}) ?? panic("the call writes once the transaction ends")
        app.transactions.end(later, true)
    }
    opened.rollback() ?? panic("the rollback")
    assert(writer.join() ?? panic("the writer ends"))
    assert_eq(call_count(counts), 3)
}

// One webhook call of delivery `id`, which came at second `at`, that writes
// `count` to row 1 and commits when `commit` holds; whether the store had run
// the delivery.
priv call_deliver: fn(counts: Table<Int, CallCount>, id: String, at: Int, count: Int, commit: Bool) -> Bool {
    call: app.transactions.begin() ?? panic("no call is open")
    app.transactions.deliver(call, app.CallDelivery{id: id, at: at})
    if counts.put(CallCount{id: 1, count: count}) == {
        .Ok(_) -> {}
        .Err(failure) -> assert(app.transactions.repeated(call), failure.message())
    }
    repeated: app.transactions.repeated(call)
    assert(app.transactions.end(call, commit))
    repeated
}

#Test("a delivery's call records its ID in its transaction, and a store drops a delivery it has run in the 30 days before") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    came: 1000000000
    // A run that rolls back forgets the delivery, which then runs again.
    assert(!call_deliver(counts, "d-1", came, 1, false))
    assert_eq(call_count(counts), 0)
    assert(!call_deliver(counts, "d-1", came, 2, true))
    assert_eq(call_count(counts), 2)
    assert(call_deliver(counts, "d-1", came + 1, 3, true))
    assert_eq(call_count(counts), 2)
    assert(!call_deliver(counts, "d-2", came, 4, true))
    assert_eq(call_count(counts), 4)
    // Kept for 30 days, and forgotten a second later.
    assert(call_deliver(counts, "d-2", came + DB_DELIVERY_KEPT, 5, true))
    assert_eq(call_count(counts), 4)
    assert(!call_deliver(counts, "d-2", came + DB_DELIVERY_KEPT + 1, 6, true))
    assert_eq(call_count(counts), 6)
    assert(!call_deliver(counts, "d-1", came + DB_DELIVERY_KEPT + 1, 7, true))
    assert_eq(call_count(counts), 7)
}

// One call of request `key` of `account`, which came at second `at`, that
// writes `count` to `counts` and replies "reply {count}", committing when
// `commit` holds; the reply the call ends with: its own, or one the store
// kept under the key.
priv call_request: fn(counts: Table<Int, CallCount>, account: String, key: String, at: Int, count: Int, commit: Bool) -> String {
    call: app.transactions.begin() ?? panic("no call is open")
    app.transactions.ask(call, app.CallRequest{account: account, key: key, at: at})
    if counts.put(CallCount{id: 1, count: count}) == {
        .Ok(_) -> {}
        .Err(failure) -> assert(app.transactions.repeated(call), failure.message())
    }
    app.transactions.answer(call, "reply {count}")
    reply: app.transactions.reply(call) ?? panic("the call has a reply")
    assert(app.transactions.end(call, commit))
    reply
}

#Test("a request's call keeps its reply under its account and key, and the store answers the request sent again with that reply for 24 hours") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    came: 1000000000
    // A run that commits keeps its reply with its writes.
    assert_eq(call_request(counts, "ann", "k-1", came, 1, true), "reply 1")
    assert_eq(call_count(counts), 1)
    // Sent again under the key, it gets the kept reply and writes nothing.
    assert_eq(call_request(counts, "ann", "k-1", came + 1, 2, true), "reply 1")
    assert_eq(call_count(counts), 1)
    // Another account's key is its own.
    assert_eq(call_request(counts, "ben", "k-1", came, 3, true), "reply 3")
    assert_eq(call_count(counts), 3)
    // A run that fails rolls back its writes and keeps its reply on its own.
    assert_eq(call_request(counts, "ann", "k-2", came, 4, false), "reply 4")
    assert_eq(call_count(counts), 3)
    assert_eq(call_request(counts, "ann", "k-2", came, 5, true), "reply 4")
    assert_eq(call_count(counts), 3)
    // Kept for 24 hours, and forgotten a second later.
    assert_eq(call_request(counts, "ann", "k-1", came + DB_REQUEST_KEPT, 6, true), "reply 1")
    assert_eq(call_count(counts), 3)
    assert_eq(call_request(counts, "ann", "k-1", came + DB_REQUEST_KEPT + 1, 7, true), "reply 7")
    assert_eq(call_count(counts), 7)
}

// One run of schedule `schedule`, due at second `due`, that writes `count`
// to `counts`; whether the store had recorded that run, or a later one.
priv call_schedule: fn(counts: Table<Int, CallCount>, schedule: String, due: Int, count: Int, commit: Bool) -> Bool {
    call: app.transactions.begin() ?? panic("no call is open")
    app.transactions.schedule(call, app.CallTick{schedule: schedule, due: due})
    if counts.put(CallCount{id: 1, count: count}) == {
        .Ok(_) -> {}
        .Err(failure) -> assert(app.transactions.repeated(call), failure.message())
    }
    repeated: app.transactions.repeated(call)
    assert(app.transactions.end(call, commit))
    repeated
}

#Test("a schedule's run records itself in its transaction, and a store drops a run of a time it has run, or run past") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    // A run that rolls back records nothing, so it runs again.
    assert(!call_schedule(counts, "s.remind", 600, 1, false))
    assert_eq(call_count(counts), 0)
    assert(!call_schedule(counts, "s.remind", 600, 2, true))
    assert_eq(call_count(counts), 2)
    // That run, or an earlier one, is dropped; a later one runs.
    assert(call_schedule(counts, "s.remind", 600, 3, true))
    assert(call_schedule(counts, "s.remind", 540, 4, true))
    assert_eq(call_count(counts), 2)
    assert(!call_schedule(counts, "s.remind", 660, 5, true))
    assert_eq(call_count(counts), 5)
    // Each schedule keeps its own latest run.
    assert(!call_schedule(counts, "s.sweep", 600, 6, true))
    assert_eq(call_count(counts), 6)
}

// The services and tokens of the devices `account` registered in `devices`.
priv db_push_test_of: fn(devices: app.PushDevices, account: String) -> String {
    found: devices.of(account) ?? panic("the devices read")
    listed := [String]{}
    loop device in found -> listed.push("{device.service} {device.token}")
    listed.join(", ")
}

#Test("a store keeps one push device per service and token, for the account that registered it last") {
    store: open_memory()
    devices: db_push_devices(store.state, "db.Test push devices")
    assert_eq(db_push_test_of(devices, "acct_ann"), "")
    assert(devices.forget("apns", "a1"))
    assert(devices.add(app.PushDevice{account: "acct_ann", service: "apns", token: "a1", key: "", auth: ""}))
    assert(devices.add(app.PushDevice{account: "acct_ann", service: "fcm", token: "f1", key: "", auth: ""}))
    assert(devices.add(app.PushDevice{account: "acct_ann", service: "web", token: "https://push.example.net/1", key: "BKey", auth: "secret"}))
    assert_eq(db_push_test_of(devices, "acct_ann"), "apns a1, fcm f1, web https://push.example.net/1")
    // The same token on the same service moves to the account that registers it.
    assert(devices.add(app.PushDevice{account: "acct_bo", service: "fcm", token: "f1", key: "", auth: ""}))
    // Another service's token of the same text is another device.
    assert(devices.add(app.PushDevice{account: "acct_bo", service: "apns", token: "f1", key: "", auth: ""}))
    assert_eq(db_push_test_of(devices, "acct_ann"), "apns a1, web https://push.example.net/1")
    assert_eq(db_push_test_of(devices, "acct_bo"), "fcm f1, apns f1")
    web: devices.of("acct_ann") ?? panic("the devices read")
    assert_eq("{web[1].key} {web[1].auth}", "BKey secret")
    assert(devices.forget("apns", "a1"))
    assert_eq(db_push_test_of(devices, "acct_ann"), "web https://push.example.net/1")
    // The registry registers in the first store named that takes a device.
    app.push.store(db_push_devices(store.state, "db.Test push devices"))
    assert(app.push.register(app.PushDevice{account: "acct_cy", service: "apns", token: "c1", key: "", auth: ""}))
    assert_eq(db_push_test_of(devices, "acct_cy"), "apns c1")
    assert_eq(app.push.devices("acct_cy").len(), 1)
    app.push.forget("apns", "c1")
    assert_eq(app.push.devices("acct_cy").len(), 0)
    assert(store.close())
    assert(devices.of("acct_ann") == None)
}

// How many replies the store keeps, fresh or stale.
priv db_kept_count: fn(store: Store) -> Int {
    guard := store.state.guard_edit()
    found: __driver_query_one(guard.value.driver, "SELECT count(*) AS n FROM __jet_kept_replies", [DBValue]{}) ?? panic("the kept replies read")
    if found.get("n") == .Val(.Int(n)) -> n else -> -1
}

// Keeps a reply under `key` whose max_age ended long ago.
priv db_kept_stale: fn(store: Store, key: String) {
    guard := store.state.guard_edit()
    _: __driver_execute(guard.value.driver, "INSERT OR REPLACE INTO __jet_kept_replies (key, reply, kept, fresh) VALUES (?, 'stale', 0, 1)", [DBValue]{.Text(key.copy())}) ?? panic("the stale reply writes")
}

#Test("a store keeps a reply under its key while it is fresh, drops the stale ones as it keeps another, and drops them all at a committed write") {
    store: open_memory()
    replies: db_kept_replies(store.state, "db.Test kept replies")
    assert(replies.find("/api/board [1]") == None)
    assert(replies.keep("/api/board [1]", "{{\"ok\":false}}", 600000, 0))
    found: replies.find("/api/board [1]") ?? panic("the kept reply reads")
    assert_eq(found.reply, "{{\"ok\":false}}")
    assert(found.age_ms >= 0 && found.age_ms < 600000)
    assert(replies.find("/api/board [2]") == None)
    db_kept_stale(store, "/api/board [3]")
    assert(replies.find("/api/board [3]") == None)
    assert_eq(db_kept_count(store), 2)
    assert(replies.keep("/api/board [1]", "{{\"ok\":true}}", 600000, 0))
    assert_eq(db_kept_count(store), 1)
    assert_eq((replies.find("/api/board [1]") ?? panic("the kept reply reads")).reply, "{{\"ok\":true}}")
    // A max_age past the end of the store's clock keeps the reply, and does not wrap.
    assert(replies.keep("/api/board [4]", "{{\"ok\":0}}", 9223372036854775807, 0))
    assert(replies.find("/api/board [4]") != None)
    // A committed write drops every kept reply. A reply whose run began
    // before the write is judged but not kept; one whose run began after it is.
    writes: app.reply_cache.writes()
    _: call_counts(store).put(CallCount{id: 1, count: 1}) ?? panic("the write commits")
    assert(app.reply_cache.writes() > writes)
    assert(replies.find("/api/board [1]") == None)
    assert(replies.find("/api/board [4]") == None)
    assert(replies.keep("/api/board [1]", "{{\"ok\":1}}", 600000, 60000))
    assert(replies.find("/api/board [1]") == None)
    core.tasks.sleep(2)
    assert(replies.keep("/api/board [1]", "{{\"ok\":2}}", 600000, 0))
    assert_eq((replies.find("/api/board [1]") ?? panic("the reply after the write is kept")).reply, "{{\"ok\":2}}")
    assert(store.close())
    assert(replies.find("/api/board [1]") == None)
    assert(!replies.keep("/api/board [1]", "{{\"ok\":0}}", 600000, 0))
}

// How many jobs the store's outbox keeps, and each one's runs and last error.
priv db_jobs_kept: fn(store: Store) -> String {
    guard := store.state.guard_edit()
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, 0) }) ?? panic("the outbox waits for open calls")
    found: __driver_query_one(guard.value.driver, "SELECT count(*) AS n, group_concat(runs || ' ' || error) AS failed FROM __jet_jobs", [DBValue]{}) ?? panic("the outbox reads")
    kept: if found.get("n") == .Val(.Int(n)) -> n else -> -1
    failed: if found.get("failed") == .Val(.Text(text)) -> text else -> ""
    "{kept}: {failed}"
}

#Test("a call keeps its jobs in its store's outbox in its transaction, and each runs after the commit and deletes its row; a rolled-back call keeps none") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    dropped: Shared{0}
    rolled: app.transactions.begin() ?? panic("no call is open")
    _: counts.put(CallCount{id: 1, count: 1}) ?? panic("the call writes")
    app.__enqueue("db.Test.never", [String]{}, 0, fn(args) {
        count := dropped.guard_edit()
        count.value += 1
        Ok(args.__reply_value<Int>(0))
    })
    assert(app.transactions.end(rolled, false))
    assert_eq(call_count(counts), 0)
    tries: Shared{0}
    writes: store.copy()
    committed: app.transactions.begin() ?? panic("no call is open")
    _: counts.put(CallCount{id: 1, count: 2}) ?? panic("the call writes")
    app.__enqueue("db.Test.set", [String]{app.__live_arg<Int>(20)}, 1, fn(args) {
        count := tries.guard_edit()
        count.value += 1
        if count.value == 1 -> return Ok(args.__reply_err<String>("once"))
        set: args.__take<Int>(0) ?? return Err(err)
        _: call_counts(writes).put(CallCount{id: 1, count: set}) ?? return Ok(args.__reply_err<String>("the job writes"))
        Ok(args.__reply_value<Int>(set))
    })
    app.__enqueue("db.Test.fail", [String]{}, 0, fn(args) { Ok(args.__reply_err<String>("no")) })
    assert(app.transactions.end(committed, true))
    assert_eq(call_count(counts), 2)
    loop _ in 0..<1000 {
        if call_count(counts) == 20 && db_jobs_kept(store) == "1: 1 {{\"err\":\"no\"}}" -> break
        core.tasks.sleep(10)
    }
    assert_eq(call_count(counts), 20)
    assert_eq(db_jobs_kept(store), "1: 1 {{\"err\":\"no\"}}")
    ran: tries.guard_read()
    assert_eq(ran.value, 2)
    never_ran: dropped.guard_read()
    assert_eq(never_ran.value, 0)
}

#Test("a store's outbox gives each row no server holds to one take, which holds it until its time by the store's clock; a closed store gives None") {
    store: open_memory()
    counts: call_counts(store)
    _: counts.put(CallCount{id: 1, count: 0}) ?? panic("the first row")
    outbox: db_outbox(store.state, "db.Test outbox")
    names: [String]{"db.Test.add"}
    call: app.transactions.begin() ?? panic("no call is open")
    _: counts.put(CallCount{id: 1, count: 1}) ?? panic("the call writes")
    key: outbox.keep("db.Test.add", "[]", 100)
    assert(app.transactions.end(call, true))
    assert_eq(key.len(), 32)
    // The store's clock is the wall clock: a time after September 2020.
    assert(outbox.now() > 1600000000000)
    assert_eq((outbox.take(names, 99, 1000) ?? panic("the store is open")).len(), 0)
    taken: outbox.take(names, 100, 1000) ?? panic("the store is open")
    assert_eq(taken.len(), 1)
    assert_eq(taken[0].key, key)
    assert_eq(taken[0].args, "[]")
    assert_eq((outbox.take(names, 500, 2000) ?? panic("the store is open")).len(), 0)
    assert(outbox.hold([String]{key.copy()}, 5000))
    assert_eq((outbox.take(names, 4999, 9000) ?? panic("the store is open")).len(), 0)
    assert_eq((outbox.take([String]{"db.Test.other"}, 6000, 9000) ?? panic("the store is open")).len(), 0)
    assert(outbox.failed(key, 3, "no", 7000))
    retaken: outbox.take(names, 7000, 9000) ?? panic("the store is open")
    assert_eq(retaken.len(), 1)
    assert_eq(retaken[0].runs, 3)
    assert(store.close())
    closed: outbox.take(names, 10000, 11000)
    if closed == .Val(_) -> panic("a closed store takes no row")
}

priv db_shutdown: fn(state: Shared<DBState>) -> Bool Never! {
    guard := state.guard_edit()
    __driver_shutdown(guard.value.driver)
}

// A write that changed no row leaves its table's live bindings current; one
// that changed a row, or a schema statement, marks them (DBState.wrote).
priv scope_execute: fn(scope: DBScope, sql: SQL, allow_schema: Bool) -> Int DBError! {
    scoped: policy_apply(sql, scope.policy, scope.user, allow_schema) ?? return Err(err)
    guard := scope.state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
    db_join(guard.value, scope.state, call) ?? return Err(err)
    changed: __driver_execute(guard.value.driver, scoped.text, scoped.values) ?? return Err(err)
    if sql_table(scoped) == .Val(table) && (changed > 0 || sql_schema(scoped)) {
        guard.value.wrote(table, None)
    }
    Ok(changed)
}

// A read made while a live binding's source runs joins that binding's read
// set first (app.live_reads), so a write to its table re-runs the binding.
priv scope_query: fn(scope: DBScope, sql: SQL, allow_schema: Bool) -> [[String:DBValue]] DBError! {
    scoped: policy_apply(sql, scope.policy, scope.user, allow_schema) ?? return Err(err)
    read: if app.live_reads.running() -> sql_table(scoped) else -> None
    if read == .Val(table) -> app.live_reads.record(live_source(table))
    guard := scope.state.guard_edit()
    call: app.transactions.current() ?? 0
    guard.wait(db_ended(guard.value), fn(held) { db_free(held, call) }) ?? return Err(db_waited())
    db_join(guard.value, scope.state, call) ?? return Err(err)
    if read == .Val(table) -> db_live_watch(guard.value, scope.state, table)
    __driver_query(guard.value.driver, scoped.text, scoped.values)
}

// The first row `sql` reads through `scope`, or None when it reads none.
priv scope_query_one: fn(scope: DBScope, sql: SQL) -> [String:DBValue]? DBError! {
    rows := scope_query(scope, sql, false) ?? return Err(err)
    if rows.len() == 0 -> return Ok(None)
    first: rows.remove(0, .Slot) ?? panic("database first row disappeared")
    Ok(Val(first))
}

// ---- live queries (#1158) ----------------------------------

// A DBScope.live binding's source in the shared live registry names the table
// its SELECT reads; a write to that table re-runs every binding over it, and
// every binding whose source read it (app.live_reads).
priv live_source: fn(table: String) -> String Never! { "core.db.live:{table}" }

// ---- live queries across servers --------------------------------------------

// The live registry is per process, so `db_live_wrote` re-runs only this
// process's bindings. Other servers learn of a write through the version
// map, a table in the database file itself: one row per table a live
// binding on some server read, holding the count of committed writes to
// it. A write to such a table adds one once it commits (`db_live_bump`);
// each process that holds a binding over it polls the map
// (`db_live_poll`) and re-runs its bindings of each table another process
// wrote since its last poll. The map does not grow with writes, and a
// server that misses nothing it polls loses no invalidation; the bound is
// the poll interval. An in-memory database is no other server's.
priv LIVE_VERSIONS: "__jet_live_versions"

priv LIVE_VERSIONS_TABLE: "CREATE TABLE IF NOT EXISTS __jet_live_versions (name TEXT PRIMARY KEY, version INTEGER NOT NULL)"

// How often a process polls the version map, in milliseconds: one second.
priv LIVE_POLL_MS: 1000

// A table of a database file this process's live bindings read: the map
// version its last poll saw, and this process's writes to it since, which
// re-ran its bindings already.
priv LiveWatched: struct {
    table: String,
    version: Int,
    own: Int,
}

// A database file whose version map this process polls, through `state`,
// the connection that first read it for a live binding.
priv LiveWatch: struct {
    path: String,
    state: Shared<DBState>,
    tables: [LiveWatched],
}

priv LIVE_WATCH: Shared{[LiveWatch]{}}

// Has this process poll the version of `table` in the file `held` reads,
// as a live binding reads it: the map gets the table's row, and the poll
// its version now, before the read, so every later write reaches the poll.
// Starts the file's poll on its first table. A connection inside a
// transaction, or a busy file, leaves it to a later read.
priv db_live_watch: fn(held: &DBState, state: Shared<DBState>, table: String) Never! {
    if held.path == ":memory:" || held.open != 0 || held.call != 0 {
        return
    }
    watch := LIVE_WATCH.guard_edit()
    at := -1
    loop index in 0..<watch.value.len() {
        if watch.value[index].path == held.path -> at = index
    }
    if at >= 0 {
        loop known in watch.value[at].tables {
            if known.table == table {
                return
            }
        }
    }
    _: __driver_execute(held.driver, LIVE_VERSIONS_TABLE, [DBValue]{}) ?? return
    _: __driver_execute(held.driver, "INSERT OR IGNORE INTO {LIVE_VERSIONS} (name, version) VALUES (?, 0)", [DBValue]{.Text(table.copy())}) ?? return
    version: db_live_version(held.driver, table) ?? return
    seen: LiveWatched{table: table.copy(), version: version, own: 0}
    if at >= 0 {
        watch.value[at].tables.push(seen)
        return
    }
    path: held.path.copy()
    watch.value.push(LiveWatch{path: path.copy(), state: state.copy(), tables: [LiveWatched]{seen}})
    polling: task { db_live_poll(path) }
    polling.detach()
}

// `table`'s version in the map of the file `driver` holds; None when the
// map has no row for it.
priv db_live_version: fn(driver: &DBDriver, table: String) -> Int? Never! {
    rows: __driver_query(driver, "SELECT version FROM {LIVE_VERSIONS} WHERE name = ?", [DBValue]{.Text(table.copy())}) ?? return None
    if rows.len() == 0 -> return None
    Val(row_int(rows[0], "version") ?? return None)
}

// Adds one to `table`'s version in the map of the file `held` reads, once a
// write to it committed, when some process polls the table. This process
// counts the write as its own, so its poll skips it.
priv db_live_bump: fn(held: &DBState, table: String) Never! {
    if held.path == ":memory:" || !table_exists(held.driver, LIVE_VERSIONS) {
        return
    }
    watch := LIVE_WATCH.guard_edit()
    bumped: __driver_execute(held.driver, "UPDATE {LIVE_VERSIONS} SET version = version + 1 WHERE name = ?", [DBValue]{.Text(table.copy())}) ?? return
    if bumped == 0 {
        return
    }
    loop index in 0..<watch.value.len() {
        if watch.value[index].path != held.path -> next
        loop at in 0..<watch.value[index].tables.len() {
            if watch.value[index].tables[at].table == table {
                watch.value[index].tables[at].own += 1
            }
        }
    }
}

// Polls the version map of the file `path` once each LIVE_POLL_MS, and
// re-runs this process's bindings over each table another process wrote.
// Ends once the connection it polls through closes; the next live read of
// the file starts it again.
priv db_live_poll: fn(path: String) Never! {
    loop {
        core.tasks.sleep(LIVE_POLL_MS)
        written: db_live_polled(path) ?? return
        loop table in written -> app.__live_invalidate_all(live_source(table))
    }
}

// The connection this process polls the file `path` through, if it polls it.
priv db_live_watched: fn(path: String) -> Shared<DBState>? Never! {
    watch: LIVE_WATCH.guard_read()
    loop known in watch.value {
        if known.path == path -> return Val(known.state.copy())
    }
    None
}

// One poll of the file `path`: the tables whose version moved past the one
// the last poll saw and this process's own writes since; None, and the file
// forgotten, once its connection closed.
priv db_live_polled: fn(path: String) -> [String]? Never! {
    held: db_live_watched(path) ?? return None
    guard := held.guard_edit()
    if driver_closed(guard.value.driver) {
        watch := LIVE_WATCH.guard_edit()
        kept := [LiveWatch]{}
        loop known in watch.value {
            if known.path != path -> kept.push(known.copy())
        }
        watch.value = kept
        return None
    }
    guard.wait(db_ended(guard.value), fn(open) { db_free(open, 0) }) ?? return Val([String]{})
    written := [String]{}
    watch := LIVE_WATCH.guard_edit()
    loop index in 0..<watch.value.len() {
        if watch.value[index].path != path -> next
        loop at in 0..<watch.value[index].tables.len() {
            seen: watch.value[index].tables[at].copy()
            version: db_live_version(guard.value.driver, seen.table) ?? next
            if version > seen.version + seen.own -> written.push(seen.table.copy())
            watch.value[index].tables[at].version = version
            watch.value[index].tables[at].own = 0
        }
    }
    Val(written)
}

#Codable
priv LiveTestChore: struct {
    id: Int,
    team: String,
}

// The ids of `binding`'s rows, and how many times its source ran.
priv live_test_ids: fn(binding: Live<[Int], DBError>, runs: Shared<Int>) -> String {
    shown := [String]{}
    if app.state(binding) == {
        .Loaded(list) -> {
            loop id in list -> shown.push("{id}")
        }
        .Failed(failure) -> shown.push("failed: {failure}")
        .Idle | .Loading -> shown.push("pending")
    }
    "[{shown.join(",")}] runs={runs.guard_read().value}"
}

// The ids of the rows `query` collects.
priv live_test_chores: fn(query: Query<LiveTestChore>) -> [Int] DBError! {
    rows: query.collect() ?? return Err(db_error("the chores collect: {err.reason}"))
    ids := [Int]{}
    loop row in rows -> ids.push(row.id)
    Ok(ids)
}

// The chores of `team`, through a filter written as SQL when `narrowed`,
// else read whole.
priv live_test_team: fn(chores: Table<Int, LiveTestChore>, team: String, narrowed: Bool) -> Query<LiveTestChore> Never! {
    query: chores.query() ?? panic("the chores read")
    condition: if narrowed -> "\"jet_row.team\" = ?" else -> ""
    data.__query_filter<LiveTestChore>(query, condition, [String]{team.copy()}, fn(row) { row.team == team })
}

#Test("a live query narrowed by a filter written as SQL re-runs only for a write that changes a row it holds for, before or after") {
    store: open_memory()
    chores: store.table("live_test_chores", key: fn(row: LiveTestChore) { row.id })
    _: chores.add(LiveTestChore{id: 1, team: "jet"}) ?? panic("add 1: {err}")
    narrow_runs: Shared{0}
    whole_runs: Shared{0}
    narrow_query: live_test_team(chores, "jet", true)
    narrow: app.__live_bind<[Int], DBError>("db.test.narrow", [String]{}, fn() {
        narrow_runs.guard_edit().value += 1
        live_test_chores(narrow_query)
    })
    whole_query: live_test_team(chores, "jet", false)
    whole: app.__live_bind<[Int], DBError>("db.test.whole", [String]{}, fn() {
        whole_runs.guard_edit().value += 1
        live_test_chores(whole_query)
    })
    seen: fn() -> String { "{live_test_ids(narrow, narrow_runs)} {live_test_ids(whole, whole_runs)}" }
    assert_eq(seen(), "[1] runs=1 [1] runs=1")
    _: chores.add(LiveTestChore{id: 2, team: "mars"}) ?? panic("add 2")
    assert_eq(seen(), "[1] runs=1 [1] runs=2")
    _: chores.put(LiveTestChore{id: 2, team: "jet"}) ?? panic("move 2 in")
    assert_eq(seen(), "[1,2] runs=2 [1,2] runs=3")
    _: chores.put(LiveTestChore{id: 2, team: "mars"}) ?? panic("move 2 out")
    assert_eq(seen(), "[1] runs=3 [1] runs=4")
    chores.delete(2) ?? panic("delete 2")
    assert_eq(seen(), "[1] runs=3 [1] runs=5")
    first: store.begin() ?? panic("begin")
    _: chores.add(LiveTestChore{id: 3, team: "mars"}) ?? panic("add 3")
    first.commit() ?? panic("commit 3")
    assert_eq(seen(), "[1] runs=3 [1] runs=6")
    second: store.begin() ?? panic("begin again")
    _: chores.add(LiveTestChore{id: 4, team: "mars"}) ?? panic("add 4")
    _: chores.add(LiveTestChore{id: 5, team: "jet"}) ?? panic("add 5")
    second.commit() ?? panic("commit 4 and 5")
    assert_eq(seen(), "[1,5] runs=4 [1,5] runs=7")
}

// The titles `binding` holds.
priv live_test_titles: fn(binding: Live<[[String:DBValue]], DBError>) -> String {
    if app.state(binding) == {
        .Loaded(rows) -> {
            shown := [String]{}
            loop row in rows -> shown.push(row_text(row, "title") ?? "?")
            "[{shown.join(",")}]"
        }
        .Failed(failure) -> "failed: {failure}"
        .Idle | .Loading -> "pending"
    }
}

#Test("a write another server commits to a database file re-runs this server's live bindings over its table at the next poll, and this server's own write is not counted twice") {
    dir: core.files.temp_dir("jet-db-live-") ?? panic("temp dir: {err}")
    path: "{dir.path}/board.db"
    store: open(path)
    tasks: policy("tasks", "owner == user") ?? panic("policy: {err}")
    alice: store.with_policy(tasks, "alice")
    _: migrate(alice, "tasks-v1", [SQL]{SQL{"CREATE TABLE tasks (owner TEXT, title TEXT)"}}) ?? panic("migrate: {err}")
    one: "one"
    _: alice.execute(SQL{"INSERT INTO tasks (owner, title) VALUES ({"alice"}, {one})"}) ?? panic("insert one: {err}")
    mine: alice.live(SQL{"SELECT title FROM tasks ORDER BY title"}) ?? panic("live: {err}")
    assert_eq(live_test_titles(mine), "[one]")
    // This server's own write re-ran its binding already; the poll skips it.
    two: "two"
    _: alice.execute(SQL{"INSERT INTO tasks (owner, title) VALUES ({"alice"}, {two})"}) ?? panic("insert two: {err}")
    assert_eq(live_test_titles(mine), "[one,two]")
    assert_eq(db_live_polled(path) ?? panic("the poll"), [String]{})
    // Another server writes through a connection of its own, which this
    // process's live registry never hears, and bumps the table's version.
    other := __driver_open(path) ?? panic("the other server opens")
    _: __driver_execute(other, "INSERT INTO tasks (owner, title) VALUES ('alice', 'three')", [DBValue]{}) ?? panic("the other server writes: {err}")
    _: __driver_execute(other, "UPDATE {LIVE_VERSIONS} SET version = version + 1 WHERE name = 'tasks'", [DBValue]{}) ?? panic("the other server bumps: {err}")
    _: __driver_shutdown(other)
    assert_eq(live_test_titles(mine), "[one,two]")
    // The poll (this one, or the background one if it came first) re-runs it.
    loop table in db_live_polled(path) ?? panic("the poll") {
        app.__live_invalidate_all(live_source(table))
    }
    assert_eq(live_test_titles(mine), "[one,three,two]")
    _: store.close()
    assert(db_live_polled(path) == None)
}

// The table `sql` reads or writes: the target of SELECT, INSERT, UPDATE or
// DELETE, or of CREATE, ALTER or DROP TABLE. None when it names no table.
priv sql_table: fn(sql: SQL) -> String? Never! {
    tokens: sql_tokens(sql.text.bytes())
    if tokens.len() == 0 -> return None
    kind: tokens[0].word.copy()
    if kind == "create" || kind == "alter" || kind == "drop" {
        at := sql_word_index(tokens, "table")
        if at < 0 -> return None
        at += 1
        loop at < tokens.len() && (tokens[at].word == "if" || tokens[at].word == "not" || tokens[at].word == "exists") {
            at += 1
        }
        if at >= tokens.len() -> return None
        return Val(tokens[at].word.copy())
    }
    if kind != "select" && kind != "insert" && kind != "update" && kind != "delete" -> return None
    target: sql_target_index(tokens, kind)
    if target < 0 -> return None
    Val(tokens[target].word.copy())
}

// Whether `sql` is a CREATE, ALTER or DROP statement, which changes its
// table's shape however many rows it reports.
priv sql_schema: fn(sql: SQL) -> Bool Never! {
    tokens: sql_tokens(sql.text.bytes())
    if tokens.len() == 0 -> return false
    kind: tokens[0].word
    kind == "create" || kind == "alter" || kind == "drop"
}

// ---- transactions and migrations -----------------------------------------

transaction: fn(scope: DBScope, name: String, steps: [SQL]) -[DB, Time.Wait]> Int DBError! {
    tx: db_begin(scope.state, false) ?? return Err(db_error("could not begin transaction: {name}"))
    done: transaction_steps(scope, steps) ?? {
        tx.rollback().drop("the failed step is the reported failure")
        return Err(err)
    }
    tx.commit() ?? return Err(db_error("could not commit transaction"))
    Ok(done)
}

priv transaction_steps: fn(scope: DBScope, steps: [SQL]) -> Int DBError! {
    done := 0
    loop sql in steps {
        _: scope_execute(scope, sql, false) ?? return Err(err)
        done += 1
    }
    Ok(done)
}

priv ledger_schema: fn() -> String Never! {
    "CREATE TABLE IF NOT EXISTS __jet_migrations (sequence INTEGER PRIMARY KEY AUTOINCREMENT, transition_key TEXT NOT NULL UNIQUE, migration_key TEXT NOT NULL, target TEXT NOT NULL, target_identity TEXT NOT NULL, database_identity TEXT NOT NULL, source_identity TEXT NOT NULL, schema_identity TEXT NOT NULL, tool_identity TEXT NOT NULL, operation TEXT NOT NULL, status TEXT NOT NULL, from_version INTEGER NOT NULL, to_version INTEGER NOT NULL, step_count INTEGER NOT NULL, step_ids TEXT NOT NULL, checksum TEXT NOT NULL, lock_mode TEXT NOT NULL, risk TEXT NOT NULL, started_unix_ms INTEGER NOT NULL, finished_unix_ms INTEGER NOT NULL, error TEXT)"
}

priv ledger_columns: fn() -> [String] Never! {
    [String]{"sequence", "transition_key", "migration_key", "target", "target_identity", "database_identity", "source_identity", "schema_identity", "tool_identity", "operation", "status", "from_version", "to_version", "step_count", "step_ids", "checksum", "lock_mode", "risk", "started_unix_ms", "finished_unix_ms", "error"}
}

priv LedgerRow: struct {
    transition_key: String,
    migration_key: String,
    target: String,
    target_identity: String,
    database_identity: String,
    source_identity: String,
    schema_identity: String,
    operation: String,
    status: String,
    from_version: Int,
    to_version: Int,
    step_count: Int,
    step_ids: Int,
    checksum: String,
}

priv ledger_value: fn(row: [String:DBValue], key: String) -> DBValue DBError! {
    value: row.get(key) ?? return Err(db_error("migration ledger row has no `{key}` field"))
    Ok(value)
}

priv ledger_text: fn(row: [String:DBValue], key: String) -> String DBError! {
    value: ledger_value(row, key) ?? return Err(err)
    if value == .Text(text) -> return Ok(text.copy())
    Err(db_error("expected text, got {render_value(value)}"))
}

priv ledger_count: fn(row: [String:DBValue], key: String) -> Int DBError! {
    value: ledger_value(row, key) ?? return Err(err)
    if value == .Int(number) {
        if number < 0 -> return Err(db_error("migration ledger `{key}` is negative"))
        return Ok(number)
    }
    Err(db_error("expected an int, got {render_value(value)}"))
}

priv ledger_row: fn(row: [String:DBValue]) -> LedgerRow DBError! {
    transition_key: ledger_text(row, "transition_key") ?? return Err(err)
    migration_key: ledger_text(row, "migration_key") ?? return Err(err)
    operation: ledger_text(row, "operation") ?? return Err(err)
    status: ledger_text(row, "status") ?? return Err(err)
    step_ids_text: ledger_text(row, "step_ids") ?? return Err(err)
    step_ids: if step_ids_text.len() == 0 -> 0 else -> step_ids_text.split("\n").len()
    step_count: ledger_count(row, "step_count") ?? return Err(err)
    _started: ledger_count(row, "started_unix_ms") ?? return Err(err)
    _finished: ledger_count(row, "finished_unix_ms") ?? return Err(err)
    lock: ledger_text(row, "lock_mode") ?? return Err(err)
    if lock != "shared" && lock != "exclusive" {
        return Err(db_error("unknown migration lock mode `{lock}`"))
    }
    target: ledger_text(row, "target") ?? return Err(err)
    target_identity: ledger_text(row, "target_identity") ?? return Err(err)
    source_identity: ledger_text(row, "source_identity") ?? return Err(err)
    schema_identity: ledger_text(row, "schema_identity") ?? return Err(err)
    database_identity: ledger_text(row, "database_identity") ?? return Err(err)
    _tool: ledger_text(row, "tool_identity") ?? return Err(err)
    from_version: ledger_count(row, "from_version") ?? return Err(err)
    to_version: ledger_count(row, "to_version") ?? return Err(err)
    checksum: ledger_text(row, "checksum") ?? return Err(err)
    _risk: ledger_text(row, "risk") ?? return Err(err)
    error_value: ledger_value(row, "error") ?? return Err(err)
    if error_value == {
        .Null -> {}
        .Text(_) -> {}
        .Int(_) | .Float(_) | .Bool(_) | .Blob(_) -> return Err(db_error("expected text, got {render_value(error_value)}"))
    }
    Ok(
        LedgerRow{
            transition_key: transition_key,
            migration_key: migration_key,
            target: target,
            target_identity: target_identity,
            database_identity: database_identity,
            source_identity: source_identity,
            schema_identity: schema_identity,
            operation: operation,
            status: status,
            from_version: from_version,
            to_version: to_version,
            step_count: step_count,
            step_ids: step_ids,
            checksum: checksum,
        },
    )
}

// The first reason a `direct` ledger row disagrees with canonical state.
priv ledger_drift: fn(row: LedgerRow, current: Int) -> String? Never! {
    key: row.transition_key
    if row.target_identity != "direct" {
        return Val("migration transition `{key}` has a foreign target identity")
    }
    if row.database_identity != "runtime" {
        return Val("migration transition `{key}` has a foreign database identity")
    }
    if row.source_identity != "jet.db.runtime" {
        return Val("migration transition `{key}` was created from a different migration catalog")
    }
    if row.schema_identity != "jet.db.migration/v2" {
        return Val("migration transition `{key}` has a mismatched schema identity")
    }
    if row.step_count != row.step_ids {
        return Val("migration transition `{key}` has an invalid step count")
    }
    if row.status != "applied" {
        return Val("migration transition `{key}` has unresolved status `{row.status}`")
    }
    if row.operation == "apply" || row.operation == "rollback" {
        if row.from_version != current {
            return Val("migration transition `{key}` starts at {row.from_version}, but canonical state is at {current}")
        }
        return None
    }
    if row.operation != "direct" {
        return Val("migration transition `{key}` has unknown operation `{row.operation}`")
    }
    None
}

// Direct runtime migrations: target `direct`, one exclusive transaction.
priv migration_validate: fn(name: String, steps: [SQL]) -> DBError? Never! {
    key: name.bytes()
    if key.len() == 0 || sql_has_control(key, false) {
        return Val(db_error("migration migration key is empty or contains control characters"))
    }
    loop sql in steps {
        text: sql.text.bytes()
        if sql_blank(text, 0, text.len()) || sql_has_control(text, false) {
            return Val(db_error("migration step contains empty or invalid SQL metadata"))
        }
    }
    None
}

// Applies `steps` inside the caller's transaction. Returns -1 for an
// idempotent replay of the latest applied migration with the same checksum.
priv migration_apply: fn(scope: DBScope, name: String, steps: [SQL]) -> Int DBError! {
    _: scope_execute(scope, sql_raw(ledger_schema()), true) ?? return Err(err)
    columns: scope_query(scope, sql_raw("PRAGMA table_info(__jet_migrations)"), true) ?? return Err(err)
    canonical: ledger_columns()
    if columns.len() != canonical.len() {
        return Err(db_error("migration ledger uses a non-canonical schema"))
    }
    loop index in 0..<columns.len() {
        column: row_text(columns[index], "name") ?? ""
        if column != canonical[index] {
            return Err(db_error("migration ledger uses a non-canonical schema"))
        }
    }
    stored: scope_query(scope, sql_raw("SELECT transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error FROM __jet_migrations ORDER BY sequence"), true) ?? return Err(err)
    rows := [LedgerRow]{}
    loop entry in stored {
        parsed: ledger_row(entry) ?? return Err(err)
        rows.push(parsed)
    }
    drift := [String]{}
    current := 0
    latest := -1
    loop index in 0..<rows.len() {
        row: rows[index]
        if row.target == "direct" {
            if row.migration_key == name -> latest = index
            if {
                ledger_drift(row, current) == .Val(message) -> { drift.push(message.copy()) }
                row.operation == "apply" || row.operation == "rollback" -> {
                    current = row.to_version
                }
            }
        }
    }
    if drift.len() > 0 {
        return Err(db_error("migration target `direct` has unreconciled state: {drift.join("; ")}"))
    }
    checksum: migration_checksum(name, steps)
    predecessor := ""
    if latest >= 0 {
        previous: rows[latest]
        if previous.status == "applied" && previous.operation == "direct" {
            if previous.checksum == checksum -> return Ok(-1)
            return Err(db_error("migration `{name}` checksum changed"))
        }
        predecessor = previous.transition_key.copy()
    }
    transition: migration_transition_key(name, checksum, predecessor)
    loop sql in steps -> _: scope_execute(scope, sql, true) ?? return Err(err)
    step_ids := [String]{}
    loop index in 0..<steps.len() -> step_ids.push(migration_step_id(index + 1, steps[index]))
    // Direct migrations run under the DB authority alone; without a granted
    // wall clock the ledger records 0 for both timestamps.
    values: [DBValue]{
        .Text(transition),
        .Text(name.copy()),
        .Text("direct"),
        .Text("direct"),
        .Text("runtime"),
        .Text("jet.db.runtime"),
        .Text("jet.db.migration/v2"),
        .Text("jet-runtime"),
        .Text("direct"),
        .Text("applied"),
        .Int(0),
        .Int(0),
        .Int(steps.len()),
        .Text(step_ids.join("\n")),
        .Text(checksum.copy()),
        .Text("exclusive"),
        .Text("runtime migration"),
        .Int(0),
        .Int(0),
        .Null,
    }
    insert: SQL{text: "INSERT INTO __jet_migrations (transition_key, migration_key, target, target_identity, database_identity, source_identity, schema_identity, tool_identity, operation, status, from_version, to_version, step_count, step_ids, checksum, lock_mode, risk, started_unix_ms, finished_unix_ms, error) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", values: values}
    _: scope_execute(scope, insert, true) ?? return Err(err)
    Ok(steps.len())
}

migrate: fn(scope: DBScope, name: String, steps: [SQL]) -[DB, Time.Wait]> Int DBError! {
    if migration_validate(name, steps) == .Val(failure) -> return Err(failure.copy())
    tx: db_begin(scope.state, true) ?? return Err(db_error("could not begin migration `{name}`"))
    applied: migration_apply(scope, name, steps) ?? {
        tx.rollback().drop("the failed migration step is the reported failure")
        return Err(err)
    }
    tx.commit() ?? return Err(db_error(if applied < 0 -> "could not commit idempotent migration read" else -> "could not commit migration `{name}`"))
    Ok(if applied < 0 -> 0 else -> applied)
}

// FNV-1a 64 identities, byte-compatible with the existing migration ledgers.
priv fnv_offset: fn() -> U64 Never! { U64{14695981039346656037} }

priv fnv_byte: fn(hash: U64, byte: Int) -> U64 Never! {
    wrapping((hash ~ U64{byte}) * U64{1099511628211})
}

priv hash_field: fn(hash: U64, value: String) -> U64 Never! {
    bytes: value.bytes()
    out := hash
    length := bytes.len()
    loop _ in 0..<8 {
        out = fnv_byte(out, length & 255)
        length = length >> 8
    }
    loop byte in bytes -> out = fnv_byte(out, Int{byte})
    fnv_byte(out, 255)
}

priv float_bits_text: fn(value: Float) -> String Never! {
    bits: math.to_bits(value)
    if bits >= 0 -> return "{bits}"
    unsigned: wrapping(U64{bits + 9223372036854775807 + 1} + U64{9223372036854775808})
    "{unsigned}"
}

priv hash_value: fn(hash: U64, value: DBValue) -> U64 Never! {
    if value == {
        .Null -> hash_field(hash, "N")
        .Int(number) -> hash_field(hash_field(hash, "I"), "{number}")
        .Float(number) -> hash_field(hash_field(hash, "F"), float_bits_text(number))
        .Text(text) -> hash_field(hash_field(hash, "T"), text)
        .Bool(flag) -> hash_field(hash, if flag -> "B1" else -> "B0")
        .Blob(bytes) -> {
            out := hash_field(hash, "X")
            loop byte in bytes -> out = fnv_byte(out, Int{byte})
            fnv_byte(out, 255)
        }
    }
}

priv hash_sql: fn(hash: U64, sql: SQL) -> U64 Never! {
    out := hash_field(hash, sql.text)
    out = hash_field(out, "{sql.values.len()}")
    loop value in sql.values -> out = hash_value(out, value)
    out
}

priv hex16: fn(hash: U64) -> String Never! {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop index in 0..<16 {
        nibble: Int{(hash >> (60 - index * 4)) & U64{15}}
        out.push(digits[nibble])
    }
    String.from_bytes(out) ?? ""
}

priv migration_checksum: fn(name: String, steps: [SQL]) -> String Never! {
    hash := fnv_offset()
    fields: [String]{"jet.db.migration/v2", "direct", name.copy(), "direct", "direct", "runtime", "jet.db.runtime", "jet.db.migration/v2", "jet-runtime", "0", "0", "exclusive", "runtime migration", "{steps.len()}"}
    loop field in fields -> hash = hash_field(hash, field)
    loop index in 0..<steps.len() {
        hash = hash_field(hash, "{index + 1}")
        hash = hash_field(hash, "exclusive")
        hash = hash_field(hash, "runtime migration")
        hash = hash_sql(hash, steps[index])
        hash = hash_field(hash, "no-inverse")
    }
    "migration-v2:{hex16(hash)}"
}

priv migration_step_id: fn(ordinal: Int, sql: SQL) -> String Never! {
    hash := hash_field(fnv_offset(), "{ordinal}")
    hash = hash_field(hash, "exclusive")
    hash = hash_field(hash, "runtime migration")
    hash = hash_sql(hash, sql)
    "step:{hex16(hash)}"
}

priv migration_transition_key: fn(name: String, checksum: String, predecessor: String) -> String Never! {
    hash := fnv_offset()
    fields: [String]{"transition", "direct", name.copy(), "direct", checksum.copy(), predecessor.copy()}
    loop field in fields -> hash = hash_field(hash, field)
    "transition:{hex16(hash)}"
}

// ---- pools ---------------------------------------------------------------
// Admission is FIFO by ticket; waiting sleeps (`Time.Wait`) and deadlines use
// the pure monotonic clock, so no wall-clock authority is involved.

priv PoolState: struct {
    url: String,
    lifecycle: PoolLifecycle,
    max: Int,
    available: [DBDriver],
    leased: Int,
    opening: Int,
    waiters: [Int],
    next_ticket: Int,
    acquires: Int,
    releases: Int,
    timeouts: Int,
    open_failures: Int,
    unhealthy: Int,
    replacements: Int,
    replacement_failures: Int,
}

DBPool: struct {
    state: Shared<PoolState>,

    acquire: fn(self, *, deadline: Duration{30000ms}) -[DB, Time.Wait]> DBLease DBError! {
        deadline_ns: pool_deadline(deadline)
        waiter := PoolWaiter{pool: self.state.copy(), ticket: -1}
        defer close(waiter)
        loop {
            claim := pool_claim(self.state, waiter.ticket, deadline_ns)
            if claim.failure == .Val(failure) -> return Err(failure.copy())
            if claim.drivers.len() > 0 {
                driver: claim.drivers.remove(0, .Slot) ?? panic("database pool lost a claimed connection")
                return Ok(DBLease{state: Shared{LeaseState{pool: self.state.copy(), drivers: [DBDriver]{driver.move()}}}})
            }
            waiter.ticket = claim.ticket
            if !claim.retry -> time.sleep(1ms)
        }
    }

    ready: fn(self) -[DB, Time.Wait]> Bool DBError! {
        state: pool_ready_state(self.state)
        if state == 0 -> return Ok(false)
        if state == 1 -> return Ok(true)
        lease: self.acquire() ?? return Err(err)
        lease.close() ?? return Err(err)
        Ok(true)
    }

    drain: fn(self, *, deadline: Duration{30000ms}) -[DB, Time.Wait]> DBPoolReceipt DBError! {
        deadline_ns: pool_deadline(deadline)
        loop {
            if pool_drain_step(self.state, deadline_ns) == {
                .Ok(step) -> {
                    if step == .Val(receipt) -> return Ok(receipt)
                }
                .Err(failure) -> return Err(failure)
            }
            time.sleep(1ms)
        }
    }

    receipt: fn(self) -[DB]> DBPoolReceipt Never! {
        guard: self.state.guard_read()
        pool_receipt(guard.value)
    }
}

priv LeaseState: struct {
    pool: Shared<PoolState>,
    drivers: [DBDriver],

    impl Close {
        close: fn(&&self) {
            drivers := self.drivers.move()
            loop drivers.len() > 0 {
                driver: drivers.remove(0, .Slot) ?? panic("database lease lost its connection")
                pool_release(self.pool, driver)
            }
        }
    }
}

// A queued acquire's place in line. Closing it leaves the queue, so an acquire
// that ends early (its task canceled at the wait) never blocks later waiters.
priv PoolWaiter: struct {
    pool: Shared<PoolState>,
    ticket: Int,

    impl Close {
        close: fn(&&self) {
            if self.ticket < 0 {
                return
            }
            guard := self.pool.guard_edit()
            pool_remove_waiter(guard.value, self.ticket)
        }
    }
}

DBLease: struct {
    state: Shared<LeaseState>,

    close: fn(self) -[DB]> DBError! {
        guard := self.state.guard_edit()
        if guard.value.drivers.len() == 0 -> return Ok()
        driver: guard.value.drivers.remove(0, .Slot) ?? return Ok()
        pool_release(guard.value.pool, driver)
        Ok()
    }

    impl Display {
        display: fn(self) -> String { "db.lease" }
    }
}

priv pool_deadline: fn(deadline: Duration) -> Int Never! {
    now: rt.clock_mono_ns()
    if deadline.ns > 9223372036854775807 - now -> return 9223372036854775807
    now + deadline.ns
}

priv pool_expired: fn(deadline_ns: Int) -> Bool Never! { rt.clock_mono_ns() >= deadline_ns }

priv pool_state_error: fn(lifecycle: PoolLifecycle) -> DBError Never! {
    if lifecycle == {
        .Open -> db_error("database pool is unavailable")
        .Draining -> db_error("database pool is draining")
        .Drained -> db_error("database pool is drained")
    }
}

priv pool_receipt: fn(state: PoolState) -> DBPoolReceipt Never! {
    DBPoolReceipt{
        lifecycle: state.lifecycle,
        max: state.max,
        available: state.available.len(),
        leased: state.leased,
        opening: state.opening,
        ready: state.lifecycle == .Open && state.available.len() + state.leased > 0,
        acquires: state.acquires,
        releases: state.releases,
        timeouts: state.timeouts,
        open_failures: state.open_failures,
        unhealthy: state.unhealthy,
        replacements: state.replacements,
        replacement_failures: state.replacement_failures,
    }
}

priv pool_mark_drained: fn(state: &PoolState) Never! {
    if state.lifecycle == .Draining && state.available.len() == 0 && state.leased == 0 && state.opening == 0 {
        state.lifecycle = .Drained
    }
}

priv pool_remove_waiter: fn(state: &PoolState, ticket: Int) Never! {
    loop index in 0..<state.waiters.len() {
        if state.waiters[index] == ticket {
            _: state.waiters.remove(index, .Slot)
            return
        }
    }
}

priv pool_replace_one: fn(state: &PoolState) Never! {
    if state.lifecycle != .Open || state.available.len() + state.leased + state.opening >= state.max {
        return
    }
    driver := __driver_open(state.url) ?? {
        state.replacement_failures += 1
        return
    }
    if !__driver_health(driver) {
        state.unhealthy += 1
        state.replacement_failures += 1
        close(driver)
        return
    }
    state.available.push(driver)
    state.replacements += 1
}

priv pool_release: fn(pool: Shared<PoolState>, driver: &&DBDriver) Never! {
    held := driver.move()
    fit: __driver_reset(held)
    guard := pool.guard_edit()
    if guard.value.leased > 0 -> guard.value.leased -= 1
    guard.value.releases += 1
    if guard.value.lifecycle == .Open && fit {
        guard.value.available.push(held)
        return
    }
    if !fit -> guard.value.unhealthy += 1
    close(held)
    pool_mark_drained(guard.value)
    if !fit -> pool_replace_one(guard.value)
}

priv PoolClaim: struct {
    drivers: [DBDriver],
    failure: DBError?,
    ticket: Int,
    retry: Bool,
}

// One admission attempt under the pool lock: lease a healthy idle driver,
// open a new one within `max`, or queue the ticket to wait.
priv pool_claim: fn(pool: Shared<PoolState>, ticket: Int, deadline_ns: Int) -> PoolClaim Never! {
    claim := PoolClaim{drivers: [DBDriver]{}, failure: None, ticket: ticket, retry: false}
    guard := pool.guard_edit()
    if guard.value.lifecycle != .Open {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        claim.failure = Val(pool_state_error(guard.value.lifecycle))
        return claim
    }
    turn: if ticket >= 0 -> guard.value.waiters.len() > 0 && guard.value.waiters[0] == ticket else -> guard.value.waiters.len() == 0
    if turn && guard.value.available.len() > 0 {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        driver := guard.value.available.pop() ?? panic("database pool lost an idle connection")
        healthy: __driver_health(driver)
        expired: pool_expired(deadline_ns)
        if healthy && !expired {
            guard.value.leased += 1
            guard.value.acquires += 1
            claim.drivers.push(driver)
            return claim
        }
        close(driver)
        if !healthy -> guard.value.unhealthy += 1
        if expired {
            guard.value.timeouts += 1
            claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
        }
        claim.retry = true
        return claim
    }
    if turn && guard.value.available.len() + guard.value.leased + guard.value.opening < guard.value.max {
        if ticket >= 0 -> pool_remove_waiter(guard.value, ticket)
        claim.ticket = -1
        driver := __driver_open(guard.value.url) ?? {
            guard.value.open_failures += 1
            if {
                pool_expired(deadline_ns) -> {
                    guard.value.timeouts += 1
                    claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
                }
                else -> { claim.failure = Val(db_error("database pool backend open failed")) }
            }
            return claim
        }
        healthy: __driver_health(driver)
        expired: pool_expired(deadline_ns)
        if !healthy || expired {
            if !healthy -> guard.value.unhealthy += 1
            if expired -> guard.value.timeouts += 1
            close(driver)
            claim.failure = Val(db_error(if expired -> "database pool acquisition deadline exceeded" else -> "database pool opened an unhealthy connection"))
            return claim
        }
        guard.value.leased += 1
        guard.value.acquires += 1
        claim.drivers.push(driver)
        return claim
    }
    if claim.ticket < 0 {
        claim.ticket = guard.value.next_ticket
        guard.value.next_ticket += 1
        guard.value.waiters.push(claim.ticket)
    }
    if pool_expired(deadline_ns) {
        pool_remove_waiter(guard.value, claim.ticket)
        claim.ticket = -1
        guard.value.timeouts += 1
        claim.failure = Val(db_error("database pool acquisition deadline exceeded"))
    }
    claim
}

priv pool_drain_step: fn(pool: Shared<PoolState>, deadline_ns: Int) -> DBPoolReceipt? DBError! {
    guard := pool.guard_edit()
    if guard.value.lifecycle == .Open -> guard.value.lifecycle = .Draining
    loop guard.value.available.len() > 0 {
        driver: guard.value.available.pop() ?? panic("database pool lost an idle connection")
        close(driver)
    }
    pool_mark_drained(guard.value)
    if guard.value.lifecycle == .Drained -> return Ok(Val(pool_receipt(guard.value)))
    if pool_expired(deadline_ns) {
        guard.value.timeouts += 1
        return Err(db_error("database pool drain deadline exceeded"))
    }
    Ok(None)
}

// 0: not open, 1: already serving leases, 2: needs a probe lease.
priv pool_ready_state: fn(pool: Shared<PoolState>) -> Int Never! {
    guard: pool.guard_read()
    if guard.value.lifecycle != .Open -> return 0
    if guard.value.leased > 0 -> return 1
    2
}

pool: fn(url: String, *, max: Int) -[DB]> DBPool DBError! {
    if max <= 0 -> return Err(db_error("database pool max must be greater than zero"))
    Ok(
        DBPool{
            state: Shared{PoolState{
                url: url.copy(),
                lifecycle: .Open,
                max: max,
                available: [DBDriver]{},
                leased: 0,
                opening: 0,
                waiters: [Int]{},
                next_ticket: 0,
                acquires: 0,
                releases: 0,
                timeouts: 0,
                open_failures: 0,
                unhealthy: 0,
                replacements: 0,
                replacement_failures: 0,
            }},
        },
    )
}

// ---- typed rows ----------------------------------------------------------

priv dyn_value: fn(value: DBValue) -> Dyn Never! {
    if value == {
        .Null -> Dyn.Null
        .Int(number) -> Dyn.Int(number)
        .Float(number) -> Dyn.Float(number)
        .Text(text) -> Dyn.Text(text)
        .Bool(flag) -> Dyn.Bool(flag)
        .Blob(bytes) -> {
            items := [Dyn]{}
            loop byte in bytes -> items.push(Dyn.Int(Int{byte}))
            Dyn.Array(items)
        }
    }
}

// Typed `decode<T>(row)`: sema supplies `names`, the column name and decode
// key of each of T's fields whose column differs from its key; every other
// column decodes under its own name.
decode: fn<T: Decode>(row: [String:DBValue], names: [{db_name: String, key: String}]) -> T [FieldError]! {
    entries := [{key: String, value: Dyn}]{}
    loop (column, value) in row {
        key := column.copy()
        loop rename in names {
            if rename.db_name == column {
                key = rename.key.copy()
                break
            }
        }
        entries.push({key: key, value: dyn_value(value)})
    }
    tree: stream.object_from_entries(entries)
    if tree.decode<T>() == {
        .Ok(value) -> Ok(value)
        .Err(failures) -> Err(failures)
    }
}

// One cached prepared statement: its engine statement slot (-1 when SQLite
// prepared no statement, as for empty SQL) and the trimmed SQL it caches.
CachedStatement: struct {
    stmt: Int,
    sql: String,
}

// rusqlite 0.31.0: cache16,
// READWRITE|CREATE|URI|NOMUTEX, extended codes and a 5000ms busy timeout.
// The connection is the Jet engine's; `live` is false once it is shut down.
// The fields are `priv`: only core.db opens, drives and closes a connection.
priv DBDriver: struct {
    priv database: conn.Conn,
    priv cache: [CachedStatement],
    priv live: Bool,

    impl Close {
        close: fn(&&self) {
            if !self.live {
                return
            }
            held := DBDriver{database: self.database.move(), cache: self.cache.move(), live: true}
            _: __driver_shutdown(held)
        }
    }
}

priv driver_closed: fn(driver: DBDriver) -> Bool Never! { !driver.live }

error: fn(driver: DBDriver) -> DBError Never! { DBError.Failed(prep.errmsg(driver.database)) }

// Backend open reports None; public open preserves E3001, while the queue maps
// None to its existing Unavailable error. Failed opens close their connection.
priv nul_text: fn() -> String Never! {
    String.from_bytes([U8]{0}) ?? panic("NUL is one ASCII byte")
}

__has_nul: fn(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        if byte == (U8{0}) -> return true
    }
    false
}

__driver_open: fn(path: String) -> DBDriver? Never! {
    // sqlite3_open_v2 takes a NUL-terminated filename, so a NUL never opens.
    if __has_nul(path) -> return None
    opened := prep.open_v2(path, 32838)
    database := opened.db.move()
    if opened.rc != base.OK {
        _: prep.close_v2(database)
        return None
    }
    _: prep.extended_result_codes(database, true)
    if prep.busy_timeout(database, 5000) != base.OK {
        _: prep.close_v2(database)
        return None
    }
    Val(DBDriver{database: database.move(), cache: [CachedStatement]{}, live: true})
}

// Finalize every cached statement, oldest first.
priv driver_finalize_cache: fn(driver: &DBDriver) Never! {
    loop driver.cache.len() > 0 {
        statement: driver.cache.remove(0, .Slot) ?? panic("SQLite cache lost a statement")
        _: prep.finalize_stmt(driver.database, statement.stmt)
    }
}

// Shut a shared connection down in place: later operations see it closed and
// the driver's own Close then does nothing.
__driver_shutdown: fn(driver: &DBDriver) -> Bool Never! {
    if !driver.live -> return false
    driver_finalize_cache(driver)
    _: prep.close_v2(driver.database)
    driver.live = false
    true
}

control: fn(driver: &DBDriver, sql: String) -> Bool Never! {
    prep.exec_sql(driver.database, sql.bytes()) == base.OK
}

__driver_begin: fn(driver: &DBDriver) -> Bool Never! { control(driver, "BEGIN") }

__driver_begin_immediate: fn(driver: &DBDriver) -> Bool Never! {
    control(driver, "BEGIN IMMEDIATE")
}

__driver_commit: fn(driver: &DBDriver) -> Bool Never! { control(driver, "COMMIT") }

__driver_rollback: fn(driver: &DBDriver) -> Bool Never! { control(driver, "ROLLBACK") }

__driver_reset: fn(driver: &DBDriver) -> Bool Never! {
    if prep.get_autocommit(driver.database) -> return true
    __driver_rollback(driver)
}

prepare: fn(driver: &DBDriver, sql: String) -> CachedStatement DBError! {
    // An unchanged template hits without allocating a trimmed String. Only a
    // different spelling needs the canonical trimmed-key comparison below.
    loop index in 0..<driver.cache.len() {
        if driver.cache[index].sql == sql {
            cached: driver.cache.remove(index, .Slot) ?? panic("SQLite cache index disappeared")
            return Ok(cached)
        }
    }
    key: sql.trim()
    loop index in 0..<driver.cache.len() {
        if driver.cache[index].sql == key {
            cached: driver.cache.remove(index, .Slot) ?? panic("SQLite cache index disappeared")
            return Ok(cached)
        }
    }
    text: key.bytes()
    if text.len() >= 2147483647 {
        return Err(db_error("Error code 18: String or BLOB exceeds size limit"))
    }
    prepared: prep.prepare_v3(driver.database, text, 1)
    if prepared.rc != base.OK {
        failure := error(driver)
        primary: prepared.rc & 255
        // rusqlite: only Unknown primary errors (outside 2..26) acquire
        // modern_sqlite's SQL/offset diagnostic suffix.
        if primary < 2 || primary > 26 {
            offset: prep.error_offset(driver.database)
            if offset >= 0 -> failure = db_error("{failure.message()} in {key} at offset {offset}")
        }
        // SQLite hands back no statement on error; finalize(-1) does nothing.
        _: prep.finalize_stmt(driver.database, prepared.stmt)
        return Err(failure)
    }
    Ok(CachedStatement{stmt: prepared.stmt, sql: key})
}

release: fn(driver: &DBDriver, statement: &&CachedStatement) Never! {
    if statement.stmt < 0 {
        return
    }
    // Reset this statement and clear its bindings before it returns to the cache.
    _: prep.reset_stmt(driver.database, statement.stmt)
    api.clear_bindings(driver.database, statement.stmt)
    if driver.cache.len() == 16 {
        oldest: driver.cache.remove(0, .Slot) ?? panic("SQLite cache lost its oldest statement")
        _: prep.finalize_stmt(driver.database, oldest.stmt)
    }
    driver.cache.push(statement)
}

// sqlite3_step(NULL) is SQLITE_MISUSE; empty SQL prepares no statement.
step_statement: fn(driver: &DBDriver, statement: Int) -> Int Never! {
    if statement < 0 -> return base.MISUSE
    prep.step(driver.database, statement)
}

bind: fn(driver: &DBDriver, statement: Int, params: [DBValue]) -> DBError? Never! {
    needed: if statement < 0 -> 0 else -> api.bind_parameter_count(driver.database, statement)
    if params.len() != needed {
        return Val(db_error("Wrong number of parameters passed to query. Got {params.len()}, needed {needed}"))
    }
    loop at in 0..<params.len() {
        index: at + 1
        status := base.OK
        if params[at] == {
            .Null -> { status = api.bind_null(driver.database, statement, index) }
            .Int(number) -> { status = api.bind_int64(driver.database, statement, index, number) }
            .Float(number) -> {
                status = api.bind_double(driver.database, statement, index, number)
            }
            .Bool(value) -> {
                status = api.bind_int64(driver.database, statement, index, if value -> 1 else -> 0)
            }
            .Text(text) -> {
                bytes: text.bytes()
                length: bytes.len()
                if length >= 2147483647 {
                    return Val(db_error("Error code 18: String or BLOB exceeds size limit"))
                }
                // Empty TEXT binds empty text, never NULL.
                status = api.bind_text(driver.database, statement, index, Val(bytes), length)
            }
            .Blob(bytes) -> {
                length: bytes.len()
                if length >= 2147483647 {
                    return Val(db_error("Error code 18: String or BLOB exceeds size limit"))
                }
                if length == 0 -> status = api.bind_zeroblob(driver.database, statement, index, 0) else {
                    status = api.bind_blob(driver.database, statement, index, Val(bytes), length)
                }
            }
        }
        if status != base.OK -> return Val(error(driver))
    }
    None
}

__driver_execute: fn(driver: &DBDriver, sql: String, params: [DBValue]) -> Int DBError! {
    statement: prepare(driver, sql) ?? return Err(err)
    if bind(driver, statement.stmt, params) == .Val(failure) {
        release(driver, statement)
        return Err(failure)
    }
    count := 0
    failure := DBError?{None}
    // Step, then reset, matching rusqlite execute_with_bound_parameters; copy
    // any SQLite error before another operation.
    status: step_statement(driver, statement.stmt)
    reset_status: if statement.stmt < 0 -> base.OK else -> prep.reset_stmt(driver.database, statement.stmt)
    if {
        status == base.DONE -> {
            if reset_status == base.OK -> count = prep.changes(driver.database) else {
                failure = Val(error(driver))
            }
        }
        status == base.ROW -> {
            failure = Val(db_error("Execute returned results - did you mean to call query?"))
        }
        else -> failure = Val(error(driver))
    }
    release(driver, statement)
    if failure == .Val(found_failure) -> return Err(found_failure)
    Ok(count)
}

// Preserve the old wire decoder's externally observable size/count limits
// without constructing a second serialized copy of the complete result.
decimal_width: fn(number: Int) -> Int Never! {
    rest := number
    width := if number < 0 -> 2 else -> 1
    loop rest >= 10 || rest <= -10 {
        // Truncating division: /% floors, which overcounts some negative widths.
        quotient := rest /% 10
        if rest < 0 && quotient * 10 != rest -> quotient += 1
        rest = quotient
        width += 1
    }
    width
}

tagged_width: fn(payload: Int) -> Int Never! { payload + decimal_width(payload) + 2 }

cell_wire_width: fn(value: DBValue) -> Int Never! {
    payload: if value == {
        .Null -> 0
        .Int(number) -> decimal_width(number)
        .Float(number) -> __float_text(number).len()
        .Text(text) -> text.count_bytes()
        .Bool(_) -> 1
        .Blob(bytes) -> bytes.len() * 2
    }
    tagged_width(payload)
}

__driver_query: fn(driver: &DBDriver, sql: String, params: [DBValue]) -> [[String:DBValue]] DBError! {
    statement: prepare(driver, sql) ?? return Err(err)
    if bind(driver, statement.stmt, params) == .Val(failure) {
        release(driver, statement)
        return Err(failure)
    }
    rows := [[String:DBValue]]{}
    failure := DBError?{None}
    duplicate := false
    wire_rows := 0
    column_overflow := false
    // Copy every column into an owned value while its row is current.
    count: if statement.stmt < 0 -> 0 else -> api.column_count(driver.database, statement.stmt)
    names := [String]{}
    row_prefix := decimal_width(count) + 1
    loop index in 0..<count {
        name: api.column_name(driver.database, statement.stmt, index) ?? panic("Null pointer from sqlite3_column_name: Out of memory?")
        row_prefix += tagged_width(name.len())
        names.push(String.from_bytes(name) ?? "")
    }
    loop {
        status: step_statement(driver, statement.stmt)
        if status == base.DONE -> break
        if status != base.ROW {
            failure = Val(error(driver))
            break
        }
        row := [String:DBValue]{}
        loop at in 0..<count {
            value := DBValue.Null
            kind: api.column_type(driver.database, statement.stmt, at)
            if {
                kind == base.SQL_INTEGER -> {
                    value = DBValue.Int(api.column_int64(driver.database, statement.stmt, at))
                }
                kind == base.SQL_FLOAT -> {
                    value = DBValue.Float(api.column_double(driver.database, statement.stmt, at))
                }
                kind == base.SQL_TEXT -> {
                    text: api.column_text(driver.database, statement.stmt, at) ?? [U8]{}
                    // The Rust original maps invalid UTF-8 to "".
                    value = DBValue.Text(String.from_bytes(text) ?? "")
                }
                kind == base.SQL_BLOB -> {
                    value = DBValue.Blob(api.column_blob(driver.database, statement.stmt, at))
                }
                else -> {}
            }
            wire_rows += cell_wire_width(value)
            if row.get(names[at]) == .Val(_) -> duplicate = true
            row[names[at].copy()] = value.move()
        }
        wire_rows += row_prefix
        if count > 100000 -> column_overflow = true
        rows.push(row)
    }
    release(driver, statement)
    if failure == .Val(found_failure) -> return Err(found_failure)
    if wire_rows + decimal_width(rows.len()) + 3 > 67108864 {
        return Err(db_error("database result exceeds the wire-size limit"))
    }
    if rows.len() > 1000000 -> return Err(db_error("database row count exceeds the wire limit"))
    if column_overflow -> return Err(db_error("database column count exceeds the wire limit"))
    if duplicate -> return Err(db_error("database row contains a duplicate column"))
    Ok(rows)
}

__driver_query_one: fn(driver: &DBDriver, sql: String, params: [DBValue]) -> [String:DBValue]? DBError! {
    rows := __driver_query(driver, sql, params) ?? return Err(err)
    if rows.len() == 0 -> return Ok(None)
    first: rows.remove(0, .Slot) ?? panic("SQLite first row disappeared")
    Ok(Val(first))
}

__driver_health: fn(driver: &DBDriver) -> Bool Never! {
    if __driver_query_one(driver, "SELECT 1", [DBValue]{}) == {
        .Ok(found) -> found != None
        .Err(_) -> false
    }
}

#Test("typed SQL rows preserve conversion and missing-column errors") {
    row: [String:DBValue]{"number": DBValue.Int(42), "text": DBValue.Text("jet"), "zero": DBValue.Int(0), "one": DBValue.Int(1)}
    assert_eq(row_int(row, "number") ?? -1, 42)
    assert_eq(row_float(row, "number") ?? -1.0, 42.0)
    assert_eq(row_text(row, "text") ?? "", "jet")
    assert_eq(row_bool(row, "zero") ?? true, false)
    assert_eq(row_bool(row, "one") ?? false, true)
    if row_value(row, "absent") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message(), "missing column `absent`")
    }
    if row_int(row, "text") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message(), "expected an int, got jet")
    }
    floating: [String:DBValue]{"value": DBValue.Float(1.0)}
    if row_int(floating, "value") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message(), "expected an int, got 1")
    }
    large: [String:DBValue]{"value": DBValue.Float(1e21)}
    if row_int(large, "value") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message(), "expected an int, got 1000000000000000000000")
    }
    blob: [String:DBValue]{"value": DBValue.Blob([U8]{1, 2})}
    if row_text(blob, "value") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message(), "expected text, got [1, 2]")
    }
}

#Test("SQLite driver preserves typed bindings, storage affinities and transaction behavior") {
    driver := __driver_open(":memory:") ?? panic("SQLite memory open failed")
    assert(__driver_begin(driver))
    _: __driver_execute(driver, "CREATE TABLE values_store (value INTEGER)", [DBValue]{}) ?? panic("SQLite create failed")
    assert_eq(__driver_execute(driver, "INSERT INTO values_store VALUES (?)", [DBValue]{.Int(17)}) ?? -1, 1)
    assert(__driver_rollback(driver))
    _: __driver_execute(driver, "CREATE TABLE values_store (value INTEGER)", [DBValue]{}) ?? panic("SQLite rollback did not undo schema")
    assert(__driver_begin(driver))
    _: __driver_execute(driver, "INSERT INTO values_store VALUES (?)", [DBValue]{.Int(42)}) ?? panic("SQLite insert failed")
    assert(__driver_commit(driver))
    selected: __driver_query(driver, "SELECT value FROM values_store", [DBValue]{}) ?? panic("SQLite select failed")
    assert_eq(row_int(selected[0], "value") ?? -1, 42)

    bindings: [DBValue]{.Null, .Int(9223372036854775807), .Int(-9223372036854775808), .Float(1.25), .Text(""), .Text("jet{nul_text()}λ"), .Bool(true), .Blob([U8]{}), .Blob([U8]{0, 1, 255})}
    rows: __driver_query(driver, "SELECT ? AS missing, ? AS largest, ? AS smallest, ? AS real, ? AS empty, ? AS text, ? AS flag, ? AS empty_blob, ? AS blob", bindings) ?? panic("SQLite bindings failed")
    row: rows[0]
    assert((row_value(row, "missing") ?? panic("missing null")).is_null())
    assert_eq(row_int(row, "largest") ?? 0, 9223372036854775807)
    assert_eq(row_int(row, "smallest") ?? 0, -9223372036854775808)
    assert_eq(row_float(row, "real") ?? 0.0, 1.25)
    assert_eq(row_text(row, "empty") ?? "not empty", "")
    assert_eq(row_text(row, "text") ?? "", "jet{nul_text()}λ")
    assert_eq(row_int(row, "flag") ?? 0, 1)
    assert_eq((row_value(row, "empty_blob") ?? panic("missing empty blob")).blob() ?? [U8]{1}, [U8]{})
    assert_eq((row_value(row, "blob") ?? panic("missing blob")).blob() ?? [U8]{}, [U8]{0, 1, 255})
    invalid_utf8: __driver_query(driver, "SELECT CAST(X'ff' AS TEXT) AS value", [DBValue]{}) ?? panic("SQLite text selection failed")
    assert_eq(row_text(invalid_utf8[0], "value") ?? "invalid", "")
    if __driver_query_one(driver, "SELECT value FROM values_store WHERE value = 0", [DBValue]{}) == {
        .Val(_) -> { assert(false) }
        .None -> {}
        .Err(_) -> assert(false)
    }
    assert(__driver_health(driver))
    assert(__driver_shutdown(driver))
}

#Test("SQLite driver builds an index over existing rows and keeps UNIQUE indexes unique") {
    driver := __driver_open(":memory:") ?? panic("SQLite memory open failed")
    _: __driver_execute(driver, "CREATE TABLE jobs (queue TEXT NOT NULL, state TEXT NOT NULL, due INTEGER NOT NULL, sequence INTEGER NOT NULL)", [DBValue]{}) ?? panic("SQLite create failed")
    loop n in 0..<40 {
        _: __driver_execute(driver, "INSERT INTO jobs VALUES (?, ?, ?, ?)", [DBValue]{.Text("q{n % 3}"), .Text(if n % 2 == 0 -> "ready" else -> "done"), .Int(100 - n), .Int(n)}) ?? panic("SQLite insert failed")
    }
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS jobs_due ON jobs (queue, state, due, sequence)", [DBValue]{}) ?? panic("SQLite create index failed")
    _: __driver_execute(driver, "CREATE INDEX IF NOT EXISTS jobs_due ON jobs (queue, state, due, sequence)", [DBValue]{}) ?? panic("SQLite repeated create index failed")
    _: __driver_execute(driver, "INSERT INTO jobs VALUES ('q1', 'ready', 1, 40)", [DBValue]{}) ?? panic("SQLite insert after index failed")
    // INDEXED BY reads the rows from the index alone: the refill wrote every
    // existing row and the later insert added its own.
    due: __driver_query(driver, "SELECT sequence FROM jobs INDEXED BY jobs_due WHERE queue = 'q1' AND state = 'ready' ORDER BY due", [DBValue]{}) ?? panic("SQLite indexed select failed")
    assert_eq(due.map(fn(row) { row_int(row, "sequence") ?? -1 }), [Int]{40, 34, 28, 22, 16, 10, 4})
    schema: __driver_query(driver, "SELECT sql FROM sqlite_master WHERE name = 'jobs_due'", [DBValue]{}) ?? panic("SQLite schema read failed")
    assert_eq(row_text(schema[0], "sql") ?? "", "CREATE INDEX jobs_due ON jobs (queue, state, due, sequence)")
    if __driver_execute(driver, "CREATE UNIQUE INDEX jobs_queue ON jobs (queue)", [DBValue]{}) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert(error.message().contains("UNIQUE constraint failed: jobs.queue"))
    }
    _: __driver_execute(driver, "CREATE UNIQUE INDEX jobs_sequence ON jobs (sequence)", [DBValue]{}) ?? panic("SQLite unique index failed")
    if __driver_execute(driver, "INSERT INTO jobs VALUES ('q0', 'ready', 5, 3)", [DBValue]{}) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert(error.message().contains("UNIQUE constraint failed: jobs.sequence"))
    }
    assert(__driver_shutdown(driver))
}

// Ordinary scope-end Close finalizes the driver's cached statements and then
// closes its connection when this probe returns; no explicit close here.
priv driver_cache_parity_probe: fn() Never! {
    driver := __driver_open(":memory:") ?? panic("SQLite open failed")
    loop number in 0..<20 {
        rows: __driver_query(driver, "SELECT {number} AS value", [DBValue]{}) ?? panic("SQLite cache prepare failed")
        assert_eq(row_int(rows[0], "value") ?? -1, number)
    }
    cached: __driver_query(driver, "  SELECT 19 AS value  ", [DBValue]{}) ?? panic("SQLite trimmed cache key failed")
    assert_eq(row_int(cached[0], "value") ?? -1, 19)
    assert(__driver_begin(driver))
    assert(__driver_reset(driver))
    assert(__driver_begin(driver))
    assert(__driver_rollback(driver))
    if __driver_execute(driver, "SELECT ? AS value", [DBValue]{.Int(1)}) == {
        .Ok(_) -> { assert(false) }
        .Err(failure) -> {
            assert_eq(failure.message(), "Execute returned results - did you mean to call query?")
        }
    }
    if __driver_query(driver, "SELECT ?", [DBValue]{}) == {
        .Ok(_) -> { assert(false) }
        .Err(failure) -> {
            assert_eq(failure.message(), "Wrong number of parameters passed to query. Got 0, needed 1")
        }
    }
    if __driver_query(driver, "SELECT 1 AS same, 2 AS same", [DBValue]{}) == {
        .Ok(_) -> { assert(false) }
        .Err(failure) -> assert_eq(failure.message(), "database row contains a duplicate column")
    }
    if __driver_query(driver, "SELEC invalid", [DBValue]{}) == {
        .Ok(_) -> { assert(false) }
        .Err(failure) -> assert(failure.message().contains(" in SELEC invalid at offset 0"))
    }
}

#Test("SQLite driver retains cache/error parity and releases every cached handle") {
    warm := __driver_open(":memory:") ?? panic("SQLite warmup failed")
    assert(__driver_shutdown(warm))
    assert(!__driver_shutdown(warm))
    assert(driver_closed(warm))
    driver_cache_parity_probe()
    // The cache keeps the 16 newest statements; finalizing them leaves the
    // connection with no statement.
    driver := __driver_open(":memory:") ?? panic("SQLite open failed")
    loop number in 0..<20 {
        _: __driver_query(driver, "SELECT {number} AS value", [DBValue]{}) ?? panic("SQLite cache prepare failed")
    }
    assert_eq(driver.cache.len(), 16)
    driver_finalize_cache(driver)
    assert_eq(driver.cache.len(), 0)
    assert_eq(driver.database.vdbe_head, -1)
    assert(__driver_shutdown(driver))
    if __driver_open("bad{nul_text()}filename") == .Val(_) -> assert(false)
    if __driver_open("/") == .Val(_) -> assert(false)
}

#Test("typed SQL literals join their pieces with placeholders") {
    sql: __sql_literal([String]{"SELECT ", " FROM t WHERE a = ", ""}, [DBValue]{.Int(1), .Text("x")})
    assert_eq(sql.text, "SELECT ? FROM t WHERE a = ?")
    assert_eq(sql.values, [DBValue]{.Int(1), .Text("x")})
    assert_eq(__sql_literal([String]{"SELECT 1"}, [DBValue]{}).text, "SELECT 1")
}

#Test("row policies scope SQL to one table and bind the owner") {
    owned: RowPolicy{table: "tasks", owner: true}
    select: policy_apply(SQL{text: "SELECT title FROM tasks WHERE done = ? ORDER BY title", values: [DBValue]{.Int(0)}}, owned, "alice", false) ?? panic("select")
    assert_eq(select.text, "SELECT title FROM tasks WHERE (done = ?) AND owner = ? ORDER BY title")
    assert_eq(select.values, [DBValue]{.Int(0), .Text("alice")})
    bare: policy_apply(sql_raw("SELECT title FROM tasks"), owned, "alice", false) ?? panic("bare")
    assert_eq(bare.text, "SELECT title FROM tasks WHERE owner = ?")
    assert_eq(bare.values, [DBValue]{.Text("alice")})
    insert: policy_apply(SQL{text: "INSERT INTO tasks (owner, title) VALUES (?, ?)", values: [DBValue]{.Text("bob"), .Text("one")}}, owned, "alice", false) ?? panic("insert")
    assert_eq(insert.values, [DBValue]{.Text("alice"), .Text("one")})
    open: RowPolicy{table: "tasks", owner: false}
    same: policy_apply(sql_raw("SELECT * FROM tasks LIMIT 1"), open, "alice", false) ?? panic("open")
    assert_eq(same.text, "SELECT * FROM tasks LIMIT 1")
    schema: policy_apply(sql_raw("CREATE TABLE tasks (owner TEXT)"), open, "alice", true) ?? panic("schema")
    assert_eq(schema.text, "CREATE TABLE tasks (owner TEXT)")
    // SQL that targets no table or another table runs unchanged (#6070).
    outside_sql: [String]{"SELECT 1", "SELECT title FROM other WHERE id = 1", "INSERT INTO other (title) VALUES ('x')"}
    loop text in outside_sql {
        outside: policy_apply(sql_raw(text), owned, "alice", false) ?? panic("outside `{text}`")
        assert_eq(outside.text, text)
        assert_eq(outside.values.len(), 0)
    }
    rejected: [{sql: String, message: String}]{
        {sql: "SELECT title FROM other JOIN tasks", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"},
        {sql: "SELECT title FROM other WHERE owner IN (SELECT owner FROM tasks)", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"},
        {sql: "SELECT 1 FROM main.tasks", message: "policy-scoped SQL that reads `tasks` must target it as its one simple table"},
        {sql: "SELECT 1 FROM tasks; DROP TABLE tasks", message: "policy-scoped SQL must be one statement without control characters"},
        {sql: "SELECT * FROM tasks -- note", message: "policy-scoped SQL cannot contain comments"},
        {sql: "CREATE TABLE tasks (x)", message: "schema and transaction-control SQL is only allowed in db.migrate or through the scope transaction controls"},
        {sql: "SELECT * FROM tasks JOIN other", message: "policy-scoped SQL must name one simple target table without joins or subqueries"},
        {sql: "UPDATE tasks SET owner = 'bob' WHERE id = 1", message: "owner policy does not allow changing the owner column"},
        {sql: "VACUUM", message: "row policy supports SELECT, INSERT, UPDATE, and DELETE only"},
        {sql: "SELECT * FROM __jet_migrations", message: "migration metadata is managed only by db.migrate"},
    }
    loop entry in rejected {
        if policy_apply(sql_raw(entry.sql), owned, "alice", false) == .Err(failure) {
            assert_eq(failure.message(), entry.message)
        } else { panic("accepted `{entry.sql}`") }
    }
    assert_eq(policy_show(owned), "RowPolicy(table=tasks, expr=owner == user)")
    assert(policy_allows(owned, user: "alice", owner: "alice"))
    assert(!policy_allows(owned, user: "alice", owner: "bob"))
    assert(policy_allows(open, user: "alice", owner: "bob"))
}

#Test("an opened connection queries every row with no row policy, and schema changes stay in db.migrate") {
    store: open_memory()
    _: migrate(store.all_rows(), "notes-v1", [SQL]{sql_raw("CREATE TABLE notes (id INTEGER, owner TEXT)"), sql_raw("CREATE TABLE tags (note INTEGER, tag TEXT)")}) ?? panic("migrate: {err}")
    assert_eq(store.execute(sql_raw("INSERT INTO notes (id, owner) VALUES (1, 'ann'), (2, 'ben')")) ?? panic("notes: {err}"), 2)
    _: store.execute(sql_raw("INSERT INTO tags (note, tag) VALUES (2, 'home')")) ?? panic("tags: {err}")
    assert_eq((store.query(sql_raw("SELECT id FROM notes")) ?? panic("every note: {err}")).len(), 2)
    joined: store.query(sql_raw("SELECT notes.owner, tags.tag FROM notes JOIN tags ON tags.note = notes.id")) ?? panic("join: {err}")
    assert_eq(joined.len(), 1)
    assert_eq(row_text(joined[0], "owner") ?? panic("owner"), "ben")
    one: store.query_one(sql_raw("SELECT 1 AS one")) ?? panic("select 1 reads one row")
    assert_eq(row_int(one, "one") ?? panic("one"), 1)
    if store.execute(sql_raw("DROP TABLE tags")) == .Ok(_) {
        panic("a connection dropped a table outside db.migrate")
    }
    owned: RowPolicy{table: "notes", owner: true}
    assert_eq((store.with_policy(owned, "ann").query(sql_raw("SELECT id FROM notes")) ?? panic("ann: {err}")).len(), 1)
    assert(store.close())
}

#Test("migration identities hash every field with its length") {
    assert_eq(hex16(fnv_offset()), "cbf29ce484222325")
    assert_eq(hex16(hash_field(fnv_offset(), "")).len(), 16)
    assert(migration_checksum("v1", [SQL]{sql_raw("CREATE TABLE a (x)")}).starts_with("migration-v2:"))
    assert(migration_checksum("v1", [SQL]{sql_raw("CREATE TABLE a (x)")}) != migration_checksum("v2", [SQL]{sql_raw("CREATE TABLE a (x)")}))
}
