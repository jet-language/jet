// Real-world SQLite 3.45.0 statement corpus checked against SQL.check.
use core.db.[SQL]

#Test("SQL grammar accepts a broad corpus of real SQLite 3.45.0 statements") {
    corpus: [String]{
        "SELECT 1",
        "SELECT 1 + 2 * 3 - 4 / 2, ~5, 1 << 4, 16 >> 2, 7 % 3, 'a' || 'b'",
        "SELECT DISTINCT a, b AS alias_b, c bare_c FROM t1 INNER JOIN t2 ON t1.id = t2.t1_id LEFT OUTER JOIN t3 USING (k) WHERE t1.x >= 10 AND t2.y <> 'z' GROUP BY a HAVING count(*) > 1 ORDER BY a ASC NULLS FIRST, b DESC NULLS LAST LIMIT 20 OFFSET 5",
        "SELECT * FROM (SELECT id FROM users) AS u CROSS JOIN (SELECT 1 AS one) o",
        "SELECT * FROM main.users INDEXED BY idx_users WHERE id IN (1, 2, 3) AND status NOT IN (SELECT bad FROM blocked)",
        "SELECT * FROM t WHERE a IS NULL OR b IS NOT NULL OR c ISNULL OR d NOTNULL",
        "SELECT CASE status WHEN 1 THEN 'open' WHEN 2 THEN 'closed' ELSE 'other' END, CASE WHEN x > 0 THEN x ELSE -x END FROM t",
        "SELECT CAST(price AS REAL), CAST(count AS INTEGER) FROM items",
        "SELECT a FROM t1 UNION SELECT a FROM t2 UNION ALL SELECT a FROM t3 INTERSECT SELECT a FROM t4 EXCEPT SELECT a FROM t5",
        "VALUES (1, 'a'), (2, 'b'), (3, 'c')",
        "WITH a AS MATERIALIZED (SELECT 1 AS n), b(m) AS NOT MATERIALIZED (SELECT n + 1 FROM a) SELECT m FROM b",
        "WITH RECURSIVE tree(id, depth) AS (SELECT id, 0 FROM nodes WHERE parent IS NULL UNION ALL SELECT n.id, t.depth + 1 FROM nodes n JOIN tree t ON n.parent = t.id) SELECT * FROM tree",
        "SELECT id, row_number() OVER w, lag(val, 1, 0) OVER w FROM metrics WINDOW w AS (PARTITION BY grp ORDER BY ts RANGE BETWEEN 10 PRECEDING AND 5 FOLLOWING EXCLUDE CURRENT ROW)",
        "SELECT id, sum(x) OVER (ORDER BY id GROUPS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE GROUP) FROM t",
        "SELECT id, avg(x) OVER (w ORDER BY id ROWS 3 PRECEDING EXCLUDE NO OTHERS) FROM t WINDOW w AS (PARTITION BY k)",
        "SELECT count(*), count(DISTINCT a), group_concat(name ORDER BY name DESC) FROM users",
        "SELECT json_extract(doc, '$.a'), doc -> '$.b' ->> 0 FROM payloads WHERE EXISTS (SELECT 1 FROM flags WHERE flags.id = payloads.id)",
        "SELECT (1, 2) = (1, 2), (a, b) IN (VALUES (1, 2), (3, 4)) FROM pairs",
        "SELECT CURRENT_DATE, CURRENT_TIME, CURRENT_TIMESTAMP, TRUE, FALSE, NULL, 0xFF, 1.5e-3, .25, X'00ff'",
        "SELECT name COLLATE NOCASE FROM users WHERE name GLOB 'a*' AND note REGEXP '^[0-9]+$' AND tag MATCH 'foo'",
        "INSERT INTO logs DEFAULT VALUES",
        "INSERT OR IGNORE INTO kv (k, v) VALUES ('a', 1), ('b', 2)",
        "INSERT OR REPLACE INTO kv (k, v) SELECT k, v FROM staging ON CONFLICT (k) WHERE v > 0 DO NOTHING",
        "INSERT INTO counters AS c (k, n) VALUES ('hits', 1) ON CONFLICT (k) DO UPDATE SET n = c.n + excluded.n WHERE excluded.n > 0 RETURNING k, n",
        "REPLACE INTO cache (k, v) VALUES ('x', X'abcd')",
        "UPDATE OR ABORT users AS u SET (first, last) = ('Ada', 'Lovelace'), active = true FROM edits e WHERE u.id = e.user_id RETURNING u.id",
        "UPDATE tasks SET done = 1 WHERE owner = ?1 ORDER BY id LIMIT 10",
        "DELETE FROM sessions NOT INDEXED WHERE expires_at < :now RETURNING id",
        "CREATE TEMP TABLE scratch (id INTEGER PRIMARY KEY, val TEXT) WITHOUT ROWID",
        "CREATE TEMPORARY TABLE t_as AS SELECT id, name FROM users",
        "CREATE TABLE orders (id INTEGER CONSTRAINT pk_orders PRIMARY KEY ASC ON CONFLICT ROLLBACK AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE ON UPDATE RESTRICT MATCH SIMPLE DEFERRABLE INITIALLY DEFERRED, amount NUMERIC(10, 2) DEFAULT (-1.0), note TEXT DEFAULT ('n/a'), UNIQUE (user_id, note) ON CONFLICT IGNORE, CONSTRAINT fk_u FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL, CONSTRAINT ck_amt CHECK (amount >= -100)) STRICT",
        "CREATE UNIQUE INDEX IF NOT EXISTS main.idx_orders_u ON orders (user_id ASC, amount DESC) WHERE amount > 0",
        "CREATE VIEW IF NOT EXISTS active_users (uid, uname) AS SELECT id, name FROM users WHERE active = 1",
        "CREATE TRIGGER tr_no_del BEFORE DELETE ON users BEGIN SELECT RAISE(ABORT, 'cannot delete user'); END",
        "CREATE TRIGGER tr_upd AFTER UPDATE OF name, email ON users FOR EACH ROW WHEN OLD.name <> NEW.name BEGIN INSERT INTO audit VALUES (OLD.id, NEW.name); UPDATE stats SET edits = edits + 1; END",
        "CREATE TRIGGER tr_instead INSTEAD OF INSERT ON active_users BEGIN INSERT INTO users(id, name, active) VALUES (NEW.uid, NEW.uname, 1); END",
        "CREATE VIRTUAL TABLE search USING fts5(title, body, content='articles', content_rowid='id')",
        "ALTER TABLE users RENAME TO accounts",
        "ALTER TABLE accounts RENAME COLUMN name TO full_name",
        "ALTER TABLE accounts RENAME email TO contact_email",
        "ALTER TABLE accounts ADD COLUMN bio TEXT DEFAULT ''",
        "ALTER TABLE accounts ADD nickname TEXT",
        "ALTER TABLE accounts DROP COLUMN bio",
        "ALTER TABLE accounts DROP nickname",
        "DROP TABLE IF EXISTS scratch",
        "DROP INDEX IF EXISTS idx_orders_u",
        "DROP VIEW IF EXISTS active_users",
        "DROP TRIGGER IF EXISTS tr_no_del",
        "BEGIN DEFERRED TRANSACTION",
        "BEGIN IMMEDIATE",
        "BEGIN EXCLUSIVE TRANSACTION tx1",
        "COMMIT TRANSACTION",
        "END",
        "SAVEPOINT sp1",
        "ROLLBACK TRANSACTION TO SAVEPOINT sp1",
        "RELEASE SAVEPOINT sp1",
        "ROLLBACK TO sp1",
        "RELEASE sp1",
        "PRAGMA main.user_version = 42",
        "PRAGMA cache_size = -2000",
        "PRAGMA table_info('users')",
        "PRAGMA foreign_keys",
        "ATTACH DATABASE 'aux.db' AS aux",
        "ATTACH 'aux2.db' AS aux2",
        "DETACH DATABASE aux",
        "DETACH aux2",
        "VACUUM main INTO 'backup.db'",
        "ANALYZE main.users",
        "REINDEX NOCASE",
        "EXPLAIN SELECT 1",
        "EXPLAIN QUERY PLAN SELECT * FROM users WHERE id = $id",
        "-- leading comment\n/* block comment */ SELECT 1; SELECT 2;",
    }
    loop (index, stmt) in corpus {
        if SQL.check([String]{stmt}) == {
            .Ok(_) -> {}
            .Err(e) -> panic("corpus[{index}] failed: {stmt}\n  reason: {e.reason}")
        }
    }
}
