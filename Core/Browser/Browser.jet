use {
    core: core
    text: core.text
    parse: core.text.parse
    core.net.ws.[WsConn, WsError]
    core.encoding.[Dyn]
    core.time.[Instant]
    tree: __core_encoding_stream
    json: core.encoding.json
    base64: core.encoding.base64
    files: core.files
    http: core.http
    net: core.net
    process: core.process
    time: core.time
}

// core.browser — headed/headless browser control for tests.
//
// The WebDriver BiDi session runs in Jet over core.net.ws: one shared session
// state per connection, ordered command/reply matching, a bounded event queue,
// and a redacted trace. Profiles and timeout validation remain offline-checkable.

host: module
storage: module

C_MAX_SOURCE_BYTES: 1048576

C_MAX_SOURCE_NAME: 256

C_TRACE_LIMIT_BYTES: 8192

C_EVENT_LIMIT: 256

C_MAX_REPORT_BYTES: 16777216

C_MAX_SERVER_LOG_BYTES: 65536

#Error
BrowserError: struct {
    kind: String

    impl Display {
        display: fn(self) -> String {
            if self.kind == {
                "invalid profile" -> "browser profile is not supported"
                "invalid timeout" -> "browser timeout must be between 1 and 600000 milliseconds"
                "unsupported protocol" -> "browser protocol is not available in this session"
                "timeout" -> "browser operation timed out"
                "closed" -> "browser session is closed"
                "transport" -> "browser transport failed"
                "missing lock" -> "no locked browser for this engine in .jet/lock"
                "unknown engine" -> "browser engine is not supported"
                "missing binary" -> "locked browser binary was not found"
                "missing driver" -> "this engine needs a locked WebDriver driver to launch"
                "size mismatch" -> "locked browser binary size drifted"
                "invalid lock" -> "browser lock entry is incomplete"
                else -> "browser protocol failed"
            }
        }
    }
}

BrowserTimeout: struct {
    milliseconds: Int
}

BrowserProfile: struct {
    name: String
    version: String
}

BrowserAbilities: struct {
    bidi: Bool
    cdp: Bool
    profile: String

    bidi: fn(self) -> Bool Never! { self.bidi }
    cdp: fn(self) -> Bool Never! { self.cdp }
    profile: fn(self) -> String Never! { self.profile }
}

// Privacy defaults of a connected session: isolated user contexts, redacted
// receipts, and no shared profiles.
BrowserPrivacy: struct {
    isolated_profiles: Bool
    redact_receipts: Bool
    shared_profiles: Bool

    isolated_profiles: fn(self) -> Bool Never! { self.isolated_profiles }
    redact_receipts: fn(self) -> Bool Never! { self.redact_receipts }
    shared_profiles: fn(self) -> Bool Never! { self.shared_profiles }
}

// One bounded, redacted event: method name, request facts, debugger facts, and
// hashes only.
BrowserEvent: struct {
    method: String
    request_id: String
    request_method: String
    url_hash: String
    is_blocked: Bool
    status_code: Int
    download_id: String
    suggested_filename_hash: String
    frame_line: Int
    frame_column: Int
    frame_function_hash: String
    source_map_url_hash: String
    // The CDP session a `goog:cdp` event came from, "" for a BiDi event. A
    // page's CDP handle takes only its own session's events; the session
    // never leaves Core.
    __session: String

    kind: fn(self) -> String Never! { self.method }
    request_id: fn(self) -> String Never! { self.request_id }
    request_method: fn(self) -> String Never! { self.request_method }
    url_hash: fn(self) -> String Never! { self.url_hash }
    is_blocked: fn(self) -> Bool Never! { self.is_blocked }
    status_code: fn(self) -> Int Never! { self.status_code }
    download_id: fn(self) -> String Never! { self.download_id }
    suggested_filename_hash: fn(self) -> String Never! { self.suggested_filename_hash }
    // The top call frame of a `Debugger.paused`: its 0-based line and column
    // and the hash of its function name. -1, -1 and "" on any other event.
    frame_line: fn(self) -> Int Never! { self.frame_line }
    frame_column: fn(self) -> Int Never! { self.frame_column }
    frame_function_hash: fn(self) -> String Never! { self.frame_function_hash }
    // The hash of the source-map URL a `Debugger.scriptParsed` names; "" when
    // the script names none.
    source_map_url_hash: fn(self) -> String Never! { self.source_map_url_hash }
}

BrowserTrace: struct {
    entries: [String]

    entry_count: fn(self) -> Int Never! { self.entries.len() }
    redacted: fn(self) -> Bool Never! { trace_redacted(self.entries) }
    summary: fn(self) -> String Never! { self.entries.join(",") }
}

BrowserReceipt: struct {
    entries: [String]
    isolated: Bool
    cleaned: Bool

    entry_count: fn(self) -> Int Never! { self.entries.len() }
    redacted: fn(self) -> Bool Never! { trace_redacted(self.entries) }
    summary: fn(self) -> String Never! { self.entries.join(",") }
    isolated: fn(self) -> Bool Never! { self.isolated }
    cleaned: fn(self) -> Bool Never! { self.cleaned }
}

// The session's one WebSocket and its protocol state, shared by every copy of
// a handle; the last copy closes the socket.
__BrowserState: struct {
    conn: WsConn
    next_id: Int
    closed: Bool
    session_started: Bool
    timeout_ms: Int
    profile: String
    cdp: Bool
    trace: [String]
    trace_bytes: Int
    events: [BrowserEvent]
    engine: __BrowserEngine?

    // The last copy of a Browser that was never closed ends its session as
    // `close` does, best effort: it sends `session.end` and waits for its
    // reply, skipping events, until the session's timeout. A gone peer needs
    // no end. The engine, if any, stops after this, when its field drops.
    impl Close {
        close: fn(&&self) {
            if self.closed || !self.session_started -> return
            id: self.next_id
            core.browser.__ws_set_timeout(self.conn, self.timeout_ms) ?? return
            self.conn.send_text("{{\"id\":{id},\"method\":\"session.end\",\"params\":{{}}}}") ?? return
            loop _ in 0..<C_EVENT_LIMIT {
                message: self.conn.recv() ?? return
                body: message.text() ?? return
                value: json.parse(body) ?? return
                if browser_id(value) == .Val(got) {
                    if got == id -> return
                }
            }
        }
    }
}

// The engine process and throwaway profile that `launch` started. The
// session state is its one owner, so the last Browser copy (or close) stops
// the engine and removes the profile. For Chromium the process is
// chromedriver and `session_url` is its WebDriver session; Chromium outlives
// a killed chromedriver, so close deletes that session (which quits the
// browser) before stopping the driver.
__BrowserEngine: struct {
    child: ProcessChild
    profile: String
    session_url: String

    impl Close {
        close: fn(&&self) {
            // Close cannot fail: an engine that already exited cannot be
            // signalled, and wait still reaps it.
            if self.session_url != "" -> http.__request("DELETE", self.session_url).send().drop("a gone driver session needs no delete")
            self.child.kill().drop("an exited engine needs no signal")
            self.child.wait().drop("the engine receipt is not reported")
            files.remove_all(self.profile).drop("profile removal at close is best-effort")
        }
    }
}

// The id and closed fact of one BiDi resource (user context, browsing
// context, frame, or intercept), shared by every copy of its handle.
__BrowserScope: struct {
    id: String
    closed: Bool
}

Browser: struct {
    __state: Shared<__BrowserState>

    abilities: fn(self) -> BrowserAbilities Never! {
        guard: self.__state.guard_read()
        BrowserAbilities{bidi: true, cdp: guard.value.cdp, profile: guard.value.profile}
    }

    context: fn(self) -[Net, Time]> BrowserContext BrowserError! {
        result: browser_command(self, "browser.createUserContext", empty_object())
        id: browser_string(result, "userContext")
        Ok(BrowserContext{__browser: self, __scope: new_scope(id)})
    }

    // A BiDi event; CDP events go through `protocol("cdp").subscribe`.
    subscribe: fn(self, event: String) BrowserError! -[Net, Time]> {
        if event.starts_with("goog:cdp") -> return Err(BrowserError{kind: "unsupported protocol"})
        browser_command(self, "session.subscribe", obj([(key: "events", value: Dyn.Array([Dyn]{Dyn.Text(event.copy())}))]))
        Ok()
    }

    next_event: fn(self, timeout: BrowserTimeout) -[Net, Time]> BrowserEvent BrowserError! {
        if browser_closed(self) -> return Err(BrowserError{kind: "closed"})
        if browser_pop_event(self) == .Val(queued) -> return Ok(queued)
        started: time.instant()
        value: browser_recv_json(self, started, timeout.milliseconds)
        if !browser_capture_event(self, value) -> return Err(BrowserError{kind: "protocol"})
        event: browser_pop_event(self) ?? return Err(BrowserError{kind: "protocol"})
        Ok(event)
    }

    add_intercept: fn(self, phase: String) -[Net, Time]> BrowserIntercept BrowserError! {
        if !phase_ok(phase) -> return Err(BrowserError{kind: "protocol"})
        result: browser_command(self, "network.addIntercept", obj([(key: "phases", value: Dyn.Array([Dyn]{Dyn.Text(phase.copy())}))]))
        id: browser_string(result, "intercept")
        Ok(BrowserIntercept{__browser: self, __scope: new_scope(id)})
    }

    add_intercept_url: fn(self, phase: String, url_pattern: String) -[Net, Time]> BrowserIntercept BrowserError! {
        if !phase_ok(phase) || url_pattern.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        pattern: obj([(key: "type", value: Dyn.Text("string")), (key: "pattern", value: Dyn.Text(url_pattern.copy()))])
        result: browser_command(self, "network.addIntercept", obj([
            (key: "phases", value: Dyn.Array([Dyn]{Dyn.Text(phase.copy())})),
            (key: "urlPatterns", value: Dyn.Array([Dyn]{pattern.move()}))
        ]))
        id: browser_string(result, "intercept")
        Ok(BrowserIntercept{__browser: self, __scope: new_scope(id)})
    }

    continue_request: fn(self, request_id: String) BrowserError! -[Net, Time]> {
        if request_id.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        browser_command(self, "network.continueRequest", obj([(key: "request", value: Dyn.Text(request_id.copy()))]))
        Ok()
    }

    fail_request: fn(self, request_id: String) BrowserError! -[Net, Time]> {
        if request_id.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        browser_command(self, "network.failRequest", obj([(key: "request", value: Dyn.Text(request_id.copy())), (key: "errorReason", value: Dyn.Text("Failed"))]))
        Ok()
    }

    fulfill_request: fn(self, request_id: String, status: Int, body: String) BrowserError! -[Net, Time]> {
        if request_id.len() == 0 || status < 100 || status > 599 -> return Err(BrowserError{kind: "protocol"})
        browser_command(self, "network.provideResponse", obj([
            (key: "request", value: Dyn.Text(request_id.copy())),
            (key: "statusCode", value: Dyn.Int(status)),
            (key: "body", value: string_value(body))
        ]))
        Ok()
    }

    // Allow downloads into an absolute destination folder.
    allow_downloads: fn(self, folder: String) BrowserError! -[Net, Time]> {
        if folder.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        behavior: obj([(key: "type", value: Dyn.Text("allowed")), (key: "destinationFolder", value: Dyn.Text(folder.copy()))])
        browser_command(self, "browser.setDownloadBehavior", obj([(key: "downloadBehavior", value: behavior)]))
        Ok()
    }

    protocol: fn(self, kind: String) -> BrowserProtocol BrowserError! {
        guard: self.__state.guard_read()
        if guard.value.closed -> return Err(BrowserError{kind: "closed"})
        supported: kind == "bidi" || (kind == "cdp" && guard.value.cdp)
        if !supported -> return Err(BrowserError{kind: "unsupported protocol"})
        Ok(BrowserProtocol{__browser: self, __kind: kind, __context: new_scope(""), __page: new_scope(""), __session: new_scope("")})
    }

    trace: fn(self) -> BrowserTrace Never! {
        guard: self.__state.guard_read()
        BrowserTrace{entries: guard.value.trace.copy()}
    }

    privacy: fn(self) -> BrowserPrivacy Never! {
        BrowserPrivacy{isolated_profiles: true, redact_receipts: true, shared_profiles: false}
    }

    receipt: fn(self) -> BrowserReceipt Never! {
        guard: self.__state.guard_read()
        BrowserReceipt{entries: guard.value.trace.copy(), isolated: true, cleaned: guard.value.closed}
    }

    close: fn(self) BrowserError! -[Net, Time]> {
        if browser_closed(self) -> return Ok()
        if browser_session_started(self) -> browser_command(self, "session.end", empty_object())
        browser_mark_closed(self)
        Ok()
    }
}

BrowserContext: struct {
    __browser: Browser
    __scope: Shared<__BrowserScope>

    page: fn(self) -[Net, Time]> BrowserPage BrowserError! { context_create_tab(self) }
    tab: fn(self) -[Net, Time]> BrowserPage BrowserError! { context_create_tab(self) }
    // Contexts are always isolated BiDi user contexts.
    isolated: fn(self) -> Bool Never! { true }
    // The hashed user-context id; the raw id never leaves the session.
    user_hash: fn(self) -> String Never! { fact_hash(scope_id(self.__scope)) }

    close: fn(self) BrowserError! -[Net, Time]> {
        if scope_closed(self.__scope) -> return Ok()
        if !browser_closed(self.__browser) -> browser_command(self.__browser, "browser.removeUserContext", obj([(key: "userContext", value: Dyn.Text(scope_id(self.__scope)))]))
        scope_close(self.__scope)
        Ok()
    }
}

BrowserPage: struct {
    __browser: Browser
    __context: Shared<__BrowserScope>
    __scope: Shared<__BrowserScope>

    goto: fn(self, url: String) BrowserError! -[Env, Net, Time]> {
        page_live(self)
        target: navigation_url(url)
        browser_command(self.__browser, "browsingContext.navigate", obj([
            (key: "context", value: Dyn.Text(scope_id(self.__scope))),
            (key: "url", value: Dyn.Text(target)),
            (key: "wait", value: Dyn.Text("complete"))
        ]))
        Ok()
    }

    close: fn(self) BrowserError! -[Net, Time]> {
        if scope_closed(self.__scope) -> return Ok()
        if !scope_closed(self.__context) && !browser_closed(self.__browser) -> browser_command(self.__browser, "browsingContext.close", obj([(key: "context", value: Dyn.Text(scope_id(self.__scope)))]))
        scope_close(self.__scope)
        Ok()
    }

    // A CDP handle for this page alone: its commands carry the page's CDP
    // session, and its events are this page's only. "bidi" is refused: BiDi
    // commands already name their page.
    protocol: fn(self, kind: String) -> BrowserProtocol BrowserError! {
        page_live(self)
        if browser_closed(self.__browser) -> return Err(BrowserError{kind: "closed"})
        if kind != "cdp" || !browser_cdp(self.__browser) -> return Err(BrowserError{kind: "unsupported protocol"})
        Ok(BrowserProtocol{__browser: self.__browser, __kind: "cdp", __context: self.__context, __page: self.__scope, __session: new_scope("")})
    }

    main_frame: fn(self) -> BrowserFrame BrowserError! {
        page_live(self)
        Ok(page_frame(self, scope_id(self.__scope)))
    }

    frames: fn(self) -[Net, Time]> [BrowserFrame] BrowserError! {
        page_live(self)
        result: browser_command(self.__browser, "browsingContext.getTree", obj([(key: "root", value: Dyn.Text(scope_id(self.__scope)))]))
        contexts: browser_get(result, "contexts") ?? return Err(BrowserError{kind: "protocol"})
        ids := [String]{}
        if contexts == .Array(nodes) {
            loop node in nodes -> collect_frame_ids(node, ids)
        } else {
            return Err(BrowserError{kind: "protocol"})
        }
        out := [BrowserFrame]{}
        loop id in ids -> out.push(page_frame(self, id))
        Ok(out)
    }

    // A viewport PNG, decoded from the protocol's base64; never traced.
    screenshot: fn(self) -[Net, Time]> [U8] BrowserError! {
        page_live(self)
        format: obj([(key: "type", value: Dyn.Text("image/png"))])
        result: browser_command(self.__browser, "browsingContext.captureScreenshot", obj([(key: "context", value: Dyn.Text(scope_id(self.__scope))), (key: "format", value: format)]))
        decode_data(result)
    }

    // A print-to-PDF document, decoded from the protocol's base64; never traced.
    pdf: fn(self) -[Net, Time]> [U8] BrowserError! {
        page_live(self)
        result: browser_command(self.__browser, "browsingContext.print", obj([(key: "context", value: Dyn.Text(scope_id(self.__scope)))]))
        decode_data(result)
    }

    set_cookie: fn(self, name: String, value: String, domain: String) BrowserError! -[Net, Time]> {
        page_live(self)
        if name.len() == 0 || domain.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        cookie: obj([(key: "name", value: Dyn.Text(name.copy())), (key: "value", value: string_value(value)), (key: "domain", value: Dyn.Text(domain.copy()))])
        browser_command(self.__browser, "storage.setCookie", obj([(key: "cookie", value: cookie), (key: "partition", value: page_partition(self))]))
        Ok()
    }

    cookie: fn(self, name: String) -[Net, Time]> String? BrowserError! {
        page_live(self)
        if name.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        filter: obj([(key: "name", value: Dyn.Text(name.copy()))])
        result: browser_command(self.__browser, "storage.getCookies", obj([(key: "filter", value: filter), (key: "partition", value: page_partition(self))]))
        cookies: browser_get(result, "cookies") ?? return Err(BrowserError{kind: "protocol"})
        if cookies == .Array(items) {
            if items.len() == 0 -> return Ok(None)
            found: cookie_string_value(items[0])
            return Ok(Val(found))
        }
        Err(BrowserError{kind: "protocol"})
    }

    clear_cookies: fn(self) BrowserError! -[Net, Time]> {
        page_live(self)
        browser_command(self.__browser, "storage.deleteCookies", obj([(key: "partition", value: page_partition(self))]))
        Ok()
    }

    storage_get: fn(self, kind: String, key: String) -[Net, Time]> String? BrowserError! {
        store: storage_name(kind) ?? return Err(BrowserError{kind: "protocol"})
        if key.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        result: page_storage_call(self, "function(key) {{ return {store}.getItem(key); }}", [Dyn]{string_value(key)})
        remote_string(result)
    }

    storage_set: fn(self, kind: String, key: String, value: String) BrowserError! -[Net, Time]> {
        store: storage_name(kind) ?? return Err(BrowserError{kind: "protocol"})
        if key.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        page_storage_call(self, "function(key, value) {{ {store}.setItem(key, value); }}", [Dyn]{string_value(key), string_value(value)})
        Ok()
    }

    storage_clear: fn(self, kind: String) BrowserError! -[Net, Time]> {
        store: storage_name(kind) ?? return Err(BrowserError{kind: "protocol"})
        page_storage_call(self, "function() {{ {store}.clear(); }}", [Dyn]{})
        Ok()
    }

    url: fn(self) -[Net, Time]> String BrowserError! { page_evaluate_text(self, "String(location.href)") }
    title: fn(self) -[Net, Time]> String BrowserError! { page_evaluate_text(self, "String(document.title || '')") }
    text: fn(self) -[Net, Time]> String BrowserError! { page_evaluate_text(self, "document.body ? String(document.body.innerText || '') : ''") }
    dom: fn(self) -[Net, Time]> String BrowserError! { page_evaluate_text(self, "document.documentElement ? document.documentElement.outerHTML : ''") }

    get_by_role: fn(self, role: String, name: String) -> BrowserLocator Never! { page_locator(self, "accessibility", role, name, "") }
    get_by_text: fn(self, value: String) -> BrowserLocator Never! { page_locator(self, "innerText", "", "", value) }
    get_by_label: fn(self, name: String) -> BrowserLocator Never! { page_locator(self, "accessibility", "", name, "") }
    get_by_placeholder: fn(self, value: String) -> BrowserLocator Never! { page_locator(self, "css", "", "", css_attr_equals("placeholder", value)) }
    get_by_test_id: fn(self, id: String) -> BrowserLocator Never! { page_locator(self, "css", "", "", css_attr_equals("data-testid", id)) }
    get_by_css: fn(self, selector: String) -> BrowserLocator Never! { page_locator(self, "css", "", "", selector) }
}

// A browsing-context frame (main or child). Listing frames never closes them.
BrowserFrame: struct {
    __browser: Browser
    __context: Shared<__BrowserScope>
    __page: Shared<__BrowserScope>
    __scope: Shared<__BrowserScope>

    close: fn(self) BrowserError! -[Net, Time]> {
        if scope_closed(self.__scope) -> return Ok()
        if scope_closed(self.__page) || scope_closed(self.__context) || browser_closed(self.__browser) {
            scope_close(self.__scope)
            return Ok()
        }
        id: scope_id(self.__scope)
        browser_command(self.__browser, "browsingContext.close", obj([(key: "context", value: Dyn.Text(id))]))
        scope_close(self.__scope)
        if id == scope_id(self.__page) -> scope_close(self.__page)
        Ok()
    }
}

// A semantic BiDi locator: `accessibility`, `css`, or `innerText`.
BrowserLocator: struct {
    __browser: Browser
    __context: Shared<__BrowserScope>
    __page: Shared<__BrowserScope>
    __kind: String
    __role: String
    __name: String
    __value: String

    wait: fn(self, timeout: BrowserTimeout) BrowserError! -[Net, Time, Time.Wait]> {
        started: time.instant()
        loop {
            remaining: remaining_ms(started, timeout.milliseconds)
            if locator_query(self, remaining) != None -> return Ok()
            time.sleep(10ms)
        }
    }

    wait_gone: fn(self, timeout: BrowserTimeout) BrowserError! -[Net, Time, Time.Wait]> {
        started: time.instant()
        loop {
            remaining: remaining_ms(started, timeout.milliseconds)
            if locator_query(self, remaining) == None -> return Ok()
            time.sleep(10ms)
        }
    }

    // The resolved element's shared id.
    resolve: fn(self) -[Net, Time]> String BrowserError! {
        found: locator_query(self, browser_timeout_ms(self.__browser)) ?? return Err(BrowserError{kind: "timeout"})
        Ok(found)
    }

    click: fn(self) BrowserError! -[Net, Time]> {
        shared_id: self.resolve()
        locator_pointer(self, shared_id, true)
    }

    hover: fn(self) BrowserError! -[Net, Time]> {
        shared_id: self.resolve()
        locator_pointer(self, shared_id, false)
    }

    // Clear, then assign through the DOM value path; no page data enters the trace.
    fill: fn(self, value: String) BrowserError! -[Net, Time]> {
        shared_id: self.resolve()
        target: obj([(key: "context", value: Dyn.Text(scope_id(self.__page)))])
        node: obj([(key: "type", value: Dyn.Text("node")), (key: "sharedId", value: Dyn.Text(shared_id))])
        browser_command(self.__browser, "script.callFunction", obj([
            (key: "functionDeclaration", value: Dyn.Text(C_FILL_FUNCTION)),
            (key: "awaitPromise", value: Dyn.Bool(false)),
            (key: "target", value: target),
            (key: "arguments", value: Dyn.Array([Dyn]{node.move(), string_value(value)}))
        ]))
        Ok()
    }

    press: fn(self, key: String) BrowserError! -[Net, Time]> {
        shared_id: self.resolve()
        locator_pointer(self, shared_id, true)
        down: obj([(key: "type", value: Dyn.Text("keyDown")), (key: "value", value: Dyn.Text(key.copy()))])
        up: obj([(key: "type", value: Dyn.Text("keyUp")), (key: "value", value: Dyn.Text(key.copy()))])
        source: obj([(key: "type", value: Dyn.Text("key")), (key: "id", value: Dyn.Text("keyboard")), (key: "actions", value: Dyn.Array([Dyn]{down.move(), up.move()}))])
        browser_command(self.__browser, "input.performActions", obj([(key: "context", value: Dyn.Text(scope_id(self.__page))), (key: "actions", value: Dyn.Array([Dyn]{source.move()}))]))
        Ok()
    }

    set_files: fn(self, path: String) BrowserError! -[Net, Time]> {
        if path.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        shared_id: self.resolve()
        element: obj([(key: "sharedId", value: Dyn.Text(shared_id))])
        browser_command(self.__browser, "input.setFiles", obj([
            (key: "context", value: Dyn.Text(scope_id(self.__page))),
            (key: "element", value: element),
            (key: "files", value: Dyn.Array([Dyn]{Dyn.Text(path.copy())}))
        ]))
        Ok()
    }
}

BrowserIntercept: struct {
    __browser: Browser
    __scope: Shared<__BrowserScope>

    remove: fn(self) BrowserError! -[Net, Time]> {
        if scope_closed(self.__scope) -> return Ok()
        browser_command(self.__browser, "network.removeIntercept", obj([(key: "intercept", value: Dyn.Text(scope_id(self.__scope)))]))
        scope_close(self.__scope)
        Ok()
    }
}

// The checked expert path: raw BiDi or capability-gated CDP. BiDi cannot
// smuggle `goog:cdp.*`, and CDP methods and events must have the
// `Domain.name` shape. CDP events join the session's one event queue, with
// the same slots and redaction as BiDi events, as their `Domain.event` kinds.
// A page's CDP handle (`page.protocol("cdp")`) sends through that page's CDP
// session and takes only that session's events; a browser's handle has empty
// page and session ids.
BrowserProtocol: struct {
    __browser: Browser
    __kind: String
    __context: Shared<__BrowserScope>
    __page: Shared<__BrowserScope>
    // The page's CDP session, asked of the driver on first use.
    __session: Shared<__BrowserScope>

    send: fn(self, method: String, params_json: String) -[Net, Time]> String BrowserError! {
        params: json.parse(params_json) ?? return Err(BrowserError{kind: "protocol"})
        if !(params == .Object(_)) -> return Err(BrowserError{kind: "protocol"})
        if self.__kind == "bidi" {
            if method.starts_with("goog:cdp.") -> return Err(BrowserError{kind: "unsupported protocol"})
            result: browser_command(self.__browser, method, params)
            return Ok(json.dumps(result) ?? return Err(BrowserError{kind: "protocol"}))
        }
        if self.__kind != "cdp" || !browser_cdp(self.__browser) -> return Err(BrowserError{kind: "unsupported protocol"})
        if !cdp_method_ok(method) -> return Err(BrowserError{kind: "protocol"})
        page_session: protocol_session(self)
        request := [(key: String, value: Dyn)]{(key: "method", value: Dyn.Text(method.copy())), (key: "params", value: params)}
        if page_session == .Val(session) -> request.push((key: "session", value: Dyn.Text(session)))
        result: browser_command(self.__browser, "goog:cdp.sendCommand", obj(request))
        Ok(json.dumps(result) ?? return Err(BrowserError{kind: "protocol"}))
    }

    subscribe: fn(self, event: String) BrowserError! -[Net, Time]> {
        if self.__kind == "bidi" {
            self.__browser.subscribe(event)
            return Ok()
        }
        if self.__kind != "cdp" || !browser_cdp(self.__browser) -> return Err(BrowserError{kind: "unsupported protocol"})
        if !cdp_method_ok(event) -> return Err(BrowserError{kind: "protocol"})
        request := [(key: String, value: Dyn)]{(key: "events", value: Dyn.Array([Dyn]{Dyn.Text("goog:cdp.{event}")}))}
        if protocol_session(self) != None -> request.push((key: "contexts", value: Dyn.Array([Dyn]{Dyn.Text(scope_id(self.__page))})))
        browser_command(self.__browser, "session.subscribe", obj(request))
        Ok()
    }

    // A page's handle waits for the next event of its own CDP session and
    // leaves every other event queued.
    next_event: fn(self, timeout: BrowserTimeout) -[Net, Time]> BrowserEvent BrowserError! {
        page_session: protocol_session(self)
        session: page_session ?? return self.__browser.next_event(timeout)
        if browser_closed(self.__browser) -> return Err(BrowserError{kind: "closed"})
        if browser_pop_session_event(self.__browser, session) == .Val(queued) -> return Ok(queued)
        started: time.instant()
        loop {
            value: browser_recv_json(self.__browser, started, timeout.milliseconds)
            if !browser_capture_event(self.__browser, value) -> return Err(BrowserError{kind: "protocol"})
            if browser_pop_session_event(self.__browser, session) == .Val(event) -> return Ok(event)
        }
    }
}

// The CDP session of a page's handle, asked of the driver once with
// `goog:cdp.getSession` and kept in the handle; None for a browser's handle.
// It never leaves Core.
protocol_session: fn(protocol: BrowserProtocol) -[Net, Time]> String? BrowserError! {
    page: scope_id(protocol.__page)
    if page == "" -> return Ok(None)
    if scope_closed(protocol.__page) || scope_closed(protocol.__context) -> return Err(BrowserError{kind: "closed"})
    known: scope_id(protocol.__session)
    if known != "" -> return Ok(Val(known))
    result: browser_command(protocol.__browser, "goog:cdp.getSession", obj([(key: "context", value: Dyn.Text(page))]))
    session: browser_string(result, "session")
    if session == "" -> return Err(BrowserError{kind: "protocol"})
    scope_set_id(protocol.__session, session)
    Ok(Val(session))
}

BrowserLocked: struct {
    engine: String
    version: String
    binary: String
    protocol: String
    size: Int
    output_hash: String
    // The WebDriver driver a launch goes through ("" when the engine serves
    // BiDi itself) and its locked size.
    driver: String
    driver_size: Int

    engine: fn(self) -> String Never! { self.engine }
    version: fn(self) -> String Never! { self.version }
    binary: fn(self) -> String Never! { self.binary }
    protocol: fn(self) -> String Never! { self.protocol }
    verify: fn(self) BrowserError! -[FS]> {
        if !files.is_file(self.binary) -> return Err(BrowserError{kind: "missing binary"})
        size: files.getsize(self.binary) ?? return Err(BrowserError{kind: "missing binary"})
        if size != self.size -> return Err(BrowserError{kind: "size mismatch"})
        __verify_driver(self)
    }
}

BrowserTestConfig: struct {
    engines: [String]
    retries: Int
    timeout: BrowserTimeout
    filter: String
    reporter: String
    ui: Bool
    visual: Bool
    watch: Bool
    trace_on_retry: Bool
    trace_all: Bool
    server_url: String
    server_command: [String]
    server_reuse: Bool
    server_cwd: String
    artifact_dir: String
    report_path: String
    source_root: String

    engines: fn(self) -> [String] Never! { self.engines }
    retries: fn(self) -> Int Never! { self.retries }
    filter: fn(self) -> String Never! { self.filter }
    reporter: fn(self) -> String Never! { self.reporter }
    ui: fn(self) -> Bool Never! { self.ui }
    visual: fn(self) -> Bool Never! { self.visual }
    watch: fn(self) -> Bool Never! { self.watch }
    server_url: fn(self) -> String Never! { self.server_url }
    artifact_dir: fn(self) -> String Never! { self.artifact_dir }
    report_path: fn(self) -> String Never! { self.report_path }
}

// The report data model a browser run records. Lines, columns, sequences and
// byte counts are the Rust u32/usize facts.
BrowserTestSource: struct {
    path: String
    line: Int
    column: Int
}

BrowserTestAction: struct {
    sequence: Int
    kind: String
    fact: String
}

BrowserTestSnapshot: struct {
    kind: String
    hash: String
    bytes: Int
    path: String
    source: BrowserTestSource
}

BrowserTestEventFact: struct {
    kind: String
    request_id_hash: String
    request_method: String
    url_hash: String
    status_code: Int
    is_blocked: Bool
}

BrowserTestArtifact: struct {
    name: String
    path: String
    mime: String
    bytes: Int
    hash: String
    source: BrowserTestSource
}

BrowserTestAttempt: struct {
    test: String
    engine: String
    attempt: Int
    passed: Bool
    expected_failure: Bool
    duration_ms: Int
    source: BrowserTestSource
    actions: [BrowserTestAction]
    snapshots: [BrowserTestSnapshot]
    events: [BrowserTestEventFact]
    artifacts: [BrowserTestArtifact]
    trace: [String]
    error: String
}

BrowserTestCase: struct {
    name: String
    selected: Bool
    attempts: [BrowserTestAttempt]
}

BrowserTestReport: struct {
    source_root: String
    reporter: String
    ui: Bool
    watch: Bool
    cases: [BrowserTestCase]

    json: fn(self) -> String Never! { report_json(self) }
    text: fn(self) -> String Never! { report_text(self) }
    html: fn(self) -> String Never! { report_html(self) }
    exit_code: fn(self) -> Int Never! { report_exit_code(self) }
}

// One named test attempt's live session: its browser, isolated context, and
// first page, subscribed to the console and network events a report records.
BrowserTestFixture: struct {
    __browser: Browser
    __context: BrowserContext
    __page: BrowserPage
}

__BrowserServerState: struct {
    child: ProcessChild?
    logs: String
}

// The test web server: a spawned command, or a reused server already
// listening at the configured URL.
BrowserTestServer: struct {
    __url: String
    __state: Shared<__BrowserServerState>

    url: fn(self) -> String Never! { self.__url }

    // Captured stdout then stderr, bounded to 64 KiB, once the server stopped.
    logs: fn(self) -> String Never! {
        guard: self.__state.guard_read()
        guard.value.logs
    }

    stop: fn(self) Never! -[Exec, Time.Wait]> {
        guard := self.__state.guard_edit()
        if guard.value.child == .Val(child) {
            // A child that already exited cannot be signalled; wait still reaps it.
            child.kill() ?? ()
            if child.wait() == .Ok(receipt) -> guard.value.logs = bounded_text("{receipt.output}{receipt.errors}", C_MAX_SERVER_LOG_BYTES)
        }
        guard.value.child = None
    }
}

config: fn() -> BrowserTestConfig BrowserError! { config_from_env() }

config_from_env: fn() -[Env, FS]> BrowserTestConfig BrowserError! {
    env: core.sys.__startup_env()
    root: env_value(env, "JET_PROJECT_ROOT") ?? "."
    config_from_snapshot(root, env)
}


make_profile: fn(name: String) -> BrowserProfile BrowserError! { profile(name) }

// No trimming, case folding, timeout clamping, or fallback. Profile refusal uses
// the BrowserError kind carrier, not protocol enum variants.
profile: fn(name: String) -> BrowserProfile BrowserError! {
    version: if name == {
        "bidi-2025.5" -> "2025.5"
        "bidi-2024.11" -> "2024.11"
        else -> { return Err(BrowserError{kind: "invalid profile"}) }
    }
    Ok(BrowserProfile{name: name, version: version})
}

timeout: fn(ms: Int) -> BrowserTimeout BrowserError! {
    if ms < 1 || ms > 600000 -> return Err(BrowserError{kind: "invalid timeout"})
    Ok(BrowserTimeout{milliseconds: ms})
}

// The project's pin, read through FS alone (architecture.md:1287-1288): the
// `.jet/lock` of the working directory, the project root a program runs from.
locked: fn(engine: String) -[FS, IO]> BrowserLocked BrowserError! {
    if engine != "chromium" && engine != "firefox" && engine != "webkit" -> return Err(BrowserError{kind: "unknown engine"})
    raw: files.read(".jet/lock") ?? return Err(BrowserError{kind: "missing lock"})
    entry: parse_locked(raw, engine)
    if !files.is_file(entry.binary) -> return Err(BrowserError{kind: "missing binary"})
    size: files.getsize(entry.binary) ?? return Err(BrowserError{kind: "missing binary"})
    if size != entry.size -> return Err(BrowserError{kind: "size mismatch"})
    __verify_driver(entry)
    Ok(entry)
}

// A pinned driver must still be the locked file; no driver pins nothing.
__verify_driver: fn(entry: BrowserLocked) BrowserError! -[FS]> {
    if entry.driver == "" -> return Ok()
    if !files.is_file(entry.driver) -> return Err(BrowserError{kind: "missing driver"})
    size: files.getsize(entry.driver) ?? return Err(BrowserError{kind: "missing driver"})
    if size != entry.driver_size -> return Err(BrowserError{kind: "size mismatch"})
    Ok()
}

// Start the engine pinned by `locked(engine)` headless on a throwaway profile
// and connect over WebDriver BiDi. Firefox serves BiDi itself; Chromium goes
// through the chromedriver the lock pins beside it and refuses with
// "missing driver" when none is pinned. The session's last owner, or close,
// stops the engine and removes the profile.
launch: fn(engine: String) -[Exec, FS, IO, Net, Time, Time.Wait]> Browser BrowserError! {
    pin: locked(engine)
    p: profile(pin.protocol)
    if pin.engine == "chromium" -> return __launch_chromium(pin, p)
    if pin.engine != "firefox" -> return Err(BrowserError{kind: "missing driver"})
    dir: files.temp_dir("jet-browser-") ?? return Err(BrowserError{kind: "transport"})
    // Port 0 picks a free port, which Firefox records in the profile. The
    // session bus stays off: a desktop D-Bus can stall Firefox's startup
    // after its BiDi server listens and before it answers.
    spec: process.cmd([String]{pin.binary, "--headless", "--no-remote", "--profile", dir.path, "--remote-debugging-port=0", "about:blank"})
        .env("DBUS_SESSION_BUS_ADDRESS", "disabled:").stdout(.Capture).stderr(.Capture)
    child: spec.spawn() ?? {
        files.remove_all(dir.path).drop("a failed launch leaves no profile")
        return Err(BrowserError{kind: "transport"})
    }
    held := __BrowserEngine{child: child, profile: dir.path.copy(), session_url: ""}
    port: __launched_bidi_port(held, "{dir.path}/WebDriverBiDiServer.json", 60000)
    browser: connect_profile("ws://127.0.0.1:{port}/session", p, BrowserTimeout{milliseconds: 30000})
    __browser_own_engine(browser, held)
    Ok(browser)
}

// Chromium serves BiDi through chromedriver. The driver picks a free port
// (`--port=0`) and prints it; a WebDriver classic new session with
// `webSocketUrl` starts Chromium on a throwaway profile, and that session's
// BiDi socket is the connection. The session already exists, so the
// connection skips `session.new`. chromedriver's BiDi mapper serves
// `goog:cdp.*`, so `protocol("cdp")` is available.
__launch_chromium: fn(pin: BrowserLocked, p: BrowserProfile) -[Exec, FS, Net, Time, Time.Wait]> Browser BrowserError! {
    if pin.driver == "" -> return Err(BrowserError{kind: "missing driver"})
    dir: files.temp_dir("jet-browser-") ?? return Err(BrowserError{kind: "transport"})
    child: process.cmd([String]{pin.driver, "--port=0"}).stdout(.Capture).stderr(.Capture).spawn() ?? {
        files.remove_all(dir.path).drop("a failed launch leaves no profile")
        return Err(BrowserError{kind: "transport"})
    }
    held := __BrowserEngine{child: child, profile: dir.path.copy(), session_url: ""}
    port := 0
    loop line in held.child.stdout.lines() {
        pair: parse.split_once(line, "started successfully on port ")
        if pair.found {
            port = parse_i64(text.trim(pair.tail).replace(".", "")) ?? 0
            break
        }
    }
    if port <= 0 || port > 65535 -> return Err(BrowserError{kind: "transport"})
    driver_url: "http://127.0.0.1:{port}"
    args: Dyn.Array([Dyn]{Dyn.Text("--headless=new"), Dyn.Text("--no-first-run"), Dyn.Text("--user-data-dir={dir.path}")})
    options: obj([(key: "binary", value: Dyn.Text(pin.binary.copy())), (key: "args", value: args)])
    always: obj([(key: "browserName", value: Dyn.Text("chrome")), (key: "webSocketUrl", value: Dyn.Bool(true)), (key: "goog:chromeOptions", value: options)])
    request: json.dumps(obj([(key: "capabilities", value: obj([(key: "alwaysMatch", value: always)]))])) ?? return Err(BrowserError{kind: "protocol"})
    response: http.post("{driver_url}/session", request) ?? return Err(BrowserError{kind: "transport"})
    body: response.body.text(C_MAX_SOURCE_BYTES) ?? return Err(BrowserError{kind: "transport"})
    reply: json.parse(body) ?? return Err(BrowserError{kind: "protocol"})
    value: browser_get(reply, "value") ?? return Err(BrowserError{kind: "protocol"})
    session_id: browser_text(value, "sessionId") ?? return Err(BrowserError{kind: "protocol"})
    held.session_url = "{driver_url}/session/{session_id}"
    capabilities: browser_get(value, "capabilities") ?? return Err(BrowserError{kind: "protocol"})
    socket: browser_text(capabilities, "webSocketUrl") ?? return Err(BrowserError{kind: "protocol"})
    if !socket.starts_with("ws://127.0.0.1:") -> return Err(BrowserError{kind: "protocol"})
    browser: __connect_session(socket, p, BrowserTimeout{milliseconds: 30000})
    __browser_own_engine(browser, held)
    Ok(browser)
}

// The BiDi socket of a session a driver already created: no `session.status`
// or `session.new`, and close ends it through the engine's driver session.
__connect_session: fn(endpoint: String, p: BrowserProfile, t: BrowserTimeout) -[Net, Time]> Browser BrowserError! {
    conn: if core.net.ws.__connect(endpoint) == {
        .Ok(value) -> value
        .Err(error) -> return Err(browser_ws_error(error))
    }
    Ok(Browser{__state: Shared{__BrowserState{
        conn: conn.move(), next_id: 1, closed: false, session_started: false, timeout_ms: t.milliseconds,
        profile: p.name, cdp: true, trace: [String]{"connect"}, trace_bytes: 7, events: [BrowserEvent]{}, engine: None
    }}})
}

// The BiDi port the engine records in its profile. A read can race the
// engine's write, so an incomplete file retries; an engine that exits first
// fails the launch.
__launched_bidi_port: fn(engine: __BrowserEngine, path: String, timeout_ms: Int) -[Exec, FS, Time, Time.Wait]> Int BrowserError! {
    started: time.instant()
    loop {
        if files.read(path) == .Ok(raw) {
            if json.parse(raw) == .Ok(value) {
                if browser_get(value, "ws_port") == .Val(field) {
                    port: dyn_int(field) ?? 0
                    if port > 0 && port < 65536 -> return Ok(port)
                }
            }
        }
        if engine.child.exited() ?? false -> return Err(BrowserError{kind: "transport"})
        if started.elapsed_millis() >= timeout_ms -> return Err(BrowserError{kind: "timeout"})
        time.sleep(20ms)
    }
}

connect: fn(endpoint: String) -[Net, Time]> Browser BrowserError! {
    connect_profile(endpoint, profile("bidi-2025.5"), BrowserTimeout{milliseconds: 30000})
}

connect_profile: fn(endpoint: String, p: BrowserProfile, t: BrowserTimeout) -[Net, Time]> Browser BrowserError! {
    conn: if core.net.ws.__connect(endpoint) == {
        .Ok(value) -> value
        .Err(error) -> return Err(browser_ws_error(error))
    }
    browser: Browser{__state: Shared{__BrowserState{
        conn: conn.move(), next_id: 1, closed: false, session_started: false, timeout_ms: t.milliseconds,
        profile: p.name, cdp: false, trace: [String]{"connect"}, trace_bytes: 7, events: [BrowserEvent]{}, engine: None
    }}}
    status: browser_command(browser, "session.status", empty_object())
    if !browser_true_field(status, "ready") || !browser_text_field(status, "message") ->
        return Err(BrowserError{kind: "protocol"})
    always: obj([(key: "alwaysMatch", value: empty_object())])
    session: browser_command(browser, "session.new", obj([(key: "capabilities", value: always)]))
    // The session counts as started before reply validation, so a failed
    // sessionId/capability check still ends the started session on close.
    browser_mark_started(browser)
    cdp: browser_session_cdp(session)
    browser_set_cdp(browser, cdp)
    Ok(browser)
}

browser_ws_error: fn(error: WsError) -> BrowserError Never! {
    if error == {
        .Timeout -> BrowserError{kind: "timeout"}
        .Closed -> BrowserError{kind: "closed"}
        .InvalidURL | .InvalidHandshake | .Protocol | .Cancelled | .UnsupportedTarget | .MessageTooLarge(_) | .IO(_) -> BrowserError{kind: "transport"}
    }
}

browser_true_field: fn(value: Dyn, key: String) -> Bool Never! {
    if !(value == .Object(_)) -> return false
    loop entry in tree.object_entries(value) {
        if entry.key == key {
            if entry.value == .Bool(flag) -> return flag
            return false
        }
    }
    false
}

browser_text_field: fn(value: Dyn, key: String) -> Bool Never! {
    if !(value == .Object(_)) -> return false
    loop entry in tree.object_entries(value) {
        if entry.key == key -> return entry.value == .Text(_)
    }
    false
}

browser_session_cdp: fn(session: Dyn) -> Bool BrowserError! {
    if !browser_text_field(session, "sessionId") -> return Err(BrowserError{kind: "protocol"})
    loop entry in tree.object_entries(session) {
        if entry.key == "capabilities" {
            if !(entry.value == .Object(_)) -> return Err(BrowserError{kind: "protocol"})
            return Ok(browser_true_field(entry.value, "goog:cdp"))
        }
    }
    Err(BrowserError{kind: "protocol"})
}

connect_browser_profile: fn(p: BrowserProfile, t: BrowserTimeout) -[Net, Time]> Browser BrowserError! {
    connect_profile(p.name, p, t)
}

// ---- Session state ----------------------------------------------------------

browser_closed: fn(browser: Browser) -> Bool Never! {
    guard: browser.__state.guard_read()
    guard.value.closed
}

browser_session_started: fn(browser: Browser) -> Bool Never! {
    guard: browser.__state.guard_read()
    guard.value.session_started
}

browser_cdp: fn(browser: Browser) -> Bool Never! {
    guard: browser.__state.guard_read()
    guard.value.cdp
}

browser_timeout_ms: fn(browser: Browser) -> Int Never! {
    guard: browser.__state.guard_read()
    guard.value.timeout_ms
}

browser_mark_started: fn(browser: Browser) Never! {
    guard := browser.__state.guard_edit()
    guard.value.session_started = true
}

// Closing ends the session; a launched engine stops with it.
browser_mark_closed: fn(browser: Browser) Never! {
    guard := browser.__state.guard_edit()
    guard.value.closed = true
    guard.value.engine = None
}

__browser_own_engine: fn(browser: Browser, engine: &&__BrowserEngine) Never! {
    guard := browser.__state.guard_edit()
    guard.value.engine = Val(engine)
}

browser_set_cdp: fn(browser: Browser, cdp: Bool) Never! {
    guard := browser.__state.guard_edit()
    guard.value.cdp = cdp
}

// The trace keeps at most 8 KiB, dropping the oldest entries first.
browser_trace_push: fn(browser: Browser, entry: String) Never! {
    size: entry.len()
    if size > C_TRACE_LIMIT_BYTES -> return
    guard := browser.__state.guard_edit()
    drop := 0
    total := guard.value.trace_bytes
    loop drop < guard.value.trace.len() && total + size > C_TRACE_LIMIT_BYTES {
        total -= guard.value.trace[drop].len()
        drop += 1
    }
    if drop > 0 {
        kept := [String]{}
        loop index in drop..<guard.value.trace.len() -> kept.push(guard.value.trace[index])
        guard.value.trace = kept
    }
    guard.value.trace.push(entry.copy())
    guard.value.trace_bytes = total + size
}

browser_pop_event: fn(browser: Browser) -> BrowserEvent? Never! {
    guard := browser.__state.guard_edit()
    if guard.value.events.len() == 0 -> return None
    first: guard.value.events[0]
    rest := [BrowserEvent]{}
    loop index in 1..<guard.value.events.len() -> rest.push(guard.value.events[index])
    guard.value.events = rest
    Val(first)
}

browser_queue_event: fn(browser: Browser, event: BrowserEvent) Never! {
    guard := browser.__state.guard_edit()
    if guard.value.events.len() == C_EVENT_LIMIT {
        rest := [BrowserEvent]{}
        loop index in 1..<guard.value.events.len() -> rest.push(guard.value.events[index])
        guard.value.events = rest
    }
    guard.value.events.push(event.copy())
}

// The first queued event of CDP session `session`; every other event stays
// queued in order.
browser_pop_session_event: fn(browser: Browser, session: String) -> BrowserEvent? Never! {
    guard := browser.__state.guard_edit()
    found := -1
    loop index in 0..<guard.value.events.len() {
        if found < 0 && guard.value.events[index].__session == session -> found = index
    }
    if found < 0 -> return None
    taken: guard.value.events[found]
    rest := [BrowserEvent]{}
    loop index in 0..<guard.value.events.len() {
        if index != found -> rest.push(guard.value.events[index])
    }
    guard.value.events = rest
    Val(taken)
}

browser_check_command: fn(browser: Browser, method: String) BrowserError! {
    guard: browser.__state.guard_read()
    if guard.value.closed -> return Err(BrowserError{kind: "closed"})
    if !profile_allows(guard.value.profile, method) -> return Err(BrowserError{kind: "unsupported protocol"})
    if (method == "goog:cdp.sendCommand" || method == "goog:cdp.getSession") && !guard.value.cdp -> return Err(BrowserError{kind: "unsupported protocol"})
    Ok()
}

browser_next_id: fn(browser: Browser) -> Int Never! {
    guard := browser.__state.guard_edit()
    id: guard.value.next_id
    guard.value.next_id = id + 1
    id
}

// ---- Command transport ------------------------------------------------------

browser_command: fn(browser: Browser, method: String, params: &&Dyn) -[Net, Time]> Dyn BrowserError! {
    browser_command_with_timeout(browser, method, params, browser_timeout_ms(browser))
}

// One command: send `{id, method, params}`, queue interleaved events, and
// accept only the matching success reply before the deadline.
browser_command_with_timeout: fn(browser: Browser, method: String, params: &&Dyn, timeout_ms: Int) -[Net, Time]> Dyn BrowserError! {
    browser_check_command(browser, method)
    started: time.instant()
    browser_ws_timeout(browser, remaining_ms(started, timeout_ms))
    id: browser_next_id(browser)
    request: obj([(key: "id", value: Dyn.Int(id)), (key: "method", value: Dyn.Text(method.copy())), (key: "params", value: params)])
    wire: json.dumps(request) ?? return Err(BrowserError{kind: "protocol"})
    method_hash: fact_hash(method)
    browser_trace_push(browser, "send:{id}:{method_hash}")
    browser_ws_send(browser, wire)
    loop {
        response: browser_recv_json(browser, started, timeout_ms)
        if browser_capture_event(browser, response) -> next
        if browser_id(response) != Val(id) -> return Err(BrowserError{kind: "protocol"})
        response_type: browser_string(response, "type")
        if response_type == "error" || browser_get(response, "error") != None {
            browser_trace_push(browser, "error:{id}:{method_hash}")
            return Err(BrowserError{kind: "protocol"})
        }
        if response_type != "success" -> return Err(BrowserError{kind: "protocol"})
        result: browser_get(response, "result") ?? return Err(BrowserError{kind: "protocol"})
        browser_trace_push(browser, "recv:{id}:{method_hash}")
        return Ok(result)
    }
}

remaining_ms: fn(started: Instant, timeout_ms: Int) -[Time]> Int BrowserError! {
    remaining: timeout_ms - started.elapsed_millis()
    if remaining <= 0 -> return Err(BrowserError{kind: "timeout"})
    Ok(remaining)
}

browser_ws_timeout: fn(browser: Browser, timeout_ms: Int) BrowserError! -[Net]> {
    state: browser.__state.guard_read()
    core.browser.__ws_set_timeout(state.value.conn, timeout_ms) ?? return Err(browser_ws_error(err))
    Ok()
}

browser_ws_send: fn(browser: Browser, text: String) BrowserError! -[Net]> {
    state: browser.__state.guard_read()
    state.value.conn.send_text(text) ?? return Err(browser_ws_error(err))
    Ok()
}

browser_recv_json: fn(browser: Browser, started: Instant, timeout_ms: Int) -[Net, Time]> Dyn BrowserError! {
    browser_ws_timeout(browser, remaining_ms(started, timeout_ms))
    state: browser.__state.guard_read()
    message: state.value.conn.recv() ?? return Err(browser_ws_error(err))
    body: message.text() ?? return Err(browser_ws_error(err))
    value: json.parse(body) ?? return Err(BrowserError{kind: "protocol"})
    if !(value == .Object(_)) -> return Err(BrowserError{kind: "protocol"})
    Ok(value)
}

// An `event` message joins the bounded queue and the trace as a method hash.
browser_capture_event: fn(browser: Browser, value: Dyn) -> Bool BrowserError! {
    kind: browser_text(value, "type") ?? return Err(BrowserError{kind: "protocol"})
    if kind != "event" -> return Ok(false)
    method: browser_string(value, "method")
    event: if method.starts_with("goog:cdp.") -> __cdp_event_facts(value, method) else -> event_facts(value, method)
    browser_trace_push(browser, "event:{fact_hash(method)}")
    browser_queue_event(browser, event)
    Ok(true)
}

event_facts: fn(value: Dyn, method: String) -> BrowserEvent Never! {
    out := BrowserEvent{method: method, request_id: "", request_method: "", url_hash: "", is_blocked: false, status_code: 0, download_id: "", suggested_filename_hash: "", frame_line: -1, frame_column: -1, frame_function_hash: "", source_map_url_hash: "", __session: ""}
    params: browser_get(value, "params") ?? return out
    out.is_blocked = browser_true_field(params, "isBlocked")
    url := String?{None}
    if browser_get(params, "request") == .Val(request) {
        out.request_id = browser_text(request, "request") ?? ""
        out.request_method = browser_text(request, "method") ?? ""
        url = browser_text(request, "url")
    }
    if url == None -> url = browser_text(params, "url")
    if url == .Val(found) -> out.url_hash = fact_hash(found)
    out.status_code = __response_status(params)
    out.download_id = browser_text(params, "download") ?? ""
    if browser_text(params, "suggestedFilename") == .Val(name) -> out.suggested_filename_hash = fact_hash(name)
    out
}

// chromedriver's BiDi mapper sends a CDP event as `goog:cdp.<Domain.event>`
// with the CDP payload under `params.params` and the CDP session under
// `params.session`. It is queued as its `Domain.event` kind with the same
// redacted network facts, plus the named debugger facts: the top frame of a
// `Debugger.paused`, and the URL and source-map URL of a
// `Debugger.scriptParsed`. Nothing else of the payload is kept.
__cdp_event_facts: fn(value: Dyn, method: String) -> BrowserEvent Never! {
    out := BrowserEvent{method: method.remove_prefix("goog:cdp."), request_id: "", request_method: "", url_hash: "", is_blocked: false, status_code: 0, download_id: "", suggested_filename_hash: "", frame_line: -1, frame_column: -1, frame_function_hash: "", source_map_url_hash: "", __session: ""}
    outer: browser_get(value, "params") ?? return out
    out.__session = browser_text(outer, "session") ?? ""
    params: browser_get(outer, "params") ?? return out
    out.request_id = browser_text(params, "requestId") ?? ""
    if browser_get(params, "request") == .Val(request) {
        out.request_method = browser_text(request, "method") ?? ""
        if browser_text(request, "url") == .Val(url) -> out.url_hash = fact_hash(url)
    }
    out.status_code = __response_status(params)
    if out.method == "Debugger.scriptParsed" {
        if browser_text(params, "url") == .Val(url) -> out.url_hash = fact_hash(url)
        if browser_text(params, "sourceMapURL") == .Val(map) && map != "" -> out.source_map_url_hash = fact_hash(map)
    }
    if out.method == "Debugger.paused" {
        frames: browser_get(params, "callFrames") ?? return out
        if frames == .Array(items) {
            if items.len() == 0 -> return out
            top: items[0]
            out.frame_function_hash = fact_hash(browser_text(top, "functionName") ?? "")
            location: browser_get(top, "location") ?? return out
            if browser_get(location, "lineNumber") == .Val(line) -> out.frame_line = dyn_int(line) ?? -1
            if browser_get(location, "columnNumber") == .Val(column) -> out.frame_column = dyn_int(column) ?? -1
        }
    }
    out
}

// The HTTP status of an event's `response`, or 0 when it has none in range.
__response_status: fn(params: Dyn) -> Int Never! {
    response: browser_get(params, "response") ?? return 0
    status: browser_get(response, "status") ?? return 0
    code: dyn_int(status) ?? -1
    if code >= 0 && code <= 599 -> return code
    0
}

C_BIDI_2024_11: [String]{
    "session.status", "session.new", "session.end", "session.subscribe",
    "browser.createUserContext", "browser.removeUserContext", "browser.setDownloadBehavior",
    "browsingContext.create", "browsingContext.close", "browsingContext.getTree", "browsingContext.navigate",
    "browsingContext.reload", "browsingContext.locateNodes", "browsingContext.captureScreenshot", "browsingContext.print",
    "input.performActions", "input.releaseActions", "input.setFiles",
    "network.addIntercept", "network.continueRequest", "network.failRequest", "network.provideResponse", "network.removeIntercept",
    "storage.getCookies", "storage.setCookie", "storage.deleteCookies",
    "script.addPreloadScript", "script.callFunction", "script.disown", "script.evaluate", "script.getRealms", "script.removePreloadScript",
    "goog:cdp.sendCommand", "goog:cdp.getSession"
}

profile_allows: fn(name: String, method: String) -> Bool Never! {
    if name != "bidi-2024.11" && name != "bidi-2025.5" -> return false
    loop allowed in C_BIDI_2024_11 {
        if allowed == method -> return true
    }
    name == "bidi-2025.5" && (method == "permissions.setPermission" || method == "webExtension.install" || method == "webExtension.uninstall" || method == "emulation.setNetworkConditions")
}

phase_ok: fn(phase: String) -> Bool Never! {
    phase == "beforeRequestSent" || phase == "responseStarted" || phase == "authRequired"
}

// ---- Dyn helpers ------------------------------------------------------------

obj: fn(entries: &&[(key: String, value: Dyn)]) -> Dyn Never! { tree.object_from_entries(entries) }

empty_object: fn() -> Dyn Never! { tree.object_from_entries([(key: String, value: Dyn)]{}) }

string_value: fn(value: String) -> Dyn Never! {
    obj([(key: "type", value: Dyn.Text("string")), (key: "value", value: Dyn.Text(value.copy()))])
}

// The first field named `key` of an object; any other value has no fields.
browser_get: fn(value: Dyn, key: String) -> Dyn? Never! {
    if value == .Object(_) {
        loop entry in tree.object_entries(value) {
            if entry.key == key -> return Val(entry.value.copy())
        }
    }
    None
}

browser_text: fn(value: Dyn, key: String) -> String? Never! {
    field: browser_get(value, key) ?? return None
    if field == .Text(found) -> return Val(found.copy())
    None
}

browser_string: fn(value: Dyn, key: String) -> String BrowserError! {
    found: browser_text(value, key) ?? return Err(BrowserError{kind: "protocol"})
    Ok(found)
}

dyn_int: fn(value: Dyn) -> Int? Never! {
    if value == .Int(number) -> return Val(number)
    if value == .Number(lexeme) -> return parse_i64(lexeme)
    None
}

browser_id: fn(value: Dyn) -> Int? Never! {
    field: browser_get(value, "id") ?? return None
    id: dyn_int(field) ?? return None
    if id < 0 -> return None
    Val(id)
}

// FNV-1a 64 of the UTF-8 bytes as 16 lowercase hex digits: the hash every
// event and trace fact carries. Public, so a caller compares a fact against
// text it already holds without the text ever being kept.
fact_hash: fn(value: String) -> String Never! {
    hash := U64{14695981039346656037}
    loop byte in value.bytes() -> hash = (hash.bit_xor(U64.from_u8(byte))).wrapping_mul(U64{1099511628211})
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop index in 0..<16 {
        nibble: Int.from_u64((hash >> (60 - index * 4)).bit_and(U64{15}))
        out.push(digits[nibble])
    }
    String.from_bytes(out) ?? ""
}

hex_text: fn(value: String, length: Int) -> Bool Never! {
    raw: value.bytes()
    if raw.len() != length -> return false
    loop b in raw {
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70)) -> return false
    }
    true
}

digit_text: fn(value: String) -> Bool Never! {
    raw: value.bytes()
    if raw.len() == 0 -> return false
    loop b in raw {
        if b < 48 || b > 57 -> return false
    }
    true
}

// Redacted traces hold only `connect`, `event:<hash>`, and
// `send|recv|error:<id>:<hash>` entries within the 8 KiB bound.
trace_redacted: fn(entries: [String]) -> Bool Never! {
    total := 0
    loop entry in entries -> total += entry.len()
    if total > C_TRACE_LIMIT_BYTES -> return false
    loop entry in entries {
        if entry == "connect" -> next
        parts: parse.split(entry, ":")
        if parts.len() == 2 && parts[0] == "event" && hex_text(parts[1], 16) -> next
        if parts.len() == 3 && (parts[0] == "send" || parts[0] == "recv" || parts[0] == "error") && digit_text(parts[1]) && hex_text(parts[2], 16) -> next
        return false
    }
    true
}

ascii_upper: fn(b: U8) -> Bool Never! { b >= 65 && b <= 90 }

ascii_alpha: fn(b: U8) -> Bool Never! { ascii_upper(b) || (b >= 97 && b <= 122) }

ascii_alnum: fn(b: U8) -> Bool Never! { ascii_alpha(b) || (b >= 48 && b <= 57) }

// CDP methods are `Domain.command` with a PascalCase domain, so CDP never
// becomes a second spelling of a lowercase BiDi module path.
cdp_method_ok: fn(method: String) -> Bool Never! {
    raw: method.bytes()
    dot := -1
    loop index in 0..<raw.len() {
        if raw[index] == (U8{58}) -> return false
        if raw[index] == (U8{46}) {
            if dot >= 0 -> return false
            dot = index
        }
    }
    if dot <= 0 || dot == raw.len() - 1 -> return false
    if !ascii_upper(raw[0]) || !ascii_alpha(raw[dot + 1]) -> return false
    loop index in 1..<raw.len() {
        if index != dot && !ascii_alnum(raw[index]) -> return false
    }
    true
}

// ---- Scopes, pages, and locators --------------------------------------------

new_scope: fn(id: String) -> Shared<__BrowserScope> Never! { Shared{__BrowserScope{id: id, closed: false}} }

scope_id: fn(scope: Shared<__BrowserScope>) -> String Never! {
    guard: scope.guard_read()
    guard.value.id
}

scope_closed: fn(scope: Shared<__BrowserScope>) -> Bool Never! {
    guard: scope.guard_read()
    guard.value.closed
}

scope_close: fn(scope: Shared<__BrowserScope>) Never! {
    guard := scope.guard_edit()
    guard.value.closed = true
}

scope_set_id: fn(scope: Shared<__BrowserScope>, id: String) Never! {
    guard := scope.guard_edit()
    guard.value.id = id
}

context_create_tab: fn(context: BrowserContext) -[Net, Time]> BrowserPage BrowserError! {
    if scope_closed(context.__scope) -> return Err(BrowserError{kind: "closed"})
    result: browser_command(context.__browser, "browsingContext.create", obj([(key: "type", value: Dyn.Text("tab")), (key: "userContext", value: Dyn.Text(scope_id(context.__scope)))]))
    id: browser_string(result, "context")
    Ok(BrowserPage{__browser: context.__browser, __context: context.__scope, __scope: new_scope(id)})
}

page_live: fn(page: BrowserPage) BrowserError! {
    if scope_closed(page.__scope) || scope_closed(page.__context) -> return Err(BrowserError{kind: "closed"})
    Ok()
}

page_frame: fn(page: BrowserPage, id: String) -> BrowserFrame Never! {
    BrowserFrame{__browser: page.__browser, __context: page.__context, __page: page.__scope, __scope: new_scope(id)}
}

collect_frame_ids: fn(node: Dyn, out: &[String]) BrowserError! {
    id: browser_string(node, "context")
    out.push(id)
    children: browser_get(node, "children") ?? return Ok()
    if children == .Array(nodes) {
        loop child in nodes -> collect_frame_ids(child, out)
        return Ok()
    }
    Err(BrowserError{kind: "protocol"})
}

page_partition: fn(page: BrowserPage) -> Dyn Never! {
    obj([(key: "type", value: Dyn.Text("context")), (key: "context", value: Dyn.Text(scope_id(page.__scope)))])
}

decode_data: fn(result: Dyn) -> [U8] BrowserError! {
    data: browser_string(result, "data")
    bytes: base64.decode(data) ?? return Err(BrowserError{kind: "protocol"})
    Ok(bytes)
}

cookie_string_value: fn(cookie: Dyn) -> String BrowserError! {
    value: browser_get(cookie, "value") ?? return Err(BrowserError{kind: "protocol"})
    kind: browser_text(value, "type") ?? ""
    if kind != "string" && kind != "base64" -> return Err(BrowserError{kind: "protocol"})
    browser_string(value, "value")
}

storage_name: fn(kind: String) -> String? Never! {
    if kind == "local" -> return Val("localStorage")
    if kind == "session" -> return Val("sessionStorage")
    None
}

page_storage_call: fn(page: BrowserPage, function: String, arguments: &&[Dyn]) -[Net, Time]> Dyn BrowserError! {
    page_live(page)
    target: obj([(key: "context", value: Dyn.Text(scope_id(page.__scope)))])
    browser_command(page.__browser, "script.callFunction", obj([
        (key: "functionDeclaration", value: Dyn.Text(function.copy())),
        (key: "awaitPromise", value: Dyn.Bool(false)),
        (key: "target", value: target),
        (key: "arguments", value: Dyn.Array(arguments))
    ]))
}

remote_string: fn(result: Dyn) -> String? BrowserError! {
    value: browser_get(result, "result") ?? return Err(BrowserError{kind: "protocol"})
    kind: browser_text(value, "type") ?? ""
    if kind == "null" || kind == "undefined" -> return Ok(None)
    if kind != "string" -> return Err(BrowserError{kind: "protocol"})
    found: browser_string(value, "value")
    Ok(Val(found))
}

// A fixed caller expression evaluated in the page; its result stays out of the trace.
page_evaluate_text: fn(page: BrowserPage, expression: String) -[Net, Time]> String BrowserError! {
    page_live(page)
    target: obj([(key: "context", value: Dyn.Text(scope_id(page.__scope)))])
    result: browser_command(page.__browser, "script.evaluate", obj([
        (key: "expression", value: Dyn.Text(expression.copy())),
        (key: "awaitPromise", value: Dyn.Bool(false)),
        (key: "resultOwnership", value: Dyn.Text("none")),
        (key: "target", value: target)
    ]))
    found: remote_string(result) ?? return Err(BrowserError{kind: "protocol"})
    Ok(found)
}

navigation_url: fn(url: String) -[Env]> String Never! {
    if url.contains("://") || url.starts_with("about:") || url.starts_with("data:") -> return url.copy()
    env: core.sys.__startup_env()
    base: env_value(env, "JET_TEST_WEB_SERVER_URL") ?? env_value(env, "JET_BROWSER_TEST_SERVER_URL") ?? ""
    if base.len() == 0 -> return url.copy()
    "{trim_byte_end(base, U8{47})}/{trim_byte_start(url, U8{47})}"
}

trim_byte_end: fn(value: String, byte: U8) -> String Never! {
    raw: value.bytes()
    end := raw.len()
    loop end > 0 && raw[end - 1] == byte -> end -= 1
    out := [U8]{}
    loop index in 0..<end -> out.push(raw[index])
    String.from_bytes(out) ?? ""
}

trim_byte_start: fn(value: String, byte: U8) -> String Never! {
    raw: value.bytes()
    start := 0
    loop start < raw.len() && raw[start] == byte -> start += 1
    out := [U8]{}
    loop index in start..<raw.len() -> out.push(raw[index])
    String.from_bytes(out) ?? ""
}

css_attr_equals: fn(attr: String, value: String) -> String Never! {
    out := [U8]{}
    loop b in value.bytes() {
        if b == (U8{92}) || b == (U8{34}) -> out.push(U8{92})
        out.push(b)
    }
    escaped: String.from_bytes(out) ?? ""
    "[{attr}=\"{escaped}\"]"
}

page_locator: fn(page: BrowserPage, kind: String, role: String, name: String, value: String) -> BrowserLocator Never! {
    BrowserLocator{__browser: page.__browser, __context: page.__context, __page: page.__scope, __kind: kind, __role: role, __name: name, __value: value}
}

locator_wire: fn(locator: BrowserLocator) -> Dyn BrowserError! {
    if locator.__kind == "accessibility" {
        value := [(key: String, value: Dyn)]{}
        if locator.__role.len() > 0 -> value.push((key: "role", value: Dyn.Text(locator.__role.copy())))
        if locator.__name.len() > 0 -> value.push((key: "name", value: Dyn.Text(locator.__name.copy())))
        if value.len() == 0 -> return Err(BrowserError{kind: "protocol"})
        return Ok(obj([(key: "type", value: Dyn.Text("accessibility")), (key: "value", value: obj(value))]))
    }
    if locator.__kind == "css" || locator.__kind == "innerText" -> return Ok(obj([(key: "type", value: Dyn.Text(locator.__kind.copy())), (key: "value", value: Dyn.Text(locator.__value.copy()))]))
    Err(BrowserError{kind: "protocol"})
}

locator_query: fn(locator: BrowserLocator, timeout_ms: Int) -[Net, Time]> String? BrowserError! {
    if scope_closed(locator.__page) || scope_closed(locator.__context) -> return Err(BrowserError{kind: "closed"})
    wire: locator_wire(locator)
    result: browser_command_with_timeout(locator.__browser, "browsingContext.locateNodes", obj([
        (key: "context", value: Dyn.Text(scope_id(locator.__page))),
        (key: "locator", value: wire),
        (key: "maxNodeCount", value: Dyn.Int(1))
    ]), timeout_ms)
    nodes: browser_get(result, "nodes") ?? return Err(BrowserError{kind: "protocol"})
    if nodes == .Array(items) {
        if items.len() == 0 -> return Ok(None)
        found: browser_string(items[0], "sharedId")
        return Ok(Val(found))
    }
    Err(BrowserError{kind: "protocol"})
}

locator_pointer: fn(locator: BrowserLocator, shared_id: String, down_up: Bool) BrowserError! -[Net, Time]> {
    element: obj([(key: "sharedId", value: Dyn.Text(shared_id.copy()))])
    origin: obj([(key: "type", value: Dyn.Text("element")), (key: "element", value: element)])
    actions := [Dyn]{obj([(key: "type", value: Dyn.Text("pointerMove")), (key: "x", value: Dyn.Int(0)), (key: "y", value: Dyn.Int(0)), (key: "origin", value: origin)])}
    if down_up {
        actions.push(obj([(key: "type", value: Dyn.Text("pointerDown")), (key: "button", value: Dyn.Int(0))]))
        actions.push(obj([(key: "type", value: Dyn.Text("pointerUp")), (key: "button", value: Dyn.Int(0))]))
    }
    parameters: obj([(key: "pointerType", value: Dyn.Text("mouse"))])
    source: obj([(key: "type", value: Dyn.Text("pointer")), (key: "id", value: Dyn.Text("mouse")), (key: "parameters", value: parameters), (key: "actions", value: Dyn.Array(actions))])
    browser_command(locator.__browser, "input.performActions", obj([(key: "context", value: Dyn.Text(scope_id(locator.__page))), (key: "actions", value: Dyn.Array([Dyn]{source.move()}))]))
    Ok()
}

C_FILL_FUNCTION: "function(el, value) {{el.focus();if ('value' in el) {{ el.value = ''; el.value = value; }}else if (el.isContentEditable) {{ el.textContent = value; }}el.dispatchEvent(new Event('input', {{ bubbles: true }}));el.dispatchEvent(new Event('change', {{ bubbles: true }}));}}"

// ---- Browser tests ----------------------------------------------------------

selected: fn(config: BrowserTestConfig, name: String) -> Bool Never! {
    // An empty filter selects everything; otherwise any comma- or
    // ASCII-whitespace-separated glob pattern may match the name.
    if config.filter.trim().len() == 0 -> return true
    value: name.bytes()
    pattern := [U8]{}
    loop b in config.filter.bytes() {
        n: Int.from_u8(b)
        if n == 44 || n == 32 || n == 9 || n == 10 || n == 12 || n == 13 {
            if pattern.len() > 0 && glob_match(pattern, value) -> return true
            pattern = [U8]{}
        } else {
            pattern.push(b)
        }
    }
    pattern.len() > 0 && glob_match(pattern, value)
}

glob_match: fn(pattern: [U8], value: [U8]) -> Bool Never! {
    // `*` matches any run and `?` any one byte.
    p := 0
    v := 0
    star := -1
    star_value := 0
    loop v < value.len() {
        if p < pattern.len() && (pattern[p] == value[v] || pattern[p] == (U8{63})) {
            p += 1
            v += 1
        } else if p < pattern.len() && pattern[p] == (U8{42}) {
            star = p
            p += 1
            star_value = v
        } else {
            if star < 0 -> return false
            p = star + 1
            star_value += 1
            v = star_value
        }
    }
    loop p < pattern.len() && pattern[p] == (U8{42}) -> p += 1
    p == pattern.len()
}

// The engine's endpoint: `JET_BROWSER_<ENGINE>_ENDPOINT`, else
// `JET_BROWSER_ENDPOINT`; only ws:// and wss:// are accepted.
test_endpoint: fn(engine: String) -[Env]> String BrowserError! {
    env: core.sys.__startup_env()
    endpoint: env_value(env, "JET_BROWSER_{engine.to_upper()}_ENDPOINT") ?? env_value(env, "JET_BROWSER_ENDPOINT") ?? ""
    if endpoint.starts_with("ws://") || endpoint.starts_with("wss://") -> return Ok(endpoint)
    Err(BrowserError{kind: "transport"})
}

// Connects the engine's locked profile, opens an isolated context and page,
// and subscribes to the console and network events a report records. A
// failed page open closes the context and browser it opened.
begin_named: fn(config: BrowserTestConfig, test: String, engine: String, attempt: Int, source_path: String, line: Int, column: Int) -[Env, FS, IO, Net, Time]> BrowserTestFixture BrowserError! {
    entry: locked(engine)
    endpoint: test_endpoint(engine)
    p: profile(if entry.protocol.starts_with("bidi-") -> entry.protocol else -> "bidi-2025.5")
    b: connect_profile(endpoint, p, config.timeout)
    context: b.context()
    page: context.page() ?? {
        _: context.close()
        _: b.close()
        return Err(err)
    }
    // An older profile may lack an optional event; the queue keeps the rest.
    loop event in ([String]{"log.entryAdded", "network.beforeRequestSent", "network.responseStarted", "network.fetchError", "browsingContext.consoleMessage"}) {
        _: b.subscribe(event)
    }
    Ok(BrowserTestFixture{__browser: b, __context: context, __page: page})
}

fixture_context: fn(fixture: BrowserTestFixture) -> BrowserContext Never! { fixture.__context }

fixture_page: fn(fixture: BrowserTestFixture) -> BrowserPage Never! { fixture.__page }


fixture_source: fn(name: String, body: String) -> String BrowserError! {
    generate_source(name, body, "")
}

generate_source: fn(name: String, body: String, base_url: String) -> String BrowserError! {
    if name.len() == 0 || name.len() > C_MAX_SOURCE_NAME || body.len() > C_MAX_SOURCE_BYTES || base_url.len() > C_MAX_SOURCE_BYTES {
        return Err(BrowserError{kind: "protocol"})
    }
    url := base_url
    if url.len() == 0 -> url = "/"
    test_name := source_name(name)
    escaped: esc_source(url)
    out := "// generated browser test\n{test_name}: fn() {{\n    _: \"{escaped}\"\n    {body}\n}}\n"
    if out.len() > C_MAX_SOURCE_BYTES -> return Err(BrowserError{kind: "protocol"})
    Ok(out)
}

report_new: fn(config: BrowserTestConfig) -> BrowserTestReport Never! {
    BrowserTestReport{source_root: config.source_root, reporter: config.reporter, ui: config.ui, watch: config.watch, cases: [BrowserTestCase]{}}
}

report_add_case: fn(report: BrowserTestReport, case: BrowserTestCase) -> BrowserTestReport Never! {
    // Append, then order the cases by name.
    out := report
    out.cases.push(case.copy())
    out.cases.sort_by(fn(left: BrowserTestCase, right: BrowserTestCase) { left.name <=> right.name })
    out
}

report_exit_code: fn(report: BrowserTestReport) -> Int Never! {
    // A selected case fails unless its last attempt passed.
    loop case in report.cases {
        if case.selected {
            if case.attempts.len() == 0 -> return 1
            if !case.attempts[case.attempts.len() - 1].passed -> return 1
        }
    }
    0
}

report_summary: fn(report: BrowserTestReport) -> String Never! {
    passed := 0
    failed := 0
    skipped := 0
    loop case in report.cases {
        if !case.selected {
            skipped += 1
        } else if case.attempts.len() > 0 && case.attempts[case.attempts.len() - 1].passed {
            passed += 1
        } else {
            failed += 1
        }
    }
    "{passed} passed, {failed} failed, {skipped} skipped"
}

report_source_value: fn(source: BrowserTestSource) -> Dyn Never! {
    obj([(key: "path", value: Dyn.Text(source.path.copy())), (key: "line", value: Dyn.Int(source.line)), (key: "column", value: Dyn.Int(source.column))])
}

report_attempt_value: fn(attempt: BrowserTestAttempt) -> Dyn Never! {
    actions := [Dyn]{}
    loop action in attempt.actions {
        actions.push(obj([(key: "sequence", value: Dyn.Int(action.sequence)), (key: "kind", value: Dyn.Text(action.kind)), (key: "fact", value: Dyn.Text(action.fact)), (key: "source", value: report_source_value(attempt.source))]))
    }
    snapshots := [Dyn]{}
    loop snapshot in attempt.snapshots {
        snapshots.push(obj([(key: "kind", value: Dyn.Text(snapshot.kind)), (key: "hash", value: Dyn.Text(snapshot.hash)), (key: "bytes", value: Dyn.Int(snapshot.bytes)), (key: "path", value: Dyn.Text(snapshot.path)), (key: "source", value: report_source_value(snapshot.source))]))
    }
    events := [Dyn]{}
    loop event in attempt.events {
        events.push(obj([(key: "kind", value: Dyn.Text(event.kind)), (key: "requestIdHash", value: Dyn.Text(event.request_id_hash)), (key: "requestMethod", value: Dyn.Text(event.request_method)), (key: "urlHash", value: Dyn.Text(event.url_hash)), (key: "statusCode", value: Dyn.Int(event.status_code)), (key: "isBlocked", value: Dyn.Bool(event.is_blocked))]))
    }
    artifacts := [Dyn]{}
    loop artifact in attempt.artifacts {
        artifacts.push(obj([(key: "name", value: Dyn.Text(artifact.name)), (key: "path", value: Dyn.Text(artifact.path)), (key: "mime", value: Dyn.Text(artifact.mime)), (key: "bytes", value: Dyn.Int(artifact.bytes)), (key: "hash", value: Dyn.Text(artifact.hash)), (key: "source", value: report_source_value(artifact.source))]))
    }
    trace := [Dyn]{}
    loop entry in attempt.trace -> trace.push(Dyn.Text(entry))
    error: if attempt.error.len() == 0 -> Dyn.Null else -> Dyn.Text(attempt.error.copy())
    obj([
        (key: "test", value: Dyn.Text(attempt.test.copy())),
        (key: "engine", value: Dyn.Text(attempt.engine.copy())),
        (key: "attempt", value: Dyn.Int(attempt.attempt)),
        (key: "passed", value: Dyn.Bool(attempt.passed)),
        (key: "expectedFailure", value: Dyn.Bool(attempt.expected_failure)),
        (key: "durationMs", value: Dyn.Int(attempt.duration_ms)),
        (key: "source", value: report_source_value(attempt.source)),
        (key: "actions", value: Dyn.Array(actions)),
        (key: "snapshots", value: Dyn.Array(snapshots)),
        (key: "events", value: Dyn.Array(events)),
        (key: "artifacts", value: Dyn.Array(artifacts)),
        (key: "trace", value: Dyn.Array(trace)),
        (key: "error", value: error)
    ])
}

// The `jet.browser.test/v1` document, pretty-rendered with keys in schema order.
report_json: fn(report: BrowserTestReport) -> String Never! {
    cases := [Dyn]{}
    loop case in report.cases {
        attempts := [Dyn]{}
        loop attempt in case.attempts -> attempts.push(report_attempt_value(attempt))
        cases.push(obj([(key: "name", value: Dyn.Text(case.name)), (key: "selected", value: Dyn.Bool(case.selected)), (key: "attempts", value: Dyn.Array(attempts))]))
    }
    document: obj([
        (key: "schema", value: Dyn.Text("jet.browser.test/v1")),
        (key: "sourceRoot", value: Dyn.Text(report.source_root.copy())),
        (key: "reporter", value: Dyn.Text(report.reporter.copy())),
        (key: "ui", value: Dyn.Bool(report.ui)),
        (key: "watch", value: Dyn.Bool(report.watch)),
        (key: "summary", value: Dyn.Text(report_summary(report))),
        (key: "exitCode", value: Dyn.Int(report_exit_code(report))),
        (key: "cases", value: Dyn.Array(cases))
    ])
    // The document holds no Float, so rendering cannot fail.
    json.to_string_pretty(document) ?? ""
}

report_text: fn(report: BrowserTestReport) -> String Never! {
    lines := [String]{"Browser tests: {report_summary(report)}\n"}
    loop case in report.cases {
        if !case.selected {
            lines.push("SKIP {case.name}\n")
            next
        }
        loop attempt in case.attempts {
            status: if attempt.passed -> "PASS" else -> "FAIL"
            lines.push("{status} {attempt.test} [{attempt.engine}] attempt={attempt.attempt} duration={attempt.duration_ms}ms\n")
            if attempt.error.len() > 0 -> lines.push("  error: {attempt.error}\n")
            loop action in attempt.actions -> lines.push("  action {action.sequence}: {action.kind} {action.fact}\n")
            loop snapshot in attempt.snapshots {
                origin: if snapshot.source.path.len() == 0 -> "" else -> " source={snapshot.source.path}:{snapshot.source.line}"
                lines.push("  snapshot {snapshot.kind}: {snapshot.path} bytes={snapshot.bytes} hash={snapshot.hash}{origin}\n")
            }
            loop event in attempt.events {
                lines.push("  {event.kind} request={event.request_id_hash} method={event.request_method} url={event.url_hash} status={event.status_code} blocked={event.is_blocked}\n")
            }
            loop artifact in attempt.artifacts -> lines.push("  attachment {artifact.name}: {artifact.path}\n")
            if attempt.trace.len() > 0 -> lines.push("  trace: {attempt.trace.join(",")}\n")
        }
    }
    lines.join("")
}

// The viewer embeds the JSON document with `&`, `<`, `>`, U+2028, and U+2029
// escaped so the data block cannot close its script element.
report_html: fn(report: BrowserTestReport) -> String Never! {
    raw: report_json(report).bytes()
    out := [U8]{}
    push_str(out, C_REPORT_HTML_HEAD)
    index := 0
    loop index < raw.len() {
        b: raw[index]
        line_separator: b == (U8{226}) && index + 2 < raw.len() && raw[index + 1] == (U8{128}) && (raw[index + 2] == (U8{168}) || raw[index + 2] == (U8{169}))
        if b == (U8{38}) {
            push_str(out, "\\u0026")
        } else if b == (U8{60}) {
            push_str(out, "\\u003c")
        } else if b == (U8{62}) {
            push_str(out, "\\u003e")
        } else if line_separator {
            push_str(out, if raw[index + 2] == (U8{168}) -> "\\u2028" else -> "\\u2029")
            index += 2
        } else {
            out.push(b)
        }
        index += 1
    }
    push_str(out, C_REPORT_HTML_TAIL)
    String.from_bytes(out) ?? ""
}

write_report: fn(report: BrowserTestReport, path: String) BrowserError! -[FS]> {
    // The configured format is written first; the HTML viewer companion
    // follows for `ui` runs and HTML reports.
    rendered: if report.reporter == {
        "json" -> report_json(report)
        "html" -> report_html(report)
        else -> report_text(report)
    }
    write_report_text(path, rendered)
    if report.ui || report.reporter == "html" -> write_report_text(files.with_suffix(path, ".html"), report_html(report))
    Ok()
}

write_report_text: fn(path: String, rendered: String) BrowserError! -[FS]> {
    if rendered.bytes().len() > C_MAX_REPORT_BYTES -> return Err(BrowserError{kind: "protocol"})
    parent: files.dirname(path)
    if parent.len() > 0 -> files.create_dir_all(parent) ?? return Err(BrowserError{kind: "transport"})
    files.write(path, rendered) ?? return Err(BrowserError{kind: "transport"})
    Ok()
}

// Reuse a listening server when configured; otherwise spawn the server
// command and wait for its port. A server that never listens is stopped.
server_start: fn(config: BrowserTestConfig) -[Exec, Net, Time, Time.Wait]> BrowserTestServer BrowserError! {
    if config.server_url.len() == 0 -> return Err(BrowserError{kind: "transport"})
    reusable := false
    if config.server_reuse && server_wait_ready(config.server_url, 100) == .Ok(_) -> reusable = true
    server: BrowserTestServer{__url: config.server_url, __state: Shared{__BrowserServerState{child: None, logs: ""}}}
    if reusable -> return Ok(server)
    if config.server_command.len() > 0 {
        spec := process.cmd(config.server_command).stdout(.Capture).stderr(.Capture)
        if config.server_cwd.len() > 0 -> spec = spec.cwd(config.server_cwd)
        child: spec.spawn() ?? return Err(BrowserError{kind: "transport"})
        guard := server.__state.guard_edit()
        guard.value.child = Val(child)
    }
    if server_wait_ready(config.server_url, config.timeout.milliseconds) == .Err(error) {
        server.stop()
        return Err(error)
    }
    Ok(server)
}

server_wait_ready: fn(url: String, timeout_ms: Int) BrowserError! -[Net, Time, Time.Wait]> {
    target: server_host_port(url) ?? return Err(BrowserError{kind: "transport"})
    started: time.instant()
    loop {
        remaining: timeout_ms - started.elapsed_millis()
        if remaining <= 0 -> return Err(BrowserError{kind: "timeout"})
        probe: if remaining < 100 -> remaining else -> 100
        if core.net.__tcp_connect_happy(target.host, target.port, probe) == .Ok(_) -> return Ok()
        time.sleep(10ms)
    }
}

// The host and port of an http:// or https:// URL without credentials.
server_host_port: fn(url: String) -> (host: String, port: Int)? Never! {
    scheme: parse.split_once(url, "://")
    if !scheme.found || (scheme.head != "http" && scheme.head != "https") -> return None
    authority: parse.split_once(scheme.tail, "/").head
    if authority.len() == 0 || authority.contains("@") -> return None
    colon: parse.rpartition(authority, ":")
    if colon.sep.len() == 0 -> return Val((host: authority, port: 80))
    if colon.head.len() == 0 -> return None
    port: parse_i64(colon.tail) ?? return None
    if port < 0 || port > 65535 -> return None
    Val((host: colon.head, port: port))
}

bounded_text: fn(value: String, limit: Int) -> String Never! {
    raw: value.bytes()
    if raw.len() <= limit -> return value.copy()
    end := limit
    // Keep whole UTF-8 sequences: back up over continuation bytes.
    loop end > 0 && raw[end] >= 128 && raw[end] < 192 -> end -= 1
    out := [U8]{}
    loop index in 0..<end -> out.push(raw[index])
    String.from_bytes(out) ?? ""
}

watch_changed: fn(path: String, last_modified_ms: Int) -[FS, Net]> Bool BrowserError! {
    modified: files.getmtime(path) ?? return Ok(last_modified_ms >= 0)
    Ok(modified > last_modified_ms)
}

server_stop: fn(server: BrowserTestServer) Never! -[Exec, Time.Wait]> { server.stop() }

server_url: fn(server: BrowserTestServer) -> String Never! { server.url() }

server_logs: fn(server: BrowserTestServer) -> String Never! { server.logs() }


push_str: fn(out: &[U8], s: String) Never! {
    loop b in s.bytes() -> out.push(b)
}
source_name: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    loop i in 0..<raw.len() {
        n: raw[i]
        ok := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95
        if ok {
            if i == 0 && n >= 48 && n <= 57 -> out.push(U8{95})
            out.push(n)
        } else {
            out.push(U8{95})
        }
    }
    if out.len() == 0 -> return "generated_browser_test"
    String.from_bytes(out) ?? "generated_browser_test"
}

esc_source: fn(text: String) -> String Never! {
    raw: text.bytes()
    out := [U8]{}
    loop b in raw {
        if b == (U8{92}) || b == (U8{34}) {
            out.push(U8{92})
            out.push(b)
        } else {
            if b == (U8{10}) {
                push_str(out, "\\n")
            } else {
                if b == (U8{13}) -> push_str(out, "\\r") else -> out.push(b)
            }
        }
    }
    String.from_bytes(out) ?? ""
}

C_REPORT_HTML_HEAD: "<!doctype html><html><head><meta charset=\"utf-8\"><title>Jet browser tests</title><style>:root{{color-scheme:dark;font:14px system-ui,sans-serif;background:#10151d;color:#e7edf5}}body{{margin:0;padding:24px;max-width:1400px;margin-inline:auto}}header{{display:flex;gap:16px;align-items:end;justify-content:space-between;border-bottom:1px solid #344052;padding-bottom:16px}}input{{background:#171f2b;border:1px solid #40506a;color:inherit;padding:8px;border-radius:5px;min-width:260px}}main{{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,2fr);gap:18px;margin-top:18px}}section{{border:1px solid #344052;border-radius:8px;background:#151c27;padding:14px;margin-bottom:12px}}.tree button{{display:block;width:100%;text-align:left;background:none;border:0;color:inherit;padding:8px;border-radius:4px;cursor:pointer}}.tree button:hover,.tree button.active{{background:#26364b}}.pass{{color:#6ee7a8}}.fail{{color:#ff8e8e}}.muted{{color:#9aabc0}}pre{{white-space:pre-wrap;overflow:auto;background:#0d1118;border-radius:5px;padding:10px;font-size:12px}}.chip{{display:inline-block;border:1px solid #40506a;border-radius:999px;padding:2px 7px;margin:2px;font-size:12px}}@media(max-width:760px){{main{{display:block}}body{{padding:14px}}input{{min-width:0;width:100%}}}}</style></head><body><header><div><div class=\"muted\">Jet browser test viewer</div><h1 id=\"summary\">Loading</h1></div><label>Filter <input id=\"filter\" placeholder=\"test or engine\"></label></header><main><section class=\"tree\"><h2>Test tree</h2><div id=\"tree\"></div></section><section><div id=\"details\"><p class=\"muted\">Select a test.</p></div></section></main><script id=\"jet-browser-data\" type=\"application/json\">"

C_REPORT_HTML_TAIL: "</script><script>\nconst data=JSON.parse(document.getElementById('jet-browser-data').textContent);\nconst tree=document.getElementById('tree'), details=document.getElementById('details'), filter=document.getElementById('filter');\nconst text=(tag,value,cls='')=>{{const e=document.createElement(tag);e.textContent=value??'';if(cls)e.className=cls;return e;}};\nconst allAttempts=c=>c.attempts||[];\nfunction renderTree(){{tree.replaceChildren();const q=filter.value.toLowerCase();for(const c of data.cases){{if(q&&!(`${{c.name}} ${{allAttempts(c).map(a=>a.engine).join(' ')}}`.toLowerCase().includes(q)))continue;const b=document.createElement('button');const last=allAttempts(c).at(-1);b.append(text('span',c.selected?(last&&last.passed?'PASS ':'FAIL '):'SKIP ','',c.selected?(last&&last.passed?'pass':'fail'):'muted'),text('span',c.name));b.onclick=()=>renderDetails(c);tree.append(b);}}}}\nfunction renderDetails(c){{details.replaceChildren();details.append(text('h2',c.name));for(const a of allAttempts(c)){{const s=document.createElement('section');s.append(text('h3',`${{a.passed?'PASS':'FAIL'}} · ${{a.engine}} · attempt ${{a.attempt}}`,a.passed?'pass':'fail'));s.append(text('p',`Duration ${{a.durationMs}} ms · source ${{a.source.path}}:${{a.source.line}}:${{a.source.column}}`,'muted'));if(a.error)s.append(text('p',`Error: ${{a.error}}`,'fail'));const timeline=document.createElement('div');timeline.append(text('h4','Timeline'));for(const x of a.actions||[])timeline.append(text('span',`${{x.sequence}} ${{x.kind}} ${{x.fact}}`,'chip'));for(const x of a.trace||[])timeline.append(text('span',x,'chip'));s.append(timeline);const dom=document.createElement('div');dom.append(text('h4','DOM snapshots'));for(const x of a.snapshots||[])dom.append(text('p',`${{x.kind}}: ${{x.hash}} · ${{x.bytes}} bytes${{x.path?' · '+x.path:''}}`));s.append(dom);const source=document.createElement('div');source.append(text('h4','Source'));source.append(text('p',`${{a.source.path}}:${{a.source.line}}:${{a.source.column}}`));s.append(source);const logs=document.createElement('div');logs.append(text('h4','Logs / console'));for(const x of (a.events||[]).filter(x=>x.kind==='console'))logs.append(text('p',`${{x.requestMethod||'console'}} · ${{x.urlHash||''}}`));s.append(logs);const network=document.createElement('div');network.append(text('h4','Network'));for(const x of (a.events||[]).filter(x=>x.kind==='network'))network.append(text('p',`${{x.requestMethod||''}} · ${{x.urlHash||''}} · ${{x.statusCode}} · blocked=${{x.isBlocked}}`));s.append(network);const attachments=document.createElement('div');attachments.append(text('h4','Attachments'));for(const x of a.artifacts||[])attachments.append(text('p',`${{x.name}} · ${{x.path}} · ${{x.mime}} · ${{x.bytes}} bytes`));s.append(attachments);details.append(s);}}}}\nsummary.textContent=`${{data.summary}} · exit ${{data.exitCode}}`;filter.addEventListener('input',renderTree);renderTree();if(data.watch)setInterval(()=>location.reload(),1000);\n</script></body></html>"

#Test("browser profiles keep exact version pins") {
    current: profile("bidi-2025.5") ?? panic("current profile rejected")
    previous: profile("bidi-2024.11") ?? panic("previous profile rejected")
    assert_eq(current.name, "bidi-2025.5")
    assert_eq(current.version, "2025.5")
    assert_eq(previous.version, "2024.11")
    loop invalid in ([String]{"", "default", "BIDI-2025.5", " bidi-2025.5", "bidi-2025.5 "}) {
        if profile(invalid) == {
            .Ok(_) -> panic("invalid profile accepted")
            .Err(error) -> {
                assert_eq(error.kind, "invalid profile")
                assert_eq("{error}", "browser profile is not supported")
            }
        }
    }
}

#Test("browser timeout preserves both bounds and exact refusal text") {
    minimum: timeout(1) ?? panic("minimum timeout rejected")
    maximum: timeout(600000) ?? panic("maximum timeout rejected")
    assert_eq(minimum.milliseconds, 1)
    assert_eq(maximum.milliseconds, 600000)
    loop invalid in ([Int]{-1, 0, 600001, 9223372036854775807}) {
        if timeout(invalid) == {
            .Ok(_) -> panic("invalid timeout accepted")
            .Err(error) -> assert_eq("{error}", "browser timeout must be between 1 and 600000 milliseconds")
        }
    }
}

#Test("browser errors use the shipped display vocabulary") {
    assert_eq("{BrowserError{kind: "unsupported protocol"}}", "browser protocol is not available in this session")
    assert_eq("{BrowserError{kind: "timeout"}}", "browser operation timed out")
    assert_eq("{BrowserError{kind: "closed"}}", "browser session is closed")
    assert_eq("{BrowserError{kind: "transport"}}", "browser transport failed")
    assert_eq("{BrowserError{kind: "missing lock"}}", "no locked browser for this engine in .jet/lock")
    assert_eq("{BrowserError{kind: "unknown engine"}}", "browser engine is not supported")
    assert_eq("{BrowserError{kind: "missing binary"}}", "locked browser binary was not found")
    assert_eq("{BrowserError{kind: "size mismatch"}}", "locked browser binary size drifted")
    assert_eq("{BrowserError{kind: "invalid lock"}}", "browser lock entry is incomplete")
    assert_eq("{BrowserError{kind: "protocol"}}", "browser protocol failed")
}

#Test("browser facts hash, gate, and redact like the session runtime") {
    assert_eq(fact_hash(""), "cbf29ce484222325")
    assert_eq(fact_hash("a"), "af63dc4c8601ec8c")
    assert(profile_allows("bidi-2024.11", "session.new"))
    assert(!profile_allows("bidi-2024.11", "permissions.setPermission"))
    assert(profile_allows("bidi-2025.5", "permissions.setPermission"))
    assert(profile_allows("bidi-2024.11", "script.addPreloadScript") && profile_allows("bidi-2024.11", "script.removePreloadScript"))
    assert(!profile_allows("bidi-2024.11", "emulation.setNetworkConditions"))
    assert(profile_allows("bidi-2025.5", "emulation.setNetworkConditions"))
    assert(!profile_allows("bidi-2026.1", "session.new"))
    assert(cdp_method_ok("Runtime.evaluate"))
    assert(!cdp_method_ok("runtime.evaluate"))
    assert(!cdp_method_ok("Runtime.evaluate.more"))
    assert(!cdp_method_ok("goog:cdp.Runtime"))
    assert(!cdp_method_ok("Runtime."))
    hash: fact_hash("session.new")
    assert(trace_redacted([String]{"connect", "send:1:{hash}", "recv:1:{hash}", "event:{hash}"}))
    assert(!trace_redacted([String]{"send:x:{hash}"}))
    assert(!trace_redacted([String]{"goto:{hash}"}))
    assert_eq(server_host_port("http://127.0.0.1:8080/app"), Val((host: "127.0.0.1", port: 8080)))
    assert_eq(server_host_port("https://example.test"), Val((host: "example.test", port: 80)))
    assert_eq(server_host_port("http://user@host:1"), None)
    assert_eq(server_host_port("ftp://host"), None)
    assert_eq(css_attr_equals("data-testid", "a\"b"), "[data-testid=\"a\\\"b\"]")
}

#Test("a CDP event is queued as its Domain.event kind with redacted network facts") {
    wire: "{{\"type\":\"event\",\"method\":\"goog:cdp.Network.responseReceived\",\"params\":{{\"event\":\"Network.responseReceived\",\"session\":\"S1\",\"params\":{{\"requestId\":\"R7\",\"request\":{{\"method\":\"GET\",\"url\":\"https://example.test/app.js\"}},\"response\":{{\"status\":200}}}}}}}}"
    value: json.parse(wire) ?? panic("the CDP event parses")
    event: __cdp_event_facts(value, "goog:cdp.Network.responseReceived")
    assert_eq(event.kind(), "Network.responseReceived")
    assert_eq(event.request_id(), "R7")
    assert_eq(event.request_method(), "GET")
    assert_eq(event.url_hash(), fact_hash("https://example.test/app.js"))
    assert_eq(event.status_code(), 200)
    assert_eq(event.frame_line(), -1)
    assert_eq(event.frame_function_hash(), "")
    assert_eq(event.source_map_url_hash(), "")
    bare: __cdp_event_facts(json.parse("{{\"type\":\"event\",\"method\":\"goog:cdp.Debugger.paused\"}}") ?? panic("the bare event parses"), "goog:cdp.Debugger.paused")
    assert_eq("{bare.kind()} {bare.request_id()} {bare.status_code()} {bare.frame_line()} {bare.frame_column()} {bare.frame_function_hash()}", "Debugger.paused  0 -1 -1 ")
}

#Test("a CDP debugger event keeps its top frame and script facts as hashes and its session in Core") {
    paused_wire: "{{\"type\":\"event\",\"method\":\"goog:cdp.Debugger.paused\",\"params\":{{\"event\":\"Debugger.paused\",\"session\":\"S1\",\"params\":{{\"reason\":\"other\",\"hitBreakpoints\":[\"1:41:0:https://app.example/main.js\"],\"callFrames\":[{{\"callFrameId\":\"F0\",\"functionName\":\"render\",\"location\":{{\"scriptId\":\"42\",\"lineNumber\":41,\"columnNumber\":7}},\"url\":\"https://app.example/main.js\",\"scopeChain\":[],\"this\":{{\"type\":\"undefined\"}}}},{{\"callFrameId\":\"F1\",\"functionName\":\"\",\"location\":{{\"scriptId\":\"42\",\"lineNumber\":90,\"columnNumber\":0}},\"url\":\"https://app.example/main.js\",\"scopeChain\":[],\"this\":{{\"type\":\"undefined\"}}}}]}}}}}}"
    paused: __cdp_event_facts(json.parse(paused_wire) ?? panic("the paused event parses"), "goog:cdp.Debugger.paused")
    assert_eq(paused.kind(), "Debugger.paused")
    assert_eq(paused.frame_line(), 41)
    assert_eq(paused.frame_column(), 7)
    assert_eq(paused.frame_function_hash(), fact_hash("render"))
    assert_eq(paused.__session, "S1")
    assert_eq(paused.url_hash(), "")
    anonymous_wire: "{{\"type\":\"event\",\"method\":\"goog:cdp.Debugger.paused\",\"params\":{{\"event\":\"Debugger.paused\",\"session\":\"S2\",\"params\":{{\"reason\":\"other\",\"callFrames\":[{{\"callFrameId\":\"F0\",\"functionName\":\"\",\"location\":{{\"scriptId\":\"7\",\"lineNumber\":0}}}}]}}}}}}"
    anonymous: __cdp_event_facts(json.parse(anonymous_wire) ?? panic("the anonymous paused event parses"), "goog:cdp.Debugger.paused")
    assert_eq("{anonymous.frame_line()} {anonymous.frame_column()} {anonymous.frame_function_hash()} {anonymous.__session}", "0 -1 {fact_hash("")} S2")
    parsed_wire: "{{\"type\":\"event\",\"method\":\"goog:cdp.Debugger.scriptParsed\",\"params\":{{\"event\":\"Debugger.scriptParsed\",\"session\":\"S1\",\"params\":{{\"scriptId\":\"42\",\"url\":\"https://app.example/main.js\",\"startLine\":0,\"startColumn\":0,\"endLine\":120,\"endColumn\":0,\"executionContextId\":1,\"hash\":\"abc\",\"sourceMapURL\":\"main.js.map\"}}}}}}"
    parsed: __cdp_event_facts(json.parse(parsed_wire) ?? panic("the scriptParsed event parses"), "goog:cdp.Debugger.scriptParsed")
    assert_eq(parsed.kind(), "Debugger.scriptParsed")
    assert_eq(parsed.url_hash(), fact_hash("https://app.example/main.js"))
    assert_eq(parsed.source_map_url_hash(), fact_hash("main.js.map"))
    assert_eq("{parsed.frame_line()} {parsed.frame_column()} {parsed.frame_function_hash()}", "-1 -1 ")
    mapless_wire: "{{\"type\":\"event\",\"method\":\"goog:cdp.Debugger.scriptParsed\",\"params\":{{\"event\":\"Debugger.scriptParsed\",\"session\":\"S1\",\"params\":{{\"scriptId\":\"43\",\"url\":\"\",\"sourceMapURL\":\"\"}}}}}}"
    mapless: __cdp_event_facts(json.parse(mapless_wire) ?? panic("the mapless scriptParsed event parses"), "goog:cdp.Debugger.scriptParsed")
    assert_eq("{mapless.url_hash()} {mapless.source_map_url_hash()}", "{fact_hash("")} ")
    bidi: event_facts(json.parse("{{\"type\":\"event\",\"method\":\"log.entryAdded\",\"params\":{{\"text\":\"x\"}}}}") ?? panic("the BiDi event parses"), "log.entryAdded")
    assert_eq(bidi.__session, "")
    assert_eq(fact_hash(""), "cbf29ce484222325")
    assert_eq(fact_hash("a"), "af63dc4c8601ec8c")
}

#Test("goog:cdp.getSession is allowed only where goog:cdp.sendCommand is") {
    assert(profile_allows("bidi-2024.11", "goog:cdp.getSession"))
    assert(profile_allows("bidi-2025.5", "goog:cdp.getSession"))
    assert(!profile_allows("bidi-2023.1", "goog:cdp.getSession"))
}

#Test("browser report renders the v1 schema, text summary, and escaped viewer") {
    source: BrowserTestSource{path: "app.jet", line: 3, column: 5}
    attempt: BrowserTestAttempt{test: "login", engine: "firefox", attempt: 0, passed: false, expected_failure: false, duration_ms: 12, source: source, actions: [BrowserTestAction]{{sequence: 0, kind: "goto", fact: "abc"}}, snapshots: [BrowserTestSnapshot]{}, events: [BrowserTestEventFact]{}, artifacts: [BrowserTestArtifact]{}, trace: [String]{"connect"}, error: "browser operation timed out"}
    report: BrowserTestReport{source_root: ".", reporter: "text", ui: false, watch: false, cases: [BrowserTestCase]{{name: "login", selected: true, attempts: [BrowserTestAttempt]{attempt}}, {name: "skip", selected: false, attempts: [BrowserTestAttempt]{}}}}
    assert_eq(report_summary(report), "0 passed, 1 failed, 1 skipped")
    assert_eq(report_text(report), "Browser tests: 0 passed, 1 failed, 1 skipped\nFAIL login [firefox] attempt=0 duration=12ms\n  error: browser operation timed out\n  action 0: goto abc\n  trace: connect\nSKIP skip\n")
    rendered: report_json(report)
    assert(rendered.starts_with("{{\n  \"schema\": \"jet.browser.test/v1\",\n  \"sourceRoot\": \".\""))
    assert(rendered.contains("\"exitCode\": 1"))
    assert(rendered.contains("\"error\": \"browser operation timed out\""))
    html: report_html(BrowserTestReport{source_root: "<x>&", reporter: "html", ui: false, watch: false, cases: [BrowserTestCase]{}})
    assert(html.contains("\"sourceRoot\": \"\\u003cx\\u003e\\u0026\""))
    assert(html.starts_with("<!doctype html>"))
    assert(html.ends_with("</script></body></html>"))
}

source_position: fn(value: Int) -> Int Never! {
    if value < 0 -> return 0
    if value > 4294967295 -> return 4294967295
    value
}

// A negative accumulator accepts i64::MIN without an overflowing magnitude.
parse_i64: fn(value: String) -> Int? Never! {
    raw: value.bytes()
    if raw.len() == 0 -> return None
    negative: raw[0] == (U8{45})
    i := if negative || raw[0] == (U8{43}) -> 1 else -> 0
    if i == raw.len() -> return None
    limit: if negative -> -9223372036854775808 else -> -9223372036854775807
    n := 0
    loop i < raw.len() {
        d: Int{raw[i]} - 48
        if d < 0 || d > 9 -> return None
        if n < limit /% 10 -> return None
        n = n * 10
        if n < limit + d -> return None
        n = n - d
        i += 1
    }
    Val(if negative -> n else -> -n)
}

config_value: fn(root: String, key: String) -[FS]> String? Never! {
    raw: files.read(files.join(root, "browser-tests.conf")) ?? return None
    loop line in parse.split(raw, "\n") {
        pair: parse.split_once(text.trim(line), "=")
        if pair.found && parse.lower(text.trim(pair.head)) == parse.lower(key) -> return Val(text.trim(pair.tail))
    }
    None
}

env_value: fn(env: [(name: [U8], value: [U8])], variable: String) -> String? Never! {
    key: variable.bytes()
    loop entry in env {
        if entry.name == key {
            text: String.from_bytes(entry.value) ?? return None
            return Val(text)
        }
    }
    None
}

setting: fn(root: String, env: [(name: [U8], value: [U8])], variable: String, key: String) -[FS]> String? Never! {
    if env_value(env, variable) == Val(value) -> return Val(value)
    config_value(root, key)
}

env_bool: fn(env: [(name: [U8], value: [U8])], variable: String, default: Bool) -> Bool Never! {
    value: env_value(env, variable) ?? return default
    normalized: parse.lower(text.trim(value))
    if normalized == "1" || normalized == "true" || normalized == "yes" || normalized == "on" -> return true
    if normalized == "0" || normalized == "false" || normalized == "no" || normalized == "off" -> return false
    default
}

ascii_space: fn(value: U8) -> Bool Never! {
    value == U8{32} || value == U8{9} || value == U8{10} || value == U8{11} || value == U8{12} || value == U8{13}
}

test_engines: fn(raw: String) -> [String] BrowserError! {
    requested := [String]{}
    token := [U8]{}
    bytes: raw.bytes()
    loop i in 0..<(bytes.len() + 1) {
        separator: i == bytes.len() || bytes[i] == (U8{44}) || ascii_space(bytes[i])
        if !separator {
            token.push(bytes[i])
            next
        }
        value: parse.lower(text.trim(String.from_bytes(token) ?? ""))
        token = [U8]{}
        if value == "" -> next
        if value != "chromium" && value != "firefox" && value != "webkit" -> return Err(BrowserError{kind: "unknown engine"})
        requested.push(value)
    }
    engines := [String]{}
    loop engine in ([String]{"chromium", "firefox", "webkit"}) {
        loop value in requested {
            if value == engine {
                engines.push(engine)
                break
            }
        }
    }
    if engines.len() == 0 -> return Err(BrowserError{kind: "unknown engine"})
    Ok(engines)
}

split_command: fn(raw: String) -> [String] Never! {
    command := [String]{}
    value := [U8]{}
    quote := U8{0}
    loop b in raw.bytes() {
        if quote != (U8{0}) {
            if b == quote -> quote = U8{0} else -> value.push(b)
        } else if b == (U8{39}) || b == (U8{34}) {
            quote = b
        } else if ascii_space(b) {
            if value.len() > 0 {
                command.push(String.from_bytes(value) ?? "")
                value = [U8]{}
            }
        } else {
            value.push(b)
        }
    }
    if value.len() > 0 -> command.push(String.from_bytes(value) ?? "")
    command
}

config_from_snapshot: fn(root: String, env: [(name: [U8], value: [U8])]) -[FS]> BrowserTestConfig BrowserError! {
    browsers: env_value(env, "JET_TEST_BROWSERS") ?? setting(root, env, "JET_TEST_BROWSER", "browsers") ?? "chromium"
    engines: test_engines(browsers)
    retries: parse_i64(setting(root, env, "JET_TEST_RETRIES", "retries") ?? "") ?? 0
    if retries < 0 || retries > 5 -> return Err(BrowserError{kind: "protocol"})
    timeout_ms: parse_i64(setting(root, env, "JET_TEST_TIMEOUT_MS", "timeout-ms") ?? "") ?? 30000
    validated_timeout: timeout(timeout_ms)
    reporter: parse.lower(setting(root, env, "JET_TEST_REPORTER", "reporter") ?? "text")
    if reporter != "text" && reporter != "json" && reporter != "html" -> return Err(BrowserError{kind: "protocol"})
    artifacts: setting(root, env, "JET_TEST_ARTIFACTS", "artifacts") ?? files.join(root, ".jet/browser-tests/artifacts")
    report_path: setting(root, env, "JET_TEST_REPORT", "report") ?? files.join(root, ".jet/browser-tests/report.json")
    server_url: env_value(env, "JET_TEST_WEB_SERVER_URL") ?? setting(root, env, "JET_BROWSER_TEST_SERVER_URL", "server-url") ?? ""
    command: env_value(env, "JET_TEST_WEB_SERVER_CMD") ?? env_value(env, "JET_BROWSER_TEST_SERVER_CMD") ?? config_value(root, "webServer") ?? config_value(root, "web_server") ?? ""
    reuse: if env_value(env, "JET_TEST_WEB_SERVER_REUSE") != None -> env_bool(env, "JET_TEST_WEB_SERVER_REUSE", false) else -> parse.lower(config_value(root, "server") ?? "") == "reuse"
    cwd: setting(root, env, "JET_TEST_WEB_SERVER_CWD", "server-cwd") ?? root
    filter: setting(root, env, "JET_TEST_FILTER", "filter") ?? ""
    Ok(BrowserTestConfig{
        engines: engines, retries: retries, timeout: validated_timeout,
        filter: filter, reporter: reporter, server_reuse: reuse,
        ui: env_bool(env, "JET_TEST_BROWSER_UI", false),
        visual: env_bool(env, "JET_TEST_BROWSER_VISUAL", false),
        watch: env_bool(env, "JET_TEST_WATCH", false),
        trace_on_retry: env_bool(env, "JET_TEST_TRACE_ON_RETRY", true),
        trace_all: env_bool(env, "JET_TEST_TRACE", false),
        server_url: server_url, server_command: split_command(command),
        server_cwd: cwd, artifact_dir: artifacts, report_path: report_path, source_root: root
    })
}

parse_locked: fn(raw: String, engine: String) -> BrowserLocked BrowserError! {
    current := BrowserLocked{engine: "", version: "", binary: "", protocol: "", size: 0, output_hash: "", driver: "", driver_size: 0}
    in_browser := false
    found := BrowserLocked?{None}
    loop raw_line in parse.split(raw, "\n") {
        line: text.trim(raw_line)
        bytes: line.bytes()
        if bytes.len() == 0 || bytes[0] == (U8{35}) -> next
        if bytes[0] == (U8{91}) {
            if in_browser && current.engine == engine -> found = Val(current)
            in_browser = line == "[[browser]]"
            current = BrowserLocked{engine: "", version: "", binary: "", protocol: "", size: 0, output_hash: "", driver: "", driver_size: 0}
            next
        }
        if !in_browser -> next
        pair: parse.split_once(line, "=")
        if !pair.found -> next
        key: text.trim(pair.head)
        value: strip_quotes(text.trim(pair.tail))
        if key == {
            "engine" -> current.engine = value
            "version" -> current.version = value
            "binary" -> current.binary = value
            "protocol" -> current.protocol = value
            "size" -> current.size = parse_i64(value) ?? return Err(BrowserError{kind: "invalid lock"})
            "output-hash" -> current.output_hash = value
            "driver" -> current.driver = value
            "driver-size" -> current.driver_size = parse_i64(value) ?? return Err(BrowserError{kind: "invalid lock"})
            else -> {}
        }
    }
    if in_browser && current.engine == engine -> found = Val(current)
    entry: found ?? return Err(BrowserError{kind: "missing lock"})
    if entry.engine == "" || entry.binary == "" || entry.protocol == "" || entry.output_hash == "" -> return Err(BrowserError{kind: "invalid lock"})
    Ok(entry)
}

strip_quotes: fn(raw: String) -> String Never! {
    bytes: raw.bytes()
    start := 0
    end := bytes.len()
    loop start < end && bytes[start] == (U8{34}) -> start += 1
    loop end > start && bytes[end - 1] == (U8{34}) -> end -= 1
    out := [U8]{}
    loop i in start..<end -> out.push(bytes[i])
    String.from_bytes(out) ?? ""
}

#Test("browser configuration helpers preserve Rust numeric and command rules") {
    assert_eq(parse_i64("-9223372036854775808"), Val(-9223372036854775808))
    assert_eq(parse_i64("9223372036854775807"), Val(9223372036854775807))
    assert_eq(parse_i64("9223372036854775808"), None)
    assert_eq(parse_i64(" 1"), None)
    assert_eq(parse_i64("+5"), Val(5))
    assert_eq(test_engines(" WEBKIT,chromium,webkit firefox "), [String]{"chromium", "firefox", "webkit"})
    assert_eq(split_command("run '' \"a b\" 'unterminated"), [String]{"run", "a b", "unterminated"})
    assert_eq(source_position(-1), 0)
    assert_eq(source_position(4294967296), 4294967295)
}

#Test("locked browser entries use last match and validate all size fields") {
    raw: "[[browser]]\nengine=firefox\nbinary=first\nprotocol=bidi\noutput-hash=a\n[[browser]]\nengine=firefox\nbinary=\"\"last\"\"\nprotocol=bidi\noutput-hash=b\nsize=-1\n"
    entry: parse_locked(raw, "firefox")
    assert_eq(entry.binary(), "last")
    assert_eq(entry.size, -1)
    if parse_locked("{raw}[[browser]]\nengine=chromium\nsize=overflow\n", "firefox") == {
        .Ok(_) -> panic("invalid size accepted")
        .Err(error) -> assert_eq(error.kind, "invalid lock")
    }
}

#Test("browser handshake checks preserve native first-match and protocol rules") {
    ready: tree.object_from_entries([(key: String, value: Dyn)]{
        (key: "ready", value: Dyn.Bool(true)),
        (key: "message", value: Dyn.Text("ready"))
    })
    assert(browser_true_field(ready, "ready"))
    assert(browser_text_field(ready, "message"))
    assert(!browser_true_field(Dyn.Null, "ready"))
    assert(!browser_text_field(Dyn.Null, "message"))
    duplicate_ready: tree.object_from_entries([(key: String, value: Dyn)]{
        (key: "ready", value: Dyn.Bool(false)),
        (key: "ready", value: Dyn.Bool(true))
    })
    assert(!browser_true_field(duplicate_ready, "ready"))
    caps: tree.object_from_entries([(key: String, value: Dyn)]{
        (key: "goog:cdp", value: Dyn.Bool(false)),
        (key: "goog:cdp", value: Dyn.Bool(true))
    })
    session: tree.object_from_entries([(key: String, value: Dyn)]{
        (key: "sessionId", value: Dyn.Text("")),
        (key: "capabilities", value: caps)
    })
    assert_eq(browser_session_cdp(session) ?? panic("duplicate cdp session reads"), false)
    typed_text: tree.typed_string("typed")
    typed_session: tree.object_from_entries([(key: String, value: Dyn)]{
        (key: "sessionId", value: typed_text),
        (key: "capabilities", value: tree.object_from_entries([(key: String, value: Dyn)]{}))
    })
    assert_eq(browser_session_cdp(typed_session) ?? panic("typed session reads"), false)
    if browser_session_cdp(Dyn.Null) == {
        .Ok(_) -> panic("non-object session accepted")
        .Err(error) -> assert_eq(error.kind, "protocol")
    }
}
