package: {
    name: "core.browser.storage"
    version: "0.0.1"
    edition: "2026"
    description: "Portable browser storage namespaces."
    license: "MIT"
    outputs: {
        storage: .Library{ entry: storage }
    }
}
use world_rt: jet.runtime.testing

// core.browser.storage — browser storage namespaces.

WebStorage: struct {
    ns: String
}

local: fn() -> WebStorage Never! { {ns: "local"} }

session: fn() -> WebStorage Never! { {ns: "session"} }

kind_local: fn() -> String Never! { "local" }

kind_session: fn() -> String Never! { "session" }

// Inside a deterministic world, local and session storage are the World's own
// entries, starting empty, so a world and its tasks never read or change the
// process storage. The World keeps a namespace's entries as length-prefixed
// key and value bytes; an edit installs only over the bytes it read, so a
// concurrent task's edit makes it retry instead of being lost.

// The World's entries for `store`; None outside a World.
__world_entries: fn(store: String) -> [String:String]? {
    raw: world_rt.world_store_load(store) ?? return None
    Val(__world_decode(raw))
}

// Sets `key` to `value` in the World's `store`; false outside a World.
__world_set: fn(store: String, key: String, value: String) -> Bool {
    loop {
        seen: world_rt.world_store_load(store) ?? return false
        entries := __world_decode(seen)
        _: entries.add(key.copy(), value.copy())
        if world_rt.world_store_replace(store, seen, __world_encode(entries)) ?? false -> return true
    }
}

// Removes `key` from the World's `store`; false outside a World.
__world_remove: fn(store: String, key: String) -> Bool {
    loop {
        seen: world_rt.world_store_load(store) ?? return false
        entries := __world_decode(seen)
        _: entries.remove(key)
        if world_rt.world_store_replace(store, seen, __world_encode(entries)) ?? false -> return true
    }
}

// Empties the World's `store`; false outside a World.
__world_clear: fn(store: String) -> Bool {
    loop {
        seen: world_rt.world_store_load(store) ?? return false
        if world_rt.world_store_replace(store, seen, [U8]{}) ?? false -> return true
    }
}

__world_encode: fn(entries: [String:String]) -> [U8] {
    out := [U8]{}
    loop key in entries.keys() {
        __world_put(out, key)
        __world_put(out, entries.get(key) ?? "")
    }
    out
}

__world_put: fn(out: &[U8], text: String) {
    raw: text.bytes()
    n: raw.len()
    out.push(wrapping(U8{n}))
    out.push(wrapping(U8{n >> 8}))
    out.push(wrapping(U8{n >> 16}))
    out.push(wrapping(U8{n >> 24}))
    loop b in raw -> out.push(b)
}

// The entries `__world_encode` wrote; only this file writes the World's bytes.
__world_decode: fn(raw: [U8]) -> [String:String] {
    entries := [String:String]{}
    pos := 0
    loop pos + 4 <= raw.len() {
        key_length: __world_length(raw, pos)
        key: __world_text(raw, pos + 4, key_length)
        pos = pos + 4 + key_length
        value_length: __world_length(raw, pos)
        value: __world_text(raw, pos + 4, value_length)
        pos = pos + 4 + value_length
        _: entries.add(key, value)
    }
    entries
}

__world_length: fn(raw: [U8], pos: Int) -> Int {
    Int{raw[pos]}.bit_or((Int{raw[pos + 1]} << 8)).bit_or((Int{raw[pos + 2]} << 16)).bit_or((Int{raw[pos + 3]} << 24))
}

__world_text: fn(raw: [U8], start: Int, length: Int) -> String {
    bytes := [U8]{}
    loop at in start..<start + length -> bytes.push(raw[at])
    String.from_bytes(bytes) ?? ""
}
