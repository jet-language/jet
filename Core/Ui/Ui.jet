package: {
    name: "core.ui"
    version: "0.0.1"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use {
    core: core
    tui_text: core.tui
    core.term.[Key]
    wayland: __core_ui_wayland
    internal.[checksum, has_nul]
}

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
host: module

UIPreviewDevice: enum {
    Phone
    Tablet
    Desktop
}

UIPreviewKind: enum {
    Preview
    Playground
}

UIIMEMode: enum {
    Native
    Disabled
}

UIAriaRole: enum {
    Button
    Container
    Label
    TextInput
}

UINodeKind: enum {
    Custom
    Text
    Box
    Button
    TextInput
}

Point: struct {
    x: Float
    y: Float
}

Size: struct {
    width: Float
    height: Float
}

Rect: struct {
    x: Float
    y: Float
    width: Float
    height: Float
}

SizeConstraint: struct {
    min_width: Float
    min_height: Float
    max_width: Float
    max_height: Float
}

// The size a preview or playground renders at and the device class it
// stands for; `phone`, `tablet` and `desktop` build the presets.
UIPreviewViewport: struct {
    device: UIPreviewDevice
    width: Int
    height: Int
    scale: Int
}

// A named preview or playground. Its registry keeps `body` and calls it each
// time the preview renders.
UIPreview: struct {
    kind: UIPreviewKind
    name: String
    viewport: UIPreviewViewport
    body: fn() -> UINode
}

// One program's previews or playgrounds: at most 64, each with its own name.
UIPreviewRegistry: struct {
    entries: [UIPreview]
}

#Error
UIPreviewError: enum {
    EmptyName
    TooManyPreviews
    DuplicatePreview(String)
    UnknownPreview(String)
}

InputEvent: enum {
    Key(code: String)
    Resize(size: Size)
}




point: fn(x: Float, y: Float) -> Point Never! { Point{x: x, y: y} }
size: fn(width: Float, height: Float) -> Size Never! {
    Size{width: width, height: height}
}
rect: fn(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {
    Rect{x: x, y: y, width: width, height: height}
}
constraint: fn(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {
    SizeConstraint{min_width: min_width, min_height: min_height, max_width: max_width, max_height: max_height}
}

node: fn(label: String, width: Float, height: Float) -> UINode Never! {
    transfer_node(label, width, height, None, UINodeKind.Custom, [UINode]{}, None)
}

box: fn(children: [UINode]) -> UINode Never! {
    width := Float{0.0}
    height := Float{0.0}
    loop child in children {
        // f64::max ignores a NaN operand; do not let it poison the width.
        if child.width > width -> width = child.width
        height += child.height
    }
    transfer_node("", width, height, Val(UIAriaRole.Container), UINodeKind.Box, children, None)
}

text: fn(value: String) -> UINode Never! {
    width: Float{tui_text.display_width(value)}
    transfer_node(value, width, 1.0, Val(UIAriaRole.Label), UINodeKind.Text, [UINode]{}, None)
}

// A button sized to its label plus two cells of padding on each side. The
// callback form `button(display) { … }` registers its click handler through
// the compiler's retained-closure emission.
button: fn(display: String) -> UINode Never! {
    width: Float{tui_text.display_width(display)} + 4.0
    transfer_node(display, width, 1.0, Val(UIAriaRole.Button), UINodeKind.Button, [UINode]{}, None)
}

// A text input over `state` with its IME mode. The host provider fills the
// IME slot, which the audited node transfer leaves absent.
text_input: fn(state: String, ime: UIIMEMode) -> UINode Never! {
    #Unsafe("Core UI text input: the provider sets the explicitly requested IME slot") {
        return core.ui.__text_input(state, ime)
    }
}

desktop: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Desktop, width: 1280, height: 800, scale: 1} }
phone: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Phone, width: 390, height: 844, scale: 2} }
tablet: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Tablet, width: 834, height: 1119, scale: 2} }

// A preview renders in the desktop viewport unless `viewport:` names another.
preview: fn(name: String, &&body: fn() -> UINode, *, viewport: UIPreviewViewport?{None}) -> UIPreview Never! {
    UIPreview{kind: .Preview, name: name, viewport: viewport ?? desktop(), body: body}
}
playground: fn(name: String, &&body: fn() -> UINode, *, viewport: UIPreviewViewport?{None}) -> UIPreview Never! {
    UIPreview{kind: .Playground, name: name, viewport: viewport ?? desktop(), body: body}
}

// Registers previews and playgrounds alike; each entry's `kind` tells them apart.
previews: fn(&&entries: [UIPreview]) -> UIPreviewRegistry UIPreviewError! { preview_registry(entries) }

impl UIPreviewRegistry {
    // Builds the node tree of the preview named `name`.
    render: fn(self, name: String) -> UINode UIPreviewError! {
        loop entry in self.entries {
            if entry.name == name -> return Ok((entry.body)())
        }
        Err(UIPreviewError.UnknownPreview(name))
    }
}

key_event: fn(code: String) -> InputEvent Never! { InputEvent.Key{code: code} }
resize_event: fn(width: Float, height: Float) -> InputEvent Never! {
    InputEvent.Resize{size: size(width, height)}
}

tui_backend: fn() -[Browser]> TUIBackend Never! {
    #Unsafe("Core creates the real retained terminal renderer through the registered host allocation boundary") {
        return core.ui.__tui_backend()
    }
}
null_backend: fn() -[Browser]> NullBackend Never! {
    #Unsafe("Core creates the real retained null renderer through the registered host allocation boundary") {
        return core.ui.__null_backend()
    }
}

aria_role_button: fn() -> UIAriaRole Never! { UIAriaRole.Button }
aria_role_container: fn() -> UIAriaRole Never! { UIAriaRole.Container }
aria_role_label: fn() -> UIAriaRole Never! { UIAriaRole.Label }
aria_role_text_input: fn() -> UIAriaRole Never! { UIAriaRole.TextInput }

node_accessibility: fn(n: UINode, metadata: UIAccessibility) -> UINode Never! {
    #Unsafe("Core UI accessibility slot transfer: explicitly present validated metadata") {
        return core.ui.__accessibility_transfer(n, metadata, true)
    }
}

node_color: fn(label: String, width: Float, height: Float, color: String) -> UINode Never! {
    transfer_node(label, width, height, Val(UIAriaRole.Label), UINodeKind.Custom, [UINode]{}, Val(color))
}

node_role: fn(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {
    kind := UINodeKind.Custom
    if role == .Button -> kind = UINodeKind.Button
    if role == .TextInput -> kind = UINodeKind.TextInput
    transfer_node(label, width, height, Val(role), kind, [UINode]{}, None)
}

node_shortcut: fn(n: UINode, shortcut: UIShortcut) -> UINode Never! {
    #Unsafe("Core UI shortcut slot transfer: explicitly present validated shortcut") {
        return core.ui.__shortcut_transfer(n, shortcut, true)
    }
}


transfer_node: fn(label: String, width: Float, height: Float, role: UIAriaRole?, kind: UINodeKind, children: [UINode], color: String?) -> UINode Never! {
    // Policy chooses the absent metadata slots here. The wire explicitly
    // carries their six absence bits, rather than asking the host for defaults.
    role_tag := -1
    if role == .Val(value) {
        if value == .Button -> role_tag = 0
        if value == .TextInput -> role_tag = 1
        if value == .Label -> role_tag = 2
        if value == .Container -> role_tag = 3
    }
    kind_tag := 0
    if kind == .Text -> kind_tag = 1
    if kind == .Box -> kind_tag = 2
    if kind == .Button -> kind_tag = 3
    if kind == .TextInput -> kind_tag = 4
    color_present := false
    color_word := ""
    if color == .Val(value) {
        color_present = true
        color_word = value
    }
    #Unsafe("Core UI host slot transfer: audited kind, role, explicit absent slots, and normalized style words") {
        return core.ui.__node_transfer(label, width, height, role_tag, kind_tag, children, color_present, color_word, 63, false, 0, 0, 0, 0, 0)
    }
}

preview_registry: fn(&&entries: [UIPreview]) -> UIPreviewRegistry UIPreviewError! {
    if entries.len() > 64 -> return Err(UIPreviewError.TooManyPreviews)
    loop (index, entry) in entries {
        if entry.name == "" -> return Err(UIPreviewError.EmptyName)
        loop earlier in 0..<index {
            if entries[earlier].name == entry.name -> return Err(UIPreviewError.DuplicatePreview(entry.name.copy()))
        }
    }
    Ok(UIPreviewRegistry{entries: entries})
}

// ---- windows ----------------------------------------------------------
//
// `open` shows a native window; `headless` gives the same Window, Frame
// and event types with no device. A program draws its own RGBA pixels:
//
//     window: ui.open(width: 640, height: 400, title: "demo")
//     loop frame in window.frames() {
//         loop event in frame.events() { … }
//         frame.present(pixels)
//     }
//
// The display paces the frames, one per refresh while the program
// presents; move things as a function of `frame.time`, never per frame.
//
// A window's size is asked for in logical units, the desktop's own;
// frames, pixels and event positions are physical pixels, `frame.scale`
// of them per unit (1.5 on a display scaled to 150%), so what a program
// draws stays sharp on every display. The scale changes when the window
// moves to another display; the frame after carries `.Resize`.
//
// Jet draws the window's frame (title bar, buttons, rounded corners,
// shadow) around the frames unless the display server draws its own;
// frames are the content below the title bar.
//
// The display server comes from the environment: $WAYLAND_DISPLAY.

SIDE_MAX: 16384
ICON_SIDE_MAX: 1024
// A headless window's frames are one 60 Hz refresh apart.
HEADLESS_REFRESH_NS: 16666667

#Error
UIError: enum {
    // The environment names no display server.
    NoDisplay
    // The display server could not be reached.
    Connect(String)
    // The display server broke or refused the protocol.
    Protocol(String)
    // The display server lacks something a window needs.
    Unsupported(String)
    // A window size or pixel buffer is out of range.
    Size(String)
    // An app_id or icon name the program passed is malformed.
    Invalid(String)
}

UIPointerButton: enum {
    Left
    Right
    Middle
    Other(Int)
}

// How the pointer looks over a window: CSS's cursor keywords, in the
// order wp_cursor_shape_v1 numbers them, and `Hidden` (CSS `none`).
UICursor: enum {
    Default
    ContextMenu
    Help
    Pointer
    Progress
    Wait
    Cell
    Crosshair
    Text
    VerticalText
    Alias
    Copy
    Move
    NoDrop
    NotAllowed
    Grab
    Grabbing
    ResizeE
    ResizeN
    ResizeNE
    ResizeNW
    ResizeS
    ResizeSE
    ResizeSW
    ResizeW
    ResizeEW
    ResizeNS
    ResizeNESW
    ResizeNWSE
    ResizeColumn
    ResizeRow
    AllScroll
    ZoomIn
    ZoomOut
    Hidden
}

// A window icon: the name of a desktop theme icon ("" for none), used
// when the desktop has one by that name, and images of it, one per size,
// for when it has not.
UIIcon: struct {
    name: String
    images: [UIIconImage]
}

// A square icon image `side` pixels across: `side` rows of `side` RGBA
// pixels, 4 bytes each, alpha straight (not premultiplied), as a frame's.
UIIconImage: struct {
    side: Int
    pixels: [U8]
}

// What happened since the previous frame. Positions are window pixels
// from the top-left; `Text` is what a key press typed; `Resize` gives
// the new frame size in pixels; `Close` asks the program to close the
// window and ends the frames.
UIEvent: enum {
    KeyDown(Key)
    KeyUp(Key)
    Text(String)
    PointerMove(x: Int, y: Int)
    PointerDown(UIPointerButton)
    PointerUp(UIPointerButton)
    Scroll(dx: Float, dy: Float)
    Resize(width: Int, height: Int)
    Focus(Bool)
    Close
}

// A rectangle of window pixels: `x`, `y` from the top-left.
UIRect: struct {
    x: Int
    y: Int
    width: Int
    height: Int
}

WindowState: struct {
    priv width: Int
    priv height: Int
    priv scale: Float
    priv frames: Int
    priv closed: Bool
    priv failure: UIError?
    priv link: Shared<wayland.Connection>?
    priv script: [[UIEvent]]
    priv checksums: [Int]
    priv cursor: UICursor
}

// A window and its frames. Copies share the one window, which closes when
// the last copy is dropped.
Window: struct {
    priv state: Shared<WindowState>
}

// Opens a window of `width` x `height` logical units, titled `title`,
// on the environment's display server.
open: fn(*, width: Int, height: Int, title: String) -[Env, Net, Time]> Window UIError! {
    if width < 1 || height < 1 || width > SIDE_MAX || height > SIDE_MAX {
        return Err(UIError.Size("a window is 1 to {SIDE_MAX} pixels on each side, not {width}x{height}"))
    }
    if !wayland.available() -> return Err(UIError.NoDisplay)
    link: wayland.connect(width, height, title)
    state: WindowState{
        width: link.width(), height: link.height(), scale: link.scale(), frames: 0, closed: false, failure: None,
        link: Val(shared link), script: [[UIEvent]]{}, checksums: [Int]{}, cursor: UICursor.Default,
    }
    Ok(Window{state: shared state})
}

// A window with no device at scale 1: frame `i` carries `script[i]`, one
// more frame carries `.Close`, and each `present` records a checksum of
// its pixels.
headless: fn(*, width: Int, height: Int, script: [[UIEvent]]) -> Window UIError! {
    if width < 1 || height < 1 || width > SIDE_MAX || height > SIDE_MAX {
        return Err(UIError.Size("a window is 1 to {SIDE_MAX} pixels on each side, not {width}x{height}"))
    }
    state: WindowState{
        width: width, height: height, scale: 1.0, frames: 0, closed: false, failure: None,
        link: None, script: script, checksums: [Int]{}, cursor: UICursor.Default,
    }
    Ok(Window{state: shared state})
}

// How evenly frames reached the screen and how fast input showed.
// `presented` frames were shown; `missed` counts refreshes frames were
// late by against the vblank they aimed at; `discarded` frames were never
// shown (a hidden window). Intervals run present to present; input
// latency runs from an input event to the frame that showed it reaching
// the screen (ms resolution: input times are whole ms). All times are
// nanoseconds.
FrameStats: struct {
    presented: Int
    missed: Int
    discarded: Int
    refresh_ns: Int
    median_ns: Int
    p99_ns: Int
    input_samples: Int
    input_median_ns: Int
    input_p99_ns: Int
    // Present-to-present intervals by refreshes spanned: [0] one
    // refresh (every vblank), [1] two, [2] three, [3] four or more.
    spans: [Int]
}

impl Window {
    // The window's frames, paced by the display alone: one per refresh
    // while the program presents, none while it is idle until input
    // arrives.
    frames: fn(self) -> Frames { Frames{state: self.state.copy()} }

    // The latest frame's size in pixels, and pixels per logical unit.
    width: fn(self) -> Int {
        guard: self.state.guard_read()
        guard.value.width
    }

    height: fn(self) -> Int {
        guard: self.state.guard_read()
        guard.value.height
    }

    scale: fn(self) -> Float {
        guard: self.state.guard_read()
        guard.value.scale
    }

    // Why the display server ended the frames, if it failed.
    failure: fn(self) -> UIError? {
        guard: self.state.guard_read()
        guard.value.failure
    }

    // The FNV-1a checksum of each frame a headless window presented.
    checksums: fn(self) -> [Int] {
        guard: self.state.guard_read()
        guard.value.checksums.copy()
    }

    // How the pointer looks over the window; `.Default` until set.
    cursor: fn(self) -> UICursor {
        guard: self.state.guard_read()
        guard.value.cursor
    }

    // Shows the pointer as `cursor` while it is over the window. A
    // display server without wp_cursor_shape_v1 keeps its own cursor for
    // every shape but `.Hidden`.
    set_cursor: fn(self, cursor: UICursor) {
        guard := self.state.guard_edit()
        guard.value.cursor = cursor
        if guard.value.link == .Val(link) {
            connection := link.guard_edit()
            wayland.set_cursor(connection.value, cursor)
        }
    }

    // Names the application the window belongs to, as a reverse-DNS id
    // ("org.example.Notes"): the desktop matches it to the application's
    // desktop entry for its name, icon and grouping. It is
    // "dev.jet.app" until set; set it before the first present.
    set_app_id: fn(self, app_id: String) UIError! {
        if app_id == "" -> return Err(UIError.Invalid("an app_id is not empty"))
        if has_nul(app_id) -> return Err(UIError.Invalid("an app_id has no NUL byte"))
        guard := self.state.guard_edit()
        if guard.value.link == .Val(link) {
            connection := link.guard_edit()
            wayland.set_app_id(connection.value, app_id)
        }
        Ok()
    }

    // Shows `icon` as the window's icon; one with no name and no images
    // unsets it. A display server without xdg_toplevel_icon_v1 shows
    // the icon of the app_id's desktop entry instead.
    set_icon: fn(self, icon: UIIcon) UIError! -[Env]> {
        if has_nul(icon.name) -> return Err(UIError.Invalid("an icon name has no NUL byte"))
        loop image in icon.images {
            if image.side < 1 || image.side > ICON_SIDE_MAX {
                return Err(UIError.Size("an icon image is 1 to {ICON_SIDE_MAX} pixels across, not {image.side}"))
            }
            if image.pixels.len() != image.side * image.side * 4 {
                return Err(UIError.Size("a {image.side}x{image.side} icon image needs {image.side * image.side * 4} bytes of RGBA, got {image.pixels.len()}"))
            }
        }
        guard := self.state.guard_edit()
        if guard.value.link == .Val(link) {
            connection := link.guard_edit()
            return wayland.set_icon(connection.value, icon)
        }
        Ok()
    }

    // Presentation timing so far; zeros for a headless window or a
    // display server without presentation feedback.
    frame_stats: fn(self) -> FrameStats {
        guard: self.state.guard_read()
        if guard.value.link == .Val(link) {
            connection: link.guard_read()
            return connection.value.frame_stats()
        }
        FrameStats{presented: 0, missed: 0, discarded: 0, refresh_ns: 0, median_ns: 0, p99_ns: 0, input_samples: 0, input_median_ns: 0, input_p99_ns: 0, spans: [Int]{0, 0, 0, 0}}
    }
}

Frames: struct {
    priv state: Shared<WindowState>
}

FrameCursor: struct {
    priv state: Shared<WindowState>
}

impl Frames.Iterable {
    Iter: FrameCursor
    iter: fn(&&self) -> FrameCursor { FrameCursor{state: self.state.copy()} }
}

impl FrameCursor.Iterator {
    Item: Frame
    // The next frame, once it is due; none after the frame that carried
    // `.Close`.
    next: fn(&self) -[Env, Net, Time]> Frame? {
        guard := self.state.guard_edit()
        if guard.value.closed -> return None
        events := [UIEvent]{}
        index: guard.value.frames
        time_ns := 0
        delta_ns := 0
        if guard.value.link == .Val(link) {
            connection := link.guard_edit()
            events = wayland.next_frame(connection.value)
            guard.value.width = connection.value.width()
            guard.value.height = connection.value.height()
            guard.value.scale = connection.value.scale()
            time_ns = connection.value.time_ns()
            delta_ns = connection.value.delta_ns()
            if connection.value.failure() == .Val(failure) -> guard.value.failure = Val(failure)
        } else {
            time_ns = index * HEADLESS_REFRESH_NS
            delta_ns = if index == 0 -> 0 else -> HEADLESS_REFRESH_NS
            if index < guard.value.script.len() -> events = guard.value.script[index].copy() else -> events.push(UIEvent.Close)
            loop event in events {
                if event == .Resize(width, height) {
                    guard.value.width = width
                    guard.value.height = height
                }
            }
        }
        loop event in events {
            if event == .Close -> guard.value.closed = true
        }
        frame: Frame{
            state: self.state.copy(), index: index, width: guard.value.width, height: guard.value.height, scale: guard.value.scale,
            time: Float{time_ns} / 1000000000.0, delta: Float{delta_ns} / 1000000000.0, pending: events,
        }
        guard.value.frames += 1
        Val(frame)
    }
}

// One frame: its number from 0, the size in pixels to draw at and the
// pixels per logical unit, when it is meant to be seen and the events
// since the previous frame. `time` is the vblank this frame is
// predicted to reach the screen at, in seconds since the first frame's,
// and `delta` the seconds since the previous frame's; both advance in
// whole refresh intervals, so motion computed from `time` keeps its
// speed even when a frame is late.
Frame: struct {
    priv state: Shared<WindowState>
    index: Int
    width: Int
    height: Int
    scale: Float
    time: Float
    delta: Float
    priv pending: [UIEvent]
}

impl Frame {
    events: fn(self) -> [UIEvent] { self.pending.copy() }

    // Shows `pixels`: `height` rows of `width` RGBA pixels, 4 bytes each.
    present: fn(self, pixels: [U8]) UIError! -[Env, Net, Time]> {
        self.present_damage(pixels, [UIRect]{UIRect{x: 0, y: 0, width: self.width, height: self.height}})
    }

    // Shows `pixels` where only the `damage` rectangles changed since the
    // previous frame; only they are copied to the display.
    present_damage: fn(self, pixels: [U8], damage: [UIRect]) UIError! -[Env, Net, Time]> {
        if pixels.len() != self.width * self.height * 4 {
            return Err(UIError.Size("frame {self.index} needs {self.width * self.height * 4} bytes for {self.width}x{self.height} RGBA, got {pixels.len()}"))
        }
        guard := self.state.guard_edit()
        if guard.value.link == .Val(link) {
            connection := link.guard_edit()
            return wayland.present(connection.value, pixels, damage)
        }
        guard.value.checksums.push(checksum(pixels))
        Ok()
    }
}

// How a headless frame is recorded: not part of the ui surface.
priv internal: module {
    // FNV-1a, 32-bit.
    checksum: fn(bytes: [U8]) -> Int {
        hash := 2166136261
        loop b in bytes -> hash = (hash.bit_xor(Int.from_u8(b)) * 16777619).bit_and(4294967295)
        hash
    }

    // Whether `text` holds a NUL byte, which a wire string cannot carry.
    has_nul: fn(text: String) -> Bool {
        loop b in text.bytes() {
            if Int.from_u8(b) == 0 -> return true
        }
        false
    }
}

#Test("UI aria role constructors") {
    assert(aria_role_button() == UIAriaRole.Button)
    assert(aria_role_container() == UIAriaRole.Container)
    assert(aria_role_label() == UIAriaRole.Label)
    assert(aria_role_text_input() == UIAriaRole.TextInput)
}

#Test("UI event constructors preserve named payloads") {
    assert(key_event("Enter") == InputEvent.Key{code: "Enter"})
    assert(resize_event(640.0, 480.0) == InputEvent.Resize{size: Size{width: 640.0, height: 480.0}})
}

#Test("UI previews keep their viewport and registries reject unusable names") {
    viewport: phone()
    assert(viewport.device == .Phone && viewport.width == 390 && viewport.height == 844 && viewport.scale == 2)
    assert(preview("card", () -> text("card")).viewport == desktop())
    lab: playground("lab", () -> text("lab"), viewport: tablet())
    assert(lab.kind == UIPreviewKind.Playground && lab.viewport == tablet())
    if previews([preview("card", () -> text("a")), preview("card", () -> text("b"))]) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error == UIPreviewError.DuplicatePreview("card"))
    }
    if previews([playground("", () -> text("blank"))]) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error == UIPreviewError.EmptyName)
    }
    if previews([preview("card", () -> text("card"))]) == {
        .Ok(registry) -> {
            if registry.render("missing") == {
                .Ok(_) -> assert(false)
                .Err(error) -> assert(error == UIPreviewError.UnknownPreview("missing"))
            }
            if registry.render("card") == {
                .Ok(_) -> {}
                .Err(_) -> assert(false)
            }
        }
        .Err(_) -> assert(false)
    }
}
