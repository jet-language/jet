package: {
    name: "core.ui"
    version: "0.0.1"
    edition: "2026"
    description: "Immediate-mode UI nodes, previews, and host dialogs."
    license: "MIT"
    outputs: {
        ui: .Library{ entry: ui }
    }
}
use {
    core: core
    tui_text: core.tui
}

// core.ui — one portable tree consumed by every backend.
//
// Geometry and node values are deliberately backend-neutral.  Opening a
// window, painting, and event delivery remain provider operations; these
// constructors only build values that can be measured and rendered.
host: module

UIPreviewDevice: enum {
    Phone
    Tablet
    Desktop
}

UIPreviewKind: enum {
    Preview
    Playground
}

UIIMEMode: enum {
    Native
    Disabled
}

UIAriaRole: enum {
    Button
    Container
    Label
    TextInput
}

UINodeKind: enum {
    Custom
    Text
    Box
    Button
    TextInput
}

Point: struct {
    x: Float
    y: Float
}

Size: struct {
    width: Float
    height: Float
}

Rect: struct {
    x: Float
    y: Float
    width: Float
    height: Float
}

SizeConstraint: struct {
    min_width: Float
    min_height: Float
    max_width: Float
    max_height: Float
}

// The size a preview or playground renders at and the device class it
// stands for; `phone`, `tablet` and `desktop` build the presets.
UIPreviewViewport: struct {
    device: UIPreviewDevice
    width: Int
    height: Int
    scale: Int
}

// A named preview or playground. Its registry keeps `body` and calls it each
// time the preview renders.
UIPreview: struct {
    kind: UIPreviewKind
    name: String
    viewport: UIPreviewViewport
    body: fn() -> UINode
}

// One program's previews or playgrounds: at most 64, each with its own name.
UIPreviewRegistry: struct {
    entries: [UIPreview]
}

#Error
UIPreviewError: enum {
    EmptyName
    TooManyPreviews
    DuplicatePreview(String)
    UnknownPreview(String)
}

InputEvent: enum {
    Key(code: String)
    Resize(size: Size)
}




point: fn(x: Float, y: Float) -> Point Never! { Point{x: x, y: y} }
size: fn(width: Float, height: Float) -> Size Never! {
    Size{width: width, height: height}
}
rect: fn(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {
    Rect{x: x, y: y, width: width, height: height}
}
constraint: fn(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {
    SizeConstraint{min_width: min_width, min_height: min_height, max_width: max_width, max_height: max_height}
}

node: fn(label: String, width: Float, height: Float) -> UINode Never! {
    transfer_node(label, width, height, None, UINodeKind.Custom, [UINode]{}, None)
}

box: fn(children: [UINode]) -> UINode Never! {
    width := Float{0.0}
    height := Float{0.0}
    loop child in children {
        // f64::max ignores a NaN operand; do not let it poison the width.
        if child.width > width -> width = child.width
        height += child.height
    }
    transfer_node("", width, height, Val(UIAriaRole.Container), UINodeKind.Box, children, None)
}

text: fn(value: String) -> UINode Never! {
    width: Float{tui_text.display_width(value)}
    transfer_node(value, width, 1.0, Val(UIAriaRole.Label), UINodeKind.Text, [UINode]{}, None)
}

// A button sized to its label plus two cells of padding on each side. The
// callback form `button(display) { … }` registers its click handler through
// the compiler's retained-closure emission.
button: fn(display: String) -> UINode Never! {
    width: Float{tui_text.display_width(display)} + 4.0
    transfer_node(display, width, 1.0, Val(UIAriaRole.Button), UINodeKind.Button, [UINode]{}, None)
}

// A text input over `state` with its IME mode. The host provider fills the
// IME slot, which the audited node transfer leaves absent.
text_input: fn(state: String, ime: UIIMEMode) -> UINode Never! {
    #Unsafe("Core UI text input: the provider sets the explicitly requested IME slot") {
        return core.ui.__text_input(state, ime)
    }
}

desktop: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Desktop, width: 1280, height: 800, scale: 1} }
phone: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Phone, width: 390, height: 844, scale: 2} }
tablet: fn() -> UIPreviewViewport Never! { UIPreviewViewport{device: .Tablet, width: 834, height: 1119, scale: 2} }

// A preview renders in the desktop viewport unless `viewport:` names another.
preview: fn(name: String, &&body: fn() -> UINode, *, viewport: UIPreviewViewport?{None}) -> UIPreview Never! {
    UIPreview{kind: .Preview, name: name, viewport: viewport ?? desktop(), body: body}
}
playground: fn(name: String, &&body: fn() -> UINode, *, viewport: UIPreviewViewport?{None}) -> UIPreview Never! {
    UIPreview{kind: .Playground, name: name, viewport: viewport ?? desktop(), body: body}
}

previews: fn(&&entries: [UIPreview]) -> UIPreviewRegistry UIPreviewError! { preview_registry(entries) }
playgrounds: fn(&&entries: [UIPreview]) -> UIPreviewRegistry UIPreviewError! { preview_registry(entries) }

impl UIPreviewRegistry {
    // Builds the node tree of the preview named `name`.
    render: fn(self, name: String) -> UINode UIPreviewError! {
        loop entry in self.entries {
            if entry.name == name -> return Ok((entry.body)())
        }
        Err(UIPreviewError.UnknownPreview(name))
    }
}

key_event: fn(code: String) -> InputEvent Never! { InputEvent.Key{code: code} }
resize_event: fn(width: Float, height: Float) -> InputEvent Never! {
    InputEvent.Resize{size: size(width, height)}
}


gtk_backend: fn() -[Browser]> GtkBackend Never! {
    #Unsafe("Core creates the real retained GTK renderer through the registered host allocation boundary") {
        return core.ui.__gtk_backend()
    }
}
tui_backend: fn() -[Browser]> TUIBackend Never! {
    #Unsafe("Core creates the real retained terminal renderer through the registered host allocation boundary") {
        return core.ui.__tui_backend()
    }
}
null_backend: fn() -[Browser]> NullBackend Never! {
    #Unsafe("Core creates the real retained null renderer through the registered host allocation boundary") {
        return core.ui.__null_backend()
    }
}

aria_role_button: fn() -> UIAriaRole Never! { UIAriaRole.Button }
aria_role_container: fn() -> UIAriaRole Never! { UIAriaRole.Container }
aria_role_label: fn() -> UIAriaRole Never! { UIAriaRole.Label }
aria_role_text_input: fn() -> UIAriaRole Never! { UIAriaRole.TextInput }

node_accessibility: fn(n: UINode, metadata: UIAccessibility) -> UINode Never! {
    #Unsafe("Core UI accessibility slot transfer: explicitly present validated metadata") {
        return core.ui.__accessibility_transfer(n, metadata, true)
    }
}

node_color: fn(label: String, width: Float, height: Float, color: String) -> UINode Never! {
    transfer_node(label, width, height, Val(UIAriaRole.Label), UINodeKind.Custom, [UINode]{}, Val(color))
}

node_role: fn(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {
    kind := UINodeKind.Custom
    if role == .Button -> kind = UINodeKind.Button
    if role == .TextInput -> kind = UINodeKind.TextInput
    transfer_node(label, width, height, Val(role), kind, [UINode]{}, None)
}

node_shortcut: fn(n: UINode, shortcut: UIShortcut) -> UINode Never! {
    #Unsafe("Core UI shortcut slot transfer: explicitly present validated shortcut") {
        return core.ui.__shortcut_transfer(n, shortcut, true)
    }
}


transfer_node: fn(label: String, width: Float, height: Float, role: UIAriaRole?, kind: UINodeKind, children: [UINode], color: String?) -> UINode Never! {
    // Policy chooses the absent metadata slots here. The wire explicitly
    // carries their six absence bits, rather than asking the host for defaults.
    role_tag := -1
    if role == .Val(value) {
        if value == .Button -> role_tag = 0
        if value == .TextInput -> role_tag = 1
        if value == .Label -> role_tag = 2
        if value == .Container -> role_tag = 3
    }
    kind_tag := 0
    if kind == .Text -> kind_tag = 1
    if kind == .Box -> kind_tag = 2
    if kind == .Button -> kind_tag = 3
    if kind == .TextInput -> kind_tag = 4
    color_present := false
    color_word := ""
    if color == .Val(value) {
        color_present = true
        color_word = value
    }
    #Unsafe("Core UI host slot transfer: audited kind, role, explicit absent slots, and normalized style words") {
        return core.ui.__node_transfer(label, width, height, role_tag, kind_tag, children, color_present, color_word, 63, false, 0, 0, 0, 0, 0)
    }
}

preview_registry: fn(&&entries: [UIPreview]) -> UIPreviewRegistry UIPreviewError! {
    if entries.len() > 64 -> return Err(UIPreviewError.TooManyPreviews)
    loop (index, entry) in entries {
        if entry.name == "" -> return Err(UIPreviewError.EmptyName)
        loop earlier in 0..<index {
            if entries[earlier].name == entry.name -> return Err(UIPreviewError.DuplicatePreview(entry.name.copy()))
        }
    }
    Ok(UIPreviewRegistry{entries: entries})
}

#Test("UI aria role constructors") {
    assert(aria_role_button() == UIAriaRole.Button)
    assert(aria_role_container() == UIAriaRole.Container)
    assert(aria_role_label() == UIAriaRole.Label)
    assert(aria_role_text_input() == UIAriaRole.TextInput)
}

#Test("UI event constructors preserve named payloads") {
    assert(key_event("Enter") == InputEvent.Key{code: "Enter"})
    assert(resize_event(640.0, 480.0) == InputEvent.Resize{size: Size{width: 640.0, height: 480.0}})
}

#Test("UI previews keep their viewport and registries reject unusable names") {
    assert(phone() == UIPreviewViewport{device: .Phone, width: 390, height: 844, scale: 2})
    assert(preview("card", () -> text("card")).viewport == desktop())
    lab: playground("lab", () -> text("lab"), viewport: tablet())
    assert(lab.kind == UIPreviewKind.Playground && lab.viewport == tablet())
    if previews([preview("card", () -> text("a")), preview("card", () -> text("b"))]) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error == UIPreviewError.DuplicatePreview("card"))
    }
    if playgrounds([playground("", () -> text("blank"))]) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error == UIPreviewError.EmptyName)
    }
    if previews([preview("card", () -> text("card"))]) == {
        .Ok(registry) -> {
            if registry.render("missing") == {
                .Ok(_) -> assert(false)
                .Err(error) -> assert(error == UIPreviewError.UnknownPreview("missing"))
            }
            if registry.render("card") == {
                .Ok(_) -> {}
                .Err(_) -> assert(false)
            }
        }
        .Err(_) -> assert(false)
    }
}
