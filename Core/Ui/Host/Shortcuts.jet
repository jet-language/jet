use {
    core :: core
    core.ui.host.[UIHostError, UIShortcut, UIShortcutBinding, UIShortcutDispatch]
}

// core.ui.host.shortcuts — the process's shortcut registry. Core owns it; the
// provider only answers whether shortcuts are available (capability code 4).
struct ShortcutRegistry {
    bindings: [UIShortcutBinding]
}

SHORTCUTS :: shared ShortcutRegistry{bindings: [UIShortcutBinding]{}}

fn binding(shortcut: UIShortcut, action: String) -> UIShortcutBinding UIHostError! {
    if action.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut action must not be empty"))
    Ok(UIShortcutBinding{shortcut: shortcut, action: action, node: None})
}

// Registering the same shortcut and action again is a no-op; the same
// shortcut for a different action conflicts with the first.
fn register(binding: UIShortcutBinding) -[IO]> UIShortcutBinding UIHostError! {
    if !core.ui.host.__capability(4) -> return Err(UIHostError.CapabilityUnavailable{capability: "Shortcuts"})
    if binding.action.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut action must not be empty"))
    loop existing in SHORTCUTS.bindings {
        if existing.shortcut != binding.shortcut -> next
        if existing.action == binding.action -> return Ok(existing.copy())
        return Err(UIHostError.ShortcutConflict{shortcut: binding.shortcut.copy(), existing_action: existing.action.copy()})
    }
    &SHORTCUTS.bindings.push(binding.copy())
    Ok(binding)
}

fn dispatch(shortcut: UIShortcut) -[IO]> UIShortcutDispatch UIHostError! {
    if !core.ui.host.__capability(4) -> return Err(UIHostError.CapabilityUnavailable{capability: "Shortcuts"})
    loop existing in SHORTCUTS.bindings {
        if existing.shortcut == shortcut -> return Ok(UIShortcutDispatch.Dispatched(existing.copy()))
    }
    Ok(UIShortcutDispatch.Unhandled)
}

#Test("UI shortcut bindings preserve action bytes and absent node identity") {
    key :: core.ui.host.shortcut(" A ", core.ui.host.UIShortcutModifiers{}) ?? panic("valid shortcut rejected")
    bound :: binding(key, " ") ?? panic("space action rejected")
    assert(bound.action == " " && bound.node == None && bound.shortcut == key)
    if binding(key, "") == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "shortcut action must not be empty")
        else -> panic("wrong shortcut binding error")
    } else { panic("empty action accepted") }
}
