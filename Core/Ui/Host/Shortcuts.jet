use {
    core: core
    core.ui.host.[UIHostError, UIShortcut, UIShortcutBinding, UIShortcutDispatch, UIShortcutModifiers]
    internal.[dispatched, key_claims, lookup, shortcut_failure]
}

// core.ui.host.shortcuts — the process's shortcut registry. Core owns it and
// its matching; the provider answers whether shortcuts are available
// (capability code 4), takes key claims, and queues claimed key events.
//
// Modifier bits: Control 1, Alt 2, Shift 4, Meta 8, and 16 for the logical
// platform command (`UIShortcut.cmd`), which is Control or Meta by platform.
ShortcutRegistry: struct {
    bindings: [UIShortcutBinding]
}

SHORTCUTS: shared ShortcutRegistry{bindings: [UIShortcutBinding]{}}

COMMAND: 16

binding: fn(shortcut: UIShortcut, action: String) -> UIShortcutBinding UIHostError! {
    if action.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut action must not be empty"))
    Ok(UIShortcutBinding{shortcut: shortcut, action: action, node: None})
}

// Registering the same shortcut and action again is a no-op; the same
// shortcut for a different action conflicts with the first. A new binding
// claims its key from the provider first, so a browser page
// cancels the default action of bound keys only.
register: fn(binding: UIShortcutBinding) -[IO]> UIShortcutBinding UIHostError! {
    if !core.ui.host.__capability(4) -> return Err(UIHostError.CapabilityUnavailable{capability: "Shortcuts"})
    if binding.action.len() == 0 -> return Err(UIHostError.InvalidRequest("shortcut action must not be empty"))
    loop existing in SHORTCUTS.bindings {
        if existing.shortcut != binding.shortcut -> next
        if existing.action == binding.action -> return Ok(existing.copy())
        return Err(UIHostError.ShortcutConflict{shortcut: binding.shortcut.copy(), existing_action: existing.action.copy()})
    }
    loop claim in key_claims(binding.shortcut) {
        if !core.ui.host.__key_claim(claim) -> return Err(shortcut_failure("the provider could not claim key `{claim}`"))
    }
    SHORTCUTS.bindings.push(binding.copy())
    Ok(binding)
}

dispatch: fn(shortcut: UIShortcut) -[IO]> UIShortcutDispatch UIHostError! {
    if !core.ui.host.__capability(4) -> return Err(UIHostError.CapabilityUnavailable{capability: "Shortcuts"})
    Ok(dispatched(lookup(shortcut)))
}

// One raw key event from the provider's shortcut queue (queue 2), a provider
// record of target, the browser key value, and the pressed modifier mask. A
// provider queues only keys a registration claimed. A key pressed with
// exactly one of Control and Meta also matches a command binding. An empty
// record is the provider's mark that its queue overflowed and dropped events.
poll: fn() -[IO]> UIShortcutDispatch? UIHostError! {
    if !core.ui.host.__capability(4) -> return Err(UIHostError.CapabilityUnavailable{capability: "Shortcuts"})
    raw: core.ui.host.__event_pop(2) ?? return Ok(None)
    if raw.len() == 0 -> return Err(UIHostError.QueueFull{service: "Shortcuts"})
    fields: core.ui.host.provider_record_fields(raw) ?? return Err(shortcut_failure("a key event is not a provider record"))
    if fields.len() != 3 -> return Err(shortcut_failure("a key event has 3 fields, not {fields.len()}"))
    mask: Int.parse(fields[2]) ?? return Err(shortcut_failure("key modifiers `{fields[2]}` are not a number"))
    if mask < 0 || mask > 15 -> return Err(shortcut_failure("key modifiers `{fields[2]}` are outside the Control, Alt, Shift and Meta bits"))
    pressed: core.ui.host.shortcut(fields[1], UIShortcutModifiers{bits: mask})
    if lookup(pressed) == .Val(exact) -> return Ok(Val(UIShortcutDispatch.Dispatched(exact)))
    control: mask.bit_and(1) != 0
    meta: mask.bit_and(8) != 0
    if control == meta -> return Ok(Val(UIShortcutDispatch.Unhandled))
    command: mask - (if control -> 1 else -> 8) + COMMAND
    Ok(Val(dispatched(lookup(UIShortcut{key: pressed.key.copy(), modifiers: UIShortcutModifiers{bits: command}}))))
}

// Registry matching and provider claims: not part of the shortcuts surface.
priv internal: module {
    lookup: fn(shortcut: UIShortcut) -> UIShortcutBinding? Never! {
        loop existing in SHORTCUTS.bindings {
            if existing.shortcut == shortcut -> return Val(existing.copy())
        }
        None
    }

    dispatched: fn(found: UIShortcutBinding?) -> UIShortcutDispatch Never! {
        if found == .Val(binding) -> return UIShortcutDispatch.Dispatched(binding)
        UIShortcutDispatch.Unhandled
    }

    // The provider claims of a shortcut: `<mask>:<key>` for each modifier mask a
    // browser key event can carry for it. A command shortcut claims its Control
    // and its Meta form, since the page's platform is the browser's.
    key_claims: fn(shortcut: UIShortcut) -> [String] Never! {
        bits: shortcut.modifiers.bits
        base: bits.bit_and(15)
        if bits.bit_and(COMMAND) == 0 -> return [String]{"{base}:{shortcut.key}"}
        control: if base.bit_and(1) == 0 -> base + 1 else -> base
        meta: if base.bit_and(8) == 0 -> base + 8 else -> base
        [String]{"{control}:{shortcut.key}", "{meta}:{shortcut.key}"}
    }

    shortcut_failure: fn(message: String) -> UIHostError Never! {
        UIHostError.HostFailure{service: "Shortcuts", message: message}
    }
}

#Test("UI shortcut bindings preserve action bytes and absent node identity") {
    key: core.ui.host.shortcut(" A ", core.ui.host.UIShortcutModifiers{}) ?? panic("valid shortcut rejected")
    bound: binding(key, " ") ?? panic("space action rejected")
    assert(bound.action == " " && bound.node == None && bound.shortcut == key)
    if binding(key, "") == .Err(error) {
        if error == .InvalidRequest(message) -> assert(message == "shortcut action must not be empty")
        else -> panic("wrong shortcut binding error")
    } else { panic("empty action accepted") }
}

#Test("a command shortcut claims its Control and Meta forms; others claim their own mask") {
    assert_eq(key_claims(UIShortcut.cmd("s")), [String]{"1:s", "8:s"})
    shifted: UIShortcut{key: "k", modifiers: UIShortcutModifiers{bits: 4}}
    assert_eq(key_claims(shifted), [String]{"4:k"})
    command_shift: UIShortcut{key: "p", modifiers: UIShortcutModifiers{bits: 20}}
    assert_eq(key_claims(command_shift), [String]{"5:p", "12:p"})
}
