use {
    core :: core
    core.ui.host.[UIHostError, UINodeID, UITextRange]
}

// core.ui.host.ime — typed input-method editor events.
enum UIIMEPhase {
    Start
    Update
    Commit
    Cancel
}

struct UIIMEComposition {
    text: String
    selection: UITextRange
    marked: UITextRange?
}

struct UIIMEEvent {
    target: UINodeID
    phase: UIIMEPhase
    composition: UIIMEComposition?
}

// One raw event from the provider's IME queue (queue 0, capability code 2), a
// provider record of target, the browser event type (`compositionstart`,
// `compositionupdate`, `compositionend`), text, selection start and end, and
// the marked range's start and end. Offsets count characters (Unicode scalars)
// of the text. An empty selection is a caret after the text; an empty marked
// range is no marked range. A `compositionend` with no text cancels the
// composition and carries none. An empty record is the provider's mark that
// its queue overflowed and dropped events.
fn poll() -[IO]> UIIMEEvent? UIHostError! {
    if !core.ui.host.__capability(2) -> return Err(UIHostError.CapabilityUnavailable{capability: "IME"})
    raw :: core.ui.host.__event_pop(0) ?? return Ok(None)
    if raw.len() == 0 -> return Err(UIHostError.QueueFull{service: "IME"})
    fields :: core.ui.host.provider_record_fields(raw) ?? return Err(ime_failure("an IME event is not a provider record"))
    if fields.len() != 7 -> return Err(ime_failure("an IME event has 7 fields, not {fields.len()}"))
    text :: fields[2].copy()
    phase :: ime_phase(fields[1], text.len() == 0)
    target :: UINodeID{value: fields[0].copy()}
    if phase == .Cancel -> return Ok(Val(UIIMEEvent{target: target, phase: phase, composition: None}))
    caret := 0
    loop byte in text.bytes() {
        if Int.from_u8(byte).bit_and(192) != 128 -> caret += 1
    }
    selection :: if fields[3].len() == 0 && fields[4].len() == 0 -> UITextRange{start: caret, end: caret} else -> UITextRange{start: ime_offset(fields[3]), end: ime_offset(fields[4])}
    marked :: if fields[5].len() == 0 && fields[6].len() == 0 -> UITextRange?{None} else -> Val(UITextRange{start: ime_offset(fields[5]), end: ime_offset(fields[6])})
    Ok(Val(UIIMEEvent{target: target, phase: phase, composition: Val(UIIMEComposition{text: text, selection: selection, marked: marked})}))
}

fn ime_phase(event: String, empty: Bool) -> UIIMEPhase UIHostError! {
    if event == "compositionstart" -> return Ok(UIIMEPhase.Start)
    if event == "compositionupdate" -> return Ok(UIIMEPhase.Update)
    if event == "compositionend" && empty -> return Ok(UIIMEPhase.Cancel)
    if event == "compositionend" -> return Ok(UIIMEPhase.Commit)
    Err(ime_failure("unknown IME event `{event}`"))
}

fn ime_offset(text: String) -> Int UIHostError! {
    offset :: Int.parse(text) ?? return Err(ime_failure("IME offset `{text}` is not a number"))
    if offset < 0 -> return Err(ime_failure("IME offset `{text}` is negative"))
    Ok(offset)
}

fn ime_failure(message: String) -> UIHostError Never! {
    UIHostError.HostFailure{service: "IME", message: message}
}
