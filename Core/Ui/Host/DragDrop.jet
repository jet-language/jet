use {
    core :: core
    core.ui.host.[UIGrantedPath, UIHostError, UINodeID]
}

// core.ui.host.drag_drop — typed file/text drop events.
enum UIDragPhase {
    Enter
    Over
    Drop
    Leave
    Cancel
}

enum UIDragOperation {
    Copy
    Move
    Link
}

enum UIDropItem {
    Text(value: String)
    URI(value: String)
    File(value: UIGrantedPath)
}

struct UIDragEvent {
    target: UINodeID
    phase: UIDragPhase
    operation: UIDragOperation
    items: [UIDropItem]
}

// One raw event from the provider's drag/drop queue (queue 1, capability
// code 3), a provider record of target, the browser event type (`dragenter`,
// `dragover`, `drop`, `dragleave`), the drop effect (`copy`, `move`, `link`),
// and the dropped `text/plain` and `text/uri-list` data. Nonempty plain text
// is one text item; each uri-list line that is neither empty nor a `#`
// comment is one URI item. A browser item has no native path, so a provider
// never sends a file. An empty record is the provider's mark that its queue
// overflowed and dropped events.
fn poll() -[IO]> UIDragEvent? UIHostError! {
    if !core.ui.host.__capability(3) -> return Err(UIHostError.CapabilityUnavailable{capability: "DragDrop"})
    raw :: core.ui.host.__event_pop(1) ?? return Ok(None)
    if raw.len() == 0 -> return Err(UIHostError.QueueFull{service: "DragDrop"})
    fields :: core.ui.host.provider_record_fields(raw) ?? return Err(drag_failure("a drag/drop event is not a provider record"))
    if fields.len() != 5 -> return Err(drag_failure("a drag/drop event has 5 fields, not {fields.len()}"))
    phase :: drag_phase(fields[1])
    operation :: drag_operation(fields[2])
    items := [UIDropItem]{}
    if fields[3].len() > 0 -> &items.push(UIDropItem.Text{value: fields[3].copy()})
    loop line in fields[4].split("\n") {
        uri :: line.trim()
        if uri.len() > 0 && !uri.starts_with("#") -> &items.push(UIDropItem.URI{value: uri.copy()})
    }
    Ok(Val(UIDragEvent{target: UINodeID{value: fields[0].copy()}, phase: phase, operation: operation, items: items}))
}

fn drag_phase(event: String) -> UIDragPhase UIHostError! {
    if event == "dragenter" -> return Ok(UIDragPhase.Enter)
    if event == "dragover" -> return Ok(UIDragPhase.Over)
    if event == "drop" -> return Ok(UIDragPhase.Drop)
    if event == "dragleave" -> return Ok(UIDragPhase.Leave)
    Err(drag_failure("unknown drag/drop event `{event}`"))
}

fn drag_operation(drop_effect: String) -> UIDragOperation UIHostError! {
    if drop_effect == "copy" -> return Ok(UIDragOperation.Copy)
    if drop_effect == "move" -> return Ok(UIDragOperation.Move)
    if drop_effect == "link" -> return Ok(UIDragOperation.Link)
    Err(drag_failure("unknown drag/drop operation `{drop_effect}`"))
}

fn drag_failure(message: String) -> UIHostError Never! {
    UIHostError.HostFailure{service: "DragDrop", message: message}
}
