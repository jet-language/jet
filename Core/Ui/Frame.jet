use {
    math: core.math
    text: core.text
    font: core.ui.font
    core.ui.[UIRect]
}
// __core_ui_frame — the window frame Jet draws for itself (client-side
// decorations), a private part of core.ui.
//
// Backend-neutral: it paints the title bar and the soft shadow ring around
// a window into premultiplied ARGB8888 pixels (bytes B, G, R, A, as wl_shm
// ARGB8888 is on every little-endian target), says which part of the frame
// a point is on, and holds the frame's measures. A backend places the
// pieces; on Wayland they are subsurfaces around the program's content.
// Shapes are signed-distance coverage painted with core.ui.font's `blend`,
// source-over in sRGB like the title text and every core.ui surface.
//
// The look is quiet and stays out of the way: a 34-unit header on the
// content's own surface, a small muted title in the regular face centered
// where it fits, three thin muted glyphs that take a soft background under
// the pointer (Jet red only for close), squircle corners, one 1-unit
// outline a step lighter than the surface, and a soft shadow. It is dark
// on Jet black unless the desktop asks for light (org.freedesktop.appearance's
// color-scheme through the settings portal); either way the keyboard focus
// ring is the theme's ink. The app's icon belongs to the taskbar
// (xdg-toplevel-icon-v1), not the header. The buttons are laid out in whole
// pixels at every scale (see `button_box` and `button_glyph`).
//
// Coordinates: logical units have the window's top-left corner (the
// header's) at 0, 0; pixels are logical units times the scale, given in
// 120ths as wp_fractional_scale_v1 gives it.

// The measures, in logical units. The window's corners are squircles
// (superellipses of degree 4) RADIUS across.
HEADER: 34
RADIUS: 10
// Room for the shadow on each side of the window.
MARGIN: 64
// How far outside the window's edge the pointer still grips it to resize,
// and how near a corner an edge grip resizes both ways.
GRIP: 8
CORNER_GRIP: 20
// The buttons' soft squares under the pointer. The close square is
// BUTTON_INSET in from the header's top and from the window's right edge,
// so it is centered down the header (8 + 18 + 8 = 34); each next one is a
// step further left, 10 units apart. The hit regions are a step wide and
// the header high, side by side from the window's edge: 28 x 34 units,
// each holding its square.
BUTTON_SIDE: 18
BUTTON_INSET: 8
BUTTON_STEP: 28
// For a finger (`look.coarse`) the buttons spread out: each hit region is
// a step wide and the header high, 46 x 34 units.
BUTTON_STEP_COARSE: 46
// The button glyphs: each fits a box this many units across, drawn with a
// one-unit stroke.
GLYPH: 10
// The title's room starts this far in from the left edge, and ends this
// far before the minimize button's square.
TITLE_INSET: 10
TITLE_GAP: 8
// The keyboard focus ring: a square line this wide, this far outside the
// focused button's square.
FOCUS_GAP: 2
FOCUS_LINE: Float{1.5}
// The title's size, in the regular face.
TITLE_SIZE: Float{13.0}
// `button_index` of no button.
NO_BUTTON: -1
// The smallest window: room for a title and the spread-out buttons across,
// and the shadow kit's box down.
MIN_WIDTH: 176
MIN_HEIGHT: 56
// Two presses on the title this close together, in milliseconds, toggle
// maximizing.
DOUBLE_CLICK_MS: 400
// The shadow kit's window, in logical units: just big enough that every
// side has a straight run past its corners (2 * RADIUS + 2 wide, and the
// longest shadow drop, 12, on each side of that tall).
KIT_BOX_WIDTH: 26
KIT_BOX_HEIGHT: 50

// xdg_toplevel's resize edges, which these bits make: top 1, bottom 2,
// left 4, right 8, and their sums for the corners.
EDGE_TOP: 1
EDGE_BOTTOM: 2
EDGE_LEFT: 4
EDGE_RIGHT: 8

// The colors of one theme, 0xAARRGGBB with straight alpha.
Palette: struct {
    header_active: Int
    header_inactive: Int
    text_active: Int
    // An unfocused window is still operable, so its title stays readable
    // (4.5:1 on its header) rather than taking the disabled-text exception.
    text_inactive: Int
    // A glyph under the pointer.
    glyph_hover: Int
    // The line just outside the window's edge.
    outline: Int
    button_idle: Int
    button_hover: Int
    button_press: Int
    close_hover: Int
    close_press: Int
    // The keyboard focus ring.
    focus: Int
}

// The dark theme, the default: the header on Jet black, a muted gray title
// and glyphs, a quiet square a step lighter under the pointer, Jet red only
// for the close button under it, and a light focus ring.
dark_palette: fn() -> Palette {
    Palette{
        header_active: 0xFF0B0B0D, header_inactive: 0xFF0B0B0D, text_active: 0xFF9A9AA4, text_inactive: 0xFF80808A,
        glyph_hover: 0xFFECECF0, outline: 0xFF1E1E22, button_idle: 0x00000000, button_hover: 0xFF1D1D21, button_press: 0xFF27272C,
        close_hover: 0xFFE8232A, close_press: 0xFFE8232A, focus: 0xFFECECF0,
    }
}

// The light theme, when the desktop prefers light: the same quiet layout
// on a pale header, with a dark focus ring and Jet red only for close.
light_palette: fn() -> Palette {
    Palette{
        header_active: 0xFFF4F4F6, header_inactive: 0xFFF4F4F6, text_active: 0xFF5A5A63, text_inactive: 0xFF66666F,
        glyph_hover: 0xFF1C1C21, outline: 0xFFD6D6DC, button_idle: 0x00000000, button_hover: 0xFFE8E8EC, button_press: 0xFFDEDEE3,
        close_hover: 0xFFE8232A, close_press: 0xFFE8232A, focus: 0xFF1C1C21,
    }
}

palette: fn(look: FrameLook) -> Palette { if look.dark -> dark_palette() else -> light_palette() }

SHADOW_ACTIVE: 0x59000000
SHADOW_INACTIVE: 0x2E000000
SHADOW_NEAR: 0x24000000
WHITE: 0xFFFFFFFF

// A title-bar button.
FrameButton: enum {
    Nothing
    Minimize
    Maximize
    Close
}

// The part of the frame a point is on. `Edge` carries xdg_toplevel's
// resize edge.
FrameSpot: enum {
    Outside
    Content
    Title
    Button(FrameButton)
    Edge(Int)
}

// What the header shows. `square` drops the rounded corners and the
// shadow (a maximized, tiled or fullscreen window); `maximized` picks the
// restore glyph. `coarse` spreads the buttons for a finger: the latest
// press on the frame was a touch. `focus` is the button with the keyboard
// focus, ringed (`Nothing` while the content has it). `dark` picks the
// dark theme, else the light one.
FrameLook: struct {
    title: String
    active: Bool
    square: Bool
    maximized: Bool
    coarse: Bool
    hover: FrameButton
    pressed: FrameButton
    focus: FrameButton
    dark: Bool
}

// The shadow and outline of a small window, `box_width` by `box_height`
// pixels with `margin` pixels around it, for one scale, activation and
// theme. Any larger window's ring is this one's corners with its straight
// middle rows and columns repeated: see `kit_index`.
Kit: struct {
    active: Bool
    dark: Bool
    scale120: Int
    margin: Int
    box_width: Int
    box_height: Int
    width: Int
    height: Int
    pixels: [U8]
}

// A row of a window's shadow ring: `left`'s bytes, `fill_count` copies of
// the pixel `fill` (a little-endian ARGB8888 word), then `right`'s bytes.
KitRow: struct {
    left: [U8]
    fill: Int
    fill_count: Int
    right: [U8]
}

// The title face, its glyphs, and the kits made so far.
Painter: struct {
    face: font.Face
    cache: font.GlyphCache
    kits: [Kit]
}

painter: fn() -> Painter {
    Painter{face: font.regular(), cache: font.cache(), kits: [Kit]{}}
}

// `logical` units in pixels at `scale120`, rounded half away from zero as
// wp_fractional_scale_v1 asks.
px: fn(logical: Int, scale120: Int) -> Int {
    if logical < 0 -> return -((-logical * scale120 + 60) /% 120)
    (logical * scale120 + 60) /% 120
}

// ---- hit testing -------------------------------------------------------

// The part of a `width` x `height` logical-unit window (header included)
// the point (`x`, `y`) is on. A square window (`look.square`) has no
// resize grip outside.
spot: fn(x: Float, y: Float, width: Int, height: Int, look: FrameLook) -> FrameSpot {
    w: Float{width}
    h: Float{height}
    if x < 0.0 || y < 0.0 || x >= w || y >= h {
        grip: Float{GRIP}
        if look.square || x < -grip || y < -grip || x >= w + grip || y >= h + grip -> return FrameSpot.Outside
        corner: Float{CORNER_GRIP}
        edge := 0
        if x < 0.0 -> edge += EDGE_LEFT else if x >= w -> edge += EDGE_RIGHT
        if y < 0.0 -> edge += EDGE_TOP else if y >= h -> edge += EDGE_BOTTOM
        if edge == EDGE_LEFT || edge == EDGE_RIGHT {
            if y < corner -> edge += EDGE_TOP else if y >= h - corner -> edge += EDGE_BOTTOM
        }
        if edge == EDGE_TOP || edge == EDGE_BOTTOM {
            if x < corner -> edge += EDGE_LEFT else if x >= w - corner -> edge += EDGE_RIGHT
        }
        return FrameSpot.Edge(edge)
    }
    header: Float{HEADER}
    if y >= header -> return FrameSpot.Content
    button: button_at(x, width, look)
    if button != .Nothing -> return FrameSpot.Button(button)
    FrameSpot.Title
}

// The button whose hit region holds column `x` of the header of a
// `width`-unit window. The regions are rectangles the header's full height
// and a button step wide (28 x 34 units, past the 24 x 24 minimum; 46 x 34
// for a finger), side by side from the window's edge without overlap; each
// holds its soft square.
button_at: fn(x: Float, width: Int, look: FrameLook) -> FrameButton {
    step: button_step(look)
    loop k in 0..<3 {
        from: Float{width - (k + 1) * step}
        to: Float{width - k * step}
        if x >= from && x < to -> return button_of(k)
    }
    FrameButton.Nothing
}

// The step from each button to the next, in logical units.
button_step: fn(look: FrameLook) -> Int { if look.coarse -> BUTTON_STEP_COARSE else -> BUTTON_STEP }

// The buttons from the window's edge in: close, maximize, minimize.
button_of: fn(k: Int) -> FrameButton {
    if k == 0 -> return FrameButton.Close
    if k == 1 -> return FrameButton.Maximize
    FrameButton.Minimize
}

// Where `which` sits from the edge, as `button_of` counts; -1 for none.
button_index: fn(which: FrameButton) -> Int {
    if which == {
        .Close -> 0
        .Maximize -> 1
        .Minimize -> 2
        .Nothing -> NO_BUTTON
    }
}

// The center of the `k`th button from the edge on a `width`-unit window, in
// logical units from the window's left edge.
center_of: fn(k: Int, width: Int, look: FrameLook) -> Int {
    width - BUTTON_INSET - BUTTON_SIDE /% 2 - k * button_step(look)
}

button_center: fn(which: FrameButton, width: Int, look: FrameLook) -> Int {
    center_of(max_int(button_index(which), 0), width, look)
}

// The `k`th button's soft square in the header of a `width`-pixel window at
// `scale120`, in whole pixels. Its top and the close square's right edge
// are the same px(BUTTON_INSET) in from the header's top and the window's
// right edge, and it is the header's height less that inset at top and
// bottom, so it is centered down the header at every scale; each next one
// is a whole-pixel step further left.
button_box: fn(k: Int, width: Int, scale120: Int, look: FrameLook) -> UIRect {
    inset: px(BUTTON_INSET, scale120)
    side: px(HEADER, scale120) - 2 * inset
    UIRect{x: width - inset - side - k * px(button_step(look), scale120), y: inset, width: side, height: side}
}

// Keyboard focus across the buttons in reading order (left to right:
// minimize, maximize, close): the next one `step` 1 on, or with `step` -1
// back, wrapping. From `Nothing` it enters at the first, or going back at
// the last.
next_control: fn(current: FrameButton, step: Int) -> FrameButton {
    at := if step < 0 -> 2 else -> 0
    if current != .Nothing {
        at = 2 - button_index(current) + step
        if at > 2 -> at -= 3
        if at < 0 -> at += 3
    }
    button_of(2 - at)
}

// The title's left edge in a `window`-wide header when the space between
// `start` and `end` is free for it and it is `advance` wide: centered on the
// window when it fits there, else shifted only as far as it must to stay
// inside that space.
title_left: fn(window: Float, start: Float, end: Float, advance: Float) -> Float {
    fmax(fmin((window - advance) / 2.0, end - advance), start)
}

// ---- the shadow kit ----------------------------------------------------

// Which of `p.kits` is the kit for `look.active` at `scale120`, made once
// and kept: the four latest stay.
kit: fn(&p: Painter, look: FrameLook, scale120: Int) -> Int {
    loop at in 0..<p.kits.len() {
        if p.kits[at].active == look.active && p.kits[at].dark == look.dark && p.kits[at].scale120 == scale120 -> return at
    }
    if p.kits.len() >= 4 {
        _: p.kits.remove(0, .Slot)
    }
    p.kits.push(draw_kit(look, scale120))
    p.kits.len() - 1
}

draw_kit: fn(look: FrameLook, scale120: Int) -> Kit {
    s: Float{scale120} / 120.0
    margin: px(MARGIN, scale120)
    box_width: px(KIT_BOX_WIDTH, scale120)
    box_height: px(KIT_BOX_HEIGHT, scale120)
    width: box_width + 2 * margin
    height: box_height + 2 * margin
    pixels := transparent(width * height)
    x0: Float{margin}
    y0: Float{margin}
    x1: Float{margin + box_width}
    y1: Float{margin + box_height}
    r: Float{RADIUS} * s
    // A tight contact shadow under a wide soft one, then the outline just
    // outside the window's edge.
    paint(pixels, width, height, shadow_mask(width, height, x0, y0, x1, y1, r, 1.0 * s, 1.5 * s), SHADOW_NEAR)
    if look.active {
        paint(pixels, width, height, shadow_mask(width, height, x0, y0, x1, y1, r, 12.0 * s, 22.0 * s), SHADOW_ACTIVE)
    } else {
        paint(pixels, width, height, shadow_mask(width, height, x0, y0, x1, y1, r, 5.0 * s, 11.0 * s), SHADOW_INACTIVE)
    }
    paint(pixels, width, height, ring_mask(x0, y0, x1, y1, r, fmax(1.0, s)), palette(look).outline)
    Kit{active: look.active, dark: look.dark, scale120: scale120, margin: margin, box_width: box_width, box_height: box_height, width: width, height: height, pixels: pixels}
}

// Where pixel `at` of a window side `size` pixels long falls in the kit's
// box side `box` long: the near corner as it is, the far corner from the
// far end, and everything between on the box's middle.
kit_index: fn(at: Int, size: Int, box: Int) -> Int {
    half: box /% 2
    if at < half -> return at
    if at >= size - (box - half) -> return at - (size - box)
    half
}

// The byte offset in `kit.pixels` of pixel (`x`, `y`) around a `width` x
// `height` pixel window; either may be negative, out in the margin.
kit_offset: fn(kit: Kit, x: Int, y: Int, width: Int, height: Int) -> Int {
    col: kit.margin + kit_index(x, width, kit.box_width)
    row: kit.margin + kit_index(y, height, kit.box_height)
    (row * kit.width + col) * 4
}

// Row `y` of the ring around a `width` x `height` pixel window, from
// pixel `x0` to before `x1`.
kit_row: fn(kit: Kit, y: Int, width: Int, height: Int, x0: Int, x1: Int) -> KitRow {
    half: kit.box_width /% 2
    right_from: max_int(width - (kit.box_width - half), half)
    left_end: min_int(x1, half)
    right_start: max_int(x0, right_from)
    left := [U8]{}
    if left_end > x0 {
        at: kit_offset(kit, x0, y, width, height)
        left = kit.pixels[at..<(at + (left_end - x0) * 4)].copy()
    }
    right := [U8]{}
    if x1 > right_start {
        at: kit_offset(kit, right_start, y, width, height)
        right = kit.pixels[at..<(at + (x1 - right_start) * 4)].copy()
    }
    middle: kit_offset(kit, half, y, width, height)
    fill: Int.from_u8(kit.pixels[middle]) + (Int.from_u8(kit.pixels[middle + 1]) << 8) + (Int.from_u8(kit.pixels[middle + 2]) << 16) + (Int.from_u8(kit.pixels[middle + 3]) << 24)
    count: min_int(x1, right_from) - max_int(x0, half)
    KitRow{left: left, fill: fill, fill_count: max_int(count, 0), right: right}
}

// The window's coverage in the square at a rounded corner, `side` x `side`
// pixels (side = corner_side), rows top to bottom, for the bottom-left
// corner; the other corners mirror it.
corner_side: fn(scale120: Int) -> Int { math.round(math.ceil(Float{RADIUS * scale120} / 120.0)) }

bottom_left_cover: fn(scale120: Int) -> [U8] {
    r: Float{RADIUS * scale120} / 120.0
    side: corner_side(scale120)
    out := [U8]{}
    loop row in 0..<side {
        loop col in 0..<side {
            // The squircle's center is r in from the left and up from the
            // bottom.
            dx: r - (Float{col} + 0.5)
            dy: (Float{row} + 0.5) - (Float{side} - r)
            d: if dx > 0.0 && dy > 0.0 -> squircle(dx, dy) - r else -> Float{-1.0}
            out.push(U8{math.round(clamp01(0.5 - d) * 255.0)})
        }
    }
    out
}

// ---- the header --------------------------------------------------------

// The header of a `width`-pixel-wide window: `width` x px(HEADER) pixels.
header: fn(&p: Painter, look: FrameLook, width: Int, scale120: Int) -> [U8] {
    s: Float{scale120} / 120.0
    height: px(HEADER, scale120)
    colors: palette(look)
    back: if look.active -> colors.header_active else -> colors.header_inactive
    side: if look.square -> 0 else -> min_int(corner_side(scale120), min_int(width /% 2, height))
    slot: kit(p, look, scale120)
    // Opaque header, except the rounded corners' squares, which start as
    // the ring beside them.
    pixels := [U8]{}
    loop row in 0..<height {
        loop col in 0..<width {
            if row < side && (col < side || col >= width - side) {
                // Near the top every window height maps alike.
                at: kit_offset(p.kits[slot], col, row, width, p.kits[slot].box_height)
                loop k in 0..<4 -> pixels.push(p.kits[slot].pixels[at + k])
            } else {
                pixels.push(U8{back.bit_and(255)})
                pixels.push(U8{(back >> 8).bit_and(255)})
                pixels.push(U8{(back >> 16).bit_and(255)})
                pixels.push(U8{255})
            }
        }
    }
    if side > 0 {
        r: Float{RADIUS} * s
        paint(pixels, width, height, corner_mask(0, side, r), back)
        paint(pixels, width, height, corner_mask(width - side, side, r), back)
    }
    logical: Float{width} / s
    ink: if look.active -> colors.text_active else -> colors.text_inactive
    // The title has the header from the inset at the left edge to a gap
    // before the minimize button's square, and is clipped there. It is
    // centered on the window when it fits so, else shifted only as far as
    // that space needs (adaptive centering).
    controls: Float{BUTTON_INSET + BUTTON_SIDE + 2 * button_step(look) + TITLE_GAP}
    title_x: Float{TITLE_INSET}
    title_end: logical - controls
    size: s * TITLE_SIZE
    room: fmax(title_end - title_x, 0.0) * s
    shown: fit_title(p, look.title, size, room)
    start: math.round(title_x * s)
    advance: title_width(p.face, shown, size)
    left: math.round(title_left(Float{width}, Float{start}, Float{start} + room, advance))
    clip: UIRect{x: start, y: 0, width: math.round(room), height: height}
    // The face's capitals are 0.668 em tall, centered on the header: the
    // baseline is half of 13 * 0.668 = 4.342 units below its middle.
    baseline: math.round((Float{HEADER} / 2.0 + 4.342) * s)
    _: font.draw_text(pixels, width, height, width * 4, p.cache, p.face, shown, size, left, baseline, ink, clip)
    ring: colors.focus
    round: s * 5.0
    loop k in 0..<3 {
        which: button_of(k)
        lit: look.hover == which
        held: lit && look.pressed == which
        square: button_box(k, width, scale120, look)
        x0: Float{square.x}
        y0: Float{square.y}
        x1: Float{square.x + square.width}
        y1: Float{square.y + square.height}
        fill := if held -> colors.button_press else if lit -> colors.button_hover else -> colors.button_idle
        glyph := if lit -> colors.glyph_hover else -> ink
        if lit && which == .Close {
            fill = if held -> colors.close_press else -> colors.close_hover
            glyph = WHITE
        }
        if alpha_of(fill) > 0 -> paint(pixels, width, height, box_mask(x0, y0, x1, y1, round, round, 0.0), fill)
        button_glyph(pixels, width, height, look, which, square, scale120, glyph)
        out: (Float{FOCUS_GAP} + FOCUS_LINE) * s
        if look.focus == which -> paint(pixels, width, height, box_mask(x0 - out, y0 - out, x1 + out, y1 + out, round + s * 2.0, round + s * 2.0, FOCUS_LINE * s), ring)
    }
    pixels
}

// `title`'s width at `size` pixels.
title_width: fn(face: font.Face, title: String, size: Float) -> Float { face.layout(title, size).advance }

// `title` to fit `room` pixels at `size` pixels: whole
// if it fits, else cut at a grapheme boundary, at a word's end when one
// fits, and ended with an ellipsis; empty when not even the ellipsis fits.
// Combining sequences stay whole, and the text keeps its logical order.
fit_title: fn(&p: Painter, title: String, size: Float, room: Float) -> String {
    if title_width(p.face, title, size) <= room -> return title.copy()
    if title_width(p.face, "…", size) > room -> return ""
    parts: text.graphemes(title)
    // prefixes[k] is the first k graphemes.
    prefixes := [String]{""}
    loop part in parts -> prefixes.push("{prefixes[prefixes.len() - 1]}{part}")
    // The most graphemes that fit before the ellipsis: widths grow with
    // the prefix, so a binary search finds it.
    low := 0
    high := parts.len()
    loop low < high {
        mid: (low + high + 1) /% 2
        if title_width(p.face, "{prefixes[mid]}…", size) <= room {
            low = mid
        } else {
            high = mid - 1
        }
    }
    // Back to the last word's end inside that, if there is one.
    cut := low
    loop at in 1..<(low + 1) {
        k: low + 1 - at
        if k < parts.len() && text.is_whitespace(parts[k]) && !text.is_whitespace(parts[k - 1]) {
            cut = k
            break
        }
    }
    kept: text.trim_end(prefixes[cut])
    "{kept}…"
}

// The side of a button glyph's box in pixels at `scale120`: px(GLYPH), less
// a pixel where that keeps it exactly centered in a `side`-pixel square.
glyph_side: fn(side: Int, scale120: Int) -> Int {
    g: px(GLYPH, scale120)
    if (side - g).bit_and(1) == 1 -> g - 1 else -> g
}

// A button glyph's stroke in pixels at `scale120`: one unit, at least one
// pixel.
glyph_stroke: fn(scale120: Int) -> Int { max_int(px(1, scale120), 1) }

// A button's glyph in its soft `square`, at `scale120`. Every glyph fills
// the same box, glyph_side across and centered in the square, with the
// same glyph_stroke: the dash spans the box's width, the box is the
// maximize glyph, and the X runs corner to corner. The dash and the boxes
// are whole-pixel rectangles, so they are crisp at every scale; the X's
// strokes end on the box's corners, symmetric about its center. A
// diagonal's anti-aliased edges spread more ink than a whole-pixel line,
// so the X is drawn 0.15 pixels thinner: then all three carry one stroke's
// ink per pixel of their length, to a few percent (the last test measures
// it).
button_glyph: fn(&pixels: [U8], width: Int, height: Int, look: FrameLook, which: FrameButton, square: UIRect, scale120: Int, color: Int) {
    g: glyph_side(square.width, scale120)
    w: glyph_stroke(scale120)
    x0: square.x + (square.width - g) /% 2
    y0: square.y + (square.height - g) /% 2
    if which == .Minimize -> paint(pixels, width, height, rect_mask(x0, square.y + (square.height - w) /% 2, g, w), color)
    if which == .Maximize {
        if look.maximized {
            // Restore: a square with another behind it, up and right by d.
            d: max_int(px(2, scale120), w + 1)
            box_lines(pixels, width, height, x0, y0 + d, g - d, w, color)
            paint(pixels, width, height, rect_mask(x0 + d, y0, g - d, w), color)
            paint(pixels, width, height, rect_mask(x0 + g - w, y0, w, g - d), color)
            paint(pixels, width, height, rect_mask(x0 + d, y0, w, d), color)
            paint(pixels, width, height, rect_mask(x0 + g - d, y0 + g - d - w, d, w), color)
        } else {
            box_lines(pixels, width, height, x0, y0, g, w, color)
        }
    }
    if which == .Close {
        line: Float{w} - 0.15
        half: line / 2.0
        a: Float{x0} + half
        b: Float{x0 + g} - half
        top: Float{y0} + half
        bottom: Float{y0 + g} - half
        paint(pixels, width, height, segment_mask(a, top, b, bottom, line), color)
        paint(pixels, width, height, segment_mask(b, top, a, bottom, line), color)
    }
}

// The outline of the `side`-pixel square at pixel (x, y), `line` pixels
// wide inside it.
box_lines: fn(&pixels: [U8], width: Int, height: Int, x: Int, y: Int, side: Int, line: Int, color: Int) {
    paint(pixels, width, height, rect_mask(x, y, side, line), color)
    paint(pixels, width, height, rect_mask(x, y + side - line, side, line), color)
    paint(pixels, width, height, rect_mask(x, y + line, line, side - 2 * line), color)
    paint(pixels, width, height, rect_mask(x + side - line, y + line, line, side - 2 * line), color)
}

// ---- shapes ------------------------------------------------------------

// `count` transparent pixels.
transparent: fn(count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<(count * 4) -> out.push(U8{0})
    out
}

// Paints `mask` in `color` onto the `width` x `height` pixels.
paint: fn(&pixels: [U8], width: Int, height: Int, mask: font.GlyphMask, color: Int) {
    font.blend(pixels, width, height, width * 4, mask, 0, 0, color, UIRect{x: 0, y: 0, width: width, height: height})
}

// A mask whose top-left pixel is (col, row); `blend` places a mask's
// left edge at x + left and its top row at y - top.
mask_at: fn(col: Int, row: Int, width: Int, height: Int, coverage: [U8]) -> font.GlyphMask {
    font.GlyphMask{width: width, height: height, left: col, top: -row, coverage: coverage}
}

cover_byte: fn(cover: Float) -> U8 { U8{math.round(clamp01(cover) * 255.0)} }

rect_mask: fn(col: Int, row: Int, width: Int, height: Int) -> font.GlyphMask {
    coverage := [U8]{}
    loop _ in 0..<(width * height) -> coverage.push(U8{255})
    mask_at(col, row, width, height, coverage)
}

// Signed distance in pixels from (x, y) to the box (x0, y0)-(x1, y1),
// whose top corners are squircles `top` across and bottom corners
// `bottom`; square corners (0) measure as a plain box.
box_distance: fn(x: Float, y: Float, x0: Float, y0: Float, x1: Float, y1: Float, top: Float, bottom: Float) -> Float {
    cx: (x0 + x1) / 2.0
    cy: (y0 + y1) / 2.0
    r: if y < cy -> top else -> bottom
    qx: fabs(x - cx) - (x1 - x0) / 2.0 + r
    qy: fabs(y - cy) - (y1 - y0) / 2.0 + r
    ox: fmax(qx, 0.0)
    oy: fmax(qy, 0.0)
    corner: if r > 0.0 -> squircle(ox, oy) else -> math.sqrt(ox * ox + oy * oy)
    corner + fmin(fmax(qx, qy), 0.0) - r
}

// The degree-4 superellipse's radius through (dx, dy): the squircle
// corner's (|dx|^4 + |dy|^4)^(1/4).
squircle: fn(dx: Float, dy: Float) -> Float {
    fourth: dx * dx * dx * dx + dy * dy * dy * dy
    root: math.sqrt(fourth)
    math.sqrt(root)
}

// The box filled, or with `line` > 0 a border that wide inside it.
box_mask: fn(x0: Float, y0: Float, x1: Float, y1: Float, top: Float, bottom: Float, line: Float) -> font.GlyphMask {
    col0: floor_int(x0)
    row0: floor_int(y0)
    cols: ceil_int(x1) - col0
    rows: ceil_int(y1) - row0
    coverage := [U8]{}
    loop row in 0..<rows {
        loop col in 0..<cols {
            d: box_distance(Float{col0 + col} + 0.5, Float{row0 + row} + 0.5, x0, y0, x1, y1, top, bottom)
            cover: if line > 0.0 -> clamp01(0.5 - d) - clamp01(0.5 - d - line) else -> clamp01(0.5 - d)
            coverage.push(cover_byte(cover))
        }
    }
    mask_at(col0, row0, cols, rows, coverage)
}

// A ring `line` wide just outside the rounded box.
ring_mask: fn(x0: Float, y0: Float, x1: Float, y1: Float, r: Float, line: Float) -> font.GlyphMask {
    col0: floor_int(x0 - line) - 1
    row0: floor_int(y0 - line) - 1
    cols: ceil_int(x1 + line) + 1 - col0
    rows: ceil_int(y1 + line) + 1 - row0
    coverage := [U8]{}
    loop row in 0..<rows {
        loop col in 0..<cols {
            d: box_distance(Float{col0 + col} + 0.5, Float{row0 + row} + 0.5, x0, y0, x1, y1, r, r)
            coverage.push(cover_byte(clamp01(0.5 + d) - clamp01(0.5 + d - line)))
        }
    }
    mask_at(col0, row0, cols, rows, coverage)
}

// The square `side` pixels from column `col` at the top of a header,
// covered where the header's rounded corner is: the top-left corner's at
// column 0, else the top-right's.
corner_mask: fn(col: Int, side: Int, r: Float) -> font.GlyphMask {
    right: col > 0
    coverage := [U8]{}
    loop row in 0..<side {
        loop k in 0..<side {
            // Distance in from the corner's own edges.
            inward: if right -> Float{side - k} - 0.5 else -> Float{k} + 0.5
            dx: r - inward
            dy: r - (Float{row} + 0.5)
            d: if dx > 0.0 && dy > 0.0 -> squircle(dx, dy) - r else -> Float{-1.0}
            coverage.push(cover_byte(0.5 - d))
        }
    }
    mask_at(col, 0, side, side, coverage)
}

// The soft shadow of the rounded box moved down `drop`, a Gaussian of
// `sigma` pixels, over the whole `width` x `height` canvas, left out
// under the box itself.
shadow_mask: fn(width: Int, height: Int, x0: Float, y0: Float, x1: Float, y1: Float, r: Float, drop: Float, sigma: Float) -> font.GlyphMask {
    coverage := [U8]{}
    spread: sigma * 1.41421356
    loop row in 0..<height {
        loop col in 0..<width {
            x: Float{col} + 0.5
            y: Float{row} + 0.5
            if box_distance(x, y, x0, y0, x1, y1, r, r) < -1.0 {
                coverage.push(U8{0})
                next
            }
            d: box_distance(x, y - drop, x0, y0, x1, y1, r, r)
            coverage.push(cover_byte(math.erfc(d / spread) * 0.5))
        }
    }
    mask_at(0, 0, width, height, coverage)
}

// A disc of radius `r` centered at (cx, cy), or with `line` > 0 a ring
// that wide.
disc_mask: fn(cx: Float, cy: Float, r: Float, line: Float) -> font.GlyphMask {
    col0: floor_int(cx - r - 1.0)
    row0: floor_int(cy - r - 1.0)
    cols: ceil_int(cx + r + 1.0) - col0
    rows: ceil_int(cy + r + 1.0) - row0
    coverage := [U8]{}
    loop row in 0..<rows {
        loop col in 0..<cols {
            dx: Float{col0 + col} + 0.5 - cx
            dy: Float{row0 + row} + 0.5 - cy
            d: math.sqrt(dx * dx + dy * dy) - r
            cover: if line > 0.0 -> clamp01(0.5 - d) - clamp01(0.5 - d - line) else -> clamp01(0.5 - d)
            coverage.push(cover_byte(cover))
        }
    }
    mask_at(col0, row0, cols, rows, coverage)
}

// A line `width` pixels wide from (ax, ay) to (bx, by) with round caps.
segment_mask: fn(ax: Float, ay: Float, bx: Float, by: Float, width: Float) -> font.GlyphMask {
    half: width / 2.0
    col0: floor_int(fmin(ax, bx) - half - 1.0)
    row0: floor_int(fmin(ay, by) - half - 1.0)
    cols: ceil_int(fmax(ax, bx) + half + 1.0) - col0
    rows: ceil_int(fmax(ay, by) + half + 1.0) - row0
    bax: bx - ax
    bay: by - ay
    len2: fmax(bax * bax + bay * bay, 0.0001)
    coverage := [U8]{}
    loop row in 0..<rows {
        loop col in 0..<cols {
            pax: Float{col0 + col} + 0.5 - ax
            pay: Float{row0 + row} + 0.5 - ay
            t: clamp01((pax * bax + pay * bay) / len2)
            dx: pax - bax * t
            dy: pay - bay * t
            coverage.push(cover_byte(0.5 - (math.sqrt(dx * dx + dy * dy) - half)))
        }
    }
    mask_at(col0, row0, cols, rows, coverage)
}

// The filled polygon through the points (xs[k], ys[k]), any simple one:
// its signed distance is the nearest edge's, negative inside.
polygon_mask: fn(xs: [Float], ys: [Float]) -> font.GlyphMask {
    left := xs[0]
    right := xs[0]
    top := ys[0]
    bottom := ys[0]
    loop k in 1..<xs.len() {
        left = fmin(left, xs[k])
        right = fmax(right, xs[k])
        top = fmin(top, ys[k])
        bottom = fmax(bottom, ys[k])
    }
    col0: floor_int(left) - 1
    row0: floor_int(top) - 1
    cols: ceil_int(right) + 1 - col0
    rows: ceil_int(bottom) + 1 - row0
    coverage := [U8]{}
    loop row in 0..<rows {
        loop col in 0..<cols {
            d: polygon_distance(Float{col0 + col} + 0.5, Float{row0 + row} + 0.5, xs, ys)
            coverage.push(cover_byte(0.5 - d))
        }
    }
    mask_at(col0, row0, cols, rows, coverage)
}

polygon_distance: fn(x: Float, y: Float, xs: [Float], ys: [Float]) -> Float {
    nearest := (x - xs[0]) * (x - xs[0]) + (y - ys[0]) * (y - ys[0])
    inside := false
    j := xs.len() - 1
    loop i in 0..<xs.len() {
        ex: xs[j] - xs[i]
        ey: ys[j] - ys[i]
        wx: x - xs[i]
        wy: y - ys[i]
        t: clamp01((wx * ex + wy * ey) / fmax(ex * ex + ey * ey, 0.0001))
        dx: wx - ex * t
        dy: wy - ey * t
        nearest = fmin(nearest, dx * dx + dy * dy)
        // Even-odd: the edges a ray to the right crosses.
        if (ys[i] > y) != (ys[j] > y) && x < xs[i] + (y - ys[i]) * ex / ey -> inside = !inside
        j = i
    }
    if inside -> -math.sqrt(nearest) else -> math.sqrt(nearest)
}

// ---- the app icon ------------------------------------------------------

// Jet's mark as an app icon `side` pixels square, in straight-alpha RGBA
// (a UIIconImage's pixels): the red delta and its speed dash on a rounded
// square of Jet black, as Docs/site/assets/favicon.svg draws it on 64
// units. A window that names no icon of its own shows it in the taskbar.
app_icon: fn(side: Int) -> [U8] {
    s: Float{side} / 64.0
    pixels := [U8]{}
    loop _ in 0..<(side * side) {
        pixels.push(U8{0x0D})
        pixels.push(U8{0x0B})
        pixels.push(U8{0x0B})
        pixels.push(U8{255})
    }
    red: 0xFFE8232A
    paint(pixels, side, side, polygon_mask([Float]{56.0 * s, 20.0 * s, 28.5 * s, 20.0 * s}, [Float]{32.0 * s, 17.0 * s, 32.0 * s, 47.0 * s}), red)
    paint(pixels, side, side, box_mask(6.0 * s, 29.0 * s, 20.0 * s, 35.0 * s, 3.0 * s, 3.0 * s, 0.0), red)
    // Painted opaque, the premultiplied B, G, R are straight; the rounded
    // square's coverage becomes the alpha.
    shape: box_mask(0.0, 0.0, Float{side}, Float{side}, 12.0 * s, 12.0 * s, 0.0)
    out := [U8]{}
    loop at in 0..<(side * side) {
        i: at * 4
        out.push(pixels[i + 2])
        out.push(pixels[i + 1])
        out.push(pixels[i])
        out.push(shape.coverage[at])
    }
    out
}

// ---- numbers and colors ------------------------------------------------

fmin: fn(a: Float, b: Float) -> Float { if a < b -> a else -> b }
fmax: fn(a: Float, b: Float) -> Float { if a > b -> a else -> b }
fabs: fn(a: Float) -> Float { if a < 0.0 -> -a else -> a }
clamp01: fn(a: Float) -> Float { fmax(0.0, fmin(1.0, a)) }
floor_int: fn(a: Float) -> Int { math.round(math.floor(a)) }
ceil_int: fn(a: Float) -> Int { math.round(math.ceil(a)) }
min_int: fn(a: Int, b: Int) -> Int { if a < b -> a else -> b }
max_int: fn(a: Int, b: Int) -> Int { if a > b -> a else -> b }
alpha_of: fn(color: Int) -> Int { (color >> 24).bit_and(255) }
with_alpha: fn(color: Int, alpha: Int) -> Int { color.bit_and(16777215) + (alpha << 24) }

// `top` (0xAARRGGBB, straight alpha) laid over the opaque `bottom`, in
// sRGB bytes as the header's buttons are seen.
over: fn(top: Int, bottom: Int) -> Int {
    a: alpha_of(top)
    out := 0xFF000000
    shifts: [Int]{0, 8, 16}
    loop shift in shifts {
        t: (top >> shift).bit_and(255)
        b: (bottom >> shift).bit_and(255)
        out += ((t * a + b * (255 - a) + 127) /% 255) << shift
    }
    out
}

// WCAG 2.2's contrast ratio between two opaque colors.
contrast: fn(a: Int, b: Int) -> Float {
    la: luminance(a)
    lb: luminance(b)
    (fmax(la, lb) + 0.05) / (fmin(la, lb) + 0.05)
}

luminance: fn(color: Int) -> Float {
    linear(color >> 16) * 0.2126 + linear(color >> 8) * 0.7152 + linear(color) * 0.0722
}

// The low byte of `channel`, an sRGB value, in linear light.
linear: fn(channel: Int) -> Float {
    c: Float{channel.bit_and(255)} / 255.0
    if c <= 0.04045 -> return c / 12.92
    math.exp(math.ln((c + 0.055) / 1.055) * 2.4)
}

// A look for the tests: active, rounded, dark, nothing hovered.
plain_look: fn(title: String) -> FrameLook {
    FrameLook{title: title, active: true, square: false, maximized: false, coarse: false, hover: FrameButton.Nothing, pressed: FrameButton.Nothing, focus: FrameButton.Nothing, dark: true}
}

// The bounding box of the pixels in `area` of the `width`-pixel-wide
// header `bar` whose green byte is at least `rise` above `base`; width 0
// when there are none.
ink_box: fn(bar: [U8], width: Int, area: UIRect, base: Int, rise: Int) -> UIRect {
    x0 := area.x + area.width
    y0 := area.y + area.height
    x1 := area.x
    y1 := area.y
    loop row in area.y..<(area.y + area.height) {
        loop col in area.x..<(area.x + area.width) {
            if Int.from_u8(bar[(row * width + col) * 4 + 1]) - base >= rise {
                x0 = min_int(x0, col)
                y0 = min_int(y0, row)
                x1 = max_int(x1, col + 1)
                y1 = max_int(y1, row + 1)
            }
        }
    }
    if x1 <= x0 -> return UIRect{x: area.x, y: area.y, width: 0, height: 0}
    UIRect{x: x0, y: y0, width: x1 - x0, height: y1 - y0}
}

// The bounding box of the pixels in `area` where the headers `a` and `b`
// differ.
changed_box: fn(a: [U8], b: [U8], width: Int, area: UIRect) -> UIRect {
    x0 := area.x + area.width
    y0 := area.y + area.height
    x1 := area.x
    y1 := area.y
    loop row in area.y..<(area.y + area.height) {
        loop col in area.x..<(area.x + area.width) {
            at: (row * width + col) * 4
            if a[at] != b[at] || a[at + 1] != b[at + 1] || a[at + 2] != b[at + 2] {
                x0 = min_int(x0, col)
                y0 = min_int(y0, row)
                x1 = max_int(x1, col + 1)
                y1 = max_int(y1, row + 1)
            }
        }
    }
    if x1 <= x0 -> return UIRect{x: area.x, y: area.y, width: 0, height: 0}
    UIRect{x: x0, y: y0, width: x1 - x0, height: y1 - y0}
}

// How much of the glyph color `ink` (a green byte) the pixels of `area`
// hold over `base`, in whole pixels: blend mixes the sRGB bytes linearly,
// so each pixel's share of the way from `base` to `ink` is its coverage.
ink_cover: fn(bar: [U8], width: Int, area: UIRect, base: Int, ink: Int) -> Float {
    total := Float{0.0}
    loop row in area.y..<(area.y + area.height) {
        loop col in area.x..<(area.x + area.width) {
            g: Int.from_u8(bar[(row * width + col) * 4 + 1])
            if g > base -> total += Float{g - base} / Float{ink - base}
        }
    }
    total
}

// Twice a box's center, so a half pixel is a whole step.
twice_center_x: fn(r: UIRect) -> Int { 2 * r.x + r.width }
twice_center_y: fn(r: UIRect) -> Int { 2 * r.y + r.height }

within_half: fn(a: Int, b: Int) -> Bool { a - b <= 1 && b - a <= 1 }

// The RGBA bytes of pixel (x, y) of a `side`-pixel square icon.
icon_pixel: fn(pixels: [U8], side: Int, x: Int, y: Int) -> [U8] {
    at: (y * side + x) * 4
    [U8]{pixels[at], pixels[at + 1], pixels[at + 2], pixels[at + 3]}
}

#Test("the app icon is Jet's mark: the red delta and its dash on a rounded square of Jet black") {
    // At 64 pixels a unit of favicon.svg is a pixel.
    pixels: app_icon(64)
    assert_eq(pixels.len(), 64 * 64 * 4)
    // The corner pixel's center is sqrt(2) * 11.5 - 12 = 4.26 outside the
    // 12-unit corner: transparent.
    assert_eq(icon_pixel(pixels, 64, 0, 0)[3], U8{0})
    assert_eq(icon_pixel(pixels, 64, 63, 63)[3], U8{0})
    assert(icon_pixel(pixels, 64, 10, 10) == [U8]{0x0B, 0x0B, 0x0D, 255})
    assert(icon_pixel(pixels, 64, 32, 2) == [U8]{0x0B, 0x0B, 0x0D, 255})
    // Inside the delta (28.5..56 across on row 32) and the dash (6..20
    // across, 29..35 down): Jet red.
    assert(icon_pixel(pixels, 64, 40, 32) == [U8]{0xE8, 0x23, 0x2A, 255})
    assert(icon_pixel(pixels, 64, 10, 31) == [U8]{0xE8, 0x23, 0x2A, 255})
    // Between the dash's end (20) and the delta's notch (28.2 on row 32's
    // center line), and above the delta's top edge: black.
    assert(icon_pixel(pixels, 64, 24, 32) == [U8]{0x0B, 0x0B, 0x0D, 255})
    assert(icon_pixel(pixels, 64, 40, 12) == [U8]{0x0B, 0x0B, 0x0D, 255})
    // Scaled, the same spots: 32 pixels, half a unit each.
    small: app_icon(32)
    assert(icon_pixel(small, 32, 20, 16) == [U8]{0xE8, 0x23, 0x2A, 255})
    assert(icon_pixel(small, 32, 5, 5) == [U8]{0x0B, 0x0B, 0x0D, 255})
}

#Test("frame spots: content, title, button regions, edges and corners") {
    look: plain_look("")
    assert_eq(spot(100.0, 100.0, 400, 300, look), FrameSpot.Content)
    assert_eq(spot(100.0, 20.0, 400, 300, look), FrameSpot.Title)
    assert_eq(spot(200.0, 34.0, 400, 300, look), FrameSpot.Content)
    assert_eq(spot(304.5, 2.0, 400, 300, look), FrameSpot.Title)
    // Rectangular regions the header's height, a step (28 units) wide, side
    // by side from the window's edge: on a 400-unit window close from 372,
    // maximize from 344, minimize from 316.
    assert_eq(spot(315.5, 2.0, 400, 300, look), FrameSpot.Title)
    assert_eq(spot(316.0, 0.0, 400, 300, look), FrameSpot.Button(FrameButton.Minimize))
    assert_eq(spot(343.5, 33.5, 400, 300, look), FrameSpot.Button(FrameButton.Minimize))
    assert_eq(spot(344.0, 1.0, 400, 300, look), FrameSpot.Button(FrameButton.Maximize))
    assert_eq(spot(371.5, 33.0, 400, 300, look), FrameSpot.Button(FrameButton.Maximize))
    assert_eq(spot(372.0, 0.0, 400, 300, look), FrameSpot.Button(FrameButton.Close))
    assert_eq(spot(399.5, 33.5, 400, 300, look), FrameSpot.Button(FrameButton.Close))
    assert_eq(spot(-3.0, 150.0, 400, 300, look), FrameSpot.Edge(EDGE_LEFT))
    assert_eq(spot(402.0, 150.0, 400, 300, look), FrameSpot.Edge(EDGE_RIGHT))
    assert_eq(spot(200.0, -1.0, 400, 300, look), FrameSpot.Edge(EDGE_TOP))
    assert_eq(spot(200.0, 305.0, 400, 300, look), FrameSpot.Edge(EDGE_BOTTOM))
    assert_eq(spot(-2.0, 5.0, 400, 300, look), FrameSpot.Edge(EDGE_TOP + EDGE_LEFT))
    assert_eq(spot(10.0, -2.0, 400, 300, look), FrameSpot.Edge(EDGE_TOP + EDGE_LEFT))
    assert_eq(spot(399.0, 303.0, 400, 300, look), FrameSpot.Edge(EDGE_BOTTOM + EDGE_RIGHT))
    assert_eq(spot(-20.0, 150.0, 400, 300, look), FrameSpot.Outside)
    // A maximized or tiled window has no grips outside it.
    tiled := plain_look("")
    tiled.square = true
    assert_eq(spot(-3.0, 150.0, 400, 300, tiled), FrameSpot.Outside)
    assert_eq(spot(200.0, -1.0, 400, 300, tiled), FrameSpot.Outside)
    assert_eq(spot(399.5, 0.5, 400, 300, tiled), FrameSpot.Button(FrameButton.Close))
    // Every button's region holds a 24 x 24 square, at the smallest window too.
    widths: [Int]{MIN_WIDTH, 400}
    offsets: [Float]{-12.0, 11.5}
    rows: [Float]{5.0, 28.5}
    loop width in widths {
        loop k in 0..<3 {
            cx: Float{width - 14 - k * 28}
            loop dx in offsets {
                loop dy in rows {
                    assert_eq(spot(cx + dx, dy, width, MIN_HEIGHT, look), FrameSpot.Button(button_of(k)))
                }
            }
        }
    }
    // For a finger every region is 46 units wide and the header high, at
    // the smallest window too, where the minimize region leaves the title
    // its first 38 units (176 - 3 * 46).
    finger := plain_look("")
    finger.coarse = true
    touch_offsets: [Float]{-22.0, 21.5}
    touch_rows: [Float]{0.0, 33.5}
    loop width in widths {
        loop k in 0..<3 {
            cx: Float{width - 23 - k * 46}
            loop dx in touch_offsets {
                loop dy in touch_rows {
                    assert_eq(spot(cx + dx, dy, width, MIN_HEIGHT, finger), FrameSpot.Button(button_of(k)))
                }
            }
        }
        assert_eq(spot(37.5, 20.0, width, MIN_HEIGHT, finger), FrameSpot.Title)
        assert_eq(spot(Float{width - 138}, 20.0, width, MIN_HEIGHT, finger), FrameSpot.Button(FrameButton.Minimize))
    }
    // A finger's regions are wider than a pointer's: 84 units from the right
    // edge is minimize's for a pointer (56 to 84), maximize's for a finger
    // (46 to 92).
    assert_eq(spot(Float{400 - 84}, 20.0, 400, 300, look), FrameSpot.Button(FrameButton.Minimize))
    assert_eq(spot(Float{400 - 84}, 20.0, 400, 300, finger), FrameSpot.Button(FrameButton.Maximize))
}

#Test("the shadow kit stretches: corners kept, middles repeated") {
    assert_eq(kit_index(0, 500, 26), 0)
    assert_eq(kit_index(12, 500, 26), 12)
    assert_eq(kit_index(13, 500, 26), 13)
    assert_eq(kit_index(250, 500, 26), 13)
    assert_eq(kit_index(487, 500, 26), 13)
    assert_eq(kit_index(499, 500, 26), 25)
    assert_eq(kit_index(-5, 500, 26), -5)
    assert_eq(kit_index(510, 500, 26), 36)
    p := painter()
    look: plain_look("")
    slot: kit(p, look, 120)
    ring: p.kits[slot]
    assert_eq([Int]{ring.margin, ring.box_width, ring.box_height, ring.width, ring.height}, [Int]{64, 26, 50, 154, 178})
    assert_eq(ring.pixels.len(), 154 * 178 * 4)
    // Under the window's middle there is no shadow; just outside its
    // bottom edge the shadow is dark, and fades with distance.
    inside: kit_offset(ring, 200, 150, 400, 300)
    assert_eq(ring.pixels[inside + 3], U8{0})
    near: kit_offset(ring, 200, 302, 400, 300)
    far: kit_offset(ring, 200, 360, 400, 300)
    assert(Int.from_u8(ring.pixels[near + 3]) > Int.from_u8(ring.pixels[far + 3]), "the shadow fades away from the window")
    row: kit_row(ring, 302, 400, 300, -64, 464)
    assert_eq(row.left.len() + row.fill_count * 4 + row.right.len(), 528 * 4)
    assert_eq(row.fill >> 24, Int.from_u8(ring.pixels[near + 3]))
    // A side strip's row is all kit bytes, no fill.
    side: kit_row(ring, 150, 400, 300, -64, 0)
    assert_eq([Int]{side.left.len(), side.fill_count, side.right.len()}, [Int]{256, 0, 0})
    assert_eq(kit(p, look, 120), slot)
    assert_eq(p.kits.len(), 1)
}

#Test("every fractional scale sizes the frame in whole pixels") {
    p := painter()
    look: plain_look("Notes")
    scales: [Int]{120, 150, 180, 210, 240, 300}
    loop scale in scales {
        slot: kit(p, look, scale)
        margin: px(MARGIN, scale)
        assert_eq(p.kits[slot].margin, margin)
        assert_eq(p.kits[slot].width, px(KIT_BOX_WIDTH, scale) + 2 * margin)
        // The straight middles really are straight: the kit's middle row
        // and column hold no corner.
        half: p.kits[slot].box_width /% 2
        assert(half >= corner_side(scale), "the kit's straight run starts past the corner")
        width: px(MIN_WIDTH, scale)
        bar: header(p, look, width, scale)
        assert_eq(bar.len(), width * px(HEADER, scale) * 4)
        assert_eq(bottom_left_cover(scale).len(), corner_side(scale) * corner_side(scale))
    }
    // The four latest kits stay.
    assert_eq(p.kits.len(), 4)
    assert_eq(px(46, 150), 58)
    assert_eq(px(-64, 150), -80)
    assert_eq(px(46, 180), 69)
}

#Test("the header is opaque but for its rounded corners, and draws alike every time") {
    p := painter()
    look := plain_look("A window with a long title")
    look.hover = FrameButton.Close
    bar: header(p, look, 300, 120)
    assert_eq(bar.len(), 300 * 34 * 4)
    assert(Int.from_u8(bar[3]) < 255, "the top-left corner is rounded")
    middle: (17 * 300 + 150) * 4
    assert_eq(bar[middle + 3], U8{255})
    // Dark by default, and no mark of Jet's: left of the title the header
    // is bare Jet black, 0x0B0B0D as B, G, R, A.
    bare: (17 * 300 + 5) * 4
    assert_eq([U8]{bar[bare], bar[bare + 1], bar[bare + 2], bar[bare + 3]}, [U8]{U8{0x0D}, U8{0x0B}, U8{0x0B}, U8{255}})
    // The hovered close button is Jet red: its square runs from 274 to 292
    // (8 in from the right edge, 18 across, centered at 283), and 8 units
    // left of its center is clear of the glyph.
    close: (17 * 300 + 275) * 4
    assert(Int.from_u8(bar[close + 2]) > 200 && Int.from_u8(bar[close + 1]) < 60, "the hovered close button is red")
    // A hovered maximize button is a quiet square one step above Jet
    // black, 0x1D1D21 as B, G, R, A: the square runs from 246 to 264 and
    // its glyph from 250 to 260, so pixel (247, 17) is the fill alone.
    quiet := plain_look("")
    quiet.hover = FrameButton.Maximize
    soft: header(p, quiet, 300, 120)
    lit: (17 * 300 + 247) * 4
    assert_eq([U8]{soft[lit], soft[lit + 1], soft[lit + 2], soft[lit + 3]}, [U8]{U8{0x21}, U8{0x1D}, U8{0x1D}, U8{255}})
    // Nothing moves: the same look draws the same bytes.
    assert_eq(header(p, look, 300, 120), bar)
    flat := plain_look("")
    flat.active = false
    flat.square = true
    flat.maximized = true
    square: header(p, flat, 200, 240)
    assert_eq(square.len(), 200 * 68 * 4)
    assert_eq(square[3], U8{255})
    // No icon in the header: the app's icon is the taskbar's. A header
    // without a title is bare from its left inset to the minimize button's
    // square, which starts at 218 on a 300-unit window (300 - 8 - 18 - 2 * 28).
    empty: header(p, plain_look(""), 300, 120)
    loop col in TITLE_INSET..<218 {
        at: (17 * 300 + col) * 4
        assert_eq([U8]{empty[at], empty[at + 1], empty[at + 2]}, [U8]{U8{0x0D}, U8{0x0B}, U8{0x0B}})
    }
    // When the desktop prefers light, the header is 0xF4F4F6, a hovered
    // maximize square is 0xE8E8EC, close still turns Jet red, and the
    // shadow ring is the light theme's own kit.
    light := plain_look("")
    light.dark = false
    pale: header(p, light, 300, 120)
    assert_eq([U8]{pale[bare], pale[bare + 1], pale[bare + 2], pale[bare + 3]}, [U8]{U8{0xF6}, U8{0xF4}, U8{0xF4}, U8{255}})
    light.hover = FrameButton.Maximize
    pale_soft: header(p, light, 300, 120)
    assert_eq([U8]{pale_soft[lit], pale_soft[lit + 1], pale_soft[lit + 2], pale_soft[lit + 3]}, [U8]{U8{0xEC}, U8{0xE8}, U8{0xE8}, U8{255}})
    light.hover = FrameButton.Close
    pale_close: header(p, light, 300, 120)
    assert(Int.from_u8(pale_close[close + 2]) > 200 && Int.from_u8(pale_close[close + 1]) < 60, "the hovered close button is red in the light theme")
    light_kit: kit(p, light, 120)
    dark_kit: kit(p, plain_look(""), 120)
    assert(light_kit != dark_kit && p.kits[light_kit].dark == false && p.kits[dark_kit].dark, "each theme has its own shadow ring")
}

#Test("titles are cut at graphemes, at a word end when one fits") {
    p := painter()
    size: Float{13.0}
    width: (s: String) -> title_width(p.face, s, size)
    assert_eq(fit_title(p, "short", size, 1000.0), "short")
    assert_eq(fit_title(p, "far too long a title", size, 1.0), "")
    assert_eq(fit_title(p, "alpha beta gamma", size, width("alpha beta ga…")), "alpha beta…")
    assert_eq(fit_title(p, "Supercalifragilistic", size, width("Supercal…")), "Supercal…")
    // A combining acute accent (U+0301) stays with its letter.
    acute: String.from_bytes([U8]{U8{101}, U8{204}, U8{129}}) ?? panic("UTF-8 fixture")
    accented: "{acute}{acute}{acute}{acute}{acute}{acute}"
    cut: fit_title(p, accented, size, width("{acute}{acute}…") + width("e") * 0.5)
    assert_eq(cut, "{acute}{acute}…")
}

#Test("the frame's colors meet WCAG 2.2 contrast, focused or not, in both themes") {
    palettes: [Palette]{dark_palette(), light_palette()}
    loop colors in palettes {
        // Titles are text: 4.5:1 on their header, unfocused windows included.
        assert(contrast(colors.text_active, colors.header_active) >= 4.5, "the title is readable")
        assert(contrast(colors.text_inactive, colors.header_inactive) >= 4.5, "an unfocused window's title is readable")
        assert(contrast(colors.glyph_hover, over(colors.button_hover, colors.header_active)) >= 3.0, "a hovered glyph shows")
        // Button glyphs are graphics: 3:1 on their button in every state.
        fills: [Int]{colors.button_idle, colors.button_hover, colors.button_press}
        loop fill in fills {
            assert(contrast(colors.text_active, over(fill, colors.header_active)) >= 3.0, "a button's glyph shows")
            assert(contrast(colors.text_inactive, over(with_alpha(fill, alpha_of(fill) /% 2), colors.header_inactive)) >= 3.0, "an unfocused button's glyph shows")
            assert(contrast(colors.text_inactive, over(fill, colors.header_inactive)) >= 3.0, "a hovered or pressed unfocused button's glyph shows")
        }
        assert(contrast(WHITE, colors.close_hover) >= 3.0, "the hovered close glyph shows")
        assert(contrast(WHITE, colors.close_press) >= 3.0, "the pressed close glyph shows")
        // The focus ring is a graphic: 3:1 on the header, focused or not.
        assert(contrast(colors.focus, colors.header_active) >= 3.0 && contrast(colors.focus, colors.header_inactive) >= 3.0, "the ring shows focused or not")
    }
}

#Test("the title is centered on the window, shifted only to clear the buttons") {
    // A 400-unit window has the space from 10 to 310 for its title (the
    // minimize square starts at 318, and the gap is 8).
    assert_eq(title_left(400.0, 10.0, 310.0, 50.0), Float{175.0})
    // Too wide to center: it moves left just enough to clear the buttons.
    assert_eq(title_left(400.0, 10.0, 310.0, 280.0), Float{30.0})
    // A narrow window's title starts at the left gap.
    assert_eq(title_left(200.0, 10.0, 110.0, 100.0), Float{10.0})
    // The header draws it there: its first inked column is the centered
    // title's.
    p := painter()
    bar: header(p, plain_look("Notes"), 400, 120)
    advance: title_width(p.face, "Notes", Float{13.0})
    first := -1
    loop col in 10..<310 {
        loop row in 6..<28 {
            // Blue byte of B, G, R, A: the header's is 0x0D, the ink's 0xA4.
            if first < 0 && Int.from_u8(bar[(row * 400 + col) * 4]) > 100 -> first = col
        }
    }
    centered: math.round((400.0 - advance) / 2.0)
    assert(first >= centered - 1 && first <= centered + 3, "the short title is centered, first ink at {first}, center start {centered}")
}

#Test("keyboard focus steps through the buttons in reading order and rings the focused one") {
    look: plain_look("")
    assert_eq(next_control(FrameButton.Nothing, 1), FrameButton.Minimize)
    assert_eq(next_control(FrameButton.Nothing, -1), FrameButton.Close)
    assert_eq(next_control(FrameButton.Minimize, 1), FrameButton.Maximize)
    assert_eq(next_control(FrameButton.Maximize, 1), FrameButton.Close)
    assert_eq(next_control(FrameButton.Close, 1), FrameButton.Minimize)
    assert_eq(next_control(FrameButton.Minimize, -1), FrameButton.Close)
    assert_eq(next_control(FrameButton.Close, -1), FrameButton.Maximize)
    // Centers 8 + 9 in from the right edge, then 28 units apart.
    assert_eq(button_center(FrameButton.Close, 300, look), 283)
    assert_eq(button_center(FrameButton.Minimize, 300, look), 227)
    // On a 300-unit window the close square runs from 274 to 292 across, 9
    // units each way from its center at 283; the ring runs from 11 to 12.5
    // out, so pixel (294, 17), 11 to 12 out, is on it.
    p := painter()
    plain: header(p, look, 300, 120)
    focused := plain_look("")
    focused.focus = FrameButton.Close
    ringed: header(p, focused, 300, 120)
    on_ring: (17 * 300 + 294) * 4
    assert_eq(plain[on_ring + 2], U8{0x0B})
    assert(Int.from_u8(ringed[on_ring]) > 0xC0 && Int.from_u8(ringed[on_ring + 1]) > 0xC0 && Int.from_u8(ringed[on_ring + 2]) > 0xC0, "the ring is drawn in the focus ink")
    // In the gap, pixel (293, 17), 10 to 11 out, past the square, the
    // header shows untouched.
    in_gap: (17 * 300 + 293) * 4
    assert_eq(ringed[in_gap + 2], plain[in_gap + 2])
    assert_eq(plain[in_gap + 2], U8{0x0B})
}

#Test("the buttons are centered in the header and their glyphs in their squares, in whole pixels at every scale") {
    p := painter()
    // By hand from `px` at each scale: the inset (8 units), the square's
    // side (the header, 34 units, less the inset twice), the step (28
    // units), the glyph box (10 units, which already has the square's
    // parity) and the stroke (1 unit, at least a pixel).
    scales: [Int]{120, 150, 180, 240}
    insets: [Int]{8, 10, 12, 16}
    sides: [Int]{18, 23, 27, 36}
    steps: [Int]{28, 35, 42, 56}
    glyphs: [Int]{10, 13, 15, 20}
    strokes: [Int]{1, 1, 2, 2}
    // Each glyph's centerline: the X's two diagonals, the box's four sides
    // and the dash, between stroke centers.
    root2: Float{1.4142135623730951}
    loop at in 0..<scales.len() {
        scale: scales[at]
        width: px(300, scale)
        height: px(HEADER, scale)
        rest: header(p, plain_look(""), width, scale)
        end: UIRect{x: width - px(110, scale), y: 0, width: px(110, scale), height: height}
        squares := [UIRect]{}
        loop k in 0..<3 {
            hovered := plain_look("")
            hovered.hover = button_of(k)
            lit: header(p, hovered, width, scale)
            // The soft square is where hovering changed the header.
            square: changed_box(rest, lit, width, end)
            assert_eq([Int]{square.width, square.height}, [Int]{sides[at], sides[at]})
            // Centered down the header: the inset above it and below it.
            assert_eq([Int]{square.y, height - square.y - square.height}, [Int]{insets[at], insets[at]})
            squares.push(square.copy())
            // At rest and hovered, the glyph's ink is centered in the square
            // to half a pixel, as wide as the glyph box, and as tall but for
            // the dash, one stroke tall.
            bars: [[U8]]{rest, lit}
            loop bar in bars {
                base: Int.from_u8(bar[((square.y + square.height /% 2) * width + square.x) * 4 + 1])
                glyph: ink_box(bar, width, square, base, 24)
                assert(within_half(twice_center_x(glyph), twice_center_x(square)) && within_half(twice_center_y(glyph), twice_center_y(square)), "button {k} at {scale}: ink at {glyph.x}, {glyph.y}, {glyph.width} x {glyph.height}, square at {square.x}, {square.y}")
                tall: if k == 2 -> strokes[at] else -> glyphs[at]
                assert_eq([Int]{glyph.width, glyph.height}, [Int]{glyphs[at], tall})
            }
        }
        // The close square's right inset is its top inset, and the squares
        // are a whole step apart.
        assert_eq(width - squares[0].x - squares[0].width, insets[at])
        assert_eq([Int]{squares[0].x - squares[1].x, squares[1].x - squares[2].x}, [Int]{steps[at], steps[at]})
        // The restore glyph fills the same box, centered alike.
        restored := plain_look("")
        restored.maximized = true
        two: ink_box(header(p, restored, width, scale), width, squares[1], 0x0B, 24)
        assert_eq([Int]{two.width, two.height}, [Int]{glyphs[at], glyphs[at]})
        assert(within_half(twice_center_x(two), twice_center_x(squares[1])) && within_half(twice_center_y(two), twice_center_y(squares[1])), "the restore glyph is centered at {scale}")
        // The same weight: each glyph's ink, its summed coverage, per pixel
        // of its centerline is one stroke, to 10%.
        g: Float{glyphs[at]}
        w: Float{strokes[at]}
        lengths: [Float]{2.0 * root2 * (g - w), 4.0 * (g - w), g}
        loop k in 0..<3 {
            weight: ink_cover(rest, width, squares[k], 0x0B, 0x9A) / lengths[k]
            assert(weight >= w * 0.9 && weight <= w * 1.1, "button {k} at {scale} weighs {weight} for a {w}-pixel stroke")
        }
    }
}

#Test("content corners are covered inside the arc only") {
    cover: bottom_left_cover(120)
    assert_eq(cover.len(), 100)
    // Row 9 (the bottom), column 0: outside the squircle. Row 0, column 9:
    // inside.
    assert_eq(cover[9 * 10], U8{0})
    assert_eq(cover[9], U8{255})
}
