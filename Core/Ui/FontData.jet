// Compiler-private data part of core.ui.font: the built-in Atkinson
// Hyperlegible Next 2.001 faces and their license (SIL Open Font License
// 1.1), vendored unchanged beside this file in FontData/ and pinned by
// FontData/SHA256SUMS. Embedded when the compiler builds, so programs never
// read these files at runtime.

FONT_REGULAR: #run embed_bytes("FontData/AtkinsonHyperlegibleNext-Regular.ttf")
FONT_BOLD: #run embed_bytes("FontData/AtkinsonHyperlegibleNext-Bold.ttf")
FONT_LICENSE: #run embed_file("FontData/OFL.txt")
