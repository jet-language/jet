use math: core.math

// core.math.combinatorics — generation over any element type, and the
// counts core.math does not already own.
//
// `permutations` / `combinations` / `product` materialise the full
// collection (Python `itertools` without lazy iterators). Counts use
// exact `Int`; `math.factorial`, `math.binomial` and `math.perm` are the
// single home of the factorial, choose and arrangement counts. Operations
// lists already carry stay list methods: `take_while`, `skip_while`,
// `filter`, `windows`, `chunks`, `chunk_while`, `scan`, `map`, `skip`,
// `take`, `step_by`, `flatten`, `cycle`, `repeat`, `reverse`.

permutations: fn<T>(items: [T], k: Int) -> [[T]] Never! {
    n: items.len()
    if k < 0 || k > n -> return [[T]]{}
    used := [Bool]{}
    loop i in 0..<n -> used.push(false)
    perm_rec<T>(items, k, used, [T]{})
}

combinations: fn<T>(items: [T], k: Int) -> [[T]] Never! {
    n: items.len()
    if k < 0 || k > n -> return [[T]]{}
    comb_rec<T>(items, k, 0, [T]{})
}

combinations_with_replacement: fn<T>(items: [T], k: Int) -> [[T]] Never! {
    if k < 0 -> return [[T]]{}
    comb_rep_rec<T>(items, k, 0, [T]{})
}

product: fn<T>(items: [T], repeat: Int) -> [[T]] Never! {
    if repeat <= 0 -> return [[T]]{[T]{}}
    out := [[T]]{[T]{}}
    r := 0
    loop r < repeat {
        nxt := [[T]]{}
        loop row in out {
            loop x in items {
                cloned := row.copy()
                cloned.push(x.copy())
                nxt.push(cloned)
            }
        }
        out = nxt
        r = r + 1
    }
    out
}

cartesian: fn<T>(left: [T], right: [T]) -> [[T]] Never! {
    out := [[T]]{}
    loop a in left {
        loop b in right -> out.push([T]{a.copy(), b.copy()})
    }
    out
}

perm_rec: fn<T>(items: [T], k: Int, used: [Bool], cur: [T]) -> [[T]] {
    if cur.len() == k -> return [[T]]{cur.copy()}
    out := [[T]]{}
    i := 0
    loop i < items.len() {
        if used[i] == false {
            next_used := used.copy()
            next_used[i] = true
            next_cur := cur.copy()
            next_cur.push(items[i].copy())
            kids: perm_rec<T>(items, k, next_used, next_cur)
            loop row in kids -> out.push(row.copy())
        }
        i = i + 1
    }
    out
}

comb_rec: fn<T>(items: [T], k: Int, start: Int, cur: [T]) -> [[T]] {
    if cur.len() == k -> return [[T]]{cur.copy()}
    out := [[T]]{}
    i := start
    loop i < items.len() {
        next_cur := cur.copy()
        next_cur.push(items[i].copy())
        kids: comb_rec<T>(items, k, i + 1, next_cur)
        loop row in kids -> out.push(row.copy())
        i = i + 1
    }
    out
}

comb_rep_rec: fn<T>(items: [T], k: Int, start: Int, cur: [T]) -> [[T]] {
    if cur.len() == k -> return [[T]]{cur.copy()}
    out := [[T]]{}
    i := start
    loop i < items.len() {
        next_cur := cur.copy()
        next_cur.push(items[i].copy())
        kids: comb_rep_rec<T>(items, k, i, next_cur)
        loop row in kids -> out.push(row.copy())
        i = i + 1
    }
    out
}

multinomial: fn(parts: [Int]) -> Int? Never! {
    n := 0
    loop p in parts {
        if p < 0 -> return None
        n = n + p
    }
    acc := 1
    loop p in parts {
        c: math.binomial(n, p) ?? return None
        acc = acc * c
        n = n - p
    }
    Val(acc)
}

rising_factorial: fn(n: Int, k: Int) -> Int? Never! {
    if k < 0 -> return None
    acc := 1
    i := 0
    loop i < k {
        acc = acc * (n + i)
        i = i + 1
    }
    Val(acc)
}

chain: fn<T>(left: [T], right: [T]) -> [T] Never! {
    out := left.copy()
    loop x in right -> out.push(x.copy())
    out
}

compress: fn<T>(items: [T], mask: [Bool]) -> [T] Never! {
    out := [T]{}
    i := 0
    loop i < items.len() {
        if i < mask.len() && mask[i] -> out.push(items[i].copy())
        i = i + 1
    }
    out
}

unique: fn<T: Equatable>(items: [T]) -> [T] Never! {
    out := [T]{}
    loop x in items {
        seen := false
        loop y in out {
            if y == x -> seen = true
        }
        if seen == false -> out.push(x.copy())
    }
    out
}

count_from: fn(start: Int, step: Int, n: Int) -> [Int] Never! {
    out := [Int]{}
    v := start
    i := 0
    loop i < n {
        out.push(v)
        v = v + step
        i = i + 1
    }
    out
}

tee: fn<T>(items: [T], copies: Int) -> [[T]] Never! {
    out := [[T]]{}
    if copies <= 0 -> return out
    loop _ in 0..<copies -> out.push(items.copy())
    out
}

zip_longest: fn<T>(left: [T], right: [T], fill: T) -> [[T]] Never! {
    out := [[T]]{}
    n := left.len()
    if right.len() > n -> n = right.len()
    i := 0
    loop i < n {
        a: if i < left.len() -> left[i].copy() else -> fill.copy()
        b: if i < right.len() -> right[i].copy() else -> fill.copy()
        out.push([T]{a, b})
        i = i + 1
    }
    out
}

powerset: fn<T>(items: [T]) -> [[T]] Never! {
    out := [[T]]{[T]{}}
    loop x in items {
        nxt := [[T]]{}
        loop row in out {
            nxt.push(row.copy())
            grown := row.copy()
            grown.push(x.copy())
            nxt.push(grown)
        }
        out = nxt
    }
    out
}
