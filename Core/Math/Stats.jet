use {
    math: core.math
    random: core.math.random
}

// core.math.stats — descriptive statistics in exact Int / software Float.
//
// Scalar statistics return `None` for empty, mismatched, non-finite, or
// mathematically undefined inputs. Population variants divide by n; sample
// variants divide by n - 1. Collection transforms return an empty collection
// for invalid dimensions/parameters. Ties in mode preserve the first-seen
// order. Random KDE sampling carries the explicit Rand effect.
//
// mean, sum, rank, min and max follow one rule: any NaN gives no answer
// (None, an empty list, or NaN for sum), and infinities are ordinary values
// wherever the math still has an answer. The mean of both infinities has none.
// mean never overflows when the mean fits, and sum keeps its rounding errors
// and overflows only when the true total is too large.

SlopeIntercept: struct {
    slope: Float
    intercept: Float
}

NormalDist: struct {
    mu: Float
    sigma: Float
}

CovarianceTerms: struct {
    x_scale: Float
    y_scale: Float
    sx: Float
    sy: Float
    xx: Float
    yy: Float
    xy: Float
}

CentralTerms: struct {
    n: Int
    s2: Float
    s3: Float
    s4: Float
}

nonfinite: fn(value: Float) -> Bool Never! {
    if math.is_finite(value) -> return false
    true
}
abs_value: fn(value: Float) -> Float Never! {
    if value < (Float{0.0}) -> return Float{0.0} - value
    value
}
sqrt_value: fn(value: Float) -> Float Never! {
    math.sqrt(value)
}
ln_value: fn(value: Float) -> Float Never! {
    math.ln(value)
}
exp_value: fn(value: Float) -> Float Never! {
    math.exp(value)
}

valid_sample: fn(xs: [Float]) -> Bool Never! {
    loop x in xs {
        if nonfinite(x) -> return false
    }
    true
}
invalid_sample: fn(xs: [Float]) -> Bool Never! {
    if valid_sample(xs) -> return false
    true
}
__holds_nan: fn(xs: [Float]) -> Bool Never! {
    loop x in xs {
        if math.is_nan(x) -> return true
    }
    false
}

copy_floats: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    loop x in xs -> out.push(x)
    out
}
stable_mean: fn(xs: [Float]) -> Float? {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    acc := Float{0.0}
    loop x in xs -> acc = acc + x / scale
    Val((acc / (Float{xs.len()})) * scale)
}

// A Neumaier compensated running total: `total + correction` is the sum.
CompensatedTotal: struct {
    total: Float
    correction: Float
}

__compensated_add: fn(acc: CompensatedTotal, x: Float) -> CompensatedTotal Never! {
    t: acc.total + x
    if abs_value(acc.total) >= abs_value(x) -> return CompensatedTotal{total: t, correction: acc.correction + ((acc.total - t) + x)}
    CompensatedTotal{total: t, correction: acc.correction + ((x - t) + acc.total)}
}

// The sum of finite values whose plain compensated total overflowed. Values of
// magnitude at least 2^-894 are scaled by 2^-128, which is exact, and summed
// apart from the smaller ones, so the scaled total stays below n * 2^896 and
// only the final rescale can overflow: when the true sum is too large.
__compensated_sum_rescaled: fn(xs: [Float]) -> Float Never! {
    threshold: math.ldexp(Float{1.0}, -894)
    down: math.ldexp(Float{1.0}, -128)
    big := CompensatedTotal{total: Float{0.0}, correction: Float{0.0}}
    small := CompensatedTotal{total: Float{0.0}, correction: Float{0.0}}
    loop x in xs {
        if abs_value(x) >= threshold -> big = __compensated_add(big, x * down) else -> small = __compensated_add(small, x)
    }
    (big.total + big.correction) * math.ldexp(Float{1.0}, 128) + (small.total + small.correction)
}

compensated_sum: fn(xs: [Float]) -> Float Never! {
    acc := CompensatedTotal{total: Float{0.0}, correction: Float{0.0}}
    overflowed := false
    positive_inf := false
    negative_inf := false
    loop x in xs {
        if math.is_nan(x) -> return x
        if math.is_inf(x) {
            if x > (Float{0.0}) -> positive_inf = true else -> negative_inf = true
            next
        }
        if overflowed -> next
        next_acc: __compensated_add(acc, x)
        if math.is_inf(next_acc.total) {
            overflowed = true
            next
        }
        acc = next_acc
    }
    if positive_inf && negative_inf -> return math.NAN
    if positive_inf -> return math.INFINITY
    if negative_inf -> return -math.INFINITY
    if overflowed -> return __compensated_sum_rescaled(xs)
    acc.total + acc.correction
}

sift_down: fn(xs: &[Float], start: Int, end: Int) Never! {
    root := start
    loop {
        child: root * 2 + 1
        if child > end -> return
        candidate := root
        if xs[candidate] < xs[child] -> candidate = child
        right: child + 1
        if right <= end && xs[candidate] < xs[right] -> candidate = right
        if candidate == root -> return
        tmp: Float{xs[root]}
        xs[root] = xs[candidate]
        xs[candidate] = tmp
        root = candidate
    }
}

sorted: fn(xs: [Float]) -> [Float] Never! {
    out := copy_floats(xs)
    n: out.len()
    if n < 2 -> return out
    start := (n - 2) /% 2
    loop {
        sift_down(out, start, n - 1)
        if start == 0 -> break
        start = start - 1
    }
    end := n - 1
    loop end > 0 {
        tmp: Float{out[0]}
        out[0] = out[end]
        out[end] = tmp
        end = end - 1
        sift_down(out, 0, end)
    }
    out
}

// Does position `a` sort before position `b`? By value, then by position, so
// the order is the one a stable sort gives.
__position_before: fn(xs: [Float], a: Int, b: Int) -> Bool Never! {
    if xs[a] < xs[b] -> return true
    if xs[b] < xs[a] -> return false
    a < b
}

__sift_positions: fn(xs: [Float], order: &[Int], start: Int, end: Int) Never! {
    root := start
    loop {
        child: root * 2 + 1
        if child > end -> return
        candidate := root
        if __position_before(xs, order[candidate], order[child]) -> candidate = child
        right: child + 1
        if right <= end && __position_before(xs, order[candidate], order[right]) -> candidate = right
        if candidate == root -> return
        tmp: order[root]
        order[root] = order[candidate]
        order[candidate] = tmp
        root = candidate
    }
}

// The positions of NaN-free `xs`, ordered as a stable sort by value orders
// them, in n log n time.
__sorted_positions: fn(xs: [Float]) -> [Int] Never! {
    order := [Int]{}
    loop i in 0..<xs.len() -> order.push(i)
    n: order.len()
    if n < 2 -> return order
    start := (n - 2) /% 2
    loop {
        __sift_positions(xs, order, start, n - 1)
        if start == 0 -> break
        start = start - 1
    }
    end := n - 1
    loop end > 0 {
        tmp: order[0]
        order[0] = order[end]
        order[end] = tmp
        end = end - 1
        __sift_positions(xs, order, 0, end)
    }
    order
}

interpolate: fn(a: Float, b: Float, fraction: Float) -> Float Never! {
    if (a >= (Float{0.0}) && b >= (Float{0.0})) || (a <= (Float{0.0}) && b <= (Float{0.0})) {
        return a + (b - a) * fraction
    }
    a * ((Float{1.0}) - fraction) + b * fraction
}

quantile_sorted: fn(s: [Float], p: Float) -> Float? {
    if s.len() == 0 || p != p || p < (Float{0.0}) || p > (Float{1.0}) -> return None
    if p <= (Float{0.0}) -> return Val(s[0])
    if p >= (Float{1.0}) -> return Val(s[s.len() - 1])
    position: p * (Float{s.len() - 1})
    lower: checked(Int{math.trunc(position)}) ?? panic("quantile position must be finite")
    upper: lower + 1
    if upper >= s.len() -> return Val(s[s.len() - 1])
    fraction: position - (Float{lower})
    Val(interpolate(s[lower], s[upper], fraction))
}

compensated_sum_scaled: fn(xs: [Float], scale: Float) -> Float Never! {
    acc := Float{0.0}
    correction := Float{0.0}
    loop x in xs {
        value: x / scale
        t: acc + value
        if abs_value(acc) >= abs_value(value) {
            correction = correction + ((acc - t) + value)
        } else {
            correction = correction + ((value - t) + acc)
        }
        acc = t
    }
    acc + correction
}
covariance_terms: fn(xs: [Float], ys: [Float]) -> CovarianceTerms? {
    n: xs.len()
    if n == 0 || ys.len() != n || invalid_sample(xs) || invalid_sample(ys) -> return None
    x_scale := Float{0.0}
    y_scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > x_scale -> x_scale = magnitude
    }
    loop y in ys {
        magnitude: abs_value(y)
        if magnitude > y_scale -> y_scale = magnitude
    }
    if x_scale <= (Float{0.0}) || y_scale <= (Float{0.0}) {
        return Val(CovarianceTerms{x_scale: x_scale, y_scale: y_scale, sx: Float{0.0}, sy: Float{0.0}, xx: Float{0.0}, yy: Float{0.0}, xy: Float{0.0}})
    }
    mx: compensated_sum_scaled(xs, x_scale) / (Float{n})
    my: compensated_sum_scaled(ys, y_scale) / (Float{n})
    sx := Float{0.0}
    sy := Float{0.0}
    loop i in 0..<n {
        dx: abs_value(xs[i] / x_scale - mx)
        dy: abs_value(ys[i] / y_scale - my)
        if dx > sx -> sx = dx
        if dy > sy -> sy = dy
    }
    xx := Float{0.0}
    yy := Float{0.0}
    xy := Float{0.0}
    loop i in 0..<n {
        dx := Float{0.0}
        dy := Float{0.0}
        if sx > (Float{0.0}) -> dx = (xs[i] / x_scale - mx) / sx
        if sy > (Float{0.0}) -> dy = (ys[i] / y_scale - my) / sy
        xx = xx + dx * dx
        yy = yy + dy * dy
        xy = xy + dx * dy
    }
    Val(CovarianceTerms{x_scale: x_scale, y_scale: y_scale, sx: sx, sy: sy, xx: xx, yy: yy, xy: xy})
}


central_terms: fn(xs: [Float]) -> CentralTerms? {
    n: xs.len()
    if n == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return None
    m: compensated_sum_scaled(xs, scale) / (Float{n})
    s2 := Float{0.0}
    s3 := Float{0.0}
    s4 := Float{0.0}
    loop x in xs {
        z: x / scale - m
        z2: z * z
        s2 = s2 + z2
        s3 = s3 + z2 * z
        s4 = s4 + z2 * z2
    }
    Val(CentralTerms{n: n, s2: s2, s3: s3, s4: s4})
}

variance_den: fn(xs: [Float], den: Int) -> Float? {
    if den <= 0 || xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    m: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs {
        z: x / scale - m
        acc = acc + z * z
    }
    normalized := acc / (Float{den})
    if normalized < (Float{0.0}) -> return Val(Float{0.0})
    deviation := sqrt_value(normalized) * scale
    if nonfinite(deviation) -> return None
    value := deviation * deviation
    if nonfinite(value) -> return None
    Val(value)
}


sum: fn(xs: [Float]) -> Float Never! { compensated_sum(xs) }

prod: fn(xs: [Float]) -> Float Never! {
    acc := Float{1.0}
    loop x in xs -> acc = acc * x
    acc
}

mean: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || __holds_nan(xs) -> return None
    positive_inf := false
    negative_inf := false
    loop x in xs {
        if x == math.INFINITY -> positive_inf = true
        if x == -math.INFINITY -> negative_inf = true
    }
    if positive_inf && negative_inf -> return None
    if positive_inf -> return Val(math.INFINITY)
    if negative_inf -> return Val(-math.INFINITY)
    stable_mean(xs)
}

fmean: fn(xs: [Float]) -> Float? Never! { mean(xs) }

geometric_mean: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    acc := Float{0.0}
    i := 0
    loop x in xs {
        if x <= (Float{0.0}) -> return None
        log_x: ln_value(x)
        acc = acc + (log_x - acc) / (Float{i + 1})
        i = i + 1
    }
    Val(exp_value(acc))
}

harmonic_mean: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    minimum := xs[0].copy()
    loop x in xs {
        if x <= (Float{0.0}) -> return None
        if x < minimum -> minimum = x.copy()
    }
    acc := Float{0.0}
    loop x in xs -> acc = acc + minimum / x
    if acc <= (Float{0.0}) -> return None
    Val((Float{xs.len()}) * minimum / acc)
}

median: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s: sorted(xs)
    n: s.len()
    mid: n /% 2
    if n % 2 == 1 -> return Val(s[mid])
    Val(interpolate(s[mid - 1], s[mid], (Float{0.5})))
}

median_grouped: fn(xs: [Float], interval: Float) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(interval) || interval <= (Float{0.0}) {
        return None
    }
    s: sorted(xs)
    n: s.len()
    mid: n /% 2
    x: s[mid]
    lower: x - interval / (Float{2.0})
    upper: lower + interval
    below := 0
    frequency := 0
    loop value in s {
        if value < lower -> below += 1
        if value >= lower && value < upper -> frequency += 1
    }
    if frequency == 0 -> return Val(x)
    Val(lower + interval * ((Float{n}) / (Float{2.0}) - (Float{below})) / (Float{frequency}))
}

median_low: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s: sorted(xs)
    n: s.len()
    if n % 2 == 1 -> return Val(s[n /% 2])
    Val(s[n /% 2 - 1])
}

median_high: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    s: sorted(xs)
    Val(s[s.len() /% 2])
}

// The lower and upper middle values of an Int sample, exact: no Float round
// trip, so every Int sample keeps its own value.
median_low_int: fn(xs: [Int]) -> Int? Never! {
    if xs.len() == 0 -> return None
    s := xs.copy()
    s.sort()
    Val(s[(s.len() - 1) /% 2])
}

median_high_int: fn(xs: [Int]) -> Int? Never! {
    if xs.len() == 0 -> return None
    s := xs.copy()
    s.sort()
    Val(s[s.len() /% 2])
}

quantile: fn(xs: [Float], p: Float) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    quantile_sorted(sorted(xs), p)
}

percentile: fn(xs: [Float], pct: Float) -> Float? Never! {
    if pct != pct -> return None
    quantile(xs, pct / (Float{100.0}))
}

mode: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    best := xs[0].copy()
    best_n := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best_n {
            best = x.copy()
            best_n = n
        }
    }
    Val(best)
}

multimode: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) -> return out
    best := 0
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n > best -> best = n
    }
    loop x in xs {
        n := 0
        loop y in xs {
            if y == x -> n = n + 1
        }
        if n == best {
            seen := false
            loop z in out {
                if z == x -> seen = true
            }
            if seen == false -> out.push(x)
        }
    }
    out
}

pvariance: fn(xs: [Float]) -> Float? Never! { variance_den(xs, xs.len()) }

pstdev: fn(xs: [Float]) -> Float? Never! {
    v: pvariance(xs) ?? return None
    Val(sqrt_value(v))
}

variance: fn(xs: [Float]) -> Float? Never! {
    if xs.len() < 2 -> return None
    variance_den(xs, xs.len() - 1)
}

stdev: fn(xs: [Float]) -> Float? Never! {
    v: variance(xs) ?? return None
    Val(sqrt_value(v))
}

covariance: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    n: xs.len()
    if n < 2 || ys.len() != n -> return None
    t: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.sy <= (Float{0.0}) -> return Val(Float{0.0})
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None
    value := (t.xy / (Float{n - 1})) * x_deviation * y_deviation
    if nonfinite(value) -> return None
    Val(value)
}

correlation: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    n: xs.len()
    if n < 2 || ys.len() != n -> return None
    t: covariance_terms(xs, ys) ?? return None
    if t.xx <= (Float{0.0}) || t.yy <= (Float{0.0}) -> return None
    value := t.xy / sqrt_value(t.xx * t.yy)
    if nonfinite(value) -> return None
    if value < (Float{-1.0}) -> return Val(Float{-1.0})
    if value > (Float{1.0}) -> return Val(Float{1.0})
    Val(value)
}

linear_regression: fn(xs: [Float], ys: [Float]) -> SlopeIntercept? Never! {
    n: xs.len()
    if n < 2 || ys.len() != n -> return None
    t: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.xx <= (Float{0.0}) -> return None
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) || x_deviation <= (Float{0.0}) {
        return None
    }
    slope := (t.xy / t.xx) * (y_deviation / x_deviation)
    mx: stable_mean(xs) ?? return None
    my: stable_mean(ys) ?? return None
    intercept := my - slope * mx
    if nonfinite(slope) || nonfinite(intercept) -> return None
    Val(SlopeIntercept{slope: slope, intercept: intercept})
}

normal_dist: fn(mu: Float, sigma: Float) -> NormalDist Never! {
    NormalDist{mu: mu, sigma: sigma}
}

kde: fn(xs: [Float], bandwidth: Float) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{0.0}) {
        return out
    }
    normalizer: (Float{1.0}) / ((Float{xs.len()}) * bandwidth * sqrt_value((Float{2.0}) * math.PI))
    loop point in xs {
        total := Float{0.0}
        loop value in xs {
            z: (point - value) / bandwidth
            total = total + exp_value((Float{-0.5}) * z * z)
        }
        out.push(total * normalizer)
    }
    out
}

kde_random: fn(xs: [Float], bandwidth: Float, n: Int) -[Rand]> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{0.0}) || n <= 0 {
        return out
    }
    loop _ in 0..<n {
        index: random.int(0, xs.len() - 1)
        value := xs[index] + random.normal((Float{0.0}), bandwidth)
        if nonfinite(value) -> return [Float]{}
        out.push(value)
    }
    out
}

zscore: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) -> return out
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return out
    m: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs {
        z: x / scale - m
        acc = acc + z * z
    }
    spread: sqrt_value(acc / (Float{xs.len()}))
    if spread <= (Float{0.0}) -> return out
    loop x in xs -> out.push((x / scale - m) / spread)
    out
}

min: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || __holds_nan(xs) -> return None
    m := xs[0].copy()
    loop x in xs {
        if x < m -> m = x.copy()
    }
    Val(m)
}

max: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || __holds_nan(xs) -> return None
    m := xs[0].copy()
    loop x in xs {
        if x > m -> m = x.copy()
    }
    Val(m)
}

range: fn(xs: [Float]) -> Float? Never! {
    lo: min(xs) ?? return None
    hi: max(xs) ?? return None
    value := hi - lo
    if nonfinite(value) -> return None
    Val(value)
}
cumsum: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) -> return out
    acc := Float{0.0}
    correction := Float{0.0}
    loop x in xs {
        t: acc + x
        if abs_value(acc) >= abs_value(x) {
            correction = correction + ((acc - t) + x)
        } else {
            correction = correction + ((x - t) + acc)
        }
        acc = t
        value: acc + correction
        if nonfinite(value) -> return [Float]{}
        out.push(value)
    }
    out
}

count: fn(xs: [Float]) -> Int Never! { xs.len() }

sumprod: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return None
    acc := Float{0.0}
    correction := Float{0.0}
    loop i in 0..<xs.len() {
        x: xs[i] * ys[i]
        t: acc + x
        if abs_value(acc) >= abs_value(x) {
            correction = correction + ((acc - t) + x)
        } else {
            correction = correction + ((x - t) + acc)
        }
        acc = t
    }
    value := acc + correction
    if nonfinite(value) -> return None
    Val(value)
}
weighted_mean: fn(xs: [Float], weights: [Float]) -> Float? Never! {
    if xs.len() == 0 || xs.len() != weights.len() || invalid_sample(xs) -> return None
    maximum_weight := Float{0.0}
    value_scale := Float{0.0}
    loop i in 0..<xs.len() {
        w: weights[i]
        if nonfinite(w) || w < (Float{0.0}) -> return None
        if w > maximum_weight -> maximum_weight = w
        magnitude: abs_value(xs[i])
        if magnitude > value_scale -> value_scale = magnitude
    }
    if maximum_weight <= (Float{0.0}) -> return None
    if value_scale <= (Float{0.0}) -> return Val(Float{0.0})
    numerator := Float{0.0}
    denominator := Float{0.0}
    loop i in 0..<xs.len() {
        scaled_weight: weights[i] / maximum_weight
        numerator = numerator + (xs[i] / value_scale) * scaled_weight
        denominator = denominator + scaled_weight
    }
    if denominator <= (Float{0.0}) -> return None
    value := (numerator / denominator) * value_scale
    if nonfinite(value) -> return None
    Val(value)
}

quantiles: fn(xs: [Float], n: Int) -> [Float] Never! {
    out := [Float]{}
    if n <= 1 || xs.len() == 0 || invalid_sample(xs) -> return out
    s: sorted(xs)
    i := 1
    loop i < n {
        q: quantile_sorted(s, (Float{i}) / (Float{n})) ?? return [Float]{}
        out.push(q)
        i = i + 1
    }
    out
}

iqr: fn(xs: [Float]) -> Float? Never! {
    q1: quantile(xs, (Float{0.25})) ?? return None
    q3: quantile(xs, (Float{0.75})) ?? return None
    value := q3 - q1
    if nonfinite(value) -> return None
    Val(value)
}

mad: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    m: median(xs) ?? return None
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    center := m / scale
    dev := [Float]{}
    loop x in xs -> dev.push(abs_value(x / scale - center))
    d: median(dev) ?? return None
    value := d * scale
    if nonfinite(value) -> return None
    Val(value)
}

mean_abs_deviation: fn(xs: [Float]) -> Float? Never! {
    if xs.len() == 0 || invalid_sample(xs) -> return None
    scale := Float{0.0}
    loop x in xs {
        magnitude: abs_value(x)
        if magnitude > scale -> scale = magnitude
    }
    if scale <= (Float{0.0}) -> return Val(Float{0.0})
    m: compensated_sum_scaled(xs, scale) / (Float{xs.len()})
    acc := Float{0.0}
    loop x in xs -> acc = acc + abs_value(x / scale - m)
    value := (acc / (Float{xs.len()})) * scale
    if nonfinite(value) -> return None
    Val(value)
}

skew: fn(xs: [Float]) -> Float? Never! {
    n: xs.len()
    if n < 3 -> return None
    t: central_terms(xs) ?? return None
    variance: t.s2 / (Float{t.n})
    if variance <= (Float{0.0}) -> return None
    root: sqrt_value(variance)
    Val((t.s3 / (Float{t.n})) / (root * root * root))
}

kurtosis: fn(xs: [Float]) -> Float? Never! {
    n: xs.len()
    if n < 4 -> return None
    t: central_terms(xs) ?? return None
    variance: t.s2 / (Float{t.n})
    if variance <= (Float{0.0}) -> return None
    Val((t.s4 / (Float{t.n})) / (variance * variance) - (Float{3.0}))
}

moving_average: fn(xs: [Float], window: Int) -> [Float] Never! {
    out := [Float]{}
    if window <= 0 || invalid_sample(xs) -> return out
    acc := Float{0.0}
    i := 0
    loop i < xs.len() {
        acc = acc + xs[i]
        if i >= window -> acc = acc - xs[i - window]
        if nonfinite(acc) -> return [Float]{}
        width := i + 1
        if width > window -> width = window
        value := acc / (Float{width})
        if nonfinite(value) -> return [Float]{}
        out.push(value)
        i = i + 1
    }
    out
}

ewma: fn(xs: [Float], alpha: Float) -> [Float] Never! {
    out := [Float]{}
    if xs.len() == 0 || invalid_sample(xs) || nonfinite(alpha) -> return out
    a := alpha
    if a < (Float{0.0}) -> a = (Float{0.0})
    if a > (Float{1.0}) -> a = (Float{1.0})
    acc := xs[0].copy()
    out.push(acc)
    i := 1
    loop i < xs.len() {
        acc = a * xs[i] + ((Float{1.0}) - a) * acc
        if nonfinite(acc) -> return [Float]{}
        out.push(acc)
        i = i + 1
    }
    out
}

cumprod: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) -> return out
    acc := Float{1.0}
    loop x in xs {
        acc = acc * x
        if nonfinite(acc) -> return [Float]{}
        out.push(acc)
    }
    out
}

diff: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() < 2 || invalid_sample(xs) -> return out
    i := 1
    loop i < xs.len() {
        value := xs[i] - xs[i - 1]
        if nonfinite(value) -> return [Float]{}
        out.push(value)
        i = i + 1
    }
    out
}

// Positions are one-based in input order; ties share their average position.
// One sort of the positions and one pass over the tie groups.
rank: fn(xs: [Float]) -> [Float] Never! {
    out := [Float]{}
    if __holds_nan(xs) -> return out
    n: xs.len()
    order: __sorted_positions(xs)
    loop _ in 0..<n -> out.push(Float{0.0})
    start := 0
    loop start < n {
        end := start + 1
        loop end < n && xs[order[end]] == xs[order[start]] {
            end = end + 1
        }
        shared: (Float{start + 1 + end}) / (Float{2.0})
        loop k in start..<end -> out[order[k]] = shared
        start = end
    }
    out
}

spearman: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    if xs.len() != ys.len() -> return None
    correlation(rank(xs), rank(ys))
}

r_squared: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    n: xs.len()
    if n < 2 || ys.len() != n -> return None
    _: linear_regression(xs, ys) ?? return None
    r: correlation(xs, ys) ?? return None
    Val(r * r)
}

residuals: fn(xs: [Float], ys: [Float]) -> [Float] Never! {
    out := [Float]{}
    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return out
    fit: linear_regression(xs, ys) ?? return out
    loop i in 0..<xs.len() {
        value := ys[i] - (fit.slope * xs[i] + fit.intercept)
        if nonfinite(value) -> return [Float]{}
        out.push(value)
    }
    out
}

histogram: fn(xs: [Float], bins: Int) -> [Int] Never! {
    out := [Int]{}
    if bins <= 0 || xs.len() == 0 || invalid_sample(xs) -> return out
    lo: min(xs) ?? return out
    hi: max(xs) ?? return out
    loop _ in 0..<bins -> out.push(0)
    if lo == hi {
        out[0] = xs.len()
        return out
    }
    scale := abs_value(lo)
    if abs_value(hi) > scale -> scale = abs_value(hi)
    loop x in xs {
        t := Float{0.0}
        if scale > (Float{0.0}) {
            lower: lo / scale
            upper: hi / scale
            value: x / scale
            t = (value - lower) / (upper - lower)
        }
        idx := checked(Int{math.trunc(t * (Float{bins}))}) ?? panic("histogram position must be finite")
        if idx < 0 -> idx = 0
        if idx >= bins -> idx = bins - 1
        out[idx] = out[idx] + 1
    }
    out
}

describe: fn(xs: [Float]) -> (max: Float, mean: Float, median: Float, min: Float, n: Int, q1: Float, q3: Float, stdev: Float) Never! {
    empty := (max: (Float{0.0}), mean: (Float{0.0}), median: (Float{0.0}), min: (Float{0.0}), n: 0, q1: (Float{0.0}), q3: (Float{0.0}), stdev: (Float{0.0}))
    if xs.len() == 0 || invalid_sample(xs) -> return empty
    return (
        max: max(xs) ?? (Float{0.0}),
        mean: mean(xs) ?? (Float{0.0}),
        median: median(xs) ?? (Float{0.0}),
        min: min(xs) ?? (Float{0.0}),
        n: xs.len(),
        q1: quantile(xs, (Float{0.25})) ?? (Float{0.0}),
        q3: quantile(xs, (Float{0.75})) ?? (Float{0.0}),
        stdev: stdev(xs) ?? (Float{0.0}),
    )
}

clip: fn(xs: [Float], lo: Float, hi: Float) -> [Float] Never! {
    out := [Float]{}
    if invalid_sample(xs) || nonfinite(lo) || nonfinite(hi) -> return out
    lower := lo
    upper := hi
    if lower > upper {
        swap := lower.copy()
        lower = upper
        upper = swap
    }
    loop x in xs {
        v := x.copy()
        if v < lower -> v = lower
        if v > upper -> v = upper
        out.push(v)
    }
    out
}

winsorize: fn(xs: [Float], p: Float) -> [Float] Never! {
    if invalid_sample(xs) || p != p || p < (Float{0.0}) || p > (Float{0.5}) -> return [Float]{}
    lo: quantile(xs, p) ?? return [Float]{}
    hi: quantile(xs, (Float{1.0}) - p) ?? return [Float]{}
    clip(xs, lo, hi)
}

pearson: fn(xs: [Float], ys: [Float]) -> Float? Never! { correlation(xs, ys) }

covariance_population: fn(xs: [Float], ys: [Float]) -> Float? Never! {
    n: xs.len()
    if n == 0 || ys.len() != n -> return None
    t: covariance_terms(xs, ys) ?? return None
    if t.sx <= (Float{0.0}) || t.sy <= (Float{0.0}) -> return Val(Float{0.0})
    x_deviation := t.sx * t.x_scale
    y_deviation := t.sy * t.y_scale
    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None
    value := (t.xy / (Float{n})) * x_deviation * y_deviation
    if nonfinite(value) -> return None
    Val(value)
}
