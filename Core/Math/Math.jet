/// The cube root of x, correctly rounded (CORE-MATH cbrt.c): odd in x, exact
/// at every exact cube, and +-0, +-inf and NaN return themselves.
cbrt: fn(n: Float) -> Float Never! {
    hx: to_bits(n)
    mant := hx.bit_and(0xF_FFFF_FFFF_FFFF)
    e := (hx >> 52).bit_and(0x7FF)
    if (e + 1).bit_and(0x7FF) < 2 {
        ix: hx.bit_and(0x7FFF_FFFF_FFFF_FFFF)
        if e == 0x7FF || ix == 0 -> return n + n
        // subnormal: normalize the significand
        nz: 53 - __bit_len(ix)
        mant = (mant << nz).bit_and(0xF_FFFF_FFFF_FFFF)
        e = e - (nz - 1)
    }
    e = e + 3072
    et: e /% 3
    ei: e %% 3
    // cbrt(x) = cbrt(zz) 2^(et - 1365) with 1 <= |zz| < 8, and
    // cbrt(zz) = cbrt(z) * {1, 2^(1/3), 2^(2/3)}[ei] with 1 <= z < 2
    neg: hx < 0
    z: from_bits(mant.bit_or(0x3FF0_0000_0000_0000))
    zm: from_bits(mant.bit_or((0x3FF + ei) << 52))
    zz: if neg -> -zm else -> zm
    escale: __CBRT_ESCALE[ei]
    isc: if neg -> -escale else -> escale
    r: Float{1.0} / z
    rscale: __CBRT_RSCALE[ei]
    rr: if neg -> -(r * rscale) else -> r * rscale
    z2: z * z
    c0: Float{0.5528234184016472} + z * Float{0.5871142918266982}
    c2: Float{-0.16296967194987905} + z * Float{0.02310496411078147}
    y0: c0 + z2 * c2
    h0: y0 * y0 * (y0 * r) - Float{1.0}
    // a cubic Newton step on 1 - z/y^3
    y: (y0 - (h0 * y0) * (Float{0.3333333333333333} - Float{0.2222222222222222} * h0)) * isc
    // then a linear one on zz, with y^3 in double-double
    s: __cbrt_step(y, zz, rr)
    y1 := s.hi
    dy := s.lo
    ady := fabs(dy)
    if (fabs(ady - Float{1.1102230246251565e-16}) < Float{2.6469779601696886e-23}) || (fabs(ady - Float{3.3306690738754696e-16}) < Float{2.6469779601696886e-23}) {
        t: __cbrt_step(y1, zz, rr)
        y1 = t.hi
        dy = t.lo
        ady = fabs(dy)
        if (fabs(ady - Float{1.1102230246251565e-16}) < Float{3.1554436208840472e-30}) || (fabs(ady - Float{3.3306690738754696e-16}) < Float{3.1554436208840472e-30}) {
            azz: fabs(zz)
            if (azz == Float{3.2146036897957497}) -> y1 = copysign(Float{1.4758508835342132}, zz)
            if (azz == Float{6.531417795099968}) -> y1 = copysign(Float{1.86925759992312}, zz)
        }
    }
    // the scaled magnitude; its low 34 bits near 0 or 2^34 flag an exact cube
    mag := to_bits(fabs(y1)) + ((et - 342 - 1023) << 52)
    low: mag.bit_and(0x3_FFFF_FFFF)
    if low <= 1 || low == 0x3_FFFF_FFFF {
        rounded: copysign(from_bits((to_bits(fabs(y1)) + 0x8000).bit_and(0x7FFF_FFFF_FFFF_0000)), y1)
        if (fabs((rounded - y1) - dy) < Float{8.673617379884035e-19}) || (fabs(zz) == Float{1.0}) -> mag = (mag + 0x8000).bit_and(0x7FFF_FFFF_FFFF_0000)
    }
    if neg -> return -from_bits(mag)
    from_bits(mag)
}
__CBRT_ESCALE: [Float]{1.0, 1.2599210498948732, 1.5874010519681996}
__CBRT_RSCALE: [Float]{1.0, 0.5, 0.25}
// One Newton step of cbrt.c: y - dy for zz^(1/3) with y^3 in double-double
// (rr ~ 1/zz), as hi + lo with |lo| < ulp(hi)/2.
__cbrt_step: fn(y: Float, zz: Float, rr: Float) -> (hi: Float, lo: Float) Never! {
    y2: y * y
    y2l: fma(y, y, -y2)
    y3: y2 * y
    y3l: fma(y, y2, -y3) + y * y2l
    h: ((y3 - zz) + y3l) * rr
    dy: h * (y * Float{0.3333333333333333})
    y1: y - dy
    (hi: y1, lo: (y - y1) - dy)
}
/// cos x, correctly rounded (CORE-MATH cos.c): 1 for |x| < 2^-27, and NaN
/// for an infinity.
cos: fn(n: Float) -> Float Never! {
    z: fabs(n)
    e: __to_bits_i64(z) >> 52
    if e < 0x3E4 -> return fma(n, -n, Float{1.0})
    if e < 0x41E -> return __cos_moderate(z)
    if e == 0x7FF -> return __pi_trig_special(n)
    __cos_large(z)
}
/// cosh x, correctly rounded (CORE-MATH cosh.c): even in x, at least 1, +inf
/// from about +-710.48 out, and NaN for NaN.
cosh: fn(n: Float) -> Float Never! {
    ax: fabs(n)
    aix: to_bits(ax)
    if aix < 0x3FC0_0000_0000_0000 {
        if aix < 0x3E50_0000_0000_0000 -> return fma(ax, Float{2.7755575615628914e-17}, 1.0)
        x2: n * n
        x4: x2 * x2
