/// tgamma.c from musl 1.2.5: Lanczos approximation with g = 6.0246800407767296,
/// the error of x + g - 0.5 carried separately, exact factorials for small
/// whole arguments and the reflection formula below zero.
gamma: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    negative: bits < 0
    ix: (bits >> 32).bit_and(2147483647)
    // gamma(nan) = nan, gamma(inf) = inf, gamma(-inf) = nan
    if ix >= 2146435072 -> return n + INFINITY
    // |x| < 2^-54: gamma(x) ~ 1/x
    if ix < 1016070144 -> return Float{1.0} / n
    if n == floor(n) {
        if negative -> return Float{0.0} / Float{0.0}
        if (n <= Float{23.0}) -> return __GAMMA_FACTORIALS[(Int.from_float(n) ?? 1) - 1]
    }
    // x >= 184: inf with overflow; x <= -184: +-0 with underflow
    if ix >= 1080492032 {
        if negative {
            if (floor(n) * Float{0.5} == floor(n * Float{0.5})) -> return Float{0.0}
            return -Float{0.0}
        }
        return n * Float{8.98846567431158e+307}
    }
    absx: if negative -> -n else -> n
    // the error of x + g - 0.5
    y: absx + Float{5.52468004077673}
    dy := Float{0.0}
    if (absx > Float{5.52468004077673}) {
        dy = y - absx
        dy = dy - Float{5.52468004077673}
    } else {
        dy = y - Float{5.52468004077673}
        dy = dy - absx
    }
    z := absx - Float{0.5}
    r := __gamma_lanczos(absx) * exp(-y)
    if (n < Float{0.0}) {
        // reflection; sin(pi*x) is not 0, whole arguments returned above
        r = -PI / (__gamma_sin_pi(absx) * absx * r)
        dy = -dy
        z = -z
    }
    r = r + dy * (Float{5.52468004077673} + Float{0.5}) * r / y
    power: y.pow(Float{0.5} * z)
    r * power * power
}
// musl tgamma.c S(): the Lanczos rational function for positive x, evaluated
// in 1/x from 8 up so it cannot overflow.
__gamma_lanczos: fn(x: Float) -> Float Never! {
    numerator := Float{0.0}
    denominator := Float{0.0}
    if (x < Float{8.0}) {
        i := 12
        loop i >= 0 {
            numerator = numerator * x + __GAMMA_NUMERATOR[i]
            denominator = denominator * x + __GAMMA_DENOMINATOR[i]
            i = i - 1
        }
    } else {
        loop i in 0..<13 {
            numerator = numerator / x + __GAMMA_NUMERATOR[i]
            denominator = denominator / x + __GAMMA_DENOMINATOR[i]
        }
    }
    numerator / denominator
}
__GAMMA_NUMERATOR: [Float]{23531376880.41076, 42919803642.6491, 35711959237.35567, 17921034426.03721, 6039542586.352028, 1439720407.3117216, 248874557.86205417, 31426415.585400194, 2876370.6289353725, 186056.26539522348, 8071.672002365816, 210.82427775157936, 2.5066282746310002}
__GAMMA_DENOMINATOR: [Float]{0.0, 39916800.0, 120543840.0, 150917976.0, 105258076.0, 45995730.0, 13339535.0, 2637558.0, 357423.0, 32670.0, 1925.0, 66.0, 1.0}
// n! for 1 <= n <= 23, gamma(n + 1).
__GAMMA_FACTORIALS: [Float]{1.0, 1.0, 2.0, 6.0, 24.0, 120.0, 720.0, 5040.0, 40320.0, 362880.0, 3628800.0, 39916800.0, 479001600.0, 6227020800.0, 87178291200.0, 1307674368000.0, 20922789888000.0, 355687428096000.0, 6402373705728000.0, 121645100408832000.0, 2432902008176640000.0, 51090942171709440000.0, 1.1240007277776077e+21}
// musl's sin(pi * x) for x > 2^-100 inside tgamma and lgamma (tgamma.c
// sinpi(), lgamma_r.c sin_pi()), not the correctly rounded sin_pi: x mod 2
// reduced into [-1/4, 1/4] around a multiple of 1/2, then the __sin.c and
// __cos.c kernels.
__gamma_sin_pi: fn(n: Float) -> Float Never! {
    x := Float{2.0} * (n * Float{0.5} - floor(n * Float{0.5}))
    quadrant := Int.from_float(trunc(Float{4.0} * x)) ?? 0
    quadrant = (quadrant + 1) /% 2
    x = (x - Float{quadrant} * Float{0.5}) * PI
    if quadrant == 1 -> return __kernel_cos(x)
    if quadrant == 2 -> return __kernel_sin(-x)
    if quadrant == 3 -> return -__kernel_cos(x)
    __kernel_sin(x)
}
// musl __sin.c with no tail: sin on [-pi/4, pi/4].
__kernel_sin: fn(x: Float) -> Float Never! {
    z: x * x
    w: z * z
    r: Float{0.00833333333332249} + z * (Float{-0.0001984126982985795} + z * Float{0.0000027557313707070068}) + z * w * (Float{-2.5050760253406863e-8} + z * Float{1.58969099521155e-10})
    x + z * x * (Float{-0.16666666666666632} + z * r)
}
// musl __cos.c with no tail: cos on [-pi/4, pi/4].
__kernel_cos: fn(x: Float) -> Float Never! {
    z: x * x
    w: z * z
    r: z * (Float{0.0416666666666666} + z * (Float{-0.001388888888887411} + z * Float{0.00002480158728947673})) + w * w * (Float{-2.7557314351390663e-7} + z * (Float{2.087572321298175e-9} + z * Float{-1.1359647557788195e-11}))
    hz: Float{0.5} * z
    one_minus: Float{1.0} - hz
    one_minus + (((Float{1.0} - one_minus) - hz) + z * r)
