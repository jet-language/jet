// (ch + cl) xh as a double-double, cl xh's rounding error dropped.
__exp2_cr_mulddd: fn(xh: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    h: ch * xh
    (hi: h, lo: cl * xh + fma(ch, xh, -h))
}
// The n (hi, lo) coefficients of c at the double xh, Horner in
// double-double.
__exp2_cr_polydd: fn(xh: Float, c: [Float], n: Int) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    ch := c[2 * i]
    cl := c[2 * i + 1]
    loop i > 0 {
        i = i - 1
        p: __exp2_cr_mulddd(xh, ch, cl)
        th: p.hi + c[2 * i]
        tl: (c[2 * i] - th) + p.hi
        ch = th
        cl = p.lo + (tl + c[2 * i + 1])
    }
    (hi: ch, lo: cl)
}
// exp2's accurate path: a degree-6 double-double polynomial in the
// reduced 4096 x, then __EXP2CR_HARD's exceptions.
__exp2_cr_accurate: fn(n: Float) -> Float Never! {
    sx: Float{4096.0} * n
    fx: round_even(sx)
    z: sx - fx
    k: __whole_i64(fx)
    i1: Int{k.bit_and(0x3F)}
    i0: Int{(k >> 6).bit_and(0x3F)}
    ie: k >> 12
    tt: __exp_cr_muldd(__EXP2CR_T0[2 * i0 + 1], __EXP2CR_T0[2 * i0], __EXP2CR_T1[2 * i1 + 1], __EXP2CR_T1[2 * i1])
    f0: __exp2_cr_polydd(z, __EXP2CR_CD, 6)
    f1: __exp2_cr_mulddd(z, f0.hi, f0.lo)
    fh := f1.hi
    fl := f1.lo
    bits: __to_bits_i64(n)
    if bits >= 0 || bits.bit_and(0x7FFF_FFFF_FFFF_FFFF) <= 0x408F_F000_0000_0000 {
        if (n >= Float{-8.008566259537294e-17}) && (n <= Float{1.6017132519074586e-16}) -> return fma(n, Float{0.5}, Float{1.0})
        if k.bit_and(0xFFF) == 0 {
            // 4096 x is a multiple of 4096: th + tl is 1
            a: __fast_two_sum(tt.hi, fh)
            b: __fast_two_sum(a.lo, fl)
            fh = a.hi
            fl = b.hi
            if __to_bits_i64(fl).bit_and(0x000F_FFFF_FFFF_FFFF) == 0 {
                // fl a power of 2: the sticky e moves it one unit
                step: if (__to_bits_i64(fl) < 0) != (__to_bits_i64(b.lo) < 0) -> I64{-1} else -> I64{1}
                fl = __from_bits_i64(__to_bits_i64(fl) + step)
            }
        } else {
            p: __exp_cr_muldd(fh, fl, tt.hi, tt.lo)
            s: __fast_two_sum(tt.hi, p.hi)
            fh = s.hi
            fl = (tt.lo + p.lo) + s.lo
        }
        r: __fast_two_sum(fh, fl)
        fh = r.hi
        if (__to_bits_i64(r.lo) + 2).bit_and(0x000F_FFFF_FFFF_FFFF) <= 2 -> fh = __exp_cr_listed(n, fh, __EXP2CR_HARD, 0x0034_C797_3B21_6FBD_5FD7_665F, 8677191773140, Float{5.551115123125783e-17})
        return __exp_cr_scale(fh, ie)
    }
    p: __exp_cr_muldd(fh, fl, tt.hi, tt.lo)
    s: __fast_two_sum(tt.hi, p.hi)
    sl: (tt.lo + p.lo) + s.lo
    u: __fast_two_sum(__from_bits_i64((1 - ie) << 52), s.hi)
    __exp_cr_subnormal(u.hi + (sl + u.lo))
}
// The exceptions of exp2's, exp10's and exp_m1's accurate paths (their
// CORE-MATH databases): for xs's m-th input, the result before the 2^ie
// scaling is y + dy, y within one unit of f with its low two bits at 2m in
// low, and dy = tail, negated where neg has bit m set. f otherwise.
__exp_cr_listed: fn(n: Float, f: Float, xs: [Float], low: Int, neg: Int, tail: Float) -> Float Never! {
    loop m in 0..<xs.len() {
        if xs[m] == n {
            p: (low >> (2 * m)).bit_and(3)
            dy: if (neg >> m).bit_and(1) == 1 -> -tail else -> tail
            fb: __to_bits_i64(f)
            loop j in 0..<3 {
                yb: fb + I64{j} - 1
                if yb.bit_and(3) == (I64{p}) -> return __from_bits_i64(yb) + dy
            }
        }
    }
    f
}
// 10^dx - 1 for the reduced |dx| <= log10(2)/8192: degree 1 to 6 as
// (hi, lo).
__EXP10CR_C: [Float]{
