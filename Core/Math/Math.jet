// asin_pi for |x| < 2^-53, zero included: x / pi in double-double, rounded
// once, and its hard cases.
__asin_pi_tiny: fn(x: Float) -> Float Never! {
    if (x == Float{0.0}) -> return x
    au: to_bits(x).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    t: Float{2.409919865102884e-181}
    if (au << 12).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0x59AF_9A11_94EF_E000 {
        // every +-0x1.59af9a1194efep-e sits next to a rounding boundary
        one: if (x > Float{0.0}) -> Float{1.0} else -> Float{-1.0}
        s: from_bits(to_bits(one) - ((0x3C9 - (au >> 52)) << 52))
        return fma(Float{1.5407439555097885e-33}, s, Float{2.3860092221731257e-17} * s)
    }
    if au == 0x35_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(t, -t, Float{3.859243931873672e-308})
        return fma(t, t, Float{-3.859243931873672e-308})
    }
    if au == 0x15_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(-t, t, Float{9.64810982968418e-309})
        return fma(t, t, Float{-9.64810982968418e-309})
    }
    if au == 0x16_8E64_8254_9DB1 {
        if (x > Float{0.0}) -> return fma(t, t, Float{9.984835630268913e-309})
        return fma(-t, t, Float{-9.984835630268913e-309})
    }
    if au == 0x25_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(-t, t, Float{1.929621965936836e-308})
        return fma(t, t, Float{-1.929621965936836e-308})
    }
    // h is exact: x times the high part of 1/pi before any scaling
    h: x * Float{0.3183098861837907}
    sx: x * Float{8.112963841460668e31}
    l := fma(sx, Float{0.3183098861837907}, -h * Float{8.112963841460668e31})
    l = fma(sx, Float{-1.9678676675182486e-17}, l)
    fma(l, Float{1.232595164407831e-32}, h)
}
// asin_pi for 2^-53 <= |x| < 2^-26: x / pi + x^3 / (6 pi) in double-double,
// and its hard cases.
__asin_pi_small: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    i := 0
    loop i < 18 {
        if (ax == __ASINPI_SMALL_HARD[3 * i]) {
            r: __ASINPI_SMALL_HARD[3 * i + 1] + __ASINPI_SMALL_HARD[3 * i + 2]
            if (x > Float{0.0}) -> return r
            return -r
        }
        i = i + 1
    }
    ch: Float{0.3183098861837907}
    l: fma(Float{0.05305164769729846}, x * x, Float{-1.967867667518249e-17})
    hh: ch * x
    ll := fma(ch, x, -hh)
    ll = fma(l, x, ll)
    hh + ll
}
// asin_pi when the fast path cannot round: asin(|x|) in 128-bit fixed point
// to within a few units of 2^-127, with no early exit.
__asin_pi_acc: fn(x: Float) -> Float Never! {
