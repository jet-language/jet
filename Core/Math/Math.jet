/// The gamma function, correctly rounded (C23 tgamma; CORE-MATH tgamma.c):
/// +-inf at +-0, NaN at negative whole x and at -inf, and +inf from
/// 171.62437695630274.
gamma: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return n + n
    if n == INFINITY -> return n
    if n == -INFINITY -> return n / n
    ax: fabs(n)
    if (ax < Float{0.25}) {
        // below 2^-112, gamma(x) = 1/x - 0.5772... rounds as 1/x; 1/2^-1024
        // overflows but gamma(2^-1024) rounds to +inf too
        if (ax < Float{1.925929944387236e-34}) {
            if n == from_bits(0x4_0000_0000_0000) -> return Float{1.7976931348623157e308} + Float{9.9792015476736e291}
            return Float{1.0} / n
        }
        x2: n * n
        x4: x2 * x2
        x8: x4 * x4
        c: __TGAMMA_TINY_C
        c0: (c[0] + n * c[1]) + x2 * (c[2] + n * c[3])
        c4: (c[4] + n * c[5]) + x2 * (c[6] + n * c[7])
        c8: (c[8] + n * c[9]) + x2 * (c[10] + n * c[11])
        c12: (c[12] + n * c[13]) + x2 * (c[14] + n * c[15])
        p: __gamma_polyddd(n, __TGAMMA_TINY_CC, 0, 5, n * ((c0 + x4 * c4) + x8 * (c8 + x4 * c12)))
        fh: Float{1.0} / n
        f: __fast_sum_dd(fh, fma(fh, -n, Float{1.0}) * fh, p.hi, p.lo)
        eps: f.hi * (Float{3.5e-19} + (x2 * x4) * Float{4e-15})
        ub: f.hi + (f.lo + eps)
        if ub == f.hi + (f.lo - eps) -> return ub
        return __tgamma_accurate(n)
    }
    if (n >= Float{171.62437695630274}) -> return Float{1.7415152243978685e308} + Float{1.7415152243978685e308}
    fx: floor(n)
    if fx == n {
        if (n < Float{0.0}) -> return Float{0.0} / Float{0.0}
        // (n - 1)! exactly in double-double up to 23!, then rounded once
        k: Int.from_float(fx) ?? 0
        th := Float{1.0}
        tl := Float{0.0}
        x0 := Float{1.0}
        i := 1
        loop i < k {
            t: __exp2_cr_mulddd(x0, th, tl)
            th = t.hi
            tl = t.lo
            x0 = x0 + Float{1.0}
            i = i + 1
        }
        return th + tl
    }
    // below -184, |gamma(x)| < 2^-1078 rounds to a zero of the sign of
    // (-1)^floor(x)
    if (n <= Float{-184.0}) -> return if (Int.from_float(fx) ?? 0) % 2 == 0 -> Float{0.0} else -> Float{-0.0}
    if (n < Float{-3.0}) {
        // reflection: gamma(x) = pi / (sin(pi x) gamma(1 - x)), gamma(1 - x)
        // as e^lgamma(1 - x) 2^e
        y: __fast_two_sum(-n, Float{1.0})
        lg: __tgamma_lgamma_asym(y.hi, y.lo)
        ex: __tgamma_exp(lg.hi, lg.lo)
        ip: Int.from_float(fx) ?? 0
        sp: __gamma_sin_pi(n - fx, __TGAMMA_SIN_PI_T)
        l: __exp_cr_muldd(sp.hi, sp.lo, ex.hi, ex.lo)
        pih: Float{3.141592653589793}
        rcp: Float{1.0} / l.hi
        rh0: rcp * pih
        rl0: rcp * ((Float{1.2246467991473532e-16} - l.lo * rh0) - fma(rh0, l.hi, -pih))
        rh: if ip % 2 != 0 -> -rh0 else -> rh0
        rl: if ip % 2 != 0 -> -rl0 else -> rl0
        eps: rh * (Float{8.7e-21} - n * Float{1.46e-22})
        if ip < -170 {
            re: (to_bits(rh) >> 52).bit_and(0x7FF)
            if re - ex.e <= 0 {
                // a subnormal result: round rh + 2^(e - 1022) where its last
                // bit is 2^-1074 once scaled, then clear the exponent field
                s: __fast_two_sum(copysign(ldexp(Float{1.0}, ex.e - 1022), rh), rh)
                sl: rl + s.lo
                sub: s.hi + (sl + eps)
                if sub != s.hi + (sl - eps) -> return __tgamma_accurate(n)
                return from_bits(to_bits(sub).bit_and(-0x7FF0_0000_0000_0001))
            }
        }
        ub: rh + (rl + eps)
        if ub != rh + (rl - eps) -> return __tgamma_accurate(n)
        return ldexp(ub, -ex.e)
    }
    if (n > Float{4.0}) {
        lg: __tgamma_lgamma_asym(n, Float{0.0})
        ex: __tgamma_exp(lg.hi, lg.lo)
        eps: ex.hi * (Float{2e-21} + n * Float{1.84e-22})
        ub: ex.hi + (ex.lo + eps)
        if ub != ex.hi + (ex.lo - eps) -> return __tgamma_accurate(n)
        return ldexp(ub, ex.e)
    }
    // -3 <= x <= 4: gamma(x) = gamma(x + j) / (x (x + 1) ... (x + j - 1)),
    // x + j within 1/2 of 3.5
    i: round_even(n - Float{3.5})
    d: n - (i + Float{3.5})
    d2: d * d
    d4: d2 * d2
    c: __TGAMMA_MID_C
    f: __gamma_polyddd(d, __TGAMMA_MID_CC, 0, 10, d * (((c[0] + d * c[1]) + d2 * (c[2] + d * c[3])) + d4 * ((c[4] + d * c[5]) + d2 * (c[6] + d * c[7]))))
    jm: Int.from_float(fabs(i)) ?? 0
    wh := Float{1.0}
    wl := Float{0.0}
    if jm != 0 {
        xph := n
        xpl := Float{0.0}
        wh = n
        j := jm - 1
        loop j > 0 {
            s: if (fabs(xph) > Float{1.0}) -> __fast_two_sum(xph, Float{1.0}) else -> __fast_two_sum(Float{1.0}, xph)
            xph = s.hi
            xpl = xpl + s.lo
            w: __exp_cr_muldd(xph, xpl, wh, wl)
            wh = w.hi
            wl = w.lo
            j = j - 1
        }
    }
    rh: Float{1.0} / wh
    g: __exp_cr_muldd(rh, (fma(rh, -wh, Float{1.0}) - wl * rh) * rh, f.hi, f.lo)
    eps: g.hi * Float{1e-21}
    ub: g.hi + (g.lo + eps)
    if ub != g.hi + (g.lo - eps) -> return __tgamma_accurate(n)
    ub
}
// tgamma.c as_tgamma_accurate: gamma(x) for finite x where the fast paths
// cannot round, from a triple-double-led polynomial on pieces of x and the
// hard cases.
__tgamma_accurate: fn(x: Float) -> Float Never! {
    if (fabs(x) < Float{0.25}) {
        x2: x * x
        x4: x2 * x2
        c: __TGAMMA_ACC0_C
        c0: (c[0] + x * c[1]) + x2 * (c[2] + x * c[3])
        c4: (c[4] + x * c[5]) + x2 * (c[6] + x * c[7])
        p: __gamma_polyddd(x, __TGAMMA_ACC0_CC, 0, 28, x * (c0 + x4 * c4))
        fh: Float{1.0} / x
        dh: fma(fh, -x, Float{1.0})
        fl0: dh * fh
        s: __two_sum_dd(fl0, fma(fl0, -x, dh) * fh, p.hi, p.lo)
        t: __two_sum(s.hi, s.lo)
        u: __fast_two_sum(fh, t.hi)
        v: __fast_two_sum(u.lo, t.lo)
        // fh + fl a tie: break it by the sign of the third part
        et: __fast_two_sum(u.hi, Float{2.0} * v.hi)
        if (et.lo == Float{0.0}) {
            if (copysign(Float{1.0}, v.hi) * copysign(Float{1.0}, v.lo) > Float{0.0}) -> return u.hi + v.hi * (Float{1.0} + Float{8.881784197001252e-16})
            return u.hi + v.hi * (Float{1.0} - Float{8.881784197001252e-16})
        }
        return u.hi + v.hi
    }
    ix: floor(x)
    d: Float{2.0} * (x - (ix + Float{0.5}))
    i: Int.from_float(ix) ?? 0
    seg := 0
    loop seg < 8 && i <= __TGAMMA_ACC_SEG[7 * seg] {
        seg = seg + 1
    }
    sg: 7 * seg
    f: __gamma_poly3(d, __TGAMMA_ACC_SEG[sg + 3], __TGAMMA_ACC_SEG[sg + 4], __TGAMMA_ACC_SEG[sg + 5], __TGAMMA_ACC_SEG[sg + 6])
    jm: __TGAMMA_ACC_SEG[sg + 1] - i
    eoff := __TGAMMA_ACC_SEG[sg + 2]
    wh := Float{1.0}
    wl := Float{0.0}
    if jm > 0 {
        // x (x + 1) ... (x + jm - 1), rescaled by 2^-500 as it grows
        xph := x
        xpl := Float{0.0}
        wh = x
        j := jm - 1
        loop j > 0 {
            s: if (fabs(xph) > Float{1.0}) -> __fast_two_sum(xph, Float{1.0}) else -> __fast_two_sum(Float{1.0}, xph)
            t: __fast_two_sum(s.hi, xpl + s.lo)
            xph = t.hi
            xpl = t.lo
            w: __gamma_mul_dd3(xph, xpl, wh, wl)
            wh = w.hi
            wl = w.lo
            if (fabs(wh) > Float{8.580997075163262e155}) {
                wh = wh * Float{3.054936363499605e-151}
                wl = wl * Float{3.054936363499605e-151}
                eoff = eoff - 500
            }
            j = j - 1
        }
    } else if jm < 0 {
        // (x - 1) (x - 2) ... (x + jm)
        xph := x - Float{1.0}
        xpl := Float{0.0}
        wh = xph
        j := -1 - jm
        loop j > 0 {
            s: __fast_two_sum(xph, Float{-1.0})
            t: __fast_two_sum(s.hi, xpl + s.lo)
            xph = t.hi
            xpl = t.lo
            w: __gamma_mul_dd3(xph, xpl, wh, wl)
            wh = w.hi
            wl = w.lo
            j = j - 1
        }
    }
    fh := f.hi
    fl := f.lo
    if jm > 0 {
        rh: Float{1.0} / wh
        g: __gamma_mul_dd3(fh, fl, rh, (fma(rh, -wh, Float{1.0}) - wl * rh) * rh)
        fh = g.hi
        fl = g.lo
    } else if jm < 0 {
        g: __gamma_mul_dd3(fh, fl, wh, wl)
        fh = g.hi
        fl = g.lo
    }
    eps: Float{1.8488927466117464e-31} * fh
    r: fh + fl
    re: (to_bits(r) >> 52).bit_and(0x7FF)
    res := Float{0.0}
    if re + eoff <= 0 {
        // a subnormal result, rounded once as in gamma's reflection
        s: __fast_two_sum(copysign(ldexp(Float{1.0}, -1022 - eoff), r), fh)
        res = from_bits(to_bits(s.hi + (fl + s.lo)).bit_and(-0x7FF0_0000_0000_0001))
    } else {
        res = ldexp(r, eoff)
    }
    if fh + (fl + eps) != fh + (fl - eps) {
        h: __hard_case(__TGAMMA_HARD, x)
        if !is_nan(h) -> return h
    }
    res
}
// tgamma.c poly3: sum ch[k] d^k with d^k carried as a triple-double t0 + t1 +
// t2, t0 kept to multiples of 2^-25 so t0 ch[k] is exact, plus the
// double-double polynomial of cl; ch and cl are runs of __TGAMMA_ACC_CH and
// __TGAMMA_ACC_CL.
__gamma_poly3: fn(d: Float, ch: Int, nh: Int, cl: Int, nl: Int) -> (hi: Float, lo: Float) Never! {
    t0 := Float{1.0}
    t1 := Float{0.0}
    t2 := Float{0.0}
    s0 := __TGAMMA_ACC_CH[ch]
    s1 := Float{0.0}
    s2 := Float{0.0}
    i := 1
    loop i < nh {
        // sprod: d (t0 + t1 + t2) as the triple t0 + t1 + t2 again
        z0: d * t0
        z0l: fma(d, t0, -z0)
        z1: d * t1
        z2: d * t2 + fma(d, t1, -z1)
        zh: (z0 + Float{201326592.0}) - Float{201326592.0}
        e: __fast_two_sum(z0 - zh, z0l)
        l1: __two_sum(e.hi, z1)
        t0 = zh
        t1 = l1.hi
        t2 = (l1.lo + e.lo) + z2
        c: __TGAMMA_ACC_CH[ch + i]
        s0 = s0 + t0 * c
        p: __exp2_cr_mulddd(c, t1, t2)
        s: __two_sum_dd(s1, s2, p.hi, p.lo)
        s1 = s.hi
        s2 = s.lo
        i = i + 1
    }
    q: __gamma_polyddd(d, __TGAMMA_ACC_CL, cl, nl, Float{0.0})
    s: __two_sum_dd(s1, s2, q.hi, q.lo)
    a: __fast_two_sum(s0, s.hi)
    (hi: a.hi, lo: a.lo + s.lo)
}
// tgamma.c muldd3: (xh + xl) (yh + yl) renormalized, all four products kept.
__gamma_mul_dd3: fn(xh: Float, xl: Float, yh: Float, yl: Float) -> (hi: Float, lo: Float) Never! {
    ch: xh * yh
    __fast_two_sum(ch, fma(xh, yh, -ch) + ((xl * yl + xh * yl) + xl * yh))
}
// tgamma.c's and lgamma.c's polyddd: the n (hi, lo) pairs of c from index o
// at the double x, Horner in double-double with two-sums, l added to the top
// coefficient.
__gamma_polyddd: fn(x: Float, c: [Float], o: Int, n: Int, l: Float) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    t: __fast_two_sum(c[o + 2 * i], l)
    ch := t.hi
    cl := t.lo + c[o + 2 * i + 1]
    loop i > 0 {
        i = i - 1
        p: __exp2_cr_mulddd(x, ch, cl)
        s: __two_sum_dd(c[o + 2 * i], c[o + 2 * i + 1], p.hi, p.lo)
        ch = s.hi
        cl = s.lo
    }
    (hi: ch, lo: cl)
}
// tgamma.c's and lgamma.c's as_logd: ln(x) as a double-double for x > 0, by
// log2's reduction to r (1 + m 2^-52) - 1 with r = r1[i1] r2[i2].
__gamma_log: fn(x: Float) -> (hi: Float, lo: Float) Never! {
    // a subnormal x scaled by 2^52 into the normal range
    sub: (to_bits(x) >> 52) == 0
    b: if sub -> to_bits(x * Float{4503599627370496.0}) else -> to_bits(x)
    ed: Float{(b >> 52) - (if sub -> 1075 else -> 1023)}
    m: b.bit_and(0xF_FFFF_FFFF_FFFF)
    i: m >> 47
    d: m.bit_and(0x7FFF_FFFF_FFFF)
    j: (m + (__LOG2CR_B[2 * i] << 33) + __LOG2CR_B[2 * i + 1] * (d >> 16)) >> 42
    i1: j >> 5
    i2: j.bit_and(31)
    tf: from_bits(m.bit_or(0x3FF0_0000_0000_0000))
    r: __GAMMA_LOG_R1[i1] * __LOG2CR_R2[i2]
    o: r * tf
    dxl: fma(r, tf, -o)
    dxh: o - Float{1.0}
    dx: fma(r, tf, Float{-1.0})
    dx2: dx * dx
    c: __GAMMA_LOG_C
    f: dx2 * ((c[0] + dx * c[1]) + dx2 * (c[2] + dx * c[3]))
    lt: (__GAMMA_LOG_L1[2 * i1 + 1] + __GAMMA_LOG_L2[2 * i2 + 1]) + ed * Float{0.6931471805437468}
    lh: lt + dxh
    ll: (((lt - lh) + dxh) + (((__GAMMA_LOG_L1[2 * i1] + __GAMMA_LOG_L2[2 * i2]) + Float{1.619851018665656e-11} * ed) + dxl)) + f
    (hi: lh, lo: ll)
}
// tgamma.c as_sinpid and lgamma.c as_sinpipid: sin(pi x) (t sin(pi i/128))
// or sin(pi x)/pi (t sin(pi i/128)/pi) as a double-double for 0 <= x < 1, as
// cos(pi (x - 1/2)) from t at the nearest multiple of 1/128.
__gamma_sin_pi: fn(x: Float, t: [Float]) -> (hi: Float, lo: Float) Never! {
    v: fabs(x - Float{0.5}) * Float{128.0}
    iv: round_even(v)
    d: iv - v
    d2: d * d
    ky: Int.from_float(iv) ?? 0
    kx: 64 - ky
    sh: t[2 * kx + 1]
    sl: t[2 * kx]
    pc: d2 * (Float{1.5119880908790113e-8} + d2 * (Float{-3.0360360343398624e-13} + d2 * Float{3.2658548907715e-18}))
    ps: d2 * (Float{-0.0000024641574764489986} + d2 * (Float{7.421954185251001e-11} + d2 * Float{-1.0645026354944996e-15}))
    q: __fast_two_sum(Float{0.02454369260617026}, ps)
    cs: __exp_cr_muldd(q.hi, q.lo + Float{9.567540887362087e-19}, t[2 * ky + 1], t[2 * ky])
    tc: __fast_two_sum(Float{-0.0003011964233730883}, pc)
    td: __exp2_cr_mulddd(d, tc.hi, tc.lo + Float{-1.912015617779642e-20})
    p: __exp_cr_muldd(td.hi, td.lo, sh, sl)
    u: __fast_sum_dd(cs.hi, cs.lo, p.hi, p.lo)
    w: __exp2_cr_mulddd(d, u.hi, u.lo)
    __fast_sum_dd(sh, sl, w.hi, w.lo)
}
// tgamma.c as_expd: e^(xh + xl) as (hi + lo) 2^e, by x 1024/ln(2) = k + y,
// 2^(k/1024) from two tables and 2^(y/1024) - 1 by a polynomial.
__tgamma_exp: fn(xh: Float, xl: Float) -> (hi: Float, lo: Float, e: Int) Never! {
    t: __exp_cr_muldd(xh, xl, Float{1477.3197218702985}, Float{2.0843800310713378e-14})
    kf: round_even(t.hi)
    y: __fast_two_sum(t.hi - kf, t.lo)
    k: Int.from_float(kf) ?? 0
    i0: (k >> 5).bit_and(31)
    i1: k.bit_and(31)
    r: __exp_cr_muldd(__TGAMMA_EXP_T0[2 * i0 + 1], __TGAMMA_EXP_T0[2 * i0], __TGAMMA_EXP_T1[2 * i1 + 1], __TGAMMA_EXP_T1[2 * i1])
    c: __TGAMMA_EXP_C
    fl: y.hi * (c[2] + y.hi * (c[4] + y.hi * (c[6] + y.hi * c[8])))
    f0: __fast_two_sum(c[0], fl)
    f: __exp_cr_muldd(y.hi, y.lo, f0.hi, f0.lo + c[1])
    g: __fast_two_sum(Float{1.0}, f.hi)
    p: __exp_cr_muldd(r.hi, r.lo, g.hi, f.lo + g.lo)
    (hi: p.hi, lo: p.lo, e: k >> 10)
}
// tgamma.c as_lgamma_asym: ln(gamma(x)) for x = xh + xl > 3 as a
// double-double, Stirling's (x - 1/2) (ln(x) - 1) plus a series in 1/x.
__tgamma_lgamma_asym: fn(xh: Float, xl: Float) -> (hi: Float, lo: Float) Never! {
    zh: Float{1.0} / xh
    dz: xl * zh
    zl: (fma(zh, -xh, Float{1.0}) - dz) * zh
    lg: __gamma_log(xh)
    m: __exp_cr_muldd(xh - Float{0.5}, xl, lg.hi - Float{1.0}, lg.lo + dz)
    z2: __exp_cr_muldd(zh, zl, zh, zl)
    x2: z2.hi * z2.hi
    lh := Float{0.0}
    ll := Float{0.0}
    fh := Float{0.0}
    fl := Float{0.0}
    if (xh > Float{11.5}) {
        c: __TGAMMA_ASYM_FAR
        l: __fast_sum_dd(m.hi, m.lo, c[0], c[1])
        lh = l.hi
        ll = l.lo
        tail: z2.hi * ((c[4] + z2.hi * c[6]) + x2 * ((c[8] + z2.hi * c[10]) + x2 * (c[12] + z2.hi * c[14])))
        s: __fast_two_sum(c[2], tail)
        fh = s.hi
        fl = c[3] + s.lo
    } else {
        c: __TGAMMA_ASYM_NEAR
        l: __fast_sum_dd(m.hi, m.lo, c[0], c[1])
        lh = l.hi
        ll = l.lo
        x4: x2 * x2
        q4: (c[14] + z2.hi * c[16]) + x2 * ((c[18] + z2.hi * c[20]) + x2 * (c[22] + z2.hi * c[24]))
        q0: ((c[6] + z2.hi * c[8]) + x2 * (c[10] + z2.hi * c[12])) + x4 * q4
        s: __fast_two_sum(c[4], z2.hi * q0)
        p: __exp_cr_muldd(z2.hi, z2.lo, s.hi, c[5] + s.lo)
        s2: __fast_two_sum(c[2], p.hi)
        fh = s2.hi
        fl = (c[3] + p.lo) + s2.lo
    }
    f: __exp_cr_muldd(zh, zl, fh, fl)
    __fast_sum_dd(lh, ll, f.hi, f.lo)
}
