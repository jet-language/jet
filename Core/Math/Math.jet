    r: num - k * ln2
    rerr: nerr + (if k < 0 -> -k else -> k) + 1
    // e^(-|r| / 2^8) or e^(|r| / 2^8) by Taylor terms, each within 2 units
    ra: (if r < 0 -> -r else -> r) >> 8
    raerr: (rerr >> 8) + 2
    q := one
    a := one
    i := 0
