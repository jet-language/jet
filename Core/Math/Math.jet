struct I8x16 {
    lanes: [I8#16]
}
impl I8x16 {
    fn new(l0: I8, l1: I8, l2: I8, l3: I8, l4: I8, l5: I8, l6: I8, l7: I8, l8: I8, l9: I8, l10: I8, l11: I8, l12: I8, l13: I8, l14: I8, l15: I8) -> I8x16 Never! { I8x16{lanes: [I8#16]{l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15}} }
    fn splat(value: I8) -> I8x16 Never! { I8x16{lanes: [I8#16]{value, value, value, value, value, value, value, value, value, value, value, value, value, value, value, value}} }
    fn from_array(lanes: [I8#16]) -> I8x16 Never! { I8x16{lanes: lanes} }
    fn to_array(self) -> [I8#16] Never! { self.lanes.copy() }
    fn lane(self, index: Int) -> I8 Never! {
        if index < 0 || index >= 16 -> core.math.__numeric_stop("lane index {index} out of range for I8x16 (16 lanes)")
        self.lanes[index]
    }
    fn sum(self) -> I8 Never! {
        value := I8{0}
        loop i in 0..<16 -> value = value + self.lanes[i]
        value
    }
    fn product(self) -> I8 Never! {
        value := I8{1}
        loop i in 0..<16 -> value = value * self.lanes[i]
        value
    }
    fn min(self) -> I8 Never! {
        value := self.lanes[0]
        loop i in 1..<16 {
            if self.lanes[i] < value -> value = self.lanes[i]
        }
        value
    }
    fn max(self) -> I8 Never! {
        value := self.lanes[0]
        loop i in 1..<16 {
            if self.lanes[i] > value -> value = self.lanes[i]
        }
        value
    }
    fn reduce_add(self) -> I8 Never! { self.sum() }
    fn reduce_mul(self) -> I8 Never! { self.product() }
    fn reduce_min(self) -> I8 Never! { self.min() }
    fn reduce_max(self) -> I8 Never! { self.max() }
    fn reduce_avg(self) -> I8 Never! { self.sum() / I8{16} }
    fn reduce(self, op: ReduceOp) -> I8 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl I8x16.Add {
    fn add(self, rhs: I8x16) -> I8x16 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<16 -> lanes[i] = lanes[i] + rhs.lanes[i]
        I8x16{lanes: lanes}
    }
