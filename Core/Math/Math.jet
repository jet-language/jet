// ln_1p's fast path for -1 < x <= -2^-4 and 2^-4 <= x < inf as (hi, lo,
// err): 1 + x = t + dt, then t = 2^je v with r v - 1 small for rf's r.
__ln_1p_cr_large: fn(n: Float, b: Int) -> (hi: Float, lo: Float, err: Float) Never! {
    dt0: if b < 0x4690_0000_0000_0000 -> Float{1.0} else -> Float{0.0}
    s: if b < 0x4340_0000_0000_0000 -> __fast_two_sum(Float{1.0}, n) else -> (hi: n, lo: dt0)
    j: to_bits(s.hi) - 0x3FE6_A000_0000_0000
    j1: (j >> 46).bit_and(0x3F)
    je: j >> 52
    big: je >= 1022
    // near the top of the range t and dt shrink instead of rf's r growing
    sc: if big -> from_bits((2044 - je) << 52) else -> Float{1.0}
    rb: to_bits(__LOG1PCR_RF[j1])
    rs: if big -> from_bits(rb - (1021 << 52)) else -> from_bits(rb - (je << 52))
    t: if big -> s.hi * sc else -> s.hi
    dt: if big -> s.lo * sc else -> s.lo
