// asin_pi for |x| < 2^-53, zero included: x / pi in double-double, rounded
// once, and its hard cases.
__asin_pi_tiny: fn(x: Float) -> Float Never! {
    if (x == Float{0.0}) -> return x
    au: to_bits(x).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    t: Float{2.409919865102884e-181}
    if (au << 12).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0x59AF_9A11_94EF_E000 {
        // every +-0x1.59af9a1194efep-e sits next to a rounding boundary
        one: if (x > Float{0.0}) -> Float{1.0} else -> Float{-1.0}
        s: from_bits(to_bits(one) - ((0x3C9 - (au >> 52)) << 52))
        return fma(Float{1.5407439555097885e-33}, s, Float{2.3860092221731257e-17} * s)
    }
    if au == 0x35_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(t, -t, Float{3.859243931873672e-308})
        return fma(t, t, Float{-3.859243931873672e-308})
    }
    if au == 0x15_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(-t, t, Float{9.64810982968418e-309})
        return fma(t, t, Float{-9.64810982968418e-309})
    }
    if au == 0x16_8E64_8254_9DB1 {
        if (x > Float{0.0}) -> return fma(t, t, Float{9.984835630268913e-309})
        return fma(-t, t, Float{-9.984835630268913e-309})
    }
    if au == 0x25_CBA8_9AF1_F855 {
        if (x > Float{0.0}) -> return fma(-t, t, Float{1.929621965936836e-308})
        return fma(t, t, Float{-1.929621965936836e-308})
    }
    // h is exact: x times the high part of 1/pi before any scaling
    h: x * Float{0.3183098861837907}
    sx: x * Float{8.112963841460668e31}
    l := fma(sx, Float{0.3183098861837907}, -h * Float{8.112963841460668e31})
    l = fma(sx, Float{-1.9678676675182486e-17}, l)
    fma(l, Float{1.232595164407831e-32}, h)
}
// asin_pi for 2^-53 <= |x| < 2^-26: x / pi + x^3 / (6 pi) in double-double,
// and its hard cases.
__asin_pi_small: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    i := 0
    loop i < 18 {
        if (ax == __ASINPI_SMALL_HARD[3 * i]) {
            r: __ASINPI_SMALL_HARD[3 * i + 1] + __ASINPI_SMALL_HARD[3 * i + 2]
            if (x > Float{0.0}) -> return r
            return -r
        }
        i = i + 1
    }
    ch: Float{0.3183098861837907}
    l: fma(Float{0.05305164769729846}, x * x, Float{-1.967867667518249e-17})
    hh: ch * x
    ll := fma(ch, x, -hh)
    ll = fma(l, x, ll)
    hh + ll
}
// asin_pi when the fast path cannot round: asin(|x|) in 128-bit fixed point
// to within a few units of 2^-127, with no early exit.
__asin_pi_acc: fn(x: Float) -> Float Never! {
    u: to_bits(x).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    se := (u >> 52).bit_and(0x7FF) - 0x3FF
    ax: fabs(x)
    sm: (u << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
    fi := 0
    if (ax < Float{0.0131875}) {
        // asin(y) = y + y^3 P(y^2), y = |x| scaled into [0, 2^-6)
        fi = __u128(((sm >> 1) << 64) + __mul_hi64_128(sm >> 1, __asin_pi_poly((sm * sm) >> (-14 - 2 * se))))
        se = se + 0x3FF
    } else {
        xx: fma(x, -x, Float{1.0})
        c: sqrt(xx)
        ixx: (Float{1.0} / xx) * c
        x2: x * x
        c0 := Float{63.96459584605448} + ax * Float{-39.39065080729959}
        c2: Float{23.579467473196825} + ax * Float{-7.445150988059025}
        c0 = c0 + x2 * c2
        indx: (to_bits(c0 * c + Float{64.0}).bit_and(0xF_FFFF_FFFF_FFFF) + 0x2000_0000_0000) >> 46
        cu: to_bits(c)
        cm: (cu << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
        ce: (cu >> 52) - 0x3FF
        // two Newton steps take sqrt(1 - x^2) to 128 bits as cmv
        s := __u128(__u128((sm * sm) << (52 + 2 * se)) + __u128((cm * cm) << (52 + 2 * ce)))
        iu: to_bits(ixx)
        ixm: iu.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
        ixe: (iu >> 52) - 0x3FF
        dc: __mh(__wrap_i64(s >> 64), ixm)
        s = __u128(s - __u128((dc * (cm >> 1)) << 13))
        sc: 28 - 2 * ixe
        dsm3: if sc >= 0 -> (dc * dc) >> sc else -> __u128((dc * dc) << -sc)
        s = __u128(s + dsm3)
        k: ixe - ce
        ss: 24 + k
        // dc 2^ss; C builds it from two words, which only works for ss < 64
        cmv := __u128((cm << 64) - (dc << ss))
        dc2: __mh(__wrap_i64(s >> 14), ixm)
        ss2: 26 - k
        cmv = if ss2 >= 0 -> __u128(cmv - (dc2 >> ss2)) else -> __u128(cmv - (dc2 << -ss2))
        // y_i = (64 - indx) pi / 128 plus asin of the rotated remainder
        fi = __u128(0x0324_3F6A_8885_A308_D313_198A_2E03_7073 * (64 - indx))
        if indx == 0 {
            cmv = cmv >> (-ce - 7)
            cmv = __u128(cmv + __mul_hi128(cmv, __asin_pi_poly(__sqr_hi128(cmv))))
            fi = __u128(fi - (cmv >> 7))
        } else {
            v: __wrap_i128(__mul_hi64_128(sm >> -se, __asin_pi_acc_s(indx - 1)) - (__mul_hi128(cmv, __asin_pi_acc_s(63 - indx)) >> -ce))
            vu: __u128(v)
            v2 := __sqr_hi128(vu)
            if v < 0 -> v2 = __u128(v2 - (v + v))
            p: __asin_pi_poly(__u128(v2 << 14))
            w := __mul_hi128(p, vu)
            if v < 0 -> w = w - p
            fi = __u128(fi + v + w)
        }
        se = 0x3FE
    }
    __asin_pi_round(__asin_pi_div_pi(fi), se, u.bit_and(0x8000_0000_0000_0000))
}
// asin(x) - x for x / 2^128 in [0, 2^-6): x^3 / 6 + ... in 2^128 units.
__asin_pi_poly: fn(x: Int) -> Int Never! {
    xh: x >> 64
    m: 0xFFFF_FFFF_FFFF_FFFF
    tl: (__muuh(xh, (0x5BA2_E8BA_2E8A_D9B7 + __muuh(xh, (0x4_713B_13B2_9079 + __muuh(xh, (0x39_3331_E196 + __muuh(xh, 0x2F5_C315)).bit_and(m))).bit_and(m))).bit_and(m)) + 0x1C71_C71C_71C7_6217).bit_and(m)
    t: (0x7C7 << 64) + tl
    c2: __u128(0xB6_DB6D_B6DB_6DB6_DB6D_A950 + __mul_hi128(x, t))
    c1: __u128(0x13_3333_3333_3333_3333_3333_3484 + __mul_hi128(x, c2))
    __mul_hi128(x, __u128(0x2_AAAA_AAAA_AAAA_AAAA_AAAA_AAAA_AAA5 + __mul_hi128(x, c1)))
}
// fi / pi in the same 2^127 fixed point, with 1/pi rounded down to 127 bits.
__asin_pi_div_pi: fn(fi: Int) -> Int Never! {
    bh: fi >> 64
    bl: fi.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    __u128(0x517C_C1B7_2722_0A94 * bh + ((0x517C_C1B7_2722_0A94 * bl) >> 64) + ((0xFE13_ABE8_FA9A_6EE0 * bh) >> 64))
}
// The Float of fi / 2^127 scaled by 2^(e - 0x3FE), rounded to nearest from
// its top bits, with sign bit xsign.
__asin_pi_round: fn(fi: Int, e: Int, xsign: Int) -> Float Never! {
    bh: fi >> 64
    nz: __clz64(bh)
    rnd: (bh >> (10 - nz)).bit_and(1)
    from_bits(__wrap_i64((bh >> (11 - nz)) + ((e - nz) << 52).bit_or(rnd) + xsign))
}
__asin_pi_acc_s: fn(i: Int) -> Int Never! { (__ASINPI_ACC_S[2 * i] << 64) + __ASINPI_ACC_S[2 * i + 1] }
// 64- and 128-bit unsigned words of the CORE-MATH ports as Ints: the high
// word of a product, C's wraparound, and leading zeros.
__muuh: fn(a: Int, b: Int) -> Int Never! { (a * b) >> 64 }
__mh: fn(a: Int, b: Int) -> Int Never! { (a * b) >> 64 }
__u128: fn(v: Int) -> Int Never! { v.bit_and(0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF) }
__wrap_i128: fn(v: Int) -> Int Never! {
    w: __u128(v)
    if w > 0x7FFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF -> return w - 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF - 1
    w
}
__clz64: fn(v: Int) -> Int Never! { 64 - exact_bit_length(v) }
// The high 128 bits of a * b, from the three partial products that reach them.
__mul_hi128: fn(a: Int, b: Int) -> Int Never! {
    ah: a >> 64
    al: a.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    bh: b >> 64
    bl: b.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    __u128(ah * bh + ((al * bh) >> 64) + ((ah * bl) >> 64))
}
// a * b / 2^64 for a 64-bit a and a 128-bit b, truncated per partial product.
__mul_hi64_128: fn(a: Int, b: Int) -> Int Never! { __u128(a * (b >> 64) + ((a * b.bit_and(0xFFFF_FFFF_FFFF_FFFF)) >> 64)) }
// The high 128 bits of a^2, from the two partial products that reach them.
__sqr_hi128: fn(a: Int) -> Int Never! {
    ah: a >> 64
    __u128(ah * ah + ((a.bit_and(0xFFFF_FFFF_FFFF_FFFF) * ah) >> 63))
}
