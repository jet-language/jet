        ta: sx * __ATANPI_A[2 * i]
        al = sx * __ATANPI_A[2 * i + 1] + Float{4.2111741079360304e-17} * id
        h = (n - ta) / (Float{1.0} + n * ta)
        ah = Float{0.012271846303085088} * id
    }
    h2: h * h
    h4: h2 * h2
    f: (Float{1.0} + h2 * Float{-0.333333333333331}) + h4 * (Float{0.1999999997326265} + h2 * Float{-0.1428473928322857})
    al = fma(h, f, al)
    ub0: (al + h * Float{8.743006318923108e-16}) + ah
    t: __fast_two_sum(ah, al)
    p: __mul_dd(t.hi, t.lo, ph, pl)
    e: h * Float{2.7842311789427754e-16}
    ub: (p.lo + e) + p.hi
    lb: (p.lo - e) + p.hi
    if ub == lb -> return ub
    __atan_pi_refine(n, ub0)
