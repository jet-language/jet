    se := (u >> 52).bit_and(0x7FF) - 0x3FF
    ax: fabs(x)
    sm: (u << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
    fi := 0
    if (ax < Float{0.0131875}) {
        // asin(y) = y + y^3 P(y^2), y = |x| scaled into [0, 2^-6)
        fi = __u128(((sm >> 1) << 64) + __mul_hi64_128(sm >> 1, __asin_pi_poly((sm * sm) >> (-14 - 2 * se))))
        se = se + 0x3FF
    } else {
        xx: fma(x, -x, Float{1.0})
        c: sqrt(xx)
        ixx: (Float{1.0} / xx) * c
        x2: x * x
        c0 := Float{63.96459584605448} + ax * Float{-39.39065080729959}
        c2: Float{23.579467473196825} + ax * Float{-7.445150988059025}
        c0 = c0 + x2 * c2
        indx: (to_bits(c0 * c + Float{64.0}).bit_and(0xF_FFFF_FFFF_FFFF) + 0x2000_0000_0000) >> 46
        cu: to_bits(c)
        cm: (cu << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
        ce: (cu >> 52) - 0x3FF
        // two Newton steps take sqrt(1 - x^2) to 128 bits as cmv
        s := __u128(__u128((sm * sm) << (52 + 2 * se)) + __u128((cm * cm) << (52 + 2 * ce)))
        iu: to_bits(ixx)
        ixm: iu.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
        ixe: (iu >> 52) - 0x3FF
        dc: __mh(__wrap_i64(s >> 64), ixm)
        s = __u128(s - __u128((dc * (cm >> 1)) << 13))
        sc: 28 - 2 * ixe
        dsm3: if sc >= 0 -> (dc * dc) >> sc else -> __u128((dc * dc) << -sc)
        s = __u128(s + dsm3)
