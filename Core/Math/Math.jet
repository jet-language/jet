// fi / pi in the same 2^127 fixed point, with 1/pi rounded down to 127 bits.
__asin_pi_div_pi: fn(fi: Int) -> Int Never! {
    bh: fi >> 64
    bl: fi.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    __u128(0x517C_C1B7_2722_0A94 * bh + ((0x517C_C1B7_2722_0A94 * bl) >> 64) + ((0xFE13_ABE8_FA9A_6EE0 * bh) >> 64))
