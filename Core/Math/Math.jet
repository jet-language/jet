            w = (sig: v.sig, ex: v.ex, sgn: 1)
        }
        err = 346
    }
    if (x < Float{0.0}) {
        // the opposite quadrant: plus or minus 1
        one: (sig: 1 << 191, ex: 1, sgn: 0)
        if w.sgn == 0 {
            v: __tint_add(one, (sig: w.sig, ex: w.ex, sgn: 1))
            w = (sig: v.sig, ex: v.ex, sgn: 1)
