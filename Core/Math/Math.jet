// ln, log2 and log10 off the positive finite Floats: NaN for NaN and below
// 0, -inf at a zero, +inf at +inf.
__log_cr_special: fn(n: Float) -> Float Never! {
    if is_nan(n) || n == INFINITY -> return n + n
    if n == 0.0 -> return -INFINITY
    NAN
}
// log(x) for a positive finite x as a double-double within 2^-68.22 (the
// fast paths of CORE-MATH's log.c and log10.c): x = 2^e v with v in [1/sqrt(2),
// sqrt(2)), z = r v - 1 exact for log_fast's reciprocal r, then e log(2) -
// log(r) + z + a degree-6 polynomial of z. log.c's table, for ln, has r = 1
// and log(r) = 0 at its i = 511 and 512.
__log_cr_fast: fn(n: Float, ln: Bool) -> (hi: Float, lo: Float) Never! {
    b0: __to_bits_i64(n)
    sub: b0 < 0x0010_0000_0000_0000
    b: if sub -> __to_bits_i64(n * Float{4503599627370496.0}) else -> b0
    scaled: if sub -> I64{52} else -> I64{0}
    m: b.bit_and(0xF_FFFF_FFFF_FFFF)
    c: m >= 0x6_A09E_667F_3BCD
    e0: (b >> 52) - 1023 - scaled
    e: if c -> e0 + 1 else -> e0
    sh: if c -> I64{44} else -> I64{43}
    i: Int{((m + 0x10_0000_0000_0000) >> sh) - 362}
    v: __from_bits_i64(m.bit_or(0x3FF0_0000_0000_0000))
    y: if c -> v * Float{0.5} else -> v
    one: ln && (i == 149 || i == 150)
    r: if one -> Float{1.0} else -> __LOG_FAST_INVERSE[i]
    l1: if one -> Float{0.0} else -> __LOG_FAST_LOG_INVERSE[2 * i]
    l2: if one -> Float{0.0} else -> __LOG_FAST_LOG_INVERSE[2 * i + 1]
    z: fma(r, y, Float{-1.0})
    z2: z * z
    p45: fma(Float{-0.16660715889531294}, z, Float{0.20000091537201936})
    p23: fma(Float{-0.25000000030374225}, z, Float{0.33333333333196213})
    ph: fma(fma(p45, z2, p23), z, Float{-0.49999999999999967}) * z2
    ee: __float_i64(e)
    // log(2) as hi + lo, hi a multiple of 2^-42 so that e hi is exact
    s: __fast_two_sum(fma(ee, Float{0.6931471805598903}, l1), z)
    l: ph + (s.lo + l2)
