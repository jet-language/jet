    0.280313390386063, 0.276766462749929, 1.3877787807814457e-17,
    0.2925647645885862, 0.2885441423070197, -1.3877787807814457e-17,
    0.3052938955342292, 0.3007399695268544, 1.3877787807814457e-17,
