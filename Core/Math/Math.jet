floor: fn(n: Float) -> Float Never! { core.math.floor(n) }
ceil: fn(n: Float) -> Float Never! { core.math.ceil(n) }
fract: fn(n: Float) -> Float Never! { n - trunc(n) }
/// sqrt(a^2 + b^2), correctly rounded (CORE-MATH hypot.c): never overflows
/// or underflows early; +inf when a side is infinite and the other is a
/// number or a quiet NaN, else NaN for a NaN.
hypot: fn(a: Float, b: Float) -> Float Never! {
    ab: to_bits(a).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    bb: to_bits(b).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if ab >= 0x7FF0_0000_0000_0000 || bb >= 0x7FF0_0000_0000_0000 {
        ainf: ab == 0x7FF0_0000_0000_0000
        binf: bb == 0x7FF0_0000_0000_0000
        aq: ab >= 0x7FF8_0000_0000_0000
        bq: bb >= 0x7FF8_0000_0000_0000
        if ainf != binf && aq != bq -> return INFINITY
        return fabs(a) + fabs(b)
    }
    ub: if ab > bb -> ab else -> bb
    vb: if ab > bb -> bb else -> ab
    if vb == 0 -> return from_bits(ub)
    if ub < 0x10_0000_0000_0000 -> return __hypot_exact(from_bits(ub), from_bits(vb))
    // a subnormal v as a normalized significand under an exponent field <= 0
    ve := vb
    if vb < 0x10_0000_0000_0000 {
        sh: 53 - __bit_len(vb)
        ve = (vb << sh).bit_and(0xF_FFFF_FFFF_FFFF) + ((1 - sh) << 52)
    }
    if ub - ve > 0x01B0_0000_0000_0000 -> return fma(Float{7.450580596923828e-9}, from_bits(vb), from_bits(ub))
    // both scaled by the power of 2 that puts u in [1, 2)
    off: 0x3FF0_0000_0000_0000 - ub.bit_and(0x7FF0_0000_0000_0000)
    x: from_bits(ub + off)
    y: from_bits(ve + off)
    x2: x * x
    dx2: fma(x, x, -x2)
    y2: y * y
    dy2: fma(y, y, -y2)
    r2: x2 + y2
    dr2: ((x2 - r2) + y2) + (dx2 + dy2)
    th0: sqrt(r2)
    dz: dr2 - fma(th0, th0, -r2)
    t: __fast_two_sum(th0, th0 * (Float{0.5} / r2) * dz)
    // |lo| / ulp(hi) near 1/2 or 1/4, or tiny (an exact root): decided exactly
    aidr: to_bits(fabs(t.lo)) + 0x3FE0_0000_0000_0000 - to_bits(t.hi).bit_and(0x7FF0_0000_0000_0000)
    mid: aidr - 0x3C90_0000_0000_0000 + 16
    midm: aidr - 0x3C80_0000_0000_0000 + 16
    if (mid >= 0 && mid < 32) || (midm >= 0 && midm < 32) || aidr < 0x39B0_0000_0000_0000 || aidr > 0x3C9F_FFFF_FFFF_FF80 -> return __hypot_exact(from_bits(ub), from_bits(vb))
