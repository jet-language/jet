struct F64x2 {
    lanes: [F64#2]
}
impl F64x2 {
    fn new(l0: F64, l1: F64) -> F64x2 Never! { F64x2{lanes: [F64#2]{l0, l1}} }
    fn splat(value: F64) -> F64x2 Never! { F64x2{lanes: [F64#2]{value, value}} }
    fn from_array(lanes: [F64#2]) -> F64x2 Never! { F64x2{lanes: lanes} }
    fn to_array(self) -> [F64#2] Never! { self.lanes.copy() }
    fn lane(self, index: Int) -> F64 Never! {
        if index < 0 || index >= 2 -> core.math.__numeric_stop("lane index {index} out of range for F64x2 (2 lanes)")
        self.lanes[index]
    }
    // Swizzles (D-SWIZZLE1): both lanes read and write as an F64x2.
    fn __swizzle2(self, a: Int, b: Int) -> F64x2 Never! { F64x2.new(self.lanes[a], self.lanes[b]) }
    fn __swizzle_set1(&self, a: Int, value: F64) Never! { self.lanes[a] = value }
    fn __swizzle_set2(&self, a: Int, b: Int, value: F64x2) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
    }
    fn sum(self) -> F64 Never! {
        value := F64{0.0}
        loop i in 0..<2 -> value = value + self.lanes[i]
        value
    }
    fn product(self) -> F64 Never! {
        value := F64{1.0}
        loop i in 0..<2 -> value = value * self.lanes[i]
        value
    }
    fn min(self) -> F64 Never! {
        value := F64{1.0} / F64{0.0}
        loop i in 0..<2 -> value = min_float(value, self.lanes[i])
        value
    }
    fn max(self) -> F64 Never! {
        value := -F64{1.0} / F64{0.0}
        loop i in 0..<2 -> value = max_float(value, self.lanes[i])
        value
    }
    fn reduce_add(self) -> F64 Never! { self.sum() }
    fn reduce_mul(self) -> F64 Never! { self.product() }
    fn reduce_min(self) -> F64 Never! { self.min() }
    fn reduce_max(self) -> F64 Never! { self.max() }
    fn reduce_avg(self) -> F64 Never! { self.sum() / F64{2.0} }
    fn reduce(self, op: ReduceOp) -> F64 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl F64x2.Add {
    fn add(self, rhs: F64x2) -> F64x2 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<2 -> lanes[i] = lanes[i] + rhs.lanes[i]
        F64x2{lanes: lanes}
    }
}
impl F64x2.Sub {
    fn sub(self, rhs: F64x2) -> F64x2 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<2 -> lanes[i] = lanes[i] - rhs.lanes[i]
