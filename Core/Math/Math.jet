/// (1 + x)^n for a whole n, correctly rounded (C23 compoundn): 1 for n = 0
/// when x >= -1 or x is NaN, NaN for x < -1 and for a NaN x otherwise, +0
/// or +inf at x = -1 and +inf or +0 at x = +inf for n > 0 and n < 0. Every
/// Int n is taken exactly, and 1 + x is never rounded.
compound_n: fn(x: Float, n: Int) -> Float Never! {
    if is_nan(x) {
        if n == 0 -> return Float{1.0}
        return x + x
    }
    if (x < Float{-1.0}) -> return NAN
    if n == 0 || x == 0.0 -> return Float{1.0}
    if (x == Float{-1.0}) || is_inf(x) {
        if (n > 0) == is_inf(x) -> return INFINITY
        return Float{0.0}
    }
    if n == 1 -> return Float{1.0} + x
    b: if (fabs(x) > Float{1.0}) -> __fast_two_sum(x, Float{1.0}) else -> __fast_two_sum(Float{1.0}, x)
    if b.lo == 0.0 -> return pow_n(b.hi, n)
    __compound_cr(x, b.hi, b.lo, n)
}
// (1 + x)^n for bh + bl = 1 + x exactly, bl != 0 and n not 0 or 1: for
// |n| <= 2^53 pow's phase 1 on n (log(bh) + log(1 + bl/bh)), then a power
// far outside the Floats from an estimate of n log2(1 + x), and the rest by
// __pow_ziv on the exact 1 + x. As bl != 0 the odd part of 1 + x exceeds
// 2^53, so no such power is a Float or the midpoint of two.
__compound_cr: fn(x: Float, bh: Float, bl: Float, n: Int) -> Float Never! {
    if -0x20_0000_0000_0000 <= n && n <= 0x20_0000_0000_0000 {
        l: __pow_log_1(bh)
        ch: bl / bh
        cl: fma(-ch, bh, bl) / bh
        s: __add_dd(l.hi, l.lo, ch, cl - Float{0.5} * ch * ch)
        g: __fast_two_sum(s.hi, s.lo)
        r: __s_mul(Float{n}, g.hi, g.lo)
        e: __pow_exp_1(r.hi, r.lo)
