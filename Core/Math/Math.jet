        e = e + 1
    }
    p: __float_parts(fabs(y))
    n := p.m
    f := p.e
    loop n.bit_and(1) == 0 {
        n = n >> 1
        f = f + 1
    }
    if m == 1 {
        g: if (y < Float{0.0}) -> -e * n else -> e * n
        if f >= 0 -> return __round_scaled(1, g << f)
        if (g >> -f) << -f != g -> return NAN
        return __round_scaled(1, g >> -f)
