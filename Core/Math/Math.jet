// e^(xh + xl) within 2^-74.139 relatively, for |xl/xh| < 2^-23.89 and |xl| <
// 2^-14.3486: x = k log(2)/4096 + y, then 2^(k/4096) e^y.
__exp_dd_fast: fn(xh: Float, xl: Float) -> (hi: Float, lo: Float) Never! {
    k: round_even(xh * Float{5909.278887481194})
    kp: __s_mul(k, Float{0.0001692253858788929}, Float{5.661735385366942e-21})
    y: __fast_two_sum(xh - kp.hi, xl)
    __exp_dd_tail(k, __exp_q1(y.hi, y.lo - kp.lo))
}
// 2^(k/4096) (qh + ql) for whole k with 2^(k/4096) a normal Float: 2^(k/4096)
// from __EXP_T1 and __EXP_T2, the power of two exactly.
__exp_dd_tail: fn(k: Float, q: (hi: Float, lo: Float)) -> (hi: Float, lo: Float) Never! {
    kk: __whole_i64(k)
    m: (kk >> 12) + 0x3FF
    i2: Int{(kk >> 6).bit_and(0x3F)}
    i1: Int{kk.bit_and(0x3F)}
    t: __d_mul(__EXP_T2[2 * i1], __EXP_T2[2 * i1 + 1], __EXP_T1[2 * i2], __EXP_T1[2 * i2 + 1])
    r: __d_mul(t.hi, t.lo, q.hi, q.lo)
    if m == 0x7FF {
        // 2^1024 is no Float: scale by 2 and 2^1023
        s: __from_bits_i64(0x7FE0_0000_0000_0000)
        return (hi: r.hi * Float{2.0} * s, lo: r.lo * Float{2.0} * s)
    }
    s: __from_bits_i64(m << 52)
    (hi: r.hi * s, lo: r.lo * s)
}
// e^(zh + zl) within 2^-74.346 absolutely for |z| < 0.000130273 and |zl| <
// 2^-42.6: a degree-4 polynomial.
__exp_q1: fn(zh: Float, zl: Float) -> (hi: Float, lo: Float) Never! {
    z: zh + zl
    q: fma(fma(Float{0.0416666666881331}, zh, Float{0.16666666679041395}), z, Float{0.5})
    a: __fast_two_sum(Float{1.0}, q * z)
    b: __d_mul(zh, zl, a.hi, a.lo)
    c: __fast_two_sum(Float{1.0}, b.hi)
    (hi: c.hi, lo: b.lo + c.lo)
}
// e^(zh + zl) within 2^-113.218 absolutely for |z| < 0.000130273 and |zl| <
// 2^-42.6: a degree-7 polynomial, double-double from degree 3 down.
__exp_q2: fn(zh: Float, zl: Float) -> (hi: Float, lo: Float) Never! {
    z: zh + zl
    q := fma(Float{0.000198412702925094}, zh, Float{0.0013888890379584226})
    q = fma(q, z, Float{0.008333333333333333})
    q = fma(q, z, Float{0.041666666666666664})
    h: q * z
    a: __fast_two_sum(Float{0.16666666666666666}, h)
    b: __d_mul(a.hi, fma(q, z, -h) + (a.lo + Float{9.251858539246562e-18}), zh, zl)
    c: __fast_two_sum(Float{0.5}, b.hi)
    d: __d_mul(c.hi, b.lo + c.lo, zh, zl)
    e: __fast_two_sum(Float{1.0}, d.hi)
    f: __d_mul(e.hi, d.lo + e.lo, zh, zl)
    g: __fast_two_sum(Float{1.0}, f.hi)
    (hi: g.hi, lo: f.lo + g.lo)
}
// (h + l) - 1 for h + l = b^x, with the larger operand first.
__dd_minus_one: fn(x: Float, h: Float, l: Float) -> (hi: Float, lo: Float) Never! {
    if (x >= Float{0.0}) {
        u: __fast_two_sum(h, Float{-1.0})
        return (hi: u.hi, lo: l + u.lo)
    }
    u: __fast_two_sum(Float{-1.0}, h)
    (hi: u.hi, lo: l + u.lo)
}
// CORE-MATH exp.c's helpers. muldd: (xh + xl)(ch + cl) without the low
// product and with no renormalization.
__exp_cr_muldd: fn(xh: Float, xl: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    h: ch * xh
    (hi: h, lo: (ch * xl + cl * xh) + fma(ch, xh, -h))
}
// Algorithm 4 of Jeannerod, Joldes, Louvet and Muller (Arith 2026):
// (ah + al)(bh + bl) + (ch + cl) as a double-double.
__exp_cr_fma_dw: fn(ah: Float, al: Float, bh: Float, bl: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    dh: fma(ah, bh, ch)
    e: fma(ah, bh, ch - dh)
    (hi: dh, lo: al * bh + (ah * bl + (e + cl)))
}
// The double-double polynomial of the n (hi, lo) pairs of c at xh + xl.
__exp_cr_poly: fn(xh: Float, xl: Float, c: [Float], n: Int) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    ch := c[2 * i]
    cl := c[2 * i + 1]
    loop i > 0 {
        i = i - 1
        r: __exp_cr_fma_dw(xh, xl, ch, cl, c[2 * i], c[2 * i + 1])
        ch = r.hi
        cl = r.lo
    }
    (hi: ch, lo: cl)
}
// y 2^e for a normal y 2^e: e added to the exponent field.
__exp_cr_scale: fn(y: Float, e: I64) -> Float Never! { __from_bits_i64(__to_bits_i64(y) + (e << 52)) }
// The subnormal under y = 2^-1022 + v: the exponent field cleared.
__exp_cr_subnormal: fn(y: Float) -> Float Never! { __from_bits_i64(__to_bits_i64(y).bit_and(0x000F_FFFF_FFFF_FFFF)) }
// exp's accurate path for |x| > 2^-54: a degree-7 double-double polynomial
// after a three-part Cody-Waite reduction, then __EXPCR_HARD's exceptions.
__exp_cr_accurate: fn(n: Float) -> Float Never! {
    t: round_even(n * Float{5909.278887481194})
    jt: __whole_i64(t)
    i0: Int{(jt >> 6).bit_and(0x3F)}
    i1: Int{jt.bit_and(0x3F)}
    ie: jt >> 12
    tt: __exp_cr_muldd(__EXPCR_T0[2 * i0 + 1], __EXPCR_T0[2 * i0], __EXPCR_T1[2 * i1 + 1], __EXPCR_T1[2 * i1])
    dx: n - Float{0.00016922538588914904} * t
    dxl0: Float{1.0256140314162804e-14} * t
    dxll: Float{3.2042720746546034e-31} * t + fma(Float{1.0256140314162804e-14}, t, -dxl0)
    d: __fast_two_sum(dx, dxl0)
    dxl: d.lo + dxll
    f0: __exp_cr_poly(d.hi, dxl, __EXPCR_CH, 7)
    f1: __exp_cr_muldd(d.hi, dxl, f0.hi, f0.lo)
    f2: __exp_cr_muldd(f1.hi, f1.lo, tt.hi, tt.lo)
    // fastsum(th, tl, fh, fl)
    s0: __fast_two_sum(tt.hi, f2.hi)
    fh := s0.hi
    fl := (tt.lo + f2.lo) + s0.lo
    bits: __to_bits_i64(n)
    if bits < 0 && bits.bit_and(0x7FFF_FFFF_FFFF_FFFF) > 0x4086_232B_DD7A_BCD2 {
        s: __fast_two_sum(__from_bits_i64((1 - ie) << 52), fh)
        return __exp_cr_subnormal(s.hi + (fl + s.lo))
    }
    s: __fast_two_sum(fh, fl)
    fh = s.hi
    // a low part within 4 units of 2^-53 fh's power-of-two boundary: the
    // result may be one of __EXPCR_HARD's exceptions
    if (__to_bits_i64(s.lo) + 4).bit_and(0x000F_FFFF_FFFF_FFFF) <= 4 {
        r: __hard_case(__EXPCR_HARD, n)
        if !is_nan(r) -> fh = r
    }
    __exp_cr_scale(fh, ie)
}
