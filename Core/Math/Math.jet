}
/// atan(x) / pi, correctly rounded (C23 atanpi; CORE-MATH atanpi.c): in
/// [-1/2, 1/2] with the sign of x, and +-1/2 for an infinity.
atan_pi: fn(n: Float) -> Float Never! {
    at: to_bits(n).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    ph: Float{0.3183098861837907}
    pl: Float{-1.9678676675182486e-17}
    if at < 0x3F7B_21C4_75E6_362A {
        // |x| < 0.006624
        if at < 0x3C90_0000_0000_0000 -> return __atan_pi_small(n)
