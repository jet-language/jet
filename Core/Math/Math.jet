// asin's and acos's fast path: f0 + asin(z + zl), asin(z)/z being piece j's
// polynomial at t = z^2 - j/128; the bounds (lb, ub) are eps apart.
__asin_core: fn(jd: Float, t: Float, z: Float, zl: Float, f0h: Float, f0l: Float, eps: Float) -> (lb: Float, ub: Float) Never! {
    c: __ASIN_CC
    b: 8 * (Int.from_float(jd) ?? 0)
    t2: t * t
    d: t * ((c[b + 2] + t * c[b + 3]) + t2 * ((c[b + 4] + t * c[b + 5]) + t2 * (c[b + 6] + t * c[b + 7])))
    f: __exp_cr_muldd(z, zl, c[b], c[b + 1] + d)
    s: __fast_sum_dd(f0h, f0l, f.hi, f.lo)
    (lb: s.hi + (s.lo - eps), ub: s.hi + (s.lo + eps))
}
// For |x| = sin(phi), |x| cos(j pi/64) - sqrt(1 - x^2) sin(j pi/64) =
// sin(phi - j pi/64) as a double-double: the rotation both refinements share.
__asin_rotate: fn(x: Float, j: Int) -> (hi: Float, lo: Float) Never! {
    s2: x * x
    dx2: fma(x, x, -s2)
    c2a: __fast_two_sum(Float{1.0}, -s2)
    c2: __fast_two_sum(c2a.hi, c2a.lo - dx2)
    ch: sqrt(c2.hi)
    cl: (c2.lo - fma(ch, ch, -c2.hi)) * (Float{0.5} / ch)
    s: __ASIN_S
    bc: 2 * (32 - j)
    sh: s[2 * j + 1]
    sl: s[2 * j]
    dsh: fabs(x) - sh
    dch: ch - s[bc + 1]
    dcl: cl - s[bc]
    // both products rounded to multiples of 2^-56, so their difference is exact
    magic: Float{0.09375}
    sc: fma(sh, dch, magic) - magic
    dsc: fma(sh, dch, -sc)
    cs: fma(s[bc + 1], dsh, magic) - magic
    dcs: fma(s[bc + 1], dsh, -cs)
    dv: ((s[bc + 1] * -sl + s[bc] * dsh) - (sh * dcl + sl * dch)) - (dsc - dcs)
    __fast_two_sum(cs - sc, dv)
}
// asin(sg (v + dv)) as a double-double for the small rotated v.
__asin_series: fn(v: Float, dv: Float, sg: Float) -> (hi: Float, lo: Float) Never! {
    v2: __exp_cr_muldd(v, dv, v, dv)
    fl: v2.hi * (Float{0.022372159104814857} + v2.hi * (Float{0.017352737142070387} + v2.hi * Float{0.013992707164303743}))
    f: __exp_m1_cr_opolydd(v2.hi, v2.lo, __ASIN_RC, 0, 5, fl)
    __exp_cr_muldd(v * sg, dv * sg, f.hi, f.lo)
}
// (ph + pl + ps) renormalized by two rounds of fast two-sums.
__asin_renorm: fn(ph: Float, pl: Float, ps: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    a: __fast_two_sum(ph, pl)
    b: __fast_two_sum(a.lo, ps)
    c: __fast_two_sum(a.hi, b.hi)
    d: __fast_two_sum(c.lo, b.lo)
    (hi: c.hi, mid: d.hi, lo: d.lo)
}
// asin to about 2^-149 for the inputs the fast path cannot round: phi
// approximates asin(x), x = sin(j pi/64 + delta); the hardest are tabulated.
__asin_refine: fn(x: Float, phi: Float) -> Float Never! {
    jf: round_even(fabs(phi) * Float{20.371832715762604})
    r: __asin_rotate(x, Int.from_float(jf) ?? 0)
    sg: copysign(Float{1.0}, x)
    f: __asin_series(r.hi, r.lo, sg)
    jt: jf * sg
    // pi/64 as h + l + s within 2^-155; jt h and jt l are exact
    s: __fast_sum_dd(f.hi, f.lo, Float{1.684469643174416e-16} * jt, Float{-3.917809439666406e-31} * jt)
    p: __asin_renorm(jt * Float{0.04908738521234035}, s.hi, s.lo)
    tn: (to_bits(p.hi).bit_and(0x7FF0_0000_0000_0000) - (53 << 52)).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    gap: (tn - to_bits(p.mid).bit_and(0x7FFF_FFFF_FFFF_FFFF)).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    res: p.hi + p.mid
    if gap > 2 && (gap >> 52) <= 47 -> return res
    ax: fabs(x)
    k := 0
    loop k < __ASIN_HARD.len() {
        if ax == __ASIN_HARD[k] -> return sg * __ASIN_HARD[k + 1] + sg * __ASIN_HARD[k + 2]
        k = k + 3
    }
    res
}
// acos to about 2^-149 for the inputs the fast path cannot round: phi
// approximates acos(x), x = cos(pi/2 -+ j pi/64 - delta). A tail on a
// rounding boundary is nudged by the next term's sign; five inputs are listed.
__acos_refine: fn(x: Float, phi: Float) -> Float Never! {
    jf: round_even(fabs(phi - Float{1.5707963267948966}) * Float{20.371832715762604})
    r: __asin_rotate(x, Int.from_float(jf) ?? 0)
    sg: copysign(Float{1.0}, x)
    f: __asin_series(r.hi, r.lo, -sg)
    jt: Float{32.0} - jf * sg
    // f + (jt l + jt s) with a two-sum, as f may be the larger
    pl0: Float{1.684469643174416e-16} * jt
    sh: f.hi + pl0
    ap: sh - pl0
    bp: sh - ap
    tail: (f.hi - ap) + (pl0 - bp)
    p: __asin_renorm(jt * Float{0.04908738521234035}, sh, (f.lo + Float{-3.917809439666406e-31} * jt) + tail)
    tb := to_bits(p.mid)
    e0: (tb >> 52).bit_and(0x7FF) - 1023
    e1: 52 - (107 + e0)
    e: if e1 < 0 -> 0 else -> if e1 > 52 -> 52 else -> e1
    m: (1 << 52) - (1 << e)
    half: if e == 0 -> 1 << 63 else -> 1 << (e - 1)
    if (tb + half).bit_and(m) != 0 -> return p.hi + p.mid
    if (x == Float{0.999999999999936}) -> return Float{3.5762786865234566e-7} + Float{1.3234889800848443e-23}
    if (x == Float{0.08298723566019295}) -> return Float{1.4877135408445967} + Float{5.551115123125783e-17}
    if (x == Float{0.0009717008771394217}) -> return Float{1.5698246257648432} + Float{1.6653345369377348e-16}
    if (x == Float{0.999999999999984}) -> return Float{1.788139343261721e-7} + Float{6.617444900424222e-24}
    if (x == Float{0.038214879531014476}) -> return Float{1.5325721397906955} - Float{1.5407439555097887e-33}
    tb = if (to_bits(p.lo) < 0) != (tb < 0) -> tb - 1 else -> tb + 1
    p.hi + from_bits(tb)
}
