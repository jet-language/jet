// The bit length of v > 0.
__bit_len: fn(v: Int) -> Int Never! {
    r := v
    n := 0
    loop r > 0xFFFF_FFFF_FFFF_FFFF {
        r = r >> 64
        n = n + 64
    }
    // approx(r) rounds up to the next power of two at most
    b := (to_bits(approx(r)) >> 52) - 1022
    if (Int{1} << (b - 1)) > r -> b = b - 1
    n + b
