// ln for 1 - 2^-9 <= x < 1 + 2^-9 (log.c's cr_log_tiny): a degree-7
// polynomial of r = x - 1, exact, within 2^-60.141 |r|.
__ln_cr_tiny: fn(n: Float) -> Float Never! {
    if n == 1.0 -> return 0.0
    r: n - Float{1.0}
    r2: r * r
    p6: Float{-0.1666673819284923} + r * Float{0.142855366547185}
    p4: (Float{-0.24999999999904501} + r * Float{0.200000000012976}) + r2 * p6
    p2: (Float{-0.5} + r * Float{0.3333333333333333}) + r2 * p4
    s: __fast_two_sum(r, r2 * p2)
    eps: Float{7.877406409464993e-19}
    lb: s.hi + (s.lo - eps * r)
    ub: s.hi + (s.lo + eps * r)
