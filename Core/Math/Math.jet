                y = Float{1.0} - x
            } else if ix >= 1070442081 {
                y = x - (Float{1.4616321449683622} - Float{1.0})
                fit = 1
            } else {
                y = x
                fit = 2
            }
        } else if ix >= 1073460419 {
            // [1.7316, 2]
            y = Float{2.0} - x
        } else if ix >= 1072936132 {
            // [1.23, 1.73]
            y = x - Float{1.4616321449683622}
            fit = 1
        } else {
            y = x - Float{1.0}
            fit = 2
        }
        if fit == 0 {
            z: y * y
            p1: Float{0.07721566490153287} + z * (Float{0.06735230105312927} + z * (Float{0.007385550860814029} + z * (Float{0.0011927076318336207} + z * (Float{0.00022086279071390839} + z * Float{0.000025214456545125733}))))
            p2: z * (Float{0.3224670334241136} + z * (Float{0.020580808432516733} + z * (Float{0.0028905138367341563} + z * (Float{0.0005100697921535113} + z * (Float{0.00010801156724758394} + z * Float{0.000044864094961891516})))))
            p: y * p1 + p2
            r = r + (p - Float{0.5} * y)
        } else if fit == 1 {
            z: y * y
            w: z * y
            p1: Float{0.48383612272381005} + w * (Float{-0.032788541075985965} + w * (Float{0.006100538702462913} + w * (Float{-0.0014034646998923284} + w * Float{0.00031563207090362595})))
            p2: Float{-0.1475877229945939} + w * (Float{0.01797067508118204} + w * (Float{-0.0036845201678113826} + w * (Float{0.000881081882437654} + w * Float{-0.00031275416837512086})))
            p3: Float{0.06462494023913339} + w * (Float{-0.010314224129834144} + w * (Float{0.0022596478090061247} + w * (Float{-0.0005385953053567405} + w * Float{0.0003355291926355191})))
            p: z * p1 - (Float{-3.638676997039505e-18} - w * (p2 + y * p3))
            r = r + (Float{-0.12148629053584961} + p)
        } else {
            p1: y * (Float{-0.07721566490153287} + y * (Float{0.6328270640250934} + y * (Float{1.4549225013723477} + y * (Float{0.9777175279633727} + y * (Float{0.22896372806469245} + y * Float{0.013381091853678766})))))
            p2: Float{1.0} + y * (Float{2.4559779371304113} + y * (Float{2.128489763798934} + y * (Float{0.7692851504566728} + y * (Float{0.10422264559336913} + y * Float{0.003217092422824239}))))
