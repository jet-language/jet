        if ax >= 0x42D0_0000_0000_0000 {
            // |x| >= 2^46 is a multiple of 2^-6: the table holds the answer
            if ax >= 0x7FF0_0000_0000_0000 -> return __pi_trig_special(n)
            s: (ax >> 52) - 1069
            if s > 6 -> return copysign(0.0, n)
            iq: ((if sgn < 0 -> -ax else -> ax) << s).bit_and(127)
            if iq.bit_and(31) == 0 -> return __tan_pi_pole_or_zero(iq >> 5, sgn)
            if iq.bit_and(32) != 0 {
                k: 32 - iq.bit_and(31)
                return -__TANPI_T[2 * k + 1] + -__TANPI_T[2 * k]
            }
            k: iq.bit_and(31)
            return __TANPI_T[2 * k + 1] + __TANPI_T[2 * k]
        }
        // 2^-12 <= |x| < 2^46
        e: ax >> 52
        s: 1068 - e
        s1: e - 1011
        m: ax.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
        // the bit of x of weight 1/2, as 0 or -1
        half: if (m << s1).bit_and(0xFFFF_FFFF_FFFF_FFFF) > 0x7FFF_FFFF_FFFF_FFFF -> -1 else -> 0
        iq: ((m.bit_xor(half) >> s).bit_and(63) + 1) >> 1
        ms: half.bit_xor(sgn)
        sm: if sgn < 0 -> -m else -> m
        // the bits of x of weight at most 2^-7, as a signed 64-bit word
        k: __wrap_i64(sm << (e - 1005))
        z := approx(k)
        if (k << 1).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0 {
            if k == 0 {
                if iq.bit_and(31) == 0 -> return __tan_pi_pole_or_zero(sm >> (s + 6), sgn)
                kq: (m << s1).bit_and(0xFFFF_FFFF_FFFF_FFFF) >> 58
                if kq == 0x10 -> return copysign(1.0, n)
                if kq == 0x30 -> return -copysign(1.0, n)
            }
            z = copysign(1.0, n) * z
        }
        z2: z * z
        z4: z2 * z2
        z3: z * z2
        f: z3 * ((Float{6.281006949579927e-63} + z2 * Float{1.779055995675284e-104}) + z4 * (Float{5.099053215602634e-146} + z2 * Float{1.4640479742404237e-187}))
        eps := z3 * Float{8.636168555094445e-78} + copysign(Float{4.930380657631324e-32}, z)
        p: __mul_dd_d(Float{2.6610324844426207e-21}, Float{1.0373161876273278e-37}, z)
        q: __fast_sum_ddd(p.hi, p.lo, f)
        r: __tan_pi_combine(iq, ms, q.hi, q.lo)
        eps = eps + eps * (r.hi * r.hi)
        lb: r.hi + (r.lo - eps)
        ub: r.hi + (r.lo + eps)
        if lb == ub -> return lb
        x: z * Float{1.0842021724855044e-19}
        x2: x * x
        dx2: fma(x, x, -x2)
        t0: __poly_dd(x2, dx2, __TANPI_REFINE_C, 5, x2 * (Float{1.7255646049060546e-20} + x2 * (Float{4.212795514202248e-24} + x2 * Float{1.0295197365311714e-27})))
        t1: __mul_dd_d(t0.hi, t0.lo, x)
        r2: __tan_pi_combine(iq, ms, t1.hi, t1.lo)
        fin: __fast_two_sum(r2.hi, r2.lo)
        th = fin.hi
        tl = fin.lo
        res = fin.hi
    } else {
        if ax == 0 -> return n
        pi0: Float{3.141592653589793}
        pi1: Float{1.2246467991473532e-16}
        if ax < 0x3CA0_0000_0000_0000 {
            if ax < 0x06B0_0000_0000_0000 {
                // scaled up so a subnormal result rounds once
                e: ax >> 52
                sc: from_bits((2045 - e) << 52)
                isc: from_bits((1 + e) << 52)
                p: __mul_dd_d(pi0, pi1, n * sc)
                th = p.hi
                tl = p.lo
                res = th * isc
                if (fabs(res) < Float{2.2250738585072014e-308}) {
                    o: copysign(Float{2.2250738585072014e-308}, n)
                    v0b: (o + res) * sc
                    v0h: res * sc
                    return (v0b + (tl + (th - v0h))) * isc - o
                }
            } else {
                p: __mul_dd_d(pi0, pi1, n)
                th = p.hi
                tl = p.lo
                res = th
            }
        } else {
            x2: n * n
            x3: n * x2
            f: x3 * (Float{10.33542556009994} + x2 * (Float{40.80262463803622} + x2 * Float{163.0000102605464}))
            px: __mul_dd_d(pi0, pi1, n)
            q: __fast_sum_ddd(px.hi, px.lo, f)
            eps: n * (x2 * Float{7.549516567451064e-15} + Float{3.944304526105059e-31})
            lb: q.hi + (q.lo - eps)
            ub: q.hi + (q.lo + eps)
            if lb == ub -> return lb
            dx2: fma(n, n, -x2)
            dx3: fma(x2, n, -x3) + dx2 * n
            t0: __poly_dd(x2, dx2, __TANPI_ZERO_C, 3, x2 * (Float{651.9097561458326} + x2 * Float{2607.6010593946085}))
            t1: __mul_dd(x3, dx3, t0.hi, t0.lo)
            u: __fast_two_sum(px.hi, t1.hi)
            fin: __fast_two_sum(u.hi, (t1.lo + px.lo) + u.lo)
            th = fin.hi
            tl = fin.lo
            res = fin.hi
        }
    }
    // th + tl could round either way: the hard cases are tabulated
    er: (to_bits(tl) + 6).bit_and(0xF_FFFF_FFFF_FFFF)
    de: ((to_bits(th) - to_bits(tl)).bit_and(0xFFFF_FFFF_FFFF_FFFF) >> 52).bit_and(0x7FF)
    if er <= 12 || de > 102 -> return __tan_pi_hard(n, res)
