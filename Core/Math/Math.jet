#Test("Vec4 dot folds from zero in lane order") {
    large: Vec4.new(10000000000000000.0, 1.0, -10000000000000000.0, 2.0)
    assert_eq(large.dot(Vec4.splat(1.0)), 2.0)
    assert_eq(to_bits(Vec4.new(0.0, -0.0, 0.0, -0.0).normalize().to_array()[1]), to_bits(-0.0))
    assert_eq(Vec4.from_array([Float#4]{1.0, 2.0, 3.0, 4.0}).length(), sqrt(30.0))
    assert_eq((Vec4.splat(2.0) + Vec4.splat(3.0)).lane(3), 5.0)
    assert_eq((Vec4.splat(2.0) - Vec4.splat(3.0)).lane(3), -1.0)
    assert_eq((Vec4.splat(2.0) * Vec4.splat(3.0)).lane(3), 6.0)
}

Mat3: struct {
    lanes: [Float#9]
}
impl Mat3 {
    new: fn(m0: Float, m1: Float, m2: Float, m3: Float, m4: Float, m5: Float, m6: Float, m7: Float, m8: Float) -> Mat3 Never! {
        Mat3{lanes: [Float#9]{m0, m1, m2, m3, m4, m5, m6, m7, m8}}
    }
    from_array: fn(lanes: [Float#9]) -> Mat3 Never! { Mat3{lanes: lanes} }
    to_array: fn(self) -> [Float#9] Never! { self.lanes.copy() }
    matmul: fn(self, other: Mat3) -> Mat3 Never! {
        result := self.lanes.copy()
        loop column in 0..<3 {
            loop row in 0..<3 {
                total := Float{0.0}
                loop k in 0..<3 -> total = total + self.lanes[k * 3 + row] * other.lanes[column * 3 + k]
                result[column * 3 + row] = total
            }
        }
        Mat3{lanes: result}
    }
    transform: fn(self, value: Vec3) -> Vec3 Never! {
        result := value.lanes.copy()
        loop row in 0..<3 {
            total := Float{0.0}
            loop k in 0..<3 -> total = total + self.lanes[k * 3 + row] * value.lanes[k]
            result[row] = total
        }
        Vec3{lanes: result}
    }
    transpose: fn(self) -> Mat3 Never! {
        result := self.lanes.copy()
        loop column in 0..<3 {
            loop row in 0..<3 -> result[column * 3 + row] = self.lanes[row * 3 + column]
        }
        Mat3{lanes: result}
    }
}
impl Mat3.Add {
    add: fn(self, rhs: Mat3) -> Mat3 Never! {
        result := self.lanes.copy()
        loop i in 0..<9 -> result[i] = self.lanes[i] + rhs.lanes[i]
        Mat3{lanes: result}
    }
}
impl Mat3.Sub {
    sub: fn(self, rhs: Mat3) -> Mat3 Never! {
        result := self.lanes.copy()
        loop i in 0..<9 -> result[i] = self.lanes[i] - rhs.lanes[i]
        Mat3{lanes: result}
    }
}
impl Mat3.Mul {
    mul: fn(self, rhs: Mat3) -> Mat3 Never! { self.matmul(rhs) }
}
impl Mat3.Mul(Vec3) {
    mul: fn(self, rhs: Vec3) -> Vec3 Never! { self.transform(rhs) }
}
