// log10_1p when the fast path cannot round.
__log10_1p_accurate: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    if (ax < Float{0.03125}) {
        if (ax < Float{1.1830521861667747e-271}) -> return __mul_dd_tiny(x, Float{0.4342944819032518}, Float{1.098319650216765e-17})
        r: __hard_case(__LOG10P1_HARD, x)
        if !is_nan(r) -> return r
        // degree 17 down to 10 in Floats, 9 adding the product's error, then
        // double-double coefficients
        c: __LOG10P1_ACCURATE
        h := fma(c[24], x, c[23])
        i := 22
        loop i >= 17 {
            h = fma(h, x, c[i])
            i = i - 1
        }
        hp: x * h
        s: c[16] + hp
        q: __horner_dd_x(x, s, fma(x, h, -hp) + (hp - (s - c[16])), c, 8)
        return q.hi + q.lo
