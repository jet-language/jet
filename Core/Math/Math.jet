// The fast path of atan2_pi(y, x): (hi, lo) within err relatively, from z =
// y/x or x/y in [0, 1] and a degree-7 polynomial of atan(z) on z's 1/64 piece
// (degree 9 on the first).
__atan2_pi_fast: fn(y0: Float, x0: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    vy: to_bits(y0)
    vx: to_bits(x0)
    ay: vy.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    ax: vx.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if ax == ay {
        v := Float{0.75}
        if y0 == x0 {
            v = if (x0 > Float{0.0}) -> Float{0.25} else -> Float{-0.75}
        } else if (x0 > Float{0.0}) {
            v = Float{-0.25}
        }
        return (hi: v, lo: Float{0.0}, err: Float{0.0})
    }
    inv: ay > ax
    negz: (vy < 0) != (vx < 0)
    y: if inv -> x0 else -> y0
    x: if inv -> y0 else -> x0
    // y/x as qh + ql within 2^-98.41 relatively (Karp-Markstein)
    r: Float{1.0} / x
    qh: y * r
    ql: r * fma(x, -qh, y)
    neg: qh < Float{0.0}
    sz: if neg -> Float{-1.0} else -> Float{1.0}
    zh0: if neg -> -qh else -> qh
    zl: if neg -> -ql else -> ql
    i: Int.from_float(trunc(Float{64.0} * zh0)) ?? 0
    b: 10 * i
    zh: zh0 - __ATAN2PI_POINT[i]
    z: zh + zl
    h := if i == 0 -> fma(Float{0.11105902526508889}, z * z, __ATAN2PI_FAST[9]) else -> __ATAN2PI_FAST[b + 9]
    j := 6
    loop j >= 2 {
        h = fma(h, z, __ATAN2PI_FAST[b + 2 + j])
        j = j - 1
    }
    // degree 1: h (zh + zl) plus its double-double coefficient
    m: h * zh
    ml: fma(h, zl, fma(h, zh, -m))
    s1: __fast_two_sum(__ATAN2PI_FAST[b + 2], m)
    l1: ml + (s1.lo + __ATAN2PI_FAST[b + 3])
    // degree 0: (s1.hi + l1) (zh + zl) plus its double-double coefficient
    n: s1.hi * zh
    nl: fma(s1.hi, zl, fma(l1, zh, fma(s1.hi, zh, -n)))
    s0: __fast_two_sum(__ATAN2PI_FAST[b], n)
    l0: nl + (s0.lo + __ATAN2PI_FAST[b + 1])
    // atan_pi(|z|), then its sign
    ph: s0.hi * Float{0.3183098861837907}
    pl: fma(s0.hi, Float{-1.9678676675182486e-17}, fma(l0, Float{0.3183098861837907}, fma(s0.hi, Float{0.3183098861837907}, -ph)))
    hi := ph * sz
    lo := pl * sz
    if inv {
