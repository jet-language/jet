// 2^k for -1022 <= k <= 1023.
__tan_p2: fn(k: Int) -> Float Never! { from_bits((k + 1023) << 52) }
// v 2^-128 truncated to 53 bits, for 0 <= v < 2^128.
__tan_trunc53: fn(v: Int) -> Float Never! {
    if v == 0 -> return Float{0.0}
    hi: v >> 64
    n: if hi != 0 -> 128 - __clz64(hi) else -> 64 - __clz64(v)
    if n <= 53 -> return Float{v} * __tan_p2(-128)
    Float{v >> (n - 53)} * __tan_p2(n - 181)
}
// x/(2pi) mod 1 as i/2^11 + h + l within 2^-104.815, 0 <= h < 2^-11, for x >
// 1.3538603431225862e-8: beyond 2pi from 128 bits of the fraction, h and l
// truncated from them as tan.c's set_dd does.
__tan_reduce_fast: fn(x: Float) -> (i: Int, h: Float, l: Float) Never! {
    h := Float{0.0}
    l := Float{0.0}
    if (x <= Float{6.283185307179585}) {
        h = Float{0.15915494309189535} * x
        l = fma(Float{-9.839338337591243e-18}, x, fma(Float{0.15915494309189535}, x, -h))
    } else {
        b: to_bits(x)
        e: b >> 52
        m: b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
        c := 0
        sh := 0
        if e <= 1074 {
            c = ((m * __SINCOS_T[1]) << 64) + m * __SINCOS_T[2] + ((m * __SINCOS_T[3]) >> 64)
            sh = 1075 - e
        } else {
            i: (e - 1075) >> 6
            c = (((m * __SINCOS_T[i + 1]) << 128) + ((m * __SINCOS_T[i + 2]) << 64) + m * __SINCOS_T[i + 3] + ((m * __SINCOS_T[i + 4]) >> 64)).bit_and((1 << 192) - 1)
            sh = 1139 + 64 * i - e
        }
        r: (c >> sh).bit_and((1 << 128) - 1)
        if r != 0 {
            rh: r >> 64
            n: if rh != 0 -> 128 - __clz64(rh) else -> 64 - __clz64(r)
            if n <= 53 {
                h = Float{r} * __tan_p2(-128)
            } else {
                top: r >> (n - 53)
                h = Float{top} * __tan_p2(n - 181)
                // only the 64 bits after h's 53 reach l
                cut: if n > 117 -> n - 117 else -> 0
                l = __tan_trunc53(((r - (top << (n - 53))) >> cut) << cut)
            }
        }
    }
    k: floor(h * Float{2048.0})
    (i: Int.from_float(k) ?? 0, h: fma(k, Float{-0.00048828125}, h), l: l)
}
// tan x as hi + lo within |err| (CORE-MATH tan_fast): sin2pi and cos2pi of
// the reduced argument from __TAN_SC's points and short polynomials, then
// their ratio; err 1 where the reduced argument is too small.
__tan_fast: fn(x: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    red: __tan_reduce_fast(fabs(x))
    // pi <= x mod 2pi: tan(x - pi); pi/2 <= x mod pi: -cot(x - pi/2)
    flip: red.i.bit_and(0x200) != 0
    is_tan := !flip
    neg: (x < Float{0.0}) != flip
    i := red.i.bit_and(0x1FF)
    h := red.h
    l := red.l
    if i.bit_and(0x100) != 0 {
        // pi/4 <= x mod pi/2: cot(pi/2 - x)
        is_tan = !is_tan
        i = 0x1FF - i
        h = Float{0.00048828125} - h
        l = -l
    }
    if i == 0 && (h < Float{7.275957614183426e-12}) -> return (hi: Float{0.0}, lo: Float{0.0}, err: Float{1.0})
    t: __fast_two_sum(h - __TAN_SC[3 * i], l)
    uh: t.hi * t.hi
    ul: fma(t.hi + t.hi, t.lo, fma(t.hi, t.hi, -uh))
    // sin2pi(t) within 2^-71.61 and cos2pi(t) within 2^-69.96, relatively
    ps0: fma(fma(Float{-76.77083125858339}, uh, Float{81.60524929831949}), uh, Float{-41.34170224039976})
    ps1: __s_mul(ps0, uh, ul)
    ps2: __fast_two_sum(Float{6.283185307179586}, ps1.hi)
    pl: ps1.lo + (Float{2.4492937487389357e-16} + ps2.lo)
    psm: ps2.hi * t.hi
    sh: psm
    sl: fma(ps2.hi, t.lo, fma(pl, t.hi, fma(ps2.hi, t.hi, -psm)))
    pc0: fma(fma(Float{-85.41188646817469}, uh, Float{64.93939400729349}), uh, Float{-19.739208802178716})
    pc1: __s_mul(pc0, uh, ul)
    pc2: __fast_two_sum(Float{1.0}, pc1.hi)
    ch: pc2.hi
    cl: pc1.lo + (Float{-1.0396311785461432e-23} + pc2.lo)
    si: __TAN_SC[3 * i + 1]
    ci: __TAN_SC[3 * i + 2]
    // sin2pi and cos2pi of the whole reduced argument
    s0: __s_mul(ci, sh, sl)
    c0: __s_mul(si, ch, cl)
    p1: __fast_two_sum(c0.hi, s0.hi)
    l1: p1.lo + (s0.lo + c0.lo)
    c1: __s_mul(ci, ch, cl)
    s1: __s_mul(si, sh, sl)
    p2: __fast_two_sum(c1.hi, -s1.hi)
    l2: p2.lo + (c1.lo - s1.lo)
    bh: if is_tan -> p1.hi else -> p2.hi
    bl: if is_tan -> l1 else -> l2
    ah: if is_tan -> p2.hi else -> p1.hi
    al: if is_tan -> l2 else -> l1
    // (bh + bl) / (ah + al) within 2^-96.99 (Karp-Markstein)
    y: Float{1.0} / ah
    qh: bh * y
    ql: y * (fma(ah, -qh, bh) + fma(al, -qh, bl))
    sg: if neg -> Float{-1.0} else -> Float{1.0}
    rh: qh * sg
    (hi: rh, lo: ql * sg, err: rh * Float{1.4928955695357043e-20})
}
// The 192-bit float of a __TAN_S, __TAN_C, __TAN_PS or __TAN_PC entry.
__tan_coef: fn(t: [Int], i: Int) -> (sig: Int, ex: Int, sgn: Int) Never! {
    (sig: t[3 * i] << 64, ex: t[3 * i + 1], sgn: t[3 * i + 2])
}
// tan x when the fast path cannot round (CORE-MATH tan_accurate): x/(2pi)
// mod 1 to 192 bits as i/2^11 + X, then sin2pi and cos2pi of X by
// polynomials and of i/2^11 from tables, and their ratio, in 192-bit floats
// (tan.c's 128-bit ones, more precise).
__tan_accurate: fn(x: Float) -> Float Never! {
    // the two arguments whose tan lies closest to a rounding boundary
    ax: fabs(x)
    if (ax == Float{4.470348358154178e-7}) -> return copysign(Float{4.4703483581544753e-7} + Float{2.6469779601696883e-23}, x)
    if (ax == Float{8.940696716307641e-7}) -> return copysign(Float{8.940696716310023e-7} + Float{-7.828575563803332e-45}, x)
    b: to_bits(ax)
    e: b >> 52
    m: b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
    // 1/(2pi)'s words before k0 only add whole numbers; five words keep the
    // fraction's error below 2^-204
    q: (e - 1075) >> 6
    k0: if q > 0 -> q else -> 0
    w: (__SINCOS_T[k0 + 1] << 256) + (__SINCOS_T[k0 + 2] << 192) + (__SINCOS_T[k0 + 3] << 128) + (__SINCOS_T[k0 + 4] << 64) + __SINCOS_T[k0 + 5]
    sh: 1075 + 64 * (k0 + 5) - e
    f: (m * w).bit_and((1 << sh) - 1) >> (sh - 192)
    is_tan := true
    neg := x < Float{0.0}
    i := (f >> 181).bit_and(0x3FF)
    xr := f.bit_and((1 << 181) - 1)
    if i.bit_and(0x200) != 0 {
        // pi/2 <= x mod pi: -1/tan(x - pi/2)
        is_tan = false
        neg = !neg
        i = i.bit_and(0x1FF)
    }
    if i.bit_and(0x100) != 0 {
        // pi/4 <= x mod pi/2: 1/tan(pi/2 - x)
        is_tan = !is_tan
        xr = (1 << 181) - xr
        i = 0x1FF - i
    }
    xn: exact_bit_length(xr)
    xt: if xr == 0 -> (sig: 0, ex: -1076, sgn: 0) else -> (sig: xr << (192 - xn), ex: xn - 192, sgn: 0)
    x2: __tint_mul(xt, xt)
    u := __tint_mul(x2, __tan_coef(__TAN_PC, 5))
    v := __tint_mul(x2, __tan_coef(__TAN_PS, 5))
    j := 4
    loop j >= 0 {
        u = __tint_add(u, __tan_coef(__TAN_PC, j))
        v = __tint_add(v, __tan_coef(__TAN_PS, j))
        if j > 0 {
            u = __tint_mul(u, x2)
            v = __tint_mul(v, x2)
        }
        j = j - 1
    }
    // cos2pi(X) and sin2pi(X)
    v = __tint_mul(v, xt)
    si: __tan_coef(__TAN_S, i)
    ci: __tan_coef(__TAN_C, i)
    s: __tint_add(__tint_mul(si, u), __tint_mul(ci, v))
    sv: __tint_mul(si, v)
    c: __tint_add(__tint_mul(ci, u), (sig: sv.sig, ex: sv.ex, sgn: 1 - sv.sgn))
    r: if is_tan -> __tint_div(s, c) else -> __tint_div(c, s)
    // within 86 units of tan.c's 128-bit last place
    rs: if neg -> 1 - r.sgn else -> r.sgn
    __tint_to_float((sig: r.sig, ex: r.ex, sgn: rs), 86)
}
