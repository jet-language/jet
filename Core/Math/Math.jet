/// lgamma_r.c from musl 1.2.5: ln|gamma(x)|, by rational fits on [0, 2),
/// recurrence on [2, 8), Stirling's series above, reflection below zero.
lgamma: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    negative: bits < 0
    ix: (bits >> 32).bit_and(2147483647)
    if ix >= 2146435072 -> return n * n
    // |x| < 2^-70: -ln|x|
    if ix < 999292928 -> return if negative -> -ln(-n) else -> -ln(n)
