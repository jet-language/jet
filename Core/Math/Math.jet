#Test("SIMD lane types fold left to right and act lane by lane") {
    floats: F32x4.new(F32{1.0}, F32{2.0}, F32{3.0}, F32{4.0})
    assert_eq(floats.sum(), F32{10.0})
    assert_eq(floats.reduce(.Avg), F32{2.5})
    assert_eq((floats * floats).lane(3), F32{16.0})
    assert_eq(F32x8.splat(F32{0.5}).sum(), F32{4.0})
    assert_eq(F64x2.new(F64{NAN}, F64{2.0}).min(), F64{2.0})
    ints: I32x8.new(I32{1}, I32{2}, I32{3}, I32{4}, I32{5}, I32{6}, I32{7}, I32{8})
    assert_eq(ints.reduce(.Add), I32{36})
    assert_eq(ints.min(), I32{1})
    assert_eq((ints / I32x8.splat(I32{-2})).lane(2), I32{-1})
    assert_eq(U8x16.splat(U8{3}).sum(), U8{48})
}

// Stock coordinates retain the seed's frame-zero constructors and left frame.
ScreenPoint: struct {
    x: Float
    y: Float
    frame_id: Int

    new: fn(x: Float, y: Float) -> ScreenPoint Never! { ScreenPoint{x: x, y: y, frame_id: 0} }

    impl Add(ScreenDelta) {
        add: fn(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
    }

    impl Sub {
        sub: fn(self, rhs: ScreenPoint) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
    }

    impl Sub(ScreenDelta) {
        sub: fn(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
    }

    impl GeometryPoint {
        __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
    }
}
ScreenDelta: struct {
    x: Float
    y: Float
    frame_id: Int

    new: fn(x: Float, y: Float) -> ScreenDelta Never! { ScreenDelta{x: x, y: y, frame_id: 0} }

    impl Add {
        add: fn(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
    }

    impl Add(ScreenPoint) {
        add: fn(self, rhs: ScreenPoint) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
    }

    impl Sub {
        sub: fn(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
    }
}
