        y: x - Float{whole}
        p: y * (Float{-0.07721566490153287} + y * (Float{0.21498241596060885} + y * (Float{0.325778796408931} + y * (Float{0.14635047265246445} + y * (Float{0.02664227030336386} + y * (Float{0.0018402845140733772} + y * Float{0.00003194753265841009}))))))
        q: Float{1.0} + y * (Float{1.3920053346762105} + y * (Float{0.7219355475671381} + y * (Float{0.17193386563280308} + y * (Float{0.01864591917156529} + y * (Float{0.0007779424963818936} + y * Float{0.000007326684307446256})))))
        r = Float{0.5} * y + p / q
        z := Float{1.0}
        if whole >= 7 -> z = z * (y + Float{6.0})
        if whole >= 6 -> z = z * (y + Float{5.0})
        if whole >= 5 -> z = z * (y + Float{4.0})
        if whole >= 4 -> z = z * (y + Float{3.0})
        if whole >= 3 {
            z = z * (y + Float{2.0})
            r = r + ln(z)
        }
    } else if ix < 1133510656 {
        // 8 <= x < 2^58
        t: ln(x)
        z: Float{1.0} / x
        y: z * z
        w: Float{0.4189385332046727} + z * (Float{0.08333333333333297} + y * (Float{-0.0027777777772877554} + y * (Float{0.0007936505586430196} + y * (Float{-0.00059518755745034} + y * (Float{0.0008363399189962821} + y * Float{-0.0016309293409657527})))))
        r = (x - Float{0.5}) * (t - Float{1.0}) + w
    } else {
        r = x * (ln(x) - Float{1.0})
    }
    if negative -> r = reflection - r
    r
}
floor: fn(n: Float) -> Float Never! { core.math.floor(n) }
ceil: fn(n: Float) -> Float Never! { core.math.ceil(n) }
fract: fn(n: Float) -> Float Never! { n - trunc(n) }
hypot: fn(a: Float, b: Float) -> Float Never! { core.math.hypot(a, b) }
ln: fn(n: Float) -> Float Never! { core.math.ln(n) }
ln_1p: fn(n: Float) -> Float Never! { core.math.ln_1p(n) }
log1p: fn(n: Float) -> Float Never! { ln_1p(n) }
/// log2(1 + x), correctly rounded (C23 log2p1; CORE-MATH log2p1.c): NaN
/// below -1, -inf at -1, +inf at +inf, exact at every x = 2^k - 1, and a zero
/// keeps its sign.
log2_1p: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    e: (bits >> 52).bit_and(0x7FF) - 1023
    if e == 1024 || n == 0.0 || (n <= Float{-1.0}) {
        if (n < Float{-1.0}) -> return NAN
        if (n == Float{-1.0}) -> return -INFINITY
        return n + n
    }
    if (0 <= e && e <= 52 && n == Float{(1 << (e + 1)) - 1}) -> return Float{e + 1}
    if e == -1 && (n < Float{0.0}) {
        // 1 + x is exact here
        w: to_bits(Float{1.0} + n)
        if w.bit_and(0xF_FFFF_FFFF_FFFF) == 0 -> return Float{(w >> 52) - 1023}
    }
    if e > -920 {
        f: if e < -5 -> __log_1p_fast_small(n, Float{1.4426950408889634}, Float{2.0355273740931033e-17}) else -> __log_1p_fast(__one_plus(n, Float{1.7976931348623157e308}), Float{1.4426950408889634}, Float{2.0355273740931033e-17}, Float{3.851352932046897e-21})
        left: f.hi + (f.lo - f.err)
        if left == f.hi + (f.lo + f.err) -> return left
    }
    __log2_1p_accurate(n)
}
/// log10(1 + x), correctly rounded (C23 log10p1; CORE-MATH log10p1.c): NaN
/// below -1, -inf at -1, +inf at +inf, exact at every x = 10^k - 1 for k in
/// [1, 15], and a zero keeps its sign.
log10_1p: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    e: (bits >> 52).bit_and(0x7FF) - 1023
    if e == 1024 || n == 0.0 || (n <= Float{-1.0}) {
        if (n < Float{-1.0}) -> return NAN
        if (n == Float{-1.0}) -> return -INFINITY
        return n + n
    }
    if 3 <= e && e <= 49 {
        // the one 10^k - 1 in [2^e, 2^(e + 1)), if any, has k = floor((e + 1) log10(2))
        k: ((e + 1) * 1233) >> 12
        if (n == __EXP10_POWERS[k + 15] - Float{1.0}) -> return Float{k}
    }
    if e > -918 {
        f: if e < -5 -> __log_1p_fast_small(n, Float{0.4342944819032518}, Float{1.098319650216765e-17}) else -> __log_1p_fast(__one_plus(n, Float{9007199254740992.0}), Float{0.4342944819032518}, Float{1.098319650216765e-17}, Float{3.520480687025686e-21})
        left: f.hi + (f.lo - f.err)
        if left == f.hi + (f.lo + f.err) -> return left
    }
    __log10_1p_accurate(n)
}
log: fn(n: Float, base: Float) -> Float Never! { ln(n) / ln(base) }
log10: fn(n: Float) -> Float Never! { core.math.log10(n) }
log2: fn(n: Float) -> Float Never! { core.math.log2(n) }
/// logb.c from musl 1.2.5: ilogb as a Float, x * x for an infinity or NaN
/// and -inf for a zero.
logb: fn(n: Float) -> Float Never! {
    if !is_finite(n) -> return n * n
    if n == 0.0 -> return Float{-1.0} / (n * n)
    Float{ilogb(n) ?? 0}
}
sin: fn(n: Float) -> Float Never! { core.math.sin(n) }
sinh: fn(n: Float) -> Float Never! { core.math.sinh(n) }
sqrt: fn(n: Float) -> Float Never! { core.math.sqrt(n) }
/// 1/sqrt(x), correctly rounded (C23 rsqrt; CORE-MATH rsqrt.c): +inf for +0,
/// -inf for -0, +0 for +inf and NaN below zero. One Newton step on
/// (1/x) * sqrt(x) lands within a hair of the answer; when that hair could
/// straddle a rounding boundary the result is settled exactly.
rsqrt: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    biased: (bits >> 52).bit_and(0x7FF)
    if bits < 0 {
        if n == 0.0 -> return -INFINITY
        if is_nan(n) -> return n + n
        return from_bits(0x7FF8_0000_0000_0000)
    }
    r := Float{0.0}
    if biased == 0 {
        if bits == 0 -> return INFINITY
        r = sqrt(n) / n
    } else if biased < 0x7FD {
        r = (Float{1.0} / n) * sqrt(n)
    } else if biased < 0x7FF {
        r = (Float{4.0} / n) * (Float{0.25} * sqrt(n))
    } else {
        if is_nan(n) -> return n + n
        return 0.0
    }
    // r' = r - r/2 * (r^2 * x - 1), with r * x carried to about 106 bits
    rx: r * n
    drx: fma(r, n, -rx)
    h: fma(r, rx, Float{-1.0}) + r * drx
    dr: (r * Float{0.5}) * h
    refined: r - dr
    dr_bits: to_bits(dr).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    gap: (to_bits(r) >> 52) - (dr_bits >> 52).bit_and(0x7FF)
    if (dr_bits + 18).bit_and(0x7_FFFF_FFFF_FFFF) <= 23 || gap > 100 -> return __rsqrt_exact(refined, n)
    refined
}
// The correctly rounded 1/sqrt(x) for a finite x > 0, from a candidate r
// within an ulp: the midpoints on either side of r are tested exactly, by
// comparing m * m * x with 1 in integers. No midpoint is ever exact.
__rsqrt_exact: fn(candidate: Float, n: Float) -> Float Never! {
    x: __float_parts(n)
    r := candidate
    loop {
        c: __float_parts(r)
        if __square_times_below_one(2 * c.m + 1, c.e - 1, x) {
            r = next_up(r)
            next
        }
        power_of_two: c.m == 0x10_0000_0000_0000 && c.e > -1074
        low_m: if power_of_two -> 4 * c.m - 1 else -> 2 * c.m - 1
        low_e: if power_of_two -> c.e - 2 else -> c.e - 1
        if !__square_times_below_one(low_m, low_e, x) {
            r = next_down(r)
            next
        }
        return r
    }
}
// A finite x >= 0 as m * 2^e with m an Int.
__float_parts: fn(n: Float) -> (m: Int, e: Int) Never! {
    bits: to_bits(n).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    biased: bits >> 52
    fraction: bits.bit_and(0xF_FFFF_FFFF_FFFF)
    if biased == 0 -> return (m: fraction, e: -1074)
    (m: fraction.bit_or(0x10_0000_0000_0000), e: biased - 1075)
}
// Whether (m * 2^e)^2 * x < 1, exactly.
__square_times_below_one: fn(m: Int, e: Int, x: (m: Int, e: Int)) -> Bool Never! {
    shift: 2 * e + x.e
    if shift >= 0 -> return false
    m * m * x.m < (Int{1} << -shift)
}
/// base^exponent for a whole exponent, correctly rounded (C23 pown): 1 for
/// exponent 0 even when base is NaN, and for a zero or infinite base the
/// zero or infinity pow gives, negative for a negative base and an odd
/// exponent. Every Int exponent is taken exactly, however large.
pow_n: fn(base: Float, exponent: Int) -> Float Never! {
    if exponent == 0 -> return Float{1.0}
    if is_nan(base) -> return base + base
    sign: if exponent.bit_and(1) == 1 && to_bits(base) < 0 -> Float{-1.0} else -> Float{1.0}
    a: fabs(base)
    if a == 0.0 || is_inf(a) {
        if (exponent > 0) == (a == 0.0) -> return sign * Float{0.0}
        return sign * INFINITY
    }
    if -0x20_0000_0000_0000 <= exponent && exponent <= 0x20_0000_0000_0000 -> return sign * __pow_cr(a, Float{exponent})
    sign * __pow_big(a, exponent)
}
/// base^exponent as e^(exponent ln base), correctly rounded (C23 powr): NaN
/// for base < 0 and for 0^0, inf^0 and 1^inf, +inf for 0^y with y < 0, +0
/// for 0^y with y > 0, and 1 for 1^y with y finite and for x^0 with x finite
/// and positive. Float.pow keeps musl's bits and pow's rules.
pow_r: fn(base: Float, exponent: Float) -> Float Never! {
    if is_nan(base) || is_nan(exponent) -> return base + exponent
    if (base < Float{0.0}) -> return NAN
    if exponent == 0.0 {
        if base == 0.0 || is_inf(base) -> return NAN
        return Float{1.0}
    }
    if base == 0.0 {
        if (exponent < Float{0.0}) -> return INFINITY
        return 0.0
    }
    if is_inf(base) {
        if (exponent < Float{0.0}) -> return 0.0
        return INFINITY
    }
    if (base == Float{1.0}) {
        if is_inf(exponent) -> return NAN
        return Float{1.0}
    }
    if is_inf(exponent) {
        if ((base < Float{1.0}) == (exponent > Float{0.0})) -> return 0.0
        return INFINITY
    }
    __pow_cr(base, exponent)
}
// a^y for finite a > 0 and finite y != 0 (CORE-MATH pow.c cr_pow): phase 1
// in double-double, then y = 1, 2 and 1/2 directly, then __pow_accurate.
__pow_cr: fn(a: Float, y: Float) -> Float Never! {
    l: __pow_log_1(a)
    ey: (to_bits(y) >> 52).bit_and(0x7FF)
    // y log(a) could underflow below 2^-969 or overflow from 2^1014
    if 0x36 <= ey && ey < 0x7F5 {
        r: __s_mul(y, l.hi, l.lo)
        e: __pow_exp_1(r.hi, r.lo)
        // 2^-57.579 when log(a) cancelled, else 2^-63.797
        bound: if l.cancel -> Float{4.6485168145316e-18} else -> Float{6.246867986000465e-20}
        low: e.hi + fma(bound, -e.hi, e.lo)
        if low == e.hi + fma(bound, e.hi, e.lo) -> return low
    }
    if (y == Float{1.0}) -> return a
    if (y == Float{2.0}) -> return a * a
    if (y == Float{0.5}) -> return sqrt(a)
    __pow_accurate(a, y)
}
// log(x) as hi + lo for a finite x > 0 (CORE-MATH pow.c log_1): x = 2^e t
// with t in (1/sqrt 2, sqrt 2), z = r t - 1 exact for the 9-bit inverse r,
// log x = e log 2 - log r + log(1 + z). cancel when e = 0 and lo is not
// below 2^-24 hi.
__pow_log_1: fn(x: Float) -> (hi: Float, lo: Float, cancel: Bool) Never! {
    u: to_bits(x)
    m := u.bit_and(0xF_FFFF_FFFF_FFFF)
    e := (u >> 52).bit_and(0x7FF)
    tb := 0
    if e != 0 {
        tb = m.bit_or(0x3FF0_0000_0000_0000)
        m = m + 0x10_0000_0000_0000
        e = e - 0x3FF
    } else {
        k: __clz64(m) - 11
        e = -0x3FE - k
        m = m << k
        tb = m.bit_or(0x3FF0_0000_0000_0000)
    }
    c: m >= 0x16_A09E_667F_3BCD
    if c -> e = e + 1
    i: if c -> (m >> 45) - 181 else -> (m >> 44) - 181
    t: if c -> from_bits(tb) * Float{0.5} else -> from_bits(tb)
    z: fma(__POW_INVERSE[i], t, Float{-1.0})
    ee: Float{e}
    th: fma(ee, Float{0.6931471805598903}, __POW_LOG_INVERSE[2 * i])
    tl: fma(ee, Float{5.497923018708371e-14}, __POW_LOG_INVERSE[2 * i + 1])
    s: __fast_sum_ddd(th, tl, z)
    p: __pow_p_1(z)
    h: __fast_sum_ddd(s.hi, s.lo + p.lo, p.hi)
    if e == 0 && (fabs(h.lo) > fabs(h.hi) * Float{5.960464477539063e-8}) {
        f: __fast_two_sum(h.hi, h.lo)
        return (hi: f.hi, lo: f.lo, cancel: true)
    }
    (hi: h.hi, lo: h.lo, cancel: false)
}
// log(1 + z) - z for |z| < 0.00403 as hi + lo (CORE-MATH pow.c p_1): a
// degree-8 polynomial, -z^2/2 kept in double-double.
__pow_p_1: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    wh: z * z
    wl: fma(z, z, -wh)
    t: fma(Float{-0.12500370131039634}, z, Float{0.1428610267999632})
    u := fma(Float{-0.16666666662262275}, z, Float{0.19999999995699516})
    v := fma(Float{-0.25000000000000017}, z, Float{0.3333333333333335})
    u = fma(t, wh, u)
    v = fma(u, wh, v)
    (hi: Float{-0.5} * wh, lo: fma(v * wh, z, Float{-0.5} * wl))
}
// e^(rh + rl) as hi + lo (CORE-MATH pow.c exp_1): rh + rl = k log(2)/4096 + z,
// then 2^(k/4096) e^z. Sure overflow gives DBL_MAX twice and sure underflow
// zeros; NaN where the result could overflow or be subnormal, for the slow
// path to settle.
__pow_exp_1: fn(rh: Float, rl: Float) -> (hi: Float, lo: Float) Never! {
    if is_nan(rh) || (rh > Float{709.7826672320183}) {
        if (rh > Float{709.7827585515907}) -> return (hi: Float{1.7976931348623157e308}, lo: Float{1.7976931348623157e308})
        return (hi: NAN, lo: NAN)
    }
    if (rh < Float{-656.4652340719966}) {
        if (rh < Float{-745.1332670341407}) -> return (hi: 0.0, lo: 0.0)
        return (hi: NAN, lo: NAN)
    }
    k: round_even(rh * Float{5909.278887481194})
    zh: fma(Float{0.0001692253858788929}, -k, rh)
    zl: fma(Float{5.661735385366942e-21}, -k, rl)
    __exp_dd_tail(k, __pow_q_1(zh + zl))
}
// e^z for |z| < 2^-12.905 as hi + lo (CORE-MATH pow.c q_1): degree 4.
__pow_q_1: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    q := fma(Float{0.041666666688168076}, z, Float{0.16666666679061554})
    q = fma(q, z, Float{0.5})
    h0: fma(q, z, Float{1.0})
    h1: z * h0
    __fast_sum_ddd(Float{1.0}, fma(z, h0, -h1), h1)
}
// a^y correctly rounded where phase 1 could not tell: an exact power or
// midpoint exactly, a power far outside the Floats from log2, the rest by
// __pow_ziv.
__pow_accurate: fn(a: Float, y: Float) -> Float Never! {
    exact: __pow_exact(a, y)
    if !is_nan(exact) -> return exact
    lg: y * log2(a)
    if (lg > Float{1100.0}) -> return INFINITY
    if (lg < Float{-1200.0}) -> return 0.0
    x: __float_parts(a)
    p: __float_parts(fabs(y))
    yn: if (y < Float{0.0}) -> -p.m else -> p.m
    __pow_ziv(x.m, x.e, yn, p.e, 1)
}
// a^n for finite a > 0 and |n| > 2^53: exact for a power of two, from log2
// far outside the Floats, else by __pow_ziv; no other such a^n is a Float or
// a midpoint.
__pow_big: fn(a: Float, n: Int) -> Float Never! {
    if (a == Float{1.0}) -> return a
    x: __float_parts(a)
    if x.m.bit_and(x.m - 1) == 0 -> return __round_scaled(1, (x.e + __bit_len(x.m) - 1) * n)
    cap: Int{1} << 1000
    cn := n
    if cn > cap -> cn = cap
    if cn < -cap -> cn = -cap
    lg: approx(cn) * log2(a)
    if (lg > Float{1100.0}) -> return INFINITY
    if (lg < Float{-1200.0}) -> return 0.0
    __pow_ziv(x.m, x.e, n, 0, 1)
}
/// The nth root of x, correctly rounded (C23 rootn): NaN for n = 0, for a
/// NaN and for x < 0 with n even; for x < 0 and n odd the negative root. A
/// zero gives a zero for n > 0 and an infinity for n < 0, an infinity the
/// reverse, each negative only for a negative x and an odd n.
root_n: fn(x: Float, n: Int) -> Float Never! {
    if n == 0 -> return NAN
    if is_nan(x) -> return x + x
    odd: n.bit_and(1) == 1
    if (x < Float{0.0}) && !odd -> return NAN
    sign: if odd && to_bits(x) < 0 -> Float{-1.0} else -> Float{1.0}
    a: fabs(x)
    if a == 0.0 || is_inf(a) {
        if (n > 0) == (a == 0.0) -> return sign * Float{0.0}
        return sign * INFINITY
    }
    if n == 1 -> return x
    if n == -1 -> return Float{1.0} / x
    if n == 2 -> return sqrt(a)
    if n == -2 -> return rsqrt(a)
    if (a == Float{1.0}) -> return sign
    sign * __root_cr(a, n)
}
// a^(1/n) for finite a > 0, a != 1 and |n| >= 3: exact roots exactly, then
// for |n| <= 2^53 pow's phase 1 on log(a)/n, then __pow_ziv. No such root
// lies outside the normal Floats, and none is a midpoint: one would need an
// odd 54-bit significand whose nth power is a's 53-bit one.
__root_cr: fn(a: Float, n: Int) -> Float Never! {
    exact: __root_exact(a, n)
    if !is_nan(exact) -> return exact
    if -0x20_0000_0000_0000 <= n && n <= 0x20_0000_0000_0000 {
        l: __pow_log_1(a)
        d: Float{n}
        rh: l.hi / d
        rl: (fma(-rh, d, l.hi) + l.lo) / d
        r: __fast_two_sum(rh, rl)
        e: __pow_exp_1(r.hi, r.lo)
        // pow's bounds plus 2^-90 for the division
        bound: if l.cancel -> Float{4.6485168145316e-18} else -> Float{6.246867986000465e-20}
        low: e.hi + fma(bound + Float{8.077935669463161e-28}, -e.hi, e.lo)
        if low == e.hi + fma(bound + Float{8.077935669463161e-28}, e.hi, e.lo) -> return low
    }
    x: __float_parts(a)
    if n < 0 -> return __pow_ziv(x.m, x.e, -1, 0, -n)
    __pow_ziv(x.m, x.e, 1, 0, n)
}
// a^(1/n) when it is a Float, else NaN: with a = m 2^e and m odd, n must
// divide e and m must be the nth power of a whole s, and s = 1 for n < 0.
__root_exact: fn(a: Float, n: Int) -> Float Never! {
    x: __float_parts(a)
    m := x.m
    e := x.e
    loop m.bit_and(1) == 0 {
        m = m >> 1
        e = e + 1
    }
