// asin(x) - x for x / 2^128 in [0, 2^-6): x^3 / 6 + ... in 2^128 units.
__asin_pi_poly: fn(x: Int) -> Int Never! {
    xh: x >> 64
    m: 0xFFFF_FFFF_FFFF_FFFF
    tl: (__muuh(xh, (0x5BA2_E8BA_2E8A_D9B7 + __muuh(xh, (0x4_713B_13B2_9079 + __muuh(xh, (0x39_3331_E196 + __muuh(xh, 0x2F5_C315)).bit_and(m))).bit_and(m))).bit_and(m)) + 0x1C71_C71C_71C7_6217).bit_and(m)
    t: (0x7C7 << 64) + tl
    c2: __u128(0xB6_DB6D_B6DB_6DB6_DB6D_A950 + __mul_hi128(x, t))
    c1: __u128(0x13_3333_3333_3333_3333_3333_3484 + __mul_hi128(x, c2))
