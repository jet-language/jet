// exp_m1's accurate path: for |x| < 1/4 the degree-19 Taylor polynomial,
// its x^3 to x^13 coefficients double-double; beyond, e^x = 2^(t/4096) e^dx
// as in exp with 2^-ie subtracted before the scaling. Then __EXPM1CR_HARD's
// exceptions.
__exp_m1_cr_accurate: fn(n: Float) -> Float Never! {
    if fabs(n) < (Float{0.25}) {
        c: __EXPM1CR_CL
        fl0: n * (c[0] + n * (c[1] + n * (c[2] + n * (c[3] + n * (c[4] + n * c[5])))))
        f0: __exp_m1_cr_opolyddd(n, __EXPM1CR_CS, 0, 11, fl0)
        f1: __exp_m1_cr_mulddd(f0.hi, f0.lo, n)
        f2: __exp_m1_cr_mulddd(f1.hi, f1.lo, n)
        f3: __exp_m1_cr_mulddd(f2.hi, f2.lo, n)
        hx: Float{0.5} * n
        x2h: n * hx
        x2l: fma(n, hx, -x2h)
        s: __fast_two_sum(x2h, f3.hi)
        sl: (x2l + f3.lo) + s.lo
        a: __fast_two_sum(n, s.hi)
        b: __fast_two_sum(a.lo, sl)
        c0: __fast_two_sum(a.hi, b.hi)
        c1: __fast_two_sum(c0.lo, b.lo)
        v1 := c1.hi
        vb: to_bits(v1)
        if vb.bit_and(0x000F_FFFF_FFFF_FFFF) == 0 {
            if vb.bit_and(0x7FFF_FFFF_FFFF_FFFF) == 0 -> return __exp_m1_cr_listed(n, c0.hi)
            // v1 a power of 2: the sticky c1.lo moves it one unit
            step: if (vb < 0) != (to_bits(c1.lo) < 0) -> -1 else -> 1
            v1 = from_bits(vb + step)
        }
        return c0.hi + v1
    }
    t: round_even(n * Float{5909.278887481194})
    jt: Int.from_float(t) ?? 0
    i0: (jt >> 6).bit_and(0x3F)
    i1: jt.bit_and(0x3F)
    ie: jt >> 12
    tt: __exp_cr_muldd(__EXP2CR_T0[2 * i0 + 1], __EXP2CR_T0[2 * i0], __EXP2CR_T1[2 * i1 + 1], __EXP2CR_T1[2 * i1])
    dx: n - Float{0.00016922538588914904} * t
    dxl0: Float{1.0256140314162804e-14} * t
    dxll: Float{3.2042720746546034e-31} * t + fma(Float{1.0256140314162804e-14}, t, -dxl0)
    dxh: dx + dxl0
    dxl: ((dx - dxh) + dxl0) + dxll
    f0: __exp_m1_cr_opolydd(dxh, dxl, __EXPCR_CH, 0, 7, Float{0.0})
    f1: __exp_cr_muldd(dxh, dxl, f0.hi, f0.lo)
    f2: __exp_cr_muldd(f1.hi, f1.lo, tt.hi, tt.lo)
    s: __fast_two_sum(tt.hi, f2.hi)
    fh := s.hi
    fl := (tt.lo + f2.lo) + s.lo
    off: -from_bits((1023 - ie) << 52)
    if ie < 53 {
        o: __fast_two_sum(off, fh)
        fh = o.hi
        fl = fl + o.lo
    } else if ie < 104 {
        o: __fast_two_sum(fh, off)
        fh = o.hi
        fl = fl + o.lo
    }
    r: __fast_two_sum(fh, fl)
    fh = r.hi
    if (to_bits(r.lo) + 8).bit_and(0x000F_FFFF_FFFF_FFFF) <= 8 -> fh = __exp_m1_cr_listed(n, fh)
    __exp_cr_scale(fh, ie)
}
// exp_m1's exceptions: __exp_cr_listed with a tail of 2^-54 units of f.
__exp_m1_cr_listed: fn(n: Float, f: Float) -> Float Never! {
    tail: from_bits(((to_bits(f) >> 52).bit_and(0x7FF) - 54) << 52)
    __exp_cr_listed(n, f, __EXPM1CR_HARD, 0x0C06_76F5_8B0D_65BD_5553, 0x30_0E81_651C, tail)
}
// (xh + xl) c as a double-double, xl c's rounding error dropped.
__exp_m1_cr_mulddd: fn(xh: Float, xl: Float, c: Float) -> (hi: Float, lo: Float) Never! {
    h: c * xh
    (hi: h, lo: c * xl + fma(c, xh, -h))
}
// The n (hi, lo) coefficients of c from index o at xh + xl, Horner in
// double-double, with l added to the top coefficient (expm1.c's opolydd at l
// = 0, log1p.c's and lgamma.c's polydd).
__exp_m1_cr_opolydd: fn(xh: Float, xl: Float, c: [Float], o: Int, n: Int, l: Float) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    t: __fast_two_sum(c[o + 2 * i], l)
    ch := t.hi
    cl := c[o + 2 * i + 1] + t.lo
    loop i > 0 {
        i = i - 1
        p: __exp_cr_muldd(xh, xl, ch, cl)
        s: __fast_two_sum(c[o + 2 * i], p.hi)
        ch = s.hi
        cl = (c[o + 2 * i + 1] + p.lo) + s.lo
    }
    (hi: ch, lo: cl)
}
// The n (hi, lo) coefficients of c from index o at the double x, Horner in
// double-double, with l added to the top coefficient (lgamma.c's
// polydddfst).
__exp_m1_cr_opolyddd: fn(x: Float, c: [Float], o: Int, n: Int, l: Float) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    t: __fast_two_sum(c[o + 2 * i], l)
    ch := t.hi
    cl := c[o + 2 * i + 1] + t.lo
    loop i > 0 {
        i = i - 1
        p: __exp_m1_cr_mulddd(ch, cl, x)
        s: __fast_two_sum(c[o + 2 * i], p.hi)
        ch = s.hi
        cl = (c[o + 2 * i + 1] + p.lo) + s.lo
    }
    (hi: ch, lo: cl)
}
