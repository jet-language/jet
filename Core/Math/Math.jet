/// logb.c from musl 1.2.5: ilogb as a Float, x * x for an infinity or NaN
/// and -inf for a zero.
logb: fn(n: Float) -> Float Never! {
    if !is_finite(n) -> return n * n
    if n == 0.0 -> return Float{-1.0} / (n * n)
    Float{ilogb(n) ?? 0}
}
/// sin x, correctly rounded (CORE-MATH sin.c): a zero keeps its sign, and NaN
/// for an infinity.
sin: fn(n: Float) -> Float Never! {
    bits: __to_bits_i64(n)
    e: (bits >> 52).bit_and(0x7FF)
    if e < 0x3E5 {
        // |x| < 2^-26: x - x^3/6 is within half an ulp of x
        if bits.bit_and(0x7FFF_FFFF_FFFF_FFFF) == 0 -> return n
        return fma(n, Float{-5.551115123125783e-17}, n)
    }
    if e < 0x41E -> return __sin_moderate(n)
    if e == 0x7FF -> return __pi_trig_special(n)
    __sin_large(n)
}
/// sinh x, correctly rounded (CORE-MATH sinh.c): odd in x, +-inf from about
/// +-710.48 out, and NaN for NaN.
sinh: fn(n: Float) -> Float Never! {
    ax: fabs(n)
    aix: to_bits(ax)
    if aix < 0x3FD0_0000_0000_0000 {
        if aix < 0x3E57_1374_4912_3EF7 -> return fma(n, Float{2.7755575615628914e-17}, n)
        x2: n * n
        x3: x2 * n
        x4: x2 * x2
        p: x3 * ((Float{0.16666666666666666} + x2 * Float{0.008333333333335132}) + x4 * ((Float{0.00019841269832592963} + x2 * Float{0.0000027557330544555877}) + x4 * Float{2.5059397415904265e-8}))
        e: x3 * Float{1.942890293094024e-16}
        lb: n + (p - e)
        if lb == n + (p + e) -> return lb
        return __sinh_zero(n)
    }
    if aix > 0x4086_33CE_8FB9_F87D {
        if aix >= 0x7FF0_0000_0000_0000 -> return n + n
        return copysign(Float{8.98846567431158e307}, n) * Float{2.0}
    }
    __sinh_cosh(ax, copysign(1.0, n), -1.0, Float{1.2001398071409368e-19}, __SINH_HARD)
}
// sinh x for 2^-25.47 < |x| < 1/4 in double-double (sinh.c as_sinh_zero).
__sinh_zero: fn(x: Float) -> Float Never! {
    x2: x * x
    x2l: fma(x, x, -x2)
    y2: x2 * (Float{1.6059043837926057e-10} + x2 * (Float{7.647161643548583e-13} + x2 * Float{2.8135131492069468e-15}))
    p: __hyp_poly_dd(x2, x2l, __SINH_ZERO_C, 5, y2, false)
    a: __hyp_mul_dd_d(p.hi, p.lo, x)
    b: __hyp_mul_dd(a.hi, a.lo, x2, x2l, false)
    s0: __fast_two_sum(x, b.hi)
    s1: __fast_two_sum(s0.lo, b.lo)
    s0.hi + __hyp_nudge(s1.hi, s1.lo)
}
// sinh x (odd: sg = copysign(1, x), m = -1) or cosh x (sg = m = 1) for
// |x| = ax from 1/8 (cosh) or 1/4 (sinh) to about 710.48, as
// (e^ax + m e^-ax) / 2 from 2^(k/4096) e^dx: sinh.c's and cosh.c's shared
// main path, e36 their error bound past |x| = 36.74 and hard their hard cases.
__sinh_cosh: fn(ax: Float, sg: Float, m: Float, e36: Float, hard: [Float]) -> Float Never! {
    aix: to_bits(ax)
    v0: fma(ax, Float{5909.278887481194}, Float{100663296.5})
    vb: to_bits(v0)
    t: from_bits(vb.bit_and(0x7FFF_FFFF_FC00_0000)) - Float{100663296.0}
    il: (vb >> 26).bit_and(0xFF_FFFF)
    jl: -il
    i1: il.bit_and(63)
    i0: (il >> 6).bit_and(63)
    ie: il >> 12
    j1: jl.bit_and(63)
    j0: (jl >> 6).bit_and(63)
    t0h: __HYP_T0[2 * i0 + 1]
    t1h: __HYP_T1[2 * i1 + 1]
    th0: t0h * t1h
    tl0: t0h * __HYP_T1[2 * i1] + t1h * __HYP_T0[2 * i0] + fma(t0h, t1h, -th0)
    dx: (ax - Float{0.00016922538588914904} * t) + Float{1.0256140314162804e-14} * t
    dx2: dx * dx
    mx: -dx
    pp: dx * ((Float{1.0} + dx * Float{0.5}) + dx2 * (Float{0.1666666668218872} + dx * Float{0.041666666640865824}))
    rh := Float{0.0}
    rl := Float{0.0}
    if aix > 0x4014_0000_0000_0000 {
        if aix > 0x4042_5E4F_7B27_37FA {
            // e^-ax is below the rounding: only e^ax / 2
            sp: from_bits((1021 + ie) << 52)
            h0: th0 * sg
            l0: (tl0 + th0 * pp) * sg
            e: e36 * th0
            lb: h0 + (l0 - e)
            if lb == h0 + (l0 + e) -> return (lb * sp) * Float{2.0}
            a: __hyp_exp_accurate(ax, t, th0, tl0, false)
            f: __fast_two_sum(a.hi, a.lo)
            h: f.hi * sg
            l: f.lo * sg
            r: ((h + l) * Float{2.0}) * sp
            if (to_bits(l) + 8).bit_and(0xF_FFFF_FFFF_FFFF) <= 16 -> return __hyp_listed(hard, ax, sg, r)
            return r
        }
        sp: from_bits((1022 + ie) << 52)
        sm: from_bits((1022 + (jl >> 12)) << 52)
        q0h: __HYP_T0[2 * j0 + 1]
        q1h: __HYP_T1[2 * j1 + 1]
        th: th0 * sp
        tl: tl0 * sp
        qh: (q0h * q1h) * sm
        pm: mx * ((Float{1.0} + mx * Float{0.5}) + dx2 * (Float{0.1666666668218872} + mx * Float{0.041666666640865824}))
        em: m * (qh + qh * pm)
        h0: th * sg
        l0: ((tl + em) + th * pp) * sg
        e: Float{1.2202568396382264e-19} * h0
        lb: h0 + (l0 - e)
        if lb == h0 + (l0 + e) -> return lb
        a: __hyp_exp_accurate(ax, t, th, tl, false)
        if aix > 0x403F_6666_6666_6666 {
            qn: m * qh
            rh = a.hi + qn
            rl = ((a.hi - rh) + qn) + a.lo
        } else {
            qh2: q0h * q1h
            ql: q0h * __HYP_T1[2 * j1] + q1h * __HYP_T0[2 * j0] + fma(q0h, q1h, -qh2)
            b: __hyp_exp_accurate(-ax, -t, qh2 * sm, ql * sm, false)
            bh: m * b.hi
            rh = a.hi + bh
            rl = (((a.hi - rh) + bh) + m * b.lo) + a.lo
        }
    } else {
        sp: from_bits((1022 + ie) << 52)
        sm: from_bits((1022 + (jl >> 12)) << 52)
        q0h: __HYP_T0[2 * j0 + 1]
        q1h: __HYP_T1[2 * j1 + 1]
        qh0: q0h * q1h
        ql0: q0h * __HYP_T1[2 * j1] + q1h * __HYP_T0[2 * j0] + fma(q0h, q1h, -qh0)
        th: th0 * sp
        tl: tl0 * sp
        qh: qh0 * sm
        ql: ql0 * sm
        pm: mx * ((Float{1.0} + mx * Float{0.5}) + dx2 * (Float{0.1666666668218872} + mx * Float{0.041666666640865824}))
        fpl: tl + th * pp
        fmh: m * qh
        fml: m * (ql + qh * pm)
        h1: th + fmh
        h0: h1 * sg
        l0: ((((th - h1) + fmh) + fml) + fpl) * sg
        e: Float{3.800001559619605e-19} * h0
        lb: h0 + (l0 - e)
        if lb == h0 + (l0 + e) -> return lb
        a: __hyp_exp_accurate(ax, t, th, tl, false)
        b: __hyp_exp_accurate(-ax, -t, qh, ql, false)
        bh: m * b.hi
        rh = a.hi + bh
        rl = (((a.hi - rh) + bh) + m * b.lo) + a.lo
    }
    f: __fast_two_sum(rh, rl)
    r: f.hi * sg + f.lo * sg
    if (to_bits(f.lo) + 8).bit_and(0xF_FFFF_FFFF_FFFF) <= 16 -> return __hyp_listed(hard, ax, sg, r)
    r
}
// (th + tl) e^(x - t log(2) / 4096) in double-double, for |x - t log(2) / 4096|
// <= log(2) / 8192 (the shared as_exp_accurate of sinh.c, cosh.c and tanh.c;
// acc: tanh.c's renormalizing products).
__hyp_exp_accurate: fn(x: Float, t: Float, th: Float, tl: Float, acc: Bool) -> (hi: Float, lo: Float) Never! {
    dx: x - Float{0.00016922538588914904} * t
    dxl0: Float{1.0256140314162804e-14} * t
    dxll: Float{3.2042720746546034e-31} * t + fma(Float{1.0256140314162804e-14}, t, -dxl0)
    dxh: dx + dxl0
    dxl: ((dx - dxh) + dxl0) + dxll
    fl: dxh * (Float{0.041666666666666664} + dxh * (Float{0.008333333338507347} + dxh * Float{0.0013888888882434365}))
    p: __hyp_poly_dd(dxh, dxl, __HYP_EXP_C, 3, fl, acc)
    f1: __hyp_mul_dd(dxh, dxl, p.hi, p.lo, acc)
    f2: __hyp_mul_dd(th, tl, f1.hi, f1.lo, acc)
    zh: th + f2.hi
    zl: (th - zh) + f2.hi
    uh: zh + tl
    ul: ((zh - uh) + tl) + zl
    vh: uh + f2.lo
    (hi: vh, lo: ((uh - vh) + f2.lo) + ul)
}
// (xh + xl) (ch + cl): sinh.c's and cosh.c's unnormalized muldd, or with acc
// tanh.c's muldd_acc (__mul_dd).
__hyp_mul_dd: fn(xh: Float, xl: Float, ch: Float, cl: Float, acc: Bool) -> (hi: Float, lo: Float) Never! {
    if acc -> return __mul_dd(xh, xl, ch, cl)
    h: xh * ch
    (hi: h, lo: fma(xh, ch, -h) + xh * cl + xl * ch)
}
__hyp_mul_dd_d: fn(xh: Float, xl: Float, c: Float) -> (hi: Float, lo: Float) Never! {
    h: xh * c
    (hi: h, lo: fma(xh, c, -h) + xl * c)
}
// The double-double polynomial of n (hi, lo) pairs of c in xh + xl, with l
// added to the last coefficient (the polydd of sinh.c, cosh.c and tanh.c).
__hyp_poly_dd: fn(xh: Float, xl: Float, c: [Float], n: Int, l: Float, acc: Bool) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    s0: __fast_two_sum(c[2 * i], l)
    ch := s0.hi
    cl := s0.lo + c[2 * i + 1]
    loop i > 0 {
        i = i - 1
        p: __hyp_mul_dd(xh, xl, ch, cl, acc)
        s: __fast_two_sum(c[2 * i], p.hi)
        ch = s.hi
        cl = (p.lo + c[2 * i + 1]) + s.lo
    }
    (hi: ch, lo: cl)
}
// y1 moved one ulp toward y2 when its significand bits are all zero, so the
// sum with a higher part rounds the way y1 + y2 does.
__hyp_nudge: fn(y1: Float, y2: Float) -> Float Never! {
    b: to_bits(y1)
    if b.bit_and(0xF_FFFF_FFFF_FFFF) != 0 -> return y1
    d: if (b < 0) != (to_bits(y2) < 0) -> -1 else -> 1
    from_bits(__wrap_i64(b + d))
}
// f, or the listed sg (hi + lo) of a hard case |x| = ax in rows of three.
__hyp_listed: fn(hard: [Float], ax: Float, sg: Float, f: Float) -> Float Never! {
    k := 0
    loop k < hard.len() {
        if ax == hard[k] -> return sg * hard[k + 1] + sg * hard[k + 2]
        k = k + 3
    }
    f
}
__HYP_EXP_C: [Float]{1.0, 7.180385960686095e-29, 0.5, -1.523885870582321e-28, 0.16666666666666666, 9.213309146126262e-18}
// sinh.c's degree-3..11 odd coefficients as (hi, lo) pairs.
__SINH_ZERO_C: [Float]{
    0.16666666666666666, 9.251858538542912e-18, 0.008333333333333333, 1.1564823185149052e-19,
    0.0001984126984126984, 1.720553633109976e-22, 0.0000027557319223985893, -1.8069132505534607e-22,
    2.5052108385441396e-8, -7.738469464826113e-25
}
