// The F32 form of hypot, CORE-MATH hypotf.c on the widened binary32 a and b:
// a Float that narrows to the correctly rounded binary32 result. Narrowing
// hypot(a, b) itself could round twice when that lands on a binary32
// midpoint, so a result within one binary64 step of a binary32 boundary is
// recomputed with its error term and moved off the midpoint to its own side.
__hypot_f32: fn(a: Float, b: Float) -> Float Never! {
    ax: fabs(a)
    bx: fabs(b)
    if !is_finite(ax) || !is_finite(bx) -> return hypot(a, b)
    big: if ax > bx -> ax else -> bx
    small: if ax > bx -> bx else -> ax
    x2: big * big
    y2: small * small
    r2: x2 + y2
