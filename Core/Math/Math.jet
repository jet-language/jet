        c: if negz -> Float{-0.5} else -> Float{0.5}
        t: __fast_two_sum(c, -hi)
        hi = t.hi
        lo = t.lo - lo
    }
    if (x0 < Float{0.0}) {
        // the opposite quadrant: plus or minus 1
        c: if negz -> Float{1.0} else -> Float{-1.0}
        t: __fast_two_sum(c, hi)
        hi = t.hi
        lo = t.lo + lo
    }
