// exp10's accurate path: a three-part reduction x = t log10(2)/4096 + dx,
// a degree-6 double-double polynomial, then __EXP10CR_HARD's exceptions.
__exp10_cr_accurate: fn(n: Float) -> Float Never! {
    t: round_even(Float{13606.617476658635} * n)
    jt: __whole_i64(t)
    i1: Int{jt.bit_and(0x3F)}
    i0: Int{(jt >> 6).bit_and(0x3F)}
    ie: jt >> 12
    tt: __exp_cr_muldd(__EXP2CR_T0[2 * i0 + 1], __EXP2CR_T0[2 * i0], __EXP2CR_T1[2 * i1 + 1], __EXP2CR_T1[2 * i1])
    dx: n - Float{0.00007349365125719487} * t
    dxl0: Float{-2.795678930181113e-14} * t
    dxll: Float{-6.5950754538526695e-31} * t + fma(Float{-2.795678930181113e-14}, t, -dxl0)
    dxh: dx + dxl0
    dxl: ((dx - dxh) + dxl0) + dxll
    f0: __exp10_cr_opolydd(dxh, dxl, __EXP10CR_C, 6)
    f1: __exp_cr_muldd(dxh, dxl, f0.hi, f0.lo)
    fh := f1.hi
    fl := f1.lo
    bits: __to_bits_i64(n)
    if bits >= 0 || bits.bit_and(0x7FFF_FFFF_FFFF_FFFF) < 0x4073_3A71_46F7_2A42 {
        if jt.bit_and(0xFFF) == 0 {
            // th + tl is 1
            a: __fast_two_sum(fh, fl)
            b: __fast_two_sum(tt.hi, a.hi)
            c: __fast_two_sum(b.lo, a.lo)
            hb := __to_bits_i64(c.hi)
            if hb.bit_and(0x000F_FFFF_FFFF_FFFF) == 0 {
                // c.hi a power of 2: moved half its exponent's unit toward c.lo
                hb = if (hb < 0) == (__to_bits_i64(c.lo) < 0) -> hb + 0x0008_0000_0000_0000 else -> hb - 0x0008_0000_0000_0001
            }
            fh = b.hi + __from_bits_i64(hb)
        } else {
            p: __exp_cr_muldd(fh, fl, tt.hi, tt.lo)
            s: __fast_two_sum(tt.hi, p.hi)
            r: __fast_two_sum(s.hi, (tt.lo + p.lo) + s.lo)
            fh = r.hi
            lb: __to_bits_i64(r.lo)
            // a low part near 0, half or one unit of fh, or tiny
            if (lb + 4).bit_and(0x000F_FFFF_FFFF_FFFF) <= 4 || (lb >> 52).bit_and(0x7FF) < 918 {
                fh = __exp_cr_listed(n, fh, __EXP10CR_HARD, 0x0003_781B_19E1_7EB3_7EF5_AC3F_E7C6, 371470981966157, Float{5.551115123125783e-17})
            }
        }
        return __exp_cr_scale(fh, ie)
    }
    p: __exp_cr_muldd(fh, fl, tt.hi, tt.lo)
    s: __fast_two_sum(tt.hi, p.hi)
    sl: (tt.lo + p.lo) + s.lo
    u: __fast_two_sum(__from_bits_i64((1 - ie) << 52), s.hi)
    __exp_cr_subnormal(u.hi + (sl + u.lo))
}
// The n (hi, lo) coefficients of c at xh + xl, Horner in double-double.
__exp10_cr_opolydd: fn(xh: Float, xl: Float, c: [Float], n: Int) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    ch := c[2 * i]
    cl := c[2 * i + 1]
    loop i > 0 {
        i = i - 1
        p: __exp_cr_muldd(xh, xl, ch, cl)
        th: p.hi + c[2 * i]
        tl: (c[2 * i] - th) + p.hi
        ch = th
        cl = p.lo + (tl + c[2 * i + 1])
    }
    (hi: ch, lo: cl)
}
