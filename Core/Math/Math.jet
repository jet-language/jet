/// asin(x) / pi, correctly rounded (C23 asinpi; CORE-MATH asinpi.c): in
/// [-1/2, 1/2] with the sign of x, and NaN for |x| > 1.
asin_pi: fn(n: Float) -> Float Never! {
    u: to_bits(n).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    e := (u >> 52).bit_and(0x7FF) - 0x3FF
    // |x| = 2^(e + 1) * sm / 2^64 with 2^63 <= sm < 2^64
    sm: (u << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
    fi := 0
    if e >= 0 {
        m: (u << 12).bit_and(0xFFFF_FFFF_FFFF_FFFF)
        if e == 0 && m == 0 -> return n * Float{0.5}
        if e == 0x400 && m != 0 -> return n + n
        return from_bits(0x7FF8_0000_0000_0000)
    }
    if e < -6 {
        if e < -53 -> return __asin_pi_tiny(n)
        if e < -26 -> return __asin_pi_small(n)
        // asin(y) - y for y = |x| / 2^(e + 1), rounded toward zero in integers
        v2: __muuh(sm, sm) >> (-2 * e - 14)
        v3: __muuh(sm, __muuh(sm, sm))
        b: __ASINPI_B
