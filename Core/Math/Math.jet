__erf_fast: fn(z: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    if (z < Float{0.0625}) {
        // erf0.sollya's odd degree-11 polynomial, degree 1 and 3 as (hi, lo)
        z2h: z * z
        z2l: fma(z, z, -z2h)
        z4: z2h * z2h
        c9: fma(Float{-0.0008537735898387047}, z2h, Float{0.005223974478269176})
        c5: fma(c9, z4, fma(Float{-0.02686617064150544}, z2h, Float{0.11283791670954989}))
        t3: z2h * c5
        s3: __fast_two_sum(Float{-0.37612638903183754}, t3)
        l3: s3.lo + (fma(z2h, c5, -t3) + Float{1.3488819958138915e-17})
        t1: z2h * s3.hi
        tl1: fma(z2h, s3.hi, -t1) + fma(z2h, l3, Float{1.5335458324517626e-17})
        s1: __fast_two_sum(Float{1.1283791670955126}, t1)
        l1: s1.lo + fma(z2l, s3.hi, tl1)
        h: s1.hi * z
        return (hi: h, lo: fma(l1, z, fma(s1.hi, z, -h)), err: Float{2.4881592825595072e-21})
    }
    // i/16 <= z < (i + 1)/16, and z - 1/32 - v/16 is exact
    v: floor(Float{16.0} * z)
    b: 13 * ((Int.from_float(v) ?? 1) - 1)
    x: (z - Float{0.03125}) - Float{0.0625} * v
    x2: x * x
    x4: x2 * x2
    c9: fma(__ERF_C[b + 12], x, __ERF_C[b + 11])
    c7: fma(c9, x2, fma(__ERF_C[b + 10], x, __ERF_C[b + 9]))
    c5: fma(__ERF_C[b + 8], x, __ERF_C[b + 7])
    a3: __fast_two_sum(__ERF_C[b + 5], x * __ERF_C[b + 6])
    b3: __fast_two_sum(a3.hi, c5 * x2)
    c3: __fast_two_sum(b3.hi, c7 * x4)
    c3l: (a3.lo + b3.lo) + c3.lo
    t2: x * c3.hi
    s2: __fast_two_sum(__ERF_C[b + 4], t2)
    c2l: s2.lo + fma(x, c3l, fma(x, c3.hi, -t2))
    t1: x * s2.hi
    s1: __fast_two_sum(__ERF_C[b + 2], t1)
    l1: s1.lo + (fma(x, s2.hi, -t1) + fma(x, c2l, __ERF_C[b + 3]))
    t0: x * s1.hi
    tl0: fma(x, l1, fma(x, s1.hi, -t0))
    s0: __fast_two_sum(__ERF_C[b], t0)
    (hi: s0.hi, lo: s0.lo + (tl0 + __ERF_C[b + 1]), err: Float{1.8065624578158124e-21})
}
// erf.c cr_erf_accurate: erf(z) as a double-double within about 2^-106
// relatively, for 2^-61 <= z <= 5.9215871957945065.
__erf_accurate: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    if (z < Float{0.125}) -> return __erf_accurate_tiny(z)
    v: floor(Float{8.0} * z)
    b: 27 * ((Int.from_float(v) ?? 1) - 1)
    x: (z - Float{0.0625}) - Float{0.125} * v
    h := __ERF_C2[b + 26]
    j := 17
    loop j > 10 {
        h = fma(h, x, __ERF_C2[b + 8 + j])
        j = j - 1
    }
    l := Float{0.0}
    loop j >= 0 {
        t: __s_mul(x, h, l)
        // two_sum: a small coefficient may follow a larger one
        if j > 7 {
            s: __two_sum(__ERF_C2[b + 8 + j], t.hi)
            h = s.hi
            l = s.lo + t.lo
        } else {
            s: __two_sum(__ERF_C2[b + 2 * j], t.hi)
            h = s.hi
            l = s.lo + (__ERF_C2[b + 2 * j + 1] + t.lo)
        }
        j = j - 1
    }
    (hi: h, lo: l)
}
// erf.c cr_erf_accurate_tiny: erf(z) as a double-double, for 2^-61 <= z <
// 1/8.
__erf_accurate_tiny: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    z2: z * z
    h := __ERF_TINY_P[14]
    k := 13
    loop k >= 10 {
        h = fma(h, z2, __ERF_TINY_P[k])
        k = k - 1
    }
    l := Float{0.0}
    // (h + l) z^2, then the next coefficient: degree 11 and 9 as Floats,
    // degree 7 to 1 as (hi, lo)
    loop k >= 0 {
        t: __s_mul(z, h, l)
        m: __s_mul(z, t.hi, t.lo)
        if k >= 8 {
            s: __fast_two_sum(__ERF_TINY_P[k], m.hi)
            h = s.hi
            l = m.lo + s.lo
            k = k - 1
        } else {
            s: __fast_two_sum(__ERF_TINY_P[k - 1], m.hi)
            h = s.hi
            l = m.lo + (__ERF_TINY_P[k] + s.lo)
            k = k - 2
        }
    }
    __s_mul(z, h, l)
}
