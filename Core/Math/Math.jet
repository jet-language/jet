            fi = __u128(fi - (cmv >> 7))
        } else {
            v: __wrap_i128(__mul_hi64_128(sm >> -se, __asin_pi_acc_s(indx - 1)) - (__mul_hi128(cmv, __asin_pi_acc_s(63 - indx)) >> -ce))
            vu: __u128(v)
            v2 := __sqr_hi128(vu)
            if v < 0 -> v2 = __u128(v2 - (v + v))
            p: __asin_pi_poly(__u128(v2 << 14))
            w := __mul_hi128(p, vu)
            if v < 0 -> w = w - p
            fi = __u128(fi + v + w)
