// e^(xh + xl) within 2^-74.139 relatively, for |xl/xh| < 2^-23.89 and |xl| <
// 2^-14.3486: x = k log(2)/4096 + y, then 2^(k/4096) e^y.
__exp_dd_fast: fn(xh: Float, xl: Float) -> (hi: Float, lo: Float) Never! {
    k: round_even(xh * Float{5909.278887481194})
    kp: __s_mul(k, Float{0.0001692253858788929}, Float{5.661735385366942e-21})
    y: __fast_two_sum(xh - kp.hi, xl)
    __exp_dd_tail(k, __exp_q1(y.hi, y.lo - kp.lo))
}
// 2^(k/4096) (qh + ql) for whole k with 2^(k/4096) a normal Float: 2^(k/4096)
// from __EXP_T1 and __EXP_T2, the power of two exactly.
__exp_dd_tail: fn(k: Float, q: (hi: Float, lo: Float)) -> (hi: Float, lo: Float) Never! {
    kk: Int.from_float(k) ?? 0
    m: (kk >> 12) + 0x3FF
    i2: (kk >> 6).bit_and(0x3F)
    i1: kk.bit_and(0x3F)
    t: __d_mul(__EXP_T2[2 * i1], __EXP_T2[2 * i1 + 1], __EXP_T1[2 * i2], __EXP_T1[2 * i2 + 1])
    r: __d_mul(t.hi, t.lo, q.hi, q.lo)
    if m == 0x7FF {
        // 2^1024 is no Float: scale by 2 and 2^1023
        s: from_bits(0x7FE0_0000_0000_0000)
        return (hi: r.hi * Float{2.0} * s, lo: r.lo * Float{2.0} * s)
    }
    s: from_bits(m << 52)
    (hi: r.hi * s, lo: r.lo * s)
}
// e^(zh + zl) within 2^-74.346 absolutely for |z| < 0.000130273 and |zl| <
// 2^-42.6: a degree-4 polynomial.
__exp_q1: fn(zh: Float, zl: Float) -> (hi: Float, lo: Float) Never! {
    z: zh + zl
    q: fma(fma(Float{0.0416666666881331}, zh, Float{0.16666666679041395}), z, Float{0.5})
    a: __fast_two_sum(Float{1.0}, q * z)
    b: __d_mul(zh, zl, a.hi, a.lo)
    c: __fast_two_sum(Float{1.0}, b.hi)
    (hi: c.hi, lo: b.lo + c.lo)
}
// e^(zh + zl) within 2^-113.218 absolutely for |z| < 0.000130273 and |zl| <
// 2^-42.6: a degree-7 polynomial, double-double from degree 3 down.
__exp_q2: fn(zh: Float, zl: Float) -> (hi: Float, lo: Float) Never! {
    z: zh + zl
    q := fma(Float{0.000198412702925094}, zh, Float{0.0013888890379584226})
    q = fma(q, z, Float{0.008333333333333333})
    q = fma(q, z, Float{0.041666666666666664})
    h: q * z
    a: __fast_two_sum(Float{0.16666666666666666}, h)
    b: __d_mul(a.hi, fma(q, z, -h) + (a.lo + Float{9.251858539246562e-18}), zh, zl)
    c: __fast_two_sum(Float{0.5}, b.hi)
    d: __d_mul(c.hi, b.lo + c.lo, zh, zl)
    e: __fast_two_sum(Float{1.0}, d.hi)
    f: __d_mul(e.hi, d.lo + e.lo, zh, zl)
    g: __fast_two_sum(Float{1.0}, f.hi)
    (hi: g.hi, lo: f.lo + g.lo)
}
// (h + l) - 1 for h + l = b^x, with the larger operand first.
__dd_minus_one: fn(x: Float, h: Float, l: Float) -> (hi: Float, lo: Float) Never! {
    if (x >= Float{0.0}) {
        u: __fast_two_sum(h, Float{-1.0})
        return (hi: u.hi, lo: l + u.lo)
    }
    u: __fast_two_sum(Float{-1.0}, h)
    (hi: u.hi, lo: l + u.lo)
}
// exp2_m1's fast path: (hi, lo) within err. Up to |x| = 1/8 a degree-10
// polynomial, double-double from degree 3 down; beyond, e^(x log(2)) - 1.
__exp2_m1_fast: fn(x: Float, tiny: Bool) -> (hi: Float, lo: Float, err: Float) Never! {
    if tiny {
        p: __EXP2M1_FAST
        x2: x * x
        c8: fma(p[12], x2, fma(p[11], x, p[10]))
        c4: fma(c8, x2 * x2, fma(fma(p[9], x, p[8]), x2, fma(p[7], x, p[6])))
        r: __horner_dd_x(x, c4, Float{0.0}, p, 3)
        return (hi: r.hi, lo: r.lo, err: Float{1.768181277393352e-20} * r.hi)
    }
    s: __s_mul(x, Float{0.6931471805599453}, Float{2.3190468138462996e-17})
    e: __exp_dd_fast(s.hi, s.lo)
    d: __dd_minus_one(x, e.hi, e.lo)
    (hi: d.hi, lo: d.lo, err: Float{5.327043144841498e-22} * d.hi)
}
// exp2_m1 for 4.530329207760484e-16 < |x| <= 1/8 when the fast path cannot
// round: a degree-15 polynomial, double-double from degree 8 down.
__exp2_m1_accurate_tiny: fn(x: Float) -> Float Never! {
    r: __hard_case(__EXP2M1_TINY_HARD, x)
    if !is_nan(r) -> return r
    q: __EXP2M1_ACCURATE
    x2: x * x
    c13: fma(q[22], x2, fma(q[21], x, q[20]))
    c11: fma(q[19], x, q[18])
    s: __fast_two_sum(q[16], q[17] * x + c11 * x2 + c13 * (x2 * x2))
    p: __horner_dd_x(x, s.hi, s.lo, q, 8)
    p.hi + p.lo
}
// exp10_m1's fast path: (hi, lo) within err. Up to |x| = 1/16 a degree-11
// polynomial, double-double from degree 4 down; beyond, e^(x log(10)) - 1.
__exp10_m1_fast: fn(x: Float, tiny: Bool) -> (hi: Float, lo: Float, err: Float) Never! {
    if tiny {
        p: __EXP10M1_FAST
        x2: x * x
        c9: fma(p[14], x2, fma(p[13], x, p[12]))
        c5: fma(c9, x2 * x2, fma(fma(p[11], x, p[10]), x2, fma(p[9], x, p[8])))
        r: __horner_dd_x(x, c5, Float{0.0}, p, 4)
        return (hi: r.hi, lo: r.lo, err: Float{3.520480687025686e-21} * r.hi)
    }
    s: __s_mul(x, Float{2.302585092994046}, Float{-2.1707562233822494e-16})
    e: __exp_dd_fast(s.hi, s.lo)
    d: __dd_minus_one(x, e.hi, e.lo)
    (hi: d.hi, lo: d.lo, err: Float{3.1267427154504446e-22} * d.hi)
}
// exp10_m1 for 2^-54 < |x| <= 1/16 when the fast path cannot round: a
// degree-17 polynomial, double-double from degree 10 down.
__exp10_m1_accurate_tiny: fn(x: Float) -> Float Never! {
    r: __hard_case(__EXP10M1_TINY_HARD, x)
    if !is_nan(r) -> return r
    q: __EXP10M1_ACCURATE
    x2: x * x
    c15: fma(q[26], x2, fma(q[25], x, q[24]))
    c13: fma(q[23], x, q[22])
    s: __fast_two_sum(q[20], q[21] * x + c13 * x2 + c15 * (x2 * x2))
    p: __horner_dd_x(x, s.hi, s.lo, q, 10)
    p.hi + p.lo
}
