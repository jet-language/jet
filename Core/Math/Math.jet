        ss: 63 + 2 * e
        fi = __asin_pi_div_pi((((d >> (64 - ss)) + (sm >> 1)) << 64) + (d << ss).bit_and(0xFFFF_FFFF_FFFF_FFFF))
        // fi / 2^127 is asinpi(|x|) within 15 / 2^127 below
        nz: __clz64(fi >> 64) + 1
        up: __u128(fi + (15 << ss))
        if ((fi >> 64).bit_xor(up >> 64) >> (11 - nz)).bit_and(1) != 0 -> return __asin_pi_acc(n)
        e = e + 0x3FF
    } else {
        xx: fma(n, -n, Float{1.0})
        c: sqrt(xx)
        ixx: (Float{1.0} / xx) * c
        ax: fabs(n)
        x2: n * n
        // c0 roughly 64 + 64 acos(|x|) / (pi / 2); indx is round(c0) - 64
        c0 := Float{63.96459584605448} + ax * Float{-39.39065080729959}
        c2: Float{23.579467473196825} + ax * Float{-7.445150988059025}
        c0 = c0 + x2 * c2
        c0 = c0 * c
        c0 = c0 + Float{64.0}
        indx: (to_bits(c0).bit_and(0xF_FFFF_FFFF_FFFF) + 0x2000_0000_0000) >> 46
        cu: to_bits(c)
        cm: (cu << 11).bit_and(0xFFFF_FFFF_FFFF_FFFF).bit_or(0x8000_0000_0000_0000)
        ce: (cu >> 52) - 0x3FF
        // one Newton step for sqrt(1 - x^2), from frac(2^50 (x^2 + c^2))
        sm2: __u128((sm * sm) << (52 + 2 * e))
        sc := 52 + 2 * ce
        cm2: if sc >= 0 -> __u128((cm * cm) << sc) else -> (cm * cm) >> -sc
        h: __wrap_i64(__u128(sm2 + cm2) >> 64)
        iu: to_bits(ixx)
        ixm: iu.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
        ixe: (iu >> 52) - 0x3FF
        // (|x| - sin(y_i)) cos(y_i) - (sqrt(1 - x^2) - cos(y_i)) sin(y_i), y_i = (64 - indx) pi / 128
        smh: __wrap_i64((sm << (6 + e)) - __ASINPI_SH[64 - indx])
        sc = 6 + ce
        cmh0: if sc >= 0 -> __wrap_i64(cm << sc) else -> cm >> -sc
        cmh: __wrap_i64(__wrap_i64(cmh0 - __ASINPI_SH[indx]) - (__mh(h, ixm) >> (34 - ixe)))
        v := __wrap_i64(__mh(smh, __ASINPI_S[indx]) - __mh(cmh, __ASINPI_S[64 - indx]))
        v2: __mh(v, v)
        v3: __mh(v2, v)
        a: __ASINPI_A
        v = __wrap_i64(v + __mh(v3, a[0] + __muuh(v2, a[1] + __muuh(v2, a[2] + __muuh(v2, a[3])))))
        // y_i as (64 - indx) (pi / 2 / 64) in 2^127 units, plus v
        f0: __u128((0x0324_3F6A_8885_A308_D313_198A_2E03_7073 * (64 - indx)))
        vh: (v >> 5).bit_and(0xFFFF_FFFF_FFFF_FFFF)
        vl: (v << 59).bit_and(0xFFFF_FFFF_FFFF_FFFF)
        fi = __asin_pi_div_pi(__u128(f0 + ((vh << 64) + vl)))
        // fi / 2^127 is asinpi(|x|) within 124 * 2^55 / 2^127 either way
        nz: __clz64(fi >> 64) + 1
        up: __u128(fi + (124 << 55))
        dn: __u128(fi - (124 << 55))
        if ((dn >> 64).bit_xor(up >> 64) >> (11 - nz)).bit_and(1) != 0 -> return __asin_pi_acc(n)
        e = 0x3FE
    }
    __asin_pi_round(fi, e, u.bit_and(0x8000_0000_0000_0000))
}
/// acos(x) / pi, correctly rounded (C23 acospi; CORE-MATH acospi.c): in
/// [0, 1], and NaN for |x| > 1.
acos_pi: fn(n: Float) -> Float Never! {
    ab: to_bits(n).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    k: ab >> 32
    ax: from_bits(ab)
    pih: Float{3.141592653589793}
    pil: Float{1.2246467991473532e-16}
    du := Float{0.0}
    dv := Float{0.0}
    i := 0
    if k < 0x3FE8_0000 {
        // |x| < 0.75: acos(x) from a degree-6 polynomial at the piece's point
        if k < 0x3C99_21FB -> return fma(Float{-2.7755575615628914e-17}, n, Float{0.5})
        i = (to_bits(Float{1.0} + ax) >> 44).bit_and(255)
        if i == 192 -> i = 191
        b: 8 * i
        y: ax - __ACOSPI_T[b + 7]
        yy: y * y
        p56: fma(__ACOSPI_T[b + 6], y, __ACOSPI_T[b + 5])
        p34: fma(__ACOSPI_T[b + 4], y, __ACOSPI_T[b + 3])
        zh := fma(p56, yy, p34)
        zh = fma(zh, y, __ACOSPI_T[b + 2])
        z: __fast_two_sum(__ACOSPI_T[b + 1], y * zh)
        d: __fast_two_sum(__ACOSPI_T[b], z.hi * y)
        du = d.hi
        dv = fma(z.lo, y, d.lo)
        // the first piece's point is 0, so its constant term carries this
        if i == 0 -> dv = dv + Float{6.123241268232362e-17}
        if (n < Float{0.0}) {
            t: __fast_two_sum(pih, -du)
            du = t.hi
            dv = (pil + t.lo) - dv
        }
    } else if k < 0x3FF0_0000 {
        // 0.75 <= |x| < 1: acos(x) = sqrt(1 - |x|) times a degree-5 polynomial
        v: Float{1.0} + ax
        i = if (v == Float{2.0}) -> 255 else -> (to_bits(v) >> 44).bit_and(255)
        b: 8 * i
        y: ax - __ACOSPI_T[b + 6]
        s: __sqrt_dd(Float{1.0} - ax)
        yy: y * y
        p45: fma(__ACOSPI_T[b + 5], y, __ACOSPI_T[b + 4])
        p23: fma(__ACOSPI_T[b + 3], y, __ACOSPI_T[b + 2])
        zh := fma(p45, yy, p23)
        zh = fma(zh, y, __ACOSPI_T[b + 1])
        z: __fast_two_sum(__ACOSPI_T[b], zh * y)
        l1zh: s.lo * z.hi
        h1zl: s.hi * z.lo
        du = s.hi * z.hi
        dv = fma(s.hi, z.hi, -du) + (l1zh + h1zl)
        if (n < Float{0.0}) {
            t: __fast_two_sum(pih, -du)
            du = t.hi
            dv = (t.lo + pil) - dv
        }
    } else {
        if ab == 0x3FF0_0000_0000_0000 {
            if (n > Float{0.0}) -> return Float{0.0}
            return Float{1.0}
        }
        if ab > 0x7FF0_0000_0000_0000 -> return n + n
        return from_bits(0x7FF8_0000_0000_0000)
    }
    p: __acos_pi_div_pi(du, dv)
    err: __ACOSPI_ERR[i]
    left: p.hi + (p.lo - err)
    if left != p.hi + (p.lo + err) -> return __acos_pi_accurate(n)
    left
}
/// atan2(a, b) / pi, correctly rounded (C23 atan2pi; CORE-MATH atan2pi.c):
/// the angle of the point (b, a) in half-turns, in [-1, 1] with the sign of
/// a; the C23 values at zeros and infinities, and NaN when a or b is NaN.
atan2_pi: fn(a: Float, b: Float) -> Float Never! {
    ua: to_bits(a)
    ub: to_bits(b)
    aa: ua.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    ab: ub.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    ea: aa >> 52
    eb: ab >> 52
    if ea == 0x7FF || eb == 0x7FF {
        if is_nan(a) || is_nan(b) -> return __nan_pair(a, b)
        if aa == 0x7FF0_0000_0000_0000 && ab == 0x7FF0_0000_0000_0000 {
            if (b < Float{0.0}) {
                if (a > Float{0.0}) -> return Float{0.75}
                return Float{-0.75}
            }
            if (a > Float{0.0}) -> return Float{0.25}
            return Float{-0.25}
        }
        if ab == 0x7FF0_0000_0000_0000 {
            if (b < Float{0.0}) {
                if ua < 0 -> return Float{-1.0}
                return Float{1.0}
            }
            return copysign(Float{0.0}, a)
        }
        if (a > Float{0.0}) -> return Float{0.5}
        return Float{-0.5}
    }
    if aa == 0 || ab == 0 {
        if ab != 0 && (b > Float{0.0}) -> return a
        if aa == 0 {
            if ub == 0 -> return a
            if ua == 0 -> return Float{1.0}
            return Float{-1.0}
        }
        if (a > Float{0.0}) -> return Float{0.5}
        return Float{-0.5}
    }
    // the fast path keeps its products clear of underflow and overflow
    if 54 <= eb && eb <= 2044 && 54 <= ea && ea <= 2044 && -341 <= ea - eb && ea - eb <= 341 {
        f: __atan2_pi_fast(a, b)
        left: f.hi + fma(f.hi, -f.err, f.lo)
        if left == f.hi + fma(f.hi, f.err, f.lo) -> return left
    }
    __atan2_pi_accurate(a, b)
}
// Double-double helpers of the CORE-MATH ports: a value is hi + lo, and every
// fma recovers the exact rounding error of a product.
__fast_two_sum: fn(x: Float, y: Float) -> (hi: Float, lo: Float) Never! {
    s: x + y
    (hi: s, lo: y - (s - x))
}
__fast_two_sub: fn(x: Float, y: Float) -> (hi: Float, lo: Float) Never! {
    s: x - y
    (hi: s, lo: (x - s) - y)
}
__fast_sum_ddd: fn(xh: Float, xl: Float, c: Float) -> (hi: Float, lo: Float) Never! {
    t: __fast_two_sum(xh, c)
    (hi: t.hi, lo: xl + t.lo)
}
__add_dd: fn(xh: Float, xl: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    s: xh + ch
    d: s - xh
    (hi: s, lo: ((ch - d) + (xh + (d - s))) + (xl + cl))
}
__mul_dd: fn(xh: Float, xl: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    ahlh: ch * xl
    alhh: cl * xh
    ahhh: ch * xh
    __fast_two_sum(ahhh, fma(ch, xh, -ahhh) + (alhh + ahlh))
}
__mul_dd_d: fn(xh: Float, xl: Float, c: Float) -> (hi: Float, lo: Float) Never! {
    ahhh: c * xh
    ahhl: fma(c, xh, -ahhh) + c * xl
    h: ahhh + ahhl
    (hi: h, lo: (ahhh - h) + ahhl)
}
// The double-double polynomial c[0] + x * (c[1] + ...) of n pairs (hi, lo)
// of `c`, with `l` added to the last coefficient.
__poly_dd: fn(xh: Float, xl: Float, c: [Float], n: Int, l: Float) -> (hi: Float, lo: Float) Never! {
    i := n - 1
    ch := c[2 * i] + l
    cl := ((c[2 * i] - ch) + l) + c[2 * i + 1]
    loop i > 0 {
        i = i - 1
        p: __mul_dd(xh, xl, ch, cl)
        th: p.hi + c[2 * i]
        tl: (c[2 * i] - th) + p.hi
        ch = th
        cl = p.lo + (tl + c[2 * i + 1])
    }
    (hi: ch, lo: cl)
}
// a (bh + bl), the low product's rounding folded into lo.
__s_mul: fn(a: Float, bh: Float, bl: Float) -> (hi: Float, lo: Float) Never! {
    h: a * bh
    (hi: h, lo: fma(a, bl, fma(a, bh, -h)))
}
// (ah + al) (bh + bl) less al bl.
__d_mul: fn(ah: Float, al: Float, bh: Float, bl: Float) -> (hi: Float, lo: Float) Never! {
    h: ah * bh
    (hi: h, lo: fma(al, bh, fma(ah, bl, fma(ah, bh, -h))))
}
// x (c0 + x (c1 + ... x (c(n-1) + x (h + l)))), each ci the double-double
// c[2i] + c[2i + 1]: one s_mul and fast two-sum per step.
__horner_dd_x: fn(x: Float, h0: Float, l0: Float, c: [Float], n: Int) -> (hi: Float, lo: Float) Never! {
    h := h0
    l := l0
    i := n
    loop i > 0 {
        i = i - 1
        p: __s_mul(x, h, l)
        s: c[2 * i] + p.hi
        l = p.lo + ((p.hi - (s - c[2 * i])) + c[2 * i + 1])
        h = s
    }
    __s_mul(x, h, l)
}
// c x for 0 < |x| <= 2^-104 and c = ch + cl: the product is taken at x 2^106,
// so the double-double keeps its low part, and scaled back with one rounding.
__mul_dd_tiny: fn(x: Float, ch: Float, cl: Float) -> Float Never! {
    p: __s_mul(x * Float{8.112963841460668e31}, ch, cl)
    h2: (p.hi + p.lo) * Float{1.232595164407831e-32}
    fma(fma(-h2, Float{8.112963841460668e31}, p.hi) + p.lo, Float{1.232595164407831e-32}, h2)
}
// From t's rows (x, result, correction) sorted by x, result + correction for
// the row of x, or NaN when x has none: the hard cases of a CORE-MATH port.
__hard_case: fn(t: [Float], x: Float) -> Float Never! {
    a := 0
    b := t.len() /% 3
    loop a + 1 != b {
        c: (a + b) >> 1
        if t[3 * c] <= x {
            a = c
        } else {
            b = c
        }
    }
    if x == t[3 * a] -> return t[3 * a + 1] + t[3 * a + 2]
    NAN
}
// y1 with a zero fraction would let y0 + y1 tie: step it one ulp toward y2
// so the sum rounds as the exact y0 + y1 + y2 does.
__sticky_step: fn(y1: Float, y2: Float) -> Float Never! {
    b: to_bits(y1)
    if b.bit_and(0xF_FFFF_FFFF_FFFF) != 0 -> return y1
    if (to_bits(y2) < 0) != (b < 0) -> return from_bits(__wrap_i64(b - 1))
    from_bits(__wrap_i64(b + 1))
}
// The 64-bit two's complement word of v, as C's int64_t cast of a uint64_t.
__wrap_i64: fn(v: Int) -> Int Never! {
    w: v.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    if w > 0x7FFF_FFFF_FFFF_FFFF -> return w - 0xFFFF_FFFF_FFFF_FFFF - 1
    w
}
// sin_pi, cos_pi and tan_pi of an infinity are NaN; a NaN stays NaN.
__pi_trig_special: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return n + n
    from_bits(0x7FF8_0000_0000_0000)
}
// sin(pi * x) for 0 < |x| <= 0x1.2p-5.
__sin_pi_small: fn(x: Float) -> Float Never! {
    ph: Float{3.141592653589793}
    pl: Float{1.2246467991473532e-16}
    if (fabs(x) < Float{5.551115123125783e-17}) {
        if (fabs(x) < Float{1.0261342003245941e-289}) {
            // scaled up by 2^106 so a subnormal result rounds once
            t: x * Float{8.112963841460668e31}
            zh: ph * t
            zl: fma(ph, t, -zh) + pl * t
            rs: (zh + zl) * Float{1.232595164407831e-32}
            rt: rs * Float{8.112963841460668e31}
            return fma((zh - rt) + zl, Float{1.232595164407831e-32}, rs)
        }
        zh: ph * x
        return zh + (fma(ph, x, -zh) + pl * x)
    }
    zh: ph * x
    x2: x * x
    x4: x2 * x2
    eps: x * (x2 * Float{7.105427357601002e-15} + Float{1.9721522630525295e-31})
    zl: fma(ph, x, -zh) + pl * x + x2 * x * ((Float{-5.1677127800499685} + x2 * Float{2.550164039866476}) + x4 * (Float{-0.5992645046958942} + x2 * Float{0.08212311566377814}))
    lb: (zl - eps) + zh
    ub: (zl + eps) + zh
    if lb == ub -> return lb
    __sin_pi_zero(x)
}
// sin(pi * x) for 0 < |x| <= 0x1.2p-5 in double-double, for the cases the
// fast path cannot round.
__sin_pi_zero: fn(x: Float) -> Float Never! {
    x2: x * x
    dx2: fma(x, x, -x2)
    x3: x2 * x
    dx3: fma(x2, x, -x3) + dx2 * x
    f: __poly_dd(x2, dx2, __SINPI_ZERO_C, 4, x2 * (Float{-0.007370430945706094} + x2 * (Float{0.0004663027978725982} + x2 * Float{-0.0000219114224108643})))
    p: __mul_dd(f.hi, f.lo, x3, dx3)
    // pi = pi0 + pi1 + pi2 with pi0 short, so pi0 * x rounds to y0 + y0l
    pi0: Float{3.140625}
    y: pi0 * x
    b: from_bits(to_bits(y).bit_and(0xF_FFFF_FFFF_FFFF) + (85 << 51))
    y0: (y + b) - b
    y0l: fma(pi0, x, -y0)
    y1: Float{0.0009676535897932385} * x
    y2: fma(Float{0.0009676535897932385}, x, -y1) + Float{-5.016557612668332e-20} * x
    s1: __add_dd(y1, y2, y0l, 0.0)
    s2: __add_dd(s1.hi, s1.lo, p.hi, p.lo)
    t0: __fast_two_sum(y0, s2.hi)
    t1: __fast_two_sum(t0.lo, s2.lo)
    t0.hi + __sticky_step(t1.hi, t1.lo)
}
// cos(pi * x) for 0 < |x| <= 2^-12.
__cos_pi_small: fn(x: Float, ax: Int) -> Float Never! {
    if ax <= 0x3E2C_CF64_29BE_6621 -> return Float{1.0} - Float{2.7755575615628914e-17}
    x2: x * x
    x4: x2 * x2
    eps: x2 * Float{5.773159728050814e-15}
    p: x2 * ((Float{-4.934802200544677} + x2 * Float{4.058712126397995}) + x4 * (Float{-1.3352627150260947} + x2 * Float{0.2352676329578543}))
    lb: (p - eps) + Float{1.0}
    ub: (p + eps) + Float{1.0}
    if lb == ub -> return lb
    __cos_pi_zero(x)
}
// cos(pi * x) for 0 < |x| <= 2^-12 in double-double, for the cases the fast
// path cannot round.
__cos_pi_zero: fn(x: Float) -> Float Never! {
    x2: x * x
    dx2: fma(x, x, -x2)
    f: __poly_dd(x2, dx2, __COSPI_ZERO_C, 2, x2 * (Float{-1.3352627688545893} + x2 * Float{0.23533062651336675}))
    p: __mul_dd(x2, dx2, f.hi, f.lo)
    y: __fast_two_sum(Float{1.0}, p.hi)
    z: __fast_two_sum(y.lo, p.lo)
    y.hi + __sticky_step(z.hi, z.lo)
}
// The main path of sin_pi and cos_pi: x is iq/2048 of a half turn plus
// `below`, the bits of x under that grid point as a signed 64-bit word in
// units of 2^-63 of a 1/2048 step.
__pi_trig_reduced: fn(iq: Int, below: Int, hard_iq: [Int], hard: [Float]) -> Float Never! {
    z: approx(__wrap_i64(below))
    z2: z * z
    fs: Float{8.31572651388319e-23} + z2 * (Float{-9.584056014373668e-68} + z2 * Float{3.3137499508959674e-113})
    fc: Float{-3.4575653726849915e-45} + z2 * Float{1.9924596591260817e-90}
    t: __sincos_pi_coarse(iq)
    er: fabs(z) * Float{9.4039548065783e-38} + Float{3.308722450212111e-24}
    r: t.sl + t.sh * (z2 * fc) + t.ch * (z * fs)
    lb: (r - er) + t.sh
    ub: (r + er) + t.sh
    if lb == ub -> return lb
    __pi_trig_refine(iq, z, hard_iq, hard)
}
// The double-double evaluation behind __pi_trig_reduced; the few inputs
// it cannot round are tabulated as (iq, x, result, correction).
__pi_trig_refine: fn(iq: Int, z: Float, hard_iq: [Int], hard: [Float]) -> Float Never! {
    x: z * Float{1.0842021724855044e-19}
    x2: x * x
    dx2: fma(x, x, -x2)
    s0: __poly_dd(x2, dx2, __PI_REFINE_S, 3, Float{-1.268991980402342e-22} * x2)
    s: __mul_dd_d(s0.hi, s0.lo, x * Float{0.000244140625})
    c0: __poly_dd(x2, dx2, __PI_REFINE_C, 2, x2 * (Float{-2.827528896154601e-22} + Float{2.9702900969209974e-30} * x2))
    c: __mul_dd(c0.hi, c0.lo, x2, dx2)
    b: __sincos_pi_fine(iq)
    cs: __mul_dd(c.hi, c.lo, b.sh, b.sl)
    sc: __mul_dd(s.hi, s.lo, b.ch, b.cl)
    t: __fast_two_sum(sc.hi, cs.hi)
    u: __fast_two_sum(b.sh, t.hi)
    low: (b.sl + (t.lo + (cs.lo + sc.lo))) + u.lo
    tail: to_bits(low).bit_and(0xF_FFFF_FFFF_FFFF)
    if tail == 0xF_FFFF_FFFF_FFFF || tail == 0 {
        sign: if iq > 2048 -> Float{-1.0} else -> Float{1.0}
        q: iq.bit_and(0x7FF)
        i := 0
        loop i < hard_iq.len() {
            hx: hard[3 * i]
            if (x == hx && q == hard_iq[i]) || (x == -hx && q == 2048 - hard_iq[i]) -> return sign * hard[3 * i + 1] + sign * hard[3 * i + 2]
            i = i + 1
        }
    }
    u.hi + low
}
// sin and cos of iq/2048 of a half turn (iq mod 4096) as double-doubles,
// from a 32-step table and a 32-step fine table: about 2^-80 relative.
__sincos_pi_coarse: fn(iq: Int) -> (sh: Float, sl: Float, ch: Float, cl: Float) Never! {
    q: iq.bit_and(0xFFF)
    j: if q.bit_and(0x400) != 0 -> 1024 - q.bit_and(0x3FF) else -> q.bit_and(0x3FF)
    a: 2 * (j >> 5)
    b: 64 - a
    c: 2 * j.bit_and(31)
    sbh: __SINCOS_PI_SN[a]
    sbl: __SINCOS_PI_SN[a + 1]
    cbh: __SINCOS_PI_SN[b]
    cbl: __SINCOS_PI_SN[b + 1]
    slh: __SINCOS_PI_SM[c]
    sll: __SINCOS_PI_SM[c + 1]
    clh: __SINCOS_PI_CM[c]
    cll: __SINCOS_PI_CM[c + 1]
    sb: sbh + sbl
    cb: cbh + cbl
    ch: cbh * clh - sbh * slh
    cl: clh * cbl - slh * sbl + cb * cll - sb * sll
    sh: sbh * clh + cbh * slh
    sl: slh * cbl + clh * sbl + cb * sll + sb * cll
    tch: ch + cl
    tsh: sh + sl
    __sincos_pi_signed(q, tsh, (sh - tsh) + sl, tch, (ch - tch) + cl)
}
// __sincos_pi_coarse to about 2^-106 relative, for the refinement paths.
__sincos_pi_fine: fn(iq: Int) -> (sh: Float, sl: Float, ch: Float, cl: Float) Never! {
    q: iq.bit_and(0xFFF)
    j: if q.bit_and(0x400) != 0 -> 1024 - q.bit_and(0x3FF) else -> q.bit_and(0x3FF)
    a: 2 * (j >> 5)
    b: 64 - a
    c: 2 * j.bit_and(31)
    sbh: __SINCOS_PI_FINE_SN[a]
    sbl: __SINCOS_PI_FINE_SN[a + 1]
    cbh: __SINCOS_PI_FINE_SN[b]
    cbl: __SINCOS_PI_FINE_SN[b + 1]
    slh: __SINCOS_PI_FINE_SM[c]
    sll: __SINCOS_PI_FINE_SM[c + 1]
    clh: __SINCOS_PI_FINE_CM[c]
    cll: __SINCOS_PI_FINE_CM[c + 1]
    cc: __mul_dd(clh, cll, cbh, cbl)
    ss: __mul_dd(slh, sll, sbh, sbl)
    cs: __mul_dd(clh, cll, sbh, sbl)
    sc: __mul_dd(slh, sll, cbh, cbl)
    tc: __fast_two_sum(ss.hi, cc.hi)
    tcl: tc.lo + (cc.lo + ss.lo)
    ts: __fast_two_sum(-sc.hi, cs.hi)
    tsl: ts.lo + (cs.lo - sc.lo)
    c2: __fast_two_sum(cbh, -tc.hi)
    s2: __fast_two_sum(sbh, -ts.hi)
    __sincos_pi_signed(q, s2.hi, (sbl - tsl) + s2.lo, c2.hi, (cbl - tcl) + c2.lo)
}
// The quadrant signs of a first-quadrant sin and cos pair.
__sincos_pi_signed: fn(q: Int, sh: Float, sl: Float, ch: Float, cl: Float) -> (sh: Float, sl: Float, ch: Float, cl: Float) Never! {
    ss: if q.bit_and(0x800) != 0 -> Float{-1.0} else -> Float{1.0}
    cs: if (q + 1024).bit_and(0x800) != 0 -> Float{-1.0} else -> Float{1.0}
    (sh: ss * sh, sl: ss * sl, ch: cs * ch, cl: cs * cl)
}
// tan_pi where x is a multiple of 1/4: jq counts quarter turns.
__tan_pi_pole_or_zero: fn(jq: Int, sgn: Int) -> Float Never! {
    if jq.bit_and(1) != 0 {
        if jq.bit_and(2) != 0 -> return -INFINITY
        return INFINITY
    }
    if jq.bit_xor(sgn).bit_and(2) != 0 -> return Float{-0.0}
    Float{0.0}
}
// (n + t) / (1 - n * t) for the table's tan n of the grid point iq/64 and
// tan t of the rest, or -1/t at the grid's pole; `ms` < 0 flips n's sign.
__tan_pi_combine: fn(iq: Int, ms: Int, th: Float, tl: Float) -> (hi: Float, lo: Float) Never! {
    if iq == 32 {
        ith: Float{-1.0} / th
        return (hi: ith, lo: (fma(ith, th, Float{1.0}) + tl * ith) * ith)
    }
    sign: if ms < 0 -> Float{-1.0} else -> Float{1.0}
    nl0: __TANPI_T[2 * iq] * sign
    nh0: __TANPI_T[2 * iq + 1] * sign
    m: __mul_dd(th, tl, nh0, nl0)
    d: __fast_two_sub(Float{1.0}, m.hi)
    ml: d.lo - m.lo
    nn: __fast_two_sum(nh0, th)
    nl: nl0 + (nn.lo + tl)
    imh: Float{1.0} / d.hi
    hi: nn.hi * imh
    (hi: hi, lo: fma(nn.hi, imh, -hi) + (nl + nn.hi * (fma(-d.hi, imh, Float{1.0}) - ml * imh)) * imh)
}
// tan_pi's hard cases, keyed by |x| reduced into [0, 1/2]; `f` otherwise.
__tan_pi_hard: fn(x: Float, f: Float) -> Float Never! {
    bits: to_bits(x)
    aix: bits.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    ax := fabs(x)
    e: (aix >> 52) - 1022
    p := 0
    if e >= 0 {
        ax = ax - from_bits(aix.bit_and(0xFFFF_FFFF_FFFF_FFFF - (0xFFFF_FFFF_FFFF_FFFF >> (12 + e))))
        p = (aix.bit_or(0x10_0000_0000_0000) >> (52 - e)).bit_and(1)
        if p != 0 -> ax = Float{0.5} - ax
    }
    sign: if (p != 0) != (bits < 0) -> Float{-1.0} else -> Float{1.0}
    lo := 0
    hi := __TANPI_HARD.len() /% 3 - 1
    loop lo <= hi {
        mid: (lo + hi) /% 2
        v: __TANPI_HARD[3 * mid]
        if v == ax -> return sign * __TANPI_HARD[3 * mid + 1] + sign * __TANPI_HARD[3 * mid + 2]
        if v < ax {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    f
}
