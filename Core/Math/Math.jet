/// The complementary error function 1 - erf(x), correctly rounded (C23 erfc;
/// CORE-MATH erfc.c): 2 up to -5.863584748755168 and +0 from
/// 27.226017111108366.
erfc: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return n + n
    if (n < Float{0.0}) {
        if (n <= Float{-5.863584748755168}) -> return Float{2.0} - Float{5.551115123125783e-17}
        if (n >= Float{-9.83909537680414e-17}) -> return fma(-n, Float{5.551115123125783e-17}, Float{1.0})
    } else {
        // 2^-1074 / 4 rounds to +0
        if (n >= Float{27.226017111108366}) -> return Float{0.0}
        if (n <= Float{4.91954768840207e-17}) -> return fma(-n, Float{5.551115123125783e-17}, Float{1.0})
    }
    f: __erfc_fast(n)
    left: f.hi + (f.lo - f.err)
    if left == f.hi + (f.lo + f.err) -> return left
    r: __hard_case(__ERFC_HARD, n)
    if !is_nan(r) -> return r
    if (n < Float{0.0}) {
        e: __erf_accurate(-n)
        s: __fast_two_sum(Float{1.0}, e.hi)
        return s.hi + (s.lo + e.lo)
    }
    // erfc(x) >= 2^-6
    if (n <= Float{1.7094723742995113}) {
        e: __erf_accurate(n)
        s: __fast_two_sum(Float{1.0}, -e.hi)
        return s.hi + (s.lo - e.lo)
    }
    __erfc_asympt_accurate(n)
}
// erfc.c cr_erfc_fast: erfc(x) as hi + lo within err absolutely, for
// 4.91954768840207e-17 < |x| and -5.863584748755168 < x < 27.226017111108366.
__erfc_fast: fn(x: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    if (x < Float{0.0}) {
        e: __erf_fast(-x)
        s: __fast_two_sum(Float{1.0}, e.hi)
        return (hi: s.hi, lo: s.lo + e.lo, err: e.err * e.hi + Float{2.465190328815662e-31})
    }
    if (x <= Float{2.8845070422535213}) {
        e: __erf_fast(x)
        s: __fast_two_sum(Float{1.0}, -e.hi)
        err: e.err * e.hi
        // from 0.4769362762044699, 1 - h is exact
        return (hi: s.hi, lo: s.lo - e.lo, err: if (x >= Float{0.4769362762044699}) -> err else -> err + Float{6.162975822039155e-32})
    }
    // erfc(x) = e^(-x^2) p(1/x): from 25.85589130550742 the accurate path
    // takes it, away from underflow
    if (x >= Float{25.85589130550742}) -> return (hi: Float{0.0}, lo: Float{0.0}, err: Float{1.0})
    uh: x * x
    e: __exp_dd_fast(-uh, -fma(x, x, -uh))
    yh: Float{1.0} / x
    yl: yh * fma(-x, yh, Float{1.0})
    i := 0
    loop yh > __ERFC_ASYMPT_CUT[i] {
        i = i + 1
    }
    b: 13 * i
    vh: yh * yh
    vl: fma(Float{2.0} * yh, yl, fma(yh, yh, -vh))
    // p(y) = y (c1 + y^2 (c3 + ...)): c1 as (hi, lo), then c3 to c23
    p: __s_mul(fma(fma(__ERFC_ASYMPT[b + 12], vh, __ERFC_ASYMPT[b + 11]), vh, __ERFC_ASYMPT[b + 10]), vh, vl)
    s: __fast_two_sum(__ERFC_ASYMPT[b + 9], p.hi)
    zh := s.hi
    zl := s.lo + p.lo
    k := 8
    loop k >= 2 {
        d: __d_mul(zh, zl, vh, vl)
        t: __fast_two_sum(__ERFC_ASYMPT[b + k], d.hi)
        zh = t.hi
        zl = t.lo + d.lo
        k = k - 1
    }
    d: __d_mul(zh, zl, vh, vl)
    t: __fast_two_sum(__ERFC_ASYMPT[b], d.hi)
    w: __d_mul(t.hi, t.lo + (d.lo + __ERFC_ASYMPT[b + 1]), yh, yl)
    r: __d_mul(w.hi, w.lo, e.hi, e.lo)
    // relative error 2^-67.115, held up to an absolute 2^-1022 near underflow
    (hi: r.hi, lo: r.lo, err: if (r.hi >= Float{3.5543726719065856e-288}) -> Float{6.2601028758013134e-21} * r.hi else -> Float{2.2250738585072014e-308})
}
// The ranges of y = 1/x of __ERFC_ASYMPT's polynomials.
__ERFC_ASYMPT_CUT: [Float]{
    0.114501953125, 0.16887364264604549, 0.216796875, 0.26171875, 0.3046875, 0.3466796875
}
// erfc.c erfc_asympt_accurate: erfc(x) for 1.7094723742995113 < x <
// 27.226017111108366, rounded once: e^(-x^2) p(1/x) within about 2^-105
// relatively, its power of two applied last.
__erfc_asympt_accurate: fn(x: Float) -> Float Never! {
    // erfc(26.560485590559058) rounds to a subnormal its double-double misses
    if (x == Float{26.560485590559058}) -> return from_bits(0x6_67BD_620F_D95B)
    uh: x * x
    e: __erfc_exp_accurate(-uh, -fma(x, x, -uh))
    yh: Float{1.0} / x
    yl: yh * fma(-x, yh, Float{1.0})
    i := 0
    loop yh > __ERFC_ACC_CUT[i] {
        i = i + 1
    }
    b: 30 * i
    vh: yh * yh
    vl: fma(Float{2.0} * yh, yl, fma(yh, yh, -vh))
    // p(y) = y (c1 + y^2 (c3 + ...)): c1 to c11 as (hi, lo), then c13 to the
    // degree 29 + 2i
    zh := __ERFC_ASYMPT_ACC[b + 20 + i]
    zl := Float{0.0}
    j := 27 + 2 * i
    loop j >= 1 {
        d: __d_mul(zh, zl, vh, vl)
        if j >= 13 {
            s: __two_sum(__ERFC_ASYMPT_ACC[b + (j - 1) /% 2 + 6], d.hi)
            zh = s.hi
            zl = s.lo + d.lo
        } else {
            s: __two_sum(__ERFC_ASYMPT_ACC[b + j - 1], d.hi)
            zh = s.hi
            zl = s.lo + (d.lo + __ERFC_ASYMPT_ACC[b + j])
        }
        j = j - 2
    }
    w: __d_mul(zh, zl, yh, yl)
    u: __fast_two_sum(w.hi, w.lo)
    r: __d_mul(u.hi, u.lo, e.hi, e.lo)
    res: ldexp(r.hi + r.lo, e.k)
    if (res >= Float{2.2250738585072014e-308}) -> return res
    // a subnormal result: the bits h + l lost to its first rounding
    res + ldexp((r.hi - ldexp(res, -e.k)) + r.lo, e.k)
}
// The ranges of y = 1/x of __ERFC_ASYMPT_ACC's polynomials.
__ERFC_ACC_CUT: [Float]{
    0.079345703125, 0.1171875, 0.15576171875, 0.19775390625, 0.24462890625, 0.2978515625, 0.3603515625, 0.43359375, 0.521484375, 0.59375
}
// erfc.c exp_accurate: e^(xh + xl) as (hi + lo) 2^k within about 2^-104
// relatively, for -742 < xh: xh + xl = k log(2) + y, then a degree-19
// polynomial of y.
__erfc_exp_accurate: fn(xh: Float, xl: Float) -> (hi: Float, lo: Float, k: Int) Never! {
    kf: round_even(xh * Float{1.4426950408889634})
    // exact by Sterbenz
    yh: fma(-kf, Float{0.6931471805599453}, xh)
    t: __two_sum(-kf * Float{2.31904681384628e-17}, xl)
    y: __fast_two_sum(yh, t.hi)
    yl: fma(-kf, Float{1.94704509238075e-31}, y.lo + t.lo)
    // y.lo is below 2^-104 in the terms of degree 16 to 19
    h := fma(fma(fma(__ERFC_EXP_P[27], y.hi, __ERFC_EXP_P[26]), y.hi, __ERFC_EXP_P[25]), y.hi, __ERFC_EXP_P[24])
    l := Float{0.0}
    i := 15
    loop i >= 0 {
        d: __d_mul(h, l, y.hi, yl)
        if i >= 8 {
            s: __fast_two_sum(__ERFC_EXP_P[i + 8], d.hi)
            h = s.hi
            l = s.lo + d.lo
        } else {
            s: __fast_two_sum(__ERFC_EXP_P[2 * i], d.hi)
            h = s.hi
            l = s.lo + (d.lo + __ERFC_EXP_P[2 * i + 1])
        }
        i = i - 1
    }
    (hi: h, lo: l, k: Int.from_float(kf) ?? 0)
}
