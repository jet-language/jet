            low: __round_scaled(f.q - f.err, f.k - w)
            if low == __round_scaled(f.q + f.err, f.k - w) -> return low
        }
        if w == 1024 -> return __round_scaled(f.q, f.k - w)
        w = if w > 512 -> 1024 else -> 2 * w
    }
}
// e^(y log x) as q 2^(k - w) within err units of 2^(k - w), for x = xm 2^xe
// > 0 and y = yn 2^ye / yd, in w-bit fixed point: log t = 2 atanh((t - 1) /
// (t + 1)) for x = 2^E t with t in [1/sqrt 2, sqrt 2), then y log x =
// k log 2 + r and e^r = (e^(r / 2^8))^(2^8). Every truncation is counted
// into err.
__pow_fixed: fn(xm: Int, xe: Int, yn: Int, ye: Int, yd: Int, w: Int) -> (q: Int, err: Int, k: Int) Never! {
    one: Int{1} << w
    b: __bit_len(xm)
    big_e := b + xe
    t := if b <= w -> xm << (w - b) else -> xm >> (b - w)
    terr := if b <= w -> 0 else -> 1
    if 2 * t * t < one * one {
        t = t << 1
        terr = 2 * terr
        big_e = big_e - 1
    }
    // atanh(|s|) for s = (t - 1)/(t + 1), |s| < 0.1716; each term within 2
    // units, s and s^2 within serr and serr + 1, the tail below 1
    d: if t >= one -> t - one else -> one - t
    s: (d << w) /% (t + one)
    serr: terr + 1
    s2: (s * s) >> w
    sum := s
    term := s
    j := 1
    loop term != 0 {
        term = (term * s2) >> w
        j = j + 2
        sum = sum + term /% j
    }
    ln2: __LN2_1024 >> (1024 - w)
    logt: if t >= one -> 2 * sum else -> -2 * sum
    lx: big_e * ln2 + logt
    lxerr: 2 * (3 * serr + j + 3) + (if big_e < 0 -> -big_e else -> big_e) + 1
    num := lx * yn
    nerr := lxerr * (if yn < 0 -> -yn else -> yn)
    if ye >= 0 {
        num = num << ye
        nerr = nerr << ye
    } else {
        num = num >> -ye
        nerr = (nerr >> -ye) + 2
    }
    if yd != 1 {
        num = num /% yd
        nerr = nerr /% yd + 2
    }
