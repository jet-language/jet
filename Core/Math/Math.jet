/// ln|gamma(x)|, correctly rounded (C23 lgamma; CORE-MATH lgamma.c): +inf at
/// zero, at negative whole x and at +-inf.
lgamma: fn(n: Float) -> Float Never! {
    b: to_bits(n)
    ab: b.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if ab >= 0x7F57_54D9_278B_51A6 {
        // |x| >= 3.517009718874798e305: every such x is whole, and lgamma
        // overflows but for two x just above
        if b == 0x7F57_54D9_278B_51A6 -> return Float{1.7976931348623155e308} - Float{4.9896007738368e291}
        if b == 0x7F57_54D9_278B_51A7 -> return Float{1.7976931348623157e308} - Float{4.9896007738368e291}
        if is_nan(n) -> return n + n
        return INFINITY
    }
    fx: floor(n)
    if fx == n {
        if (n <= Float{0.0}) -> return INFINITY
        if (n == Float{1.0} || n == Float{2.0}) -> return Float{0.0}
    }
    au: ab >> 37
    fh := Float{0.0}
    fl := Float{0.0}
    eps := Float{0.0}
    if au < __LGAMMA_BRD[0] {
        // |x| < 1/2: lgamma(x) = lgamma(1 + x) - ln|x|
        lg: __gamma_log(fabs(n))
        if au < 0x1DA_0000 {
            // |x| < 2.6469779601696886e-23
            fh = -lg.hi
            fl = -lg.lo
            eps = Float{1.5e-22}
        } else if au < 0x1FD_0000 {
            // |x| < 1/32
            z2: n * n
            z4: z2 * z2
            q: __LGAMMA_TINY_Q
            p: __exp_m1_cr_opolyddd(n, __LGAMMA_TINY_CC, 0, 4, n * (((q[0] + n * q[1]) + z2 * (q[2] + n * q[3])) + z4 * ((q[4] + n * q[5]) + z2 * (q[6] + n * q[7]))))
            m: __exp2_cr_mulddd(n, p.hi, p.lo)
            s: __two_sum_dd(-lg.hi, -lg.lo, m.hi, m.lo)
            fh = s.hi
            fl = s.lo
            eps = Float{1.5e-22}
        } else {
            // 1 + x in [1/2, 31/32] or [33/32, 3/2], within the pieces
            y: __fast_two_sum(Float{1.0}, n)
            j: __lgamma_piece(to_bits(y.hi) >> 37)
            f: __lgamma_piece_poly(j, (y.hi - __LGAMMA_OFF[j]) + y.lo)
            fh = f.hi
            fl = f.lo
            if j == 4 {
                // the root at 1 + x = 1
                r: __exp2_cr_mulddd(-n, fh, fl)
                fh = r.hi
                fl = r.lo
            }
            eps = fabs(fh) * Float{8.3e-20}
            s: __two_sum_dd(-lg.hi, -lg.lo, fh, fl)
            fh = s.hi
            fl = s.lo
            eps = eps + fabs(lg.hi) * Float{5e-22}
        }
    } else {
        ax: fabs(n)
        if au >= __LGAMMA_BRD[19] {
            // |x| >= 8.29541: Stirling, (x - 1/2) (ln(x) - 1) + c0 + c1 z + ...
            lg: __gamma_log(ax)
            lh := lg.hi - Float{1.0}
            ll := lg.lo
            if au >= 0x219_8000 {
                // x >= 2^52: x (ln(x) - 1) - (ln(x) - 1)/2
                if au >= 0x3FA_BAA6 {
                    r: __fast_two_sum(lh, ll)
                    lh = r.hi
                    ll = r.lo
                }
                hlh: lh * Float{0.5}
                m: __exp2_cr_mulddd(ax, lh, ll)
                lh = m.hi
                ll = m.lo - hlh
            } else {
                m: __exp2_cr_mulddd(ax - Float{0.5}, lh, ll)
                lh = m.hi
                ll = m.lo
            }
            c: __LGAMMA_ASYM_CC
            l: __fast_sum_dd(lh, ll, c[0], c[1])
            sh := Float{0.0}
            sl := Float{0.0}
            if (ax < Float{1.2676506002282294e30}) {
                zh: Float{1.0} / ax
                zl: fma(zh, -ax, Float{1.0}) * zh
                z2h: zh * zh
                z4h: z2h * z2h
                q: __LGAMMA_ASYM_Q
                t: __fast_two_sum(c[2], z2h * ((q[0] + z2h * q[1]) + z4h * ((q[2] + z2h * q[3]) + z4h * q[4])))
                p: __exp_cr_muldd(t.hi, t.lo + c[3], zh, zl)
                sh = p.hi
                sl = p.lo
            }
            s: __fast_sum_dd(l.hi, l.lo, sh, sl)
            fh = s.hi
            fl = s.lo
            eps = fabs(fh) * Float{4.5e-20}
        } else {
            // 1/2 <= |x| < 8.29541
            j: __lgamma_piece(au)
            f: __lgamma_piece_poly(j, ax - __LGAMMA_OFF[j])
            fh = f.hi
            fl = f.lo
            if j == 4 {
                // the root at 1
                r: __exp2_cr_mulddd(Float{1.0} - ax, fh, fl)
                fh = r.hi
                fl = r.lo
            }
            if j == 10 {
                // the root at 2
                r: __exp2_cr_mulddd(ax - Float{2.0}, fh, fl)
                fh = r.hi
                fl = r.lo
            }
            eps = fabs(fh) * Float{8.7e-20} + Float{1e-24}
        }
        if b < 0 {
            // reflection: lgamma(x) = -ln(-x sin(pi x)/pi) - lgamma(-x)
            sp: __lgamma_sin_pi(n - fx)
            s: __exp2_cr_mulddd(-n, sp.hi, sp.lo)
            lg: __gamma_log(s.hi)
            r: __two_sum_dd(fh, fl, lg.hi, lg.lo + s.lo / s.hi)
            fh = -r.hi
            fl = -r.lo
            eps = eps + fabs(lg.hi) * Float{8e-22}
        }
    }
    ub: fh + (fl + eps)
    if ub != fh + (fl - eps) -> return __lgamma_accurate(n)
    ub
}
// lgamma.c's piece of [1/2, 8.29541] for a = |x|'s bits >> 37, from a
// quadratic guess corrected by one border.
__lgamma_piece: fn(a: Int) -> Int Never! {
    ou: a - __LGAMMA_BRD[0]
    j: ((0x1_57CE_D865 - ou * 0x150D) * ou + 0x1280_0000_0000) >> 45
    if a < __LGAMMA_BRD[j] -> return j - 1
    j
}
// lgamma on piece j at z = x - off[j]: degrees 0 to 4 in double-double, 5 to
// 12 as Floats.
__lgamma_piece_poly: fn(j: Int, z: Float) -> (hi: Float, lo: Float) Never! {
    z2: z * z
    z4: z2 * z2
    o: 8 * j
    q: __LGAMMA_CL
    fl: z * (((q[o] + z * q[o + 1]) + z2 * (q[o + 2] + z * q[o + 3])) + z4 * ((q[o + 4] + z * q[o + 5]) + z2 * (q[o + 6] + z * q[o + 7])))
    __exp_m1_cr_opolyddd(z, __LGAMMA_CH, 10 * j, 5, fl)
}
// lgamma.c as_sinpipid: sin(pi x)/pi as a double-double for 0 < x < 1, by a
// series in z = 1/2 - |x - 1/2| within 1/64 of 0 and 1.
__lgamma_sin_pi: fn(x: Float) -> (hi: Float, lo: Float) Never! {
    ax: fabs(x - Float{0.5})
    if (round_even(ax * Float{128.0}) <= Float{62.0}) -> return __gamma_sin_pi(x, __LGAMMA_SIN_PI_T)
    z: Float{0.5} - ax
    z2: z * z
    z2l: fma(z, z, -z2)
    t: __fast_two_sum(Float{-1.6449340668482264}, z2 * (Float{0.8117424252833463} + z2 * (Float{-0.19075182400041193} + z2 * Float{0.026146961822224223})))
    f: __exp_cr_muldd(z2, z2l, t.hi, t.lo + Float{-3.02274545379001e-17})
    g: __exp2_cr_mulddd(z, f.hi, f.lo)
    s: __fast_two_sum(z, g.hi)
    (hi: s.hi, lo: g.lo + s.lo)
}
// lgamma.c as_lgamma_accurate: ln|gamma(x)| for finite x where lgamma's
// fast path cannot round, in triple-double, then near lgamma's roots on
// (-10.5, -2) a polynomial in the distance to the root, and the hard cases.
__lgamma_accurate: fn(sx: Float) -> Float Never! {
    x: fabs(sx)
    fh := Float{0.0}
    fl := Float{0.0}
    fll := Float{0.0}
    if (x < Float{0.25}) {
        if (x < Float{7.888609052210118e-31}) {
            lg: __lgamma_log_accurate(x)
            a: __fast_two_sum(-lg.hi, -lg.mid)
            c: __fast_two_sum(a.lo, -lg.lo)
            fh = a.hi
            fl = c.hi
            fll = c.lo
        } else {
            // lgamma(x) = x P(x) - ln|x|
            p: __exp_m1_cr_opolyddd(sx, __LGAMMA_ACC_C0, 0, __LGAMMA_ACC_C0.len() /% 2, Float{0.0})
            m: __exp2_cr_mulddd(sx, p.hi, p.lo)
            lg: __lgamma_log_accurate(x)
            s: __two_sum_dd(m.hi, m.lo, -lg.mid, -lg.lo)
            t: __two_sum(-lg.hi, s.hi)
            u: __two_sum(t.lo, s.lo)
            fh = t.hi
            fl = u.hi
            fll = u.lo
        }
        // fh + fl a tie: break it by the sign of fll
        et: __fast_two_sum(fh, Float{2.0} * fl)
        if (et.lo == Float{0.0}) -> fl = fl * (Float{1.0} + copysign(Float{2.220446049250313e-16}, fl) * copysign(Float{1.0}, fll))
    } else {
        // near 1/2, 1, ..., 7/2: lgamma(1 + x) from lgamma(3/2 + d) or
        // (lgamma(1 + d) + ln(1 + d))/d and logs of x - 1 and x - 2, then for
        // sx < 0 the log of x (lgamma(1 + x) is the reflection's lgamma(1 - sx))
        neg: (sx < Float{0.0})
        addlog := neg
        f := __lgamma_dd3(Float{0.0}, Float{0.0}, Float{0.0})
        if (fabs(x - Float{0.5}) < Float{0.25}) {
            p: __exp_m1_cr_opolyddd(x - Float{0.5}, __LGAMMA_ACC_B, 0, __LGAMMA_ACC_B.len() /% 2, Float{0.0})
            f = __lgamma_dd3(p.hi, p.lo, Float{0.0})
            if !neg {
                lg: __lgamma_log_accurate(x)
                f = __lgamma_add3(f.hi, f.mid, f.lo, -lg.hi, -lg.mid, -lg.lo)
            }
            addlog = false
        } else if (fabs(x - Float{2.5}) < Float{0.25}) {
            p: __exp_m1_cr_opolyddd(x - Float{2.5}, __LGAMMA_ACC_B, 0, __LGAMMA_ACC_B.len() /% 2, Float{0.0})
            lg: __lgamma_log_accurate(x - Float{1.0})
            f = __lgamma_add3(p.hi, p.lo, Float{0.0}, lg.hi, lg.mid, lg.lo)
        } else if (fabs(x - Float{3.5}) < Float{0.25}) {
            lg: __lgamma_log2_accurate(x)
            p: __exp_m1_cr_opolyddd(x - Float{3.5}, __LGAMMA_ACC_B, 0, __LGAMMA_ACC_B.len() /% 2, Float{0.0})
            f = __lgamma_add3(p.hi, p.lo, Float{0.0}, lg.hi, lg.mid, lg.lo)
        } else if (fabs(x - Float{1.0}) < Float{0.25}) {
            p: __exp_m1_cr_opolyddd(x - Float{1.0}, __LGAMMA_ACC_C0, 0, __LGAMMA_ACC_C0.len() /% 2, Float{0.0})
            m: __exp2_cr_mulddd(x - Float{1.0}, p.hi, p.lo)
            f = __lgamma_dd3(m.hi, m.lo, Float{0.0})
        } else if (fabs(x - Float{1.5}) < Float{0.25}) {
            p: __exp_m1_cr_opolyddd(x - Float{1.5}, __LGAMMA_ACC_B, 0, __LGAMMA_ACC_B.len() /% 2, Float{0.0})
            f = __lgamma_dd3(p.hi, p.lo, Float{0.0})
        } else if (fabs(x - Float{2.0}) < Float{0.25}) {
            lg: __lgamma_log_accurate(x - Float{1.0})
            p: __exp_m1_cr_opolyddd(x - Float{2.0}, __LGAMMA_ACC_C0, 0, __LGAMMA_ACC_C0.len() /% 2, Float{0.0})
            m: __exp2_cr_mulddd(x - Float{2.0}, p.hi, p.lo)
            f = __lgamma_add3(m.hi, m.lo, Float{0.0}, lg.hi, lg.mid, lg.lo)
        } else if (fabs(x - Float{3.0}) < Float{0.25}) {
            lg: __lgamma_log2_accurate(x)
            p: __exp_m1_cr_opolyddd(x - Float{3.0}, __LGAMMA_ACC_C0, 0, __LGAMMA_ACC_C0.len() /% 2, Float{0.0})
            m: __exp2_cr_mulddd(x - Float{3.0}, p.hi, p.lo)
            f = __lgamma_add3(m.hi, m.lo, Float{0.0}, lg.hi, lg.mid, lg.lo)
        } else {
            // x > 3.75: Stirling at x, or at 1 + x for sx < 0
            y: if neg -> __fast_two_sum(x, Float{1.0}) else -> __fast_two_sum(x, Float{0.0})
            f = __lgamma_asym_accurate(y.hi, y.lo)
            addlog = false
        }
        if addlog {
            lg: __lgamma_log_accurate(x)
            f = __lgamma_add3(f.hi, f.mid, f.lo, lg.hi, lg.mid, lg.lo)
        }
        if neg {
            phi: if (sx < Float{-0.5}) -> sx - floor(sx) else -> -sx
            sp: __lgamma_sin_pi_accurate(phi)
            lg: __lgamma_log_accurate(sp.hi)
            r: __lgamma_add3(f.hi, f.mid, f.lo, lg.hi, lg.mid + (sp.lo / sp.hi + lg.lo), Float{0.0})
            f = __lgamma_dd3(-r.hi, -r.mid, -r.lo)
        }
        a: __fast_two_sum(f.hi, f.mid)
        c: __fast_two_sum(a.lo, f.lo)
        a2: __fast_two_sum(a.hi, c.hi)
        c2: __fast_two_sum(a2.lo, c.lo)
        fh = a2.hi
        fl = c2.hi
        fll = c2.lo
        // fh + fl a tie: break it by the sign of fll
        et: __fast_two_sum(fh, Float{2.0} * fl)
        if (et.lo == Float{0.0}) -> fl = fl * (Float{1.0} + copysign(Float{1.4901161193847656e-8}, fl) * copysign(Float{1.4901161193847656e-8}, fll))
    }
    if (fabs(fh) < Float{0.375}) {
        // near a root x0 of lgamma: lgamma(x) = z P(sc z), z = x + x0
        rt: __LGAMMA_ROOT
        k := 0
        row := -1
        loop k < 17 {
            if (sx > rt[7 * k] && sx < rt[7 * k + 1]) -> row = k
            k = k + 1
        }
        if row >= 0 && fabs(fh) < rt[7 * row + 2] {
            o: __LGAMMA_ROOT_IX[3 * row]
            nd: __LGAMMA_ROOT_IX[3 * row + 1]
            nf: __LGAMMA_ROOT_IX[3 * row + 2]
            z: __fast_two_sum(rt[7 * row + 3] + sx, rt[7 * row + 4])
            zl: z.lo + rt[7 * row + 5]
            sh: z.hi * rt[7 * row + 6]
            sl: zl * rt[7 * row + 6]
            c: __LGAMMA_ROOT_C
            i := nf - 1
            pk := c[o + 2 * (nd + i)]
            loop i > 0 {
                i = i - 1
                pk = c[o + 2 * (nd + i)] + sh * pk
            }
            p: __exp_m1_cr_opolydd(sh, sl, c, o, nd, sh * pk)
            m: __exp_cr_muldd(z.hi, zl, p.hi, p.lo)
            fh = m.hi
            fl = m.lo
        }
    }
    // fl zero or within 2 ulps of a power of 2: fh + fl may be a hard case
    if (to_bits(fl) + 2).bit_and(0xF_FFFF_FFFF_FFFF) <= 2 {
        h: __hard_case(__LGAMMA_HARD, sx)
        if !is_nan(h) -> return h
    }
    fh + fl
}
// A triple-double from its three parts.
__lgamma_dd3: fn(hi: Float, mid: Float, lo: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    (hi: hi, mid: mid, lo: lo)
}
// (fh + fm + fl) + (h + m + l), lgamma.c's sumdd and twosum chain.
__lgamma_add3: fn(fh: Float, fm: Float, fl: Float, h: Float, m: Float, l: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    s: __two_sum_dd(fm, fl, m, l)
    t: __two_sum(fh, h)
    r: __two_sum_dd(s.hi, s.lo, t.lo, Float{0.0})
    (hi: t.hi, mid: r.hi, lo: r.lo)
}
// ln(x - 1) + ln(x - 2) as a triple-double, for x near 3 and 7/2.
__lgamma_log2_accurate: fn(x: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    l2: __lgamma_log_accurate(x - Float{2.0})
    l1: __lgamma_log_accurate(x - Float{1.0})
    a: __two_sum_dd(l1.mid, l1.lo, l2.mid, l2.lo)
    h: __fast_two_sum(l1.hi, l2.hi)
    r: __two_sum_dd(a.hi, a.lo, h.lo, Float{0.0})
    (hi: h.hi, mid: r.hi, lo: r.lo)
}
// lgamma.c as_logd_accurate: ln(x) as a triple-double for x > 0, as
// __gamma_log with triple-double tables and a longer series.
__lgamma_log_accurate: fn(x: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    sub: (to_bits(x) >> 52) == 0
    b: if sub -> to_bits(x * Float{4503599627370496.0}) else -> to_bits(x)
    ed: Float{(b >> 52) - (if sub -> 1075 else -> 1023)}
    m: b.bit_and(0xF_FFFF_FFFF_FFFF)
    i: m >> 47
    d: m.bit_and(0x7FFF_FFFF_FFFF)
    j: (m + (__LOG2CR_B[2 * i] << 33) + __LOG2CR_B[2 * i + 1] * (d >> 16)) >> 42
    i1: j >> 5
    i2: j.bit_and(31)
    tf: from_bits(m.bit_or(0x3FF0_0000_0000_0000))
    r: __GAMMA_LOG_R1[i1] * __LOG2CR_R2[i2]
    o: r * tf
    dx: __fast_two_sum(o - Float{1.0}, fma(r, tf, -o))
    c: __LGAMMA_LOG_C
    p: __exp_m1_cr_opolydd(dx.hi, dx.lo, c, 0, 6, dx.hi * (c[12] + dx.hi * (c[14] + dx.hi * c[16])))
    f: __exp_cr_muldd(dx.hi, dx.lo, p.hi, p.lo)
    s2: __LGAMMA_LOG_H1[3 * i1 + 2] + __LGAMMA_LOG_H2[3 * i2 + 2]
    s1: __LGAMMA_LOG_H1[3 * i1 + 1] + __LGAMMA_LOG_H2[3 * i2 + 1]
    s0: __LGAMMA_LOG_H1[3 * i1] + __LGAMMA_LOG_H2[3 * i2]
    l0: Float{0.6931471805598903} * ed + s2
    l1: __two_sum_dd(Float{5.49792301870721e-14} * ed, Float{1.1612227229362532e-26} * ed, s1, s0)
    l2: __two_sum_dd(l1.hi, l1.lo, f.hi, f.lo)
    a: __fast_two_sum(l0, l2.hi)
    e: __fast_two_sum(a.lo, l2.lo)
    (hi: a.hi, mid: e.hi, lo: e.lo)
}
// lgamma.c as_sinpipid_accurate: sin(pi x)/pi as a double-double for 0 < x
// < 1, as __gamma_sin_pi with double-double series.
__lgamma_sin_pi_accurate: fn(x: Float) -> (hi: Float, lo: Float) Never! {
    v: fabs(x - Float{0.5}) * Float{128.0}
    iv: round_even(v)
    d: iv - v
    ky: Int.from_float(iv) ?? 0
    kx: 64 - ky
    t: __LGAMMA_SIN_PI_T
    d2h: d * d
    d2l: fma(d, d, -d2h)
    p0: __exp_m1_cr_opolydd(d2h, d2l, __LGAMMA_SIN_PI_C, 0, 5, Float{0.0})
    q0: __exp_m1_cr_opolydd(d2h, d2l, __LGAMMA_SIN_PI_S, 0, 6, Float{0.0})
    p1: __exp2_cr_mulddd(d, p0.hi, p0.lo)
    p: __exp_cr_muldd(t[2 * kx + 1], t[2 * kx], p1.hi, p1.lo)
    q: __exp_cr_muldd(t[2 * ky + 1], t[2 * ky], q0.hi, q0.lo)
    c0: __fast_sum_dd(q.hi, q.lo, p.hi, p.lo)
    c: __exp2_cr_mulddd(d, c0.hi, c0.lo)
    __fast_sum_dd(t[2 * kx + 1], t[2 * kx], c.hi, c.lo)
}
// lgamma.c as_lgamma_asym_accurate: ln(gamma(x)) for x = xh + xl > 3.75 as a
// triple-double, (x - 1/2) (ln(x) - 1) + c0 plus a series in 1/x.
__lgamma_asym_accurate: fn(xh: Float, xl: Float) -> (hi: Float, mid: Float, lo: Float) Never! {
    lg: __lgamma_log_accurate(xh)
    l0: lg.hi - Float{1.0}
    l1 := lg.mid
    l2 := lg.lo
    if (xh >= Float{1.329227995784916e36}) {
        wl: xl - Float{0.5}
        l0x: l0 * xh
        l1x: l1 * xh
        s: __two_sum_dd(l1x, l2 * xh, fma(l0, xh, -l0x), fma(l1, xh, -l1x))
        s2: __two_sum_dd(s.hi, s.lo, l0 * wl, l1 * wl)
        return (hi: l0x, mid: s2.hi, lo: s2.lo)
    }
    zh: Float{1.0} / xh
    zl: (fma(zh, -xh, Float{1.0}) - xl * zh) * zh
    if (xl != Float{0.0}) {
        // ln(xh + xl) = ln(xh) + xl/xh - (xl/xh)^2/2
        dl: __exp2_cr_mulddd(xl, zh, fma(zh, -xh, Float{1.0}) * zh)
        s: __two_sum_dd(l1, l2, dl.hi, dl.lo - dl.hi * dl.hi / Float{2.0})
        l1 = s.hi
        l2 = s.lo
    }
    // x - 1/2 as wh + wl, exactly
    big: (to_bits(xh) >> 52) > 0x3FF + 51
    wh: if big -> xh else -> xh - Float{0.5}
    wl: if big -> xl - Float{0.5} else -> xl
    l0x: l0 * wh
    l1x: l1 * wh
    s: __two_sum_dd(l1x, l2 * wh, fma(l0, wh, -l0x), fma(l1, wh, -l1x))
    s2: __two_sum_dd(s.hi, s.lo, l0 * wl, l1 * wl)
    z2: __exp_cr_muldd(zh, zl, zh, zl)
    c0: __LGAMMA_ASYM_ACC_C0
    k: if (xh >= Float{48.0}) -> 0 else -> if (xh >= Float{14.5}) -> 2 else -> 4
    c: if k == 0 -> __LGAMMA_ASYM_ACC_48 else -> if k == 2 -> __LGAMMA_ASYM_ACC_14 else -> __LGAMMA_ASYM_ACC_LO
    s3: __two_sum_dd(s2.hi, s2.lo, c0[k], c0[k + 1])
    p: __exp_m1_cr_opolydd(z2.hi, z2.lo, c, 0, c.len() /% 2, Float{0.0})
    f: __exp_cr_muldd(zh, zl, p.hi, p.lo)
    s4: __two_sum_dd(s3.hi, s3.lo, f.hi, f.lo)
    a: __fast_two_sum(l0x, s4.hi)
    e: __fast_two_sum(a.lo, s4.lo)
    (hi: a.hi, mid: e.hi, lo: e.lo)
}
// lgamma's piece borders for 1/2 <= |x| < 8.29541: |x|'s bits >> 37, then
// each piece's offset, its degrees 5 to 12 as Floats and its degrees 0 to 4 as
// (hi, lo) pairs.
