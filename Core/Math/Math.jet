}
// a^y rounded when it is a Float or the midpoint of two, else NaN (the
// cases of CORE-MATH pow.c is_exact). With a = m 2^e and y = n 2^f, m and n
// odd: a power of two gives 2^(e y) when e y is whole; otherwise y > 0, and
// m^y or, for y = n/2^k, the k-fold square root of m must be whole with an
// odd power below 2^54.
__pow_exact: fn(a: Float, y: Float) -> Float Never! {
