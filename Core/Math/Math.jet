tan: fn(n: Float) -> Float Never! { core.math.tan(n) }
tanh: fn(n: Float) -> Float Never! { core.math.tanh(n) }
trunc: fn(n: Float) -> Float Never! { core.math.trunc(n) }
truncate: fn(n: Float) -> Float Never! { trunc(n) }

cot: fn(n: Float) -> Float Never! { 1.0 / tan(n) }
copysign: fn(value: Float, sign_value: Float) -> Float Never! {
    magnitude: to_bits(value).bit_and(9223372036854775807)
    sign: to_bits(sign_value).bit_and((-9223372036854775807 - 1))
    from_bits(magnitude.bit_or(sign))
}
fma: fn(a: Float, b: Float, c: Float) -> Float Never! { core.math.fma(a, b, c) }
muladd: fn(a: Float, b: Float, c: Float) -> Float Never! { fma(a, b, c) }
inv: fn(n: Float) -> Float Never! { 1.0 / n }
signum: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return NAN
    if sign_bit(n) -> return -1.0
    1.0
}
degrees: fn(n: Float) -> Float Never! { n * 57.29577951308232 }
radians: fn(n: Float) -> Float Never! { n * 0.017453292519943295 }
lerp: fn(a: Float, b: Float, t: Float) -> Float Never! { a + (b - a) * t }
fabs: fn(n: Float) -> Float Never! { core.math.fabs(n) }
// `math.abs` on F32 and I64 (MathBuiltin `abs`): F32 negates exactly when the
// sign bit is set, so -0.0 and a negative NaN lose their sign; I64 negation
// stops at I64.MIN like any fixed-width overflow.
__abs_f32: fn(n: F32) -> F32 Never! {
    if to_bits(Float.from_f32(n)) < 0 -> return -n
    n
}
__abs_i64: fn(n: I64) -> I64 Never! {
    zero: I64{0}
    if n < zero -> return -n
    n
}
real: fn(n: Float) -> Float Never! { n }
imag: fn(n: Float) -> Float Never! { Float{0.0} }
conj: fn(n: Float) -> Float Never! { n }

is_nan: fn(n: Float) -> Bool Never! { n != n }
is_inf: fn(n: Float) -> Bool Never! { fabs(n) == INFINITY }
is_finite: fn(n: Float) -> Bool Never! { fabs(n) < INFINITY }
// #4747: preserve the existing F32 call contract without changing Float policy.
__is_finite_f32: fn(n: F32) -> Bool Never! { is_finite(Float.from_f32(n)) }
isnan: fn(n: Float) -> Bool Never! { is_nan(n) }
isinf: fn(n: Float) -> Bool Never! { is_inf(n) }
isfinite: fn(n: Float) -> Bool Never! { is_finite(n) }
is_normal: fn(n: Float) -> Bool Never! {
    magnitude: fabs(n)
    magnitude >= 2.2250738585072014e-308 && magnitude < INFINITY
}
is_subnormal: fn(n: Float) -> Bool Never! {
    magnitude: fabs(n)
    magnitude > 0.0 && magnitude < 2.2250738585072014e-308
}
is_canonical: fn(n: Float) -> Bool Never! { is_finite(n) || is_nan(n) }
is_signed: fn(n: Float) -> Bool Never! { sign_bit(n) }
is_zero: fn(n: Float) -> Bool Never! { n == 0.0 }
is_integer: fn(n: Float) -> Bool Never! { is_finite(n) && fract(n) == 0.0 }
sign_bit: fn(n: Float) -> Bool Never! { to_bits(n) < 0 }

next_up: fn(n: Float) -> Float Never! {
    if is_nan(n) || n == INFINITY -> return n
    next_after(n, INFINITY)
}
next_down: fn(n: Float) -> Float Never! {
    if is_nan(n) || n == -INFINITY -> return n
    next_after(n, -INFINITY)
}
/// nextafter.c from musl 1.2.5: one step of the bit pattern toward `toward`.
next_after: fn(n: Float, toward: Float) -> Float Never! {
    if is_nan(n) || is_nan(toward) -> return __nan_pair(n, toward)
    ux: to_bits(n)
    uy: to_bits(toward)
    if ux == uy -> return toward
    ax: ux.bit_and(9223372036854775807)
    ay: uy.bit_and(9223372036854775807)
    if ax == 0 {
        if ay == 0 -> return toward
        return from_bits(uy.bit_and(-9223372036854775807 - 1).bit_or(1))
    }
    if ax > ay || (ux < 0) != (uy < 0) -> return from_bits(ux - 1)
    from_bits(ux + 1)
}
nextafter: fn(n: Float, toward: Float) -> Float Never! { next_after(n, toward) }
significand: fn(n: Float) -> Float Never! {
    if n == 0.0 || !is_finite(n) -> return n
    bits: to_bits(n)
    exponent: (bits >> 52).bit_and(2047)
    if exponent == 0 {
        value := fabs(n)
        loop value < 1.0 -> value = value * 2.0
        return copysign(value, n)
    }
    copysign(from_bits((1023 << 52).bit_or((bits.bit_and(4503599627370495)))), n)
}
ulp: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return NAN
    if is_inf(n) -> return INFINITY
    magnitude: fabs(n)
    if magnitude == 0.0 -> return from_bits(1)
    from_bits(to_bits(magnitude) + 1) - magnitude
}
/// ilogb.c from musl 1.2.5: the unbiased exponent, a subnormal's counted
/// from its leading bit; None for a zero, an infinity or a NaN.
ilogb: fn(n: Float) -> Int? Never! {
    bits: to_bits(n).bit_and(9223372036854775807)
    exponent: bits >> 52
    if exponent == 2047 -> return None
    if exponent != 0 -> return Val(exponent - 1023)
    if bits == 0 -> return None
    i := bits << 12
    found := -1023
    loop i < 9223372036854775808 {
        found = found - 1
        i = i << 1
    }
    Val(found)
}
/// scalbn.c from musl 1.2.5: `n` times 2^exponent, scaled in at most three
/// exact steps so only the last can round.
ldexp: fn(n: Float, exponent: Int) -> Float Never! {
    y := n
    k := exponent
    if k > 1023 {
        y = y * Float{8.98846567431158e307}
        k = k - 1023
        if k > 1023 {
            y = y * Float{8.98846567431158e307}
            k = k - 1023
            if k > 1023 -> k = 1023
        }
    } else if k < -1022 {
        y = y * Float{2.004168360008973e-292}
        k = k + 969
        if k < -1022 {
            y = y * Float{2.004168360008973e-292}
            k = k + 969
            if k < -1022 -> k = -1022
        }
    }
    y * from_bits((1023 + k) << 52)
}
scaleb: fn(n: Float, exponent: Int) -> Float Never! { ldexp(n, exponent) }
radix: fn(n: Float) -> Int Never! { 2 }

// Comptime constants. INFINITY and NAN are the IEEE-754 binary64 quotients;
// NAN compares unequal to every value, itself included (use `is_nan`).
PI: Float{3.14159265358979323846264338327950288}
E: Float{2.7182818284590452354}
TAU: Float{6.2831853071795864769}
INFINITY: Float{1.0} / Float{0.0}
NAN: Float{0.0} / Float{0.0}

round: fn(n: Float) -> Int Never! {
    if is_nan(n) -> return 0
    if n >= 9223372036854775808.0 -> return 9223372036854775807
    if n <= -9223372036854775808.0 -> return -9223372036854775808
    whole := trunc(n)
    fraction: n - whole
    if fraction >= 0.5 -> whole = whole + 1.0
    if fraction <= -0.5 -> whole = whole - 1.0
    Int.from_float(whole) ?? panic("bounded rounded Float fits Int")
}
to_bits: fn(n: Float) -> Int Never! { core.math.to_bits(n) }
// `math.to_bits` on F32: the binary32 bits as an Int in 0..<2^32, and its
// inverse, the F32 of binary32 `bits` in that range. Both are one bit copy
// (no conversion), so NaN payloads and signaling NaNs cross unchanged.
__to_bits_f32: fn(n: F32) -> Int Never! { core.math.__to_bits_f32(n) }
__from_bits_f32: fn(bits: Int) -> F32 Never! { core.math.__from_bits_f32(bits) }
from_bits: fn(bits: Int) -> Float Never! { core.math.from_bits(bits) }
sin_cos: fn(n: Float) -> (cos: Float, sin: Float) Never! {
    pair: core.math.sin_cos(n)
    (cos: pair.cos, sin: pair.sin)
}
/// modf.c from musl 1.2.5: the whole part clears the fraction bits, and a
/// whole `n` has a fraction of zero with its sign.
modf: fn(n: Float) -> (fract: Float, whole: Float) Never! {
    bits: to_bits(n)
    signed_zero: from_bits(bits.bit_and(-9223372036854775807 - 1))
    e: (bits >> 52).bit_and(2047) - 1023
    if e >= 52 {
        if e == 1024 && bits.bit_and(4503599627370495) != 0 -> return (fract: n, whole: n)
        return (fract: signed_zero, whole: n)
    }
    if e < 0 -> return (fract: n, whole: signed_zero)
    mask: 4503599627370495 >> e
    if bits.bit_and(mask) == 0 -> return (fract: signed_zero, whole: n)
    whole: from_bits(bits - bits.bit_and(mask))
    (fract: n - whole, whole: whole)
}
/// frexp.c from musl 1.2.5: `n` is frac * 2^exp with |frac| in [0.5, 1);
/// a zero, an infinity or a NaN is its own frac with exp 0.
frexp: fn(n: Float) -> (exp: Int, frac: Float) Never! {
    bits: to_bits(n)
    biased: (bits >> 52).bit_and(2047)
    if biased == 0 {
        if n == 0.0 -> return (exp: 0, frac: n)
        scaled: frexp(n * Float{18446744073709551616.0})
        return (exp: scaled.exp - 64, frac: scaled.frac)
    }
    if biased == 2047 -> return (exp: 0, frac: n)
    (exp: biased - 1022, frac: from_bits(bits.bit_and(-9218868437227405313).bit_or(4602678819172646912)))
}

checked_abs: fn(n: Int) -> Int? Never! {
    if n < 0 -> return Val(0 - n)
    Val(n)
}

checked_neg: fn(n: Int) -> Int? Never! { Val(0 - n) }

checked_add: fn(a: Int, b: Int) -> Int? Never! { Val(a + b) }

checked_sub: fn(a: Int, b: Int) -> Int? Never! { Val(a - b) }

checked_mul: fn(a: Int, b: Int) -> Int? Never! { Val(a * b) }

checked_div: fn(a: Int, b: Int) -> Int? Never! {
    if b == 0 -> return None
    remainder: a %% b
    Val((a - remainder) /% b)
}

checked_rem: fn(a: Int, b: Int) -> Int? Never! {
    if b == 0 -> return None
    Val(a %% b)
}

checked_pow: fn(base: Int, exponent: Int) -> Int? Never! {
    if exponent < 0 -> return None
    result := 1
    factor := base
    power := exponent
    loop power > 0 {
        if ((power).bit_and(1)) != 0 {
            result = checked_mul(result, factor) ?? return None
        }
        power = power /% 2
        if power > 0 -> factor = checked_mul(factor, factor) ?? return None
    }
    Val(result)
}

// Integer power has the same exact arithmetic and negative-exponent stop as `Int.pow`.
int_pow: fn(base: Int, exponent: Int) -> Int Never! { base.pow(exponent) }

saturating_add: fn(a: Int, b: Int) -> Int Never! { a + b }

saturating_sub: fn(a: Int, b: Int) -> Int Never! { a - b }

saturating_mul: fn(a: Int, b: Int) -> Int Never! { a * b }

factorial: fn(n: Int) -> Int? Never! {
    if n < 0 -> return None
    acc := 1
    i := 2
    loop i <= n {
        acc = checked_mul(acc, i) ?? return None
        i = i + 1
    }
    Val(acc)
}

binomial: fn(n: Int, k: Int) -> Int? Never! {
    if n < 0 || k < 0 || k > n -> return None
    choose_k := k
    if choose_k > n - choose_k -> choose_k = n - choose_k
    acc := 1
    i := 1
    loop i <= choose_k {
        factor: n - choose_k + i
        acc = checked_mul(acc, factor) ?? return None
        acc = acc /% i
        i = i + 1
    }
    Val(acc)
}

comb: fn(n: Int, k: Int) -> Int? Never! { binomial(n, k) }

perm: fn(n: Int, k: Int) -> Int? Never! {
    if n < 0 || k < 0 || k > n -> return None
    acc := 1
    i := 0
    loop i < k {
        acc = checked_mul(acc, n - i) ?? return None
        i = i + 1
    }
    Val(acc)
}

gcd_many: fn(values: [Int]) -> Int Never! {
    acc := 0
    loop value in values -> acc = gcd(acc, value)
    acc
}

lcm_many: fn(values: [Int]) -> Int Never! {
    if values.len() == 0 -> return 0
    acc := values[0]
    i := 1
    loop i < values.len() {
        acc = lcm(acc, values[i])
        i = i + 1
    }
    acc
}

powmod: fn(base: Int, exponent: Int, modulus: Int) -> Int? Never! {
    if modulus <= 0 || exponent < 0 -> return None
    result := 1 %% modulus
    factor := base %% modulus
    if factor < 0 -> factor = factor + modulus
    power := exponent
    loop power > 0 {
        if ((power).bit_and(1)) != 0 {
            product: checked_mul(result, factor) ?? return None
            result = product %% modulus
        }
        power = power /% 2
        square: checked_mul(factor, factor) ?? return None
        factor = square %% modulus
    }
    Val(result)
}

div_mod: fn(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {
    rem := a %% b
    if rem < 0 {
        if b > 0 -> rem = rem + b
        if b < 0 -> rem = rem - b
    }
    (quot: (a - rem) /% b, rem: rem)
}

div_rem: fn(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {
    rem: a %% b
    (quot: (a - rem) /% b, rem: rem)
}

digits: fn(n: Int) -> Int Never! {
    value := abs(n)
    count := 1
    loop value >= 10 {
        value = value /% 10
        count = count + 1
    }
    count
}
leading_ones: fn(n: Int) -> Int Never! {
    count := 0
    loop count < 64 {
        if ((n >> (63 - count)).bit_and(1)) == 0 -> return count
        count = count + 1
    }
    count
}
trailing_ones: fn(n: Int) -> Int Never! {
    count := 0
    loop count < 64 {
        if ((n >> count).bit_and(1)) == 0 -> return count
        count = count + 1
    }
    count
}
cmp: fn(a: Float, b: Float) -> Int Never! {
    if a < b -> return -1
    if a > b -> return 1
    if a == b || (is_nan(a) && is_nan(b)) -> return 0
    if is_nan(a) -> return 1
    return -1
}
__cmp_f32: fn(a: F32, b: F32) -> Int Never! { cmp(Float.from_f32(a), Float.from_f32(b)) }

abs_diff: fn(a: Int, b: Int) -> Int Never! {
    if a >= b -> return a - b
    b - a
}

even: fn(n: Int) -> Bool Never! { is_even(n) }
odd: fn(n: Int) -> Bool Never! { is_odd(n) }
in_range: fn(value: Int, low: Int, high: Int) -> Bool Never! {
    value >= low && value < high
}

sum_int: fn(values: [Int]) -> Int Never! {
    acc := 0
    loop value in values -> acc = saturating_add(acc, value)
    acc
}

prod_int: fn(values: [Int]) -> Int Never! {
    acc := 1
    loop value in values -> acc = saturating_mul(acc, value)
    acc
}

prod: fn(values: [Int]) -> Int Never! { prod_int(values) }
fmod: fn(a: Float, b: Float) -> Float Never! { core.math.fmod(a, b) }
/// remainder.c from musl 1.2.5: rem_quo's remainder.
remainder: fn(a: Float, b: Float) -> Float Never! { rem_quo(a, b).rem }
/// remquo.c from musl 1.2.5: `a - n * b` for the integer n nearest a / b
/// (ties to even), found by exact long division of the significands, and
/// n's low 31 bits signed as a / b.
rem_quo: fn(a: Float, b: Float) -> (rem: Float, quo: Int) Never! {
    ux: to_bits(a).bit_and(18446744073709551615)
    uy: to_bits(b).bit_and(18446744073709551615)
    ex := (ux >> 52).bit_and(2047)
    ey := (uy >> 52).bit_and(2047)
    sx: ux >> 63 != 0
    sy: uy >> 63 != 0
    if is_nan(a) || is_nan(b) -> return (rem: __nan_pair(a, b), quo: 0)
    if uy.bit_and(9223372036854775807) == 0 || ex == 2047 -> return (rem: (a * b) / (a * b), quo: 0)
    if ux.bit_and(9223372036854775807) == 0 -> return (rem: a, quo: 0)
    uxi := __remquo_significand(ux, ex)
    uyi: __remquo_significand(uy, ey)
    if ex == 0 -> ex = __remquo_exponent(ux)
    if ey == 0 -> ey = __remquo_exponent(uy)
    q := 0
    if ex < ey - 1 -> return (rem: a, quo: 0)
    if ex >= ey {
        loop ex > ey {
            if uxi >= uyi {
                uxi = uxi - uyi
                q = q + 1
            }
            uxi = uxi << 1
            q = (q << 1).bit_and(4294967295)
            ex = ex - 1
        }
        if uxi >= uyi {
            uxi = uxi - uyi
            q = q + 1
        }
        if uxi == 0 {
            ex = -60
        } else {
            loop uxi < 4503599627370496 {
                uxi = uxi << 1
                ex = ex - 1
            }
        }
    }
    bits: if ex > 0 -> (uxi - 4503599627370496).bit_or(ex << 52) else -> uxi >> (1 - ex)
    x := from_bits(bits)
    y: fabs(b)
    if ex == ey || (ex + 1 == ey && (Float{2.0} * x > y || (Float{2.0} * x == y && q % 2 != 0))) {
        x = x - y
        q = q + 1
    }
    q = q.bit_and(2147483647)
    (rem: if sx -> -x else -> x, quo: if sx != sy -> -q else -> q)
}
// remquo.c: the significand of binary64 `bits` with its leading bit at bit
// 52, a subnormal's shifted up to it.
__remquo_significand: fn(bits: Int, biased: Int) -> Int Never! {
    if biased != 0 -> return bits.bit_and(4503599627370495).bit_or(4503599627370496)
    (bits << (1 - __remquo_exponent(bits))).bit_and(9007199254740991)
}
// remquo.c: a subnormal's exponent, counted down from 0 to its leading bit.
__remquo_exponent: fn(bits: Int) -> Int Never! {
    i := (bits << 12).bit_and(18446744073709551615)
    exponent := 0
    loop i < 9223372036854775808 {
        exponent = exponent - 1
        i = i << 1
    }
    exponent
}
isclose: fn(a: Float, b: Float, rel_tol: Float, abs_tol: Float) -> Bool Never! {
    if rel_tol < 0.0 || abs_tol < 0.0 -> return false
    if a == b -> return true
    if !is_finite(a) || !is_finite(b) -> return false
    fabs(a - b) <= max_float(rel_tol * max_float(fabs(a), fabs(b)), abs_tol)
}

dist: fn(left: [Float], right: [Float]) -> Float Never! {
    if left.len() != right.len() -> return NAN
    total := Float{0.0}
    loop i in 0..<left.len() {
        delta: left[i] - right[i]
        total = total + delta * delta
    }
    sqrt(total)
}

hypot3: fn(a: Float, b: Float, c: Float) -> Float Never! { hypot(hypot(a, b), c) }

clamp_float: fn(value: Float, low: Float, high: Float) -> Float Never! {
    if !(low <= high) -> panic("min > max, or either was NaN")
    if value < low -> return low
    if value > high -> return high
    value
}

/// fmin.c from musl 1.2.5: the lesser, a NaN only when both are, -0 below +0.
min_float: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return b
    if is_nan(b) -> return a
    if sign_bit(a) != sign_bit(b) -> return if sign_bit(a) -> a else -> b
    if a < b -> return a
    b
}
/// fmax.c from musl 1.2.5: the greater, a NaN only when both are, +0 above -0.
max_float: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return b
    if is_nan(b) -> return a
    if sign_bit(a) != sign_bit(b) -> return if sign_bit(a) -> b else -> a
    if a < b -> return b
    a
}
midpoint: fn(a: Float, b: Float) -> Float Never! { a + (b - a) * 0.5 }

fsum: fn(values: [Float]) -> Float Never! {
    total := Float{0.0}
    compensation := Float{0.0}
    loop value in values {
        corrected: value - compensation
        next_total: total + corrected
        compensation = (next_total - total) - corrected
        total = next_total
    }
    total
}

sumprod: fn(left: [Float], right: [Float]) -> Float Never! {
    total := Float{0.0}
    n := left.len()
    if right.len() < n -> n = right.len()
    loop i in 0..<n -> total = total + left[i] * right[i]
    total
}

random: fn() -[Rand]> Float Never! {
    approx(ambient_random.__word()) / 18446744073709551616.0
}

fraction: fn(numerator: Int, denominator: Int) -> Fraction? Never! {
    __fraction_new(numerator, denominator)
}

decimal: fn(text: String) -> Decimal Never! {
    __decimal_from_str(text)
}

copy: fn(n: Float) -> Float Never! { n }

/// The direction `round_to_signed` and `round_to_unsigned` round in: an
/// IEEE 754 rounding direction, or ties away from zero or to even.
Rounding: enum {
    TowardNegative
    TowardPositive
    TowardZero
    TiesToAway
    TiesToEven
}

/// The integral Float nearest `n`, ties to the even one (C23 roundeven); an
/// infinity, a NaN or a whole `n` is itself, and the sign of zero is kept.
round_even: fn(n: Float) -> Float Never! {
    if !(fabs(n) < Float{4503599627370496.0}) -> return n
    whole: trunc(n)
    distance: fabs(n - whole)
    if (distance > Float{0.5} || (distance == Float{0.5} && fmod(whole, Float{2.0}) != Float{0.0})) -> return whole + copysign(Float{1.0}, n)
    whole
}
// The integral Float nearest `n`, ties away from zero (C round).
__round_away: fn(n: Float) -> Float Never! {
    if !(fabs(n) < Float{4503599627370496.0}) -> return n
    whole: trunc(n)
    if (fabs(n - whole) >= Float{0.5}) -> return whole + copysign(Float{1.0}, n)
    whole
}
// `n` rounded to an integral Float in `mode`.
__rounded: fn(n: Float, mode: Rounding) -> Float Never! {
    if mode == {
        .TowardNegative -> floor(n)
        .TowardPositive -> ceil(n)
        .TowardZero -> trunc(n)
        .TiesToAway -> __round_away(n)
        .TiesToEven -> round_even(n)
    }
}
/// `n` rounded in `mode` to an integer that fits a two's-complement integer
/// of `bits` bits (C23 fromfp, with widths above 64 read as 64); None for an
/// infinity, a NaN, `bits` below 1 or a rounded value outside the width.
round_to_signed: fn(n: Float, mode: Rounding, bits: Int) -> Int? Never! {
    if !is_finite(n) || bits < 1 -> return None
    width: min(bits, 64)
    whole: __rounded(n, mode)
    limit: ldexp(Float{1.0}, width - 1)
    if whole < -limit || whole >= limit -> return None
    Val(Int.from_float(whole) ?? 0)
}
/// `n` rounded in `mode` to an integer that fits an unsigned integer of
/// `bits` bits (C23 ufromfp, with widths above 64 read as 64); None for an
/// infinity, a NaN, `bits` below 1 or a rounded value outside the width.
round_to_unsigned: fn(n: Float, mode: Rounding, bits: Int) -> Int? Never! {
    if !is_finite(n) || bits < 1 -> return None
    width: min(bits, 64)
    whole: __rounded(n, mode)
    if (whole < Float{0.0} || whole >= ldexp(Float{1.0}, width)) -> return None
    // An Int conversion of a whole value above 2^63 halves exactly first.
    if (whole >= Float{9223372036854775808.0}) -> return Val((Int.from_float(whole * Float{0.5}) ?? 0) * 2)
    Val(Int.from_float(whole) ?? 0)
}

/// fdim.c from musl 1.2.5: `a - b` when `a` is greater, else +0; a NaN
/// operand is the result.
fdim: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return a
    if is_nan(b) -> return b
    if a > b -> return a - b
    Float{0.0}
}

/// IEEE 754-2019 maximum (C23 fmaximum): the greater, +0 above -0, and a NaN
/// when either operand is one.
maximum: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) || is_nan(b) -> return __nan_pair(a, b)
    if a > b -> return a
    if b > a -> return b
    if sign_bit(a) -> return b
    a
}
/// IEEE 754-2019 minimum (C23 fminimum): the lesser, -0 below +0, and a NaN
/// when either operand is one.
minimum: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) || is_nan(b) -> return __nan_pair(a, b)
    if a < b -> return a
    if b < a -> return b
    if sign_bit(a) -> return a
    b
}
/// IEEE 754-2019 maximumMagnitude (C23 fmaximum_mag): the operand of greater
/// magnitude, `maximum` of equal ones, and a NaN when either operand is one.
maximum_mag: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) || is_nan(b) -> return __nan_pair(a, b)
    if fabs(a) > fabs(b) -> return a
    if fabs(b) > fabs(a) -> return b
    maximum(a, b)
}
/// IEEE 754-2019 minimumMagnitude (C23 fminimum_mag): the operand of lesser
/// magnitude, `minimum` of equal ones, and a NaN when either operand is one.
minimum_mag: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) || is_nan(b) -> return __nan_pair(a, b)
    if fabs(a) < fabs(b) -> return a
    if fabs(b) < fabs(a) -> return b
    minimum(a, b)
}
/// IEEE 754-2019 maximumNumber (C23 fmaximum_num): `maximum` of the numbers
/// among the operands, a NaN only when both are.
maximum_num: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return if is_nan(b) -> __nan_pair(a, b) else -> b
    if is_nan(b) -> return a
    maximum(a, b)
}
/// IEEE 754-2019 minimumNumber (C23 fminimum_num): `minimum` of the numbers
/// among the operands, a NaN only when both are.
minimum_num: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return if is_nan(b) -> __nan_pair(a, b) else -> b
    if is_nan(b) -> return a
    minimum(a, b)
}
/// IEEE 754-2019 maximumMagnitudeNumber (C23 fmaximum_mag_num):
/// `maximum_mag` of the numbers among the operands, a NaN only when both are.
maximum_mag_num: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return if is_nan(b) -> __nan_pair(a, b) else -> b
    if is_nan(b) -> return a
    maximum_mag(a, b)
}
/// IEEE 754-2019 minimumMagnitudeNumber (C23 fminimum_mag_num):
/// `minimum_mag` of the numbers among the operands, a NaN only when both are.
minimum_mag_num: fn(a: Float, b: Float) -> Float Never! {
    if is_nan(a) -> return if is_nan(b) -> __nan_pair(a, b) else -> b
    if is_nan(b) -> return a
    minimum_mag(a, b)
}

// The bits of `n` as a signed Int that orders as IEEE 754 totalOrder: a
// negative pattern's magnitude bits flip, so -NaN < -inf < ... < -0 < +0.
__total_order_key: fn(n: Float) -> Int Never! {
    bits: to_bits(n)
    if bits < 0 -> return bits.bit_xor(9223372036854775807)
    bits
}
/// IEEE 754 totalOrder (C23 totalorder): whether `a` sorts at or before `b`
/// when -0 precedes +0 and NaNs sort by sign and payload beyond the
/// infinities.
total_order: fn(a: Float, b: Float) -> Bool Never! { __total_order_key(a) <= __total_order_key(b) }
/// IEEE 754 totalOrderMag (C23 totalordermag): `total_order` of the
/// magnitudes.
total_order_mag: fn(a: Float, b: Float) -> Bool Never! {
    to_bits(a).bit_and(9223372036854775807) <= to_bits(b).bit_and(9223372036854775807)
}

/// Whether `n` is a signaling NaN: a NaN whose quiet bit is clear.
is_signaling: fn(n: Float) -> Bool Never! {
    bits: to_bits(n).bit_and(9223372036854775807)
    bits > 9218868437227405312 && bits < 9221120237041090560
}
/// `n` in canonical form (C23 canonicalize): a signaling NaN becomes the
/// quiet NaN of the same sign and payload; anything else is itself.
canonicalize: fn(n: Float) -> Float Never! {
    if is_signaling(n) -> return from_bits(to_bits(n).bit_or(2251799813685248))
    n
}
// x86-64's result for an arithmetic operation on `a` and `b` when either is
// a NaN: the first NaN operand, quieted. musl's `x + y` and `x * y` NaN
// returns are this. Wasm leaves the choice open (V8 may commute the
// operands), so naming it keeps every tier's bits the same.
__nan_pair: fn(a: Float, b: Float) -> Float Never! { canonicalize(if is_nan(a) -> a else -> b) }
/// The payload of NaN `n` as an integral Float (C23 getpayload): its fraction
/// bits below the quiet bit; None when `n` is not a NaN.
get_payload: fn(n: Float) -> Float? Never! {
    if !is_nan(n) -> return None
    Val(Float{to_bits(n).bit_and(2251799813685247)})
}
/// The positive quiet NaN whose payload is `payload` (C23 setpayload); None
/// unless `payload` is +0 or a whole number below 2^51.
set_payload: fn(payload: Float) -> Float? Never! {
    bits: __payload_bits(payload) ?? return None
    Val(from_bits(bits.bit_or(9221120237041090560)))
}
/// The positive signaling NaN whose payload is `payload` (C23
/// setpayloadsig); None unless `payload` is a whole number in 1..<2^51.
set_payload_signaling: fn(payload: Float) -> Float? Never! {
    bits: __payload_bits(payload) ?? return None
    if bits == 0 -> return None
    Val(from_bits(bits.bit_or(9218868437227405312)))
}
// A payload Float's integer, when it is +0 or whole and below 2^51.
__payload_bits: fn(payload: Float) -> Int? Never! {
    if sign_bit(payload) || !(payload < Float{2251799813685248.0}) || trunc(payload) != payload -> return None
    Val(Int.from_float(payload) ?? 0)
}

#Test("math scalar composition preserves IEEE boundaries") {
    assert(is_nan(NAN))
    assert(is_inf(INFINITY))
    assert(!is_finite(NAN))
    assert(is_normal(1.0))
    assert(is_subnormal(from_bits(1)))
    assert(sign_bit(-0.0))
    assert_eq(to_bits(fabs(-0.0)), 0)
    assert_eq(signum(-0.0), -1.0)
    assert_eq(cmp(NAN, 1.0), 1)
    assert_eq(cmp(1.0, NAN), -1)
    assert_eq(cmp(NAN, NAN), 0)
    assert_eq(__cmp_f32(F32{-0.0}, F32{0.0}), 0)
    assert_eq(__cmp_f32(F32{NAN}, F32{1.0}), 1)
    assert(__is_finite_f32(F32{1.0}))
    assert(!__is_finite_f32(F32{INFINITY}))
    assert_eq(__to_bits_f32(F32{16777217.0}), 1266679808)
    assert_eq(__to_bits_f32(F32{-0.0}), 2147483648)
    assert_eq(__to_bits_f32(F32{1.0}), 1065353216)
    assert_eq(__to_bits_f32(F32{INFINITY}), 2139095040)
    assert_eq(__to_bits_f32(F32{from_bits(1)}), 0)
    assert_eq(__to_bits_f32(F32{Float{1.0e-40}}), 71362)
    // A payload NaN, a signaling NaN of either sign, the smallest and the
    // largest subnormal, a normal and -inf round-trip their bits exactly.
    loop bits in ([Int]{2143363909, 2139095041, 4286578689, 1, 8388607, 1065353217, 4286578688}) {
        assert_eq(__to_bits_f32(__from_bits_f32(bits)), bits)
    }
    assert(is_nan(Float.from_f32(__from_bits_f32(2139095041))))
    assert_eq(Float.from_f32(__from_bits_f32(1)), from_bits(3936146074321813504))
    assert_eq(radix(0.0), 2)
}

#Test("math rounding uses ties away from zero and saturating native conversion") {
    assert_eq(round(1.5), 2)
    assert_eq(round(-1.5), -2)
    assert_eq(round(0.49999999999999994), 0)
    assert_eq(round(NAN), 0)
    assert_eq(round(INFINITY), 9223372036854775807)
    assert_eq(round(-INFINITY), -9223372036854775808)
}

#Test("math adjacent values and exponent decomposition") {
    assert_eq(to_bits(next_up(0.0)), 1)
    assert_eq(to_bits(next_down(0.0)), -9223372036854775807)
    assert_eq(to_bits(next_after(1.0, 2.0)), to_bits(1.0) + 1)
    assert_eq(next_up(INFINITY), INFINITY)
    assert_eq(ulp(0.0), from_bits(1))
    assert_eq(significand(6.0), 1.5)
    assert_eq(ilogb(8.0) ?? -1, 3)
    assert(ilogb(0.0) == None)
    assert_eq(ldexp(1.5, 2), 6.0)
    pair: frexp(6.0)
    assert_eq(pair.exp, 3)
    assert_eq(pair.frac, 0.75)
    tiny: frexp(from_bits(1))
    assert_eq(tiny.exp, -1073)
    assert_eq(tiny.frac, 0.5)
    assert_eq(frexp(INFINITY).exp, 0)
    assert_eq(logb(from_bits(1)), -1074.0)
    assert_eq(logb(0.0), -INFINITY)
    assert_eq(ldexp(1.5, -1074), from_bits(2))
    assert_eq(ldexp(from_bits(1), 1074), 1.0)
    assert_eq(ldexp(1.0, 2000), INFINITY)
    split: modf(-INFINITY)
    assert(sign_bit(split.fract) && split.fract == 0.0 && split.whole == -INFINITY)
    assert_eq(to_bits(next_after(-0.0, 1.0)), 1)
    assert_eq(to_bits(next_after(0.0, -0.0)), to_bits(-0.0))
}

#Test("math C23 exact operations follow IEEE 754-2019") {
    assert_eq(round_even(2.5), 2.0)
    assert_eq(round_even(3.5), 4.0)
    assert_eq(round_even(-2.5), -2.0)
    assert(sign_bit(round_even(-0.25)))
    assert_eq(round_even(4503599627370497.0), 4503599627370497.0)
    assert_eq(round_to_signed(2.5, Rounding.TiesToEven, 8), Val(2))
    assert_eq(round_to_signed(2.5, Rounding.TiesToAway, 8), Val(3))
    assert_eq(round_to_signed(-2.5, Rounding.TowardNegative, 8), Val(-3))
    assert_eq(round_to_signed(-2.5, Rounding.TowardPositive, 8), Val(-2))
    assert_eq(round_to_signed(-2.7, Rounding.TowardZero, 8), Val(-2))
    assert_eq(round_to_signed(127.4, Rounding.TiesToEven, 8), Val(127))
    assert(round_to_signed(127.6, Rounding.TiesToEven, 8) == None)
    assert_eq(round_to_signed(-128.4, Rounding.TiesToEven, 8), Val(-128))
    assert(round_to_signed(-128.6, Rounding.TiesToEven, 8) == None)
    assert(round_to_signed(NAN, Rounding.TowardNegative, 8) == None)
    assert(round_to_signed(1.0, Rounding.TowardNegative, 0) == None)
    assert_eq(round_to_signed(-9223372036854775808.0, Rounding.TowardNegative, 64), Val(-9223372036854775807 - 1))
    assert(round_to_signed(9223372036854775808.0, Rounding.TowardNegative, 100) == None)
    assert_eq(round_to_unsigned(255.4, Rounding.TiesToEven, 8), Val(255))
    assert(round_to_unsigned(255.6, Rounding.TiesToEven, 8) == None)
    assert_eq(round_to_unsigned(-0.4, Rounding.TiesToEven, 8), Val(0))
    assert(round_to_unsigned(-0.6, Rounding.TiesToEven, 8) == None)
    assert_eq(round_to_unsigned(-0.6, Rounding.TowardPositive, 8), Val(0))
    assert_eq(round_to_unsigned(18446744073709549568.0, Rounding.TowardZero, 64), Val(18446744073709549568))
    assert(round_to_unsigned(18446744073709551616.0, Rounding.TowardZero, 64) == None)
    assert(!sign_bit(maximum(-0.0, 0.0)) && !sign_bit(maximum(0.0, -0.0)))
    assert(sign_bit(minimum(-0.0, 0.0)) && sign_bit(minimum(0.0, -0.0)))
    assert(is_nan(maximum(NAN, 1.0)) && is_nan(minimum(1.0, NAN)))
    assert_eq(maximum_num(NAN, 1.0), 1.0)
    assert_eq(minimum_num(1.0, NAN), 1.0)
    assert(is_nan(maximum_num(NAN, NAN)))
    assert_eq(maximum_mag(-3.0, 2.0), -3.0)
    assert_eq(minimum_mag(-3.0, 2.0), 2.0)
    assert_eq(maximum_mag(-2.0, 2.0), 2.0)
    assert_eq(minimum_mag(-2.0, 2.0), -2.0)
    assert(is_nan(maximum_mag(NAN, 1.0)))
    assert_eq(maximum_mag_num(NAN, -3.0), -3.0)
    assert_eq(minimum_mag_num(-3.0, NAN), -3.0)
    signaling: from_bits(9218868437227405313)
    quiet: from_bits(9221120237041090560)
    negative_quiet: from_bits(-2251799813685248)
    assert(total_order(-0.0, 0.0) && !total_order(0.0, -0.0))
    assert(total_order(INFINITY, quiet) && !total_order(quiet, INFINITY))
    assert(total_order(negative_quiet, -INFINITY) && total_order(signaling, quiet))
    assert(total_order(1.0, 1.0))
    assert(total_order_mag(-1.0, 2.0) && !total_order_mag(-3.0, 2.0))
    assert(total_order_mag(-0.0, 0.0) && total_order_mag(0.0, -0.0))
    assert(is_signaling(signaling) && !is_signaling(quiet) && !is_signaling(INFINITY) && !is_signaling(1.0))
    assert_eq(to_bits(canonicalize(signaling)), 9221120237041090561)
    assert_eq(canonicalize(1.5), 1.5)
    assert(sign_bit(canonicalize(-0.0)))
    assert_eq(get_payload(from_bits(9221120237041090565)), Val(5.0))
    assert_eq(get_payload(signaling), Val(1.0))
    assert(get_payload(1.0) == None)
    assert_eq(to_bits(set_payload(5.0) ?? 0.0), 9221120237041090565)
    assert_eq(to_bits(set_payload(0.0) ?? 0.0), 9221120237041090560)
    assert(set_payload(-1.0) == None && set_payload(-0.0) == None && set_payload(0.5) == None)
    assert(set_payload(2251799813685248.0) == None && set_payload(NAN) == None)
    assert_eq(to_bits(set_payload_signaling(1.0) ?? 0.0), 9218868437227405313)
    assert(set_payload_signaling(0.0) == None)
    split: rem_quo(7.0, -2.0)
    assert_eq(split.rem, -1.0)
    assert_eq(split.quo, -4)
    assert_eq(fdim(5.0, 3.0), 2.0)
    assert_eq(fdim(3.0, 5.0), 0.0)
    assert(is_nan(fdim(NAN, 1.0)))
}

#Test("math remainder and distance retain their validation") {
    assert_eq(remainder(7.0, 2.0), -1.0)
    assert_eq(remainder(5.0, 2.0), 1.0)
    assert(is_nan(remainder(1.0, 0.0)))
    assert(isclose(INFINITY, INFINITY, 0.0, 0.0))
    assert(!isclose(1.0, 1.0, -1.0, 0.0))
    assert_eq(dist([Float]{0.0, 0.0}, [Float]{3.0, 4.0}), 5.0)
    assert(is_nan(dist([Float]{1.0}, [Float]{})))
    assert_eq(digits(-9223372036854775808), 19)
    assert_eq(digits(-99), 2)
    assert_eq(digits(0), 1)
    assert_eq(leading_ones(-1), 64)
    assert_eq(trailing_ones(-1), 64)
    assert_eq((Int{3}).bit_xor(5), 6)
}

#Test("math rsqrt is correctly rounded and exp10 matches musl") {
    assert_eq(rsqrt(4.0), 0.5)
    assert_eq(rsqrt(0.0), INFINITY)
    assert_eq(rsqrt(-0.0), -INFINITY)
    assert_eq(to_bits(rsqrt(INFINITY)), 0)
    assert(is_nan(rsqrt(-1.0)))
    assert(is_nan(rsqrt(NAN)))
    assert_eq(to_bits(rsqrt(2.0)), 4604544271217802189)
    // A CORE-MATH worst case, and the smallest subnormal (2^537).
    assert_eq(to_bits(rsqrt(from_bits(4610114390058515662))), 4605185130452627605)
    assert_eq(to_bits(rsqrt(from_bits(1))), 7025615418697973760)
    assert_eq(exp10(2.0), 100.0)
    assert_eq(exp10(-3.0), 0.001)
    assert_eq(exp10(INFINITY), INFINITY)
    assert_eq(exp10(-INFINITY), 0.0)
    assert(is_nan(exp10(NAN)))
    assert_eq(to_bits(exp10(0.5)), 4614303235046005586)
    // musl's own result at its worst input, 4 ulps from 10^x.
    assert_eq(to_bits(exp10(from_bits(-4598200772700550838))), 4368491250563624223)
}

#Test("math sin_pi cos_pi and tan_pi are correctly rounded") {
    assert_eq(to_bits(sin_pi(-0.0)), to_bits(-0.0))
    assert_eq(to_bits(sin_pi(1.0)), 0)
    assert_eq(to_bits(sin_pi(-2.0)), to_bits(-0.0))
    assert_eq(sin_pi(-0.5), -1.0)
    assert_eq(to_bits(sin_pi(0.25)), 4604544271217802189)
    assert(is_nan(sin_pi(INFINITY)))
    assert_eq(cos_pi(1.0), -1.0)
    assert_eq(to_bits(cos_pi(-1.5)), 0)
    assert_eq(cos_pi(1152921504606846976.0), 1.0)
    assert(is_nan(cos_pi(-INFINITY)))
    assert_eq(to_bits(tan_pi(1.0)), to_bits(-0.0))
    assert_eq(to_bits(tan_pi(-1.0)), 0)
    assert_eq(tan_pi(0.5), INFINITY)
    assert_eq(tan_pi(-0.5), -INFINITY)
    assert_eq(tan_pi(1.5), -INFINITY)
    assert_eq(tan_pi(-0.75), 1.0)
    assert(is_nan(tan_pi(NAN)))
    // CORE-MATH hard cases, and a subnormal x.
    assert_eq(to_bits(sin_pi(from_bits(4395891070298091049))), 4403180974300602922)
    assert_eq(to_bits(sin_pi(from_bits(4642176498684705821))), 4606812274292659608)
    assert_eq(to_bits(cos_pi(from_bits(4504997151097359015))), 4607182418800016324)
    assert_eq(to_bits(tan_pi(from_bits(4407730924795980279))), 4415082666414721775)
    assert_eq(to_bits(tan_pi(from_bits(4665355407666552457))), 4590372015398588693)
    assert_eq(to_bits(sin_pi(from_bits(1))), 3)
}

#Test("math atan_pi asin_pi acos_pi and atan2_pi are correctly rounded") {
    assert_eq(to_bits(atan_pi(-0.0)), to_bits(-0.0))
    assert_eq(atan_pi(1.0), 0.25)
    assert_eq(atan_pi(-INFINITY), -0.5)
    assert(is_nan(atan_pi(NAN)))
    assert_eq(asin_pi(-1.0), -0.5)
    assert_eq(to_bits(asin_pi(0.5)), 4595172819793696085)
    assert(is_nan(asin_pi(1.5)))
    assert_eq(to_bits(acos_pi(1.0)), 0)
    assert_eq(acos_pi(-1.0), 1.0)
    assert_eq(acos_pi(0.0), 0.5)
    assert_eq(to_bits(acos_pi(0.5)), 4599676419421066581)
    assert(is_nan(acos_pi(-2.0)))
    assert_eq(atan2_pi(0.0, -0.0), 1.0)
    assert_eq(atan2_pi(-0.0, -1.0), -1.0)
    assert_eq(to_bits(atan2_pi(-0.0, 0.0)), to_bits(-0.0))
    assert_eq(atan2_pi(-3.0, 0.0), -0.5)
    assert_eq(atan2_pi(-INFINITY, -INFINITY), -0.75)
    assert_eq(atan2_pi(2.0, -INFINITY), 1.0)
    assert_eq(to_bits(atan2_pi(-2.0, INFINITY)), to_bits(-0.0))
    assert_eq(atan2_pi(-2.0, -2.0), -0.75)
    assert(is_nan(atan2_pi(1.0, NAN)))
    // CORE-MATH hard cases, subnormal arguments and a subnormal result.
    assert_eq(to_bits(atan_pi(from_bits(680858217096071))), 216723901591149)
    assert_eq(to_bits(atan_pi(from_bits(4782349007629104709))), 4602678819172635902)
    assert_eq(to_bits(asin_pi(from_bits(285783798826148))), 90967808477522)
    assert_eq(to_bits(asin_pi(from_bits(4541628092410130775))), 4534397843049511498)
    assert_eq(to_bits(acos_pi(from_bits(4366558677046668669))), 4602678819172646911)
    assert_eq(to_bits(acos_pi(from_bits(4450985882809810338))), 4602678819172427056)
    assert_eq(to_bits(atan2_pi(from_bits(4752955398285935993), from_bits(-4377330597561286194))), 4607182416996996294)
    assert_eq(to_bits(atan2_pi(from_bits(4878408227249931555), from_bits(-4377103036804331144))), 4602698723339557068)
    assert_eq(to_bits(atan2_pi(1.0, from_bits(9218868437227405311))), 358385071201416)
}

#Test("math exp2_m1 and exp10_m1 are correctly rounded") {
    assert_eq(to_bits(exp2_m1(-0.0)), to_bits(-0.0))
    assert_eq(exp2_m1(1.0), 1.0)
    assert_eq(exp2_m1(-1.0), -0.5)
    assert_eq(exp2_m1(53.0), 9007199254740991.0)
    assert_eq(exp2_m1(-60.0), -1.0)
    assert_eq(exp2_m1(-INFINITY), -1.0)
    assert_eq(exp2_m1(1024.0), INFINITY)
    assert(is_nan(exp2_m1(NAN)))
    assert_eq(to_bits(exp2_m1(0.5)), 4601133428098527026)
    assert_eq(to_bits(exp10_m1(-0.0)), to_bits(-0.0))
    assert_eq(exp10_m1(2.0), 99.0)
    assert_eq(exp10_m1(15.0), 999999999999999.0)
    assert_eq(exp10_m1(-1.0), -0.9)
    assert_eq(exp10_m1(-20.0), -1.0)
    assert_eq(exp10_m1(309.0), INFINITY)
    assert(is_nan(exp10_m1(NAN)))
    assert_eq(to_bits(exp10_m1(0.5)), 4612051435232320339)
    // CORE-MATH hard cases, subnormal arguments and the fast path's misses.
    assert_eq(to_bits(exp2_m1(from_bits(1))), 1)
    assert_eq(to_bits(exp2_m1(from_bits(-4865551698031115683))), -4867804948596339579)
    assert_eq(to_bits(exp2_m1(from_bits(4592909171902919587))), 4590611977400612091)
    assert_eq(to_bits(exp2_m1(from_bits(4634202865296434871))), 4895361867596065469)
    assert_eq(to_bits(exp2_m1(from_bits(-4612352158977410970))), -4618684534485185013)
    assert_eq(to_bits(exp10_m1(from_bits(148190067766332))), 341220240968533)
    assert_eq(to_bits(exp10_m1(from_bits(-9223026260029987700))), -9222575856292515897)
    assert_eq(to_bits(exp10_m1(from_bits(4642329645483511056))), 8062042634838959287)
    assert_eq(to_bits(exp10_m1(from_bits(4588740663914655215))), 4594461513243737592)
    assert_eq(to_bits(exp10_m1(from_bits(-4863972193747803283))), -4858751334356899146)
    assert_eq(to_bits(exp10_m1(from_bits(-4601441329427016830))), -4616189618055329045)
}

#Test("math log2_1p and log10_1p are correctly rounded") {
    assert_eq(to_bits(log2_1p(-0.0)), to_bits(-0.0))
    assert_eq(log2_1p(1.0), 1.0)
    assert_eq(log2_1p(9007199254740991.0), 53.0)
    assert_eq(log2_1p(-0.75), -2.0)
    assert_eq(log2_1p(1152921504606846976.0), 60.0)
    assert_eq(log2_1p(-1.0), -INFINITY)
    assert_eq(log2_1p(INFINITY), INFINITY)
    assert(is_nan(log2_1p(-2.0)))
    assert(is_nan(log2_1p(NAN)))
    assert_eq(to_bits(log10_1p(-0.0)), to_bits(-0.0))
    assert_eq(log10_1p(9.0), 1.0)
    assert_eq(log10_1p(999999999999999.0), 15.0)
    assert_eq(log10_1p(-1.0), -INFINITY)
    assert_eq(log10_1p(INFINITY), INFINITY)
    assert(is_nan(log10_1p(-1.5)))
    assert(is_nan(log10_1p(NAN)))
    // Each accurate path: the 128-bit floats, the |x| < 2^-5 polynomial,
    // its hard cases, and the tiny product with its one exception.
    assert_eq(to_bits(log2_1p(from_bits(-4621061171219588020))), -4616709906547599607)
    assert_eq(to_bits(log2_1p(from_bits(-4642082605198259385))), -4639508814641984101)
    assert_eq(to_bits(log2_1p(from_bits(-4645025225609036188))), -4642493380846808603)
    assert_eq(to_bits(log2_1p(from_bits(4503599627370496))), 6497320848556798)
    assert_eq(to_bits(log2_1p(from_bits(777451915729368))), 1121626023352383)
    assert_eq(to_bits(log10_1p(from_bits(6285590920284994944))), 4637596414123282161)
    assert_eq(to_bits(log10_1p(from_bits(4114038128211098081))), 4108646811809616641)
    assert_eq(to_bits(log10_1p(from_bits(-4639263655811884328))), -4644768064034318774)
    assert_eq(to_bits(log10_1p(from_bits(4503599627370496))), 1955888466868548)
    assert_eq(log10_1p(8.795571893350569e229), 229.94426408279878)
}

#Test("math pow_n and pow_r are correctly rounded") {
    assert_eq(pow_n(3.0, 5), 243.0)
    assert_eq(pow_n(-2.0, -3), -0.125)
    assert_eq(pow_n(NAN, 0), 1.0)
    assert_eq(to_bits(pow_n(-0.0, 3)), to_bits(-0.0))
    assert_eq(pow_n(-0.0, -2), INFINITY)
    assert_eq(pow_n(-INFINITY, -3), -0.0)
    assert(is_nan(pow_n(NAN, 1)))
    // A midpoint ties to even; 2^-1075 is the midpoint of 0 and 2^-1074.
    assert_eq(pow_n(94906267.0, 2), 9007199515875288.0)
    assert_eq(to_bits(pow_n(-0.03125, 215)), to_bits(-0.0))
    assert_eq(pow_n(0.25, 537), 5e-324)
    // Exponents past 2^53 are taken exactly.
    assert_eq(pow_n(1.0, 4611686018427387905), 1.0)
    assert_eq(to_bits(pow_n(from_bits(-4616189618054758372), -93702007578077696)), 821658989560790850)
    assert_eq(to_bits(pow_n(from_bits(4607182418800017407), -3360544418716710911)), 7031019058405545140)
    assert_eq(pow_r(2.0, 0.5), 1.4142135623730951)
    assert_eq(pow_r(94906267.0, 2.0), 9007199515875288.0)
    assert_eq(pow_r(0.0, -1.0), INFINITY)
    assert_eq(pow_r(INFINITY, -2.0), 0.0)
    assert_eq(pow_r(1.0, 1e300), 1.0)
    assert_eq(pow_r(0.5, INFINITY), 0.0)
    assert(is_nan(pow_r(-8.0, 3.0)))
    assert(is_nan(pow_r(0.0, 0.0)))
    assert(is_nan(pow_r(INFINITY, 0.0)))
    assert(is_nan(pow_r(1.0, INFINITY)))
    assert(is_nan(pow_r(1.0, NAN)))
    // CORE-MATH pow.wc worst cases, one subnormal
    assert_eq(to_bits(pow_r(from_bits(4835813121993211188), 0.3125)), 4678529498034705970)
    assert_eq(to_bits(pow_r(from_bits(3138866179343064177), from_bits(4614256656552045848))), 958906342421917)
}

#Test("math root_n and compound_n are correctly rounded") {
    assert_eq(root_n(-8.0, 3), -2.0)
    assert_eq(root_n(16.0, -4), 0.5)
    assert_eq(root_n(2.0, 3), 1.2599210498948732)
    assert_eq(root_n(2.0, -3), 0.7937005259840998)
    assert_eq(root_n(10.0, 5), 1.5848931924611134)
    assert_eq(root_n(1e-310, -9), 2.7825594022071255e34)
    assert_eq(root_n(3.0, 1000000), 1.0000010986128922)
    assert_eq(root_n(3.0, 9223372036854775807), 1.0)
    assert_eq(to_bits(root_n(-0.0, 2)), to_bits(0.0))
    assert_eq(root_n(-0.0, -3), -INFINITY)
    assert_eq(root_n(INFINITY, -2), 0.0)
    assert(is_nan(root_n(-8.0, 2)))
    assert(is_nan(root_n(2.0, 0)))
    assert(is_nan(root_n(NAN, 3)))
    // a CORE-MATH cbrt.wc worst case
    assert_eq(to_bits(root_n(from_bits(4615315874094516424), -3)), 4604045713815548866)
    assert_eq(compound_n(0.5, 2), 2.25)
    assert_eq(compound_n(-0.5, -3), 8.0)
    assert_eq(compound_n(0.1, 10), 2.5937424601)
    assert_eq(compound_n(1e-10, -1), 0.9999999999)
    assert_eq(compound_n(1e-300, 3), 1.0)
    assert_eq(compound_n(8.673617379884035e-19, 1152921504606846976), 2.718281828459045)
    assert_eq(to_bits(compound_n(8.470329472543003e-22, -4611686018427387904)), 4607147303058014140)
    assert_eq(compound_n(1e300, 2), INFINITY)
    assert_eq(compound_n(NAN, 0), 1.0)
    assert_eq(compound_n(-1.0, -1), INFINITY)
    assert_eq(compound_n(-1.0, 2), 0.0)
    assert_eq(compound_n(INFINITY, -1), 0.0)
    assert(is_nan(compound_n(-2.0, 0)))
    assert(is_nan(compound_n(NAN, 1)))
    // a CORE-MATH log1p.wc worst case
    assert_eq(to_bits(compound_n(from_bits(-4717333287328040252), 4)), 4607182412178923782)
}

#Test("math special functions match musl") {
    assert_eq(erf(INFINITY), 1.0)
    assert_eq(erf(-INFINITY), -1.0)
    assert_eq(to_bits(erf(1.0)), 4605765593499502731)
    assert_eq(to_bits(erfc(1.0)), 4594835321492594133)
    assert_eq(gamma(0.0), INFINITY)
    assert(is_nan(gamma(-1.0)))
    assert_eq(gamma(5.0), 24.0)
    assert_eq(to_bits(gamma(0.5)), to_bits(sqrt(PI)))
    assert_eq(lgamma(1.0), 0.0)
    assert_eq(to_bits(lgamma(-0.5)), 4608378179100405206)
}

// Keep fixed-size lane storage and ordered scalar arithmetic.
// The native carrier adapters are bootstrap paths, not the source policy.
Vec2: struct {
    lanes: [Float#2]
}
impl Vec2 {
    new: fn(x: Float, y: Float) -> Vec2 Never! {
        Vec2{lanes: [Float#2]{x, y}}
    }
    splat: fn(x: Float) -> Vec2 Never! { Vec2.new(x, x) }
    from_array: fn(lanes: [Float#2]) -> Vec2 Never! { Vec2{lanes: lanes} }
    to_array: fn(self) -> [Float#2] Never! { self.lanes.copy() }
    lane: fn(self, index: Int) -> Float Never! {
        if index < 0 || index >= 2 -> core.math.__numeric_stop("lane index {index} out of range for Vec2 (2 lanes)")
        self.lanes[index]
    }
    // A swizzle read (`v.zyx`) is the vector of the lanes it names.
    __swizzle2: fn(self, a: Int, b: Int) -> Vec2 Never! { Vec2.new(self.lanes[a], self.lanes[b]) }
    __swizzle3: fn(self, a: Int, b: Int, c: Int) -> Vec3 Never! { Vec3.new(self.lanes[a], self.lanes[b], self.lanes[c]) }
    __swizzle4: fn(self, a: Int, b: Int, c: Int, d: Int) -> Vec4 Never! { Vec4.new(self.lanes[a], self.lanes[b], self.lanes[c], self.lanes[d]) }
    // A swizzle write (`v.yx = w`) stores each lane it names from the value.
    __swizzle_set1: fn(&self, a: Int, value: Float) Never! { self.lanes[a] = value }
    __swizzle_set2: fn(&self, a: Int, b: Int, value: Vec2) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
    }
    dot: fn(self, other: Vec2) -> Float Never! {
        self.lanes[0] * other.lanes[0] + self.lanes[1] * other.lanes[1]
    }
    length: fn(self) -> Float Never! { sqrt(self.dot(self)) }
    normalize: fn(self) -> Vec2 Never! {
        length: self.length()
        if length == 0.0 -> return self.copy()
        Vec2.new(self.lanes[0] / length, self.lanes[1] / length)
    }
}
impl Vec2.Add {
    add: fn(self, rhs: Vec2) -> Vec2 Never! {
        Vec2.new(self.lanes[0] + rhs.lanes[0], self.lanes[1] + rhs.lanes[1])
    }
}
impl Vec2.Sub {
    sub: fn(self, rhs: Vec2) -> Vec2 Never! {
        Vec2.new(self.lanes[0] - rhs.lanes[0], self.lanes[1] - rhs.lanes[1])
    }
}
impl Vec2.Mul {
    mul: fn(self, rhs: Vec2) -> Vec2 Never! {
        Vec2.new(self.lanes[0] * rhs.lanes[0], self.lanes[1] * rhs.lanes[1])
    }
}
impl Vec2.Mul(Float) {
    mul: fn(self, rhs: Float) -> Vec2 Never! {
        Vec2.new(self.lanes[0] * rhs, self.lanes[1] * rhs)
    }
}
impl Vec2.Div(Float) {
    div: fn(self, rhs: Float) -> Vec2 Never! {
        Vec2.new(self.lanes[0] / rhs, self.lanes[1] / rhs)
    }
}
impl Float.Mul(Vec2) {
    mul: fn(self, rhs: Vec2) -> Vec2 Never! { rhs * self }
}
Vec3: struct {
    lanes: [Float#3]
}
impl Vec3 {
    new: fn(x: Float, y: Float, z: Float) -> Vec3 Never! {
        Vec3{lanes: [Float#3]{x, y, z}}
    }
}

impl Vec3 {
    splat: fn(x: Float) -> Vec3 Never! { Vec3.new(x, x, x) }
    from_array: fn(lanes: [Float#3]) -> Vec3 Never! { Vec3{lanes: lanes} }
    to_array: fn(self) -> [Float#3] Never! { self.lanes.copy() }
    lane: fn(self, index: Int) -> Float Never! {
        if index < 0 || index >= 3 -> core.math.__numeric_stop("lane index {index} out of range for Vec3 (3 lanes)")
        self.lanes[index]
    }
    // A swizzle read (`v.zyx`) is the vector of the lanes it names.
    __swizzle2: fn(self, a: Int, b: Int) -> Vec2 Never! { Vec2.new(self.lanes[a], self.lanes[b]) }
    __swizzle3: fn(self, a: Int, b: Int, c: Int) -> Vec3 Never! { Vec3.new(self.lanes[a], self.lanes[b], self.lanes[c]) }
    __swizzle4: fn(self, a: Int, b: Int, c: Int, d: Int) -> Vec4 Never! { Vec4.new(self.lanes[a], self.lanes[b], self.lanes[c], self.lanes[d]) }
    // A swizzle write (`v.xy = w`) stores each lane it names from the value.
    __swizzle_set1: fn(&self, a: Int, value: Float) Never! { self.lanes[a] = value }
    __swizzle_set2: fn(&self, a: Int, b: Int, value: Vec2) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
    }
    __swizzle_set3: fn(&self, a: Int, b: Int, c: Int, value: Vec3) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
        self.lanes[c] = value.lanes[2]
    }
    dot: fn(self, other: Vec3) -> Float Never! {
        self.lanes[0] * other.lanes[0] + self.lanes[1] * other.lanes[1] + self.lanes[2] * other.lanes[2]
    }
    cross: fn(self, other: Vec3) -> Vec3 Never! {
        Vec3.new(
            self.lanes[1] * other.lanes[2] - self.lanes[2] * other.lanes[1],
            self.lanes[2] * other.lanes[0] - self.lanes[0] * other.lanes[2],
            self.lanes[0] * other.lanes[1] - self.lanes[1] * other.lanes[0],
        )
    }
    length: fn(self) -> Float Never! { sqrt(self.dot(self)) }
    normalize: fn(self) -> Vec3 Never! {
        length: self.length()
        if length == 0.0 -> return self.copy()
        Vec3.new(self.lanes[0] / length, self.lanes[1] / length, self.lanes[2] / length)
    }
}
impl Vec3.Add {
    add: fn(self, rhs: Vec3) -> Vec3 Never! {
        Vec3.new(self.lanes[0] + rhs.lanes[0], self.lanes[1] + rhs.lanes[1], self.lanes[2] + rhs.lanes[2])
    }
}
impl Vec3.Sub {
    sub: fn(self, rhs: Vec3) -> Vec3 Never! {
        Vec3.new(self.lanes[0] - rhs.lanes[0], self.lanes[1] - rhs.lanes[1], self.lanes[2] - rhs.lanes[2])
    }
}
impl Vec3.Mul {
    mul: fn(self, rhs: Vec3) -> Vec3 Never! {
        Vec3.new(self.lanes[0] * rhs.lanes[0], self.lanes[1] * rhs.lanes[1], self.lanes[2] * rhs.lanes[2])
    }
}
impl Vec3.Mul(Float) {
    mul: fn(self, rhs: Float) -> Vec3 Never! {
        Vec3.new(self.lanes[0] * rhs, self.lanes[1] * rhs, self.lanes[2] * rhs)
    }
}
impl Vec3.Div(Float) {
    div: fn(self, rhs: Float) -> Vec3 Never! {
        Vec3.new(self.lanes[0] / rhs, self.lanes[1] / rhs, self.lanes[2] / rhs)
    }
}
impl Float.Mul(Vec3) {
    mul: fn(self, rhs: Vec3) -> Vec3 Never! { rhs * self }
}
impl Float.Div(Vec3) {
    div: fn(self, rhs: Vec3) -> Vec3 Never! {
        Vec3.new(self / rhs.lanes[0], self / rhs.lanes[1], self / rhs.lanes[2])
    }
}

#Test("Vec3 source products retain scalar and Hadamard distinctions") {
    value: Vec3.new(2.0, 3.0, 4.0)
    assert_eq((value * Vec3.new(5.0, 6.0, 7.0)).lane(2), 28.0)
    assert_eq((value * 2.0).lane(1), 6.0)
    assert_eq((2.0 * value).lane(1), 6.0)
    assert_eq((value / 2.0).lane(2), 2.0)
    assert_eq((12.0 / value).lane(1), 4.0)
    assert_eq(Vec3.new(1.0, 0.0, 0.0).cross(Vec3.new(0.0, 1.0, 0.0)).lane(2), 1.0)
    assert_eq(Vec3.splat(0.0).normalize().dot(value), 0.0)
    assert_eq(Vec3.from_array(value.to_array()).lane(0), 2.0)
}

#Test("Vec2 source arithmetic preserves lane order and zero normalization") {
    value: Vec2.new(3.0, 4.0)
    assert_eq(value.length(), 5.0)
    assert_eq(value.dot(Vec2.new(2.0, -1.0)), 2.0)
    assert_eq((value * Vec2.new(2.0, 3.0)).lane(1), 12.0)
    assert_eq((value + Vec2.new(2.0, 3.0)).lane(0), 5.0)
    assert_eq((value - Vec2.new(2.0, 3.0)).lane(1), 1.0)
    assert_eq(value.normalize().lane(0), 0.6)
    zero: Vec2.new(-0.0, 0.0).normalize()
    assert_eq(to_bits(zero.lane(0)), to_bits(-0.0))
    assert_eq(Vec2.from_array(value.to_array()).lane(1), 4.0)
    assert_eq(Vec2.splat(2.0).dot(Vec2.splat(3.0)), 12.0)
}

Vec4: struct {
