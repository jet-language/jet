// atan_pi for |x| < 2^-54, zero included: x/pi rounded once, and its two
// hard cases.
__atan_pi_small: fn(x: Float) -> Float Never! {
    if to_bits(x).bit_and(0x7FFF_FFFF_FFFF_FFFF) == 0 -> return x
    t: Float{2.409919865102884e-181}
    if (fabs(x) == Float{3.0310430961963293e-308}) {
        if (x > Float{0.0}) -> return fma(-t, t, Float{9.64810982968418e-309})
        return fma(t, t, Float{-9.64810982968418e-309})
    }
    ax: to_bits(x).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    eb: ax >> 52
    if ax.bit_and(0xF_FFFF_FFFF_FFFF) == 0x5_9AF9_A119_4EFE && eb > 2 {
        // every +-0x1.59af9a1194efep-e sits next to a rounding boundary
        v: from_bits(((eb - 2) << 52).bit_or(0xB_8241_98B9_4A89))
        if (x > Float{0.0}) -> return fma(t, t, v)
        return fma(-t, t, -v)
    }
    ph: Float{0.3183098861837907}
    h: x * ph
    // scaled up by 2^106 so the correction cannot underflow
    s: Float{8.112963841460668e31}
    corr: fma(x * s, Float{-1.9678676675182486e-17}, fma(x * s, ph, -h * s))
    // h + corr * 2^-106, rounded once
    fma(corr, Float{1.232595164407831e-32}, h)
}
// atan_pi for 2^-54 <= |x| < 1.3242242857813835e-8: x/pi - x^3/(3 pi) in
// double-double, and its hard cases.
__atan_pi_tiny: fn(x: Float) -> Float Never! {
    ph: Float{0.3183098861837907}
    h: x * ph
    l: fma(Float{-0.1061032953945969} * x, x * x, fma(x, Float{-1.9678676675182486e-17}, fma(x, ph, -h)))
    ax: fabs(x)
    sx: copysign(Float{1.0}, x)
    k := 0
    loop k < __ATANPI_TINY_HARD.len() {
        if ax == __ATANPI_TINY_HARD[k] -> return __ATANPI_TINY_HARD[k + 1] * sx + __ATANPI_TINY_HARD[k + 2] * sx
        k = k + 3
    }
    h + l
}
// atan_pi for |x| > 1826816: +-1/2 - 1/(pi x) + 1/(3 pi x^3) in
// double-double.
__atan_pi_asympt: fn(x: Float) -> Float Never! {
    yh: Float{1.0} / x
    yl: yh * fma(yh, -x, Float{1.0})
    p: __mul_dd(yh, yl, Float{0.3183098861837907}, Float{-1.9678676675182486e-17})
    l: fma(Float{0.1061032953945969} * yh, yh * yh, -p.lo)
    s: __fast_two_sum(copysign(Float{0.5}, x), -p.hi)
    t: __fast_two_sum(s.lo, l)
    m := t.hi
    if (fabs(m) == Float{2.7755575615628914e-17}) {
        // half an ulp of the result: the tail settles the tie
        m = if (m * t.lo > Float{0.0}) -> copysign(Float{2.775557561562892e-17}, m) else -> copysign(Float{2.775557561562891e-17}, m)
    }
    s.hi + m
}
// atan_pi to about 2^-107 relative for the inputs the fast paths cannot
// round; `a` approximates atan(x). The hardest inputs are tabulated.
__atan_pi_refine: fn(x: Float, a: Float) -> Float Never! {
    ax: fabs(x)
    if (ax > Float{1826816.0}) -> return __atan_pi_asympt(x)
    if (ax < Float{1.3242242857813835e-8}) -> return __atan_pi_tiny(x)
    sx: copysign(Float{1.0}, x)
    k := 0
    loop k < __ATANPI_HARD.len() {
        if ax == __ATANPI_HARD[k] -> return __ATANPI_HARD[k + 1] * sx + __ATANPI_HARD[k + 2] * sx
        k = k + 3
    }
    i: (to_bits(fabs(a) * Float{81.48733086305042} + Float{256.5}) >> 44).bit_and(0xFF)
    h := Float{0.0}
    hl := Float{0.0}
    if i == 128 {
        h = Float{-1.0} / x
        hl = fma(h, x, Float{1.0}) * h
    } else {
        // (x - t) / (1 + x t) for the table's t = tan(i pi / 256)
        ta: copysign(__ATANPI_A[2 * i], x)
        zta: x * ta
        ztal: fma(x, ta, -zta)
        zmta: x - ta
        v: Float{1.0} + zta
        d: Float{1.0} - v
        ev: ((d + zta) - ((d + v) - Float{1.0})) + ztal
        r: Float{1.0} / v
        rl: (fma(r, -v, Float{1.0}) - ev * r) * r
        h = r * zmta
        hl = fma(r, zmta, -h) + rl * zmta
    }
    h2: __mul_dd(h, hl, h, hl)
    h4: h2.hi * h2.hi
    h3: __mul_dd(h, hl, h2.hi, h2.lo)
    fl: h2.hi * ((Float{0.1111111111111111} + h2.hi * Float{-0.09090909090907358}) + h4 * (Float{0.07692307637971313} + h2.hi * Float{-0.06665779689246536}))
    f0: __poly_dd(h2.hi, h2.lo, __ATANPI_REFINE_C, 3, fl)
    f: __mul_dd(h3.hi, h3.lo, f0.hi, f0.lo)
    ah := h
    al := f.hi
    at := f.lo
    if i != 0 {
        id: copysign(approx(i), x)
        df: if i < 128 -> sx * __ATANPI_A[2 * i + 1] else -> Float{0.0}
        ah = Float{0.012271846303085088} * id
        s1: __add_dd(Float{4.21117410793604e-17} * id, Float{-9.794523599166037e-32} * id, df, Float{0.0})
        s2: __add_dd(s1.hi, s1.lo, h, hl)
        s3: __add_dd(s2.hi, s2.lo, f.hi, f.lo)
        al = s3.hi
        at = s3.lo
    }
    v: __fast_two_sum(ah, al)
    w: __fast_two_sum(v.lo, at)
    p: __mul_dd(v.hi, w.hi, Float{0.3183098861837907}, Float{-1.9678676675182486e-17})
    p.lo + p.hi
}
