        x3: n * x2
        x4: x2 * x2
        f: x3 * ((Float{-0.3333333333333333} + x2 * Float{0.199999999999994}) + x4 * (Float{-0.1428571424743179} + x2 * Float{0.11110113960028833}))
        p: __mul_dd(n, f, ph, pl)
        ub: p.hi + fma(Float{5.254251250936832e-21}, n, p.lo)
        lb: p.hi + fma(Float{-5.254251250936832e-21}, n, p.lo)
        if ub == lb -> return ub
        return __atan_pi_refine(n, (f + f * Float{9.992007221626409e-16}) + n)
    }
    h := Float{0.0}
    ah := Float{0.0}
    al := Float{0.0}
    if at > 0x4062_DED8_E34A_9035 {
        // |x| > 150.9639755684199
        if at >= 0x4344_5F30_6DC9_C883 {
            if at > 0x7FF0_0000_0000_0000 -> return n + n
            if at == 0x7FF0_0000_0000_0000 -> return copysign(0.5, n)
            return copysign(0.5, n) - copysign(Float{1.3877787807814457e-17}, n)
        }
        h = Float{-1.0} / n
        ah = copysign(Float{1.5707963267948966}, n)
        al = copysign(Float{6.123233995736766e-17}, n)
    } else {
        if at == 0x3FF0_0000_0000_0000 -> return copysign(0.25, n)
        // the table point nearest x, from a piecewise quadratic in its bits
        ci: (at >> 51) - 2030
        ut: at.bit_and(0x7_FFFF_FFFF_FFFF) >> 35
        ut2: (ut * ut) >> 16
        i: ((__ATANPI_C[3 * ci] << 16) + ut * __ATANPI_C[3 * ci + 1] - ut2 * __ATANPI_C[3 * ci + 2]) >> 25
        sx: copysign(1.0, n)
