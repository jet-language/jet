    p: __float_parts(x)
    sx: if (x < Float{0.0}) -> -p.m else -> p.m
    bm: if p.e < 0 -> (Int{1} << -p.e) + sx else -> 1 + (sx << p.e)
    be: if p.e < 0 -> p.e else -> 0
