// h + m + l, |h| > |m| > |l| roughly, rounded once (the last step of
// CORE-MATH's log2.c and log1p.c): when the middle word is a power of 2 the
// tail l moves it one unit its own way.
__log_cr_round3: fn(h: Float, m: Float, l: Float) -> Float Never! {
    w0: __fast_two_sum(h, m)
    w1: __fast_two_sum(w0.lo, l)
    tb: to_bits(w1.hi)
    if tb.bit_and(0xF_FFFF_FFFF_FFFF) != 0 -> return w0.hi + w1.hi
    d: if (tb < 0) != (to_bits(w1.lo) < 0) -> -1 else -> 1
    w0.hi + from_bits(tb + d)
}
// ln_1p's fast path for 2^-53 <= |x| < 2^-4 as (hi, lo, err).
__ln_1p_cr_small: fn(n: Float, a: Int) -> (hi: Float, lo: Float, err: Float) Never! {
