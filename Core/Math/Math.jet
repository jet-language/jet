    lanes: [Float#16]
}
impl Mat4 {
    new: fn(m0: Float, m1: Float, m2: Float, m3: Float, m4: Float, m5: Float, m6: Float, m7: Float, m8: Float, m9: Float, m10: Float, m11: Float, m12: Float, m13: Float, m14: Float, m15: Float) -> Mat4 Never! {
        Mat4{lanes: [Float#16]{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}}
    }
}
impl Mat4.Add {
    add: fn(self, rhs: Mat4) -> Mat4 Never! {
