}
impl WorldDelta {
    new: fn(x: Float, y: Float) -> WorldDelta Never! { WorldDelta{x: x, y: y, frame_id: 0} }
}
impl ScreenPoint.Add(ScreenDelta) {
    add: fn(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenPoint.Sub {
    sub: fn(self, rhs: ScreenPoint) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
