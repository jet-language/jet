/// atan x, correctly rounded (CORE-MATH atan.c): in [-pi/2, pi/2] with the
/// sign of x, and +-pi/2 rounded for an infinity.
atan: fn(n: Float) -> Float Never! {
    at: to_bits(n).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if at < 0x3F7B_21C4_75E6_362A {
        // |x| < 0.006624
        if at == 0 -> return n
        // |x| < 2^-27: x - x 2^-54 rounds as x - x^3/3 does
        if at < 0x3E40_0000_0000_0000 -> return fma(Float{-5.551115123125783e-17}, n, n)
        x2: n * n
        x3: n * x2
        x4: x2 * x2
        f: x3 * ((Float{-0.3333333333333333} + x2 * Float{0.199999999999994}) + x4 * (Float{-0.1428571424743179} + x2 * Float{0.11110113960028833}))
        ub: (f + f * Float{1.2212453270876722e-15}) + n
        lb: (f - f * Float{6.106226635438361e-16}) + n
        if ub == lb -> return ub
        return __atan_refine(n, ub)
    }
    h := Float{0.0}
    ah := Float{0.0}
    al := Float{0.0}
    if at > 0x4062_DED8_E34A_9035 {
        // |x| > 150.9639755684199
        ah = copysign(Float{1.5707963267948966}, n)
        al = copysign(Float{6.123233995736766e-17}, n)
        if at >= 0x434D_0296_7C31_CDB5 {
            if at > 0x7FF0_0000_0000_0000 -> return n + n
            return ah + al
        }
        h = Float{-1.0} / n
    } else {
        // the table point nearest x, as in atan_pi
        ci: (at >> 51) - 2030
        ut: at.bit_and(0x7_FFFF_FFFF_FFFF) >> 35
        ut2: (ut * ut) >> 16
        i: ((__ATANPI_C[3 * ci] << 16) + ut * __ATANPI_C[3 * ci + 1] - ut2 * __ATANPI_C[3 * ci + 2]) >> 25
        sx: copysign(1.0, n)
        id: sx * approx(i)
        ta: sx * __ATANPI_A[2 * i]
        al = sx * __ATANPI_A[2 * i + 1] + Float{4.2111741079360304e-17} * id
        h = (n - ta) / (Float{1.0} + n * ta)
        ah = Float{0.012271846303085088} * id
    }
    h2: h * h
    h4: h2 * h2
    f: (Float{1.0} + h2 * Float{-0.333333333333331}) + h4 * (Float{0.1999999997326265} + h2 * Float{-0.1428473928322857})
    al = fma(h, f, al)
    e: h * Float{8.743006318923108e-16}
    ub: (al + e) + ah
    lb: (al - e) + ah
    if ub == lb -> return ub
    __atan_refine(n, ub)
}
/// atan2(a, b), the angle of the point (b, a), correctly rounded (CORE-MATH
/// atan2.c): in [-pi, pi] with the sign of a; the C23 values at zeros and
/// infinities, and NaN when a or b is NaN.
atan2: fn(a: Float, b: Float) -> Float Never! {
    uy: to_bits(a)
    ux: to_bits(b)
    aiy: uy.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    aix: ux.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if aiy == 0 || aiy >= 0x7FF0_0000_0000_0000 || aix == 0 || aix >= 0x7FF0_0000_0000_0000 -> return __atan2_special(a, b)
    // |a| and |b| more than 52 binades apart
    if aix - aiy >= 0x0350_0000_0000_0000 || aiy - aix > 0x0350_0000_0000_0000 -> return __atan2_accurate(a, b)
    gt: aix < aiy
    sg: if (gt != (ux < 0)) != (uy < 0) -> Float{-1.0} else -> Float{1.0}
    kw: (if ux < 0 -> 4 else -> 0) + (if uy < 0 -> 2 else -> 0) + (if gt -> 1 else -> 0)
    // x / y in [0, 1], and jt / 64 the table point nearest it
    x := if gt -> fabs(a) else -> fabs(b)
    y := if gt -> fabs(b) else -> fabs(a)
    jt: (to_bits(y / x + Float{2.0078125}) >> 45).bit_and(127)
    fh: __ATAN2_F[2 * jt + 1] * sg + __ATAN2_O[2 * kw]
    fl: __ATAN2_F[2 * jt] * sg + __ATAN2_O[2 * kw + 1]
    if (x < Float{1.1282464849155185e-277}) {
        x = x * Float{8.863311460481781e276}
        y = y * Float{8.863311460481781e276}
    }
    if (x > Float{4.49423283715579e307}) && jt != 0 {
        x = x * Float{0.5}
        y = y * Float{0.5}
    }
    t0: Float{jt} * Float{0.015625}
    z: fma(-t0, x, y) / fma(t0, y, x)
    z2: z * z
    zs: z * sg
    dz: (zs * z2) * (Float{-0.33333333333332604} + z2 * (Float{0.19999999943116925} + z2 * Float{-0.14284292170535642}))
    e: fabs(zs) * Float{4.528712474471952e-16} + Float{8.077935669463161e-28}
    r: __fast_two_sum(fh, zs)
    rl: (fl + dz) + r.lo
    ub: r.hi + (rl + e)
    if r.hi + (rl - e) == ub -> return ub
    __atan2_refine(a, b, x, y, t0, fh, fl, sg)
}
/// atanh x, correctly rounded (CORE-MATH atanh.c): odd in x, +-inf at +-1,
/// and NaN for |x| > 1.
atanh: fn(n: Float) -> Float Never! {
    ax: fabs(n)
    aix: to_bits(ax)
    if aix >= 0x3FF0_0000_0000_0000 {
        if aix == 0x3FF0_0000_0000_0000 -> return copysign(INFINITY, n)
        if aix > 0x7FF0_0000_0000_0000 -> return n + n
        return NAN
    }
    if aix < 0x3FD0_0000_0000_0000 {
        // |x| < 1.35e-8: x rounds as atanh(x) does
        if aix < 0x3E4D_12ED_0AF1_A27F -> return fma(n, Float{2.7755575615628914e-17}, n)
        // x + x^3 / 3 + x^5 c(x^2) for |x| < 1/4
        x2: n * n
        c: __ATANH_SMALL_C
        dx2: fma(n, n, -x2)
        x4: x2 * x2
        x3: x2 * n
        x8: x4 * x4
        dx3: fma(x2, n, -x3) + dx2 * n
        p: (c[0] + x2 * c[1]) + x4 * (c[2] + x2 * c[3]) + x8 * ((c[4] + x2 * c[5]) + x4 * (c[6] + x2 * c[7]) + x8 * c[8])
        ph: __fast_two_sum(Float{0.3333333333333333}, fma(x2, p, Float{1.850371707708594e-17}))
        mh: x3 * ph.hi
        ml: fma(x3, ph.hi, -mh) + (dx3 * ph.hi + x3 * ph.lo)
        s: __fast_two_sum(n, mh)
        pl: ml + s.lo
        eps: n * (x4 * Float{2.0122792321330962e-16} + Float{9.860761315262648e-32})
        lb: s.hi + (pl - eps)
        if lb == s.hi + (pl + eps) -> return lb
        return __atanh_zero(n)
    }
    // atanh(x) = ln(t) / 2 with t = (1 + |x|) / (1 - |x|) in double-double
    p: __fast_two_sum(Float{1.0}, ax)
    q: __fast_two_sub(Float{1.0}, ax)
    iqh: Float{1.0} / q.hi
    th: p.hi * iqh
    tl: fma(p.hi, iqh, -th) + (p.lo + p.hi * (fma(-q.hi, iqh, Float{1.0}) - q.lo * iqh)) * iqh
    b: to_bits(th)
    m: b.bit_and(0xF_FFFF_FFFF_FFFF)
    ed: Float{(b >> 52) - 1023}
    i: m >> 47
    d: m.bit_and(0x7FFF_FFFF_FFFF)
    j: (m + (__LOG2CR_B[2 * i] << 33) + __LOG2CR_B[2 * i + 1] * (d >> 16)) >> 42
    i1: j >> 5
    i2: j.bit_and(31)
    tf: from_bits(m.bit_or(0x3FF0_0000_0000_0000))
    r: (Float{0.5} * __AH_R1[i1]) * __AH_R2[i2]
    dx: fma(r, tf, Float{-0.5})
    dx2: dx * dx
    rx: r * tf
    dxl: fma(r, tf, -rx)
    c: __ATANH_C
    f: dx2 * ((c[0] + dx * c[1]) + dx2 * (c[2] + dx * c[3] + dx2 * c[4]))
    lw: __fast_two_sum((__ATANH_L1[2 * i1 + 1] + __ATANH_L2[2 * i2 + 1]) + Float{0.3465735902799736} * ed, rx - Float{0.5})
    ll0: lw.lo + (Float{-9.320943368621517e-16} * ed + (__ATANH_L1[2 * i1] + __ATANH_L2[2 * i2]) + dxl + Float{0.5} * tl / th)
    sg: copysign(1.0, n)
    lh: lw.hi * sg
    ll: (ll0 + f) * sg
    eps: Float{3.8e-23} + dx2 * Float{1.7763568394002505e-15}
    lb: lh + (ll - eps)
    if lb == lh + (ll + eps) -> return lb
    z: __fast_two_sum(th, tl)
    __atanh_refine(n, z.hi, z.lo, Float{2.8853900817779268} * fabs(lh + ll))
}
// atanh x for 1.35e-8 <= |x| < 1/4 in double-double (atanh.c as_atanh_zero).
__atanh_zero: fn(x: Float) -> Float Never! {
    x2: x * x
    x2l: fma(x, x, -x2)
    cl: __ATANH_ZERO_CL
    y2: x2 * (cl[0] + x2 * (cl[1] + x2 * (cl[2] + x2 * (cl[3] + x2 * cl[4]))))
    p: __poly_dd(x2, x2l, __ATANH_ZERO_C, 13, y2)
    q: __hyp_mul_dd_d(p.hi, p.lo, x)
    r: __mul_dd(x2, x2l, q.hi, q.lo)
    y0: __fast_two_sum(x, r.hi)
    y1: __fast_two_sum(y0.lo, r.lo)
    y0.hi + __hyp_nudge(y1.hi, y1.lo)
}
// atanh x when its fast path cannot round: ln(zh + zl) / 2 from the
// estimate a of 2 atanh(x) / ln 2.
__atanh_refine: fn(x: Float, zh: Float, zl: Float, a: Float) -> Float Never! {
    v: __ah_refine(zh, zl, a, 0, Float{0.3465735902799736}, Float{-9.320943368621517e-16}, Float{9.735225461903722e-32}, true, false)
    b1: to_bits(v.v1)
    // atanh.c moves a power-of-two v1 one ulp up in magnitude
    v1: if b1.bit_and(0xF_FFFF_FFFF_FFFF) == 0 -> from_bits(b1 + 1) else -> v.v1
    sg: copysign(1.0, x)
    __ah_finish(sg * v.v0, sg * v1, 1, 3, 104, __ATANH_HARD, fabs(x), sg)
}
// asinh.c's and acosh.c's reduction of 2^e (1 + m 2^-52), with the integer
// exponent field of b less off as e: a reciprocal r = r1[i1] r2[i2] picked by
// log2's piecewise-linear guess, dx = r (1 + m 2^-52) - 1 and the tail f of
// ln(1 + dx) - dx.
__ah_reduce: fn(b: Int, off: Int) -> (i1: Int, i2: Int, ed: Float, dx: Float, f: Float) Never! {
    m: b.bit_and(0xF_FFFF_FFFF_FFFF)
    i: m >> 47
    d: m.bit_and(0x7FFF_FFFF_FFFF)
    j: (m + (__LOG2CR_B[2 * i] << 33) + __LOG2CR_B[2 * i + 1] * (d >> 16)) >> 42
    i1: j >> 5
    i2: j.bit_and(31)
    dx: fma(__AH_R1[i1] * __AH_R2[i2], from_bits(m.bit_or(0x3FF0_0000_0000_0000)), Float{-1.0})
    dx2: dx * dx
    c: __AH_C
    (i1: i1, i2: i2, ed: Float{(b >> 52) - off}, dx: dx, f: dx2 * ((c[0] + dx * c[1]) + dx2 * ((c[2] + dx * c[3]) + dx2 * c[4])))
}
// The refine step of asinh.c, acosh.c and atanh.c: ln(zh + zl) / 2 with zh =
// 2^e t, t in [1, 2) and e its exponent plus adj, from the estimate a of
// log2(zh + zl), as the unnormalized triple v0 + v1 + v2: four reciprocal
// levels t1 t2 t3 t4 picked by a - e, ln(1/t) / 2 from triple-double tables,
// e (l20 + l21 + l22) for e ln(2) / 2, and a degree-6 polynomial. atanh.c
// (always) applies zl even at zero; acosh.c (two) adds with twosum.
__ah_refine: fn(zh: Float, zl: Float, a: Float, adj: Int, l20: Float, l21: Float, l22: Float, always: Bool, two: Bool) -> (v0: Float, v1: Float, v2: Float) Never! {
    b: to_bits(zh)
    e: (b >> 52) - 1023 + adj
    tf: from_bits(b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x3FF0_0000_0000_0000))
    ed: Float{e}
    i: (to_bits(a - ed + Float{1.0000076293945312}) - 0x3FF0_0000_0000_0000) >> 36
    i1: (i >> 12).bit_and(31)
    i2: (i >> 8).bit_and(15)
    i3: (i >> 4).bit_and(15)
    i4: i.bit_and(15)
    // __AH_LL[k] for k in 0..<4 holds 17 triples
    k1: 3 * i1
    k2: 3 * (17 + i2)
    k3: 3 * (34 + i3)
    k4: 3 * (51 + i4)
    ll: __AH_LL
    l0: ll[k1] + ll[k2] + (ll[k3] + ll[k4]) + l20 * ed
    l1: ll[k1 + 1] + ll[k2 + 1] + (ll[k3 + 1] + ll[k4 + 1])
    l2: ll[k1 + 2] + ll[k2 + 2] + (ll[k3 + 2] + ll[k4 + 2])
    t12: __LOG2CR_T1[i1] * __LOG2CR_T2[i2]
    t34: __LOG2CR_T3[i3] * __LOG2CR_T4[i4]
    th: t12 * t34
    tl: fma(t12, t34, -th)
    dh: th * tf
    dl: fma(th, tf, -dh)
    sh: tl * tf
    sl: fma(tl, tf, -sh)
    x0: __fast_two_sum(dh - Float{1.0}, dl)
    xl := x0.lo
    // zl / 2^e by its exponent field, as the C does
    if always || zl != (Float{0.0}) {
        xl = xl + th * from_bits(__wrap_i64(to_bits(zl) - (e << 52)))
    }
    xd: __ah_add(x0.hi, xl, sh, sl, two)
    cl: __AH_REFINE_CL
    tail: xd.hi * (cl[0] + xd.hi * (cl[1] + xd.hi * cl[2]))
    p: __poly_dd(xd.hi, xd.lo, __AH_REFINE_C, 3, tail)
    q: __mul_dd(xd.hi, xd.lo, p.hi, p.lo)
    s1: __ah_add(q.hi, q.lo, l21 * ed, l22 * ed, two)
    s2: __ah_add(s1.hi, s1.lo, l1, l2, two)
    w0: __fast_two_sum(l0, s2.hi)
    w1: __fast_two_sum(w0.lo, s2.lo)
    (v0: w0.hi, v1: w1.hi, v2: w1.lo)
}
// (xh + xl) + (ch + cl) as __add_dd, or with two as acosh.c's adddd: twosum
// of the high parts plus xl + cl.
__ah_add: fn(xh: Float, xl: Float, ch: Float, cl: Float, two: Bool) -> (hi: Float, lo: Float) Never! {
    if !two -> return __add_dd(xh, xl, ch, cl)
    s: xh + ch
    ap: s - ch
    (hi: s, lo: ((xh - ap) + (ch - (s - ap))) + (xl + cl))
}
// v0 + v1, or the listed sg (hi + lo) of a hard case |x| = ax when v1's
// fraction bits plus k fall below lim or v1 sits more than dmax binades
// under v0 (the database tests of asinh.c, acosh.c and atanh.c).
__ah_finish: fn(v0: Float, v1: Float, k: Int, lim: Int, dmax: Int, hard: [Float], ax: Float, sg: Float) -> Float Never! {
    b1: to_bits(v1)
    er: (b1 + k).bit_and(0xF_FFFF_FFFF_FFFF)
    de: (to_bits(v0) >> 52).bit_and(0x7FF) - (b1 >> 52).bit_and(0x7FF)
    res: v0 + v1
    if de > dmax || de < 0 || er < lim -> return __hyp_listed(hard, ax, sg, res)
    res
}
