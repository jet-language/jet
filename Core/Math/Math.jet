}
log: fn(n: Float, base: Float) -> Float Never! { ln(n) / ln(base) }
/// log10(x), correctly rounded (C23 log10; CORE-MATH log10.c): -inf at a
/// zero, NaN below 0, +inf at +inf, and k exactly at every 10^k.
log10: fn(n: Float) -> Float Never! {
    if !(n > Float{0.0}) || n == INFINITY -> return __log_cr_special(n)
    e: (to_bits(n) >> 52) - 1023
    if e >= 0 && e <= 73 {
        // log10.c's hash of the exponent to the one candidate 10^k
        k: (0x267_CFA2 * (e + 1)).bit_and(0xFFFF_FFFF) >> 27
        if k <= 22 && n == __LOG10_POW10[k] -> return Float{k}
    }
    f: __log_cr_fast(n, false)
    // times 1/log(10) as 0.4342944819032518 + 1.098319650216765e-17
    hi: f.hi * Float{0.4342944819032518}
    t: fma(f.lo, Float{0.4342944819032518}, fma(f.hi, Float{0.4342944819032518}, -hi))
    lo: fma(f.hi, Float{1.098319650216765e-17}, t)
