__LOG10_POW10: [Float]{1.0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22}
/// log2(x), correctly rounded (C23 log2; CORE-MATH log2.c): -inf at a zero,
/// NaN below 0, +inf at +inf, and k exactly at every 2^k.
log2: fn(n: Float) -> Float Never! {
