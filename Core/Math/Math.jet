// The sign of (xm 2^xe)^(yn 2^ye / yd) - a for xm, yd > 0, yn != 0 and a
// binary32 midpoint a > 0: 0 when they are equal, else Ziv's strategy on
// __pow_fixed until its error interval leaves a (at 1024 bits its
// approximation's side).
__pow_side: fn(xm: Int, xe: Int, yn: Int, ye: Int, yd: Int, a: Float) -> Int Never! {
    t: __float_parts(a)
    n: if ye > 0 -> yn << ye else -> yn
    d: if ye < 0 -> yd << -ye else -> yd
    if __pow_equal(xm, xe, n, d, t.m, t.e) -> return 0
    w := 160
    loop {
        f: __pow_fixed(xm, xe, yn, ye, yd, w)
        // a and the approximation q 2^(k - w) in one unit
        s: t.e - (f.k - w)
        c: if s >= 0 -> t.m << s else -> t.m
        lift: if s >= 0 -> 0 else -> -s
        if ((f.q - f.err) << lift) > c -> return 1
        if ((f.q + f.err) << lift) < c -> return -1
        if w == 1024 -> return (if (f.q << lift) > c -> 1 else -> -1)
        w = if w > 512 -> 1024 else -> 2 * w
    }
}
// Whether (xm 2^xe)^(n / d) = am 2^ae exactly, for xm, am, d > 0 and n !=
// 0: with odd parts xo 2^xs = xm 2^xe and ao 2^ash = am 2^ae, that is
// xo^n 2^(xs n) = ao^d 2^(ash d). For xo, ao > 1, n > 0 and g = gcd(n, d) it
// is xo^(n/g) = ao^(d/g), so both are powers of one whole c >= 3: n/g < 16,
// as ao < 2^25 here, and d/g at most the bit length of xo.
__pow_equal: fn(xm: Int, xe: Int, n: Int, d: Int, am: Int, ae: Int) -> Bool Never! {
    xo := xm
    xs := xe
    loop xo.bit_and(1) == 0 {
        xo = xo >> 1
        xs = xs + 1
    }
    ao := am
    ash := ae
    loop ao.bit_and(1) == 0 {
        ao = ao >> 1
        ash = ash + 1
    }
    if xs * n != ash * d -> return false
    if xo == 1 || ao == 1 -> return xo == ao
    if n < 0 -> return false
    g: gcd(n, d)
    p: n /% g
    q: d /% g
    if p >= 16 || q > __bit_len(xo) -> return false
    xo.pow(p) == ao.pow(q)
}
// a^y rounded when it is a Float or the midpoint of two, else NaN (the
// cases of CORE-MATH pow.c is_exact). With a = m 2^e and y = n 2^f, m and n
// odd: a power of two gives 2^(e y) when e y is whole; otherwise y > 0, and
// m^y or, for y = n/2^k, the k-fold square root of m must be whole with an
// odd power below 2^54.
__pow_exact: fn(a: Float, y: Float) -> Float Never! {
    x: __float_parts(a)
    m := x.m
    e := x.e
    loop m.bit_and(1) == 0 {
        m = m >> 1
        e = e + 1
    }
    p: __float_parts(fabs(y))
    n := p.m
    f := p.e
    loop n.bit_and(1) == 0 {
        n = n >> 1
        f = f + 1
    }
    if m == 1 {
        g: if (y < Float{0.0}) -> -e * n else -> e * n
        if f >= 0 -> return __round_scaled(1, g << f)
        if (g >> -f) << -f != g -> return NAN
        return __round_scaled(1, g >> -f)
    }
    if (y < Float{0.0}) || f > 5 || f < -5 -> return NAN
    if f >= 0 {
        power: n << f
        if power > 34 -> return NAN
        v: m.pow(power)
        if v >= 0x40_0000_0000_0000 -> return NAN
        return __round_scaled(v, e * power)
    }
