        loop i in 1..<4 {
            if self.lanes[i] < value -> value = self.lanes[i]
        }
        value
    }
    fn max(self) -> I64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] > value -> value = self.lanes[i]
        }
        value
    }
    fn reduce_add(self) -> I64 Never! { self.sum() }
    fn reduce_mul(self) -> I64 Never! { self.product() }
    fn reduce_min(self) -> I64 Never! { self.min() }
    fn reduce_max(self) -> I64 Never! { self.max() }
    fn reduce_avg(self) -> I64 Never! { self.sum() / I64{4} }
    fn reduce(self, op: ReduceOp) -> I64 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl I64x4.Add {
    fn add(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] + rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Sub {
    fn sub(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] - rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Mul {
    fn mul(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] * rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Div {
    fn div(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] / rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}

struct U64x4 {
    lanes: [U64#4]
}
impl U64x4 {
    fn new(l0: U64, l1: U64, l2: U64, l3: U64) -> U64x4 Never! { U64x4{lanes: [U64#4]{l0, l1, l2, l3}} }
    fn splat(value: U64) -> U64x4 Never! { U64x4{lanes: [U64#4]{value, value, value, value}} }
    fn from_array(lanes: [U64#4]) -> U64x4 Never! { U64x4{lanes: lanes} }
    fn to_array(self) -> [U64#4] Never! { self.lanes.copy() }
    fn lane(self, index: Int) -> U64 Never! {
        if index < 0 || index >= 4 -> core.math.__numeric_stop("lane index {index} out of range for U64x4 (4 lanes)")
        self.lanes[index]
    }
    fn sum(self) -> U64 Never! {
        value := U64{0}
        loop i in 0..<4 -> value = value + self.lanes[i]
        value
    }
    fn product(self) -> U64 Never! {
        value := U64{1}
        loop i in 0..<4 -> value = value * self.lanes[i]
        value
    }
    fn min(self) -> U64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] < value -> value = self.lanes[i]
        }
        value
    }
    fn max(self) -> U64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] > value -> value = self.lanes[i]
        }
        value
    }
    fn reduce_add(self) -> U64 Never! { self.sum() }
    fn reduce_mul(self) -> U64 Never! { self.product() }
    fn reduce_min(self) -> U64 Never! { self.min() }
    fn reduce_max(self) -> U64 Never! { self.max() }
    fn reduce_avg(self) -> U64 Never! { self.sum() / U64{4} }
    fn reduce(self, op: ReduceOp) -> U64 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl U64x4.Add {
    fn add(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] + rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Sub {
    fn sub(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] - rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Mul {
    fn mul(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] * rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Div {
    fn div(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] / rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}

#Test("SIMD lane types fold left to right and act lane by lane") {
    floats :: F32x4.new(F32{1.0}, F32{2.0}, F32{3.0}, F32{4.0})
    assert_eq(floats.sum(), F32{10.0})
    assert_eq(floats.reduce(.Avg), F32{2.5})
    assert_eq((floats * floats).lane(3), F32{16.0})
    assert_eq(F32x8.splat(F32{0.5}).sum(), F32{4.0})
    assert_eq(F64x2.new(F64{NAN}, F64{2.0}).min(), F64{2.0})
    ints :: I32x8.new(I32{1}, I32{2}, I32{3}, I32{4}, I32{5}, I32{6}, I32{7}, I32{8})
    assert_eq(ints.reduce(.Add), I32{36})
    assert_eq(ints.min(), I32{1})
    assert_eq((ints / I32x8.splat(I32{-2})).lane(2), I32{-1})
    assert_eq(U8x16.splat(U8{3}).sum(), U8{48})
}

// Stock coordinates retain the seed's frame-zero constructors and left frame.
struct ScreenPoint { x: Float, y: Float, frame_id: Int }
struct ScreenDelta { x: Float, y: Float, frame_id: Int }
struct WorldPoint { x: Float, y: Float, frame_id: Int }
struct WorldDelta { x: Float, y: Float, frame_id: Int }
impl ScreenPoint {
    fn new(x: Float, y: Float) -> ScreenPoint Never! { ScreenPoint{x: x, y: y, frame_id: 0} }
}
impl ScreenDelta {
    fn new(x: Float, y: Float) -> ScreenDelta Never! { ScreenDelta{x: x, y: y, frame_id: 0} }
}
impl WorldPoint {
    fn new(x: Float, y: Float) -> WorldPoint Never! { WorldPoint{x: x, y: y, frame_id: 0} }
}
impl WorldDelta {
    fn new(x: Float, y: Float) -> WorldDelta Never! { WorldDelta{x: x, y: y, frame_id: 0} }
}
impl ScreenPoint.Add(ScreenDelta) {
    fn add(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenPoint.Sub {
    fn sub(self, rhs: ScreenPoint) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl ScreenPoint.Sub(ScreenDelta) {
    fn sub(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Add {
    fn add(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Add(ScreenPoint) {
    fn add(self, rhs: ScreenPoint) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Sub {
    fn sub(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Add(WorldDelta) {
    fn add(self, rhs: WorldDelta) -> WorldPoint Never! { WorldPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Sub {
    fn sub(self, rhs: WorldPoint) -> WorldDelta Never! { WorldDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Sub(WorldDelta) {
    fn sub(self, rhs: WorldDelta) -> WorldPoint Never! { WorldPoint{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Add {
    fn add(self, rhs: WorldDelta) -> WorldDelta Never! { WorldDelta{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Add(WorldPoint) {
    fn add(self, rhs: WorldPoint) -> WorldPoint Never! { WorldPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Sub {
    fn sub(self, rhs: WorldDelta) -> WorldDelta Never! { WorldDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
#Test("Stock screen and world coordinates keep nominal and frame semantics") {
    point :: ScreenPoint.new(2.0, 3.0)
    delta :: ScreenDelta.new(4.0, 5.0)
    assert_eq((point + delta).x, 6.0)
    assert_eq((delta + point).y, 8.0)
    assert_eq((point - delta).x, -2.0)
    assert_eq((point - point).y, 0.0)
    assert_eq((delta + delta).x, 8.0)
    assert_eq((delta - delta).y, 0.0)
    assert_eq((WorldPoint.new(8.0, 9.0) - WorldPoint.new(3.0, 4.0)).x, 5.0)
    assert_eq((WorldPoint.new(1.0, 2.0) + WorldDelta.new(3.0, 4.0)).y, 6.0)
    assert_eq((WorldDelta.new(3.0, 4.0) + WorldDelta.new(5.0, 6.0)).x, 8.0)
    assert_eq((WorldDelta.new(3.0, 4.0) - WorldDelta.new(5.0, 6.0)).y, -2.0)
    assert_eq(ScreenPoint.new(0.0, 0.0).frame_id, 0)
    left :: ScreenPoint{x: 1.0, y: 2.0, frame_id: 7}
    assert_eq((left + delta).frame_id, 7)
}

