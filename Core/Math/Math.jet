// log_b(1 + x) for 2^-920 <= |x| < 2^-5 as (hi, lo, err) with 1/log(b) = ch
// + cl: x + (log(1 + x) - x), times 1/log(b), within 0x1.d4p-62 |hi|.
__log_1p_fast_small: fn(x: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    p: __log_p1a(x)
    s: __fast_two_sum(x, p.hi)
    d: __d_mul(s.hi, s.lo + p.lo, ch, cl)
    (hi: d.hi, lo: d.lo, err: Float{3.9641141931501256e-19} * d.hi)
}
// log_b(xh + xl) for |xl| <= ulp(xh) / 2 as (hi, lo, err): log(xh) + xl / xh,
// times 1/log(b) = ch + cl.
__log_1p_fast: fn(x: (hi: Float, lo: Float), ch: Float, cl: Float, err: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    b: to_bits(x.hi)
    f: __log_fast((b >> 52) - 1023, from_bits(b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x3FF0_0000_0000_0000)))
    // beyond 2^1022 the C drops xl / xh, which would underflow
    c: if (x.hi <= Float{4.49423283715579e307}) -> x.lo / x.hi else -> Float{0.0}
    d: __d_mul(f.hi, f.lo + c, ch, cl)
    (hi: d.hi, lo: d.lo, err: err)
}
// The 128-bit floats of CORE-MATH's dint.h, for the accurate paths of
// log2_1p and log10_1p: (-1)^sgn sig 2^(ex - 127), with sig 0 or in [2^127,
// 2^128). Each operation rounds or truncates as dint.h does, so its error
// bounds hold.
__dint_add: fn(a0: (sig: Int, ex: Int, sgn: Int), b0: (sig: Int, ex: Int, sgn: Int)) -> (sig: Int, ex: Int, sgn: Int) Never! {
    if a0.sig == 0 -> return (sig: b0.sig, ex: b0.ex, sgn: b0.sgn)
    if b0.sig == 0 -> return (sig: a0.sig, ex: a0.ex, sgn: a0.sgn)
    if a0.ex == b0.ex && a0.sig == b0.sig {
        if a0.sgn != b0.sgn -> return (sig: 0, ex: 0, sgn: 0)
        return (sig: a0.sig, ex: a0.ex + 1, sgn: a0.sgn)
    }
    swap: a0.ex < b0.ex || (a0.ex == b0.ex && a0.sig < b0.sig)
    a: if swap -> b0 else -> a0
    b: if swap -> a0 else -> b0
    w: (1 << 128) - 1
    sh: a.ex - b.ex
    t := b.sig
    if sh > 0 {
        // b rounded at a's last place, ties up
        if sh <= 128 {
            t = (t + (t >> (sh - 1)).bit_and(1)).bit_and(w)
        }
        if sh < 128 {
            t = t >> sh
        } else {
            t = 0
        }
    }
    ex := a.ex
    c := (a.sig - t).bit_and(w)
    if a.sgn == b.sgn {
        c = a.sig + t
        if c > w {
            // a carry out: halve, the dropped bit rounding up
            c = c.bit_and(w)
            c = (c + c.bit_and(1)).bit_and(w)
            c = (1 << 127).bit_or(c >> 1)
            ex = ex + 1
        }
    }
    lz: 128 - exact_bit_length(c)
    (sig: c << lz, ex: ex - lz, sgn: a.sgn)
}
// a b: the low words' product dropped, then rounded by the next bit.
__dint_mul: fn(a: (sig: Int, ex: Int, sgn: Int), b: (sig: Int, ex: Int, sgn: Int)) -> (sig: Int, ex: Int, sgn: Int) Never! {
    w: 0xFFFF_FFFF_FFFF_FFFF
    w2: (1 << 128) - 1
    ah: a.sig >> 64
    bh: b.sig >> 64
    m: ah * b.sig.bit_and(w) + a.sig.bit_and(w) * bh
    t: (ah * bh + ((m >> 128) << 64) + (m >> 64).bit_and(w)).bit_and(w2)
    round: (m >> 63).bit_and(1)
    sgn: if a.sgn == b.sgn -> 0 else -> 1
    if (t >> 127) == 0 -> return (sig: ((t << 1) + round).bit_and(w2), ex: a.ex + b.ex, sgn: sgn)
    (sig: (t + round).bit_and(w2), ex: a.ex + b.ex + 1, sgn: sgn)
}
// n a for a whole n with |n| < 2^11 (dint.h's mul_dint_2).
__dint_mul_int: fn(n: Int, a: (sig: Int, ex: Int, sgn: Int)) -> (sig: Int, ex: Int, sgn: Int) Never! {
    if n == 0 -> return (sig: 0, ex: 0, sgn: 0)
    c: if n < 0 -> -n else -> n
    sgn: if n < 0 -> 1 - a.sgn else -> a.sgn
    w2: (1 << 128) - 1
    hi: (a.sig >> 64) * c
    m0: if (hi >> 64) == 0 -> 64 else -> __clz64(hi >> 64)
    m := m0
    t: (hi << m).bit_and(w2)
    l: (((a.sig.bit_and(0xFFFF_FFFF_FFFF_FFFF) * c) << (m - 1)).bit_and(w2)) >> 63
    s := l + t
    if s > w2 {
        s = s.bit_and(w2)
        s = (s + s.bit_and(1)).bit_and(w2)
        s = (1 << 127).bit_or(s >> 1)
        m = m - 1
    }
    (sig: s, ex: a.ex + 64 - m, sgn: sgn)
}
// The 128-bit float of x, exactly; a zero has sig 0.
__dint_from_float: fn(x: Float) -> (sig: Int, ex: Int, sgn: Int) Never! {
    u: to_bits(x)
    f: (u >> 52).bit_and(0x7FF)
    lead: if f != 0 -> 0x10_0000_0000_0000 else -> 0
    m: u.bit_and(0xF_FFFF_FFFF_FFFF) + lead
    t: if m != 0 -> __clz64(m) else -> 0
    drop: if t > 11 -> t - 12 else -> 0
    sgn: if (x < Float{0.0}) -> 1 else -> 0
    (sig: m << (t + 64), ex: f - 1023 - drop, sgn: sgn)
}
// b / a for nonzero a (dint.h's div_dint): 1/a from the Float 4/a and one
// Newton step, times b.
__dint_div: fn(b: Float, a: Float) -> (sig: Int, ex: Int, sgn: Int) Never! {
    r0: __dint_from_float(Float{4.0} / a)
    r: (sig: r0.sig, ex: r0.ex - 2, sgn: r0.sgn)
    q: __dint_add((sig: 1 << 127, ex: 0, sgn: 0), __dint_mul(__dint_from_float(-a), r))
    __dint_mul(__dint_add(r, __dint_mul(r, q)), __dint_from_float(b))
}
// a rounded to nearest for a in the normal range (dint.h's dint_tod): the top
// 53 bits, with the round and sticky bits added as 2^-53 and 2^-54.
__dint_to_float: fn(a: (sig: Int, ex: Int, sgn: Int)) -> Float Never! {
    hi: a.sig >> 64
    r: from_bits((hi >> 11).bit_or(0x3FF0_0000_0000_0000))
    rd := Float{0.0}
    if (hi >> 10).bit_and(1) == 1 {
        rd = Float{1.1102230246251565e-16}
    }
    if hi.bit_and(0x3FF) != 0 || a.sig.bit_and(0xFFFF_FFFF_FFFF_FFFF) != 0 {
        rd = rd + Float{5.551115123125783e-17}
    }
    s: if a.sgn == 0 -> r + rd else -> -r - rd
    s * from_bits((a.ex + 1023).bit_and(0x7FF) << 52)
}
// log(x) for a positive 128-bit float x (dint.h's log_2): x scaled by 2^-E
// into [1/sqrt(2), sqrt(2)) and times a table reciprocal, so that log(x) =
// E log(2) - log(r) + log(1 + z) with a degree-13 polynomial in z.
__dint_log: fn(x: (sig: Int, ex: Int, sgn: Int)) -> (sig: Int, ex: Int, sgn: Int) Never! {
    big: (x.sig >> 64) > 0xB504_F333_F9DE_6484
    e: if big -> x.ex + 1 else -> x.ex
    sh: if big -> 120 else -> 119
    i: (x.sig >> sh) - 128
    z: __dint_add((sig: 1 << 127, ex: 0, sgn: 1), __dint_mul((sig: x.sig, ex: x.ex - e, sgn: x.sgn), __tint_coef(__LOG_DINT_INVERSE, i)))
    p := __tint_coef(__LOG_DINT_P, 0)
    loop k in 1..<13 {
        p = __dint_add(__tint_coef(__LOG_DINT_P, k), __dint_mul(z, p))
    }
    ln2: (sig: 0xB172_17F7_D1CF_79AB_C9E3_B398_03F2_F6AF, ex: -1, sgn: 0)
    __dint_add(__dint_add(__tint_coef(__LOG_DINT_LOG_INVERSE, i), __dint_mul(z, p)), __dint_mul_int(e, ln2))
}
// log_b(1 + x) for |x| >= 2^-5 in 128-bit floats, rounded to nearest, with
// inv = 1/log(b): log(xh) + log(1 + c) for c = xl / xh, as c - c^2/2.
__log_1p_dint: fn(x: Float, inv: (sig: Int, ex: Int, sgn: Int)) -> Float Never! {
    s: __one_plus(x, INFINITY)
    y: __dint_log(__dint_from_float(s.hi))
    c: __dint_div(s.lo, s.hi)
    c2: __dint_mul(c, c)
    t: __dint_add(c, (sig: c2.sig, ex: c2.ex - 1, sgn: 1))
    __dint_to_float(__dint_mul(__dint_add(y, t), inv))
}
// log2_1p when the fast path cannot round.
__log2_1p_accurate: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    if (ax < Float{0.03125}) {
        if (ax < Float{2.465190328815662e-32}) {
            // the one tiny x that the scaled product misrounds
