    0.383891308742342, 0.3750375679601346, 1.3877787807814457e-17,
    0.43260271067188394, 0.4201333991401245, 1.3877787807814457e-17,
    0.4429642251623777, 0.4296251699028713, 1.3877787807814457e-17,
