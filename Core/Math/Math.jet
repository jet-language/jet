}
impl Vec4 {
    new: fn(x: Float, y: Float, z: Float, w: Float) -> Vec4 Never! {
        Vec4{lanes: [Float#4]{x, y, z, w}}
    }
    splat: fn(x: Float) -> Vec4 Never! { Vec4.new(x, x, x, x) }
    from_array: fn(lanes: [Float#4]) -> Vec4 Never! { Vec4{lanes: lanes} }
    to_array: fn(self) -> [Float#4] Never! { self.lanes.copy() }
    lane: fn(self, index: Int) -> Float Never! {
        if index < 0 || index >= 4 -> core.math.__numeric_stop("lane index {index} out of range for Vec4 (4 lanes)")
        self.lanes[index]
    }
    // A swizzle read (`v.zyx`) is the vector of the lanes it names.
    __swizzle2: fn(self, a: Int, b: Int) -> Vec2 Never! { Vec2.new(self.lanes[a], self.lanes[b]) }
    __swizzle3: fn(self, a: Int, b: Int, c: Int) -> Vec3 Never! { Vec3.new(self.lanes[a], self.lanes[b], self.lanes[c]) }
    __swizzle4: fn(self, a: Int, b: Int, c: Int, d: Int) -> Vec4 Never! { Vec4.new(self.lanes[a], self.lanes[b], self.lanes[c], self.lanes[d]) }
    // A swizzle write (`v.xyz = w`) stores each lane it names from the value.
    __swizzle_set1: fn(&self, a: Int, value: Float) Never! { self.lanes[a] = value }
    __swizzle_set2: fn(&self, a: Int, b: Int, value: Vec2) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
    }
    __swizzle_set3: fn(&self, a: Int, b: Int, c: Int, value: Vec3) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
        self.lanes[c] = value.lanes[2]
    }
    __swizzle_set4: fn(&self, a: Int, b: Int, c: Int, d: Int, value: Vec4) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
        self.lanes[c] = value.lanes[2]
        self.lanes[d] = value.lanes[3]
    }
    dot: fn(self, other: Vec4) -> Float Never! {
        total := Float{0.0}
        loop i in 0..<4 -> total = total + self.lanes[i] * other.lanes[i]
        total
    }
    length: fn(self) -> Float Never! { sqrt(self.dot(self)) }
    normalize: fn(self) -> Vec4 Never! {
        length: self.length()
        if length == 0.0 -> return self.copy()
        Vec4.new(self.lanes[0] / length, self.lanes[1] / length, self.lanes[2] / length, self.lanes[3] / length)
    }
}
