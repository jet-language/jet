/// sin(pi * x), correctly rounded (C23 sinpi; CORE-MATH sinpi.c): a zero
/// with the sign of x at every whole x and NaN for an infinity.
sin_pi: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    ax: bits.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if ax == 0 -> return n
    e: ax >> 52
    m0: bits.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
    m: if bits < 0 -> -m0 else -> m0
    s: 1063 - e
    if s < 0 {
        // |x| >= 2^41 is a multiple of 2^-11: the table holds the answer
        if e == 0x7FF -> return __pi_trig_special(n)
        shift: -s - 1
        if shift > 10 -> return copysign(0.0, n)
        iq: m << shift
        if iq.bit_and(2047) == 0 -> return copysign(0.0, n)
        t: __sincos_pi_coarse(iq)
        return t.sh + t.sl
    }
    if ax <= 0x3FA2_0000_0000_0000 -> return __sin_pi_small(n)
    si: e - 1011
    if (m0 << (si + 1)).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0 {
        // a whole x, or a whole x plus one half
        if (m0 << si).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0 -> return copysign(0.0, n)
        if ((m0 << (si - 1)).bit_and(0xFFFF_FFFF_FFFF_FFFF) >> 63) == 0 -> return copysign(1.0, n)
        return -copysign(1.0, n)
    }
    iq: ((m >> s).bit_and(8191) + 1) >> 1
    __pi_trig_reduced(iq, m << (e - 1000), __SINPI_HARD_IQ, __SINPI_HARD)
}
/// cos(pi * x), correctly rounded (C23 cospi; CORE-MATH cospi.c): +0 at
/// every x = 1/2 mod 1 and NaN for an infinity.
cos_pi: fn(n: Float) -> Float Never! {
    ax: to_bits(n).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if ax == 0 -> return 1.0
    e: ax >> 52
    m: ax.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
    s: 1063 - e
    if s < 0 {
        if e == 0x7FF -> return __pi_trig_special(n)
        shift: -s - 1
        if shift > 11 -> return 1.0
        iq: (m << shift) + 1024
        if iq.bit_and(2047) == 0 -> return 0.0
        t: __sincos_pi_coarse(iq)
        return t.sh + t.sl
    }
    if ax <= 0x3F30_0000_0000_0000 -> return __cos_pi_small(n, ax)
    si: e - 1011
    if (m << (si + 1)).bit_and(0xFFFF_FFFF_FFFF_FFFF) == 0 {
        if (m << si).bit_and(0xFFFF_FFFF_FFFF_FFFF) != 0 -> return 0.0
        if ((m << (si - 1)).bit_and(0xFFFF_FFFF_FFFF_FFFF) >> 63) != 0 -> return -1.0
        return 1.0
    }
    iq: (((m >> s) + 2048).bit_and(8191) + 1) >> 1
    __pi_trig_reduced(iq, m << (e - 1000), __COSPI_HARD_IQ, __COSPI_HARD)
}
/// tan(pi * x), correctly rounded (C23 tanpi; CORE-MATH tanpi.c): a signed
/// zero at whole x, an infinity at x = 1/2 mod 1 and NaN for an infinity.
tan_pi: fn(n: Float) -> Float Never! {
    bits: to_bits(n)
    ax: bits.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    sgn: if bits < 0 -> -1 else -> 0
    th := Float{0.0}
    tl := Float{0.0}
