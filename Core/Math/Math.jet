            return Float{-0.5} + Float{2.7755575615628914e-17}
        }
        if (y > Float{0.0}) -> return Float{0.5} + Float{5.551115123125783e-17}
        return Float{-0.5} - Float{5.551115123125783e-17}
    }
    if !inv && (x < Float{0.0}) && ey - ex < -54 {
        if (y > Float{0.0}) -> return Float{1.0} - Float{5.551115123125783e-17}
        return Float{-1.0} + Float{5.551115123125783e-17}
