// log2_1p and log10_1p, CORE-MATH's log2p1.c and log10p1.c: a double-double
// fast path with an error bound and a rounding test. When it cannot round,
// |x| < 2^-5 takes a double-double polynomial and its hard cases, and larger
// |x| the 128-bit floats of dint.h.
//
// 1 + x as a double-double (xh, xl) with xh = 1 + x rounded; from cap up,
// (x, 1) as the C keeps it.
__one_plus: fn(x: Float, cap: Float) -> (hi: Float, lo: Float) Never! {
    if (x >= cap) -> return (hi: x, lo: Float{1.0})
    if (x > Float{1.0}) -> return __fast_two_sum(x, Float{1.0})
    __fast_two_sum(Float{1.0}, x)
}
// log(1 + z) - z for |z| < 0.0021210 as a double-double within 2^-78.25
// (CORE-MATH's p_1).
__log_p1: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    c: __LOG_P1
    z2h: z * z
    z2l: fma(z, z, -z2h)
    ph: fma(fma(fma(c[6], z, c[5]), z2h, fma(c[4], z, c[3])), z, c[2]) * z2h
    s: __fast_two_sum(Float{-0.5} * z2h, ph * z)
    (hi: s.hi, lo: s.lo + Float{-0.5} * z2l)
}
// log(1 + z) - z for |z| < 2^-5 as a double-double within 2^-67.14
// (CORE-MATH's p_1a); below 2^-255 the square is dropped, as in the C.
__log_p1a: fn(z: Float) -> (hi: Float, lo: Float) Never! {
    c: __LOG_P1A
    big: (fabs(z) >= Float{1.727233711018889e-77})
    z2h: if big -> z * z else -> Float{0.0}
    z2l: if big -> fma(z, z, -z2h) else -> Float{0.0}
    p710: fma(fma(c[10], z, c[9]), z2h, fma(c[8], z, c[7]))
    p36: fma(fma(c[6], z, c[5]), z2h, fma(c[4], z, c[3]))
    ph: fma(fma(p710, z2h * z2h, p36), z, c[2]) * z2h
    s: __fast_two_sum(Float{-0.5} * z2h, ph * z)
    (hi: s.hi, lo: s.lo + Float{-0.5} * z2l)
}
// log(2^e v) for 1 <= v < 2 as a double-double within 2^-69.99 (CORE-MATH's
// cr_log_fast): v halved above sqrt(2), times a 10-bit reciprocal r so that
// z = r v - 1 is exact, then e log(2) - log(r) + z + (log(1 + z) - z).
__log_fast: fn(e0: Int, v: Float) -> (hi: Float, lo: Float) Never! {
    m: to_bits(v).bit_and(0xF_FFFF_FFFF_FFFF) + 0x10_0000_0000_0000
    c: m >= 0x16_A09E_667F_3BCD
    e: if c -> e0 + 1 else -> e0
    sh: if c -> 44 else -> 43
    i: (m >> sh) - 362
    y: if c -> v * Float{0.5} else -> v
    z: fma(__LOG_FAST_INVERSE[i], y, Float{-1.0})
    p: __log_p1(z)
    ee: Float{e}
    // log(2) as hi + lo, hi a multiple of 2^-42 so that e hi is exact
    s: __fast_two_sum(fma(ee, Float{0.6931471805598903}, __LOG_FAST_LOG_INVERSE[2 * i]), z)
    l: p.hi + (s.lo + (__LOG_FAST_LOG_INVERSE[2 * i + 1] + p.lo))
    (hi: s.hi, lo: fma(ee, Float{5.497923018708371e-14}, l))
}
// log_b(1 + x) for 2^-920 <= |x| < 2^-5 as (hi, lo, err) with 1/log(b) = ch
// + cl: x + (log(1 + x) - x), times 1/log(b), within 0x1.d4p-62 |hi|.
__log_1p_fast_small: fn(x: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    p: __log_p1a(x)
    s: __fast_two_sum(x, p.hi)
    d: __d_mul(s.hi, s.lo + p.lo, ch, cl)
    (hi: d.hi, lo: d.lo, err: Float{3.9641141931501256e-19} * d.hi)
}
// log_b(xh + xl) for |xl| <= ulp(xh) / 2 as (hi, lo, err): log(xh) + xl / xh,
// times 1/log(b) = ch + cl.
__log_1p_fast: fn(x: (hi: Float, lo: Float), ch: Float, cl: Float, err: Float) -> (hi: Float, lo: Float, err: Float) Never! {
    b: to_bits(x.hi)
    f: __log_fast((b >> 52) - 1023, from_bits(b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x3FF0_0000_0000_0000)))
    // beyond 2^1022 the C drops xl / xh, which would underflow
    c: if (x.hi <= Float{4.49423283715579e307}) -> x.lo / x.hi else -> Float{0.0}
    d: __d_mul(f.hi, f.lo + c, ch, cl)
    (hi: d.hi, lo: d.lo, err: err)
}
// The 128-bit floats of CORE-MATH's dint.h, for the accurate paths of
// log2_1p and log10_1p: (-1)^sgn sig 2^(ex - 127), with sig 0 or in [2^127,
// 2^128). Each operation rounds or truncates as dint.h does, so its error
// bounds hold.
__dint_add: fn(a0: (sig: Int, ex: Int, sgn: Int), b0: (sig: Int, ex: Int, sgn: Int)) -> (sig: Int, ex: Int, sgn: Int) Never! {
    if a0.sig == 0 -> return (sig: b0.sig, ex: b0.ex, sgn: b0.sgn)
    if b0.sig == 0 -> return (sig: a0.sig, ex: a0.ex, sgn: a0.sgn)
    if a0.ex == b0.ex && a0.sig == b0.sig {
        if a0.sgn != b0.sgn -> return (sig: 0, ex: 0, sgn: 0)
        return (sig: a0.sig, ex: a0.ex + 1, sgn: a0.sgn)
    }
    swap: a0.ex < b0.ex || (a0.ex == b0.ex && a0.sig < b0.sig)
    a: if swap -> b0 else -> a0
    b: if swap -> a0 else -> b0
    w: (1 << 128) - 1
    sh: a.ex - b.ex
    t := b.sig
    if sh > 0 {
        // b rounded at a's last place, ties up
        if sh <= 128 {
            t = (t + (t >> (sh - 1)).bit_and(1)).bit_and(w)
        }
        if sh < 128 {
            t = t >> sh
        } else {
            t = 0
        }
    }
    ex := a.ex
    c := (a.sig - t).bit_and(w)
