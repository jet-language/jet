// Double-double helpers of the CORE-MATH ports: a value is hi + lo, and every
// fma recovers the exact rounding error of a product.
__fast_two_sum: fn(x: Float, y: Float) -> (hi: Float, lo: Float) Never! {
    s: x + y
    (hi: s, lo: y - (s - x))
}
__fast_two_sub: fn(x: Float, y: Float) -> (hi: Float, lo: Float) Never! {
    s: x - y
    (hi: s, lo: (x - s) - y)
}
// hi + lo = x + y exactly, for any order of magnitude (Knuth's two-sum).
__two_sum: fn(x: Float, y: Float) -> (hi: Float, lo: Float) Never! {
    s: x + y
    xa: s - y
    ya: s - xa
    (hi: s, lo: (x - xa) + (y - ya))
}
// (xh + xl) + (yh + yl), the high parts summed exactly in either order.
__two_sum_dd: fn(xh: Float, xl: Float, yh: Float, yl: Float) -> (hi: Float, lo: Float) Never! {
    t: __two_sum(xh, yh)
    (hi: t.hi, lo: (xl + yl) + t.lo)
}
__fast_sum_ddd: fn(xh: Float, xl: Float, c: Float) -> (hi: Float, lo: Float) Never! {
    t: __fast_two_sum(xh, c)
    (hi: t.hi, lo: xl + t.lo)
}
// (xh + xl) + (yh + yl), the high parts summed fast (|xh| >= |yh|).
__fast_sum_dd: fn(xh: Float, xl: Float, yh: Float, yl: Float) -> (hi: Float, lo: Float) Never! {
    t: __fast_two_sum(xh, yh)
    (hi: t.hi, lo: (xl + yl) + t.lo)
}
__add_dd: fn(xh: Float, xl: Float, ch: Float, cl: Float) -> (hi: Float, lo: Float) Never! {
    s: xh + ch
    d: s - xh
    (hi: s, lo: ((ch - d) + (xh + (d - s))) + (xl + cl))
