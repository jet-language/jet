// sqrt(x) as a double-double for 0 <= x <= 0.25, within 2^-102.677 relatively.
__sqrt_dd: fn(x: Float) -> (hi: Float, lo: Float) Never! {
    h: sqrt(x)
    (hi: h, lo: -fma(h, h, -x) / (h + h))
}
// (h + l) / pi as a double-double: the product with 1/pi's double-double,
// without the l * lo term.
__acos_pi_div_pi: fn(h: Float, l: Float) -> (hi: Float, lo: Float) Never! {
    ph: Float{0.3183098861837907}
    hi: h * ph
    lo := fma(h, ph, -hi)
    lo = fma(h, Float{-1.9678676675182486e-17}, lo)
    (hi: hi, lo: fma(l, ph, lo))
}
// The double-double __ACOSPI_T2 polynomial of piece i at y.
__acos_pi_poly: fn(i: Int, y: Float, ordered: Bool) -> (hi: Float, lo: Float) Never! {
    p: 21 * i
    h := __ACOSPI_T2[p + 19]
    l := Float{0.0}
    j := 10
    loop j >= 0 {
        if j >= 8 {
            h = __ACOSPI_T2[p + 8 + j] + h * y
            l = Float{0.0}
        } else {
            uh: h * y
            ul: fma(h, y, -uh) + l * y
            c: __ACOSPI_T2[p + 2 * j]
            // the first piece's even coefficients are tiny: add the larger first
            s: if !ordered && fabs(c) < fabs(uh) -> __fast_two_sum(uh, c) else -> __fast_two_sum(c, uh)
            h = s.hi
            l = s.lo + (__ACOSPI_T2[p + 2 * j + 1] + ul)
        }
        j = j - 1
    }
    (hi: h, lo: l)
}
// acos_pi when the fast path cannot round, for |x| < 1: degree-11
// polynomials with double-double coefficients, and the hard cases.
__acos_pi_accurate: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    w: Float{1.0} + ax
    i: if (w == Float{2.0}) -> 127 else -> (to_bits(w) >> 45).bit_and(127)
    if i < 64 {
        a := 0
        b := 114
        loop a + 1 != b {
            c: (a + b) >> 1
            if (__ACOSPI_HARD[3 * c] <= x) {
                a = c
            } else {
                b = c
            }
        }
        if (x == __ACOSPI_HARD[3 * a]) {
            hi: __ACOSPI_HARD[3 * a + 1]
            return hi + hi * Float{5.551115123125783e-17} * __ACOSPI_HARD[3 * a + 2]
        }
        // acos_pi rounds to 1/2 here
        if (ax <= Float{8.71967124502158e-17}) -> return fma(x, Float{-0.125}, Float{0.5})
        // acos(x) = pi/2 -+ (h + l)
        q: __acos_pi_poly(i, ax - __ACOSPI_T2[21 * i + 20], false)
        h: if (x < Float{0.0}) -> -q.hi else -> q.hi
        l: if (x < Float{0.0}) -> -q.lo else -> q.lo
        u: __fast_two_sum(Float{1.5707963267948966}, h)
        r: __acos_pi_div_pi(u.hi, u.lo + (Float{6.123233995736766e-17} + l))
        return r.hi + r.lo
    }
    if (x == Float{0.8499410982757903}) -> return Float{0.1766374250800131} - Float{3.355268964844986e-33}
    if (x == Float{0.9479560751507496}) -> return Float{0.10314588628040941} - Float{1.4858952376020977e-33}
    // acos(x) = sqrt(1 - |x|) (h + l), or pi minus it
    s: __sqrt_dd(Float{1.0} - ax)
    q: __acos_pi_poly(i, ax - __ACOSPI_T2[21 * i + 20], true)
    u := s.hi * q.hi
    v := fma(s.hi, q.hi, -u) + (s.lo * q.hi + s.hi * q.lo)
    if (x < Float{0.0}) {
        t: __fast_two_sum(Float{3.141592653589793}, -u)
        u = t.hi
        v = (t.lo + Float{1.2246467991473532e-16}) - v
    }
    r: __acos_pi_div_pi(u, v)
    r.hi + r.lo
}
