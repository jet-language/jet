}
// sqrt(u^2 + v^2) for finite u >= v > 0, rounded from the exact sum of
// squares: hypot.c's exact cases and its integer Newton refinement.
__hypot_exact: fn(u: Float, v: Float) -> Float Never! {
    pu: __float_parts(u)
    pv: __float_parts(v)
    s: ((pu.m * pu.m) << (2 * (pu.e - pv.e))) + pv.m * pv.m
    b: __bit_len(s)
    // at least 60 root bits, so a sticky bit below the root decides alone
    k: if b < 120 -> (121 - b) /% 2 + 1 else -> 0
    s2: s << (2 * k)
    root: __isqrt_floor(s2)
    sticky: if root * root == s2 -> 0 else -> 1
    __round_scaled(2 * root + sticky, pv.e - k - 1)
}
// floor(sqrt(n)) for n >= 0: Newton's iteration from a binary64 seed.
__isqrt_floor: fn(n: Int) -> Int Never! {
    if n < 2 -> return n
    b: __bit_len(n)
    sh: if b > 100 -> (b - 100) /% 2 else -> 0
    seed: Int.from_float(floor(sqrt(approx(n >> (2 * sh))))) ?? 1
    x0: if seed < 1 -> Int{1} << sh else -> seed << sh
    // one step lands at or above floor(sqrt(n)); from there it decreases
    x := (x0 + n /% x0) /% 2
    loop {
        y: (x + n /% x) /% 2
        if y >= x -> return x
        x = y
    }
}
/// log(x), correctly rounded (C23 log; CORE-MATH log.c): -inf at a zero, NaN
/// below 0, +inf at +inf, and +0 at 1.
ln: fn(n: Float) -> Float Never! {
    if !(n > Float{0.0}) || n == INFINITY -> return __log_cr_special(n)
    bits: __to_bits_i64(n)
    if bits >= 0x3FEF_F000_0000_0000 && bits < 0x3FF0_0800_0000_0000 -> return __ln_cr_tiny(n)
    f: __log_cr_fast(n, true)
    left: f.hi + (f.lo - Float{2.898440866385809e-21})
    right: f.hi + (f.lo + Float{2.898440866385809e-21})
    if left == right -> return left
    __dint_to_float(__dint_log(__dint_from_float(n)))
}
/// log(1 + x), correctly rounded (C23 log1p; CORE-MATH log1p.c): NaN below
/// -1, -inf at -1, +inf at +inf, and a zero keeps its sign.
ln_1p: fn(n: Float) -> Float Never! {
    if !(n > Float{-1.0}) || n == INFINITY {
        if is_nan(n) || n == INFINITY -> return n + n
        if n == -1.0 -> return -INFINITY
        return NAN
    }
    b: to_bits(n)
    a: b.bit_and(0x7FFF_FFFF_FFFF_FFFF)
    if a < 0x3CA0_0000_0000_0000 {
        if a == 0 -> return n
        return fma(fabs(n), Float{-5.551115123125783e-17}, n)
    }
    f: if a < 0x3FB0_0000_0000_0000 -> __ln_1p_cr_small(n, a) else -> __ln_1p_cr_large(n, b)
    lb: f.hi + (f.lo - f.err)
    ub: f.hi + (f.lo + f.err)
    if lb != ub -> return __ln_1p_cr_refine(n, lb)
