    dl: fma(rs, t, -dh) + rs * dt
    xd: __fast_two_sum(dh - Float{1.0}, dl)
    x2: xd.hi * xd.hi
    c: __LOG1PCR_C4
    xl: xd.lo + x2 * ((c[0] + xd.hi * c[1]) + x2 * ((c[2] + xd.hi * c[3]) + x2 * (c[4] + xd.hi * c[5])))
