#Error
TransformError: struct { message: String }
impl TransformError.Display {
    display: fn(self) -> String { self.message.copy() }
}
// Phantom params follow existing KeyRef<T>/DataTracked<T,K> source declarations.
// The seed erases both params and keeps f64 payloads even for F32 spellings.
Point2: struct<T, Space> { x: Float, y: Float, frame_id: Int }
Delta2: struct<T, Space> { x: Float, y: Float, frame_id: Int }
impl Point2 {
    new: fn(x: Float, y: Float, frame_id: Int) -> Point2<T, Space> Never! {
        Point2<T, Space>{x: x, y: y, frame_id: frame_id}
    }
}
impl Delta2 {
    new: fn(x: Float, y: Float, frame_id: Int) -> Delta2<T, Space> Never! {
        Delta2<T, Space>{x: x, y: y, frame_id: frame_id}
    }
}
__coordinate_frame: fn(left: Int, right: Int) -> Int TransformError! {
    if left != 0 && right != 0 && left != right -> return Err(TransformError{message: "coordinate values belong to different frames"})
    if left != 0 -> return Ok(left)
    Ok(right)
}
impl Point2.Add(Delta2<T, Space>) {
    add: fn(self, rhs: Delta2<T, Space>) -> Point2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Point2<T, Space>{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: frame})
    }
}
impl Point2.Sub {
    sub: fn(self, rhs: Point2<T, Space>) -> Delta2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Delta2<T, Space>{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: frame})
    }
}
impl Point2.Sub(Delta2<T, Space>) {
    sub: fn(self, rhs: Delta2<T, Space>) -> Point2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Point2<T, Space>{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: frame})
    }
}
impl Delta2.Add {
    add: fn(self, rhs: Delta2<T, Space>) -> Delta2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Delta2<T, Space>{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: frame})
    }
}
impl Delta2.Add(Point2<T, Space>) {
    add: fn(self, rhs: Point2<T, Space>) -> Point2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Point2<T, Space>{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: frame})
    }
}
impl Delta2.Sub {
    sub: fn(self, rhs: Delta2<T, Space>) -> Delta2<T, Space> TransformError! {
        frame: __coordinate_frame(self.frame_id, rhs.frame_id) ?? return Err(TransformError{message: "coordinate values belong to different frames"})
        Ok(Delta2<T, Space>{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: frame})
    }
}
#Test("Device and dynamic coordinates retain seed frame policy") {
    point: DevicePoint.new(7.0, 8.0)
    delta: DeviceDelta.new(3.0, 4.0)
    assert_eq((point + delta).x, 10.0)
    assert_eq((point - point).y, 0.0)
    assert_eq((point - delta).x, 4.0)
    assert_eq((delta + point).y, 12.0)
    assert_eq((delta + delta).x, 6.0)
    assert_eq((delta - delta).y, 0.0)
    assert_eq(point.frame_id, 0)
    assert_eq(__coordinate_frame(0, 12) ?? panic("frame"), 12)
    assert_eq(__coordinate_frame(11, 0) ?? panic("frame"), 11)
    assert_eq(__coordinate_frame(11, 11) ?? panic("frame"), 11)
    if __coordinate_frame(11, 12) == {
        .Ok(_) -> panic("mismatched frames accepted")
        .Err(error) -> assert_eq(error.message, "coordinate values belong to different frames")
    }
    dynamic: Point2<Float, World>.new(1.0, 2.0, 11)
    shift: Delta2<Float, World>.new(3.0, 4.0, 0)
    moved: (dynamic + shift) ?? panic("dynamic add")
    assert_eq(moved.x, 4.0)
    assert_eq(moved.frame_id, 11)
    distance: (moved - dynamic) ?? panic("dynamic difference")
    assert_eq(distance.y, 4.0)
    assert_eq((shift + dynamic ?? panic("reverse add")).frame_id, 11)
    assert_eq((shift - shift ?? panic("delta sub")).x, 0.0)
}

// Not exported from Core's public type table: payload extraction for the
// existing geometry call contracts checked by sema, not a new coordinate API.
GeometryPoint: trait {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never!
}
impl ScreenPoint.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
impl WorldPoint.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
impl ViewPoint.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
impl CameraPoint.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
impl DevicePoint.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
impl Point2.GeometryPoint {
    __coordinates: fn(self) -> (x: Float, y: Float, frame_id: Int) Never! { (x: self.x, y: self.y, frame_id: self.frame_id) }
}
Ray2: struct<T, From, To> {
    origin: Point2<T, To>
    direction: Delta2<T, To>
}
Transform: struct<From, To> {
    m00: Float, m01: Float, m10: Float, m11: Float, tx: Float, ty: Float
    from_frame: Int, to_frame: Int
}
impl Transform {
    affine: fn(m00: Float, m01: Float, m10: Float, m11: Float, tx: Float, ty: Float, from_frame: Int, to_frame: Int) -> Transform<From, To> Never! {
        Transform<From, To>{m00: m00, m01: m01, m10: m10, m11: m11, tx: tx, ty: ty, from_frame: from_frame, to_frame: to_frame}
    }
    then: fn<Next>(self, next: Transform<To, Next>) -> Transform<From, Next> TransformError! {
        if self.to_frame != 0 && next.from_frame != 0 && self.to_frame != next.from_frame -> return Err(TransformError{message: "transform composition has mismatched frame identity"})
        Ok(Transform<From, Next>{
            m00: next.m00 * self.m00 + next.m01 * self.m10,
            m01: next.m00 * self.m01 + next.m01 * self.m11,
            m10: next.m10 * self.m00 + next.m11 * self.m10,
            m11: next.m10 * self.m01 + next.m11 * self.m11,
            tx: next.m00 * self.tx + next.m01 * self.ty + next.tx,
            ty: next.m10 * self.tx + next.m11 * self.ty + next.ty,
            from_frame: self.from_frame, to_frame: next.to_frame,
        })
    }
    inverse: fn(self) -> Transform<To, From> TransformError! {
        det: self.m00 * self.m11 - self.m01 * self.m10
        if !is_finite(det) || fabs(det) <= 0.0000000000000002220446049250313 -> return Err(TransformError{message: "transform is singular and has no inverse"})
        inv_det: Float{1.0} / det
        Ok(Transform<To, From>{
            m00: self.m11 * inv_det, m01: -self.m01 * inv_det,
            m10: -self.m10 * inv_det, m11: self.m00 * inv_det,
            tx: (self.m01 * self.ty - self.m11 * self.tx) * inv_det,
            ty: (self.m10 * self.tx - self.m00 * self.ty) * inv_det,
            from_frame: self.to_frame, to_frame: self.from_frame,
        })
    }
    point: fn<P: GeometryPoint>(self, point: P) -> Point2<Float, To> TransformError! {
        value: point.__coordinates()
        if value.frame_id != 0 && value.frame_id != self.from_frame -> return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Point2<Float, To>{
            x: self.m00 * value.x + self.m01 * value.y + self.tx,
            y: self.m10 * value.x + self.m11 * value.y + self.ty,
            frame_id: self.to_frame,
        })
    }
    point_at_depth: fn<P: GeometryPoint>(self, point: P, depth: Float) -> Point2<Float, To> TransformError! {
        if !is_finite(depth) -> return Err(TransformError{message: "perspective depth must be finite"})
        origin: self.point<P>(point) ?? return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Point2<Float, To>{x: origin.x + self.m00 * depth, y: origin.y + self.m10 * depth, frame_id: origin.frame_id})
    }
    ray: fn<P: GeometryPoint>(self, point: P) -> Ray2<Float, From, To> TransformError! {
        origin: self.point<P>(point) ?? return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Ray2<Float, From, To>{origin: origin, direction: Delta2<Float, To>{x: self.m00, y: self.m10, frame_id: self.to_frame}})
    }
}
Transform2: struct<T, From, To> {
    m00: Float, m01: Float, m10: Float, m11: Float, tx: Float, ty: Float
    from_frame: Int, to_frame: Int
}
impl Transform2 {
    affine: fn(m00: Float, m01: Float, m10: Float, m11: Float, tx: Float, ty: Float, from_frame: Int, to_frame: Int) -> Transform2<T, From, To> Never! {
        Transform2<T, From, To>{m00: m00, m01: m01, m10: m10, m11: m11, tx: tx, ty: ty, from_frame: from_frame, to_frame: to_frame}
    }
    then: fn<Next>(self, next: Transform2<T, To, Next>) -> Transform2<T, From, Next> TransformError! {
        if self.to_frame != 0 && next.from_frame != 0 && self.to_frame != next.from_frame -> return Err(TransformError{message: "transform composition has mismatched frame identity"})
        Ok(Transform2<T, From, Next>{
            m00: next.m00 * self.m00 + next.m01 * self.m10,
            m01: next.m00 * self.m01 + next.m01 * self.m11,
            m10: next.m10 * self.m00 + next.m11 * self.m10,
            m11: next.m10 * self.m01 + next.m11 * self.m11,
            tx: next.m00 * self.tx + next.m01 * self.ty + next.tx,
            ty: next.m10 * self.tx + next.m11 * self.ty + next.ty,
            from_frame: self.from_frame, to_frame: next.to_frame,
        })
    }
    inverse: fn(self) -> Transform2<T, To, From> TransformError! {
        det: self.m00 * self.m11 - self.m01 * self.m10
        if !is_finite(det) || fabs(det) <= 0.0000000000000002220446049250313 -> return Err(TransformError{message: "transform is singular and has no inverse"})
        inv_det: Float{1.0} / det
        Ok(Transform2<T, To, From>{
            m00: self.m11 * inv_det, m01: -self.m01 * inv_det,
            m10: -self.m10 * inv_det, m11: self.m00 * inv_det,
            tx: (self.m01 * self.ty - self.m11 * self.tx) * inv_det,
            ty: (self.m10 * self.tx - self.m00 * self.ty) * inv_det,
            from_frame: self.to_frame, to_frame: self.from_frame,
        })
    }
    // Rust geometry_method_return: a Float-scalar Transform2's `then` and
    // `inverse` return the Float `Transform`. The checker routes those calls
    // here.
    __then_float: fn<Next>(self, next: Transform2<T, To, Next>) -> Transform<From, Next> TransformError! {
        composed: self.then<Next>(next) ?? return Err(err)
        Ok(Transform<From, Next>{m00: composed.m00, m01: composed.m01, m10: composed.m10, m11: composed.m11, tx: composed.tx, ty: composed.ty, from_frame: composed.from_frame, to_frame: composed.to_frame})
    }
    __inverse_float: fn(self) -> Transform<To, From> TransformError! {
        inverted: self.inverse() ?? return Err(err)
        Ok(Transform<To, From>{m00: inverted.m00, m01: inverted.m01, m10: inverted.m10, m11: inverted.m11, tx: inverted.tx, ty: inverted.ty, from_frame: inverted.from_frame, to_frame: inverted.to_frame})
    }
    point: fn<P: GeometryPoint>(self, point: P) -> Point2<T, To> TransformError! {
        value: point.__coordinates()
        if value.frame_id != 0 && value.frame_id != self.from_frame -> return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Point2<T, To>{
            x: self.m00 * value.x + self.m01 * value.y + self.tx,
            y: self.m10 * value.x + self.m11 * value.y + self.ty,
            frame_id: self.to_frame,
        })
    }
    point_at_depth: fn<P: GeometryPoint>(self, point: P, depth: Float) -> Point2<T, To> TransformError! {
        if !is_finite(depth) -> return Err(TransformError{message: "perspective depth must be finite"})
        origin: self.point<P>(point) ?? return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Point2<T, To>{x: origin.x + self.m00 * depth, y: origin.y + self.m10 * depth, frame_id: origin.frame_id})
    }
    ray: fn<P: GeometryPoint>(self, point: P) -> Ray2<T, From, To> TransformError! {
        origin: self.point<P>(point) ?? return Err(TransformError{message: "coordinate point belongs to a stale frame"})
        Ok(Ray2<T, From, To>{origin: origin, direction: Delta2<T, To>{x: self.m00, y: self.m10, frame_id: self.to_frame}})
    }
}
#Test("Source transforms preserve composition, inverse, frames, depth, and rays") {
    first: Transform<Screen, World>.affine(2.0, 0.0, 0.0, 3.0, 5.0, 7.0, 11, 12)
    next: Transform<World, View>.affine(1.0, 0.0, 0.0, 1.0, 10.0, 20.0, 12, 13)
    chain: first.then(next) ?? panic("then")
    point: first.point(ScreenPoint.new(1.0, 2.0)) ?? panic("point")
    assert_eq(point.x, 7.0)
    assert_eq(point.y, 13.0)
    assert_eq(point.frame_id, 12)
    assert_eq(chain.tx, 15.0)
    assert_eq(chain.to_frame, 13)
    back: first.inverse() ?? panic("inverse")
    restored: back.point(point) ?? panic("inverse point")
    assert_eq(restored.x, 1.0)
    assert_eq(restored.y, 2.0)
    assert_eq(restored.frame_id, 11)
    deep: first.point_at_depth(ScreenPoint.new(1.0, 2.0), 4.0) ?? panic("depth")
    assert_eq(deep.x, 15.0)
    assert_eq(deep.y, 13.0)
    ray: first.ray(ScreenPoint.new(1.0, 2.0)) ?? panic("ray")
    assert_eq(ray.direction.x, 2.0)
    assert_eq(ray.direction.frame_id, 12)
    singular: Transform<Screen, World>.affine(1.0, 2.0, 2.0, 4.0, 0.0, 0.0, 11, 12)
    if singular.inverse() == {
        .Ok(_) -> panic("singular accepted")
        .Err(error) -> assert_eq(error.message, "transform is singular and has no inverse")
    }
    if first.point_at_depth(ScreenPoint.new(0.0, 0.0), NAN) == {
        .Ok(_) -> panic("NaN depth accepted")
        .Err(error) -> assert_eq(error.message, "perspective depth must be finite")
    }
    if first.point(Point2<Float, Screen>.new(0.0, 0.0, 99)) == {
        .Ok(_) -> panic("stale frame accepted")
        .Err(error) -> assert_eq(error.message, "coordinate point belongs to a stale frame")
    }
    narrow: Transform2<F32, Screen, World>.affine(F32{1.0}, F32{0.0}, F32{0.0}, F32{1.0}, F32{2.0}, F32{3.0}, 11, 12)
    assert_eq((narrow.point(ScreenPoint.new(1.0, 2.0)) ?? panic("F32 point")).y, 5.0)
    assert_eq((narrow.inverse() ?? panic("F32 inverse")).tx, -2.0)
    assert_eq((narrow.ray(ScreenPoint.new(1.0, 2.0)) ?? panic("F32 ray")).direction.x, 1.0)
    assert_eq((narrow.point_at_depth(ScreenPoint.new(1.0, 2.0), 4.0) ?? panic("F32 depth")).x, 7.0)
    assert_eq(approx(9007199254740993), 9007199254740992.0)
    assert_eq(approx(-9007199254740993), -9007199254740992.0)
    assert_eq(to_bits(Float.from_f32(F32{-0.0})), to_bits(-0.0))
}

__decimal_to_string: fn(value: Decimal) -> String Never! {
    digits: "{value.magnitude}".bytes()
    bytes := [U8]{}
    if value.negative -> bytes.push(U8{45})
    if value.scale >= digits.len() && value.scale != 0 {
        bytes.push(U8{48})
        bytes.push(U8{46})
        loop _ in 0..<(value.scale - digits.len()) -> bytes.push(U8{48})
        loop byte in digits -> bytes.push(byte)
    } else {
        boundary: digits.len() - value.scale
        loop (index, byte) in digits {
            if value.scale != 0 && index == boundary -> bytes.push(U8{46})
            bytes.push(byte)
        }
    }
    String.from_bytes(bytes) ?? panic("Decimal digits are not UTF-8")
}
__fraction_to_string: fn(value: Fraction) -> String Never! {
    if __decimal_try_fraction(value) == .Val(decimal) -> return __decimal_to_string(decimal)
    "{value.num_value}/{value.den_value}"
}
__complex_from_parts: fn(real: Float, imaginary: Float) -> Complex Never! {
    Complex{real: real, imaginary: imaginary}
}
__complex_add: fn(left: Complex, right: Complex) -> Complex Never! {
    __complex_from_parts(left.real + right.real, left.imaginary + right.imaginary)
}
__complex_sub: fn(left: Complex, right: Complex) -> Complex Never! {
    __complex_from_parts(left.real - right.real, left.imaginary - right.imaginary)
}
__complex_mul: fn(left: Complex, right: Complex) -> Complex Never! {
    __complex_from_parts(left.real * right.real - left.imaginary * right.imaginary, left.real * right.imaginary + left.imaginary * right.real)
}
__complex_div: fn(left: Complex, right: Complex) -> Complex Never! {
    denominator: right.real * right.real + right.imaginary * right.imaginary
    __complex_from_parts((left.real * right.real + left.imaginary * right.imaginary) / denominator, (left.imaginary * right.real - left.real * right.imaginary) / denominator)
}
// A part renders in the shortest display spelling: a whole value drops its
// ".0" (`3 - 0i`, not `3.0 - 0.0i`).
__complex_part_text: fn(value: Float) -> String Never! {
    text: "{value}"
    if text.ends_with(".0") && text.cut_last(".") == .Val(parts) -> return parts.before
    text
}
__complex_to_string: fn(value: Complex) -> String Never! {
    sign: if sign_bit(value.imaginary) -> "-" else -> "+"
    "{__complex_part_text(value.real)} {sign} {__complex_part_text(abs_float(value.imaginary))}i"
}
impl Decimal.Display {
    display: fn(self) -> String { __decimal_to_string(self) }
}
impl Fraction.Display {
    display: fn(self) -> String { __fraction_to_string(self) }
}
impl Complex.Display {
    display: fn(self) -> String { __complex_to_string(self) }
}
// Complex has no order; its arithmetic hooks and its
// magnitude are source methods like Fraction's and Decimal's.
impl Complex {
    abs: fn(self) -> Float Never! { __complex_abs(self) }
}
impl Complex.Add {
    add: fn(self, rhs: Complex) -> Complex Never! { __complex_add(self, rhs) }
}
impl Complex.Sub {
    sub: fn(self, rhs: Complex) -> Complex Never! { __complex_sub(self, rhs) }
}
impl Complex.Mul {
    mul: fn(self, rhs: Complex) -> Complex Never! { __complex_mul(self, rhs) }
}
impl Complex.Div {
    div: fn(self, rhs: Complex) -> Complex Never! { __complex_div(self, rhs) }
}

#Test("Source exact rendering preserves decimal scale and quotient form") {
    assert_eq(__decimal_to_string(__decimal_from_str("-0.00")), "0.00")
    assert_eq(__decimal_to_string(__decimal_from_str("-123.4500")), "-123.4500")
    assert_eq(__fraction_to_string(__fraction_from_parts(1, 8)), "0.125")
    assert_eq(__fraction_to_string(__fraction_from_parts(1, 3)), "1/3")
    assert_eq(__complex_to_string(__complex_from_parts(3.0, -0.0)), "3 - 0i")
}
