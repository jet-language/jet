    if a < 0x3F30_0000_0000_0000 {
        eps: Float{8.809142651444724e-20} * n
        if a < 0x3EA1_9B00_0000_0000 -> return (hi: n, lo: x2 * (Float{-0.5000000000000516} + n * Float{0.33333333333338494}), err: eps)
        c: __LOG1PCR_C2
        return (hi: n, lo: x2 * ((c[0] + n * c[1]) + x2 * (c[2] + n * c[3])), err: eps)
    }
    c: __LOG1PCR_C3
    x3: x2 * n
    x4: x2 * x2
    hx: Float{-0.5} * n
    ln1: fma(hx, n, n)
    ln0: fma(hx, n, n - ln1)
    f: ((c[0] + n * c[1]) + x2 * (c[2] + n * c[3])) + x4 * (((c[4] + n * c[5]) + x2 * (c[6] + n * c[7])) + x4 * ((c[8] + n * c[9]) + x2 * (c[10] + n * c[11])))
