        // lgamma(1) = lgamma(2) = 0
        r = Float{0.0}
    } else if ix < 1073741824 {
        // x < 2
        y := Float{0.0}
        fit := 0
        if ix <= 1072483532 {
            // lgamma(x) = lgamma(x + 1) - ln(x)
            r = -ln(x)
