            a = c
        } else {
            b = c
        }
    }
    if x == t[3 * a] -> return t[3 * a + 1] + t[3 * a + 2]
    NAN
}
// y1 with a zero fraction would let y0 + y1 tie: step it one ulp toward y2
// so the sum rounds as the exact y0 + y1 + y2 does.
__sticky_step: fn(y1: Float, y2: Float) -> Float Never! {
    b: to_bits(y1)
    if b.bit_and(0xF_FFFF_FFFF_FFFF) != 0 -> return y1
    if (to_bits(y2) < 0) != (b < 0) -> return from_bits(__wrap_i64(b - 1))
    from_bits(__wrap_i64(b + 1))
}
// The 64-bit two's complement word of v, as C's int64_t cast of a uint64_t.
__wrap_i64: fn(v: Int) -> Int Never! {
    w: v.bit_and(0xFFFF_FFFF_FFFF_FFFF)
    if w > 0x7FFF_FFFF_FFFF_FFFF -> return w - 0xFFFF_FFFF_FFFF_FFFF - 1
    w
}
// sin, cos, tan, sin_pi, cos_pi and tan_pi of an infinity are NaN; a NaN
// stays NaN.
__pi_trig_special: fn(n: Float) -> Float Never! {
    if is_nan(n) -> return n + n
    from_bits(0x7FF8_0000_0000_0000)
}
// sin and cos (CORE-MATH sin.c, cos.c). The fast paths reduce x by k pi/2^14
// (|x| < 2^31) or by k 2pi/2^15 (__sincos_reduce), read sin and cos of the grid
// point from two double-double tables and add a short polynomial in the rest;
// when the error bound cannot decide the rounding, the accurate path reduces
// x/(2pi) in 128-bit fixed point and evaluates there.
__sin_moderate: fn(x: Float) -> Float Never! {
    ax: fabs(x)
    k: round_even(Float{5215.189175235227} * ax)
    r: fma(k, Float{-0.00019174759848570515}, ax) + k * Float{-7.474650873702107e-21}
    r2: r * r
    j: __whole_i64(k)
    neg: if (x < Float{0.0}) -> 1 else -> 0
    g: __sin_grid(Int{(j >> 7).bit_and(0x7F)}, Int{j.bit_and(0x7F)})
    sh: r * (Float{1.0} - Float{0.16666666659950335} * r2)
    ch: r2 * (Float{-0.5} + Float{0.041666666655141404} * r2)
    f: __sincos_round(g.hi, g.lo + g.hi * ch + g.other * sh, neg.bit_xor(Int{(j >> 14).bit_and(1)}), Float{1.0122043719688889e-19})
    if !is_nan(f) -> return f
    if (ax < Float{1.52587890625e-5}) -> return __sin_small_accurate(x)
    __sin_accurate(x)
}
__sin_large: fn(x: Float) -> Float Never! {
    red: __sincos_reduce(fabs(x))
    r: red.r
    r2: r * r
    neg: if (x > Float{0.0}) -> 0 else -> 1
    g: __sin_grid((red.j >> 7).bit_and(0x7F), red.j.bit_and(0x7F))
    sh: r * (Float{6.283185307179586} - Float{41.341700961418276} * r2)
    ch: r2 * (Float{-19.739208802178716} + Float{64.93938786554104} * r2)
    f: __sincos_round(g.hi, g.lo + g.hi * ch + g.other * sh, neg.bit_xor(red.j >> 14), Float{1.088437337221776e-19})
    if !is_nan(f) -> return f
    __sin_accurate(x)
}
__cos_moderate: fn(x: Float) -> Float Never! {
    k: round_even(Float{5215.189175235227} * x)
    r: fma(k, Float{-0.00019174759848570515}, x) + k * Float{-7.474650873702107e-21}
    r2: r * r
    j: __whole_i64(k)
    g: __cos_grid(Int{(j >> 7).bit_and(0x7F)}, Int{j.bit_and(0x7F)})
    sh: r * (Float{1.0} - Float{0.16666666659950335} * r2)
    ch: r2 * (Float{-0.5} + Float{0.041666666655141404} * r2)
    f: __sincos_round(g.hi, g.lo + g.hi * ch - g.other * sh, Int{(j >> 14).bit_and(1)}, Float{1.0122043719688889e-19})
    if !is_nan(f) -> return f
    __cos_accurate(x)
}
__cos_large: fn(x: Float) -> Float Never! {
    red: __sincos_reduce(x)
    r: red.r
    r2: r * r
    g: __cos_grid((red.j >> 7).bit_and(0x7F), red.j.bit_and(0x7F))
    sh: r * (Float{6.283185307179586} - Float{41.341700961418276} * r2)
    ch: r2 * (Float{-19.739208802178716} + Float{64.93938786554104} * r2)
    f: __sincos_round(g.hi, g.lo + g.hi * ch - g.other * sh, red.j >> 14, Float{1.088437337221776e-19})
    if !is_nan(f) -> return f
    __cos_accurate(x)
}
// sin(t1 + t2) as hi + lo and cos(t1 + t2) as other, for t1 = i1 pi/2^7 and
// t2 = i2 pi/2^14.
__sin_grid: fn(i1: Int, i2: Int) -> (hi: Float, lo: Float, other: Float) Never! {
    a: 4 * i1
    b: 4 * i2
    s1: __exp_cr_muldd(__SINCOS_U1[a], __SINCOS_U1[a + 1], __SINCOS_U2[b + 2], __SINCOS_U2[b + 3])
    s2: __exp_cr_muldd(__SINCOS_U2[b], __SINCOS_U2[b + 1], __SINCOS_U1[a + 2], __SINCOS_U1[a + 3])
    s: __fast_sum_dd(s1.hi, s1.lo, s2.hi, s2.lo)
    (hi: s.hi, lo: s.lo, other: __SINCOS_U1[a + 2] * __SINCOS_U2[b + 2] - __SINCOS_U1[a] * __SINCOS_U2[b])
}
// cos(t1 + t2) as hi + lo and sin(t1 + t2) as other, as __sin_grid.
__cos_grid: fn(i1: Int, i2: Int) -> (hi: Float, lo: Float, other: Float) Never! {
    a: 4 * i1
    b: 4 * i2
    c1: __exp_cr_muldd(__SINCOS_U1[a + 2], __SINCOS_U1[a + 3], __SINCOS_U2[b + 2], __SINCOS_U2[b + 3])
    c2: __exp_cr_muldd(__SINCOS_U2[b], __SINCOS_U2[b + 1], __SINCOS_U1[a], __SINCOS_U1[a + 1])
    c: __fast_sum_dd(c1.hi, c1.lo, -c2.hi, -c2.lo)
    (hi: c.hi, lo: c.lo, other: __SINCOS_U1[a] * __SINCOS_U2[b + 2] + __SINCOS_U1[a + 2] * __SINCOS_U2[b])
}
// (-1)^s (fh + fl) when fl - eps and fl + eps round alike with fh; NaN when
// the fast path cannot decide.
__sincos_round: fn(fh: Float, fl: Float, s: Int, eps: Float) -> Float Never! {
    sg: if s == 1 -> Float{-1.0} else -> Float{1.0}
    h: sg * fh
    l: sg * fl
    lb: h + (l - eps)
    if lb == h + (l + eps) -> return lb
    NAN
}
// For x >= 2^31: x/(2pi) mod 1 = j/2^15 + r + s with 0 <= r < 2^-15 and
// 0 <= s < 2^-67.988.
__sincos_reduce: fn(x: Float) -> (j: Int, r: Float) Never! {
    b: to_bits(x)
    e: b >> 52
    m: b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
    i: (e - 1011) >> 6
    w: (__SINCOS_T[i] << 128) + (__SINCOS_T[i + 1] << 64) + __SINCOS_T[i + 2]
    v: ((w << (e - 1011).bit_and(0x3F)) >> 64).bit_and(0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF)
    // rounded to nearest by 2^59 + 2^52 below the 15 + 53 bits kept
    u: __u128(m * v + 0x1_0000_0000_0000_0000_0000_0000_0000 + 0x810_0000_0000_0000)
    (j: u >> 113, r: Float{(u >> 60).bit_and(0x1F_FFFF_FFFF_FFFF)} * Float{3.3881317890172014e-21} - Float{1.52587890625e-5})
}
// For |x| >= 2^-27: x/(2pi) mod 1 = k/2^13 + (-1)^neg r/2^128 + eps with
// |r/2^128| <= 2^-14 and 0 <= eps < 2^-127.999.
__sincos_reduce_acc: fn(x: Float) -> (k: Int, r: Int, neg: Bool) Never! {
    b: to_bits(x).bit_and(0x7FFF_FFFF_FFFF_FFFF)
    e: b >> 52
    m: b.bit_and(0xF_FFFF_FFFF_FFFF).bit_or(0x10_0000_0000_0000)
    i: ((e - 947) /% 64) - 1
    t0: if i >= 0 -> __SINCOS_T[i] else -> 0
    w: (t0 << 192) + (__SINCOS_T[i + 1] << 128) + (__SINCOS_T[i + 2] << 64) + __SINCOS_T[i + 3]
    v: ((w << ((e - 1011) % 64)) >> 64).bit_and(0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF)
    u0: __u128(m * (v >> 64) + ((m * v.bit_and(0xFFFF_FFFF_FFFF_FFFF)) >> 64))
    k: u0 >> 115
    u: u0.bit_and(0x7_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF)
    // k rounded to nearest, so that |r/2^128| < 2^-14
    if (u >> 114) == 1 -> return (k: (k + 1).bit_and(0x1FFF), r: 0x8_0000_0000_0000_0000_0000_0000_0000 - u, neg: true)
    (k: k, r: u, neg: false)
}
// sin(2 pi r)/2^128 for 0 <= r < 2^-14, given u = 8 r, u2 = u^2, u2h = its
// top word and u4 = u^4, all in 2^-128 fixed point.
__sincos_ps: fn(u: Int, u2: Int, u2h: Int, u4: Int) -> Int Never! {
    sh: __mul_hi128(__SINCOS_PS[2] - __SINCOS_PS[3] * u2h, u4)
    s: __u128(__SINCOS_PS[0] - __mul_hi128(__SINCOS_PS[1], u2) + sh)
    __mul_hi128(s, u)
}
// cos(2 pi r)/2^128, as __sincos_ps.
__sincos_pc: fn(u2: Int, u2h: Int, u4: Int) -> Int Never! {
    sh: __SINCOS_PC[2] - __mul_hi128(__SINCOS_PC[3] - u2h * __SINCOS_PC[4], u2)
    __u128(__SINCOS_PC[0] - __mul_hi128(__SINCOS_PC[1], u2) + __mul_hi128(sh, u4))
}
// sin(pi i/2^6) in 2^-128 units for 0 <= i <= 32, the last capped to 2^128 - 1.
__sincos_s1u: fn(i: Int) -> Int Never! {
    if i == 0 -> return 0
    if i == 32 -> return 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF
    __asin_pi_acc_s(2 * i - 1)
}
// (|sin z|, |cos z|) for z = k pi/2^12 mod pi, i1 = k/2^6 mod 2^6 and
// i2 = k mod 2^6, in 2^-128 units.
__sincos_acc_grid: fn(i1: Int, i2: Int) -> (s: Int, c: Int) Never! {
    s1: if i1 <= 32 -> __sincos_s1u(i1) else -> __sincos_s1u(64 - i1)
    c1: if i1 <= 32 -> __sincos_s1u(32 - i1) else -> __sincos_s1u(i1 - 32)
    sa: __mul_hi128(s1, __SINCOS_C2U[i2])
    sb: __mul_hi128(c1, __SINCOS_S2U[i2])
    ca: __mul_hi128(c1, __SINCOS_C2U[i2])
    cb: __mul_hi128(s1, __SINCOS_S2U[i2])
    if i1 < 32 -> return (s: __u128(sa + sb), c: __u128(ca - cb))
    (s: __u128(sa - sb), c: __u128(ca + cb))
}
// (-1)^s r/2^128 rounded to nearest, for r/2^128 above 2^-64 (the closest a
// binary64 comes to a multiple of pi/2 is 2^-60.888).
__sincos_u128_to_float: fn(r: Int, s: Int) -> Float Never! {
    sh: __clz64(r >> 64)
    v0: from_bits((970 - sh) << 52)
    v: if s == 1 -> -v0 else -> v0
    low: if (r >> (74 - sh)).bit_and(1) == 1 -> Float{0.75} else -> Float{0.375}
    Float{r >> (75 - sh)} * v + low * v
}
// sin's accurate path for |x| >= 2^-16.
__sin_accurate: fn(x: Float) -> Float Never! {
    red: __sincos_reduce_acc(x)
    r: red.r << 3
    u2: __mul_hi128(r, r)
    u4: __mul_hi128(u2, u2)
    i1: (red.k >> 6).bit_and(0x3F)
    g: __sincos_acc_grid(i1, red.k.bit_and(0x3F))
    p: __mul_hi128(g.s, __sincos_pc(u2, u2 >> 64, u4))
    q: __mul_hi128(g.c, __sincos_ps(r, u2, u2 >> 64, u4))
    sbit: (if (x > Float{0.0}) -> 0 else -> 1).bit_xor(red.k >> 12)
    // p = sin(z) cos(r) >= 0; q = |cos(z) sin(r)|, positive when i1 < 32 and r >= 0
    if (i1 < 32) != red.neg -> return __sincos_u128_to_float(__u128(p + q), sbit)
    if p < q -> return __sincos_u128_to_float(q - p, 1 - sbit)
    __sincos_u128_to_float(p - q, sbit)
}
// sin's accurate path for |x| < 2^-16: x + c3 x^3 + c5 x^5, c3 a double-double.
__sin_small_accurate: fn(x: Float) -> Float Never! {
    x2h: x * x
    x2l: fma(x, x, -x2h)
    h: Float{0.00833333333327091} * x2h + Float{-9.251854266180608e-18}
    a: __fast_two_sum(Float{-0.16666666666666666}, h)
    b: __exp_cr_muldd(a.hi, a.lo, x2h, x2l)
    c: __exp_cr_muldd(b.hi, b.lo, x, Float{0.0})
    d: __fast_two_sum(x, c.hi)
    d.hi + (c.lo + d.lo)
}
// cos's accurate path for x >= 2^-27, x positive.
__cos_accurate: fn(x: Float) -> Float Never! {
    red: __sincos_reduce_acc(x)
    r: red.r << 3
    u2: __mul_hi128(r, r)
    u4: __mul_hi128(u2, u2)
    i1: (red.k >> 6).bit_and(0x3F)
    g: __sincos_acc_grid(i1, red.k.bit_and(0x3F))
    p: __mul_hi128(g.c, __sincos_pc(u2, u2 >> 64, u4))
    q: __mul_hi128(g.s, __sincos_ps(r, u2, u2 >> 64, u4))
    sbit: (red.k >> 12).bit_and(1)
    flip: if i1 >= 32 -> 1 else -> 0
    // p = |cos(z)| cos(r), cos(z) <= 0 when i1 >= 32; q = sin(z) sin(r), r's sign
    if (i1 >= 32) != red.neg -> return __cos_listed(x, __u128(p + q), sbit.bit_xor(flip))
    if p <= q -> return __cos_listed(x, q - p, (1 - sbit).bit_xor(flip))
    __cos_listed(x, p - q, sbit.bit_xor(flip))
}
// cos's four hard cases near 0, which the 128-bit result cannot round: their
// results agree with the result's top 72 to 88 bits beyond the round bit.
__cos_listed: fn(x: Float, c: Int, s: Int) -> Float Never! {
    ret: __sincos_u128_to_float(c, s)
    if (c + 5).bit_and(0xFFFF_FFFF_FFFF_FFFF) > 3 -> return ret
    if (x == Float{1.788139343261721e-7}) -> return 0.999999999999984
    if (x == Float{3.5762786865234566e-7}) -> return 0.999999999999936
    if (x == Float{7.152557373047027e-7}) -> return 0.9999999999997442
    if (x == Float{1.0728836059570827e-6}) -> return 0.9999999999994245
    ret
}
// 1/(2pi) rounded down, in 64-bit words from 2^0: sum of T[i]/2^(64 i).
__SINCOS_T: [Int]{
    0x0, 0x28BE_60DB_9391_054A, 0x7F09_D5F4_7D4D_3770, 0x36D8_A566_4F10_E410,
    0x7F94_58EA_F7AE_F158, 0x6DC9_1B8E_9093_74B8, 0x192_4BBA_8274_6487, 0x3F87_7AC7_2C4A_69CF,
    0xBA20_8D7D_4BAE_D121, 0x3A67_1C09_AD17_DF90, 0x4E64_758E_60D4_CE7D, 0x2721_17E2_EF7E_4A0E,
    0xC7FE_25FF_F781_6603, 0xFBCB_C462_D682_9B47, 0xDB4D_9FB3_C9F2_C26D, 0xD3D1_8FD9_A797_FA8B,
    0x5D49_EEB1_FAF9_7C5E, 0xCF41_CE7D_E294_A4BA, 0x9AFE_D7EC_47E3_5742, 0x1580_CC11_BF1E_DAEA,
    0xFC33_EF08_26BD_0D87
}
// sin(2pi x/8) for 0 <= x < 2^-11 to 2^-128.605: odd coefficients from
// degree 1 in 2^-128 units, the last in 2^-64 units; degrees 3 and 7 negated.
__SINCOS_PS: [Int]{
    0xC90F_DAA2_2168_C234_C4C6_628B_80DB_ED80, 0x14AB_BCE6_25BE_52BE_ABB8_E550_6CA4_5B03,
    0xA3_35E3_3BAD_570E_044C_5499_5BB9_7635, 0x2_65A5_999D_06C4
}
// cos(2pi x/8) for 0 <= x < 2^-11 to 2^-128: even coefficients from degree 0
// in 2^-128 units, the last in 2^-64 units; degrees 2 and 6 negated.
__SINCOS_PC: [Int]{
    0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF, 0x4EF4_F326_F917_7969_2B71_366C_BCF0_B096,
    0x40F_07C2_06D6_B0EC_D4C9_076E_3DB7_8FED, 0x15_5D3C_7E3C_BEF9_EEC6_9623_68FB_7C41,
    0x3C3E_845B_5510
}
// sin(pi i/2^12) for 0 <= i < 64, in 2^-128 units, to nearest.
__SINCOS_S2U: [Int]{
    0x0, 0x32_43F6_55D9_66C0_C3B0_ABF2_B35A_62F8,
    0x64_87EA_BB99_1CB6_11AD_1D7B_5620_834A, 0x96_CBDB_4125_8434_C4A3_2C45_60D0_1E70,
    0xC9_0FC5_F665_25D2_5748_0F79_56B6_4707, 0xFB_53A8_EB3E_C385_3284_21CF_8014_D698,
    0x12D_9782_2F99_6BC4_F968_57B5_AA8F_6208, 0x15F_DB4F_D35C_8CAA_D230_A305_92F2_5049,
    0x192_1F0F_E670_0711_AB96_7FE6_B7A9_B037, 0x1C4_62C0_78BC_41B6_7DB6_E69A_B68F_0D10,
    0x1F6_A65F_9A2A_3C58_85CE_DE1F_0314_607B, 0x228_E9EB_5AA3_A2D9_7C11_EBC1_B33C_AFB5,
    0x25B_2D61_CA12_E05D_C2DD_9C01_5A46_E767, 0x28D_70C0_F863_326C_8E8D_6151_676A_E94D,
    0x2BF_B406_F580_BC10_0532_05A5_4588_F0AB, 0x2F1_F731_D158_98F5_556F_EBF4_862D_A970,
    0x324_3A3F_9BD8_F08C_C3C7_5F41_B6CE_7AA8, 0x356_7D2E_64F1_0929_AD8A_2D0C_1A9E_3A8C,
    0x388_BFFC_3C91_5B22_80C1_C97A_65CF_2291, 0x3BB_02A7_32AB_A3F0_A849_3BF9_C07F_7765,
    0x3ED_452D_5732_F950_6B5E_1380_C7E6_BDDB, 0x41F_878C_BA1B_DC60_BFEB_A221_FB9D_05BE,
    0x451_C9C3_6B5C_4CC3_0ED3_C01C_0300_08BB, 0x484_0BCF_7AEB_DBBA_E978_5720_7BC5_89DA,
    0x4B6_4DAE_F8C3_BF4D_AFC8_F71B_8EB2_33EE, 0x4E8_8F5F_F4DE_E562_2617_B65F_5A2A_8F5A,
    0x51A_D0E0_7F3A_06DF_F9F8_9FB6_5BE2_A455, 0x54D_122E_A7D3_BACF_356E_F187_634A_531D,
    0x57F_5348_7EAC_8977_9FAB_71E4_3D71_E2B7, 0x5B1_942C_13C6_FF80_0A9F_1C12_38FD_05D5,
    0x5E3_D4D7_7727_C10D_8CA5_6CD8_D54B_97F0, 0x616_1548_B8D5_9CE2_A589_93A7_6B3F_4FFE,
    0x648_557D_E8D9_9F7E_4E29_CF6E_5FED_0679, 0x67A_9575_173F_263A_F1FC_3EDB_7A0F_1757,
    0x6AC_D52C_5413_F26D_51B8_6C83_422C_BAB4, 0x6DF_14A1_AF68_3C83_4E68_E062_EB17_7E2D,
    0x711_53D3_394E_C722_9C28_010F_1C93_A252, 0x743_92BF_01DC_F247_5BCB_8FD4_1CB1_096F,
    0x775_D163_192A_CE62_9AC2_0C03_3D7F_5CC3, 0x7A8_0FBD_8F53_2F78_B865_4AA8_2457_8975,
    0x7DA_4DCC_7473_C03F_B005_90E6_75E4_E556, 0x80C_8B8D_D8AD_153D_46F0_804D_AE5F_13BA,
    0x83E_C8FF_CC22_BFE5_1DB7_2585_6FF8_C284, 0x871_0620_5EFB_61B6_A3F6_7AD0_5A5B_E69E,
    0x8A3_42ED_A160_BF5A_EDE5_B106_8D17_4BEA, 0x8D5_7F65_A37F_D3C2_6AED_92D3_4C17_DF54,
    0x907_BB86_7588_E342_7C8C_5732_D89E_910B, 0x939_F74E_27AF_8EB2_ECC9_3966_728E_412D,
    0x96C_32BA_CA2A_E68B_437B_2DD4_9D5F_CA3C, 0x99E_6DCA_6D35_7DFF_F9A6_0C93_3178_92C4,
    0x9D0_A87B_210D_7E1F_8A31_8BA7_75FD_7B04, 0xA02_E2CA_F5F4_B8EF_5F3D_645E_787B_94F2,
