package: {
    name: "core.math"
    version: "0.0.1"
    edition: "2026"
    description: "Exact integer arithmetic and IEEE floating-point composition in Jet."
    license: "MIT"
    outputs: {
        math: .Library{ entry: math }
    }
}
use {
    core: core
    ambient_random: core.math.random
    core.prelude.[min, max, clamp]
}
// One `abs` for every Numeric type: Int, every sized integer, a `#Numeric`
// distinct type, or a struct that implements Numeric. `n - n` is the type's
// zero. A Float, F32 or I64 argument takes the sign-bit builtin instead.
abs: fn<T: Numeric>(n: T) -> T Never! {
    zero: n - n
    if n < zero -> return zero - n
    n
}

abs_float: fn(n: Float) -> Float Never! { core.math.fabs(n) }

is_even: fn(n: Int) -> Bool Never! { n % 2 == 0 }
is_odd: fn(n: Int) -> Bool Never! { n % 2 != 0 }

sign: fn(n: Int) -> Int Never! {
    if n > 0 -> return 1
    if n < 0 -> return -1
    0
}

isqrt: fn(n: Int) -> Int? Never! {
    if n < 0 -> return None
    if n < 2 -> return Val(n)
    lo := 1
    hi := n
    ans := 1
    loop lo <= hi {
        mid: lo + (hi - lo) /% 2
        // Compare through division so `mid * mid` cannot overflow.
        if mid > n /% mid {
            hi = mid - 1
        } else {
            ans = mid
            if mid == n /% mid && n %% mid == 0 -> return Val(mid)
            lo = mid + 1
        }
    }
    Val(ans)
}

gcd: fn(a: Int, b: Int) -> Int Never! {
    x := abs(a)
    y := abs(b)
    loop y != 0 {
        next: x % y
        x = y
        y = next
    }
    x
}

lcm: fn(a: Int, b: Int) -> Int Never! {
    if a == 0 || b == 0 -> return 0
    abs(a /% gcd(a, b) * b)
}
// Floating-point entry points remain thin Jet APIs over the existing
// deterministic Core primitives.  Keeping the call qualified is deliberate:
// inside this source package it selects the primitive Core route rather than
// recursively calling the source implementation being defined.
/// acos x, correctly rounded (CORE-MATH acos.c): in [0, pi], and NaN for
/// |x| > 1.
acos: fn(n: Float) -> Float Never! {
    u: to_bits(n)
    ax: (u << 1).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    if ax > 0x7FC0_0000_0000_0000 {
        // |x| > 1/2: acos(x) = 2 asin(sqrt((1 - x)/2)), or pi minus that of -x
        f0h: if u < 0 -> Float{3.141592653589793} else -> Float{0.0}
        f0l: if u < 0 -> Float{1.2246467991473532e-16} else -> Float{0.0}
        if ax >= 0x7FE0_0000_0000_0000 {
            if ax == 0x7FE0_0000_0000_0000 -> return f0h + f0l
            if ax > 0xFFE0_0000_0000_0000 -> return n + n
            return NAN
        }
        t: Float{2.0} - Float{2.0} * fabs(n)
        jd: round_even(t * Float{32.0})
        z: copysign(sqrt(t), n)
        zl: fma(z, z, -t) * ((Float{-0.5} / t) * z)
        tj: Float{0.25} * t - jd * Float{0.0078125}
        eps: fabs(z * tj) * Float{3.434752482434078e-16} + Float{2.465190328815662e-32}
        r: __asin_core(jd, tj, z, zl, f0h, f0l, eps)
        if r.lb != r.ub -> return __acos_refine(n, r.lb)
        return r.lb
    }
    f0h: Float{1.5707963267948966}
    f0l: Float{6.123233995736766e-17}
    if ax <= 0x7E00_0000_0000_0000 {
        // |x| <= 2^-15: pi/2 - x - x^3/6, the cube dropped below 4.98e-17
        v: if ax <= 0x7919_6767_0D2E_8FE8 -> Float{0.0} else -> (n * n) * (Float{-0.16666666666666666} * n)
        h: __fast_two_sum(f0h, -n)
        l: v + (h.lo + f0l)
        lb: h.hi + (l - Float{1.990403348955723e-24})
        ub: h.hi + (l + Float{1.990403348955723e-24})
        if lb != ub -> return __acos_refine(n, lb)
        return lb
    }
    // pi/2 - asin(x)
    jd: round_even(n * n * Float{128.0})
    t: fma(n, n, Float{-0.0078125} * jd)
    r: __asin_core(jd, t, -n, Float{0.0}, f0h, f0l, (-n * t) * Float{3.3393426912553537e-16})
    if r.lb != r.ub -> return __acos_refine(n, r.lb)
    r.lb
}
/// acosh x, correctly rounded (CORE-MATH acosh.c): 0 at 1, NaN below 1, and
/// +inf at +inf.
acosh: fn(n: Float) -> Float Never! {
    b: to_bits(n)
    if b >= 0x7FF0_0000_0000_0000 || b < 0 {
        if is_nan(n) || b == 0x7FF0_0000_0000_0000 -> return n + n
        return NAN
    }
    if b <= 0x3FF0_0000_0000_0000 {
        if b == 0x3FF0_0000_0000_0000 -> return Float{0.0}
        return NAN
    }
    if b < 0x3FF1_E83E_425A_EE63 {
        // 1 < x < 1.1192: acosh(x) = sqrt(2 z) (1 + z c(z)) with z = x - 1
        z: n - Float{1.0}
        iz: Float{-0.25} / z
        zt: Float{2.0} * z
        sh: sqrt(zt)
        sl: fma(sh, sh, -zt) * (sh * iz)
        cl: __ACOSH_NEAR1_C
        z2: z * z
        z4: z2 * z2
        ds: fma(sh * z, (cl[0] + z * (((cl[1] + z * cl[2]) + z2 * (cl[3] + z * cl[4])) + z4 * ((cl[5] + z * cl[6]) + z2 * (cl[7] + z * cl[8])))), sl)
        e0: ds * Float{8.881784197001252e-16} - Float{4.930380657631324e-32} * sh
        lb: sh + (ds - e0)
        if lb == sh + (ds + e0) -> return lb
        return __acosh_one(z, sh, sl)
    }
    // ln(x + sqrt(x^2 - 1)) as ln(2x) + g for x >= 111.75
    g := Float{0.0}
    eps := Float{1.8380614955418317e-19}
    off := 1022
    tb := b
    if b < 0x405B_F000_0000_0000 {
        off = 1023
        x2h: n * n
        wh: x2h - Float{1.0}
        wl: fma(n, n, -x2h)
        sh: sqrt(wh)
        ish: Float{0.5} / wh
        sl: (wl - fma(sh, sh, -wh)) * (sh * ish)
        t: __fast_two_sum(n, sh)
        tb = to_bits(t.hi)
        g = (t.lo + sl) / t.hi
        eps = Float{1.6305384234645282e-19}
    } else if b < 0x4087_1000_0000_0000 {
        z: Float{1.0} / (n * n)
        g = Float{1.8438554824029686e-20} + z * (Float{-0.2500000000000051} + z * (Float{-0.09374999970827397} + z * Float{-0.052088933292329824}))
        eps = Float{1.9100592960584473e-19}
    } else if b < 0x40E0_1000_0000_0000 {
        z: Float{1.0} / (n * n)
        g = Float{-1.0150310783512001e-20} + z * (Float{-0.24999999999990108} + z * Float{-0.09375014351472541})
        eps = Float{1.7364175418713157e-19}
    } else if b < 0x41EA_0000_0000_0000 {
        z: Float{1.0} / (n * n)
        g = Float{1.0007109452477697e-20} + z * Float{-0.25000000008663337}
        eps = Float{1.7321823771350442e-19}
    }
    r: __ah_reduce(tb, off)
    lh: (__AH_L1[2 * r.i1 + 1] + __AH_L2[2 * r.i2 + 1]) + Float{0.6931471805598903} * r.ed
    ll: r.dx + (g + (r.f + (Float{5.497923018708371e-14} * r.ed + (__AH_L1[2 * r.i1] + __AH_L2[2 * r.i2]))))
    lb: lh + (ll - eps)
    if lb == lh + (ll + eps) -> return lb
    __acosh_refine(n, Float{1.4426950408889634} * lb)
}
// acosh(1 + x) = sqrt(2 x) (1 + x c(x)) for 0 < x < 0.1192 in double-double,
// with sh + sl = sqrt(2 x) (acosh.c as_acosh_one).
__acosh_one: fn(x: Float, sh: Float, sl: Float) -> Float Never! {
    cl: __ACOSH_ONE_CL
    y2: x * (cl[0] + x * (cl[1] + x * (cl[2] + x * (cl[3] + x * (cl[4] + x * cl[5])))))
    p: __poly_dd(x, Float{0.0}, __ACOSH_ONE_C, 10, y2)
    q: __mul_dd_d(p.hi, p.lo, x)
    y0: __fast_two_sum(Float{1.0}, q.hi)
    r: __mul_dd(y0.hi, y0.lo + q.lo, sh, sl)
    r.hi + r.lo
}
// acosh x when its fast path cannot round, from its estimate a of acosh(x) /
// ln 2: z = x + sqrt(x^2 - 1) in double-double, or x itself one binade down
// from 2^52 on.
__acosh_refine: fn(x: Float, a: Float) -> Float Never! {
    b: to_bits(x)
    zh := x
    zl := Float{0.0}
    huge := 0
    if b < 0x4190_0000_0000_0000 {
        x2h: x * x
        w: __fast_two_sum(x2h - Float{1.0}, fma(x, x, -x2h))
        sh: sqrt(w.hi)
        sl: (w.lo - fma(sh, sh, -w.hi)) / (Float{2.0} * sh)
        z0: __fast_two_sum(x, sh)
        z1: __fast_two_sum(z0.hi, z0.lo + sl)
        zh = z1.hi
        zl = z1.lo
    } else if b < 0x4330_0000_0000_0000 {
        zh = Float{2.0} * x
        zl = Float{-0.5} / x
    } else {
        huge = 1
    }
    v: __ah_refine(zh, zl, a, huge, Float{0.34657359027994517}, Float{2.7489615093542512e-14}, Float{-6.562349208892628e-28}, false, true)
    v1: __hyp_nudge(Float{2.0} * v.v1, Float{2.0} * v.v2)
    __ah_finish(Float{2.0} * v.v0, v1, 7, 15, 102, __ACOSH_HARD, x, Float{1.0})
}
/// asin x, correctly rounded (CORE-MATH asin.c): in [-pi/2, pi/2] with the
/// sign of x, and NaN for |x| > 1.
asin: fn(n: Float) -> Float Never! {
    u: to_bits(n)
    ax: (u << 1).bit_and(0xFFFF_FFFF_FFFF_FFFF)
    if ax > 0x7FC0_0000_0000_0000 {
        // |x| > 1/2: asin(x) = pi/2 - 2 asin(sqrt((1 - x)/2)), odd in x
        f0h: if u < 0 -> Float{-1.5707963267948966} else -> Float{1.5707963267948966}
        f0l: if u < 0 -> Float{-6.123233995736766e-17} else -> Float{6.123233995736766e-17}
        if ax >= 0x7FE0_0000_0000_0000 {
            if ax == 0x7FE0_0000_0000_0000 -> return f0h + f0l
            if ax > 0xFFE0_0000_0000_0000 -> return n + n
            return NAN
        }
        t: Float{2.0} - Float{2.0} * fabs(n)
        jd: round_even(t * Float{32.0})
        z: copysign(sqrt(t), -n)
        zl: fma(z, z, -t) * ((Float{-0.5} / t) * z)
        tj: Float{0.25} * t - jd * Float{0.0078125}
        r: __asin_core(jd, tj, z, zl, f0h, f0l, fabs(z * tj) * Float{3.5475095083725705e-16})
        if r.lb != r.ub -> return __asin_refine(n, r.lb)
        return r.lb
    }
    // |x| < 2.149119332890821e-8: x rounds as asin(x) does
    if ax < 0x7CAE_26E8_9224_7DEC -> return fma(Float{2.7755575615628914e-17}, n, n)
    jd: round_even(n * n * Float{128.0})
    t: fma(n, n, Float{-0.0078125} * jd)
    r: __asin_core(jd, t, n, Float{0.0}, Float{0.0}, Float{0.0}, fabs(n * t) * Float{3.2526065174565133e-16})
    if r.lb != r.ub -> return __asin_refine(n, r.lb)
    r.lb
}
/// asinh x, correctly rounded (CORE-MATH asinh.c): odd in x, and +-inf and
/// NaN return themselves.
asinh: fn(n: Float) -> Float Never! {
    ax: fabs(n)
    u: to_bits(ax)
    if u < 0x3FBB_0000_0000_0000 {
        // |x| < 0.10546875: x + x^3 c(x^2)
        if u < 0x3E57_1374_4912_3EF7 {
            if u == 0 -> return n
            return fma(Float{-8.673617379884035e-19}, n, n)
        }
        x2h: n * n
        x2l: fma(n, n, -x2h)
        x3h: x2h * n
        sl := Float{0.0}
        if u < 0x3E5A_0000_0000_0000 {
            sl = x3h * Float{-0.16666666666666666}
        } else if u < 0x3F30_0000_0000_0000 {
            sl = x3h * (Float{-0.16666666666666666} + x2h * Float{0.07499999733907847})
        } else if u < 0x3F93_0000_0000_0000 {
            sl = x3h * (Float{-0.16666666666666666} + x2h * (Float{0.0749999999997719} + x2h * (Float{-0.0446428538299723} + x2h * Float{0.030366545941310663})))
        } else {
            c1: Float{0.07499999999999951} + x2h * Float{-0.0446428571423326}
            c3: Float{0.0303819442002541} + x2h * Float{-0.02237210153194042}
            c5: Float{0.017345577248855333} + x2h * Float{-0.013510645942218957}
            x4: x2h * x2h
            sl = x3h * (Float{-0.16666666666666666} + x2h * (c1 + x4 * (c3 + x4 * c5)))
        }
        eps: Float{1.6349768761081407e-16} * x3h
        lb: n + (sl - eps)
        if lb == n + (sl + eps) -> return lb
        return __asinh_zero(n, x2h, x2l)
    }
    // ln(|x| + sqrt(x^2 + 1)) with the sign of x
    x2h := Float{0.0}
    x2l := Float{0.0}
    ah := ax
    al := Float{0.0}
    off := 1023
    if u < 0x4190_0000_0000_0000 {
        x2h = n * n
        x2l = fma(n, n, -x2h)
        t: if u < 0x3FF0_0000_0000_0000 -> __fast_two_sum(Float{1.0}, x2h) else -> __fast_two_sum(x2h, Float{1.0})
        tl: t.lo + x2l
        h: sqrt(t.hi)
        rs: Float{0.5} / t.hi
        l: (tl - fma(h, h, -t.hi)) * (rs * h)
        s: __fast_two_sum(h, ax)
        ah = s.hi
        al = l + s.lo
    } else if u < 0x4330_0000_0000_0000 {
        ah = Float{2.0} * ax
        al = Float{0.5} / ax
    } else {
        if u >= 0x7FF0_0000_0000_0000 -> return n + n
        // ln(2 |x|) from |x| one binade down
        off = 1022
    }
    r: __ah_reduce(to_bits(ah), off)
    sg: copysign(1.0, n)
    lh: (Float{0.6931471805598903} * r.ed + (__AH_L1[2 * r.i1 + 1] + __AH_L2[2 * r.i2 + 1])) * sg
    ll: ((Float{5.497923018708371e-14} * r.ed + __AH_L1[2 * r.i1] + __AH_L2[2 * r.i2] + al / ah + r.f) + r.dx) * sg
    lb: lh + (ll - Float{1.63e-19})
    if lb == lh + (ll + Float{1.63e-19}) -> return lb
    if ax < (Float{0.25}) -> return __asinh_zero(n, x2h, x2l)
    __asinh_refine(n, ah, al, Float{1.4426950408889634} * fabs(lb))
}
// asinh x for 2^-25.47 <= |x| < 1/4 in double-double from x^2 = x2h + x2l
// (asinh.c as_asinh_zero).
__asinh_zero: fn(x: Float, x2h: Float, x2l: Float) -> Float Never! {
    cl: __ASINH_ZERO_CL
    y2: x2h * (cl[0] + x2h * (cl[1] + x2h * (cl[2] + x2h * (cl[3] + x2h * cl[4]))))
    p: __poly_dd(x2h, x2l, __ASINH_ZERO_C, 12, y2)
    q: __mul_dd(p.hi, p.lo, x2h, x2l)
    r: __mul_dd_d(q.hi, q.lo, x)
    y0: __fast_two_sum(x, r.hi)
    y1: __fast_two_sum(y0.lo, r.lo)
    y0.hi + __hyp_nudge(y1.hi, y1.lo)
}
// asinh x when its fast path cannot round: ln(zh + zl) with the sign of x,
// from the estimate a of log2(zh + zl).
__asinh_refine: fn(x: Float, zh: Float, zl: Float, a: Float) -> Float Never! {
    // a zero zl marks zh = |x| for 2 |x|
    adj: if zl == (Float{0.0}) -> 1 else -> 0
    v: __ah_refine(zh, zl, a, adj, Float{0.34657359027994517}, Float{2.7489615093542512e-14}, Float{-6.562349208892628e-28}, false, false)
    w0: __fast_two_sum(v.v0, v.v1)
    w1: __fast_two_sum(w0.lo, v.v2)
    s2: copysign(2.0, x)
    v1: __hyp_nudge(s2 * w1.hi, s2 * w1.lo)
    __ah_finish(s2 * w0.hi, v1, 41, 80, 99, __ASINH_HARD, fabs(x), copysign(1.0, x))
}
// asinh.c's as_asinh_zero coefficients: degree 3 to 25 as (hi, lo) pairs,
// 27 to 35 as Floats, and its listed hard cases.
__ASINH_ZERO_C: [Float]{
