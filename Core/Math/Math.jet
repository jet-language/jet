    sub: fn(self, rhs: ScreenDelta) -> ScreenPoint Never! { ScreenPoint{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Add {
    add: fn(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Add(ScreenPoint) {
    add: fn(self, rhs: ScreenPoint) -> ScreenPoint Never! { ScreenPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl ScreenDelta.Sub {
    sub: fn(self, rhs: ScreenDelta) -> ScreenDelta Never! { ScreenDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Add(WorldDelta) {
    add: fn(self, rhs: WorldDelta) -> WorldPoint Never! { WorldPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Sub {
    sub: fn(self, rhs: WorldPoint) -> WorldDelta Never! { WorldDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldPoint.Sub(WorldDelta) {
    sub: fn(self, rhs: WorldDelta) -> WorldPoint Never! { WorldPoint{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Add {
    add: fn(self, rhs: WorldDelta) -> WorldDelta Never! { WorldDelta{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Add(WorldPoint) {
    add: fn(self, rhs: WorldPoint) -> WorldPoint Never! { WorldPoint{x: self.x + rhs.x, y: self.y + rhs.y, frame_id: self.frame_id} }
}
impl WorldDelta.Sub {
    sub: fn(self, rhs: WorldDelta) -> WorldDelta Never! { WorldDelta{x: self.x - rhs.x, y: self.y - rhs.y, frame_id: self.frame_id} }
}
#Test("Stock screen and world coordinates keep nominal and frame semantics") {
    point: ScreenPoint.new(2.0, 3.0)
    delta: ScreenDelta.new(4.0, 5.0)
    assert_eq((point + delta).x, 6.0)
    assert_eq((delta + point).y, 8.0)
    assert_eq((point - delta).x, -2.0)
    assert_eq((point - point).y, 0.0)
    assert_eq((delta + delta).x, 8.0)
    assert_eq((delta - delta).y, 0.0)
    assert_eq((WorldPoint.new(8.0, 9.0) - WorldPoint.new(3.0, 4.0)).x, 5.0)
    assert_eq((WorldPoint.new(1.0, 2.0) + WorldDelta.new(3.0, 4.0)).y, 6.0)
    assert_eq((WorldDelta.new(3.0, 4.0) + WorldDelta.new(5.0, 6.0)).x, 8.0)
    assert_eq((WorldDelta.new(3.0, 4.0) - WorldDelta.new(5.0, 6.0)).y, -2.0)
    assert_eq(ScreenPoint.new(0.0, 0.0).frame_id, 0)
    left: ScreenPoint{x: 1.0, y: 2.0, frame_id: 7}
    assert_eq((left + delta).frame_id, 7)
}

