// m 2^e for a whole m >= 0, rounded to nearest, ties to even, with the
// subnormals and overflow to +inf.
__round_scaled: fn(m: Int, e: Int) -> Float Never! {
    if m == 0 -> return 0.0
    b: __bit_len(m)
    if b + e > 1025 -> return INFINITY
    if b + e < -1076 -> return 0.0
    shift: if b - 53 > -1074 - e -> b - 53 else -> -1074 - e
    if shift <= 0 -> return ldexp(Float{m}, e)
    q := m >> shift
    rest: m - (q << shift)
    half: Int{1} << (shift - 1)
    if rest > half || (rest == half && q.bit_and(1) == 1) -> q = q + 1
