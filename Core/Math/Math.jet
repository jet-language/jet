#Test("View and camera coordinate arithmetic retains left frame") {
    point :: ViewPoint.new(2.0, 3.0)
    delta :: ViewDelta.new(4.0, 5.0)
    assert_eq((point + delta).x, 6.0)
    assert_eq((point - point).y, 0.0)
    assert_eq((point - delta).x, -2.0)
    assert_eq((delta + point).y, 8.0)
    assert_eq((delta + delta).y, 10.0)
    assert_eq((delta - delta).y, 0.0)
    camera :: CameraPoint.new(7.0, 8.0)
    shift :: CameraDelta.new(3.0, 4.0)
    assert_eq((camera + shift).x, 10.0)
    assert_eq((camera - camera).y, 0.0)
    assert_eq((camera - shift).x, 4.0)
    assert_eq((shift + camera).y, 12.0)
    assert_eq((shift + shift).x, 6.0)
    assert_eq((shift - shift).y, 0.0)
    assert_eq(camera.frame_id, 0)
    assert_eq((ViewDelta{x: 1.0, y: 2.0, frame_id: 9} + point).frame_id, 9)
}

