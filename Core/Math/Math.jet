F64x2: struct {
    lanes: [F64#2]
}
impl F64x2 {
    new: fn(l0: F64, l1: F64) -> F64x2 Never! { F64x2{lanes: [F64#2]{l0, l1}} }
    splat: fn(value: F64) -> F64x2 Never! { F64x2{lanes: [F64#2]{value, value}} }
    from_array: fn(lanes: [F64#2]) -> F64x2 Never! { F64x2{lanes: lanes} }
    to_array: fn(self) -> [F64#2] Never! { self.lanes.copy() }
    lane: fn(self, index: Int) -> F64 Never! {
        if index < 0 || index >= 2 -> core.math.__numeric_stop("lane index {index} out of range for F64x2 (2 lanes)")
        self.lanes[index]
    }
    // Swizzles: both lanes read and write as an F64x2.
    __swizzle2: fn(self, a: Int, b: Int) -> F64x2 Never! { F64x2.new(self.lanes[a], self.lanes[b]) }
    __swizzle_set1: fn(&self, a: Int, value: F64) Never! { self.lanes[a] = value }
    __swizzle_set2: fn(&self, a: Int, b: Int, value: F64x2) Never! {
        self.lanes[a] = value.lanes[0]
        self.lanes[b] = value.lanes[1]
    }
    sum: fn(self) -> F64 Never! {
        value := F64{0.0}
        loop i in 0..<2 -> value = value + self.lanes[i]
