        loop i in 1..<4 {
            if self.lanes[i] < value -> value = self.lanes[i]
        }
        value
    }
    max: fn(self) -> I64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] > value -> value = self.lanes[i]
        }
        value
    }
    reduce_add: fn(self) -> I64 Never! { self.sum() }
    reduce_mul: fn(self) -> I64 Never! { self.product() }
    reduce_min: fn(self) -> I64 Never! { self.min() }
    reduce_max: fn(self) -> I64 Never! { self.max() }
    reduce_avg: fn(self) -> I64 Never! { self.sum() / I64{4} }
    reduce: fn(self, op: ReduceOp) -> I64 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl I64x4.Add {
    add: fn(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] + rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Sub {
    sub: fn(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] - rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Mul {
    mul: fn(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] * rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}
impl I64x4.Div {
    div: fn(self, rhs: I64x4) -> I64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] / rhs.lanes[i]
        I64x4{lanes: lanes}
    }
}

U64x4: struct {
    lanes: [U64#4]
}
impl U64x4 {
    new: fn(l0: U64, l1: U64, l2: U64, l3: U64) -> U64x4 Never! { U64x4{lanes: [U64#4]{l0, l1, l2, l3}} }
    splat: fn(value: U64) -> U64x4 Never! { U64x4{lanes: [U64#4]{value, value, value, value}} }
    from_array: fn(lanes: [U64#4]) -> U64x4 Never! { U64x4{lanes: lanes} }
    to_array: fn(self) -> [U64#4] Never! { self.lanes.copy() }
    lane: fn(self, index: Int) -> U64 Never! {
        if index < 0 || index >= 4 -> core.math.__numeric_stop("lane index {index} out of range for U64x4 (4 lanes)")
        self.lanes[index]
    }
    sum: fn(self) -> U64 Never! {
        value := U64{0}
        loop i in 0..<4 -> value = value + self.lanes[i]
        value
    }
    product: fn(self) -> U64 Never! {
        value := U64{1}
        loop i in 0..<4 -> value = value * self.lanes[i]
        value
    }
    min: fn(self) -> U64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] < value -> value = self.lanes[i]
        }
        value
    }
    max: fn(self) -> U64 Never! {
        value := self.lanes[0]
        loop i in 1..<4 {
            if self.lanes[i] > value -> value = self.lanes[i]
        }
        value
    }
    reduce_add: fn(self) -> U64 Never! { self.sum() }
    reduce_mul: fn(self) -> U64 Never! { self.product() }
    reduce_min: fn(self) -> U64 Never! { self.min() }
    reduce_max: fn(self) -> U64 Never! { self.max() }
    reduce_avg: fn(self) -> U64 Never! { self.sum() / U64{4} }
    reduce: fn(self, op: ReduceOp) -> U64 Never! {
        if op == .Add -> return self.reduce_add()
        if op == .Mul -> return self.reduce_mul()
        if op == .Min -> return self.reduce_min()
        if op == .Max -> return self.reduce_max()
        self.reduce_avg()
    }
}
impl U64x4.Add {
    add: fn(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] + rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Sub {
    sub: fn(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] - rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Mul {
    mul: fn(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] * rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}
impl U64x4.Div {
    div: fn(self, rhs: U64x4) -> U64x4 Never! {
        lanes := self.lanes.copy()
        loop i in 0..<4 -> lanes[i] = lanes[i] / rhs.lanes[i]
        U64x4{lanes: lanes}
    }
}

#Test("SIMD lane types fold left to right and act lane by lane") {
    floats: F32x4.new(F32{1.0}, F32{2.0}, F32{3.0}, F32{4.0})
    assert_eq(floats.sum(), F32{10.0})
    assert_eq(floats.reduce(.Avg), F32{2.5})
    assert_eq((floats * floats).lane(3), F32{16.0})
    assert_eq(F32x8.splat(F32{0.5}).sum(), F32{4.0})
    assert_eq(F64x2.new(F64{NAN}, F64{2.0}).min(), F64{2.0})
    ints: I32x8.new(I32{1}, I32{2}, I32{3}, I32{4}, I32{5}, I32{6}, I32{7}, I32{8})
    assert_eq(ints.reduce(.Add), I32{36})
    assert_eq(ints.min(), I32{1})
    assert_eq((ints / I32x8.splat(I32{-2})).lane(2), I32{-1})
    assert_eq(U8x16.splat(U8{3}).sum(), U8{48})
}

// Stock coordinates retain the seed's frame-zero constructors and left frame.
