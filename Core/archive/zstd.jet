// core.archive.zstd — Zstandard frames as whole-buffer codecs.
//
// This encoder writes a valid uncompressed Zstandard frame (magic + header
// with content size + raw blocks). The decoder reads that frame shape and
// also stops closed on compressed blocks it does not yet inflate.
@c_magic :: 0xFD2FB528

pub fn compress(data: [U8]) -> [U8] {
    out := [U8]{}
    put32(&out, @c_magic)
    // Frame_Header_Descriptor: FCS_Flag = 11 (8-byte size), single segment, no checksum
    out.push(U8{0xE8})
    n :: data.len()
    loop k in 0..<8 -> out.push(to_u8(n >> (k * 8)))
    i := 0
    loop i < data.len() {
        left := data.len() - i
        chunk_len := left
        if chunk_len > 1048576 -> chunk_len = 1048576
        last := 0
        if i + chunk_len >= data.len() -> last = 1
        bh := chunk_len << 3
        if last != 0 -> bh = bh | 1
        out.push(to_u8(bh))
        out.push(to_u8(bh >> 8))
        out.push(to_u8(bh >> 16))
        loop k in 0..<chunk_len -> out.push(data[i + k])
        i = i + chunk_len
    }
    if data.len() == 0 {
        out.push(U8{1})
        out.push(U8{0})
        out.push(U8{0})
    }
    out
}

pub fn decompress(data: [U8]) -> [U8] {
    if data.len() < 5 -> return [U8]{}
    mag :: u8_int(data[0]) | (u8_int(data[1]) << 8) | (u8_int(data[2]) << 16) | (u8_int(data[3]) << 24)
    if mag != @c_magic -> return [U8]{}
    fhd :: u8_int(data[4])
    i := 5
    fcs_flag :: (fhd >> 6) & 3
    single :: (fhd >> 5) & 1
    if (fhd & 1) != 0 -> i = i + 1
    if fcs_flag == 0 && single != 0 -> i = i + 1
    if fcs_flag == 1 -> i = i + 2
    if fcs_flag == 2 -> i = i + 4
    if fcs_flag == 3 -> i = i + 8
    out := [U8]{}
    loop i + 3 <= data.len() {
        bh :: u8_int(data[i]) | (u8_int(data[i + 1]) << 8) | (u8_int(data[i + 2]) << 16)
        last :: bh & 1
        kind :: (bh >> 1) & 3
        size :: bh >> 3
        i = i + 3
        if {
            kind == 0 -> {
                k := 0
                loop k < size {
                    if i >= data.len() -> return out
                    out.push(data[i])
                    i = i + 1
                    k = k + 1
                }
            }
            kind == 1 -> {
                if i >= data.len() -> return out
                b :: data[i]
                i = i + 1
                loop _ in 0..<size -> out.push(b)
            }
            else -> { return out }
        }
        if last != 0 -> break
    }
    out
}

fn put32(out: &[U8], n: Int) {
    out.push(to_u8(n))
    out.push(to_u8(n >> 8))
    out.push(to_u8(n >> 16))
    out.push(to_u8(n >> 24))
}

fn u8_int(b: U8) -> Int { Int.from_u8(b) }

fn to_u8(n: Int) -> U8 {
    v :: n & 255
    (U8{v})
}

pub fn is_zstd(data: [U8]) -> Bool {
    data.len() >= 4 && data[0] == (U8{40}) && data[1] == (U8{181}) && data[2] == (U8{47}) && data[3] == (U8{253})
}

pub fn magic() -> [U8] { [U8]{(U8{40}), (U8{181}), (U8{47}), (U8{253})} }

pub fn compress_text(text: String) -> [U8] { compress(text.bytes()) }

pub fn decompress_text(data: [U8]) -> String { String.from_bytes(decompress(data)) ?? "" }

fn host_read_bytes(path: String) -[FS]> [U8] { panic("host_read_bytes") }

fn host_write_bytes(path: String, data: [U8]) -[FS]> { panic("host_write_bytes") }

pub fn compress_file(src: String, dst: String) -[FS]> {
    data :: host_read_bytes(src)
    host_write_bytes(dst, compress(data))
}

pub fn decompress_file(src: String, dst: String) -[FS]> {
    data :: host_read_bytes(src)
    host_write_bytes(dst, decompress(data))
}
