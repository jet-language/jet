use core as core

// core.archive.zstd — Zstandard frames as whole-buffer codecs.
//
// The encoder writes standards-valid single-segment frames with raw blocks.
// The decoder accepts raw and RLE blocks, validates frame sizes/checksums, and
// reports compressed blocks and dictionaries as explicit unsupported cases.
#Error
pub enum ZstdFileError {
    Read
    Write
    Malformed
    Unsupported
    Checksum
}

C_MAGIC :: 0xFD2FB528
C_MASK32 :: 4294967295
// XXH64 primes (Zstandard content checksum), as wrapping 64-bit words. They
// are function literals rather than module consts: the bootstrap compiler
// mis-evaluates module-level `U64` consts above 2^63.
fn xxh_p1() -> U64 Never! { U64{11400714785074694791} }
fn xxh_p2() -> U64 Never! { U64{14029467366897019727} }
fn xxh_p3() -> U64 Never! { U64{1609587929392839161} }
fn xxh_p4() -> U64 Never! { U64{9650029242287828579} }
fn xxh_p5() -> U64 Never! { U64{2870177450012600261} }

/// Encode one single-segment frame of raw blocks. Input above the 64 MiB codec
/// budget is `ZstdFileError.Unsupported`, never an empty buffer.
pub fn compress(data: [U8]) -> [U8] ZstdFileError! {
    if data.len() > 67108864 -> return Err(ZstdFileError.Unsupported)
    out := [U8]{}
    put32(&out, C_MAGIC)
    // Frame_Header_Descriptor: FCS_Flag = 11 (8-byte size), single segment, no checksum
    &out.push(U8{0xE0})
    n :: data.len()
    loop k in 0..<8 -> &out.push(to_u8(n >> (k * 8)))
    i := 0
    loop i < data.len() {
        left := data.len() - i
        chunk_len := left
        if chunk_len > 131072 -> chunk_len = 131072
        last := 0
        if i + chunk_len >= data.len() -> last = 1
        bh := chunk_len << 3
        if last != 0 -> bh = bh | 1
        &out.push(to_u8(bh))
        &out.push(to_u8(bh >> 8))
        &out.push(to_u8(bh >> 16))
        loop k in 0..<chunk_len -> &out.push(data[i + k])
        i = i + chunk_len
    }
    if data.len() == 0 {
        &out.push(U8{1})
        &out.push(U8{0})
        &out.push(U8{0})
    }
    Ok(out)
}
/// Decode one or more supported Zstandard frame blocks. Raw and RLE blocks
/// are decoded; dictionaries and compressed blocks return `ZstdFileError.Unsupported`.
pub fn decompress(data: [U8]) -> [U8] ZstdFileError! {
    if data.len() < 5 -> return Err(ZstdFileError.Malformed)
    mag :: u8_int(data[0]) | (u8_int(data[1]) << 8) | (u8_int(data[2]) << 16) | (u8_int(data[3]) << 24)
    if mag != C_MAGIC -> return Err(ZstdFileError.Malformed)
    fhd :: u8_int(data[4])
    if (fhd & 24) != 0 -> return Err(ZstdFileError.Malformed)
    i := 5
    fcs_flag :: (fhd >> 6) & 3
    single :: (fhd >> 5) & 1
    dict_flag :: fhd & 3
    if single == 0 {
        if i >= data.len() -> return Err(ZstdFileError.Malformed)
        i = i + 1
    }
    dict_bytes := 0
    if dict_flag == 1 -> dict_bytes = 1
    if dict_flag == 2 -> dict_bytes = 2
    if dict_flag == 3 -> dict_bytes = 4
    if i + dict_bytes > data.len() -> return Err(ZstdFileError.Malformed)
    dict_id := 0
    loop k in 0..<dict_bytes -> dict_id = dict_id | (u8_int(data[i + k]) << (k * 8))
    if dict_bytes > 0 || dict_id != 0 -> return Err(ZstdFileError.Unsupported)
    i = i + dict_bytes
    fcs_bytes := 0
    if fcs_flag == 0 {
        if single != 0 -> fcs_bytes = 1
    }
    if fcs_flag == 1 -> fcs_bytes = 2
    if fcs_flag == 2 -> fcs_bytes = 4
    if fcs_flag == 3 -> fcs_bytes = 8
    if i + fcs_bytes > data.len() -> return Err(ZstdFileError.Malformed)
    expected := -1
    if fcs_bytes > 0 {
        expected = 0
        loop k in 0..<fcs_bytes -> expected = expected | (u8_int(data[i + k]) << (k * 8))
        if fcs_bytes == 2 && single != 0 -> expected = expected + 256
        if expected > 67108864 -> return Err(ZstdFileError.Unsupported)
        i = i + fcs_bytes
    }
    out := [U8]{}
    last_seen := false
    loop {
        if i + 3 > data.len() -> return Err(ZstdFileError.Malformed)
        bh :: u8_int(data[i]) | (u8_int(data[i + 1]) << 8) | (u8_int(data[i + 2]) << 16)
        last :: bh & 1
        kind :: (bh >> 1) & 3
        size :: bh >> 3
        i = i + 3
        if kind == 2 -> return Err(ZstdFileError.Unsupported)
        if kind == 3 -> return Err(ZstdFileError.Malformed)
        if size > 131072 -> return Err(ZstdFileError.Malformed)
        if kind == 0 {
            if size > 67108864 - out.len() -> return Err(ZstdFileError.Unsupported)
            if i + size > data.len() -> return Err(ZstdFileError.Malformed)
            loop k in 0..<size -> &out.push(data[i + k])
            i = i + size
        } else {
            if size > 67108864 - out.len() -> return Err(ZstdFileError.Unsupported)
            if i >= data.len() -> return Err(ZstdFileError.Malformed)
            b :: data[i]
            i = i + 1
            loop _ in 0..<size -> &out.push(b)
        }
        if last != 0 {
            last_seen = true
            break
        }
    }
    if !last_seen -> return Err(ZstdFileError.Malformed)
    if expected >= 0 && expected != out.len() -> return Err(ZstdFileError.Malformed)
    if (fhd & 4) != 0 {
        if i + 4 > data.len() -> return Err(ZstdFileError.Malformed)
        if read_u32le(data, i) != xxh64_low32(out) {
            return Err(ZstdFileError.Checksum)
        }
        i = i + 4
    }
    if i != data.len() -> return Err(ZstdFileError.Malformed)
    Ok(out)
}

fn put32(out: &[U8], n: Int) Never! {
    &out.push(to_u8(n))
    &out.push(to_u8(n >> 8))
    &out.push(to_u8(n >> 16))
    &out.push(to_u8(n >> 24))
}

fn u8_int(b: U8) -> Int Never! { Int.from_u8(b) }

fn to_u8(n: Int) -> U8 Never! {
    v :: n & 255
    (U8{v})
}

fn read_u32le(data: [U8], i: Int) -> Int Never! {
    u8_int(data[i]) | (u8_int(data[i + 1]) << 8) | (u8_int(data[i + 2]) << 16) | (u8_int(data[i + 3]) << 24)
}

fn read_u64le(data: [U8], i: Int) -> U64 Never! {
    n := U64{0}
    k := 7
    loop k >= 0 {
        n = n.wrapping_mul(U64{256}).wrapping_add(U64.from_u8(data[i + k]))
        k = k - 1
    }
    n
}

// Rotation as wrapping multiply plus shift: `x.wrapping_mul(2^r)` drops the
// high bits exactly like a 64-bit left shift, so no step can overflow.
fn rotl64(x: U64, r: Int) -> U64 Never! {
    x.wrapping_mul(U64{1} << r) | (x >> (64 - r))
}

fn xxh_round(acc: U64, input: U64) -> U64 Never! {
    rotl64(acc.wrapping_add(input.wrapping_mul(xxh_p2())), 31).wrapping_mul(xxh_p1())
}

fn xxh_merge_round(acc: U64, value: U64) -> U64 Never! {
    (acc ~| xxh_round(U64{0}, value)).wrapping_mul(xxh_p1()).wrapping_add(xxh_p4())
}

/// XXH64 with seed 0 (Zstandard frame content checksum). Every step is
/// explicit 64-bit wrapping arithmetic, so no value leaves the U64 domain.
fn xxh64(data: [U8]) -> U64 Never! {
    n :: data.len()
    i := 0
    h := U64{0}
    if n >= 32 {
        // P1 + P2 and 0 - P1, both modulo 2^64.
        v1 := U64{6983438078262162902}
        v2 := xxh_p2()
        v3 := U64{0}
        v4 := U64{7046029288634856825}
        loop i + 32 <= n {
            v1 = xxh_round(v1, read_u64le(data, i))
            v2 = xxh_round(v2, read_u64le(data, i + 8))
            v3 = xxh_round(v3, read_u64le(data, i + 16))
            v4 = xxh_round(v4, read_u64le(data, i + 24))
            i = i + 32
        }
        h = rotl64(v1, 1).wrapping_add(rotl64(v2, 7)).wrapping_add(rotl64(v3, 12)).wrapping_add(rotl64(v4, 18))
        h = xxh_merge_round(h, v1)
        h = xxh_merge_round(h, v2)
        h = xxh_merge_round(h, v3)
        h = xxh_merge_round(h, v4)
    } else {
        h = xxh_p5()
    }
    h = h.wrapping_add(U64.from_int(n) ?? U64{0})
    loop i + 8 <= n {
        h = rotl64(h ~| xxh_round(U64{0}, read_u64le(data, i)), 27).wrapping_mul(xxh_p1()).wrapping_add(xxh_p4())
        i = i + 8
    }
    if i + 4 <= n {
        lane :: U64.from_int(read_u32le(data, i)) ?? U64{0}
        h = rotl64(h ~| lane.wrapping_mul(xxh_p1()), 23).wrapping_mul(xxh_p2()).wrapping_add(xxh_p3())
        i = i + 4
    }
    loop i < n {
        h = rotl64(h ~| U64.from_u8(data[i]).wrapping_mul(xxh_p5()), 11).wrapping_mul(xxh_p1())
        i = i + 1
    }
    h = h ~| (h >> 33)
    h = h.wrapping_mul(xxh_p2())
    h = h ~| (h >> 29)
    h = h.wrapping_mul(xxh_p3())
    h ~| (h >> 32)
}

fn xxh64_low32(data: [U8]) -> Int Never! {
    Int.from_u64(xxh64(data) & U64{4294967295})
}

pub fn is_zstd(data: [U8]) -> Bool Never! {
    data.len() >= 4 && data[0] == (U8{40}) && data[1] == (U8{181}) && data[2] == (U8{47}) && data[3] == (U8{253})
}

pub fn magic() -> [U8] Never! { [U8]{(U8{40}), (U8{181}), (U8{47}), (U8{253})} }

pub fn compress_text(text: String) -> [U8] ZstdFileError! { compress(text.bytes()) }

pub fn decompress_text(data: [U8]) -> String ZstdFileError! {
    body :: decompress(data)
    String.from_bytes(body) ?? return Err(ZstdFileError.Malformed)
}

fn host_read_bytes(path: String) -[FS]> [U8] ZstdFileError! {
    core.files.read_bytes(path) ?? return Err(ZstdFileError.Read)
}

fn host_write_bytes(path: String, data: [U8]) -> Bool ZstdFileError! {
    core.files.write_bytes(path, data) ?? return Err(ZstdFileError.Write)
    Ok(true)
}

pub fn compress_file(src: String, dst: String) -> Bool ZstdFileError! {
    data :: host_read_bytes(src)
    encoded :: compress(data)
    host_write_bytes(dst, encoded)
}

pub fn decompress_file(src: String, dst: String) -> Bool ZstdFileError! {
    data :: host_read_bytes(src)
    body :: decompress(data)
    host_write_bytes(dst, body)
}
