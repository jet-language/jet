fn work(value: Int) Int -> value * 2

fn run() {
    first :: task work(5)
    second :: task work(7)
    first_value :: first.join() ?? return
    second_value :: second.join() ?? return
    values := [Int]{first_value, second_value}
    values.sort()
    print("results={values[0]},{values[1]} order=sorted")
}
