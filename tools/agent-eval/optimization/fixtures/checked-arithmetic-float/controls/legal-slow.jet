// Legal slow control: helper call keeps the exact ordered arithmetic.
fn add_checked(left: Int, right: Int) Int -> left + right

fn run() {
    first :: Float{10000000000000000.0} + Float{-10000000000000000.0}
    float_value :: first + Float{1.0}
    checked :: add_checked(100, 23)
    print(float_value == Float{1.0})
    print(checked)
}
