// Negative control: changed kernel result must not be hidden by a parallel speed claim.
fn run() {
    values := [Int]{}
    loop index in 0..<1024 {
        values.push(index)
    }
    results :: values.para_map((value: Int) -> value * (value + 1), limit: 2)
    print("{results[0]}:{results[1023]}")
}
