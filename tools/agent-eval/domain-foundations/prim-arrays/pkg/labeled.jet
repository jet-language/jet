use core.compute as compute

pub struct Coordinate {
    pub name: String
    pub labels: [String]
}

pub struct LabeledArray {
    pub values: Tensor
    pub dims: [String]
    pub coords: [Coordinate]
}

pub fn find_text(xs: [String], needle: String) ?Int -> {
    i := 0
    loop i < xs.len() {
        if xs[i] == needle -> return Val(i)
        i += 1
    }
    return None
}


 
pub fn coordinate(name: String, labels: [String]) Coordinate -> Coordinate{name: name, labels: labels}

pub fn make(values: Tensor, dims: [String], coords: [Coordinate]) LabeledArray -> LabeledArray{
    values: values,
    dims: dims,
    coords: coords
}
