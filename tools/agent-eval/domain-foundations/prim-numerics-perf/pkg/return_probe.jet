struct Buffers {
    re: [Float]
    im: [Float]
}

fn mutate(re0: ^[Float], im0: ^[Float]) Buffers -> {
    re := re0
    im := im0
    re[0] = Float{9.0}
    return Buffers{re: re, im: im}
}

fn run() {
    re := [Float]{Float{1.0}, Float{2.0}}
    im := [Float]{Float{3.0}, Float{4.0}}
    out :: mutate(^re, ^im)
    print(out.re)
    print(out.im)
}
