use core.files as fs
use "log" as log

fn run() {
    root :: "/home/nate/.cache/jet-luna/dx3/prim-storage/setup"
    if fs.exists(root) -> fs.remove_all(root) ?? panic("cleanup")
    fs.create_dir_all(root) ?? panic("create")
    p :: Path.from(root).join("x.log")
    a :: log.append_record(~p, "a") ?? false
    fs.append_all(~p, "b") ?? panic("b")
    print("{a}")
}
