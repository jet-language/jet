fn join(prefix: String, parts: ...String) String -> [prefix, ...parts].join(" ")

fn forward(prefix: String, parts: ...String) String -> join(prefix, ...parts)
fn forward_twice(prefix: String, parts: ...String) String -> forward(prefix, ...parts)
fn forward_thrice(prefix: String, parts: ...String) String -> forward_twice(prefix, ...parts)

fn run() {
    print(forward_thrice("v", "a", "b", "c", "d"))
}
