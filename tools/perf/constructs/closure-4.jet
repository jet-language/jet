fn run() {
    nums :: [1, 2, 3]
    offset :: 1
    factor :: 2
    threshold :: 4
    bonus :: 3
    shifted :: nums.map((n: Int) -> (n + offset))
    scaled :: shifted.map((n: Int) -> (n * factor))
    filtered :: scaled.filter(n -> (n > threshold))
    print(filtered.map((n: Int) -> (n + bonus)))
}
