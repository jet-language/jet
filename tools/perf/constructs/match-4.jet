enum Choice {
    A(Int)
    B(Int)
    C(Int)
    D(Int)
    E(Int)
    F(Int)
    G(Int)
    H(Int)
    Done
}

fn score(choice: Choice) Int -> {
    if choice == {
        .A(value) -> { return value }
        .B(value) -> { return value }
        .C(value) -> { return value }
        .D(value) -> { return value }
        .E(value) -> { return value }
        .F(value) -> { return value }
        .G(value) -> { return value }
        .H(value) -> { return value }
        .Done -> { return 0 }
        else -> { return 0 }
    }
}

fn run() {
    print(score(Choice.A(1)))
}
