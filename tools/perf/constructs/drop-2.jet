use core.mem.scope as _scope

#Error
enum Fail {
    Bad
}

fn with_guards(succeed: Bool) Int !Fail -> {
    _g1 :: _scope.guard(() -> print("guard 1 runs"))
    _g2 :: _scope.guard(() -> print("guard 2 runs"))
    _g3 :: _scope.guard(() -> print("guard 3 runs"))
    _g4 :: _scope.guard(() -> print("guard 4 runs"))
    if succeed -> return Ok(42)
    return Err(Fail.Bad)
}

fn question_path() Int !Fail -> {
    _cleanup :: _scope.guard(() -> print("cleanup before ?"))
    n :: with_guards(false)
    return Ok(n)
}

fn run() {
    r1 :: with_guards(true) ?? 0
    print(r1)
    r2 :: question_path() ?? -1
    print(r2)
}
