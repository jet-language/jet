use core.mem.scope as scope

enum Fail {
    Bad
}

fn with_guards(succeed: Bool) Int Fail! -> {
    _g1 :: scope.guard(() -> print("guard 1 runs"))
    _g2 :: scope.guard(() -> print("guard 2 runs"))
    _g3 :: scope.guard(() -> print("guard 3 runs"))
    _g4 :: scope.guard(() -> print("guard 4 runs"))
    _g5 :: scope.guard(() -> print("guard 5 runs"))
    _g6 :: scope.guard(() -> print("guard 6 runs"))
    _g7 :: scope.guard(() -> print("guard 7 runs"))
    _g8 :: scope.guard(() -> print("guard 8 runs"))
    if succeed -> return Ok(42)
    return Err(Fail.Bad)
}

fn question_path() Int Fail! -> {
    _cleanup :: scope.guard(() -> print("cleanup before ?"))
    n :: with_guards(false)?
    return Ok(n)
}

fn run() {
    r1 :: with_guards(true) ?? 0
    print(r1)
    r2 :: question_path() ?? -1
    print(r2)
}
