module box<T> {
    pub fn render(value: T) String -> "box"
}

module int_box :: box<Int>
module string_box :: box<String>
module bool_box :: box<Bool>
module char_box :: box<Char>

fn run() {
    print(int_box.render(1))
    print(string_box.render("two"))
    print(bool_box.render(true))
    print(char_box.render('J'))
}
