// D-NAME-ALIAS1=A: the readable logical `core/prelude.jet` module.
//
// These declarations name the ambient surface. Their meaning stays in the
// embedded Prelude/CoreLib implementations; sema opens this module once per
// file and resolves each alias through the ordinary Core call path.
pub fn print(value: Any)
pub fn input(prompt: String = "") -> String ? IOError
pub fn panic(message: String)
pub fn require(cond: Bool)
pub fn assert(cond: Bool)
pub fn assert_eq(a: Any, b: Any)

pub use core.io.[eprint]
pub use core.time.[Clock, Instant, Date, Duration]
pub use core.files.[Path, read as read_file, write as write_file, exists as file_exists]
pub use core.comptime.[embed_file, embed_bytes, find, fetch]
