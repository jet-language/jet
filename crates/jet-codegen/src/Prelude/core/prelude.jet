// D-NAME-ALIAS1=A: the readable logical `core/prelude.jet` module.
//
// These declarations name the ambient surface. Their meaning stays in the
// embedded Prelude/CoreLib implementations; sema opens this module once per
// file and resolves each alias through the ordinary Core call path.
pub fn print(value: Any)
pub fn input(prompt: String{""}) -> String IOError!
pub fn panic(message: String)
pub fn assert(cond: Bool)
pub fn assert_eq(a: Any, b: Any)
// D-DBG1=A: `debug(value)` returns `value` unchanged and, in development
// builds, writes `[debug] file.jet:LINE expr = <Debug form>` to stderr. It adds
// no effect; a shipped artifact or release-profile build rejects it (E3405).
pub fn debug<T>(value: T) -> T

// D-TEXTHEAD-TYPE1=A: checked text is an ordinary nominal String-backed type
// with one ordinary CheckedText implementation. The trait has one associated
// check error, one pure complete-text checker, and one pure generic hole encoder.
pub trait CheckedText {
    type Error
    fn check(text: String) Error! -[]>
    fn encode_hole<T: Printable>(value: T) String -[]>
}

// D-BENCH-KEEP1=A: measurement claims use the one always-available identity
// sink; its AOT implementation is the shared Prelude black-box kernel.
pub use core.prelude.[keep]
pub use core.term.[eprint]
pub use core.time.[Clock, Instant, Date, Duration]
pub use core.files.[Path, read as read_file, write as write_file, exists as file_exists]
pub fn channel<T>(capacity: Int{0})
pub use core.comptime.[embed_file, embed_bytes, find, fetch]
