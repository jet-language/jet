// D-FACT-LAW1=B / D-FACTDECL1=A: compiler fact rows are written here.
//
// Each row names what it holds, its safe direction, and every word that can
// move the fact away from safety. Prover rows name their publisher and still
// carry the same law columns.

// D-TYPE2-PLANE1=A / D-TYPE2-FOUND1=A: compiler type planes are ordinary
// readable Prelude rows. `@name` gives the row its dotted compiler namespace;
// `@identity` states whether the plane contributes to carrier identity.
fact TypeNominal(@name: "Type.Nominal", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeInterval(@name: "Type.Interval", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeLayout(@name: "Type.Layout", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeMeasure(@name: "Type.Measure", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeDimension(@name: "Type.Dimension", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeClassification(@name: "Type.Classification", @holds: .Value, @safe: .Gain, @gates: [], @identity: false, @decision: "D-TYPE2-FOUND1")
fact TypeExactness(@name: "Type.Exactness", @holds: .Value, @safe: .Gain, @gates: [], @identity: true, @decision: "D-TYPE2-FOUND1")
fact TypeObligation(@name: "Type.Obligation", @holds: .Value, @safe: .Gain, @gates: [], @identity: false, @decision: "D-TYPE2-FOUND1")

fact Exactness(@holds: .Value, @safe: .Gain, @gates: [approx, raw, wrapping], @decision: "D-TYPE2-EXACT1")
fact Flow(@holds: .Value, @safe: .Gain, @gates: [], @decision: "D-FLOWTYPE1")
fact Taint(@holds: .Value, @safe: .Gain, @gates: [Scrub], @decision: "D-TAG-SURFACE1")
fact Duty(@holds: .Value, @safe: .Discharge, @gates: [detach, drop], @decision: "D-CONC-JOIN1")
fact Rights(@holds: .Scope, @safe: .Shrink, @gates: [Unsafe, Impure, Grant], @decision: "D-AUTHORITY-MODEL1")
fact PackagePolicy(@holds: .Scope, @safe: .Shrink, @gates: [Unsafe, Grant], @decision: "D-PACKAGE-POLICY-SCOPE1")
fact BuildSettings(@holds: .Build, @safe: .Shrink, @gates: [Force], @decision: "D-CONF-MERGE1")
fact Effects(@holds: .Value, @safe: .Gain, @gates: [], @decision: "D-FACT-READ1")
fact States(@holds: .Value, @safe: .Gain, @gates: [], @decision: "D-FACT-READ1")
fact Sendability(@holds: .Value, @safe: .None, @gates: [], @proved_by: ownership, @decision: "D-FACT-OWN1")
fact ViewProvenance(@holds: .Value, @safe: .None, @gates: [], @proved_by: ownership, @decision: "D-MEMPROVENANCE3")
fact Movedness(@holds: .Value, @safe: .None, @gates: [], @proved_by: ownership, @decision: "D-MEM1")
fact Attribution(@holds: .Value, @safe: .None, @gates: [], @decision: "D-FACT-HOME1")
fact TrackOrigin(@holds: .Value, @safe: .None, @gates: [], @decision: "D-PROVENANCE1")
fact UnitScaleProvenance(@holds: .Value, @safe: .None, @gates: [], @decision: "D-UNIT-SCALE-PROVENANCE1")
fact Maturity(@holds: .Value, @safe: .None, @gates: [], @decision: "D-MARK-META1")
