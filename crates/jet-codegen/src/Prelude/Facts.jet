// D-FACT-LAW1=B / D-FACTDECL1=A: compiler fact rows are written here.
//
// Each row names what it holds, its safe direction, and every word that can
// move the fact away from safety. Prover rows name their publisher and still
// carry the same law columns.

fact Exactness($holds: .Value, $safe: .Gain, $gates: [approx, raw, wrapping], $decision: "D-TYPE2-EXACT1")
fact Flow($holds: .Value, $safe: .Gain, $gates: [], $decision: "D-FLOWTYPE1")
fact Taint($holds: .Value, $safe: .Gain, $gates: [Scrub], $decision: "D-TAG-SURFACE1")
fact Duty($holds: .Value, $safe: .Discharge, $gates: [detach, drop], $decision: "D-CONC-JOIN1")
fact Rights($holds: .Scope, $safe: .Shrink, $gates: [Unsafe, Impure, Grant], $decision: "D-AUTHORITY-MODEL1")
fact PackagePolicy($holds: .Scope, $safe: .Shrink, $gates: [Unsafe, Grant], $decision: "D-PACKAGE-POLICY-SCOPE1")
fact BuildSettings($holds: .Build, $safe: .Shrink, $gates: [Force], $decision: "D-CONF-MERGE1")
fact Sendability($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership, $decision: "D-FACT-OWN1")
fact ViewProvenance($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership, $decision: "D-MEMPROVENANCE3")
fact Movedness($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership, $decision: "D-MEM1")
