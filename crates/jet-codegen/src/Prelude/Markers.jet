// The marker vocabulary is written here, not in Rust.
//
// This is ordinary Jet source in the ratified `marker Name(params…)` form
// . One row per marker. The compiler reads
// this file to build its registry, so a marker exists exactly when it is
// written here (law zero).
//
// A plain parameter is an argument the use site writes: `name: Type` with an
// optional `{default}`. A `$`-marked parameter is a fact about the rule
// itself:
//
//   $sites        the attachment points the rule accepts, `[]` for none
//   $repeatable   the rule may be written more than once on one target
//   $owns_menu    the rule teaches its own argument menu in its own error
//   $inherits     the rule takes part in lexical policy inheritance
//   $resolution   how nested writings combine: .Override, .Merge, .Tighten
//   $scopes       the policy scopes the rule may be written at
//   $companion    `[Rule, .Site]` — one extra site a companion rule opens
//
// `$sites` is the only public legal-site declaration form. Ordinary names
// are typed use-site arguments; every `$` name is fixed declaration metadata.
//
marker Policy(settings: ...PolicySetting, $sites: [.Package, .Module, .Function, .Method, .Block], $inherits: true, $resolution: .Tighten, $scopes: [.Package, .Module, .Function, .Block])

marker Arithmetic(mode: ArithmeticMode, $sites: [.Function, .Method, .Block])

marker Unsafe(reason: String, obligations: ObligationMode{.None}, $sites: [.Function, .Method, .Block, .Operation])

marker Scrub(tag: Ident, $sites: [.Function, .Method])

marker Memo(bound: MemoBound{.Default}, $sites: [.Function, .Field])

marker Pre(condition: Value, message: String, $sites: [.Function, .Method], $repeatable: true)

marker Post(condition: Value, message: String, $sites: [.Function, .Method], $repeatable: true)

// These rows stay separate. Kernel requests a checked
// worker-boundary proof; Inline(Always) is a checked promise, not a hint.
marker Kernel(mode: KernelMode, $sites: [.Function])

marker Inline(mode: InlineMode{.Hint}, $sites: [.Function, .Method, .Constant])

// Native auto-vectorization is the safe default; this explicit
// function/method marker keeps scalar codegen available for reproducibility or
// a workload whose measured result favors scalar execution.
marker Scalar($sites: [.Function, .Method])
// A typed Add/Mul impl may derive its reverse lookup.
marker Commutative($sites: [.Impl])

marker Job(scope: JobScope{.Dev}, packages: Value{[]}, cwd: Value{none}, inputs: Value{[]}, outputs: Value{[]}, skip: Value{none}, cache: Value{.Uncached}, limits: Value{none}, after: Value{[]}, parallel: Value{none}, $sites: [.Function])

marker Every(schedule: Duration | String, $sites: [.Function])

marker Replayable($sites: [.Function, .Method])

marker WasmExport($sites: [.Function])

marker State(state: State, $sites: [.Function, .Method])

marker Transition(from: State, to: State, $sites: [.Function, .Method])

marker FFI(language: FFILanguage, $sites: [.Function], $owns_menu: true)

marker Undo(inverse: Ident, $sites: [.Function])

marker Close(close: Ident, $sites: [.Function])

marker ABI(name: ABI, $sites: [.Function])

marker MustUse($sites: [.Function, .Method, .Type])

marker Error($sites: [.Type])

// The one retiring lifecycle rung. `removed_in` is
// optional until package editions own removal; before then it remains warn-only.
marker Deprecated(since: String, use: String, removed_in: String{none}, $sites: [.Function, .Method, .Type])

marker Codable($sites: [.Type])

// Named typed receipt section declaration.
marker Receipt(name: String, $sites: [.Type])

marker Encode($sites: [.Type])

marker Decode($sites: [.Type])

marker PublishedSchema($sites: [.Type])

marker Comparable($sites: [.Type])

marker Equatable($sites: [.Type])

marker Debug($sites: [.Type])

marker Numeric($sites: [.Type])

marker Printable($sites: [.Type])

marker CodableAsBase($sites: [.Type])

marker CLI(pack: Ident{none}, $sites: [.Type])

marker Patchable($sites: [.Type])

marker UnitFamily(family: Ident, dimension: Value{nominal}, base: Ident{"first member when converting"}, $sites: [.Type])

marker SingleUse($sites: [.Type])

// Structs use the second argument for `align(N)`; enums retain
// the legacy bare tag-width argument in this same registry slot.
marker Layout(kind: Layout, tag: Value{none}, $sites: [.Type])

marker RenameAll(case: NamingCase, $sites: [.Type], $owns_menu: true)

marker DenyUnknownFields($sites: [.Type])

marker Discriminant(field: String, $sites: [.Type])

marker Untagged($sites: [.Type])

marker Redact($sites: [.Field])

marker Rename(name: String, json: String{none}, cbor: String{none}, csv: String{none}, toml: String{none}, yaml: String{none}, xml: String{none}, args: String{none}, env: String{none}, db: String{none}, layout: String{none}, $sites: [.Field, .Variant])

marker Skip($sites: [.Field])

marker Flatten($sites: [.Field])

marker Doc(text: String, $sites: [.Field, .Type, .Variant, .Method], $companion: [Job, .Function])

marker Flag($sites: [.Field])

marker Short(name: String, $sites: [.Field])

marker Env(name: String, $sites: [.Field])

marker Persist($sites: [.Declaration])

marker Track($sites: [.Declaration])

marker Local($sites: [.Declaration])

marker Shared($sites: [.Declaration])

marker Meta(category: String{""}, tunable: Bool{false}, maturity: Maturity{.Tested}, $sites: [.Function, .Method, .Declaration, .Constant])
// Exported devtools panels are discovered from one typed
// function marker; no startup registration call or second metadata surface.
marker DevPanel($sites: [.Function])

marker Todo($sites: [.Expression])

marker Shield($sites: [.Block])

marker Impure(reason: String{none}, $sites: [.Block])

marker FX(grant: ...Effect, $sites: [.Block])

marker Transact(name: Ident, $sites: [.Block])

marker Region(name: Ident, $sites: [.Block])

marker Live($sites: [.Block])

marker Nondeterministic(reason: String, $sites: [.Block])

marker Context(allocator: Value{default}, logger: Value{default}, deadline: Int{default}, $sites: [.Block])

marker Reactive($sites: [.Function, .Method, .Block])

marker Off($sites: [.Statement, .Block])

marker DebugOnly($sites: [.Statement, .Block])

// Test-only effect substitution is configured by one typed
// marker argument; the harness owns fail-nth scheduling.
// `.expect_fail([E30xx,] message: "text")` checks a
// region's raw stop message. Whole-test expected_fail remains the known-bug mark.
marker Test(name: String{"function name"}, faults: [Effect]{[]}, expected_fail: Bool{false}, $sites: [.Test])

marker Target(target: Target, $sites: [.File, .Module, .Function])
// #2793: target interrupt vector plus bounded effect row.
marker Interrupt(vector: Ident, effects: [Effect], $sites: [.Function])

marker Root($sites: [.Parameter])

marker HTML(page: Path, $sites: [.File, .Block])

marker NoPrelude($sites: [.File])

marker SQL(row: Type{none}, $sites: [.Block])

marker Bindgen($sites: [.Module])

marker allow(lint: Ident, reason: String{none}, $sites: [.Declaration, .Field, .Statement], $repeatable: true)

// Stable-address storage is not a code-generation hint.
marker Static($sites: [.Constant])

marker wire($sites: [.Field])

