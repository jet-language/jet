// Ownable Button component. Its output is the canonical core.ui UiNode used by
// every backend; copied projects do not inherit a private view-tree runtime.
use core.ui as ui

struct Button {
    label: String
    clicks: Int
}

fn button(label: String) => Button {
    return Button.{label: ~label, clicks: 0}
}

fn press(b: Button) => Button {
    return Button.{label: ~b.label, clicks: b.clicks + 1}
}

fn to_view(b: Button) => UiNode :: ui.button("[{b.label}] clicks={b.clicks}")
fn run() {
    b := button("Save")
    backend := ui.null_backend()
    backend.paint(to_view(b))
    print("[{b.label}] clicks={b.clicks}")
    b = press(press(b))
    backend.paint(to_view(b))
    print("[{b.label}] clicks={b.clicks}")
}
