// Ownable Label component over canonical core.ui UiNode.
use core.ui as ui

struct Label { text: String }

fn label(text: String) => Label {
    return Label.{text: ~text}
}

fn to_view(value: Label) => UiNode :: ui.text(value.text)
fn run() {
    value := label("hello, world")
    backend := ui.null_backend()
    backend.paint(to_view(value))
    print(value.text)
}
