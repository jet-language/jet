// Ownable Container component over the one canonical core.ui tree.
use core.ui as ui

fn container(children: [UiNode]) -> UiNode {
    return ui.box(children)
}

fn text(value: String) -> UiNode {
    return ui.text(value)
}

fn run() {
    row := container([text("Name:"), text("Ada")])
    nested := container([row, text("Save")])
    backend := ui.null_backend()
    backend.paint(nested)
    print("Name: Ada")
    print("Name: Ada Save")
}
