// D-FOUND-PLATFORM1 / #2815: the first-party GUI battery keeps editor state,
// Unicode-safe editing, persistence policy, and view composition in ordinary Jet
// code. Host boundaries remain the canonical core.ui.host/core.font calls.
use core.font as font
use core.text as text
use core.ui as ui
use core.ui.host as host
use core.ui.host.clipboard as clipboard
use core.ui.host.ime as ime
use core.ui.host.drag_drop as drag_drop
use core.ui.host.shortcuts as shortcuts
use core.ui.host.accessibility as accessibility

module gui {

    struct TextSelection {
        anchor: Int
        active: Int
    }

    struct TextEdit {
        text: String
        selection: TextSelection
    }

    struct EditorState {
        body: String
        title: String
        theme: String
        settings_open: Bool
        selection: TextSelection
        composition: String
        undo: [String]
        redo: [String]
        revision: Int
        status: String
    }

    struct SessionSettings {
        theme: String
        settings_open: Bool
    }

    fn clamp_offset(value: String, offset: Int) -> Int {
        limit :: text.scalar_count(value)
        if offset < 0 -> return 0
        if offset > limit -> return limit
        return offset
    }

    fn snap_boundary(value: String, offset: Int) -> Int {
        bounded :: clamp_offset(value, offset)
        clusters :: text.graphemes(value)
        cursor := 0
        loop cluster in clusters {
            next :: cursor + text.scalar_count(cluster)
            if bounded <= cursor -> return cursor
            if bounded < next -> return cursor
            cursor = next
        }
        cursor
    }

    fn grapheme_boundary(value: String, grapheme_index: Int) -> Int {
        clusters :: text.graphemes(value)
        bounded :: if grapheme_index < 0 -> 0 else -> grapheme_index
        offset := 0
        position := 0
        loop cluster in clusters {
            if position >= bounded -> break
            offset += text.scalar_count(cluster)
            position += 1
        }
        offset
    }

    fn grapheme_index(value: String, offset: Int) -> Int {
        boundary :: snap_boundary(value, offset)
        clusters :: text.graphemes(value)
        cursor := 0
        index := 0
        loop cluster in clusters {
            if cursor >= boundary -> break
            cursor += text.scalar_count(cluster)
            index += 1
        }
        index
    }

    fn selection(anchor: Int, active: Int) -> TextSelection {
        TextSelection{anchor: anchor, active: active}
    }

    fn normalize_selection(value: String, current: TextSelection) -> TextSelection {
        anchor :: snap_boundary(value, current.anchor)
        active :: snap_boundary(value, current.active)
        TextSelection{anchor: anchor, active: active}
    }

    fn selection_start(value: String, current: TextSelection) -> Int {
        normalized :: normalize_selection(value, current)
        if normalized.anchor < normalized.active -> normalized.anchor
        normalized.active
    }

    fn selection_end(value: String, current: TextSelection) -> Int {
        normalized :: normalize_selection(value, current)
        if normalized.anchor > normalized.active -> normalized.anchor
        normalized.active
    }

    fn selected_text(value: String, current: TextSelection) -> String {
        start :: selection_start(value, current)
        end :: selection_end(value, current)
        text.scalars(value).slice(start, end).join("")
    }

    // Text offsets are stored at Unicode grapheme boundaries. The host editor
    // can add platform-specific cursor, IME, and selection events unchanged.
    fn replace_selection(value: String, current: TextSelection, replacement: String) -> TextEdit {
        start :: selection_start(value, current)
        end :: selection_end(value, current)
        scalars :: text.scalars(value)
        prefix :: scalars.slice(0, start).join("")
        suffix :: scalars.slice(end, scalars.len()).join("")
        next :: "{prefix}{replacement}{suffix}"
        cursor :: start + text.scalar_count(replacement)
        TextEdit{
            text: next.copy(),
            selection: TextSelection{anchor: cursor, active: cursor},
        }
    }

    fn move_cursor(value: String, current: TextSelection, delta: Int) -> TextSelection {
        normalized :: normalize_selection(value, current)
        base :: if normalized.anchor == normalized.active -> normalized.active else if delta < 0 -> selection_start(value, normalized) else -> selection_end(value, normalized)
        base_index :: grapheme_index(value, base)
        clusters :: text.graphemes(value)
        target_index := base_index + delta
        if target_index < 0 -> target_index = 0
        if target_index > clusters.len() -> target_index = clusters.len()
        target :: grapheme_boundary(value, target_index)
        TextSelection{anchor: target, active: target}
    }

    fn grapheme_cursor_boundary(value: String, grapheme_index: Int) -> Int {
        grapheme_boundary(value, grapheme_index)
    }

    fn new_editor(body: String, title: String) -> EditorState {
        cursor :: text.scalar_count(body)
        EditorState{
            body: body.copy(),
            title: title.copy(),
            theme: "dark",
            settings_open: false,
            selection: TextSelection{anchor: cursor, active: cursor},
            composition: "",
            undo: [String]{},
            redo: [String]{},
            revision: 0,
            status: "new",
        }
    }

    fn body_of(state: EditorState) -> String { state.body.copy() }

    fn title_of(state: EditorState) -> String { state.title.copy() }

    fn theme_of(state: EditorState) -> String { state.theme.copy() }

    fn settings_open_of(state: EditorState) -> Bool { state.settings_open }

    fn selection_of(state: EditorState) -> TextSelection { state.selection.copy() }

    fn composition_of(state: EditorState) -> String { state.composition.copy() }

    fn revision_of(state: EditorState) -> Int { state.revision }

    fn status_of(state: EditorState) -> String { state.status.copy() }

    fn commit_edit(state: EditorState, next: String, next_selection: TextSelection, status: String) -> EditorState {
        if state.body == next -> return state
        history := state.undo
        &history.push(state.body)
        EditorState{
            body: next.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: next_selection,
            composition: "",
            undo: history.copy(),
            redo: [String]{},
            revision: state.revision + 1,
            status: status.copy(),
        }
    }

    fn with_selection(state: EditorState, next: TextSelection) -> EditorState {
        normalized :: normalize_selection(state.body, next)
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: normalized,
            composition: state.composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: state.status.copy(),
        }
    }

    fn apply_text(state: EditorState, replacement: String) -> EditorState {
        edit :: replace_selection(state.body, state.selection, replacement)
        commit_edit(state, edit.text.copy(), edit.selection, "edited")
    }

    fn start_composition(state: EditorState) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: "",
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: "composing",
        }
    }

    fn update_composition(state: EditorState, composition: String) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: "composing",
        }
    }

    fn commit_composition(state: EditorState, composition: String) -> EditorState {
        committed :: if composition == "" -> state.composition.copy() else -> composition.copy()
        apply_text(state, committed.copy())
    }

    fn cancel_composition(state: EditorState) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: "",
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: "composition-cancelled",
        }
    }

    fn drop_text(state: EditorState, dropped: String) -> EditorState {
        apply_text(state, dropped)
    }

    fn undo(state: EditorState) -> EditorState {
        history := state.undo
        previous :: &history.pop() ?? return state
        forward := state.redo
        &forward.push(state.body)
        cursor :: text.scalar_count(previous)
        EditorState{
            body: previous.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: TextSelection{anchor: cursor, active: cursor},
            composition: "",
            undo: history.copy(),
            redo: forward.copy(),
            revision: state.revision + 1,
            status: "undo",
        }
    }

    fn redo(state: EditorState) -> EditorState {
        forward := state.redo
        next :: &forward.pop() ?? return state
        history := state.undo
        &history.push(state.body)
        cursor :: text.scalar_count(next)
        EditorState{
            body: next.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: TextSelection{anchor: cursor, active: cursor},
            composition: "",
            undo: history.copy(),
            redo: forward.copy(),
            revision: state.revision + 1,
            status: "redo",
        }
    }

    fn set_theme(state: EditorState, theme: String) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: state.composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: state.status.copy(),
        }
    }

    fn set_settings_open(state: EditorState, open: Bool) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: open,
            selection: state.selection,
            composition: state.composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: state.status.copy(),
        }
    }

    fn mark_saved(state: EditorState) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: state.composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: "saved",
        }
    }

    fn mark_error(state: EditorState, message: String) -> EditorState {
        EditorState{
            body: state.body.copy(),
            title: state.title.copy(),
            theme: state.theme.copy(),
            settings_open: state.settings_open,
            selection: state.selection,
            composition: state.composition.copy(),
            undo: state.undo.copy(),
            redo: state.redo.copy(),
            revision: state.revision,
            status: message.copy(),
        }
    }

    // Keep body and UI settings as separate records. This lets a reload recover
    // the Unicode document even when a host cancels its settings transaction.
    fn persisted_body(state: EditorState) -> String { state.body.copy() }

    fn persisted_session(state: EditorState) -> String {
        mode :: if state.settings_open -> "open" else -> "closed"
        "JET-GUI-SESSION-1|{state.theme}|{mode}"
    }

    fn restore_session(raw: String) -> SessionSettings {
        parts :: text.splitn(raw, "|", 3)
        version :: parts.get(0) ?? ""
        if version != "JET-GUI-SESSION-1" -> return SessionSettings{theme: "dark", settings_open: false}
        theme := parts.get(1) ?? "dark"
        if theme == "" -> theme = "dark"
        mode :: parts.get(2) ?? "closed"
        SessionSettings{theme: theme.copy(), settings_open: mode == "open"}
    }

    fn recover(body: String, raw_session: String, title: String) -> EditorState {
        session :: restore_session(raw_session)
        base :: new_editor(body, title)
        themed :: set_theme(base, session.theme.copy())
        set_settings_open(themed, session.settings_open)
    }

    fn status_label(state: EditorState) -> String {
        if state.status == "saved" -> return "Saved"
        "{state.status} — revision {state.revision}"
    }

    fn settings_view(theme: String, open: Bool) -> UiNode {
        if open -> return ui.box([
            ui.text("SETTINGS"),
            ui.text("Theme: {theme}"),
            ui.text("Recovery: enabled"),
            ui.text("Accessibility: named controls"),
        ])
        ui.text("SETTINGS (closed)")
    }

    fn sidebar_view(selected: Int) -> UiNode {
        meeting :: if selected == 0 -> "* Meeting" else -> "  Meeting"
        ideas :: if selected == 1 -> "* Ideas" else -> "  Ideas"
        ui.box([
            ui.text("NOTES"),
            ui.node_role(meeting, 24.0, 1.0, ui.aria_role_button()),
            ui.node_role(ideas, 24.0, 1.0, ui.aria_role_button()),
        ])
    }

    fn command_bar() -> UiNode {
        ui.box([
        ui.node_shortcut(ui.button("Save"), .cmd("s")),
        ui.node_shortcut(ui.button("Undo"), .cmd("z")),
        ui.node_shortcut(ui.button("Redo"), .cmd("r")),
        ui.node_shortcut(ui.button("Toggle theme"), .cmd("t")),
        ui.node_shortcut(ui.button("Settings"), .cmd(",")),
    ])
    }

    fn menu_view() -> UiNode {
        ui.box([
        ui.text("FILE"),
        ui.text("Open   Save   Quit"),
        ui.text("Tray fallback: host window lifecycle"),
    ])
    }

    // Fixed child order is the identity policy for the portable tree. Hosts can
    // reconcile this same order while a future keyed-node core gate is pending.
    fn editor_view(body: String, selected: Int, theme: String, settings_open: Bool) -> UiNode {
        background :: if theme == "dark" -> "#15181d" else -> "#f8f4ea"
        input :: ui.text_input(body, .Native)
        ui.box([
            ui.node_color("JET NOTES — {theme} mode", 80.0, 1.0, background),
            sidebar_view(selected),
            ui.node_role("EDITOR — selected {selected}", 80.0, 1.0, ui.aria_role_label()),
            input,
            menu_view(),
            command_bar(),
            settings_view(theme, settings_open),
            ui.text("Ctrl+S Save   Ctrl+Z Undo   Ctrl+Shift+Z Redo"),
            ui.text("Focus order: Save → Editor → Toggle theme"),
        ])
    }

    fn focus_group() -> [UiNode] { [
        ui.node_role("Save", 12.0, 1.0, ui.aria_role_button()),
        ui.node_role("Editor", 60.0, 4.0, ui.aria_role_text_input()),
        ui.node_role("Toggle theme", 18.0, 1.0, ui.aria_role_button()),
    ] }

    fn save_button() -> UiNode { ui.node_shortcut(ui.button("Save"), .cmd("s")) }

    fn system_font(style: FontStyle) -> FontFace { font.system(style) }

    fn shape_text(value: String, face: FontFace) -> GlyphRun { font.shape(value, face) }

    fn host_capabilities() -> UiCapabilityFacts { host.capabilities() }

    fn text_filter() -> UiFileFilter { host.file_filter_text() }

    fn file_filter(label: String, extensions: [String], mime_types: [String]) -> UiFileFilterResult {
        host.file_filter(label, extensions, mime_types)
    }

    fn fs_rights() -> UiFsRights { host.fs_rights_read_write() }

    fn request_grant(root: String) -> UiFsGrantResult { host.fs_grant(root, host.fs_rights_read_write()) }

    fn open_request(grant: UiFsGrant) -> UiFileDialogRequest { host.open_request(grant) }

    fn save_request(grant: UiFsGrant) -> UiFileDialogRequest { host.save_request(grant) }

    fn open_file(request: UiFileDialogRequest) -> UiFileDialogResult { host.open_file(request) }

    fn save_file(request: UiFileDialogRequest) -> UiFileDialogResult { host.save_file(request) }

    fn read_clipboard() -> UiClipboardTextResult { clipboard.read_text() }

    fn write_clipboard(value: String) -> UiClipboardWriteResult { clipboard.write_text(value) }

    fn poll_ime() -> UiImeResult { ime.poll() }

    fn poll_drag_drop() -> UiDragResult { drag_drop.poll() }

    fn save_shortcut() -> UiShortcut { .cmd("s") }

    fn host_shortcut() -> UiShortcutResult { host.shortcut("s", save_shortcut().modifiers) }

    fn bind_shortcut(shortcut: UiShortcut, action: String) -> UiShortcutBindingResult {
        shortcuts.binding(shortcut, action)
    }

    fn register_shortcut(binding: UiShortcutBinding) -> UiShortcutBindingResult {
        shortcuts.register(binding)
    }

    fn dispatch_shortcut(shortcut: UiShortcut) -> UiShortcutDispatchResult {
        shortcuts.dispatch(shortcut)
    }

    fn accessibility_metadata(name: String, description: String) -> UiAccessibilityResult {
        host.accessibility(name, description)
    }

    fn attach_accessibility(node: UiNode, metadata: UiAccessibility) -> UiAccessibilityAttachResult {
        accessibility.attach(node, metadata)
    }

    fn future_commands() -> [String] { [
        "JET_UI_HEADLESS=1 Tools/agent/jet-env jet run Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet run --target=native Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet dev --target=web Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet build Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet package --kind desktop --target linux-appimage --package gui-battery-example --name gui-battery-example --version 0.1.0 --executable build/run --output build/gui-battery-example.AppImage",
    ] }

    fn open_core_gates() -> [String] { [
        "#2771: reactive render ICEs in two compositions",
        "Typography/mobile: native glyph hit-testing plus Android/iOS adapters remain core work",
    ] }
}
