Token: struct {
    raw: String
}

impl Token.Encode {
    encode: fn(self) -> Dyn { Dyn.Text(self.raw.copy()) }
}

impl Token.Decode {
    decode: fn(tree: Dyn) -> Token [FieldError]! {
        raw: tree.text()?
        return Ok(Token{raw: raw})
    }
}

#Codable
Row: struct {
    value: Int | Token
}

run: fn() { print("x") }
