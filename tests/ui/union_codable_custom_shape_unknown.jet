struct Token {
    raw: String
}

impl Token.Encode {
    fn encode(self) -> Dyn { Dyn.Text(self.raw.copy()) }
}

impl Token.Decode {
    fn decode(tree: Dyn) -> Token [FieldError]! {
        raw :: tree.text()?
        return Ok(Token{raw: raw})
    }
}

#Codable
struct Row {
    value: Int | Token
}

fn run() { print("x") }
