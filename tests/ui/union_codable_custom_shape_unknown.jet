struct Token {
    raw: String
}

impl Token.Encode {
    fn encode(self) DataTree -> DataTree.Text(~self.raw)
}

impl Token.Decode {
    fn decode(tree: DataTree) Token ![FieldError] -> {
        raw :: tree.text()?
        return Ok(Token{raw: raw})
    }
}

#Codable
struct Row {
    value: Int | Token
}

fn run() { print("x") }
