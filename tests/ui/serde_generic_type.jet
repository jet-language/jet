// Generic `#Codable` is first-class. `Wrap<T>`
// reaches the wire through `value`, so the derive injects `T: Encode`/`T: Decode`.
// `Tagged<K>`'s `K` is phantom (skip-only), so it serializes with no bound on `K`.
// (D-MEM1 S6: renamed from `Id<K>` — `Id<T>` is now the reserved `Pool<T>` handle type.)
#Codable
struct Wrap<T> {
    value: T
}

#Codable
struct Tagged<K> {
    raw: Int
    #Skip marker: K?
}

fn run() {
    print("x")
}
