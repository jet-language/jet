// E2404: `?` propagates a typed error into a function that returns a different
// typed error, but no `impl Source => Target` conversion has been declared.
enum FileErr {
    NotFound
}

enum AppErr {
    File(FileErr)
}

fn inner() => String ? FileErr :: Ok("hi")
fn outer() => String ? AppErr {
    inner()?
    return Ok("done")
}

fn run() {

}
