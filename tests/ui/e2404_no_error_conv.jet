// E2404: `?` propagates a typed error into a function that returns a different
// typed error, but no `impl Target.From(Source)` conversion has been declared.
FileErr: enum {
    NotFound
}

AppErr: enum {
    File(FileErr)
}

inner: fn() -> String FileErr! { Ok("hi") }

outer: fn() -> String AppErr! {
    inner()
    return Ok("done")
}

run: fn() {

}
