// A `priv` field of an inline module's struct belongs to that module and its
// children (D-VIS-MODULE1): the rest of the file can't write it.
bank: module {
    Account: struct {
        priv balance: Int
    }

    open: fn() -> Account { Account{balance: 0} }

    balance_of: fn(account: Account) -> Int { account.balance }
}

run: fn() {
    account := bank.open()
    account.balance = 5
    print(bank.balance_of(account))
}
