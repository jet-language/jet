// D-CRYPTO-DIAG1=A: HKDF boundary literals and dynamic lengths remain valid.
use {
    crypto: core.crypto
    expert: core.crypto.expert
}

derive_dynamic: fn(length: Int) {
    #Unsafe("protocol-selected output length") {
        dynamic: expert.hkdf_sha256_raw([1], [], [], length)
    }
}

run: fn() {
    safe_min: crypto.hkdf_sha256([U8]{1}, [], [], 0)
    safe_max: crypto.hkdf_sha256([U8]{1}, [], [], 8160)
    #Unsafe("fixed interop vectors") {
        expert_min: expert.hkdf_sha256_raw([1], [], [], 0)
        expert_max: expert.hkdf_sha256_raw([1], [], [], 8160)
    }
    derive_dynamic(8161)
}
