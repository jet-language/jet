use web: core.web
use server: core.http.server

Jokes: struct {
    #Server.Get("/jokes/:id")
    joke: fn(self, id: Int) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "joke={id}"))
    }
}

run: fn() {
    mux: web.app()
    mux.mount(Jokes{})
    mux.get("/jokes/:id", fn(id: Int) { Ok(server.response(200, "duplicate={id}")) })
}
