use server :: core.http.server

struct Jokes {
    #Server.Get("/jokes/:id")
    fn joke(self, id: Int) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "joke={id}"))
    }
}

fn run() {
    mux :: server.mux()
    mux.mount(Jokes{})
    mux.get("/jokes/:id", (id: Int) -> Ok(server.response(200, "duplicate={id}")))
}
