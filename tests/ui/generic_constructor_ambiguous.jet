Empty: struct<T> {
    marker: Int
}

impl Empty {
    new: fn() -> Empty<T> { return Empty<T>{marker: 0} }
}

Same: struct<T> {
    value: T
}

impl Same {
    new: fn(left: ^T, right: ^T) -> Same<T> { return Same<T>{value: left} }
}

run: fn() {
    item: Empty.new()
    conflict: Same.new(1, "two")
}
