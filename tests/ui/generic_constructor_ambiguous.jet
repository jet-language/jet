struct Empty<T> {
    marker: Int
}

impl Empty {
    fn new() => Empty<T> {
        return Empty<T>.{marker: 0}
    }
}

struct Same<T> {
    value: T
}

impl Same {
    fn new(left: ^T, right: ^T) => Same<T> {
        return Same<T>.{value: left}
    }
}

fn run() {
    item :: Empty.new()
    conflict :: Same.new(1, "two")
}
