#Policy(copies: .Explicit)

// #3738, #6611: `.push()` takes its argument and a call never copies, so a
// local still used after the push is reported with the Safe `.copy()` edit,
// under `copies: .Explicit` as everywhere.
run: fn() {
    first: "Ada"
    names := [String]{}
    names.push(first)
    print("{first} {names.len()}")
}
