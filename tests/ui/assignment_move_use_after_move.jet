// E0121: an assignment moves a value that cannot be copied, so the old name is gone.
fn run() {
    nums := [1, 2, 3, 4]
    evens := nums.lazy().filter((n: Int) -> n % 2 == 0)
    kept := nums.lazy().filter((n: Int) -> n > 2)
    kept = evens
    print(^kept.to_list())
    print(^evens.to_list())
}
