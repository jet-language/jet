// The public sleep export resolves to its loaded Core declaration.
use {
    time :: core.time
    core.time.[sleep]
}

fn qualified_waits() Never! -[Time]> {
    time.sleep(time.duration_ns(0))
    time.sleep(time.duration_ns(-1))
}
fn imported_wait() Never! -[Time]> {
    sleep(time.duration_ns(0))
}
fn run() {}
