// A `.Ship` or `.Dev` job can't share its word with a `#CLI` command.
// An `.Internal` job never clashes.
#CLI(Standard)
Commands: struct {
    #Doc("Start the service") serve: fn(self) { print("command serve") }

    #Doc("Write the report") report: fn(self) { print("command report") }

    #Doc("Preview changes") plan = plan_impl
}

plan_impl: fn(_args: Commands) { print("command plan") }

#Job(.Ship) serve: fn() { print("job serve") }

#Job(.Dev) plan: fn() { print("job plan") }

#Job(.Internal) report: fn() { print("job report") }

run: fn(_args: Commands) {}
