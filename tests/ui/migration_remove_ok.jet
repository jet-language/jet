// Tests that `remove legacy_id` (D-MIGRATE2D) unblocks a dropped field.
// The sibling .published.snapshot has `legacy_id` that the new struct lacks.
#PublishedSchema Account: struct {
    name: String
}

migration Account {
    remove legacy_id
}

run: fn() {
    a: Account{name: "Alice"}
    print("{a.name}")
}
