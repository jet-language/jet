// E0355 (D-META-REG1): `#Job` only marks a top-level function.
// function — a method has no free-standing name for `jet run <entry> -- <job>` to
// invoke.
struct Cleaner {
    label: String,
}

impl Cleaner {
    #Job
    fn sweep(self) {
        print(self.label)
    }
}

fn run() {
    c := Cleaner.{ label: "x" }
    c.sweep()
}
