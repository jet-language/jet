#Error
enum FetchError {
    BadURL(String)
    Timeout(seconds: Int, retries: Int)
}

#Error
enum AppError {
    FailedToFetch(url: String, cause: FetchError)
    Offline
}

fn fetch(raw: String) -> String AppError! {
    if raw == "" -> return Err(.Offline)
    Ok(raw)
}

fn run() {
    if fetch("") == {
        .Ok(page) -> print(page)
        .Err(.FailedToFetch{url, ..}) -> print(url)
    }
}
