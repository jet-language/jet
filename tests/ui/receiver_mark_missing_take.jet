// D-CAP-RECEIVER1=D: a taking call needs `^` on the named receiver place.
// D-COPY-DEFAULT1=A leaves `^` optional only on a whole local at its last
// use; a field receiver still needs the mark.
Buffer: struct { text: String }
Holder: struct { buf: Buffer }
impl Buffer {
    seal: fn(^self) { print(self.text) }
}
run: fn() {
    holder := Holder{buf: Buffer{text: "hello"}}
    holder.buf.seal()
}
