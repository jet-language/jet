// E0641 in a statement table. A guarded arm covers no case, so the `else` in
// `tally` stands for `.Green` and every `.Custom` the guard lets through; the
// `Light` table's `else` can never run. `bucket` has a comparison arm, so its
// table is not a closed-set match and keeps its `else`.
Color: enum {
    Red
    Green
    Custom(Int)
}

Light: enum {
    On
    Off
}

tally: fn(c: Color) -> Int {
    total := 0
    if c == {
        .Red -> total += 1
        .Custom(n) && n > 0 -> total += n
        else -> total += 100
    }
    total
}

bucket: fn(n: Int) -> Int {
    seen := 0
    if {
        n > 10 -> seen += 2
        else -> seen += 1
    }
    seen
}

run: fn() {
    print(tally(Color.Green))
    print(bucket(3))
    state := 0
    light: Light.Off
    if light == {
        .On -> state += 1
        .Off -> state += 2
        else -> state += 3
    }
    print(state)
}
