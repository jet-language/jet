// D-TAINT1: an untrusted (`#Input`) value reaching a sink effect (here the
// `Exec` subprocess sink `process.cmd`) without passing through a `#Scrub(Input) fn`
// is E0721 — the classic command-injection bug, caught at compile time.
use process: core.process

run: fn() {
    name: #Input "world; rm -rf /"
    _: process.cmd(["echo", name])
}
