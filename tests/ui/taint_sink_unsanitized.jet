// D-TAINT1: an untrusted (`#Tainted`) value reaching a sink effect (here the
// `Exec` subprocess sink `process.run`) without passing through a `#Sanitizer fn`
// is E0721 — the classic command-injection bug, caught at compile time.
use core.process as process

fn main() {
    name @= #Tainted "world; rm -rf /"
    result := process.run(["echo", name]) ?? return
    print(result.output)
}
