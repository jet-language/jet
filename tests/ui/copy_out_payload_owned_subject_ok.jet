// A payload bound from a subject this scope owns moves with `^` (spec.md:1189:
// a value with cleanup moves only where `^` writes it): the binding takes it,
// and the subject never closes it again.
Res: struct { name: String }
impl Res.Close {
    close: fn(^self) { print("close {self.name}") }
}

keep: fn(r: ^Res) -> Int { r.name.len() }

make: fn(name: String) -> Res? { Val(Res{name: name}) }

from_local: fn() -> Int {
    local := make("local")
    if local == .Val(held) {
        applied := ^held
        return keep(^applied)
    }
    0
}

from_call: fn() -> Int {
    if make("call") == {
        .Val(held) -> {
            applied := ^held
            keep(^applied)
        }
        .None -> 0
    }
}

run: fn() {
    print(from_local() + from_call())
}
