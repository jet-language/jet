// D-VIS-MODULE1: the enclosing module uses its `priv module` and the
// type's own module uses its `priv` field; this file checks clean.
priv vault: module {
    secret: fn() -> Int { 42 }
}

priv(package) shared: module {
    bump: fn(n: Int) -> Int { n + 1 }
}

Token: struct {
    priv raw: String
    label: String
}

token: fn(label: String) -> Token { Token{raw: "s3cr3t", label: label} }

run: fn() {
    t: token("api")
    print(shared.bump(vault.secret()))
    print(t.label)
    print(t.raw.len())
}
