// A call's result carries its arguments' tags. `??` on the result of a call
// that took a secret decides on the secret, even when only a public length
// picks the None. Core's TLS 1.3 key schedule checks the lengths first and
// derives after, as `key_checked` does.
expand: fn(secret: [#Secret U8], len: Int) -> [U8]? {
    if len < 0 || len > 255 || secret.len() == 0 -> return None
    Val(expand_bytes(secret, len))
}

expand_bytes: fn(secret: [#Secret U8], len: Int) -> [U8] {
    out := [U8]{}
    loop i in 0..<len -> out.push(secret[i %% secret.len()])
    out
}

key_of: fn(secret: [#Secret U8]) -> [U8]? {
    key: expand(secret, 16) ?? return None
    Val(key)
}

key_checked: fn(secret: [#Secret U8]) -> [U8]? {
    if secret.len() == 0 -> return None
    Val(expand_bytes(secret, 16))
}
