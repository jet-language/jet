// D-COPY-DEFAULT1=A (#3714): `^` cannot move out of borrowed storage or take
// an element out of its collection, and a fresh value has nothing to move.
Box: struct {
    xs: [Int]
}

wrap: fn(xs: [Int]) -> Box {
    Box{xs: ^xs}
}

make: fn() -> [Int] {
    [4]
}

run: fn() {
    grid := [[1], [2]]
    first := ^grid[0]
    fresh := ^make()
    print("{wrap([3]).xs.len()} {first.len()} {fresh.len()}")
}
