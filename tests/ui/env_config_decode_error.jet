// @run_cli
package {
    name: "env_config_decode_error"
    authority: { allow: [Env] }
}
use core.sys as env

#Decode
struct Settings {
    port: Int
}

fn run() {
    env.set("APP_PORT", "not-an-int")
    settings :: env.decode<Settings>(prefix: "APP_", file: "", allow: ["APP_PORT"]) ?? panic("config: {err}")
    panic("invalid config unexpectedly accepted: {settings.port}")
}
