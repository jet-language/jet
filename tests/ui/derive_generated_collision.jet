DebugText: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            debug_string: fn(self) -> String { target.reflect().name }
        }
    }
}

#DebugText
Point: struct {
    x: Int
    debug_string: fn(self) -> String { "existing" }
}

run: fn() {
    p: Point{x: 1}
    print(p.debug_string())
}
