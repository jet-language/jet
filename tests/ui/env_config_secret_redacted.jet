// @run_cli
package {
    name: "env_config_secret_redacted"
    authority: { allow: [Env] }
}
use {
    crypto :: core.crypto
    env :: core.sys
}

#Decode
struct Settings {
    #Redact password: crypto.Secret
}

fn run() {
    env.set("APP_PASSWORD", "plaintext-must-not-print")
    settings :: env.decode<Settings>(prefix: "APP_", file: "", allow: ["APP_PASSWORD"]) ?? panic("config decode")
    panic("config: {settings:Debug}")
}
