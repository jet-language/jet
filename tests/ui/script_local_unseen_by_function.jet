// E0107: in a file of top-level statements, `total := 0` is a local of the
// file's entry. A function declared in the file takes it as a parameter, but
// a method gets none, so it can't see it.
total := 0
loop n in 0..<3 -> total += n
Ledger: struct {
    rows: Int

    report: fn(self) -> String { "total {total}" }
}
print(Ledger{rows: 1}.report())
