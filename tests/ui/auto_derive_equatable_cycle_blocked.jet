// A mutually recursive group derives `Equatable` together, so one member
// without equality blocks the whole group and every type built on it.
#!Equatable
Opaque: struct { value: Int }

Shape: enum {
    Leaf
    Node(parts: [Part])
}

Part: struct {
    shape: Shape
    tag: Opaque
}

Wrapper: struct { shape: Shape }

run: fn() {
    a: Shape.Leaf
    b: Shape.Leaf
    print(a == b)
    w: Wrapper{shape: Shape.Leaf}
    v: Wrapper{shape: Shape.Leaf}
    print(w == v)
}
