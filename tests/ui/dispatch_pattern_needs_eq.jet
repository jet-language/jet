// E0366 (D-IFDIST1): structural pattern arms need `==`. Other distributed
// comparison markers only wrap bare values — a pattern head is a teaching error.
enum Shape {
    Circle
    Square
}

fn name(s: Shape) => String {
    return if s < {
        .Circle -> "circle"
        else -> "other"
    }
}

fn run() {
    print(name(.Circle))
}
