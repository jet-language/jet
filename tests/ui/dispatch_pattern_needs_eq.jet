// E0366 (D-IFDIST1): structural pattern arms need `==`. Other distributed
// comparison markers only wrap bare values, so a pattern head under `<` is a
// teaching error. The `<` table is this fixtures subject and must stay.
enum Shape {
    Circle
    Square
}

fn name(s: Shape) String -> {
    if s < {
        .Circle -> "circle"
        else -> "other"
    }
}

fn run() { print(name(.Circle)) }
