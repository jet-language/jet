
struct Vec2 {
    x: Int
    y: Int
}

struct Holder {
    value: Vec2
}

impl Vec2.Add {
    fn add(self, rhs: Vec2) -> Vec2 {
        return Vec2{ x: self.x + rhs.x, y: self.y + rhs.y }
    }
}

fn run() {
    hs := [Holder{ value: Vec2{ x: 1, y: 2 } }]
    hs[0].value += Vec2{ x: 3, y: 4 }
    print("{hs[0].value.x},{hs[0].value.y}")
}
