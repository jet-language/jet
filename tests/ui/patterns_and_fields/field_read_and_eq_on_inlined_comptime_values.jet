Pair: struct {
    left: Int
    right: String
}

Light: enum {
    Red
    Green
}

PAIR_VALUE: #run { Pair{left: 7, right: "seven"} }
LIGHT_VALUE: #run Light.Green

run: fn() {
    p: Pair{left: 7, right: "seven"}
    l: Light.Green
    print("{PAIR_VALUE.left}")
    print("{p.left}")
    print("{PAIR_VALUE.right}")
    print("{p.right}")
    print("{LIGHT_VALUE == Light.Green}")
    print("{l == Light.Green}")
}
