trait Backend {
    fn paint(self) -> Int
}

struct LinuxBackend {
    id: Int
}

#Target(Os.Linux)
impl LinuxBackend.Backend {
    fn paint(self) -> Int {
        return 1
    }
}

fn run_paint(b: LinuxBackend) -> Int {
    return b.paint()
}

fn run() {
    print("{run_paint(LinuxBackend.{id: 1})}")
}
