// E0131: Decimal and Float do not mix implicitly.
//
// D-TYPE2-DEFAULT1=A made decimal literals exact Decimal values, so a bare
// `0.03` is Decimal and mixes with `Decimal` perfectly well. Float is now an
// expert opt-in at the declaration, which is what makes this a mix again.
fn run() {
    price :: Decimal("1.50")
    rate :: Float{0.03}
    print(price + rate)
}
