// Positive matrix cell (package boundary): a `pub fn` may hand a `view` of one
// of its parameters back across a module/package boundary. The caller owns the
// argument for as long as the returned view lives, so the borrow is sound.
pub fn borrow_name(name: String) -> &String {
    return name
}
fn run() {
n: String :: "ada"
    print(borrow_name(n))
}
