// E2305: a view bound from a narrowed payload escapes its declared `from` owner.
Packet: enum {
    Data([Int])
    Empty
}

head: fn(packet: Packet, spare: [Int]) -> View<Int> from spare {
    if packet == .Data(items) -> return items[0..1]
    spare[0..0]
}

run: fn() {
    print(head(.Data([1, 2, 3]), [9]).len())
}
