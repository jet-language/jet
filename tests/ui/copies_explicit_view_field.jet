#Policy(copies: .Explicit)

// #3738: a text view that fills an owned field is a copy site, so
// `copies: .Explicit` reports it with the Safe `.copy()` edit.
User: struct {
    name: String
}

run: fn() {
    text: "  admin  "
    label: text.trim()
    user: User{name: label}
    print(user.name)
}
