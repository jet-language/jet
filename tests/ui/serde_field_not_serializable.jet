use core.encoding.json as json

// D-AUTODERIVE1=E made a qualifying plain struct auto-`Encode`/`Decode`, so the
// no-wire-form contract now needs a type that refuses codec generation itself.
#!Codable
struct Plain {
    v: Int
}

#Codable
struct Order {
    inner: Plain
}

fn run() { print("x") }
