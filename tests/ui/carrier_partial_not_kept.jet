// D-FAIL-CARRIER1=A: `.partial` reads the payload a failure kept. An error
// type that never keeps one has nothing to hand back.
struct ImportErr {
    broken: Int
}

fn import_rows(rows: [String]) => [String] ? ImportErr {
    if rows.len() == 0 { return Err(ImportErr.{broken: 1}) }
    return Ok(rows)
}

fn run() {
    spotty :: import_rows([String].{})
    print((spotty.partial() ?? []).len())
}
