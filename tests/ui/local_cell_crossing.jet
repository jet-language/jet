use server: core.http.server

cross_task: fn(cell: Cell<Int>) {
    worker: task {
        _: cell.get()
    }
    worker.join() ?? panic("task failed")
}

cross_shared: fn(cell: Cell<Int>) {
    _: shared cell
}

LocalCache: struct {
    cell: Cell<Int>,
}

cross_shared_nested: fn(cache: LocalCache) {
    _: shared cache
}

cross_http: fn() {
    cell: Cell.new(0)
    mux: server.mux()
    mux.get("/", (req: HTTPRequest) -> {
        return Ok(server.response(200, "{cell.get()}"))
    })
}

run: fn() {}
