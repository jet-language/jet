fn cross_task(cell: Cell<Int>) {
    worker :: task {
        _ :: cell
    }
    worker.join() ?? panic("task failed")
}

fn cross_shared(cell: Cell<Int>) {
    _ :: Shared.new(^cell)
}

struct Cache {
    cell: Cell<Int>,
}

fn cross_shared_nested(cache: Cache) {
    _ :: Shared.new(^cache)
}

fn run() {}
