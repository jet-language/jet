// A malformed Iterator `next` is rejected by sema before any lowering.
BagIter: struct {
    items: [Int]
    at: Int

    impl Iterator {
        Item: Int

        next: fn(self) -> String {
            "none"
        }
    }
}

run: fn() {
    cur := BagIter{items: [10, 20], at: 0}
    print(cur.at)
}
