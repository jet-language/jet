struct Particle {
    position: Int
    velocity: Int
}

fn run() {
    particles := [Particle].{
        .{position: 10, velocity: 2},
        .{position: 20, velocity: 3}
    }
    task.group g {
        one :: &particles[0]
        two :: &particles[0]
        a :: task {
            one.position += 1
            one.position
        }
        b :: task {
            two.position += 1
            two.position
        }
    }
}
