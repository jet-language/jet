struct Particle {
    position: Int
    velocity: Int
}

fn run() {
    particles := [Particle].{
        .{position: 10, velocity: 2},
        .{position: 20, velocity: 3}
    }
    task.group g {
        one :: &particles[0]
        two :: &particles[0]
        print(task.all {
            { one.position += 1; one.position },
            { two.position += 1; two.position }
        } ?? panic("task.all failed"))
    }
}
