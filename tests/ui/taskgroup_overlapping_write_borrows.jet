struct Particle {
    position: Int
    velocity: Int
}

fn run() {
    particles := [Particle].{
        .{position: 10, velocity: 2},
        .{position: 20, velocity: 3}
    }
    taskgroup g {
        one :: &particles[0]
        two :: &particles[0]
        a :: g.task => {
            one.position += 1
            one.position
        }
        b :: g.task => {
            two.position += 1
            two.position
        }
        print(g.all([a, b]))
    }
}
