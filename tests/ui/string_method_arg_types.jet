// #4009: every String method checks its argument types (E0108), including
// the padding, comparison, regex and separator-split methods.
fn run() {
    word :: "ab"
    print(word.center("6", "*"))
    print(word.ljust(4, 0))
    print(word.rjust(true, "-"))
    print(word.zfill("3"))
    print(word.compare(3))
    print(word.equal(3))
    print(word.matches(2))
    print(word.match(2))
    print(word.last_index_of(true))
    print(word.after(1))
    print(word.before(1))
}
