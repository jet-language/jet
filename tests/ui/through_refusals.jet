Shape: enum {
    Dot
    Circle(Int)
    Square(Int)
}

size: fn(shape: Shape) -> Int {
    total := 0
    if shape == {
        .Square(side) -> return side #Through
        .Dot -> total += 1 #Through
        .Circle(r) -> total += r
    }
    total
}

word: fn(text: String) -> String { "{text}" }

label: fn(n: Int) -> String {
    if n == {
        1 -> word("one") #Through
        else -> word("other")
    }
}

run: fn() {
    print("{size(Shape.Dot)} {label(1)}")
}
