// D-COMPILER-NS1=A / D-META-ROOT3=A / D-BUILD-FACT3=A / D-DECL-META1=A: the
// retired `@` fact and metadata spellings teach E0003, each with a
// machine-applicable `$` respelling.
#Numeric
Severity :: distinct Int(0..10)

marker Audited(@sites: [.Type], @repeatable: false)

RANGE :: Severity.@range

PACKAGE_NAME :: @build.package.name

OS :: @build.os

fn run() {
    print(RANGE.start)
    print(PACKAGE_NAME)
    print(OS)
}
