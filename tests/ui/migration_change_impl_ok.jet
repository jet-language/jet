// Tests D-MIGRATE2B fallback: a `change` op with no inline `via` resolves its
// converter from an `impl New.From(Old)` in scope. The .published.snapshot has
// `note: String`; the struct now stores `note: Label`.
Label: struct {
    text: String
}

impl Label.From(String) {
    from: fn(text: String) -> Label { return Label{ text: text } }
}

#PublishedSchema Order: struct {
    id: Int
    note: Label
}

migration Order {
    change note: String -> Label
}

run: fn() {
    o: Order{id: 1, note: Label{text: "rush"}}
    print("{o.id}")
}
