// E2405: two `impl Target.From(Source)` blocks for the same (Source, Target) pair.
ParseErr: enum {
    Empty
}

#Error AppErr: enum {
    Parse(ParseErr)
}

impl AppErr.From(ParseErr) { from: fn(error: ParseErr) -> AppErr { AppErr.Parse(error) } }

impl AppErr.From(ParseErr) { from: fn(error: ParseErr) -> AppErr { AppErr.Parse(error) } }

run: fn() {

}
