// D-METHOD-FOOTPRINT1=A: a stated receiver footprint must cover the body.
struct World {
    bodies: [Int]
    log: [String]
    hits: Int
}

impl World {
    fn log_hit(&self.log) {
        &self.log.push("hit")
        self.hits += 1
    }
}

fn run() {
    world := World{bodies: [1], log: [String]{}, hits: 0}
    &world.log_hit()
    print(world.hits)
}
