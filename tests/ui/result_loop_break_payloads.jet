missing: fn() -> Int {
    result: loop {
        if true { break }
        break 1
    }
    result
}

mismatch: fn() -> Int {
    result: loop {
        if true {
            break 1
        }
        break "other"
    }
    result
}

routed_missing: fn() -> Int {
    result: loop {
        found: loop value in [1] {
            if value == 2 {
                break value
            }
        } ?? break(result)
        break found
    }
    result
}

fallible: fn() -> Int String! { return Err("failed") }

fallback_routed_missing: fn() -> Int {
    result: loop {
        fallible() ?? break(result)
        break 1
    }
    result
}

run: fn() {}
