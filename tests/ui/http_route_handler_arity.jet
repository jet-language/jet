use web: core.web
use server: core.http.server

named_zero: fn() -> HTTPResponse HTTPError! { Ok(server.response(200, "named")) }

run: fn() {
    mux: web.app()
    mux.get("/zero", fn() { Ok(server.response(200, "zero")) })
    mux.get("/named", named_zero)
    mux.get("/one", fn(req: HTTPRequest) { Ok(server.response(200, req.path())) })
    mux.get("/bad", fn(first: HTTPRequest, second: HTTPRequest) { Ok(server.response(200, first.path())) })
}
