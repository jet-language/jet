marker AddGreeting(@sites: [.Type]) {
    tname :: target.name
    emit("""
impl $tname {{
    fn greeting(self) => String {{
        return "generated"
    }}
}}
""")
}

#AddGreeting
struct Person { name: String }

impl Person {
    fn greeting(self) => String {
        return "written"
    }
}

fn run() {}
