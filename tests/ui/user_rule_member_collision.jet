struct AddGreeting {
    impl Marker {
        sites :: [.Type]

        fn expand(self, target: Target) {
            tname :: target.name
            impl $tname {
                fn greeting(self) -> String { "generated" }
            }
        }
    }
}

#AddGreeting
struct Person {
    name: String
}

impl Person {
    fn greeting(self) -> String { return "written" }
}

fn run() {}
