AddGreeting: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            tname: target.name
            impl #{tname} {
                greeting: fn(self) -> String { "generated" }
            }
        }
    }
}

#AddGreeting
Person: struct {
    name: String

    greeting: fn(self) -> String { return "written" }
}

run: fn() {}
