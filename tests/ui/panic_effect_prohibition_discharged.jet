// D-NOPANIC1=D: a refinement fact discharges the fixed-list stop.
Die :: distinct Int(1..6)

fn pick(faces: [String#6], roll: Die) =[!Panic]=> String :: ~faces[roll.raw() - 1]

fn run() {
    roll :: Die.from_int(3)
    faces :: [String#6]{"zero", "one", "two", "three", "four", "five"}
    print(pick(faces, roll))
}
