// `Never!` denies failure. A call that can fail and an `Err` returned
// directly are both failures outside the contract: each is E2404 naming
// what it fails with, and each offers the return type that admits it.
#Error
ParseError: enum {
    Empty
}

parse: fn(text: String) -> Int ParseError! {
    if text == "" -> return Err(ParseError.Empty)
    text.len()
}

checked: fn(text: String) -> Int Never! { parse(text) }

refused: fn(text: String) -> Int Never! {
    if text == "" -> return Err(ParseError.Empty)
    text.len()
}

run: fn() {
    print(checked("ab"))
    print(refused("ab"))
}
