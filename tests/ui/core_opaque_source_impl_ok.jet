// Native carriers retain their representation; their owning Core impls resolve.
use {
    tasks: core.tasks
    rt: core.rt
}

notify: fn(condition: Condition) Never! {
    condition.notify_one()
    condition.notify_all()
}
observe: fn(stream: RealtimeStream) -> Bool Never! {
    stream.is_cancelled()
}
unrelated_builtin: fn(text: String) -> Int Never! { text.len() }
run: fn() {}
