// Native carriers retain their representation; their owning Core impls resolve.
use {
    tasks :: core.tasks
    rt :: core.rt
}

fn notify(condition: Condition) Never! {
    condition.notify_one()
    condition.notify_all()
}
fn observe(stream: RealtimeStream) -> Bool Never! {
    stream.is_cancelled()
}
fn unrelated_builtin(text: String) -> Int Never! { text.len() }
fn run() {}
