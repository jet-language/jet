// E0927 (D-VERDICT-1455-1): an unregistered name on a function reaches the
// same vocabulary family as an unregistered name on a type. It used to get
// E0355 "cannot attach through this function marker list", which described the
// compiler's dispatch table rather than the writer's typo.
#Inlin
fn hot(a: Int) => Int {
    return a * 2
}

fn run() {
    print("ok")
}
