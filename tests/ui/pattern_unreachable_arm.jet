// @all_diags
// A group arm covers every leaf under the group, so a later payload arm for one
// of those leaves can never be selected.
Msg: enum {
    Net {
        Ping(Int)
        Pong(Int)
    }
    Quit
}

show: fn(m: Msg) -> String {
    if m == {
        .Net -> "net"
        .Net.Ping(n) -> "ping {n}"
        .Quit -> "quit"
    }
}

run: fn() {
    print(show(Msg.Quit))
}
