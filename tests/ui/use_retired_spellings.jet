// #6542: the retired import spellings teach E0630. `as` names no import (the
// alias comes first, `alias :: path`), a renamed member is a row of its own,
// and a member list is written in brackets.
use core.files as fs
use core.math.[max as biggest, min]
use core.text.{trim}

fn run() {
    print(biggest(1, min(2, 3)))
    print(trim(" ok "))
    print(fs.exists("missing.txt"))
}
