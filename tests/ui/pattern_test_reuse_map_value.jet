Shape: enum {
    Rect(w: Int, h: Int)
    Dot
}

Point: struct {
    x: Int
    y: Int
}

parse: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

run: fn() {
    name: "ada"
    user: ["name": "ada"]
    same: user == ["name": name, ..]
    print("{same} {name}")
}
