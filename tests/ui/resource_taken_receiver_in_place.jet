// E0211: a taking receiver (`&&self`) read in place leaves its place still
// owning the value. Releasing a lease that is a field of a list element, or of
// a read receiver, would close its handle once in the call and again when the
// list or the caller cleans up. Take the element out of its list first.
use files: core.files

Lease: struct {
    handle: files.Directory?

    release: fn(&&self) {}
}

Package: struct {
    name: String
    lease: Lease
}

element_field: fn(packages: &&[Package]) {
    packages[0].lease.release()
}

Holder: struct {
    lease: Lease

    read_receiver: fn(self) {
        self.lease.release()
    }
}

run: fn() {}
