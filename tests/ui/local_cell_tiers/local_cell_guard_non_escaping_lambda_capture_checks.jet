// A lambda passed to a direct parameter never outlives the guard it
// captures, so the capture holds no loan past the guard's scope.
apply: fn(f: fn() -> Int) -> Int {
    return f()
}

run: fn() {
    cell: Cell.new(1)
    guard: cell.guard_read()
    xs: [1, 2, 3]
    total: xs.map(x -> x + guard.get()).sum()
    print(total)
}

read_once: fn(cell: Cell<Int>) -> Int {
    guard: cell.guard_read()
    return apply(() -> guard.get())
}
