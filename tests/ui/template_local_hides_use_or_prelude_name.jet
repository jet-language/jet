use io: core.term

Note: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            io: target.name
            print: 1
            tname: target.name
            impl #{tname} {
                note: fn(self) -> Int { 1 }
            }
        }
    }
}

#Note
Point: struct {
    x: Int
}

run: fn() { io.print("{Point{x: 1}.note()}") }
