use core.math as math

fn run() {
    math.sqrt(1)
    math.is_nan(1).drop("type-mismatch diagnostic fixture")
    math.sign(1).drop("type-mismatch diagnostic fixture")
    math.pow(2.0, F32.from_float(2.0) ?? F32.from_int(0)).drop("type-mismatch diagnostic fixture")
    math.hypot(2.0, F32.from_float(2.0) ?? F32.from_int(0)).drop("type-mismatch diagnostic fixture")
}
