// A user module declared exactly as the runtime declares jet.runtime.time (an
// inline `time` module of `#Import(c)` members naming runtime exports) is not
// a runtime binding: only the generated interface and the runtime package are.
// Its members are ordinary C imports, so naming a runtime export outside
// `#Unsafe` is E3101, a type with no C ABI is E3203, and two imports of one
// symbol are E1341.
time: module {
    #Import(c) zone_env: fn(name: String) -[Env]> String? = "jet_time_raw_zone_env"
    #Import(c) wall_sample: fn() -[Time]> (epoch_seconds: Int, fraction_ns: Int, pre_epoch: Bool) = "jet_time_raw_wall_sample"
    #Import(c) zone_file_bytes: fn(path: String) -[FS.Read]> [U8]? = "jet_time_raw_zone_file_bytes"
}

#Import(c) top_zone_env: fn(name: String) -[Env]> String? = "jet_time_raw_zone_env"

run: fn() -[Env, IO]> {
    print(time.zone_env("TZ") ?? "none")
}
