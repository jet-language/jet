// A program reaches the runtime's public time functions through the
// jet.runtime interface: each call is checked against the member's Jet
// signature and effect row, its route carriers included (a String parameter,
// an Option, a List and a tuple result); a member without a row is pure.
use rt: jet.runtime.time

nap: fn(nanos: Int) -[Time]> Int {
    rt.sleep_ns(nanos)
    rt.task_timeout(nanos)
    rt.reject_uncontrolled("clock")
    sample: rt.wall_sample()
    if sample.pre_epoch -> return rt.world_wall_ms() ?? 0
    sample.epoch_seconds + sample.fraction_ns + rt.host_monotonic_ns() + rt.clock_mono_ns()
}

zone: fn(name: String) -[Env, FS.Read]> Int {
    found: rt.zone_env(name) ?? return 0
    bytes: rt.zone_file_bytes(found) ?? return 0
    bytes.len()
}

pure_reads: fn() -> Int {
    embedded: rt.embedded_zone_bytes("UTC") ?? [U8]{}
    embedded.len()
}

run: fn() -[IO, Env, FS.Read, Time]> {
    print(nap(1) >= 0)
    print(zone("TZ") >= 0)
    print(pure_reads() >= 0)
}
