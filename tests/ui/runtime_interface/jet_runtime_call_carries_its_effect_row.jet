// A jet.runtime member has no body in the program: its declared row
// (`-[Time]>` on host_monotonic_ns) is the effect a call performs, so a
// caller whose row lacks it is E0740.
use rt: jet.runtime.time

stamp: fn() -[IO]> Int {
    rt.host_monotonic_ns()
}

run: fn() -[IO]> {
    print(stamp())
}
