// E2418: error conversion graphs must not contain cycles.
#Error SourceErr: enum { One }
#Error TargetErr: enum { One }

impl TargetErr.From(SourceErr) { from: fn(error: SourceErr) -> TargetErr { TargetErr.One } }
impl SourceErr.From(TargetErr) { from: fn(error: TargetErr) -> SourceErr { SourceErr.One } }

run: fn() {}
