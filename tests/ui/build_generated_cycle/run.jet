// @programmable_build
build: fn(b: Build) {
    b.generate("alpha") {
        alpha: fn() {}
    }?
    b.generate("alpha") {
        beta: fn() {}
    }?
    app: b.add_executable("app", ["main.jet", ".jet/generated/main/alpha.jet", ".jet/generated/main/beta.jet"], [])?
    b.default(app)
}

run: fn() {}
