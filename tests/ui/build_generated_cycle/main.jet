// @programmable_build

fn build(b: BuildContext) => BuildPlan ? {
    b.generate("alpha", "use \"beta\"\npub fn alpha() {{}}")?
    b.generate("beta", "use \"alpha\"\npub fn beta() {{}}")?
    app :: b.add_executable(
        "app",
        ["main.jet", ".jet/generated/main/alpha.jet", ".jet/generated/main/beta.jet"],
        []
    )?
    return b.plan(app)
}

fn run() {}
