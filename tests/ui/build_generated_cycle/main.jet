// @programmable_build

fn build(b: BuildContext) => BuildPlan ? {
    b.generate("alpha") {
        pub fn alpha() {}
    }?
    b.generate("alpha") {
        pub fn beta() {}
    }?
    app :: b.add_executable(
        "app",
        ["main.jet", ".jet/generated/main/alpha.jet", ".jet/generated/main/beta.jet"],
        []
    )?
    return b.plan(app)
}

fn run() {}
