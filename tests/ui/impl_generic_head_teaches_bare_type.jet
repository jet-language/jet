// #5967: `impl Stack<T> {` from other languages is one refusal whose Fix
// spells `impl Stack {`, with no cascade at the closing brace.
struct Stack<T> {
    items: [T]
}

impl Stack<T> {
    fn size(self) -> Int {
        self.items.len()
    }
}

fn run() {
    s :: Stack<Int>{items: [1, 2]}
    print(s.size())
}
