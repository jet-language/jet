StateFacts: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            states: target.reflect().states
            derived_fact_read: fn() -> String { "ok" }
        }
    }
}

#StateFacts
Report: struct {
    state { Draft, Published }
    value: Int
}

run: fn() {}
