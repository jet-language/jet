// @all_diags
// A version dependency resolves only to the toolchain's first-party battery
// of its name whose version the selector matches (the Rust jetpack's
// batteries registry). The `web` battery is 0.1.0, not 9.0.0, and no battery
// is named `nosuchbattery`, so each import reports E0603.
use web
use nosuchbattery

fn run() {
    print("never gets here")
}
