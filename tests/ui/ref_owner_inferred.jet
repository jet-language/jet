// D-REF-SHORTHAND1: exactly one in-scope value has the referent type, so the
// owner of the `&String` field is inferred — no `#Ref(label)` needed.
struct TokenView {
    text: &String
}
fn show(source: String) {
    t: TokenView :: TokenView.{ text: source }
    print(t.text)
}
fn run() {
    show("hello")
}
