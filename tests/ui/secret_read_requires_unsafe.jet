// E0510: only the module that declares a secret type reads its `.bytes`
// freely. Every other module, a Core one included, reads them only inside an
// audited `#Unsafe` region; the read inside one below is accepted.
use crypto: core.crypto

run: fn() {
    secret: crypto.Secret{bytes: "hunter2".bytes()}
    #Unsafe("the length leaves this function, never the key bytes") {
        print(secret.bytes.len())
    }
    print(secret.bytes.len())
}
