// A function with a trait-bounded variadic parameter is checked against its
// bounds even when nothing calls it.
Edit: trait {
    edit: fn(&self) -> Int
}
Inspect: trait {
    inspect: fn(self) -> String
}

apply: fn(items: ...[Edit, Inspect]) {
    loop item in items {
        item.nothing_here()
    }
}

run: fn() {
    print("ok")
}
