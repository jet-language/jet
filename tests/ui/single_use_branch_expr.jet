// D-LIN1 / D-FACT-FLOW1 / E0141: a `#SingleUse` value consumed on one arm of a
// value-position `if` and dropped on the other. The merged flow store alone
// would call it consumed either way (`Moved::join` is a union), so this needs
// its own branch-divergence check.
#SingleUse Lock: struct {
    resource: String
}

acquire: fn(resource: String) -> Lock { return Lock{resource: resource.copy()} }

release: fn(lock: &&Lock) { print("unlocked {lock.resource}") }

run: fn() {
    db: acquire("db")
    flag: true
    x: if {
        flag -> {
            release(db)
            1
        }
        else -> 2
    }
    print(x)
}
