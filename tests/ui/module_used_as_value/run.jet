// A Core module has no Module record, so it is not a value: `math` is E0629
// each time it is bound, passed, returned, stored or printed.
use core.math

Box: struct { v: String }

show: fn(s: String) { print(s) }

pick: fn() -> String { math }

run: fn() {
    m: math
    show(math)
    b: Box{v: math}
    print("{math}")
    print(math.abs(-2))
}
