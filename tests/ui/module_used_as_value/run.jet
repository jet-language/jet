// A module is not a value: the folder module `text` and the inline module
// `lib.inner` are each E0629 when bound, passed, returned, stored or printed.
text: module
lib: module

Box: struct { v: String }

show: fn(s: String) { print(s) }

pick: fn() -> String { text }

pick_inner: fn() -> String { lib.inner }

run: fn() {
    m: text
    n: lib.inner
    show(text)
    show(lib.inner)
    b: Box{v: text}
    c: Box{v: lib.inner}
    print("{text} {lib.inner}")
    print(text.shout("hi"))
    print(lib.inner.f())
}
