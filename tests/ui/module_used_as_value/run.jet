// A module is not a value: the folder module `text` and the inline module
// `lib.inner` are each E0629 when bound, passed, returned, stored or printed.
module text
module lib

struct Box { v: String }

fn show(s: String) { print(s) }

fn pick() -> String { text }

fn pick_inner() -> String { lib.inner }

fn run() {
    m :: text
    n :: lib.inner
    show(text)
    show(lib.inner)
    b :: Box{v: text}
    c :: Box{v: lib.inner}
    print("{text} {lib.inner}")
    print(text.shout("hi"))
    print(lib.inner.f())
}
