// E0367: bare payload variant patterns need a leading `.` (D-ENUMDOT1).
Light: enum {
    Fade(Int)
}

show: fn(light: Light, result: Int String!, value: Int | String) {
    if light == {
        Fade(n) -> { print(n) }
    }
    if result == {
        Ok(n) -> { print(n) }
        Err(e) -> { print(e) }
    }
    if value == {
        Int(n) -> { print(n) }
        String(s) -> { print(s) }
    }
}

run: fn() {
    show(Light.Fade(1), Ok(1), 2)
}
