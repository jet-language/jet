Shape: enum {
    Rect(w: Int, h: Int)
    Dot
}

Point: struct {
    x: Int
    y: Int
}

parse: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

run: fn() {
    held: 3
    maybe: Shape?{Val(Shape.Rect{w: 3, h: 4})}
    same: maybe == .Val(.Rect(held, _))
    print("{same} {held}")
}
