// Matrix cell (closure capture): a closure can't smuggle a borrow of a local
// past a `view` return. The closure call's result is fresh as far as the
// caller is concerned, so it's rejected — no borrow escapes its source.
fn make() -> &String {
    local: String @= "hi"
    grab @= () => local
    return grab()
}
fn main() {
    print(0)
}
