// `User? DBError!` names its states directly, so the
// nested `.Ok(.Val(..))` / `.Ok(.None)` spelling is refused (E0392) with an
// edit to the flat state.
User: struct {
    name: String
}

#Error
DBError: enum {
    Down
}

read_user: fn(id: Int) -> User? DBError! {
    if id == 0 -> return Err(DBError.Down)
    if id == 7 -> return Ok(Val(User{name: "priya"}))
    Ok(None)
}

run: fn() {
    if read_user(7) == {
        .Val(user) -> print(user.name)
        .None -> print("no such user")
        .Err(_) -> print("database down")
    }
}
