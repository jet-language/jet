// #6014: each trail hop shows its trimmed source line, innermost first.
parse: fn(raw: String) -> Int {
    if raw == "" -> return Err("empty input")
    7
}

double: fn(raw: String) -> Int {
    n: parse(raw)
    n * 2
}

total: fn() -> Int {
    a: double("x")
    b: double("")
    a + b
}

run: fn() { print(total()) }
// @run_cli
