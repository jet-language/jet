// #6014: each trail hop shows its trimmed source line, innermost first.
fn parse(raw: String) -> Int {
    if raw == "" -> return Err("empty input")
    7
}

fn double(raw: String) -> Int {
    n :: parse(raw)
    n * 2
}

fn total() -> Int {
    a :: double("x")
    b :: double("")
    a + b
}

fn run() { print(total()) }
// @run_cli
