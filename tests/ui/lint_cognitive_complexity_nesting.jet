// @complexity_cli pass 3
two_loops: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        loop j in 0..<n {
            total += i * j
        }
    }
    return total
}

nested_if: fn(a: Int, b: Int) -> Int {
    if a > 0 {
        if b > 0 -> return 1
    }
    return 0
}

if_in_loop: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        if i > 2 -> total += i
    }
    return total
}

run: fn() {}
