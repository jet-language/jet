// @complexity_cli pass 3
fn two_loops(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        loop j in 0..<n {
            total += i * j
        }
    }
    return total
}

fn nested_if(a: Int, b: Int) -> Int {
    if a > 0 {
        if b > 0 -> return 1
    }
    return 0
}

fn if_in_loop(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        if i > 2 -> total += i
    }
    return total
}

fn run() {}
