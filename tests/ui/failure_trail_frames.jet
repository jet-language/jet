// `?(text)` frames stay in order: the report lists each context frame, origin
// first, and each hop that added a note shows it.
read_raw: fn() -> String { Err("file not found") }

parse_config: fn() -> Int {
    raw: read_raw()?("reading raw config")
    raw.len()
}

load: fn() -> Int { parse_config()?("loading config") }

run: fn() { print(load()?("starting the app")) }
// @run_cli
