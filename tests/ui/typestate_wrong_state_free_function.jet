// D-STATE1: free-function typestate checks use the tracked first argument.
// `bounce_ready` requires `Unit`, but `v` starts in `Raw`.
Vec3: struct {
    state { Raw, Unit }
    x: Float
}

#Transition(_, Raw) vec3: fn(x: Float) -> Vec3 { Vec3{x: x} }

#Transition(Raw, Unit) normalize: fn(v: ^Vec3) -> Vec3 { v }

#State(Unit) bounce_ready: fn(normal: Vec3) -> Bool { true }

run: fn() {
    v := vec3(Float{3.0})
    print("{bounce_ready(v)}")
}
