// @all_diags
// Core crypto restrictions follow resolved nominal provenance, not leaf names.
use core.crypto as crypto

struct Secret { label: String }
struct SigningKey { label: String }
struct X25519SecretKey { label: String }
struct SharedSecret { label: String }

fn run() {
    core_secret :: crypto.Secret.from_text("core")
    core_signing :: crypto.SigningKey.generate() ?? panic("signing key")
    core_x25519 :: crypto.X25519SecretKey.generate() ?? panic("x25519 key")
    core_public :: core_x25519.public_key()
    core_shared :: crypto.x25519(core_x25519, core_public) ?? panic("shared secret")
    secret :: Secret.{ label: "local" }
    signing :: SigningKey.{ label: "local" }
    x25519 :: X25519SecretKey.{ label: "local" }
    shared :: SharedSecret.{ label: "local" }
    print("{secret}")
    print("{signing}")
    print("{x25519}")
    print("{shared}")
    print("{core_secret}")
    print("{core_signing}")
    print("{core_x25519}")
    print("{core_shared}")
}
