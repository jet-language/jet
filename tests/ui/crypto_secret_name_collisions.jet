// @all_diags
// Core crypto restrictions follow resolved nominal provenance, not leaf names.
use crypto: core.crypto

Secret: struct {
    label: String
}

SigningKey: struct {
    label: String
}

X25519SecretKey: struct {
    label: String
}

SharedSecret: struct {
    label: String
}

run: fn() {
    core_secret: crypto.Secret.from_text("core")
    core_signing: crypto.SigningKey.new_random() ?? panic("signing key")
    core_x25519: crypto.X25519SecretKey.new_random() ?? panic("x25519 key")
    core_public: core_x25519.public_key()
    core_shared: crypto.x25519(core_x25519, core_public) ?? panic("shared secret")
    secret: Secret{label: "local"}
    signing: SigningKey{label: "local"}
    x25519: X25519SecretKey{label: "local"}
    shared: SharedSecret{label: "local"}
    print("{secret}")
    print("{signing}")
    print("{x25519}")
    print("{shared}")
    print("{core_secret}")
    print("{core_signing}")
    print("{core_x25519}")
    print("{core_shared}")
}
