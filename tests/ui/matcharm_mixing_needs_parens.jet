// E0328 (D-MATCHARM2=B): value alternates and `&&` at the same level require parens.
// `400 | 404 && fresh` is ambiguous; write `(400 | 404) && fresh`.
fn handle(code: Int, fresh: Bool) -> String {
    if code == {
        400 | 404 && fresh -> { return "retry" }
        else -> { return "other" }
    }
}
fn run() {
    print(handle(400, true))
}
