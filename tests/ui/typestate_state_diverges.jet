// @all_diags
// D-FACT-FLOW1 (card #1621): one arm confirms the order, the other cancels it,
// so after the arms meet nobody can say which state `order` is in. The one join
// rule reports that instead of keeping whichever arm was walked last.
Order: struct {
    state {
        Draft -> Confirmed, Cancelled
        Confirmed -> Draft
        Cancelled -> Draft
    }
    id: Int

    start: fn(id: Int) -> Order.Draft { Order{id: id} }

    confirm: fn(self: &&Order.Draft) -> Order.Confirmed { self }

    cancel: fn(self: &&Order.Draft) -> Order.Cancelled { self }

    reopen: fn(self: &&Order.Confirmed) -> Order.Draft { self }

    restore: fn(self: &&Order.Cancelled) -> Order.Draft { self }
}

job: fn(cents: Int) {
    order := Order.start(1)
    if {
        cents > 0 -> order = order.confirm()
        else -> order = order.cancel()
    }
    print(order.id)
}
