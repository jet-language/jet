// @all_diags
// D-FACT-FLOW1 (card #1621): one arm confirms the order, the other cancels it,
// so after the arms meet nobody can say which state `order` is in. The one join
// rule reports that instead of keeping whichever arm was walked last.
Order: struct {
    state { Draft, Confirmed, Cancelled }
    id: Int
}

impl Order {
    #Transition(_, Draft) start: fn(id: Int) -> Order { Order{id: id} }

    #Transition(Draft, Confirmed) confirm: fn(self: ^Order) -> Order { self }

    #Transition(Draft, Cancelled) cancel: fn(self: ^Order) -> Order { self }

    #Transition(Confirmed, Draft) reopen: fn(self: ^Order) -> Order { self }

    #Transition(Cancelled, Draft) restore: fn(self: ^Order) -> Order { self }
}

job: fn(cents: Int) {
    order := Order.start(1)
    if {
        cents > 0 -> order = ^order.confirm()
        else -> order = ^order.cancel()
    }
    print(order.id)
}
