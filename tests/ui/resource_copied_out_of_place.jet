// E0211: a value that holds a resource (here a `Directory` handle) has one
// cleanup owner. Binding an element, a field of an element, or a field of a
// borrowed receiver into an owned name would copy the handle, and the copy's
// cleanup would close the handle the collection still holds.
use files: core.files

Held: struct {
    handle: files.Directory
    path: String
}

Auth: struct {
    dirs: [Held]

    element: fn(self) -> String {
        parent: self.dirs[0]
        parent.path
    }

    element_field: fn(self) -[FS]> Bool {
        h: self.dirs[0].handle
        h.stat() != None
    }

    whole_list: fn(self) -> Int {
        dirs := self.dirs
        dirs.len()
    }
}

run: fn() {}
