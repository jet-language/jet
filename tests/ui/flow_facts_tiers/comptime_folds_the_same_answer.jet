
fn label(text: String?) -> String {
    if text != None {
        return text
    }
    return "none"
}

fn score(flag: Bool) -> Int {
    total := 0
    if {
        flag -> total = 2
        else -> total = 3
    }
    return total
}

fn run() {
    print(label(Val("keep")))
    print(label(None))
    print(score(true))
    print(score(false))
}

FOLDED :: comptime { score(true) }

fn show() {
    print(FOLDED)
}
