// When `check` rejects a literal with an error that carries a String reason,
// E2712's Why line is that reason.

#Error
RouteError: struct { reason: String }

Route: struct {
    text: String
}

impl Route.CheckedText {
    Error: RouteError
    Hole: String

    check: fn(text: String) RouteError! -[]> {
        if !text.starts_with("/") -> return Err(RouteError{reason: "a route must start with `/`"})
        return Ok()
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String { "{value}" }

    build: fn(parts: [String], holes: [String]) -[]> Route {
        Route{text: parts.join("*")}
    }
}

run: fn() {
    id := 7
    route: Route{"users/{id}"}
    print(route.text)
}
