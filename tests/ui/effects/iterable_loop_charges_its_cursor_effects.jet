// #6086: `files.walk` only builds its cursor; the loop's implicit `iter`,
// `next` and `close` calls read the tree. Those calls are the loop's, so a
// loop over the walk uses FS, directly or inside a callback lambda, and a row
// that allows only IO refuses it with E0740.
use files: core.files

count_direct: fn(root: String) -[IO]> Int {
    count := 0
    loop item in files.walk(root) {
        _: item ?? panic("walk")
        count += 1
    }
    count
}

count_in_callback: fn(roots: [String]) -[IO]> Int {
    count := 0
    roots.each((root) -> {
        loop item in files.walk(root) {
            _: item ?? panic("walk")
            count += 1
        }
    })
    count
}

run: fn() {
    print("{count_direct(".") + count_in_callback(["."])}")
}
