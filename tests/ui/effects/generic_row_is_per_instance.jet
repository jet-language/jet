use log: core.log
Item: trait { get: fn(self) -> Int }
Pure: struct { n: Int }
impl Pure.Item {
    get: fn(self) -> Int { self.n }
}
Logger: struct { n: Int }
impl Logger.Item {
    get: fn(self) -> Int {
        log.info("get")
        self.n
    }
}
Box: struct<T: Item> {
    inner: T
    get: fn(self) -> Int { self.inner.get() }
}
pure_box: fn(b: Box<Pure>) -[]> Int { b.get() }
log_box: fn(b: Box<Logger>) -[Net]> Int { b.get() }
run: fn() { print(pure_box(Box<Pure>{inner: Pure{n: 1}}) + log_box(Box<Logger>{inner: Logger{n: 2}})) }
