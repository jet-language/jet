Loud: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[]> {
            tname: target.name
            impl #{tname} {
                loud: fn(self) -> String { "LOUD" }
            }
        }
    }
}

#Loud
Point: struct {
    x: Int
}

run: fn() { print(Point{x: 1}.x) }
