
use fs: core.files

need: fn(value: Int) {
    print(value)
}

erased_refinement: fn(value: Int?) {
    #Off {
        if value == .None {
            return
        }
        need(value)
    }
    need(value)
}

erased_effect: fn() -[IO]> {
    #Off {
        #FX(authority: FS) {
            _text: fs.read("missing") ?? ""
        }
    }
    print("erased")
}

active_effect: fn() -[IO]> {
    #FX(authority: FS) {
        _text: fs.read("missing") ?? ""
    }
    print("active")
}

run: fn() {}
