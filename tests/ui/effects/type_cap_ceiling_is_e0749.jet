use fs: core.files

#FX(IO)
Report: struct {
    title: String

    show: fn(self) { print(self.title) }
    load: fn(self) -> String { fs.read("rates.txt") ?? "" }
}

#FX(!IO)
Level: enum {
    Low
    High
}

impl Level {
    hush: fn(self) { print("x") }
}

run: fn() {
    report: Report{title: "ok"}
    report.show()
    print(report.load())
    Level.Low.hush()
}
