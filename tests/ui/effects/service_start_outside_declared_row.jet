// D-SERVICE-EFFECTS1=A: `start` recovers the tree's durable state store, so it
// reads and writes files and resolves the store path against the working
// directory (Env). A row that allows only Time is refused with E0740.
use service: core.service

launch: fn() -[Time]> {
    tree := service.tree("orders")
    tree.start() ?? panic("start")
}

run: fn() { launch() }
