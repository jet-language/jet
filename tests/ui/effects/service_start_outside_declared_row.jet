// D-SERVICE-EFFECTS1=A: `start` recovers the tree's durable state store, so
// its Core source reads and writes files. A function whose row allows only
// Time is refused with E0740 naming the file effects it reaches.
use service: core.service

launch: fn() -[Time]> {
    tree := service.tree("orders")
    tree.start() ?? panic("start")
}

run: fn() { launch() }
