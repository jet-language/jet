
Gate: struct { state { Closed, Reopened } }
impl Gate {
    #Transition(_, Closed) new: fn() -[]> Gate { return Gate{} }
    #Transition(Closed, Reopened) reopen: fn(self: ^Gate) -[]> Gate { return self }
    #Transition(Closed, Reopened) reopen: fn(self: ^Gate) -[]> Gate { return self }
}
run: fn() {}
