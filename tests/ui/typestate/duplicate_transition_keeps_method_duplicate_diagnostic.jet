
struct Gate { state { Closed, Reopened } }
impl Gate {
    #Transition(_, Closed) fn new() -[]> Gate { return Gate{} }
    #Transition(Closed, Reopened) fn reopen(self: ^Gate) -[]> Gate { return self }
    #Transition(Closed, Reopened) fn reopen(self: ^Gate) -[]> Gate { return self }
}
fn run() {}
