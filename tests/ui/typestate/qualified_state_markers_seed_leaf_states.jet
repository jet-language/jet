
Door: struct {
    state { Closed, Open }
}

impl Door {
    #State(_ -> Door.State.Closed) new: fn() -[]> Door { return Door{} }
    #State(Door.State.Closed -> Door.State.Open) open: fn(self: &&Door) -[]> Door {
        return self
    }
    #State(Door.State.Closed) inspect: fn(self: &&Door) -[]> String {
        next := self.open()
        return "closed"
    }
}

run: fn() {}
