
struct Crate {
    state { Full, Empty }
    data: Int
}

impl Crate {
    #Transition(_, Full) fn fill(data: Int) -[]> Crate {
        return Crate{ data: data }
    }
    #State(Stuffed) fn get(self) -[]> Int {
        return self.data
    }
}

fn run() {
    b := Crate.fill(1)
    print(b.get())
}
