
Crate: struct {
    state { Full, Empty }
    data: Int
}

impl Crate {
    #State(_ -> Full) fill: fn(data: Int) -[]> Crate {
        return Crate{ data: data }
    }
    #State(Stuffed) get: fn(self) -[]> Int {
        return self.data
    }
}

run: fn() {
    b := Crate.fill(1)
    print(b.get())
}
