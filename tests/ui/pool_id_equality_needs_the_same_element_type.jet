// Pool ids compare with `==` and `!=` (D-POOLID-API1=A), so
// comparing two `ID<Player>` values raises no E0312. An `ID<Player>` and an
// `ID<Item>` name slots in different pools, so comparing them is refused.
Player: struct {
    name: String
}

Item: struct {
    label: String
}

run: fn() {
    players := Pool<Player>.new()
    items := Pool<Item>.new()
    kai: players.add(Player{name: "Kai"})
    rem: players.add(Player{name: "Rem"})
    sword: items.add(Item{label: "Sword"})
    print(kai == rem)
    print(kai != rem)
    print(kai == sword)
}
