// D-JAI-SITE1=A: `#caller` is the place of a call, so it is legal only as a
// parameter default or inside an #Expand macro. Read in a body, there is no
// call to name, and the error names the two legal places.
report: fn(message: String) {
    at: #caller
    print("{at}: {message}")
}

run: fn() {
    report("ready")
}
