// D-FAIL-INFER-UNION1=A / D-ERR-CASES1=A: `age_of` writes no failure
// contract, so its failures are inferred as `FindPersonError | ParseAgeError`.
// A two-arm match that handles only `.NotFound` names the inferred member it
// is missing.
fn parse_age(raw: String) -> Int {
    if raw == "" -> return Err(.BadNumber(~raw))
    42
}

fn find_person(book: [String:String], name: String) -> String {
    if book.has_key(name) -> return book[name]
    Err(.NotFound(~name))
}

fn age_of(book: [String:String], name: String) -> Int {
    raw :: find_person(book, name)
    parse_age(raw)
}

fn describe(book: [String:String], name: String) -> String {
    if age_of(book, name) == {
        .Ok(n) -> "age {n}"
        .Err(.NotFound(_)) -> "no such person"
    }
}

fn run() {
    print(describe(["ada": "36"], "zed"))
}
