// D-METHOD-FOOTPRINT1=A: a stated receiver footprint names stored fields.
struct World {
    log: [String]
    hits: Int
}

impl World {
    fn bump(&self.[hits, score]) {
        self.hits += 1
    }
}

fn run() {
    world := World{log: [String]{}, hits: 0}
    &world.bump()
    print(world.hits)
}
