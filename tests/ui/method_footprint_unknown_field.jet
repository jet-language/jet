// D-METHOD-FOOTPRINT1=A: a stated receiver footprint names stored fields.
World: struct {
    log: [String]
    hits: Int
}

impl World {
    bump: fn(&self.[hits, score]) {
        self.hits += 1
    }
}

run: fn() {
    world := World{log: [String]{}, hits: 0}
    world.bump()
    print(world.hits)
}
