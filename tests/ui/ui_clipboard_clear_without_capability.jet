package: {
    name: "ui_clipboard_clear_without_capability"
    version: "0.1.0"
    authority: {
        allow: [IO, Mem.Alloc]
        needs: [UI.IME]
    }
}
use clipboard: core.ui.host.clipboard

// `clear` writes the clipboard through `write_text`, so it needs the same
// capability.
wipe: fn() {
    _wiped: clipboard.clear()
}

run: fn() {
    print("ready")
}
