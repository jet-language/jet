Debt: struct {
    cents: Int

    impl Sub(Int) {
        sub: fn(self, rhs: Int) -> Debt {
            return Debt{cents: self.cents - rhs}
        }
    }

    impl Div(Int) {
        div: fn(self, rhs: Int) -> Debt {
            return Debt{cents: self.cents /% rhs}
        }
    }
}

run: fn() {
    debt: Debt{cents: 20}
    bad_sub: 2 - debt
    bad_div: 2 / debt
}
