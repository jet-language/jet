struct Debt {
    cents: Int
}

impl Debt.Sub(Int) {
    fn sub(self, rhs: Int) Debt -> {
        return Debt{cents: self.cents - rhs}
    }
}

impl Debt.Div(Int) {
    fn div(self, rhs: Int) Debt -> {
        return Debt{cents: self.cents /% rhs}
    }
}

fn run() {
    debt :: Debt{cents: 20}
    bad_sub :: 2 - debt
    bad_div :: 2 / debt
}
