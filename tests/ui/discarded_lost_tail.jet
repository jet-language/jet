// E0433 (D-DISCARD1=A): a named function with no written return type returns
// nothing, so a value on its last line is thrown away. The error lands on
// that line instead of at a caller.
total: fn(a: Int, b: Int) {
    a + b
}

Counter: struct {
    hits: Int
}

impl Counter {
    doubled: fn(self) {
        self.hits * 2
    }
}

// Quiet: a Unit last line, an explicit discard, and a written return type.
report: fn(n: Int) {
    print(n)
}

warm: fn(n: Int) {
    total(n, n).drop("only warms the cache")
}

twice: fn(n: Int) -> Int {
    n * 2
}

// Quiet: a last line calling a unit `Never!` function succeeds with unit.
leave: fn(counter: &Counter) Never! {
    if counter.hits > 0 -> counter.hits -= 1
}

leave_twice: fn(counter: &Counter) {
    leave(&counter)
    leave(&counter)
}

run: fn() {
    total(1, 2)
    Counter{hits: 3}.doubled()
    report(twice(4))
    warm(5)
    counter := Counter{hits: 2}
    leave_twice(&counter)
}
