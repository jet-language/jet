// D-MATCHARM1=A: predicate arms (`code >= 500`) are now allowed.
// A comparison arm head tests the subject directly as a Bool expression.
classify: fn(code: Int) -> String {
    if code == {
        200 -> { return "ok" }
        code >= 500 -> { return "server error" }
        else -> { return "other" }
    }
}

run: fn() { print(classify(503)) }
