// A match payload bound from storage this scope does not own reads its
// value in place: a borrowed parameter's payload, an element subject's
// payload and a loop name over such a payload can't be copied out. A loop
// over a `:` field binding reads the field in place, so its names can't be
// moved out either.
Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
keep: fn(r: &&Res) -> Int { r.name.len() }

from_param: fn(env: Res?) -> Int {
    if env == .Val(held) {
        applied := held
        return keep(applied)
    }
    0
}

from_element: fn(items: [Res?]) -> Int {
    if items[0] == .Val(held) {
        applied := held
        return keep(applied)
    }
    0
}

from_payload_loop: fn(warm: [Res]?) -> Int {
    merged := [Res]{}
    if warm == .Val(existing) {
        loop entry in existing -> merged.push(entry)
    }
    merged.len()
}

Holder: struct { items: [Res] }

from_projection_loop: fn() -> Int {
    value := Holder{items: [Res{name: "a"}]}
    items: value.items
    value.items = [Res]{}
    sink := [Res]{}
    loop item in items -> sink.push(item)
    sink.len()
}

from_param_loop: fn(items: [Res]) -> Int {
    sink := [Res]{}
    loop item in items -> sink.push(item)
    sink.len()
}

run: fn() {
    print("unreached")
}
