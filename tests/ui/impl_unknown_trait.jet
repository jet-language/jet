Point: struct {
    x: Int
}

Label: struct {
    text: String
}

impl Point.Hash {
    hash: fn(self) -> Int { self.x }
}

impl Point.Label {
    label: fn(self) -> String { "point" }
}

Pixel: struct {
    x: Int
    impl Clone {
        clone: fn(self) -> Pixel { Pixel{x: self.x} }
    }
}

run: fn() {
    print(Point{x: 1}.x)
    print(Pixel{x: 2}.x)
}
