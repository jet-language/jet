Point: struct {
    x: Int

    impl Hash {
        hash: fn(self) -> Int { self.x }
    }

    impl Label {
        label: fn(self) -> String { "point" }
    }
}

Label: struct {
    text: String
}

Pixel: struct {
    x: Int
    impl Clone {
        clone: fn(self) -> Pixel { Pixel{x: self.x} }
    }
}

run: fn() {
    print(Point{x: 1}.x)
    print(Pixel{x: 2}.x)
}
