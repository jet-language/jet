struct Point {
    x: Int
}

struct Label {
    text: String
}

impl Point.Hash {
    fn hash(self) -> Int { self.x }
}

impl Point.Label {
    fn label(self) -> String { "point" }
}

struct Pixel {
    x: Int
    impl Clone {
        fn clone(self) -> Pixel { Pixel{x: self.x} }
    }
}

fn run() {
    print(Point{x: 1}.x)
    print(Pixel{x: 2}.x)
}
