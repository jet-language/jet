// E0641 over `T?` and a union: each `else` stands for cases of a closed set,
// and its edit names them (`.None`, `.String`).
first: fn(x: Int?) -> Int {
    if x == {
        .Val(n) -> n
        else -> 0
    }
}

kind: fn(v: Int | String) -> String {
    if v == {
        .Int -> "number"
        else -> "text"
    }
}

run: fn() {
    print(first(None))
    print(kind(3))
}
