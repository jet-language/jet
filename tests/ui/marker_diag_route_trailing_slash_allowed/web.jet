// The D-MARKER-DIAG1 example library: `#Web.Route(path)` rejects a path that
// doesn't start at the site root with `web.BadPath`, and warns about a
// trailing slash with `web.TrailingSlash`, which `#Allow` can silence.
BadPath: struct {
    path: String

    impl Diagnostic {
        what: fn(self) -> String { "route path `{self.path}` doesn't start with `/`" }
        why: fn(self) -> String { "a route path is matched from the root of the site" }
        fix: fn(self) -> String { "write the path as `/{self.path}`" }
    }
}

TrailingSlash: struct {
    path: String

    impl Diagnostic {
        severity: .Warning
        what: fn(self) -> String { "route path `{self.path}` ends with `/`" }
        why: fn(self) -> String { "`{self.path}` and the path without its last `/` are different routes" }
        fix: fn(self) -> String { "drop the last `/`, or keep it with `#Allow(web.TrailingSlash, \"why\")`" }
    }
}

Route: struct {
    path: String

    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            if !self.path.starts_with("/") {
                reject(BadPath{path: self.path})
            }
            if self.path != "/" && self.path.ends_with("/") {
                reject(TrailingSlash{path: self.path})
            }
        }
    }
}
