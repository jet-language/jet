// D-MIGRATE1 (I2 fix): `PublishedSchema` inside an item-level `#[…]` bracket
// LIST must set `is_published_schema` exactly like the single-prefix
// `#PublishedSchema Name: struct …` form — E0910 must still fire for a broken
// migration when the marker is spelled this way. The sibling
// .published.snapshot is the prior shape.
#[PublishedSchema, Codable]
Account: struct {
    name: String
    verified: Bool
}

run: fn() {
    a: Account{name: "Alice", verified: true}
    print("{a.name}")
}
