use {
    http: core.http
    server: core.http.server
}

CACHE_PATH: "/cache/:key"
ITEM_PATH: CACHE_PATH

handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! { Ok(server.response(200, "ok")) }

register: fn(path: String) {
    router: http.router()
    router.get(path, handle)
}

run: fn() {
    router: http.router()
    router.get(CACHE_PATH, (key: String) -> Ok(server.response(200, "hit {key}")))
    router.delete(ITEM_PATH, (key: String) -> Ok(server.response(200, "gone {key}")))
    register("/dynamic")
}
