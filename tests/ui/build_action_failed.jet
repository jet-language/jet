// @programmable_build
// @build_grants Exec
// @requires tool:bwrap
build: fn(b: Build) -[Exec]> {
    #Impure("run failing action fixture") {
        action: b.action("fail", [], ["never"], ["sh", "-c", "printf 'first\\nsecond\\n' >&2; exit 7"], ["Exec"])
        app: b.add_executable("app", ["build_action_failed.jet"], [action])
        b.default(app)
    }
}

run: fn() {

}
