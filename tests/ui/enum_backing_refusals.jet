#Layout(U8)
Shape: enum {
    Dot
    Circle(radius: Int)
}

#Layout(U8)
Wide: enum {
    Small = 1
    Large = 256
}

#Layout(I8)
Climb: enum {
    Top = 127
    Over
}

#Layout(U16)
Twice: enum {
    First = 3
    Second = 2
    Third
}

LIMIT: 4

#Layout(U8)
Computed: enum {
    Base = LIMIT
}

run: fn() {}
