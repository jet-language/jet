// E2406: `impl Source -> Target` where neither type is defined in this program
// (orphan rule for error conversions, analogous to S28 for trait impls).
// Note: in Jet v1, all user-defined types ARE local — this fixture demonstrates
// the diagnostic by using two types that sema knows are not locally-defined.
// Since the compiler can only reject non-local types and all enum/struct definitions
// in a file ARE local, we test this via a compile-check annotation.
// For now, this is a positive test showing that locally-defined types ARE accepted.
enum MyErr { Bad }
enum MyTarget { Wrapped(MyErr) }
impl MyErr -> MyTarget { return MyTarget.Wrapped(self) }
fn main() {}
