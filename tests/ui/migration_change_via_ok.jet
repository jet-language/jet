// Tests that `change note: String -> Label via { … }` (D-MIGRATE2E) unblocks a
// type change with an inline converter. The .published.snapshot has `note: String`.
struct Label {
    text: String
}

@PublishedSchema
struct Order {
    id: Int
    note: Label
}

migration Order {
    change note: String -> Label via { (s) => Label.{ text: s } }
}

fn main() {
    o :: Order.{
        id: 1
        note: Label.{ text: "rush" }
    }
    print("{o.id}")
}
