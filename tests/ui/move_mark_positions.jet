// D-COPY-DEFAULT1=A (#3714): `^place` is an exact move in every value
// position (field initializer, collection element, assignment, result), with
// no E0225. Each source is read again afterwards, so each later read is E0121.
struct Box {
    xs: [Int]
}

fn keep(values: ^[Int]) -> [Int] {
    ^values
}

fn run() {
    a := [1]
    holder :: Box{xs: ^a}
    b := [2]
    rows :: [[Int]]{^b}
    c := [3]
    d := [0]
    d = ^c
    kept :: keep(^d)
    print("{holder.xs.len()} {rows.len()} {kept.len()}")
    print(a.len())
    print(b.len())
    print(c.len())
}
