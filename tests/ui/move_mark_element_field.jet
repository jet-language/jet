// D-COPY-DEFAULT1=A: `.move()` on any place below a collection element is E0225,
// as `.move()` on the element itself is. The element keeps owning its fields, so
// the value can only be a copy; the fix spells it with `.copy()`.
Item: struct {
    tags: [String]
}

Shelf: struct {
    items: [Item]
}

run: fn() {
    items := [Item{tags: ["a"]}]
    tags := items[0].tags.move()
    shelf := Shelf{items: [Item{tags: ["b"]}]}
    nested := shelf.items[0].tags.move()
    print(tags.len() + nested.len() + items[0].tags.len())
}
