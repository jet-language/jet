// D-PREP-FN1=A: the retired `@fn` literal-hook head teaches `prep fn`
// (E0388) and carries a machine-applicable respelling.
struct Cents {
    amount: Int
}

impl Cents.Literal.Int {
    @fn from_literal(value: Int) -> Cents { Cents{amount: value} }
}

fn accept(value: Cents) -> Cents { value }

fn run() {
    print(accept(5).amount)
}
