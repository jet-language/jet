Level: enum {
    Low
    High
}

run: fn() {
    stats := ["level": 3, "score": 10, "level": 7]
    names := [Level.Low: "low", Level.High: "high", Level.Low: "lower"]
    codes := [404: "missing", 500: "failed", 404: "gone"]
    stats["level"] = 99
    print(stats["level"])
    print(names.len())
    print(codes.len())
}
