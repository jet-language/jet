// A diagnostic inside a string interpolation nested in another interpolation
// points at the nested expression's own line, not at an earlier line.
Loc: struct { line: Int }

show: fn(location: Loc?) -> String {
    "{if location == None -> "None" else -> "{(location ?? Loc{line: 0}).line}"}"
}

run: fn() {
    print(show(Val(Loc{line: 3})))
}
