// core.devtools does not export `toolchain_core_source`, the Core sources jet
// was built with: only the compiler's CLI (the jet_cli package) may name it,
// and any other package gets the private-item error, as for every unexported
// Core item.
use core.devtools.[toolchain_core_source]

run: fn() {
    print(toolchain_core_source("Core/App/App.jet") ?? "")
}
