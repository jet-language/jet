// Named-zone lookup must not hide environment or filesystem access.
use time: core.time

pure: fn(name: String) -[]> Zone TimeError! { time.zone(name) }
env_only: fn(name: String) -[Env]> Zone TimeError! { time.zone(name) }
read_only: fn(name: String) -[FS.Read]> ZonedDateTime TimeError! { time.parse_zoned(name) }
run: fn() {}
