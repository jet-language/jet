// D-QUAL3: mixing two members of a unit family is rejected — each member is a
// distinct `#Numeric` type, so cross-unit arithmetic is E0127 (same rule as
// any two different distinct types).
#UnitFamily(currency) { usd, eur }

fn main() {
    price @= Usd(9.99)
    other @= Eur(2.0)
    total @= price + other
}
