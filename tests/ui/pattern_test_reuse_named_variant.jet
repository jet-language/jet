enum Shape {
    Rect(w: Int, h: Int)
    Dot
}

struct Point {
    x: Int
    y: Int
}

fn parse(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

fn run() {
    w :: 3
    shape :: Shape.Rect{w: 3, h: 4}
    same :: shape == .Rect{w, ..}
    print("{same} {w}")
}
