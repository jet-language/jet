Shape: enum {
    Rect(w: Int, h: Int)
    Dot
}

Point: struct {
    x: Int
    y: Int
}

parse: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

run: fn() {
    w: 3
    shape: Shape.Rect{w: 3, h: 4}
    same: shape == .Rect{w, ..}
    print("{same} {w}")
}
