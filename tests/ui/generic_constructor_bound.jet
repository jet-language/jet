trait Named {
    fn name(self) -> String
}

struct Token {
    value: Int
}

struct Box<T: Named> {
    value: T
}

impl Box {
    fn new(value: ^T) -> Box<T> {
        return Box<T>.{ value: value }
    }
}

fn run() {
    value :: Token.{ value: 1 }
    boxed :: Box.new(^value)
    boxed_list :: Box.new([1])
}
