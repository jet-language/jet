// A larger union does not pass where a smaller one is expected: `Bool` is
// not one of `keep`'s cases.
keep: fn(cell: Int | String) -> String {
    if cell == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

wide: fn() -> Int | String | Bool { false }

run: fn() { print(keep(wide())) }
