// A tail `panic(...)` after an exhaustive `if` whose arms all return or panic
// is dead code, but it stays a diverging statement: it is not a valueless
// call used as the function's value (no E0116).
enum Op { A B(n: Int) C }

fn pick(op: Op) -> Int {
    x :: 1
    if op == {
        .A -> return x
        .B(n) -> return n
        .C -> panic("C has no value")
    }
    panic("checked op is unsupported")
}

fn run() {
    print(pick(Op.A))
}
