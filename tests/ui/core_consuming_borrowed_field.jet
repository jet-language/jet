struct Address {
    text: String
}

struct Email {
    addr: String
    nested: Address
    items: [Address]
}

fn shallow(e: Email) -> Dyn { Dyn.Text(e.addr) }

fn nested(e: Email) -> Dyn { Dyn.Text(e.nested.text) }

fn indexed(e: Email) -> Dyn { Dyn.Text(e.items[0].text) }

fn computed_index(e: Email, i: Int) -> Dyn { Dyn.Text(e.items[i + 1].text) }

fn pick() -> Int { 0 }

fn call_index(e: Email) -> Dyn { Dyn.Text(e.items[pick()].text) }

fn unary_parenthesized_index(e: Email, i: Int) -> Dyn { Dyn.Text(e.items[-(-i)].text) }

fn if_index(e: Email, choose_first: Bool) -> Dyn {
    return Dyn.Text(e.items[if choose_first -> 0 else -> 1].text)
}

fn owned_slice(xs: [Dyn]) -> Dyn { Dyn.Array(xs[0..1]) }

fn run() {

}
