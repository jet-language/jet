struct Address {
    text: String
}

struct Email {
    addr: String
    nested: Address
    items: [Address]
}

fn shallow(e: Email) -> DataTree {
    return DataTree.Text(e.addr)
}

fn nested(e: Email) -> DataTree {
    return DataTree.Text(e.nested.text)
}

fn indexed(e: Email) -> DataTree {
    return DataTree.Text(e.items[0].text)
}

fn computed_index(e: Email, i: Int) -> DataTree {
    return DataTree.Text(e.items[i + 1].text)
}

fn pick() -> Int {
    return 0
}

fn call_index(e: Email) -> DataTree {
    return DataTree.Text(e.items[pick()].text)
}

fn unary_parenthesized_index(e: Email, i: Int) -> DataTree {
    return DataTree.Text(e.items[-(-i)].text)
}

fn if_index(e: Email, choose_first: Bool) -> DataTree {
    return DataTree.Text(e.items[if choose_first { 0 } else { 1 }].text)
}

fn owned_slice(xs: [DataTree]) -> DataTree {
    return DataTree.Array(xs[0..1])
}

fn run() {

}
