Address: struct {
    text: String
}

Email: struct {
    addr: String
    nested: Address
    items: [Address]
}

shallow: fn(e: Email) -> Dyn { Dyn.Text(e.addr) }

nested: fn(e: Email) -> Dyn { Dyn.Text(e.nested.text) }

indexed: fn(e: Email) -> Dyn { Dyn.Text(e.items[0].text) }

computed_index: fn(e: Email, i: Int) -> Dyn { Dyn.Text(e.items[i + 1].text) }

pick: fn() -> Int { 0 }

call_index: fn(e: Email) -> Dyn { Dyn.Text(e.items[pick()].text) }

unary_parenthesized_index: fn(e: Email, i: Int) -> Dyn { Dyn.Text(e.items[-(-i)].text) }

if_index: fn(e: Email, choose_first: Bool) -> Dyn {
    return Dyn.Text(e.items[if choose_first -> 0 else -> 1].text)
}

owned_slice: fn(xs: [Dyn]) -> Dyn { Dyn.Array(xs[0..1]) }

run: fn() {

}
