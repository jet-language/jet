struct Address {
    text: String
}

struct Email {
    addr: String,
    nested: Address,
    items: [Address]
}

fn shallow(e: Email) -> Data {
    return Data.Text(e.addr)
}

fn nested(e: Email) -> Data {
    return Data.Text(e.nested.text)
}

fn indexed(e: Email) -> Data {
    return Data.Text(e.items[0].text)
}

fn computed_index(e: Email, i: Int) -> Data {
    return Data.Text(e.items[i + 1].text)
}

fn pick() -> Int {
    return 0
}

fn call_index(e: Email) -> Data {
    return Data.Text(e.items[pick()].text)
}

fn unary_parenthesized_index(e: Email, i: Int) -> Data {
    return Data.Text(e.items[-(-i)].text)
}

fn owned_slice(xs: [Data]) -> Data {
    return Data.Array(xs[0..1])
}

fn run() {}
