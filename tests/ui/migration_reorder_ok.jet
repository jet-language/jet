// Tests D-MIGRATE2F: reordering fields is NOT a breaking change and needs no
// migration. The .published.snapshot lists the fields in the opposite order.
#PublishedSchema
struct Account {
    age: Int
    name: String
}

fn main() {
    a #= Account.{
        age: 30
        name: "Alice"
    }
    print("{a.name}")
}
