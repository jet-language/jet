// The built-in `Path` and the `core.files.path` record `path.Path` share a
// leaf name but are different types: passing one where the other is expected
// is a type error, never a silent match by name.
use core.files.path as path

fn run() {
    builtin :: Path.from("docs")
    print(path.join(builtin, "a.txt").raw)
}
