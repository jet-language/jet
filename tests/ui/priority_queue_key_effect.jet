// A PriorityQueue key function must be pure: `loud_points` prints, so its
// `IO` effect breaks the key's empty effect bound.
Score: struct {
    name: String
    points: Int
}

loud_points: fn(s: Score) -> Int {
    print(s.name)
    s.points
}

run: fn() {
    scores := PriorityQueue.by_desc(loud_points)
    scores.push(Score{name: "Ana", points: 90})
    print(scores.len())
}
