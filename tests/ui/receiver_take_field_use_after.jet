// A taking call on a field moves that field out of its owner. The sibling
// field stays usable; reading the taken field again is E0121.
Buffer: struct { text: String }
Holder: struct { buf: Buffer, tag: String }
impl Buffer {
    seal: fn(&&self) { print(self.text) }
}
run: fn() {
    holder: Holder{buf: Buffer{text: "hello"}, tag: "kept"}
    holder.buf.seal()
    print(holder.tag)
    print(holder.buf.text)
}
