// D-S14-PAUSE / #1887's table: a keyword from another language is taught,
// not blamed on the expression grammar.
fun add(left: Int, right: Int) -> Int {
    return left + right
}

func subtract(left: Int, right: Int) -> Int {
    return left - right
}

def multiply(left: Int, right: Int): Int {
    return left * right
}

function divide(left: Int, right: Int) -> Int {
    return left / right
}

fn run() {
    var count: Int = 1
    let total = count
    const stable = total
    val alias = stable
    print(alias)
}
