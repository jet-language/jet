Shape: enum {
    Leaf(name: String)
    Fn(ret: Shape?)
}

is_unit: fn(shape: Shape) -> Bool Never! {
    if shape == {
        .Leaf(name) -> name == "Unit"
        .Fn(_) -> false
    }
}

describe: fn(shape: Shape) -> String Never! {
    if shape == {
        .Leaf(name) -> name
        .Fn(ret) -> {
            marker: if {
                ret.map(value -> !is_unit(value)) ?? false -> "fn*"
                else -> "fn"
            }
            result: ret.map(value -> " => {describe(value)}") ?? ""
            "{marker}{result}"
        }
    }
}

run: fn() {
    print(describe(Shape.Fn{ret: Val(Shape.Leaf{name: "Int"})}))
}
