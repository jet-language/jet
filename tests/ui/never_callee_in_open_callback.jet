enum Shape {
    Leaf(name: String)
    Fn(ret: Shape?)
}

fn is_unit(shape: Shape) -> Bool Never! {
    if shape == {
        .Leaf(name) -> name == "Unit"
        .Fn(_) -> false
    }
}

fn describe(shape: Shape) -> String Never! {
    if shape == {
        .Leaf(name) -> name
        .Fn(ret) -> {
            marker :: if {
                ret.map(value -> !is_unit(value)) ?? false -> "fn*"
                else -> "fn"
            }
            result :: ret.map(value -> " => {describe(value)}") ?? ""
            "{marker}{result}"
        }
    }
}

fn run() {
    print(describe(Shape.Fn{ret: Val(Shape.Leaf{name: "Int"})}))
}
