double: fn(value: Int) -> Int {
    if value < 0 -> return Err("negative")
    value * 2
}

#Export(c) twice: fn(value: Int) -> Int {
    double(value)
}

#Export(c) settle: fn(value: Int) -> Int Never! {
    double(value) ?? 0
}

#Export(c) reset: fn() Never! {
    print("reset")
}

run: fn() {
    print("{twice(4)} {settle(4)}")
    reset()
}
