// D-PATR: Int/Char range dispatch with no `else` must be rejected in sema
// (I2: rustc must never speak to users — previously ICEd with E0317).
fn grade(score: Int) -> String {
    if score == {
        0..59 -> { return "F" }
        60..100 -> { return "A" }
    }
}

fn run() {
    print(grade(75))
}
