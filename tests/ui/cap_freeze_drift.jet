// Tests E0912 (c129): a `library { api: stable }` froze `scale`'s public capability
// signature with `v` passed by read. The body now mutates `v` (field assignment),
// so D-CAP8 resolves the param to `&Vec3` (edit) — a read → `&` drift that silently
// breaks every caller. The sibling .frozen.api is the prior frozen contract.
struct Vec3 {
    x: Float
    y: Float
    z: Float
}

pub fn scale(v: Vec3, factor: Float) {
    v.x = v.x * factor
}

fn run() {
    p := Vec3.{ x: 1.0, y: 2.0, z: 3.0 }
    scale(&p, 2.0)
    print("{p.x}")
}
