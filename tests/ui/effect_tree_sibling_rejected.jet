// D-EFFTREE1: ancestor matching is subsumption, but siblings don't subsume
// each other. `read_only` declares the leaf `FS.Read`; calling something
// declared `FS.Write` is still out of bound, same as any other E0740.
load: fn(path: String) -[FS.Read]> String { "contents of {path}" }

archive: fn(path: String) -[FS.Write]> String { "archived {path}" }

read_only: fn(path: String) -[FS.Read]> {
    archive(path).drop("only the effect bound is under test")
}

run: fn() { read_only("app.conf") }
