// Tests E0910: @PublishedSchema struct drops a field without a migration.
// The sibling .published.snapshot supplies the prior snapshot (field `name: String`).
@PublishedSchema
struct UserRecord {
    display_name: String
    age: Int
}

fn main() {
    r :: UserRecord.{
        display_name: "Alice"
        age: 30
    }
    print("{r.display_name}")
}
