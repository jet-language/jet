// D-BIND-TYPE2=A: the retired `name: Type :: value` form teaches E0393 with a
// behavior-preserving `jet fix` edit to `name :: Type{value}`.
fn run() {
    limit :: U8{250}
    total := Int{0}
    evens :: [Int]{[1, 2, 3].map(n -> n * 2)}
    total += 1
    print("{limit} {total} {evens.len()}")
}
