// @check_core Builtins/Builtins.jet
// Two Core functions that fill one role (E1014).
RoleKind: enum {
    DuplicateRoleProbe
}

Role: struct {
    kind: RoleKind

    impl Marker {
        sites: [.Function]
    }
}

#Role(.DuplicateRoleProbe) duplicate_role_first: fn() -> Int { 1 }

#Role(.DuplicateRoleProbe) duplicate_role_second: fn() -> Int { 2 }
