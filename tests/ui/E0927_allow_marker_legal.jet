// E0927 (card #518): `#Allow(jet.LintName, "why")` is a legal applied rule
// — the closed rule vocabulary must
// never flag it. `#Bogus` on the second struct proves the vocabulary check
// still fires for a genuinely unregistered name: this fixture's .stderr
// must show exactly one E0927, for `#Bogus`, and nothing for `#Allow(...)`.
struct Invoice {
    #Allow(jet.FloatMoney, "the fixture deliberately accepts floating-point money") price: Float
}

#Bogus
struct Widget {
    label: String
}

fn run() {
    print("ok")
}
