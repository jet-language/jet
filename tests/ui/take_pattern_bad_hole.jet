// A `take_pattern` hole binds a bare (optionally typed) name —
// an expression is not a hole. A bare string takes any interpolation, so the
// typed `String{…}` form carries the pattern.
run: fn() {
    c: Cursor.over("inc-42 rest")
    m: c.take_pattern(String{"inc-{id + 1} "}) ?? panic("no match")
    print("{m}")
}
