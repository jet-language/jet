// Tests that `migration UserRecord { rename name -> display_name }` unblocks E0910.
// The sibling .published.snapshot supplies the prior snapshot.
#PublishedSchema
struct UserRecord {
    display_name: String
    age: Int
}

migration UserRecord {
    rename name -> display_name
}

fn main() {
    r :: UserRecord {
        display_name: "Alice"
        age: 30
    }
    print("{r.display_name}")
}
