// E0113 (D-DISCARD1=A owner ruling): when a return type is written, a
// mismatched last line is taught as a fault in the value (its type or
// shape), with the conversion or wrap to use. It never suggests changing the
// declared return type.
average: fn(a: Int, b: Int) -> Int {
    (a + b) / 2
}

names: fn() -> [String] {
    "ana"
}

label: fn(n: Int) -> String {
    n
}

first: fn() -> Int {
    [1, 2]
}

run: fn() {
    print(average(4, 6))
    print(names())
    print(label(3))
    print(first())
}
