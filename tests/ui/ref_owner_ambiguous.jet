// E0207: two in-scope `String` values, so Jet can't infer which one each
// `&String` field borrows — the owner must be named with `#Ref(label)`.
struct Pair {
    left: &String
    right: &String
}
fn build(a: String, b: String) {
    p: Pair :: Pair.{ left: a, right: b }
    print(p.left)
}
fn main() {
    build("x", "y")
}
