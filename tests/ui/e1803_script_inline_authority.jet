// @run_cli
// A single-file program with no `package.jet` needs FS beyond the beginner
// default. E1803 names the complete inline row, and `jet fix --all` inserts
// the leading `package { … }` block that grants it.
use core.files as files

fn run() {
    files.write("e1803-script-must-not-exist.txt", "never") ?? panic("write failed")
    print("wrote")
}
