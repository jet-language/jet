// `Packet<4>` and `Packet<2>` are two instances: a field of the instance
// takes that instance's length, and one instance is never the other.
Packet: struct<comptime N: Int> {
    data: [Int#N]
}

pair_length: fn(packet: Packet<2>) -> Int { packet.data.len() }

short_packet: fn() {
    short: Packet<4>{data: [Int#2]{1, 2}}
    print("{short.data.len()}")
}

run: fn() {
    four: Packet<4>{data: [Int#4]{1, 2, 3, 4}}
    print("{pair_length(four)}")
}
