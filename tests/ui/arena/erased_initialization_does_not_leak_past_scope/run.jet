
use core.mem

erased_off: fn() {
    value := Int{ uninit }
    #Off {
        value = 7
    }
    print(value)
}

erased_debug: fn() {
    value := Int{ uninit }
    #DebugOnly {
        value = 8
    }
    print(value)
}

active_initialization: fn() {
    value := Int{ uninit }
    value = 9
    print(value)
}


run: fn() {
    erased_off()
    erased_debug()
    active_initialization()
}
