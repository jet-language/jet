
use core.mem

fn erased_off() {
    value := Int{ uninit }
    #Off {
        value = 7
    }
    print(value)
}

fn erased_debug() {
    value := Int{ uninit }
    #DebugOnly {
        value = 8
    }
    print(value)
}

fn active_initialization() {
    value := Int{ uninit }
    value = 9
    print(value)
}


fn run() {
    erased_off()
    erased_debug()
    active_initialization()
}
