// A form that hands on its operand's value (`x ?? fallback`, an `if` or match
// arm tail, a block tail, parentheses) reads a place it does not own the same
// way a bare place read does: a resource it would copy out of a borrowed
// holder or parameter into an owned position is refused, so the holder stays
// its one owner. A loop name over a list of resources read in place (no `^`
// drive) is such a place read too, whoever owns the list.
Res: struct { name: String }
impl Res.Close {
    close: fn(^self) { print("close {self.name}") }
}

Holder: struct {
    first: Res?
    second: Res?
}

or_field: fn(h: Holder) -> Int {
    r: h.first ?? return 0
    r.name.len()
}

or_param: fn(env: Res?) -> Int {
    r: env ?? return 0
    r.name.len()
}

or_fallback_value: fn(h: Holder) -> Int {
    r: h.first ?? h.second ?? return 0
    r.name.len()
}

or_fallback_block: fn(h: Holder) -> Int {
    r: h.first ?? {
        print("fallback")
        h.second ?? return 0
    }
    r.name.len()
}

paren: fn(h: Holder) -> Int {
    r: (h.first ?? return 0)
    r.name.len()
}

if_arms: fn(flag: Bool, left: Res, right: Res) -> Int {
    r: if flag -> left else -> right
    r.name.len()
}

match_arm: fn(h: Holder) -> Int {
    r: if h.first == {
        .Val(found) -> found
        .None -> panic("none")
    }
    r.name.len()
}

assign_or: fn(h: Holder) -> Int {
    out := Holder{first: None, second: None}
    out.first = Val(h.first ?? return 0)
    0
}

return_or: fn(h: Holder) -> Res? {
    Val(h.first ?? return None)
}

keep: fn(r: ^Res) -> Int { r.name.len() }

loop_push: fn() -> Int {
    list: [Res{name: "push"}]
    out := [Res]{}
    loop item in list {
        &out.push(item)
    }
    out.len()
}

loop_collect: fn() -> Int {
    list: [Res{name: "collect"}]
    out: loop item in list -> item
    out.len()
}

loop_take: fn() -> Int {
    list: [Res{name: "take"}]
    total := 0
    loop item in list {
        total = total + keep(^item)
    }
    total
}

loop_drive_moves: fn() -> Int {
    list: [Res{name: "drive"}]
    out := [Res]{}
    loop item in ^list {
        &out.push(item)
    }
    out.len()
}

run: fn() {
    print("unreached")
}
