marker Checked(@sites: [.Block]) {
    if !target.contains("required phrase") {
        reject(
            code: "E0927",
            what: "checked text is missing the required phrase",
            why: "this block language requires its greeting",
            fix: "add `required phrase` to the block"
        )
    }
}

fn run() {
    #Checked {
        print("wrong text")
    }
}
