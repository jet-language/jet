MissingPhrase: struct {
    impl Diagnostic {
        code: "E0927"
        what: fn(self) -> String { "checked text is missing the required phrase" }
        why: fn(self) -> String { "this block language requires its greeting" }
        fix: fn(self) -> String { "add `required phrase` to the block" }
    }
}

Checked: struct {
    impl Marker {
        sites: [.Block]

        expand: fn(self, target: Target) {
            if !target.contains("required phrase") {
                reject(MissingPhrase{})
            }
        }
    }
}

run: fn() {
    #Checked {
        print("wrong text")
    }
}
