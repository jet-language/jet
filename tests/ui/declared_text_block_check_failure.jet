struct MissingPhrase {
    impl Diagnostic {
        code :: "E0927"
        fn what(self) -> String { "checked text is missing the required phrase" }
        fn why(self) -> String { "this block language requires its greeting" }
        fn fix(self) -> String { "add `required phrase` to the block" }
    }
}

struct Checked {
    impl Marker {
        sites :: [.Block]

        fn expand(self, target: Target) {
            if !target.contains("required phrase") {
                reject(MissingPhrase{})
            }
        }
    }
}

fn run() {
    #Checked {
        print("wrong text")
    }
}
