// @all_diags
// card #131 S1-bridge (D-SERDE2): a hand `impl T.Encode` / `impl T.Decode` whose
// signature does not match the codec's fixed shape is E0907, caught in sema before
// codegen bridges the verb to `jet_encode` / `jet_decode` — so a sema-accepted
// program never reaches rustc as broken Rust (I2/I4).
Email: struct {
    addr: String

    // `encode` must return `Dyn`, not `String`.
    impl Encode {
        encode: fn(self) -> String { self.addr.copy() }
    }

    // `decode` is static — a `self` receiver is not part of its shape.
    impl Decode {
        decode: fn(self, tree: Dyn) -> Email [FieldError]! { return Ok(Email{addr: "x"}) }
    }
}

run: fn() { print("ok") }
