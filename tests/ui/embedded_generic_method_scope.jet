// Embedded generic method scope, including the source RNG signature shapes.
GenericPicker: struct {
    pick: fn<T>(&self, items: [T]) -> T? Never! {
        if items.len() == 0 -> return None
        Val(items[0].copy())
    }
    weighted_pick: fn<T>(&self, items: [T], weights: [Float]) -> T? Never! {
        if weights.len() != items.len() -> return None
        &self.pick(items)
    }
    sample: fn<T>(&self, items: [T], count: Int) -> [T] Never! {
        if count <= 0 -> return [T]{}
        items.copy()
    }
    shuffle: fn<T>(&self, items: &[T]) Never! {
        print(items.len())
    }
}
GenericOwner: struct<T> {
    preserve: fn<U>(self, owner_value: T, method_value: U) -> (owner_value: T, method_value: U) Never! {
        (owner_value: owner_value.copy(), method_value: method_value.copy())
    }
    shadow: fn<T>(self, method_value: T) -> T Never! {
        method_value.copy()
    }
}
run: fn() {
    picker := GenericPicker{}
    print((&picker.pick([1, 2])) ?? 0)
    print((&picker.weighted_pick([1, 2], [1.0, 2.0])) ?? 0)
    print(&picker.sample([1, 2], 2))
    values := [1, 2]
    &picker.shuffle(&values)
    print(values)
}
