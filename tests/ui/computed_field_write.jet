Inner: struct {
    items: [Int]
    first: Int -> items[0]
    listed: [Int] -> items.copy()
}

Outer: struct {
    inner: Inner
    label: String
    title: String -> label
}

edit: fn(text: &String) {
    text += "!"
}

bump: fn(value: &Int) {
    value += 1
}

consume: fn(text: &&String) -> Int {
    text.len()
}

run: fn() {
    outer := Outer{inner: Inner{items: [Int]{1, 2}}, label: "a"}
    outer.title = "b"
    outer.title += "c"
    outer.inner.first = 3
    outer.inner.listed[0] = 4
    edit(outer.title)
    bump(outer.inner.first)
    outer.inner.listed.push(5)
    taken: outer.title.move()
    print("{consume(outer.title)} {taken}")
}
