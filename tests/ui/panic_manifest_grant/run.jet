// D-PANICROOT1=A: a manifest that grants Panic is one E0751 at its allow
// entry, not one per function of the package.
port: fn(text: String) -> Int {
    if text == "" -> panic("empty port")
    8080
}

label: fn(value: Int) -> String {
    "port {value}"
}

run: fn() {
    print(label(port("8080")))
}
