Vec2: struct {
    x: Int
    y: Int

    impl Add {
        add: fn(self, rhs: Vec2) -> Vec2 { return Vec2{x: self.x + rhs.x, y: self.y + rhs.y} }
    }

    impl Equatable {
        equal: fn(self, rhs: Vec2) -> Bool { self.x == rhs.x && self.y == rhs.y }
    }

    impl Comparable {
        compare: fn(self, rhs: Vec2) -> Ordering {
            if self.x < rhs.x -> return Ordering.Less
            if self.x > rhs.x -> return Ordering.Greater
            return Ordering.Equal
        }
    }
}

run: fn() {
    a: Vec2{x: 1, y: 2}
    b: Vec2{x: 3, y: 4}
    print(a + b)
    print(a == b)
    print(a < b)
}
