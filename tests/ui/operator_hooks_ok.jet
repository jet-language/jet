struct Vec2 { x: Int y: Int }

impl Vec2.Add { fn add(self, rhs: Vec2) -> Vec2 { return Vec2.{ x: self.x + rhs.x, y: self.y + rhs.y } } }
impl Vec2.Equatable { fn equal(self, rhs: Vec2) -> Bool { return self.x == rhs.x && self.y == rhs.y } }
impl Vec2.Comparable {
    fn compare(self, rhs: Vec2) -> Ordering {
        if self.x < rhs.x { return Ordering.Less }
        if self.x > rhs.x { return Ordering.Greater }
        return Ordering.Equal
    }
}

fn run() {
    a :: Vec2.{ x: 1, y: 2 }
    b :: Vec2.{ x: 3, y: 4 }
    print(a + b)
    print(a == b)
    print(a < b)
}
