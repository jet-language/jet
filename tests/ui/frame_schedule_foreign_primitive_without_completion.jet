use c: c.demo
use game: core.game

#Import c.demo: module {
    scale: fn(x: I32) -> I32 = "demo_scale"
}

run: fn() {
    scene := game.Scene.new("frame-scale")
    scene.on_frame(fn(frame) {
        level := I32{3}
        print(c.scale(level))
    })
    game.run(scene).drop("only the schedule refusal is under test")
}
