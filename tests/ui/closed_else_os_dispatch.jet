// E0641 in a `#build.target.os` dispatch: `OS` is a closed set, so an `else`
// stands for the OSes no arm names, whatever the build targets. The first
// dispatch's `else` stands for `.Windows` and the three OS-less targets; the
// second already names every OS, one of its arms with an or-pattern, so its
// `else` can never run.
native: fn() {
    #if #build.target.os == {
        .Linux -> print("linux")
        .MacOS -> print("macos")
        else -> print("other")
    }
}

run: fn() {
    native()
    #if #build.target.os == {
        .Linux | .MacOS | .Windows -> print("native")
        .Web -> print("web")
        .Wasm | .Freestanding -> print("bare")
        else -> print("unreachable")
    }
}
