use mem: core.mem

initialize: fn() -> Shared<Int> Never! { shared 0 }

run: fn() {
    mem.__process_shared(initialize).drop("reserved Core seam")
    mem.__world_shared(initialize).drop("reserved Core seam")
    mem.__thread_shared(initialize).drop("reserved Core seam")
    mem.__attempt_shared(initialize).drop("reserved Core seam")
}
