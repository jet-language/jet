// C25/E0318: `..=` in an arm head is a porting hazard from Rust.
// Jet's `..` is inclusive — `0..=9` should be written `0..9`.
fn classify(score: Int) -> String {
    if score == {
        0..=59 -> { return "fail" }
        60..=100 -> { return "pass" }
        else -> { return "?" }
    }
}

fn run() {
    print(classify(75))
}
