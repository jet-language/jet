// @programmable_build
// @cli_build
// A type error in the module `b.generate("facts")` makes is reported
// against that module's virtual path and generated text, with the
// `b.generate` call as its note.
build: fn(b: Build) {
    b.generate("facts") {
        tooling_facts: fn() -> Int { "x" }
    }
    app: b.add_executable("app", ["run.jet", ".jet/generated/run/facts.jet"], [])
    b.default(app)
}
run: fn() {
    print("{tooling_facts()}")
}
