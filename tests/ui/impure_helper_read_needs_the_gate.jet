use files: core.files

// The helper the running program calls reads a file. A `#run`
// value inside `#Impure` that calls it reads the file natively only under
// `--gate impure=allow`; without the gate the read is refused where the
// value calls the helper.
greeting: fn(path: String) -[FS.Read]> String {
    text: files.read(path) ?? return "can't read {path}: {err}"
    text.trim()
}

run: fn() {
    #Impure("read the greeting while building") {
        // The reported call keeps a line of its own.
        text: #run {
            greeting("greeting.txt")
        }
        print(text)
    }
    print(greeting("greeting.txt"))
}
