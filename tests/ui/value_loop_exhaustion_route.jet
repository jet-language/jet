fn missing() => Int {
    found :: loop value, [1, 2] {
        if value == 2 { break value }
    }
    found
}

fn next_after() => Int {
    found :: loop value, [1, 2] {
        if value == 2 { break value }
    } ?? next
    found
}

fn break_after() => Int {
    found :: loop value, [1, 2] {
        if value == 2 { break value }
    } ?? break
    found
}

fn run() {}
