// E0307: a value dispatch over a call (not a name) must still prove coverage.
// The call is the table's one subject, so its arms join the coverage proof
// exactly as arms over a local do.
Light: enum {
    Red
    Green
    Yellow
}

pick: fn(n: Int) -> Light {
    if n == 0 -> return Light.Red
    Light.Green
}

describe: fn(n: Int) -> String {
    if pick(n) == {
        .Red -> "stop"
        .Green -> "go"
    }
}

run: fn() { print(describe(1)) }
