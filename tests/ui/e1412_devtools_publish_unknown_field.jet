// E1412: a devtools publication names a field of the panel's state.
use {
    ui :: core.ui
    devtools :: core.devtools
}

struct State {
    selected: String{"none"}
}

#DevPanel
fn panel(state: State) -> UINode {
    return ui.text(state.selected)
}

fn run() {
    devtools.publish(field: .chosen, value: "overview")
}
