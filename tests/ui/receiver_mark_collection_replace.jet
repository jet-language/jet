// #4009: `Map.replace` and `Set.replace` write the collection, so the named
// receiver needs the `&` mark like every other mutating method.
fn run() {
    scores := ["ada": 3]
    old :: scores.replace("ada", 9)
    seen := Set.from([1, 2])
    displaced :: seen.replace(2)
    print(old ?? 0)
    print(displaced ?? 0)
}
