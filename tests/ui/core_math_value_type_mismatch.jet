use core.math as math

fn run() {
    math.checked_add("one", 2).drop("type-mismatch diagnostic fixture")
    math.abs("one")
    math.min((n: Int) => n, (n: Int) => n)
    math.min(1, "two")
    math.clamp(1, 0.0, 2)
    math.round("one")
    math.to_bits("one")
    math.from_bits("one")
    math.decimal(1)
}
