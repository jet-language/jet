// Dividing by an args-derived value traps at runtime with the Prelude
// wording — never E0953 "your comptime code stopped the build".
// Argv is read at run time (I9 with AOT); missing arg falls through to 0.
use process: core.process

run: fn() {
    raw: process.args().get(0) ?? "0"
    n: 10 /% (Int.parse(raw) ?? 0)
    print(n)
}
// @run_cli
