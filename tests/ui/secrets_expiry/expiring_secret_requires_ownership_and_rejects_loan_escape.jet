
use {
    crypto: core.crypto
    time: core.time
    vault: core.crypto.vault
}

seal: fn(key: crypto.SigningKey) {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    _ := vault.ExpiringSecret.new(key, ttl, clock)
}

run: fn() {
    key := crypto.SigningKey.new_random() ?? panic("key")
    seal(key)
}
