
use {
    crypto :: core.crypto
    time :: core.time
    vault :: core.crypto.vault
}

fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> () -> borrowed.public_key())
}
