// A query is a function whose effects stay inside `DB.Read`, the row a live
// query re-runs. One that writes, here through a helper it calls, is refused
// at its row.
use db: core.db

mark_seen: fn(tasks: DBScope) { _rows: tasks.execute(SQL{"UPDATE task SET seen = 1"}) ?? 0 }

open_count: fn(tasks: DBScope) -[DB.Read]> Int {
    mark_seen(tasks)
    rows: tasks.query(SQL{"SELECT id FROM task WHERE done = 0"}) ?? return 0
    rows.len()
}

run: fn() {
    policy: db.policy("task", "true") ?? panic("policy")
    print(open_count(db.open_memory().with_policy(policy, "owner")))
}
