// E0313: the rename fix fills in the names the user wrote, in order, and never
// binds one name twice.
pair: fn() -> (part0: Int, part1: Int) { (part0: 7, part1: -9) }

run: fn() {
    (left, right): pair()
    print("{left} {right}")
    { _0: first, _1: second }: pair()
    print("{first} {second}")
    { _0: value, _1: value }: pair()
    print("{value}")
}
