struct Point {
    x: Float
    y: Float
}

impl Point {
    fn cartesian(x: Float, y: Float) => Point {
        return Point.{x: x, y: y}
    }

    fn polar(r: Float, theta: Float) => Point {
        return Point.{x: r, y: theta}
    }

    // duplicate constructor name — E0105 with constructor teaching text
    fn cartesian(a: Float, b: Float) => Point {
        return Point.{x: a, y: b}
    }
}

fn run() {
    p :: Point.cartesian(1.0, 2.0)
    q :: Point.polar(1.0, 0.5)
    _ :: (p.x + q.y)
}
