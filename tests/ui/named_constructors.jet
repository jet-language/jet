Point: struct {
    x: Float
    y: Float
}

impl Point {
    cartesian: fn(x: Float, y: Float) -> Point { return Point{x: x, y: y} }

    polar: fn(r: Float, theta: Float) -> Point { return Point{x: r, y: theta} }

    // duplicate constructor name — E0105 with constructor teaching text
    cartesian: fn(a: Float, b: Float) -> Point { return Point{x: a, y: b} }
}

run: fn() {
    p: Point.cartesian(1.0, 2.0)
    q: Point.polar(1.0, 0.5)
    _: (p.x + q.y)
}
