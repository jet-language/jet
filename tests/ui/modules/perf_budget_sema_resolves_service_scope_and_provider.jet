env.dev: module {
    services: { api: { enable: true } }
}
perf.release: module {
    budgets: [Budget{
        name: "ready",
        scope: .Service("api"),
        metric: .ServiceReadiness,
        provider: .ServiceProbe("api"),
        comparison: .AbsoluteFrom("ci/linux-x64"),
        limit: .AtMost(2s),
        enforcement: .Warn,
    }]
}
