env.dev: module { services: { api: { enable: true } } }
perf.release: module {
    budgets: [Budget{
        name: "hostile",
        scope: .Service("api"),
        metric: .Throughput,
        provider: .ServiceProbe("api"),
        comparison: .RelativeTo("ci/linux-x64"),
        limit: .ImprovementAtLeast{ value: 3pct },
        enforcement: .Fail,
    }]
}
