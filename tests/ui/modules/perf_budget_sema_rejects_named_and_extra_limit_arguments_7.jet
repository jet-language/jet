module env.dev { services: { api: { enable: true } } }
module perf.release {
    budgets: [Budget{
        name: "hostile",
        scope: .Service("api"),
        metric: .Throughput,
        provider: .ServiceProbe("api"),
        comparison: .AbsoluteFrom("ci/linux-x64"),
        limit: .AtLeast{ value: Rate{ count: 100, per: 1s } },
        enforcement: .Fail,
    }]
}
