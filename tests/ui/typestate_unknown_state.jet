// D-STATE-HOME1=A: a `#State(X)` or `#State(A -> B)` marker that references a
// state name not declared in the owning `state { … }` section is E0151. Here
// `#State(Stuffed)` on `Crate::get` references `Stuffed`, but the section only
// declares `Full` and `Empty`. Close enough to `Full` to get a typo suggestion.
Crate: struct {
    state { Full, Empty }
    data: Int

    #State(_ -> Full) fill: fn(data: Int) -> Crate { return Crate{data: data} }

    #State(Stuffed) get: fn(self) -> Int { return self.data }
}

run: fn() {
    b := Crate.fill(42)
    print(b.get())
}
