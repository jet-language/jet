// D-STATE-DECL: a `#State(X)` or `#Transition(A, B)` marker that references a
// state name not declared in `state TypeName { … }` is E0151. Here `#State(Stuffed)`
// on `Crate::get` references `Stuffed`, but the `state Crate` block only declares
// `Full` and `Empty`. Close enough to `Full` to get a typo suggestion.
state Crate { Full, Empty }

struct Crate {
    data: Int
}

impl Crate {
    #Transition(_, Full) fn fill(data: Int) -> Crate {
        return Crate.{data: data}
    }

    #State(Stuffed) fn get(self) -> Int {
        return self.data
    }
}

fn run() {
    b := Crate.fill(42)
    print(b.get())
}
