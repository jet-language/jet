// D-STATE-HOME1=A: a state type that names a state not declared in its
// owner's `state { … }` list is E0151. Here `Crate.Stuffed` on `Crate.get`
// names `Stuffed`, but the list only declares `Full` and `Empty`.
Crate: struct {
    state { Full, Empty }
    data: Int

    fill: fn(data: Int) -> Crate.Full { return Crate{data: data} }

    get: fn(self: Crate.Stuffed) -> Int { return self.data }
}

run: fn() {
    b := Crate.fill(42)
    print(b.get())
}
