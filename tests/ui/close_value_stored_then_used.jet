// A value that holds a Close type cannot be copied, so storing it in a
// struct, a variant or a List moves it: a later use is E0121, and storing a
// read parameter is a move out of borrowed storage (E0201).
Res: struct { id: Int }

impl Res.Close {
    close: fn(^self) { print("close {self.id}") }
}

Holder: struct { item: Res }

Group: struct { items: [Res] }

Slot: enum {
    Full(Res)
    Empty
}

in_struct: fn() {
    a: Res{id: 1}
    h: Holder{item: a}
    print(a.id)
    print(h.item.id)
}

list_in_struct: fn() {
    a: [Res]{Res{id: 1}, Res{id: 2}}
    g: Group{items: a}
    print(a.len())
    print(g.items.len())
}

in_variant: fn() {
    a: Res{id: 1}
    s: Slot.Full(a)
    print(a.id)
    if s == .Full(inner) -> print(inner.id)
}

in_list: fn() {
    a: Res{id: 1}
    out := [Res]{}
    &out.push(a)
    print(a.id)
    print(out.len())
}

from_parameter: fn(r: Res) -> Holder {
    Holder{item: r}
}

run: fn() {

}
