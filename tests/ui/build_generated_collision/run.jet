// @programmable_build
// @cli_build
// E3510: `.jet/generated/run/collision.jet` is a hand-written module (the
// staged `state/` tree), so `b.generate("collision")` would shadow it.
build: fn(b: Build) {
    b.generate("collision") {
        collision: fn() -> String { "generated" }
    }
    app: b.add_executable("app", ["run.jet"], [])
    b.default(app)
}

run: fn() { print("hand written") }
