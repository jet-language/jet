// @programmable_build
use "./.jet/generated/main/collision" as handwritten

fn build(b: Build) {
    b.generate("collision") {
        fn collision() -> String { "generated" }
    }?
    app :: b.add_executable("app", ["main.jet", ".jet/generated/main/collision.jet"], [])?
    b.default(app)
}

fn run() { print(handwritten.collision()) }
