// @programmable_build
// @cli_build
use handwritten: "./.jet/generated/main/collision"

build: fn(b: Build) {
    b.generate("collision") {
        collision: fn() -> String { "generated" }
    }
    app: b.add_executable("app", ["run.jet"], [])
    b.default(app)
}

run: fn() { print(handwritten.collision()) }
