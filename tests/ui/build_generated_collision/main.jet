// @programmable_build
use "./.jet/generated/main/collision" as handwritten

fn build(b: BuildContext) => BuildPlan ? {
    b.generate("collision", "pub fn collision() => String { return \"generated\" }")?
    app :: b.add_executable(
        "app",
        ["main.jet", ".jet/generated/main/collision.jet"],
        []
    )?
    return b.plan(app)
}

fn run() { print(handwritten.collision()) }
