// @programmable_build
fn build(b: BuildContext) #(Exec) -> BuildPlan ? {
    #Impure("exercise denied action") {
    action :: b.action("stamp", [], ["stamp"], ["sh", "-c", "printf ok > stamp"], ["Exec"])?
    app :: b.add_executable("app", ["build_action_ungranted.jet"], [action])?
    return b.plan(app)
    }
    return b.plan()
}
fn run() {}
