// @programmable_build
// @cli_build
build: fn(b: Build) -[Exec]> {
    #Impure("exercise denied action") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("stamp", b.found(shell), ["Exec"])
        action.arg("-c")
        action.arg("printf ok > stamp")
        action.writes("stamp")
        app: b.add_executable("app", ["build_action_ungranted.jet"], [action])
        b.default(app)
    }
}

run: fn() {

}
