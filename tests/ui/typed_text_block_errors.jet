// A typed SQL or HTML block reports an unknown owner, an unknown row
// type, a hole value the head can't carry, and a head type mismatch at the
// exact span.
User: struct {
    id: Int
}

render: fn(page: HTML) -> String { page.text() }

run: fn() {
    #SQL(Missing) {
        print(SQL{"select id from users"}.template())
    }
    #Sql(User) {
        print("lower-case owner")
    }
    #CSS {
        print("no CSS owner")
    }
    user: User{id: 1}
    query: SQL{"select id from users where id = {user}"}
    print(query.template())
    page: HTML{"<p>{user}</p>"}
    print(page.text())
    print(render(SQL{"select 1"}))
}
