// @all_diags
// A local nominal named Secret keeps ordinary struct behavior at every crypto
// restriction site: print, Debug, comparison, reflection, and methods. `#!Codable`
// keeps the serialization site honest under D-AUTODERIVE1=E: the refusal is the
// type's own, so E0905 still reports the missing `Encode` contract.
use core.reflect as reflect

#!Codable
struct Secret {
    token: String
}

fn run() {
    left :: Secret.{token: "left"}
    right :: Secret.{token: "right"}
    print(left)
    print("{left:Debug}")
    print(left == right)
    reflected :: reflect.of(left)
    encoded :: left.encode()
    cloned :: left.clone()
    hashed :: left.hash()
}
