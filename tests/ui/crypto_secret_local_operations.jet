// @all_diags
// A local nominal named Secret keeps ordinary struct behavior at every crypto
// restriction site: print, Debug, comparison, reflection, serialization, and methods.
use core.reflect as reflect

struct Secret {
    token: String
}

fn run() {
    left :: Secret.{ token: "left" }
    right :: Secret.{ token: "right" }
    print(left)
    print("{left@Debug}")
    print(left == right)
    reflected :: reflect.of(left)
    encoded :: left.encode()
    cloned :: left.clone()
    hashed :: left.hash()
}
