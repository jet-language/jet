// @programmable_build
// @cli_build
// A `Compiler` value adds code; nothing registers a call-site expansion.
build: fn(b: Build) {
    app: b.add_executable("app", ["code_value_has_no_register_expansion.jet"], [])
    meta: b.compiler(app)
    meta.register_expansion("greet", #code {
        greeting: fn() -> String { "hi" }
    })
    b.default(app)
}

run: fn() { print(1) }
