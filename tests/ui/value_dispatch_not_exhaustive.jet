// E0307 (card #1440): an else-less all-pattern value dispatch must cover the
// subject's whole enum; a missing variant is a sema error, not a parse error.
Direction: enum {
    North
    South
    East
    West
}

label: fn(d: Direction) -> String {
    return if d == {
        .North -> "north"
        .South -> "south"
        .East -> "east"
    }
}

run: fn() { print(label(Direction.North)) }
