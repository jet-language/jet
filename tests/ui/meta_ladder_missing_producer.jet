// @programmable_build
// @cli_build
// A target that lists a `.jet/generated/` file nothing in the build makes
// fails at the call that declared the target (E3515).
build: fn(b: Build) {
    app: b.add_executable("app", ["meta_ladder_missing_producer.jet", ".jet/generated/meta_ladder_missing_producer/count.jet"], [])
    b.default(app)
}

run: fn() {}
