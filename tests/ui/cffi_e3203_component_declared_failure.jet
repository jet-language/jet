#Error
ParseError: enum {
    Negative
    Empty
}

#Export(c) checked: fn(value: Int) -> Int ParseError! {
    if value < 0 -> return Err(ParseError.Negative)
    value
}

#Export(c) lookup: fn(key: Int) -> Int? {
    if key == 0 -> return None
    key
}

#Export(c) total: fn(items: [Int]) -> Int ParseError! {
    if items.len() == 0 -> return Err(ParseError.Empty)
    items.len()
}

#Export(c) count: fn(items: [Int]) -> Int {
    items.len()
}

run: fn() {
    print("{checked(1) ?? 0} {lookup(1) ?? 0} {total([Int]{1}) ?? 0} {count([Int]{1})}")
}
