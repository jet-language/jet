// E1404: a devtools publication names its field and value with labels.
use {
    ui :: core.ui
    devtools :: core.devtools
}

struct State {
    selected: String{"none"}
}

#DevPanel
fn panel(state: State) -> UINode {
    return ui.text(state.selected)
}

fn run() {
    devtools.publish(.selected, "overview")
}
