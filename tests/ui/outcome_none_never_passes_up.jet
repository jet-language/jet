// A failure passes up by itself, but a missing value
// never does. `user` stays `User?`, so reading its field is E0310, which
// teaches `?.`, `??`, or a `.Val`/`.None` pattern instead of an early return.
User: struct {
    name: String
}

#Error
DBError: enum {
    Down
}

read_user: fn(id: Int) -> User? DBError! {
    if id == 0 -> return Err(DBError.Down)
    if id == 7 -> return Ok(Val(User{name: "priya"}))
    Ok(None)
}

greet: fn(id: Int) -> String? DBError! {
    user: read_user(id)
    Ok(Val(user.name))
}

run: fn() {
    print(greet(7) ?? "stranger")
}
