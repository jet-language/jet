struct bad_type {
    BadField: Int
}

fn BadFunction(BadParam: Int) {
    BadLocal :: BadParam
}

const MAX_RETRIES = 3

trait Token {}
module holder<bad_type: Token, BadCount: Int> {}

struct Incident { severity: Int }

fn nested_names(value: Int?, incident: Incident) {
    callback :: (BadLambda: Int) => BadLambda
    Incident.{severity: BadRename} :: incident
    matched :: value == Val(BadBind)
    text :: "item-1"
    if text == {
        "item-{BadText:Int}" -> {}
        else -> {}
    }
    bytes: [U8] :: [1]
    if bytes == {
        b"{BadBits:U8}" -> {}
        else -> {}
    }
}

fn run() {}
