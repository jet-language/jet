// E2421: a public fallible function must expose every named failure-carrier
// member through a public declaration.
#Error
struct PublicFailure {
    priv detail: String
}

fn load() -> String PublicFailure! {
    return Err(PublicFailure{detail: "missing"})
}

priv module internal {
    #Error
    enum PrivateFailure { Missing }
}

fn private_load() -> String internal.PrivateFailure! {
    return Err(internal.PrivateFailure.Missing)
}

fn run() {
}
