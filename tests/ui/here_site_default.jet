// D-SITE-CALLER1=A: `#here` is the place where it is written, so a `#here`
// parameter default would name the declaration for every call. The place of
// each call is the `#caller` default.
log: fn(message: String, at: SourceLocation{#here}) {
    print("{at}: {message}")
}

run: fn() {
    log("started")
}
