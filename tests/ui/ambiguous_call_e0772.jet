// Two traits each give `Store` a default `put` of the same shape, so a
// positional call cannot choose one body.
Named: trait {
    put: fn(self, name: String, text: String) -> String { "{name}: {text}" }
}

Keyed: trait {
    put: fn(self, key: String, id: String) -> String { "{key} = {id}" }
}

Store: struct {
    impl Named {}
    impl Keyed {}
}

run: fn() {
    store: Store{}
    print(store.put("name", "text"))
}
