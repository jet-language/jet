// `pad` is a `priv` item of module `text`, so only `text` and
// its children call it; the file around `text` gets E0605.
text: module {
    priv pad: fn(s: String) -> String { "  {s}" }

    banner: fn(s: String) -> String { pad(s) }
}

run: fn() {
    print(text.banner("hi"))
    print(text.pad("hi"))
}
