Lock: struct {
    name: String
}

impl Lock.Close {
    close: fn(^self) { print("release {self.name}") }
}

Session: struct {
    lock: Lock
    user: String
}

hand_off: fn(s: ^Session) { print(s.user) }

sink: fn<T>(x: ^T) { print("sunk") }

forward: fn<T>(x: ^T) {
    sink(x)
}

consume: fn(s: ^String) -> String { s }

run: fn() {
    held: Session{lock: Lock{name: "db"}, user: "ada"}
    hand_off(held)
    forward("v")
    t: "vault"
    f: () -> print(consume(t))
    f()
}
