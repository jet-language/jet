// D-PREP-SURFACE2=A: a `prep { … }` block used as a value is ratified, but
// the build-time value fold is not implemented yet, so the parser rejects it
// with E0391 instead of silently accepting it.
fn calculate_lanes() -> Int { 8 }

fn run() {
    lanes :: prep { calculate_lanes() + 0 }
    print(lanes)
}
