// `Map` with angle-bracket type arguments is no Jet spelling (D-LISTMAP-CANON1=A: a map type is written
// `[K: V]`). Jet teaches no foreign spelling, so `Map` is an unknown type
// like any other undeclared name: E0119, nothing Map-specific.
run: fn() {
    counts := Map<String, Int>{}
    print(counts.len())
    named := Map<String, [Int]>{a: [Int]{1}}
    print(named.len())
}
