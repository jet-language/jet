// E0109: an open value loop `(loop { … break value })` is evaluated in place,
// so its value has the break payload's own type, not a function carrier.
// `!` and `==` accept the Bool it produces; negating it with `-` is the one
// error here, and it names the plain Bool type.
is_live: fn(limit: Int) -> Bool {
    live := (loop {
        result: limit > 0
        break result
    })
    if !live -> return false
    live == true
}

negated: fn(limit: Int) -> Int {
    live := (loop {
        break limit > 0
    })
    negative: -live
    negative
}

run: fn() {
    print(is_live(2))
    print(negated(2))
}
