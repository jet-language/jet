// E0641: an `else` over a closed enum is an error in a value table. The `else`
// in `name` stands for `.Blue` and `.Custom(_)`, which its edit writes in its
// place; the one in `full` can never run, and its edit deletes it. `size`
// matches an open set and keeps its `else`.
Color: enum {
    Red
    Green
    Blue
    Custom(Int)
}

name: fn(c: Color) -> String {
    if c == {
        .Red -> "red"
        .Green -> "green"
        else -> "other"
    }
}

full: fn(c: Color) -> String {
    if c == {
        .Red -> "red"
        .Green -> "green"
        .Blue -> "blue"
        .Custom(_) -> "custom"
        else -> "unknown"
    }
}

size: fn(n: Int) -> String {
    if n == {
        0..9 -> "small"
        else -> "large"
    }
}

run: fn() {
    print(name(Color.Blue))
    print(full(Color.Red))
    print(size(4))
}
