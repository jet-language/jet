// assert_eq compares map types by declaration identity: two maps written
// with the same key and value types check clean wherever they were written,
// and only maps of different types get the mismatch (#6124).
run: fn() {
    first: [String: Int]{"x": 1, "y": 2}
    second: [String: Int]{"y": 2, "x": 1}
    assert_eq(first, second)
    labels: [String: String]{"x": "one"}
    assert_eq(first, labels)
}
