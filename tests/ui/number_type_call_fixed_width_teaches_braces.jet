// Each fixed-width number type called like a function is refused
// with the Jet spelling `Type{value}` in the Fix.
run: fn() {
    n: 7
    print(I8(n))
    print(I16(n))
    print(I32(n))
    print(I64(n))
    print(U8(n))
    print(U16(n))
    print(U32(n))
    print(U64(n))
    print(F32(n))
    print(F64(n))
}
