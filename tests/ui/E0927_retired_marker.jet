// E0927: `#Uninit` used to mark a deliberately-uninitialized
// field; D-UNINIT-SENTINEL1 retired the spelling outright. It gets a
// targeted fix, not a bare "did you mean" guess (there's no close
// registered name that means the same thing).
Widget: struct {
    #Uninit label: String
}

run: fn() {
    print("ok")
}
