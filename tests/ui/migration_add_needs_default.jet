// Tests E0910: a #PublishedSchema struct adds a field with no `add` migration,
// so old data has no value for it. The sibling .published.snapshot is the prior shape.
#PublishedSchema Account: struct {
    name: String
    verified: Bool
}

run: fn() {
    a: Account{name: "Alice", verified: true}
    print("{a.name}")
}
