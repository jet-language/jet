struct Session {
    hits: Int
}

struct Res {
    session: Session?
}

fn touch(result: &Res) {
    if &result.session == {
        .Val(session) -> {
            result.session = None
            session.hits = session.hits + 1
        }
        None -> {}
    }
}

fn run() {
    result := Res{session: Val(Session{hits: 0})}
    touch(&result)
}
