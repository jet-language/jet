Session: struct {
    hits: Int
}

Res: struct {
    session: Session?
}

touch: fn(result: &Res) {
    if &result.session == {
        .Val(session) -> {
            result.session = None
            session.hits = session.hits + 1
        }
        None -> {}
    }
}

run: fn() {
    result := Res{session: Val(Session{hits: 0})}
    touch(&result)
}
