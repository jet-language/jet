// #6281 c159: `impl Pair<T: Priced>.Describe` applies only where `T` is
// `Priced`. A `Pair<Int>` calling `describe`, a `Pair<Int>` passed where a
// `Describe` bound is wanted, and a `Pair<U>` for an unbounded `U` are each
// one E0905.
Priced: trait {
    price: fn(self) -> Int
}

Describe: trait {
    describe: fn(self) -> String
}

Pair: struct<T> {
    left: T
    right: T
}

impl Pair<T: Priced>.Describe {
    describe: fn(self) -> String { "pair costs {self.left.price() + self.right.price()}" }
}

show: fn<T: Describe>(value: T) -> String { value.describe() }

loose: fn<U>(pair: Pair<U>) -> String { pair.describe() }

run: fn() {
    n: Pair<Int>{left: 1, right: 2}
    print(n.describe())
    print(show(n))
}
