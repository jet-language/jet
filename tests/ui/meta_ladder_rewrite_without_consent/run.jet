// @programmable_build
// @cli_build
// E3514: the root rewrites `greet.hello` without `meta.allow_rewrite`.
use greet

build: fn(b: Build) -[Meta.Rewrite]> {
    app: b.add_executable("app", ["run.jet"], [])
    meta: b.compiler(app)
    meta.rewrite_body(greet.hello, #code {
        "rewritten by the root"
    })
    b.default(app)
}

run: fn() {
    print(greet.hello())
}
