// @programmable_build
// @build_grants Exec
// @requires env:LIBRARY_PATH=
build: fn(b: Build) -[Exec]> {
    #Impure("look for a folder no machine has") {
        shell: b.probe("shell", "find_program", "sh")
        marks: b.probe("marks", "find_folder", "jet-ui-no-such-file.a")
        look: b.run("look", b.found(shell), ["Exec"])
        look.file(b.found(marks))
        look.output("never.txt")
        app: b.add_executable("app", ["build_find_folder_missing.jet"], [look])
        b.default(app)
    }
}

run: fn() {

}
