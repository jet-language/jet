// @complexity_cli pass 3
add_if_match: fn(i: Int, j: Int) -> Int {
    if i > 0 && j > 0 -> return i + j
    if i == j -> return i + j
    return 0
}

tangled: fn(n: Int) -> Int {
    total := 0
    loop i in 0..<n {
        loop j in 0..<n -> total += add_if_match(i, j)
    }
    return total
}

run: fn() {}
