// @complexity_cli pass 3
fn add_if_match(i: Int, j: Int) Int {
    if i > 0 {
        if j > 0 :> return i + j
    }
    if i == j :> return i + j
    return 0
}

fn tangled(n: Int) Int {
    total := 0
    loop i, 0..<n {
        loop j, 0..<n :> total += add_if_match(i, j)
    }
    return total
}

fn run() {}
