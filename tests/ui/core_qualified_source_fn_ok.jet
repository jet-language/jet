    core :: core
    sys :: core.sys
    core.sys.[usize_max]
}

fn qualified() -> U64 Never! { core.sys.usize_max() }
fn aliased() -> U64 Never! { sys.usize_max() }
fn imported() -> U64 Never! { usize_max() }
fn run() {}
