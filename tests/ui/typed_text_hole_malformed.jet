// #6622 c3: an unfinished hole inside typed text reports once, at the hole's
// closing brace; the literal's own `}` doesn't end the function early.
run: fn() {
    page: HTML{"<p>{1 +}</p>"}
    print(page.text())
    query: SQL{"select name from users"}
    print(query.template())
}

after: fn() {
    print("still parsed")
}
