#Policy(writes: .Explicit)

grow: fn(items: &[Int]) {
    items.push(4)
}

archive: fn(title: &&String) -> Int {
    title.len()
}

count: fn(items: [Int]) -> Int {
    items.len()
}

run: fn() {
    xs := [Int]{1, 2, 3}
    grow(xs)
    xs.push(5)
    grow(&&xs)
    title: "draft"
    n: archive(title)
    print("{count(&xs)} {n}")
}
