// D-CRYPTO-DIAG1=A: compiler-known HKDF output bounds are E2702.
use core.crypto as crypto
use core.crypto.expert as expert

fn run() {
    safe :: crypto.hkdf_sha256(
        crypto.Secret.from_bytes([1]),
        [],
        [],
        8161
    )
    @Unsafe("fixed interop vector") {
        raw :: expert.hkdf_sha256(
            [1],
            [],
            [],
            -1
        )
    }
}
