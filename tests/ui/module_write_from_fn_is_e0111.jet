// A function may not write a plain module `:=` (D-MODULE-WRITE1=A): every
// task sees module state, and two plain writes at once can lose one. A
// `#Persist` binding and a write inside `#Unsafe` stay legal.
hits := 0
#Persist pinned := 0
raw := 0

bump: fn() {
    hits += 1
    pinned += 1
    #Unsafe("this program starts no task, so nothing else writes `raw`") {
        raw += 1
    }
}

run: fn() {
    bump()
    print("{hits} {pinned} {raw}")
}
