// A user trait that shares the name `IndexMut` is not the prelude index
// hook (#5971 c6): its impl never routes `g[k] = v`.
trait IndexMut {
    fn set(&self, k: Int, v: Int)
}

struct Grid {
    cells: [Int]
}

impl Grid.Index {
    type Key = Int
    type Value = Int
    fn get(self, k: Int) -> Int? { self.cells.get(k) }
}

impl Grid.IndexMut {
    fn set(&self, k: Int, v: Int) { print("user set {k} {v}") }
}

fn run() {
    g := Grid{cells: [1, 2, 3]}
    &g.set(1, 9)
    g[1] = 9
}
