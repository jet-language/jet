// A user trait that shares the name `IndexMut` is not the prelude index
// hook (#5971 c6): its impl never routes `g[k] = v`.
IndexMut: trait {
    set: fn(&self, k: Int, v: Int)
}

Grid: struct {
    cells: [Int]
}

impl Grid.Index {
    Key: Int
    Value: Int
    get: fn(self, k: Int) -> Int? { self.cells.get(k) }
}

impl Grid.IndexMut {
    set: fn(&self, k: Int, v: Int) { print("user set {k} {v}") }
}

run: fn() {
    g := Grid{cells: [1, 2, 3]}
    g.set(1, 9)
    g[1] = 9
}
