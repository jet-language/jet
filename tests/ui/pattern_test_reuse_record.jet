enum Shape {
    Rect(w: Int, h: Int)
    Dot
}

struct Point {
    x: Int
    y: Int
}

fn parse(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

fn run() {
    y :: 4
    point :: Point{x: 0, y: 4}
    same :: point == Point{x: 0, y}
    print("{same} {y}")
}
