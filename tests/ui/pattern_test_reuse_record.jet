Shape: enum {
    Rect(w: Int, h: Int)
    Dot
}

Point: struct {
    x: Int
    y: Int
}

parse: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

run: fn() {
    y: 4
    point: Point{x: 0, y: 4}
    same: point == Point{x: 0, y}
    print("{same} {y}")
}
