// A `Val`, `Ok` or `Err` built from a borrowed resource owns its payload
// wherever the carrier is kept: a binding, a stored field, a return and a
// pushed element each copy the caller's value.
Res: struct { name: String }
impl Res.Close {
    close: fn(&&self) { print("close {self.name}") }
}

Slot: struct { held: Res? }

bind: fn(env: Res) -> Int {
    wrapped := Val(env)
    wrapped.len()
}

store: fn(env: Res) -> Slot {
    Slot{held: Val(env)}
}

give: fn(env: Res) -> Res? {
    Val(env)
}

push: fn(env: Res) -> Int {
    kept := [Res?]{}
    kept.push(Val(env))
    kept.len()
}

run: fn() {
    print("unreached")
}
