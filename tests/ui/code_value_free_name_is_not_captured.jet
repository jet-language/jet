// @programmable_build
// @cli_build
// `#code` is hygienic: a name the build function declares is not seen by
// the code it hands over unless it is pasted.
build: fn(b: Build) {
    app: b.add_executable("app", ["code_value_free_name_is_not_captured.jet"], [])
    meta: b.compiler(app)
    message: "from the build"
    meta.add(#code {
        greeting: fn() -> String { message }
    }, scope: "greeting")
    b.default(app)
}

run: fn() { print(greeting()) }
