// D-META-FORM1=A rejects two retired spellings for stating facts about a rule
// (its legal sites, whether it repeats): a trailing `on` clause and a second
// parameter list. A scope body is now the checked code form from
// D-META-USER1=A.

marker Inline(mode: String) on [.Function]

marker Pre(condition: String)(sites: [.Function])

fn run() {}
