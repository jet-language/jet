// Every `marker` declaration is retired. A marker is a struct whose fields
// are its arguments and whose `impl Marker { … }` block gives its settings,
// group or template, so each spelling teaches that form; the parameter and
// group spellings carry the rewrite `jet fix` applies.

marker Traced(label: String, $sites: [.Function], $repeatable: true)

marker Fast = #[Inline(.Always), Scalar]

marker Inline(mode: String) on [.Function]

marker Pre(condition: String)(sites: [.Function])

marker Selector on [.Text] {
    check @body
    hole @value
}

fn run() {}
