// D-MARKER-SITES1=B rejects two retired spellings for stating facts about a rule
// (its legal sites, whether it repeats): a trailing `on` clause and a second
// parameter list. Each rejection must teach the ratified @-marked
// named-parameter form instead.

marker Inline(mode: String) on [.Function]

marker Pre(condition: String)(sites: [.Function])

marker Selector on [.Text] {
    check @body
    hole @value
}

fn run() {}
