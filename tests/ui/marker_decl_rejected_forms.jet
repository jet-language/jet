// D-META-FORM1=A rejected three spellings for stating facts about a rule
// (its legal sites, whether it repeats): a trailing `on` clause, a second
// parameter list, and a scope block. Each must teach the ratified
// @-marked named-parameter form instead.

marker Inline(mode: String) on [.Function]

marker Pre(condition: String)(sites: [.Function])

marker Unsafe(reason: String) {
    .sites [.Function]
}

fn run() {}
