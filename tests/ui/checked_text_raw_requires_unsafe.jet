// E0387: `Type.raw(text)` skips the CheckedText checker, so it needs `#Unsafe`.
#Error
TextError: enum { Empty }

Token: distinct String

impl Token.CheckedText {
    Error: TextError

    check: fn(text: String) TextError! -[]> {
        if text == "" { return Err(TextError.Empty) }
        return Ok()
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return "[{value}]"
    }
}

run: fn() {
    token: Token.raw("unchecked")
    #Unsafe("audited literal") {
        print(token.raw())
    }
}
