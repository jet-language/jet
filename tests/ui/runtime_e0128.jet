// A strict `zip` whose inputs end at different rows stops at run time.
// The lengths come from argv, so the check can't settle them first.
use process :: core.process

fn run() {
    count :: process.args().len()
    left :: [1, 2, 3].take(count)
    right :: [10, 20].take(2)
    loop row in left.zip(right) {
        print(row.a)
    }
}
// @run_cli
