use {
    web: core.web
    http: core.http
    server: core.http.server
}

named: fn(name: String) -> HTTPResponse HTTPError! { Ok(server.response(200, name)) }

keyed: fn(key: String) -> HTTPResponse HTTPError! { Ok(server.response(200, key)) }

run: fn() {
    router: http.router()
    // A Path without holes is a static pattern, checked as the same String is.
    router.get(Path{"/files/:name"}, named)
    router.custom("PURGE", Path{"/files/:name"}, named)
    router.get(Path{"/files/{{name}}"}, named)
    // A hole makes a run-time pattern, which only an App registers.
    area: "eu"
    router.get(Path{"/area/{area}/:key"}, keyed)
    mux: web.app()
    mux.custom("PURGE", Path{"/area/{area}/:key"}, keyed)
    mux.get(42, keyed)
}
