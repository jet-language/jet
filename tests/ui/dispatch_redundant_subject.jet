// E0994 (D-IF3): the `==` on the `if` already matches each arm head against the
// subject, so repeating `subject ==` on an arm is redundant. Drop the prefix and
// write just the value or pattern.
enum Conn {
    Active(Int)
    Closed
}

fn describe(c: Conn) => String {
    if c == {
        .Active(id) -> { return "live:{id}" }
        .Closed -> { return "closed" }

    }
    return "unknown"
}

fn run() {
    print(describe(Conn.Active(7)))
}
