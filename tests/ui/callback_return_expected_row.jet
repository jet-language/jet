struct Tree {
    source: String
    line_starts: Cell<[Int]?>
}

fn line_starts(tree: Tree) -> [Int] {
    return tree.line_starts.get_or_set(() -> {
        print("index built")
        return "built"
    })
}

fn run() {
    tree :: Tree{ source: "first", line_starts: Cell.new(None) }
    print(line_starts(tree))
}
