Tree: struct {
    source: String
    line_starts: Cell<[Int]?>
}

line_starts: fn(tree: Tree) -> [Int] {
    return tree.line_starts.get_or_set(fn() {
        print("index built")
        return "built"
    })
}

run: fn() {
    tree: Tree{ source: "first", line_starts: Cell.new(None) }
    print(line_starts(tree))
}
