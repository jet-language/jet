// E0307: `Dyn` has no source declaration, but it is a closed Core
// registry enum, so an else-less dispatch over it must name every variant.
// Before this check an unnamed variant (`Number`, `Bytes`, `DateTime`) reached
// a runtime "no else arm" trap instead of a compile error.
use {
    json: core.encoding.json
    core.encoding.[Dyn]
}

kind: fn(tree: Dyn) -> String {
    return if tree == {
        .Null -> "null"
        .Bool(_) -> "bool"
        .Int(_) -> "int"
        .Float(_) -> "float"
        .Text(_) -> "text"
        .Array(_) -> "array"
        .Object(_) -> "object"
    }
}

run: fn() { print(kind(json.parse("1") ?? panic("parse"))) }
