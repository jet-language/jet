// Positive matrix cell (generic): a `view` through a generic type parameter's
// field is sound when the wrapper is a parameter — the caller still owns it.
struct Wrap<T> {
    item: T
}
fn peek_item<T>(w: Wrap<T>) -> view T {
    return w.item
}
fn main() {
    w: Wrap<String> @= Wrap<String> {item: "hi"}
    print(peek_item(w))
}
