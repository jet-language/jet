// Fields and values with cleanup still need `^` (spec "Copies, moves, and
// owned destinations"): an owning position takes a resource out of an owned
// variable's field or a live match payload only where `^` writes the move,
// and once it is written a later use of the original is rejected.
Res: struct { name: String }
impl Res.Close {
    close: fn(^self) { print("close {self.name}") }
}

Holder: struct {
    res: Res
    label: String
}

holder: fn(name: String) -> Holder {
    Holder{res: Res{name: name}, label: name}
}

present: fn(carrier: Holder?) -> Bool {
    carrier != None
}

field_unmarked: fn() -> Res? {
    h: holder("field")
    out := Res?{None}
    out = Val(h.res)
    out
}

payload_unmarked: fn() -> Res? {
    carrier: Val(holder("payload"))
    out := Holder?{None}
    if carrier == {
        .Val(found) -> out = Val(found)
        .None -> {}
    }
    if out == {
        .Val(moved) -> Val(^moved.res)
        .None -> None
    }
}

payload_field_unmarked: fn() -> Res? {
    carrier: Val(holder("payload field"))
    if carrier == {
        .Val(found) -> Val(found.res)
        .None -> None
    }
}

arm_tail_unmarked: fn() -> Holder {
    carrier: Val(holder("arm"))
    found: if carrier == {
        .Val(held) -> held
        .None -> panic("no holder")
    }
    found
}

field_marked_then_used: fn() -> Res {
    h: holder("marked")
    out: Val(^h.res)
    print(h.res.name)
    out ?? panic("none")
}

payload_marked_then_used: fn() -> Res? {
    carrier: Val(holder("payload marked"))
    if carrier == {
        .Val(found) -> {
            out: Val(^found.res)
            print(found.res.name)
            out
        }
        .None -> None
    }
}

subject_used_after_payload_move: fn() -> Holder? {
    carrier: Val(holder("subject"))
    out := Holder?{None}
    if carrier == {
        .Val(found) -> out = Val(^found)
        .None -> {}
    }
    print(present(carrier))
    out
}

run: fn() {
    print("unreached")
}
