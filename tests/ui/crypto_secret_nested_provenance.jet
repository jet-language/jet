// Qualified core.crypto types retain nominal provenance through every type
// wrapper. Calls prove annotations unify; interpolation proves the leaf remains
// restricted after a transparent user flow tag.
use core.crypto as crypto

struct Holder<T> {
    value: T
}

fn accept_tagged(value: #Audit crypto.Secret) {}
fn accept_fixed(value: [crypto.Secret#1]) {}
fn accept_shared(value: Shared<crypto.Secret>) {}
fn accept_callback(value: fn(crypto.Secret) => crypto.Secret) {}
fn accept_list(value: [crypto.Secret]) {}
fn accept_holder(value: Holder<crypto.Secret>) {}
fn accept_tuple(value: (item: crypto.Secret, label: String)) {}

fn run() {
    tagged := #Audit crypto.Secret.{ crypto.Secret.from_text("tagged") }
    accept_tagged(tagged)
    print("{tagged}")

    fixed := [crypto.Secret#1].{ crypto.Secret.from_text("fixed") }
    accept_fixed(fixed)

    shared := Shared.new(crypto.Secret.from_text("shared"))
    accept_shared(shared)

    callback := fn(crypto.Secret) => crypto.Secret.{ (value) => value }
    accept_callback(callback)

    list := [crypto.Secret].{ crypto.Secret.from_text("list") }
    accept_list(list)

    holder := Holder<crypto.Secret>.{
        value: crypto.Secret.from_text("holder")
    }
    accept_holder(holder)

    tuple := (item: crypto.Secret, label: String).{ ( }
        item: crypto.Secret.from_text("tuple"),
        label: "tuple",
    )
    accept_tuple(tuple)
}
