// Qualified core.crypto types retain nominal provenance through every type
// wrapper. Calls prove annotations unify; interpolation proves the leaf remains
// restricted after a transparent user flow tag.
use crypto: core.crypto

Reviewed: tag { deny: [Log] }

Holder: struct<T> {
    value: T
}

accept_tagged: fn(value: #Reviewed crypto.Secret) {}

accept_fixed: fn(value: [crypto.Secret#1]) {}

accept_shared: fn(value: Shared<crypto.Secret>) {}

accept_callback: fn(value: fn(crypto.Secret) -> crypto.Secret) {}

accept_list: fn(value: [crypto.Secret]) {}

accept_holder: fn(value: Holder<crypto.Secret>) {}

accept_tuple: fn(value: (item: crypto.Secret, label: String)) {}

run: fn() {
    tagged: #Reviewed crypto.Secret.from_text("tagged")
    accept_tagged(tagged)
    print("{tagged}")

    fixed := [crypto.Secret#1]{crypto.Secret.from_text("fixed")}
    accept_fixed(fixed)

    handle := Shared{crypto.Secret.from_text("shared")}
    accept_shared(handle)

    callback: fn(value: crypto.Secret) { value }
    accept_callback(callback)

    list := [crypto.Secret]{crypto.Secret.from_text("list")}
    accept_list(list)

    holder := Holder<crypto.Secret>{
        value: crypto.Secret.from_text("holder")
    }
    accept_holder(holder)

    tuple: (
        item: crypto.Secret.from_text("tuple"),
        label: "tuple"
    )
    accept_tuple(tuple)
}
