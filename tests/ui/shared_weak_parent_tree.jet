// Strong kids and weak parent back-edges never close a strong cycle.
struct Person {
    name: String
    parent: Shared.Weak<Person>?
    kids: [Shared<Person>]
}

fn run() {
    mum :: shared Person{name: "Ada", parent: None, kids: []}
    kid :: shared Person{name: "Byron", parent: Val(mum.downgrade()), kids: []}
    &mum.kids.push(kid)
    &mum.kids.push(shared Person{name: "Cy", parent: Val(mum.downgrade()), kids: []})
    print("{mum.name} has {mum.kids.len()} kids")
}
