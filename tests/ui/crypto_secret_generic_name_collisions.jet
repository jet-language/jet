// @all_diags
// Generic parameter names are local nominal vocabulary, never core.crypto
// provenance. Each operation should get the ordinary generic-type diagnostic.
fn show_secret<Secret>(value: Secret) {
    print(value)
}

fn show_signing_key<SigningKey>(value: SigningKey) {
    print(value)
}

fn show_x25519_secret_key<X25519SecretKey>(value: X25519SecretKey) {
    print(value)
}

fn show_shared_secret<SharedSecret>(value: SharedSecret) {
    print(value)
}

fn run() {}
