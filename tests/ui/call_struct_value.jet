// D-OP-CALL1=A: parentheses call functions and lambdas only.
Scale: struct {
    factor: Int

    apply: fn(self, n: Int) -> Int { n * self.factor }

    as_fn: fn(self) -> fn(Int) -> Int {
        factor: self.factor
        fn(n: Int) { n * factor }
    }
}

run: fn() {
    triple: Scale{factor: 3}
    print(triple(4))
}
