MetadataField: struct { name: String }
MetadataPayload: enum {
    Unit
    Named(fields: [MetadataField])
}
MetadataVariant: struct { name: String, payload: MetadataPayload }
MetadataDefinitionKind: enum { Enum(variants: [MetadataVariant]) }
MetadataDefinition: struct { key: String, kind: MetadataDefinitionKind }
MetadataEmitter: struct { definitions: [MetadataDefinition], rendered: Int }

metadata_field_name: fn(emitter: &MetadataEmitter, name: String) -> String Never! {
    emitter.rendered += 1
    name.copy()
}

render_metadata: fn(emitter: &MetadataEmitter) -> [String] Never! {
    definition := emitter.definitions[0].copy()
    names := [String]{}
    if definition.kind == .Enum(variants) {
        loop variant in variants {
            if variant.payload == .Named(fields) {
                loop field in fields -> &names.push(metadata_field_name(&emitter, field.name))
            }
        }
    }
    names
}

run: fn() Never! {
    emitter := MetadataEmitter{
        definitions: [MetadataDefinition]{MetadataDefinition{
            key: "Choice",
            kind: MetadataDefinitionKind.Enum{variants: [MetadataVariant]{MetadataVariant{
                name: "Named",
                payload: MetadataPayload.Named{fields: [MetadataField]{MetadataField{name: "first"}, MetadataField{name: "second"}}}
            }}}
        }},
        rendered: 0
    }
    names := render_metadata(&emitter)
    assert(names == [String]{"first", "second"})
    assert(emitter.rendered == 2)
    assert(emitter.definitions.len() == 1)
}
