// D-SERDE-ACCESS=B: static-type-check Data/JSON accessor chain
use json: core.encoding.json

run: fn() {
    raw := "{{\"items\":[10,20]}}"
    tree := json.parse(raw) ?? panic("bad json")
    items := tree.field("items") ?? panic("missing items")
    first := items.at(0) ?? panic("no index 0")
    n := first.int() ?? panic("not int")
    print(n)
}
