// E0433 (D-DISCARD1=A): a pure method call whose result is thrown away. The
// method declares that it cannot fail, so the line has no outcome at all.
struct Point {
    x: Int
    y: Int
}

impl Point {
    fn sum(self) -> Int Never! { self.x + self.y }
}

fn run() {
    p :: Point{ x: 1, y: 2 }
    p.sum()
    print(p.x)
}
