// E2414: a field `{}` default must be a compile-time constant.
// `live()` performs I/O, so its value can only be known at runtime —
// it can't be baked in as a decode default.
live: fn() -[IO]> Int {
    print("side effect")
    return 1
}

#Codable
S: struct {
    n: Int{live()}
}

run: fn() {
    s: S{n: 5}
    print(s.n)
}
