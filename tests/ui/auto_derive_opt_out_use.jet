#!Printable
struct NoPrint { value: Int }

#!Debug
struct NoDebug { value: Int }

#!Equatable
struct NoEquality { value: Int }

fn run() {
    print(NoPrint{ value: 1 })
    print("{NoDebug{ value: 2 }:Debug}")
    left :: NoEquality{ value: 3 }
    right :: NoEquality{ value: 3 }
    print(left == right)
}
