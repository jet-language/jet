#!Printable
NoPrint: struct { value: Int }

#!Debug
NoDebug: struct { value: Int }

#!Equatable
NoEquality: struct { value: Int }

run: fn() {
    print(NoPrint{ value: 1 })
    print("{NoDebug{ value: 2 }:Debug}")
    left: NoEquality{ value: 3 }
    right: NoEquality{ value: 3 }
    print(left == right)
}
