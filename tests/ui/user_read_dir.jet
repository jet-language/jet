use paths: core.files.path

DirectoryHost: trait {
    read_dir: fn(self, path: paths.Path) -> [paths.Path]
}

Host: struct {}
impl Host.DirectoryHost {
    read_dir: fn(self, path: paths.Path) -> [paths.Path] { [paths.Path]{path} }
}

listing: fn<H: DirectoryHost>(host: H, path: paths.Path) -> Int {
    host.read_dir(path).len()
}

run: fn() {
    host: Host{}
    path: paths.of("example")
    _: host.read_dir(path)
    _: listing(host, path)
}
