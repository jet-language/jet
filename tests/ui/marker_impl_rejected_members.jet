// An `impl Marker` block gives a marker's settings, its group or its
// `expand: fn(self, target: Target)` template, each once, and a struct has one
// such block. A group names a fixed marker stack, so it has no fields.
Traced: struct {
    label: String

    impl Marker {
        sites: [.Function]
        sites: [.Method]
        colour: .Red
        group: #[Inline, Scalar]

        expand: fn(self, target: Target) {}

        expand: fn(self, target: Target) {}

        render: fn(self) {}
    }

    impl Marker {
        repeatable: true
    }
}

run: fn() {}
