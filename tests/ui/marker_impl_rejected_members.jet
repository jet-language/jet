// An `impl Marker` block gives a marker's settings, its group or its
// `fn expand(self, target: Target)` template, each once, and a struct has one
// such block. A group names a fixed marker stack, so it has no fields.
struct Traced {
    label: String

    impl Marker {
        sites :: [.Function]
        sites :: [.Method]
        colour :: .Red
        group :: #[Inline, Scalar]

        fn expand(self, target: Target) {}

        fn expand(self, target: Target) {}

        fn render(self) {}
    }

    impl Marker {
        repeatable :: true
    }
}

fn run() {}
