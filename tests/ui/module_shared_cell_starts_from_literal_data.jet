// A module `shared` cell starts from literal data the build stores: a call in
// its value is not literal data, so the build refuses it (E0643) rather than
// run code before `run`.
Count: struct { value: Int }

start: fn() -> Int { 3 }

HITS: shared Count{value: start()}

run: fn() {
    HITS.value += 1
    print(HITS.value)
}
