// The canonical DataEvent payloads stay typed: Number carries exact lexical
// text, Float a Float, Text a String, Bytes a [U8] list.
use core.encoding as encoding

fn run() {
    number :: encoding.DataEvent.Number(12)
    float :: encoding.DataEvent.Float("1.5")
    text :: encoding.DataEvent.Text(7)
    bytes :: encoding.DataEvent.Bytes([Int]{1, 2})
    print(number == float || text == bytes)
}
