// A': claiming due queue work consumes DB, Rand, and Time, not DB alone.
// The composed verifier owns the diagnostic snapshot; it is unobserved here.
use jobs: core.jobs

narrow: fn(queue: jobs.JobQueue) -[DB]> {
    _: queue.claim("narrow-effects", 1) ?? return
}

run: fn() {
    queue: jobs.queue() ?? return
    narrow(queue)
}
