// `:Debug` on a value with no Debug form is E0112. Its Fix never offers a
// spelling that fails for the same value: `ParseError` has no `Display`
// either and Core owns it, so neither `{err}` nor an `impl` is offered.
run: fn() {
    n: Int.parse("x") ?? {
        print("couldn't read {err:Debug}")
        0
    }
    print(n)
}
