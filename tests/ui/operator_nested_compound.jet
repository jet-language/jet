Vec2: struct {
    x: Int
    y: Int
}

Inner: struct {
    value: Vec2
}

Outer: struct {
    inner: Inner
}

GenericInner: struct<T> {
    value: T
}

GenericOuter: struct<T> {
    inner: GenericInner<T>
}

impl Vec2.Add {
    add: fn(self, rhs: Vec2) -> Vec2 { return Vec2{x: self.x + rhs.x, y: self.y + rhs.y} }
}

run: fn() {
    outer := Outer{inner: Inner{value: Vec2{x: 1, y: 2}}}
    outer.inner.value += Vec2{x: 3, y: 4}
}

update_generic: fn<T: Add>(outer: &GenericOuter<T>, delta: T) { outer.inner.value += delta }
