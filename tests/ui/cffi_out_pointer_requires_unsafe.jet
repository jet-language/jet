use {
    core.mem
    store: c.store
}

#Layout(c) Record: struct {
    id: U64
}

#Import c.store: module {
    store_load: fn(id: U64, out: *Record) -> I32 = "store_load"
}

#Unsafe("the local slot remains live for the complete C call")
invoke: fn() {
    slot := Record{id: 0}
    p: mem.Ptr<Record>.from_addr(mem.address_of(slot))
    print(store.store_load(1, p))
}

run: fn() { invoke() }
