// Tests E0910: a `change` op with neither an inline `via` nor an `impl New.From(Old)`
// in scope is rejected — the converter is required to read old data.
Label: struct {
    text: String
}

#PublishedSchema Order: struct {
    id: Int
    note: Label
}

migration Order {
    change note: String -> Label
}

run: fn() {
    o: Order{id: 1, note: Label{text: "rush"}}
    print("{o.id}")
}
