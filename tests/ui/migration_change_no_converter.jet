// Tests E0910: a `change` op with neither an inline `via` nor an `impl Old -> New`
// in scope is rejected — the converter is required to read old data.
struct Label {
    text: String
}

#PublishedSchema
struct Order {
    id: Int
    note: Label
}

migration Order {
    change note: String -> Label
}

fn main() {
    o #= Order.{
        id: 1
        note: Label.{ text: "rush" }
    }
    print("{o.id}")
}
