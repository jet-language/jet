// A mutation is a `#Transact` block: its writes commit together or roll back
// together. A call in the block whose body reaches `Net` is refused, as a
// `Net` call written in the block is: a sent request can't be taken back.
use {
    db: core.db
    http: core.http
}

notify: fn(url: String) -> Int {
    response: http.get(url) ?? return 0
    response.status
}

complete: fn(tasks: DBScope) {
    #Transact {
        _rows: tasks.execute(SQL{"UPDATE task SET done = 1"}) ?? 0
        _status: notify("https://hooks.example.com/done")
    }
}

run: fn() {
    policy: db.policy("task", "true") ?? panic("policy")
    complete(db.open_memory().with_policy(policy, "owner"))
}
