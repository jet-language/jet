use web: core.web
use server: core.http.server

#!Codable
JokeID: struct { value: Int }

Jokes: struct {
    #Server.Get("/jokes/:id")
    joke: fn(self, id: JokeID) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "joke={id.value}"))
    }
}

run: fn() {
    mux: web.app()
    mux.mount(Jokes{})
}
