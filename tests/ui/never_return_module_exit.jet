use {
    proc: core.process
    term: core.term
}

// A module-qualified `Never` call keeps the promise: no E2423 here.
stop: fn(code: Int) -> Never {
    term.print("stopping")
    proc.exit(code)
}

// A module-qualified call that returns still reaches the end (E2423).
almost: fn() -> Never {
    term.print("still here")
}

run: fn() {}
