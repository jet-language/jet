Score: struct {
    points: Int

    impl Comparable {
        compare: fn(self, other: Score) -> Ordering {
            if self.points < other.points -> return Ordering.Less
            if self.points > other.points -> return Ordering.Greater
            return Ordering.Equal
        }
    }
}

run: fn() { print(Score{points: 1} < Score{points: 2}) }
