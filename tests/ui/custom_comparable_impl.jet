struct Score {
    points: Int
}

impl Score.Comparable {
    fn compare(self, other: Score) => Ordering {
        if self.points < other.points { return Ordering.Less }
        if self.points > other.points { return Ordering.Greater }
        return Ordering.Equal
    }
}

fn run() {
    print(Score.{points: 1} < Score.{points: 2})
}
