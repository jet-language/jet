// A public group cannot export a private marker (E0605). Privacy belongs to a
// `priv module`, so the private marker is declared inside one.
priv module internal {
    struct Private {
        impl Marker {
            sites :: [.Function]
        }
    }
}
struct Published {
    impl Marker {
        group :: #[Internal.Private, Inline]
    }
}
fn run() {}
