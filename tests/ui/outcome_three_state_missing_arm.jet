// An else-less table over `User? DBError!` covers its
// three states `.Val`, `.None` and `.Err`; E0307 names the missing one.
User: struct {
    name: String
}

#Error
DBError: enum {
    Down
}

read_user: fn(id: Int) -> User? DBError! {
    if id == 0 -> return Err(DBError.Down)
    if id == 7 -> return Ok(Val(User{name: "priya"}))
    Ok(None)
}

describe: fn(id: Int) -> String {
    if read_user(id) == {
        .None -> "no such user"
        .Err(_) -> "database down"
    }
}

run: fn() {
    if read_user(7) == {
        .Val(user) -> print(user.name)
        .Err(_) -> print("database down")
    }
    print(describe(3))
}
