// E2404: provenance teaches both the inferred default and an explicit domain.
// The converted call below is the successful counterpart: its declared rail
// is accepted and therefore adds no mismatch report.
#Error
SourceErr: enum { One }

#Error
TargetErr: enum { One }

#Error
OtherErr: enum { One }

inferred: fn() -> Int {
    return Err("missing")
}

explicit: fn() -> Int SourceErr! {
    return Err(SourceErr.One)
}

impl TargetErr.From(SourceErr) {
    from: fn(error: SourceErr) -> TargetErr { return TargetErr.One }
}

converted: fn() -> Int TargetErr! {
    explicit()
    return Ok(0)
}

other: fn() -> Int OtherErr! {
    return Err(OtherErr.One)
}

job: fn() -> Int TargetErr! {
    inferred()
    inferred()
    inferred()
    inferred()
    inferred()
    other()
    converted()
    return Ok(0)
}
