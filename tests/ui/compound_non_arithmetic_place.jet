// S17 / E0109: `place op= value` means `place = place op value`, so a compound
// update needs the operator its binary form has. Lists, maps, Bool, Char, and
// tuples have no arithmetic; `String +=` is the one text append.
fn run() {
    items := [1, 2]
    items += [3]
    ready := true
    ready &= false
    letter := 'a'
    letter += 'b'
    text := "ab"
    text -= "b"
    counts := [String:Int]{}
    counts += [String:Int]{}
    pair := (x: 1, y: 2)
    pair += (x: 3, y: 4)
    print("{items.len()} {ready} {letter} {text} {counts.len()} {pair.x}")
}
