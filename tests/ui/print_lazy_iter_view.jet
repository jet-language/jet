// D-ITERTOOLS1=A: an adapter hands back a one-pass view. Showing one would
// consume it, so both `print` and bare interpolation refuse and teach
// `.to_list()`.
fn run() {
    nums :: [1, 2, 3]
    doubled :: nums.map((n: Int) => (n * 2))
    print(doubled)
    other :: nums.filter((n: Int) => (n > 1))
    print("view: {other}")
}
