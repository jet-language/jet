// One-pass sources cannot be shown because that would consume them.
use http: core.http

Box: struct<T> {
    value: T
}

count: fn() -> Stream<Int> {
    yield 1
}

run: fn() {
    nums: [1, 2, 3]
    doubled: nums.map((n: Int) -> (n * 2))
    print(doubled)
    other: nums.filter((n: Int) -> (n > 1))
    print("view: {other}")

    chunks: http.Body.empty().chunks()
    print(chunks)
    print("chunks: {chunks}")

    stream: count()
    print(stream)
    print("stream: {stream}")

    // Containers and unrelated generic applications remain printable.
    print([1, 2, 3])
    print(Box<Int>{value: 1})
    lazy_nums: nums.lazy()
    print(lazy_nums)
}
