// E0928 (D-JET-VERBS1=A): jobs cannot reuse any registered Jet command.
// Retired words such as `serve` remain available for jobs.
// `lint`, `test`, and `help` below each clash with a command.
// Invocation is `jet <name>`.
#Job serve: fn() {
    print("serving")
}

#Job lint: fn() {
    print("linting")
}

#Job test: fn() {
    print("nope")
}

#Job help: fn() {
    print("nope")
}

run: fn() {

}
