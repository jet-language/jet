// E0928 (D-JOB-NAMES1=A, card #3684): a `#Job fn` may not take `run`, `dev`,
// `build`, `test`, `help`, or `version`. Every other name, including Jet
// command words such as `serve` and `lint`, is an ordinary job name because
// jobs run under `jet jobs <name>`.
#Job fn serve() {
    print("serving")
}

#Job fn lint() {
    print("linting")
}

#Job fn test() {
    print("nope")
}

#Job fn help() {
    print("nope")
}

fn run() {

}
