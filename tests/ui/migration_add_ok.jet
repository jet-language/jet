// Tests that `add verified: Bool =  false` (D-MIGRATE2A) unblocks the added field.
// The sibling .published.snapshot supplies the prior shape (just `name`).
#PublishedSchema Account: struct {
    name: String
    verified: Bool
}

migration Account {
    add verified: Bool  = false
}

run: fn() {
    a: Account{name: "Alice", verified: true}
    print("{a.name}")
}
