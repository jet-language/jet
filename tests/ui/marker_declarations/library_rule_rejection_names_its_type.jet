
UnservedRoute: struct {
    name: String

    impl Diagnostic {
        what: fn(self) -> String { "`{self.name}` has no served route" }
        why: fn(self) -> String { "a served function answers one route" }
        fix: fn(self) -> String { "add the route that `{self.name}` answers" }
    }
}

Served: struct {
    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            reject(UnservedRoute{name: target.name})
        }
    }
}

#Served
serve: fn() {}

run: fn() {}
