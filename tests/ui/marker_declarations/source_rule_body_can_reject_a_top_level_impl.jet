
ImplNotAllowed: struct {
    impl Diagnostic {
        code: "E0927"
        what: fn(self) -> String { "this impl is not allowed" }
        why: fn(self) -> String { "the test rule rejects every impl it marks" }
        fix: fn(self) -> String { "remove the marker" }
    }
}

RejectsImpl: struct {
    impl Marker {
        sites: [.Impl]

        expand: fn(self, target: Target) {
            reject(ImplNotAllowed{})
        }
    }
}

Greeter: trait {
    hi: fn(self) -> String
}

Point: struct {
    x: Int
}

#RejectsImpl
impl Point.Greeter {
    hi: fn(self) -> String { "hi" }
}

run: fn() {}
