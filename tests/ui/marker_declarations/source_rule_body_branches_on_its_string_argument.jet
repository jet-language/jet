
BadPath: struct {
    path: String

    impl Diagnostic {
        what: fn(self) -> String { "route path `{self.path}` doesn't start with `/`" }
        why: fn(self) -> String { "a route path is matched from the root of the site" }
        fix: fn(self) -> String { "write the path as `/{self.path}`" }
    }
}

Route: struct {
    path: String

    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            if !self.path.starts_with("/") {
                reject(BadPath{path: self.path})
            }
        }
    }
}

#Route("orders")
orders: fn() {}

#Route("/home")
home: fn() {}

run: fn() {}
