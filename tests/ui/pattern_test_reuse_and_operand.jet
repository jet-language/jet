enum Shape {
    Rect(w: Int, h: Int)
    Dot
}

struct Point {
    x: Int
    y: Int
}

fn parse(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

fn run() {
    held :: 3
    ready :: true
    same :: ready && parse("abc") == .Ok(held)
    print("{same} {held}")
}
