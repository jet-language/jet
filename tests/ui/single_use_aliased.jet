// D-LIN1 / E0142: a `#SingleUse` value can't be lent (read/`&`) — only moved.
#SingleUse Lock: struct {
    resource: String
}

acquire: fn(resource: String) -> Lock { return Lock{resource: resource} }

peek: fn(lock: Lock) { print("peeking {lock.resource}") }

release: fn(lock: ^Lock) { print("unlocked {lock.resource}") }

run: fn() {
    db: acquire("db")
    peek(db)
    release(^db)
}
