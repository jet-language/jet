// D-EFF2: `#(via f)` must name a callback parameter of the function. `missing`
// is not a parameter of `invoke`, so the pass-through annotation is E0748.
fn invoke(n: Int, act: fn(Int) =[IO]=>) =[via missing]=> {
    act(n)
}

fn show(n: Int) {
    print("{n}")
}

fn run() {
    invoke(5, show)
}
