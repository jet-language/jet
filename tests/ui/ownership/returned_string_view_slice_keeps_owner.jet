// A `String.slice` result fills a `View<str>` return or field as a view
// of its source string, in either slice form; a plain `String` slot or
// binding still takes the owned slice.
Part: struct {
    head: View<str>
}

Named: struct {
    name: String
}

prefix: fn(text: String) -> View<str> from text {
    text.slice(0..<3)
}

middle: fn(text: String) -> View<str> from text {
    if text.len() < 4 -> return text.slice(0..<0)
    text.slice(1, 4)
}

part: fn(text: String) -> Part from text {
    Part{head: text.slice(0..<2)}
}

named: fn(text: String) -> Named {
    Named{name: text.slice(0..<2)}
}

owned_local: fn() -> Named {
    local: "local-text"
    cut: local.slice(0..<5)
    Named{name: cut}
}

run: fn() {
    word: "jetstream"
    print(prefix(word))
    print(middle(word))
    print(part(word).head)
    print(named(word).name)
    print(owned_local().name)
}
