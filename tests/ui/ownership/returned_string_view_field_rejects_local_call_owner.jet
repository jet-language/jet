// A `View<str>` field filled straight from a `.after()` call on a local
// owner is returned past that owner: the named literal carries the view.
Domain: struct { value: View<str> }

bad: fn() -[]> Domain {
    email := "user@example.com"
    return Domain{ value: email.after("@") }
}
run: fn() { print(bad().value) }
