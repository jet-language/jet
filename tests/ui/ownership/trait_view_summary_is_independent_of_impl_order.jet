
trait Select {
    fn select(self, left: [Int], right: [Int]) -> View<Int>
}

struct First { marker: Int }

fn wrapper(selector: First, left: [Int], right: [Int]) -[]> View<Int> {
    return selector.select(left, right)
}

impl First.Select {
    fn select(self, left: [Int], right: [Int]) -[]> View<Int> {
        return left[0..1]
    }
}

fn run() { print(0) }
