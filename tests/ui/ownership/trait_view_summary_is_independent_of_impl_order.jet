
Select: trait {
    select: fn(self, left: [Int], right: [Int]) -> View<Int>
}

First: struct { marker: Int }

wrapper: fn(selector: First, left: [Int], right: [Int]) -[]> View<Int> {
    return selector.select(left, right)
}

impl First.Select {
    select: fn(self, left: [Int], right: [Int]) -[]> View<Int> {
        return left[0..1]
    }
}

run: fn() { print(0) }
