
Token: struct {
    text: View<str>,
    rest: View<str>
}

scan: fn(source: String) -[]> Token {
    text: source.before(":")
    rest: source.after(":")
    return Token{ text: text, rest: rest }
}

parse: fn(source: String) -[]> Token {
    return scan(source)
}

parse_text: fn(source: String) -[]> View<str> {
    return parse(source).text
}

parse_rest: fn(source: String) -[]> View<str> {
    return parse(source).rest
}

run: fn() {
    source := "name:value"
    selected: parse_text(source)
    source = "other:data"
    print(selected)
}
