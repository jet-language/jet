
Particle: struct { position: Int }

update_pair: fn(particles: &[Particle], left_index: Int, right_index: Int) {
    left: &particles[left_index]
    right: &particles[right_index]
    left.position += 1
    right.position += 1
}

run: fn() {
    particles := [Particle]{
        Particle{ position: 10 },
        Particle{ position: 20 }
    }
    update_pair(particles, 0, 1)
}
