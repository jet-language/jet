// A write subrange takes over its parent write view's loan, but two live
// write subranges of one write view still overlap in its storage.
fn run() {
    data := [U8{0}, U8{0}, U8{0}, U8{0}]
    edit :: &data[0..<data.len()]
    window :: &edit[1..<3]
    other :: &edit[0..<2]
    window[0] = U8{1}
    other[0] = U8{2}
}
