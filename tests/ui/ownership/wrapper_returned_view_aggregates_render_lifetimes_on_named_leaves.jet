
Window: struct { values: View<Int> }
Holder: struct { maybe: Window? }
GenericHolder: struct<T> { value: T, maybe: Window? }

maybe: fn(values: [Int]) -[]> (Window?) {
    selected: values[0..1]
    return Val(Window{ values: selected })
}

result: fn(values: [Int]) -[]> Window Err! {
    selected: values[0..1]
    return Ok(Window{ values: selected })
}

tuple: fn(values: [Int]) -[]> (window: Window, count: Int) {
    selected: values[0..1]
    return (window: Window{ values: selected }, count: 1)
}

run: fn() { print(0) }
