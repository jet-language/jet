
Selector: struct { marker: Int }

impl Selector {
    first: fn(self, left: [Int], right: [Int]) -[]> View<Int> {
        return left[0..1]
    }
}

wrapper: fn(selector: Selector, left: [Int], right: [Int]) -[]> View<Int> {
    return selector.first(left, right)
}

run: fn() {
    selector: Selector{ marker: 0 }
    left := [7, 8]
    right := [9, 10]
    result: wrapper(selector, left, right)
    print(result[0])
}
