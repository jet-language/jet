Res: struct { name: String }
impl Res.Close {
    close: fn(^self) { print("close {self.name}") }
}

Holder: struct { res: Res }

Pair: struct { left: Holder, right: Holder }

run: fn() {
    res: Res{name: "a"}
    pair: Pair{left: Holder{res: res}, right: Holder{res: res}}
    print(pair.left.res.name)
}
