struct Res { name: String }
impl Res.Close {
    fn close(^self) { print("close {self.name}") }
}

struct Holder { res: Res }

struct Pair { left: Holder, right: Holder }

fn run() {
    res :: Res{name: "a"}
    pair :: Pair{left: Holder{res: res}, right: Holder{res: res}}
    print(pair.left.res.name)
}
