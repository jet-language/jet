Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
Holder: struct { res: Res }

grab: fn(res: &&Res) { print("took {res.name}") }

release: fn(holder: Holder) {
    grab(holder.res.move())
}

run: fn() {
    release(Holder{res: Res{name: "c"}})
}
