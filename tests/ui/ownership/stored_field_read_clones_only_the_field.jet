
Sprite: struct {
    text: [U8]
    width: Int

    row_width: fn(self, row: Int) -> Int { self.width * row }
}

Frame: struct {
    sprite: Sprite
}

frame_width: fn(frame: Frame) -> Int { frame.sprite.width }

run: fn() {
    sprite: Sprite{text: [U8{1}, U8{2}, U8{3}], width: 4}
    total := 0
    loop row in 0..3 -> total += sprite.row_width(row)
    print(total)
    local_width: sprite.width
    frame: Frame{sprite: sprite}
    print(frame_width(frame) + local_width)
}
