#SingleUse Lease: struct {
    name: String
}

acquire: fn(name: String) -> Lease { Lease{name: name.copy()} }

skip_inner: fn() {
    groups: [[Lease]]{[Lease]{acquire("nested")}}
    loop group in groups {
        print(group.len())
    }
}

skip_element: fn() {
    leases: [Lease]{acquire("a")}
    loop lease in leases {
        print(lease.name)
    }
}

skip_map_value: fn() {
    table: [String: Lease]{"k": acquire("b")}
    loop (key, lease) in table.move() {
        print(key)
    }
}

run: fn() {
    skip_inner()
    skip_element()
    skip_map_value()
}
