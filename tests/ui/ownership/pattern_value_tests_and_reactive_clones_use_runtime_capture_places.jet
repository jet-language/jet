
Incident: struct { count: Int, label: String }
both: fn(values: &[Int], callback: fn()) {
    values.push(3)
    callback()
}
run: fn() {
    values := [1, 2]
    changed := [0]
    incident := Incident{ count: 2, label: "jet" }
    both(values, () -> {
        changed.push(1)
        if incident == {
            { count: values.len(), label, .. } -> print(label)
            else -> {}
        }
    })
}
