
pick_first: fn(line: String, noise: String) -[]> View<str> {
    text: line.before(":")
    return text
}

apply: fn(f: fn(String, String) -> View<str>, a: String, b: String) -[]> View<str> {
    return f(a, b)
}

run: fn() {
    a := "hello:x"
    b := "world"
    result: apply(pick_first, a, b)
    b = "mutated"
    print(result)
}
