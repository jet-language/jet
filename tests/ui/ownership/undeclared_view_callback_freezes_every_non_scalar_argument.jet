
fn pick_first(line: String, noise: String) -[]> View<str> {
    text :: line.before(":")
    return text
}

fn apply(f: fn(String, String) -> View<str>, a: String, b: String) -[]> View<str> {
    return f(a, b)
}

fn run() {
    a := "hello:x"
    b := "world"
    result :: apply(pick_first, a, b)
    b = "mutated"
    print(result)
}
