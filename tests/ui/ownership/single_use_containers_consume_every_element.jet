#SingleUse struct Lease {
    name: String
}

struct Box<T> {
    item: T
}

fn acquire(name: String) -> Lease { Lease{name: name.copy()} }

fn try_acquire(name: String) -> Lease Err! { Ok(acquire(name)) }

fn release(lease: ^Lease) { print("released {lease.name}") }

fn unbox(boxed: ^Box<Lease>) -> Lease { boxed.item }

fn release_list() {
    leases :: [Lease]{acquire("list a"), acquire("list b")}
    loop lease in leases {
        release(^lease)
    }
}

fn release_nested() {
    groups :: [[Lease?]]{[Lease?]{acquire("nested"), None}}
    loop group in groups {
        loop maybe in group {
            if ^maybe == {
                .Val(lease) -> release(^lease)
                .None -> {}
            }
        }
    }
}

fn release_drained_list() {
    leases := [Lease]{acquire("drain a"), acquire("drain b")}
    loop leases.len() > 0 {
        if &leases.pop() == {
            .Val(lease) -> release(^lease)
            .None -> {}
        }
    }
}

fn release_option() {
    maybe :: Lease?{acquire("option")}
    lease :: ^maybe ?? return
    release(^lease)
}

fn release_option_match() {
    maybe :: Lease?{acquire("option match")}
    if ^maybe == {
        .Val(lease) -> release(^lease)
        .None -> {}
    }
}

fn release_results() {
    outcomes :: [Lease Err!]{try_acquire("result")}
    loop outcome in outcomes {
        if ^outcome == {
            .Ok(lease) -> release(^lease)
            .Err(_) -> {}
        }
    }
}

fn release_map() {
    table :: [String: Lease]{"map": acquire("map")}
    loop (key, lease) in ^table {
        print(key)
        release(^lease)
    }
}

fn release_tuple() {
    pair :: (first: acquire("tuple"), count: 1)
    (first, count) :: ^pair
    print(count)
    release(^first)
}

fn release_generic() {
    boxed :: Box<Lease>{item: acquire("generic")}
    lease :: unbox(^boxed)
    release(^lease)
}

fn run() {
    release_list()
    release_nested()
    release_drained_list()
    release_option()
    release_option_match()
    release_results()
    release_map()
    release_tuple()
    release_generic()
}
