#SingleUse Lease: struct {
    name: String
}

Box: struct<T> {
    item: T
}

acquire: fn(name: String) -> Lease { Lease{name: name.copy()} }

try_acquire: fn(name: String) -> Lease Err! { Ok(acquire(name)) }

release: fn(lease: &&Lease) { print("released {lease.name}") }

unbox: fn(boxed: &&Box<Lease>) -> Lease { boxed.item }

release_list: fn() {
    leases: [Lease]{acquire("list a"), acquire("list b")}
    loop lease in leases {
        release(lease)
    }
}

release_nested: fn() {
    groups: [[Lease?]]{[Lease?]{acquire("nested"), None}}
    loop group in groups {
        loop maybe in group {
            if maybe.move() == {
                .Val(lease) -> release(lease)
                .None -> {}
            }
        }
    }
}

release_drained_list: fn() {
    leases := [Lease]{acquire("drain a"), acquire("drain b")}
    loop leases.len() > 0 {
        if leases.pop() == {
            .Val(lease) -> release(lease)
            .None -> {}
        }
    }
}

release_option: fn() {
    maybe: Lease?{acquire("option")}
    lease: maybe.move() ?? return
    release(lease)
}

release_option_match: fn() {
    maybe: Lease?{acquire("option match")}
    if maybe.move() == {
        .Val(lease) -> release(lease)
        .None -> {}
    }
}

release_results: fn() {
    outcomes: [Lease Err!]{try_acquire("result")}
    loop outcome in outcomes {
        if outcome.move() == {
            .Ok(lease) -> release(lease)
            .Err(_) -> {}
        }
    }
}

release_map: fn() {
    table: [String: Lease]{"map": acquire("map")}
    loop (key, lease) in table.move() {
        print(key)
        release(lease)
    }
}

release_tuple: fn() {
    pair: (first: acquire("tuple"), count: 1)
    (first, count): pair.move()
    print(count)
    release(first)
}

release_generic: fn() {
    boxed: Box<Lease>{item: acquire("generic")}
    lease: unbox(boxed)
    release(lease)
}

run: fn() {
    release_list()
    release_nested()
    release_drained_list()
    release_option()
    release_option_match()
    release_results()
    release_map()
    release_tuple()
    release_generic()
}
