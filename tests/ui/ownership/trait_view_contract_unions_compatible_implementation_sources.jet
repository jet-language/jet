
Select: trait {
    select: fn(self, left: [Int], right: [Int]) -> View<Int>
}

First: struct {}
impl First.Select {
    select: fn(self, left: [Int], right: [Int]) -[]> View<Int> {
        return left[0..1]
    }
}

Last: struct {}
impl Last.Select {
    select: fn(self, left: [Int], right: [Int]) -[]> View<Int> {
        return right[0..1]
    }
}

run: fn() { print(0) }
