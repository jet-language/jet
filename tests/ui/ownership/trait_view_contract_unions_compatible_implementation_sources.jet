
trait Select {
    fn select(self, left: [Int], right: [Int]) -> View<Int>
}

struct First {}
impl First.Select {
    fn select(self, left: [Int], right: [Int]) -[]> View<Int> {
        return left[0..1]
    }
}

struct Last {}
impl Last.Select {
    fn select(self, left: [Int], right: [Int]) -[]> View<Int> {
        return right[0..1]
    }
}

fn run() { print(0) }
