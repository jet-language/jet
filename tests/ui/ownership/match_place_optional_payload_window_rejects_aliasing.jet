Counter: struct {
    value: Int?
}

read_while_open: fn() {
    counter := Counter{value: Val(10)}
    if &counter.value == {
        .Val(n) -> {
            print(counter.value ?? 0)
            n += 1
        }
        .None -> {}
    }
}

reset_while_open: fn() {
    maybe := Int?{Val(1)}
    if &maybe == {
        .Val(n) -> {
            maybe = None
            n += 1
        }
        .None -> {}
    }
}

run: fn() {
    read_while_open()
    reset_while_open()
}
