struct Counter {
    value: Int?
}

fn read_while_open() {
    counter := Counter{value: Val(10)}
    if &counter.value == {
        .Val(n) -> {
            print(counter.value ?? 0)
            n += 1
        }
        .None -> {}
    }
}

fn reset_while_open() {
    maybe := Int?{Val(1)}
    if &maybe == {
        .Val(n) -> {
            maybe = None
            n += 1
        }
        .None -> {}
    }
}

fn run() {
    read_while_open()
    reset_while_open()
}
