
struct Window { values: View<Int> }

fn window(values: [Int]) -[]> Window {
    selected :: values[0..1]
    return Window{ values: selected }
}

fn run() {
    handle :: task window([7, 8])
    print((handle.join() ?? Window{ values: [] }).values[0])
}

