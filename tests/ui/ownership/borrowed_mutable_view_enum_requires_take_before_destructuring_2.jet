
Choice: enum {
    First(ViewMut<Int>)
    Second(ViewMut<Int>)
}

inspect: fn(choice: &&Choice) {
    if choice == {
        .First(selected) -> print(selected[0])
        .Second(selected) -> print(selected[0])
    }
}

run: fn() {
    values := [1, 2]
    window: &values[0..1]
    choice: Choice.First(window)
    inspect(choice)
}

