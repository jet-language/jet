
Pair: struct { left: View<Int>, right: View<Int> }

Select: trait {
    select: fn(self, left: [Int], right: [Int]) -[]> Pair
}

wrapper: fn(selector: Select, left: [Int], right: [Int]) -[]> Pair {
    return selector.select(left, right)
}


Last: struct {
    impl Select {
        select: fn(self, left: [Int], right: [Int]) -[]> Pair {
            left_view: left[0..1]
            right_view: right[0..1]
            return Pair{ left: left_view, right: right_view }
        }
    }
}
First: struct {
    impl Select {
        select: fn(self, left: [Int], right: [Int]) -[]> Pair {
            left_view: left[0..1]
            right_view: right[0..1]
            return Pair{ left: left_view, right: right_view }
        }
    }
}

run: fn() { print(0) }
