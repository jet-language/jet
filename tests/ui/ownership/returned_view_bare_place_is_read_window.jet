// A bare parameter or field place returned as `View<T>` is a read window
// over the whole list, on a plain and on a fallible success edge.
Holder: struct {
    items: [Int]
}

all: fn(items: [Int]) -> View<Int> from items {
    items
}

field: fn(holder: Holder) -> View<Int> from holder {
    holder.items
}

fixed: fn(values: [Int#3]) -> View<Int> from values {
    values
}

checked: fn(items: [Int]) -> View<Int> Err! from items {
    if items.len() == 0 -> return Err("none")
    Ok(items)
}

run: fn() {
    xs: [Int]{1, 2, 3}
    holder: Holder{items: [Int]{4, 5}}
    triple: [Int#3]{6, 7, 8}
    print(all(xs))
    print(field(holder))
    print(fixed(triple))
    print(checked(xs) ?? panic("checked"))
}
