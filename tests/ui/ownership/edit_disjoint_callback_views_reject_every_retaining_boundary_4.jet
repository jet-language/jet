
leak: fn(values: &[Int]) -[]> ViewMut<Int> {
    return values.edit_disjoint([0, 1], fn(left, right) {
        return left
    }) ?? panic("selection failed")
}
run: fn() {
    values := [1, 2]
    leak(values)
}

// Known failing: JetSema does not check this ownership rule yet; this variant retains its original contract, not a skip.
