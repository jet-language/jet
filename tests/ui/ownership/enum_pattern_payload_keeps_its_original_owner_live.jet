
Selection: enum { One(View<Int>) }

select: fn(values: [Int]) -[]> Selection {
    selected: values[0..1]
    return Selection.One(selected)
}

run: fn() {
    values := [7, 8]
    selected: select(values)
    if selected == {
        .One(part) -> {
            &values.push(9)
            print(part[0])
        }
    }
}

