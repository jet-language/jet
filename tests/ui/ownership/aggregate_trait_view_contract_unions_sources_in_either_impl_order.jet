
struct Pair { left: View<Int>, right: View<Int> }

trait Select {
    fn select(self, left: [Int], right: [Int]) -> Pair
}


struct First {}
impl First.Select {
    fn select(self, left: [Int], right: [Int]) -[]> Pair {
        left_view :: left[0..1]
        right_view :: right[0..1]
        return Pair{ left: left_view, right: right_view }
    }
}

struct Last {}
impl Last.Select {
    fn select(self, left: [Int], right: [Int]) -[]> Pair {
        left_view :: left[0..1]
        right_view :: left[0..1]
        return Pair{ left: left_view, right: right_view }
    }
}


fn run() { print(0) }
