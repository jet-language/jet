
Token: struct {
    text: View<str>
    rest: View<str>
}

scan: fn(source: String) -[]> Token {
    text: source.before(":")
    rest: source.after(":")
    return Token{ text: text, rest: rest }
}

run: fn() {
    source: "name:value"
    token: scan(source)
    print(token.text)
    print(token.rest)
}
