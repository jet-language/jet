#SingleUse Lease: struct {
    name: String
}

Box: struct<T> {
    item: T
}

acquire: fn(name: String) -> Lease { Lease{name: name.copy()} }

try_acquire: fn(name: String) -> Lease Err! { Ok(acquire(name)) }

run: fn() {
    leases: [Lease]{acquire("list")}
    maybe: Lease?{acquire("option")}
    outcomes: [Lease Err!]{try_acquire("result")}
    table: [String: Lease]{"map": acquire("map")}
    pair: (first: acquire("tuple"), count: 1)
    boxed: Box<Lease>{item: acquire("generic")}
    plain: Box<[Int]>{item: [1, 2]}
    print(plain.item.len())
}
