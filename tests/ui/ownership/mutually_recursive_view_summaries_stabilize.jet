
first: fn(values: [Int], recurse: Bool) -[]> View<Int> {
    if recurse {
        return second(values, false)
    }
    return values[0..1]
}

second: fn(values: [Int], recurse: Bool) -[]> View<Int> {
    if recurse {
        return first(values, false)
    }
    return values[0..1]
}

run: fn() { print(0) }
