
fn first(values: [Int], recurse: Bool) -[]> View<Int> {
    if recurse {
        return second(values, false)
    }
    return values[0..1]
}

fn second(values: [Int], recurse: Bool) -[]> View<Int> {
    if recurse {
        return first(values, false)
    }
    return values[0..1]
}

fn run() { print(0) }
