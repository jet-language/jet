Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
Box: struct { res: Res }

keep: fn(res: &&Res) -> Res { res }

// The shared storage keeps owning the guard's payload: a `^` out of the
// guard would leave its other guards and its cleanup a closed value.
steal: fn(storage: Shared<Box>) -> Res {
    guard := storage.guard_edit()
    keep(guard.value.res.move())
}

run: fn() {
    storage: shared Box{res: Res{name: "kept"}}
    _: steal(storage)
}
