// A Directory or FileReader passed to a read parameter of a union
// type is lent to the call, and the callee can't keep it. Returning it and
// capturing it in a stored lambda report E0120; storing it in a struct field
// reports E0201. A union payload that has a copy is copied instead.
Holder: struct { handle: Directory | FileReader }

keep: fn(handle: Directory | FileReader) -> Directory | FileReader { handle }

hold: fn(handle: Directory | FileReader) -> Holder { Holder{handle: handle} }

later: fn(handle: Directory | FileReader) -> fn() -> String {
    fn() { if handle == {
        .Directory(_) -> "directory"
        .FileReader(_) -> "reader"
    } }
}

run: fn() {
    print("unreached")
}
