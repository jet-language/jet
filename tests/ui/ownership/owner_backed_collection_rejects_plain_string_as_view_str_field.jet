
Book: struct {
    title: String,
    pages: Int
}

Library: struct {
    books: [Book]
}

TitleView: struct {
    value: View<str>
}

first_title: fn(lib: Library) -[]> TitleView {
    value: lib.books[0].title
    return TitleView{ value: value }
}

run: fn() {
    lib: Library{
        books: [Book{ title: "Dune", pages: 412 }]
    }
    print(first_title(lib).value)
}
