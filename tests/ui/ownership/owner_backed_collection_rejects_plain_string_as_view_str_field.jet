
struct Book {
    title: String,
    pages: Int
}

struct Library {
    books: [Book]
}

struct TitleView {
    value: View<str>
}

fn first_title(lib: Library) -[]> TitleView {
    value :: lib.books[0].title
    return TitleView{ value: value }
}

fn run() {
    lib :: Library{
        books: [Book{ title: "Dune", pages: 412 }]
    }
    print(first_title(lib).value)
}
