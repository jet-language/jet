
first: fn(values: [Int]) -[]> View<Int> { return values[0..1] }
both: fn(view: View<Int>, values: &[Int]) { values.push(view[0]) }
choose: fn(other: [Int], values: &[Int]) -[..E]> View<Int> {
    both(Val(first(other)) ?? return first(values), values)
    return first(other)
}
run: fn() {
    other := [1]
    values := [2]
    chosen: choose(other, values)
    print(chosen[0])
}
