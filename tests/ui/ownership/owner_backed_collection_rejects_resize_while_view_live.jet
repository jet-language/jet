
Book: struct {
    title: String,
    pages: Int
}

Library: struct {
    books: [Book]
}

book_at: fn(lib: Library, i: Int) -> View<Book> { lib.books[i..i] }

run: fn() {
    lib := Library{
        books: [
            Book{ title: "Dune", pages: 412 },
            Book{ title: "Neuromancer", pages: 271 }
        ]
    }
    first: book_at(lib, 0)
    &lib.books.push(Book{ title: "Snow Crash", pages: 480 })
    print(first[0].title)
}
