
Parcel: struct {
    label: String
}

impl Parcel {
    show: fn(self) {
        print(self.label)
    }
}

read_text: fn(text: String) {
    if true {
        print(text)
    }
}

read_list: fn(values: [Int]) {
    print(values.len())
}

read_parcel: fn(parcel: Parcel) {
    parcel.show()
}

read_generic: fn<T>(value: T) {
    print(0)
}

apply: fn(f: fn(Int) -> Int, value: Int) -[]> Int {
    return f(value)
}

run: fn() {
    text: "hello"
    values: [1, 2, 3]
    parcel: Parcel{ label: "parcel" }
    read_text(text)
    read_list(values)
    read_parcel(parcel)
    read_generic(text)
    print(apply((n: Int) -> (n + 1), 41))
}
