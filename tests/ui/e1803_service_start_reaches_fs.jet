// @run_cli
// D-SERVICE-EFFECTS1=A: starting a service tree recovers its durable state
// store, so the call reaches the files its Core source reads and writes. A
// file with no package block has not allowed FS, so E1803 names it before
// anything runs.
use service :: core.service

fn worker() {}

fn run() {
    tree := service.tree("orders")
    _endpoint :: &tree.worker("intake", worker, capacity: 1) ?? panic("worker")
    &tree.start() ?? panic("start")
    print("started")
}
