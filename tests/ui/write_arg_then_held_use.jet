// A later argument that the call keeps holding, moves, or writes still
// conflicts with a `&` argument of the same place, and so does the place
// passed on to a nested call or taken by a nested receiver.
Bag: struct {
    items: [Int]

    drain: fn(&&self) -> Int { self.items.len() }
}

grow: fn(items: &[Int], extra: [Int]) {
    items.push(extra.len())
}

grow_taken: fn(items: &[Int], extra: &&[Int]) {
    items.push(extra.len())
}

grow_both: fn(items: &[Int], more: &[Int]) {
    items.push(more.len())
}

count: fn(items: &&[Int]) -> Int { items.len() }

grow_by: fn(items: &[Int], extra: Int) {
    items.push(extra)
}

fill: fn(bag: &Bag, extra: Int) {
    bag.items.push(extra)
}

run: fn() {
    xs := [1, 2, 3]
    grow(xs, xs)
    grow_taken(xs, xs)
    ys := [1]
    grow_both(ys, ys)
    zs := [1]
    grow_by(zs, count(zs))
    bag := Bag{items: [1]}
    fill(bag, bag.drain())
}
