// D-EFFDBREAD1=A: `conn.query`/`query_one` carry the `DB.Read` effect leaf and
// `conn.execute` carries `DB.Write`. A function declared `#(DB.Read)` — the
// bound a live query (D-LIVEQUERY1) requires — that hides a write is caught by
// the existing E0740 check, naming the offending `DB.Write` leaf. No new
// diagnostic code: `DB.Read` does not cover its sibling `DB.Write`.
use core.db as db

fn touch(conn: DBScope) =[DB.Read]=> {
    _rows :: conn.execute("UPDATE person SET active = 1", []) ?? 0
}

fn run() {
    conn :: db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped :: conn.with_policy(policy, "owner") ?? panic("scope")
    touch(scoped)
}
