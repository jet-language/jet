// E0355 (D-META-REG1): `#Job` only marks a top-level job function.
// function — a method has no free-standing name for `jet run <entry> -- <job>` to
// invoke.
Cleaner: struct {
    label: String,

    #Job
    sweep: fn(self) {
        print(self.label)
    }
}

run: fn() {
    c := Cleaner{ label: "x" }
    c.sweep()
}
