#Error
enum FetchError {
    BadURL(String)
    Timeout(seconds: Int, retries: Int)
}

#Error
enum AppError {
    FailedToFetch(url: String, cause: FetchError)
}

fn fetch(raw: String) -> String AppError! {
    if raw == "" -> return Err(AppError.FailedToFetch{url: raw, cause: FetchError.BadURL("empty")})
    Ok(raw)
}

fn run() {
    if fetch("") == {
        .Ok(page) -> print(page)
        .Err(.FailedToFetch{link, ..}) -> print("failed")
    }
}
