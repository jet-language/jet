enum Shape {
    Rect(w: Int, h: Int)
    Dot
}

struct Point {
    x: Int
    y: Int
}

fn parse(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

fn run() {
    first :: "a"
    words :: ["a", "b"]
    same :: words == [first, ..rest]
    print("{same} {first}")
}
