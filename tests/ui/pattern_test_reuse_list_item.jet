Shape: enum {
    Rect(w: Int, h: Int)
    Dot
}

Point: struct {
    x: Int
    y: Int
}

parse: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

run: fn() {
    first: "a"
    words: ["a", "b"]
    same: words == [first, ..rest]
    print("{same} {first}")
}
