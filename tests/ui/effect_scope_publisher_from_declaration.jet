// A Core function publishes a scoped effect from its declaration alone:
// `files.can_write` takes `path` first and declares `FS.Read`, so its
// constant path `secret.txt` is outside the folder `assets/`.
use files: core.files

probe: fn() -[FS.Read("assets/")]> Bool {
    files.can_write("secret.txt")
}

run: fn() { print(probe()) }
