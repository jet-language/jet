// E2711 fixture: an imported module defines both a UserDerive block AND applies
// it to a struct within the same file. This violates the derive orphan rule
// (D-METADERIVE1=A): user-derive expansion can only run in the entry module.

derive T.Named {
    info :: T.reflect()
    tname :: info.name
    emit("impl $tname {{ fn tag_name(self) -> String {{ return \"$tname\" }} }}")
}

#[Named]
pub struct Bar {
    x: Int
}
