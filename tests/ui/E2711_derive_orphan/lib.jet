// E2711 fixture: neither the UserDerive provider nor its target type is local
// to the entry module, so the generated impl would have no local owner.
derive T.Named {
    info :: T.reflect()
    tname :: info.name
    emit("impl $tname {{ fn tag_name(self) -> String {{ return \"$tname\" }} }}")
}

#Named
pub struct Bar {
    x: Int
}
