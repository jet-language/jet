// A typed literal straight after a comparison or `in` in an `if` or `loop`
// header: its `{` is read as the start of the body.
run: fn() {
    a: I32{3}
    if a > I32{0} -> print("pos")
    if a <= I32{0} {
        print("nonpos")
    }
    n := I32{0}
    loop n < I32{2} {
        n += I32{1}
    }
    loop word in [String]{"x", "y"} -> print(word)
}
