Node: struct {
    label: String
    next: Shared<Node>?
}

// Either handle may already reach the other, so both writes can close a loop.
link: fn(a: Shared<Node>, b: Shared<Node>) {
    a.next = Val(b)
    guard: b.guard_edit()
    guard.value.next = Val(a)
}

run: fn() {
    link(shared Node{label: "a", next: None}, shared Node{label: "b", next: None})
}
