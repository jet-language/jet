// #1414 library workload: the public JSON value API owns parsing and
// canonicalization. Invalid input is an ordinary, reported result.
use {
    json: core.encoding.json
    fs: core.files
}

#CLI
WorkloadArgs: struct {
    input: String
}

reject_json: fn() {
    print("reject=json")
    print("valid=false")
}

run: fn(args: WorkloadArgs) {
    input: args.input
    if fs.read(input) == {
        .Ok(raw) -> {
            raw_bytes: raw.bytes()
            if raw_bytes.len() <= 1048576 {
                if json.parse(raw) == {
                    .Ok(value) -> {
                        canonical: json.canonical(value) ?? panic("canonicalize")
                        print("canonical={canonical}")
                        print("valid=true")
                    }
                    .Err(_) -> reject_json()
                }
            } else { reject_json() }
        }
        .Err(_) -> reject_json()
    }
}
