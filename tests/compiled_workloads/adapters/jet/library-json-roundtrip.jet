// #1414 library workload: the public JSON value API owns parsing and
// canonicalization. Invalid input is an ordinary, reported result.
use core.encoding.json as json
use core.files as fs

#CLI
struct WorkloadArgs {
    input: String
}

fn reject_json() {
    print("reject=json")
    print("valid=false")
}

fn run(args: WorkloadArgs) {
    input :: args.input
    if fs.read(input) == {
        .Ok(raw) -> {
            raw_bytes :: raw.bytes()
            if raw_bytes.len() <= 1048576 {
                if json.parse(raw) == {
                    .Ok(value) -> {
                        canonical :: json.canonical(value) ?? panic("canonicalize")
                        print("canonical={canonical}")
                        print("valid=true")
                    }
                    .Err(_) -> reject_json()
                }
            } else { reject_json() }
        }
        .Err(_) -> reject_json()
    }
}
