// #1414 CLI workload: inspect real USTAR bytes with one beginner path and
// optional expert controls. Invalid headers are rejected without extraction.
use core.archive as archive
use core.files as fs

#CLI
struct WorkloadArgs {
    #Doc("tar or ustar input format") format: String{"tar"}
    #Doc("entry glob; * and ? match path bytes") filter: String{"*.md"}
    #Doc("maximum claimed entry size") max_size: Int{64}
    #Doc("maximum number of headers") max_entries: Int{10000}
    #Doc("archive path") input: String
    #Doc("write the report to this file") output: ?String
}

fn field_text(bytes: [U8], start: Int, width: Int) String -> {
    value := [U8]{}
    loop i in 0..<width {
        byte :: bytes.get(start + i) ?? 0
        if byte == 0 -> break
        value.push(byte)
    }
    return String.from_bytes_lossy(value)
}

fn valid_field(bytes: [U8], start: Int, width: Int) Bool -> {
    i := 0
    loop i < width {
        first :: bytes.get(start + i) ?? return false
        if first == 0 -> return true
        count := 0
        code := 0
        if first < 128 {
            count = 1
            code = Int.from_u8(first)
        } else if first >= 194 && first <= 223 {
            count = 2
            code = Int.from_u8(first) - 192
        } else if first >= 224 && first <= 239 {
            count = 3
            code = Int.from_u8(first) - 224
        } else if first >= 240 && first <= 244 {
            count = 4
            code = Int.from_u8(first) - 240
        } else { return false }
        if i + count > width -> return false
        loop j in 1..<count {
            next_byte :: bytes.get(start + i + j) ?? return false
            if next_byte < 128 || next_byte > 191 -> return false
            code = code * 64 + Int.from_u8(next_byte) - 128
        }
        if (count == 3 && code < 2048) || (count == 4 && code < 65536) || code > 1114111 || (code >= 55296 && code <= 57343) {
            return false
        }
        i += count
    }
    return true
}

fn number_field(bytes: [U8], start: Int, width: Int) Int -> {
    first :: bytes.get(start) ?? return -1
    if first >= 128 {
        value := Int.from_u8(first) - 128
        loop i in 1..<width {
            byte :: bytes.get(start + i) ?? return -1
            value = value * 256 + Int.from_u8(byte)
        }
        return value
    }
    value := 0
    seen := false
    loop i in 0..<width {
        byte :: bytes.get(start + i) ?? return -1
        if byte == 0 || byte == 32 {
            if seen -> break
            next
        }
        if byte < 48 || byte > 55 -> return -1
        seen = true
        value = value * 8 + Int.from_u8(byte) - 48
    }
    return value
}

fn checksum_ok(bytes: [U8], offset: Int) Bool -> {
    stored :: number_field(bytes, offset + 148, 8)
    if stored < 0 -> return false
    sum := 0
    loop i in 0..<512 {
        byte :: bytes.get(offset + i) ?? return false
        if i >= 148 && i < 156 -> sum += 32 else -> sum += Int.from_u8(byte)
    }
    return stored == sum
}

fn zero_block(bytes: [U8], offset: Int) Bool -> {
    loop i in 0..<512 {
        byte :: bytes.get(offset + i) ?? return false
        if byte != 0 -> return false
    }
    return true
}

fn zero_tail(bytes: [U8], offset: Int) Bool -> {
    loop i in offset..<bytes.len() {
        byte :: bytes.get(i) ?? return false
        if byte != 0 -> return false
    }
    return true
}

fn safe_path(path: String) Bool -> {
    if path == "" || path.starts_with("/") || path.starts_with("\\") -> return false
    path_bytes :: path.bytes()
    if path_bytes.len() > 1 && path_bytes[1] == 58 -> return false
    normalized :: path.replace("\\", "/")
    loop component in normalized.split("/") {
        if component == ".." -> return false
    }
    return true
}

fn glob_match(pattern: String, path: String) Bool -> {
    p :: pattern.bytes()
    s :: path.bytes()
    pattern_index := 0
    path_index := 0
    star := -1
    star_match := 0
    loop path_index < s.len() {
        if pattern_index < p.len() {
            pattern_byte :: p[pattern_index]
            if pattern_byte == 63 || pattern_byte == s[path_index] {
                pattern_index += 1
                path_index += 1
                next
            }
            if pattern_byte == 42 {
                star = pattern_index
                pattern_index += 1
                star_match = path_index
                next
            }
        }
        if star >= 0 {
            pattern_index = star + 1
            star_match += 1
            path_index = star_match
            next
        }
        return false
    }
    loop pattern_index < p.len() && p[pattern_index] == 42 -> pattern_index += 1
    return pattern_index == p.len()
}

fn entry_kind(tag_byte: U8) String -> {
    if tag_byte == 0 || tag_byte == 48 -> return "file"
    if tag_byte == 49 -> return "hardlink"
    if tag_byte == 50 -> return "symlink"
    if tag_byte == 51 -> return "char"
    if tag_byte == 52 -> return "block"
    if tag_byte == 53 -> return "directory"
    if tag_byte == 54 -> return "fifo"
    if tag_byte == 55 -> return "reserved"
    return ""
}

fn run(args: WorkloadArgs) {
    if args.format != "tar" && args.format != "ustar" {
        print("error=unsupported-format")
        return
    }
    if args.max_size < 0 || args.max_entries < 0 {
        print("error=invalid-limit")
        return
    }
    raw :: fs.read_bytes(args.input) ?? panic("read input")
    // Keep core.archive on the same byte path as the explicit metadata parser.
    // Its canonical name reader is a cross-check for archives with no rejects.
    core_names :: archive.tar_names_json(raw)
    rows := [String]{}
    seen := [String:Int]{}
    offset := 0
    entries := 0
    accepted := 0
    bytes := 0
    rejected := 0
    traversal := 0
    duplicates := 0
    malformed := 0
    oversize := 0
    limited := 0
    terminated := false
    loop offset < raw.len() {
        if raw.len() - offset < 512 {
            malformed += 1
            rejected += 1
            break
        }
        if zero_block(raw, offset) {
            if !zero_tail(raw, offset) {
                malformed += 1
                rejected += 1
            } else { terminated = true }
            break
        }
        entries += 1
        if !checksum_ok(raw, offset) {
            malformed += 1
            rejected += 1
            offset += 512
            next
        }
        if !valid_field(raw, offset + 257, 6) {
            malformed += 1
            rejected += 1
            offset += 512
            next
        }
        magic :: field_text(raw, offset + 257, 6)
        if (args.format == "ustar" && !magic.starts_with("ustar")) || (magic != "" && !magic.starts_with("ustar")) {
            malformed += 1
            rejected += 1
            offset += 512
            next
        }
        size :: number_field(raw, offset + 124, 12)
        if size < 0 {
            malformed += 1
            rejected += 1
            offset += 512
            next
        }
        padded :: ((size + 511) /% 512) * 512
        next_offset :: offset + 512 + padded
        if next_offset > raw.len() {
            if size > args.max_size {
                oversize += 1
                rejected += 1
            } else {
                malformed += 1
                rejected += 1
            }
            break
        }
        if size > args.max_size {
            oversize += 1
            rejected += 1
            offset = next_offset
            next
        }
        if !valid_field(raw, offset, 100) || !valid_field(raw, offset + 345, 155) {
            malformed += 1
            rejected += 1
            offset = next_offset
            next
        }
        name :: field_text(raw, offset, 100)
        prefix :: field_text(raw, offset + 345, 155)
        if name == "" || (raw.get(offset) ?? 0) == 0 {
            malformed += 1
            rejected += 1
            offset = next_offset
            next
        }
        path :: if prefix == "" -> name else -> "{prefix}/{name}"
        if !safe_path(path) {
            traversal += 1
            rejected += 1
            offset = next_offset
            next
        }
        if seen.has_key(path) {
            duplicates += 1
            rejected += 1
            offset = next_offset
            next
        }
        seen[path] = 1
        if entries > args.max_entries {
            limited += 1
            rejected += 1
            offset = next_offset
            next
        }
        type_byte :: raw.get(offset + 156) ?? 0
        kind :: entry_kind(type_byte)
        if kind == "" {
            malformed += 1
            rejected += 1
            offset = next_offset
            next
        }
        if glob_match(args.filter, path) {
            rows.push("path={path}|type={kind}|size={size}")
            accepted += 1
            bytes += size
        }
        offset = next_offset
    }
    if !terminated && offset >= raw.len() {
        malformed += 1
        rejected += 1
    }
    if terminated && rejected == 0 && entries > 0 && core_names == "" {
        malformed += 1
        rejected += 1
    }
    rows.sort()
    report := [String]{
        "format={args.format}",
        "entries={entries}",
        "accepted={accepted}",
        "bytes={bytes}",
        "rejected={rejected}",
        "traversal={traversal}",
        "duplicates={duplicates}",
        "malformed={malformed}",
        "oversize={oversize}",
        "limited={limited}"
    }
    report.extend(rows)
    text := ""
    loop line in report -> text = "{text}{line}\n"
    if args.output == .None {
        loop line in report -> print(line)
    } else {
        output :: ~args.output ?? ""
        fs.write(output, text) ?? panic("write output")
    }
}
