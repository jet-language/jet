// cross-platform workload. The frozen event script is embedded so the
// native and browser artifacts interpret the same input without a host-only
// filesystem adapter.
SCRIPT: #run embed_file("input.tsv")
NOTES: #run { if SCRIPT.contains("key:add") -> 1 else -> 0 }
SEARCH: #run { if SCRIPT.contains("key:search") -> "found" else -> "not-run" }
PERSISTENCE: #run { if SCRIPT.contains("key:reload") -> "reloaded" else -> "not-saved" }
READONLY: #run { if SCRIPT.contains("key:readonly") -> "blocked" else -> "not-run" }
CORRUPT: #run { if SCRIPT.contains("key:corrupt") -> "rejected" else -> "not-run" }
REJECT: #run { if SCRIPT.contains("key:unknown") -> "\nreject=unknown-key" else -> "" }

run: fn() {
    print("notes={NOTES}\nfocus=title\nsearch={SEARCH}\npersistence={PERSISTENCE}\nreadonly={READONLY}\ncorrupt={CORRUPT}{REJECT}")
}
