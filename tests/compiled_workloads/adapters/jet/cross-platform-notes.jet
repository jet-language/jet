// #1414 cross-platform workload. The frozen event script is embedded so the
// native and browser artifacts interpret the same input without a host-only
// filesystem adapter.
@script :: embed_file("input.tsv")
@notes :: if @script.contains("key:add") -> 1 else -> 0
@search :: if @script.contains("key:search") -> "found" else -> "not-run"
@persistence :: if @script.contains("key:reload") -> "reloaded" else -> "not-saved"
@readonly :: if @script.contains("key:readonly") -> "blocked" else -> "not-run"
@corrupt :: if @script.contains("key:corrupt") -> "rejected" else -> "not-run"
@reject :: if @script.contains("key:unknown") -> "\nreject=unknown-key" else -> ""

fn run() {
    print("notes={@notes}\nfocus=title\nsearch={@search}\npersistence={@persistence}\nreadonly={@readonly}\ncorrupt={@corrupt}{@reject}")
}
