// #1414 systems workload: walk the supplied directory without following
// symlinks, then hash every readable regular file.
use core.crypto as crypto
use core.files as fs

#CLI
struct WorkloadArgs {
    input: String
}

fn run(args: WorkloadArgs) {
    root :: args.input
    entries :: fs.walk(root) ?? panic("cannot walk input root")
    rows := [String]{}
    links := 0
    rejects := 0
    bytes := 0
    loop entry in entries {
        if entry.is_dir -> next
        if entry.relative == ".fixture-modes.tsv" -> next
        stat :: fs.stat(entry.path) ?? {
            rejects += 1
            next
        }
        if stat.is_symlink {
            links += 1
            next
        }
        if !stat.is_file {
            rejects += 1
            next
        }
        content :: fs.read_bytes(entry.path) ?? {
            rejects += 1
            next
        }
        relative :: entry.relative.replace("\\", "/")
        digest :: crypto.sha256(content).hex()
        rows.push("file|{relative}|{content.len()}|{digest}")
        bytes += content.len()
    }
    rows.sort()
    canonical := ""
    loop row in rows -> canonical = "{canonical}{row}\n"
    index_hash :: crypto.sha256(canonical.bytes()).hex()
    print("files={rows.len()}")
    print("bytes={bytes}")
    print("links={links}")
    print("rejects={rejects}")
    print("index_sha256={index_hash}")
    loop row in rows -> print(row)
}
