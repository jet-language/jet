# D-HTTP-BYTES-FORM1=A (#5976 c39): every tolerant `query_decode` and
# `form_decode` call outside Core carries the L0208 advisory with a
# needs-review edit to its strict sibling. `jet check` shows it as a warning
# and still passes, `jet fix` lists each call for review and changes nothing,
# and `jet fix --all` writes the strict call where it type-checks and rolls it
# back where the caller leaves the FormDecodeError unhandled.
fixture: jet_fix_lists_tolerant_decodes_for_review.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 0
stderr: count "Warning [jet.TolerantFormDecode]" = 2 # both tolerant calls are flagged, and the check passes
step: jet check run.jet --json
exit: 0
json: stdout doc $.reports[?code="L0208"] #= 2
json: stdout doc $.reports[?code="L0208"][?applicability="suggested"] #= 2
json: stdout doc $.reports[?code="L0208"][0].fix_edits[?safety="needs-review"] #= 1
step: jet fix run.jet
exit: 0
stderr: ~ "no changes made (2 suggestions need review)" # both calls are listed
file: run.jet ~ "http.form_decode(body)" # nothing is applied without --all
file: run.jet ~ "http.query_decode(body)" # the field decode is unchanged too
step: jet fix run.jet --all
exit: 0
file: run.jet ~ "http.form_decode_strict(body)" # the account decode moves to strict
file: run.jet ~ "http.query_decode(body)" # the field decode would not check, so it stays
step: jet run run.jet
exit: 0
stdout: = "Ann\nOslo\n"
