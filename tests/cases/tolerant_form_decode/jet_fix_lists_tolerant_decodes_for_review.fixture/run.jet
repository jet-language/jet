use {
    http: core.http
    core.http.[FormDecodeError, Query, query_get]
}

// The value picks an account, so it belongs on the strict sibling; the edit
// type-checks here because the function already returns FormDecodeError.
account: fn(body: String) -> Query FormDecodeError! { http.form_decode(body) }

// An ordinary form field: the strict call would leave its error unhandled.
city: fn(body: String) -> String { query_get(http.query_decode(body), "city") ?? "" }

run: fn() {
    print(query_get(account("name=Ann") ?? panic("decode"), "name") ?? "")
    print(city("city=Oslo"))
}
