
use {
    reactive: core.reactive
    tasks: core.tasks
}
run: fn() {
    base := reactive.signal(1)
    twice := reactive.computed(() -> (base.get() * 2))
    { sender: tx, receiver: rx }: channel<Computed<Int>>()
    tx.send(twice.copy())
    got: rx.receive() ?? panic("recv")
    print(got.get())
}
