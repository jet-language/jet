
struct Particle { position: Int, velocity: Int }

fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3}, {position: 30, velocity: 4} }
        task.group outer {
        left :: &particles[0]
        a :: task {
            left.position += 1
            left.position
        }
        task.group inner {
            right :: &particles[2]
            b :: task {
                right.position += 1
                right.position
            }
        }
    }
}
