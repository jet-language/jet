
struct Particle { position: Int, velocity: Int }

fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3}, {position: 30, velocity: 4} }
        task.group g {
        left :: &particles[0]
        right :: &particles[2]
        a :: task {
            left.position += left.velocity
            left.position
        }
        b :: task {
            right.position += right.velocity
            right.position
        }
    }
}
