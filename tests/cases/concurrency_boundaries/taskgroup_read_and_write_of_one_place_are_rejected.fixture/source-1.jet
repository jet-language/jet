
struct Particle { position: Int, velocity: Int }

fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        task.group g {
        writer :: &particles[0]
        reader :: particles[0..1]
        a :: task {
            writer.position += 1
            writer.position
        }
        b :: task reader[0].position
    }
}
