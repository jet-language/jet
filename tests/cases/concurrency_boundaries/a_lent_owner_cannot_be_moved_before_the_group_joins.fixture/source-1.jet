
Particle: struct { position: Int, velocity: Int }

eat: fn(ps: &&[Particle]) -> Int { ps.len() }
run: fn() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        task.group g {
        left: &particles[0]
        a: task {
            left.position += left.velocity
            left.position
        }
        n: eat(particles)
        print(n)
    }
}
