missing: fn(path: String) -> (receipt: Int?, error: IOError?) {
    (receipt: None, error: Val(IOError.NotFound(IOContext{operation: .Resolve, resource: Val(path), os_code: None, cause: None})))
}

resource: fn(error: IOError) -> String {
    if error == {
        .NotFound(context) -> context.resource ?? "no resource"
        else -> "another error"
    }
}

run: fn() {
    task.group pool(limit: 2) {
        handles: loop name in ["a.txt", "b.txt"] -> task missing(name)
        loop handle in handles {
            outcome: ^handle.join() ?? (receipt: None, error: None)
            if outcome.error == {
                .Val(error) -> print(resource(error))
                .None -> print("cancelled")
            }
        }
    }
}
