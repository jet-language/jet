# What the detach and freeze rules accept, on every tier: a detached task may
# read a frozen snapshot, a merge where one path is not frozen may be written
# after it, and freezing a frozen value is the identity.
fixture: detach_and_freeze_keep_their_ratified_rules.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check accepted.jet
exit: 0
step: jet run --optimize=none accepted.jet
exit: 0
stdout: = "launched\n3\n7\n"
step: jet run --optimize=basic accepted.jet
exit: 0
stdout: = "launched\n3\n7\n"
step: jet run --optimize=full accepted.jet
exit: 0
stdout: = "launched\n3\n7\n"
