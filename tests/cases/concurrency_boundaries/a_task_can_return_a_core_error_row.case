# A task returns a compiler-owned Core row (IOError) inside its result: the row is
# sendable when every payload part is (D-CORE-PROCPOOL1). Before the
# fix this was E1102 "no registered ownership facts for `IOError`".
fixture: a_task_can_return_a_core_error_row.fixture
env: NO_COLOR=1
step check1: jet check source-1.jet --json
exit: 0
step run1: jet run source-1.jet
exit: 0
stdout: = a_task_can_return_a_core_error_row.out
