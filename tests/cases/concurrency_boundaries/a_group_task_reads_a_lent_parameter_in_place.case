# A task in a `task.group` that reads a read parameter of sendable type borrows
# it until the join, so the task reads the caller's storage in place instead
# of a deep copy of it: the children sum the right total and see the owner's
# address on every tier.
fixture: a_group_task_reads_a_lent_parameter_in_place.fixture
env: NO_COLOR=1
step check: jet check lend.jet
exit: 0
step lend_o0: jet run -O0 lend.jet
exit: 0
stdout: = "a read parameter passes its place: true\na child reads the owner's graph in place: true\nsum 41290\n"
step lend_o1: jet run -O1 lend.jet
exit: 0
stdout: = "a read parameter passes its place: true\na child reads the owner's graph in place: true\nsum 41290\n"
step lend_o2: jet run -O2 lend.jet
exit: 0
stdout: = "a read parameter passes its place: true\na child reads the owner's graph in place: true\nsum 41290\n"
