
fn classify(tree: DataTree) -> String {
    if tree == {
        .Object(entries) -> { return "object:{entries.len()}" }
        .Int(_) -> { return "int" }
        else -> { return "other" }
    }
}
fn run() {
    print(classify(DataTree.Object(["a": DataTree.Int(7)])))
    print(classify(DataTree.Int(3)))
    print(classify(DataTree.Text("x")))
}
