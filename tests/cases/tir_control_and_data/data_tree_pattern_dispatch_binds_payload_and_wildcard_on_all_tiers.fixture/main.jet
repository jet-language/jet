
fn classify(tree: Dyn) -> String {
    if tree == {
        .Object(entries) -> { return "object:{entries.len()}" }
        .Int(_) -> { return "int" }
        else -> { return "other" }
    }
}
fn run() {
    print(classify(Dyn.Object(["a": Dyn.Int(7)])))
    print(classify(Dyn.Int(3)))
    print(classify(Dyn.Text("x")))
}
