fn label(n: Int) -> String {
    if ((n % 15) == 0) {
        return "FizzBuzz"
    } else if ((n % 3) == 0) {
        return "Fizz"
    } else if ((n % 5) == 0) {
        return "Buzz"
    }
    return "{n}"
}
fn run() {
    print(label(3))
    print(label(5))
    print(label(15))
    print(label(7))
}
