
fn nested_return_if(value: DataTree, right: DataTree) -> Bool Never! {
    return if value == {
        .Text(left_text) -> {
            return if right == {
                .Text(right_text) -> left_text == right_text
                else -> false
            }
        }
        else -> true
    }
}

fn run() {
    print(nested_return_if(DataTree.Null, DataTree.Null))
}
