use {
    jet_foundation.[Diagnostic]
    jet_lexer.[lex, lex_payload, token_decimal, token_decoded, token_integer, token_string_parts, token_suffix, token_text]
}

span_start: fn(diagnostic: Diagnostic) -> Int {
    (diagnostic.span ?? return -1).start
}

span_end: fn(diagnostic: Diagnostic) -> Int {
    (diagnostic.span ?? return -1).end
}

run: fn() {
    result: lex_payload("Name 500ms 1.25 true \"ok\" 'x'".bytes(), false)
    tables: result.tables
    print(result.tokens[0].kind)
    print(token_text(tables, result.tokens[0]))
    print(result.tokens[1].kind)
    print(token_integer(tables, result.tokens[1]) ?? -1)
    print(token_suffix(tables, result.tokens[1]))
    print(result.tokens[2].kind)
    print(token_decimal(tables, result.tokens[2]) ?? Float{0})
    print(result.tokens[3].kind)
    print(result.tokens[4].kind)
    print(token_decoded(tables, result.tokens[4]))
    print(result.tokens[5].kind)
    print(token_decoded(tables, result.tokens[5]))
    print(result.tokens[6].kind)
    print(result.diagnostics.len())
    interpolated: lex_payload("\"a{{value + 1}}b\"".bytes(), false)
    parts: token_string_parts(interpolated.tables, interpolated.tokens[0])
    print(parts.len())
    print(parts[0].kind)
    print(parts[1].kind)
    print(parts[1].tokens.len())
    print(parts[1].tokens[0].span.start)
    print(parts[1].tokens[3].kind)
    print(parts[1].tokens[3].span.start)
    terminated: lex("fn f() {{\n    value\n}}".bytes())
    print(terminated.tokens[6].kind)
    print(terminated.tokens[6].span.start)
    print(terminated.tokens[6].span.end)
    bad: lex_payload("§§".bytes(), false)
    print(bad.diagnostics.len())
    print(span_start(bad.diagnostics[0]))
    print(span_start(bad.diagnostics[1]))
    // Since D-TEACH-RECONCILE1=A the lexer reads `r"bad"` as a name and a
    // string and teaches no foreign string prefix.
    prefix: lex_payload("r\"bad\"".bytes(), false)
    print(prefix.diagnostics.len())
}
