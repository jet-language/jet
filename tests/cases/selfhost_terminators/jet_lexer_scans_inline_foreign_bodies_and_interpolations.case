# PORT tests/selfhost_terminators.rs:504-528.
# The fixture depends on this checkout's JetLexer and JetFoundation packages, copied into a toolchain
# tree (Core, Compiler/Prelude and the compiler workspace) that the toolchain root resolves to, so
# JetFoundation's `toolchain:` inputs read the copied tree.
fixture: jet_lexer_scans_inline_foreign_bodies_and_interpolations.fixture
copy: {root}/Core tree/Core
copy: {root}/Compiler/Prelude tree/Compiler/Prelude
copy: {root}/Compiler/package.jet tree/Compiler/package.jet
copy: {root}/Compiler/JetFoundation tree/Compiler/JetFoundation
copy: {root}/Compiler/JetLexer tree/Compiler/JetLexer
step: jet run tree/app/main.jet
unset: JET_TOOLCHAIN_ROOT
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
exit: 0
stdout: = jet_lexer_scans_inline_foreign_bodies_and_interpolations.fixture/expected.out
