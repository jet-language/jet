
#Error TextError: enum { Bad }

Pattern: distinct String

impl Pattern.CheckedText {
    Error: TextError

    check: fn(text: String) TextError! -[]> {
        if text == "" { return Err(TextError.Bad) }
        return Ok(())
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return "{value}"
    }
}


Envelope: struct<T> {
    value: T
}

run: fn() {
    plain: "plain"
    envelope: Envelope<Pattern>{ value: plain }
}
