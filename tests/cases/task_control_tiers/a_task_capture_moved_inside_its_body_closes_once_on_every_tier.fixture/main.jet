Guard: struct {
    tag: String
    impl Close {
        close: fn(&&self) -[IO]> { print("close {self.tag}") }
    }
}

keep: fn(g: &&Guard) -> Int { g.tag.len() }

run: fn() {
    held := Guard{tag: "plain held"}
    held_task: task &&held { 1 }
    print(held_task.join() ?? panic("plain held task failed"))

    called := Guard{tag: "plain call"}
    called_task: task &&called { keep(called) }
    print(called_task.join() ?? panic("plain call task failed"))

    bound := Guard{tag: "plain binding"}
    bound_task: task &&bound {
        mine: bound
        mine.tag.len()
    }
    print(bound_task.join() ?? panic("plain binding task failed"))

    rebound := Guard{tag: "plain rebinding"}
    rebound_task: task &&rebound {
        again := rebound
        again.tag.len()
    }
    print(rebound_task.join() ?? panic("plain rebinding task failed"))

    group_held := Guard{tag: "group held"}
    group_called := Guard{tag: "group call"}
    group_bound := Guard{tag: "group binding"}
    group_rebound := Guard{tag: "group rebinding"}
    task.group moved {
        first: task &&group_held { 1 }
        print(first.join() ?? panic("group held task failed"))
        second: task &&group_called { keep(group_called) }
        print(second.join() ?? panic("group call task failed"))
        third: task &&group_bound {
            mine: group_bound
            mine.tag.len()
        }
        print(third.join() ?? panic("group binding task failed"))
        fourth: task &&group_rebound {
            again := group_rebound
            again.tag.len()
        }
        print(fourth.join() ?? panic("group rebinding task failed"))
    }
    print("end")
}
