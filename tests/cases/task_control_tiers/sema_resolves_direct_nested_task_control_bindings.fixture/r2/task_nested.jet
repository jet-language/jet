
use time: core.time

slow_one: fn() -> Int {
    time.sleep(100ms)
    return 1
}

slow_three: fn() -> Int {
    time.sleep(100ms)
    return 3
}

run: fn() {
    task.group workers {
        nested: task.all {
            task.race { slow_one(), 2 } ?? 0,
            task.any { slow_three(), 4 } ?? 0
        } ?? []
        print(nested)
    }
}
