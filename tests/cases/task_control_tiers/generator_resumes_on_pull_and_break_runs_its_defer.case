# A generator resumes only on its consumer's
# pull (each "resumed" line follows the consumer's "got" line), and a consumer
# `break` cancels the producer at its yield: its `defer` runs before the loop
# is left, and the code after that yield never runs. Every tier and the AOT
# binary print the same transcript.
fixture: generator_resumes_on_pull_and_break_runs_its_defer.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = generator_resumes_on_pull_and_break_runs_its_defer.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = generator_resumes_on_pull_and_break_runs_its_defer.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = generator_resumes_on_pull_and_break_runs_its_defer.1.out
stderr: = ""
step: jet build main.jet
exit: 0
step aot: {work}/.jet/build/main
exit: 0
stdout: = generator_resumes_on_pull_and_break_runs_its_defer.1.out
