# Carriers come from the link shape, at O0, O1 and O2. `pure` links
# no C: the runtime starts its carriers itself (Thread.jet raw clone), its
# 64 tasks run off the main thread, and the image names no pthread symbol.
# `linked` links a C closure: its carriers come from that closure's libc
# (the musl startup hands pthread_create to the runtime, Thread.jet
# jet_rt_thread_libc), so two tasks held in C at once read two pthread_self
# values, both apart from the main thread's (a raw clone reads the main
# thread s).
fixture: carriers_come_from_the_runtime_or_from_the_c_closures_libc.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=4
step: jet build -O0 main.jet
cwd: pure
exit: 0
step o0_pure: built
cwd: pure
timeout: 60s
exit: 0
stdout: = "64 tasks joined, ran off the main thread true\n"
file: pure/.jet/build/main !~ "pthread_" # the runtime object asks libc for no pthread symbol
step: jet build -O0 main.jet
cwd: linked
exit: 0
step o0_linked: built
cwd: linked
timeout: 60s
exit: 0
stdout: = "met 2\nlibc carriers true\n"
step: jet build -O1 main.jet
cwd: pure
exit: 0
step o1_pure: built
cwd: pure
timeout: 60s
exit: 0
stdout: = "64 tasks joined, ran off the main thread true\n"
file: pure/.jet/build/main !~ "pthread_" # the runtime object asks libc for no pthread symbol
step: jet build -O1 main.jet
cwd: linked
exit: 0
step o1_linked: built
cwd: linked
timeout: 60s
exit: 0
stdout: = "met 2\nlibc carriers true\n"
step: jet build --release main.jet
cwd: pure
exit: 0
step o2_pure: built
cwd: pure
timeout: 60s
exit: 0
stdout: = "64 tasks joined, ran off the main thread true\n"
file: pure/.jet/build/main !~ "pthread_" # the runtime object asks libc for no pthread symbol
step: jet build --release main.jet
cwd: linked
exit: 0
step o2_linked: built
cwd: linked
timeout: 60s
exit: 0
stdout: = "met 2\nlibc carriers true\n"
