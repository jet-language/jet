# Port of tests/dev_parts/routine.rs:797-841. Sources verbatim; ORACLE-LITERAL original predicates.
# Runtime PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four) where used.
# The session waits for each run's output instead of sleeping a fixed time, so a
# slow rebuild is waited for. A recv reads its part of stdout, so the stdout
# predicates apply to each part they cover.
fixture: watching_dev_deopts_on_gap_edit_and_recovers.fixture
env: NO_COLOR=1
session app raw: jet dev app.jet
recv app until ~ "ok1" timeout 30s # the first build runs before the edit
stdout: ~ "ok1" # original first execution predicate
stdout: !~ "E2211" # original retired-diagnostic predicate
write: app.jet watching_dev_deopts_on_gap_edit_and_recovers.gap.template
sleep: 800ms
write: app.jet watching_dev_deopts_on_gap_edit_and_recovers.final.template
recv app until ~ "ok2" timeout 30s # the recovered build runs before the kill
stdout: !~ "E2211" # original retired-diagnostic predicate
stdout: ~ "ok2" # original recovered execution predicate
signal app: KILL
close app
exit: any # original status unasserted after intentional child.kill
stdout: !~ "E2211" # original retired-diagnostic predicate
stderr: !~ "E2211" # original retired-diagnostic predicate
