use tasks: core.tasks
run: fn() {
    { sender, receiver: ch }: channel<Int>()
    { sender: ack_sender, receiver: ack }: channel<Int>()
    slow: task {
               #Shield {
                   value: ch.receive() ?? panic("closed")
                   print(value)
                   ack_sender.send(1)
               }
               print(99)
       }
    slow.cancel()
    slow.detach()
    sender.send(42)
    _ := ack.receive() ?? panic("closed")
}
