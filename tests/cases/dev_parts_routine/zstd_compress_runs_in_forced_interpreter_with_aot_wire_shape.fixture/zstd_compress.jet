use core.archive.zstd as zstd

fn run() {
    frame :: zstd.compress([72, 101, 108, 108, 111]) ?? panic("compress")
    m0 :: U8{ 40 }
    m1 :: U8{ 181 }
    m2 :: U8{ 47 }
    m3 :: U8{ 253 }
    print(frame.len() > 9)
    print(frame[0] == m0 && frame[1] == m1 && frame[2] == m2 && frame[3] == m3)
}
