# tests/dev_parts/routine.rs::data_schema_empty_and_generic_rows_report_jit_gap_on_default_dev at tests/dev_parts/routine.rs:41; hand-port (the example declares its inline package, so the case adds none)
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
copy: {root}/Examples/features/tooling/data_json.jet data_json.jet
step check: jet check data_json.jet
exit: any # original assert_default_run_or_named_boundary accepts a run or a named dev boundary
stderr: !~ "E2211" # original predicate: problems never name the retired E2211
when exit != 0: stderr: ~any "E2202" "E0952" "E0956" "E0953" "E3410" "E3411" "E3412" "E1265" "E0102" "E0857" "E0107" "E0501" "E0308" "E0504" "E0302" "E0505" "E0915" "E0311" "E1004" # original predicate: is_named_dev_boundary (some diagnostic carries a BOUNDARY_CODES code)
step run: jet run data_json.jet
stdin: null
exit: any # original predicate: RunOutcome::Ran passes whatever the program exits
