
#Post(result > 0, "post sees the successful payload")
counted: fn(value: Int) -> Int {
    print("body:{value}")
    if value > 0 {
        return value
    }
    return Err("sentinel")
}

run: fn() {
    if counted(7) == {
        .Ok(value) -> print("good:{value}")
        .Err(error) -> print("good-error:{error.message}")
    }
    if counted(0) == {
        .Ok(value) -> print("bad:{value}")
        .Err(error) -> print("bad-error:{error.message}")
    }
}
