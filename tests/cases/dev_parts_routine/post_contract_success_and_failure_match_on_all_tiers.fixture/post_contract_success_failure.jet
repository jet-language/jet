
#Post(result > 0, "post sees the successful payload")
counted: fn(value: Int) -> Int {
    print("body:{value}")
    if value > 0 {
        return value
    }
    return Err("sentinel")
}

run: fn() {
    counted(7) ? value -> print("good:{value}") ! error -> print("good-error:{error.message}")
    counted(0) ? value -> print("bad:{value}") ! error -> print("bad-error:{error.message}")
}
