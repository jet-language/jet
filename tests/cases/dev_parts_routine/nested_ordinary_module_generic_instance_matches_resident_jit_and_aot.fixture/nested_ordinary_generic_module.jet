
outer: module<T>(n: Int) {
    plain: module {
        inner: module<U> { total: fn(value: U) -> Int { return n } }
        closed: inner<T>
        result: fn(value: T) -> Int { return closed.total(value) }
    }
    result: fn(value: T) -> Int { return plain.result(value) }
}
selected: outer<Int>(6)
run: fn() { print(selected.result(1)) }
