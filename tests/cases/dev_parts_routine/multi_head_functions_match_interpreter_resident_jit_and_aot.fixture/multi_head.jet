Shape: enum {
    Circle(Float)
    Rect(left_1: Float, right_1: Float)
}
area: fn(Circle(r: Float)) -> Float { return r * r }
area: fn(Rect(left_1: Float, right_1: Float)) -> Float { return left_1 * right_1 }
run: fn() {
    print(area(Shape.Circle(3.0)))
    print(area(.Rect{ left_1: 2.0, right_1: 4.0 }))
}
