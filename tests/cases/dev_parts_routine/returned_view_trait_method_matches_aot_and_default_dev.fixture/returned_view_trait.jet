Select: trait {
    select: fn(self, left: [Int], right: [Int]) -> View<Int>
}

First: struct {
    marker: Int

    impl Select {
        select: fn(self, left: [Int], right: [Int]) -> View<Int> {
            return left[0..1]
        }
    }
}
wrapper: fn(selector: First, left: [Int], right: [Int]) -> View<Int> {
    return selector.select(left, right)
}

run: fn() {
    selector: First{ marker: 0 }
    left := [7, 8]
    right := [9, 10]
    result: wrapper(selector, left, right)
    print(result[0])
}
