
F32_NAN :: prep { F32.NAN }
F32_INF :: prep { F32.INFINITY }
F32_NEG_INF :: prep { F32.NEG_INFINITY }
F64_NAN :: prep { Float.NAN }
F64_INF :: prep { Float.INFINITY }
F64_NEG_INF :: prep { Float.NEG_INFINITY }

