
F32_NAN :: comptime { F32.NAN }
F32_INF :: comptime { F32.INFINITY }
F32_NEG_INF :: comptime { F32.NEG_INFINITY }
F64_NAN :: comptime { Float.NAN }
F64_INF :: comptime { Float.INFINITY }
F64_NEG_INF :: comptime { Float.NEG_INFINITY }

fn run() {
    print(F32_NAN)
    print(F32_INF)
    print(F32_NEG_INF)
    print(F64_NAN)
    print(F64_INF)
    print(F64_NEG_INF)
}
