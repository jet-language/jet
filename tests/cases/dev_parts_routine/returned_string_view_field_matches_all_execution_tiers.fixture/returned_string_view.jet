Parsed: struct { source: String, head: View<str> }

parse: fn(source: String) -> Parsed {
    head: source.before(":")
    return Parsed{ source: source, head: head }
}

run: fn() {
    left := "name"
    right := "value"
    source := "{left}:{right}"
    result: parse(source)
    print(result.head)
    print("wrapped: {result.head}")
    expected: "name"
    print("wrapped: {expected}")
}
