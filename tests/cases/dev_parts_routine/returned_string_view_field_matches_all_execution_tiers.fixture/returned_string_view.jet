struct Parsed { source: String, head: View<str> }

fn parse(source: String) -> Parsed {
    head :: source.before(":")
    return Parsed{ source: source, head: head }
}

fn run() {
    left := "name"
    right := "value"
    source := "{left}:{right}"
    result :: parse(source)
    print(result.head)
    print("wrapped: {result.head}")
    expected :: "name"
    print("wrapped: {expected}")
}
