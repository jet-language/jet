enum Pair {
    Values(left: Int, right: Int)
    Empty
}
fn classify(pair: Pair) -> String {
    if pair == {
        .Values(_, 10..19) -> { return "range" }
        .Values(_, _) -> { return "other" }
        .Empty -> { return "empty" }
    }
    return "unknown"
}
fn run() {
    print(classify(.Values{ left: 1, right: 15 }))
    print(classify(.Values{ left: 1, right: 25 }))
}
