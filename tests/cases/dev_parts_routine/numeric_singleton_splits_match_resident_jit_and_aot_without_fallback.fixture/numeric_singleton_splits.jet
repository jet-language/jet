
fn run() {
    values := [1.5, 2.5, 3.5]
    first :: &values[0]
    last :: &values[2]
    first = 4.5
    last = 6.5
    first += 1.25
    last += 0.25
    print(first)
    print(last)
    print(values[0])
    print(values[2])

    counts := [1, 2, 3]
    low :: &counts[0]
    high :: &counts[2]
    low += 4
    high += 6
    low = low.bit_and(6)
    low <<= 1
    high = high.bit_xor(10)
    high = high.bit_or(8)
    print(low)
    print(high)
    print(counts[0])
    print(counts[2])
}
