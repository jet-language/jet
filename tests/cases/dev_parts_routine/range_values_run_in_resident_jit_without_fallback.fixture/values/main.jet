
identity: fn(band: &&Range) -> Range {
    return band.copy()
}
run: fn() {
    band: 2..<5
    copied: identity(band.copy())
    print(copied == band)
    bands: [1..3, 8..<10]
    print(bands[0])
    print("{bands[1]:Debug}")
    print(bands[0].contains(3))
    print(band)
    print("{band}")
    print("{band:Debug}")
    print(band == (2..<5))
    print(band == (2..5))
    print(band.start)
    print(band.end)
    print(band.contains(4))
    // A literal `5..2` is E0170, so the descending range is built from values.
    high: 5
    low: 2
    print((high..low).contains(3))
    total := 0
    loop n in band {
        total += n
    }
    print(total)
    values := [10, 20, 30, 40, 50, 60]
    print(values[band].copy())
    edit: &values[band]
    edit[0] = 99
    print(values)
}
