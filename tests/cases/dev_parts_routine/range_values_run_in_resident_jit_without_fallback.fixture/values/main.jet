
fn identity(band: ^Range) -> Range {
    return band
}
fn run() {
    band :: 2..<5
    copied :: identity(band)
    print(copied == band)
    bands :: [1..3, 8..<10]
    print(bands[0])
    print("{bands[1]:Debug}")
    print(bands[0].contains(3))
    print(band)
    print("{band}")
    print("{band:Debug}")
    print(band == (2..<5))
    print(band == (2..5))
    print(band.start)
    print(band.end)
    print(band.contains(4))
    print((5..2).contains(3))
    total := 0
    loop n in band {
        total += n
    }
    print(total)
    values := [10, 20, 30, 40, 50, 60]
    print(values[band].copy())
    edit :: &values[band]
    edit[0] = 99
    print(values)
}
