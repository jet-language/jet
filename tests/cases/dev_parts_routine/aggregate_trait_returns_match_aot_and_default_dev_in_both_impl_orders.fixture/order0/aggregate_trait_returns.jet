Pair: struct { left: View<Int>, right: View<Int> }
Envelope: struct<T> { value: T, marker: Int }

Select: trait {
    select: fn(self, left: [Int], right: [Int]) -> Pair
    optional: fn(self, left: [Int], right: [Int]) -> (Pair?)
    fallible: fn(self, left: [Int], right: [Int]) -> Pair String!
    tupled: fn(self, left: [Int], right: [Int]) -> (pair: Pair, count: Int)
    generic: fn(self, left: [Int], right: [Int]) -> Envelope<Pair>
}

wrapper: fn(selector: First, left: [Int], right: [Int]) -> Pair {
    return selector.select(left, right)
}

First: struct { marker: Int }
impl First.Select {
    select: fn(self, left: [Int], right: [Int]) -> Pair {
        left_view: left[0..1]
        right_view: right[0..1]
        return Pair{ left: left_view, right: right_view }
    }
    optional: fn(self, left: [Int], right: [Int]) -> (Pair?) {
        left_view: left[0..1]
        right_view: right[0..1]
        return Val(Pair{ left: left_view, right: right_view })
    }
    fallible: fn(self, left: [Int], right: [Int]) -> Pair String! {
        left_view: left[0..1]
        right_view: right[0..1]
        return Ok(Pair{ left: left_view, right: right_view })
    }
    tupled: fn(self, left: [Int], right: [Int]) -> (pair: Pair, count: Int) {
        left_view: left[0..1]
        right_view: right[0..1]
        return (pair: Pair{ left: left_view, right: right_view }, count: 1)
    }
    generic: fn(self, left: [Int], right: [Int]) -> Envelope<Pair> {
        left_view: left[0..1]
        right_view: right[0..1]
        return Envelope<Pair>{
            value: Pair{ left: left_view, right: right_view },
            marker: 0,
        }
    }
}
Last: struct { marker: Int }
impl Last.Select {
    select: fn(self, left: [Int], right: [Int]) -> Pair {
        left_view: left[0..1]
        right_view: right[0..1]
        return Pair{ left: left_view, right: right_view }
    }
    optional: fn(self, left: [Int], right: [Int]) -> (Pair?) {
        left_view: left[0..1]
        right_view: right[0..1]
        return Val(Pair{ left: left_view, right: right_view })
    }
    fallible: fn(self, left: [Int], right: [Int]) -> Pair String! {
        left_view: left[0..1]
        right_view: right[0..1]
        return Ok(Pair{ left: left_view, right: right_view })
    }
    tupled: fn(self, left: [Int], right: [Int]) -> (pair: Pair, count: Int) {
        left_view: left[0..1]
        right_view: right[0..1]
        return (pair: Pair{ left: left_view, right: right_view }, count: 1)
    }
    generic: fn(self, left: [Int], right: [Int]) -> Envelope<Pair> {
        left_view: left[0..1]
        right_view: right[0..1]
        return Envelope<Pair>{
            value: Pair{ left: left_view, right: right_view },
            marker: 0,
        }
    }
}


run: fn() {
    left := [7, 8]
    right := [9, 10]
    pair: wrapper(First{ marker: 0 }, left, right)
    print(pair.left[0])
    print(pair.right[0])
}
