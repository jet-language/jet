# Port of tests/dev_parts/routine.rs:6118-6178. Sources verbatim; ORACLE-LITERAL original predicates.
# Runtime PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four) where used.
# The session waits for each run's output instead of sleeping a fixed time, so a
# slow rebuild is waited for. A recv reads its part of stdout, so the stdout
# predicates apply to each part they cover.
fixture: watching_dev_reruns_on_jit_gap_and_recovers.fixture
env: NO_COLOR=1
session app raw: jet dev app.jet
recv app until ~ "good-v1" timeout 30s # the first build runs before the edit
stdout: ~ "good-v1" # original first execution predicate
stdout: !~ "E2211" # original retired-diagnostic predicate
write: app.jet watching_dev_reruns_on_jit_gap_and_recovers.gap.template
sleep: 800ms
write: app.jet watching_dev_reruns_on_jit_gap_and_recovers.final.template
recv app until ~ "good-v2" timeout 30s # the recovered build runs before the kill
stdout: !~ "E2211" # original retired-diagnostic predicate
stdout: ~ "good-v2" # original recovered execution predicate
signal app: KILL
close app
exit: any # original status unasserted after intentional child.kill
stdout: !~ "E2211" # original retired-diagnostic predicate
stderr: !~ "E2211" # original retired-diagnostic predicate
write: app.jet watching_dev_reruns_on_jit_gap_and_recovers.gap.template
step: jet dev app.jet --watch=off
exit: 0
stdout: !~ "E2211" # original retired-diagnostic predicate
stderr: !~ "E2211" # original retired-diagnostic predicate
stdout.trim: nonempty # original ed77c235f tests/dev_parts/routine.rs:6174-6177 one-shot stdout.trim is not empty
