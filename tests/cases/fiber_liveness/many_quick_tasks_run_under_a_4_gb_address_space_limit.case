# 10,000 quick tasks on 32 carriers, the pool of a 32-CPU machine, under
# `ulimit -v 4000000` (`limit: memory=` is RLIMIT_AS in KiB, set before the
# program starts): every task runs and the program prints done (#6403 c5).
# Built programs only, at O0, O1 and O2: under `jet run` the limit would be
# the compiler's.
fixture: fixtures/many_quick
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=32
step: jet build -O0 main.jet
exit: 0
step o0: built
limit: memory=4000000
exit: 0
stdout: = "total 29994\ndone\n"
stderr: empty
step: jet build -O1 main.jet
exit: 0
step o1: built
limit: memory=4000000
exit: 0
stdout: = "total 29994\ndone\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
limit: memory=4000000
exit: 0
stdout: = "total 29994\ndone\n"
stderr: empty
