# A program that caps its address space at 4 GiB (sys.set_memory_limit)
# before its first task runs 200 tasks asleep at once on four carriers:
# every one completes and its peak address space stays under 3 GiB, since
# under the cap no stack reserves more than a hundredth of it and the fiber
# stacks together a quarter. Built programs only, at O0, O1 and O2: under
# `jet run` the cap and the peak would be the compiler's process.
fixture: fixtures/capped
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=4
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "200 of 200 tasks completed\npeak address space under 3 GiB true\n"
step: jet build -O1 main.jet
exit: 0
step o1: built
exit: 0
stdout: = "200 of 200 tasks completed\npeak address space under 3 GiB true\n"
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "200 of 200 tasks completed\npeak address space under 3 GiB true\n"
