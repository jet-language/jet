# A carrier the host refuses (thread_spawn fails: the address space the
# program capped itself to has no room for more thread stacks) is no panic
# (#6403 c7). With carriers already running, the pool goes on with them:
# the 64 tasks that would start 31 more carriers on 32 all run and the
# program completes, short of its 32 carriers. Built programs at O0 and O2;
# a refused first carrier is a_refused_first_carrier_stops_naming_the_limit.
fixture: fixtures/refused_carriers
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=32
step: jet build --optimize=none main.jet
exit: 0
step o0: built
exit: 0
stdout: = "64 of 64 tasks completed, total 127\ncarriers refused true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "64 of 64 tasks completed, total 127\ncarriers refused true\n"
stderr: empty
