# 12 tasks block their carriers opening FIFOs for reading on four carriers,
# and the task that writes the FIFOs is queued behind them: the monitor
# starts a carrier for it, so the readers finish instead of deadlocking, and
# a quick task spawned meanwhile finishes in under 100 ms. Built
# programs at O0, O1 and O2.
requires: os-name:linux
requires: tool:sh
fixture: fixtures/blocked_fifo_read
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=4
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "24 bytes read from 12 fifos\nquick task under 100 ms true\n"
stderr: empty
step: jet build -O1 main.jet
exit: 0
step o1: built
exit: 0
stdout: = "24 bytes read from 12 fifos\nquick task under 100 ms true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "24 bytes read from 12 fifos\nquick task under 100 ms true\n"
stderr: empty
