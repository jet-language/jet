# 12 tasks wait on `sleep 1` children on four carriers; a quick task spawned
# after them finishes in under 100 ms (#6403 c2): a child wait parks its
# fiber and frees the carrier. Built programs at O0, O1 and O2.
requires: os-name:linux
fixture: fixtures/blocked_child_wait
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=4
step: jet build --optimize=none main.jet
exit: 0
step o0: built
exit: 0
stdout: = "12 blockers done\nquick task under 100 ms true\n"
stderr: empty
step: jet build --optimize=basic main.jet
exit: 0
step o1: built
exit: 0
stdout: = "12 blockers done\nquick task under 100 ms true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "12 blockers done\nquick task under 100 ms true\n"
stderr: empty
