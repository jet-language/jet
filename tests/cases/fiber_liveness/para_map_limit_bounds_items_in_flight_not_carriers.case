# With two carrier threads, para_map(f, limit: 16) keeps items parked in a
# sleep in flight past the two carriers and never past 16 (the limit, not
# the carriers, bounds them), and limit 1 keeps one; items that never park
# run at most two at once, with or without a limit. Results keep source
# order. Same output on jet run and at O0, O1 and O2.
fixture: fixtures/para
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=2
step: jet run main.jet
exit: 0
stdout: = "limit 16: parked items overlap past the 2 carriers true, within the limit true\nlimit 1: parked items overlap 1\nbusy items: at most 2 at once true\norder kept true\n"
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "limit 16: parked items overlap past the 2 carriers true, within the limit true\nlimit 1: parked items overlap 1\nbusy items: at most 2 at once true\norder kept true\n"
step: jet build -O1 main.jet
exit: 0
step o1: built
exit: 0
stdout: = "limit 16: parked items overlap past the 2 carriers true, within the limit true\nlimit 1: parked items overlap 1\nbusy items: at most 2 at once true\norder kept true\n"
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "limit 16: parked items overlap past the 2 carriers true, within the limit true\nlimit 1: parked items overlap 1\nbusy items: at most 2 at once true\norder kept true\n"
