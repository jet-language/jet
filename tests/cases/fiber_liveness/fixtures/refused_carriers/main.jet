// After one task has started the pool's first carrier, the program caps its
// address space 8 MiB above what it maps: room for the heap and a few
// thread stacks (a hundredth of the cap each), not for the 31 more carriers
// the 64 tasks that follow would start on 32. The host refuses the rest, the
// pool goes on with the carriers it has, and every task runs (#6403 c7).
package: {
    name: "refused_carriers"
    authority: { allow: [Env, Exec, FS, FS.Read, IO] }
}

use files: core.files
use sys: core.sys

TASKS: 64
CARRIERS: 32
ROOM: 8388608

work: fn(i: Int) -> Int {
    i % 5
}

// A /proc status field's number ("VmSize:\t 123 kB", "Threads:\t3").
census: fn(prefix: String) -[FS]> Int {
    text: files.read("/proc/self/status") ?? panic("read status")
    loop line in text.lines() {
        if line.starts_with(prefix) -> return Int.parse(line.remove_prefix(prefix).remove_suffix("kB").trim()) ?? -1
    }
    -1
}

run: fn() {
    first: task work(1)
    total := first.join() ?? 0
    cap: census("VmSize:") * 1024 + ROOM
    sys.set_memory_limit(cap, cap) ?? panic("set_memory_limit")
    handles := [Task<Int>]{}
    loop i in 0..<TASKS -> handles.push(task work(i))
    count := 0
    loop handle in handles {
        total += handle.join() ?? 0
        count += 1
    }
    threads: census("Threads:")
    print("{count} of {TASKS} tasks completed, total {total}")
    print("carriers refused {threads > 1 && threads < CARRIERS + 1}")
}
