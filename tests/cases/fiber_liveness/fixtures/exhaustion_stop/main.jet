// Two scenarios under a tight address-space limit, chosen by the
// first argument.
// `contended` caps its address space below a megabyte above what it maps,
// so no new fiber stack fits and its tasks run on their carrier, then runs
// 20 rounds of 64 tasks: each task's start and finish take the observation
// registry's mutex, which the main thread's spawns contend. A wake that
// went only to a parked fiber left the one carrier asleep on the futex
// with the mutex free, and the program hung; now every round completes and
// it exits 0.
// `exhausted` caps its address space 64 MiB above what it maps and grows a
// list in a task until no allocation fits: it stops with the out-of-memory
// report (`memory allocation of N bytes failed`) and SIGABRT, not a hang.
package: {
    name: "exhaustion_stop"
    authority: { allow: [Env, Exec, Exec.Args, FS, FS.Read, IO, Mem.Alloc] }
}

use files: core.files
use process: core.process
use sys: core.sys

ROUNDS: 20
TASKS: 64
ROOM: 786432

work: fn(i: Int) -> Int {
    i % 5
}

// A /proc status field's number ("VmSize:\t 123 kB").
census: fn(prefix: String) -[FS]> Int {
    text: files.read("/proc/self/status") ?? panic("read status")
    loop line in text.lines() {
        if line.starts_with(prefix) -> return Int.parse(line.remove_prefix(prefix).remove_suffix("kB").trim()) ?? -1
    }
    -1
}

cap: fn(room: Int) {
    limit: census("VmSize:") * 1024 + room
    sys.set_memory_limit(limit, limit) ?? panic("set_memory_limit")
}

contended: fn() {
    first: task work(1)
    _ := first.join() ?? 0
    cap(ROOM)
    total := 0
    loop _ in 0..<ROUNDS {
        handles := [Task<Int>]{}
        loop i in 0..<TASKS -> handles.push(task work(i))
        loop handle in handles -> total += handle.join() ?? 0
    }
    print("{ROUNDS} rounds of {TASKS} tasks, total {total}")
}

grow: fn() -> Int {
    values := [Int]{}
    loop {
        values.push(values.len())
    }
    values.len()
}

exhausted: fn() {
    cap(67108864)
    growing: task grow()
    print("grew {growing.join() ?? 0}")
}

run: fn() {
    mode: process.args()
    if mode.len() > 0 && mode[0] == "contended" -> contended() else if mode.len() > 0 && mode[0] == "exhausted" -> exhausted() else -> panic("usage: main contended|exhausted")
}
