// The program caps its address space just above what it maps before its
// first task, so the pool's first carrier cannot start: the process stops
// with one `error:` line naming the limit, not a panic.
package: {
    name: "refused_first_carrier"
    authority: { allow: [Env, Exec, FS, FS.Read, IO] }
}

use files: core.files
use sys: core.sys

// Under a megabyte: no thread stack (at least 1 MiB and its guard page)
// fits, while the heap still has its slabs.
ROOM: 786432

work: fn(i: Int) -> Int {
    i % 5
}

// A /proc status field's number ("VmSize:\t 123 kB").
census: fn(prefix: String) -[FS]> Int {
    text: files.read("/proc/self/status") ?? panic("read status")
    loop line in text.lines() {
        if line.starts_with(prefix) -> return Int.parse(line.remove_prefix(prefix).remove_suffix("kB").trim()) ?? -1
    }
    -1
}

run: fn() {
    cap: census("VmSize:") * 1024 + ROOM
    sys.set_memory_limit(cap, cap) ?? panic("set_memory_limit")
    print("capped")
    first: task work(1)
    print("ran {first.join() ?? -1}")
}
