// The task CPU clock follows the task, not the carrier: on one carrier, a
// task parked in a 200 ms sleep while another task burns 200 ms on that
// same carrier gains almost nothing on its clock, the burner's clock counts
// its own run, and a task keeps its identity across a park.
package: {
    name: "task_clock"
    authority: { allow: [IO, Mem.Alloc, Time, Time.Wait, FFI] }
}

use time: core.time

#Import(c) task_cpu_ns: fn() -> Int = "jet_rt_task_cpu_ns"
#Import(c) task_identity: fn() -> Int = "jet_rt_task_identity"

burn: fn(ms: Int) {
    start: time.instant()
    loop time.instant().difference(start).ns < ms * 1_000_000 {}
}

// The CPU time a task gains across a 200 ms sleep, or -1 when it comes back
// under another identity.
parked_spent: fn() -> Int {
    identity: task_identity()
    before: task_cpu_ns()
    time.sleep(200ms)
    spent: task_cpu_ns() - before
    if task_identity() == identity -> spent else -> -1
}

// The CPU time a task gains burning `ms` milliseconds.
burned_spent: fn(ms: Int) -> Int {
    before: task_cpu_ns()
    burn(ms)
    task_cpu_ns() - before
}

run: fn() {
    parked: task { parked_spent() }
    burner: task { burned_spent(200) }
    burned: burner.join() ?? panic("burner")
    slept: parked.join() ?? panic("parked")
    print("identity kept across the park {slept >= 0}")
    print("parked task's clock skips the other task's run {slept >= 0 && slept < 50_000_000}")
    print("busy task's clock counts its own run {burned >= 150_000_000}")
    print("a plain thread's clock is its CPU time {burned_spent(50) >= 30_000_000}")
}
