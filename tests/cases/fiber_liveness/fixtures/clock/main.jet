// The task CPU clock follows the task, not the carrier: on one carrier, a
// task parked in a 200 ms sleep while another task spends 200 ms of CPU on
// that same carrier gains almost nothing on its clock, the burner's clock
// counts its own run, and a task keeps its identity across a park. Every
// check holds under load: a burn waits for CPU time, not wall time.
package: {
    name: "task_clock"
    authority: { allow: [IO, Mem.Alloc, Time, Time.Wait, FFI] }
}

use time: core.time

#Import(c) task_cpu_ns: fn() -> Int = "jet_rt_task_cpu_ns"
#Import(c) task_identity: fn() -> Int = "jet_rt_task_identity"

// Spins until this task's CPU clock has advanced `ms` milliseconds; false
// when 30 s of wall time pass first. A preempted thread spins longer rather
// than counting less.
burn: fn(ms: Int) -> Bool {
    before: task_cpu_ns()
    start: time.instant()
    loop task_cpu_ns() - before < ms * 1_000_000 {
        if time.instant().difference(start).ns >= 30_000_000_000 -> return false
    }
    true
}

// The CPU time a task gains across a 200 ms sleep, or -1 when it comes back
// under another identity.
parked_spent: fn() -> Int {
    identity: task_identity()
    before: task_cpu_ns()
    time.sleep(200ms)
    spent: task_cpu_ns() - before
    if task_identity() == identity -> spent else -> -1
}

run: fn() {
    parked: task { parked_spent() }
    burner: task { burn(200) }
    burned: burner.join() ?? panic("burner")
    slept: parked.join() ?? panic("parked")
    print("identity kept across the park {slept >= 0}")
    print("parked task's clock skips the other task's run {burned && slept >= 0 && slept < 50_000_000}")
    print("busy task's clock counts its own run {burned}")
    print("a plain thread's clock is its CPU time {burn(50)}")
}
