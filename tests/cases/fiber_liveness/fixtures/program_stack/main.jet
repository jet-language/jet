// A program's threads and fibers take the program stack size, 8 MiB here,
// never the 192 MiB the compiler asks for on its compile group.
// The soft stack limit is set to 8 MiB first, so only the compiler's size
// leaking into the program could make the stacks larger. 16 tasks park in a
// channel receive on two carriers, and while they are parked the address
// space (/proc/self/status VmSize) has grown by under 1 GiB from the start.
// 18 stacks of 192 MiB would add 3.4 GiB.
package: {
    name: "program_stack"
    authority: { allow: [Env, Exec, FS, FS.Read, IO, Time, Time.Wait] }
}

use files: core.files
use sys: core.sys
use time: core.time

TASKS: 16
PROGRAM_STACK: 8388608
GROWTH_LIMIT: 1073741824

vm_size: fn() -[FS]> Int {
    text: files.read("/proc/self/status") ?? panic("read status")
    loop line in text.lines() {
        if line.starts_with("VmSize:") -> return (Int.parse(line.remove_prefix("VmSize:").remove_suffix("kB").trim()) ?? -1) * 1024
    }
    -1
}

waiter: fn(rx: Receiver<Int>) -> Int { rx.receive() ?? 0 }

run: fn() {
    limit: sys.stack_limit() ?? panic("stack limit: {err}")
    sys.set_stack_limit(Val(PROGRAM_STACK), limit.hard) ?? panic("set stack limit: {err}")
    before: vm_size()
    { sender: tx, receiver: rx }: channel<Int>(capacity: 1)
    handles := [Task<Int>]{}
    loop _ in 0..<TASKS -> handles.push(task waiter(rx))
    time.sleep(200ms)
    parked: vm_size()
    loop _ in 0..<TASKS -> tx.send(1)
    total := 0
    loop handle in handles -> total += handle.join() ?? 0
    print("{total} of {TASKS} tasks completed")
    print("address space grew under 1 GiB while parked {before > 0 && parked - before < GROWTH_LIMIT}")
    if parked - before >= GROWTH_LIMIT -> print("  grew {(parked - before) /% 1048576} MiB")
}
