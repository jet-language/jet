// Two tasks count loop turns on the pool's two carriers and never wait; each
// stops at LIMIT turns or once the quick task has run. Once both are counting,
// one trivial task is spawned and joined. A busy task that has held its
// carrier for a whole tick while the quick task waits is asked for its turn
// and gives the carrier up at its next loop check, so the quick task runs
// while both counts are still far below LIMIT. Without turns it would wait
// for both loops to reach LIMIT.
use time: core.time

BUSY: 2
LIMIT: 2000000000

busy: fn(counter: Atomic<Int>, done: Atomic<Bool>) -> Int {
    n := 0
    loop n < LIMIT && !done.load() {
        n += 1
        if n % 4096 == 0 -> counter.store(n)
    }
    n
}

// Runs once a busy task gives up its carrier: records the most turns either
// busy loop had counted, then stops them.
quick: fn(counters: [Atomic<Int>], done: Atomic<Bool>) -> Int {
    most := 0
    loop counter in counters {
        count: counter.load()
        if count > most -> most = count
    }
    done.store(true)
    most
}

counting: fn(counters: [Atomic<Int>]) -> Bool {
    loop counter in counters {
        if counter.load() == 0 -> return false
    }
    true
}

run: fn() {
    done: Atomic<Bool>.try_new(false) ?? return
    counters := [Atomic<Int>]{}
    handles := [Task<Int>]{}
    loop _ in 0..<BUSY {
        counter: Atomic<Int>.try_new(0) ?? return
        handles.push(task busy(counter, done))
        counters.push(counter)
    }
    tries := 0
    loop !counting(counters) && tries < 5000 {
        time.sleep(1ms)
        tries += 1
    }
    start: time.instant()
    one: task quick(counters, done)
    most: one.join() ?? LIMIT
    latency: time.instant() - start
    stopped := 0
    loop handle in handles {
        if (handle.join() ?? LIMIT) < LIMIT -> stopped += 1
    }
    print("quick task ran with every busy loop below {LIMIT} turns: {most < LIMIT}")
    print("{stopped} busy tasks stopped before {LIMIT} turns")
    print("quick task under 10 s {latency.in(.Seconds) < 10}")
}
