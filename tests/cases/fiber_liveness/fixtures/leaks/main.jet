// Tasks cancelled while parked give back their stacks. Rounds of 10000
// tasks each park in a receive and are cancelled. After the first round has
// filled the pool of idle stacks, two more rounds leave the address space
// within 160 MiB of the first census (allocator arenas of up to 64 MiB
// each come and go; one leaked fiber would add its whole stack reservation,
// at least 192 MiB) and the thread count unchanged. A finished fiber's
// stack returns to the pool from its carrier just after the join wakes, so
// every round starts once the carriers settle (a round started before a
// late return maps one more pooled stack, which is no leak), and the last
// census waits, up to 5 s, for them too.
package: {
    name: "fiber_leaks"
    authority: { allow: [FS, FS.Read, IO, Mem.Alloc, Time, Time.Wait] }
}

use files: core.files
use time: core.time

TASKS: 10000

waiter: fn(rx: Receiver<Int>) -> Int { rx.receive() ?? 0 }

round: fn() -> Int {
    { sender: tx, receiver: rx }: channel<Int>(capacity: 1)
    parked := [Task<Int>]{}
    loop i in 0..<TASKS -> parked.push(task waiter(rx))
    time.sleep(50ms)
    loop i in 0..<parked.len() -> parked[i].cancel()
    cancelled := 0
    loop handle in parked {
        if handle.join() == {
            .Ok(_) -> {}
            .Err(_) -> cancelled += 1
        }
    }
    tx.close()
    cancelled
}

// A /proc status field's number ("Threads:\t33", "VmSize:\t 123 kB").
census: fn(path: String, prefix: String) -[FS]> Int {
    text: files.read(path) ?? panic("read {path}")
    loop line in text.lines() {
        if line.starts_with(prefix) -> return Int.parse(line.remove_prefix(prefix).remove_suffix("kB").trim()) ?? -1
    }
    -1
}

BOUND_KB: 160 * 1024

// The address space once the carriers settle: two equal readings 100 ms
// apart, or the first reading within BOUND_KB of `base` (-1: no base).
settled_kb: fn(base: Int) -[FS, Time.Wait]> Int {
    time.sleep(100ms)
    size := census("/proc/self/status", "VmSize:")
    loop tries in 0..<50 {
        if base >= 0 && size - base <= BOUND_KB -> return size
        time.sleep(100ms)
        next: census("/proc/self/status", "VmSize:")
        if base < 0 && next == size -> return size
        size = next
    }
    size
}

run: fn() {
    first: round()
    size_first: settled_kb(-1)
    threads_first: census("/proc/self/status", "Threads:")
    second: round()
    _ := settled_kb(-1)
    third: round()
    size_last: settled_kb(size_first)
    threads_last: census("/proc/self/status", "Threads:")
    print("cancelled {first}, {second}, {third} of {TASKS}")
    print("address space within 160 MiB {size_last - size_first <= BOUND_KB}, threads unchanged {threads_last == threads_first}")
}
