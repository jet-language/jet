// 10,000 quick tasks at once on every carrier the pool has (#6403's
// r09_many_quick_tasks): the stacks of the carriers and of the tasks' fibers
// fit the process's address-space limit, so every task runs.
package: {
    name: "many_quick_tasks"
    authority: { allow: [IO] }
}

TASKS: 10000

quick: fn(i: Int) -> Int {
    i % 7
}

run: fn() {
    handles := [Task<Int>]{}
    loop i in 0..<TASKS -> handles.push(task quick(i))
    total := 0
    loop handle in handles -> total += handle.join() ?? 0
    print("total {total}")
    print("done")
}
