// Four tasks count loop turns on the pool's two carriers and never wait; each
// stops at LIMIT turns or once the quick task has run. Two of them start
// behind the two that take the carriers, so once every busy task has a fiber
// a turn given always finds a busy fiber ready for the carrier. The quick
// task, spawned right after them, still starts at a turn: a carrier whose
// fiber has just given its turn starts a queued task before it takes a ready
// fiber. Without that the quick task waits for the busy loops to reach LIMIT.
use time: core.time

LIMIT: 2000000000

busy: fn(done: Atomic<Bool>) -> Int {
    n := 0
    loop n < LIMIT && !done.load() -> n += 1
    n
}

quick: fn(done: Atomic<Bool>) -> Int {
    done.store(true)
    1
}

// The tasks share the owner's flag, so they run in a group the flag outlives.
run: fn() {
    done: Atomic<Bool>.try_new(false) ?? return
    task.group carriers {
        handles := [Task<Int>]{}
        loop _ in 0..<4 -> handles.push(task busy(done))
        one: task quick(done)
        start: time.instant()
        ran: one.join() ?? 0
        latency: time.instant() - start
        stopped := 0
        loop handle in handles {
            if (handle.join() ?? LIMIT) < LIMIT -> stopped += 1
        }
        print("quick task ran: {ran == 1}")
        print("{stopped} busy tasks stopped before {LIMIT} turns")
        print("quick task under 10 s {latency.in(.Seconds) < 10}")
    }
}
