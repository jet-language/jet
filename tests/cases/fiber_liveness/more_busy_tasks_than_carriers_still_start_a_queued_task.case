# Four tasks count loop turns that never wait on the pool's two carriers, each
# up to 2000000000 turns or until a quick task runs; the quick task, spawned
# right after them, runs while every busy count is still below that bound,
# and all four busy tasks then stop early (D-TASK-SLICE1=A). Once every busy
# task has a fiber, two always wait ready for a carrier, so a turn given
# reaches the queued quick task only because a carrier whose fiber has just
# yielded starts a queued task before it takes a ready fiber; otherwise the
# quick task waits for the busy loops to reach the bound. The 10 s wall check
# is only a backstop. Built programs at O0, O1 and O2.
fixture: fixtures/more_busy_tasks_than_carriers
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=2
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "quick task ran: true\n4 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
step: jet build -O1 main.jet
exit: 0
step o1: built
exit: 0
stdout: = "quick task ran: true\n4 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "quick task ran: true\n4 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
