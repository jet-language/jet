# Two tasks count loop turns that never wait on the pool's two carriers, each
# up to 2000000000 turns or until a quick task runs; the quick task, spawned
# once both count, runs while every busy count is still below that bound, and
# both busy tasks then stop early (D-TASK-SLICE1=A). The monitor asks each
# fiber still on its carrier a tick later for its turn, and the fiber gives
# the carrier to the queued task at its next loop check, about two 10 ms
# ticks of turns; without turns the quick task waits for both loops to reach
# the bound. The 10 s wall check is only a backstop. Built programs at O0, O1
# and O2.
fixture: fixtures/busy_carriers
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=2
step: jet build --optimize=none main.jet
exit: 0
step o0: built
exit: 0
stdout: = "quick task ran with every busy loop below 2000000000 turns: true\n2 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
step: jet build --optimize=basic main.jet
exit: 0
step o1: built
exit: 0
stdout: = "quick task ran with every busy loop below 2000000000 turns: true\n2 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "quick task ran with every busy loop below 2000000000 turns: true\n2 busy tasks stopped before 2000000000 turns\nquick task under 10 s true\n"
stderr: empty
