# A program jet runs gets the program thread stack size, not the 192 MiB
# jet asks for on its own compile group (D-THREAD-STACK1=A). 16
# tasks parked on two carriers grow the address space by under 1 GiB. The
# program runs in place of jet under `jet run`, in a child of jet under `jet
# dev` (which always spawns it), and as its own process once built. The
# compiler's side is compiler_stack/long_chain_100000_terms_check_and_run:
# its compile recursion needs about 10 MiB, more than 8 MiB stacks hold.
fixture: fixtures/program_stack
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=2
step run: jet run main.jet
exit: 0
stdout: = "16 of 16 tasks completed\naddress space grew under 1 GiB while parked true\n"
stderr: empty
step child: jet dev --watch=off --quiet main.jet
exit: 0
stdout: = "16 of 16 tasks completed\naddress space grew under 1 GiB while parked true\n"
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "16 of 16 tasks completed\naddress space grew under 1 GiB while parked true\n"
stderr: empty
