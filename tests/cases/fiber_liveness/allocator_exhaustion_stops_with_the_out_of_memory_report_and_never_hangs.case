# Under a tight address-space limit a program ends, never hangs.
# `contended` caps its address space under a megabyte above what it maps,
# so its tasks find no fiber stack and run on the one carrier, and runs 20
# rounds of 64 tasks against the main thread's spawns: it completes (before
# the fix a wake that readied only a parked fiber left that carrier asleep
# with the mutex free, and every run hung). `exhausted` caps its address
# space 64 MiB above what it maps and grows a list until no allocation fits:
# the out-of-memory report, then SIGABRT (the shell reports status 134; a
# signal death is an ERROR as a run step). Built programs at O0, O1 and O2,
# each run bounded by a timeout.
fixture: fixtures/exhaustion_stop
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=1
step: jet build -O0 main.jet
exit: 0
step o0_contended: built contended
timeout: 60s
exit: 0
stdout: = "20 rounds of 64 tasks, total 2520\n"
stderr: empty
step o0_exhausted: sh -c '.jet/build/main exhausted; echo status $?'
timeout: 60s
exit: 0
stdout: = "status 134\n"
stderr: ~ "memory allocation of " # the registered out-of-memory report
stderr: ~ " bytes failed\n" # with its byte count
stderr: !~ "panic" # exhaustion is no program panic
step: jet build -O1 main.jet
exit: 0
step o1_contended: built contended
timeout: 60s
exit: 0
stdout: = "20 rounds of 64 tasks, total 2520\n"
stderr: empty
step o1_exhausted: sh -c '.jet/build/main exhausted; echo status $?'
timeout: 60s
exit: 0
stdout: = "status 134\n"
stderr: ~ "memory allocation of " # the registered out-of-memory report
stderr: ~ " bytes failed\n" # with its byte count
stderr: !~ "panic" # exhaustion is no program panic
step: jet build --release main.jet
exit: 0
step o2_contended: built contended
timeout: 60s
exit: 0
stdout: = "20 rounds of 64 tasks, total 2520\n"
stderr: empty
step o2_exhausted: sh -c '.jet/build/main exhausted; echo status $?'
timeout: 60s
exit: 0
stdout: = "status 134\n"
stderr: ~ "memory allocation of " # the registered out-of-memory report
stderr: ~ " bytes failed\n" # with its byte count
stderr: !~ "panic" # exhaustion is no program panic
