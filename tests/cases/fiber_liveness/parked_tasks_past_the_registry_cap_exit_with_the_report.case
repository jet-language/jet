# 5000 detached tasks stay parked at exit. The task registry holds 4096, so
# the E3013 report counts exactly 4096: 860 entries fit its byte limit and
# the other 3236 are counted as omitted. The tasks past the cap are neither
# reported nor waited for: the process exits 70 rather than hanging. Same
# output on jet run and at O0, O1 and O2.
fixture: fixtures/cap
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet
exit: 70
stdout: = "leaving with 5000 parked\n"
stderr: ~ "Stop [E3013]: Parked tasks remain at process exit:" # jet run: the parked-task report
stderr: ~ "  ... 3236 more parked task(s) omitted by the report limit ..." # jet run: 4096 registered, 860 listed
step: jet build --optimize=none main.jet
exit: 0
step o0: built
exit: 70
stdout: = "leaving with 5000 parked\n"
stderr: ~ "Stop [E3013]: Parked tasks remain at process exit:" # O0: the parked-task report
stderr: ~ "  ... 3236 more parked task(s) omitted by the report limit ..." # O0: 4096 registered, 860 listed
step: jet build --optimize=basic main.jet
exit: 0
step o1: built
exit: 70
stdout: = "leaving with 5000 parked\n"
stderr: ~ "Stop [E3013]: Parked tasks remain at process exit:" # O1: the parked-task report
stderr: ~ "  ... 3236 more parked task(s) omitted by the report limit ..." # O1: 4096 registered, 860 listed
step: jet build --release main.jet
exit: 0
step o2: built
exit: 70
stdout: = "leaving with 5000 parked\n"
stderr: ~ "Stop [E3013]: Parked tasks remain at process exit:" # O2: the parked-task report
stderr: ~ "  ... 3236 more parked task(s) omitted by the report limit ..." # O2: 4096 registered, 860 listed
