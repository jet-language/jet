# 100 tasks block 100 times each for 1 ms on four carriers: the process's
# live thread count, read after every wait, never passes the carriers + 8
# runtime helper threads + the main thread. A waiting task parks
# its fiber; no wait holds or adds a thread. The count comes from
# /proc/self/status, since the fiber scheduler keeps no blocking-wait
# thread stats (jet_scheduler_blocking_wait_stats went with its
# compensation threads). Built programs at O0, O1 and O2.
fixture: fixtures/blocking_high_water
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JET_SCHEDULER_THREADS=4
step: jet build -O0 main.jet
exit: 0
step o0: built
exit: 0
stdout: = "10000 blocking waits\nthread high-water within carriers + 9 true\n"
stderr: empty
step: jet build -O1 main.jet
exit: 0
step o1: built
exit: 0
stdout: = "10000 blocking waits\nthread high-water within carriers + 9 true\n"
stderr: empty
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = "10000 blocking waits\nthread high-water within carriers + 9 true\n"
stderr: empty
