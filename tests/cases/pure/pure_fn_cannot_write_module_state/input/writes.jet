Count: struct {
    value: Int
}

HITS: shared Count{value: 0}
#Persist pinned := 0

bump: fn() -[]> Int {
    HITS.value += 1
    HITS.value
}

pin: fn() -[]> Int {
    pinned += 1
    pinned
}

inc: fn() {
    pinned += 1
}

relay: fn() -[]> Int {
    inc()
    pinned
}

run: fn() {
    print(bump())
    print(pin())
    print(relay())
}
