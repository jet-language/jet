# A `[T#N]` of plain elements is carried inline as a value: assigning it
# copies the elements, a by-value parameter gets its own copy, and a `&`
# parameter writes the caller's. Every tier and a build-time constant agree.
fixture: fixed_lists_are_inline_values_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet emit --ir main.jet --fn add3
exit: 0
stdout: !~ "jet_rt_alloc" # the result lives in frame storage, not on the heap
stdout: !~ "jet_rt_free" # nothing is freed either
step: jet run -O0 main.jet
exit: 0
stdout: = fixed_lists_are_inline_values_on_every_tier.out
step: jet run -O1 main.jet
exit: 0
stdout: = fixed_lists_are_inline_values_on_every_tier.out
step: jet run -O2 main.jet
exit: 0
stdout: = fixed_lists_are_inline_values_on_every_tier.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = fixed_lists_are_inline_values_on_every_tier.out
