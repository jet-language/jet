total: fn(window: View<Int>) -> Int {
    sum := 0
    loop x in window {
        sum += x
    }
    sum
}

middle: fn(values: [Int#4]) -> View<Int> from values {
    values[1..<3]
}

middle_total: fn(values: [Int#4]) -> Int {
    total(values[1..<3])
}

run: fn() {
    values: [Int#4]{1, 2, 3, 4}
    print(middle(values))
    print(middle_total(values))
}
