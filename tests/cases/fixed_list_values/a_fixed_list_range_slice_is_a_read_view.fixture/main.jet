fn total(window: View<Int>) -> Int {
    sum := 0
    loop x in window {
        sum += x
    }
    sum
}

fn middle(values: [Int#4]) -> View<Int> from values {
    values[1..<3]
}

fn middle_total(values: [Int#4]) -> Int {
    total(values[1..<3])
}

fn run() {
    values :: [Int#4]{1, 2, 3, 4}
    print(middle(values))
    print(middle_total(values))
}
