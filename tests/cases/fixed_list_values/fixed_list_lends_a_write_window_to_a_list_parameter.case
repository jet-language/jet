# #6290: a fixed list passed as `&a` to a `&[Int]` parameter checks, builds,
# and writes the caller's elements on every tier.
fixture: fixed_list_lends_a_write_window_to_a_list_parameter.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = fixed_list_lends_a_write_window_to_a_list_parameter.out
step: jet run -O1 main.jet
exit: 0
stdout: = fixed_list_lends_a_write_window_to_a_list_parameter.out
step: jet run -O2 main.jet
exit: 0
stdout: = fixed_list_lends_a_write_window_to_a_list_parameter.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = fixed_list_lends_a_write_window_to_a_list_parameter.out
