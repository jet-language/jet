// A byte read off the wire is 0..255. After the guard returns for every
// value at or past the list's length, the index can only be 0..3, so the
// fixed-size list index checks.
tally: fn(frames: [U8]) -> [U64#4]? {
    channels := [U64#4]{0, 0, 0, 0}
    loop raw in frames {
        channel: Int{raw}
        if channel >= channels.len() -> return None
        channels[channel] = channels[channel] + U64{1}
    }
    channels
}

// The mirrored and `||` forms narrow the same way; a guard that exits on
// `next` narrows the rest of the loop body.
lanes: fn(frames: [U8]) -> Int {
    lane_hits := [Int#3]{0, 0, 0}
    loop raw in frames {
        lane: Int{raw} - 1
        if lane < 0 || 3 <= lane -> next
        lane_hits[lane] = lane_hits[lane] + 1
    }
    lane_hits[0] * 100 + lane_hits[1] * 10 + lane_hits[2]
}

run: fn() {
    counts: tally([U8]{0, 1, 1, 3, 3, 3}) ?? return
    print("channels {counts[0]} {counts[1]} {counts[2]} {counts[3]}")
    print("channel 9 rejected: {tally([U8]{2, 9}) == None}")
    print("lanes {lanes([U8]{0, 1, 2, 2, 3, 3, 3, 4, 255})}")
}
