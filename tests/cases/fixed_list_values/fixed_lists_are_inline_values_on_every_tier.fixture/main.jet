// A `[T#N]` of plain elements is a value: assignment copies it, a by-value
// parameter gets its own copy, and a `&` parameter writes the caller's, as a
// `[T#N]` or as a `[T]`.

struct Body {
    at: [Float#3]
    mass: Float
}

fn add3(x: [Float#3], y: [Float#3]) -> [Float#3] {
    return [Float#3]{x[0] + y[0], x[1] + y[1], x[2] + y[2]}
}

fn bumped(xs: [Int#3]) -> [Int#3] {
    own := xs
    own[0] = own[0] + 100
    return own
}

fn scale(xs: &[Int#3], k: Int) {
    loop i in 0..<3 -> xs[i] = xs[i] * k
}

fn total(xs: [Int#3]) -> Int {
    return xs[0] + xs[1] + xs[2]
}

fn widened(xs: [Int]) -> Int {
    sum := 0
    loop x in xs -> sum += x
    return sum
}

fn first_doubled(xs: &[Int]) {
    xs[0] = xs[0] * 2
}

fn squares() -> [Int#3] {
    out := [Int#3]{0, 0, 0}
    loop i in 0..<3 -> out[i] = (i + 1) * (i + 1)
    return out
}

ORIGIN :: [Float#3]{1.5, 2.5, 3.5}
SQUARES :: squares()

fn run() {
    a := [Int#3]{1, 2, 3}
    b := a
    b[0] = 9
    print("assign {a[0]} {b[0]}")
    c :: bumped(a)
    print("by value {a[0]} {c[0]}")
    scale(&a, 10)
    print("by write {a[0]} {a[1]} {a[2]}")
    print("total {total(a)} widened {widened(a)} len {a.len()}")
    print("shown {a}")
    print("equal {a == [Int#3]{10, 20, 30}} {a == b}")
    &a.reverse()
    print("reversed {a}")
    first_doubled(&a)
    print("as a list {a}")
    p := Body{at: ORIGIN, mass: 2.0}
    q := p
    q.at[2] = 8.5
    print("field {p.at[2]} {q.at[2]}")
    moved :: add3(p.at, q.at)
    print("sum {moved[0]} {moved[1]} {moved[2]}")
    print("constant {SQUARES[0]} {SQUARES[1]} {SQUARES[2]}")
}
