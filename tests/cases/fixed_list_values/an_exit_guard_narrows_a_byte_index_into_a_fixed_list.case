# A dominating `if i >= list.len() -> return` guard leaves the rest of the
# block only the indexes the guard did not exit for, so an index whose type
# allows 0..255 checks against a `[T#4]`. The same program runs on every
# tier. tests/ui/fixed_list_index_guard_off_by_one.jet keeps the error for a
# guard that still lets an out-of-range index through.
fixture: an_exit_guard_narrows_a_byte_index_into_a_fixed_list.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
stderr: !~ "E0965" # the guarded index is in range
step: jet run -O0 main.jet
exit: 0
stdout: = an_exit_guard_narrows_a_byte_index_into_a_fixed_list.out
step: jet run -O1 main.jet
exit: 0
stdout: = an_exit_guard_narrows_a_byte_index_into_a_fixed_list.out
step: jet run -O2 main.jet
exit: 0
stdout: = an_exit_guard_narrows_a_byte_index_into_a_fixed_list.out
