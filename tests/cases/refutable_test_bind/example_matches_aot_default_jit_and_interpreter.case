fixture: example_matches_aot_default_jit_and_interpreter.fixture
step release: jet run --release {root}/Examples/features/patterns/refutable_test_bind.jet
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: NO_COLOR=1
env: JETPACK_ENV=1
