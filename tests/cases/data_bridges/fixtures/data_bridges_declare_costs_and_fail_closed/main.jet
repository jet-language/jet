
use data :: core.data

fn show_bridge(step: String) {
    status :: data.status()
    loop row in status {
        if row.step == step {
            print("{row.step} path={row.path} copy={row.clone_value} ownership={row.ownership} trust={row.trust} fallback={row.fallback} replacement={row.replacement}")
        }
    }
}

fn probe_bridge(name: String) {
    if data.require_bridge(name) == {
        .Ok(_) -> print("{name}: available")
        .Err(error) -> print("{name}: {error}")
    }
}

fn run() {
    show_bridge("py.*")
    show_bridge("r.*")
    show_bridge("gpu.*")
    probe_bridge("py")
    probe_bridge("r")
    probe_bridge("gpu")
    if data.require_bridge("nope") == {
        .Ok(_) -> print("nope: unexpectedly ok")
        .Err(error) -> print("nope: {error}")
    }
}
