# Core ships as machine code in jet. Outside the tree, `jet run` checks
# the Core sources built into jet and binds the program's Core calls to the
# Core code jet carries (JetCli Host.jet jet_cli_native_executable): here the
# runtime image's. The trace counter `ir.build.core_calls` counts the Core
# symbols the program calls there. `jet build` binds none, so a built
# program carries the Core code it calls. A run whose live code calls C
# binds to the Core library's object instead:
# a_run_that_links_c_binds_its_core_calls_to_the_core_object.case, which
# needs a C toolchain.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_PHASE_COUNTERS=1
write: main.jet = "use base64: core.encoding.base64\n\nrun: fn() {\n    print(base64.encode(\"jet\".bytes()))\n}\n"
step: jet run --trace=run.json main.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "amV0\n"
stderr: ~ "JET_PHASE_COUNTERS {\"phase\":\"ir.build\",\"core_calls\":" # the run counts its bound Core calls
stderr: !~ "\"core_calls\":0}" # and binds at least one
step: jet build --trace=build.json main.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stderr: ~ "JET_PHASE_COUNTERS {\"phase\":\"ir.build\",\"core_calls\":0}" # a build binds none
