# A `jet run` whose live code calls C takes the full link, and binds the
# program's Core calls to the Core library's object, which that link takes
# beside the runtime pack (JetCli Host.jet jet_cli_native_executable). The
# trace counter `ir.build.core_calls` counts the Core symbols it binds there.
# Realizing the C closure needs a C toolchain, so the case runs only where
# one is installed; a_run_binds_its_core_calls_to_the_shipped_core_code.case
# holds the run that binds to the runtime image.
requires: tool:cc|gcc|clang
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_PHASE_COUNTERS=1
write: c.jet = "use base64: core.encoding.base64\n\n#Import(c) c_labs: fn(value: I64) -> I64 = \"labs\"\n\nrun: fn() {\n    print(base64.encode(\"jet\".bytes()))\n    print(c_labs(I64{-6}))\n}\n"
step: jet run --trace=c.json c.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "amV0\n6\n"
stderr: ~ "JET_PHASE_COUNTERS {\"phase\":\"ir.build\",\"core_calls\":" # a run that links C links Core's object too
stderr: !~ "\"core_calls\":0}" # and binds its Core calls there
