# Was safe_raw_nonce_json_omits_inapplicable_bounds (crypto_diagnostics.rs:155-185),
# which read E2702 `raw_nonce` for `seal(..., nonce: [0])`. Today's safe envelope
# `seal(recipients, bytes, aad)` (Core/Crypto/Crypto.jet) makes its own nonces and
# has no `nonce` parameter, so a raw nonce can't be written: the call is E0764,
# and nothing is built. No running test covers the `raw_nonce` row's omitted bounds:
# the Rust-era Compiler/JetLSP/Tests/LSP/Diagnostics.jet that claimed them never compiled
# and was removed (#6650).
fixture: fixtures/raw-nonce
step: jet check main.jet --json
exit: 1
stdout: ~ "\"code\":\"E0764\"" # the unknown-label report row
stdout: ~ "\"what\":\"`core.crypto.seal` has no parameter labelled `nonce`\"" # its registry sentence
stdout: ~ "\"fix\":\"`core.crypto.seal` accepts `recipients`, `bytes`, `aad`\"" # its fix names today's parameters
file: .jet/build absent
