# Port of tests/crypto_diagnostics.rs:110-153. The fixture passes today's
# `ikm: [U8]`. The Rust era printed one `jet.report/v1` line per diagnostic;
# `--json` now prints one `jet.status/v1` envelope with one report row per
# diagnostic, so the two rows are checked as rows of that envelope.
fixture: fixtures/multiple_e2702_diagnostics_are_independent_json_lines
env: NO_COLOR=1
step: jet check main.jet --json
exit: 1
stdout: lines = 1 # one status envelope
json: stdout doc $ valid # the envelope is one JSON document
stdout: count "\"schema\":\"jet.report/v3\"" = 2 # one report row per diagnostic
stdout: count "\"code\":\"E2702\"" = 2 # original: both lines are E2702
stdout: count "\"reason\":\"output_length\"" = 2 # original: both reasons
stdout: count "\"operation\":\"hkdf_sha256\"" = 2 # original: both operations
stdout: ~ "\"actual\":8161" # original first diagnostic's actual
stdout: ~ "\"actual\":8162" # original second diagnostic's actual
stderr: empty
file: .jet/build absent
