use core.math.[abs]
api: module {
    use core.[math.abs]
    pub use exported: core.math.abs
    local: fn(n: Int) -> Int {
        return abs(n)
    }
}
run: fn() {
    print(abs(-3))
    print(min(9, 4))
    print(max(9, 4))
    print(clamp(12, 0, 10))
    print(min(9.0, 4.0))
    print(max(9.0, 4.0))
    print(clamp(12.0, 0.0, 10.0))
    print(api.local(-7))
    print(api.exported(-5))
}
