use core.math.[abs, min, max, clamp]
module api {
    use core.[math.abs]
    pub use core.[math.abs as exported]
    fn local(n: Int) -> Int {
        return abs(n)
    }
}
fn run() {
    print(abs(-3))
    print(min(9, 4))
    print(max(9, 4))
    print(clamp(12, 0, 10))
    print(min(9.0, 4.0))
    print(max(9.0, 4.0))
    print(clamp(12.0, 0.0, 10.0))
    print(api.local(-7))
    print(api.exported(-5))
}
