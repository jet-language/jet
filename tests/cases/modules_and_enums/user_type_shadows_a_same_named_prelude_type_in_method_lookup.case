# A file type named like a prelude type (`Severity`) owns its receiver's
# methods: lookup stops at the nominal the caller's scope names, so the
# prelude's same-named type adds no second candidate (no E0772).
fixture: user_type_shadows_a_same_named_prelude_type_in_method_lookup.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet
exit: 0
stdout: = "7\nlevel 7\n"
