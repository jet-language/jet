#[Specified, Layout(U8)]
Kind: enum {
    Unit = 0
    Contract = 1
    Property = 3
}

#Layout(U8)
Mode: enum {
    Read = 1
    Write = 9
}

kind_code: fn(kind: Kind) -> Int Never! { kind.to_int() }

mode_code: fn(mode: Mode) -> Int Never! { mode.to_int() }

run: fn() {
    print(kind_code(Kind.Property))
    print(mode_code(Mode.Write))
}
