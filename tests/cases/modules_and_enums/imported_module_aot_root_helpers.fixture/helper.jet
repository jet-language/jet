sum: fn(left: Int, right: Int) -> Int { left + right }
#Error
HelperError: enum {
    Negative
}
trimmed: fn(value: String) -> String {
    return value.trim()
}
checked: fn(value: Int) -> Int HelperError! {
    assert(value >= 0)
    return Ok(value)
}
failed: fn(value: Int) -> Int HelperError! {
    if value < 0 {
        return Err(HelperError.Negative)
    }
    return Ok(value)
}
fallback_message: fn() -> String {
    return "recovered"
}
recover: fn() -> String {
    values := "".split(",").to_list()
    return values.get(1) ?? fallback_message()
}
empty_strings: fn() -> [String] {
    return [String]{}
}
reset_strings: fn() -> [String] {
    values := [String]{}
    values = [String]{}
    return values
}
