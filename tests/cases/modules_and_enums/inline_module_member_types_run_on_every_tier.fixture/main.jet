tokens: module {
    Token: distinct Int
    Cell: struct { v: Int }
    impl Cell {
        make: fn(n: Int) -> Cell { Cell{v: n} }
    }
    make: fn(n: Int) -> Token { Token.from_int(n) }
}

show: fn(t: tokens.Token) -> Int { t.raw() }

run: fn() {
    print(tokens.make(5).raw() + 1)
    print(show(tokens.Token.from_int(7)))
    print(tokens.Cell.make(3).v)
}
