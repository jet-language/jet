module tokens {
    Token :: distinct Int
    struct Cell { v: Int }
    impl Cell {
        fn make(n: Int) -> Cell { Cell{v: n} }
    }
    fn make(n: Int) -> Token { Token.from_int(n) }
}

fn show(t: tokens.Token) -> Int { t.raw() }

fn run() {
    print(tokens.make(5).raw() + 1)
    print(show(tokens.Token.from_int(7)))
    print(tokens.Cell.make(3).v)
}
