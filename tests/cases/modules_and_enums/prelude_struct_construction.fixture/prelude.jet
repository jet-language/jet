use {
    client: core.http.client
    server: core.http.server
}
build_resp: fn(body: String) -> HTTPResponse {
    return server.response(200, body)
}
build_req: fn() -> HTTPRequest {
    return client.request("GET", "http://localhost/")
}
run: fn() {
    r: build_resp("hi")
    q: build_req()
    print("built")
}
