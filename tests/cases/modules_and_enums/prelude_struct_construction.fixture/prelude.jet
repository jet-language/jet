use core.http.client as client
use core.http.server as server
fn build_resp(body: String) -> HTTPResponse {
    return server.response(200, body)
}
fn build_req() -> HTTPRequest {
    return client.request("GET", "http://localhost/")
}
fn run() {
    r :: build_resp("hi")
    q :: build_req()
    print("built")
}
