geo: module {
    START: 5
    STEP: START * 2
    GREETING: "hi"

    first: fn() -> Int { START }
    second: fn() -> Int { START + STEP }
    label: fn() -> String { "{GREETING} {STEP}" }

    inner: module {
        LIMIT: 3
        cap: fn(n: Int) -> Int { if n > LIMIT -> LIMIT else -> n }
    }
}

run: fn() {
    print("{geo.first()}")
    print("{geo.second()}")
    print(geo.label())
    print("{geo.inner.cap(9)}")
}
