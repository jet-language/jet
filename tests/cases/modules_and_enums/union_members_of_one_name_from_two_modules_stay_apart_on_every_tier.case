# A union of two types named `Point` from different modules keeps both
# members: each value is built as itself (a parameter, a return and a wider
# union widen it) and every tier prints each member's own fields.
fixture: union_members_of_one_name_from_two_modules_stay_apart_on_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = "Point { x: 1, y: 2 }\nPoint { name: harbor }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nint 7\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "Point { x: 1, y: 2 }\nPoint { name: harbor }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nint 7\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "Point { x: 1, y: 2 }\nPoint { name: harbor }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nPoint { name: quay }\nPoint { x: 3, y: 4 }\nint 7\n"
