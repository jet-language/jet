# A nested inline module's functions lift like a top-level module's: the file calls them through
# the full module path, the enclosing module names its child relatively, and a nested member calls
# its siblings and its own `priv module` child.
fixture: inline_module_nested_calls_run_on_every_tier.fixture
env: NO_COLOR=1
