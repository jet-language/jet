step: jet run main.jet
exit: 0
stdout: = "11\n20\n36\n"
step: jet run --release main.jet
exit: 0
stdout: = "11\n20\n36\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "11\n20\n36\n"
