module math {
    fn visible(n: Int) -> Int { return inner.helper(n) + 1 }
    module inner {
        fn helper(n: Int) -> Int { return n * 10 }
        fn sibling(n: Int) -> Int { return helper(n) + deep.twice(n) }
        priv module deep {
            fn twice(n: Int) -> Int { return n * 2 }
        }
    }
}

fn run() {
    print(math.visible(1))
    print(math.inner.helper(2))
    print(math.inner.sibling(3))
}
