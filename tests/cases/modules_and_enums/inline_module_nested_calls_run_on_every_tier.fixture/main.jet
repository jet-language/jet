math: module {
    visible: fn(n: Int) -> Int { return inner.helper(n) + 1 }
    inner: module {
        helper: fn(n: Int) -> Int { return n * 10 }
        sibling: fn(n: Int) -> Int { return helper(n) + deep.twice(n) }
        priv deep: module {
            twice: fn(n: Int) -> Int { return n * 2 }
        }
    }
}

run: fn() {
    print(math.visible(1))
    print(math.inner.helper(2))
    print(math.inner.sibling(3))
}
