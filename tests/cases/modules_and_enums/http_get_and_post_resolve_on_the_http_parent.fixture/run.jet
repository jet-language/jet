use http: core.http

// The one-shot `get` and `post` are members of the `core.http` parent, so the
// module alias reaches them with no nested client path.
fetch: fn(url: String) -[Net]> Bool {
    got: http.get(url) ?? return false
    sent: http.post(url, "body") ?? return false
    got.status == 200 && sent.status == 200
}

run: fn() {
    print("checked")
}
