// Enum cases and group leaves are separated as struct fields are: by a `,`
// or a line break, on one line or across many.
Point: struct { x: Int, y: Int }

Mode: enum { Fast, Safe }

Shape: enum { Circle(Float), Rect(w: Float, h: Float), Dot }

Level: enum {
    Low,
    Mid
    High,
}

Burn: enum { Fire { Hot, Scald }, Cold }

Code: enum { Ok = 0, Warn = 4, Fail = 8 }

mode_name: fn(mode: Mode) -> String {
    if mode == {
        .Fast -> "fast"
        .Safe -> "safe"
    }
}

area: fn(shape: Shape) -> Float {
    if shape == {
        .Circle(r) -> r * r
        .Rect(w, h) -> w * h
        .Dot -> 0.0
    }
}

level_rank: fn(level: Level) -> Int {
    if level == {
        .Low -> 1
        .Mid -> 2
        .High -> 3
    }
}

burn_name: fn(burn: Burn) -> String {
    if burn == {
        .Fire.Hot -> "hot"
        .Fire.Scald -> "scald"
        .Cold -> "cold"
    }
}

code_name: fn(code: Code) -> String {
    if code == {
        .Ok -> "ok"
        .Warn -> "warn"
        .Fail -> "fail"
    }
}

run: fn() {
    p: Point{x: 1, y: 2}
    print("{p.x + p.y} {mode_name(.Fast)} {mode_name(.Safe)}")
    print("{area(.Circle(2.0))} {area(.Rect(w: 2.0, h: 3.0))} {area(.Dot)}")
    print("{level_rank(.Low)} {level_rank(.Mid)} {level_rank(.High)}")
    print("{burn_name(Burn.Fire.Hot)} {burn_name(Burn.Fire.Scald)} {burn_name(.Cold)}")
    print("{code_name(.Ok)} {code_name(.Warn)} {code_name(.Fail)}")
}
