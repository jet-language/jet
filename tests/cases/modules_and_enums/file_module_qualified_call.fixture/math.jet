clamp: fn(x: Int, lo: Int, hi: Int) -> Int {
    if (x < lo) {
        return lo
    }
    if (x > hi) {
        return hi
    }
    return x
}
label: fn(prefix: String, n: Int) -> String {
    return "{prefix}:{n}"
}
checked: fn(value: Int) -> Int Err! {
    if value < 0 {
        return Err(message(value))
    }
    return Ok(value)
}
message: fn(value: Int) -> String {
    return "bad {value}"
}
ready: fn() -> Bool { true }
