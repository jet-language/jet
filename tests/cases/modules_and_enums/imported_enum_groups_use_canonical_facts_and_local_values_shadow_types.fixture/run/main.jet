
#NoPrelude
use {
    "tags"
    tags.[Choice]
    io: core.term
}
run: fn() {
    alias_empty: tags.Choice.Empty.measure()
    imported_empty: Choice.Empty.measure()
    alias_leaf: tags.Choice.Branch.Leaf(2)
    imported_tip: Choice.Branch.Nested.Tip(3)
    io.print("{alias_empty}")
    io.print("{imported_empty}")
}
