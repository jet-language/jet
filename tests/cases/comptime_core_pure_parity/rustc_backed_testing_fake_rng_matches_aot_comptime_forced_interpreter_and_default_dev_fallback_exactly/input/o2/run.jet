use testing: core.testing
testing_fake_rng_view: fn() -> String {
    first := testing.fake_rng(99)
    second := testing.fake_rng(99)
    return "{first.int(1, 100)}|{second.int(1, 100)}|{first.float()}|{second.float()}"
}
EXPECTED: comptime { testing_fake_rng_view() }

run: fn() {
    actual: testing_fake_rng_view()
    print("{EXPECTED}")
    print("{actual}")
}
