use solve: core.compute.solve
solver_render_view: fn() -> String {
    solver := solve.Solver.new(-17)
    &solver.require(true)
    &solver.require(false)
    &solver.require(false)
    return "{solver}|{solver:Debug}|{[solver]}"
}
EXPECTED: comptime { solver_render_view() }

run: fn() {
    actual: solver_render_view()
    print("{EXPECTED}")
    print("{actual}")
}
