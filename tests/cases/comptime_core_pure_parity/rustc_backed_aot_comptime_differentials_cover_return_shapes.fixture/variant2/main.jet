use xml: core.encoding.xml
xml_canonical: fn() -> String {
    tree: xml.parse("<r b=\"2\" a=\"1\"><x/></r>") ?? panic("xml")
    return xml.canonical(tree, xml.XMLCanonical{ mode: .Inclusive11, comments: false, inclusive_prefixes: [] }) ?? panic("canonical")
}
EXPECTED: #run xml_canonical()

run: fn() {
    actual: xml_canonical()
    print("{EXPECTED}")
    print("{actual}")
}
