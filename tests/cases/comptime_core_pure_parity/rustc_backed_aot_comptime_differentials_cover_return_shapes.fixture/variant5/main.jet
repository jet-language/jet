use date: core.time
date_view: fn() -> String {
    parsed: date.parse("2024-02-29") ?? panic("date")
    clamped: date.new(2024, 13, 40)
    return "{parsed.year()}-{parsed.month()}-{parsed.day()}|{parsed.to_string()}|{clamped.to_string()}"
}
EXPECTED: comptime { date_view() }

run: fn() {
    actual: date_view()
    print("{EXPECTED}")
    print("{actual}")
}
