use xml :: core.encoding.xml
fn xml_shape_reason(tree: Dyn) -> String {
    _ :: xml.canonical(tree, xml.XMLCanonical{ mode: .Inclusive11, comments: false, inclusive_prefixes: [] }) ?? {
        return err.reason
    }
    return "unexpected success"
}
EXPECTED :: comptime { xml_shape_reason(Dyn.Float(1.5)) }

fn run() {
    actual :: xml_shape_reason(Dyn.Float(1.5))
    print("{EXPECTED}")
    print("{actual}")
}
