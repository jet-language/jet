use core.net.mime as mime
fn mime_view() -> String {
    value :: mime.parse("Text/HTML; charset=UTF-8") ?? panic("mime")
    return "{value.media_type()}|{value.subtype()}|{value.essence()}|{value.param("charset") ?? "none"}|{value.params()}|{value.to_string()}"
}
EXPECTED :: prep { mime_view() }

fn run() {
    actual :: mime_view()
    print("{EXPECTED}")
    print("{actual}")
}
