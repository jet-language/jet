#Scalar scalar_marker: fn(value: Float) -> Float {
    total := 0.0
    loop i in 0..<4 {
        total += value
    }
    return total
}
simd_scalar_view: fn() -> String {
    return "{scalar_marker(2.0)}"
}
EXPECTED: comptime { simd_scalar_view() }

run: fn() {
    actual: simd_scalar_view()
    print("{EXPECTED}")
    print("{actual}")
}
