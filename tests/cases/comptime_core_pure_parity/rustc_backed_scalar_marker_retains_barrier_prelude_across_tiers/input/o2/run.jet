#Scalar fn scalar_marker(value: Float) -> Float {
    total := 0.0
    loop i in 0..<4 {
        total += value
    }
    return total
}
fn simd_scalar_view() -> String {
    return "{scalar_marker(2.0)}"
}
EXPECTED :: comptime { simd_scalar_view() }

fn run() {
    actual :: simd_scalar_view()
    print("{EXPECTED}")
    print("{actual}")
}
