// Two compile-time values call Core source functions through their loaded
// signatures; LIMIT is a plain literal, which lands as its own value with no
// compile-time fragment built for it.
use {
    core.math.abs
    core.math.gcd
}

DIVISOR: #run gcd(12, 18)

DISTANCE: #run abs(-9)

LIMIT: 40

run: fn() { print("{DIVISOR} {DISTANCE} {LIMIT} {gcd(12, 18)} {abs(-9)}") }
