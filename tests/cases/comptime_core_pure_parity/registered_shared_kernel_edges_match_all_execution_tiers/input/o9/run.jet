use time: core.time
time_plane_view: fn() -> String {
    wait: 500ms
    origin: time.instant()
    point: origin + 5min
    delta: point - origin
    speed: 12meter / 2s
    return "{wait.in(.Milliseconds)}|{delta.in(.Minutes)}"
}
EXPECTED: #run time_plane_view()

run: fn() {
    actual: time_plane_view()
    print("{EXPECTED}")
    print("{actual}")
}
