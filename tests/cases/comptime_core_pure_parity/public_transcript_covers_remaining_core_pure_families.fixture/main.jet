use {
    mime: core.net.mime
    time: core.time
    date: core.time
    datetime: core.time
}

TRANSCRIPT_0: #run { mime.from_extension(".PNG") ?? "none" }
TRANSCRIPT_1: #run { mime.extension("Text/HTML; charset=UTF-8") ?? "none" }
TRANSCRIPT_2: #run mime.parse("Text/HTML; charset=UTF-8")
TRANSCRIPT_3: #run time.period(1, 2, 3)
TRANSCRIPT_4: #run time.period_days(4)
TRANSCRIPT_5: #run time.period_months(5)
TRANSCRIPT_6: #run time.period_years(6)
TRANSCRIPT_7: #run time.parse_time("23:59:58")
TRANSCRIPT_8: #run time.parse_rfc3339("2024-02-29T12:34:56+02:30")
TRANSCRIPT_9: #run (500ms + 250ms).in(.Milliseconds)
TRANSCRIPT_10: #run 2s.in(.Milliseconds)
TRANSCRIPT_11: #run date.new(2024, 13, 40)
TRANSCRIPT_12: #run date.parse("2024-02-29")
TRANSCRIPT_13: #run datetime.from_timestamp(-1)
TRANSCRIPT_14: #run time.from_unix_ms(-1)
TRANSCRIPT_15: #run measurement(12.5, uncertainty: 0.25).value()

run: fn() {
    print("{TRANSCRIPT_0}")
    print("{TRANSCRIPT_1}")
    print("{TRANSCRIPT_2}")
    print("{TRANSCRIPT_3}")
    print("{TRANSCRIPT_4}")
    print("{TRANSCRIPT_5}")
    print("{TRANSCRIPT_6}")
    print("{TRANSCRIPT_7}")
    print("{TRANSCRIPT_8}")
    print("{TRANSCRIPT_9}")
    print("{TRANSCRIPT_10}")
    print("{TRANSCRIPT_11}")
    print("{TRANSCRIPT_12}")
    print("{TRANSCRIPT_13}")
    print("{TRANSCRIPT_14}")
    print("{TRANSCRIPT_15}")
}
