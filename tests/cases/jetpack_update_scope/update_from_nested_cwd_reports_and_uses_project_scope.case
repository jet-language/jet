# Port of tests/jetpack_update_scope.rs:10-58: `jetpack update` from a nested
# directory finds the project above it, reports that root, and locks the
# project's channel there. A bare update plans both scopes (see
# jetpack_update_plan/combined_update_plans_both_scopes_before_one_confirmation),
# so the user-tools scope line is expected too.
fixture: update_from_nested_cwd_reports_and_uses_project_scope.fixture
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
env: HOME={work}/home
mkdir: root
mkdir: home
mkdir: src/nested
step: jetpack update --no-color --yes --fixtures {work}/channels
cwd: src/nested
exit: 0
stderr: ~ "scope: project dependencies ({work})"
file: .jet/lock ~ "exact = \"github:acme/tools#v1.2.0\""
file: src/nested/.jet absent
