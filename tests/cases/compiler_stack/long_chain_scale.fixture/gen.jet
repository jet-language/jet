// Writes the two programs a long-chain case compiles, for the size its
// first argument names: sum.jet prints an `a + a + …` sum of that many
// terms (each `+` nests its left operand one level deeper), list.jet the
// length of a list literal of that many elements.
use core.files
use core.process.[args]

fn run() {
    given :: args()
    if given.len() != 1 -> panic("gen.jet takes one size: 1000, 10000 or 100000")
    count :: if given[0] == {
        "1000" -> 1000
        "10000" -> 10000
        "100000" -> 100000
        else -> panic("gen.jet takes one size: 1000, 10000 or 100000")
    }
    terms := [String]{}
    elements := [String]{}
    loop index in 0..<count {
        &terms.push("a")
        &elements.push("{index % 10}")
    }
    sum :: terms.join(" + ")
    list :: elements.join(", ")
    files.write("sum.jet", "fn run() {{\n    a :: 1\n    print({sum})\n}}\n") ?? panic("gen.jet: write sum.jet: {err}")
    files.write("list.jet", "fn run() {{\n    xs :: [Int]{{{list}}}\n    print(xs.len())\n}}\n") ?? panic("gen.jet: write list.jet: {err}")
}
