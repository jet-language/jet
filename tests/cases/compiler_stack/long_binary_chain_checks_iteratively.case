# #6072: a 1,000-term `a + a + …` sum (each `+` nests its left operand) and a
# 1,000-element list literal check and run on O0 and O1 within the default
# main-thread stack; sema checks the operator chain as a loop.
fixture: long_binary_chain_checks_iteratively.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step o0: jet run --optimize=none main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = "1000\n1000\n999\n"
stderr: = ""
step o1: jet run --optimize=basic main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = "1000\n1000\n999\n"
stderr: = ""
