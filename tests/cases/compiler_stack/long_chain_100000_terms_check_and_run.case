# A 100,000-term `a + a + …` sum (each `+` nests its left operand one
# level deeper) and a 100,000-element list literal, both written by gen.jet,
# check and run on O0 and O1: the compiler walks an operator chain with no
# stack per operator, on a compile thread whose stack holds the rest.
fixture: long_chain_scale.fixture
env: NO_COLOR=1
step: jet run --allow=FS gen.jet 100000
exit: 0
stdout: = ""
step sum_check: jet check sum.jet
exit: 0
step list_check: jet check list.jet
exit: 0
step sum_o0: jet run -O0 sum.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = "100000\n"
stderr: = ""
step sum_o1: jet run -O1 sum.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = "100000\n"
stderr: = ""
step list_o0: jet run -O0 list.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = "100000\n"
stderr: = ""
step list_o1: jet run -O1 list.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = "100000\n"
stderr: = ""
