
fn own_first(values: [Int]) -> [Int] {
    return values[0..0].copy()
}

fn run() {
    values := [1, 2]
    copied := own_first(values)
    values[0] = 8
    copied[0] = 9
    print(values[0])
    print(copied[0])

    nested := [[1, 2], [3, 4]]
    nested_copy := nested[0..0].copy()
    nested[0][0] = 6
    nested_copy[0][0] = 7
    print(nested[0][0])
    print(nested_copy[0][0])
}
