# PORT tests/jet_perf_trace_parts/capture_run.rs:1-122; all six honest helpers from support.rs129-345 preserved in honesty.jet.
# PENDING-GRAMMAR(batch-four); PENDING-SAME-HEAD, not a reference snapshot.
# have_rustc is toolchain-availability, erased per owner; no replacement skip.
fixture: perf_run_captures_wall_and_alloc_into_jettrace.fixture
mkdir: honesty
copy: {root}/tests/cases/jet_perf_trace_parts/fixtures/honesty.jet honesty/honesty.jet
write: session.jet session.jet.txt
step: jet perf run session.jet --out run-capture.jettrace
exit: 0
stderr: ~ "trace:"
file: run-capture.jettrace is-file
step: jet test honesty/honesty.jet
env: S6_TRACE={work}/run-capture.jettrace
env: S6_CAPTURE_MODE=run
exit: 0
file: run-capture.jettrace ~ "\"name\":\"probe_work\"" # Original parsed non-entry identity.
file: run-capture.jettrace ~ "\"name\":\"run\""
file: run-capture.jettrace ~ "session.jet"
file: run-capture.jettrace !~ "\"duration_ns\":1," # Original anti-fabrication predicate.
file: run-capture.jettrace !~ "\"count\":0," # Original zero-alloc scrape rejection.
step: jet perf view run-capture.jettrace
exit: 0
stdout: ~ "sample wall"
stdout: ~ "alloc count="
stdout: !~ "alloc count=0 "
stdout: ~ "tasks count="
stdout: ~ "children="
stdout: !~ "tasks count=0 "
stdout: ~ "locks count="
stdout: ~ "waiters="
stdout: !~ "locks count=0 "
stdout: ~ "io count="
stdout: !~ "io count=0 "
stdout: ~ "native process_cpu="
stdout: ~ "spans count="
stdout: ~ "window="
stdout: ~ "target="
stdout: ~ "session.jet#run"
stdout: ~ "command run"
