
use core.sys as env

trait Measure {
    fn measure(self) -> Int
}

struct Parcel {
    n: Int
}

impl Parcel.Measure {
    fn measure(self) -> Int {
        value :: env.get("JET_CARD_2835") ?? ""
        return self.n
    }
}

fn via<T: Measure>(value: T) -> Int { value.measure() }

fn run() {
    print(via(Parcel{n: 5}))
}
