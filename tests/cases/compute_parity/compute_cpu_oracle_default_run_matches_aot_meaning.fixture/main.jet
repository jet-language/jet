
use compute: core.compute

run: fn() {
    a: compute.from_list([1.0, 2.0, 3.0]) ?? panic("a")
    b: compute.from_list([4.0, 5.0, 6.0]) ?? panic("b")
    sum: compute.add(a, b) ?? panic("sum")
    print("sum:{compute.to_list(sum)}")

    matrix: compute.full([2, 2], 2.0) ?? panic("matrix")
    identity: compute.eye(2) ?? panic("eye")
    product: compute.matmul(matrix, identity) ?? panic("matmul")
    print("product:{compute.to_list(product)}")

    tensor := compute.from_list([1.0, 2.0, 3.0, 4.0]) ?? panic("tensor")
    compute.set(tensor, [1], 9.0) ?? panic("set")
    print("edited:{compute.to_list(tensor)}")

    wire: compute.serialize(product) ?? panic("wire")
    round: compute.deserialize(wire) ?? panic("round")
    print("round:{compute.to_list(round)}")

    if compute.deserialize("shape=2;data=1") == {
        .Ok(value) -> { print("corrupt:accepted") }
        .Err(error) -> { print("corrupt:rejected") }
    }

    if compute.deserialize("shape=02;data=1.0,1.0") == {
        .Ok(value) -> { print("axis:accepted") }
        .Err(error) -> { print("axis:rejected") }
    }

    if compute.deserialize("shape=1;data=1.0;data=1.0") == {
        .Ok(value) -> { print("field:accepted") }
        .Err(error) -> { print("field:rejected") }
    }

    if compute.deserialize("shape=1;data=1.0;profile=F64Strict+Reproducible;checksum=0000000000000000") == {
        .Ok(value) -> { print("checksum:accepted") }
        .Err(error) -> { print("checksum:rejected") }
    }

    if compute.kernel_bounds_ok([2, 3], [2, 0]) == {
        .Ok(value) -> { print("bounds:accepted") }
        .Err(error) -> { print("bounds:rejected") }
    }

    empty: compute.full([0, 3], 1.0) ?? panic("empty")
    print("empty:{compute.shape(empty)}:{compute.to_list(empty)}")
    empty_other: compute.full([1, 3], 2.0) ?? panic("empty_other")
    if compute.add(empty, empty_other) == {
        .Ok(value) -> { print("empty_broadcast:{compute.shape(value)}:{compute.to_list(value)}") }
        .Err(error) -> { print("empty_broadcast:rejected") }
    }

    left_shape: compute.full([2, 2], 1.0) ?? panic("left_shape")
    right_shape: compute.full([3], 1.0) ?? panic("right_shape")
    if compute.add(left_shape, right_shape) == {
        .Ok(value) -> { print("broadcast:accepted") }
        .Err(error) -> { print("broadcast:rejected") }
    }

    if compute.full([9223372036854775807, 2], 1.0) == {
        .Ok(value) -> { print("overflow:accepted") }
        .Err(error) -> { print("overflow:rejected") }
    }

    if compute.get(tensor, [4]) == {
        .Ok(value) -> { print("tensor_bounds:accepted") }
        .Err(error) -> { print("tensor_bounds:rejected") }
    }
}
