// The row lists FFI.C, IO and Mem.Alloc, yet `run` calls C, which may do anything.
package: {
    name: "listed"
    authority: { allow: [FFI.C, IO, Mem.Alloc] }
}

use c: c.c
#Import c.c: module {
    getpid: fn() -> I32 = "getpid"
}

run: fn() {
    pid: c.getpid()
    print("pid>0={pid > I32{0}}")
}
