# Claim: a typed `run: fn(args: T)` uses no effect of its own through the
# generated parser (`__jet_cli_parse` reads argv and its env fallback, prints
# help, exits on a refusal), so the run names none, while the entry's own
# `exit` and environment read are its effects and the notice names them
# (Pipeline.jet jet_driver_required_effects).
fixture: typed_cli_entry_parser_effects_are_never_noticed.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run parsed/run.jet -- --name Ada
exit: 0 # default: the parser's effects are never named
stdout: = "hello Ada\n" # default: the parser's effects are never named
stderr: !~ "note:" # default: the parser's effects are never named
step: jet run parsed/run.jet --
env: CLI_GREETING=env
exit: 0 # default: the env fallback is never named
stdout: = "hello env\n" # default: the env fallback is never named
stderr: !~ "note:" # default: the env fallback is never named
step: jet run parsed/run.jet -- --bogus
exit: 2 # default: a refusal exits through the parser
stdout: = "" # default: a refusal exits through the parser
stderr: !~ "E1803" # default: a refusal exits through the parser
stderr: !~ "note:" # default: a refusal exits through the parser
step: jet run --release parsed/run.jet -- --name Ada
exit: 0 # release: the parser's effects are never named
stdout: = "hello Ada\n" # release: the parser's effects are never named
stderr: !~ "note:" # release: the parser's effects are never named
step: jet run exits/run.jet
exit: 3 # default: the entry's own exit runs
stdout: = "exiting\n" # default: the entry's own exit runs
stderr: ~ "note: " # default: the notice names the entry's own exit
stderr: ~ "(-A hides this)" # default: the notice names the entry's own exit
step: jet run --release exits/run.jet
exit: 3 # release: the entry's own exit runs
stdout: = "exiting\n" # release: the entry's own exit runs
stderr: ~ "(-A hides this)" # release: the notice names the entry's own exit
step: jet run envs/run.jet
exit: 0 # default: the entry's own env read runs
stderr: ~ "reads environment variables (-A hides this)" # default: the notice names the entry's own env read
step: jet run --release envs/run.jet
exit: 0 # release: the entry's own env read runs
stderr: ~ "reads environment variables (-A hides this)" # release: the notice names the entry's own env read
