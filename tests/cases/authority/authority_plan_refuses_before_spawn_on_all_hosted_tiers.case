# Claim: spec.plan returns Ok without spawning; marker file absent
# Fixture migrated: the marker path is the program's argument, {work}/plan-marker (Rust used temp_dir + pid)
# Not ported: Rust expected spawned only on linux/macos with Strong native sandbox, else refused; spec uses Strong-branch value spawned\n; host sandbox level not detected by spec
fixture: authority_plan_refuses_before_spawn_on_all_hosted_tiers.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet {work}/plan-marker
exit: 0 # plan Ok on linux Strong
stdout: = "spawned\n" # plan Ok on linux Strong
file: plan-marker absent # plan did not spawn
step o1: jet run -O1 main.jet {work}/plan-marker
exit: 0 # plan Ok on linux Strong
stdout: = "spawned\n" # plan Ok on linux Strong
file: plan-marker absent # plan did not spawn
step o2: jet run -O2 main.jet {work}/plan-marker
exit: 0 # plan Ok on linux Strong
stdout: = "spawned\n" # plan Ok on linux Strong
file: plan-marker absent # plan did not spawn
