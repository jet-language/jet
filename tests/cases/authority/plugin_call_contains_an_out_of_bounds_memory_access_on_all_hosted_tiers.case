# Claim: a guest load that crosses the end of its linear memory and a store at a wrapped
# address (-8) each fail as a Guest fault ("out of bounds memory access") at that export,
# never touch host memory, and the host keeps running; an in-bounds call still returns.
fixture: plugin_call_contains_an_out_of_bounds_memory_access_on_all_hosted_tiers.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet
exit: 0
stdout: = "peek:contained\npoke:contained\nok:7\nhost:still-running\n"
step: jet run --release main.jet
exit: 0
stdout: = "peek:contained\npoke:contained\nok:7\nhost:still-running\n"
