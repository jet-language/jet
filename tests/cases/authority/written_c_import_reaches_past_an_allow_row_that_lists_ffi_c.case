# Claim (#6281 c146): a C call that no binding descriptor owns reaches every
# effect, so a written package `allow` row is a ceiling over it even when the
# row lists `FFI.C`: `allow: [FFI.C, IO, Mem.Alloc]` is refused with E0749,
# naming the roots outside the row and the function that calls C. A row that
# lists every root holds the same call.
fixture: written_c_import_reaches_past_an_allow_row_that_lists_ffi_c.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step listed: jet check listed/run.jet
exit: 1 # the row lists FFI.C, IO and Mem.Alloc, and C may do anything
stderr: ~ "E0749" # the package row is the ceiling
stderr: ~ "reaches the `Browser, DB, Env, Exec, FFI, FS, GPU, Log, Meta, Net, Rand, Secret, Time` effect" # every root the row leaves out
stderr: ~ "calls a C binding no descriptor owns" # the reason is the unseen C body
stderr: ~ "Call chain:" # names the call chain
step every: jet check every/run.jet
exit: 0 # a row that lists every root holds the call
