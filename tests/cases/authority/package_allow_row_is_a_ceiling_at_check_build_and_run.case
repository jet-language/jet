# Claim: a written `authority` `allow` row is a ceiling over the package's own
# code. Reaching an effect it leaves out is E0749 with the call chain from
# `jet check`, `jet build` and `jet run`, before anything runs, and `-A` does
# not widen a written row. A row that covers what the program reaches runs
# with no notice.
fixture: package_allow_row_is_a_ceiling_at_check_build_and_run.fixture
env: NO_COLOR=1
env: HOME={work}
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check over/over.jet
exit: 1 # check: the environment read is outside the row
stdout: empty
stderr: ~ "E0749" # check: the ceiling's code
stderr: ~ "`Env`" # check: names the effect
stderr: ~ "Call chain:" # check: names the call chain
stderr: ~ "home_set" # check: the chain reaches the function that reads
stderr: ~ "authority.allow" # check: the fix names the row
step: jet build over/over.jet
exit: 1 # build: the same refusal
stderr: ~ "E0749" # build: the ceiling's code
stderr: ~ "`Env`" # build: names the effect
step: jet run over/over.jet
exit: 1 # run: refused before the program starts
stdout: = "" # run: no user code ran
stderr: ~ "E0749" # run: the ceiling's code
stderr: !~ "hides this" # run: a ceiling overrun is an error, not a notice
step: jet run -A over/over.jet
exit: 1 # -A: a written row is not widened by the command line
stdout: = "" # -A: no user code ran
stderr: ~ "E0749" # -A: the ceiling's code
step: jet run covered/covered.jet
exit: 0 # covered: the row lists the read
stdout: = "home set: true\n" # covered: the program ran
stderr: !~ "note:" # covered: a row that covers what it reaches prints no notice
