# Claim (#6281 c146): a foreign call is held to the package's written `allow`
# row by the effects it has. An undescribed call into the C library `c` has
# `FFI.C("c")` (#6281 c181), the explicit opt-in to "this library's code may
# do anything": a row without it is refused with E0749 naming
# `FFI.C("c")`, and a row with it runs. `FFI.C("c")` never covers a
# Jet-side effect: a Jet call reaching Net under `allow: [FFI.C("c"), IO,
# Mem.Alloc]` is refused with E0749 naming Net.
fixture: written_c_import_is_held_to_its_allow_row.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step omitted: jet check omitted/run.jet
exit: 1 # the row leaves out FFI.C("c")
stderr: ~ "E0749" # the package row is the ceiling
stderr: ~ "reaches the `FFI.C(\"c\")` effect" # the C call's own effect is named
step listed: jet run listed/run.jet
exit: 0 # the row lists FFI.C("c"), so the C call is inside it
stdout: = "pid>0=true\n"
step jet_side: jet check jet_side/run.jet
exit: 1 # FFI.C("c") does not hold the Jet call to `net.tcp_connect`
stderr: ~ "E0749" # the package row is the ceiling
stderr: ~ "reaches the `Net` effect" # the Jet-side effect is named
stderr: !~ "reaches the `FFI.C(\"c\")` effect" # the C call itself is inside the row
