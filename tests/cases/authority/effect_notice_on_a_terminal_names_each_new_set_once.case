# Claim (#6614 c3): on a terminal, `jet run` names the
# program's unacknowledged effects in one stderr line before it runs, says
# nothing on a rerun with the same set, and names the set again once an edit
# makes the program reach a new effect. The last set named is kept per entry
# under $XDG_STATE_HOME/jet/effects.
fixture: effect_notice_on_a_terminal_names_each_new_set_once.fixture
requires: os:unix
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: XDG_STATE_HOME={work}/state
step first: jet run tool.jet
pty: true
exit: 0
stdout: ~ "env read: true" # the program ran
stdout: ~ "note: tool.jet reads environment variables (-A hides this)" # the first run names the set
entries: state/jet/effects >= 1 # the set named is kept for the next run
step same: jet run tool.jet
pty: true
exit: 0
stdout: ~ "env read: true" # the program ran
stdout: !~ "note:" # the same set is not named twice
copy: tool_with_clock.jet.txt tool.jet
step changed: jet run tool.jet
pty: true
exit: 0
stdout: ~ "env read: true" # the program ran
stdout: ~ "note: tool.jet " # the changed set is named again
stdout: ~ "reads the clock (-A hides this)" # including the new effect
step changed_again: jet run tool.jet
pty: true
exit: 0
stdout: !~ "note:" # and only once
