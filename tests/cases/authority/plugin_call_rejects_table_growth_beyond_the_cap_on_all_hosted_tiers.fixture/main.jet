
use core.plugin as plugin

fn run() {
    policy :: Authority.from_rights(["FS.Read:."])
    hostile :: plugin.load("table.wat", policy)
    _result :: hostile.grow() ?? {
        print("table-bound-failure")
        if err == {
            .Budget(_, fault) -> {
                assert(fault.export == "grow")
                assert(fault.frames.len() > 0 && fault.frames.len() <= 32)
                print("Budget")
            }
            else -> assert(false)
        }
        print(err)
        return
    }
    print("guest-returned")
    print(_result)
}
