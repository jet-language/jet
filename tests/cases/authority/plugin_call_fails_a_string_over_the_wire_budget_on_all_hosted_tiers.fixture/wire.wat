;; String exports for the plugin wire budget. `size` takes a string and returns
;; its length; `big` returns a string of 1048577 bytes and `small` one of 3
;; bytes, both from in-bounds memory, so only the wire budget refuses `big`.
(component
  (core module $m
    (memory (export "memory") 18)
    (global $heap (mut i32) (i32.const 1114120))
    (data (i32.const 65536) "abc")
    (func $realloc (export "cabi_realloc") (param $ptr i32) (param $old i32) (param $align i32) (param $new i32) (result i32)
      (local $p i32)
      (local.set $p (global.get $heap))
      (global.set $heap (i32.add (local.get $p) (local.get $new)))
      (local.get $p))
    (func $size (export "size") (param $text i32) (param $length i32) (result i64)
      (i64.extend_i32_u (local.get $length)))
    (func $big (export "big") (result i32)
      (i32.store (i32.const 0) (i32.const 65536))
      (i32.store (i32.const 4) (i32.const 1048577))
      (i32.const 0))
    (func $small (export "small") (result i32)
      (i32.store (i32.const 8) (i32.const 65536))
      (i32.store (i32.const 12) (i32.const 3))
      (i32.const 8)))
  (core instance $i (instantiate $m))
  (type $size-type (func (param "text" string) (result s64)))
  (func $size (type $size-type)
    (canon lift (core func $i "size") (memory $i "memory") (realloc (func $i "cabi_realloc"))))
  (type $text-type (func (result string)))
  (func $big (type $text-type)
    (canon lift (core func $i "big") (memory $i "memory") (realloc (func $i "cabi_realloc"))))
  (func $small (type $text-type)
    (canon lift (core func $i "small") (memory $i "memory") (realloc (func $i "cabi_realloc"))))
  (export "size" (func $size))
  (export "big" (func $big))
  (export "small" (func $small)))
