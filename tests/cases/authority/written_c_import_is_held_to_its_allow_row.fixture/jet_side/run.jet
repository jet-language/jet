// `FFI.C("c")` covers the C call only, never a Jet-side effect: `dial` uses
// Net.
package: {
    name: "jet_side"
    authority: { allow: [FFI.C("c"), IO, Mem.Alloc] }
}

use {
    c: c.c
    net: core.net
}
#Import c.c: module {
    getpid: fn() -> I32 = "getpid"
}

dial: fn() {
    stream: net.tcp_connect("127.0.0.1:9") ?? return
    stream.close() ?? return
}

run: fn() {
    pid: c.getpid()
    print("pid>0={pid > I32{0}}")
    dial()
}
