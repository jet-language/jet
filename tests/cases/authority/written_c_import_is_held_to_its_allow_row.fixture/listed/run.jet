// The row lists FFI.C("c"), the opt-in to an undescribed call into the C
// library `c`, and IO for `print`.
package: {
    name: "listed"
    authority: { allow: [FFI.C("c"), IO, Mem.Alloc] }
}

use c: c.c
#Import c.c: module {
    getpid: fn() -> I32 = "getpid"
}

run: fn() {
    pid: c.getpid()
    print("pid>0={pid > I32{0}}")
}
