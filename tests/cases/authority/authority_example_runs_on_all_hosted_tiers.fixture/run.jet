// D-AUTHORITY-WORD2=E: Authority is the one rights value that crosses
// process, plugin, and session boundaries. It only narrows.
use process :: core.process

struct Holder {
    grant: Authority
}

fn run() {
    #FX(grant: Exec, IO) {
        // `.under(grant)` delegates the scoped grant to the specification, so
        // the specification is built and run inside this #FX region.
        result :: process.cmd(["printf", "authority"]).stdout(.Capture).stderr(.Capture).under(grant).run() ?? panic("authority process")
        print(result.output)
    }
}
