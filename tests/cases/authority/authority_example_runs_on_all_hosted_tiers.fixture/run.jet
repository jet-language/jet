// D-AUTHORITY-WORD2=E: Authority is the one rights value that crosses
// process, plugin, and session boundaries. It only narrows.
use core.process as process

struct Holder {
    grant: Authority
}

fn run() -[Exec, IO]> {
    #FX(grant: Exec, IO) {
        // Consume the authority-bound specification inside this #FX region;
        // do not retain a command builder beyond the scoped grant.
        result :: process.run_spec(process.cmd(["echo", "authority"]).under(grant)) ?? panic("authority process")
        print(result.success)
    }
}
