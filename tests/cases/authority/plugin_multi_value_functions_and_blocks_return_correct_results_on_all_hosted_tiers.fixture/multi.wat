;; Multi-value core code behind single-result exports: functions with
;; several results, called directly, through a table and from another such
;; function, and blocks, ifs and loops that take params and give several
;; results.
(component
  (core module $multi
    (type $pair (func (param i64 i64) (result i64 i64)))
    (table 2 funcref)
    (elem (i32.const 0) $divmod $swap)
    ;; Quotient and remainder, as two results.
    (func $divmod (type $pair)
      (i64.div_s (local.get 0) (local.get 1))
      (i64.rem_s (local.get 0) (local.get 1)))
    (func $swap (type $pair)
      (local.get 1)
      (local.get 0))
    ;; Returns the two results of a call it makes.
    (func $flip (type $pair)
      (call $swap (call $divmod (local.get 0) (local.get 1))))
    ;; An i32, an f64 and an i64 together.
    (func $mixed (param i64) (result i32 f64 i64)
      (i32.wrap_i64 (local.get 0))
      (f64.convert_i64_s (local.get 0))
      (i64.mul (local.get 0) (i64.const 2)))
    ;; Each pair export answers first * 1000 + second.
    (func (export "divmod") (param i64 i64) (result i64) (local $second i64)
      (call $divmod (local.get 0) (local.get 1))
      (local.set $second)
      (i64.const 1000)
      (i64.mul)
      (local.get $second)
      (i64.add))
    (func (export "indirect") (param i64 i64 i64) (result i64) (local $second i64)
      (call_indirect (type $pair) (local.get 0) (local.get 1) (i32.wrap_i64 (local.get 2)))
      (local.set $second)
      (i64.const 1000)
      (i64.mul)
      (local.get $second)
      (i64.add))
    (func (export "chain") (param i64 i64) (result i64) (local $second i64)
      (call $flip (local.get 0) (local.get 1))
      (local.set $second)
      (i64.const 1000)
      (i64.mul)
      (local.get $second)
      (i64.add))
    ;; A block that takes two params and gives two results.
    (func (export "swapped") (param i64 i64) (result i64) (local $low i64)
      (local.get 0)
      (local.get 1)
      (block (param i64 i64) (result i64 i64)
        (call $swap))
      (local.set $low)
      (i64.const 10)
      (i64.mul)
      (local.get $low)
      (i64.add))
    ;; An if whose arms each give two results.
    (func (export "pick") (param i64) (result i64) (local $tag i64)
      (if (result i64 i64) (i64.gt_s (local.get 0) (i64.const 0))
        (then (local.get 0) (i64.const 1))
        (else (i64.sub (i64.const 0) (local.get 0)) (i64.const 2)))
      (local.set $tag)
      (i64.const 10)
      (i64.mul)
      (local.get $tag)
      (i64.add))
    ;; A br_if that carries two values out of its block.
    (func (export "early") (param i64) (result i64)
      (block (result i64 i64)
        (i64.const 7)
        (i64.const 8)
        (br_if 0 (i32.wrap_i64 (local.get 0)))
        (drop)
        (drop)
        (i64.const 1)
        (i64.const 2))
      (i64.add))
    ;; A loop whose two params carry the sum and the counter round.
    (func (export "sum") (param i64) (result i64) (local $n i64)
      (i64.const 0)
      (local.get 0)
      (loop (param i64 i64) (result i64 i64)
        (local.set $n)
        (i64.add (local.get $n))
        (local.tee $n (i64.sub (local.get $n) (i64.const 1)))
        (br_if 0 (i64.gt_s (local.get $n) (i64.const 0))))
      (drop))
    (func (export "mixed") (param i64) (result i64) (local $wide i64) (local $whole i64)
      (call $mixed (local.get 0))
      (local.set $wide)
      (local.set $whole (i64.trunc_f64_s))
      (i64.extend_i32_s)
      (local.get $whole)
      (i64.add)
      (local.get $wide)
      (i64.add)))
  (core instance $guest (instantiate $multi))
  (type $one (func (param "x" s64) (result s64)))
  (type $two (func (param "a" s64) (param "b" s64) (result s64)))
  (type $three (func (param "a" s64) (param "b" s64) (param "k" s64) (result s64)))
  (func $divmod (type $two) (canon lift (core func $guest "divmod")))
  (func $indirect (type $three) (canon lift (core func $guest "indirect")))
  (func $chain (type $two) (canon lift (core func $guest "chain")))
  (func $swapped (type $two) (canon lift (core func $guest "swapped")))
  (func $pick (type $one) (canon lift (core func $guest "pick")))
  (func $early (type $one) (canon lift (core func $guest "early")))
  (func $sum (type $one) (canon lift (core func $guest "sum")))
  (func $mixed (type $one) (canon lift (core func $guest "mixed")))
  (export "divmod" (func $divmod))
  (export "indirect" (func $indirect))
  (export "chain" (func $chain))
  (export "swapped" (func $swapped))
  (export "pick" (func $pick))
  (export "early" (func $early))
  (export "sum" (func $sum))
  (export "mixed" (func $mixed)))
