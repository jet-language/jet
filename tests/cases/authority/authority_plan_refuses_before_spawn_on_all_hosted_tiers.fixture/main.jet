
use process: core.process
use core.process.[args]

// The marker path is the first argument, inside the case's work directory.
run: fn() {
    marker: args()[0]
    policy: process.workspace()
    spec: process.cmd(["sh", "-c", "printf spawned > {marker}"]).cwd("/").under(policy)
    if spec.plan() == {
        .Ok(_) -> print("spawned")
        .Err(_) -> print("refused")
    }
}
