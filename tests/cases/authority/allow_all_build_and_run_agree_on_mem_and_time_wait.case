# `jet build -A` and `jet run -A` accept and refuse the same programs: a
# program whose rows require Mem and Time.Wait builds and runs under `-A`, as a
# loose file and under a package whose `authority` allows Env, Net and Time, the
# built binary prints what the run prints, and a `--deny` of either right stops
# both paths with the same E1803.
fixture: allow_all_build_and_run_agree_on_mem_and_time_wait.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run -A wait.jet
exit: 0
stdout: = "waited 2\n"
step: jet build -A wait.jet
exit: 0
step: built
exit: == run
stdout: == run
step: jet run -A --deny=Time.Wait wait.jet
exit: 1
stderr: ~ "Application authority denies `Time.Wait`" # the run refuses before it launches
step: jet build -A --deny=Time.Wait wait.jet
exit: 1
stderr: ~ "Application authority denies `Time.Wait`" # the build refuses the same right before it builds
step: jet run -A --deny=Mem wait.jet
exit: 1
stderr: ~ "Application authority denies `Mem`" # the run refuses before it launches
step: jet build -A --deny=Mem wait.jet
exit: 1
stderr: ~ "Application authority denies `Mem`" # the build refuses the same right before it builds
step package: jet run -A main.jet
cwd: app
exit: 0
stdout: = "waited 2\n"
step: jet build -A main.jet
cwd: app
exit: 0
step: built
cwd: app
exit: == package
stdout: == package
