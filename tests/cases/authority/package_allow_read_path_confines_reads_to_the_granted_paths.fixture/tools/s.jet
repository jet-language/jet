// Reads each argument and prints its first line, or why the read failed.
use {
    files: core.files
    process: core.process
}

run: fn() {
    loop path in process.args() {
        text: files.read(path.copy()) ?? {
            print("{path}: {err}")
            next
        }
        print("{path}: {text.trim()}")
    }
}
