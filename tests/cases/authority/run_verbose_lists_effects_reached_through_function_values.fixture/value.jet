// A function that runs only through a value: a named function stored in a
// list, and a trait method called through a trait value.
use files: core.files

peek: fn(x: Int) -> Int {
    text: files.read("value.jet") ?? ""
    text.len() + x
}

Shape: trait {
    area: fn(self) -> Int
}

Note: struct {
    side: Int

    impl Shape {
        area: fn(self) -> Int {
            files.write("area.txt", "{self.side}") ?? panic("write failed")
            self.side * self.side
        }
    }
}

measure: fn(shape: Shape) -> Int { shape.area() }

run: fn() {
    table: [fn(Int) -> Int]{peek}
    f: table[0]
    print("read: {f(0) > 0}")
    print("area: {measure(Note{side: 3})}")
}
