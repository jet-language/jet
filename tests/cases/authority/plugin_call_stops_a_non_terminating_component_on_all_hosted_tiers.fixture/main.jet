
use plugin: core.plugin

run: fn() {
    policy: Authority.from_rights(["FS.Read:."])
    hostile: plugin.load("non_terminating.wat", policy)
    _result: hostile.spin() ?? {
        print("execution-bound-failure")
        if err == {
            .Budget(.Fuel, fault) -> {
                assert(fault.export == "spin")
                assert(fault.frames.len() > 0 && fault.frames.len() <= 32)
                print("Budget")
            }
            .Guest(_) | .Denied(_) | .Budget(.Memory, _) | .Budget(.Table, _) | .Budget(.Time, _) | .Budget(.Wire, _) | .Defect(_) -> assert(false)
        }
        print(err)
        return
    }
    print("guest-returned")
    print(_result)
}
