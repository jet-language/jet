
fn erased() {
    #Off {
        #FX(authority: FS.Read) {
            print("erased")
        }
    }
    authority :: Authority.workspace()
    authority.with("FS.Write")
}

fn active() {
    #FX(authority: FS.Read) {
        print("active")
    }
    authority :: Authority.workspace()
    authority.with("FS.Write")
}

fn run() {}
