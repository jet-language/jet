# `FFI.C("nativeffi")` in `authority.allow` is the foreign-call effect
# `FFI.C` with a library argument; E1221 says so and asks for the bare right,
# not "a parameterized memory denial" with a `Mem.Alloc` fix (#6281 c144).
fixture: ffi_library_argument_in_allow_is_a_foreign_call_effect.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 1
stderr: ~ "E1221" # the authority block is refused
stderr: ~ "is the foreign-call effect `FFI.C` with a library argument" # named as a foreign call
stderr: ~ "so write `FFI.C`" # the fix is the bare right
stderr: !~ "memory denial" # not a memory denial
