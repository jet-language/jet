# Claim (#5949 c6): `jet run --verbose -A` prints one stderr line listing the
# effects the program uses; without `--verbose` the line is absent.
fixture: run_verbose_allow_all_lists_the_effects_used.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step verbose: jet run --verbose -A spawn.jet
exit: 0
stdout: = "child ran: true\n"
stderr: = "jet run: effects used: Exec, IO\n"
step plain: jet run -A spawn.jet
exit: 0
stdout: = "child ran: true\n"
stderr: = ""
