(component
  (core module $m
    (type $pair (func (param i64 i64) (result i64 i64)))
    (table 1 funcref)
    (elem (i32.const 0) func $divmod)
    ;; Quotient and remainder: two results.
    (func $divmod (type $pair)
      (i64.div_s (local.get 0) (local.get 1))
      (i64.rem_s (local.get 0) (local.get 1)))
    ;; Both results of a two-result `if`.
    (func $order (param i64 i64) (result i64 i64)
      (if (result i64 i64) (i64.lt_s (local.get 0) (local.get 1))
        (then (local.get 0) (local.get 1))
        (else (local.get 1) (local.get 0))))
    ;; Two results through an early `return`.
    (func $swap (param i64 i64) (result i64 i64)
      (local.get 1)
      (local.get 0)
      (return)
      (i64.const 0)
      (i64.const 0))
    ;; Three results of three types.
    (func $mixed (result i32 f64 i64)
      (i32.const 7)
      (f64.const 2.5)
      (i64.const 1000))
    (func (export "direct") (result i64) (local $q i64) (local $r i64)
      (call $divmod (i64.const 47) (i64.const 5))
      (local.set $r)
      (local.set $q)
      (i64.add (i64.mul (local.get $q) (i64.const 100)) (local.get $r)))
    (func (export "indirect") (result i64) (local $q i64) (local $r i64)
      (call_indirect (type $pair) (i64.const 100) (i64.const 7) (i32.const 0))
      (local.set $r)
      (local.set $q)
      (i64.add (i64.mul (local.get $q) (i64.const 100)) (local.get $r)))
    (func (export "pick") (result i64) (local $lo i64) (local $hi i64)
      (call $order (i64.const 9) (i64.const 2))
      (local.set $hi)
      (local.set $lo)
      (i64.add (i64.mul (local.get $lo) (i64.const 10)) (local.get $hi)))
    ;; A block taking two params and giving two results.
    (func (export "swapped") (result i64)
      (i64.const 30)
      (i64.const 4)
      (block (param i64 i64) (result i64 i64)
        (call $swap))
      (i64.sub))
    ;; A loop carrying the counter and the sum as its params.
    (func (export "sum") (result i64) (local $i i64) (local $acc i64)
      (i64.const 10)
      (i64.const 0)
      (loop $next (param i64 i64) (result i64)
        (local.set $acc)
        (local.set $i)
        (local.set $acc (i64.add (local.get $acc) (local.get $i)))
        (local.set $i (i64.sub (local.get $i) (i64.const 1)))
        (if (result i64) (i64.eqz (local.get $i))
          (then (local.get $acc))
          (else (local.get $i) (local.get $acc) (br $next)))))
    (func (export "mixed") (result i64) (local $n i32) (local $f f64) (local $w i64)
      (call $mixed)
      (local.set $w)
      (local.set $f)
      (local.set $n)
      (i64.add
        (i64.add (i64.extend_i32_s (local.get $n)) (i64.trunc_f64_s (f64.mul (local.get $f) (f64.const 100))))
        (local.get $w))))
  (core instance $i (instantiate $m))
  (type $t (func (result s64)))
  (func $direct (type $t)
    (canon lift (core func $i "direct")))
  (func $indirect (type $t)
    (canon lift (core func $i "indirect")))
  (func $pick (type $t)
    (canon lift (core func $i "pick")))
  (func $swapped (type $t)
    (canon lift (core func $i "swapped")))
  (func $sum (type $t)
    (canon lift (core func $i "sum")))
  (func $mixed (type $t)
    (canon lift (core func $i "mixed")))
  (export "direct" (func $direct))
  (export "indirect" (func $indirect))
  (export "pick" (func $pick))
  (export "swapped" (func $swapped))
  (export "sum" (func $sum))
  (export "mixed" (func $mixed)))
