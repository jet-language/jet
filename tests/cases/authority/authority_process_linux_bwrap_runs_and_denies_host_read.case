# Claim: linux-bwrap runs a sandboxed command (sandboxed) and denies a host /etc/passwd read (blocked)
# Fixture migrated: two separate package dirs ok/ and hostile/ (each with its own package.jet, same authority block as TIR_PACKAGE)
# Not ported: Expected values are the Strong native-sandbox branch; non-Strong branch expects refused
fixture: authority_process_linux_bwrap_runs_and_denies_host_read.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run ok/main.jet
exit: 0 # native backend success
stdout: = "sandboxed\n" # native backend success
step: jet run hostile/main.jet
exit: 0 # native backend host-read denied
stdout: = "blocked\n" # native backend host-read denied
