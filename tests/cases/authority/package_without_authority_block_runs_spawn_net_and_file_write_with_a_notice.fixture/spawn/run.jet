// A package.jet with no authority block holds the beginner floor (IO,
// Mem.Alloc, Exec.Args) and allows every other effect. Starting a process
// uses the `Exec` root, so the run's notice says it starts other programs.
use core.process.[cmd]

run: fn() {
    receipt: cmd([String]{"touch", "spawned.txt"}).run() ?? {
        print("spawn failed")
        return
    }
    print("spawned code={receipt.code}")
}
