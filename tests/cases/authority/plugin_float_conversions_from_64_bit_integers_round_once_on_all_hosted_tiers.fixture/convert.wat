(component
  (core module $m
    (func $s (export "s") (param i64) (result i64)
      (i64.extend_i32_u (i32.reinterpret_f32 (f32.convert_i64_s (local.get 0)))))
    (func $u (export "u") (param i64) (result i64)
      (i64.extend_i32_u (i32.reinterpret_f32 (f32.convert_i64_u (local.get 0)))))
    (func $d (export "d") (param i64) (result i64)
      (i64.reinterpret_f64 (f64.convert_i64_u (local.get 0)))))
  (core instance $i (instantiate $m))
  (type $t (func (param "a0" s64) (result s64)))
  (func $s (type $t)
    (canon lift (core func $i "s")))
  (func $u (type $t)
    (canon lift (core func $i "u")))
  (func $d (type $t)
    (canon lift (core func $i "d")))
  (export "s" (func $s))
  (export "u" (func $u))
  (export "d" (func $d)))
