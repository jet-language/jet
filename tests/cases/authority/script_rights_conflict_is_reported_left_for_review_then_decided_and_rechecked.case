# #6035 c46 (was #2505 c4): the rights-conflict loop as one source scenario.
# A script with no package block writes a file, so its `FS.Write` right is
# undecided (D-AUTH-AMBIENT1, D-ECO-INLINEPACKAGE1).
# 1 emit: `jet run --json` refuses with E1803, and the report carries the
#   inline grant as a needs-review edit. Nothing runs.
# 2 fix: plain `jet fix` leaves the grant out, because granting a right is a
#   decision and not a repair. The typed status names the skipped edit.
# 3 decide: `jet fix --all` applies the grant the author chose.
# 4 recheck: `jet check --json` passes with no reports, and the run writes.
fixture: script_rights_conflict_is_reported_left_for_review_then_decided_and_rechecked.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
copy: write.jet original.bytes
step: jet run --json write.jet
exit: 1
stdout: empty
json: stderr doc $.schema = "jet.status/v1"
json: stderr doc $.ok = false
json: stderr doc $.reports #= 1
json: stderr doc $.reports[0].code = "E1803"
json: stderr doc $.reports[0].denial_kind = "authority"
json: stderr doc $.reports[0].applicability = "suggested"
json: stderr doc $.reports[0].fix_edits #= 1
json: stderr doc $.reports[0].fix_edits[0].safety = "needs-review"
json: stderr doc $.reports[0].fix_edits[0].new_text = "package {\n    name: \"write\"\n    authority: { allow: [FS.Write] }\n}\n\n"
file: out.txt absent
step: jet fix --json write.jet
exit: 0
stderr: empty
stdout: lines = 1 # one status line
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "fix"
json: stdout doc $.ok = true
json: stdout doc $.fix.dry_run = false
json: stdout doc $.fix.applied = 0
json: stdout doc $.fix.skipped #= 1
json: stdout doc $.fix.skipped[0].reason = "needs review: `jet fix --all` applies it"
json: stdout doc $.fix.skipped[0].new_text = "package {\n    name: \"write\"\n    authority: { allow: [FS.Write] }\n}\n\n"
json: stdout doc $.fix.log = null
file: write.jet == original.bytes
step: jet fix write.jet
exit: 0
stdout: empty
stderr: = "write.jet: no changes made (1 suggestion need review)\n"
file: write.jet == original.bytes
file: out.txt absent
step: jet fix --all --json write.jet
exit: 0
stderr: empty
json: stdout doc $.fix.applied = 1
json: stdout doc $.fix.skipped #= 0
file: write.jet = script_rights_conflict_is_reported_left_for_review_then_decided_and_rechecked.granted.bytes
step: jet check --json write.jet
exit: 0
json: stdout doc $.ok = true
json: stdout doc $.reports #= 0
step: jet run write.jet
exit: 0
stdout: = "wrote\n"
stderr: empty
file: out.txt = "hi"
