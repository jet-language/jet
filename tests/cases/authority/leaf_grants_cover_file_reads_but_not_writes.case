# Claim: --allow=FS.Read acknowledges files.read but not a write: the write
# still runs (every effect is allowed unless a row denies it) and the notice
# names it; --allow=FS acknowledges the write, and --deny=FS.Write refuses it
# with E1803 before anything runs.
# Fixture migrated: readfile path argument made dir-relative (argv/argv.jet); writes target fixture-relative written.txt
# Fixture migrated: core.process items imported as use core.process.[args, cmd] (seed rejects process.args() in this position, E1004); calls changed to args()/cmd()
fixture: leaf_grants_cover_file_reads_but_not_writes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run --allow=FS.Read readfile/readfile.jet
exit: 0 # default: FS.Read covers files.read
stdout: = "read=true\n" # default: FS.Read covers files.read
stderr: !~ "note:" # default: the read is acknowledged, so there is no notice
step: jet run --allow=FS.Read writefile/writefile.jet written.txt
exit: 0 # default: the unacknowledged write runs
stdout: = "wrote\n" # default: the unacknowledged write runs
stderr: ~ "writes files (-A hides this)" # default: the notice names the write
file: written.txt = "written" # the write ran (default)
remove: written.txt
step: jet run --allow=FS writefile/writefile.jet written.txt
exit: 0 # default: FS root covers write
stdout: = "wrote\n" # default: FS root covers write
stderr: !~ "note:" # default: the FS root acknowledges the write
file: written.txt = "written" # written content = written (default)
remove: written.txt
step: jet run --deny=FS.Write writefile/writefile.jet written.txt
exit: 1 # default: the denied write stops the run
stdout: = "" # default: no user code ran
stderr: ~ "E1803" # default: the denied write stops the run
stderr: ~ "`FS.Write`" # default: E1803 names the denied right
file: written.txt absent # the denied write never ran (default)
step: jet run --release --allow=FS.Read readfile/readfile.jet
exit: 0 # release: FS.Read covers files.read
stdout: = "read=true\n" # release: FS.Read covers files.read
stderr: !~ "note:" # release: the read is acknowledged, so there is no notice
step: jet run --release --allow=FS.Read writefile/writefile.jet written.txt
exit: 0 # release: the unacknowledged write runs
stdout: = "wrote\n" # release: the unacknowledged write runs
stderr: ~ "writes files (-A hides this)" # release: the notice names the write
file: written.txt = "written" # the write ran (release)
remove: written.txt
step: jet run --release --deny=FS.Write writefile/writefile.jet written.txt
exit: 1 # release: the denied write stops the run
stdout: = "" # release: no user code ran
stderr: ~ "`FS.Write`" # release: E1803 names the denied right
file: written.txt absent # the denied write never ran (release)
