// Starting a process uses the `Exec` root. The marker path is
// the first argument, so a denied run leaves no file behind.
use core.process.[args, cmd]

run: fn() {
    args: args()
    if args.len() == 0 -> return
    receipt: cmd([String]{"touch", args[0]}).run() ?? {
        print("spawn failed")
        return
    }
    print("spawned code={receipt.code}")
}
