# A source whose first binding is a `Config` record is Jet, so `jet fmt`
# formats it with the one Jet formatter (trailing commas on broken records);
# only `package.jet` goes through the Package model.
fixture: config_record_formats_with_the_jet_formatter.fixture
step: jet fmt {work}/config/dev.jet
exit: 0
file: config/dev.jet = config_record_formats_with_the_jet_formatter.out
step: jet fmt --check {work}/config/dev.jet
exit: 0
