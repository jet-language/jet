User: struct {
    name: String
    tags: [String]
}

make: fn(name: String) -> User {
    User{name: name, tags: [String]{}}
}

run: fn() {
    first: "Ada"
    names := [String]{}
    &names.push(first)
    u: make(first)
    label: "  admin  ".trim()
    kept: User{name: label, tags: names}
    print("{first} {names.len()} {u.name} {kept.name} {kept.tags.len()}")
}
