use game: core.game

perf.game: module {
    budgets: [
        Budget{
    name: "memory",
    scope: .Scene("main"),
    metric: .MemoryHighWater,
    provider: .SceneProbe("main"),
    comparison: .AbsoluteFrom("local/main"),
    limit: .AtMost(256MiB),
    enforcement: .Warn,
},
    ]
}

run: fn() {
    scene := game.Scene.new("main")
    counter := 0
    scene.on_frame(fn(frame) {
        counter = counter + 1
    })
    transcript: game.run(scene)
    print(transcript)
}
