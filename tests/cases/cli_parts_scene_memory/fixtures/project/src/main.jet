use core.game as game

module perf.game {
    budgets: [
        Budget.{
    name: "memory",
    scope: .Scene("main"),
    metric: .MemoryHighWater,
    provider: .SceneProbe("main"),
    comparison: .AbsoluteFrom("local/main"),
    limit: .AtMost(256MiB),
    enforcement: .Warn,
},
    ]
}

fn run() {
    scene := game.Scene.new("main")
    counter := 0
    scene.on_frame((frame) -> {
        counter = counter + 1
    })
    transcript :: game.run(scene)
    print(transcript)
}
