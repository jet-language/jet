# Arena and Bump run each allocated value's Close and drop when they reset or
# end, latest allocation first; a view never closes the value it reads.
fixture: allocated_values_close_in_reverse_order_at_reset_and_end.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = allocated_values_close_in_reverse_order_at_reset_and_end.out
step: jet run -O1 main.jet
exit: 0
stdout: = allocated_values_close_in_reverse_order_at_reset_and_end.out
step: jet run -O2 main.jet
exit: 0
stdout: = allocated_values_close_in_reverse_order_at_reset_and_end.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = allocated_values_close_in_reverse_order_at_reset_and_end.out
