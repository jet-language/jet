# A value try_alloc accepts belongs to its allocator as an alloc value does:
# Arena and Fixed close and drop it once, at reset or close, latest first;
# the Result carrying its view, and every name its Ok binds, own none of it.
fixture: try_alloc_values_close_once_at_reset_like_alloc.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = try_alloc_values_close_once_at_reset_like_alloc.out
step: jet run -O1 main.jet
exit: 0
stdout: = try_alloc_values_close_once_at_reset_like_alloc.out
step: jet run -O2 main.jet
exit: 0
stdout: = try_alloc_values_close_once_at_reset_like_alloc.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = try_alloc_values_close_once_at_reset_like_alloc.out
