# tests/web_browser.rs::web_browser_source_map_cdp_jet_breakpoint
# Exact five-source preparation/build/publish sequence; the published source
# maps are checked statically: app.js names app.js.map, the map's mappings
# land on a Jet line, and app.wasm carries its map. The live CDP breakpoint
# half of the original oracle needs a page-scoped CDP surface in
# core.web.browser, which does not exist.
fixture: fixtures/acceptance
step: jet build --target=web app.jet
cwd: {work}/click_src
exit: 0
mkdir: {work}/click
for file {work}/click_src/.jet/build as f
copy: {f.path} {work}/click/{f.name}
end for
step: jet build --target=web app.jet
cwd: {work}/reactive_src
exit: 0
mkdir: {work}/reactive
for file {work}/reactive_src/.jet/build as f
copy: {f.path} {work}/reactive/{f.name}
end for
step: jet build --target=web app.jet
cwd: {work}/compute_src
exit: 0
mkdir: {work}/compute
for file {work}/compute_src/.jet/build as f
copy: {f.path} {work}/compute/{f.name}
end for
step: jet build --target=web app.jet
cwd: {work}/callback_src
exit: 0
mkdir: {work}/callback
for file {work}/callback_src/.jet/build as f
copy: {f.path} {work}/callback/{f.name}
end for
step: jet build --target=web app.jet
cwd: {work}/lifecycle_src
exit: 0
mkdir: {work}/lifecycle
for file {work}/lifecycle_src/.jet/build as f
copy: {f.path} {work}/lifecycle/{f.name}
end for
spawn server: jet run --allow=Env,FS,IO,Net,Time {root}/Tools/web-test/Serve.jet -- --port {free-port:static} --root {work}
stdout: null
poll ready: jet run {root}/tests/cases/web_browser/fixtures/http-ready.jet 127.0.0.1:{free-port:static} /click/web.manifest.json - - until stdout: ~ "200 OK" timeout 10s every 50ms # the static server serves the manifest
step: jet run --allow=Env,Exec,IO,Net,Time {root}/Tools/web-test/SourceMap.jet -- --port {free-port:static} --prefix /click --wasm-prefix /compute
exit: 0
stdout: ~ "PASS web source-map Jet mapping + wasm map" # the second line is the mapped location, which varies with the build
signal server: KILL
wait: server
exit: any # original server cleanup ignores status
