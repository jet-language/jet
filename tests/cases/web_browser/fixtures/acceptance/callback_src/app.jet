#Target(Web)
#HTML("index.html")
// D-JSBIND1 / #123: JS event callback invokes a #WasmExport bridge (JS -> Wasm
// inside a browser-style handler), proving callback + compute round-trip.
use web: core.web

#WasmExport
double: fn(n: Int) -> Int { n * 2 }

#Target(JS)
init: fn() {
    web.on("#go", "click", ev -> {
        if double(21) == 42 {
            print("42")
        }
        web.storage.local.set("clicked", "yes")
    })
}

run: fn() {}
