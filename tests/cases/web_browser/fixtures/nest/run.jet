use web: core.web

#Web.Form
Input: struct {
    name: String
}

save: fn(input: Input) -> String { "saved {input.name}" }

run: fn() {
    form: web.form(Input, action: save)
    form.set("name", "Ada") ?? panic("name set")
    print(form.no_script() ?? panic("no-script form"))
    print(form.render())
}
