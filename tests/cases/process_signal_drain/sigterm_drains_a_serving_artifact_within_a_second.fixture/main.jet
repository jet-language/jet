// An artifact that registers `process.on_signal(.Term)`
// drains on SIGTERM. The entry serves one server, a task serves another and
// a second task sleeps; the signal cancels the process, so the entry's serve
// returns its report and both tasks end cancelled, and the entry prints what
// each one did and ends.
use {
    web: core.web
    http_server: core.http.server
    process: core.process
    term: core.term
    time: core.time
}

run: fn() {
    process.on_signal(.Term)
    entry_mux: web.app()
    entry_mux.get("/", fn(_req: HTTPRequest) { Ok(http_server.response(200, "entry")) })
    entry_server: entry_mux.bind("127.0.0.1:0") ?? process.fail(2, "bind: {err}")
    task_mux: web.app()
    task_mux.get("/", fn(_req: HTTPRequest) { Ok(http_server.response(200, "task")) })
    task_server: task_mux.bind("127.0.0.1:0") ?? process.fail(2, "bind: {err}")
    serving: task { task_server.serve() ?? process.fail(1, "task serve: {err}") }
    sleeping: task { time.sleep(60s) }
    print("ready")
    // A pipe stdout is written when its buffer fills (spec.md print); flush so
    // the parent sees ready before it signals.
    ready_out := term.stdout()
    ready_out.flush() ?? process.fail(1, "flush: {err}")
    entry_report: entry_server.serve() ?? process.fail(1, "entry serve: {err}")
    print("entry drained: accepted={entry_report.accepted}")
    if serving.join() == {
        .Ok(task_report) -> print("task drained: accepted={task_report.accepted}")
        .Err(.Cancelled) -> print("task: cancelled")
        .Err(.DeadlineBlown) -> print("task: deadline")
        .Err(.Panicked(reason)) -> print("task: panicked {reason}")
    }
    if sleeping.join() == {
        .Ok(_) -> print("sleep: finished")
        .Err(_) -> print("sleep: cancelled")
    }
}
