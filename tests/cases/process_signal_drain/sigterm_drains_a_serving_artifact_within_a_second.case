# Card #3173 c40: a native artifact that registers `process.on_signal(.Term)`
# drains on SIGTERM. The signal cancels the process: the entry's accept ends
# as cancelled, so its `serve` returns its report, and every live task is
# cancelled, so the serving task returns its report and the sleeping task
# ends. The artifact prints both reports and exits 0 within a second, at O0,
# O1 and O2.
requires: os:unix
fixture: sigterm_drains_a_serving_artifact_within_a_second.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --optimize=none --output-dir=o0 --allow=Exec,Net,Time,FS.Read,IO main.jet
exit: 0
step: jet build --optimize=basic --output-dir=o1 --allow=Exec,Net,Time,FS.Read,IO main.jet
exit: 0
step: jet build --optimize=full --output-dir=o2 --allow=Exec,Net,Time,FS.Read,IO main.jet
exit: 0

session o0 raw: {work}/o0/main
recv o0 until = "ready\n" within 30s
stdout: = "ready\n"
signal o0: TERM
repeat while process {pid:o0} alive timeout 1s every 10ms fail "the O0 artifact did not drain within 1 s of SIGTERM"
end repeat
close o0
exit: 0
stdout: = "entry drained: accepted=0\ntask drained: accepted=0\nsleep: cancelled\n"

session o1 raw: {work}/o1/main
recv o1 until = "ready\n" within 30s
stdout: = "ready\n"
signal o1: TERM
repeat while process {pid:o1} alive timeout 1s every 10ms fail "the O1 artifact did not drain within 1 s of SIGTERM"
end repeat
close o1
exit: 0
stdout: = "entry drained: accepted=0\ntask drained: accepted=0\nsleep: cancelled\n"

session o2 raw: {work}/o2/main
recv o2 until = "ready\n" within 30s
stdout: = "ready\n"
signal o2: TERM
repeat while process {pid:o2} alive timeout 1s every 10ms fail "the O2 artifact did not drain within 1 s of SIGTERM"
end repeat
close o2
exit: 0
stdout: = "entry drained: accepted=0\ntask drained: accepted=0\nsleep: cancelled\n"
