// SIGTERM while a request is in flight: the artifact registers
// `process.on_signal(.Term)` and serves on its entry. A client task sends half
// a request and prints ready; the parent signals; the client finishes the
// request 300 ms later. The signal stops accepting, the request in flight is
// still answered, and serve reports it once it is.
use {
    web: core.web
    http_server: core.http.server
    net: core.net
    process: core.process
    term: core.term
    time: core.time
}

crlf: fn() -> String {
    "\r\n"
}

run: fn() {
    process.on_signal(.Term)
    app: web.app().get("/hi", fn(_req: HTTPRequest) { Ok(http_server.response(200, "hi")) })
    listening: app.bind("127.0.0.1:0") ?? process.fail(2, "bind: {err}")
    addr: listening.local_addr() ?? process.fail(2, "address: {err}")
    client: task {
        #Shield {
            held: net.tcp_connect(addr) ?? process.fail(1, "connect: {err}")
            held.write_all("GET /hi HTTP/1.1{crlf()}".bytes()) ?? process.fail(1, "write: {err}")
            time.sleep(100ms)
            print("ready")
            // A pipe stdout is written when its buffer fills (spec.md
            // print); flush so the parent sees ready before it signals.
            ready_out := term.stdout()
            ready_out.flush() ?? process.fail(1, "flush: {err}")
            time.sleep(300ms)
            held.write_all("Host: test{crlf()}{crlf()}".bytes()) ?? process.fail(1, "write: {err}")
            parts := [String]{}
            loop {
                part: held.read_text(8192) ?? process.fail(1, "read: {err}")
                if part == "" -> break
                parts.push(part)
            }
            line: parts.join("").split_once(crlf()) ?? process.fail(1, "no response")
            print("in flight: {line.before}")
        }
    }
    report: listening.serve() ?? process.fail(1, "serve: {err}")
    if client.join() == {
        .Ok(_) -> {}
        .Err(_) -> print("client: cancelled")
    }
    print("drained: accepted={report.accepted} completed={report.completed} cancelled={report.cancelled}")
}
