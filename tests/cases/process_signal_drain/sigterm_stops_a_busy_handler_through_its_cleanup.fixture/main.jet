// An artifact that registers `process.on_signal(.Term)` drains on SIGTERM. A
// task busy in a loop that never waits stops at its next iteration, its
// deferred close runs, and its join reports the cancel.
use {
    process: core.process
    term: core.term
    time: core.time
}

// A close that shows the cancelled task's cleanup ran.
Marker: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

// Counts with no call and no wait point: only the check each iteration
// starts with can stop it.
spin: fn(counter: Atomic<Int>) -> Int {
    n := 0
    loop n >= 0 {
        n += 1
        if n % 4096 == 0 -> counter.store(n)
    }
    n
}

run: fn() {
    process.on_signal(.Term)
    counter: Atomic<Int>.try_new(0) ?? return
    // The spinner shares the entry's counter, so it runs in a group the
    // counter outlives.
    task.group handlers {
        busy: task {
            marker: Marker{name: "the busy handler's marker"}
            defer close(marker)
            spin(counter)
        }
        tries := 0
        loop counter.load() == 0 && tries < 2000 {
            time.sleep(1ms)
            tries += 1
        }
        print("ready")
        // A pipe stdout is written when its buffer fills; flush so the parent
        // sees ready before it signals.
        ready_out := term.stdout()
        ready_out.flush() ?? process.fail(1, "flush: {err}")
        if busy.join() == {
            .Ok(_) -> print("busy handler: finished")
            .Err(.Cancelled) -> print("busy handler: cancelled")
            .Err(.DeadlineBlown) -> print("busy handler: deadline")
            .Err(.Panicked(reason)) -> print("busy handler: panicked {reason}")
        }
    }
}
