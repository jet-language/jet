// `math.sqrt` on Float and F32: exact squares, an irrational root, signed
// zero, infinity and the NaN of a negative operand.
use math: core.math

root: fn(x: Float) -> Float {
    return math.sqrt(x)
}

run: fn() {
    print("{root(16.0)} {root(2.0)} {root(1e-300)}")
    print("{root(0.0)} {root(-0.0)} {root(math.INFINITY)}")
    nan: root(-1.0)
    print("nan {nan != nan}")
    print("narrow {math.sqrt(F32{9.0})} {math.sqrt(F32{2.0})}")
    total := Float{0.0}
    loop i in 1..<101 -> total += root(Float{i})
    print("sum {total}")
}
