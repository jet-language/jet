# `math.sqrt` is the IEEE square root as one IR operation (sqrtsd), not a
# runtime call, and every tier computes the same correctly rounded roots.
fixture: sqrt_is_one_instruction_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet emit --ir main.jet --fn sqrt
exit: 0
stdout: ~ ": sqrt s" # the Core sqrt body is the sqrt operation
stdout: !~ "jet_std_math_sqrt" # no runtime route is called
step: jet run -O0 main.jet
exit: 0
stdout: = sqrt_is_one_instruction_on_every_tier.out
step: jet run -O1 main.jet
exit: 0
stdout: = sqrt_is_one_instruction_on_every_tier.out
step: jet run -O2 main.jet
exit: 0
stdout: = sqrt_is_one_instruction_on_every_tier.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = sqrt_is_one_instruction_on_every_tier.out
