
use process: core.process

run: fn() {
    // A short stage deadline: the subject is that it fires and reaps the
    // tree's descendants, not its length.
    timeout: Duration.milliseconds(250) ?? panic("duration failed")
    first: process.pipeline([
        process.cmd(["{work}/session_fixture", "tree", "{work}/aot.pid"]).timeout(timeout),
        process.cmd(["cat"])
    ]) ?? panic("aot-shaped pipeline failed")
    print(first.timed_out)
    second: process.pipeline([
        process.cmd(["{work}/session_fixture", "tree", "{work}/jit.pid"]).timeout(timeout),
        process.cmd(["cat"])
    ]) ?? panic("jit-shaped pipeline failed")
    print(second.timed_out)
    third: process.pipeline([
        process.cmd(["{work}/session_fixture", "tree", "{work}/interp.pid"]).timeout(timeout),
        process.cmd(["cat"])
    ]) ?? panic("interpreter-shaped pipeline failed")
    print(third.timed_out)
}
