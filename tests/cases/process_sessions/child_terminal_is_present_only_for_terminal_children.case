# ProcessChild.terminal: None for a piped child; for a terminal child each read
# is a session whose resize the child observes, on every optimization level and
# in a built binary.
requires: os:unix
requires: tool:sh
requires: tool:stty
fixture: child_terminal_is_present_only_for_terminal_children.fixture
step o0: jet run --optimize=none run.jet
exit: 0
stdout: = child_terminal_is_present_only_for_terminal_children.out
step: jet run --optimize=basic run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet run --optimize=full run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet build --optimize=full run.jet
exit: 0
step: built
exit: == o0
stdout: == o0
stderr: == o0
