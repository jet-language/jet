// N sleeping children under jobs N finish in about one sleep, not N; under
// jobs 2 they finish in waves of two. A run_all that ran its specs one at a
// time would take the sum of the sleeps.
package {
    name: "run_all_overlap"
    edition: "2026"
    authority: { allow: [Exec, IO, Time, Time.Wait] }
}

use {
    process :: core.process
    time :: core.time
}

fn timed(count: Int, jobs: Int, seconds: String) -[Exec, Time, Time.Wait]> Int {
    specs :: loop _ in 0..<count -> process.cmd(["sleep", seconds])
    clock :: time.start()
    results :: process.run_all(specs, jobs) ?? panic("run_all failed")
    elapsed :: clock.elapsed_millis()
    loop result in results {
        receipt :: result ?? panic("a sleep did not start")
        if receipt.code != 0 -> panic("a sleep failed")
    }
    elapsed
}

fn run() -[Exec, IO, Time, Time.Wait]> {
    // Eight 1 s sleeps: about 1 s at once, 8 s one at a time.
    wide :: timed(8, 8, "1")
    print("jobs 8 ran 8 at once: {wide >= 1000 && wide < 3000}")
    // Eight 0.5 s sleeps two at a time: four waves, about 2 s.
    narrow :: timed(8, 2, "0.5")
    print("jobs 2 ran in waves of 2: {narrow >= 2000 && narrow < 3500}")
}
