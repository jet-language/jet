
use process: core.process

run: fn() {
    cpu_budget: Duration.milliseconds(1000) ?? panic("duration failed")
    if process.cmd(["{work}/session_fixture", "cpu"]).cpu_time_limit(cpu_budget).run() == {
        .Ok(_) -> print("cpu:missed")
        .Err(error) -> {
            if error == {
                .ResourceLimit(limit) -> print(if limit == .CpuTime -> "cpu:typed" else -> "cpu:wrong")
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .AlreadyExists(_) | .Unsupported(_) -> print("cpu:wrong")
            }
        }
    }
    if process.cmd(["{work}/session_fixture", "memory"]).memory_limit(33554432).run() == {
        .Ok(_) -> print("memory:missed")
        .Err(error) -> {
            if error == {
                .ResourceLimit(limit) -> print(if limit == .Memory -> "memory:typed" else -> "memory:wrong")
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .AlreadyExists(_) | .Unsupported(_) -> print("memory:wrong")
            }
        }
    }
    if process.cmd(["{work}/session_fixture", "files"]).open_file_limit(64).run() == {
        .Ok(_) -> print("files:missed")
        .Err(error) -> {
            if error == {
                .ResourceLimit(limit) -> print(if limit == .OpenFiles -> "files:typed" else -> "files:wrong")
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .AlreadyExists(_) | .Unsupported(_) -> print("files:wrong")
            }
        }
    }
}
