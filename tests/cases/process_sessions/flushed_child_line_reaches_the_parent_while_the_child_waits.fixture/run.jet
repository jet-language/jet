use {
    fs: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

// The child prints `ready` into its stdout pipe, flushes, and waits until the
// parent answers through a file. A piped stdout is written only when its
// buffer fills, at a flush or when the process stops (D-STDOUT-BUFFER1), so
// the explicit flush is what lets the parent read the line while the child
// still runs; without it both sides wait out the child's bound.
child: fn(go: Path) {
    print("ready")
    out := term.stdout()
    out.flush() ?? panic("child flush")
    waited := 0
    loop !fs.exists(go) {
        if waited >= 500 {
            print("child gave up waiting")
            return
        }
        time.sleep(10ms)
        waited += 1
    }
    print("child saw the answer")
}

run: fn() {
    args: process.args()
    if args.len() > 1 && (args.get(0) ?? "") == "--child" {
        child(Path.from(args.get(1) ?? panic("missing answer path")))
        return
    }
    scratch: fs.temp_dir("jet-flushed-child") ?? panic("temp dir")
    go: Path.from(scratch.path).join("go")
    worker: process.cmd([sys.executable(), "--child", go.to_string()])
        .stdout(.Stream)
        .spawn() ?? panic("spawn child")
    answered := false
    loop line in worker.stdout.lines() {
        print("parent read: {line.trim()}")
        if !answered {
            fs.write(go, "go") ?? panic("answer the child")
            answered = true
        }
    }
    _: worker.wait() ?? panic("wait child")
}
