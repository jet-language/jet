// Every line a child streams becomes an owned [U8] that Core trims in place
// before it decodes it. The line buffer is a counted List block, so trimming
// it never writes the bytes beside it: each line reads back as sent, and the
// boxed names allocated between the reads keep their values.
use process :: core.process

struct Holder {
    name: String?
}

fn run() {
    script :: "i=0; while [ $i -lt 300 ]; do echo ready; echo ready >&2; i=$((i+1)); done"
    child := process.cmd(["/bin/sh", "-c", script]).stdout(.Stream).stderr(.Stream).spawn()
    kept := [Holder]{}
    lines := 0
    loop line in child.stdout.lines() {
        if line != "ready" -> print("stdout line {lines}: {line}")
        &kept.push(Holder{name: Val("value {lines}")})
        lines += 1
    }
    errors := 0
    loop line in child.stderr.lines() {
        if line != "ready" -> print("stderr line {errors}: {line}")
        &kept.push(Holder{name: Val("value {lines + errors}")})
        errors += 1
    }
    receipt :: child.wait()
    intact := 0
    loop (index, holder) in kept {
        if holder.name == .Val(name) {
            expected :: "value {index}"
            if name == expected -> intact += 1
        }
    }
    print("{lines} stdout lines, {errors} stderr lines, {intact} names intact, exit ok {receipt.success}")
}
