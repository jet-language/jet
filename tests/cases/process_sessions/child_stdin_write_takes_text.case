# ProcessStdin.write takes a String and writes all of its UTF-8 bytes;
# write_some takes [U8] and is the partial write that reports the count
# taken. Both in the interpreter and a built binary.
requires: os:unix
requires: tool:cat
fixture: child_stdin_write_takes_text.fixture
step default: jet run run.jet
exit: 0
stdout: = "took 5, received hello, pipe\n\nexit 0\n"
step: jet build run.jet
exit: 0
step: built
exit: == default
stdout: == default
stderr: == default
