# A child that prints `ready`, flushes its piped stdout and then waits for the
# parent delivers the line while it runs: the parent answers and the child
# finishes, on every optimization level and in a built binary (#6591).
requires: os:unix
fixture: flushed_child_line_reaches_the_parent_while_the_child_waits.fixture
step o0: jet run -O0 run.jet
exit: 0
stdout: = flushed_child_line_reaches_the_parent_while_the_child_waits.out
step: jet run -O1 run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet run -O2 run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet build -O2 run.jet
exit: 0
step: built
exit: == o0
stdout: == o0
stderr: == o0
