
use core.process as process
use core.time as time
use core.files as files

// Waits until the tree's descendant has joined the tree's process group and
// published its pid file, so the signal below always reaches a whole tree. A
// fixed 100ms sleep raced the two process starts under load.
fn started(pid_file: String) {
    loop _ in 0..<1000 {
        if files.exists(pid_file) -> return
        time.sleep(10ms)
    }
    panic("descendant never published {pid_file}")
}

fn dropped(fixture: String, pid: String) {
    child :: process.cmd([fixture, "tree", pid]).terminal().spawn() ?? panic("drop spawn failed")
    started(pid)
}

fn run() {
    session :: process.current_pid()

    interrupt_pid := "{work}/session-{session}-interrupt.pid"
    interrupt :: process.cmd(["{work}/session_fixture", "tree", interrupt_pid]).terminal().spawn() ?? panic("interrupt spawn failed")
    started(interrupt_pid)
    interrupt.interrupt() ?? panic("interrupt failed")
    interrupt_result :: interrupt.wait() ?? panic("interrupt wait failed")
    print(interrupt_result.success)
    if interrupt.stdin.write_text("late") == {
        .Ok(_) -> panic("interrupt cleanup left stdin open")
        .Err(error) -> {
            if error == { .Closed(_) -> {} else -> panic("interrupt cleanup was not typed") }
        }
    }

    terminate_pid := "{work}/session-{session}-terminate.pid"
    terminate :: process.cmd(["{work}/session_fixture", "tree", terminate_pid]).terminal().spawn() ?? panic("terminate spawn failed")
    started(terminate_pid)
    terminate.terminate() ?? panic("terminate failed")
    terminate_result :: terminate.wait() ?? panic("terminate wait failed")
    print(terminate_result.success)
    if terminate.stdin.write_text("late") == {
        .Ok(_) -> panic("terminate cleanup left stdin open")
        .Err(error) -> {
            if error == { .Closed(_) -> {} else -> panic("terminate cleanup was not typed") }
        }
    }

    kill_pid := "{work}/session-{session}-kill.pid"
    kill :: process.cmd(["{work}/session_fixture", "tree", kill_pid]).terminal().spawn() ?? panic("kill spawn failed")
    started(kill_pid)
    kill.kill() ?? panic("kill failed")
    kill_result :: kill.wait() ?? panic("kill wait failed")
    print(kill_result.success)
    if kill.stdin.write_text("late") == {
        .Ok(_) -> panic("kill cleanup left stdin open")
        .Err(error) -> {
            if error == { .Closed(_) -> {} else -> panic("kill cleanup was not typed") }
        }
    }

    // The timeout must outlast the tree's and its descendant's starts, or the
    // kill can come before the descendant has a pid file to check.
    timeout :: Duration.milliseconds(5000) ?? panic("duration failed")
    timeout_pid := "{work}/session-{session}-timeout.pid"
    timed :: process.cmd(["{work}/session_fixture", "tree", timeout_pid]).terminal().timeout(timeout).run() ?? panic("timeout failed")
    print(timed.timed_out)

    drop_pid := "{work}/session-{session}-drop.pid"
    dropped("{work}/session_fixture", drop_pid)
    print("drop returned")
}
