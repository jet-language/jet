# The original pid_file writer emits decimal PID bytes without a newline; trim is an identity here.
capture: pid = text file aot.pid
repeat while process {cap:pid} alive timeout 2s every 10ms fail "pipeline descendant {cap:pid} survived timeout"
end repeat
capture: pid = text file jit.pid
repeat while process {cap:pid} alive timeout 2s every 10ms fail "pipeline descendant {cap:pid} survived timeout"
end repeat
capture: pid = text file interp.pid
repeat while process {cap:pid} alive timeout 2s every 10ms fail "pipeline descendant {cap:pid} survived timeout"
end repeat
