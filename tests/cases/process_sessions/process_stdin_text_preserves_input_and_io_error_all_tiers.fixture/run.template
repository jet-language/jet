
use process: core.process

run: fn() {
    session: process.current_pid()
    path := "{work}/stdin-{session}.txt"
    process.stdin_text(
        process.cmd(["sh", "-c", "cat > \"$1\"", "sh", path]),
        "exact stdin\nbytes\n"
    ) ?? panic("stdin text failed")
    print("stdin:sent")

    if process.stdin_text(process.cmd(["sh", "-c", "exit 0"]), "__JET_PAYLOAD__") == {
        .Ok(_) -> print("write:missed")
        .Err(error) -> {
            if error == {
                .Closed(_) -> print("write:closed")
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> print("write:wrong")
            }
        }
    }
}
