# A streamed child line is the buffer of an owned [U8] that Core trims with
# `pop` before decoding. The runtime once handed that buffer over as
# align-1 bytes, which have no count word. The trim's uniqueness check then
# read the 24 bytes before the buffer, and decremented them, which are the
# neighbouring allocation's: later lines read back as "qeady" and boxed names
# beside them pointed one byte off. Every line and name must read back as
# written, at every optimization level and in a built binary.
requires: os:unix
fixture: streamed_child_lines_leave_neighbouring_values_intact.fixture
step o0: jet run -O0 run.jet
exit: 0
stdout: = streamed_child_lines_leave_neighbouring_values_intact.out
stderr: empty
step: jet run -O1 run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet run -O2 run.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet build -O2 run.jet
exit: 0
step: built
exit: == o0
stdout: == o0
stderr: == o0
