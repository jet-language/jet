# ProcessStdin.write/write_all/write_text and ProcessStdoutStream.read/chunks
# carry every byte value; chunks ends at end of input and on a refused size.
requires: os:unix
requires: tool:sh
requires: tool:cat
fixture: child_pipes_carry_binary_bytes_both_ways.fixture
step default: jet run run.jet
exit: 0
stdout: = child_pipes_carry_binary_bytes_both_ways.out
step: jet build run.jet
exit: 0
step: built
exit: == default
stdout: == default
stderr: == default
