# ProcessStdin.write_some/write_bytes and ProcessStdoutStream.read_bytes are
# the byte names of write/write_all/read: the same partial write, whole write
# and bounded read, in the interpreter and a built binary alike.
requires: os:unix
requires: tool:cat
fixture: child_pipes_take_the_byte_method_names.fixture
step default: jet run run.jet
exit: 0
stdout: = "took 2, received abcd\nexit 0\n"
step: jet build run.jet
exit: 0
step: built
exit: == default
stdout: == default
stderr: == default
