# A `-> Never Never!` call (process.fail, a fn declared `Never Never!`)
# fills a `??` fallback of a Unit, String or Int success and stops the run,
# with the same output on O0, O1 and O2 (#5072 c39).
fixture: never_never_calls_fill_fallback_slots_on_every_tier.fixture
step o0: jet run main.jet
env: NO_COLOR=1
exit: 3 # O0: the last fallback ends the run
stdout: = expected.out
stderr: ~ "missing.txt: not found\n" # O0: process.fail's message
step o1: jet run -O1 main.jet
env: NO_COLOR=1
exit: 3 # O1: the last fallback ends the run
stdout: = expected.out
stderr: ~ "missing.txt: not found\n" # O1: process.fail's message
step o2: jet run -O2 main.jet
env: NO_COLOR=1
exit: 3 # O2: the last fallback ends the run
stdout: = expected.out
stderr: ~ "missing.txt: not found\n" # O2: process.fail's message
