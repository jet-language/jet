use {
    files: core.files
    process: core.process
}

// A `-> Never Never!` call diverges like a `-> Never` one: it fills a `??`
// fallback whatever the success type, Unit, String or Int.
halt: fn(code: Int, why: String) -> Never Never! { process.fail(code, why) }

run: fn() {
    files.chdir(".") ?? process.fail(2, "cd: {err}")
    files.chdir(".") ?? halt(2, "cd: {err}")
    text: files.read("main.jet") ?? process.fail(2, "read: {err}")
    n: Int.parse("41") ?? halt(2, "not a number")
    print("{text.lines().len() > 0} {n + 1}")
    files.read("missing.txt") ?? process.fail(3, "missing.txt: not found")
    print("unreached")
}
