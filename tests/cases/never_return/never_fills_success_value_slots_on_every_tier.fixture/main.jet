// Never is accepted in success-value slots: a `??` fallback, an `if` arm
// whose other arm is an Int, and the tail of a function that returns Int.
fail: fn(why: String) -> Never {
    panic(why)
}

positive: fn(n: Int) -> Int {
    if n > 0 -> return n
    fail("not positive")
}

run: fn() {
    y := Int.parse("41") ?? fail("not a number")
    y += 1
    z: if y > 0 -> { y * 2 } else -> { fail("negative") }
    print("{y} {z} {positive(3)}")
}
