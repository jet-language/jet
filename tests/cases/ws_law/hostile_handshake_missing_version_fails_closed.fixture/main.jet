use {
    web: core.web
    net: core.net
    ws: core.net.ws
    server: core.http.server
}
handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    assert(if ws.upgrade(req) == {
        .Ok(_) -> false
        .Err(error) -> if error == {
            .InvalidHandshake -> true
            .InvalidURL | .Protocol | .Timeout | .Closed | .Cancelled | .UnsupportedTarget | .MessageTooLarge(_) | .IO(_) -> false
        }
    })
    return Ok(server.response(400, "bad"))
}
run: fn() {
    cr: "\r"
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    addr: listener.local_addr() ?? panic("address")
    mux: web.app()
    mux.get("/live", fn(req: HTTPRequest) { handle(req) })
    serving: task { mux.serve_once(listener) ?? panic("serve") }
    stream: net.tcp_connect(addr) ?? panic("connect")
    stream.write_all("GET /live HTTP/1.1{cr}\nHost: local{cr}\nUpgrade: websocket{cr}\nConnection: Upgrade{cr}\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=={cr}\n{cr}\n".bytes()) ?? panic("write")
    stream.close() ?? panic("close")
    serving.join() ?? panic("server join")
}
