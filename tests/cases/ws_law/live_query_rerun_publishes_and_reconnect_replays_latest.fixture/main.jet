use {
    application: app
    core.reactive.loadable.[Loadable]
}

#Error
UserError: enum {
    Missing
}

user_name: fn(id: String) -[DB.Read]> String UserError! {
    if id == "" -> return Err(UserError.Missing)
    "v1:{id}"
}

shown: fn(state: Loadable<String, UserError>) -> String {
    if state == {
        .Loaded(value) -> value
        .Failed(_) -> "failed"
        .Idle | .Loading -> "pending"
    }
}

run: fn() {
    binding: application.live(user_name, "alice")
    print(shown(application.state(binding)))
    application.push(user_name, "alice", value: "v2:alice")
    print(shown(application.state(binding)))
    print(application.live_stats())
}
