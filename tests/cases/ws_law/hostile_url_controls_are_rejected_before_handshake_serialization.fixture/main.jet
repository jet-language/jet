use core.net.ws as ws
fn run() {
    cr :: String.from_bytes([U8]{13}) ?? panic("CR")
    hostiles :: [String]{"ws://127.0.0.1/path{cr}\nInjected: yes", "ws://127.0.0.1{cr}\nInjected: yes/path"}
    loop hostile in hostiles {
        rejected :: if ws.connect(hostile) == {
            .Ok(_) -> false
            .Err(error) -> if error == { .InvalidURL -> true; else -> false }
        }
        assert(rejected)
    }
}
