use {
    web: core.web
    net: core.net
    ws: core.net.ws
    server: core.http.server
}
handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    sock: ws.upgrade(req) ?? panic("upgrade")
    message: sock.recv() ?? panic("recv")
    text: message.text() ?? panic("text")
    sock.send_text("echo:{text}") ?? panic("send")
    sock.close(1000, "") ?? panic("close")
    return Ok(server.response(500, "unused"))
}
run: fn() {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    addr: listener.local_addr() ?? panic("address")
    mux: web.app()
    mux.get("/live", fn(req: HTTPRequest) { handle(req) })
    serving: task { mux.serve_once(listener) ?? panic("serve") }
    client: ws.connect("ws://{addr}/live") ?? panic("connect")
    client.send_text("ping") ?? panic("client send")
    reply := client.recv() ?? panic("client recv")
    loop {
        if reply.is_text() && (reply.text() ?? panic("text")) == "echo:ping" -> break
        reply = client.recv() ?? panic("client recv")
    }
    assert_eq(reply.text() ?? panic("reply text"), "echo:ping")
    closed: client.recv() ?? panic("client close")
    assert(closed.is_close())
    serving.join() ?? panic("server join")
}
