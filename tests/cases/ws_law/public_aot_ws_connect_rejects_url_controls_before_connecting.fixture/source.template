
use ws: core.net.ws
run: fn() {
    if ws.connect("ws://{cap:addr}/live\nInjected: yes") == {
        .Ok(_) -> print("accepted")
        .Err(error) -> {
            if error == .InvalidURL -> print("rejected")
            else -> print("wrong error")
        }
        else -> print("unexpected")
    }
}
