# Port of tests/explain_syntax.rs:64-86.
# `--verbose` prints the default explanation unchanged, then the registry
# constant the lookup("&&") row is declared as. No decision ID is printed:
# those live in Tower and the specs, never in the registry's output.
step default: jet explain "&&"
# Original dictionary snapshot retained so the dynamic prefix source cannot silently change.
stdout: = ../../cli/explain_syntax_take.txt
step: jet explain "&&" --verbose
stdout: = explain_syntax_verbose_names_registry_constant_and_decision.stdout
