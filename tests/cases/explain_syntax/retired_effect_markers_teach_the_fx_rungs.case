# Claim: `#Abilities` and `#Caps` are retired effect markers. `jet explain`
# says so and teaches the live rungs, `#FX(...)` on a block or module line and
# `-[...]>` on a function, instead of presenting either one as a live marker.
step: jet explain "#Abilities"
env: NO_COLOR=1
exit: 0
stdout: ~ "`#Abilities` is retired" # the row names the marker as retired
stdout: ~ "#FX(IO) {" # the example is the block rung
stdout: ~ "-[...]>" # the text names the function rung
stdout: !~ "The marker `#Abilities`." # no placeholder text that reads as a live marker
step: jet explain "#Caps"
env: NO_COLOR=1
exit: 0
stdout: ~ "`#Caps` is retired" # the row names the marker as retired
stdout: ~ "#FX(!Net, !FS)" # the example is the module rung
stdout: !~ "The marker `#Caps`." # no placeholder text that reads as a live marker
