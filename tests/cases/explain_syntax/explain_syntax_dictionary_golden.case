# Port of tests/explain_syntax.rs:30-60; original checked-in snapshot assertions reused unchanged.
step: jet explain "@"
stdout: = ../../cli/explain_syntax_at.txt
step: jet explain "::"
stdout: = ../../cli/explain_syntax_bind.txt
step: jet explain "#Live"
stdout: = ../../cli/explain_syntax_marker.txt
step: jet explain "->"
stdout: = ../../cli/explain_syntax_arrow.txt
step: jet explain loop
stdout: = ../../cli/explain_syntax_keyword.txt
step: jet explain "^"
stdout: = ../../cli/explain_syntax_caret.txt
step: jet explain "??"
stdout: = ../../cli/explain_syntax_fallback.txt
step: jet explain "@@"
exit: 1
stderr: = ../../cli/explain_syntax_unknown.txt
