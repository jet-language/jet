
    #[Printable, Equatable, Debug]
    Enabled: struct { value: Int }
    
    Missing: struct { value: Int }
    
    #!Debug
    Manual: struct {
        value: Int

        impl Debug {
            debug: fn(self) -> String { return "manual" }
        }
    }
    
    run: fn() {
        a := Enabled{ value: 3 }
        print(a)
        print("{a:Debug}")
        print(a == Enabled{ value: 3 })
        print("{Manual{ value: 9 }:Debug}")
    }
    