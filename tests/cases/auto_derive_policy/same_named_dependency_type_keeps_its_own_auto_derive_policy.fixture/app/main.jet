
use vendor: dep

Token: struct { value: Int }
LocalEnvelope: struct { token: Token }
DependencyEnvelope: struct { token: vendor.Token }
SharedEnvelope: struct { value: Shared<Int> }

reject: fn(value: vendor.Token) {
    print(value)
}

run: fn() {
    print(LocalEnvelope{ token: Token{ value: 7 } })
}
