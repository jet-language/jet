Tree: enum {
    Leaf(value: Int)
    Pair(left: Node, right: Node)
}

Node: Tree

Point: struct {
    x: Int
    y: Int
}

Spot: Point

Holder: struct {
    at: Spot
}

run: fn() {
    a: Tree.Pair{left: Tree.Leaf{value: 1}, right: Tree.Leaf{value: 2}}
    b: Tree.Pair{left: Tree.Leaf{value: 1}, right: Tree.Leaf{value: 2}}
    c: Tree.Pair{left: Tree.Leaf{value: 1}, right: Tree.Leaf{value: 3}}
    print("{a == b} {a == c}")
    g: Holder{at: Point{x: 1, y: 2}}
    h: Holder{at: Point{x: 1, y: 2}}
    k: Holder{at: Point{x: 1, y: 3}}
    print("{g == h} {g == k}")
}
