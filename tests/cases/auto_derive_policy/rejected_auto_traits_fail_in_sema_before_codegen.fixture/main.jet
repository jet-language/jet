
#!Printable
NoPrint: struct { value: Int }
OuterNoPrint: struct { inner: NoPrint }

#!Debug
NoDebug: struct { value: Int }
OuterNoDebug: struct { inner: NoDebug }

#!Equatable
NoEquality: struct { value: Int }
OuterNoEquality: struct { inner: NoEquality }

OuterReader: struct { reader: FileReader }

#[!Printable, !Debug, !Equatable]
Hidden: struct<T> { value: T }
OuterHidden: struct { value: Hidden<Int> }

reject_opaque_core: fn(reader: FileReader) {
    print(reader)
    print("{reader:Debug}")
}

reject_outer_reader: fn(value: OuterReader) {
    print(value)
}

run: fn() {
    print(OuterNoPrint{ inner: NoPrint{ value: 1 } })
    print("{OuterNoDebug{ inner: NoDebug{ value: 2 } }:Debug}")
    print(OuterNoEquality{ inner: NoEquality{ value: 3 } } == OuterNoEquality{ inner: NoEquality{ value: 3 } })
    print(OuterHidden{ value: Hidden{ value: 4 } })
}
