
use process: core.process
Stored: tag { from: [Store.read], deny: [Exec] }
Store: struct {
    value: String
    read: fn(self) -> String { self.value }
}
run: fn() {
    store := Store{ value: "Ada" }
    receipt: process.cmd(["echo", store.read()]).run() ?? return Err("test")
    receipt.drop("only the argument flow matters here")
}
