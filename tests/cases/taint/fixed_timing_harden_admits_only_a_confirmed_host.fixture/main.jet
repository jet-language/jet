// A `policy.harden` package that holds `timing: .Fixed` values starts only on
// a host sys.timing_host() confirms: on any other host its entry refuses to
// start before `run` prints anything.
use sys: core.sys

Key: tag { deny: [Exec], timing: .Fixed }

#Scrub(Key)
reveal: fn(value: #Key U64) -> U64 { value }

pick: fn(k: #Key U64, a: U64, b: U64) -> U64 {
    if k == (U64{1}) -> a else -> b
}

run: fn() -[Env, IO]> {
    host: if sys.timing_host() == {
        .Confirmed -> "a confirmed host"
        .Unconfirmed -> "an unconfirmed host"
    }
    print("started on {host}: pick {reveal(pick(#Key U64{1}, U64{7}, U64{9}))}")
}
