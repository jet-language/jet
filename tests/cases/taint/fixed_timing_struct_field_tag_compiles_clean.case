# A struct field tagged with a `timing: .Fixed` tag compiles with no
# diagnostic: the code the compiler derives for the struct (Derives.jet's
# `equal` and `compare`) is not reported against the user's file.
fixture: fixed_timing_struct_field_tag_compiles_clean.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = fixed_timing_struct_field_tag_compiles_clean.out
