// Early returns from branches on a `timing: .Fixed` value are masked: every
// round of the loop runs, and the function returns the value of the first
// return taken.
Key: tag { deny: [Exec], timing: .Fixed }

#Scrub(Key)
reveal_flag: fn(value: #Key Bool) -> Bool { value }

#Scrub(Key)
reveal: fn(value: #Key U64) -> U64 { value }

check_fast: fn(expected: #Key [U8], got: [U8]) -> #Key Bool {
    if expected.len() != got.len() -> return false
    loop i in 0..<got.len() {
        if expected[i] != got[i] -> return false
    }
    true
}

position: fn(k: #Key U64, items: [U64]) -> #Key U64 {
    count := U64{0}
    loop i in 0..<items.len() {
        if items[i] == k -> return count
        count = count.wrapping_add(U64{1})
    }
    U64{99}
}

run: fn() {
    // The checks are called where they print, not bound to local values: a
    // local value of constant inputs folds at build time, and the masked
    // branch of the function it calls with it.
    print("check {reveal_flag(check_fast(#Key [U8]{1, 2, 3}, [U8]{1, 2, 3}))} {reveal_flag(check_fast(#Key [U8]{1, 2, 3}, [U8]{1, 9, 3}))} {reveal_flag(check_fast(#Key [U8]{1, 2}, [U8]{1, 2, 3}))}")
    items: [U64]{3, 5, 7}
    print("position {reveal(position(#Key U64{5}, items))} {reveal(position(#Key U64{9}, items))} {reveal(position(#Key U64{3}, items))}")
}
