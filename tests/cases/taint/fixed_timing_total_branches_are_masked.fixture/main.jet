// Branches on a `timing: .Fixed` value whose arms are total are masked:
// both arms run and the result is selected with no jump.
Key: tag { deny: [Exec], timing: .Fixed }

#Scrub(Key)
reveal: fn(value: #Key U64) -> U64 { value }

#Scrub(Key)
reveal_flag: fn(value: #Key Bool) -> Bool { value }

#Scrub(Key)
reveal_byte: fn(value: #Key U8) -> U8 { value }

pick: fn(k: #Key U64, a: U64, b: U64) -> U64 {
    if k == (U64{1}) -> a else -> b
}

order: fn(k: #Key U64, a: U64, b: U64) -> U64 {
    low := a
    high := b
    if k.bit_and(U64{1}) == (U64{1}) {
        low = b
        high = a
    }
    wrapping(wrapping(low * U64{1000}) + high)
}

same: fn(k: #Key U64, v: U64) -> Bool {
    found := false
    if k == v -> found = true
    found
}

grade: fn(k: #Key U64) -> U64 {
    r := U64{0}
    if k > (U64{10}) {
        if k > (U64{100}) -> r = U64{3} else -> r = U64{2}
    } else if k > (U64{5}) {
        r = U64{1}
    }
    r
}

small: fn(k: #Key U8) -> U8 {
    if k < (U8{128}) -> k.bit_xor(U8{255}) else -> k
}

run: fn() {
    print("pick {reveal(pick(#Key U64{1}, U64{7}, U64{9}))} {reveal(pick(#Key U64{2}, U64{7}, U64{9}))}")
    print("order {reveal(order(#Key U64{3}, U64{4}, U64{5}))} {reveal(order(#Key U64{2}, U64{4}, U64{5}))}")
    print("same {reveal_flag(same(#Key U64{6}, U64{6}))} {reveal_flag(same(#Key U64{6}, U64{7}))}")
    print("grade {reveal(grade(#Key U64{1}))} {reveal(grade(#Key U64{6}))} {reveal(grade(#Key U64{50}))} {reveal(grade(#Key U64{500}))}")
    print("small {reveal_byte(small(#Key U8{3}))} {reveal_byte(small(#Key U8{200}))}")
}
