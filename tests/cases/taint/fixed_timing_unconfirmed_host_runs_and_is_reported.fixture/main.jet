// Without `policy.harden`, fixed-timing code runs on every host.
Key: tag { deny: [Exec], timing: .Fixed }

#Scrub(Key)
reveal: fn(value: #Key U64) -> U64 { value }

pick: fn(k: #Key U64, a: U64, b: U64) -> U64 {
    if k == (U64{1}) -> a else -> b
}

run: fn() {
    print("pick {reveal(pick(#Key U64{1}, U64{7}, U64{9}))}")
}
