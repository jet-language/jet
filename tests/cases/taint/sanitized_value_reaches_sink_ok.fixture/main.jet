
use process: core.process
#Scrub(Input) clean: fn(raw: #Input String) -> String { return raw.split(" ").to_list()[0] }
run: fn() {
    name: #Input "world; rm -rf /"
    safe := clean(name)
    receipt: process.cmd(["echo", safe]).run() ?? return Err("test")
    receipt.drop("only the argument flow matters here")
}
