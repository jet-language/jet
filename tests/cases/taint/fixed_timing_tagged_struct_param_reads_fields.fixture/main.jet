Limbs: struct {
    p: [U64]
}

or_limbs: fn(x: #Secret Limbs) -> U64 {
    acc := U64{0}
    loop i in 0..<x.p.len() -> acc = acc.bit_or(x.p[i])
    acc
}

clear: fn(x: &#Secret Limbs) {
    loop i in 0..<x.p.len() -> x.p[i] = U64{0}
}

run: fn() {
    limbs := Limbs{p: [U64]{U64{1}, U64{6}}}
    before: or_limbs(limbs)
    clear(limbs)
    after: or_limbs(limbs)
    print("{before} {after}")
}
