# A parameter whose type is a tagged struct (`x: #Secret Limbs`) reads and
# writes the struct's declared fields; a read keeps the value's tag, and
# total code over the fields compiles and runs with no diagnostic.
fixture: fixed_timing_tagged_struct_param_reads_fields.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = fixed_timing_tagged_struct_param_reads_fields.out
