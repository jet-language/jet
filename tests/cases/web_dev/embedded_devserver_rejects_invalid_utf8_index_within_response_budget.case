# PENDING-SEAM(DFileRaw + read_bytes; original HTTP client algorithm in Jet)
fixture: embedded_devserver_rejects_invalid_utf8_index_within_response_budget.fixture
env: S5_PORT={free-port:web}
env: S5_CHECK=0
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
write: app.jet app.source
session app raw: jet dev app.jet
stderr: null
recv app line until ^= "App preview: " timeout 60s
capture: served = text stdout.strip_prefix_lines("App preview: ").line(0).split("://",1).split("/",0).after_last(":")
json: cap:served doc $ = {free-port:web}
step: jet test claims
exit: 0
write: build/index.html empty
resize: build/index.html 67104768
poke: build/index.html at 0 hex "ff"
step: jet test claims
env: S5_CHECK=1
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
