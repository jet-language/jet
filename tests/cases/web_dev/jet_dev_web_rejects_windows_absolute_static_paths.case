# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: jet_dev_web_rejects_windows_absolute_static_paths.fixture
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
session app raw: jet dev app.jet --target=web
stderr: null
recv app line until ^= "App preview: " timeout 60s
capture: port = text stdout.strip_prefix_lines("App preview: ").line(0).split("://",1).split("/",0).after_last(":")
cap:port: is-u32
json: cap:port doc $ <= 65535
step: jet test claims
env: S5_PORT={cap:port}
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
