# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: jet_dev_web_browser_runs_hybrid_status_overlay_and_recovery_matrix.fixture
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
env: S5_ROOT={work}
requires: os-name:linux
requires: tool:chromium
requires: tool:chromedriver
env: JET_PROJECT_ROOT={work}
requires: tool:script
env: S5_PORT={free-port:web}
session app raw: script -qfec "env NO_COLOR=1 {jet} dev app.jet --target=web --canvas --verbose --port={free-port:web}" browser-terminal.typescript
stdout: null
stderr: null
step: jet test claims
exit: 0
step: jetpack browser lock chromium --binary {tool:chromium} --driver {tool:chromedriver} --version 152.0 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {root}/Tools/web-dev-test/Hybrid.jet -- --port {free-port:web} --source {work}/app.jet --terminal-transcript {work}/browser-terminal.typescript
exit: 0
stdout: ~ "PASS hybrid dev-server browser matrix" # original browser runner completion substring
file: app.jet = edited.source
capture: before = size file browser-terminal.typescript
send app: "\u0003"
wait app timeout 5s
exit: 130
capture: after = size file browser-terminal.typescript
file.slice({cap:before},{cap:after}): browser-terminal.typescript ~ "\u001b[r" # original final_transcript[before_ctrl_c..].contains
