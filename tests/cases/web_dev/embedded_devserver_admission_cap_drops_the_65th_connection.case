# Original tests/web_dev.rs:3541-3623; exact admitted connection count, successful bytes, empty response and timing predicates.
# D-NET-IO-KIND1 NOT-A-BALLOT desk note ~/.cache/jet-dev/scratch/ballots/D-NET-IO-KIND1.md: original Reset|Aborted|EOF union maps to ConnectionReset or empty read; tcp_shutdown exists; single-task write/deadline-read replaces cloned writer load.
# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw); core-net-io-kind PORTED.
fixture: embedded_devserver_admission_cap_drops_the_65th_connection.fixture
env: S5_PORT={free-port:web}
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
write: app.jet app.source
session app raw: jet dev app.jet
stderr: null
recv app line until ^= "App preview: " timeout 60s
capture: served = text stdout.strip_prefix_lines("App preview: ").line(0).split("://",1).split("/",0).after_last(":")
json: cap:served doc $ = {free-port:web}
step: jet test claims
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
