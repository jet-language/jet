use core.files as files

fn s5_version(port: Int) -> String {
    response :: s5_web_get(port, "/__jet_dev_version", None) ?? panic("GET version")
    String.from_bytes_lossy(response.body).trim().copy()
}

fn s5_changed(port: Int, baseline: String, timeout_ms: Int) -> String {
    started :: time.start()
    loop {
        if s5_web_get(port, "/__jet_dev_version", None) == .Val(response) {
            if response.status == 200 {
                version :: String.from_bytes_lossy(response.body).trim().copy()
                if version != baseline && !version.is_empty() -> return version
            }
        }
        assert(time.elapsed(started).ns <= timeout_ms * 1000000, "version never changed")
        time.sleep(time.duration_ms(100))
    }
}

fn s5_root() -> String { sys.get("S5_ROOT") ?? panic("root") }

#Test("original Unix file identity and publish recovery") {
    port :: s5_web_port()
    root :: s5_root()
    s5_web_wait_up(port, 30000)
    phase :: sys.get("S5_PHASE") ?? panic("phase")
    if phase == "static" {
        outside :: files.join(root, "outside-static.js")
        files.write(outside, "outside-static") ?? panic("outside static")
        files.hard_link(outside, files.join(root, "build/hardlinked.js")) ?? panic("hardlink static")
        response :: s5_web_get(port, "/hardlinked.js", None) ?? panic("hardlinked GET")
        assert_eq(response.status, 400)
        assert(response.body.is_empty() || response.body == "bad path".bytes())
        assert_eq(files.read_bytes(outside) ?? panic("outside bytes"), "outside-static".bytes())
    } else if phase == "socket" {
        response :: s5_web_get(port, "/special.sock", None) ?? panic("socket GET")
        assert_eq(response.status, 400)
    } else {
        outside :: files.join(root, "outside-output.js")
        output :: files.join(root, "build/app.js")
        source_path :: files.join(root, "app.jet")
        files.write(outside, "outside-output") ?? panic("outside output")
        files.remove(output) ?? panic("remove output")
        files.hard_link(outside, output) ?? panic("hardlink output")
        baseline :: s5_version(port)
        source :: files.read(source_path) ?? panic("read source")
        files.write(source_path, source.replace("host", "changed")) ?? panic("save changed")
        started :: time.start()
        loop time.elapsed(started).ns < 5000000000 {
            assert_eq(s5_version(port), baseline)
            time.sleep(time.duration_ms(100))
        }
        assert_eq(files.read_bytes(outside) ?? panic("outside bytes"), "outside-output".bytes())
        assert_eq(files.read_bytes(output) ?? panic("output bytes"), "outside-output".bytes())
        files.remove(output) ?? panic("remove hardlinked output")
        files.write(source_path, source.replace("host", "recovered")) ?? panic("save recovered")
        recovered :: s5_changed(port, baseline, 15000)
        assert(recovered != baseline)
        assert_eq(files.read_bytes(outside) ?? panic("outside recovery bytes"), "outside-output".bytes())
    }
}
