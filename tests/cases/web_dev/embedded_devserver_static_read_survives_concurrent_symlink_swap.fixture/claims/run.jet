use core.files as files

#Test("original in-root baseline and race aggregate") {
    root :: sys.get("S5_ROOT") ?? panic("root")
    if (sys.get("S5_PHASE") ?? panic("phase")) == "baseline" {
        s5_web_wait_up(s5_web_port(), 30000)
        response :: s5_web_get(s5_web_port(), "/race.js", None) ?? panic("initial static GET")
        assert_eq(response.status, 200)
        assert_eq(response.content_type, "application/javascript; charset=utf-8")
        assert_eq(response.body, "inside".bytes())
    } else {
        total := 0
        loop worker in 0..<4 {
            count :: files.read(files.join(root, "served-{worker}")) ?? panic("served report")
            total = total + (Int.parse(count) ?? panic("served count"))
        }
        assert(total > 0)
    }
}
