    helper_query_body :: s5_canvas_body(helper_query_body_response)
    assert(helper_query_body.contains("\"protocol\":\"jet.canvas.query\""))
    helper_edit_body_response :: s5_canvas_post("/canvas/transaction", (String.from_bytes([U8]{123,34,115,99,104,101,109,97,95,118,101,114,115,105,111,110,34,58,49,44,34,111,112,34,58,34,114,101,112,108,97,99,101,95,115,111,117,114,99,101,34,44,34,115,111,117,114,99,101,95,105,100,34,58,34,104,101,108,112,101,114,46,106,101,116,34,44,34,114,101,118,105,115,105,111,110,34,58,34,64,72,69,76,80,69,82,64,34,44,34,115,111,117,114,99,101,34,58,34,102,110,32,114,117,110,40,41,32,123,92,110,32,32,32,32,112,114,105,110,116,40,92,34,101,100,105,116,101,100,32,104,101,108,112,101,114,92,34,41,92,110,125,92,110,34,125}) ?? panic("literal UTF-8")).replace("@REV@", revision).replace("@HELPER@", helper_revision).replace("@SESSION@", helper_session).replace("@PROJECT@", project_revision).replace("@MANIFEST@", manifest_revision))
    assert_eq(helper_edit_body_response.status, 200)
    helper_edit_body :: s5_canvas_body(helper_edit_body_response)
    assert(helper_edit_body.contains("\"changed\":true"))
    assert((files.read(files.join(root, "helper.jet")) ?? panic("edited helper")).contains("edited helper"))
    assert_eq(files.read(files.join(root, "app.jet")) ?? panic("unchanged entry"), source)
    catalog_response :: s5_canvas_get("/canvas/core-catalog?query=http")
    assert_eq(catalog_response.status, 200)
    catalog :: s5_canvas_body(catalog_response)
    assert(catalog.contains("\"op\":\"core_catalog\""))
    assert(catalog.contains("\"catalog_schema_version\":1"))
    assert(catalog.contains("\"authority\":[\"canvas.catalog:core.read\"]"))
    assert(catalog.contains("\"path\":\"core.http\""))
    assert(catalog.contains("\"source\":\"Docs/spec/reference/core-library.md\""))
    project_revision = s5_canvas_field(project, "project_revision")
    manifest_source :: files.read(files.join(root, "package.jet")) ?? panic("manifest source")
    manifest_revision = s5_canvas_revision(manifest_source)
    project_tx_response :: s5_canvas_post("/canvas/project/transaction", (String.from_bytes([U8]{123,34,115,99,104,101,109,97,95,118,101,114,115,105,111,110,34,58,49,44,34,111,112,34,58,34,97,100,100,95,100,101,112,101,110,100,101,110,99,121,34,44,34,112,114,101,118,105,101,119,34,58,116,114,117,101,44,34,112,114,111,106,101,99,116,95,114,101,118,105,115,105,111,110,34,58,34,64,80,82,79,74,69,67,84,64,34,44,34,102,105,108,101,115,34,58,91,123,34,112,97,116,104,34,58,34,112,97,99,107,97,103,101,46,106,101,116,34,44,34,114,101,118,105,115,105,111,110,34,58,34,64,77,65,78,73,70,69,83,84,64,34,125,93,44,34,109,97,110,105,102,101,115,116,34,58,34,112,97,99,107,97,103,101,46,106,101,116,34,44,34,110,97,109,101,34,58,34,108,111,103,103,105,110,103,34,44,34,115,112,101,99,34,58,34,48,46,49,46,48,34,125}) ?? panic("literal UTF-8")).replace("@REV@", revision).replace("@HELPER@", helper_revision).replace("@SESSION@", helper_session).replace("@PROJECT@", project_revision).replace("@MANIFEST@", manifest_revision))
    assert_eq(project_tx_response.status, 200)
    project_tx :: s5_canvas_body(project_tx_response)
    assert(project_tx.contains("\"protocol\":\"jet.canvas.project.edit\""))
    assert(project_tx.contains("\"writes\":\"preview_only\""))
    assert(project_tx.contains("+    logging: \\\"0.1.0\\\","))
    assert(!(files.read(files.join(root, "package.jet")) ?? panic("manifest after preview")).contains("logging"))
}
