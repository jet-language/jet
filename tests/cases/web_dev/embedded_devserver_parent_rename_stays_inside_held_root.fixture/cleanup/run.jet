use {
    files: core.files
    sys: core.sys
}
run: fn() {
    root: sys.get("S5_ROOT") ?? panic("root")
    files.remove(files.join(root, "build/nested")).drop("original ignored unlink")
    files.rename(files.join(root, "build/nested.parked"), files.join(root, "build/nested")).drop("original ignored rename")
}
