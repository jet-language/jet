use core.files as files

fn run() {
    port :: s5_web_port()
    root :: sys.get("S5_ROOT") ?? panic("root")
    worker :: sys.get("S5_WORKER") ?? panic("worker")
    leaked := false
    served := 0
    loop request in 0..<256 {
        if s5_web_get(port, "/nested/race.js", None) == .Val(response) {
            if response.status == 200 -> served = served + 1
            if response.status == 200 && response.body != "inside-parent".bytes() {
                leaked = true
                break
            }
        }
    }
    files.write(files.join(root, "served-{worker}"), "{served}") ?? panic("served report")
    print(leaked)
}
