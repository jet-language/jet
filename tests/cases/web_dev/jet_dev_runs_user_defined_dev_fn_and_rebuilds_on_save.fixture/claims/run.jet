use core.files as files

fn s5_version(port: Int) -> String {
    response :: s5_web_get(port, "/__jet_dev_version", None) ?? panic("GET version")
    String.from_bytes_lossy(response.body).trim().copy()
}

fn s5_changed(port: Int, baseline: String, timeout_ms: Int) -> String {
    started :: time.start()
    loop {
        if s5_web_get(port, "/__jet_dev_version", None) == .Val(response) {
            if response.status == 200 {
                version :: String.from_bytes_lossy(response.body).trim().copy()
                if version != baseline && !version.is_empty() -> return version
            }
        }
        assert(time.elapsed(started).ns <= timeout_ms * 1000000, "version never changed")
        time.sleep(time.duration_ms(100))
    }
}

fn s5_root() -> String { sys.get("S5_ROOT") ?? panic("root") }

#Test("original dev watcher saves launched source") {
    port :: s5_web_port()
    s5_web_wait_up(port, 30000)
    paths :: [String]{"/C:/Windows/win.ini", "/\\Windows\\win.ini", "/\\\\server\\share\\secret"}
    loop requested in paths {
        response :: s5_web_get(port, requested, None) ?? panic("hostile request")
        assert_eq(response.status, 400)
    }
    response :: s5_web_get(port, "/__jet_dev_version", None) ?? panic("version")
    assert_eq(response.status, 200)
    baseline :: String.from_bytes_lossy(response.body).trim().copy()
    js :: s5_web_get(port, "/app.js", None) ?? panic("app.js")
    assert_eq(js.status, 200)
    assert(!js.body.is_empty())
    source_path :: files.join(s5_root(), "app.jet")
    source :: files.read(source_path) ?? panic("read source")
    files.write(source_path, source.replace("hello, world", "hello there")) ?? panic("save source")
    changed :: s5_changed(port, baseline, 20000)
    assert(changed != baseline)
}
