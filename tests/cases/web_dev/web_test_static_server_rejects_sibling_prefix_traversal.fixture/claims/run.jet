// tests/web_dev.rs826-862; public raw HTTP client, assertion for assertion.
#Test("sibling prefix traversal is rejected without secret bytes") {
    port :: s5_web_port()
    s5_web_wait_root(port, true)
    root :: s5_web_get(port, "/", None) ?? panic("GET /")
    assert_eq(root.status, 200)
    assert_eq(root.content_type, "text/html; charset=utf-8")
    traversal :: s5_web_get(port, "/../root-sibling/secret.js", None) ?? panic("traversal GET")
    assert_eq(traversal.status, 400)
    assert(s5_web_find(traversal.body, "sibling-secret".bytes()) == None)
}
