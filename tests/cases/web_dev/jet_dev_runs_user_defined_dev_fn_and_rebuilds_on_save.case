# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: jet_dev_runs_user_defined_dev_fn_and_rebuilds_on_save.fixture
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
env: S5_PORT={free-port:web}
