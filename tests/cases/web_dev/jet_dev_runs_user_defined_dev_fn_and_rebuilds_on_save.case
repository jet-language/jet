write: app.jet app.source
session app raw: jet dev app.jet
env: PATH={jet-dir}:{env:PATH}
stdout: null
stderr: null
step: jet test claims
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
