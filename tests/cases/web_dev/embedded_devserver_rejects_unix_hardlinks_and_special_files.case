# PENDING-GRAMMAR(batch-four); PENDING-SEAM(read_bytes/DFileRaw).
fixture: embedded_devserver_rejects_unix_hardlinks_and_special_files.fixture
copy: {root}/tests/cases/web_dev/support.fixture/HTTP.jet claims/HTTP.jet
env: S5_PORT={free-port:web}
env: S5_ROOT={work}
requires: os:unix
step: jet build socket-owner
exit: 0
write: app.jet app.source
session app raw: jet dev app.jet
stderr: null
recv app line until ^= "App preview: " timeout 60s
capture: served = text stdout.strip_prefix_lines("App preview: ").line(0).split("://",1).split("/",0).after_last(":")
json: cap:served doc $ = {free-port:web}
step: jet test claims
env: S5_PHASE=static
exit: 0
session socket raw: built
env: S5_SOCKET={work}/build/special.sock
recv socket line until = "ready" timeout 10s
step: jet test claims
env: S5_PHASE=socket
exit: 0
signal socket: KILL
close socket
exit: any # original drop(socket) asserts no exit status; socket path remains
step: jet test claims
env: S5_PHASE=output
exit: 0
signal app: KILL
close app
exit: any # original KillOnDrop ignores child status
