# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four); no reference-run or PASS claim.
requires: tool:rustc
requires: os-name:linux
requires: tool:chromium
requires: tool:chromedriver
env: JET_PROJECT_ROOT={work}
copy: {root}/Examples/Apps/Web/JetWeb/run.jet run.jet
copy: {root}/Examples/Apps/Web/JetWeb/package.jet package.jet
copy: {root}/Examples/Apps/Web/JetWeb/Public/index.html Public/index.html
copy: {root}/Examples/Apps/Web/JetWeb/Public/App.css Public/App.css
step: jetpack browser lock chromium --binary {tool:chromium} --driver {tool:chromedriver} --version 152.0 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {root}/Tools/web-dev-test/ReferenceApp.jet -- --metric error_to_fix --manifest {root}/Tools/agent-eval/dx/manifest.json --exercise --app jet-web-orders
exit: 0
stdout: ~ "REFERENCE_METRIC:error_to_fix" # original predicate
stdout: ~ "diagnosis_ms=" # original predicate
stdout: ~ "repair_ms=" # original predicate
