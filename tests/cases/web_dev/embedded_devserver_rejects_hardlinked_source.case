# PENDING-SEAM(DFileRaw hardlink; exact original command and byte equality)
fixture: embedded_devserver_rejects_hardlinked_source.fixture
env: S5_PORT={free-port:web}
env: S5_CHECK=0
requires: os:unix|windows
write: outside-app.jet app.source
step: jet check outside-app.jet # a refusal only counts for an app that compiles; a broken app would keep `jet dev` watching instead of exiting
exit: 0
capture: before = opt-bytes file outside-app.jet
hardlink: outside-app.jet app.jet
step: jet dev app.jet
exit: nonzero
file: outside-app.jet same-as {cap:before}
