# Every immutable `name: value` local reports when it is computed:
# while compiling with its value, or at run time with the reason it waits.
fixture: immutable_locals_report_their_stage.fixture
step: jet inspect semindex stages.jet --json
exit: 0
json: stdout doc $.semindex.definitions[?leaf_name="base"][0].detail.stage = {"when":"build","value":"40"}
json: stdout doc $.semindex.definitions[?leaf_name="scaled"][0].detail.stage = {"when":"build","value":"120"}
json: stdout doc $.semindex.definitions[?leaf_name="name"][0].detail.stage = {"when":"build","value":"\"jet\""}
json: stdout doc $.semindex.definitions[?leaf_name="shown"][0].detail.stage = {"when":"run","reason":"it reads `count`, which only the running program knows"}
json: stdout doc $.semindex.definitions[?leaf_name="logged"][0].detail.stage = {"when":"run","reason":"it calls `log_total`, which prints text or reads input"}
json: stdout doc $.semindex.definitions[?leaf_name="twice"][0].detail.stage.when = "run"
json: stdout doc $.semindex.definitions[?leaf_name="twice"][0].detail.stage.reason ~ "which a build can't keep" # the reason also names the held type, whose spelling is not part of this contract
