square: fn(value: Int) -> Int {
    value * value
}

greeting: fn(name: String) -> String {
    "hello {name}"
}

explode: fn(value: Int) -> Int {
    if value == 0 -> panic("zero")
    value
}

spin: fn() -> Int {
    i := 0
    loop i >= 0 -> i += 1
    i
}

computed: fn(flag: Bool) -> Int {
    area: square(7)
    hello: greeting("jet")
    if flag {
        risky: explode(0)
        spun: spin()
        return risky + spun
    }
    area + hello.len()
}

run: fn() {
    print("{computed(false)}")
}
