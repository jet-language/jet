
Light: enum {
    Red
    Green
}

helper: fn(p: Point) -> Int {
    p.sum()
}

Point: struct {
    x: Int
    y: Int

    sum: fn(self) -> Int {
        self.x + self.y
    }
}

math: module {
    double: fn(n: Int) -> Int {
        n * 2
    }
}

impl Point {
    origin: fn() -> Point {
        Point{x: 0, y: 0}
    }
}

run: fn() {
    p: Point.origin()
    print(helper(p))
}
