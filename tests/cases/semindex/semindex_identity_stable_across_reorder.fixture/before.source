
module math {
    fn double(n: Int) -> Int {
        n * 2
    }
}

struct Point {
    x: Int
    y: Int

    fn sum(self) -> Int {
        self.x + self.y
    }
}

impl Point {
    fn origin() -> Point {
        Point{x: 0, y: 0}
    }
}

enum Light {
    Red
    Green
}

fn helper(p: Point) -> Int {
    p.sum()
}

fn run() {
    p :: Point.origin()
    print(helper(p))
}
