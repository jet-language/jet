log_total: fn(value: Int) -> Int {
    print("total {value}")
    value
}

stages: fn(count: Int) -> Int {
    base: 40
    scaled: base * 3
    name: "jet"
    shown: count + base
    logged: log_total(7)
    twice: fn(value: Int) { value * 2 }
    base + scaled + shown + logged + twice(name.len())
}

run: fn() {
    print("{stages(2)}")
}
