
DrawThing: trait {
    render: fn(self) -> String
}

Widget: struct {
    title: String

    label: fn(self) -> String {
        self.title.copy()
    }

    size: fn(self) -> Int {
        1
    }

    impl DrawThing {
        render: fn(self) -> String {
            self.label()
        }
    }
}

run: fn() {
    w: Widget{title: "ok"}
    print(w.render())
}
