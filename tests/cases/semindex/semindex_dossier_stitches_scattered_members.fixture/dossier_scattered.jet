
trait DrawThing {
    fn render(self) -> String
}

struct Widget {
    title: String

    fn label(self) -> String {
        self.title.copy()
    }
}

impl Widget {
    fn size(self) -> Int {
        1
    }
}

impl Widget.DrawThing {
    fn render(self) -> String {
        self.label()
    }
}

fn run() {
    w :: Widget{title: "ok"}
    print(w.render())
}
