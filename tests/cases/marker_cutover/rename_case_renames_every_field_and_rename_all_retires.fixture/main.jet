// A type-level `#Rename(.Camel)` renames every field; a
// field-level `#Rename("…")` still wins for that one field.
use json: core.encoding.json

#[Codable, Rename(.Camel)]
Person: struct {
    full_name: String
    #Rename("years") age_in_years: Int
}

run: fn() [FieldError]! {
    person: json.decode<Person>("{{\"fullName\":\"Ada\",\"years\":36}}")
    print(person.full_name)
    print(person.age_in_years)
    print(json.to_string(person) ?? panic("JSON encode"))
}
