Door: struct {
    state {
        Closed -> Open
        Open -> Closed
    }

    name: String

    new: fn(name: String) -[]> Door.Closed { Door{name: name.copy()} }

    open: fn(self: &&Door.Closed) -[]> Door.Open { self }

    close: fn(self: &&Door.Open) -[]> Door.Closed { self }

    label: fn(self: Door.Open) -[]> String { "{self.name} is open" }
}

run: fn() {
    door := Door.new("front")
    door = door.open()
    print(door.label())
    door = door.close()
    door = door.open()
    print(door.label())
}
