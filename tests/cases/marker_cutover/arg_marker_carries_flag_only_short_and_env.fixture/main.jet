// One `#Arg` marker carries a command field's options.
#CLI
ServeArgs: struct {
    #[Doc("port to listen on"), Arg(short: "p", env: "ARG_CASE_PORT")] port: Int{3000}
    #Arg(flag_only: true) token: String
    #Arg(false, "n") name: String
}

run: fn(args: ServeArgs) {
    print("port={args.port} token={args.token} name={args.name}")
}
