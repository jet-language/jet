# Arithmetic is a `#Policy` setting. On the line above a
# function or a method, or on a block, `#Policy(arithmetic: .Mode)` sets the
# fixed-width arithmetic of that body only. A module or package arithmetic
# policy is refused, a bare `arithmetic` needs a mode, and a mode outside the
# `.Checked` / `.Wrapping` / `.Saturating` menu is E0930. The retired
# `#Arithmetic` marker is an unknown marker (E0927).
fixture: arithmetic_policy_setting_scopes_function_method_and_block_bodies.fixture
env: NO_COLOR=1
step run: jet run main.jet
exit: 0
stdout: = "4\n255\n244\n"
stderr: empty
step module: jet check module/main.jet
exit: 1
stderr: ~ "`arithmetic` is not a module policy" # a blank line leaves the policy at module scope
stderr: ~ "--> main.jet:1:1" # located at the module policy
stderr: ~ "jet-lang.dev/e/E0355" # the scoped-policy code
stderr: ~ "1 problem found" # one diagnostic only
step bare: jet check bare/main.jet
exit: 1
stderr: ~ "`arithmetic` needs an explicit mode" # no default mode is implied
stderr: ~ "--> main.jet:1:9" # located at the bare key
stderr: ~ "jet-lang.dev/e/E0355" # the scoped-policy code
step mode: jet check mode/main.jet
exit: 1
stderr: ~ "`#Policy` arguments do not match `Policy(PolicySetting...)`" # `.Fast` is not a mode
stderr: ~ "--> main.jet:1:2" # located at the marker
stderr: ~ "jet-lang.dev/e/E0930" # the marker-signature code
step package: jet check package/run.jet
exit: 1
stderr: ~ "`arithmetic` is not a package policy" # the package manifest refuses the key
stderr: ~ "jet-lang.dev/e/E1215" # the invalid-manifest code
step retired: jet check retired/main.jet
exit: 1
stderr: ~ "`#Arithmetic` isn't a known applied rule" # the old marker is retired
stderr: ~ "--> main.jet:1:2" # located at the retired marker
stderr: ~ "jet-lang.dev/e/E0927" # unknown marker, no teaching diagnostic
stderr: ~ "1 problem found" # one diagnostic only
