# #4284 c12 (#4296): `#Export(wasm)` is the JS-to-Wasm bridge entry. A web
# build puts `compute` in the app Wasm partition behind the generated JS
# bridge, and the page prints its result through that bridge. `#Export(c)`
# stays the native export, and the retired `#WasmExport` is an unknown
# marker (E0927).
fixture: export_wasm_selects_the_wasm_bridge_and_wasm_export_retires.fixture
env: NO_COLOR=1
step check: jet check main.jet
exit: 0
step web: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
file: .jet/build/web.manifest.json ~ "{\"name\": \"app\", \"module\": \"app.wasm\"" # the app partition holds the export
file: .jet/build/web.manifest.json ~ "\"slots\": 1}" # one bridge slot, `compute`
step bridge: node .jet/build/app.js
exit: 0
stdout: = "42\n"
step cexport: jet run cexport/main.jet
exit: 0
stdout: = "42\n"
step retired: jet check retired/main.jet
exit: 1
stderr: ~ "`#WasmExport` isn't a known applied rule" # the old marker is retired
stderr: ~ "--> main.jet:1:2" # located at the retired marker
stderr: ~ "jet-lang.dev/e/E0927" # unknown marker, no teaching diagnostic
stderr: ~ "1 problem found" # one diagnostic only
