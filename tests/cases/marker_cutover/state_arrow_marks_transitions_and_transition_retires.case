# #4284 c17 (#4302): `#State(A -> B)` is the transition marker (`_` as A at
# entry) and `#State(S)` the required state. The fixture runs and formats
# stably, a call in the wrong state is E0150, a chain or another shape is
# E0930, and the retired `#Transition(A, B)` is an unknown marker (E0927).
fixture: state_arrow_marks_transitions_and_transition_retires.fixture
env: NO_COLOR=1
step run: jet run main.jet
exit: 0
stdout: = "front is open\nfront is open\n"
stderr: empty
step fmt: jet fmt --check main.jet
exit: 0 # the arrow form is the canonical spelling
step wrong: jet check wrong/main.jet
exit: 1
stderr: ~ "`label` needs `Door` in state `Open`, but `door` is in state `Closed`" # the required state is checked
stderr: ~ "--> main.jet:13:16" # located at the call
stderr: ~ "jet-lang.dev/e/E0150" # the typestate code
step chain: jet check chain/main.jet
exit: 1
stderr: ~ "`#State` arguments do not match `State(S)` or `State(A -> B)`" # a transition is one step
stderr: ~ "--> main.jet:7:6" # located at the marker
stderr: ~ "jet-lang.dev/e/E0930" # the marker shape code
stderr: ~ "1 problem found" # one diagnostic only
step shape: jet check shape/main.jet
exit: 1
stderr: ~ "`#State` arguments do not match `State(S)` or `State(A -> B)`" # `_` is only a from-state
stderr: ~ "--> main.jet:7:6" # located at the marker
stderr: ~ "jet-lang.dev/e/E0930" # the marker shape code
step retired: jet check retired/main.jet
exit: 1
stderr: ~ "`#Transition` isn't a known applied rule" # the old marker is retired
stderr: ~ "--> main.jet:7:6" # located at the retired marker
stderr: ~ "jet-lang.dev/e/E0927" # unknown marker, no teaching diagnostic
stderr: ~ "1 problem found" # one diagnostic only
