exit: 0
stdout: = "2\n"
stderr: empty
step off_dev: jet dev --watch=off app/main.jet -- --bad side
exit: 0
stdout: = "2\n"
stderr: empty
step library_dev: jet dev --watch=off --deep-checks=shapes app/main.jet -- --bad side
exit: 70
stdout: empty
stderr: ~ "panic: a side is negative" # the failed deep check's own message
stderr: ~ "shapes.jet:4 in area" # the stop names the deep check's line and function
step library_skips_app_dev: jet dev --watch=off --deep-checks=shapes app/main.jet -- --bad count
exit: 0
stdout: = "8\n"
stderr: empty
step app_dev: jet dev --watch=off --deep-checks=app app/main.jet -- --bad count
exit: 70
stdout: empty
stderr: ~ "panic: the app has no shapes" # the failed deep check's own message
stderr: ~ "main.jet:14 in run" # the stop names the deep check's line and function
step app_skips_library_dev: jet dev --watch=off --deep-checks=app app/main.jet -- --bad side
exit: 0
stdout: = "2\n"
stderr: empty
step lambda_owner_dev: jet dev --watch=off --deep-checks=shapes::total app/main.jet -- --bad size
exit: 70
stdout: empty
stderr: ~ "panic: a size is negative" # the failed deep check's own message
stderr: ~ "shapes.jet:10 in total" # the stop names the deep check's line and function
step other_function_dev: jet dev --watch=off --deep-checks=shapes::area app/main.jet -- --bad size
exit: 0
stdout: = "4\n"
stderr: empty
step caller_dev: jet dev --watch=off --deep-checks=app::run app/main.jet -- --bad side
