step missing_source_off: jet run orphan/main.jet
exit: 1
stdout: empty
stderr: ~ "jet-lang.dev/e/E0603" # the missing dependency is refused at load
step missing_source_all: jet run --deep-checks orphan/main.jet
exit: 1
stdout: empty
stderr: ~ "jet-lang.dev/e/E0603" # selecting every deep check refuses it the same way
step missing_source_scope: jet run --deep-checks=shapes orphan/main.jet
exit: 1
stdout: empty
stderr: ~ "jet-lang.dev/e/E0603" # a scope naming the missing package refuses it the same way
