fn seed(n: Int) -[]> Int {
    return n
}

fn run() {
    two :: seed(2)
    print(seed(7) /% two)
    print(seed(-7) /% two)
    print(seed(7) /% seed(-2))
    print(seed(-7) /% seed(-2))
    print(seed(7) % two)
    print(seed(-7) % two)
    print(seed(7) %% two)
    print(seed(-7) %% two)
    print(7.5 /% 2.0)
    print(-7.5 /% 2.0)
    running := seed(9)
    running /%= seed(2)
    print(running)
    slot := seed(-3)
    slot %= seed(5)
    print(slot)
    debt := seed(-7)
    debt %%= seed(5)
    print(debt)
}
