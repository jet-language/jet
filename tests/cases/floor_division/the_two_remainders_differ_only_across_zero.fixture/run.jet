fn seed(n: Int) -[]> Int {
    return n
}

fn run() {
    two :: seed(2)
    print(seed(7) % two)
    print(seed(7) %% two)
    print(seed(-7) % two)
    print(seed(-7) %% two)
    print(seed(7) % seed(-2))
    print(seed(7) %% seed(-2))
    print(seed(-7) % seed(-2))
    print(seed(-7) %% seed(-2))
}
