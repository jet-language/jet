seed: fn(n: Int) -[]> Int {
    return n
}

check: fn(a: Int, b: Int) {
    floored: a % b
    truncated: a %% b
    print(floored == truncated || floored == truncated + b)
}

run: fn() {
    check(seed(7), seed(2))
    check(seed(-7), seed(2))
    check(seed(7), seed(-2))
    check(seed(-7), seed(-2))
    check(seed(9), seed(3))
    check(seed(-9), seed(3))
}
