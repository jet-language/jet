# A header that can't be read stops `jet inspect bind` with E3208 and names the unreadable header.
step: jet "inspect" "bind" "{work}/jet_missing_bind_header.h"
exit: 1
stdout: empty
stderr: ~ "Error [jet.BindingGenerationFailed]: Could not generate bindings from" # the binder refuses the header
stderr: ~ "jet_missing_bind_header.h" # the report names the header it could not read
stderr: ~ "the header file could not be read" # the cause is the unreadable header, not a parse failure
stderr: ~ "More: jet-lang.dev/e/E3208" # the code is E3208 BindingGenerationFailed
