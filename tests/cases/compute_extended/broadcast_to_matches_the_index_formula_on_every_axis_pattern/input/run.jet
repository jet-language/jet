use core.compute as compute

// The broadcast element at each flat target index, from the index formula:
// split the index into target coordinates and add each kept source axis's
// coordinate times its stride (an axis of size 1 contributes nothing).
fn by_formula(data: [Float], shape: [Int], target: [Int]) -> [Float] {
    rank :: target.len()
    lead :: rank - shape.len()
    n := 1
    loop d in target -> n = n * d
    out := [Float]{}
    loop flat in 0..<n {
        remainder := flat
        at := 0
        stride := 1
        loop k in 0..<rank {
            axis :: rank - 1 - k
            coordinate :: remainder % target[axis]
            remainder = remainder /% target[axis]
            if axis >= lead {
                dim :: shape[axis - lead]
                if dim != 1 -> at = at + coordinate * stride
                stride = stride * dim
            }
        }
        &out.push(data[at])
    }
    out
}

fn check(shape: [Int], target: [Int]) {
    n := 1
    loop d in shape -> n = n * d
    data := [Float]{}
    loop i in 0..<n -> &data.push(Float{i} + 1.0)
    flat :: compute.from_list(data) ?? panic("from_list")
    tensor :: compute.reshape(flat, shape) ?? panic("reshape")
    wide :: compute.broadcast_to(tensor, target) ?? panic("broadcast_to")
    got :: compute.to_list(wide)
    print("{shape} -> {target}: {got == by_formula(data, shape, target)} {got.len()}")
}

fn run() {
    check([3], [2, 3])
    check([2, 1], [2, 3])
    check([1, 3], [4, 3])
    check([2, 1, 3], [2, 4, 3])
    check([4, 1], [3, 4, 5])
    check([1], [2, 2, 2])
    check([1, 1], [1, 5])
    check([2, 3], [2, 3])
    check([3, 1, 1], [3, 2, 2])
    check([1, 2, 1, 2], [3, 2, 2, 2])
    check([1, 3], [0, 3])
}
