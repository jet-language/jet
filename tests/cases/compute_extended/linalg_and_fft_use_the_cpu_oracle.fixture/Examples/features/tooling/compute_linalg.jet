package {
    name: "tooling_compute_linalg"
    version: "0.1.0"
    authority: { holds: { allow: [GPU, IO, Mem.Alloc, Panic] } }
}

// D-COMPUTE1 / #1137: dense linalg + DFT on the Tensor CPU oracle.
use core.compute as compute
use core.compute.solve as solve

fn run() {
    a := compute.matrix(2, 2, 0.0) ?? panic("matrix")
    compute.set(&a, [0, 0], 4.0) ?? panic("set")
    compute.set(&a, [0, 1], 7.0) ?? panic("set")
    compute.set(&a, [1, 0], 2.0) ?? panic("set")
    compute.set(&a, [1, 1], 6.0) ?? panic("set")
    print("det:{compute.det(a) ?? panic("det")}")

    inv :: compute.inv(a) ?? panic("inv")
    print("inv:{compute.to_list(inv)}")

    pivot := compute.matrix(2, 2, 0.0) ?? panic("pivot")
    compute.set(&pivot, [0, 1], 2.0) ?? panic("set")
    compute.set(&pivot, [1, 0], 1.0) ?? panic("set")
    compute.set(&pivot, [1, 1], 3.0) ?? panic("set")

    b := compute.matrix(2, 1, 0.0) ?? panic("b")
    compute.set(&b, [0, 0], 4.0) ?? panic("set")
    compute.set(&b, [1, 0], 5.0) ?? panic("set")
    x :: solve.dense(pivot, b) ?? panic("dense")
    print("solve:{compute.to_list(x)}")

    factors :: solve.lu(pivot) ?? panic("lu")
    print("lu_pivots:{factors.pivots}")

    singular := compute.matrix(2, 2, 0.0) ?? panic("singular")
    compute.set(&singular, [0, 0], 1.0) ?? panic("set")
    compute.set(&singular, [0, 1], 2.0) ?? panic("set")
    compute.set(&singular, [1, 0], 2.0) ?? panic("set")
    compute.set(&singular, [1, 1], 4.0) ?? panic("set")
    if solve.dense(singular, b) == {
        .Ok(_) -> panic("singular accepted")
        .Err(_) -> print("singular:checked")
    }

    signal :: compute.from_list([1.0, 0.0, -1.0, 0.0]) ?? panic("signal")
    spectrum :: compute.fft(signal) ?? panic("fft")
    print("fft_len:{compute.numel(spectrum)}")
}
