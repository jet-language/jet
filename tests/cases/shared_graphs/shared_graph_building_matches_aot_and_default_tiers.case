# A strong list built by prepending, an appended cell and a strong-kid tree
# compile and run; a writing call on a cell's field updates the stored value.
fixture: shared_graph_building_matches_aot_and_default_tiers.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = shared_graph_building_matches_aot_and_default_tiers.stdout.expected
step: jet build --profile=debug main.jet
exit: 0
step aot: built
exit: 0
stdout: = shared_graph_building_matches_aot_and_default_tiers.stdout.expected
