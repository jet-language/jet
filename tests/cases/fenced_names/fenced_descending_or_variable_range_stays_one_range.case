# Inside an expression fence only an ascending
# integer-literal range expands. A range with a non-literal endpoint, in
# either direction, or a parenthesized one stays one ordinary Range value; a
# descending literal range reports only the E0170 the same range reports
# outside a fence, so the fence adds no diagnostic.
fixture: fenced_descending_or_variable_range_stays_one_range.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = fenced_descending_or_variable_range_stays_one_range.stdout.expected
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = fenced_descending_or_variable_range_stays_one_range.stdout.expected
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = fenced_descending_or_variable_range_stays_one_range.stdout.expected
stderr: empty
step fenced: jet check descending/main.jet
exit: 1 # a descending literal range holds no numbers (E0170)
stderr: = fenced_descending_or_variable_range_stays_one_range.stderr.expected # the one E0170, nothing from the fence
step plain: jet check plain/main.jet
exit: 1 # the same range outside a fence
stderr: = fenced_descending_or_variable_range_stays_one_range.plain.stderr.expected # the same E0170 at the same column
