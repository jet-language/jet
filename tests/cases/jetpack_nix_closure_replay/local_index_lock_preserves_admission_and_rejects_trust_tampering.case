requires: os-name:linux
fixture: local_index_lock_preserves_admission_and_rejects_trust_tampering.fixture
mkdir: root
mkdir: replay
mkdir: catalog
mkdir: replacement
mkdir: home/tmp
env: PATH=
env: HOME={work}/home
env: XDG_DATA_HOME={work}/home/data
env: XDG_STATE_HOME={work}/home/state
env: XDG_CACHE_HOME={work}/home/cache
env: XDG_CONFIG_HOME={work}/home/config
env: XDG_RUNTIME_DIR={work}/home/run
env: TMPDIR={work}/home/tmp
env: TMP={work}/home/tmp
env: TEMP={work}/home/tmp
env: JETPACK_SHARED_CAS={work}/root/hangar/cas
env: JETPACK_ROOT={work}/root
env: JETPACK_NIX_FALLBACK_POLICY=deny
step: jetpack env --env dev --prep --trust --no-color --yes --local-nix-catalog {work}/catalog
cwd: project
env-clear: true
exit: 0
copy: project/.jet/lock original.lock
# Original server stops network and selected project CAS bundle moves to saved-bundle (auth fixture seam).
rename: project/.jet/nix-cas/{cap:project_cas_bundle} project/saved-bundle
step: jetpack env --env dev --prep --trust --no-color --yes --local-nix-catalog {work}/replacement --offline
cwd: project
env-clear: true
exit: 0
file: project/.jet/lock == original.lock
