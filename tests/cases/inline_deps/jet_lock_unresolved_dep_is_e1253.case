# Port of tests/inline_deps.rs::jet_lock_unresolved_dep_is_e1253 (196-211), under D-JPK-SCRIPTDEP1=A:
# `jet fetch --offline --lock` never fetches, so an unknown inline dependency is
# E1253; without `--offline` it fetches from the configured registry, here an
# absent one (E1235). Neither writes a lock.
fixture: ghost.fixture
env: JET_STORE_DIR={work}/.jet-test-cache
step: jet fetch --offline --lock stats.jet
exit: nonzero
stderr: ~ E1253 # the code; tests/ui/inline_dep_unresolved owns the full report
file: stats.jet.lock absent
step: jet fetch --lock stats.jet
env: JET_REGISTRY_URL=file://{work}/absent.git
env: JET_REGISTRY_CACHE_DIR={work}/cache
exit: nonzero
stderr: ~ E1235 # the code; the unreachable-registry report text is covered by pkg/cli_publish_unreachable_registry_e1235
file: stats.jet.lock absent
