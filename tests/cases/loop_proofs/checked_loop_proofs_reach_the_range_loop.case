# #3039: sema's checked loop proof reaches the range loop it covers. `jet inspect
# decisions` prints one row per covered loop with its facts, its extent and how
# many fixed-list accesses drop their bounds check; every tier prints the same
# results, and an extent past the fixed length keeps the checked path.
fixture: checked_loop_proofs_reach_the_range_loop.fixture
env: NO_COLOR=1
step: jet inspect decisions main.jet
exit: 0
stdout: ~ "loop auto_loop main.jet:12 `i` below 8 of Float: aliasing-free true, no early exit true, effect-free true, independent true; lowered scalar, proven accesses 2, unchecked 2" # both accesses proven
stdout: ~ "loop project_fields main.jet:26 `i` below 4 of Float: aliasing-free true, no early exit true, effect-free true, independent true; lowered scalar, proven accesses 3, unchecked 3" # field projections of the element
stdout: ~ "loop sum_positive main.jet:33 `i` below 8 of Float: aliasing-free true, no early exit true, effect-free true, independent false; lowered scalar, proven accesses 2, unchecked 2" # a reduction is not independent
stdout: ~ "loop first_match main.jet:42 `i` below 8 of Int: aliasing-free true, no early exit false, effect-free true, independent false; lowered scalar, proven accesses 1, unchecked 1" # break is an early exit
stdout: ~ "loop growable main.jet:62 `i` below 3 of Int: aliasing-free true, no early exit true, effect-free false, independent false; lowered scalar, proven accesses 0, unchecked 0" # a growable list stays checked
stdout: ~ "loop past_end main.jet:69 `i` below 4 of Int: aliasing-free true, no early exit true, effect-free false, independent false; lowered scalar, proven accesses 1, unchecked 1" # inside the fixed length
stdout: ~ "loop past_end main.jet:70 `k` below 5 of Int: aliasing-free true, no early exit true, effect-free false, independent false; lowered scalar, proven accesses 0, unchecked 0" # past the fixed length
stdout: ~ "loop zero_trip main.jet:79 `i` below 0 of Int: aliasing-free true, no early exit true, effect-free false, independent false; lowered scalar, proven accesses 1, unchecked 1" # a zero-trip loop
stdout: ~ "loop unproven main.jet:86 `i` below 3 of Int: aliasing-free true, no early exit true, effect-free false, independent false; lowered scalar, proven accesses 0, unchecked 0" # offset index
stdout: !~ "loop scalar_loop" # #Scalar records no proof
stdout: !~ "loop first_index" # a loop that returns from inside has no proof
step: jet run -O0 main.jet
exit: 0
stdout: = checked_loop_proofs_reach_the_range_loop.out
step: jet run -O1 main.jet
exit: 0
stdout: = checked_loop_proofs_reach_the_range_loop.out
step: jet run -O2 main.jet
exit: 0
stdout: = checked_loop_proofs_reach_the_range_loop.out
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = checked_loop_proofs_reach_the_range_loop.out
step: jet run bad.jet
exit: 70
stdout: ~ "3" # the rounds before the bad index run
stderr: ~ "Stop [E3010]" # the kept bounds check stops the program
stderr: ~ "bad.jet:7" # at the access past the end
