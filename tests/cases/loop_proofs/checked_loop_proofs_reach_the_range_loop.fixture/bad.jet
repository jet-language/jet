// An extent past the fixed length keeps the bounds check, which stops the
// program at the first bad index after the earlier rounds' output.
fn past_end(values: [Int#4]) -> Int {
    total := 0
    loop i in 0..<5 {
        print(i)
        total += values[i]
    }
    return total
}

fn run() {
    print(past_end([Int#4]{1, 2, 3, 4}))
}
