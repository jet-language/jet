# A zero or negative sleep, or a sleep until a past instant, inside an elapsed
# `#Deadline(0ms)` still checks the task deadline: the wait stops with
# E3003 on every tier and names the sleep, since the stop polls before it
# take no deadline (moved from Core/Time/Time.jet; a deadline stop ends the
# task, so the program's exit is what observes it).
fixture: nonpositive_sleeps_check_the_task_deadline/input
step: jet run -O0 zero.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O1 zero.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O2 zero.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O0 negative.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O1 negative.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O2 negative.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.sleep.stderr
step: jet run -O0 until.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.until.stderr
step: jet run -O1 until.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.until.stderr
step: jet run -O2 until.jet
exit: 70
stdout: empty
stderr: = nonpositive_sleeps_check_the_task_deadline.until.stderr
