# A zero or negative sleep, or a sleep until a past instant, inside an elapsed
# `#Deadline(0ms)` still checks the task deadline: the wait stops with
# E3003 on every tier and names the sleep, since the stop polls before it
# take no deadline (moved from Core/Time/Time.jet; a deadline stop ends the
# task, so the program's exit is what observes it).
fixture: nonpositive_sleeps_check_the_task_deadline/input
step: jet run --optimize=none zero.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=basic zero.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=full zero.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=none negative.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=basic negative.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=full negative.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=none until.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=basic until.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
step: jet run --optimize=full until.jet
exit: 70
stdout: empty
stderr: has-line "Error [E3003]: `deadline exceeded while waiting in time sleep`."
