use time: core.time

// A copy of a tuple that holds a Manual clock forks that clock; the tuple's
// other fields copy as they always do.
run: fn() {
    pair: (clock: time.Clock.new(0), count: 1)
    copied := pair.copy()
    assert_eq(copied.clock.advance(3), 3)
    assert_eq(pair.clock.now(), 0)
    assert_eq(copied.count, 1)
    print("forked")
}
