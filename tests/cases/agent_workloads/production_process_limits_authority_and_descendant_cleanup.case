# HAND-PORT tests/agent_workloads.rs:2461-2544 production_process_limits_authority_and_descendant_cleanup
# PENDING-KIT; PENDING-GRAMMAR(batch-four); no runtime/reference proof.
# Original default/release policy matrix exact stdout and Linux gone-or-zombie descendant deadline2s/poll10ms; source bytes verbatim.
requires: os-name:linux
fixture: production_process_limits_authority_and_descendant_cleanup.fixture
env: NO_COLOR=1
step default: jet run process_policy.jet
limit: time=120
exit: 0
stdout: = production_process_limits_authority_and_descendant_cleanup.stdout.expected
capture: child = text file child.pid.trim
cap:child: is-u32
repeat while process {cap:child} alive-nonzombie timeout 2s every 10ms fail "timed-out process left descendant"
end repeat
remove: child.pid
step release: jet run --release process_policy.jet
limit: time=120
exit: 0
stdout: = production_process_limits_authority_and_descendant_cleanup.stdout.expected
capture: child = text file child.pid.trim
cap:child: is-u32
repeat while process {cap:child} alive-nonzombie timeout 2s every 10ms fail "timed-out process left descendant"
end repeat
remove: child.pid
