requires: os-name:linux
fixture: production_process_limits_authority_and_descendant_cleanup.fixture
env: NO_COLOR=1
step default: jet run process_policy.jet
limit: time=120
exit: 0
stdout: = production_process_limits_authority_and_descendant_cleanup.stdout.expected
capture: child = text file.trim child.pid
