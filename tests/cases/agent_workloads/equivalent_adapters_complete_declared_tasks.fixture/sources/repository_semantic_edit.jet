use {
    env: core.sys
    fs: core.files
    io: core.term
    process: core.process
    time: core.time
}

#CLI
WorkloadArgs: struct {
    input: String
}

run: fn(args: WorkloadArgs) {
    input: args.input
    jet: env.get("JET_CORPUS_JET") ?? panic("missing Jet CLI")
    // The copy goes outside this adapter's package: inside it, the copied
    // sources would be files of that package and share its namespace.
    scratch: fs.tmpdir("jet-semantic-edit-") ?? panic("cannot create scratch directory")
    project: "{scratch}/project"
    fs.copy_dir(input, project) ?? panic("cannot copy input project")
    object := "{project}/migration.codemod.json"
    result: process.cmd([String]{jet.copy(), "inspect", "codemod", "apply", object, "--yes"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(Duration.seconds(30) ?? panic("bad timeout"))
        .run() ?? panic("cannot run semantic codemod")
    if result.timed_out || result.code != 0 -> panic("codemod failed: {result.errors}")
    source: fs.read("{project}/project/examples/main.jet") ?? panic("cannot read edited source")
    print(source.trim())
    fs.remove_all(scratch) ?? panic("cannot clean edited project")
}
