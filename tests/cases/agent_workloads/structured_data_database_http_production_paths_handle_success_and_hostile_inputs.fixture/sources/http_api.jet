use {
    web: core.web
    fs: core.files
    json: core.encoding.json
    http_client: core.http.client
    http_server: core.http.server
    net: core.net
}

#Codable
Request: struct {
    name: String
    role: String
}

handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    request: req.json<Request>() ?? return Ok(http_server.response(400, "invalid-json"))
    if request.name == "" -> return Ok(http_server.response(422, "invalid-name"))
    return Ok(http_server.response(200, "accepted|{request.name}|{request.role}"))
}

#CLI
WorkloadArgs: struct {
    input: String
}

run: fn(args: WorkloadArgs) (HTTPError | IOError | NetError | TaskFailure)! {
    input: args.input
    body: fs.read(input) ?? panic("cannot read input")
    payload: json.decode<Request>(body) ?? panic("cannot parse input")
    listener: net.tcp_listen("127.0.0.1:0")
    address: listener.local_addr()
    mux: web.app()
    mux.post("/agent", fn(req: HTTPRequest) { handle(req) })
    t: task { mux.serve_once(listener) }
    request: http_client.request("POST", "http://{address}/agent")
        .json(payload)
    response: request.send()
    answer: response.text()
    print("{response.status()}|{answer}")
    t.join()
}
