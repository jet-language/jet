# #6606 c6: `jet env vars` with no --command lists every registered control
# variable, each with its flag, its `<command>.` setting key, its effective
# value and the source that set it, so the variables the environment sets
# show `environment` and the rest `default`. A URL's user and password never
# show: JET_KEEP_GOING_REPORT's `user:secret@` is listed as `***@`, in the
# text and in --json. Both forms are UI snapshots. The kit sets
# JET_OPT_VERIFY=1 for every case; the case sets it too, so it is listed.
env: NO_COLOR=1
env: JET_OPT_VERIFY=1
env: JET_PHASE_COUNTERS=1
env: JET_OPT_DISABLE=ssa,sink
env: JET_KEEP_GOING_REPORT=https://user:secret@example.com/report.tsv
step: jet env vars
exit: 0
stdout: = env_vars_lists_every_control_and_hides_a_url_password.text.out
stdout: !~ "secret" # the password never shows
step: jet env vars --json
exit: 0
stdout: = env_vars_lists_every_control_and_hides_a_url_password.json.out
stdout: !~ "secret" # nor in the JSON
