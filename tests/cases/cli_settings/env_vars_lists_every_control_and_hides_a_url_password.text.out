FLAG                 VARIABLE               SETTING                      VALUE                               SOURCE
--keep-going         JET_KEEP_GOING         <command>.keep_going         off                                 default
--keep-going-report  JET_KEEP_GOING_REPORT  <command>.keep_going_report  https://***@example.com/report.tsv  environment
--keep-going-skip    JET_KEEP_GOING_SKIP    <command>.keep_going_skip    -                                   default
--trace              JET_TRACE_FILE         <command>.trace              -                                   default
--trace-detail       JET_TRACE_DETAIL       <command>.trace_detail       -                                   default
--phase-counters     JET_PHASE_COUNTERS     <command>.phase_counters     on                                  environment
--opt-dump           JET_OPT_DUMP           <command>.opt_dump           -                                   default
--opt-disable        JET_OPT_DISABLE        <command>.opt_disable        ssa,sink                            environment
--opt-verify         JET_OPT_VERIFY         <command>.opt_verify         on                                  environment
--opt-ssa-stress     JET_OPT_SSA_STRESS     <command>.opt_ssa_stress     off                                 default
--gc-trace           JET_GC_TRACE           <command>.gc_trace           -                                   default
--memory-ledger      JET_MEMORY_LEDGER      <command>.memory_ledger      -                                   default
