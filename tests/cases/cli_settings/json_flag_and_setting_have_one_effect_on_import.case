# `jet import --json` and the user setting `import.json` have one effect:
# bare `jet import` in an empty directory prints the same stdout and stderr and
# exits the same with either.
fixture: json_flag_and_setting_have_one_effect_on_import.fixture
env: NO_COLOR=1
mkdir: p
step: jet import --json
cwd: {work}/p
exit: 2
capture: flag_out = text stdout
capture: flag_err = text stderr
write: flag.out = "{cap:flag_out}"
write: flag.err = "{cap:flag_err}"
mkdir: config/jet
copy: user.settings config/jet/settings.jet
step: jet import
cwd: {work}/p
env: XDG_CONFIG_HOME={work}/config
exit: 2 # the setting's exit is the flag's
capture: setting_out = text stdout
capture: setting_err = text stderr
write: setting.out = "{cap:setting_out}"
write: setting.err = "{cap:setting_err}"
file: setting.out == flag.out
file: setting.err == flag.err
