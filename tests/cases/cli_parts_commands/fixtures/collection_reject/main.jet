use fs: core.files

Row: struct {
    name: String
    count: Int
}

run: fn() {
    fs.write("/tmp/jet_1271.csv", "alpha,1\n") ?? panic("write failed")
    text: fs.read("/tmp/jet_1271.csv") ?? ""
    rows := [Row]{}
    loop line in text.split("\n") {
        parts: line.split(",")
        rows.push(Row{ name: parts.get(0), count: missing })
    }
    rows.sort_by(fn(row: Row) { row.name })
}
