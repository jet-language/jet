# bash completion for jet (generated by `jet self completions bash`)
_jet() {
local cur prev cmds flags
COMPREPLY=()
cur="${COMP_WORDS[COMP_CWORD]}"
cmds="registry inspect bind project self diff merge review run jobs check fill test test-compare prove status build cc c++ dev try debug crash repl import new fmt fix audit lint doc explain env cache remote trust image os add remove fetch search find update init split fold gc clean emit eval budget perf version help"
flags="--live --observe --log --structural --base-receipt --receipt --out --repo --json --topic --to --list-topics --kind --quiet --color --version --apply --preview --remove --path --route --model --check --lang --diff --simplify --changed --explicit-copies --skipped --stdin-path --output --locked --sha256 --effect --example --lock --host -p --annotated --force --no-sign --registry --pkg --before --advisory-db --vendor-dir --sbom --verbose --template --sort --online --fix --dry-run --keep --edition --all --markers --try-anyway --caps --watch --port --project --no-prepare -e --pure --allow --allow-all -A --deny --offline --fixtures --project-root --build-root -c -o -MMD -MD -MF -MT --sysroot -I -D -L -l -std -dumpmachine -print-sysroot -dumpversion -v --gate --target --up --sql --down --risk --no-color --env --preset --explain-partition --docs --filter --capture --update-snapshots --shuffle --serial --measure --trace-tiers --time-limit --opt-in --shard --list --cases --jobs --memory --allow-shrink --diagnostic-coverage --results --compiler --jetpack --where --grade --iterations --time --seed --corpus --browser-retries --browser-reporter --browser-ui --browser-visual --browser-trace --update --coverage --times --ast --ir --fn -u --release --profile --optimize -O0 -O1 -O2 --bounds --debug-info --small --inline --backtrace --dead-code --checked-alloc --write-generated --output-dir --libs --link-args --os --min-os --action-timeout --set --threads --trace --builder --a11y --complexity --max --scope --core --show-default --record --lens --facts --annotations --baseline --bootstrap --accept-regression --reason --yes -y --prelude --style"
if [[ "$cur" == -* ]]; then
COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
return 0
fi
    local job_names
job_names="$(jet --json jobs 2>/dev/null | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')"
cmds="$cmds $job_names"
    if [[ $COMP_CWORD -eq 1 ]]; then
COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
return 0
fi
if [[ $COMP_CWORD -eq 2 ]]; then
case "${COMP_WORDS[1]}" in
        registry) COMPREPLY=( $(compgen -W "publish yank keygen key vendor" -- "$cur") ); return 0 ;;
        inspect) COMPREPLY=( $(compgen -W "types rights claims shapes decisions structure build gates graph query explain-build compiler impact provenance digest env semindex output expand schema codemod audit bind logs info outdated reserved" -- "$cur") ); return 0 ;;
        project) COMPREPLY=( $(compgen -W "parts" -- "$cur") ); return 0 ;;
        self) COMPREPLY=( $(compgen -W "toolchain doctor completions man devtools lsp" -- "$cur") ); return 0 ;;
        env) COMPREPLY=( $(compgen -W "test hook sync info fetch-toolchain" -- "$cur") ); return 0 ;;
        cache) COMPREPLY=( $(compgen -W "status prune limit" -- "$cur") ); return 0 ;;
        os) COMPREPLY=( $(compgen -W "bridge services config" -- "$cur") ); return 0 ;;
        gc) COMPREPLY=( $(compgen -W "report" -- "$cur") ); return 0 ;;
        perf) COMPREPLY=( $(compgen -W "run test attach view compare export" -- "$cur") ); return 0 ;;
        esac
fi
COMPREPLY=( $(compgen -f -- "$cur") )
}
complete -F _jet jet
