// Setup for tests/polyglot_systems.rs:35-40: the absolute clang++ and ar the
// binder records, and the host triple `jet` builds for (env!("JET_BUILD_TARGET")),
// spelled as jet_cli_host_triple spells it. No assertions.
use {
    process :: core.process
    sys :: core.sys
    json :: core.encoding.json
    core.encoding.Dyn
}
fn host_triple(arch: String, os: String) -> String {
    known_arch :: arch == "x86_64" || arch == "aarch64"
    if os == "linux" && known_arch -> return "{arch}-unknown-linux-gnu"
    if os == "macos" && known_arch -> return "{arch}-apple-darwin"
    "{arch}-unknown-{os}"
}
fn run() {
    clang :: process.which("clang++") ?? panic("the C++ binder needs clang++")
    ar :: process.which("ar") ?? panic("the C++ binder needs ar")
    target :: host_triple(sys.arch(), sys.name())
    print("{{\"clang\":{json.to_string(Dyn.Text(clang))},\"ar\":{json.to_string(Dyn.Text(ar))},\"target\":{json.to_string(Dyn.Text(target))}}}")
}
