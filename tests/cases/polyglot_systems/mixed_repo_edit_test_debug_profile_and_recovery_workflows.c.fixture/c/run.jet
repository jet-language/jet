use {
    counter: "counter.h"
    c.pthread
}

foreign_work: fn() -> Int {
    return counter.mixed_c_threaded(41)
}

#Test("C host and worker-thread boundary") {
    assert_eq(counter.mixed_c_value(41), 42)
    assert_eq(counter.mixed_c_threaded(41), 42)
}

run: fn() {
    print(counter.mixed_c_value(41))
    task.group c_workers {
        worker: task foreign_work()
        print(worker.join() ?? panic("C worker failed"))
    }
}
