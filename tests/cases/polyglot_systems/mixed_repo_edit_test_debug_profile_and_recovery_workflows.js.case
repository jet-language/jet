append: js/ops.mjs "\n// stale binding source\n"
step: jet run run.jet
cwd: js
env: NO_COLOR=1
exit: nonzero
stdout+stderr: ~ "E3208" # original mixed_assert_failed_with helper422-428
copy: source.before js/ops.mjs
capture: before = text file js/.jet/bindings/js/ops.jet
capture: stale_descriptor = text file.replace_first("jet-ffi-descriptor=", "jet-ffi-descriptor=stale-") js/.jet/bindings/js/ops.jet
cap:stale_descriptor: != "{cap:before}" # original replacen changes the cached descriptor
write: js/.jet/bindings/js/ops.jet = "{cap:stale_descriptor}"
step: jet check run.jet
cwd: js
env: NO_COLOR=1
exit: nonzero
stdout+stderr: ~ "E3208" # original mixed_assert_failed_with helper422-428
step: jet inspect bind js ops.d.ts --runtime ops.mjs --pkg ops
cwd: js
env: NO_COLOR=1
exit: 0
