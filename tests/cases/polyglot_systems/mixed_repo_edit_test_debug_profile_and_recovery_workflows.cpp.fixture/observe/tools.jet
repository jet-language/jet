// SETUP-PORT of tests/polyglot_systems.rs:381-386/515-528/532-549: real tool discovery. A missing tool, or a
// JAVA_HOME without its embedded runtime (542-547, a path outside the case's work directory), is an error.
use {
    process: core.process
    files: core.files
    sys: core.sys
    json: core.encoding.json
    parse: core.text.parse
}
#Error
MissingTool: struct { name: String }
quoted: fn(text: String) -> String { json.to_string(text) ?? panic("JSON text quoting failed") }
run: fn() MissingTool! {
    names: [String]{"cc", "ar", "clang", "strip", "nm", "javac", "node", "python3"}
    fields := [String]{}
    javac := ""
    loop name in names {
        path: process.which(name) ?? return Err(MissingTool{name: name})
        if name == "javac" -> javac = path
        fields.push("{quoted(name)}:{quoted(path)}")
    }
    home: sys.get("JAVA_HOME") ?? files.dirname(files.dirname(javac))
    runtime: files.join(files.join(home, "lib/server"), if sys.name() == "macos" -> "libjvm.dylib" else -> "libjvm.so")
    if !files.is_file(runtime) -> return Err(MissingTool{name: runtime})
    strip_flag: if sys.name() == "macos" -> "-S" else -> "--strip-debug"
    fields.push("\"java_home\":{quoted(home)}")
    fields.push("\"libjvm\":{quoted(runtime)}")
    fields.push("\"strip_flag\":{quoted(strip_flag)}")
    print("{{{parse.join(fields, ",")}}}")
}
