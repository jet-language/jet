// D-STATE1: calling a typestate operation in the wrong state is E0150. Here
// `check_in` requires a `Confirmed` reservation, but `r` is still `Pending`
// (payment was skipped) — the order-of-events bug typestate prevents.
Reservation: struct {
    state { Pending, Confirmed, CheckedIn }
    guest: String
}

impl Reservation {
    #Transition(_, Pending) book: fn(guest: String) -[]> Reservation {
        return Reservation{guest: guest.copy()}
    }

    #Transition(Pending, Confirmed) pay: fn(self: &&Reservation) -[]> Reservation {
        return self
    }

    #Transition(Confirmed, CheckedIn) check_in: fn(self: &&Reservation) -[]> Reservation {
        return self
    }
}

run: fn() {
    r := Reservation.book("Ada")
    // BUG: skipped `pay()` — `r` is still `Pending`, not `Confirmed`.
    r = r.check_in()
}
