
use time: core.time

now: fn() -> Instant {
    return time.instant()
}

run: fn() {
    wait: 500ms
    origin: now()
    point: now() + 5min
    delta: point - origin
    speed: 12meter / 2s
    print(wait.in(.Milliseconds) ?? panic("wait"))
    print(delta.in(.Minutes) ?? panic("delta"))
    print(speed)
}
