package: { name: "run", authority: { allow: [Time] } }
use time: core.time

now: fn() -> Instant {
    return time.instant()
}

run: fn() {
    wait: 500ms
    origin: now()
    point: now() + 5min
    delta: point - origin
    speed: 12meter / 2s
    print(wait.in(.Milliseconds))
    print(delta.in(.Minutes))
    print(speed)
}
