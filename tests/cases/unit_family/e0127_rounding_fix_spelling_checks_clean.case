# #6281 c155: E0127's rounding fix offers a spelling that checks. The fix
# names the rounded conversion with `?? fallback`, never a bare `?` (which is
# itself E-ERR-PROPAGATE in a function that returns nothing), and the fix
# applied as written checks clean and runs.
fixture: e0127_rounding_fix_spelling_checks_clean.fixture
env: NO_COLOR=1
step refused: jet check refused/main.jet
exit: 1
stderr: ~ "This implicit unit conversion would round" # the implicit rounding is refused
stderr: ~ "--> main.jet:7:12" # located at the implicit `1meter + 1thirdish`
stderr: ~ "Fix: Write `Thirdish.from_meter_rounded(expr, .NearestEven, digits: 0) ?? fallback`" # the fix handles the Result
stderr: !~ "digits: 0)?" # no bare `?` spelling
stderr: ~ "jet-lang.dev/e/E0127" # one registered code
step applied: jet check applied/main.jet
exit: 0 # the applied fix checks clean
step run: jet run applied/main.jet
exit: 0
stdout: = "3 thirdish\n"
