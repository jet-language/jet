
#UnitFamily(Length, dimension, base: meter) {
    meter
    millimeter(scale: 1/1000)
}
fn takes_millimeter(value: Millimeter) { print(value) }
fn run() {
    coarse :: 3meter
    fine :: 42millimeter
    total :: coarse + fine
    takes_millimeter(3meter)
    binding :: Millimeter{ 4meter }
    print(total)
    print(binding)
}
