# #6281 c156: an anonymous derived quantity prints the unit its magnitude is
# in. Quantity arithmetic reads a Duration in seconds, so `12meter / 2s`
# prints `6 meter/s` (never `meter/ns`), `12meter / 500ms` prints
# `24 meter/s`, and a force spells its Time axis `s^2`, on O0, O1 and O2.
fixture: derived_quantity_label_names_seconds_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = derived_quantity_label_names_seconds_on_every_tier.out
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = derived_quantity_label_names_seconds_on_every_tier.out
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = derived_quantity_label_names_seconds_on_every_tier.out
stderr: empty
