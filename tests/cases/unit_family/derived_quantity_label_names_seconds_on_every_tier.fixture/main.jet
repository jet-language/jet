// An anonymous derived quantity's label names the unit its magnitude is in:
// quantity arithmetic reads a Duration in seconds, so the Time axis is `s`.
run: fn() {
    speed: 12meter / 2s
    print(speed)
    rate: 12meter / 500ms
    print(rate)
    force: 2kilogram * 12meter / 2s / 2s
    print(force)
}
