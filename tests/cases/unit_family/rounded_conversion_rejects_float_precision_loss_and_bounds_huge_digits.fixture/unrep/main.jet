
#UnitFamily(Length, dimension, base: meter) {
    meter
    big(scale: 9007199254740993)
    neg(scale: -9007199254740993)
}
fn show(value: Meter) { print(value.raw()) }
fn run() {
    show(Meter.from_big_rounded(Big.from_float(Float{1.0}), .NearestEven, digits: 0) ?? Meter.from_float(-Float{1.0}))
    show(Meter.from_neg_rounded(Neg.from_float(Float{1.0}), .NearestEven, digits: 0) ?? Meter.from_float(-Float{1.0}))
}
