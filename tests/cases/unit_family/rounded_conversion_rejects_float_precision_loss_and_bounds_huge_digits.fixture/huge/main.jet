
#UnitFamily(Length, dimension, base: meter) {
    meter
    same(scale: 1)
    third(scale: 1/3)
}
fn run() {
    print(Meter.from_same_rounded(Same.from_float(Float{0.5}), .TowardZero, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{0.5}), .TowardZero, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{5e-324}), .TowardZero, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{5e-324}), .TowardZero, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{1.7976931348623157e308}), .TowardZero, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_third_rounded(Third.from_float(Float{1.0}), .TowardZero, digits: 9223372036854775807) ?? Meter.from_float(-Float{1.0}))
    print(Meter.from_same_rounded(Same.from_float(Float{0.5}), .Floor, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{0.5}), .Floor, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{5e-324}), .Floor, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{5e-324}), .Floor, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{1.7976931348623157e308}), .Floor, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_third_rounded(Third.from_float(Float{1.0}), .Floor, digits: 9223372036854775807) ?? Meter.from_float(-Float{1.0}))
    print(Meter.from_same_rounded(Same.from_float(Float{0.5}), .Ceiling, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{0.5}), .Ceiling, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{5e-324}), .Ceiling, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{5e-324}), .Ceiling, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{1.7976931348623157e308}), .Ceiling, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_third_rounded(Third.from_float(Float{1.0}), .Ceiling, digits: 9223372036854775807) ?? Meter.from_float(-Float{1.0}))
    print(Meter.from_same_rounded(Same.from_float(Float{0.5}), .NearestEven, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{0.5}), .NearestEven, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{5e-324}), .NearestEven, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(-Float{5e-324}), .NearestEven, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_same_rounded(Same.from_float(Float{1.7976931348623157e308}), .NearestEven, digits: 9223372036854775807) ?? panic("same"))
    print(Meter.from_third_rounded(Third.from_float(Float{1.0}), .NearestEven, digits: 9223372036854775807) ?? Meter.from_float(-Float{1.0}))
    print(Meter.from_same_rounded(Same.from_float(Float{5e-324}), .NearestEven, digits: 1074) ?? panic("bounded"))
}
