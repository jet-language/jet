
#UnitFamily(Length, dimension, base: meter) {
    meter
    just_above(scale: )
    just_below(scale: -)
    halfway_above(scale: )
    halfway_below(scale: -)
}
fn show(value: Meter) { print(value.raw()) }
fn run() {
    show(Meter.from_just_above_rounded(JustAbove.from_float(Float{1.0}), .TowardZero, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_above_rounded(JustAbove.from_float(Float{1.0}), .Floor, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_above_rounded(JustAbove.from_float(Float{1.0}), .Ceiling, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_above_rounded(JustAbove.from_float(Float{1.0}), .NearestEven, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_below_rounded(JustBelow.from_float(-Float{1.0}), .TowardZero, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_below_rounded(JustBelow.from_float(-Float{1.0}), .Floor, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_below_rounded(JustBelow.from_float(-Float{1.0}), .Ceiling, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_just_below_rounded(JustBelow.from_float(-Float{1.0}), .NearestEven, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_above_rounded(HalfwayAbove.from_float(Float{1.0}), .TowardZero, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_above_rounded(HalfwayAbove.from_float(Float{1.0}), .Floor, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_above_rounded(HalfwayAbove.from_float(Float{1.0}), .Ceiling, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_above_rounded(HalfwayAbove.from_float(Float{1.0}), .NearestEven, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_below_rounded(HalfwayBelow.from_float(-Float{1.0}), .TowardZero, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_below_rounded(HalfwayBelow.from_float(-Float{1.0}), .Floor, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_below_rounded(HalfwayBelow.from_float(-Float{1.0}), .Ceiling, digits: 2000) ?? Meter.from_float(-Float{9.0}))
    show(Meter.from_halfway_below_rounded(HalfwayBelow.from_float(-Float{1.0}), .NearestEven, digits: 2000) ?? Meter.from_float(-Float{9.0}))
}
