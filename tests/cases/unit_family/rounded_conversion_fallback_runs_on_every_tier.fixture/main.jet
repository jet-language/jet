// D-QUANTITY-CONVERT1: a rounded conversion whose rounded decimal no Float
// holds exactly is a conversion error carried by its Result, so the program
// takes its fallback at run time; an exactly representable one returns it.
run: fn() {
    if Kilogram.from_dalton_rounded(1dalton, .NearestEven, digits: 30) == {
        .Ok(_) -> print("dalton: value")
        .Err(reason) -> print("dalton: fallback ({reason})")
    }
    angle: Radian.from_degree_rounded(180.0degree, .NearestEven, digits: 6) ?? 999radian
    print("degree: {angle}")
    length: Meter.from_centimeter_rounded(150centimeter, .NearestEven, digits: 1) ?? 999meter
    print("centimeter: {length}")
}
