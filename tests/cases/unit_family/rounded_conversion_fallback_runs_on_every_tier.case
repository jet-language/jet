# The run-time proof of D-QUANTITY-CONVERT1's rounded path. A
# rounded conversion whose rounded decimal no Float holds exactly is a
# conversion error carried by its Result, so both
# `Kilogram.from_dalton_rounded(1dalton, .NearestEven, digits: 30)` (measured)
# and `Radian.from_degree_rounded(180.0degree, .NearestEven, digits: 6)`
# (symbolic) take their fallback, and the exactly representable
# `Meter.from_centimeter_rounded(150centimeter, .NearestEven, digits: 1)`
# returns 1.5 meter, the same on O0, O1 and O2.
fixture: rounded_conversion_fallback_runs_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = rounded_conversion_fallback_runs_on_every_tier.out
stderr: empty
step o1: jet run -O1 main.jet
exit: 0
stdout: = rounded_conversion_fallback_runs_on_every_tier.out
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = rounded_conversion_fallback_runs_on_every_tier.out
stderr: empty
