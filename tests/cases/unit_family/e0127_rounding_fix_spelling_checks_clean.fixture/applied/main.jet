#UnitFamily(Length, base: meter) {
    meter
    thirdish(scale: 2/3)
}

// The E0127 fix applied as written: the rounded conversion's Result is
// handled with `?? fallback`, so a function that returns nothing checks.
run: fn() {
    total: (Thirdish.from_meter_rounded(1meter, .NearestEven, digits: 0) ?? 0thirdish) + 1thirdish
    print(total)
}
