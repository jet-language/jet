# core.ui.font draws the same bytes everywhere. main.jet paints three lines
# and a blended glyph from a budgeted cache onto a premultiplied ARGB8888
# canvas, and rasterizes every glyph of both built-in faces. It prints
# checksums of the pixels, the integer advances and the Float layout
# advances. O0, O1, O2 and the web build print the same.
fixture: font_draws_the_same_bytes_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = expected.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = expected.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = expected.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = expected.out
stderr: = ""
