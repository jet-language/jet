# core.ui.font on hostile files: main.jet builds a small valid TrueType font
# and damaged copies of it, one fault each (directory, head, maxp, hhea,
# hmtx, loca, simple and composite glyphs, cmap formats 4 and 12, GPOS pair
# formats 1 and 2, kern), and prints what loading each gives. Every damaged
# font gives a typed FontError naming its fault; none loads or stops.
fixture: font_hostile_inputs.fixture
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step aot: jet build main.jet
exit: 0
step native: built
exit: 0
stdout: = expected.out
step default: jet run main.jet
exit: == native
stdout: == native
stderr: == native
