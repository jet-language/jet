// Feeds core.ui.font a small valid TrueType font (an empty glyph, a square,
// a composite of the square, a cmap, a GPOS kern pair) and damaged copies of
// it, one fault each, and prints what loading each gives: the glyph count
// and the kerned advance of "AB", or the typed error. Every damaged font
// must give a FontError naming its fault; none may load or fault.
use {
    font: core.ui.font
}

Table: struct {
    name: String
    body: [U8]
}

// Big-endian `width`-byte fields; negative values wrap as two's complement.
put_field: fn(&out: [U8], value: Int, width: Int) {
    wrapped: value % (1 << (width * 8))
    loop k in 0..<width -> out.push(U8{(wrapped >> ((width - 1 - k) * 8)).bit_and(255)})
}

fields: fn(values: [Int], width: Int) -> [U8] {
    out := [U8]{}
    loop v in values -> put_field(out, v, width)
    out
}

bytes: fn(values: [Int]) -> [U8] { fields(values, 1) }
words: fn(values: [Int]) -> [U8] { fields(values, 2) }
longs: fn(values: [Int]) -> [U8] { fields(values, 4) }

join: fn(parts: [[U8]]) -> [U8] {
    out := [U8]{}
    loop part in parts {
        loop byte in part -> out.push(byte)
    }
    out
}

zeros: fn(count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> out.push(U8{0})
    out
}

// `body` with the big-endian `width`-byte field at `at` set to `value`.
patch: fn(body: [U8], at: Int, value: Int, width: Int) -> [U8] {
    out := body.copy()
    field: fields([Int]{value}, width)
    loop k in 0..<width -> out[at + k] = field[k]
    out
}

// ---- the valid font ---------------------------------------------------------

// A 100-unit square: one contour of four on-curve points, coordinates as
// words.
square: fn() -> [U8] {
    join([[U8]]{
        words([Int]{1, 0, 0, 100, 100, 3, 0}), bytes([Int]{1, 1, 1, 1}),
        words([Int]{0, 0, 100, 0}), words([Int]{0, 100, 0, -100}),
    })
}

// A composite glyph header, then `components`.
composite: fn(components: [U8]) -> [U8] {
    join([[U8]]{words([Int]{-1, 0, 0, 110, 120}), components})
}

// One component: `flags`, glyph `child`, byte arguments `arg1` and `arg2`.
component: fn(flags: Int, child: Int, arg1: Int, arg2: Int) -> [U8] {
    join([[U8]]{words([Int]{flags, child}), bytes([Int]{arg1, arg2})})
}

// Flag 2: the arguments are an x, y offset.
moved_square: fn() -> [U8] {
    composite(component(2, 1, 10, 20))
}

head: fn(units: Int, loca_format: Int) -> [U8] {
    patch(patch(zeros(54), 18, units, 2), 50, loca_format, 2)
}

maxp: fn(glyphs: Int) -> [U8] {
    words([Int]{0, 20480, glyphs})
}

hhea: fn(metrics: Int) -> [U8] {
    patch(patch(patch(zeros(36), 4, 800, 2), 6, -200, 2), 34, metrics, 2)
}

hmtx: fn() -> [U8] {
    words([Int]{500, 0, 600, 0, 700, 10})
}

// Long loca for glyphs with these bodies, laid end to end.
loca_for: fn(glyphs: [[U8]]) -> [U8] {
    offsets := [Int]{0}
    total := 0
    loop g in glyphs {
        total += g.len()
        offsets.push(total)
    }
    longs(offsets)
}

// The glyphs: none, the 34-byte square, the 16-byte composite.
glyphs: fn() -> [[U8]] {
    [[U8]]{[U8]{}, square(), moved_square()}
}

// cmap with one subtable (`platform`, `encoding`) in format 12 holding
// (first, last, glyph) triples.
cmap12: fn(platform: Int, encoding: Int, groups: [Int]) -> [U8] {
    count: groups.len() /% 3
    join([[U8]]{
        words([Int]{0, 1, platform, encoding}), longs([Int]{12}),
        words([Int]{12, 0}), longs([Int]{16 + count * 12, 0, count}), longs(groups),
    })
}

// cmap with one Windows BMP subtable in format 4: segments end..start
// mapped by `deltas`, with no glyph id array.
cmap4: fn(ends: [Int], starts: [Int], deltas: [Int]) -> [U8] {
    count: ends.len()
    offsets := [Int]{}
    loop _ in 0..<count -> offsets.push(0)
    join([[U8]]{
        words([Int]{0, 1, 3, 1}), longs([Int]{12}),
        words([Int]{4, 16 + count * 8, 0, count * 2, 0, 0, 0}),
        words(ends), words([Int]{0}), words(starts), words(deltas), words(offsets),
    })
}

// "A" is glyph 1 and "B" glyph 2.
valid_cmap: fn() -> [U8] {
    cmap12(3, 10, [Int]{65, 66, 1})
}

// GPOS: script latn, its default language naming feature `feature_index`;
// feature 0 is kern with lookup `lookup_index`; lookup 0 is one pair
// adjustment subtable `subtable` (type 2).
gpos: fn(feature_index: Int, lookup_index: Int, subtable: [U8]) -> [U8] {
    join([[U8]]{
        words([Int]{1, 0, 10, 30, 44}),
        words([Int]{1}), "latn".bytes().copy(), words([Int]{8}),
        words([Int]{4, 0}),
        words([Int]{0, 65535, 1, feature_index}),
        words([Int]{1}), "kern".bytes().copy(), words([Int]{8}),
        words([Int]{0, 1, lookup_index}),
        words([Int]{1, 4}),
        words([Int]{2, 0, 1, 8}),
        subtable,
    })
}

// Pair format 1: glyph 1 then glyph 2 closes up by 50 units (x advance).
// `seconds` are the pair set's second glyphs; `coverage_format` is 1.
pair_format1: fn(format: Int, seconds: [Int], coverage_format: Int) -> [U8] {
    set := words([Int]{seconds.len()})
    loop second in seconds -> set = join([[U8]]{set, words([Int]{second, -50})})
    join([[U8]]{
        words([Int]{format, 12 + set.len(), 4, 0, 1, 12}),
        set,
        words([Int]{coverage_format, 1, 1}),
    })
}

// Pair format 2: class 1 of glyph 1 then class 1 of glyph 2 closes up by
// 50; the first class definition has `class_format` and gives glyph 1 class
// `first_class`.
pair_format2: fn(class_format: Int, first_class: Int) -> [U8] {
    join([[U8]]{
        words([Int]{2, 44, 4, 0, 24, 34, 2, 2}),
        words([Int]{0, 0, 0, -50}),
        words([Int]{class_format, 1, 1, 1, first_class}),
        words([Int]{2, 1, 2, 2, 1}),
        words([Int]{1, 1, 1}),
    })
}

valid_gpos: fn() -> [U8] {
    gpos(0, 0, pair_format1(1, [Int]{2}, 1))
}

base: fn() -> [Table] {
    [Table]{
        Table{name: "cmap", body: valid_cmap()},
        Table{name: "glyf", body: join(glyphs())},
        Table{name: "head", body: head(1000, 1)},
        Table{name: "hhea", body: hhea(3)},
        Table{name: "hmtx", body: hmtx()},
        Table{name: "loca", body: loca_for(glyphs())},
        Table{name: "maxp", body: maxp(3)},
        Table{name: "GPOS", body: valid_gpos()},
    }
}

// The font file for `tables`: an sfnt directory, then each body.
build: fn(tables: [Table]) -> [U8] {
    out := [U8]{}
    put_field(out, 65536, 4)
    put_field(out, tables.len(), 2)
    loop _ in 0..<6 -> out.push(U8{0})
    offset := 12 + tables.len() * 16
    loop t in tables {
        loop byte in t.name.bytes() -> out.push(byte)
        put_field(out, 0, 4)
        put_field(out, offset, 4)
        put_field(out, t.body.len(), 4)
        offset += t.body.len()
    }
    loop t in tables {
        loop byte in t.body -> out.push(byte)
    }
    out
}

// `tables` with table `name`'s body replaced.
with: fn(tables: [Table], name: String, body: [U8]) -> [Table] {
    out := [Table]{}
    loop t in tables {
        out.push(Table{name: t.name.copy(), body: if t.name == name -> body.copy() else -> t.body.copy()})
    }
    out
}

// `tables` with table `name` called `renamed`.
rename: fn(tables: [Table], name: String, renamed: String) -> [Table] {
    out := [Table]{}
    loop t in tables {
        out.push(Table{name: if t.name == name -> renamed.copy() else -> t.name.copy(), body: t.body.copy()})
    }
    out
}

// The valid font with glyph 2 (the composite) replaced by `glyph`.
with_glyph: fn(glyph: [U8]) -> [Table] {
    glyphs: [[U8]]{[U8]{}, square(), glyph}
    with(with(base(), "glyf", join(glyphs)), "loca", loca_for(glyphs))
}

// The valid font without GPOS (renamed to a tag nothing reads) and with a
// kern table `kern`.
with_kern: fn(kern: [U8]) -> [Table] {
    out := rename(base(), "GPOS", "GPOX")
    out.push(Table{name: "kern", body: kern})
    out
}

// ---- running ----------------------------------------------------------------

report: fn(name: String, file: [U8]) {
    if font.face(file) == {
        .Ok(face) -> {
            run: face.layout("AB", 1000.0)
            print("{name}: loads, {face.glyph_count()} glyphs, AB advances {run.advance}")
        }
        .Err(error) -> print("{name}: FontError: {error.reason}")
    }
}

// How `face` wraps three kerned "AB" words (1250 px each at 1000 px, a
// space 500 px) into 1300 px: one word per line, the spaces on no line.
wraps: fn(face: font.Face) -> String {
    parts := [String]{}
    loop line in face.wrap("AB AB AB", 1000.0, 1300.0) -> parts.push("{line.start}..{line.end} {line.width}")
    parts.join(", ")
}

run: fn() {
    good: build(base())
    report("valid", good)
    print("valid wraps: {wraps(font.face(good) ?? panic("the valid font does not load"))}")
    print("built-in license: {font.license().split("\n").to_list()[0]}")
    report("without GPOS", build(rename(base(), "GPOS", "GPOX")))

    // The file and its directory.
    report("shorter than a header", good[0..<8].copy())
    report("CFF outlines", patch(good, 0, 0x4F54544F, 4))
    report("a font collection", patch(good, 0, 0x74746366, 4))
    report("an unknown sfnt version", patch(good, 0, 0x12345678, 4))
    report("a directory past the end", patch(good, 4, 4000, 2))
    report("a table past the end", patch(good, 12 + 12, 0x7FFFFFFF, 4))
    report("no head table", build(rename(base(), "head", "hexd")))
    report("no glyf table", build(rename(base(), "glyf", "glyx")))
    report("CFF instead of glyf", build(rename(base(), "glyf", "CFF ")))
    report("no cmap table", build(rename(base(), "cmap", "cmaq")))

    // head, maxp, hhea, hmtx, loca.
    report("a short head", build(with(base(), "head", zeros(20))))
    report("units per em 0", build(with(base(), "head", head(0, 1))))
    report("index-to-loc format 2", build(with(base(), "head", head(1000, 2))))
    report("no glyphs", build(with(base(), "maxp", maxp(0))))
    report("more metrics than glyphs", build(with(base(), "hhea", hhea(9))))
    report("no metrics", build(with(base(), "hhea", hhea(0))))
    report("a short hmtx", build(with(base(), "hmtx", words([Int]{500, 0}))))
    report("a short loca", build(with(base(), "loca", longs([Int]{0, 0}))))
    report("loca past glyf", build(with(base(), "loca", longs([Int]{0, 0, 34, 9000}))))
    report("loca running backwards", build(with(base(), "loca", longs([Int]{0, 0, 34, 0}))))

    // Simple glyphs.
    report("a glyph shorter than its header", build(with_glyph(words([Int]{1, 0, 0}))))
    report("contour ends out of order", build(with_glyph(join([[U8]]{words([Int]{2, 0, 0, 100, 100, 3, 2, 0}), bytes([Int]{1, 1, 1, 1}), zeros(16)}))))
    report("contour ends past the glyph", build(with_glyph(words([Int]{40, 0, 0, 100, 100, 3}))))
    report("flags past the glyph", build(with_glyph(words([Int]{1, 0, 0, 100, 100, 3, 0}))))
    report("a flag repeated past the points", build(with_glyph(join([[U8]]{words([Int]{1, 0, 0, 100, 100, 3, 0}), bytes([Int]{9, 10}), zeros(16)}))))
    report("x coordinates past the glyph", build(with_glyph(join([[U8]]{words([Int]{1, 0, 0, 100, 100, 3, 0}), bytes([Int]{1, 1, 1, 1}), words([Int]{0, 0})}))))
    report("y coordinates past the glyph", build(with_glyph(join([[U8]]{words([Int]{1, 0, 0, 100, 100, 3, 0}), bytes([Int]{1, 1, 1, 1}), words([Int]{0, 0, 100, 0, 0})}))))
    report("too many points", build(with_glyph(words([Int]{1, 0, 0, 100, 100, 65535, 0}))))

    // Composite glyphs.
    report("a component outside the font", build(with_glyph(composite(component(2, 7, 0, 0)))))
    report("a component that is itself", build(with_glyph(composite(component(2, 2, 0, 0)))))
    report("component arguments past the glyph", build(with_glyph(composite(words([Int]{2, 1})))))
    report("a component scale past the glyph", build(with_glyph(composite(component(2 + 8, 1, 0, 0)))))
    report("components past the glyph", build(with_glyph(composite(component(2 + 32, 1, 0, 0)))))
    report("matched points the glyphs lack", build(with_glyph(composite(join([[U8]]{component(2 + 32, 1, 0, 0), component(0, 1, 9, 0)})))))
    many := [U8]{}
    loop _ in 0..<16384 {
        loop byte in component(2 + 32, 1, 0, 0) -> many.push(byte)
    }
    report("components with too many points", build(with_glyph(composite(join([[U8]]{many, component(2, 1, 0, 0)})))))

    // cmap.
    report("no Unicode subtable", build(with(base(), "cmap", cmap12(1, 0, [Int]{65, 66, 1}))))
    report("format 12 groups out of order", build(with(base(), "cmap", cmap12(3, 10, [Int]{66, 66, 2, 65, 65, 1}))))
    report("a format 12 group running backwards", build(with(base(), "cmap", cmap12(3, 10, [Int]{66, 65, 1}))))
    report("format 12 groups past the end", build(with(base(), "cmap", patch(valid_cmap(), 24, 1000000, 4))))
    report("format 4 segments out of order", build(with(base(), "cmap", cmap4([Int]{66, 65, 65535}, [Int]{66, 65, 65535}, [Int]{-64, -64, 1}))))
    report("format 4 with no segments", build(with(base(), "cmap", cmap4([Int]{}, [Int]{}, [Int]{}))))
    report("valid format 4", build(with(base(), "cmap", cmap4([Int]{66, 65535}, [Int]{65, 65535}, [Int]{-64, 1}))))

    // GPOS.
    report("a short GPOS", build(with(base(), "GPOS", words([Int]{1, 0}))))
    report("a GPOS language naming a missing feature", build(with(base(), "GPOS", gpos(5, 0, pair_format1(1, [Int]{2}, 1)))))
    report("a kern feature naming a missing lookup", build(with(base(), "GPOS", gpos(0, 4, pair_format1(1, [Int]{2}, 1)))))
    report("pair format 3", build(with(base(), "GPOS", gpos(0, 0, pair_format1(3, [Int]{2}, 1)))))
    report("coverage format 3", build(with(base(), "GPOS", gpos(0, 0, pair_format1(1, [Int]{2}, 3)))))
    report("a pair set out of order", build(with(base(), "GPOS", gpos(0, 0, pair_format1(1, [Int]{2, 1}, 1)))))
    report("valid pair format 2", build(with(base(), "GPOS", gpos(0, 0, pair_format2(2, 1)))))
    report("class format 3", build(with(base(), "GPOS", gpos(0, 0, pair_format2(3, 1)))))
    report("a class past the class count", build(with(base(), "GPOS", gpos(0, 0, pair_format2(2, 5)))))

    // kern, read when GPOS is absent: glyph 1 then 2 closes up by 50.
    report("valid kern", build(with_kern(words([Int]{0, 1, 0, 20, 1, 1, 6, 0, 0, 1, 2, -50}))))
    report("a kern subtable under 6 bytes", build(with_kern(words([Int]{0, 1, 0, 4, 1}))))
    report("kern pairs past the end", build(with_kern(words([Int]{0, 1, 0, 20, 1, 900, 6, 0, 0, 1, 2, -50}))))
    report("a short kern", build(with_kern(words([Int]{0}))))
}
