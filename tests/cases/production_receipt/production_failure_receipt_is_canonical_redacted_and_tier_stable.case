# tests/production_receipt.rs::production_failure_receipt_is_canonical_redacted_and_tier_stable
# Every original mode/code/receipt field/redaction/byte-identity assertion; no captured oracle.
fixture: production_failure_receipt_is_canonical_redacted_and_tier_stable.fixture
env: JET_PRODUCTION_USER_DATA=PRODUCTION_RECEIPT_ENV_MARKER_755
step tier0: jet run --interpret main.jet -- PRODUCTION_RECEIPT_INPUT_MARKER_755
cwd: tier-0
env: JET_STORE_DIR={work}/tier-0/cache
exit: 70
capture: report_tier0 = first-entry {work}/tier-0/.jet/reports child-is-file "receipt"
file: {cap:report_tier0}/receipt ^= "jet-development-receipt-v1\n" # original ed77c235f tests/production_receipt.rs:73 starts_with receipt header
file: {cap:report_tier0}/receipt ~ "closure\t\t" # original ed77c235f tests/production_receipt.rs:74 contains closure
file: {cap:report_tier0}/receipt ~ "input\t" # original ed77c235f tests/production_receipt.rs:75 contains input
