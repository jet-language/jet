file: {cap:report_tier0}/receipt ~ "failure-path\t66696c65\t6d61696e2e6a6574" # original ed77c235f tests/production_receipt.rs:77-81 contains hex file main.jet
file: {cap:report_tier0}/receipt ~ "failure-path\t6c696e65\t32" # original ed77c235f tests/production_receipt.rs:82 contains hex line 2
file: {cap:report_tier0}/receipt ~ "failure-path\t66756e6374696f6e\t72756e" # original ed77c235f tests/production_receipt.rs:83-87 contains hex function run
file: {cap:report_tier0}/receipt !~ "PRODUCTION_RECEIPT_SOURCE_MARKER_755" # original ed77c235f tests/production_receipt.rs:41,88-89 excludes source secret
file: {cap:report_tier0}/receipt !~ "PRODUCTION_RECEIPT_INPUT_MARKER_755" # original ed77c235f tests/production_receipt.rs:42,88-89 excludes input secret
file: {cap:report_tier0}/receipt !~ "PRODUCTION_RECEIPT_ENV_MARKER_755" # original ed77c235f tests/production_receipt.rs:43,88-89 excludes environment secret
copy: {cap:report_tier0}/receipt baseline.receipt
