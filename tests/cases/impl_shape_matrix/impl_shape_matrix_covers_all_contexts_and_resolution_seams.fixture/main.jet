// Every sema-admitted Display/Debug owner shape exercises the
// same interpolation contexts on the default, release, and interpreter tiers.
#[Printable, Debug]
AutoOwner: struct {
    value: Int
}

#[Printable, Debug]
DisplayOnlyOwner: struct {
    value: Int

    impl Display {
        display: fn(self) -> String { "display-only" }
    }
}

#[Printable, Debug]
DebugOnlyOwner: struct {
    value: Int

    impl Debug {
        debug: fn(self) -> String { "debug-only" }
    }
}

#[Printable, Debug]
DisplayDebugOwner: struct {
    value: Int

    impl Display {
        display: fn(self) -> String { "display-debug-display" }
    }

    impl Debug {
        debug: fn(self) -> String { "display-debug-debug" }
    }
}

#[Printable, Debug, Equatable]
EquatableOwner: struct {
    value: Int

    impl Display {
        display: fn(self) -> String { "equatable-display" }
    }
}

#[Printable, Debug]
GenericOwner: struct<T: Printable> {
    value: T

    impl Display {
        display: fn(self) -> String { "generic-display" }
    }

    impl Debug {
        debug: fn(self) -> String { "generic-debug" }
    }
}

#[Printable, Debug]
EnumOwner: enum {
    Ready

    impl Display {
        display: fn(self) -> String { "enum-display" }
    }

    impl Debug {
        debug: fn(self) -> String { "enum-debug" }
    }
}

#[Printable, Debug]
UnitOwner: struct {


    impl Display {
        display: fn(self) -> String { "unit-display" }
    }

    impl Debug {
        debug: fn(self) -> String { "unit-debug" }
    }
}

#Printable
DistinctOwner: distinct Int

run: fn() {
    auto: AutoOwner{value: 1}
    display_only: DisplayOnlyOwner{value: 2}
    debug_only: DebugOnlyOwner{value: 3}
    display_debug: DisplayDebugOwner{value: 4}
    equatable: EquatableOwner{value: 5}
    generic: GenericOwner<DisplayDebugOwner>{value: display_debug.copy()}
    enum_value: EnumOwner.Ready
    unit: UnitOwner{}
    distinct: DistinctOwner.from_int(9)

    print("auto/bare={auto}")
    print("auto/debug={auto:Debug}")
    print("auto/pretty={auto:Pretty}")
    print(auto.copy())
    auto_list: [AutoOwner]{auto.copy()}
    auto_map: [String:AutoOwner]{"k": auto.copy()}
    auto_tuple: (value: auto.copy(), tag: "tuple")
    print("auto/nested={auto_list:Debug}|{auto_map:Debug}|{auto_tuple:Debug}")

    print("display-only/bare={display_only}")
    print("display-only/debug={display_only:Debug}")
    print("display-only/pretty={display_only:Pretty}")
    print(display_only.copy())
    display_only_list: [DisplayOnlyOwner]{display_only.copy()}
    display_only_map: [String:DisplayOnlyOwner]{"k": display_only.copy()}
    display_only_tuple: (value: display_only.copy(), tag: "tuple")
    print("display-only/nested={display_only_list}|{display_only_map}|{display_only_tuple}")

    print("debug-only/bare={debug_only}")
    print("debug-only/debug={debug_only:Debug}")
    print("debug-only/pretty={debug_only:Pretty}")
    print(debug_only.copy())
    debug_only_list: [DebugOnlyOwner]{debug_only.copy()}
    debug_only_map: [String:DebugOnlyOwner]{"k": debug_only.copy()}
    debug_only_tuple: (value: debug_only.copy(), tag: "tuple")
    print("debug-only/nested={debug_only_list:Debug}|{debug_only_map:Debug}|{debug_only_tuple:Debug}")

    print("display-debug/bare={display_debug}")
    print("display-debug/debug={display_debug:Debug}")
    print("display-debug/pretty={display_debug:Pretty}")
    print(display_debug.copy())
    display_debug_list: [DisplayDebugOwner]{display_debug.copy()}
    display_debug_map: [String:DisplayDebugOwner]{"k": display_debug.copy()}
    display_debug_tuple: (value: display_debug.copy(), tag: "tuple")
    print("display-debug/nested={display_debug_list}|{display_debug_map}|{display_debug_tuple}")

    print("equatable/bare={equatable}")
    print("equatable/debug={equatable:Debug}")
    print("equatable/pretty={equatable:Pretty}")
    print(equatable.copy())
    equatable_list: [EquatableOwner]{equatable.copy()}
    equatable_map: [String:EquatableOwner]{"k": equatable.copy()}
    equatable_tuple: (value: equatable.copy(), tag: "tuple")
    print("equatable/nested={equatable_list}|{equatable_map}|{equatable_tuple}")

    print("generic/bare={generic}")
    print("generic/debug={generic:Debug}")
    print("generic/pretty={generic:Pretty}")
    print(generic.copy())
    generic_list: [GenericOwner<DisplayDebugOwner>]{generic.copy()}
    generic_map: [String:GenericOwner<DisplayDebugOwner>]{"k": generic.copy()}
    generic_tuple: (value: generic.copy(), tag: "tuple")
    print("generic/nested={generic_list}|{generic_map}|{generic_tuple}")

    print("enum/bare={enum_value}")
    print("enum/debug={enum_value:Debug}")
    print("enum/pretty={enum_value:Pretty}")
    print(enum_value.copy())
    enum_list: [EnumOwner]{enum_value.copy()}
    enum_map := [String:EnumOwner]{}
    enum_map["k"] = enum_value.copy()
    enum_tuple: (value: enum_value.copy(), tag: "tuple")
    print("enum/nested={enum_list}|{enum_map}|{enum_tuple}")

    print("unit/bare={unit}")
    print("unit/debug={unit:Debug}")
    print("unit/pretty={unit:Pretty}")
    print(unit.copy())
    unit_list: [UnitOwner]{unit.copy()}
    unit_map: [String:UnitOwner]{"k": unit.copy()}
    unit_tuple: (value: unit.copy(), tag: "tuple")
    print("unit/nested={unit_list}|{unit_map}|{unit_tuple}")

    print("distinct/bare={distinct}")
    print("distinct/debug={distinct.raw():Debug}")
    print("distinct/pretty={distinct.raw():Pretty}")
    print(distinct.copy())
    distinct_list: [DistinctOwner]{distinct.copy()}
    distinct_map: [String:Int]{"k": distinct.raw()}
    distinct_tuple: (value: distinct.raw(), tag: "tuple")
    print("distinct/nested={distinct_list}|{distinct_map}|{distinct_tuple}")
}
