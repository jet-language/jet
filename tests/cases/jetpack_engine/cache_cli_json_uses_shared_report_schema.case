# HAND-PORT tests/jetpack_engine.rs:583-679 cache_cli_json_uses_shared_report_schema
# --json prints one status object { schema: "jet.status/v1", action, ok, reports }
# whose reports hold the report objects (Docs/spec/syntax-decisions.md:10020).
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: mirror
step: jetpack hangar cache bind public {work}/mirror --yes --json --no-color
exit: 0
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.ok = true
json: stdout doc $.action = "cache-bind"
json: stdout doc $.role = "public"
step list: jetpack hangar cache list --json --no-color
exit: 0
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "cache-list"
stdout: ~ "\"bindings\":[" # original contains predicate
step repeat: jetpack hangar cache list --json --no-color
exit: any # Original repeated call asserted stdout only, not exit.
stdout: == list
step: jetpack hangar cache verify missing --json --no-color
exit: 2
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.reports[0].code = "E1340"
step: jetpack hangar cache remove public --yes --json --no-color
exit: 0
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "cache-remove"

