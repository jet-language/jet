# HAND-PORT tests/jetpack_engine.rs:5594-5635 automatic_channel_refresh_moves_again_after_manifest_writeback
# D-CHANNEL-AUTO2=A: each automatic refresh moves only the lock. env.jet stays byte for byte as written when the lock changes and when it does not.
# `--trust`: the typed env.dev needs a trust decision and these steps are non-interactive.
fixture: automatic_channel_refresh_moves_the_lock_again_and_leaves_env_jet_unchanged.fixture
env: JETPACK_ROOT={work}/root
mkdir: root
copy: project/env.jet env.before
step: jetpack env --prep --no-color --yes --trust --fixtures {work}/fixtures
cwd: project
exit: 0
file: project/.jet/lock ~ "exact = \"nixpkgs:omp#1.2.3\"" # the first refresh locks 1.2.3
file: project/env.jet == env.before
write: fixtures/channels.txt new-channel.template
step: jetpack env --prep --no-color --yes --trust --fixtures {work}/fixtures
cwd: project
exit: 0
file: project/.jet/lock ~ "exact = \"nixpkgs:omp#1.2.4\"" # the channel moved, so the lock moves to 1.2.4
file: project/env.jet == env.before
copy: project/.jet/lock lock.before
step: jetpack env --prep --no-color --yes --trust --fixtures {work}/fixtures
cwd: project
exit: 0
file: project/.jet/lock == lock.before
file: project/env.jet == env.before
