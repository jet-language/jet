env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: fixtures
env: JETPACK_FIXTURES={work}/fixtures
step: jetpack build fastfetch@nixpkgs --no-color --offline
cwd: project
env: PATH=
exit: 0
stderr: ~ "fastfetch" # original contains predicate
stderr: ~ "substituted" # original contains predicate
