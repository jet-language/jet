env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: fixtures
env: JETPACK_FIXTURES={work}/fixtures
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- omp
cwd: project
exit: nonzero
stderr: ~ "Error [E1315]:" # original contains predicate
stderr: ~ "32-byte file" # original contains predicate
stdout: !~ "hello from jetpack" # original negative contains predicate
when dir-readable root/leases: entries: root/leases = 0

