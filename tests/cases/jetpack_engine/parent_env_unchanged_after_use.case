env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: fixtures
env: JETPACK_FIXTURES={work}/fixtures
step: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- sh -c "printf %s \"$PATH\""
cwd: project
exit: 0

