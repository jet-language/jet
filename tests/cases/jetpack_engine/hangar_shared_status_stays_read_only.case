# HAND-PORT tests/jetpack_engine.rs:706-716 hangar_shared_status_stays_read_only and
# tests/jetpack_dispatch.rs:59-100: status reports an absent broker without installing one
# and without migrating the per-user Hangar state.
fixture: hangar_shared_status_stays_read_only.fixture
env: NO_COLOR=1
mkdir: home
mkdir: data
env: HOME={work}/home
env: XDG_DATA_HOME={work}/data
env: XDG_STATE_HOME={work}/xdg-state
step: jetpack hangar shared status --no-color
unset: JETPACK_ROOT
exit: 0
stderr: ~ "shared-store broker is not installed." # original contains predicate
stderr: !~ "Error [jet.JetpackCommandFailed]" # original absent predicate
stderr: !~ "shared-store install failed" # original absent predicate
stderr: !~ "sudo" # original absent predicate
stderr: !~ "jetpack hangar shared install" # original absent predicate
file: xdg-state/jet/hangar/marker is-file
file: data/jet/hangar absent
file: data/jet/shared-store absent
