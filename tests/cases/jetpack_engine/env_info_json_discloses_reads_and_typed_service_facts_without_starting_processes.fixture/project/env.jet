module env.dev {
    prompt: $HOME
    services: {
        fixture: {
            enable: false,
            ports: [8080],
            run: ["fixture", "--port", "8080"],
            ready: "fixture --ready",
            data_dir: "state/fixture",
            watch: ["src"],
            after: ["database"],
            before_start: ["lint_all"],
            sockets: ["run/fixture.sock"]
        }
    }
    files: ["config/generated.txt": File{ content: "generated\n", mode: .Copy }]
}
