# HAND-PORT tests/jetpack_engine.rs:5552-5592 automatic_channel_refresh_writes_lock_and_manifest_without_update
# D-CHANNEL-AUTO2=A: an automatic refresh records the exact version in the lock only; env.jet keeps `omp@jetpack#auto` byte for byte.
# The resolved `nixpkgs:omp#1.2.3` is the exact the retired writeback turned into the malformed `omp#1.2.3@nixpkgs#auto`.
# `--trust`: the typed env.dev needs a trust decision and these steps are non-interactive.
fixture: automatic_channel_refresh_writes_lock_and_leaves_env_jet_unchanged.fixture
env: JETPACK_ROOT={work}/root
mkdir: root
copy: project/env.jet env.before
step: jetpack env --prep --no-color --yes --trust --fixtures {work}/fixtures
cwd: project
exit: 0
file: project/.jet/lock ~ "name = \"automatic\"" # the refresh locks the automatic source
file: project/.jet/lock ~ "exact = \"nixpkgs:omp#1.2.3\"" # the lock holds the exact version
file: project/env.jet == env.before
