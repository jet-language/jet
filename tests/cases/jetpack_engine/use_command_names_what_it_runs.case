# `jetpack use <pkg> -- <cmd>` says what it runs before the
# command's own output, so a package run is never mistaken for Jetpack output.
fixture: use_many_packages_settles_one_row_per_package_without_output_flood.fixture
mkdir: root
mkdir: project
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
step: jetpack use --offline --fixtures {work}/fixtures -y --no-color omp@releases#1.0.0 -- omp
cwd: project
exit: 0
stderr: ~ "running omp@releases#1.0.0 -> omp (no args)" # names the refs and the command before running it
stdout.trim: = "omp version one" # the package's own output follows unchanged
step: jetpack use --offline --fixtures {work}/fixtures -y --no-color omp@releases#1.0.0 -- omp --version
cwd: project
exit: 0
stderr: ~ "running omp@releases#1.0.0 -> omp --version" # names the command's arguments
