# Every ref that matches none of the legal forms (provider first,
# `@nixpkgs`, the `path` provider word, a version before `@source`) gets the
# one generic E1358 error listing the legal ref forms.
env: NO_COLOR=1
env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
step: jetpack use github@owner/repo --no-color
exit: 2
stderr.trim_end: = ../../fixtures/jetpack-diagnostics/ref_malformed.stderr # the whole E1358 report with the legal ref forms
step: jetpack use ripgrep@nixpkgs --no-color
exit: 2
stderr: ~ "Error [jet.InvalidRef]: `ripgrep@nixpkgs` is not a valid package ref" # retired @nixpkgs source
stderr: ~ "More: jet-lang.dev/e/E1358" # the generic ref error's page
step: jetpack use ../vendor/tool@path --no-color
exit: 2
stderr: ~ "Error [jet.InvalidRef]: `../vendor/tool@path` is not a valid package ref" # retired path provider word
step: jetpack use omp#v18.0.4@jetpack --no-color
exit: 2
stderr: ~ "Error [jet.InvalidRef]: `omp#v18.0.4@jetpack` is not a valid package ref" # version before @source
