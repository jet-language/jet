name: "demo"
outputs: {
    workstation: System{
        name: "workstation"
        target: linux.x64
        packages: [ripgrep, "fd@nixpkgs", ripgrep]
        services: { ssh: { enable: true, ports: [22] } }
        options: { network: { hostName: "workstation" } }
    }
    prod: Fleet{ hosts: { edge: "system.workstation" } }
}