// ORIGINAL-EXPRESSION oracle: jetpack_engine.rs:99-108. No assertions.
use core.files as files
use core.sys as sys
use core.process as process
use core.encoding.json as json
fn run() {
    data :: process.args()[0]
    home :: sys.get("USERPROFILE") ?? sys.get("HOME") ?? panic("home directory environment variable")
    expected :: if sys.is_macos() -> files.join(home, "Library/Application Support/Jet/Hangar") else if sys.is_windows() -> files.join(home, "AppData/Local/Jet/Hangar") else -> files.join(data, "jet/hangar")
    print(json.to_string(Dyn.Text(expected)))
}
