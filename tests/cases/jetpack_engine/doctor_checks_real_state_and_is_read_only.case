env: JETPACK_ROOT={work}/root
mkdir: root
mkdir: project
mkdir: keys
step: git init --bare {work}/project/registry.git
exit: 0
step: jet registry keygen
cwd: project
env: JET_KEYS_DIR={work}/keys
exit: 0
step: jetpack doctor --json --online
cwd: project
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=file://{work}/project/registry.git
exit: 0
json: stdout doc $.status = "healthy"
remove: keys/jet.ed25519
step: jetpack doctor --online
cwd: project
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=http://user:super-secret@example.invalid/index
exit: 2
stderr: ~ "[Fail] registry" # original contains predicate
stderr: ~ "embedded registry credentials" # original contains predicate
stderr: ~ "[Warn] signing" # original contains predicate
stderr: $= "Result: broken\n" # original ends_with predicate
stderr: !~ "super-secret" # original negative contains predicate
step: jetpack doctor --online
cwd: project
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=file:///registry.git?access_token=super-secret
exit: 2
stderr: ~ "embedded registry credentials" # original contains predicate
stderr: !~ "super-secret" # original negative contains predicate
step: jet registry keygen --force
cwd: project
env: JET_KEYS_DIR={work}/keys
exit: 0
copy: keys/jet.ed25519.pub matching-public
step: jet run mismatch-public.jet -- {work}/keys/jet.ed25519.pub
exit: 0
step: jetpack doctor --online
cwd: project
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=http://user:super-secret@example.invalid/index
exit: 2
stderr: ~ "does not match its public key" # original contains predicate
stderr: !~ "super-secret" # original negative contains predicate
copy: matching-public keys/jet.ed25519.pub

write: root/owned-output/payload trusted.template
# store-ingest seam supplies the exact original IngestRequest at 2538-2558;
# it must NOT use hangar ingest with CacheIdentity.empty() as a substitute.
step: jetpack explain demo --json --no-color
cwd: project
exit: 0
capture: id stdout doc $.explain.entry.id
capture: out stdout doc $.explain.entry.output_path
capture: old_used file root/hangar/{cap:id}/meta.json doc $.last_used_at
step: jet run broken-setup.jet -- {work}/root/hangar/{cap:id}/meta.json {cap:old_used} {cap:out} {work}/root
exit: 0
remove: keys/jet.ed25519
copy: root/hangar/{cap:id}/meta.json before-meta
copy: root/.locks/abandoned.lock before-lock
copy: keys/jet.ed25519.pub before-public
capture: public_permissions = permissions file keys/jet.ed25519.pub
capture: payload_permissions = permissions file root/owned-output/payload
step: jetpack doctor --json --offline
cwd: project
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=file://{work}/project/missing
exit: 2
stdout: ~ "failed its content digest" # original contains predicate
stdout: ~ "local index missing" # original contains predicate
stdout: !~ "stale lock" # original negative contains predicate
stdout: ~ "kernel advisory locks readable" # original contains predicate
stdout: ~ "unused for more than 30 days" # original contains predicate
stdout: ~ "signing key for `jet` is missing" # original contains predicate
file: root/hangar/{cap:id}/meta.json == before-meta
file: root/.locks/abandoned.lock == before-lock
file: keys/jet.ed25519.pub == before-public
file: keys/jet.ed25519.pub permissions = "{cap:public_permissions}"
file: root/owned-output/payload permissions = "{cap:payload_permissions}"
