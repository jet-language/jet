# HAND-PORT tests/jetpack_engine.rs:83-113 hangar_path_reports_the_native_user_data_location
# Store commands live under `jetpack hangar`; `jet` has no hangar group.
fixture: hangar_path_reports_the_native_user_data_location.fixture
env: NO_COLOR=1
mkdir: data
env: XDG_DATA_HOME={work}/data
step: jet run --allow=Env {work}/expected-path.jet -- {work}/data
exit: 0
capture: expected stdout doc $
step: jetpack hangar path --no-color
unset: JETPACK_ROOT
unset: XDG_STATE_HOME
unset: LOCALAPPDATA
exit: 0
stdout.trim: = "{cap:expected}" # original String equality; expected itself is NOT trimmed

