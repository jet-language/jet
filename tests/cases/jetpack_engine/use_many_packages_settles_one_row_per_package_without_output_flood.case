# A 26-package realization on a real 30x120 terminal
# pins one live aggregate line (`Resolving <done>/<total> packages` with
# transferred / total bytes, `?` while the total is undisclosed) above one
# settled row per package, so the transcript never floods past the screen.
fixture: use_many_packages_settles_one_row_per_package_without_output_flood.fixture
mkdir: root
mkdir: project
env: JETPACK_ROOT={work}/root
env: JETPACK_FIXTURES={work}/fixtures
step: script -qfec "stty rows 30 cols 120; exec '{jetpack}' use --prep --offline --fixtures '{work}/fixtures' -y omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0 omp@releases#1.0.0" /dev/null
cwd: project
unset: NO_COLOR
unset: FORCE_COLOR
unset: CI
exit: 0
stdout: count "✓" = 26 # one settled row per package
stdout: count "✓" <= 29 # settled rows plus the aggregate fit 30 rows
stdout: ~ "0/26 packages" # the aggregate counts packages while resolving
stdout: ~ "25/26 packages" # the aggregate counts the last package before it settles
stdout: !~ "objects  0 B / 0 B" # no fabricated byte total
