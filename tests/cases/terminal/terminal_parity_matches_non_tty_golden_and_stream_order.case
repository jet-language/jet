# tests/terminal.rs::terminal_parity_matches_non_tty_golden_and_stream_order
# Exact original helper/source predicates; PENDING-SAME-HEAD; runtime UNRUN.
# The `_merged` steps run terminal.jet through merged.jet, which merges its
# stderr into its stdout with Core's `.stderr(.Stdout)`: one descriptor for
# both, so the merged golden pins the stdout/stderr write order.
requires: os:unix
fixture: terminal_parity_matches_non_tty_golden_and_stream_order.fixture
env: NO_COLOR=1
step default: jet run --quiet terminal.jet
stdin: piped.stdin
exit: 0
stdout: = terminal_parity_matches_non_tty_golden_and_stream_order.stdout
stderr: = terminal_parity_matches_non_tty_golden_and_stream_order.stderr
step default_merged: jet run --quiet merged.jet
stdin: piped.stdin
exit: 0
stdout: = terminal_parity_matches_non_tty_golden_and_stream_order.merged
stderr: = ""
step release: jet run --quiet --release terminal.jet
stdin: piped.stdin
exit: 0
stdout: = terminal_parity_matches_non_tty_golden_and_stream_order.stdout
stderr: = terminal_parity_matches_non_tty_golden_and_stream_order.stderr
step release_merged: jet run --quiet merged.jet release
stdin: piped.stdin
exit: 0
stdout: = terminal_parity_matches_non_tty_golden_and_stream_order.merged
stderr: = ""
step interpret_merged: jet run --quiet merged.jet
stdin: piped.stdin
exit: 0
stdout: = terminal_parity_matches_non_tty_golden_and_stream_order.merged
stderr: = ""
