// The consuming Iter methods over a lazy source. `pulled` counts the items an
// upstream map hands on, so each test also sees how far its method walked:
// find stops at the first match, the others pull every item once.

#Test("count_where counts the matching items of an Iter") {
    pulled := 0
    count: [Int]{1, 2, 3, 4}.lazy().map(fn(n) {
        pulled += 1
        n
    }).count_where(fn(n) { n % 2 == 0 })
    assert_eq(count, 2)
    assert_eq(pulled, 4)
}

#Test("find stops pulling at the first match") {
    pulled := 0
    found: [Int]{1, 2, 3, 4}.lazy().map(fn(n) {
        pulled += 1
        n
    }).find(fn(n) { n >= 2 })
    assert_eq(found ?? 0, 2)
    assert_eq(pulled, 2)
}

#Test("find over an Iter without a match is None") {
    found: [String]{"a", "b"}.lazy().find(fn(s) { s == "c" })
    assert_eq(found ?? "none", "none")
}

#Test("each lends every item of an Iter in order") {
    seen := [String]{}
    items: [String]{"a", "b", "c"}
    items.lazy().map(fn(s) { s.to_upper() }).each(fn(s) { seen.push(s.copy()) })
    assert_eq(seen, [String]{"A", "B", "C"})
}

#Test("fold threads the accumulator through every item of an Iter") {
    total: [String]{"ab", "cde", "f"}.lazy().fold(0, fn(acc, s) { acc + s.len() })
    assert_eq(total, 6)
    joined: [String]{"x", "y"}.lazy().fold("", fn(acc, s) { "{acc}{s}" })
    assert_eq(joined, "xy")
}

#Test("max_by keeps the last of the longest items of an Iter") {
    pulled := 0
    longest: [String]{"bb", "a", "cc"}.lazy().map(fn(s) {
        pulled += 1
        s
    }).max_by(fn(s) { s.len() })
    assert_eq(longest ?? "", "cc")
    assert_eq(pulled, 3)
}

#Test("min_by keeps the last of the shortest items of an Iter") {
    shortest: [String]{"bb", "a", "c"}.lazy().min_by(fn(s) { s.len() })
    assert_eq(shortest ?? "", "c")
    empty: [String]{}.lazy().min_by(fn(s) { s.len() })
    assert_eq(empty ?? "none", "none")
}

#Test("count_by counts the items of an Iter under each key") {
    counts: [String]{"a 1", "b 2", "a 3"}.lazy().count_by(fn(s) { s.words()[0] })
    assert_eq(counts["a"], 2)
    assert_eq(counts["b"], 1)
}

#Test("group_by gathers the items of an Iter under each key in order") {
    groups: [String]{"a 1", "b 2", "a 3"}.lazy().group_by(fn(s) { s.words()[0] })
    assert_eq(groups["a"], [String]{"a 1", "a 3"})
    assert_eq(groups["b"], [String]{"b 2"})
}

#Test("indexed numbers the items of an Iter as they are pulled") {
    pulled := 0
    pairs: [String]{"x", "y", "z"}.lazy().map(fn(s) {
        pulled += 1
        s
    }).indexed()
    first: pairs.find(fn(p) { p.idx == 1 })
    assert_eq(pulled, 2)
    assert_eq(first?.item ?? "", "y")
}
