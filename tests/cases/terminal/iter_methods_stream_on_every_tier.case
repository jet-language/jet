cwd: main
limit: time=120
exit: 0
stdout: = "b 2 ok\n"
step count_by_o0: jet run --optimize=none -e 'input.count_by(fn(l) { l.words()[0] })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "[a: 2, b: 1, ccc: 1]\n"
