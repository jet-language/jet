stdout: = "[a: [a 1 error, a 3 error], b: [b 2 ok], ccc: [ccc 4 ok]]\n"
step indexed_o0: jet run --optimize=none -e 'input.indexed().map(fn(p) { "{p.idx + 1} {p.item}" })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "1 a 1 error\n2 b 2 ok\n3 a 3 error\n4 ccc 4 ok\n"
