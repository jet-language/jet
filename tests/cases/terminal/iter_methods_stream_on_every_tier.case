# #6067: every consuming Iter method lowers on every tier. Over the Iter
# `input` yields, count_where, find, each, fold, max_by, min_by, count_by,
# group_by and indexed run under `jet -e` at O0, O1 and O2 and print the same
# lines. They pull the Iter item by item instead of collecting it first: the
# #Test per method in iter_methods.jet counts the pulls an upstream map makes,
# so find stops at the first match and indexed numbers items as they come.
fixture: iter_methods_stream_on_every_tier.fixture
env: NO_COLOR=1
step test_o0: jet test --optimize=none iter_methods.jet
cwd: main
limit: time=300
exit: 0
stdout: ~ "10 passed, 0 failed, 0 skipped" # the summary line; the per-test lines and timings vary
stdout: ~ "find stops pulling at the first match: pass" # the pull-count test is among the passes
step test_o1: jet test --optimize=basic iter_methods.jet
cwd: main
limit: time=300
exit: 0
stdout: ~ "10 passed, 0 failed, 0 skipped" # the summary line; the per-test lines and timings vary
stdout: ~ "find stops pulling at the first match: pass" # the pull-count test is among the passes
step test_o2: jet test --optimize=full iter_methods.jet
cwd: main
limit: time=300
exit: 0
stdout: ~ "10 passed, 0 failed, 0 skipped" # the summary line; the per-test lines and timings vary
stdout: ~ "find stops pulling at the first match: pass" # the pull-count test is among the passes
step count_where_o0: jet run --optimize=none -e 'input.count_where(fn(l) { l.contains("error") })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "2\n"
step count_where_o1: jet run --optimize=basic -e 'input.count_where(fn(l) { l.contains("error") })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "2\n"
step count_where_o2: jet run --optimize=full -e 'input.count_where(fn(l) { l.contains("error") })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "2\n"
step find_o0: jet run --optimize=none -e 'input.find(fn(l) { l.contains("ok") }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "b 2 ok\n"
step find_o1: jet run --optimize=basic -e 'input.find(fn(l) { l.contains("ok") }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "b 2 ok\n"
step find_o2: jet run --optimize=full -e 'input.find(fn(l) { l.contains("ok") }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "b 2 ok\n"
step each_o0: jet run --optimize=none -e 'input.each(fn(l) { print(l.len()) })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "9\n6\n9\n8\n"
step each_o1: jet run --optimize=basic -e 'input.each(fn(l) { print(l.len()) })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "9\n6\n9\n8\n"
step each_o2: jet run --optimize=full -e 'input.each(fn(l) { print(l.len()) })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "9\n6\n9\n8\n"
step fold_o0: jet run --optimize=none -e 'input.fold(0, fn(acc, l) { acc + l.len() })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "32\n"
step fold_o1: jet run --optimize=basic -e 'input.fold(0, fn(acc, l) { acc + l.len() })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "32\n"
step fold_o2: jet run --optimize=full -e 'input.fold(0, fn(acc, l) { acc + l.len() })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "32\n"
step max_by_o0: jet run --optimize=none -e 'input.max_by(fn(l) { l.len() }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "a 3 error\n"
step max_by_o1: jet run --optimize=basic -e 'input.max_by(fn(l) { l.len() }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: = "a 3 error\n"
