# tests/terminal.rs::error_report_matrix_tty_pipe_no_color_and_narrow_widths
# Exact original helper/source predicates; PENDING-SAME-HEAD; runtime UNRUN.
requires: os:unix
fixture: error_report_matrix_tty_pipe_no_color_and_narrow_widths.fixture
env: NO_COLOR=1
step pipe: jet run --quiet Examples/features/errors/error_context.jet
unset: NO_COLOR
unset: FORCE_COLOR
env: COLUMNS=40
stdin: null
exit: any # original predicate: status not asserted
stderr.replace("\r", ""): = error_report_pipe.txt # original transcript.replace('\r', "")
stderr: !~ "\u001b" # original pipe output has no escape bytes
stderr: ~ "Examples/features/errors/error_context.jet:7" # original contains predicate
stderr.strip_sgr.line(0): = error_report_matrix_tty_pipe_no_color_and_narrow_widths.first-line # original compares SGR-stripped first line
step ansi: script -qfec "stty rows 24 cols 80; exec {jet} run --quiet Examples/features/errors/error_context.jet" /dev/null
unset: NO_COLOR
unset: FORCE_COLOR
unset: COLUMNS
stdin: null
exit: == pipe
stdout.replace("\r", ""): = error_report_tty_ansi.txt # original transcript.replace('\r', "")
stdout.replace("\r", "").strip_sgr.line(0): = error_report_matrix_tty_pipe_no_color_and_narrow_widths.first-line # original transcript.replace('\r', "")
stdout: ~ "\u001b" # original TTY output carries escape bytes
step plain: script -qfec "stty rows 24 cols 80; exec {jet} run --quiet Examples/features/errors/error_context.jet" /dev/null
unset: NO_COLOR
unset: FORCE_COLOR
unset: COLUMNS
env: NO_COLOR=
stdin: null
exit: == pipe
stdout.replace("\r", ""): = error_report_tty_no_color.txt # original transcript.replace('\r', "")
stdout.replace("\r", "").strip_sgr.line(0): = error_report_matrix_tty_pipe_no_color_and_narrow_widths.first-line # original transcript.replace('\r', "")
stdout.replace("\r", "").strip_sgr: == ansi # original transcript.replace('\r', "")
step narrow: script -qfec "stty rows 24 cols 40; export COLUMNS=40; exec {jet} run --quiet Examples/features/errors/error_context.jet" /dev/null
unset: NO_COLOR
unset: FORCE_COLOR
unset: COLUMNS
env: NO_COLOR=
stdin: null
exit: == pipe
stdout.replace("\r", ""): = error_report_tty_narrow40.txt # original transcript.replace('\r', "")
stdout.replace("\r", "").strip_sgr.line(0): = error_report_matrix_tty_pipe_no_color_and_narrow_widths.first-line # original transcript.replace('\r', "")
stdout.replace("\r", ""): each-line where chars <= 40 # original transcript.replace('\r', "")
stdout: ~ "  1. parse_config (error_context.jet:7)" # original contains predicate
stdout: ~ "  2. load_config (error_context.jet:12)" # original contains predicate
stdout: ~ "  3. run (error_context.jet:16)" # original contains predicate
