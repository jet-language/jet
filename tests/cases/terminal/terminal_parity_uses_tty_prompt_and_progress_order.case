stdout.replace("\r", ""): == default
stdout.replace("\r", ""): before "Continue? [y/N]" "Choose a target:"
stdout.replace("\r", ""): before "Choose a target:" "choice: production"
stdout.replace("\r", ""): before "choice: production" "Secret: "
stdout.replace("\r", ""): before "Secret: " "secret length: 6"
stdout.replace("\r", ""): before "secret length: 6" "progress"
stdout.replace("\r", ""): before "progress" "stderr stream"
stdout: ~ "\rprogress" # original ed77c235f tests/terminal.rs:171 contains predicate
stdout: !~ "secret: non-tty" # original ed77c235f tests/terminal.rs:175 not contains predicate
