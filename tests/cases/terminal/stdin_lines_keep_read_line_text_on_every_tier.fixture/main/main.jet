use core.term as io

// Each line of a fresh stdin handle: its position, byte length and text (a
// long line by its length and last byte only).
fn run() {
    index := 0
    loop line in io.stdin().lines() {
        index += 1
        if line == "skip" -> next
        size :: line.bytes().len()
        if size > 40 {
            print("{index} {size} long {line.slice(size - 1, size)}")
        } else {
            print("{index} {size} [{line}]")
        }
        if line == "stop" -> break
    }
    print("done")
}
