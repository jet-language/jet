use core.process as process

// A process line source: the child's stdout carries an invalid UTF-8 line.
fn run() -[Exec, IO, Time.Wait]> {
    child :: process.cmd(["sh", "-c", "printf 'ok\\n\\377\\376\\nnever\\n'"]).stdout(.Stream).spawn() ?? panic("spawn failed")
    count := 0
    loop line in child.stdout.lines() {
        count += 1
        print("[{line}]")
    }
    print("count {count}")
}
