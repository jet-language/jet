# An explicit flush writes a piped stdout's buffer at once. The program
# prints a line and writes another through `term.stdout()`, flushes, prints
# a third line and sleeps, and the step kills it first, so no exit drains the
# buffer: the pipe holds the two lines written before the flush, at every
# optimization level.
requires: os:unix
fixture: stdout_flush_shows_piped_lines_before_the_program_ends.fixture
env: NO_COLOR=1
step build0: jet build --optimize=none main.jet
exit: 0
step pipe0: sh -c "timeout -s KILL 2 .jet/build/main | cat; echo killed"
exit: 0
stdout: = "a printed line before the flush\na stdout write before the flush\nkilled\n" # the line after the flush died with the process
step build1: jet build --optimize=basic main.jet
exit: 0
step pipe1: sh -c "timeout -s KILL 2 .jet/build/main | cat; echo killed"
exit: 0
stdout: = "a printed line before the flush\na stdout write before the flush\nkilled\n"
step build2: jet build --optimize=full main.jet
exit: 0
step pipe2: sh -c "timeout -s KILL 2 .jet/build/main | cat; echo killed"
exit: 0
stdout: = "a printed line before the flush\na stdout write before the flush\nkilled\n"
