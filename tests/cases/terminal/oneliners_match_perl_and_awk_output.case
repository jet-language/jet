# #6067: each `jet -e` one-liner of the table prints byte for byte what the Perl
# and awk one-liners print over the same input, and the in-place edit leaves
# the same file. The commands are the ones `oneliners.tsv` lists; `count.jet`
# counts their characters. A misspelled record field is a compile error in Jet,
# while the Perl and awk versions exit 0 and print a wrong sum.
requires: os:unix
requires: tool:perl
requires: tool:gawk
fixture: oneliners_match_perl_and_awk_output.fixture
env: NO_COLOR=1
step p_field: perl -lane 'print $F[1]' log.txt
cwd: main
exit: 0
step a_field: gawk '{ print $2 }' log.txt
cwd: main
exit: 0
stdout: == p_field
step j_field: jet -e 'input.map(fn(l) { l.words()[1] })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_field
step p_sum: perl -lane '$s += $F[2]; END { print $s }' log.txt
cwd: main
exit: 0
step a_sum: gawk '{ s += $3 } END { print s }' log.txt
cwd: main
exit: 0
stdout: == p_sum
step j_sum: jet -e 'input.map(fn(l) { l.words()[2].to_int() ?? 0 }).sum()' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_sum
step p_count: perl -lne '$n++ if /error/; END { print $n + 0 }' log.txt
cwd: main
exit: 0
step a_count: gawk '/error/ { n++ } END { print n + 0 }' log.txt
cwd: main
exit: 0
stdout: == p_count
step j_count: jet -e 'input.count_where(fn(l) { l.contains("error") })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_count
step p_unique: perl -ne 'print unless $seen{$_}++' log.txt
cwd: main
exit: 0
step a_unique: gawk '!seen[$0]++' log.txt
cwd: main
exit: 0
stdout: == p_unique
step j_unique: jet -e 's := [String]{}.to_set(); input.filter(fn(l) { s.add(l.copy()) })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_unique
step p_edit: perl -pi -e 's/web/www/g' edit_perl.txt
cwd: main
exit: 0
stdout: empty
step a_edit: gawk -i inplace '{ gsub(/web/, "www") } 1' edit_awk.txt
cwd: main
exit: 0
stdout: empty
file: main/edit_awk.txt == main/edit_perl.txt
step j_edit: jet -e 'input.edit(fn(l) { l.replace("web", "www") })' edit_jet.txt
cwd: main
limit: time=120
exit: 0
stdout: empty
file: main/edit_jet.txt == main/edit_perl.txt # the same file as `perl -pi` leaves
step p_number: perl -ne 'print "$. $_"' log.txt
cwd: main
exit: 0
step a_number: gawk '{ print NR, $0 }' log.txt
cwd: main
exit: 0
stdout: == p_number
step j_number: jet -e 'input.indexed().map(fn(p) { "{p.idx + 1} {p.item}" })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_number
step p_longest: perl -ne '$m = $_ if length > length $m; END { print $m }' log.txt
cwd: main
exit: 0
step a_longest: gawk 'length > length(m) { m = $0 } END { print m }' log.txt
cwd: main
exit: 0
stdout: == p_longest
step j_longest: jet -e 'input.max_by(fn(l) { l.len() }) ?? ""' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_longest
step p_swap: perl -lane 'print "$F[1] $F[0]"' log.txt
cwd: main
exit: 0
step a_swap: gawk '{ print $2, $1 }' log.txt
cwd: main
exit: 0
stdout: == p_swap
step j_swap: jet -e 'input.map(fn(l) { l.words() }).map(fn(w) { "{w[1]} {w[0]}" })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_swap
step p_long: perl -lne 'print if length > 80' log.txt
cwd: main
exit: 0
step a_long: gawk 'length > 80' log.txt
cwd: main
exit: 0
stdout: == p_long
step j_long: jet -e 'input.filter(fn(l) { l.len() > 80 })' log.txt
cwd: main
limit: time=120
exit: 0
stdout: == p_long
step p_csv: perl -F, -lane 'if ($. == 1) { ($c) = grep { $F[$_] eq "amount" } 0 .. $#F } else { $s += $F[$c] } END { print $s }' sales.csv
cwd: main
exit: 0
stdout: = "8.5\n"
step a_csv: gawk -F, 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "amount") c = i; next } { s += $c } END { print s }' sales.csv
cwd: main
exit: 0
stdout: == p_csv
step j_csv: jet -e 'Sale: struct { amount: Float }; input.csv<Sale>().map(fn(s) { s.amount }).sum()' sales.csv
cwd: main
limit: time=120
exit: 0
stdout: == p_csv
step p_typo: perl -F, -lane 'if ($. == 1) { ($c) = grep { $F[$_] eq "amonut" } 0 .. $#F } else { $s += $F[$c] } END { print $s }' sales.csv
cwd: main
exit: 0
stdout: = "0\n" # the misspelled column sums the first field as 0 and exits 0
step a_typo: gawk -F, 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "amonut") c = i; next } { s += $c } END { print s }' sales.csv
cwd: main
exit: 0
stdout: = "0\n" # the same silent wrong sum
step j_typo: jet -e 'Sale: struct { amount: Float }; input.csv<Sale>().map(fn(s) { s.amonut }).sum()' sales.csv
cwd: main
limit: time=120
exit: 1
stdout: empty
stderr: ~ "amonut" # a compile error names the misspelled field; nothing runs
step count: jet run --quiet count.jet oneliners.tsv
cwd: main
limit: time=120
exit: 0
stdout: = oneliners_match_perl_and_awk_output.count.out
stderr: empty
