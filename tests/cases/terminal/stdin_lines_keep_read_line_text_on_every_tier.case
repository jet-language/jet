# #6444/#6541: `loop line in io.stdin().lines()` over a fresh handle (the direct read)
# and over a kept handle (the eager line source) keeps every line's text on each
# tier: a 70001-byte line, a `stop` break, and an invalid UTF-8 line, which
# stops with the read error instead of growing without bound (#6541). The
# testkit feeds a `stdin:` file as its exact bytes, invalid UTF-8 included. A process
# line source (`child.stdout.lines()`, the same lazy.line_next) stops on its
# invalid UTF-8 line the same way, and so does a file line source
# (`files.open(path).lines()`), which grew without bound before #6541.
requires: os:unix
fixture: stdin_lines_keep_read_line_text_on_every_tier.fixture
env: NO_COLOR=1
step main_lines_default: jet run --quiet main.jet
cwd: main
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-lines.out
stderr: empty
step main_stop_default: jet run --quiet main.jet
cwd: main
stdin: {work}/stop.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-stop.out
stderr: empty
step main_bad_default: jet run --quiet main.jet
cwd: main
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step main_lines_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-lines.out
stderr: empty
step main_stop_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/stop.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-stop.out
stderr: empty
step main_bad_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: = stdin_lines_keep_read_line_text_on_every_tier.main-bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step kept_lines_default: jet run --quiet kept.jet
cwd: kept
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.kept-lines.out
stderr: empty
step kept_stop_default: jet run --quiet kept.jet
cwd: kept
stdin: {work}/stop.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.kept-stop.out
stderr: empty
step kept_bad_default: jet run --quiet kept.jet
cwd: kept
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: empty # the kept handle reads every line before the body runs
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step kept_lines_release: jet run --quiet --release kept.jet
cwd: kept
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.kept-lines.out
stderr: empty
step kept_stop_release: jet run --quiet --release kept.jet
cwd: kept
stdin: {work}/stop.stdin
limit: time=120
exit: 0
stdout: = stdin_lines_keep_read_line_text_on_every_tier.kept-stop.out
stderr: empty
step kept_bad_release: jet run --quiet --release kept.jet
cwd: kept
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: empty # the kept handle reads every line before the body runs
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step proc_bad_default: jet run --quiet proc.jet
cwd: proc
limit: time=60
exit: 70
stdout: = stdin_lines_keep_read_line_text_on_every_tier.proc-bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `process output`: stream did not contain valid UTF-8" # the E3001 report's message line
step proc_bad_release: jet run --quiet --release proc.jet
cwd: proc
limit: time=60
exit: 70
stdout: = stdin_lines_keep_read_line_text_on_every_tier.proc-bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `process output`: stream did not contain valid UTF-8" # the E3001 report's message line
step file_bad_default: jet run --quiet file.jet
cwd: file
limit: time=60
exit: 70
stdout: empty
stderr: ~ "panic: invalid input during read `../bad.stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step file_bad_release: jet run --quiet --release file.jet
cwd: file
limit: time=60
exit: 70
stdout: empty
stderr: ~ "panic: invalid input during read `../bad.stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
