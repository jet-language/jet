# `loop line in input` reads each line in the loop's own step (no Iter
# between the read and the body), with standard input through the runtime's
# line leaf while no arguments name files. Each tier keeps the same lines from
# standard input and from two named files, in order, honours `next` and
# `break`, ends at an empty input, and stops on an invalid UTF-8 line with the
# read error after running the body on the line before it.
requires: os:unix
fixture: ambient_input_loop_reads_lines_in_place_on_every_tier.fixture
env: NO_COLOR=1
step stdin_default: jet run --quiet main.jet
cwd: main
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.lines.out
stderr: empty
step files_default: jet run --quiet main.jet a.txt b.txt
cwd: main
stdin: {work}/bad.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.lines.out # named files: standard input is not read
stderr: empty
step empty_default: jet run --quiet main.jet
cwd: main
stdin: {work}/empty.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.empty.out
stderr: empty
step bad_default: jet run --quiet main.jet
cwd: main
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
step stdin_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/lines.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.lines.out
stderr: empty
step files_release: jet run --quiet --release main.jet a.txt b.txt
cwd: main
stdin: {work}/bad.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.lines.out # named files: standard input is not read
stderr: empty
step empty_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/empty.stdin
limit: time=120
exit: 0
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.empty.out
stderr: empty
step bad_release: jet run --quiet --release main.jet
cwd: main
stdin: {work}/bad.stdin
limit: time=60
exit: 70
stdout: = ambient_input_loop_reads_lines_in_place_on_every_tier.bad.out # the line before the bad one runs the body
stderr: ~ "panic: I/O error during read `stdin`: stream did not contain valid UTF-8" # the E3001 report's message line
