# tests/terminal.rs::terminal_parity_ends_on_closed_input_on_every_tier
# Exact original helper/source predicates; PENDING-SAME-HEAD; runtime UNRUN.
requires: os:unix
fixture: terminal_parity_ends_on_closed_input_on_every_tier.fixture
env: NO_COLOR=1
file: expected.original count "> Enter a number from 1 to 2.\n" = 2 # original expected-value helper assertion
step default: jet run --quiet terminal.jet
stdin: null
stdout: file {work}/default.stdout
stderr: file {work}/default.stderr
limit: time=120
exit: 0
file: default.stdout size <= 65536
file: default.stdout !~ "Enter a number from 1 to 2."
file: default.stdout = terminal_parity_ends_on_closed_input_on_every_tier.out
step release: jet run --quiet --release terminal.jet
stdin: null
stdout: file {work}/release.stdout
stderr: file {work}/release.stderr
limit: time=120
exit: 0
file: release.stdout size <= 65536
file: release.stdout !~ "Enter a number from 1 to 2."
file: release.stdout = terminal_parity_ends_on_closed_input_on_every_tier.out
