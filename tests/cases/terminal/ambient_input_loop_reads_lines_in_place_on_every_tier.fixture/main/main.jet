// `loop line in input`: the program's lines, from the files its arguments
// name, in order, else from standard input, each read by the loop's own step.
// A `next` skips a line and a `break` ends the reading.
run: fn() {
    count := 0
    loop line in input {
        count += 1
        if line == "skip" -> next
        print("{count} [{line}]")
        if line == "stop" -> break
    }
    print("done")
}
