# PORT tests/repl.rs:413-430 plus helpers13-62/343-357; original inputs/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os:unix
env: JET_REPL_HISTORY=off
step raw: jet repl
pty: true
limit: time=8
pty-send: "10 +\r" after 200ms
pty-send: "32\r" after 150ms
pty-send: ":quit\r" after 200ms
exit: 0
stdout: ~ "· 2" # Original edited continuation rs423.
stdout: ~ "12 : Int" # Original edited execution rs427.
