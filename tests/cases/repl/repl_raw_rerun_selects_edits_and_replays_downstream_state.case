# PORT tests/repl.rs:2550-2573, helper343-357 where used; exact bytes/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os:unix
env: JET_REPL_HISTORY=off
step raw: jet repl
pty: true
limit: time=8
pty-send: "rate := 7\r" after 200ms
pty-send: "total :: rate * 2\r" after 120ms
pty-send: "\u0012" after 120ms
pty-send: "1\r" after 120ms
pty-send: "8\r" after 120ms
pty-send: "total\r" after 200ms
pty-send: ":quit\r" after 200ms
exit: 0
stdout: ~ "select turn to edit" # Original substring predicate rs2562.
stdout: ~ "rerun #2: total :: rate * 2" # Original substring predicate rs2566.
stdout: ~ "16 : Int" # Original substring predicate rs2570.
