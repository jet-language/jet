# PORT tests/repl.rs:2376-2392 plus helpers13-62/343-357; original inputs/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os-name:linux
env: JET_REPL_HISTORY=off
step raw: jet repl
pty: true
limit: time=8
pty-send: "use core.math as math\r" after 200ms
pty-send: "math.sq\t" after 150ms
pty-send: "(16.0)\r" after 120ms
pty-send: ":quit\r" after 200ms
exit: 0
stdout: ~ "4" # Original result conjunction rs2389.
stdout: ~any "Float" "4.0" # Original result disjunction rs2389.
