# PORT tests/repl.rs:1871-1908 plus helpers13-62/343-357; original inputs/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os-name:linux
mkdir: project
env: JET_REPL_HISTORY=off
step raw: jet repl --project {work}/project --allow-exec
pty: true
limit: time=6
pty-send: "use core.process as process\r" after 200ms
pty-send: "#FX(authority: Exec) { process.run([\"sh\", \"-c\", \"trap 'sleep 0.4; exit 130' INT; while :; do :; done\"]) ?? panic(\"run failed\") }\r" after 150ms
pty-send: "\u0003" after 600ms
pty-send: ":quit\r" after 800ms
exit: 0
stdout: ~ "waiting for active external I/O to stop" # Original blocking warning rs1904.
