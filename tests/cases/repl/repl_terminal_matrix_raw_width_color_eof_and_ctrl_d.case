# PORT tests/repl.rs:2879-2945, helper343-357 where used; exact bytes/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os-name:linux
env: JET_REPL_HISTORY=off
# Original matrix row auto/20, rs2882-2926.
step auto_20: jet repl
pty: true size 24x20
unset: NO_COLOR
unset: FORCE_COLOR
limit: time=8
pty-send: "1 + 1\r" after 200ms
pty-send: "\u0004" after 120ms
exit: 0
stdout: ~ "Tab" # Original substring predicate rs2913.
stdout: ~ "F3" # Original substring predicate rs2914.
stdout: !~ "interactive keys require a TTY" # Original raw-mode conjunction rs2915.
stdout: ~ "2 : Int" # Original substring predicate rs2919.
stdout: ~ "\u001b[1;96m" # Original exact color bool for auto/20 rs2922-2925.
