# PORT tests/repl.rs:2718-2745, helper343-357 where used; exact bytes/predicates, no reference snapshot.
# PENDING-SEAM(pty); runtime PENDING-SAME-HEAD.
refused: pty
env: NO_COLOR=1
requires: os:unix
env: JET_REPL_HISTORY=off
step raw: jet repl
pty: true
limit: time=8
pty-send: "first :: 1\r" after 200ms
pty-send: "second :: 2\r" after 120ms
pty-send: "\u0010" after 120ms
pty-send: "1\r" after 120ms
pty-send: "\u0006" after 120ms
pty-send: "1\r" after 120ms
pty-send: ":turns\r" after 120ms
pty-send: ":quit\r" after 200ms
exit: 0
stdout: ~ "select turn to pin" # Original substring predicate rs2730.
stdout: ~ "select turn to fold" # Original substring predicate rs2734.
stdout: ~ "#1 ok pinned folded" # Original substring predicate rs2738.
stdout: !~ "#2 ok pinned" # Original latest-turn conjunction rs2742.
stdout: !~ "#2 ok folded" # Original latest-turn conjunction rs2742.
