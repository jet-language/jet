# PORT tests/repl.rs:1992-2005, migrated to the session's effect notice (#6614 c3, c4): a
# non-tty session with no flags runs a turn that writes a file, and names the
# write on stderr before the turn runs; `--deny=FS.Write` stops the same turn
# with E1803 before anything is written.
# PENDING-GRAMMAR(batch-four); no blessed snapshots.
# Startup non-overlap: crates/jet-repl/src/Render.rs24-37,41-61,67-74; cooked mirror lib.rs2469-2470.
fixture: repl_non_tty_session_names_a_file_write_and_runs_it.fixture
mkdir: project
step allowed: jet repl --project {work}/project
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: repl_non_tty_session_names_a_file_write_and_runs_it.fixture/input0.txt
exit: 0
stderr: ~ "note: this session now " # the session names what the turn does before it runs
stderr: ~ "writes files (-A hides this)" # the write is named, not refused
stdout|stderr: !~ "E1803" # nothing denies the write
file: project/written.txt = "yes"
remove: project/written.txt
step denied: jet repl --project {work}/project --deny=FS.Write
env: NO_COLOR=1
env: XDG_STATE_HOME={work}/state
stdin: repl_non_tty_session_names_a_file_write_and_runs_it.fixture/input0.txt
exit: nonzero
stdout|stderr: ~ "E1803" # the command's deny row stops the turn
stdout|stderr: ~ "FS.Write" # and names the denied right
stdout|stderr: !~ "note: this session" # a denied turn names nothing
file: project/written.txt absent
