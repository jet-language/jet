# Claim: a plain fallible call propagates its failure through a compiler-made
# binding, so L0101 never reports it. The fixture propagates on lines 12, 17
# and 18. The unread user binding `spare` on line 23 is the only report.
fixture: propagated_failure_is_never_an_unused_local.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
stderr: ~ "Local binding `spare` is never read" # a real unused local still warns
stderr: ~ "main.jet:23:5" # the user binding is the only report
stderr: !~ "main.jet:12:" # no report for the propagation in load_one
stderr: !~ "main.jet:17:" # no report for the first propagation in load_two
stderr: !~ "main.jet:18:" # no report for the second propagation in load_two
stderr: !~ "`err`" # no generated error binding is reported
