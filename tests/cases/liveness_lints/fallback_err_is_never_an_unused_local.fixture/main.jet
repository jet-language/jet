use math: core.math

#Unsafe("probe") mine: fn(x: Int) -> Int IOError! { x }

safe: fn(x: Int) -> Int IOError! { x }

in_block: fn() -> Int {
    #Unsafe("probe") { mine(3) ?? -1 }
}

early: fn() -> Int {
    value: safe(4) ?? return 0
    value
}

run: fn() {
    print(in_block())
    print(safe(2) ?? -1)
    print(math.factorial(5) ?? -1)
    print(early())
    err: 7
}
