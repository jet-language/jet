#Error
ParseError: enum {
    Empty
}

parse: fn(raw: String) -> Int ParseError! {
    if raw == "" -> return Err(ParseError.Empty)
    Ok(raw.len())
}

load_one: fn() -> Int ParseError! {
    a: parse("ab")
    Ok(a)
}

load_two: fn() -> Int ParseError! {
    b: parse("")
    c: load_one()
    Ok(b + c)
}

run: fn() {
    spare: 5
    print(load_one() ?? 0)
    print(load_two() ?? -1)
}
