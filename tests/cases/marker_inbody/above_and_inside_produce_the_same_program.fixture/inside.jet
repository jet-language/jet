// The same program as above.jet, with every marker written as a line in the body.
Pixel: struct {
    #Layout: c
    a: U8
    b: Int
    #Equatable: true
    c: U8
    #Debug: false
}

Receipt: struct {
    id: Int
    #MustUse: true
}

brightness: fn(pixel: Pixel) -> Int {
    #Inline: true
    pixel.b * 2
    #MustUse: true
}

PIXEL_SIZE: comptime { Pixel.reflect().layout.size ?? -1 }

PIXEL_C: comptime { Pixel.reflect().layout.fields[2].offset ?? -1 }

issue: fn() -> Receipt { Receipt{id: 4} }

run: fn() {
    print("size {PIXEL_SIZE}, c at {PIXEL_C}")
    first: Pixel{a: U8{1}, b: 20, c: U8{3}}
    print(first == Pixel{a: U8{1}, b: 20, c: U8{3}})
    print(brightness(first))
    print(issue().id)
}
