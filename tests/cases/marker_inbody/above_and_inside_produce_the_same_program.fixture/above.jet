// The same program as inside.jet, with every marker written above.
#[Layout(c), Equatable, !Debug]
Pixel: struct {
    a: U8
    b: Int
    c: U8
}

#MustUse
Receipt: struct {
    id: Int
}

#[Inline, MustUse]
brightness: fn(pixel: Pixel) -> Int {
    pixel.b * 2
}

PIXEL_SIZE: #run { Pixel.reflect().layout.size ?? -1 }
PIXEL_C: #run { Pixel.reflect().layout.fields[2].offset ?? -1 }

issue: fn() -> Receipt { Receipt{id: 4} }

run: fn() {
    print("size {PIXEL_SIZE}, c at {PIXEL_C}")
    first: Pixel{a: U8{1}, b: 20, c: U8{3}}
    print(first == Pixel{a: U8{1}, b: 20, c: U8{3}})
    print(brightness(first))
    print(issue().id)
}
