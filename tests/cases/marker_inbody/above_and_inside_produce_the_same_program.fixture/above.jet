// The same program as inside.jet, with every marker written above.
#[Layout(c), Equatable, !Debug]
struct Pixel {
    a: U8
    b: Int
    c: U8
}

#MustUse
struct Receipt {
    id: Int
}

#[Inline, MustUse]
fn brightness(pixel: Pixel) -> Int {
    pixel.b * 2
}

PIXEL_SIZE :: comptime { Pixel.$layout.size ?? -1 }
PIXEL_C :: comptime { Pixel.$layout.fields[2].offset ?? -1 }

fn issue() -> Receipt { Receipt{id: 4} }

fn run() {
    print("size {PIXEL_SIZE}, c at {PIXEL_C}")
    first :: Pixel{a: U8{1}, b: 20, c: U8{3}}
    print(first == Pixel{a: U8{1}, b: 20, c: U8{3}})
    print(brightness(first))
    print(issue().id)
}
