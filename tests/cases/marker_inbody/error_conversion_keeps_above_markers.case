# The markers written above an error conversion `impl Target.From(Source)` are
# its impl's markers: one that an impl takes is accepted and the conversion
# runs, and one an impl does not take is refused at the Impl site.
fixture: error_conversion_keeps_above_markers.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run main.jet
exit: 0
stdout: = error_conversion_keeps_above_markers.out
step: jet check wrong_site.jet
exit: 1
stderr: ~ "`#Deprecated` cannot attach at the Impl site" # the above-written marker reaches the site check
