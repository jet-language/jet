// The same program as inside.jet, with each marker of an impl written inside
// a type body written above it.
Backend: trait {
    label: fn(self) -> String
}

Meters: struct {
    value: Int

    #Commutative
    impl Add(Int) {
        add: fn(self, other: Int) -> Meters { Meters{value: self.value + other} }
    }
}

LinuxBackend: struct {
    name: String

    #Target(OS.Linux)
    impl Backend {
        label: fn(self) -> String { "linux: {self.name}" }
    }
}

run: fn() {
    print((2 + Meters{value: 1}).value)
    print(LinuxBackend{name: "a"}.label())
}
