// The same program as above.jet, with each marker of an impl written inside
// a type body as a line of the impl's body.
Backend: trait {
    label: fn(self) -> String
}

Meters: struct {
    value: Int

    impl Add(Int) {
        #Commutative: true
        add: fn(self, other: Int) -> Meters { Meters{value: self.value + other} }
    }
}

LinuxBackend: struct {
    name: String

    impl Backend {
        label: fn(self) -> String { "linux: {self.name}" }
        #Target: OS.Linux
    }
}

run: fn() {
    print((2 + Meters{value: 1}).value)
    print(LinuxBackend{name: "a"}.label())
}
