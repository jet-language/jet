# Type facts from marker lines apply after the whole body: `#Layout :: c` as
# a struct's last line gives C layout (Loose, with no marker, is reordered),
# and `#MustUse :: true` as an enum's last line rejects a discarded value.
fixture: type_marker_facts_apply_from_the_last_line.fixture
env: NO_COLOR=1
step: jet run run.jet
exit: 0
stdout: = type_marker_facts_apply_from_the_last_line.out
step: jet check discard.jet
exit: 1
stderr: ~ "E0419" # the enum's last-line #MustUse rejects the discarded value
