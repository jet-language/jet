# #6035 c26: `jet status` renders its claims from receipts only. A claim
# appears once `jet test-compare` publishes its receipt, turns stale when the
# corpus changes, and is gone when the receipt is absent. The ledger never
# shows the changed corpus as proven.
fixture: status_shows_a_comparison_claim_only_while_its_receipt_is_current.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet status corpus.json --json
exit: 0
json: stdout doc $.claims = []
step: jet test-compare corpus.json
exit: 0
stdout: = "status=matched relation=typed_equality samples=1 reason=1 observed case(s) matched under typed_equality\n"
stderr: empty
file: .jet/receipts/objects is-dir
step: jet status corpus.json --json
exit: 0
json: stdout doc $.claims #= 1
json: stdout doc $.claims[0].claim = "test-compare"
json: stdout doc $.claims[0].state = "proven"
json: stdout doc $.claims[0].reason = "current receipt records success"
append: corpus.json "\n"
step: jet status corpus.json --json
exit: 0
json: stdout doc $.claims #= 1
json: stdout doc $.claims[0].state = "stale"
json: stdout doc $.claims[0].reason = "receipt input closure changed"
stdout: !~ "\"state\":\"proven\"" # the changed corpus is never shown as proven
remove: .jet/receipts
step: jet status corpus.json --json
exit: 0
json: stdout doc $.claims = []
