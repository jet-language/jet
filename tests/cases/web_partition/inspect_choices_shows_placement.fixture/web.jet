// `view` is pinned to JS, and nothing else places `count`, so its JS caller
// takes it into JS. `compute` is pinned to Wasm, and `run` stays in Wasm by
// default.
#Target(JS)
view: fn() -> Int {
    count()
}

count: fn() -> Int {
    2
}

#Target(Wasm)
compute: fn() -> Int {
    1
}

run: fn() {
    print("ok")
}
