#Export(wasm)
echo: fn(values: [String:I32]) -> [String:I32] { return values.copy() }

#Target(JS)
run: fn() {
    values: [String:I32]{"": 0, "low": I32.MIN, "high": I32.MAX, "emoji🌍": -7}
    back: echo(values)
    print(back.len())
    print(back["low"])
    print(back["high"])
    print(back["emoji🌍"])
    print(back[""])
}
