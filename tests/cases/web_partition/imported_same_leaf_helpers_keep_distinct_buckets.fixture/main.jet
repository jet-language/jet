#Target(Web)

left: module {
    #Target(JS)
    helper: fn() -> Int { return 1 }

    #Target(JS)
    value: fn() -> Int { return helper() }
}

right: module {
    helper: fn() -> Int { return 2 }

    #Export(wasm)
    value: fn() -> Int { return helper() }
}

#Target(JS)
run: fn() { print(left.value() + right.value()) }
