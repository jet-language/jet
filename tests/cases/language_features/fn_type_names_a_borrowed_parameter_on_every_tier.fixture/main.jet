// A function type marks a borrowed parameter as a declaration does:
// `fn(&Seeded) -> Unit` names a function that writes its argument in place.
// A value of that type is stored in a field and a list, passed and called,
// and each call changes the caller's value.
Seeded: struct { value: Int }

bump: fn(s: &Seeded) { s.value += 1 }

double: fn(s: &Seeded) { s.value *= 2 }

Holder: struct { step: fn(&Seeded) -> Unit }

apply: fn(f: fn(&Seeded) -> Unit, s: &Seeded) { f(s) }

run: fn() {
    s := Seeded{value: 1}
    holder: Holder{step: bump}
    apply(holder.step, s)
    print("field {s.value}")
    apply(double, s)
    print("passed {s.value}")
    steps: [fn(&Seeded) -> Unit]{bump, double}
    loop step in steps {
        step(s)
    }
    print("list {s.value}")
    holder.step(s)
    print("called {s.value}")
}
