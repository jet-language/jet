# `[T#N].filled(value)` builds a fixed array of N copies of one value, which
# is evaluated once (#6281 c131); `[Int?#3].filled(None)` runs the same on
# every tier and in the built binary.
fixture: fixed_array_filled_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "3\n-1 -1\n7 9 7\nmade once\njet jet\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "3\n-1 -1\n7 9 7\nmade once\njet jet\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "3\n-1 -1\n7 9 7\nmade once\njet jet\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "3\n-1 -1\n7 9 7\nmade once\njet jet\n"
