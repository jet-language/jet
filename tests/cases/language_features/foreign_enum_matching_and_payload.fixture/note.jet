NoteType: enum { User Feedback Project Reference }
Note: struct {
    name: String
    note_type: NoteType
    parent: String?
}

make_note: fn(name: &&String, t: &&NoteType) -> Note {
    return Note{name: name, note_type: t, parent: None}
}
kind_str: fn(n: Note) -> String {
    k: n.note_type.copy()
    if k == {
        .User -> { return "user" }
        .Feedback -> { return "feedback" }
        .Project -> { return "project" }
        .Reference -> { return "reference" }
    }
}
run: fn() { print("note") }
