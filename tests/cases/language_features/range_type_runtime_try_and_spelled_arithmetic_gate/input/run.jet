#Numeric Severity: distinct Int(0..10)

checked: fn(raw: Int) -> Severity String! {
    return Ok(Severity.from_int(raw))
}

pass_checked: fn(value: Severity String!) -> Severity String! { return value.copy() }
direct: fn() -> Severity { return Severity.from_u8(8) }

run: fn() {
    a: pass_checked(checked(4)) ?? panic("range")
    b: checked(6) ?? panic("range")
    widened: wrapping(a + b)
    print("{widened}")
    print(direct().raw())
}
