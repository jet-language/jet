# The optional and error-contract suffix spellings the Type.Option and
# Type.Result doc comments describe (#6281 c121) parse, check and run the
# same on every tier.
fixture: type_suffix_spellings_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --optimize=none main.jet
exit: 0
stdout: = "2 true true\n7\n0\nrefused\n1\n-1\n-2\n2\n"
step: jet run --optimize=basic main.jet
exit: 0
stdout: = "2 true true\n7\n0\nrefused\n1\n-1\n-2\n2\n"
step: jet run --optimize=full main.jet
exit: 0
stdout: = "2 true true\n7\n0\nrefused\n1\n-1\n-2\n2\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "2 true true\n7\n0\nrefused\n1\n-1\n-2\n2\n"
