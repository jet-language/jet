// `\q` is no escape of quoted text, so a function body that writes one is
// E0001 after the qualified, generic, list, map, optional and fallible
// return-type forms, exactly as after `-> String`.
#Error
Bad: enum {
    Broke
}

names: module {
    Text<T>: String
}

Holder: struct<T> {
    value: T
}

unknown_qualified: fn() -[IO]> names.Text<Int> { "\q41" }
unknown_generic: fn() -[IO]> Holder<String> { Holder<String>{value: "\q41"} }
unknown_list: fn() -[IO]> [String] { ["\q41"] }
unknown_map: fn() -[IO]> [String: String] { ["k": "\q41"] }
unknown_optional: fn() -[IO]> String? { Val("\q41") }
unknown_fallible: fn() -[IO]> String Bad! { Ok("\q41") }

run: fn() {
    print("other forms")
}
