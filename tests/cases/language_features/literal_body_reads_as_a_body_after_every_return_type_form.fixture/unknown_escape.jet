// `\u{…}` is no escape of quoted text, so a function body that is quoted
// text right after its return type's name is E0001 after every return-type
// form, with or without an effect row, exactly as after `-> String`. Text
// after `Name {` or `[U8] {` could also be a typed head's body, so the parser
// picks its reading and reports its E0001 once the file lexes.

unicode_plain: fn() -> String { "\u{41}" }
unicode_empty_row: fn() -[]> String { "\u{41}" }
unicode_one_effect: fn() -[IO]> String { "\u{41}" }
unicode_effects: fn() -[IO, FS]> String { "\u{41}" }
unicode_generic_fn: fn<T>(x: T) -[IO]> String { "\u{41}" }
unicode_bytes: fn() -[IO]> [U8] { "\u{41}".bytes() }

run: fn() {
    print(unicode_plain())
}
