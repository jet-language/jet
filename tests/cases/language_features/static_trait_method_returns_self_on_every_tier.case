# A static trait method declared `-> Self` is implemented per type and called
# through the type name (#6281 c15), and every tier prints the same.
fixture: static_trait_method_returns_self_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "7\nmade\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "7\nmade\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "7\nmade\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "7\nmade\n"
