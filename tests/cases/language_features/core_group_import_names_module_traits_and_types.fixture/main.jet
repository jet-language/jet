// `use core.[mem, target]` binds each Core module by its last name, as
// `use mem: core.mem` does: `mem.Allocator`, `mem.Region`, `target.Machine`
// and `target.MachineFacts` name that module's own traits and types, so an
// impl, a bound, a static call and a method call all reach them.
use core.[mem, target]

Stack: struct {
    region: mem.Region
    kept: [mem.Block]
}

impl Stack.mem.Allocator {
    allocate: fn(&self, size: Int, align: Int) -> mem.Block mem.AllocError! {
        Ok(self.region.claim(size, align) ?? return Err(mem.AllocError{requested_bytes: size, allocator: "Stack"}))
    }

    release: fn(&self, block: &&mem.Block) Never! { self.kept.push(block) }

    resize: fn(&self, block: &mem.Block, new_size: Int) -> Bool Never! { false }
}

Toy: struct {}

impl Toy.target.Machine {
    facts: target.MachineFacts{
        triple: "toy-none-elf",
        layout: target.MachineLayout{pointer_bits: 32, word_bits: 32, cache_line: 16, atomic_bits: 32},
        allocator: None,
        panic: None,
    }
}

// The bound names the module's trait, so the trait's member reads through it.
triple: fn<M: target.Machine>() -> String { M.facts.triple }

run: fn() {
    region: mem.Region.reserve(4096) ?? panic("reserve")
    print("region of {region.size()} bytes")
    stack := Stack{region: region, kept: [mem.Block]{}}
    block := stack.allocate(64, 16) ?? panic("allocate")
    print("block of {block.size()} bytes, resized: {stack.resize(block, 16)}")
    stack.release(block)
    print("{stack.kept.len()} block kept, {stack.region.remaining()} bytes left")
    print("toy is {triple<Toy>()}")
    print("toy denies {Toy.facts.row()}")
}
