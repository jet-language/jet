# `use core.[mem, target]` binds `mem` and `target` to those Core modules, as
# `use mem: core.mem` does: an impl of `mem.Allocator` and `target.Machine`,
# a `target.Machine` bound, the static `mem.Region.reserve` and the methods
# of `mem.Region`, `mem.Block` and `target.MachineFacts` all resolve, and the
# program runs the same on every tier.
fixture: core_group_import_names_module_traits_and_types.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = "region of 4096 bytes\nblock of 64 bytes, resized: false\n1 block kept, 4032 bytes left\ntoy is toy-none-elf\ntoy denies [!Net, !FS, !IO, !Time, !Rand, !Env, !Exec, !GPU, !FFI, !Browser, !Panic, !Mem.Alloc]\n"
step: jet run --optimize=basic main.jet
exit: 0
stdout: = "region of 4096 bytes\nblock of 64 bytes, resized: false\n1 block kept, 4032 bytes left\ntoy is toy-none-elf\ntoy denies [!Net, !FS, !IO, !Time, !Rand, !Env, !Exec, !GPU, !FFI, !Browser, !Panic, !Mem.Alloc]\n"
step: jet run --optimize=full main.jet
exit: 0
stdout: = "region of 4096 bytes\nblock of 64 bytes, resized: false\n1 block kept, 4032 bytes left\ntoy is toy-none-elf\ntoy denies [!Net, !FS, !IO, !Time, !Rand, !Env, !Exec, !GPU, !FFI, !Browser, !Panic, !Mem.Alloc]\n"
