# A dependency function whose parameter is typed through an aliased Core
# import (`use fp: core.files.path`, `dir: fp.Path`), called from a test that
# binds the Ok result with `?? panic`, checks and runs with no internal error
# under `jet test` and `jet run` on every tier (#6281 c33, was #6391).
fixture: aliased_import_parameter_type_runs_under_test_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet test -O0 main.jet
exit: 0
stdout: ~ "1 passed, 0 failed, 0 skipped" # the step prints it
step: jet test -O1 main.jet
exit: 0
stdout: ~ "1 passed, 0 failed, 0 skipped" # the step prints it
step: jet test -O2 main.jet
exit: 0
stdout: ~ "1 passed, 0 failed, 0 skipped" # the step prints it
step: jet run -O0 main.jet
exit: 0
stdout: = "/srv/a\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "/srv/a\n"
