mem: module {
    Allocator: trait {
        grant: fn(self, size: Int) -> Int
    }

    Bump: struct {
        used: Int
    }
}

impl mem.Bump.mem.Allocator {
    grant: fn(self, size: Int) -> Int { self.used + size }
}

reserve: fn<A: mem.Allocator>(arena: A, size: Int) -> Int { arena.grant(size) }

run: fn() {
    bump: mem.Bump{used: 8}
    print(reserve(bump, 4))
}
