// A binding of a struct holding an in-body Close value moves it; the old name
// is gone, so nothing reads the value after its one close.
Stream: struct {
    fd: Int

    impl Close {
        close: fn(&&self) { print("closed {self.fd}") }
    }
}

FileReader: struct {
    stream: Stream
}

keep: fn(r: FileReader) -> Int { r.stream.fd }

run: fn() {
    a: FileReader{stream: Stream{fd: 3}}
    b: a
    print(keep(b))
    print(a.stream.fd)
}
