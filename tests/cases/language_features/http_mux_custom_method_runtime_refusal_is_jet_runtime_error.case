# A run-time custom method meets core.http's one method token check when its mux registers it.
fixture: http_mux_custom_method_runtime_refusal_is_jet_runtime_error.fixture
step: jet build --profile=debug http_custom_method.jet
exit: 0
step: built
exit: nonzero
stdout: ~ "registered PURGE" # a run-time token that is not a standard method registers
stdout: !~ "unreachable" # the refused registration stops the program
stderr: ~ "Stop [E2808]: HTTP route method `GET` is refused: `GET` is a standard method, which registers with its own verb `get`." # the E2808 registry wording core.rt.__coded_stop renders
stderr: ~ "http_custom_method.jet:12" # the second `mux.custom` line
stderr: !~ "thread 'main' panicked" # a coded stop, not a panic
