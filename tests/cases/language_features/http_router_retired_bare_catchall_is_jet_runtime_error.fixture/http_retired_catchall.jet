use {
    http: core.http
    server: core.http.server
    env: core.sys
}
handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    return Ok(server.response(200, "ok"))
}
run: fn() {
    routes: server.mux()
    dynamic: env.get("JET_HTTP_TEST_MARKER") ?? "*"
    pattern: "/assets/{dynamic}"
    routes.get(pattern, handle)
}
