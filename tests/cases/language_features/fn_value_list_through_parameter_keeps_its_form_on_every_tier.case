# A list of function values passed to a parameter of the same written type
# keeps its functions' form. `[fn(Int) -> Int]{peek}` through
# `pick` used to SIGSEGV in pick.fn_widen: the parameter's element type was
# normalized to the failing form while the list held the non-failing one. A
# failing list (`[fn(Int) -> Int Err!]`) through a parameter that names that
# form calls and fails as written. A mismatched pair is E0638
# (tests/ui/nested_fn_failure_mismatch).
fixture: fn_value_list_through_parameter_keeps_its_form_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "v=269\nw=40\ne=-7\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "v=269\nw=40\ne=-7\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "v=269\nw=40\ne=-7\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "v=269\nw=40\ne=-7\n"
