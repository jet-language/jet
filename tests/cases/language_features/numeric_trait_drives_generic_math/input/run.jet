use {
    math: core.math
}

#Numeric Meters: distinct Float
#Numeric Count: distinct Int

Money: struct {
    cents: Int
    impl Add {
        add: fn(self, rhs: Money) -> Money { Money{cents: self.cents + rhs.cents} }
    }
    impl Sub {
        sub: fn(self, rhs: Money) -> Money { Money{cents: self.cents - rhs.cents} }
    }
    impl Mul {
        mul: fn(self, rhs: Money) -> Money { Money{cents: self.cents * rhs.cents} }
    }
    impl Comparable {
        compare: fn(self, rhs: Money) -> Ordering { self.cents <=> rhs.cents }
    }
    impl Numeric {
        zero: fn() -> Money { Money{cents: 0} }
        one: fn() -> Money { Money{cents: 1} }
    }
}

// One generic body serves every Numeric type: the bound admits `+`, `-`,
// `*` and ordering, because Numeric requires Add, Sub, Mul and Comparable.
double: fn<T: Numeric>(x: T) -> T { x + x }

total: fn<T: Numeric>(xs: [T]) -> T {
    sum := xs[0] - xs[0]
    loop x in xs -> sum = sum + x
    sum
}

run: fn() {
    a: Meters.from_float(3.0)
    b: Meters.from_float(-1.5)
    print(double(a).raw())
    print(double(Count.from_int(4)).raw())
    print(double(7))
    print(total([Meters.from_float(3.0), Meters.from_float(-1.5)]).raw())
    print(total([Count.from_int(2), Count.from_int(5)]).raw())
    print(total([Money{cents: 3}, Money{cents: 4}]).cents)
    // `#Numeric` implements Numeric, and Numeric requires Comparable, so the
    // prelude's max, min and clamp take a marker type.
    print(max(a, b).raw())
    print(min(Count.from_int(2), Count.from_int(5)).raw())
    print(clamp(Count.from_int(9), Count.from_int(0), Count.from_int(5)).raw())
    print(max(Money{cents: 3}, Money{cents: 4}).cents)
    // math.abs is one generic function over Numeric.
    print(math.abs(-4))
    print(math.abs(U8{9}))
    print(math.abs(Count.from_int(-4)).raw())
    print(math.abs(Money{cents: -7}).cents)
    print(math.abs(b).raw())
    print(math.abs(Float{-2.5}))
}
