step o2: jet run -O2 run.jet
exit: 0 # O2 runs the same program
stdout: = "6.0\n8\n14\n1.5\n7\n7\n3.0\n2\n5\n4\n4\n9\n4\n7\n1.5\n2.5\n" # same results at O2
