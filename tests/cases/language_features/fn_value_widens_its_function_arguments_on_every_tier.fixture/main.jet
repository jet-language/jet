Holder: struct<T> {
    reader: fn(T) -> Int
}

Direct: struct {
    apply: fn(fn(Int) -> Int) -> Int
}

// `value` is a function-typed parameter: it takes the implicit `Err` contract.
read_callback: fn(value: fn(Int) -> Int) -> Int { value(41) }

double: fn(x: Int) -> Int Never! { x * 2 }

run: fn() {
    step: 1
    holder: Holder<fn(Int) -> Int>{reader: read_callback}
    print(holder.reader(x -> x + step))
    direct: Direct{apply: read_callback}
    print(direct.apply(double))
}
