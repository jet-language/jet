# A local trait implemented through a module-qualified head
# (`impl labels.Tag.Mine`, `impl labels.inner.Mark.Mine`) is callable as a
# method and through a generic bound, the same on every tier (#6281 c24).
fixture: qualified_head_impl_method_runs_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --optimize=none main.jet
exit: 0
stdout: = "hi!\nlevel 3!\nhi!\nlevel 3!\n"
step: jet run --optimize=basic main.jet
exit: 0
stdout: = "hi!\nlevel 3!\nhi!\nlevel 3!\n"
step: jet run --optimize=full main.jet
exit: 0
stdout: = "hi!\nlevel 3!\nhi!\nlevel 3!\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "hi!\nlevel 3!\nhi!\nlevel 3!\n"
