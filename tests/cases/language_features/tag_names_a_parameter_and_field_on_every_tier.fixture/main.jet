// `tag` names a parameter or field like any other word, and a value reads it
// back by that name.
Label: struct {
    tag: String
}

greet: fn(tag: String) {
    print(tag)
}

shout: fn(tag: String) -> String {
    loud: tag.upper()
    "{loud} {tag.len()}"
}

run: fn() {
    greet("hi")
    print(shout("hey"))
    label: Label{tag: "ok"}
    print(label.tag)
}
