use json: core.encoding.json
run: fn() {
    raw: "{{\"port\":\"8080\",\"name\":\"api\"}}"
    data: json.decode(raw) ?? panic("bad json")
    if data == .Object(entries) {
        port: entries["port"]
        name: entries["name"]
        if port == .Int(n) {
            print(n + 1)
        }
        if name == .Text(s) {
            print(s)
        }
    }
}
