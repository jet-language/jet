// `[T#N].filled(value)` is N copies of one value, evaluated once.
make: fn() -> String {
    print("made once")
    "jet"
}

run: fn() {
    slots: [Int?#3].filled(None)
    print(slots.len())
    print("{slots[0] ?? -1} {slots[2] ?? -1}")
    counts := [Int#4].filled(7)
    counts[1] = 9
    print("{counts[0]} {counts[1]} {counts[3]}")
    names: [String#2].filled(make())
    print("{names[0]} {names[1]}")
}
