# A `#Pre` condition an interval fact proves has no runtime check; the same
# clause without the proof keeps it. source0 calls `checked(1)` with a plain
# Int parameter, so `value > 0` is checked at the call site: the slot IR runs
# the comparison and holds the contract stop (jet_rt_require_stop, ordinal 3).
# source1 takes `Positive: distinct Int(1..10)`, whose range proves
# `value.raw() > 0`, so the call site emits neither. O0 compiles the
# `jet emit --ir` slots unchanged; both programs print 1 on every tier.
fixture: contract_interval_proof_erases_only_the_runtime_check.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet emit --ir source0.jet --fn run
exit: 0
stdout: ~ "local contract_arg_" # the argument is bound for the clause
stdout: ~ ": gt s" # the unproved `value > 0` is compared at run time
stdout: ~ "jet_rt_require_stop" # and a failed comparison stops
step: jet emit --ir source1.jet --fn run
exit: 0
stdout: !~ ": gt s" # the proved `value.raw() > 0` is not compared
stdout: !~ "jet_rt_require_stop" # and no contract stop is emitted
step: jet run -O0 source0.jet
exit: 0
stdout: = "1\n"
step: jet run -O0 source1.jet
exit: 0
stdout: = "1\n"
step: jet run -O2 source0.jet
exit: 0
stdout: = "1\n"
step: jet run -O2 source1.jet
exit: 0
stdout: = "1\n"
