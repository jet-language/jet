# An empty `T{}` parameter or field default is the empty value of `T`, as the
# same `T{}` is in an expression, and every tier prints the same.
fixture: empty_typed_default_is_the_empty_value_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "0 3\n0 2\n0 1\nr 0 0\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "0 3\n0 2\n0 1\nr 0 0\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "0 3\n0 2\n0 1\nr 0 0\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "0 3\n0 2\n0 1\nr 0 0\n"
