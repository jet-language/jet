# An early `return` in a braced sort comparator exits the comparator, not the
# enclosing function (ports sort_comparator_early_return_is_local_to_lambda,
# #6281 c7); every tier prints the same. The generic `map` form is
# core_and_closures/return_in_a_braced_callback_leaves_the_callback_on_every_tier.
fixture: lambda_early_return_is_local_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "1 1 2 3\n7 8 9\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "1 1 2 3\n7 8 9\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "1 1 2 3\n7 8 9\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "1 1 2 3\n7 8 9\n"
