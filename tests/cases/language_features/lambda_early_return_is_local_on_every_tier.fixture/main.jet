// Ports sort_comparator_early_return_is_local_to_lambda (#6281 c7, from
// #6252): an early `return` inside a braced comparator exits the comparator,
// not the Unit function around it, so it is checked against the comparator's
// `Ordering` result.
sorted: fn(values: [Int]) -> [Int] {
    out := values.copy()
    out.sort_by((left: Int, right: Int) -> {
        order: left <=> right
        if order != Ordering.Equal -> return order
        right <=> left
    })
    out
}

run: fn() {
    values := [2, 1, 3, 1]
    values.sort_by((left: Int, right: Int) -> {
        order: left <=> right
        if order != Ordering.Equal -> return order
        right <=> left
    })
    print("{values[0]} {values[1]} {values[2]} {values[3]}")
    again: sorted([9, 7, 8])
    print("{again[0]} {again[1]} {again[2]}")
}
