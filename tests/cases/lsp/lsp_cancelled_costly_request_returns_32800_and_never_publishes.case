session lsp content-length: jet self lsp
send lsp: messages/lsp_cancelled_costly_request_returns_32800_and_never_publishes/0.json
recv lsp until $.id = 1
send lsp: messages/lsp_cancelled_costly_request_returns_32800_and_never_publishes/1.json
recv lsp
stdout: ~ "publishDiagnostics" # original predicate; unrelated metadata varies
stdout: ~ "\"version\":1" # original predicate; unrelated metadata varies
send lsp: messages/lsp_cancelled_costly_request_returns_32800_and_never_publishes/2.json
