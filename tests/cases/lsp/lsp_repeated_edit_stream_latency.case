send lsp: "{\"jsonrpc\":\"2.0\",\"id\":1200,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/lsp_repeated_edit_stream.jet\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":5200,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/lsp_repeated_edit_stream.jet\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":5200}}"
recv lsp collect until ndjson $[?id in [1200,5200]] #>= 2
capture: frames-200 = text stdout
write: frames-200.ndjson = "{cap:frames-200}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{}}"
recv lsp until $.id = 99
close lsp
exit: 0
step: jet test claims
env: S5_FRAMES_ROOT={work}
