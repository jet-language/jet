{
  "description": "semantic tokens returns a non-empty data array",
  "source": "fn main() {\n    x: Int :: 1\n}\n",
  "steps": [
    {
      "send": {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}},
      "expect_contains": ["semanticTokensProvider"]
    },
    {
      "send": {"jsonrpc":"2.0","method":"initialized","params":{}},
      "expect_notification": null
    },
    {
      "open": {"uri": "file:///tmp/lsp_semtok_test.jet"},
      "expect_notification": "publishDiagnostics"
    },
    {
      "send": {"jsonrpc":"2.0","id":2,"method":"textDocument/semanticTokens/full","params":{"textDocument":{"uri":"file:///tmp/lsp_semtok_test.jet"}}},
      "expect_contains": ["data"]
    },
    {
      "send": {"jsonrpc":"2.0","id":99,"method":"shutdown","params":{}},
      "expect_contains": ["result"]
    }
  ]
}
