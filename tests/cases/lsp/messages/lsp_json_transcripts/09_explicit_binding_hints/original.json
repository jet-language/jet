{
  "description": "inlay hints use : Type for inferred immutable and mutable bindings",
  "source": "fn main() {\n    x :: 42\n    count := 0\n}\n",
  "steps": [
    {
      "send": {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}},
      "expect_contains": ["inlayHintProvider"]
    },
    {
      "send": {"jsonrpc":"2.0","method":"initialized","params":{}},
      "expect_notification": null
    },
    {
      "open": {"uri": "file:///tmp/lsp_explicit_binding_test.jet"},
      "expect_notification": "publishDiagnostics"
    },
    {
      "send": {"jsonrpc":"2.0","id":2,"method":"textDocument/inlayHint","params":{"textDocument":{"uri":"file:///tmp/lsp_explicit_binding_test.jet"},"range":{"start":{"line":0,"character":0},"end":{"line":10,"character":0}}}},
      "expect_contains": [": Int"]
    },
    {
      "send": {"jsonrpc":"2.0","id":3,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///tmp/lsp_explicit_binding_test.jet"},"position":{"line":1,"character":5}}},
      "expect_contains": [": Int", "immutable"]
    },
    {
      "send": {"jsonrpc":"2.0","id":4,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///tmp/lsp_explicit_binding_test.jet"},"position":{"line":2,"character":5}}},
      "expect_contains": [": Int", "mutable"]
    },
    {
      "send": {"jsonrpc":"2.0","id":99,"method":"shutdown","params":{}},
      "expect_contains": ["result"]
    }
  ]
}
