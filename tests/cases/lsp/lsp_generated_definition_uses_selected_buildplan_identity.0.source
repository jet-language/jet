build: fn(b: Build) {
    b.generate("right") {
        generated_value: fn() -> String { "right" }
    }
    b.generate("left") {
        generated_value: fn() -> String { "left" }
    }
    app: b.add_executable("app", ["main.jet", ".jet/generated/main/left.jet"], [])
    b.default(app)
}
run: fn() {
    generated_value()
}
