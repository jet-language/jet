# A type declared in an inline module is lifted to a file-level type with a
# compiler-owned name. The tools spell it as the diagnostics do, by its ledger
# path: `jet check --json` reports the same `geo.Point` and `ui.Point` text
# as the terminal, `jet inspect semindex --json` names the type `geo.Point`
# with leaf `Point` in every field, `jet project parts` names each inline
# module by its path (`main.geo`), and a hover on the declaration shows
# `geo.Point`, its derived methods' signatures included. The generated names
# never show.
fixture: lsp_hover_and_json_spell_an_inline_module_type_by_its_path.fixture
env: NO_COLOR=1
step: jet check --json mismatch.jet
exit: 1
stdout: ~ "wants `geo.Point` for argument 1, but this is `ui.Point`" # the path, since both modules declare a Point
stdout: !~ "M3GeoPoint" # no generated name
stdout: !~ "M2UiPoint" # no generated name
step: jet inspect semindex --json main.jet
exit: 0
stdout: ~ "\"name\":\"geo.Point\",\"leaf_name\":\"Point\"" # the type's definition
stdout: ~ "equal: fn(rhs: geo.Point) -> Bool" # a derived method's contract
stdout: !~ "M3GeoPoint" # no generated name in any field
step: jet project parts --json
exit: 1
stdout: ~ "\"name\":\"main.geo\"" # each inline module by its ledger path
stdout: ~ "\"name\":\"mismatch.geo\"" # the other file's `geo`
stdout: ~ "\"name\":\"mismatch.ui\"" # and its `ui`
stdout: ~ "\"modules\":[\"main.geo\",\"mismatch.geo\"]" # two files declare `geo`, so each is named by its path
stdout: !~ "project." # no name outside the ledger's spelling
session lsp content-length: jet self lsp
stderr: null
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
recv lsp until $.id = 1
send lsp: "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\",\"languageId\":\"jet\",\"version\":1,\"text\":\"geo: module {\\n    Point: struct {\\n        x: Int\\n    }\\n}\\n\\nrun: fn() { print(geo.Point{x: 1}.x) }\\n\"}}}"
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file://{work}/main.jet\"},\"position\":{\"line\":1,\"character\":5}}}"
recv lsp until $.id = 2
stdout: ~ "geo.Point: struct { x: Int }" # the declaration by its path
stdout: ~ "equal: fn(rhs: geo.Point) -> Bool" # a derived method's signature spells it the same way
stdout: !~ "M3GeoPoint" # no generated name
send lsp: "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\",\"params\":{}}"
recv lsp until $.id = 3
close lsp
exit: any # the server's status after shutdown is not what this case shows
