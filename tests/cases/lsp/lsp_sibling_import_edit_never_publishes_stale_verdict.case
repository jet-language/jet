send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/3.json
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/4.json
recv lsp collect until ndjson $[?id=2] #>= 1
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"] #= 1 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"][0].params.diagnostics[?severity=1] #= 0 # original predicate
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/5.json
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/6.json
recv lsp collect until ndjson $[?id=3] #>= 1
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"] #= 1 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"][0].params.diagnostics[?severity=1] #>= 1 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/other.jet"] #= 0 # original predicate
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/7.json
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/8.json
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/9.json
recv lsp collect until ndjson $[?id=4] #>= 1
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"] #= 1 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/run.jet"][0].params.diagnostics[?severity=1] #= 0 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/helper.jet"][?params.version!=4] #= 0 # original predicate
json: stdout ndjson $[?method="textDocument/publishDiagnostics"][?params.uri="file://{work}/other.jet"] #= 0 # original predicate
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/10.json
