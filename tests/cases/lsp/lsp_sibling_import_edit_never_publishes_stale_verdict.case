# Port of tests/lsp.rs:3370-3462; original source bytes/order/assertions.
# The Rust fixture's `package.jet` is dropped: package files now share one
# namespace and refuse `use "helper"` (E0623), so the files are loose and the
# file import stays the edge this case follows. A collection is NDJSON, so each
# collecting `recv` waits for its response with `ndjson $[?id=N] #>= 1`, and a
# filter selects frames (`[?params.uri=…]`); `[0]` is the Rust `main_*[0]`.
# PENDING-SEAM(read_bytes): Main ballot + CoreState2 + kit batch three.
# PENDING-GRAMMAR: collection, negated JSON filters, capture/write and named-stream equality.
fixture: fixtures/lsp_sibling_import_edit_never_publishes_stale_verdict
session lsp content-length: jet self lsp
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/0.json
recv lsp until $.id = 1
send lsp: messages/lsp_sibling_import_edit_never_publishes_stale_verdict/1.json
