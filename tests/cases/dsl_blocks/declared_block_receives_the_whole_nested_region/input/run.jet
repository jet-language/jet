
IncompleteBlock: struct {
    impl Diagnostic {
        code: "E0927"
        what: fn(self) -> String { "the complete block text is required" }
        why: fn(self) -> String { "the checker reads one lexical region" }
        fix: fn(self) -> String { "keep the trailing statement inside the block" }
    }
}

Check: struct {
    impl Marker {
        sites: [.Block]

        expand: fn(self, target: Target) {
            if !target.contains("after") {
                reject(IncompleteBlock{})
            }
        }
    }
}

run: fn() {
    #Check {
        if true {
            print("inside")
        }
        print("after")
    }
}
