Producer: trait {
    produce: fn(self) -> Int Never!
}
CanonicalProducer: struct { values: [Int] }
impl CanonicalProducer.Producer {
    produce: fn(self) -> Int Never! { self.values[0] }
}
Preparation: enum { Prepared(producer: CanonicalProducer) }
Host: struct { parent: Int }

admit: fn(parent: &Int, producer: Producer) -> Int Never! {
    parent + producer.produce()
}
attach: fn(host: &Host, prepared: Preparation) -> Int Never! {
    if prepared == .Prepared(producer) {
        return admit(host.parent, producer)
    }
    0
}
run: fn() {
    host := Host{parent: 10}
    prepared: Preparation.Prepared{producer: CanonicalProducer{values: [Int]{7}}}
    print(attach(host, prepared))
    print(attach(host, prepared))
    print(host.parent)
}
