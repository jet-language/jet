fn erased() -> Int {
    items :: [17, 23]
    if false {
        mapped :: loop item in items -> item + 1
        return mapped[0]
    }
    items[0]
}

fn active(flag: Bool) -> Int {
    items :: [17, 23]
    if flag {
        mapped :: loop item in items -> item + 1
        return mapped[1]
    }
    items[0]
}

fn run() {
    print(erased())
    print(active(true))
    print(active(false))
}
