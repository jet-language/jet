
#Layout(c)
TargetPointer: struct { pointer: *Int }
POINTER_BYTES: comptime { pointer_bytes() }
pointer_bytes: fn() -> Int Never! {
    layout: TargetPointer.$layout
    layout.size ?? panic("target pointer layout is missing")
}
run: fn() {
    print(POINTER_BYTES == comptime { TargetPointer.$layout.size ?? 0 })
}
