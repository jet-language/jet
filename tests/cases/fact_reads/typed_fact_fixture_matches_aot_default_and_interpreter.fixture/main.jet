// D-FACT-READ1=A: every compiler-held plane uses one typed `@` read.
#Numeric
Severity :: distinct Int(0..10)

#UnitFamily(Length, dimension) { meter }

tag Audited { deny: [Net] }

struct PlaneFacts {
    approximate: F32
    shape: [Int#4]
    classified: #Audited Int
    callable: fn(value: Int, *, label: Bool) -> Int
}

struct Order {
    state { Draft, Confirmed }

    id: Int
}

fn send_report() {}

fn sendability_for(cell: Cell<Int>) -> Bool {
    known :: comptime { cell.$sendability.known }
    return known
}

RANGE :: comptime { Severity.$range }

EFFECTS :: comptime { send_report.$effects }

STATES :: comptime { Order.$states }

DIMENSION :: comptime { Meter.$dimension }

MEASURE :: comptime { PlaneFacts.$measure }

EXACTNESS :: comptime { PlaneFacts.$exactness }

CLASSIFICATION :: comptime { PlaneFacts.$classification }

OBLIGATION :: comptime { PlaneFacts.$obligation }

PACKAGE_NAME :: comptime { $package.name }

PACKAGE_VERSION :: comptime { $package.version }

OS :: comptime { $build.os }

PROFILE :: comptime { $build.profile }

SENDABILITY :: comptime { Severity.$sendability }

MOVEDNESS :: comptime { Severity.$movedness }

ATTRIBUTION :: comptime { report.$attribution }

ORIGIN :: comptime { Severity.$origin }

VIEW_PROVENANCE :: comptime { send_report.$view_provenance }

UNIT_SCALE :: comptime { Meter.$unit_scale_provenance }

MATURITY :: comptime { send_report.$maturity }

fn run() {
    print(RANGE.start)
    print(EFFECTS.values.len())
    print(STATES[0].name)
    print(DIMENSION.axes.len())
    print(MEASURE.kind == "length")
    print(EXACTNESS.kind == .Approximate)
    print(CLASSIFICATION.name)
    print(OBLIGATION.param_contract[0].zone == .Either)
    print(PACKAGE_NAME)
    print(PACKAGE_VERSION)
    print(PROFILE)
    print(SENDABILITY.known)
    print(MOVEDNESS.known)
    print(ATTRIBUTION.source)
    print(ORIGIN.tracked)
    print(VIEW_PROVENANCE.mutable)
    cell :: Cell.new(1)
    print(sendability_for(cell))
}
