# A primitive's `$layout` read at run time is E0302, and the fix it suggests,
# `FACT: comptime { I32.$layout }`, compiles and reads the layout on O0, O1
# and O2. Inside comptime the primitive's name resolves (no E0107).
fixture: primitive_layout_fact_fix_compiles_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step runtime: jet check runtime/main.jet
exit: 1 # the fact read is compile-time only
stderr: ~ "Error [jet.UnknownField]: Fact read `$layout` is compile-time only" # E0302 at the run-time read
stderr: ~ "Fix: Write `FACT: comptime { I32.$layout }`, then use `FACT` in this expression" # the fix the o0 to o2 steps compile
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = primitive_layout_fact_fix_compiles_on_every_tier.stdout.expected
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = primitive_layout_fact_fix_compiles_on_every_tier.stdout.expected
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = primitive_layout_fact_fix_compiles_on_every_tier.stdout.expected
stderr: empty
