# A value of a trait that declares no method prints and interpolates as its
# concrete value, at the top level and inside a list, on every tier: an empty
# implementation still makes its owner one of the trait's implementers.
fixture: empty_trait_value_prints.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = empty_trait_value_prints.out
step: jet run -O1 main.jet
exit: 0
stdout: = empty_trait_value_prints.out
step: jet run -O2 main.jet
exit: 0
stdout: = empty_trait_value_prints.out
