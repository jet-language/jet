#Import(c) c_getpid: fn() -> I32 = "getpid"

names: fn(count: Int) -> [String] {
    out := [String]{}
    loop k in 0..<count -> &out.push("name {k}")
    out
}

run: fn() {
    first: names(3)
    second: first.copy()
    pid: c_getpid()
    zero: I32{0}
    if pid > zero -> print(first.len() + second.len())
}
