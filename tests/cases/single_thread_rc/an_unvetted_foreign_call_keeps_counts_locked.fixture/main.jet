#Import(c) fn c_getpid() -> I32 = "getpid"

fn names(count: Int) -> [String] {
    out := [String]{}
    loop k in 0..<count -> &out.push("name {k}")
    out
}

fn run() {
    first :: names(3)
    second :: first.copy()
    pid :: c_getpid()
    zero :: I32{0}
    if pid > zero -> print(first.len() + second.len())
}
