# Card #6477: a foreign call of a vetted libc leaf (`labs` starts no thread,
# installs no handler and calls nothing back) keeps the program single-threaded,
# so its inline reference counts stay unlocked.
fixture: a_vetted_libc_leaf_call_keeps_counts_unlocked.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --release main.jet
exit: 0
step native: built
exit: 0
stdout: = "6\n"
when arch x86_64
when tool objdump
step: objdump -d --no-show-raw-insn --disassemble=main_run .jet/build/main
exit: 0
stdout: ~ "incq" # card #6477: the entry body retains its strings and lists inline
stdout: !~ "lock " # card #6477: a vetted libc leaf cannot start a second thread
end when
end when
