
#Error
PatternError: enum { Rejected }

Pattern: distinct String

impl Pattern.CheckedText {
    Error: PatternError

    check: fn(text: String) PatternError! -[]> {
        if text == "bad" { return Err(PatternError.Rejected) }
        return Ok()
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return ""
    }
}

impl PatternError -> Err {
    return Err("pattern rejected", code: "E_PATTERN", cause: Err("invalid shape"))
}

parse: fn(text: String) -[]> Pattern {
    pattern: Pattern.from(text)
    return Ok(pattern)
}

load: fn(text: String) -[]> Pattern {
    pattern: parse(text)?("loading pattern")
    return Ok(pattern)
}

run: fn() {
    _: load("bad")
}
