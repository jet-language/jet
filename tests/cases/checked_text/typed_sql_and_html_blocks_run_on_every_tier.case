# Typed SQL and HTML heads inside a declared `#SQL(User)` owner block run the same on
# every execution tier: SQL holes bind in order as parameters, HTML holes escape, an `HTML` hole
# composes without a second escape, and `.raw` keeps its text. The source is `jet fmt` stable.
fixture: typed_sql_and_html_blocks_run_on_every_tier.fixture
step: jet fmt --check main.jet
exit: 0
step default: jet run main.jet
exit: 0
stdout: = "select id, name from users where id = ? and active = ? and name = ?\n3\n<p>&lt;Ada &amp; co&gt;</p>\n<div><b>&lt;Ada &amp; co&gt;</b></div>\nselect 1\n<hr>\n"
step o0: jet run -O0 main.jet
exit: 0
stdout: == default
step o1: jet run -O1 main.jet
exit: 0
stdout: == default
step o2: jet run -O2 main.jet
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
