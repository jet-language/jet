// Each literal is built by its Core CheckedText impl, inside a function
// whose failure contract is `Never!`: the literal adds no failure route.
sql_text: fn(user: String) -> String Never! {
    query: SQL{"SELECT * FROM t WHERE u = {user}"}
    query.template()
}

html_text: fn(user: String) -> String Never! {
    page: HTML{"<b>{user}</b>"}
    page.text()
}

sh_text: fn(user: String) -> String Never! {
    command: Sh{"echo {user}"}
    "{command}"
}

url_text: fn(page: String) -> String Never! {
    address: URL{"https://example.com/{page}"}
    "{address}"
}

path_text: fn(name: String) -> String Never! {
    file: Path{"logs/{name}.txt"}
    "{file}"
}

date_text: fn() -> String Never! {
    moment: DateTime{"2026-08-07T12:00:00Z"}
    "{moment}"
}

run: fn() {
    print(sql_text("a"))
    print(html_text("b"))
    print(sh_text("c"))
    print(url_text("d"))
    print(path_text("e"))
    print(date_text())
}
