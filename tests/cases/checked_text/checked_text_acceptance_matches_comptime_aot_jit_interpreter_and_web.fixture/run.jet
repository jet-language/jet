
#Error
TextError: enum { Bad }

Pattern: distinct String

impl Pattern.CheckedText {
    Error: TextError

    check: fn(text: String) TextError! -[]> {
        if text == "hello [1]" || text == "ok" { return Ok() }
        return Err(TextError.Bad)
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return "[1]"
    }
}

accepts: fn(text: String) -[]> Bool {
    return Pattern.from(text) ? _value -> true ! _error -> false
}

COMPTIME_GOOD: comptime { accepts("ok") }
COMPTIME_BAD: comptime { accepts("") }

run: fn() {
    literal: Pattern{"hello {1}"}
    print(literal.raw())

    Pattern.from("ok") ? value -> print(value.raw()) ! _error -> print("good rejected")

    Pattern.from("") ? _value -> print("bad accepted") ! _error -> print("bad rejected")

    runtime_good: accepts("ok")
    runtime_bad: accepts("")
    print("{COMPTIME_GOOD}")
    print("{COMPTIME_BAD}")
    print("{runtime_good}")
    print("{runtime_bad}")
}
