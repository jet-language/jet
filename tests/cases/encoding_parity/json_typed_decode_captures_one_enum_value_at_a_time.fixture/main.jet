// Records whose enum field is read as a captured value, at 1x, 2x and 4x
// 100,000 records. A capture holds only the enum value under the cursor, so
// decoding a document is one pass over it: work grows with the record count.
use json: core.encoding.json

#Codable
Kind: enum {
    Plain
    Level(depth: Int)
}

#Codable
Record: struct {
    id: Int
    kind: Kind
    name: String
}

document: fn(count: Int) -> String {
    parts := [String]{}
    loop i in 0..<count {
        kind: if i % 2 == 0 -> "\"Plain\"" else -> "{{\"Level\":{{\"depth\":{i % 7}}}}}"
        parts.push("{{\"id\":{i},\"kind\":{kind},\"name\":\"r{i}\"}}")
    }
    "[{parts.join(",")}]"
}

run: fn() [FieldError]! {
    loop scale in [1, 2, 4] {
        count: 100000 * scale
        records: json.decode<[Record]>(document(count))
        depth := 0
        plain := 0
        loop record in records {
            if record.kind == .Level(level) -> depth += level
            if record.kind == .Plain -> plain += 1
        }
        print("{scale}x: {records.len()} records, {plain} plain, depth {depth}, last {records[records.len() - 1].name}")
    }
}
