# #6082: typed JSON decode reads the document in place through the parser
# cursor (json.__decode_typed over __Decoding.read) instead of building a Dyn
# tree first. Each input in main.jet decodes through json.decode<T> and
# through its parsed tree; the .out was captured from the compiler before the
# cursor, when json.decode<T> decoded a tree. Values, every FieldError path and
# reason (missing, unknown, wrong type, wrong shape, enum, distinct, generic,
# Option, Map, nested List) and every parse error with its line match on O0,
# O1, O2, the binary, the web build and jet eval.
requires: tool:node
fixture: json_typed_decode_reads_in_place_and_matches_the_tree_decode.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
step: jet build --optimize=full main.jet
exit: 0
step: .jet/build/main
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
step: jet build --target web main.jet
exit: 0
step: node .jet/build/app.js
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
step: jet eval main.jet
exit: 0
stdout: = json_typed_decode_reads_in_place_and_matches_the_tree_decode.out
