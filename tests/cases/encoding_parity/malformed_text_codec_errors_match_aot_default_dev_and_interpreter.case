# tests/encoding_parity.rs::malformed_text_codec_errors_match_aot_default_dev_and_interpreter
# The expected reasons are Core's own codec messages, identical on AOT,
# default dev run and the interpreter.
env: NO_COLOR=1
fixture: malformed_text_codec_errors_match_aot_default_dev_and_interpreter.fixture
capture: source = text file.replace("@DIR@", "{work}/probe") probe/source.template
write: probe/run.jet = "{cap:source}"
step: jet build probe/run.jet
exit: 0
step probe_aot: built
cwd: probe
exit: 0
stdout: = "2|object keys must be strings\n|invalid JSON (line 2): object keys must be strings\nexpected a value\nYAML map entry needs ':'\n"
step probe_dev: jet run probe/run.jet
stdin: null
exit: == probe_aot
stdout: == probe_aot
stderr: == probe_aot
