# Typed `json.decode<T>` is exact. A JSON string is refused for an
# Int, Float or Bool field with the FieldError naming the field and the JSON
# type, while the matching JSON number or literal still decodes; every tier
# prints the same lines.
fixture: json_typed_decode_refuses_text_for_a_scalar_field_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = json_typed_decode_refuses_text_for_a_scalar_field_on_every_tier.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = json_typed_decode_refuses_text_for_a_scalar_field_on_every_tier.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = json_typed_decode_refuses_text_for_a_scalar_field_on_every_tier.1.out
stderr: = ""
