
use json: core.encoding.json
Token: struct {
    raw: String

    impl Encode {
        encode: fn(self) -> Dyn { Dyn.Text("wire") }
    }
}
token: fn() -> Token? { Val(Token{raw: "raw"}) }
empty: fn() -> Token? { None }
run: fn() {
    print(json.to_string([Token{raw: "raw"}]))
    print(json.to_string(token()))
    print(json.to_string(empty()))
    tokens := [String:Token]{}
    tokens["a"] = Token{raw: "raw"}
    print(json.to_string(tokens))
}
