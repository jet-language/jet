
use {
    json: core.encoding.json
    toml: core.encoding.toml
}

run: fn() {
    open256: "[".repeat(256)
    close256: "]".repeat(256)
    if json.parse("{open256}{close256}") == {
        .Ok(_value) -> { print("json256:accepted") }
        .Err(error) -> { print("json256:{error.line}:{error.reason}") }
    }

    open257: "[".repeat(257)
    close257: "]".repeat(257)
    if json.parse("{open257}{close257}") == {
        .Ok(_value) -> { print("json257:accepted") }
        .Err(error) -> { print("json257:{error.line}:{error.reason}") }
    }

    if toml.parse("value = {open256}{close256}") == {
        .Ok(_value) -> { print("toml256:accepted") }
        .Err(error) -> { print("toml256:{error.line}:{error.reason}") }
    }

    if toml.parse("value = {open257}{close257}") == {
        .Ok(_value) -> { print("toml257:accepted") }
        .Err(error) -> { print("toml257:{error.line}:{error.reason}") }
    }
}
