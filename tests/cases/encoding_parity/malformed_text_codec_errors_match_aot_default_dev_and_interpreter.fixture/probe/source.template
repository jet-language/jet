
use {
    json: core.encoding.json
    toml: core.encoding.toml
    yaml: core.encoding.yaml
}

#Codable
Row: struct {
    value: Int
}

json_parse_error: fn() -[]> String {
    if json.parse("\n{{oops") == {
        .Ok(_value) -> return "accepted"
        .Err(error) -> return "{error.line}|{error.reason}"
    }
}

json_decode_error: fn() -[]> String {
    if json.decode<Row>("\n{{oops") == {
        .Ok(_value) -> return "accepted"
        .Err(errors) -> return "{errors[0].path}|{errors[0].reason}"
    }
}

toml_parse_error: fn() -[]> String {
    if toml.parse("value = ") == {
        .Ok(_value) -> return "accepted"
        .Err(error) -> return error.reason
    }
}

yaml_parse_error: fn() -[]> String {
    if yaml.parse("key: value\nbad") == {
        .Ok(_value) -> return "accepted"
        .Err(error) -> return error.reason
    }
}

run: fn() {
    print(json_parse_error())
    print(json_decode_error())
    print(toml_parse_error())
    print(yaml_parse_error())
}
