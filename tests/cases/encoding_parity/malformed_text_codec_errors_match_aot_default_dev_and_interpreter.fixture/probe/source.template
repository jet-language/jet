
use {
    json: core.encoding.json
    toml: core.encoding.toml
    yaml: core.encoding.yaml
}

#Codable
Row: struct {
    value: Int
}

json_parse_error: fn() -[]> String {
    json.parse("\n{{oops") ? _value -> return "accepted" ! error -> return "{error.line}|{error.reason}"
}

json_decode_error: fn() -[]> String {
    json.decode<Row>("\n{{oops") ? _value -> return "accepted" ! errors -> return "{errors[0].path}|{errors[0].reason}"
}

toml_parse_error: fn() -[]> String {
    toml.parse("value = ") ? _value -> return "accepted" ! error -> return error.reason
}

yaml_parse_error: fn() -[]> String {
    yaml.parse("key: value\nbad") ? _value -> return "accepted" ! error -> return error.reason
}

run: fn() {
    print(json_parse_error())
    print(json_decode_error())
    print(toml_parse_error())
    print(yaml_parse_error())
}
