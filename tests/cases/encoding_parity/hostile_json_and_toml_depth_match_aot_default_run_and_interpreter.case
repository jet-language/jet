env: NO_COLOR=1
fixture: hostile_json_and_toml_depth_match_aot_default_run_and_interpreter.fixture
capture: source = text file.replace("@DIR@", "{work}/probe") probe/source.template
write: probe/run.jet = "{cap:source}"
step: jet build probe/run.jet
exit: 0
step probe_aot: built
cwd: probe
exit: 0
stdout: = "json64:accepted\njson65:1:JSON value is nested too deeply\ntoml64:accepted\ntoml65:1:TOML value is nested too deeply\n"
stderr: empty
step probe_dev: jet run probe/run.jet
stdin: null
exit: == probe_aot
stdout: == probe_aot
stderr: == probe_aot
step: jet run --interpret probe/run.jet
stdin: null
exit: == probe_aot
stdout: == probe_aot
