env: NO_COLOR=1
fixture: serde_examples_match_aot_default_run_and_interpreter.fixture
mkdir: encoding_breadth
copy: {root}/Examples/features/serde/encoding_breadth.jet encoding_breadth/run.jet
file: {root}/Examples/features/expected/serde/encoding_breadth.out = "{\"a\":1,\"b\":2}\ntrue\n2\ntrue\n<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>\ntrue\n{\"a\":1,\"b\":2}\naGk\n2\nNBUQ====\n2\n"
step: jet build encoding_breadth/run.jet
exit: 0
step encoding_breadth_aot: built
cwd: encoding_breadth
exit: 0
stdout: = "{\"a\":1,\"b\":2}\ntrue\n2\ntrue\n<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>\ntrue\n{\"a\":1,\"b\":2}\naGk\n2\nNBUQ====\n2\n"
stderr: empty
step encoding_breadth_dev: jet run encoding_breadth/run.jet
stdin: null
exit: == encoding_breadth_aot
stdout: == encoding_breadth_aot
stderr: == encoding_breadth_aot
