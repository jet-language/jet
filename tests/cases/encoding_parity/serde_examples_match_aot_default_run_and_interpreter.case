# tests/encoding_parity.rs::serde_examples_match_aot_default_run_and_interpreter
# Original source bytes and assertions; PENDING-SAME-HEAD, runtime UNRUN.
# Expected literals below come from the Rust assertions, not captured/blessed output.
env: NO_COLOR=1
mkdir: encoding_breadth
copy: {root}/Examples/Data/EncodingBreadth.jet encoding_breadth/run.jet
copy: {root}/Examples/Data/EncodingBreadth.out from-root/Examples/Data/EncodingBreadth.out
file: from-root/Examples/Data/EncodingBreadth.out = "{\"a\":1,\"b\":2}\ntrue\n2\ntrue\n<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>\ntrue\n{\"a\":1,\"b\":2}\naGk\n2\nNBUQ====\n2\n"
step: jet build encoding_breadth/run.jet
exit: 0
step encoding_breadth_aot: built
cwd: encoding_breadth
exit: 0
stdout: = "{\"a\":1,\"b\":2}\ntrue\n2\ntrue\n<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>\ntrue\n{\"a\":1,\"b\":2}\naGk\n2\nNBUQ====\n2\n"
stderr: empty
step encoding_breadth_dev: jet run encoding_breadth/run.jet
stdin: null
exit: == encoding_breadth_aot
stdout: == encoding_breadth_aot
stderr: == encoding_breadth_aot
mkdir: serde_generic
copy: {root}/Examples/Data/SerdeGeneric.jet serde_generic/run.jet
copy: {root}/Examples/Data/SerdeGeneric.out from-root/Examples/Data/SerdeGeneric.out
file: from-root/Examples/Data/SerdeGeneric.out = "{\"value\":7}\n42\n{\"value\":\"hi\"}\n{\"raw\":9}\n3\n"
step: jet build serde_generic/run.jet
exit: 0
step serde_generic_aot: built
cwd: serde_generic
exit: 0
stdout: = "{\"value\":7}\n42\n{\"value\":\"hi\"}\n{\"raw\":9}\n3\n"
stderr: empty
step serde_generic_dev: jet run serde_generic/run.jet
stdin: null
exit: == serde_generic_aot
stdout: == serde_generic_aot
stderr: == serde_generic_aot
mkdir: codable_default
copy: {root}/Examples/Data/CodableDefault.jet codable_default/run.jet
copy: {root}/Examples/Data/CodableDefault.out from-root/Examples/Data/CodableDefault.out
file: from-root/Examples/Data/CodableDefault.out = "{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}\nweb\n[80, 443]\nprod\n{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}\n[8080]\n"
step: jet build codable_default/run.jet
exit: 0
step codable_default_aot: built
cwd: codable_default
exit: 0
stdout: = "{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}\nweb\n[80, 443]\nprod\n{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}\n[8080]\n"
stderr: empty
step codable_default_dev: jet run codable_default/run.jet
stdin: null
exit: == codable_default_aot
stdout: == codable_default_aot
stderr: == codable_default_aot
