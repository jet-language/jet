# #3280 c6 (was #3232): typed JSON numbers keep one meaning on web too. The
# unchanged golden example, built for web and run under node, prints its
# native golden byte for byte: exact and beyond-64-bit Int, exact Decimal
# scale, and quoted, fractional, out-of-range and nonfinite inputs as typed
# decode errors, never a string coercion.
requires: tool:node
env: NO_COLOR=1
copy: {root}/tests/run/Encoding/JSONTypedNumbers.jet main.jet
step: jet build --target web main.jet
exit: 0
step: node .jet/build/app.js
exit: 0
stdout: = ../../../tests/run/Encoding/JSONTypedNumbers.out
