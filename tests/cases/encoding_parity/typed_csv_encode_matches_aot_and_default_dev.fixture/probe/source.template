
use csv: core.encoding.csv

#Codable
Sale: struct {
    item: String
    qty: Int
}

run: fn() {
    sales: [Sale{item: "pen", qty: 3}, Sale{item: "ink", qty: 5}]
    typed: csv.to_string(sales)
    print("typed-len: {typed.len()}")
    print(typed)
    rows: [["name", "score"], ["ada", "9"]]
    print("rows: {csv.to_string(rows)}")
}
