# tests/encoding_parity.rs::malformed_limits_and_terminal_errors_match_across_applicable_tiers
# Marker spelling updated per registry E0202 ("Add the write-access marker `&` at the call site."): the stream writer and reader are `:=` places written with `&`. Effect rows updated per E0740 ("Add `IO` to the effect list"): the probes declare the effects of Core's stream `write`/`finish` (`IO`) and `next` (`IO, Time.Wait`), and the package grants `Time.Wait`. All other source bytes are original.
# Original source bytes and assertions; PENDING-SAME-HEAD, runtime UNRUN.
# Expected literals below come from the Rust assertions, not captured/blessed output.
env: NO_COLOR=1
fixture: malformed_limits_and_terminal_errors_match_across_applicable_tiers.fixture
capture: source = text file.replace("@DIR@", "{work}/probe") probe/source.template
write: probe/run.jet = "{cap:source}"
step: jet build probe/run.jet
exit: 0
step probe_aot: built
cwd: probe
exit: 0
stdout: has-line "true" # original lines().any exact true
stdout: ~any "Syntax" "true" # original contains disjunction
step probe_dev: jet run probe/run.jet
stdin: null
exit: == probe_aot
stdout: == probe_aot
stderr: == probe_aot
