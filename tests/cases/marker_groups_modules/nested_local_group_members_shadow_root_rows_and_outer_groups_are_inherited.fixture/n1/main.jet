struct LibraryNote {
    value: Int

    impl Marker {
        sites :: [.Function]
    }
}
module outer {
struct LibraryNote {
    value: String

    impl Marker {
        sites :: [.Function]
    }
}
struct Fast {
    impl Marker {
        group :: #[LibraryNote("outer"), Inline]
    }
}
#Fast fn direct() {}
module inner {
#Fast fn inherited() {}
}
}
fn run() {}
