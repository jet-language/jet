use process: core.process

run: fn() {
    // process.args() holds the words after the program name, as given.
    first := process.args()
    print(first.len())
    loop arg in first -> print("<{arg}>")
    // Each call returns a fresh list: growing one leaves the next untouched.
    first.push("added")
    second: process.args()
    print("after push: first {first.len()} second {second.len()}")
}
