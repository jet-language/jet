# Record member order is part of the type and decides comparison: the first
# written member decides first, swapped operands mirror, a record in another
# order converts to an expected type by name, an untyped list takes the first
# entry's order, and members run in written order before they are arranged.
fixture: record_member_order_decides_comparison.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step check: jet check main.jet
exit: 0
step o0: jet run -O0 main.jet
exit: 0
stdout: = "false\ntrue\ntrue true\nfalse\n2023-11 2024-3\nmonth\nyear\n2024-3\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "false\ntrue\ntrue true\nfalse\n2023-11 2024-3\nmonth\nyear\n2024-3\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "false\ntrue\ntrue true\nfalse\n2023-11 2024-3\nmonth\nyear\n2024-3\n"
