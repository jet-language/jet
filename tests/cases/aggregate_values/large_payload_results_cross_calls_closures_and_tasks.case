# A Result whose box is as large as a caller's frame holds (a seven-word
# struct payload) comes back from a direct call in a loop, through a closure
# that forwards it, and inside tasks. Every tier writes and reads it the same
# way, and the checked heap traps a box freed twice or never.
fixture: large_payload_results_cross_calls_closures_and_tasks.fixture
env: NO_COLOR=1
step: jet run --checked-alloc -O0 main.jet
exit: 0
stdout: = "called 456\nclosed 327\ntasked 1371\n"
step: jet run --checked-alloc -O1 main.jet
exit: 0
stdout: = "called 456\nclosed 327\ntasked 1371\n"
step: jet run --checked-alloc -O2 main.jet
exit: 0
stdout: = "called 456\nclosed 327\ntasked 1371\n"
