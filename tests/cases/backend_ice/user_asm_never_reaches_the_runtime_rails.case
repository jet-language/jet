# The runtime's fiber switch and GS base write assemble through rails that
# only the runtime library build enables. A program that spells either
# template exactly gets what any template outside the strict grammar gets:
# a backend fault row naming the refused line, never the rail's bytes.
fixture: fixtures/asm_rail
step: jet build rail.jet
exit: 101
stderr: ~ "internal compiler error: the Jet backend failed on `rail.jet`: 2 compiler faults:" # both leaves are refused in one report
stderr: ~ "ir.build unlowered: claim_stack [" # the switch template stays outside the program grammar
stderr: ~ "(line 2: push rbp)" # refused at its first instruction, as the grammar has no rbp
stderr: ~ "ir.build unlowered: claim_tls [" # the GS base write stays outside the program grammar
stderr: ~ "unsupported mnemonic `wrgsbase`" # the grammar has no wrgsbase
