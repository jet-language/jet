# AGENTS.md I2: a construct the IR builder can't lower is a compiler
# fault, never a user diagnostic. Each faulty function is one census row
# naming its pass, and one run reports every such function.
# The fixture carries two independent open backend gaps, so one report counts
# two fault rows: `nine` and `run` each interpolate a struct whose field is a
# Set (`Set<String>`, `Set<Int>`), and the IR builder has no rendering of a
# Set inside a record yet. Sema accepts both, so they reach the backend.
# When either gap lands, replace it with another open gap in the same position.
fixture: fixtures/backend_gap
step: jet build gap.jet
exit: 101
stderr: ~ "internal compiler error: the Jet backend failed on `gap.jet`: 2 compiler faults:" # one report counts every row
stderr: ~ "ir.build unlowered: run [function:" # the entry's gap row names its pass and function
stderr: ~ "ir.build unlowered: nine [" # the callee's row comes from the same run
stderr: ~ "display of Set<Int>" # the builder's own message stays in the row
stderr: ~ "display of Set<String>" # the builder's own message stays in the row
stderr: !~ "E2104" # a backend gap is never a user diagnostic
step: jet run gap.jet
exit: 101
stderr: ~ "ir.build unlowered: run [" # `jet run` reports the same census
stderr: !~ "E2104" # a backend gap is never a user diagnostic

step: jet test gap.jet
exit: 101
stderr: ~ "ir.build unlowered: nine [" # the test harness reports the same census
stderr: !~ "E2105" # a backend gap is never an operating-system failure
