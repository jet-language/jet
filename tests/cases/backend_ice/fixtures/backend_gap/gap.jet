package {
    name: "gap"
    authority: {
        needs: [UI.IME, UI.DragDrop]
    }
}

use {
    ime :: core.ui.host.ime
    drag_drop :: core.ui.host.drag_drop
}

fn nine() {
    event :: ime.poll() ?? panic("poll")
    print("made")
}

#Test("nine polls one IME event") {
    nine()
}

fn run() {
    nine()
    dropped :: drag_drop.poll() ?? panic("drop")
    print("made")
}
