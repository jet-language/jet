package {
    name: "gap"
    authority: { allow: [GPU] }
}

use core.compute as compute

fn nine() {
    row :: compute.vec(9, 1.0) ?? panic("vec")
    print("made")
}

#Test("nine makes its vector") {
    nine()
}

fn run() {
    nine()
    row :: compute.vec(2, 1.0) ?? panic("vec")
    print("made")
}
