package: {
    name: "gap"
    authority: {
        allow: [GPU]
    }
}

use compute: core.compute

loss: fn(w: Tensor) -> Tensor { compute.mul(w.copy(), w) ?? panic("loss") }

nine: fn() {
    _pullback: compute.vjp(loss)
    print("made")
}

#Test("nine takes one pullback") {
    nine()
}

run: fn() {
    nine()
    _tangent: compute.jvp(loss)
    print("made")
}
