package {
    name: "gap"
    authority: { allow: [Net] }
}

use core.ui.host.ime as ime
use core.web.browser as browser

fn nine() {
    event :: ime.poll() ?? panic("poll")
    print("made")
}

#Test("nine polls one IME event") {
    nine()
}

fn run() {
    nine()
    session :: browser.connect("ws://127.0.0.1:2") ?? panic("connect")
    print("made")
}
