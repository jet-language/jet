use core.data as data

struct Ticket {
    team: String
    minutes: Float
}

fn nine() {
    rows :: [Ticket]{Ticket{team: "Core", minutes: 9.0}, Ticket{team: "Tools", minutes: 4.0}}
    picked :: data.query(rows)
        .filter(t -> t.minutes >= 5.0)
        .collect() ?? panic("filter")
    print(picked.len())
}

#Test("nine prints its count") {
    nine()
}

fn run() {
    nine()
    rows :: [Ticket]{Ticket{team: "Core", minutes: 4.0}}
    picked :: data.query(rows)
        .filter(t -> t.minutes >= 1.0)
        .collect() ?? panic("filter")
    print(picked.len())
}
