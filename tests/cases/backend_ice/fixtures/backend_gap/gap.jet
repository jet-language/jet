package: {
    name: "gap"
}

Seen: struct {
    ids: Set<Int>
}

Tagged: struct {
    tags: Set<String>
}

nine: fn() {
    tagged: Tagged{tags: Set<String>.new()}
    print("{tagged}")
}

#Test("nine shows one tag set") {
    nine()
}

run: fn() {
    nine()
    seen: Seen{ids: Set<Int>.new()}
    print("{seen}")
}
