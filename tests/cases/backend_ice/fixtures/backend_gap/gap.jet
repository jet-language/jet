package {
    name: "gap"
    authority: {
        allow: [GPU]
    }
}

use compute :: core.compute

fn loss(w: Tensor) -> Tensor { compute.mul(w.copy(), w) ?? panic("loss") }

fn nine() {
    _slope :: compute.gradient(loss)
    print("made")
}

#Test("nine takes one gradient") {
    nine()
}

fn run() {
    nine()
    _tangent :: compute.jvp(loss)
    print("made")
}
