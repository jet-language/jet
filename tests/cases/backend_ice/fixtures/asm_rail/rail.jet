package: {
    name: "asm_rail"
    authority: { allow: [FFI.Asm] }
}

use core.mem

// The runtime's fiber switch, written in a program: a program's leaf
// assembles only through the strict template grammar, which has no `rbp`.
#[Unsafe("the program claims the runtime's stack switch"), FFI(asm)]
switch: fn(save: I64, target: I64) {
    """
    push rbp
    push rbx
    push r12
    push r13
    push r14
    push r15
    lea rax, [rip + 1f]
    push rax
    mov qword ptr [{save}], rsp
    mov rsp, {target}
    xor ebp, ebp
    ret
    1:
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    """
}

// The runtime's GS base write: no `wrgsbase` in the program grammar either.
#[Unsafe("the program claims the runtime's TLS base"), FFI(asm)]
gs_write: fn(base: I64) {
    """
    wrgsbase {base}
    """
}

claim_stack: fn() {
    #Unsafe("call the leaf the build refuses") {
        switch(I64{0}, I64{0})
    }
}

claim_tls: fn() {
    #Unsafe("call the leaf the build refuses") {
        gs_write(I64{0})
    }
}

run: fn() {
    claim_stack()
    claim_tls()
}
