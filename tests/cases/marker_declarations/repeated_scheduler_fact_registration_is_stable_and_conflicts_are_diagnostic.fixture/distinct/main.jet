Scheduler: struct {
    impl Fact {
        name: "Scheduler"
        holds: .Build
        safe: .Gain
        gates: [provider]
    }
}

TargetScheduler: struct {
    impl Fact {
        name: "Target.Scheduler"
        holds: .Build
        safe: .Gain
        gates: [provider, digest]
    }
}
run: fn() {}
