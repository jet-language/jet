// Two retired marker declarations, written as they were before markers
// became structs.
marker Traced(label: String, $sites: [.Function], $repeatable: true)

marker Fast = #[Inline(.Always), Scalar]

#Traced("helper") fn helper() -> Int { 41 }

#Fast fn bump(value: Int) -> Int { value + 1 }

fn run() { print(bump(helper())) }
