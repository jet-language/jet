BadPath: struct {
    name: String

    impl Diagnostic {
        what: fn(self) -> String { "`{self.name}` serves no absolute path" }
        why: fn(self) -> String { "a route path starts at the site root" }
        fix: fn(self) -> String { "give `{self.name}` a path that starts with `/`" }
    }
}

Served: struct {
    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            reject(BadPath{name: target.name})
        }
    }
}

#Served
serve: fn() {}

run: fn() {}
