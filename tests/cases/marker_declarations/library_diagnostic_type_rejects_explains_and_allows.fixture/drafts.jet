DraftRoute: struct {
    name: String

    impl Diagnostic {
        severity: .Warning
        what: fn(self) -> String { "`{self.name}` is a draft route" }
        why: fn(self) -> String { "a draft route has not been reviewed" }
        fix: fn(self) -> String { "review the route, then remove `#Draft`" }
    }
}

Draft: struct {
    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            reject(DraftRoute{name: target.name})
        }
    }
}

#Draft
shown: fn() {}

#[Allow(drafts.DraftRoute, "the release checklist reviews this route"), Draft]
reviewed: fn() {}

run: fn() {}
