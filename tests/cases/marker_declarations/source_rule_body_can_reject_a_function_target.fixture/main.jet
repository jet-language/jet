FunctionNotAllowed: struct {
    impl Diagnostic {
        code: "E0927"
        what: fn(self) -> String { "the function is not allowed" }
        why: fn(self) -> String { "the test rule rejects this declaration" }
        fix: fn(self) -> String { "remove the marker" }
    }
}

RejectsFunction: struct {
    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            reject(FunctionNotAllowed{})
        }
    }
}

#RejectsFunction
run: fn() {}
