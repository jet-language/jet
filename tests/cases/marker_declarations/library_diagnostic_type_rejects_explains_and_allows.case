# Claim: `reject(Value)` reports the library type's own `Diagnostic` texts, its `{self.field}` holes filled, at the marker use site
# Claim: a library type's code defaults to its type path and its report has no `More:` line
# Claim: `jet explain <module>.<Type>` prints the type's literals with their holes
# Claim: `#Allow(<module>.<Type>, "why")` silences a `.Warning` rejection at that site only
fixture: library_diagnostic_type_rejects_explains_and_allows.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check web.jet
exit: 1
stderr: ~ "Error [web.BadPath]: `serve` serves no absolute path" # the header names the library type and fills its hole
stderr: ~ "web.jet:21:1" # the span is the marker use site
stderr: ~ "Fix: Give `serve` a path that starts with `/`" # the fix text is the impl's literal with its hole filled
stderr: !~ "More:" # a library code has no registry page
step: jet explain web.BadPath web.jet
exit: 0
stdout: ~ "web.BadPath" # explain names the type
stdout: ~ "`{self.name}` serves no absolute path" # explain prints the what literal with its hole
stdout: ~ "give `{self.name}` a path that starts with `/`" # explain prints the fix literal with its hole
step: jet check drafts.jet
exit: 0
stderr: ~ "Warning [drafts.DraftRoute]: `shown` is a draft route" # an unallowed .Warning still reports
stderr: !~ "`reviewed` is a draft route" # the #Allow site is silenced
