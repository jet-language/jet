Recorded: struct {
    impl Marker {
        sites: [.Type]
    }
}

AddGreeting: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            tname: target.name
            impl #{tname} {
                greeting: fn(self) -> String { "hello" }
            }
        }
    }
}

#[Recorded, AddGreeting]
Person: struct { name: String }

run: fn() {
    person: Person{name: "ada"}
    print(person.greeting())
}
