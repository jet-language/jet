struct Recorded {
    impl Marker {
        sites :: [.Type]
    }
}

struct AddGreeting {
    impl Marker {
        sites :: [.Type]

        fn expand(self, target: Target) {
            tname :: target.name
            impl $tname {
                fn greeting(self) -> String { "hello" }
            }
        }
    }
}

#[Recorded, AddGreeting]
struct Person { name: String }

fn run() {
    person :: Person{name: "ada"}
    print(person.greeting())
}
