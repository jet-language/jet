# Card #705: every Examples/features/web/*.jet is named in Docs/spec/reference/web-backend-wasm.md and has a golden in Examples/features/expected/web/: a .out, .web.out or .harness.out stream, or a .case golden. Failure stops at the first missing item.
step: bash -c 'cd "{root}" && n=0 && for f in Examples/features/web/*.jet; do n=$((n+1)); b=$(basename "$f"); s=${b%.jet}; grep -qF -- "$b" Docs/spec/reference/web-backend-wasm.md || { echo "$b missing from Docs/spec/reference/web-backend-wasm.md"; exit 1; }; for g in out web.out harness.out case; do [ -f "Examples/features/expected/web/$s.$g" ] && continue 2; done; echo "$b has no golden under Examples/features/expected/web/"; exit 1; done; [ "$n" -gt 0 ] || { echo "expected at least one web example"; exit 1; }'
exit: 0
