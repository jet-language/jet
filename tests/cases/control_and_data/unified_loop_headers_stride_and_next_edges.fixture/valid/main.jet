
fn source() -> [Int] {
    print("source")
    return [0, 1, 2, 3, 4, 5, 6]
}

fn stride() -> Int {
    print("stride")
    return 3
}

fn run() {
    loop item in source(), stride() {
        print(item)
        if item == 0 { next }
    }

    outer :: loop i in 0..<3 {
        loop {
            if i < 2 { next(outer) }
            break
        }
        print("state {i}")
    }
}
