Tile: struct {
    value: Int
}
Grid: struct {
    cells: [Tile]

    impl Index {
        Key: Int
        Value: Int
        get: fn(self, key: Int) -> Int? {
            if key < 0 || key >= self.cells.len() -> return None
            return Val(self.cells[key].value)
        }
    }
}
run: fn() {
    grid: Grid{cells: [Tile{value: 1}]}
    print(grid[9])
}
