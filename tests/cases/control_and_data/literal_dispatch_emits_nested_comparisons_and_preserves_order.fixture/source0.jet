
dense: fn(n: Int) -> String {
    if n == {
        1 -> { return "one" }
        2 -> { return "two" }
        3 -> { return "three" }
        else -> { return "other" }
    }
}
sparse: fn(n: Int) -> String {
    if n == {
        1 -> { return "one" }
        100 -> { return "hundred" }
        else -> { return "other" }
    }
}
truth: fn(flag: Bool) -> String {
    if flag == {
        true -> { return "yes" }
        false -> { return "no" }
        else -> { return "no" }
    }
}
run: fn() {
    print(dense(1))
    print(sparse(100))
    print(truth(true))
}
