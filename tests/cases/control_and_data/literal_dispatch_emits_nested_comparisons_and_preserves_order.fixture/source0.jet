
fn dense(n: Int) -> String {
    if n == {
        1 -> { return "one" }
        2 -> { return "two" }
        3 -> { return "three" }
        else -> { return "other" }
    }
}
fn sparse(n: Int) -> String {
    if n == {
        1 -> { return "one" }
        100 -> { return "hundred" }
        else -> { return "other" }
    }
}
fn truth(flag: Bool) -> String {
    if flag == {
        true -> { return "yes" }
        false -> { return "no" }
        else -> { return "no" }
    }
}
fn run() {
    print(dense(1))
    print(sparse(100))
    print(truth(true))
}
