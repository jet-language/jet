
classify: fn(ok: Bool) -> Int {
    if ok { return 7 }
    return Err("bad")
}

run: fn() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        if classify(true) == {
            .Ok(ok) -> {
                print("ok")
                print(ok)
                0
            }
            .Err(_error) -> {
                print("error")
                0
            }
        }
        if classify(false) == {
            .Ok(ok) -> {
                print("ok")
                print(ok)
                0
            }
            .Err(_error) -> {
                print("error")
                0
            }
        }
    }
}
