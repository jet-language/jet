# A source loop with a stride runs its body on every n-th item from the
# first over a List (with its index), a chars() walk, an Iterable, a lazy
# Iter and a columnar List, on every tier; a stride below 1 known only at
# run time stops before the first pull.
fixture: source_loop_strides_walk_every_source_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = source_loop_strides_walk_every_source_on_every_tier.out
step: jet run -O1 main.jet
exit: 0
stdout: = source_loop_strides_walk_every_source_on_every_tier.out
step: jet run -O2 main.jet
exit: 0
stdout: = source_loop_strides_walk_every_source_on_every_tier.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = source_loop_strides_walk_every_source_on_every_tier.out
step: jet run -O0 stop.jet
exit: 70
stdout: = source_loop_strides_walk_every_source_on_every_tier.stop.out
stderr: ~ "E0123: loop stride must be positive" # O0 stops with the stride report
step: jet run -O2 stop.jet
exit: 70
stdout: = source_loop_strides_walk_every_source_on_every_tier.stop.out
stderr: ~ "E0123: loop stride must be positive" # O2 stops with the same report
