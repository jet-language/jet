# A program's explicit `process.exit(42)` ends the process with status 42 on
# every optimization level and in its built executable, after the output it
# printed (S36: explicit termination preserves its requested exit code).
fixture: explicit_exit_code_passes_through_on_every_tier.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 42
stdout: = explicit_exit_code_passes_through_on_every_tier.stdout.expected
step: jet run --optimize=basic main.jet
exit: 42
stdout: = explicit_exit_code_passes_through_on_every_tier.stdout.expected
step: jet run --optimize=full main.jet
exit: 42
stdout: = explicit_exit_code_passes_through_on_every_tier.stdout.expected
step: jet build main.jet
exit: 0
step aot: built
exit: 42
stdout: = explicit_exit_code_passes_through_on_every_tier.stdout.expected
