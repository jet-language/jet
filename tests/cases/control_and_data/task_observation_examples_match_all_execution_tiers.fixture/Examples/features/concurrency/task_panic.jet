// D-CONC-FAIL1=A / D-OBSERVE-TASK1=A: a joined child keeps its
// panic text and task identity on the TaskFailure rail.
package: {
    name: "task_panic"
    authority: { allow: [Time.Wait] }
}

boom: fn() -> Int {
    panic("Child boom")
    return 0
}

failure_text: fn(error: TaskFailure) -> String {
    if error == {
        .Panicked(reason) -> {
            return reason

        }
        .DeadlineBlown -> {
            return "deadline"

        }
        .Cancelled -> {
            return "cancelled"

        }
    }
}

run: fn() {
    task.group parent {
        child: task boom()
        child.join() ?? panic(failure_text(err))
    }
}
