#Error
struct ReadError {
    message: String
}

struct Source {
    items: [Int]
}

impl Source {
    fn pick(&self, index: Int) -> Int ReadError! {
        if index >= self.items.len() -> return Err(ReadError{message: "out of range"})
        Ok(self.items[index])
    }
}

fn run() {
    source := Source{items: [4, 5]}
    x :: &source.pick(1) ? v -> v ! e -> {
        print("failed {e.message}")
        0
    }
    print("{x}")
    y :: &source.pick(5) ? v -> v ! e -> {
        print("failed {e.message}")
        0
    }
    print("{y}")
}
