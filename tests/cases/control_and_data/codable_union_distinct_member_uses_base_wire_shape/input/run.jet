
use json: core.encoding.json

#CodableAsBase
Usd: distinct Int

#Codable
Row: struct {
    value: Usd | String
}

run: fn() {
    row: Row{ value: Usd.from_int(7) }
    wire: json.to_string(row)
    print(wire)
    decoded: json.decode<Row>(wire) ?? panic("row")
    decoded_value: decoded.value
    if decoded_value == {
        .Usd(value) -> print(value.raw())
        .String(value) -> print(value)
    }
}
