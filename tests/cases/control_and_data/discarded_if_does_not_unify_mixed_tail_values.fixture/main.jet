
seven: fn() -[IO]> Int {
    print("returned")
    7
}

branch: fn(flag: Bool) -[IO]> {
    if {
        flag -> {
            seven()
        }
        else -> { print("value") }
    }
}

run: fn() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        branch(true)
        branch(false)
    }
}
