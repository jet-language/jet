fn identity(band: ^Range) -> Range {
    return band
}
fn run() {
    bands :: [1..3, 8..<10]
    print(bands[0])
    print("{bands[1]:Debug}")
    print(bands[0] == (1..3))
    print(bands[0] == (1..<3))
    print(bands[0].contains(3))
    band :: identity(4..<7)
    print(band.start)
    print(band.end)
    print(band.contains(6))
    print(band.contains(7))
    print((7..4).contains(5))
    total := 0
    loop n in band {
        total = (total + n)
    }
    print(total)
    xs :: [10, 20, 30, 40, 50, 60, 70, 80]
    print(xs[band].copy())
}
