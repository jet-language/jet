Words: struct {
    data: [String]
}

WordsIter: struct {
    words: Words
    idx: Int
}

impl WordsIter.Iterator {
    Item: String

    next: fn(&self) -> String? {
        if self.idx >= self.words.data.len() -> return None
        v: self.words.data[self.idx]
        self.idx += 1
        Val(v)
    }
}

impl Words.Iterable {
    Iter: WordsIter

    iter: fn(&&self) -> WordsIter { WordsIter{words: self, idx: 0} }
}

source: fn() -> Words {
    print("source")
    Words{data: [String]{"one", "two"}}
}

stride: fn() -> Int {
    print("stride")
    0
}

run: fn() {
    loop w in source(), stride() -> print("word {w}")
}
