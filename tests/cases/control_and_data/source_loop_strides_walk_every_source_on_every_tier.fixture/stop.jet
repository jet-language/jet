Words: struct {
    data: [String]

    impl Iterable {
        Iter: WordsIter

        iter: fn(&&self) -> WordsIter { WordsIter{words: self, idx: 0} }
    }
}

WordsIter: struct {
    words: Words
    idx: Int

    impl Iterator {
        Item: String

        next: fn(&self) -> String? {
            if self.idx >= self.words.data.len() -> return None
            v: self.words.data[self.idx]
            self.idx += 1
            Val(v)
        }
    }
}

source: fn() -> Words {
    print("source")
    Words{data: [String]{"one", "two"}}
}

stride: fn() -> Int {
    print("stride")
    0
}

run: fn() {
    loop w in source(), stride() -> print("word {w}")
}
