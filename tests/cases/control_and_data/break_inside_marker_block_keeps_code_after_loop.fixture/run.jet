e: fn(n: Int) -> Int {
    loop {
        #Shield {
            if n > 0 -> break
        }
        return 1
    }
    print("after e")
    5
}

f: fn(n: Int) -> Int {
    loop {
        #Impure("probe") {
            if n > 0 -> break
        }
        return 1
    }
    print("after f")
    6
}

run: fn() {
    print(e(1))
    print(f(1))
}
