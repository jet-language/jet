// body_rules — D-SIG-AFTER1=A, D-BODY-LAST1=B, and D-LOOP-STMT-ARROW1=C.
twice: fn(n: Int) -> Int {
    adjusted: n + 1
    adjusted * 2
}

early: fn(n: Int) -> Int {
    if n == 0 -> return 7
    n * 2
}

label: fn(n: Int) -> String {
    if n == {
        1 -> "one"
        else -> "other"
    }
}

_report: fn(value: Int) { print("report {value}") }

_save: fn() { return Err("not implemented") }

run: fn() {
    if true -> print("if arrow")
    loop value in [1, 2] -> print("loop {value}")
    print(twice(3))
    print(early(0))
    print(early(3))
    print(label(1))
}
