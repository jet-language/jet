
nested: fn(flag: Bool) -> Int {
    // Both nested branches leave without a value.
    if {
        flag -> { panic("then") }
        else -> { panic("else") }
    }
}

infinite: fn() -> Int {
    loop {
        panic("stop")
    }
}

infinite_true: fn() -> Int {
    loop true {
        next
    }
}

unreachable: fn() -> Int {
    return 1
    print(2)
}

fallback: fn(value: Int?) -> Int {
    value ?? {
        if {
            true -> { panic("missing") }
            else -> { panic("missing") }
        }
    }
}

unit_panic: fn() -> () {
    panic("unit")
}

unit_loop: fn() -> () {
    loop {
        panic("unit")
    }
}

run: fn() {}
