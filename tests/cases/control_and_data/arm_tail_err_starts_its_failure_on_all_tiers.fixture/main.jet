// The `Err(...)` an arm's last line hands back is where its failure starts,
// as `return Err(...)` is, even after an earlier failure was handled.
lookup: fn(name: String) -> Int? {
    if name == "port" -> return Val(8080)
    None
}

setting: fn(name: String) -> Int {
    if lookup(name) == {
        .Val(value) -> Ok(value)
        .None -> Err("no setting `{name}`")
    }
}

run: fn() {
    if setting("host") == {
        .Ok(value) -> print("host:{value}")
        .Err(error) -> print("handled:{error}")
    }
    print(setting("color"))
}
