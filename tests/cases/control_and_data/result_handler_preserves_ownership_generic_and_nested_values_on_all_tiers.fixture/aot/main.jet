
choose: fn<T>(value: ^T, ok: Bool) -> T {
    if ok { return value }
    return Err("bad")
}

choose_text: fn(value: ^String, ok: Bool) -> String {
    if ok { return value }
    return Err("bad")
}

owned: fn(ok: Bool) -> String {
    return choose_text("owned", ok) ? success -> success ! _failure -> "bad"
}

generic: fn<T>(value: ^T, ok: Bool) -> T {
    return choose<T>(^value, ok) ? success -> success ! _failure -> return Err("bad")
}

nested: fn(value: Int, ok: Bool) -> Int {
    return choose<Int>(^value, ok) ? success -> {
        choose<Int>(^success, ok) ? nested_success -> nested_success + 1 ! _nested_failure -> 0
    } ! _failure -> 0
}

run: fn() {
    #FX(authority: IO) {
        authority.with("IO")
        print(owned(true))
        print(owned(false))
        print(generic(4, true) ? generic_value -> generic_value ! _generic_failure -> 0)
        print(nested(4, true))
        print(nested(4, false))
    }
}
