# A statement-position if whose condition is false and that has no else runs
# no body and falls through, at the top level, in a loop and nested, with the
# same output on O0, O1 and O2.
fixture: false_if_without_else_falls_through_on_every_tier.fixture
step o0: jet run main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o1: jet run -O1 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o2: jet run -O2 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
