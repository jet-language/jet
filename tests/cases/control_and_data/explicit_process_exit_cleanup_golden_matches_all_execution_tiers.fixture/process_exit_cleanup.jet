// D-FAIL-EXIT1: explicit process termination runs the one cleanup boundary.
package: {
    name: "process_exit_cleanup"
    authority: { allow: [Env, Exec, IO] }
}

use {
    os: core.sys
    process: core.process
    scope: core.mem.scope
}

Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

run: fn() {
    #Unsafe("the exit callback has no captured state") {
        os.atexit(() -> print("atexit"))
    }
    outer: scope.guard(() -> print("guard outer"))
    inner: scope.guard(() -> print("guard inner"))
    resource := Resource{name: "resource"}
    defer close(resource)
    print("body")
    process.exit(0)
}
