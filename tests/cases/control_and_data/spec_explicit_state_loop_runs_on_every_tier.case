# The spec's explicit-state loop example (Docs/spec/spec.md, Branching,
# results, and loops) runs as written on every tier: the header binds and
# tests the state, the body advances it.
fixture: spec_explicit_state_loop_runs_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = spec_explicit_state_loop_runs_on_every_tier.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = spec_explicit_state_loop_runs_on_every_tier.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = spec_explicit_state_loop_runs_on_every_tier.out
