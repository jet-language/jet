
classify: fn(ok: Bool) -[IO]> Int {
    print("subject")
    if ok {
        return 5
    }
    return Err("bad")
}

handle: fn(ok: Bool) -[IO]> {
        if classify(ok) == {
            .Ok(_success) -> { print("success") }
            .Err(_failure) -> {
                print("failure")
                _ := 9
            }
        }
}

run: fn() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        handle(true)
        handle(false)
    }
}
