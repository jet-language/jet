
nested_return_if: fn(value: Dyn, right: Dyn) -> Bool Never! {
    return if value == {
        .Text(left_text) -> {
            return if right == {
                .Text(right_text) -> left_text == right_text
                .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> false
            }
        }
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> true
    }
}

run: fn() {
    print(nested_return_if(Dyn.Null, Dyn.Null))
}
