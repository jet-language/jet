
nested_return_if: fn(value: Dyn, right: Dyn) -> Bool Never! {
    return if value == {
        .Text(left_text) -> {
            return if right == {
                .Text(right_text) -> left_text == right_text
                else -> false
            }
        }
        else -> true
    }
}

run: fn() {
    print(nested_return_if(Dyn.Null, Dyn.Null))
}
