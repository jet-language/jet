flag: fn(value: Bool) -> Bool {
    print("checked {value}")
    value
}

run: fn() {
    total := 0
    if flag(false) {
        total += 100
    }
    print("after first {total}")
    loop i in 0..<3 {
        if i > 5 {
            total += 1000
        }
        total += i
    }
    if flag(false) {
        if flag(true) {
            total += 10000
        }
    }
    print("end {total}")
}
