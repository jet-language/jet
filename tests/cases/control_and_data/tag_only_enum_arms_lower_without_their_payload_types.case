# Tag-only arms (`.Exited(_)`, an or-pattern of them) over enum variants with
# struct, list, String, Float and enum payloads cover each variant by its tag:
# the table needs no coverage of the payload types it never binds, and it
# lowers and runs the same at every tier. A payload-bound arm keeps the full
# check (tests/ui/enum_payload_arm_not_exhaustive).
fixture: tag_only_enum_arms_lower_without_their_payload_types.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = tag_only_enum_arms_lower_without_their_payload_types.out
step: jet run -O1 main.jet
exit: 0
stdout: = tag_only_enum_arms_lower_without_their_payload_types.out
step: jet run -O2 main.jet
exit: 0
stdout: = tag_only_enum_arms_lower_without_their_payload_types.out
step: jet build --release main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = tag_only_enum_arms_lower_without_their_payload_types.out
