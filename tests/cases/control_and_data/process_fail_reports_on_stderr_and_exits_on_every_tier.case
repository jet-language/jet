# `process.fail(code, message)` writes the message and a newline to stderr,
# after the output already printed, and ends the program with `code`.
fixture: process_fail_reports_on_stderr_and_exits_on_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 3
stdout: = "before\n"
stderr: = "batch b1 has no compiler\n"
step: jet run -O1 main.jet
exit: 3
stdout: = "before\n"
stderr: = "batch b1 has no compiler\n"
step: jet run -O2 main.jet
exit: 3
stdout: = "before\n"
stderr: = "batch b1 has no compiler\n"
step: jet build main.jet
exit: 0
step aot: built
exit: 3
stdout: = "before\n"
stderr: = "batch b1 has no compiler\n"