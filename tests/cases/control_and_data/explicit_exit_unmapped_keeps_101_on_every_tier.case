# `process.exit_unmapped(101)` ends the process with status 101 unchanged on
# every optimization level and in its built executable, after the output it
# printed; `process.exit(101)` maps the same status to 1
# (explicit_exit_101_maps_to_user_error_on_every_tier, S36).
fixture: explicit_exit_unmapped_keeps_101_on_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 101
stdout: = explicit_exit_unmapped_keeps_101_on_every_tier.stdout.expected
step: jet run -O1 main.jet
exit: 101
stdout: = explicit_exit_unmapped_keeps_101_on_every_tier.stdout.expected
step: jet run -O2 main.jet
exit: 101
stdout: = explicit_exit_unmapped_keeps_101_on_every_tier.stdout.expected
step: jet build main.jet
exit: 0
step aot: built
exit: 101
stdout: = explicit_exit_unmapped_keeps_101_on_every_tier.stdout.expected
