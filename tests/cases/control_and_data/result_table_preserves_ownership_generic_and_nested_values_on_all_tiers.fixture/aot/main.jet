
choose: fn<T>(value: &&T, ok: Bool) -> T {
    if ok { return value }
    return Err("bad")
}

choose_text: fn(value: &&String, ok: Bool) -> String {
    if ok { return value }
    return Err("bad")
}

owned: fn(ok: Bool) -> String {
    return if choose_text("owned", ok) == { .Ok(success) -> success, .Err(_failure) -> "bad" }
}

generic: fn<T>(value: &&T, ok: Bool) -> T {
    return if choose<T>(value, ok) == { .Ok(success) -> success, .Err(_failure) -> return Err("bad") }
}

nested: fn(value: Int, ok: Bool) -> Int {
    return if choose<Int>(value, ok) == {
        .Ok(success) -> if choose<Int>(success, ok) == { .Ok(inner) -> inner + 1, .Err(_) -> 0 }
        .Err(_failure) -> 0
    }
}

run: fn() {
    #FX(authority: IO) {
        authority.with("IO")
        print(owned(true))
        print(owned(false))
        print(if generic(4, true) == { .Ok(value) -> value, .Err(_) -> 0 })
        print(nested(4, true))
        print(nested(4, false))
    }
}
