struct Runner {
    label: String
}

impl Runner {
    fn count_with(self, outcomes: [KitOutcome], check: fn(KitOutcome) -> Bool) -> Int {
        total := 0
        loop outcome in outcomes {
            if check(outcome) -> total += 1
        }
        total
    }
}

fn count_free(outcomes: [KitOutcome], check: fn(KitOutcome) -> Bool) -> Int {
    total := 0
    loop outcome in outcomes {
        if check(outcome) -> total += 1
    }
    total
}
