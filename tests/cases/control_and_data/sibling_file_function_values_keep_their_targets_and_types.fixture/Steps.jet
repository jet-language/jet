Runner: struct {
    label: String

    count_with: fn(self, outcomes: [KitOutcome], check: fn(KitOutcome) -> Bool) -> Int {
        total := 0
        loop outcome in outcomes {
            if check(outcome) -> total += 1
        }
        total
    }
}

count_free: fn(outcomes: [KitOutcome], check: fn(KitOutcome) -> Bool) -> Int {
    total := 0
    loop outcome in outcomes {
        if check(outcome) -> total += 1
    }
    total
}
