KitOutcome: struct {
    name: String
    ok: Bool
}

Hooks: struct {
    check: fn(KitOutcome) -> Bool
}

kit_expect_diagnostics: fn(outcome: KitOutcome) -> Bool { outcome.ok }

kit_expect_exact: fn(outcomes: [KitOutcome]) -> Int {
    hooks: Hooks{check: kit_expect_diagnostics}
    runner: Runner{label: "exact"}
    a: runner.count_with(outcomes, kit_expect_diagnostics)
    b: runner.count_with(outcomes, hooks.check)
    c: count_free(outcomes, hooks.check)
    a + b + c
}
