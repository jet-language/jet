{
  "host": "devhost",
  "target": "linux.x64",
  "nixpkgs": "NixOS/nixpkgs/nixos-24.05@github",
  "packages": ["git", "ripgrep", "jetbrains.idea-ultimate"],
  "services": ["openssh", "pipewire"],
  "options": {
    "network.hostName": "devhost",
    "services.openssh.enable": true,
    "boot.loader": ".Limine"
  },
  "flakePartsModules": ["./nix/hosts/devhost.nix"],
  "homeManagerModules": ["./home/user.nix"],
  "users": [
    {
      "name": "user",
      "home": "/home/user",
      "groups": ["wheel"],
      "packages": ["neovim", "ghostty"],
      "homeManager": true
    }
  ],
  "omissions": ["programs.firefox.profiles need profile-specific Canvas editing"]
}