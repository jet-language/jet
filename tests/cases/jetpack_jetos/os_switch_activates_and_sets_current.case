step proof: jet os proof halcyon --json --no-color
cwd: project
env: JETPACK_ROOT={work}/package-root
env: PATH=/usr/bin:/bin
exit: 0
stdout: ~ "\"host\":\"halcyon\"" # original predicate
stdout: ~ "\"boot\":" # original predicate
stdout: ~ "\"provenance\":" # original predicate
stdout: ~ "\"vm_proof\":" # original predicate
