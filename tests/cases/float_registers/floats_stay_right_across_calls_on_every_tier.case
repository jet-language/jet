# Float and F32 values the native code keeps in xmm registers stay right
# across user calls, runtime calls and stop polls, with more Floats live at
# once than there are registers; every tier prints the same values.
fixture: floats_stay_right_across_calls_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run --optimize=none main.jet
exit: 0
stdout: = floats_stay_right_across_calls_on_every_tier.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = floats_stay_right_across_calls_on_every_tier.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = floats_stay_right_across_calls_on_every_tier.out
step: jet build --optimize=none main.jet
exit: 0
step aot0: built
exit: 0
stdout: = floats_stay_right_across_calls_on_every_tier.out
step: jet build --optimize=full main.jet
exit: 0
step aot2: built
exit: 0
stdout: = floats_stay_right_across_calls_on_every_tier.out
