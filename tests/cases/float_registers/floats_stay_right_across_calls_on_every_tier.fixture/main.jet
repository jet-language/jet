// Float and F32 values carried in registers through loops whose bodies call
// user functions and the runtime (printing, allocation, floor and floor
// division), with more Floats live at once than there are registers, and
// through recursion.
use math: core.math

scale: fn(x: Float, k: Float) -> Float {
    return x * k + 0.5
}

tree: fn(n: Int, x: Float) -> Float {
    if n < 2 -> return x
    left: tree(n - 1, x * 0.5)
    right: tree(n - 2, x + 1.0)
    return left + right + x
}

narrow: fn(x: F32, y: F32) -> F32 {
    return x * y - x
}

run: fn() {
    a := Float{1.5}
    b := Float{-2.25}
    c := Float{3.0}
    d := Float{0.125}
    e := Float{10.0}
    f := Float{-7.5}
    g := Float{2.0}
    h := Float{0.75}
    i := Float{100.0}
    j := Float{-0.5}
    words := [String]{}
    loop step in 0..<20 {
        words.push("w{step}")
        a = scale(a, 1.01) - b * 0.001
        b = b + math.floor(c * 1.5) * 0.01
        c = c * h + d
        d = (d + e) /% Float{3.0}
        e = e - f * 0.01
        f = f + g * h
        g = g * 1.0001 + j
        h = h * 0.999
        i = i - a + scale(j, 2.0)
        j = j * -1.0
    }
    print("{a} {b} {c} {d} {e}")
    print("{f} {g} {h} {i} {j}")
    print("{words.len()} {words[19]} {tree(12, 1.0)}")
    p := F32{1.5}
    q := F32{0.25}
    loop _ in 0..<10 {
        p = narrow(p, q) + F32{1.0}
        q = q * F32{0.5} + F32{0.125} * p
    }
    print("narrow {p} {q}")
}
