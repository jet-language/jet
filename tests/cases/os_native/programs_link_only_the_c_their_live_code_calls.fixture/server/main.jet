// A core.http.server program that serves plain HTTP only, so it links no C.
use core.[files, http.server, net]

// The defined symbols of this executable's `.symtab` and the ones at its
// entry address.
LinkFacts: struct {
    entry: [String]
    defined: [String:Bool]
}

link_facts: fn() -[FS]> LinkFacts Never! {
    b: files.read_bytes("/proc/self/exe") ?? panic("can't read /proc/self/exe: {err}")
    entry: le(b, 24, 8)
    shoff: le(b, 40, 8)
    shentsize: le(b, 58, 2)
    shnum: le(b, 60, 2)
    facts := LinkFacts{entry: [String]{}, defined: [String:Bool]{}}
    loop i in 0..<shnum {
        s: shoff + i * shentsize
        // SHT_SYMTAB
        if le(b, s + 4, 4) != 2 -> next
        off: le(b, s + 24, 8)
        size: le(b, s + 32, 8)
        link: le(b, s + 40, 4)
        ent: le(b, s + 56, 8)
        strings: le(b, shoff + link * shentsize + 24, 8)
        at := off
        loop ent > 0 && at + ent <= off + size {
            // A defined symbol: st_shndx is not SHN_UNDEF.
            if le(b, at + 6, 2) != 0 {
                name: c_string(b, strings + le(b, at, 4))
                if le(b, at + 8, 8) == entry -> facts.entry.push(name.copy())
                facts.defined[name.copy()] = true
            }
            at += ent
        }
    }
    facts
}

// The `width`-byte little-endian unsigned value at `at`.
le: fn(b: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = value * 256 + Int.from_u8(b[at + width - 1 - k])
    value
}

// The NUL-terminated name at `at`.
c_string: fn(b: [U8], at: Int) -> String Never! {
    end := at
    loop end < b.len() && Int.from_u8(b[end]) != 0 -> end += 1
    String.from_bytes_lossy(b.slice(at, end))
}

health: fn() -> HTTPResponse HTTPError! { Ok(server.response(200, "ok")) }

run: fn() (HTTPError | IOError | NetError)! {
    mux: server.mux()
    mux.get("/health", fn() { health() })
    // The serving path is live code; the case never creates the flag.
    if files.exists("serve.flag") {
        listener: net.tcp_listen("127.0.0.1:0")
        server.serve_once_listener(listener, mux) ?? panic("serve failed")
    }
    print("routes ready")
    facts: link_facts()
    print("entry is __jet_start: {facts.entry.contains("__jet_start")}")
    names: [String]{"__libc_start_main", "pthread_create"}
    loop name in names -> print("defines {name}: {facts.defined.get(name) != None}")
}
