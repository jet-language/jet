// A core.db program: it calls SQLite, so it links SQLite's closure.
use core.[db, files]

// The defined symbols of this executable's `.symtab`.
defined_symbols: fn() -[FS]> [String:Bool] Never! {
    b: files.read_bytes("/proc/self/exe") ?? panic("can't read /proc/self/exe: {err}")
    shoff: le(b, 40, 8)
    shentsize: le(b, 58, 2)
    shnum: le(b, 60, 2)
    defined := [String:Bool]{}
    loop i in 0..<shnum {
        s: shoff + i * shentsize
        // SHT_SYMTAB
        if le(b, s + 4, 4) != 2 -> next
        off: le(b, s + 24, 8)
        size: le(b, s + 32, 8)
        link: le(b, s + 40, 4)
        ent: le(b, s + 56, 8)
        strings: le(b, shoff + link * shentsize + 24, 8)
        at := off
        loop ent > 0 && at + ent <= off + size {
            // A defined symbol: st_shndx is not SHN_UNDEF.
            if le(b, at + 6, 2) != 0 -> defined[c_string(b, strings + le(b, at, 4))] = true
            at += ent
        }
    }
    defined
}

// The `width`-byte little-endian unsigned value at `at`.
le: fn(b: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = value * 256 + Int.from_u8(b[at + width - 1 - k])
    value
}

// The NUL-terminated name at `at`.
c_string: fn(b: [U8], at: Int) -> String Never! {
    end := at
    loop end < b.len() && Int.from_u8(b[end]) != 0 -> end += 1
    String.from_bytes_lossy(b.slice(at, end))
}

run: fn() {
    conn := db.open_memory()
    policy: db.policy("items", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "owner")
    _created: db.migrate(scoped, "items-v1", [
        SQL{"CREATE TABLE items (name TEXT)"}
    ]) ?? panic("create")
    _inserted: scoped.execute(SQL{"INSERT INTO items (name) VALUES ('one')"}) ?? panic("insert")
    row: scoped.query_one(SQL{"SELECT name FROM items"}) ?? panic("query")
    name: db.row_value(row, "name") ?? panic("row value")
    print("name={name.text() ?? panic("text")}")
    print("defines sqlite3_open_v2: {defined_symbols().get("sqlite3_open_v2") != None}")
}
