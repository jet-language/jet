// A one-request nscd on /var/run/nscd/socket: a GETINITGR query for alice
// gets groups 700, 500 and 4321; any other request gets "not found". Each
// request word is a native-endian (here little-endian) int32.
package: {
    name: "nscd_stub"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use net: core.net

NSCD_VERSION: 2
GETINITGR: 15

word: fn(bytes: [U8], at: Int) -> Int {
    Int{bytes[at]} + Int{bytes[at + 1]} * 256 + Int{bytes[at + 2]} * 65536 + Int{bytes[at + 3]} * 16777216
}

words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values {
        rest := value
        written := 0
        loop written < 4 {
            out.push(checked(U8{rest % 256}) ?? U8{0})
            rest /%= 256
            written += 1
        }
    }
    out
}

read_exact: fn(stream: &UnixStream, n: Int) -> [U8] {
    out := [U8]{}
    loop out.len() < n {
        chunk: net.unix_read_bytes(stream, n - out.len()) ?? return out
        if chunk.len() == 0 -> return out
        loop b in chunk -> out.push(b)
    }
    out
}

run: fn() {
    listener: net.unix_listen("/var/run/nscd/socket") ?? panic("listen on the nscd socket")
    stream := net.unix_accept(listener) ?? panic("accept the query")
    header: read_exact(stream, 12)
    asked := header.len() == 12 && word(header, 0) == NSCD_VERSION && word(header, 4) == GETINITGR
    if asked {
        key: read_exact(stream, word(header, 8))
        expected: [U8]{97, 108, 105, 99, 101, 0}
        asked = key.len() == expected.len()
        at := 0
        loop asked && at < key.len() {
            asked = key[at] == expected[at]
            at += 1
        }
    }
    reply: if asked -> words([Int]{NSCD_VERSION, 1, 3, 700, 500, 4321}) else -> words([Int]{NSCD_VERSION, 0, 0})
    net.unix_write_all_bytes(stream, reply) ?? panic("answer the query")
    stream.close() ?? panic("close the query")
}
