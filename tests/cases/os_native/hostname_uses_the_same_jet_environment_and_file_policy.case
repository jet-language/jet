# Port of tests/os_native.rs::hostname_uses_the_same_jet_environment_and_file_policy (718-759):
# core.net.gethostname and core.sys.hostname agree, prefer a nonempty HOSTNAME and otherwise
# read /etc/hostname (trimmed), falling back to `localhost`. The original's padded HOSTNAME
# value cannot be spelled in a case `env:` line, which trims; an unpadded name stands in.
requires: os-name:linux
fixture: hostname_uses_the_same_jet_environment_and_file_policy.fixture
step: sh -c 'if [ -r /etc/hostname ]; then cat /etc/hostname; else echo localhost; fi'
exit: 0
capture: file_host = text stdout.trim
step: jet build --allow=Env,FS.Read main.jet
exit: 0
step unset: built
unset: HOSTNAME
exit: 0
stdout: = "name:{cap:file_host}\ntrue\n"
step empty: built
env: HOSTNAME=
exit: 0
stdout: = "name:{cap:file_host}\ntrue\n"
step named: built
env: HOSTNAME=deliberate-host
exit: 0
stdout: = "name:deliberate-host\ntrue\n"
