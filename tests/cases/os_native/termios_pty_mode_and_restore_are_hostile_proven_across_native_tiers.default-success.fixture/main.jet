
use term: core.term

run: fn() {
    print("ready")
    #Live {
        // Raw mode is on here: the case sends its key only after this marker.
        print("raw-on")
        _pressed: term.read_key()
        print("raw-complete")
    }
    secret: term.input_secret("secret> ")
    print("secret-ok:{secret}")
}
