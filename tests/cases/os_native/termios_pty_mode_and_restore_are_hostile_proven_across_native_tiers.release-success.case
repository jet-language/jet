requires: os:unix
requires: os-name:linux|android|macos|ios|freebsd|openbsd|netbsd
refused: pty
fixture: termios_pty_mode_and_restore_are_hostile_proven_across_native_tiers.release-success.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
session child raw: jet run --quiet --release main.jet
pty: true
recv child until ~ "ready" within 60s
pty-send: "x" after 0ms
recv child until ~ "raw-complete" within 10s
pty-send: "answer\n" after 0ms
recv child until ~ "secret-ok:answer" within 10s
close child
exit: 0
stdout: ~ "secret-ok:answer" # original complete PTY transcript predicate
