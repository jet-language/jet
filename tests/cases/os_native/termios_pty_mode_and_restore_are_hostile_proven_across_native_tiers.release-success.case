# Port of tests/os_native.rs:677-693 and helper510-674 (release-success). Source bytes verbatim.
# SPLIT pty-termios-observation: full baseline/raw/secret-mode/restore claims ledger-only, not replaced by transcript checks.
# Runtime PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four).
requires: os:unix
requires: os-name:linux|android|macos|ios|freebsd|openbsd|netbsd
fixture: termios_pty_mode_and_restore_are_hostile_proven_across_native_tiers.release-success.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
session child raw: jet run --quiet --release main.jet
pty: true
recv child until ~ "raw-on" within 60s # original PTY ready marker rs582-587, then the raw-mode wait rs588-593 as a marker printed inside #Live
pty-send: "x" after 0ms
recv child until ~ "raw-complete" within 10s # original raw-complete marker rs626-630
pty-send: "answer\n" after 0ms
recv child until ~ "secret-ok:answer" within 10s # original secret-ok marker rs641-645
stdout: ~ "secret-ok:answer" # original complete PTY transcript predicate; close reports only output no recv consumed
close child
exit: 0
