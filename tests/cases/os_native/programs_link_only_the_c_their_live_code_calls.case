# A program links only the C its live code calls (#6693, #6687). The link's
# own collection over the program object and the runtime pack names the
# symbols live code references and nothing defines; only the C providers of
# those declarations are realized (JetCli Host.jet jet_cli_native_executable).
# A core.data program, a core.db program (its SQLite is Jet) and a plain
# HTTP core.http.server program call no C: they link no musl and start at
# `__jet_start`. A call of a C function no library defines is the program's
# error (E2105) naming the undefined symbol and its declaration, not an
# internal compiler error. Each program reads its own `.symtab` (a debug
# build keeps it), so only the built executables run: under `jet run`
# /proc/self/exe is jet itself.
requires: os-name:linux
fixture: programs_link_only_the_c_their_live_code_calls.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step data: jet build data/main.jet
exit: 0
step data_run: built
exit: 0
stdout: = programs_link_only_the_c_their_live_code_calls.data.out
stderr: empty
step server: jet build server/main.jet
exit: 0
step server_run: built
exit: 0
stdout: = programs_link_only_the_c_their_live_code_calls.server.out
stderr: empty
step db: jet build db/main.jet
exit: 0
step db_run: built
exit: 0
stdout: = programs_link_only_the_c_their_live_code_calls.db.out
stderr: empty
step missing: jet build missing/main.jet
exit: 1
stderr: ~ "undefined symbol `jet_case_no_such_c_function`" # the link names the C symbol nothing defines
stderr: ~ "the foreign function `absent` names it" # and the declaration that calls it
stderr: ~ "jet.DriverOperationFailed" # the program's own error
stderr: !~ "internal compiler error" # not a compiler fault (exit 101)
