# setuid, setgid and initgroups change the credentials of every thread of
# the process, as musl's do (Linux keeps them per thread): after the calls,
# made from one task while others keep carriers busy, every
# /proc/self/task/<tid>/status shows the same Uid, Gid and Groups. A call
# the kernel refuses changes no thread. initgroups reads /etc/group as musl's
# getgrouplist does (a member list's byte after a comma is never a separator,
# so `carol,,alice` names `,alice`; a gid wraps to 32 bits) and merges the
# groups nscd's GETINITGR answer lists.
requires: os-name:linux
requires: tool:sh
requires: tool:unshare
requires: tool:mount
requires: tool:mkdir
requires: probe unshare --user --map-root-user --map-auto --mount true # user namespaces with subordinate ids (newuidmap, /etc/subuid)
fixture: credentials_change_on_every_thread.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step build: jet build main.jet
exit: 0
step build-nscd: jet build main.jet
cwd: nscd
exit: 0
step drop: unshare --user --map-root-user --map-auto --mount sh inside.sh
exit: 0
stdout: = credentials_change_on_every_thread.out
