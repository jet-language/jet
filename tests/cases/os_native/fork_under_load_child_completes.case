# core.sys.fork() under load is as safe as musl's fork: tasks keep other
# carriers allocating and resolving localhost for the whole run while the
# main task forks 400 times, and every child allocates, resolves and exits 0.
# The fork gate (RouteSys.jet jet_sys_fork_raw) keeps pthread_create out and
# holds the thread registry's mutex, the stdout lock and every allocator lock
# across the system call, so no child inherits a lock a thread it lacks still
# holds; a child that did would block for good and the step would time out
# (the ungated runtime hangs within a few hundred forks of this load).
requires: os-name:linux
requires: probe grep -qw localhost /etc/hosts # the children resolve localhost from /etc/hosts
fixture: fork_under_load_child_completes.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = fork_under_load_child_completes.out
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = fork_under_load_child_completes.out
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = fork_under_load_child_completes.out
