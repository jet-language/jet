# Port of tests/os_native.rs::native_os_facts_match_host_and_are_nonempty (762-797): a native
# build reports the host's OS name, family and architecture, and nonempty process facts.
# The original compared against Rust's host constants; on Linux they are `linux`, `unix`
# and the `uname -m` machine name.
requires: os-name:linux
fixture: native_os_facts_match_host_and_are_nonempty.fixture
step: uname -m
exit: 0
capture: arch = text stdout.trim
step: jet build --allow=Env,FS.Read main.jet
exit: 0
step facts: built
exit: 0
stdout: = "linux\nunix\n{cap:arch}\ntrue\ntrue\ntrue\ntrue\ntrue\n"
