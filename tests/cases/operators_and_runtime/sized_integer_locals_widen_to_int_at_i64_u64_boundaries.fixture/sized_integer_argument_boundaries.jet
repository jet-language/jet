
fn accept(value: Int) -> Int { return value }
fn pick(values: [U8], slot: I64) -> U8 { return values[slot] }

fn run() {
    i64_min :: I64.MIN
    i64_max :: I64.MAX
    u64_zero :: U64{0}
    u64_max :: U64.MAX
    values :: [U8]{7}
    print(accept(i64_min))
    print(accept(i64_max))
    print(accept(u64_zero))
    print(accept(u64_max))
    print(pick(values, I64{0}))
}
