
fn transform(xs: [Int], offset: Int) -> [Int] {
    xs.map(x -> x * 3 + offset).filter(x -> x % 2 == 0).map(x -> x + 1)
}
fn captured(xs: [Int], offset: Int) -> [Int] {
    xs.map(x -> x * 3 + offset)
}
fn run() {
    a :: transform([1, 2], 5)
    print(a[0])
    b :: captured([1], 9223372036854775808)
    print(b[0])
    c :: captured([9223372036854775808], 5)
    print(c[0])
}
