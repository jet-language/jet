
#Arithmetic(.Wrapping)
wrapped: fn(left: U8, right: U8) -> U8 {
    return left + right
}

#Arithmetic(.Saturating)
saturated: fn(left: U8, right: U8) -> U8 {
    return left + right
}

Accumulator: struct { value: U8 }
impl Accumulator {
    #Arithmetic(.Wrapping)
    step: fn(self, right: U8) -> U8 {
        return self.value + right
    }
}

run: fn() {
    left: U8{200}
    right: U8{100}
    #Arithmetic(.Wrapping) {
        print(left + right)
        print(left - U8{250})
        print(left * U8{2})
        print(U8{3}.pow(U8{5}))
        print(left / U8{2})
    }
    print(wrapped(left, right))
    print(saturated(left, right))
    print(Accumulator{value: left}.step(right))
}
