
#Arithmetic(.Wrapping)
fn wrapped(left: U8, right: U8) -> U8 {
    return left + right
}

#Arithmetic(.Saturating)
fn saturated(left: U8, right: U8) -> U8 {
    return left + right
}

struct Accumulator { value: U8 }
impl Accumulator {
    #Arithmetic(.Wrapping)
    fn step(self, right: U8) -> U8 {
        return self.value + right
    }
}

fn run() {
    left :: U8{200}
    right :: U8{100}
    #Arithmetic(.Wrapping) {
        print(left + right)
        print(left - U8{250})
        print(left * U8{2})
        print(U8{3}.pow(U8{5}))
        print(left / U8{2})
    }
    print(wrapped(left, right))
    print(saturated(left, right))
    print(Accumulator{value: left}.step(right))
}
