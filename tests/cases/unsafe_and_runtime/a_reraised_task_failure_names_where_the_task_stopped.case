# A task's stop keeps its report context with its failure. A join that
# re-raises the failure (`t.join() ?? panic(text)` with the failure's reason)
# hands that site on, through every task level, so the root stop names the
# line that failed, not only the line that re-raised it.
fixture: a_reraised_task_failure_names_where_the_task_stopped.fixture
env: NO_COLOR=1
step check: jet check main.jet
exit: 0
step o0: jet run -O0 main.jet
exit: 70
stderr: ~ "the list has 1 item, so position 3 doesn't exist" # the innermost reason, under both identity prefixes
stderr: ~ "the failed task stopped at:" # the joined failure's site follows the root's own context
stderr: ~ "main.jet:2" # the indexing line of the innermost task
stderr: ~ "rows[at]" # its source line
stderr: ~ "main.jet:17" # the middle task's re-raise, after the site it carried
step o2: jet run -O2 main.jet
exit: 70
stderr: ~ "the failed task stopped at:" # the same site under optimization
stderr: ~ "main.jet:2" # the indexing line of the innermost task
