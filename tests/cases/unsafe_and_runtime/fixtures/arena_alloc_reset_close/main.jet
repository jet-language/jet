use core.mem
fn run() {
    arena :: mem.Arena.new()
    x :: arena.alloc(42)
    print(x)
    arena.reset()
    y :: arena.alloc(99)
    print(y)
    sized :: mem.Arena.new(capacity: 4096)
    s :: sized.alloc(7)
    print(s)
    pool :: mem.Pool.new(slots: 8)
    p :: pool.alloc(3)
    print(p)
    close(^arena)
}
