use time: core.time

slow: fn(value: Int) -> Int {
    time.sleep(1ms)
    return value
}

run: fn() {
    #Deadline(0ms) {
        task.group workers {
            if (task.all { slow(1), slow(2) }) == {
                .Ok(results) -> {
                    print(results[0], results[1])
                }
                .Err(error) -> {
                    panic("unexpected child task failure")
                }
            }
        }
    }
    print("unreachable")
}
