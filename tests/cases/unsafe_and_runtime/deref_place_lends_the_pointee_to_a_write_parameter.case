# `pointer.*` as the argument of a write (`&`) parameter is the pointee's own
# storage: IR lowering lends the place at the pointer's address, so the
# callee's write lands in `c` and `print(c.n)` shows the bumped value on every
# tier.
fixture: deref_place_lends_the_pointee_to_a_write_parameter.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = "2\n"
step: jet run --optimize=basic main.jet
exit: 0
stdout: = "2\n"
step: jet run --optimize=full main.jet
exit: 0
stdout: = "2\n"
