#Unsafe("the cell is live on this frame")
peek: fn(v: Int) -> Int {
    cell: v
    p: *cell
    p.*
}

run: fn() {
    #Unsafe("call the gated reader") {
        print(peek(42))
    }
}

#Test("gated reader") {
    #Unsafe("test region calls the gated reader") {
        assert_eq(peek(1), 1)
    }
}
