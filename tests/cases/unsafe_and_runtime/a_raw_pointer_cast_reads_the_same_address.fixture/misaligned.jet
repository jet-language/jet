use core.mem

run: fn() {
    cell := 258
    address: mem.address_of(cell)
    #Unsafe("the cast Int starts one byte into the cell, so the sentry stops the read") {
        whole: mem.Ptr<Int>.from_addr(address)
        inside: whole.cast<U8>().offset(1).cast<Int>()
        print(inside.*)
    }
}
