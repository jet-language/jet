# `pointer.*.bump(by)` in a generic function calls the trait's `&self` method
# on the pointee in place: IR lowering lends the place at the pointer's
# address, so both calls bump the caller's `c` and it reads the sum on every
# tier.
fixture: deref_place_receives_a_trait_self_method_through_a_pointer.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = "3\n6\n6\n"
step: jet run --optimize=basic main.jet
exit: 0
stdout: = "3\n6\n6\n"
step: jet run --optimize=full main.jet
exit: 0
stdout: = "3\n6\n6\n"
