use core.mem

run: fn() {
    cell := (a: 1, b: 2)
    list := [Int]{7, 8, 9}
    #Unsafe("the copy writes one Int past the tuple, so the sentry stops it before any byte moves") {
        first: mem.Ptr<Int>.from_addr(mem.address_of(cell))
        print(first.*)
        mem.list_copy<Int>(first, list, 0, 3)
        print(first.*)
    }
}
