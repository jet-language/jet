package: {
    name: "font-defaults"
    version: "0.1.0"
    deps: {
        font: "0.1.0",
    }
}

use font

run: fn() {
    body: font.system(.Body)
    title: font.system(.Title)
    mono: font.system(.Monospace)
    print("{body.family}|{body.size}")
    print("{title.family}|{title.size}")
    print("{mono.family}|{mono.size}")
}
