read: fn(req: HTTPRequest) -> String {
    body: req.body().text(1048576) ?? "fallback"
    smaller: req.body().text(1024) ?? "fallback"
    exact: #run { 1024 * 1024 }
    from_constant: req.body().text(exact) ?? "fallback"
    #Allow(jet.MessageText, "the fixture exercises suppression of this occurrence") allowed: req.body().text(1048576) ?? "fallback"
    print(smaller)
    print(from_constant)
    print(allowed)
    body
}

read_response: fn(response: HTTPResponse) -> String {
    response.body().text(1048576) ?? "fallback"
}

read_binary: fn(req: HTTPRequest) -> [U8] {
    req.body().bytes(1048576) ?? []
}

read_stream: fn(req: HTTPRequest) -> HTTPBodyChunks {
    req.body().chunks(1024)
}

run: fn() {}
