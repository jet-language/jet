use {
    fs: core.files
    files: core.files
}

run: fn() {
    root: "."
    #Allow(jet.WalkFilesFilter, "the fixture exercises suppression of this occurrence") loop entry in fs.walk(root).list() ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in fs.walk(root).list() ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in files.walk(root).list() ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    entries: fs.walk(root).list() ?? []
    loop entry in entries {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in fs.walk(root).list() ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
        break
    }

    loop entry in fs.walk(root).list() ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.is_dir)
    }
}
