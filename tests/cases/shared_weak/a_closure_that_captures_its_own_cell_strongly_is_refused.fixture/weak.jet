// The repair: the listener captures a weak handle, and a named function
// captures nothing, so the feed closes its stream when the last strong handle
// goes. A callback a writing call only runs (`sort_by`) may capture a strong
// handle to a feed: it is not stored.
Stream: struct {
    fd: Int

    impl Close {
        close: fn(&&self) { print("closed {self.fd}") }
    }
}

Feed: struct {
    stream: Stream
    listeners: [fn() -> Int]
    peers: [Shared<Feed>]
}

seven: fn() -> Int {
    7
}

run: fn() {
    feed: Shared{Feed{stream: Stream{fd: 7}, listeners: [], peers: []}}
    back: feed.downgrade()
    listener: fn() -> Int { if back.upgrade() == .Val(f) -> f.stream.fd else -> 0 }
    feed.listeners.push(listener)
    feed.listeners.push(seven)
    twin: Shared{Feed{stream: Stream{fd: 8}, listeners: [], peers: []}}
    other: twin.copy()
    feed.peers.sort_by(fn(peer) { peer.strong_count() - other.strong_count() })
    print("end {feed.listeners.len()} {feed.peers.len()}")
}
