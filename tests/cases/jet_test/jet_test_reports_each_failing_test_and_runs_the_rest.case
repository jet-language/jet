# #6185: a failing assert (E3001) in one test, and a test process that dies at
# exit (E3013 parked task) after streaming every outcome, are each reported as
# that test's FAIL row; the tests after them still run, on none/basic/full.
fixture: jet_test_reports_each_failing_test_and_runs_the_rest.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet test --show-default --capture=all --serial --optimize=none .
exit: 1
stdout: ~ "before the failures: pass" # the first clean test keeps its batch outcome
stdout: ~ "fails an assert: FAIL" # the failing assert is that test's row
stdout: ~ "between the failures: pass" # a test after the failing assert still runs
stdout: ~ "leaves a parked task: FAIL" # the isolated rerun attributes the exit to its test
stdout: ~ "after the failures: pass" # a test after the parked task still runs
stdout: ~ "3 passed, 2 failed, 0 skipped" # every test is counted once
stderr: !~ "internal compiler error" # the run reports per test instead of an ICE
step: jet test --show-default --capture=all --optimize=none .
exit: 1
stdout: ~ "fails an assert: FAIL" # the parallel path reports the assert per test
stdout: ~ "leaves a parked task: FAIL" # the parallel rerun attributes the exit too
stdout: ~ "3 passed, 2 failed, 0 skipped" # the parallel run counts the same rows
stderr: !~ "internal compiler error" # no ICE on the parallel path either
step: jet test --show-default --capture=all --serial --optimize=basic .
exit: 1
stdout: ~ "fails an assert: FAIL" # basic optimization reports the assert per test
stdout: ~ "leaves a parked task: FAIL" # basic optimization attributes the exit
stdout: ~ "3 passed, 2 failed, 0 skipped" # basic optimization runs every test
stderr: !~ "internal compiler error" # no ICE under basic optimization
step: jet test --show-default --capture=all --serial --optimize=full .
exit: 1
stdout: ~ "fails an assert: FAIL" # full optimization reports the assert per test
stdout: ~ "leaves a parked task: FAIL" # full optimization attributes the exit
stdout: ~ "3 passed, 2 failed, 0 skipped" # full optimization runs every test
stderr: !~ "internal compiler error" # no ICE under full optimization
