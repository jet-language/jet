# #6301: `jet test tests/guards/diagnostic_pages.jet` builds and runs the whole
# guards package. Quadratic Docs scans in truthfulness.jet drove its test
# harness past 12 GB until the host killed it. After the fix, on dev
# 0fe442db9b, the process tree peaked at about 3550 MiB resident: 603 MiB for
# jet plus 2947 MiB for the harness, sampled every 2 s. If a guard regresses
# above the 4 GiB tree budget, this case fails. It checks memory, not the guard
# verdicts: the run must finish and report its summary, whatever the outcomes.
# The guards read the repository relative to the working directory, and a
# `cwd:` may not leave the case's work directory, so the step enters the root.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: sh -c "cd '{root}' && exec '{jet}' test tests/guards/diagnostic_pages.jet"
limit: time=900 resident=4194304
exit: in [0, 1] # the guards' own verdicts (all pass or some fail) are not this case's subject
stdout: ~ " skipped" # the harness reports every test instead of dying
stderr: !~ "internal compiler error" # the run builds and reports without an ICE
