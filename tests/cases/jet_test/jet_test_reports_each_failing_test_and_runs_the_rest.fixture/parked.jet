// One test fails an assert and another registers an exit handler that
// panics, so its test process dies at exit after every outcome has
// streamed. A third leaves a detached task parked on a full channel, which
// the exit cancels, so it passes. The run still reports each test, and the
// tests after either culprit run and pass.
use {
    os: core.sys
    tasks: core.tasks
}

#Test("before the failures") { assert(true) }

#Test("fails an assert") { assert_eq(1 + 1, 3) }

#Test("between the failures") { assert(true) }

#Test("leaves a parked task") {
    (sender, receiver): channel<Int>(1)
    sender.send(1)
    blocked: task &&sender {
        sender.send(2)
        receiver.close()
    }
    blocked.detach()
    tasks.yield_now()
}

#Test("fails at exit") {
    #Unsafe("the exit callback has no captured state") {
        os.atexit(fn() { panic("exit handler fails") })
    }
}

#Test("after the failures") { assert(true) }
