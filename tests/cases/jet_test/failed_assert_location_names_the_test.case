# D-DIAG-CORE-NAME1: a failing assert's location names the test
# as its source does, never by the checked test key (module identity, the
# `::test::` marker and the source span).
fixture: failed_assert_location_names_the_test.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet test --show-default --capture=all --serial main.jet
exit: 1
stdout: ~ "total adds both prices: FAIL" # the failing test's report line
stderr: ~ "Stop [E3001]: `panic: expected: 7, got: 6`" # the assert's stop
stderr: ~ "--> main.jet:6 in test \"total adds both prices\"" # the user's own test name
stderr: !~ "::test::" # no checked test key
stderr: !~ "module:" # no internal module identity
