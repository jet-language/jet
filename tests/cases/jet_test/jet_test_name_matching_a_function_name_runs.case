# `add: fn` plus `#Test("add")` checks clean under `jet test`, which runs test "add" and passes. Test names
# share a namespace only with other test names (tests/ui/test_duplicate_name keeps the duplicate-test E0105).
fixture: jet_test_name_matching_a_function_name_runs.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet test --show-default --capture=all --serial -O0 .
exit: 0
stderr: !~ "E0105" # a test named after a function is not a second definition
stdout: ~ "add: pass" # the test labelled "add" runs and passes
stdout: ~ "1 passed, 0 failed, 0 skipped" # it is the one test
