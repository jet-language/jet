# A release gate's release side: a newer jet runs the corpus and an older jet
# runs the rows, each against its own tree. JET_TEST_TOOLCHAIN_ROOT names the
# rows' tree, here `old`, which lacks every Core file. The runner still reads
# its own tree's Core through JET_TOOLCHAIN_ROOT: it builds and runs main.jet
# and runs the inner corpus. The inner row (inner/row.txt, copied in so this
# corpus does not collect it) sees `old` as its JET_TOOLCHAIN_ROOT and no
# JET_TEST_TOOLCHAIN_ROOT.
fixture: corpus_rows_read_an_older_toolchain_tree_beside_a_newer_runner.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_TEST_TOOLCHAIN_ROOT={work}/old
step: mkdir -p old/Core old/Compiler/Prelude inner/cases
exit: 0
step: cp inner/row.txt inner/cases/row.case
exit: 0
step: jet run main.jet
exit: 0
stdout: = "runner reads its own Core\n"
step: jet test inner --profile rows
exit: 0
stdout: ~ "cases/row.case" # the inner corpus ran its row
stdout: ~ "\"PASS\":1,\"FAIL\":0" # the row passed: it read the older tree
