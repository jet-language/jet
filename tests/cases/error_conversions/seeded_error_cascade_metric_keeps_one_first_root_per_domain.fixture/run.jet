// E2392: repeated helper-domain failures collapse to one root while an
// independent failure domain remains visible.
#Error
SourceErr: enum {
    Missing
}

#Error
TargetErr: enum {
    Wrapped
}

#Error
OtherSourceErr: enum {
    Missing
}

#Error
OtherTargetErr: enum {
    Wrapped
}

load_row: fn() -> Int SourceErr! { return Err(SourceErr.Missing) }

load_other: fn() -> Int OtherSourceErr! { return Err(OtherSourceErr.Missing) }

job: fn() -> Int TargetErr! {
    load_row()
    load_row()
    load_row()
    load_row()
    load_row()
    return Ok(0)
}

other_run: fn() -> Int OtherTargetErr! {
    load_other()
    load_other()
    return Ok(0)
}
