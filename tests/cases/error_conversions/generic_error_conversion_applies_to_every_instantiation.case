# A conversion declared for a generic error type, `impl Err.From(Unsent)`,
# applies to every instantiation as it does to a plain error type: an
# `Unsent<Int>` failure reaches `Err` through the declared routine at a
# `?(text)` site and at a bare failing call, in a plain helper, in a generic
# one (`Unsent<T>`, built as `Unsent<String>`) and at the end of `run`, on
# O0, O1 and O2. plain.jet is the same program over a plain
# error type and still converts.
fixture: generic_error_conversion_applies_to_every_instantiation.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 1
stdout: = "kept 7\n0\n-1\n0\n-1\n1\n-1\n"
stderr: ~ "send on a closed channel" # run ends with the converted Err's message
stderr: ~ "conversion: Unsent" # the report names the declared conversion
step: jet run -O1 main.jet
exit: 1
stdout: = "kept 7\n0\n-1\n0\n-1\n1\n-1\n"
stderr: ~ "send on a closed channel" # run ends with the converted Err's message
step: jet run -O2 main.jet
exit: 1
stdout: = "kept 7\n0\n-1\n0\n-1\n1\n-1\n"
stderr: ~ "send on a closed channel" # run ends with the converted Err's message
step: jet run -O0 plain.jet
exit: 1
stdout: = "kept 7\n0\n-1\n0\n-1\n"
stderr: ~ "send on a closed channel" # run ends with the converted Err's message
stderr: ~ "conversion: Unsent -> Err" # the plain type keeps its declared conversion
