# An error conversion whose last line is the bare target value converts like
# a function's tail value, with no statement error and no redundant-return
# advice, and every tier prints the same.
fixture: conversion_body_tail_value_is_the_converted_error.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
stderr: !~ "L0530" # the bare tail value is the conversion's value, so no redundant-return advice
step: jet run -O0 main.jet
exit: 0
stdout: = "ok 9\nfailed 107 read\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "ok 9\nfailed 107 read\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "ok 9\nfailed 107 read\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "ok 9\nfailed 107 read\n"
