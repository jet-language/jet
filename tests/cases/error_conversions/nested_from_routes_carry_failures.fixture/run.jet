// Conversions written in the failure domain's own body route as top-level
// ones do: `?` takes each, and `AppErr{failure}` (no field is named
// `failure`) is `AppErr.from(failure)`.
#Error
ReadErr: struct {
    code: Int
}

#Error
ParseErr: struct {
    line: Int
}

#Error
AppErr: struct {
    code: Int
    origin: String

    impl From(ReadErr) {
        from: fn(error: ReadErr) -> AppErr {
            AppErr{code: error.code, origin: "read"}
        }
    }

    impl From(ParseErr) {
        from: fn(error: ParseErr) -> AppErr {
            AppErr{code: error.line, origin: "parse"}
        }
    }
}

read: fn(n: Int) -> Int ReadErr! {
    if n < 0 -> return Err(ReadErr{code: 7})
    Ok(n)
}

parse: fn(n: Int) -> Int ParseErr! {
    if n > 9 -> return Err(ParseErr{line: n})
    Ok(n)
}

load: fn(n: Int) -> Int AppErr! {
    value: read(n)
    checked: parse(value)
    Ok(checked)
}

show: fn(n: Int) {
    if load(n) == {
        .Ok(ok) -> print("ok {ok}")
        .Err(failure) -> print("failed {failure.code} {failure.origin}")
    }
}

run: fn() {
    show(4)
    show(-1)
    show(12)
    failure: ReadErr{code: 5}
    built: AppErr{failure}
    print("built {built.code} {built.origin}")
}
