
#Error
StoreErr: enum { Missing }

impl Err.From(StoreErr) {
    from: fn(error: StoreErr) -> Err {
        return Err("missing")
    }
}

read_store: fn() -> Int StoreErr! {
    return Err(StoreErr.Missing)
}

get_user: fn() -> Int {
    return Ok(read_store())
}

run: fn() {
    print(get_user())
}
