// An error conversion's last line is the converted value, as a function's is.
#Error
ReadErr: struct {
    code: Int
}

#Error
AppErr: struct {
    code: Int
    origin: String
}

impl AppErr.From(ReadErr) {
    from: fn(error: ReadErr) -> AppErr {
        AppErr{code: error.code + 100, origin: "read"}
    }
}

read: fn(n: Int) -> Int ReadErr! {
    if n < 0 -> return Err(ReadErr{code: 7})
    Ok(n * 2)
}

load: fn(n: Int) -> Int AppErr! {
    value: read(n)
    Ok(value + 1)
}

show: fn(n: Int) {
    if load(n) == {
        .Ok(ok) -> print("ok {ok}")
        .Err(failure) -> print("failed {failure.code} {failure.origin}")
    }
}

run: fn() {
    show(4)
    show(-1)
}
