
#Error
SourceErr: enum { One }
#Error
TargetErr: enum { One }

fetch: fn() -> [U8] SourceErr! {
    return Err(SourceErr.One)
}

width: fn(bytes: [U8]) -> Int Never! { bytes.len() }

load: fn() -> Int TargetErr! {
    raw: fetch()
    owned: raw.copy()
    size: owned.len() + 1
    doubled: size * 2
    if width(owned) != doubled -> return Ok(1)
    count := size
    count = count + 1
    return Ok(0)
}

run: fn() {
    print(load() ?? 0)
}
