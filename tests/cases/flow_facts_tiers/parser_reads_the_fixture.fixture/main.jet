
label: fn(text: String?) -> String {
    if text != None {
        return text
    }
    return "none"
}

score: fn(flag: Bool) -> Int {
    total := 0
    if {
        flag -> total = 2
        else -> total = 3
    }
    return total
}

run: fn() {
    print(label(Val("keep")))
    print(label(None))
    print(score(true))
    print(score(false))
}
