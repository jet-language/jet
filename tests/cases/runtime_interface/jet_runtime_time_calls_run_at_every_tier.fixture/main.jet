// A user package calls the runtime's public time functions through
// `jet.runtime.time`: each call lowers to the runtime export its interface
// row names, across every route carrier (a word, text, an Option, a List and a
// tuple result), under `jet run` at every optimization level and in a built
// binary. `task.timeout` reaches the same export through core.time.
use {
    rt: jet.runtime.time
    time: core.time
}

run: fn() -[IO, Env, FS.Read, Time]> {
    rt.reject_uncontrolled("clock")
    start: rt.host_monotonic_ns()
    rt.task_timeout(60000000000)
    task.timeout(60s)
    rt.sleep_ns(2000000)
    elapsed: rt.host_monotonic_ns() - start
    print("slept at least 2 ms: {elapsed >= 2000000}")
    print("pure clock agrees: {rt.clock_mono_ns() >= start + elapsed}")
    sample: rt.wall_sample()
    print("wall clock after 2020: {!sample.pre_epoch && sample.epoch_seconds > 1577836800}")
    print("fraction in range: {sample.fraction_ns >= 0 && sample.fraction_ns < 1000000000}")
    print("no world clock: {rt.world_wall_ms() == None && rt.world_monotonic_ns() == None}")
    print("no override: {rt.wall_override_ms() == None && rt.controlled_monotonic_ns() == None}")
    print("zone env: {rt.zone_env("JET_RUNTIME_TIME_CASE_UNSET") ?? "unset"}")
    print("missing zone file: {rt.zone_file_bytes("/nonexistent/jet/zone") == None}")
    print("no embedded zone: {rt.embedded_zone_bytes("Europe/Paris") == None}")
    print("core.time over jet.runtime.time: {time.elapsed(time.start()) >= 0ms}")
}
