# A user package calls jet.runtime.term, jet.runtime.log, jet.runtime.encoding
# and jet.runtime.process members. Each call lowers through the route its
# interface signature projects (a flag, a word, text, a List argument, an
# Option result, an Option of a tuple, tuple results with List and Option
# items) to the runtime export the row names, so the program prints the same
# lines at O0, O1 and O2 and from the binary `jet build` makes.
fixture: jet_runtime_term_log_encoding_process_calls_run_at_every_tier.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_term_log_encoding_process_calls_run_at_every_tier.out
step: jet run --optimize=basic main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_term_log_encoding_process_calls_run_at_every_tier.out
step: jet run --optimize=full main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_term_log_encoding_process_calls_run_at_every_tier.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = jet_runtime_term_log_encoding_process_calls_run_at_every_tier.out
