# A user package calls every jet.runtime.time member and `task.timeout`. Each
# call lowers through the route its interface signature projects (a word,
# text, an Option, a List or a tuple result) to the runtime export the row
# names, so the program prints the same lines at O0, O1 and O2 and from the
# binary `jet build` makes.
fixture: jet_runtime_time_calls_run_at_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_time_calls_run_at_every_tier.out
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_time_calls_run_at_every_tier.out
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = jet_runtime_time_calls_run_at_every_tier.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = jet_runtime_time_calls_run_at_every_tier.out
