package: {
    name: "os_family_value"
    authority: { allow: [Env, IO] }
}

use files: jet.runtime.files

// The platform family has no effect row, and it is the machine the program
// runs on: a build would answer with its own, a cross build with another's.
FAMILY: files.os_family()

run: fn() {
    print(FAMILY)
}
