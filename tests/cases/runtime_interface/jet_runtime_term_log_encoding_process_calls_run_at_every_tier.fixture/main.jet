// A user package calls the runtime's public stdio, terminal, logging,
// encoding and signal functions through `jet.runtime.term`, `.log`,
// `.encoding` and `.process`: each call lowers to the runtime export its
// interface row names, across the route carriers (a flag, a word, text, a
// List argument, an Option result, an Option of a tuple, and tuple results
// with List and Option items), under `jet run` at every optimization level
// and in a built binary.
use {
    enc: jet.runtime.encoding
    log: jet.runtime.log
    proc: jet.runtime.process
    term: jet.runtime.term
}

run: fn() -[IO, Log, Exec]> {
    print("stdio write: {term.stdio_put_text("written by jet.runtime.term", true, false) == None}")
    print("stdio bytes: {term.stdio_put_bytes([U8]{111, 107, 10}, false) == None}")
    print("stdio flush: {term.stdio_flush(false) == None && term.stdio_flush(true) == None}")
    print("no stdio fault: {!term.stdio_fault("write") && !term.terminal8_fault("write")}")
    print("stdout is a pipe: {!term.stdout_terminal() && !term.terminal8_stdout_tty()}")
    print("env: {term.terminal8_env("JET_RUNTIME_TERM_CASE_UNSET") ?? "unset"} {term.terminal8_env_has("JET_RUNTIME_TERM_CASE_UNSET")}")
    taken: term.terminal8_take(0)
    print("take none: {taken.bytes.len() == 0 && taken.read_error == None}")
    stty_ok := true
    if term.terminal8_stty() == .Val(size) -> stty_ok = size.h > 0 && size.w > 0
    print("stty answers: {stty_ok}")
    print("color mode: {term.terminal8_color_mode() >= 0}")

    level: log.level_load()
    log.level_store(level)
    disabled: log.disabled_load()
    log.disabled_store(disabled)
    print("log cells kept: {log.level_load() == level && log.disabled_load() == disabled}")
    log.filter_store("jet=debug")
    print("filter: {log.filter_load()}")
    log.filter_store("")
    print("filter cleared: {log.filter_load() == ""}")
    span: log.span_allocate("case")
    print("span: {span.name} {span.id > 0}")
    log.metric_publish("case", 1)
    log.trace_store("case-trace")
    log.flush()

    cells: enc.text_cells_enter()
    enc.text_cells_leave(cells)
    mode: enc.etf_strings_enter(1)
    print("etf mode round trip: {enc.etf_strings_enter(mode) == 1}")
    enc.etf_strings_leave(mode)

    subscription: proc.signal_open(false)
    proc.signal_close(subscription)
    usr1: proc.signal_disposition(10, false)
    print("SIGUSR1 default: {usr1.available && usr1.disposition == 0 && usr1.errno == 0}")
}
