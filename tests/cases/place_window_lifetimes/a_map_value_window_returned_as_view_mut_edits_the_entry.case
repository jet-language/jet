# `&m[key]` where a `ViewMut` of the map's value type is expected (a returned
# window, a `ViewMut` parameter) is a window over that one map value, used as
# `w[0]` like a one-element list window: edits through it reach the entry on
# every tier. While it lives the map cannot gain an entry (the loan the list
# window records), and a missing key stops as `m[key]` does.
fixture: a_map_value_window_returned_as_view_mut_edits_the_entry.fixture
env: NO_COLOR=1
step check: jet check slot.jet
exit: 0
step o0: jet run -O0 slot.jet
exit: 0
stdout: = "1\n1 7 0\n"
step o1: jet run -O1 slot.jet
exit: 0
stdout: = "1\n1 7 0\n"
step o2: jet run -O2 slot.jet
exit: 0
stdout: = "1\n1 7 0\n"
step pass_o0: jet run -O0 pass.jet
exit: 0
stdout: = "1\n"
step pass_o2: jet run -O2 pass.jet
exit: 0
stdout: = "1\n"
step grow: jet check grow.jet
exit: 1
stderr: ~ "Error [jet.ReadDuringWriteWindow]" # the map write is refused; the snapshot is tests/ui/ownership/map_value_window_blocks_map_growth
stderr: ~ "grow.jet:10:5" # at the map write
step missing_o0: jet run -O0 missing.jet
exit: 70
stdout: = ""
stderr: ~ "the map has no entry for key \"z\"" # the stop message; the stderr also carries the stop's location
step missing_o1: jet run -O1 missing.jet
exit: 70
stdout: = ""
stderr: ~ "the map has no entry for key \"z\"" # the stop message; the stderr also carries the stop's location
step missing_o2: jet run -O2 missing.jet
exit: 70
stdout: = ""
stderr: ~ "the map has no entry for key \"z\"" # the stop message; the stderr also carries the stop's location
