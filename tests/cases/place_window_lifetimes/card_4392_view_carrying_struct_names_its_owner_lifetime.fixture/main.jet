
Record: struct {
    kind: View<str>
    body: View<str>
}
split: fn(header: String, payload: String) -> Record {
    kind: header.after(":")
    body: payload.after(":")
    return Record{kind: kind, body: body}
}
run: fn() {
    header: "kind:message"
    payload: "body:hello"
    record: split(header, payload)
    kind: record.kind
    body: record.body
    print(kind.copy())
    print(body.copy())
}
