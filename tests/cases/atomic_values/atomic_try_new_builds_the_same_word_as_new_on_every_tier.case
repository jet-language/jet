# Atomic.try_new checks, builds and runs on every tier: it takes the same
# frame word Atomic.new does, so its Result is Ok and the word answers
# add, compare_exchange, store and load.
fixture: atomic_try_new_builds_the_same_word_as_new_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = atomic_try_new_builds_the_same_word_as_new_on_every_tier.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = atomic_try_new_builds_the_same_word_as_new_on_every_tier.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = atomic_try_new_builds_the_same_word_as_new_on_every_tier.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = atomic_try_new_builds_the_same_word_as_new_on_every_tier.out
