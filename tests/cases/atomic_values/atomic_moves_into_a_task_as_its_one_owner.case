# An `Atomic<Int>` is not cloneable, so a task capture of it, alone
# or inside a struct, moves it and the task becomes its one owner. The crossing
# prover accepts it instead of E1102, and the task's writes are what it returns,
# on every tier. A copy stays refused (tests/ui/atomic_record_copy_noncloneable).
fixture: atomic_moves_into_a_task_as_its_one_owner.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = atomic_moves_into_a_task_as_its_one_owner.out
step: jet run -O1 main.jet
exit: 0
stdout: = atomic_moves_into_a_task_as_its_one_owner.out
step: jet run -O2 main.jet
exit: 0
stdout: = atomic_moves_into_a_task_as_its_one_owner.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = atomic_moves_into_a_task_as_its_one_owner.out
