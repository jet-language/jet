use core.mem

run: fn() {
    #Unsafe("the copy writes one Int past the target block") {
        source: mem.alloc_raw(32, 8) ?? panic("no memory")
        target: mem.alloc_raw(16, 8) ?? panic("no memory")
        mem.fill<Int>(source.cast<Int>(), 3, 4)
        mem.copy<Int>(target.cast<Int>(), source.cast<Int>(), 2)
        print(target.cast<Int>().*)
        mem.copy<Int>(target.cast<Int>(), source.cast<Int>(), 3)
        print("copied")
        mem.free_raw(source)
        mem.free_raw(target)
    }
}
