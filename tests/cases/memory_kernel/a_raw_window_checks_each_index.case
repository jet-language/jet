# `mem.window(owner, p, len)` gives a `View<T>` over the `len` Ts at `p`,
# tied to `owner`: `w.len()` and `w[i]` reach only elements inside
# `0..<len`, `w.get(i)` is None past the end, and a negative length is an
# empty View, on every tier. Reading one past the end stops with the View's
# bounds stop before any byte is touched. A capability's View read after the
# capability is released is refused before the program runs (E0212).
fixture: a_raw_window_checks_each_index.fixture
env: NO_COLOR=1
step check: jet check main.jet
exit: 0
step o0: jet run -O0 main.jet
exit: 0
stdout: = "4 11 44\n20\npast refused\n0\n"
step o1: jet run -O1 main.jet
exit: 0
stdout: = "4 11 44\n20\npast refused\n0\n"
step o2: jet run -O2 main.jet
exit: 0
stdout: = "4 11 44\n20\npast refused\n0\n"
when tool node
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = "4 11 44\n20\npast refused\n0\n"
end when
step pastnone: jet run -O0 past.jet
exit: 70
stdout: = "33\n"
stderr: ~ "Stop [E3010]" # the View's bounds stop, whose source line follows
stderr: ~ "print(ints[4])" # the stop quotes the faulting index
step pastfull: jet run -O2 past.jet
exit: 70
stdout: = "33\n"
stderr: ~ "Stop [E3010]" # the View's bounds stop, whose source line follows
stderr: ~ "print(ints[4])" # the stop quotes the faulting index
step released: jet check released.jet
exit: 1
stderr: ~ "Error [jet.OwnerMovedWhileViewed]" # the release moves the owner while its View is still read
stderr: ~ "released.jet:37:13" # at `release(words)`
step releasedrun: jet run -O2 released.jet
exit: == released
stdout: = ""
