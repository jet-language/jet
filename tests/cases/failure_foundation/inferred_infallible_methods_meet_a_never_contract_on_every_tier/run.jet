// `twice` and `next` write no failure contract and cannot fail, so the solve
// proves them `Int Never!` and `total`'s `Never!` contract holds; `checked`
// can fail, so `risky`, which calls it, keeps its default route.
Counter: struct {
    n: Int

    twice: fn(self) -> Int { self.n * 2 }
    next: fn(self) -> Int { self.twice() + 1 }
    checked: fn(self) -> Int {
        if self.n < 0 -> return Err("negative count")
        self.n
    }
    risky: fn(self) -> Int { self.checked() + 1 }
}

total: fn(c: Counter) -> Int Never! { c.next() }

run: fn() {
    print(total(Counter{n: 20}))
    print(Counter{n: 4}.risky())
    print(Counter{n: -1}.risky() ?? 0)
}
