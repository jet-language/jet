# A callback that calls an unannotated function takes that function's
# inferred effect (#6281 c173, c174): helpers that cannot fail, called from
# `filter`, `sort_by`, `map` and local callbacks (one of them a file function
# named `text`), leave the enclosing functions infallible, so `Never!` and
# `Failure!` callers accept them on every tier. A callee that can fail keeps
# its `Err` route: the caller sees the failure, and a `Never!` caller is E2404.
fixture: callbacks_take_the_callee_inferred_effect_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "ones 3 ordered 54321 descriptors d1d2d3d4d5 local 6 named 1\n1\n4\n-1\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "ones 3 ordered 54321 descriptors d1d2d3d4d5 local 6 named 1\n1\n4\n-1\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "ones 3 ordered 54321 descriptors d1d2d3d4d5 local 6 named 1\n1\n4\n-1\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "ones 3 ordered 54321 descriptors d1d2d3d4d5 local 6 named 1\n1\n4\n-1\n"
step: jet check fallible.jet
exit: nonzero
stderr: ~ "[jet.ErrorNotPropagatable]" # E2404: `positives` keeps the `Err` its callback's callee can fail with
stderr: ~ "fallible.jet:11:41" # the `positives(rows)` call in the `Never!` body
