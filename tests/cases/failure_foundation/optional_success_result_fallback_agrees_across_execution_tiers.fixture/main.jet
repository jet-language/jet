
#Error
TestFailure: enum {
    Missing
}

optional_success_result: fn(value: Int) -> Int? TestFailure! {
    if value == -1 {
        return Err(TestFailure.Missing)
    }
    if value == 0 {
        return None
    }
    return Ok(Val(value))
}

run: fn() {
    print(optional_success_result(8080) ?? 0)
    print(optional_success_result(0) ?? 0)
    print(optional_success_result(-1) ?? 0)
}
