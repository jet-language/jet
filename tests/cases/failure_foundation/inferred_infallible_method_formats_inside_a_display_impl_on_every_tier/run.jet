// A Display body interpolates an inherent method whose failure set the
// solve proves empty (`count` calls `words`, neither can fail), next to a
// generic Display that prints, a callback-taking method, and an attributed type.
use files: core.files

#Equatable
Parser: struct {
    text: String
}

impl Parser {
    words: fn(self) -> [String] { self.text.split(" ").to_list() }
    count: fn(self) -> Int { self.words().len() }

    // `visit` is the caller's function: what it does is the caller's.
    each: fn(self, visit: fn(String)) {
        loop word in self.words() -> visit(word)
    }
}

impl Parser.Display {
    display: fn(self) -> String { "Parser of {self.count()} words" }
}

Traced: struct<T: Printable> {
    inner: T
}

impl Traced.Display {
    display: fn(self) -> String {
        print("trace: display")
        "{self.inner}"
    }
}

run: fn() {
    parser: Parser{text: files.read("notes.md") ?? "a b c"}
    print(parser.count())
    parser.each((word: String) -> print(word))
    print(Traced<Parser>{inner: parser})
}
