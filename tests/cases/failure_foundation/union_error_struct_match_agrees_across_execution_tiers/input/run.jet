
#Error
ListWasEmpty: struct {
    message: String
}

#Error
BadNumStr: struct {
    message: String
}

first: fn(xs: [String]) -> String ListWasEmpty! {
    if xs.is_empty() -> return Err(ListWasEmpty{message: "empty"})
    Ok(xs[0])
}

to_num: fn(s: String) -> Int BadNumStr! {
    s.to_int() ?? return Err(BadNumStr{message: "nan"})
}

increment_first: fn(xs: [String]) -> Int (ListWasEmpty | BadNumStr)! {
    s: first(xs)
    n: to_num(s)
    Ok(n + 1)
}

run: fn() {
    loop xs in [["41"], [], ["x"]] {
        if increment_first(xs) == {
            .Ok(n) -> print(n)
            .Err(.ListWasEmpty(_)) -> print("empty")
            .Err(.BadNumStr(_)) -> print("not a number")
        }
    }
}
