# A function with an inferred failure union includes the failures of its
# unit-returning statements whose arguments read a value a typed failure
# guards: `files.write`, a stream `write` and a call of a function
# with a written `IOError!` contract each join `Parity | IOError`, so the check
# passes, every tier runs, and the callers match both members. Before the fix
# the union missed them: E2404 on the recheck, or an ir.build fault on a Core
# body no check demanded.
fixture: inferred_union_keeps_unit_statement_failures_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step: jet run -O0 main.jet
exit: 0
stdout: = "saved ab.txt\nodd abc.txt\nio no/such/xy.txt\ncopied 6\ncopy cd.txt\nodd abc.txt\nio absent.txt\nstored ef.txt\nodd efg.txt\nio no/such/xy.txt\njet! has 4\nannounced\nodd odd\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "saved ab.txt\nodd abc.txt\nio no/such/xy.txt\ncopied 6\ncopy cd.txt\nodd abc.txt\nio absent.txt\nstored ef.txt\nodd efg.txt\nio no/such/xy.txt\njet! has 4\nannounced\nodd odd\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "saved ab.txt\nodd abc.txt\nio no/such/xy.txt\ncopied 6\ncopy cd.txt\nodd abc.txt\nio absent.txt\nstored ef.txt\nodd efg.txt\nio no/such/xy.txt\njet! has 4\nannounced\nodd odd\n"
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = "saved ab.txt\nodd abc.txt\nio no/such/xy.txt\ncopied 6\ncopy cd.txt\nodd abc.txt\nio absent.txt\nstored ef.txt\nodd efg.txt\nio no/such/xy.txt\njet! has 4\nannounced\nodd odd\n"
