// A callback whose callee can fail keeps that failure: `positives` stays on
// the default `Err` route, so a `Never!` caller is E2404.

checked: fn(row: Int) -> Int {
    if row < 0 -> return Err("negative {row}")
    row
}

positives: fn(rows: [Int]) -> Int { rows.filter((row: Int) -> checked(row) > 1).len() }

strict: fn(rows: [Int]) -> Int Never! { positives(rows) }

run: fn() {}
