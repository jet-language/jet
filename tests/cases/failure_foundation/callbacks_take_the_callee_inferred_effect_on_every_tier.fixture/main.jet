// #6281 c173/c174: a callback that calls an unannotated function takes the
// effect the bundle failure solve infers for that function, as a direct call
// does. `score`, `row_key`, `descriptor` and `text` cannot fail, so the
// functions whose `filter`, `sort_by`, `map` and local callbacks call them are
// written without `!` and stay infallible: the `Never!` and `Failure!`
// callers below accept them. `checked` can fail, so `positives` keeps the
// default `Err` route and its failure reaches the caller.

#Error
Failure: struct {
    message: String
}

score: fn(row: Int, key: String) -> Int {
    if key == "odd" -> return row % 2
    row
}

row_key: fn(row: Int) -> String { "{9 - row}" }

descriptor: fn(row: Int) -> String { "d{row}" }

// A file function named `text` is the callee a callback names (c174).
text: fn(row: Int, key: String) -> String { "{key}{row}" }

checked: fn(row: Int) -> Int {
    if row < 0 -> return Err("negative {row}")
    row
}

ones: fn(rows: [Int]) -> Int { rows.filter(fn(row: Int) { score(row, "odd") == 1 }).len() }

ordered: fn(rows: [Int]) -> [Int] {
    sorted := rows.copy()
    sorted.sort_by(fn(row: Int) { row_key(row) })
    sorted
}

descriptors: fn(rows: [Int]) -> [String] { rows.map(fn(row: Int) { descriptor(row) }) }

local: fn(row: Int) -> Int {
    twice: fn(value: Int) -> Int { score(value, "all") * 2 }
    twice(row)
}

named: fn(rows: [Int]) -> Int { rows.filter(fn(row: Int) { text(row, "x") == "x1" }).len() }

joined: fn(values: [Int]) -> String {
    out := ""
    loop value in values -> out = "{out}{value}"
    out
}

joined_text: fn(values: [String]) -> String {
    out := ""
    loop value in values -> out = "{out}{value}"
    out
}

// Every helper caller above is infallible, so a `Never!` body may call each.
summary: fn(rows: [Int]) -> String Never! {
    "ones {ones(rows)} ordered {joined(ordered(rows))} descriptors {joined_text(descriptors(rows))} local {local(3)} named {named(rows)}"
}

// The `filter` callback calls `text`, which cannot fail, so `filter` does not
// fail with `Err` here and the `Failure!` contract holds.
named_strict: fn(rows: [Int]) -> Int Failure! { Ok(rows.filter(fn(row: Int) { text(row, "x") == "x1" }).len()) }

// `checked` can fail: the callback adopts its carrier and `filter` fails.
positives: fn(rows: [Int]) -> Int { rows.filter(fn(row: Int) { checked(row) > 1 }).len() }

run: fn() {
    rows := [1, 2, 3, 4, 5]
    print(summary(rows))
    print(named_strict(rows) ?? -1)
    print(positives(rows) ?? -1)
    print(positives([3, -1]) ?? -1)
}
