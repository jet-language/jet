
#Error
TypedFailure: enum {
    Bad
}

#Error
OtherFailure: enum {
    Worse
}

#Error
StoreFailure: enum {
    Missing
}

// Omitted contract: the effective route is Int !Err.
implicit: fn(value: Int) -> Int {
    if value == 0 {
        return Err("implicit")
    }
    return value
}

// Expert opt-out: a named error domain.
explicit: fn(value: Int) -> Int TypedFailure! {
    if value == 0 {
        return Err(TypedFailure.Bad)
    }
    return value
}

// Expert opt-out: an error union widens a member failure.
union: fn(value: Int) -> Int (TypedFailure | OtherFailure)! {
    if value == 0 {
        return Err(TypedFailure.Bad)
    }
    return value
}

// One declared conversion crosses from a named error into default Err.
impl Err.From(StoreFailure) {
    from: fn(error: StoreFailure) -> Err { return Err("converted") }
}

converted: fn(value: Int) -> Int StoreFailure! {
    if value == 0 {
        return Err(StoreFailure.Missing)
    }
    return value
}

contextual_source: fn() -> Int { Err("context", code: "E_CONTEXT", cause: Err("root")) }

// `?(text)` keeps the original structured error while adding one context hop.
contextual: fn() -> Int { contextual_source()?("loading") }

// Optional success still rides the Result-shaped carrier.
optional_success: fn(value: Int) -> Int? {
    if value == 0 {
        return None
    }
    return Val(value)
}

// Unit success still propagates a failure through the same carrier.
unit_success: fn(fail: Bool) {
    if fail {
        return Err("unit")
    }
}

unit_caller: fn(fail: Bool) -> Int {
    unit_success(fail)
    return 7
}

// Function values retain their fallible contract.
apply: fn(callback: fn(Int) -> Int, value: Int) -> Int { callback(value) }

// Generic call results use the same automatic propagation rule.
generic_forward: fn<T>(value: T) -> T { value }

generic_caller: fn(value: Int) -> Int { generic_forward<Int>(implicit(value)) }

// No reachable failure: the !Never proof is a valid contract.
impossible: fn() -> Int Never! { 7 }

run: fn() {
    print(implicit(2) ?? -1)
    print(implicit(0) ?? -1)
    print(explicit(2) ?? -2)
    print(explicit(0) ?? -2)
    print(union(2) ?? -3)
    print(union(0) ?? -3)
    print(converted(2) ?? -4)
    print(converted(0) ?? -4)
    print(contextual() ?? -5)
    print(optional_success(2) ?? -6)
    print(optional_success(0) ?? -6)
    print(unit_caller(false) ?? -7)
    print(unit_caller(true) ?? -7)
    print(apply(implicit, 2) ?? -8)
    print(apply(implicit, 0) ?? -8)
    print(generic_caller(2) ?? -9)
    print(generic_caller(0) ?? -9)
    print(impossible() ?? -10)
}
