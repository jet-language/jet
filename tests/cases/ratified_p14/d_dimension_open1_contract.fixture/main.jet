// D-DIMENSION-OPEN1 / D-DERIVED-DIMENSION-CLAIM1: the SI families are ordinary
// prelude declarations; a user base dimension uses the same surface, and a
// derived family claims its structure in its header.
#UnitFamily(Information, dimension, base: token) { token }

#UnitFamily(Throughput, dimension: Information / Time, base: token_per_second) { token_per_second }

#UnitFamily(Effort, dimension: Mass * Information, base: kilogram_token) { kilogram_token }

speed_of: fn(v: MeterPerSecond) { print(v) }

force_of: fn(f: Newton) { print(f) }

rate_of: fn(r: TokenPerSecond) { print(r) }

effort_of: fn(e: KilogramToken) { print(e) }

run: fn() {
    speed_of(10meter / 2s)
    force_of(2kilogram * 3meter / 1s / 1s)
    force_of(1newton)
    rate_of(12token / 3s)
    rate_of(1token_per_second)
    effort_of(2kilogram * 5token)
    effort_of(3kilogram_token)
}
