// D-TYPE2-SPELL1: `Int(0..100)` is legal in every type position.
Gauge: struct {
    level: Int(0..100)
}

half: fn(p: Int(0..100)) -> Int { p /% 2 }

top: fn() -> Int(0..100) { 100 }

checked: fn(raw: Int) -> Int(0..100) { Int(0..100).from_int(raw) }

run: fn() {
    g: Gauge{level: 40}
    print(g.level)
    b: Int(0..100).from_int(7)
    print(half(b))
    print(half(top()))
    print(half(g.level))
    fallback: Int(0..100).from_int(1)
    print(checked(50) ?? fallback)
    print(checked(500) ?? fallback)
    print(checked(-1) ?? fallback)
}
