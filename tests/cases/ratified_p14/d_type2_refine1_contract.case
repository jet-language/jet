# D-TYPE2-REFINE1 (#4284 c28): `distinct Int(1..6)` is the one refinement
# spelling and `#Invariant` is an unknown marker (E0927, no teaching text). The
# index prover reads the range directly: a `Die` index into `[String#7]` is one
# proved fixed_index_bounds obligation and no other index is, a `Die` index into
# `[String#6]` is refused at compile time, and a plain `Int` index keeps its
# runtime check.
fixture: d_type2_refine1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = d_type2_refine1_contract.stdout.expected
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = d_type2_refine1_contract.stdout.expected
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = d_type2_refine1_contract.stdout.expected
stderr: empty
step prove: jet prove main.jet --lens solver
exit: 0
stdout: ~ "SOLVER   proved 1; disproved 0; unknown 0; unavailable 0" # only the Die index is an obligation
stdout: ~ "  proved  fixed_index_bounds at main.jet:6:60" # the range proves `faces[roll]`
step unproved: jet run unproved/main.jet
exit: 70 # the plain Int index keeps its runtime check
stdout: = "six\n"
stderr: ~ "the list has 7 items, so position 7 doesn't exist" # the kept check stops
stderr: ~ "jet-lang.dev/e/E3010" # the runtime stop code
step out_of_range: jet check out_of_range/main.jet
exit: 1
stderr: ~ "Index 6 is out of range for a fixed-size list of 6 elements" # the range upper bound reaches the prover
stderr: ~ "--> main.jet:3:58" # located at the index
stderr: ~ "jet-lang.dev/e/E0965" # one registered code
step invariant: jet check invariant/main.jet
exit: 1
stderr: ~ "`#Invariant` isn't a known applied rule" # the retired marker is unknown
stderr: ~ "jet-lang.dev/e/E0927" # the unknown-marker code
stderr: !~ "distinct Int(" # no teaching diagnostic for the retired marker
