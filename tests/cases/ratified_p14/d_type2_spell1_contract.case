# D-TYPE2-SPELL1: `Int(0..100)` is legal as a field, a parameter, a
# result and a binding. A literal outside the range is refused at compile time
# in each position; a runtime value converts fallibly with
# `Int(0..100).from_int(raw)`, and the fallback runs when it is out of range,
# on every optimization tier.
fixture: d_type2_spell1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = d_type2_spell1_contract.stdout.expected
stderr: empty
step o1: jet run -O1 main.jet
exit: 0
stdout: = d_type2_spell1_contract.stdout.expected
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = d_type2_spell1_contract.stdout.expected
stderr: empty
step literal: jet check literal/main.jet
exit: 1
stderr: ~ "`101` is outside `Int(0..100)`'s range 0..100" # result position
stderr: ~ "--> main.jet:7:28" # located at the returned literal
stderr: ~ "`140` is outside `Int(0..100)`'s range 0..100" # field position
stderr: ~ "--> main.jet:10:21" # located at the field literal
stderr: ~ "`200` is outside `Int(0..100)`'s range 0..100" # parameter position
stderr: ~ "--> main.jet:11:16" # located at the argument literal
stderr: ~ "`500` is outside `Int(0..100)`'s range 0..100" # binding position
stderr: ~ "--> main.jet:13:29" # located at the converted literal
stderr: ~ "jet-lang.dev/e/E0135" # one registered code
