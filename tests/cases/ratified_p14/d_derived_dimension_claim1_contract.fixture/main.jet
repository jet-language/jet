// D-DERIVED-DIMENSION-CLAIM1: `Speed` claims `Length / Time` in its prelude
// header, and its base member `meter_per_second` is the coherent product of the
// base units, so `12meter / 2s` is exactly 6 of it. Scales keep their source:
// rational and symbolic scales use the ordinary path, and a measured scale
// crosses only through an explicit rounded conversion.
speed_of: fn(v: MeterPerSecond) { print(v) }

force_of: fn(f: Newton) { print(f) }

angle_of: fn(a: Radian) { print(a) }

run: fn() {
    v: 12meter / 2s
    speed_of(v)
    print(Meter{v * 3s})
    force_of(2kilogram * 3meter / 1s / 1s)
    print(Meter{2kilometer})
    angle_of(180.0degree)
}
