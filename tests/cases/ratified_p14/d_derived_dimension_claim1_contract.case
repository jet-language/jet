# D-DERIVED-DIMENSION-CLAIM1 (#4284 c26): a derived family states its structure
# beside its name, and its base member is the coherent product of the base
# dimensions' base units (scale one). `12meter / 2s` is exactly 6
# meter_per_second on every tier; a base member with its own scale is refused.
# Scale provenance: rational and symbolic scales take the ordinary path, and a
# measured scale crosses only through an explicit rounded conversion.
fixture: d_derived_dimension_claim1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = d_derived_dimension_claim1_contract.stdout.expected
stderr: empty
step o1: jet run -O1 main.jet
exit: 0
stdout: = d_derived_dimension_claim1_contract.stdout.expected
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = d_derived_dimension_claim1_contract.stdout.expected
stderr: empty
step noncoherent: jet check noncoherent/main.jet
exit: 1
stderr: ~ "Base `kilojoule_effort` changes its own scale or offset" # the base member is coherent
stderr: ~ "--> main.jet:2:5" # located at the scaled base member
stderr: ~ "Fix: Remove metadata from the base member" # keep scale one
step measured: jet check measured/main.jet
exit: 1
stderr: ~ "`Dalton` to `Kilogram` crosses a measured scale" # no implicit measured crossing
stderr: ~ "1.66053906892e-27 with standard uncertainty 5.2e-37 (BIPM-2026/CODATA-2022)" # the diagnostic keeps the provenance
stderr: ~ "--> main.jet:2:17" # located at the measured value
stderr: ~ "jet-lang.dev/e/E0127" # one registered code
step rounded: jet check rounded/main.jet
exit: 0 # the explicit rounded measured conversion is the accepted crossing
