
TOKEN: [Int]{66}
PAYLOAD: [U8]{84}
ALIAS_VALUES: [U8]{42}
IMPORT_VALUES: [U8]{43}

token_at: fn(index: Int) -> Int {
    return TOKEN[index]
}

payload_at: fn(index: Int) -> U8 {
    return PAYLOAD[index]
}

alias_value_list: fn() -> [U8] {
    return ALIAS_VALUES
}

import_value_list: fn() -> [U8] {
    return IMPORT_VALUES
}
