
TOKEN: [Int]{65}
PAYLOAD: [Int]{17}
ALIAS_VALUES: [Int]{31}

token_at: fn(index: Int) -> Int {
    return TOKEN[index]
}

payload_at: fn(index: Int) -> Int {
    return PAYLOAD[index]
}

alias_value_list: fn() -> [Int] {
    return ALIAS_VALUES
}

shadowed: fn(token: [Int]) -> Int {
    return token[0]
}
