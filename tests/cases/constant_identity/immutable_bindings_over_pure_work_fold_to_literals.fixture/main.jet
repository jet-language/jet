
square: fn(value: Int) -> Int {
    value * value
}

greet: fn(name: String) -> String {
    "hello {name}"
}

noisy: fn() -> Int {
    print("noisy")
    5
}

run: fn() {
    squared: square(12)
    greeting: greet("jet")
    total: [4, 5, 6].reduce(0, (acc: Int, n: Int) -> acc + n)
    a: 7
    b: 3
    larger: if a > b -> a * 2 else -> b
    side: noisy()
    print("{squared} {greeting} {total} {larger} {side}")
}
