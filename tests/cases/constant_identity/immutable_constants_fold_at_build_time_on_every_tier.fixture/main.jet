package: {
    name: "fold_tiers"
    authority: { allow: [IO] }
}

LIMIT: 6 * 7 + 1
greet: fn(name: String) -> String { "hello {name}" }
GREETING: greet("tiers")

local_fold: fn() -> Int Never! {
    lanes: 8 * 4 + 2
    wide: lanes * 2 - -1
    wide + 1
}

overflow_kept: fn(start: Int) -> Int Never! {
    big: 9223372036854775807 - 1
    near: big + start
    near
}

mutable_kept: fn() -> Int Never! {
    count := 2 + 3
    count += 1
    count
}

module_read: fn() -> Int Never! { LIMIT }

run: fn() {
    print(local_fold())
    print(overflow_kept(1))
    print(mutable_kept())
    print(module_read())
    print(GREETING)
}
