# #6125: `:` folds at build time as an optimization, on every tier.
# The slot IR `jet emit --ir` prints is what O0 compiles unchanged; `jet inspect
# decisions` prints it again after the O1 (default) and O2 (--release) passes.
fixture: immutable_constants_fold_at_build_time_on_every_tier.fixture
env: NO_COLOR=1
# C1: block-local Int arithmetic holds its folded value before any pass runs.
step: jet emit --ir main.jet --fn local_fold
exit: 0
stdout: ~ "local lanes: Int" # the binding keeps its slot
stdout: ~ "const s0 <- 34" # lanes: 8 * 4 + 2
stdout: ~ "const s2 <- 69" # wide: lanes * 2 - -1 reads the folded lanes
stdout: !~ "mul s" # no multiplication is left to run
stdout: !~ "jet_rt_int_clone" # the folded constant moves into its binding
step: jet emit --ir main.jet --fn overflow_kept
exit: 0
stdout: ~ "add s" # a sum that may leave i64 is computed at run time
step: jet emit --ir main.jet --fn mutable_kept
exit: 0
stdout: ~ "add s" # a `:=` binding never folds
step: jet inspect decisions main.jet
env: JET_OPT_DUMP=local_fold
exit: 0
stdout: ~ "O1:" # the default build runs the O1 passes
stdout: ~ "const s5 <- 70" # O1 folds the use site too
step: jet inspect decisions --release main.jet
env: JET_OPT_DUMP=local_fold
exit: 0
stdout: ~ "O2:" # --release runs the O2 passes
stdout: ~ "const s5 <- 70" # O2 folds the use site too
# C2: a module-level constant folds while building; one that reads the
# environment is computed at startup, with no error.
step: jet emit --ir main.jet --fn module_read
exit: 0
stdout: ~ "const s0 <- 43" # LIMIT: 6 * 7 + 1
step: jet emit --ir main.jet --fn run
exit: 0
stdout: ~ "GREETING#startup" # GREETING runs its startup function before `run: fn`
step: jet run --optimize=none main.jet
exit: 0
stdout: = immutable_constants_fold_at_build_time_on_every_tier.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = immutable_constants_fold_at_build_time_on_every_tier.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = immutable_constants_fold_at_build_time_on_every_tier.out
step: jet build main.jet
exit: 0
step: built
env: JET_FOLD_TIERS_GREETING=startup
exit: 0
stdout: ~ "startup" # the built program reads the environment when it starts
stdout: !~ "hello" # not the value the build saw
