# A `#Static` inline fixed array (the SHA-256 K table as [U32#64], a [U8#4]
# shift table) is a shared addressable constant: a hot loop indexing it reads
# the static object in place and builds no copy of the array on its stack. A
# mutable local copy of it still takes its own elements, and the values match
# on o0, o1 and o2.
fixture: static_fixed_arrays_are_shared_addressable_constants.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet inspect decisions --optimize=basic --opt-dump=rounds main.jet
exit: 0
stdout: ~ "after fn rounds" # the dump covers the hot loop
stdout: ~ "data_address" # the tables are read at their static address
stdout: !~ "stack_address" # no table is built on the stack per read
step: jet run --optimize=none main.jet
exit: 0 # o0
stdout: = static_fixed_arrays_are_shared_addressable_constants.out # o0
step: jet run --optimize=basic main.jet
exit: 0 # o1
stdout: = static_fixed_arrays_are_shared_addressable_constants.out # o1
step: jet run --optimize=full main.jet
exit: 0 # o2
stdout: = static_fixed_arrays_are_shared_addressable_constants.out # o2
