use core.context

Probe: struct {
    deadline: Int
}

// The parameter hides the import by the ordinary scoping rule.
shadowed: fn(context: Probe) -> Int {
    context.deadline
}

report: fn() -> String {
    "deadline {(context.deadline ?? -1) >= 0} thread {context.thread}"
}

run: fn() {
    print(report())
    #Deadline(3600s) {
        print(report())
    }
    print("shadowed {shadowed(Probe{deadline: 7})}")
}
