use term: core.term

Point: struct {
    x: Int
    y: Int
}

shown: fn(values: [Int]) {
    print(values)
}

run: fn() {
    #Context(print: term.PrintStyle{int_base: .Hex, int_min_digits: 4}) {
        print(255)
        print([1, 2, 3])
        print("x = {255}")
    }
    print(255)
    #Context(print: term.PrintStyle{int_base: .Binary, float_digits: Val(2), list_separator: "; ", field_names: false}) {
        print(-5)
        shown([4, 5])
        print((1, 2.5))
        print(Point{x: 3, y: 4})
        print(0.125)
        print("[{context.print.list_separator}]")
    }
    print([1, 2, 3])
    print((1, 2.5))
    print(Point{x: 3, y: 4})
}
