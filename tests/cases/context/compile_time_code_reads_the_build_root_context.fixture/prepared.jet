ROOT_THREAD: #run context.thread

report: fn() -> String {
    thread: #run context.thread
    deadline: #run context.deadline
    shown: if deadline == {
        .Val(ms) -> "{ms}"
        .None -> "None"
    }
    "prepared thread {ROOT_THREAD} {thread} deadline {shown}; running thread {context.thread} deadline {(context.deadline ?? -1) >= 0}"
}

run: fn() {
    #Deadline(3600s) {
        worker: task report()
        if worker.join() == {
            .Ok(line) -> { print(line) }
            .Err(_) -> { print("failed") }
        }
    }
}
