# A panic inside a `#Context(allocator:)` block's `allocate` stops the task:
# the list growth it interrupted takes its buffer from the program heap, the
# stop is taken at the loop's next stop check, and the task reports the
# panic and never reaches the code after the block.
fixture: context_allocator_panic_in_allocate_stops_the_task.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check refuse.jet
exit: 0
step: jet run -O0 refuse.jet
exit: 70
stdout: = "before the block\n"
stderr: ~ "panic: the allocator is out of patience" # the report goes on with where the task stopped
step: jet run -O1 refuse.jet
exit: 70
stdout: = "before the block\n"
stderr: ~ "panic: the allocator is out of patience" # the report goes on with where the task stopped
step: jet run -O2 refuse.jet
exit: 70
stdout: = "before the block\n"
stderr: ~ "panic: the allocator is out of patience" # the report goes on with where the task stopped
