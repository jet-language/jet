# Reading the task context is an implicit input, not an effect: a `-[]>`
# function reads it, and a `#Memo` function keys its results on the context
# fields it can reach, so a call under another deadline is a miss.
fixture: pure_code_reads_context_and_memo_keys_on_it.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check pure.jet
exit: 0
step: jet run -O0 pure.jet
exit: 0
stdout: ~ "pure true thread 0" # the block's deadline, read by pure code
step: jet run -O1 pure.jet
exit: 0
stdout: ~ "pure true thread 0" # the block's deadline, read by pure code
step: jet run -O2 pure.jet
exit: 0
stdout: ~ "pure true thread 0" # the block's deadline, read by pure code
step: jet run -O0 memo.jet
exit: 0
stdout: ~ "memo 0 true 0 hits=1 misses=2" # the deadline is part of the key
step: jet run -O1 memo.jet
exit: 0
stdout: ~ "memo 0 true 0 hits=1 misses=2" # the deadline is part of the key
step: jet run -O2 memo.jet
exit: 0
stdout: ~ "memo 0 true 0 hits=1 misses=2" # the deadline is part of the key
