# `context` is the short name of the Core module `core.context`. A program
# that imports the module reads the task context through it, under its own
# name or another one, and a parameter named `context` still hides the
# import. Every tier reads the same values.
fixture: context_reads_through_the_core_context_import.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run -O0 imported.jet
exit: 0
stdout: = "deadline false thread 0\ndeadline true thread 0\nshadowed 7\n"
step: jet run -O0 renamed.jet
exit: 0
stdout: = "renamed deadline true\n"
step: jet run -O1 imported.jet
exit: 0
stdout: = "deadline false thread 0\ndeadline true thread 0\nshadowed 7\n"
step: jet run -O1 renamed.jet
exit: 0
stdout: = "renamed deadline true\n"
step: jet run -O2 imported.jet
exit: 0
stdout: = "deadline false thread 0\ndeadline true thread 0\nshadowed 7\n"
step: jet run -O2 renamed.jet
exit: 0
stdout: = "renamed deadline true\n"
