
#Error
TypedFailure: enum {
    Bad
}

#Error
StoreFailure: enum {
    Missing
}

implicit: fn(value: Int) -> Int {
    if value == 0 {
        return Err("implicit")
    }
    return value
}

explicit: fn(value: Int) -> Int TypedFailure! {
    if value == 0 {
        return Err(TypedFailure.Bad)
    }
    return value
}

impl Err.From(StoreFailure) {
    from: fn(error: StoreFailure) -> Err { return Err("converted") }
}

converted: fn(value: Int) -> Int StoreFailure! {
    if value == 0 {
        return Err(StoreFailure.Missing)
    }
    return value
}

contextual_source: fn() -> Int { Err("context", code: "E_CONTEXT", cause: Err("root")) }

contextual: fn() -> Int { contextual_source()?("loading") }

optional_success: fn(value: Int) -> Int? {
    if value == 0 {
        return None
    }
    return Val(value)
}

unit_success: fn(fail: Bool) {
    if fail {
        return Err("unit")
    }
}

unit_caller: fn(fail: Bool) -> Int {
    unit_success(fail)
    return 7
}

impossible: fn() -> Int Never! { 7 }

matrix: fn() -> String {
    return "{implicit(2) ?? -1}|{implicit(0) ?? -1}|{explicit(2) ?? -2}|{explicit(0) ?? -2}|{converted(2) ?? -3}|{converted(0) ?? -3}|{contextual() ?? -4}|{optional_success(2) ?? -5}|{optional_success(0) ?? -5}|{unit_caller(false) ?? -6}|{unit_caller(true) ?? -6}|{impossible() ?? -7}"
}

COMPTIME_MATRIX: #run matrix()

run: fn() {
    print(COMPTIME_MATRIX)
    print(matrix())
}
