step: jet budget update --baseline ci/linux --bootstrap --reason "initial evidence"
cwd: yes
pty: true
stdin: yes.stdin
exit: 0
stdout: ~ "Apply? [y/N]" # original predicate
stdout: count "+ report " = 1 # original predicate
stdout: count "~ baseline " = 1 # original predicate
file: yes/.jet/perf/baselines/names/ci/linux.json is-file
entries: yes/.jet/perf/reports >= 1 # original predicate
