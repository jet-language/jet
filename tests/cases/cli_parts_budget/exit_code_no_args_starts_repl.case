# Port of tests/cli_parts/budget.rs:1160-1175; fixture sources copied verbatim.
# Bare `jet` prints the command palette and exits 0; only `jet repl` starts the
# REPL (owner ruling 2026-10-28, Docs/spec/syntax-decisions.md:7148).
step: jet
exit: 0
stdout: ~ "Jet command palette" # bare `jet` prints the palette (syntax-decisions.md:7148-7150)
stdout: !~ "Interactive REPL" # bare `jet` never starts the REPL (syntax-decisions.md:7148-7150)
