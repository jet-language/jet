# PENDING-SAME-HEAD: no runtime reference run.
# PENDING-GRAMMAR(batch-four): pending predicate and step forms remain explicit.
# PENDING-SEAM(budget-verify)
refused: budget-verify
requires: os-name:linux
copy: {root}/Examples/performance/receipts/hello .
step: jet budget check --json
exit: 1
stderr: empty
json: stdout canonical # original predicate
json: stdout doc $.budget.report.content.measurements #= 3
json: stdout doc $.budget.report.content.measurements[*].provider.kind = "BuildArtifact"
json: stdout doc $.budget.report.content.measurements[*].provider.version = "jet-artifact-footprint-v1-first-line-vmhwm-trials-20"
json: stdout doc $.budget.report.content.measurements[*].provider.isolation = "fresh-child-process-per-trial"
