fixture: fixtures/hostile_files
resize: oversized 536870913
step: jet self completions bash --for oversized
exit: 1
stderr: ~ "larger than the 512 MiB" # original predicate
when os unix: step: jet self completions bash --for /dev/null
when os unix: exit: 1
when os unix: stderr: ~ "not a regular file" # original predicate
when os unix: step: mkfifo program-fifo
when os unix: exit: 0
when os unix: step: jet self completions bash --for program-fifo
when os unix: exit: 1
when os unix: stderr: ~ "not a regular file" # original predicate
copy: notexe.payload "safe\nINJECT_COMMAND\nnext"
step: jet self completions bash --for "safe\nINJECT_COMMAND\nnext"
exit: 1
stdout: empty
stderr: ~ "contains a control character" # original predicate
stderr: !~ "\nINJECT_COMMAND\n" # original predicate
stderr: ~ "safe\\nINJECT_COMMAND\\nnext" # original predicate
step: jet self completions zsh --for "safe\nINJECT_COMMAND\nnext"
exit: 1
stdout: empty
stderr: ~ "contains a control character" # original predicate
stderr: !~ "\nINJECT_COMMAND\n" # original predicate
stderr: ~ "safe\\nINJECT_COMMAND\\nnext" # original predicate
step: jet self completions fish --for "safe\nINJECT_COMMAND\nnext"
exit: 1
stdout: empty
stderr: ~ "contains a control character" # original predicate
stderr: !~ "\nINJECT_COMMAND\n" # original predicate
stderr: ~ "safe\\nINJECT_COMMAND\\nnext" # original predicate
