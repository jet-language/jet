# #6611 c2: method, plain, operator-hook and trailing-block calls that hand a
# read parameter to an owning parameter all report E0201 with the same `.copy()`
# fix; no call form copies on its own. The operator itself (`bag + item`) reads
# `item` (the hook's `rhs` is a read parameter), so it reports nothing.
fixture: read_param_owning_argument_is_one_rule_in_every_call_form
env: NO_COLOR=1
step: jet check run.jet
exit: nonzero
stderr: ~ "4 problems found" # exactly the four call forms
stderr: ~ "--> run.jet:12:19" # operator hook body: rows.push(rhs)
stderr: ~ "--> run.jet:27:15" # method call: rows.push(item)
stderr: ~ "--> run.jet:32:10" # plain call: keep(item)
stderr: ~ "--> run.jet:41:15" # trailing-block call: with_rows(item) { 1 }
stderr: ~ "Write `item.copy()` when `.push()` should receive a copy" # method form fix
stderr: ~ "Write `item.copy()` when `keep` should receive a copy" # plain form fix
stderr: ~ "Write `item.copy()` when `with_rows` should receive a copy" # trailing-block form fix
stderr: ~ "Write `rhs.copy()` when `.push()` should receive a copy" # operator hook form fix
