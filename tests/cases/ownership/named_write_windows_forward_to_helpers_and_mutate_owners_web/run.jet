
Slot: struct { value: Int }

bump: fn(value: &Int, amount: Int) {
    value += amount
}

inspect: fn(first: Slot, second: Slot) {
    print(first.value + second.value)
}

run: fn() {
    whole := 1
    whole_window: &whole
    bump(&whole_window, 2)

    slot := Slot{ value: 3 }
    field_window: &slot.value
    bump(&field_window, 4)

    values := [5, 6]
    index_window: &values[0]
    bump(&index_window, 6)

    read_slot := Slot{ value: 9 }
    read_window: &read_slot
    inspect(read_window, read_window)

    print(whole)
    print(slot.value)
    print(values[0])
}
