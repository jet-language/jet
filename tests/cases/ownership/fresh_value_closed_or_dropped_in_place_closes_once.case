# A fresh value with cleanup ended in place closes exactly once, before the
# next statement: `close(^make("x"))`, `close(^Plain{..})`,
# `consume(make("x"))`, and `.drop("why")` on a Res, a Res IOError! and a
# Res?, on o0, o1, o2 and a built binary (#6436).
fixture: fresh_value_closed_or_dropped_in_place_closes_once.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = fresh_value_closed_or_dropped_in_place_closes_once.out
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = fresh_value_closed_or_dropped_in_place_closes_once.out
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = fresh_value_closed_or_dropped_in_place_closes_once.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = fresh_value_closed_or_dropped_in_place_closes_once.out
