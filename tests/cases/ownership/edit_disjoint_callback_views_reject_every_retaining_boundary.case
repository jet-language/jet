step: jet check o2/run.jet
exit: nonzero # tests/ownership.rs:5234 expect_err
stderr: ~ "[jet.OwnerMovedWhileViewed]" # tests/ownership.rs:5235 assert!
stderr: ~ "Fix: Use the view inside that scope, and keep only owned values outside it" # the diagnostic's fix
step: jet check o3/run.jet
exit: nonzero # tests/ownership.rs:5234 expect_err
stderr: ~ "[jet.OwnerMovedWhileViewed]" # tests/ownership.rs:5235 assert!
