# Element assignment into a uniquely owned list or map, and nested list and
# map place writes, update in place without copying the collection, on O0,
# O1, O2, the built binary and in compile-time code. The program makes
# 2,000,000 stores of each kind at run time and 200,000 at build time; a copy
# per store would be quadratic and run for hours, so finishing under each
# step's timeout proves no store copies. The last line shows that copies
# taken before a write keep the values they saw.
fixture: unique_element_and_nested_place_writes_do_not_copy.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
timeout: 60s
exit: 0
stdout: = unique_element_and_nested_place_writes_do_not_copy.out
step: jet run --optimize=basic main.jet
timeout: 60s
exit: 0
stdout: = unique_element_and_nested_place_writes_do_not_copy.out
step: jet run --optimize=full main.jet
timeout: 60s
exit: 0
stdout: = unique_element_and_nested_place_writes_do_not_copy.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = unique_element_and_nested_place_writes_do_not_copy.out
