use core.files as files

// An aggregate holding a handle has no clone, so sema reads a variable that
// holds one as a move (E0121 on a later use): returning a local or a taken
// parameter, rebinding it with `:=`, sorting it in place and returning it,
// or returning it inside a struct or a tuple hands the one value to its new
// owner (the Jetpack package loader's pkg_sorted_checked_files is this
// shape). Each handle closes exactly once, when its last owner ends, so the
// process's open descriptors return to the count they had before.

struct Checked {
    relative: String
    handle: FileReader
}

struct Shelf {
    name: String
    items: [Checked]
}

fn open_fds() -> Int {
    entries :: files.list_dir("/proc/self/fd") ?? panic("list fds")
    entries.len()
}

fn checked(relative: String) -> Checked {
    Checked{relative: relative, handle: files.open("run.jet") ?? panic("open run.jet")}
}

fn gathered() -> [Checked] {
    out := [Checked]{}
    &out.push(checked("b"))
    &out.push(checked("c"))
    &out.push(checked("a"))
    out
}

fn passed_through(input: ^[Checked]) -> [Checked] {
    input
}

fn rebound(input: ^[Checked]) -> [Checked] {
    out := ^input
    out
}

fn sorted(input: ^[Checked]) -> [Checked] {
    out := input
    &out.sort_by((a, b) -> a.relative <=> b.relative)
    out
}

fn shelved(input: ^[Checked]) -> Shelf {
    shelf := Shelf{name: "shelf", items: input}
    again := shelf
    again
}

fn paired(input: ^Shelf) -> (shelf: Shelf, count: Int) {
    count :: input.items.len()
    pair := (shelf: input, count: count)
    pair
}

fn nested() -> [[Checked]] {
    inner := [Checked]{checked("x"), checked("y")}
    outer := [[Checked]]{}
    &outer.push(inner)
    outer
}

fn names(list: [Checked]) -> String {
    text := ""
    loop index in 0..<list.len() -> text = "{text}{list[index].relative}"
    text
}

fn run() {
    before :: open_fds()
    list := gathered()
    print("gathered {names(list)} open {open_fds() - before}")
    through := passed_through(^list)
    print("passed {names(through)} open {open_fds() - before}")
    again := rebound(^through)
    print("rebound {names(again)} open {open_fds() - before}")
    ordered := sorted(^again)
    print("sorted {names(ordered)} open {open_fds() - before}")
    shelf := shelved(^ordered)
    print("shelved {names(shelf.items)} open {open_fds() - before}")
    pair := paired(^shelf)
    print("paired {pair.count} open {open_fds() - before}")
    drop_pair(^pair)
    print("pair leaked {open_fds() - before}")
    lists := nested()
    print("nested {lists.len()} open {open_fds() - before}")
    drop_lists(^lists)
    print("nested leaked {open_fds() - before}")
}

fn drop_pair(pair: ^(shelf: Shelf, count: Int)) {
    print("dropping {pair.shelf.name}")
}

fn drop_lists(lists: ^[[Checked]]) {
    print("dropping {lists.len()}")
}
