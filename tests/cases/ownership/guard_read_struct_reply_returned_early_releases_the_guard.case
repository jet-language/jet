# The #4957 http-service shape: a struct reply returned through
# `?? return reply(404)` while a Shared read guard temporary is live releases
# that guard on the exit edge, so each later guard_edit() on the store
# proceeds (a guard left held would make it wait forever). Hand-derived
# output: absent keys reply 404, stored ones reply 200 with their value.
fixture: guard_read_struct_reply_returned_early_releases_the_guard.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = guard_read_struct_reply_returned_early_releases_the_guard.out
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = guard_read_struct_reply_returned_early_releases_the_guard.out
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = guard_read_struct_reply_returned_early_releases_the_guard.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = guard_read_struct_reply_returned_early_releases_the_guard.out
