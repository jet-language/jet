# Claim: the result of a call that returns a view (`-> Directory from self | picked`) is lent, not owned: passed straight to a read parameter, bound to a variable, or wrapped in an Option, it never closes the handle its receiver or argument owns, on o0, o1 and o2.
# Hand-derived: every handle is the open working directory, so each check of a still-open handle is true; a handle closed early would make the next `stat` fail and print false.
fixture: view_returned_by_a_call_stays_open_for_its_owner.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --allow=FS.Read -O0 run.jet
exit: 0 # o0
stdout: = view_returned_by_a_call_stays_open_for_its_owner.out # o0
step: jet run --allow=FS.Read -O1 run.jet
exit: 0 # o1
stdout: = view_returned_by_a_call_stays_open_for_its_owner.out # o1
step: jet run --allow=FS.Read -O2 run.jet
exit: 0 # o2
stdout: = view_returned_by_a_call_stays_open_for_its_owner.out # o2
