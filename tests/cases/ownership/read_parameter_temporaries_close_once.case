# A temporary with cleanup lent to a read parameter closes exactly once: a
# plain Res, a Res? and a Held? (whose Res closes through it) close when
# their statement ends, two in one statement close latest first, and a
# `?? return` exit closes the statement's temporary on its way out. One made
# on the right of `||`/`&&` or in a loop condition closes right after its
# call, once per evaluation, and one never evaluated never closes.
fixture: read_parameter_temporaries_close_once.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = read_parameter_temporaries_close_once.out
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = read_parameter_temporaries_close_once.out
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = read_parameter_temporaries_close_once.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = read_parameter_temporaries_close_once.out
