// Each form moves `path` into `out` and then leaves the inner loop by a
// `break`, a labeled exit, a fallback or a match arm. Where the loop's exits
// meet, `path` is owned only on the paths that did not move it, so its scope
// end never drops the text `out` now holds.

pick: fn(text: String) -> String? {
    if text == "b" -> return None
    Val(text.copy())
}

pushed_then_break: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            out.push(path)
            break
        }
    }
    out.join(",")
}

next_then_break: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            if item == "b" {
                next
            }
            out.push(path)
            break
        }
    }
    out.join(",")
}

next_outer: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    outer: loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            out.push(path)
            next(outer)
        }
        out.push("unreached")
    }
    out.join(",")
}

break_outer: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    outer: loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            if item == "b" {
                out.push(path)
                break(outer)
            }
            out.push(path)
            break
        }
    }
    out.join(",")
}

fallback_return: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            out.push(path)
            _: pick(item) ?? return out.join(",")
            break
        }
    }
    "unreached"
}

fallback_break: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    loop item in items {
        path: "dir/{item}"
        loop _ in 0..<2 {
            out.push(path)
            _: pick(item) ?? break
            break
        }
    }
    out.join(",")
}

match_arm_exit: fn() -> String {
    out := [String]{}
    items: [String]{"c", "b", "a"}
    loop item in items {
        path: "dir/{item}"
        loop round in 0..<2 {
            if round == {
                0 -> {
                    out.push(path)
                    break
                }
                else -> {}
            }
        }
    }
    out.join(",")
}

run: fn() {
    print("break {pushed_then_break()}")
    print("next then break {next_then_break()}")
    print("next(outer) {next_outer()}")
    print("break(outer) {break_outer()}")
    print("?? return {fallback_return()}")
    print("?? break {fallback_break()}")
    print("match arm {match_arm_exit()}")
}
