// A temporary with cleanup that a call only reads closes exactly once: a
// Res, a Res? and a Held? (whose Res closes through it) lent to a read
// parameter close when their statement ends, the latest first. On an early
// exit out of the statement they close on the way out. One made in a branch
// or a loop condition of the statement closes right after its call.

struct Res { name: String }
impl Res.Close {
    fn close(^self) { print("close {self.name}") }
}

struct Held {
    res: Res
}

fn make(name: String) -> Res { Res{name: name} }
fn make_opt(name: String) -> Res? { Val(Res{name: name}) }
fn make_held(name: String) -> Held? { Val(Held{res: Res{name: name}}) }

fn show(r: Res) { print("show {r.name}") }
fn show_opt(r: Res?) { print("show_opt {r != None}") }
fn show_held(r: Held?) { print("show_held {r != None}") }
fn show_pair(a: Res, b: Res) { print("show_pair {a.name} {b.name}") }
fn name_of(r: Res) -> String { r.name }
fn short(r: Res) -> Bool { r.name.len() < 3 }
fn found(r: Res, key: String) -> Int? { if r.name == key -> Val(r.name.len()) else -> None }

fn early(key: String) -> String {
    size :: found(make("probe"), key) ?? return "{key}: missing"
    "{key}: {size}"
}

fn branches(wide: Bool) {
    if wide || short(make("skipped")) -> print("wide")
    if !wide || short(make("ab")) -> print("short")
}

fn run() {
    show(make("plain"))
    show_opt(make_opt("opt"))
    show_held(make_held("held"))
    show_pair(make("first"), make("second"))
    print("name {name_of(make("inner"))}")
    print(early("probe"))
    print(early("other"))
    branches(true)
    count := 0
    loop short(make("w{count}")) && count < 2 {
        count += 1
    }
    print("count {count}")
    print("done")
}
