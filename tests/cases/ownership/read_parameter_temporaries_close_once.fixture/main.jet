// A temporary with cleanup that a call only reads closes exactly once: a
// Res, a Res? and a Held? (whose Res closes through it) lent to a read
// parameter close when their statement ends, the latest first. On an early
// exit out of the statement they close on the way out. One made in a branch
// or a loop condition of the statement closes right after its call.

Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
Held: struct {
    res: Res
}

make: fn(name: String) -> Res { Res{name: name} }
make_opt: fn(name: String) -> Res? { Val(Res{name: name}) }
make_held: fn(name: String) -> Held? { Val(Held{res: Res{name: name}}) }

show: fn(r: Res) { print("show {r.name}") }
show_opt: fn(r: Res?) { print("show_opt {r != None}") }
show_held: fn(r: Held?) { print("show_held {r != None}") }
show_pair: fn(a: Res, b: Res) { print("show_pair {a.name} {b.name}") }
name_of: fn(r: Res) -> String { r.name }
short: fn(r: Res) -> Bool { r.name.len() < 3 }
found: fn(r: Res, key: String) -> Int? { if r.name == key -> Val(r.name.len()) else -> None }

early: fn(key: String) -> String {
    size: found(make("probe"), key) ?? return "{key}: missing"
    "{key}: {size}"
}

branches: fn(wide: Bool) {
    if wide || short(make("skipped")) -> print("wide")
    if !wide || short(make("ab")) -> print("short")
}

run: fn() {
    show(make("plain"))
    show_opt(make_opt("opt"))
    show_held(make_held("held"))
    show_pair(make("first"), make("second"))
    print("name {name_of(make("inner"))}")
    print(early("probe"))
    print(early("other"))
    branches(true)
    count := 0
    loop short(make("w{count}")) && count < 2 {
        count += 1
    }
    print("count {count}")
    print("done")
}
