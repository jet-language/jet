# tests/ownership.rs::return_fallback_view_does_not_reach_the_enclosing_call, migrated to the implicit-copy ownership
# model (Compiler/JetSema/Source/Sema/Ownership/CopySites.jet): the slice `values[0..1]` is an owned [Int], not the
# fixture's own `View<Int>` struct, and that struct has no index, so the check stops on those types.
fixture: return_fallback_view_does_not_reach_the_enclosing_call/input
step: jet check run.jet
exit: nonzero # tests/ownership.rs:1790
stderr: ~ "[jet.ReturnTypeMismatch]" # the registered diagnostic
stderr: ~ "This value is [Int], but `first` returns View<Int>" # the slice is an owned list
stderr: ~ "[jet.InvalidIndexType]" # the registered diagnostic
stderr: ~ "Fix: Use `[ ]` on a List or Map" # and its fix
