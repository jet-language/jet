use files: core.files

// Each owner below holds an open file handle somewhere other than its own
// direct field: in an Option field, an Option local, an Option of a struct, a
// list of Options, a list and an enum payload. When the owner ends, the
// handle closes with it, so the process's open descriptors return to the
// count it had before. A handle moved out of an Option payload has exactly
// one owner: it stays readable after the Option's owner ends, then closes once.

Holder: struct {
    file: FileReader?
}

Inner: struct {
    file: FileReader
}

Nest: struct {
    inner: Inner?
}

Shelf: struct {
    maybe: [FileReader?]
    plain: [FileReader]
}

Slot: enum {
    Open(FileReader)
    Shut
}

Tagged: struct {
    slot: Slot
}

open_fds: fn() -> Int {
    entries: files.list_dir("/proc/self/fd") ?? panic("list fds")
    entries.len()
}

reader: fn(path: String) -> FileReader {
    files.open(path) ?? panic("open {path}")
}

hold_field: fn(path: String) {
    holder: Holder{file: Val(reader(path))}
    print("field held {holder.file != None}")
}

hold_local: fn(path: String) {
    file: FileReader?{Val(reader(path))}
    print("local held {file != None}")
}

hold_nested: fn(path: String) {
    nest: Nest{inner: Val(Inner{file: reader(path)})}
    print("nested held {nest.inner != None}")
}

hold_lists: fn(path: String) {
    shelf: Shelf{maybe: [FileReader?]{Val(reader(path)), None, Val(reader(path))}, plain: [FileReader]{reader(path), reader(path)}}
    print("lists held {shelf.maybe.len() + shelf.plain.len()}")
}

hold_enum: fn(path: String) {
    tagged: Tagged{slot: Slot.Open(reader(path))}
    print("enum held {tagged.slot == .Open(_)}")
}

take_payload: fn(path: String) -> FileReader {
    holder := Holder{file: Val(reader(path))}
    if holder.file == {
        .Val(file) -> ^file
        None -> panic("no file")
    }
}

run: fn() {
    path: "run.jet"
    before: open_fds()
    hold_field(path)
    print("field leaked {open_fds() - before}")
    hold_local(path)
    print("local leaked {open_fds() - before}")
    hold_nested(path)
    print("nested leaked {open_fds() - before}")
    hold_lists(path)
    print("lists leaked {open_fds() - before}")
    hold_enum(path)
    print("enum leaked {open_fds() - before}")
    moved := take_payload(path)
    print("moved open {open_fds() - before}")
    print("moved reads {moved.read(3).len()}")
    drop_reader(^moved)
    print("moved leaked {open_fds() - before}")
}

drop_reader: fn(file: ^FileReader) {
    print("dropping {file.read(2).len()}")
}
