// Every early exit out of a statement whose temporary holds a read guard
// (`store.guard_read().value ...`) releases that guard on its way out:
// `?? return`, a failure propagating out of a call, `?(context)`, `?? break`
// and `?? next`. Each later guard_edit() on the same store only proceeds
// once every read guard is gone.

lookup: fn(store: Shared<[String:String]>, key: String) -> String {
    stored: store.guard_read().value.get(key) ?? return "{key}: missing"
    "{key}: {stored}"
}

year: fn(entries: [String:String], key: String) -> String {
    entries.get(key).or_err("no year for {key}")
}

checked: fn(store: Shared<[String:String]>, key: String) -> String {
    stored: year(store.guard_read().value, key)
    "{key}: {stored}"
}

noted: fn(store: Shared<[String:String]>, key: String) -> String {
    stored: year(store.guard_read().value, key)?("reading {key}")
    "{key}: {stored}"
}

// The read guard of the `then` arm is never taken when the `else` arm
// returns, so that exit releases only its own.
pick: fn(store: Shared<[String:String]>, key: String, lenient: Bool) -> String {
    stored: if lenient -> store.guard_read().value.get(key) ?? "none" else -> store.guard_read().value.get(key) ?? return "{key}: gone"
    "{key}: {stored}"
}

sum_until_missing: fn(store: Shared<[String:String]>, keys: [String]) -> Int {
    total := 0
    loop key in keys {
        stored: store.guard_read().value.get(key) ?? break
        total += Int.parse(stored) ?? 0
    }
    total
}

sum_present: fn(store: Shared<[String:String]>, keys: [String]) -> Int {
    total := 0
    loop key in keys {
        stored: store.guard_read().value.get(key) ?? next
        total += Int.parse(stored) ?? 0
    }
    total
}

run: fn() {
    store: Shared{[String:String]{}}
    print(lookup(store, "ada"))
    store.guard_edit().value["ada"] = "1815"
    print(lookup(store, "ada"))
    print(checked(store, "alan") ?? "alan: no year")
    store.guard_edit().value["alan"] = "1912"
    print(checked(store, "alan") ?? "alan: no year")
    print(noted(store, "barbara") ?? "barbara: no year")
    store.guard_edit().value["barbara"] = "1939"
    print(noted(store, "barbara") ?? "barbara: no year")
    print(pick(store, "grace", false))
    print(pick(store, "grace", true))
    store.guard_edit().value["grace"] = "1906"
    print(pick(store, "grace", false))
    print(sum_until_missing(store, ["ada", "hedy", "alan"]))
    store.guard_edit().value["edith"] = "1897"
    print(sum_present(store, ["ada", "hedy", "alan", "grace"]))
    store.guard_edit().value["hedy"] = "1914"
    print(sum_present(store, ["ada", "hedy", "alan", "grace"]))
}
