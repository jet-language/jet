
#Policy(copies: .Explicit)
struct Inner {
    name: String?
}

struct Outer {
    inner: Inner
    names: [String?]
}

fn first_name(outer: Outer) -> String {
    picked :: outer.inner.name ?? return ""
    picked
}

fn indexed(outer: Outer) -> String {
    picked :: outer.names[0] ?? return ""
    picked
}

fn run() { print(0) }
