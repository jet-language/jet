// A struct member holding a function value moves out of its holder: the
// holder stops owning it, so the taken value's Shared is its only owner and
// the cell is freed where the taken value ends, before the holder's scope end.
Node: struct { label: String }

Hooks: struct {
    pick: fn(Int) -> Int
    node: Shared<Node>
}

Holder: struct {
    hooks: Hooks
    name: String
}

make: fn(n: Int) -> Holder {
    Holder{hooks: Hooks{pick: fn(x: Int) -> Int { x + n }, node: Shared{Node{label: "node {n}"}}}, name: "holder {n}"}
}

consume: fn(hooks: Hooks) -> Int {
    hooks.pick(1)
}

take_hooks: fn(n: Int) -> Int {
    h: make(n)
    taken: h.hooks.move()
    owners: taken.node.strong_count()
    weak: taken.node.downgrade()
    used: consume(taken.move())
    freed: weak.upgrade() == .None
    print("owners {owners} freed {freed} used {used} {h.name}")
    owners
}

run: fn() {
    total := 0
    loop i in 0..<3 -> total += take_hooks(i)
    print("total {total}")
}
