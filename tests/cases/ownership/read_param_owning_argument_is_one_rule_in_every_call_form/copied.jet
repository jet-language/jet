// The same four call forms with `.copy()` written at each owning argument:
// every form accepts the copy, and none needs another spelling.
Bag: struct {
    rows: [[Int]]

    impl Add([Int]) {
        add: fn(self, rhs: [Int]) -> Bag {
            rows := self.rows.copy()
            rows.push(rhs.copy())
            Bag{rows: rows}
        }
    }
}

take_rows: fn(rows: &&[Int]) -> Int {
    rows.len()
}

with_rows: fn(rows: &&[Int], body: fn() -> Int) -> Int {
    rows.len() + body()
}

by_method: fn(item: [Int]) -> Int {
    rows := [[Int]]{}
    rows.push(item.copy())
    rows.len()
}

by_call: fn(item: [Int]) -> Int {
    take_rows(item.copy())
}

by_operator: fn(item: [Int]) -> Int {
    bag: Bag{rows: [[Int]]{}} + item
    bag.rows.len()
}

by_block: fn(item: [Int]) -> Int {
    with_rows(item.copy(), fn() { 1 })
}

run: fn() {
    print(by_method([1]) + by_call([2]) + by_operator([3]) + by_block([4]))
}
