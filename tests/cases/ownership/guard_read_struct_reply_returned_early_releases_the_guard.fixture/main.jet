// The #4957 http-service shape: a handler reads a Shared store through a
// read guard temporary and, when the key is absent, returns a struct reply
// through `?? return reply(404)` while that guard is live. The exit releases
// the guard, so the next guard_edit() on the same store proceeds.

Reply: struct {
    status: Int
    body: String
}

reply: fn(status: Int) -> Reply {
    Reply{status: status, body: "status {status}"}
}

handle: fn(store: Shared<[String:String]>, key: String) -> Reply {
    stored: store.guard_read().value.get(key) ?? return reply(404)
    Reply{status: 200, body: stored}
}

show: fn(answer: Reply) {
    print("{answer.status} {answer.body}")
}

run: fn() {
    store: shared [String:String]{}
    show(handle(store, "ada"))
    store.guard_edit().value["ada"] = "1815"
    show(handle(store, "ada"))
    show(handle(store, "alan"))
    store.guard_edit().value["alan"] = "1912"
    show(handle(store, "alan"))
    loop _ in 0..<3 {
        show(handle(store, "grace"))
        store.guard_edit().value["edits"] = "more"
    }
    print("edits {store.guard_read().value.get("edits") ?? "none"}")
}
