// The loop reads `names` while the body lends it to a write parameter that
// clears it: refused, since the row the loop reads would be gone.
clear_all: fn(xs: &[String]) {
    xs.clear()
}

run: fn() {
    names := ["alpha", "beta", "gamma"]
    loop name in names {
        clear_all(names)
        print(name)
    }
}
