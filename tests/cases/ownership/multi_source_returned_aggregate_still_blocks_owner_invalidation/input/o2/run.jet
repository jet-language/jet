
struct Pair { left: View<Int>, right: View<Int> }

fn pair(left: [Int], right: [Int]) -[]> Pair {
    left_view :: left[0..1]
    right_view :: right[0..1]
    return Pair{ left: left_view, right: right_view }
}

fn run() {
    left := [7, 8]
    right := [9, 10]
    result :: pair(left, right)
    right.push(11)
    print(result.right[0])
}
