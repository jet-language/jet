// A write receiver's resource field taken by `.move()` and refilled from the
// call's result: a stop inside `next` would close `a` in `next` and again with
// `h`, so the take is refused before anything runs.
Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

next: fn(r: &&Res) -> Res {
    if r.name == "a" -> panic("stop")
    Res{name: "b"}
}

Holder: struct {
    r: Res

    step: fn(&self) {
        self.r = next(self.r.move())
    }
}

run: fn() {
    h := Holder{r: Res{name: "a"}}
    h.step()
    print("end")
}
