
Graph: struct {
    names: [String]
    size: Int
}
Run: struct {
    graph: Graph
    values: [String]
}
make_run: fn() -> Run {
    return Run{graph: Graph{names: ["a", "b"], size: 2}, values: ["v"]}
}
hop: fn(run: ^Run) -> Graph {
    graph := ^run.graph
    print(run.values.len())
    return graph
}
hop_local: fn() -> Int {
    run := make_run()
    names := ^run.graph.names
    run.graph.names = ["c"]
    return names.len() + run.graph.names.len()
}
run: fn() {
    print(hop(make_run()).names.len())
    print(hop_local())
}
