# tests/ownership.rs::mutable_view_extraction_retires_the_source_aggregate, migrated to the implicit-copy ownership model
# (Compiler/JetSema/Source/Sema/Ownership/CopySites.jet). o1 reads the source aggregate while the extracted mutable view
# holds its exclusive write window, which sema rejects as a read during that window. o2 prints the optional mutable view
# itself, which has no display.
fixture: mutable_view_extraction_retires_the_source_aggregate/input
step: jet check o1/run.jet
exit: nonzero # tests/ownership.rs:5337 expect_err
stderr: ~ "[jet.ReadDuringWriteWindow]" # the registered diagnostic
stderr: ~ "Fix: Read or edit through `selected` instead of `values[…]`" # and its fix
step: jet check o2/run.jet
exit: nonzero # tests/ownership.rs:5355 expect_err
stderr: ~ "[jet.ValueTypeMismatch]" # the registered diagnostic
stderr: ~ "`print` doesn't know how to show ViewMut<Int>?" # names the optional view
stderr: ~ "Fix: Print one of its parts instead" # and its fix
