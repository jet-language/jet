#Policy(copies: .Explicit)
Inner: struct {
    name: String?
}

Outer: struct {
    inner: Inner
    names: [String?]
}

first_name: fn(outer: Outer) -> String {
    outer.inner.name.copy() ?? ""
}

indexed: fn(outer: Outer) -> String {
    outer.names[0].copy() ?? ""
}

picked_name: fn(outer: Outer) -> String {
    picked: outer.inner.name ?? return ""
    picked.copy()
}

run: fn() {
    outer: Outer{inner: Inner{name: "Ada"}, names: [String?]{"Lin"}}
    print(first_name(outer))
    print(indexed(outer))
    print(picked_name(outer))
}
