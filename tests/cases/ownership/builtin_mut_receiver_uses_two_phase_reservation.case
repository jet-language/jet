# tests/ownership.rs::builtin_mut_receiver_uses_two_phase_reservation, migrated to the implicit-copy ownership model
# (Compiler/JetSema/Source/Sema/Ownership/CopySites.jet). o2 and o3 pass the written list into its own mutating call and
# are rejected. In o4 (`clock.advance(clock.now())`) and o5 (`solver.require(solver.failure_count() == 0)`) the
# argument is an owned Int or Bool read before the mutating receiver is reserved, so both calls are legal.
fixture: builtin_mut_receiver_uses_two_phase_reservation/input
step: jet check o1/run.jet
exit: 0 # tests/ownership.rs:1437 expect
step: jet check o2/run.jet
exit: nonzero # tests/ownership.rs:1446 expect_err
stderr: ~ "[jet.UseWhileWriteActive]" # tests/ownership.rs:1447 assert!
stderr: ~ "Fix: Pass `values` only once, or copy first with `values.copy()`" # the diagnostic's fix
step: jet check o3/run.jet
exit: nonzero # tests/ownership.rs:1470 expect_err
stderr: ~ "[jet.UseWhileWriteActive]" # tests/ownership.rs:1471 assert!
stderr: ~ "Fix: Pass `values` only once, or copy first with `values.copy()`" # the diagnostic's fix
step: jet check o4/run.jet
exit: 0
stderr: !~ "[jet." # no diagnostic
step: jet run o4/run.jet
exit: 0
step: jet check o5/run.jet
exit: 0
stderr: !~ "[jet." # no diagnostic
step: jet run o5/run.jet
exit: 0
