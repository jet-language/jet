# Claim: a write through a Shared edit guard closes the replaced Close value exactly once, at the write, whether it replaces the whole payload or one field of it; the new value closes once when the storage ends; on o0, o1 and o2 (#6450).
# Hand-derived: "close X" is printed by each close; every value is closed once, the old ones before the line the writer prints, "new" after "end" when its storage ends.
fixture: shared_guard_write_closes_the_old_payload_once.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --optimize=none run.jet
exit: 0 # o0
stdout: = shared_guard_write_closes_the_old_payload_once.out # o0
step: jet run --optimize=basic run.jet
exit: 0 # o1
stdout: = shared_guard_write_closes_the_old_payload_once.out # o1
step: jet run --optimize=full run.jet
exit: 0 # o2
stdout: = shared_guard_write_closes_the_old_payload_once.out # o2
