# A `Reader.over(…)` temporary passed to a `&term.Reader` parameter. Sema
# accepts a temporary for a `&` parameter, so lowering gives it a place: the
# cursor moves into a frame cell, the callee's reads advance it there, and it
# ends after the call. Each tier prints the same lines.
fixture: a_reader_over_temporary_passed_to_a_write_parameter_runs_on_every_tier.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 0
step: jet run -O0 run.jet
exit: 0
stdout: = a_reader_over_temporary_passed_to_a_write_parameter_runs_on_every_tier.out
step: jet run -O1 run.jet
exit: 0
stdout: = a_reader_over_temporary_passed_to_a_write_parameter_runs_on_every_tier.out
step: jet run -O2 run.jet
exit: 0
stdout: = a_reader_over_temporary_passed_to_a_write_parameter_runs_on_every_tier.out
