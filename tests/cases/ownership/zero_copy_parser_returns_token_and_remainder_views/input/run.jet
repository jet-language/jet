
Token: struct {
    text: View<str>,
    rest: View<str>
}

scan: fn(source: String) -[]> Token {
    text: source.before(":")
    rest: source.after(":")
    return Token{ text: text, rest: rest }
}

parse: fn(source: String) -[]> Token {
    return scan(source)
}

run: fn() {
    source := "name:value"
    token: parse(source)
    print(token.text)
    print(token.rest)
    expected: "name"
    print("wrapped: {token.text}")
    print("wrapped: {expected}")
}
