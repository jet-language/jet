// Element and nested place writes into uniquely owned collections, sized so
// that a full copy per store would run for hours: 2,000,000 list stores,
// 2,000,000 map stores and 2,000,000 nested list and map place stores at run
// time, and 200,000 of each in compile-time code.

writes: fn(n: Int) -> String {
    list := [Int]{0}.cycle(n).to_list()
    loop i in 0..<n -> list[i] = i * 3
    map := [Int:Int]{}
    loop i in 0..<n -> map[i % 1024] = i
    rows: 64
    grid := [[Int]]{}
    loop r in 0..<rows -> grid.push([Int]{0}.cycle(n /% rows).to_list())
    loop i in 0..<n -> grid[i % rows][i /% rows] = i
    groups := [String:[Int]]{}
    loop g in 0..<16 -> groups["g{g}"] = [Int]{0}.cycle(n /% 16).to_list()
    loop i in 0..<n -> groups["g{i % 16}"][i /% 16] = i
    "{list[n - 1]} {map[1023]} {grid[rows - 1][n /% rows - 1]} {groups["g15"][n /% 16 - 1]}"
}

// A copy or an alias taken before a write keeps the value it saw.
isolation: fn() -> String {
    grid := [[Int]]{[Int]{1, 2}, [Int]{3, 4}}
    row: grid[1].copy()
    snapshot: grid.copy()
    grid[1][0] = -1
    groups := [String:[Int]]{"a": [Int]{5}}
    kept: groups.copy()
    groups["a"][0] = -5
    "{row[0]} {snapshot[1][0]} {grid[1][0]} {kept["a"][0]} {groups["a"][0]}"
}

AT_BUILD: comptime { writes(200000) }

run: fn() {
    print(writes(2000000))
    print(AT_BUILD)
    print(isolation())
}
