use {
    net: core.net
    files: core.files
}
PEER_CRLF: comptime { String.from_bytes([U8]{13, 10}) ?? panic("fixture CRLF") }

run: fn() {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address: listener.local_addr() ?? panic("address")
    files.write_atomic("{work}/addr.txt", address.bytes()) ?? panic("publish address")
    peer := listener.accept() ?? panic("accept")
    net.set_read_timeout(peer, 5000) ?? panic("request timeout")
    request := [U8]{}
    loop request.len() < 4 || request[request.len() - 4] != (U8{13}) || request[request.len() - 1] != (U8{10}) {
        block: peer.read(512) ?? panic("request read")
        assert(block.len() > 0)
        loop byte in block { request.push(byte) }
        assert(request.len() <= 65536)
    }
    peer.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 13{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}replayed-text".bytes()) ?? panic("response")
}
