# The package floor is examples(2) and the file has one passing example. Below
# the floor, `jet test` and `jet prove` print E2942 and exit 1, and `jet inspect
# claims` shows the grade and the unmet floor (D-GRADE-POLICY1=A). The solver
# proving every obligation raises the run to proved, which meets the floor.
fixture: claims_floor_is_registered_e2942_in_test_prove_and_inspect.fixture
step: jet test fee.jet
limit: time=120
exit: 1
stderr: = ../../cli/claims_below_floor_e2942.txt
step: jet test --json fee.jet
exit: 1
json: stdout doc $.claims.floorMet = false
stdout: ~ "\"code\":\"E2942\"" # the diagnostic rides in the status
step: jet inspect claims fee.jet
exit: 0
stdout: ~ "claims grade: examples(1)" # the newest evidence for this source
stdout: ~ "claims floor: examples(2) (below)" # the package floor, not met
step: jet prove fee.jet
limit: time=120
exit: 1
stdout: ~ "CLAIMS   grade: examples(1), floor: examples(2) (below)" # the run's grade against the floor
stderr: ~ "Claims grade `examples(1)` is below the package floor `examples(2)`" # the parent holds the run to the floor
step: jet prove fee.jet --lens solver --json
limit: time=120
exit: 0
stdout: ~ "\"floor\":\"examples(2)\",\"floorMet\":true" # proving every obligation meets the floor
stdout: !~ "\"code\":\"E2942\"" # so no E2942
step: jet prove fee.jet --lens solver
limit: time=120
exit: 0
stdout: ~ "CLAIMS   grade: proved, floor: examples(2) (met)" # the human line agrees
