#Pre(value > 0, "positive") checked: fn(value: Int) -[]> Int { return value }
#Post(result < 100, "small") doubled: fn(value: Int) -[]> Int { return value * 2 }
#Test("breaking the precondition is a known failure", expected_fail: true) { checked(0) }
#Test("a region expects the precondition to stop") {
    .expect_fail(E3005) { checked(-1) }
}
