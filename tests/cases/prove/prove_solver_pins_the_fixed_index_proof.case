# A `distinct Int(0..3)` index into a `[String#4]` is one fixed_index_bounds
# obligation with the pinned formula and certificate hashes
# (proof-replay-decisions.md "Solver proof boundary"), proved by bare
# backend work and never run by a bare prove.
fixture: prove_solver_pins_the_fixed_index_proof.fixture
step first: jet prove fixture/refinements.jet --lens solver --json
limit: time=120
exit: 0
stdout: ~ "\"obligationKind\":\"fixed_index_bounds\"" # the index is the obligation
stdout: ~ "\"formulaSha256\":\"fef21cce571b7291308098d3395817087c4e7c7ded116b7fb70eec4d439813ba\"" # pinned formula hash
stdout: ~ "\"obligationId\":\"528f3ade991c4e06bc2fff2029af670241162d3a1b14d42f2d4df3a8707010af\"" # this fixture's obligation ID
stdout: ~ "\"certificateSha256\":\"1daaaa1b6476b341d8e5a2682b9a13a632ec828f2a3c94a4596ab59ca8216454\"" # pinned certificate hash
stdout: ~ "\"source\":{\"column\":5,\"line\":4,\"path\":\"fixture/refinements.jet\"},\"state\":\"checked\"" # the row starts at the index
stdout: ~ "\"solver\":{\"disproved\":0,\"proved\":1,\"selected\":1,\"unavailable\":0,\"unknown\":0}" # one proved obligation
step: jet prove fixture/refinements.jet --lens solver --json
exit: 0
stdout: == first # the same run gives the same bytes
step: jet prove fixture/refinements.jet --lens solver
exit: 0
stdout: ~ "SOLVER   proved 1; disproved 0; unknown 0; unavailable 0" # the human summary
stdout: ~ "  proved  fixed_index_bounds at fixture/refinements.jet:4:5" # the proved row
stdout: ~ "  backend native-presburger-v1; steps " # the backend and its work
step: jet prove fixture/refinements.jet --json
exit: 0
stdout: ~ "\"solver\":{\"disproved\":0,\"proved\":0,\"selected\":0,\"unavailable\":0,\"unknown\":0}" # bare prove never runs the solver
