# `jet prove` projects a canonical budget report of exactly the target's sources and skips one of other sources.
# The fixture is Examples/performance/receipts/hello with two reports: the example's
# own (recorded for an earlier src/run.jet, so its source hash differs) and the same
# report re-hashed for today's src/run.jet (new evidence_id and report_id).
fixture: prove_projects_matching_budget_reports_and_skips_other_sources.fixture
step: jet prove src/run.jet --json
limit: time=120
exit: 0
stdout: ~ "\"deterministicBudget\":{\"failed\":0,\"met\":1,\"selected\":1,\"skipped\":0,\"unavailable\":0}" # one compatible budget, met
stdout: ~ "\"budget\":{\"budgetId\":\"receipt:binary\",\"enforcement\":\"fail\",\"evidenceId\":\"1f5fb12b4cf635133165859f2660a720d00d32c3cc7dc2a221747be0784bd53e\",\"reportId\":\"dd98acd936402c0c088fa4873be7bb044e30a83e241c0623fe987acacd46b08e\",\"statistical\":false}" # the report's own identity
stdout: ~ "\"kind\":\"deterministic_budget\",\"outcome\":\"met\",\"producer\":\"jet-budget\"" # the engine's recorded outcome
stdout: !~ "4e6e20468ab1a0a71d0011c0f653b3af3e6a964dfb8876516c06540052bf3c13" # the report of other sources is skipped
stdout: ~ "\"result\":\"pass\"" # nothing is missing
entries: .jet/perf/reports = 2 # prove never writes a report
step: jet prove src/run.jet
limit: time=120
exit: 0
stdout: ~ "BUDGETS  1 met, 0 failed, 0 warned, 0 unavailable · verified canonical reports" # the human summary
stdout: ~ "RESULT   pass" # the human result
