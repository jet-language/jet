#Post(result > 0, "positive") shrink: fn(value: Int) -[]> Int { return value - 10 }
#Post(result > 0, "positive") less: fn(value: Int) -[]> Int { return value - 1 }
#Test("shrinking a small value is known to break its promise", expected_fail: true) { shrink(5) }
#Test("one less than one breaks its promise") { less(1) }
