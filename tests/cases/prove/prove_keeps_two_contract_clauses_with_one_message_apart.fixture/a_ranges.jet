#Pre(value > 0, "out of range") low: fn(value: Int) -[]> Int { return value }
#Pre(value < 100, "out of range") high: fn(value: Int) -[]> Int { return value }
#Test("breaking low's precondition is a known failure", expected_fail: true) { low(0) }
#Test("high is called past its range") { high(100) }
