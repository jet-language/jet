# `policy.claims.min` is package-only and only tightens, like `contain` and
# `harden` (D-GRADE-POLICY1=A, D-MEM-GUARANTEE1=A). The root floor is
# examples(2). A member that sets none inherits it, a member may raise it to
# examples(3), and a member that lowers it is E1215 in test, prove and inspect.
# Source has no `#Policy(claims)` mirror: it is E0355 as `#Policy(contain)` is.
fixture: claims_floor_tightens_only_from_package_root_to_members.fixture
step: jet test inherit/main.jet
limit: time=120
exit: 1
stderr: ~ "Claims grade `examples(1)` is below the package floor `examples(2)`" # the root's floor, inherited
step: jet inspect claims inherit/main.jet
exit: 0
stdout: ~ "claims floor: examples(2) (below)" # inspect reads the same inherited floor
step: jet test raise/main.jet
limit: time=120
exit: 1
stderr: ~ "Claims grade `examples(2)` is below the package floor `examples(3)`" # the member's raised floor
step: jet test lower/main.jet
limit: time=120
exit: 1
stderr: ~ "Member `lower/package.jet` lowers its Package root's claims floor" # the member is named, not just the root
stderr: ~ "`policy.claims.min` cannot weaken from `examples(2)` to `unchecked`" # the tighten rule's own words
stderr: ~ "E1215" # an invalid package manifest
step: jet prove lower/main.jet
limit: time=120
exit: 1
stderr: ~ "Member `lower/package.jet` lowers its Package root's claims floor" # prove holds the same floor
step: jet inspect claims lower/main.jet
exit: 1
stderr: ~ "Member `lower/package.jet` lowers its Package root's claims floor" # inspect refuses the same member
step: jet check scoped.jet
exit: 1
stderr: ~ "`claims` is not a scoped policy" # no #Policy mirror
stderr: ~ "E0355" # an unknown scoped policy
