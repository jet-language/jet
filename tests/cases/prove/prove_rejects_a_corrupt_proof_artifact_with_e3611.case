# A `.jetproof` is published once and never replaced (proof-replay-decisions.md):
# a run whose artifact path already holds other bytes refuses with E3611.
fixture: prove_rejects_a_corrupt_proof_artifact_with_e3611.fixture
step: jet prove main.jet
limit: time=120
exit: 0
entries: .jet/proofs/file/main ext = "jetproof" = 1 # one artifact per run identity
capture: proof = sole-entry .jet/proofs/file/main ext = "jetproof"
capture: name = text cap:proof.after_last("/")
step: jet prove main.jet
exit: 0
entries: .jet/proofs/file/main ext = "jetproof" = 1 # an identical rerun reuses the artifact
append: {cap:proof} "corrupt"
step: jet prove main.jet
normalize: replace {cap:name} ID.jetproof
exit: 1
stdout: empty
# The reserved E3611 copy (D-JPROOF1=A), then the artifact to move aside.
stderr: = ../../cli/prove_artifact_corrupt_e3611.txt
file: {cap:proof} $= "corrupt" # the bytes on disk are left for inspection
