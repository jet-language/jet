# Port of tests/prove.rs:431-520; every original predicate, original fixture bytes.
fixture: prove_lens_union_is_canonical_and_keeps_the_complete_report.fixture
step baseline: jet prove main.jet --json
limit: time=120
exit: 0
step: jet prove main.jet --lens budgets --lens tests --lens budgets --json
limit: time=120
exit: 0
stdout: == baseline
# Both runs consume and produce no records, so their delivery links match and
# they share one artifact (artifact_id hashes report_id and the links). The
# Rust test's count of 2 can't follow from that rule; one artifact is checked.
entries: .jet/proofs/file/main = 1 # same report, same links: one artifact
for file .jet/proofs/file/main as f
capture: aid = text file.split("\"artifact_id\":\"", 1).split("\"", 0) {f.path}
cap:aid.slice(0, 16): = "{f.stem}" # original path.file_stem == artifact_id[..16]
end for
json: files .jet/proofs/file/main doc $ #= 1
json: files .jet/proofs/file/main doc $[*].report_id #distinct= 1 # original: the lens keeps the report id
step: jet prove main.jet --lens budgets --lens tests --lens budgets
limit: time=120
exit: 0
stdout: ~ "LENSES   tests, budgets" # original predicate
step: jet prove main.jet --lens all --lens tests
limit: time=120
exit: 0
stdout: ~ "LENSES   all" # original predicate
stdout: !~ "LENSES   all, tests" # original predicate
step: jet prove main.jet --lens all --json
limit: time=120
exit: 0
stdout: !~ "\"facet\":\"solver\"" # original predicate
