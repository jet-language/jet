# A `#Pre` that fails only where the tests expect it to (D-TEST-XFAIL1 and an
# `.expect_fail(E3005)` region) is the expectation met: its row reached the
# failing side and passes, and the run does not fail. A `#Post` no test reaches
# is declared but not observed, so a passing run is pass_incomplete
# (proof-replay-decisions.md:116-119).
fixture: prove_expected_contract_failures_are_met_and_unreached_clauses_incomplete.fixture
step: jet prove . --json
limit: time=120
exit: 0
stdout: ~ "\"marker\":\"Pre\",\"observation\":\"reached_fail\"" # the precondition was reached and failed
stdout: ~ "\"marker\":\"Post\",\"observation\":\"not_reached\"" # no test calls `doubled`
stdout: !~ "\"kind\":\"contract\",\"outcome\":\"failed\"" # an expected failure is not a failed row
stdout: !~ "\"code\":\"E3005\"" # and carries no stop diagnostic
stdout: ~ "\"contract\":{\"declared\":2,\"failed\":0,\"notObserved\":1,\"observed\":1,\"passed\":1,\"selected\":2,\"skipped\":0}" # the summary counts both clauses
stdout: ~ "\"result\":\"pass_incomplete\"" # a declared clause went unobserved
stderr: empty
step: jet test --json a_checked.jet
limit: time=120
exit: 0
json: stdout doc $.test.expectedFailures = 1
json: stdout doc $.claims.floorMet = true
json: stdout doc $.evidence.evidence has {"claim":"Pre","kind":"contract","outcome":"failed"}
