# A proof artifact is written only through real project directories
# (proof-replay-decisions.md): a symlinked `.jet/proofs` refuses with E3614.
fixture: prove_rejects_an_unsafe_proof_artifact_path_with_e3614.fixture
requires: os:unix
mkdir: .jet
mkdir: elsewhere
symlink: "{work}/elsewhere" .jet/proofs
step: jet prove main.jet
limit: time=120
exit: 1
stdout: empty
# The reserved E3614 copy (D-JPROOF1=A).
stderr: = ../../cli/prove_artifact_unsafe_e3614.txt
entries: elsewhere recursive = 0 # nothing was written through the link
