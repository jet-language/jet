# A sensitive capture records the raw Rand bytes a test drew, and its replay
# serves them back: the failing index the capture saw is the one replay sees.
fixture: prove_sensitive_rand_capture_replays_the_recorded_bytes.fixture
requires: os:unix
env: JET_STORE_DIR={work}/store
step: jet prove main.jet --capture-sensitive
pty: true
stdin: prove_sensitive_rand_wrong_phrase.stdin
exit: 1
stdout: ~ "Type `capture sensitive` to record it" # the disclosure asks for the exact phrase
stdout: ~ "E3627" # any other answer refuses the sensitive capture
file: .jet/replays absent
step: jet prove main.jet --capture-sensitive
pty: true
stdin: prove_sensitive_rand_consent.stdin
exit: 70
stdout: ~ "doesn't exist" # the drawn index is past the one-item list
capture: pos = text stdout.after_first("position ").split(" ", 0)
capture: artifact = text stdout.after_first("REPLAY   captured ").line(0).trim
file: {cap:artifact} ~ "\"roots\":[\"Rand\",\"Time\"]" # the header names the recorded Rand root
file: {cap:artifact} ~ "\"mode\":\"sensitive\"" # the header records the consented mode
step: jet prove main.jet --replay {cap:artifact}
exit: 70
stdout+stderr: ~ "position {cap:pos} doesn't exist" # replay serves the captured bytes, so the same index fails
stdout+stderr: ~ "REPLAY   reproduced" # the replay consumed every record and matched the exit
