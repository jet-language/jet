Build: struct {
    state { Queued, Running, Finished }
    name: String
}
impl Build {
    #State(_ -> Queued) queue: fn(name: String) -> Build { Build{name: name.copy()} }
    #State(Queued -> Running) start: fn(self: &&Build) -> Build { self }
    #State(Running -> Finished) finish: fn(self: &&Build) -> Build { self }
    #State(Finished) report: fn(self) -> String { "finished:{self.name}" }
}
run: fn() {
    build := Build.queue("compile")
    build = build.start()
    build = build.finish()
    print(build.report())
}
