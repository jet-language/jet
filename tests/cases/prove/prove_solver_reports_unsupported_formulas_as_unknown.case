# A claim outside the solver's formulas is an unknown obligation with its
# reason, never skipped and never an error: the run passes with evidence
# incomplete. Fixed-width arithmetic is machine_overflow.
fixture: prove_solver_reports_unsupported_formulas_as_unknown.fixture
step: jet prove nonlinear.jet --lens solver
limit: time=120
exit: 0
stdout: ~ "SOLVER   proved 0; disproved 0; unknown 2; unavailable 0" # both claims are unknown
stdout: ~ "  unknown  function_postcondition at nonlinear.jet:1:1\n  reason: unsupported_formula (variable multiplication)\n" # the reason in plain words
stdout: ~ "  unknown  function_postcondition at nonlinear.jet:6:1\n  reason: machine_overflow\n" # fixed-width arithmetic can wrap
stdout: ~ "RESULT   pass_incomplete" # unknown is incomplete, not a failure
step: jet prove nonlinear.jet --lens solver --json
exit: 0
stdout: ~ "\"formulaSha256\":null" # no formula, no hash
stdout: ~ "\"reason\":\"unsupported_formula\",\"status\":\"unknown\",\"stepLimit\":1000000,\"steps\":0" # never searched
stdout: ~ "\"result\":\"pass_incomplete\"" # the report says incomplete too
