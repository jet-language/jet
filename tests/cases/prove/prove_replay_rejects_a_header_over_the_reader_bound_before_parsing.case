# A reader bounds the header it accepts before it parses it (the v1 bounds in
# proof-replay-decisions): a complete artifact whose header length is one byte over 4 MiB is
# E3628, and the reader never reads that header as JSON.
fixture: prove_replay_rejects_a_header_over_the_reader_bound_before_parsing.fixture
write: large.jetproof-replay = "JREPLAYXaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
poke: large.jetproof-replay at 7 hex "00"
poke: large.jetproof-replay at 8 hex "0100000001004000"
truncate: large.jetproof-replay 4194373
step: jet prove main.jet --replay=large.jetproof-replay --json
exit: 1
stdout: ~ "\"code\":\"E3628\"" # the one JSON report is the limit refusal
stdout: ~ "Replay header exceeds the 4194304-byte limit" # the header bound, not a JSON parse failure
stderr: empty
