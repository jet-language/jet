# A refused `try_alloc` with no `??` propagates its AllocError implicitly out
# of `run: fn() AllocError!`. The program stops with the AllocError stop
# (record, failing line), exit 1, through the runtime's AllocError show export,
# never an internal compiler error (exit 101), on O0, O1 and O2.
fixture: try_alloc_refusal_propagates_as_the_coded_alloc_error_stop.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0
step o0: jet run --optimize=none main.jet
exit: 1
stdout: = "first 7\n"
stderr: ~ "Error: AllocError { requested_bytes: 8, allocator: " # the record, rendered by the runtime show export
stderr: ~ "Fixed" # the refusing allocator
stderr: ~ "failed here: run (main.jet:10)" # the propagating line
step o1: jet run --optimize=basic main.jet
exit: 1
stdout: = "first 7\n"
stderr: ~ "Error: AllocError { requested_bytes: 8, allocator: " # the record, rendered by the runtime show export
stderr: ~ "Fixed" # the refusing allocator
stderr: ~ "failed here: run (main.jet:10)" # the propagating line
step o2: jet run --optimize=full main.jet
exit: 1
stdout: = "first 7\n"
stderr: ~ "Error: AllocError { requested_bytes: 8, allocator: " # the record, rendered by the runtime show export
stderr: ~ "Fixed" # the refusing allocator
stderr: ~ "failed here: run (main.jet:10)" # the propagating line
