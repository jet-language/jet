
use core.mem
Point: struct {
    x: Int
    y: Int
}
run: fn() {
    bytes := [U8#128]{ uninit }
    fixed: mem.Fixed.over(bytes)
    value: fixed.alloc(9)
    point: fixed.alloc(Point{x: 3, y: 4})
    print(value)
    print(point.x)
    print(point.y)
    fixed.reset()
    again: fixed.alloc(10)
    print(again)
    fixed.reset()
    close(fixed)
}
