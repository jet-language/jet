# `--checked-alloc` (the checked_alloc build option) links the runtime's
# checked memory allocator, which a build without it does not link at all:
# the unchecked image has none of its symbols, the checked one its start-up
# hook, and both print the same. `jet run --checked-alloc` links the runtime
# pack in full (the prelinked runtime image holds no checked allocator). The
# web runtime partition holds none either: a web build runs unchecked, and
# `--checked-alloc` with `--target web` is refused.
# Compiler/JetRuntime/Tests/run-alloc-parity.mjs covers the checked traps.
fixture: checked_alloc_is_chosen_at_build_time.fixture
env: NO_COLOR=1
step: jet build main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "part0,part1,part2\n"
when tool objdump
step: objdump -t .jet/build/main
exit: 0
stdout: !~ "jet_rt_alloc_check" # the unchecked image links none of the checked allocator
end when
step: jet build --checked-alloc main.jet
exit: 0
step: {work}/.jet/build/main
exit: 0
stdout: = "part0,part1,part2\n"
when tool objdump
step: objdump -t .jet/build/main
exit: 0
stdout: ~ "jet_rt_alloc_check_init" # the checked image links its start-up hook
end when
step: jet run --checked-alloc main.jet
exit: 0
stdout: = "part0,part1,part2\n"
when tool node
step: jet build --target web main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = "part0,part1,part2\n" # the web runtime starts no checked heap
end when
step: jet build --target web --checked-alloc main.jet
exit: 2
stderr: ~ "Error [jet.InvalidCommandInput]: `--checked-alloc` asks for the checked allocator, and a web build has none" # refused before the build, not at link
