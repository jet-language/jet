
struct Item { value: Int }

fn run() {
    pool := Pool<Item>.new()
    first :: pool.add(Item{ value: 10 })
    stale :: first
    removed :: pool.remove(first)
    second :: pool.add(Item{ value: 20 })
    if removed == Val(item) {
        print(item.value)
    } else {
        print(-1)
    }
    print(stale == second)
    print(pool[second].value)
}
