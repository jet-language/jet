
use core.mem

fn run() {
    arena :: mem.Arena.new(capacity: 32)
    a :: arena.alloc(1)
    print(a)
    &arena.reset()
    again :: arena.alloc(2)
    print(again)
    bump :: mem.Bump.new(capacity: 32)
    b :: bump.alloc(3)
    print(b)
    pool :: mem.Pool.new(slots: 2)
    p :: pool.alloc(4)
    print(p)
    fixed :: mem.Fixed.new(size: 128)
    f :: fixed.alloc(5)
    print(f)
}
