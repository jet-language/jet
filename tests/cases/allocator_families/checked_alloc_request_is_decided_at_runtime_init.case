# JET_CHECKED_ALLOC=1 at start is decided by the runtime's .init_array
# (Alloc.jet jet_rt_alloc_check_refuse_init), before any entry: a build
# without the checked heap refuses with status 70 rather than run unchecked.
# Compiler/JetRuntime/Tests/run-alloc-parity.mjs embed-* covers a foreign host
# that never calls jet_rt_host_arguments.
fixture: checked_alloc_request_is_decided_at_runtime_init.fixture
step: jet build main.jet
unset: JET_CHECKED_ALLOC
exit: 0
step: {work}/.jet/build/main
unset: JET_CHECKED_ALLOC
exit: 0
stdout: = "part0,part1,part2\n"
step: {work}/.jet/build/main
env: JET_CHECKED_ALLOC=1
exit: 70
stdout: empty
stderr: = "jet checked allocator (JET_CHECKED_ALLOC=1): this program was built without the checked allocator; build it again with JET_CHECKED_ALLOC=1 set\n"
