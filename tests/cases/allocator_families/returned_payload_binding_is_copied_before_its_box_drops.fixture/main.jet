// A plain-data struct bound out of an Option or Result box and returned:
// the box drops when the function returns, so the returned value must be
// read before that drop. The checked heap poisons a freed block, so a read
// after the drop would print `true` for every field.
Facts: struct {
    copyable: Bool
    cloneable: Bool
    resource: Bool
    complete: Bool
}

known: fn(copyable: Bool, resource: Bool) -> Facts {
    Facts{copyable: copyable, cloneable: !resource, resource: resource, complete: true}
}

param_facts: fn(name: String, params: [String]) -> Facts? {
    loop param in params {
        if param == name -> return Val(known(false, false))
    }
    None
}

checked_facts: fn(name: String, params: [String]) -> Facts Err! {
    loop param in params {
        if param == name -> return Ok(known(false, false))
    }
    Err("no {name}")
}

show: fn(label: String, f: Facts) {
    print("{label}: {f.copyable} {f.cloneable} {f.resource} {f.complete}")
}

arrow_return: fn(params: [String]) -> Facts {
    if param_facts("T", params) == .Val(facts) -> return facts
    known(true, true)
}

block_return: fn(params: [String]) -> Facts {
    if param_facts("T", params) == .Val(facts) {
        return facts
    }
    known(true, true)
}

bound_first: fn(params: [String]) -> Facts {
    found: param_facts("T", params)
    if found == .Val(facts) -> return facts
    known(true, true)
}

result_payload: fn(params: [String]) -> Facts {
    if checked_facts("T", params) == .Ok(facts) -> return facts
    known(true, true)
}

matched: fn(params: [String]) -> Facts {
    if param_facts("T", params) == {
        .Val(facts) -> facts
        None -> known(true, true)
    }
}

run: fn() {
    params: [String]{"T"}
    show("arrow", arrow_return(params))
    show("block", block_return(params))
    show("bound", bound_first(params))
    show("result", result_payload(params))
    show("matched", matched(params))
}
