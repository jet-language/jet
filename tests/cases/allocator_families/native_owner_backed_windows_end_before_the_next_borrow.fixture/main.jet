// #1163 / D-MEM-VIEWRET1=B: an owner-backed collection keeps the list in a
// named field. Callers borrow element windows through `View` / `ViewMut` with
// public provenance — no lifetime syntax, no second view mechanism.
// Jet range windows are inclusive, so one element is `i..i`.
Book: struct {
    title: String
    pages: Int
}

Library: struct {
    books: [Book]
}

book_at: fn(lib: Library, i: Int) -> View<Book> { lib.books[i..i] }

edit_at: fn(lib: &Library, i: Int) -> ViewMut<Book> { &lib.books[i..i] }

run: fn() {
    lib := Library{
        books: [Book]{
            {title: "Dune", pages: 412},
            {title: "Neuromancer", pages: 271},
        },
    }
    first: book_at(lib, 0)
    print(first[0].title)
    print(first[0].pages)
    dune: edit_at(&lib, 0)
    dune[0].pages += 10
    neuro: edit_at(&lib, 1)
    neuro[0].pages += 9
    print(lib.books[0].pages)
    print(lib.books[1].pages)
}
