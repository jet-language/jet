# tests/compute_cuda.rs::cuda_public_precision_gate_is_identical_on_all_tiers at tests/compute_cuda.rs:16; hand-port
# The ComputeDevice example prints the same rejected f64 CUDA gate on the release and default tiers.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step release: jet run --release {root}/Examples/Math/Compute/ComputeDevice.jet
exit: 0 # the tier-agreement harness assert_example_cli_tiers_agree release run succeeds
stdout: ~ "\ncuda:f64:rejected\n" # tests/compute_cuda.rs:17; the gate is one line of the merged device example
step default: jet run {root}/Examples/Math/Compute/ComputeDevice.jet
exit: == release # the tier-agreement harness exit code agrees with release
stdout: == release # the tier-agreement harness output agrees with release
