# Claim: env.decode hides the value of a field whose variable name
# holds a secret word inside a segment (APP_DB_PASSWORD, APP_API_KEY, and the
# renamed APP_STRIPE_SECRET), keeps an ordinary bad value visible, and frames a
# missing value with the variable that would have supplied it (APP_DB_URL;
# APP_REPLICA for a whole missing record).
fixture: decode_hides_secret_named_values_and_names_the_missing_variable.fixture
env: NO_COLOR=1
env: APP_PORT=not-a-port
env: APP_DB_PASSWORD=hunter2
env: APP_API_KEY=sk-live-123
env: APP_STRIPE_SECRET=sk-stripe
step decode: jet run -A main.jet
exit: 0
stdout: = decode_hides_secret_named_values_and_names_the_missing_variable.stdout.expected
stdout: !~ "hunter2" # the password's value never prints
stdout: !~ "sk-" # neither key's value prints
