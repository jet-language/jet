use {
    env: core.sys
    testing: core.testing
}

peek: fn(name: String) -[Env]> String { env.get(name) ?? "missing" }

run: fn() {
    env.set("JET_WORLD_ENV_KEPT", "process")
    testing.world(
    world -> {
        print("world start: startup={peek("JET_WORLD_ENV_START")} kept={peek("JET_WORLD_ENV_KEPT")}")
        env.set("JET_WORLD_ENV_KEPT", "world")
        env.set("JET_WORLD_ENV_ONLY", "world")
        removed: env.unset("JET_WORLD_ENV_START") ?? false
        child: task peek("JET_WORLD_ENV_ONLY") ?? return
        seen: child.join() ?? return
        print("world end: removed={removed} kept={peek("JET_WORLD_ENV_KEPT")} child={seen} startup={peek("JET_WORLD_ENV_START")}")
    },
    )
    print("process: startup={peek("JET_WORLD_ENV_START")} kept={peek("JET_WORLD_ENV_KEPT")} only={peek("JET_WORLD_ENV_ONLY")}")
}
