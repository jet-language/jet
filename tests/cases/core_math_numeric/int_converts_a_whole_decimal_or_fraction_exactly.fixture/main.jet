use math: core.math

// Int{x} over the exact number types: a whole Decimal or Fraction converts
// exactly, and checked(Int{x}) is None where Int{x} would stop.
run: fn() {
    price: 2.50
    whole: -12.00
    print(Int{whole})
    print(Int{math.round(price)})
    a: 21
    b: 7
    print(Int{a / b})
    print(checked(Int{a / b}) ?? -1)
    print(checked(Int{price}) ?? -1)
    print(checked(Int{b / 2}) ?? -1)
}
