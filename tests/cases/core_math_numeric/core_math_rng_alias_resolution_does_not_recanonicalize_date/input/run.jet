
use {
    random: core.math.random
    testing: core.testing
    time: core.time
}
Dated: struct { day: Date, stream: testing.RNG }
day: fn(value: Date) -> Date { return value }
run: fn() {
    dated := Dated{day: day(time.new(2024, 2, 29)), stream: random.rng(42)}
    print(dated.day)
    print(dated.day.year())
    print(dated.stream.bool())
}
