// The stock coordinate constructors keep both coordinates and start in frame 0.
use math: core.math

run: fn() {
    point: math.ScreenPoint.new(240.0, -120.5)
    print("screen point {point.x},{point.y} frame {point.frame_id}")
    delta: math.WorldDelta.new(-3.25, 4.0)
    print("world delta {delta.x},{delta.y} frame {delta.frame_id}")
    sum: math.WorldDelta.new(1.5, 2.0) + delta
    print("world delta sum {sum.x},{sum.y} frame {sum.frame_id}")
}
