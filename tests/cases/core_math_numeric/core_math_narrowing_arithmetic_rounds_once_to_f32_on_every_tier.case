# core.math's C23 narrowing arithmetic (f32_add, f32_sub, f32_mul, f32_div,
# f32_fma, f32_sqrt) rounds the exact result once to F32: every corpus call
# (special values, operands whose Float result is a binary32 midpoint the
# exact result is not, so rounding the Float result again would land on the
# wrong side, and seeded random operands) returns the binary32 bits exact
# rational arithmetic rounds to, on O0, O1, O2 and the web build.
fixture: core_math_narrowing_arithmetic_rounds_once_to_f32_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_narrowing_arithmetic_rounds_once_to_f32_on_every_tier.1.out
stderr: = ""
step o1: jet run --optimize=basic main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_narrowing_arithmetic_rounds_once_to_f32_on_every_tier.1.out
stderr: = ""
step o2: jet run --optimize=full main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_narrowing_arithmetic_rounds_once_to_f32_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_narrowing_arithmetic_rounds_once_to_f32_on_every_tier.1.out
stderr: = ""
