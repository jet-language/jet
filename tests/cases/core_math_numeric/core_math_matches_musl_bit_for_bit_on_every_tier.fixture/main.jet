// Every corpus row is a call of one core.math function: its argument words,
// then musl 1.2.5's result words, as hex binary64 bits (an Int argument or
// result is a two's-complement word). A row after a `#mpfr` line is where
// musl is not correctly rounded: its comment gives musl's word, and the row
// holds MPFR's. The program prints one line per function with the rows it
// checked and how many results differ, plus the first differing rows.
use {
    math: core.math
}

CEIL: comptime { embed_file("corpus/ceil.txt") }
ERF: comptime { embed_file("corpus/erf.txt") }
ERFC: comptime { embed_file("corpus/erfc.txt") }
FDIM: comptime { embed_file("corpus/fdim.txt") }
FLOOR: comptime { embed_file("corpus/floor.txt") }
FMA: comptime { embed_file("corpus/fma.txt") }
FMAX: comptime { embed_file("corpus/fmax.txt") }
FMIN: comptime { embed_file("corpus/fmin.txt") }
FMOD: comptime { embed_file("corpus/fmod.txt") }
FREXP: comptime { embed_file("corpus/frexp.txt") }
ILOGB: comptime { embed_file("corpus/ilogb.txt") }
LGAMMA: comptime { embed_file("corpus/lgamma.txt") }
LOGB: comptime { embed_file("corpus/logb.txt") }
MODF: comptime { embed_file("corpus/modf.txt") }
NEXTAFTER: comptime { embed_file("corpus/nextafter.txt") }
REMAINDER: comptime { embed_file("corpus/remainder.txt") }
REMQUO: comptime { embed_file("corpus/remquo.txt") }
ROUNDEVEN: comptime { embed_file("corpus/roundeven.txt") }
SCALBN: comptime { embed_file("corpus/scalbn.txt") }
SQRT: comptime { embed_file("corpus/sqrt.txt") }
TGAMMA: comptime { embed_file("corpus/tgamma.txt") }
TRUNC: comptime { embed_file("corpus/trunc.txt") }

hex_value: fn(b: U8) -> Int {
    n: Int.from_u8(b)
    if n >= 48 && n <= 57 -> return n - 48
    n - 87
}

// The 16-digit hex word at `at`, as the signed Int math.from_bits takes.
word_at: fn(raw: [U8], at: Int) -> Int {
    n := 0
    loop i in 0..<16 -> n = n * 16 + hex_value(raw[at + i])
    if n > 9223372036854775807 -> n = n - 18446744073709551616
    n
}

hex_word: fn(word: Int) -> String {
    digits: "0123456789abcdef".bytes()
    n := if word < 0 -> word + 18446744073709551616 else -> word
    out := [U8]{}
    loop _ in 0..<16 {
        out.push(digits[n %% 16])
        n = n /% 16
    }
    out.reverse()
    String.from_bytes(out) ?? ""
}

is_nan_word: fn(word: Int) -> Bool {
    magnitude: if word < 0 -> word + 9223372036854775808 else -> word
    magnitude > 9218868437227405312
}

// How many of a row's words are arguments; the rest are results.
arity: fn(name: String) -> Int {
    if name == "fma" -> return 3
    if name == "fdim" || name == "fmax" || name == "fmin" || name == "fmod" -> return 2
    if name == "nextafter" || name == "remainder" || name == "remquo" || name == "scalbn" -> return 2
    1
}

// The one Float result of `name` on Float arguments `a`.
value: fn(name: String, a: [Float]) -> Float {
    if name == "ceil" -> return math.ceil(a[0])
    if name == "erf" -> return math.erf(a[0])
    if name == "erfc" -> return math.erfc(a[0])
    if name == "fdim" -> return math.fdim(a[0], a[1])
    if name == "floor" -> return math.floor(a[0])
    if name == "fma" -> return math.fma(a[0], a[1], a[2])
    if name == "fmax" -> return math.max_float(a[0], a[1])
    if name == "fmin" -> return math.min_float(a[0], a[1])
    if name == "fmod" -> return math.fmod(a[0], a[1])
    if name == "lgamma" -> return math.lgamma(a[0])
    if name == "logb" -> return math.logb(a[0])
    if name == "nextafter" -> return math.next_after(a[0], a[1])
    if name == "remainder" -> return math.remainder(a[0], a[1])
    if name == "roundeven" -> return math.round_even(a[0])
    if name == "sqrt" -> return math.sqrt(a[0])
    if name == "tgamma" -> return math.gamma(a[0])
    math.trunc(a[0])
}

// The result words of `name` on argument words `w`.
evaluate: fn(name: String, w: [Int]) -> [Int] {
    if name == "frexp" {
        parts: math.frexp(math.from_bits(w[0]))
        return [Int]{math.to_bits(parts.frac), parts.exp}
    }
    if name == "ilogb" -> return [Int]{math.ilogb(math.from_bits(w[0])) ?? 0}
    if name == "modf" {
        parts: math.modf(math.from_bits(w[0]))
        return [Int]{math.to_bits(parts.fract), math.to_bits(parts.whole)}
    }
    if name == "remquo" {
        parts: math.rem_quo(math.from_bits(w[0]), math.from_bits(w[1]))
        return [Int]{math.to_bits(parts.rem), parts.quo}
    }
    if name == "scalbn" -> return [Int]{math.to_bits(math.ldexp(math.from_bits(w[0]), w[1]))}
    arguments := [Float]{}
    loop word in w -> arguments.push(math.from_bits(word))
    [Int]{math.to_bits(value(name, arguments))}
}

// WebAssembly leaves the sign and payload of an arithmetic NaN to the engine,
// so where invalid arithmetic does not give x86's default NaN (sign set, quiet
// payload 0), a NaN result matches any NaN.
nan_bits_are_exact: fn() -> Bool {
    infinity: math.from_bits(word_at("7ff0000000000000".bytes(), 0))
    math.to_bits(infinity - infinity) == -2251799813685248
}

// Whether the comment line at `at` is `#mpfr`.
marks_mpfr: fn(raw: [U8], at: Int) -> Bool {
    mark: "#mpfr\n".bytes()
    if at + mark.len() > raw.len() -> return false
    loop i in 0..<mark.len() {
        if raw[at + i] != mark[i] -> return false
    }
    true
}

check: fn(name: String, corpus: String, exact_nan: Bool) {
    raw: corpus.bytes()
    at := 0
    rows := 0
    wrong := 0
    against_mpfr := 0
    mpfr := false
    count: arity(name)
    loop at < raw.len() {
        if raw[at] == (U8{35}) {
            if marks_mpfr(raw, at) -> mpfr = true
            loop raw[at] != (U8{10}) -> at = at + 1
            at = at + 1
            next
        }
        arguments := [Int]{}
        want := [Int]{}
        loop {
            word: word_at(raw, at)
            if arguments.len() < count {
                arguments.push(word)
            } else {
                want.push(word)
            }
            at = at + 17
            if raw[at - 1] == (U8{10}) -> break
        }
        got: evaluate(name, arguments)
        rows = rows + 1
        source: if mpfr -> "mpfr" else -> "musl"
        if mpfr -> against_mpfr = against_mpfr + 1
        mpfr = false
        same := got.len() == want.len()
        loop i in 0..<want.len() {
            if same && got[i] != want[i] && (exact_nan || !is_nan_word(got[i]) || !is_nan_word(want[i])) -> same = false
        }
        if !same {
            wrong = wrong + 1
            if wrong <= 3 {
                shown := [String]{}
                loop word in arguments -> shown.push(hex_word(word))
                gotten := [String]{}
                loop word in got -> gotten.push(hex_word(word))
                wanted := [String]{}
                loop word in want -> wanted.push(hex_word(word))
                print("{name}({shown.join(", ")}) = {gotten.join(" ")}, {source} {wanted.join(" ")}")
            }
        }
    }
    if against_mpfr > 0 {
        print("{name}: {rows} rows, {wrong} differ from musl, or from MPFR on the {against_mpfr} where musl is not correctly rounded")
    } else {
        print("{name}: {rows} rows, {wrong} differ from musl")
    }
}

run: fn() {
    exact_nan: nan_bits_are_exact()
    check("ceil", CEIL, exact_nan)
    check("erf", ERF, exact_nan)
    check("erfc", ERFC, exact_nan)
    check("fdim", FDIM, exact_nan)
    check("floor", FLOOR, exact_nan)
    check("fma", FMA, exact_nan)
    check("fmax", FMAX, exact_nan)
    check("fmin", FMIN, exact_nan)
    check("fmod", FMOD, exact_nan)
    check("frexp", FREXP, exact_nan)
    check("ilogb", ILOGB, exact_nan)
    check("lgamma", LGAMMA, exact_nan)
    check("logb", LOGB, exact_nan)
    check("modf", MODF, exact_nan)
    check("nextafter", NEXTAFTER, exact_nan)
    check("remainder", REMAINDER, exact_nan)
    check("remquo", REMQUO, exact_nan)
    check("roundeven", ROUNDEVEN, exact_nan)
    check("scalbn", SCALBN, exact_nan)
    check("sqrt", SQRT, exact_nan)
    check("tgamma", TGAMMA, exact_nan)
    check("trunc", TRUNC, exact_nan)
}
