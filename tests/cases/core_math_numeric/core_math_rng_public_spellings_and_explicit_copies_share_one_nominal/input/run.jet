
use {
    random: core.math.random
    testing: core.testing
}

Envelope: struct { stream: testing.RNG }
identity: fn<T>(value: &&T) -> T { return value }
into_testing: fn(value: &&RNG) -> testing.RNG { return value }
into_random: fn(value: &&testing.RNG) -> random.RNG { return value }
into_bare: fn(value: &&random.RNG) -> RNG { return value }
draw: fn(stream: &RNG) {
    print(stream.bool())
    print(stream.bool(0.25))
}
run: fn() {
    original := random.rng(42)
    independent := original.copy()
    envelope := Envelope{stream: into_testing(identity<RNG>(original))}
    round_trip := into_bare(into_random(envelope.stream.move()))
    draw(round_trip)
    draw(independent)
    print(round_trip)
    print(independent)
}
