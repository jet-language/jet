# math.bessel_j and math.bessel_y are POSIX's jn and yn (j0, j1, y0 and y1
# are their orders 0 and 1): on every corpus row (orders from -101 to 400
# against signed zeros, infinities, a NaN, subnormals, the boundaries of the
# approximation intervals, the first zeros, values past 2^302 and the
# largest binary64, plus seeded random orders and arguments) each result
# matches glibc 2.44's: a NaN where glibc gives a NaN, the same infinity or
# signed zero, else within 256 units in the last place or 2^-47. O0, O1, O2
# and the web build print the same lines.
fixture: core_math_bessel_functions_match_glibc_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_bessel_functions_match_glibc_on_every_tier.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_bessel_functions_match_glibc_on_every_tier.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_bessel_functions_match_glibc_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_bessel_functions_match_glibc_on_every_tier.1.out
stderr: = ""
