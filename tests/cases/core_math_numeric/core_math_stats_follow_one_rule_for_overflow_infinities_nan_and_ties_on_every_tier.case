# D-STATS-CANONICAL1=A: core.math.stats mean, sum, rank, min and max follow
# one rule, and each row pins the rule's exact value (every Float prints as
# its bits), the same at O0, O1 and O2:
# - mean: [1e308, 1e308] is 1e308; one infinity gives that infinity; both
#   infinities, any NaN, or no samples give None.
# - sum: 1e16 + 1 - 1e16 is 1. [1e308, 1e308, -1e308] and
#   [-1e308, -1e308, 1e308, 0.5] overflow the first pass and the rescaled
#   second pass gives 1e308 and -1e308; [1e308, 1e308] is +inf; one infinity
#   gives it, both or any NaN give NaN; no samples give +0.
# - rank: ties share their average position ([1, 1, 2] is [1.5, 1.5, 3],
#   three 3s share 5), infinities rank as the extremes, any NaN gives [].
# - min and max: any NaN or no samples give None; -inf and +inf are ordinary
#   values; of 0 and -0 the first wins. range of [-inf, 1] is None.
# - kde_random repeats under a fixed seed and refuses an infinite sample.
fixture: core_math_stats_follow_one_rule_for_overflow_infinities_nan_and_ties_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = "mean [1e308, 1e308]: 9214871658872686752\nmean [inf, 1]: 9218868437227405312\nmean [-inf, 1]: -4503599627370496\nmean [inf, -inf]: None\nmean [NaN, 1]: None\nmean []: None\nsum [1e16, 1, -1e16]: 4607182418800017408\nsum [1e308, 1e308, -1e308]: 9214871658872686752\nsum [1e308, 1e308]: 9218868437227405312\nsum [-1e308, -1e308, 1e308, 0.5]: -8500377982089056\nsum [inf, 1]: 9218868437227405312\nsum [inf, -inf] is NaN: true\nsum [NaN, 1] is NaN: true\nsum []: 0\nrank [1, 1, 2]: [4609434218613702656, 4609434218613702656, 4613937818241073152]\nrank [inf, -inf, 0, inf]: [4615063718147915776, 4607182418800017408, 4611686018427387904, 4615063718147915776]\nrank [3, 1, 2, 1, 3, 3]: [4617315517961601024, 4609434218613702656, 4613937818241073152, 4609434218613702656, 4617315517961601024, 4617315517961601024]\nrank [NaN, 1]: []\nmin [NaN, 1]: None\nmax [1, NaN]: None\nmin []: None\nmax []: None\nmin [-inf, 1]: -4503599627370496\nmax [1, inf]: 9218868437227405312\nmin [0, -0]: 0\nmin [-0, 0]: -9223372036854775808\nrange [-inf, 1]: None\nkde_random repeats under seed 7: true\nkde_random [1, inf]: []\n"
