# #6615 c5: the F32 bit pair (`__to_bits_f32`, `__from_bits_f32`) is a pure
# intrinsic the IR lowers itself, with no runtime call and no conversion, so a
# signaling NaN of either sign and a payload NaN round-trip their exact bits.
# The scalar composition test checks those bits; this runs it at O0, O1 and
# O2, so an optimizer fold or a float conversion on any level fails here.
env: NO_COLOR=1
step: jet test {root}/Core/Math/Math.jet --filter "math scalar composition" --optimize=none
timeout: 1800s
exit: 0
stdout: ~ "1 passed, 0 failed" # O0 keeps the signaling NaN's bits
stderr: !~ "internal compiler error" # no level crashes the compiler
step: jet test {root}/Core/Math/Math.jet --filter "math scalar composition" --optimize=basic
timeout: 1800s
exit: 0
stdout: ~ "1 passed, 0 failed" # O1 keeps the signaling NaN's bits
stderr: !~ "internal compiler error" # no level crashes the compiler
step: jet test {root}/Core/Math/Math.jet --filter "math scalar composition" --optimize=full
timeout: 1800s
exit: 0
stdout: ~ "1 passed, 0 failed" # O2 keeps the signaling NaN's bits
stderr: !~ "internal compiler error" # no level crashes the compiler
