# core.math's exact and bit-level Float functions that no musl corpus covers
# (fabs, copysign, canonicalize, the payloads, is_signaling, is_normal,
# is_subnormal, is_canonical, is_finite, is_inf, is_nan, is_zero, sign_bit,
# total_order, the maximum and minimum family, ldexp, next_up, next_down) are
# C23's binary64 functions: every corpus call (binary64 special values, quiet
# and signaling NaNs with payloads, libc-test's round-to-nearest vectors and
# seeded random operands) returns the
# bits glibc 2.42 returns, on O0, O1, O2 and the web build. A signaling NaN
# keeps its bits through the sign-bit, payload and signaling calls, and every
# encoding, an infinity too, is canonical.
fixture: core_math_exact_and_bit_functions_match_c23_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
