// a * b + c rounds the product before the add on every tier. With
// a = 1 + 2^-k and b = 1 - 2^-k the exact product 1 - 2^-2k rounds to 1 once
// 2k passes the format's precision, so a * b - 1 is 0; a fused multiply-add
// would keep the -2^-2k. math.fma is the one spelling that fuses.
use {
    math: core.math
}

mul_add: fn(a: Float, b: Float, c: Float) -> Float { a * b + c }

mul_add_f32: fn(a: F32, b: F32, c: F32) -> F32 { a * b + c }

run: fn() {
    one: Float{1.0}
    zero: Float{0.0}
    float_steps: [Int]{27, 30, 40}
    loop k in float_steps {
        tiny: math.ldexp(one, -k)
        a: one + tiny
        b: one - tiny
        product: a * b
        print("Float k={k}: a*b-1 {mul_add(a, b, -one) == zero}, -1+a*b {-one + a * b == zero}, a*b then -1 {product - one == zero}, fma {math.fma(a, b, -one) == -(tiny * tiny)}")
    }
    one_f32: F32{one}
    zero_f32: F32{zero}
    f32_steps: [Int]{13, 20}
    loop k in f32_steps {
        tiny: math.ldexp(one, -k)
        a: F32{one + tiny}
        b: F32{one - tiny}
        print("F32 k={k}: a*b-1 {mul_add_f32(a, b, -one_f32) == zero_f32}, -1+a*b {-one_f32 + a * b == zero_f32}")
    }
}
