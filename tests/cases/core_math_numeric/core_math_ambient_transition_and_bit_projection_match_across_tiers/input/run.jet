package: { name: "run", authority: { allow: [Rand] } }
use {
    math: core.math
    random: core.math.random
}

run: fn() {
    random.seed(1)
    print(random.getrandbits(63))
    random.seed(1)
    print(math.random())
    random.seed(0)
    print(random.getrandbits(1))
    print(random.getrandbits(0))
}
