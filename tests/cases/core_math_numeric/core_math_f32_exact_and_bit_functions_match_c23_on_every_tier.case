# The F32 forms of core.math's exact and bit-level functions (fabs,
# copysign, canonicalize, the payloads, is_signaling, is_normal,
# is_subnormal, total_order, fmod, remainder, fdim, the max and min family,
# round_even, floor, ceil, trunc, logb, ldexp, next_up, next_down,
# next_after) are C23's binary32 functions: every corpus call (binary32
# special values, quiet and signaling NaNs with payloads, and seeded random
# operands) returns the bits glibc 2.42's float function (musl 1.2.5's fmaxf
# and fminf) returns, on O0, O1, O2 and the web build. A signaling NaN keeps
# its bits through the sign-bit, payload and signaling calls, and next_up
# steps by one binary32 unit.
fixture: core_math_f32_exact_and_bit_functions_match_c23_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_f32_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step o1: jet run --optimize=basic main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_f32_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step o2: jet run --optimize=full main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_f32_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_f32_exact_and_bit_functions_match_c23_on_every_tier.1.out
stderr: = ""
