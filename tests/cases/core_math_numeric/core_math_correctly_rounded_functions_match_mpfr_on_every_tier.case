# The correctly rounded core.math functions return MPFR's bits: every corpus
# row (special values, musl's libc-test vectors, CORE-MATH's worst cases for
# rounding and seeded random inputs) returns the result bits MPFR rounds to, on
# O0, O1, O2 and the web build. Each row where musl 1.2.5 differs lists musl's
# result word as a finding, not a target, and the program counts them.
fixture: core_math_correctly_rounded_functions_match_mpfr_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_correctly_rounded_functions_match_mpfr_on_every_tier.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_correctly_rounded_functions_match_mpfr_on_every_tier.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_correctly_rounded_functions_match_mpfr_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_correctly_rounded_functions_match_mpfr_on_every_tier.1.out
stderr: = ""
