# The F32 forms of the correctly rounded core.math functions are correctly
# rounded at binary32: every all-F32 corpus call (special values,
# CORE-MATH's binary32 worst cases, the inputs whose binary64 result is a
# binary32 midpoint, and seeded random inputs) returns the binary32 bits MPFR
# rounds to, on O0, O1, O2 and the web build. Each row where musl 1.2.5's
# float function differs lists musl's result word as a finding, not a target,
# and the program counts them.
fixture: core_math_correctly_rounded_f32_forms_match_mpfr_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_math_correctly_rounded_f32_forms_match_mpfr_on_every_tier.1.out
stderr: = ""
step o1: jet run --optimize=basic main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_math_correctly_rounded_f32_forms_match_mpfr_on_every_tier.1.out
stderr: = ""
step o2: jet run --optimize=full main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_math_correctly_rounded_f32_forms_match_mpfr_on_every_tier.1.out
stderr: = ""
step: jet build --target web main.jet
env: JET_STORE_DIR={work}/cache/web
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = core_math_correctly_rounded_f32_forms_match_mpfr_on_every_tier.1.out
stderr: = ""
