# math.trunc, floor, ceil, round and round_even are fn<T: Roundable>(n: T) -> T:
# Float and F32 stay binary floats (a NaN is itself), Decimal and Fraction round
# exactly in both tie rules, Int and U8 are themselves, x.rounded(mode) takes
# the mode as a value on Float, F32, Decimal and every sized integer (an
# integer is itself), and a user type rounds through its own impl. The same
# output on O0, O1 and O2.
fixture: roundings_keep_the_argument_type.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = roundings_keep_the_argument_type.out
stderr: empty
step: jet run -O1 main.jet
exit: 0
stdout: = roundings_keep_the_argument_type.out
stderr: empty
step: jet run -O2 main.jet
exit: 0
stdout: = roundings_keep_the_argument_type.out
stderr: empty
