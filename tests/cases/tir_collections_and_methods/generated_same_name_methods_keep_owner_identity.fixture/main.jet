
struct D {
    value: Int
}
struct Pair {
    a: Int
    b: Int
}
fn align(left: D, right: D) -> Pair { Pair{a: left.value, b: right.value} }
impl D.Add {
    fn add(self, rhs: D) -> D {
        pair :: align(self, rhs)
        return D{value: pair.a + pair.b}
    }
}
fn run() {
    sum :: (D{value: 1} + D{value: 2})
    print(sum.value)
    print(Pair{a: 1, b: 2} == Pair{a: 1, b: 2})
}
