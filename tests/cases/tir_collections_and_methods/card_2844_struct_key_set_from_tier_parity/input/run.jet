
struct CacheKey {
    user: String
    resource: String
}

fn run() {
    scores := [CacheKey:Int]{}
    print(scores.add(CacheKey{user: "ada", resource: "profile"}, 7) ?? -1)
    keys :: scores.keys().to_list()
    key_set :: Set.from(keys)
    print(keys.len())
    print(key_set.len())
    print(key_set.has(CacheKey{user: "ada", resource: "profile"}))
}
