fn build() -[]> [Int] {
    xs := [3, 1, 2]
    xs.push(5)
    xs.insert(0, 0)
    xs.sort()
    xs.reverse()
    return xs
}
fn run() {
    xs := build()
    print(xs.len())
    print(xs.contains(5))
    print(xs.index_of(2))
    g := xs.get(0)
    print(g ?? 0)
    f := xs.first()
    print(f ?? 0)
}
