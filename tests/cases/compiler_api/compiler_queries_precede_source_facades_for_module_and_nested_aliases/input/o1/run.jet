use compiler: core.compiler
LEXED: comptime { compiler.lex(`run: fn() {}`) ?? panic("lex") }
PARSED: comptime { compiler.parse(`run: fn() {}`) ?? panic("parse") }
CHECKED: comptime { compiler.check(PARSED) ?? panic("check") }
MAPPED: comptime { compiler.source_map(`run: fn() {}`) ?? panic("map") }
run: fn() { print("compiler queries") }
