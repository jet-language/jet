use compiler: core.compiler
LEXED: #run { compiler.lex(`run: fn() {}`) ?? panic("lex") }
PARSED: #run { compiler.parse(`run: fn() {}`) ?? panic("parse") }
CHECKED: #run { compiler.check(PARSED) ?? panic("check") }
MAPPED: #run { compiler.source_map(`run: fn() {}`) ?? panic("map") }
run: fn() { print("compiler queries") }
