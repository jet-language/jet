use core.compiler as compiler
LEXED :: comptime { compiler.lex(`fn run() {}`) ?? panic("lex") }
PARSED :: comptime { compiler.parse(`fn run() {}`) ?? panic("parse") }
CHECKED :: comptime { compiler.check(PARSED) ?? panic("check") }
MAPPED :: comptime { compiler.source_map(`fn run() {}`) ?? panic("map") }
fn run() { print("compiler queries") }
