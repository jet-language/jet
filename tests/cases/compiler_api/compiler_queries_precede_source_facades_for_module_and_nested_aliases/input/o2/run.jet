use facts: core.compiler
LEXED: comptime { facts.lex(`run: fn() {}`) ?? panic("lex") }
PARSED: comptime { facts.parse(`run: fn() {}`) ?? panic("parse") }
CHECKED: comptime { facts.check(PARSED) ?? panic("check") }
MAPPED: comptime { facts.source_map(`run: fn() {}`) ?? panic("map") }
run: fn() { print("compiler queries") }
