use core.compiler as facts
LEXED :: comptime { facts.lex(`fn run() {}`) ?? panic("lex") }
PARSED :: comptime { facts.parse(`fn run() {}`) ?? panic("parse") }
CHECKED :: comptime { facts.check(PARSED) ?? panic("check") }
MAPPED :: comptime { facts.source_map(`fn run() {}`) ?? panic("map") }
fn run() { print("compiler queries") }
