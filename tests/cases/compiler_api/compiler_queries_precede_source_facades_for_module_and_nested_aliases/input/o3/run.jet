use root: core
LEXED: #run { root.compiler.lex(`run: fn() {}`) ?? panic("lex") }
PARSED: #run { root.compiler.parse(`run: fn() {}`) ?? panic("parse") }
CHECKED: #run { root.compiler.check(PARSED) ?? panic("check") }
MAPPED: #run { root.compiler.source_map(`run: fn() {}`) ?? panic("map") }
run: fn() { print("compiler queries") }
