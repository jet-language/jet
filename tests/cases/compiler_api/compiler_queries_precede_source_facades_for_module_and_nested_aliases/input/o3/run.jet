use root: core
LEXED: comptime { root.compiler.lex(`run: fn() {}`) ?? panic("lex") }
PARSED: comptime { root.compiler.parse(`run: fn() {}`) ?? panic("parse") }
CHECKED: comptime { root.compiler.check(PARSED) ?? panic("check") }
MAPPED: comptime { root.compiler.source_map(`run: fn() {}`) ?? panic("map") }
run: fn() { print("compiler queries") }
