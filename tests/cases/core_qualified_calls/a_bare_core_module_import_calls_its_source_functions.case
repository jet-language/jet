# `use core.files` binds the Core module `files`, and qualified access through that name is the Core call form
# (Docs/spec/reference/core-library.md "Importing modules": keep qualified access through an alias). E1004 is an
# unknown item in a known Core module (registry row E1004), so a qualified call of a function the module declares,
# with or without a registered Core call row, is never E1004; an item the module lacks still is.
fixture: a_bare_core_module_import_calls_its_source_functions.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --allow=FS.Read,FS.Write calls/main.jet a b
exit: 0 # files.rename, files.exists, files.basename and process.args are source functions of their modules
stderr: !~ "E1004" # a declared Core function is not an unknown item
stdout: = "before=false after=true\nmoved\nafter.txt\nargs=2\n" # the calls run: the file moved, and the two arguments arrive
step: jet check unknown/main.jet
exit: 1 # `renamed` is not an item of core.files
stderr: ~ "Error [jet.UnknownCoreItem]: `core.files` has no item `renamed`" # registry row E1004: unknown item in a Core module
stderr: ~ "Did you mean `rename`?" # the module's own items are the suggestion menu
