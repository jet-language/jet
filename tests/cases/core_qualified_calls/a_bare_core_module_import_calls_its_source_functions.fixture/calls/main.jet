// `use core.files` binds the module `files`, exactly as `use files :: core.files`
// does, so a qualified call reaches every function the module declares, with
// or without a registered Core call row (`rename`, `exists`, `basename`, `args`).
use {
    core.files
    core.process
}

fn run() {
    files.write("before.txt", "moved") ?? panic("cannot write")
    files.rename("before.txt", "after.txt") ?? panic("cannot rename")
    print("before={files.exists("before.txt")} after={files.exists("after.txt")}")
    print(files.read("after.txt") ?? panic("cannot read"))
    print(files.basename("photos/after.txt"))
    print("args={process.args().len()}")
}
