
use api: core.testing

HistoryStep: enum {
    Step(Int)
}

reference_size: fn(commands: [HistoryStep]) -> Dyn {
    Dyn.Int(commands.len())
}

candidate_size: fn(commands: [HistoryStep]) -> Dyn {
    Dyn.Int(commands.len())
}

observe: fn(value: Dyn) -> Dyn { value.copy() }

run: fn() Err! {
    comparison: api.histories<HistoryStep>(
        seed: 1,
        cases: 1,
        strategy: None,
        model: reference_size,
        actual: candidate_size,
        observe: observe,
    )
    print(comparison.status)
}
