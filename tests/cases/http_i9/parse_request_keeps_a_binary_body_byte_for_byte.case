# #4428 C1: http.parse_request checks the body length before slicing the body,
# then keeps that one slice as Body.Bytes. It does not decode the body into a
# String. A binary upload (0x00, 0xFF, a lone 0x80, CRLF) parses and comes back
# byte for byte. Reading it as text reports UnsupportedEncoding at that read. A
# UTF-8 body reads back as its text, and an empty body stays Body.Empty.
fixture: parse_request_keeps_a_binary_body_byte_for_byte.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = parse_request_keeps_a_binary_body_byte_for_byte.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = parse_request_keeps_a_binary_body_byte_for_byte.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = parse_request_keeps_a_binary_body_byte_for_byte.out
