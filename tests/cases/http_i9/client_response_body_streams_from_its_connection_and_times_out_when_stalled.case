# A client response body streams from its connection:
# the server sends the second half of one body only after the client read
# the first half, and a body that stalls times out with HTTPError.Timeout
# at the read, on every optimization level.
fixture: client_response_body_streams_from_its_connection_and_times_out_when_stalled.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = client_response_body_streams_from_its_connection_and_times_out_when_stalled.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = client_response_body_streams_from_its_connection_and_times_out_when_stalled.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = client_response_body_streams_from_its_connection_and_times_out_when_stalled.out
