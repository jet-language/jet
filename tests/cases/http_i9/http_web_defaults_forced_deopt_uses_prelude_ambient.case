# HAND-PORT tests/http_i9.rs:967-980 http_web_defaults_forced_deopt_uses_prelude_ambient
# resp/req/body.json, server.json, static_files, cors and cors_policy lower
# with one meaning on O0, O1, O2 and the built program. A printed HTTPError
# reads as its registered message from the one runtime table
# (JetRuntime HTTPErrors.jet), as D-DISPLAYDBG1=A gives print the error's
# Display, on every tier. The web target has no server sockets, so it refuses
# the program with E3304 instead of rendering a second meaning.
fixture: http_web_defaults_forced_deopt_uses_prelude_ambient.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stderr: empty
stdout: = http_web_defaults_forced_deopt_uses_prelude_ambient.stdout.expected
step default_o1: jet run -O1 main.jet
exit: 0
stderr: empty
stdout: = http_web_defaults_forced_deopt_uses_prelude_ambient.stdout.expected
step default_o2: jet run -O2 main.jet
exit: 0
stderr: empty
stdout: = http_web_defaults_forced_deopt_uses_prelude_ambient.stdout.expected
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stderr: empty
stdout: = http_web_defaults_forced_deopt_uses_prelude_ambient.stdout.expected
step web: jet build --target web main.jet
exit: nonzero
stderr: ~ "E3304" # core.http.server needs sockets the web target does not provide
