
use {
    web: core.web
    server: core.http.server
    files: core.files
    time: core.time
}

run: fn() (HTTPError | NetError | TaskFailure)! {
    mux: web.app()
    mux.post("/", fn(req: HTTPRequest) {
        body: req.body().text(1024) ?? "rejected"
        return Ok(server.response(200, body))
    })
    // A short connection deadline, set as a user sets it: the subject is that a
    // trickled chunked trailer can't hold the request past it, not its length.
    bound: mux.bind("127.0.0.1:__PORT__", deadline: 500ms) ?? panic("bind")
    server_task: task {
        bound.serve() ?? panic("serve")
    }
    // The controller marks the stop once it has read the response.
    loop !files.exists("__STOP__") {
        time.sleep(10ms)
    }
    bound.shutdown() ?? panic("shutdown")
    server_task.join() ?? panic("serve")
}
