
use http: core.http.client

response_text_default: fn(response: HTTPResponse) -> String Never! {
    if response.text() == {
        .Ok(text) -> return "ok:{text.len()}"
        .Err(error) -> {
            if error == {
                .BodyTooLarge(limit) -> return "err:BodyTooLarge:{limit}"
                .UnsupportedEncoding -> return "err:UnsupportedEncoding"
                .IO(operation) -> return "err:IO:{operation}"
                .BodyConsumed -> return "err:BodyConsumed"
                .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .InvalidFraming | .Cancelled | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> return "err:other"
            }
        }
    }
}

response_text_explicit: fn(response: HTTPResponse) -> String Never! {
    if response.text(5) == {
        .Ok(text) -> return "ok:{text}"
        .Err(error) -> {
            if error == {
                .BodyTooLarge(limit) -> return "err:BodyTooLarge:{limit}"
                .BodyConsumed -> return "err:BodyConsumed"
                .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .InvalidFraming | .UnsupportedEncoding | .Cancelled | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> return "err:other"
            }
        }
    }
}

response_text_consumed: fn(response: HTTPResponse) -> String Never! {
    if response.text() == {
        .Ok(_) -> {
            if response.text() == {
                .Ok(_) -> return "ok:reused"
                .Err(error) -> {
                    if error == {
                        .BodyConsumed -> return "err:BodyConsumed"
                        .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .InvalidFraming | .UnsupportedEncoding | .Cancelled | .BodyTooLarge(_) | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> return "err:other"
                    }
                }
            }
        }
        .Err(_) -> return "err:first-read"
    }
}

response_text_stream: fn(response: HTTPResponse) -> String Never! {
    if response.text() == {
        .Ok(text) -> return "ok:{text}"
        .Err(error) -> {
            if error == {
                .BodyConsumed -> return "err:BodyConsumed"
                .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .InvalidFraming | .UnsupportedEncoding | .Cancelled | .BodyTooLarge(_) | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> return "err:other"
            }
        }
    }
}

run: fn() {
    if http.get("http://{cap:addr}/default") == {
        .Ok(response) -> print("default={response_text_default(response)}")
        .Err(_) -> print("default=request-error")
    }
    if http.get("http://{cap:addr}/explicit") == {
        .Ok(response) -> print("explicit={response_text_explicit(response)}")
        .Err(_) -> print("explicit=request-error")
    }
    if http.get("http://{cap:addr}/consumed") == {
        .Ok(response) -> print("consumed={response_text_consumed(response)}")
        .Err(_) -> print("consumed=request-error")
    }
    if http.get("http://{cap:addr}/stream") == {
        .Ok(response) -> print("stream={response_text_stream(response)}")
        .Err(_) -> print("stream=request-error")
    }
    if http.get("http://{cap:addr}/over") == {
        .Ok(over) -> print("over={response_text_default(over)}")
        .Err(_) -> print("over=request-error")
    }
    if http.get("http://{cap:addr}/binary") == {
        .Ok(binary) -> print("binary={response_text_default(binary)}")
        .Err(_) -> print("binary=request-error")
    }
    if http.get("http://{cap:addr}/truncated") == {
        .Ok(truncated) -> print("truncated={response_text_default(truncated)}")
        .Err(_) -> print("truncated=request-error")
    }
}
