// Span holds only Ints, so it copies: `width` reads `span` after binding it,
// which is clean only while Span's copy fact is known.
Span: struct {
    start: Int
    end: Int
}

width: fn(start: Int, end: Int) -> Int Never! {
    span: Span{start: start, end: end}
    first: span
    span.end - first.start
}
