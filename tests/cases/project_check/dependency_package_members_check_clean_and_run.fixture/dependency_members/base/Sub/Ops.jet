widen: fn(end: Int) -> Int Never! {
    hidden: Hidden{value: end}
    if hidden.value > LIMIT -> return hidden.value
    hidden.value + 1
}

impl Span {
    width: fn(self) -> Int Never! { self.end - self.start }
}

kind_value: fn(kind: Kind) -> Int Never! {
    if kind == {
        .Alpha -> 0
        .Beta(v) -> v + make_span(0, 1).width()
    }
}

Label: struct {
    text: String
    inner: [Shape]
}

same_shape: fn(a: Shape, b: Shape) -> Bool Never! {
    a == b
}

// A compile-time table of a sibling file's enum with a named payload.
MARKS: comptime { [Mark]{ Mark.Point{at: Span{start: 0, end: 2}}, Mark.Blank } }
