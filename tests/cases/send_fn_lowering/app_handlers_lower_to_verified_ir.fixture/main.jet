
use core.web as web
#Target(Web)

fn home() -> WebPage { web.page("Home", "hello") }

fn detail(id: Int) -> WebPage { web.page("Detail", "item {id}") }

fn save() -> String { "saved" }

fn app_graph() -> App {
    return web.app()
        .route("/", home)
        .page("/about", home)
        .route("/items/:id", detail)
        .action("save", save)
        .form("order", save)
        .pending(home)
        .csr()
}

fn run() {
    _app :: app_graph()
}
