
use web: core.web
#Target(Web)

home: fn() -> WebPage { web.page("Home", "hello") }

detail: fn(id: Int) -> WebPage { web.page("Detail", "item {id}") }

save: fn() -> String { "saved" }

app_graph: fn() -> App {
    return web.app()
        .route("/", home)
        .page("/about", home)
        .route("/items/:id", detail)
        .action("save", save)
        .form("order", save)
        .pending(home)
        .csr()
}

run: fn() {
    _app: app_graph()
}
