# Port of tests/jetpack_platform.rs:327-449; public assertions exact, runtime PENDING-SAME-HEAD.
# Setup requires the named authentic fixture seam; no forged Store receipts/output identities.
# Direct library claims LEDGER-ONLY in SEAMS.tsv; full original setup and predicates below.
refused: hangar-verified-realization
requires: os-name:linux
mkdir: package-root
mkdir: fixtures
mkdir: staging
mkdir: missing-tools
env: JETPACK_ROOT={work}/package-root
step: jetpack use omp@releases#1.0.0 --no-color --offline -- omp{sys:exe-suffix} --help
env: JETPACK_FIXTURES={work}/fixtures
env: PATH={work}/missing-tools
exit: 0
stdout: ~ "jetpack" # original native child stdout
entries: package-root/leases = 0
# write_hangar_meta authenticated fixture supplies exactly original good_object (store-ingest seam).
mkdir: package-root/leases/4294967294-1-platform-diagnostics-good/snapshot
write: package-root/leases/4294967294-1-platform-diagnostics-good/snapshot/partial platform_tier_gate_exercises_native_lease_diagnostics_and_audit.interrupted.template
step: jetpack doctor --json --offline
exit: any # original doctor status unasserted
stdout: ~ "stale executable lease(s) found" # original doctor predicate
file: package-root/leases/4294967294-1-platform-diagnostics-good is-dir
step: jetpack audit --no-color
exit: 0
stderr: ~ "Leases:" # original audit label
stderr: ~ "0 active, 1 stale" # original lease count
mkdir: package-root/hangar/closure-db/journal
write: package-root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial platform_tier_gate_exercises_native_lease_diagnostics_and_audit.interrupted.template
step: jetpack audit --no-color
exit: 2
stderr: ~ "Error [E1340]:" # original registered diagnostic
stderr: ~ "Why:" # original diagnostic reason
stderr: ~ "Fix:" # original diagnostic fix
stderr: ~ "More: jet-lang.dev/e/E1340" # original diagnostic link
file: package-root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial is-file
file: {cap:good_object}/meta.json is-file
remove: package-root/hangar/closure-db/journal/00000000000000000099-corrupt.txn.partial
step: jetpack hangar recover --no-color
env: PATH={work}/missing-tools
exit: 0
file: package-root/leases/4294967294-1-platform-diagnostics-good absent
file: {cap:good_object}/meta.json is-file

