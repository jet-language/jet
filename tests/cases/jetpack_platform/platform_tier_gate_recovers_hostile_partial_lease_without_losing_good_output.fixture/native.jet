// Behavioural port of tests/support/jetpack_fixtures.rs:400-408. Real compiled executable, not a shell surrogate.
use core.process as process
use core.time as time
fn run() {
    args :: process.args()
    if args.len() > 0 && args[0] == "--hold" -> time.sleep(5s)
    if args.len() > 0 && args[0] == "--help" -> print("jetpack platform fixture")
}
