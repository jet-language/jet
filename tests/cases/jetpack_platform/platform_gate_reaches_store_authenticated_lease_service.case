# Port of tests/jetpack_platform.rs:175-283; public assertions exact, runtime PENDING-SAME-HEAD.
# Setup requires the named authentic fixture seam; no forged Store receipts/output identities.
# Direct library claims LEDGER-ONLY in SEAMS.tsv; full original setup and predicates below.
refused: hangar-verified-realization
requires: os-name:linux
mkdir: package-root
mkdir: fixtures
mkdir: staging
mkdir: missing-tools
env: JETPACK_ROOT={work}/package-root
env: JETPACK_FIXTURES={work}/fixtures
env: PATH={work}/missing-tools
spawn run: jetpack use omp@releases#1.0.0 -y --no-color --offline --fixtures {work}/fixtures -- omp{sys:exe-suffix} --hold
await: entry package-root/lease-service/leases with-file "generations/1/receipt" with-file "generations/1/complete" readable "generations/1/receipt" timeout 5s every 10ms capture record
file: {cap:record}/generations/1/receipt ^= "JET-EXECUTABLE-LEASE/1 receipt\n" # original receipt header
file: {cap:record}/generations/1/receipt ~ "\ngeneration=1\n" # original generation receipt
file.strip_prefix_lines("mac=").line(0): {cap:record}/generations/1/receipt len = 64 # original receipt mac length
file.strip_prefix_lines("mac=").line(0): {cap:record}/generations/1/receipt each-line hex # original ascii hex mac bytes
file.trim: {cap:record}/generations/1/complete len = 71 # original witness length
file.trim: {cap:record}/generations/1/complete ^= "sha256-" # original witness prefix
step: jetpack hangar recover --no-color
exit: 0
file: {cap:record}/generations/1/receipt is-file
wait: run
exit: 0
step: jetpack hangar recover --no-color
exit: 0
when dir-readable package-root/lease-service/leases: entries: package-root/lease-service/leases = 0

