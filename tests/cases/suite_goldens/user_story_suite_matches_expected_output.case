# Each Examples/Apps/Programs/*.jet (package.jet excluded, 8 stories) must run with success and match Examples/Apps/Programs/<stem>.out byte-for-byte.
step: bash -c 'test "$(ls {root}/Examples/Apps/Programs/*.jet | grep -vc /package.jet$)" = 8'
exit: 0
step: jet run {root}/Examples/Apps/Programs/Dispatch.jet
env: JETPACK_ENV=1
unset: JETPACK_ENV_DIR
env: NO_COLOR=1
env: JET_STORE_DIR={work}
exit: 0
stdout: = {root}/Examples/Apps/Programs/Dispatch.out
step: jet run {root}/Examples/Apps/Programs/ExpenseReport.jet
env: JETPACK_ENV=1
unset: JETPACK_ENV_DIR
env: NO_COLOR=1
env: JET_STORE_DIR={work}
exit: 0
stdout: = {root}/Examples/Apps/Programs/ExpenseReport.out
