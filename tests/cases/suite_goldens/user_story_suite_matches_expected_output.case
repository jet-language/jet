# PORT tests/suite_goldens.rs20-73; current live corpus, exact literal expected bytes.
# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four). No snapshot blessing.
copy: {root}/Examples/suites suite
mkdir: cache
capture: n = entries suite ext = "jet" name != "package.jet"
cap:n: = 8
for file suite ext = "jet" name != "package.jet" sorted as story
step: jet run {story.path}
env: JETPACK_ENV=1
env: JET_STORE_DIR={work}/cache
env: NO_COLOR=1
unset: JETPACK_ENV_DIR
exit: 0
stdout: = {work}/suite/expected/{story.stem}.out
end for
