# Port of tests/suite_goldens.rs::user_story_suite_matches_expected_output.
# Each Examples/suites/*.jet (package.jet excluded, 8 stories) must run with success and match Examples/suites/expected/<stem>.out byte-for-byte.
step: bash -c 'test "$(ls {repo}/Examples/suites/*.jet | grep -vc /package.jet$)" = 8'
cwd: {repo}
exit: 0
step: jet run {repo}/Examples/suites/dispatch.jet
cwd: {repo}
env: JETPACK_ENV=1
unset: JETPACK_ENV_DIR
env: NO_COLOR=1
env: JET_STORE_DIR={work}
exit: 0
stdout: = {repo}/Examples/suites/expected/dispatch.out
step: jet run {repo}/Examples/suites/expense_report.jet
cwd: {repo}
env: JETPACK_ENV=1
unset: JETPACK_ENV_DIR
env: NO_COLOR=1
env: JET_STORE_DIR={work}
exit: 0
stdout: = {repo}/Examples/suites/expected/expense_report.out
step: jet run {repo}/Examples/suites/failure.jet
cwd: {repo}
env: JETPACK_ENV=1
unset: JETPACK_ENV_DIR
env: NO_COLOR=1
env: JET_STORE_DIR={work}
exit: 0
stdout: = {repo}/Examples/suites/expected/failure.out
