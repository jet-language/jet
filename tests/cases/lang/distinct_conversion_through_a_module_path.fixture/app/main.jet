use logic
use model

show_project: fn(id: model.ProjectID) { print("project {id}") }
show_task: fn(id: logic.TaskID) { print("task {id}") }

run: fn() {
    project: model.ProjectID.from_int(2)
    show_project(project)
    show_task(logic.TaskID.from_int(7))
    print(logic.Label.from_string("ops"))
    print(project == model.ProjectID{2})
    level: logic.Level.from_int(3)
    print(level)
}
