// A method read without parentheses where a function type is expected is
// the method with its receiver bound.
Crew: struct {
    name: String

    tell: fn(self, id: Int) -> String { "{self.name} hears about task {id}" }

    projects: fn(self, owner: String) -> [String] {
        ["{owner}/{self.name}-site", "{owner}/{self.name}-api"]
    }

    notify_all: fn(self, ids: [Int]) { each(ids, self.tell) }
}

Alert: struct {
    title: String
    send: fn(Int) -> String
}

Team: struct {
    lead: Crew
}

hired: fn(name: String) -> Crew {
    print("hired {name}")
    Crew{name: name}
}

each: fn(ids: [Int], notify: fn(Int) -> String) {
    loop id in ids -> print(notify(id))
}

owned_by: fn(owner: String, find: fn(String) -> [String]) -> Int {
    found: find(owner)
    loop name in found -> print(name)
    found.len()
}

teller: fn(name: String) -> fn(Int) -> String {
    crew: Crew{name: name}
    crew.tell
}

run: fn() {
    ada: Crew{name: "Ada"}
    each([1, 2], ada.tell)
    bo: Crew{name: "Bo"}
    print(owned_by("user", bo.projects))
    Crew{name: "Cy"}.notify_all([7])
    dee: Crew{name: "Dee"}
    alert: Alert{title: "deploy", send: dee.tell}
    print("{alert.title}: {alert.send(9)}")
    eve: Crew{name: "Eve"}
    fay: Crew{name: "Fay"}
    senders: [fn(Int) -> String]{eve.tell, fay.tell}
    loop send in senders -> print(send(5))
    print(teller("Kai")(4))
    team: Team{lead: Crew{name: "Lu"}}
    each([6], team.lead.tell)
    // The receiver is evaluated once, at the read.
    each([3, 4], hired("Lin").tell)
}
