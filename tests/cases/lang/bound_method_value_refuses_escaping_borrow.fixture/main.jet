// `counter.bump` returned from `bumper` would write the lent `counter`
// after the call that lent it ends: the bound method value keeps its
// receiver as a closure keeps a capture, so it is refused naming `counter`.
Counter: struct {
    n: Int

    bump: fn(&self, by: Int) { self.n += by }
}

bumper: fn(counter: &Counter) -> fn(Int) {
    counter.bump
}

run: fn() {
    counter := Counter{n: 1}
    bump: bumper(counter)
    bump(2)
    print(counter.n)
}
