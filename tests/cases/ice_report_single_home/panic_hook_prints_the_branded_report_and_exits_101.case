# Port of tests/ice_report_single_home.rs:74-105; fixture source bytes unchanged.
# Partial forms reproduce original predicates; literal expected bytes need no blessing.
# JET_ICE_SELF_TEST=1 makes `jet` report an internal compiler error before it
# reads its command line, so every verb's ICE report and its exit 101 are
# proved without depending on a defect in the compiler.
env: JET_ICE_SELF_TEST=1
step: jet
exit: 101
stderr: ~ "internal compiler error: ICE self-test triggered by JET_ICE_SELF_TEST" # original predicate
stderr: ~ "This is a bug in jet, NOT in your program. Please report it," # original predicate
stderr: !~ "RUST_BACKTRACE" # original predicate
stderr: !~ "thread 'main' panicked at" # original predicate
step build: jet build gap.jet
exit: 101
stderr: ~ "internal compiler error: ICE self-test triggered by JET_ICE_SELF_TEST" # `jet build` reports the same report
stderr: !~ "E2104" # an internal fault is never a user diagnostic
step run: jet run gap.jet
exit: 101
stderr: ~ "internal compiler error: ICE self-test triggered by JET_ICE_SELF_TEST" # `jet run` reports the same report
stderr: !~ "E2104" # an internal fault is never a user diagnostic
step test: jet test gap.jet
exit: 101
stderr: ~ "internal compiler error: ICE self-test triggered by JET_ICE_SELF_TEST" # the test harness reports the same report
stderr: !~ "E2105" # an internal fault is never an operating-system failure
