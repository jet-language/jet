
use core.encoding.json as json
fn run() {
    data :: json.decode("{{\"port\":\"8080\",\"enabled\":\"true\"}}") ?? panic("bad json")
    if data == .Object(m) {
        if m["port"] == .Int(n) {
            print(n)
        }
        if m["enabled"] == .Bool(b) {
            print(b)
        }
    }
}
