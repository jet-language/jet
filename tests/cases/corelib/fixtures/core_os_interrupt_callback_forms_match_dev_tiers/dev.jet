
// `jet dev` takes no --allow flag; the package block grants on_interrupt its Env.
package: {
    name: "interrupt_callback_forms"
    authority: { allow: [Env] }
}

use {
    os: core.sys
    term: core.term
}

named_callback: fn() {
    print("named")
}

stop_callback: fn() {
    print("stop")
    panic("stop")
}

run: fn() {
    loop indirect := stop_callback, true {
        named_alias: named_callback
        local_lambda: fn() {
            print("lambda")
        }
        os.on_interrupt(fn() {
            named_alias()
        })
        os.on_interrupt(local_lambda)
        os.on_interrupt(named_callback)
        os.on_interrupt(indirect)
        print("ready")
        // A pipe stdout is written when its buffer fills (spec.md print); flush so
        // the parent sees ready before it signals.
        ready_out := term.stdout()
        ready_out.flush() ?? panic("flush")
        loop {
            tick: 0
        }
    }
}
