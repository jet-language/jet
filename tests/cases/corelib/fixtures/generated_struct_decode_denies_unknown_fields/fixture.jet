
use json: core.encoding.json

#[Codable, DenyUnknownFields]
Strict: struct { name: String }

run: fn() {
    if json.decode<Strict>("{{\"name\":\"x\",\"extra\":1}}") == {
        .Ok(_) -> {}
        .Err(errors) -> {
            loop error in errors {
                print(error.path)
                print(error.reason)
            }
        }
    }
}
