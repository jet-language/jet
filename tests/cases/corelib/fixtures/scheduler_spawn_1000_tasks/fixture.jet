
use core.tasks as tasks

fn run() {
{ sender, receiver: ch } :: channel<Int>()
    loop i in 1..1000 {
        dup :: sender.copy()
        task {
            dup.send(1)
        }
    }
    total := 0
    loop i in 1..1000 {
        total = (total + (ch.receive() ?? panic("channel closed")))
    }
    print(total)
}
