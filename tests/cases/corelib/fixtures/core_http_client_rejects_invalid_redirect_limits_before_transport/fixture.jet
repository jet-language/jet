use core.net as net
use core.http as http
use core.http.client as client
use core.files as files
use core.text.parse as txt

fn http_crlf() -> String { String.from_bytes([U8]{13, 10}) ?? panic("CRLF") }
fn http_read(stream: net.TCPStream) -> String {
    net.set_read_timeout(stream, 5000) ?? panic("read timeout")
    String.from_bytes(net.tcp_read_bytes(stream, 4096) ?? panic("read request")) ?? panic("request UTF-8")
}
fn http_reply(stream: net.TCPStream, file: String) {
    bytes :: files.read_bytes(file) ?? panic("response bytes")
    net.tcp_write_all_bytes(stream, bytes) ?? panic("write response")
    net.tcp_close(stream) ?? panic("drop peer stream")
}
fn require_redirect(request: HTTPRequest) {
    if request.send() == {
        .Ok(_) -> panic("redirect unexpectedly accepted")
        .Err(error) -> if error == {
            .Redirect(_) -> { _ :: 0 }
            else -> panic("original Redirect variant lost")
        }
    }
}
fn check_redirect_limits() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    base :: "http://{address}"
    peer :: task {
        loop _i in 0..<26 {
            stream :: net.tcp_accept(listener) ?? panic("accept")
            request :: http_read(stream)
            first :: request.lines().to_list()[0]
            target :: txt.split_ws(first)[1]
            if target == "/redirect" {
                http_reply(stream, "redirect.response")
            } else if target == "/target" {
                http_reply(stream, "ok.response")
            } else {
                parts :: txt.split(target, "/")
                step :: Int.parse(parts[parts.len() - 1]) ?? panic("chain step")
                chain :: parts[parts.len() - 2]
                final_step :: if chain == "within" -> 10 else if chain == "over" -> 11 else -> panic("unexpected target")
                if step == final_step {
                    http_reply(stream, "ok.response")
                } else {
                    crlf :: http_crlf()
                    next :: step + 1
                    response :: "HTTP/1.1 302 Found{crlf}Location: /{chain}/{next}{crlf}Content-Length: 0{crlf}Connection: close{crlf}{crlf}"
                    net.tcp_write_all_bytes(stream, response.bytes()) ?? panic("redirect response")
                    net.tcp_close(stream) ?? panic("drop")
                }
            }
        }
    }
    url :: "{base}/redirect"
    require_redirect(client.request("GET", url).redirects(-1))
    require_redirect(client.request("GET", url).redirects(4294967296))
    stopped :: client.request("GET", url).redirects(0).send() ?? panic("disabled redirect")
    assert(stopped.status() == 302 && (stopped.body().bytes(16) ?? panic("stopped body")) == "redirect".bytes(), "original disabled redirect status/body")
    followed :: client.request("GET", url).redirects(4294967295).send() ?? panic("maximum redirects")
    assert(followed.status() == 200 && (followed.body().bytes(8) ?? panic("followed body")) == "ok".bytes(), "original maximum redirect status/body")
    require_redirect(client.request("GET", url).redirects(1))
    within :: client.request("GET", "{base}/within/0").send() ?? panic("within")
    assert(within.status() == 200 && (within.body().bytes(8) ?? panic("within body")) == "ok".bytes(), "original default within boundary")
    require_redirect(client.request("GET", "{base}/over/0"))
    peer.join() ?? panic("peer")
}
#Test("core_http_client_rejects_invalid_redirect_limits_before_transport") { check_redirect_limits() }
