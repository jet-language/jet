
use json: core.encoding.json

ConfigSchema: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            #Codable
            GeneratedConfig: struct {
                ports: [Int]{[80, 443]}
            }
        }
    }
}

#ConfigSchema
Schema: struct<T> { witness: T }

run: fn() {
    config := json.decode<GeneratedConfig>("{{}}") ?? panic("decode")
    print(config.ports)
}
