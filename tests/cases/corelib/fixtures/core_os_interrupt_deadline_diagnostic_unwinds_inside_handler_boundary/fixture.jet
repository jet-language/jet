
use {
    term: core.term
    os: core.sys
    process: core.process
    time: core.time
}

run: fn() {
    os.on_interrupt(fn() {
        #Deadline(0ms) {
            time.sleep(5ms)
        }
    })
    os.on_interrupt(fn() {
        print("second")
        process.exit(0)
    })
    print("ready")
    // A pipe stdout is written when its buffer fills (spec.md print); flush so
    // the parent sees ready before it signals.
    ready_out := term.stdout()
    ready_out.flush() ?? panic("flush")
    loop { }
}
