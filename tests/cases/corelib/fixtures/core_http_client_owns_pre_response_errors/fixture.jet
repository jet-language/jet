use core.net as net
use core.http as http
use core.http.client as client
use core.files as files
use core.text.parse as txt
use core.time as time

fn http_crlf() -> String { String.from_bytes([U8]{13, 10}) ?? panic("CRLF") }
fn http_read(stream: net.TCPStream) -> String {
    net.set_read_timeout(stream, 1000) ?? panic("read timeout")
    String.from_bytes(net.tcp_read_bytes(stream, 4096) ?? panic("read request")) ?? panic("request UTF-8")
}
fn http_reply(stream: net.TCPStream, file: String) {
    bytes :: files.read_bytes(file) ?? panic("response bytes")
    net.tcp_write_all_bytes(stream, bytes) ?? panic("write response")
    net.tcp_close(stream) ?? panic("drop peer stream")
}
fn require_timeout(request: HTTPRequest) {
    if request.send() == {
        .Ok(_) -> panic("negative timeout accepted")
        .Err(error) -> if error == {
            .Timeout(_) -> { _ :: 0 }
            else -> panic("negative timeout wrong error")
        }
    }
}
fn require_invalid_url(url: String) {
    if client.request("GET", url).send() == {
        .Ok(_) -> panic("invalid URL accepted")
        .Err(error) -> assert(error == .InvalidURL, "original InvalidURL variant")
    }
}
fn require_proxy(request: HTTPRequest) {
    if request.send() == {
        .Ok(_) -> panic("bad proxy accepted")
        .Err(error) -> if error == {
            .Proxy(_) -> { _ :: 0 }
            else -> panic("original Proxy variant lost")
        }
    }
}
fn check_pre_response_errors() {
    listener := net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    url :: "http://{address}/"
    { sender: stop_tx, receiver: stop_rx } :: channel<Int>()
    peer :: task {
        requests := [String]{}
        // Original nonblocking accept + stop atomic: zero-deadline accepts queued
        // sockets; Timeout alone = WouldBlock, any other failure panics.
        loop stop_rx.try_receive() == None {
            if &listener.accept(deadline: 0s) == {
                .Ok(stream) -> {
                    index :: requests.len()
                    &requests.push(http_read(stream))
                    if index < 2 {
                        http_reply(stream, "proxy-{index}.response")
                    } else {
                        net.tcp_close(stream) ?? panic("drop")
                    }
                }
                .Err(error) -> if error == {
                    .Timeout(_) -> time.sleep(1ms)
                    else -> panic("accept failed")
                }
            }
        }
        return requests
    }
    require_timeout(client.request("GET", url).timeout(-1))
    require_timeout(client.request("GET", url).connect_timeout(-1))
    require_timeout(client.request("GET", url).read_timeout(-1))
    require_timeout(client.request("GET", url).total_timeout(-1))
    require_invalid_url("http://[")
    require_invalid_url(url.replace("http://", "ftp://"))
    if client.request("GET", "http://127.0.0.1:0/").send() == {
        .Ok(_) -> panic("connection unexpectedly succeeded")
        .Err(error) -> if error == {
            .Connect(_) -> { _ :: 0 }
            else -> panic("original Connect variant lost")
        }
    }
    require_proxy(client.request("GET", url).proxy("ftp://proxy.invalid"))
    require_proxy(client.request("GET", "https://example.invalid/").proxy(url))
    require_proxy(client.request("GET", "https://auth.invalid/").proxy(url))
    if client.request("GET", "{url}io").send() == {
        .Ok(_) -> panic("closed response unexpectedly succeeded")
        .Err(error) -> if error == {
            .IO(_) -> { _ :: 0 }
            else -> panic("original IO variant lost")
        }
    }
    stop_tx.send(1)
    requests :: peer.join() ?? panic("peer")
    assert_eq(requests.len(), 3, "pre-response transport count changed")
    crlf :: http_crlf()
    assert(requests[0].starts_with("CONNECT example.invalid:443 HTTP/1.1{crlf}") && requests[1].starts_with("CONNECT auth.invalid:443 HTTP/1.1{crlf}") && requests[2].starts_with("GET /io HTTP/1.1{crlf}"), "unexpected requests")
}
#Test("core_http_client_owns_pre_response_errors") { check_pre_response_errors() }
