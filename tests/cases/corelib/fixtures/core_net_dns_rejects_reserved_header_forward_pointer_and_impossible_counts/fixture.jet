use core.net as net
use core.files as files
use core.process as process
use core.sys as sys

fn fixture_build(address: String) {
    original :: files.read("guest.template") ?? panic("read original guest")
    source :: original.replace("@ADDR@", address)
    files.write("guest.jet", source) ?? panic("write guest")
    jet :: sys.get("JET_BIN") ?? panic("JET_BIN missing")
    build :: process.cmd([jet, "build", "guest.jet"]).stdout(.Capture).stderr(.Capture).run() ?? panic("build guest")
    assert(build.code == 0, "original guest compilation must succeed")
}
fn fixture_run() -> ProcessReceipt {
    process.cmd([".jet/build/guest"]).stdout(.Capture).stderr(.Capture).run() ?? panic("run original guest")
}
fn fixture_copy(out: &[U8], bytes: [U8], start: Int, end: Int) {
    loop i in start..<end -> &out.push(bytes[i])
}
fn fixture_u16(out: &[U8], n: Int) {
    &out.push(U8{(n /% 256) %% 256})
    &out.push(U8{n %% 256})
}
fn fixture_question_end(query: [U8]) -> Int {
    pos := 12
    loop pos < query.len() && query[pos] != (U8{0}) {
        pos += Int.from_u8(query[pos]) + 1
    }
    pos + 5
}
fn fixture_name(name: String) -> [U8] {
    out := [U8]{}
    loop label in name.split(".") {
        &out.push(U8{label.bytes().len()})
        fixture_copy(&out, label.bytes(), 0, label.bytes().len())
    }
    &out.push(U8{0})
    out
}
fn fixture_header(query: [U8], flags: Int, answers: Int, authorities: Int, additional: Int) -> [U8] {
    out := [U8]{}
    fixture_copy(&out, query, 0, 2)
    fixture_u16(&out, flags)
    fixture_u16(&out, 1)
    fixture_u16(&out, answers)
    fixture_u16(&out, authorities)
    fixture_u16(&out, additional)
    fixture_copy(&out, query, 12, fixture_question_end(query))
    out
}
fn fixture_cname(query: [U8]) -> [U8] {
    alias :: fixture_name("alias.example.test")
    out := fixture_header(query, 0x8180, 1, 0, 1)
    &out.push(U8{0xc0})
    &out.push(U8{0x0c})
    fixture_u16(&out, 5)
    fixture_u16(&out, 1)
    fixture_copy(&out, [U8]{0, 0, 0, 0}, 0, 4)
    fixture_u16(&out, alias.len())
    fixture_copy(&out, alias, 0, alias.len())
    fixture_copy(&out, alias, 0, alias.len())
    fixture_u16(&out, 1)
    fixture_u16(&out, 1)
    fixture_copy(&out, [U8]{0, 0, 0, 0}, 0, 4)
    fixture_u16(&out, 4)
    fixture_copy(&out, [U8]{192, 0, 2, 42}, 0, 4)
    out
}
fn fixture_pointer(query: [U8], delta: Int) -> [U8] {
    pointer :: fixture_question_end(query) + delta
    out := fixture_header(query, 0x8180, 1, 0, 0)
    &out.push(U8{0xc0 | ((pointer /% 256) & 0x3f)})
    &out.push(U8{pointer %% 256})
    fixture_u16(&out, 1)
    fixture_u16(&out, 1)
    fixture_copy(&out, [U8]{0, 0, 0, 0}, 0, 4)
    fixture_u16(&out, 4)
    fixture_copy(&out, [U8]{192, 0, 2, 1}, 0, 4)
    out
}
fn fixture_send(socket: net.UDPSocket, packet: net.UDPPacket, bytes: [U8]) {
    peer :: net.socket_addr(packet.host, packet.port) ?? panic("peer")
    net.udp_send_bytes_to(socket, bytes, peer) ?? panic("send fixture response")
}

#Test("core_net_dns_rejects_reserved_header_forward_pointer_and_impossible_counts") {
    socket :: net.udp_bind("127.0.0.1:0") ?? panic("bind UDP")
    address :: net.socket_to_string(net.udp_local_addr(socket) ?? panic("UDP address"))
    server :: task {
        loop i in 0..<3 {
            packet :: net.udp_recv_from(socket, 512) ?? panic("receive query")
            response := [U8]{}
            if i == 0 {
                response = fixture_cname(packet.data)
                response[3] = U8{Int.from_u8(response[3]) | 0x40}
            } else if i == 1 {
                response = fixture_pointer(packet.data, 6)
            } else {
                response = fixture_header(packet.data, 0x8180, 65535, 65535, 65535)
            }
            fixture_send(socket, packet, response)
        }
    }
    fixture_build(address)
    observed :: fixture_run()
    server.join() ?? panic("peer failed")
    assert(observed.code == 0, "guest exit")
    assert(observed.output == "rejected\nrejected\nrejected\n", "all original hostile header/pointer/count outputs")
}
