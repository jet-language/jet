
use {
    encoding: core.encoding
    jsonl: core.encoding.jsonl
    files: core.files
}

run: fn() {
    output: files.create("{work}/out.jsonl") ?? panic("create")
    writer := jsonl.writer(^output) ?? panic("writer")
    &writer.write(Dyn.Text("alpha")) ?? panic("write")
    &writer.write(Dyn.Array([Dyn.Int(1), Dyn.Text("beta")])) ?? panic("write")
    &writer.flush() ?? panic("flush")
    &writer.finish() ?? panic("finish")
    &writer.finish() ?? panic("finish twice")
    if &writer.write(Dyn.Null) == {
        .Ok(_) -> { print("write-after-finish-missed") }
        .Err(first) -> {
            if &writer.flush() == {
                .Ok(_) -> { print("terminal-not-latched") }
                .Err(second) -> { print(first.byte_offset == second.byte_offset && first.reason == second.reason) }
            }
        }
    }

    input: files.open("{work}/input.jsonl") ?? panic("open")
    reader := jsonl.reader(^input) ?? panic("reader")
    if &reader.next() == {
        .Val(value) -> { print(value.text() ?? "bad") }
        .None -> { print("missing-first") }
        .Err(_) -> panic("first")
    }
    if &reader.next() == {
        .Val(value) -> {
            first: value.at(0) ?? Dyn.Int(-1)
            second: value.at(1) ?? Dyn.Text("bad")
            print(first.int() ?? -1)
            print(second.text() ?? "bad")
        }
        .None -> { print("missing-second") }
        .Err(_) -> panic("second")
    }
    if &reader.next() == {
        .None -> { print("eof") }
        .Val(_) -> { print("bad-eof") }
        .Err(_) -> panic("eof")
    }
    if &reader.next() == {
        .None -> { print("eof-again") }
        .Val(_) -> { print("bad-eof-again") }
        .Err(_) -> panic("eof again")
    }

    malformed_input: files.open("{work}/malformed.jsonl") ?? panic("open malformed")
    malformed_reader := jsonl.reader(^malformed_input) ?? panic("reader malformed")
    first_malformed: &malformed_reader.next() ?? panic("first malformed record")
    if &malformed_reader.next() == {
        .Val(_) | .None -> { print("malformed-missed") }
        .Err(first) -> {
            if &malformed_reader.next() == {
                .Val(_) | .None -> { print("malformed-not-latched") }
                .Err(second) -> {
                    print(first.line ?? -1)
                    print(first.path)
                    print(first.byte_offset == second.byte_offset && first.path == second.path && first.reason == second.reason)
                }
            }
        }
    }

    limits := encoding.EncodingLimits.safe()
    limits.max_item_bytes = 2
    limited_output: files.create("{work}/limited.jsonl") ?? panic("limited create")
    limited_writer := jsonl.writer(^limited_output, limits) ?? panic("limited writer")
    if &limited_writer.write(Dyn.Text("three")) == {
        .Ok(_) -> { print("limit-missed") }
        .Err(first) -> {
            if &limited_writer.finish() == {
                .Ok(_) -> { print("limit-not-latched") }
                .Err(second) -> {
                    print(first.byte_offset == second.byte_offset && first.reason == second.reason)
                }
            }
        }
    }
}
