
derive T.TypeName {
    info: T.reflect()
    param: info.type_params[0].name
    get_value: fn(self) -> $param { self.value.copy() }
    type_name: fn(self) -> String { T.$name }
}

#TypeName
Box: struct<T> { value: T }

run: fn() {
    boxed := Box<Int>{ value: 7 }
    n := boxed.get_value()
    print(n)
    print(boxed.type_name())
}
