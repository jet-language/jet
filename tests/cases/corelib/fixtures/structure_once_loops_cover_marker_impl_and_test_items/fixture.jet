
AddFields: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            type_name: target.$name
            comptime loop field in target.$fields {
                method: "field_{field.$name}"
                impl $type_name {
                    $method: fn(self) -> String { field.$name }
                }
            }
        }
    }
}

Case: struct { n: Int }

#AddFields
Person: struct { first: String  last: String }

CASES: comptime { [Case]{ Case{ n: 1 }, Case{ n: 2 } } }

comptime loop T in [Person] {
    impl T {
        generated: fn(self) -> String { "generated" }
    }
}

comptime loop case in CASES {
    #Test("case {case.n}") {
        assert(case.n > 0)
    }
}

run: fn() {
    person: Person{ first: "a", last: "b" }
    print(person.field_first())
    print(person.field_last())
    print(person.generated())
}
