run: fn() {
    #Track speed: 3.5
    plain: 3.5
    copied: speed
    speed_origin: comptime { speed.reflect().origin }
    plain_origin: comptime { plain.reflect().origin }
    copied_origin: comptime { copied.reflect().origin }
    print(speed_origin?.tracked ?? false)
    print(speed_origin?.source ?? "missing")
    print(speed_origin?.line ?? 0)
    print(speed_origin?.column ?? 0)
    print(plain_origin == None)
    print(copied_origin == None)
}
