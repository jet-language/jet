
use json: core.encoding.json

#Codable
Inner: struct { left: Int  right: Bool }

#Codable
Outer: struct { inner: Inner  count: Int }

#Codable
Account: struct {
    email: String
    age: Int

    validate {
        check(email.contains("@"), at: email, "email")
        check(age >= 18, at: age, "age")
    }
}

run: fn() {
    if json.decode<Outer>("{{\"inner\":{{\"left\":\"bad\",\"right\":\"bad\"}},\"count\":\"bad\"}}") == {
        .Ok(_) -> {}
        .Err(errors) -> {
            print(errors.len())
            loop error in errors { print(error.path) }
        }
    }
    if json.decode<Account>("{{\"email\":\"missing-at\",\"age\":12}}") == {
        .Ok(_) -> {}
        .Err(errors) -> {
            print(errors.len())
            loop error in errors { print(error.path) }
        }
    }
}
