
use {
    tasks: core.tasks
    time: core.time
}

fast_nine: fn() -> Int {
    return 9
}

slow_one: fn() -> Int {
    time.sleep(300ms)
    return 1
}

run: fn() {
    task.group g {
        winner: (task.race {
            slow_one(),
            fast_nine()
        }) ?? panic("race failed")
        print(winner)
    }
}
