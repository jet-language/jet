
use files: core.files

run: fn() {
    output := files.create("/dev/full") ?? panic("open")
    output.write_line("buffered") ?? panic("buffer")
    if output.flush() == {
        .Ok(_) -> panic("flush succeeded")
        .Err(error) -> {
            if error == {
                .Other(context) -> print(if context.operation == .Flush -> "flush" else -> "wrong-flush-operation")
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> { print("wrong-flush-kind") }
            }
        }
    }
}
