
use json: core.encoding.json

Email: struct { addr: String }

impl Email.Encode {
    encode: fn(self) -> Dyn {
        m: [String:Dyn]{ "email": Dyn.Text(self.addr.copy()) }
        return Dyn.Object(m)
    }
}

impl Email.Decode {
    decode: fn(tree: Dyn) -> Email [FieldError]! {
        f := &tree.field("email") ?? Dyn.Text("")
        s := f.text() ?? ""
        return Ok(Email{addr: s})
    }
}

run: fn() {
    e := Email{addr: "a@b.com"}
    s := json.to_string(e)
    print(s)
    back := json.decode<Email>(s) ?? panic("decode failed")
    print(back.addr)
}
