
use {
    encoding: core.encoding
    xml: core.encoding.xml
    files: core.files
}

xml_name: fn(local: String) -> Dyn {
    return Dyn.Object([
        "raw": Dyn.Text(local.copy()),
        "prefix": Dyn.Null,
        "local": Dyn.Text(local.copy()),
        "namespace_uri": Dyn.Null,
    ])
}

document_start: fn() -> Dyn {
    return Dyn.Object([
        "$xml_event": Dyn.Text("document_start"),
        "encoding": Dyn.Null,
        "bom": Dyn.Array([]),
    ])
}

document_end: fn() -> Dyn {
    return Dyn.Object(["$xml_event": Dyn.Text("document_end")])
}

element_start: fn(empty_style: String) -> Dyn {
    return Dyn.Object([
        "$xml_event": Dyn.Text("element_start"),
        "name": xml_name("r"),
        "namespaces": Dyn.Array([]),
        "attributes": Dyn.Array([]),
        "empty_style": Dyn.Text(empty_style.copy()),
        "open_lexical": Dyn.Object([
            "raw_text": Dyn.Null,
            "raw_bytes": Dyn.Null,
            "semantic": Dyn.Object([
                "name": xml_name("r"),
                "namespaces": Dyn.Array([]),
                "attributes": Dyn.Array([]),
                "empty_style": Dyn.Text(empty_style.copy()),
            ]),
        ]),
    ])
}

write_unfinished: fn(path: String) {
    output: files.create(path) ?? panic("create partial")
    writer := xml.writer(^output) ?? panic("writer")
    &writer.write(document_start()) ?? panic("document_start")
    &writer.write(element_start("explicit")) ?? panic("open root")
    &writer.flush() ?? panic("flush")
    // no element_end / document_end / finish — Drop leaves incomplete open tag
}

run: fn() {
    write_unfinished("{work}/partial.xml")
    // Same-path reopen after Drop: incomplete open element still here.
    leftover: files.read("{work}/partial.xml") ?? panic("same-path read after Drop")
    print(leftover == "<r>")
    // Same-path recreate: Drop must have released the unfinished writer handle.
    reopen_out: files.create("{work}/partial.xml") ?? panic("same-path recreate after Drop")
    reopen_writer := xml.writer(^reopen_out) ?? panic("reopen writer")
    &reopen_writer.write(document_start()) ?? panic("reopen start")
    &reopen_writer.write(element_start("empty")) ?? panic("reopen empty root")
    &reopen_writer.write(document_end()) ?? panic("reopen end")
    &reopen_writer.finish() ?? panic("reopen finish")
    finished: files.read("{work}/partial.xml") ?? panic("same-path read after finish")
    print(finished == "<r/>")
    // Honesty: unfinished Drop wire ≠ finished complete document.
    print(leftover != finished)

    limits := encoding.EncodingLimits.safe()
    limits.buffer_bytes = 4096
    limits.max_depth = 1
    limits.max_item_bytes = 150000
    limits.max_expansion_bytes = 0
    input: files.open("{work}/heap.xml") ?? panic("heap open")
    reader := xml.reader(^input, limits) ?? panic("heap reader")
    count := 0
    loop count < 8 {
        if &reader.next() == {
            .Val(_) | .None -> { count += 1 }
            .Err(first) -> {
                if &reader.next() == {
                    .Val(_) | .None -> { print("heap-not-latched") }
                    .Err(second) -> {
                        print(first.byte_offset)
                        print(first.path)
                        print(first.reason)
                        print(first.byte_offset == second.byte_offset && first.path == second.path && first.reason == second.reason)
                    }
                }
                break
            }
        }
    }
}
