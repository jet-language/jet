use {
    net: core.net
    time: core.time
}

read_text: fn(stream: &net.TCPStream) -> String {
    String.from_bytes(stream.read(64, deadline: 5s) ?? panic("read")) ?? panic("UTF-8")
}

// Each read finds nothing buffered, so every one parks on the same
// descriptor again after the previous wait was satisfied.
#Test("a descriptor waits again after each satisfied wait") {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    peer: task {
        stream := net.tcp_accept(listener) ?? panic("accept")
        loop at in 0..<5 {
            time.sleep(2ms)
            net.tcp_write_all_bytes(stream, "{at};".bytes()) ?? panic("write")
        }
        net.tcp_close(stream) ?? panic("close peer")
    }
    stream := net.tcp_connect(address) ?? panic("connect")
    seen := ""
    loop seen.len() < "0;1;2;3;4;".len() { seen = "{seen}{read_text(stream)}" }
    assert(seen == "0;1;2;3;4;", "every chunk arrives through a fresh wait")
    net.tcp_close(stream) ?? panic("close")
    peer.join() ?? panic("peer")
}

// A wait abandoned before its descriptor became ready, by cancellation or by
// its deadline, must not stop the next wait on that descriptor from waking.
#Test("a wait after a cancelled or timed out wait still wakes") {
    socket: net.udp_bind("127.0.0.1:0") ?? panic("bind")
    target: net.udp_local_addr(socket) ?? panic("address")
    peer: net.udp_bind("127.0.0.1:0") ?? panic("peer")
    budget: Duration.seconds(5) ?? panic("budget")
    { sender: parked_tx, receiver: parked_rx }: channel<Int>()
    waiter: task {
        parked_tx.send(1)
        if socket.ready(NetReadyInterest.Read, deadline: budget) == {
            .Ok(_) -> panic("the cancelled wait saw a datagram")
            .Err(_) -> {}
        }
    }
    _parked: parked_rx.receive() ?? panic("parked")
    time.sleep(10ms)
    waiter.cancel()
    waiter.join() ?? panic("waiter")
    first: task {
        time.sleep(2ms)
        _sent: peer.send_to("a".bytes(), target, deadline: budget) ?? panic("send a")
    }
    _ready: socket.ready(NetReadyInterest.Read, deadline: budget) ?? panic("ready after a cancelled wait")
    first.join() ?? panic("first send")
    assert(net.udp_packet_data(socket.receive(16, deadline: budget) ?? panic("receive a")) == "a", "datagram after a cancelled wait")
    if socket.ready(NetReadyInterest.Read, deadline: Duration.milliseconds(5) ?? panic("short")) == {
        .Ok(_) -> panic("the timed out wait saw a datagram")
        .Err(_) -> {}
    }
    second: task {
        time.sleep(2ms)
        _sent: peer.send_to("b".bytes(), target, deadline: budget) ?? panic("send b")
    }
    _again: socket.ready(NetReadyInterest.Read, deadline: budget) ?? panic("ready after a timed out wait")
    second.join() ?? panic("second send")
    assert(net.udp_packet_data(socket.receive(16, deadline: budget) ?? panic("receive b")) == "b", "datagram after a timed out wait")
}

// Connections that are closed, or only dropped, after a wait hand their
// descriptor number and carrier memory to the next connection, which must
// get its own registration rather than the previous one's.
#Test("a reused descriptor after close or drop waits on its own registration") {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    rounds: 64
    peer: task {
        loop at in 0..<rounds {
            stream := net.tcp_accept(listener) ?? panic("accept")
            time.sleep(1ms)
            net.tcp_write_all_bytes(stream, "{at}".bytes()) ?? panic("write")
            net.tcp_close(stream) ?? panic("close peer")
        }
    }
    loop at in 0..<rounds {
        stream := net.tcp_connect(address) ?? panic("connect")
        assert(read_text(stream) == ("{at}"), "round {at} reads its own peer")
        if at % 2 == 0 -> net.tcp_close(stream) ?? panic("close")
    }
    peer.join() ?? panic("peer")
}
