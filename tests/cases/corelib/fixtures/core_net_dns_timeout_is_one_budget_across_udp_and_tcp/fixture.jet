use {
    net: core.net
    files: core.files
    process: core.process
    sys: core.sys
    time: core.time
}

fixture_build: fn(address: String) {
    original: files.read("guest.template") ?? panic("read original guest")
    source: original.replace("@ADDR@", address)
    files.write("guest.jet", source) ?? panic("write guest")
    jet: sys.get("JET_BIN") ?? panic("JET_BIN missing")
    build: process.cmd([jet, "build", "guest.jet"]).stdout(.Capture).stderr(.Capture).run() ?? panic("build guest")
    assert(build.code == 0, "original guest compilation must succeed")
}
fixture_run: fn() -> ProcessReceipt {
    process.cmd([".jet/build/guest"]).stdout(.Capture).stderr(.Capture).run() ?? panic("run original guest")
}
fixture_copy: fn(out: &[U8], bytes: [U8], start: Int, end: Int) {
    loop i in start..<end -> out.push(bytes[i])
}
fixture_u16: fn(out: &[U8], n: Int) {
    out.push(U8{(n /% 256) %% 256})
    out.push(U8{n %% 256})
}
fixture_question_end: fn(query: [U8]) -> Int {
    pos := 12
    loop pos < query.len() && query[pos] != (U8{0}) {
        pos += Int.from_u8(query[pos]) + 1
    }
    pos + 5
}
fixture_header: fn(query: [U8], flags: Int, answers: Int, authorities: Int, additional: Int) -> [U8] {
    out := [U8]{}
    fixture_copy(out, query, 0, 2)
    fixture_u16(out, flags)
    fixture_u16(out, 1)
    fixture_u16(out, answers)
    fixture_u16(out, authorities)
    fixture_u16(out, additional)
    fixture_copy(out, query, 12, fixture_question_end(query))
    out
}
fixture_truncated: fn(query: [U8]) -> [U8] {
    out := fixture_header(query, 0x8380, 1, 0, 0)
    out.push(U8{0xc0})
    out
}
fixture_send: fn(socket: net.UDPSocket, packet: net.UDPPacket, bytes: [U8]) {
    peer: net.socket_addr(packet.host, packet.port) ?? panic("peer")
    (net.udp_send_bytes_to(socket, bytes, peer) ?? panic("send fixture response")).drop("the fixture reply needs no sent byte count")
}

fixture_read_exact: fn(stream: &net.TCPStream, n: Int) -> [U8] {
    out := [U8]{}
    loop out.len() < n {
        chunk: net.tcp_read_bytes(stream, n - out.len()) ?? panic("read exact")
        assert(chunk.len() != 0, "unexpected EOF reading DNS TCP frame")
        fixture_copy(out, chunk, 0, chunk.len())
    }
    out
}

#Test("core_net_dns_timeout_is_one_budget_across_udp_and_tcp") {
    tcp: net.tcp_listen("127.0.0.1:0") ?? panic("TCP bind")
    addr: net.listener_local_socket_addr(tcp) ?? panic("TCP address")
    socket: net.udp_bind_addr(addr) ?? panic("UDP dual bind")
    address: net.socket_to_string(addr)
    server: task {
        packet: net.udp_recv_from(socket, 512) ?? panic("receive UDP")
        started: time.start()
        time.sleep(70ms)
        fixture_send(socket, packet, fixture_truncated(packet.data))
        stream := net.tcp_accept(tcp) ?? panic("TCP accept")
        net.set_read_timeout(stream, 500) ?? panic("TCP timeout")
        prefix: fixture_read_exact(stream, 2)
        n: Int.from_u8(prefix[0]) * 256 + Int.from_u8(prefix[1])
        query: fixture_read_exact(stream, n)
        _ignored: net.tcp_read_bytes(stream, 1)
        started.elapsed_millis()
    }
    fixture_build(address)
    observed: fixture_run()
    elapsed: server.join() ?? panic("peer failed")
    assert(observed.code != 0, "stalled TCP fallback must fail")
    assert(observed.errors.contains("dns total timeout"), "original timeout witness")
    assert(elapsed < 190, "UDP and TCP must share one budget")
}
