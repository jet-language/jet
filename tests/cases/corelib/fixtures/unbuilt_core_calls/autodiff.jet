use compute: core.compute

loss: fn(w: Tensor, x: Tensor) -> Tensor { compute.mul(w, x) ?? panic("loss") }

run: fn() {
    w: compute.from_list([2.0]) ?? panic("w")
    x: compute.from_list([4.0]) ?? panic("x")
    tangent: compute.ones([1]) ?? panic("tangent")
    d_loss: compute.jvp(loss)
    { value: value, tangent: out }: d_loss(w.copy(), x.copy(), tangent.copy(), tangent.copy())
    print("jvp:{compute.to_list(value)}:{compute.to_list(out)}")
    pulled: compute.vjp(loss, w, x)
    print("vjp:{compute.to_list(pulled.value)}")
}
