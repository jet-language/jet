use core.data as data

struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    rows :: [Ticket]{Ticket{team: "core", minutes: 7.0}, Ticket{team: "web", minutes: 2.0}}
    selected :: data.query(rows)
        .filter(t -> t.minutes >= 5.0)
        .collect() ?? panic("filter")
    print("selected:{selected.len()}")
}
