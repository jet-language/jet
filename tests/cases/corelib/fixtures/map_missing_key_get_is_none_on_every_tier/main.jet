// Defect 3: `get` of a missing key is None for a grouped map and a plain
// map, so it compares unequal to nothing and equal to None on every tier.
run: fn() {
    grouped: [String: [Int]]{"a": [1]}
    print(grouped.get("z") != None)
    print(grouped.get("z") == None)
    print(grouped.get("a") != None)
    plain: [String: Int]{"a": 1}
    print(plain.get("z") != None)
    print(plain.get("z") == None)
    print(plain.get("a") != None)
}
