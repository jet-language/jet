use c :: c.demo
use game :: core.game

#Import module c.demo {
    fn ping(x: I32) -> I32 = "ping"
}

fn run() {
    scene := game.Scene.new("frame-foreign")
    scene.on_frame((frame) -> {
        level := I32{3}
        print(c.ping(level))
    })
    game.run(scene).drop("only the schedule refusal is under test")
}
