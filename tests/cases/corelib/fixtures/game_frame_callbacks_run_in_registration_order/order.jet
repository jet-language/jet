use game: core.game

Position: struct {
    x: Int
}

advance: fn(position: &Position, by: Int) {
    position.x += by
}

run: fn() {
    scene := game.Scene.new("frame-order")
    position := Position{x: 0}
    scene.on_frame(fn(frame) {
        advance(position, 10) ?? panic("advance")
        print("first frame={frame.index} x={position.x}")
    })
    scene.on_frame(fn(frame) {
        advance(position, 1) ?? panic("advance")
        print("second frame={frame.index} x={position.x}")
    })
    game.run(scene).drop("the callbacks' prints are the record under test")
}
