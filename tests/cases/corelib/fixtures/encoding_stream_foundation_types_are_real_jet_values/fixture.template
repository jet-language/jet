
use {
    encoding: core.encoding
    json: core.encoding.json
    jsonl: core.encoding.jsonl
    csv: core.encoding.csv
    xml: core.encoding.xml
    cbor: core.encoding.cbor
    files: core.files
}

keep_error: fn(v: &&encoding.EncodingError) -> encoding.EncodingError { return v }
keep_cause: fn(v: &&encoding.EncodingCause) -> encoding.EncodingCause { return v }
keep_event: fn(v: &&encoding.DataEvent) -> encoding.DataEvent { return v }
keep_format: fn(v: &&encoding.EncodingFormat) -> encoding.EncodingFormat { return v }
keep_kind: fn(v: &&encoding.EncodingErrorKind) -> encoding.EncodingErrorKind { return v }
keep_json_reader: fn(v: &&json.JSONReader<files.FileReader>) -> json.JSONReader<files.FileReader> { return v }
keep_json_writer: fn(v: &&json.JSONWriter) -> json.JSONWriter { return v }
keep_jsonl_reader: fn(v: &&jsonl.JSONLReader<files.FileReader>) -> jsonl.JSONLReader<files.FileReader> { return v }
keep_jsonl_writer: fn(v: &&jsonl.JSONLWriter) -> jsonl.JSONLWriter { return v }
keep_csv_reader: fn(v: &&csv.CSVReader<files.FileReader>) -> csv.CSVReader<files.FileReader> { return v }
keep_csv_writer: fn(v: &&csv.CSVWriter) -> csv.CSVWriter { return v }
keep_xml_reader: fn(v: &&xml.XMLReader<files.FileReader>) -> xml.XMLReader<files.FileReader> { return v }
keep_xml_writer: fn(v: &&xml.XMLWriter) -> xml.XMLWriter { return v }
keep_cbor_reader: fn(v: &&cbor.CBORReader) -> cbor.CBORReader { return v }
keep_cbor_writer: fn(v: &&cbor.CBORWriter) -> cbor.CBORWriter { return v }

run: fn() {
    limits := encoding.EncodingLimits.safe()
    print("{limits.buffer_bytes}:{limits.max_depth}:{limits.max_item_bytes}:{limits.max_expansion_depth}:{limits.max_expansion_bytes}")
    if limits.max_total_bytes == None { print(true) } else { print(false) }
    print(keep_format(encoding.EncodingFormat.JSON.move()) == encoding.EncodingFormat.JSON)
    print(keep_kind(encoding.EncodingErrorKind.Limit.move()) == encoding.EncodingErrorKind.Limit)

    cause := encoding.EncodingCause{ kind: "io", os_code: None, message: "nope" }
    kept_cause := keep_cause(cause)
    print(kept_cause.kind)
    print(kept_cause.message)

    err := encoding.EncodingError{
        format: encoding.EncodingFormat.JSON,
        kind: encoding.EncodingErrorKind.Limit,
        byte_offset: 0,
        line: None,
        column: None,
        path: "",
        reason: "buffer_bytes 1 is outside 4096..16777216",
        cause: None,
    }
    kept_err := keep_error(err)
    print(kept_err.format == encoding.EncodingFormat.JSON)
    print(kept_err.kind == encoding.EncodingErrorKind.Limit)
    print(kept_err.byte_offset)
    if kept_err.cause == None { print(true) } else { print(false) }
    print("{kept_err}")

    event := encoding.DataEvent.Null
    kept_event := keep_event(event)
    print(true)

    output: files.create("{work}/foundation.json") ?? panic("create")
    writer: json.writer(output, limits, false) ?? panic("writer")
    kept_writer := keep_json_writer(writer)
    kept_writer.write(encoding.DataEvent.Null) ?? panic("write")
    kept_writer.finish() ?? panic("finish")

    bad := encoding.EncodingLimits.safe()
    bad.buffer_bytes = 1
    bad_output: files.create("{work}/bad-limits.json") ?? panic("bad create")
    if json.writer(bad_output, bad, false) == {
        .Ok(_) -> { print("limits-missed") }
        .Err(reject) -> {
            print("{reject}")
            print(reject.format == encoding.EncodingFormat.JSON)
            print(reject.kind == encoding.EncodingErrorKind.Limit)
            print(reject.reason)
        }
    }
}
