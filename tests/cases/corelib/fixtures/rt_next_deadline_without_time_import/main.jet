// The program never names core.time, but RealtimeStream.next_deadline()
// returns core.time's Instant; core.rt imports core.time itself.
use rt :: core.rt

fn run() {
    stream := rt.callback(48000, 256, samples -> {
        total := Float{0.0}
        loop sample in samples -> total += sample
    })
    deadline :: stream.next_deadline()
    print("deadline {deadline}")
    &stream.cancel()
    print("cancelled {stream.is_cancelled()}")
}
