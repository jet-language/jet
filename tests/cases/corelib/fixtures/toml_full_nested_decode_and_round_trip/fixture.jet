
use toml: core.encoding.toml
#Codable
Server: struct { host: String  port: Int }
#Codable
Config: struct { title: String  server: Server  ports: [Int] }
run: fn() {
    raw: "title = \"jet\"\nports = [80, 443]\n\n[server]\nhost = \"db.local\"\nport = 5432\n"
    cfg: toml.decode<Config>(raw) ?? panic("bad toml")
    print(cfg.title)
    print(cfg.server.host)
    print(cfg.server.port)
    print(cfg.ports.len())
    print(toml.to_string(cfg))
}
