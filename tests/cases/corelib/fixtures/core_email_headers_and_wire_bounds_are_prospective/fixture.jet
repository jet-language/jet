use core.email as email
use core.text.parse as text_parse

fn test_repeat(word: String, count: Int) -> String {
    bytes := [U8]{}
    raw :: word.bytes()
    loop _i in 0..<count { loop b in raw -> &bytes.push(b) }
    String.from_bytes(bytes) ?? panic("repeat UTF-8")
}
fn test_wire(message: email.Message) -> String {
    String.from_bytes(email.serialize(message) ?? panic("serialize")) ?? panic("wire UTF-8")
}
fn test_headers_fit(wire: String, include_folded: Bool) {
    bytes :: wire.bytes()
    start := 0
    loop i in 0..<bytes.len() {
        if bytes[i] == (U8{10}) {
            line_bytes := [U8]{}
            loop j in start..i -> &line_bytes.push(bytes[j])
            line :: String.from_bytes(line_bytes) ?? panic("line UTF-8")
            if line.contains(":") || (include_folded && line.starts_with(" ")) {
                assert(i - start + 1 <= 998, "original MAX_HEADER_BYTES split_inclusive bound")
            }
            start = i + 1
        }
    }
    if start < bytes.len() {
        line_bytes := [U8]{}
        loop j in start..<bytes.len() -> &line_bytes.push(bytes[j])
        line :: String.from_bytes(line_bytes) ?? panic("final line UTF-8")
        if line.contains(":") || (include_folded && line.starts_with(" ")) {
            assert(bytes.len() - start <= 998, "original final line bound")
        }
    }
}
// True when core.email refuses the message; the original matched `.Err(_)`.
fn test_message_rejected(sender: email.Address, to: [email.Address], subject: String, body: String, attachments: [email.Attachment]) -> Bool {
    _ :: email.message(sender, to, [email.Address]{}, subject, body, HTML{""}, attachments) ?? return true
    false
}
// True when core.email refuses the attachment; the original matched `.Err(_)`.
fn test_attachment_rejected(filename: String) -> Bool {
    _ :: email.attachment(filename, "application/octet-stream", [U8]{}) ?? return true
    false
}

#Test("core_email_headers_and_wire_bounds_are_prospective") {
    quoted :: email.address("\"Doe, \\\"Ada\\\"\" <ada@example.net>") ?? panic("quoted")
    _quoted_local :: email.address("\"a@b\"@example.net") ?? panic("quoted local rejected")
    unicode_display :: test_repeat("界", 120)
    unicode_name :: "{unicode_display} <mara@example.com>"
    from :: email.address(unicode_name) ?? panic("unicode from")
    message :: email.message(from, [quoted], [email.Address]{}, test_repeat("界", 120), "plain", HTML{""}, [email.Attachment]{}) ?? panic("message")
    wire :: test_wire(message)
    assert(wire.contains("\"Doe, \\\"Ada\\\"\" <ada@example.net>"), "quoted display wire")
    loop word in text_parse.split_ws(wire) {
        if word.starts_with("=?UTF-8?B?") -> assert(word.bytes().len() <= 75, "encoded word byte bound")
    }
    test_headers_fit(wire, true)
    sender :: email.address("sender@example.com") ?? panic("sender")
    recipient :: email.address("recipient@example.com") ?? panic("recipient")
    at_body_limit :: test_repeat("x", 1048576)
    _at_body_limit :: email.message(sender, [recipient], [email.Address]{}, "subject", at_body_limit, HTML{""}, [email.Attachment]{}) ?? panic("at body limit rejected")
    over_body_limit :: test_repeat("x", 1048577)
    assert(test_message_rejected(sender, [recipient], "subject", over_body_limit, [email.Attachment]{}), "over body limit accepted")
    max_subject :: test_repeat("s", 998 - "Subject: ".bytes().len() - 2)
    _max_subject :: email.message(sender, [recipient], [email.Address]{}, max_subject, "body", HTML{""}, [email.Attachment]{}) ?? panic("maximum physical subject rejected")
    assert(test_message_rejected(sender, [recipient], "{max_subject}s", "body", [email.Attachment]{}), "over physical subject accepted")
    name900 :: test_repeat("a", 900)
    _filename900 :: email.attachment("{name900}.txt", "application/octet-stream", [U8]{}) ?? panic("900-byte filename rejected")
    name960 :: test_repeat("a", 960)
    assert(test_attachment_rejected("{name960}.txt"), "960-byte filename accepted")
    tiny :: email.attachment("tiny.bin", "application/octet-stream", [U8]{0}) ?? panic("tiny")
    attachments := [email.Attachment]{}
    loop _i in 0..<65 -> &attachments.push(tiny)
    to :: email.address("to@example.com") ?? panic("to")
    assert(test_message_rejected(sender, [to], "subject", "body", attachments), "MAX_ATTACHMENTS+1 accepted")
}
