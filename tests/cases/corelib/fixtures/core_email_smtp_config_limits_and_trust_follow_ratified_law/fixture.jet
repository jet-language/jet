use core.email as email

#Test("original_safe_smtp_limits") {
    safe :: email.limits()
    assert(safe.max_reply_line_bytes == 512, "safe.max_reply_line_bytes")
    assert(safe.max_reply_lines == 100, "safe.max_reply_lines")
    assert(safe.max_capabilities == 100, "safe.max_capabilities")
    assert(safe.max_recipients == 100, "safe.max_recipients")
    assert(safe.max_message_bytes == 33554432, "safe.max_message_bytes")
    assert(safe.max_auth_challenge_bytes == 4096, "safe.max_auth_challenge_bytes")
}
