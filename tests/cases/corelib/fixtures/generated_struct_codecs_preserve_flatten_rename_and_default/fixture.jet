
use json: core.encoding.json

#Codable
Inner: struct { x: Int  y: Bool }

#[Codable, Rename(.Camel)]
Outer: struct {
    display_name: String
    #Flatten inner: Inner
    count: Int{4 + 5}
}

run: fn() {
    value := Outer{ display_name: "n", inner: Inner{ x: 1, y: true }, count: 2 }
    print(json.to_string(value))
    back := json.decode<Outer>("{{\"displayName\":\"m\",\"x\":3,\"y\":false}}") ?? panic("decode")
    print(back.display_name)
    print(back.inner.x)
    print(back.count)
}
