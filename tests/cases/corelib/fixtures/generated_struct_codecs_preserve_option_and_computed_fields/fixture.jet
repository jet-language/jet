
use json: core.encoding.json

#Codable
Record: struct {
    base: Int
    note: String?
    doubled: Int -> base * 2
}

run: fn() {
    value := Record{ base: 4, note: None }
    print(json.to_string(value))
    back := json.decode<Record>("{{\"base\":5,\"doubled\":999}}") ?? panic("decode")
    print(back.base)
    print(back.doubled)
}
