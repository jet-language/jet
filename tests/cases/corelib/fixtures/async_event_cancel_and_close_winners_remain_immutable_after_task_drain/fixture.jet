package: { name: "async-event-cancel-close" authority: { allow: [Time] } }
use {
    event: core.event
    tasks: core.tasks
}

run: fn() {
    // Payload 0 holds the event's single run slot: its handler stays parked
    // until the hard cancel stops it, so payloads 1 and 2 are still Queued and
    // Pending when the scope cancel decides them.
    hold_cancel_scope: event.scope()
    cancel_scope: event.scope()
    cancel_event: event.async_result<Int, String>(AsyncPolicy{ capacity: 1, overflow: .Block }, .Collect) ?? panic("policy")
    { sender: cancel_hold_started_tx, receiver: cancel_hold_started_rx }: channel<Int>()
    { sender: cancel_hold_release_tx, receiver: cancel_hold_release_rx }: channel<Int>()
    cancel_event.on(hold_cancel_scope, fn(n: Int) {
        cancel_hold_started_tx.send(n.copy()) ?? panic("cancel hold started send")
        held_sender: cancel_hold_release_tx.copy()
        released: cancel_hold_release_rx.receive() ?? panic("cancel hold")
    })
    cancel_hold: cancel_event.emit_async(0)
    cancel_hold_started: cancel_hold_started_rx.receive() ?? panic("cancel hold start")
    #Deadline(100000ms) {
        cancel_queued: cancel_event.emit_async(1)
        cancel_pending: cancel_event.emit_async(2)
        cancel_event.on(cancel_scope, fn(n: Int) {})
        cancel_scope.cancel()
        queued_report: cancel_queued.join() ?? panic("cancel queued join")
        pending_report: cancel_pending.join() ?? panic("cancel pending join")
        print("cancel queued={queued_report.state() == .Cancelled} trace={queued_report.trace().summary()}")
        print("cancel pending={pending_report.state() == .Cancelled} trace={pending_report.trace().summary()}")
    }
    _: cancel_hold.join() ?? panic("cancel hold join")
    print("cancel counts={cancel_event.queued_count()},{cancel_event.running_count()},{cancel_event.blocked_count()}")

    hold_close_scope: event.scope()
    close_scope: event.scope()
    close_event: event.async_result<Int, String>(AsyncPolicy{ capacity: 1, overflow: .Block }, .Collect) ?? panic("policy")
    { sender: close_hold_started_tx, receiver: close_hold_started_rx }: channel<Int>()
    { sender: close_hold_release_tx, receiver: close_hold_release_rx }: channel<Int>()
    close_event.on(hold_close_scope, fn(n: Int) {
        close_hold_started_tx.send(n.copy()) ?? panic("close hold started send")
        held_sender: close_hold_release_tx.copy()
        released: close_hold_release_rx.receive() ?? panic("close hold")
    })
    close_event.on(close_scope, fn(n: Int) {})
    close_hold: close_event.emit_async(0)
    close_hold_started: close_hold_started_rx.receive() ?? panic("close hold start")
    #Deadline(100000ms) {
        close_queued: close_event.emit_async(3)
        close_pending: close_event.emit_async(4)
        close_event.close()
        close_scope.cancel()
        queued_report: close_queued.join() ?? panic("close queued join")
        pending_report: close_pending.join() ?? panic("close pending join")
        print("close queued={queued_report.state() == .Cancelled} trace={queued_report.trace().summary()}")
        print("close pending={pending_report.state() == .Closed} trace={pending_report.trace().summary()}")
    }
    _: close_hold.join() ?? panic("close hold join")
    print("close counts={close_event.queued_count()},{close_event.running_count()},{close_event.blocked_count()}")
}
