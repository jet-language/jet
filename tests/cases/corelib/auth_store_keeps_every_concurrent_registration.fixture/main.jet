package: {
    name: "auth_store_concurrent"
    version: "0.1.0"
    authority: { allow: [DB, Rand] }
}

// Eight tasks register users into core.auth's one session store at once.
// Every registration is kept, so each user can then log in, and a second
// registration of a name is refused.
use auth: core.auth

register: fn(n: Int) -[DB]> Bool {
    if auth.register_user("user{n}@example.com", "argon2id:{n}") == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

run: fn() {
    workers := [Task<Bool>]{}
    loop n in 0..<8 {
        workers.push(task register(n))
    }
    registered := 0
    loop worker in workers {
        if worker.join() ?? panic("register task failed") -> registered += 1
    }
    print("registered {registered}")
    logins := 0
    loop n in 0..<8 {
        session: auth.password_login("user{n}@example.com", "argon2id:{n}", 1000, 60) ?? next
        if auth.session_user(session) == ("user{n}@example.com") -> logins += 1
    }
    print("logins {logins}")
    if auth.register_user("user3@example.com", "argon2id:3") == {
        .Ok(_) -> print("duplicate kept")
        .Err(error) -> print("duplicate refused: {error}")
    }
}
