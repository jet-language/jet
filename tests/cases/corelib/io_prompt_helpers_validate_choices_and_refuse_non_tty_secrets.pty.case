# Port of tests/corelib_parts/http_data.rs:1444-1473; original Unix real-PTY subclaims.
# Universal pipe checks remain in the companion case on every host.
# tests/fixtures/io_prompt_tty_feed.sh types the secret after a pause, once the
# prompt has turned echo off: script(1)
# keeps echo on for piped input, and a terminal echoes input when it arrives.
requires: os:unix
requires: tool:script
# PENDING-GRAMMAR(batch-four): literal assertion-local replace-all.
fixture: fixtures/io_prompt_helpers_validate_choices_and_refuse_non_tty_secrets
step: jet build fixture.jet
step: sh '{root}/tests/fixtures/io_prompt_tty_feed.sh' '{work}/.jet/build/fixture'
env: NO_COLOR=1
stdout: ~ "secret length: 6" # original report witness
stdout.replace("secret length: 6", ""): !~ "secret" # original removes report before echo exclusion
