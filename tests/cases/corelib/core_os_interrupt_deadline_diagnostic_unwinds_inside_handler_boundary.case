# Port of tests/corelib_parts/compile.rs::core_os_interrupt_deadline_diagnostic_unwinds_inside_handler_boundary; guest sources preserved verbatim
# except the deadline, which spec.md `#Context(deadline: <Int epoch_ms>)` spells as an already-passed epoch 0.
# The guests flush stdout after `ready`: a pipe stdout is written when its buffer fills (spec.md print).
requires: os:unix
# PENDING-GRAMMAR(batch-four): raw-session SIGINT; exact ready and rest bytes.
# Generated-Rust panic-enter/leave helper-name assertions RETIRED.
fixture: fixtures/core_os_interrupt_deadline_diagnostic_unwinds_inside_handler_boundary
step: jet build --allow=Env,Exec fixture.jet
session app raw: built
recv app until = "ready\n"
stdout: = "ready\n"
signal app: INT
close app
exit: 0
stdout: = "second\n"
stderr: ~ "Error [E3003]: `deadline exceeded while waiting in time sleep`." # original predicate, current E3003 text
stderr: ~ "Why: A wait/IO point observed an active `#Context(deadline: …)` budget" # original predicate, current E3003 text
stderr: ~ "Fix: Raise the deadline budget, shorten the work" # original predicate, current E3003 text
