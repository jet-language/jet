# core.auth's session store is a module `Shared` cell in its Jet source.
# Eight tasks register at once; a change installs only while the store holds
# what it read, so none is lost, on every optimization level.
fixture: auth_store_keeps_every_concurrent_registration.fixture
env: NO_COLOR=1
step none: jet run -O0 main.jet
exit: 0
stdout: = auth_store_keeps_every_concurrent_registration.out
stderr: empty
step basic: jet run -O1 main.jet
exit: 0
stdout: = auth_store_keeps_every_concurrent_registration.out
stderr: empty
step full: jet run -O2 main.jet
exit: 0
stdout: = auth_store_keeps_every_concurrent_registration.out
stderr: empty
