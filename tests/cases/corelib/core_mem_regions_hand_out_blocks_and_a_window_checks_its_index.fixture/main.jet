// core.mem's Region and Block methods: a reserved region hands out blocks in
// address order and refuses an alignment that is not a power of two, two
// neighbouring blocks join into one, and a region adopted over one of those
// blocks hands out blocks of its own.
use core.mem

// Keeps the blocks this program claims; a block is single use, so it ends
// with its holder.
Shelf: struct {
    blocks: [mem.Block]
}

// A region over `bytes` at `address`, memory that a block of the caller's
// reserved region holds for as long as the adopted region lives.
adopt_over: fn(address: Int, bytes: Int) -> mem.Region {
    #Unsafe("the caller's block holds the bytes and stays unused while the adopted region and its blocks live") {
        mem.Region.adopt(address, bytes)
    }
}

run: fn() {
    shelf := Shelf{blocks: [mem.Block]{}}
    region := mem.Region.reserve(4096) ?? panic("reserve")
    before: region.remaining()
    first := region.claim(24, 8) ?? panic("first claim")
    second: region.claim(40, 8) ?? panic("second claim")
    refused: region.claim(1, 3) == None
    start: first.address() - region.address()
    first.join(second)
    print("claimed {before - region.remaining()} of {before}, first at {start}, joined {first.size()} bytes, alignment 3 refused {refused}")
    shelf.blocks.push(first)

    host: region.claim(256, 16) ?? panic("host claim")
    inner := adopt_over(host.address(), host.size())
    piece: inner.claim(16, 16) ?? panic("adopted claim")
    print("adopted {inner.size()} bytes, {inner.remaining()} left, piece at the host's start {piece.address() == host.address()}")
    shelf.blocks.push(piece)
    inner.close()
    shelf.blocks.push(host)

    print("{shelf.blocks.len()} blocks kept")
    region.close()
}
