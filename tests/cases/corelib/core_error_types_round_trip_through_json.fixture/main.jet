use {
    db: core.db
    json: core.encoding.json
    time: core.time
}

// Core's #Error structs DBError and TimeError derive their codecs: the JSON
// encode and decode of each lower whenever a program asks for them.
run: fn() [FieldError]! {
    conn := db.open_memory()
    policy: db.policy("tasks", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "attacker")
    if scoped.query(SQL{"SELECT nope FROM missing"}) == {
        .Ok(_rows) -> {
            print("accepted")
        }
        .Err(error) -> {
            print(json.to_string(error) ?? panic("db json"))
        }
    }

    late: time.TimeError.new("late")
    print(json.to_string(late) ?? panic("time json"))

    db_back: json.decode<db.DBError>("{{\"message\":\"boom\"}}")
    print(db_back.message)
    time_back: json.decode<time.TimeError>("{{\"reason\":\"early\"}}")
    print(time_back.reason)
}
