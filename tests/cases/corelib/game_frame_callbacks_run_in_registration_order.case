# A scene's frame callbacks run one after another in registration order on
# every frame, and each callback's checked calls run in source order; two
# callbacks that write the same kind of state need no extra declaration.
# Inside a callback, a foreign call that reaches a resource has no checked
# access contract, so the frame schedule is refused with E2967 at the callback.
fixture: fixtures/game_frame_callbacks_run_in_registration_order
env: NO_COLOR=1
step: jet run order.jet
exit: 0
stdout: = game_frame_callbacks_run_in_registration_order.out
stderr: empty
step: jet check foreign.jet
exit: 1
stdout: empty
stderr: ~ "Error [jet.FrameScheduleConflict]: Frame resource schedule refused: foreign or unknown frame primitive `c.ping` has resource accesses but no checked completion token" # the refusal names the foreign call
stderr: ~ "--> foreign.jet:10:20" # reported at the callback
