# The second `jet run` (or `jet dev --watch=off`) of a file reuses the kept
# `none` program, which runs in place of `jet` as the first run's compiled one
# did: SIGINT to that pid reaches the program, which exits after its handler.
# Neither run starts a build of its own beside the program. Each tier gets its
# own script cache, beside the program's directory so the cache is no part of
# its source tree; its first run compiles and its second reuses.
requires: os:unix
fixture: fixtures/core_os_interrupt_delivery_matches_aot_jit_and_interpreter
copy: fixture.jet app/fixture.jet
session jit_first raw: jet run --allow=Env,Exec fixture.jet
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-jit
env: XDG_CACHE_HOME={work}/scripts-jit
recv jit_first until = "ready\n" within 30s
stdout: = "ready\n"
signal jit_first: INT
repeat while process {pid:jit_first} alive timeout 30s every 25ms fail "interrupt program did not exit after SIGINT"
end repeat
close jit_first
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-jit/jet/scripts name $= ".run" = 1 # the compiling run keeps one slot
session jit_kept raw: jet run --allow=Env,Exec fixture.jet
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-jit
env: XDG_CACHE_HOME={work}/scripts-jit
recv jit_kept until = "ready\n" within 30s
stdout: = "ready\n"
signal jit_kept: INT
repeat while process {pid:jit_kept} alive timeout 30s every 25ms fail "kept interrupt program did not exit after SIGINT"
end repeat
close jit_kept
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-jit/jet/scripts name $= ".run" = 1 # the kept run reused that slot
session interpret_first raw: jet run --allow=Env,Exec fixture.jet
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-interpreter
env: XDG_CACHE_HOME={work}/scripts-interpreter
recv interpret_first until = "ready\n" within 30s
stdout: = "ready\n"
signal interpret_first: INT
repeat while process {pid:interpret_first} alive timeout 30s every 25ms fail "interrupt program did not exit after SIGINT"
end repeat
close interpret_first
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-interpreter/jet/scripts name $= ".run" = 1 # the compiling run keeps one slot
session interpret_kept raw: jet run --allow=Env,Exec fixture.jet
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-interpreter
env: XDG_CACHE_HOME={work}/scripts-interpreter
recv interpret_kept until = "ready\n" within 30s
stdout: = "ready\n"
signal interpret_kept: INT
repeat while process {pid:interpret_kept} alive timeout 30s every 25ms fail "kept interrupt program did not exit after SIGINT"
end repeat
close interpret_kept
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-interpreter/jet/scripts name $= ".run" = 1 # the kept run reused that slot
session dev_first raw: jet dev --allow=Env,Exec fixture.jet --watch=off
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-dev
env: XDG_CACHE_HOME={work}/scripts-dev
recv dev_first until = "ready\n" within 30s
stdout: = "ready\n"
signal dev_first: INT
repeat while process {pid:dev_first} alive timeout 30s every 25ms fail "interrupt program did not exit after SIGINT"
end repeat
close dev_first
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-dev/jet/scripts name $= ".run" = 1 # the compiling run keeps one slot
session dev_kept raw: jet dev --allow=Env,Exec fixture.jet --watch=off
cwd: app
env: NO_COLOR=1
env: JET_STORE_DIR={work}/run-cache-dev
env: XDG_CACHE_HOME={work}/scripts-dev
recv dev_kept until = "ready\n" within 30s
stdout: = "ready\n"
signal dev_kept: INT
repeat while process {pid:dev_kept} alive timeout 30s every 25ms fail "kept interrupt program did not exit after SIGINT"
end repeat
close dev_kept
exit: 0
stdout: = "first\nsecond\n"
entries: scripts-dev/jet/scripts name $= ".run" = 1 # the kept run reused that slot
