# core.reactive's `unsubscribe` and `is_active` are exported: the module
# call and the named import both resolve, and the effect record they read
# is the same on O0, O1 and O2.
fixture: reactive_unsubscribe_and_is_active_import_and_call.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = reactive_unsubscribe_and_is_active_import_and_call.out
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = reactive_unsubscribe_and_is_active_import_and_call.out
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = reactive_unsubscribe_and_is_active_import_and_call.out
