step: jet build fixture.jet
session app raw: built
recv app until = "ready\n"
stdout: = "ready\n"
signal app: INT
close app
exit: 0
stdout: = "second\n"
stderr: ~ "panic: first handler failed" # original interrupt boundary diagnostic
