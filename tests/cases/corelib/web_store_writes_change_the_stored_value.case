# #3173: core.web.store's transaction, update, batch, optimistic and patch (and
# the transact receiver) hand their callback the current value as a written
# parameter (`fn(&T)`); the store holds the changed value afterward, and each
# write records the value before it. A struct value changes field by field.
fixture: web_store_writes_change_the_stored_value.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step default: jet run main.jet
exit: 0
stdout: = web_store_writes_change_the_stored_value.out
step: jet run --optimize=none main.jet
exit: 0
stdout: == default
step: jet run --optimize=full main.jet
exit: 0
stdout: == default
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: == default
