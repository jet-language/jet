env: JET_STORE_DIR={work}/cache-uuid/build
exit: any # original status is tuple component, not success-only
stdout: ^= "before\n" # original starts_with
stdout: !~ "drew" # original never produces entropy-backed value
when uuid_interpret.stdout !~ "typed failure": exit: nonzero
when uuid_interpret.stdout !~ "typed failure": stderr: ~ "could not provide cryptographic randomness" # original typed-failure OR nonzero+error fallback
exit: == uuid_aot
stdout: == uuid_aot
stderr: == uuid_aot
