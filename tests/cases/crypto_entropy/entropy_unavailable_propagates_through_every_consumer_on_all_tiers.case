when uuid_default.stdout !~ "typed failure": exit: nonzero
when uuid_default.stdout !~ "typed failure": stderr: ~ "could not provide cryptographic randomness" # original typed-failure OR nonzero+error fallback
exit: == uuid_aot
stdout: == uuid_aot
stderr: == uuid_aot
