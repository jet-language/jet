package: {
    name: "rand_fault_unhandled"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Rand] }
}
use {
    crypto: core.crypto
    random: core.crypto.random
    uuid: core.crypto.uuid
}

recipient: fn() -> crypto.X25519PublicKey {
    secret: crypto.X25519SecretKey.from_bytes([U8]{
        0x77, 0x07, 0x6d, 0x0a, 0x73, 0x18, 0xa5, 0x7d, 0x3c, 0x16, 0xc1, 0x72, 0x51, 0xb2, 0x66, 0x45,
        0xdf, 0x4c, 0x2f, 0x87, 0xeb, 0xc0, 0x99, 0x2a, 0xb1, 0x77, 0xfb, 0xa5, 0x1d, 0xb9, 0x2c, 0x2a,
    }) ?? panic("fixed recipient key")
    secret.public_key()
}

// The negative control: each consumer here stops on its entropy failure, so
// every test fails, and each report names the injected fault. A schedule
// that never reached a consumer's draw would let its test pass.
#Test(faults: [Rand]) raw_stops_on_entropy_failure: fn() {
    bytes: random.bytes(16) ?? panic("raw entropy failure not handled")
    assert_eq(bytes.len(), 16)
}

#Test(faults: [Rand]) keygen_stops_on_entropy_failure: fn() {
    key: crypto.SigningKey.new_random() ?? panic("keygen entropy failure not handled")
    assert_eq(key.public_key().bytes.len(), 32)
}

#Test(faults: [Rand]) seal_stops_on_entropy_failure: fn() {
    box: crypto.seal([recipient()], [U8]{1, 2, 3}, [U8]{}) ?? panic("seal entropy failure not handled")
    assert(crypto.sealed_bytes(box).len() > 3)
}

#Test(faults: [Rand]) password_salt_stops_on_entropy_failure: fn() {
    stored: crypto.password_hash(crypto.Secret.from_text("correct horse")) ?? panic("salt entropy failure not handled")
    assert(stored.text.starts_with("$argon2id$"))
}

#Test(faults: [Rand]) uuid_stops_on_entropy_failure: fn() {
    id: uuid.v4() ?? panic("uuid entropy failure not handled")
    assert_eq(id.len(), 36)
}

run: fn() {}
