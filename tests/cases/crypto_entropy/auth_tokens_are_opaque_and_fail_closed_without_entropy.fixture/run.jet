use auth :: core.auth

// Direct registered Core auth cells preserve original raw timestamp0/ttl1000 and literal password-hash (not wrapper policy).
#Test("auth_tokens_are_opaque_live") {
    user :: "auth-regression-s1@example.com"
    auth.register_user(user, "password-hash") ?? panic("register")
    first :: auth.password_login(user, "password-hash", 0, 1000) ?? panic("first")
    second :: auth.password_login(user, "password-hash", 0, 1000) ?? panic("second")
    first_id :: auth.session_id(first)
    second_id :: auth.session_id(second)
    assert(first_id.starts_with("sess-"))
    assert(second_id.starts_with("sess-"))
    assert(first_id != second_id)
    magic :: auth.magic_link_issue(user, 0, 1000) ?? panic("magic")
    assert(magic.starts_with("magic-"))
    assert(magic != "magic-{"00".repeat(32)}")
    auth.magic_link_consume(magic, 0, 1000) ?? panic("consume")
}
