# PENDING-GRAMMAR(batch-four)
# A terminal step puts all three of the child's streams on the terminal, so the
# fixture's capture.jet, built first, runs `jet` with stdin and stderr on the
# terminal and stdout captured into `picked`, then prints the marker.
requires: os:unix
fixture: shell_prefill_mode_keeps_palette_on_tty_while_stdout_is_captured.fixture
normalize: replace "\r" ""
step: jet build --allow=Exec,FS capture.jet
exit: 0
step: {work}/.jet/build/capture {work}/picked {jet} --color=never
env: JET_HELP_SHELL_PREFILL=1
pty: true
pty-send: "\r" after 150ms
pty-send: "\r" after 150ms
pty-close: after 150ms
exit: 0
stdout: ~ "command palette" # original predicate: transcript contains these exact bytes
stdout: ~ "JET_HELP_CAPTURED" # original predicate: transcript contains these exact bytes
file: picked = shell-prefill-picked.out
stdout: !~ "ready to copy" # original predicate: transcript does not contain these bytes
stdout: !~ "Hello, Jet!" # original predicate: transcript does not contain these bytes
