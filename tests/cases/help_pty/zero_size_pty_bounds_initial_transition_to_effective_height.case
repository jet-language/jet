# Port of tests/help_pty.rs:361-379. PENDING-GRAMMAR(batch-four); exact original inputs/delays/predicates.
requires: os:unix
refused: pty
normalize: replace "\r" ""
step: jet ? --color=never
pty: true size 0x0
unset: NO_COLOR
unset: FORCE_COLOR
pty-send: "E" after 150ms
# Original tests/help_pty.rs:363 sends DEL then q in the second write.
pty-send: "\u007fq" after 150ms
pty-close: after 150ms
exit: 0
# Helper port: help_pty.rs107-130 cursor_up_counts (not a generalized ANSI stripper).
stdout.cursor_up_counts: each < 8 # original predicate: every redraw CSI<n>A count is below viewport rows (vacuous onempty)
# Helper port: help_pty.rs90-105 final_frame_before_cleanup,including>=3sentinels check.
stdout.final_frame: lines <= 8 # original predicate: finalframe Rust .lines() row bound
# Helper port: help_pty.rs71-88 visible_cols counts Unicode chars, ignores ESC through m.
stdout.final_frame.visible_cols: each <= 50 # original predicate: every finalframe line fits visible columns
