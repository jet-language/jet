# Port of tests/help_pty.rs:246-271. PENDING-GRAMMAR(batch-four); exact original inputs/delays/predicates.
requires: os:unix
refused: pty
normalize: replace "\r" ""
step: jet ? --color=always
pty: true size 24x120
unset: NO_COLOR
unset: FORCE_COLOR
pty-send: "q" after 150ms
pty-close: after 150ms
exit: 0
stdout: ~any "\u001b[1;96m" "\u001b[48;5;24" # original predicate: either explicit style marker activates renderer
step: jet ? --color=never
pty: true size 24x120
unset: NO_COLOR
unset: FORCE_COLOR
pty-send: "q" after 150ms
pty-close: after 150ms
exit: 0
stdout: !~ "\u001b[1;96m" # original predicate: transcript does not contain these bytes
stdout: !~ "\u001b[48;5;24" # original predicate: transcript does not contain these bytes
step: jet ? --color=auto
pty: true size 24x120
unset: NO_COLOR
unset: FORCE_COLOR
env: NO_COLOR=
pty-send: "q" after 150ms
pty-close: after 150ms
exit: 0
stdout: !~ "\u001b[1;96m" # original predicate: transcript does not contain these bytes
stdout: !~ "\u001b[48;5;24" # original predicate: transcript does not contain these bytes
