// `Shared{value}` builds a shared cell and infers its payload
// type from the value; `Shared<T>{value}` names the type, and the value
// adapts to it. A name in the braces is the value, not a field shorthand.
Counter: struct {
    hits: Int
}

bump: fn(counter: Shared<Counter>) -> Int {
    counter.hits += 1
    counter.hits
}

run: fn() {
    count: 5
    plain: Shared{count}
    typed: Shared<Int>{7}
    maybe: Shared<Int?>{None}
    counter: Shared{Counter{hits: 0}}
    worker: task bump(counter)
    print(worker.join() ?? panic("task failed"))
    counter.hits += 10
    print(counter.hits)
    print(plain.guard_read().value + typed.guard_read().value)
    print(maybe.guard_read().value ?? -1)
}
