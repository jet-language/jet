# HAND-PORT tests/jetpack_no_daemon.rs:40-118 sandbox_default_never_allows_unsandboxed_build_and_require_mode_errors
# Original predicates; same-head kit verification pending.
# Retargeted off the retired `jetpack build` (2b160ee885): build -> env --prep / use --prep, run -> env / use, test -> jet test.
# The Rust test ran a bare `jetpack build` in an empty scratch directory, and the named fixture never existed, so none is staged.
# Live `jetpack env --prep` there is "Nothing to do"; `jetpack use --prep ripgrep@jetpack --offline` reaches the same sandbox gate without network.
env: NO_COLOR=1
env: HOME={work}/home
env: JETPACK_ROOT={work}/root
mkdir: home
mkdir: root
step: jetpack use --prep ripgrep@jetpack --offline --no-color
env: JETPACK_FAKE_SANDBOX=unavailable
exit: any # original predicate: status is not asserted
stderr: !~ "L0205" # original predicate
stderr: !~ "unsandboxed" # original predicate
step: jetpack use --prep ripgrep@jetpack --offline --json --no-color
env: JETPACK_FAKE_SANDBOX=unavailable
exit: any # original predicate: status is not asserted
stderr: !~ "\"code\": \"L0205\"" # original predicate
stderr: !~ "unsandboxed" # original predicate
step: jetpack config sandbox require --no-color
exit: 0
step: jetpack use --prep ripgrep@jetpack --offline --no-color
env: JETPACK_FAKE_SANDBOX=unavailable
exit: 2
stderr: ~ "E1275" # original predicate
stderr: ~ "approved remote builder, or enable the native sandbox" # original predicate
step: jetpack use --prep ripgrep@jetpack --offline --json --no-color
env: JETPACK_FAKE_SANDBOX=unavailable
exit: any # original predicate: status is not asserted
stderr: ~ "\"code\": \"E1275\"" # original predicate
stderr: ~ "\"severity\": \"error\"" # original predicate

