# Every Jai metaprogramming peer family, J01 to J40, and every row of the
# public metadata contract pass their witnesses. check.jet reads the
# families from manifest.tsv and the contract rows from the registry, plans
# their witness ids, and one corpora run runs each witness on its tiers; the
# check then reads that run's verdicts. A family with no row, an Owed
# contract row, a source cited as the wrong kind of Jai evidence, or a
# witness that fails, is skipped, is known failing, did not run or missed a
# level fails the check. The first two steps show it failing closed.
fixture: jai_families_and_metadata_rows_each_pass_a_witness.fixture
env: NO_COLOR=1
step: jet run check.jet -- verify {root} broken.tsv inconclusive.json
exit: 1
stderr: ~ "J02 has no row" # a family with no row fails
stderr: ~ "J01 lists S3 as observed, but the manifest's source S3 is not an observed one" # a demo is never observed behavior
step: jet run check.jet -- verify {root} manifest.tsv inconclusive.json
exit: 1
stderr: ~ "`Examples/Metaprogramming/Comptime/PrepBlock.jet` is UNSUPPORTED at o1" # an inconclusive verdict fails
stderr: ~ "`Examples/Metaprogramming/Comptime/PrepBlock.jet` did not run at o2" # a missed level fails
stderr: ~ "`Examples/Metaprogramming/Comptime/PrepFn.jet` has no result: it did not run" # a witness that never ran fails
step: jet run check.jet -- plan {root} manifest.tsv {work}/witnesses.txt
exit: 0
step: jet test {root}/Compiler --profile corpora --cases={work}/witnesses.txt --results={work}/results.json --jobs=4
env: TMPDIR={work}
timeout: 3600s
exit: any # the check below names each failing witness with its row
step: jet run check.jet -- verify {root} manifest.tsv {work}/results.json
exit: 0
stdout: = "40 Jai families and 64 metadata contract rows pass their witnesses\nfamilies only a historical demo shows: J25\n"
