// D-STRUCT-PLANE1=A: the program's structure is a build-time fact plane. The
// three rows share the one law and name the one written word that can loosen
// each direction; their observed entries are compiler-only and erase before
// runtime.
StructureLiveness: struct {
    impl Fact {
        name: "Structure.Liveness"
        holds: .Build
        safe: .Gain
        gates: ["_name"]
    }
}

StructureLifecycle: struct {
    impl Fact {
        name: "Structure.Lifecycle"
        holds: .Build
        safe: .Shrink
        gates: ["policy allow"]
    }
}

StructureImportEdge: struct {
    impl Fact {
        name: "Structure.ImportEdge"
        holds: .Build
        safe: .Shrink
        gates: ["manifest rule edit"]
    }
}
// D-FREESTAND-FACTS1=A: target availability is a closed Build fact plane.
// A present row names a provider and digest; `absent` remains explicit. The
// semantic effect and Authority planes stay separate from machine provision.
TargetMemory: struct {
    impl Fact {
        name: "Target.Memory"
        holds: .Build
        safe: .Gain
        gates: [provider, digest]
    }
}

TargetMmio: struct {
    impl Fact {
        name: "Target.MMIO"
        holds: .Build
        safe: .Gain
        gates: [provider, digest, Unsafe]
    }
}

