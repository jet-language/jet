BuildStampAt: struct {
    impl Fact {
        name: "Build.Stamp.At"
        holds: .Build
        safe: .Gain
        gates: []
    }
}

Effects: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: []
    }
}

States: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: []
    }
}

Sendability: struct {
    impl Fact {
        holds: .Value
        safe: .None
        gates: []
        proved_by: ownership
    }
}

ViewProvenance: struct {
    impl Fact {
        holds: .Value
        safe: .None
        gates: []
        proved_by: ownership
    }
}

Movedness: struct {
    impl Fact {
        holds: .Value
        safe: .None
