// D-FACT-LAW1=B / D-FACTDECL1=A: compiler fact rows are written here.
//
// Each row names what it holds, its safe direction, and every word that can
// move the fact away from safety. Prover rows name their publisher and still
// carry the same law columns.

// D-TYPE2-PLANE1=A / D-TYPE2-FOUND1=A: compiler type planes are ordinary
// readable Prelude rows. `@name` gives the row its dotted compiler namespace;
// `@identity` states whether the plane contributes to carrier identity.
TypeNominal: struct {
    impl Fact {
        name: "Type.Nominal"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeInterval: struct {
    impl Fact {
        name: "Type.Interval"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeLayout: struct {
    impl Fact {
        name: "Type.Layout"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeMeasure: struct {
    impl Fact {
        name: "Type.Measure"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeDimension: struct {
    impl Fact {
        name: "Type.Dimension"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeClassification: struct {
    impl Fact {
        name: "Type.Classification"
        holds: .Value
        safe: .Gain
        gates: []
        identity: false
    }
}

TypeExactness: struct {
    impl Fact {
        name: "Type.Exactness"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeObligation: struct {
    impl Fact {
        name: "Type.Obligation"
        holds: .Value
        safe: .Gain
        gates: []
        identity: false
    }
}

Exactness: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: [approx, rounded, raw, wrapping, saturating, checked]
    }
}

Flow: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: []
    }
}

Taint: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: [Scrub]
    }
}

Duty: struct {
    impl Fact {
        holds: .Value
        safe: .Discharge
        gates: [detach, drop]
    }
}

Rights: struct {
    impl Fact {
        holds: .Scope
        safe: .Shrink
        gates: [Unsafe, Impure, Grant]
    }
}

PackagePolicy: struct {
    impl Fact {
        holds: .Scope
        safe: .Shrink
        gates: [Unsafe, Grant]
    }
}

BuildPackageName: struct {
    impl Fact {
        name: "Build.Package.Name"
        holds: .Build
        safe: .Gain
        gates: []
    }
}

BuildPackageVersion: struct {
    impl Fact {
        name: "Build.Package.Version"
        holds: .Build
        safe: .Gain
        gates: []
    }
}

