// D-FACT-LAW1=B / D-FACTDECL1=A: compiler fact rows are written here.
//
// Each row names what it holds, its safe direction, and every word that can
// move the fact away from safety. Prover rows name their publisher and still
// carry the same law columns.

// D-TYPE2-PLANE1=A / D-TYPE2-FOUND1=A: compiler type planes are ordinary
// readable Prelude rows. `@name` gives the row its dotted compiler namespace;
// `@identity` states whether the plane contributes to carrier identity.
fact TypeNominal($name: "Type.Nominal", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeInterval($name: "Type.Interval", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeLayout($name: "Type.Layout", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeMeasure($name: "Type.Measure", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeDimension($name: "Type.Dimension", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeClassification($name: "Type.Classification", $holds: .Value, $safe: .Gain, $gates: [], $identity: false)
fact TypeExactness($name: "Type.Exactness", $holds: .Value, $safe: .Gain, $gates: [], $identity: true)
fact TypeObligation($name: "Type.Obligation", $holds: .Value, $safe: .Gain, $gates: [], $identity: false)

fact Exactness($holds: .Value, $safe: .Gain, $gates: [approx, rounded, raw, wrapping, saturating, checked])
fact Flow($holds: .Value, $safe: .Gain, $gates: [])
fact Taint($holds: .Value, $safe: .Gain, $gates: [Scrub])
fact Duty($holds: .Value, $safe: .Discharge, $gates: [detach, drop])
fact Rights($holds: .Scope, $safe: .Shrink, $gates: [Unsafe, Impure, Grant])
fact PackagePolicy($holds: .Scope, $safe: .Shrink, $gates: [Unsafe, Grant])
fact BuildPackageName($name: "Build.Package.Name", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildPackageVersion($name: "Build.Package.Version", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildOS($name: "Build.OS", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildProfile($name: "Build.Profile", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildSettings($name: "Build.Settings", $holds: .Build, $safe: .Shrink, $gates: [Force])
fact BuildStampGit($name: "Build.Stamp.Git", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildStampDirty($name: "Build.Stamp.Dirty", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildStampToolchain($name: "Build.Stamp.Toolchain", $holds: .Build, $safe: .Gain, $gates: [])
fact BuildStampAt($name: "Build.Stamp.At", $holds: .Build, $safe: .Gain, $gates: [])
fact Effects($holds: .Value, $safe: .Gain, $gates: [])
fact States($holds: .Value, $safe: .Gain, $gates: [])
fact Sendability($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership)
fact ViewProvenance($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership)
fact Movedness($holds: .Value, $safe: .None, $gates: [], $proved_by: ownership)
fact Attribution($holds: .Value, $safe: .None, $gates: [])
fact Origin($holds: .Value, $safe: .None, $gates: [])
fact UnitScaleProvenance($holds: .Value, $safe: .None, $gates: [])
fact Maturity($holds: .Value, $safe: .None, $gates: [])

// D-STRUCT-PLANE1=A: the program's structure is a build-time fact plane. The
// three rows share the one law and name the one written word that can loosen
// each direction; their observed entries are compiler-only and erase before
// runtime.
fact StructureLiveness($name: "Structure.Liveness", $holds: .Build, $safe: .Gain, $gates: ["_name"])
fact StructureLifecycle($name: "Structure.Lifecycle", $holds: .Build, $safe: .Shrink, $gates: ["policy allow"])
fact StructureImportEdge($name: "Structure.ImportEdge", $holds: .Build, $safe: .Shrink, $gates: ["manifest rule edit"])
// D-FREESTAND-FACTS1=A: target availability is a closed Build fact plane.
// A present row names a provider and digest; `absent` remains explicit. The
// semantic effect and Authority planes stay separate from machine provision.
fact TargetMemory($name: "Target.Memory", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetMmio($name: "Target.MMIO", $holds: .Build, $safe: .Gain, $gates: [provider, digest, Unsafe])
fact TargetAllocator($name: "Target.Allocator", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetPanic($name: "Target.Panic", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetStartup($name: "Target.Startup", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetIoRead($name: "IO.Read", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetIoWrite($name: "IO.Write", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetPanicReport($name: "Panic.Report", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetTimeWall($name: "Time.Wall", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetTimeMonotonic($name: "Time.Monotonic", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetTimeZoneData($name: "Time.ZoneData", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetTimeSleep($name: "Time.Sleep", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetEntropy($name: "Rand.Entropy", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
fact TargetScheduler($name: "Target.Scheduler", $holds: .Build, $safe: .Gain, $gates: [provider, digest])
