
use api: core.encoding.base64
TEXT: comptime { "Zg==" }

report_shadowed_local: fn(text: String) {
    input: text.copy()
    if api.decode(input) == {
        .Ok(bytes) -> print(bytes.len())
        .Err(error) -> print(error.reason)
    }
}

report_reader_progress: fn() {
    reader: Reader.over([U8]{7, 9})
    first: reader.read_u8() ?? U8{0}
    second: reader.read_u8() ?? U8{0}
    print(first)
    print(second)
}

run: fn() {
    print(TEXT)
    report_shadowed_local("a?==")
    report_reader_progress()
}
