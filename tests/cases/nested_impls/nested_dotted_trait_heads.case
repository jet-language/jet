# Dotted trait heads parse in a type body: `impl Literal.Int` gives the type a
# literal hook and `impl far.Named` implements a trait of another module. The
# heads, with an operator's `(Int) #Commutative`, format unchanged.
fixture: nested_dotted_trait_heads.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: = "5 m\n3 m\n4 m\n"
step: jet fmt --check main.jet
exit: 0 # every head prints back as written
