// A trait block in a type body takes a dotted head: a literal capability
// (`impl Literal.Int`) and a trait from another module (`impl far.Named`).
// Operator heads keep their right-hand type and `#Commutative`.
far: module {
    Named: trait {
        label: fn(self) -> String
    }
}

Meters: struct {
    v: Int

    impl Literal.Int {
        #run from_literal: fn(value: Int) -> Meters { Meters{v: value} }
    }

    impl far.Named {
        label: fn(self) -> String { "{self.v} m" }
    }

    impl Add(Int) #Commutative {
        add: fn(self, rhs: Int) -> Meters { Meters{v: self.v + rhs} }
    }
}

show: fn(value: Meters) -> String { value.label() }

run: fn() {
    print(show(5))
    print(show(Meters{v: 1} + 2))
    print(show(3 + Meters{v: 1}))
}
