Greet: trait {
    name: fn(self) -> String
    hello: fn(self) -> String { "hello {self.name()}" }
}

Inner: struct {
    n: String

    impl Greet {
        hello: fn(self) -> String { "hi" }
    }
}

Loud: struct {
    n: String

    impl Greet {
        name: fn(self) -> Int { 1 }
    }
}

run: fn() {}
