trait Greet {
    fn name(self) -> String
    fn hello(self) -> String { "hello {self.name()}" }
}

struct Inner {
    n: String

    impl Greet {
        fn hello(self) -> String { "hi" }
    }
}

struct Loud {
    n: String

    impl Greet {
        fn name(self) -> Int { 1 }
    }
}

fn run() {}
