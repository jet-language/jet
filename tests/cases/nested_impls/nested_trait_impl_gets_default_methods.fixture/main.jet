// A trait block in a struct or enum body gets the trait's default methods,
// for a trait in the same module and for one in another module.
Greet: trait {
    name: fn(self) -> String
    hello: fn(self) -> String { "hello {self.name()}" }
}

far: module {
    Wave: trait {
        who: fn(self) -> String
        wave: fn(self) -> String { "wave {self.who()}" }
    }
}

Inner: struct {
    n: String

    impl Greet {
        name: fn(self) -> String { self.n }
    }

    impl far.Wave {
        who: fn(self) -> String { self.n }
    }
}

Pet: enum {
    Cat
    Dog

    impl Greet {
        name: fn(self) -> String { if self == .Cat -> "cat" else -> "dog" }
    }

    impl far.Wave {
        who: fn(self) -> String { self.name() }
    }
}

run: fn() {
    print(Inner{n: "a"}.hello())
    print(Inner{n: "b"}.wave())
    print(Pet.Cat.hello())
    print(Pet.Dog.wave())
}
