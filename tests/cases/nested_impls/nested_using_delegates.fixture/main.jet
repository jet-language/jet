// `impl Trait using field` in a struct body forwards every trait method to
// the field, as `impl T.Trait using field` does at the top level.
Greet: trait {
    name: fn(self) -> String
    hello: fn(self) -> String {
        "hello {self.name()}"
    }
}

Inner: struct {
    n: String

    impl Greet {
        name: fn(self) -> String { self.n }
    }
}

Outer: struct {
    inner: Inner

    // Forwards to the field.
    impl Greet using inner
}

greet_twice: fn(value: Greet) -> String { "{value.hello()} {value.hello()}" }

run: fn() {
    outer: Outer{inner: Inner{n: "b"}}
    print(outer.name())
    print(outer.hello())
    print(greet_twice(outer))
}
