# Seeded random schedules over two and three replicas: writes at any replica,
# sends a cut link loses, deliveries out of order and twice, two replicas
# merging each other's state at once, and links cut and healed. Once the
# network heals and every replica hears from every other, all replicas hold
# one state and no counter step or list push is lost; the same schedules end
# in the same states on O0, O1 and O2.
fixture: partitions_converge.fixture
env: NO_COLOR=1
step: jet run run.jet
exit: 0
stdout: = partitions_converge.out
step o1: jet run -O1 run.jet
exit: 0
stdout: = partitions_converge.out
step o2: jet run -O2 run.jet
exit: 0
stdout: = partitions_converge.out
