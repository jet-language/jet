
use {
    crypto: core.crypto
    sealed: core.files.sealed
}

run: fn() {
    source: Path.from("plain.txt")
    envelope: Path.from("sealed.bin")
    identity: crypto.X25519SecretKey.new_random() ?? return
    sealed.seal([identity.public_key()], source: source, destination: envelope) ?? return
    sealed.open(identity, source: envelope, destination: source) ?? return
}
