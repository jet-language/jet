package: { name: "run", authority: { allow: [FS.Read] } }

// Runs the NIST CAVP and RFC vectors that the public digest, HMAC, HKDF and
// PBKDF2 functions cover (vectors/UPSTREAM.md).
use {
    crypto: core.crypto
    core.encoding
    core.files
}

Counts: struct {
    pass: Int
    fail: Int
}

unhex: fn(text: String) -> [U8] { encoding.hex_to_bytes(text) ?? panic("bad hex {text}") }

hex: fn(bytes: [U8]) -> String { encoding.bytes_to_hex(bytes) }

tally: fn(t: &Counts, ok: Bool, what: String) {
    if ok {
        t.pass += 1
    } else {
        t.fail += 1
        print("FAIL {what}")
    }
}

int_field: fn(text: String) -> Int { Int.parse(text) ?? panic("bad count {text}") }

// The digest of `input` under a CAVP file's algorithm, as lowercase hex.
digest_hex: fn(algorithm: String, input: [U8]) -> String {
    if algorithm == {
        "SHA1" -> crypto.sha1(input)
        "SHA224" -> crypto.sha224(input)
        "SHA256" -> hex(crypto.sha256(input).bytes)
        "SHA384" -> crypto.sha384(input)
        "SHA512" -> hex(crypto.sha512(input).bytes)
        "SHA3_224" -> crypto.sha3_224(input)
        "SHA3_256" -> crypto.sha3_256(input)
        "SHA3_384" -> crypto.sha3_384(input)
        else -> crypto.sha3_512(input)
    }
}

// The value of a CAVP `Name = value` line, or None for another line.
field: fn(line: String, name: String) -> String? {
    prefix: "{name} = "
    if !line.starts_with(prefix) -> return None
    Val(line.slice(prefix.len(), line.len()))
}

// The lines of a CAVP response file, without their CR.
rsp_lines: fn(name: String) -> [String] {
    path: "vectors/nist/{name}.rsp"
    text: files.read(path) ?? panic("read {path}")
    out := [String]{}
    loop line in text.lines() -> out.push(line.trim())
    out
}

// SHAVS and SHA3VS byte-oriented ShortMsg files: `Len` in bits, `Msg` (one
// zero byte for Len 0) and `MD`.
run_digest: fn(algorithm: String) {
    name: "{algorithm}ShortMsg"
    t := Counts{pass: 0, fail: 0}
    bits := 0
    msg := [U8]{}
    loop line in rsp_lines(name) {
        if field(line, "Len") == .Val(v) -> bits = int_field(v)
        if field(line, "Msg") == .Val(v) {
            all: unhex(v)
            msg = [U8]{}
            loop i in 0..<(bits /% 8) -> msg.push(all[i])
        }
        if field(line, "MD") == .Val(v) -> tally(t, digest_hex(algorithm, msg) == v.lower(), "{name} Len = {bits}")
    }
    print("nist {name} pass={t.pass} fail={t.fail}")
}

// HMACVS, the SHA-256 section ([L=32]): the MAC is the first Tlen bytes.
run_hmac: fn() {
    t := Counts{pass: 0, fail: 0}
    count := ""
    key := [U8]{}
    msg := [U8]{}
    tlen := 0
    loop line in rsp_lines("HMAC_L32") {
        if field(line, "Count") == .Val(v) -> count = v
        if field(line, "Tlen") == .Val(v) -> tlen = int_field(v)
        if field(line, "Key") == .Val(v) -> key = unhex(v)
        if field(line, "Msg") == .Val(v) -> msg = unhex(v)
        if field(line, "Mac") == .Val(v) {
            mac: crypto.hmac_sha256(key, msg)
            want: unhex(v)
            same := want.len() == tlen && tlen <= mac.len()
            if same {
                loop i in 0..<tlen {
                    if mac[i] != want[i] -> same = false
                }
            }
            tally(t, same, "HMAC_L32 Count = {count}")
        }
    }
    print("nist HMAC_L32 pass={t.pass} fail={t.fail}")
}

// A hex field of kdf.txt; "-" is empty.
kdf_hex: fn(text: String) -> [U8] {
    if text == "-" -> return [U8]{}
    unhex(text)
}

// RFC 5869 (HKDF-SHA-256) and RFC 7914 (PBKDF2-HMAC-SHA-256). HKDF output is
// a Secret: it is compared, never read back.
run_rfc: fn() {
    path: "vectors/rfc/kdf.txt"
    text: files.read(path) ?? panic("read {path}")
    hkdf := Counts{pass: 0, fail: 0}
    pbkdf2 := Counts{pass: 0, fail: 0}
    loop line in text.lines() {
        if line.starts_with("#") || line.trim() == "" -> next
        f: line.split(" ").to_list()
        if f[0] == "hkdf_sha256" {
            okm: kdf_hex(f[4])
            ok: if crypto.hkdf_sha256(kdf_hex(f[1]), kdf_hex(f[2]), kdf_hex(f[3]), okm.len()) == {
                .Ok(secret) -> crypto.constant_time_equal(secret, crypto.Secret.from_bytes(okm))
                .Err(_) -> false
            }
            tally(hkdf, ok, line)
        } else if f[0] == "pbkdf2_hmac_sha256" {
            dk: kdf_hex(f[4])
            ok: if crypto.pbkdf2_hmac(kdf_hex(f[1]), kdf_hex(f[2]), int_field(f[3]), dk.len()) == {
                .Ok(key) -> key == dk
                .Err(_) -> false
            }
            tally(pbkdf2, ok, line)
        } else {
            panic("unknown kdf.txt line {line}")
        }
    }
    print("rfc5869 hkdf_sha256 pass={hkdf.pass} fail={hkdf.fail}")
    print("rfc7914 pbkdf2_hmac_sha256 pass={pbkdf2.pass} fail={pbkdf2.fail}")
}

run: fn() {
    algorithms: [String]{"SHA1", "SHA224", "SHA256", "SHA384", "SHA512", "SHA3_224", "SHA3_256", "SHA3_384", "SHA3_512"}
    loop algorithm in algorithms -> run_digest(algorithm)
    run_hmac()
    run_rfc()
}
