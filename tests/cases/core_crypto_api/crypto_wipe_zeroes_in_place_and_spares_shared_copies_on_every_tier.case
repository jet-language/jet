# crypto.wipe zeroes a list in place and keeps its length; a list that
# shares its buffer keeps its bytes while the wiped list reads zero,
# and its owner may still write and grow it.
fixture: crypto_wipe_zeroes_in_place_and_spares_shared_copies_on_every_tier/input
step: jet run run.jet
env: JET_STORE_DIR={work}/cache/default/build
exit: 0
stdout: = "unique len=45 zero=true\nshared len=4 zero=true kept=[1, 2, 3, 4]\nkept after writes=[9, 2, 3, 4, 5]\n"
stderr: empty
step: jet run --release run.jet
env: JET_STORE_DIR={work}/cache/release/build
exit: 0
stdout: = "unique len=45 zero=true\nshared len=4 zero=true kept=[1, 2, 3, 4]\nkept after writes=[9, 2, 3, 4, 5]\n"
stderr: empty
step: jet dev --watch=off run.jet
env: JET_STORE_DIR={work}/cache/dev/build
exit: 0
stdout: = "unique len=45 zero=true\nshared len=4 zero=true kept=[1, 2, 3, 4]\nkept after writes=[9, 2, 3, 4, 5]\n"
stderr: empty
