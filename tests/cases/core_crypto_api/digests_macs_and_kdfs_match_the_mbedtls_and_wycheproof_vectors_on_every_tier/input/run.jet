package: { name: "run", authority: { allow: [FS.Read] } }

// Runs the mbedtls 3.6.7 suite vectors and the Wycheproof vectors that the
// public digest, HMAC, HKDF and PBKDF2 functions cover (vectors/UPSTREAM.md).
use {
    crypto: core.crypto
    core.encoding
    core.encoding.json
    core.files
}

Counts: struct {
    pass: Int
    fail: Int
}

QUOTE: U8{34}
COLON: U8{58}

unhex: fn(text: String) -> [U8] { encoding.hex_to_bytes(text) ?? panic("bad hex {text}") }

hex: fn(bytes: [U8]) -> String { encoding.bytes_to_hex(bytes) }

// The digest of `input` under an mbedtls MD name, as lowercase hex; None for
// a digest core.crypto does not export.
digest_hex: fn(md: String, input: [U8]) -> String? {
    if md == {
        "MBEDTLS_MD_SHA1" -> Val(crypto.sha1(input))
        "MBEDTLS_MD_SHA224" -> Val(crypto.sha224(input))
        "MBEDTLS_MD_SHA256" -> Val(hex(crypto.sha256(input).bytes))
        "MBEDTLS_MD_SHA384" -> Val(crypto.sha384(input))
        "MBEDTLS_MD_SHA512" -> Val(hex(crypto.sha512(input).bytes))
        "MBEDTLS_SHA3_224" | "MBEDTLS_MD_SHA3_224" -> Val(crypto.sha3_224(input))
        "MBEDTLS_SHA3_256" | "MBEDTLS_MD_SHA3_256" -> Val(crypto.sha3_256(input))
        "MBEDTLS_SHA3_384" | "MBEDTLS_MD_SHA3_384" -> Val(crypto.sha3_384(input))
        "MBEDTLS_SHA3_512" | "MBEDTLS_MD_SHA3_512" -> Val(crypto.sha3_512(input))
        else -> None
    }
}

sha3_of_len: fn(input: [U8], len: Int) -> String {
    if len == {
        28 -> crypto.sha3_224(input)
        32 -> crypto.sha3_256(input)
        48 -> crypto.sha3_384(input)
        else -> crypto.sha3_512(input)
    }
}

prefix_matches: fn(mac: [U8], want: [U8]) -> Bool {
    if want.len() > mac.len() -> return false
    loop i in 0..<want.len() {
        if mac[i] != want[i] -> return false
    }
    true
}

// The fields of one `.data` call line, quotes stripped.
fields: fn(line: String) -> [String] {
    out := [String]{}
    cur := [U8]{}
    quoted := false
    loop c in line.bytes() {
        if c == QUOTE {
            quoted = !quoted
            next
        }
        if c == COLON && !quoted {
            out.push(String.from_bytes(cur) ?? "")
            cur = [U8]{}
            next
        }
        cur.push(c)
    }
    out.push(String.from_bytes(cur) ?? "")
    out
}

tally: fn(t: &Counts, ok: Bool, what: String) {
    if ok {
        t.pass += 1
    } else {
        t.fail += 1
        print("FAIL {what}")
    }
}

int_field: fn(text: String) -> Int { Int.parse(text) ?? panic("bad count {text}") }

// HKDF output is a Secret: it is compared, never read back. `want` None
// expects the length to be refused.
hkdf_matches: fn(ikm: [U8], salt: [U8], info: [U8], len: Int, want: [U8]?) -> Bool {
    if crypto.hkdf_sha256(ikm, salt, info, len) == {
        .Ok(secret) -> {
            if want == {
                .Val(okm) -> crypto.constant_time_equal(secret, crypto.Secret.from_bytes(okm))
                .None -> false
            }
        }
        .Err(_) -> want == None
    }
}

pbkdf2_bytes: fn(password: [U8], salt: [U8], iterations: Int, len: Int) -> [U8]? {
    if crypto.pbkdf2_hmac(password, salt, iterations, len) == {
        .Ok(key) -> Val(key)
        .Err(_) -> None
    }
}

// One mbedtls call line; None when it is not a digest, HMAC or KDF call.
data_ok: fn(f: [String]) -> Bool? {
    if f[0] == {
        "mbedtls_sha1" -> Val(crypto.sha1(unhex(f[1])) == hex(unhex(f[2])))
        "sha224" -> Val(crypto.sha224(unhex(f[1])) == hex(unhex(f[2])))
        "mbedtls_sha256" -> Val(crypto.sha256(unhex(f[1])).bytes == unhex(f[2]))
        "sha384" -> Val(crypto.sha384(unhex(f[1])) == hex(unhex(f[2])))
        "mbedtls_sha512" -> Val(crypto.sha512(unhex(f[1])).bytes == unhex(f[2]))
        "mbedtls_sha3" | "mbedtls_sha3_multi" | "md_hex" | "md_hex_multi" -> Val(digest_hex(f[1], unhex(f[2])) == Val(hex(unhex(f[3]))))
        "md_text" | "md_text_multi" -> Val(digest_hex(f[1], f[2].bytes()) == Val(hex(unhex(f[3]))))
        "sha3_reuse" -> {
            d1: unhex(f[2])
            d2: unhex(f[4])
            Val(sha3_of_len(unhex(f[1]), d1.len()) == hex(d1) && sha3_of_len(unhex(f[3]), d2.len()) == hex(d2))
        }
        "mbedtls_md_hmac" | "md_hmac_multi" -> {
            want: unhex(f[5])
            cut := [U8]{}
            loop i in 0..<int_field(f[2]) -> cut.push(want[i])
            Val(prefix_matches(crypto.hmac_sha256(unhex(f[3]), unhex(f[4])), cut))
        }
        "test_hkdf" -> {
            okm: unhex(f[5])
            Val(hkdf_matches(unhex(f[2]), unhex(f[3]), unhex(f[4]), okm.len(), Val(okm)))
        }
        "pbkdf2_hmac" -> Val(pbkdf2_bytes(unhex(f[2]), unhex(f[3]), int_field(f[4]), int_field(f[5])) == Val(unhex(f[6])))
        else -> None
    }
}

run_data: fn(name: String) {
    path: "vectors/mbedtls/{name}.data"
    text: files.read(path) ?? panic("read {path}")
    t := Counts{pass: 0, fail: 0}
    loop line in text.lines() {
        if line.starts_with("depends_on:") -> next
        f: fields(line)
        if f.len() < 2 || f[0].contains(" ") -> next
        if data_ok(f) == .Val(ok) -> tally(t, ok, "{name}: {line}")
    }
    print("mbedtls {name} pass={t.pass} fail={t.fail}")
}

// Wycheproof fields, read through Dyn because the schema is camelCase.
dtext: fn(d: Dyn, key: String) -> String {
    if d[key] == {
        .Text(s) -> s.copy()
        else -> panic("field {key}")
    }
}

dint: fn(d: Dyn, key: String) -> Int { d[key].int() ?? panic("field {key}") }

ditems: fn(d: Dyn, key: String) -> [Dyn] {
    if d[key] == {
        .Array(items) -> items.copy()
        else -> panic("field {key}")
    }
}

wycheproof: fn(name: String) -> Dyn {
    path: "vectors/wycheproof/{name}_test.json"
    json.parse(files.read(path) ?? panic("read {path}")) ?? panic("parse {path}")
}

run_wycheproof_hmac: fn() {
    t := Counts{pass: 0, fail: 0}
    loop g in ditems(wycheproof("hmac_sha256"), "testGroups") {
        tag_bytes: dint(g, "tagSize") /% 8
        loop c in ditems(g, "tests") {
            want: unhex(dtext(c, "tag"))
            same: want.len() == tag_bytes && prefix_matches(crypto.hmac_sha256(unhex(dtext(c, "key")), unhex(dtext(c, "msg"))), want)
            tally(t, same == (dtext(c, "result") == "valid"), "hmac_sha256 {dint(c, "tcId")}")
        }
    }
    print("wycheproof hmac_sha256 pass={t.pass} fail={t.fail}")
}

run_wycheproof_hkdf: fn() {
    t := Counts{pass: 0, fail: 0}
    loop g in ditems(wycheproof("hkdf_sha256"), "testGroups") {
        loop c in ditems(g, "tests") {
            want: if dtext(c, "result") == "valid" -> Val(unhex(dtext(c, "okm"))) else -> None
            ok: hkdf_matches(unhex(dtext(c, "ikm")), unhex(dtext(c, "salt")), unhex(dtext(c, "info")), dint(c, "size"), want)
            tally(t, ok, "hkdf_sha256 {dint(c, "tcId")}")
        }
    }
    print("wycheproof hkdf_sha256 pass={t.pass} fail={t.fail}")
}

run_wycheproof_pbkdf2: fn() {
    t := Counts{pass: 0, fail: 0}
    loop g in ditems(wycheproof("pbkdf2_hmacsha256"), "testGroups") {
        loop c in ditems(g, "tests") {
            got: pbkdf2_bytes(unhex(dtext(c, "password")), unhex(dtext(c, "salt")), dint(c, "iterationCount"), dint(c, "dkLen"))
            ok: if dtext(c, "result") == "valid" -> got == Val(unhex(dtext(c, "dk"))) else -> got == None
            tally(t, ok, "pbkdf2_hmacsha256 {dint(c, "tcId")}")
        }
    }
    print("wycheproof pbkdf2_hmacsha256 pass={t.pass} fail={t.fail}")
}

run: fn() {
    suites: [String]{"test_suite_shax", "test_suite_md", "test_suite_hkdf", "test_suite_pkcs5"}
    loop name in suites -> run_data(name)
    run_wycheproof_hmac()
    run_wycheproof_hkdf()
    run_wycheproof_pbkdf2()
}
