# Port of tests/jetpack_nix_index.rs:161-185 (card #2200): the client resolves
# the same signed layout from a disk-backed static publication root. `built
# publish` is start_static_ripgrep: it writes the signed routes under
# publication/ and serves them as plain files (StaticFileServer).
requires: os-name:linux
fixture: nix-index.fixture
# `jet build peer` compiles peer/run.jet and names the artifact after its entry file.
artifact: run
env: JETPACK_ROOT={work}/root
env: JETPACK_SHARED_CAS={work}/root/hangar/cas
env: JETPACK_NIX_FALLBACK_POLICY=deny
env: PATH=/usr/bin
mkdir: root
mkdir: publication
copy: {root}/Jetpack/Nix/Source/Index/IndexCodec.jet {work}/peer/IndexCodec.jet
step: jet build peer
exit: 0
spawn peer: built publish {work}/root {work}/peer.port {work}/nix-index-cache-nar-source {work}/publication
await: file {work}/peer.port timeout 30s
capture: port = text file {work}/peer.port
step prepare: jetpack env --env dev --prep --trust --yes --no-color
isolate: no-nix network=enabled
unset: JETPACK_FIXTURES
exit: 0
file: publication/v1/nixpkgs-unstable/manifest.json is-file
file: publication/v1/nixpkgs-unstable/manifest.json.sig.json is-file
file: publication/index-v1 is-dir
file: publication/nar is-dir
step: built stop {cap:port}
exit: 0
wait: peer
exit: 0
