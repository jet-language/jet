
Payload: struct {
    callback: fn(Int) -> Int
}

identity: fn(value: Int) -> Int {
    return value
}

equal: fn<T: Equatable>(left: T, right: T) -> Bool {
    return left == right
}

run: fn() {
    pool := Pool<Payload>.new()
    left: pool.add(Payload{callback: identity})
    right: pool.add(Payload{callback: identity})
    same: equal(left, right)
    print(same)
}
