
Gate: struct { step: Int }

slow_value: fn(gate: Shared<Gate>) -> Int {
    gate.step = 1
    total := 0
    loop n in 0..<2000000 { total += n }
    print("settled")
    return 1
}

fail_after_start: fn(gate: Shared<Gate>) -> Int {
    loop gate.step == 0 {}
    panic("wait failed")
    return 0
}

leave_on_wait_panic: fn() {
    gate: shared Gate{ step: 0 }
    task.group group {
        slow: task slow_value(gate)
        _ignored: (task.any { fail_after_start(gate) }) ?? 0
        slow.join() ?? panic("slow child failed")
    }
}

run: fn() {
    leave_on_wait_panic()
    print("caller")
}
