# Port of tests/taskgroup_params.rs:466-490; originals retained; runtime PENDING-SAME-HEAD.
fixture: native_deadline_closes_group_before_caller_continues.fixture
step: jet check main.jet
exit: 0
step: jet run main.jet
exit: nonzero
stdout: = ""
# The original child printed "settled" before the group closed. A cancel now
# reaches a loop that never waits at its next iteration, so the closing group
# stops the child's busy loop before "settled", and the caller never
# continues: nothing reaches stdout.
stderr: ~ "E3003" # original diagnostic code membership
# The Rust host's "run tier1 native" attribution line has no successor:
# `jet run` builds the native executable and runs it on the caller's stdio
# (cli.md:598-600), so stderr holds only the program's own E3003 stop.
