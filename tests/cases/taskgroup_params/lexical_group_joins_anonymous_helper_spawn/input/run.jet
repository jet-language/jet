
Gate: struct { step: Int }

spawn_later: fn(_group: Group) -> Shared<Gate> {
    gate: Shared{Gate{ step: 0 }}
    task {
        gate.step += 1
        loop gate.step == 1 {}
        gate.step += 1
        total := 0
        loop n in 0..<2000000 { total += n }
        print("task")
    }
    loop gate.step == 0 {}
    return gate.copy()
}

run: fn() {
    task.group group {
        gate: spawn_later(group)
        print("inside")
        gate.step += 1
        loop gate.step < 3 {}
    }
    print("after")
}
