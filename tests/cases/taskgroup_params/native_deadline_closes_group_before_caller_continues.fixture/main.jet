
use time: core.time

leave_on_deadline: fn() {
    task.group group {
        child: task {
            total := 0
            loop n in 0..<2000000 { total += n }
            print("settled")
        }
        #Context(deadline: time.unix_ns() /% 1_000_000 - 1) {
            time.sleep(10000ms)
        }
        child.join() ?? panic("child failed")
    }
}

run: fn() {
    leave_on_deadline()
    print("caller")
}
