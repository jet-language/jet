use net: core.net

TEXT: comptime { net.fetch("file://data.txt", sha256: "f007767c80150f15e9cacf96dc8d24ac3b6b3094c9b727d1534b175910968f2a") }
NAME: "data.txt"
COMPUTED: comptime { net.fetch("file://{NAME}", sha256: "f007767c80150f15e9cacf96dc8d24ac3b6b3094c9b727d1534b175910968f2a") }

run: fn() {
    print("fetched: {TEXT.trim()}")
    print("same: {TEXT == COMPUTED}")
}
