# A comptime `net.fetch(url, sha256:)` is the one compile-time network input.
# Content that matches the written pin is a String value in the program, the
# same on every tier, whether the URL is a literal or computed by comptime
# code. Content that misses the pin is E3413 and nothing runs. A runtime
# `net.fetch` is E0956, and a pin that isn't a `sha256:` String literal is
# E3414. The fixture's data.txt is "pinned text\n".
fixture: comptime_fetch_pins_its_content_on_every_tier/input
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check good.jet
exit: 0
step: jet run --optimize=none good.jet
exit: 0
stdout: = "fetched: pinned text\nsame: true\n" # O0 holds the fetched value
step: jet run --optimize=basic good.jet
exit: 0
stdout: = "fetched: pinned text\nsame: true\n" # O1 holds the fetched value
step: jet run --optimize=full good.jet
exit: 0
stdout: = "fetched: pinned text\nsame: true\n" # O2 holds the fetched value
step: jet check bad.jet
exit: 1
stderr: count "Error [" = 1 # exactly this many
stderr: ~ "[jet.FetchHashMismatch]" # the pin is checked
stderr: ~ "hashes to `f007767c80150f15e9cacf96dc8d24ac3b6b3094c9b727d1534b175910968f2a`" # the report names the content's hash
step: jet run --optimize=none bad.jet
exit: 1
stderr: ~ "[jet.FetchHashMismatch]" # O0 refuses it
stdout: !~ "escaped" # nothing runs
step: jet run --optimize=basic bad.jet
exit: 1
stderr: ~ "[jet.FetchHashMismatch]" # O1 refuses it
stdout: !~ "escaped" # nothing runs
step: jet run --optimize=full bad.jet
exit: 1
stderr: ~ "[jet.FetchHashMismatch]" # O2 refuses it
stdout: !~ "escaped" # nothing runs
step: jet check runtime.jet
exit: 1
stderr: count "Error [" = 1 # exactly this many
stderr: ~ "`net.fetch` is compile-time only" # a runtime fetch is refused
step: jet run --optimize=none runtime.jet
exit: 1
stderr: ~ "`net.fetch` is compile-time only" # O0 refuses it
stdout: !~ "escaped" # nothing runs
step: jet run --optimize=basic runtime.jet
exit: 1
stderr: ~ "`net.fetch` is compile-time only" # O1 refuses it
stdout: !~ "escaped" # nothing runs
step: jet run --optimize=full runtime.jet
exit: 1
stderr: ~ "`net.fetch` is compile-time only" # O2 refuses it
stdout: !~ "escaped" # nothing runs
step: jet check unpinned.jet
exit: 1
stderr: count "Error [" = 2 # the named pin and the missing pin
stderr: ~ "`net.fetch` takes a URL and a literal `sha256:` pin" # the pin is written in the source
