# tests/net_tls.rs::comptime_fetch_rejects_outside_files_and_private_networks at tests/net_tls.rs:41; hand-port
# Compile-time fetch rejects a file outside the source directory, a loopback destination and a reserved IPv4
# destination with E3414. The sources are the originals; the case writes the absolute work path into proj/main.jet.
fixture: comptime_fetch_rejects_outside_files_and_private_networks.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
mkdir: proj
capture: source = text file.replace("WORK", "{work}") file.in
write: proj/main.jet = "{cap:source}"
step: jet check proj/main.jet
exit: nonzero # tests/net_tls.rs:53-54 comptime fetch must not read outside its source directory
stderr: ~ "[jet.FetchFailed]" # tests/net_tls.rs:55
copy: loopback.in proj/main.jet
step: jet check proj/main.jet
exit: nonzero # tests/net_tls.rs:78-79 comptime fetch must reject loopback destinations
stderr: ~ "[jet.FetchFailed]" # tests/net_tls.rs:80
copy: reserved.in proj/main.jet
step: jet check proj/main.jet
exit: nonzero # tests/net_tls.rs:88-89 comptime fetch must reject reserved IPv4 destinations
stderr: ~ "[jet.FetchFailed]" # tests/net_tls.rs:90
