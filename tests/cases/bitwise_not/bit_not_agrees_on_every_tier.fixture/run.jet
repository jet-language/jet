fn bits(n: Int) -> Int {
    return n
}

fn run() {
    print(bits(0).bit_not())
    print(bits(5).bit_not())
    print(bits(-6).bit_not())
    print(bits(4294967296).bit_not())
    print(bits(15).bit_and(bits(4).bit_not()))
    print(!true)
    a :: U8{5}
    print(a.bit_not())
    b :: I16{5}
    print(b.bit_not())
    c :: U32{5}
    print(c.bit_not())
}
