// A trait value live where control leaves its scope early (`return`
// from inside a loop, `break`, `next`, a `??` fallback that returns, an error
// return) ends there. Every payload's `Shared` context is released once, so
// the count is back to the caller's own when each scenario returns.
package: {
    name: "trait_values_free_at_their_last_owner_on_early_exit"
    authority: { allow: [IO] }
}

#Error
Reject: enum {
    Odd
}

Context: struct {
    id: Int
}

Sink: trait {
    finish: fn(&&self) -[]> Int
    peek: fn(self) -[]> Int
}

Worker: struct {
    context: Shared<Context>
    n: Int

    impl Sink {
        finish: fn(&&self) -[]> Int {
            self.n + 2
        }
        peek: fn(self) -[]> Int {
            self.n + 1
        }
    }
}

make: fn(s: Shared<Context>, n: Int) -> Sink {
    Worker{context: s.copy(), n: n}
}

maybe: fn(s: Shared<Context>, n: Int) -> Sink? {
    if n % 2 == 0 -> return Val(make(s, n))
    None
}

looped: fn(s: Shared<Context>, stop: Int) -> Int {
    outer: make(s, 100)
    total := 0
    loop i in 0..<10 {
        k: make(s, i)
        if i == stop -> return total + k.peek() + outer.peek()
        if i % 3 == 1 -> next
        if i > 6 -> break
        total += k.peek()
    }
    total
}

fallback: fn(s: Shared<Context>, n: Int) -> Int {
    held: make(s, 7)
    k: maybe(s, n) ?? return held.peek()
    k.peek() + held.peek()
}

checked: fn(s: Shared<Context>, n: Int) -> Int Reject! {
    held: make(s, n)
    if n % 2 == 1 -> return Err(Reject.Odd)
    Ok(held.peek())
}

run: fn() {
    s := Shared{Context{id: 1}}
    print("looped {looped(s, 3)} {looped(s, 20)}")
    print("looped dropped {s.strong_count()}")
    print("fallback {fallback(s, 1)} {fallback(s, 2)}")
    print("fallback dropped {s.strong_count()}")
    print("checked {checked(s, 1) ?? 0} {checked(s, 2) ?? 0}")
    print("checked dropped {s.strong_count()}")
}
