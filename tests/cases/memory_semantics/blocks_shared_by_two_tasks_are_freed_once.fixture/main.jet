// Two tasks share one counted text and one counted list, and both release
// them. `b := a` and `ys := xs` alias the blocks (count 2), each task owns
// one reference, and whichever task drops last frees each block. The total
// catches a block freed while the other task still reads it.
fn first(^text: String, ^xs: [Int]) -> Int { text.len() + xs.len() }

fn second(^text: String, ^ys: [Int]) -> Int {
    sum := 0
    loop y in ys -> sum += y
    text.len() + sum
}

fn run() {
    total := 0
    loop round in 1..2000 {
        a := "payload-{round}-".repeat(3)
        b := a
        xs := [Int]{}
        loop n in 1..(round % 7 + 1) -> &xs.push(n * round)
        ys := xs
        task.group g {
            t1 :: task first(^a, ^xs)
            t2 :: task second(^b, ^ys)
            total += (^t1.join() ?? panic("t1")) + (^t2.join() ?? panic("t2"))
        }
    }
    print(total)
}
