# #6727: a trait value passed to a read parameter stays its caller's, and a
# temporary lent for the call ends after it; one passed to a move parameter
# (and stored by the callee) is the callee's to end. Each payload's `Shared`
# context is released once on every tier.
fixture: trait_values_free_at_their_last_owner_when_passed.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_passed.out
step: jet run -O1 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_passed.out
step: jet run -O2 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_passed.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_passed.out
