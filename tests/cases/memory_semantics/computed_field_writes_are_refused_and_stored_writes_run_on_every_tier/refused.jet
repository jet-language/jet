Lock: struct {
    priv stored_path: String
    path: String -> stored_path
    size: Int -> stored_path.len()
}

Holder: struct {
    lock: Lock
}

edit: fn(text: &String) {
    text += "!"
}

run: fn() {
    fixed: Lock{stored_path: "/tmp/app.lock"}
    fixed.path = "/etc/passwd"
    lock := Lock{stored_path: "/tmp/app.lock"}
    lock.path = "/etc/passwd"
    lock.size += 1
    holder := Holder{lock: Lock{stored_path: "/tmp/app.lock"}}
    holder.lock.path = "/etc/passwd"
    edit(lock.path)
    print(lock.path)
}
