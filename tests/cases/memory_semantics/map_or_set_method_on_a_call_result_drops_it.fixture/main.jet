// A Map or Set builtin that only reads a fresh call result
// (`make_map(16).len()`, `make_map(16).keys()`, `make_set(16).has(x)`)
// drops that result once the read is done. Each scenario runs 40,000 times
// on 16 entries. A result that is never dropped keeps 70 MB or more
// resident, so the resident set may grow by at most 8 MB across a
// scenario.
package: {
    name: "map_or_set_method_on_a_call_result_drops_it"
    authority: { allow: [FS.Read] }
}

use files: core.files

ROUNDS: 40000
GROWTH_LIMIT_KB: 8192

status_kb: fn(field: String) -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

make_names: fn(n: Int) -> [String] {
    names := [String]{}
    loop i in 0..<n -> &names.push("key {i}")
    names
}

make_map: fn(n: Int) -> [String:Int] {
    map := [String:Int]{}
    loop i in 0..<n -> map["key {i}"] = i
    map
}

make_set: fn(n: Int) -> Set<String> {
    Set.from(make_names(n))
}

// The Map's length, the body's tail value.
map_len: fn() -> Int {
    make_map(16).len()
}

// An owned copy of one value.
map_get: fn() -> Int {
    make_map(16).get("key 3") ?? 0
}

// A key test in an `if` condition, with a return under it.
map_has_key: fn() -> Int {
    if make_map(16).has_key("key 3") -> return 1
    0
}

// The keys, bound as a List.
map_keys_bound: fn() -> Int {
    keys: make_map(16).keys().to_list()
    keys.len()
}

// A loop over the keys.
map_keys_walked: fn() -> Int {
    total := 0
    loop key in make_map(16).keys() -> total += key.len()
    total
}

// The values, the body's tail value.
map_values_tail: fn() -> Int {
    make_map(16).values().to_list().len()
}

// The Set's length.
set_len: fn() -> Int {
    make_set(16).len()
}

// A member test in an `if` condition, with a return under it.
set_has: fn() -> Int {
    if make_set(16).has("key 3") -> return 1
    0
}

// The members walked as a List.
set_walked: fn() -> Int {
    total := 0
    loop key in make_set(16).to_list() -> total += key.len()
    total
}

measure: fn(name: String, scenario: fn() -> Int) {
    total := scenario()
    start: status_kb("VmRSS:")
    loop _ in 1..<ROUNDS -> total += scenario()
    grown: status_kb("VmRSS:") - start
    if grown > GROWTH_LIMIT_KB -> panic("{name}: the resident set grew {grown} kB over {ROUNDS} rounds")
    print("{name}: {total}, every result dropped")
}

run: fn() {
    measure("map len", map_len)
    measure("map get", map_get)
    measure("map has_key", map_has_key)
    measure("map keys bound", map_keys_bound)
    measure("map keys walked", map_keys_walked)
    measure("map values tail", map_values_tail)
    measure("set len", set_len)
    measure("set has", set_has)
    measure("set walked", set_walked)
}
