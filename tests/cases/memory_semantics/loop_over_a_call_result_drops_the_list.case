# A loop over a fresh call result (`loop row in make_rows(16)`) drops the
# List when the loop ends, by its last pass, a break or a return. Before the
# fix the List was never dropped: the fixture's 40,000 loops per scenario
# grew the resident set by 100 MB (the Map) to 325 MB (nested) on O0.
fixture: loop_over_a_call_result_drops_the_list.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
limit: time=120
exit: 0
stdout: = loop_over_a_call_result_drops_the_list.out
step: jet run --optimize=basic main.jet
limit: time=120
exit: 0
stdout: = loop_over_a_call_result_drops_the_list.out
step: jet run --optimize=full main.jet
limit: time=120
exit: 0
stdout: = loop_over_a_call_result_drops_the_list.out
step: jet build --optimize=full main.jet
exit: 0
step aot: built
limit: time=120
exit: 0
stdout: = loop_over_a_call_result_drops_the_list.out
