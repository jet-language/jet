// #6727: a trait value is one counted box. Source never copies one (E0211,
// copy.jet), but a read of a value its holder keeps (a list element, a
// lambda's capture) gives the box one more owner, and the last owner drops
// the payload: every payload's `Shared` context is released once, and the
// count is back to the caller's own when each scenario returns.
package: {
    name: "trait_values_free_at_their_last_owner_when_copied"
    authority: { allow: [IO] }
}

Context: struct {
    id: Int
}

Sink: trait {
    finish: fn(&&self) -[]> Int
    peek: fn(self) -[]> Int
}

Worker: struct {
    context: Shared<Context>
    n: Int

    impl Sink {
        finish: fn(&&self) -[]> Int {
            self.n + 2
        }
        peek: fn(self) -[]> Int {
            self.n + 1
        }
    }
}

make: fn(s: Shared<Context>, n: Int) -> Sink {
    Worker{context: s.copy(), n: n}
}

element: fn(s: Shared<Context>) {
    list: [Sink]{make(s, 1), make(s, 2)}
    first: list[0]
    total := first.peek()
    loop k in list -> total += k.peek()
    print("element {total} live {s.strong_count()}")
}

captured: fn(s: Shared<Context>) {
    k: make(s, 1)
    f: fn() { k.peek() + 10 }
    print("captured {f()} {f()} live {s.strong_count()}")
}

fallback: fn(s: Shared<Context>) {
    spare: Sink?{Val(make(s, 4))}
    k: spare ?? make(s, 5)
    print("fallback {k.peek()} live {s.strong_count()}")
}

run: fn() {
    s := Shared{Context{id: 1}}
    element(s)
    print("element dropped {s.strong_count()}")
    captured(s)
    print("captured dropped {s.strong_count()}")
    fallback(s)
    print("fallback dropped {s.strong_count()}")
}
