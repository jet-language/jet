// A value passed to a read parameter of a trait type is lent to the call.
// The trait box borrows it: nothing takes it over, so its holder's
// drop stays its only drop. A Folder holding an open Directory, passed twice,
// stays open across both calls and closes once, when its scope ends.
package: {
    name: "trait_argument_is_lent_not_moved"
    authority: { allow: [FS, FS.Read, FS.Write, IO] }
}

use files: core.files

Named: trait {
    label: fn(self) -[]> String
}

Folder: struct {
    directory: Directory

    impl Named {
        label: fn(self) -[]> String { "folder" }
    }
}

describe: fn(item: Named) -> String { item.label() }

// The descriptor this process holds `name` open at (Linux /proc), or -1.
own_number: fn(name: String) -[FS.Read]> Int {
    loop number in 3..<256 {
        if files.read_link("/proc/self/fd/{number}") == .Ok(target) {
            if target.ends_with("/{name}") -> return number
        }
    }
    -1
}

// The folder, and the directory it holds, drop when this returns.
lend_twice: fn(held_path: String) -[FS, IO]> Int {
    folder: Folder{directory: files.open_directory(held_path)}
    open_at: own_number("held")
    print("first: {describe(folder)}, second: {describe(folder)}")
    print("directory open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

run: fn() {
    scratch: files.temp_dir("trait-lend")
    held_path: files.join(scratch.path, "held")
    files.create_dir_all(held_path)
    lend_twice(held_path)
    print("directory closed once, at its scope end: {own_number("held") == -1}")
}
