# A trait value live where control leaves its scope early (`return`
# from inside a loop, `break`, `next`, a `??` fallback that returns, an error
# return) ends there. Each payload's `Shared` context is released once on
# every tier.
fixture: trait_values_free_at_their_last_owner_on_early_exit.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_on_early_exit.out
step: jet run -O1 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_on_early_exit.out
step: jet run -O2 main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_on_early_exit.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = trait_values_free_at_their_last_owner_on_early_exit.out
