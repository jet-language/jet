# A fresh call result used as a match or `if ==` pattern subject, or as a
# method receiver (a struct method, a String method chain, `?.`), drops once
# it is used. These shapes already dropped their result; the case keeps
# them that way next to the loop, index and Map or Set builtin shapes,
# which did not.
fixture: match_and_method_on_a_call_result_drop_the_result.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
limit: time=120
exit: 0
stdout: = match_and_method_on_a_call_result_drop_the_result.out
step: jet run -O1 main.jet
limit: time=120
exit: 0
stdout: = match_and_method_on_a_call_result_drop_the_result.out
step: jet run -O2 main.jet
limit: time=120
exit: 0
stdout: = match_and_method_on_a_call_result_drop_the_result.out
step: jet build -O2 main.jet
exit: 0
step aot: built
limit: time=120
exit: 0
stdout: = match_and_method_on_a_call_result_drop_the_result.out
