# The union box a read argument is lent to (#6677) is freed after each call
# without dropping the lent value: a million calls with a lent String and a
# lent Directory keep the resident set within 8 MB on O0, O1 and O2.
fixture: union_argument_box_is_freed_after_the_call.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
limit: time=120
exit: 0
stdout: = "1000000 lent calls: total 49000000, the boxes freed\n"
step: jet run --optimize=basic main.jet
limit: time=120
exit: 0
stdout: = "1000000 lent calls: total 49000000, the boxes freed\n"
step: jet run --optimize=full main.jet
limit: time=120
exit: 0
stdout: = "1000000 lent calls: total 49000000, the boxes freed\n"
