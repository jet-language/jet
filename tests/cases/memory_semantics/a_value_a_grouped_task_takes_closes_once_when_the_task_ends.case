# A value a `task &&name` capture takes inside a task group belongs to the
# task: its Close runs exactly once, when the task body ends, on every tier.
fixture: a_value_a_grouped_task_takes_closes_once_when_the_task_ends.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = a_value_a_grouped_task_takes_closes_once_when_the_task_ends.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = a_value_a_grouped_task_takes_closes_once_when_the_task_ends.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = a_value_a_grouped_task_takes_closes_once_when_the_task_ends.out
