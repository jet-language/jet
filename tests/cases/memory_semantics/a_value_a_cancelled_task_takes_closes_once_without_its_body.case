# A value a `task &&name` capture takes closes exactly once even when the
# task is cancelled before its body starts, on every tier.
fixture: a_value_a_cancelled_task_takes_closes_once_without_its_body.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = a_value_a_cancelled_task_takes_closes_once_without_its_body.out
step: jet run -O1 main.jet
exit: 0
stdout: = a_value_a_cancelled_task_takes_closes_once_without_its_body.out
step: jet run -O2 main.jet
exit: 0
stdout: = a_value_a_cancelled_task_takes_closes_once_without_its_body.out
