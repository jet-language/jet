// A field read off a fresh call result (`make_table(16).rows.len()`) drops
// that result once the read is done: at the end of the statement, or right
// away for a read in a loop condition or a body's tail value. Each scenario
// runs 40,000 times on a table of 16 rows. A result the read never drops
// keeps 250 MB or more resident, so the resident set may grow by at most
// 8 MB across a scenario.
package: {
    name: "field_of_a_call_result_drops_the_result"
    authority: { allow: [FS.Read] }
}

use files: core.files

ROUNDS: 40000
GROWTH_LIMIT_KB: 8192

Row: struct {
    name: String
    items: [String]
}

Table: struct {
    rows: [Row]
    title: String
    count: Int
}

status_kb: fn(field: String) -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

make_table: fn(n: Int) -> Table {
    rows := [Row]{}
    loop i in 0..<n -> rows.push(Row{name: "row {i}", items: [String]{"a {i}", "b {i}"}})
    Table{rows: rows, title: "table {n}", count: n}
}

// A scalar field, the body's tail value.
scalar_tail: fn() -> Int {
    make_table(16).count
}

// A list field read in place, in a statement.
list_in_a_statement: fn() -> Int {
    total := make_table(16).rows.len()
    total
}

// A list field bound to a variable, which keeps its own share of the list.
list_bound: fn() -> Int {
    rows: make_table(16).rows
    rows.len() + rows[3].items.len()
}

// A String field returned.
text_returned: fn() -> String {
    return make_table(16).title
}

// A field read in a loop condition, once per pass.
in_a_loop_condition: fn() -> Int {
    passes := 0
    loop passes < make_table(16).count /% 4 -> passes += 1
    passes
}

// A field read in an `if` condition, with an early return under it.
in_an_if_condition: fn(flag: Bool) -> Int {
    if make_table(16).count > 4 {
        if flag -> return 1
        return 2
    }
    0
}

measure: fn(name: String, scenario: fn() -> Int) {
    total := scenario()
    start: status_kb("VmRSS:")
    loop _ in 1..<ROUNDS -> total += scenario()
    grown: status_kb("VmRSS:") - start
    if grown > GROWTH_LIMIT_KB -> panic("{name}: the resident set grew {grown} kB over {ROUNDS} rounds")
    print("{name}: {total}, every table dropped")
}

run: fn() {
    measure("scalar tail", scalar_tail)
    measure("list in a statement", list_in_a_statement)
    measure("list bound", list_bound)
    measure("text returned", fn() { text_returned().len() })
    measure("in a loop condition", in_a_loop_condition)
    measure("in an if condition", fn() { in_an_if_condition(true) + in_an_if_condition(false) })
}
