# A variable whose value moved out in an earlier statement owns the value a
# later assignment gives it, and its scope end drops that value. Before the
# fix, `returned := pass_through(^table); table = ^returned` and a fresh
# value assigned after a move were never dropped. The fixture's 40,000 calls
# per scenario then grew the resident set by 250 to 510 MB on O0 and O2. The
# compiler's own passes reassign their graphs this way, so every REPL turn
# kept a whole compile resident.
fixture: reassigned_variable_drops_the_value_it_takes_back.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
limit: time=120
exit: 0
stdout: = reassigned_variable_drops_the_value_it_takes_back.out
step: jet run --optimize=basic main.jet
limit: time=120
exit: 0
stdout: = reassigned_variable_drops_the_value_it_takes_back.out
step: jet run --optimize=full main.jet
limit: time=120
exit: 0
stdout: = reassigned_variable_drops_the_value_it_takes_back.out
step: jet build --optimize=full main.jet
exit: 0
step aot: built
limit: time=120
exit: 0
stdout: = reassigned_variable_drops_the_value_it_takes_back.out
