
struct Score {
    enabled: Bool
    base: Int
    bonus: Int
    #Memo
    total: Int -> if enabled -> {
        subtotal :: base + bonus
        subtotal
    } else -> base
}

fn run() {
    score := Score{enabled: true, base: 10, bonus: 2}
    print(score.total)
    score.bonus = 7
    print(score.total)
}
