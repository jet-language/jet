
Score: struct {
    enabled: Bool
    base: Int
    bonus: Int
    #Memo
    total: Int -> if enabled -> {
        subtotal: base + bonus
        subtotal
    } else -> base
}

run: fn() {
    score := Score{enabled: true, base: 10, bonus: 2}
    print(score.total)
    score.bonus = 7
    print(score.total)
}
