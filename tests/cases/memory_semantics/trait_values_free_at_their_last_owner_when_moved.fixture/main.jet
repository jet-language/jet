// #6727: a moved trait value keeps its one counted box, which its new owner
// ends; an overwritten one ends at the assignment. Every payload's `Shared`
// context is released once, so the count is back to the caller's own when
// each scenario returns.
package: {
    name: "trait_values_free_at_their_last_owner_when_moved"
    authority: { allow: [IO] }
}

Context: struct {
    id: Int
}

Sink: trait {
    finish: fn(&&self) -[]> Int
    peek: fn(self) -[]> Int
}

Worker: struct {
    context: Shared<Context>
    n: Int
}

impl Worker.Sink {
    finish: fn(&&self) -[]> Int {
        self.n + 2
    }
    peek: fn(self) -[]> Int {
        self.n + 1
    }
}

Holder: struct {
    sink: Sink
    spare: Sink?
}

make: fn(s: Shared<Context>, n: Int) -> Sink {
    Worker{context: s.copy(), n: n}
}

bound: fn(s: Shared<Context>) {
    a: make(s, 1)
    b: a
    c: b.move()
    print("bound {c.peek()} live {s.strong_count()}")
}

held: fn(s: Shared<Context>) {
    a: make(s, 1)
    b: make(s, 2)
    h: Holder{sink: a, spare: Val(b)}
    moved: h
    spare: moved.spare ?? make(s, 3)
    print("held {moved.sink.peek()} {spare.peek()} live {s.strong_count()}")
}

overwritten: fn(s: Shared<Context>) {
    k := make(s, 1)
    total := k.peek()
    loop i in 0..<4 {
        k = make(s, i)
        total += k.peek()
    }
    h := Holder{sink: make(s, 5), spare: None}
    h.sink = make(s, 6)
    h.spare = Val(make(s, 7))
    h.spare = None
    print("overwritten {total} {h.sink.peek()} live {s.strong_count()}")
}

run: fn() {
    s := shared Context{id: 1}
    bound(s)
    print("bound dropped {s.strong_count()}")
    held(s)
    print("held dropped {s.strong_count()}")
    overwritten(s)
    print("overwritten dropped {s.strong_count()}")
}
