# A `.measure` body runs over and over, as a loop body does, so moving a
# binding declared outside it is the loop's E0121 at the move: the next run
# would give away a value the last one already ended. An owner the body
# declares, a copy of an outer one, and a read stay legal.
fixture: measure_body_moves_of_an_outer_owner_are_refused.fixture
env: NO_COLOR=1
step: jet check main.jet --json
exit: 1
json: stdout doc $.reports[?severity="error"] #= 1 # only the outer owner's move
json: stdout doc $.reports[?code="E0121"] #= 1
json: stdout doc $.reports[?code="E0121"][0].line = 14 # `consume(s.move())` in the first test
