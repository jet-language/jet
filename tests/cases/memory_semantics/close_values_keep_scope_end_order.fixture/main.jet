// D-DROP-ASAP1=A: a value with Close keeps scope-end timing and
// last-first order. Freeing at last use is for memory-only values, so `a` and
// `b` close after `end of body`, `b` first.
Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

run: fn() {
    a: Res{name: "a"}
    print("last use of {a.name}")
    b: Res{name: "b"}
    print("last use of {b.name}")
    print("end of body")
}
