# #6727: trait values ended before a panic stay ended, so the stop reports
# only the caller's context and the one live payload's; the live one is still
# whole for the stopped cleanup, whose scope guard calls it, and nothing is
# ended twice on any tier.
fixture: trait_values_free_at_their_last_owner_on_a_panic.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 70
stdout: = trait_values_free_at_their_last_owner_on_a_panic.out
stderr: ~ "Stop [E3001]: `panic: stop with 2 live`" # the stop reports only the live payload's owner
step: jet run -O1 main.jet
exit: 70
stdout: = trait_values_free_at_their_last_owner_on_a_panic.out
stderr: ~ "Stop [E3001]: `panic: stop with 2 live`" # the stop reports only the live payload's owner
step: jet run -O2 main.jet
exit: 70
stdout: = trait_values_free_at_their_last_owner_on_a_panic.out
stderr: ~ "Stop [E3001]: `panic: stop with 2 live`" # the stop reports only the live payload's owner
step: jet build main.jet
exit: 0
step aot: built
exit: 70
stdout: = trait_values_free_at_their_last_owner_on_a_panic.out
stderr: ~ "Stop [E3001]: `panic: stop with 2 live`" # the stop reports only the live payload's owner
