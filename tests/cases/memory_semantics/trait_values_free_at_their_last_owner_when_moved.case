# #6727: a trait value moved to another binding, into a struct or an Option
# keeps its one counted box, which the new owner ends; an overwritten trait
# value (a variable, a field, an Option field) ends at the assignment. Each
# payload's `Shared` context is released once on every tier.
fixture: trait_values_free_at_their_last_owner_when_moved.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_moved.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_moved.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_moved.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_moved.out
