// A value passed to a read parameter of a union type is lent to the call
// (#6677). The union box borrows it: nothing copies it and nothing takes it
// over, so its holder's drop stays its only drop. A Directory passed twice
// stays open across both calls and closes once, at its own `close`; 64 MB of
// text passed twice leaves the peak resident set where it was, since one copy
// would raise it by 64 MB. A callee that keeps a copy of the union keeps a
// value of its own, which outlives the call's box.
package: {
    name: "union_argument_is_lent_not_copied"
    authority: { allow: [FS, FS.Read, FS.Write, IO] }
}

use files: core.files

BIG: 64_000_000
PEAK_GROWTH_LIMIT_KB: 16384

kind: fn(handle: Directory | FileReader) -> String {
    if handle == {
        .Directory(_) -> "directory"
        .FileReader(_) -> "reader"
    }
}

measure: fn(value: String | Int) -> Int {
    if value == {
        .String(text) -> text.count_bytes()
        .Int(number) -> number
    }
}

keep: fn(value: String | Int) -> String | Int { value.copy() }

status_kb: fn(field: String) -[FS.Read]> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

// The descriptor this process holds `name` open at (Linux /proc), or -1.
own_number: fn(name: String) -[FS.Read]> Int {
    loop number in 3..<256 {
        if files.read_link("/proc/self/fd/{number}") == .Ok(target) {
            if target.ends_with("/{name}") -> return number
        }
    }
    -1
}

run: fn() {
    scratch: files.temp_dir("union-lend")
    held_path: files.join(scratch.path, "held")
    files.create_dir_all(held_path)
    files.write(files.join(scratch.path, "input.txt"), "reader line\n")
    directory: files.open_directory(held_path)
    reader: files.open(files.join(scratch.path, "input.txt"))
    open_at: own_number("held")
    print("first: {kind(directory)}, second: {kind(directory)}, reader: {kind(reader)}")
    print("directory open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    reader_open: if reader.stat() == {
        .Ok(_) -> true
        .Err(_) -> false
    }
    print("reader open after its call: {reader_open}")
    close(directory)
    print("directory closed once: {own_number("held") == -1}")

    big: "x".repeat(BIG)
    peak: status_kb("VmHWM:")
    print("lent text: {measure(big)} bytes, again {measure(big)}, still held {big.count_bytes()}")
    grown: status_kb("VmHWM:") - peak
    if grown > PEAK_GROWTH_LIMIT_KB -> panic("the peak resident set grew {grown} kB: the lent text was copied")
    print("lent text not copied: true")
    print("plain value: {measure(7)}")
    word: "kept".repeat(2)
    kept: keep(word)
    print("kept copy: {measure(kept)}, holder still {word}")
}
