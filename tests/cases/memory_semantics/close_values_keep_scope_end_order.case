# D-DROP-ASAP1=A (#6392 C2): a value with Close is not freed at its last use.
# It closes at the end of its scope, last opened first, on O0, O1, O2 and a
# built binary.
fixture: close_values_keep_scope_end_order.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = close_values_keep_scope_end_order.out
step: jet run -O1 main.jet
exit: 0
stdout: = close_values_keep_scope_end_order.out
step: jet run -O2 main.jet
exit: 0
stdout: = close_values_keep_scope_end_order.out
step: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = close_values_keep_scope_end_order.out
