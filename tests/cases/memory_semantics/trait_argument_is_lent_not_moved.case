# A value passed to a read parameter of a trait type is lent to the call
# (#6677). Before the fix, the trait box took the value over: the holder gave
# up its Folder, and the box dropped after the call never closed it, so the
# Directory leaked open past its scope. The checked allocator traps a double
# free or a use after free.
fixture: trait_argument_is_lent_not_moved.fixture
env: NO_COLOR=1
step: jet run --checked-alloc -O0 main.jet
exit: 0 # o0
stdout: = trait_argument_is_lent_not_moved.out # o0
step: jet run --checked-alloc -O1 main.jet
exit: 0 # o1
stdout: = trait_argument_is_lent_not_moved.out # o1
step: jet run --checked-alloc -O2 main.jet
exit: 0 # o2
stdout: = trait_argument_is_lent_not_moved.out # o2
