// sealed.jet with `again`, which the program also takes as a value. The call
// in `apply` is now sealed to `double` and `again`, and `again` calls
// `apply`, so the path is a cycle with no `#MaxDepth(n)` and has no bound.
double: fn(value: Int) -> Int {
    value * 2
}

apply: fn(f: fn(Int) -> Int, value: Int) -> Int {
    f(value)
}

again: fn(value: Int) -> Int {
    if value <= 0 -> return 0
    apply(again, value - 1)
}

run: fn() -[!Mem.Stack(above: 65536)]> {
    _ := apply(double, 20) + apply(again, 3)
}
