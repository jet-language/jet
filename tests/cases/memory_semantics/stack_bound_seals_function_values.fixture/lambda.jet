// The only function value is a lambda `run` writes, so the call in `apply`
// is sealed to it, and the lambda's frame counts on top of `apply`'s.
apply: fn(f: fn(Int) -> Int, value: Int) -> Int {
    f(value)
}

run: fn() -[!Mem.Stack(above: 65536)]> {
    _ := apply(fn(value: Int) { value + 1 }, 20)
}
