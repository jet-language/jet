# Port of tests/memory_semantics.rs:226-249; census guard -> public CLI example parity case.
# All FOUR examples and THREE modes retain exact existing goldens and baseline equality.
env: NO_COLOR=1
env: JETPACK_ENV=1
mkdir: memo-release
mkdir: memo-default
mkdir: memo-interpret
mkdir: computed-release
mkdir: computed-default
mkdir: computed-interpret
mkdir: copy-release
mkdir: copy-default
mkdir: copy-interpret
mkdir: views-release
mkdir: views-default
mkdir: views-interpret
step memo: jet run --release {root}/Examples/features/memory/memoize.jet
env: JET_STORE_DIR={work}/memo-release/cache
env: JETPACK_ROOT={work}/memo-release/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/memoize.out
step: jet run {root}/Examples/features/memory/memoize.jet
env: JET_STORE_DIR={work}/memo-default/cache
env: JETPACK_ROOT={work}/memo-default/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/memoize.out
stdout: == memo
step: jet run --interpret {root}/Examples/features/memory/memoize.jet
env: JET_STORE_DIR={work}/memo-interpret/cache
env: JETPACK_ROOT={work}/memo-interpret/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/memoize.out
stdout: == memo
