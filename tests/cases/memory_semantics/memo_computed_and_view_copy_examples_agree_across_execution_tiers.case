# Port of tests/memory_semantics.rs:226-249; census guard -> public CLI example parity case.
# All FOUR examples and THREE modes retain exact existing goldens and baseline equality.
env: NO_COLOR=1
env: JETPACK_ENV=1
mkdir: memo-release
mkdir: memo-default
mkdir: memo-interpret
mkdir: computed-release
mkdir: computed-default
mkdir: computed-interpret
mkdir: copy-release
mkdir: copy-default
mkdir: copy-interpret
mkdir: views-release
mkdir: views-default
mkdir: views-interpret
step memo: jet run --release {root}/Examples/Memory/Memoize.jet
env: JET_STORE_DIR={work}/memo-release/cache
env: JETPACK_ROOT={work}/memo-release/jetpack
exit: 0
stdout: = ../../../Examples/Memory/Memoize.out
step: jet run {root}/Examples/Memory/Memoize.jet
env: JET_STORE_DIR={work}/memo-default/cache
env: JETPACK_ROOT={work}/memo-default/jetpack
exit: 0
stdout: = ../../../Examples/Memory/Memoize.out
stdout: == memo
step computed: jet run --release {root}/Examples/Memory/ComputedField.jet
env: JET_STORE_DIR={work}/computed-release/cache
env: JETPACK_ROOT={work}/computed-release/jetpack
exit: 0
stdout: = ../../../Examples/Memory/ComputedField.out
step: jet run {root}/Examples/Memory/ComputedField.jet
env: JET_STORE_DIR={work}/computed-default/cache
env: JETPACK_ROOT={work}/computed-default/jetpack
exit: 0
stdout: = ../../../Examples/Memory/ComputedField.out
stdout: == computed
step copy: jet run --release {root}/Examples/Memory/CopyVerb.jet
env: JET_STORE_DIR={work}/copy-release/cache
env: JETPACK_ROOT={work}/copy-release/jetpack
exit: 0
stdout: = ../../../Examples/Memory/CopyVerb.out
step: jet run {root}/Examples/Memory/CopyVerb.jet
env: JET_STORE_DIR={work}/copy-default/cache
env: JETPACK_ROOT={work}/copy-default/jetpack
exit: 0
stdout: = ../../../Examples/Memory/CopyVerb.out
stdout: == copy
step views: jet run --release {root}/Examples/Memory/Views/StringView.jet
env: JET_STORE_DIR={work}/views-release/cache
env: JETPACK_ROOT={work}/views-release/jetpack
exit: 0
stdout: = ../../../Examples/Memory/Views/StringView.out
step: jet run {root}/Examples/Memory/Views/StringView.jet
env: JET_STORE_DIR={work}/views-default/cache
env: JETPACK_ROOT={work}/views-default/jetpack
exit: 0
stdout: = ../../../Examples/Memory/Views/StringView.out
stdout: == views
