consume: fn(&&s: String) -> Int {
    s.len()
}

// Passed to a call that runs it once per item: the second item's run would
// move a value the first run already gave away.
each_item: fn() -> Int {
    s: "abc".repeat(3)
    [1, 2, 3].map(fn(x) { consume(s.move()) + x }).sum()
}

// Bound, then passed on: the binding's own calls are not the only ones.
passed_on: fn() -> Int {
    s: "abc".repeat(3)
    add: fn(acc: Int, x: Int) { acc + x + consume(s.move()) }
    [1, 2, 3].fold(0, add)
}

// Handed back: the caller may call it any number of times.
handed_back: fn() -> fn() -> Int {
    s: "abc".repeat(3)
    fn() { consume(s.move()) }
}

// Bound and only called directly: its one call is counted.
called_once: fn() -> Int {
    s: "abc".repeat(3)
    finish: fn() { consume(s.move()) }
    finish()
}

// Called where it is written: it runs once each time the call runs.
called_here: fn() -> Int {
    s: "abc".repeat(3)
    (fn() { consume(s.move()) })()
}

// A copy per run leaves the capture standing.
copies: fn() -> Int {
    s: "abc".repeat(3)
    [1, 2, 3].map(fn(x) { consume(s.copy()) + x }).sum()
}

// A task body runs once.
in_a_task: fn() {
    s: "abc".repeat(3)
    worker: task { consume(s.move()) }
    if worker.join() == {
        .Ok(n) -> print(n)
        .Err(_) -> print("failed")
    }
}

run: fn() {
    print(each_item() + passed_on() + handed_back()() + called_once() + called_here() + copies())
    in_a_task()
}
