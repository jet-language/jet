// D-DROP-ASAP1=A (#6392): a String is freed at its last use, not at the end
// of its scope. Each scenario holds one String of `size` bytes at a time when
// last use frees it, two when scope end does. Before each scenario the peak
// resident set (VmHWM) is reset to the current one (`5` to clear_refs); after
// it, the peak must stay below that start plus 1.5 strings. The size is read
// from STRING_BYTES while the program runs, so the strings are built, and
// freed, by the running program: a size the build knew would make them
// build-time constants, kept in the binary and never freed.
package: {
    name: "strings_free_at_their_last_use"
    authority: { allow: [Env, FS.Read, FS.Write] }
}

use {
    files: core.files
    sys: core.sys
}

string_bytes: fn() -> Int {
    text: sys.get("STRING_BYTES") ?? panic("STRING_BYTES is not set")
    Int.parse(text) ?? panic("STRING_BYTES is not a number: {text}")
}

status_kb: fn(field: String) -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

measure: fn(name: String, size: Int, scenario: fn(Int) -> Int) {
    files.write("/proc/self/clear_refs", "5") ?? panic("reset the peak resident set")
    start: status_kb("VmRSS:")
    print(scenario(size))
    grown: status_kb("VmHWM:") - start
    if grown * 2048 > size * 3 -> panic("{name}: peak grew {grown} kB, more than 1.5 strings of {size} bytes")
    print("{name}: one string live at the peak")
}

// The String a loop assigns is freed before the next one is built.
overwrite: fn(size: Int) -> Int {
    buf := "a".repeat(size)
    loop _ in 0..<4 {
        buf = "b".repeat(size)
    }
    buf.len()
}

// `big` is freed after `big.len()`, before `other` is built.
last_use: fn(size: Int) -> Int {
    big: "x".repeat(size)
    n: big.len()
    other: "y".repeat(size)
    n + other.len()
}

run: fn() {
    size: string_bytes()
    measure("overwrite", size, overwrite)
    measure("last use", size, last_use)
}
