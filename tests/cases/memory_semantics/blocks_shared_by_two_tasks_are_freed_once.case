# A counted block released by two threads is freed once, after both
# releases. The release with the owner count at 1 (the sole owner) stores
# the decrement without LOCK XADD. This guards that path when two tasks
# share a text and a list and race to drop them. The expected total is
# computed independently (node, the same formula). Every tier must print it.
fixture: blocks_shared_by_two_tasks_are_freed_once.fixture
env: NO_COLOR=1
step: jet build --release main.jet
exit: 0
step release: built
stdin: null
limit: time=120
exit: 0
stdout: = "24173378\n"
stderr: empty
step: jet build main.jet
exit: 0
step default: built
stdin: null
limit: time=120
exit: 0
stdout: = "24173378\n"
stderr: empty
step: jet run main.jet
stdin: null
limit: time=120
exit: 0
stdout: = "24173378\n"
stderr: empty
