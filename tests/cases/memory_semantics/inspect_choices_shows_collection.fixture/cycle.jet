#Policy(gc)
#[!Equatable, !Comparable]
Link: enum {
    End(Int)
    Next(Link)
}

// `first` and `second` point at each other and `first` is returned, so the
// module's collector keeps them.
promoted_cycle: fn() -> Link {
    first := Link.Next(Link.End(1))
    second := Link.Next(first)
    first = Link.Next(second)
    return first
}

run: fn() {
    cycle: promoted_cycle()
    print(cycle)
}
