# A lambda whose body moves a captured owner gives it away when it runs.
# Passed to a call, bound and passed on, or handed back, it may run again and
# use the value its first run gave away: E0121 at each move. A lambda bound
# and only called directly, one called where it is written, a task body and
# a copy per run stay legal.
fixture: lambdas_that_may_run_again_cannot_move_a_capture.fixture
env: NO_COLOR=1
step: jet check main.jet --json
exit: 1
json: stdout doc $.reports[?severity="error"] #= 3 # only the three repeatable lambdas
json: stdout doc $.reports[?code="E0121"] #= 3
json: stdout doc $.reports[?code="E0121"][0].line = 9 # passed to `map`
json: stdout doc $.reports[?code="E0121"][1].line = 15 # bound, then passed to `fold`
json: stdout doc $.reports[?code="E0121"][2].line = 22 # handed back
