
#Memo fn square(value: Int) -[]> Int { value * value }
fn run() {
    initial :: square.cache()
    print("{initial.hits},{initial.misses},{initial.size},{initial.bound}")
    print(square(7))
    print(square(7))
    final :: square.cache()
    print("{final.hits},{final.misses},{final.size},{final.bound}")
}
