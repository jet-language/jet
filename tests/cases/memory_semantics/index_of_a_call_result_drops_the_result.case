# An index read off a fresh call result (`make_rows(16)[3]`,
# `make_map(16)["key 3"]`) drops that result once the read is done. Before
# the fix the result was never dropped: the fixture's 40,000 reads per
# scenario grew the resident set by 100 MB to 520 MB on O0.
fixture: index_of_a_call_result_drops_the_result.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
limit: time=120
exit: 0
stdout: = index_of_a_call_result_drops_the_result.out
step: jet run -O1 main.jet
limit: time=120
exit: 0
stdout: = index_of_a_call_result_drops_the_result.out
step: jet run -O2 main.jet
limit: time=120
exit: 0
stdout: = index_of_a_call_result_drops_the_result.out
step: jet build -O2 main.jet
exit: 0
step aot: built
limit: time=120
exit: 0
stdout: = index_of_a_call_result_drops_the_result.out
