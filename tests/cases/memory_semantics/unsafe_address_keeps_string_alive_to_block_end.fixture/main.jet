// D-DROP-ASAP1=A: `label`'s last ordinary use is `label.len()`,
// but `mem.address_of(label)` inside #Unsafe keeps it alive until the block
// ends. The raw reads through the pointer see the live String.
use mem: core.mem

run: fn() {
    label: "drop".repeat(3)
    print(label.len())
    #Unsafe("label is live on this frame until this block ends") {
        address: mem.address_of(label)
        place: mem.Ptr<String>.from_addr(address)
        print(place.*.len())
        print(place.*)
    }
}
