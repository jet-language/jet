# A task capture moved into a `name: value` binding inside the task body checks clean,
# and the captured value closes exactly once on every tier.
fixture: a_task_capture_bound_by_name_in_its_body_closes_once.fixture
env: NO_COLOR=1
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = a_task_capture_bound_by_name_in_its_body_closes_once.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = a_task_capture_bound_by_name_in_its_body_closes_once.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = a_task_capture_bound_by_name_in_its_body_closes_once.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = a_task_capture_bound_by_name_in_its_body_closes_once.out
