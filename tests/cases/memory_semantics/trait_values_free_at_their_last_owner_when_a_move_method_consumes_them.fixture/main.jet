// #6727: a dynamic call of a method every implementation takes by move
// (`&&self`) consumes the trait value: a box with no other owner hands its
// payload to the implementation and is freed; a box another owner shares
// (a list element read) keeps its payload, the implementation gets its own
// copy, and the box loses an owner. The payload is ended once either way,
// and the freed boxes keep the resident set flat over the rounds.
package: {
    name: "trait_values_free_at_their_last_owner_when_a_move_method_consumes_them"
    authority: { allow: [FS.Read, IO] }
}

use files: core.files

Context: struct {
    id: Int
}

Sink: trait {
    finish: fn(&&self) -[]> Int
    peek: fn(self) -[]> Int
}

Worker: struct {
    context: Shared<Context>
    n: Int

    impl Sink {
        finish: fn(&&self) -[]> Int {
            self.n + 2
        }
        peek: fn(self) -[]> Int {
            self.n + 1
        }
    }
}

Holder: struct {
    sink: Sink
}

make: fn(s: Shared<Context>, n: Int) -> Sink {
    Worker{context: s.copy(), n: n}
}

// Grows more than this (kB) over the measured rounds: a leak.
GROWTH_KB: 8192

resident_kb: fn() -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with("VmRSS:") -> next
        loop field in line.slice(6, line.len()).trim().split(" ") {
            if field.len() > 0 -> return Int.parse(field.copy()) ?? panic("VmRSS field")
        }
    }
    panic("no VmRSS line")
}

rounds: fn(s: Shared<Context>, from: Int, to: Int) -> Int {
    total := 0
    loop i in from..<to {
        a: make(s, i)
        total += a.finish()
        total += make(s, 1).finish()
        h: Holder{sink: make(s, 2)}
        total += h.sink.finish()
    }
    total
}

consumed: fn(s: Shared<Context>) {
    a: make(s, 1)
    t: a.finish()
    h: Holder{sink: make(s, 2)}
    u: h.sink.finish()
    print("consumed {t} {u} {make(s, 3).finish()} live {s.strong_count()}")
}

popped: fn(s: Shared<Context>) {
    list := [Sink]{make(s, 1), make(s, 2)}
    k: list.pop() ?? make(s, 3)
    t: k.finish()
    print("popped {t} {list[0].peek()} live {s.strong_count()}")
}

run: fn() {
    s := Shared{Context{id: 1}}
    consumed(s)
    print("consumed dropped {s.strong_count()}")
    popped(s)
    print("popped dropped {s.strong_count()}")
    warm: 100000
    first: rounds(s, 0, warm)
    before: resident_kb()
    second: rounds(s, warm, 9 * warm)
    grown: resident_kb() - before
    if grown > GROWTH_KB -> panic("consumed boxes: resident set grew {grown} kB over {8 * warm} rounds")
    print("rounds flat, checksum {first + second}, dropped {s.strong_count()}")
}
