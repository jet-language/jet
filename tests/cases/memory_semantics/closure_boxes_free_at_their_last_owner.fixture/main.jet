// #5909: every closure box is counted and freed with its captures when its
// last owner ends. Each scenario runs `warm` rounds, reads the peak resident
// set (VmHWM), runs 8 * `warm` more rounds and reads it again: a box (or a
// capture) that outlives its last owner grows the peak with the round count.
// The checksums catch a box freed while an owner still calls it. #5918: a
// transaction hook whose body can fail drops the Result it returns.
package: {
    name: "closure_boxes_free_at_their_last_owner"
    authority: { allow: [Env, FS.Read, IO, Mem.Alloc, Time.Wait] }
}

use {
    event: core.event
    files: core.files
    scope: core.mem.scope
    os: core.sys
}

#Error
Reject: enum {
    Odd
}

Worker: struct {
    step: fn(Int) -> Int
}

// Grows more than this (kB) over the measured rounds: a leak.
GROWTH_KB: 8192

peak_kb: fn() -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with("VmHWM:") -> next
        loop field in line.slice(6, line.len()).trim().split(" ") {
            if field.len() > 0 -> return Int.parse(field.copy()) ?? panic("VmHWM field")
        }
    }
    panic("no VmHWM line")
}

measure: fn(name: String, scenario: fn(Int, Int) -> Int, warm: Int) {
    first: scenario(0, warm)
    before: peak_kb()
    second: scenario(warm, 9 * warm)
    grown: peak_kb() - before
    if grown > GROWTH_KB -> panic("{name}: peak RSS grew {grown} kB over {8 * warm} rounds")
    print("{name}: flat, checksum {first + second}")
}

add_one: fn(n: Int) -> Int { n + 1 }

apply: fn(f: fn(Int) -> Int, n: Int) -> Int { f(n) }

make_adder: fn(data: [Int], k: Int) -> fn(Int) -> Int { fn(n: Int) { n + k + data[k % 3] } }

each_checked: fn(values: [Int], handler: fn(Int) -> Int Reject!) -> Int {
    total := 0
    loop value in values {
        total += handler(value) ?? 1
    }
    total
}

by_value: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    name: "capture"
    total := 0
    loop i in from..<to {
        f: fn(x: Int) -> Int { x + data[x % 3] + name.len() }
        total += f(i)
    }
    total
}

by_write_var: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        count := 0
        apply(fn(x: Int) {
            count += x + data[x % 3]
            count
        }, i)
        total += count
    }
    total
}

named_value: fn(from: Int, to: Int) -> Int {
    total := 0
    loop i in from..<to {
        total += apply(add_one, i)
        f: add_one
        total += apply(f, i)
    }
    total
}

copied: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        f: fn(x: Int) -> Int { x + data[x % 3] }
        held: [fn(Int) -> Int]{f, fn(x: Int) { x * data[0] }}
        total += held[1](i) + held[0](i) + held.len()
    }
    total
}

in_struct: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        worker: Worker{step: fn(x: Int) { x + data[x % 3] }}
        total += worker.step(i)
    }
    total
}

returned: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        adder: make_adder(data, i)
        total += adder(1)
    }
    total
}

in_map: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        handlers: [String:fn(Int) -> Int]{"add": fn(x: Int) { x + data[x % 3] }, "one": fn(x: Int) { x + 1 }}
        f: handlers.get("add").or_err("missing add") ?? panic("missing add")
        total += f(i)
    }
    total
}

widened: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        name: "widened"
        checked: each_checked(data, fn(value: Int) { value + name.len() + i })
        total += checked
    }
    total
}

zipped: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        loop row in zip(a: data, b: data, c: data) -> total += row.a + row.c
        loop row in data.zip_pad([i], fill: 0) -> total += row.b
    }
    total
}

lazy_chain: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        mapped: data.lazy().map(fn(x: Int) { x + i }).filter(fn(x: Int) { x % 2 == 0 }).to_list()
        total += mapped.len()
        first: data[0]
        total += data.map(fn(x: Int) { x * first }).len()
        last: data[2]
        loop x in data.lazy().map(fn(x: Int) { x + last }).take(2) -> total += x
    }
    total
}

option_map: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        held: Int?{Val(i)}
        total += held.map(fn(x: Int) { x + data[x % 3] }) ?? 0
    }
    total
}

merge_with: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        left := [String:Int]{}
        left["k"] = i
        right := [String:Int]{}
        right["k"] = 2
        merged: left.merge(right, fn(key: String, a: Int, b: Int) { key.len() + a + b + data[0] })
        total += merged["k"]
    }
    total
}

tasks: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        handle: task data[i % 3] + i
        total += handle.join() ?? 0
    }
    total
}

guarded: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        guarded_round(data, i, total)
    }
    total
}

guarded_round: fn(data: [Int], i: Int, total: &Int) {
    _guard: scope.guard(fn() { total += data[i % 3] })
    total += 1
}

hooks: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        total += hooked(data, i) ?? 0
    }
    total
}

hooked: fn(data: [Int], i: Int) -> Int Reject! {
    #Transact(tx) {
        tx.on_commit(fn() { settle(data[i % 3]) })
        tx.on_rollback(fn() { settle(data[(i + 1) % 3]) })
        if i % 2 == 1 -> return Err(Reject.Odd)
    }
    Ok(i)
}

// The hooks' body: infallible, so a hook returns no Result box.
settle: fn(value: Int) Never! {
    if value > 3 -> panic("hook saw {value}")
}

fallible_hooks: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        total += fallible_hooked(data, i) ?? 0
    }
    total
}

fallible_hooked: fn(data: [Int], i: Int) -> Int Reject! {
    #Transact(tx) {
        tx.on_commit(fn() { note(data[i % 3]) })
        tx.on_rollback(fn() { note(data[(i + 1) % 3]) })
        if i % 2 == 1 -> return Err(Reject.Odd)
    }
    Ok(i)
}

// These hooks' body: it can fail, so each hook returns a Result box.
note: fn(value: Int) {
    if value > 3 -> print("hook saw {value}")
}

listened: fn(from: Int, to: Int) -> Int {
    data: [Int]{1, 2, 3}
    total := 0
    loop i in from..<to {
        app: event.scope()
        clicks: event.new<Int>()
        clicks.on(app, fn(n: Int) { settle(data[n % 3]) })
        total += clicks.emit(i % 7).delivered() + clicks.listener_count()
        app.cancel()
    }
    total
}

// A struct whose only field is a recursive edge: its wrapper box is a
// capture's own and is freed with the closure box.
CycleOnly: struct {
    ty: CycleShape
}

CycleShape: enum {
    Int
    Named(name: String)
    Other(items: [CycleOnly])
}

cycle_weight: fn(shape: CycleShape) -> Int {
    if shape == {
        .Int -> 1
        .Named(name) -> name.len()
        .Other(items) -> items.len()
    }
}

captures_cycle_struct: fn(from: Int, to: Int) -> Int {
    total := 0
    loop i in from..<to {
        x: CycleOnly{ty: CycleShape.Named{name: "n{i % 1000}"}}
        f: fn(n: Int) -> Int { n + cycle_weight(x.ty) }
        total += f(i)
    }
    total
}

run: fn() {
    // The exit queue owns this box until the process ends: one owner, run
    // once, then released (a double release would trap at exit).
    data: [Int]{1, 2, 3}
    #Unsafe("the exit callback only reads its captured List") {
        os.atexit(fn() { settle(data[0]) })
    }
    measure("capture by value", by_value, 400000)
    measure("capture by write var", by_write_var, 400000)
    measure("named fn value", named_value, 400000)
    measure("copied and listed", copied, 200000)
    measure("stored in a struct", in_struct, 400000)
    measure("returned from a fn", returned, 400000)
    measure("stored in a map", in_map, 100000)
    measure("widened fn value", widened, 100000)
    measure("zip adapters", zipped, 100000)
    measure("lazy and list adapters", lazy_chain, 100000)
    measure("option map", option_map, 400000)
    measure("map merge_with", merge_with, 100000)
    measure("sent to a task", tasks, 20000)
    measure("scope guard", guarded, 400000)
    measure("transaction hook", hooks, 200000)
    measure("fallible transaction hook", fallible_hooks, 200000)
    measure("event listener", listened, 50000)
    measure("captures a cycle struct", captures_cycle_struct, 400000)
}
