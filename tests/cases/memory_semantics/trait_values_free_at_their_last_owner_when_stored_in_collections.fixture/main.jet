// #6727: a trait value stored in a List, a Map, an Option or a struct is its
// holder's: a replaced element or entry ends at the store, a removed one is
// its taker's, and the rest end with the holder. Every payload's `Shared`
// context is released once, so the count is back to the caller's own when
// each scenario returns.
package: {
    name: "trait_values_free_at_their_last_owner_when_stored_in_collections"
    authority: { allow: [IO] }
}

Context: struct {
    id: Int
}

Sink: trait {
    finish: fn(&&self) -[]> Int
    peek: fn(self) -[]> Int
}

Worker: struct {
    context: Shared<Context>
    n: Int
}

impl Worker.Sink {
    finish: fn(&&self) -[]> Int {
        self.n + 2
    }
    peek: fn(self) -[]> Int {
        self.n + 1
    }
}

Rack: struct {
    sinks: [Sink]
    spare: Sink?
}

make: fn(s: Shared<Context>, n: Int) -> Sink {
    Worker{context: s.copy(), n: n}
}

listed: fn(s: Shared<Context>) {
    list := [Sink]{make(s, 1), make(s, 2)}
    list.push(make(s, 3))
    list[0] = make(s, 4)
    taken: list.pop() ?? make(s, 5)
    total := taken.peek()
    loop k in list -> total += k.peek()
    print("listed {total} {list.len()} live {s.strong_count()}")
}

mapped: fn(s: Shared<Context>) {
    map := [String:Sink]{"a": make(s, 1)}
    map["b"] = make(s, 2)
    map["a"] = make(s, 3)
    total := 0
    loop (_, k) in map -> total += k.peek()
    print("mapped {total} {map.len()} live {s.strong_count()}")
}

nested: fn(s: Shared<Context>) {
    rack := Rack{sinks: [Sink]{make(s, 1)}, spare: Val(make(s, 2))}
    rack.sinks.push(make(s, 3))
    rack.spare = Val(make(s, 4))
    racks: [Rack]{rack, Rack{sinks: [Sink]{}, spare: None}}
    print("nested {racks[0].sinks.len()} live {s.strong_count()}")
}

run: fn() {
    s := shared Context{id: 1}
    listed(s)
    print("listed dropped {s.strong_count()}")
    mapped(s)
    print("mapped dropped {s.strong_count()}")
    nested(s)
    print("nested dropped {s.strong_count()}")
}
