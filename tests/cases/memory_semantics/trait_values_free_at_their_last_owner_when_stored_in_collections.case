# #6727: a trait value stored in a List, a Map, an Option or a struct field
# is its holder's: a replaced element or entry ends at the store, a popped
# one is its taker's, and the rest end with the holder. Each payload's
# `Shared` context is released once on every tier.
fixture: trait_values_free_at_their_last_owner_when_stored_in_collections.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_stored_in_collections.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_stored_in_collections.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_stored_in_collections.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = trait_values_free_at_their_last_owner_when_stored_in_collections.out
