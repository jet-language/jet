// A borrowed value passed to a read parameter inside a carrier built at the
// call (`Val(x)`, `Ok(x)`, a tuple literal) is lent to the call (#6677).
// Before the fix the carrier took the value over: the holder gave up its
// Directory and disarmed its close, and nothing closed it after the call, so
// it leaked open past its scope. A borrowed Directory, a Folder holding one,
// and that Folder as a `Named?` trait value, each passed twice, stay open
// across both calls and close once, when their scope ends.
package: {
    name: "carrier_argument_is_lent_not_moved"
    authority: { allow: [FS, FS.Read, FS.Write, IO] }
}

use files: core.files

Named: trait {
    label: fn(self) -[]> String
}

Folder: struct {
    directory: Directory

    impl Named {
        label: fn(self) -[]> String { "folder" }
    }
}

maybe_directory: fn(item: Directory?) -> String {
    if item == .Val(_) -> "directory" else -> "none"
}

maybe_folder: fn(item: Folder?) -> String {
    if item == .Val(_) -> "folder" else -> "none"
}

maybe_named: fn(item: Named?) -> String {
    found: item ?? return "none"
    found.label()
}

opened: fn(item: Directory IOError!) -> String {
    if item == .Ok(_) -> "ok" else -> "err"
}

numbered: fn(item: (directory: Directory, number: Int)) -> Int { item.number }

// The descriptor this process holds `name` open at (Linux /proc), or -1.
own_number: fn(name: String) -[FS.Read]> Int {
    loop number in 3..<256 {
        if files.read_link("/proc/self/fd/{number}") == .Ok(target) {
            if target.ends_with("/{name}") -> return number
        }
    }
    -1
}

// Each holder, and the directory it holds, drops when its function returns.
directory_twice: fn(path: String) -[FS, IO]> Int {
    directory: files.open_directory(path)
    open_at: own_number("held")
    print("Directory?: {maybe_directory(Val(directory))}, {maybe_directory(Val(directory))}, open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

folder_twice: fn(path: String) -[FS, IO]> Int {
    folder: Folder{directory: files.open_directory(path)}
    open_at: own_number("held")
    print("Folder?: {maybe_folder(Val(folder))}, {maybe_folder(Val(folder))}, open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

named_twice: fn(path: String) -[FS, IO]> Int {
    folder: Folder{directory: files.open_directory(path)}
    open_at: own_number("held")
    print("Named?: {maybe_named(Val(folder))}, {maybe_named(Val(folder))}, open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

result_twice: fn(path: String) -[FS, IO]> Int {
    directory: files.open_directory(path)
    open_at: own_number("held")
    print("Result: {opened(Ok(directory))}, {opened(Ok(directory))}, open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

tuple_twice: fn(path: String) -[FS, IO]> Int {
    directory: files.open_directory(path)
    open_at: own_number("held")
    print("tuple: {numbered((directory: directory, number: 1))}, {numbered((directory: directory, number: 2))}, open after both calls: {open_at >= 0 && own_number("held") == open_at}")
    open_at
}

run: fn() {
    scratch: files.temp_dir("carrier-lend")
    held_path: files.join(scratch.path, "held")
    files.create_dir_all(held_path)
    directory_twice(held_path)
    print("Directory? closed once, at its scope end: {own_number("held") == -1}")
    folder_twice(held_path)
    print("Folder? closed once, at its scope end: {own_number("held") == -1}")
    named_twice(held_path)
    print("Named? closed once, at its scope end: {own_number("held") == -1}")
    result_twice(held_path)
    print("Result closed once, at its scope end: {own_number("held") == -1}")
    tuple_twice(held_path)
    print("tuple closed once, at its scope end: {own_number("held") == -1}")
}
