# A value passed to a read parameter of a union type is lent to the call
# (#6677). Before the fix, the union box took the value over: a borrowed
# Directory was moved into the box and closed when the box dropped after the
# first call, and a borrowed String was copied into the box on every call.
# The checked allocator traps a double free or a use after free.
fixture: union_argument_is_lent_not_copied.fixture
env: NO_COLOR=1
step: jet run --checked-alloc --optimize=none main.jet
exit: 0 # o0
stdout: = union_argument_is_lent_not_copied.out # o0
step: jet run --checked-alloc --optimize=basic main.jet
exit: 0 # o1
stdout: = union_argument_is_lent_not_copied.out # o1
step: jet run --checked-alloc --optimize=full main.jet
exit: 0 # o2
stdout: = union_argument_is_lent_not_copied.out # o2
step: jet run --optimize=none main.jet
exit: 0
stdout: = union_argument_is_lent_not_copied.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = union_argument_is_lent_not_copied.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = union_argument_is_lent_not_copied.out
