# A Map or Set builtin that only reads a fresh call result (`len`, `get`,
# `has_key`, `keys`, `values`, `has`, `to_list`) drops that result once the
# read is done. Before the fix the result was never dropped: the fixture's
# 40,000 calls per scenario grew the resident set by 80 MB to 100 MB on O0.
fixture: map_or_set_method_on_a_call_result_drops_it.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
limit: time=120
exit: 0
stdout: = map_or_set_method_on_a_call_result_drops_it.out
step: jet run --optimize=basic main.jet
limit: time=120
exit: 0
stdout: = map_or_set_method_on_a_call_result_drops_it.out
step: jet run --optimize=full main.jet
limit: time=120
exit: 0
stdout: = map_or_set_method_on_a_call_result_drops_it.out
step: jet build --optimize=full main.jet
exit: 0
step aot: built
limit: time=120
exit: 0
stdout: = map_or_set_method_on_a_call_result_drops_it.out
