// Every JSON string a decode reads is freed with what holds it. Each round
// decodes 20,000 records of three strings each: typed into a struct that skips
// them, typed into fields that hold them, and parsed into a Dyn tree. A leaked
// string keeps about 32 bytes resident, about 38 MB over a scenario's rounds,
// so the resident set may grow by at most 8 MB across a scenario.
package: {
    name: "json_strings_free_after_a_decode"
    authority: { allow: [FS.Read] }
}

use {
    files: core.files
    json: core.encoding.json
}

RECORDS: 20000
ROUNDS: 20
GROWTH_LIMIT_KB: 8192

Key: struct {
    id: Int
}

Person: struct {
    id: Int
    name: String
    tags: [String]
}

status_kb: fn(field: String) -> Int {
    status: files.read("/proc/self/status") ?? panic("read /proc/self/status")
    loop line in status.split("\n") {
        if !line.starts_with(field) -> next
        loop part in line.slice(field.len(), line.len()).trim().split(" ") {
            if part.len() > 0 -> return Int.parse(part.copy()) ?? panic("{field} field")
        }
    }
    panic("no {field} line")
}

skipped: fn(text: String) -> Int {
    keys: json.decode<[Key]>(text) ?? panic("typed decode skipping strings")
    keys.len()
}

held: fn(text: String) -> Int {
    people: json.decode<[Person]>(text) ?? panic("typed decode reading strings")
    count := 0
    loop person in people -> count += person.name.count_bytes() + person.tags.len()
    count
}

parsed: fn(text: String) -> Int {
    tree: json.parse(text) ?? panic("Dyn parse")
    if tree == .Array(items) -> return items.len()
    panic("not a list")
}

measure: fn(name: String, text: String, scenario: fn(String) -> Int) {
    total := scenario(text)
    start: status_kb("VmRSS:")
    loop _ in 1..<ROUNDS -> total += scenario(text)
    grown: status_kb("VmRSS:") - start
    if grown > GROWTH_LIMIT_KB -> panic("{name}: the resident set grew {grown} kB over {ROUNDS} rounds")
    print("{name}: {total}, the strings freed")
}

run: fn() {
    parts := ["["]
    loop i in 0..<RECORDS {
        comma: if i == 0 -> "" else -> ","
        parts.push("{comma}{{\"id\":{i},\"name\":\"user{i}\",\"tags\":[\"t{i %% 5}\",\"t{i %% 7}\"]}}")
    }
    parts.push("]")
    text: parts.join("")
    measure("skipped", text, skipped)
    measure("held", text, held)
    measure("parsed", text, parsed)
}
