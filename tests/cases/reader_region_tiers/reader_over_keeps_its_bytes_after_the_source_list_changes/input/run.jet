// Reader.over takes the bytes as a value: writes to the source list after
// the reader exists never show through it, and the bytes `take` returns are
// their own list.
fn run() {
    payload := [U8]{1, 2, 3, 4, 5, 6}
    reader :: Reader.over(payload)
    payload[0] = 9
    payload[3] = 9
    &payload.push(7)
    first :: reader.read_u8() ?? panic("short first")
    field := &reader.take(3) ?? panic("short field")
    payload[1] = 8
    field[0] = 0
    rest :: &reader.take(2) ?? panic("short rest")
    print(first)
    print(field)
    print(rest)
    print(reader.remaining())
    print(payload)
}
