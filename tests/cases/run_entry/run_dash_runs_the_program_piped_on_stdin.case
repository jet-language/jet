# Claim: `jet run -` runs the program piped on standard input, with
# the words after `-` as its arguments, and a rerun of the same source reuses
# its entry file. Piped source gets the effect notice the same program gets as
# a file: every effect is allowed, so a program that writes files runs, and before it
# runs stderr names the write, calling the piped source "the program on
# standard input", not the cache entry; `--allow`/`-A` acknowledge it.
fixture: run_dash_runs_the_program_piped_on_stdin.fixture
env: NO_COLOR=1
env: XDG_CACHE_HOME={work}/cache
env: JET_STORE_DIR={work}/store
step: jet run -
stdin: hello.jet
exit: 0
stdout: = "hi\n"
stderr: = ""
step args: jet run - one two
stdin: args.jet
exit: 0
stdout: = "one two\n"
stderr: = ""
step rerun: jet run -
stdin: hello.jet
exit: 0
stdout: = "hi\n"
stderr: = ""
entries: cache/jet/scripts/stdin = 2
step file_noticed: jet run write.jet
exit: 0
stdout: = "wrote\n"
stderr: = "note: write.jet writes files (-A hides this)\n"
file: written.txt = "piped"
remove: written.txt
step piped_noticed: jet run -
stdin: write.jet
exit: 0
stdout: = "wrote\n"
stderr: = "note: the program on standard input writes files (-A hides this)\n"
file: written.txt = "piped"
remove: written.txt
step piped_allowed: jet run --allow=FS.Write -
stdin: write.jet
exit: 0
stdout: = "wrote\n"
stderr: = ""
file: written.txt = "piped"
remove: written.txt
step piped_allow_all: jet run -A -
stdin: write.jet
exit: 0
stdout: = "wrote\n"
stderr: = ""
file: written.txt = "piped"
