# Claim: jet tells a file's language by its extension. `jet run`,
# `jet build` and the `jet <file>` shorthand compile a C (`.c`) or C++ (`.cc`,
# `.cpp`, `.cxx`) file with the C toolchain Jet programs compile their own C
# with, link it and run it, with no flag: the program's output and exit code
# are the command's. `jet build` leaves the program at `.jet/build/<stem>`.
# A file the compiler rejects exits 1 with the compiler's own report. Any
# other extension is refused with E2116, which names the extensions the
# command takes; it is never read as Jet source. A `#!` script that names jet
# is Jet source whatever its name, as the kernel runs it with jet.
fixture: c_and_cpp_files_run_by_extension.fixture
env: NO_COLOR=1
step: jet run hello.c
exit: 3
stdout: = "hello from C\n"
stderr: = ""
step: jet run hello.c one two
exit: 3
stdout: = "hello from C\none\ntwo\n"
stderr: = ""
step: jet hello.c --flag
exit: 3
stdout: = "hello from C\n--flag\n"
stderr: = ""
step: jet build hello.c
exit: 0
stdout: = ""
stderr: = ""
file: .jet/build/hello is-file
step: built
exit: 3
stdout: = "hello from C\n"
step: jet run shapes.cpp
exit: 0
stdout: = "twice 42, count 2\n"
stderr: = ""
step: jet build --release shapes.cpp
exit: 0
stdout: = ""
stderr: = ""
step: built
exit: 0
stdout: = "twice 42, count 2\n"
step: jet run broken.c
exit: 1
stdout: = ""
stderr: ~ "broken.c:2:12: error:" # the C compiler's own report, whose wording is the compiler's
file: .jet/build/broken absent
step: jet run notes.txt
exit: 2
stdout: = ""
stderr: = ../../cli/unhandled_extension_e2116.txt
step: jet notes.txt
exit: 2
stderr: = ../../cli/unhandled_extension_e2116.txt
step: jet run deploy.task
exit: 0
stdout: = "deploy script\n"
stderr: = ""
step: jet check hello.c
exit: 2
stdout: = ""
stderr: ~ "`jet check` doesn't handle `.c` files like `hello.c`" # check takes Jet source alone
stderr: ~ "`jet check` takes `.jet`." # and names it
step: jet run --verbose hello.c
exit: 2
stdout: = ""
stderr: ~ "`jet run hello.c` compiles C, which takes no `--verbose`" # Jet's own flags don't apply to C
