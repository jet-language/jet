// A file of top-level statements is a program: every top-level line runs
// in order, and its bindings are that program's locals.
print("first")
limit: 3
total := 0
loop n in 0..<limit -> total += n + 1
print("total {total}")
print(greet("jet"))
add := (x: Int) -> x + total
print("add {add(4)}")
greet: fn(name: String) -> String { "hi {name}" }
