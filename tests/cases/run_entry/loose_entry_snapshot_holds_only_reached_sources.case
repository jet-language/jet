# Claim (#6750): a loose entry (a `.jet` file in a folder with no
# `package.jet`) runs from a snapshot of the entry and the sources it
# reaches, not of every source under its folder. tests/main.jet reaches
# tests/lib/helper.jet, tests/lib/inner.jet (through helper) and
# tests/util.jet (a module import). Nothing reaches the dangling symlink
# tests/stray.jet, the unreadable tests/locked/secret.jet or the 50000
# sources under tests/bulk/, so none of them refuses the run or costs it
# time. A reached source still has to be a regular file: tests/linked_user.jet
# imports stray.jet and is refused with E2105.
fixture: loose_entry_snapshot_holds_only_reached_sources.fixture
requires: os:unix
symlink: nowhere.jet tests/stray.jet
chmod: tests/locked/secret.jet 0000
env: NO_COLOR=1
step: jet run tests/main.jet
exit: 0
stdout: = "42 hi\n"
stderr: = ""
step: jet run main.jet
cwd: tests
exit: 0
stdout: = "42 hi\n"
stderr: = ""
step: jet run tests/linked_user.jet
exit: 1
stdout: = ""
stderr: ~ "stray.jet` is a symbolic link" # the refusal names the reached link; the report also carries machine paths
stderr: ~ "jet.DriverOperationFailed" # E2105
step: sh bulk.sh
exit: 0
step cold: jet run tests/main.jet
exit: 0
stdout: = "42 hi\n"
step warm: jet run tests/main.jet
exit: 0
stdout: = "42 hi\n"
stderr: = ""
# A warm run of an entry that reaches three sources doesn't read the 50000
# under tests/bulk/. Before #6750 it read and hashed every one of them on
# each run: 15 to 99 seconds for 50000 2 KB sources, against 7 to 17 ms now.
elapsed: warm < 1000ms
