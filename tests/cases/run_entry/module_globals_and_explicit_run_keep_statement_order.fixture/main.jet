
LIMIT :: 2
LABEL :: "start"
my_var := 3

fn run() {
    print(LABEL)
    print(LIMIT)
    my_var += LIMIT
    print(my_var)
    print(even(LIMIT + 2))
    print("end")
}

fn even(n: Int) -> Bool {
    return if n == 0 -> true else -> odd(n - 1)
}

fn odd(n: Int) -> Bool {
    return if n == 0 -> false else -> even(n - 1)
}
