struct Count { value: Int }

LIMIT :: 2
LABEL :: "start"
MY_VAR :: shared Count{value: 3}

fn run() {
    print(LABEL)
    print(LIMIT)
    MY_VAR.value += LIMIT
    print(MY_VAR.value)
    print(even(LIMIT + 2))
    print("end")
}

fn even(n: Int) -> Bool {
    return if n == 0 -> true else -> odd(n - 1)
}

fn odd(n: Int) -> Bool {
    return if n == 0 -> false else -> even(n - 1)
}
