# Docs/spec/reference/cli.md: a kept `jet run` program's record names the file identity of
# each Core source file its compile read, so a rerun after one of them changes compiles
# again. Here the edit breaks `Core/Text/Text.jet`, which the program imports, so the rerun
# that compiles again fails on it instead of running the kept program.
env: NO_COLOR=1
env: XDG_CACHE_HOME={work}/cache
env: JET_STORE_DIR={work}/store
requires: os:unix
fixture: run-core-row.fixture
copy: {root}/Core tree/Core
copy: {root}/Compiler/Prelude tree/Compiler/Prelude
step first: jet run tree/app/words.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "3\n"
entries: cache/jet/scripts name $= ".run" = 1 # the compile kept its program
step kept: jet run tree/app/words.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "3\n"
concat: tree/Core/Text/Text.jet tree/Core/Text/Text.jet broken.txt
step changed: jet run tree/app/words.jet
unset: JET_TOOLCHAIN_ROOT
exit: 1
stdout: = ""
stderr: ~ "Text.jet" # the compile reports the broken Core file; the rest names the work directory
