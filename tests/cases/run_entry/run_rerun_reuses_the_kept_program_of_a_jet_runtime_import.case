# Docs/spec/reference/cli.md: a kept `jet run` program's record names each Core source
# jet supplies as text (the jet.runtime interface modules, which have no file in the
# toolchain tree) by the SHA-256 of that text, so a program that imports jet.runtime.time
# is kept and its rerun reuses it. The rerun runs after an unread Core file is removed:
# a compile would refuse the missing file up front, so only the kept program can run.
env: NO_COLOR=1
env: XDG_CACHE_HOME={work}/cache
env: JET_STORE_DIR={work}/store
requires: os:unix
fixture: run-runtime-interface-row.fixture
copy: {root}/Core tree/Core
copy: {root}/Compiler/Prelude tree/Compiler/Prelude
step first: jet run --allow=Time tree/app/clock.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "true\n"
entries: cache/jet/scripts name $= ".run" = 1 # the compile kept its program
remove: tree/Core/Db/Db.jet
step kept: jet run --allow=Time tree/app/clock.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout: = "true\n"
entries: cache/jet/scripts name $= ".run" = 1 # the rerun reused that slot
