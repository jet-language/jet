
use a

build: fn(b: Build) -[Exec]> {
    #Impure("member b records its realized package") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("b-order", b.found(shell), ["Exec"])
        action.arg("-c")
        action.arg("printf 'b_ready: fn() -> Int {{ 1 }}' > b/b.jet")
        action.writes("b/b.jet")
        target: b.add_library("b", ["run.jet"], [action])
        b.default(target)
    }
}
run: fn() {}
