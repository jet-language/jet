package {
name: "inline-parity"
version: "1.2.3"
jet: ">=0.1.0"
edition: "2026"
description: "one source of package facts"
license: "MIT"
repository: "https://example.test/inline-parity"
deps: { dep: ./deps/dep }
outputs: { app: .Executable{ name: "app", entry: run } }
defaults: { run: app }
authority: { allow: [IO] }
policy: { unsafe: .Deny }
}
use dep

fn run() {
    print(dep.value())
}
