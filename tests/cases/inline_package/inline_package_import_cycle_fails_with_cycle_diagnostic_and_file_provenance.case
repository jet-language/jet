fixture: fixtures/inline_package_import_cycle_fails_with_cycle_diagnostic_and_file_provenance
write: workspace.jet = "workspace: module { members: [] }\n"
step: jet check run.jet --json
env: JET_STORE_DIR={work}/cache-0
env: JET_PACKAGE_STORE_DIR={work}/store-0
env: JETPACK_ROOT={work}/jetpack-0
env: JETPACK_ENV=1
env: NO_COLOR=1
exit: nonzero
# One package is one namespace: its files never import each other by path,
# so the first file import in the carrier is refused before any cycle forms.
json: machine doc $.reports[0].code = "E0623"
json: machine doc $.reports[0].file = "run.jet"
json: machine doc $.reports[0].line = 2
file: run.jet = "package: { name: \"cycle\" version: \"0.1.0\" }\nuse \"a\"\nrun: fn() {}\n"
file: a.jet = "use \"run\"\na: fn() {}\n"
