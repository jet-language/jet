// The leading inline package block acknowledges the network rights
// (spec.md:1782-1787), so the run's effect notice names nothing.
package: {
    name: "run"
    authority: { allow: [Net] }
}
use web: core.web
use server: core.http.server

run: fn() {
    mux: web.app()
    // A fallible call propagates when bound with `:` (S7, Docs/spec/syntax-decisions.md:1843-1844),
    // so the outcome is matched on the call itself. Variant patterns take a leading `.`
    // (D-ENUMDOT1, Docs/spec/syntax-decisions.md:858; E0367 without it).
    if mux.bind("127.0.0.1:999999", tls: server.tls("not a cert", "not a key")) == {
        .Ok(_) -> { print("unexpected") }
        .Err(e) -> { print(e) }
    }
}
