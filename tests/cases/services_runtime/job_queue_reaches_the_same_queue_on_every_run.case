# D-DX-QUEUE1=A: durable jobs need no service setup. The queue binds to the
# package endpoint, whose private authority file sits beside the database, so a
# second run of the program sees the job the first run queued.
fixture: job_queue_reaches_the_same_queue_on_every_run.fixture
env: NO_COLOR=1
env: JET_JOB_QUEUE_DB={work}/state/jobs.db
step: jet run main.jet
exit: 0
stdout: = "before:0\nafter:1\n"
step: jet run main.jet
exit: 0
stdout: = "before:1\nafter:2\n"
# The authority secret is created owner-only.
step: stat -c %a state/jobs.db.authority
exit: 0
stdout: ~ "600" # stat prints the permission bits; group and other get none
