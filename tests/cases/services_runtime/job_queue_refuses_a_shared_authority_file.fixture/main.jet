use jobs: core.jobs

#Job(.Dev) process: fn(payload: String) { print("job:{payload}") }

run: fn() {
    if jobs.queue() == {
        .Err(error) -> {
            print("refused: {error}")
            return
        }
        .Ok(_) -> {}
    }
    queue := jobs.queue() ?? return
    before: queue.inspect(16, true) ?? return
    print("before:{before.len()}")
    queue.enqueue(process, "run", key: "run-{before.len()}") ?? return
    after: queue.inspect(16, true) ?? return
    print("after:{after.len()}")
}
