// tests/jetpack_hangar_store_v2.rs:1715-1782 setup and footprint rule.
// `payloads` writes one payload per quota fixture (rs:1728-1734).
// `ceiling` writes footprint - 2 MiB to root/config/hangar-max-bytes and to
// `limit` (rs:1764-1772); `check` stops when the Hangar is above it (rs:1775-1778).
// The footprint is the Rust logical_bytes: the lstat size of every non-directory.
use files: core.files
use process: core.process

quota_payload: fn(path: String, byte: U8, count: Int) {
    payload := [U8]{}
    loop _ in 0..<count -> payload.push(byte)
    files.create_dir_all(files.dirname(path)) ?? panic("mkdir {path}")
    files.write_bytes(path, payload) ?? panic("write {path}")
}

quota_logical_bytes: fn(path: String) -> Int {
    metadata: files.stat(path) ?? panic("metadata {path}")
    if !metadata.is_dir || metadata.is_symlink -> return metadata.size
    total := 0
    loop entry in files.list_dir(path) ?? panic("entries {path}") {
        total += quota_logical_bytes(entry.path)
    }
    total
}

run: fn() {
    mode: process.args()[0]
    if mode == "payloads" {
        quota_payload("quota-source-oldest/payload", U8{97}, 4194304)
        quota_payload("quota-source-newer/payload", U8{98}, 4194304)
        quota_payload("quota-source-admitted/payload", U8{99}, 65536)
    } else if mode == "ceiling" {
        limit: quota_logical_bytes("root/hangar") - 2097152
        files.create_dir_all("root/config") ?? panic("mkdir root/config")
        files.write("root/config/hangar-max-bytes", "{limit}\n") ?? panic("write ceiling")
        files.write("limit", "{limit}\n") ?? panic("write limit")
    } else if mode == "check" {
        text: files.read("limit") ?? panic("read limit")
        limit: Int.parse(text.trim()) ?? panic("limit {text}")
        after: quota_logical_bytes("root/hangar")
        if after > limit -> panic("quota admitted {after} logical bytes above ceiling {limit}")
    } else {
        panic("unknown mode {mode}")
    }
}
