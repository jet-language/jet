# tests/jetpack_hangar_store_v2.rs::hangar_du_rejects_corrupt_output_projection_without_following_escape at tests/jetpack_hangar_store_v2.rs:1582; hand-port
# Claim: du --json on the corrupt projection exits 2 with a jet.report/v3 finding (Rust asserted v1; REPORT_SCHEMA is now v3), moment compile, code E1340 and no stderr (rs:1627-1650)
# Claim: the real output stays a directory under the root and the outside bytes survive (rs:1651-1656)
# Claim: recover --json exits 0 with a jet.status/v1 result (Rust's jet.report/v1 command result is now STATUS_SCHEMA) with action recover, restores meta.json and leaves the outside bytes (rs:1658-1678)
# Fixture migrated: [INFERENCE] source payload and ingest --ref flag taken from the find_by_reference name du-proof@fixture (rs:1613); source file not read
# The setup after the ingest is the Rust in-place corruption (rs:1609-1625): meta.json `out` rewritten to {work}/outside, closure journal moved aside.
fixture: hangar_du_rejects_corrupt_output_projection_without_following_escape.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jetpack hangar ingest source --name du-proof --ref du-proof@fixture --no-color
exit: 0 # rs:1588-1607 exit 0
# rs:1609-1625 point the entry's output projection at an outside directory and hide the closure journal
capture: entry = sole-entry jetpack/hangar kind dir name ^= "du-proof-"
chmod: {cap:entry} 0755
chmod: {cap:entry}/meta.json 0644
write: outside/must-survive = "outside bytes"
capture: out file {cap:entry}/meta.json doc $.out
copy: {cap:entry}/meta.json meta.original
capture: forged = text file.replace("{cap:out}", "{work}/outside") {cap:entry}/meta.json
write: {cap:entry}/meta.json = "{cap:forged}"
file: {cap:entry}/meta.json ~ "\"out\": \"{work}/outside\"" # the projection now names the outside directory
rename: jetpack/hangar/closure-db/journal jetpack/hangar/closure-db/journal.corrupt-backup
step: jetpack hangar du --json --no-color
exit: 2 # rs:1627-1650
stdout: ~ "\"schema\":\"jet.report/v3\"" # rs:1627-1650
stdout: ~ "\"moment\":\"compile\"" # rs:1627-1650
stdout: ~ "\"code\":\"E1340\"" # rs:1627-1650
stderr: empty # rs:1641-1645 JSON failure leaks no stderr
rename: jetpack/hangar/closure-db/journal.corrupt-backup jetpack/hangar/closure-db/journal # rs:1633 restore the journal
cap:out: ^= "{work}/jetpack/" # rs:1651-1656 the real output stays under the root
file: {cap:out} is-dir # rs:1651-1656 the real output is intact
file: outside/must-survive = "outside bytes" # rs:1651-1656 the outside bytes survive
step: jetpack hangar recover --json --no-color
exit: 0 # rs:1658-1673
stdout: ~ "\"schema\":\"jet.status/v1\"" # rs:1658-1673
stdout: ~ "\"action\":\"recover\"" # rs:1658-1673
stderr: empty # rs:1669 JSON repair leaks no stderr
file: {cap:entry}/meta.json == meta.original # rs:1674-1678 recover restores the original projection
file: outside/must-survive = "outside bytes" # rs:1674-1678 the outside bytes survive
