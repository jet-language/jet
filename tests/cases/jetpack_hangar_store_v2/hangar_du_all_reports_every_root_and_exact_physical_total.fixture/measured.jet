// tests/jetpack_criterion4.rs:16-30 measured_bytes over the shared CAS and
// both hangars: the allocated bytes (st_blocks * 512) of every entry, each
// inode once, the directories included.
use files: core.files

measured_bytes: fn(path: String, seen: &[files.FileID]) -> Int {
    metadata: files.stat(path) ?? panic("metadata {path}")
    loop id in seen {
        if id.device == metadata.id.device && id.inode == metadata.id.inode -> return 0
    }
    seen.push(metadata.id)
    total := metadata.size_on_disk
    if metadata.is_dir && !metadata.is_symlink {
        loop entry in files.list_dir(path) ?? panic("entries {path}") {
            total += measured_bytes(entry.path, seen)
        }
    }
    total
}

run: fn() {
    seen := [files.FileID]{}
    total := 0
    loop root in ["shared-cas", "jet-omp/hangar", "jet-omp2/hangar"] -> total += measured_bytes(root, seen)
    print(total)
}
