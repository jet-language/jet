# Card #3173 c23 and c20: the backend starter's deployment builds its service,
# runs the produced artifact (not `jet run`), probes it until it reports ready,
# serves a client built from the same workspace, and stops it with SIGTERM:
# the service stops accepting, answers what it accepted and exits 0. The starter
# ships no credential, so without one the artifact refuses to start; a
# restart on the same state directory keeps its data, because migrations
# only add.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
copy: {root}/Examples/Network/BackendStarter starter
step: jet build starter/Packages/Service
exit: 0
step: jet build starter/Packages/Client
exit: 0
copy: starter/Packages/Service/.jet/build/run order-service
copy: starter/Packages/Client/.jet/build/run order-client

step refuses: {work}/order-service
env: BACKEND_STATE_DIR={work}/state
exit: 78
stderr: ~ "BACKEND_OPERATOR_PASSWORD must carry the operator credential" # it names the missing secret
stdout: !~ "ready" # it never reports ready

spawn service: {work}/order-service
env: BACKEND_ADDR=127.0.0.1:{free-port:service}
env: BACKEND_STATE_DIR={work}/state
env: BACKEND_OPERATOR_PASSWORD=case-credential-0123456789
stdout: file service.stdout
stderr: file service.stderr
poll ready: {work}/order-client health until exit: 0 && stdout: ~ "service orders/v1 is ok" timeout 60s every 50ms # the deployment's readiness probe
env: BACKEND_URL=http://127.0.0.1:{free-port:service}
step client: {work}/order-client
env: BACKEND_URL=http://127.0.0.1:{free-port:service}
env: BACKEND_PASSWORD=case-credential-0123456789
exit: 0
stdout: = "client orders/v1: service orders/v1 is ok\norder 1: 2 x book under orders/v1 (201)\n"
step intruder: {work}/order-client
env: BACKEND_URL=http://127.0.0.1:{free-port:service}
env: BACKEND_PASSWORD=not-the-credential-0123456789
exit: 1
stderr: ~ "login refused: 401" # a wrong credential gets no session
signal service: TERM
wait: service timeout 30s
exit: 0
file: service.stdout ~ "migrations: orders-v1 applied=1\nready orders/v1 http://127.0.0.1:" # the first start applies the migration, then reports ready
file: service.stdout ~ " unanswered=0\n" # every accepted request was answered before exit

spawn restarted: {work}/order-service
env: BACKEND_ADDR=127.0.0.1:{free-port:service}
env: BACKEND_STATE_DIR={work}/state
env: BACKEND_OPERATOR_PASSWORD=case-credential-0123456789
stdout: file restarted.stdout
stderr: file restarted.stderr
poll ready_again: {work}/order-client health until exit: 0 && stdout: ~ "service orders/v1 is ok" timeout 60s every 50ms # the deployment's readiness probe
env: BACKEND_URL=http://127.0.0.1:{free-port:service}
step again: {work}/order-client
env: BACKEND_URL=http://127.0.0.1:{free-port:service}
env: BACKEND_PASSWORD=case-credential-0123456789
exit: 0
stdout: ~ "order 2: 2 x book under orders/v1 (201)" # the order from the first run survived the restart
signal restarted: TERM
wait: restarted timeout 30s
exit: 0
file: restarted.stdout ~ "migrations: orders-v1 applied=0" # a restart applies nothing again
file: restarted.stdout ~ " unanswered=0\n" # every accepted request was answered before exit
