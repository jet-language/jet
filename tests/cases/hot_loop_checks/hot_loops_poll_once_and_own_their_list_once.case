# Hot loops keep only the checks they need once calls are inlined. A stop
# poll that checks no call folds into the next one, so `step`'s three
# inlined Vec3 operators keep one poll between them (`jet inspect decisions`
# prints the slot IR before and after the passes: three polls, then one).
# At O2 a `&` list parameter is made the function's own once, before the
# loop writing it, rather than on every write; the caller's other copy of
# the list keeps its values on every tier.
fixture: hot_loops_poll_once_and_own_their_list_once.fixture
env: NO_COLOR=1
step: jet inspect decisions main.jet
env: JET_OPT_DUMP=step
exit: 0
stdout: ~ "O1:" # the default build runs the O1 passes
stdout: count "jet_ir_stop_poll" = 4 # three polls before the passes, one after
step: jet inspect decisions --release main.jet
env: JET_OPT_DUMP=step
exit: 0
stdout: ~ "O2:" # --release runs the O2 passes
stdout: count "jet_ir_stop_poll" = 4 # three polls before the passes, one after
step: jet inspect decisions --release main.jet
exit: 0
stdout: ~ "unique hoisted 1," # bump's list is made its own once, before its loop
step: jet run --optimize=none main.jet
exit: 0
stdout: = hot_loops_poll_once_and_own_their_list_once.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = hot_loops_poll_once_and_own_their_list_once.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = hot_loops_poll_once_and_own_their_list_once.out
step: jet build --optimize=full main.jet
exit: 0
step aot: built
exit: 0
stdout: = hot_loops_poll_once_and_own_their_list_once.out
