// A function that writes its `&` list parameter in place and then ends in
// a tail call returns to its caller, which runs on: the `#unique` test
// selected inline reports no stop to the stop point after it.
Row: struct {
    name: String
    count: Int
}

ROWS: [Row]{
    Row{name: "alpha", count: 2},
    Row{name: "beta", count: 1},
    Row{name: "gamma", count: 3},
}

missing_rows: fn(known: [String:Int], found: &[String]) {
    loop row in ROWS {
        if known.get(row.name) == None -> found.push("{row.name}: missing")
    }
    found.sort()
}

run: fn() {
    known := [String:Int]{}
    loop row in ROWS -> known[row.name.copy()] = row.count
    // An empty frozen list: the slow path writes it in place.
    empty := [String]{}
    missing_rows(known, empty)
    print("empty {empty.len()}")
    // A list with one owner: the hot path writes it in place.
    owned := [String]{}
    owned.push("zeta: kept")
    partial := [String:Int]{}
    partial["beta"] = 1
    missing_rows(partial, owned)
    print("owned {owned.len()}")
    loop line in owned -> print(line)
    print("done")
}
