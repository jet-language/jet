step: fn(a: Vec3, b: Vec3, k: Float) -> Vec3 {
    (a + b) * k - a
}

bump: fn(xs: &[Float], k: Float) {
    loop i in 0..<xs.len() {
        xs[i] = xs[i] * k
    }
}

run: fn() {
    xs := [Float]{1.0, 2.0, 3.0}
    ys := xs
    bump(xs, 2.0)
    v: step(Vec3(1.0, 2.0, 3.0), Vec3(0.5, 0.25, 0.125), 4.0)
    print("{xs[0]} {xs[1]} {xs[2]} {ys[0]} {ys[2]}")
    print("{v.x} {v.y} {v.z}")
}
