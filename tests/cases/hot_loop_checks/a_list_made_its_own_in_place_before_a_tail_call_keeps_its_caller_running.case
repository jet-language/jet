# A function that writes its `&` list parameter in place and then ends in a
# tail call returns to its caller, which runs on, at every level. x86-64
# selection runs a `#unique` helper's test inline (X64Select.jet
# ir_x64_unique_call); the stop point after the Call reads edx as the
# helper's stop, so each path that writes in place without calling it
# leaves edx 0: an empty frozen list (the slow path) and a list with one
# owner (the hot path).
fixture: a_list_made_its_own_in_place_before_a_tail_call_keeps_its_caller_running.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = a_list_made_its_own_in_place_before_a_tail_call_keeps_its_caller_running.out
stderr: empty
step: jet run -O1 main.jet
exit: 0
stdout: = a_list_made_its_own_in_place_before_a_tail_call_keeps_its_caller_running.out
stderr: empty
step: jet run -O2 main.jet
exit: 0
stdout: = a_list_made_its_own_in_place_before_a_tail_call_keeps_its_caller_running.out
stderr: empty
step: jet build -O0 main.jet
exit: 0
step aot: built
exit: 0
stdout: = a_list_made_its_own_in_place_before_a_tail_call_keeps_its_caller_running.out
stderr: empty
