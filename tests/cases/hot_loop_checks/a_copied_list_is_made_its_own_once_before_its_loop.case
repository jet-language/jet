# A list copied from another (`ys := xs`) shares its buffer, so the loop
# writing it makes it its own. At O1 and O2 that happens once, before the
# loop, rather than on every write: the whole-header copy stores the buffer
# the loop starts with. The original keeps its values on every tier.
fixture: a_copied_list_is_made_its_own_once_before_its_loop.fixture
env: NO_COLOR=1
step: jet inspect decisions main.jet
exit: 0
stdout: ~ "unique hoisted 1," # the default build hoists it (O1)
step: jet inspect decisions --release main.jet
exit: 0
stdout: ~ "unique hoisted 1," # --release hoists it too (O2)
step: jet run --optimize=none main.jet
exit: 0
stdout: = a_copied_list_is_made_its_own_once_before_its_loop.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = a_copied_list_is_made_its_own_once_before_its_loop.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = a_copied_list_is_made_its_own_once_before_its_loop.out
