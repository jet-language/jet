
use {
    server: core.http.server
    web: core.web
}
JokeID: struct { value: Int }
Jokes: struct {
    #Server.Get("/mounted/:id")
    joke: fn(self, id: JokeID) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "joke={id.value}"))
    }
}
run: fn() {
    mux: server.mux()
    mux.get("/direct/:id", fn(id: JokeID) { Ok(server.response(200, "joke={id.value}")) })
    mux.mount(Jokes{})
    schema: web.openapi(mux)
    print(schema.contains("\"value\"") && schema.contains("/mounted/") && schema.contains("/direct/"))
}
