// `math.fma` rounds a * b + c once (IEEE 754 fusedMultiplyAdd). Native code
// runs one vfmadd213sd when the CPU has FMA3, else the runtime's soft fma
// (JetIR X64Select.jet ir_x64_fma), and each row also equals its
// compile-time value. The bits are the same either way: a negative product
// that rounds to zero plus +0 is -0 (musl's fma gives +0, Jet's does not),
// and a NaN result is the soft fma's, so an inf * 0 product with a NaN
// addend is the default NaN where the hardware would keep the addend's.
use math: core.math

// a, b, c of each row as binary64 bits; a set sign bit reads as to_bits
// gives it, a negative Int.
rows: fn() -> [Int] {
    negative_zero: -9223372036854775807 - 1
    negative_one: -4616189618054758400
    negative_half: -4620693217682128896
    negative_two: -4611686018427387904
    negative_infinity: -4503599627370496
    [Int]{
        0x3fb999999999999a, 0x4024000000000000, negative_one,
        0x3ff0000000000001, 0x3fefffffffffffff, negative_one,
        negative_zero, 0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, negative_one, negative_zero,
        0x7fe1ccf385ebc8a0, 0x4024000000000000, 0x0000000000000000,
        0x7fe1ccf385ebc8a0, 0x4024000000000000, negative_infinity,
        0x0010000000000000, 0x3e10000000000000, 0x0000000000000000,
        0x0000000000000001, 0x3fe0000000000000, 0x0000000000000000,
        0x0000000000000001, negative_half, 0x0000000000000000,
        negative_half, 0x0000000000000001, negative_zero,
        0x7ff8000000000001, 0x7ff8000000000002, 0x7ff8000000000003,
        0x3ff0000000000000, 0x7ff8000000000002, 0x7ff8000000000003,
        0x7ff0000000000000, 0x0000000000000000, 0x7ff8000000000003,
        0x7ff0000000000000, 0x0000000000000000, 0x3ff0000000000000,
        0x7ff0000000000000, 0x3ff0000000000000, negative_infinity,
        0x7ff4000000000005, 0x3ff0000000000000, 0x0000000000000000,
        0x3ff8000000000000, negative_two, 0x4008000000000000,
    }
}

fused_bits: fn() -> [Int] {
    bits: rows()
    out := [Int]{}
    loop i in 0..<bits.len() /% 3 {
        a: math.from_bits(bits[3 * i])
        b: math.from_bits(bits[3 * i + 1])
        c: math.from_bits(bits[3 * i + 2])
        out.push(math.to_bits(math.fma(a, b, c)))
    }
    out
}

run: fn() {
    soft: comptime { fused_bits() }
    now: fused_bits()
    loop i in 0..<now.len() {
        same: if now[i] == soft[i] -> "same" else -> "differs from {soft[i]}"
        print("{math.from_bits(now[i])} {now[i]} {same}")
    }
    // Many fmas after the first one's probe.
    total := Float{0.0}
    loop i in 1..<1001 -> total = math.fma(Float{i}, 0.1, total)
    print("sum {total} {math.to_bits(total)}")
}
