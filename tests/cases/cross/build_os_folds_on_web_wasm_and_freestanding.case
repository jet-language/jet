# Web, Wasm and bare-metal targets are arms of `#build.target.os`, not folded to the
# host's OS: a web build takes its own arm and reads `Web`, and the native run
# takes the `else` arm. The Wasm and no-OS machines fold the same way
# (Compiler/JetFoundation/Tests/Target/TargetMachine.jet); `jet build` writes
# neither yet.
fixture: build_os_folds_on_web_wasm_and_freestanding.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run main.jet
exit: 0
stdout: = "native arm\nLinux\n" # the Linux host's run folds on else
when tool node
step: jet build --target web main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = "web arm\nWeb\n" # the web build folds on its own arm
end when
