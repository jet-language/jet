# One `build: fn` builds the same source for the host and for the web, and
# each artifact is checked against its own machine's row. The source prepares
# a process on every path: the host provides processes, so the program runs,
# but the web machine denies `Exec`, so `jet build` stops at the call, naming
# the web target.
fixture: build_fn_checks_each_target_against_its_own_row.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -A run.jet
exit: 0
stdout: = "prepared\n"
step: jet build run.jet
exit: 1
stderr: ~ "Error [jet.TargetDeniedEffect]: `launch` uses `Exec`, which target `wasm32-unknown-unknown` denies" # the web artifact's check names the target
stderr: ~ "run.jet:10:16" # and the line of the call
