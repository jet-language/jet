# `#build.target.*` reads the machine the build targets: its triple, OS,
# layout (pointer and word bits, cache line) and CPU features fold in a
# `comptime if` and print in code. The native run reads the Linux host's
# machine and the web build the browser's. `core.target` declares the same
# facts for the native hosts, the web and the GPU, and each machine's row
# denies the effects whose services it lacks.
fixture: build_target_facts_read_in_comptime_and_code.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
requires: os-name:linux
requires: arch:x86_64
step: jet run main.jet
exit: 0
stdout: = "64-bit pointers\nx86_64-unknown-linux-gnu Linux word 64 line 64 cpu [sse2]\nlinux: x86_64-unknown-linux-gnu pointer 64 word 64 line 64 cpu [sse2] row []\nmacos: aarch64-apple-darwin pointer 64 word 64 line 128 cpu [neon] row []\nwindows: x86_64-pc-windows-msvc pointer 64 word 64 line 64 cpu [sse2] row []\nweb: wasm32-unknown-unknown pointer 32 word 32 line 64 cpu [] row [!Exec, !FFI.C]\ngpu: spirv64-unknown-unknown pointer 64 word 32 line 128 cpu [] row [!Net, !FS, !IO, !Time, !Rand, !Env, !Exec, !FFI, !Browser, !Panic, !Mem.Alloc]\n"
when tool node
step: jet build --target web main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = "32-bit pointers\nwasm32-unknown-unknown Web word 32 line 64 cpu []\nlinux: x86_64-unknown-linux-gnu pointer 64 word 64 line 64 cpu [sse2] row []\nmacos: aarch64-apple-darwin pointer 64 word 64 line 128 cpu [neon] row []\nwindows: x86_64-pc-windows-msvc pointer 64 word 64 line 64 cpu [sse2] row []\nweb: wasm32-unknown-unknown pointer 32 word 32 line 64 cpu [] row [!Exec, !FFI.C]\ngpu: spirv64-unknown-unknown pointer 64 word 32 line 128 cpu [] row [!Net, !FS, !IO, !Time, !Rand, !Env, !Exec, !FFI, !Browser, !Panic, !Mem.Alloc]\n"
end when
