# A checked inline `#FFI(c)` program built for the web stops in the checker:
# the web machine has no C, so the call is a target-denied effect (E1123),
# exit 1, and code generation never meets a C symbol it cannot link (no 101).
fixture: web_build_refuses_inline_c_before_codegen.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --os=web --allow=FFI.C main.jet
exit: 1
stderr: ~ "Error [jet.TargetDeniedEffect]: `run` uses `FFI.C`, which target `wasm32-unknown-unknown` denies" # the web artifact's check names the C effect and the target
stderr: ~ "main.jet:7:59" # and the line of the C call
