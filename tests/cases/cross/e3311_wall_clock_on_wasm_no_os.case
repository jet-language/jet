# A machine without an OS has only the services its profile declares.
# `wasm.no-os` declares no clock, so `time.now()` is E3311 at the call when
# the program is built for it, and the build stops before any image.
fixture: e3311_wall_clock_on_wasm_no_os.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --target=wasm.no-os test.jet
exit: 1
stderr: ~ "Target `wasm.no-os` lacks the required `Time.Wall` capability." # the build checks for the selected machine
stderr: ~ "test.jet:4:13" # reported at the `now` call
stderr: !~ "is not built yet" # the refusal comes from the check, before any image
