use process: core.process

build: fn(b: Build) {
    web: b.toolchain("web", "wasm32-unknown-unknown")
    _: b.add_executable("native_app", ["run.jet"], [])
    _: b.add_executable("page_app", ["run.jet"], [], [], [], web)
}

launch: fn() {
    _: process.cmd(["echo", "hello"])
}

run: fn() {
    launch()
    print("prepared")
}
