# #6603: a registered flag whose registry row scopes it to other commands is a
# usage error naming the commands that take it, before the command does anything.
mkdir: init_check
step: jet init --check
cwd: init_check
env: NO_COLOR=1
exit: 2
stdout: empty
stderr: ~ E2102 # the mis-scoped flag is a usage error
stderr: ~ `--check` is only valid with `jet fmt`, `jet doc`, `jet split` or `jet fold` # names every command that takes it
stderr: ~ Drop `--check` from `jet init` # teaches the fix
entries: init_check = 0
step: jet check main.jet --keep
env: NO_COLOR=1
exit: 2
stdout: empty
stderr: ~ E2102 # a second mis-scoped flag on a compiler command
stderr: ~ `--keep` is only valid with `jet try` # names the one command that takes it
