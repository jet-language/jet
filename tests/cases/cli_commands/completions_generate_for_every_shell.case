# Port of cli_parts/commands.rs::completions_generate_for_every_shell.
# Original snapshots pin every asserted structural/out/repo spelling.
step: jet self completions bash
stdout: = ../../cli/completions_bash.txt
step: jet self completions zsh
stdout: = ../../cli/completions_zsh.txt
step: jet self completions fish
stdout: = ../../cli/completions_fish.txt
step: jet self completions powershell
stdout: = ../../cli/completions_powershell.txt
