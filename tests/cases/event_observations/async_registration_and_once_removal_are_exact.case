# Port of tests/event_observations.rs:349-404; program bytes in current syntax.
# The debugger reads the runtime's event observations through `jet inspect <plane> --live PID`,
# which renders the closed, payload-free record lines (JetCli LiveEvents.jet).
fixture: fixtures/async_registration_and_once_removal_are_exact
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
session app raw: built
env: JET_OBSERVE=1
env: JET_DEVTOOLS_RELAY_SESSION_ID=event-observation-session
env: JET_DEVTOOLS_RELAY_SOURCE_ID=observed
env: JET_DEVTOOLS_RELAY_BUILD_ID=event-observation-build
env: JET_DEVTOOLS_RELAY_REVISION=event-observation-revision
env: JET_DEVTOOLS_RELAY_WORLD_ID=event-observation-world
env: JET_SCHEDULER_THREADS=2
recv app until = "READY\n" within 30s
poll events: jet inspect structure --live {pid:app} until exit: 0 && stdout: ~ "lifecycle=Removed" timeout 5s every 25ms # original debugger_events waits for a removal, 5s deadline, 25ms polling
stdout.filter(~ "source=AsyncEvent").filter(~ "lifecycle=Subscribed"): lines = 1 # original: the pre-cancelled registration is never published
stdout.filter(~ "source=AsyncEvent").filter(~ "lifecycle=Removed"): lines = 1 # original: the async once removal is published once
capture: subscribed = text stdout.filter(~ "source=AsyncEvent").filter(~ "lifecycle=Subscribed").line(0).split(" subscription=", 1).split(" ", 0)
stdout.filter(~ "source=AsyncEvent").filter(~ "lifecycle=Removed"): ~ " subscription={cap:subscribed} " # original: the removal matches the once subscription
signal app: KILL
close app
exit: any # original Running guard kills and ignores the wait status
