use {
    event: core.event
    term: core.term
    time: core.time
}

run: fn() {
    scope: event.scope()
    concurrent: event.async_result<Int, Err>(AsyncPolicy{ capacity: 64, overflow: .DropNewest }, .Collect) ?? panic("policy")
    concurrent.on(scope, (n: Int) -> { time.sleep(1ms) })
    loop i in 0..<400 { concurrent.emit_async(i) }
    time.sleep(1500ms)
    print("READY")
    // A pipe stdout is written when its buffer fills (spec.md print); flush so
    // the debugger session sees READY before it reads the snapshot.
    ready_out := term.stdout()
    ready_out.flush() ?? panic("flush")
    time.sleep(30000ms)
}
