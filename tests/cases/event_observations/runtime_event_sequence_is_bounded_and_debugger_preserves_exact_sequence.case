# Port of tests/event_observations.rs:406-436; program bytes in current syntax.
# The debugger reads the runtime's event observations through `jet inspect <plane> --live PID`,
# which renders the closed, payload-free record lines (JetCli LiveEvents.jet); the record lines
# are the ones carrying `sequence=`. The live renderer (jet_cli_live_event_render) refuses a
# snapshot whose sequence is not strictly increasing, so 256 rendered records carry the order check.
fixture: fixtures/runtime_event_sequence_is_bounded_and_debugger_preserves_exact_sequence
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
session app raw: built
env: JET_OBSERVE=1
env: JET_DEVTOOLS_RELAY_SESSION_ID=event-observation-session
env: JET_DEVTOOLS_RELAY_SOURCE_ID=observed
env: JET_DEVTOOLS_RELAY_BUILD_ID=event-observation-build
env: JET_DEVTOOLS_RELAY_REVISION=event-observation-revision
env: JET_DEVTOOLS_RELAY_WORLD_ID=event-observation-world
env: JET_SCHEDULER_THREADS=2
recv app until = "READY\n" within 30s
poll events: jet inspect structure --live {pid:app} until exit: 0 && stdout: ~ "terminal=Delivered" timeout 5s every 25ms # original debugger_events waits for a Delivered terminal, 5s deadline, 25ms polling
stdout: count-lines ~ " sequence=" = 256 # original: the snapshot and the rendered events both hold exactly 256 records
stdout.filter(~ " sequence=").line(0): !~ " sequence=1 " # original: old records were evicted
stdout.filter(~ " sequence=").line(255): ~ "terminal=Delivered" # original: the last record is the newest Delivered terminal
signal app: KILL
close app
exit: any # original Running guard kills and ignores the wait status
