# Port of tests/event_observations.rs:120-233; program bytes in current syntax.
# The debugger reads the runtime's event observations through `jet inspect <plane> --live PID`,
# which renders the closed, payload-free record lines (JetCli LiveEvents.jet). The original also read
# the Canvas runtime_events projection; Canvas has no CLI route, and it projects the same records.
fixture: fixtures/debugger_sees_only_executed_redacted_sync_and_hook_facts
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0
session app raw: built
env: JET_OBSERVE=1
env: JET_DEVTOOLS_RELAY_SESSION_ID=event-observation-session
env: JET_DEVTOOLS_RELAY_SOURCE_ID=observed
env: JET_DEVTOOLS_RELAY_BUILD_ID=event-observation-build
env: JET_DEVTOOLS_RELAY_REVISION=event-observation-revision
env: JET_DEVTOOLS_RELAY_WORLD_ID=event-observation-world
env: JET_SCHEDULER_THREADS=2
recv app until = "READY\n" within 30s
poll events: jet inspect structure --live {pid:app} until exit: 0 && stdout: ~ "terminal=Fail" timeout 5s every 25ms # original debugger_events waits for the Fail terminal, 5s deadline, 25ms polling
stdout: !~ "UNEXECUTED_SECRET" # original: the debugger never shows an unexecuted payload
stdout: !~ "SYNC_PAYLOAD_SECRET" # original: the debugger never shows a sync payload
stdout: !~ "HOOK_FAILURE_SECRET" # original: the debugger never shows a hook failure payload
stdout: !~ "HOOK_PAYLOAD_SECRET" # original: the debugger never shows a hook payload
stdout: ~ "source=Event " # original rendered.contains("source=Event")
stdout: ~ "priority=17" # original rendered.contains
stdout: ~ "lifecycle=HandlerStarted" # original rendered.contains
stdout: ~ "source=DecisionHook" # original rendered.contains
stdout: ~ "priority=9" # original rendered.contains
stdout: ~ "failure=Handler" # original rendered.contains
stdout: ~ "terminal=Fail" # original rendered.contains
stdout: count-lines ~ "lifecycle=Subscribed" = 5 # original rendered.matches("lifecycle=Subscribed").count() == 5
stdout: count-lines ~ "lifecycle=Removed" = 3 # original rendered.matches("lifecycle=Removed").count() == 3
stdout.filter(~ "source=Event ").filter(~ "lifecycle=Removed"): lines >= 1 # original: some Event line is a removal
stdout.filter(~ "source=DecisionHook").filter(~ "lifecycle=Removed"): lines >= 1 # original: some DecisionHook line is a removal
capture: removed0 = text stdout.filter(~ "lifecycle=Removed").line(0).split(" subscription=", 1).split(" ", 0)
capture: removed1 = text stdout.filter(~ "lifecycle=Removed").line(1).split(" subscription=", 1).split(" ", 0)
capture: removed2 = text stdout.filter(~ "lifecycle=Removed").line(2).split(" subscription=", 1).split(" ", 0)
stdout.filter(~ "lifecycle=Removed"): count-lines ~ "subscription={cap:removed0} " = 1 # original: the three removals name three distinct subscriptions
stdout.filter(~ "lifecycle=Removed"): count-lines ~ "subscription={cap:removed1} " = 1 # original: the three removals name three distinct subscriptions
stdout.filter(~ "lifecycle=Removed"): count-lines ~ "subscription={cap:removed2} " = 1 # original: the three removals name three distinct subscriptions
stdout: count-lines ~ "lifecycle=DispatchStarted" = 4 # original rendered.matches("lifecycle=DispatchStarted").count() == 4
signal app: KILL
close app
exit: any # original Running guard kills and ignores the wait status
