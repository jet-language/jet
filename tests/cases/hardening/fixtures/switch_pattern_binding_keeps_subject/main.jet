
Shape: enum {
    Circle(String)
    Empty
}

run: fn() {
    s: Shape.Circle("big")
    if s == {
        .Circle(label) -> {
            print(label)
        }
        .Empty -> {
            print("empty")
        }
    }
    if s == {
        .Circle(label2) -> {
            print(label2)
        }
        .Empty -> {
            print("still empty")
        }
    }
}
