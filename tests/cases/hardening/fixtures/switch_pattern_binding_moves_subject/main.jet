
enum Shape {
    Circle(String)
    Empty
}

fn run() {
    s :: Shape.Circle("big")
    if s == {
        Circle(label) -> {
            print(label)
        }
        Empty -> {
            print("empty")
        }
    }
    if s == {
        Circle(label2) -> {
            print(label2)
        }
        Empty -> {
            print("still empty")
        }
    }
}
