#Numeric Severity: distinct Int(0..10)

#UnitFamily(Length, base: meter) {
    meter
    half(scale: 1/2)
}

Reservation: struct {
    state { Pending, Confirmed }
    guest: String
}

impl Reservation {
    #State(_ -> Pending) book: fn(guest: String) -> Reservation { {guest: guest.copy()} }

    #State(Pending -> Confirmed) pay: fn(self: &&Reservation) -> Reservation { self }
}

#Scrub(Input) clean: fn(raw: #Input String) -> String { raw.copy() }

ANSWER: comptime { 40 + 2 }

COMPTIME_RANGE: comptime { wrapping(4 + 5) }

COMPTIME_EXACTNESS: comptime { exactness_value() }

COMPTIME_UNIT: comptime { unit_value() }

COMPTIME_STATE: comptime { state_value() }

COMPTIME_CLASSIFICATION: comptime { classification_value() }

exactness_value: fn() -> Bool {
    lossy: Int{9007199254740993}
    zero: Float{0.0}
    approx(lossy) > zero
}

unit_value: fn() -> Float {
    source: Half.from_float(Float{5.0})
    value: Meter.from_half_rounded(source, .NearestEven, digits: 0) ?? panic("unit gate")
    value.raw()
}

state_value: fn() -> String {
    reservation := Reservation.book("state")
    reservation = reservation.pay()
    reservation.guest
}

classification_value: fn() -> String {
    raw: #Input "world"
    clean(raw)
}

run: fn() {
    left: Severity.from_int(4)
    right: Severity.from_int(5)
    total: wrapping(left + right)
    exactness: exactness_value()
    unit: unit_value()
    state: state_value()
    classification: classification_value()
    print("{ANSWER}")
    print("comptime_range={COMPTIME_RANGE}")
    print("comptime_exactness={COMPTIME_EXACTNESS}")
    print("comptime_unit={COMPTIME_UNIT}")
    print("comptime_state={COMPTIME_STATE}")
    print("comptime_classification={COMPTIME_CLASSIFICATION}")
    print("exactness={exactness}")
    print("unit={unit}")
    print("state={state}")
    print("classification={classification}")
    print("range={total}")
}
