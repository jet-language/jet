#UnitFamily(Length, base: meter) {
    meter
    thirdish(scale: 2/3)
}
Input: tag { deny: [IO] }
#Scrub(Input) scrub: fn(raw: #Input String) -> String { raw.copy() }
#MustUse discardable: fn() -> Int { 1 }

run: fn() {
    #FX(authority: IO) {}
    discardable().drop("intentional result discard")
    detached: task 42
    detached.detach()
    approx(1)
    wrapping(1 + 2)
    Thirdish.from_meter_rounded(1meter, .NearestEven, digits: 0).drop("rounded conversion gate")
}
