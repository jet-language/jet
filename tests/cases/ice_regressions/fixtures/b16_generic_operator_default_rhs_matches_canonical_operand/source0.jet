use core.math.[Point2, Delta2]

Plane: struct {}

run: fn() {
    a: Point2<Float, Plane>.new(5.0, 7.0, 3)
    b: Point2<Float, Plane>.new(1.0, 2.0, 3)
    difference: (a - b) ?? panic("point difference")
    print("{difference.x} {difference.y} {difference.frame_id}")
    zero: (difference - difference) ?? panic("delta difference")
    print("{zero.x} {zero.y}")
}
