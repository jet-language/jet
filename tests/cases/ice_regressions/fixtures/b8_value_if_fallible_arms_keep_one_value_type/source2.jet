
next: fn(value: Dyn) -> [String] { return [String]{} }
value_if_list_err: fn(value: Dyn) -> [String] {
    empty := [String]{}
    return if value == {
        .Text(text) -> next(Dyn.Text(text.copy()))
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> empty
    }
}
run: fn() {
    print(value_if_list_err(Dyn.Null))
}
