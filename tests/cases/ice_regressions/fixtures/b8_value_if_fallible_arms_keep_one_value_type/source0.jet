
next: fn(value: Dyn) -> Bool Never! { return true }
value_if_bool_never: fn(value: Dyn) -> Bool Never! {
    return if value == {
        .Null -> false
        .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> next(value.copy())
    }
}
run: fn() {
    print(value_if_bool_never(Dyn.Null))
}
