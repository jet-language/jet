# A constant whose check settles but names a value still waiting in the
# comptime batch waits for the pass's last flush like any other unvalued
# name (JetDriver Pipeline.jet jet_driver_comptime_run), instead of landing
# the batch early: TWO and FOUR build one program, then SIX and EIGHT, which
# name them, build the second. Landing the batch at each such name would
# build three: TWO, then SIX and FOUR, then EIGHT.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "double: fn(n: Int) -> Int {\n    n * 2\n}\n\nTWO: double(1)\nSIX: double(TWO) + 2\nFOUR: double(2)\nEIGHT: double(FOUR)\n\nrun: fn() {\n    print(\"{TWO} {SIX} {FOUR} {EIGHT}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "2 6 4 8\n"
stderr: ~ "# comptime.programs_built = 2\n" # one build per dependency level
stderr: ~ "comptime.build TWO, FOUR (main.jet)" # the first level's build span names both
stderr: ~ "comptime.build SIX, EIGHT (main.jet)" # the second level's names both
