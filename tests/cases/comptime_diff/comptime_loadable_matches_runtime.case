# Each source computes a core.reactive.loadable state, or a reading of one,
# at compile time and the same at run time. The compile-time value and the
# run-time value print as hex, one line each, and must be byte-identical.
# The constructors name their `T` and `E`: nothing else fixes them.
fixture: comptime_loadable_matches_runtime.fixture
