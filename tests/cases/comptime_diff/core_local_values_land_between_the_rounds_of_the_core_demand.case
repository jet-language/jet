# In a compile that lowers, the local values of the Core
# bodies the finalization's Core demand reaches arrive with them, so no pass
# is refused and the program is not checked again after finalization. The
# Path literal reaches core.files `path_component_encode`, whose `hex` is a
# local value site; the program reaches the `s`, `digits` and `style` sites
# of other Core bodies too. A run whose Core is the Core built into this jet
# loads those bodies' checks from core.bodies, the local values already in
# place. A Core body checked from text instead (a toolchain tree whose Core
# differs) has its sites landed by the driver round by round of the demand
# (JetSema CoreDemand.jet sema_core_demand_waves, JetDriver BodyComptime.jet
# jet_driver_land_local_values). JET_RECHECK_VERIFY=1 finalizes the program
# again with every value from the start, its demand in the same rounds, and
# stops the compile on any difference.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "run: fn() {\n    name: \"a b/c\"\n    path: Path{\"/tmp/{name}\"}\n    print(\"{path}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "/tmp/a%20b%2Fc\n"
stderr: ~ "# core.bodies_loaded = " # the Core bodies load with their local values
stderr: !~ "# sema.local_values_refused" # no pass is refused after a round of the Core demand
stderr: !~ "> comptime.body.recheck" # no pass falls back to the full recheck
stderr: !~ "JET_RECHECK_VERIFY" # the landed result is the full recheck's
