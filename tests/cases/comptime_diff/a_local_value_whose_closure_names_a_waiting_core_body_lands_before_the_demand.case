# In a compile that lowers, a program body's local value lands
# before the first finalization's Core demand (JetDriver BodyComptime.jet
# jet_driver_land_local_values, JetSema Comptime/LocalSplice.jet
# SemaLocalSpliceInto.Undemanded). `parts`, checked to run while compiling,
# names core.text.parse `split`, a Core body that waits for demand. The
# demand runs after the landing, reads the landed body and demands what the
# pass's comptime functions name in its first round, as the full recheck's
# does, so the pass lands and is not checked again after finalization. The
# demand that `split` starts reaches a Core body's local value (core.math
# `s`), which lands after that round, so no pass falls back to
# the full recheck. JET_RECHECK_VERIFY=1 checks the whole program again
# anyway and stops the compile on any difference.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "use {\n    parse: core.text.parse\n}\n\nparts: fn(text: String) -> Int {\n    parse.split(text, \",\").len()\n}\n\nrun: fn() {\n    count: parts(\"a,b,c\")\n    print(\"{count}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "3\n"
stderr: ~ "# sema.local_values_spliced = " # `count` lands in `run`
stderr: !~ "# sema.local_values_refused" # no pass is refused, the Core one included
stderr: !~ "> comptime.body.recheck" # no pass falls back to the full recheck
stderr: !~ "JET_RECHECK_VERIFY" # the landed result is the full recheck's
