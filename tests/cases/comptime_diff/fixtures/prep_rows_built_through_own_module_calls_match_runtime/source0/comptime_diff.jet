
Cov: struct { bits: Int }

Route: enum {
    NoRoute
    Typed
}

Rec: struct {
    member: String
    coverage: Cov
    route: Route
}

rec_new: fn(member: String) -> Rec Never! {
    Rec{member: member, coverage: Cov{bits: 1}, route: Route.Typed}
}

rec_with_coverage: fn(member: String, coverage: Cov) -> Rec Never! {
    row := rec_new(member)
    row.coverage = coverage
    row.route = Route.NoRoute
    row
}

ROWS: #run { [Rec]{ rec_new("a"), rec_with_coverage("b", Cov{bits: 2}) } }

run: fn() {
    rows: [Rec]{ rec_new("a"), rec_with_coverage("b", Cov{bits: 2}) }
    print("{ROWS[1].member} {ROWS[1].coverage.bits} {ROWS[1].route == Route.NoRoute}")
    print("{rows[1].member} {rows[1].coverage.bits} {rows[1].route == Route.NoRoute}")
}
