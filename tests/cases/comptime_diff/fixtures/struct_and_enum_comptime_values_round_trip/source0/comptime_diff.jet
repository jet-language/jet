
struct Pair {
    left: Int
    right: String
}

enum Light {
    Red
    Green
}

PAIR_VALUE :: comptime { Pair{left: 7, right: "seven"} }
LIGHT_VALUE :: comptime { Light.Green }

fn run() {
    p :: Pair{left: 7, right: "seven"}
    l :: Light.Green
    print("{PAIR_VALUE.left}")
    print("{p.left}")
    print("{PAIR_VALUE.right}")
    print("{p.right}")
    print("{LIGHT_VALUE == Light.Green}")
    print("{l == Light.Green}")
}
