
fn build() -> [Int] {
    xs := [Int]{}
    loop i in 1..5, 2 {
        if i == 3 { next }
        &xs.push(i * 10)
    }
    loop cursor in 0..<3 {
        if cursor == 1 { next }
        &xs.push(cursor)
    }
    return xs
}

fn run() {
    built :: comptime { build() }
    runtime :: build()
    print("{built}")
    print("{runtime}")
}
