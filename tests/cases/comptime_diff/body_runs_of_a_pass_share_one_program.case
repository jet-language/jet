# The explicit `name: #run value` locals one comptime pass stages in
# function bodies wait in one batch (jet_driver_comptime_batchable), as local
# values do, and are evaluated together on one IR build, each landing its
# own value in its owner body.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "fact: fn(n: Int) -> Int {\n    if n <= 1 -> return 1\n    n * fact(n - 1)\n}\n\nrepeat: fn(word: String, times: Int) -> String {\n    out := \"\"\n    loop _ in 0..<times -> out = \"{out}{word}\"\n    out\n}\n\nfirst: fn() {\n    big: #run fact(10)\n    word: #run repeat(\"ab\", 3)\n    print(\"{big} {word}\")\n}\n\nsecond: fn() {\n    small: #run fact(5)\n    print(\"{small}\")\n}\n\nrun: fn() {\n    first()\n    second()\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "3628800 ababab\n120\n"
stderr: ~ "# comptime.programs_built = 1\n" # the three locals build one program
stderr: !~ "# comptime.programs_built = 3\n" # not one per local
stderr: !~ "comptime.build word (main.jet)" # `word` waits in the batch with `big`
stderr: !~ "> comptime.body.recheck" # they land in their owner bodies
stderr: !~ "JET_RECHECK_VERIFY" # the landed result is the full recheck's
