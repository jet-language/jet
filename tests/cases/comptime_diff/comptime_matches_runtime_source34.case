# tests/comptime_diff.rs::comptime_matches_runtime at tests/comptime_diff.rs:284; hand-port
# Each source is the original check_comptime_src program after its parity framing (framed_comptime_src): the
# comptime value and the AOT runtime value print as hex, one line each, and must be byte-identical
# (the frame helpers drop the double underscore: E0067 reserves it outside generated sources).
# The original also asserted no `unsafe` in the generated Rust; that is generated-Rust shape and is not ported.
# One source of the original parity loop per case (sources 1-66 are comptime_matches_runtime_sourceNN.case), so each row stays short.
fixture: comptime_matches_runtime.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build source34/comptime_diff.jet
exit: 0
step aot34: built
exit: 0
stdout: lines = 2 # original parse_parity_output: one comptime line and one runtime line
capture: comptime34 = text stdout.line(0)
capture: runtime34 = text stdout.line(1)
cap:comptime34: = "{cap:runtime34}"
