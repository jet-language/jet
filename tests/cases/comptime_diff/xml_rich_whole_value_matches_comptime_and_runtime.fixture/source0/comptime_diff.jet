use {
    comptime_diff_hex: core.encoding.hex
    xml: core.encoding.xml
}
COMPTIME_VALUE: comptime { xml.to_string(xml.parse("<r xmlns=\"urn:r\" xmlns:p=\"urn:p\" p:a=\"x&amp;y\">a&amp;<!--c--><![CDATA[<x>]]><?go now?><p:c/></r>") ?? panic("bad")) ?? panic("xml render") }

run: fn() {
    r: xml.to_string(xml.parse("<r xmlns=\"urn:r\" xmlns:p=\"urn:p\" p:a=\"x&amp;y\">a&amp;<!--c--><![CDATA[<x>]]><?go now?><p:c/></r>") ?? panic("bad")) ?? panic("xml render")
    comptime_diff_frame("{COMPTIME_VALUE}", "{r}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
