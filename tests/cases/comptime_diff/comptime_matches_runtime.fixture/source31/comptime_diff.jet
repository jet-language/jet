use core.encoding.hex as comptime_diff_hex
COMPTIME_VALUE :: prep { " 	".is_whitespace() }

fn run() {
    r :: " 	".is_whitespace()
    comptime_diff_frame("{COMPTIME_VALUE}", "{r}")

}

fn comptime_diff_frame(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
