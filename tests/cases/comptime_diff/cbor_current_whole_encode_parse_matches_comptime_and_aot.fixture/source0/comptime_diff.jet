use {
    comptime_diff_hex: core.encoding.hex
    json: core.encoding.json
    cbor: core.encoding.cbor
    hex: core.encoding.hex
}
ENCODED: #run hex.encode(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3],\"c\":-7}}") ?? panic("bad json")) ?? panic("bad cbor"))
PARSED: #run { json.to_string(cbor.parse(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3]}}") ?? panic("bad json")) ?? panic("bad cbor")) ?? panic("bad parse")) ?? panic("JSON encode") }

run: fn() {
    r: hex.encode(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3],\"c\":-7}}") ?? panic("bad json")) ?? panic("bad cbor"))
    p: json.to_string(cbor.parse(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3]}}") ?? panic("bad json")) ?? panic("bad cbor")) ?? panic("bad parse")) ?? panic("JSON encode")
    comptime_diff_frame("{ENCODED}|{PARSED}", "{r}|{p}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
