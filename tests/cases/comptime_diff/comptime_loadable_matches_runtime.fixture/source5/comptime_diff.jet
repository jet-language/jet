use {
    comptime_diff_hex: core.encoding.hex
    loadable: core.reactive.loadable
}
COMPTIME_VALUE: comptime { loadable.loading().is_loading() }

run: fn() {
    r: loadable.loading().is_loading()
    comptime_diff_frame("{COMPTIME_VALUE}", "{r}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
