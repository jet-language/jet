# Card #6759 c1 (fin1): JET_RECHECK_VERIFY=1 runs the pass that the first
# finalization refused to land again in the first body pass, instead of
# taking its run (JetDriver BodyComptime.jet jet_driver_comptime_body_run).
# It stops the compile when the two runs' values or closures differ. The
# program is the one of
# a_local_value_that_cannot_land_keeps_its_run_for_the_body_pass.case.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "use {\n    parse: core.text.parse\n}\n\nparts: fn(text: String) -> Int {\n    parse.split(text, \",\").len()\n}\n\nrun: fn() {\n    count: parts(\"a,b,c\")\n    print(\"{count}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "3\n"
stderr: ~ "# sema.local_values_refused = " # the pass is refused, as without the verify
stderr: !~ "# comptime.refused_pass_taken" # the verify runs the pass again instead of taking it
stderr: !~ "JET_RECHECK_VERIFY" # the refused run is the one the body pass makes
