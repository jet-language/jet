# The local values of the Core bodies a program reaches land
# in the first finalization with the program's own, before its whole-program
# passes (JetDriver BodyComptime.jet jet_driver_land_local_values), so no
# body comptime site is left for a pass after it and the program is not
# checked again. `count` is the program's; the Path literal reaches
# core.files `path_component_encode`, whose `hex` is Core's. The step checks
# without lowering, so no Core body waits for demand and both land in one
# pass. A compile that lowers lands the Core bodies' sites after the round
# of its Core demand that checks them, as
# core_local_values_land_between_the_rounds_of_the_core_demand shows.
# JET_RECHECK_VERIFY=1 checks the whole program again anyway and stops the
# compile on any difference.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "run: fn() {\n    name: \"a b/c\"\n    count: \"ab\".len()\n    path: Path{\"/tmp/{name}\"}\n    print(\"{path} {count}\")\n}\n"
step: jet check --trace main.jet
exit: 0
stdout: = ""
stderr: ~ "# comptime.bodies_pending = 0\n" # every body site landed in the first finalization
stderr: ~ "# sema.local_values_spliced = " # the values land in `run` and in `path_component_encode`
stderr: !~ "# sema.local_values_refused" # no pass fell back to the full recheck
stderr: !~ "JET_RECHECK_VERIFY" # the landed result is the full recheck's
