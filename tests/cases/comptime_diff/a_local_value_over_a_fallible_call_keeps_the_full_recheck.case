# A local value drops the call edges of the initializer it replaces.
# `checked(3) ?? panic("no")` holds the calls `checked(3)` and `panic("no")`
# inside the site's span, whose edges the effect solve stamped on `run` and
# the value no longer has, so the pass does not splice the value into the
# finalized result (JetSema Comptime/LocalSplice.jet) but checks the whole
# program again. Before, the splice kept the stale edges and
# JET_RECHECK_VERIFY=1 stopped the compile.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JET_RECHECK_VERIFY=1
write: main.jet = "checked: fn(raw: Int) -> Int(0..10) { Int(0..10).from_int(raw) }\n\nrun: fn() {\n    value: checked(3) ?? panic(\"no\")\n    print(\"{value}\")\n}\n"
step: jet run --trace main.jet
exit: 0
stdout: = "3\n"
stderr: ~ "# sema.local_values_refused = 1\n" # calls inside the site's span, so the splice is refused
stderr: !~ "# sema.local_values_spliced" # nothing spliced into the finalized result
stderr: !~ "JET_RECHECK_VERIFY" # the result is the full recheck's
