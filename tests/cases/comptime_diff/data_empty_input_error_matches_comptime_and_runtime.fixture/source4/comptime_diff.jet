use {
    comptime_diff_hex: core.encoding.hex
    data: core.data
}

show: fn(result: Float DataError!) -> String {
    if result == {
        .Ok(value) -> return "ok {value}"
        .Err(e) -> return "{e.operation}|{e.reason}"
    }
    return "unreachable"
}

empty: fn() -> [Float] {
    return []
}

EXPECTED_EMPTY: #run show(data.quantile(empty(), Float{0.5}))

run: fn() {
    actual_empty: show(data.quantile(empty(), Float{0.5}))
    comptime_diff_frame("{EXPECTED_EMPTY}", "{actual_empty}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
