use {
    comptime_diff_hex: core.encoding.hex
    yaml: core.encoding.yaml
}
COMPTIME_VALUE: comptime { yaml.to_string(yaml.parse("a: &x 1\nb: *x\nc:\n  - 1\n  - 2\nd: |\n  hello\n  world\n") ?? panic("bad")).replace("\n", "|") }

run: fn() {
    r: yaml.to_string(yaml.parse("a: &x 1\nb: *x\nc:\n  - 1\n  - 2\nd: |\n  hello\n  world\n") ?? panic("bad")).replace("\n", "|")
    comptime_diff_frame("{COMPTIME_VALUE}", "{r}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
