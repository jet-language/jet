use {
    comptime_diff_hex: core.encoding.hex
    json: core.encoding.json
    cbor: core.encoding.cbor
}
COMPTIME_VALUE: comptime { json.to_string(cbor.parse(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3]}}") ?? panic("bad")) ?? panic("bad")) ?? panic("bad")) ?? panic("JSON encode") }

run: fn() {
    r: json.to_string(cbor.parse(cbor.to_bytes(json.parse("{{\"a\":1,\"b\":[1,2,3]}}") ?? panic("bad")) ?? panic("bad")) ?? panic("bad")) ?? panic("JSON encode")
    comptime_diff_frame("{COMPTIME_VALUE}", "{r}")

}

comptime_diff_frame: fn(expected_text: String, actual_text: String) {
    print("{comptime_diff_hex.encode(expected_text.bytes())}")
    print("{comptime_diff_hex.encode(actual_text.bytes())}")
}
