{
 "max": 12,
 "stop": "session.end",
 "replies": {
  "session.status": {
   "frame": "{\"type\":\"success\",\"id\":{id},\"result\":{\"ready\":true,\"message\":\"ready\"}}"
  },
  "session.new": {
   "frame": "{\"type\":\"success\",\"id\":{id},\"result\":{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}}"
  },
  "session.subscribe": {
   "frame": "{\"type\":\"success\",\"id\":{id},\"result\":{}}"
  },
  "session.end": {
   "frame": "{\"type\":\"success\",\"id\":{id},\"result\":{}}"
  }
 },
 "after": {
  "session.subscribe": [
   "{\"type\":\"event\",\"method\":\"network.responseCompleted\",\"params\":{\"isBlocked\":false,\"request\":{\"request\":\"req-2\",\"method\":\"POST\",\"url\":\"https://api.example/SECRET_PATH\"},\"response\":{\"status\":201,\"headers\":[{\"name\":\"set-cookie\",\"value\":\"session=SECRET\"}]}}}"
  ]
 }
}
