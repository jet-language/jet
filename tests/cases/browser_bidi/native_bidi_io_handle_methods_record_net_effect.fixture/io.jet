use browser: core.browser

connect: fn() -[FS]> () { browser.connect("ws://127.0.0.1:1") ?? return }

context: fn(session: Browser) -[FS]> () { session.context() ?? return }

subscribe: fn(session: Browser) -[FS]> () { session.subscribe("log.entryAdded") ?? return }

next: fn(session: Browser, timeout: BrowserTimeout) -[FS]> () {
    session.next_event(timeout) ?? return
}

add_intercept: fn(session: Browser) -[FS]> () {
    session.add_intercept("beforeRequestSent") ?? return
}

add_intercept_url: fn(session: Browser) -[FS]> () {
    session.add_intercept_url("beforeRequestSent", "https://example.test/*") ?? return
}

continue_request: fn(session: Browser) -[FS]> () { session.continue_request("req-1") ?? return }

fail_request: fn(session: Browser) -[FS]> () { session.fail_request("req-1") ?? return }

fulfill_request: fn(session: Browser) -[FS]> () {
    session.fulfill_request("req-1", 200, "blocked") ?? return
}

protocol: fn(session: Browser) -[FS]> () { session.protocol("bidi") ?? return }

close: fn(session: Browser) -[FS]> () { session.close() ?? return }

page: fn(context: BrowserContext) -[FS]> () { context.page() ?? return }

tab: fn(context: BrowserContext) -[FS]> () { context.tab() ?? return }

goto: fn(page: BrowserPage) -[FS]> () { page.goto("https://example.test") ?? return }

frames: fn(page: BrowserPage) -[FS]> () { page.frames() ?? return }

frame_close: fn(frame: BrowserFrame) -[FS]> () { frame.close() ?? return }

wait: fn(locator: BrowserLocator, timeout: BrowserTimeout) -[FS]> () {
    locator.wait(timeout) ?? return
}

wait_gone: fn(locator: BrowserLocator, timeout: BrowserTimeout) -[FS]> () {
    locator.wait_gone(timeout) ?? return
}

click: fn(locator: BrowserLocator) -[FS]> () { locator.click() ?? return }

hover: fn(locator: BrowserLocator) -[FS]> () { locator.hover() ?? return }

fill: fn(locator: BrowserLocator) -[FS]> () { locator.fill("value") ?? return }

press: fn(locator: BrowserLocator) -[FS]> () { locator.press("Enter") ?? return }

remove: fn(intercept: BrowserIntercept) -[FS]> () { intercept.remove() ?? return }

send: fn(protocol: BrowserProtocol) -[FS]> () { protocol.send("session.status", "{{}}") ?? return }

run: fn() {}
