
use browser: core.browser

connect: fn() -[FS]> Unit { browser.connect("ws://127.0.0.1:1") ?? return }
context: fn(session: Browser) -[FS]> Unit { session.context() ?? return }
subscribe: fn(session: Browser) -[FS]> Unit { session.subscribe("log.entryAdded") ?? return }
next: fn(session: Browser, timeout: BrowserTimeout) -[FS]> Unit { session.next_event(timeout) ?? return }
add_intercept: fn(session: Browser) -[FS]> Unit { session.add_intercept("beforeRequestSent") ?? return }
add_intercept_url: fn(session: Browser) -[FS]> Unit {
    session.add_intercept_url("beforeRequestSent", "https://example.test/*") ?? return
}
continue_request: fn(session: Browser) -[FS]> Unit { session.continue_request("req-1") ?? return }
fail_request: fn(session: Browser) -[FS]> Unit { session.fail_request("req-1") ?? return }
fulfill_request: fn(session: Browser) -[FS]> Unit {
    session.fulfill_request("req-1", 200, "blocked") ?? return
}
protocol: fn(session: Browser) -[FS]> Unit { session.protocol("bidi") ?? return }
close: fn(session: Browser) -[FS]> Unit { session.close() ?? return }
page: fn(context: BrowserContext) -[FS]> Unit { context.page() ?? return }
tab: fn(context: BrowserContext) -[FS]> Unit { context.tab() ?? return }
goto: fn(page: BrowserPage) -[FS]> Unit { page.goto("https://example.test") ?? return }
frames: fn(page: BrowserPage) -[FS]> Unit { page.frames() ?? return }
frame_close: fn(frame: BrowserFrame) -[FS]> Unit { frame.close() ?? return }
wait: fn(locator: BrowserLocator, timeout: BrowserTimeout) -[FS]> Unit { locator.wait(timeout) ?? return }
wait_gone: fn(locator: BrowserLocator, timeout: BrowserTimeout) -[FS]> Unit { locator.wait_gone(timeout) ?? return }
click: fn(locator: BrowserLocator) -[FS]> Unit { locator.click() ?? return }
hover: fn(locator: BrowserLocator) -[FS]> Unit { locator.hover() ?? return }
fill: fn(locator: BrowserLocator) -[FS]> Unit { locator.fill("value") ?? return }
press: fn(locator: BrowserLocator) -[FS]> Unit { locator.press("Enter") ?? return }
remove: fn(intercept: BrowserIntercept) -[FS]> Unit { intercept.remove() ?? return }
send: fn(protocol: BrowserProtocol) -[FS]> Unit { protocol.send("session.status", "{{}}") ?? return }
run: fn() {}
