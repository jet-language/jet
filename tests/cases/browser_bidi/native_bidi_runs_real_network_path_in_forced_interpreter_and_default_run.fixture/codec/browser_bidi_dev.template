
use browser: core.browser

outcome: fn(endpoint: String) -> String {
    session: browser.connect(endpoint) ?? return "caught"
    session.close() ?? return "close-error"
    return "connected"
}

run: fn() {
    print(outcome("ws://127.0.0.1:{free-port:invalid}/session"))
    print(outcome("ws://127.0.0.1:{free-port:codec_surrogate}/session"))
}
