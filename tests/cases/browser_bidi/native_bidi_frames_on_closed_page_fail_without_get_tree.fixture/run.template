
use core.web.browser as browser

fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(500) ?? panic("timeout")
    session :: browser.connect_profile("ws://127.0.0.1:{free-port:closed_frames}/session?token=CLOSED_FRAME_SECRET", profile, timeout) ?? panic("connect")
    context :: session.context() ?? panic("context")
    page :: context.tab() ?? panic("tab")
    page.close() ?? panic("close")
    loop attempt in [1] {
        page.frames() ?? next
        print("unexpected")
    }
    print("caught")
}
