// `loop x in text.split(sep)` and `loop line in text.lines()` cut each piece
// in the loop's step. Their pieces match the same calls collected first
// (`split(sep).to_list()`, a `lines()` List bound and then walked) and a
// hand-written expectation, including empty separators and pieces, CR before
// LF, a trailing LF, a separator that overlaps itself, multibyte text, `break`,
// an index binding, and a body that reassigns the walked text.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc] }
}

show: fn(items: [String]) -> String {
    joined: items.join("|")
    sizes := [String]{}
    loop item in items -> sizes.push("{item.count_bytes()}")
    widths: sizes.join(",")
    "{items.len()}:[{joined}]({widths})"
}

split_walked: fn(text: String, sep: String) -> [String] {
    out := [String]{}
    loop piece in text.split(sep) -> out.push(piece)
    out
}

split_listed: fn(text: String, sep: String) -> [String] { text.split(sep).to_list() }

lines_walked: fn(text: String) -> [String] {
    out := [String]{}
    loop line in text.lines() -> out.push(line)
    out
}

lines_listed: fn(text: String) -> [String] {
    all: text.lines()
    out := [String]{}
    loop line in all -> out.push(line)
    out
}

// Each check prints its number and verdict, not the pieces: one holds a CR.
check_split: fn(number: Int, text: String, sep: String, expected: String) {
    walked: show(split_walked(text, sep))
    listed: show(split_listed(text, sep))
    verdict: if walked == expected && listed == expected -> "ok" else -> "MISMATCH walked={walked} listed={listed}"
    print("split {number} {verdict}")
}

check_lines: fn(number: Int, text: String, expected: String) {
    walked: show(lines_walked(text))
    listed: show(lines_listed(text))
    verdict: if walked == expected && listed == expected -> "ok" else -> "MISMATCH walked={walked} listed={listed}"
    print("lines {number} {verdict}")
}

run: fn() {
    check_split(1, "a,b,,c", ",", "4:[a|b||c](1,1,0,1)")
    check_split(2, "", ",", "1:[](0)")
    check_split(3, ",", ",", "2:[|](0,0)")
    check_split(4, "abc", "", "5:[|a|b|c|](0,1,1,1,0)")
    check_split(5, "", "", "2:[|](0,0)")
    check_split(6, "aaa", "aa", "2:[|a](0,1)")
    check_split(7, "héllo wörld", "ö", "2:[héllo w|rld](8,3)")
    check_split(8, "x--y--", "--", "3:[x|y|](1,1,0)")
    check_lines(1, "a\nb\r\nc", "3:[a|b|c](1,1,1)")
    check_lines(2, "a\n", "1:[a](1)")
    check_lines(3, "", "0:[]()")
    check_lines(4, "\n", "1:[](0)")
    check_lines(5, "\n\n", "2:[|](0,0)")
    check_lines(6, "a\r\n\r\nb\r", "3:[a||b\r](1,0,2)")

    text := "one two three"
    seen := [String]{}
    loop word in text.split(" ") {
        text = "changed"
        stop: word == "two"
        seen.push(word)
        if stop -> break
    }
    print("reassigned {show(seen)} {text}")

    doc := "first\nsecond\nthird"
    kept := [String]{}
    loop line in doc.lines() {
        doc = ""
        kept.push(line)
    }
    print("lines reassigned {show(kept)} {doc.count_bytes()}")

    indexed := [String]{}
    loop (i, line) in "x\ny".lines() -> indexed.push("{i}{line}")
    loop (i, line) in "p\r\nq\n".lines() -> indexed.push("{i}{line}")
    print("indexed {show(indexed)}")

    left: "alpha beta"
    right: "gamma"
    fresh := [String]{}
    loop word in "{left} {right}".split(" ") -> fresh.push(word)
    print("fresh {show(fresh)}")

    count := 0
    long := 0
    bytes := 0
    loop line in "alpha beta gamma\ndelta epsilon 12".split("\n") {
        loop word in line.split(" ") {
            size: word.count_bytes()
            count += 1
            bytes += size
            if size > 4 -> long += 1
        }
    }
    print("words={count} long={long} bytes={bytes}")
}
