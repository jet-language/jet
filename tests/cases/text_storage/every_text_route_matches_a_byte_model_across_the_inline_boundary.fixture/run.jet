// Text storage differential: every route that builds a String agrees, byte
// for byte, with a [U8] model built apart from String, at every length from
// empty to well past the 64 bytes a text keeps in its own block.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc] }
}

UNITS: 150
ALPHABET: "abcdefghijklmnopqrstuvwxyz"

// Unit i of a text: mostly ASCII, with 2-byte and 4-byte scalars mixed in, so
// the byte length crosses 64 and 128 at uneven unit counts.
unit_text: fn(i: Int) -> String {
    if i % 7 == 3 -> return "é"
    if i % 11 == 5 -> return "🙂"
    ALPHABET.slice(i % 26, i % 26 + 1)
}

unit_bytes: fn(i: Int, model: &[U8]) {
    source: if i % 7 == 3 -> "é".bytes() else if i % 11 == 5 -> "🙂".bytes() else -> [U8]{ALPHABET.bytes()[i % 26]}
    loop byte in source -> model.push(byte)
}

same: fn(got: String, model: [U8]) -> Bool {
    bytes: got.bytes()
    if bytes.len() != model.len() || got.count_bytes() != model.len() -> return false
    loop k in 0..<model.len() {
        if bytes[k] != model[k] -> return false
    }
    true
}

run: fn() {
    names: [String]{"+=", "shared +=", "interpolation", "join", "split", "slice", "clear", "clone", "grown clone"}
    whole := ""
    loop i in 0..<UNITS -> whole += unit_text(i)
    rows := 0
    mismatches := 0
    checksum := 0
    loop n in 0..<UNITS {
        model := [U8]{}
        loop i in 0..<n -> unit_bytes(i, model)
        grown := ""
        loop i in 0..<n -> grown += unit_text(i)
        half: n /% 2
        left := ""
        loop i in 0..<half -> left += unit_text(i)
        right := ""
        loop i in half..<n -> right += unit_text(i)
        parts := [String]{}
        loop i in 0..<n -> parts.push(unit_text(i))
        split := ""
        loop piece in parts.join(",").split(",") -> split += piece
        cleared := parts.join("")
        cleared = ""
        loop i in 0..<n -> cleared += unit_text(i)
        // `joined` shares `left`'s text, so its `+=` builds a fresh one.
        joined := left.to_string()
        joined += right
        kept: grown.to_string()
        grown += "!"
        routes: [String]{kept, joined, "{left}{right}", parts.join(""), split, whole.slice(0, n), cleared, kept.to_string(), grown}
        bang := [U8]{}
        loop byte in model -> bang.push(byte)
        bang.push("!".bytes()[0])
        loop k in 0..<routes.len() {
            rows += 1
            expected: if k == routes.len() - 1 -> bang else -> model
            if !same(routes[k], expected) {
                mismatches += 1
                print("mismatch: {names[k]} at {n} units")
            }
        }
        loop byte in bang -> checksum = (checksum * 31 + Int{byte}) % 1000000007
    }
    print("rows={rows} mismatches={mismatches} checksum={checksum}")
}
