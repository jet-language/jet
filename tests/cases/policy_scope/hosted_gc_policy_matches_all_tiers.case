# Port of tests/policy_scope.rs:168-174; existing source/golden reused verbatim.
# tir_support/mod.rs411-497: all three modes and exact output/baseline equality retained.
env: NO_COLOR=1
env: JETPACK_ENV=1
mkdir: release
mkdir: default
mkdir: interpret
step release: jet run --release {root}/Examples/features/memory/gc_cyclic.jet
env: JET_STORE_DIR={work}/release/cache
env: JETPACK_ROOT={work}/release/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/gc_cyclic.out
step: jet run {root}/Examples/features/memory/gc_cyclic.jet
env: JET_STORE_DIR={work}/default/cache
env: JETPACK_ROOT={work}/default/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/gc_cyclic.out
stdout: == release
step: jet run --interpret {root}/Examples/features/memory/gc_cyclic.jet
env: JET_STORE_DIR={work}/interpret/cache
env: JETPACK_ROOT={work}/interpret/jetpack
exit: 0
stdout: = ../../../Examples/features/expected/memory/gc_cyclic.out
stdout: == release
