// The rendered L0535 snapshot (impl_placement.warn); the case copies this as impl_placement.jet.
// `jet check --style` flags each top-level impl of a struct or enum this file
// declares (L0535). A target-specific impl (rule d) stays where it is.
Label: trait {
    label: fn(self) -> String
}

Shape: struct {
    side: Int
}

impl Shape {
    area: fn(self) -> Int { self.side * self.side }
}

impl Shape.Display {
    display: fn(self) -> String { "shape {self.side}" }
}

Color: enum {
    Red
    Blue
}

impl Color {
    warm: fn(self) -> Bool {
        if self == {
            .Red -> true
            .Blue -> false
        }
    }
}

#Target(OS.Linux)
impl Shape.Label {
    label: fn(self) -> String { "linux shape" }
}

Boxed: struct<T> {
    inner: T
}

// A conditional impl (rule h) stays where it is: a nested impl
// could not state `T: Label`.
impl Boxed<T: Label>.Label {
    label: fn(self) -> String { "boxed {self.inner.label()}" }
}

run: fn() {
    shape: Shape{side: 3}
    print(shape.area())
    print(shape)
    print(Color.Red.warm())
}
