# Claim: jet check --style renders each detached impl (L0535) with what, why, fix and its source line, pinned by impl_placement.warn
# Claim: a target-specific impl (exception rule d) is not flagged
fixture: impl_placement.fixture
env: NO_COLOR=1
# The fixture keeps its detached impls in impl_placement.source, outside the .jet corpus the impl placement guard sweeps.
copy: impl_placement.source impl_placement.jet
step: jet check --style impl_placement.jet
exit: 0 # a style finding is a warning, not an error
stderr: = impl_placement.warn
