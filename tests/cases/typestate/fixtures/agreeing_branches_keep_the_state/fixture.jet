
Order: struct {
    state { Draft, Confirmed, Cancelled, Closed }
    id: Int

    #State(_ -> Draft) start: fn(id: Int) -[]> Order { return Order{ id: id } }
    #State(Draft -> Confirmed) confirm: fn(self: &&Order) -[]> Order { return self }
    #State(Draft -> Cancelled) cancel: fn(self: &&Order) -[]> Order { return self }
    #State(Confirmed -> Closed) close: fn(self: &&Order) -[]> Order { return self }
    #State(Cancelled -> Closed) archive: fn(self: &&Order) -[]> Order { return self }
    #State(Confirmed) ship: fn(self) -[]> Int { return self.id }
}

decide: fn(paid: Bool) {
  order := Order.start(1)
  if {
    paid -> order = order.confirm()
    else -> order = order.confirm()
  }
  print(order.ship())
}
run: fn() { decide(true) }
