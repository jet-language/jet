
Flow: struct {
    state {
        Start -> Done, Cancelled
        Done
        Cancelled
        Orphan
    }

    start: fn() -[]> Flow.Start { return Flow{} }
    done: fn(self: &&Flow.Start) -[]> Flow.Done { return self }
    cancel: fn(self: &&Flow.Start) -[]> Flow.Cancelled { return self }
}
    run: fn() {}
