
struct Flow {
    state { Start, Done, Cancelled, Orphan }
}
impl Flow {
    #Transition(_, Start) fn start() -[]> Flow { return Flow{} }
    #Transition(Start, Done) fn done(self: ^Flow) -[]> Flow { return self }
    #Transition(Start, Cancelled) fn cancel(self: ^Flow) -[]> Flow { return self }
}
    fn run() {}
