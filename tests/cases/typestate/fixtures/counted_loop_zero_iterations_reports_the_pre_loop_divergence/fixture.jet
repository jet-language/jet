
Order: struct {
    state { Draft, Confirmed, Cancelled, Closed }
    id: Int
}

impl Order {
    #Transition(_, Draft) start: fn(id: Int) -[]> Order { return Order{ id: id } }
    #Transition(Draft, Confirmed) confirm: fn(self: ^Order) -[]> Order { return self }
    #Transition(Draft, Cancelled) cancel: fn(self: ^Order) -[]> Order { return self }
    #Transition(Confirmed, Closed) close: fn(self: ^Order) -[]> Order { return self }
    #Transition(Cancelled, Closed) archive: fn(self: ^Order) -[]> Order { return self }
    #State(Confirmed) ship: fn(self) -[]> Int { return self.id }
}

decide: fn(n: Int) {
  order := Order.start(1)
  loop i := 0, i < n {
    fresh := Order.start(2)
    order = fresh.confirm()
  }
  print(order.ship())
}
run: fn() { decide(1) }
