
Reservation: struct {
    state { Pending, Confirmed, CheckedIn }
    guest: String
}

impl Reservation {
    #Transition(_, Pending) book: fn(guest: String) -[]> Reservation {
        return Reservation{ guest: guest.copy() }
    }
    #Transition(Pending, Confirmed) pay: fn(self: ^Reservation) -[]> Reservation {
        return self
    }
    #Transition(Confirmed, CheckedIn) check_in: fn(self: ^Reservation) -[]> Reservation {
        return self
    }
    #State(CheckedIn) room_key: fn(self) -[]> String {
        return "key"
    }
}

run: fn() {
  r := Reservation.book("a")
  r = ^r.pay()
  r = ^r.check_in()
  print(r.room_key())
}
