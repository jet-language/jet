
Gate: struct {
    state {
        Closed -> Reopened
        Reopened
    }
    w: Int

    new: fn(w: Int) -[]> Gate.Closed { return Gate{ w: w } }
    hold: fn(self: &&Gate.Closed) -[]> Gate.Closed { return self }
    reopen: fn(self: &&Gate.Closed) -[]> Gate.Reopened { return self }
}

run: fn() {
    g := Gate.new(1)
    g = g.hold()
    g = g.reopen()
}
