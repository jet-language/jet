
Gate: struct {
    state { Closed, Reopened }
    w: Int
}

impl Gate {
    #State(_ -> Closed) new: fn(w: Int) -[]> Gate { return Gate{ w: w } }
    #State(Closed -> Closed) hold: fn(self: &&Gate) -[]> Gate { return self }
    #State(Closed -> Reopened) reopen: fn(self: &&Gate) -[]> Gate { return self }
}

run: fn() {
    g := Gate.new(1)
    g = g.hold()
    g = g.reopen()
}
