
Settlement: struct {
    state { Queued, Approved, Settled }
}

impl Settlement {
    #Transition(_, Queued) begin: fn() -[]> Settlement { Settlement{} }
    #Transition(Queued, Approved) approve: fn(self: &&Settlement) -[]> Settlement { self }
    #Transition(Approved, Settled) settle: fn(self: &&Settlement) -[]> Settlement { self }
    #State(Settled) report: fn(self) -[]> String { "settled" }
}

STATE_INFO: comptime { Settlement.reflect() }

run: fn() {
    item := Settlement.begin()
    item = item.approve()
    item = item.settle()
    print(item.report())
    print(STATE_INFO.states[2].terminal)
    print(STATE_INFO.states[2].reachable ?? false)
}
