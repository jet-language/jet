
Reservation: struct {
    state { Pending, Confirmed, CheckedIn }
    guest: String
}

impl Reservation {
    #State(_ -> Pending) book: fn(guest: String) -[]> Reservation {
        return Reservation{ guest: guest.copy() }
    }
    #State(Pending -> Confirmed) pay: fn(self: &&Reservation) -[]> Reservation {
        return self
    }
    #State(Confirmed -> CheckedIn) check_in: fn(self: &&Reservation) -[]> Reservation {
        return self
    }
    #State(CheckedIn) room_key: fn(self) -[]> String {
        return "key"
    }
}

run: fn() {
  r := Reservation.book("a")
  r = r.check_in()
}
