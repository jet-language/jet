
Box: struct<T> {
    state {
        Empty -> Full
        Full
    }
    value: T

    new: fn(value: &&T) -[]> Box<T> {
        return Box<T>{ value: value }
    }
    fill: fn(self: &&Box<T>) -[]> Box<T> {
        return self
    }

    read: fn(self) -[]> T {
        return self.value
    }
}

run: fn() {
    box := Box<Int>.new(1)
    box = box.fill()
    print(box.read())
}
