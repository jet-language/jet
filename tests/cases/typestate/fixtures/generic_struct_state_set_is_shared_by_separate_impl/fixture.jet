
Box: struct<T> {
    state { Empty, Full }
    value: T
}

impl Box {
    #Transition(_, Empty) new: fn(value: ^T) -[]> Box<T> {
        return Box<T>{ value: value }
    }
    #Transition(Empty, Full) fill: fn(self: ^Box<T>) -[]> Box<T> {
        return self
    }
}

impl Box {
    #State(Full) read: fn(self) -[]> T {
        return self.value
    }
}

run: fn() {
    box := Box<Int>.new(1)
    box = ^box.fill()
    print(box.read())
}
