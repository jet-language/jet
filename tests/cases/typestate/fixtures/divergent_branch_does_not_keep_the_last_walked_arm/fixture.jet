
Order: struct {
    state {
        Draft -> Confirmed, Cancelled
        Confirmed -> Closed
        Cancelled -> Closed
        Closed
    }
    id: Int

    start: fn(id: Int) -[]> Order.Draft { return Order{ id: id } }
    confirm: fn(self: &&Order.Draft) -[]> Order.Confirmed { return self }
    cancel: fn(self: &&Order.Draft) -[]> Order.Cancelled { return self }
    close: fn(self: &&Order.Confirmed) -[]> Order.Closed { return self }
    archive: fn(self: &&Order.Cancelled) -[]> Order.Closed { return self }
    ship: fn(self: Order.Confirmed) -[]> Int { return self.id }
}

decide: fn(paid: Bool) {
  order := Order.start(1)
  if {
    paid -> order = order.confirm()
    else -> order = order.cancel()
  }
  print(order.ship())
}
run: fn() { decide(true) }
