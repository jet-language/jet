// D-SUBJECT-CALL1: where the expected argument is a one-parameter callable, a bare
// member chain stands for that lambda, including method calls along the chain.
User: struct {
    name: String
    active: Bool
    tags: [String]
}

run: fn() {
    users: [User{name: "ann", active: true, tags: ["a", "bb"]}, User{name: "bo", active: false, tags: []}, User{name: "cy", active: true, tags: ["ccc"]}]
    short: users.filter(.active).map(.name.to_upper())
    long: users.filter(fn(user) { user.active }).map(fn(user) { user.name.to_upper() })
    print(short)
    print(short == long)
    counts: users.map(.tags.len())
    print(counts)
}
