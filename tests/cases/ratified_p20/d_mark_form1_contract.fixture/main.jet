// D-MARK-FORM1: a marker, or one bracket group, sits right before its target;
// parentheses appear exactly when arguments are written.
#Inline
double: fn(x: Int) -> Int { x * 2 }

#[Inline, Pre(x > 0, "x is positive")]
triple: fn(x: Int) -> Int { x * 3 }

#Codable
Point: struct {
    x: Int
    #Rename("why") y: Int
}

run: fn() {
    print(double(2))
    print(triple(2))
    p: Point{x: 1, y: 2}
    print(p.x + p.y)
}
