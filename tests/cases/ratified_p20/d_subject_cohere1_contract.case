# D-SUBJECT-COHERE1 (#4284 c7): a `.method(args)` head chain is legal in call
# slots, as it is in loops. Shorthand inside another shorthand scope raises the
# `subject_shorthand_nesting` lint (L0512) with the named-binding rewrite.
fixture: d_subject_cohere1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = d_subject_cohere1_contract.stdout.expected
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = d_subject_cohere1_contract.stdout.expected
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = d_subject_cohere1_contract.stdout.expected
stderr: empty
step clean: jet check main.jet
exit: 0
stderr: !~ "SubjectShorthandNesting" # one shorthand scope per call slot is clean
step nested: jet check nested/main.jet
exit: 0 # the lint warns; it does not refuse the program
stderr: ~ "Warning [jet.SubjectShorthandNesting]: Subject shorthand `.len(…)` is nested inside another subject shorthand" # the lint fires
stderr: ~ "--> main.jet:8:32" # located at the inner shorthand
stderr: ~ "Fix: Rewrite it with a named binding: `fn(item) { item.len(…) }`" # named-binding rewrite
stderr: ~ "jet-lang.dev/e/L0512" # one registered lint code
