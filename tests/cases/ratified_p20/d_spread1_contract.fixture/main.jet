// D-SPREAD1: `prefix.[a, b]` means `[prefix.a, prefix.b]` in any Jet code.
User: struct {
    name: String
    email: String
    city: String
}

contact: fn(user: User) -> [String] { user.[name, email] }

run: fn() {
    u: User{name: "ann", email: "ann@example.com", city: "Oslo"}
    spread: contact(u)
    expanded: [u.name, u.email]
    print(spread)
    print(spread == expanded)
    print(spread.len())
    // In list position the members splice into the surrounding list.
    row: ["user", u.[name, city], "end"]
    print(row)
    print(row.len())
}
