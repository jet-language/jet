# D-DEFAULT-SHAPE1 (#4284 c1): a default rides the type as `Type{value}`. A
# binding `n: Int{3}` owns its value; a field `port: Int{3000}` and a parameter
# `times: Int{2}` ship holding it and the caller may override it; a field
# `host: String` ships empty and the caller must fill it. `=` and `:=` are not
# declaration defaults, and neither rejection teaches the retired spelling.
fixture: d_default_shape1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = d_default_shape1_contract.stdout.expected
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = d_default_shape1_contract.stdout.expected
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = d_default_shape1_contract.stdout.expected
stderr: empty
step required: jet check required/main.jet
exit: 1
stderr: ~ "Error [jet.InvalidConstructionField]: Struct literal for `Config` is missing fields: host" # the slot without `{…}` must be filled
stderr: ~ "--> main.jet:8:8" # located at the literal that leaves `host` out
stderr: ~ "jet-lang.dev/e/E0303" # one registered code
step equals: jet check equals/main.jet
exit: 1 # `port = 3000` is not a field default
stderr: ~ "--> main.jet:3:5" # located at the `=` field
stderr: !~ "Int{" # no teaching diagnostic for the retired form
stderr: !~ "default" # no diagnostic names `=` as a default spelling
step walrus: jet check walrus/main.jet
exit: 1 # `port := 3000` is not a field default
stderr: ~ "Expected `:` after a struct field name, found `:=`" # ordinary parse error
stderr: ~ "--> main.jet:3:10" # located at the `:=`
stderr: !~ "Int{" # no teaching diagnostic for the retired form
