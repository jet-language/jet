# D-SUBJECT-CALL1: where the expected argument is a one-parameter
# callable, a bare member chain, method calls included, stands for that lambda
# and gives the same result as the written lambda. A callable with two
# parameters refuses the shorthand and names the full lambda.
fixture: d_subject_call1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = d_subject_call1_contract.stdout.expected
stderr: empty
step o1: jet run -O1 main.jet
exit: 0
stdout: = d_subject_call1_contract.stdout.expected
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = d_subject_call1_contract.stdout.expected
stderr: empty
step two_params: jet check two_params/main.jet
exit: 1
stderr: ~ "A bare member chain cannot supply a 2-parameter callable here" # one-parameter slots only
stderr: ~ "--> main.jet:4:18" # located at the shorthand
stderr: ~ "Fix: Write the full lambda, for example `fn(first, second) { first.len(…) }`" # names the full lambda
