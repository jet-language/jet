// The written equality and order compare a computed value, not one field
// path, so `jet fix` leaves them for a hand edit: an all-fields key would
// order the values differently than the written `compare`.
Reading: struct {
    celsius: Int

    impl Equatable {
        equal: fn(self, rhs: Reading) -> Bool { self.celsius / 10 == rhs.celsius / 10 }
    }

    impl Comparable {
        compare: fn(self, rhs: Reading) -> Ordering { (self.celsius / 10).compare(rhs.celsius / 10) }
    }
}

run: fn() {
    seen := [Reading: Bool]{}
    seen[Reading{celsius: 21}] = true
    print(seen.len())
}
