// D-DEFAULT-SHAPE1: a default rides the type as `Type{value}`.
Config: struct {
    port: Int{3000}
    host: String
    retries: Int?{None}
}

greet: fn(who: String, times: Int{2}) {
    loop i in 0..<times {
        print("hello {who}")
    }
}

run: fn() {
    // A binding owns its typed value.
    n: Int{3}
    print(n)
    // A field default ships in the slot; the caller may override it.
    shipped: Config{host: "a"}
    print(shipped.port)
    print(shipped.retries ?? -1)
    overridden: Config{host: "b", port: 8080, retries: 2}
    print(overridden.port)
    print(overridden.retries ?? -1)
    // A parameter default fills a trailing argument; a label overrides it.
    greet("x")
    greet("y", times: 1)
}
