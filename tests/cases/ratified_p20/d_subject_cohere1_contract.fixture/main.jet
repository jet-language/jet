// D-SUBJECT-COHERE1: a `.method(args)` head chain is legal in call slots, as in loops.
run: fn() {
    words: ["one", "three", "five"]
    print(words.map(.len()))
    print(words.map(.replace("e", "E")))
    print(words.filter(.starts_with("t")))
    long: loop words if .len() > 3 -> .to_upper()
    print(long)
}
