use compiler: core.compiler

#Test("original FFI leaf lexer diagnostics and nonempty parsed items") {
    // The original FFI leaf source, in the colon declaration spelling (D-DECL-COLON1):
    // "\nMESSAGE: prep { \"ffi leaf\" }\n\nrun: fn() -[FFI.Py, IO]> {\n    print(MESSAGE)\n}\n"
    source: comptime { String.from_bytes([U8]{10,77,69,83,83,65,71,69,58,32,112,114,101,112,32,123,32,34,102,102,105,32,108,101,97,102,34,32,125,10,10,114,117,110,58,32,102,110,40,41,32,45,91,70,70,73,46,80,121,44,32,73,79,93,62,32,123,10,32,32,32,32,112,114,105,110,116,40,77,69,83,83,65,71,69,41,10,125,10}) ?? panic("original source UTF-8") }
    // Lexed and parsed values exist only while compiling (E0956), so the
    // claims are computed there and the test reads the plain Bools.
    lexed_clean: comptime { (compiler.lex(source) ?? panic("lex original FFI source")).diagnostics.is_empty() }
    assert(lexed_clean)
    parsed_items: comptime { !(compiler.parse(source) ?? panic("parse original FFI source")).items.is_empty() }
    assert(parsed_items)
}
