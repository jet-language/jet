// Typed task channels across a task and the generic timers: a record sent
// by a producer task and delivered by after<T>, waitall and waitany over
// String receivers, and interval's Int ticks.
package: {
    name: "typed_task_timers"
    authority: { allow: [IO, Time, Time.Wait] }
}

use tasks: core.tasks

Order: struct {
    id: Int
    item: String
    tags: [String]
}

show: fn(order: Order) -> String {
    "{order.id} {order.item} [{order.tags.join(",")}]"
}

state: fn<T>(value: T?) -> String {
    if value == {
        Val(_) -> "value"
        None -> "closed"
    }
}

run: fn() {
    task.group g {
        { sender, receiver }: channel<Order>(1)
        producer: task &&sender {
            sender.send(Order{id: 4, item: "soup", tags: [String]{"warm"}})
            sender.close()
        }
        loop {
            order: tasks.recv(receiver) ?? break
            print(show(order))
        }
        producer.join() ?? panic("producer failed")
        print(state(tasks.recv(receiver)))

        timed: tasks.after(1ms, Order{id: 3, item: "late", tags: [String]{"timer"}})
        print(tasks.is_timer(timed))
        print(show(tasks.recv(timed) ?? panic("timer closed")))
        print(state(tasks.recv(timed)))

        loop word in tasks.waitall([Receiver<String>]{tasks.after(0ms, "a"), tasks.after(0ms, "b")}) {
            print(word ?? "closed")
        }
        either: tasks.waitany([Receiver<String>]{tasks.after(0ms, "first")})
        print("{either.index} {either.value ?? "closed"}")

        ticks: tasks.interval(1ms)
        print(tasks.recv(ticks) ?? panic("interval closed"))
        _: tasks.cancel(ticks)
    }
}
