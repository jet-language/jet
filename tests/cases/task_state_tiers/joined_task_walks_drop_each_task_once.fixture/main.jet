// A walk of a List of Tasks consumes the List: each step takes its Task, so
// the join in the body ends it and the List's own drop ends none again. A
// `[T#N]` of Tasks is carried as such a List and walks the same way. A walk
// of a taken Map of Tasks takes each value out of its entry the same way.
job: fn(n: Int) -> Int Never! { n * 2 }

joined: fn() -> Int {
    total := 0
    task.group pool(limit: 2) {
        numbers: [Int]{1, 2, 3}
        handles: loop n in numbers -> task job(n)
        loop handle in handles {
            got: handle.join() ?? 0
            total += got
        }
    }
    total
}

indexed: fn() -> Int {
    total := 0
    task.group pool(limit: 2) {
        numbers: [Int]{4, 5, 6}
        handles: loop n in numbers -> task job(n)
        loop (index, handle) in handles {
            got: handle.join() ?? 0
            total += got * (index + 1)
        }
    }
    total
}

fixed: fn() -> Int {
    total := 0
    task.group pool(limit: 2) {
        handles: [Task<Int> # 2]{task job(7), task job(8)}
        loop handle in handles {
            got: handle.join() ?? 0
            total += got
        }
    }
    total
}

mapped: fn() -> Int {
    total := 0
    task.group pool(limit: 2) {
        handles := [String: Task<Int>]{}
        handles["a"] = task job(1)
        handles["b"] = task job(2)
        handles["c"] = task job(3)
        loop (name, handle) in handles.move() {
            got: handle.join() ?? 0
            if name == "b" -> next
            total += got + name.count_bytes()
        }
    }
    total
}

keyed: fn() -> Int {
    total := 0
    task.group pool(limit: 2) {
        handles := [Int: Task<Int>]{}
        handles[7] = task job(10)
        handles[9] = task job(11)
        loop (key, handle) in handles.move() {
            total += key + (handle.join() ?? 0)
        }
    }
    total
}

run: fn() {
    print("joined {joined()}")
    print("indexed {indexed()}")
    print("fixed {fixed()}")
    print("mapped {mapped()}")
    print("keyed {keyed()}")
}
