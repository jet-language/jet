from_ne: fn(x: Int?) -> Int {
    if x != None {
        return x + 1
    }
    return 0
}
from_else: fn(x: Int?) -> Int {
    if x == None {
        return 0
    } else {
        return x + 2
    }
}
and_tail: fn(x: Int?) -> Int {
    if x != None && x > 0 {
        return x
    }
    return -1
}
still_binds: fn(x: Int?) -> Int {
    if x == Val(n) {
        return n * 10
    }
    return -2
}
text_ne: fn(x: String?) -> String {
    if x != None {
        return x
    }
    return "?"
}
run: fn() {
    print(from_ne(Val(3)))
    print(from_ne(None))
    print(from_else(Val(5)))
    print(from_else(None))
    print(and_tail(Val(7)))
    print(and_tail(Val(0)))
    print(and_tail(None))
    print(still_binds(Val(4)))
    print(text_ne(Val("hi")))
    print(text_ne(None))
}
