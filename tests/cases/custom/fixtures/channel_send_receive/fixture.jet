
fn run() {
{ sender: s1, receiver: ch } :: channel<Int>()
    s2 :: s1.copy()
    t1 :: task {
        s1.send(30)
    }
    t2 :: task {
        s2.send(12)
    }
    t1.join() ?? panic("task failed")
    t2.join() ?? panic("task failed")
    s1.close()
    s2.close()
    results := [Int]{}
    loop value in ch -> &results.push(value)
    &results.sort()
    loop x in results {
        print(x)
    }
}
