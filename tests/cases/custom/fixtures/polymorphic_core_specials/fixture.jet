use {
    math: core.math
    random: core.math.random
    io: core.term
}
calc: fn() -> Int {
    a: math.abs((-5))
    b: min(3, 7)
    c: max(3, 7)
    d: clamp(15, 0, 10)
    io.eprint("trace: {a} {b} {c} {d}")
    xs := [1, 2, 3]
    random.shuffle(&xs)
    p: random.pick(xs)
    return ((((a + b) + c) + d) + (p ?? 0))
}
run: fn() {
    print(calc())
}
