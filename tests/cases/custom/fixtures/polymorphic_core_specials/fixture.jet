use core.math as math
use core.math.random as random
use core.term as io
fn calc() -> Int {
    a :: math.abs((-5))
    b :: min(3, 7)
    c :: max(3, 7)
    d :: clamp(15, 0, 10)
    io.eprint("trace: {a} {b} {c} {d}")
    xs := [1, 2, 3]
    random.shuffle(&xs)
    p :: random.pick(xs)
    return ((((a + b) + c) + d) + (p ?? 0))
}
fn run() {
    print(calc())
}
