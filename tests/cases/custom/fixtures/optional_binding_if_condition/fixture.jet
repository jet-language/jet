describe: fn(x: Int?) -> String {
    if x == Val(n) {
        return "got {n}"
    }
    if x == None {
        return "nothing"
    }
    return "?"
}
first_even: fn(xs: [Int]) -> Int {
    out := [Int]{}
    i := 0
    loop i < xs.len() {
        if xs.get(i) == Val(v) {
            out.push(v)
        }
        i+= 1
    }
    return out.len()
}
run: fn() {
    print(describe(Val(7)))
    print(describe(None))
    print(first_even([1, 2, 3]))
}
