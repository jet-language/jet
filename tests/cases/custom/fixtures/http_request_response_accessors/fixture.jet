use {
    http: core.http
    server: core.http.server
}
handle: fn(req: HTTPRequest) -> HTTPResponse {
    m: req.method()
    p: req.path()
    h: req.header("host")
    q: req.param("id")
    body: "m={m} p={p}"
    return server.response(200, body)
}
describe: fn(resp: HTTPResponse) -> String {
    s: resp.status()
    b: resp.body().text(1048576) ?? "invalid body"
    return "{s}: {b}"
}
run: fn() {
    req: http.parse("GET /x HTTP/1.1\nHost: localhost")
    resp: handle(req)
    print(describe(resp))
}
