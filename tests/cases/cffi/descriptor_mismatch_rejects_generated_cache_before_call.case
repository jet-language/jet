# tests/cffi.rs::descriptor_mismatch_rejects_generated_cache_before_call at tests/cffi.rs:2585; hand-port
# Claim: a generated C binding cache whose descriptor stamp no longer matches is rejected with E3208 before any foreign call (tests/cffi.rs:2603-2608)
# The original called CBind::generate in-process; its public route is `jet inspect bind <header> --pkg <name> -o <cache>`. The header sits outside include paths, as the original had no header on disk.
# Fixture migrated: the header line verbatim in seed/mismatch.h; `use c.mismatch as m` is written `use m: c.mismatch`
# The original replaced the whole descriptor stamp with "stale"; the case prefixes the stamp with "stale-", which also breaks the match
# Not ported: jet::compile_with_path (internal Rust API); `jet check` runs the same loader and checker
fixture: descriptor_mismatch_rejects_generated_cache_before_call.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
mkdir: .jet/bindings/c
step: jet inspect bind seed/mismatch.h --pkg mismatch -o .jet/bindings/c/mismatch.jet
exit: 0 # tests/cffi.rs:2590 CBind::generate(...).unwrap()
capture: before = text file .jet/bindings/c/mismatch.jet
capture: stale = text file.replace_first("jet-ffi-descriptor=", "jet-ffi-descriptor=stale-") .jet/bindings/c/mismatch.jet
cap:stale: != "{cap:before}" # tests/cffi.rs:2591-2593 replacen changes the cached descriptor
write: .jet/bindings/c/mismatch.jet = "{cap:stale}"
step: jet check main.jet
exit: nonzero # tests/cffi.rs:2602 compile_with_path(...).unwrap_err()
stderr: ~ "E3208" # tests/cffi.rs:2603-2607 stale descriptor must be rejected before the foreign call
