# tests/cffi.rs::inline_ffi_pin_works_inside_manifest_project at tests/cffi.rs:3131; hand-port
# Claim: an inline `extern rust "base64@0.22"` pin compiles inside a project that has a package.jet, and the program gets its FFI bridge (tests/cffi.rs:3159-3165)
# The original skipped without cargo; this case requires it the same way.
# Not ported: out.ffi.is_some() (internal API); a successful build of a program that calls the bridged function is the public proof
requires: tool:cargo
fixture: inline_ffi_pin_works_inside_manifest_project.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0 # tests/cffi.rs:3159 inline FFI pin should work even when package.jet exists
step: built
exit: 0 # tests/cffi.rs:3165 expected an FFI bridge
stdout: = "aGk=\\n" # the bridged base64::encode("hi")
