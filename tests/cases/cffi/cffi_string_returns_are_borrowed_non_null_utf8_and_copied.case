# tests/cffi.rs::cffi_string_returns_are_borrowed_non_null_utf8_and_copied at tests/cffi.rs:2184; hand-port
# Claim: a C `const char*` returned as `String` is copied when it is valid UTF-8, and a null or non-UTF-8 return stops the program instead of printing a guess (tests/cffi.rs:2216-2229)
# Fixture migrated: the original wrote three programs beside one C library; each is its own package here (good/, null_s/, bad/) in the Examples/Interop/FFI/NativeC shape (deps strret: c@"c", C source verbatim in c/strret.c, `use c: c.strret`), because one package cannot hold three `run` entry points
# Not ported: the generated-Rust wrapper text asserts (`CStr::from_ptr`, `p.is_null()`, `to_owned()`, no `to_string_lossy`), tests/cffi.rs:2236-2242; they read Rust output the native backend does not produce
# Not ported: the cc/ar provider steps, the rustc build and -lstrret link (replaced by jet build, which compiles c/, + built)
requires: tool:cc|gcc|clang
fixture: cffi_string_returns_are_borrowed_non_null_utf8_and_copied.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
cwd: good
exit: 0 # tests/cffi.rs:2234 compile_with_path succeeds
step: built
cwd: good
exit: 0 # tests/cffi.rs:2262 run.status.success() == true for good
stdout: ~ "café\n" # tests/cffi.rs:2216 ("good", "café\n", true); tests/cffi.rs:2268 the output contains it
step: jet build main.jet
cwd: null_s
exit: 0 # tests/cffi.rs:2234
step: built
cwd: null_s
exit: nonzero # tests/cffi.rs:2262 run.status.success() == false for null_s
stderr: ~ "returned a null pointer" # tests/cffi.rs:2217,2268
step: jet build main.jet
cwd: bad
exit: 0 # tests/cffi.rs:2234
step: built
cwd: bad
exit: nonzero # tests/cffi.rs:2262 run.status.success() == false for bad
stderr: ~ "not valid UTF-8" # tests/cffi.rs:2218,2268
