use c: c.mixed

// No `#Layout`: the compiler places the fields, and c/mixed.c declares the
// struct from the `reflect().layout` checked below.
Mixed: struct {
    a: U8
    b: I64
    c: U8
    d: I64
    e: U8
}

#Import c.mixed: module {
    layout_fact: fn(which: I64) -> I64 = "jet_mixed_layout_fact"
    bump: fn(value: &Mixed) = "jet_mixed_bump"
    sum: fn(value: &Mixed) -> I64 = "jet_mixed_sum"
    remember: fn(value: &Mixed) = "jet_mixed_remember"
    same: fn(value: &Mixed) -> Bool = "jet_mixed_same"
}

SIZE: comptime { Mixed.reflect().layout.size ?? -1 }
ALIGNMENT: comptime { Mixed.reflect().layout.alignment ?? -1 }
AT_A: comptime { Mixed.reflect().layout.fields[0].offset ?? -1 }
AT_B: comptime { Mixed.reflect().layout.fields[1].offset ?? -1 }
AT_C: comptime { Mixed.reflect().layout.fields[2].offset ?? -1 }
AT_D: comptime { Mixed.reflect().layout.fields[3].offset ?? -1 }
AT_E: comptime { Mixed.reflect().layout.fields[4].offset ?? -1 }

run: fn() {
    facts: [Int]{SIZE, ALIGNMENT, AT_A, AT_B, AT_C, AT_D, AT_E}
    names: [String]{"size", "alignment", "a", "b", "c", "d", "e"}
    loop index in 0..<facts.len() {
        native: c.layout_fact(I64{index})
        if (native != I64{facts[index]}) -> panic("C {names[index]} is {native}, Mixed.reflect().layout says {facts[index]}")
    }
    print("C agrees with Mixed.reflect().layout: size {SIZE}, alignment {ALIGNMENT}, a {AT_A}, b {AT_B}, c {AT_C}, d {AT_D}, e {AT_E}")
    value := Mixed{a: U8{1}, b: I64{10}, c: U8{2}, d: I64{20}, e: U8{3}}
    c.remember(value)
    c.bump(value)
    print("{value.a} {value.b} {value.c} {value.d} {value.e}")
    print(c.sum(value))
    print(c.same(value))
}
