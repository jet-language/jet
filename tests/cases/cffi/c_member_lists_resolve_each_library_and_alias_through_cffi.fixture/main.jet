use {
    c.[m]
    libc: c.c
}

#Import c.c: module {
    clamp: fn(left: Int, middle: Int, right: Int) -> Int = "libc_clamp"
}
#Import c.m: module {
    version: fn(left: Int, middle: Int, right: Int) -> Int = "libm_version"
}

c_scope: module {
    use lib: c.c
    call: fn() -> Int {
        return lib.clamp(1, 2, 3)
    }
}
m_scope: module {
    use lib: c.m
    call: fn() -> Int {
        return lib.version(1, 2, 3)
    }
}

run: fn() { }
