use c: c.close
#Layout(c)
Handle: struct {
    value: I64
}
#Import c.close: module {
    #Close(release)
    acquire: fn() -> Handle = "jet_close_acquire"
    release: fn(handle: ^Handle) = "jet_close_release"
    released: fn() -> I64 = "jet_close_released"
}
run: fn() {
    handle := c.acquire()
    close(^handle)
    print(c.released())
}
