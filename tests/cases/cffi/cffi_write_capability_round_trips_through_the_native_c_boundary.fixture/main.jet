use c: c.cap
#Layout(c)
Pair: struct {
    x: I64
    y: I64
}
#Import c.cap: module {
    increment: fn(value: &I64) = "jet_cap_increment"
    make: fn() -> Pair = "jet_cap_make"
    consume: fn(value: &&Pair) -> I64 = "jet_cap_consume"
}
run: fn() {
    value := I64{41}
    c.increment(value)
    print(value)
    pair: c.make()
    print(c.consume(pair))
}
