# PENDING-GRAMMAR: file !~ and quoted newline escape must preserve byte predicates.
requires: tool:cobc
step: cobc --version
exit: 0
copy: {root}/Examples/interop/cobol/payroll.cob payroll.cob
copy: {root}/Examples/interop/cobol/payroll.cpy payroll.cpy
copy: {root}/Examples/interop/cobol/run.jet run.jet
copy: {root}/Examples/interop/cobol/expected.out expected.out
step: jet inspect bind cobol payroll.cob --copybook payroll.cpy --pkg payroll
exit: 0
file: .jet/bindings/cobol/payroll.jet ~ "jet-ffi-descriptor=" # original predicate
file: .jet/bindings/cobol/payroll.jet ~ "gross_pay: Decimal\n" # original predicate
file: .jet/bindings/cobol/payroll.jet ~ "offset=24 width=5 type=Decimal scale=2 encoding=COMP-3" # original predicate
file: .jet/bindings/cobol/payroll.jet !~ "gross_pay: Float" # original predicate
file: .jet/bindings/cobol/payroll.jet ~ "Int !CobolError -[FFI.Cobol]>" # original predicate
file: .jet/bindings/cobol/payroll.jet !~ "=>" # original predicate
file: .jet/bindings/cobol/payroll.provenance ~ "schema=jet-cobol-bind-v1\n" # original predicate
file: .jet/bindings/cobol/payroll.provenance ~ "descriptor=jet-ffi-descriptor-v1;" # original predicate
file: .jet/bindings/cobol/payroll.provenance ~ "program_symbol=JETPAY\n" # original predicate
file: .jet/bindings/cobol/payroll.provenance ~ "record_width=29\n" # original predicate
step: jet run run.jet
exit: 0
stdout: = ../../../Examples/interop/cobol/expected.out
