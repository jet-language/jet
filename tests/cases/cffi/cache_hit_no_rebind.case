# tests/cffi.rs::cache_hit_no_rebind at tests/cffi.rs:2852; hand-port
# Claim: with an unchanged header and a matching hash sidecar, the compiler loads the cache as-is: its bytes and its modification time do not change (tests/cffi.rs:2888-2900)
# The original called CBind::generate and CBind::write_bind_hash in-process; the case runs `jet inspect bind` and writes the same sidecar text, SHA-256("int mylib3_ping(int x);\n" || NUL)
# The original read the mtime through std::fs::metadata; the case reads it with GNU `stat -c %.9Y`, and sleeps 50 ms first as the original did
# Fixture migrated: the header line verbatim; `use "include/mylib3.h" as m` is written `use m: "include/mylib3.h"`
# Not ported: jet::compile_with_path (internal Rust API); `jet check` runs the same loader, binder and checker
requires: os-name:linux
requires: tool:stat
requires: tool:sleep
fixture: cache_hit_no_rebind.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
mkdir: .jet/bindings/c
step: jet inspect bind include/mylib3.h --pkg mylib3 -o .jet/bindings/c/mylib3.jet
exit: 0 # tests/cffi.rs:2866 CBind::generate(header_src, "mylib3").unwrap()
write: .jet/bindings/c/mylib3.hash = "3e979423c6ac72c80d1ceb339c4ff02b1f1a05e57a95277b3911e1b9a5f419e0"
copy: .jet/bindings/c/mylib3.jet cache-before.jet
step: stat -c %.9Y .jet/bindings/c/mylib3.jet
exit: 0
capture: mtime_before = text stdout
step: sleep 0.05
exit: 0
step: jet check main.jet
exit: any # tests/cffi.rs:2886 the compile result is not asserted; only the cache is
file: .jet/bindings/c/mylib3.jet == cache-before.jet
step: stat -c %.9Y .jet/bindings/c/mylib3.jet
exit: 0
stdout: = "{cap:mtime_before}"
