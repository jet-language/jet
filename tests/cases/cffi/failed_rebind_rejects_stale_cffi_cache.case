write: include/stale.h = "int malformed(int value,);\n"
step: jet check main.jet
exit: nonzero # tests/cffi.rs:2741 compile_with_path(...).unwrap_err()
stderr: ~ "E3208" # tests/cffi.rs:2743-2748 failed rebind must report E3208
