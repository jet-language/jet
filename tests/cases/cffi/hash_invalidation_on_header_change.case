# tests/cffi.rs::hash_invalidation_on_header_change at tests/cffi.rs:2646; hand-port
# Claim: when the header changes after a bind, the hash mismatch makes the compiler rebind: the cache holds the new symbol, not the old one, and the hash sidecar holds SHA-256(new header || NUL) (tests/cffi.rs:2686-2706)
# The original called CBind::generate and CBind::write_bind_hash in-process; the case runs `jet inspect bind` and writes the same sidecar text, SHA-256("int mylib2_v1(int x);\n" || NUL)
# Fixture migrated: the header lines verbatim; `use "include/mylib2.h" as m` is written `use m :: "include/mylib2.h"`
# Not ported: jet::compile_with_path (internal Rust API); `jet check` runs the same loader, binder and checker
fixture: hash_invalidation_on_header_change.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
mkdir: .jet/bindings/c
step: jet inspect bind include/mylib2.h --pkg mylib2 -o .jet/bindings/c/mylib2.jet
exit: 0 # tests/cffi.rs:2662 CBind::generate(header_v1, "mylib2").unwrap()
write: .jet/bindings/c/mylib2.hash = "f7b02b9c4acbabe1e3d090dde145699441c4376fcccdd745110f49164e8ba254"
file: .jet/bindings/c/mylib2.jet !~ "mylib2_v2" # tests/cffi.rs:2667-2670 sanity: v2 not in v1 cache
write: include/mylib2.h = "int mylib2_v2(int y);\n"
step: jet check main.jet
exit: any # tests/cffi.rs:2708-2711 the compile result is not asserted; only the cache is
file: .jet/bindings/c/mylib2.jet ~ "mylib2_v2" # tests/cffi.rs:2688-2692 cache regenerated with the updated symbol
file: .jet/bindings/c/mylib2.jet !~ "mylib2_v1" # tests/cffi.rs:2693-2697 stale v1 symbol absent from the regenerated cache
file: .jet/bindings/c/mylib2.hash = "f6d2757e997d8ad572e147364f487f859bf17d5fac3075f96bfaa0b5cd4eb698"
