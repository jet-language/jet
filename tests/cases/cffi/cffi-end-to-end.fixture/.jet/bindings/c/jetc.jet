    reset: fn() = "jetc_reset"
    value: fn() -> Int = "jetc_value_get"
    store: fn(value: Int) = "jetc_store"
    twice: fn(value: Int) -> Int = "jetc_twice"
    add_ints: fn(a: Int, b: Int) -> Int = "jetc_add_ints"
    half: fn(value: Float) -> Float = "jetc_half"
    sum6: fn(a: Float, b: Float, c: Float, d: Float, e: Float, f: Float) -> Float = "jetc_sum6"
    echo: fn(value: String) -> String = "jetc_echo"
    greeting: fn() -> String = "jetc_greeting"
}
