use c: c.cb

increment: fn(x: I32) -[]> I32 {
    return x + 1
}

#Import c.cb: module {
    call_twice: fn(cb: fn(I32) -[]> I32, x: I32) -> I32 = "call_twice"
    call_parallel: fn(cb: fn(I32) -[]> I32) -> I32 = "call_parallel"
}

run: fn() {
    print(c.call_twice(increment, 40))
    print(c.call_parallel(increment))
    print(c.call_twice(fn(x) { x + x }, 10))
}
