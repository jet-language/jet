use c: c.reprc2
#Layout(c)
Status: enum {
    Ok = 0
    Lost = 7
}
#Layout(c, tag: U8)
Packet: enum {
    Ping(Int) = 3
    Data(x: Int, y: Int) = 7
}
#Import c.reprc2: module {
    repr_status: fn(s: Status) -> I32 = "repr_status"
    repr_packet: fn(p: Packet) -> I32 = "repr_packet"
    repr_packet_size: fn() -> I32 = "repr_packet_size"
    repr_packet_align: fn() -> I32 = "repr_packet_align"
    repr_packet_payload_offset: fn() -> I32 = "repr_packet_payload_offset"
}
run: fn() {
    print(c.repr_status(Status.Lost))
    print(c.repr_packet(Packet.Ping(41)))
    print(c.repr_packet_size())
    print(c.repr_packet_align())
    print(c.repr_packet_payload_offset())
}
