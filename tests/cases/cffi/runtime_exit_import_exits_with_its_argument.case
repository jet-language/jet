# #6615 c6: an `#Import(c)` call of the runtime symbol jet_rt_process_exit ends
# the process with its argument and prints nothing of its own, on every tier
# and in the built program. Before, the exit asked the process root to publish
# a stop report that no stop had captured, so the program printed "internal
# error: entered unreachable code:" and exited 101 whatever code it passed.
fixture: runtime_exit_import_exits_with_its_argument.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 3
stdout: = "before exit\n"
stderr: = ""
step: jet run --optimize=basic main.jet
exit: 3
stdout: = "before exit\n"
stderr: = ""
step: jet run --optimize=full main.jet
exit: 3
stdout: = "before exit\n"
stderr: = ""
step: jet build main.jet
exit: 0
step: built
exit: 3
stdout: = "before exit\n"
stderr: = ""
