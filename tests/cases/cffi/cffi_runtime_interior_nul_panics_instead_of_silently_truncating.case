# tests/cffi.rs::cffi_runtime_interior_nul_panics_instead_of_silently_truncating at tests/cffi.rs:2272; hand-port
# Claim: a runtime String with an embedded NUL byte, passed to a C `const char*` parameter, stops the program loudly instead of sending C a truncated string (tests/cffi.rs:2353-2358)
# The NUL-bearing line arrives on stdin, so it is never a compile-time literal and only the runtime boundary check can see it.
# Fixture migrated: the Examples/features/lowlevel/native_c shape (deps jetc436: c@"c", C source in c/jetc436.c, `use c436 :: c.jetc436`); the cc/ar steps are dropped because jet build compiles c/
# Not ported: the rustc build, -ljetc436 link and FFI bridge arguments (replaced by jet build + built)
requires: tool:cc|gcc|clang
fixture: cffi_runtime_interior_nul_panics_instead_of_silently_truncating.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet
exit: 0 # tests/cffi.rs:2315 the front end accepts the runtime-NUL fixture
step: built
stdin: cffi_runtime_interior_nul_panics_instead_of_silently_truncating.fixture/nul.stdin
exit: nonzero # tests/cffi.rs:2353 a runtime String with an embedded NUL must not silently succeed
