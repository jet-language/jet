# tests/cffi.rs::missing_declared_header_rejects_stale_cffi_cache at tests/cffi.rs:2759; hand-port
# Claim: a header-path `use` whose header is missing reports E3208 with the cause "the header file could not be read (" and leaves the old cache bytes unchanged (tests/cffi.rs:2779-2795)
# The original called CBind::generate in-process and wrote no hash sidecar; the case runs `jet inspect bind` on a header outside include/, so include/missing.h stays absent
# Fixture migrated: the header line verbatim in seed/missing.h; `use "include/missing.h" as missing` is written `use missing: "include/missing.h"`
# Not ported: jet::compile_with_path (internal Rust API); `jet check` runs the same loader, binder and checker and prints the E3208 why text
fixture: missing_declared_header_rejects_stale_cffi_cache.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
mkdir: .jet/bindings/c
step: jet inspect bind seed/missing.h --pkg missing -o .jet/bindings/c/missing.jet
exit: 0 # tests/cffi.rs:2765-2767 CBind::generate(...).unwrap()
copy: .jet/bindings/c/missing.jet old-cache.jet
step: jet check main.jet
exit: nonzero # tests/cffi.rs:2777 compile_with_path(...).unwrap_err()
stderr: ~ "E3208" # tests/cffi.rs:2779-2784 missing declared header must report E3208
stderr: ~ "the header file could not be read (" # tests/cffi.rs:2789-2794 E3208 keeps the missing-header cause
file: .jet/bindings/c/missing.jet == old-cache.jet
