use c436: c.jetc436

// Deliberately NOT named `Point` — that's a reserved builtin UI-geometry
// type name (D-RENDERTGT2, `Codegen/Context.rs`); this exercises the
// ordinary user-struct fallback, not that special case.
#Layout(c)
Coord: struct {
    x: Int
    y: Int
}

Meters: distinct Int

#Import c.jetc436: module {
    add_u8: fn(a: U8, b: U8) -> U8 = "jetc436_add_u8"
    add_i32: fn(a: I32, b: I32) -> I32 = "jetc436_add_i32"
    add_f32: fn(a: F32, b: F32) -> F32 = "jetc436_add_f32"
    make_point: fn(x: Int, y: Int) -> Coord = "jetc436_make_point"
    point_sum: fn(p: Coord) -> Int = "jetc436_point_sum"
    scale_meters: fn(m: Meters) -> Meters = "jetc436_scale_meters"
}

run: fn() {
    print(c436.add_u8(200, 55))
    print(c436.add_i32(1000000, 234567))
    print(c436.add_f32(1.5, 2.25))
    p: c436.make_point(3, 4)
    print(c436.point_sum(p))
    print(c436.scale_meters(Meters.from_int(21)).raw())
}
