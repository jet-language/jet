fn run() {
    xs := [1, 2, 1]
    print(xs.remove(1) ?? 0)
    print(xs.count(1))
    print(xs.remove(0, .Slot) ?? 0)
    xs.extend([3, 4])
    print(xs.concat([5]).len())
    print(xs.len())
    by :: RemoveBy.Val
    print(xs.remove(1, by) ?? 0)
    print(xs.len())
    ss := ["a", "b", "a"]
    print(ss.remove("a", .Val) ?? "")
    print(ss.len())
}
