
fn probe(value: Int) -> Int {
    return (value /% 3) + (value % 3) + (value %% 3) + (value << 1) + (value >> 1)
}
fn run() {
    total := 0
    loop i in 0..<10 {
        total = total + (i /% 3)
        total = total + (i % 3)
        total = total + (i %% 3)
        total = total + (i << 1)
        total = total + (i >> 1)
    }
    print(total)
    print(probe(9223372036854775808))
}
