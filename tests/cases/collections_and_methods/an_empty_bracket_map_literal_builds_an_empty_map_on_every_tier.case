# `[K: V]{}` is the map spelling (D-LISTMAP-CANON1=A; the retired generic
# spelling is an unknown type, tests/ui/map_type_spelling_is_not_jet). The empty literal
# builds an empty map that takes entries, on O0, O1 and O2.
fixture: an_empty_bracket_map_literal_builds_an_empty_map_on_every_tier.fixture
step o0: jet run -O0 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o1: jet run -O1 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o2: jet run -O2 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
