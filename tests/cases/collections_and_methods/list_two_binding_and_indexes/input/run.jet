fn run() {
    xs := [10, 20, 30]
    loop (i, v) in xs {
        print("{i}:{v}")
    }
    loop i in xs.indexes() {
        print(i)
    }
    empty := [Int]{}
    count := 0
    loop i in empty.indexes() {
        count = (count + 1)
    }
    print(count)
    loop pair in xs.indexed() {
        print("{pair.idx}:{pair.item}")
    }
}
