count_and_keep: fn(n: Int, visits: Cell<Int>) -> Bool {
    visits.edit(fn(count) { count += 1 })
    return n % 2 == 0
}
run: fn() {
    nums := [1, 2, 3, 4]
    mapped := nums.map(fn(n: Int) { n + 1 })
    print(mapped)
    print(mapped.len())
    visits := Cell.new(0)
    visits_copy: visits.copy()
    even := nums.map(fn(n: Int) { n + 1 }).filter(fn(n: Int) { count_and_keep(n, visits_copy) ?? false })
    print(even)
    print(visits.get())
    lazy_values := nums.lazy().filter(fn(n: Int) { n > 2 }).map(fn(n: Int) { n * 10 }).to_list()
    print(lazy_values)
    parts := "a,b,c".split(",")
    print(parts.to_list())
}
