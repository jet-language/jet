fn drop_first(xs: [Int]) -[]> Int {
    ys := xs.copy()
    r := ys.remove(0, .Slot)
    return ys.len()
}
fn drop_key(m: [String:Int]) -[]> Int {
    m2 := m.copy()
    r := m2.remove("a")
    return m2.len()
}
fn run() {
    print(drop_first([10, 20, 30]))
    counts := [String:Int]{}
    counts["a"] = 1
    counts["b"] = 2
    print(drop_key(counts))
}
