
D: struct {
    value: Int

    impl Add {
        add: fn(self, rhs: D) -> D {
            pair: align(self, rhs)
            return D{value: pair.a + pair.b}
        }
    }
}
Pair: struct {
    a: Int
    b: Int
}
align: fn(left: D, right: D) -> Pair { Pair{a: left.value, b: right.value} }
run: fn() {
    sum: (D{value: 1} + D{value: 2})
    print(sum.value)
    print(Pair{a: 1, b: 2} == Pair{a: 1, b: 2})
}
