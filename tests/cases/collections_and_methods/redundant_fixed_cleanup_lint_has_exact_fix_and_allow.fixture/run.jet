
fn run() {
    value :: Float{1234.5}
    print("{value:Fixed(2)}".replace(",", ""))
    #allow(redundant_fixed_cleanup, "the second occurrence exercises local suppression") print("{value:Fixed(2)}".replace(",", ""))
    print("{value:Grouped(2)}".replace(",", ""))
    print("1,234".replace(",", ""))
    print("{value:Fixed(2)}".replace(",", ","))
}
