// Spans past the runtime fill's 16384-byte chunk: a 3-byte pattern (block
// copies), a 2-byte pattern ending on half a word, and 8-byte words.
run: fn() {
    bytes := [U8]{}
    loop i in 0..<100003 {
        bytes.push(0)
    }
    bytes.fill_repeat(1..<100002, [U8]{1, 2, 3})
    sum := 0
    loop b in bytes {
        sum = sum + Int{b}
    }
    print("{sum} {bytes[0]} {bytes[1]} {bytes[100000]} {bytes[100001]} {bytes[100002]}")
    pairs := [U8]{}
    loop i in 0..<40001 {
        pairs.push(0)
    }
    pairs.fill_repeat(0..<40001, [U8]{5, 7})
    paired := 0
    loop b in pairs {
        paired = paired + Int{b}
    }
    print("{paired} {pairs[40000]}")
    ints := [Int]{}
    loop i in 0..<30000 {
        ints.push(1)
    }
    ints.fill(0..<30000, -3)
    total := 0
    loop n in ints {
        total = total + n
    }
    print(total)
}
