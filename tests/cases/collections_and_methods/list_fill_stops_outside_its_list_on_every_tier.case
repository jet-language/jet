step: jet run negative_start.jet
exit: == negative_start
stdout: empty
stderr.filter(~ "Stop [E3001]:").line(0).split(" — ", 0): == negative_start # the slice stop line without the source suffix
step: jet build --release empty_pattern.jet
exit: 0
step empty_pattern: built
exit: nonzero
stdout: empty
stderr.filter(~ "Stop [E3010]:").line(0).split(" — ", 0): = "Stop [E3010]: `the list has 0 items, so position 0 doesn't exist`" # the list bounds stop line without the source suffix
step: jet run empty_pattern.jet
exit: == empty_pattern
stdout: empty
stderr.filter(~ "Stop [E3010]:").line(0).split(" — ", 0): == empty_pattern # the list bounds stop line without the source suffix
when tool node
