// Sets of 2,000,000 distinct Int and String keys: built, probed, copied,
// cleared, removed from and walked. A sorted array would move half its keys
// on each insert, so the run ending inside its step timeout proves the
// inserts do not.
run: fn() {
    count: 2000000
    numbers := Set<Int>.new()
    loop i in 0..<count {
        numbers.add((i * 7919) % count)
    }
    again := 0
    loop i in 0..<1000 {
        if numbers.add(i) {
            again += 1
        }
    }
    print("ints: {numbers.len()} re-added {again}")
    low: count - 10
    high: count + 10
    hits := 0
    loop key in low..<high {
        if numbers.has(key) {
            hits += 1
        }
    }
    print("hits: {hits}")
    loop k in 0..<10 {
        numbers.remove(k * 3)
    }
    total := 0
    loop n in numbers.to_list() {
        total += n
    }
    print("after remove: {numbers.len()} sum {total}")
    copied := numbers.copy()
    print("copy equal: {copied.equal(numbers)}")
    copied.add(-1)
    print("copy grown: {copied.equal(numbers)} {numbers.has(-1)} {copied.has(-1)}")
    copied.clear()
    copied.add(5)
    print("cleared: {copied.len()} {copied.has(5)} {copied.has(6)}")

    ranked := Rank<Int>.new()
    loop i in 0..<200000 {
        ranked.add((i * 7919) % 200000)
    }
    ascending := true
    previous := -1
    loop n in ranked.to_list() {
        if n <= previous {
            ascending = false
        }
        previous = n
    }
    print("rank: {ranked.len()} ascending {ascending} first {ranked.first() ?? -1} last {ranked.last() ?? -1}")

    words := Set<String>.new()
    loop i in 0..<count {
        words.add("line-{(i * 7919) % count}")
    }
    present: words.has("line-1999999")
    absent: words.has("line-2000000")
    print("words: {words.len()} {present} {absent}")
    popped := words.pop("line-7") ?? "none"
    kept: words.has("line-7")
    print("popped: {popped} {words.len()} {kept}")
    fruit := Rank.from(["pear", "apple", "fig"])
    fruit.add("kiwi")
    print("fruit: {fruit.to_list()}")
}
