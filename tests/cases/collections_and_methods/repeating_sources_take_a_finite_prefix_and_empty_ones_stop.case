# A finite prefix of a repeating source is taken without building the
# repeated items, and an empty repeating source terminates, on O0, O1 and O2.
# A materializing or spinning cycle would exceed the
# case timeout.
fixture: repeating_sources_take_a_finite_prefix_and_empty_ones_stop.fixture
step o0: jet run main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o1: jet run -O1 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
step o2: jet run -O2 main.jet
env: NO_COLOR=1
exit: 0
stdout: = expected.out
stderr: empty
