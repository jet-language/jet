// Prints the lowest level each module logs at, before and after the code's
// `set_level` for `shop.web`, so each rung of the level ladder shows in stdout.
use log: core.log

lowest: fn(debug: Bool, info: Bool, warn: Bool, error: Bool) -> String {
    if {
        debug -> "debug"
        info -> "info"
        warn -> "warn"
        error -> "error"
        else -> "critical"
    }
}

level: fn() -[Log]> String { lowest(log.enabled(.Debug), log.enabled(.Info), log.enabled(.Warn), log.enabled(.Error)) }

db: module {
    level: fn() -[Log]> String { lowest(log.enabled(.Debug), log.enabled(.Info), log.enabled(.Warn), log.enabled(.Error)) }
}

web: module {
    level: fn() -[Log]> String { lowest(log.enabled(.Debug), log.enabled(.Info), log.enabled(.Warn), log.enabled(.Error)) }
}

report: fn() -[Log, IO]> {
    print("shop={level()} shop.db={db.level()} shop.web={web.level()}")
}

run: fn() -[Log, IO]> {
    report()
    log.set_level(.Debug, path: "shop.web")
    report()
}
