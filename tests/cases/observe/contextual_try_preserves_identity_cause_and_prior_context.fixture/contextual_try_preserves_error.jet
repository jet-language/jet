impl Err.From(IOError) {
    from: fn(error: IOError) -> Err { return Err("store unavailable", code: "E_STORE", cause: Err("disk offline")) }
}

read_store: fn() -> String IOError! {
    return Err(IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: None,
        os_code: None,
        cause: Val("disk offline"),
    }))
}

load_store: fn() -> String {
    value: read_store()?("loading store")
    return value
}

open_store: fn() -> String {
    value: load_store()?("opening store")
    return value
}

run: fn() {
    _: open_store()?("running store")
}
