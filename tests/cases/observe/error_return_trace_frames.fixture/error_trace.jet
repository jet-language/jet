#Error
ParseError: enum {
    Empty
    BadDigit(String)
}
parse_age: fn(raw: String) -[]> Int ParseError! {
    if raw == "" {
        return Err(ParseError.Empty)
    }
    return Ok(42)
}
load: fn(raw: String) -[]> Int ParseError! {
    n: parse_age(raw)?("loading age")
    return Ok((n * 2))
}
double: fn(raw: String) -[]> Int ParseError! {
    n: load(raw)?("doubling age")
    return Ok((n * 2))
}
run: fn() ParseError! {
    n: double("")
    print(n)
}
