#Error
LoadError: enum {
    Missing
}

load: fn(n: Int) -> Int LoadError! {
    if n > 2 -> return Err(LoadError.Missing)
    n
}

middle: fn(n: Int) -> Int LoadError! { load(n) + 1 }

outer: fn(n: Int) -> Int LoadError! { middle(n) * 2 }

run: fn() LoadError! {
    print(outer(1))
    print(outer(5))
}
