# Port of tests/release_gates.rs::compiled_workload_release_gate_uses_frozen_contract_and_canaries; all original predicates.
requires: tool:node
requires: tool:bash
copy: {root}/Tools/ci/compiled-workload-gate.sh gate.sh
copy: {root}/Tools/ci/compiled-workload-runner.mjs runner.mjs
copy: {root}/Tools/ci/test-compiled-workload-gate.sh self-check.sh
copy: {root}/tests/compiled_workloads/canaries.tsv canaries.tsv
file: gate.sh ~ "--contract" # Original gate.contains.
file: gate.sh ~ "--check" # Original gate.contains.
file: gate.sh ~ "outcomes.tsv" # Original gate.contains.
file: gate.sh ~ "measurements.tsv" # Original gate.contains.
file: gate.sh ~ "tiers.tsv" # Original gate.contains.
file: gate.sh ~ "jet_tool_version" # Original gate.contains.
file: gate.sh ~ "peer_tool_version" # Original gate.contains.
file: gate.sh ~ "review_status" # Original gate.contains.
file: gate.sh ~ "review_evidence" # Original gate.contains.
file: gate.sh ~ "review.tsv" # Original gate.contains.
file: gate.sh ~ "reviewer_is_independent" # Original gate.contains.
file: gate.sh ~ "review_workflow" # Original gate.contains.
file: gate.sh ~ "review_run" # Original gate.contains.
file: gate.sh ~ "review_actor" # Original gate.contains.
file: gate.sh ~ "rust_tolerance_ratio" # Original gate.contains.
file: gate.sh ~ "metric_is_loss" # Original gate.contains.
file: runner.mjs ~ "runMeasured" # Original runner.contains.
file: runner.mjs ~ "process.hrtime.bigint" # Original runner.contains.
file: runner.mjs ~ "JET_WEB_CHROMIUM" # Original runner.contains.
file: runner.mjs ~ "CdpDriver" # Original runner.contains.
file: runner.mjs ~ "network=loopback-only" # Original runner.contains.
file: runner.mjs ~ "network=disabled" # Original runner.contains.
file: runner.mjs ~ "peerMeasured" # Original runner.contains.
file: runner.mjs ~ "samples" # Original runner.contains.
file: runner.mjs ~ "targetArtifactProof" # Original runner.contains.
file: runner.mjs ~ "JET_STORE_DIR" # Original runner.contains.
file: runner.mjs ~ ".jet" # Original runner.contains.
step: node {root}/Tools/ci/compiled-workload-runner.mjs --measurement-registry
exit: 0
stdout: ~ "\"linux\"" # Original measurement-registry contains.
stdout: ~ "\"macos\"" # Original measurement-registry contains.
stdout: ~ "\"windows\"" # Original measurement-registry contains.
stdout: ~ "\"VmHWM\"" # Original measurement-registry contains.
stdout: ~ "\"VmRSS\"" # Original measurement-registry contains.
stdout: ~ "\"PeakWorkingSet64\"" # Original measurement-registry contains.
stdout: ~ "\"processProperty\":\"PeakWorkingSet64\"" # Original measurement-registry contains.
for line file.after_first("\n").filter(!= "") canaries.tsv as r
write: canary.row = "{r}"
capture: canary = text file.split("\t", 1) canary.row
file: self-check.sh ~ "expect_reject {cap:canary}" # Original all nonempty rows after header; second field unwrap + self_check.contains.
end for
copy: {root}/tests/cases/compiled_workloads/compiled_workload_gate_self_check.case self-check.case
file: self-check.case ~ "Tools/ci/test-compiled-workload-gate.sh" # Original suites.txt registers the gate self-check.
step: bash {root}/Tools/ci/compiled-workload-gate.sh --contract
exit: 0
