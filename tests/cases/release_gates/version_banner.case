# Port of release_gates.rs:249-260; both CLI entry points retain the committed exact release fixture.
# The version line is `jet a0.0.N (<commit10>, <date>, alpha)` for a release and
# `jet a0.0.N-dev+<commit10>` otherwise; `normalize: version` writes either as
# VERSION, and `--json` carries the same facts.
normalize: version
step: jet version
stdout: = ../../../tests/release/version_banner.txt
step: jet --version
stdout: = ../../../tests/release/version_banner.txt
step: jet --version --json
exit: 0
stdout: ~ "\"version\":\"VERSION\",\"release\":\"VERSION\",\"released\":" # the build's spelling, then JET_VERSION
stdout: ~ "\"channel\":\"alpha\"" # the release stage the `a` names
stdout: ~ "\"release_status\":\"prerelease\"" # the banner's release lines
stdout: ~ "\"supported_editions\":[\"2026\"]" # the banner's editions line
