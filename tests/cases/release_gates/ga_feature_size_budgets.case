# Port of tests/release_gates.rs::ga_feature_size_budgets; all original predicates, runtime UNRUN.
requires: tool:rustc
mkdir: .jet/build
step: jet build --small {root}/Examples/Basics/Hello.jet
exit: 0
file: .jet/build/Hello size > 0
file: .jet/build/Hello size <= 512000
step: jet build --small {root}/Examples/Systems/CLI/CLIArgs.jet
exit: 0
file: .jet/build/CLIArgs size > 0
file: .jet/build/CLIArgs size <= 524288
step: jet build --small {root}/Examples/Network/HTTP/HTTPServer.jet
exit: 0
file: .jet/build/HTTPServer size > 0
file: .jet/build/HTTPServer size <= 3145728
step: jet build --small {root}/Examples/Modules/Library.jet
exit: 0
file: .jet/build/Library size > 0
file: .jet/build/Library size <= 4194304
step: jet build --small {root}/Examples/LowLevel/LowLevel.jet
exit: 0
file: .jet/build/LowLevel size > 0
file: .jet/build/LowLevel size <= 4194304
step: jet build --small {root}/Examples/LowLevel/Freestanding.jet
exit: 0
file: .jet/build/Freestanding size > 0
file: .jet/build/Freestanding size <= 4194304

