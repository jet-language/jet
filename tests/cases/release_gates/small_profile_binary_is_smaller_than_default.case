# `small: true` keeps inlining to the O1 limits at any `optimize` level (#5005), so at
# `optimize: full` the small image is smaller than the default one. At the stock `basic`
# level the limits are already the O1 ones and the two images are the same size.
copy: {root}/Examples/Collections/WordCount.jet from-root/Examples/Collections/WordCount.jet
file: from-root/Examples/Collections/WordCount.jet is-file
mkdir: .jet/build
step: jet build --optimize=full {root}/Examples/Collections/WordCount.jet
exit: 0
rename: .jet/build/WordCount .jet/build/wordcount_default
step: jet build --optimize=full --small {root}/Examples/Collections/WordCount.jet
exit: 0
rename: .jet/build/WordCount .jet/build/wordcount_small
capture: default_size = size file .jet/build/wordcount_default
file: .jet/build/wordcount_small size < {cap:default_size}
