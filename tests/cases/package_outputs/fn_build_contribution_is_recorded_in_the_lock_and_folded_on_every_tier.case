# A fresh checkout (no `.jet/lock`) of a package whose `build: fn` contributes a
# value to a setting its manifest declares: the build evaluates `build: fn`,
# records the contribution as a `[[build.contribution]]` row of the project
# lock, and folds it, so every tier prints the contributed 4, never the
# declared default 1. A run of the package records the same row.
fixture: ../../../Examples/features/packages/build_contribution
env: NO_COLOR=1
step: jet build run.jet
exit: 0
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].package = "build_contribution_demo"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].value = "Int(4)"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].scope = "function"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].layer = "environment"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].source = "build_contribution_demo::build"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].reason = "computed by fn build"
step: {work}/.jet/build/run
exit: 0
stdout: = "4\n"
step: jet build --release run.jet
exit: 0
step: {work}/.jet/build/run
exit: 0
stdout: = "4\n"
step: rm .jet/lock
exit: 0
step: jet run run.jet
exit: 0
stdout: = "4\n"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].value = "Int(4)"
json: file .jet/lock toml $.build.contribution[?key="Build.Settings.cache_slots"][0].source = "build_contribution_demo::build"
