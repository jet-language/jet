# A `#FX(…)` cap on a struct or enum binds every method of the type at check
# time: the methods in its body, a trait impl written in the body and an
# `impl` block written apart from it, each through every callee. A module cap
# binds the methods of the types inside the module. A cap's names are checked
# like a row's, a method inside its cap checks clean, and an unmarked type is
# unchanged.
fixture: type_cap_binds_every_method/input
env: NO_COLOR=1
step: jet check deny.jet
exit: 1
stderr: count "[jet.ProhibitedEffectReached]" = 3 # total, text and reload; size reads nothing
stderr: count "Error [" = 3 # the denials are the only errors
stderr: ~ "`total` reaches the `FS.Read` effect, which type `Rates` denies" # the denial holds through the call to read_rates
stderr: ~ "`text` reaches the `FS.Read` effect, which type `Rates` denies" # a trait impl in the type's body
stderr: ~ "`reload` reaches the `FS.Read` effect, which type `Rates` denies" # an impl block apart from the body
stderr: !~ "`read_rates` reaches" # a function outside the type is not bound
stderr: ~ "type `Rates` is capped here"
step: jet build deny.jet
exit: 1
stderr: count "[jet.ProhibitedEffectReached]" = 3 # build refuses before anything is emitted
step: jet check module.jet
exit: 1
stderr: count "Error [" = 1
stderr: ~ "`load` reaches the `FS.Read` effect, which module `store` denies" # a module cap reaches the methods of a type inside it
step: jet check unknown.jet
exit: 1
stderr: ~ "`Nett` isn't a known effect"
stderr: ~ "`Panic` can't be granted, only denied"
step: jet run within.jet
exit: 0
stdout: = "hello jet\nplain\n"
