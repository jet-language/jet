# A row scoped to `Net("127.0.0.1")`: a request to that host is accepted, and
# a redirect it answers with to `localhost` is refused at run time (E0740)
# before any lookup, at O0, O1 and O2.
fixture: effect_scope_checks_every_redirect_host_at_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = "same host: 200\nredirect to another host: refused\n"
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = "same host: 200\nredirect to another host: refused\n"
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = "same host: 200\nredirect to another host: refused\n"
