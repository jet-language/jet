// The runtime's covers rule on the table the compiler's own test asserts
// (Compiler/JetFoundation/Tests/Policy/EffectScope.jet): `with(need)` keeps
// a need its held right covers and stops (E0712) on any other, so each row
// narrows in a task of its own and the task's outcome is the answer.
COVERS_TABLE: [String]{
    "FS.Read(\"templates/\") > FS.Read(\"templates/home.html\")",
    "FS.Read(\"templates\") > FS.Read(\"templates/a/b.txt\")",
    "FS.Read(\"./templates/\") > FS.Read(\"templates/x/../y.txt\")",
    "FS.Read(\"templates/\") > FS.Read(\"templates2/a.txt\")",
    "FS.Read(\"templates/\") > FS.Read(\"templates/../secret.txt\")",
    "FS.Read(\"templates/\") > FS.Read(\"../templates/a.txt\")",
    "FS.Read(\"Data/\") > FS.Read(\"data/a\")",
    "FS.Read(\"..\") > FS.Read(\"../a\")",
    "FS.Read(\"..\") > FS.Read(\"../..\")",
    "FS.Read(\".\") > FS.Read(\"../a\")",
    "FS.Read(\"\") > FS.Read(\"a\")",
    "FS.Read(\"a/../../b\") > FS.Read(\"../b/c\")",
    "FS.Read(\"//data\") > FS.Read(\"/data/x\")",
    "FS.Read(\"/data\") > FS.Read(\"/database/a\")",
    "FS.Read(\"/data\") > FS.Read(\"data/a\")",
    "FS.Read(\"/\") > FS.Read(\"/etc/hosts\")",
    "FS.Read(\"/\") > FS.Read(\"etc/hosts\")",
    "FS.Read(\"/..\") > FS.Read(\"/etc\")",
    "Net(\"api.example.com\") > Net(\"API.Example.com.\")",
    "Net(\"api.example.com\") > Net(\" api.example.com\")",
    "Net(\"api.example.com\") > Net(\"api.example.com \")",
    "Net(\"api.example.com\") > Net(\"evilapi.example.com\")",
    "Net(\"example.com\") > Net(\"api.example.com\")",
    "Net(\"a.com.\") > Net(\"a.com\")",
    "Net(\"a.com..\") > Net(\"a.com\")",
    "GPU(\"npu\") > GPU(\"npu\")",
    "GPU(\"npu\") > GPU(\"NPU\")",
    "FS > FS.Read(\"a.txt\")",
    "FS.Read > FS.Read(\"a.txt\")",
    "FS.Read(\"assets/\") > FS.Read",
    "FS.Read(\"assets/\") > FS.Write(\"assets/a\")",
    "FS(\"assets/\") > FS.Read(\"assets/a\")",
    "FS.Read > FS.ReadExtra",
}

run: fn() {
    loop row in COVERS_TABLE {
        pair: row.split_once(" > ") ?? panic("a table row is `held > need`")
        held: pair.before.copy()
        need: pair.after.copy()
        narrowing: task {
            _narrowed: Authority.from_rights([held]).with(need)
        }
        covered: if narrowing.join() == {
            .Ok(_) -> true
            .Err(_) -> false
        }
        print("{row}: {covered}")
    }
}
