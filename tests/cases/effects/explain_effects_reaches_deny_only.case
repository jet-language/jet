# What a site reaches in `jet explain effects` names the deny-only effects
# (`Panic`, `Mem`) too. No rung grants them, but a `deny` row or `--deny`
# refuses them, so the explanation lists them with the call that reaches
# them. Before, they were dropped: a function that only panics reached
# `nothing`.
fixture: explain_effects_reaches_deny_only/input
env: NO_COLOR=1
step: jet check deny_only.jet
exit: 0
step stop: jet explain effects deny_only.jet:1
exit: 0
stdout: ~ "effects at deny_only.jet:1, in `stop`, nearest first" # the panicking function
stdout: ~ "reaches: Panic" # reaches Panic
stdout: !~ "reaches: nothing" # not nothing
step run: jet explain effects deny_only.jet:8
exit: 0
stdout: ~ "effects at deny_only.jet:8, in `run`, nearest first" # the caller
stdout: ~ "reaches: IO (deny_only.jet:9)" # prints itself
stdout: ~ "Mem" # allocates through `make`
stdout: ~ "Panic via deny_only.stop (deny_only.jet:8)" # and panics through `stop`, where it calls it
step json: jet explain effects --json deny_only.jet:1
exit: 0
stdout: ~ "\"effect\":\"Panic\"" # the JSON reaches carry it too
