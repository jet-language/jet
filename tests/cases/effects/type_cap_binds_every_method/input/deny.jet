use fs: core.files

Source: trait {
    text: fn(self) -> String
}

read_rates: fn() -> String { fs.read("rates.txt") ?? "" }

#FX(!FS)
Rates: struct {
    path: String

    total: fn(self) -> Int { read_rates().len() }

    impl Source {
        text: fn(self) -> String { fs.read(self.path) ?? "" }
    }

    size: fn(self) -> Int { self.path.len() }
    reload: fn(self) -> String { read_rates() }
}

run: fn() {
    rates: Rates{path: "rates.txt"}
    print(rates.total())
    print(rates.text())
    print(rates.size())
    print(rates.reload())
}
