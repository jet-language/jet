# Port of the Rust test `named_zone_lookup_requires_environment_and_read_effects`:
# a named zone lookup needs both `Env` and `FS.Read`, so each user function that
# hides one fails its own effect ceiling, and nothing else fails. A `-[]>`
# function reports its ceiling as E3401, which replaced the Rust test's E0740.
step: jet check {root}/tests/ui/time_zone_effects.jet
exit: 1
stderr: ~ "Error [jet.ImpureCallInPureContext]: `pure` calls the impure function `time.zone`" # the pure ceiling
stderr: ~ "Error [jet.EffectBoundExceeded]: `env_only` uses the effect `FS.Read`" # the Env-only ceiling
stderr: ~ "Error [jet.EffectBoundExceeded]: `read_only` uses the effect `Env`" # the read-only ceiling
stderr: count "Error [" = 3 # only the named user ceilings fail
step: jet check {root}/tests/fixtures/time_zone_effects_truthful.jet
exit: 0 # truthful zone bounds and pure numeric-offset parsing compile
