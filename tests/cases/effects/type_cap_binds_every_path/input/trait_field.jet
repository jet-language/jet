// A call through a trait-value field counts every implementation against
// the type's cap.
use fs: core.files

Source: trait { text: fn(self) -> String }

Disk: struct { path: String }

impl Disk.Source {
    text: fn(self) -> String { fs.read(self.path) ?? "" }
}

#FX(!FS)
Report: struct {
    src: Source

    show: fn(self) -> String { self.src.text() }
}

run: fn() {
    r: Report{src: Disk{path: "notes.txt"}}
    print(r.show())
}
