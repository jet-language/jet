// A trait's default body that a capped type inherits runs as the type's
// method, so the type's cap binds it.
Shape: trait {
    area: fn(self) -> Int
    show: fn(self) { print(self.area()) }
}

#FX(!IO)
Square: struct {
    side: Int

    impl Shape {
        area: fn(self) -> Int { self.side * self.side }
    }
}

run: fn() {
    s: Square{side: 2}
    s.show()
}
