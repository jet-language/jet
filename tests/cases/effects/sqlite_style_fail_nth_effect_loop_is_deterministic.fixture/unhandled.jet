package: {
    name: "sqlite_fault_unhandled"
    version: "0.1.0"
    authority: { allow: [FS, IO, Mem.Alloc] }
}
use {
    fs: core.files
}

// The negative control: the first write's fault is handled and the second's
// is not, so only the second injected run stops. Its report names that
// call, which proves the loop reaches every FS.Write the clean run reached,
// not only the first.
#Test(faults: [FS.Write]) second_write_stops_on_its_fault: fn() {
    fs.write("fault-first.txt", "x") ?? return
    fs.write("fault-second.txt", "y") ?? panic("second write fault not handled")
    assert(fs.exists("fault-second.txt"))
}

run: fn() {}
