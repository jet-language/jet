package: {
    name: "sqlite_fault_loop"
    version: "0.1.0"
    authority: { allow: [FS, IO, Mem.Alloc] }
}
use {
    fs: core.files
}

// D-TESTFAULT1=A, the SQLite-style loop: the clean run counts the FS.Write
// calls it reaches, then the runner fails each one once, in order. Every
// injected run returns through the body's ordinary fallible returns, and the
// allocation goes through the fallible rail.
#Test(faults: [FS.Write]) sqlite_style_fail_nth_effect_loop_is_deterministic: fn() {
    fs.write("fault-loop.txt", "x") ?? return
    fs.write("fault-loop.wal", "y") ?? return
    values := List.try_with_capacity(1) ?? return
    values.try_push(1) ?? return
    assert(values.len() == 1)
}

run: fn() {}
