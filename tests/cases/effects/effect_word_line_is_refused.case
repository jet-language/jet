# A `Log.Audit: effect` line declares nothing: it is E0003, and its fix
# declares the package effect as a type that names `Log` as its parent.
fixture: fixtures/effect-word
env: NO_COLOR=1
step: jet check main.jet
exit: nonzero
stderr: ~ "E0003" # the line is refused
stderr: ~ "`Log.Audit: effect` declares no effect" # the report quotes the line
stderr: ~ "impl Effect" # the fix declares a type with an `impl Effect` block
stderr: ~ "parent: Log" # that names `Log` as its parent
