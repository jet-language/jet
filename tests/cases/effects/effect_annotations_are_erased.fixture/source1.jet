
Shape: trait { area: fn(self) -> Int }
Square: struct { side: Int }
impl Square.Shape { area: fn(self) -> Int { return self.side * self.side } }
sq: fn(n: Int) -> Int { return n * n }
load: fn(p: String) { print(p) }
invoke: fn(n: Int) { load("{sq(n)}") }
run: fn() {
    s: Square{ side: 3 }
    print("{s.area()}")
    invoke(2)
}
