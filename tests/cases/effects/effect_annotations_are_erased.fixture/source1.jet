
trait Shape { fn area(self) -> Int }
struct Square { side: Int }
impl Square.Shape { fn area(self) -> Int { return self.side * self.side } }
fn sq(n: Int) -> Int { return n * n }
fn load(p: String) { print(p) }
fn invoke(n: Int) { load("{sq(n)}") }
fn run() {
    s :: Square{ side: 3 }
    print("{s.area()}")
    invoke(2)
}
