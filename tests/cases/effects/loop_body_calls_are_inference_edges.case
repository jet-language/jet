# A call inside a loop body is an inference edge of the enclosing function,
# not a direct failure of it. In clean.jet the unannotated `is_guest` is
# infallible, so `has_guest`, which calls it in a value loop, stays
# infallible and the `Never!` callers check clean and print the same at O0,
# O1 and O2. In fails.jet the loop body's callee returns `Err`; that failure
# flows along the same edge, so the `Never!` caller is refused.
fixture: loop_body_calls_are_inference_edges.fixture
env: NO_COLOR=1
step: jet check clean.jet
exit: 0
step: jet run -O0 clean.jet
exit: 0
stdout: = "true 1\n"
step: jet run -O1 clean.jet
exit: 0
stdout: = "true 1\n"
step: jet run -O2 clean.jet
exit: 0
stdout: = "true 1\n"
step: jet check fails.jet
exit: 1
stderr: count "Error [" = 1 # exactly this many
stderr: ~ "`has_guest` fails with `Err`, which can't propagate into `Never` here" # the loop body's failure reached has_guest
stderr: ~ "fails.jet:19:12" # reported at the Never! caller's call
