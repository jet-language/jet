# `core.process.exit` and `exit_unmapped` declare the narrow `Exec.Exit` leaf,
# not the whole `Exec` root: a caller bound to `-[Exec.Exit]>` checks clean
# and runs to its exit code, while the leaf still never covers starting a
# program, which is the `Exec` root.
fixture: process_exit_needs_only_the_exit_leaf.fixture
step: jet check exit.jet
exit: 0
stderr: !~ "Error [" # the Exec.Exit-bound callers of exit and exit_unmapped check clean
step: jet run exit.jet
exit: 3
stdout: = "bye\n"
step: jet check spawn.jet
exit: nonzero
stderr: ~ "uses the effect `Exec`, which its signature doesn't allow" # the leaf never covers the Exec root
