# core.compiler lists every extension point with its row, the same at O0,
# O1 and O2, and a read-only lint typed `-[]>` warns without writing code.
fixture: meta_marker_rows/input
env: NO_COLOR=1
step: jet run --optimize=none points.jet
exit: 0
stdout: = "Compile-time value: #run { … } -[]>\nMarker expansion: Marker.expand(self, target: Target) -[Meta.Generate]>\nDerive: Derive.expand(target: Target) -[Meta.Generate]>\nLint: Marker.expand(self, target: Target) -[]>\n"
step: jet run --optimize=basic points.jet
exit: 0
stdout: = "Compile-time value: #run { … } -[]>\nMarker expansion: Marker.expand(self, target: Target) -[Meta.Generate]>\nDerive: Derive.expand(target: Target) -[Meta.Generate]>\nLint: Marker.expand(self, target: Target) -[]>\n"
step: jet run --optimize=full points.jet
exit: 0
stdout: = "Compile-time value: #run { … } -[]>\nMarker expansion: Marker.expand(self, target: Target) -[Meta.Generate]>\nDerive: Derive.expand(target: Target) -[Meta.Generate]>\nLint: Marker.expand(self, target: Target) -[]>\n"
step: jet check lint.jet
exit: 0
stderr: ~ "Warning [lint.WideRecord]: `Order` has 4 fields" # the lint warns on the wide record only
stderr: count "Warning [" = 1 # exactly this many
