// The same calls under ceilings that name every effect they use.
use {
    net: core.net
    ws: core.net.ws
    core.http.[HTTPRequest]
    core.net.[NetError, SocketAddr]
    core.net.ws.[WsConn, WsError]
}

host: fn() -[Env, FS.Read]> String { net.gethostname() }
addr: fn() -[Net, Time.Wait]> SocketAddr NetError! { net.socket_addr("localhost", 80) }
dial: fn() -[Net, Time.Wait]> WsConn WsError! { ws.connect("ws://127.0.0.1:1/") }
take_over: fn(req: HTTPRequest) -[Net, Time.Wait]> WsConn WsError! { ws.upgrade(req) }
run: fn() {}
