// A function value is held to its parameter's effect row with its own
// inferred row: each call below breaks the row it is passed into.
apply: fn(n: Int, f: fn(Int) -[]> Int) -> Int { f(n) }

stop_apply: fn(n: Int, f: fn(Int) -[!Panic]> Int) -> Int { f(n) }

noisy: fn(n: Int) -> Int { if n < 0 -> panic("negative") else -> n }

run: fn() {
    a: apply(2, fn(m: Int) {
        print("x")
        m
    })
    b: stop_apply(3, fn(m: Int) { if m < 0 -> panic("negative") else -> m })
    c: stop_apply(4, noisy)
    print("{a} {b} {c}")
}
