#FX(IO)
report: module {
    load: fn() -[FS.Read]> Int { 1 }
    show: fn() -[IO]> { print("ok") }
}

#FX(!Net)
quiet: module {
    fetch: fn() -[Net]> Int { 2 }
    count: fn() -[IO]> Int { 3 }
}

run: fn() {
    print(report.load())
    report.show()
    print(quiet.fetch())
    print(quiet.count())
}
