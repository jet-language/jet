#FX(!IO)
quiet: module {
    Speaker: trait {
        speak: fn(self) -> Int {
            print("default")
            1
        }
        name: fn(self) -> String { "speaker" }
    }

    Dog: struct {
        legs: Int

        impl Speaker {}
    }
}

Loud: trait {
    speak: fn(self) -> Int {
        print("loud")
        2
    }
}

Cat: struct {
    lives: Int

    impl Loud {}
}

run: fn() {
    dog: quiet.Dog{legs: 4}
    print(dog.speak())
    print(dog.name())
    cat: Cat{lives: 9}
    print(cat.speak())
}
