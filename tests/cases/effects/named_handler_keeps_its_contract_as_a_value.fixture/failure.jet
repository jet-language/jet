// A handler that can fail is refused where the parameter's failure type is `Never`.
#Error
Rejected: struct {
    n: Int

    message: fn(self) -> String Never! { "rejected {self.n}" }
}

check: fn(n: Int) Rejected! -[IO]> {
    if n < 0 -> return Err(Rejected{n: n})
    print("ok {n}")
}

accept_total: fn(handler: fn(Int) Never! -[IO]>, n: Int) Never! -[IO]> {
    handler(n)
}

run: fn() {
    accept_total(check, 2)
}
