// Named bounded unit handlers used as function values keep their effect
// row and their failure type: a parameter of the same type accepts them,
// the row and the failure travel with the value, and a named handler
// crosses into a task.
use core.time

#Error
Rejected: struct {
    n: Int

    message: fn(self) -> String Never! { "rejected {self.n}" }
}

tick: fn(n: Int) Never! -[Time.Wait, IO]> {
    time.sleep(1ms)
    print("tick {n}")
}

wait: fn(n: Int) Never! -[Time.Wait]> {
    if n > 0 -> time.sleep(1ms)
}

check: fn(n: Int) Rejected! -[IO]> {
    if n < 0 -> return Err(Rejected{n: n})
    print("ok {n}")
}

accept: fn(handler: fn(Int) Never! -[Time.Wait, IO]>, n: Int) Never! -[Time.Wait, IO]> {
    handler(n)
}

accept_wait: fn(handler: fn(Int) Never! -[Time.Wait]>, n: Int) Never! -[Time.Wait]> {
    handler(n)
}

accept_checked: fn(handler: fn(Int) Rejected! -[IO]>, n: Int) Rejected! -[IO]> {
    handler(n)
}

run: fn() {
    accept(tick, 1)
    accept_wait(wait, 1)
    handlers: [fn(Int) Never! -[Time.Wait, IO]>]{tick}
    loop h in handlers -> accept(h, 2)
    accept_checked(check, 3) ?? print("unexpected")
    if accept_checked(check, -4) == {
        .Ok(_) -> print("unexpected")
        .Err(e) -> print(e.message())
    }
    handler: tick
    worker: task {
        handler(5)
    }
    worker.join() ?? panic("task failed")
    print("done")
}
