// A handler whose parameter is `&` can't become an ordinary read-convention
// function value: the `&` access mode would be dropped.
Counter: struct { n: Int }

bump: fn(c: &Counter) Never! {
    c.n += 1
}

each: fn(handler: fn(Counter) Never!, c: Counter) Never! {
    handler(c)
}

run: fn() {
    c := Counter{n: 0}
    each(bump, c)
    print("{c.n}")
}
