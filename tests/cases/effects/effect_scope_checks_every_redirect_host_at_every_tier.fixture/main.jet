// A row scoped to one host (spec.md "Effect scopes"): the checker proves the
// URL's constant host, and the runtime checks every host the call reaches,
// so a redirect to another host is refused before any lookup, as the
// request's own HTTPError, Policy with the refusal as its reason.
package: {
    name: "effect_scope_checks_every_redirect_host"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use {
    http: core.http
    net: core.net
}

verdict: fn(error: HTTPError) -> String {
    if error == .Policy(reason) {
        if reason.starts_with("E0740: ") -> return "refused"
    }
    "failed"
}

get_from: fn(port: String, route: String) -[Net("127.0.0.1"), Time.Wait]> String {
    response: http.get("http://127.0.0.1:{port}/{route}") ?? return verdict(err)
    "{response.status()}"
}

run: fn() (Closed | NetError | TaskFailure)! {
    { sender, receiver: ch }: channel<String>()
    t: task {
        listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
        sender.send(listener.local_addr() ?? panic("address"))
        first: listener.accept() ?? panic("accept")
        _: first.read_text(8192) ?? panic("request")
        net.tcp_reply(first, "200 OK", "inside") ?? panic("reply")
        second: listener.accept() ?? panic("accept")
        _: second.read_text(8192) ?? panic("request")
        port: (listener.local_addr() ?? panic("address")).split(":").to_list()[1]
        second.write_all("HTTP/1.1 302 Found\r\nLocation: http://localhost:{port}/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".bytes()) ?? panic("redirect")
    }
    addr: ch.receive() ?? panic("address")
    port: addr.split(":").to_list()[1]
    print("same host: {get_from(port, "")}")
    print("redirect to another host: {get_from(port, "away")}")
    t.join() ?? panic("server")
}
