// Every leaf Compiler/Prelude/Effects.jet declares, written in a signature
// row; each deny-only leaf (Time.Wait, Panic, Mem.Alloc, Mem.Rc) as a denial.
net: fn() -[Net]> {}
fs_read: fn() -[FS.Read]> {}
fs_write: fn() -[FS.Write]> {}
io: fn() -[IO]> {}
db_read: fn() -[DB.Read]> {}
db_write: fn() -[DB.Write]> {}
rand_draw: fn() -[Rand.Draw]> {}
env: fn() -[Env]> {}
exec_exit: fn() -[Exec.Exit]> {}
exec_args: fn() -[Exec.Args]> {}
log: fn() -[Log]> {}
gpu: fn() -[GPU]> {}
ffi_go: fn() -[FFI.Go]> {}
ffi_java: fn() -[FFI.Java]> {}
ffi_dotnet: fn() -[FFI.DotNet]> {}
ffi_fortran: fn() -[FFI.Fortran]> {}
ffi_cobol: fn() -[FFI.Cobol]> {}
ffi_tcl: fn() -[FFI.Tcl]> {}
ffi_lua: fn() -[FFI.Lua]> {}
ffi_ada: fn() -[FFI.Ada]> {}
ffi_pascal: fn() -[FFI.Pascal]> {}
ffi_dart: fn() -[FFI.Dart]> {}
ffi_powershell: fn() -[FFI.PowerShell]> {}
ffi_perl: fn() -[FFI.Perl]> {}
ffi_ruby: fn() -[FFI.Ruby]> {}
ffi_php: fn() -[FFI.Php]> {}
ffi_r: fn() -[FFI.R]> {}
ffi_com: fn() -[FFI.Com]> {}
ffi_c: fn() -[FFI.C]> {}
ffi_cpp: fn() -[FFI.Cpp]> {}
ffi_asm: fn() -[FFI.Asm]> {}
ffi_py: fn() -[FFI.Py]> {}
ffi_octave: fn() -[FFI.Octave]> {}
browser: fn() -[Browser]> {}
secret: fn() -[Secret]> {}
no_wait: fn() -[!Time.Wait]> {}
no_panic: fn() -[!Panic]> {}
no_alloc: fn() -[!Mem.Alloc]> {}
no_rc: fn() -[!Mem.Rc]> {}

run: fn() -[Net, FS.Read, FS.Write, IO, DB.Read, DB.Write, Rand.Draw, Env, Exec.Exit, Exec.Args, Log, GPU, FFI.Go, FFI.Java, FFI.DotNet, FFI.Fortran, FFI.Cobol, FFI.Tcl, FFI.Lua, FFI.Ada, FFI.Pascal, FFI.Dart, FFI.PowerShell, FFI.Perl, FFI.Ruby, FFI.Php, FFI.R, FFI.Com, FFI.C, FFI.Cpp, FFI.Asm, FFI.Py, FFI.Octave, Browser, Secret]> {
    net()
    fs_read()
    fs_write()
    io()
    db_read()
    db_write()
    rand_draw()
    env()
    exec_exit()
    exec_args()
    log()
    gpu()
    ffi_go()
    ffi_java()
    ffi_dotnet()
    ffi_fortran()
    ffi_cobol()
    ffi_tcl()
    ffi_lua()
    ffi_ada()
    ffi_pascal()
    ffi_dart()
    ffi_powershell()
    ffi_perl()
    ffi_ruby()
    ffi_php()
    ffi_r()
    ffi_com()
    ffi_c()
    ffi_cpp()
    ffi_asm()
    ffi_py()
    ffi_octave()
    browser()
    secret()
    no_wait()
    no_panic()
    no_alloc()
    no_rc()
}
