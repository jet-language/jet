// Every leaf Compiler/Prelude/Effects.jet declares, written in a module's and
// a type's `#FX(…)` cap; each deny-only leaf (Time.Wait, Panic, Mem.Alloc,
// Mem.Rc, Mem.Stack, Mem.Gc, Unsafe) as a denial.
#FX(Net, FS.Read, FS.Write, IO, DB.Read, DB.Write, Rand.Draw, Env, Exec.Exit, Exec.Args, Log, GPU, FFI.Go, FFI.Java, FFI.DotNet, FFI.Fortran, FFI.Cobol, FFI.Tcl, FFI.Lua, FFI.Ada, FFI.Pascal, FFI.Dart, FFI.PowerShell, FFI.Perl, FFI.Ruby, FFI.Php, FFI.R, FFI.Com, FFI.C, FFI.Cpp, FFI.Asm, FFI.Py, FFI.Octave, FFI.Rust, FFI.JS, FFI.Swift, Browser, Secret, !Time.Wait, !Panic, !Mem.Alloc, !Mem.Rc, !Mem.Stack(above: 4096), !Mem.Gc, !Unsafe)
leaves: module {
    count: fn() -> Int { 1 }
}

#FX(Net, FS.Read, FS.Write, IO, DB.Read, DB.Write, Rand.Draw, Env, Exec.Exit, Exec.Args, Log, GPU, FFI.Go, FFI.Java, FFI.DotNet, FFI.Fortran, FFI.Cobol, FFI.Tcl, FFI.Lua, FFI.Ada, FFI.Pascal, FFI.Dart, FFI.PowerShell, FFI.Perl, FFI.Ruby, FFI.Php, FFI.R, FFI.Com, FFI.C, FFI.Cpp, FFI.Asm, FFI.Py, FFI.Octave, FFI.Rust, FFI.JS, FFI.Swift, Browser, Secret, !Time.Wait, !Panic, !Mem.Alloc, !Mem.Rc, !Mem.Stack(above: 4096), !Mem.Gc, !Unsafe)
Leaves: struct {
    n: Int

    count: fn(self) -> Int { self.n }
}

run: fn() {
    print(leaves.count())
    print(Leaves{n: 2}.count())
}
