// Every grantable leaf Compiler/Prelude/Effects.jet declares, granted by an
// `#FX(leaf)` region and by an `#FX(authority: leaf)` region around a call
// that needs exactly that leaf.
net: fn() -[Net]> {}
fs_read: fn() -[FS.Read]> {}
fs_write: fn() -[FS.Write]> {}
io: fn() -[IO]> {}
db_read: fn() -[DB.Read]> {}
db_write: fn() -[DB.Write]> {}
rand_draw: fn() -[Rand.Draw]> {}
env: fn() -[Env]> {}
exec_exit: fn() -[Exec.Exit]> {}
exec_args: fn() -[Exec.Args]> {}
log: fn() -[Log]> {}
gpu: fn() -[GPU]> {}
ffi_go: fn() -[FFI.Go]> {}
ffi_java: fn() -[FFI.Java]> {}
ffi_dotnet: fn() -[FFI.DotNet]> {}
ffi_fortran: fn() -[FFI.Fortran]> {}
ffi_cobol: fn() -[FFI.Cobol]> {}
ffi_tcl: fn() -[FFI.Tcl]> {}
ffi_lua: fn() -[FFI.Lua]> {}
ffi_ada: fn() -[FFI.Ada]> {}
ffi_pascal: fn() -[FFI.Pascal]> {}
ffi_dart: fn() -[FFI.Dart]> {}
ffi_powershell: fn() -[FFI.PowerShell]> {}
ffi_perl: fn() -[FFI.Perl]> {}
ffi_ruby: fn() -[FFI.Ruby]> {}
ffi_php: fn() -[FFI.Php]> {}
ffi_r: fn() -[FFI.R]> {}
ffi_com: fn() -[FFI.Com]> {}
ffi_c: fn() -[FFI.C]> {}
ffi_cpp: fn() -[FFI.Cpp]> {}
ffi_asm: fn() -[FFI.Asm]> {}
ffi_py: fn() -[FFI.Py]> {}
ffi_octave: fn() -[FFI.Octave]> {}
ffi_rust: fn() -[FFI.Rust]> {}
ffi_js: fn() -[FFI.JS]> {}
ffi_swift: fn() -[FFI.Swift]> {}
browser: fn() -[Browser]> {}
secret: fn() -[Secret]> {}

grants: fn() {
    #FX(Net) { net() }
    #FX(FS.Read) { fs_read() }
    #FX(FS.Write) { fs_write() }
    #FX(IO) { io() }
    #FX(DB.Read) { db_read() }
    #FX(DB.Write) { db_write() }
    #FX(Rand.Draw) { rand_draw() }
    #FX(Env) { env() }
    #FX(Exec.Exit) { exec_exit() }
    #FX(Exec.Args) { exec_args() }
    #FX(Log) { log() }
    #FX(GPU) { gpu() }
    #FX(FFI.Go) { ffi_go() }
    #FX(FFI.Java) { ffi_java() }
    #FX(FFI.DotNet) { ffi_dotnet() }
    #FX(FFI.Fortran) { ffi_fortran() }
    #FX(FFI.Cobol) { ffi_cobol() }
    #FX(FFI.Tcl) { ffi_tcl() }
    #FX(FFI.Lua) { ffi_lua() }
    #FX(FFI.Ada) { ffi_ada() }
    #FX(FFI.Pascal) { ffi_pascal() }
    #FX(FFI.Dart) { ffi_dart() }
    #FX(FFI.PowerShell) { ffi_powershell() }
    #FX(FFI.Perl) { ffi_perl() }
    #FX(FFI.Ruby) { ffi_ruby() }
    #FX(FFI.Php) { ffi_php() }
    #FX(FFI.R) { ffi_r() }
    #FX(FFI.Com) { ffi_com() }
    #FX(FFI.C) { ffi_c() }
    #FX(FFI.Cpp) { ffi_cpp() }
    #FX(FFI.Asm) { ffi_asm() }
    #FX(FFI.Py) { ffi_py() }
    #FX(FFI.Octave) { ffi_octave() }
    #FX(FFI.Rust) { ffi_rust() }
    #FX(FFI.JS) { ffi_js() }
    #FX(FFI.Swift) { ffi_swift() }
    #FX(Browser) { browser() }
    #FX(Secret) { secret() }
}

authorities: fn() {
    #FX(authority: Net) { net() }
    #FX(authority: FS.Read) { fs_read() }
    #FX(authority: FS.Write) { fs_write() }
    #FX(authority: IO) { io() }
    #FX(authority: DB.Read) { db_read() }
    #FX(authority: DB.Write) { db_write() }
    #FX(authority: Rand.Draw) { rand_draw() }
    #FX(authority: Env) { env() }
    #FX(authority: Exec.Exit) { exec_exit() }
    #FX(authority: Exec.Args) { exec_args() }
    #FX(authority: Log) { log() }
    #FX(authority: GPU) { gpu() }
    #FX(authority: FFI.Go) { ffi_go() }
    #FX(authority: FFI.Java) { ffi_java() }
    #FX(authority: FFI.DotNet) { ffi_dotnet() }
    #FX(authority: FFI.Fortran) { ffi_fortran() }
    #FX(authority: FFI.Cobol) { ffi_cobol() }
    #FX(authority: FFI.Tcl) { ffi_tcl() }
    #FX(authority: FFI.Lua) { ffi_lua() }
    #FX(authority: FFI.Ada) { ffi_ada() }
    #FX(authority: FFI.Pascal) { ffi_pascal() }
    #FX(authority: FFI.Dart) { ffi_dart() }
    #FX(authority: FFI.PowerShell) { ffi_powershell() }
    #FX(authority: FFI.Perl) { ffi_perl() }
    #FX(authority: FFI.Ruby) { ffi_ruby() }
    #FX(authority: FFI.Php) { ffi_php() }
    #FX(authority: FFI.R) { ffi_r() }
    #FX(authority: FFI.Com) { ffi_com() }
    #FX(authority: FFI.C) { ffi_c() }
    #FX(authority: FFI.Cpp) { ffi_cpp() }
    #FX(authority: FFI.Asm) { ffi_asm() }
    #FX(authority: FFI.Py) { ffi_py() }
    #FX(authority: FFI.Octave) { ffi_octave() }
    #FX(authority: FFI.Rust) { ffi_rust() }
    #FX(authority: FFI.JS) { ffi_js() }
    #FX(authority: FFI.Swift) { ffi_swift() }
    #FX(authority: Browser) { browser() }
    #FX(authority: Secret) { secret() }
}

run: fn() {
    grants()
    authorities()
}
