// Core's vetted internals are sealed: a `-[!Unsafe]>` row calls Core and
// safe user code freely.
double: fn(values: [Int]) -> [Int] { loop value in values -> value * 2 }

total: fn(text: String) -[!Unsafe]> Int {
    parts: text.split(",").to_list()
    double([Int]{parts.len(), text.len()}).len()
}

run: fn() { print(total("a,b,c")) }
