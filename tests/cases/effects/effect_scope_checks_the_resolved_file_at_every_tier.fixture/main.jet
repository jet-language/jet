// Effect scopes at run time (spec.md "Effect scopes"). The checker proves a
// call's constant prefix (`data/`) lies inside the row; the runtime checks
// the file the call reaches, resolved as the kernel resolves it (the working
// directory, `..`, links), against every row in force. A refusal is the
// read's own IOError, PermissionDenied with the refusal as its cause.
use files: core.files

// What a scoped call's failure was: the row's refusal (E0740), its denial
// (E0749), or an ordinary failure.
verdict: fn(error: IOError) -> String {
    if error == .PermissionDenied(context) {
        cause: context.cause ?? ""
        if cause.starts_with("E0740: ") -> return "refused"
        if cause.starts_with("E0749: ") -> return "denied"
    }
    "failed"
}

read_scoped: fn(name: String) -[FS.Read("data/")]> String {
    text: files.read("data/{name}") ?? return verdict(err)
    "{text.trim()}"
}

// A function with no row runs under its caller's row.
read_below: fn(name: String) -> String {
    text: files.read("data/{name}") ?? return verdict(err)
    "{text.trim()}"
}

through_helper: fn(name: String) -[FS.Read("data/")]> String { read_below(name) }

// A scoped denial inside the scope refuses its folder only.
read_open: fn(name: String) -[FS.Read("data/"), !FS.Read("data/private/")]> String {
    text: files.read("data/{name}") ?? return verdict(err)
    "{text.trim()}"
}

save: fn(name: String) -[FS.Write("data/")]> String {
    files.write("data/{name}", "note") ?? return verdict(err)
    "written"
}

run: fn() {
    files.symlink("../secret.txt", "data/link.txt", replace: true) ?? panic("symlink")
    print("inside: {read_scoped("inside.txt")}")
    print("parent: {read_scoped("../secret.txt")}")
    print("link: {read_scoped("link.txt")}")
    print("missing parent: {read_scoped("missing/../../secret.txt")}")
    print("missing file: {read_scoped("missing.txt")}")
    print("helper inside: {through_helper("inside.txt")}")
    print("helper parent: {through_helper("../secret.txt")}")
    print("denied: {read_open("private/key.txt")}")
    print("back inside: {read_open("private/../inside.txt")}")
    print("write inside: {save("note.txt")}")
    print("write parent: {save("../escape.txt")}")
    print("escape exists: {files.exists("escape.txt")}")
}
