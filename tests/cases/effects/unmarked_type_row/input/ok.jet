// A type with no `#FX` keeps its inferred rows: `show` prints, so a caller
// that declares `IO` may call it, and `next` stays pure.
Counter: struct {
    n: Int

    show: fn(self) { print("count: {self.n}") }
    next: fn(self) -> Counter { Counter{n: self.n + 1} }
}

loud: fn(c: Counter) -[IO]> { c.show() }

pure_next: fn(c: Counter) -[]> Int { c.next().n }

run: fn() {
    c: Counter{n: 1}
    loud(c)
    print("next: {pure_next(c)}")
}
