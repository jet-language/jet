# Every leaf Compiler/Prelude/Effects.jet declares checks the same
# through a signature row (deny-only leaves as denials), an `#FX(leaf)` grant,
# an `#FX(authority: leaf)` grant, and a module's and a type's `#FX(…)` cap; an
# undeclared leaf fails every path with the same E0750.
fixture: every_effect_leaf_checks_through_every_path.fixture
step: jet check rows.jet
exit: 0
step: jet check grants.jet
exit: 0
stderr: !~ "Error [" # every leaf grant checks clean
step: jet check unknown_row.jet
exit: nonzero
stderr: ~ "Error [jet.UnknownEffectLeaf]: `FFI.Klingon` isn't a declared effect" # the row path names the undeclared leaf
step: jet check unknown_grant.jet
exit: nonzero
stderr: ~ "Error [jet.UnknownEffectLeaf]: `FFI.Klingon` isn't a declared effect" # the grant path names the same leaf
step: jet check caps.jet
exit: 0
stderr: !~ "Error [" # every leaf in a module cap and a type cap checks clean
step: jet check unknown_cap.jet
exit: nonzero
stderr: count "Error [jet.UnknownEffectLeaf]: `FFI.Klingon` isn't a declared effect" = 2 # the module cap and the type cap, the denial included
