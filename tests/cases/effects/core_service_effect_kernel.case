# DB is a Core declaration with `#FX(Net, FS)` above it: a `-[DB]>` row may
# read a file, a local database passes a `-[!Net]>` caller and prints the
# same at O0, O1 and O2, and a driver that reaches Net is refused there.
fixture: core_service_effect_kernel/input
env: NO_COLOR=1
step: jet check ok.jet
exit: 0
step: jet run -O0 ok.jet
exit: 0
stdout: = "people: 1\n"
step: jet run -O1 ok.jet
exit: 0
stdout: = "people: 1\n"
step: jet run -O2 ok.jet
exit: 0
stdout: = "people: 1\n"
step: jet check net.jet
exit: 1
stderr: count "Error [" = 1 # exactly this many
stderr: ~ "`offline_count` reaches the `Net` effect, which it prohibits with `-[!Net]>`" # remote_count's DB row admits Net; the denial does not
step: jet run -O0 net.jet
exit: 1
stderr: ~ "`offline_count` reaches the `Net` effect, which it prohibits with `-[!Net]>`" # run refuses it as check does
step: jet run -O1 net.jet
exit: 1
stderr: ~ "`offline_count` reaches the `Net` effect, which it prohibits with `-[!Net]>`" # run refuses it as check does
step: jet run -O2 net.jet
exit: 1
stderr: ~ "`offline_count` reaches the `Net` effect, which it prohibits with `-[!Net]>`" # run refuses it as check does
