# Scoped FS rows at run time: reads and writes the row's folder holds are
# accepted; a `..` escape, a link out of the folder, a missing component
# stepped over and a row-less callee's escape are refused (E0740), a scoped
# denial inside the folder refuses its own files (E0749), and a missing file
# inside the scope stays an ordinary failure. Same lines at O0, O1, O2 and
# from the built binary.
fixture: effect_scope_checks_the_resolved_file_at_every_tier.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
timeout: 60s
exit: 0
stdout: = effect_scope_checks_the_resolved_file_at_every_tier.out
step: jet run -O1 main.jet
timeout: 60s
exit: 0
stdout: = effect_scope_checks_the_resolved_file_at_every_tier.out
step: jet run -O2 main.jet
timeout: 60s
exit: 0
stdout: = effect_scope_checks_the_resolved_file_at_every_tier.out
step: jet build main.jet
timeout: 120s
exit: 0
step: .jet/build/main
timeout: 60s
exit: 0
stdout: = effect_scope_checks_the_resolved_file_at_every_tier.out
