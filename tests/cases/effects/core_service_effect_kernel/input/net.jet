// A database driver that talks to a server reaches Net. Its `-[DB]>` row
// admits that (Net is on DB's `#FX(…)` list), and a `-[!Net]>` caller is
// refused: the denial checks what the call really reaches.
use db: core.db
use net: core.net

remote_count: fn(scope: DBScope) -[DB]> Int {
    _listener: net.tcp_listen("127.0.0.1:0") ?? return -1
    _closed: scope.close()
    0
}

offline_count: fn(scope: DBScope) -[!Net]> Int {
    remote_count(scope)
}

run: fn() {
    conn: db.open_memory()
    policy: db.policy("person", "true") ?? panic("policy")
    print("people: {offline_count(conn.with_policy(policy, "owner"))}")
}
