// Core declares DB with `#FX(Net, FS)` above it (Core/Effects/Effects.jet):
// a row naming DB may use files and the network, and a denial checks what
// each call really reaches.
use db: core.db
use files: core.files

// `-[DB]>` admits the file read: FS is on DB's `#FX(…)` list.
add_person: fn(scope: DBScope) -[DB]> Int {
    name: (files.read("name.txt") ?? "nobody").trim()
    _: scope.execute(SQL{"INSERT INTO person (name) VALUES ({name})"}) ?? return -1
    1
}

person_count: fn(scope: DBScope) -[DB.Read]> Int {
    row_opt: scope.query_one(SQL{"SELECT COUNT(*) AS n FROM person"})
    if row_opt == .Val(row) {
        n_val: row.get("n") ?? panic("missing n")
        return n_val.int() ?? 0
    }
    0
}

// A database in a local file reaches no network, so `!Net` holds.
offline_count: fn(scope: DBScope) -[!Net]> Int {
    added: add_person(scope)
    if added < 0 -> return -1
    person_count(scope)
}

run: fn() {
    conn: db.open_memory()
    policy: db.policy("person", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "owner")
    _: db.migrate(scoped, "person-v1", [SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT)"}]) ?? panic("create")
    print("people: {offline_count(scoped)}")
    _closed: scoped.close()
}
