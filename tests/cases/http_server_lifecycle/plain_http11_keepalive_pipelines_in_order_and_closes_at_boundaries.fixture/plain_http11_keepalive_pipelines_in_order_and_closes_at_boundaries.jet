// Port of tests/http_server_lifecycle.rs:1269-1431 against public Core APIs.
// The Rust server kept connections alive and answered pipelined requests in
// order; core.http.server answers one request per connection with
// `Connection: close`, so each pipelined exchange here gets exactly its first
// response and the connection closes after it, whatever the HTTP version or
// `Connection` header asks.
// PENDING-SEAM(http-server-options): workers=1, admission_queue=5,
// read_header_timeout=40ms/read_idle_timeout=40ms; the incomplete-header
// exchange (1s read deadline, one200, one408, close suffix) needs those options.
use {
    web: core.web
    server: core.http.server
    net: core.net
}

s6_pipeline_crlf: fn() -> String { "\r\n" }

s6_pipeline_exchange: fn(addr: String, request: String) -> String {
    stream := net.tcp_connect(addr) ?? panic("connect")
    stream.write_all(request.bytes()) ?? panic("request write")
    net.tcp_shutdown(stream, NetShutdown.Write) ?? panic("finish request write")
    parts := [String]{}
    loop {
        part: stream.read_text(8192) ?? panic("response read")
        if part == "" -> break
        parts.push(part)
    }
    parts.join("")
}

#Test("pipelined requests get one response and the connection closes") {
    mux: web.app()
    mux.post("/one", fn(req: HTTPRequest) { Ok(server.response(200, req.body().text(1024 * 1024) ?? panic("body"))) })
    mux.get("/two", fn(_req: HTTPRequest) { Ok(server.response(200, "two")) })
    mux.get("/empty", fn(_req: HTTPRequest) { Ok(server.response(204, "forbidden")) })
    bound: mux.bind("127.0.0.1:0") ?? panic("bind")
    addr: bound.local_addr() ?? panic("address")
    serving: task { bound.serve() ?? panic("server") }
    crlf: s6_pipeline_crlf()
    pipelined: s6_pipeline_exchange(addr, "POST /one HTTP/1.1{crlf}Host: local{crlf}Content-Length: 3{crlf}{crlf}oneGET /two HTTP/1.1{crlf}Host: local{crlf}Connection: close{crlf}{crlf}")
    assert(pipelined.count("HTTP/1.1 200 OK") == 1, pipelined)
    assert(pipelined.count("Connection: close") == 1, pipelined)
    assert(pipelined.ends_with("{crlf}{crlf}one"), "the body ran into the pipelined request: {pipelined}")
    http10: s6_pipeline_exchange(addr, "GET /two HTTP/1.0{crlf}Host: local{crlf}{crlf}GET /two HTTP/1.0{crlf}Host: local{crlf}{crlf}")
    assert(http10.count("200 OK") == 1, http10)
    assert(http10.count("Connection: close") == 1, http10)
    http10_keepalive: s6_pipeline_exchange(addr, "GET /two HTTP/1.0{crlf}Host: local{crlf}Connection: keep-alive{crlf}{crlf}GET /two HTTP/1.0{crlf}Host: local{crlf}Connection: close{crlf}{crlf}")
    assert(http10_keepalive.count("200 OK") == 1, http10_keepalive)
    assert(http10_keepalive.count("Connection: close") == 1, http10_keepalive)
    many: s6_pipeline_exchange(addr, "GET /two HTTP/1.1{crlf}Host: local{crlf}{crlf}".repeat(1001))
    assert(many.count("HTTP/1.1 200 OK") == 1, many)
    assert(many.count("Connection: close") == 1, many)
    body_forbidden: s6_pipeline_exchange(addr, "GET /empty HTTP/1.1{crlf}Host: local{crlf}{crlf}GET /two HTTP/1.1{crlf}Host: local{crlf}Connection: close{crlf}{crlf}")
    assert(body_forbidden.starts_with("HTTP/1.1 204 No Content{crlf}"), body_forbidden)
    assert(body_forbidden.count("HTTP/1.1") == 1, body_forbidden)
    assert(!body_forbidden.to_lower().contains("content-length:"), body_forbidden)
    assert(!body_forbidden.contains("forbidden"), body_forbidden)
    assert(body_forbidden.ends_with("Connection: close{crlf}{crlf}"), body_forbidden)
    // An `HTTP/` version other than 1.0 and 1.1 is 505; a version that is not
    // `HTTP/` at all makes the request line malformed, which is 400.
    invalid_versions: [String: String]{"HTTP/2.0": "HTTP/1.1 505 HTTP Version Not Supported", "garbage": "HTTP/1.1 400 Bad Request"}
    loop (version, status) in invalid_versions {
        invalid: s6_pipeline_exchange(addr, "GET /two {version}{crlf}Host: local{crlf}{crlf}GET /two HTTP/1.1{crlf}Host: local{crlf}{crlf}")
        assert(invalid.starts_with(status), invalid)
        assert(invalid.count("HTTP/1.1") == 1, invalid)
        assert(!invalid.contains("200 OK"), "unsupported version persisted: {invalid}")
        assert(invalid.ends_with("Connection: close{crlf}{crlf}"), invalid)
    }
    bound.shutdown(30s) ?? panic("shutdown")
    serving.join() ?? panic("server join")
}
