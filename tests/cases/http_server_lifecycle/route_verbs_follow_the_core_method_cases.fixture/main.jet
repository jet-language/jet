use http_server: core.http.server

run: fn() {
    mux: http_server.mux()
    mux.get("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "get")))
    mux.head("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "")))
    mux.post("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "post")))
    mux.put("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "put")))
    mux.patch("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "patch")))
    mux.delete("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "delete")))
    mux.options("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "options")))
    mux.trace("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "trace")))
    mux.connect("/r", (_req: HTTPRequest) -> Ok(http_server.response(200, "connect")))
    print("registered")
}
