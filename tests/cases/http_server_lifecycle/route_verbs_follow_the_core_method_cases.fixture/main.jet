use http_server: core.http.server

run: fn() {
    mux: http_server.mux()
    mux.get("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "get")) })
    mux.head("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "")) })
    mux.post("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "post")) })
    mux.put("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "put")) })
    mux.patch("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "patch")) })
    mux.delete("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "delete")) })
    mux.options("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "options")) })
    mux.trace("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "trace")) })
    mux.connect("/r", fn(_req: HTTPRequest) { Ok(http_server.response(200, "connect")) })
    print("registered")
}
