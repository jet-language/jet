# The 257th connection from one peer address is answered 503 and closed,
# and the server serves again once the held connections end, on every
# execution level.
fixture: per_peer_connection_limit_answers_503.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
exit: 0
stderr: empty
stdout: = per_peer_connection_limit_answers_503.stdout.expected
step o1: jet run --optimize=basic main.jet
exit: 0
stderr: empty
stdout: = per_peer_connection_limit_answers_503.stdout.expected
step o2: jet run --optimize=full main.jet
exit: 0
stderr: empty
stdout: = per_peer_connection_limit_answers_503.stdout.expected
