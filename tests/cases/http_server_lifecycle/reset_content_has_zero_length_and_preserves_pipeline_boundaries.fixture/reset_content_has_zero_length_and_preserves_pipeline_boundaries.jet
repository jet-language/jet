// Port of tests/http_server_lifecycle.rs:1579-1684 against public Core APIs.
// PENDING-SEAM(http-server-options): workers=1, admission_queue=8 setup.
use {
    web: core.web
    server: core.http.server
    net: core.net
}

S6ResetCalls: struct { value: Int }

s6_reset_crlf: fn() -> String { "\r\n" }

s6_reset_exchange: fn(addr: String, lines: [String]) -> String {
    stream := net.tcp_connect(addr) ?? panic("connect")
    stream.write_all(lines.join(s6_reset_crlf()).bytes()) ?? panic("request write")
    net.tcp_shutdown(stream, NetShutdown.Write) ?? panic("finish request")
    parts := [String]{}
    loop {
        part: stream.read_text(8192) ?? panic("response read")
        if part == "" -> break
        parts.push(part)
    }
    parts.join("")
}

#Test("205 preserves zero length and pipeline boundaries") {
    calls: Shared{S6ResetCalls{value: 0}}
    mux: web.app()
    mux.get("/reset", fn(_req: HTTPRequest) {
        calls.value = calls.value + 1
        Ok(server.response(205, "must-not-publish").header("Content-Length", "999").header("Transfer-Encoding", "chunked").header("X-Origin", "reset"))
    })
    mux.get("/next", fn(_req: HTTPRequest) {
        calls.value = calls.value + 1
        Ok(server.response(200, "next"))
    })
    bound: mux.bind("127.0.0.1:0") ?? panic("bind")
    addr: bound.local_addr() ?? panic("address")
    serving: task { bound.serve() ?? panic("server") }
    crlf: s6_reset_crlf()
    // The server answers one request per connection, so the pipelined
    // second request gets no response and nothing follows the 205's head.
    pipelined: s6_reset_exchange(addr, [String]{"GET /reset HTTP/1.1", "Host: local", "", "GET /next HTTP/1.1", "Host: local", "Connection: close", "", ""})
    assert(pipelined.count("HTTP/1.1") == 1, "a second response followed the 205: {pipelined}")
    assert(pipelined.starts_with("HTTP/1.1 205 Reset Content"), "wrong 205 status: {pipelined}")
    assert(pipelined.contains("Content-Length: 0{crlf}"), "205 was not zero-length: {pipelined}")
    assert(!pipelined.to_lower().contains("transfer-encoding:"), "205 retained custom framing: {pipelined}")
    assert(pipelined.contains("X-Origin: reset{crlf}"), "205 lost representation metadata: {pipelined}")
    assert(pipelined.contains("Connection: close{crlf}"), "205 did not close its connection: {pipelined}")
    assert(pipelined.ends_with("{crlf}{crlf}"), "205 sent body bytes: {pipelined}")
    head: s6_reset_exchange(addr, [String]{"HEAD /reset HTTP/1.1", "Host: local", "Connection: close", "", ""})
    framed: head.split_once("{crlf}{crlf}") ?? panic("HEAD 205 framing")
    assert(framed.before.starts_with("HTTP/1.1 205 Reset Content"), head)
    assert(framed.before.contains("Content-Length: 0{crlf}"), "HEAD metadata overrode 205: {head}")
    assert(framed.after == "", "HEAD 205 emitted body bytes: {head}")
    assert(calls.value == 2)
    report: bound.shutdown(30s) ?? panic("shutdown")
    serving.join() ?? panic("server join")
    assert(report.accepted == 2)
    assert(report.completed == 2)
}
