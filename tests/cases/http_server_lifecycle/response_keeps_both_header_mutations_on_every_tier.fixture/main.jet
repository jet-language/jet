// Two `header(name, value)` calls on one server response: both fields stay,
// in order, after the response's own fields.
use server: core.http.server

run: fn() {
    response: server.response(201, "made").header("x-first", "one").header("x-second", "two")
    print("status {response.status()}")
    loop field in response.headers.fields {
        print("{field.name}: {field.value}")
    }
    first: response.header("x-first") ?? "missing"
    second: response.header("x-second") ?? "missing"
    print("x-first={first} x-second={second}")
    body: response.body().text(64) ?? "unreadable"
    print("body {body}")
}
