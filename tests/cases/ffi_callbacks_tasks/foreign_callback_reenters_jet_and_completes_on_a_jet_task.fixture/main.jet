use c: c.callback

increment: fn(value: I32) -[]> I32 {
    return value + 1
}

#Import c.callback: module {
    foreign_callback: fn(callback: fn(I32) -[]> I32, value: I32) -> I32 = "foreign_callback"
    foreign_async: fn(value: I32) -> I32 = "foreign_async"
}

foreign_work: fn() -> I32 {
    return c.foreign_async(41)
}

run: fn() {
    print(c.foreign_callback(increment, 41))
    print(c.foreign_callback(fn(value) { value + 1 }, 41))
    task.group ffi_workers {
        result: task foreign_work()
        print(result.join() ?? panic("foreign task failed"))
    }
}
