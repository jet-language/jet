package { name: "select-cc" authority: { holds: { allow: [Exec, IO] } } }
use core.process as process
fn run() {
    candidates :: [String]{"cc", "gcc", "clang"}
    loop tool in candidates {
        if process.cmd([String]{tool, "--version"}).run() == .Ok(_) {
            print(tool)
            return
        }
    }
    panic("a C compiler is required for the callback/task production proof")
}
