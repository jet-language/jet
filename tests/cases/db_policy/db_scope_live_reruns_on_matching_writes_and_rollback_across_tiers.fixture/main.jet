use {
    db: core.db
    web: core.web
    core.reactive.loadable.[Loadable]
}

titles: fn(state: Loadable<[[String: db.DBValue]], db.DBError>) -> String {
    if state == {
        .Loaded(rows) -> {
            out := [String]{}
            loop row in rows -> out.push(db.row_text(row, "title") ?? "?")
            "loaded [{out.join(",")}]"
        }
        .Failed(reason) -> "failed {reason.message}"
        .Idle | .Loading -> "pending"
    }
}

run: fn() {
    conn: db.open_memory()
    policy: db.policy("tasks", "owner == user") ?? panic("policy")
    alice: conn.with_policy(policy, "alice")
    bob: conn.with_policy(policy, "bob")
    _: db.migrate(alice, "tasks-v1", [db.SQL]{SQL{"CREATE TABLE tasks (owner TEXT, title TEXT)"}}) ?? panic("migrate")
    owner: "alice"
    first: "one"
    _: alice.execute(SQL{"INSERT INTO tasks (owner, title) VALUES ({owner}, {first})"}) ?? panic("insert one")
    mine: alice.live(SQL{"SELECT title FROM tasks ORDER BY title"}) ?? panic("live")
    print("alice {titles(web.state(mine))}")
    second: "two"
    _: bob.execute(SQL{"INSERT INTO tasks (owner, title) VALUES ({owner}, {second})"}) ?? panic("bob insert")
    print("after bob write {titles(web.state(mine))}")
    third: "three"
    _: alice.execute(SQL{"INSERT INTO tasks (owner, title) VALUES ({owner}, {third})"}) ?? panic("insert three")
    print("after write {titles(web.state(mine))}")
    _: alice.begin()
    _: alice.execute(SQL{"DELETE FROM tasks"}) ?? panic("delete")
    print("in tx {titles(web.state(mine))}")
    _: alice.rollback()
    print("after rollback {titles(web.state(mine))}")
    theirs: bob.live(SQL{"SELECT title FROM tasks ORDER BY title"}) ?? panic("bob live")
    print("bob {titles(web.state(theirs))}")
    again: alice.live(SQL{"SELECT title FROM tasks ORDER BY title"}) ?? panic("again")
    print("same binding {again.id == mine.id}, per user {theirs.id != mine.id}")
    alice.live(SQL{"DELETE FROM tasks"}) ? _ok -> print("write live: accepted") ! failure -> print("write live: {failure.message}")
    alice.live(SQL{"SELECT title FROM tasks JOIN other"}) ? _ok -> print("join live: accepted") ! failure -> print("join live: rejected")
    print(web.live_stats())
}
