// The shared task operations don't erase the database's own rules.
// 1. A waiter whose task deadline (`#Deadline`) runs out before the pool's own
//    acquire deadline leaves the pool's queue. That is the task's DeadlineBlown,
//    not a pool timeout, and the next acquire is admitted.
// 2. A pool refusal crosses a task join as the pool's own error text.
// 3. A task cancelled inside an open transaction leaves nothing written, and
//    the connection can begin a new transaction.
package: {
    name: "shared_ops_db"
    authority: { allow: [DB, DB.Read, DB.Write, IO, Mem.Alloc, Time, Time.Wait] }
}

use db: core.db
use time: core.time

label: fn(error: TaskFailure) -> String {
    if error == {
        .Panicked(reason) -> { return "panicked: {reason}" }
        .DeadlineBlown -> { return "deadline" }
        .Cancelled -> { return "cancelled" }
    }
}

wait_lease: fn(pool: DBPool, started: Sender<Int>) -[DB, Time.Wait]> String {
    started.send(1)
    lease: pool.acquire(deadline: 60000ms) ?? return "waiter: {err.message}"
    lease.close() ?? return "waiter release: {err.message}"
    "waiter: acquired"
}

// The waiter inherits the 40ms deadline in force where it is spawned. The
// block returns, so the last line is never reached.
waiter_under_deadline: fn(pool: DBPool, started: Sender<Int>) -> Task<String> {
    #Deadline(40ms) { return task wait_lease(pool, started) }
    task wait_lease(pool, started)
}

try_lease: fn(pool: DBPool) -[DB, Time.Wait]> String {
    if pool.acquire(deadline: 30ms) == {
        .Ok(lease) -> {
            lease.close() ?? return "release failed"
            return "acquired"
        }
        .Err(error) -> return "refused: {error.message}"
    }
}

slow_tx: fn(scope: DBScope, started: Sender<Int>) -[DB, Time.Wait]> String {
    tx: scope.begin() ?? return "begin: {err.message}"
    _: scope.execute(SQL{"INSERT INTO t (v) VALUES (1)"}) ?? {
        tx.rollback() ?? return "insert and rollback failed"
        return "insert failed"
    }
    started.send(1)
    time.sleep(5000ms)
    tx.commit() ?? return "commit: {err.message}"
    "committed"
}

count: fn(scope: DBScope) -[DB]> Int {
    row: scope.query_one(SQL{"SELECT COUNT(*) AS n FROM t"}) ?? return -1
    db.row_int(row, "n") ?? -1
}

run: fn() {
    pool: db.pool(":memory:", max: 1) ?? panic("pool")

    held: pool.acquire(deadline: 100ms) ?? panic("held")
    { sender: s1, receiver: r1 }: channel<Int>(capacity: 1)
    waiter: waiter_under_deadline(pool, s1)
    _: r1.receive() ?? panic("no start")
    if waiter.join() == {
        .Ok(outcome) -> print("waiter under a 40ms task deadline: {outcome}")
        .Err(error) -> print("waiter under a 40ms task deadline: {label(error)}")
    }
    print("pool timeouts after it: {pool.receipt().timeouts}")
    held.close() ?? panic("release")
    print("next lease: {try_lease(pool)}")

    held2: pool.acquire(deadline: 100ms) ?? panic("held2")
    inner: task try_lease(pool)
    print("joined: {inner.join() ?? "failed"}")
    held2.close() ?? panic("release2")
    print("drain: {pool.drain() ?? panic("drain")}")

    conn: db.open_memory()
    policy: db.policy("t", "true") ?? panic("policy")
    scope: conn.with_policy(policy, "owner")
    _: db.migrate(scope, "t-v1", [SQL{"CREATE TABLE t (v INTEGER)"}]) ?? panic("migrate")
    { sender: s3, receiver: r3 }: channel<Int>(capacity: 1)
    writer: task slow_tx(scope, s3)
    _: r3.receive() ?? panic("no writer")
    writer.cancel()
    if writer.join() == {
        .Ok(outcome) -> print("writer: {outcome}")
        .Err(error) -> print("writer: {label(error)}")
    }
    print("rows after the cancelled writer: {count(scope)}")
    if scope.begin() == {
        .Ok(tx) -> {
            print("a new transaction begins: true")
            tx.rollback() ?? panic("rollback")
        }
        .Err(error) -> print("a new transaction begins: {error.message}")
    }
}
