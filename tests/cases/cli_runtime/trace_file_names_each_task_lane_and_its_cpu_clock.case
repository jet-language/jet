# `jet build --trace=FILE` writes trace events whose `tid` is the
# span's task (core.tasks.current_task), each lane named once by its first
# span, and whose phase closes carry that task's CPU time (core.tasks.cpu_ns)
# beside the process's (/proc/self/stat).
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: main.jet = "run: fn() {\n    print(\"traced\")\n}\n"
step: jet build --trace=trace.json main.jet
exit: 0
file: trace.json ~ "{\"name\":\"thread_name\",\"ph\":\"M\"," # a task's first span names its lane
file: trace.json ~ "\"tid\":1,\"args\":{\"name\":\"task 1\"}}" # the compile's own task is lane 1
file: trace.json ~ "\"cpu_ns\":" # a phase close carries its task's CPU time
file: trace.json ~ "\"proc_cpu_ns\":" # and the whole process's
