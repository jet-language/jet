use json: core.encoding.json

show: fn() Never! {
    data: json.parse(`{"a":1}`) ?? panic("json")
    r: json.canonical(data)
    print(r)
}

sign: fn() -> String {
    data: json.parse(`{"a":1}`)
    r: json.canonical(data)
    r
}

already_migrated: fn() Never! {
    data: json.parse(`{"a":1}`) ?? panic("json")
    r: json.canonical(data) ?? panic("value is not canonical JSON")
    print(r)
}
