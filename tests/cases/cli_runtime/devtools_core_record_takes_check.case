# `jet self devtools core-record` is the compiler build's check of Core and the
# Prelude alone (JetCli CoreRecordCheck.jet); it runs only as `--check`, as
# `--write <file>`, which also writes the record to the file, as
# `--embed <image> <out>`, which adds it to an executable, or as `--embedded`,
# which reads the record the build added to this jet. The record holds each
# Core module's checked and registration rows, its checked bodies, its
# comptime values and the check's declaration table, and every row reads
# back and encodes to the same tree.
env: NO_COLOR=1
step: jet self devtools core-record
exit: 2
stdout: = ""
stderr: = "usage: jet self devtools core-record --check | --write <file> | --embed <image> <out> | --embedded\n"
step: jet self devtools core-record --check --out
exit: 2
stderr: = "usage: jet self devtools core-record --check | --write <file> | --embed <image> <out> | --embedded\n"
step: jet self devtools core-record --write
exit: 2
stderr: = "usage: jet self devtools core-record --check | --write <file> | --embed <image> <out> | --embedded\n"
step: jet self devtools core-record --write --check
exit: 2
stderr: = "usage: jet self devtools core-record --check | --write <file> | --embed <image> <out> | --embedded\n"
step: jet self devtools core-record --embed image
exit: 2
stderr: = "usage: jet self devtools core-record --check | --write <file> | --embed <image> <out> | --embedded\n"
step: jet self devtools core-record --embedded
exit: 0
stdout: ~ "every row read back and encoded to the same tree" # the line also carries row counts, a sha256 and the wall time, which change with Core
stdout: ~ " registration rows, " # section 6 is counted; the count follows Core
stdout: ~ " declaration rows, " # section 7 is counted; the count follows Core
stdout: ~ " comptime values, " # section 8 is counted; the count follows Core
stdout: ~ "core-record section 5: " # section 5 (body packets) has a size line; its counts and bytes follow Core
stderr: empty
