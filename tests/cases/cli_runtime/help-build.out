jet build — Create a native executable

  jet build [<file.jet|dir>] | build --verify <receipt-id>
  --json                       Emit machine-readable facts or diagnostics
  --quiet                      Suppress non-error status output
  --color                      Color: auto | always | never
  --small                      Favor a smaller binary
  --lib                        Emit the native Library and C header
  --output                     Select a named output (build --lib selects a Library; Canvas uses it as the initial selection)
  --locked                     Require locked dependency and provenance facts
  -p                           Pick a workspace member by name
  --import                     Import and inspect an existing foreign build graph
  --sbom                       Also write an SPDX SBOM next to the binary
  --verbose                    Print the bridge steps; with check: print the status line, proof rows, and receipt notices; with run/dev/test: show advisory lints; with explain: show a syntax token's registry name and decision
  --allow                      Allow comma-separated effect roots or leaves as --allow=RIGHTS
  --deny                       Deny comma-separated effect roots or leaves as --deny=RIGHTS
  --gate                       Allow one audited gate as --gate name=allow
  --target                     Select a target (triple, board.<name>, or named database target)
  --verify                     Rebuild and compare one indexed receipt artifact
  --emit-generated             Copy generated Jet sources into `.jet/generated/`
  --release                    Optimize for release
  --profile                    How hard to optimize: release, debug, ci, hardened, or a named optimization bundle
  --optimize                   How hard to optimize: none, basic or full
  --set                        Set one declared package setting as key=value
  --threads                    Use at most N compiler threads (1 = one thread); without it jet picks a safe number of compiler threads
  --builder                    Select a previously bound remote builder
  --show-default               Use and report the stock default
