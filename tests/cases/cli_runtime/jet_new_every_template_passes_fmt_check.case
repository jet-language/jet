# Criterion 1: every `jet new --template` scaffold is written as `jet fmt`
# writes it, so `jet fmt --check` in the fresh project exits 0.
env: NO_COLOR=1
step: jet new fresh_default
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_default
exit: 0
step: jet new fresh_cli --template cli
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_cli
exit: 0
step: jet new fresh_ui --template ui
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_ui
exit: 0
step: jet new fresh_web --template web
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_web
exit: 0
step: jet new fresh_overrides --template overrides
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_overrides
exit: 0
step: jet new fresh_annotated --annotated
cwd: {work}/
exit: 0
step: jet fmt --check
cwd: {work}/fresh_annotated
exit: 0
