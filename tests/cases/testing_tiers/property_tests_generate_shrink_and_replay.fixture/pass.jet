#Test addition_commutes: fn(a: Int, b: Int) {
    assert_eq(a + b, b + a)
}

#Test generated_values_keep_their_bounds: fn(xs: [Int], flags: [Bool], letter: Char, word: String, ratio: Float, maybe: Int?, small: I8, byte: U8, narrow: F32) {
    assert(xs.len() <= 16)
    assert(flags.len() <= 16)
    assert(word.count_bytes() <= 64)
    assert(letter == letter)
    assert(ratio == ratio && narrow == narrow)
    assert(small >= I8{-128} && byte <= U8{255})
    if maybe == .Val(value) -> assert_eq(value, value)
}

#Test("a unit claim runs beside properties") {
    assert(true)
}
