use {
    testing: core.testing
    sys: core.sys
}

run: fn() {
    sys.set("JET_UPDATE_SNAPSHOTS", "1")
    print(testing.snap("source snap é", "first\n"))
    sys.set("JET_UPDATE_SNAPSHOTS", "0")
    print(testing.snap("source snap é", "second\n"))
    sys.set("JET_UPDATE_SNAPSHOTS", "1")
    print(testing.snap("source snap é", "second\n"))
    sys.set("JET_UPDATE_SNAPSHOTS", "0")
    print(testing.snap("source snap é", "second\n"))
}
