# D-TEST-READS1 (#6064): `jet test` stores a passing run's results with the files its tests read; a rerun with every read file unchanged reuses them without running the test, and a changed read file runs it again. The test appends to `runs.log` each time it runs.
fixture: test_results_rerun_when_a_read_file_changes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1

step first: jet test
cwd: app
exit: 0
stderr: !~ "reused" # the first run has no stored results
file: app/runs.log = "ran\n"

step again: jet test
cwd: app
exit: 0
stderr: ~ "jet test: reused 1 stored result" # the read file is unchanged
file: app/runs.log = "ran\n" # so the test did not run

write: app/data.txt = "changed\n"

step changed: jet test
cwd: app
exit: 0
stderr: !~ "reused" # the read file changed
file: app/runs.log = "ran\nran\n" # so the test ran again

step stored: jet test
cwd: app
exit: 0
stderr: ~ "jet test: reused 1 stored result" # the new run's reads were stored
file: app/runs.log = "ran\nran\n"

step fresh: jet test --fresh
cwd: app
exit: 0
stderr: !~ "reused" # --fresh skips the store
file: app/runs.log = "ran\nran\nran\n"
