// The planted bug: reversing a list of exactly three elements drops its
// first one, so `reverse_list(reverse_list(xs)) == xs` breaks only at
// length 3.
reverse_list: fn(xs: [Int]) -> [Int] {
    out := [Int]{}
    index := xs.len()
    loop index > 0 {
        index -= 1
        if xs.len() == 3 && index == 0 -> break
        out.push(xs[index])
    }
    out
}

#Test reverse_twice_is_identity: fn(xs: [Int]) {
    assert_eq(reverse_list(reverse_list(xs)), xs)
}
