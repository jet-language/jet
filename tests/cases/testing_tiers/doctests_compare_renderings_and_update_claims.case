# D-TEST4: a fenced ```jet block in a `///` doc comment is a doctest claim of `jet test`. It can call the file's own functions, each `EXPR // => VALUE` line compares the rendering of EXPR exactly, a mismatch fails with E2901 at that line, and `--update-snapshots` rewrites a stale claim.
fixture: doctests_compare_renderings_and_update_claims.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache

step pass: jet test --show-default --capture=all pass.jet
exit: 0 # every claimed rendering matches
stdout: ~ "doctest 1 of double in pass.jet: pass" # the doctest is a claim named by the item it documents and its ordinal there
stdout: ~ "double is linear: pass" # ordinary claims run beside it
stdout: ~ "from the doctest" # the doctest's own output is kept
stdout: ~ "2 passed, 0 failed" # doctests share the summary

step release: jet test --show-default --release pass.jet
exit: 0 # the optimized tier runs the same doctest
stdout: ~ "2 passed, 0 failed" # release tier summary

step docs: jet test --docs pass.jet
exit: 0 # the doctest alone passes
stdout: ~ "doctest 1 of double in pass.jet: pass" # --docs runs the doctest claims
stdout: !~ "double is linear" # and no other claim
stdout: ~ "1 passed, 0 failed" # the summary counts the doctest alone

step fail: jet test fail.jet
exit: nonzero # a wrong claim fails the run
stdout: ~ "doctest 1 of four in fail.jet: FAIL" # the doctest is the failing claim
stderr: ~ "E2901" # the doctest mismatch diagnostic
stderr: ~ "Expected: `5` Got: `4`" # names the claimed and the rendered value
stderr: ~ "fail.jet:2" # at the line of the claim

step update: jet test --update-snapshots stale.jet
exit: 0 # a stale claim is rewritten, not failed
stdout: ~ "doctest 1 of pred in stale.jet: pass" # the updated doctest passes

step updated: jet test stale.jet
exit: 0 # the rewritten claim holds on the next run
