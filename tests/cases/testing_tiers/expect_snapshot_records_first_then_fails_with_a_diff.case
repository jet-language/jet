# expect(value).snapshot() (D-TOOL4, D-TESTKIT1): the first plain run writes `__snapshots__/<file>_<line>.snap` and passes; a changed value fails with `snapshot differs` and a unified diff, leaving the snapshot alone; `jet test -u` rewrites it and a plain run then passes.
fixture: expect_snapshot_records_first_then_fails_with_a_diff.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1

step first: jet test
cwd: app
exit: 0 # a missing snapshot is recorded, not failed
file: app/__snapshots__/run_jet_8.snap ~ "hello\n" # named after the call's file and line

step again: jet test
cwd: app
exit: 0 # the recorded snapshot now matches

copy: alt/changed.jet app/run.jet

step changed: jet test
cwd: app
exit: nonzero # the new value differs from the snapshot
stderr: ~ "snapshot differs: run_jet_8" # the failure names the snapshot
stderr: ~ "-hello\n+hello, world\n" # the unified diff body
file: app/__snapshots__/run_jet_8.snap ~ "hello\n" # a plain run leaves the snapshot alone

step update: jet test -u
cwd: app
exit: 0 # -u rewrites the snapshot
file: app/__snapshots__/run_jet_8.snap ~ "hello, world\n" # the snapshot holds the new value

step check: jet test
cwd: app
exit: 0 # the rewritten snapshot matches
