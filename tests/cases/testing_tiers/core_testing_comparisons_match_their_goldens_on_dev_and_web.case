# #6035 c50: core.testing comparisons have one meaning on every tier (I9). The goldens
# cover `jet run` (O0), `jet build` (O1) and `--release` (O2). Here the three tooling
# examples also run once under `jet dev`, and are built for web and run under node.
# Each prints byte-for-byte its golden. The web loader holds no testing code: the
# comparison runs in the wasm image compiled from the same Core source, with no
# JavaScript test runner beside it.
requires: tool:node
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
write: run.mjs = "const app = await import(process.cwd() + '/app.js');\nawait app.jet_main();\n"
copy: {root}/Examples/Tooling/Testing/TestCompare/run.jet compare/main.jet
step: jet dev --watch=off main.jet
cwd: compare
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestCompare.out
step: jet build --target web main.jet
cwd: compare
exit: 0
file: compare/.jet/build/app.js !~ "testing" # the loader carries no testing glue
step: node {work}/run.mjs
cwd: compare/.jet/build
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestCompare.out
copy: {root}/Examples/Tooling/Testing/TestHistory/run.jet history/main.jet
step: jet dev --watch=off main.jet
cwd: history
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestHistory.out
step: jet build --target web main.jet
cwd: history
exit: 0
file: history/.jet/build/app.js !~ "testing" # the loader carries no testing glue
step: node {work}/run.mjs
cwd: history/.jet/build
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestHistory.out
copy: {root}/Examples/Tooling/Testing/TestOutcomes/run.jet outcomes/main.jet
step: jet dev --watch=off main.jet
cwd: outcomes
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestOutcomes.out
step: jet build --target web main.jet
cwd: outcomes
exit: 0
file: outcomes/.jet/build/app.js !~ "testing" # the loader carries no testing glue
step: node {work}/run.mjs
cwd: outcomes/.jet/build
exit: 0
stdout: = ../../../Examples/Tooling/Testing/TestOutcomes.out
