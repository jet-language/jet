# `jet test-compare` exits 0 only for a matched corpus. A recorded timeout or
# cancellation, an empty or entirely discarded corpus, a partly discarded corpus, a replay
# that changed (contamination) and a mismatch all exit 1, and equal samples never claim proof.
# Each corpus runs in its own directory: the outcome lines below are the whole of stdout.
fixture: test_compare_passes_only_a_matched_recorded_corpus.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet test-compare corpus.json
cwd: matched
exit: 0
stdout: = "status=matched relation=typed_equality samples=1 reason=1 observed case(s) matched under typed_equality\n"
step: jet test-compare corpus.json --json
cwd: matched
exit: 0
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "test-compare"
json: stdout doc $.ok = true
json: stdout doc $.comparison.status = "matched"
json: stdout doc $.comparison.universal_proof = false # equal samples are reported, never as a universal proof
step: jet test-compare corpus.json
cwd: timeout
exit: 1
stdout: = "status=timeout relation=typed_equality samples=1 reason=recorded runner outcome is timeout\n"
step: jet test-compare corpus.json
cwd: cancelled
exit: 1
stdout: = "status=cancelled relation=typed_equality samples=1 reason=recorded runner outcome is cancelled\n"
step: jet test-compare corpus.json
cwd: empty
exit: 1
stdout: = "status=empty relation=typed_equality samples=0 reason=comparison corpus is empty\n"
step: jet test-compare corpus.json
cwd: discarded
exit: 1
stdout: = "status=empty relation=typed_equality samples=0 reason=all comparison cases were discarded\n"
step: jet test-compare corpus.json
cwd: partial
exit: 1
stdout: = "status=invalid_oracle relation=typed_equality samples=1 reason=comparison discarded cases and cannot claim equality\n"
step: jet test-compare corpus.json
cwd: drift
exit: 1
stdout: = "status=contaminated relation=typed_equality samples=1 reason=reference observation changed on replay for case `a`\n"
step: jet test-compare corpus.json
cwd: mismatch
exit: 1
stdout: = "status=mismatch relation=typed_equality samples=1 reason=first differing observation is case `a`\nreplay case=a input=input-a source=jet.test-compare tool=jet target=recorded-corpus\nreference={\"answer\":1}\ncandidate={\"answer\":2}\n"
