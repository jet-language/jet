# Two corpus files compared in turn from one directory share its comparison history: each run
# records its evidence and receipt under the corpus's own directory (a corpus file is never taken
# for that directory), the second distinct corpus extends the record index the first one wrote,
# and a repeated corpus finds its rows already current. No run reports a persistence failure.
fixture: test_compare_records_two_corpora_in_one_project.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet test-compare timeout.json
exit: 1
stdout: = "status=timeout relation=typed_equality samples=1 reason=recorded runner outcome is timeout\n"
stderr: empty
step: jet test-compare matched.json
exit: 0
stdout: = "status=matched relation=typed_equality samples=1 reason=1 observed case(s) matched under typed_equality\n"
stderr: empty
step: jet test-compare timeout.json
exit: 1
stdout: = "status=timeout relation=typed_equality samples=1 reason=recorded runner outcome is timeout\n"
stderr: empty
