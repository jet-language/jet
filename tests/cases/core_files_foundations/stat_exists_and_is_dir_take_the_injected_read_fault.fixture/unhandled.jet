package: {
    name: "files_read_fault_unhandled"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, FS] }
}
use files: core.files

// The negative control: each probe stops when the injected FS.Read fault
// reaches it, so every test fails and each report names the fault. A probe
// that skipped the checkpoint would let its test pass.
#Test(faults: [FS.Read]) stat_stops_on_read_fault: fn() {
    info: files.stat("unhandled.jet") ?? panic("stat read fault not handled")
    assert(info.size > 0)
}

#Test(faults: [FS.Read]) exists_stops_on_read_fault: fn() {
    if !files.exists("unhandled.jet") -> panic("exists read fault not handled")
}

#Test(faults: [FS.Read]) is_dir_stops_on_read_fault: fn() {
    if !files.is_dir(".") -> panic("is_dir read fault not handled")
}

run: fn() {}
