package: {
    name: "files_read_fault"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, FS] }
}
use files: core.files

// Each probe survives the injected FS.Read fault: stat returns the typed
// injected error, exists and is_dir answer false instead of stopping.
#Test(faults: [FS.Read]) stat_fault_is_typed: fn() {
    if files.stat("handled.jet") == {
        .Ok(info) -> assert(info.size > 0)
        .Err(error) -> {
            if error == {
                .Other(context) -> assert_eq(context.cause, Val("fault injected: FS.Read"))
                else -> panic("stat expected the injected FS.Read fault, got {error:Debug}")
            }
        }
    }
}

#Test(faults: [FS.Read]) exists_fault_answers_false: fn() {
    if !files.exists("handled.jet") -> print("exists answered false")
}

#Test(faults: [FS.Read]) is_dir_fault_answers_false: fn() {
    if !files.is_dir(".") -> print("is_dir answered false")
}

run: fn() {}
