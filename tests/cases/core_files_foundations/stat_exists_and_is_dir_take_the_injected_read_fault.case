# D-TESTFAULT1 FS.Read faults reach the source-owned metadata probes (#5976 c14):
# `#Test(faults: [FS.Read])` fails the FS.Read checkpoint that stat, exists and
# is_dir take, one rerun per reached call. stat returns the typed injected
# error and exists and is_dir answer false, on every optimization level.
# The negative control stops each probe on its fault: every test fails and its
# report names the injected fault, so a probe that skipped the checkpoint
# would turn a FAIL into a pass here.
fixture: stat_exists_and_is_dir_take_the_injected_read_fault.fixture
env: NO_COLOR=1
step o0: jet test --show-default --capture=all --serial --optimize=none handled.jet
exit: 0
stdout: = "stat_fault_is_typed: pass\nexists_fault_answers_false: pass\nis_dir_fault_answers_false: pass\n3 passed, 0 failed, 0 skipped\n"
step: jet test --show-default --capture=all --serial --optimize=basic handled.jet
exit: == o0
stdout: == o0
stderr: == o0
step: jet test --show-default --capture=all --serial --optimize=full handled.jet
exit: == o0
stdout: == o0
stderr: == o0
step u0: jet test --show-default --capture=all --serial --optimize=none unhandled.jet
exit: 1
stdout: = "stat_stops_on_read_fault: FAIL\nexists_stops_on_read_fault: FAIL\nis_dir_stops_on_read_fault: FAIL\n0 passed, 3 failed, 0 skipped\n"
stderr: ~ "fault injected: FS.Read call 1" # each failure report heads with the injected fault before its E3001 stop
stderr: ~ "stat read fault not handled" # stat took the fault
stderr: ~ "exists read fault not handled" # exists took the fault
stderr: ~ "is_dir read fault not handled" # is_dir took the fault
step: jet test --show-default --capture=all --serial --optimize=basic unhandled.jet
exit: == u0
stdout: == u0
stderr: == u0
step: jet test --show-default --capture=all --serial --optimize=full unhandled.jet
exit: == u0
stdout: == u0
stderr: == u0
