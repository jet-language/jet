
label: fn(value: Int) -> String Never! {
    if value == {
        1 -> { "one" }
        else -> { "other" }
    }
}

early: fn(flag: Bool) -> String Never! {
    if flag { return "early" }
    "late"
}

Packet: enum {
    Data(Int)
    Retry(Int)
    Empty
    Ignore(Int)
}

packet_value: fn(packet: Packet) -> Int Never! {
    if packet == {
        .Data(10..19) -> { 100 }
        .Data(value) | .Retry(value) -> {
            if value == 0 -> return 9
            if value > 0 -> { value + 1 } else -> { -1 }
        }
        .Ignore(_) -> { 0 }
        .Empty -> { 0 }
        else -> { -2 }
    }
}

EXPECTED_ONE: #run label(1)
EXPECTED_OTHER: #run label(2)
EXPECTED_EARLY: #run early(true)
EXPECTED_LATE: #run early(false)
EXPECTED_RANGE: #run packet_value(Packet.Data(12))
EXPECTED_OR: #run packet_value(Packet.Retry(2))
EXPECTED_NESTED_RETURN: #run packet_value(Packet.Data(0))
EXPECTED_EMPTY: #run packet_value(Packet.Empty)
EXPECTED_WILDCARD: #run packet_value(Packet.Ignore(17))

run: fn() {
    print(EXPECTED_ONE)
    print(EXPECTED_OTHER)
    print(EXPECTED_EARLY)
    print(EXPECTED_LATE)
    print(label(1))
    print(label(2))
    print(early(true))
    print(early(false))
    print(EXPECTED_RANGE)
    print(EXPECTED_OR)
    print(EXPECTED_NESTED_RETURN)
    print(EXPECTED_EMPTY)
    print(EXPECTED_WILDCARD)
    print(packet_value(Packet.Data(12)))
    print(packet_value(Packet.Retry(2)))
    print(packet_value(Packet.Data(0)))
    print(packet_value(Packet.Empty))
    print(packet_value(Packet.Ignore(17)))
}
