fn grade(score: Int) -> String {
    if score >= 90 {
        return "a"
    } else if score >= 80 {
        return "b"
    } else {
        return "c"
    }
}

fn show(score: Int) {
    if score >= 90 {
        print("A")
    } else if score >= 80 {
        print("B")
    } else {
        print("C")
    }
}

fn run() {
    print(grade(95))
    print(grade(85))
    print(grade(10))
    show(95)
    show(85)
    show(10)
}
