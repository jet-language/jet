// Must fail: an endpoint marker marks a job, a webhook and a signing key,
// each of which only the server runs.
use app

Crew: struct {
    #[App.Job, App.Public]
    tell_assignee: fn(self, id: Int) -> Int Never! { id }

    #[App.SignedIn, App.Webhook(path: "/hooks/:project", signature: app.Signature.GitHub, key: "webhook_secret")]
    on_event: fn(self, project: String, event: String) -> Int Never! { project.len() + event.len() }

    #[App.SigningKey, App.Public]
    webhook_secret: fn(self, project: String) -> String? { Val("secret-{project}") }
}
