// Must fail: a client calls the service's job through its Remote, which
// offers only the endpoints.
use app

Crew: struct {
    #App.SignedIn add_task: fn(self, title: String) -> Int Never! { title.len() }

    #App.Job tell_assignee: fn(self, id: Int) -> Int Never! { id }
}

steal: fn(crew: app.Remote<Crew>) -> Int app.CallError! { crew.tell_assignee(1) }
