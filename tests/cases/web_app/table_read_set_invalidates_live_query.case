# A typed table's reads join a live binding's read set: a query function that
# reads a table through `get` or `query` is re-run by a committed `add`, `put`
# or `delete` that changes a row of that table, and by the `add` that creates
# the table it read while it did not exist. A write to another table, or a
# delete that removes no row, re-runs nothing, and a write inside a
# transaction reaches the binding at the commit. The same lines print at O0,
# O1 and O2.
fixture: table_read_set_invalidates_live_query.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = table_read_set_invalidates_live_query.stdout.expected
step: jet build main.jet
exit: 0
step debug: built
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
