# PORT tests/web_app.rs::web_app_dev_auto_serves_with_reload_without_dev_function; request helper63-95 ported verbatim algorithm.
# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four); no run/reference proof.
mkdir: client
copy: {root}/tests/cases/web_app/fixtures/request.jet client/request.jet
copy: {root}/Examples/features/web/web_app.jet app.jet
copy: {root}/Examples/features/web/package.jet package.jet
spawn server: jet dev {work}/app.jet --port={free-port:app}
env: JET_APP_PORT={free-port:app}
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=GET
env: S6_WEB_PATH=/
env: S6_WEB_RESPONSE={work}/page.http
exit: 0
file: page.http ^= "HTTP/1.1 200" # Original starts_with.
file: page.http ~ "EventSource(\"/__jet/reload\")" # Original contains predicate.
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=GET
env: S6_WEB_PATH=/__jet/reload
env: S6_WEB_RESPONSE={work}/reload.http
env: S6_WEB_RELOAD_APP={work}/app.jet
exit: 0
# Original predicate: helper reads to EOF against absolute250ms then10s windows from send/shutdown and source append.
file: reload.http ^= "HTTP/1.1 200" # Original starts_with.
file: reload.http ~ "text/event-stream" # Original contains predicate.
file: reload.http ~ "data: reload" # Original contains predicate.
signal server: KILL
wait: server
exit: any # Original ServerChild drop kill/wait ignores status.
