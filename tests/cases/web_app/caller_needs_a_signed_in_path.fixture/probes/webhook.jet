// A webhook reads `app.caller()`: a delivery is signed by its sender, not
// by a signed-in account.
use {
    app
    web: core.web
}

Hooks: struct {
    #App.Webhook(path: "/hooks/:project", signature: app.Signature.Stripe, key: "webhook_secret") on_event: fn(self, project: String, event: String) -> Int {
        who: app.caller()
        who.len() + project.len() + event.len()
    }

    #App.SigningKey webhook_secret: fn(self, project: String) -> String? { Val(project.copy()) }
}

run: fn() { _: web.app().mount(Hooks{}) }
