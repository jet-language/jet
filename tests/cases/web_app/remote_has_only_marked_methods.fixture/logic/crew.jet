// The Crew service. Its three marked methods are endpoints; the signing key
// and the job are unmarked, so they stay on the server.
use app

ProjectID: struct {
    value: Int
}

TaskID: struct {
    value: Int
}

#Error
TaskError: enum {
    NotFound
    Unreachable(String)
    SignedOut
}

// A call through an `app.Remote<Crew>` can fail on the way; each failure
// has a case.
impl app.CallError -> TaskError {
    if self == {
        .Unreachable(why) -> TaskError.Unreachable(why)
        .Invalid(errors) -> TaskError.Unreachable("{errors.len()} invalid arguments")
        .SignedOut -> TaskError.SignedOut
        .UpdateRequired -> TaskError.Unreachable("update required")
    }
}

// What a failed call says.
reason: fn(error: TaskError) -> String {
    if error == {
        .NotFound -> "not found"
        .Unreachable(why) -> "unreachable: {why}"
        .SignedOut -> "signed out"
    }
}

new_task_id: fn() -> TaskID { TaskID{value: 1} }

Crew: struct {
    name: String

    // A signed-in caller moves a task.
    #App.SignedIn move_task: fn(self, id: TaskID) -> Int TaskError! {
        if id.value < 0 -> return Err(TaskError.NotFound)
        Ok(id.value + 1)
    }

    // Any caller looks a task up.
    #App.Public lookup: fn(self, id: TaskID) -> Int TaskError! {
        if id.value < 0 -> return Err(TaskError.NotFound)
        Ok(id.value + 1)
    }

    // Any caller reads the service's status.
    #App.Public status: fn(self) -> String { "{self.name} is up" }

    // The webhook signing key.
    webhook_secret: fn(self, project: ProjectID) -> String? { Val("secret-{project.value}") }

    // The job that tells a task's assignee.
    tell_assignee: fn(self, id: TaskID) TaskError! {
        if id.value < 0 -> return Err(TaskError.NotFound)
        Ok()
    }
}
