// A Crew mounted at /api answers a Remote that `app.remote_at` made: each
// call posts its arguments to the server, and the reply comes back as the
// method's value or error. The server has no sign-in, so the signed-in
// method refuses the call.
use {
    app
    net: core.net
    web: core.web
    logic
}

// A lookup through the Remote, as its value or what its failure says.
lookup: fn(crew: app.Remote<logic.Crew>, id: Int) -> String {
    found: crew.lookup(logic.TaskID{value: id}) ?? return logic.reason(err)
    "{found}"
}

move: fn(crew: app.Remote<logic.Crew>, id: Int) -> String {
    moved: crew.move_task(logic.TaskID{value: id}) ?? return logic.reason(err)
    "{moved}"
}

run: fn() (NetError | TaskFailure)! {
    served: web.app().mount("/api", logic.Crew{name: "crew"})
    listener: net.tcp_listen("127.0.0.1:0")
    addr: listener.local_addr()
    serving: task {
        served.serve_once(listener)
        served.serve_once(listener)
        served.serve_once(listener)
        served.serve_once(listener)
    }
    crew: app.remote_at<logic.Crew>("http://{addr}/api")
    print(crew.status() ?? "down")
    print(lookup(crew, 41))
    print(lookup(crew, -1))
    print(move(crew, 41))
    serving.join()
}
