# app.notify's sender skips a device whose push service has no settings,
# and keeps the skip with its service, account and reason. The reasons stay
# in-process, in app's package-private `push.outcomes`, so the case runs
# the Core/Web #Test that reads them.
env: NO_COLOR=1
step: jet test {root}/Core/Web/Web.jet --filter "a push to a device whose push service is not set up is skipped"
timeout: 1800s
exit: 0
stdout: ~ "1 passed, 0 failed" # the skip is kept as `skipped fcm acct_unset: no FCM settings`
stderr: !~ "internal compiler error" # the run doesn't crash the compiler
