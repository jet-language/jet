# Serve proof for Examples/features/web/app_hello.jet, whose golden is `run: none` (serves until stopped).
# PENDING-SAME-HEAD: authored 2026-10-17, runtime not run; a0_001 refuses #Target(Web) app entries.
mkdir: client
copy: {root}/tests/cases/web_app/fixtures/request.jet client/request.jet
spawn server: jet run {root}/Examples/features/web/app_hello.jet
env: JET_APP_PORT={free-port:app}
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=GET
env: S6_WEB_PATH=/
env: S6_WEB_RESPONSE={work}/page.http
exit: 0
file: page.http ^= "HTTP/1.1 200"
file: page.http ~ "<title>Hello</title>"
file: page.http ~ "world"
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=POST
env: S6_WEB_PATH=/actions/save
env: S6_WEB_RESPONSE={work}/action.http
exit: 0
file: action.http ^= "HTTP/1.1 200"
signal server: KILL
wait: server
exit: any
