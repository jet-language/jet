# A server caps its live queries and coalesces their bursts: a burst of
# writes between two reads re-runs a binding once, however many subscribers
# then read it; a server re-runs at most 1000 bindings a second, after which
# a due binding serves its stored result, held until the next second, and
# re-runs once then; and it keeps at most 1024 bindings, evicting the oldest.
# live_stats reports the cap and the holds it made. Same output on o0/o1/o2.
fixture: live_query_caps_and_coalescing.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = live_query_caps_and_coalescing.stdout.expected
step: jet build main.jet
exit: 0
step debug: built
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
