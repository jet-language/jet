# PORT tests/web_app.rs::web_app_run_serves_pages_actions_and_assets; request helper63-95 ported verbatim algorithm.
# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four); no run/reference proof.
mkdir: client
copy: {root}/tests/cases/web_app/fixtures/request.jet client/request.jet
copy: {root}/Examples/features/expected/web/web_app.harness.out expected-harness.out
capture: expectedPage = text file.split("\n\n--- facts_json ---\n", 0) expected-harness.out
capture: expectedFacts = text file.split("\n\n--- facts_json ---\n", 1) expected-harness.out
spawn server: jet run {root}/Examples/features/web/web_app.jet
env: JET_APP_PORT={free-port:app}
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=GET
env: S6_WEB_PATH=/
env: S6_WEB_RESPONSE={work}/page.http
exit: 0
file: page.http ^= "HTTP/1.1 200" # Original starts_with.
file: page.http ~ "<title>Home</title>" # Original contains predicate.
file: page.http ~ "hello from csr" # Original contains predicate.
file: page.http !~ "jet-dev-server-functions" # Original negative predicate.
file.after_first("\r\n\r\n"): page.http = "{cap:expectedPage}"
step: jet explain --web-graph --json {root}/Examples/features/web/web_app.jet
exit: 0
stdout.replace("{root}/Examples/features/web/web_app.jet", "Examples/features/web/web_app.jet"): = "{cap:expectedFacts}"
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=POST
env: S6_WEB_PATH=/actions/save
env: S6_WEB_RESPONSE={work}/action.http
exit: 0
file: action.http ^= "HTTP/1.1 200" # Original starts_with.
file: action.http ~ "content-type: application/json" # Original contains predicate.
file: action.http ~ "content-security-policy: default-src 'self'" # Original contains predicate.
file.after_first("\r\n\r\n"): action.http = "\"saved\""
file: action.http !~ "server function input is missing" # Original negative predicate.
step: jet run client/request.jet
env: S6_WEB_PORT={free-port:app}
env: S6_WEB_METHOD=GET
env: S6_WEB_PATH=/assets/app.css
env: S6_WEB_RESPONSE={work}/asset.http
exit: 0
file: asset.http ^= "HTTP/1.1 200" # Original starts_with.
file: asset.http ~ "font-family" # Original contains predicate.
signal server: KILL
wait: server
exit: any # Original ServerChild drop kill/wait ignores status.
