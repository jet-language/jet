# A live query that reads no caller-dependent input is one binding per source
# and arguments: every subscriber that binds it with the same arguments reads
# the one stored result, so the source runs once per write, not once per
# subscriber; other arguments are their own binding. Same output on o0/o1/o2.
fixture: live_query_shared_result.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = live_query_shared_result.stdout.expected
step: jet build main.jet
exit: 0
step debug: built
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
