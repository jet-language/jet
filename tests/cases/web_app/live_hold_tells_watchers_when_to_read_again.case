# A live binding that writes keep overtaking settles into a hold, and the hold
# is never served as current: the live event published when it starts carries
# its length (after_ms), so a device that read the held result while the
# writes ran reads again once it ends and gets the newer value, and that first
# current result publishes the binding's event again for every other watcher.
# Same output on o0/o1/o2.
fixture: live_hold_tells_watchers_when_to_read_again.fixture
env: NO_COLOR=1
step default: jet run main.jet
exit: 0
stdout: = live_hold_tells_watchers_when_to_read_again.stdout.expected
step: jet build main.jet
exit: 0
step debug: built
exit: 0
stdout: == default
step release: jet run --release main.jet
exit: 0
stdout: == default
