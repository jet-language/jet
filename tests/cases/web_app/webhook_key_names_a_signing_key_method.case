# A webhook's `key:` names the method of its service that gives each
# delivery's key, and that method must be marked `#App.SigningKey`. The
# fixture's webhook names its signing-key method and checks. A `key:` that
# names an unmarked method, or no method at all, is refused at the `key:`
# argument.
fixture: webhook_key_names_a_signing_key_method.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0

step: jet check probes/key_unmarked.jet
exit: nonzero
stderr: ~ "names no `#App.SigningKey` method of `Hooks`" # the named method is unmarked
stderr: ~ "key_unmarked.jet:8:81" # at the `key:` argument

step: jet check probes/key_unknown.jet
exit: nonzero
stderr: ~ "`key: \"secret\"` names no `#App.SigningKey` method of `Hooks`" # no method is named `secret`
stderr: ~ "key_unknown.jet:9:81" # at the `key:` argument
