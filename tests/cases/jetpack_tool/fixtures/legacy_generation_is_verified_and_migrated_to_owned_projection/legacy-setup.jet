// SETUP-PORT tests/jetpack_tool.rs:1281-1296; first matching Store metadata,
// original template and Debug String (JSON-compatible) quoting; asserts nothing.
// Arguments: <store root> <output hash> <home>.
use {
    core.files
    core.process
    core.encoding.json
}
field: fn(text: String, key: String) -> String {
    needle: "\"{key}\": \""
    parts: text.split(needle).to_list()
    if parts.len() < 2 -> panic("missing metadata key")
    tail: parts[1]
    return tail.split("\"").to_list()[0]
}
run: fn() {
    args: process.args()
    store: args[0]
    hash: args[1]
    home: args[2]
    entries: files.list_dir("{store}/hangar") ?? panic("list {store}/hangar: {err}")
    loop entry in entries {
        path: "{entry.path}/meta.json"
        if files.is_file(path.copy()) {
            meta: files.read(path.copy()) ?? panic("read {path}: {err}")
            if meta.contains("greet@jetpack") {
                target: "{field(meta, "bin")}/greet"
                template: files.read("legacy.template") ?? panic("read legacy.template: {err}")
                legacy: template.replace("OUTPUT_HASH", json.to_string(Dyn.Text(hash))).replace("TARGET_PATH", json.to_string(Dyn.Text(target)))
                files.write("{home}/.jet/tools/generations/1/meta.json", legacy) ?? panic("write generation meta: {err}")
                files.write("{home}/.jet/tools/generations/1/complete", "complete\n") ?? panic("write generation marker: {err}")
                return
            }
        }
    }
    panic("greet Store metadata")
}
