# `jet emit --ast` keeps a generic type written where a value goes whole:
# `show(Box<Int>)` prints `type Box<Int>`, not a bare `ident Box`, and every
# tier's build reports the same whole type (E0636).
write: main.jet = "Box: struct<T> {\n    value: T\n}\n\nshow: fn(x: Int) {}\n\nrun: fn() {\n    show(Box<Int>)\n}\n"
step: jet emit --ast main.jet
exit: 0
stdout: ~ "call show\n    type Box<Int>\n" # the argument node keeps its type arguments
stdout: !~ "ident Box" # it is not dropped to the bare name
step o0: jet run --optimize=none main.jet
exit: 1
stderr: ~ "`Box<Int>` is a type, not a value" # the o0 build names the whole type
step o1: jet run --optimize=basic main.jet
exit: 1
stderr: ~ "`Box<Int>` is a type, not a value" # the o1 build names the whole type
step o2: jet run --optimize=full main.jet
exit: 1
stderr: ~ "`Box<Int>` is a type, not a value" # the o2 build names the whole type
