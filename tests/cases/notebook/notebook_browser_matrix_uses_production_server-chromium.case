# tests/notebook.rs::notebook_browser_matrix_uses_production_server (chromium branch)
# Both available browser branches are discovered; both absent => SKIP-HOST, matching original ran guard.
# Public protocol produces original merge source with the same cwd environment hash; no synthetic serializer bytes.
# The journey is Tools/notebook-test/Acceptance.jet on core.web.browser: launch
# drives the Chromium and chromedriver pinned in {work}/.jet/lock.
requires: os-name:linux
requires: tool:chromium
requires: tool:chromedriver
env: JET_PROJECT_ROOT={work}
fixture: notebook_browser_matrix_uses_production_server-chromium.fixture
step: jet notebook merge.jetnb --protocol
stdin: notebook_browser_matrix_uses_production_server-chromium.fixture/merge.stdin
exit: 0
spawn server: jet notebook {work}/journey.jetnb --bind 127.0.0.1:{free-port:notebook} --token notebook-browser-test-token
stdin: null
stdout: null
stderr: null
poll ready: jet run {root}/tests/cases/web_browser/fixtures/http-ready.jet 127.0.0.1:{free-port:notebook} /health notebook-browser-test-token - until stdout: ^= "HTTP/1.1 200" && stdout: ~ "\"ok\":true" timeout 10s every 25ms # the notebook server answers its health probe
step: jetpack browser lock chromium --binary {tool:chromium} --driver {tool:chromedriver} --version 152.0 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {root}/Tools/notebook-test/Acceptance.jet -- --browser chromium --port {free-port:notebook} --token notebook-browser-test-token --save-path {work}/journey.jetnb --merge-path {work}/merge.jetnb
exit: 0
stdout: ~ "PASS notebook browser matrix (chromium)" # the journey's completion line
signal server: KILL
wait: server
exit: any # original RunningNotebook cleanup ignores kill status
