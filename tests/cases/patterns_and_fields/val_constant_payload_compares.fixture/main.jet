// `x == Val(LIMIT)` compares with the constant: an ALL_CAPS payload is a
// constructor value, never a fresh binding.
LIMIT :: 7

fn pick(flag: Bool) -> Int? {
    if flag -> return Val(7)
    None
}

fn run() {
    if pick(true) == Val(LIMIT) -> print("matched {LIMIT}") else -> print("missed")
    same :: pick(false) == Val(LIMIT)
    print("{same}")
}
