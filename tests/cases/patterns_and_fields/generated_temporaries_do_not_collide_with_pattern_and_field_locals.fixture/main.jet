
Pair: struct {
    left: Int
    right: Int
}
run: fn() {
    value: 7
    v: 3
    range := 0
    s: "ok"
    loop i in 1..<4 {
        range += i
    }
    pair: Pair{ left: value, right: range }
    xs := [v, pair.right]
    xs[0] = value
    loop item in xs {
        print(item)
    }
    print("{s}:{value}:{pair.left}:{range}")
}
