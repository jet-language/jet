
use env: core.sys

Measure: trait {
    measure: fn(self) -> Int
}

Parcel: struct {
    n: Int
}

impl Parcel.Measure {
    measure: fn(self) -> Int {
        value: env.get("JET_CARD_2835") ?? ""
        return self.n
    }
}

via: fn<T: Measure>(value: T) -> Int { value.measure() }

run: fn() {
    print(via(Parcel{n: 5}))
}
