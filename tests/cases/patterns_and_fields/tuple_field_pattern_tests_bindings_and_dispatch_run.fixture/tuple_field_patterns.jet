// Text and binary patterns synthesize structural capture tuples. Their fields
// share ordinary tuple projection IDs and never require nominal declarations.
fn tuple_test(text: String) -> Bool {
    if text == "page-{title}" -> return true
    false
}

fn tuple_bind(text: String) -> String {
    cursor :: Cursor.over(text)
    captured :: cursor.take_pattern("page-{title}:{retries:Int}") ?? return "other"
    captured.title
}

fn tuple_dispatch(text: String) -> String {
    if text == {
        "page-{title}:{retries:Int}" -> title
        "ticket-{title}:{retries:Int}" -> title
        else -> "other"
    }
}

fn run() {
    page :: "page-database:2"
    ticket :: "ticket-docs:1"
    note :: "note-memo:0"
    print(tuple_test(page))
    print(tuple_test(note))
    print(tuple_bind(page))
    print(tuple_bind(note))
    print(tuple_dispatch(page))
    print(tuple_dispatch(ticket))
    print(tuple_dispatch(note))
    reader :: Reader.over([U8]{0x45})
    captured :: reader.take_pattern([U8]{"{version:U4}{words:U4}"}) ?? panic("header did not match")
    assert_eq(captured.version, U8{4})
    assert_eq(captured.words, U8{5})
}
