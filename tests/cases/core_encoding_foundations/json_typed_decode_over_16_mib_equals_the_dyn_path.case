# #6082: typed json.decode<T> takes input over 16 MiB. The fixture builds a
# 17.9 MB array of 220,000 records and decodes it with json.decode<[Person]>
# and through json.parse_with_limits + Dyn.decode; the two results are equal,
# untyped json.parse still refuses the input under the safe limits, and a
# trailing-text error is one root FieldError on jet run and on --release.
fixture: json_typed_decode_over_16_mib_equals_the_dyn_path.fixture
env: NO_COLOR=1
step: jet run main.jet
limit: time=120
exit: 0
stdout: = json_typed_decode_over_16_mib_equals_the_dyn_path.out
step release: jet run --release main.jet
limit: time=120
exit: 0
stdout: = json_typed_decode_over_16_mib_equals_the_dyn_path.out
