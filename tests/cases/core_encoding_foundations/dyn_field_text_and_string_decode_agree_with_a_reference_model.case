# Dyn field(), text(), decode<String>() and a derived Decode over generated
# trees (repeated keys, every variant, multibyte keys and texts) answer as a
# JavaScript model does (first entry of a repeated key), on the interpreter
# and AOT: the in-place Object and Text reads and the route each failure
# still takes keep every value and every failure text.
fixture: dyn_field_text_and_string_decode_agree_with_a_reference_model.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step default: jet run run.jet
exit: 0
stdout: = dyn_field_text_and_string_decode_agree_with_a_reference_model.out
step: jet build run.jet
exit: 0
step aot: built
exit: == default
stdout: == default
stderr: == default
