use {
    encoding: core.encoding
    json: core.encoding.json
}

Person: struct {
    id: Int
    name: String
    salary: Int
    active: Bool
    tags: [String]
}

// 220,000 records in one array: about 17.9 MB, past the 16 MiB safe item size.
wire: fn() -> String {
    parts := ["["]
    loop i in 0..<220000 {
        comma: if i == 0 -> "" else -> ","
        active: if i %% 3 != 0 -> "true" else -> "false"
        parts.push("{comma}{{\"id\":{i},\"name\":\"user{i}\",\"salary\":{(i * 7919) %% 100000},\"active\":{active},\"tags\":[\"t{i %% 5}\",\"t{i %% 7}\"]}}")
    }
    parts.push("]")
    parts.join("")
}

run: fn() {
    text: wire()
    print("over 16 MiB: {text.bytes().len() > 16777216}")
    print("untyped parse keeps its limit: {json.parse(text) == .Err(_)}")
    limits := encoding.EncodingLimits.safe()
    limits.max_item_bytes = 268435456
    tree: json.parse_with_limits(text, limits) ?? panic("Dyn parse")
    through_dyn: tree.decode<[Person]>() ?? panic("Dyn decode")
    typed: json.decode<[Person]>(text) ?? panic("typed decode")
    print("records={typed.len()} equal={typed == through_dyn}")
    active := 0
    salary := 0
    loop person in typed {
        if !person.active -> next
        active += 1
        salary += person.salary
    }
    print("active={active} salary={salary}")
    broken: "{text}x"
    if json.decode<[Person]>(broken) == {
        .Err(errors) -> print("trailing text: {errors.len()} {errors[0].path == ""} {errors[0].reason}")
        .Ok(_) -> panic("trailing text accepted")
    }
}
