use core.encoding.json

Box: struct { n: Int }

run: fn() {
    exponent: `{"n":1e999999999}`
    wire: json.parse(exponent) ?? Dyn.Null
    print("exponent int is an error: {wire["n"].int() == .Err(_)}")
    print("exponent decode<Int> is an error: {json.decode<Box>(exponent) == .Err(_)}")
    zeros: "0".repeat(10000000)
    digits: "{{\"n\":1{zeros}}}"
    big: json.parse(digits) ?? Dyn.Null
    print("10 MB digit int is an error: {big["n"].int() == .Err(_)}")
    print("10 MB digit decode<Int> is an error: {json.decode<Box>(digits) == .Err(_)}")
}
