# Port of tests/jetpack_offline.rs:264-280; runtime PENDING-SAME-HEAD.
# Retargeted off the retired `jetpack build` (2b160ee885): build -> env --prep / use --prep, run -> env / use, test -> jet test.
mkdir: project
mkdir: package-root
env: JETPACK_ROOT={work}/package-root
step: jetpack use --prep greet@jetpack --no-color --offline
cwd: project
env: JETPACK_DENY_NETWORK=1
unset: JETPACK_FIXTURES
exit: 1
stderr: ~ "E1276" # original predicate
stderr: ~ "greet@jetpack" # original predicate
