# Port of tests/jetpack_offline.rs:135-195; runtime PENDING-SAME-HEAD.
refused: hangar-verified-realization
requires: os:unix
mkdir: project
mkdir: package-root
mkdir: fixtures
mkdir: staging/bin
env: JETPACK_ROOT={work}/package-root
# Before execution, helper seals the output with lua-path ../outside\n, then writes the original workspace/package/hello/env sources.
step: jetpack run -p hello --offline --trust --fixtures {work}/fixtures -- sh -c 'printf executed > "$1"' jet-test {work}/project/command-ran
cwd: project
exit: 1
file: project/command-ran absent
stderr: count "couldn't compose package environment" = 1 # original predicate
