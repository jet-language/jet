Player: struct {
    hp: Int
}

damage: fn(p: &Player, amount: Int) { p.hp -= amount }

heal: fn(p: &Player, amount: Int) { p.hp += amount }

tally: fn() {
    n := 0
    n += 1
    n *= 3
    n -= 1
}

index_stay_expanded: fn() {
    xs := [1, 2, 3]
    // An indexed place stays expanded: its compound form is E0164.
    xs[0] = xs[0] + 1
}

run: fn() {
    p := Player{hp: 100}
    damage(p, 30)
    heal(p, 10)
    tally()
    index_stay_expanded()
    print(p.hp)
}
