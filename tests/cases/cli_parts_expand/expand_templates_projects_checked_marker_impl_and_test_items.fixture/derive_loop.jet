// D-STRUCT-ONCE1=A: one typed `#loop` mechanism reaches derive/marker bodies,
// root impl items, and interpolated test declarations.
FieldNames: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            #loop field in target.reflect().fields {
                method: "field_{field.reflect().name}"
                #{method}: fn(self) -> String { field.reflect().name }
            }
        }
    }
}

AddMarkerFields: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            type_name: target.reflect().name
            #loop field in target.reflect().fields {
                method: "marked_{field.reflect().name}"
                impl #{type_name} {
                    #{method}: fn(self) -> String { field.reflect().name }
                }
            }
        }
    }
}

#[FieldNames, AddMarkerFields]
Point: struct {
    x: Int
    y: Int
}

Case: struct {
    n: Int
}

CASES: [Case]{Case{n: 1}, Case{n: 2}}

#loop T in [Point] {
    impl T {
        generated: fn(self) -> String { "generated" }
    }
}

#loop case in CASES {
    #Test("case {case.n}") {
        .measure {
            assert(case.n > 0)
        }
    }
}

run: fn() {
    point := Point{x: 1, y: 2}
    print(point.field_x())
    print(point.field_y())
    print(point.marked_x())
    print(point.marked_y())
    print(point.generated())
}
