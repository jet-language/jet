# is_match and full_match (answered by the DFA when the pattern has one)
# agree with the leftmost-first spans and group spans of the VM over a
# pattern corpus; the expected output comes from the VM-only engine.
fixture: dfa_existence_and_vm_spans_agree_over_a_pattern_corpus.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step default: jet run run.jet
exit: 0
stdout: = dfa_existence_and_vm_spans_agree_over_a_pattern_corpus.out
step: jet build run.jet
exit: 0
step aot: built
exit: == default
stdout: == default
stderr: == default
