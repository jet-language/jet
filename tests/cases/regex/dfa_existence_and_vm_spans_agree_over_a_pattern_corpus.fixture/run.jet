use re: core.regex

// One line per pattern and flag set: for every text, whether a match exists
// (the DFA's answer when it has one), whether the whole text matches, and the
// leftmost-first spans and group spans the VM reports. The expected output
// was produced by the VM-only engine.
show: fn(pattern: String, flags: RegexFlags, texts: [String]) {
    compiled: re.compile_with(pattern, flags) ?? {
        print("{pattern.debug()} [{flags}] invalid")
        return
    }
    cells := [String]{}
    loop text in texts {
        spans := [String]{}
        loop m in compiled.matches(text) {
            groups := [String]{}
            g := 1
            loop g <= m.groups.len() {
                &groups.push("{m.group_start(g) ?? -1}-{m.group_end(g) ?? -1}")
                g = g + 1
            }
            &spans.push("{m.start}:{m.end}({groups.join(" ")})")
        }
        exists: compiled.is_match(text)
        found: compiled.find(text) != None
        whole: compiled.full_match(text)
        &cells.push("{exists}/{exists == found}/{whole}/{spans.join(",")}")
    }
    print("{pattern.debug()} [{flags}] {cells.join(" | ")}")
}

run: fn() {
    texts: [String]{
        "", "a", "abc", "IMG_123.jpeg", "IMG_12.png", "xIMG_1.jpeg", "IMG_007.jpeg\n",
        "foo bar foo", "S: struct {{ T: struct }}", "line1\nline2\nfoo\n", "abab",
        "héllo wörld", "ÀB àb", "café IMG_9.jpeg", "\nfoo", "foofoo", "the cat sat", "ab\n",
        "192.0.2.1 - - [01/Jan/2026:00:00:00 +0000] \"GET /api/v1/resource/3 HTTP/1.1\" 503 1234",
        "192.0.2.1 - - [01/Jan/2026:00:00:00 +0000] \"GET /static/file/3 HTTP/1.1\" 503 1234",
        "kelvin K", "a1b22c333", "word_1 word-2", "aaaaaaaaaaaaaa", "abbbbbbbbbbbb",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaab",
    }
    plain: re.flags(false, false, false)
    icase: re.flags(true, false, false)
    multi: re.flags(false, true, false)
    dotall: re.flags(false, false, true)
    patterns: [String]{
        "^IMG_(\\d+)\\.jpeg$", "IMG_(\\d+)\\.jpeg", "struct", "foo", "^foo", "foo$", "^foo$", "",
        "a*", "a+", "(a|ab)(c|bcd)?", "a|ab", "[a-c]+", "[^a]+", "\\d+", "\\w+", "\\s+",
        "\\bfoo\\b", "(?:foo)+", "fo{{1,2}}", "x*y?z", ".", ".*", "^", "$", "\\A", "\\z", "(a)|(b)",
        "é", "\\p{{L}}+", "K", "(?<n>\\d)(\\d)?", "a.c", "line\\d$", "^line\\d",
        "^([0-9.]+) - - \\[[^]]+\\] \"GET /api/[^ ]+ HTTP/1\\.1\" 5[0-9][0-9] ",
        "(foo|foobar)baz", "c(a|o)t", "the|cat", "(ab)+$", "\\n",
        "(a|b)*a(a|b){{12}}", "(a|aa)*b", "(a*)*b",
    }
    loop pattern in patterns {
        show(pattern, plain, texts)
        show(pattern, icase, texts)
        show(pattern, multi, texts)
        show(pattern, dotall, texts)
    }
}
