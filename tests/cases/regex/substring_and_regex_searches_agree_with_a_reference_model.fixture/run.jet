// Each line of cases.txt is `kind<TAB>pattern<TAB>text`, generated with the
// expected output by a JavaScript model (Buffer.indexOf, RegExp with `u`).
// kind s: String contains/find/count/split with the pattern as the needle.
// kind r: core.regex is_match/full_match/find/find_all of the compiled pattern.
// Texts reach 1025 bytes with multibyte scalars, needles at both ends,
// overlapping and periodic needles, so the word-at-a-time substring filter,
// its bytewise tail and its fall back to the two-way search all run.
package {
    name: "run"
    authority: { allow: [IO, Mem.Alloc, FS.Read] }
}

use core.files as fs
use core.regex

fn run() {
    raw :: fs.read("cases.txt") ?? panic("read failed")
    loop line in raw.split("\n") {
        parts :: line.split("\t").to_list()
        if parts.len() < 3 -> next
        kind :: parts[0]
        p :: parts[1]
        text :: parts[2]
        if kind == "s" {
            print("s {text.contains(p)} {text.find(p)} {text.count(p)} {text.split(p).len()}")
        } else {
            r :: regex.compile(p) ?? panic("bad pattern {p}")
            first :: regex.find(r, text) ?? "<none>"
            all :: regex.find_all(r, text)
            print("r {regex.is_match(r, text)} {regex.full_match(r, text)} {first} {all.len()} {all.join("|")}")
        }
    }
}
