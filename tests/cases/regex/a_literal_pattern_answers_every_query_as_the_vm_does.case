# A pattern of literal scalars alone is matched where its bytes occur, with no
# VM; find, find_all, matches, replace, split, is_match and full_match answer
# as the leftmost-first VM does, and ignore-case keeps the VM.
fixture: a_literal_pattern_answers_every_query_as_the_vm_does.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step default: jet run run.jet
exit: 0
stdout: = a_literal_pattern_answers_every_query_as_the_vm_does.out
step: jet build run.jet
exit: 0
step aot: built
exit: == default
stdout: == default
stderr: == default
