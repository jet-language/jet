use re :: core.regex

// A pattern of literal scalars alone is matched where its bytes occur; each
// query below answers as the leftmost-first VM does, including repeats that
// touch, scalars above 127, an empty text and the flags that keep the VM.
fn run() {
    word :: Regex{"struct"}
    text :: "struct S {{ struct T }} structure; destruct"
    print(word.find_all(text))
    print(word.matches(text).map(m -> "{m.start}-{m.end}:{m.group(0) ?? "none"}"))
    print(word.find(text) ?? "none")
    print((word.match("a struct") ?? panic("no match")).start)
    print(word.replace(text, "X"))
    print(word.replace_first(text, "X"))
    print(word.split(text))
    print(word.split_limit(text, 2))
    print("{word.is_match(text)} {word.full_match("struct")} {word.full_match("structs")}")
    print(word.find_all(""))
    print(word.find("no match here") ?? "none")

    double :: Regex{"aa"}
    print(double.find_all("aaaaa"))
    print(double.matches("aaaaa").map(m -> m.start))
    print(double.replace("aaaaa", "b"))

    accent :: Regex{"é"}
    print(accent.find_all("café é ée"))
    print(accent.matches("café é").map(m -> "{m.start}-{m.end}"))
    print(accent.split("aébéc"))

    folded :: re.compile_with("STRUCT", re.flags(true, false, false)) ?? panic("bad pattern")
    print(folded.find_all(text))
    lines :: re.compile_with("struct", re.flags(false, true, false)) ?? panic("bad pattern")
    print(lines.find_all(text))
    escaped :: re.compile(re.escape("a.b")) ?? panic("bad pattern")
    print(escaped.find_all("a.b axb a.b"))

    // Texts of a kilobyte or more, where the search skips by the needle.
    long := ""
    loop k in 0..<200 -> long = "{long}st{k}struct sstruc structs "
    starts :: word.matches(long).map(m -> m.start)
    print("{starts.len()} {starts.fold(0, (sum, start) -> sum + start)} {word.replace(long, "").len()}")
    print(word.split(long).len())
    pairs := ""
    loop k in 0..<1000 -> pairs = "{pairs}ab"
    print(Regex{"abab"}.find_all(pairs).len())
    print(Regex{"bab"}.matches(pairs).map(m -> m.start).fold(0, (sum, start) -> sum + start))
    runs := ""
    loop k in 0..<300 -> runs = "{runs}aaaab"
    print(Regex{"aab"}.matches(runs).map(m -> m.start).fold(0, (sum, start) -> sum + start))
    accents := ""
    loop k in 0..<600 -> accents = "{accents}eé"
    print(Regex{"eé"}.find_all(accents).len())
    print(Regex{"éeé"}.matches(accents).map(m -> m.start).fold(0, (sum, start) -> sum + start))
}
