
use core.regex as re

fn run() {
    print(re.find({"\\d+"}, "id=42") ?? "none")
    print(re.find(pattern: {"[a-z]+"}, text: "123jet") ?? "none")
    digits :: Regex{"\d+"}
    print(digits.is_match("room 7"))
    runtime_pattern :: "\\w+"
    runtime :: re.compile(runtime_pattern) ?? panic("runtime pattern")
    print("runtime-result")
}
