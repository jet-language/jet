
use {
    compute: core.compute
    core.compute.[ComputeError]
    solve: core.compute.solve
}

run: fn() {
    scaled: compute.full([1, 1], 1e-20) ?? panic("scaled")
    rhs: compute.full([1], 2e-20) ?? panic("rhs")
    solution: solve.dense(scaled, rhs) ?? panic("scaled dense solve")
    print("dense:{compute.to_list(solution)}")
    factors: solve.lu(scaled) ?? panic("scaled LU")
    print("lu:{factors.pivots}")

    singular: compute.reshape(compute.from_list([1.0, 2.0, 2.0, 4.0]) ?? panic("singular"), [2, 2]) ?? panic("singular shape")
    if solve.lu(singular) == {
        .Ok(_) -> print("singular:accepted")
        .Err(error) -> {
            if error == ComputeError.Singular {
                print("singular:Singular")
            } else {
                print("singular:wrong-error")
            }
        }
    }

    wrong_rhs: compute.from_list([1.0, 2.0]) ?? panic("wrong_rhs")
    if solve.dense(scaled, wrong_rhs) == {
        .Ok(_) -> print("shape:accepted")
        .Err(error) -> {
            if error == ComputeError.Shape {
                print("shape:Shape")
            } else {
                print("shape:wrong-error")
            }
        }
    }

    // A CUDA tensor exists only through the checked placement path; a host
    // without the provider rejects the request itself.
    if compute.on_device(compute.full([1, 1], 1.0) ?? panic("cuda value"), compute.device_cuda()) == {
        .Ok(cuda) -> {
            if solve.lu(cuda) == {
                .Ok(_) -> print("device:accepted")
                .Err(error) -> {
                    if error == ComputeError.Unsupported {
                        print("device:Unsupported")
                    } else {
                        print("device:wrong-error")
                    }
                }
            }
        }
        .Err(error) -> {
            if error == ComputeError.Device {
                print("device:Unsupported")
            } else {
                print("device:wrong-error")
            }
        }
    }
}
