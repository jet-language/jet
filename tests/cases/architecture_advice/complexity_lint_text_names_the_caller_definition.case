# The advice resolves its consumer through the semantic index's dotted caller key
# (`ordering_policy.run` ends in `run`), so the caller's own definition is evidence.
fixture: fixtures
step: jet lint --complexity ordering_policy.jet
stdout: ~ "consumer-agreement `run` [same-module]" # the consumer is named by its definition
stdout: ~ "evidence: caller-definition ordering_policy.jet:" # the dotted caller key resolves to run's definition
