env: JETPACK_ROOT={work}/hangar-root
mkdir: hangar-root
mkdir: app/.jet/build
step: jet run main.jet
cwd: app
exit: nonzero
stderr: ~ "E0982" # original predicate
stderr: ~ "`deploy` is an executable package, so it can't be used with `use`" # original predicate
stderr: ~ "an `executable` package installs a binary on your PATH" # original predicate
stderr: ~ "change `deploy` to `library` in `package.jet`" # original predicate

