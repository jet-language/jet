// ORACLE-PORT reflect.rs:40-44. Numeric.rs:3100-3101: #[repr(transparent)] JetInt(u64).
// U64 layout equals Rust u64 layout independently of Ring/Int. Reviewer-approved target-correct oracle.
// `$layout.size` is `Int?` (D-LAYOUT-FACTS1: optional size); a scalar always has one.
SIZE: comptime { (U64.reflect().layout.size ?? panic("U64 has a fixed size")) * 1026 }
ALIGNMENT: comptime { U64.reflect().layout.alignment }
run: fn() { print("{SIZE}:{ALIGNMENT}") }
