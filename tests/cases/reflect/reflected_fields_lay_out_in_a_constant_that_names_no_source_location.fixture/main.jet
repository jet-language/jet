// Nothing here names SourceLocation, yet each FieldInfo and the TypeInfo
// carry a `location` of that type, so the constant's code lays it out.
Point: struct { x: Int, y: Int }
FIELDS: #run { Point.reflect().fields.len() }
NAMED: #run { Point.reflect().fields[1].name }
run: fn() {
    print(FIELDS)
    print(NAMED)
}
