
#Error
PatternError: enum { Bad }
Pattern: distinct String
impl Pattern.CheckedText {
    Error: PatternError
    check: fn(text: String) PatternError! -[]> {
        return
    }
    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return ""
    }
}
run: fn() {}

REFLECTION_APP: Output.Executable{ name: "reflection", entry: reflection_probe }
REFLECTION_BASE: #run Pattern.reflect().base
reflection_implements: fn() -> Bool {
    found := false
    loop implemented in Pattern.reflect().traits {
        if implemented.name == "CheckedText" -> found = true
    }
    return found
}
REFLECTION_IMPLEMENTS: #run reflection_implements()
reflection_contract: fn() -> [Bool] {
    found := false
    error_type := false
    check_method := false
    encode_method := false
    loop contract in Pattern.reflect().traits {
        if contract.name == "CheckedText" {
            found = true
            loop association in contract.associated_types {
                if association.name == "Error" && association.type.name == "PatternError" -> error_type = true
            }
            loop method in contract.methods {
                if method.name == "check" -> check_method = true
                if method.name == "encode_hole" -> encode_method = true
            }
            break
        }
    }
    return [found, error_type, check_method, encode_method]
}
REFLECTION_CONTRACT: #run reflection_contract()
reflection_probe: fn() {
    
    // Original tests/reflect.rs:126-129 base String.
    print(REFLECTION_BASE)
    
    // Original tests/reflect.rs:130-134 the traits list contains CheckedText.
    print(REFLECTION_IMPLEMENTS)
    
    // Original tests/reflect.rs:135-141 first matching CheckedText contract exists.
    print(REFLECTION_CONTRACT[0])
    
    // Original tests/reflect.rs:145-150 associated Error is PatternError.
    print(REFLECTION_CONTRACT[1])
    
    // Original tests/reflect.rs:154-156 check method exists.
    print(REFLECTION_CONTRACT[2])
    
    // Original tests/reflect.rs:157-159 encode_hole method exists.
    print(REFLECTION_CONTRACT[3])
}
