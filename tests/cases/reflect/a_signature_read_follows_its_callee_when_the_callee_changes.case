# Code that reads a callee's signature depends on that signature. run.jet
# reads the signature of `connect`, declared in net.jet, in a constant the
# check folds and again at run time. The callee then gains a label-only
# parameter, a new return type and an effect row, and nothing else changes.
# The next check of the unchanged run.jet sees the new signature in both
# reads, under the same store, and the call follows it too.
fixture: a_signature_read_follows_its_callee_when_the_callee_changes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run .
exit: 0
stdout: = "folded: connect(host: String) -> String, no written row\nread: connect(host: String) -> String, no written row\ncalled: db\n"
write: net.jet a_signature_read_follows_its_callee_when_the_callee_changes.after/net.jet
step: jet check .
exit: 0
step: jet run .
exit: 0
stdout: = "folded: connect(host: String, timeout: Int) -> Int, IO\nread: connect(host: String, timeout: Int) -> Int, IO\ncalled: 32\n"
