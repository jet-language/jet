package: {
    name: "wayland_windows_compose_text_through_the_input_method"
    authority: { allow: [Env, IO, Net, Time] }
}
use {
    net: core.net
    sys: core.sys
    ui: core.ui
}

// A fake Wayland compositor on $WAYLAND_DISPLAY with an input method
// (zwp_text_input_v3) serves a `ui.open` window. With the keyboard focus
// the input method's focus comes too, and the window takes a text field:
// the text input is enabled with its content type and caret rectangle.
// The input method composes "にほ" with its caret at the end, then
// "にほん" with a hidden caret, then commits "日本" and starts "ご" with
// its caret at the start. The window gets each composition, the end of
// one before its committed text, and then leaves the text field, which
// disables the text input and ends the composition.

Fake: struct {
    stream: net.UnixStream
    inbox: [U8]
    out: [U8]
    registry: Int
    compositor: Int
    shm: Int
    wm_base: Int
    seat: Int
    keyboard: Int
    text_manager: Int
    text_input: Int
    surface: Int
    xdg_surface: Int
    toplevel: Int
    // Received descriptors, newest first; pools keep theirs.
    fds: [sys.Fd]
    pool_fds: [sys.Fd]
    attached: Int
    current: Int
    callbacks: [Int]
    serial: Int
    configured: Bool
    // The text input's state as the window last set it, and the commits
    // it made.
    enabled: Bool
    content: String
    caret: String
    text_commits: Int
    // 0 before the focus, 1 until the text input is enabled, 2 and 3
    // composing, 4 until the text field is left, 5 until the close, 6
    // closed.
    phase: Int
    commits: Int
    due_commit: Int
    closed: Bool
    records: [String]
    failures: [String]
}

GLOBALS: [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wl_seat", "zwp_text_input_manager_v3"}

fake_put: fn(&out: [U8], value: Int) {
    v: value.bit_and(4294967295)
    out.push(U8{v.bit_and(255)})
    out.push(U8{(v >> 8).bit_and(255)})
    out.push(U8{(v >> 16).bit_and(255)})
    out.push(U8{(v >> 24).bit_and(255)})
}

fake_words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values -> fake_put(out, value)
    out
}

fake_u32: fn(bytes: [U8], at: Int) -> Int {
    if at + 4 > bytes.len() -> return 0
    Int{bytes[at]} + (Int{bytes[at + 1]} << 8) + (Int{bytes[at + 2]} << 16) + (Int{bytes[at + 3]} << 24)
}

fake_text: fn(text: String) -> [U8] {
    out := [U8]{}
    bytes: text.bytes()
    fake_put(out, bytes.len() + 1)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
    loop out.len() %% 4 != 0 -> out.push(U8{0})
    out
}

fake_string: fn(bytes: [U8], at: Int) -> String {
    length: fake_u32(bytes, at)
    if length <= 1 || at + 4 + length > bytes.len() -> return ""
    String.from_bytes(bytes[(at + 4)..<(at + 3 + length)]) ?? ""
}

fake_event: fn(&f: Fake, object: Int, opcode: Int, args: [U8]) {
    fake_put(f.out, object)
    fake_put(f.out, ((args.len() + 8) << 16) + opcode)
    loop b in args -> f.out.push(b)
}

fake_flush: fn(&f: Fake) -[Net, Time]> {
    if f.out.len() == 0 -> return
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{}) ?? {
        if !f.closed -> f.failures.push("send failed: {err}")
        return
    }
}

fake_fail: fn(&f: Fake, message: String) {
    if f.failures.len() < 8 -> f.failures.push("phase {f.phase}: {message}")
}

// zwp_text_input_v3.preedit_string(text, cursor_begin, cursor_end); an
// empty text goes as the null string.
fake_preedit: fn(&f: Fake, text: String, begin: Int, end: Int) {
    args := if text == "" -> fake_words([Int]{0}) else -> fake_text(text)
    loop b in fake_words([Int]{begin, end}) -> args.push(b)
    text_input: f.text_input
    fake_event(f, text_input, 2, args)
}

// zwp_text_input_v3.done, with the commits the input method has seen.
fake_done: fn(&f: Fake) {
    text_input: f.text_input
    fake_event(f, text_input, 5, fake_words([Int]{f.text_commits}))
}

fake_commit: fn(&f: Fake) -[Env, Net, Time]> {
    f.commits += 1
    if f.attached != 0 {
        previous: f.current
        f.current = f.attached
        f.attached = 0
        if previous != 0 && previous != f.current -> fake_event(f, previous, 0, [U8]{})
    }
    callbacks: f.callbacks.copy()
    f.callbacks = [Int]{}
    loop id in callbacks -> fake_event(f, id, 0, fake_words([Int]{f.commits}))
    if f.current == 0 || f.commits < f.due_commit -> return
    if f.phase == 0 {
        // The keyboard focus, and the input method's with it.
        f.serial += 1
        surface: f.surface
        keyboard: f.keyboard
        text_input: f.text_input
        fake_event(f, keyboard, 1, fake_words([Int]{f.serial, surface, 0}))
        fake_event(f, text_input, 0, fake_words([Int]{surface}))
        f.phase = 1
        return
    }
    if f.phase == 2 {
        fake_preedit(f, "にほん", -1, -1)
        fake_done(f)
        f.phase = 3
        f.due_commit = f.commits + 2
        return
    }
    if f.phase == 3 {
        text_input: f.text_input
        fake_event(f, text_input, 3, fake_text("日本"))
        fake_preedit(f, "ご", 0, 3)
        fake_done(f)
        f.phase = 4
        return
    }
    if f.phase == 5 {
        toplevel: f.toplevel
        f.closed = true
        fake_event(f, toplevel, 1, [U8]{})
        f.phase = 6
    }
}

// The window's text input requests: enable 1, disable 2,
// set_content_type 5, set_cursor_rectangle 6 and commit 7, which
// applies them.
fake_text_input: fn(&f: Fake, opcode: Int, body: [U8]) {
    if opcode == 1 -> f.enabled = true
    if opcode == 2 -> f.enabled = false
    if opcode == 5 -> f.content = "{fake_u32(body, 0)} {fake_u32(body, 4)}"
    if opcode == 6 -> f.caret = "{fake_u32(body, 0)},{fake_u32(body, 4)} {fake_u32(body, 8)}x{fake_u32(body, 12)}"
    if opcode != 7 -> return
    f.text_commits += 1
    if f.phase == 1 {
        if !f.enabled -> fake_fail(f, "commit without enable")
        f.records.push("enabled with content type {f.content} and caret {f.caret}")
        fake_preedit(f, "にほ", 6, 6)
        fake_done(f)
        f.phase = 2
        f.due_commit = f.commits + 2
        return
    }
    if f.phase == 4 {
        if f.enabled -> fake_fail(f, "the text field was left without disable")
        f.records.push("disabled after {f.text_commits} commits")
        f.phase = 5
        f.due_commit = f.commits + 2
        return
    }
    fake_fail(f, "an unexpected text input commit")
}

fake_request: fn(&f: Fake, object: Int, opcode: Int, body: [U8]) -[Env, Net, Time]> {
    if object == 1 && opcode == 1 {
        f.registry = fake_u32(body, 0)
        registry: f.registry
        loop (index, interface) in GLOBALS {
            args := fake_words([Int]{index + 1})
            loop b in fake_text(interface) -> args.push(b)
            version: if interface == "wl_compositor" -> 6 else if interface == "wl_seat" -> 5 else if interface == "xdg_wm_base" -> 2 else -> 1
            fake_put(args, version)
            fake_event(f, registry, 0, args)
        }
        return
    }
    if object == 1 && opcode == 0 {
        fake_event(f, fake_u32(body, 0), 0, fake_words([Int]{0}))
        return
    }
    if object == f.registry && opcode == 0 {
        name: fake_u32(body, 0)
        interface: fake_string(body, 4)
        length: fake_u32(body, 4)
        id: fake_u32(body, 8 + ((length + 3) /% 4) * 4 + 4)
        if name < 1 || name > GLOBALS.len() || GLOBALS[name - 1] != interface -> fake_fail(f, "bound global {name} as {interface}")
        if interface == "wl_compositor" -> f.compositor = id
        if interface == "wl_shm" {
            f.shm = id
            fake_event(f, id, 0, fake_words([Int]{1}))
        }
        if interface == "xdg_wm_base" -> f.wm_base = id
        if interface == "wl_seat" {
            f.seat = id
            // capabilities: a keyboard.
            fake_event(f, id, 0, fake_words([Int]{2}))
        }
        if interface == "zwp_text_input_manager_v3" -> f.text_manager = id
        return
    }
    if object == f.compositor && opcode == 0 {
        f.surface = fake_u32(body, 0)
        return
    }
    if object == f.shm && opcode == 0 {
        fd: f.fds.pop() ?? {
            fake_fail(f, "create_pool without a descriptor")
            return
        }
        f.pool_fds.push(fd)
        return
    }
    if object == f.wm_base && opcode == 2 {
        f.xdg_surface = fake_u32(body, 0)
        return
    }
    if object == f.xdg_surface && opcode == 1 {
        f.toplevel = fake_u32(body, 0)
        return
    }
    if object == f.seat && opcode == 1 {
        f.keyboard = fake_u32(body, 0)
        return
    }
    if object == f.text_manager && opcode == 1 {
        // get_text_input(id, seat).
        f.text_input = fake_u32(body, 0)
        if fake_u32(body, 4) != f.seat -> fake_fail(f, "a text input for object {fake_u32(body, 4)}, not the seat")
        f.records.push("text input for the seat")
        return
    }
    if object == f.text_input && f.text_input != 0 {
        fake_text_input(f, opcode, body)
        return
    }
    if object == f.surface {
        if opcode == 1 -> f.attached = fake_u32(body, 0)
        if opcode == 3 -> f.callbacks.push(fake_u32(body, 0))
        if opcode == 6 {
            if !f.configured {
                // The initial commit: the first configure, activated.
                f.configured = true
                f.serial += 1
                toplevel: f.toplevel
                xdg_surface: f.xdg_surface
                fake_event(f, toplevel, 0, fake_words([Int]{200, 100, 4, 4}))
                fake_event(f, xdg_surface, 0, fake_words([Int]{f.serial}))
                return
            }
            fake_commit(f)
        }
    }
}

fake_dispatch: fn(&f: Fake) -[Env, Net, Time]> {
    at := 0
    loop f.inbox.len() - at >= 8 {
        object: fake_u32(f.inbox, at)
        word: fake_u32(f.inbox, at + 4)
        size: word >> 16
        if size < 8 {
            fake_fail(f, "malformed request header")
            f.inbox = [U8]{}
            return
        }
        if f.inbox.len() - at < size -> break
        body: f.inbox[(at + 8)..<(at + size)].copy()
        fake_request(f, object, word.bit_and(65535), body)
        at += size
    }
    if at > 0 -> f.inbox = f.inbox[at..<f.inbox.len()].copy()
}

// Accepts one window and serves it until it disconnects.
fake_serve: fn(listener: net.UnixListener) -[Env, Net, Time, IO]> Fake {
    stream: net.unix_accept(listener) ?? panic("accept: {err}")
    f := Fake{
        stream: stream, inbox: [U8]{}, out: [U8]{}, registry: 0, compositor: 0, shm: 0, wm_base: 0,
        seat: 0, keyboard: 0, text_manager: 0, text_input: 0, surface: 0, xdg_surface: 0, toplevel: 0,
        fds: [sys.Fd]{}, pool_fds: [sys.Fd]{}, attached: 0, current: 0, callbacks: [Int]{}, serial: 0,
        configured: false, enabled: false, content: "", caret: "", text_commits: 0,
        phase: 0, commits: 0, due_commit: 0, closed: false, records: [String]{}, failures: [String]{},
    }
    idle := 0
    loop idle < 40 {
        ready: net.unix_wait(f.stream, 50000000) ?? {
            f.failures.push("wait failed: {err}")
            return f
        }
        if !ready {
            idle += 1
            next
        }
        idle = 0
        message: net.unix_receive(f.stream, 65536) ?? {
            if !f.closed -> f.failures.push("receive failed: {err}")
            return f
        }
        if message.bytes.len() == 0 -> return f
        loop fd in message.fds.move() { f.fds.insert(0, fd) }
        loop b in message.bytes -> f.inbox.push(b)
        fake_dispatch(f)
        fake_flush(f)
    }
    f.failures.push("the window went quiet")
    f
}

// With the focus the window takes a text field; once the input method
// commits, it leaves the field.
client: fn() -[Env, IO, Net, Time]> {
    window: ui.open(width: 200, height: 100, title: "compose") ?? {
        print("open failed: {err}")
        return
    }
    loop frame in window.frames() {
        closed := false
        loop event in frame.events() {
            if event == .Close -> closed = true
            if event == .Focus(focused) {
                print("focus {focused}")
                window.set_text_input(Val(ui.UIRect{x: 5, y: 10, width: 1, height: 8})) ?? {
                    print("text field failed: {err}")
                    return
                }
            }
            if event == .Compose(composition) {
                marked: if composition.marked == .Val(span) -> "{span.start}-{span.end}" else -> "none"
                print("compose '{composition.text}' caret {composition.selection.start}-{composition.selection.end} marked {marked}")
            }
            if event == .Text(text) {
                print("text {text}")
                window.set_text_input(None) ?? {
                    print("leaving the text field failed: {err}")
                    return
                }
            }
        }
        if closed -> break
        pixels := [U8]{}
        count := frame.width * frame.height * 4
        loop count > 0 {
            pixels.push(U8{255})
            count -= 1
        }
        frame.present(pixels) ?? {
            print("present failed: {err}")
            return
        }
    }
    if window.failure() == .Val(failure) -> print("failed: {failure}")
    print("closed")
}

// A headless window has no input method: taking a text field does
// nothing.
offline: fn() -[Env, IO, Net, Time]> {
    window: ui.headless(width: 1, height: 1, script: [[ui.UIEvent]]{}) ?? {
        print("headless failed: {err}")
        return
    }
    window.set_text_input(Val(ui.UIRect{x: 0, y: 0, width: 1, height: 1})) ?? {
        print("headless text field failed: {err}")
        return
    }
    window.set_text_input(None) ?? {
        print("headless text field failed: {err}")
        return
    }
    print("headless text field kept")
}

run: fn() {
    offline()
    path: sys.get("WAYLAND_DISPLAY") ?? ""
    if !path.starts_with("/") {
        print("WAYLAND_DISPLAY must be an absolute socket path")
        return
    }
    listener: net.unix_listen(path) ?? {
        print("listen failed: {err}")
        return
    }
    server: task { fake_serve(listener) }
    client()
    f: server.join() ?? panic("compositor task failed")
    if f.phase != 6 -> print("FAIL the compositor stopped in phase {f.phase}")
    loop record in f.records -> print(record)
    loop failure in f.failures -> print("FAIL {failure}")
}
