# #6701: Jet's own window frame answers the keyboard. A fake
# compositor on $WAYLAND_DISPLAY sends keys on the US table, then
# through an XKB keymap: F6 rings a frame button, Tab and Shift+Tab
# step across them, Enter works the focused one, Shift+F10 and
# Alt+Space open the window menu, and Escape or leaving the window
# hands the keys back. Keys the frame takes never reach the program.
requires: os:linux
fixture: wayland_frames_answer_the_keyboard.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
env: DBUS_SESSION_BUS_ADDRESS=unix:path={work}/no-bus
step run: jet run main.jet
exit: 0
stdout: = "us table: focus true\nus table: down Char(a)\nus table: text a\nus table: up Char(a)\nus table: down Char(b)\nus table: text b\nus table: up Char(b)\nus table: down Alt\nus table: up Alt\nus table: focus false\nus table: closed\n  chrome at -64,-98, ringed []\n  maximize\n  chrome at 0,-34, ringed [maximize]\n  window menu at 327,0, serial 205\n  chrome at 0,-34, ringed [minimize]\n  window menu at 10,0, serial 307\n  chrome at 0,-34, ringed []\n  chrome at 0,-34, ringed [minimize]\n  minimize\n  chrome at 0,-34, ringed []\nkeymap: focus true\nkeymap: down Char(a)\nkeymap: text a\nkeymap: up Char(a)\nkeymap: down Char(b)\nkeymap: text b\nkeymap: up Char(b)\nkeymap: down Alt\nkeymap: up Alt\nkeymap: focus false\nkeymap: closed\n  chrome at -64,-98, ringed []\n  maximize\n  chrome at 0,-34, ringed [maximize]\n  window menu at 327,0, serial 205\n  chrome at 0,-34, ringed [minimize]\n  window menu at 10,0, serial 307\n  chrome at 0,-34, ringed []\n  chrome at 0,-34, ringed [minimize]\n  minimize\n  chrome at 0,-34, ringed []\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "us table: focus true\nus table: down Char(a)\nus table: text a\nus table: up Char(a)\nus table: down Char(b)\nus table: text b\nus table: up Char(b)\nus table: down Alt\nus table: up Alt\nus table: focus false\nus table: closed\n  chrome at -64,-98, ringed []\n  maximize\n  chrome at 0,-34, ringed [maximize]\n  window menu at 327,0, serial 205\n  chrome at 0,-34, ringed [minimize]\n  window menu at 10,0, serial 307\n  chrome at 0,-34, ringed []\n  chrome at 0,-34, ringed [minimize]\n  minimize\n  chrome at 0,-34, ringed []\nkeymap: focus true\nkeymap: down Char(a)\nkeymap: text a\nkeymap: up Char(a)\nkeymap: down Char(b)\nkeymap: text b\nkeymap: up Char(b)\nkeymap: down Alt\nkeymap: up Alt\nkeymap: focus false\nkeymap: closed\n  chrome at -64,-98, ringed []\n  maximize\n  chrome at 0,-34, ringed [maximize]\n  window menu at 327,0, serial 205\n  chrome at 0,-34, ringed [minimize]\n  window menu at 10,0, serial 307\n  chrome at 0,-34, ringed []\n  chrome at 0,-34, ringed [minimize]\n  minimize\n  chrome at 0,-34, ringed []\n"
stderr: empty
