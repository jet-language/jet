# #6701: `ui.open` windows against a fake compositor on $WAYLAND_DISPLAY.
# Fractional scale with a viewport, preferred_buffer_scale and an output's
# scale each size the buffer as the acked logical size times the scale; an
# interactive resize from each of the eight edges never commits a size it
# has not acked; the cursor is set at each pointer enter's serial; the
# app_id and a premultiplied icon reach the toplevel while a malformed
# app_id or icon is refused; a protocol error and a truncated event are
# typed Protocol errors.
requires: os:linux
fixture: wayland_windows_follow_configures_scales_cursors_and_icons.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step run: jet run main.jet
exit: 0
stdout: = "empty app_id: Invalid(an app_id is not empty)\nshort icon: Size(a 16x16 icon image needs 1024 bytes of RGBA, got 900)\nhuge icon: Size(an icon image is 1 to 1024 pixels across, not 1025)\nfractional: closed at 500x300 pixels, scale 1.0, cursor Hidden, resized yes\n  frame scales [1.5, 2.0, 1.25, 1.0]\n  app_id dev.jet.app\n  app_id dev.jet.fakewl\n  icon jet with sides [16, 32], first pixels [[100, 40, 20, 128], [100, 40, 20, 128]]\n  300x200 at 180/120: 450x300 pixels\n  cursor shape 9 at enter 1\n  cursor hidden at enter 1\n  cursor hidden at enter 2\n  640x480 at 180/120: 960x720 pixels\n  200x150 at 180/120: 300x225 pixels\n  200x150 at 240/120: 400x300 pixels\n  333x222 at 240/120: 666x444 pixels\n  333x222 at 150/120: 416x278 pixels\n  1x1 at 150/120: 1x1 pixels\n  500x300 at 120/120: 500x300 pixels\npreferred: closed at 120x90 pixels, scale 1.0, cursor Text, resized yes\n  frame scales [2.0, 3.0, 1.0]\n  300x200 at 240/120: 600x400 pixels\n  400x300 at 240/120: 800x600 pixels\n  400x300 at 360/120: 1200x900 pixels\n  120x90 at 360/120: 360x270 pixels\n  120x90 at 120/120: 120x90 pixels\noutputs: closed at 120x90 pixels, scale 1.0, cursor Text, resized yes\n  frame scales [1.0, 2.0, 3.0, 1.0]\n  300x200 at 240/120: 600x400 pixels\n  400x300 at 240/120: 800x600 pixels\n  400x300 at 360/120: 1200x900 pixels\n  120x90 at 360/120: 360x270 pixels\n  120x90 at 120/120: 120x90 pixels\nresize: closed at 452x299 pixels, scale 1.5, cursor Text, resized yes\n  frame scales [1.5]\n  300x200 at 180/120: 450x300 pixels\n  top edge, 7 configures: 300x263 at 180/120: 450x395 pixels\n  top-right edge, 7 configures: 361x301 at 180/120: 542x452 pixels\n  right edge, 7 configures: 427x301 at 180/120: 641x452 pixels\n  bottom-right edge, 7 configures: 465x343 at 180/120: 698x515 pixels\n  bottom edge, 7 configures: 465x281 at 180/120: 698x422 pixels\n  bottom-left edge, 7 configures: 397x219 at 180/120: 596x329 pixels\n  left edge, 7 configures: 331x219 at 180/120: 497x329 pixels\n  top-left edge, 7 configures: 301x199 at 180/120: 452x299 pixels\ndisplay error: open failed: Protocol(protocol error on object 2, code 3: no globals for you)\nshort event: open failed: Protocol(event 0 on object 11 is too short)\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "empty app_id: Invalid(an app_id is not empty)\nshort icon: Size(a 16x16 icon image needs 1024 bytes of RGBA, got 900)\nhuge icon: Size(an icon image is 1 to 1024 pixels across, not 1025)\nfractional: closed at 500x300 pixels, scale 1.0, cursor Hidden, resized yes\n  frame scales [1.5, 2.0, 1.25, 1.0]\n  app_id dev.jet.app\n  app_id dev.jet.fakewl\n  icon jet with sides [16, 32], first pixels [[100, 40, 20, 128], [100, 40, 20, 128]]\n  300x200 at 180/120: 450x300 pixels\n  cursor shape 9 at enter 1\n  cursor hidden at enter 1\n  cursor hidden at enter 2\n  640x480 at 180/120: 960x720 pixels\n  200x150 at 180/120: 300x225 pixels\n  200x150 at 240/120: 400x300 pixels\n  333x222 at 240/120: 666x444 pixels\n  333x222 at 150/120: 416x278 pixels\n  1x1 at 150/120: 1x1 pixels\n  500x300 at 120/120: 500x300 pixels\npreferred: closed at 120x90 pixels, scale 1.0, cursor Text, resized yes\n  frame scales [2.0, 3.0, 1.0]\n  300x200 at 240/120: 600x400 pixels\n  400x300 at 240/120: 800x600 pixels\n  400x300 at 360/120: 1200x900 pixels\n  120x90 at 360/120: 360x270 pixels\n  120x90 at 120/120: 120x90 pixels\noutputs: closed at 120x90 pixels, scale 1.0, cursor Text, resized yes\n  frame scales [1.0, 2.0, 3.0, 1.0]\n  300x200 at 240/120: 600x400 pixels\n  400x300 at 240/120: 800x600 pixels\n  400x300 at 360/120: 1200x900 pixels\n  120x90 at 360/120: 360x270 pixels\n  120x90 at 120/120: 120x90 pixels\nresize: closed at 452x299 pixels, scale 1.5, cursor Text, resized yes\n  frame scales [1.5]\n  300x200 at 180/120: 450x300 pixels\n  top edge, 7 configures: 300x263 at 180/120: 450x395 pixels\n  top-right edge, 7 configures: 361x301 at 180/120: 542x452 pixels\n  right edge, 7 configures: 427x301 at 180/120: 641x452 pixels\n  bottom-right edge, 7 configures: 465x343 at 180/120: 698x515 pixels\n  bottom edge, 7 configures: 465x281 at 180/120: 698x422 pixels\n  bottom-left edge, 7 configures: 397x219 at 180/120: 596x329 pixels\n  left edge, 7 configures: 331x219 at 180/120: 497x