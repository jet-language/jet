package: {
    name: "wayland_windows_follow_configures_scales_cursors_and_icons"
    authority: { allow: [Env, IO, Net, Time] }
}
use {
    net: core.net
    sys: core.sys
    ui: core.ui
}

// A fake Wayland compositor on $WAYLAND_DISPLAY drives `ui.open` windows
// through configure and scale sequences and checks every commit: the buffer
// is the acked logical size times the announced scale, the viewport or
// buffer scale maps it back, and an ack never rides with a buffer of
// another size. An interactive resize from each of the eight edges sends
// configures faster than the window draws: every commit after the first
// ack shows exactly the acked size, so the window never jumps. With a
// seat, the pointer enters twice and the window must set its cursor at
// each enter's serial. The window names its app_id and sets an icon; a
// malformed app_id or icon is refused before it reaches the display. Then
// two hostile compositors: a protocol error and a truncated event both
// surface as `UIError.Protocol`.

FakeMode: enum {
    // wp_fractional_scale_v1 + wp_viewporter.
    Fractional
    // wl_surface.preferred_buffer_scale (wl_compositor v6).
    Preferred
    // wl_output.scale of the entered outputs (wl_compositor v4).
    Outputs
    // Interactive resizes from each of the eight edges at 180/120: bursts
    // of configures in the resizing state, overlapping the window's frames.
    Resize
    // A wl_display.error answers the registry.
    DisplayError
    // A one-word xdg_toplevel.configure.
    ShortEvent
}

// One step: a configure of `width` x `height` logical units (0 x 0 leaves
// the size to the window) when `configure`, at `scale120` / 120. A step
// with an `edge` gets there by an interactive resize from that edge.
FakeStep: struct {
    configure: Bool
    width: Int
    height: Int
    scale120: Int
    edge: String
}

// A size the compositor configures, in the resizing state or not.
FakeSize: struct {
    width: Int
    height: Int
    resizing: Bool
}

// A configure sent and not yet acked.
FakeConfigure: struct {
    serial: Int
    width: Int
    height: Int
}

// A wl_buffer: its pool (an index into `pools`), offset, size and format.
FakeBuffer: struct {
    id: Int
    pool: Int
    offset: Int
    width: Int
    height: Int
    format: Int
}

Fake: struct {
    stream: net.UnixStream
    mode: FakeMode
    inbox: [U8]
    out: [U8]
    globals: [String]
    registry: Int
    compositor: Int
    shm: Int
    wm_base: Int
    fractional_manager: Int
    viewporter: Int
    output: Int
    surface: Int
    xdg_surface: Int
    toplevel: Int
    fractional: Int
    viewport: Int
    // The seat's pointer and its cursor-shape device; enters so far and the
    // latest enter's serial.
    seat: Int
    pointer: Int
    cursor_manager: Int
    cursor_device: Int
    // The icon manager, the icon being built and its name, buffer sides
    // and each buffer's first pixel as stored.
    icon_manager: Int
    icon: Int
    icon_name: String
    icon_sides: [Int]
    icon_first: [String]
    enters: Int
    enter_serial: Int
    // Every pool, and the descriptors the window sent, one per pool in
    // order: only wl_shm.create_pool carries one.
    pools: [Int]
    fds: [sys.Fd]
    buffers: [FakeBuffer]
    // Surface state: pending, then current at commit.
    attached: Int
    current: Int
    acked: Int
    callbacks: [Int]
    destination_w: Int
    destination_h: Int
    buffer_scale: Int
    entered: Bool
    // Script state.
    steps: [FakeStep]
    step: Int
    serial: Int
    // Configures sent and not yet acked, oldest first, and the sizes the
    // current interactive resize has yet to configure.
    configures: [FakeConfigure]
    drag: [FakeSize]
    drag_configures: Int
    logical_w: Int
    logical_h: Int
    scale120: Int
    reached: Bool
    // A configure was sent and no commit has acked it or a newer one yet.
    pending_ack: Bool
    // Some commit has acked a configure.
    acked_any: Bool
    settled: Int
    closing: Bool
    // The window set the cursor again after the second enter.
    cursor_done: Bool
    commits: Int
    report: [String]
    failures: [String]
}

fake_put: fn(&out: [U8], value: Int) {
    v: value.bit_and(4294967295)
    out.push(U8{v.bit_and(255)})
    out.push(U8{(v >> 8).bit_and(255)})
    out.push(U8{(v >> 16).bit_and(255)})
    out.push(U8{(v >> 24).bit_and(255)})
}

fake_words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values -> fake_put(out, value)
    out
}

fake_text: fn(text: String) -> [U8] {
    out := [U8]{}
    bytes: text.bytes()
    fake_put(out, bytes.len() + 1)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
    loop out.len() %% 4 != 0 -> out.push(U8{0})
    out
}

fake_u32: fn(bytes: [U8], at: Int) -> Int {
    if at + 4 > bytes.len() -> return 0
    Int.from_u8(bytes[at]) + (Int.from_u8(bytes[at + 1]) << 8) + (Int.from_u8(bytes[at + 2]) << 16) + (Int.from_u8(bytes[at + 3]) << 24)
}

fake_string: fn(bytes: [U8], at: Int) -> String {
    length: fake_u32(bytes, at)
    if length <= 1 || at + 4 + length > bytes.len() -> return ""
    String.from_bytes(bytes[(at + 4)..<(at + 3 + length)]) ?? ""
}

fake_event: fn(&f: Fake, object: Int, opcode: Int, args: [U8]) {
    fake_put(f.out, object)
    fake_put(f.out, ((args.len() + 8) << 16) + opcode)
    loop b in args -> f.out.push(b)
}

fake_flush: fn(&f: Fake) -[Net, Time]> {
    if f.out.len() == 0 -> return
    net.unix_send(f.stream, f.out, [sys.Fd]{}) ?? {
        f.failures.push("send failed: {err}")
        return
    }
    f.out.clear()
}

fake_fail: fn(&f: Fake, message: String) {
    if f.failures.len() < 8 -> f.failures.push("step {f.step}: {message}")
}

// Pixels for `logical` units at `scale120`: rounded half away from zero.
fake_pixels: fn(logical: Int, scale120: Int) -> Int {
    p: (logical * scale120 + 60) /% 120
    if p < 1 -> 1 else -> p
}

fake_globals: fn(mode: FakeMode) -> [String] {
    if mode == .Fractional -> return [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wp_fractional_scale_manager_v1", "wp_viewporter", "wl_output", "wl_seat", "wp_cursor_shape_manager_v1", "xdg_toplevel_icon_manager_v1"}
    if mode == .Resize -> return [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wp_fractional_scale_manager_v1", "wp_viewporter", "wl_output"}
    [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wl_output"}
}

// The mode scales with wp_fractional_scale_v1 and wp_viewporter.
fake_fractional: fn(mode: FakeMode) -> Bool { mode == .Fractional || mode == .Resize }

fake_version: fn(mode: FakeMode, interface: String) -> Int {
    if interface == "wl_compositor" -> return if mode == .Outputs -> 4 else -> 6
    if interface == "wl_output" -> return 2
    1
}

// Announces `scale120` the way the mode does.
fake_announce: fn(&f: Fake, scale120: Int) {
    f.scale120 = scale120
    if fake_fractional(f.mode) && f.fractional != 0 {
        id: f.fractional
        fake_event(f, id, 0, fake_words([Int]{scale120}))
    }
    if f.mode == .Preferred && f.surface != 0 {
        id: f.surface
        fake_event(f, id, 2, fake_words([Int]{scale120 /% 120}))
    }
    if f.mode == .Outputs && f.output != 0 {
        id: f.output
        fake_event(f, id, 3, fake_words([Int]{scale120 /% 120}))
        fake_event(f, id, 2, [U8]{})
    }
}

// A configure of `width` x `height`, in the resizing state if `resizing`.
fake_configure: fn(&f: Fake, width: Int, height: Int, resizing: Bool) {
    f.serial += 1
    f.pending_ack = true
    serial: f.serial
    f.configures.push(FakeConfigure{serial: serial, width: width, height: height})
    toplevel: f.toplevel
    xdg_surface: f.xdg_surface
    args := fake_words([Int]{width, height})
    // states: [resizing (3)] or none.
    if resizing {
        fake_put(args, 4)
        fake_put(args, 3)
    } else {
        fake_put(args, 0)
    }
    fake_event(f, toplevel, 0, args)
    fake_event(f, xdg_surface, 0, fake_words([Int]{serial}))
}

// Starts step `f.step`: its scale, then its configure, or the first of the
// interactive resize's configures: six sizes on the way, then the last.
fake_begin: fn(&f: Fake) {
    step: f.steps[f.step].copy()
    f.reached = false
    f.settled = 0
    if step.scale120 != f.scale120 -> fake_announce(f, step.scale120)
    if step.edge != "" {
        from_w: f.logical_w
        from_h: f.logical_h
        f.drag = [FakeSize]{}
        f.drag_configures = 0
        loop k in 1..<7 {
            f.drag.push(FakeSize{width: from_w + (step.width - from_w) * k /% 6, height: from_h + (step.height - from_h) * k /% 6, resizing: true})
        }
        f.drag.push(FakeSize{width: step.width, height: step.height, resizing: false})
        fake_drag(f, 1)
        return
    }
    if step.configure -> fake_configure(f, step.width, step.height, false)
}

// Configures the next `count` sizes of the interactive resize.
fake_drag: fn(&f: Fake, count: Int) {
    sent := 0
    loop sent < count && f.drag.len() > 0 {
        size: f.drag[0].copy()
        f.drag = f.drag[1..<f.drag.len()].copy()
        fake_configure(f, size.width, size.height, size.resizing)
        f.drag_configures += 1
        sent += 1
    }
}

fake_buffer: fn(f: Fake, id: Int) -> FakeBuffer? {
    loop buffer in f.buffers {
        if buffer.id == id -> return Val(buffer.copy())
    }
    None
}

// The state applied at a commit: an ack takes the configure's size.
fake_commit: fn(&f: Fake) {
    f.commits += 1
    acked: f.acked
    f.acked = -1
    if f.attached != 0 {
        previous: f.current
        f.current = f.attached
        f.attached = 0
        if previous != 0 && previous != f.current -> fake_event(f, previous, 0, [U8]{})
    }
    callbacks: f.callbacks.copy()
    f.callbacks = [Int]{}
    loop id in callbacks -> fake_event(f, id, 0, fake_words([Int]{f.commits}))
    // An output's scale reaches a window only once its surface is on that
    // output: until this commit's enter, the window rightly draws at 1.
    on_output: f.mode != .Outputs || f.entered
    if f.mode == .Outputs && !f.entered && f.current != 0 {
        f.entered = true
        surface: f.surface
        output: f.output
        fake_event(f, surface, 0, fake_words([Int]{output}))
    }
    step: f.steps[f.step].copy()
    if acked >= 0 {
        // Acking a configure answers it and every older one.
        index := -1
        loop k in 0..<f.configures.len() {
            if f.configures[k].serial == acked -> index = k
        }
        if index < 0 {
            fake_fail(f, "acked serial {acked}, which no unacked configure carries")
        } else {
            configure: f.configures[index].copy()
            if configure.width > 0 -> f.logical_w = configure.width
            if configure.height > 0 -> f.logical_h = configure.height
            f.configures = f.configures[(index + 1)..<f.configures.len()].copy()
            f.acked_any = true
        }
        f.pending_ack = f.configures.len() > 0
    }
    buffer: fake_buffer(f, f.current) ?? return
    scale120: if on_output -> f.scale120 else -> 120
    want_w: fake_pixels(f.logical_w, scale120)
    want_h: fake_pixels(f.logical_h, scale120)
    matches: buffer.width == want_w && buffer.height == want_h
    mapped := true
    if fake_fractional(f.mode) {
        mapped = f.destination_w == f.logical_w && f.destination_h == f.logical_h
    } else {
        mapped = buffer.width == f.logical_w * f.buffer_scale && buffer.height == f.logical_h * f.buffer_scale
    }
    if acked >= 0 && !matches -> fake_fail(f, "ack {acked} committed with a {buffer.width}x{buffer.height} buffer, not {want_w}x{want_h}")
    if f.reached && !matches -> fake_fail(f, "a {buffer.width}x{buffer.height} buffer after {want_w}x{want_h} was shown")
    if matches && !mapped -> fake_fail(f, "buffer {buffer.width}x{buffer.height} maps to {f.destination_w}x{f.destination_h} (buffer scale {f.buffer_scale}), not {f.logical_w}x{f.logical_h}")
    // The scale never changes in a resize, so every commit after the first
    // ack shows the acked size: a buffer of a size not yet acked would move
    // a window resized by its top or left edge.
    if f.mode == .Resize && f.acked_any && acked < 0 && !(matches && mapped) {
        fake_fail(f, "a {buffer.width}x{buffer.height} buffer on {f.destination_w}x{f.destination_h} committed without an ack while {f.logical_w}x{f.logical_h} is acked")
    }
    // The interactive resize moves on with every frame the window commits,
    // two configures at a time, whether or not it has caught up.
    if f.drag.len() > 0 -> fake_drag(f, 2)
    if matches && mapped && !f.pending_ack && on_output && f.drag.len() == 0 {
        if !f.reached {
            f.reached = true
            via: if step.edge != "" -> "{step.edge} edge, {f.drag_configures} configures: " else -> ""
            f.report.push("{via}{f.logical_w}x{f.logical_h} at {f.scale120}/120: {buffer.width}x{buffer.height} pixels")
            if f.pointer != 0 && f.enters == 0 -> fake_enter(f)
        }
        f.settled += 1
    }
    if f.reached && f.settled >= 3 && !f.closing {
        if f.step + 1 < f.steps.len() {
            f.step += 1
            fake_begin(f)
        } else if f.pointer == 0 || f.cursor_done || f.settled >= 60 {
            if f.pointer != 0 && !f.cursor_done -> fake_fail(f, "the cursor was not set again at the second enter")
            f.closing = true
            toplevel: f.toplevel
            fake_event(f, toplevel, 1, [U8]{})
        }
    }
}

// The pointer enters the surface at (10, 10) with a fresh serial.
fake_enter: fn(&f: Fake) {
    f.enters += 1
    f.enter_serial = 100 + f.enters
    pointer: f.pointer
    serial: f.enter_serial
    surface: f.surface
    fake_event(f, pointer, 0, fake_words([Int]{serial, surface, 2560, 2560}))
}

// A cursor request at `serial`: `shape` 0 hides it. After the first hide
// the pointer leaves and enters again, and the window must set it again.
fake_cursor: fn(&f: Fake, serial: Int, shape: Int) {
    shown: if shape == 0 -> "hidden" else -> "shape {shape}"
    f.report.push("cursor {shown} at enter {f.enters}")
    if serial != f.enter_serial -> fake_fail(f, "cursor set at serial {serial}, the latest enter is {f.enter_serial}")
    if shape == 0 && f.enters == 1 {
        pointer: f.pointer
        surface: f.surface
        fake_event(f, pointer, 1, fake_words([Int]{serial, surface}))
        fake_enter(f)
    } else if shape == 0 && f.enters == 2 {
        f.cursor_done = true
    }
}

fake_pool: fn(f: Fake, object: Int) -> Int {
    loop index in 0..<f.pools.len() {
        if f.pools[index] == object -> return index
    }
    -1
}

fake_request: fn(&f: Fake, object: Int, opcode: Int, body: [U8]) -[Env]> {
    if object == 1 && opcode == 1 {
        f.registry = fake_u32(body, 0)
        registry: f.registry
        if f.mode == .DisplayError {
            args := fake_words([Int]{registry, 3})
            loop b in fake_text("no globals for you") -> args.push(b)
            fake_event(f, 1, 0, args)
            return
        }
        names := 0
        loop interface in f.globals.copy() {
            names += 1
            args := fake_words([Int]{names})
            loop b in fake_text(interface) -> args.push(b)
            fake_put(args, fake_version(f.mode, interface))
            fake_event(f, registry, 0, args)
        }
        return
    }
    if object == 1 && opcode == 0 {
        fake_event(f, fake_u32(body, 0), 0, fake_words([Int]{0}))
        return
    }
    if object == f.registry && opcode == 0 {
        name: fake_u32(body, 0)
        interface: fake_string(body, 4)
        length: fake_u32(body, 4)
        id: fake_u32(body, 8 + ((length + 3) /% 4) * 4 + 4)
        if name < 1 || name > f.globals.len() || f.globals[name - 1] != interface -> fake_fail(f, "bound global {name} as {interface}")
        if interface == "wl_compositor" -> f.compositor = id
        if interface == "wl_shm" {
            f.shm = id
            fake_event(f, id, 0, fake_words([Int]{1}))
        }
        if interface == "xdg_wm_base" -> f.wm_base = id
        if interface == "wp_fractional_scale_manager_v1" -> f.fractional_manager = id
        if interface == "wp_viewporter" -> f.viewporter = id
        if interface == "wp_cursor_shape_manager_v1" -> f.cursor_manager = id
        if interface == "xdg_toplevel_icon_manager_v1" {
            f.icon_manager = id
            // icon_size 32, done.
            fake_event(f, id, 0, fake_words([Int]{32}))
            fake_event(f, id, 1, [U8]{})
        }
        if interface == "wl_seat" {
            f.seat = id
            // capabilities: a pointer.
            fake_event(f, id, 0, fake_words([Int]{1}))
        }
        if interface == "wl_output" {
            f.output = id
            fake_event(f, id, 1, fake_words([Int]{3, 1920, 1080, 60000}))
            fake_event(f, id, 3, fake_words([Int]{1}))
            fake_event(f, id, 2, [U8]{})
        }
        return
    }
    if object == f.compositor && opcode == 0 {
        f.surface = fake_u32(body, 0)
        return
    }
    if object == f.shm && opcode == 0 {
        f.pools.push(fake_u32(body, 0))
        return
    }
    pool: fake_pool(f, object)
    if pool >= 0 {
        if opcode == 0 -> f.buffers.push(FakeBuffer{id: fake_u32(body, 0), pool: pool, offset: fake_u32(body, 4), width: fake_u32(body, 8), height: fake_u32(body, 12), format: fake_u32(body, 20)})
        return
    }
    if object == f.wm_base && opcode == 2 {
        f.xdg_surface = fake_u32(body, 0)
        return
    }
    if object == f.xdg_surface {
        if opcode == 1 -> f.toplevel = fake_u32(body, 0)
        if opcode == 4 -> f.acked = fake_u32(body, 0)
        return
    }
    if object == f.toplevel && opcode == 3 {
        if f.mode == .Fractional -> f.report.push("app_id {fake_string(body, 0)}")
        return
    }
    if object == f.icon_manager && opcode == 1 {
        f.icon = fake_u32(body, 0)
        f.icon_name = ""
        f.icon_sides = [Int]{}
        f.icon_first = [String]{}
        return
    }
    if f.icon != 0 && object == f.icon {
        if opcode == 1 -> f.icon_name = fake_string(body, 0)
        if opcode == 2 {
            buffer: fake_buffer(f, fake_u32(body, 0)) ?? {
                fake_fail(f, "an icon buffer that is no wl_buffer")
                return
            }
            if buffer.width != buffer.height || buffer.format != 0 -> fake_fail(f, "icon buffer {buffer.width}x{buffer.height} in format {buffer.format}, not square ARGB8888")
            f.icon_sides.push(buffer.width)
            if buffer.pool >= f.fds.len() {
                fake_fail(f, "icon pool {buffer.pool} came without its descriptor")
                return
            }
            at: Int(0..9223372036854775807).from_int(buffer.offset) ?? {
                fake_fail(f, "icon buffer {buffer.id} starts before its pool")
                return
            }
            first: f.fds[buffer.pool].read_at(at, 4) ?? {
                fake_fail(f, "reading the icon pool failed: {err}")
                return
            }
            f.icon_first.push("{first}")
        }
        if opcode == 0 -> f.icon = 0
        return
    }
    if object == f.icon_manager && opcode == 2 {
        if fake_u32(body, 0) != f.toplevel -> fake_fail(f, "an icon for object {fake_u32(body, 0)}, not the toplevel")
        if fake_u32(body, 4) == 0 {
            f.report.push("icon unset")
        } else {
            f.report.push("icon {f.icon_name} with sides {f.icon_sides}, first pixels {f.icon_first}")
        }
        return
    }
    if object == f.fractional_manager && opcode == 1 {
        f.fractional = fake_u32(body, 0)
        return
    }
    if object == f.viewporter && opcode == 1 {
        f.viewport = fake_u32(body, 0)
        return
    }
    if object == f.viewport && opcode == 2 {
        f.destination_w = fake_u32(body, 0)
        f.destination_h = fake_u32(body, 4)
        return
    }
    if object == f.seat && opcode == 0 {
        f.pointer = fake_u32(body, 0)
        return
    }
    if object == f.cursor_manager && opcode == 1 {
        f.cursor_device = fake_u32(body, 0)
        if fake_u32(body, 4) != f.pointer -> fake_fail(f, "a cursor-shape device for object {fake_u32(body, 4)}, not the pointer {f.pointer}")
        return
    }
    if object == f.cursor_device && opcode == 1 {
        fake_cursor(f, fake_u32(body, 0), fake_u32(body, 4))
        return
    }
    if object == f.pointer && opcode == 0 {
        if fake_u32(body, 4) != 0 -> fake_fail(f, "set_cursor with a surface")
        fake_cursor(f, fake_u32(body, 0), 0)
        return
    }
    if object == f.surface {
        if opcode == 1 -> f.attached = fake_u32(body, 0)
        if opcode == 3 -> f.callbacks.push(fake_u32(body, 0))
        if opcode == 8 -> f.buffer_scale = fake_u32(body, 0)
        if opcode == 6 {
            first: f.commits == 0
            if first && f.mode == .ShortEvent {
                toplevel: f.toplevel
                fake_event(f, toplevel, 0, fake_words([Int]{640}))
                return
            }
            if first {
                // The initial commit: the first step's scale, then its configure.
                f.commits += 1
                fake_begin(f)
                return
            }
            fake_commit(f)
        }
        return
    }
}

// Handles every complete request in the inbox.
fake_dispatch: fn(&f: Fake) -[Env]> {
    at := 0
    loop f.inbox.len() - at >= 8 {
        object: fake_u32(f.inbox, at)
        word: fake_u32(f.inbox, at + 4)
        size: word >> 16
        if size < 8 {
            fake_fail(f, "malformed request header")
            f.inbox = [U8]{}
            return
        }
        if f.inbox.len() - at < size -> break
        body: f.inbox[(at + 8)..<(at + size)].copy()
        fake_request(f, object, word.bit_and(65535), body)
        at += size
    }
    if at > 0 -> f.inbox = f.inbox[at..<f.inbox.len()].copy()
}

// Accepts one window and serves it until it disconnects.
fake_serve: fn(listener: net.UnixListener, mode: FakeMode, steps: [FakeStep]) -[Env, Net, Time, IO]> Fake {
    stream: net.unix_accept(listener) ?? panic("accept: {err}")
    f := Fake{
        stream: stream, mode: mode, inbox: [U8]{}, out: [U8]{}, globals: fake_globals(mode),
        registry: 0, compositor: 0, shm: 0, wm_base: 0, fractional_manager: 0, viewporter: 0, output: 0,
        surface: 0, xdg_surface: 0, toplevel: 0, fractional: 0, viewport: 0,
        seat: 0, pointer: 0, cursor_manager: 0, cursor_device: 0, enters: 0, enter_serial: -1,
        pools: [Int]{}, fds: [sys.Fd]{}, buffers: [FakeBuffer]{},
        attached: 0, current: 0, acked: -1, callbacks: [Int]{}, destination_w: 0, destination_h: 0, buffer_scale: 1, entered: false,
        steps: steps, step: 0, serial: 0, configures: [FakeConfigure]{}, drag: [FakeSize]{}, drag_configures: 0,
        logical_w: 300, logical_h: 200, scale120: 120,
        icon_manager: 0, icon: 0, icon_name: "", icon_sides: [Int]{}, icon_first: [String]{},
        reached: false, pending_ack: false, acked_any: false, settled: 0, closing: false, cursor_done: false, commits: 0, report: [String]{}, failures: [String]{},
    }
    idle := 0
    loop idle < 40 {
        ready: net.unix_wait(f.stream, 50000000) ?? {
            f.failures.push("wait failed: {err}")
            return f
        }
        if !ready {
            idle += 1
            next
        }
        idle = 0
        message: net.unix_receive(f.stream, 65536) ?? {
            f.failures.push("receive failed: {err}")
            return f
        }
        if message.bytes.len() == 0 -> return f
        loop fd in message.fds.move() -> f.fds.push(fd)
        loop b in message.bytes -> f.inbox.push(b)
        fake_dispatch(f)
        fake_flush(f)
    }
    f.failures.push("the window went quiet")
    f
}

// A window that presents a frame of its current size until `.Close`.
client: fn(label: String) -[Env, IO, Net, Time]> {
    window: ui.open(width: 300, height: 200, title: "configure test") ?? {
        print("{label}: open failed: {err}")
        return
    }
    frames := 0
    resizes := 0
    // A text cursor from the start; hidden once the pointer arrives.
    window.set_cursor(.Text)
    if label == "fractional" -> identity(window)
    hidden := false
    // Every scale the frames carried, in order, once each time it changes.
    scales := [Float]{}
    loop frame in window.frames() {
        if scales.len() == 0 || scales[scales.len() - 1] != frame.scale -> scales.push(frame.scale)
        closed := false
        loop event in frame.events() {
            if event == .Close -> closed = true
            if event == .Resize(_, _) -> resizes += 1
            if event == .PointerMove(_, _) && !hidden {
                window.set_cursor(.Hidden)
                hidden = true
            }
        }
        if closed -> break
        pixels := [U8]{}
        count := frame.width * frame.height
        loop count > 0 {
            // RGBA, straight alpha.
            pixels.push(U8{40})
            pixels.push(U8{80})
            pixels.push(U8{120})
            pixels.push(U8{255})
            count -= 1
        }
        frame.present(pixels) ?? {
            print("{label}: present failed: {err}")
            return
        }
        frames += 1
    }
    if window.failure() == .Val(failure) {
        print("{label}: failed: {failure}")
        return
    }
    print("{label}: closed at {window.width()}x{window.height()} pixels, scale {window.scale()}, cursor {window.cursor()}, resized {if resizes > 0 -> "yes" else -> "no"}")
    print("  frame scales {scales}")
}

// The window's identity: its own app_id and an icon of two sizes; an empty
// app_id and a short or oversized image are refused before they reach the
// display.
identity: fn(window: ui.Window) -[Env, IO]> {
    if window.set_app_id("") == .Err(error) -> print("empty app_id: {error}")
    window.set_app_id("dev.jet.fakewl") ?? print("set_app_id failed: {err}")
    short: ui.UIIcon{name: "jet", images: [ui.UIIconImage]{ui.UIIconImage{side: 16, pixels: icon_pixels(15)}}}
    if window.set_icon(short) == .Err(error) -> print("short icon: {error}")
    huge: ui.UIIcon{name: "jet", images: [ui.UIIconImage]{ui.UIIconImage{side: 1025, pixels: [U8]{}}}}
    if window.set_icon(huge) == .Err(error) -> print("huge icon: {error}")
    icon: ui.UIIcon{name: "jet", images: [ui.UIIconImage]{ui.UIIconImage{side: 16, pixels: icon_pixels(16)}, ui.UIIconImage{side: 32, pixels: icon_pixels(32)}}}
    window.set_icon(icon) ?? print("set_icon failed: {err}")
}

// A `side` x `side` half-transparent icon in straight-alpha RGBA: R, G, B,
// A. The display stores it premultiplied, B, G, R, A: 100, 40, 20, 128.
icon_pixels: fn(side: Int) -> [U8] {
    pixels := [U8]{}
    loop _ in 0..<(side * side) {
        pixels.push(U8{40})
        pixels.push(U8{80})
        pixels.push(U8{200})
        pixels.push(U8{128})
    }
    pixels
}

steps_for: fn(mode: FakeMode) -> [FakeStep] {
    if mode == .Fractional {
        return [FakeStep]{
            size_step(0, 0, 180),
            size_step(640, 480, 180),
            size_step(200, 150, 180),
            scale_step(240),
            size_step(333, 222, 240),
            scale_step(150),
            size_step(1, 1, 150),
            size_step(500, 300, 120),
        }
    }
    if mode == .Resize {
        // Round the compass from 300x200, every size at 1.5 pixels a unit;
        // odd sizes round half away from zero.
        return [FakeStep]{
            size_step(0, 0, 180),
            edge_step("top", 300, 263),
            edge_step("top-right", 361, 301),
            edge_step("right", 427, 301),
            edge_step("bottom-right", 465, 343),
            edge_step("bottom", 465, 281),
            edge_step("bottom-left", 397, 219),
            edge_step("left", 331, 219),
            edge_step("top-left", 301, 199),
        }
    }
    [FakeStep]{
        size_step(0, 0, 240),
        size_step(400, 300, 240),
        scale_step(360),
        size_step(120, 90, 360),
        scale_step(120),
    }
}

// A configure of `width` x `height` at `scale120`.
size_step: fn(width: Int, height: Int, scale120: Int) -> FakeStep {
    FakeStep{configure: true, width: width, height: height, scale120: scale120, edge: ""}
}

// A new scale and no configure.
scale_step: fn(scale120: Int) -> FakeStep {
    FakeStep{configure: false, width: 0, height: 0, scale120: scale120, edge: ""}
}

// An interactive resize from `edge` to `width` x `height` at 180/120.
edge_step: fn(edge: String, width: Int, height: Int) -> FakeStep {
    FakeStep{configure: true, width: width, height: height, scale120: 180, edge: edge}
}

mode_name: fn(mode: FakeMode) -> String {
    if mode == {
        .Fractional -> "fractional"
        .Preferred -> "preferred"
        .Outputs -> "outputs"
        .DisplayError -> "display error"
        .ShortEvent -> "short event"
        .Resize -> "resize"
    }
}

run: fn() {
    path: sys.get("WAYLAND_DISPLAY") ?? ""
    if !path.starts_with("/") {
        print("WAYLAND_DISPLAY must be an absolute socket path")
        return
    }
    listener: net.unix_listen(path) ?? {
        print("listen failed: {err}")
        return
    }
    modes: [FakeMode]{.Fractional, .Preferred, .Outputs, .Resize, .DisplayError, .ShortEvent}
    loop mode in modes {
        server: task { fake_serve(listener, mode, steps_for(mode)) }
        client(mode_name(mode))
        f: server.join() ?? panic("compositor task failed")
        loop line in f.report -> print("  {line}")
        loop failure in f.failures -> print("  FAIL {failure}")
    }
}
