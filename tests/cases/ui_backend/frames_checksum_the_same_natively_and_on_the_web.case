# #6701: a headless core.ui window draws the same pixels at O0, O2, built
# and on the web. Three scripted frames draw every Frame primitive (fills,
# translucency, gradients, outlines, lines, curves, polygons, text at three
# sizes, a sprite) and each prints its frame checksum; every other tier
# must print exactly what O0 printed. The anchors are derived by hand: the
# corner only ever gets the Jet black clear, (30, 30) is inside the opaque
# red fill and outside every later draw, and frame 2 repaints (9, 9) black.
fixture: frames_checksum_the_same_natively_and_on_the_web.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step o0: jet run --optimize=none main.jet
exit: 0
stdout: ~ "frames 3\nframe 0: " # the three scripted frames are shown; the closing frame draws nothing
stdout: ~ "corner: #0B0B0D, alpha 255\nred fill: #E8232A, alpha 255\nrepainted: #0B0B0D, alpha 255\n" # the hand-derived pixels
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: == o0
stderr: empty
step build: jet build --optimize=full main.jet
exit: 0
step aot: built
exit: 0
stdout: == o0
stderr: empty
step: jet build --target web main.jet
exit: 0
step web: node .jet/build/app.js
exit: 0 # run from the fixture, where the sprite's atlas is
stdout: == o0
stderr: empty
