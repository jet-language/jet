# A Wayland window draws 600 animated frames at 2560x1440 and the
# fake compositor sees every commit answer the protocol. This is the
# correctness half of wayland_windows_hold_a_one_millisecond_frame, on the
# same fixture: it runs in every batch and holds no time limit, because a
# loaded machine cannot time a millisecond. The timing half runs only
# under JET_TIMING_QUIET=1.
requires: os-name:linux
fixture: wayland_windows_hold_a_one_millisecond_frame.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step release: jet run --release main.jet
exit: 0
stdout: ~ "2560x1406: 600 frames drawn and 600 frame to frame times measured\ndraw p99 within 1 ms: " # every frame was drawn and measured
stdout: !~ "FAIL " # the compositor saw no protocol failure
stdout: !~ "failed" # the socket opened and the window opened
stderr: empty
