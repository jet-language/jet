# tests/ui_backend.rs::null_backend_measure_layout_paint_roundtrip at tests/ui_backend.rs:83; hand-port
# The example declares its inline package, so the case adds none. The original compiled it ahead
# of time (build_and_run), so the case builds and runs the executable.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
copy: {root}/Examples/Apps/UI/UINullBackend.jet ui_null_backend.jet
step: jet build ui_null_backend.jet
exit: 0
step: built
exit: 0 # assert_eq!(code, 0, "ui backend roundtrip failed: {stderr}")
stdout: = ../../../Examples/Apps/UI/UINullBackend.out
