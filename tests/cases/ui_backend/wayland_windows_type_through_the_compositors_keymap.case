# #6701: native windows type through the compositor's XKB keymap. A
# fake compositor on $WAYLAND_DISPLAY types US keys before any keymap,
# then sends its us,de keymap through shared memory: the layout group,
# Shift, AltGr and a dead key composed with e follow its modifiers. At
# rate 0 a held key never repeats; at 20 a second after 150 ms a held
# key repeats and stops at its release; a held Shift never repeats.
requires: os:linux
fixture: wayland_windows_type_through_the_compositors_keymap.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step run: jet run main.jet
exit: 0
stdout: = "focus true\ndown Char(z)\ntext z\nup Char(z)\ndown Char(z)\ntext z\nup Char(z)\ndown Char(y)\ntext y\nup Char(y)\ndown Char(y)\ntext Y\nup Char(y)\ndown Char(q)\ntext @\nup Char(q)\ndown Char(')\nup Char(')\ndown Char(e)\ntext é\nup Char(e)\ndown Char(a)\ntext a\nup Char(a)\ndown Char(a)\ntext a\nup Char(a), repeated while held\ndown Shift\nup Shift\nclosed\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "focus true\ndown Char(z)\ntext z\nup Char(z)\ndown Char(z)\ntext z\nup Char(z)\ndown Char(y)\ntext y\nup Char(y)\ndown Char(y)\ntext Y\nup Char(y)\ndown Char(q)\ntext @\nup Char(q)\ndown Char(')\nup Char(')\ndown Char(e)\ntext é\nup Char(e)\ndown Char(a)\ntext a\nup Char(a)\ndown Char(a)\ntext a\nup Char(a), repeated while held\ndown Shift\nup Shift\nclosed\n"
stderr: empty
