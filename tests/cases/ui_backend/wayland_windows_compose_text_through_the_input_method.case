# Native windows take text from the compositor's input method over
# zwp_text_input_v3. A fake compositor gives the window the keyboard and
# the input method's focus; the window's text field enables the text
# input with its content type and caret rectangle. The input method's
# preedits arrive as `.Compose` (the caret's byte range in characters,
# after the text when hidden, all of it marked), the end of a composition
# comes before its committed `.Text`, and leaving the text field disables
# the text input and ends the composition. A headless window has no
# input method.
requires: os-name:linux
fixture: wayland_windows_compose_text_through_the_input_method.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step run: jet run main.jet
exit: 0
stdout: = "headless text field kept\nfocus true\ncompose 'にほ' caret 2-2 marked 0-2\ncompose 'にほん' caret 3-3 marked 0-3\ncompose '' caret 0-0 marked none\ntext 日本\ncompose 'ご' caret 0-1 marked 0-1\ncompose '' caret 0-0 marked none\nclosed\ntext input for the seat\nenabled with content type 0 0 and caret 5,10 1x8\ndisabled after 2 commits\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "headless text field kept\nfocus true\ncompose 'にほ' caret 2-2 marked 0-2\ncompose 'にほん' caret 3-3 marked 0-3\ncompose '' caret 0-0 marked none\ntext 日本\ncompose 'ご' caret 0-1 marked 0-1\ncompose '' caret 0-0 marked none\nclosed\ntext input for the seat\nenabled with content type 0 0 and caret 5,10 1x8\ndisabled after 2 commits\n"
stderr: empty
