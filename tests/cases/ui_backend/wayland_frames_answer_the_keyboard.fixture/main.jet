package: {
    name: "wayland_frames_answer_the_keyboard"
    authority: { allow: [Env, IO, Net, Time] }
}
use {
    net: core.net
    sys: core.sys
    ui: core.ui
}

// A fake Wayland compositor on $WAYLAND_DISPLAY works Jet's own window
// frame from a wl_keyboard, once on the US table and once through an XKB
// keymap. F6 gives the frame the keyboard focus, which rings the focused
// button; Tab and Shift+Tab step across the buttons; Enter works one;
// Shift+F10 opens the window menu under the focused button and Alt+Space
// under the title's start; Escape and leaving the window give the focus
// back to the content. The keys the frame takes never reach the program.

KEYMAP: comptime { embed_file("us_de.xkb") }

FakeMode: enum {
    // No wl_keyboard.keymap: the window reads keys on the US table.
    UsTable
    // The compositor's XKB keymap comes first.
    Keymap
}

// A wl_buffer: its pool (an index into `pools`), offset and size.
FakeBuffer: struct {
    id: Int
    pool: Int
    offset: Int
    width: Int
    height: Int
}

Fake: struct {
    stream: net.UnixStream
    mode: FakeMode
    inbox: [U8]
    out: [U8]
    registry: Int
    compositor: Int
    subcompositor: Int
    shm: Int
    wm_base: Int
    decoration_manager: Int
    decoration: Int
    seat: Int
    keyboard: Int
    surface: Int
    chrome: Int
    subsurface: Int
    xdg_surface: Int
    toplevel: Int
    // Every pool, and the descriptors the window sent, one per pool in order.
    pools: [Int]
    fds: [sys.Fd]
    buffers: [FakeBuffer]
    // The content surface: pending, then current at commit.
    attached: Int
    current: Int
    acked: Int
    callbacks: [Int]
    // The chrome's buffer: pending, cached by its commit, shown by the
    // content's.
    chrome_pending: Int
    chrome_cached: Int
    chrome_shown: Int
    chrome_dirty: Bool
    position_x: Int
    position_y: Int
    shown_x: Int
    shown_y: Int
    serial: Int
    // Configure serials not yet acked, oldest first.
    configures: [Int]
    phase: Int
    settled: Int
    commits: Int
    report: [String]
    failures: [String]
    closing: Bool
}

GLOBALS: [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wl_subcompositor", "zxdg_decoration_manager_v1", "wl_seat"}

fake_put: fn(&out: [U8], value: Int) {
    v: value.bit_and(4294967295)
    out.push(U8{v.bit_and(255)})
    out.push(U8{(v >> 8).bit_and(255)})
    out.push(U8{(v >> 16).bit_and(255)})
    out.push(U8{(v >> 24).bit_and(255)})
}

fake_words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values -> fake_put(out, value)
    out
}

fake_text: fn(text: String) -> [U8] {
    out := [U8]{}
    bytes: text.bytes()
    fake_put(out, bytes.len() + 1)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
    loop out.len() %% 4 != 0 -> out.push(U8{0})
    out
}

fake_u32: fn(bytes: [U8], at: Int) -> Int {
    if at + 4 > bytes.len() -> return 0
    Int.from_u8(bytes[at]) + (Int.from_u8(bytes[at + 1]) << 8) + (Int.from_u8(bytes[at + 2]) << 16) + (Int.from_u8(bytes[at + 3]) << 24)
}

fake_i32: fn(bytes: [U8], at: Int) -> Int {
    v: fake_u32(bytes, at)
    if v >= 2147483648 -> v - 4294967296 else -> v
}

fake_string: fn(bytes: [U8], at: Int) -> String {
    length: fake_u32(bytes, at)
    if length <= 1 || at + 4 + length > bytes.len() -> return ""
    String.from_bytes(bytes[(at + 4)..<(at + 3 + length)]) ?? ""
}

fake_event: fn(&f: Fake, object: Int, opcode: Int, args: [U8]) {
    fake_put(f.out, object)
    fake_put(f.out, ((args.len() + 8) << 16) + opcode)
    loop b in args -> f.out.push(b)
}

fake_flush: fn(&f: Fake) -[Net, Time]> {
    if f.out.len() == 0 -> return
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{}) ?? {
        if !f.closing -> f.failures.push("send failed: {err}")
        return
    }
}

fake_fail: fn(&f: Fake, message: String) {
    if f.failures.len() < 8 -> f.failures.push("phase {f.phase}: {message}")
}

fake_version: fn(interface: String) -> Int {
    if interface == "wl_compositor" -> return 6
    if interface == "xdg_wm_base" -> return 2
    if interface == "wl_seat" -> return 5
    1
}

// A configure of 400 x 300 in `states` (xdg_toplevel's: 1 maximized,
// 4 activated).
fake_configure: fn(&f: Fake, states: [Int]) {
    f.serial += 1
    serial: f.serial
    f.configures.push(serial)
    toplevel: f.toplevel
    xdg_surface: f.xdg_surface
    args := fake_words([Int]{400, 300, states.len() * 4})
    loop state in states -> fake_put(args, state)
    fake_event(f, toplevel, 0, args)
    fake_event(f, xdg_surface, 0, fake_words([Int]{serial}))
}

fake_buffer: fn(f: Fake, id: Int) -> FakeBuffer? {
    loop buffer in f.buffers {
        if buffer.id == id -> return Val(buffer.copy())
    }
    None
}

fake_pool: fn(f: Fake, object: Int) -> Int {
    loop index in 0..<f.pools.len() {
        if f.pools[index] == object -> return index
    }
    -1
}

// The four bytes of pixel (x, y) of `buffer` as stored.
fake_pixel: fn(&f: Fake, buffer: FakeBuffer, x: Int, y: Int) -> [U8] {
    if buffer.pool >= f.fds.len() || x < 0 || y < 0 || x >= buffer.width || y >= buffer.height {
        fake_fail(f, "pixel {x},{y} is outside buffer {buffer.id}")
        return [U8]{}
    }
    at: Int(0..9223372036854775807).from_int(buffer.offset + (y * buffer.width + x) * 4) ?? {
        fake_fail(f, "pixel {x},{y} lies before the start of its pool")
        return [U8]{}
    }
    f.fds[buffer.pool].read_at(at, 4) ?? {
        fake_fail(f, "reading a pool failed: {err}")
        [U8]{}
    }
}

// The content's commit: an ack, the content's buffer, and the chrome its
// own commit cached.
fake_commit: fn(&f: Fake) -[Env, Net, Time]> {
    f.commits += 1
    acked: f.acked
    f.acked = -1
    if acked >= 0 {
        index := -1
        loop k in 0..<f.configures.len() {
            if f.configures[k] == acked -> index = k
        }
        if index < 0 {
            fake_fail(f, "acked serial {acked}, which no unacked configure carries")
        } else {
            f.configures = f.configures[(index + 1)..<f.configures.len()].copy()
        }
    }
    if f.attached != 0 {
        previous: f.current
        f.current = f.attached
        f.attached = 0
        if previous != 0 && previous != f.current -> fake_event(f, previous, 0, [U8]{})
    }
    if f.chrome_dirty {
        previous: f.chrome_shown
        f.chrome_shown = f.chrome_cached
        f.chrome_dirty = false
        if previous != 0 && previous != f.chrome_shown -> fake_event(f, previous, 0, [U8]{})
    }
    f.shown_x = f.position_x
    f.shown_y = f.position_y
    callbacks: f.callbacks.copy()
    f.callbacks = [Int]{}
    loop id in callbacks -> fake_event(f, id, 0, fake_words([Int]{f.commits}))
    if f.configures.len() > 0 || f.current == 0 -> return
    f.settled += 1
    if f.settled < 3 -> return
    f.settled = 0
    fake_phase(f)
}

// Where the chrome is and which buttons wear the focus ring: a light pixel
// 11 units right of a button's centre, on the ring 11 to 12.5 units out,
// halfway down the 34-unit header, which is dark otherwise. The centres
// are 8 + 9 units in from the window's right edge, then 28 apart.
fake_report: fn(&f: Fake) {
    chrome: fake_buffer(f, f.chrome_shown) ?? {
        fake_fail(f, "the chrome shows no wl_buffer")
        return
    }
    m: 0 - f.shown_x
    names: [String]{"close", "maximize", "minimize"}
    ringed := [String]{}
    loop k in 0..<3 {
        cx: 400 - 17 - k * 28
        pixel: fake_pixel(f, chrome, cx + 11 + m, 17 + m)
        // Bytes B, G, R, A: the header's red is 0x0B, the ring's 0xEC.
        if pixel.len() == 4 && Int.from_u8(pixel[2]) >= 128 -> ringed.push(names[k])
    }
    f.report.push("chrome at {f.shown_x},{f.shown_y}, ringed {ringed}")
}

// wl_keyboard events, with their serials.
fake_key: fn(&f: Fake, serial: Int, code: Int, state: Int) {
    keyboard: f.keyboard
    fake_event(f, keyboard, 3, fake_words([Int]{serial, serial * 10, code, state}))
}

// A press and release of evdev key `code` at serials `serial` and the next.
fake_tap: fn(&f: Fake, serial: Int, code: Int) {
    fake_key(f, serial, code, 1)
    fake_key(f, serial + 1, code, 0)
}

fake_mods: fn(&f: Fake, serial: Int, depressed: Int) {
    keyboard: f.keyboard
    fake_event(f, keyboard, 4, fake_words([Int]{serial, depressed, 0, 0, 0}))
}

// The keymap rides with its wl_keyboard.keymap event in one message: the
// text and its NUL in shared memory, format 1 (XKB text v1).
fake_keymap: fn(&f: Fake) -[Env, Net, Time]> {
    fake_flush(f)
    bytes := KEYMAP.bytes().copy()
    bytes.push(U8{0})
    size: Int(1..1073741824).from_int(bytes.len()) ?? {
        fake_fail(f, "keymap of {bytes.len()} bytes")
        return
    }
    memory := sys.shared_memory(size) ?? {
        fake_fail(f, "keymap memory: {err}")
        return
    }
    memory.write(0, bytes) ?? {
        fake_fail(f, "keymap write: {err}")
        return
    }
    fd: memory.descriptor() ?? {
        fake_fail(f, "keymap descriptor: {err}")
        return
    }
    keyboard: f.keyboard
    fake_event(f, keyboard, 0, fake_words([Int]{1, bytes.len()}))
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{fd}) ?? {
        fake_fail(f, "keymap send failed: {err}")
        return
    }
}

// evdev codes: 1 Escape, 15 Tab, 28 Enter, 30 a, 42 left Shift, 48 b,
// 56 left Alt, 57 space, 64 F6, 68 F10. Modifier masks: Shift 1, Alt
// (Mod1) 8.
KEY_ESCAPE: 1
KEY_TAB: 15
KEY_ENTER: 28
KEY_A: 30
KEY_SHIFT: 42
KEY_B: 48
KEY_ALT: 56
KEY_SPACE: 57
KEY_F6: 64
KEY_F10: 68

// Each settled state: report it, then the next keys.
fake_phase: fn(&f: Fake) -[Env, Net, Time]> {
    fake_report(f)
    phase: f.phase
    f.phase += 1
    keyboard: f.keyboard
    surface: f.surface
    if phase == 0 {
        if f.mode == .Keymap -> fake_keymap(f)
        fake_event(f, keyboard, 1, fake_words([Int]{100, surface, 0}))
        // a reaches the program; F6, Tab and Enter work maximize.
        fake_tap(f, 101, KEY_A)
        fake_tap(f, 103, KEY_F6)
        fake_tap(f, 105, KEY_TAB)
        fake_tap(f, 107, KEY_ENTER)
        return
    }
    if phase == 1 {
        // Shift+Tab steps back to minimize; Shift+F10 opens the menu.
        fake_key(f, 201, KEY_SHIFT, 1)
        fake_mods(f, 202, 1)
        fake_tap(f, 203, KEY_TAB)
        fake_tap(f, 205, KEY_F10)
        fake_key(f, 207, KEY_SHIFT, 0)
        fake_mods(f, 208, 0)
        return
    }
    if phase == 2 {
        // Escape hands the keys back: b and Alt reach the program, and
        // Alt+Space opens the menu.
        fake_tap(f, 301, KEY_ESCAPE)
        fake_tap(f, 303, KEY_B)
        fake_key(f, 305, KEY_ALT, 1)
        fake_mods(f, 306, 8)
        fake_tap(f, 307, KEY_SPACE)
        fake_key(f, 309, KEY_ALT, 0)
        fake_mods(f, 310, 0)
        return
    }
    if phase == 3 {
        fake_tap(f, 401, KEY_F6)
        return
    }
    if phase == 4 {
        // Enter on minimize, then the keyboard leaves.
        fake_tap(f, 501, KEY_ENTER)
        fake_event(f, keyboard, 2, fake_words([Int]{503, surface}))
        return
    }
    f.closing = true
    toplevel: f.toplevel
    fake_event(f, toplevel, 1, [U8]{})
}

fake_request: fn(&f: Fake, object: Int, opcode: Int, body: [U8]) -[Env, Net, Time]> {
    if object == 1 && opcode == 1 {
        f.registry = fake_u32(body, 0)
        registry: f.registry
        names := 0
        loop interface in GLOBALS {
            names += 1
            args := fake_words([Int]{names})
            loop b in fake_text(interface) -> args.push(b)
            fake_put(args, fake_version(interface))
            fake_event(f, registry, 0, args)
        }
        return
    }
    if object == 1 && opcode == 0 {
        fake_event(f, fake_u32(body, 0), 0, fake_words([Int]{0}))
        return
    }
    if object == f.registry && opcode == 0 {
        name: fake_u32(body, 0)
        interface: fake_string(body, 4)
        length: fake_u32(body, 4)
        id: fake_u32(body, 8 + ((length + 3) /% 4) * 4 + 4)
        if name < 1 || name > GLOBALS.len() || GLOBALS[name - 1] != interface -> fake_fail(f, "bound global {name} as {interface}")
        if interface == "wl_compositor" -> f.compositor = id
        if interface == "wl_subcompositor" -> f.subcompositor = id
        if interface == "wl_shm" {
            f.shm = id
            fake_event(f, id, 0, fake_words([Int]{0}))
            fake_event(f, id, 0, fake_words([Int]{1}))
        }
        if interface == "xdg_wm_base" -> f.wm_base = id
        if interface == "zxdg_decoration_manager_v1" -> f.decoration_manager = id
        if interface == "wl_seat" {
            f.seat = id
            // capabilities: a keyboard.
            fake_event(f, id, 0, fake_words([Int]{2}))
        }
        return
    }
    if object == f.compositor {
        if opcode == 0 && f.surface == 0 {
            f.surface = fake_u32(body, 0)
        } else if opcode == 0 {
            f.chrome = fake_u32(body, 0)
        }
        return
    }
    if object == f.subcompositor && opcode == 1 {
        f.subsurface = fake_u32(body, 0)
        return
    }
    if f.subsurface != 0 && object == f.subsurface {
        if opcode == 1 {
            f.position_x = fake_i32(body, 0)
            f.position_y = fake_i32(body, 4)
        }
        return
    }
    if object == f.decoration_manager && opcode == 1 {
        f.decoration = fake_u32(body, 0)
        return
    }
    if f.decoration != 0 && object == f.decoration && opcode == 1 {
        decoration: f.decoration
        fake_event(f, decoration, 0, fake_words([Int]{fake_u32(body, 0)}))
        return
    }
    if object == f.shm && opcode == 0 {
        f.pools.push(fake_u32(body, 0))
        return
    }
    pool: fake_pool(f, object)
    if pool >= 0 {
        if opcode == 0 -> f.buffers.push(FakeBuffer{id: fake_u32(body, 0), pool: pool, offset: fake_u32(body, 4), width: fake_u32(body, 8), height: fake_u32(body, 12)})
        return
    }
    if object == f.wm_base && opcode == 2 {
        f.xdg_surface = fake_u32(body, 0)
        return
    }
    if object == f.xdg_surface {
        if opcode == 1 -> f.toplevel = fake_u32(body, 0)
        if opcode == 4 -> f.acked = fake_u32(body, 0)
        return
    }
    if object == f.toplevel {
        if opcode == 4 -> f.report.push("window menu at {fake_i32(body, 8)},{fake_i32(body, 12)}, serial {fake_u32(body, 4)}")
        if opcode == 5 -> f.report.push("move at serial {fake_u32(body, 4)}")
        if opcode == 9 {
            f.report.push("maximize")
            fake_configure(f, [Int]{1, 4})
        }
        if opcode == 10 -> f.report.push("unmaximize")
        if opcode == 13 -> f.report.push("minimize")
        return
    }
    if f.seat != 0 && object == f.seat {
        if opcode == 1 -> f.keyboard = fake_u32(body, 0)
        return
    }
    if f.chrome != 0 && object == f.chrome {
        if opcode == 1 -> f.chrome_pending = fake_u32(body, 0)
        if opcode == 6 {
            f.chrome_cached = f.chrome_pending
            f.chrome_dirty = true
        }
        return
    }
    if object == f.surface {
        if opcode == 1 -> f.attached = fake_u32(body, 0)
        if opcode == 3 -> f.callbacks.push(fake_u32(body, 0))
        if opcode == 6 {
            if f.commits == 0 {
                // The initial commit: the first configure.
                f.commits += 1
                fake_configure(f, [Int]{4})
                return
            }
            fake_commit(f)
        }
        return
    }
}

// Handles every complete request in the inbox.
fake_dispatch: fn(&f: Fake) -[Env, Net, Time]> {
    at := 0
    loop f.inbox.len() - at >= 8 {
        object: fake_u32(f.inbox, at)
        word: fake_u32(f.inbox, at + 4)
        size: word >> 16
        if size < 8 {
            fake_fail(f, "malformed request header")
            f.inbox = [U8]{}
            return
        }
        if f.inbox.len() - at < size -> break
        body: f.inbox[(at + 8)..<(at + size)].copy()
        fake_request(f, object, word.bit_and(65535), body)
        at += size
    }
    if at > 0 -> f.inbox = f.inbox[at..<f.inbox.len()].copy()
}

// Accepts one window and serves it until it disconnects.
fake_serve: fn(listener: net.UnixListener, mode: FakeMode) -[Env, Net, Time, IO]> Fake {
    stream: net.unix_accept(listener) ?? panic("accept: {err}")
    f := Fake{
        stream: stream, mode: mode, inbox: [U8]{}, out: [U8]{},
        registry: 0, compositor: 0, subcompositor: 0, shm: 0, wm_base: 0, decoration_manager: 0, decoration: 0,
        seat: 0, keyboard: 0, surface: 0, chrome: 0, subsurface: 0, xdg_surface: 0, toplevel: 0,
        pools: [Int]{}, fds: [sys.Fd]{}, buffers: [FakeBuffer]{},
        attached: 0, current: 0, acked: -1, callbacks: [Int]{},
        chrome_pending: 0, chrome_cached: 0, chrome_shown: 0, chrome_dirty: false,
        position_x: 0, position_y: 0, shown_x: 0, shown_y: 0, serial: 0, configures: [Int]{},
        phase: 0, settled: 0, commits: 0, report: [String]{}, failures: [String]{}, closing: false,
    }
    idle := 0
    loop idle < 40 {
        ready: net.unix_wait(f.stream, 50000000) ?? {
            f.failures.push("wait failed: {err}")
            return f
        }
        if !ready {
            idle += 1
            next
        }
        idle = 0
        message: net.unix_receive(f.stream, 65536) ?? {
            if !f.closing -> f.failures.push("receive failed: {err}")
            return f
        }
        if message.bytes.len() == 0 -> return f
        loop fd in message.fds.move() -> f.fds.push(fd)
        loop b in message.bytes -> f.inbox.push(b)
        fake_dispatch(f)
        fake_flush(f)
    }
    f.failures.push("the window went quiet")
    f
}

// A window that presents white frames until `.Close`, printing the
// keyboard events it gets.
client: fn(label: String) -[Env, IO, Net, Time]> {
    window: ui.open(width: 400, height: 300, title: "Notes") ?? {
        print("{label}: open failed: {err}")
        return
    }
    loop frame in window.frames() {
        closed := false
        loop event in frame.events() {
            if event == .Close -> closed = true
            if event == .Focus(focused) -> print("{label}: focus {focused}")
            if event == .KeyDown(key) -> print("{label}: down {key}")
            if event == .Text(text) -> print("{label}: text {text}")
            if event == .KeyUp(key) -> print("{label}: up {key}")
        }
        if closed -> break
        pixels := [U8]{}
        count := frame.width * frame.height * 4
        loop count > 0 {
            pixels.push(U8{255})
            count -= 1
        }
        frame.present(pixels) ?? {
            print("{label}: present failed: {err}")
            return
        }
    }
    if window.failure() == .Val(failure) {
        print("{label}: failed: {failure}")
        return
    }
    print("{label}: closed")
}

mode_name: fn(mode: FakeMode) -> String {
    if mode == {
        .UsTable -> "us table"
        .Keymap -> "keymap"
    }
}

run: fn() {
    path: sys.get("WAYLAND_DISPLAY") ?? ""
    if !path.starts_with("/") {
        print("WAYLAND_DISPLAY must be an absolute socket path")
        return
    }
    listener: net.unix_listen(path) ?? {
        print("listen failed: {err}")
        return
    }
    modes: [FakeMode]{.UsTable, .Keymap}
    loop mode in modes {
        server: task { fake_serve(listener, mode) }
        client(mode_name(mode))
        f: server.join() ?? panic("compositor task failed")
        if f.phase != 6 -> print("  FAIL the script stopped at phase {f.phase}")
        loop line in f.report -> print("  {line}")
        loop failure in f.failures -> print("  FAIL {failure}")
    }
}
