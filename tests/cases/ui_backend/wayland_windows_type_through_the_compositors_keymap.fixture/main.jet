package: {
    name: "wayland_windows_type_through_the_compositors_keymap"
    authority: { allow: [Env, IO, Net, Time] }
}
use {
    net: core.net
    sys: core.sys
    time: core.time
    ui: core.ui
}

// A fake Wayland compositor on $WAYLAND_DISPLAY types into a `ui.open`
// window through a wl_keyboard. Before any keymap the window reads keys on
// a US layout. Then the compositor sends its XKB keymap (us and de, two
// groups) through a shared-memory descriptor, and the window types through
// it: the layout group, Shift, AltGr (level three) and a dead key composed
// with the next letter follow the compositor's wl_keyboard.modifiers. At
// wl_keyboard.repeat_info's rate 0 nothing repeats; otherwise a held key
// repeats after the delay and stops when released, and a held modifier
// never repeats.

KEYMAP: #run embed_file("us_de.xkb")

// One scripted step: events to send once the window has committed twice
// since the step before, and how long to wait after them.
FakeStep: struct {
    keys: [[Int]]
    wait_ms: Int
}

Fake: struct {
    stream: net.UnixStream
    inbox: [U8]
    out: [U8]
    registry: Int
    compositor: Int
    shm: Int
    wm_base: Int
    seat: Int
    keyboard: Int
    surface: Int
    xdg_surface: Int
    toplevel: Int
    pools: [Int]
    fds: [sys.Fd]
    // Content surface state: pending, then current at commit.
    attached: Int
    current: Int
    callbacks: [Int]
    serial: Int
    configured: Bool
    // Script state: the next step, the commit it waits for and the time
    // (in ms since `clock`) before which it waits.
    clock: time.Instant
    steps: [FakeStep]
    step: Int
    commits: Int
    due_commit: Int
    due_ms: Int
    closed: Bool
    failures: [String]
}

GLOBALS: [String]{"wl_compositor", "wl_shm", "xdg_wm_base", "wl_seat"}

// Script words: a kind, then its arguments.
KEY: 0
MODS: 1
MAP: 2
REPEAT: 3
ENTER: 4
CLOSE: 5

fake_put: fn(&out: [U8], value: Int) {
    v: value.bit_and(4294967295)
    out.push(U8{v.bit_and(255)})
    out.push(U8{(v >> 8).bit_and(255)})
    out.push(U8{(v >> 16).bit_and(255)})
    out.push(U8{(v >> 24).bit_and(255)})
}

fake_words: fn(values: [Int]) -> [U8] {
    out := [U8]{}
    loop value in values -> fake_put(out, value)
    out
}

fake_u32: fn(bytes: [U8], at: Int) -> Int {
    if at + 4 > bytes.len() -> return 0
    Int.from_u8(bytes[at]) + (Int.from_u8(bytes[at + 1]) << 8) + (Int.from_u8(bytes[at + 2]) << 16) + (Int.from_u8(bytes[at + 3]) << 24)
}

fake_text: fn(text: String) -> [U8] {
    out := [U8]{}
    bytes: text.bytes()
    fake_put(out, bytes.len() + 1)
    loop b in bytes -> out.push(b)
    out.push(U8{0})
    loop out.len() %% 4 != 0 -> out.push(U8{0})
    out
}

fake_string: fn(bytes: [U8], at: Int) -> String {
    length: fake_u32(bytes, at)
    if length <= 1 || at + 4 + length > bytes.len() -> return ""
    String.from_bytes(bytes[(at + 4)..<(at + 3 + length)]) ?? ""
}

fake_event: fn(&f: Fake, object: Int, opcode: Int, args: [U8]) {
    fake_put(f.out, object)
    fake_put(f.out, ((args.len() + 8) << 16) + opcode)
    loop b in args -> f.out.push(b)
}

fake_flush: fn(&f: Fake) -[Net, Time]> {
    if f.out.len() == 0 -> return
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{}) ?? {
        if !f.closed -> f.failures.push("send failed: {err}")
        return
    }
}

fake_fail: fn(&f: Fake, message: String) {
    if f.failures.len() < 8 -> f.failures.push("step {f.step}: {message}")
}

// Milliseconds since the compositor started.
fake_now: fn(f: Fake) -[Time]> Int { f.clock.elapsed_millis() }

// The keymap rides with its wl_keyboard.keymap event in one message: the
// text and its NUL in sealed shared memory, format 1 (XKB text v1).
fake_keymap: fn(&f: Fake) -[Env, Net, Time]> {
    fake_flush(f)
    bytes := KEYMAP.bytes().copy()
    bytes.push(U8{0})
    size: Int(1..1073741824).from_int(bytes.len()) ?? {
        fake_fail(f, "keymap of {bytes.len()} bytes")
        return
    }
    memory := sys.shared_memory(size) ?? {
        fake_fail(f, "keymap memory: {err}")
        return
    }
    memory.write(0, bytes) ?? {
        fake_fail(f, "keymap write: {err}")
        return
    }
    fd: memory.descriptor() ?? {
        fake_fail(f, "keymap descriptor: {err}")
        return
    }
    keyboard: f.keyboard
    fake_event(f, keyboard, 0, fake_words([Int]{1, bytes.len()}))
    out: f.out.copy()
    f.out = [U8]{}
    net.unix_send(f.stream, out, [sys.Fd]{fd}) ?? {
        fake_fail(f, "keymap send failed: {err}")
        return
    }
}

// Sends one scripted event.
fake_send: fn(&f: Fake, words: [Int]) -[Env, Net, Time]> {
    keyboard: f.keyboard
    f.serial += 1
    kind: words[0]
    if kind == KEY -> fake_event(f, keyboard, 3, fake_words([Int]{f.serial, 1000 + f.serial, words[1], words[2]}))
    if kind == MODS -> fake_event(f, keyboard, 4, fake_words([Int]{f.serial, words[1], words[2], words[3], words[4]}))
    if kind == MAP -> fake_keymap(f)
    if kind == REPEAT -> fake_event(f, keyboard, 5, fake_words([Int]{words[1], words[2]}))
    if kind == ENTER {
        surface: f.surface
        fake_event(f, keyboard, 1, fake_words([Int]{f.serial, surface, 0}))
    }
    if kind == CLOSE {
        toplevel: f.toplevel
        f.closed = true
        fake_event(f, toplevel, 1, [U8]{})
    }
}

// Runs the next step once its commit and time have come.
fake_script: fn(&f: Fake) -[Env, Net, Time]> {
    if f.step >= f.steps.len() || f.commits < f.due_commit || fake_now(f) < f.due_ms -> return
    step: f.steps[f.step].copy()
    loop words in step.keys -> fake_send(f, words)
    f.step += 1
    f.due_commit = f.commits + 2
    f.due_ms = fake_now(f) + step.wait_ms
}

fake_commit: fn(&f: Fake) -[Env, Net, Time]> {
    f.commits += 1
    if f.attached != 0 {
        previous: f.current
        f.current = f.attached
        f.attached = 0
        if previous != 0 && previous != f.current -> fake_event(f, previous, 0, [U8]{})
    }
    callbacks: f.callbacks.copy()
    f.callbacks = [Int]{}
    loop id in callbacks -> fake_event(f, id, 0, fake_words([Int]{f.commits}))
    if f.current != 0 -> fake_script(f)
}

fake_request: fn(&f: Fake, object: Int, opcode: Int, body: [U8]) -[Env, Net, Time]> {
    if object == 1 && opcode == 1 {
        f.registry = fake_u32(body, 0)
        registry: f.registry
        loop (index, interface) in GLOBALS {
            args := fake_words([Int]{index + 1})
            loop b in fake_text(interface) -> args.push(b)
            version: if interface == "wl_compositor" -> 6 else if interface == "wl_seat" -> 5 else if interface == "xdg_wm_base" -> 2 else -> 1
            fake_put(args, version)
            fake_event(f, registry, 0, args)
        }
        return
    }
    if object == 1 && opcode == 0 {
        fake_event(f, fake_u32(body, 0), 0, fake_words([Int]{0}))
        return
    }
    if object == f.registry && opcode == 0 {
        name: fake_u32(body, 0)
        interface: fake_string(body, 4)
        length: fake_u32(body, 4)
        id: fake_u32(body, 8 + ((length + 3) /% 4) * 4 + 4)
        if name < 1 || name > GLOBALS.len() || GLOBALS[name - 1] != interface -> fake_fail(f, "bound global {name} as {interface}")
        if interface == "wl_compositor" -> f.compositor = id
        if interface == "wl_shm" {
            f.shm = id
            fake_event(f, id, 0, fake_words([Int]{1}))
        }
        if interface == "xdg_wm_base" -> f.wm_base = id
        if interface == "wl_seat" {
            f.seat = id
            // capabilities: a keyboard.
            fake_event(f, id, 0, fake_words([Int]{2}))
        }
        return
    }
    if object == f.compositor && opcode == 0 {
        f.surface = fake_u32(body, 0)
        return
    }
    if object == f.shm && opcode == 0 {
        f.pools.push(fake_u32(body, 0))
        return
    }
    if object == f.wm_base && opcode == 2 {
        f.xdg_surface = fake_u32(body, 0)
        return
    }
    if object == f.xdg_surface && opcode == 1 {
        f.toplevel = fake_u32(body, 0)
        return
    }
    if object == f.seat && opcode == 1 {
        f.keyboard = fake_u32(body, 0)
        return
    }
    if object == f.seat && opcode != 1 {
        fake_fail(f, "seat request {opcode}: only the keyboard was offered")
        return
    }
    if object == f.surface {
        if opcode == 1 -> f.attached = fake_u32(body, 0)
        if opcode == 3 -> f.callbacks.push(fake_u32(body, 0))
        if opcode == 6 {
            if !f.configured {
                // The initial commit: the first configure, activated.
                f.configured = true
                f.serial += 1
                toplevel: f.toplevel
                xdg_surface: f.xdg_surface
                fake_event(f, toplevel, 0, fake_words([Int]{200, 100, 4, 4}))
                fake_event(f, xdg_surface, 0, fake_words([Int]{f.serial}))
                return
            }
            fake_commit(f)
        }
    }
}

fake_dispatch: fn(&f: Fake) -[Env, Net, Time]> {
    at := 0
    loop f.inbox.len() - at >= 8 {
        object: fake_u32(f.inbox, at)
        word: fake_u32(f.inbox, at + 4)
        size: word >> 16
        if size < 8 {
            fake_fail(f, "malformed request header")
            f.inbox = [U8]{}
            return
        }
        if f.inbox.len() - at < size -> break
        body: f.inbox[(at + 8)..<(at + size)].copy()
        fake_request(f, object, word.bit_and(65535), body)
        at += size
    }
    if at > 0 -> f.inbox = f.inbox[at..<f.inbox.len()].copy()
}

// Accepts one window and serves it until it disconnects.
fake_serve: fn(listener: net.UnixListener, steps: [FakeStep]) -[Env, Net, Time, IO]> Fake {
    stream: net.unix_accept(listener) ?? panic("accept: {err}")
    f := Fake{
        stream: stream, inbox: [U8]{}, out: [U8]{}, registry: 0, compositor: 0, shm: 0, wm_base: 0,
        seat: 0, keyboard: 0, surface: 0, xdg_surface: 0, toplevel: 0, pools: [Int]{}, fds: [sys.Fd]{},
        attached: 0, current: 0, callbacks: [Int]{}, serial: 0, configured: false,
        clock: time.instant(), steps: steps, step: 0, commits: 0, due_commit: 0, due_ms: 0, closed: false, failures: [String]{},
    }
    idle := 0
    loop idle < 40 {
        ready: net.unix_wait(f.stream, 50000000) ?? {
            f.failures.push("wait failed: {err}")
            return f
        }
        if !ready {
            idle += 1
            next
        }
        idle = 0
        message: net.unix_receive(f.stream, 65536) ?? {
            if !f.closed -> f.failures.push("receive failed: {err}")
            return f
        }
        if message.bytes.len() == 0 -> return f
        loop fd in message.fds.move() -> f.fds.push(fd)
        loop b in message.bytes -> f.inbox.push(b)
        fake_dispatch(f)
        fake_flush(f)
    }
    f.failures.push("the window went quiet")
    f
}

// Each key event the window reports, one line each; a held key's repeats
// are counted, not printed, and its release says whether it repeated.
client: fn() -[Env, IO, Net, Time]> {
    window: ui.open(width: 200, height: 100, title: "keys") ?? {
        print("open failed: {err}")
        return
    }
    // The key down and not yet up, by name; "" when none is.
    held := ""
    held_text := ""
    repeats := 0
    after_repeat := false
    loop frame in window.frames() {
        closed := false
        loop event in frame.events() {
            if event == .Close -> closed = true
            if event == .Focus(focused) -> print("focus {focused}")
            if event == .KeyDown(key) {
                name: "{key}"
                if held == name {
                    repeats += 1
                    after_repeat = true
                } else {
                    print("down {key}")
                    held = name
                    repeats = 0
                    after_repeat = false
                }
            }
            if event == .Text(text) {
                if after_repeat && text == held_text {
                    after_repeat = false
                } else {
                    print("text {text}")
                    held_text = text
                }
            }
            if event == .KeyUp(key) {
                if repeats > 0 -> print("up {key}, repeated while held") else -> print("up {key}")
                held = ""
                repeats = 0
                after_repeat = false
            }
        }
        if closed -> break
        pixels := [U8]{}
        count := frame.width * frame.height * 4
        loop count > 0 {
            pixels.push(U8{255})
            count -= 1
        }
        frame.present(pixels) ?? {
            print("present failed: {err}")
            return
        }
    }
    if window.failure() == .Val(failure) -> print("failed: {failure}")
    print("closed")
}

// wl_keyboard.key events: state 1 pressed, 0 released.
key_down: fn(code: Int) -> [Int] { [Int]{KEY, code, 1} }
key_up: fn(code: Int) -> [Int] { [Int]{KEY, code, 0} }

// evdev codes: 13 = (us) / dead acute (de), 16 q, 18 e, 30 a, 42 left
// Shift, 44 z (us) / y (de).
script: fn() -> [FakeStep] {
    [FakeStep]{
        // No keymap yet: the US table.
        FakeStep{keys: [[Int]]{[Int]{ENTER}, key_down(44), key_up(44)}, wait_ms: 0},
        // The keymap, no repeat; z in group 1 (us), then group 2 (de).
        FakeStep{keys: [[Int]]{[Int]{MAP}, [Int]{REPEAT, 0, 0}, key_down(44), key_up(44), [Int]{MODS, 0, 0, 0, 1}}, wait_ms: 0},
        FakeStep{keys: [[Int]]{key_down(44), key_up(44)}, wait_ms: 0},
        // Shift (mask 1), AltGr (LevelThree on Mod5, 128) with q.
        FakeStep{keys: [[Int]]{[Int]{MODS, 1, 0, 0, 1}, key_down(44), key_up(44), [Int]{MODS, 128, 0, 0, 1}, key_down(16), key_up(16), [Int]{MODS, 0, 0, 0, 1}}, wait_ms: 0},
        // Dead acute, then e.
        FakeStep{keys: [[Int]]{key_down(13), key_up(13), key_down(18), key_up(18)}, wait_ms: 0},
        // At rate 0 a held a never repeats.
        FakeStep{keys: [[Int]]{key_down(30)}, wait_ms: 300},
        FakeStep{keys: [[Int]]{key_up(30)}, wait_ms: 0},
        // Repeat 20 a second after 150 ms: a held 400 ms repeats.
        FakeStep{keys: [[Int]]{[Int]{REPEAT, 20, 150}, key_down(30)}, wait_ms: 400},
        // Released, it stops; a held Shift does not repeat.
        FakeStep{keys: [[Int]]{key_up(30), key_down(42), [Int]{MODS, 1, 0, 0, 1}}, wait_ms: 400},
        FakeStep{keys: [[Int]]{key_up(42), [Int]{MODS, 0, 0, 0, 1}}, wait_ms: 300},
        FakeStep{keys: [[Int]]{[Int]{CLOSE}}, wait_ms: 0},
    }
}

run: fn() {
    path: sys.get("WAYLAND_DISPLAY") ?? ""
    if !path.starts_with("/") {
        print("WAYLAND_DISPLAY must be an absolute socket path")
        return
    }
    listener: net.unix_listen(path) ?? {
        print("listen failed: {err}")
        return
    }
    server: task { fake_serve(listener, script()) }
    client()
    f: server.join() ?? panic("compositor task failed")
    if f.step != f.steps.len() -> print("FAIL the script stopped at step {f.step}")
    loop failure in f.failures -> print("FAIL {failure}")
}
