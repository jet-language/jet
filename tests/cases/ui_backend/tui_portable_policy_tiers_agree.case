# tests/ui_backend.rs::tui_portable_policy_tiers_agree at tests/ui_backend.rs:113; hand-port
# assert_example_cli_tiers_agree_with_package: Examples/features/ui/tui_policy.jet declares its inline package, so the case adds none.
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step release: jet run --release {root}/Examples/features/ui/tui_policy.jet
exit: 0
stdout: = ../../../Examples/features/expected/ui/tui_policy.out # include_str!("../Examples/features/expected/ui/tui_policy.out")
step default: jet run {root}/Examples/features/ui/tui_policy.jet
exit: == release # the tier-agreement harness exit code agrees with release
stdout: == release # the tier-agreement harness output agrees with release
