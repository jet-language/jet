# #6701: native windows copy and paste through the seat's wl_data_device.
# A fake compositor on $WAYLAND_DISPLAY offers a selection as HTML and
# UTF-8 text: the window pastes 6007 bytes of UTF-8 through a pipe. Its
# own 9007-byte copy is offered as all five text types at the focus
# serial, read back without a round trip, and pasted by the compositor
# through a pipe of its own. Another client's image copy cancels the
# window's source and leaves no text; the stale offer is destroyed. A
# headless window keeps a clipboard of its own.
requires: os-name:linux
fixture: wayland_windows_copy_and_paste_through_the_clipboard.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step run: jet run main.jet
exit: 0
stdout: = "headless 0 bytes, then kept\nfocus true\npasted 6007 bytes, as sent: true\nown copy 9007 bytes\nChar(a) after another copy: 0 bytes of text\nclosed\nfirst offer received as text/plain;charset=utf-8\ncopy offers text/plain;charset=utf-8,UTF8_STRING,text/plain,TEXT,STRING\ncopied 9007 bytes, as sent: true\nsource destroyed\nfirst offer destroyed\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "headless 0 bytes, then kept\nfocus true\npasted 6007 bytes, as sent: true\nown copy 9007 bytes\nChar(a) after another copy: 0 bytes of text\nclosed\nfirst offer received as text/plain;charset=utf-8\ncopy offers text/plain;charset=utf-8,UTF8_STRING,text/plain,TEXT,STRING\ncopied 9007 bytes, as sent: true\nsource destroyed\nfirst offer destroyed\n"
stderr: empty
