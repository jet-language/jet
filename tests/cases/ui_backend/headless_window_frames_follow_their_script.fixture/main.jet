package: {
    name: "headless_window_frames"
    version: "0.1.0"
    authority: { allow: [Env, IO, Net, Time] }
}

// A headless window (#6701): frame i carries script[i], one more frame
// carries `.Close` and then the frames end. Each present records the FNV-1a
// checksum of its pixels; pixels of the wrong size are a typed Size error
// and record nothing.
use ui: core.ui

run: fn() {
    window := ui.headless(width: 2, height: 1, script: [[ui.UIEvent]{.KeyDown(.Char('a'))}, [ui.UIEvent]{.Focus(true)}]) ?? panic("headless: {err}")
    cursor := window.frames().iter()
    drain(cursor)
    print(window.checksums())
}

drain: fn(&cursor: ui.FrameCursor) -[Env, IO, Net, Time]> {
    loop {
        frame: cursor.next() ?? break
        show(frame)
    }
}

show: fn(frame: ui.Frame) -[Env, IO, Net, Time]> {
    print("frame {frame.index} {frame.width}x{frame.height}")
    loop event in frame.events() {
        if event == {
            .KeyDown(.Char(c)) -> print("key {c}")
            .Focus(focused) -> print("focus {focused}")
            .Close -> print("close")
            .KeyDown(_) | .KeyUp(_) | .Text(_) | .Compose(_) | .PointerMove(_, _) | .PointerDown(_) | .PointerUp(_) | .Scroll(_, _) | .Resize(_, _) -> print("another event")
        }
    }
    if frame.present([U8]{1, 2, 3}) == {
        .Ok(_) -> print("short pixels accepted")
        .Err(.Size(why)) -> print(why)
        .Err(_) -> print("another error")
    }
    pixels := [U8]{}
    loop _ in 0..<(frame.width * frame.height * 4) -> pixels.push(U8{frame.index + 1})
    frame.present(pixels) ?? panic("present: {err}")
    frame.present_damage(pixels, [ui.UIRect]{ui.UIRect{x: 0, y: 0, width: 1, height: 1}}) ?? panic("present_damage: {err}")
}
