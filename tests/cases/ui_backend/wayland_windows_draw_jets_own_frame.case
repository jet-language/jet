# #6701: Jet's own window frame against a fake compositor on
# $WAYLAND_DISPLAY. The chrome is a subsurface below the content: the
# configure sizes the window title bar included, the chrome adds the
# shadow's margin, the geometry leaves it out and the content's bottom
# corners are cut round. The title moves, opens the window menu and
# shows the default cursor; an edge resizes with its arrow; a finger
# taps the widened maximize button, which squares the frame; the close
# button closes. Server-side decorations, no subcompositor and
# fullscreen leave the content the whole window; fractional scales
# size the chrome through its own viewport.
requires: os:linux
fixture: wayland_windows_draw_jets_own_frame.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: WAYLAND_DISPLAY={work}/wl.sock
step run: jet run main.jet
exit: 0
stdout: = "framed: closed, frames [400x254]\n  chrome placed below the content\n  min size 176x56\n  decoration asked client_side\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [0, 0, 0, 0]\n    chrome 528x428 ARGB8888 at buffer scale 1 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\n  cursor shape 1\n  move at serial 202\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [0, 0, 0, 0]\n    chrome 528x428 ARGB8888 at buffer scale 1 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\n  window menu at 100,-26, serial 204\n  cursor shape 23\n  resize edges 10 at serial 206\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [0, 0, 0, 0]\n    chrome 528x428 ARGB8888 at buffer scale 1 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\n  maximize\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [40, 80, 120, 255]\n    chrome 400x300 ARGB8888 at buffer scale 1 at 0,-46, input 0,0 400x300\n    title bar [241, 237, 237, 255]\n  cursor shape 1\n  the window closed by its close button\nserver side: closed, frames [400x300]\n  chrome placed below the content\n  min size 176x56\n  decoration asked client_side\n  content 400x300 ABGR8888 at buffer scale 1, geometry unset\n    content centre [40, 80, 120, 255], bottom-left [40, 80, 120, 255]\n    chrome none\nno decoration manager: closed, frames [400x254]\n  chrome placed below the content\n  min size 176x56\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [0, 0, 0, 0]\n    chrome 528x428 ARGB8888 at buffer scale 1 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\nno subcompositor: closed, frames [400x300]\n  decoration asked server_side\n  content 400x300 XRGB8888 at buffer scale 1, geometry unset\n    content centre [120, 80, 40, 255], bottom-left [120, 80, 40, 255]\n    chrome none\nfullscreen: closed, frames [400x300, 400x254]\n  chrome placed below the content\n  min size 176x56\n  decoration asked client_side\n  content 400x300 ABGR8888 at buffer scale 1, geometry unset\n    content centre [40, 80, 120, 255], bottom-left [40, 80, 120, 255]\n    chrome none\n  content 400x254 ABGR8888 at buffer scale 1, geometry 0,-46 400x300\n    content centre [40, 80, 120, 255], bottom-left [0, 0, 0, 0]\n    chrome 528x428 ARGB8888 at buffer scale 1 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\nfractional: closed, frames [600x381]\n  chrome placed below the content\n  min size 176x56\n  decoration asked client_side\n  content 600x381 ARGB8888 on 400x254, geometry 0,-46 400x300\n    content centre [120, 80, 40, 255], bottom-left [0, 0, 0, 0]\n    chrome 792x642 ARGB8888 on 528x428 at -64,-110, input 56,56 416x316\n    title bar [241, 237, 237, 255]\n    shadow soft true\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
