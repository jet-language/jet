use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

consume_lock: fn(&&l: FileLock) -[FS]> Int {
    held()
}

lock_byte: fn(&&l: FileLock) -[FS]> U8 {
    U8.from_int(held()) ?? 0
}

// `U8.from_int(n) ?? …` builds as a range test (no Result is made). A value
// fallback moves the lock only where `n` does not fit: where it fits, the
// parameter still owns the lock, which closes as this returns.
value_fallback: fn(&&l: FileLock, n: Int) -[FS]> Int {
    small := U8.from_int(n) ?? lock_byte(l.move())
    Int.from_u8(small) + held()
}

// A `?? return` fallback is the same: it moves the lock on the leaving path.
return_fallback: fn(&&l: FileLock, n: Int) -[FS]> Int {
    small := U8.from_int(n) ?? return consume_lock(l.move())
    Int.from_u8(small) + held()
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b", "c", "d"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    fits_value: value_fallback(lock("a.lk"), 10)
    print("value fallback, fits {fits_value} {held()}")
    over_value: value_fallback(lock("b.lk"), 300)
    print("value fallback, does not fit {over_value} {held()}")
    fits_return: return_fallback(lock("c.lk"), 20)
    print("return fallback, fits {fits_return} {held()}")
    over_return: return_fallback(lock("d.lk"), -1)
    print("return fallback, does not fit {over_return} {held()}")
}
