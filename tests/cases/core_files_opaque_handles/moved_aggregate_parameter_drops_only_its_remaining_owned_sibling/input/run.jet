package: { name: "run", authority: { allow: [FS, FS.Read, FS.Write] } }
use files: core.files

Pair: struct { left: files.TempFile, right: files.TempFile }

consume: fn(pair: &&Pair) -> String {
    left: pair.left.path
    sibling: pair.right.path
    close(pair.left)
    print(!files.exists(left))
    print(files.exists(sibling))
    sibling
}

run: fn() {
    pair := Pair{
        left: files.temp_file("parameter-left") ?? panic("left"),
        right: files.temp_file("parameter-right") ?? panic("right")
    }
    sibling: consume(pair)
    print(!files.exists(sibling))
}
