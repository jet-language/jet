use files: core.files
use process: core.process

held: fn(slot: Int) -[FS]> Bool {
    name: "{slot}"
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        if entry.name == name -> return true
    }
    false
}

// A spec that already keeps a directory, chained into a second keep: the
// second spec takes the first one's row, so both slots reach the child and
// each descriptor closes once, when the last spec ends.
chained: fn(round: Int) -[IO, FS, Exec, Env]> {
    first_directory: files.open_directory(".") ?? panic("open . for 300")
    second_directory: files.open_directory(".") ?? panic("open . for 301")
    first: process.cmd(["sh", "-c", "test -d /dev/fd/300 && test -d /dev/fd/301 && echo child sees 300 and 301"]).keep_open(first_directory, at: 300)
    second: first.keep_open(second_directory, at: 301)
    receipt: second.stdout(.Capture).run() ?? panic("run")
    print("round {round}: {receipt.output.trim()}")
}

round: fn(n: Int) -[IO, FS, Exec, Env]> {
    chained(n)
    print("round {n}: parent holds 300 {held(300)}, 301 {held(301)}")
}

// Each round keeps both slots again; the parent holds neither after a round.
run: fn() -[IO, FS, Exec, Env]> {
    round(1)
    round(2)
}
