use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

Holder: struct {
    note: String
    lock: FileLock

    // Owns self: its lock closes when this returns.
    finish: fn(&&self) -[FS]> Int {
        held()
    }
}

Outer: struct {
    name: String
    owner: Holder
    spare: FileLock
}

consume_holder: fn(&&h: Holder) -[FS]> Int {
    held()
}

consume_lock: fn(&&l: FileLock) -[FS]> Int {
    held()
}

Count: struct {
    n: Int
}

// A Close owner with no clone glue (its FileReader has none) that also shares
// a cell: moved out of its holder, it still ends its lock and reader at its
// consumer.
Guard: struct {
    lock: FileLock
    marker: FileReader
    state: Shared<Count>

    impl Close {
        close: fn(&&self) {}
    }

    finish: fn(&&self) -[FS]> Int {
        held()
    }
}

Prepared: struct {
    note: String
    guard: Guard
}

prepared: fn(name: String) -[FS, Env]> Prepared {
    Prepared{note: name, guard: Guard{lock: lock("{name}.lk"), marker: files.open("{name}-marker.lk") ?? panic("open {name}-marker"), state: shared Count{n: 1}}}
}

// A consumed receiver with no clone glue rebound to a local moves there: the
// local is its only owner, so clearing its optional Guard ends the lock and
// the reader at once, not at the receiver's scope end.
Lease: struct {
    note: String
    live: Guard?

    release: fn(&&self) -[IO, FS]> {
        lease := self
        before: held()
        lease.live = None
        print("rebound release {before} {held()}")
    }
}

outer: fn(name: String) -[FS, Env]> Outer {
    Outer{name: name, owner: Holder{note: name, lock: lock("{name}-owner.lk")}, spare: lock("{name}-spare.lk")}
}

receiver: fn() -[IO, FS, Env]> {
    h: Holder{note: "a", lock: lock("a.lk")}
    inside: h.finish()
    print("receiver {inside} {held()}")
}

member_receiver: fn() -[IO, FS, Env]> {
    o: outer("b")
    inside: o.owner.finish()
    print("member receiver {inside} {held()}")
}

member_argument: fn() -[IO, FS, Env]> {
    o := outer("c")
    inside: consume_holder(o.owner.move())
    print("member argument {inside} {held()}")
    close(o.spare)
    print("member close {held()}")
    o.spare = lock("c-again.lk")
    print("member reinitialized {held()}")
}

branch: fn(moved: Bool) -[IO, FS, Env]> {
    o := outer("d")
    if moved {
        close(o.spare)
    }
    print("branch {moved} {held()}")
}

adopt: fn(&&h: Holder) -[IO, FS]> {
    me := h.move()
    inside: consume_holder(me)
    print("adopted {inside} {held()}")
}

whole_lock: fn() -[IO, FS, Env]> {
    l: lock("e.lk")
    inside: consume_lock(l)
    print("whole lock {inside} {held()}")
}

guard_close: fn() -[IO, FS, Env]> {
    p: prepared("g")
    before: held()
    close(p.guard.move())
    print("guard close {before} {held()}")
}

guard_receiver: fn() -[IO, FS, Env]> {
    p: prepared("h")
    inside: p.guard.finish()
    print("guard receiver {inside} {held()}")
}

rebound_receiver: fn() -[IO, FS, Env]> {
    p: prepared("i")
    lease: Lease{note: "i", live: Val(p.guard.move())}
    lease.release()
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b-owner", "b-spare", "c-owner", "c-spare", "c-again", "d-owner", "d-spare", "e", "f", "g", "g-marker", "h", "h-marker", "i", "i-marker"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    receiver()
    print("after {held()}")
    member_receiver()
    print("after {held()}")
    member_argument()
    print("after {held()}")
    branch(true)
    print("after {held()}")
    branch(false)
    print("after {held()}")
    adopt(Holder{note: "f", lock: lock("f.lk")})
    print("after {held()}")
    whole_lock()
    print("after {held()}")
    guard_close()
    print("after {held()}")
    guard_receiver()
    print("after {held()}")
    rebound_receiver()
    print("after {held()}")
}
