# Directory.pass_to, kept only for CacheLease: the child
# sees the directory at the chosen slot, the parent's handle still lists, and
# a standard stream slot is IOError.InvalidInput.
fixture: directory_pass_to_keeps_the_parent_handle_and_refuses_stdio_slots.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run -O0 main.jet
exit: 0
stdout: = directory_pass_to_keeps_the_parent_handle_and_refuses_stdio_slots.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = directory_pass_to_keeps_the_parent_handle_and_refuses_stdio_slots.out
