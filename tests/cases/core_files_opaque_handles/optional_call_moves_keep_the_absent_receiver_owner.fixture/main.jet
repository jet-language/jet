use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

Counter: struct {
    base: Int

    claim: fn(self, &&l: FileLock) -[FS]> Int {
        self.base + held()
    }
}

// `c?.claim(…)` calls only on a present receiver: where `c` is absent the
// argument's owner still holds the lock, which closes as this returns.
optional_call: fn(&&l: FileLock, c: Counter?) -[FS]> Int {
    value: c?.claim(l.move())
    value ?? 0
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    present: optional_call(lock("a.lk"), Val(Counter{base: 10}))
    print("optional call, present {present} {held()}")
    absent: optional_call(lock("b.lk"), None)
    print("optional call, absent {absent} {held()}")
}
