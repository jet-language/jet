use files: core.files
use process: core.process

// `directory.duplicate()` is a fresh handle to the same directory: the spec
// takes the duplicate, and the parent's original stays open and usable
// before the child runs, after it ends and after the path is replaced.
run: fn() -[IO, FS, Exec, Env]> {
    scratch: files.temp_dir("duplicate-directory") ?? panic("scratch")
    root: scratch.path
    held_path: files.join(root, "held")
    files.create_dir_all(held_path) ?? panic("held")
    files.write(files.join(held_path, "marker.txt"), "held\n") ?? panic("marker")
    original: files.open_directory(held_path) ?? panic("open directory")
    twin: original.duplicate() ?? panic("duplicate")
    spec: process.cmd(["sh", "-c", "cat /proc/self/fd/9/marker.txt"]).keep_open(twin, at: 9)
    files.rename(held_path, files.join(root, "moved")) ?? panic("rename")
    files.create_dir_all(held_path) ?? panic("replacement")
    files.write(files.join(held_path, "marker.txt"), "replacement\n") ?? panic("replacement marker")
    receipt: spec.run() ?? panic("run")
    print("child read: {receipt.output.trim()}")
    names := [String]{}
    entries: original.list() ?? panic("list the original")
    loop entry in entries -> names.push(entry.name)
    print("parent lists: {names.join(", ")}")
    after := original.create("after.txt") ?? panic("create through the original")
    after.write_line("after") ?? panic("write through the original")
    print("parent wrote after the child: {files.exists(files.join(files.join(root, "moved"), "after.txt"))}")
}
