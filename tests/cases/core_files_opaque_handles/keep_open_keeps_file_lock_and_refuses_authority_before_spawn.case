# ProcessSpec.keep_open of a FileLock (#6677 phase 2): the child's descriptor
# names the lock file and the lock is free again once the spec is gone; an
# authority-bound spec that keeps a handle is refused when it plans. That
# spec starts no child on any tier.
fixture: keep_open_keeps_file_lock_and_refuses_authority_before_spawn.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run --optimize=none main.jet
exit: 0
stdout: = keep_open_keeps_file_lock_and_refuses_authority_before_spawn.out
file: started absent
step: jet run --optimize=full main.jet
exit: 0
stdout: = keep_open_keeps_file_lock_and_refuses_authority_before_spawn.out
file: started absent
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = keep_open_keeps_file_lock_and_refuses_authority_before_spawn.out
file: started absent
