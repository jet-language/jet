use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

consume_lock: fn(&&l: FileLock) -[FS]> Int {
    held()
}

// A stop's message runs only where the check fails: where it holds, the
// parameter still owns the lock, which closes as this returns.
assert_message: fn(&&l: FileLock, n: Int) -[FS]> Int {
    assert(n > 0, "{consume_lock(l.move())}")
    n
}

#Pre(n > 0, "{consume_lock(l.move())}")
pre_message: fn(&&l: FileLock, n: Int) -[FS]> Int {
    n
}

#Post(n > 0, "{consume_lock(l.move())}")
post_message: fn(&&l: FileLock, n: Int) -[FS]> Int {
    n
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b", "c"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    asserted: assert_message(lock("a.lk"), 3)
    print("assert message {asserted} {held()}")
    pre: pre_message(lock("b.lk"), 4)
    print("pre message {pre} {held()}")
    post: post_message(lock("c.lk"), 5)
    print("post message {post} {held()}")
}
