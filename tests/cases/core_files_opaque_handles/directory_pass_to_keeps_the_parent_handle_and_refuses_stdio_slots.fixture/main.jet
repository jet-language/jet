use files: core.files
use process: core.process

// `directory.pass_to(spec, at)` is kept only for CacheLease until it moves to
// `spec.keep_open(directory.duplicate())`: the child gets a
// duplicate at `at`, the parent's handle stays usable, and a standard
// stream slot is refused.
run: fn() -[IO, FS, Exec, Env]> {
    directory: files.open_directory(".") ?? panic("open .")
    spec: directory.pass_to(process.cmd(["sh", "-c", "test -d /proc/self/fd/9 && echo child sees 9"]), 9) ?? panic("pass")
    receipt: spec.run() ?? panic("run")
    print(receipt.output.trim())
    entries: directory.list() ?? panic("list after pass")
    print("parent still lists: {entries.len() > 0}")
    if directory.pass_to(process.cmd(["true"]), 2) == {
        .Ok(_) -> print("stdio slot: passed")
        .Err(error) -> print("stdio slot: {error == .InvalidInput(_)}")
    }
}
