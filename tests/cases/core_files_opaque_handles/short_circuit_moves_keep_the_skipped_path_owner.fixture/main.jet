use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

consume_lock: fn(&&l: FileLock) -[FS]> Int {
    held()
}

// The right side of `&&` runs only where `flag` holds: where it does not,
// the parameter still owns the lock, which closes as this returns.
and_move: fn(&&l: FileLock, flag: Bool) -[FS]> Int {
    taken: flag && consume_lock(l.move()) > 0
    if taken -> 1 else -> 0
}

// The right side of `||` runs only where `flag` fails.
or_move: fn(&&l: FileLock, flag: Bool) -[FS]> Int {
    taken: flag || consume_lock(l.move()) > 0
    if taken -> 1 else -> 0
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b", "c", "d"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    and_true: and_move(lock("a.lk"), true)
    print("and, right side runs {and_true} {held()}")
    and_false: and_move(lock("b.lk"), false)
    print("and, right side skipped {and_false} {held()}")
    or_true: or_move(lock("c.lk"), true)
    print("or, right side skipped {or_true} {held()}")
    or_false: or_move(lock("d.lk"), false)
    print("or, right side runs {or_false} {held()}")
}
