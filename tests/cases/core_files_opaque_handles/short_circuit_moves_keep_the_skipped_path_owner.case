# A `&&` or `||` whose right side moves an owner moves it only where that
# side runs: where the left side decides, the owner still ends its lock at
# its scope end, so every lock descriptor closes once and none leaks.
fixture: short_circuit_moves_keep_the_skipped_path_owner.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = short_circuit_moves_keep_the_skipped_path_owner.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = short_circuit_moves_keep_the_skipped_path_owner.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = short_circuit_moves_keep_the_skipped_path_owner.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = short_circuit_moves_keep_the_skipped_path_owner.out
