# Only the selected arm of a readiness table runs: an owner another arm
# moves still ends its lock at its scope end, whichever arm order, so every
# lock descriptor closes once and none leaks.
fixture: readiness_arm_moves_keep_the_other_arm_owner.fixture
env: NO_COLOR=1
step: jet run --optimize=none main.jet
exit: 0
stdout: = readiness_arm_moves_keep_the_other_arm_owner.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = readiness_arm_moves_keep_the_other_arm_owner.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = readiness_arm_moves_keep_the_other_arm_owner.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = readiness_arm_moves_keep_the_other_arm_owner.out
