use files: core.files

// Lock descriptors this process holds open (fds whose target ends `.lk`).
held: fn() -[FS]> Int {
    count := 0
    names: files.list_dir("/proc/self/fd") ?? panic("list /proc/self/fd")
    loop entry in names {
        target: files.read_link(entry.path) ?? ""
        if target.ends_with(".lk") -> count += 1
    }
    count
}

lock: fn(name: String) -[FS, Env]> FileLock {
    files.lock(name) ?? panic("lock {name}")
}

consume_lock: fn(&&l: FileLock) -[FS]> Int {
    held()
}

// `n ?? return …` moves the lock only where `n` is absent: where it is
// present the parameter still owns the lock, which closes as this returns.
return_fallback: fn(&&l: FileLock, n: Int?) -[FS]> Int {
    value := n ?? return consume_lock(l.move())
    value + held()
}

// The guard `if n == None -> return …` is the same refinement.
none_guard: fn(&&l: FileLock, n: Int?) -[FS]> Int {
    if n == None -> return consume_lock(l.move())
    n + held()
}

// A value fallback moves the lock on one path only: the other path's owner
// still ends it at the scope end.
value_fallback: fn(&&l: FileLock, n: Int?) -[FS]> Int {
    value := n ?? consume_lock(l.move())
    value
}

run: fn() -[IO, FS, Env]> {
    loop name in ["a", "b", "c", "d", "e", "f"] {
        files.write("{name}.lk", "") ?? panic("write {name}")
    }
    present_return: return_fallback(lock("a.lk"), Val(10))
    print("return fallback, present {present_return} {held()}")
    absent_return: return_fallback(lock("b.lk"), None)
    print("return fallback, absent {absent_return} {held()}")
    present_guard: none_guard(lock("c.lk"), Val(10))
    print("none guard, present {present_guard} {held()}")
    absent_guard: none_guard(lock("d.lk"), None)
    print("none guard, absent {absent_guard} {held()}")
    present_value: value_fallback(lock("e.lk"), Val(10))
    print("value fallback, present {present_value} {held()}")
    absent_value: value_fallback(lock("f.lk"), None)
    print("value fallback, absent {absent_value} {held()}")
}
