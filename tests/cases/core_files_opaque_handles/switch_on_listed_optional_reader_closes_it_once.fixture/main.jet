use files: core.files

Member: struct {
    name: String
    file: FileReader?
}

// The match form over a borrowed element's optional handle (#6590): the
// switch's subject aliases the element, so only the List closes the handle.
member_size: fn(members: &[Member], index: Int) -> Int IOError! {
    if &members[index].file == {
        .Val(input) -> {
            info: input.stat()
            Ok(info.size)
        }
        .None -> Ok(-1)
    }
}

// The window's payload passes on to a borrowing parameter, as Jetpack's
// CacheLease.copy_profile_executable does: the value table's subject is
// its generated `it`, which still windows the element.
reader_size: fn(input: &FileReader) -> Int {
    input.stat().size
}

member_size_through: fn(members: &[Member], index: Int) -> Int {
    if &members[index].file == {
        .Val(input) -> reader_size(input)
        .None -> -1
    }
}

// The handle still reads after every match above.
member_bytes: fn(members: &[Member], index: Int) -> Int IOError! {
    total := 0
    if &members[index].file == .Val(input) {
        input.seek(0)
        loop {
            chunk: input.read(65536)
            if chunk.len() == 0 -> break
            total += chunk.len()
        }
    }
    Ok(total)
}

// The same switch over an element of a read List of optional handles.
present: fn(readers: [FileReader?], index: Int) -> Bool {
    if readers[index] == {
        .Val(_) -> true
        .None -> false
    }
}

run: fn() {
    main: files.open("main.jet") ?? panic("open main.jet")
    members := [Member]{Member{name: "main", file: Val(main)}, Member{name: "none", file: None}}
    loop round in 0..<3 {
        size: member_size(members, 0) ?? panic("size")
        absent: member_size(members, 1) ?? panic("size")
        print("round {round}: main has bytes {size > 0}, none {absent}")
    }
    bytes: member_bytes(members, 0) ?? panic("bytes")
    print("through a borrow: {member_size_through(members, 0) == (member_size(members, 0) ?? -2)} {member_size_through(members, 1)}")
    print("read every byte {bytes == (member_size(members, 0) ?? -2)}")
    package: files.open("package.jet") ?? panic("open package.jet")
    readers: [FileReader?]{Val(package), None}
    loop round in 0..<3 -> print("present {present(readers, 0)} {present(readers, 1)}")
    print("done")
}
