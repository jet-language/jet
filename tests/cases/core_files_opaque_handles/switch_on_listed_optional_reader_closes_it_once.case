# A switch over a List element's optional FileReader (#6590), as the
# hoisted `&members[i].file` window and as a plain `readers[i]` read: the
# switch's subject aliases the element instead of owning or closing it, so the
# handle still reads after every match and the List closes it once at the
# end. Before, the program closed it twice and hung at exit.
fixture: switch_on_listed_optional_reader_closes_it_once.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = switch_on_listed_optional_reader_closes_it_once.out
stderr: empty
step: jet run -O1 main.jet
exit: 0
stdout: = switch_on_listed_optional_reader_closes_it_once.out
stderr: empty
step: jet run -O2 main.jet
exit: 0
stdout: = switch_on_listed_optional_reader_closes_it_once.out
stderr: empty
step: jet build --release main.jet
exit: 0
step aot: built
exit: 0
stdout: = switch_on_listed_optional_reader_closes_it_once.out
stderr: empty
