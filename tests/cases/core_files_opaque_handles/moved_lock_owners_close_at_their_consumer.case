# A consumed owner closes its lock where its consumer ends it, never at the
# source's scope end: a `^self` method's receiver, a member moved out
# with `^x.f` (as a receiver, an argument, a close, then reinitialized, and
# on one branch), a `me := ^param` local, a whole handle, a Close owner
# with no clone glue that shares a cell, closed and consumed out of its
# holder, and a consumed receiver rebound to a local whose optional
# Guard is cleared. Every lock descriptor closes once: no leak and no
# second close.
fixture: moved_lock_owners_close_at_their_consumer.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = moved_lock_owners_close_at_their_consumer.out
step: jet run -O1 main.jet
exit: 0
stdout: = moved_lock_owners_close_at_their_consumer.out
step: jet run -O2 main.jet
exit: 0
stdout: = moved_lock_owners_close_at_their_consumer.out
step: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = moved_lock_owners_close_at_their_consumer.out
