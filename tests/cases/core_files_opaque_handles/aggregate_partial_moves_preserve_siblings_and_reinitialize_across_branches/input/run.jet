use core.files as files

struct Pair { left: files.TempFile, right: files.TempFile }
struct Envelope { pair: Pair, sibling: files.TempFile }

struct GenericPair<T, U> {
    first: T
    second: U
}


fn paths(pair: Pair) -> [String] {
    [pair.left.path, pair.right.path]
}

fn generic_partial<U>(value: U) -> Bool {
    pair := GenericPair<U, files.TempFile>{
        first: value,
        second: files.temp_file("generic-partial") ?? panic("generic")
    }
    close(^pair.second)
    true
}


fn exercise(move_first: Bool) -> String {
    pair := Pair{
        left: files.temp_file("partial-left") ?? panic("left"),
        right: files.temp_file("partial-right") ?? panic("right")
    }
    first :: pair.left.path
    sibling :: pair.right.path
    if move_first {
        close(^pair.left)
        print(!files.exists(first))
        print(files.exists(sibling))
        pair.left = files.temp_file("partial-reinitialized") ?? panic("reinitialize")
    } else {
        print(files.exists(first))
        print(files.exists(sibling))
    }
    snapshot :: paths(pair)
    print(snapshot[0] == pair.left.path)
    print(snapshot[1] == sibling)
    close(^pair.left)
    print(!files.exists(snapshot[0]))
    print(files.exists(sibling))
    pair = Pair{
        left: files.temp_file("partial-replacement-left") ?? panic("replace left"),
        right: files.temp_file("partial-replacement-right") ?? panic("replace right")
    }
    print(!files.exists(sibling))
    survivor :: pair.right.path
    close(^pair.left)
    print(files.exists(survivor))
    survivor
}

fn nested() -> [String] {
    outer := Envelope{
        pair: Pair{
            left: files.temp_file("nested-left") ?? panic("left"),
            right: files.temp_file("nested-right") ?? panic("right")
        },
        sibling: files.temp_file("nested-sibling") ?? panic("sibling")
    }
    old_left :: outer.pair.left.path
    right :: outer.pair.right.path
    sibling :: outer.sibling.path
    close(^outer.pair.left)
    print(!files.exists(old_left))
    print(files.exists(right))
    outer.pair.left = files.temp_file("nested-reinitialized") ?? panic("reinitialize")
    snapshot :: paths(outer.pair)
    close(^outer.pair.right)
    print(!files.exists(right))
    print(files.exists(snapshot[0]))
    print(files.exists(sibling))
    [snapshot[0], sibling]
}

fn run() {
    loop move_first in [true, false] {
        survivor :: exercise(move_first)
        print(!files.exists(survivor))
    }
    remaining :: nested()
    generic_value := generic_partial(7)

    print(!files.exists(remaining[0]) && generic_value)
    print(!files.exists(remaining[1]))
}
