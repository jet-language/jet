// tests/jetpack_criterion5.rs14-29,95-118: original algorithm, no assertions here.
// PENDING-SEAM(stat-physical): ratified Stat from held Core3ec4f6b0c.
// Unix provider FileHandles.rs jet_fs_stat_row uses meta.blocks().saturating_mul(512).
// Only runtime measurement, never an expected snapshot; assertions remain in the .case.
use core.files as files
fn s1_criterion_measured_bytes(path: String, seen: &[files.FileID]) -> Int {
    metadata :: files.stat(path) ?? panic("metadata {path}")
    loop id in seen {
        if id.device == metadata.id.device && id.inode == metadata.id.inode -> return 0
    }
    &seen.push(metadata.id)
    total := metadata.size_on_disk
    if metadata.is_dir {
        loop entry in files.read_dir(path) ?? panic("entries {path}") {
            total += s1_criterion_measured_bytes(entry.path, &seen)
        }
    }
    total
}
fn run() {
    payload := ""
    loop entry in files.read_dir("agent-0/hangar/objects") ?? panic("objects") {
        if files.is_dir(entry.path) {
            payload = "{entry.path}/payload"
            break
        }
    }
    links :: (files.stat(payload) ?? panic("payload metadata")).links
    single_seen := [files.FileID]{}
    single_bytes :: s1_criterion_measured_bytes("shared-cas", &single_seen) + s1_criterion_measured_bytes("agent-0/hangar", &single_seen)
    multi_seen := [files.FileID]{}
    multi_bytes := s1_criterion_measured_bytes("shared-cas", &multi_seen)
    loop index in 0..<30 -> multi_bytes += s1_criterion_measured_bytes("agent-{index}/hangar", &multi_seen)
    // Rust u64::saturating_mul(4), not a narrowed Int/i64 bound.
    max_u64 :: 18446744073709551615
    bound :: if single_bytes > max_u64 /% 4 -> max_u64 else -> single_bytes * 4
    print("[{{\"links\":{links},\"single_bytes\":{single_bytes},\"multi_bytes\":{multi_bytes},\"single_bound\":{bound}}}]")
}
