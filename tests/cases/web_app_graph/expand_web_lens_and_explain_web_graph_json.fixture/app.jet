package: {
    name: "browser_route"
    // `serve` reads the port override and serves: its row's effects join the
    // route's Browser, as Examples/Apps/Web/AppHello.jet writes them.
    authority: { allow: [Browser, Env, Net, FS.Read, Time] }
}
use web: core.web
use ui: core.ui
#Target(Web)

// `web.page` renders on the server: `/` reaches no effect and stays static.
home: fn() -> WebPage { web.page("Hello", "world") }

// `ui.mount` paints through the browser scene, so `/greet` reaches Browser and renders on the client.
greet: fn() -> WebPage {
    ui.mount(ui.null_backend(), ui.button("Go"))
    web.page("Greet", "hello")
}

run: fn() {
    web.app()
        .route("/", home)
        .route("/greet", greet)
        .serve()
}
