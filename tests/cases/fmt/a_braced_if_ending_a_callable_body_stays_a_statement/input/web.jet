#Target(Web)
use {
    reactive: core.reactive
    ui: core.ui
}

run: fn() {
    choose_left := reactive.signal(true)
    left := reactive.signal(1)
    right := reactive.signal(10)
    ui.reactive_render(fn() {
        if choose_left.get() { print(left.get()) } else { print(right.get()) }
    })
    choose_left.set(false)
    left.set(2)
    right.set(11)
}
