#[Job(every: 5min), Doc("Prune old sessions")]
prune_sessions: fn() { print("pruning") }

#[Job(every: "03:00"), Doc("Back up nightly")]
nightly_backup: fn() { print("backing up") }

#Job manual_only: fn() { print("manual") }

run: fn() {
    prune_sessions()
    nightly_backup()
    manual_only()
}
