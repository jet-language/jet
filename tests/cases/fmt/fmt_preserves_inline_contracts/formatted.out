#Inline square: fn(x: Int) -> Int { return x * x }

#Inline(Always) double: fn(x: Int) -> Int { return x * 2 }

Meters: struct {
    value: Int

    #Inline(Always) plus: fn(self, other: Int) -> Int { return self.value + other }
}

run: fn() {
    m: Meters{value: 7}
    print("{square(4)} {double(5)} {m.plus(3)}")
}
