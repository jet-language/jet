#Inline fn square(x: Int) -> Int {
    return x * x
}

#Inline(Always) fn double(x: Int) -> Int {
    return x * 2
}

struct Meters {
    value: Int

    #Inline(Always) fn plus(self, other: Int) -> Int {
        return self.value + other
    }
}

fn run() {
    m :: Meters{value: 7}
    print("{square(4)} {double(5)} {m.plus(3)}")
}
