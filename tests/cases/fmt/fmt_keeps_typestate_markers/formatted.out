Reservation: struct {
    state { Pending, Confirmed }

    guest: String

    #Transition(_, Pending) book: fn(guest: String) -> Reservation {
        return Reservation{guest: guest.copy()}
    }

    #Transition(Pending, Confirmed) pay: fn(self: ^Reservation) -> Reservation { return self }

    #State(Confirmed) check_in: fn(self) { print(self.guest) }
}
