Reservation: struct {
    state {
        Pending -> Confirmed
        Confirmed
    }
    guest: String

    book: fn(guest: String) -> Reservation.Pending {
        return Reservation{guest: guest.copy()}
    }

    pay: fn(self: &&Reservation.Pending) -> Reservation.Confirmed {
        return self
    }

    check_in: fn(self: Reservation.Confirmed) {
        print(self.guest)
    }
}
