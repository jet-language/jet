# A braced `if … else` on the last line of a lambda body keeps its braces: the
# parser reads an arrow-form `if` there as the body's value, so arrows would
# change the program, and `jet fmt` refuses a format that changes the syntax
# tree. The inputs are the three sources that format refused.
fixture: a_braced_if_ending_a_callable_body_stays_a_statement/input
step: jet fmt closures.jet reactive.jet web.jet
exit: 0
file: closures.jet = a_braced_if_ending_a_callable_body_stays_a_statement/closures.out
file: reactive.jet = a_braced_if_ending_a_callable_body_stays_a_statement/reactive.out
file: web.jet = a_braced_if_ending_a_callable_body_stays_a_statement/web.out
