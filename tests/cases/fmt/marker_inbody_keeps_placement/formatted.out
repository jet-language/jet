Pixel: struct {
    r: Int
    #Layout: c
    #Equatable: true
}

#Codable
Note: struct {
    text: String
}

Shade: enum {
    Light
    #Debug: false
    Dark
    Dim
}

Shape: trait {
    #MustUse area: fn(self) -> Int
    twice: fn(self) -> Int {
        #Inline: true
        self.area() * 2
    }
}

#Error
ReadErr: enum {
    Missing
}

#Error
AppErr: enum {
    Read(ReadErr)
}

#Deprecated("old")
impl ReadErr -> AppErr { AppErr.Read(self) }

#Deprecated("old")
tools: module {
    sources: { main: "tools.jet" }
}

helpers: module {
    #Deprecated: "old"
    sources: { main: "helpers.jet" }
}

area: fn(pixel: Pixel) -> Int {
    #Inline: true
    doubled: pixel.r * 2
    #Deprecated: "old"
    doubled
}

run: fn() { print(area(Pixel{r: 3})) }
