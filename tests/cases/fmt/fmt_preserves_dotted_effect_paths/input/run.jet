load: fn(path: String) -[FS.Read]> String {
    return path
}

archive: fn(path: String) -[FS.Write]> {
    print(path)
}

read_only: fn(path: String) -[FS.Read, !FS.Write]> {
    load(path)
}

boot: fn() -[FS]> {
    load("app.conf")
    archive("out.tar")
    #FX(Net.HTTP.Get) {
        print("net")
    }
    #FX(authority: FS.Read) {
        load("app.conf")
    }
}
