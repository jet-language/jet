# The formatter keeps the one blank line after a file's leading comment block,
# so the header never merges into the first item's doc comment and marker, or
# into a block comment below it. A second run changes nothing.
fixture: fmt_keeps_the_blank_line_after_a_file_header/input
step: jet fmt run.jet
file: run.jet = fmt_keeps_the_blank_line_after_a_file_header/run.formatted.out
step: jet fmt run.jet
file: run.jet = fmt_keeps_the_blank_line_after_a_file_header/run.formatted.out
step: jet fmt plain.jet
file: plain.jet = fmt_keeps_the_blank_line_after_a_file_header/plain.formatted.out
step: jet fmt plain.jet
file: plain.jet = fmt_keeps_the_blank_line_after_a_file_header/plain.formatted.out
