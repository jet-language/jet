fn run() {
    values :: [
        1,
        2,
        3
    ]
    typed :: [Int]{
        4,
        5,
        6
    }
    lookup :: [
        "a": 1,
        "b": 2
    ]
    point :: (
        x: 7,
        y: 8
    )
    record :: Point{
        x: 9,
        y: 10
    }
    print(values.len() + typed.len() + lookup.len() + point.x + point.y + record.x)
}
