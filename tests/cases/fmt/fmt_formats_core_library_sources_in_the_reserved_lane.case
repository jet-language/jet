# Claim: `jet fmt` formats a source of the toolchain's Core library in the reserved lane, where `__` names belong to the library, while a user source spelling the same name still fails with E0067
fixture: fmt_formats_core_library_sources_in_the_reserved_lane/input
env: NO_COLOR=1
env: JET_TOOLCHAIN_ROOT={work}
step: mkdir -p Compiler/Prelude
exit: 0
step: jet fmt Core/Probe.jet
exit: 0
file: Core/Probe.jet = fmt_formats_core_library_sources_in_the_reserved_lane/formatted.out
step: jet fmt --check Core/Probe.jet
exit: 0
step: jet fmt --check app/user.jet
exit: 1
stderr: ~ "E0067" # the user file is outside Core and Compiler/Prelude, so the reserved-name rule still holds
