# `jet fmt --explicit-failures` writes the `?` that each call under
# `#Policy(failures: .Explicit)` able to pass a failure up is missing, as
# `(call()?)` for a call read as a receiver. The marked file checks clean, and
# a plain format keeps every mark.
fixture: fmt_inserts_failure_marks/input
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet fmt --explicit-failures run.jet
exit: 0
file: run.jet = fmt_inserts_failure_marks/formatted.out
step: jet check run.jet
exit: 0
step: jet fmt run.jet
exit: 0
file: run.jet = fmt_inserts_failure_marks/formatted.out
