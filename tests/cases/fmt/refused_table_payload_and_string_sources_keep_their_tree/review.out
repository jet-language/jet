jet_cli_review_op_key: fn(operation: JetCLIReviewOp) -> String Never! {
    "{jet_cli_review_key(operation.kind, operation.stable_id, None)}{jet_cli_review_key(operation.identity, operation.alignment, operation.source_operation)}{jet_cli_review_key("b", operation.before ?? "", operation.before_identity)}{jet_cli_review_key(if operation.before == None -> "n" else -> "v", operation.after ?? "", operation.after_identity)}{if operation.after == None -> "n" else -> "v"}"
}
