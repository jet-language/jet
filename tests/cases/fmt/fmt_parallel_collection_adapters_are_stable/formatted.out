run: fn() {
    values := [1, 2, 3, 4]
    doubled: values.para_map(fn(n: Int) { n * 2 })
    even: values.para_filter(fn(n: Int) { n % 2 == 0 })
    split: values.para_partition(fn(n: Int) { n % 2 == 0 })
    total: values.para_fold(fn() { 0 }, fn(acc: Int, n: Int) { acc + n }, fn(left: Int, right: Int) { left + right })
}
