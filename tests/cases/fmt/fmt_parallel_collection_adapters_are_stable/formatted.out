fn run() {
    values := [1, 2, 3, 4]
    doubled :: values.para_map((n: Int) -> n * 2)
    even :: values.para_filter((n: Int) -> n % 2 == 0)
    split :: values.para_partition((n: Int) -> n % 2 == 0)
    total :: values.para_fold(() -> 0, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right)
}
