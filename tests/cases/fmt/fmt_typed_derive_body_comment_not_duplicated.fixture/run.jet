Label: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            info: target.reflect()
            tname: info.name
            // resolves to the same value as `tname`
            lbl: #{tname}
            label: fn(self) -> String { #{lbl} }
        }
    }
}

#Label
Cube: struct {
    side: Int
}

run: fn() {
    c: Cube{side: 5}
    print(c.label())
}
