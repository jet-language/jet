# jet fmt keeps in-body marker lines where the author wrote them, prints one simple value without parentheses, and is idempotent
fixture: marker_inbody_keeps_placement/input
step: jet fmt run.jet
file: run.jet = marker_inbody_keeps_placement/formatted.out
step: jet fmt run.jet
file: run.jet = marker_inbody_keeps_placement/formatted.out
