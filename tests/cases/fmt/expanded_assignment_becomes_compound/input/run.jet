Player: struct {
    hp: Int
}

damage: fn(p: &Player, amount: Int) { p.hp = p.hp - amount }

run: fn() {
    n := 0
    n = n + 1
    n = (n * 3)
    n = n - 1  // a trailing comment stays
    n = n / 2
    k := 5
    k = n + k
    m := 9
    m = m - 1 - n
    m = m % 4
    xs := [1, 2, 3]
    xs[0] = xs[0] + 1
    xs[xs.len() - 1] = xs[xs.len() - 1] * 2
    s := "a"
    s = s + "b"
    p := Player{hp: 10}
    damage(p, 3)
    p.hp = p.hp + n
    n += 1
    print("{n} {k} {m} {xs[0]} {s} {p.hp}")
}
