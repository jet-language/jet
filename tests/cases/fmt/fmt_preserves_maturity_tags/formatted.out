#Meta(maturity: .Experimental)
experimental_label: fn() -> String { return "exp" }

#Meta(maturity: .Tested)
tested_label: fn() -> String { return "tested" }

#Meta(maturity: .Hardened)
hardened_label: fn() -> String { return "hard" }

run: fn() {
    print(experimental_label())
    print(tested_label())
    print(hardened_label())
}
