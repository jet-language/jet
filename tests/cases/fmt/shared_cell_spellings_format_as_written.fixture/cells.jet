Counter: struct {
    hits: Int
}

run: fn() {
    count: 5
    braced: Shared{  count  }
    typed: Shared<Int?>{ None }
    built: Shared{Counter{hits: 0}}
    older: shared   Counter{hits: 1}
    print(braced.guard_read().value + built.hits + older.hits)
    print(typed.guard_read().value ?? 0)
}
