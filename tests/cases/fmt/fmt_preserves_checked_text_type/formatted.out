TextError: enum {
    Empty
}

Pattern: distinct String

impl Pattern.CheckedText {
    Error: TextError

    check: fn(text: String) Err! -[]> {
        if text == "" -> return Err(TextError.Empty)
        return Ok(())
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String { return "[{value}]" }
}

render: fn(value: Pattern) {
    #Unsafe("formatter fixture") { print(value.raw()) }
}

run: fn() {
    id: 42
    value: Pattern{"value {id}"}
    render(value)
}
