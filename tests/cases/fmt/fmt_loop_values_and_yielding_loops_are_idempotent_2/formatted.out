find: fn(xs: [Int]) -> Int {
    found: loop {
        loop x in xs {
            if x > 2 {
                break(found, x)
            }
        }
        break -1
    }
    found
}

run: fn() {
    xs: [Int]{1, 2, 3, 4}
    values: loop x in xs -> {
        if x > 3 { break }
        x * 2
    }
    print(values)
}
