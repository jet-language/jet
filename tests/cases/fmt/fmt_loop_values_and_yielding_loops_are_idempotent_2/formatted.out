fn find(xs: [Int]) -> Int {
    found :: loop {
        loop x in xs {
            if x > 2 {
                break(found, x)
            }
        }
        break -1
    }
    found
}

fn run() {
    xs :: [Int]{1, 2, 3, 4}
    values :: loop x in xs -> {
        if x > 3 { break }
        x * 2
    }
    print(values)
}
