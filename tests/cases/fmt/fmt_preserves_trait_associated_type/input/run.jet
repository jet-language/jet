trait Indexed {
    type Elem
    fn at(self, i: Int) -> Elem
    fn count(self) -> Int
}

struct Nums {
    vals: [Int]
}

impl Nums.Indexed {
    type Elem = Int

    fn at(self, i: Int) -> Int {
        return self.vals[i]
    }

    fn count(self) -> Int {
        return self.vals.len()
    }
}

fn run() {
    n :: Nums{vals: [10, 20, 30]}
    print(n.at(0))
    print(n.count())
}
