Indexed: trait {
    Elem: type
    at: fn(self, i: Int) -> Elem
    count: fn(self) -> Int
}

Nums: struct {
    vals: [Int]

    impl Indexed {
        Elem: Int

        at: fn(self, i: Int) -> Int { return self.vals[i] }

        count: fn(self) -> Int { return self.vals.len() }
    }
}

run: fn() {
    n: Nums{vals: [10, 20, 30]}
    print(n.at(0))
    print(n.count())
}
