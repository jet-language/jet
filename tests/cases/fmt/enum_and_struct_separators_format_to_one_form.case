# Struct fields, enum cases and variant-group leaves written with `,` or line
# breaks, on one line or many, all format to the one canonical form, and the
# formatted file is a fixed point.
fixture: enum_and_struct_separators_format_to_one_form/input
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet fmt run.jet
file: run.jet = enum_and_struct_separators_format_to_one_form/formatted.out
step: jet fmt run.jet
file: run.jet = enum_and_struct_separators_format_to_one_form/formatted.out
step: jet run run.jet
exit: 0
stdout: = "1 4\n"
