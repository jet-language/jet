use {
    math.clamp
    c2 :: math.clamp
    core.math.[sign]
    absolute :: core.math.abs
    core.encoding.[json, csv]
    c.sqlite3
    rl :: c.raylib
}

module math {
    fn clamp(x: Int, lo: Int, hi: Int) -> Int {
        if x < lo -> return lo
        if x > hi -> return hi
        return x
    }
}

fn run() {
    print(clamp(15, 0, 10))
    print(c2(5, 0, 3))
}
