use {
    math.[clamp, clamp as c2]
    core.math.[abs as absolute, sign]
    core.encoding.[json, csv]
    c.[raylib as rl, sqlite3]
}

module math {
    fn clamp(x: Int, lo: Int, hi: Int) -> Int {
        if x < lo -> return lo
        if x > hi -> return hi
        return x
    }
}

fn run() {
    print(clamp(15, 0, 10))
    print(c2(5, 0, 3))
}
