fn run() {
    values :: [
        // Primary value.
        1,
        2,  // Secondary value.
    ]
    point :: (
        // Horizontal coordinate.
        x: 7,
        /* coordinate value */
        y: 8,
    )
    lookup :: [
        // Stable key.
        "a": 1,
        /* mapped value */
        "b": 2,
    ]
    typed :: [Int]{
        // First typed value.
        3,
        4,
    }
    record :: Point{
        // Named field.
        x: 9,
        /* field value */
        y: 10,
    }
    typed_lookup :: [String:Int]{
        "c": 5,
        /* typed mapped value */
        "d": 6,
    }
    empty :: [
        // Intentionally empty.
    ]
    typed_empty :: [Int]{
        /* Typed sentinel. */
    }
    print(values.len() + point.x + lookup.len() + typed.len())
}
