label: fn(x: Int) -> String {
    if {
        x == 1 -> "one" // first
        else -> "other" // last
    }
}

pick: fn(x: Int) -> String {
    if x == {
        // the small one
        1 -> "one" // first
        2 -> {
            "two"
        } // second
        // what is left
        else -> "other" // last
        // after the arms
    }
}

word: fn(x: Int) -> Int {
    if {
        x == 1 -> print("one") // first
        else -> print("other") // last
    }
    x
}

braced: fn(x: Int) -> Int {
    if {
        x == 1 -> print("one") // first
        else -> {
            print("other")
        } // last
    }
    x
}

