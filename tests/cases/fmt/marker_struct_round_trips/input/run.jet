Route: struct {
    path: String
    label: String{"route"}
    tags: [String]
    impl Marker {
        sites: [.Function, .Method]
        repeatable: true
        expand: fn(self, target: Target) {
        }
    }
}
Quick: struct {
    impl Marker {
        group: #[Inline(.Always), Scalar]
    }
}

#Route("/orders", "orders", "a", "b") orders: fn() -> String { "orders" }

#Quick bump: fn(value: Int) -> Int { value + 1 }

run: fn() { print("{orders()} {bump(1)}") }
