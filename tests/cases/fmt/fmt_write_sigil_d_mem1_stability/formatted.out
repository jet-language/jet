Player: struct {
    hp: Int
}

impl Player {
    show: fn(self) -> Int { return self.hp }

    heal: fn(&self, amount: Int) { self.hp = self.hp + amount }
}

damage: fn(p: &Player, amount: Int) { p.hp = p.hp - amount }

archive: fn(p: ^Player) -> Int { return p.hp }

run: fn() {
    p := Player{hp: 100}
    damage(&p, 10)
    p.heal(5)
    print(archive(^p))
}
