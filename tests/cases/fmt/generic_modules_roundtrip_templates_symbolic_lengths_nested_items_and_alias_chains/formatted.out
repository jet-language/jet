ring: module<T>(capacity: Int, label: String) {
    #Meta(category: label) SIZE: #run capacity

    Buffer: struct {
        slots: [T#capacity]
    }

    nested: module<U> {
        keep: fn(value: U) -> U { return value.copy() }
    }

    inner: nested<T>

    #Meta(category: label)
    adjusted: fn() -> Int { return capacity + 1 }
}

a: ring<Int>(2 + 2, "ring")

b: a

run: fn() {}
