module math {
    fn clamp(x: Int, lo: Int, hi: Int) -> Int {
        if x < lo { return lo }
        if x > hi { return hi }
        return x
    }
}

use math.[clamp, clamp as c2]
use core.math.[abs as absolute, min]
use core.encoding.[json, csv]
use c.[raylib as rl, sqlite3]

fn run() {
    print(clamp(15, 0, 10))
    print(c2(5, 0, 3))
}
