use core.encoding.json as json

fn run() {
    parsed0 := json.parse("{{}}") ?? panic("parse")
    print(true)
    parsed1 := json.parse("[]") ?? panic("parse")
    print(true)
    parsed2 := json.parse("{{\"\":1}}") ?? panic("parse")
    print(true)
    parsed3 := json.parse("{{\"a\":1}}") ?? panic("parse")
    print(true)
    parsed4 := json.parse("{{\"a\":1,\"b\":2}}") ?? panic("parse")
    print(true)
    parsed5 := json.parse("[1,2,3]") ?? panic("parse")
    print(true)
    parsed6 := json.parse("{{\"a\":1,\"b\":[true,false,null]}}") ?? panic("parse")
    print(true)
}
