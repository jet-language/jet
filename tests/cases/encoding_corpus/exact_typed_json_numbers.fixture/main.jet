
use {
    json: core.encoding.json
    data: core.data
}

#Codable
ExactNumbers: struct {
    amount: Decimal
    exponent: Decimal
    whole: Decimal
    tenth: Decimal
    tenth_with_zero: Decimal
    scientific_tenth: Decimal
    adjacent_lo: Int
    adjacent_hi: Int
    large: Int
    large_exp: Int
}

#Codable
SmallI64: struct {
    value: I64
}

#Codable
ExactIntRow: struct {
    adjacent_hi: Int
    large: Int
}

LIMITED_TEXT: comptime { "1{"0".repeat(1000000)}" }

run: fn() {
    raw: "{{\"amount\":12.340,\"exponent\":1E-5,\"whole\":100,\"tenth\":0.1,\"tenth_with_zero\":0.10,\"scientific_tenth\":1e-1,\"adjacent_lo\":9007199254740992,\"adjacent_hi\":9007199254740993,\"large\":12345678901234567890123456789012345678901234567890,\"large_exp\":1e30}}"
    value: json.decode<ExactNumbers>(raw) ?? panic("whole decode")
    print(value.amount.to_string())
    print(value.exponent.to_string())
    print(value.whole.to_string())
    print(value.tenth.to_string())
    print(value.tenth_with_zero.to_string())
    print(value.scientific_tenth.to_string())
    print(value.adjacent_lo.to_string())
    print(value.adjacent_hi.to_string())
    print(value.large.to_string())
    print(value.large_exp.to_string())

    stream_raw: "{{\"adjacent_hi\":9007199254740993,\"large\":12345678901234567890123456789012345678901234567890}}"
    rows: data.json<ExactIntRow>("[{stream_raw}]") ?? panic("stream decode")
    loop row in rows {
        print(row.adjacent_hi.to_string())
        print(row.large.to_string())
    }

    if json.decode<SmallI64>("{{\"value\":9223372036854775808}}") == {
        .Err(_) -> { print("i64-overflow") }
        .Ok(_) -> { print("accepted") }
    }
    print(json.decode<U64>("18446744073709551615") ?? panic("u64 maximum"))
    if json.decode<U64>("18446744073709551616") == {
        .Err(_) -> print("u64-overflow")
        .Ok(_) -> print("accepted")
    }
    if json.decode<U64>("-1") == {
        .Err(_) -> print("u64-negative")
        .Ok(_) -> print("accepted")
    }
    if json.decode<Int>("\"123\"") == {
        .Err(_) -> print("quoted-int")
        .Ok(_) -> print("accepted")
    }
    if json.decode<Float>("1e400") == {
        .Err(_) -> { print("nonfinite") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<Decimal>("NaN") == {
        .Err(_) -> { print("nan-rejected") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<Decimal>("Infinity") == {
        .Err(_) -> { print("infinity-rejected") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<Int>("1.5") == {
        .Err(_) -> { print("fractional-rejected") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<Decimal>("1e1000001") == {
        .Err(_) -> { print("exponent-limit") }
        .Ok(_) -> { print("accepted") }
    }
    // Decimal decodes from its own text encoding, so the mismatch is a Bool.
    mismatch_raw: "{{\"amount\":true,\"exponent\":1E-5,\"whole\":100,\"tenth\":0.1,\"tenth_with_zero\":0.10,\"scientific_tenth\":1e-1,\"adjacent_lo\":1,\"adjacent_hi\":1,\"large\":1,\"large_exp\":1}}"
    if json.decode<ExactNumbers>(mismatch_raw) == {
        .Err(_) -> { print("mismatch") }
        .Ok(_) -> { print("accepted") }
    }
    if data.json<ExactNumbers>("[{mismatch_raw}]") == {
        .Err(_) -> { print("stream-mismatch") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<String>("123") == {
        .Err(_) -> { print("string-mismatch") }
        .Ok(_) -> { print("accepted") }
    }
    if json.decode<Decimal>(LIMITED_TEXT) == {
        .Err(_) -> { print("limit") }
        .Ok(_) -> { print("accepted") }
    }
}
