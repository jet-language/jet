use core.encoding.csv as csv

fn run() {
    rows0 := csv.parse("aaa,bbb,ccc") ?? panic("parse")
    print(rows0.len() > 0)
    rows1 := csv.parse("zzz,yyy,xxx") ?? panic("parse")
    print(rows1.len() > 0)
    rows2 := csv.parse("\"aaa\",\"bbb\",\"ccc\"") ?? panic("parse")
    print(rows2.len() > 0)
    rows3 := csv.parse("\"zzz\",\"yyy\",\"xxx\"") ?? panic("parse")
    print(rows3.len() > 0)
    rows4 := csv.parse("\"aaa\",\"b\"\"bb\",\"ccc\"") ?? panic("parse")
    print(rows4.len() > 0)
    rows5 := csv.parse("\"aaa\",\"b\\nbb\",\"ccc\"") ?? panic("parse")
    print(rows5.len() > 0)
}
