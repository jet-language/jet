
use {
    values
    functions
    calls: functions
    transform: functions.apply
    Weight: values.Item
    Store: values.Pool
    OFFSET: values.BASE
}
run: fn() {
    first: transform(Weight{weight: OFFSET}, fn(item: Weight) { Weight{weight: item.weight + 1} })
    second: calls.apply(first, fn(item: Weight) { Weight{weight: item.weight + 2} })
    copied: duplicate(second)
    pool: Store<Weight>{items: [copied]}
    print(total(pool_copy(pool)))
}
