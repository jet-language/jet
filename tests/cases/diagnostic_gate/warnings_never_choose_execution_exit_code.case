# Port of tests/diagnostic_gate.rs::warnings_never_choose_execution_exit_code (104-161).
# PENDING-GRAMMAR and PENDING-SAME-HEAD: no runtime snapshot.
# Visibility follows #3420 (ratified): run, dev, and build keep the advisory
# lints L0103/L0202 off stderr, `--verbose` shows them, and `--json` reports
# exactly what the human output shows. Warnings never choose the exit code.
# The l0103 fixture imports core.text under two aliases where the Rust source
# used core.http.client and fetched example.com; the case needs no network.
fixture: warnings.fixture
env: NO_COLOR=1
step: jet run main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/default/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: run hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet run --release main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/release/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: run hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet dev main.jet --watch=off
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/dev/build
exit: 0
stderr: !~ "Warning [jet.UnusedImport]" # #3420: dev hides advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet run --verbose main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/verbose/build
exit: 0
stderr: ~ "Warning [jet.UnusedImport]" # #3420: --verbose shows advisories
stderr: !~ "Error [jet.UnusedImport]" # original predicate
stdout: = l0103.out
step: jet build main.jet
cwd: l0103
env: JET_STORE_DIR={work}/cache/l0103/build/build
exit: 0
