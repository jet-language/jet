# #4627/5: a one-item list indexed at 1 stops with "the list has 1 item"; two
# items still say "2 items". Default jet run (o0, o2), the AOT build and the
# comptime evaluator word the stop the same way.
fixture: fixtures/list_position_stop_counts_one_item
env: NO_COLOR=1
step one_o0: jet run -O0 one.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist`" # the stop's reason line; Why/Fix belong to the E3010 row
stderr: ~ "--> one.jet:6" # the indexing site
step one_o2: jet run -O2 one.jet
exit: 70
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist`" # the stop's reason line on the optimized tier
step: jet build one.jet
exit: 0
step one_aot: {work}/.jet/build/one
exit: 70
stderr: ~ "Stop [E3010]: `the list has 1 item, so position 1 doesn't exist`" # the AOT binary's reason line
step two_o0: jet run -O0 two.jet
exit: 70
stderr: ~ "Stop [E3010]: `the list has 2 items, so position 2 doesn't exist`" # a count above one keeps the plural
step folded: jet run folded.jet
exit: 1
stderr: ~ "Error [E3010]: `the list has 1 item, so position 1 doesn't exist`" # the comptime evaluator's reason line
stderr: ~ "--> {work}/folded.jet:7:20" # the folded call site; a refused `jet run` names the file by its full path (owner answer q07mphiy 2026-11-01)
