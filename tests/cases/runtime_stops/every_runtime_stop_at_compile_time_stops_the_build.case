# #6725: every runtime stop reached while folding a `#run` value stops
# the build with its message at the folded call (JetRuntime Trap.jet
# trap_stop), on every optimization level, including a stop in a function
# that returns nothing and a process.exit. No program runs, so nothing is
# printed. The compiler used to answer such a fold with the stopped call's
# garbage result.
fixture: fixtures/every_runtime_stop_at_compile_time_stops_the_build
env: NO_COLOR=1
step: jet run -O0 narrow.jet
exit: 1
stdout: empty
stderr: ~ "Error [E3010]: `Value doesn't fit in destination type`" # an exact int past i64 narrowed to i64 stops the fold
stderr: ~ "--> {work}/narrow.jet:7:" # at the comptime call
step: jet run -O1 narrow.jet
exit: 1
stdout: empty
stderr: ~ "Error [E3010]: `Value doesn't fit in destination type`" # an exact int past i64 narrowed to i64 stops the fold
stderr: ~ "--> {work}/narrow.jet:7:" # at the comptime call
step: jet run -O2 narrow.jet
exit: 1
stdout: empty
stderr: ~ "Error [E3010]: `Value doesn't fit in destination type`" # an exact int past i64 narrowed to i64 stops the fold
stderr: ~ "--> {work}/narrow.jet:7:" # at the comptime call
