# `10 / z` with z == 0 exits 70 (not 101) with the E3010
# "divided by zero" stop at the division's file and line, under jet run and
# in the AOT binary.
fixture: fixtures/int_divide_by_zero_variable_stops_on_run_and_aot
env: NO_COLOR=1
step run: jet run div.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `divided by zero`" # the stop's reason line; Why/Fix belong to the E3010 row
stderr: ~ "--> div.jet:6" # the division's line
stderr: !~ "invalid exact quotient" # the retired wording
step: jet build div.jet
exit: 0
step aot: {work}/.jet/build/div
exit: 70
stdout: empty
stderr: ~ "Stop [E3010]: `divided by zero`" # the AOT binary's reason line
stderr: ~ "--> div.jet:6" # the division's line
stderr: !~ "invalid exact quotient" # the retired wording
