# A `#Todo` reached while folding a `#run` value stops check, run and
# build with the E3011 stop at the `#Todo`'s file and line, naming the type
# it stands for (spec.md, runtime stops: `#Todo` reports E3011). The fold
# never yields a value, so no program runs and nothing is printed.
fixture: fixtures/todo_reached_at_compile_time_stops_the_build
env: NO_COLOR=1
step: jet check folded.jet
exit: 1
stdout: empty
stderr: ~ "Error [E3011]: `#Todo at folded.jet:3 — expected Int`" # the stop names the #Todo's file, line and type
stderr: ~ "--> folded.jet:6:18" # the folded call site
stderr: ~ "Why: Compile-time code reached a `#Todo`" # the compile-time Why
step: jet run folded.jet
exit: 1
stdout: empty
stderr: ~ "Error [E3011]: `#Todo at folded.jet:3 — expected Int`" # the stop names the #Todo's file, line and type
stderr: ~ "--> {work}/folded.jet:6:18" # the folded call site; a refused `jet run` names the file by its full path
step: jet build folded.jet
exit: 1
stderr: ~ "Error [E3011]" # the build refuses the same fold
