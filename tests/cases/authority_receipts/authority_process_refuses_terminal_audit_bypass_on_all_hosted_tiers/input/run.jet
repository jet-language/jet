
use core.process as process

fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["/bin/sh", "-c", "printf terminal-secret"])
        .terminal()
        .cwd("/tmp")
        .under(policy)
    if spec.plan() == {
        .Ok(_) -> print("accepted")
        .Err(_) -> print("refused")
    }
}
