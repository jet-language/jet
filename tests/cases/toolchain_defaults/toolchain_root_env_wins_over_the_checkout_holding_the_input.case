# Docs/spec/reference/environment.md: `JET_TOOLCHAIN_ROOT` names the toolchain sources and wins
# over both defaults. `decoy/` looks like a checkout but holds no Core sources, so the check
# passes only when the env value is used.
env: NO_COLOR=1
requires: os:unix
mkdir: decoy/Core
mkdir: decoy/Compiler/Prelude
copy: {root}/Examples/features/basics/hello.jet decoy/app/hello.jet
step: jet check decoy/app/hello.jet
env: JET_TOOLCHAIN_ROOT={root}
exit: 0
stdout+stderr: ~ "has no problems" # the check's verdict line; the path varies with the work directory
