# Docs/spec/reference/environment.md: with `JET_COMPILER_IDENTITY` unset, the compiler identity
# is the one line of the `IDENTITY` file beside the running `jet`.
env: NO_COLOR=1
requires: os:unix
copy: {jet} tool/jet
chmod: tool/jet 0755
write: tool/IDENTITY identity.template
copy: {root}/Examples/Basics/Hello.jet app/hello.jet
step: {work}/tool/jet check app/hello.jet
unset: JET_COMPILER_IDENTITY
exit: 0
stdout+stderr: ~ "has no problems" # the check's verdict line; the path varies with the work directory
