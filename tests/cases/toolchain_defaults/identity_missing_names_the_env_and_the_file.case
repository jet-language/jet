# Docs/spec/reference/environment.md: with `JET_COMPILER_IDENTITY` unset and no `IDENTITY` file
# beside `jet`, the refusal names both.
env: NO_COLOR=1
requires: os:unix
copy: {jet} tool/jet
chmod: tool/jet 0755
copy: {root}/Examples/Basics/Hello.jet app/hello.jet
step: {work}/tool/jet check app/hello.jet
unset: JET_COMPILER_IDENTITY
exit: 1
stdout: empty
stderr: = identity_missing_names_the_env_and_the_file.stderr
