# Docs/spec/reference/environment.md: a compile takes its Core from a toolchain tree only when
# one is named, by `JET_TOOLCHAIN_ROOT` or by an entry under a tree's `Core/` or `Compiler/`.
# Any other entry, even one inside a checkout, compiles against the Core sources built into
# `jet`. The work directory looks like a checkout but holds no Core sources, so the check
# passes only on the built-in Core.
env: NO_COLOR=1
requires: os:unix
mkdir: Core
mkdir: Compiler/Prelude
copy: {root}/Examples/Basics/Hello.jet app/hello.jet
step: jet check app/hello.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout+stderr: ~ "has no problems" # the check's verdict line; the path varies with the work directory
