# Docs/spec/reference/environment.md: with `JET_TOOLCHAIN_ROOT` unset, no checkout at or above
# the input and no toolchain beside `jet`, the refusal names all three places.
env: NO_COLOR=1
requires: os:unix
copy: {jet} tool/jet
chmod: tool/jet 0755
copy: {root}/Examples/features/basics/hello.jet app/hello.jet
step: {work}/tool/jet check app/hello.jet
unset: JET_TOOLCHAIN_ROOT
exit: 1
stdout: empty
stderr: = toolchain_root_missing_names_every_place_jet_looked.stderr
