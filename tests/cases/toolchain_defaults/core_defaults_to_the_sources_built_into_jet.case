# Docs/spec/reference/environment.md: with `JET_TOOLCHAIN_ROOT` unset and no checkout at or
# above the input, `jet` compiles against the Core sources built into it, so a `jet` copied
# alone (no `Core/` beside it) checks a program.
env: NO_COLOR=1
requires: os:unix
copy: {jet} tool/jet
chmod: tool/jet 0755
# The copy carries its own identity, so the row does not lean on a `JET_COMPILER_IDENTITY`
# from the calling shell.
write: tool/IDENTITY identity.template
copy: {root}/Examples/Basics/Hello.jet app/hello.jet
step: {work}/tool/jet check app/hello.jet
unset: JET_TOOLCHAIN_ROOT
exit: 0
stdout+stderr: ~ "has no problems" # the check's verdict line; the path varies with the work directory
