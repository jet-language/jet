# A generic owner's methods are compiler-thread jobs in a body stream (JetSema
# Sema/CheckProgram.jet, sema_check_method_parallel_eligible): the owner's
# generic parameters come with the method's input, and the thread checks it on
# its own copy of the environment with them set, as the lead does. A JSON
# reader over the program's own byte source demands `JSONPull<Chunks>`'s
# methods from a Core demand wave, enough work to admit two threads, and the
# run shows the bodies the threads checked are the ones one thread checks.
fixture: core_demand_waves_check_generic_owner_methods_on_threads.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check --threads 2 --trace run.jet
exit: 0
stdout+stderr: ~ "has no problems"
stderr: ~ "# sema.core_demand.wave_workers = 2\n" # a demand wave admits both threads the cap allows
step: jet run --threads 2 run.jet
exit: 0
stdout: = core_demand_waves_check_generic_owner_methods_on_threads.out
