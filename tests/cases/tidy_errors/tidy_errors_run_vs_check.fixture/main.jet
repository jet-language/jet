use text: core.text

Light: enum {
    Red
    Yellow
    Green
}

run: fn() {
    unused_binding: 1
    light: Light.Red
    if light == {
        .Red -> { print("red") }
        .Yellow -> { print("yellow") }
        .Red -> { print("again") }
        .Green -> { print("green") }
    }
}

#Test("adds") {
    assert_eq(1 + 1, 2)
}
