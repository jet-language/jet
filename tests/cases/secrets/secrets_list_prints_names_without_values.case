# HAND-PORT tests/secrets.rs:261-305 secrets_list_prints_names_without_values
# PENDING-GRAMMAR: approved batch-two/four forms, no runtime parity claim.
env: JET_KEYS_DIR={work}/keys
mkdir: keys
mkdir: project
step: jetpack secrets keygen
cwd: project
exit: 0
capture: recipient stderr.strip_ansi after "recipient: " trim
cap:recipient: ^= "age1" # original predicate
step: jetpack secrets recipients add {cap:recipient}
cwd: project
exit: 0
step: jetpack secrets set first_name list-value-one-never-printed
cwd: project
exit: 0
step: jetpack secrets set second_name list-value-two-never-printed
cwd: project
exit: 0
step: jetpack secrets list
cwd: project
exit: 0
stdout: lines = ["first_name","second_name"] # original predicate
stdout+stderr: !~ "list-value-one-never-printed" # original predicate
stdout+stderr: !~ "list-value-two-never-printed" # original predicate

