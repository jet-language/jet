exit: 0
tree: project !~ "hunter2-super-secret-value" # original predicate
entries: project recursive ext = "tmp" = 0 # original predicate
file: project/.jet/secrets.age is-file
file: project/.jet/secrets.age nonempty # original predicate
step: jetpack secrets get db_password
cwd: project
exit: 0
stdout.trim: = secrets_keygen_set_get_roundtrip_no_plaintext_on_disk.plain.expected # original predicate
