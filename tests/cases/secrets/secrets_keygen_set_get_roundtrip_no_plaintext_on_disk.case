env: JET_KEYS_DIR={work}/keys
mkdir: keys
mkdir: project
step: jetpack secrets keygen
cwd: project
exit: 0
capture: recipient stderr.strip_ansi after "recipient: " trim
cap:recipient: ^= "age1" # original predicate
step: jetpack secrets recipients add {cap:recipient}
