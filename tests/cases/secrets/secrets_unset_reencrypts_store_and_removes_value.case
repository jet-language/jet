# HAND-PORT tests/secrets.rs:204-259 secrets_unset_reencrypts_store_and_removes_value
# PENDING-GRAMMAR: approved batch-two/four forms, no runtime parity claim.
env: JET_KEYS_DIR={work}/keys
mkdir: keys
mkdir: project
step: jetpack secrets keygen
cwd: project
exit: 0
capture: recipient stderr.strip_ansi after "recipient: " trim
cap:recipient: ^= "age1" # original predicate
step: jetpack secrets recipients add {cap:recipient}
cwd: project
exit: 0
step: jetpack secrets set removed_name unset-value-never-printed
cwd: project
exit: 0
step: jetpack secrets set kept_name kept-value
cwd: project
exit: 0
copy: project/.jet/secrets.age before.age
step: jetpack secrets unset removed_name
cwd: project
exit: 0
stdout: !~ "unset-value-never-printed" # original predicate
stderr: !~ "unset-value-never-printed" # original predicate
file: project/.jet/secrets.age != before.age
file: project/.jet/secrets.age !~ "unset-value-never-printed" # original predicate
step: jetpack secrets get removed_name
cwd: project
exit: nonzero
stderr: ~ "E1263" # original predicate

