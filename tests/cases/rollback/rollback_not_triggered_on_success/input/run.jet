
Counter: struct {
    value: Int
    ops: Int
}
CounterSnap: struct {
    value: Int
    ops: Int
}
impl Counter.Rollback {
    Snapshot: CounterSnap
    snapshot: fn(self) -> CounterSnap {
        return CounterSnap{ value: self.value, ops: self.ops }
    }
    restore: fn(&self, snap: ^CounterSnap) {
        self.value = snap.value
        self.ops = snap.ops
    }
}
#Error
Fail: enum { Bad }
bump: fn(c: &Counter) -> Int Fail! {
    #Transact {
        c.value += 1
        c.ops += 1
    }
    return Ok(c.value)
}
run: fn() {
    c := Counter{ value: 10, ops: 0 }
    _: bump(&c) ?? 0
    print(c.value)
    print(c.ops)
}
