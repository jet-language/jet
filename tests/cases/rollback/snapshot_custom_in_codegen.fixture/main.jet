
Counter: struct {
    value: Int
}
CounterSnap: struct { value: Int }
impl Counter.Rollback {
    Snapshot: CounterSnap
    snapshot: fn(self) -> CounterSnap {
        return CounterSnap{ value: self.value }
    }
    restore: fn(&self, snap: ^CounterSnap) {
        self.value = snap.value
    }
}
#Error
Fail: enum { Bad }
bump: fn(c: &Counter) -> Int Fail! {
    #Transact {
        c.value += 1
        return Err(Fail.Bad)
    }
    return Ok(c.value)
}
run: fn() {
    c := Counter{ value: 0 }
    _: bump(&c) ?? 0
    print(c.value)
}
