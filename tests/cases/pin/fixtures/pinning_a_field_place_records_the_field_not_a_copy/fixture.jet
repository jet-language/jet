
use core.mem

struct Node {
    payload: Int
    hops: Int
}

struct Pair {
    left: Node
    right: Node
}

fn run() {
    pair := Pair{left: Node{payload: 1, hops: 0}, right: Node{payload: 2, hops: 0}}
    first :: mem.pin(&pair.left)
    pair.left = Node{payload: 9, hops: 0}
    print("{(first.hops)}")
}
