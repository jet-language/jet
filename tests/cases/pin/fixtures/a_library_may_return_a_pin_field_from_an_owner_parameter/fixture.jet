
use core.mem

Node: struct {
    payload: Int
    hops: Int
}

PinQueue: struct {
    label: String
    head: Pin<Node>
}

attach: fn(label: String, node: &Node) -> PinQueue from node {
    return PinQueue{label: label.copy(), head: mem.pin(node)}
}

run: fn() {
    node := Node{payload: 41, hops: 0}
    queue: attach("ready", node)
    queue.head.hops += 1
    queue.head.payload += 1
    print("{(queue.label)} {(queue.head.payload)} {(queue.head.hops)}")
}
