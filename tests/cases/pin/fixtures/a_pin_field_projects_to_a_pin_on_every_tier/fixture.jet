
use core.mem

Node: struct {
    payload: Int
    hops: Int
}

PinQueue: struct {
    label: String
    head: Pin<Node>
}

run: fn() {
    node := Node{payload: 41, hops: 0}
    pinned: mem.pin(node)
    pinned.hops += 1
    queue: PinQueue{label: "ready", head: mem.pin(node)}
    print("{(queue.label)} {(queue.head.payload)} {(queue.head.hops)}")
}
