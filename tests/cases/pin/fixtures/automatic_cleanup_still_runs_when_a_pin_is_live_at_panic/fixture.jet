
use core.mem

struct Guard {
    name: String
}

impl Guard.Close {
    fn close(^self) {
        print("closed {self.name}")
    }
}

struct Node {
    payload: Int
    hops: Int
}

fn run() {
    guard := Guard{name: "pin"}
    node := Node{payload: 1, hops: 0}
    pinned :: mem.pin(&node)
    pinned.hops += 1
    print("body {(pinned.hops)}")
    panic("stop")
}
