
use core.mem

Guard: struct {
    name: String
}

impl Guard.Close {
    close: fn(&&self) {
        print("closed {self.name}")
    }
}

Node: struct {
    payload: Int
    hops: Int
}

run: fn() {
    guard := Guard{name: "pin"}
    node := Node{payload: 1, hops: 0}
    pinned: mem.pin(node)
    pinned.hops += 1
    print("body {(pinned.hops)}")
    panic("stop")
}
