requires: os:unix
requires: tool:git
refused: crypto-provider-failure
mkdir: home
mkdir: project
mkdir: store
mkdir: keys
# The owning seam admits the exact clean-project/review/provider/key fixture before the command.
env: HOME={work}/home
env: JET_KEYS_DIR={work}/keys
env: JET_REGISTRY_URL=file://{work}/registry.git
env: JET_REGISTRY_CACHE_DIR={work}/registry-cache
env: JET_PACKAGE_STORE_DIR={work}/store
step: jet registry publish
cwd: project
exit: 0
file: keys/jet.ed25519 = fixtures/crypto/seed.bin
step: git --git-dir {work}/registry.git show HEAD:index/existingkey/existingkey.jsonl
exit: 0
