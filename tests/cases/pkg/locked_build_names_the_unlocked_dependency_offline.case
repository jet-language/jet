# `jet build --locked` checks `.jet/lock` before it compiles. A
# missing or stale lock fails and names the dependency; with a current lock
# the build opens no network connection (it runs with the network disabled).
requires: os-name:linux
requires: tool:unshare
fixture: fixtures/locked_build_names_the_unlocked_dependency_offline
mkdir: store
env: JET_PACKAGE_STORE_DIR={work}/store
env: NO_COLOR=1
step: jet build --locked run.jet
exit: 1
stderr: ~ "Error [jet.StaleLockFile]: `.jet/lock` is missing, so `greeter` is not locked" # the headline names the unlocked dependency
file: .jet/build/run absent
step: jet fetch
exit: 0
stdout: = "fetched all dependencies\n"
file: .jet/lock exists
step: jet build --locked run.jet
isolate: no-nix network=disabled
exit: 0
stdout: = ""
step: {work}/.jet/build/run
exit: 0
stdout: = "hello from greeter\n"
write: package.jet stale-package.template
step: jet build --locked run.jet
isolate: no-nix network=disabled
exit: 1
stderr: ~ "`helper`" # the stale lock names the dependency it lacks
file: .jet/lock exists
