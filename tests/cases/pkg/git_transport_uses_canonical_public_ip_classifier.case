# tests/pkg.rs::git_transport_uses_canonical_public_ip_classifier at tests/pkg.rs:4135; hand-port
# Claim: the Git dependency transport has one call site for the canonical public-address classifier, defines no classifier of its own, and carries no second IP range table (tests/pkg.rs:4139-4151)
# Source move: Source/Fetch.rs is now Jetpack/Provider/Source/PackageFetch/Git.jet; the canonical classifier jet_net::is_public_ip is now publication_addresses_public (Jetpack/Publication/Source/RegistryTransport.jet), which applies Core's ip.is_public_destination / ip.ipv6_is_public_destination tables (Core/Net/Ip.jet)
# The IPv4-mapped and 2000::/3 checks the original refused to see twice are spelled `::ffff:` / `bit_and(57344)` in Jet; the case refuses both spellings in the transport
copy: {root}/Jetpack/Provider/Source/PackageFetch/Git.jet git.jet
copy: {root}/Jetpack/Publication/Source/RegistryTransport.jet registry-transport.jet
copy: {root}/Core/Net/Ip.jet ip.jet
file: git.jet count "publication_addresses_public(" = 1 # tests/pkg.rs:4140 one call site for the canonical IP classifier
file: git.jet !~ "fn publication_addresses_public(" # tests/pkg.rs:4145 no duplicate classifier
file: git.jet !~ "is_public" # tests/pkg.rs:4145 no other classifier is defined or called in the transport
file: git.jet !~ "is_public_destination(" # the transport does not bypass the canonical classifier
file: git.jet !~ "::ffff:" # tests/pkg.rs:4149 to_ipv4_mapped: no second mapped-address table
file: git.jet !~ "57344" # tests/pkg.rs:4149 `first & 0xe000`: no second range table
file: git.jet !~ "0xe000" # tests/pkg.rs:4149
file: registry-transport.jet count "fn publication_addresses_public(" = 1 # the canonical classifier is defined once
file: registry-transport.jet ~ "ip.is_public_destination(" # it applies Core's IPv4 table
file: registry-transport.jet ~ "ip.ipv6_is_public_destination(" # it applies Core's IPv6 table
file: ip.jet count "fn is_public_destination(" = 1 # Core owns the one IPv4 table
file: ip.jet count "fn ipv6_is_public_destination(" = 1 # Core owns the one IPv6 table
