requires: os:unix
refused: crypto-provider-failure
mkdir: home
env: HOME={work}/home
env: JET_KEYS_DIR={work}/keys
step: jet registry keygen
exit: 1
stdout: empty
stderr: = ../../fixtures/jetpack-diagnostics/keygen_entropy_unavailable.stderr
file: keys absent
