# Port of tests/pkg.rs:8793-8825. The Rust test faked a closed-status crypto
# helper; Jet keygen draws from the OS, so the failure is the real one: the
# crypto_entropy no-entropy wrapper makes getrandom fail with ENOSYS for jet.
# Process-HOME-unchanged assertion8802 is covered by kit child-env isolation.
requires: os-name:linux
requires: arch:x86_64|aarch64
requires: tool:cc
mkdir: home
env: HOME={work}/home
env: JET_KEYS_DIR={work}/keys
copy: {root}/tests/cases/crypto_entropy/entropy_unavailable_propagates_through_every_consumer_on_all_tiers.fixture/no-entropy.c no-entropy.c
step: cc no-entropy.c -o no-entropy
exit: 0
step: {work}/no-entropy {jet} registry keygen
exit: 1
stdout: empty
stderr: = ../../fixtures/jetpack-diagnostics/keygen_entropy_unavailable.stderr
file: keys absent
