# `jet registry keygen [--registry <name>] [--force]` and `jet registry key backup [<dest>]
# [--registry <name>]` (Source/main.rs "keygen"/"key", CmdSupply.rs run_keygen/run_key_backup;
# c146, D-PKGSIGN1): the Ed25519 seed is owner-only, the public key is 64 hex digits, an existing key
# is E1248 without --force, and the backup is a byte copy of the seed.
requires: os:unix
requires: tool:cmp
mkdir: home
mkdir: project
env: HOME={work}/home
env: JET_KEYS_DIR={work}/keys
step: jet registry key backup
cwd: project
exit: 1
stderr: ~ "Error [jet.DriverOperationFailed]: No signing key for registry `jet` — run `jet registry keygen` first" # the E2105 headline; Why/Fix are the shared E2105 copy
file: project/jet-signing-key.backup absent
file: keys absent
step: jet registry keygen
cwd: project
exit: 0
stdout: ^= "created a signing key for registry `jet`.\n  public key:  " # the public key hex varies per run
stdout: ~ "\n  secret key:  <redacted>/jet.ed25519\n  public file: <redacted>/jet.ed25519.pub\n`jet registry key backup` writes this to <redacted>/jet.ed25519 — losing it means losing your ability to publish signed updates.\n" # the key lines name JET_KEYS_DIR's files, which the kit redacts
file: keys/jet.ed25519 size = 32
file: keys/jet.ed25519 mode = 0600
file: keys/jet.ed25519.pub size = 64
file: keys/jet.ed25519.pub mode = 0644
step: jet registry keygen
cwd: project
exit: 1
stdout: empty
stderr: ~ "Error [jet.SigningKeyExists]: `jet registry keygen` refused: a signing key already exists at `" # the headline names the existing seed path
step: jet registry keygen --force
cwd: project
exit: 0
stdout: ^= "created a signing key for registry `jet`.\n" # the rest names a fresh public key
file: keys/jet.ed25519 size = 32
file: keys/jet.ed25519 mode = 0600
step: jet registry key backup
cwd: project
exit: 0
stdout: = "backed up the `jet` signing key to ./jet-signing-key.backup\nwarning: store this file somewhere safe (e.g. a password manager). Anyone who has it can publish signed updates as you.\n"
file: project/jet-signing-key.backup size = 32
step: cmp keys/jet.ed25519 project/jet-signing-key.backup
exit: 0
step: jet registry key backup other.key --registry other
cwd: project
exit: 1
stderr: ~ "Error [jet.DriverOperationFailed]: No signing key for registry `other`" # the E2105 headline for the named registry
file: project/other.key absent
step: jet registry keygen --registry=other
cwd: project
exit: 0
stdout: ^= "created a signing key for registry `other`.\n" # the rest names a fresh public key
file: keys/other.ed25519 size = 32
step: jet registry key backup --registry other other.key
cwd: project
exit: 0
stdout: ^= "backed up the `other` signing key to other.key\n" # the safe-keeping warning line follows
step: cmp keys/other.ed25519 project/other.key
exit: 0
step: jet registry key rotate
cwd: project
exit: 1
stderr: ~ "Error [jet.UnknownCommand]: Unknown `jet registry key` subcommand `rotate` — did you mean `jet registry key backup`?" # the E2101 headline; Why/Fix are the shared E2101 copy
