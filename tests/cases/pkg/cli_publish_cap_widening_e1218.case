# A public type's written `#FX(…)` cap is a `cap` row of the API snapshot
# `jet registry publish` uploads, held by the same SemVer gate as every other
# row: a widened cap under a minor bump is E1218 and mutates nothing, and a
# narrowed one under the same minor bump passes.
fixture: cli_publish_cap_widening_e1218.fixture
requires: tool:git
mkdir: store
step: git init --bare {work}/registry.git
exit: 0
step: git init -b main
cwd: {work}/proj
exit: 0
step: git config user.email test@jet.test
cwd: {work}/proj
exit: 0
step: git config user.name "Jet Test"
cwd: {work}/proj
exit: 0
step: git add .
cwd: {work}/proj
exit: 0
step: git commit -m init
cwd: {work}/proj
exit: 0
step: git --git-dir {work}/registry.git symbolic-ref HEAD refs/heads/main
exit: 0
step: git clone file://{work}/registry.git {work}/review
exit: 0
mkdir: review/reviews/capkit
copy: reviews/capkit/1.0.0.review review/reviews/capkit/1.0.0.review
copy: reviews/capkit/1.1.0.review review/reviews/capkit/1.1.0.review
step: git config user.email test@jet.test
cwd: {work}/review
exit: 0
step: git config user.name "Jet Test"
cwd: {work}/review
exit: 0
step: git add .
cwd: {work}/review
exit: 0
step: git commit -m "approve core package"
cwd: {work}/review
exit: 0
step: git push origin HEAD:main
cwd: {work}/review
exit: 0
remove: review
step: jet registry publish --no-sign
cwd: {work}/proj
env: JET_REGISTRY_URL=file://{work}/registry.git
env: JET_REGISTRY_CACHE_DIR={work}/cache
env: JET_PACKAGE_STORE_DIR={work}/store
env: JET_KEYS_DIR={work}/keys
exit: 0
stdout: ~ "semver: first release" # the gate's progress line; the rest is the publish log
step: git --git-dir {work}/registry.git show HEAD:apis/capkit/1.0.0.api
exit: 0
stdout: ~ "cap Receipt #FX(IO, !FS)" # the cap row; the other rows are the fn, field and struct rows
step: git add .
cwd: {work}/proj
exit: 0
step: git commit -m "snapshot api"
cwd: {work}/proj
exit: 0
# `Receipt` may now reach the network under a minor bump: E1218, and the
# registry is untouched.
copy: run-widen.jet proj/run.jet
copy: package-1.1.0.jet proj/package.jet
step: git commit -am "widen the Receipt cap"
cwd: {work}/proj
exit: 0
step: jet registry publish --no-sign
cwd: {work}/proj
env: JET_REGISTRY_URL=file://{work}/registry.git
env: JET_REGISTRY_CACHE_DIR={work}/cache
env: JET_PACKAGE_STORE_DIR={work}/store
env: JET_KEYS_DIR={work}/keys
exit: 1
stderr: = ../../fixtures/jetpack-diagnostics/publish_cap_widened_e1218.stderr
step: git --git-dir {work}/registry.git cat-file -e HEAD:apis/capkit/1.1.0.api
exit: nonzero
# The same minor release with the cap narrowed instead passes.
copy: run-narrow.jet proj/run.jet
step: git add .
cwd: {work}/proj
exit: 0
step: git commit -m "narrow the Receipt cap"
cwd: {work}/proj
exit: 0
step: jet registry publish --no-sign
cwd: {work}/proj
env: JET_REGISTRY_URL=file://{work}/registry.git
env: JET_REGISTRY_CACHE_DIR={work}/cache
env: JET_PACKAGE_STORE_DIR={work}/store
env: JET_KEYS_DIR={work}/keys
exit: 0
stdout: ~ "semver: ok — public API compatible with v1.0.0" # the gate's progress line; the rest is the publish log
step: git --git-dir {work}/registry.git show HEAD:apis/capkit/1.1.0.api
exit: 0
stdout: ~ "cap Receipt #FX(IO, !FS, !Net)" # the narrowed cap row; the other rows are unchanged
