# tests/pkg.rs::vendor_rejects_symlink_sources_and_traversal_names at tests/pkg.rs:6389; hand-port
# Claim: vendoring refuses a dependency source that contains a symlink, leaving the symlink's target untouched, and refuses a traversal-shaped dependency name without writing outside the vendor tree (tests/pkg.rs:6410-6432)
# The original called Publish::vendor with a hand-made lock and dependency map (internal API); its public route is `jet registry vendor --vendor-dir <dir>` (as in tests/cases/pkg/cli_vendor_dir_flag_relocates.case), so each dependency reaches it through a package.jet: `dep: ./source` and `"../escape": ./safe-source`
# The source and safe-source package.jet bytes are the original's verbatim; the app manifests use the min_manifest shape of tests/cases/pkg/fixtures/vendor
requires: os:unix
requires: tool:git
fixture: vendor_rejects_symlink_sources_and_traversal_names.fixture
symlink: {work}/outside sym/source/leak
mkdir: store
env: JET_PACKAGE_STORE_DIR={work}/store
step: jet registry vendor --vendor-dir vendor-symlink
cwd: sym
exit: nonzero # tests/pkg.rs:6412 vendor must refuse source symlinks
stderr: !~ "E2104" # the refusal comes from vendor itself, not from an unbuilt command
file: outside = "must survive\n" # tests/pkg.rs:6415
step: jet registry vendor --vendor-dir vendor-name
cwd: name
exit: nonzero # tests/pkg.rs:6429 vendor must refuse traversal-shaped dependency names
stderr: !~ "E2104" # the refusal comes from vendor itself, not from an unbuilt command
file: name/escape absent # tests/pkg.rs:6432 !tmp.join("escape").exists()
