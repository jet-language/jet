use files: core.files

// A List of file readers emptied by assigning `[files.FileReader]{}` closes
// each reader once: as a variable, as a field written through `&self`, and
// as a write parameter. A second end of a closed reader would touch freed
// state (it hung on the reader's lock).
Holder: struct {
    open: [files.FileReader]

    clear: fn(&self) {
        self.open = [files.FileReader]{}
    }
}

empty_out: fn(readers: &[files.FileReader]) {
    readers = [files.FileReader]{}
}

run: fn() -[IO, FS.Read]> {
    local := [files.FileReader]{files.open("a.txt"), files.open("b.txt")}
    local = [files.FileReader]{}
    print("local {local.len()}")
    local.push(files.open("a.txt"))
    print("refilled {local.len()}")
    holder := Holder{open: [files.FileReader]{files.open("b.txt")}}
    holder.clear()
    print("field {holder.open.len()}")
    holder.open.push(files.open("a.txt"))
    holder.open = [files.FileReader]{}
    print("field again {holder.open.len()}")
    passed := [files.FileReader]{files.open("a.txt")}
    empty_out(passed)
    print("param {passed.len()}")
    again := files.open("b.txt")
    print("reopened {again.read_line() ?? "none"}")
}
