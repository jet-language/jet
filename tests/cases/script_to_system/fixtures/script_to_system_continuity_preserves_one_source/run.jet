// One useful file at the start of the continuity journey.
// The same functions and types remain the package, service, executable, and
// native Library surface after package metadata is added.
#CLI
TimerArgs: struct {
    #Doc("minutes to convert") minutes: Int{1}
}

seconds: fn(minutes: Int) -> Int { minutes * 60 }

run: fn(args: TimerArgs) {
    print(seconds(args.minutes))
}

serve: fn() {
    print(seconds(1))
}

dev: fn() {
    serve()
}

#Test("one minute is sixty seconds") {
    assert_eq(seconds(1), 60)
}

APP: Output.Executable{ name: "pulse", entry: run }
API: Output.Service{ name: "pulse-api", entry: serve }
defaults: { run: APP }
