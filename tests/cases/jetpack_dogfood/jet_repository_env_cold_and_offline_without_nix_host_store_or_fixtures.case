step: jetpack hangar du --json
cwd: project
isolate: no-nix network=enabled
env-clear: true
env: PATH=
env: HOME={work}/home
env: TMPDIR={work}/tmp
env: JETPACK_NIX_FALLBACK_POLICY=deny
env: CARGO_TARGET_DIR={cap:target}
env: CARGO_INCREMENTAL=0
env: CARGO_BUILD_JOBS=2
env: CARGO_NET_OFFLINE=true
env: CARGO_HOME={cap:cargo_home}
env: RUST_MIN_STACK=8388608
env: NO_COLOR=1
exit: 0
copy: project/.jet/lock online.lock
mkdir: replaced-catalog
step offline-tools: jetpack env --env compiler --trust --yes --offline --local-nix-catalog {work}/replaced-catalog -- bash -eu {work}/probe.sh
cwd: project
isolate: no-nix network=disabled
env-clear: true
env: PATH=
env: HOME={work}/home
env: TMPDIR={work}/tmp
env: JETPACK_NIX_FALLBACK_POLICY=deny
env: CARGO_TARGET_DIR={cap:target}
env: CARGO_INCREMENTAL=0
env: CARGO_BUILD_JOBS=2
env: CARGO_NET_OFFLINE=true
env: CARGO_HOME={cap:cargo_home}
env: RUST_MIN_STACK=8388608
env: NO_COLOR=1
exit: 0
stdout: $= "JETPACK_NATIVE_TOOLS_OK\n" # original predicate: native tool probe must finish
file: {work}/project/target/debug/jet ^= "\u007fELF" # original predicate: first four bytes are ELF, not a shell fixture
step offline-compiler-smoke: jetpack env --env compiler --trust --yes --offline --local-nix-catalog {work}/replaced-catalog -- {cap:target}/debug/jet run Examples/features/basics/hello.jet
