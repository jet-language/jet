# A directory target is a package: its `run.jet` and the `nested` member module hold one copy of each test.
fixture: fixtures/measured
step: jet test --show-default . --filter=needle --capture=all
env: NO_COLOR=1
exit: 0
stdout: ~ "needle" # original predicate
stdout: !~ "other: pass" # original predicate
step: jet test --show-default . --measure --filter=measured-needle --capture=all
env: NO_COLOR=1
exit: 0
stdout: count "measured-needle: pass" = 2 # one row per module
stdout: count "measure measured-needle:" = 2 # one measurement row per module
stdout: !~ "measured-other" # original predicate
step: jet test --show-default . --measure --filter=measured-needle --json
env: NO_COLOR=1
exit: 0
json: stdout ndjson $ #= 2
json: stdout ndjson $[*] : object # original pattern
json: stdout ndjson $[*].name = "measured-needle"
json: stdout ndjson $[*] has "mean_ns" # original predicate: key presence
