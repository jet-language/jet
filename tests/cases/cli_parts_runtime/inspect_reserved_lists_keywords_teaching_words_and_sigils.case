# PENDING-SAME-HEAD: runtime not run.
# PENDING-GRAMMAR(batch-four).
step: jet inspect reserved
env: NO_COLOR=1
exit: 0
stdout: ~ "copy" # original predicate
stdout: ~ "mut" # original predicate
stdout: ~ "take" # original predicate
stdout: ~ "const" # original predicate
stdout: ~ "unsafe" # original predicate
stdout: ~ "::" # original predicate
stdout: ~ ":=" # original predicate
stdout: ~ "&" # original predicate
stdout: ~ "^" # original predicate
# `~` is no sigil: the retired prefix `~x` teaches E0941 (spec.md:1200, syntax-decisions.md:23).
stdout: ~ "@" # original predicate
stdout: ~ "fn" # original predicate
step: jet inspect reserved --json
env: NO_COLOR=1
exit: 0
stdout: ~ "\"keywords\":[" # original predicate
stdout: ~ "\"teaching_reserved\":[" # original predicate
stdout: ~ "\"sigils\":[" # original predicate
json: stdout doc $ valid # original predicate: parses
