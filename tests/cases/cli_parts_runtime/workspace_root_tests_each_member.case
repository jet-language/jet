# `jet test` at a workspace root with two runnable members tests each one as its own
# child `jet test <member>`, instead of asking which member to pick; each member's
# output is written whole after its `jet test: member` line, and the exit is the worst
# member's. `--quiet` drops the member lines.
fixture: fixtures/test_workspace
env: NO_COLOR=1
env: TERM=dumb
step: jet test --capture=all
cwd: {work}/shop
exit: 1
stdout+stderr: !~ "ambiguous" # a workspace test never asks which member to run
stderr: ~ "jet test: member `alpha`" # each member's output follows its own line
stderr: ~ "jet test: member `beta`" # each member's output follows its own line
stdout: ~ "alpha ran" # alpha's test ran in its own child
stdout: ~ "beta ran" # beta's test ran in its own child
stdout: ~ "1 passed, 0 failed" # alpha's own summary
stdout: ~ "1 passed, 1 failed" # beta's own summary: its failing test sets the exit
step: jet test . --capture=all --quiet
cwd: {work}/shop
exit: 1
stderr: !~ "jet test: member" # --quiet drops the member lines
stdout: ~ "alpha ran" # the members still run
stdout: ~ "beta ran" # the members still run
copy: fixed/run.jet shop/beta/run.jet
step: jet test shop --capture=all
cwd: {work}
exit: 0
stdout: ~ "1 passed, 0 failed" # a workspace directory argument tests the same way
stdout: ~ "2 passed, 0 failed" # beta passes now
stdout: !~ "1 failed" # every member passes
