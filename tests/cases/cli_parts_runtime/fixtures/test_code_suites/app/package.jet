// Code suites: test.jet's `fn test` declares the `sizes` suite, which the
// `sizes` profile runs beside the package's #Tests and `rows` runs alone.
name: "suited"
version: "0.1.0"
edition: "2026"
test: {
    sizes: TestProfile{ suites: [tests, sizes] },
    rows: TestProfile{ suites: [sizes] },
}
