// The `sizes` code suite: one row per check.
use {
    files: core.files
    sys: core.sys
    core.testing.[TestRows]
}

sizes_rows: fn(rows: TestRows) {
    rows.pass("size hello")
    rows.skip("slow", "needs a release build")
    // A filtered run selects the rows it reports: the suite skips the work
    // of a row it doesn't select.
    if !rows.selects("suite env") -> return
    jet: sys.get("JET") ?? ""
    root: sys.get("JET_TEST_SUITE_ROOT") ?? ""
    if files.is_file(jet) && files.is_file(files.join(root, "package.jet")) {
        rows.pass("suite env")
    } else {
        rows.fail("suite env", "JET `{jet}`, JET_TEST_SUITE_ROOT `{root}`")
    }
}
