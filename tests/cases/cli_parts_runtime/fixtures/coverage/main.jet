Point: struct {
    x: Int
    y: Int
}

impl Point {
    sum: fn(self) -> Int {
        self.x + self.y
    }

    unused: fn(self) -> Int {
        self.x - self.y
    }
}

impl Point.Display {
    display: fn(self) -> String {
        "({self.x}, {self.y})"
    }
}

double: fn(n: Int) -> Int {
    n * 2
}

never_called: fn(n: Int) -> Int {
    n + 1
}

#Test("adds") {
    p: Point{x: 1, y: 2}
    assert_eq(p.sum(), 3)
    assert_eq(double(4), 8)
}

run: fn() {}
