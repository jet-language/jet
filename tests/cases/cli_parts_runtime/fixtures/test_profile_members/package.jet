// A workspace whose `all` test profile runs every member's #Tests in one
// `tests` run: `adder`'s test passes and `breaker`'s fails.
name: "members"
version: "0.1.0"
edition: "2026"
members: [
    "adder",
    "breaker",
]
test: {
    all: TestProfile{ suites: [tests] },
}
defaults: { test: all }
