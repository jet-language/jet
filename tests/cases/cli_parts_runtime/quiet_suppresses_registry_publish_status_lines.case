# PENDING-SAME-HEAD: runtime not run.
# PENDING-GRAMMAR(batch-four).
# The fixture packages are `jet init` output plus `license:`: publish refuses
# a package with no SPDX license (E2607) before the gate output checked here.
fixture: fixtures/publish
step: jet registry publish
cwd: loud
env: NO_COLOR=1
env: JET_KEYS_DIR={work}/loud/keys
exit: 1
stdout: ~ "publishing" # original predicate
stdout: ~ "[1/3]" # original predicate
step: jet registry publish --quiet
cwd: quiet
env: NO_COLOR=1
env: JET_KEYS_DIR={work}/quiet/keys
exit: 1
stdout.trim: empty # original predicate
stderr: ~ "build: failed" # original predicate
