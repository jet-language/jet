# A test profile's `tests` run over a workspace runs each member in a child `jet test`,
# and every member's #Test verdicts reach the profile: its rows and its `results`
# document hold the passing member's test and the failing member's as FAIL, not only
# the verdicts of the member that finished last.
fixture: fixtures/test_profile_members
env: NO_COLOR=1
env: TERM=dumb
step: jet test --profile all --results={work}/results.json
cwd: {work}
exit: 1
stderr: ~ "jet test: profile `all`, run `tests`" # the profile runs the members' #Tests
stderr: ~ "`tests`: 2 rows recorded as the baseline `.jet/test/all/tests.rows`" # one row per member's test
file: .jet/test/all/tests.rows ~ "adder adds" # the passing member's row
file: .jet/test/all/tests.rows ~ "breaker breaks" # the failing member's row
file: results.json ~ "\"PASS\":1," # the passing member's verdict is counted
file: results.json ~ "\"case\":\"adder adds\",\"detail\":\"\",\"diff\":\"\",\"exit\":0,\"peak_kib\":0,\"status\":\"PASS\"" # the passing member's test is a row
file: results.json ~ "\"case\":\"breaker breaks\",\"detail\":\"`panic: expected: 3, got: 2`\",\"diff\":\"\",\"exit\":0,\"peak_kib\":0,\"status\":\"FAIL\"" # the failing member's test is a FAIL row
