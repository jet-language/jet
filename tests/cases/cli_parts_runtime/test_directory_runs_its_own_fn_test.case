# `jet test <dir>` and a bare `jet test` in the package run the directory's own `test: fn`
# (its `test.jet` command home), as `jet build <dir>` runs its `build: fn`; `--show-default`
# tests the stock entry instead.
fixture: fixtures/test_directory
step: jet test . --serial --capture=all
env: NO_COLOR=1
exit: 0
stdout: ~ "directory entry" # test runner adds summary lines around the entry's own output
stdout: ~ "stock: pass" # test runner adds summary lines around the entry's own output
step: jet test --serial --capture=all
env: NO_COLOR=1
exit: 0
stdout: ~ "directory entry" # test runner adds summary lines around the entry's own output
stdout: ~ "stock: pass" # test runner adds summary lines around the entry's own output
step: jet test . --show-default --serial --capture=all
env: NO_COLOR=1
exit: 0
stderr: ~ "jet test: using stock default" # test runner adds summary lines around the entry's own output
stdout: !~ "directory entry" # test runner adds summary lines around the entry's own output
stdout: ~ "stock: pass" # test runner adds summary lines around the entry's own output
