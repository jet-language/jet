# `jet test` settings (D-TEST-INVOKE1=A): each is a flag, a TestProfile field and a
# `t.<setting>(…)` call on test.jet's `Test`, layered profile, then `fn test`, then flag.
# `jet test` prints the settings it used and where each came from. `list` names the tests
# and runs none, `shard` runs one slice and never writes the baseline, `results` writes
# one document of the run's rows (one for every level of a multi-level run), and
# `compiler` names the jet the children run. The corpus-pool settings need a corpus
# suite, and a `fn test` setting after `t.run()` is refused. Each part has its negative
# control.
fixture: fixtures/test_profiles
env: NO_COLOR=1
env: TERM=dumb
step: jet test --list
cwd: {work}/app
exit: 0
stdout: ~ "adds" # list names each test
stdout: ~ "waits a moment" # list names each test
stdout: !~ "passed" # list runs no test
stderr: ~ "time_limit 60000ms (profile `quick`), list true (flag)" # each setting names its layer
file: app/.jet/test/quick/tests.rows absent # a list run records no baseline
step: jet test --list -u
cwd: {work}/app
exit: 2
stderr: ~ "`list` (flag) and `update_snapshots` (flag) don't combine" # list blesses nothing
step: jet test --shard=0/8
cwd: {work}/app
exit: 2
stderr: ~ "`--shard` needs I/N with 1 <= I <= N, such as `2/4`, not `0/8`" # the range is named
step: jet test --shard=9/8
cwd: {work}/app
exit: 2
stderr: ~ "not `9/8`" # past the count is refused too
step: jet test --results=missing/r.json
cwd: {work}/app
exit: 1
stderr: ~ "`results` file `missing/r.json` (flag) can't be written" # refused before any test runs
step: jet test --shard=1/2 --results=r.json --compiler={jet}
cwd: {work}/app
exit: 0
stdout: ~ "1 passed, 0 failed" # shard 1 of 2 runs one of the two tests
stdout: !~ "waits a moment" # the other test is shard 2's
stderr: ~ "a sharded run never writes the baseline" # the shard records nothing
file: app/.jet/test/quick/tests.rows absent # the shard records nothing
file: app/r.json ~ "\"case\":\"adds\"" # results holds the run's rows
file: app/r.json ~ "\"suites\":[\"tests\"]" # under the tests suite
step: jet test --capture=all
cwd: {work}/app
exit: 0
stderr: ~ "2 rows recorded as the baseline" # an unsharded run records it
step: jet test --show-default --optimize=none,basic --results=lv.json --compiler={jet}
cwd: {work}/app
exit: 0
file: app/lv.json ~ "\"tier\":\"tests at optimize none\"" # one document holds every level's rows
file: app/lv.json ~ "\"tier\":\"tests at optimize basic\"" # one document holds every level's rows
file: app/lv.json ~ "\"suites\":[\"tests\"]" # under the tests suite
file: app/lv.none.json absent # no file per level
step: jet test --show-default --jobs=2
cwd: {work}/app
exit: 2
stderr: ~ "`jobs` (flag) steers the corpus suites, and this run has none" # a plain run has no corpus pool
stderr: ~ "E2104" # refused with the settings code
stdout: !~ "passed" # no test ran
step: jet test --profile quick --diagnostic-coverage
cwd: {work}/app
exit: 2
stderr: ~ "`diagnostic_coverage` (flag) steers the corpus suites, and this run has none" # quick runs only #Tests
step: jet test --profile full --jobs=1
cwd: {work}/app
exit: 0
stdout: ~ "PASS\ttests/golden/greet.jet\to0" # a profile with a corpus suite takes the pool width
copy: alt/settings-test.jet app/test.jet
step: jet test
cwd: {work}/app
exit: 0
stderr: ~ "shard 2/2 (fn test), results code.json (fn test)" # fn test's calls replace the profile's
stdout: ~ "1 passed, 0 failed" # shard 2 of 2 runs the other test
stdout: ~ "waits a moment" # shard 2's test
stderr: ~ "1 rows against `.jet/test/quick/tests.rows`: 0 lost" # a shard compares only its own rows
file: app/code.json ~ "\"case\":\"waits a moment\"" # fn test's results file
step: jet test --shard=1/1 --capture=all
cwd: {work}/app
exit: 0
stderr: ~ "shard 1/1 (flag)" # the flag replaces fn test's shard
stdout: ~ "2 passed, 0 failed" # the whole run
copy: alt/bad-shard-test.jet app/test.jet
step: jet test
cwd: {work}/app
exit: 2
stderr: ~ "`t.shard(…)` needs I/N with 1 <= I <= N, such as `2/4`, not `9/8`" # a bad call is refused before any test runs
stdout: !~ "passed" # no test ran
copy: alt/late-setting-test.jet app/test.jet
step: jet test
cwd: {work}/app
exit: 2
stderr: ~ "`t.serial(…)` comes after `t.run()`, whose tests already ran without it" # a late call is refused
stdout: !~ "passed" # no test ran
