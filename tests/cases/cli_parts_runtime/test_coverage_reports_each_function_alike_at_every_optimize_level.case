# `jet test --coverage` lists each of the tested file's own functions and methods, by line, as
# HIT or MISS after the test report, never the #Test or `run`; every optimize level reports alike.
fixture: fixtures/coverage
step: jet test main.jet --coverage
env: NO_COLOR=1
exit: 0
stdout: = test_coverage.out
step: jet test main.jet --coverage -O0
env: NO_COLOR=1
exit: 0
stdout: = test_coverage.out
step: jet test main.jet --coverage -O1
env: NO_COLOR=1
exit: 0
stdout: = test_coverage.out
step: jet test main.jet --coverage -O2
env: NO_COLOR=1
exit: 0
stdout: = test_coverage.out
step: jet test main.jet --coverage --json
env: NO_COLOR=1
exit: 0
stdout: ~ "\"action\":\"coverage\"" # the coverage status line follows the test status
stdout: ~ "\"name\":\"double\",\"line\":20,\"covered\":true" # a function the test calls
stdout: ~ "\"name\":\"never_called\",\"line\":24,\"covered\":false" # a function no test calls
