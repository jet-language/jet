# A command home without its function is inert: `build.jet`, `dev.jet` and
# `test.jet` here hold only comments, so `jet build`, `jet dev` and `jet test`
# keep their stock defaults over the `run.jet` entry.
fixture: fixtures/command_homes/inert
env: NO_COLOR=1
step: jet run
exit: 0
stdout: = "stock run\n"
step: jet build
exit: 0
file: .jet/build/run exists
step: jet test --serial --capture=all
exit: 0
stdout: ~ "stock body: pass" # the stock harness ran the package tests
step: jet dev --watch=off
exit: 0
stdout: = "stock run\n"
