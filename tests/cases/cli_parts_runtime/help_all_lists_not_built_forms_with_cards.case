step: jet help --all
env: NO_COLOR=1
normalize: replace {jet-semver} "VERSION"
exit: 0
stdout: = help_all.txt
stdout: ~ "Not built yet:" # the command model's unported rows follow the usage page
stdout: ~ "jet self exec" # an unported action is listed with its card
step: jet help
env: NO_COLOR=1
exit: 0
stdout: !~ "Not built yet:" # plain help lists only built forms
stdout: !~ "jet self exec" # plain help leaves out unported actions
