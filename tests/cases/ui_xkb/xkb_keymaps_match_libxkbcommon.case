# core.ui.xkb against libxkbcommon 1.13.2: main.jet plays keys.script over
# keymaps that xkbcli-compile-keymap (libxkbcommon 1.13.2, xkeyboard-config
# 2.48, --output-format 1) dumped for us, de, fr, ru, us+de
# (grp:alt_shift_toggle) and us(intl) (compose:rctrl). expected.out is what
# libxkbcommon's xkb_state and xkb_compose_state (libX11 1.8.13 en_US.UTF-8
# Compose) report for the same script; its `repeat` lines count the repeats
# wl_keyboard.repeat_info defines (the first after `delay` ms, then `rate`
# per second).
fixture: xkb_keymaps_match_libxkbcommon.fixture
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step aot: jet build main.jet
exit: 0
step native: built
exit: 0
stdout: = expected.out
step default: jet run main.jet
exit: == native
stdout: == native
stderr: == native
