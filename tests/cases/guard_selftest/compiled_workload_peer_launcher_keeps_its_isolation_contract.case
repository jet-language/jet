# The native peer launcher (Tools/ci/CompiledWorkloadPeerLauncher.jet)
# keeps its whole isolation contract with no C import: its focused proof
# builds it and its probe workload, then checks the filesystem, network, path,
# authority, result, signal (the default action re-raised through
# core.sys.reset_signal) and descendant contracts.
requires: tool:bwrap
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet {root}/Tools/ci/CompiledWorkloadPeerLauncherCheck.jet
exit: 0
stdout: = "peer launcher self-test: filesystem, network, path, authority, result, signal, and descendant checks passed\n"
