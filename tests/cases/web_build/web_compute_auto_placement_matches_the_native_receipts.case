# `.Auto` placement on the web host has the native host's one meaning: it
# selects WebGPU only when the browser grants a device and the storage keeps
# its precision there, and otherwise selects the CPU oracle with the native
# receipt. The CPU lines are the native goldens' text
# (Examples/features/expected/tooling/compute_device.out line 2 and
# compute_tensor.out line 6); the harness runs the live Prelude JS.
requires: tool:node
fixture: web_compute_auto_placement_matches_the_native_receipts.fixture
env: NO_COLOR=1
mkdir: build
copy: package.json build/package.json
copy: {root}/Compiler/Prelude/Web/Core/ComputeWebGpu.js build/compute_webgpu.js
copy: harness.mjs build/harness.mjs
step: node harness.mjs
cwd: build
exit: 0
stdout: = web_compute_auto_placement_matches_the_native_receipts.stdout.expected
