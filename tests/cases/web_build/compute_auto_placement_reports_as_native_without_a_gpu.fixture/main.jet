// `.Auto` placement on a host with no GPU: the CPU oracle runs the tensor,
// the placement report names it, and an explicit WebGPU request is a
// `Device` error, on the web as on the native host.
use compute: core.compute

run: fn() {
    seed: compute.matrix(2, 2, 1.5) ?? panic("seed")
    auto: compute.on_device(seed, compute.device_auto()) ?? panic("auto")
    sum: compute.add(auto, auto) ?? panic("add")
    print(compute.to_list(sum))
    print(compute.placement(sum))
    if compute.on_device(seed, compute.device_webgpu()) == {
        .Ok(gpu) -> print(compute.placement(gpu))
        .Err(error) -> print("webgpu: {error}")
    }
}
