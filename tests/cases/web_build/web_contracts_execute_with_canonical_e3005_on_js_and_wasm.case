# A failed `#Pre` or `#Post` clause in a web (wasm) build stops with the
# canonical E3005 report, as every native tier does: the `#Pre` report points
# at the call site, the `#Post` report at its clause in the signature, and the
# program exits 70. The web build has one engine (wasm), so each fixture is
# built and run once.
requires: tool:node
fixture: web_contracts_execute_with_canonical_e3005_on_js_and_wasm.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet build --target web tests/fixtures/web_contract_pre.jet
exit: 0
file: tests/fixtures/.jet/build/web.manifest.json ~ "\"partitions\"" # the wasm build's partition table
file: tests/fixtures/.jet/build/app.wasm is-file
step: node app.js
cwd: tests/fixtures/.jet/build
exit: 70
stdout: empty
stderr: ~ "Stop [E3005]: #Pre contract failed: positive" # the stop family's contract header
stderr: ~ "--> web_contract_pre.jet:7 in run" # a `#Pre` breach points at the call site
stderr: ~ "print(checked(0))" # the quoted call line
stderr: ~ "Why: A `#Pre` (argument claim, checked at entry) or `#Post` (`result` claim, checked before return) condition evaluated false at runtime." # the registry row's why
stderr: ~ "Fix: Fix the caller (a failed `#Pre` means an argument violated the function's stated contract) or the function body (a failed `#Post` means it broke its own promise about the result)." # the registry row's fix
stderr: ~ "More: jet-lang.dev/e/E3005" # the registry row's link
step: jet build --target web tests/fixtures/web_contract_post.jet
exit: 0
file: tests/fixtures/.jet/build/app.wasm is-file
step: node app.js
cwd: tests/fixtures/.jet/build
exit: 70
stdout: empty
stderr: ~ "Stop [E3005]: #Post contract failed: grows" # the stop family's contract header
stderr: ~ "--> web_contract_post.jet:1 in checked" # a `#Post` breach points at the function's clause
stderr: ~ "Post(result > value, \"grows\")" # the quoted clause line
stderr: ~ "Why: A `#Pre` (argument claim, checked at entry) or `#Post` (`result` claim, checked before return) condition evaluated false at runtime." # the registry row's why
stderr: ~ "More: jet-lang.dev/e/E3005" # the registry row's link
