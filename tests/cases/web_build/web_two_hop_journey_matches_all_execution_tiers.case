# A two-hop `?` failure prints one report on every tier: the built binary,
# `jet run` and the interpreter natively, and the web build, whose host
# passes the shared runtime's stderr through and formats no report of its
# own. The JS fixture's `#Target(JS)` line shifts its lines by one.
requires: tool:node
fixture: web_two_hop_journey_matches_all_execution_tiers.fixture
env: NO_COLOR=1
step: jet build web_two_hop_journey.jet
exit: 0
step aot: built
exit: 1
stdout: empty
stderr.trim_end: = web_two_hop_journey_matches_all_execution_tiers.report.expected # the runtime ends its report with a newline
step default: jet run web_two_hop_journey.jet
exit: 1
stdout: empty
stderr.trim_end: = web_two_hop_journey_matches_all_execution_tiers.report.expected # the runtime ends its report with a newline
step interpret: jet run web_two_hop_journey.jet
exit: 1
stdout: empty
stderr.trim_end: = web_two_hop_journey_matches_all_execution_tiers.report.expected # the runtime ends its report with a newline
step: jet build --target web js/tests/fixtures/web_two_hop_journey.jet
exit: 0
file: js/tests/fixtures/.jet/build/web.manifest.json ~ "\"partitions\"" # the manifest lists the runtime and app partitions
file: js/tests/fixtures/.jet/build/app.wasm is-file
file: js/tests/fixtures/.jet/build/jet_dom_runtime.js !~ "failed here" # the host formats no report
file: js/tests/fixtures/.jet/build/jet_dom_runtime.js !~ "Trail [" # the host formats no report
copy: harness.mjs js/tests/fixtures/.jet/build/two_hop_journey_harness.mjs
step: node two_hop_journey_harness.mjs
cwd: js/tests/fixtures/.jet/build
exit: 0
stdout: has-line "JetHostExitError status=1" # the host only reports the exit status
stderr.trim_end: = web_two_hop_journey_matches_all_execution_tiers.js-report.expected # the runtime ends its report with a newline
step: jet build --target web wasm/tests/fixtures/web_two_hop_journey.jet
exit: 0
file: wasm/tests/fixtures/.jet/build/web.manifest.json ~ "\"partitions\"" # the manifest lists the runtime and app partitions
file: wasm/tests/fixtures/.jet/build/app.wasm is-file
copy: harness.mjs wasm/tests/fixtures/.jet/build/two_hop_journey_harness.mjs
step: node two_hop_journey_harness.mjs
cwd: wasm/tests/fixtures/.jet/build
exit: 0
stdout: has-line "JetHostExitError status=1" # the host only reports the exit status
stderr.trim_end: = web_two_hop_journey_matches_all_execution_tiers.report.expected # the runtime ends its report with a newline
