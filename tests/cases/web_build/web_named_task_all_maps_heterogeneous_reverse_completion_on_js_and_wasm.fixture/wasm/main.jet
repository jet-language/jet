
#Target(Web)
slow: fn() -> String {
    turns := 0
    loop _ in 0..<50000 {
        turns += 1
    }
    return "slow"
}
fast: fn() -> Int {
    return 7
}
run: fn() {
    values: (task.all {
        z: slow(),
        a: fast()
    }) ?? panic("named task.all failed")
    print(values.z)
    print(values.a)
}
