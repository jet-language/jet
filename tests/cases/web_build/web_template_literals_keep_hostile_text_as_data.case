# A string holding a backtick, a backslash, `${owned}` and a newline stays
# data in the built page: it prints that text, and the interpolated value,
# unchanged.
requires: tool:node
fixture: web_template_literals_keep_hostile_text_as_data.fixture
env: NO_COLOR=1
step: jet build --target web --json main.jet
exit: 0
file: .jet/build/web.manifest.json ~ "\"target\": \"web\"" # the manifest names the web target
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_template_literals_keep_hostile_text_as_data.stdout.expected
