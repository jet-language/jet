# core.ui's Wayland wire part runs only on Linux (`comptime if #build.target.os`): a web build of a
# program that opens a window builds without reaching it, and `ui.open` answers NoDisplay.
requires: tool:node
fixture: web_ui_open_answers_no_display.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: = "open: NoDisplay\n"
stderr: = ""
