#Target(Web)

#Target(JS)
js_value: fn() -[]> Int {
    value := 0
    #Impure("preserve JS body") {
        value = 7
    }
    return value
}
#Export(wasm)
wasm_value: fn() -[]> Int {
    value := 0
    #Impure("preserve Wasm body") {
        value = 9
    }
    return value
}
run: fn() { print(js_value()) }
