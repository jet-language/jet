#Target(Web)
square: fn(n: Int) -[]> Int { return n * n }
summarize: fn(limit: Int) -[]> Int {
    total := square(limit)
    if total > 10 { return total } else { return total + 1 }
}
scratch: fn(limit: Int, text: String, flag: Bool, ratio: Float) { print(limit) }
run: fn() { print(summarize(4)) }
