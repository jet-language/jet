#Target(Web)

#Target(JS)
sum_to: fn(n: Int) -[]> Int {
    total := 0
    i := 0
    loop {
        if i >= n { break }
        total = total + i
        i = i + 1
    }
    return total
}
#Target(JS)
sum_while: fn(n: Int) -[]> Int {
    total := 0
    i := 0
    loop i < n {
        i += 1
        if i == 2 { next }
        total += i
    }
    return total
}
#Target(JS)
sum_counted: fn(n: Int) -[]> Int {
    total := 0
    loop i in 0..<n { total += i }
    return total
}
#Target(JS)
bump: fn(n: Int) -[]> Int {
    xs := [n]
    xs[0] = 9
    return xs[0]
}
