// A typed Person form renders its canonical progressive endpoint and feeds the
// matching App action with the same checked model contract.
use web: core.web
#Target(Web)

#Web.Form
Person: struct {
    id: Int
    name: String
    active: Bool
}

save: fn(input: Person) -> String { "saved {input.name}" }

home: fn() -> WebPage {
    form: web.form(Person, action: save)
    form.set("id", "7") ?? panic("id set")
    form.set("name", "Ada") ?? panic("name set")
    web.page("People", form.render())
}

run: fn() {
    web.app()
        .route("/", home)
        .form("save", save)
        .serve()
}
