#Target(Web)
#WasmExport
fn wasm_pick(flag: Bool) -[]> Int {
    if flag -> {
        n :: 6
        n + 1
    } else -> { 3 }
}

#Target(JS)
fn js_pick(flag: Bool) -[]> Int {
    if flag -> {
        n :: 6
        n + 2
    } else -> { 4 }
}

#Target(JS)
fn run() {
    print(js_pick(true))
    print(if true -> wasm_pick(true) else -> 0)
}
