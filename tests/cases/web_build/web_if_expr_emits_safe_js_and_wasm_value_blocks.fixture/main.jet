#Target(Web)
#Export(wasm)
wasm_pick: fn(flag: Bool) -[]> Int {
    if flag -> {
        n: 6
        n + 1
    } else -> { 3 }
}

#Target(JS)
js_pick: fn(flag: Bool) -[]> Int {
    if flag -> {
        n: 6
        n + 2
    } else -> { 4 }
}

#Target(JS)
run: fn() {
    print(js_pick(true))
    print(if true -> wasm_pick(true) else -> 0)
}
