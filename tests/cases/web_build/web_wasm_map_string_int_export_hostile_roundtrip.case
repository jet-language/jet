# A `[String:Int]` map through `#Export(wasm)` functions keeps hostile keys and
# values on the page. The wasm build calls the exports from the program
# itself; it has no JavaScript-callable export bridge yet, so the retired JS
# emitter's ABI harnesses have nothing to call.
requires: tool:node
fixture: web_wasm_map_string_int_export_hostile_roundtrip.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/app.wasm is-file
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_wasm_map_string_int_export_hostile_roundtrip.stdout.expected
stderr: empty
