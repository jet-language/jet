#Target(Web)
#Error
enum StoreErr { Missing }

impl StoreErr -> Err {
    return Err("store unavailable")
}

fn read_store() -> Int StoreErr! {
    return Err(StoreErr.Missing)
}

fn get_user() -> Int Err! {
    value :: read_store()
    return Ok(value)
}

#Target(Wasm)
fn run() {
    if get_user() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> { print(error.message) }
        else -> {}
    }
}
