#Target(Web)
#Error
StoreErr: enum { Missing }

impl Err.From(StoreErr) {
    from: fn(error: StoreErr) -> Err { return Err("store unavailable") }
}

read_store: fn() -> Int StoreErr! {
    return Err(StoreErr.Missing)
}

get_user: fn() -> Int Err! {
    value: read_store()
    return Ok(value)
}

#Target(Wasm)
run: fn() {
    if get_user() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> { print(error.message) }
    }
}
