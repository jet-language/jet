# core.ui.host's provider seam: a provider answers primitives only and Core owns every rule, decoded
# value and UIHostError. Native defines the leaves headless, so every capability is absent there and the
# request validation answers match the web run's; the web run stubs `globalThis.jetUiProvider` and gets Core's
# answers to its raw events, clipboard text and dialog results: length-prefixed provider records carry IME and
# dropped text holding U+241F and U+001F intact, and an unknown IME event type and a malformed record each fail.
requires: tool:node
fixture: ui_host_provider_answers_are_core_owned.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: = ui_host_provider_answers_are_core_owned-native.out
step: jet build --target web main.jet
exit: 0
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: = ui_host_provider_answers_are_core_owned-web.out
