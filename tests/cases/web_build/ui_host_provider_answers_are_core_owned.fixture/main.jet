package: {
    name: "ui_host_provider"
    version: "0.1.0"
    authority: {
        allow: [IO, Mem.Alloc, Browser, FS]
        needs: [UI.FileDialog, UI.Clipboard, UI.IME, UI.DragDrop, UI.Shortcuts, UI.Accessibility]
    }
}
// Every core.ui.host service through the provider seam. Core validates each
// request, decodes each provider answer and owns every UIHostError; the
// provider only answers primitives. Native has no provider, so each capability
// is absent; the web harness stubs one.
use {
    ui: core.ui
    host: core.ui.host
    accessibility: core.ui.host.accessibility
    clipboard: core.ui.host.clipboard
    drag_drop: core.ui.host.drag_drop
    ime: core.ui.host.ime
    shortcuts: core.ui.host.shortcuts
}

show_ime: fn() {
    if ime.poll() == {
        .Ok(event) -> print("ime: {event}")
        .Err(error) -> print("ime: {error}")
    }
}

show_drop: fn() {
    if drag_drop.poll() == {
        .Ok(event) -> print("drop: {event}")
        .Err(error) -> print("drop: {error}")
    }
}

run: fn() {
    facts: host.capabilities()
    loop fact in facts.facts -> print("capability {fact.capability}: {fact.available}")

    grant: host.fs_grant(".", host.fs_rights_read_write()) ?? panic("the working directory grant is valid")
    multiple: UIFileDialogRequest{kind: .Save, title: "Save", grant: grant.copy(), initial_directory: None, filters: [UIFileFilter]{}, allow_multiple: true}
    if host.save_file(multiple) == {
        .Ok(selection) -> print("save multiple: {selection.files.len()} files")
        .Err(error) -> print("save multiple: {error}")
    }
    if host.open_file(host.save_request(grant.copy())) == {
        .Ok(selection) -> print("open with a save request: {selection.files.len()} files")
        .Err(error) -> print("open with a save request: {error}")
    }
    if host.open_file(host.open_request(grant.copy())) == {
        .Ok(selection) -> { loop file in selection.files -> print("open: {file.path} in {file.grant_root}") }
        .Err(error) -> print("open: {error}")
    }
    if host.save_file(host.save_request(grant.copy())) == {
        .Ok(selection) -> print("save: {selection.files.len()} files")
        .Err(error) -> print("save: {error}")
    }

    if clipboard.read_text() == {
        .Ok(read) -> print("clipboard read: {read.text}")
        .Err(error) -> print("clipboard read: {error}")
    }
    if clipboard.write_text("café ☕") == {
        .Ok(write) -> print("clipboard write: {write.characters} characters")
        .Err(error) -> print("clipboard write: {error}")
    }
    if clipboard.read_text() == {
        .Ok(read) -> print("clipboard read: {read.text}")
        .Err(error) -> print("clipboard read: {error}")
    }

    show_ime()
    show_ime()
    show_ime()
    show_drop()
    show_drop()

    save: UIShortcut.cmd("s")
    if shortcuts.register(shortcuts.binding(save.copy(), "save") ?? panic("the save binding is valid")) == {
        .Ok(binding) -> print("register: {binding.action}")
        .Err(error) -> print("register: {error}")
    }
    if shortcuts.register(shortcuts.binding(save.copy(), "share") ?? panic("the share binding is valid")) == {
        .Ok(binding) -> print("register again: {binding.action}")
        .Err(error) -> print("register again: {error}")
    }
    if shortcuts.dispatch(save) == {
        .Ok(dispatched) -> print("dispatch: {dispatched}")
        .Err(error) -> print("dispatch: {error}")
    }

    metadata: host.accessibility("Notes", "The notes editor") ?? panic("the metadata is valid")
    node: ui.text("Notes")
    if accessibility.attach(node.copy(), metadata) == {
        .Ok(attached) -> print("attach: {attached.accessibility != None}")
        .Err(error) -> print("attach: {error}")
    }
    if accessibility.project(node, UINodeID{value: "notes"}) == {
        .Ok(projection) -> print("project bare node: {projection}")
        .Err(error) -> print("project bare node: {error}")
    }
}
