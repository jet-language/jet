#Target(Web)
Toggle: enum { On Off }

#Target(JS)
make_result: fn(flag: Bool) -> Int Err! {
    if flag -> return Ok(7)
    return Err("x")
}
#Target(JS)
make_opt: fn(flag: Bool) -> Int? {
    if flag -> return .Val(3)
    return .None
}
#Target(JS)
classify: fn(flag: Bool) -> Int {
    if make_result(flag) == {
        .Ok(n) -> return n
        .Err(_) -> return -1
    }
}
#Target(JS)
maybe: fn(flag: Bool) -> Int {
    x: make_opt(flag)
    if x == .None { return 0 }
    if x == .Val(n) { return n }
    return -1
}
#Target(JS)
js_make_toggle: fn(flag: Bool) -> Toggle {
    if flag { return .On }
    return .Off
}
#Target(JS)
js_matches_and: fn(flag: Bool) -> Int {
    x: make_opt(flag)
    toggle: js_make_toggle(flag)
    if x == .Val(n) && toggle == .On && flag { return n }
    return 0
}
#Target(Wasm)
wasm_make_result: fn(flag: Bool) -> Int Err! {
    if flag -> return Ok(7)
    return Err("x")
}
#Target(Wasm)
wasm_make_opt: fn(flag: Bool) -> Int? {
    if flag -> return .Val(3)
    return .None
}
#WasmExport
wasm_classify: fn(flag: Bool) -> Int {
    if wasm_make_result(flag) == {
        .Ok(n) -> return n
        .Err(_) -> return -1
    }
}
#WasmExport
wasm_maybe: fn(flag: Bool) -> Int {
    x: wasm_make_opt(flag)
    if x == .None { return 0 }
    if x == .Val(n) { return n }
    return -1
}
#Target(Wasm)
wasm_make_toggle: fn(flag: Bool) -> Toggle {
    if flag { return .On }
    return .Off
}
#WasmExport
wasm_matches_and: fn(flag: Bool) -> Int {
    x: wasm_make_opt(flag)
    toggle: wasm_make_toggle(flag)
    if x == .Val(n) && toggle == .On && flag { return n }
    return 0
}
run: fn() {}
