# #6425 c5: the never_helper_callers golden program, built for the web, prints
# the same lines as its O0, O1 and O2 golden rows (tests/run/FailureFoundation/NeverHelperCallers.out).
requires: tool:node
fixture: web_never_helper_callers_match_native_output.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: = web_never_helper_callers_match_native_output.stdout.expected
