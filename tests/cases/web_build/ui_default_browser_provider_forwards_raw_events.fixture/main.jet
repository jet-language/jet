package {
    name: "ui_default_provider"
    version: "0.1.0"
    authority: {
        allow: [IO, Mem.Alloc, Browser, FS]
        needs: [UI.FileDialog, UI.Clipboard, UI.IME, UI.DragDrop]
    }
}
// The page's default core.ui.host provider forwards browser primitives only:
// the harness's DOM stub fires composition, drag/drop and paste events before
// the run, and Core decodes and judges each one.
use {
    host :: core.ui.host
    clipboard :: core.ui.host.clipboard
    drag_drop :: core.ui.host.drag_drop
    ime :: core.ui.host.ime
}

fn show_ime() {
    if ime.poll() == {
        .Ok(event) -> print("ime: {event}")
        .Err(error) -> print("ime: {error}")
    }
}

// Prints every drag/drop event but the dragover flood, which it counts.
fn show_drops() {
    over := 0
    loop {
        if drag_drop.poll() == {
            .Ok(found) -> {
                event :: found ?? break
                if event.phase == .Over { over += 1 } else { print("drop: {event}") }
            }
            .Err(error) -> print("drop: {error}")
        }
    }
    print("drop: {over} dragover events")
}

fn run() {
    facts :: host.capabilities()
    loop fact in facts.facts -> print("capability {fact.capability}: {fact.available}")

    grant :: host.fs_grant(".", host.fs_rights_read()) ?? panic("the working directory grant is valid")
    if host.open_file(host.open_request(grant)) == {
        .Ok(selection) -> print("open: {selection.files.len()} files")
        .Err(error) -> print("open: {error}")
    }

    if clipboard.read_text() == {
        .Ok(read) -> print("clipboard read: {read.text}")
        .Err(error) -> print("clipboard read: {error}")
    }
    if clipboard.write_text("café ☕") == {
        .Ok(write) -> print("clipboard write: {write.characters} characters")
        .Err(error) -> print("clipboard write: {error}")
    }
    if clipboard.read_text() == {
        .Ok(read) -> print("clipboard read: {read.text}")
        .Err(error) -> print("clipboard read: {error}")
    }

    loop _ in 0..<5 -> show_ime()
    show_drops()
}
