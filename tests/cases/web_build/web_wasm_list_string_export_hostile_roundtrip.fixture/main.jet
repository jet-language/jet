// D-JSBIND1: Wasm #Export(wasm) [String] ABI (contiguous count/len/utf8
// blob) with hostile empty / empty-elem / tab+newline / Unicode / multi roundtrip.
#Export(wasm)
echo_strs: fn(xs: [String]) -> [String] { xs.copy() }

#Export(wasm)
count_strs: fn(xs: [String]) -> Int {
    n := 0
    loop x in xs -> n += 1
    return n
}

#Target(JS)
run: fn() {
    empty: [String]{}
    print(count_strs(empty))
    print(count_strs([""]))
    print(echo_strs([""]))
    print(echo_strs(["ascii-ok"]))
    print(echo_strs(["tab\tline\nbreak"]))
    print(echo_strs(["emoji🌍"]))
    print(echo_strs(["a", "b", "c"]))
}
