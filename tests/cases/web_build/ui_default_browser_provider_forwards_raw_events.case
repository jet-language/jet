# A page with no `globalThis.jetUiProvider` gets the web runtime's default core.ui.host provider (#6596), which
# forwards raw browser primitives only: event types, data and drop effects. A DOM stub fires paste, composition
# and drag/drop events before the run, and Core maps each record: event types to phases (an empty compositionend
# cancels), the caret after the composition text in characters, uri-list lines to URI items, and the host
# buffer's overflow mark to QueueFull. IME and dropped text holding U+241F and U+001F arrive intact; the
# clipboard answers the pasted text, then the program's own write; file dialogs and font shaping are absent. A
# drag leave's raw `none` effect is no operation (D-UI-DRAG-NONE1=A).
requires: tool:node
fixture: ui_default_browser_provider_forwards_raw_events.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: = ui_default_browser_provider_forwards_raw_events.out
