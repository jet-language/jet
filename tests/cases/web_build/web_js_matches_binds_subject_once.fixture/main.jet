#Target(Web)
Toggle: enum { On Off }

#Target(JS)
make_opt: fn(n: Int) -> Int? { .Val(n) }

#Target(JS)
make_toggle: fn() -> Toggle { .On }

#Target(JS)
classify: fn(n: Int) -[]> Int {
    opt: make_opt(n)
    toggle: make_toggle()
    if opt == .Val(value) && toggle == .On { return value }
    return 0
}

#Target(JS)
run: fn() { print(classify(2)) }
