#Target(Web)
enum Toggle { On Off }

#Target(JS)
fn make_opt(n: Int) -> Int? { .Val(n) }

#Target(JS)
fn make_toggle() -> Toggle { .On }

#Target(JS)
fn classify(n: Int) -[]> Int {
    opt :: make_opt(n)
    toggle :: make_toggle()
    if opt == .Val(value) && toggle == .On { return value }
    return 0
}

#Target(JS)
fn run() { print(classify(2)) }
