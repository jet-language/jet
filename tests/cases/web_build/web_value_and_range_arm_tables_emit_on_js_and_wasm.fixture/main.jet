#Target(Web)

#Target(JS)
fn digit(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#Target(JS)
fn band(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        else -> { "high" }
    }
}
#WasmExport
fn wasm_digit(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#WasmExport
fn wasm_band(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        10..19 -> { "mid" }
        else -> { "high" }
    }
}
fn run() {}
