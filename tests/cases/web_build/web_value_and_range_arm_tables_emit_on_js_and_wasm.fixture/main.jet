#Target(Web)

#Target(JS)
digit: fn(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#Target(JS)
band: fn(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        else -> { "high" }
    }
}
#WasmExport
wasm_digit: fn(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#WasmExport
wasm_band: fn(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        10..19 -> { "mid" }
        else -> { "high" }
    }
}
run: fn() {}
