#Target(Web)

#Numeric Severity: distinct Int(0..10)

#UnitFamily(Length, base: meter) {
    meter
    half(scale: 1/2)
}

Input: tag { deny: [IO] }

#Scrub(Input) clean: fn(raw: #Input String) -> String { raw.copy() }

ReservationStage: enum {
    Created
    Paid
}

exactness_value: fn() -> Bool {
    lossy: Int{9007199254740993}
    zero: Float{0.0}
    return approx(lossy) > zero
}

unit_value: fn() -> Float {
    value: Meter.from_float(Float{5.0})
    return value.raw()
}

state_value: fn() -> String {
    stage: ReservationStage.Paid
    if stage == {
        .Created -> { return "invalid" }
        .Paid -> { return "state" }
    }
}

classification_value: fn() -> String {
    raw: #Input "world"
    return clean(raw)
}

run: fn() {
    left: Severity.from_int(4)
    right: Severity.from_int(5)
    total: wrapping(left + right)
    exactness: exactness_value()
    unit: unit_value()
    state: state_value()
    classification: classification_value()
    print("42")
    print("exactness={exactness}")
    print("unit={unit}")
    print("state={state}")
    print("classification={classification}")
    print("range={total}")
}
