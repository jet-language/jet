# HAND-PORT tests/web_build.rs:3091-3160 web_wasm_try_returns_typed_journey
# The old emitter's `JetError` rejection (kind/code/journey/frame) is replaced
# by what a page observes: `jet_main()` rejects with JetHostExitError, status 1
# for the unhandled `Err` (as `jet run` exits), and the host writes the same
# report the native edge writes: the error, where it failed (main.jet:3) and
# its `?` trail (read at main.jet:8, run at main.jet:14).
requires: tool:node
fixture: web_wasm_try_returns_typed_journey.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
file: .jet/build/web.manifest.json ~ "\"target\": \"web\"" # was: ~ "\"status\": \"m2\"" (the old emitter's milestone label)
file: .jet/build/web.manifest.json ~ "\"partitions\"" # original build_web_fixture partitions predicate
file: .jet/build/app.wasm is-file
copy: harness.mjs .jet/build/harness.mjs
step: node harness.mjs
cwd: .jet/build
exit: 0
stdout: ~ "status=1" # was: kind=JetError, code=TRYFAIL, journey and frame lines
stderr: ~ "Error [TRYFAIL]: try failed" # original contains predicate
stderr: ~ "load (main.jet:3)" # was: stdout frame
stderr: ~ "read (main.jet:8)" # was: stdout ~ "read" (journey)
stderr: ~ "run (main.jet:14)" # was: stdout ~ "run" (journey)
