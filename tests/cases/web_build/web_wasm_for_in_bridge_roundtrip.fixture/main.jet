// D-WEBBACKEND1: Wasm compute lowers plain `loop x in xs` ForIn from
// checked IR (parity with JS `for…of`), summing an ABI-safe [Int] param.
#Export(wasm)
sum_list: fn(xs: [Int]) -> Int {
    total := 0
    loop x in xs -> total += x
    return total
}

#Target(JS)
run: fn() {
    empty: [Int]{}
    print(sum_list(empty))
    print(sum_list([1, 2, 3]))
    print(sum_list([-1, 0, 4]))
}
