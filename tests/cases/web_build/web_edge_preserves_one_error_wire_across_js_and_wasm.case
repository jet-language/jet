# An unhandled default Err prints one report on every tier: `jet run`
# natively, and the Wasm and `#Target(JS)` web builds, whose host passes the
# shared runtime's stderr through and formats no report of its own. A
# successful web run reports status 0 and an Ok outcome at the raw Wasm edge.
requires: tool:node
fixture: web_edge_preserves_one_error_wire_across_js_and_wasm.fixture
env: NO_COLOR=1
step: jet run --quiet wasm/Examples/features/errors/default_err_edge.jet
exit: 1
stdout: empty
stderr.trim_end: = web_edge_preserves_one_error_wire_across_js_and_wasm.cli-report.expected # the runtime ends its report with a newline
step: jet build --target web wasm/Examples/features/errors/default_err_edge.jet
exit: 0
file: wasm/Examples/features/errors/.jet/build/web.manifest.json ~ "\"partitions\"" # the manifest lists the runtime and app partitions
file: wasm/Examples/features/errors/.jet/build/app.wasm is-file
file: wasm/Examples/features/errors/.jet/build/jet_dom_runtime.js !~ "failed here" # the host formats no report
file: wasm/Examples/features/errors/.jet/build/jet_dom_runtime.js !~ "Error [" # the host formats no report
copy: edge-harness.mjs wasm/Examples/features/errors/.jet/build/failure_edge_harness.mjs
step: node failure_edge_harness.mjs
cwd: wasm/Examples/features/errors/.jet/build
exit: 0
stdout: has-line "JetHostExitError status=1" # the host only reports the exit status
stderr.trim_end: = web_edge_preserves_one_error_wire_across_js_and_wasm.cli-report.expected # the runtime ends its report with a newline
step: jet build --target web js/tests/fixtures/default_err_edge.jet
exit: 0
file: js/tests/fixtures/.jet/build/web.manifest.json ~ "\"partitions\"" # the manifest lists the runtime and app partitions
file: js/tests/fixtures/.jet/build/app.wasm is-file
copy: edge-harness.mjs js/tests/fixtures/.jet/build/failure_edge_harness.mjs
step: node failure_edge_harness.mjs
cwd: js/tests/fixtures/.jet/build
exit: 0
stdout: has-line "JetHostExitError status=1" # the host only reports the exit status
stderr.trim_end: = web_edge_preserves_one_error_wire_across_js_and_wasm.cli-report.expected # the runtime ends its report with a newline
step: jet build --target web ok/tests/fixtures/failure_edge_wasm_ok.jet
exit: 0
file: ok/tests/fixtures/.jet/build/app.wasm is-file
copy: ok-harness.mjs ok/tests/fixtures/.jet/build/failure_edge_wasm_ok_harness.mjs
step: node failure_edge_wasm_ok_harness.mjs
cwd: ok/tests/fixtures/.jet/build
exit: 0
stdout: = web_edge_preserves_one_error_wire_across_js_and_wasm.ok-edge.expected
