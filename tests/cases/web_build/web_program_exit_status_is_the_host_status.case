# The web target runs the one runtime selected to WebAssembly, and the
# generated host only marshals: a program's nonzero exit status (73) is the
# status `node app.js` exits with, and its stdout is flushed before it.
requires: tool:node
fixture: web_program_exit_status_is_the_host_status.fixture
env: NO_COLOR=1
step: jet build --target web main.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 73
stdout: = "before exit\n"
stderr: = ""
