// D-JSBIND1 / #123: JS event callback invokes a #Export(wasm) bridge (JS -> Wasm
// inside a browser-style handler), proving callback + compute round-trip.
use web: core.web

#Export(wasm)
double: fn(n: Int) -> Int { n * 2 }

#Target(JS)
init: fn() {
    web.on("#go", "click", fn(ev) {
        if double(21) == 42 {
            print("42")
        }
        web.storage.local.set("clicked", "yes")
    })
}

run: fn() {}
