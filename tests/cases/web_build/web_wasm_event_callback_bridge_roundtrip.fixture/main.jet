// D-JSBIND1: JS event callback invokes a #Export(wasm) bridge (JS -> Wasm
// inside a browser-style handler), proving callback + compute round-trip.
use {
    host: core.browser.host
    core.browser.storage.local
}

#Export(wasm)
double: fn(n: Int) -> Int { n * 2 }

#Target(JS)
init: fn() {
    host.on("#go", "click", fn(ev) {
        if double(21) == 42 {
            print("42")
        }
        local.set("clicked", "yes")
    })
}

run: fn() {}
