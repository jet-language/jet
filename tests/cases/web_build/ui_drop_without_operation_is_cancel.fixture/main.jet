package: {
    name: "ui_drop_cancel"
    version: "0.1.0"
    authority: {
        allow: [IO, Mem.Alloc, Browser]
        needs: [UI.DragDrop]
    }
}
// D-UI-DRAG-NONE1=A: a drag event's operation is optional, and a drop the
// browser offers no operation for arrives as Cancel.
use drag_drop: core.ui.host.drag_drop

run: fn() {
    loop {
        if drag_drop.poll() == {
            .Ok(found) -> {
                event: found ?? break
                print("{event.phase} {event.operation} {event.items.len()}")
            }
            .Err(error) -> print("drop: {error}")
        }
    }
}
