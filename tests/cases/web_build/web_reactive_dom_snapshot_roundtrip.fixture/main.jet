// D-WEBBACKEND1 M2 + D-RENDERTGT2=A (c133/c123 Phase 7): a reactive signal
// drives a DOM-backend render loop, compiled to JS (and runnable natively).
// D-UI-MOUNT1=A: one-call mount (3-arg keeps the 200×100 golden viewport).
package: {
    name: "ui_web_reactive"
    authority: { allow: [Browser, IO] }
}

use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    backend: ui.null_backend()
    label: reactive.signal("hello")
    ui.reactive_render(fn() {
        node: ui.node(label.get(), 100.0, 20.0)
        ui.mount(backend, node, ui.constraint(0.0, 0.0, 200.0, 100.0))
    })
    loop cmd in backend.commands() -> print(cmd)
    label.set("world")
    loop cmd in backend.commands() -> print(cmd)
}
