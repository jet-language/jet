# The forms_table app (main.jet, Examples/Apps/Web/FormsTable.jet's program)
# builds for the web. Its server can't listen on a page, so page.jet renders
# the same `home` page without the server: the typed Person form's field and
# action markup on the page is byte for byte what `jet run` prints.
requires: tool:node
fixture: forms_table_web_lowering_preserves_typed_form_contract.fixture
env: NO_COLOR=1
step: jet build --target=web main.jet
exit: 0
file: .jet/build/app.wasm is-file
file: .jet/build/rt.wasm is-file
step native: jet run page.jet
exit: 0
stdout: = "People\n<form action=\"save\" method=\"POST\"><label>id<input name=\"id\" type=\"number\" value=\"7\" required></label><label>name<input name=\"name\" type=\"text\" value=\"Ada\" required></label><label>active<input name=\"active\" type=\"checkbox\" value=\"\" required></label><button type=\"submit\">Submit</button></form>\n"
step: jet build --target=web page.jet
exit: 0
step: node app.js
cwd: .jet/build
exit: 0
stdout: == native
stderr: empty
