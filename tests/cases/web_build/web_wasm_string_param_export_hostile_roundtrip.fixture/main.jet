// D-JSBIND1 / #123: Wasm #Export(wasm) String *param* ABI (packed ptr/len) with
// hostile empty / tab+newline / Unicode roundtrip through the JS bridge.
#Export(wasm)
echo_str: fn(s: String) -> String { s.copy() }

#Target(JS)
run: fn() {
    print(echo_str(""))
    print(echo_str("ascii-ok"))
    print(echo_str("tab\tline\nbreak"))
    print(echo_str("emoji🌍"))
}
