
#Target(JS)
fn run() {
    nums :: [1, 2, 3, 4]
    doubled :: nums.map((n: Int) -> n * 2)
    evens :: nums.filter((n: Int) -> n > 2)
    lazy_evens :: nums.lazy().filter((n: Int) -> n > 2).map((n: Int) -> n * 10).to_list()
    print(doubled[0])
    print(doubled[3])
    print(evens[0])
    print(evens[1])
    print(lazy_evens[0])
    print(lazy_evens[1])
    }
    