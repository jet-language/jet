
#Target(JS)
run: fn() {
    nums: [1, 2, 3, 4]
    doubled: nums.map(fn(n: Int) { n * 2 })
    evens: nums.filter(fn(n: Int) { n > 2 })
    lazy_evens: nums.lazy().filter(fn(n: Int) { n > 2 }).map(fn(n: Int) { n * 10 }).to_list()
    print(doubled[0])
    print(doubled[3])
    print(evens[0])
    print(evens[1])
    print(lazy_evens[0])
    print(lazy_evens[1])
    }
    