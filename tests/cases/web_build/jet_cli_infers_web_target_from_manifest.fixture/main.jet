use {
    ui: core.ui
    core.color.[Color]
}
run: fn() {
    b: ui.null_backend()
    n: ui.node_color("hi", 10.0, 5.0, Color{r: 51, g: 102, b: 255, a: 255})
    c: ui.constraint(0.0, 0.0, 50.0, 20.0)
    s: b.measure(n, c)
    f: ui.rect(0.0, 0.0, s.width, s.height)
    b.layout(n, f)
    b.paint(n)
}
