#Target(Web)
Packet: enum {
    Data(Int)
    Empty
}

#Target(JS)
make_packet: fn(n: Int) -> Packet { .Data(n) }

#Target(JS)
make_opt: fn(n: Int) -> Int? { .Val(n) }

#Target(JS)
bind_opt: fn(n: Int) -[]> Int {
    if make_opt(n) == .Val(value) { return value }
    return 0
}

#Target(JS)
classify_range: fn(n: Int) -[]> Int {
    packet: make_packet(n)
    if packet == {
        .Data(1..3) -> return 1
        else -> return 0
    }
}

#Target(Wasm)
wasm_packet: fn(n: Int) -> Packet { .Data(n) }

#WasmExport
wasm_classify: fn(n: Int) -[]> Int {
    packet: wasm_packet(n)
    if packet == {
        .Data(1..3) -> return 1
        else -> return 0
    }
}

run: fn() {}
