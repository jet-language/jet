// D-JSBIND1: Wasm #Export(wasm) [String:Int] ABI with hostile empty,
// control-character, Unicode, full-width signed, and JS -> Wasm -> JS -> Wasm roundtrip.
#Export(wasm)
echo_scores: fn(scores: [String:Int]) -> [String:Int] { scores.copy() }

#Export(wasm)
score: fn(scores: [String:Int], key: String) -> Int { scores[key] }

#Export(wasm)
verify_limits: fn(scores: [String:Int]) -> Int { scores["min"] + scores["max"] + (scores["above-safe"] - 9007199254740992) + (scores["below-safe"] + 9007199254740992) }

#Target(JS)
run: fn() {
    empty: [String:Int]{}
    empty_roundtrip: echo_scores(empty)
    _empty_twice: echo_scores(empty_roundtrip)
    scores: [String:Int]{
        "": 0,
        "tab\tline\nbreak": -7,
        "emoji🌍": 42,
        "z": 99,
        "min": Int.MIN,
        "max": Int.MAX,
        "above-safe": 9007199254740993,
        "below-safe": -9007199254740993
    }
    roundtrip: echo_scores(scores)
    print(score(roundtrip, ""))
    print(score(roundtrip, "tab\tline\nbreak"))
    print(score(roundtrip, "emoji🌍"))
    print(score(roundtrip, "z"))
    print(verify_limits(roundtrip))
}
