// D-JSBIND1: Wasm #Export(wasm) [Int] ABI (packed ptr/len i64 payload)
// with hostile empty / zero / signed / mixed roundtrip through the JS bridge.
#Export(wasm)
echo_list: fn(xs: [Int]) -> [Int] { xs.copy() }

#Target(JS)
run: fn() {
    empty: [Int]{}
    print(echo_list(empty))
    print(echo_list([0]))
    print(echo_list([-1, 2, -3]))
    print(echo_list([42, 0, -7, 99]))
}
