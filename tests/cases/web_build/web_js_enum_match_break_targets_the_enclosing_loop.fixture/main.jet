#Target(Web)
enum Choice { Stop Keep }

#Target(JS)
fn count(choice: Choice) -[]> Int {
    hits := 0
    loop i in 0..<3 {
        if choice == {
            .Stop -> { break }
            .Keep -> {}
        }
        hits += 1
    }
    return hits
}

#Target(JS)
fn run() { print(count(.Stop)) }
