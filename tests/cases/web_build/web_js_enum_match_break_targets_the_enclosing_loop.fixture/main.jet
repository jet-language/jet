#Target(Web)
Choice: enum { Stop Keep }

#Target(JS)
count: fn(choice: Choice) -[]> Int {
    hits := 0
    loop i in 0..<3 {
        if choice == {
            .Stop -> { break }
            .Keep -> {}
        }
        hits += 1
    }
    return hits
}

#Target(JS)
run: fn() { print(count(.Stop)) }
