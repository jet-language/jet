# D-TAIL-CALL1=A (#6358 C1): a call the function returns is a jump on O0, O1
# and O2, so `walk` 10 million deep, mutual `is_even`/`is_odd` 10 million deep
# and a String-handing `hop` 3 million deep all finish in constant stack and
# print the same result on every level (a frame per level stops with E3012).
fixture: tail_calls_run_in_constant_stack_on_every_level.fixture
env: NO_COLOR=1
step: jet run -O0 main.jet
exit: 0
stdout: = tail_calls_run_in_constant_stack_on_every_level.out
step: jet run -O1 main.jet
exit: 0
stdout: = tail_calls_run_in_constant_stack_on_every_level.out
step: jet run -O2 main.jet
exit: 0
stdout: = tail_calls_run_in_constant_stack_on_every_level.out
step: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = tail_calls_run_in_constant_stack_on_every_level.out
