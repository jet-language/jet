# #6427 (D-DROP-ASAP1=A, D-TAIL-CALL1=A): a Child bound in a function that
# ends in a call keeps its process tree alive through that call on every
# tier. A tail jump would drop the Child (killing the tree) before the
# callee runs, and the callee would print "killed" instead of "kept".
fixture: tail_call_keeps_a_child_tree_to_scope_end.fixture
when os windows
refused: PENDING-SEAM(win-process-query)
end when
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
step: jet run --optimize=none main.jet
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
step: jet build --optimize=none main.jet
exit: 0
step: built
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
step: jet build --release main.jet
exit: 0
step: built
exit: 0
stdout: = tail_call_keeps_a_child_tree_to_scope_end.out
