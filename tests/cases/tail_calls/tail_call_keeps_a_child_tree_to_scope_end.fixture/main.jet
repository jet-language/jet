// #6427 (D-DROP-ASAP1=A, D-TAIL-CALL1=A): `hold` ends in a call, but its
// Child's Drop kills the process tree, so that Drop runs after the call
// returns and the call is not a tail jump. The callee sees the tree write
// `later` (it waits up to 30 s, for a loaded machine); dropping the Child
// before the call would kill the tree first, and the callee print "killed".
package {
    name: "tail_call_child"
    authority: { allow: [Exec, FS, IO] }
}

use {
    fs :: core.files
    process :: core.process
    time :: core.time
}

fn hold() {
    child :: process.cmd(["/bin/sh", "-c", "sleep 0.1; : > later; sleep 60"]).spawn() ?? panic("cannot spawn the tree")
    wait_later(3000)
}

fn wait_later(left: Int) {
    if fs.exists("later") {
        print("kept")
    } else if left == 0 {
        print("killed")
    } else {
        time.sleep(10ms)
        wait_later(left - 1)
    }
}

fn run() {
    if fs.exists("later") -> fs.remove_all("later") ?? panic("cannot clean later")
    hold()
}
