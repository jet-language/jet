run: fn() {
    values: [1, 2, 3, 4]
    print(values.para_map(fn(n: Int) { n * 2 }))
    print(values.para_filter(fn(n: Int) { n % 2 == 0 }))
    split: values.para_partition(fn(n: Int) { n % 2 == 0 })
    print(split.false_)
    print(split.true_)
    print(values.para_fold(fn() { 0 }, fn(acc: Int, n: Int) { acc + n }, fn(left: Int, right: Int) { left + right }))
}
