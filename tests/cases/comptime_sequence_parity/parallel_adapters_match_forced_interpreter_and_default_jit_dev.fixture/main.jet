fn run() {
    values :: [1, 2, 3, 4]
    print(values.para_map((n: Int) -> n * 2))
    print(values.para_filter((n: Int) -> n % 2 == 0))
    split :: values.para_partition((n: Int) -> n % 2 == 0)
    print(split.false_)
    print(split.true_)
    print(values.para_fold(() -> 0, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right))
}
