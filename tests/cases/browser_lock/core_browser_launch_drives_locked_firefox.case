# core.browser.launch starts the Firefox that `jetpack browser provision`
# admitted into the Jetpack store from the repository browser catalog and
# pinned in .jet/lock, headless on a throwaway profile; it drives the engine
# over its own WebDriver BiDi endpoint (open a page, evaluate its
# script-computed text) and stops it at close. It needs no browser on PATH.
# Chromium has no locked driver, so launch refuses it.
opt-in: live cache.nixos.org closure download (about 500 MB); run deliberately with --opt-in or by exact id
fixture: core_browser_launch_drives_locked_firefox.fixture
env: NO_COLOR=1
requires: os-name:linux
env: JET_PROJECT_ROOT={work}
step: jetpack browser provision firefox@jetpack --local-nix-catalog {root}/Jetpack/Environment/Catalogs/browsers --yes
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/main.jet
exit: 0
stdout: = core_browser_launch_drives_locked_firefox.1.out
chmod: chromium 0755
step: jetpack browser lock chromium --binary {work}/chromium --version 152.0 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/chromium.jet
exit: 0
stdout: = core_browser_launch_drives_locked_firefox.2.out
