# core.browser.launch starts the Firefox pinned in .jet/lock headless on a
# throwaway profile, drives it over its own WebDriver BiDi endpoint (open a
# page, evaluate its script-computed text), and stops it at close. Chromium
# has no locked driver, so launch refuses it.
fixture: core_browser_launch_drives_locked_firefox.fixture
env: NO_COLOR=1
requires: os-name:linux
requires: tool:firefox
env: JET_PROJECT_ROOT={work}
step: jetpack browser lock firefox --binary {tool:firefox} --version 157.0.1 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/main.jet
exit: 0
stdout: = core_browser_launch_drives_locked_firefox.1.out
chmod: chromium 0755
step: jetpack browser lock chromium --binary {work}/chromium --version 152.0 --protocol bidi-2025.5
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/chromium.jet
exit: 0
stdout: = core_browser_launch_drives_locked_firefox.2.out
