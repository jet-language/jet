# core.browser.launch starts the Chromium that `jetpack browser provision`
# admitted into the Jetpack store from the repository browser catalog and
# pinned in .jet/lock, through the chromedriver provisioned beside it; it
# drives the engine over that session's WebDriver BiDi socket (open a page,
# evaluate its script-computed text), sends a CDP command and reads a CDP event
# through goog:cdp, and stops both at close. It needs no browser on PATH.
opt-in: live cache.nixos.org closure download (about 600 MB); run deliberately with --opt-in or by exact id
fixture: core_browser_launch_drives_locked_chromium.fixture
env: NO_COLOR=1
requires: os-name:linux
env: JET_PROJECT_ROOT={work}
step: jetpack browser provision chromium@jetpack --local-nix-catalog {root}/Jetpack/Environment/Catalogs/browsers --yes
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/main.jet
exit: 0
stdout: = core_browser_launch_drives_locked_chromium.1.out
