# core.browser.launch starts the Chromium pinned in .jet/lock through the
# chromedriver pinned beside it, drives it over that session's WebDriver BiDi
# socket (open a page, evaluate its script-computed text), sends a CDP command
# and reads a CDP event through goog:cdp, and stops both at close.
fixture: core_browser_launch_drives_locked_chromium.fixture
env: NO_COLOR=1
requires: os-name:linux
requires: tool:chromium
requires: tool:chromedriver
env: JET_PROJECT_ROOT={work}
step: jetpack browser lock chromium --binary {tool:chromium} --version 152.0.7977.64 --protocol bidi-2025.5 --driver {tool:chromedriver}
exit: 0
step: jet run --allow=Env,Exec,FS,IO,Net,Time {work}/main.jet
exit: 0
stdout: = core_browser_launch_drives_locked_chromium.1.out
