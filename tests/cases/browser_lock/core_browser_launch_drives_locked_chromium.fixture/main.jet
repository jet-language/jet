// Launch the locked Chromium through its locked chromedriver, send a CDP
// command and read a CDP event over goog:cdp, open a page whose script
// computes its text, read it back through BiDi evaluation, and close. Each
// fact prints only after the step before it succeeded.
use browser: core.browser

PAGE: "data:text/html,<title>launched</title><p id=out>pending</p><script>document.getElementById('out').textContent = 'computed ' + String(6 * 7)</script>"

run: fn() {
    session: browser.launch("chromium") ?? {
        print("launch failed: {err}")
        return
    }
    print("bidi:{session.abilities().bidi()} cdp:{session.abilities().cdp()}")
    cdp: session.protocol("cdp") ?? {
        print("cdp failed: {err}")
        return
    }
    version: cdp.send("Browser.getVersion", "{{}}") ?? {
        print("cdp send failed: {err}")
        return
    }
    print("cdp product:{version.contains("Chrome/152.0.7977.64")}")
    session.subscribe("goog:cdp.Page.frameNavigated") ?? {
        print("subscribe failed: {err}")
        return
    }
    context: session.context() ?? {
        print("context failed: {err}")
        return
    }
    page: context.page() ?? {
        print("page failed: {err}")
        return
    }
    page.goto(PAGE) ?? {
        print("goto failed: {err}")
        return
    }
    print("title:{page.title() ?? "error"}")
    print("text:{page.text() ?? "error"}")
    event: session.next_event(browser.timeout(10000) ?? return) ?? {
        print("event failed: {err}")
        return
    }
    print("event:{event.kind()}")
    page.close() ?? print("page close failed: {err}")
    context.close() ?? print("context close failed: {err}")
    session.close() ?? {
        print("close failed: {err}")
        return
    }
    print("closed:{session.receipt().cleaned()}")
    print("after close:{session.context() == .Err(_)}")
}
