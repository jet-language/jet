// A user enum may declare its own `Ok` and `Err` cases. When a call returns
// that enum, `.Ok(x)` and `.Err(e)` name the enum's cases, not the call's
// success or failure.
Reply: enum {
    Ok(Int)
    Err(String)
}

fetch: fn(v: Int) -> Reply {
    if v > 0 -> return Reply.Ok(v)
    Reply.Err("none")
}

table_value: fn(v: Int) -> Int {
    return if fetch(v) == {
        .Ok(got) -> got
        .Err(_) -> 0
    }
}

table_statement: fn(v: Int) {
    if fetch(v) == {
        .Ok(got) -> { print("ok {got}") }
        .Err(why) -> print("err {why}")
    }
}

test_form: fn(v: Int) -> Int {
    if fetch(v) == .Ok(got) -> return got
    99
}

test_bind: fn(v: Int) -> String {
    fetch(v) == .Err(why) ?? return "not an error"
    why
}

// A call that can fail still has its carrier matched by `.Ok` and `.Err`.
good: fn() -> Int Err! { return .Ok(4) }

bad: fn() -> Int Err! { return .Err("odd") }

carrier: fn(even: Bool) -> String {
    if even {
        return if good() == {
            .Ok(value) -> "half {value}"
            .Err(_) -> "odd"
        }
    }
    return if bad() == {
        .Ok(value) -> "half {value}"
        .Err(why) -> why.message
    }
}

// A callee that declares its failure keeps `.Ok` and `.Err` for its carrier,
// even when its success enum declares those cases itself.
#Error
Refusal: struct {
    message: String
}

parse: fn(v: Int) -> Reply Refusal! {
    if v < 0 -> return Err(Refusal{message: "negative"})
    Reply.Ok(v)
}

refusal: fn(v: Int) -> String {
    if parse(v) == {
        .Ok(_) -> {
            panic("expected {v} to be refused")
        }
        .Err(error) -> error.message
    }
}

run: fn() {
    print(table_value(4))
    print(table_value(-1))
    table_statement(5)
    table_statement(0)
    print(test_form(6))
    print(test_bind(-2))
    print(test_bind(2))
    print(carrier(true))
    print(carrier(false))
    print(refusal(-3))
}
