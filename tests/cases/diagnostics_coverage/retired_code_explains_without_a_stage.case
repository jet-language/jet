# A retired row runs in no stage, so `jet explain` prints none.
# Claim: the generated row of a retired code has an empty stage (Tools/agent/DiagnosticRows.jet)
# Claim: explain renders Stage only for a row that states one (Compiler/JetFoundation/Source/Registry/Explain.jet)
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet explain L1401 --verbose
exit: 0
stdout: = retired_code_explains_without_a_stage.stdout
stdout: !~ "Stage:" # a retired row states no stage
step: jet explain L1401 --json
exit: 0
stdout: ~ "\"stage\":null" # --json gives null, not ""
