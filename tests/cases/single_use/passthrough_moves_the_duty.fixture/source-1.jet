
#SingleUse Lock: struct {
    resource: String,
}
acquire: fn(resource: String) -> Lock {
    return Lock{ resource: resource }
}
release: fn(lock: ^Lock) {
    print(lock.resource)
}


hold: fn(lock: ^Lock) -> Lock {
    return lock
}
run: fn() {
    db: acquire("db")
    held: hold(^db)
    release(^held)
}
