
#SingleUse Lock: struct {
    resource: String,
}
acquire: fn(resource: String) -> Lock {
    return Lock{ resource: resource }
}
release: fn(lock: &&Lock) {
    print(lock.resource)
}


run: fn() {
    db: acquire("db")
    early: true
    if early {
        release(db)
    } else {
        release(db)
    }
}
