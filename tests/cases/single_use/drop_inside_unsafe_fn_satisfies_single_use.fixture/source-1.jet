
#SingleUse Lock: struct {
    resource: String,
}
acquire: fn(resource: String) -> Lock {
    return Lock{ resource: resource }
}
release: fn(lock: ^Lock) {
    print(lock.resource)
}


#Unsafe("voids a freshly-acquired lock whose resource is already gone")
void_one: fn() {
    db: acquire("db")
    consume(db)
}
run: fn() {
    #Unsafe("calling the audited voider") {
        void_one()
    }
}
