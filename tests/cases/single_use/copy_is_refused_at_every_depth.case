# A copy would give a `#SingleUse` value's one duty a second owner, so it is
# refused (E0211): a `.copy()` of the value on its own or inside a record, an
# enum payload, a list or an option, of Core's `mem.Block` the same way, and
# the implicit copy of an element read out of the list that keeps it.
fixture: copy_is_refused_at_every_depth.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet --json
exit: nonzero
json: stdout doc $.reports[?severity="error"] #= 8 # exactly the eight copies, nothing else
json: stdout doc $.reports[?code="E0211"][?why~="#SingleUse"] #= 8 # every copy is refused for the duty it would double
json: stdout doc $.reports[?code="E0211"][?why~="is `#SingleUse`"] #= 2 # `Lease` and `mem.Block` are copied themselves
json: stdout doc $.reports[?code="E0211"][?why~="holds a `#SingleUse` value"] #= 6 # the record, payload, list, option, block record and shelf element each hold one
json: stdout doc $.reports[?code="E0211"][?what="`Holder` can't be copied"] #= 1 # a record field holding one is enough
json: stdout doc $.reports[?code="E0211"][?what="`Lease` can't be copied out of the place it is read from"] #= 1 # the implicit copy is refused like the written one
