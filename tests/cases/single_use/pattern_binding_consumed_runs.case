# A `#SingleUse` payload bound by a pattern and released in its arm checks
# clean and runs the same on every tier.
fixture: pattern_binding_consumed_runs.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet check main.jet
exit: 0 # clean
step: jet run -O0 main.jet
exit: 0 # o0
stdout: = pattern_binding_consumed_runs.out # o0
step: jet run -O1 main.jet
exit: 0 # o1
stdout: = pattern_binding_consumed_runs.out # o1
step: jet run -O2 main.jet
exit: 0 # o2
stdout: = pattern_binding_consumed_runs.out # o2
