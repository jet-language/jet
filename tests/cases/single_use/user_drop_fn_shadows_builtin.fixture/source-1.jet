
#SingleUse Lock: struct {
    resource: String,
}
acquire: fn(resource: String) -> Lock {
    return Lock{ resource: resource }
}
release: fn(lock: ^Lock) {
    print(lock.resource)
}


drop: fn(n: Int) -> Int {
    return n + 1
}
run: fn() {
    db: acquire("db")
    release(^db)
    x: drop(41)
    print("{x}")
}
