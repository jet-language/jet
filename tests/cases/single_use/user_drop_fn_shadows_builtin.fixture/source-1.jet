
#SingleUse struct Lock {
    resource: String,
}
fn acquire(resource: String) -> Lock {
    return Lock.{ resource: resource }
}
fn release(lock: ^Lock) {
    print(lock.resource)
}


fn drop(n: Int) -> Int {
    return n + 1
}
fn run() {
    db :: acquire("db")
    release(^db)
    x :: drop(41)
    print("{x}")
}
