# tests/cc_cli.rs::c_drivers_are_registered_with_one_flag_surface at tests/cc_cli.rs:4; hand-port
# jet cc and jet c++ are builtin commands with one shared flag surface, and each validates its own flags, so the
# front door never rejects an unknown cc/c++ flag with E2102.
env: NO_COLOR=1
step: jet help cc
exit: 0 # tests/cc_cli.rs:6 `cc` is a builtin command
stdout: ~ "jet cc [options] <sources>\n" # tests/cc_cli.rs:8 the usage line ends with `cc [options] <sources>`
stdout: ~ "\n  --offline " # tests/cc_cli.rs:10-33 `cc` lists --offline
stdout: ~ "\n  --project-root " # tests/cc_cli.rs:10-33 `cc` lists --project-root
stdout: ~ "\n  --build-root " # tests/cc_cli.rs:10-33 `cc` lists --build-root
stdout: ~ "\n  -c " # tests/cc_cli.rs:10-33 `cc` lists -c
stdout: ~ "\n  -o " # tests/cc_cli.rs:10-33 `cc` lists -o
stdout: ~ "\n  -MMD " # tests/cc_cli.rs:10-33 `cc` lists -MMD
stdout: ~ "\n  -MD " # tests/cc_cli.rs:10-33 `cc` lists -MD
stdout: ~ "\n  -MF " # tests/cc_cli.rs:10-33 `cc` lists -MF
stdout: ~ "\n  -MT " # tests/cc_cli.rs:10-33 `cc` lists -MT
stdout: ~ "\n  --sysroot " # tests/cc_cli.rs:10-33 `cc` lists --sysroot
stdout: ~ "\n  -I " # tests/cc_cli.rs:10-33 `cc` lists -I
stdout: ~ "\n  -D " # tests/cc_cli.rs:10-33 `cc` lists -D
stdout: ~ "\n  -L " # tests/cc_cli.rs:10-33 `cc` lists -L
stdout: ~ "\n  -l " # tests/cc_cli.rs:10-33 `cc` lists -l
stdout: ~ "\n  -std " # tests/cc_cli.rs:10-33 `cc` lists -std
stdout: ~ "\n  --target " # tests/cc_cli.rs:10-33 `cc` lists --target
stdout: ~ "\n  -dumpmachine " # tests/cc_cli.rs:10-33 `cc` lists -dumpmachine
stdout: ~ "\n  -print-sysroot " # tests/cc_cli.rs:10-33 `cc` lists -print-sysroot
stdout: ~ "\n  -dumpversion " # tests/cc_cli.rs:10-33 `cc` lists -dumpversion
stdout: ~ "\n  -v " # tests/cc_cli.rs:10-33 `cc` lists -v
step: jet cc --rust-port-unknown-flag main.c
exit: nonzero # main.c does not exist
stderr: !~ "E2102" # tests/cc_cli.rs:7 `cc` owns its flag vocabulary
step: jet help c++
exit: 0 # tests/cc_cli.rs:6 `c++` is a builtin command
stdout: ~ "jet c++ [options] <sources>\n" # tests/cc_cli.rs:8 the usage line ends with `c++ [options] <sources>`
stdout: ~ "\n  --offline " # tests/cc_cli.rs:10-33 `c++` lists --offline
stdout: ~ "\n  --project-root " # tests/cc_cli.rs:10-33 `c++` lists --project-root
stdout: ~ "\n  --build-root " # tests/cc_cli.rs:10-33 `c++` lists --build-root
stdout: ~ "\n  -c " # tests/cc_cli.rs:10-33 `c++` lists -c
stdout: ~ "\n  -o " # tests/cc_cli.rs:10-33 `c++` lists -o
stdout: ~ "\n  -MMD " # tests/cc_cli.rs:10-33 `c++` lists -MMD
stdout: ~ "\n  -MD " # tests/cc_cli.rs:10-33 `c++` lists -MD
stdout: ~ "\n  -MF " # tests/cc_cli.rs:10-33 `c++` lists -MF
stdout: ~ "\n  -MT " # tests/cc_cli.rs:10-33 `c++` lists -MT
stdout: ~ "\n  --sysroot " # tests/cc_cli.rs:10-33 `c++` lists --sysroot
stdout: ~ "\n  -I " # tests/cc_cli.rs:10-33 `c++` lists -I
stdout: ~ "\n  -D " # tests/cc_cli.rs:10-33 `c++` lists -D
stdout: ~ "\n  -L " # tests/cc_cli.rs:10-33 `c++` lists -L
stdout: ~ "\n  -l " # tests/cc_cli.rs:10-33 `c++` lists -l
stdout: ~ "\n  -std " # tests/cc_cli.rs:10-33 `c++` lists -std
stdout: ~ "\n  --target " # tests/cc_cli.rs:10-33 `c++` lists --target
stdout: ~ "\n  -dumpmachine " # tests/cc_cli.rs:10-33 `c++` lists -dumpmachine
stdout: ~ "\n  -print-sysroot " # tests/cc_cli.rs:10-33 `c++` lists -print-sysroot
stdout: ~ "\n  -dumpversion " # tests/cc_cli.rs:10-33 `c++` lists -dumpversion
stdout: ~ "\n  -v " # tests/cc_cli.rs:10-33 `c++` lists -v
step: jet c++ --rust-port-unknown-flag main.c
exit: nonzero # main.c does not exist
stderr: !~ "E2102" # tests/cc_cli.rs:7 `c++` owns its flag vocabulary
