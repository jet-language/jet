# #6686 c5: `jet cc` declares every file under the project root as a compile input. Run from a directory that
# also holds a large store (here a sparse 1 GiB file), the set is over the 512 MiB cap, and the driver stops with
# E2118 naming the project root it inferred, the size it found and the cap, before any toolchain is fetched,
# instead of the E2102 "Invalid arguments" usage error. `--project-root` naming the source directory clears it.
requires: os:unix
requires: tool:truncate
env: NO_COLOR=1
write: src/hello.c = "int answer = 42;\n"
step: truncate -s 1G {work}/hangar.bin
exit: 0
step: jet cc --offline -c src/hello.c
normalize: replace "{work}" "<work>"
exit: 2 # the input set is refused before the compile, as a usage-class error
stderr: = project_input_set_over_the_cap_names_root_size_and_cap.stderr # E2118 with the inferred root, the size, the cap and `--project-root`, not the E2102 usage error, before toolchain admission
step: jet cc --offline --project-root src -c src/hello.c
exit: any # the narrowed set passes; what follows depends on this host's C toolchain
stderr: !~ "E2118" # a 17-byte source directory is within the cap
