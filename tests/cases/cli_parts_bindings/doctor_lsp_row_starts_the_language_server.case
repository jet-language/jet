# #6418: the doctor's language-server row comes from a probe. Doctor starts `jet self lsp`, sends `initialize` and reports what it got back. That server is not built yet (card #6386), so the probe reads the refusal and reports that card.
step: jet self doctor
env: NO_COLOR=1
exit: any # the other rows check this machine's tools
stdout: ~ "language server" # the row is reported
stdout: ~ "`jet self lsp` is not built yet (card #6386)" # the probe ran the server and read its E2104 refusal
stdout: !~ "built in (" # no static text stands in for the probe
