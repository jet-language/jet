# The doctor's language-server row comes from a probe. Doctor starts `jet self lsp`, sends `initialize` and reports what it got back.
step: jet self doctor
env: NO_COLOR=1
exit: any # the other rows check this machine's tools
stdout: ~ "language server" # the row is reported
stdout: ~ "`jet self lsp` answered `initialize`" # the probe ran the server and read its capabilities
stdout: !~ "built in (" # no static text stands in for the probe
