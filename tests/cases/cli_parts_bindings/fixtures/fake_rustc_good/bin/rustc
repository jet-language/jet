#!/bin/sh
if [ "$1" = "--version" ]; then
    printf '%s\n' 'rustc 1.97.1'
    exit 0
fi
if [ "$1" = "--print" ] && [ "$2" = "target-list" ]; then
    printf '%s\n' 'wasm32-unknown-unknown'; exit 0
fi
if [ "$1" = "--print" ] && [ "$2" = "sysroot" ]; then
    printf '%s\n' "$JET_FAKE_SYSROOT"
    exit 0
fi
printf '%s\n' 'rustc-probe-sentinel' >&2
exit 79
