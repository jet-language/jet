# A single-dash word no flag owns is refused with E2102, never ignored, on
# `jet run`, `jet build`, `jet check` and the `jet <file>` shorthand. `-O0`,
# `-O1` and `-O2` are the three optimize level flags, so they run; `-O3`
# names no level and is refused. Registered single-dash flags still run.
fixture: fixtures/unknown_flag
env: NO_COLOR=1
step: jet run -O1 jet_cli_ok2.jet
exit: 0
stdout: = "hi\n"
step: jet build -O2 jet_cli_ok2.jet
exit: 0
step: jet -O0 jet_cli_ok2.jet
exit: 0
stdout: = "hi\n"
step: jet run -O3 jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: = single-dash-level.stderr
step: jet build -Ozzz jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `-Ozzz` isn't a flag jet understands" # no level is zzz
step: jet check -Zqqqqqq jet_cli_ok2.jet
exit: 2
stderr: ~ "Error [jet.UnknownFlag]: `-Zqqqqqq` isn't a flag jet understands" # the refusal names the single-dash word
step: jet --bogus-flag jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `--bogus-flag` isn't a flag jet understands" # the refusal names the flag
step: jet -A jet_cli_ok2.jet
exit: 0
stdout: = "hi\n"
