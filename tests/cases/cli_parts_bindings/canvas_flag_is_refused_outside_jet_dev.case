# `--canvas` belongs to `jet dev` alone. Every other command refuses it
# through the canonical flag refusal (E2102, exit 2) and runs nothing.
fixture: fixtures/unknown_flag
env: NO_COLOR=1
step: jet run jet_cli_ok2.jet --canvas
exit: 2
stdout: = ""
stderr: = canvas-run.stderr
step: jet check jet_cli_ok2.jet --canvas
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `--canvas` is only valid with `jet dev`" # the same refusal on check
stderr: ~ "Drop `--canvas` from `jet check`" # the fix names the command it came with
step: jet build jet_cli_ok2.jet --canvas
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `--canvas` is only valid with `jet dev`" # the same refusal on build
step: jet test jet_cli_ok2.jet --canvas
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `--canvas` is only valid with `jet dev`" # the same refusal on test
