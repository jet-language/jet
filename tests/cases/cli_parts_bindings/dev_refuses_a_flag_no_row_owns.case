# `jet dev` checks its own flags, and a flag no registry row owns is refused
# with E2102 there too, a `--flag` and a single-dash word alike, never
# ignored. `--port` is a registered dev flag: a bare one is refused for its
# missing value, and `jet run` refuses it as a dev flag. `-v` is the short
# form of `--verbose` on a run.
fixture: fixtures/unknown_flag
env: NO_COLOR=1
step: jet dev --bogus-flag --watch=off jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: = dev-unknown-flag.stderr
step: jet dev -Q --watch=off jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `-Q` isn't a flag jet understands" # the refusal names the single-dash word
step: jet dev --port --watch=off jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: ~ "`--port` needs its value" # the refusal names the flag missing its value
stderr: ~ "Write `--port=8080`, or leave it out to let the preview listener choose a port" # the fix spells the valued form
step: jet run --port=8080 jet_cli_ok2.jet
exit: 2
stdout: = ""
stderr: ~ "Error [jet.UnknownFlag]: `--port` is only valid with `jet dev`" # the refusal names the command that owns the flag
step: jet dev --watch=off jet_cli_ok2.jet
exit: 0
stdout: ~ "hi" # the program ran; the dev session prints its own lines around it
step: jet run -v jet_cli_ok2.jet
exit: 0
stdout: ~ "hi" # the program ran; `-v` adds the run's verbose lines
