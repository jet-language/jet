# `receipt.attach` is a no-op without a receipt claim; with one it publishes the
# section as one framed record under `staged/<claim>`, its JSON keys in byte
# order, and attaching the same section again keeps that one record.
fixture: attach_publishes_one_canonical_section_record.fixture
requires: os-name:linux
mkdir: receipts
env: JET_RECEIPT_DIR={work}/receipts
step: jet run run.jet
exit: 0
stdout: = "attached\n"
entries: receipts recursive = 0
step: jet run run.jet
env: JET_RECEIPT_CLAIM=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
exit: 0
stdout: = "attached\n"
entries: receipts/staged/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef kind file = 1
for file receipts/staged/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef kind file as record
file: {record.path} ~ "jet-receipt-section-record-v1" # the record's magic
file: {record.path} ~ "{\"alpha\":\"first\",\"zeta\":2}\n" # the payload frame: compact JSON, keys in byte order
end for
step: jet run run.jet
env: JET_RECEIPT_CLAIM=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
exit: 0
entries: receipts/staged/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef kind file = 1
