# #6659: an Output entry reaches a function of an inline module that an
# imported file module declares, behind the module's visibility.
fixture: qualified_entry_reaches_package_visible_inline_module.fixture
env: NO_COLOR=1
step: jet run main.jet
exit: 0
stdout: ~ "launched" # the package-visible member ran
stderr: !~ "Package export `launch` is unreachable" # the Output entry consumes the member it links
step: jet check hidden.jet
exit: 1
stderr: ~ "Function `bank.hidden.launch` is private" # a `priv` module stays closed to the Output
