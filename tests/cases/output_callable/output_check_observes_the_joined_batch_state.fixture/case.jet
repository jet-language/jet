use contract_files: core.files
CHECK: Output.Check{name: "state-check", entry: verify}
#Persist state := 0
#Test("first") {
    state = 41
    contract_files.append_all("events.txt", "first\n") ?? panic("write first event")
}
#Test("second") {
    state += 1
    contract_files.append_all("events.txt", "second\n") ?? panic("write second event")
}
verify: fn() {
    contract_files.append_all("events.txt", "check\n") ?? panic("write check event")
    if state != 42 -> return Err("the check saw state {state}, not the batch's 42")
}
