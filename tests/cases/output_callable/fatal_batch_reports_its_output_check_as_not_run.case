# Port of Compiler/JetBackend/Tests/test-native-test-contract.mjs `fatal-recovery`:
# a test body that exits the batch fails alone, the remaining bodies still run,
# and the Output.Check, whose batch state is gone, is reported as not run (E3016)
# instead of being executed against a fresh process.
fixture: fatal_batch_reports_its_output_check_as_not_run.fixture
env: NO_COLOR=1
env: TERM=dumb
step: jet test --serial --color=never case.jet
exit: 1
stdout: = "already reported: pass\nfatal child: FAIL\nunreported body: pass\nstate-check: FAIL\n2 passed, 2 failed, 0 skipped\n"
stderr: = "native test executable ended without an outcome (exit 73)\nError [E3016]: Output check not run: the test batch ended in a fatal trap\n Why: The test batch's process state was lost; a fresh reporter cannot truthfully execute a check against the test bodies' state.\n Fix: Fix the fatal trap in the reported test, then rerun the complete test batch.\nMore: jet-lang.dev/e/E3016\n\n"
file: events.txt = "already\nfatal\nfatal\nremaining\n"
