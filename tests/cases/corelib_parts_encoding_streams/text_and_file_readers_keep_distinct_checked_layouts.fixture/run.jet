
use core.encoding.json as json
use core.encoding.jsonl as jsonl
use core.files as files

fn keep_file_reader(value: ^json.JSONReader) -> json.JSONReader { value }

fn keep_record_reader(value: ^jsonl.JSONLReader) -> jsonl.JSONLReader { value }

fn run() {
    input :: files.open("value.json") ?? panic("open")
    file :: json.reader(^input) ?? panic("file reader")
    kept := keep_file_reader(^file)
    _ :: &kept.next() ?? panic("file event")
    print("file event")

    lines :: files.open("value.jsonl") ?? panic("open records")
    records :: jsonl.reader(^lines) ?? panic("record reader")
    kept_records := keep_record_reader(^records)
    first :: &kept_records.next() ?? panic("first record")
    print(json.canonical(first) ?? panic("canonical first"))
    second :: &kept_records.next() ?? panic("second record")
    print(json.canonical(second) ?? panic("canonical second"))
}
