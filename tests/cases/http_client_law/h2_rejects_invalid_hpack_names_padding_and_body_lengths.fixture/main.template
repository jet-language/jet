// HTTPClient.rs409-411/419 precise raw error mappings; original three raw-client instances and request/read phases.
use http: core.http.client
run: fn() {
    client0: http.Client.new().protocols(true, false, true)
    if client0.send(http.request("GET", "http://{cap:addr}/h2")) == {
        .Err(error) -> {
            if error == {
                .InvalidHeader -> print("InvalidHeader")
                .InvalidMethod | .InvalidURL | .InvalidStatus | .BodyConsumed | .InvalidFraming | .UnsupportedEncoding | .Cancelled | .BodyTooLarge(_) | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> panic("expected InvalidHeader")
            }
        }
        .Ok(_) -> panic("expected send error")
    }
    client1: http.Client.new().protocols(true, false, true)
    if client1.send(http.request("GET", "http://{cap:addr}/h2")) == {
        .Err(error) -> {
            if error == {
                .Protocol(_) -> print("Protocol")
                .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .BodyConsumed | .InvalidFraming | .UnsupportedEncoding | .Cancelled | .BodyTooLarge(_) | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> panic("expected Protocol")
            }
        }
        .Ok(_) -> panic("expected send error")
    }
    client2: http.Client.new().protocols(true, false, true)
    response: client2.send(http.request("GET", "http://{cap:addr}/h2")) ?? panic("third send")
    saw_error := false
    loop chunk in response.body().chunks(64) {
        if chunk == {
            .Ok(_) -> panic("original FIRST read must fail")
            .Err(error) -> {
                if error == {
                    .InvalidFraming -> {
                        print("InvalidFraming")
                        saw_error = true
                    }
                    .InvalidMethod | .InvalidURL | .InvalidHeader | .InvalidStatus | .BodyConsumed | .UnsupportedEncoding | .Cancelled | .BodyTooLarge(_) | .Resolve(_) | .Connect(_) | .TLS(_) | .Timeout(_) | .Proxy(_) | .Redirect(_) | .Protocol(_) | .IO(_) | .Policy(_) | .ResourceUnavailable(_) | .Internal(_) | .UnsupportedTarget(_) -> panic("expected InvalidFraming")
                }
                break
            }
        }
    }
    if !saw_error -> panic("original FIRST read must not be EOF")
}
