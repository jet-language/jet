use core.http.client as http
fn run() {
    client :: http.Client.new().cookies(.Memory).proxy(.URL("http://{cap:addr}")).protocols(false, true, false)
    seed :: client.send(http.request("GET", "http://127.0.0.1/seed")) ?? panic("seed")
    check :: client.send(http.request("GET", "http://127.0.0.1/check")) ?? panic("check")
}
