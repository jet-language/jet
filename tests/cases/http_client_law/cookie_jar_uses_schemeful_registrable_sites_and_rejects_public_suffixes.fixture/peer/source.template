    assert(!contains_bytes(head4, "{PEER_CRLF}cookie:".bytes(), true))
    stream4.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream4.close() ?? panic("close")
    stream5 :: &listener.accept() ?? panic("accept 5")
    head5 :: request_head(stream5)
