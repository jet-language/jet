use core.net as net
use core.files as files
use core.time as time
PEER_CRLF :: prep { String.from_bytes([U8]{13, 10}) ?? panic("fixture CRLF") }

fn prefix(raw: [U8], want: [U8]) -> Bool {
    if raw.len() < want.len() -> return false
    loop i in 0..<want.len() { if raw[i] != want[i] -> return false }
    return true
}
fn contains_bytes(raw: [U8], want: [U8], ascii_casefold: Bool) -> Bool {
    if raw.len() < want.len() -> return false
    loop start in 0..<(raw.len() - want.len() + 1) {
        same := true
        loop i in 0..<want.len() {
            n := Int.from_u8(raw[start + i])
            if ascii_casefold && n >= 65 && n <= 90 -> n += 32
            if n != Int.from_u8(want[i]) -> same = false
        }
        if same -> return true
    }
    return false
}
fn request_head(stream: TCPStream) -> [U8] {
    // Original request_head10-23: persistent 5s read timeout,512-byte reads, positive read, <=64KiB bound, exact CRLFCRLF terminator.
    net.set_read_timeout(stream, 5000) ?? panic("request timeout")
    request := [U8]{}
    loop !contains_bytes(request, [U8]{13,10,13,10}, false) {
        block :: stream.read(512) ?? panic("request read")
        assert(block.len() > 0)
        loop byte in block { &request.push(byte) }
        assert(request.len() <= 65536)
    }
    return request
}
fn publish(listener: TCPListener, path: String) {
    address :: listener.local_addr() ?? panic("address")
    files.write_atomic(path, address.bytes()) ?? panic("publish address")
}

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    publish(listener, "{work}/addr.txt")
    stream0 :: &listener.accept() ?? panic("accept 0")
    head0 :: request_head(stream0)
    _ :: String.from_bytes(head0) ?? panic("original UTF8 request head")
    assert(prefix(head0, "GET http://shop.example.co.uk/dir/seed HTTP/1.1{PEER_CRLF}".bytes()))
    assert(!contains_bytes(head0, "{PEER_CRLF}cookie:".bytes(), true))
    stream0.write_all("HTTP/1.1 200 OK{PEER_CRLF}Set-Cookie: root=one; Domain=example.co.uk; Path=/; SameSite=Strict{PEER_CRLF}Set-Cookie: deep=one; Domain=example.co.uk; Path=/dir; SameSite=Strict{PEER_CRLF}Set-Cookie: alpha=one; Domain=example.co.uk; Path=/; SameSite=Strict{PEER_CRLF}Set-Cookie: beta=one; Domain=example.co.uk; Path=/; SameSite=Strict{PEER_CRLF}Set-Cookie: public=bad; Domain=co.uk; Path=/{PEER_CRLF}Set-Cookie: secure=bad; Domain=example.co.uk; Path=/; Secure{PEER_CRLF}Set-Cookie: expired=bad; Domain=example.co.uk; Path=/; Max-Age=0{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream0.close() ?? panic("close")
