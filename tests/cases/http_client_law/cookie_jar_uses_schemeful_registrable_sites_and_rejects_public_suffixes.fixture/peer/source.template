    assert(!contains_bytes(head7, "{PEER_CRLF}cookie:".bytes(), true))
    stream7.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream7.close() ?? panic("close")
}
