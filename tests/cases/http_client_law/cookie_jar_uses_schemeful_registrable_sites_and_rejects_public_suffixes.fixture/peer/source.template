    assert(prefix(head5, "GET http://seed.b.xn--55qx5d.cn/seed HTTP/1.1{PEER_CRLF}".bytes()))
    assert(!contains_bytes(head5, "{PEER_CRLF}cookie:".bytes(), true))
    stream5.write_all("HTTP/1.1 200 OK{PEER_CRLF}Set-Cookie: idn_public=bad; Domain=xn--55qx5d.cn; Path=/{PEER_CRLF}Set-Cookie: idn_strict=good; Domain=b.xn--55qx5d.cn; Path=/; SameSite=Strict{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream5.close() ?? panic("close")
    stream6 :: &listener.accept() ?? panic("accept 6")
