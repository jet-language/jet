    assert(!contains_bytes(head3, "{PEER_CRLF}cookie:".bytes(), true))
    stream3.write_all("HTTP/1.1 302 Found{PEER_CRLF}Location: http://api.example.co.uk/cross-site{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream3.close() ?? panic("close")
    stream4 :: &listener.accept() ?? panic("accept 4")
    head4 :: request_head(stream4)
