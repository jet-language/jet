    stream1.write_all("HTTP/1.1 302 Found{PEER_CRLF}Location: http://api.example.co.uk/dir/next{PEER_CRLF}Set-Cookie: alpha=two; Domain=example.co.uk; Path=/; SameSite=Strict{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream1.close() ?? panic("close")
    stream2 :: &listener.accept() ?? panic("accept 2")
    head2 :: request_head(stream2)
