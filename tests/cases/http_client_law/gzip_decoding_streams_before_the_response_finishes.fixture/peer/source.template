use core.net as net
use core.files as files
use core.time as time
PEER_CRLF :: prep { String.from_bytes([U8]{13, 10}) ?? panic("fixture CRLF") }

fn prefix(raw: [U8], want: [U8]) -> Bool {
    if raw.len() < want.len() -> return false
    loop i in 0..<want.len() { if raw[i] != want[i] -> return false }
    return true
}
fn contains_bytes(raw: [U8], want: [U8], ascii_casefold: Bool) -> Bool {
    if raw.len() < want.len() -> return false
    loop start in 0..<(raw.len() - want.len() + 1) {
        same := true
        loop i in 0..<want.len() {
            n := Int.from_u8(raw[start + i])
            if ascii_casefold && n >= 65 && n <= 90 -> n += 32
            if n != Int.from_u8(want[i]) -> same = false
        }
        if same -> return true
    }
    return false
}
fn request_head(stream: TCPStream) -> [U8] {
    // Original request_head10-23: persistent 5s read timeout,512-byte reads, positive read, <=64KiB bound, exact CRLFCRLF terminator.
    net.set_read_timeout(stream, 5000) ?? panic("request timeout")
    request := [U8]{}
    loop !contains_bytes(request, [U8]{13,10,13,10}, false) {
        block :: stream.read(512) ?? panic("request read")
        assert(block.len() > 0)
        loop byte in block { &request.push(byte) }
        assert(request.len() <= 65536)
    }
    return request
}
fn publish(listener: TCPListener, path: String) {
    address :: listener.local_addr() ?? panic("address")
    files.write_atomic(path, address.bytes()) ?? panic("publish address")
}

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    publish(listener, "{work}/addr.txt")
    signal :: net.tcp_listen("127.0.0.1:0") ?? panic("signal listen")
    publish(signal, "{work}/signal.txt")
    stream :: &listener.accept() ?? panic("gzip accept")
    _ :: request_head(stream)
    prefix :: [U8]{31, 139, 8, 0, 0, 0, 0, 0, 0, 0, 0, 5, 0, 250, 255, 104, 101, 108, 108, 111}
    suffix :: [U8]{1, 5, 0, 250, 255, 119, 111, 114, 108, 100, 173, 32, 235, 249, 10, 0, 0, 0}
    stream.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Encoding: gzip{PEER_CRLF}Content-Length: {prefix.len() + suffix.len()}{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    stream.write_all(prefix) ?? panic("gzip prefix")
    // Original2sec decoder-buffering signal deadline; no suffix until the exact hello chunk was delivered.
    _ :: &signal.accept(deadline: 2s) ?? panic("decoder buffered the unfinished gzip response")
    stream.write_all(suffix) ?? panic("gzip suffix")
    _ :: stream.close()
    second :: &listener.accept() ?? panic("br accept")
    _ :: request_head(second)
    second.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Encoding: br{PEER_CRLF}Content-Length: 2{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}ok".bytes()) ?? panic("response write")
}
