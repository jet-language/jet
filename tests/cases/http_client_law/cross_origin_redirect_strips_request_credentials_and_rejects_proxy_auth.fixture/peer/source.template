use {
    net: core.net
    files: core.files
    time: core.time
}
PEER_CRLF: #run { String.from_bytes([U8]{13, 10}) ?? panic("fixture CRLF") }

prefix: fn(raw: [U8], want: [U8]) -> Bool {
    if raw.len() < want.len() -> return false
    loop i in 0..<want.len() { if raw[i] != want[i] -> return false }
    return true
}
contains_bytes: fn(raw: [U8], want: [U8], ascii_casefold: Bool) -> Bool {
    if raw.len() < want.len() -> return false
    loop start in 0..<(raw.len() - want.len() + 1) {
        same := true
        loop i in 0..<want.len() {
            n := Int{raw[start + i]}
            if ascii_casefold && n >= 65 && n <= 90 -> n += 32
            if n != (Int{want[i]}) -> same = false
        }
        if same -> return true
    }
    return false
}
request_head: fn(stream: &TCPStream) -> [U8] {
    // Original request_head10-23: 5s per read,512-byte reads, positive read, <=64KiB bound, exact CRLFCRLF terminator.
    request := [U8]{}
    loop !contains_bytes(request, [U8]{13,10,13,10}, false) {
        block: stream.read(512, deadline: 5s) ?? panic("request read")
        assert(block.len() > 0)
        loop byte in block { request.push(byte) }
        assert(request.len() <= 65536)
    }
    return request
}
publish: fn(listener: TCPListener, path: String) {
    address: listener.local_addr() ?? panic("address")
    files.write_atomic(path, address.bytes()) ?? panic("publish address")
}

run: fn() {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    publish(listener, "{work}/addr.txt")
    starts_casefold: fn(raw: [U8], want: [U8]) {
        if raw.len() < want.len() -> return false
        loop i in 0..<want.len() {
            n := Int{raw[i]}
            if n >= 65 && n <= 90 -> n += 32
            if n != (Int{want[i]}) -> return false
        }
        return true
    }
    second_listener: net.tcp_listen("127.0.0.1:0") ?? panic("second listen")
    forbidden_listener: net.tcp_listen("127.0.0.1:0") ?? panic("forbidden listen")
    second_addr: second_listener.local_addr() ?? panic("second addr")
    publish(second_listener, "{work}/second.txt")
    publish(forbidden_listener, "{work}/forbidden.txt")
    forbidden: task {
        // Original accepts ANY non-WouldBlock error as no connection, rather than inventing stricter validation.
        until: time.instant() + 1s
        loop {
            if forbidden_listener.accept(deadline: 0s) == {
                .Ok(_) -> return true
                .Err(error) -> {
                    if error == {
                        .Timeout(_) -> {
                            if time.instant() >= until -> return false
                            time.sleep(0s)
                        }
                        else -> return false
                    }
                }
            }
        }
    }
    first := listener.accept() ?? panic("first accept")
    initial: request_head(first)
    assert(contains_bytes(initial, "authorization: bearer secret{PEER_CRLF}".bytes(), true))
    assert(contains_bytes(initial, "cookie: session=secret{PEER_CRLF}".bytes(), true))
    assert(!contains_bytes(initial, "proxy-authorization:".bytes(), true))
    assert(starts_casefold(initial, "get /start ".bytes()))
    first.write_all("HTTP/1.1 302 Found{PEER_CRLF}Location: http://{second_addr}/next{PEER_CRLF}Content-Length: 0{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("response write")
    _: first.close()
    second := second_listener.accept() ?? panic("second accept")
    redirected: request_head(second)
    assert(starts_casefold(redirected, "get /next ".bytes()))
    assert(!contains_bytes(redirected, "authorization:".bytes(), true))
    assert(!contains_bytes(redirected, "proxy-authorization:".bytes(), true))
    assert(!contains_bytes(redirected, "cookie:".bytes(), true))
    second.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 2{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}ok".bytes()) ?? panic("response write")
    assert(!(forbidden.join() ?? panic("forbidden join")))
}
