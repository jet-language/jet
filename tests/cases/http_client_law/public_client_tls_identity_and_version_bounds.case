# HAND-PORT tests/http_client_law.rs:2340-2554 public_client_tls_identity_and_version_bounds
# PENDING-KIT; PENDING-GRAMMAR(batch-four); no runtime/reference proof.
# Original five OpenSSL cert creation/sign commands and EACH success predicate, exact original serverAuth/clientAuth extensions; TLS1.2 and Verify1 peers with every original argv/250ms delay/client-source/exit/stdout law. Real fresh1day RSA2048 CA/client/server certificates, no fake TLS fixture or new public API.
requires: tool:openssl
fixture: public_client_tls_identity_and_version_bounds.fixture
env: NO_COLOR=1
step: openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=jet-http-ca -keyout tls/ca.key.pem -out tls/ca.cert.pem
exit: 0
step: openssl req -new -newkey rsa:2048 -nodes -subj /CN=localhost -keyout tls/localhost.key.pem -out tls/localhost.csr.pem
exit: 0
step: openssl x509 -req -days 1 -CAcreateserial -CAserial tls/localhost.srl -CA tls/ca.cert.pem -CAkey tls/ca.key.pem -extfile tls/localhost.ext -in tls/localhost.csr.pem -out tls/localhost.cert.pem
exit: 0
step: openssl req -new -newkey rsa:2048 -nodes -subj /CN=jet-client -keyout tls/jet-client.key.pem -out tls/jet-client.csr.pem
exit: 0
step: openssl x509 -req -days 1 -CAcreateserial -CAserial tls/jet-client.srl -CA tls/ca.cert.pem -CAkey tls/ca.key.pem -extfile tls/jet-client.ext -in tls/jet-client.csr.pem -out tls/jet-client.cert.pem
exit: 0
step: jet run --interpreter port/main.jet
exit: 0
capture: version_port = text stdout.trim
session versiontls raw: openssl s_server -quiet -www -tls1_2 -accept {cap:version_port} -CAfile tls/ca.cert.pem -cert tls/localhost.cert.pem -key tls/localhost.key.pem
sleep: 250ms
write: version/main.jet version/main.template
step: jet build version/main.jet
exit: 0
step version: built
exit: 0
stdout: = public_client_tls_identity_and_version_bounds.version.expected
signal versiontls: KILL
close versiontls
exit: any # original ignores BOTH kill() and wait() Results; expected case-requested termination per DESIGN360
step: jet run --interpreter port/main.jet
exit: 0
capture: mtls_port = text stdout.trim
session mtls raw: openssl s_server -quiet -www -Verify 1 -verify_return_error -accept {cap:mtls_port} -CAfile tls/ca.cert.pem -cert tls/localhost.cert.pem -key tls/localhost.key.pem
sleep: 250ms
write: mtls/main.jet mtls/main.template
step: jet build mtls/main.jet
exit: 0
step mtls_client: built
exit: 0
stdout: = public_client_tls_identity_and_version_bounds.mtls.expected
signal mtls: KILL
close mtls
exit: any # original ignores BOTH kill() and wait() Results; expected case-requested termination per DESIGN360
