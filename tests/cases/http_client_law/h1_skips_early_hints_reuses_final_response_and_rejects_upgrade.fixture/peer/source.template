use core.net as net
use core.files as files
use core.time as time
PEER_CRLF :: prep { String.from_bytes([U8]{13, 10}) ?? panic("fixture CRLF") }

fn prefix(raw: [U8], want: [U8]) -> Bool {
    if raw.len() < want.len() -> return false
    loop i in 0..<want.len() { if raw[i] != want[i] -> return false }
    return true
}
fn contains_bytes(raw: [U8], want: [U8], ascii_casefold: Bool) -> Bool {
    if raw.len() < want.len() -> return false
    loop start in 0..<(raw.len() - want.len() + 1) {
        same := true
        loop i in 0..<want.len() {
            n := Int.from_u8(raw[start + i])
            if ascii_casefold && n >= 65 && n <= 90 -> n += 32
            if n != Int.from_u8(want[i]) -> same = false
        }
        if same -> return true
    }
    return false
}
fn request_head(stream: TCPStream) -> [U8] {
    // Original request_head10-23: persistent 5s read timeout,512-byte reads, positive read, <=64KiB bound, exact CRLFCRLF terminator.
    net.set_read_timeout(stream, 5000) ?? panic("request timeout")
    request := [U8]{}
    loop !contains_bytes(request, [U8]{13,10,13,10}, false) {
        block :: stream.read(512) ?? panic("request read")
        assert(block.len() > 0)
        loop byte in block { &request.push(byte) }
        assert(request.len() <= 65536)
    }
    return request
}
fn publish(listener: TCPListener, path: String) {
    address :: listener.local_addr() ?? panic("address")
    files.write_atomic(path, address.bytes()) ?? panic("publish address")
}

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    publish(listener, "{work}/addr.txt")
    first_peer :: task {
        stream :: &listener.accept() ?? panic("accept")
        assert(prefix(request_head(stream), "GET /early HTTP/1.1{PEER_CRLF}".bytes()))
        stream.write_all("HTTP/1.1 103 Early Hints{PEER_CRLF}Link: </style.css>; rel=preload{PEER_CRLF}{PEER_CRLF}HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 3{PEER_CRLF}Connection: keep-alive{PEER_CRLF}{PEER_CRLF}one".bytes()) ?? panic("early response")
        assert(prefix(request_head(stream), "GET /reuse HTTP/1.1{PEER_CRLF}".bytes()))
        stream.write_all("HTTP/1.1 200 OK{PEER_CRLF}Content-Length: 3{PEER_CRLF}Connection: close{PEER_CRLF}{PEER_CRLF}two".bytes()) ?? panic("reuse response")
    }
    upgrade_listener :: net.tcp_listen("127.0.0.1:0") ?? panic("upgrade listen")
    publish(upgrade_listener, "{work}/upgrade_addr.txt")
    upgrade_peer :: task {
        stream :: &upgrade_listener.accept() ?? panic("upgrade accept")
        _ :: request_head(stream)
        stream.write_all("HTTP/1.1 101 Switching Protocols{PEER_CRLF}Connection: upgrade{PEER_CRLF}Upgrade: websocket{PEER_CRLF}{PEER_CRLF}".bytes()) ?? panic("upgrade response")
    }
    first_peer.join() ?? panic("first peer join")
    upgrade_peer.join() ?? panic("upgrade peer join")
}
