use core.http.client as client
use core.net as net

// Loopback peers for the checked-build GET leaf. Each peer accepts one
// connection, reads the request, answers with fixed bytes and closes; `hold`
// peers never answer and keep the connection until the client gives up.

fn text(row: [U8]) -> String {
    out := ""
    loop byte in row {
        n :: Int.from_u8(byte)
        out = if n >= 32 && n < 127 -> "{out}{String.from_bytes([U8]{byte}) ?? "?"}" else -> "{out}\\x{n}"
    }
    out
}

fn show(rows: [[U8]]) -> String {
    out := ""
    loop row in rows -> out = "{out}[{text(row)}]"
    out
}

fn serve(listener: TCPListener, response: [U8], hold: Bool) -[Net, Time.Wait]> String Never! {
    stream := net.tcp_accept(listener) ?? return "accept failed"
    request := [U8]{}
    loop {
        chunk :: stream.read(4096, deadline: 10s) ?? return "read failed"
        if chunk.len() == 0 -> break
        loop byte in chunk -> &request.push(byte)
        n :: request.len()
        if !hold && n >= 4 && request[n - 4] == (U8{13}) && request[n - 3] == (U8{10}) && request[n - 2] == (U8{13}) && request[n - 1] == (U8{10}) -> break
    }
    at := 0
    loop at < response.len() {
        rest := [U8]{}
        loop index in at..<response.len() -> &rest.push(response[index])
        sent :: stream.write(rest, deadline: 10s) ?? return "write failed"
        at += sent
    }
    stream.close() ?? return "close failed"
    text(request)
}

fn exchange(name: String, response: [U8], limit: Int, timeout_ms: Int, hold: Bool) {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    port :: net.socket_port(net.listener_local_socket_addr(listener) ?? panic("address"))
    peer :: task { serve(listener, response, hold) }
    if client.jet_http_build_get("fixture.test", "fixture.test:8080", "/pkg/a.tar?v=1", false, [[U8]]{[U8]{127, 0, 0, 1}}, port, timeout_ms, limit) == {
        .Ok(rows) -> print("{name}: {rows.len()} {show(rows)}")
        .Err(error) -> print("{name}: error {error}")
    }
    request :: peer.join() ?? panic("peer task failed")
    if name == "redirect" -> print("request: {request}")
}

fn answer(name: String, response: String, limit: Int) { exchange(name, response.bytes(), limit, 5000, false) }

fn refused(name: String, addresses: [[U8]], port: Int, timeout_ms: Int) {
    if client.jet_http_build_get("fixture.invalid", "fixture.invalid", "/", false, addresses, port, timeout_ms, 10) == {
        .Ok(rows) -> print("{name}: unexpected {show(rows)}")
        .Err(error) -> print("{name}: error {error}")
    }
}

fn run() {
    // Pinned, no-follow: status and raw body bytes are facts, not policy.
    answer("redirect", "HTTP/1.1 302 Found\r\nLocation: http://must-not-resolve.invalid/\r\nContent-Length: 6\r\n\r\nlocked", 1024)
    answer("missing", "HTTP/1.1 404 Missing\r\nContent-Length: 3\r\n\r\nraw", 1024)
    answer("hints", "HTTP/1.1 103 Early Hints\r\nLink: </asset>\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nraw", 1024)

    // Chunked binary bodies with extensions; the bound returns one excess byte.
    chunked := "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, Chunked\r\n\r\n2\r\n".bytes()
    &chunked.push(U8{255})
    &chunked.push(U8{0})
    loop byte in "\r\n3;extension=x\r\nabc\r\n0\r\n\r\n".bytes() -> &chunked.push(byte)
    exchange("chunked", chunked, 512, 5000, false)
    bounded := "HTTP/1.1 200 OK\r\nContent-Length: 514\r\n\r\n".bytes()
    loop _ in 0..<514 -> &bounded.push(U8{120})
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    port :: net.socket_port(net.listener_local_socket_addr(listener) ?? panic("address"))
    peer :: task { serve(listener, bounded, false) }
    if client.jet_http_build_get("fixture.test", "fixture.test", "/", false, [[U8]]{[U8]{127, 0, 0, 1}}, port, 5000, 512) == {
        .Ok(rows) -> print("bounded: {rows.len()} body {rows[1].len()} status {text(rows[2])}")
        .Err(error) -> print("bounded: error {error}")
    }
    _ :: peer.join() ?? panic("peer task failed")

    // Malformed Content-Length takes no body; EOF without a length reads all.
    answer("malformed", "HTTP/1.1 200 OK\r\nContent-Length: +x\r\n\r\nignored", 1024)
    answer("eof", "HTTP/1.1 200 OK\r\nServer: eof\r\n\r\nall of it", 1024)
    answer("http10", "HTTP/1.0 200 OK\r\n\r\nuntil-eof", 1024)

    // Framing errors keep the seed's exact String texts.
    answer("head-eof", "HTTP/1.1 200 OK\r\n", 1024)
    answer("no-status", "HTTP/1.1\r\n\r\n", 1024)
    answer("head-bound", "HTTP/1.1 200 OK\r\nX: 0123456789\r\n\r\n", 20)
    answer("short", "HTTP/1.1 200 OK\r\nContent-Length: 9\r\n\r\nshort", 1024)
    answer("chunk-digit", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 1024)
    answer("chunk-empty", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", 1024)
    answer("chunk-large", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n10000000000000000\r\n", 1024)
    answer("chunk-eof", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nab", 1024)
    answer("chunk-framing", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nabXY", 1024)
    answer("chunk-crlf", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nab", 1024)

    // The one transport deadline fires below HTTP framing.
    exchange("deadline", [U8]{}, 64, 200, true)

    // Conversion and carrier failures precede any connection.
    loopback :: [[U8]]{[U8]{127, 0, 0, 1}}
    refused("port", loopback, 70000, 10)
    refused("timeout", loopback, 80, -1)
    refused("none", [[U8]]{}, 80, 10)
    refused("carrier", [[U8]]{[U8]{127, 0, 1}}, 80, 10)
}
