
use core.http.client as http
fn run() {
    client :: http.Client.new().timeouts(5000, 5000, 5000, 5000, 5000, 5000, 5000)
    req :: http.request("GET", "http://{cap:addr}/slow").first_byte_timeout(40)
    if client.send(req) == {
        .Ok(_) -> print("ok")
        .Err(_) -> print("timeout")
    }
}
