
use {
    http: core.http.client
    message: core.http
    files: core.files
}
run: fn() {
    input: files.open("{work}/upload.fifo") ?? panic("open")
    body: message.Body.reader(input, 204800) ?? panic("reader")
    req: http.request("POST", "http://{cap:addr}/upload").body(body).redirects(0)
    resp: req.send() ?? panic("send")
    print(resp.body().text(8) ?? panic("body"))
}
