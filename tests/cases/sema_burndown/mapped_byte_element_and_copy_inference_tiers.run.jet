
use files: core.files
run: fn() {
    mapped: files.map(Path.from("{work}/data.txt")) ?? panic("map")
    window: mapped.window_len(0, 1) ?? panic("window")
    print(Int{window[0]})
    loop line in mapped.lines() {
        print(Int{line[0]})
        print(String.from_bytes(line.copy()) ?? panic("utf8"))
    }
}
