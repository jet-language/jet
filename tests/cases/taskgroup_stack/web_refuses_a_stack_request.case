# A browser task has no stack of its own to size, so any `stack:` on the web
# target is E-WEB-UNSUPPORTED (D-THREAD-STACK1=A). The checker
# refuses it when the target machine is wasm.browser, as it refuses host
# APIs there (CheckProgram.jet sema_web_host_check_core_usage).
fixture: fixtures/stack
env: NO_COLOR=1
step: jet check web.jet --target web
exit: nonzero
stderr: ~ "[E-WEB-UNSUPPORTED]" # the refusal's code
stderr: ~ "cannot give a task group its own stack size" # the refusal's text, beside other web findings
