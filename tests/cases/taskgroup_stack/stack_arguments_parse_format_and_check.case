# `stack:` parses beside `limit:` and formats unchanged; the checker refuses
# a stack that is not an Int, a constant outside 1 byte to 8 GiB, a repeated
# argument and an unknown label (D-THREAD-STACK1=A). The web
# refusal is web_refuses_a_stack_request.case.
fixture: fixtures/stack
env: NO_COLOR=1
step fmt: jet fmt --check format.jet
exit: 0
step check: jet check format.jet
exit: 0
step not_int: jet check not_int.jet
exit: nonzero
stderr: ~ "Error [jet.ValueTypeMismatch]: A task-group stack must be an integer" # the refusal's heading; its source frame is the report's
step range: jet check out_of_range.jet
exit: nonzero
stderr: ~ "A task-group stack of 0 bytes is outside what this target supplies" # both groups are refused in one report
stderr: ~ "A task-group stack of 9663676416 bytes is outside what this target supplies" # both groups are refused in one report
step labels: jet check labels.jet
exit: nonzero
stderr: ~ "Error [jet.InvalidStatement]: Task-group argument `stack` is given twice" # both labels are refused in one report
stderr: ~ "Task-group parameter `depth` is not supported" # both labels are refused in one report
