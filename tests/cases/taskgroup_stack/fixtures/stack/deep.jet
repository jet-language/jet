// A task group's `stack:` gives its tasks, and the groups and tasks they
// open, at least that much stack (D-THREAD-STACK1=A). The soft stack limit
// is set to 8 MiB first, so every other task gets 8 MiB: shallow.jet's same
// recursion outside the group stops with E3012. Here it runs in a task of
// the group, in a group a task of it opens, and in a task one starts
// outside any group.
package: {
    name: "taskgroup_stack"
    authority: { allow: [Env, Exec, FS, FS.Read, IO] }
}

use sys: core.sys

DEPTH: 400000
STACK: 536870912
PROGRAM_STACK: 8388608

deep: fn(n: Int, a: Int, b: Int, c: Int, d: Int) -> Int {
    if n == 0 -> return a + b + c + d
    1 + deep(n - 1, b, c, d, a + n)
}

inherited: fn() -> Bool {
    reached := 0
    task.group inner {
        grouped: task deep(DEPTH, 1, 2, 3, 4)
        reached = grouped.join() ?? -1
    }
    loose: task deep(DEPTH, 1, 2, 3, 4)
    loose_reached: loose.join() ?? -1
    reached > DEPTH && loose_reached > DEPTH
}

run: fn() {
    limit: sys.stack_limit() ?? panic("stack limit: {err}")
    sys.set_stack_limit(Val(PROGRAM_STACK), limit.hard) ?? panic("set stack limit: {err}")
    task.group roomy(limit: 2, stack: STACK) {
        direct: task deep(DEPTH, 1, 2, 3, 4)
        print("group task reached the bottom {(direct.join() ?? -1) > DEPTH}")
        nested: task inherited()
        print("inner group and loose task inherit {nested.join() ?? false}")
    }
}
