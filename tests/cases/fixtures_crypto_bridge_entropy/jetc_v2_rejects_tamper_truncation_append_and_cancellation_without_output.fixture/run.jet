// tests/fixtures/crypto_bridge_entropy.rs:1028-1116. KNOWN-FAILING #4821 #4841 + PENDING-SEAM(runtime-crypto-internals,crypto-io-fault-hook). Runtime UNRUN.
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use core.crypto as crypto
use core.crypto.expert as expert
use core.files as files
fn filled(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> &out.push((U8{value}))
    out
}
fn cut(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> &out.push(bytes[i])
    out
}
fn hex(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a :: Int.from_u8(raw[2 * i])
        b :: Int.from_u8(raw[2 * i + 1])
        high :: if a <= 57 -> a - 48 else -> a - 87
        low :: if b <= 57 -> b - 48 else -> b - 87
        &out.push((U8{high * 16 + low}))
    }
    out
}
fn little(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out = out | (Int.from_u8(bytes[at + i]) << (8 * i))
    out
}
fn store_little(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}
#Test("jetc_v2_rejects_tamper_truncation_append_and_cancellation_without_output") {
    files.write_bytes("source.bin", "authenticated file".bytes()) ?? panic("source")
    recipient :: crypto.X25519SecretKey.new_random() ?? panic("recipient")
    crypto.file_seal([recipient.public_key()], Path.from("source.bin"), Path.from("sealed.jetc")) ?? panic("seal")
    canonical :: files.read_bytes("sealed.jetc") ?? panic("canonical")
    body_at :: 20 + little(canonical, 8, 4)
    loop mode in 0..<17 {
        hostile := canonical.copy()
        if mode == 0 {
            last :: hostile.len() - 1
            hostile[last] = (U8{Int.from_u8(hostile[last]) ~| 1})
        }
        if mode == 1 -> hostile = cut(canonical, 0, canonical.len() - 1)
        if mode == 2 -> &hostile.push(U8{0})
        if mode == 3 -> hostile[4] = (U8{1})
        if mode == 4 -> hostile[5] = (U8{2})
        if mode == 5 -> hostile[6] = (U8{2})
        if mode == 6 -> hostile[7] = (U8{1})
        if mode == 7 -> store_little(&hostile, 8, 4, 32 * 1024 * 1024 + 1)
        if mode == 8 -> store_little(&hostile, 12, 8, 1099511627776 + 21 * 1048577 + 1)
        if mode == 9 -> store_little(&hostile, 84, 4, 1)
        if mode == 10 -> store_little(&hostile, 88, 2, 0)
        if mode == 11 -> store_little(&hostile, 88, 2, 257)
        if mode == 12 -> store_little(&hostile, 90, 4, 1)
        if mode == 13 -> hostile[94] = (U8{Int.from_u8(hostile[94]) ~| 1})
        if mode == 14 -> loop i in 110..<142 -> hostile[i] = (U8{0})
        if mode == 15 -> store_little(&hostile, body_at, 4, 1048576 + 1)
        if mode == 16 -> hostile[body_at + 4] = (U8{2})
        input :: "hostile-{mode}.jetc"
        output :: "hostile-{mode}.out"
        files.write_bytes(input, hostile) ?? panic("hostile")
        assert_eq(crypto.file_open(&recipient, Path.from(input), Path.from(output)), Err(crypto.FileCryptoError.OpenFailed))
        assert(!files.exists(output))
    }
}
