// tests/fixtures/crypto_bridge_entropy.rs:798-860. KNOWN-FAILING #4821 #4841. Runtime UNRUN.
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use core.crypto as crypto
use core.crypto.expert as expert
use core.files as files
fn filled(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> &out.push((U8{value}))
    out
}
fn cut(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> &out.push(bytes[i])
    out
}
fn hex(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a :: Int.from_u8(raw[2 * i])
        b :: Int.from_u8(raw[2 * i + 1])
        high :: if a <= 57 -> a - 48 else -> a - 87
        low :: if b <= 57 -> b - 48 else -> b - 87
        &out.push((U8{high * 16 + low}))
    }
    out
}
fn little(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out = out | (Int.from_u8(bytes[at + i]) << (8 * i))
    out
}
fn store_little(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}
#Test("jetc_v2_streams_authenticated_chunks_and_publishes_without_overwrite") {
    plain := filled(90, 1048576 + 17)
    plain[0] = (U8{1})
    plain[1048576] = (U8{2})
    files.write_bytes("source.bin", plain) ?? panic("source")
    recipient :: crypto.X25519SecretKey.new_random() ?? panic("recipient")
    crypto.file_seal([recipient.public_key()], Path.from("source.bin"), Path.from("sealed.jetc")) ?? panic("seal")
    encoded :: files.read_bytes("sealed.jetc") ?? panic("encoded")
    assert_eq(cut(encoded, 0, 8), [U8]{74, 69, 84, 67, 2, 1, 1, 0})
    header_len :: little(encoded, 8, 4)
    body_len :: little(encoded, 12, 8)
    assert_eq(header_len, 74 + 96 + 16)
    assert_eq(encoded.len(), 20 + header_len + body_len)
    body :: cut(encoded, 20 + header_len, encoded.len())
    assert_eq(little(body, 0, 4), 1048576)
    assert_eq(body[4], U8{0})
    final_at :: 5 + 1048576 + 16
    assert_eq(little(body, final_at, 4), 17)
    assert_eq(body[final_at + 4], U8{1})
    crypto.file_open(&recipient, Path.from("sealed.jetc"), Path.from("restored.bin")) ?? panic("open")
    assert_eq(files.read_bytes("restored.bin") ?? panic("restored"), plain)
    wrong :: crypto.X25519SecretKey.new_random() ?? panic("wrong")
    assert_eq(crypto.file_open(&wrong, Path.from("sealed.jetc"), Path.from("wrong.bin")), Err(crypto.FileCryptoError.OpenFailed))
    assert(!files.exists("wrong.bin"))
    files.write_bytes("restored.bin", "do not replace".bytes()) ?? panic("sentinel")
    // Ratified DestinationExists, not drift PublishFailed: #4821, Core crypto.jet54-58,531-535.
    assert_eq(crypto.file_open(&recipient, Path.from("sealed.jetc"), Path.from("restored.bin")), Err(crypto.FileCryptoError.DestinationExists))
    assert_eq(files.read_bytes("restored.bin") ?? panic("preserved"), "do not replace".bytes())
}
