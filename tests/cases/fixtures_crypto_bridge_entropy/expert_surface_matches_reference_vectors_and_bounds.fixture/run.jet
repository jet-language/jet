// tests/fixtures/crypto_bridge_entropy.rs:470-520. PENDING-SAME-HEAD. Runtime UNRUN.
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use core.crypto as crypto
use core.crypto.expert as expert
use core.files as files
fn filled(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> &out.push((U8{value}))
    out
}
fn cut(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> &out.push(bytes[i])
    out
}
fn hex(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a :: Int.from_u8(raw[2 * i])
        b :: Int.from_u8(raw[2 * i + 1])
        high :: if a <= 57 -> a - 48 else -> a - 87
        low :: if b <= 57 -> b - 48 else -> b - 87
        &out.push((U8{high * 16 + low}))
    }
    out
}
fn little(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out = out | (Int.from_u8(bytes[at + i]) << (8 * i))
    out
}
fn store_little(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}
#Test("expert_surface_matches_reference_vectors_and_bounds") {
    #Unsafe("original expert interoperability vectors") {
        key :: filled(128, 32)
        xnonce :: filled(36, 24)
        anonce :: filled(18, 12)
        message :: "expert crypto".bytes()
        aad :: "tenant".bytes()
        xs :: expert.xchacha20poly1305_seal(key, xnonce, message, aad) ?? panic("xseal")
        assert_eq(expert.xchacha20poly1305_open(key, xnonce, xs, aad) ?? panic("xopen"), message)
        as_ :: expert.aes256gcm_seal(key, anonce, message, aad) ?? panic("aseal")
        assert_eq(expert.aes256gcm_open(key, anonce, as_, aad) ?? panic("aopen"), message)
        assert_eq(expert.xchacha20poly1305_open(key, xnonce, xs, "wrong".bytes()), Err(crypto.CryptoError.OpenFailed))
        // expert.jet485 Length; 585 KeyRejected; 560 and516 Length. Rust payload/Display RETIRE.
        assert_eq(expert.aes256gcm_seal(key, xnonce, message, aad), Err(crypto.CryptoError.Length))
        seed :: hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
        public :: hex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
        expected :: hex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
        sig :: expert.ed25519_sign(seed, [U8]{}) ?? panic("sign")
        assert_eq(sig.bytes, expected)
        assert(expert.ed25519_verify_strict(public, [U8]{}, expected) ?? panic("strict verify"))
        alice :: hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
        bob :: hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
        shared :: expert.x25519_raw(alice, bob) ?? panic("shared")
        assert(crypto.constant_time_equal(shared, crypto.Secret.from_bytes(hex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"))))
        assert_eq(expert.x25519_raw(alice, filled(0, 32)), Err(crypto.CryptoError.KeyRejected))
        ikm :: filled(11, 22)
        salt :: hex("000102030405060708090a0b0c")
        info :: hex("f0f1f2f3f4f5f6f7f8f9")
        okm :: expert.hkdf_sha256_raw(ikm, salt, info, 42) ?? panic("hkdf")
        assert(crypto.constant_time_equal(okm, crypto.Secret.from_bytes(hex("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"))))
        assert_eq(expert.hkdf_sha256_raw(ikm, salt, info, 8161), Err(crypto.CryptoError.Length))
        assert_eq(expert.hkdf_sha256_raw(ikm, salt, info, -1), Err(crypto.CryptoError.Length))
        password :: crypto.Secret.from_text("password")
        derived :: expert.argon2id(password, "12345678".bytes(), 8192, 1, 1, 32) ?? panic("argon")
        assert_eq(expert.secret_bytes(derived).len(), 32)
        assert_eq(expert.argon2id(password, "short".bytes(), 8192, 1, 1, 32), Err(crypto.CryptoError.Length))
        assert_eq(expert.argon2id(password, "12345678".bytes(), 8192, 1, 1, -1), Err(crypto.CryptoError.Length))
    }
}
