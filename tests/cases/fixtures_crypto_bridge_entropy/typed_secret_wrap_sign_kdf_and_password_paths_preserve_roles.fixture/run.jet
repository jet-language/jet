// tests/fixtures/crypto_bridge_entropy.rs:418-467. PORT+PENDING-SEAM(runtime-crypto-internals). Runtime UNRUN.
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use core.crypto as crypto
use core.crypto.expert as expert
use core.files as files
fn filled(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> &out.push((U8{value}))
    out
}
fn cut(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> &out.push(bytes[i])
    out
}
fn hex(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a :: Int.from_u8(raw[2 * i])
        b :: Int.from_u8(raw[2 * i + 1])
        high :: if a <= 57 -> a - 48 else -> a - 87
        low :: if b <= 57 -> b - 48 else -> b - 87
        &out.push((U8{high * 16 + low}))
    }
    out
}
fn little(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out = out | (Int.from_u8(bytes[at + i]) << (8 * i))
    out
}
fn store_little(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}
#Test("typed_secret_wrap_sign_kdf_and_password_paths_preserve_roles") {
    recipient :: crypto.X25519SecretKey.new_random() ?? panic("recipient")
    secret :: crypto.Secret.from_text("do not print")
    wrapped :: crypto.wrap(secret, recipient.public_key()) ?? panic("wrap")
    assert_eq(cut(wrapped.bytes, 0, 4), "JETW".bytes())
    unwrapped :: crypto.unwrap(recipient, crypto.WrappedKey{bytes: wrapped.bytes.copy()}) ?? panic("unwrap")
    assert(crypto.constant_time_equal(secret, unwrapped))
    derived :: crypto.hkdf_sha256(secret.bytes, [U8]{}, "domain".bytes(), 32) ?? panic("derive")
    assert(!crypto.constant_time_equal(secret, derived))
    // Core/crypto/crypto.jet282: Length; payload/Display RETIRE.
    assert_eq(crypto.hkdf_sha256(secret.bytes, [U8]{}, [U8]{}, -1), Err(crypto.CryptoError.Length))
    signing :: crypto.SigningKey.new_random() ?? panic("signing")
    message :: "release".bytes()
    signature :: crypto.sign(signing, message) ?? panic("sign")
    assert(crypto.verify(signing.public_key(), message, signature) ?? panic("verify"))
    stored :: crypto.password_hash(secret) ?? panic("hash")
    assert(crypto.password_verify(secret, stored) ?? panic("password verify"))
    // Core/crypto/crypto.jet795-799: KeyRejected for unsupported PHC algorithm/version/extra parameters.
    extra :: crypto.PasswordHash{text: stored.text.replace(",p=1$", ",p=1,x=1$")}
    assert_eq(crypto.password_verify(secret, extra), Err(crypto.CryptoError.KeyRejected))
    loop algorithm in ["argon2i", "argon2d", "argon2x"] {
        hostile :: crypto.PasswordHash{text: stored.text.replace("$argon2id$", "${algorithm}$")}
        assert_eq(crypto.password_verify(secret, hostile), Err(crypto.CryptoError.KeyRejected))
    }
    loop version in ["16", "300"] {
        hostile :: crypto.PasswordHash{text: stored.text.replace("$v=19$", "$v={version}$")}
        assert_eq(crypto.password_verify(secret, hostile), Err(crypto.CryptoError.KeyRejected))
    }
    wrong :: crypto.Secret.from_text("wrong")
    stored_again :: crypto.password_hash(secret) ?? panic("hash again")
    assert(!(crypto.password_verify(wrong, stored_again) ?? panic("wrong password")))
}
