// tests/fixtures/crypto_bridge_entropy.rs:260-288. KNOWN-FAILING #4821 + PENDING-SEAM(runtime-crypto-internals). Runtime UNRUN.
// CryptoError payloads retire under D-CRYPTO-ERRFAM1=A; public tag mappings cite Core at assertion sites.
use core.crypto as crypto
use core.crypto.expert as expert
use core.files as files
fn filled(value: Int, count: Int) -> [U8] {
    out := [U8]{}
    loop _ in 0..<count -> &out.push((U8{value}))
    out
}
fn cut(bytes: [U8], start: Int, end: Int) -> [U8] {
    out := [U8]{}
    loop i in start..<end -> &out.push(bytes[i])
    out
}
fn hex(text: String) -> [U8] {
    raw :: text.bytes()
    out := [U8]{}
    loop i in 0..<(raw.len() /% 2) {
        a :: Int.from_u8(raw[2 * i])
        b :: Int.from_u8(raw[2 * i + 1])
        high :: if a <= 57 -> a - 48 else -> a - 87
        low :: if b <= 57 -> b - 48 else -> b - 87
        &out.push((U8{high * 16 + low}))
    }
    out
}
fn little(bytes: [U8], at: Int, width: Int) -> Int {
    out := 0
    loop i in 0..<width -> out = out | (Int.from_u8(bytes[at + i]) << (8 * i))
    out
}
fn store_little(bytes: &[U8], at: Int, width: Int, value: Int) {
    loop i in 0..<width -> bytes[at + i] = (U8{(value >> (8 * i)) & 255})
}
fn file_tag(error: crypto.FileCryptoError) -> String {
    if error == {
        .OpenFailed -> "open-failed"
        .SealFailed -> "seal-failed"
        .SourceIO -> "source-io"
        .DestinationExists -> "destination-exists"
        .DestinationIO -> "destination-io"
    }
}
#Test("file_crypto_error_projection_is_exhaustive_and_redacted") {
    // D-CRYPTO-ERRFAM1=A keeps all five file-error cases payload-free.
    public :: [crypto.FileCryptoError]{.OpenFailed, .SealFailed, .SourceIO, .DestinationExists, .DestinationIO}
    tags := [String]{}
    loop error in public -> &tags.push(file_tag(error))
    assert_eq(tags, ["open-failed", "seal-failed", "source-io", "destination-exists", "destination-io"])
}
