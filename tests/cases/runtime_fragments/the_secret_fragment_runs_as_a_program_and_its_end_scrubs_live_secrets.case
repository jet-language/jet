# The Secret runtime test fragment (Compiler/JetRuntime/Tests/Fragments.fixture/SecretTests.jet)
# runs as a program, not only type-checked by `RuntimePack.jet unit --check`. These are the
# plain transport's steps (Tools/agent/CompilerRegistries.jet drive): RuntimePack composes the
# runtime unit with the fragment, the front lowers it as the library a C host links, and
# tests/fixtures/runtime_fragment_host.c runs its entry under jet_rt_main to the real process
# end. secret_tests_ended then sees that the end zeroed the live Secret's whole buffer, spare
# capacity included, and left its header, so the Secret still drops.
requires: os-name:linux
requires: tool:cc
requires: tool:as
mkdir: native/Source
step unit: jet {root}/Compiler/Toolchain/RuntimePack.jet --root {root}/Compiler unit raw --test Secret
timeout: 600s
exit: 0
write: glue.jet = "\n#Export(c) jet_rt_plain_fixture: fn() { secret_tests() }\n#Export(c) jet_rt_plain_fixture_ended: fn() { secret_tests_ended() }\n"
concat: native/Source/Fixture.jet raw/unit.jet glue.jet
copy: {root}/Compiler/JetRuntime/package.jet native/package.jet
# The fragment witnesses the allocator a program built without `--checked-alloc` runs, so the
# checked heap's init hook stays out.
copy: {root}/Compiler/JetRuntime/lifecycle.list lifecycle.full
capture: lifecycle = text file.filter(!^= "jet_rt_alloc_check_init ") lifecycle.full
write: native/lifecycle.list = "{cap:lifecycle}\n"
step library: jet doc {work}/native/Source/Fixture.jet
cwd: native/Source
env: JET_FRONT_LIBRARY_OBJECT_OUTPUT={work}/native/fixture
env: JET_FRONT_LIBRARY_LIFECYCLE={work}/native/lifecycle.list
timeout: 1800s
exit: 0
file: native/fixture.issues absent # the front lowered every function of the unit
file: native/fixture.o exists
write: fault-report.S = "    .text\n    .globl jet_rt_fault_report\n    .type jet_rt_fault_report, @function\njet_rt_fault_report:\n    .include \"{root}/Compiler/JetRuntime/Assets/FaultReport/report.S\"\n    .size jet_rt_fault_report, . - jet_rt_fault_report\n    .section .note.GNU-stack,\"\",@progbits\n"
step: as --64 -o fault-report.o fault-report.S
exit: 0
step: cc -std=c11 -Wall -Wextra -Werror {root}/tests/fixtures/runtime_fragment_host.c native/fixture.o fault-report.o -lpthread -ldl -lm -o fragment
exit: 0
step run: {work}/fragment
timeout: 60s
exit: 0
stdout: = "secret tests: ok\n"
stderr: empty
