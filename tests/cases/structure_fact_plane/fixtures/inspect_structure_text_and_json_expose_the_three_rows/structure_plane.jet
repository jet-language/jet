// `jet inspect structure Examples/Tooling/StructurePlane/run.jet`
// exposes the registered structure rows without changing this program.
use "structure_plane/support"

// Declarations are public by default; a `priv module` member
// that nothing calls is the program's liveness fact.
priv draft: module {
    unused_structure_subject: fn() {}
}

run: fn() {
    support.old()
    // A written `_name` is a deliberate structure gate (D-GATE-LAW1=A).
    _draft_note: "kept for the next release"
    print("structure fact plane")
}
