
#Job
migrate: fn(to: String{"latest"}) {
    print("migrate {to}")
}
#Job(after: ["migrate"])
populate: fn(label: String{"dev"}) {
    print("populate {label}")
}
#Job
web: fn(port: Int{8080}, host: String{"127.0.0.1"}) {
    print("web host={host} port={port}")
}
#Job
broken: fn() {
    panic("broken job")
}
#Job(after: ["broken"])
needs_broken: fn() {
    print("needs_broken ran")
}
run: fn() {}
