# D-JOB-SUBCMD1=C: the program's first word selects a job before `run: fn`.
# `jet run` and a dev binary run bare, `.Dev` and `.Ship` jobs; a release
# binary runs `.Ship` jobs only and reports any other job word as an unknown
# command with the `#Job(.Ship)` fix. An `.Internal` job never reaches argv,
# so its word is an ordinary program argument and `run: fn` runs.
fixture: program_word_selects_a_visible_job.fixture
env: NO_COLOR=1
step: jet run main.jet -- greet
exit: 0
stdout: = program_word_selects_a_visible_job.greet.out
step: jet run main.jet -- seed_data
exit: 0
stdout: = program_word_selects_a_visible_job.seed_data.out
step: jet run main.jet -- tidy
exit: 0
stdout: = program_word_selects_a_visible_job.tidy.out
step: jet run main.jet -- inspect_job
exit: 0
stdout: = program_word_selects_a_visible_job.run.out
step: jet run main.jet
exit: 0
stdout: = program_word_selects_a_visible_job.run.out
step: jet build main.jet
exit: 0
step: built seed_data
exit: 0
stdout: = program_word_selects_a_visible_job.seed_data.out
step: built tidy
exit: 0
stdout: = program_word_selects_a_visible_job.tidy.out
step: jet build main.jet --release
exit: 0
step: built greet
exit: 0
stdout: = program_word_selects_a_visible_job.greet.out
step: built seed_data
exit: 1
stderr: ~ 'mark `seed_data` `#Job(.Ship)` to ship it' # the report names the fix
stdout: = ""
step: built tidy
exit: 1
stderr: ~ 'unknown command `tidy`' # a bare #Job is .Dev
stdout: = ""
step: built inspect_job
exit: 0
stdout: = program_word_selects_a_visible_job.run.out
