# Outside any package, a directory target's programs are the sources under it. A
# sibling's inline dependency still needs the declared environment, but `jet test lib` no
# longer reads it (it stopped `jet test Core/Encoding` with E1355 in a checkout).
fixture: loose_directory_test_reads_only_its_own_sources_for_the_boundary.fixture
env: NO_COLOR=1
step: jet test stats.jet
unset: JETPACK_ENV
unset: JETPACK_ENV_DIR
unset: JETPACK_ENV_HASH
exit: 1
stderr: ~ "Error [jet.OutsideProjectEnvironment]" # the importer itself still needs the environment
stderr: ~ "Import: `use textkit#1.4`" # the importer itself still needs the environment
step: jet test lib
unset: JETPACK_ENV
unset: JETPACK_ENV_DIR
unset: JETPACK_ENV_HASH
exit: 0
stdout: = "a loose directory needs no environment its siblings import: pass\n1 passed, 0 failed, 0 skipped\n"
stderr: !~ "OutsideProjectEnvironment" # the sibling outside `lib` is no part of its programs
