# A user-owned Transform suffix never supplies a Core identity or Display.
fixture: user_transform_suffix_grants_no_capability.fixture
step: jet check main.jet
exit: nonzero
stderr: ~ "[jet.ValueTypeMismatch]" # a user suffix does not grant Core reflection capability
stderr: ~ "[jet.MissingDisplay]" # a user suffix does not grant Core Display
stderr: !~ "[jet.UnknownType]" # the impostor is a resolved user declaration, not an unknown type
