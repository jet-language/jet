// A library metaprogram that passes the root's `Compiler` value on to a
// helper, which adds the code.
install: fn(meta: Compiler) {
    stage(meta)
}

stage: fn(meta: Compiler) {
    meta.add(#code {
        greeting: fn() -> String { "added by the tool" }
    }, scope: "greeting")
}

// The same chain, adding code with a type error.
install_broken: fn(meta: Compiler) {
    stage_broken(meta)
}

stage_broken: fn(meta: Compiler) {
    meta.add(#code {
        count: fn() -> Int { "not a number" }
    }, scope: "count")
}
