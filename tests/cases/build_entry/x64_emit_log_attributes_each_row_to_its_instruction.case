# #6694: JET_X64_EMIT_LOG keeps the x86-64 selector's emission log of each
# named function in JET_X64_EMIT_LOG_REPORT: the slot IR the selector
# consumed, each slot's checked type, and a row per jump, call and memory
# operand the encoder wrote, attributed to the IR instruction it lowers. A
# jump to a stop is marked, with the slot its condition reads when there is
# one. Each struct's members are laid out first, by offset and size. A
# function the list does not name has no log.
fixture: x64_emit_log_attributes_each_row_to_its_instruction.fixture
step: jet build -O0 main.jet
env: JET_X64_EMIT_LOG=pick,widen
env: JET_X64_EMIT_LOG_REPORT={work}/emit.log
env: NO_COLOR=1
exit: 0
file: emit.log count-lines ^= "x64 " = 2 # one log per named function
file: emit.log ~ "fn pick [" # the IR the selector consumed
file: emit.log ~ "type s0 " # each slot's checked type
file: emit.log ~ " jcc " # the If's conditional jump
file: emit.log ~ " memory " # the element load's memory operand
file: emit.log count-lines ^= "end" = 2 # each log's closing row
file: emit.log ~ " jcc ae stop s" # the shift's count stop reads the count alone
file: emit.log ~ " jcc ne stop" # the U32 addition's overflow stop
file: emit.log ~ " 0 8 start" # Span's Int member, placed first by alignment
file: emit.log ~ " 8 1 count" # and its U8 member after it
file: emit.log !~ "fn run [" # a function the list does not name
step: jet build -O2 main.jet
env: JET_X64_EMIT_LOG=pick,run
env: JET_X64_EMIT_LOG_REPORT={work}/full.log
env: NO_COLOR=1
exit: 0
file: full.log ~ "fn run [" # the list's second name, at O2
