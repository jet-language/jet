// The build makes `Shape` from values: its fields are a list it joins into
// source text, which `meta.add` parses as it adds the type.
build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    fields: [String]{"flag: U8", "id: I64", "count: I32"}
    body: fields.join("\n    ")
    meta.add("Shape: struct {{\n    {body}\n}}\n", scope: "shape")
    b.default(app)
}

SHAPE_ID: #run Shape.reflect().identity
SHAPE_SIZE: #run { Shape.reflect().layout.size ?? -1 }
SHAPE_ALIGNMENT: #run { Shape.reflect().layout.alignment ?? -1 }
AT_FLAG: #run { Shape.reflect().layout.fields[0].offset ?? -1 }
AT_ID: #run { Shape.reflect().layout.fields[1].offset ?? -1 }
AT_COUNT: #run { Shape.reflect().layout.fields[2].offset ?? -1 }

run: fn() {
    shape: Shape{flag: U8{1}, id: I64{40}, count: I32{2}}
    print("{SHAPE_ID}: size {SHAPE_SIZE}, alignment {SHAPE_ALIGNMENT}, flag at {AT_FLAG}, id at {AT_ID}, count at {AT_COUNT}")
    print(shape.id + I64{shape.count})
}
