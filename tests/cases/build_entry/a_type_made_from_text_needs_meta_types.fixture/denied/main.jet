// The same type factory under a row that denies `Meta.Types`.
build: fn(b: Build) -[!Meta.Types]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    fields: [String]{"flag: U8", "id: I64", "count: I32"}
    body: fields.join("\n    ")
    meta.add("Shape: struct {{\n    {body}\n}}\n", scope: "shape")
    b.default(app)
}

run: fn() {
    print(Shape{flag: U8{1}, id: I64{40}, count: I32{2}}.id)
}
