
build: fn(b: Build) -[Exec]> {
    #Impure("find the shell the step names") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("never-run", b.found(shell), [])
    action.arg("-c")
    action.arg("exit 99")
    action.writes("out")
    app: b.add_executable("app", ["main.jet"], [action])
    b.default(app)
    }
}
run: fn() {}
