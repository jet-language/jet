
fn build(b: Build) {
    b.generate("consumer") {
        fn generated_value() -> String { "round two" }
    }
    b.generate("provider") {
        fn message() -> String { "round two" }
        }
    app :: b.add_executable("app", ["main.jet", ".jet/generated/main/consumer.jet", ".jet/generated/main/provider.jet"], [])
    b.default(app)
}
fn run() { print(generated_value()) }
