
build: fn(b: Build) {
    b.generate("consumer") {
        generated_value: fn() -> String { "round two" }
    }
    b.generate("provider") {
        message: fn() -> String { "round two" }
        }
    app: b.add_executable("app", ["main.jet", ".jet/generated/main/consumer.jet", ".jet/generated/main/provider.jet"], [])
    b.default(app)
}
run: fn() { print(generated_value()) }
