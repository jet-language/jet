
build: fn(b: Build) -[Exec]> {
    #Impure("policy chain test") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("stamp", b.found(shell), ["Exec"])
    action.arg("-c")
    action.arg("printf ok > stamp")
    action.writes("stamp")
    app: b.add_executable("app", ["main.jet"], [action])
    b.default(app)
    }
}
run: fn() {}
