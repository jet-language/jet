build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the step that makes a committed file") {
    // `table.txt` is committed, and the step `table` makes it from
    // `version.txt`, so the step keeps it in git.
    shell: b.probe("shell", "find_program", "sh")
    table: b.run("table", b.found(shell), ["Exec", "FS"])
    table.arg("-c")
    table.arg("read -r line < \"$0\"; printf '%s\\n' \"$line\" > \"$1\"")
    table.input("version.txt")
    table.output("table.txt", kept: true)
    app: b.add_executable("app", ["main.jet"], [table])
    b.default(app)
    }
}
run: fn() {}
