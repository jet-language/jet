build: fn(b: Build) -[Exec]> {
    #Impure("find the shell") {
    b.generate("facts") {
        answer: fn() -> Int { 42 }
    }
    shell: b.probe("shell", "find_program", "sh")
    // The step claims the module `b.generate("facts")` makes.
    make: b.run("make", b.found(shell), [])
    make.writes(".jet/generated/main/facts.jet")
    app: b.add_executable("app", ["main.jet"], [])
    b.default(app)
    }
}

run: fn() { print("{answer()}") }
