
build: fn(b: Build) -[Exec, FS]> {
    #Impure("exercise hostile output path") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("escape", b.found(shell), ["Exec", "FS"])
    action.arg("-c")
    action.arg("mkdir -p redirect; printf escaped > redirect/pwn")
    action.writes("redirect/pwn")
    app: b.add_executable("app", ["main.jet"], [action])
    b.default(app)
    }
}
run: fn() {}
