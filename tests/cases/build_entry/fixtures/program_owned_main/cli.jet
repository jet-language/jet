// Its generated CLI parser reads the arguments, parses an Int, writes a
// refusal to stderr or the help to stdout and leaves through process.exit:
// all root-free routes with nothing to clean up on a stop, so it owns its
// main.
#CLI
Args: struct {
    n: Int
}

run: fn(args: Args) {
    print("half {args.n /% 2}")
}
