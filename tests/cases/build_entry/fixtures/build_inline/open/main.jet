// `mix` is marked `#Inline(Always)` and past the O1 callee limit; `bump` is
// small and unmarked. `inline: auto` inlines `bump` only, `always_marked`
// `mix` only, and `off` neither; the output is the same under every value.
#Inline(Always)
fn mix(a: Int, b: Int) -> Int {
    x := (a * 31 + b) % 1000003
    y := (x * 17 + a % 7) % 1000003
    z := (y * 13 + x % 11) % 1000003
    w := (z * 7 + y % 5) % 1000003
    v := (w * 3 + z % 13) % 1000003
    u := (v * 29 + w % 17) % 1000003
    (u * 5 + v % 19) % 1000003
}

fn bump(a: Int) -> Int {
    (a * 3 + 1) % 1000003
}

fn stage_one(t: Int) -> Int {
    s := mix(t, 1)
    s = bump(s)
    s = mix(s, 2)
    s = bump(s)
    s = mix(s, 3)
    bump(s)
}

fn stage_two(t: Int) -> Int {
    s := mix(t, 4)
    s = bump(s)
    s = mix(s, 5)
    s = bump(s)
    s = mix(s, 6)
    bump(s)
}

fn stage_three(t: Int) -> Int {
    s := mix(t, 7)
    s = bump(s)
    s = mix(s, 8)
    s = bump(s)
    s = mix(s, 9)
    bump(s)
}

fn run() {
    t := 1
    loop round in 0..<3 -> t = stage_three(stage_two(stage_one(t + round)))
    print("mixed: {t}")
}
