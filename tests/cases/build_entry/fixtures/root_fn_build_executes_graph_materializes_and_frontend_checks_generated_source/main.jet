
build: fn(b: Build) -[Exec, FS]> {
    b.generate("generated_message") {
        generated_message: fn() -> String { return "built" }
    }
    #Impure("write declared build output") {
        shell: b.probe("shell", "find_program", "sh")
        stamp: b.run("stamp", b.found(shell), ["Exec", "FS"])
        stamp.arg("-c")
        stamp.arg("printf stamped > .jet/generated/app/stamp.txt")
        stamp.writes(".jet/generated/app/stamp.txt")
        app: b.add_executable("app", ["main.jet", ".jet/generated/main/generated_message.jet"], [stamp])
        b.default(app)
    }
}

run: fn() { print("ok") }
