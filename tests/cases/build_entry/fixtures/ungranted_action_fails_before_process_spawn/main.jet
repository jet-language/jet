
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("exercise denied authority") {
    action :: b.action("escape", [], ["out"], ["sh", "-c", "printf bad > out"], ["Exec"])
    app :: b.add_executable("app", ["main.jet"], [action])
    return b.plan(app)
    }
    return b.plan()
}
fn run() {}
