
build: fn(b: Build) -[Exec]> {
    #Impure("locked action output") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("emit", b.found(shell), ["Exec"])
    action.arg("-c")
    action.arg("printf one > artifact")
    action.writes("artifact")
    app: b.add_executable("app", ["main.jet"], [action])
    b.default(app)
    }
}
run: fn() {}
