
build: fn(b: Build) -[FS]> {
    files: b.find("assets/*.txt")
    message: b.embed(files[0])
    b.generate("asset") {
        generated_asset: fn() -> String { "hello" }
        }
    app: b.add_executable("app", ["main.jet", ".jet/generated/main/asset.jet"], [])
    b.default(app)
}
run: fn() { print(generated_asset()) }
