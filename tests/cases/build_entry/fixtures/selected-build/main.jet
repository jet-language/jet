
build: fn(b: Build) -[Exec, FS]> {
    #Impure("write CLI test output") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("stamp", b.found(shell), ["Exec", "FS"])
    action.arg("-c")
    action.arg("printf cli-built > stamp.txt")
    action.writes("stamp.txt")
    app: b.add_executable("app", ["main.jet"], [action])
    b.default(app)
    }
}
run: fn() { print("ok") }
