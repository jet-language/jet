build: fn(b: Build) -[Exec, FS]> {
    #Impure("run declared steps") {
        shell: b.probe("shell", "find_program", "sh")
        greet: b.run("greet", b.found(shell), ["Exec", "FS"])
        greet.arg("-c")
        greet.arg("read -r word < greeting.txt; printf '%s [%s] [%s]' \"$word\" \"$SECRET\" \"$HOME\" > greet.txt")
        greet.reads("greeting.txt")
        greet.writes("greet.txt")
        announce: b.run("announce", b.found(shell), ["Exec", "FS"])
        announce.arg("-c")
        announce.arg("read -r gate < gate.txt; test \"$gate\" = open && printf ok > announce.txt")
        announce.reads("gate.txt")
        announce.writes("announce.txt")
        app: b.add_executable("app", ["main.jet"], [greet, announce])
        b.default(app)
    }
}

run: fn() {}
