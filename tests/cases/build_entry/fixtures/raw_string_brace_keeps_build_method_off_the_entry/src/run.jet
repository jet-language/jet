// The raw string's lone `}` is text, not the end of a block: the `build`
// method below stays inside its impl and is no package build entry.
CLOSER: ```}```

Target: struct {
    name: String
}

impl Target {
    build: fn(self, system: String) -> String Never! { "{self.name}-{system}{CLOSER}" }
}

run: fn() {
    print(Target{name: "box"}.build("linux"))
}
