
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("declare an inspectable action") {
        action :: b.action("never-run", [], ["out"], ["sh", "-c", "exit 91"], ["Exec", "FS"])
        app :: b.add_executable("app", ["main.jet"], [action])
        return b.plan(app)
    }
    return b.plan()
}
fn run() {}
