
build: fn(b: Build) -[Exec, FS]> {
    #Impure("declare an inspectable action") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("never-run", b.found(shell), ["Exec", "FS"])
        action.arg("-c")
        action.arg("exit 91")
        action.writes("out")
        app: b.add_executable("app", ["main.jet"], [action])
        b.default(app)
    }
}
run: fn() {}
