// `parts` lists helper.jet beside parts.jet: `doubled` calls what only helper.jet declares.
// With no `b.default`, `jet build` builds both targets.
build: fn(b: Build) {
    _ := b.add_library("parts", ["parts.jet", "helper.jet"], [])
    _ := b.add_executable("app", ["main.jet"], [])
}

run: fn() {
    print("built")
}
