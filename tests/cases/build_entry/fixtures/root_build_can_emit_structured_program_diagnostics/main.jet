
struct Entity { id: Int }

fn build(b: BuildContext) -> BuildPlan {
    types :: b.program.types()
    entity :: types[0]
    b.error(
        entity.span,
        "ORG01",
        "entity must define archive",
        "company policy requires archival",
        "add an archive method"
    )
    return b.plan()
}

fn run() {}
