// Original predicate: tests/build_entry.rs:3474-3491,3513-3516.
// A 1s nonblocking accept/yield window is equivalent to accept(deadline:1s):
// ANY accepted connection = true; expiration OR ANY other error = false.
// TestLead1 approved this exact Boolean equivalence; no deadline-zero shortcut.
use core.net as net
use core.files as files
use core.process as process
fn run() {
    args :: process.argv().skip(1).to_list()
    listener := net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.listener_local_socket_addr(listener) ?? panic("address")
    files.write(args[0], "{net.socket_port(address)}") ?? panic("publish port")
    budget :: Duration.milliseconds(1000) ?? panic("observer budget")
    connected :: if &listener.accept(deadline: budget) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
    assert(!connected, "BuildContext.fetch contacted a private destination")
}
