
fn build(b: BuildContext) -[Exec]> BuildPlan {
    #Impure("workspace ceiling wins last") {
    action :: b.action("stamp", [], ["stamp"], ["sh", "-c", "printf bad > stamp"], ["Exec"])
    app :: b.add_executable("app", ["run.jet"], [action])
    return b.plan(app)
    }
    return b.plan()
}
fn run() {}
