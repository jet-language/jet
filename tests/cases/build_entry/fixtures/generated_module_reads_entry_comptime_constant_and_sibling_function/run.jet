TOKENS: comptime { 3 }

build: fn(b: Build) {
    b.generate("facts") {
        tooling_facts: fn() -> String { "tokens={TOKENS} helper={helper()}" }
    }
    app: b.add_executable("app", ["run.jet", "other.jet", ".jet/generated/run/facts.jet"], [])
    b.default(app)
}

run: fn() {
    print(tooling_facts())
    print("tokens={TOKENS}")
}
