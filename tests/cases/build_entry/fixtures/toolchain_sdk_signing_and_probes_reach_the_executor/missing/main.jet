build: fn(b: Build) -[Exec, FS]> {
    #Impure("probe a library that is not installed") {
        native: b.toolchain("native", "x86_64-unknown-linux-gnu")
        missing: b.probe("missing", "pkg_config", "jet-no-such-library", native)
        shell: b.probe("shell", "find_program", "sh", native)
        stamp: b.run("stamp", b.found(shell), ["Exec", "FS"])
        stamp.arg("-c")
        stamp.arg("printf ran > never.txt")
        stamp.writes("never.txt")
        stamp.toolchain(native)
        app: b.add_executable("app", ["main.jet"], [stamp], [], [missing], native)
        b.default(app)
    }
}

run: fn() {}
