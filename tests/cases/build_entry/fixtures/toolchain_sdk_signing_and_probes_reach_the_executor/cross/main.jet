build: fn(b: Build) -[Exec, FS]> {
    #Impure("probe a cross toolchain that declares no tools") {
        cross: b.toolchain("cross", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu", "sdk-14.2", "lld", "sysroot/aarch64")
        shell: b.probe("shell", "find_program", "sh", cross)
        stamp: b.action(
            "stamp",
            [],
            ["never.txt"],
            ["sh", "-c", "printf ran > never.txt"],
            ["Exec", "FS"],
            cross,
            [shell]
        )
        app: b.add_executable("app", ["main.jet"], [stamp])
        b.default(app)
    }
}

run: fn() {}
