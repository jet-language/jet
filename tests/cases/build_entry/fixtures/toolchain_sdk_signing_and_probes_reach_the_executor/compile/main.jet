fn build(b: Build) -[Exec, FS]> {
    #Impure("compile-check against the host toolchain") {
        native :: b.toolchain("native", "x86_64-unknown-linux-gnu")
        broken :: b.probe("broken", "compile_check", "stdio.h", "int main(void) {{ return missing_symbol; }}", native)
        stamp :: b.action(
            "stamp",
            [],
            ["never.txt"],
            ["sh", "-c", "printf ran > never.txt"],
            ["Exec", "FS"],
            native,
            [broken]
        )
        app :: b.add_executable("app", ["main.jet"], [stamp])
        b.default(app)
    }
}

fn run() {}
