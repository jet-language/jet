
#Error
enum BuildLeftError { One }
#Error
enum BuildRightError { One }
#Error
enum BuildTargetError { One }

impl BuildError -> BuildLeftError { return BuildLeftError.One }
impl BuildError -> BuildRightError { return BuildRightError.One }
impl BuildLeftError -> BuildTargetError { return BuildTargetError.One }
impl BuildRightError -> BuildTargetError { return BuildTargetError.One }

fn build(b: Build) BuildTargetError! {
    first :: b.add_library("app", ["main.jet"], [])
    b.default(first)
}

fn run() {}
