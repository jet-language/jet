
build: fn(b: Build) -[Exec]> {
    #Impure("member must use its own grant") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("stamp", b.found(shell), ["Exec"])
        action.arg("-c")
        action.arg("printf bad > stamp")
        action.writes("stamp")
        app: b.add_executable("app", ["run.jet"], [action])
        b.default(app)
    }
}
run: fn() {}
