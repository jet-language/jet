use files: core.files

build: fn(b: Build) -[Exec, FS]> {
    #Impure("declare a stamp action") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("stamp", b.found(shell), ["Exec", "FS"])
        action.arg("-c")
        action.arg("printf ok > stamp.txt")
        action.reads("impure.jet")
        action.writes("stamp.txt")
        app: b.add_executable("probe_app", ["impure.jet"], [action])
        b.default(app)
    }
}

run: fn() { print(files.exists("stamp.txt")) }
