build: fn(b: Build) -[Exec]> {
    #Impure("declare a step") {
    shell: b.probe("shell", "find_program", "sh")
    quiet: b.run("quiet", b.found(shell), ["Exec"])
    quiet.arg("-c")
    quiet.arg("exit 0")
    app: b.add_executable("app", ["main.jet"], [quiet])
    b.default(app)
    }
}
run: fn() {}
