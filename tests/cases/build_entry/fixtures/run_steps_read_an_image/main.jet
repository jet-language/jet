build: fn(b: Build) -[Exec, FS]> {
    #Impure("pack and run the image") {
    // `gen` is not selected, but steps use its image, so it compiles first:
    // `pack` checks the image is there and names it,
    // `sh -c '[ -s "$0" ] && printf %s "$0" > "$1"' <image> packed.txt`,
    // and `table` runs it to write the source of `show`.
    gen: b.add_executable("gen", ["gen/gen.jet"], [])
    shell: b.probe("shell", "find_program", "sh")
    pack: b.run("pack", b.found(shell), ["Exec", "FS"])
    pack.arg("-c")
    pack.arg("[ -s \"$0\" ] && printf %s \"$0\" > \"$1\"")
    pack.file(b.image(gen))
    pack.output("packed.txt")
    table: b.run("table", b.image(gen), ["Exec", "FS"])
    table.output("show.jet", flag: "--out=")
    show: b.add_executable("show", ["show.jet"], [pack])
    b.default(show)
    }
}
run: fn() {}
