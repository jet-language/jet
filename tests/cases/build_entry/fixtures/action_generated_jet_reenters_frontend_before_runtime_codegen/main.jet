
build: fn(b: Build) -[Exec, FS]> {
    #Impure("generate declared source") {
    shell: b.probe("shell", "find_program", "sh")
    action: b.run("bad-gen", b.found(shell), ["Exec", "FS"])
    action.arg("-c")
    action.arg("printf 'nope: fn(' > .jet/generated/main/bad.jet")
    action.writes(".jet/generated/main/bad.jet")
    app: b.add_executable("app", ["main.jet", ".jet/generated/main/bad.jet"], [action])
    b.default(app)
    }
}
run: fn() {}
