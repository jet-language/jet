build: fn(b: Build) -[Exec, FS]> {
    #Impure("declare a step over a hand-written file") {
    // `notes.txt` is the package's own file, which no build made, so the
    // step that would write over it is refused.
    shell: b.probe("shell", "find_program", "sh")
    notes: b.run("notes", b.found(shell), ["Exec", "FS"])
    notes.arg("-c")
    notes.arg("printf made > \"$0\"")
    notes.output("notes.txt")
    app: b.add_executable("app", ["main.jet"], [notes])
    b.default(app)
    }
}
run: fn() {}
