
fn build(b: BuildContext) -[Exec]> BuildPlan {
    #Impure("inner workspace grant must apply") {
        action :: b.action("stamp", [], ["stamp"], ["sh", "-c", "printf inner > stamp"], ["Exec"])
        app :: b.add_executable("app", ["run.jet"], [action])
        return b.plan(app)
    }
    return b.plan()
}
fn run() {}
