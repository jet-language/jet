fn build(b: Build) -[Exec, FS]> {
    #Impure("run declared actions") {
        tc :: b.toolchain("native", "x86_64-linux")
        signer :: b.signing("dev", "Developer")
        greet :: b.action(
            "greet",
            ["greeting.txt"],
            ["greet.txt"],
            ["sh", "-c", "read -r word < greeting.txt; printf '%s %s [%s] [%s]' \"$GREETING\" \"$word\" \"$SECRET\" \"$HOME\" > greet.txt"],
            ["Exec", "FS"],
            tc,
            [],
            signer,
            "generic",
            [],
            ["GREETING=hello", "SECRET=leaked"],
            ["GREETING"],
            [],
            [],
            "cached"
        )
        announce :: b.action(
            "announce",
            ["gate.txt"],
            [],
            ["sh", "-c", "read -r gate < gate.txt; test \"$gate\" = open"],
            ["Exec"],
            tc,
            [],
            signer,
            "generic",
            [],
            [],
            [],
            [],
            [],
            "phony"
        )
        app :: b.add_executable("app", ["main.jet"], [greet, announce])
        b.default(app)
    }
}

fn run() {}
