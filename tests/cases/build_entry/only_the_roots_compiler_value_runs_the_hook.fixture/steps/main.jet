// The root makes a `Compiler` value and declares a step that runs a process.
// The build runs the step as it runs any build's steps.
build: fn(b: Build) -[Exec, FS]> {
    #Impure("run a declared step") {
        shell: b.probe("shell", "find_program", "sh")
        mark: b.run("mark", b.found(shell), ["Exec", "FS"])
        mark.arg("-c")
        mark.arg("printf ran > mark.txt")
        mark.writes("mark.txt")
        app: b.add_executable("app", ["main.jet"], [mark])
        _ := b.compiler(app)
        b.default(app)
    }
}

run: fn() { print("plain") }
