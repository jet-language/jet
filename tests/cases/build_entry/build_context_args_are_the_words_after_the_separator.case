# #5829: `b.args()` returns the words after `--` on `jet build`, so a
# `build: fn` can pick what it builds from them. A file of the package builds
# through the package's `build: fn` (spec.md "Programmable builds"). A build
# that runs no `build: fn` refuses the words instead of dropping them.
fixture: fixtures/build_args
artifact: hello
env: NO_COLOR=1
step: jet build
exit: 0
file: .jet/build/hello exists
file: .jet/build/goodbye absent
step: jet build -- goodbye
exit: 0
file: .jet/build/goodbye exists
step: {work}/.jet/build/goodbye
exit: 0
stdout: = "built\n"
step: jet build main.jet -- goodbye
exit: 0
remove: build.jet
step: jet build main.jet -- goodbye
exit: 2
stderr: ~ "Error [jet.InvalidCommandInput]: `jet build main.jet -- …` passes the words after `--` to `build: fn`, and this build runs none" # a package with no `build: fn` reads no words
