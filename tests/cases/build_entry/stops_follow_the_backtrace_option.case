# A `panic`, a failed `assert` and a failed `assert_eq` follow the
# `backtrace` option as a fault report does: `brief` prints only the
# stopping frame (its location, source line and locals), `off` prints no
# frame, only the stop line and its Why, Fix and More.
fixture: fixtures/stops_follow_the_backtrace_option
env: NO_COLOR=1
step: jet run --backtrace=brief panic.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.panic.brief.stderr
step: jet run --backtrace=off panic.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.panic.off.stderr
step: jet run --backtrace=brief assert.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.assert.brief.stderr
step: jet run --backtrace=off assert.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.assert.off.stderr
step: jet run --backtrace=brief assert_eq.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.assert_eq.brief.stderr
step: jet run --backtrace=off assert_eq.jet
exit: 70
stderr: = stops_follow_the_backtrace_option.assert_eq.off.stderr
step: jet build --backtrace=off panic.jet
exit: 0
step: {work}/.jet/build/panic
exit: 70
stderr: = stops_follow_the_backtrace_option.panic.off.stderr
