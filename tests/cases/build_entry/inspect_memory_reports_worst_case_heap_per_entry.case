# `jet inspect memory` gives the program's entry its worst-case heap, by the
# proof `!Mem.Alloc(above: N)` checks. The heap is the arena bytes every call
# path from the entry may reserve, or, when no bound holds, why not and the
# call path to the reason. One 8-byte arena reserved once gives 8 B. A body
# that reaches no allocation gives 0 B. A list literal allocates storage that
# no byte bound can count, so its entry is unbounded via run -> count. JSON
# carries the same text in the entry's `heap` field.
fixture: inspect_memory_reports_worst_case_heap_per_entry.fixture
env: NO_COLOR=1
step arena: jet inspect memory --optimize=none arena.jet
exit: 0
stdout: ~ "entry run" # the program entry
stdout: ~ "heap: 8 B" # one 8-byte arena, reserved once
step none: jet inspect memory --optimize=none none.jet
exit: 0
stdout: ~ "heap: 0 B" # nothing run reaches allocates
step list: jet inspect memory --optimize=none list.jet
exit: 0
stdout: ~ "heap: unbounded, List construction allocates backing storage at list.jet via " # the list literal's storage has no proven size
stdout: ~ "::run -> " # the path starts at the entry
stdout: ~ "::count" # and ends at the allocating function
step json: jet inspect memory --optimize=none arena.jet --json
exit: 0
json: stdout doc $.entries[0].name = "run"
json: stdout doc $.entries[0].heap = "8 B"
