build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    limit: 3
    meta.events(
        watch: .Calls{to: limit},
        (event) -> {
            if event == .Checked(.Call(c)) -> panic("heard {c.callee}")
        },
    )
    b.default(app)
}

run: fn() { print(1) }
