helper: fn() -> Int { 2 }

other: fn() -> Int { 3 }

build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.events(
        watch: .Calls{to: helper},
        (event) -> {
            if event == .Checked(.Call(c)) -> panic("heard {c.callee} from {c.caller}")
        },
    )
    b.default(app)
}

run: fn() { print(other() + helper()) }
