# `b.image(gen)` is `gen` built for the build's platform, copied to
# `.jet/build/image/gen`: one step reads it as a file and another runs it as
# its tool, and `gen` compiles before either though no plan selects it.
fixture: fixtures/run_steps_read_an_image
artifact: show
requires: tool:sh
requires: tool:bwrap
step: jet build main.jet --allow=Exec,FS
exit: 0
file: .jet/build/image/gen exists # the copy steps read
file: packed.txt = ".jet/build/image/gen" # the step that read the image found it at its path
step: built
stdout: = "42\n"