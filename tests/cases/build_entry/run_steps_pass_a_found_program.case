# `.file(b.found(cc))` passes a step the program a find_program probe finds,
# by the path it runs at in the step's sandbox, which shows it as it shows a
# step's tool. Here `jet-case-cc` on PATH links the machine's gcc, which must
# be in the Nix store: the store is the host layout a step's sandbox shows, so
# a compiler there finds its cc1, as, ld and libraries. Every build runs the
# step again, so linking g++ in its place shows in its output.
fixture: fixtures/run_steps_pass_a_found_program
requires: tool:sh
requires: tool:bwrap
requires: probe sh -c 'readlink -f "$(command -v gcc)"' stdout: ^= "/nix/store/" # a step's sandbox shows the Nix store
requires: probe sh -c 'readlink -f "$(command -v g++)"' stdout: ^= "/nix/store/" # and g++ must be there too
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
env: PATH={work}/bin:{env:PATH}
step: sh -c 'mkdir -p bin && ln -sf "$(readlink -f "$(command -v gcc)")" bin/jet-case-cc'
exit: 0
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/version.txt ^= "gcc " # the step ran the found gcc
file: app/answer.o exists # and compiled answer.c with it
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/.jet/build/receipt.json ~ "\"cache_hit\":false" # nothing changed, and the build ran the step again
step: sh -c 'ln -sf "$(readlink -f "$(command -v g++)")" bin/jet-case-cc'
exit: 0
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/version.txt ^= "g++ " # another program at the same name runs the step again
