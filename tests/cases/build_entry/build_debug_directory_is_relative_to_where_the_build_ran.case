# The image's DWARF and .debug_jetline name the package's source directory
# relative to where `jet build` ran, so naming the package by an absolute path
# builds the same bytes as naming it relative, and neither image names the
# directory the build ran in.
fixture: fixtures/build_debug_directory
env: NO_COLOR=1
step: jet build App
env: JET_STORE_DIR={work}/store-relative
exit: 0
file: App/.jet/build/run !~ "{work}" # the image doesn't name where the package lives
copy: App/.jet/build/run relative-run
remove: App/.jet
step: jet build {work}/App
env: JET_STORE_DIR={work}/store-absolute
exit: 0
file: App/.jet/build/run !~ "{work}" # the absolute spelling records no more
file: App/.jet/build/run == relative-run
step: {work}/App/.jet/build/run
stdout: = "hi\n"
