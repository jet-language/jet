Traced: struct {
    impl Marker {
        sites: [.Function]
    }
}

plain: fn() -> Int { 2 }

greet: fn() -> Int { 1 }

build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    meta.events(
        watch: .Functions{marked: Traced{}},
        fn(event) {
            if event == .Checked(.Function(f)) -> panic("heard {f.name}")
        },
    )
    b.default(app)
}

run: fn() { print(plain() + greet()) }
