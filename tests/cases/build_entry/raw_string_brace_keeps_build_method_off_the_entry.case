# A `}` inside a raw string doesn't end a block, so an impl's
# `build: fn(self, …)` method after it is no package build entry. Before, the
# CLI's byte scan took the method for one and routed `jet build` to the build
# entry the Driver never found (ICE "the completed build query has no plan").
fixture: fixtures/raw_string_brace_keeps_build_method_off_the_entry
step: jet build
exit: 0
stderr: !~ "internal compiler error" # the build runs as the package's `run` program, not as a missing build entry
step: built
exit: 0
stdout: = "box-linux}\n"
