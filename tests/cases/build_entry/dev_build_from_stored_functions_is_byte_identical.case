# Port of build_entry.rs:857-897. A dev build keeps no out-of-tree blob store
# (JET_STORE_DIR is retired), so the rebuild after the image is removed must
# reproduce it byte for byte from the same sources.
fixture: fixtures/function-cache
env: NO_COLOR=1
step: jet build main.jet
copy: .jet/build/main first-image
remove: .jet/build/main
step: jet build main.jet
file: .jet/build/main == first-image
step: built
stdout: = function-cache.out
