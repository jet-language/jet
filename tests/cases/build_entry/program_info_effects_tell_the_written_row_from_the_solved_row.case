# #3520 c12: a FunctionInfo's EffectInfo tells the row its signature writes
# (`declared`, None when it writes none) from the row the checker solved from
# its body (`inferred`), with no string parsing. fn build reports one code per
# fact it sees.
fixture: fixtures/program_info_effects_tell_the_written_row_from_the_solved_row
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet --json
exit: 0
json: machine doc $.ok = true
step: jet build --allow=Net main.jet --json
exit: nonzero # fn build reports what it saw as build errors
json: machine doc $.reports[?code="DECLARED"] #>= 1 # fetch writes -[Net]>
json: machine doc $.reports[?code="SOLVED"] #>= 1 # after the check every row is solved
json: machine doc $.reports[?code="UNWRITTEN"] #>= 1 # relay writes no row
json: machine doc $.reports[?code="INFERRED"] #>= 1 # relay's solved row holds fetch's Net
json: machine doc $.reports[?code="PURE"] #>= 1 # add solves to an empty row
