# A step reads whole folders: `b.folder("data")` in its own package and
# `b.dependency("words").folder("lines")` in one package.jet lists, each
# bound read-only at its path in the step's sandbox. Every build runs the
# step again, so adding or editing a file in them shows in its output.
fixture: fixtures/run_steps_read_a_folder
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/lines.txt = "a\nb\none\n" # each file of both folders, in order
file: app/.jet/build/receipt.json ~ "\"cache_hit\":false" # the first run of the step ran it
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/.jet/build/receipt.json ~ "\"cache_hit\":false" # nothing changed, and the build ran the step again
write: app/data/c.txt = "c\n"
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/lines.txt = "a\nb\nc\none\n" # a file added to the folder runs the step again
write: words/lines/one.txt = "uno\n"
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/lines.txt = "a\nb\nc\nuno\n" # and so does an edit in the dependency's folder
