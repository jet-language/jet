# A step's effects decide whether it is reused. `mirror` declares only Exec and
# FS, which the sandbox confines to its declared inputs and tool, so an
# unchanged rebuild restores it and a changed input runs it again. `stamp`
# also declares Time, which is ambient, so it runs on every build. `sneak`
# reads a file it never declares: the sandbox hides it, so the step fails on
# every build instead of reusing a result the file could have changed.
fixture: fixtures/run_steps_reuse_follows_their_effects
artifact: app
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
step: jet build main.jet --allow=Exec,FS,Time
env: JET_STORE_DIR={work}/store
exit: 0
file: mirror.txt = "one"
file: stamp.txt = "one"
file: .jet/build/receipt.json count "\"cache_hit\":false" = 2 # the first build ran both steps
step: jet build main.jet --allow=Exec,FS,Time
env: JET_STORE_DIR={work}/store
exit: 0
file: .jet/build/receipt.json ~ "\"cache_hits\":[{\"id\":0,\"name\":\"mirror\"" # the unchanged rebuild restored mirror
file: .jet/build/receipt.json count "\"cache_hit\":true" = 2 # mirror's row and its cache_hits entry, nothing else
file: .jet/build/receipt.json count "\"cache_hit\":false" = 1 # stamp ran again
write: in.txt = "two\n"
step: jet build main.jet --allow=Exec,FS,Time
env: JET_STORE_DIR={work}/store
exit: 0
file: mirror.txt = "two" # the changed input ran mirror again
file: stamp.txt = "two"
file: .jet/build/receipt.json count "\"cache_hit\":false" = 2 # neither step was reused
file: .jet/build/receipt.json ~ "\"cache_hits\":[]" # nothing came from the store
step: jet build sneak.jet --allow=Exec,FS
env: JET_STORE_DIR={work}/store
exit: nonzero
stderr: ~ "Build action `sneak` exited with status" # the undeclared read fails the step
step: jet build sneak.jet --allow=Exec,FS
env: JET_STORE_DIR={work}/store
exit: nonzero
stderr: ~ "Build action `sneak` exited with status" # and fails it again rather than reusing anything
