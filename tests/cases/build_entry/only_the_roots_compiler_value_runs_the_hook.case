# The hook fixture. `trace` is a library metaprogram whose handler
# prints "hooked" before each function marked `Trace.Traced`. It acts only
# through a `Compiler` value it is handed, so only a root that makes the value
# and hands it on runs it:
# - `none`: no value and no hook. The app prints "plain".
# - `imported`: the hook is imported and its marker written, but no value is
#   made. An import runs no compiler code, so the app prints "plain".
# - `root`: the root makes the value and hands it to the hook, and the app
#   prints "hooked" first. The plan records the handoff at the hook's line.
#   Once the root stops making the value, a rebuild in the same store prints
#   "plain": no stored artifact carries the hook into a build without it.
# - `forwarded`: the root forwards its `Build` to `grab`, a dependency whose
#   own source asks it for a value to give the hook. That is E0776 at grab's
#   line, and no app is built.
# - `denied`: the root hands the hook its value but denies `Meta.Rewrite`.
#   The denial reaches the rewrite inside the hook (E0749), and no app is built.
# - `header`: the root hands its value to `mint`, which adds a module whose
#   function calls `b.compiler`. Code a value made is not the root's own
#   source, so it can't make a value of its own: E0776, noted at mint's
#   `meta.add`, and no app is built.
# - `spawn`: the root hands its `Compiler` value to `launch`, whose helper
#   `start` starts a process that would run another compiler. Code handed
#   the value launches no process, so the check refuses `launch` (E3410)
#   with the call path to the launch: nothing is spawned and no app is built.
#   A declared step's process still runs
#   (a_build_holding_a_compiler_value_runs_its_process_steps.case).
# No step has a TTY, and none asks for one.
fixture: only_the_roots_compiler_value_runs_the_hook.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build none/main.jet
exit: 0
step: {work}/none/.jet/build/app
exit: 0
stdout: = "plain\n"
step: jet build imported/main.jet
exit: 0
step: {work}/imported/.jet/build/app
exit: 0
stdout: = "plain\n"
step: jet build root/main.jet
exit: 0
step: {work}/root/.jet/build/app
exit: 0
stdout: = "hooked\nplain\n"
step: jet inspect graph root/main.jet --json
exit: 0
json: stdout doc $.build.generated[0].made_by ~ "trace.jet:15" # the handoff to the hook is recorded at its rewrite
json: stdout doc $.build.generated[0].authority = "Meta.Rewrite"
copy: root/unhooked.txt root/main.jet
step: jet build root/main.jet
exit: 0
step: {work}/root/.jet/build/app
exit: 0
stdout: = "plain\n"
step: jet build forwarded/main.jet
exit: 1
stderr: ~ E0776 # the dependency's own call is refused
stderr: ~ grab.jet:6 # at the dependency's line
file: forwarded/.jet/build/app absent
step: jet build denied/main.jet
exit: 1
stderr: ~ E0749 # the root's denial reaches the rewrite inside the hook
stderr: ~ "reaches the `Meta.Rewrite` effect, which the package denies with `authority: { deny: [Meta.Rewrite] }`" # the report names the root's row
file: denied/.jet/build/app absent
step: jet build header/main.jet
exit: 1
stderr: ~ E0776 # generated code can't make a `Compiler` value
stderr: ~ "mint.jet:4 added this module through the root's `Compiler` value" # the note names the dependency's call that made it
file: header/.jet/build/app absent
step: jet build spawn/main.jet
exit: 1
stderr: ~ E3410 # code holding the Compiler value launches no process
stderr: ~ "`launch` takes the root's `Compiler` value and launches a process through launch → start → core.process.call" # the report names the hook and its call path
file: spawned.txt absent
file: spawn/spawned.txt absent
file: spawn/.jet/build/app absent
