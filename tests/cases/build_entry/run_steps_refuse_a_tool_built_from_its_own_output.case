# A step whose `b.host` tool compiles from that step's own output is a cycle,
# refused before anything runs.
fixture: fixtures/run_steps_refuse_a_tool_built_from_its_own_output
artifact: gen
requires: tool:bwrap
env: NO_COLOR=1
step: jet build main.jet --allow=Exec,FS
exit: 1
stderr: ~ "E3502" # the plan refusal
stderr: ~ "step `again`, target `gen`" # names both ends of the cycle
file: gen.jet absent # nothing ran
