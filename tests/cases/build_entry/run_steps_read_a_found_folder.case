# A find_folder probe chooses the first folder holding the file it names,
# looking in each LIBRARY_PATH entry, then the usual library folders.
# `b.found(probe)` is that folder, which a step reads whole at
# `.jet/found/<probe>`, and the step's key covers every file in it.
fixture: fixtures/run_steps_read_a_found_folder
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
env: LIBRARY_PATH={work}/none:{work}/libs
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/marker.txt = "found\n" # copied out of libs/, past the missing none/
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/.jet/build/receipt.json ~ "\"cache_hit\":true" # nothing changed, so the store gave the step back
write: libs/jet-case-marker.txt = "changed\n"
step: jet build app/main.jet --allow=Exec,FS
exit: 0
file: app/marker.txt = "changed\n" # an edit in the found folder runs the step again
