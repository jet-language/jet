# A step whose output would overwrite a file no build made, such as a
# committed one, is refused before anything runs; the file stays as written.
fixture: fixtures/run_steps_refuse_to_overwrite_a_file
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
step: jet build main.jet --allow=Exec,FS
exit: 1
stderr: ~ "E3502" # the plan refusal
stderr: ~ "Step `notes` would overwrite `notes.txt`, a file no build made" # names the step and the file
file: notes.txt = "written by hand\n"
