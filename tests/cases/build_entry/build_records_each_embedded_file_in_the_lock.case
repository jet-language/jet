# (D-EMBED-TOOLCHAIN1=A, spec.md "Every embedded or matched file records its SHA-256 in
# `.jet/lock`"): `jet build` records a `[[comptime_inputs]]` row, package-relative path and SHA-256, for
# each file the compile read through `embed_file` or `find`; editing the file replaces its row's digest.
fixture: fixtures/build_records_each_embedded_file_in_the_lock
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
step: jet build main.jet
exit: 0
file: .jet/lock ~ "[[comptime_inputs]]\npath = \"assets/one.txt\"\nhash = \"sha256:2c8b08da5ce60398e1f19af0e5dccc744df274b826abe585eaba68c525434806\"\n" # the find match's row
file: .jet/lock ~ "[[comptime_inputs]]\npath = \"data.txt\"\nhash = \"sha256:b6a98d9ce9a2d9149288fa3df42d377c3e42737afdcdaf714e33c0a100b51060\"\n" # sha256("alpha\n")
step: {work}/.jet/build/main
stdout: = "alpha assets/one.txt\n"
write: data.txt = "beta\n"
step: jet build main.jet
exit: 0
file: .jet/lock ~ "[[comptime_inputs]]\npath = \"data.txt\"\nhash = \"sha256:f2c82decdd7181cf98945929a62598db7e6b477e11f6e0eb0ae97020eff151ad\"\n" # sha256("beta\n"), the edited file's new digest
file: .jet/lock !~ "b6a98d9ce9a2d9149288fa3df42d377c3e42737afdcdaf714e33c0a100b51060" # the old digest's row is replaced, not kept
step: {work}/.jet/build/main
stdout: = "beta assets/one.txt\n"
