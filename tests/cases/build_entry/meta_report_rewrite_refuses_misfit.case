# #6516 c3: `syntax.rewrite` refuses a replacement whose parameter or return
# types don't fit the callee's: `count(n: Int) -> Int` can't take a
# `print(text)` call's place, so the build fails before any finding.
fixture: fixtures/meta_report_rewrite
step: jet build refused.jet
exit: nonzero
stderr: ~ "E1135" # the refused rewrite
stderr: ~ "can't call `count` where `print` was called" # it names both functions
stderr: ~ "its argument 1 is `Int` and the call passes `String`" # and the first misfit
stderr: !~ "mypkg.NoPrintInLib" # no finding is raised with a refused fix
