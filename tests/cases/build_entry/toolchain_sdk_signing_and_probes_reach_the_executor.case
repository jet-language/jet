# #3590 c71: a `fn build` toolchain carries its host and target triples, SDK,
# linker and sysroot; a signing identity and typed probes (find_program,
# pkg_config, compile_check) attach to an action. All of them enter the action
# key, and the production executor resolves each probe against the probe's
# toolchain before the action may run. A cross toolchain that declares no
# tools never borrows the host PATH, and a failed probe stops the build with
# E3505 before its action runs.
fixture: fixtures/toolchain_sdk_signing_and_probes_reach_the_executor
artifact: app
requires: tool:sh
requires: tool:bwrap
env: NO_COLOR=1
step: jet build main.jet --allow=Exec,FS
exit: 0
file: stamp.txt = "stamped"
step: jet inspect graph main.jet --json
exit: 0
stdout: ~ "\"toolchains\":[{\"name\":\"host\",\"target\":\"host\"},{\"name\":\"native\",\"target\":\"x86_64-unknown-linux-gnu\"}]" # the declared toolchain is in the plan
stdout: ~ "\"key\":\"act-sha256:f866fef8421f9a77b00b3c73f00c303204d7837ab8f0508e8ca221f2cbecac56\"" # pinned key of sdk-14.2 + developer-id:ACME
step: jet inspect graph main.jet --json
cwd: relabel
exit: 0
stdout: ~ "\"key\":\"act-sha256:3a89bdecc3cf04bba1d91beb2556a291d326c71f3e0dbbe73d3e9007d9e2f712\"" # a new SDK and signing label give a new key
step: jet build main.jet --allow=Exec,FS
cwd: cross
exit: nonzero
stderr: ~ "Build probe `shell` failed: program `sh` not found" # an aarch64 target on an x86_64 host gets no ambient PATH
file: cross/never.txt absent
step: jet build main.jet --allow=Exec,FS
cwd: missing
exit: nonzero
stderr: ~ "Build probe `missing` failed" # pkg_config probe runs before the action
file: missing/never.txt absent
step: jet build main.jet --allow=Exec,FS
cwd: compile
exit: nonzero
stderr: ~ "Build probe `broken` failed" # compile_check probe runs before the action
file: compile/never.txt absent
