# #3526 (D-META-LADDER1): only the root package's own build source makes the
# `Compiler` value. The `app` root makes it for its target and builds. The
# `forwarded` root hands its `Build` to the `tool` dependency, whose
# `b.compiler` call is E0776 at the dependency's own line: a forwarded `Build`
# carries no compiler control.
fixture: compiler_value_is_made_only_by_the_root_build.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build app/main.jet
exit: 0
step: jet build forwarded/main.jet
exit: 1
stderr: ~ E0776 # the dependency's call is refused
stderr: ~ tool.jet:4 # at the dependency's own line
