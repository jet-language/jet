// A library with a metaprogram and an ordinary function. Only a root that
// hands `install` its `Compiler` value runs the metaprogram.
install: fn(meta: Compiler) {
    meta.add(#code {
        greeting: fn() -> String { "added by the tool" }
    }, scope: "greeting")
}

hello: fn() -> String {
    "hello from the tool"
}
