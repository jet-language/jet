// The build makes `Shape` from `Source`'s reflected fields: it drops
// `secret`, renames `count` to `total`, and keeps each field's type as the
// reflection spells it. `meta.add_struct` declares the struct from that list.
Source: struct {
    flag: U8
    id: I64
    secret: String
    count: I32
}

build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    source: Source.reflect()
    fields := [CompilerField]{}
    loop field in source.fields {
        if field.name == "secret" -> next
        name: if field.name == "count" -> "total" else -> field.name.copy()
        fields.push(CompilerField{name: name, type: field.type.copy()})
    }
    meta.add_struct("Shape", fields, scope: "shape")
    b.default(app)
}

SHAPE_ID: #run Shape.reflect().identity
SHAPE_SIZE: #run { Shape.reflect().layout.size ?? -1 }
SHAPE_ALIGNMENT: #run { Shape.reflect().layout.alignment ?? -1 }
AT_FLAG: #run { Shape.reflect().layout.fields[0].offset ?? -1 }
AT_ID: #run { Shape.reflect().layout.fields[1].offset ?? -1 }
AT_TOTAL: #run { Shape.reflect().layout.fields[2].offset ?? -1 }

run: fn() {
    shape: Shape{flag: U8{1}, id: I64{40}, total: I32{2}}
    print("{SHAPE_ID}: size {SHAPE_SIZE}, alignment {SHAPE_ALIGNMENT}, flag at {AT_FLAG}, id at {AT_ID}, total at {AT_TOTAL}")
    print(shape.id + I64{shape.total})
}
