// Written fields under a row that denies `Meta.Types`: declaring a type is
// what the row refuses.
build: fn(b: Build) -[!Meta.Types]> {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    fields: [CompilerField]{CompilerField{name: "id", type: "I64"}, CompilerField{name: "total", type: "I32"}}
    meta.add_struct("Shape", fields, scope: "shape")
    b.default(app)
}

run: fn() {
    print(Shape{id: I64{40}, total: I32{2}}.id)
}
