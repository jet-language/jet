# A library target's listed sources are checked together. `parts`
# lists helper.jet beside parts.jet, and parts.jet calls `helper_value`, which
# only helper.jet declares, so the build of `app`, which depends on `parts`,
# checks `parts` clean.
fixture: fixtures/library_listed_second_source_is_checked
artifact: app
env: NO_COLOR=1
step: jet build main.jet
exit: 0
stderr: empty
step: {work}/.jet/build/app
exit: 0
stdout: = "built\n"
