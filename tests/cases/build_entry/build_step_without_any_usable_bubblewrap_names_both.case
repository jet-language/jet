# A build step runs only in the native sandbox, whose Bubblewrap is the `bwrap`
# on PATH, else Jet's hash-pinned copy in the Hangar (installed from beside jet,
# or fetched on first need). With neither usable (PATH holds only `sh` for the
# fixture's probe, the Hangar is empty, no copy is beside the kit's jet, and
# the fetch is refused) the build is refused before any step runs, and E3505
# names both and the fetch.
fixture: fixtures/declared_step_runs_with_only_its_declared_files
requires: os-name:linux
requires: arch:x86_64
mkdir: {tmp}/no-bwrap
symlink: /bin/sh {tmp}/no-bwrap/sh
env: NO_COLOR=1
env: PATH={tmp}/no-bwrap
env: JETPACK_DENY_NETWORK=1
env: JET_BWRAP_URL=https://example.invalid/jet-bwrap-x86_64-linux
step: jet build main.jet --allow=Exec,FS
exit: nonzero
stderr: = build-step-without-any-usable-bubblewrap.stderr
