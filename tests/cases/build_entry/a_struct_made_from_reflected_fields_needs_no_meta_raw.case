# #3526 c13: types from values. `meta.add_struct(name, fields, scope:)`
# declares a struct from a list of `CompilerField{name:, type:}` records,
# whose names and types a build may compute. The `typed` build reads
# `Source`'s reflected fields, drops one, renames one and keeps each type as
# reflection spells it. The build host checks every name and type, so no
# code a build computes is written: it uses `Meta.Generate` and `Meta.Types`
# but not `Meta.Raw`. None, basic and full optimization give the same
# identity, size, alignment and offsets, and a second build gives them
# again. A row that denies `Meta.Raw` still builds it; one that denies
# `Meta.Types` refuses it. Beside it, the same `Shape` joined into source
# text under the `Meta.Raw` denial is refused. A computed name that is not
# one identifier, and a computed type that is not exactly one type (a
# default, or a second field), are refused when the build runs.
fixture: a_struct_made_from_reflected_fields_needs_no_meta_raw.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet build --optimize=none typed/main.jet --write-generated=on
exit: 0
file: typed/.jet/generated/main/shape.jet ~ "Shape: struct {" # the declared struct is the generated module
file: typed/.jet/generated/main/shape.jet ~ "    total: I32\n" # the renamed field keeps its reflected type
step: {work}/typed/.jet/build/app
exit: 0
stdout: = a_struct_made_from_reflected_fields_needs_no_meta_raw.out
step: jet build --optimize=basic typed/main.jet
exit: 0
step: {work}/typed/.jet/build/app
exit: 0
stdout: = a_struct_made_from_reflected_fields_needs_no_meta_raw.out
step: jet build --optimize=full typed/main.jet
exit: 0
step: {work}/typed/.jet/build/app
exit: 0
stdout: = a_struct_made_from_reflected_fields_needs_no_meta_raw.out
step: jet build --optimize=full typed/main.jet
exit: 0
step: {work}/typed/.jet/build/app
exit: 0
stdout: = a_struct_made_from_reflected_fields_needs_no_meta_raw.out
step: jet inspect graph typed/main.jet --json
exit: 0
json: stdout doc $.build.generated[0].authority = "Meta.Generate, Meta.Types"
step: jet build raw_denied/main.jet
exit: 0
step: {work}/raw_denied/.jet/build/app
exit: 0
stdout: = "42\n"
step: jet build types_denied/main.jet
exit: 1
stderr: ~ "reaches the `Meta.Types` effect, which it prohibits with `-[!Meta.Types]>`" # the row's denial wins over the typed factory
file: types_denied/.jet/build/app absent
step: jet build text/main.jet
exit: 1
stderr: ~ "reaches the `Meta.Raw` effect, which it prohibits with `-[!Meta.Raw]>`" # source text is unparsed code
file: text/.jet/build/app absent
step: jet build bad_name/main.jet
exit: 1
stderr: ~ "E0357" # the registered casing refusal
stderr: ~ "`meta.add_struct` was given the field name" # names the call that refused it
file: bad_name/.jet/build/app absent
step: jet build bad_type/main.jet
exit: 1
stderr: ~ "was given the type \"I64 = launch()\" for the field `field_1`, which is not one type's spelling" # a default is code, not a type
stderr: ~ "E3502" # the registered generated-source refusal
file: bad_type/.jet/build/app absent
step: jet build extra_field/main.jet
exit: 1
stderr: ~ "E3502" # the registered generated-source refusal
stderr: ~ "was given the type \"I64, extra: String\" for the field `field_1`, which is not one type's spelling" # a second field is not one type
file: extra_field/.jet/build/app absent
