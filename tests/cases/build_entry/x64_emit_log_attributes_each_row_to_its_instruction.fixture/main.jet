pick: fn(values: [Int], index: Int, flag: Bool) -> Int {
    if flag -> return values[index]
    values.len()
}

Span: struct { count: U8, start: Int }

widen: fn(word: U32, count: U32, span: Span) -> U32 {
    (word << count) + U32{span.count}
}

run: fn() {
    values: [Int]{3, 5, 7}
    print(pick(values, 1, true))
    print(pick(values, 2, false))
    print(widen(U32{1}, U32{3}, Span{count: U8{4}, start: 2}))
}
