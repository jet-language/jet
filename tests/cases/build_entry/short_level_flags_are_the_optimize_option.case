# `-O0`, `-O1` and `-O2` are the short forms of `--optimize=none`, `basic`
# and `full`: one option, so they share its layers, its duplicate check and
# its pins, in either argument order. A short flag over a profile or
# `build: fn` value says so in the long spelling, two levels that disagree
# are E2104, and one against a pin is E2113. `jet run` stays at `none` and
# `-O2` runs the same program at `full`.
fixture: fixtures/build_options
artifact: app
env: NO_COLOR=1
step: jet build -O1
cwd: set
exit: 0
stderr: ~ "note: --optimize=basic replaces b.optimize(.Full) at build.jet:3 for this run" # -O1 is --optimize=basic
step: jet build -O1 --optimize=full
cwd: set
exit: 2
stderr: ~ "Error [jet.InvalidCommandInput]: `--optimize=basic` and `--optimize=full` disagree" # the rest of the report is the registered E2104 row
step: jet build --optimize=full -O1
cwd: set
exit: 2
stderr: ~ "Error [jet.InvalidCommandInput]: `--optimize=full` and `--optimize=basic` disagree" # the other order
step: jet build -O2 --optimize=full
cwd: set
exit: 0 # two spellings of one level agree
step: jet run --profile=fast -O0 main.jet
cwd: set
exit: 0
stdout: = "build options: ok\n"
stderr: ~ "note: --optimize=none replaces optimize: full in profile `fast` of package.jet for this run" # -O0 over the profile value
step: jet run -O2 main.jet
cwd: set
exit: 0
stdout: = "build options: ok\n"
step: jet build -O2
cwd: pinned
exit: 0 # the pinned value itself
step: jet build -O0
cwd: pinned
exit: 2
stderr: ~ "Error [jet.PinnedBuildOption]: `optimize` is pinned to `full` at build.jet:3, so `--optimize=none` can't change it" # -O0 against the pin
