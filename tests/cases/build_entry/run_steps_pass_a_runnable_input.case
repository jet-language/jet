# A step's work tree receives each input it reads runnable where the input
# is: the shell step is passed the host copy of `gen` and runs it, and its
# output is the source `show` compiles.
fixture: fixtures/run_steps_pass_a_runnable_input
artifact: show
requires: tool:sh
requires: tool:bwrap
step: jet build main.jet --allow=Exec,FS
exit: 0
file: show.jet ~ "print" # gen ran from the step's work tree
step: built
stdout: = "42\n"
