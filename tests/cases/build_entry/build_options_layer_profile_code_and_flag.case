# D-SETTING-ORDER1: one build-option table, settable from a profile,
# from `build: fn` and from a flag, in that order; a flag that replaces a
# profile or `build: fn` value says so, and a flag against a pin is E2113.
fixture: fixtures/build_options
artifact: app
env: NO_COLOR=1
step: jet run --profile=fast main.jet
cwd: set
exit: 0
stdout: = "build options: ok\n"
stderr: empty
step: jet run --profile=fast -O0 main.jet
cwd: set
exit: 0
stdout: = "build options: ok\n"
stderr: ~ "note: -O0 replaces optimize: O2 in profile `fast` of package.jet for this run" # the replace note names the profile value
step: jet build
cwd: set
exit: 0
stderr: !~ "note:" # no flag replaces a written value
step: jet build -O1
cwd: set
exit: 0
stderr: ~ "note: -O1 replaces b.optimize(.O2) at build.jet:3 for this run" # the replace note names the fn build call
step: jet build -O2 -O0
cwd: set
exit: 2
stderr: ~ "Error [jet.InvalidCommandInput]: `-O2` and `-O0` disagree" # the rest of the report is the registered E2104 row
step: jet run --profile=nope main.jet
cwd: set
exit: 1
stderr: ~ "Error [jet.UnknownProfile]: `--profile=nope` is not a defined build profile." # the rest of the report is the registered E1219 row (DiagnosticRows.jet:10067)
step: jet build -O2
cwd: pinned
exit: 0
step: jet build -O0
cwd: pinned
exit: 2
stderr: = ../../cli/build_option_pinned_e2113.txt
