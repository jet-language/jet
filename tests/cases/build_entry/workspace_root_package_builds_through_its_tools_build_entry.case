# A workspace index that is also a package whose `build: fn(b: Build)` lives in
# tools/build.jet: a bare `jet build` builds the member, then the root package
# through that build entry. The build query reads the entry through the
# package's own run entry, never the index, so a checked workspace never stops
# on an internal compiler error (I2).
fixture: fixtures/workspace-root-tool-build
step: jet build
exit: 0
file: .jet/build/root_tool is-file
file: packages/leaf/.jet/build/run is-file
step: built
exit: 0
stdout: = "root tool\n"
