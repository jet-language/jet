# ProgramInfo.packages holds one PackageInfo per package (name,
# identity, version, modules), not one per module. The fixture package `pair`
# has two modules; fn build reports one code per fact it sees.
fixture: fixtures/program_info_groups_a_two_module_package_into_one_package_record
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet --json
exit: 0
json: machine doc $.ok = true
step: jet build main.jet --json
exit: nonzero # fn build reports what it saw as build errors
json: machine doc $.reports[?code="ONE"] #>= 1 # one PackageInfo for `pair`
json: machine doc $.reports[?code="SPLIT"] #= 0 # never one per module
json: machine doc $.reports[?code="VERSION"] #>= 1 # the manifest's version
json: machine doc $.reports[?code="MODULES"] #>= 1 # both modules
json: machine doc $.reports[?code="MEMBERS"] #>= 1 # every module's types and functions
json: machine doc $.reports[?code="HELPER"] #>= 1 # helper.jet's ModuleInfo
