# #6035 c17 (D-RELEASE-DEBUG1 A, D-RT-DEFECT-REPORT1 A): a release image
# keeps no location table, so its own fault report prints its build id and
# the frames' addresses; `jet crash < report` names them from the side
# debug file the build saved in `.jet/symbols`, and prints the report the
# dev build of the program prints.
fixture: fixtures/build_debug_info
env: NO_COLOR=1
step: jet build main.jet
cwd: open
exit: 0
step: sh -c 'cd "{work}/open" && .jet/build/main > /dev/null 2> dev.txt; exit 0'
exit: 0
file: open/dev.txt ~ "Stop [E3012]: Stack overflow in `depth`" # the dev image names the function itself
step: jet build --release main.jet
cwd: open
exit: 0
step: sh -c 'cd "{work}/open" && .jet/build/main > /dev/null 2> release.txt; exec "{jet}" crash < release.txt'
exit: 0
file: open/release.txt ~ "Stop [E3012]: Stack overflow in `??` at 0x" # the release image prints addresses
file: open/release.txt ~ "(names and lines: jet crash)" # and its build id
stdout: ~ "Stop [E3012]: Stack overflow in `depth`" # jet crash names the function
stdout: ~ "--> main.jet:1 in depth" # and its declaration
step: sh -c 'cd "{work}/open" && test "$(cat dev.txt)" = "$("{jet}" crash < release.txt)"'
exit: 0 # the named release report is the dev build's report
step: jet crash
stdin: crash_no_build.stdin
exit: 1
stderr: = ../../cli/crash_no_build_e2114.txt
step: jet crash
cwd: open
stdin: crash_unknown_build.stdin
exit: 1
stderr: = ../../cli/crash_no_symbols_e2115.txt
step: jet crash release.txt
cwd: open
exit: 2
stderr: ~ "`jet crash` takes no arguments, but got `release.txt`" # the report comes on stdin
