// The same type inside a list type: `[geo.Point]`.
use geo

Carrier: struct {
    at: [geo.Point]
}

build: fn(b: Build) {
    app: b.add_executable("app", ["main.jet"], [])
    meta: b.compiler(app)
    fields := [CompilerField]{}
    loop field in Carrier.reflect().fields -> fields.push(CompilerField{name: field.name.copy(), type: field.type.copy()})
    meta.add_struct("Pin", fields, scope: "pin")
    b.default(app)
}

run: fn() {
    pin: Pin{at: [geo.Point]{geo.Point{x: 9}}}
    print(pin.at[0].x)
}
