# Every `jet build` records the graph it ran in `.jet/build/receipt.json` and
# how long each step and target took in `.jet/build/times.json`, which
# `jet inspect build --times` shows. A second build reuses the step's stored
# output and says so; the step's `.jet` output, now on disk, stays `show`'s
# own program instead of joining the build entry's namespace.
fixture: fixtures/run_steps_run_a_host_tool
artifact: show
requires: tool:bwrap
step: jet inspect build main.jet --times
exit: 1
stderr: ~ "E2104" # nothing to show before the first build
stderr: ~ "`jet build` has recorded its times" # names what is missing
step: jet build main.jet --allow=Exec,FS
env: JET_STORE_DIR={work}/store
exit: 0
file: .jet/build/receipt.json ~ "\"name\":\"table\"" # the step is in the graph the build ran
file: .jet/build/receipt.json ~ "\"cache_hit\":false" # the first run of the step ran it
file: .jet/build/receipt.json ~ "\"nodes\":[" # the compiler's own nodes are in it too
file: .jet/build/times.json ~ "{\"name\":\"gen\",\"kind\":\"host\",\"wall_ms\":" # the host tool's time
file: .jet/build/times.json ~ "{\"name\":\"table\",\"kind\":\"step\",\"wall_ms\":" # the step's time
file: .jet/build/times.json ~ "{\"name\":\"show\",\"kind\":\"image\",\"wall_ms\":" # the target's time
file: .jet/build/times.json !~ "\"reused\":true" # the first build made everything
step: jet inspect build main.jet --times
exit: 0
stdout: ^= "kind\tname\twall_ms\tresult\nhost\tgen\t" # the header, then the rows in the order they finished
stdout: ~ "\nstep\ttable\t" # the step's row
stdout: ~ "\nimage\tshow\t" # the target's row
stdout: ~ "\tmade\n" # each was made, not reused
stdout: !~ "\treused\n" # nothing was reused
step: jet build main.jet --allow=Exec,FS
env: JET_STORE_DIR={work}/store
exit: 0
file: .jet/build/receipt.json ~ "\"cache_hit\":true" # the second run of the step came from the store
step: jet inspect build main.jet --times --json
exit: 0
stdout: ~ "\"times\":{\"rows\":[" # the record itself under --json
stdout: ~ "\"kind\":\"step\"" # the step's row
stdout: ~ "\"reused\":true" # the step's outputs were reused
step: built
stdout: = "42\n"
