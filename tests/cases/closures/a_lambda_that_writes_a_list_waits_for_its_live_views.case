# A call of a lambda that writes a captured list changes that list, so it is
# refused while a view of the list is still read after the call: a push
# through the capture may move the list's storage under the view. A lambda
# that only reads the list may run beside the view, and a lambda that pushes
# may run once the view's last use is over.
fixture: a_lambda_that_writes_a_list_waits_for_its_live_views.fixture
env: NO_COLOR=1
step check: jet check accepted.jet
exit: 0
step o0: jet run --optimize=none accepted.jet
exit: 0
stdout: = "4|7\n"
step o1: jet run --optimize=basic accepted.jet
exit: 0
stdout: = "4|7\n"
step o2: jet run --optimize=full accepted.jet
exit: 0
stdout: = "4|7\n"
step refused: jet check refused.jet
exit: 1
stderr: ~ "jet.OwnerMovedWhileViewed" # the writing call is refused (E0212)
stderr: ~ "refused.jet:9:5" # at the call of `add`
stderr: ~ "cannot be changed by calling `add` while `window` is still looking into it" # naming the call and the live view
step refused_run: jet run --optimize=none refused.jet
exit: 1
stderr: ~ "jet.OwnerMovedWhileViewed" # the run stops at the same check
