# A lambda parameter that only a lambda two levels down reads is captured by
# the lambda between them, so the innermost lambda's capture finds it on every
# tier instead of failing the build with "capture of unknown local".
fixture: a_lambda_parameter_read_two_lambdas_down_is_captured_by_the_lambda_between.fixture
env: NO_COLOR=1
step check: jet check nested.jet
exit: 0
step o0: jet run -O0 nested.jet
exit: 0
stdout: = "ax1,ax2,ay1,ay2,bx1,bx2,by1,by2\np11,q11,p12,q12\na-1,a-2,b-1,b-2\nm/capsule/t1,m/capsule/t2,m/control/t1,m/control/t2\n"
step o1: jet run -O1 nested.jet
exit: 0
stdout: = "ax1,ax2,ay1,ay2,bx1,bx2,by1,by2\np11,q11,p12,q12\na-1,a-2,b-1,b-2\nm/capsule/t1,m/capsule/t2,m/control/t1,m/control/t2\n"
step o2: jet run -O2 nested.jet
exit: 0
stdout: = "ax1,ax2,ay1,ay2,bx1,bx2,by1,by2\np11,q11,p12,q12\na-1,a-2,b-1,b-2\nm/capsule/t1,m/capsule/t2,m/control/t1,m/control/t2\n"
