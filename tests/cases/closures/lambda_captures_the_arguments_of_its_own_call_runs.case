# A call may pass read parameters as arguments and also capture them in a
# lambda it passes: `with_lock<Bool>(repo, entry.name, () -> write_locked(repo,
# entry))` needs no copies first, on every tier.
fixture: lambda_captures_the_arguments_of_its_own_call_runs.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = "written\n"
step o2: jet run --optimize=full main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = "written\n"
