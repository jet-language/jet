
run: fn() {
    nums := [1, 2, 3, 4, 5]
    print(nums.take(3).to_list())
    print(nums.skip(2).to_list())
    print(nums.step_by(2).to_list())
    print(nums.dedup().to_list())
    print(nums.take_while(fn(n: Int) { (n < 4) }).to_list())
    print(nums.skip_while(fn(n: Int) { (n < 4) }).to_list())
    sum := nums.fold(0, fn(acc: Int, n: Int) { (acc + n) })
    print(sum)
    pos := nums.position(fn(n: Int) { (n == 3) })
    print(pos)
    words := ["b", "a", "c"]
    print(words.min_by(fn(w: String) { w.len() }))
    print(words.max_by(fn(w: String) { w.len() }))
    nested := [[1, 2], [3, 4]]
    print(nested.flatten())
    print(nested.lazy().flatten().to_list())
    print(nested.flat_map(fn(xs: [Int]) { xs }))
    print(nested.lazy().flat_map(fn(xs: [Int]) { xs }).to_list())
}
