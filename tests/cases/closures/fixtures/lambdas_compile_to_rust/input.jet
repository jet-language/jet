
apply: fn(f: fn(Int) -> Int, x: Int) -> Int {
    return f(f(x))
}

run: fn() {
    nums: [1, 2, 3]
    print(nums.map(fn(n: Int) { n * n }).len())
    total := 0
    nums.each(fn(n: Int) { total += n })
    print(total)
    print(apply(fn(x: Int) { x + 1 }, 5))
    print(nums.filter(fn(n: Int) { n > 1 }).len())
    print(nums.any(fn(n: Int) { n == 2 }))
    print(nums.reduce(0, fn(acc: Int, n: Int) { acc + n }))
}
