package: { name: "field_lambda", authority: { allow: [FS, IO] } }
use files: core.files

Source: struct {
    size: fn(String) -[FS.Read]> Int IOError!
}

// The stored lambda's body is a match on a Result whose arms build the
// lambda's own Result.
make_source: fn() -> Source Never! {
    Source{size: fn(path: String) {
        if files.read(path) == {
            .Ok(text) -> Ok(text.len())
            .Err(error) -> Err(error)
        }
    }}
}

run: fn() {
    source: make_source()
    print(source.size("data.txt") ?? -1)
    print(source.size("missing.txt") ?? -1)
}
