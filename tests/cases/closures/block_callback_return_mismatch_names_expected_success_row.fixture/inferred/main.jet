
source_flag: fn(value: Int) -> Bool {
    if value == 0 {
        return Err("source failed")
    }
    return value > 1
}

retain_flag: fn(value: Bool) -> Bool { value }

run: fn() {
    kept: [1, 2, 3].filter(fn(value: Int) {
        if value == 2 {
            return retain_flag(source_flag(value))
        }
        if value == 3 {
            return "kept"
        }
        retain_flag(source_flag(value))
    }) ?? []
    print(kept.len())
}
