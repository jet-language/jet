// D-SIMD3: a 128-bit float lane operator is the scalar operator on each lane,
// and every reduction is the scalar left-to-right fold.
fold_f32: fn(values: [F32#4]) -> F32 {
    total := F32{0.0}
    loop value in values -> total = total + value
    return total
}

run: fn() {
    // (1e8 + 1) rounds back to 1e8 in F32, so only the left fold ends at 1.
    big: F32x4(100000000.0, 1.0, -100000000.0, 1.0)
    print(big.sum())
    print(big.sum() == fold_f32(big.to_array()))
    v: F32x4(1.0, 2.0, 3.0, 4.0)
    w: F32x4(0.5, 0.25, 2.0, 8.0)
    print((v - w).to_array())
    print((v / w).to_array())
    print(v.product())
    print(w.min())
    print(w.max())
    print(v.reduce(.Avg))
    print(v[3])
    // 0.1 + 0.2 is the double 0.30000000000000004, not the double nearest 0.3.
    d: F64x2(0.1, 0.2)
    print(d.sum() == d[0] + d[1])
    print(d.sum() == F64x2.splat(0.3)[0])
    print((d * F64x2.splat(10.0)).to_array())
    print(d.reduce(.Max))
}
