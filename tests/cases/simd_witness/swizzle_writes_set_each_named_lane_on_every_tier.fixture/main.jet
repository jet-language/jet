Body: struct {
    pos: Vec3
}

run: fn() {
    b := Body{pos: Vec3(1.0, 2.0, 3.0)}
    b.pos.zx = Vec2(7.0, 8.0)
    print(b.pos.to_array())
    v := Vec4(1.0, 2.0, 3.0, 4.0)
    v.wy += Vec2(10.0, 20.0)
    print(v.to_array())
    v.x = 0.5
    print(v.xyz.to_array())
    f := F32x4(1.0, 2.0, 3.0, 4.0)
    f.zw = Vec2(0.25, 0.75)
    print(f.to_array())
    g: f.xyzw
    f.wzyx = g
    print(f.to_array())
    d := F64x2(5.0, 6.0)
    d.y = 9.5
    print(d.yx.to_array())
}
