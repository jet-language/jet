// D-SIMD3: a 256-bit integer lane operator is the scalar operator on each
// lane, and every reduction is the scalar left-to-right fold.
run: fn() {
    ramp: I32x8(1, 2, 3, 4, 5, 6, 7, 8)
    print((ramp - I32x8.splat(4)).to_array())
    print(ramp.product())
    print(ramp.reduce(.Avg))
    print(ramp[7])
    bytes: U8x32.splat(7)
    print(bytes.sum())
    print(bytes.reduce(.Max))
    // 32 lanes of -4 fold to exactly I8's least value.
    print(I8x32.splat(-4).sum())
    print(I16x16.splat(100).sum())
    print(U16x16.splat(3).reduce(.Min))
    print(U32x8(8, 7, 6, 5, 4, 3, 2, 1).min())
    print(I64x4(-5, 10, -15, 20).sum())
    print((U64x4(1, 2, 3, 4) * U64x4.splat(1000000000000)).to_array())
}
