# F32x8 and F64x4 lane operators act lane by lane and every
# reduction is the scalar left-to-right fold, so each tier prints the scalar
# spelling's values.
fixture: float_256_lanes_match_the_scalar_spelling_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = float_256_lanes_match_the_scalar_spelling_on_every_tier.1.out
stderr: = ""
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = float_256_lanes_match_the_scalar_spelling_on_every_tier.1.out
stderr: = ""
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = float_256_lanes_match_the_scalar_spelling_on_every_tier.1.out
stderr: = ""
