# #6565 c2: a pipe lowers each step to a hidden binding before type checking,
# so `port` written as a pipe (piped/) and as hand-named bindings (named/)
# compile to the same slot IR. Only the binding names differ (the pipe's are
# hidden, `__jet_pipe_<offset of its |>>`), so the named form's names are
# rewritten to them before each comparison.
# O0 compiles the `jet emit --ir` slots unchanged. They match through the final
# `return`. After it, the hand-named body drops `text` and `number` again
# where no path reaches (its function scope ends after the tail value),
# while the pipe's frame closed before the return.
# O1 (default) and O2 (--release) are the function after the passes, as
# `jet inspect decisions` prints it: identical.
fixture: a_pipe_compiles_to_its_hand_named_form_on_every_tier.fixture
env: NO_COLOR=1
step: jet emit --ir piped/main.jet --fn port
exit: 0
stdout: ~ "local __jet_pipe_112: String" # the first step's value, bound under its hidden name
stdout: ~ "local __jet_pipe_163: Int" # the second step's value
stdout: !~ "local raw" # the head is a name, so the first step reads it in place
stdout: ~ "  132: unreachable" # the pipe's frame dropped its values before the return
capture: piped_o0 = text stdout.cut("  132: ")
step: jet emit --ir named/main.jet --fn port
exit: 0
stdout: ~ "  132: drop 57" # the unreachable second drop of `number`
capture: named_o0 = text stdout.cut("  132: ").replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
cap:named_o0: = "{cap:piped_o0}"
step: jet inspect decisions piped/main.jet
env: JET_OPT_DUMP=port
exit: 0
stdout: ~ "O1:" # the default build runs the O1 passes
capture: piped_o1 = text stdout.after_first("\nafter fn port")
step: jet inspect decisions named/main.jet
env: JET_OPT_DUMP=port
exit: 0
capture: named_o1 = text stdout.after_first("\nafter fn port").replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
cap:named_o1: = "{cap:piped_o1}"
step: jet inspect decisions --release piped/main.jet
env: JET_OPT_DUMP=port
exit: 0
stdout: ~ "O2:" # --release runs the O2 passes
capture: piped_o2 = text stdout.after_first("\nafter fn port")
step: jet inspect decisions --release named/main.jet
env: JET_OPT_DUMP=port
exit: 0
capture: named_o2 = text stdout.after_first("\nafter fn port").replace("local text:", "local __jet_pipe_112:").replace("local number:", "local __jet_pipe_163:")
cap:named_o2: = "{cap:piped_o2}"
step: jet run --optimize=none piped/main.jet
exit: 0
stdout: = "8080\n"
step: jet run --optimize=basic piped/main.jet
exit: 0
stdout: = "8080\n"
step: jet run --optimize=full piped/main.jet
exit: 0
stdout: = "8080\n"
