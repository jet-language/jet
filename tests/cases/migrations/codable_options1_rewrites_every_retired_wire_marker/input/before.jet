// `#Encode` alone derives one direction.
#Encode
Receipt: struct {
    total: Int
    #Skip cache: Int
    #[Flatten]
    meta: Meta
}

#[Debug, Decode]
Meta: struct {
    tag: String
}

#[Encode, Decode, Rename(.Camel)]
Both: struct { value: Int }

#[Codable, DenyUnknownFields]
Strict: struct { value: Int }

#PublishedSchema
#Codable
Account: struct { id: Int }

#[PublishedSchema, Codable, Rename(.Camel)]
Profile: struct { name: String }

#[Codable, Discriminant("type")]
Shape: enum { Circle(radius: Int), Dot }

#Untagged
Value: enum { Number(Int), Text(String) }

#!Encode
Secret: struct { bytes: [U8] }

#[Comparable, Printable, CodableAsBase]
TaskID: distinct Int

#CodableAsBase
UserID: distinct String

#Codable(only: .Encode)
Kept: struct { value: Int }

#Test("a marker in a string keeps its quotes and its line escapes")
quoted: fn() {
    source: "#[Codable, Discriminant(\"kind\")]\nShape: enum \{ A, B \}\n#CodableAsBase\nID: distinct Int\n#PublishedSchema\n#Codable\nRow: struct \{ id: ID \}"
    print(source)
}

#Discriminant
Broken: enum { A, B }
