// Written before toolchain a0.0.45, when a lambda was spelled with an arrow.
Point: struct {
    x: Int
    y: Int
}

Handlers: struct {
    on_point: fn(Point) -> Int
}

Rank: struct {
    value: Int
}

#PublishedSchema Score: struct {
    rank: Rank
}

migration Score {
    change rank: Int -> Rank via { fn(n) { Rank{ value: n } } }
}

total: fn(points: [Point], pick: fn(Point) -> Int) -> Int {
    sum := 0
    loop point in points -> sum += pick(point)
    sum
}

run: fn() {
    points: [Point]{{x: 1, y: 2}, {x: 3, y: 4}}
    print(total(points, fn(p) { p.x }))
    print(total(points, fn(p) { p.x + p.y }))
    print(total(points, fn(point: Point) {
        doubled: point.y * 2
        doubled + 1
    }))
    scaled: points.map(fn(p) {
        p.x * 10
    })
    print(scaled)
    sorted := [3, 1, 2]
    sorted.sort_by(fn(left, right) { left <=> right })
    print(sorted)
    nested: points.map(fn(p) { [1, 2].map(fn(n) { n * p.x }) })
    print(nested)
    handlers: Handlers{on_point: fn(p) { p.y }}
    print(handlers.on_point(points[0]))
    print("{points.map(fn(p) { p.x })}")
    square := fn(n: Int) { n * n }
    print(square(3))
    notify: fn(p: Point) -[IO]> { print(p.x) }
    notify(points[1])
    adder := fn(n: Int) { fn(m: Int) { m + n } }
    add_one: adder(1)
    print(add_one(2))
    makers: [1].map(fn(n: Int) { fn(m: Int) { m + n } })
    print(makers[0](2))
    label: if points.len() == {
        0 -> "none"
        count -> "{count} points"
    }
    print(label)
    done := false
    if done -> print("never")
    source: "run: fn() {{\n    print([1].map(fn(n) {{ n + 1 }}))\n}}\n"
    print(source)
    hint: "write `.with(fn(value) {{ … }})` or `scope.guard(fn() {{ cleanup }})`, not `(Int) -> Int`"
    print(hint)
    shape: "(item, key) -> value"
    print(shape)
    c_check: "if (n->refs != before) ++failures;"
    print(c_check)
}
