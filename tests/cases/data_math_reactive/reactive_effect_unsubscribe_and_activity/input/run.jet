use core.reactive as reactive
fn run() {
    value := reactive.signal(1)
    subscription := reactive.effect(() -> {
        print(value.get())
    })
    print(subscription.is_active())
    value.set(2)
    subscription.unsubscribe()
    print(subscription.is_active())
    subscription.unsubscribe()
    value.set(3)
}
