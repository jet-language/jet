// A `defer` puts an entry with no name and no slot among the frame's
// bindings; a bounds stop after it lists only the program's locals.
tally: fn(xs: [Int], at: Int) -> Int {
    defer print("tally ends")
    total: xs.len() + at
    xs[at] + total
}

run: fn() { print("{tally([Int]{1, 2, 3}, 9)}") }
