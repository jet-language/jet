// A stop with at most three Int and Bool locals passes their words to the
// runtime in registers, not in a frame area; the report is the same.
walk: fn(xs: [Int]) -> Int {
    total := 0
    wrapped := false
    i := 0
    loop i < 3 {
        total += xs[i * 2]
        wrapped = i > 0
        i += 1
    }
    if wrapped -> total else -> 0
}

run: fn() { print("{walk([Int]{1, 2, 3})}") }
