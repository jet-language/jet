# tests/debug.rs::dap_cli_pauses_a_running_target_through_production_wire
# Original source and wire predicates; PENDING-GRAMMAR(batch-four), PENDING-SAME-HEAD; runtime UNRUN.
# Native compiler rustc availability guard retires at Jet backend cutover.
requires: tool:lldb
fixture: dap_cli_pauses_a_running_target_through_production_wire.fixture
env: NO_COLOR=1
session dap content-length: jet debug --dap {work}/main.jet
send dap: "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}"
send dap: "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"{work}/main.jet\",\"stopOnEntry\":false,\"args\":[],\"env\":{}}}"
send dap: "{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{}}"
send dap: "{\"seq\":4,\"type\":\"request\",\"command\":\"pause\",\"arguments\":{}}"
recv dap collect until ndjson $[?request_seq=4][?success=true][?command="pause"] #>= 1 && ndjson $[?event="stopped"][?reason="pause"] #>= 1 timeout 30s
json: stdout ndjson $[?request_seq=4][0].success = true
stdout: ~ "\"event\":\"stopped\"" # original paused transcript conjunction
stdout: ~ "\"reason\":\"pause\"" # original paused transcript conjunction
send dap: "{\"seq\":5,\"type\":\"request\",\"command\":\"threads\",\"arguments\":{}}"
recv dap until $.request_seq = 5 timeout 5s
stdout: ~ "\"request_seq\":5,\"success\":true,\"command\":\"threads\"" # original substring predicate
send dap: "{\"seq\":6,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{}}"
close dap timeout 10s
exit: 0
