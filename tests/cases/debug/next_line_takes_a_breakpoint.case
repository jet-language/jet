# #6585: on the native O0 image a loop `next` statement has a line row of
# its own. A breakpoint on the `next` line binds there instead of sliding to
# the following statement, stops when the edge is taken, and `n` from it goes
# to the next iteration.
requires: tool:lldb
fixture: next_line_takes_a_breakpoint.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: next_line_takes_a_breakpoint.stdin
exit: 0
stdout: ~ "breakpoint set  prog.jet:5" # the breakpoint binds on the next line itself
stdout: ~ "breakpoint hit  prog.jet:5  in run()\n5 |             next        <- here" # it stops on the next line
stdout: ~ "(jet) p i\ni = 1\n(jet) n\n4 |         if i == 1 {        <- here\nlocals:  hits = 0   i = 2" # only the iteration that takes the edge stops; n goes to the next iteration
stdout: ~ "(jet) p i\ni = 2\n(jet) c\n2\nprogram finished\n" # the edge is taken once; the program's own result is unchanged
stdout: !~ "prog.jet:7  in run()" # the breakpoint never slid to the following statement
