# #6576: the session's status comes from the native debugger, not from what
# the program prints. A program whose own output is `Program finished` shows
# that line and then the session's own completion marker, and the session
# exits 0.
requires: tool:lldb
fixture: structured_session_status_ignores_program_output.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: structured_session_status_ignores_program_output.stdin
exit: 0
stdout: ~ "(Jet) c\nProgram finished\nProgram finished\n" # the program's own line, then the session's completion marker
stdout: !~ ".rs:" # no generated Rust anywhere
