# #6576: `jet debug` builds the program's native O0 image and drives LLDB over
# its DWARF. A breakpoint on a Jet line stops there with the `<- here` caret,
# `print` reads a Jet local in Jet terms, the backtrace names only Jet frames,
# and the program runs on to its end. Without LLDB on PATH the session stops
# with E2203 before it builds anything.
requires: tool:lldb
fixture: native_breakpoint_reads_a_jet_local.fixture
env: NO_COLOR=1
step: jet debug prog.jet
stdin: native_breakpoint_reads_a_jet_local.stdin
exit: 0
stdout: ~ "breakpoint set  prog.jet:2" # `break 2` confirms the Jet line
stdout: ~ "breakpoint hit  prog.jet:2  in double()" # the stop names the Jet file, line and function
stdout: ~ "2 |     y: x * 2        <- here" # the stop shows the Jet source line with its caret
stdout: ~ "(jet) print x\nx = 0\n" # the first call's argument
stdout: ~ "#0  double()  at prog.jet:2\n#1  run()  at prog.jet:9\n" # Jet frames only
stdout: ~ "(jet) c\nbreakpoint hit  prog.jet:2  in double()" # the second call stops again
stdout: ~ "count 2\nprogram finished\n" # the program's own output, then the end of the session
stdout: !~ ".rs:" # no generated Rust anywhere
step: jet debug prog.jet
env: PATH={work}/no-tools
exit: 1
stdout: empty
stderr: = ../../cli/debug_lldb_missing_e2203.txt
