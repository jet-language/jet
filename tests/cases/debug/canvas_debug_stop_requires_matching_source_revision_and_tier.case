# tests/debug.rs::canvas_debug_stop_requires_matching_source_revision_and_tier
# Exact production WebHost Canvas requests/subclaims, original source unchanged.
# PENDING-SAME-HEAD, runtime UNRUN. Core.net client mirrors the existing raw HTTP fixture pattern.
fixture: canvas_debug_stop_requires_matching_source_revision_and_tier.fixture
env: NO_COLOR=1
step: jet build client/run.jet
exit: 0
copy: client/.jet/build/run canvas-client
spawn canvas: jet dev jet_debug_canvas_stop_binding.jet --canvas --canvas-port 0
env: JET_CANVAS_BROWSER=/definitely/missing/canvas-browser
stdout: file canvas.stdout
stderr: file canvas.stderr
await: file canvas.stderr ~ "Canvas: http" timeout 60s every 50ms # transport readiness bridge: Source/CmdDevTools.rs:777-783 emits the Canvas URL on configured browser launch failure; retain the ported 60s/50ms gate
capture: url = text file.after_first("Canvas: ").line(0) canvas.stderr
capture: revision = sha256 file jet_debug_canvas_stop_binding.jet
capture: original_source = text file jet_debug_canvas_stop_binding.jet
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.first.json
step first: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
capture: session = text stdout.after_first("\"id\":\"canvas-debug-").split("\"", 0).prepend("canvas-debug-")
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.wrong_tier.json
step wrong_tier: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"conflict\"" # original contains predicate
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.wrong_source.json
step wrong_source: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"conflict\"" # original contains predicate
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.next.json
step next: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.stale_stop.json
step stale_stop: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"conflict\"" # original contains predicate
write: request.json canvas_debug_stop_requires_matching_source_revision_and_tier.ended.json
step ended: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
stdout: ~ "\"state\":\"stopped\"" # original contains predicate
file: jet_debug_canvas_stop_binding.jet = "{cap:original_source}"
signal canvas: INT
wait: canvas
exit: any # original only asserts session/store/source predicates, not dev server shutdown status
