# tests/debug.rs::canvas_debug_session_replays_one_source_bound_session
# Exact production WebHost Canvas requests/subclaims, original source unchanged.
# PENDING-SAME-HEAD, runtime UNRUN. Core.net client mirrors the existing raw HTTP fixture pattern.
fixture: canvas_debug_session_replays_one_source_bound_session.fixture
env: NO_COLOR=1
step: jet build client/run.jet
exit: 0
copy: client/.jet/build/run canvas-client
spawn canvas: jet dev jet_debug_canvas_live_protocol.jet --canvas --canvas-port 0
env: JET_CANVAS_BROWSER=/definitely/missing/canvas-browser
stdout: file canvas.stdout
stderr: file canvas.stderr
await: file canvas.stderr ~ "Canvas: http" timeout 60s every 50ms # transport readiness bridge: Source/CmdDevTools.rs:777-783 emits the Canvas URL on configured browser launch failure; retain the ported 60s/50ms gate
capture: url = text file.after_first("Canvas: ").line(0) canvas.stderr
capture: revision = sha256 file jet_debug_canvas_live_protocol.jet
capture: original_source = text file jet_debug_canvas_live_protocol.jet
write: request.json canvas_debug_session_replays_one_source_bound_session.first.json
step first: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
stdout: ~ "\"state\":\"running\"" # original contains predicate
stdout: ~ "\"tier\":\"jet-dev-interpreter\"" # original contains predicate
stdout: ~ "\"revision\":\"sha256-{cap:revision}\"" # original contains predicate
stdout: ~ "run()" # original contains predicate
capture: session = text stdout.after_first("\"id\":\"canvas-debug-").split("\"", 0).prepend("canvas-debug-")
write: request.json canvas_debug_session_replays_one_source_bound_session.next.json
step next: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
stdout: ~ "\"state\":\"running\"" # original contains predicate
stdout: ~ "\"id\":\"{cap:session}\"" # original contains predicate
stdout: ~ "\"debug_overlay\":\"running\"" # original contains predicate
write: request.json canvas_debug_session_replays_one_source_bound_session.invalid_continue.json
step invalid_continue: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"unsupported\"" # original contains predicate
write: request.json canvas_debug_session_replays_one_source_bound_session.after_invalid.json
step after_invalid: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
stdout: ~ "\"id\":\"{cap:session}\"" # original contains predicate
stdout: ~ "\"state\":\"running\"" # original contains predicate
write: request.json canvas_debug_session_replays_one_source_bound_session.stop.json
step stop: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 200" # original success vs expect_err projection
stdout: ~ "\"state\":\"stopped\"" # original contains predicate
stdout: ~ "\"overlay\":null" # original contains predicate
file: jet_debug_canvas_live_protocol.jet = "{cap:original_source}"
write: request.json canvas_debug_session_replays_one_source_bound_session.invalid.json
step invalid: {work}/canvas-client
env: S1_CANVAS_URL={cap:url}
env: S1_METHOD=POST
env: S1_PATH=/__jet_canvas/debug
exit: 0
stdout: ^= "HTTP/1.1 409" # original success vs expect_err projection
stdout: ~ "\"kind\":\"unsupported\"" # original contains predicate
file: jet_debug_canvas_live_protocol.jet = "{cap:original_source}"
signal canvas: INT
wait: canvas
exit: any # original only asserts session/store/source predicates, not dev server shutdown status
