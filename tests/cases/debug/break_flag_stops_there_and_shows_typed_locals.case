# `jet debug --break file:line` runs the program to that line before the
# console reads a command; `locals` there lists each local with its Jet type,
# `s` steps into the call on the line, `f` finishes it and `n` steps over.
requires: tool:lldb
fixture: break_flag_stops_there_and_shows_typed_locals.fixture
env: NO_COLOR=1
step: jet debug prog.jet --break prog.jet:7
stdin: break_flag_stops_there_and_shows_typed_locals.stdin
exit: 0 # `c` runs the program to its end, and the session ends with it
stdout+stderr: ~ "Breakpoint set  prog.jet:7" # the --break line is placed
stdout+stderr: ~ "Breakpoint hit  prog.jet:7  in run()" # the program stops there before the first command
stdout+stderr: ~ "a: Int = 5" # `locals` in run gives the local's Jet type
stdout+stderr: ~ "2 |" # `s` steps into double
stdout+stderr: ~ "x: Int = 5" # `locals` in double gives its parameter's Jet type
stdout+stderr: ~ "8 |" # `f` returns to run's line and `n` steps over it
stdout+stderr: ~ "10" # the program's own print
stdout+stderr: ~ "Program finished" # `c` runs it to its end
stdout+stderr: !~ "Program started" # the run begins at the breakpoint, not with an entry stop
