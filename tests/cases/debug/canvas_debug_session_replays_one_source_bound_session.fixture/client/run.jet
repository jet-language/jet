// Real Core.net HTTP transport for production Canvas; no test assertions hidden here.
use {
    net: core.net
    files: core.files
    sys: core.sys
}
CRLF: "\r\n"
run: fn() {
    url: sys.get("S1_CANVAS_URL") ?? panic("URL")
    rest: (url.split_once("://") ?? panic("URL scheme")).after
    address: if rest.split_once("/") == {
        .Val(parts) -> parts.before
        .None -> rest
    }
    secret: (url.split_once("session=") ?? panic("URL session")).after
    method: sys.get("S1_METHOD") ?? "POST"
    target: sys.get("S1_PATH") ?? "/__jet_canvas/debug"
    body: if method == "POST" -> files.read("request.json") ?? panic("request") else -> ""
    stream := net.tcp_connect(address) ?? panic("connect")
    request: "{method} {target} HTTP/1.1{CRLF}Host: {address}{CRLF}Origin: http://{address}{CRLF}Authorization: Bearer {secret}{CRLF}Content-Type: application/json{CRLF}Content-Length: {body.bytes().len()}{CRLF}Connection: close{CRLF}{CRLF}{body}"
    stream.write_all(request.bytes()) ?? panic("write")
    bytes := [U8]{}
    loop {
        block: stream.read(4096, deadline: 5s) ?? panic("read")
        if block.is_empty() -> break
        loop byte in block -> bytes.push(byte)
    }
    response: String.from_bytes(bytes) ?? panic("response")
    print(response)
}
