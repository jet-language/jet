# At O2 `sum_squares` is inlined into `run`, so its code has no function of
# its own. The DWARF makes each inlined copy an inlined subroutine of an
# abstract `sum_squares`, with the call's file and line and the inlined
# locals inside it. LLDB stopped on a line of the inlined loop's body shows
# a `sum_squares` frame inlined into `run` above `run`'s own frame at the
# call, and reads the loop's live locals there. The body is on its own line:
# a loop's head code carries the loop's line, and at the head before the
# first pass the loop's variable is not bound yet.
requires: tool:lldb
fixture: lldb_shows_o2_inlined_frames_and_their_locals.fixture
env: NO_COLOR=1
step: jet build -O2 prog.jet
exit: 0
step: lldb --no-lldbinit --no-use-colors -b -o "breakpoint set -f prog.jet -l 6" -o run -o bt -o "frame variable" -o "process kill" {work}/.jet/build/prog
exit: any # only the frames and the locals are the subject
stdout+stderr: ~ "[inlined] sum_squares" # the stop is in the inlined copy, named as its function
stdout+stderr: ~ "at prog.jet:5" # on the loop body's line
stdout+stderr: ~ "run at prog.jet:11" # and the caller's frame is at the call
stdout+stderr: ~ "total = " # the inlined function's locals are in its frame
stdout+stderr: ~ "i = " # the loop's variable too
stdout+stderr: !~ "total = <" # with values, not "optimized out" or "not available"
stdout+stderr: !~ "i = <" # the same for the loop's variable
step: {work}/.jet/build/prog
exit: 0
stdout: = "332833500\n" # the image runs unchanged
