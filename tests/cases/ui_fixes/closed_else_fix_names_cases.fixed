Shade: enum {
    Red
    Green
    Blue
}

warm: fn(shade: Shade) -> Bool {
    if shade == {
        .Red -> true
        .Green | .Blue -> false
    }
}

rank: fn(shade: Shade) -> Int {
    if shade == {
        .Blue -> 3
        .Red | .Green -> 1
    }
}

depth: fn(value: Int?) -> Int {
    found: if value == {
        .Val(n) -> n
        .None -> 0
    }
    found
}

next_of: fn(value: Int?) -> Int? {
    if value == {
        .Val(n) -> Val(n + 1)
        .None -> None
    }
}

kept: fn(value: Int?) -> Int? {
    if value == {
        .Val(n) -> Val(n)
        .None -> None
    }
}

always: fn(shade: Shade) -> Int {
    if shade == {
        .Red | .Green | .Blue -> 7
    }
}

run: fn() -[IO]> {
    if Shade.Green == {
        .Red -> {}
        .Green | .Blue -> print("not red")
    }
    print(warm(Shade.Red))
    print(rank(Shade.Blue))
    print(depth(Val(4)))
    print(always(Shade.Green))
    print(next_of(Val(1)) ?? 0)
    print(kept(None) ?? 9)
}
