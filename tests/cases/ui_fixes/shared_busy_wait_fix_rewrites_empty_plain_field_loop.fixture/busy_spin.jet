use time: core.time

Flag: struct { ready: Bool, ticks: Int }

busy_spin: fn(flag: Shared<Flag>, _changed: Condition) {
    loop flag.ready == false {}
}

allowed_spin: fn(flag: Shared<Flag>) {
    #Allow(jet.SharedBusyWait, "the fixture exercises suppression of this occurrence") loop flag.ready == false {}
}

finite: fn(flag: Shared<Flag>) {
    loop _i in 0..<10 {
        if flag.ready { break }
    }
}

mutating: fn(flag: Shared<Flag>) {
    loop flag.ready == false {
        flag.ready = true
    }
}

blocking: fn(flag: Shared<Flag>, changed: Condition) {
    loop flag.ready == false {
        guard: flag.guard_edit()
        guard.wait(changed, value -> value.ready) ?? panic("wait failed")
    }
}

sleeping: fn(flag: Shared<Flag>) {
    loop flag.ready == false {
        time.sleep(1ms)
    }
}

receiving: fn(flag: Shared<Flag>, rx: Receiver<Int>) {
    loop flag.ready == false {
        rx.receive() ?? panic("channel closed")
    }
}

run: fn() {
    flag := shared Flag{ ready: true, ticks: 0 }
    changed := Condition.new()
    { sender: _tx, receiver: rx }: channel<Int>()
    busy_spin(flag, changed)
    allowed_spin(flag)
    finite(flag)
    mutating(flag)
    blocking(flag, changed)
    sleeping(flag)
    receiving(flag, rx)
}
