Color: enum {
    Red
    Green
    Custom(Int)
}

tally: fn(c: Color) -> Int {
    total := 0
    if c == {
        .Red -> total += 1
        .Custom(n) && n > 0 -> total += n
        else -> total += 100
    }
    total
}

weight: fn(c: Color) -> Int {
    if c == {
        .Red -> 1
        .Custom(n) && n > 0 -> n
        else -> 0
    }
}

clamp: fn(c: Color, cap: Bool) -> Int {
    found: if c == {
        .Custom(n) -> if cap -> 9 else -> return n
        else -> 5
    }
    found
}

run: fn() -[IO]> {
    print(tally(Color.Green))
    print(tally(Color.Custom(4)))
    print(weight(Color.Custom(0)))
    print(weight(Color.Custom(3)))
    print(clamp(Color.Custom(2), false))
    print(clamp(Color.Red, false))
}
