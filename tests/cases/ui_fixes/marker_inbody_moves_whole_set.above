// Each declaration writes its markers both above it and inside its body.
// `jet fix` moves each whole set above; `jet fix --markers inside|above`
// moves every set into the body or back out.
#[Codable, Layout(c)]
Pixel: struct {
    r: Int
}

#[MustUse, Inline]
area: fn(pixel: Pixel) -> Int {
    doubled: pixel.r * 2
    doubled
}

run: fn() { print(area(Pixel{r: 3})) }
