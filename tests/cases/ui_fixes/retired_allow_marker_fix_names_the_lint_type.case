# Claim: `jet fix` rewrites the retired `#allow(lint_name, …)` to `#Allow(jet.LintName, …)` at field and statement sites
# Claim: the rewritten allowances check clean
fixture: retired_allow_marker_fix_names_the_lint_type.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet fix allow.jet
exit: 0
step: sh {work}/step-2.sh
exit: 0
stdout: ~ "#Allow(jet.FloatMoney, \"the fixture keeps floating-point money\") price: Float" # the field-site allowance is rewritten
stdout: ~ "#Allow(jet.UnitScalarRewrap, \"the fixture keeps the explicit conversion\") print(\"kept\")" # the statement-site allowance is rewritten
step: jet check allow.jet
exit: 0
