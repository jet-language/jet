# A declaration writes its whole marker set in one place. Mixed sets are
# E0942, and `jet fix` moves each set above; `jet fix --markers inside` and
# `--markers above` move every set, `jet fmt` keeps the placement, and each
# move is idempotent and round-trips byte for byte.
fixture: marker_inbody_moves_whole_set.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 1
stderr: ~ "Struct `Pixel` writes markers both above it and inside its body" # E0942 names the mixed struct
stderr: ~ "Function `area` writes markers both above it and inside its body" # E0942 names the mixed function
step: jet fix run.jet
exit: 0
stderr: ~ "applied 2 fixes" # one move per mixed declaration
file: run.jet = marker_inbody_moves_whole_set.above
step: jet fix --markers inside run.jet
exit: 0
file: run.jet = marker_inbody_moves_whole_set.inside
step: jet fmt run.jet
exit: 0
file: run.jet = marker_inbody_moves_whole_set.inside
step: jet fix --markers inside run.jet
exit: 0
stderr: ~ "no changes made" # the inside move is idempotent
file: run.jet = marker_inbody_moves_whole_set.inside
step: jet run run.jet
exit: 0
stdout: = "6\n"
step: jet fix --markers above run.jet
exit: 0
file: run.jet = marker_inbody_moves_whole_set.above
step: jet fmt run.jet
exit: 0
file: run.jet = marker_inbody_moves_whole_set.above
step: jet fix --markers above run.jet
exit: 0
stderr: ~ "no changes made" # the above move is idempotent
step: jet fix --markers sideways run.jet
exit: 2
stderr: ~ "`sideways` is not a `jet fix --markers` placement" # a bad placement is a usage error
