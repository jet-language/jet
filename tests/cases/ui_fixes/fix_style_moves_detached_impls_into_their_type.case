# Claim: jet fix --style moves each impl jet check --style flags (L0535) into its type's body
# Claim: inherent methods become fn members and a trait impl a nested impl Trait, comments kept
# Claim: a trait impl keeps the marker written above it (#Commutative still finds 1 + shape)
# Claim: a target-specific impl (exception rule d) stays where it is
# Claim: the moved file checks clean of L0535, formats unchanged, runs the same, and a second fix changes nothing
fixture: fix_style_moves_detached_impls_into_their_type.fixture
env: NO_COLOR=1
step: jet run run.jet
exit: 0
stdout: = "9\n12\nshape 3\n7\n16\n"
step: jet fix --style run.jet
exit: 0
stderr: ~ "applied 4 fixes" # one move per flagged impl
file: run.jet = fix_style_moves_detached_impls_into_their_type.moved
step: jet check --style run.jet
exit: 0
stderr: !~ "DetachedImpl" # nothing is left to move
step: jet fmt run.jet
exit: 0
file: run.jet = fix_style_moves_detached_impls_into_their_type.moved
step: jet run run.jet
exit: 0
stdout: = "9\n12\nshape 3\n7\n16\n"
step: jet fix --style run.jet
exit: 0
stderr: ~ "no changes made" # the move is idempotent
file: run.jet = fix_style_moves_detached_impls_into_their_type.moved
