// `add`'s replacement takes the same call: `jet fix` renames its uses, except
// where the new name means something else (`total` below is a local Int):
// no edit is offered there, and L2001 says to edit it by hand. `double`'s replacement needs another
// argument: no edit is offered, and L2001 says to edit the use by hand.
fn total(a: Int, b: Int) -> Int {
    a + b
}

#Deprecated(since: "1.2", use: "total")
fn add(a: Int, b: Int) -> Int {
    total(a, b)
}

fn scaled(a: Int, by: Int) -> Int {
    a * by
}

#Deprecated(since: "1.2", use: "scaled")
fn double(a: Int) -> Int {
    scaled(a, 2)
}

fn shadowed() -> Int {
    total := 5
    add(total, 1)
}

fn run() {
    print(total(1, 2))
    print(double(4))
    print(shadowed())
}
