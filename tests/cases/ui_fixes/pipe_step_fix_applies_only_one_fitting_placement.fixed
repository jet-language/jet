add: fn(a: Int, b: Int) -> Int { a + b }
double: fn(a: Int) -> Int { a * 2 }
label: fn(text: String, times: Int) -> String { "{text} x{times}" }

run: fn() -[IO]> {
    total: 3
        |> double(<>)
    print(total)
    twice: 4
        |> double(<>)
    print(twice)
    badge: "ab"
        |> label(<>, 2)
    print(badge)
    word: " hi "
        |> <>.trim()
    print(word)
    sum: 3
        |> add(10)
    print(sum)
}
