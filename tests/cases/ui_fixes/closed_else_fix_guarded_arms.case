# #6281: a guarded arm covers no case, so E0641's fix names every case the
# `else` stands for, guarded ones included, and the table that results needs
# no `else`: the other arms cover the subject. An arm whose inline `if` ends in
# `return` still ends at its line, so the named arm after it is its own arm.
fixture: closed_else_fix_guarded_arms.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 1
stderr: ~ "Fix: Name the cases instead: `.Green | .Custom(_) ->`" # a guarded arm covers no case, so its case is named too
stderr: ~ "Fix: Name the cases instead: `.Red | .Green ->`" # the arm after an inline `if … else -> return` is its own arm
stderr: ~ "3 problems found" # the statement table, the value table and the table after the return arm
step: jet fix run.jet
exit: 0
stderr: ~ "applied 3 fixes" # each report carries its Safe edit
file: run.jet = closed_else_fix_guarded_arms.fixed
step: jet check run.jet
exit: 0
step: jet run run.jet
exit: 0
stdout: = "100\n4\n0\n3\n2\n5\n"
