// Build-time values in the retired spelling. A comment that says
// `comptime { … }` and a string that holds it are text, not code.
SQUARES: comptime { [Int]{1, 4, 9} }

#Static LIMIT: comptime { 10 * 10 }

scaled: fn(n: Int) -> Int {
    factor: comptime { 6 * 7 }
    n * factor
}

run: fn() {
    print(SQUARES)
    print(LIMIT)
    print(scaled(2))
    print("comptime {{ kept }}")
}
