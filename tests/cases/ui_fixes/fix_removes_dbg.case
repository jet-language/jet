# A development run prints every `debug` trace; a build refuses the ones
# left over. `jet fix` removes each wrapper and keeps its expression as
# written, in parentheses where the call was an operand (`(2 + 3) * 2`), in
# one pass. The result builds and prints the same values with no trace, and
# a second `jet fix` changes nothing.
fixture: fix_removes_dbg.fixture
env: NO_COLOR=1
step: jet run run.jet
exit: 0
stdout: = "10\n10\n"
stderr: ~ "[debug] run.jet:8 2 + 3 = 5" # the operand trace
step: jet build run.jet
exit: 1
stderr: ~ "A `debug` trace is left at `run.jet:3`." # the memoized body's trace
stderr: ~ "3 problems found" # one per leftover trace
step: jet fix run.jet
exit: 0
stderr: ~ "applied 3 fixes" # every trace, in one pass
file: run.jet = fix_removes_dbg.fixed
step: jet fix run.jet
exit: 0
stderr: ~ "no changes made" # nothing is left to remove
file: run.jet = fix_removes_dbg.fixed
step: jet build run.jet
exit: 0
step: jet run run.jet
exit: 0
stdout: = "10\n10\n"
stderr: !~ "[debug]" # no trace is left to print
