# A `use:` replacement is a `jet fix` rename only when it takes the same call
# and, at the use, its name isn't a local or parameter; L2001 offers `jet fix` only there.
fixture: deprecated_rename_applies_only_where_the_call_still_checks.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 0
stderr: = deprecated_rename_applies_only_where_the_call_still_checks.check.stderr
step: jet fix run.jet
exit: 0
stderr: !~ "rolled back" # the shadowed use gets no edit, so nothing is attempted and rolled back
stderr: ~ "applied 1 fix" # the one use that still checks is renamed
file: run.jet = deprecated_rename_applies_only_where_the_call_still_checks.fixed
file: .jet/codemods/Fix-run.log.json !~ "\"reason\":\"the edited file no longer checks: " # no edit was attempted that fails to check
step: jet check run.jet
exit: 0
step: jet run run.jet
exit: 0
stdout: = "3\n8\n6\n"
