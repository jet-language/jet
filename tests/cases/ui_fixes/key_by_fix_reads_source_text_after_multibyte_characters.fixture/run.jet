// Readings — two in one ten-degree band — are equal: “warm” is 20–29°.
Reading: struct {
    celsius: Int

    impl Equatable {
        equal: fn(self, rhs: Reading) -> Bool { self.celsius / 10 == rhs.celsius / 10 }
    }
}

run: fn() {
    warm: Reading{celsius: 21}
    seen := [Reading:String]{}
    seen[warm] = "first"
    seen[Reading{celsius: 25}] = "second"
    print("keys: {seen.len()}")
}
