Shade: enum {
    Red
    Green
    Blue
}

warm: fn(shade: Shade) -> Bool {
    if shade == {
        .Red -> true
        else -> false
    }
}

rank: fn(shade: Shade) -> Int {
    if shade == { .Blue -> 3 else -> 1 }
}

depth: fn(value: Int?) -> Int {
    found: if value == {.Val(n) -> n else -> 0}
    found
}

next_of: fn(value: Int?) -> Int? {
    if value == {.Val(n) -> Val(n + 1) else -> None}
}

kept: fn(value: Int?) -> Int? {
    if value == {
        .Val(n) -> Val(n)
        .None -> None
        else -> Val(0)
    }
}

always: fn(shade: Shade) -> Int {
    if shade == {
        .Red | .Green | .Blue -> 7
        else -> 0
    }
}

run: fn() -[IO]> {
    if Shade.Green == { .Red -> {} else -> print("not red") }
    print(warm(Shade.Red))
    print(rank(Shade.Blue))
    print(depth(Val(4)))
    print(always(Shade.Green))
    print(next_of(Val(1)) ?? 0)
    print(kept(None) ?? 9)
}
