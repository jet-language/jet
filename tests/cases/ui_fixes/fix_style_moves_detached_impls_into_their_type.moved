Label: trait {
    label: fn(self) -> String
}

Shape: struct {
    side: Int

    // The area and the perimeter of a square.
    area: fn(self) -> Int { self.side * self.side }

    // Four sides.
    perimeter: fn(self) -> Int { self.side * 4 }

    impl Display {
        display: fn(self) -> String { "shape {self.side}" }
    }

    // The trait impl keeps its marker above it.
    #Commutative
    impl Add(Int) {
        add: fn(self, rhs: Int) -> Shape { Shape{side: self.side + rhs} }
    }
}

Color: enum {
    Red
    Blue

    code: fn(self) -> Int { 7 }
}

#Target(OS.Linux)
impl Color.Label {
    label: fn(self) -> String { "linux color" }
}

run: fn() {
    shape: Shape{side: 3}
    print(shape.area())
    print(shape.perimeter())
    print(shape)
    print(Color.Red.code())
    print((1 + shape).area())
}
