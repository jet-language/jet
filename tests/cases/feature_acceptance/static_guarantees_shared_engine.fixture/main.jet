
Die: distinct Int(1..6)

#[Pre(n >= 0, "n non-negative"), Post(result >= 0, "result non-negative")]
absish: fn(n: Int) -> Int {
    return n
}

#Scrub(Input) clean: fn(raw: #Input String) -> String {
    return raw.copy()
}

#Replayable add: fn(a: Int, b: Int) -> Int {
    return a + b
}

stamp: fn(path: String) -[FS]> String {
    return path.copy()
}

pick: fn(faces: [String#6], roll: Die) -> String {
    return faces[roll.raw() - 1]
}

run: fn() {
    dirty: #Input "x"
    safe := clean(dirty)
    faces: [String#6]{ "a", "b", "c", "d", "e", "f" }
    print(pick(faces, Die.from_int(1)))
    print(absish(3))
    print(add(1, 2))
    print(safe)
}
