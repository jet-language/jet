
D: struct {
    value: Int
}

Pair: struct {
    a: Int
    b: Int
}

align: fn(left: D, right: D) -> Pair { Pair{a: left.value, b: right.value} }

impl D.Add {
    add: fn(self, rhs: D) -> D {
        pair: align(self, rhs)
        return D{value: pair.a + pair.b}
    }
}

Envelope: enum {
    Pair(left: D, right: D)
}

Shown: struct {
    value: Int
}

impl Shown.Display {
    display: fn(self) -> String { "shown={self.value}" }
}

mark: fn(label: String, value: Int) -[IO]> D {
    print(label)
    return D{value: value}
}

run: fn() {
    print(D{value: 3})
    print(D{value: 1} + D{value: 2})
    print(Envelope.Pair{left: D{value: 4}, right: D{value: 5}})
    print(Shown{value: 9})
    print(mark("left", 1), mark("right", 2))
}
