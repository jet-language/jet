package: {
    name: "memory_shared_condition"
    version: "0.1.0"
    authority: { allow: [Exec, IO, Mem.Alloc, Mem.Rc, Time.Wait] }
}
// D-SHAREDGUARD1=A: a Shared<T> edit guard waits on a Condition with a
// predicate; the wait returns once the predicate holds, and a notify wakes
// waiters. One task and no panic, so every tier prints the same line.
State: struct {
    ready: Bool
    ticket: Int
}

mark_ready: fn(state: Shared<State>, changed: Condition) {
    guard: state.guard_edit()
    guard.value.ready = true
    changed.notify_one()
}

take_ticket: fn(state: Shared<State>, changed: Condition) -> Int {
    guard: state.guard_edit()
    // A cancelled or failed wait hands out no ticket.
    guard.wait(changed, fn(value) { value.ready }) ?? return 0
    guard.value.ticket += 1
    return guard.value.ticket
}

run: fn() {
    state: Shared{State{ready: false, ticket: 0}}
    changed: Condition.new()
    mark_ready(state, changed)
    print("ticket={take_ticket(state, changed)}")
}
