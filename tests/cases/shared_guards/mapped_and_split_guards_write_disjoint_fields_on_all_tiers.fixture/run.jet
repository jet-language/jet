
Pair: struct {
    left: Int,
    right: Int,
}

map_left: fn(handle: Shared<Pair>) {
    mapped := handle.guard_edit().map(value -> value.left)
    mapped.value += 10
}

split_pair: fn(handle: Shared<Pair>) {
    { first: left, second: right } := handle.guard_edit().split(
        value -> value.left,
        value -> value.right
    )
    left.value += 1
    right.value += 2
}

run: fn() {
    mapped := Shared{Pair{ left: 1, right: 2 }}
    map_left(mapped)
    print(mapped.left + mapped.right)

    split := Shared{Pair{ left: 3, right: 4 }}
    split_pair(split)
    print(split.left + split.right)
}
