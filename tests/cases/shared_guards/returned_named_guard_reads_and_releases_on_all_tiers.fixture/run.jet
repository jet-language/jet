
acquire: fn(handle: Shared<Int>) -> SharedGuard<Int> {
    return handle.guard_edit()
}

read_returned: fn(handle: Shared<Int>) -> Int {
    guard: acquire(handle)
    return guard.value
}

bump: fn(handle: Shared<Int>) {
    guard: handle.guard_edit()
    guard.value += 1
}

run: fn() {
    cell := shared 6
    print(read_returned(cell))
    bump(cell)
    print(cell.guard_read().value)
}
