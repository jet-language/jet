
#Error
EarlyExitError: enum {
    Stop
}

return_early: fn(handle: Shared<Int>) {
    guard: handle.guard_edit()
    guard.value += 1
    return
}

fail_early: fn(handle: Shared<Int>) -> Int EarlyExitError! {
    guard: handle.guard_edit()
    guard.value += 1
    return .Err(EarlyExitError.Stop)
}

run: fn() {
    cell := Shared{0}
    return_early(cell)
    _: fail_early(cell) ?? 0
    guard: cell.guard_edit()
    guard.value += 1
    print(guard.value)
}
