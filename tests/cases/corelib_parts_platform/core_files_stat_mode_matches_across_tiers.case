# Port of tests/corelib_parts/platform.rs:199-333. Stat.mode holds the permission bits (0o0..0o7777,
# the domain set_mode takes); the file type the original read from the S_IFMT bits is Stat.kind.
fixture: fixtures/core_files_stat_mode_matches_across_tiers
mkdir: directory
when os unix: chmod: executable.sh 755
step default: jet run main.jet  -- {work}/regular.txt {work}/executable.sh {work}/directory {work}/regular.link
exit: 0
when os unix: stdout.line(0).strip_prefix("family:"): = "unix" # original observations(): line.strip_prefix("family:")
when os windows: stdout.line(0).strip_prefix("family:"): = "windows" # original observations(): line.strip_prefix("family:")
stdout.line(1).strip_prefix("absolute:"): = "{work}/regular.txt" # original observations(): line.strip_prefix("absolute:")
stdout.line(2).trim.split(",", 0): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.split(",", 1): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.split(",", 2): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.split(",", 3): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.split(",", 4): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.split(",", 5): is-i64 # original observations(): mode.parse::<i64>()
stdout.line(2).trim.replace(",", "\n"): lines = 6 # original default_modes.len() == 6
stdout.line(2).trim.split(",", 0): numeric-lines = [420] # original mode & 0o777 == 0o644
stdout.line(2).trim.split(",", 1): numeric-lines = [493] # original mode & 0o777 == 0o755
stdout.line(2).trim.split(",", 2): numeric-lines = [493] # original mode & 0o777 == 0o755
stdout.line(2).trim.split(",", 4): numeric-lines = [384] # original mode & 0o777 == 0o600
stdout.line(2).trim.split(",", 5): numeric-lines = [448] # original mode & 0o777 == 0o700
stdout.line(2).trim.split(",", 3).bit_and(0o111): each-line where != "0" # original assert_ne!(mode & 0o111, 0)
stdout.line(3): = "file,file,dir,symlink,file,dir" # original S_IFREG/S_IFDIR/S_IFLNK mode & 0o170000 assertions
remove: regular.link
step interpreted: jet run main.jet -- {work}/regular.txt {work}/executable.sh {work}/directory {work}/regular.link
exit: 0
when os unix: stdout.line(0).strip_prefix("family:"): = "unix" # original observations(): line.strip_prefix("family:")
when os windows: stdout.line(0).strip_prefix("family:"): = "windows" # original observations(): line.strip_prefix("family:")
stdout.line(1).strip_prefix("absolute:"): = "{work}/regular.txt" # original observations(): line.strip_prefix("absolute:")
stdout: == default # original interpreted_modes == default_modes; the kinds match the default tier too
remove: regular.link
step release: jet run main.jet --release -- {work}/regular.txt {work}/executable.sh {work}/directory {work}/regular.link
exit: 0
when os unix: stdout.line(0).strip_prefix("family:"): = "unix" # original observations(): line.strip_prefix("family:")
when os windows: stdout.line(0).strip_prefix("family:"): = "windows" # original observations(): line.strip_prefix("family:")
stdout.line(1).strip_prefix("absolute:"): = "{work}/regular.txt" # original observations(): line.strip_prefix("absolute:")
stdout: == default # original release_modes == default_modes; the kinds match the default tier too
