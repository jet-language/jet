// D-WATCH-SCOPE1=A/comment: core.watcher owns file/process/port watch handles.
package: {
    name: "watcher"
    authority: { allow: [Env, Exec, Exec.Args, FS, FS.Read, FS.Write, IO, Mem.Alloc, Net, Time.Wait] }
}

use {
    event: core.event
    fs: core.files
    net: core.net
    os: core.sys
    process: core.process
    time: core.time
    watcher: core.watcher
}

// #2055: `WatchEvent.domain` and `.kind` are closed Core enums, not strings, so
// turning one into output text is an exhaustive match with no `else` arm — a new
// variant is a compile error here instead of silently taking a default branch.
domain_label: fn(domain: WatchDomain) -> String {
    if domain == {
        .File -> { return "file" }
        .Process -> { return "process" }
        .Port -> { return "port" }
    }
}

kind_label: fn(kind: WatchKind) -> String {
    if kind == {
        .Created -> { return "Created" }
        .Modified -> { return "Modified" }
        .Removed -> { return "Removed" }
        .Error -> { return "Error" }
        .Exited -> { return "Exited" }
        .Ready -> { return "Ready" }
    }
}

optional_kind_label: fn(kind: WatchKind?) -> String {
    if kind == {
        .Val(value) -> { return kind_label(value) }
        .None -> { return "none" }
    }
}

no_kind: fn() -> WatchKind? { None }

run: fn() {
    args: process.args()
    if args.len() > 0 && (args.get(0) ?? "") == "--watch-child" {
        time.sleep(60000ms)
        return
    }
    root: "/tmp/jet_watcher_demo"
    if fs.exists(root) -> fs.remove_all(root) ?? panic("cleanup failed")
    fs.create_dir_all(root) ?? panic("mkdir failed")
    nested: Path.from(root).join("nested")
    fs.create_dir_all(nested) ?? panic("nested mkdir failed")
    created: nested.join("note.txt")
    scope: event.scope()
    files: watcher.files(root) ?? panic("watch files failed")
    callback_path: created.to_string()
    sub: files.on(scope, ev -> {
        if ev.path == callback_path {
            print("callback {domain_label(ev.domain)}:{kind_label(ev.kind)}:recursive")
        }
    })
    fs.write(created, "hello") ?? panic("write failed")
    first: files.poll()
    first_kind := no_kind()
    loop ev in first {
        if ev.path == created.to_string() -> first_kind = Val(ev.kind)
    }
    print("recursive file: {optional_kind_label(first_kind)}")
    print("callback active: {sub.is_active()}")
    scope.cancel()
    print("callback after scope cancel: {sub.is_active()}")
    after_drop: nested.join("after-drop.txt")
    dropped_path: after_drop.to_string()
    if true {
        dropped_scope: event.scope()
        files.on(dropped_scope, ev -> {
            if ev.path == dropped_path -> print("leaked callback after scope drop")
        })
    }
    fs.write(after_drop, "cleanup") ?? panic("scope-drop write failed")
    after_drop_events: files.poll()
    after_drop_kind := no_kind()
    loop ev in after_drop_events {
        if ev.path == after_drop.to_string() -> after_drop_kind = Val(ev.kind)
    }
    print("scope drop file: {optional_kind_label(after_drop_kind)}")
    child: process.cmd([os.executable(), "--watch-child"]).spawn() ?? panic("child spawn failed")
    exited: watcher.process_pid(child.id())
    before_exit: exited.poll()
    print("process events before exit: {before_exit.len()}")
    child.kill() ?? panic("child kill failed")
    _: child.wait() ?? panic("child wait failed")
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen failed")
    address: net.listener_local_socket_addr(listener) ?? panic("listener address failed")
    ready: watcher.port("127.0.0.1", net.socket_port(address))
    set := watcher.set()
    set.add(exited)
    set.add(ready)
    print(set.summary())
    combined: set.poll()
    process_kind := no_kind()
    port_kind := no_kind()
    loop ev in combined {
        if ev.domain == {
            .File -> {}
            .Process -> { process_kind = Val(ev.kind) }
            .Port -> { port_kind = Val(ev.kind) }
        }
    }
    print("process event: {optional_kind_label(process_kind)}")
    print("port event: {optional_kind_label(port_kind)}")
    print("set events: {combined.len()}")
    files.cancel()
    print("file watcher active: {files.is_active()}")
    cancelled_path: nested.join("after-cancel.txt")
    fs.write(cancelled_path, "stopped") ?? panic("cancelled watcher write failed")
    print("file events after cancel: {files.poll().len()}")
    fs.remove_all(root) ?? panic("remove failed")
}
