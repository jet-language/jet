
use core.process as process
use core.tasks as tasks
use core.time as time

fn run() {
    (ready_tx, ready_rx) :: channel<Int>()
    worker :: task {
        child :: process.cmd(["{work}/cancel-tree.sh"]).stdout(.Capture).stderr(.Capture).spawn() ?? panic("spawn failed")
        ready_tx.send(1)
        child.wait() ?? panic("cancelled wait returned")
    }
    _ready :: ready_rx.receive() ?? panic("ready failed")
    time.sleep(100ms)
    worker.cancel()
    result :: worker.join()
    if result == {
        .Err(error) -> {
            if error == {
                .Cancelled -> { print("cancelled") }
                else -> { print("wrong cancellation") }
            }
        }
        .Ok(_) -> { print("completed") }
    }
}
