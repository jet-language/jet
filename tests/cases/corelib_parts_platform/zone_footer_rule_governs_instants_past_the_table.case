# A TZif footer's POSIX TZ rule governs the instants past the zone table's
# last transition (#5976 c111). The fixture's New York and Sydney tables end
# in 2037, so their 2045 offsets, next shifts, gap and overlap all come from
# the rules `EST5EDT,M3.2.0,M11.1.0` and `AEST-10AEDT,M10.1.0,M4.1.0/3`, on
# O0, O1, O2 and web.
fixture: zone_footer_rule_governs_instants_past_the_table.fixture
env: NO_COLOR=1
env: JET_TZDB_DIR={work}/tzdb
step o0: jet run -O0 --allow=Env,FS.Read main.jet
exit: 0
stdout: = expected.out
stderr: empty
step o1: jet run -O1 --allow=Env,FS.Read main.jet
exit: 0
stdout: = expected.out
stderr: empty
step o2: jet run -O2 --allow=Env,FS.Read main.jet
exit: 0
stdout: = expected.out
stderr: empty
step: jet build --target web --allow=Env,FS.Read main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = expected.out
