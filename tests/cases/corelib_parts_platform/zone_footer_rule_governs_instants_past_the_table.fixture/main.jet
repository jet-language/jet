// Both zone tables end in 2037; their footer rules decide 2045.
use core.time

run: fn() {
    names: [String]{"America/New_York", "Australia/Sydney"}
    stamps: [String]{"2045-01-15T12:00:00Z", "2045-07-15T12:00:00Z"}
    loop name in names {
        zone: time.zone(name) ?? panic("no zone {name}")
        loop stamp in stamps {
            instant: time.parse_rfc3339(stamp) ?? panic("bad stamp {stamp}")
            at: instant.to_timestamp()
            shift: zone.next_transition(at) ?? panic("no transition after {stamp}")
            print("{stamp} {time.zoned(instant, zone)}, next shift {time.zoned(time.from_timestamp(shift), zone)}")
        }
    }
    new_york: time.zone("America/New_York") ?? panic("no zone America/New_York")
    // 02:30 on the second Sunday of March 2045 is skipped; 01:30 on the
    // first Sunday of November happens twice.
    skipped: time.zoned_local(time.new(2045, 3, 12), time.local_time(2, 30, 0), new_york, "compatible") ?? panic("gap")
    print("2045-03-12 02:30 compatible: {skipped}")
    if time.zoned_local(time.new(2045, 3, 12), time.local_time(2, 30, 0), new_york, "reject") == .Err(problem) {
        print("2045-03-12 02:30 reject: {problem.reason}")
    }
    earlier: time.zoned_local(time.new(2045, 11, 5), time.local_time(1, 30, 0), new_york, "earlier") ?? panic("earlier")
    later: time.zoned_local(time.new(2045, 11, 5), time.local_time(1, 30, 0), new_york, "later") ?? panic("later")
    print("2045-11-05 01:30 earlier: {earlier}, later: {later}")
}
