# core.sys platform facts (name, arch, family, and platform, machine, is_unix,
# pathsep and linesep built from them), the process id, and the environment
# calls get, set and unset answer through core.sys's own Jet declarations.
# Each fact matches its derived spelling, and the output is the same on O0,
# O1 and O2.
fixture: core_sys_facts_and_environment_answer_the_same_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = core_sys_facts_and_environment_answer_the_same_on_every_tier.out
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = core_sys_facts_and_environment_answer_the_same_on_every_tier.out
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = core_sys_facts_and_environment_answer_the_same_on_every_tier.out
