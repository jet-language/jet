# Port of run_regressions.rs:131-137; reuse the original committed golden unchanged.
# PENDING-GRAMMAR: step-scoped env (fresh store and jetpack root for each tier).
env: JETPACK_ENV=1
env: NO_COLOR=1
step: jet run {root}/Examples/features/basics/named_args.jet
env: JET_STORE_DIR={work}/store-default
env: JETPACK_ROOT={work}/jetpack-default
stdout: = ../../../Examples/features/expected/basics/named_args.out
stderr: empty
step: jet run --interpret {root}/Examples/features/basics/named_args.jet
env: JET_STORE_DIR={work}/store-interpreter
env: JETPACK_ROOT={work}/jetpack-interpreter
stdout: = ../../../Examples/features/expected/basics/named_args.out
stderr: empty
