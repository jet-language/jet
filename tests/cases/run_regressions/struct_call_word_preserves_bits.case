# Port of run_regressions.rs:106-116; BOTH fixtures on BOTH run tiers.
# ORACLE-LITERAL: first fixture's exact original stdout at run_regressions.rs:110; never re-bless.
# PENDING-GRAMMAR: step-scoped env (fresh store and jetpack root for each fixture/tier).
env: JETPACK_ENV=1
env: NO_COLOR=1
# Original run_tier creates a fresh Scratch root per fixture/tier, not its children.
mkdir: cache/original-default
step: jet run {root}/tests/fixtures/struct_call_word_original.jet
env: JET_STORE_DIR={work}/cache/original-default/cache
env: JETPACK_ROOT={work}/cache/original-default/jetpack
stdout: = struct_call_word_original.out
stderr: empty
mkdir: cache/original-interpreter
step: jet run --interpret {root}/tests/fixtures/struct_call_word_original.jet
env: JET_STORE_DIR={work}/cache/original-interpreter/cache
env: JETPACK_ROOT={work}/cache/original-interpreter/jetpack
stdout: = struct_call_word_original.out
stderr: empty
mkdir: cache/example-default
step: jet run {root}/Examples/features/basics/struct_call_word.jet
env: JET_STORE_DIR={work}/cache/example-default/cache
env: JETPACK_ROOT={work}/cache/example-default/jetpack
stdout: = ../../../Examples/features/expected/basics/struct_call_word.out
stderr: empty
mkdir: cache/example-interpreter
step: jet run --interpret {root}/Examples/features/basics/struct_call_word.jet
env: JET_STORE_DIR={work}/cache/example-interpreter/cache
env: JETPACK_ROOT={work}/cache/example-interpreter/jetpack
stdout: = ../../../Examples/features/expected/basics/struct_call_word.out
stderr: empty
