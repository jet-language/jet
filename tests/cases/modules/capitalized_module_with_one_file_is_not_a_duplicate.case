# #6466: `use Util` with a single Util.jet names one file. The module's
# candidate paths {m}.jet and {P}.jet are the same path for a capitalized
# name, so that one file must not count as two matches (no false E0105).
# The real problem left is the module's case: `use Util` must be snake_case.
fixture: capitalized_module_with_one_file_is_not_a_duplicate.fixture
env: NO_COLOR=1
step: jet check run.jet
exit: 1
stderr: ~ "[jet.CasingMismatch]: Module `Util` must be snake_case" # the one real problem: a module name is snake_case
stderr: !~ "E0105" # one Util.jet matched by {m}.jet and {P}.jet is one file, not two
