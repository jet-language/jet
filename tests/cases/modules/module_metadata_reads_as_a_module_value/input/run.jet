use core.meta.[Module]

pricing: module

/// Old discount rules, kept for one release.
discount: module {
    category: "billing"
    maturity: .Experimental

    total: fn(text: String) -> Int { text.len() - 1 }
}

// A module argument is admitted as that module's Module value.
billing: module<Rules> {
    label: fn() -> String { "{Rules.name} in {Rules.category}" }

    rules: fn() -> Module { Rules }
}

priced: billing<pricing>

describe: fn(m: Module) -> String { "{m.name} ({m.category}, {m.maturity})" }

run: fn() {
    print(pricing.total("abc"))
    print(pricing.category)
    print(pricing.doc)
    print(pricing.file)
    print(pricing.package.name)
    print(pricing.package.version)
    print(discount.file)
    print(discount.doc)
    print(describe(pricing))
    print(describe(discount))
    print(discount.total("abc"))
    print(priced.label())
    print(describe(priced.rules()))
    print(describe(pricing.tiers))
    print(pricing.tiers.double(3))
}
