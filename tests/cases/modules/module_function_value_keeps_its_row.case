# A module function read as a value passes like any function: `pricing.total`
# fills an `fn(String) -[]> Int` parameter and runs the same at O0, O1 and O2.
# It keeps its inferred row, so a member that prints is refused by the
# narrower parameter on every tier.
fixture: module_function_value_keeps_its_row/input
env: NO_COLOR=1
step: jet check ok.jet
exit: 0
step: jet run --optimize=none ok.jet
exit: 0
stdout: = "9\n6\n6\n3\n3\n"
step: jet run --optimize=basic ok.jet
exit: 0
stdout: = "9\n6\n6\n3\n3\n"
step: jet run --optimize=full ok.jet
exit: 0
stdout: = "9\n6\n6\n3\n3\n"
step: jet check narrow.jet
exit: 1
stderr: count "Error [" = 1 # exactly this many
stderr: ~ "This callback uses the effect `IO`, which the parameter doesn't allow" # loud's inferred row is IO
step: jet run --optimize=none narrow.jet
exit: 1
stderr: ~ "This callback uses the effect `IO`, which the parameter doesn't allow" # O0 keeps the row
step: jet run --optimize=basic narrow.jet
exit: 1
stderr: ~ "This callback uses the effect `IO`, which the parameter doesn't allow" # O1 keeps the row
step: jet run --optimize=full narrow.jet
exit: 1
stderr: ~ "This callback uses the effect `IO`, which the parameter doesn't allow" # O2 keeps the row
