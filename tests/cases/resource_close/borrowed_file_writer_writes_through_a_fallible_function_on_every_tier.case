# A fallible function taking a borrowed FileWriter calls write_all on it,
# and the bytes reach the file, on every tier.
fixture: borrowed_file_writer_writes_through_a_fallible_function_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "hello\nagain\n"
step: jet run -O1 main.jet
exit: 0
stdout: = "hello\nagain\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "hello\nagain\n"
