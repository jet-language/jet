// A Close value taken out of an owned carrier's payload has one owner: the
// held directory stays open for the new owner after the carrier it came from
// ends, and a borrowed holder reads it in place without closing it.
use core.files as files

struct Res { name: String }
impl Res.Close {
    fn close(^self) { print("close {self.name}") }
}

struct Held {
    tracer: Res
    directory: Directory?

    // Reads the held directory where it is: a borrowed receiver never closes it.
    fn is_open(self) -> Bool Never! {
        if self.directory == {
            .Val(directory) -> {
                info :: directory.stat() ?? return false
                info.is_dir
            }
            .None -> false
        }
    }
}

struct Wrappers {
    root: String
    held: Held
}

struct Lease {
    root: String?
    handle: Held?

    fn is_open(self) -> Bool Never! {
        if self.handle == {
            .Val(held) -> held.is_open()
            .None -> false
        }
    }
}

fn held_at(name: String) -> Held? {
    directory :: files.open_directory(".") ?? return None
    Val(Held{tracer: Res{name: name}, directory: Val(directory)})
}

fn wrappers_at(name: String) -> Wrappers? {
    held :: held_at(name) ?? return None
    Val(Wrappers{root: ".", held: ^held})
}

// The Store shape: the payload's field moves out of the owned carrier with a
// written `^`, and the carrier then ends with this function.
fn lease_from_payload() -> Lease {
    wrappers :: wrappers_at("payload")
    root := String?{None}
    handle := Held?{None}
    if wrappers == {
        .Val(found) -> {
            root = Val(found.root)
            handle = Val(^found.held)
        }
        .None -> {}
    }
    Lease{root: root, handle: handle}
}

// `??` on an owned carrier moves its payload to the new binding.
fn held_from_unwrap() -> Held? {
    carrier :: held_at("unwrap")
    found :: carrier ?? return None
    Val(^found)
}

// A match arm tail on an owned carrier moves its payload out with `^`.
fn held_from_arm() -> Held? {
    carrier :: held_at("arm")
    found :: if carrier == {
        .Val(held) -> ^held
        .None -> panic("no held directory")
    }
    Val(^found)
}

fn check_lease() {
    lease :: lease_from_payload()
    print("payload open {lease.is_open()}")
    print("payload open again {lease.is_open()}")
}

fn check(label: String, held: Held?) {
    if held == {
        .Val(found) -> {
            print("{label} open {found.is_open()}")
            print("{label} open again {found.is_open()}")
        }
        .None -> print("{label} missing")
    }
}

// Each new owner is a named local, so it ends, and closes, with its function.
fn check_unwrap() {
    held :: held_from_unwrap()
    check("unwrap", held)
}

fn check_arm() {
    held :: held_from_arm()
    check("arm", held)
}

// A `^` drive hands the loop each element: pushing it moves it to the new
// list, which then closes each tracer once.
fn check_loop() {
    list :: [Res{name: "loop a"}, Res{name: "loop b"}]
    out := [Res]{}
    loop item in ^list {
        &out.push(item)
    }
    print("loop moved {out.len()}")
}

fn run() {
    check_lease()
    check_unwrap()
    check_arm()
    check_loop()
    print("done")
}
