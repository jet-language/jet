// A local whose value closes, reassigned, closes its old value while it is
// whole, then drops it: the old list buffer is freed once.
// Close moves its list out and zeroes it in place, as a wipe of secret
// words does. A close after the drop retains the freed buffer (its count
// word is the free list's link), zeroes it in place and frees it again: the
// buffer links to itself, two later lists of its size class share it, and
// the next push of that class pops the address 1. The lists hold 300 words,
// a size class nothing else in the run frees first, so the freed buffer is
// alone in its free list on every tier.
Words: struct {
    name: String
    p: [U64]

    impl Close {
        close: fn(&&self) {
            p := self.p.move()
            sum := U64{0}
            loop i in 0..<p.len() {
                sum = wrapping(sum + p[i])
                p[i] = U64{0}
            }
            print("close {self.name} sum {sum}")
        }
    }
}

words: fn(name: String, n: Int, v: U64) -> Words {
    p := [U64]{}
    loop _ in 0..<n -> p.push(v)
    Words{name: name, p: p}
}

sub: fn(a: Words, b: Words, name: String) -> Words {
    out := words(name, a.p.len(), U64{0})
    loop i in 0..<a.p.len() -> out.p[i] = wrapping(a.p[i] - b.p[i])
    out
}

held: fn(name: String, n: Int, v: U64) -> Words? {
    Val(words(name, n, v))
}

// The ECDSA harness's reduction: `if x >= n { t: x - n; x = t }`.
reduced: fn() -> U64 {
    n := words("n", 300, U64{2})
    x := words("x", 300, U64{7})
    if x.p[0] >= n.p[0] {
        t: sub(x, n, "t")
        x = t
    }
    x.p[0]
}

// An Option local's box ends at its reassignment too: a close after the
// drop reads the freed box.
boxed: fn() -> Int {
    o := held("o", 6, U64{3})
    o = Val(words("o2", 6, U64{4}))
    if o == {
        .Val(got) -> got.p.len()
        .None -> 0
    }
}

run: fn() {
    first: reduced()
    lists := [[U64]]{}
    loop k in 0..<8 {
        w := [U64]{}
        loop _ in 0..<300 -> w.push(U64{k})
        lists.push(w)
    }
    total := U64{0}
    loop list in lists {
        loop v in list -> total = wrapping(total + v)
    }
    print("reduced {first} total {total}")
    print("boxed {boxed()}")
}
