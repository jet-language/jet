# A consuming method `fn(&&self)` drops self, so a struct's
# [TCPListener] closes and its port rebinds, the same as a free function
# that takes the struct and as the struct leaving scope.
fixture: consuming_method_drops_self_and_its_listener.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run -A main.jet
exit: 0
stdout: = "consume empty: rebind ok\nconsume field: rebind ok\nfree fn: rebind ok\n"
step: jet build -A main.jet
exit: 0
step native: built
exit: 0
stdout: = "consume empty: rebind ok\nconsume field: rebind ok\nfree fn: rebind ok\n"
step: jet build -A --release main.jet
exit: 0
step release: built
exit: 0
stdout: = "consume empty: rebind ok\nconsume field: rebind ok\nfree fn: rebind ok\n"
