use net: core.net

Res: struct {
    ports: [Int]
    listeners: [TCPListener]

    release_empty: fn(&&self) {}
    release_field: fn(&&self) { held: self.listeners }
}

make: fn() -> Res NetError! {
    held := [TCPListener]{}
    listener: net.tcp_listen("127.0.0.1:0")
    address: net.listener_local_socket_addr(listener)
    port: net.socket_port(address)
    held.push(listener)
    Ok(Res{ports: [Int]{port}, listeners: held})
}

release_free: fn(r: &&Res) {}

try_bind: fn(label: String, port: Int) {
    if net.tcp_listen("127.0.0.1:{port}") == {
        .Ok(_) -> print("{label}: rebind ok")
        .Err(e) -> print("{label}: rebind FAILED {e}")
    }
}

run: fn() {
    b: make() ?? panic("b")
    pb: b.ports[0]
    b.release_empty()
    try_bind("consume empty", pb)
    c: make() ?? panic("c")
    pc: c.ports[0]
    c.release_field()
    try_bind("consume field", pc)
    d: make() ?? panic("d")
    pd: d.ports[0]
    release_free(d)
    try_bind("free fn", pd)
}
