
Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }

    handoff: fn(&&self) -> Resource { return self }
}
relay: fn(&&resource: Resource) -> Resource { return resource }
consume: fn(&&resource: Resource) { print("consume {resource.name}") }
run: fn() {
    first := Resource{ name: "transfer" }
    second := relay(first)
    third := second.handoff()
    consume(third)
}
