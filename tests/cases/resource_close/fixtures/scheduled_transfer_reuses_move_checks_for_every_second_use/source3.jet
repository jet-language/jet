
Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) {
            print("close {self.name}")
        }
    }
}

run: fn() {
    resource := Resource{ name: "dev" }
    defer close(resource)
    print("body")
}

bad: fn() {
    resource := Resource{ name: "x" }
    copied := resource.copy()
    print(copied.name)
}