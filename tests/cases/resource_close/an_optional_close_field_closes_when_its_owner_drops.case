# A value held in a `T?` field of a struct closes once when the struct drops (scope end, a returned owner, a None sibling field), on every optimization tier
fixture: an_optional_close_field_closes_when_its_owner_drops.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 run.jet
exit: 0 # unoptimized
stdout: = "scope end\nclose scoped\nend\nclose first\nclose returned\n" # unoptimized
step: jet run run.jet
exit: 0 # default jet run
stdout: = "scope end\nclose scoped\nend\nclose first\nclose returned\n" # default jet run
step: jet run --release run.jet
exit: 0 # release AOT
stdout: = "scope end\nclose scoped\nend\nclose first\nclose returned\n" # release AOT
