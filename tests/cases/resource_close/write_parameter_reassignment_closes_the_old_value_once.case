# Claim: assigning through a write parameter (`x: &Box`, `x: &Box?`) or a write receiver (`&self`) closes the caller's old value exactly once, before its drop, and the caller's scope end closes the new one, on o0, o1, o2 and web.
# Hand-derived: Close prints each value's name, length and sum; the old value closes at the write, the caller's values latest first at its scope end.
fixture: reassigned_close_local_closes_its_old_value_once_before_its_drop.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --optimize=none write.jet
exit: 0 # o0
stdout: = write_parameter_reassignment_closes_the_old_value_once.out # o0
step: jet run --optimize=basic write.jet
exit: 0 # o1
stdout: = write_parameter_reassignment_closes_the_old_value_once.out # o1
step: jet run --optimize=full write.jet
exit: 0 # o2
stdout: = write_parameter_reassignment_closes_the_old_value_once.out # o2
when tool node
step: jet build --target web write.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = write_parameter_reassignment_closes_the_old_value_once.out # web
end when
