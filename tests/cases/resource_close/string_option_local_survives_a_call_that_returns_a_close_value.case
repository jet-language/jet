# Claim: in the Store lease shape (Jetpack LeaseSnapshot.jet store_reuse_build_lease), a `String?` local set from a match in a loop keeps its value across a call that opens and returns a Close value, whether the local is passed by value or by reference around that call; the lease built from it reads it back, its held directory stays open, and its tracer closes once, on o0, o1 and o2, from `jet run` and from the built image.
# Hand-derived: "before" and "after" print the same relative bin path and its length; the wrapped lease closes its tracer once when `check` ends; the direct lease holds none.
fixture: string_option_local_survives_a_call_that_returns_a_close_value.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --allow=FS.Read --optimize=none run.jet
exit: 0 # o0
stdout: = string_option_local_survives_a_call_that_returns_a_close_value.out # o0
step: jet run --allow=FS.Read --optimize=basic run.jet
exit: 0 # o1
stdout: = string_option_local_survives_a_call_that_returns_a_close_value.out # o1
step: jet run --allow=FS.Read --optimize=full run.jet
exit: 0 # o2
stdout: = string_option_local_survives_a_call_that_returns_a_close_value.out # o2
step: jet build --allow=FS.Read --optimize=full run.jet
exit: 0
step: {work}/.jet/build/run
exit: 0 # o2 image
stdout: = string_option_local_survives_a_call_that_returns_a_close_value.out # o2 image
