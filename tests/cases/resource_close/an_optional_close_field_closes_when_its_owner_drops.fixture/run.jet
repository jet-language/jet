struct Resource {
    name: String
}

impl Resource.Close {
    fn close(^self) { print("close {self.name}") }
}

struct Holder {
    item: Resource?
}

struct Pair {
    first: Resource?
    second: Resource?
}

fn hold(name: String) -> Holder { Holder{item: Val(Resource{name: name})} }

fn scoped() {
    holder := Holder{item: Val(Resource{name: "scoped"})}
    print("scope end")
}

fn run() {
    scoped()
    returned := hold("returned")
    pair := Pair{first: Val(Resource{name: "first"}), second: None}
    print("end")
}
