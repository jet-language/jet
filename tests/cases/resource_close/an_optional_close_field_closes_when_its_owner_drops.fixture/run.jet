Resource: struct {
    name: String
}

impl Resource.Close {
    close: fn(^self) { print("close {self.name}") }
}

Holder: struct {
    item: Resource?
}

Pair: struct {
    first: Resource?
    second: Resource?
}

hold: fn(name: String) -> Holder { Holder{item: Val(Resource{name: name})} }

scoped: fn() {
    holder := Holder{item: Val(Resource{name: "scoped"})}
    print("scope end")
}

run: fn() {
    scoped()
    returned := hold("returned")
    pair := Pair{first: Val(Resource{name: "first"}), second: None}
    print("end")
}
