# Claim: a closing value (a user Close type, and a struct holding a FileReader beside one) in an Option or Result closes exactly once when `found: held ?? return ...` binds its payload, which then moves out or ends with its scope, on o0, o1 and o2.
# Hand-derived: one "close" line per value, printed when the caller's carrier ends.
fixture: closing_values_close_once.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --allow=FS.Read -O0 unwrap.jet
exit: 0 # o0
stdout: = closing_value_unwrapped_with_or_return_closes_once.out # o0
step: jet run --allow=FS.Read -O1 unwrap.jet
exit: 0 # o1
stdout: = closing_value_unwrapped_with_or_return_closes_once.out # o1
step: jet run --allow=FS.Read -O2 unwrap.jet
exit: 0 # o2
stdout: = closing_value_unwrapped_with_or_return_closes_once.out # o2
