// Each value below closes exactly once: `return held` leaves while the variable is live.
use files: core.files

Res: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
// Closes through the FileReader it holds, and the Res beside it.
Checked: struct {
    tracer: Res
    handle: files.FileReader
}

some_res: fn(name: String) -> Res? { Val(Res{name: name}) }

ok_res: fn(name: String) -> Res Err! { Ok(Res{name: name}) }

some_checked: fn(name: String) -> Checked? {
    handle: files.open("data.txt") ?? return None
    Val(Checked{tracer: Res{name: name}, handle: handle})
}

ok_checked: fn(name: String) -> Checked Err! {
    handle: files.open("data.txt") ?? return Err("open")
    Ok(Checked{tracer: Res{name: name}, handle: handle})
}

return_option_res: fn(name: String) -> Res? {
    held: some_res(name)
    if name.len() > 0 -> return held
    None
}

check_option_res: fn() {
    if return_option_res("return option res") == {
        .Val(got) -> print("got {got.name}")
        .None -> print("none")
    }
}

return_result_res: fn(name: String) -> Res Err! {
    held: ok_res(name)
    if name.len() > 0 -> return held
    Err("missing")
}

check_result_res: fn() {
    if return_result_res("return result res") == {
        .Ok(got) -> print("got {got.name}")
        .Err(error) -> print("failed {error}")
    }
}

return_option_reader: fn(name: String) -> Checked? {
    held: some_checked(name)
    if name.len() > 0 -> return held
    None
}

check_option_reader: fn() {
    if return_option_reader("return option reader") == {
        .Val(got) -> print("got {got.tracer.name}")
        .None -> print("none")
    }
}

return_result_reader: fn(name: String) -> Checked Err! {
    held: ok_checked(name)
    if name.len() > 0 -> return held
    Err("missing")
}

check_result_reader: fn() {
    if return_result_reader("return result reader") == {
        .Ok(got) -> print("got {got.tracer.name}")
        .Err(error) -> print("failed {error}")
    }
}

run: fn() {
    check_option_res()
    check_result_res()
    check_option_reader()
    check_result_reader()
    print("done")
}
