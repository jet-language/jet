// Each value below closes exactly once: `found: held ?? return ...` binds the payload, which then moves out.
use files: core.files

Res: struct { name: String }
impl Res.Close {
    close: fn(&&self) { print("close {self.name}") }
}

// Closes through the FileReader it holds, and the Res beside it.
Checked: struct {
    tracer: Res
    handle: files.FileReader
}

some_res: fn(name: String) -> Res? { Val(Res{name: name}) }

ok_res: fn(name: String) -> Res Err! { Ok(Res{name: name}) }

some_checked: fn(name: String) -> Checked? {
    handle: files.open("data.txt") ?? return None
    Val(Checked{tracer: Res{name: name}, handle: handle})
}

ok_checked: fn(name: String) -> Checked Err! {
    handle: files.open("data.txt") ?? return Err("open")
    Ok(Checked{tracer: Res{name: name}, handle: handle})
}

unwrap_option_res: fn(name: String) -> Res? {
    held: some_res(name)
    found: held ?? return None
    Val(found.move())
}

check_option_res: fn() {
    if unwrap_option_res("unwrap option res") == {
        .Val(got) -> print("got {got.name}")
        .None -> print("none")
    }
}

unwrap_result_res: fn(name: String) -> Res Err! {
    found: ok_res(name) ?? return Err("missing")
    Ok(found)
}

check_result_res: fn() {
    if unwrap_result_res("unwrap result res") == {
        .Ok(got) -> print("got {got.name}")
        .Err(error) -> print("failed {error}")
    }
}

unwrap_option_reader: fn(name: String) -> Checked? {
    held: some_checked(name)
    found: held ?? return None
    Val(found.move())
}

check_option_reader: fn() {
    if unwrap_option_reader("unwrap option reader") == {
        .Val(got) -> print("got {got.tracer.name}")
        .None -> print("none")
    }
}

unwrap_result_reader: fn(name: String) -> Checked Err! {
    found: ok_checked(name) ?? return Err("missing")
    Ok(found)
}

check_result_reader: fn() {
    if unwrap_result_reader("unwrap result reader") == {
        .Ok(got) -> print("got {got.tracer.name}")
        .Err(error) -> print("failed {error}")
    }
}

bound_res: fn() {
    held: some_res("bound res")
    found: held ?? return
    print("bound {found.name}")
}

bound_reader: fn() {
    held: some_checked("bound reader")
    found: held ?? return
    print("bound {found.tracer.name}")
}

run: fn() {
    check_option_res()
    check_result_res()
    check_option_reader()
    check_result_reader()
    bound_res()
    bound_reader()
    print("done")
}
