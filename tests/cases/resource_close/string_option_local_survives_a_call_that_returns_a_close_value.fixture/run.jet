// The Store lease shape: a `String?` local set from a match inside a loop
// keeps its value across a call that opens and returns a Close value (a held
// directory), when the local is passed by value or by reference to calls
// around it, and the lease built from both reads it afterwards.
use files: core.files

Res: struct { name: String }
impl Res.Close {
    close: fn(&&self) { print("close {self.name}") }
}

Held: struct {
    tracer: Res
    directory: Directory?

    is_open: fn(self) -> Bool Never! {
        if self.directory == {
            .Val(directory) -> {
                info: directory.stat() ?? return false
                info.is_dir
            }
            .None -> false
        }
    }
}

Wrappers: struct {
    root: String
    held: Held
}

Output: struct {
    output_root: String
    lease_root: String
}

Lease: struct {
    bin_relative: String?
    bin_output_root: String?
    projected_bin_root: String?
    wrapper_root: String?
    executables: [String]
    handle: Held?

    bin_path: fn(self, name: String) -> String? Never! {
        root: self.projected_bin_root ?? return None
        bin: self.bin_relative ?? return None
        Val("{root}/{bin}/{name}")
    }

    is_open: fn(self) -> Bool Never! {
        if self.handle == {
            .Val(held) -> held.is_open()
            .None -> false
        }
    }
}

strip_prefix: fn(path: String, prefix: String) -> String? Never! {
    if path.starts_with("{prefix}/") -> return Val(path.slice(prefix.len() + 1, path.len()))
    None
}

open_executables: fn(root: String, bin: String?) -> [String] Never! {
    names := [String]{}
    relative: bin ?? return names
    names.push("{root}/{relative}/tool")
    names.push("{root}/{relative}/helper")
    names
}

bin_length: fn(bin: &String?) -> Int Never! {
    found: bin ?? return -1
    found.len()
}

create_wrappers: fn(snapshot_root: String, executables: [String]) -> Wrappers? {
    if executables.len() == 0 -> return None
    mounts := [String]{}
    loop executable in executables -> mounts.push("{snapshot_root}.exec-mount/{executable}")
    directory: files.open_directory(".") ?? return None
    Val(Wrappers{root: "{snapshot_root}/wrappers/{mounts.len()}", held: Held{tracer: Res{name: "wrappers"}, directory: Val(directory)}})
}

build_lease: fn(bin: String, outputs: [Output], direct: Bool) -> Lease {
    bin_output_root := String?{None}
    bin_relative := String?{None}
    projected_bin_root := String?{None}
    if bin != "" {
        loop output in outputs {
            if bin_output_root != None -> break
            if strip_prefix(bin, output.output_root) == {
                .Val(relative) -> {
                    bin_output_root = Val(output.output_root)
                    bin_relative = Val(relative)
                    projected_bin_root = Val(output.lease_root)
                }
                .None -> {}
            }
        }
    }
    print("before: {bin_relative ?? "null"} ({bin_length(bin_relative)})")
    executables := open_executables(projected_bin_root ?? "/snapshot", bin_relative)
    wrappers: if direct -> Wrappers?{None} else -> create_wrappers("/lease", executables)
    print("after: {bin_relative ?? "null"} ({bin_length(bin_relative)})")
    wrapper_root := String?{None}
    handle := Held?{None}
    if wrappers == {
        .Val(found) -> {
            wrapper_root = Val(found.root)
            handle = Val(found.held.move())
        }
        .None -> {}
    }
    Lease{bin_relative: bin_relative, bin_output_root: bin_output_root, projected_bin_root: projected_bin_root, wrapper_root: wrapper_root, executables: executables, handle: handle}
}

check: fn(label: String, direct: Bool) {
    outputs: [Output]{
        Output{output_root: "/store/doc", lease_root: "/lease/doc"},
        Output{output_root: "/store/out", lease_root: "/lease/out"},
    }
    lease: build_lease("/store/out/bin", outputs, direct)
    print("{label} bin {lease.bin_relative ?? "null"}")
    print("{label} path {lease.bin_path("tool") ?? "null"}")
    print("{label} output {lease.bin_output_root ?? "null"} wrappers {lease.wrapper_root ?? "none"}")
    print("{label} executables {lease.executables.len()} open {lease.is_open()}")
}

run: fn() {
    check("wrapped", false)
    check("direct", true)
    print("done")
}
