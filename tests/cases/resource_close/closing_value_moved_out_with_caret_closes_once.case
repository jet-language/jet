# Claim: a closing value (a user Close type, and a struct holding a FileReader beside one) in an Option or Result closes exactly once when `^held` moves the variable out as the tail value, on o0, o1 and o2.
# Hand-derived: one "close" line per value, printed when the caller's carrier ends.
fixture: closing_values_close_once.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run --allow=FS.Read -O0 moved.jet
exit: 0 # o0
stdout: = closing_value_moved_out_with_caret_closes_once.out # o0
step: jet run --allow=FS.Read -O1 moved.jet
exit: 0 # o1
stdout: = closing_value_moved_out_with_caret_closes_once.out # o1
step: jet run --allow=FS.Read -O2 moved.jet
exit: 0 # o2
stdout: = closing_value_moved_out_with_caret_closes_once.out # o2
