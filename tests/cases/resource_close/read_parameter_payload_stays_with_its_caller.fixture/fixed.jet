// main.jet with each payload read where the caller holds it.
struct Res {
    name: String
}

impl Res.Close {
    fn close(^self) { print("close {self.name}") }
}

fn peek(warm: Res?) -> Bool {
    if warm == {
        .Val(got) -> got.name == "a"
        .None -> false
    }
}

fn peek_list(warm: [Res]?) -> Int {
    if warm == {
        .Val(got) -> got.len()
        .None -> 0
    }
}

fn run() {
    one := Res?{None}
    one = Val(Res{name: "a"})
    print("peek {peek(one)}")
    many := [Res]{}
    &many.push(Res{name: "b"})
    held := [Res]?{None}
    held = Val(^many)
    print("peek_list {peek_list(held)}")
    print("peek_list again {peek_list(held)}")
    print("end")
}
