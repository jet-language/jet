// main.jet with each payload read where the caller holds it.
Res: struct {
    name: String
}

impl Res.Close {
    close: fn(&&self) { print("close {self.name}") }
}

peek: fn(warm: Res?) -> Bool {
    if warm == {
        .Val(got) -> got.name == "a"
        .None -> false
    }
}

peek_list: fn(warm: [Res]?) -> Int {
    if warm == {
        .Val(got) -> got.len()
        .None -> 0
    }
}

run: fn() {
    one := Res?{None}
    one = Val(Res{name: "a"})
    print("peek {peek(one)}")
    many := [Res]{}
    many.push(Res{name: "b"})
    held := [Res]?{None}
    held = Val(many.move())
    print("peek_list {peek_list(held)}")
    print("peek_list again {peek_list(held)}")
    print("end")
}
