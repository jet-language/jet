Res: struct {
    name: String
}

impl Res.Close {
    close: fn(&&self) { print("close {self.name}") }
}

peek: fn(warm: Res?) -> Bool {
    got: warm ?? return false
    got.name == "a"
}

peek_list: fn(warm: [Res]?) -> Int {
    got: warm ?? return 0
    got.len()
}

run: fn() {
    one := Res?{None}
    one = Val(Res{name: "a"})
    print("peek {peek(one)}")
    many := [Res]{}
    many.push(Res{name: "b"})
    held := [Res]?{None}
    held = Val(many.move())
    print("peek_list {peek_list(held)}")
    print("end")
}
