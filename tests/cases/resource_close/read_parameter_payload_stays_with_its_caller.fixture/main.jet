struct Res {
    name: String
}

impl Res.Close {
    fn close(^self) { print("close {self.name}") }
}

fn peek(warm: Res?) -> Bool {
    got :: warm ?? return false
    got.name == "a"
}

fn peek_list(warm: [Res]?) -> Int {
    got :: warm ?? return 0
    got.len()
}

fn run() {
    one := Res?{None}
    one = Val(Res{name: "a"})
    print("peek {peek(one)}")
    many := [Res]{}
    &many.push(Res{name: "b"})
    held := [Res]?{None}
    held = Val(^many)
    print("peek_list {peek_list(held)}")
    print("end")
}
