use mem: core.mem

square: fn(n: Int) -> Int { n * n }

// A file constant is computed while building and needs no word.
SIDE: square(2)

// `comptime` demands the value now.
LIMIT: comptime { square(3) }

Grid: struct {
    cells: [Int#SIDE]
}

run: fn() {
    // A static assertion: checked while building, absent from the program.
    comptime {
        assert(LIMIT > SIDE, "LIMIT must exceed SIDE")
    }
    grid: Grid{cells: [Int#SIDE]{1, 2, 3, 4}}
    row: [Int#LIMIT]{1, 2, 3, 4, 5, 6, 7, 8, 9}
    fixed: mem.Fixed.new(size: LIMIT * 64)
    print("side {SIDE} limit {LIMIT}")
    print("grid {grid.cells.len()} row {row.len()}")
}
