// Only Jet's Prelude markers change checking settings. The Prelude's `Policy`
// row sets `inherits`, `resolution` and `scopes`; a package marker that sets
// them is refused, while `sites` and `repeatable` stay its own.
Strict: struct {
    impl Marker {
        sites: [.Function]
        repeatable: true
        inherits: true
        resolution: .Tighten
        scopes: [.Function]
    }
}

#Strict
run: fn() {
    print("strict")
}
