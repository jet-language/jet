// A generated member is checked like written code: its wrong result type is
// reported at the template line that wrote it.
Width: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            width: fn(self) -> Int { "wide" }
        }
    }
}

#Width
Point: struct {
    x: Int
}

run: fn() {
    print(Point{x: 1}.width())
}
