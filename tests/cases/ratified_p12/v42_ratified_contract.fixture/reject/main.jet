// The marker's `reject` stops the program at the marked type.
Audit: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            tname: target.name
            count: target.fields.len()
            if count > 3 -> reject(TooWide{name: tname, count: count})
            audit: fn(self) -> String { "{tname}: {count} fields" }
        }
    }
}

TooWide: struct {
    name: String
    count: Int

    impl Diagnostic {
        what: fn(self) -> String { "`{self.name}` has {self.count} fields" }
        why: fn(self) -> String { "an audited record keeps at most three fields" }
        fix: fn(self) -> String { "split `{self.name}` into smaller records" }
    }
}

#Audit
Point: struct {
    x: Int
    y: Int
    z: Int
    w: Int
}

run: fn() {
    print(Point{x: 1, y: 2, z: 3, w: 4}.audit())
}
