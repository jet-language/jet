# Marker bodies (#4276 c7): a marker's `expand` template holds the members it
# generates. A `name: fn(…)` written directly in the template is a member of
# the marked type with no nested `impl` (a static one too); a body-level
# `#if … else #if … else` expands only its chosen branch, and
# a template loop writes one member per field. The marker's parameter is a
# named field read as `self.label`. A direct member that would replace a
# written one is refused like any generated member. The old provider
# declaration `derive T.X { … }` is rejected as source that does not parse.
fixture: d_meta_body1_contract.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
env: JETPACK_ENV=1
step o0: jet run -O0 main.jet
exit: 0
stdout: = d_meta_body1_contract.stdout.expected
stderr: empty
step o2: jet run -O2 main.jet
exit: 0
stdout: = d_meta_body1_contract.stdout.expected
stderr: empty
step fmt: jet fmt --check main.jet
exit: 0 # the direct-member template is already formatted
step collide: jet check collide/main.jet
exit: 1
stderr: ~ "Generated member `describe` would change or shadow `describe` on `Point`" # a direct member can't replace a written one
stderr: ~ "jet-lang.dev/e/E0105" # the generated-collision code
stderr: ~ "--> main.jet:9:13" # the template's direct member
stderr: ~ "1 problem found" # one collision
step retired: jet check retired/main.jet
exit: 1
stderr: ~ "--> main.jet:5:" # the old provider declaration is refused where it starts
stderr: !~ "marker" # no teaching diagnostic points at the marker form
stderr: !~ "provider" # nor names the retired declaration
