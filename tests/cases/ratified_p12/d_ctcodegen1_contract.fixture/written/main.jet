// The members `#Describe` generates for Point in ../main.jet, written by
// hand. This program prints the same line as the generated one.
Point: struct {
    x: Int
    y: Int
}

impl Point {
    describe: fn(self) -> String { "Point" }

    field_count: fn(self) -> Int { 2 }
}

run: fn() {
    point: Point{x: 1, y: 2}
    print("{point.describe()} has {point.field_count()} fields")
}
