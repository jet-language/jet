// The generated `describe` claims Int but returns text. It is checked like
// written code: the error names the template line, as it would name the
// line of a hand-written method.
Describe: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            type_name: target.name
            count: target.fields.len()
            impl #{type_name} {
                describe: fn(self) -> Int { "{type_name}" }

                field_count: fn(self) -> Int { #{count} }
            }
        }
    }
}

#Describe
Point: struct {
    x: Int
    y: Int
}

run: fn() {
    point: Point{x: 1, y: 2}
    print("{point.describe()} has {point.field_count()} fields")
}
