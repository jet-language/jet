// The template is Jet source, parsed where it is written: a malformed
// member is a located parse error at the template line, before any
// expansion runs.
Describe: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            type_name: target.name
            count: target.fields.len()
            impl #{type_name} {
                describe: fn(self) -> String { "{type_name}" }

                field_count: fn(self) -> Int { #{count} + }
            }
        }
    }
}

#Describe
Point: struct {
    x: Int
    y: Int
}

run: fn() {
    point: Point{x: 1, y: 2}
    print("{point.describe()} has {point.field_count()} fields")
}
