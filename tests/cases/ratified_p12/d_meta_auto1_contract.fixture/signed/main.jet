// `!` refuses one generated trait; the others still derive.
#!Equatable
Mixed: struct {
    value: Int
}

#!Comparable
Unordered: struct {
    value: Int
}

run: fn() {
    a: Mixed{value: 1}
    b: Mixed{value: 1}
    print("{a}")
    print(a == b)
    c: Unordered{value: 1}
    d: Unordered{value: 2}
    print(c == d)
    print(c < d)
}
