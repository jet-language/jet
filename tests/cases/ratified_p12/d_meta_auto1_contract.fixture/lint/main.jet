// The package refuses silent generation through the named `auto_derive`
// lint; an explicit marker still opts a type in.
Plain: struct {
    value: Int
}

#[Equatable, Comparable]
Marked: struct {
    value: Int
}

run: fn() {
    a: Marked{value: 1}
    b: Marked{value: 2}
    print(a == b)
    print(a < b)
    c: Plain{value: 1}
    d: Plain{value: 2}
    print(c == d)
    print(c < d)
}
