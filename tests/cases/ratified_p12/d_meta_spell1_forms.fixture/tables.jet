// Tables main.jet builds while building; it imports this file for build-time
// code only, so the shipped program holds the finished lists.
build_squares: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> table.push(i * i)
    table
}

build_cubes: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> table.push(i * i * i)
    table
}
