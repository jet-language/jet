# Port of tests/image.rs:566-615. The original Store::ingest_tree setup runs through
# Jetpack/Store/Tests/PkgIntegrationImageSetup.jet (a real Store ingest, no fake records).
# The gzip layer's `port = 8080` bytes are not readable by text predicates.
fixture: environment_image_projects_explicit_extra_file_reproducibly.fixture
write: config/app.toml = "port = 8080\n"
mkdir: hangar-root
step: jet test {root}/Jetpack/Store/Tests/PkgIntegrationImageSetup.jet --filter "S3 image authentic fixture setup"
env: JET_TEST_IMAGE_SETUP={work}/hangar-root
env: JET_TEST_IMAGE_EXECUTABLES=bash bash@nixpkgs bash
exit: 0
step: jetpack image server
env: NO_COLOR=1
env: JETPACK_ROOT={work}/hangar-root
exit: 0
file: .jet/images/server/projection.json ~ "file:config/app.toml" # original projection predicate
file: .jet/images/server/plan.json ~ "config/app.toml" # original plan predicate
copy: .jet/images/server/index.json first-index.json
remove: .jet/images
step: jetpack image server
env: NO_COLOR=1
env: JETPACK_ROOT={work}/hangar-root
exit: 0
file: .jet/images/server/index.json == first-index.json
