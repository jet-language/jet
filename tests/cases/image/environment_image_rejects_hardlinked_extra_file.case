# Port of tests/image.rs:1008-1044. The original Store::ingest_tree setup runs through
# Jetpack/Store/Tests/PkgIntegrationImageSetup.jet (a real Store ingest, no fake records).
# The original's outside scratch is the work directory's `outside/`, which the image never names.
fixture: environment_image_rejects_hardlinked_extra_file.fixture
write: outside/payload.bin = "must not be read\n"
hardlink: outside/payload.bin payload.bin
mkdir: hangar-root
step: jet test {root}/Jetpack/Store/Tests/PkgIntegrationImageSetup.jet --filter "S3 image authentic fixture setup"
env: JET_TEST_IMAGE_SETUP={work}/hangar-root
env: JET_TEST_IMAGE_EXECUTABLES=bash bash@nixpkgs bash
exit: 0
step: jetpack image server
env: NO_COLOR=1
env: JETPACK_ROOT={work}/hangar-root
exit: 2
stderr: ~ "hard link" # original predicate
file: outside/payload.bin ~ "must not be read" # original outside payload predicate
