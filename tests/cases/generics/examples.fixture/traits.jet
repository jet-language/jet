Shape: trait {
    area: fn(self) -> Float
    name: fn(self) -> String
}

Circle: struct {
    radius: Float

    impl Shape {
        area: fn(self) -> Float { Float{3.14159} * self.radius * self.radius }

        name: fn(self) -> String { "circle" }
    }
}

Square: struct {
    side: Float

    impl Shape {
        area: fn(self) -> Float { self.side * self.side }

        name: fn(self) -> String { "square" }
    }
}

largest: fn<T: Comparable>(xs: [T]) -> T? {
    if xs.len() == 0 -> return None
    best := xs[0].copy()
    i := 1
    loop i < xs.len() {
        if xs[i] > best -> best = xs[i].copy()
        i += 1
    }
    return Val(best)
}

print_area: fn(s: Shape) { print("{s.name()}: {s.area()}") }

#Comparable
Score: struct {
    points: Int
}

run: fn() {
    shapes: [Shape]{Circle{radius: 1.0}, Square{side: 2.0}}
    // S48: a trait name in type position boxes invisibly, so a concrete value
    // meets `s: Shape` directly — as a name and as a literal argument.
    one: Circle{radius: 2.0}
    print_area(one)
    print_area(Square{side: 3.0})
    shapes.each(fn(s) { print_area(s) })
    nums: [3, 1, 4, 1, 5]
    print(largest(nums))
    scores := [Score]{{points: 10}, {points: 20}}
    scores.sort_by(fn(s: Score) { s.points })
    print(scores[0].points)
}
