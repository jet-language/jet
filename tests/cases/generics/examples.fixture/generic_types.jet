struct Pair<T> {
    first: T
    second: T
}

fn make_pair<T>(a: T, b: T) -> Pair<T> { {first: a.copy(), second: b.copy()} }

struct Stack<T> {
    items: [T]
}

fn push<T>(s: Stack<T>, item: T) -> Stack<T> {
    dup := s.copy()
    &dup.items.push(item.copy())
    return dup
}

fn run() {
    p :: Pair<Int>{make_pair(1, 2)}
    print(p.first)
    st := Stack<Int>{items: []}
    st = push(st, 42)
    print(st.items[0])
}
