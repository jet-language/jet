Pair: struct<T> {
    first: T
    second: T
}

make_pair: fn<T>(a: T, b: T) -> Pair<T> { {first: a.copy(), second: b.copy()} }

Stack: struct<T> {
    items: [T]
}

push: fn<T>(s: Stack<T>, item: T) -> Stack<T> {
    dup := s.copy()
    dup.items.push(item.copy())
    return dup
}

run: fn() {
    p: Pair<Int>{make_pair(1, 2)}
    print(p.first)
    st := Stack<Int>{items: []}
    st = push(st, 42)
    print(st.items[0])
}
