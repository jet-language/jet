Priced: trait {
    price: fn(self) -> Int
}

Describe: trait {
    describe: fn(self) -> String
}

Pair: struct<T> {
    left: T
    right: T
}

impl Pair<T: Priced>.Describe {
    describe: fn(self) -> String { "pair costs {self.left.price() + self.right.price()}" }
}

impl Pair<T: Priced> {
    cents: fn(self) -> Int { self.left.price() + self.right.price() }
}

Apple: struct {
    cents: Int

    impl Priced {
        price: fn(self) -> Int { self.cents }
    }
}

show: fn<T: Describe>(value: T) -> String { value.describe() }

total: fn<U: Priced>(pair: Pair<U>) -> String { pair.describe() }

run: fn() {
    p: Pair<Apple>{left: Apple{cents: 3}, right: Apple{cents: 4}}
    print(show(p))
    print(p.describe())
    print(total(Pair<Apple>{left: Apple{cents: 10}, right: Apple{cents: 5}}))
    print(p.cents())
}
