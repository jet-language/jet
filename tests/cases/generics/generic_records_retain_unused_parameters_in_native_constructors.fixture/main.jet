
Token: struct<T> {}
Plan: struct<T> {
    json: String
    phantom: Int
}
Mixed: struct<T, Value> {
    values: [Value]
}
token: fn<T>() -> Token<T> { Token<T>{} }
plan: fn<T>(json: ^String) -> Plan<T> {
    Plan<T>{json: json, phantom: 7}
}
mixed: fn<T, Value>(value: ^Value) -> Mixed<T, Value> {
    Mixed<T, Value>{values: [Value]{value}}
}
CONSTANT: comptime { Plan<Int>{json: "constant", phantom: 9} }
run: fn() {
    empty: token<Int>()
    another: token<String>()
    copied: empty.copy()
    item: plan<Int>("literal")
    values: mixed<String, Int>(3)
    print(item.json)
    print(item.phantom)
    print(values.values[0])
    print(CONSTANT.json)
}
