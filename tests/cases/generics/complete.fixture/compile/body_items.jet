
complete: module<T>(count: Int, label: String) {
    #Meta(category: label)
    VALUE: comptime { count }
    COMPTIME_VALUE: comptime { count + 1 }
    Marked: tag { deny: [Net] }
    Reveal: trait { reveal: fn(self) -> T }
    Wrapped: struct { value: T }
    Maybe: enum { Empty Value(T) }
    impl Wrapped.Reveal { reveal: fn(self) -> T { return self.value } }
    SourceErr: enum { Bad(T) }
    TargetErr: enum { Wrapped(SourceErr) }
    impl SourceErr -> TargetErr { return TargetErr.Wrapped(self) }
    #Target(OS.Linux)
    impl Wrapped { linux_value: fn(self) -> T { return self.value } }
    plain: module { value: fn() -> Int { return count } }
    nested: module<U> { keep: fn(value: U) -> U { return value.copy() } }
    nested_use: nested<T>
    #Meta(category: label)
    marked: fn(value: &&#Marked T) -> #Marked T {
        #Meta(category: label)
        local := T{ value }
        return local
    }
    #Test identity: fn(value: T) { assert(count == count) }
    #Test("complete") { .measure { assert(label == label) } }
}
complete_use: complete<Int>(3, "generic module")
run: fn() {}
