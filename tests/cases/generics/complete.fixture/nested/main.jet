
outer: module<T>(count: Int) {
    plain: module {
        inner: module<U> {
            total: fn(value: U) -> Int { return count }
        }
        closed: inner<T>
        forwarded: closed
        result: fn(value: T) -> Int {
            return closed.total(value) + forwarded.total(value)
        }
    }
    result: fn(value: T) -> Int {
        return plain.result(value)
    }
}
selected: outer<Int>(3)
run: fn() {
    print(selected.result(1))
}
