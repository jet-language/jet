
Mode: enum { Fast Safe }
keyed: module(flag: Bool, count: Int, letter: Char, label: String, mode: Mode) {
    value: fn() -> Int { return count }
}
same: keyed(true, 3, 'a', "x", Mode.Fast)
equivalent: keyed(1 < 2, 1 + 2, 'a', "x", Mode.Fast)
different_bool: keyed(false, 3, 'a', "x", Mode.Fast)
different_int: keyed(true, 4, 'a', "x", Mode.Fast)
different_char: keyed(true, 3, 'b', "x", Mode.Fast)
different_string: keyed(true, 3, 'a', "y", Mode.Fast)
different_enum: keyed(true, 3, 'a', "x", Mode.Safe)
run: fn() {}
