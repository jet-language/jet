
Box: struct<T> {
    value: T

    new: fn(value: &&T) -> Box<T> {
        return Box<T>{ value: value }
    }

    convert: fn<U>(self, value: &&U, *, note: String{"unused"}) -> U {
        return value
    }

    make: fn<U>(value: &&U) -> U {
        return value
        }
}

run: fn() {
    box: Box<Int>.new(3)
    value: box.convert<String>(note: "explicit", value: "ok")
    inferred: box.convert(note: "inferred", value: "again")
    static_value: Box.make<String>("static")
    static_inferred: Box.make("inferred")
    print(value)
    print(inferred)
    print(static_value)
    print(static_inferred)
}
