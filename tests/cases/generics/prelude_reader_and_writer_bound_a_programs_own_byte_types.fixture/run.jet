// A byte source and a byte sink of the program's own meet the Prelude
// Reader and Writer. Generic code calls them through the bare bounds:
// `read_into` appends to the caller's buffer in place, and a generic struct
// holds its source as a field.
Chunks: struct {
    data: [U8]
    at: Int

    impl Reader {
        read: fn(&self, limit: Int) -> [U8] IOError! {
            out := [U8]{}
            _: self.read_into(out, limit) ?? return Err(err)
            Ok(out)
        }

        read_into: fn(&self, buffer: &[U8], limit: Int) -> Int IOError! {
            count := 0
            loop count < limit && self.at < self.data.len() {
                buffer.push(self.data[self.at])
                self.at += 1
                count += 1
            }
            Ok(count)
        }
    }
}

Sink: struct {
    bytes: [U8]

    impl Writer {
        write: fn(&self, bytes: [U8]) -> Int IOError! {
            loop byte in bytes -> self.bytes.push(byte)
            Ok(bytes.len())
        }

        write_all: fn(&self, bytes: [U8]) IOError! {
            loop byte in bytes -> self.bytes.push(byte)
        }
    }
}

// Reads `source` to its end, `step` bytes at a time, into one buffer.
drain: fn<R: Reader>(&source: R, step: Int) -> [U8] IOError! {
    out := [U8]{}
    loop {
        count: source.read_into(out, step)
        if count == 0 -> break
    }
    Ok(out)
}

// Copies `source` into `sink` in reads of three bytes; the count copied.
pipe: fn<R: Reader, W: Writer>(&source: R, &sink: W) -> Int IOError! {
    total := 0
    loop {
        chunk: source.read(3)
        if chunk.len() == 0 -> break
        total += chunk.len()
        sink.write_all(chunk)
    }
    Ok(total)
}

// A pull stream over any source: its buffer refills in place.
Pull: struct<R: Reader> {
    input: R
    buffer: [U8]

    fill: fn(&self) -> Int IOError! {
        self.buffer.clear()
        self.input.read_into(self.buffer, 2)
    }
}

run: fn() {
    first := Chunks{data: "hello".bytes(), at: 0}
    drained: drain(first, 2) ?? panic("drain")
    print("drained {drained.len()} {String.from_bytes(drained) ?? "?"}")
    second := Chunks{data: "abcdefgh".bytes(), at: 0}
    sink := Sink{bytes: [U8]{}}
    copied: pipe(second, sink) ?? panic("pipe")
    print("copied {copied} {String.from_bytes(sink.bytes) ?? "?"}")
    written: sink.write("!".bytes()) ?? panic("write")
    print("wrote {written}")
    pull := Pull{input: Chunks{data: "xyz".bytes(), at: 0}, buffer: [U8]{}}
    loop {
        got: pull.fill() ?? panic("fill")
        if got == 0 -> break
        print("fill {got} {String.from_bytes(pull.buffer) ?? "?"}")
    }
}
