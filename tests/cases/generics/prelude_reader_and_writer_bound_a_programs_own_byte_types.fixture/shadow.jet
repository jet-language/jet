// A program's own struct named `Reader`, as core.term's byte cursor is, does
// not hide the Prelude trait: the impl and the bound both name the trait,
// and a value of the struct still builds.
Reader: struct {
    at: Int
}

Ones: struct {
    left: Int

    impl Reader {
        read: fn(&self, limit: Int) -> [U8] IOError! {
            out := [U8]{}
            _: self.read_into(out, limit) ?? return Err(err)
            Ok(out)
        }

        read_into: fn(&self, buffer: &[U8], limit: Int) -> Int IOError! {
            count := 0
            loop count < limit && self.left > 0 {
                buffer.push(49)
                self.left -= 1
                count += 1
            }
            Ok(count)
        }
    }
}

// The number of bytes `source` holds, read four at a time.
total: fn<R: Reader>(&source: R) -> Int IOError! {
    out := [U8]{}
    loop {
        count: source.read_into(out, 4)
        if count == 0 -> break
    }
    Ok(out.len())
}

run: fn() {
    cursor: Reader{at: 3}
    ones := Ones{left: 10}
    read: total(ones) ?? panic("total")
    print("cursor {cursor.at} read {read}")
}
