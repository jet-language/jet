Box: struct {
    value: Int | String
}

describe: fn(v: Int | String) -> String {
    if v == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

run: fn() {
    c: Box{value: "y"}
    d: Box{value: 5}
    e: Box{value: 5}
    f: Box{value: "y"}
    print(d.value == c.value)
    print(d.value == e.value)
    print(c.value == f.value)
    print(c.value != e.value)
    print(describe(d.value))
    print(describe(c.value))
}
