
box: module(capacity: Int) {
    BASE: #run capacity
    shadowed: fn() -> Int {
        base: #run 5
        return base
    }
    plain_shadowed: fn() -> Int {
        capacity := 5
        return capacity
    }
}
b32: box(32)
run: fn() {
    print(b32.shadowed())
    print(b32.plain_shadowed())
}
