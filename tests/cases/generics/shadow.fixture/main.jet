
module box(capacity: Int) {
    BASE :: comptime { capacity }
    fn shadowed() -> Int {
        base :: comptime { 5 }
        return base
    }
    fn plain_shadowed() -> Int {
        capacity := 5
        return capacity
    }
}
module b32 :: box(32)
fn run() {
    print(b32.shadowed())
    print(b32.plain_shadowed())
}
