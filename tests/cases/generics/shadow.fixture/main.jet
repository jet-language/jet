
module box(capacity: Int) {
    BASE :: prep { capacity }
    pub fn shadowed() -> Int {
        base :: prep { 5 }
        return base
    }
    pub fn plain_shadowed() -> Int {
        capacity := 5
        return capacity
    }
}
module b32 :: box(32)
fn run() {
    print(b32.shadowed())
    print(b32.plain_shadowed())
}
