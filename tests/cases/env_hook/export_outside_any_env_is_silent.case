# Port of tests/env_hook.rs::export_outside_any_env_is_silent.
# PENDING-GRAMMAR: step-scoped unset (TestW3b batch one).
env: PATH=/usr/bin:/bin
step: jetpack env export bash
unset: JET_ENV_DISABLE
unset: JETPACK_ENV
unset: JETPACK_ENV_DIR
unset: JETPACK_ENV_HASH
unset: JETPACK_ENV_OLD_PATH
unset: JETPACK_REF
exit: 0
stdout: empty
