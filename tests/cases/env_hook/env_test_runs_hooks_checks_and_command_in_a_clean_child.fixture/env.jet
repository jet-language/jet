module env.dev {
    on_enter: [{
        name: "clean-enter",
        command: "test -z \"$JET_PARENT_SENTINEL\" && printf entered > .clean-marker",
        trusted: true,
    }]
    checks: [{
        name: "clean-check",
        command: "test -z \"$JET_PARENT_SENTINEL\" && test -f .clean-marker",
        trusted: true,
    }]
}
