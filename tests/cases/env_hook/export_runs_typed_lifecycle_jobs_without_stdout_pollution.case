# Port of tests/env_hook.rs::export_runs_typed_lifecycle_jobs_without_stdout_pollution.
# Preserve caller PATH: the typed job uses the caller's compiler/toolchain.
# PENDING-GRAMMAR: tool expansion and step unset.
fixture: typed-lifecycle.fixture
env: HOME={work}/home
mkdir: home
step: jetpack trust grant env:{work} --scope user
exit: 0
step: jetpack env --no-color export bash
unset: JET_ENV_DISABLE
unset: JETPACK_ENV
unset: JETPACK_ENV_DIR
unset: JETPACK_ENV_HASH
unset: JETPACK_ENV_OLD_PATH
unset: JETPACK_REF
exit: 0
stdout: ~ "export JETPACK_ENV=1" # original predicate
stdout: !~ "typed lifecycle job" # original predicate
