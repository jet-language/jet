# Port of tests/env_hook.rs::export_unchanged_directory_is_silent.
# The captured CLI-emitted assignment is sourced unchanged; no hash computation/helper.
# A `module env.dev` env is typed, so the hook activates it only after an env
# grant (trust law; same setup as export_runs_typed_lifecycle_jobs...).
requires: tool:bash
fixture: activation-reload.fixture
env: PATH=/usr/bin:/bin
env: HOME={work}/home
mkdir: home
step: jetpack trust grant env:{work} --scope user
exit: 0
step: jetpack env export bash
unset: JET_ENV_DISABLE
unset: JETPACK_ENV
unset: JETPACK_ENV_DIR
unset: JETPACK_ENV_HASH
unset: JETPACK_ENV_OLD_PATH
unset: JETPACK_REF
exit: 0
capture: hash stdout line ^= "export JETPACK_ENV_HASH=" # original activation_hash field
write: hash.env hash.template
step: {tool:bash} --noprofile --norc -c 'source hash.env && exec "$1" env export bash' reexport {jetpack}
env: JETPACK_ENV_DIR={work}
unset: JET_ENV_DISABLE
unset: JETPACK_ENV
unset: JETPACK_ENV_HASH
unset: JETPACK_ENV_OLD_PATH
unset: JETPACK_REF
exit: 0
stdout: empty
