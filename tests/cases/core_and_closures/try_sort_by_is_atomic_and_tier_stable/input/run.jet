sort_key: fn(n: Int) -> String Never! { "{n}" }
stopping_sort_key: fn(n: Int, seen: &String) -> String Err! {
    seen += "{n}"
    if n == 1 { return Err("stop", code: "E_SORT") }
    return "{n}"
}
unit: fn() {}
run: fn() {
    ascending := [3, 1, 2]
    ascending.sort_by(fn(n: Int) { sort_key(n) })
    descending := [3, 1, 2]
    descending.sort_by_desc(fn(n: Int) { sort_key(n) })

    values := [3, 1, 2]
    seen := ""
    recovered := false
    values.sort_by(fn(n: Int) { stopping_sort_key(n, seen) }) ?? {
        print("{err.code}:{err.message}")
        recovered = true
        unit()
    }
    print("{ascending}|{descending}")
    print(seen)
    print(values)
    print(recovered)
}
