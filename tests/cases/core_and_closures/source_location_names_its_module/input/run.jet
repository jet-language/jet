// SourceLocation.module is the package's name, then the `name: module`
// declarations that reach the file, then the inline modules around the place.
where: fn(at: SourceLocation{$caller}) -> String { at.module }

db: module {
    query: fn() -> String { where() }
    inner: module {
        deep: fn() -> String { where() }
    }
}

cache: module

run: fn() {
    print(where())
    print(db.query())
    print(db.inner.deep())
    print(cache.get())
    print(cache.stored())
    here: $here
    print("here: {here.module}")
}
