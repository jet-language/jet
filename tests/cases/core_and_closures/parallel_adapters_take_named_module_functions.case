# A named module fn passed to para_map, para_filter, para_partition and
# para_fold checks like a lambda and gives the sequential adapters' result on
# every tier. A fallible callback makes the call a Result whose Err is the
# lowest-index failure (spec.md "Parallel collection adapters").
fixture: parallel_adapters_take_named_module_functions.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run main.jet
exit: 0
stdout: = parallel_adapters_take_named_module_functions.out
step: jet build main.jet
exit: 0
step o1: built
exit: 0
stdout: = parallel_adapters_take_named_module_functions.out
step: jet build --release main.jet
exit: 0
step o2: built
exit: 0
stdout: = parallel_adapters_take_named_module_functions.out
