// SourceLocation.display is `file:line:column`, for a written location and for
// `$here`, and interpolation shows the same text.
run: fn() {
    written: SourceLocation{file: "Main.jet", line: 12, column: 5, function: "run"}
    print("written: {written.display()}")
    here: $here
    print("here: {here.display()}")
    shown: "{written}"
    print("same as interpolation: {written.display() == shown}")
}
