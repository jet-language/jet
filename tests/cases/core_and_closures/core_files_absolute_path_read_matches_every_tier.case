# Port of tests/tir_core_and_closures.rs:137-200: core.files reads a tree by
# absolute path, and every tier prints the same bytes (I9). The case writes its
# own tree into scratch and passes its absolute path.
fixture: core_files_absolute_path_read_matches_every_tier.fixture
mkdir: tree/nested
write: tree/notes.txt = "absolute read\n"
write: tree/nested/deep.txt = "nested read\n"
write: tree/zeta.txt = "last\n"
env: NO_COLOR=1
step release: jet run --release --allow=FS.Read read.jet -- {work}/tree
exit: 0
stdout: = "absolute read\nnested,notes.txt,zeta.txt\nnested read\n"
step default: jet run --allow=FS.Read read.jet -- {work}/tree
exit: 0
stdout: == release
step interpret: jet dev --allow=FS.Read read.jet --watch=off -- {work}/tree
exit: 0
stdout: == release
