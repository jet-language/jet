stderr: empty
step: jet run -O1 run.jet
exit: 0
stdout: = "5.75\n5.75\nb199!\n3\nTuring 42\nLovelace!\nlabel new 199\n7\n"
stderr: empty
step: jet run --release run.jet
exit: 0
stdout: = "5.75\n5.75\nb199!\n3\nTuring 42\nLovelace!\nlabel new 199\n7\n"
