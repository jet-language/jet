Person: struct {
    name: String
    age: Int
}

Shape: enum {
    Dot
    Circle(radius: Int)
    Label(text: String)
}

shape_text: fn(shape: Shape) -> String {
    if shape == {
        .Dot -> "dot"
        .Circle(radius) -> "circle {radius}"
        .Label(text) -> "label {text}"
    }
}

run: fn() {
    amounts := [1.5, 2.5, 3.5]
    first: &amounts[0]
    first = 4.5
    first += 1.25
    print(first)
    print(amounts[0])

    words := ["a", "b", "c"]
    loop round in 0..<200 {
        word: &words[1]
        word = "b{round}"
        word += "!"
    }
    print(words[1])
    print(words.len())

    people := [Person{name: "Ada", age: 36}, Person{name: "Alan", age: 41}]
    person: &people[1]
    person.age += 1
    person.name = "Turing"
    print("{people[1].name} {people[1].age}")
    name: &people[0].name
    name = "Lovelace"
    name += "!"
    print(people[0].name)

    shapes := [Shape.Dot, Shape.Label{text: "old"}]
    loop round in 0..<200 {
        shape: &shapes[1]
        shape = Shape.Circle{radius: round}
        shape = Shape.Label{text: "new {round}"}
    }
    print(shape_text(shapes[1]))

    maybe := [Int?]{Val(1), None}
    slot: &maybe[1]
    slot = Val(7)
    print(maybe[1] ?? 0)
}
