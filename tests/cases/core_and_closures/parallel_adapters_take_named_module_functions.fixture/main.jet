#Error
struct Bad {
    at: Int
}

fn double(n: Int) -> Int { n * 2 }
fn even(n: Int) -> Bool { n % 2 == 0 }
fn zero() -> Int { 0 }
fn add(acc: Int, n: Int) -> Int { acc + n }
fn even_n(n: Int) -> Bool Never! { n % 2 == 0 }
fn pick(n: Int) -> Bool Bad! {
    if n == 130 || n == 70 || n == 200 -> return Err(Bad{at: n})
    Ok(n % 3 == 0)
}
fn step(acc: Int, n: Int) -> Int Bad! {
    if n == 150 || n == 90 -> return Err(Bad{at: n})
    Ok(acc + n)
}
fn seed() -> Int Bad! { Ok(0) }
fn merge(left: Int, right: Int) -> Int Bad! { Ok(left + right) }

fn show_list(label: String, value: [Int] Bad!) {
    if value == {
        .Ok(v) -> print("{label} ok {v.len()} {v.first()} {v.last()}")
        .Err(e) -> print("{label} err {e.at}")
    }
}

fn show_fold(label: String, value: Int Bad!) {
    if value == {
        .Ok(v) -> print("{label} ok {v}")
        .Err(e) -> print("{label} err {e.at}")
    }
}

fn run() {
    xs :: [Int]{1, 2, 3, 4, 5}
    print("{xs.para_map(double)} {xs.map(double)}")
    print("{xs.para_filter(even)} {xs.filter(even)}")
    print("{xs.para_partition(even)}")
    print("{xs.para_filter(even_n)} {xs.para_partition(even_n)}")
    print("{xs.para_fold(zero, add, add)} {xs.fold(0, (a: Int, n: Int) -> a + n)}")
    big := [Int]{}
    loop i in 0..<256 -> &big.push(i)
    show_list("filter", big.para_filter(pick))
    small :: [Int]{1, 2, 3, 6, 9}
    show_list("filter-ok", small.para_filter(pick))
    if big.para_partition(pick) == {
        .Ok(v) -> print("partition ok {v.true_.len()}")
        .Err(e) -> print("partition err {e.at}")
    }
    if small.para_partition(pick) == {
        .Ok(v) -> print("partition-ok {v.false_} {v.true_}")
        .Err(e) -> print("partition-ok err {e.at}")
    }
    show_fold("fold", big.para_fold(seed, step, merge))
    show_fold("fold-ok", small.para_fold(seed, step, merge))
    show_fold("fold-mixed", big.para_fold(() -> 0, step, (a: Int, b: Int) -> a + b))
    show_fold("fold-empty", ([Int]{}).para_fold(seed, step, merge))
    print("total {big.para_fold(zero, add, add)}")
}
