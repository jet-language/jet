// #6085: `para_map(f, limit: n)` spreads 100 items over its workers in
// chunks shorter than 64. The result keeps source order for every limit, and
// of several failing items the lowest index is the one reported.
tripled: fn(n: Int) -> Int { return n * 3 + 1 }

checked: fn(n: Int) -> Int {
    if n == 37 || n == 70 || n == 99 { assert(false, "item-{n}") }
    return n
}

run: fn() {
    values := [Int]{}
    loop i in 0..<100 -> &values.push(i)
    serial: values.map((n: Int) -> tripled(n))
    limits: [Int]{ 0, 1, 7, 32, 100, 200 }
    loop limit in limits {
        mapped: values.para_map((n: Int) -> tripled(n), limit: limit)
        print("limit {limit}: {mapped.len()} {mapped.first()} {mapped.last()} {mapped == serial}")
    }
    ignored: values.para_map((n: Int) -> checked(n), limit: 32)
    print("unreachable {ignored.len()}")
}
