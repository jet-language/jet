use {
    files: core.files
    process: core.process
}

// Reads the tree named by an absolute path: one file's text and the sorted
// entry names, so every tier must agree on both.
run: fn() {
    root: process.args()[0]
    text: files.read(files.join(root, "notes.txt")) ?? panic("read notes.txt: {err}")
    print(text.trim())
    entries: files.list_dir(root) ?? panic("list {root}: {err}")
    names := loop entry in entries -> entry.name
    &names.sort()
    print(names.join(","))
    nested: files.read(files.join(root, "nested/deep.txt")) ?? panic("read nested/deep.txt: {err}")
    print(nested.trim())
}
