
TOKEN :: [Int]{65}
PAYLOAD :: [Int]{17}
ALIAS_VALUES :: [Int]{31}

fn token_at(index: Int) -> Int {
    return TOKEN[index]
}

fn payload_at(index: Int) -> Int {
    return PAYLOAD[index]
}

fn alias_value_list() -> [Int] {
    return ALIAS_VALUES
}

fn shadowed(token: [Int]) -> Int {
    return token[0]
}
