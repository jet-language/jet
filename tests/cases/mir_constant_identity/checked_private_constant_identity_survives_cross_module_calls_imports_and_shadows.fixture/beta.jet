
TOKEN :: [Int]{66}
PAYLOAD :: [U8]{84}
ALIAS_VALUES :: [U8]{42}
IMPORT_VALUES :: [U8]{43}

fn token_at(index: Int) -> Int {
    return TOKEN[index]
}

fn payload_at(index: Int) -> U8 {
    return PAYLOAD[index]
}

fn alias_value_list() -> [U8] {
    return ALIAS_VALUES
}

fn import_value_list() -> [U8] {
    return IMPORT_VALUES
}
