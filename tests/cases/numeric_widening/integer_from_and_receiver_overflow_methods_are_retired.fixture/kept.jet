// Between whole-number types the typed literal is the one conversion; the
// non-integer crossings and a distinct type's conversions from its base stay.
UserID: distinct U16

run: fn() {
    small: U8{200}
    wide: U64{small} * U64{1000}
    print(wide)
    print(checked(U8{wide}) ?? U8{0})
    print(wrapping(small + U8{100}))
    print(saturating(small + U8{100}))
    print(checked(small + U8{100}) ?? U8{0})
    print(F32.from_int(3))
    print(saturating(Int{Float{4.75}}))
    print(UserID.from_u8(small).raw())
}
