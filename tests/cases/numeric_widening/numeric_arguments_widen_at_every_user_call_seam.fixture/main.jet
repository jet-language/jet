
NumericSink: trait {
    accept: fn(self, value: Float) -> Float
}

Holder: struct {
    seed: Int
}

impl Holder.NumericSink {
    accept: fn(self, value: Float) -[]> Float {
        return value
    }
}

impl Holder {
    instance: fn(self, value: Float) -[]> Float {
        return value
    }

    static: fn(value: Float) -[]> Float {
        return value
    }
}

numeric_helpers: module {
    accept: fn(value: Float) -[]> Float {
        return value
    }
}

accept_float: fn(value: Float) -[]> Float {
    return value
}

run: fn() {
    narrow: I32{7}
    holder: Holder{seed: 0}
    callback: accept_float

    print(holder.instance(narrow) == 7.0)
    print(Holder.static(narrow) == 7.0)
    print(callback(narrow) == 7.0)
    print(&numeric_helpers.accept(narrow) == 7.0)
    print(&holder.accept(narrow) == 7.0)
    widened: [accept_float(narrow)]
    print(widened[0] == 7.0)
}
