# `wrapping`, `saturating` and `checked` around a narrowing typed-literal
# conversion keep the low bits, clamp to the destination's bounds, or give None
# for a value that doesn't fit, from a fixed width and from an Int, in every sign
# class; a value that fits converts unchanged; and a word covers only the
# conversion it is written around, so an inner conversion still stops. Every
# optimization level agrees.
fixture: fixed_narrowing_words_choose_the_outcome.fixture
env: NO_COLOR=1
step: jet run -O0 run.jet
exit: 0
stdout: = fixed_narrowing_words_choose_the_outcome.out
step: jet run -O0 run.jet -- inner
exit: nonzero # the inner conversion stops
stdout: empty
stderr: ~ "Stop [E3010]: `Value doesn't fit in destination type`" # the unwrapped inner conversion
stderr: ~ "run.jet:18" # at the conversion's line
step: jet run -O1 run.jet
exit: 0
stdout: = fixed_narrowing_words_choose_the_outcome.out
step: jet run -O1 run.jet -- inner
exit: nonzero # the inner conversion stops
stdout: empty
stderr: ~ "Stop [E3010]: `Value doesn't fit in destination type`" # the unwrapped inner conversion
stderr: ~ "run.jet:18" # at the conversion's line
step: jet run -O2 run.jet
exit: 0
stdout: = fixed_narrowing_words_choose_the_outcome.out
step: jet run -O2 run.jet -- inner
exit: nonzero # the inner conversion stops
stdout: empty
stderr: ~ "Stop [E3010]: `Value doesn't fit in destination type`" # the unwrapped inner conversion
stderr: ~ "run.jet:18" # at the conversion's line
