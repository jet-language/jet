
take_i16: fn(value: I16) -[]> I16 {
    return value
}

return_i16: fn(value: I8) -[]> I16 {
    return value
}

increment: fn(value: I32) -[]> I32 {
    return value + 1
}

run: fn() {
    small: I8{1}
    wide: I16{2}
    _: small + wide
    _: 1 + wide
    _: wide + 1
    _: take_i16(small)
    _: return_i16(small)
    assigned := I16{0}
    assigned = small
    narrow_decimal: F32{1.5}
    wide_decimal: Float{2.5}
    _: narrow_decimal + wide_decimal
}
