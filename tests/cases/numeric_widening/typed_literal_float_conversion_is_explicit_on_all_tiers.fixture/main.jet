use math: core.math
run: fn() {
    positive: Float{1.5}
    negative: Float{-1.5}
    print(Int{math.round(positive)})
    print(Int{math.round(negative)})
    print(Int.from_float(positive) ?? panic("finite conversion"))
    print(Int.from_float(negative) ?? panic("finite conversion"))
    print(Float{7})
}
