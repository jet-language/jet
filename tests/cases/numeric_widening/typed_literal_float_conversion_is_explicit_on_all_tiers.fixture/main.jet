use core.math as math
fn run() {
    positive :: Float{1.5}
    negative :: Float{-1.5}
    print(math.round(positive))
    print(math.round(negative))
    print(Int.from_float(positive) ?? panic("finite conversion"))
    print(Int.from_float(negative) ?? panic("finite conversion"))
    print(Float{7})
}
