fn run() {
    exact :: Int{9007199254740992}
    called :: Float.from_int(exact)
    braced :: Float{exact}
    print(called == braced)
    small :: I32{16777215}
    called_small :: Float.from_i32(small)
    braced_small :: Float{small}
    print(called_small == braced_small)
    single :: Int{16777216}
    called_single :: F32.from_int(single)
    braced_single :: F32{single}
    print(called_single == braced_single)
    lossy :: Int{9007199254740993}
    print(approx(lossy) == 9007199254740992.0)
}
