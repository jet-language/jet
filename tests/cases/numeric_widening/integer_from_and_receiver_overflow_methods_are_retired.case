# Between two whole-number types `T{x}` widens and `checked(T{x})` narrows;
# the `from_<int>` statics on the built-in integer owners are gone. The fixed
# receiver methods `wrapping_add` and kin are gone too: the `wrapping(...)`,
# `saturating(...)` and `checked(...)` words are the one spelling. The F32 and
# Float heads' crossings and a distinct type's conversions from its base stay.
fixture: integer_from_and_receiver_overflow_methods_are_retired.fixture
env: NO_COLOR=1
step: jet run kept.jet
exit: 0
stdout: = "200000\n0\n44\n255\n0\n3.0\n4\n200\n"
step: jet check from.jet
exit: 1
stderr: ~ "`U64` has no static method `from_u8`"
step: jet check method.jet
exit: 1
stderr: ~ "wrapping_add"
