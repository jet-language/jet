
fn run() {
    byte :: U8{1}
    signed :: I8{1}
    left :: byte + 256
    right :: 256 + byte
    print(left == U16{257})
    print(right == U16{257})
    print((signed + 1) == I8{2})
    print((1 + signed) == I8{2})
    print((byte + 1) == U8{2})
    print((1 + byte) == U8{2})
    print((I8{0} + 127) == I8{127})
    print((I16{0} + 128) == I16{128})
    print((I8{0} + -128) == I8{-128})
    print((I16{0} + -129) == I16{-129})
    print((U64{0} + 9223372036854775807) == U64{9223372036854775807})
}

