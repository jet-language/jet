# `Float.from_int(n)` and `Float{n}` cross a whole number into
# Float by one rule (D-NUMWIDEN-CROSS1): an exact value converts, 2^53 + 1
# stops with E3010 at run time on every optimization level, a literal with no
# exact Float is E1003 at compile time, and `approx(n)` is the rounding spelling.
fixture: float_from_int_and_float_braces_follow_one_crossing_rule.fixture
env: NO_COLOR=1
step: jet run -O0 exact.jet
exit: 0
stdout: = float_from_int_and_float_braces_follow_one_crossing_rule.out
step: jet run -O1 exact.jet
exit: 0
stdout: = float_from_int_and_float_braces_follow_one_crossing_rule.out
step: jet run -O2 exact.jet
exit: 0
stdout: = float_from_int_and_float_braces_follow_one_crossing_rule.out
step: jet run -O0 from_int.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # the stop names the crossing rule
stderr: ~ "from_int.jet:3" # the stop names the call's line
step: jet run -O1 from_int.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # the stop names the crossing rule
stderr: ~ "from_int.jet:3" # the stop names the call's line
step: jet run -O2 from_int.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # the stop names the crossing rule
stderr: ~ "from_int.jet:3" # the stop names the call's line
step: jet run -O0 braces.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # braces cross the same rule
step: jet run -O1 braces.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # braces cross the same rule
step: jet run -O2 braces.jet
exit: 70
stdout: empty
stderr: ~ "whole number has no exact Float; approx(x) rounds it to the nearest Float" # braces cross the same rule
step: jet run from_int_literal.jet
exit: nonzero
stderr: ~ "[E1003]" # a literal crossing is a compile error
step: jet run braces_literal.jet
exit: nonzero
stderr: ~ "[E1003]" # a literal crossing is a compile error
