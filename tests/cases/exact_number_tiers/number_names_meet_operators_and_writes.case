# #6325 c3: a name for a number meets an operator or a write the way its
# number would. `rate: 0.5` times the Float `price` reads as the Float 0.5,
# on either side. A `:=` number name whose type no use has decided takes the
# type of a typed value written to it (`total = price`, `sum += price`) or
# met by an operator (`mixed + price`): each is a Float. A pair an operator
# already combines keeps the default: `count := 0` stays an Int, and
# `exact * 2` stays the Decimal 5.0. Each tier prints the same values.
fixture: number_names_meet_operators_and_writes.fixture
step: jet check run.jet
exit: 0
step: jet run --optimize=none run.jet
exit: 0
stdout: = number_names_meet_operators_and_writes.out
step: jet run --optimize=basic run.jet
exit: 0
stdout: = number_names_meet_operators_and_writes.out
step: jet run --optimize=full run.jet
exit: 0
stdout: = number_names_meet_operators_and_writes.out
