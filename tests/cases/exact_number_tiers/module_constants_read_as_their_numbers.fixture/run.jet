half: fn(x: Float) -> Float { x * 0.5 }

exact: fn(x: Decimal) -> Decimal { x * 2 }

small: fn(x: U8) -> U8 { x }

LIMIT: 200

RATE: 0.5

run: fn() {
    print(small(LIMIT))
    print(LIMIT + 1)
    print(exact(RATE))
    cost: exact(1.5)
    print(cost * RATE)
    print(RATE * cost)
    print(half(1.0) * RATE)
}
