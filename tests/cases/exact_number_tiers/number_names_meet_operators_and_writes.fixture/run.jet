half: fn(x: Float) -> Float { x * 0.5 }

run: fn() {
    rate: 0.5
    price: half(3.0)
    print(price * rate)
    print(rate * price)
    total := 0.0
    total = price
    print(total)
    sum := 0.0
    sum += price
    sum += half(price)
    print(sum)
    mixed := 0.0
    print(mixed + price)
    count := 0
    count += 1
    count = count + 2
    print(count)
    exact: 2.5
    print(exact * 2)
}
