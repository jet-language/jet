# A name for a number reads as its number would. `y: 2.5` passed
# to a Float parameter reads as the Float 2.5 and to a Decimal one as the
# Decimal 2.5. `n: 200` passed to a U8 parameter reads as the U8 200, and
# elsewhere it stays an Int. `twice: y * 2` keeps `2.5 * 2`. A `:=` name
# takes the type of the first use that refuses its default: `speed := 1.5`
# is a Float because `advance` takes one. Each tier prints the same values.
fixture: number_names_take_the_type_of_their_use.fixture
step: jet check run.jet
exit: 0
step: jet run -O0 run.jet
exit: 0
stdout: = number_names_take_the_type_of_their_use.out
step: jet run -O1 run.jet
exit: 0
stdout: = number_names_take_the_type_of_their_use.out
step: jet run -O2 run.jet
exit: 0
stdout: = number_names_take_the_type_of_their_use.out
