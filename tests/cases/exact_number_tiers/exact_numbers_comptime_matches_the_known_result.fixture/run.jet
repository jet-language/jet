
takes: fn(v: Float) {
    print(v)
}

THIRD: #run { 1 / 3 }
ROUNDTRIP: #run { THIRD * 3 }
DECIMAL: #run { 0.1 + 0.2 }
FAST: #run { Float{19.99} }

run: fn() {
    print(THIRD)
    print(ROUNDTRIP == 1)
    print(DECIMAL == 0.3)
    print(FAST)
    takes(3.4)
    decimal: 3.4
    print("dec={decimal}")
    print(decimal)
}
