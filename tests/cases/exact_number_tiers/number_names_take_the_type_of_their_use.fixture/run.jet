half: fn(x: Float) -> Float { x * 0.5 }
exact: fn(x: Decimal) -> Decimal { x * 2 }
small: fn(x: U8) -> U8 { x }
advance: fn(x: Float, by: Float) -> Float { x + by }

run: fn() {
    y: 2.5
    print(half(y))
    print(exact(y))
    n: 200
    print(small(n))
    print(n + 1)
    twice: y * 2
    print(half(twice))
    speed := 1.5
    speed = advance(speed, 0.5)
    speed = advance(speed, 0.25)
    print(speed)
}
