#CLI
GreetingArgs: struct {
    #Doc("name to greet") name: String{"world"}
}

#Comparable
Score: struct {
    value: Int
}

Node: struct {
    value: Int
    next: Node?
}

comparable_max: fn<T: Comparable>(left: T, right: T) -> T {
    if right > left -> return right
    left
}

greeting: fn(name: String) -> String { "hello, {name}" }

run: fn(args: GreetingArgs) {
    print(greeting(args.name))
    best: comparable_max(Score{value: 3}, Score{value: 5})
    print(best.value)
    node: Node{value: 7, next: None}
    print(node.value)
}

#Test("the greeting stays stable") {
    assert_eq(greeting("world"), "hello, world")
}
