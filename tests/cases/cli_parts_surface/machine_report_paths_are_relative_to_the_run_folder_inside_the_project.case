# A jet.report/v3 `file` is relative to the folder jet ran in when the file is
# under it, takes `../` steps to another file of the project that folder is
# in, and stays absolute for a file outside that project.
fixture: fixtures/paths
mkdir: repo/.git
mkdir: repo/tools
step: jet check src/bad.jet --json
cwd: repo
env: NO_COLOR=1
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $ valid # parses
json: stdout doc $.reports[0].file = "src/bad.jet"
step: jet check {work}/repo/src/bad.jet --json
cwd: repo
env: NO_COLOR=1
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $ valid # parses
json: stdout doc $.reports[0].file = "src/bad.jet"
step: jet check ../src/bad.jet --json
cwd: repo/tools
env: NO_COLOR=1
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $ valid # parses
json: stdout doc $.reports[0].file = "../src/bad.jet"
step: jet check {work}/outside/bad.jet --json
cwd: repo/tools
env: NO_COLOR=1
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $ valid # parses
json: stdout doc $.reports[0].file = "{work}/outside/bad.jet"
