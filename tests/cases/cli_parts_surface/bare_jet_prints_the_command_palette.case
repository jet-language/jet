# Bare `jet` prints the command palette and exits 0; with no terminal it is the
# same static text and never touches `/dev/tty`. Only `jet repl` starts the
# REPL (with no input it prints its banner and ends), and `?` is an ordinary
# unknown command (E2101).
env: NO_COLOR=1
step: jet
exit: 0
stdout: = bare_jet_palette.txt
stderr: !~ "/dev/tty" # the palette needs no terminal
step: jet --color=never
exit: 0
stdout: = bare_jet_palette.txt
step: jet repl
exit: 0
stdout: ~ "Jet 0.1.0 — Interactive REPL" # the one REPL entry
stderr: !~ "E2104" # the REPL is built, not the registered refusal
step: jet ?
exit: 2
stderr: ~ "Error [jet.UnknownCommand]: `?` isn't a jet command." # no `?` alias
