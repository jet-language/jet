Rect: struct {
    width: Int
    height: Int
}

area: fn(rect: Rect) -> Int {
    rect.width * rect.height
}

run: fn() {
    rects: [Rect]{Rect{width: 3, height: 4}, Rect{width: 3, height: 3}}
    total := 0
    loop rect in rects {
        total += area(rect)
        print("area {area(rect)}")
    }
    print("total {total}")
}
