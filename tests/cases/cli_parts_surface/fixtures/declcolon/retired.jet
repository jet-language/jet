use math :: core.math

limit :: 3

struct Point {
    x: Int
    y: Int
}

enum Mode {
    Fast
    Slow
}

trait Shape {
    fn area(self) -> Int
}

impl Point.Shape {
    fn area(self) -> Int { self.x * self.y }
}

module geometry {
    fn twice(value: Int) -> Int { value * 2 }
}

fn run() {
    point :: Point{x: limit, y: 2}
    mode :: Mode.Fast
    if mode == .Fast -> print("{math.abs(0 - geometry.twice(point.area()))}")
}
