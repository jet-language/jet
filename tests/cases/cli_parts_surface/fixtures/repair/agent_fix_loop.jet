// Line-for-line semantic port of surface.rs:1291-1577 (real CLI callback, no synthetic provider).
// The expected published status/report schemas are original v1/v2, never widened.
use core.files as files
use core.process as process
use core.sys as sys
use core.encoding as encoding
use core.encoding.json as json

struct S1RepairFile { path: String, source: String }
struct S1RepairEdit { code: String, file: String, start: Int, end: Int, new_text: String }
struct S1RepairReport { code: String, edits: [S1RepairEdit] }
struct S1RepairDone { state: [S1RepairFile], rounds: Int }

fn s1_repair_field(tree: encoding.Dyn, key: String) -> encoding.Dyn {
    &tree.field(key) ?? panic("machine report missing {key}")
}
fn s1_repair_string(tree: encoding.Dyn, key: String) -> String {
    value :: s1_repair_field(tree, key)
    value.text() ?? panic("machine report {key} is not a string")
}
fn s1_repair_usize(tree: encoding.Dyn, key: String) -> Int {
    value :: s1_repair_field(tree, key)
    number :: value.int() ?? panic("machine report {key} is not an integer")
    assert(number >= 0, "machine report {key} is negative")
    number
}
fn s1_repair_array(value: encoding.Dyn) -> [encoding.Dyn] {
    if value == {
        .Array(items) -> return items
        else -> panic("machine status reports/fix_edits is not an array")
    }
}
fn s1_repair_parse_report(value: encoding.Dyn) -> S1RepairReport {
    // surface.rs1327: exact original schema, even if the live head differs.
    assert_eq(s1_repair_string(value, "schema"), "jet.report/v2")
    code :: s1_repair_string(value, "code")
    edits := [S1RepairEdit]{}
    loop edit in s1_repair_array(s1_repair_field(value, "fix_edits")) {
        span :: s1_repair_field(edit, "span")
        &edits.push(S1RepairEdit{
            code: code.copy(), file: s1_repair_string(edit, "file"),
            start: s1_repair_usize(span, "start"), end: s1_repair_usize(span, "end"),
            new_text: s1_repair_string(edit, "new_text"),
        })
    }
    S1RepairReport{code: code, edits: edits}
}
fn s1_repair_parse_reports(status: encoding.Dyn) -> [S1RepairReport] {
    assert_eq(s1_repair_string(status, "schema"), "jet.status/v1")
    assert_eq(s1_repair_string(status, "action"), "check")
    loop value in s1_repair_array(s1_repair_field(status, "reports")) -> s1_repair_parse_report(value)
}
fn s1_repair_check(dir: String, jet: String, state: [S1RepairFile]) -> [S1RepairReport] {
    loop file in state -> files.write(file.path, file.source) ?? panic("fixture write")
    reports := [S1RepairReport]{}
    // state is in BTreeMap path order (helper.jet then run.jet).
    loop file in state {
        output :: process.cmd([String]{jet, "check", file.path, "--json"}).cwd(dir).env("NO_COLOR", "1").run() ?? panic("check spawn")
        assert_eq(output.errors, "", "JSON check wrote stderr")
        status :: json.parse(output.output.trim().copy()) ?? panic("JSON check must emit one status object")
        assert_eq(s1_repair_string(status, "schema"), "jet.status/v1")
        assert_eq(s1_repair_string(status, "action"), "check")
        rows :: s1_repair_parse_reports(status)
        if output.success {
            assert_eq(s1_repair_field(status, "ok"), encoding.Dyn.Bool(true))
            assert_eq(rows.len(), 0, "clean check must have no reports")
        } else {
            assert_eq(output.code, 1, "check failed")
            loop row in rows -> &reports.push(row)
        }
    }
    reports
}
fn s1_repair_same(left: [S1RepairFile], right: [S1RepairFile]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index].path != right[index].path || left[index].source != right[index].source -> return false
    }
    true
}
fn s1_repair_codes(reports: [S1RepairReport]) -> [String] Never! {
    codes := [String]{}
    loop report in reports {
        if !codes.contains(report.code) -> &codes.push(report.code)
    }
    &codes.sort()
    codes
}
fn s1_repair_apply(state: [S1RepairFile], reports: [S1RepairReport]) -> [S1RepairFile] String! {
    // surface.rs1404-1453: group edits by file, reject untracked files, descending spans.
    paths := [String]{}
    loop file in state -> &paths.push(file.path)
    loop report in reports {
        if report.edits.len() == 0 -> return Err("report {report.code} has no fix_edits")
        loop edit in report.edits {
            if !paths.contains(edit.file) -> return Err("fix_edit for {edit.code} names untracked file {edit.file}")
        }
    }
    next_state := [S1RepairFile]{}
    loop file in state {
        edits := [S1RepairEdit]{}
        loop report in reports {
            loop edit in report.edits {
                if edit.file == file.path -> &edits.push(edit)
            }
        }
        &edits.sort_by((left: S1RepairEdit, right: S1RepairEdit) -> {
            order :: right.start <=> left.start
            if order != Ordering.Equal -> return order
            right.end <=> left.end
        })
        loop index in 1..<edits.len() {
            if edits[index - 1].start < edits[index].end {
                return Err("overlapping fix_edits for {edits[index - 1].code} and {edits[index].code} in {file.path}")
            }
        }
        fixed := file.source.bytes()
        loop edit in edits {
            if edit.start > edit.end || edit.end > fixed.len() {
                return Err("invalid span {edit.start}..{edit.end} for fix_edit {edit.code} in {file.path}")
            }
            // String::get(start..end) rejects both non-UTF8 boundaries, even for an empty slice.
            if edit.start < fixed.len() && (Int.from_u8(fixed[edit.start]) & 192) == 128 {
                return Err("invalid span {edit.start}..{edit.end} for fix_edit {edit.code} in {file.path}")
            }
            if edit.end < fixed.len() && (Int.from_u8(fixed[edit.end]) & 192) == 128 {
                return Err("invalid span {edit.start}..{edit.end} for fix_edit {edit.code} in {file.path}")
            }
            replacement := fixed.slice(0, edit.start)
            loop byte in edit.new_text.bytes() -> &replacement.push(byte)
            loop byte in fixed.slice(edit.end, fixed.len()) -> &replacement.push(byte)
            fixed = replacement
        }
        &next_state.push(S1RepairFile{path: file.path, source: String.from_bytes(fixed) ?? panic("fixed source UTF8")})
    }
    Ok(next_state)
}
fn s1_repair_loop(initial: [S1RepairFile], max_rounds: Int, dir: String, jet: String) -> S1RepairDone String! {
    state := initial
    seen := [[S1RepairFile]]{}
    previous_codes := [String]{}
    has_previous := false
    loop round in 0..max_rounds {
        reports :: s1_repair_check(dir, jet, state)
        if reports.len() == 0 -> return Ok(S1RepairDone{state: state, rounds: round})
        codes :: s1_repair_codes(reports)
        loop old in seen {
            if s1_repair_same(old, state) -> return Err("repeated file state; offending code(s): {codes.join(", ")}")
        }
        if has_previous {
            introduced := [String]{}
            loop code in codes {
                if !previous_codes.contains(code) -> &introduced.push(code)
            }
            if introduced.len() != 0 -> return Err("fix_edit regression introduced report code(s): {introduced.join(", ")}")
        }
        if round == max_rounds -> return Err("round bound {max_rounds} exceeded; offending code(s): {codes.join(", ")}")
        &seen.push(state.copy())
        if s1_repair_apply(state, reports) == {
            .Ok(next_state) -> state = next_state
            .Err(error) -> return Err(error)
        }
        previous_codes = codes
        has_previous = true
    }
    panic("repair loop unreachable")
}
#Test("agent fix loop corpus converges without report regression") {
    dir :: sys.current_dir() ?? panic("cwd")
    jet :: sys.get("JET_BIN") ?? panic("JET_BIN")
    initial :: [S1RepairFile]{
        S1RepairFile{path: "{dir}/helper.jet", source: files.read("helper.source") ?? panic("helper fixture")},
        S1RepairFile{path: "{dir}/run.jet", source: files.read("run.source") ?? panic("run fixture")},
    }
    reports :: s1_repair_check(dir, jet, initial)
    counts := [Int]{0, 0}
    loop report in reports {
        // surface.rs1520-1525: every report carries at least one fix edit.
        assert(report.edits.len() != 0, "every fixture report must carry fix_edits")
        loop edit in report.edits {
            found := false
            loop index in 0..<initial.len() {
                if edit.file == initial[index].path {
                    counts[index] = counts[index] + 1
                    found = true
                }
            }
            // surface.rs1530-1534: the edit path set equals the initial state key set.
            assert(found, "one repair-loop round must report edits for every fixture file")
        }
    }
    loop count in counts -> assert(count > 0, "one repair-loop round must report edits for every fixture file")
    assert(counts[1] >= 3, "run.jet needs several errors")
    assert(counts[0] >= 3, "helper.jet needs several errors")
    if s1_repair_loop(initial.copy(), 0, dir, jet) == {
        .Err(error) -> assert(error.contains("round bound 0") && error.contains("E0102"), "bound failure must name offending code")
        .Ok(_) -> panic("expected bound failure")
    }
    result :: s1_repair_loop(initial, 4, dir, jet) ?? panic("repair loop failed")
    assert(result.rounds <= 4)
    assert_eq(s1_repair_check(dir, jet, result.state).len(), 0, "final recheck was not clean")
    // surface.rs1557-1576: exact original final source bytes.
    assert_eq(result.state[1].source, files.read("run-fixed.bytes") ?? panic("run oracle"))
    assert_eq(result.state[0].source, files.read("helper-fixed.bytes") ?? panic("helper oracle"))
}
