# Every failed --json command prints one jet.status/v1 envelope on stdout and
# nothing on stderr (#6035 c44, D-REPORT-MACHINE1): the refusals of a missing
# target file, a missing project, a usage error, an unbuilt command, and an
# engine handshake. The census of these commands printed report text instead.
mkdir: empty
step: jet run --json missing.jet
cwd: empty
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "cli"
json: stdout doc $.ok = false
json: stdout doc $.reports #= 1
json: stdout doc $.reports[0].code = "E2105"
