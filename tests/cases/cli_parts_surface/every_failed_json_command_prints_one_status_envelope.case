# A success uses the same envelope with the command's own action: `jet new`
# names the folder and the files it wrote instead of the human recap.
step: jet new --json demo
cwd: empty
exit: 0
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "new"
json: stdout doc $.ok = true
json: stdout doc $.reports #= 0
json: stdout doc $.new.path = "demo/"
json: stdout doc $.new.files = ["package.jet","run.jet",".gitignore"]
file: empty/demo/package.jet is-file
file: empty/demo/run.jet is-file
# A valid `jet prove` request past the front stops at the unbuilt producer,
# and that refusal is one status line too.
step: jet prove --json demo/run.jet
cwd: empty
exit: 2
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "cli"
json: stdout doc $.ok = false
json: stdout doc $.reports #= 1
json: stdout doc $.reports[0].code = "E2104"
# `jet cc` and `jet c++` own their flag vocabulary, so `--json` there is a
# compiler flag, not a jet one (cc_cli/c_drivers_are_registered_with_one_flag_surface).
# trust, search and env run the jetpack engine, which prints its own reports.
# Jet's own outcome for them is the engine handshake: here a jet with no
# engine beside it or on PATH.
copy: {jet} {tmp}/lone/jet
step: {tmp}/lone/jet trust --json missing.jet
cwd: empty
env: PATH={tmp}/lone
exit: 1
stdout: lines = 1 # one status line
stderr: empty
json: stdout doc $.schema = "jet.status/v1"
json: stdout doc $.action = "cli"
json: stdout doc $.ok = false
json: stdout doc $.reports #= 1
json: stdout doc $.reports[0].code = "E1228"
