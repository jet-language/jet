# #6613: a binding read only inside the arguments of a call that does not
# resolve (an unknown receiver, an unknown member, an unknown function) is
# still used, so `jet fix` leaves it named; no `_value` rename is applied.
fixture: fixtures/unresolved_call
copy: call.jet original.bytes
step: jet fix {work}/call.jet
env: NO_COLOR=1
exit: any # the unresolved calls stay errors; only the file matters
file: call.jet == original.bytes
file: call.jet !~ "_value" # the receiver-less member call's argument
file: call.jet !~ "_count" # the unknown member's argument
file: call.jet !~ "_label" # the unknown function's interpolated argument
