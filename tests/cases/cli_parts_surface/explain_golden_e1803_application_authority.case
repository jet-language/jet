# Port of tests/cli_parts/surface.rs:2164-2179; meaning migrated to the rule that every effect is allowed unless a row denies it (E1803 is a deny).
step: jet explain E1803
env: NO_COLOR=1
exit: 0
stdout: ~ "Application authority denies a required effect" # every effect is allowed, so E1803 is only a deny
stdout: !~ "undecided" # no right waits on a decision: every effect is allowed unless denied
stdout: !~ "REPL host effects" # original predicate
stdout: = explain_E1803.txt
