use math: core.math

limit: 3

Point: struct {
    x: Int
    y: Int
}

Mode: enum {
    Fast
    Slow
}

Shape: trait {
    area: fn(self) -> Int
}

impl Point.Shape {
    area: fn(self) -> Int { self.x * self.y }
}

geometry: module {
    twice: fn(value: Int) -> Int { value * 2 }
}

run: fn() {
    point: Point{x: limit, y: 2}
    mode: Mode.Fast
    if mode == .Fast -> print("{math.abs(0 - geometry.twice(point.area()))}")
}
