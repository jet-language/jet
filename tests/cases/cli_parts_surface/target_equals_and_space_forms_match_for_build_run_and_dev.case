# Port surface.rs6-177; exact first installed nonhost target selection via SETUP-PORT.
# PENDING-SAME-HEAD; PENDING-GRAMMAR(batch-four).
# rustc is exact original SETUP, not an availability guard; revisit when native backend lists targets.
requires: tool:rustc
fixture: fixtures/targets
step select: jet run select_target.jet
exit: 0 # original predicate: expect installed non-host target
capture: target = text stdout.trim
step build_equals: jet build main.jet --target={cap:target}
cwd: build_equals
env: NO_COLOR=1
exit: 0
step: jet build main.jet --target {cap:target}
cwd: build_space
env: NO_COLOR=1
exit: 0
stdout: == build_equals
stderr: == build_equals
step build_unknown: jet build main.jet --target=definitely-not-a-rust-target
cwd: build_unknown_equals
env: NO_COLOR=1
exit: 1
stderr: ~ "Error [E3302]:" # original predicate
stderr: = unknown_target_e3302.txt
step: jet build main.jet --target definitely-not-a-rust-target
cwd: build_unknown_space
env: NO_COLOR=1
exit: 1
stderr: == build_unknown
step: jet build main.jet --target
cwd: build_missing_space
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
step: jet build main.jet --target=
cwd: build_missing_equals
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
step run_equals: jet run main.jet --target={cap:target}
cwd: run_equals
env: NO_COLOR=1
exit: 0
step: jet run main.jet --target {cap:target}
cwd: run_space
env: NO_COLOR=1
exit: 0
stdout: == run_equals
stderr: == run_equals
step run_unknown: jet run main.jet --target=definitely-not-a-rust-target
cwd: run_unknown_equals
env: NO_COLOR=1
exit: 1
stderr: ~ "Error [E3302]:" # original predicate
stderr: = unknown_target_e3302.txt
step: jet run main.jet --target definitely-not-a-rust-target
cwd: run_unknown_space
env: NO_COLOR=1
exit: 1
stderr: == run_unknown
step: jet run main.jet --target
cwd: run_missing_space
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
step: jet run main.jet --target=
cwd: run_missing_equals
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
step dev_equals: jet dev main.jet --target={cap:target}
cwd: dev_equals
env: NO_COLOR=1
exit: 0
step: jet dev main.jet --target {cap:target}
cwd: dev_space
env: NO_COLOR=1
exit: 0
stdout: == dev_equals
stderr: == dev_equals
step dev_unknown: jet dev main.jet --target=definitely-not-a-rust-target
cwd: dev_unknown_equals
env: NO_COLOR=1
exit: 1
stderr: ~ "Error [E3302]:" # original predicate
stderr: = unknown_target_e3302.txt
step: jet dev main.jet --target definitely-not-a-rust-target
cwd: dev_unknown_space
env: NO_COLOR=1
exit: 1
stderr: == dev_unknown
step: jet dev main.jet --target
cwd: dev_missing_space
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
step: jet dev main.jet --target=
cwd: dev_missing_equals
env: NO_COLOR=1
exit: 2
stderr: ~ "Error [E2104]:" # original predicate
stderr: ~ "`--target` needs a value" # original predicate
