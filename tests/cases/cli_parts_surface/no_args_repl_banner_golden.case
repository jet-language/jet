# Port of tests/cli_parts/surface.rs:2395-2400; exact original sources/predicates.
# Bare `jet` prints the command palette as static text and never starts the REPL
# (owner ruling 2026-10-28, Docs/spec/syntax-decisions.md:7148).
step: jet 
env: NO_COLOR=1
exit: 0
stdout: ^= "Jet command palette\n" # bare `jet` prints the palette as static text (syntax-decisions.md:7148-7150)
stdout: !~ "user> " # bare `jet` never starts the REPL (syntax-decisions.md:7148-7150)
