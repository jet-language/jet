# Port of tests/cli_parts/surface.rs:1006-1020.
# jet --json reports arrive on stdout in the jet.status/v1 envelope, so the
# golden is stdout and stderr stays empty.
fixture: fixtures/name
step: jet check {work}/name.jet --json
env: NO_COLOR=1
normalize: replace "{work}/name.jet" "BAD.jet"
normalize: replace "name.jet" "BAD.jet"
exit: 1
stdout: = name_suggestion_json.txt # the --json envelope is written to stdout
stderr: empty # nothing but the envelope is printed
