# E0968's fix names source refs that parse today: a nixpkgs channel through
# `@github` or `@jetpack`, never the retired `@nixpkgs` source.
step: jet explain E0968
env: NO_COLOR=1
exit: 0
stdout: ~ "nixos-unstable@jetpack" # the channel through the jetpack index
stdout: ~ "NixOS/nixpkgs/nixos-24.05@github" # the channel through its upstream repository
stdout: !~ "@nixpkgs" # `@nixpkgs` is not a source provider (E1358)
