# TLS on task threads. A core.net.tls server task and four client
# tasks run the Jet TLS engine's handshakes at once, at O0 and O2, under
# `jet run` and as a built program. Each connection owns its engine state and
# its random generator, so the handshakes share nothing; every client
# completes a TLS 1.3 handshake and verifies the server's chain.
fixture: tls_handshakes_from_concurrent_tasks_all_complete.fixture
copy: {root}/tests/fixtures/tls/custom-root.ca.cert.pem ca.pem
copy: {root}/tests/fixtures/tls/custom-root.server.cert.pem server.cert.pem
copy: {root}/tests/fixtures/tls/custom-root.server.key.pem server.key.pem
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step: jet run -O0 main.jet
exit: 0
stdout: = "client 0: localhost TLS13 true\nclient 1: localhost TLS13 true\nclient 2: localhost TLS13 true\nclient 3: localhost TLS13 true\n"
step: jet run -O2 main.jet
exit: 0
stdout: = "client 0: localhost TLS13 true\nclient 1: localhost TLS13 true\nclient 2: localhost TLS13 true\nclient 3: localhost TLS13 true\n"
step: jet build -O0 main.jet
exit: 0
step: built
exit: 0
stdout: = "client 0: localhost TLS13 true\nclient 1: localhost TLS13 true\nclient 2: localhost TLS13 true\nclient 3: localhost TLS13 true\n"
step: jet build -O2 main.jet
exit: 0
step: built
exit: 0
stdout: = "client 0: localhost TLS13 true\nclient 1: localhost TLS13 true\nclient 2: localhost TLS13 true\nclient 3: localhost TLS13 true\n"
