# #6694 c3: Core's TLS interoperates with OpenSSL both ways.
# The client (core.net.tls) completes a handshake with `openssl s_server`, verifies
# its chain and name, and exchanges a line, for every suite, group and signature
# family of Core's pinned policy:
# - TLS 1.3 with AES-128-GCM, AES-256-GCM and ChaCha20-Poly1305.
# - A HelloRetryRequest to P-384, and P-256 (the servers name the group they used).
# - TLS 1.2 ECDHE-ECDSA and ECDHE-RSA with AES-GCM and ChaCha20-Poly1305.
# - RSA-PSS and ECDSA server certificates.
# - A client certificate on TLS 1.3 and TLS 1.2, which the server verifies.
# - ALPN against a server that selects h2.
# - SNI: the server's default certificate is self-signed and untrusted, and only
#   the name `localhost` selects the trusted one, so the row passes only if the
#   client sent that name.
# The server (core.http.server over core.net.tls) answers `openssl s_client` on
# TLS 1.3 with each suite and P-384, and on TLS 1.2 with ECDHE-ECDSA and
# ECDHE-RSA, and s_client verifies its chain and name.
requires: tool:openssl
fixture: tls_interoperates_with_openssl_servers_and_clients.fixture
copy: {root}/tests/fixtures/tls/custom-root.ca.cert.pem rsa-ca.pem
copy: {root}/tests/fixtures/tls/custom-root.server.cert.pem rsa.cert.pem
copy: {root}/tests/fixtures/tls/custom-root.server.key.pem rsa.key.pem
copy: {root}/tests/fixtures/tls/ec-root.ca.cert.pem ec-ca.pem
copy: {root}/tests/fixtures/tls/ec-root.server.cert.pem ec.cert.pem
copy: {root}/tests/fixtures/tls/ec-root.server.key.pem ec.key.pem
copy: {root}/tests/fixtures/tls/localhost.cert.pem client.cert.pem
copy: {root}/tests/fixtures/tls/localhost.key.pem client.key.pem
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
session aes128 raw: openssl s_server -quiet -rev -accept {free-port:aes128} -cert rsa.cert.pem -key rsa.key.pem -tls1_3 -ciphersuites TLS_AES_128_GCM_SHA256
session aes256 raw: openssl s_server -quiet -rev -accept {free-port:aes256} -cert ec.cert.pem -key ec.key.pem -tls1_3 -ciphersuites TLS_AES_256_GCM_SHA384
session chacha raw: openssl s_server -quiet -rev -accept {free-port:chacha} -cert ec.cert.pem -key ec.key.pem -tls1_3 -ciphersuites TLS_CHACHA20_POLY1305_SHA256
session p384 raw: openssl s_server -quiet -rev -accept {free-port:p384} -cert ec.cert.pem -key ec.key.pem -tls1_3 -groups secp384r1
session p256 raw: openssl s_server -quiet -rev -accept {free-port:p256} -cert ec.cert.pem -key ec.key.pem -tls1_3 -groups P-256
session ecdsa12 raw: openssl s_server -quiet -rev -accept {free-port:ecdsa12} -cert ec.cert.pem -key ec.key.pem -tls1_2 -cipher ECDHE-ECDSA-AES128-GCM-SHA256
session rsa12 raw: openssl s_server -quiet -rev -accept {free-port:rsa12} -cert rsa.cert.pem -key rsa.key.pem -tls1_2 -cipher ECDHE-RSA-AES256-GCM-SHA384
session chacha12 raw: openssl s_server -quiet -rev -accept {free-port:chacha12} -cert rsa.cert.pem -key rsa.key.pem -tls1_2 -cipher ECDHE-RSA-CHACHA20-POLY1305
session mtls13 raw: openssl s_server -quiet -rev -accept {free-port:mtls13} -cert ec.cert.pem -key ec.key.pem -tls1_3 -Verify 1 -CAfile client.cert.pem -verify_return_error
session mtls12 raw: openssl s_server -quiet -rev -accept {free-port:mtls12} -cert ec.cert.pem -key ec.key.pem -tls1_2 -Verify 1 -CAfile client.cert.pem -verify_return_error
session alpn raw: openssl s_server -quiet -rev -accept {free-port:alpn} -cert ec.cert.pem -key ec.key.pem -tls1_3 -alpn h2
session sni raw: openssl s_server -quiet -rev -accept {free-port:sni} -cert client.cert.pem -key client.key.pem -servername localhost -cert2 ec.cert.pem -key2 ec.key.pem -servername_fatal -tls1_3
sleep: 250ms
write: client/main.jet tls_interoperates_with_openssl_servers_and_clients.fixture/client.template
write: server/main.jet tls_interoperates_with_openssl_servers_and_clients.fixture/server.template
step client: jet build client/main.jet
exit: 0
step client_run: built
exit: 0
stdout: = tls_interoperates_with_openssl_servers_and_clients.client.out
step server: jet build server/main.jet
exit: 0
session srv raw: built
recv srv until = "ready\n"
stdout: = "ready\n"
step s_client_aes128: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_rsa} -servername localhost -CAfile rsa-ca.pem -verify_return_error -tls1_3 -ciphersuites TLS_AES_128_GCM_SHA256
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Ciphersuite: TLS_AES_128_GCM_SHA256" # s_client's connection summary
stderr: ~ "Verification: OK" # s_client verified the RSA chain and the name
step s_client_aes256: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_ec} -servername localhost -CAfile ec-ca.pem -verify_return_error -tls1_3 -ciphersuites TLS_AES_256_GCM_SHA384
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Ciphersuite: TLS_AES_256_GCM_SHA384" # s_client's connection summary
stderr: ~ "Verification: OK" # s_client verified the ECDSA chain and the name
step s_client_chacha: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_ec} -servername localhost -CAfile ec-ca.pem -verify_return_error -tls1_3 -ciphersuites TLS_CHACHA20_POLY1305_SHA256
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Ciphersuite: TLS_CHACHA20_POLY1305_SHA256" # s_client's connection summary
stderr: ~ "Verification: OK" # s_client verified the ECDSA chain and the name
step s_client_p384: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_ec} -servername localhost -CAfile ec-ca.pem -verify_return_error -tls1_3 -groups secp384r1
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Peer Temp Key: ECDH, secp384r1, 384 bits" # s_client's connection summary: the server's key share
stderr: ~ "Verification: OK" # s_client verified the ECDSA chain and the name
step s_client_ecdsa12: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_ec} -servername localhost -CAfile ec-ca.pem -verify_return_error -tls1_2 -cipher ECDHE-ECDSA-AES128-GCM-SHA256
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Ciphersuite: ECDHE-ECDSA-AES128-GCM-SHA256" # s_client's connection summary
stderr: ~ "Verification: OK" # s_client verified the ECDSA chain and the name
step s_client_rsa12: openssl s_client -brief -ign_eof -connect 127.0.0.1:{free-port:srv_rsa} -servername localhost -CAfile rsa-ca.pem -verify_return_error -tls1_2 -cipher ECDHE-RSA-CHACHA20-POLY1305
stdin: request.http
exit: 0
stdout: ~ "pong" # the server's response body
stderr: ~ "Ciphersuite: ECDHE-RSA-CHACHA20-POLY1305" # s_client's connection summary
stderr: ~ "Verification: OK" # s_client verified the RSA chain and the name
signal srv: KILL
close srv
exit: any # the case stops the server; its exit status is not part of the contract
signal aes128: KILL
close aes128
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal aes256: KILL
close aes256
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal chacha: KILL
close chacha
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal p384: KILL
close p384
exit: any # killed; each OpenSSL server's exit status is not part of the contract
stderr: ~ "Peer Temp Key: ECDH, secp384r1, 384 bits" # the client retried with P-384 after the HelloRetryRequest
signal p256: KILL
close p256
exit: any # killed; each OpenSSL server's exit status is not part of the contract
stderr: ~ "Peer Temp Key: ECDH, prime256v1, 256 bits" # the client's key share was P-256
signal ecdsa12: KILL
close ecdsa12
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal rsa12: KILL
close rsa12
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal chacha12: KILL
close chacha12
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal mtls13: KILL
close mtls13
exit: any # killed; each OpenSSL server's exit status is not part of the contract
stderr: ~ "Peer certificate: CN=localhost" # s_server verified the client's certificate
signal mtls12: KILL
close mtls12
exit: any # killed; each OpenSSL server's exit status is not part of the contract
stderr: ~ "Peer certificate: CN=localhost" # s_server verified the client's certificate
signal alpn: KILL
close alpn
exit: any # killed; each OpenSSL server's exit status is not part of the contract
signal sni: KILL
close sni
exit: any # killed; each OpenSSL server's exit status is not part of the contract
