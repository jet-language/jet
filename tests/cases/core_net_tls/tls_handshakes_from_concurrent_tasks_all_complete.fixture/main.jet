// #6694: TLS on task threads. A TLS server task and four client tasks run the
// Jet TLS engine at once, each on its own runtime thread; every connection
// owns its engine state, so every handshake completes.
use {
    web: core.web
    files: core.files
    server: core.http.server
    net: core.net
    tls: core.net.tls
}

// One client: its own trust store and config, a TLS 1.3 handshake, a
// request and its response over a fresh connection.
exchange: fn(addr: String, ca: String, index: Int) -> String {
    roots: tls.RootCertificates.from_pem(ca.bytes()) ?? panic("validate CA {index}")
    config: tls.ClientConfig.default()
        .with_trust(.CustomOnly(roots)) ?? panic("trust policy {index}")
    bounded: config.with_version_bounds(min: TLSVersion.TLS13, max: TLSVersion.TLS13) ?? panic("version policy {index}")
    tcp: net.tcp_connect(addr) ?? panic("connect loopback {index}")
    budget: 10s
    secure := tls.client(tcp, server_name: "localhost", config: bounded, deadline: budget) ?? panic("TLS handshake {index}")
    peer: secure.peer_identity()
    version: if tls.is_tls13(peer.tls_version) -> "TLS13" else -> "TLS12"
    crlf: "\r\n"
    secure.write_all("GET / HTTP/1.1{crlf}Host: localhost{crlf}Connection: close{crlf}{crlf}".bytes(), deadline: budget) ?? panic("request {index}")
    reply: secure.read(8192, deadline: budget) ?? panic("response {index}")
    secure.close() ?? panic("close TLS {index}")
    text: String.from_bytes(reply) ?? panic("response text {index}")
    "client {index}: {peer.verified_server_name} {version} {text.starts_with("HTTP/1.1 200")}"
}

run: fn() {
    ca: files.read("ca.pem") ?? panic("CA fixture")
    cert: files.read("server.cert.pem") ?? panic("server certificate fixture")
    key: files.read("server.key.pem") ?? panic("server key fixture")
    mux: web.app()
    mux.get("/", fn(_request: HTTPRequest) { Ok(server.response(200, "ok")) })
    listener: mux.bind("127.0.0.1:0", tls: server.tls(cert, key)) ?? panic("bind TLS server")
    addr: listener.local_addr() ?? panic("server address")
    serving: task { listener.serve() ?? panic("serve TLS") }
    clients := [Task<String>]{}
    loop index in 0..<4 {
        at: addr.copy()
        roots: ca.copy()
        clients.push(task { exchange(at, roots, index) })
    }
    loop client in clients {
        print(client.join() ?? panic("client task"))
    }
    _: listener.shutdown(100ms) ?? panic("shutdown TLS server")
    _: serving.join() ?? panic("join TLS server")
}
