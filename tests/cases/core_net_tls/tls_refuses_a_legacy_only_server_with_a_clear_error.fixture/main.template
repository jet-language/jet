// Core's TLS policy offers TLS 1.3, and TLS 1.2 ECDHE, with AES-GCM or
// ChaCha20-Poly1305 only. Two OpenSSL servers that accept nothing in it, a
// TLS 1.2 server with CBC suites and a TLS 1.3 server with AES-CCM only,
// refuse the handshake, and the client says why.
use {
    files: core.files
    net: core.net
    tls: core.net.tls
}

connect: fn(port: String, config: ClientConfig) -[Net, Time.Wait]> TLSStream NetError! {
    tcp := net.tcp_connect("127.0.0.1:{port}") ?? panic("connect")
    tls.client(tcp, server_name: "localhost", config: config, deadline: 5s)
}

report: fn(result: TLSStream NetError!) {
    if result == {
        .Ok(_) -> print("unexpected handshake success")
        .Err(err) -> print("{err}")
    }
}

run: fn() {
    ca: files.read_bytes("ca.pem") ?? panic("CA fixture")
    roots: tls.RootCertificates.from_pem(ca) ?? panic("validate CA")
    config: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("trust policy")
    report(connect("{free-port:cbc}", config))
    report(connect("{free-port:ccm}", config))
}
