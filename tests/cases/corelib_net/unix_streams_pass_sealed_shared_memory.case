# #6701: shared memory crosses a Unix stream as an owned descriptor, reads back
# with pread, converts pixels and fills words; a duplicate of the received
# descriptor and the memory close explicitly; wait reports readiness without
# consuming.
requires: os:linux
fixture: unix_streams_pass_sealed_shared_memory.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run main.jet
exit: 0
stdout: = "false\n4096\n[4, 3, 2, 1, 4, 3, 2, 1]\ntrue\n[42] 1\n4096\njet\n[3, 2, 1, 255, 7, 6, 5, 255]\n4096\nout-of-bounds write refused\n0 0\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "false\n4096\n[4, 3, 2, 1, 4, 3, 2, 1]\ntrue\n[42] 1\n4096\njet\n[3, 2, 1, 255, 7, 6, 5, 255]\n4096\nout-of-bounds write refused\n0 0\n"
stderr: empty
