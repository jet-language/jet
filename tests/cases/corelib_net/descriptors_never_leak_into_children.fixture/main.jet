// hazard: close-on-exec. Every descriptor core.sys and core.net make
// is O_CLOEXEC: shared memory, a listener and both ends of a stream, a
// descriptor received over SCM_RIGHTS (MSG_CMSG_CLOEXEC) and its duplicate.
// This process holds them all while it starts a child (child.py), and the
// child finds none of them among its own descriptors.
use {
    files: core.files
    net: core.net
    process: core.process
    sys: core.sys
}

run: fn() {
    root: files.temp_dir("descriptors_never_leak") ?? panic("temporary directory")
    path: files.join(root.path, "s")
    listener: net.unix_listen(path) ?? panic("listen: {err}")
    client := net.unix_connect(path) ?? panic("connect: {err}")
    server := net.unix_accept(listener) ?? panic("accept: {err}")
    memory := sys.shared_memory(4096) ?? panic("shared memory: {err}")
    descriptor: memory.descriptor() ?? panic("descriptor: {err}")
    net.unix_send(client, [U8]{1}, [sys.Fd]{descriptor}) ?? panic("send: {err}")
    message := net.unix_receive(server, 16) ?? panic("receive: {err}")
    received: message.fds.remove(0, .Slot) ?? panic("no descriptor arrived")
    twin: received.duplicate() ?? panic("duplicate: {err}")

    held: kinds("/proc/self/fd")
    print("this process: memfds {held.memfds >= 3}, sockets {held.sockets >= 3}")
    child: process.run_spec(process.cmd([String]{"python3", "child.py"}).stdout(.Capture).stderr(.Capture)) ?? panic("child: {err}")
    print("child: {child.output.trim()}")
    print(received.size() ?? panic("size: {err}"))
    print(twin.size() ?? panic("size of the duplicate: {err}"))
    memory.close()
}

// How many of the descriptors listed under `directory` are memfds and how
// many sockets.
kinds: fn(directory: String) -> (memfds: Int, sockets: Int) {
    memfds := 0
    sockets := 0
    loop name in files.listdir(directory) ?? panic("listing descriptors: {err}") {
        target: files.read_link(files.join(directory, name)) ?? ""
        if target.starts_with("/memfd:") -> memfds += 1
        if target.starts_with("socket:") -> sockets += 1
    }
    (memfds: memfds, sockets: sockets)
}
