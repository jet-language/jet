// #6701 hazard: partial sends. One unix_send of 1 MiB with three
// descriptors attached is far more than a socket buffer holds, so the
// nonblocking sendmsg takes it in pieces; the send resumes each piece after
// a writable wait, and the descriptors ride with the first byte only. The
// peer (peer.py) reads slowly through a small receive buffer and reports
// what it got.
use {
    files: core.files
    net: core.net
    process: core.process
    sys: core.sys
}

SIZE: 1048576

run: fn() {
    root: files.temp_dir("unix_partial_sends") ?? panic("temporary directory")
    path: files.join(root.path, "s")
    listener: net.unix_listen(path) ?? panic("listen: {err}")
    peer: process.cmd([String]{"python3", "peer.py", path, "{SIZE}"}).stdout(.Capture).stderr(.Capture).spawn() ?? panic("peer: {err}")
    server := net.unix_accept(listener) ?? panic("accept: {err}")

    memory := sys.shared_memory(4096) ?? panic("shared memory: {err}")
    fds := [sys.Fd]{}
    loop _ in 0..<3 -> fds.push(memory.descriptor() ?? panic("descriptor: {err}"))
    bytes := [U8]{}
    loop k in 0..<SIZE -> bytes.push(U8{k %% 251})
    net.unix_send(server, bytes, fds) ?? panic("send: {err}")
    print("sent {bytes.len()} bytes")
    print("peer: {receive_line(server)}")

    receipt: peer.wait() ?? panic("peer wait: {err}")
    if !receipt.success -> panic("the peer failed: {receipt.output}")
    memory.close()
}

// One newline-ended line from the peer, without its newline.
receive_line: fn(&stream: net.UnixStream) -> String {
    line := [U8]{}
    loop {
        message: net.unix_receive(stream, 256) ?? panic("receive: {err}")
        if message.bytes.len() == 0 -> panic("the peer hung up mid-line")
        loop byte in message.bytes {
            if (Int{byte}) == 10 -> return String.from_bytes(line) ?? ""
            line.push(byte)
        }
    }
}
