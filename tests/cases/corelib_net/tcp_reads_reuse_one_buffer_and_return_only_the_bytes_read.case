# Every read on a TCP stream reuses the stream's one read buffer
# and returns a list of only the bytes it got. Short reads after a long one,
# limits that grow the buffer past the 256 KiB a stream keeps and shrink it
# again, and a byte read after a text read all return exactly the bytes sent,
# and a list the caller holds is unchanged by later reads. The interpreter at
# each level and the native build print the same lines.
requires: os-name:linux
fixture: tcp_reads_reuse_one_buffer_and_return_only_the_bytes_read.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step none: jet run -O0 main.jet
exit: 0
stdout: = tcp_reads_reuse_one_buffer_and_return_only_the_bytes_read.out
stderr: empty
step basic: jet run -O1 main.jet
exit: 0
stdout: = tcp_reads_reuse_one_buffer_and_return_only_the_bytes_read.out
stderr: empty
step full: jet run -O2 main.jet
exit: 0
stdout: = tcp_reads_reuse_one_buffer_and_return_only_the_bytes_read.out
stderr: empty
step build: jet build -O2 main.jet
exit: 0
step aot: built
exit: 0
stdout: = tcp_reads_reuse_one_buffer_and_return_only_the_bytes_read.out
stderr: empty
