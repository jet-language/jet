package: { name: "run", authority: { allow: [Net, Time.Wait, IO, Mem.Alloc] } }
use net: core.net

// A TCP text read never drops bytes. Each write below is one
// segment the peer has already received when the read runs, so the read
// sees exactly that split: a character cut by a segment or by the read
// limit is kept for the next read, bytes that are not UTF-8 fail the text
// read and stay for a byte read, and the end of the stream inside a
// character fails without losing the character's first bytes.
shown: fn(read: String NetError!) -> String Never! {
    if read == {
        .Ok(text) -> "\"{text}\" ({text.bytes().len()} bytes)"
        .Err(error) -> "error: {net.error_message(error)}"
    }
}

bytes_shown: fn(read: [U8] NetError!) -> String Never! {
    if read == {
        .Ok(bytes) -> "{bytes}"
        .Err(error) -> "error: {net.error_message(error)}"
    }
}

run: fn() {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address: net.listener_local_socket_addr(listener) ?? panic("listener address")
    client := net.tcp_connect_addr(address) ?? panic("connect")
    server := net.tcp_accept(listener) ?? panic("accept")

    // é (C3 A9) split across two segments.
    net.tcp_write_all_bytes(server, [U8]{0x68, 0xc3}) ?? panic("write")
    print("segment h+C3: {shown(net.tcp_read_text(client, 8192))}")
    net.tcp_write_all_bytes(server, [U8]{0xa9, 0x6c, 0x6c, 0x6f}) ?? panic("write")
    print("segment A9+llo: {shown(net.tcp_read_text(client, 8192))}")

    // A read limit shorter than the character returns the whole character.
    net.tcp_write_all_bytes(server, [U8]{0xe2, 0x82, 0xac}) ?? panic("write")
    print("limit 1 on E2 82 AC: {shown(net.tcp_read_text(client, 1))}")

    // A limit that cuts a 4-byte character keeps the cut for the next read.
    net.tcp_write_all_bytes(server, [U8]{0x61, 0xf0, 0x9f, 0x98, 0x80, 0x21}) ?? panic("write")
    print("limit 3 on a F0 9F 98 80 !: {shown(net.tcp_read_text(client, 3))}")
    print("then: {shown(net.tcp_read_text(client, 8192))}")

    // Bytes that are not UTF-8: the text before them reads, then the text
    // read fails without consuming them, and a byte read returns them.
    net.tcp_write_all_bytes(server, [U8]{0x61, 0xff, 0x62}) ?? panic("write")
    print("a FF b: {shown(net.tcp_read_text(client, 8192))}")
    print("then: {shown(net.tcp_read_text(client, 8192))}")
    print("again: {shown(net.tcp_read_text(client, 8192))}")
    print("bytes: {bytes_shown(net.tcp_read_bytes(client, 8))}")

    // The stream ends inside a character: the text read fails and the byte
    // read still returns the byte.
    net.tcp_write_all_bytes(server, [U8]{0xc3}) ?? panic("write")
    server.close() ?? panic("close")
    print("C3 then end: {shown(net.tcp_read_text(client, 8192))}")
    print("bytes: {bytes_shown(net.tcp_read_bytes(client, 8))}")
    print("end: {shown(net.tcp_read_text(client, 8192))}")
}
