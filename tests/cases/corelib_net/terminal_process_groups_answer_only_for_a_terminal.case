# Fd.process_group (tcgetpgrp) answers 0 for a fresh pseudoterminal's
# primary, which has no foreground group yet, and fails for its secondary
# (not this process's controlling terminal) and for a socket (no terminal).
# Fd.set_process_group (tcsetpgrp) refuses a terminal this process doesn't
# control.
requires: os-name:linux
fixture: terminal_process_groups_answer_only_for_a_terminal.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run -A main.jet
exit: 0
stdout: = "group 0\nrefused\nrefused\nrefused\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "group 0\nrefused\nrefused\nrefused\n"
stderr: empty
