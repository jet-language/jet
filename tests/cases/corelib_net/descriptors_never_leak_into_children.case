# #6701 hazard (close-on-exec): while this process holds shared memory, a
# received descriptor and its duplicate (three memfds) and a listener with
# both ends of a stream (three sockets), a child it starts inherits none of
# them.
requires: os:linux
requires: tool:python3
fixture: descriptors_never_leak_into_children.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run main.jet
exit: 0
stdout: = "this process: memfds true, sockets true\nchild: inherited memfds and sockets []\n4096\n4096\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "this process: memfds true, sockets true\nchild: inherited memfds and sockets []\n4096\n4096\n"
stderr: empty
