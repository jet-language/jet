# #6701 hazard (sealed memfd): a peer holding this process's shared memory
# can neither shrink nor grow it (both EPERM, the shrink and grow seals
# set), so the mapping here never loses pages; the peer's write through its
# own mapping reads back here, and the last word is still mapped.
requires: os-name:linux
requires: tool:python3
fixture: shared_memory_refuses_a_peers_resize.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run -A main.jet
exit: 0
stdout: = "peer: shrink EPERM, grow EPERM, seals shrink+grow, size 4096\n4096\nJET\n[0, 0, 0, 0]\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "peer: shrink EPERM, grow EPERM, seals shrink+grow, size 4096\n4096\nJET\n[0, 0, 0, 0]\n"
stderr: empty
