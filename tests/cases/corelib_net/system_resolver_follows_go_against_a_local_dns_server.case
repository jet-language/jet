# The system resolver follows Go's: the program serves DNS on 127.0.0.1:53
# (UDP and TCP) inside a fresh user, network and mount namespace whose
# resolv.conf and hosts are the fixture's, then resolves every name through
# core.net. Where musl and Go differ the golden is Go's: candidates go on
# after a failure, one record type's answer stands when the other fails,
# names with ndots dots still try the search list, the name's own error is
# preferred, .onion is never queried, all-IPv4 lists are sorted too, rule 9
# applies to IPv6 only, 127/8 and 169.254/16 have link-local scope, and the
# full RFC 6724 policy table ranks addresses.
requires: os-name:linux
requires: tool:sh+unshare+ip+mount
requires: probe unshare --user --map-root-user --net --mount true # unprivileged user namespaces are enabled
fixture: system_resolver_follows_go_against_a_local_dns_server.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step build: jet build main.jet
exit: 0
step resolve: unshare --user --map-root-user --net --mount sh inside.sh
exit: 0
stdout: = system_resolver_follows_go_against_a_local_dns_server.out
