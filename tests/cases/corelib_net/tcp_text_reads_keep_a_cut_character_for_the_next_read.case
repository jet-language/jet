# #5976 c40 (#4664): a TCP text read never drops bytes. A character cut by
# a segment or by the read limit stays for the next read, bytes that are
# not UTF-8 fail each text read and stay for a byte read, and the end of the
# stream inside a character fails the text read and leaves its bytes. The
# interpreter at each level and the native build print the same lines.
requires: os-name:linux
fixture: tcp_text_reads_keep_a_cut_character_for_the_next_read.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step none: jet run --optimize=none main.jet
exit: 0
stdout: = tcp_text_reads_keep_a_cut_character_for_the_next_read.out
stderr: empty
step basic: jet run --optimize=basic main.jet
exit: 0
stdout: = tcp_text_reads_keep_a_cut_character_for_the_next_read.out
stderr: empty
step full: jet run --optimize=full main.jet
exit: 0
stdout: = tcp_text_reads_keep_a_cut_character_for_the_next_read.out
stderr: empty
step build: jet build --optimize=full main.jet
exit: 0
step aot: built
exit: 0
stdout: = tcp_text_reads_keep_a_cut_character_for_the_next_read.out
stderr: empty
