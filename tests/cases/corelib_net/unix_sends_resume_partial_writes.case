# hazard (partial sends): one 1 MiB unix_send with three descriptors
# goes out in pieces to a peer reading a page at a time through a 4 KiB
# receive buffer; every byte arrives in order and the three descriptors
# arrive once, with byte 0.
requires: os-name:linux
requires: tool:python3
fixture: unix_sends_resume_partial_writes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step run: jet run -A main.jet
exit: 0
stdout: = "sent 1048576 bytes\npeer: 1048576 bytes in many reads, in order true, 3 descriptors at byte 0\n"
stderr: empty
step build: jet build main.jet
exit: 0
step aot: built
exit: 0
stdout: = "sent 1048576 bytes\npeer: 1048576 bytes in many reads, in order true, 3 descriptors at byte 0\n"
stderr: empty
