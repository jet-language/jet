# String.to_ascii_lower and to_ascii_upper change only A-Z and a-z. Every other
# byte keeps its place: punctuation next to the letter ranges (@ [ ` {),
# digits, and non-ASCII scalars that have case (Ä, ß, İ, ı, ǅ, Σ, ς, 𝐀, é,
# ﬀ). Each tier prints the same lines.
fixture: ascii_case_conversion_moves_only_ascii_letters.fixture
env: NO_COLOR=1
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = expected.out
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = expected.out
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = expected.out
step: jet build --target web main.jet
exit: 0
step web: node app.js
cwd: .jet/build
exit: 0
stdout: = expected.out
