// UTS #10 conformance for text.collation_key and text.collate over CLDR 48
// CollationTest_CLDR_NON_IGNORABLE_SHORT.txt (Unicode 17.0.0): each row's key
// is at least the key of the row before it. Rows holding a surrogate code
// point cannot be a String and are counted, not checked. Equal neighbours must
// be canonically equivalent: the identical level compares NFD scalars.
use {
    collation_files: core.files
    collation_text: core.text
    collation_parse: core.text.parse
}

collation_scalar: fn(out: &[U8], cp: Int) Never! {
    if cp < 128 {
        out.push(U8{cp})
    } else if cp < 2048 {
        out.push(U8{Int{192}.bit_or(cp >> 6)})
        out.push(U8{Int{128}.bit_or(cp.bit_and(Int{63}))})
    } else if cp < 65536 {
        out.push(U8{Int{224}.bit_or(cp >> 12)})
        out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(Int{63}))})
        out.push(U8{Int{128}.bit_or(cp.bit_and(Int{63}))})
    } else {
        out.push(U8{Int{240}.bit_or(cp >> 18)})
        out.push(U8{Int{128}.bit_or((cp >> 12).bit_and(Int{63}))})
        out.push(U8{Int{128}.bit_or((cp >> 6).bit_and(Int{63}))})
        out.push(U8{Int{128}.bit_or(cp.bit_and(Int{63}))})
    }
}

collation_key_order: fn(left: [U8], right: [U8]) -> Ordering Never! {
    at := 0
    loop at < left.len() && at < right.len() {
        if left[at] != right[at] -> return left[at] <=> right[at]
        at += 1
    }
    left.len() <=> right.len()
}

run: fn() {
    source: collation_files.read("CollationTest.txt") ?? panic("missing CollationTest_CLDR_NON_IGNORABLE_SHORT.txt")
    previous := [U8]{}
    previous_value := ""
    checked := 0
    surrogates := 0
    out_of_order := 0
    equal := 0
    disagreements := 0
    loop raw in source.lines() {
        line: raw.partition("#").head.trim()
        if line == "" -> next
        bytes := [U8]{}
        surrogate := false
        loop word in line.split(" ") {
            if word == "" -> next
            cp: collation_parse.parse_int_base(word, 16) ?? panic("bad code point `{word}`")
            if cp >= 0xd800 && cp <= 0xdfff -> surrogate = true
            collation_scalar(bytes, cp)
        }
        if surrogate {
            surrogates += 1
            next
        }
        value: String.from_bytes(bytes) ?? panic("row `{line}` is not UTF-8")
        key: collation_text.collation_key(value)
        if checked > 0 {
            order: collation_key_order(previous, key)
            if order == Ordering.Greater {
                out_of_order += 1
                if out_of_order <= 10 -> print("out of order: `{line}`")
            }
            if order == Ordering.Equal -> equal += 1
            if collation_text.collate(previous_value, value) != order -> disagreements += 1
        }
        previous = key
        previous_value = value
        checked += 1
    }
    print("rows {checked}, surrogate rows {surrogates}")
    print("out of order {out_of_order}, equal neighbours {equal}, collate disagreements {disagreements}")
}
