# core.text, core.text.parse and core.text.fmt members have one meaning, their
# Jet body. A member called from inside its own module (text.trim calls
# trim_start, parse.strip calls lstrip and rstrip, parse.startswith calls
# starts_with) runs the same body an outside caller gets, so each line's two
# spellings agree, on every tier.
fixture: text_members_call_their_own_jet_bodies_inside_the_module_on_every_tier.fixture
env: NO_COLOR=1
step o0: jet run -O0 main.jet
env: JET_STORE_DIR={work}/cache/o0
exit: 0
stdout: = text_members_call_their_own_jet_bodies_inside_the_module_on_every_tier.out
step o1: jet run -O1 main.jet
env: JET_STORE_DIR={work}/cache/o1
exit: 0
stdout: = text_members_call_their_own_jet_bodies_inside_the_module_on_every_tier.out
step o2: jet run -O2 main.jet
env: JET_STORE_DIR={work}/cache/o2
exit: 0
stdout: = text_members_call_their_own_jet_bodies_inside_the_module_on_every_tier.out
