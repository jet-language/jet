
use core.text as text
use core.regex as re

FOLDED :: comptime { text.casefold("Straßeİς") }
LOWERED :: comptime { text.lower("ΟΣ") }
UPPERED :: comptime { text.upper("ßև") }
METHOD_LOWERED :: comptime { "꟎".to_lower() }
METHOD_UPPERED :: comptime { "꟏".to_upper() }
METHOD_TRIMMED :: comptime { " jet ".trim() }
KEYCAP :: comptime { text.display_width("1️⃣") }
EMOJI :: comptime { text.display_width("©️") }
IGNORABLE :: comptime { text.display_width("́‍") }
CLASSES :: comptime { text.is_alphabetic("Ж") && text.is_numeric("٣") && text.is_whitespace(" ") }
REGEX_SPACE :: comptime { re.is_match(Regex{"\s"}, " ") }

fn run() {
    runtime_folded :: text.casefold("Straßeİς")
    runtime_lowered :: text.lower("ΟΣ")
    runtime_uppered :: text.upper("ßև")
    runtime_method_lowered :: "꟎".to_lower()
    runtime_method_uppered :: "꟏".to_upper()
    runtime_method_trimmed :: " jet ".trim()
    runtime_keycap :: text.display_width("1️⃣")
    runtime_emoji :: text.display_width("©️")
    runtime_ignorable :: text.display_width("́‍")
    runtime_classes :: text.is_alphabetic("Ж") && text.is_numeric("٣") && text.is_whitespace(" ")
    runtime_regex_space :: re.is_match(Regex{"\s"}, " ")
    regex_alpha :: re.is_match(Regex{"\p{{Alphabetic}}+"}, "Ж")
    regex_number :: re.is_match(Regex{"\p{{Number}}+"}, "٣")
    regex_whitespace :: re.is_match(Regex{"\p{{White_Space}}+"}, " ")
    insensitive :: re.compile_with("k", re.flags(true, false, false)) ?? panic("regex")
    print("{FOLDED}|{runtime_folded}")
    print("{LOWERED}|{runtime_lowered}")
    print("{UPPERED}|{runtime_uppered}")
    print(METHOD_LOWERED == "꟏" && runtime_method_lowered == "꟏")
    print(METHOD_UPPERED == "꟎" && runtime_method_uppered == "꟎")
    print("{METHOD_TRIMMED}|{runtime_method_trimmed}")
    print("{KEYCAP}|{runtime_keycap}")
    print("{EMOJI}|{runtime_emoji}")
    print("{IGNORABLE}|{runtime_ignorable}")
    print("{CLASSES}|{runtime_classes}")
    print("{REGEX_SPACE}|{runtime_regex_space}")
    print(regex_alpha && regex_number && regex_whitespace && insensitive.is_match("K"))
}
