// Pure parser combinators over UTF-8 text. Input.pos is a byte offset, but
// predicate scans advance only at validated scalar boundaries.
use unicode: core.text

Input: struct {
    text: String
    pos: Int
}

Took: struct {
    next: Input
    chunk: String
}

Digit: struct {
    next: Input
    n: Int
}

input: fn(text: String) -> Input Never! { {text: text, pos: 0} }

remaining: fn(src: Input) -> String Never! {
    raw: src.text.bytes()
    if src.pos < 0 || src.pos >= raw.len() -> return ""
    String.from_bytes(slice_rest(raw, src.pos)) ?? ""
}

eof: fn(src: Input) -> Bool Never! { src.pos >= src.text.bytes().len() }

peek: fn(src: Input) -> U8? Never! {
    raw: src.text.bytes()
    if src.pos < 0 || src.pos >= raw.len() -> return None
    Val(raw[src.pos])
}

take_n: fn(src: Input, n: Int) -> Took? Never! {
    raw: src.text.bytes()
    if n < 0 || src.pos < 0 || src.pos + n > raw.len() -> return None
    chunk: String.from_bytes(slice_range(raw, src.pos, src.pos + n)) ?? return None
    Val(Took{next: Input{text: src.text, pos: src.pos + n}, chunk: chunk})
}

tag: fn(src: Input, lit: String) -> Took? Never! {
    got: take_n(src, lit.bytes().len()) ?? return None
    if got.chunk != lit -> return None
    Val(got)
}

take_while: fn(src: Input, predicate: fn(String) -> Bool Never!) -> Took Never! {
    raw: src.text.bytes()
    i := src.pos
    loop i < raw.len() {
        width: utf8_width(raw, i)
        scalar: String.from_bytes(slice_range(raw, i, i + width)) ?? break
        if !predicate(scalar) -> break
        i = i + width
    }
    chunk: String.from_bytes(slice_range(raw, src.pos, i)) ?? ""
    {next: Input{text: src.text, pos: i}, chunk: chunk}
}

skip_ws: fn(src: Input) -> Input Never! { take_while(src, fn(scalar: String) { unicode.is_whitespace(scalar) }).next }

digit: fn(src: Input) -> Digit? Never! {
    b: peek(src) ?? return None
    if b < 48 || b > 57 -> return None
    nxt: take_n(src, 1) ?? return None
    Val(Digit{next: nxt.next, n: Int.from_u8(b) - 48})
}

int_dec: fn(src: Input) -> Digit? Never! {
    cur := skip_ws(src) ?? return None
    sign := 1
    b: peek(cur) ?? return None
    if b == 45 || b == 43 {
        if b == 45 -> sign = -1
        taken: take_n(cur, 1) ?? return None
        cur = taken.next
    }
    acc := 0
    saw := false
    loop {
        d: digit(cur) ?? break
        saw = true
        acc = acc * 10 + d.n
        cur = d.next
    }
    if !saw -> return None
    return Val(Digit{next: cur, n: acc * sign})
}

utf8_width: fn(raw: [U8], at: Int) -> Int {
    if at < 0 || at >= raw.len() -> return 1
    b: raw[at]
    if b < 128 -> return 1
    if b >= 194 && b <= 223 && at + 1 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 -> return 2
    if b >= 224 && b <= 239 && at + 2 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 -> return 3
    if b >= 240 && b <= 244 && at + 3 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 && raw[at + 3] >= 128 && raw[at + 3] <= 191 -> return 4
    1
}

slice_range: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    lo := start
    hi := end
    if lo < 0 -> lo = 0
    if hi > raw.len() -> hi = raw.len()
    if hi < lo -> hi = lo
    i := lo
    loop {
        if i >= hi -> return out
        out.push(raw[i])
        i = i + 1
    }
}

slice_rest: fn(raw: [U8], start: Int) -> [U8] { slice_range(raw, start, raw.len()) }
