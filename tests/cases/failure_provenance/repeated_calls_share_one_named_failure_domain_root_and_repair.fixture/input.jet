
#Error
WrongDomain: enum { One }

#Error
CallerDomain: enum { One }

wrong_helper: fn() -> Int WrongDomain! {
    return Err(WrongDomain.One)
}

caller: fn() -> Int CallerDomain! {
    wrong_helper()
    wrong_helper()
    wrong_helper()
    wrong_helper()
    wrong_helper()
    return Ok(0)
}

run: fn() {}
