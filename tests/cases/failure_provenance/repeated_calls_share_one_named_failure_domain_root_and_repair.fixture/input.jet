
#Error
enum WrongDomain { One }

#Error
enum CallerDomain { One }

fn wrong_helper() -> Int WrongDomain! {
    return Err(WrongDomain.One)
}

fn caller() -> Int CallerDomain! {
    wrong_helper()
    wrong_helper()
    wrong_helper()
    wrong_helper()
    wrong_helper()
    return Ok(0)
}

fn run() {}
