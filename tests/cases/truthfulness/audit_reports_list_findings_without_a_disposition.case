# #6563 c6 (was #1705 c2): list every Docs/audits report and finding that carries no disposition
# (.agents/skills/_shared/audit-dispositions.md). Port of scripts/agent/check-audit-dispositions.mjs,
# removed in 2efc938b3d. The golden is the list: a new report without a table, or a report whose
# table gains or loses a disposition, changes it, and the golden is updated in the same change.
# NODE-DEBT: live cards and decisions come from Tools/tower/tower.mjs; remove when Tower is Jet.
requires: tool:node
fixture: audit_reports_list_findings_without_a_disposition.fixture
copy: {root}/Tools/tower repo/Tools/tower
step: jet run --allow=Exec,FS.Read {work}/main.jet {root} {work}/repo
exit: 0
stdout: = audit_reports_list_findings_without_a_disposition.out
stderr: empty
