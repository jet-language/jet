# Prep constants keep their declared collection and named-tuple types:
# `[String]{}` stays `[String]` and a named tuple keeps its fields, with no
# value-shape guessing, on O0, O1 and O2.
fixture: prep_constants_keep_declared_collection_and_tuple_types.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
step o0: jet run --optimize=none main.jet
exit: 0
stdout: = "alpha,beta\n\n0\n6\npair\n20\n"
stderr: empty
step o1: jet run --optimize=basic main.jet
exit: 0
stdout: = "alpha,beta\n\n0\n6\npair\n20\n"
stderr: empty
step o2: jet run --optimize=full main.jet
exit: 0
stdout: = "alpha,beta\n\n0\n6\npair\n20\n"
stderr: empty
