# Port of tests/comptime_cli_parity.rs::package_build_entry_discovery_matches_committed_golden_across_tiers; exact original predicates, runtime UNRUN.
# ORIGINAL-TEST-BUG: duplicate store assignments preserved.
copy: {root}/Examples/Metaprogramming/BuildTime/BuildEntryDiscovery build_entry_discovery
step release: jet run --release {work}/build_entry_discovery/run.jet
cwd: build_entry_discovery
env: JET_STORE_DIR={work}/cache/release-run
env: JET_STORE_DIR={work}/cache/release-build
exit: 0
stdout: = ../../../Examples/Metaprogramming/BuildTime/BuildEntryDiscovery.out
step default: jet run {work}/build_entry_discovery/run.jet
cwd: build_entry_discovery
env: JET_STORE_DIR={work}/cache/run
env: JET_STORE_DIR={work}/cache/default
exit: 0
stdout: = ../../../Examples/Metaprogramming/BuildTime/BuildEntryDiscovery.out
exit: == release # Original ExitStatus::code equality.
step dev: jet dev {work}/build_entry_discovery/run.jet --watch=off
cwd: build_entry_discovery
env: JET_STORE_DIR={work}/cache/dev-run
env: JET_STORE_DIR={work}/cache/dev-build
exit: 0
stdout: = ../../../Examples/Metaprogramming/BuildTime/BuildEntryDiscovery.out
exit: == release # Original ExitStatus::code equality.

