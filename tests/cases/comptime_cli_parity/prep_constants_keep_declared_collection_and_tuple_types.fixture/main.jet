// Each prep constant keeps the type its value declares: an empty `[String]{}`
// stays `[String]` (it can be pushed to and passed where `[String]` is
// expected), and a named tuple keeps its field names and field types.
EMPTY: #run { [String]{} }
NUMBERS: #run { [Int]{1, 2, 3} }
PAIR: #run { (name: "pair", count: 2) }

joined: fn(words: [String]) -> String {
    words.join(",")
}

run: fn() {
    words := EMPTY.copy()
    words.push("alpha")
    words.push("beta")
    print(joined(words))
    print(joined(EMPTY))
    print(EMPTY.len())
    total := 0
    loop n in NUMBERS -> total = total + n
    print(total)
    print(PAIR.name)
    print(PAIR.count * 10)
}
