# `jet inspect facts --store=program` renders the very `core.compiler.query` a
# build makes over its ProgramInfo: the marker rows the command prints for
# main.jet are the rows main.jet's own build reads from `b.program`, with the
# same stable identities, and both name the program's revision (#4276 c97).
fixture: inspect_facts_program_store_is_the_build_query.fixture
step: jet inspect facts --store=program --kind=marker main.jet
env: NO_COLOR=1
exit: 0
stdout: ~ "program source main.jet revision " # the header names the source; the revision is a content hash
stdout: ~ ", kind marker: " # the header names the kind
stdout: ~ " facts, complete" # the query ends complete; the count is the toolchain's
stdout: ~ "Codable  main.Order  main.Order#marker:Codable" # Order's marker row and its stable identity
stdout: ~ "Comparable  main.OrderID  main.OrderID#marker:Comparable" # OrderID's marker row and its stable identity
stderr: empty
step: jet build main.jet
env: NO_COLOR=1
exit: nonzero
stdout+stderr: ~ "FACTS" # the build's error report carries the program's FACTS line
stdout+stderr: ~ " facts: " # the build prints its count line; the count is the fixture's
stdout+stderr: ~ "[Codable  main.Order  main.Order#marker:Codable  item Order]" # the build's row equals the command's row
stdout+stderr: ~ "[Comparable  main.OrderID  main.OrderID#marker:Comparable  item OrderID]" # the build's row equals the command's row
stdout+stderr: ~ "revision-matches=true" # the build's revision is the one the command printed
step: jet inspect facts --store=program --kind=read main.jet --json
env: NO_COLOR=1
exit: 0
stdout: ~ "inspect.facts" # one inspect.facts envelope
stdout: ~ "\"source\"" # the JSON names the program source
stdout: ~ "\"revision\"" # the JSON names the program revision
stderr: empty
step: jet inspect facts --store=program --kind=marker-arg main.jet
env: NO_COLOR=1
exit: 0
stdout: ~ ", kind marker-arg: 0 facts, complete" # main.jet's markers take no arguments
stderr: empty
step: jet inspect facts --store=schema --kind=marker-arg
env: NO_COLOR=1
exit: nonzero
stderr: ~ "E2105" # the query refusal's code; the rest of the report is the renderer's
stderr: ~ "unsupported: marker-argument facts of the schema store" # the schema store has no marker arguments
