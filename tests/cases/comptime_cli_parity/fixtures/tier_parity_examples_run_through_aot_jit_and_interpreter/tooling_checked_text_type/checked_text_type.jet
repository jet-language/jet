#Error
TextError: enum { Empty }

Token: distinct String

impl Token.CheckedText {
    Error: TextError

    check: fn(text: String) TextError! -[]> {
        if text == "" -> return Err(TextError.Empty)
        return Ok(())
    }

    encode_hole: fn<T: Printable>(value: T) -[]> String {
        return "[{value}]"
    }
}

show: fn(value: Token) {
    #Unsafe("checked text example output") {
        print(value.raw())
    }
}

run: fn() {
    literal: Token{"accepted {7}"}
    show(literal)

    if Token.from("accepted") == {
        .Ok(value) -> show(value)
        .Err(error) -> print("rejected")
    }
}
