// D-CMD-OVERRIDE1=C (card #1451): `fn test` owns command policy while the
// compiler-owned Test remains an ordinary value. `jet test --show-default`
// selects the stock harness instead.
use core.testing as testing

fn test(suite: Test) {
    print("test setup")
    print("test suite {suite.iteration}:{suite.result}")
    suite.run()
    print("test teardown")
}

#Test("override body") {
    print("test body")
}

fn run() { test(testing.test_suite()) }
