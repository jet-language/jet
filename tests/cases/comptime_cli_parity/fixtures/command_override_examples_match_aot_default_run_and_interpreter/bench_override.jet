// D-CLAIM-BENCH1=A: measurement is selected by `jet test --measure`; the
// command override remains the ordinary `test: fn` path.
use testing: core.testing

test: fn(suite: Test) {
    print("test setup")
    print("test suite {suite.iteration}:{suite.result}")
    suite.run()
    print("test teardown")
}

#Test("override body") {
    .measure {
        print("test body")
        assert(true)
    }
}

run: fn() { test(testing.test_suite()) }
