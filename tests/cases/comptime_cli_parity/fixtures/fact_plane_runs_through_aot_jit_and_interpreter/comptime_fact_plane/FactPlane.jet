// D-CONF-READ1=A: one folded program reads the registered build fact plane.
run: fn() {
    #if #build.target.os == {
        .Linux -> { print("linux") }
        .MacOS -> { print("macos") }
        .Windows -> { print("windows") }
        .Web -> { print("web") }
        .Wasm -> { print("wasm") }
        .Freestanding -> { print("freestanding") }
    }
    print(#package.name)
    print(#package.version)
    print(#build.target.os)
    print(#build.profile)
}
