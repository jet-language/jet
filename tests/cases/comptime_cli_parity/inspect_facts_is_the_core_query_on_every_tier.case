# `jet inspect facts` renders the very `core.compiler.query` a Jet program
# makes while building: the schema store's marker facts as the command prints
# them equal the program's own rendering of the same query on O0, O1 and O2,
# snapshot identity, count and rows alike (#4276 c97).
fixture: inspect_facts_is_the_core_query_on_every_tier.fixture
step cli: jet inspect facts --store=schema --kind=marker
env: NO_COLOR=1
exit: 0
stdout: ~ "schema snapshot " # the header names the snapshot; its identity is the toolchain's
stdout: ~ " facts, complete" # the query ends complete; the count is the toolchain's
stdout: ~ "Pre  " # the schema lists the Pre marker
stderr: empty
step o0: jet run -O0 main.jet
env: NO_COLOR=1
exit: 0
stdout: == cli
stderr: empty
step o1: jet run -O1 main.jet
env: NO_COLOR=1
exit: 0
stdout: == cli
stderr: empty
step o2: jet run -O2 main.jet
env: NO_COLOR=1
exit: 0
stdout: == cli
stderr: empty
step: jet inspect facts --store=schema --kind=read --json
env: NO_COLOR=1
exit: 0
stdout: ~ "inspect.facts" # one inspect.facts envelope
stdout: ~ "origin" # read rows name their origin
stderr: empty
