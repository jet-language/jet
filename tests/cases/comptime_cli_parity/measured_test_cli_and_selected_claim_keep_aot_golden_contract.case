# Port of tests/comptime_cli_parity.rs::measured_test_cli_and_selected_claim_keep_aot_golden_contract; exact original predicates, runtime UNRUN.
# ORIGINAL-TEST-BUG: duplicate bench JET_STORE_DIR assignments preserved.
fixture: fixtures/measured_test_cli_and_selected_claim_keep_aot_golden_contract
step: jet build main.jet
exit: 0
step: built
exit: 0
stdout: = ../../../Examples/features/expected/tooling/test_target.out
step: jet test --help
exit: 0
stdout: ~ "--filter" # Original help contains.
stdout: ~ "--measure" # Original help contains.
step: jet test main.jet --measure "--filter=sum_to(1000)"
exit: 0
stdout: ~ "sum_to(1000)" # Original selected contains claim name.
stdout: ~ "ns" # Original selected contains timing unit.
# The original ran bench.jet in place, outside the scratch package. A copy under
# {work} joins package `work`, whose main.jet already declares `run` (E0624
# DuplicatePackageName), so the bench runs from the case's own tmp directory.
copy: {root}/Examples/features/tooling/bench.jet {tmp}/bench/bench.jet
step: jet test bench.jet --measure --json
cwd: {tmp}/bench
env: JET_STORE_DIR={work}/bench-cache
env: JET_STORE_DIR={work}/bench-run-cache
exit: 0
# The two claims compare by their fastest sample, not their mean: load on the
# host only ever slows a sample, so one slow elided-baseline sample can lift
# its mean past the keep loop's, while the fastest samples still order the
# kept work above the elided control.
capture: elided = text stdout.filter(~ "\"name\":\"elided baseline\"").line(0).split("\"min_ns\":", 1).split(",", 0).split("}", 0)
capture: kept = text stdout.filter(~ "\"name\":\"keep loop\"").line(0).split("\"min_ns\":", 1).split(",", 0).split("}", 0)
cap:kept: is-f64 # original parses the keep-loop mean_ns as f64; here its min_ns
cap:elided: is-f64 # original parses the elided-baseline mean_ns as f64; here its min_ns
cap:kept: f64 > {cap:elided} # Original same-run f64 keep mean > elided control, here by min_ns; never an absolute threshold.
# The shipped bench's golden shows each measured claim. The iteration count is
# calibrated per host and the timings vary, so only those values are masked.
step: jet test bench.jet --measure --json
cwd: {tmp}/bench
env: JET_STORE_DIR={work}/bench-golden-cache
normalize: json stdout $.iterations : int # calibrated per host
normalize: json stdout $.min_ns : number # timing varies
normalize: json stdout $.median_ns : number # timing varies
normalize: json stdout $.mean_ns : number # timing varies
normalize: json stdout $.max_ns : number # timing varies
exit: 0
stdout: = ../../../Examples/features/expected/tooling/bench.measure.out

