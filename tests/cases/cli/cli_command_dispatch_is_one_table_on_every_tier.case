exit: 0
stdout: = "stop\n"
stderr: empty
step: jet run --optimize=basic six.jet -- stop
exit: 0
stdout: = "stop\n"
stderr: empty
step: jet run --optimize=full six.jet -- stop
exit: 0
stdout: = "stop\n"
stderr: empty
step: jet run --optimize=none options.jet -- --name=ada -c 3 --scale 2.5 --label=x -l --quiet
exit: 0
stdout: = "ada 3 2.5 x true true false\n"
stderr: empty
step: jet run --optimize=basic options.jet -- --name=ada -c 3 --scale 2.5 --label=x -l --quiet
exit: 0
stdout: = "ada 3 2.5 x true true false\n"
stderr: empty
step: jet run --optimize=full options.jet -- --name=ada -c 3 --scale 2.5 --label=x -l --quiet
exit: 0
stdout: = "ada 3 2.5 x true true false\n"
stderr: empty
step: jet run --optimize=none options.jet -- -n bo --count=4 -s1.5 --dry
exit: 0
stdout: = "bo 4 1.5 none false false true\n"
stderr: empty
step: jet run --optimize=basic options.jet -- -n bo --count=4 -s1.5 --dry
exit: 0
stdout: = "bo 4 1.5 none false false true\n"
stderr: empty
step: jet run --optimize=full options.jet -- -n bo --count=4 -s1.5 --dry
exit: 0
stdout: = "bo 4 1.5 none false false true\n"
stderr: empty
step: jet run --optimize=none six.jet -- nope
exit: 2
stdout: empty
stderr: ~ "unknown command `nope`" # an unknown command reaches the else of the table
step: jet run --optimize=full six.jet -- nope
exit: 2
stdout: empty
stderr: ~ "unknown command `nope`" # an unknown command reaches the else of the table
step: jet run --optimize=none options.jet -- --nope
exit: 2
stdout: empty
stderr: ~ "unknown option `--nope`" # an unknown `--name` reaches the else of the `--name` table
step: jet run --optimize=full options.jet -- --nope
exit: 2
stdout: empty
stderr: ~ "unknown option `--nope`" # an unknown `--name` reaches the else of the `--name` table
step: jet run --optimize=none options.jet -- --loud=yes
exit: 2
stdout: empty
stderr: ~ "--loud is a flag; it takes no value (got `=yes`)" # a flag given a value is the flag arm of the `--name=value` table
step: jet run --optimize=full options.jet -- --loud=yes
exit: 2
stdout: empty
stderr: ~ "--loud is a flag; it takes no value (got `=yes`)" # a flag given a value is the flag arm of the `--name=value` table
step: jet run --optimize=none options.jet -- -z
exit: 2
stdout: empty
stderr: ~ "unknown option `-z`" # an unknown short reaches the else of the `-x` table
step: jet run --optimize=full options.jet -- -z
exit: 2
stdout: empty
stderr: ~ "unknown option `-z`" # an unknown short reaches the else of the `-x` table
step: jet run --optimize=none options.jet -- --count x
exit: 2
stdout: empty
stderr: ~ "`--count` expects an Int, got `x`" # a bad Int still refuses inside its arm
step: jet run --optimize=full options.jet -- --count x
exit: 2
stdout: empty
stderr: ~ "`--count` expects an Int, got `x`" # a bad Int still refuses inside its arm
