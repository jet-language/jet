# A #CLI struct with 1, 2, 3 or 6 command fns checks with no warning: the
# generated dispatch is one `if __command == { … }` table, not adjacent guards
# (three or more once warned L0514 SameSubjectDispatch on code the user never
# wrote). A struct without commands gets a parser with one table per argv
# form, so many options and flags check clean too. Each command and form runs
# on every tier.
fixture: fixtures/cli_commands
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check one.jet
exit: 0
stdout: = ""
stderr: = "ok: `one.jet` has no problems\n"
step: jet check two.jet
exit: 0
stdout: = ""
stderr: = "ok: `two.jet` has no problems\n"
step: jet check three.jet
exit: 0
stdout: = ""
stderr: = "ok: `three.jet` has no problems\n"
step: jet check six.jet
exit: 0
stdout: = ""
stderr: = "ok: `six.jet` has no problems\n"
step: jet check options.jet
exit: 0
stdout: = ""
stderr: = "ok: `options.jet` has no problems\n"
step: jet run --optimize=none one.jet -- hello ada
exit: 0
stdout: = "hello ada\n"
stderr: empty
step: jet run --optimize=basic one.jet -- hello ada
exit: 0
stdout: = "hello ada\n"
stderr: empty
step: jet run --optimize=full one.jet -- hello ada
exit: 0
stdout: = "hello ada\n"
stderr: empty
step: jet run --optimize=none two.jet -- add buy-milk --due fri
exit: 0
stdout: = "add buy-milk due fri\n"
stderr: empty
step: jet run --optimize=basic two.jet -- add buy-milk --due fri
exit: 0
stdout: = "add buy-milk due fri\n"
stderr: empty
step: jet run --optimize=full two.jet -- add buy-milk --due fri
exit: 0
stdout: = "add buy-milk due fri\n"
stderr: empty
step: jet run --optimize=none two.jet -- login tok
exit: 0
stdout: = "login tok\n"
stderr: empty
step: jet run --optimize=basic two.jet -- login tok
exit: 0
stdout: = "login tok\n"
stderr: empty
step: jet run --optimize=full two.jet -- login tok
exit: 0
stdout: = "login tok\n"
stderr: empty
step: jet run --optimize=none three.jet -- --greeting hey greet ada
exit: 0
stdout: = "hey ada\n"
stderr: empty
step: jet run --optimize=basic three.jet -- --greeting hey greet ada
exit: 0
stdout: = "hey ada\n"
stderr: empty
step: jet run --optimize=full three.jet -- --greeting hey greet ada
exit: 0
stdout: = "hey ada\n"
stderr: empty
step: jet run --optimize=none three.jet -- count --times 5
exit: 0
stdout: = "count 5\n"
stderr: empty
step: jet run --optimize=basic three.jet -- count --times 5
exit: 0
stdout: = "count 5\n"
stderr: empty
step: jet run --optimize=full three.jet -- count --times 5
exit: 0
stdout: = "count 5\n"
stderr: empty
step: jet run --optimize=none three.jet -- stop
exit: 0
stdout: = "stop hi\n"
stderr: empty
step: jet run --optimize=basic three.jet -- stop
exit: 0
stdout: = "stop hi\n"
stderr: empty
step: jet run --optimize=full three.jet -- stop
exit: 0
stdout: = "stop hi\n"
stderr: empty
step: jet run --optimize=none six.jet -- --config x show
exit: 0
stdout: = "show x\n"
stderr: empty
step: jet run --optimize=basic six.jet -- --config x show
exit: 0
stdout: = "show x\n"
stderr: empty
step: jet run --optimize=full six.jet -- --config x show
exit: 0
stdout: = "show x\n"
stderr: empty
step: jet run --optimize=none six.jet -- open a.txt
exit: 0
stdout: = "open a.txt\n"
stderr: empty
step: jet run --optimize=basic six.jet -- open a.txt
exit: 0
stdout: = "open a.txt\n"
stderr: empty
step: jet run --optimize=full six.jet -- open a.txt
exit: 0
stdout: = "open a.txt\n"
stderr: empty
step: jet run --optimize=none six.jet -- repeat hi
exit: 0
stdout: = "repeat hi 3\n"
stderr: empty
step: jet run --optimize=basic six.jet -- repeat hi
exit: 0
stdout: = "repeat hi 3\n"
stderr: empty
step: jet run --optimize=full six.jet -- repeat hi
exit: 0
stdout: = "repeat hi 3\n"
stderr: empty
step: jet run --optimize=none six.jet -- tag --label x
exit: 0
stdout: = "tag x\n"
stderr: empty
step: jet run --optimize=basic six.jet -- tag --label x
exit: 0
stdout: = "tag x\n"
stderr: empty
step: jet run --optimize=full six.jet -- tag --label x
exit: 0
stdout: = "tag x\n"
stderr: empty
step: jet run --optimize=none six.jet -- rename a b
exit: 0
stdout: = "rename a b\n"
