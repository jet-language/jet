# #6532: a #CLI struct in a file shorter than its generated
# `__jet_cli_decode` and `merge` projections builds and runs on every tier.
# Their journey sites name the generated function, not a span past the end
# of run.jet, and a refused flag's journey points at the user's decode call.
fixture: fixtures/cli_projection
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run --optimize=none run.jet -- hello --count 3
exit: 0
stdout: = cli_projections_of_a_short_file_build_and_run_on_every_tier.out
stderr: empty
step: jet run --optimize=basic run.jet -- hello --count 3
exit: 0
stdout: = cli_projections_of_a_short_file_build_and_run_on_every_tier.out
stderr: empty
step: jet run --optimize=full run.jet -- hello --count 3
exit: 0
stdout: = cli_projections_of_a_short_file_build_and_run_on_every_tier.out
stderr: empty
step default: jet run run.jet -- hello
exit: 0
stdout: = "count=1\nmerged=7\n" # an unset flag keeps its default and merge takes the layer's 7
step refused: jet run run.jet -- hello --count x
exit: 1
stdout: empty
stderr: ~ "`--count` expects an Int, got `x`" # the decode refusal names the flag and the bad value
stderr: ~ "failed here: run (run.jet:15)" # the journey names the user's decode line, not a generated span
stderr: ~ "flags: args.decode<Tool>()" # and quotes that source line
