// A #CLI struct in a file shorter than its generated decode and merge
// projections: `args.decode<Tool>()` and `Tool.merge` build and run.
use args :: core.args

#CLI
struct Tool {
    #[Doc("how many"), Short("c")] count: Int{1}

    #Doc("say hello") fn hello(self) {
        print("hello {self.count}")
    }
}

fn run() [FieldError]! {
    flags :: args.decode<Tool>()
    print("count={flags.count}")
    merged :: Tool.merge(flags, Tool{count: 7})
    print("merged={merged.count}")
}
