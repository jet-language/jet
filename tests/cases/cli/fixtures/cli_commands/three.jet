// Three command fns over one shared field: three adjacent guards over the
// command name once warned L0514; the dispatch is now one table.
#CLI
Commands: struct {
    #Doc("the greeting") greeting: String{"hi"}

    #Doc("greet someone") greet: fn(self, name: String) {
        print("{self.greeting} {name}")
    }

    #Doc("count up") count: fn(self, times: Int{2}) {
        print("count {times}")
    }

    #Doc("stop") stop: fn(self) {
        print("stop {self.greeting}")
    }
}

run: fn(_args: Commands) {}
