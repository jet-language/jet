// Two command fns: a positional, a defaulted option and a plain String.
#CLI
Commands: struct {
    #Doc("add a task") add: fn(self, text: String, due: String{"never"}) {
        print("add {text} due {due}")
    }

    #Doc("log in") login: fn(self, token: String) {
        print("login {token}")
    }
}

run: fn(_args: Commands) {}
