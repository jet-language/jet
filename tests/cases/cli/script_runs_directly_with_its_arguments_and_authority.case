# A file whose first line is `#!/usr/bin/env jet` is a script: `./script` runs
# it with exactly the words after it, with no package block, and a rerun reuses
# the kept build. Every program may use every effect unless something denies it
# here: the script and the same program without the launch line
# both run and name what they did in one notice line; `-A` hides the notice.
env: XDG_STATE_HOME={work}/state
env: NO_COLOR=1
requires: os:unix
fixture: fixtures/script_mode
copy: {root}/Examples/Systems/CLI/ScriptMode.jet script_mode.jet
chmod: script_mode.jet 755
mkdir: bin
symlink: {jet} bin/jet
step first: ./script_mode.jet alpha --beta -- gamma
env: PATH={work}/bin:{env:PATH}
env: XDG_CACHE_HOME={work}/cache
exit: 0
stdout: = script_runs_directly_first.out
stderr: ~ "script_mode.jet " # the notice names the script
stderr: ~ "(-A hides this)\n" # the notice is one line
step rerun: ./script_mode.jet again
env: PATH={work}/bin:{env:PATH}
env: XDG_CACHE_HOME={work}/cache
exit: 0
stdout: = script_runs_directly_rerun.out
stderr: ~ "(-A hides this)\n" # outside a terminal every run names its effects
step plain: jet plain.jet alpha
env: XDG_CACHE_HOME={work}/cache
exit: 0
stdout: = script_runs_directly_allow_all.out
stderr: ~ "note: plain.jet " # without the launch line the file runs the same way and is named the same way
stderr: ~ "(-A hides this)\n" # the notice is one line
step allow_all: jet -A plain.jet alpha
env: XDG_CACHE_HOME={work}/cache
exit: 0
stdout: = script_runs_directly_allow_all.out
stderr: !~ "note:" # `-A` acknowledges every effect, so nothing is named
