# A typed CLI Int flag decodes with exactly Int.parse's rules on every tier.
# Int is exact, so a value past I64 is the exact number, not a refusal or a
# wrapped count; a leading space or plus sign gives what Int.parse gives.
fixture: fixtures/cli_projection
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet run -O0 run.jet -- hello --count 9223372036854775808
exit: 0
stdout: = "count=9223372036854775808\nmerged=9223372036854775808\n"
stderr: empty
step: jet run -O1 run.jet -- hello --count 18446744073709551617
exit: 0
stdout: = "count=18446744073709551617\nmerged=18446744073709551617\n"
stderr: empty
step: jet run -O2 run.jet -- hello --count 99999999999999999999
exit: 0
stdout: = "count=99999999999999999999\nmerged=99999999999999999999\n"
stderr: empty
step: jet run -O0 run.jet -- hello --count ' 5'
exit: 0
stdout: = "count=5\nmerged=5\n"
stderr: empty
step: jet run -O2 run.jet -- hello --count +5
exit: 0
stdout: = "count=5\nmerged=5\n"
stderr: empty
step: jet run -O1 run.jet -- hello --count -12
exit: 0
stdout: = "count=-12\nmerged=-12\n"
stderr: empty
