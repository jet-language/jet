
use {
    encoding: core.encoding
    cbor: core.encoding.cbor
    files: core.files
}

run: fn() {
    directory_input: files.open("{work}") ?? panic("open dir")
    directory_reader := cbor.reader(^directory_input) ?? panic("reader")
    if &directory_reader.next() == {
        .Val(_) | .None -> { print("read-ok-missed") }
        .Err(first) -> {
            if &directory_reader.next() == {
                .Val(_) | .None -> { print("not-latched") }
                .Err(second) -> {
                    print(first.kind == encoding.EncodingErrorKind.IO)
                    print(first.reason == second.reason)
                }
            }
        }
    }
}
