
use {
    encoding: core.encoding
    json: core.encoding.json
    jsonl: core.encoding.jsonl
    csv: core.encoding.csv
    cbor: core.encoding.cbor
    files: core.files
}

run: fn() {
    input: files.open("{work}/jsonl_bad/input.data") ?? panic("open")
    reader := jsonl.reader(input) ?? panic("reader")
    loop {
        if reader.next() == {
            .Val(_) -> {}
            .None -> {
                print("eof-missed")
                break
            }
            .Err(first) -> {
                if reader.next() == {
                    .Val(_) | .None -> { print("not-latched") }
                    .Err(second) -> {
                        print(first.byte_offset == second.byte_offset && first.reason == second.reason)
                    }
                }
                break
            }
        }
    }
}
