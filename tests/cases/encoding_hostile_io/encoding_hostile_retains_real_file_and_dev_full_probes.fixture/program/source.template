
use {
    encoding: core.encoding
    cbor: core.encoding.cbor
    files: core.files
}

reader_io: fn(reader: &cbor.CBORReader) -[IO]> Bool {
    if reader.next() == {
        .Err(error) -> return error.kind == encoding.EncodingErrorKind.IO
        .Val(_) | .None -> return false
    }
    return false
}

writer_io: fn(writer: &cbor.CBORWriter) -[IO]> Bool {
    if writer.flush() == {
        .Err(error) -> return error.kind == encoding.EncodingErrorKind.IO
        .Ok(_) -> return false
    }
    return false
}

run: fn() {
    directory_input: files.open("{work}") ?? panic("open dir")
    directory_reader := cbor.reader(directory_input) ?? panic("reader")
    print(reader_io(directory_reader))

    full_output: files.create("/dev/full") ?? panic("full")
    full_writer := cbor.writer(full_output) ?? panic("writer")
    if full_writer.write(encoding.DataEvent.Null) == {
        .Err(io_error) -> print(writer_io(full_writer))
        .Ok(wrote) -> {
            if full_writer.flush() == {
                .Err(io_error) -> print(writer_io(full_writer))
                .Ok(done) -> print(false)
            }
        }
    }
}
