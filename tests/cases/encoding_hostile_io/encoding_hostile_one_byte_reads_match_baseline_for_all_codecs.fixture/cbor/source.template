
use core.encoding as encoding
use core.encoding.cbor as cbor
use core.files as files

fn run() {
    input :: files.open("{work}/cbor/input.data") ?? panic("open")
    reader := cbor.reader(^input) ?? panic("reader")
    count := 0
    loop count < 16 {
        if &reader.next() == {
            .None -> { break }
            .Val(_) -> { count += 1 }
            .Err(first) -> {
                if &reader.next() == {
                    .Val(_) | .None -> { print("not-latched") }
                    .Err(second) -> {
                        print(first.byte_offset == second.byte_offset && first.reason == second.reason)
                    }
                }
                break
            }
        }
    }
    print(count)
    print("eof")
}
