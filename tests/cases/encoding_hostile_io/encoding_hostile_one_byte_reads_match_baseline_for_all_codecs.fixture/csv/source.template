
use core.encoding as encoding
use core.encoding.csv as csv
use core.files as files

fn run() {
    input :: files.open("{work}/csv/input.data") ?? panic("open")
    reader := csv.reader(^input) ?? panic("reader")
    if &reader.next() == {
        .Val(row) -> {
            print(row.fields[0])
            print(row.fields[1])
        }
        .None -> print("none")
        .Err(_) -> panic("first")
    }
    if &reader.next() == {
        .None -> print("eof")
        .Val(_) -> print("bad")
        .Err(_) -> panic("eof")
    }
}
