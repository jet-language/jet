
use core.encoding as encoding
use core.encoding.jsonl as jsonl
use core.files as files

fn run() {
    input :: files.open("{work}/jsonl/input.data") ?? panic("open")
    reader := jsonl.reader(^input) ?? panic("reader")
    if &reader.next() == {
        .Val(v) -> print(v.text() ?? "bad")
        .None -> print("none")
        .Err(_) -> panic("first")
    }
    if &reader.next() == {
        .Val(v) -> print(v.int() ?? -1)
        .None -> print("none2")
        .Err(_) -> panic("second")
    }
    if &reader.next() == {
        .None -> print("eof")
        .Val(_) -> print("bad-eof")
        .Err(_) -> panic("eof")
    }
}
