# Claim: the package's hot-text.list, which orders the image's text, is an input of the build identity
# Claim: an unchanged rebuild reuses the stored binary
# Claim: adding only hot-text.list (no .jet source changes) makes jet build rebuild, and the rebuilt binary runs
fixture: jet_build_rebuilds_when_the_hot_text_list_changes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet --verbose
exit: 0 # cold build
stderr: ~ "[build] cache miss -> compiling" # cold build compiles
step: jet build main.jet --verbose
exit: 0 # unchanged rebuild
stderr: ~ "[build] cache hit -> reused cached binary" # unchanged rebuild reuses the binary
stderr: !~ "[build] cache miss -> compiling" # unchanged rebuild doesn't compile
copy: variants/hot-text.list hot-text.list
step: jet build main.jet --verbose
exit: 0 # rebuild after adding the hot-text list
stderr: ~ "[build] cache miss -> compiling" # the list rebuilds
stderr: !~ "[build] cache hit -> reused cached binary" # the list is not a cache hit
step: .jet/build/main
exit: 0 # rebuilt binary runs
stdout: = "laid out\n" # rebuilt binary prints
