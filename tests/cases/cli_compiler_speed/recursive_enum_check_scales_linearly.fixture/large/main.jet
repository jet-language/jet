enum Tree {
    Leaf(Int)
    Branch(left: Tree, right: Forest)
    Tagged(label: String, body: Node)
}

enum Forest {
    Empty
    Trees([Tree])
    Linked(head: Tree, rest: Forest)
}

enum Node {
    Plain(Int)
    Holds(Tree?)
    Grows(Forest)
}

struct Layer0 {
    tree: Tree
    node: Node
}

fn use_0(layer: Layer0) -> Int {
    if layer.tree == {
        .Leaf(value) -> value
        .Branch(_, _) -> 1
        .Tagged(_, _) -> 2
    }
}

struct Layer1 {
    left: Layer0
    right: Layer0
    tree: Tree
}

fn use_1(layer: Layer1) -> Int {
    inner :: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_0(inner)
        .Branch(_, _) -> 1
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 1
        }
    }
}

