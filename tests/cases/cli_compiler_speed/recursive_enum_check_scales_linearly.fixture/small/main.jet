    left: Layer3
    right: Layer3
    tree: Tree
}

use_4: fn(layer: Layer4) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_3(inner)
        .Branch(_, _) -> 4
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 4
        }
    }
}

