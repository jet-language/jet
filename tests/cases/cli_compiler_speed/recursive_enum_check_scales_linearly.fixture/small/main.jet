Tree: enum {
    Leaf(Int)
    Branch(left: Tree, right: Forest)
    Tagged(label: String, body: Node)
}

Forest: enum {
    Empty
    Trees([Tree])
    Linked(head: Tree, rest: Forest)
}

Node: enum {
    Plain(Int)
    Holds(Tree?)
    Grows(Forest)
}

Layer0: struct {
    tree: Tree
    node: Node
}

use_0: fn(layer: Layer0) -> Int {
    if layer.tree == {
        .Leaf(value) -> value
        .Branch(_, _) -> 1
        .Tagged(_, _) -> 2
    }
}

Layer1: struct {
    left: Layer0
    right: Layer0
    tree: Tree
}

use_1: fn(layer: Layer1) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_0(inner)
        .Branch(_, _) -> 1
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 1
        }
    }
}

Layer2: struct {
    left: Layer1
    right: Layer1
    tree: Tree
}

use_2: fn(layer: Layer2) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_1(inner)
        .Branch(_, _) -> 2
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 2
        }
    }
}

Layer3: struct {
    left: Layer2
    right: Layer2
    tree: Tree
}

use_3: fn(layer: Layer3) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_2(inner)
        .Branch(_, _) -> 3
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 3
        }
    }
}

