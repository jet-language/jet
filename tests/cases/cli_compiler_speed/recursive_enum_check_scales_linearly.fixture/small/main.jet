    left: Layer4
    right: Layer4
    tree: Tree
}

use_5: fn(layer: Layer5) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_4(inner)
        .Branch(_, _) -> 5
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 5
        }
