Layer6: struct {
    left: Layer5
    right: Layer5
    tree: Tree
}

use_6: fn(layer: Layer6) -> Int {
    inner: layer.left
    if layer.tree == {
        .Leaf(value) -> value + use_5(inner)
        .Branch(_, _) -> 6
        .Tagged(_, body) -> if body == {
            .Plain(value) -> value
            .Holds(_) -> 0
            .Grows(_) -> 6
        }
    }
}

run: fn() {
    print(use_0(Layer0{tree: Tree.Leaf(1), node: Node.Plain(2)}))
}
