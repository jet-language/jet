# Claim: a file a comptime block reads is an input of the build identity
# Claim: an unchanged rebuild reuses the stored binary
# Claim: editing only that file (no .jet source changes) makes jet build rebuild, and the new binary has the new bytes
fixture: jet_build_rebuilds_when_a_comptime_input_changes.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/store
env: JETPACK_ROOT={work}/jetpack
step: jet build main.jet --verbose
exit: 0 # cold build
stderr: ~ "[build] cache miss -> compiling" # cold build compiles
step: .jet/build/main
exit: 0 # cold binary runs
stdout: = "first build\n" # cold binary embeds data.txt
step: jet build main.jet --verbose
exit: 0 # unchanged rebuild
stderr: ~ "[build] cache hit -> reused cached binary" # unchanged rebuild reuses the binary
stderr: !~ "[build] cache miss -> compiling" # unchanged rebuild doesn't compile
copy: variants/edited.txt data.txt
step: jet build main.jet --verbose
exit: 0 # rebuild after editing the comptime input
stderr: ~ "[build] cache miss -> compiling" # edited input rebuilds
stderr: !~ "[build] cache hit -> reused cached binary" # edited input is not a cache hit
step: .jet/build/main
exit: 0 # rebuilt binary runs
stdout: = "edited input\n" # rebuilt binary embeds the edited bytes
