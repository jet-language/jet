// D-PROTO1 / D-PROTO2: declare the exchange once; compiler generates ordered
// Payment.Client / Payment.Server handles over #SingleUse + typestate (E0150
// on out-of-order send/recv). See tests/ui/protocol_out_of_order.jet.
struct ProtocolError {
    msg: String
}

protocol Payment {
    client: Hello(version: Int)
    server: Ack(session: Int)
    client: Charge(cents: Int)
    server: Receipt(id: Int)
}

fn drive(h: ^Payment.Client) {
    h1 :: h.Hello(1) ?? panic("hello failed")
    h2 :: h1.recv_Ack() ?? panic("ack failed")
    h3 :: h2.Charge(500) ?? panic("charge failed")
    h3.recv_Receipt()
}

fn run() {
    h :: Payment.Client.client()
    drive(^h)
    print("payment complete")
}
