// D-META-USER1=A: a source rule with a body adds an ordinary method. A
// template binding is spliced with `$` (D-NAME-SPLICE1=B): `impl $tname`
// names the target type and `$marker_count` reads the build-time value.
Audited: struct {
    impl Marker {
        sites: [.Type]
    }
}

AddGreeting: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            tname: target.name
            marker_count: target.markers.len()
            impl $tname {
                greeting: fn(self) -> String { "hello" }

                marker_count: fn(self) -> Int { $marker_count }
            }
        }
    }
}

#[Audited, AddGreeting]
Person: struct {
    name: String
}

run: fn() {
    person: Person{name: "ada"}
    print(person.greeting())
    print(person.marker_count())
}
