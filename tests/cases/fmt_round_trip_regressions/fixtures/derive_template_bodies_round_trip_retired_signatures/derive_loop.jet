// D-STRUCT-ONCE1=A: one typed `comptime loop` mechanism reaches derive/marker bodies,
// root impl items, and interpolated test declarations.
derive T.FieldNames {
    comptime loop field in T.$fields {
        method: "field_{field.$name}"
        $method: fn(self) -> String { field.$name }
    }
}

AddMarkerFields: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            type_name: target.$name
            comptime loop field in target.$fields {
                method: "marked_{field.$name}"
                impl $type_name {
                    $method: fn(self) -> String { field.$name }
                }
            }
        }
    }
}

#[FieldNames, AddMarkerFields]
Point: struct {
    x: Int
    y: Int
}

Case: struct {
    n: Int
}

CASES: comptime { [Case]{Case{n: 1}, Case{n: 2}} }

comptime loop T in [Point] {
    impl T {
        generated: fn(self) -> String { "generated" }
    }
}

comptime loop case in CASES {
    #Test("case {case.n}") {
        .measure {
            assert(case.n > 0)
        }
    }
}

run: fn() {
    point := Point{x: 1, y: 2}
    print(point.field_x())
    print(point.field_y())
    print(point.marked_x())
    print(point.marked_y())
    print(point.generated())
}
