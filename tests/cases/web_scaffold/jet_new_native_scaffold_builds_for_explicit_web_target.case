# tests/web_scaffold.rs::jet_new_native_scaffold_builds_for_explicit_web_target at tests/web_scaffold.rs:275; hand-port
# The ui scaffold runs natively, then builds for an explicit web target into index.html, app.js and app.wasm; jet dev
# serves the page and the generated app renders its greeting into a DOM. The Rust rustc availability guard is dropped.
# The authority grants are read from package.jet text instead of the Rust PackageFacts parser (EFFECT_LEAF_EXEC_ARGS is
# Exec.Args). web_dom_harness.mjs is the Rust WEB_DOM_HARNESS byte for byte; get.mjs is the Rust http_get helper.
fixture: jet_new_native_scaffold_builds_for_explicit_web_target.fixture
requires: tool:node
env: NO_COLOR=1
step: jet new demo --template ui
exit: 0
