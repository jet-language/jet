spawn dev: jet dev --port={free-port:web}
cwd: {work}/web_app
stdout: null
stderr: null
poll ready: node get.mjs {free-port:web} /__jet_dev_version until exit: 0 timeout 30s every 100ms # tests/web_scaffold.rs:56-68 wait_for_server
step page: node get.mjs {free-port:web} /
exit: 0 # tests/web_scaffold.rs:261-262 the page is served
stdout: ~ "type=\"module\"" # tests/web_scaffold.rs:263-267 the page loads its Web module
stdout: ~ "src=\"./app.js\"" # tests/web_scaffold.rs:263-267
stdout: !~ "jet_main" # tests/web_scaffold.rs:268-271 the page does not know an export name
signal dev: KILL
wait: dev
exit: any # the Rust KillOnDrop guard ignores the wait status
