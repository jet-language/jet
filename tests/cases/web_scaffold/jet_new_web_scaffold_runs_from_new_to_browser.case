step test: jet test
cwd: {work}/web_app
exit: 0
stdout: !~ "E-WEB-TIR-UNSUPPORTED" # tests/web_scaffold.rs:157-170 web scaffold test has no scaffold drift diagnostic
stderr: !~ "E-WEB-TIR-UNSUPPORTED" # tests/web_scaffold.rs:157-170
stdout: !~ "E2937" # tests/web_scaffold.rs:157-170 web scaffold test has no scaffold drift diagnostic
stderr: !~ "E2937" # tests/web_scaffold.rs:157-170
stdout: !~ "ICE" # tests/web_scaffold.rs:157-170 web scaffold test has no scaffold drift diagnostic
