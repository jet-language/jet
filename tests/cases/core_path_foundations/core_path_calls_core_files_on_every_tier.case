# core.files.path calls core.files with the path text (#6086). core.files
# takes `String | Path`, where `Path` is the compiler's path type, while a
# bare `Path` in core.files.path names its own struct: the text is boxed as
# the callee's own union, so walk, exists, read_text and the other calls
# lower and run alike on every tier.
fixture: core_path_calls_core_files_on_every_tier.fixture
env: NO_COLOR=1
env: JET_STORE_DIR={work}/cache
env: JETPACK_ROOT={work}/jetpack
step: jet check main.jet
exit: 0
step: jet run --optimize=none main.jet
exit: 0
stdout: = core_path_calls_core_files_on_every_tier.out
step: jet run --optimize=basic main.jet
exit: 0
stdout: = core_path_calls_core_files_on_every_tier.out
step: jet run --optimize=full main.jet
exit: 0
stdout: = core_path_calls_core_files_on_every_tier.out
