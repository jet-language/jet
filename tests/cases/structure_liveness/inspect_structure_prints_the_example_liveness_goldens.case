# The example plants one of each liveness verdict (an unused binding, an
# unused import, an unused private function, an unreachable package export);
# `jet inspect structure` prints their facts as the example's text and JSON goldens.
step: jet inspect structure {root}/Examples/Tooling/StructureLiveness.jet
exit: 0
stdout: = ../../../Examples/Tooling/StructureLiveness.structure.out
step: jet inspect structure --json {root}/Examples/Tooling/StructureLiveness.jet
exit: 0
stdout: = ../../../Examples/Tooling/StructureLiveness.structure.json
