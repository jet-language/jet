# Port of tests/learn.rs:28-80; combined() is stdout then stderr, not one chosen stream.
# PENDING-GRAMMAR: stdout+stderr and file is-file (TestW3b batch two).
env: NO_COLOR=1
step: jet learn --watch=off --json
exit: nonzero
stdout+stderr: ~ "\"schema\":\"jet.learn/v1\"" # original predicate
stdout+stderr: ~ "\"task_id\":\"language.tir-stmt.loop.predict\"" # original predicate
stdout+stderr: ~ "\"source_identity\"" # original predicate
stdout+stderr: ~ "\"input_identity\"" # original predicate
stdout+stderr: ~ "\"oracle\"" # original predicate
file: .jet/learn/feedback/loop.jet is-file
file: .jet/learn/feedback/loop.jet ~ "0..<2" # original predicate
file: .jet/learn/feedback/progress/language_tir_stmt_loop_predict.json is-file
