
use core.mem
fn run() {
    values := [31, 47]
    cell :: values[0]
    #Unsafe("the list element remains heap-owned") {
        addr :: mem.address_of(cell)
        pointer :: mem.Ptr<Int>.from_addr(addr)
        print(pointer.*)
        via_volatile :: mem.volatile_read(pointer)
        print(via_volatile)
    }
}
