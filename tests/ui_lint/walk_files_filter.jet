use {
    fs :: core.files
    files :: core.files
}

fn run() {
    root :: "."
    #Allow(jet.WalkFilesFilter, "the fixture exercises suppression of this occurrence") loop entry in fs.walk(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in fs.walk(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in files.walk(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    entries :: fs.walk(root) ?? []
    loop entry in entries {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in fs.walk_parallel(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
    }

    loop entry in fs.walk(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.path)
        break
    }

    loop entry in fs.walk(root) ?? [] {
        if entry.is_dir {
            next
        }
        print(entry.is_dir)
    }
}
