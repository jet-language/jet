fn optional_value() ?Int -> None

fn propagate() ?Int -> {
    loop _ in 0..<3 -> _value :: optional_value()?("reading optional")
    return Val(0)
}

fn run() {
    padded :: "  value  "
    view :: padded.trim()
    out := [String]{}
    loop _ in 0..<3 -> out.push(view)
    print(out.len())
    reader :: Reader.over([U8]{1, 2, 3, 4, 5, 6})
    loop _ in 0..<3 {
        _byte :: reader.read_u8() ?? panic("read")
        if reader.read_u8() == {
            .Ok(byte) -> { print(byte) }
            .Err(error) -> print(error)
        }
    }
    _propagated :: propagate() ?? 0
}
