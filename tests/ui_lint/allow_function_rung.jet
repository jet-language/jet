// Function rung (ladder L-09): `#Allow(jet.LintName, "why")` on a
// function silences that lint in the whole body, and only that lint.
#Allow(jet.SubjectShorthandNesting, "the fixture exercises the function rung")
allowed_lengths: fn(words: [[String]]) -> [[Int]] {
    words.map(.map(.len()))
}

#Allow(jet.FloatMoney, "a different lint leaves this one reported")
other_lint: fn(words: [[String]]) -> [[Int]] {
    words.map(.map(.len()))
}

Price: struct {
    #Allow(jet.FloatMoney, "the fixture exercises the field rung")
    amount: Float
}

run: fn() {
    words: [["a", "bb"]]
    print(allowed_lengths(words))
    print(other_lint(words))
    print(Price{amount: 2.5}.amount)
}
