// L2421 reports `fail` and `stop`: each public body reaches `panic` on its one
// path. `declared` writes `-> Never` and `maybe` can return first, so neither
// is reported.
fail: fn(message: String) {
    panic(message)
}

stop: fn(code: Int) -> Int {
    print("stopping with {code}")
    panic("stopped")
}

declared: fn() -> Never {
    panic("declared")
}

maybe: fn(flag: Bool) {
    if flag -> return
    panic("flag was false")
}

run: fn() {
    maybe(true)
}
