// L2421 over the divergence fixed point (Func.diverges).
// Direct: `exit_now` panics itself and `spin` loops with no `break`.
// Transitive: `stop` only calls `exit_now`, and `fail` only calls `stop`.
// Mutual recursion: `ping` and `pong` only call each other, so no path of
// theirs proves a stop and neither is reported. `guarded` can return before
// it calls `fail`, so it is not reported either.
exit_now: fn(code: Int) {
    print("exit {code}")
    panic("exit")
}

spin: fn() {
    loop {
        print("spinning")
    }
}

stop: fn(code: Int) {
    exit_now(code)
}

fail: fn(message: String) {
    print(message)
    stop(1)
}

ping: fn(n: Int) -> Int {
    pong(n + 1)
}

pong: fn(n: Int) -> Int {
    ping(n - 1)
}

guarded: fn(code: Int) {
    if code == 0 -> return
    fail("code {code}")
}

run: fn() {
    guarded(0)
}
