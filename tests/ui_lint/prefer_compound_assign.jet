Player: struct {
    hp: Int
}

damage: fn(p: &Player, amount: Int) { p.hp = p.hp - amount }

heal: fn(p: &Player, amount: Int) { p.hp = p.hp + amount }

tally: fn() {
    n := 0
    n = n + 1
    // Already compound — must not warn (including after any hooked rewrite).
    n += 1
    // Parenthesized RHS still counts as the long form.
    n = (n + 1)
}

index_stay_expanded: fn() {
    xs := [1, 2, 3]
    // Indexed compound is E0164; expanded form must not get L0503.
    xs[0] = xs[0] + 1
}

run: fn() {
    p := Player{hp: 100}
    damage(&p, 30)
    heal(&p, 10)
    tally()
    index_stay_expanded()
    print(p.hp)
}
