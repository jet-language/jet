use core.compute.solve as solve
use core.files as files
use core.http.client as http_client
use core.http.client as unused_http_client

fn run() {
    response :: http_client.get("https://example.com") ?? panic("get")
    print("status={response.status()}")

    solver := solve.Solver.new(42)
    wins := 0
    loop key in 1..3 {
        loop door in 1..3 {
            passes :: key != door && key + door == 4
            solver.require(passes)
            if passes {
                wins += 1
                print("key={key} door={door}")
            }
        }
    }
    print("wins={wins}")
    print("status={solver.status()}")
    print("failures={solver.failure_count()}")
}
