#Error
enum ValidationError {
    Invalid
}

fn validate(n: Int) ValidationError! {
    if n < 0 -> return Err(ValidationError.Invalid)
}

fn measure(n: Int) -> Int ValidationError! {
    if n < 0 -> return Err(ValidationError.Invalid)
    Ok(n)
}

fn check(n: Int) -> Int ValidationError! {
    _ :: validate(n)
    validate(n)
    _ :: measure(n)
    Ok(n)
}

fn run() {
    print(check(3))
}
