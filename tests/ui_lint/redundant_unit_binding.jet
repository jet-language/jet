#Error
ValidationError: enum {
    Invalid
}

validate: fn(n: Int) ValidationError! {
    if n < 0 -> return Err(ValidationError.Invalid)
}

measure: fn(n: Int) -> Int ValidationError! {
    if n < 0 -> return Err(ValidationError.Invalid)
    Ok(n)
}

check: fn(n: Int) -> Int ValidationError! {
    _: validate(n)
    validate(n)
    _: measure(n)
    Ok(n)
}

run: fn() {
    print(check(3) ?? 0)
}
