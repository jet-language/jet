Person: struct {
    name: String
    dept: String
}

// Copies each department's group out of a Map the caller lends and back,
// newest first: the lint fires.
by_dept_copied: fn(people: [Person], groups: &[String: [Person]]) {
    loop p in people {
        group := groups.get(p.dept) ?? [Person]{}
        group.insert(0, p.copy())
        groups[p.dept] = group
    }
}

// Grows each department's group in place, newest first: no lint.
by_dept_in_place: fn(people: [Person]) -> [String: [Person]] {
    groups := [String: [Person]]{}
    loop p in people {
        if !groups.has_key(p.dept) -> groups[p.dept] = [Person]{}
        groups[p.dept].insert(0, p.copy())
    }
    groups
}

// Pushes onto each department's group of a Map the function declares: the
// build grows the entry in place, so no lint.
by_dept_moved: fn(people: [Person]) -> [String: [Person]] {
    groups := [String: [Person]]{}
    loop p in people {
        group := groups.get(p.dept) ?? [Person]{}
        group.push(p.copy())
        groups[p.dept] = group
    }
    groups
}

// Pushes onto a group taken with `[]`: no lint either.
names_by_dept: fn(people: [Person]) -> [String: [String]] {
    names := [String: [String]]{}
    loop p in people {
        group := names.get(p.dept) ?? []
        group.push(p.name.copy())
        group.push("-")
        names[p.dept] = group
    }
    names
}

// Seeds each group with a header: the build seeds the entry with it and
// grows it in place, so no lint.
titled_by_dept: fn(people: [Person]) -> [String: [String]] {
    titled := [String: [String]]{}
    loop p in people {
        group := titled.get(p.dept) ?? ["header"]
        group.push(p.name.copy())
        titled[p.dept] = group
    }
    titled
}

// Can `break` between the take and the store, past the store: the Map must
// not hold a half-grown group then, so the group is copied and the lint
// fires.
named_by_dept: fn(people: [Person]) -> [String: [String]] {
    names := [String: [String]]{}
    loop p in people {
        group := names.get(p.dept) ?? []
        if p.name == "" -> break
        group.push(p.name.copy())
        names[p.dept] = group
    }
    names
}

run: fn() {
    people: [Person]{{name: "Ada", dept: "eng"}, {name: "Bo", dept: "ops"}, {name: "Cy", dept: "eng"}}
    copied := [String: [Person]]{}
    by_dept_copied(people, copied)
    print(copied.len())
    print(by_dept_in_place(people).len())
    print(by_dept_moved(people).len())
    print(names_by_dept(people)["eng"])
    print(titled_by_dept(people)["eng"])
    print(named_by_dept(people)["eng"])
}
