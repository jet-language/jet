// L0511: binding `err` shadows the ambient failure report a `??` fallback
// exposes. The failure domain must itself be a valid error type (E2417), so
// this uses `Err` rather than a bare value type.
fn fail() String !Err -> Err("bad")

fn run() {
    err :: "user binding"
    value :: fail() ?? "fallback"
    print(value)
    print(err)
}
