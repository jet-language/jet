use compute: core.compute

loss: fn(w: Tensor, x: Tensor) -> Tensor Never! { compute.mul(w, x) ?? panic("loss") }

run: fn() {
    w: compute.from_list([2.0]) ?? panic("w")
    x: compute.from_list([4.0]) ?? panic("x")
    { w: dw, x: dx }: compute.gradient(loss).call(w, x)
    print("grad:{compute.to_list(dw)}")
    print("grad_x:{compute.to_list(dx)}")
}
