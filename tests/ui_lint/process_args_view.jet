use core.process as process
use core.process as p

fn run() {
    #allow(process_args_view) allowed :: process.argv().skip(1)
    args :: process.argv().skip(1)
    raw :: process.argv()
    aliased :: raw.skip(1)
    indexed :: process.argv().skip(0)
    alternate :: p.argv().skip(1)
    print(allowed.len())
    print(args.len())
    print(raw.len())
    print(aliased.len())
    print(indexed.len())
    print(alternate.len())
}
