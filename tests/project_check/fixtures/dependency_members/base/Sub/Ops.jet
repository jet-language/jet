fn widen(end: Int) -> Int Never! {
    hidden :: Hidden{value: end}
    if hidden.value > LIMIT -> return hidden.value
    hidden.value + 1
}

impl Span {
    pub fn width(self) -> Int Never! { self.end - self.start }
}

pub fn kind_value(kind: Kind) -> Int Never! {
    if kind == {
        .Alpha -> 0
        .Beta(v) -> v + make_span(0, 1).width()
    }
}

pub struct Label {
    pub text: String
    pub inner: [Shape]
}

pub fn same_shape(a: Shape, b: Shape) -> Bool Never! {
    a == b
}

// A compile-time table of a sibling file's enum with a named payload.
pub MARKS :: prep { [Mark]{ Mark.Point{at: Span{start: 0, end: 2}}, Mark.Blank } }
