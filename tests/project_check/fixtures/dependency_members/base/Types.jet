// D-MOD-CYCLE1=A: the files of a package share one namespace. Types.jet and
// Sub/Ops.jet call each other, and Ops.jet extends Span declared here.
Span: struct {
    start: Int
    end: Int
}

Kind: enum { Alpha Beta(Int) }

// Shape and Sub/Ops.jet's Label hold each other, so their equality derives
// as one cycle across two files.
Shape: enum {
    Dot
    Boxed(bounds: Span)
    Labeled(label: Label)
}

Note: struct {
    span: Span?
}

Mark: enum {
    Blank
    Point(at: Span)
}

LIMIT: 7

Hidden: struct { value: Int }

make_span: fn(start: Int, end: Int) -> Span Never! {
    Span{start: start, end: widen(end)}
}
