// No tracked .jet file under the source trees keeps an impl outside
// its type's body. The guard runs the one impl placement rule that `jet check
// --style` runs (jet_parser's parser_impl_placement_lints, L0535) over every
// tracked .jet file under IP_ROOTS, tests/cases/cross excepted, and reports
// each finding as `path:line: what`. A Core or Prelude file parses as the
// compiler reads it, with its `__` names admitted (parse_generated_source).
// An impl whose head carries a parse error is that error's to report (rule f);
// the file's other impls are checked.
use {
    jet_foundation.[Diagnostic, ParseResult]
    jet_parser.[parse_generated_source, parse_source, parser_impl_placement_lints]
    corpus_manifest.[guards_enter_root]
    ip_files: core.files
    ip_process: core.process
}

// The source trees the rule covers.
IP_ROOTS: [String]{"Compiler", "Core", "Jetpack", "Examples", "tests", "Tools"}
// The cross-language cases hold other languages' sources, not Jet's own.
IP_EXCLUDED: "tests/cases/cross/"

ip_parse: fn(path: String, source: String) -> ParseResult {
    if path.starts_with("Core/") || path.starts_with("Compiler/Prelude/") -> return parse_generated_source(source.bytes())
    parse_source(source.bytes())
}

// `path:line: what` for each impl placement finding in `source`.
ip_findings: fn(path: String, source: String) -> [String] {
    parsed: ip_parse(path, source)
    bytes: source.bytes()
    found := [String]{}
    loop diagnostic in parser_impl_placement_lints(parsed.program, bytes, parsed.diagnostics) {
        at: if diagnostic.span == .Val(span) -> span.start else -> 0
        line := 1
        loop index in 0..<at {
            if bytes[index] == 10 -> line += 1
        }
        found.push("{path}:{line}: {diagnostic.what}")
    }
    found
}

// The tracked .jet files under IP_ROOTS, outside IP_EXCLUDED.
ip_tracked_sources: fn() -> [String] {
    argv := [String]{"git", "ls-files", "--"}
    loop root in IP_ROOTS -> argv.push(root)
    listed: ip_process.cmd(argv).stdout(.Capture).stderr(.Capture).run() ?? panic("run git ls-files: {err}")
    assert(listed.code == 0, "git ls-files failed: {ip_process.combined_output(listed).trim()}")
    paths := [String]{}
    loop line in ip_process.stdout_lines(listed) {
        if line.ends_with(".jet") && !line.starts_with(IP_EXCLUDED) -> paths.push(line.copy())
    }
    paths
}

#Test("the impl placement rule flags a planted detached impl and skips one with a head error") {
    planted: "Tile: struct {{\n    size: Int\n}}\n\nimpl Tile {{\n    area: fn(self) -> Int {{ self.size * self.size }}\n}}\n"
    assert_eq(ip_findings("planted.jet", planted), [String]{"planted.jet:5: `impl Tile` sits outside the body of `Tile`"})
    nested: "Tile: struct {{\n    size: Int\n\n    area: fn(self) -> Int {{ self.size * self.size }}\n}}\n"
    assert_eq(ip_findings("nested.jet", nested).len(), 0)
    broken: "Tile: struct {{\n    size: Int\n}}\n\nimpl Tile. {{\n    area: fn(self) -> Int {{ self.size }}\n}}\n"
    assert_eq(ip_findings("broken.jet", broken).len(), 0)
}

#Test("no tracked .jet file keeps an impl outside its type's body") {
    guards_enter_root()
    paths: ip_tracked_sources()
    assert(paths.len() > 10000, "the tracked .jet corpus must be readable, found {paths.len()} files")
    offenders := [String]{}
    loop path in paths {
        source: ip_files.read(path) ?? panic("read {path}: {err}")
        loop finding in ip_findings(path, source) -> offenders.push(finding)
    }
    assert(offenders.len() == 0, "{offenders.len()} impl(s) sit outside their type's body; move each in (`jet fix --style FILE` lifts most):\n{offenders.join("\n")}")
}
