use ds_files: core.files

// Snapshot-scan gates of the deleted tests/diagnostics_coverage.rs:683-1189.
// Rows, report openers and the rendered corpus come from the dc_* helpers in
// diagnostics_coverage.jet.

// tests/diagnostics_coverage.rs:843-849: direct fixture directories that carry
// rendered CLI and tool reports.
DS_REPORT_FIXTURE_DIRS: [(directory: String, suffix: String)]{
    (directory: "tests/cli", suffix: ".txt"),
    (directory: "tests/release", suffix: ".txt"),
    (directory: "tests/fixtures/cli-diagnostics", suffix: ".stderr"),
    (directory: "tests/fixtures/jetpack-diagnostics", suffix: ".stderr"),
    (directory: "tests/fixtures/module-eval-diagnostics", suffix: ".stderr"),
}

// Whether a UI source is an imported fixture module (`// @fixture_module`),
// which the UI harness never runs on its own.
ds_fixture_module: fn(source: String) -> Bool {
    loop raw in source.split("\n") {
        line: raw.trim().copy()
        if !line.starts_with("//") -> next
        directive: dc_slice(line, 2, line.count_bytes()).trim().copy()
        if directive == "@fixture_module" || directive.starts_with("@fixture_module ") || directive.starts_with("@fixture_module\t") -> return true
    }
    false
}

// The expected snapshot of every UI entry under `directory`, derived the way
// the UI harness derives it: a project directory (`run.jet`/`main.jet`) owns
// `<dir>/stderr`, a workspace directory owns `<dir>.stderr`, and a loose
// source owns `<stem>.stderr`, or `<stem>.warn` in a lint corpus.
ds_ui_expected: fn(directory: String, lint: Bool, out: &[String]) {
    if !ds_files.exists(directory) -> return
    loop child in (ds_files.list_dir(directory) ?? panic("list {directory}: {err}")) {
        if child.name.starts_with(".") -> next
        shown: ds_files.join(directory, child.name)
        if child.is_dir {
            if ds_files.exists(ds_files.join(shown, "run.jet")) || ds_files.exists(ds_files.join(shown, "main.jet")) {
                out.push(ds_files.join(shown, "stderr"))
            } else if ds_files.exists(ds_files.join(shown, "workspace.jet")) {
                out.push("{shown}.stderr")
            } else {
                ds_ui_expected(shown, lint, out)
            }
        } else if child.name.ends_with(".jet") && !child.name.ends_with(".fixed.jet") && child.name != "package.jet" && child.name != "workspace.jet" && !ds_fixture_module(dc_read(shown)) {
            out.push("{dc_slice(shown, 0, shown.count_bytes() - 4)}{if lint -> ".warn" else -> ".stderr"}")
        }
    }
}

// tests/diagnostics_coverage.rs:866-942: the expected snapshot of every UI and
// lint fixture plus every direct report fixture, independent of whether the
// snapshot file exists.
ds_report_fixture_snapshot_paths: fn() -> [String] {
    paths := [String]{}
    ds_ui_expected("tests/ui", false, paths)
    ds_ui_expected("tests/ui_lint", true, paths)
    loop row in DS_REPORT_FIXTURE_DIRS {
        if !ds_files.exists(row.directory) -> next
        loop child in (ds_files.list_dir(row.directory) ?? panic("list {row.directory}: {err}")) {
            if !child.is_dir && child.name.ends_with(row.suffix) -> paths.push(ds_files.join(row.directory, child.name))
        }
    }
    paths.sort()
    unique := [String]{}
    loop path in paths -> dc_add(unique, path)
    unique
}

// The report opener a line starts, or "".
ds_opener: fn(line: String) -> String {
    ids: dc_report_codes(line)
    if ids.len() == 0 -> return ""
    ids[0].copy()
}

// The registered row an opener names, by type path (`jet.UnknownCommand`) or
// by code (`E3001`); -1 when none.
ds_row: fn(rows: [DcRow], id: String) -> Int {
    loop (index, row) in rows {
        if row.name == id || row.code == id -> return index
    }
    -1
}

// The entries the accepted-failing ledger (tests/known-failing.tsv) owns.
// Their snapshots are absent or stale on an owning card until the check lands.
ds_known_failing: fn() -> [String] {
    entries := [String]{}
    loop line in dc_read("tests/known-failing.tsv").split("\n") {
        if line == "" || line.starts_with("#") -> next
        entries.push(line.split("\t").to_list()[0].copy())
    }
    entries
}

// The fixture entry a snapshot path belongs to: `<dir>` for `<dir>/stderr`,
// else the path without its snapshot extension.
ds_entry: fn(path: String) -> String {
    if path.ends_with("/stderr") -> return dc_slice(path, 0, path.count_bytes() - 7)
    loop suffix in [".stderr", ".warn", ".txt"] {
        if path.ends_with(suffix) -> return dc_slice(path, 0, path.count_bytes() - suffix.count_bytes())
    }
    path.copy()
}

// Snapshots that open a second report inside the first one's body. The
// build-action failure prints the typed `BuildAction::Failed` display line
// (`Error [jet.BuildProbeFailed]: build action ...`) between the report's
// Fix and its `More:` link.
DS_NESTED_OPENER_SNAPSHOTS: [String]{"tests/ui/build_action_failed.stderr"}

// Whether a trimmed line of a report is a non-empty `<label>: ...` part.
// tests/cli fixtures compared line-trimmed keep the parts without their indent.
ds_part: fn(line: String, label: String) -> Bool {
    trimmed: line.trim()
    trimmed.starts_with("{label}: ") && trimmed.count_bytes() > label.count_bytes() + 2
}

// tests/diagnostics_coverage.rs:1092-1110: only column-0 report openers count;
// prose, comments, quoted assertions and indented text never do.
#Test("report_openers_ignore_prose_comments_and_rust_assertion_text") {
    text: "Error [E0001]: what; Why: [E9998]; Fix: [E9997]\n// Error [E9996]\nassert!(stderr.contains(\"[E9995]\"));\n  Error [E9994]: indented\nWarning [L0001]: lint\nStop [E0002]: stop\nLint [L0002]: lint\nError [jet.UnknownCommand]: type path\n"
    assert_eq(dc_report_codes(text).join(" "), "E0001 L0001 E0002 L0002 jet.UnknownCommand")
}

// tests/diagnostics_coverage.rs:967-1067: every report a snapshot opens names a
// registered row and renders the row's whole product: a What after the
// opener, a `Why:` line, a `Fix:` line and the row's `More:` link. An opener
// naming a user-declared diagnostic type (`app.UnservedRoute`) is not a
// registry row.
#Test("diagnostic_snapshots_keep_the_complete_registered_product") {
    rows: dc_registered_rows()
    known: ds_known_failing()
    failures := [String]{}
    loop path in ds_report_fixture_snapshot_paths() {
        if !ds_files.exists(path) || dc_has(known, ds_entry(path)) || dc_has(DS_NESTED_OPENER_SNAPSHOTS, path) -> next
        lines: dc_read(path).split("\n").to_list()
        loop (start, line) in lines {
            id: ds_opener(line)
            if id == "" || (!id.starts_with("jet.") && !dc_is_code(id)) -> next
            row: ds_row(rows, id)
            if row < 0 {
                failures.push("{path}:{start + 1} opens unregistered diagnostic {id}")
                next
            }
            code: rows[row].code
            end := lines.len()
            loop (index, other) in lines {
                if index > start && index < end && ds_opener(other) != "" -> end = index
            }
            what: line.index("]: ") ?? -1
            if what < 0 || dc_slice(line, what + 3, line.count_bytes()).trim() == "" -> failures.push("{path}:{start + 1} lost What for {id}")
            why := false
            fix := false
            more := false
            loop (index, other) in lines {
                if index < start || index >= end -> next
                if ds_part(other, "Why") -> why = true
                if ds_part(other, "Fix") -> fix = true
                if other.trim() == ("More: jet-lang.dev/e/{code}") -> more = true
            }
            if !why -> failures.push("{path}:{start + 1} lost Why for {id}")
            if !fix -> failures.push("{path}:{start + 1} lost Fix for {id}")
            if !more -> failures.push("{path}:{start + 1} lost the `More: jet-lang.dev/e/{code}` link for {id}")
        }
    }
    assert_eq(failures.join("\n"), "")
}

// tests/diagnostics_coverage.rs:1070-1081: every UI, lint and report fixture
// keeps its expected snapshot, unless the accepted-failing ledger owns it.
#Test("every_report_fixture_has_a_snapshot_file") {
    known: ds_known_failing()
    missing := [String]{}
    loop path in ds_report_fixture_snapshot_paths() {
        if !ds_files.exists(path) && !dc_has(known, ds_entry(path)) -> missing.push(path)
    }
    assert_eq("diagnostic fixture lost its UI snapshot:\n{missing.join("\n")}", "diagnostic fixture lost its UI snapshot:\n")
}

// tests/diagnostics_coverage.rs:683-704, re-pointed at the current product:
// `bench` routes through the active E2101 unknown-command row, which the
// snapshot renders with its type path and link.
#Test("retired_bench_command_snapshot_keeps_registered_teaching_code") {
    rows: dc_registered_rows()
    row: ds_row(rows, "jet.UnknownCommand")
    assert(row >= 0, "the unknown-command route must stay registered")
    assert_eq(rows[row].code, "E2101")
    assert_eq(rows[row].status, "active")
    snapshot: dc_read("tests/ui/bench_command_retired_e2101.stderr")
    assert(snapshot.starts_with("Error [jet.UnknownCommand]: "), "snapshot lost the E2101 opener: {snapshot}")
    assert(snapshot.contains("`bench`"), "snapshot lost the retired spelling: {snapshot}")
    assert(snapshot.contains("\nMore: jet-lang.dev/e/E2101"), "snapshot lost the E2101 link: {snapshot}")
}

// The codes only `left` holds and the codes only `right` holds, each sorted.
ds_set_diff: fn(left: [String], right: [String]) -> (left_only: [String], right_only: [String]) {
    left_only := [String]{}
    right_only := [String]{}
    loop code in left {
        if !dc_has(right, code) -> dc_add(left_only, code)
    }
    loop code in right {
        if !dc_has(left, code) -> dc_add(right_only, code)
    }
    left_only.sort()
    right_only.sort()
    (left_only: left_only, right_only: right_only)
}

// tests/diagnostics_coverage.rs:1114-1126: the reverse coverage diff names a
// fixture code that is retired or no longer registered.
#Test("reverse_coverage_diff_names_retired_and_unregistered_fixture_codes") {
    diff: ds_set_diff([String]{}, dc_report_codes("Error [E0004]: retired\nError [E9999]: no longer registered\n"))
    assert_eq(diff.left_only.len(), 0)
    assert_eq(diff.right_only.join("\n  "), "E0004\n  E9999")
}

// tests/diagnostics_coverage.rs:1171-1189: the voice scan covers the owned
// runtime and CLI artifacts. tests/cli/repl_e1801.txt left the tree with the
// Rust REPL fixture and is not required.
#Test("diagnostic_voice_scope_includes_owned_runtime_artifacts") {
    paths: dc_snapshot_texts().map(snapshot -> snapshot.path)
    loop expected in ["tests/fixtures/module-eval-diagnostics/E0970.stderr", "tests/fixtures/module-eval-diagnostics/E0971.stderr", "tests/cli/doctor_l2101.txt", "tests/cli/fetch_no_git_e1203.txt"] {
        assert(dc_has(paths, expected), "voice scan omitted {expected}")
    }
}
