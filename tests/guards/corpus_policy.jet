policy_test_canonical_source_exception: fn() {
    manifest := policy_manifest()
    manifest.exceptions.push(PolicyExceptionRow{rule: "entry-explicit", selector: "file:Examples/Basics/Hello.jet", site: "stmt:top-level@0..0", expected: "1", protocol: "fixture", reason: "planted"})
    error: "exception entry-explicit file:Examples/Basics/Hello.jet requires an expert-lesson or negative-diagnostic source, found CanonicalTeaching"
    assert(policy_validate_manifest(manifest).contains(error), "canonical source cannot absorb a violation")
}
