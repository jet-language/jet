    guards_enter_root()
    policy_test_invalid_manifest_rows()
}
policy_test_duplicate_and_provenance_violations: fn() {
    manifest := policy_manifest()
    manifest.sources.push(manifest.sources[0])
    manifest.artifacts.push(PolicyArtifactRow{selector: "family:planted", producer: "producer:new.rs#render", kind: "generated-output", reason: "planted"})
    errors: policy_validate_manifest(manifest)
    assert(errors.contains("duplicate source selector {manifest.sources[0].selector}"), "duplicate source must fail")
    assert(errors.contains("artifact family:planted names unknown producer producer:new.rs#render"), "missing provenance must fail")
}
#Test("corpus manifest validation planted duplicate and provenance violations") {
    guards_enter_root()
    policy_test_duplicate_and_provenance_violations()
}
policy_test_exception_source_roles: fn() {
    manifest: policy_manifest()
    loop exception in manifest.exceptions {
        assert(exception.selector.starts_with("file:"), "exceptions use exact file selectors")
        source: policy_source_row(manifest, policy_selector_path(exception.selector)) ?? panic("exception source is classified")
        assert(source.role == "expert-lesson" || source.role == "negative-diagnostic", "exception requires expert or negative source")
    }
}
#Test("exceptions_are_limited_to_expert_or_negative_sources") {
