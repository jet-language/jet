policy_test_unclassified_inventory_entries: fn() {
    manifest: policy_manifest()
    error: policy_audit_inventory(manifest, [String]{"unclassified/new-maintained-program.jet"}, [String]{}).join("\n")
    assert(error.contains("unclassified eligible source"), "a synthetic source without a classification must fail")
    assert(error.contains("rule=corpus-inventory"), "inventory rule identity")
    assert(error.contains("site=inventory:source@0..0"), "inventory byte site")
    assert(error.contains("replacement="), "inventory replacement")
    assert_eq(error, "unclassified eligible source: unclassified/new-maintained-program.jet; file=unclassified/new-maintained-program.jet; rule=corpus-inventory; site=inventory:source@0..0; why=every maintained source and generated producer needs an explicit manifest boundary; replacement=add one exact manifest row with its role, owner, reason, and provenance")
    producer_error: policy_audit_inventory(manifest, [String]{"Examples/Basics/Hello.jet"}, [String]{"producer:new.rs#render"}).join("\n")
    assert(producer_error.contains("unclassified generated-source producer"), "a synthetic producer without provenance must fail")
    assert_eq(policy_audit_inventory(manifest, [String]{"Examples/Basics/Hello.jet"}, [String]{"producer:Jetpack/Integrations/Source/Foreign/Binders/Lua.jet#pkg_lua_render_jet"}), [String]{})
}
#Test("inventory_rejects_new_source_or_producer_without_a_row") {
    guards_enter_root()
    policy_test_unclassified_inventory_entries()
}
policy_test_occurrence_scoped_exceptions: fn() {
    manifest: policy_manifest()
    selector: "tests/ui/args_spec_bad_parse_arity.jet"
    candidate: PolicyOccurrence{file: selector, rule: "raw-cli-fixed-shape", site: "call:process.args@0..0"}
    assert_eq(policy_validate_occurrences(manifest, selector, [PolicyOccurrence]{candidate}), None)
    duplicate: policy_validate_occurrences(manifest, selector, [PolicyOccurrence]{candidate, candidate}) ?? panic("a second occurrence cannot reuse one exception")
    assert(duplicate.contains("expected 1"), "duplicate occurrence must fail")
    assert_eq(duplicate, "file=tests/ui/args_spec_bad_parse_arity.jet; rule=raw-cli-fixed-shape; site=call:process.args@0..0; why=expected 1 occurrence(s), found 2; replacement=remove the additional occurrence or add a distinct reviewed site")
    applied: policy_apply_exceptions(manifest, selector, [PolicyOccurrence]{candidate}) ?? panic("recorded occurrence is accepted")
    assert_eq(applied, [PolicyOccurrence]{})
}
#Test("exception_matching_is_occurrence_scoped") {
    guards_enter_root()
    policy_test_occurrence_scoped_exceptions()
}
policy_test_missing_and_shifted_exception_sites: fn() {
    manifest: policy_manifest()
    selector: "tests/ui/args_spec_bad_parse_arity.jet"
    shifted: PolicyOccurrence{file: selector, rule: "raw-cli-fixed-shape", site: "call:process.args@1..1"}
    assert_eq(policy_validate_occurrences(manifest, selector, [PolicyOccurrence]{shifted}), Val("file=tests/ui/args_spec_bad_parse_arity.jet; rule=raw-cli-fixed-shape; site=call:process.args@1..1; why=occurrence has no unique exception; replacement=add one exact exception"))
    assert_eq(policy_validate_occurrences(manifest, selector, [PolicyOccurrence]{}), Val("file=tests/ui/args_spec_bad_parse_arity.jet; rule=raw-cli-fixed-shape; site=call:process.args@0..0; why=expected 1 occurrence(s), found 0; replacement=remove the additional occurrence or update the exact reviewed site"))
    assert_eq(policy_exception_failure(manifest, selector, [PolicyOccurrence]{}), "file=tests/ui/args_spec_bad_parse_arity.jet; rule=raw-cli-fixed-shape; site=call:process.args@0..0; why=expected 1 occurrence(s), found 0; replacement=remove the additional occurrence or update the exact reviewed site")
}
#Test("corpus occurrence exceptions reject missing and shifted sites") {
    guards_enter_root()
    policy_test_missing_and_shifted_exception_sites()
}

PolicyInventoryEntry: struct { path: String, role: String, producer: String? }
PolicyProvenanceEntry: struct { producer: String, artifact: String, protocol: String }
PolicyInventory: struct {
    files: [PolicyInventoryEntry]
    producers: [String]
    artifacts: [String]
    provenance: [PolicyProvenanceEntry]
}
PolicyDiscovery: struct { paths: [String], config_candidates: [String] }

policy_skip_directory: fn(name: String) -> Bool {
    name == ".git" || name == ".claude" || name == ".opencode" || name == ".tmp" ||
    name == ".jet" || name == ".tower" || name == ".cache" || name == ".agent-worktrees" ||
    name == "plugins" || name == "node_modules" || name == "target" || name == "build" ||
    name == "cache" || name == "dist" || name == "result" ||
    name.starts_with("target-") || name.starts_with("build-") || name.starts_with("result-")
}
policy_discover_manifest_files: fn(manifest: PolicyManifest, root: String) -> PolicyDiscovery PolicyError! {
    paths := [String]{}
    candidates := [String]{}
    pending := [String]{}
    loop source in manifest.sources {
        relative: policy_selector_path(source.selector)
        if source.selector.starts_with("root:") {
            pending.push(relative)
        } else if source.selector.starts_with("file:") && policy_files.is_file(policy_join(root, relative)) {
            paths.push(relative)
        }
    }
    loop pending.len() > 0 {
        relative: pending.pop() ?? panic("pending directory is present")
        directory: policy_join(root, relative)
        metadata := policy_files.Stat?{None}
        if policy_files.stat(directory) == {
            .Ok(info) -> metadata = Val(info)
            .Err(error) -> return Err(PolicyError{message: "stat {directory}: {error}"})
        }
        info: metadata ?? panic("stat succeeded")
        if info.is_symlink -> next
        entries := [policy_files.DirEntry]{}
        if policy_files.list_dir(directory) == {
            .Ok(found) -> entries = found
            .Err(error) -> return Err(PolicyError{message: "read {directory}: {error}"})
        }
        loop entry in entries {
            child: "{relative}/{entry.name}"
            path: policy_join(root, child)
            file_type := policy_files.Stat?{None}
            if policy_files.stat(path) == {
                .Ok(found) -> file_type = Val(found)
                .Err(error) -> return Err(PolicyError{message: "stat {path}: {error}"})
            }
            kind: file_type ?? panic("entry stat succeeded")
            if kind.is_symlink -> next
            if kind.is_dir {
                // A `config/` directory beside a `package.jet` is a candidate; the
                // caller that owns the package parser decides whether the package
                // declares it (Rust `is_declared_package_config_dir`).
                if entry.name == "config" && policy_files.is_file(policy_join(root, "{relative}/package.jet")) && !candidates.contains(child) -> candidates.push(child.copy())
                if !policy_skip_directory(entry.name) -> pending.push(child)
            } else if kind.is_file && child.ends_with(".jet") {
                paths.push(child)
            }
        }
    }
    paths.sort()
    unique := [String]{}
    loop path in paths { if unique.len() == 0 || unique[unique.len() - 1] != path -> unique.push(path) }
    candidates.sort()
    Ok(PolicyDiscovery{paths: unique, config_candidates: candidates})
}
// `declared_configs` are the discovery candidates their sibling `package.jet`
// declares under `configs:`; their files are package configuration, not corpus.
policy_inventory: fn(manifest: PolicyManifest, root: String, discovery: PolicyDiscovery, declared_configs: [String]) -> PolicyInventory PolicyError! {
    errors := [String]{}
    entries := [PolicyInventoryEntry]{}
    loop path in discovery.paths {
        excluded := false
        loop config in declared_configs { if path.starts_with("{config}/") -> excluded = true }
        if excluded -> next
        source := PolicySourceRow?{None}
        source = policy_source_row(manifest, path)
        if source == None {
            errors.push(policy_inventory_error("unclassified eligible source", path, "inventory:source"))
            next
        }
        row: source ?? panic("source classification is present")
        producer := String?{None}
        loop artifact in manifest.artifacts {
            if artifact.selector == ("path:{path}") {
                producer = Val(artifact.producer)
                break
            }
        }
        if row.role == "generated-output" && producer == None -> errors.push(policy_inventory_error("generated source has no producer artifact provenance", path, "inventory:provenance"))
        entries.push(PolicyInventoryEntry{path: path, role: row.role, producer: producer})
    }
    loop artifact in manifest.artifacts {
        if !artifact.selector.starts_with("path:") -> next
        path: policy_slice_bytes(artifact.selector, 5, artifact.selector.bytes().len())
        if !policy_files.is_file(policy_join(root, path)) -> errors.push("manifest artifact is missing: {path}")
    }
    loop artifact in manifest.artifacts {
        if !artifact.selector.starts_with("path:") -> next
        path: policy_slice_bytes(artifact.selector, 5, artifact.selector.bytes().len())
        if !path.ends_with(".jet") -> next
        source: policy_source_row(manifest, path)
        if source == {
            .Val(row) -> { if row.role != "generated-output" -> errors.push("generated artifact {path} is classified as {policy_role_debug(row.role)}, not generated-output") }
            .None -> errors.push("generated artifact has no source classification: {path}")
        }
    }
    producers := [String]{}
    loop producer in manifest.producers -> producers.push(producer.selector)
    artifacts := [String]{}
    provenance := [PolicyProvenanceEntry]{}
    loop artifact in manifest.artifacts {
        artifacts.push(artifact.selector)
        loop producer in manifest.producers {
            if producer.selector == artifact.producer {
                provenance.push(PolicyProvenanceEntry{producer: producer.selector, artifact: artifact.selector, protocol: producer.protocol})
                break
            }
        }
    }
    if errors.len() > 0 -> return Err(PolicyError{message: errors.join("\n")})
    Ok(PolicyInventory{files: entries, producers: producers, artifacts: artifacts, provenance: provenance})
}
policy_test_usize_domain: fn() {
    assert_eq(policy_unsigned("+0001"), Val("1"))
    assert_eq(policy_unsigned("18446744073709551615"), Val("18446744073709551615"))
    assert_eq(policy_unsigned("18446744073709551616"), None)
    assert_eq(policy_unsigned("-1"), None)
    assert_eq(policy_unsigned("+"), None)
    assert_eq(policy_unsigned(""), None)
    assert_eq(policy_site_error("fn:run@+0001..18446744073709551615"), None)
    assert_eq(policy_site_error("fn:run@18446744073709551615..1"), Val("site end precedes start (fn:run@18446744073709551615..1)"))
}
#Test("corpus manifest usize parsing retains the full x64 domain") {
    guards_enter_root()
    policy_test_usize_domain()
}

policy_test_unicode_manifest_fields: fn() {
    manifest: policy_parse_manifest("[source]\n1\tfile:案例.jet\tcanonical-teaching\troutine\tdecision\tproof\towner\treason é") ?? panic("Unicode manifest")
    assert_eq(manifest.sources[0].selector, "file:案例.jet")
    assert_eq(manifest.sources[0].reason, "reason é")
    assert_eq(policy_selector_path(manifest.sources[0].selector), "案例.jet")
    assert_eq(policy_producer_error("producer:例.rs#生成"), None)
    assert_eq(policy_protocol_error("override:雪:differs-from-ordinary-envelope"), None)
    assert_eq(policy_manifest_failure("[未知]\n"), "manifest line 1: unknown section [未知]")
    assert_eq(policy_slice_bytes("é", 0, 0), "")
}
#Test("corpus manifest byte spans retain Unicode fields") {
    guards_enter_root()
    policy_test_unicode_manifest_fields()
}
// Rust str::split_whitespace uses Unicode White_Space, not just ASCII space.
// Scan byte spans directly; only the returned words allocate.
policy_space_width: fn(bytes: [U8], index: Int) -> Int {
    first: Int.from_u8(bytes[index])
    if first == 32 || (first >= 9 && first <= 13) -> return 1
    if index + 1 >= bytes.len() -> return 0
    second: Int.from_u8(bytes[index + 1])
    if first == 194 && (second == 133 || second == 160) -> return 2
    if index + 2 >= bytes.len() -> return 0
    third: Int.from_u8(bytes[index + 2])
    if first == 225 && second == 154 && third == 128 -> return 3
    if first == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) -> return 3
    if first == 226 && second == 129 && third == 159 -> return 3
    if first == 227 && second == 128 && third == 128 -> return 3
    0
}
policy_split_whitespace: fn(text: String) -> [String] {
    bytes: text.bytes()
    words := [String]{}
    index := 0
    start := -1
    loop index < bytes.len() {
        width: policy_space_width(bytes, index)
        if width > 0 {
            if start >= 0 -> words.push(policy_slice_bytes(text, start, index))
            start = -1
            index += width
        } else {
            if start < 0 -> start = index
            index += 1
        }
    }
    if start >= 0 -> words.push(policy_slice_bytes(text, start, bytes.len()))
    words
}

// Keep byte-exact control characters without unsupported lexer escapes.
policy_byte_text: fn(code: U8) -> String {
    String.from_bytes([U8]{code}) ?? panic("guard control byte must be UTF-8")
}

policy_test_unicode_word_splitting: fn() {
    nel: String.from_bytes([U8]{194, 133}) ?? panic("NEL UTF-8")
    nbsp: String.from_bytes([U8]{194, 160}) ?? panic("NBSP UTF-8")
    emspace: String.from_bytes([U8]{226, 128, 131}) ?? panic("EM SPACE UTF-8")
    assert_eq(policy_split_whitespace("jet{nel}run{nbsp}file{emspace}"), [String]{"jet", "run", "file"})
    carriage_return: policy_byte_text(U8{13})
    assert_eq(policy_split_whitespace(" \t{carriage_return}\n"), [String]{})
    assert_eq(policy_split_whitespace("例{emspace}子"), [String]{"例", "子"})
}
#Test("corpus shared word splitting matches Unicode White_Space") {
    guards_enter_root()
    policy_test_unicode_word_splitting()
}
