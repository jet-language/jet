policy_test_invalid_manifest_rows: fn() {
    assert_eq(policy_manifest_failure("[unknown]\n"), "manifest line 1: unknown section [unknown]")
    assert_eq(policy_manifest_failure("[scope]\n1\tentry-explicit\tfile:../escape.jet\twhy"), "manifest line 2: manifest path is not a normalized relative path (../escape.jet)")
    assert_eq(policy_manifest_failure("[exception]\n1\tentry-explicit\tfile:ok.jet\tstmt:top-level@3..2\t1\tfixture\twhy"), "manifest line 2: site end precedes start (stmt:top-level@3..2)")
    assert_eq(policy_manifest_failure("[scope]\n2\tentry-explicit\tfile:ok.jet\twhy"), "manifest line 2: unsupported manifest version")
    assert_eq(policy_manifest_failure("[scope]\n1\tentry-explicit\tfile:ok.jet"), "manifest line 2: wrong field count or row outside a section")
}
