policy_test_unguarded_finding: fn() {
    manifest := policy_manifest()
    kept := [PolicyScopeRow]{}
    loop scope in manifest.scopes { if scope.rule != "entry-explicit" -> kept.push(scope) }
    manifest.scopes = kept
    assert(policy_validate_manifest(manifest).join("\n").contains("entry-explicit has no executable corpus or domain guard"), "orphan finding must fail")
}
#Test("manifest_rejects_a_finding_without_an_executable_guard") {
