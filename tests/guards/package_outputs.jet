use s6_output_files: core.files

#Test("outputs build example has no convention entry filename") {
    guards_enter_root()
    root: "Examples/Modules/Packages/OutputsBuild"
    assert(!s6_output_files.is_file("{root}/main.jet"))
    assert(!s6_output_files.is_file("{root}/run.jet"))
    assert(s6_output_files.is_file("{root}/Service/service.jet"))
    manifest: s6_output_files.read("{root}/package.jet") ?? panic("read output manifest")
    assert(manifest.contains("outputs:"), manifest)
    assert(manifest.contains("entry: service.run"), manifest)
}

// The pre-run source-law half of package_outputs.rs:153-214: the entry the
// manifest names is a top-level callable of the nested file, and no top-level
// `run` callable is left for the runner to fall back to.
#Test("nested outputs entry has no fallback run callable") {
    guards_enter_root()
    root: "tests/cases/package_outputs/nested_outputs_entry_invokes_leaf_on_every_run_tier.fixture"
    assert(!s6_output_files.is_file("{root}/runner.jet"))
    assert(s6_output_files.is_file("{root}/src/cli/main.jet"))
    manifest: s6_output_files.read("{root}/package.jet") ?? panic("read nested manifest")
    assert(manifest.contains("entry: main.cli_run"), manifest)
    source: s6_output_files.read("{root}/src/cli/main.jet") ?? panic("read nested entry")
    callables: package_outputs_top_level_callables(source)
    assert(package_outputs_names(callables, "cli_run"), "the nested entry declares no top-level `cli_run`")
    assert(!package_outputs_names(callables, "run"), "the nested entry still declares a top-level `run`")
}

// The names `source` declares as top-level callables (`name: fn…`, after
// `pub` and leading markers), read by declaration: lines inside a brace
// body (a method, a nested binding) and text in strings or comments are not
// declarations.
package_outputs_top_level_callables: fn(source: String) -> [String] {
    names := [String]{}
    depth := 0
    loop line in source.lines() {
        if depth == 0 && package_outputs_declared_callable(line) == .Val(name) -> names.push(name)
        depth += package_outputs_brace_delta(line)
    }
    names
}

package_outputs_names: fn(names: [String], wanted: String) -> Bool {
    loop name in names {
        if name == wanted -> return true
    }
    false
}

// The callable `line` declares at its start, if it declares one.
package_outputs_declared_callable: fn(line: String) -> String? {
    head := line.trim_start().copy()
    loop head.starts_with("#") {
        marker: head.bytes()
        end := 1
        nesting := 0
        loop end < marker.len() && (nesting > 0 || marker[end] != (U8{32})) {
            if marker[end] == (U8{40}) || marker[end] == (U8{91}) -> nesting += 1
            if marker[end] == (U8{41}) || marker[end] == (U8{93}) -> nesting -= 1
            end += 1
        }
        head = policy_slice_bytes(head, end, marker.len()).trim_start().copy()
    }
    if head.starts_with("pub ") -> head = policy_slice_bytes(head, 4, head.bytes().len()).trim_start().copy()
    bytes: head.bytes()
    end := 0
    loop end < bytes.len() && s3_truth_ascii_word_byte(bytes[end]) { end += 1 }
    if end == 0 -> return None
    rest: policy_slice_bytes(head, end, bytes.len()).trim_start().copy()
    if !rest.starts_with(":") || rest.starts_with("::") || rest.starts_with(":=") -> return None
    value: policy_slice_bytes(rest, 1, rest.bytes().len()).trim_start().copy()
    if !value.starts_with("fn(") && !value.starts_with("fn<") -> return None
    Val(policy_slice_bytes(head, 0, end))
}

// How much `line` deepens the brace nesting; braces in strings and after a
// `//` comment do not count.
package_outputs_brace_delta: fn(line: String) -> Int {
    bytes: line.bytes()
    delta := 0
    quoted := false
    at := 0
    loop at < bytes.len() {
        b: bytes[at]
        if {
            quoted && b == (U8{92}) -> at += 1
            quoted && b == (U8{34}) -> quoted = false
            quoted -> {}
            b == (U8{34}) -> quoted = true
            b == (U8{47}) && at + 1 < bytes.len() && bytes[at + 1] == (U8{47}) -> return delta
            b == (U8{123}) -> delta += 1
            b == (U8{125}) -> delta -= 1
        }
        at += 1
    }
    delta
}
