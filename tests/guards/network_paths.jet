// Jet tools send nothing anywhere unless the user asks: the network policy
// (Docs/spec/reference/network-policy.md) lists every toolchain path that may
// dial out, each behind an explicit trigger. In compiler source, the only way
// to reach the network is a Core network module: `core.http` and its children,
// `core.net` and its children other than the pure-data `url`, `mime` and `ip`.
// (A C import, the other door, is held by c_imports.jet.) This census lists
// every compiler source that imports or calls one. The list is closed, so a
// new network path fails here until it gets a row naming its trigger. The
// diagnostics and report paths (the JetFoundation package that holds the
// registry and the renderer, the CLI's report, explain, receipt and status
// sources, and the runtime's stop texts) are never on it.
use np_files: core.files

NP_ROOT: "Compiler"

// Folders the census does not enter: component tests, fixtures and test-kit
// probes, build output, and installed packages.
NP_SKIPPED: [String]{"Tests", "tests", "Fixtures", "fixtures", "Probes", ".jet", "target", "node_modules"}

// Core modules under `core.net` that only parse or name data.
NP_DATA_MODULES: [String]{"core.net.url", "core.net.mime", "core.net.ip"}

NetworkPathRow: struct {
    path: String
    // The explicit trigger that opens the path.
    trigger: String
}

NP_ALLOWED: [NetworkPathRow]{
    NetworkPathRow{path: "Compiler/JetCanvas/Source/Host/CanvasHost.jet", trigger: "`jet canvas` serves its page on a local port the user starts"},
    NetworkPathRow{path: "Compiler/JetCli/Source/Cli/BuildHTTPTransport.jet", trigger: "a build's declared, locked fetch under the user's Net grant"},
    NetworkPathRow{path: "Compiler/JetDevserver/Source/Transport/Request.jet", trigger: "`jet dev` serves the user's program on a local port"},
    NetworkPathRow{path: "Compiler/JetDevserver/Source/WebHost02.jet", trigger: "`jet dev` serves the user's program on a local port"},
    NetworkPathRow{path: "Compiler/JetDevserver/Source/WebHost03.jet", trigger: "`jet dev` serves the user's program on a local port"},
    NetworkPathRow{path: "Compiler/JetDevserver/Source/WebHost04.jet", trigger: "`jet dev` serves the user's program on a local port"},
}

// Whether `path` is on a diagnostics or report path.
np_report_path: fn(path: String) -> Bool Never! {
    if path.starts_with("Compiler/JetFoundation/") -> return true
    if path.starts_with("Compiler/JetCli/Source/Cli/") {
        name: path.split("/").to_list().last() ?? return false
        return name.contains("Report") || name.contains("Explain") || name.contains("Receipt") || name.starts_with("Status")
    }
    if path.starts_with("Compiler/JetRuntime/Source/") {
        name: path.split("/").to_list().last() ?? return false
        return name.starts_with("Trap") || name.ends_with("Messages.jet")
    }
    false
}

np_is_word: fn(byte: U8) -> Bool {
    value: Int{byte}
    (value >= 97 && value <= 122) || (value >= 48 && value <= 57) || value == 95 || value == 46
}

// Does `needle` start at byte `at` of `bytes`.
np_has_at: fn(bytes: [U8], at: Int, needle: String) -> Bool {
    wanted: needle.bytes()
    if at + wanted.len() > bytes.len() -> return false
    loop index in 0..<wanted.len() {
        if bytes[at + index] != wanted[index] -> return false
    }
    true
}

// The network modules `line` names: each `core.http…` or `core.net…` dotted
// path that is not a data module. In a `use` block every path counts;
// elsewhere only a call (`core.http.get(`) outside a string.
np_line_modules: fn(line: String, in_use: Bool) -> [String] {
    bytes: line.bytes()
    found := [String]{}
    quotes := 0
    at := 0
    loop at < bytes.len() {
        byte: bytes[at]
        if byte == (U8{92}) {
            at += 2
            next
        }
        if byte == (U8{34}) {
            quotes += 1
            at += 1
            next
        }
        starts: at == 0 || !np_is_word(bytes[at - 1])
        if !starts || !(np_has_at(bytes, at, "core.http") || np_has_at(bytes, at, "core.net")) {
            at += 1
            next
        }
        end := at
        loop end < bytes.len() && np_is_word(bytes[end]) -> end += 1
        // `core.http.[Headers]` names its module with a trailing dot.
        stop: if bytes[end - 1] == (U8{46}) -> end - 1 else -> end
        path: s5_grammar_slice_bytes(line, at, stop)
        data := false
        loop data_module in NP_DATA_MODULES {
            if path == data_module || path.starts_with("{data_module}.") -> data = true
        }
        called: end < bytes.len() && bytes[end] == (U8{40})
        root: path == "core.http" || path == "core.net" || path.starts_with("core.http.") || path.starts_with("core.net.")
        if root && !data && (in_use || (called && quotes % 2 == 0)) -> found.push(path)
        at = end
    }
    found
}

// Every network module `source` imports or calls.
np_modules: fn(source: String) -> [String] {
    found := [String]{}
    in_use := false
    loop line in source.lines() {
        trimmed: line.trim()
        if trimmed.starts_with("//") -> next
        if line.starts_with("use ") -> in_use = true
        loop reached in np_line_modules(line, in_use) -> found.push(reached)
        if in_use && (trimmed == "}}" || (line.starts_with("use ") && !trimmed.ends_with("{{"))) {
            in_use = false
        }
    }
    found
}

np_walk: fn(path: String, out: &[String]) {
    if !np_files.is_dir(path) {
        if path.ends_with(".jet") -> out.push(path.copy())
        return
    }
    loop child in (np_files.list_dir(path) ?? panic("list {path}: {err}")) {
        if !NP_SKIPPED.contains(child.name) -> np_walk(child.path, out)
    }
}

// The census against the closed list: one line per difference, and one per
// diagnostics or report path that reaches a network module.
np_findings: fn(found: [String:String]) -> [String] {
    findings := [String]{}
    allowed := [String:Bool]{}
    loop row in NP_ALLOWED -> allowed[row.path] = true
    loop path in found.keys() {
        if np_report_path(path) {
            findings.push("{path}: a diagnostics or report path reaches {found[path]}; diagnostics and reports never touch the network")
        } else if allowed.get(path) == None {
            findings.push("{path}: reaches {found[path]} with no NP_ALLOWED row; add one naming the user's explicit trigger, and list the path in Docs/spec/reference/network-policy.md")
        }
    }
    loop row in NP_ALLOWED {
        if found.get(row.path) == None {
            findings.push("{row.path}: reaches no network module now; delete its NP_ALLOWED row")
        }
    }
    findings.sort()
    findings
}

#Test("only the listed compiler sources reach the network, and no diagnostics or report path does") {
    guards_enter_root()
    sources := [String]{}
    np_walk(NP_ROOT, sources)
    assert(sources.len() > 1000, "the census found only {sources.len()} Jet sources")
    reports := 0
    found := [String:String]{}
    loop path in sources {
        if np_report_path(path) -> reports += 1
        modules: np_modules(np_files.read(path) ?? panic("read {path}: {err}"))
        if modules.len() > 0 -> found[path] = modules.join(", ")
    }
    assert(reports > 50, "the census found only {reports} diagnostics and report sources")
    assert_eq(np_findings(found).join("\n"), "")
}

#Test("the network census counts imports and calls, not mentions") {
    source: "use {{\n    a_http: core.http.client\n    a_url: core.net.url\n}}\nuse b_net: core.net\n// core.http.get(x) in a comment\nwhy: \"use `core.net.fetch(url)`\"\nrun: fn() {{ core.http.get(\"x\") }}\nlink: core.net.url.parse(\"x\")\n"
    assert_eq(np_modules(source), [String]{"core.http.client", "core.net", "core.http.get"})
    found := [String:String]{}
    found["Compiler/JetFoundation/Source/Diagnostics/Render.jet"] = "core.http"
    found["Compiler/JetCli/Source/Cli/New.jet"] = "core.net"
    loop row in NP_ALLOWED {
        if row.path != "Compiler/JetCanvas/Source/Host/CanvasHost.jet" {
            found[row.path] = "core.http"
        }
    }
    findings: np_findings(found)
    assert_eq(findings.len(), 3)
    assert(findings.contains("Compiler/JetFoundation/Source/Diagnostics/Render.jet: a diagnostics or report path reaches core.http; diagnostics and reports never touch the network"))
    assert(findings.contains("Compiler/JetCli/Source/Cli/New.jet: reaches core.net with no NP_ALLOWED row; add one naming the user's explicit trigger, and list the path in Docs/spec/reference/network-policy.md"))
    assert(findings.contains("Compiler/JetCanvas/Source/Host/CanvasHost.jet: reaches no network module now; delete its NP_ALLOWED row"))
}
