use control_variable_files: core.files

// A script, skill or agent rule gives `jet` a command-line control with its
// flag or setting, never its JET_* variable. The variables are the
// ones the control registry backs each flag with. A line sets one when it
// assigns it (`NAME=`), passes it to an environment call (`.env("NAME", `,
// `set_var("NAME", `), names it in a setting record (`name: "NAME"`), or, in a
// JavaScript file, keys an environment object with it (`{NAME: `).
CONTROL_VARIABLE_REGISTRY: "Compiler/JetFoundation/Source/Registry/CLIControls.jet"
CONTROL_VARIABLE_ROOTS: [String]{"Tools", ".agents", "AGENTS.md"}

CONTROL_VARIABLE_SEED: "drives an admitted seed or the released jet, and a0.0.44 has no --keep-going flag; it moves to the flag when a release carries the flags (#6606 c9)"
CONTROL_VARIABLE_TIMED: "times a seed, released or baseline jet, and its gauntlet fixture jet reads the variable; it moves to the flags when a release carries them (#6606 c9)"
CONTROL_VARIABLE_RUNTIME: "names the ledger a generated program's runtime writes; the runtime reads only the variable, and no jet command runs there"
CONTROL_VARIABLE_RECORD: "records the measurement a landed held patch was proved with"

// Every setter the roots hold today, with how many lines set the variable in
// that file and why. A new setter, and a row whose lines are gone, both fail.
CONTROL_VARIABLE_SETTERS: [(path: String, variable: String, lines: Int, why: String)]{
    (path: ".agents/skills/orchestration/SKILL.md", variable: "JET_KEEP_GOING", lines: 1, why: CONTROL_VARIABLE_SEED),
    (path: "AGENTS.md", variable: "JET_KEEP_GOING", lines: 1, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/Chain.jet", variable: "JET_KEEP_GOING", lines: 4, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/Chain.jet", variable: "JET_KEEP_GOING_REPORT", lines: 2, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/CompilerRegistries.jet", variable: "JET_KEEP_GOING", lines: 1, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/CompilerRegistries.jet", variable: "JET_MEMORY_LEDGER", lines: 3, why: CONTROL_VARIABLE_RUNTIME),
    (path: "Tools/agent/Land.jet", variable: "JET_KEEP_GOING", lines: 1, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/Land.jet", variable: "JET_KEEP_GOING_REPORT", lines: 1, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/LaneCheck.jet", variable: "JET_KEEP_GOING", lines: 2, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/orchestrator/CensusSnap2.jet", variable: "JET_KEEP_GOING", lines: 3, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/orchestrator/CensusSnap2.jet", variable: "JET_KEEP_GOING_REPORT", lines: 3, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/orchestrator/census-snap2.sh", variable: "JET_KEEP_GOING", lines: 4, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/agent/orchestrator/census-snap2.sh", variable: "JET_KEEP_GOING_REPORT", lines: 4, why: CONTROL_VARIABLE_SEED),
    (path: "Tools/perf/compile-throughput/Throughput.jet", variable: "JET_TRACE_FILE", lines: 2, why: CONTROL_VARIABLE_TIMED),
    (path: "Tools/perf/scaling/gate/Source/Gate.jet", variable: "JET_PHASE_COUNTERS", lines: 1, why: CONTROL_VARIABLE_TIMED),
    (path: "Tools/perf/scaling/gate/Source/Gate.jet", variable: "JET_TRACE_FILE", lines: 1, why: CONTROL_VARIABLE_TIMED),
    (path: "Tools/perf/scaling/harness.mjs", variable: "JET_PHASE_COUNTERS", lines: 1, why: CONTROL_VARIABLE_TIMED),
    (path: "Tools/perf/scaling/harness.mjs", variable: "JET_TRACE_FILE", lines: 1, why: CONTROL_VARIABLE_TIMED),
    (path: "Tools/tower/held/README.md", variable: "JET_OPT_DISABLE", lines: 1, why: CONTROL_VARIABLE_RECORD),
    (path: "Tools/release/Admit.jet", variable: "JET_KEEP_GOING", lines: 1, why: CONTROL_VARIABLE_SEED),
}

// The variable of every registered control, as the registry spells it.
control_variable_names: fn() -> [String] {
    text: control_variable_files.read(CONTROL_VARIABLE_REGISTRY) ?? panic("read {CONTROL_VARIABLE_REGISTRY}: {err}")
    marker: "variable: \""
    names := [String]{}
    at := 0
    loop {
        start: s5_grammar_find(text, marker, at)
        if start < 0 -> break
        begin: start + marker.bytes().len()
        end: s5_grammar_find(text, "\"", begin)
        assert(end > begin, "{CONTROL_VARIABLE_REGISTRY}: an unterminated variable name")
        names.push(s5_grammar_slice_bytes(text, begin, end))
        at = end + 1
    }
    names
}

// Whether `line` sets `name`; `script` is a JavaScript file.
control_variable_sets: fn(line: String, name: String, script: Bool) -> Bool {
    if !line.contains(name) -> return false
    if line.contains("(\"{name}\", ") || line.contains("name: \"{name}\"") -> return true
    bytes: line.bytes()
    width: name.bytes().len()
    at := 0
    loop {
        start: s5_grammar_find(line, name, at)
        if start < 0 -> return false
        after: start + width
        if (start == 0 || !decision_id_word(bytes[start - 1])) && after < bytes.len() {
            following: Int{bytes[after]}
            if following == 61 && (after + 1 >= bytes.len() || Int{bytes[after + 1]} != 61) -> return true
            if script && start > 0 && following == 58 && after + 1 < bytes.len() && (Int{bytes[after + 1]}) == 32 {
                before: Int{bytes[start - 1]}
                if before == 123 || before == 44 || before == 32 -> return true
            }
        }
        at = after
    }
}

// One `path variable` entry per line under `path` that sets a variable.
// Symbolic links, hidden entries below a root, installed node modules and
// build output are not sources.
control_variable_setters: fn(path: String, names: [String], out: &[String]) {
    if control_variable_files.is_symlink(path) -> return
    if control_variable_files.is_dir(path) {
        loop child in (control_variable_files.list_dir(path) ?? panic("list {path}: {err}")) {
            if child.name.starts_with(".") || child.name == "node_modules" || child.name == "target" -> next
            control_variable_setters(child.path, names, out)
        }
        return
    }
    text: control_variable_files.read(path) ?? return
    if !text.contains("JET_") -> return
    script: path.ends_with(".mjs") || path.ends_with(".js") || path.ends_with(".ts")
    loop line in text.lines() {
        loop name in names {
            if control_variable_sets(line, name, script) -> out.push("{path} {name}")
        }
    }
}

#Test("no script, skill or agent rule sets a control's variable where its flag serves") {
    guards_enter_root()
    names: control_variable_names()
    assert(names.contains("JET_KEEP_GOING") && names.contains("JET_MEMORY_LEDGER"), "{CONTROL_VARIABLE_REGISTRY} lists no control variables")
    found := [String]{}
    loop root in CONTROL_VARIABLE_ROOTS {
        assert(control_variable_files.is_dir(root) || control_variable_files.is_file(root), "the scanned root {root} must exist")
        control_variable_setters(root, names, found)
    }
    found.sort()
    allowed := [String]{}
    loop row in CONTROL_VARIABLE_SETTERS {
        assert(names.contains(row.variable), "{row.path}: {row.variable} is no control variable")
        assert(row.why != "", "{row.path}: {row.variable} needs a reason")
        loop _ in 0..<row.lines -> allowed.push("{row.path} {row.variable}")
    }
    allowed.sort()
    assert_eq(found.join("\n"), allowed.join("\n"))
    // The matcher sees an assignment, an environment call, a setting record
    // and a JavaScript environment key, and not a read, a comparison, a longer
    // name or a counter line.
    assert(control_variable_sets("JET_KEEP_GOING=1 jet check", "JET_KEEP_GOING", false))
    assert(control_variable_sets("spec.env(\"JET_KEEP_GOING\", \"1\")", "JET_KEEP_GOING", false))
    assert(control_variable_sets("Setting{{name: \"JET_TRACE_FILE\", value: trace}}", "JET_TRACE_FILE", false))
    assert(control_variable_sets("const env = {{JET_TRACE_FILE: run.trace}}", "JET_TRACE_FILE", true))
    assert(!control_variable_sets("process.env_get(\"JET_KEEP_GOING\")", "JET_KEEP_GOING", false))
    assert(!control_variable_sets("[ \"$JET_KEEP_GOING\" == 1 ]", "JET_KEEP_GOING", false))
    assert(!control_variable_sets("JET_KEEP_GOING_REPORT=out.tsv", "JET_KEEP_GOING", false))
    assert(!control_variable_sets("printf 'JET_PHASE_COUNTERS: {{}}'", "JET_PHASE_COUNTERS", false))
}
