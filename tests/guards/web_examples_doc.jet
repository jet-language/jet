use core.files as files
use core.text.parse as web_doc_text
// KNOWN-FAILING #4816: original Rust law also rejects app_hello.jet (no native/web/harness golden).

// tests/web_examples_doc.rs:9-43. The original nonempty corpus, indexing,
// and three-way golden existence assertions are unchanged.
fn s3_guard_web_example_docs() {
    doc :: files.read("Docs/spec/reference/web-backend-wasm.md") ?? panic("web backend doc")
    entries :: files.list_dir("Examples/features/web") ?? panic("web examples")
    count := 0
    loop entry in entries {
        if !entry.name.ends_with(".jet") -> next
        count += 1
        name :: entry.name
        assert(doc.contains(name), "{name} missing from web backend doc")
        stem :: web_doc_text.strip_suffix(name, ".jet")
        expected :: "Examples/features/expected/web/{stem}"
        assert(files.is_file("{expected}.out") || files.is_file("{expected}.web.out") || files.is_file("{expected}.harness.out"), "{name} has no golden")
    }
    assert(count > 0, "expected at least one web example")
}

#Test("web_examples_are_documented_and_have_expected_outputs") {
    s3_guard_web_example_docs()
}
