use core.files as files

fn s3_guard_core_syntax_surfaces() {
    syntax :: files.read("Docs/spec/reference/syntax-surface.jet") ?? panic("read syntax reference")
    markers :: [String]{
        "values: ...String", "[...tags", "user.[name, email]", "Stream<Int>", "yield i",
        "delay: Int", "policy audit(", "wrap(call)", "#Policy(",
    }
    loop marker in markers {
        assert(syntax.contains(marker), "syntax reference lost: {marker}")
    }
    // Rust lsp.rs function/source-spelling scans retire with that harness.
    // The protocol fixture and public diagnostic teaching remain source-independent.
    hover :: files.read("tests/lsp/02_hover.json") ?? panic("read hover protocol fixture")
    assert(hover.contains("-[IO]>"))
    assert(!hover.contains("=>"))
    variadic :: files.read("tests/ui/variadic_not_last.stderr") ?? panic("read variadic diagnostic")
    assert(variadic.contains("E1310"))
    assert(variadic.contains("Variadic parameter"))
    spread :: files.read("tests/ui/spread_bad_call.stderr") ?? panic("read spread diagnostic")
    assert(spread.contains("E1312"))
    assert(spread.contains("call spread"))
    yielded :: files.read("tests/ui/yield_type_mismatch.stderr") ?? panic("read yield diagnostic")
    assert(yielded.contains("E0807"))
    assert(yielded.contains("Stream<Int"))
    policy :: files.read("tests/ui/user_policy_bad_args.stderr") ?? panic("read policy diagnostic")
    assert(policy.contains("Policy `audit`"))
    assert(policy.contains("Fix:"))
}

#Test("Core API syntax is taught by reference editor and diagnostic surfaces") {
    s3_guard_core_syntax_surfaces()
}
