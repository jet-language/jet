use {
    s6_ratchet_files: core.files
    s6_ratchet_text: core.text.parse
}

// Retired authority vocabulary stays in fixtures, history or unrelated English.
// Boundary and allowlist rules are exact; this is not a blanket source grep.
s6_ratchet_contains_word: fn(text: String, word: String) -> Bool {
    bytes: text.bytes()
    offset := 0
    loop {
        rest: policy_slice_bytes(text, offset, bytes.len())
        found: s6_ratchet_text.find(rest, word)
        if found < 0 -> return false
        start: offset + found
        end: start + word.bytes().len()
        before := false
        after := false
        if start > 0 -> before = s3_truth_ascii_word_byte(bytes[start - 1])
        if end < bytes.len() -> after = s3_truth_ascii_word_byte(bytes[end])
        if !before && !after -> return true
        offset = end
    }
}

// Docs/audits, Docs/proposals and Docs/research keep dated evidence: agents
// may move it intact but never rewrite it, so no guard demands edits there.
// Every guard that exempts history uses this one definition.
guards_dated_evidence: fn(path: String) -> Bool {
    path.starts_with("Docs/audits/") || path.starts_with("Docs/proposals/") || path.starts_with("Docs/research/")
}

// History, generated snapshots and the bridge's frozen Rust foundation copy
// record retired spellings as they were.
s6_ratchet_history: fn(path: String) -> Bool {
    path == "Docs/spec/syntax-decisions.md" ||
    path == "Docs/spec/contributing/agent-engineering.md" ||
    path == "Docs/spec/reference/prior-art.md" ||
    guards_dated_evidence(path) || path.starts_with("Tools/agent-eval/domain-foundations/") ||
    path.starts_with("Docs/site/dist/") ||
    path.starts_with("Jetpack/Integrations/Source/Foreign/RustBridge/Support/jet-foundation/")
}

// Syntax-reconciliation guard and case fixtures spell retired words as data.
s6_ratchet_fixture: fn(path: String) -> Bool {
    path.starts_with("tests/ui/") || path.starts_with("tests/fuzz/") ||
    path == "tests/guards/syntax_reconciliation.jet" ||
    path.starts_with("tests/cases/syntax_reconciliation/") ||
    path == "Tools/notebook-test/Acceptance.jet"
}

// Fixtures spell retired words in pieces so this guard does not introduce the
// forbidden vocabulary into the very corpus it checks.
s6_ratchet_concat: fn(first: String, second: String) -> String {
    "{first}{second}"
}

s6_ratchet_producer: fn(path: String, line: String) -> Bool {
    // The Prelude marker source and its generated embedded copy.
    if path == "Compiler/Prelude/Markers.jet" || path == "Compiler/JetFoundation/Source/Policy/PreludeMarkers.jet" {
        return line.contains(s6_ratchet_concat("Abil", "ities: struct {{")) || line.contains(s6_ratchet_concat("Cap", "s: struct {{"))
    }
    if path == "Compiler/Prelude/Diagnostics.jet" {
        return line.trim_start().starts_with(s6_ratchet_concat("what: fn(self) -> String {{ \"The `#", "Grant` scope marker is retired."))
    }
    // The E0077 registry row (and the generated DiagnosticRows copies in
    // selfhost_terminators fixtures), the CLI syntax dictionary rows for the
    // retired markers, and the E0077 parser test.
    if path == "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet" ||
        (path.starts_with("tests/cases/selfhost_terminators/") && path.ends_with("/main.jet")) {
        return line.trim_start().starts_with(s6_ratchet_concat("what: \"The `#", "Grant` scope marker is retired."))
    }
    if path == "Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet" {
        return line.contains(s6_ratchet_concat("token: \"Abil", "ities\"")) || line.contains(s6_ratchet_concat("token: \"Cap", "s\""))
    }
    if path == "Compiler/JetParser/Tests/Parser/Entry02.jet" -> return line.contains("E0077")
    false
}

s6_ratchet_unrelated: fn(path: String, line: String) -> Bool {
    if path == "Jetpack/Integrations/Source/CompilerExtension/CompilerExtension.jet" -> return true
    // Terminal capabilities (terminfo sense), and the vendored, SHA-pinned
    // xkbcommon/libX11 keyboard data and the keymaps xkbcomp compiled from
    // xkeyboard-config (the caps-lock key and level).
    if path == "Compiler/JetDevserver/Source/TerminalStyleReload.jet" -> return true
    if path.starts_with("tests/data/xkb/") || ((path.starts_with("tests/cases/ui_xkb/") || path.starts_with("tests/cases/ui_backend/")) && path.ends_with(".xkb")) -> return true
    if path == "Jetpack/Recipe/Source/Build/StagedPlanRun.jet" -> return line.contains(s6_ratchet_concat("Capabil", "ity-limited"))
    if path.starts_with("Docs/spec/reference/surfaces/") -> return true
    if path == "Compiler/JetCanvas/Source/CanvasAssets/js/inspector-connections.js" -> return line.contains(s6_ratchet_concat("Capabil", "ity mismatch"))
    if path == "Compiler/JetParser/Source/Formatter/Items.jet" -> return line.contains(s6_ratchet_concat("Capabil", "ity is a sigil"))
    // The `DataInvalidationCause` variant and its generated registry rows.
    if path == "Core/Data/Data.jet" -> return line.trim() == s6_ratchet_concat("Capabil", "ity")
    if path == "Compiler/JetCli/Source/Cli/CoreStructureRows.jet" || path == "Compiler/JetFoundation/Source/Registry/CoreEnumRows.jet" ||
        path == "Compiler/JetIR/Source/CompilerOwned.jet" || path == "Compiler/JetIR/Source/RuntimeRoutes.jet" ||
        path == "Compiler/Prelude/Core.jet" -> return line.contains("DataInvalidationCause")
    if path == "Tools/ci/CompiledWorkloadPeerLauncher.jet" -> return line.contains(s6_ratchet_concat("Capabil", "ity check ----"))
    if path == "Tools/perf/scaling/corpora.mjs" -> return line.contains(s6_ratchet_concat("Capabil", "ity$"))
    if path == "Examples/Systems/CLI/AppConfig.jet" -> return line.trim_start().starts_with(s6_ratchet_concat("// Abil", "ity"))
    if path == "Examples/Network/Browser/BrowserCDP.jet" -> return line.contains(s6_ratchet_concat("Abil", "ity-gated protocol"))
    if path == "Docs/spec/spec.md" -> return line.contains(s6_ratchet_concat("Capabil", "ity parameters"))
    false
}

s6_ratchet_hits: fn(line: String) -> [String] {
    hits := [String]{}
    words: [String]{s6_ratchet_concat("Abil", "ity"), s6_ratchet_concat("Abil", "ities"), s6_ratchet_concat("Capabil", "ity"), s6_ratchet_concat("Cap", "s")}
    loop word in words {
        if s6_ratchet_contains_word(line, word) -> hits.push(word)
    }
    markers: [String]{s6_ratchet_concat("#Abil", "ities"), s6_ratchet_concat("#Cap", "s"), s6_ratchet_concat("#", "Grant"), s6_ratchet_concat("#", "grant")}
    loop marker in markers {
        if line.contains(marker) -> hits.push(marker)
    }
    identifiers: [String]{s6_ratchet_concat("KW_", "CAPS"), s6_ratchet_concat("TYPE_", "ABILITIES"), s6_ratchet_concat("CAP_", "HANDLE_TYPE"), s6_ratchet_concat("Stmt::Cap", "s")}
    loop identifier in identifiers {
        if line.contains(identifier) -> hits.push(identifier)
    }
    hits
}

s6_ratchet_authority_scan: fn(directory: String, relative: String, offenders: &[String]) {
    entries: s6_ratchet_files.list_dir(directory) ?? return
    loop entry in entries {
        kind: s6_ratchet_files.stat(entry.path) ?? next
        if kind.is_symlink -> next
        path := entry.name.copy()
        if relative != "" -> path = "{relative}/{entry.name}"
        if kind.is_dir {
            if entry.name.starts_with(".") || entry.name.starts_with("target") ||
                entry.name == "build" || entry.name == "node_modules" -> next
            s6_ratchet_authority_scan(entry.path, path, offenders)
        } else {
            if path.starts_with("Tools/tower/") -> next
            content: s6_ratchet_files.read(entry.path) ?? next
            number := 0
            loop raw in content.lines() {
                number += 1
                line: raw.copy()
                hits: s6_ratchet_hits(line)
                if hits.len() == 0 || s6_ratchet_history(path) || s6_ratchet_fixture(path) ||
                    s6_ratchet_producer(path, line) || s6_ratchet_unrelated(path, line) -> next
                offenders.push("{path}:{number}: {hits}")
            }
        }
    }
}

s6_ratchet_authority_vocabulary: fn() {
    offenders := [String]{}
    s6_ratchet_authority_scan(".", "", offenders)
    assert(offenders.len() == 0, "retired authority vocabulary escaped its fixture/history boundary: {offenders}")
}

#Test("retired_authority_vocabulary_stays_in_fixtures_history_or_unrelated_english") {
    guards_enter_root()
    s6_ratchet_authority_vocabulary()
}
