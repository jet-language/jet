use core.files as s6_ratchet_files
use core.text.parse as s6_ratchet_text

// tests/retirement_ratchet.rs:127-172,731-894,1706-1739.
// Keep the original boundary/allowlist rules; this is not a blanket source grep.
fn s6_ratchet_contains_word(text: String, word: String) -> Bool {
    bytes :: text.bytes()
    offset := 0
    loop {
        rest :: policy_slice_bytes(text, offset, bytes.len())
        found :: s6_ratchet_text.find(rest, word)
        if found < 0 -> return false
        start :: offset + found
        end :: start + word.bytes().len()
        before := false
        after := false
        if start > 0 -> before = s3_truth_ascii_word_byte(bytes[start - 1])
        if end < bytes.len() -> after = s3_truth_ascii_word_byte(bytes[end])
        if !before && !after -> return true
        offset = end
    }
}

fn s6_ratchet_history(path: String) -> Bool {
    path == "Docs/spec/syntax-decisions.md" ||
    path == "Docs/spec/contributing/agent-engineering.md" ||
    path == "Docs/spec/reference/prior-art.md" ||
    path.starts_with("Docs/audits/") || path.starts_with("Docs/proposals/") ||
    path.starts_with("Docs/research/") || path.starts_with("Tools/agent-eval/domain-foundations/")
}

// tests/retirement_ratchet.rs:779-783 exempts syntax_reconciliation.rs fixture
// data. Its verbatim Jet guard/case ports inherit that same source allowance.
fn s6_ratchet_fixture(path: String) -> Bool {
    path.starts_with("tests/ui/") || path.starts_with("tests/fuzz/") ||
    path == "tests/syntax_reconciliation.rs" ||
    path == "tests/guards/syntax_reconciliation.jet" ||
    path.starts_with("tests/cases/syntax_reconciliation/") ||
    path == "Tools/notebook-test/acceptance.mjs"
}

// Rust concat! fixtures spell retired words in pieces so this guard does not
// introduce the forbidden vocabulary into the very corpus it checks.
fn s6_ratchet_concat(first: String, second: String) -> String {
    "{first}{second}"
}

fn s6_ratchet_producer(path: String, line: String) -> Bool {
    if path == "crates/jet-codegen/src/Prelude/Markers.jet" {
        return line.trim_start().starts_with("marker ") &&
            (line.contains(s6_ratchet_concat("marker Abil", "ities")) || line.contains(s6_ratchet_concat("marker Cap", "s")))
    }
    if path == "crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs" {
        return line.trim_start().starts_with("\"Abil") || line.trim_start().starts_with("\"Cap")
    }
    if path == "crates/jet-codegen/src/Prelude/Diagnostics.jet" {
        return line.starts_with("diagnostic\tE0077\t") && line.contains(s6_ratchet_concat("#", "Grant"))
    }
    if path == "crates/jet-parser/src/Parser/Statements/control.rs" -> return line.contains(s6_ratchet_concat("the `#", "Grant` scope marker is retired"))
    if path == "crates/jet-foundation/src/Syntax/retirements.rs" -> return line.contains(s6_ratchet_concat("retired: \"#", "Grant\""))
    if path == "crates/jet-parser/src/Parser/mod.rs" -> return line.contains(s6_ratchet_concat("#", "Grant"))
    // Jet counterparts of the producers above: the E0077 registry row (and the
    // generated DiagnosticRows copies in selfhost_terminators fixtures), the
    // retirement table, the generated Prelude marker source, the CLI syntax
    // dictionary rows for the retired markers, and the E0077 parser test.
    if path == "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet" ||
        (path.starts_with("tests/cases/selfhost_terminators/") && path.ends_with("/main.jet")) {
        return line.trim_start().starts_with(s6_ratchet_concat("what: \"The `#", "Grant` scope marker is retired."))
    }
    if path == "Compiler/JetFoundation/Data/Syntax/retirements.jet" -> return line.contains(s6_ratchet_concat("retired: \"#", "Grant\""))
    if path == "Compiler/JetSema/Source/Sema/Registration/PreludeMarkers.jet" {
        return line.contains(s6_ratchet_concat("marker Abil", "ities(")) && line.contains(s6_ratchet_concat("marker Cap", "s("))
    }
    if path == "Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet" {
        return line.contains(s6_ratchet_concat("token: \"Abil", "ities\"")) || line.contains(s6_ratchet_concat("token: \"Cap", "s\""))
    }
    if path == "Compiler/JetParser/Tests/Parser/Entry02.jet" -> return line.contains("E0077")
    false
}

fn s6_ratchet_unrelated(path: String, line: String) -> Bool {
    if path == "crates/jet-pkg-model/src/CompilerExtension.rs" ||
        path == "crates/jet-driver/src/CompilerExtensionHook.rs" ||
        path == "crates/jetpack-bin/tests/compiler_extension_e2e.rs" -> return true
    if path == "Jetpack/Integrations/Source/CompilerExtension/CompilerExtension.jet" -> return true
    if path == "Jetpack/Recipe/Source/Build/StagedPlanRun.jet" -> return line.contains(s6_ratchet_concat("Capabil", "ity-limited"))
    if path.starts_with("Docs/spec/reference/surfaces/") -> return true
    if path == "crates/jet-canvas/src/js/inspector-connections.js" -> return line.contains(s6_ratchet_concat("Capabil", "ity mismatch"))
    if path == "crates/jet-devserver/src/WebHost.rs" -> return line.contains(s6_ratchet_concat("Abil", "ity check"))
    if path == "crates/jet-driver/src/Driver/mod.rs" -> return line.contains(s6_ratchet_concat("Abil", "ity grants"))
    if path == "crates/jet-driver/src/Foreign.rs" -> return line.contains(s6_ratchet_concat("Capabil", "ity report"))
    if path == "crates/jet-pkg-model/src/FFI.rs" -> return line.contains(s6_ratchet_concat("Capabil", "ity-bearing"))
    if path == "crates/jet-repl/src/Notebook/trust.rs" -> return line.contains(s6_ratchet_concat("Abil", "ity widget"))
    if path == "crates/jet-sema/src/Sema/mod.rs" -> return line.contains(s6_ratchet_concat("Abil", "ity")) && line.contains("derive rows")
    if path == "crates/jetpack/src/Recipe.rs" -> return line.contains(s6_ratchet_concat("Capabil", "ity-limited"))
    if path == "Examples/features/io/app_config.jet" -> return line.trim_start().starts_with(s6_ratchet_concat("// Abil", "ity"))
    if path == "Examples/features/net/browser_cdp.jet" -> return line.contains(s6_ratchet_concat("Abil", "ity-gated protocol"))
    if path == "Tools/canvas-test/scenario.mjs" -> return line.contains(s6_ratchet_concat("Capabil", "ity mismatch"))
    if path == "Docs/spec/spec.md" -> return line.contains(s6_ratchet_concat("Capabil", "ity parameters"))
    false
}

fn s6_ratchet_hits(line: String) -> [String] {
    hits := [String]{}
    words :: [String]{s6_ratchet_concat("Abil", "ity"), s6_ratchet_concat("Abil", "ities"), s6_ratchet_concat("Capabil", "ity"), s6_ratchet_concat("Cap", "s")}
    loop word in words {
        if s6_ratchet_contains_word(line, word) -> &hits.push(word)
    }
    markers :: [String]{s6_ratchet_concat("#Abil", "ities"), s6_ratchet_concat("#Cap", "s"), s6_ratchet_concat("#", "Grant"), s6_ratchet_concat("#", "grant")}
    loop marker in markers {
        if line.contains(marker) -> &hits.push(marker)
    }
    identifiers :: [String]{s6_ratchet_concat("KW_", "CAPS"), s6_ratchet_concat("TYPE_", "ABILITIES"), s6_ratchet_concat("CAP_", "HANDLE_TYPE"), s6_ratchet_concat("Stmt::Cap", "s")}
    loop identifier in identifiers {
        if line.contains(identifier) -> &hits.push(identifier)
    }
    hits
}

fn s6_ratchet_authority_scan(directory: String, relative: String, offenders: &[String]) {
    entries :: s6_ratchet_files.list_dir(directory) ?? return
    loop entry in entries {
        kind :: s6_ratchet_files.stat(entry.path) ?? next
        if kind.is_symlink -> next
        path := entry.name.copy()
        if relative != "" -> path = "{relative}/{entry.name}"
        if kind.is_dir {
            if entry.name.starts_with(".") || entry.name.starts_with("target") ||
                entry.name == "build" || entry.name == "node_modules" -> next
            s6_ratchet_authority_scan(entry.path, path, &offenders)
        } else {
            if path.starts_with("Tools/tower/") -> next
            content :: s6_ratchet_files.read(entry.path) ?? next
            number := 0
            loop raw in content.lines() {
                number += 1
                line :: raw.copy()
                hits :: s6_ratchet_hits(line)
                if hits.len() == 0 || s6_ratchet_history(path) || s6_ratchet_fixture(path) ||
                    s6_ratchet_producer(path, line) || s6_ratchet_unrelated(path, line) -> next
                &offenders.push("{path}:{number}: {hits}")
            }
        }
    }
}

fn s6_ratchet_authority_vocabulary() {
    offenders := [String]{}
    s6_ratchet_authority_scan(".", "", &offenders)
    assert(offenders.len() == 0, "retired authority vocabulary escaped its fixture/history boundary: {offenders}")
}

#Test("retired_authority_vocabulary_stays_in_fixtures_history_or_unrelated_english") {
    s6_ratchet_authority_vocabulary()
}
