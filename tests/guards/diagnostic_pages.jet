// Port of the deleted tests/diagnostic_pages.rs (#6096 diagnostic-pages): one
// `Docs/site/dist/e/<CODE>/index.html` page per registered diagnostic row,
// rendered from the typed rows' one home (Compiler/Prelude/Diagnostics.jet,
// D-REPORT-HOME1=A) and the first UI snapshot naming the code.
//
// The check compares the committed pages with the rendering. Set
// JET_UPDATE_DIAGNOSTIC_PAGES=1 to write the rendered pages instead, as the
// Rust test's UPDATE_EXPECT mode did.
use {
    dp_files :: core.files
    dp_sys :: core.sys
}

DP_GENERATED_DIR :: "Docs/site/dist/e"
DP_SNAPSHOT_DIRS :: [String]{"tests/ui", "tests/ui_lint"}

struct DpRow {
    code: String
    what: String
    why: String
    fix: String
}

struct DpSnapshot {
    path: String
    text: String
}

fn dp_read(path: String) -> String { dp_files.read(path) ?? panic("read {path}: {err}") }

fn dp_html_escape(value: String) -> String {
    nul :: String.from_bytes([U8{0}]) ?? panic("NUL is UTF-8")
    value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;").replace(nul, "&#0;")
}

// Rust sorted `PathBuf`s, which order by path component: `a/b` before `a.b`.
// Sorting with `/` swapped for a byte below every path character keeps that order.
fn dp_component_key(path: String) -> String { path.replace("/", String.from_bytes([U8{1}]) ?? panic("U+0001 is UTF-8")) }

fn dp_key_path(key: String) -> String { key.replace(String.from_bytes([U8{1}]) ?? panic("U+0001 is UTF-8"), "/") }

fn dp_collect_snapshot_keys(directory: String, out: &[String]) {
    loop child in (dp_files.list_dir(directory) ?? panic("list {directory}: {err}")) {
        if child.is_dir {
            dp_collect_snapshot_keys(child.path, &out)
        } else if child.name.ends_with(".stderr") || child.name.ends_with(".warn") {
            &out.push(dp_component_key(child.path))
        }
    }
}

fn dp_snapshots() -> [DpSnapshot] {
    keys := [String]{}
    loop directory in DP_SNAPSHOT_DIRS -> dp_collect_snapshot_keys(directory, &keys)
    &keys.sort()
    snapshots := [DpSnapshot]{}
    loop key in keys {
        path :: dp_key_path(key)
        &snapshots.push(DpSnapshot{path: path, text: dp_read(path)})
    }
    snapshots
}

// The typed rows: tab-separated `diagnostic CODE stage severity moment status
// meaning what why fix …` lines, sorted by code as the Rust `sorted_rows` did.
fn dp_rows() -> [DpRow] {
    rows := [DpRow]{}
    loop line in dp_read("Compiler/Prelude/Diagnostics.jet").split("\n") {
        if !line.starts_with("diagnostic\t") -> next
        fields :: line.split("\t").to_list()
        assert(fields.len() > 9, "diagnostic row without what/why/fix: {line}")
        &rows.push(DpRow{code: fields[1].copy(), what: fields[7].copy(), why: fields[8].copy(), fix: fields[9].copy()})
    }
    assert(rows.len() > 100, "the typed diagnostic rows must be readable")
    codes := rows.map(row -> row.code)
    &codes.sort()
    sorted := [DpRow]{}
    loop code in codes {
        loop row in rows {
            if row.code == code {
                &sorted.push(row.copy())
                break
            }
        }
    }
    sorted
}

fn dp_first_snapshot(snapshots: [DpSnapshot], code: String) -> DpSnapshot? {
    marker :: "[{code}]"
    loop snapshot in snapshots {
        if snapshot.text.contains(marker) -> return Val(snapshot.copy())
    }
    None
}

fn dp_render_page(row: DpRow, example: DpSnapshot?) -> String {
    code :: dp_html_escape(row.code)
    what :: dp_html_escape(row.what)
    why :: dp_html_escape(row.why)
    fix :: dp_html_escape(row.fix)
    worked :: if example == {
        .Val(snapshot) -> "<p>First UI snapshot mentioning <code>{code}</code>: <code>{dp_html_escape(snapshot.path)}</code>.</p>\n<pre class=\"diag\">{dp_html_escape(snapshot.text)}</pre>"
        else -> "<p>No UI snapshot currently mentions this code.</p>"
    }
    lines :: [String]{
        "<!-- Generated by tests/guards/diagnostic_pages.jet; do not edit. -->",
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
        "<title>{code} — Jet diagnostic</title>",
        "<meta name=\"description\" content=\"{what}\">",
        "<meta property=\"og:title\" content=\"{code} — Jet diagnostic\">",
        "<meta property=\"og:description\" content=\"{what}\">",
        "<link rel=\"icon\" type=\"image/svg+xml\" href=\"../../assets/favicon.svg\">",
        "<link rel=\"stylesheet\" href=\"../../assets/site.css\">",
        "</head>",
        "<body>",
        "<header class=\"wrap nav\">",
        "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>",
        "<nav><ul class=\"nav-links\">",
        "<li><a href=\"../../tour.html\">Tour</a></li>",
        "<li><a href=\"../../install.html\">Install</a></li>",
        "<li><a href=\"../index.html\" aria-current=\"page\">Error codes</a></li>",
        "</ul></nav>",
        "</header>",
        "<main>",
        "<section class=\"wrap page\">",
        "<div class=\"page-header\">",
        "<p class=\"eyebrow\">// diagnostic</p>",
        "<h1>{code}</h1>",
        "<p>{what}</p>",
        "</div>",
        "</section>",
        "<article class=\"wrap article\">",
        "<h2>What</h2>",
        "<p class=\"diag-copy what\" data-registry-field=\"what\">{what}</p>",
        "<h2>Why</h2>",
        "<p class=\"diag-copy why\" data-registry-field=\"why\">{why}</p>",
        "<h2>Fix</h2>",
        "<p class=\"diag-copy fix\" data-registry-field=\"fix\">{fix}</p>",
        "<h2>Worked example</h2>",
        worked,
        "<p><a href=\"../index.html\">Back to all error codes</a></p>",
        "</article>",
        "</main>",
        "<footer class=\"footer\">",
        "<div class=\"wrap footer-grid\">",
        "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>",
        "<p class=\"made\">Generated from Jet's diagnostic registry and UI snapshots.</p>",
        "</div>",
        "</footer>",
        "</body>",
        "</html>",
    }
    "{lines.join("\n")}\n"
}

// tests/diagnostic_pages.rs:171-185.
fn dp_line_diff(expected: String, actual: String) -> String {
    expected_lines :: expected.split("\n").to_list()
    actual_lines :: actual.split("\n").to_list()
    shorter :: if expected_lines.len() < actual_lines.len() -> expected_lines.len() else -> actual_lines.len()
    first := shorter
    loop index in 0..<shorter {
        if expected_lines[index] != actual_lines[index] {
            first = index
            break
        }
    }
    left :: if first < expected_lines.len() -> expected_lines[first].copy() else -> "<missing>"
    right :: if first < actual_lines.len() -> actual_lines[first].copy() else -> "<missing>"
    "first differing line {first + 1}\n- {left}\n+ {right}"
}

fn dp_collect_html(directory: String, root: String, out: &[String]) {
    loop child in (dp_files.list_dir(directory) ?? panic("list {directory}: {err}")) {
        if child.is_dir {
            dp_collect_html(child.path, root, &out)
        } else if child.name.ends_with(".html") {
            &out.push(child.path.slice(root.len() + 1, child.path.len()))
        }
    }
}

// A page without its generator line: the drift that is not just the deleted
// Rust generator's name.
fn dp_body(page: String) -> String {
    lines :: page.split("\n").to_list()
    rest := [String]{}
    loop (index, line) in lines {
        if index > 0 -> &rest.push(line.copy())
    }
    rest.join("\n")
}

// tests/diagnostic_pages.rs:188: every registered row has exactly one page,
// the page carries the row's what/why/fix text verbatim, and no hand-authored
// or stale page sits beside them.
#Test("diagnostic_pages_match_registry_and_snapshots") {
    snapshots :: dp_snapshots()
    rows :: dp_rows()
    codes := [String]{}
    loop row in rows {
        assert(!codes.contains(row.code), "diagnostic registry contains duplicate code {row.code}")
        &codes.push(row.code.copy())
    }
    update :: dp_sys.get("JET_UPDATE_DIAGNOSTIC_PAGES") != None
    lost := [String]{}
    missing := [String]{}
    drifted := [String]{}
    body_drifted := [String]{}
    generated := 0
    loop row in rows {
        page :: dp_render_page(row, dp_first_snapshot(snapshots, row.code))
        loop entry in [(field: "what", value: row.what), (field: "why", value: row.why), (field: "fix", value: row.fix)] {
            if !page.contains("<p class=\"diag-copy {entry.field}\" data-registry-field=\"{entry.field}\">{dp_html_escape(entry.value)}</p>") -> &lost.push("{row.code} page lost registry {entry.field} text")
        }
        directory :: "{DP_GENERATED_DIR}/{row.code}"
        path :: "{directory}/index.html"
        if update {
            dp_files.create_dir_all(directory) ?? panic("create {directory}: {err}")
            dp_files.write(path, page) ?? panic("write {path}: {err}")
        } else if !dp_files.exists(path) {
            &missing.push(row.code.copy())
        } else {
            actual :: dp_read(path)
            if actual != page -> &drifted.push("{path} drifted:\n{dp_line_diff(page, actual)}")
            if dp_body(actual) != dp_body(page) -> &body_drifted.push("{path}:\n{dp_line_diff(dp_body(page), dp_body(actual))}")
        }
        generated += 1
    }
    expected_pages := codes.map(code -> "{code}/index.html")
    &expected_pages.sort()
    actual_pages := [String]{}
    if dp_files.exists(DP_GENERATED_DIR) -> dp_collect_html(DP_GENERATED_DIR, DP_GENERATED_DIR, &actual_pages)
    extra := [String]{}
    loop page in actual_pages {
        if page != "index.html" && !expected_pages.contains(page) -> &extra.push(page)
    }
    &extra.sort()
    problems := [String]{}
    if !lost.is_empty() -> &problems.push(lost.join("\n"))
    if !missing.is_empty() -> &problems.push("{missing.len()} registered codes have no page; run with JET_UPDATE_DIAGNOSTIC_PAGES=1: {missing.join(" ")}")
    if !extra.is_empty() -> &problems.push("generated diagnostic page set drifted; hand-authored or stale pages exist: {extra.join(" ")}")
    if !drifted.is_empty() -> &problems.push("{drifted.len()} pages drifted from the registry; first:\n{drifted[0]}")
    if !body_drifted.is_empty() -> &problems.push("{body_drifted.len()} pages drifted below the generator line; first:\n{body_drifted[0]}")
    assert_eq(problems.join("\n"), "")
    assert_eq(generated, codes.len())
}
