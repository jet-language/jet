// #6725: every JetRuntime stop goes through one door, Trap.jet trap_stop,
// which serves the compiler first when the image runs comptime code and else
// returns to the routine's own runtime report. A routine that reaches a stop
// or exit primitive before trap_stop ends the child without telling the
// compiler, which then reads garbage as the call's result. This reads the
// runtime source: every exported routine is followed through its in-runtime
// calls, in source order, up to its first trap_stop.
use stop_door_files: core.files

STOP_DOOR_RUNTIME: "Compiler/JetRuntime/Source"

// The stop and exit primitives: a report's header and footer, a stop's
// publication to a task or the root, and the process exit itself.
stop_door_ends: fn() -> [String] {
    [String]{
        "trap_header", "trap_header_bytes", "trap_footer", "trap_footer_bytes", "trap_exit", "trap_defect_exit",
        "trap_root_panic_report", "rt_task_panic_publish", "rt_task_panic_publish_recorded", "rt_task_panic_publish_owned",
        "jet_rt_task_panic_publish", "jet_rt_root_publish_rendered", "scheduler_root_publish_owned",
        "scheduler_panic_publish_record", "jet_rt_trap_root", "jet_rt_control_publish_stop", "main_exit_claim",
        "jet_rt_process_stop_claim", "jet_rt_process_exit_begin", "jet_rt_process_exit_finish", "jet_rt_process_exit",
        "jet_rt_main_stopped", "<exit_group>",
    }
}

// Routines that end the process with no stop to serve.
stop_door_exempt: fn() -> [String] {
    [String]{
        // The serve protocol itself: its exits answer or refuse the compiler.
        "comptime_serve_move", "comptime_serve_loop", "jet_rt_comptime_serve", "jet_rt_comptime_serve_stop", "jet_rt_comptime_refused",
        // The fault signal handler: the compiler reports the child's signal.
        "jet_rt_fault_signal", "fault_raise",
        // Allocation failure: serving allocates, so the child aborts and the compiler reports SIGABRT.
        "alloc_abort",
        // No thread state to serve from.
        "trap_gs_failure",
        // Exits whose status is the program's, not a stop: under a serve CALL
        // the root publication ends the child with it (ComptimeServe.jet).
        "jet_std_process_exit", "jet_std_process_exit_owned", "jet_log_process_exit", "journey_entry_write_take",
        "jet_rt_process_signal_interrupts",
        // The process root and the test runner's roots, which `jet test` runs and never serves.
        "jet_rt_main", "jet_rt_test_unit", "property_case",
        // Replays a worker's stop, which its own routine served when it stopped.
        "parallel_raise",
        // The vfork child before exec: not the served process.
        "spawn_exec_child",
    }
}

stop_door_has: fn(values: [String], value: String) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}

stop_door_slice: fn(text: String, start: Int, end: Int) -> String {
    if start >= end -> return ""
    String.from_bytes(text.bytes()[start..(end - 1)]) ?? panic("runtime source slices end on ASCII")
}

stop_door_word_byte: fn(byte: U8) -> Bool {
    (byte >= (U8{97}) && byte <= (U8{122})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{48}) && byte <= (U8{57})) || byte == (U8{95})
}

// The calls of `line` in source order, comments and string literals skipped.
// A raw exit_group syscall (first argument I64{231}) is "<exit_group>".
stop_door_line_calls: fn(line: String, out: &[String]) {
    bytes: line.bytes()
    count: bytes.len()
    at := 0
    start := -1
    quoted := false
    loop at < count {
        byte: bytes[at]
        if quoted {
            if byte == (U8{92}) {
                at += 1
            } else if byte == (U8{34}) {
                quoted = false
            }
        } else if stop_door_word_byte(byte) {
            if start < 0 -> start = at
        } else {
            if byte == (U8{40}) && start >= 0 {
                first: bytes[start]
                if (first >= (U8{97}) && first <= (U8{122})) || first == (U8{95}) {
                    if stop_door_slice(line, at + 1, if at + 9 < count -> at + 9 else -> count) == "I64{{231}}" {
                        out.push("<exit_group>")
                    } else {
                        out.push(stop_door_slice(line, start, at))
                    }
                }
            }
            start = -1
            if byte == (U8{34}) -> quoted = true
            if byte == (U8{47}) && at + 1 < count && bytes[at + 1] == (U8{47}) -> break
        }
        at += 1
    }
}

// The name a top-level `name: fn` line declares, else "".
stop_door_declared: fn(line: String) -> String {
    text: if line.starts_with("#Export(c) ") -> stop_door_slice(line, 11, line.count_bytes()) else -> line.copy()
    parts: text.split(": fn").to_list()
    if parts.len() < 2 -> return ""
    name: parts[0]
    bytes: name.bytes()
    if bytes.len() == 0 -> return ""
    if !((bytes[0] >= (U8{97}) && bytes[0] <= (U8{122})) || bytes[0] == (U8{95})) -> return ""
    loop byte in bytes {
        if !stop_door_word_byte(byte) -> return ""
    }
    name.copy()
}

// The first stop or exit primitive `name` reaches before a trap_stop, as the
// call path that reaches it, else "".
stop_door_reach: fn(name: String, calls: [String: [String]], ends: [String], exempt: [String], memo: &[String: String]) -> String {
    if stop_door_has(ends, name) -> return name.copy()
    if stop_door_has(exempt, name) -> return ""
    if memo.get(name) == .Val(known) -> return known.copy()
    called: calls.get(name) ?? return ""
    memo[name] = ""
    result := ""
    loop callee in called {
        if callee == "trap_stop" -> break
        found: stop_door_reach(callee, calls, ends, exempt, memo)
        if found != "" {
            result = "{name} > {found}"
            break
        }
    }
    memo[name] = result.copy()
    result
}

#Test("every_runtime_stop_serves_comptime_through_trap_stop") {
    guards_enter_root()
    calls := [String: [String]]{}
    exported := [(name: String, file: String)]{}
    readers := [String]{}
    files := [String]{}
    loop child in (stop_door_files.list_dir(STOP_DOOR_RUNTIME) ?? panic("list {STOP_DOOR_RUNTIME}: {err}")) {
        if !child.is_dir && child.name.ends_with(".jet") -> files.push(child.name.copy())
    }
    files.sort()
    loop file in files {
        current := ""
        body := [String]{}
        loop line in (stop_door_files.read("{STOP_DOOR_RUNTIME}/{file}") ?? panic("read {file}: {err}")).split("\n") {
            declared: stop_door_declared(line.copy())
            bytes: line.bytes()
            top: bytes.len() > 0 && (stop_door_word_byte(bytes[0]) || bytes[0] == (U8{35}))
            if top {
                if current != "" -> calls[current] = body.copy()
                current = declared.copy()
                body = [String]{}
                if declared == "" -> next
                if line.starts_with("#Export(c) ") -> exported.push((name: declared.copy(), file: file.copy()))
                stop_door_line_calls(stop_door_slice(line, (line.split(": fn").to_list()[0]).count_bytes() + 4, line.count_bytes()), body)
            } else if current != "" {
                reader: "{file} {current}"
                if line.contains("comptime_serve_stop_code") && current != "trap_stop" && !stop_door_has(readers, reader) -> readers.push(reader)
                stop_door_line_calls(line.copy(), body)
            }
        }
        if current != "" -> calls[current] = body.copy()
    }
    assert(exported.len() > 500, "the runtime's exported routines must be readable")
    ends: stop_door_ends()
    exempt: stop_door_exempt()
    memo := [String: String]{}
    ungated := [String]{}
    loop routine in exported {
        if stop_door_has(ends, routine.name) -> next
        path: stop_door_reach(routine.name, calls, ends, exempt, memo)
        if path != "" -> ungated.push("{routine.file}: {path}")
    }
    // The installer and trap_stop are the serve stop code's only readers.
    assert_eq(readers, [String]{"ComptimeServe.jet jet_rt_comptime_serve"})
    assert_eq(ungated.join("\n"), "")
}
