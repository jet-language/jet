fn s2_syntax_module_internal_is_discovery_not_access_control() {
    decisions :: s2_syntax_files_api.read("Docs/spec/syntax-decisions.md") ?? panic("read syntax decisions")
    assert(decisions.contains("`use project._name` remains allowed"))
    assert(decisions.contains("underscore changes discovery, not access"))
    assert(!decisions.contains("| D-SHAPE-MODULEINTERNAL1 |"))
}
#Test("module_internal_is_discovery_not_access_control") {
    s2_syntax_module_internal_is_discovery_not_access_control()
}

fn s2_syntax_artifact_extensions_are_one_closed_kind_specific_family() {
    roots :: [String]{"Source", "crates", "Examples", "tests", "Docs"}
    retired :: [String]{".jproof", ".jtrace", ".jreplay"}
    loop root in roots {
        loop path in s2_syntax_paths(root) {
            if path.ends_with(".rs") || path.ends_with("tests/guards/syntax_reconciliation.jet") -> next
            source :: s2_syntax_files_api.read(path) ?? next
            loop (index, line) in source.lines() {
                loop suffix in retired -> assert(!line.contains(suffix) || line.contains("jet.jproof"), "{path}:{index + 1} retains retired artifact suffix {suffix}")
            }
        }
    }
}
#Test("artifact_extensions_are_one_closed_kind_specific_family") {
    s2_syntax_artifact_extensions_are_one_closed_kind_specific_family()
}
