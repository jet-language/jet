use core.files as s6_view_guard_files

// tests/view_copy_semantics.rs:211-235: exact checked-Jet evaluator source law.
fn s6_view_checked_evaluator_materialization() {
    source :: s6_view_guard_files.read("Compiler/JetEval/Source/Evaluator.jet") ?? panic("Evaluator.jet")
    helpers :: [String]{"jet_eval_materialize_string_window", "jet_eval_materialize_list_window", "jet_eval_materialize_bytes_window"}
    loop helper in helpers {
        assert(source.contains("fn {helper}("), "Evaluator.jet must define {helper}")
    }
    assert(source.contains("window :: value.after(\"\")\n    ~window"), "String evaluator materialization must lower through checked Jet ~")
    // split has one more segment than nonoverlapping str::matches occurrences.
    count :: source.split("window :: value[0..<value.len()]\n    ~window").to_list().len() - 1
    assert(count == 2, "List and Bytes evaluator materialization must use checked full windows")
}

#Test("evaluator_view_materialization_helpers_use_checked_jet_route") {
    s6_view_checked_evaluator_materialization()
}
