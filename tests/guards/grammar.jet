use files: core.files
use process: core.process
use testing: core.testing

s5_grammar_find: fn(text: String, needle: String, start: Int) -> Int {
    bytes: text.bytes()
    wanted: needle.bytes()
    at := start
    loop {
        if at + wanted.len() > bytes.len() -> return -1
        matched := true
        loop offset in 0..<wanted.len() {
            if bytes[at + offset] != wanted[offset] -> matched = false
        }
        if matched -> return at
        at += 1
    }
}

// The finder returns UTF-8 byte offsets, matching the Rust original's string indices.
s5_grammar_slice_bytes: fn(text: String, start: Int, end: Int) -> String {
    raw: text.bytes()
    assert(start >= 0 && end >= start && end <= raw.len(), "valid grammar byte span")
    if start == end -> return ""
    String.from_bytes(raw[start..(end - 1)]) ?? panic("grammar byte span must end on UTF-8 boundaries")
}

#Test("grammar byte spans remain byte-indexed after Unicode") {
    guards_enter_root()
    text: "é🙂 variant: λ body paren_expr:"
    start: s5_grammar_find(text, "variant:", 0)
    end: s5_grammar_find(text, "paren_expr:", start)
    assert(s5_grammar_slice_bytes(text, start, end) == "variant: λ body ")
    assert(s5_grammar_slice_bytes(text, start, start) == "")
}

#Test("editor_grammars_have_generated_sections") {
    guards_enter_root()
    paths: [String]{"Tools/editors/vscode/syntaxes/jet.tmLanguage.json", "Tools/editors/jet.tmGrammar", "Tools/editors/tree-sitter/grammar.js", "Tools/editors/zed/languages/jet/highlights.scm"}
    loop path in paths {
        text: files.read(path) ?? panic("read {path}")
        start: s5_grammar_find(text, "BEGIN GENERATED JET SYNTAX HIGHLIGHTS", 0)
        assert(start >= 0, "{path} missing generated start")
        end: s5_grammar_find(text, "END GENERATED JET SYNTAX HIGHLIGHTS", start)
        assert(end >= start, "{path} missing generated end after start")
    }
}

#Test("tree_sitter_map_type_grammar_keeps_colon_adjacent") {
    guards_enter_root()
    grammar: files.read("Tools/editors/tree-sitter/grammar.js") ?? panic("read tree-sitter grammar")
    assert(grammar.contains("seq(\"[\", $._type, \":\", $._type, \"]\")"))
    assert(!grammar.contains("seq(\"[\", $._type, \": \", $._type, \"]\")"))
}

// A Result is handled by an ordinary `if value == { … }` table; the
// retired `value ? ok -> … ! err -> …` handler has no editor rule either.
#Test("tree_sitter_grammar_has_no_retired_result_handler_rule") {
    guards_enter_root()
    grammar: files.read("Tools/editors/tree-sitter/grammar.js") ?? panic("read tree-sitter grammar")
    assert(!grammar.contains("result_handler_expr"), "the retired result handler rule is back")
    query: files.read("Tools/editors/zed/languages/jet/highlights.scm") ?? panic("read Zed highlights")
    assert(!query.contains("result_handler_expr"), "Zed highlights name the retired result handler rule")
}

#Test("vscode_strings_do_not_relex_interpolations") {
    guards_enter_root()
    paths: [String]{"Tools/editors/vscode/syntaxes/jet.tmLanguage.json", "Tools/editors/jet.tmGrammar"}
    loop path in paths {
        grammar: files.read(path) ?? panic("read {path}")
        assert(!grammar.contains("\"include\": \"$self\""))
        assert(grammar.contains("\"include\": \"#string-interpolation\""))
        assert(!grammar.contains("constant.character.escape.jet"))
    }
}

#Test("classic_textmate_grammar_matches_vscode_source") {
    guards_enter_root()
    classic: files.read("Tools/editors/jet.tmGrammar") ?? panic("read classic TextMate grammar")
    vscode: files.read("Tools/editors/vscode/syntaxes/jet.tmLanguage.json") ?? panic("read VSCode grammar")
    assert(classic == vscode, "classic TextMate grammar must mirror VSCode grammar")
}

// S5: block comments nest. Each TextMate grammar's `block-comments` rule
// includes itself and the `comments` rule reaches it, and the VSCode language
// configuration names the block comment pair.
#Test("textmate_block_comments_nest") {
    guards_enter_root()
    paths: [String]{"Tools/editors/vscode/syntaxes/jet.tmLanguage.json", "Tools/editors/jet.tmGrammar"}
    loop path in paths {
        grammar: files.read(path) ?? panic("read {path}")
        rule: s5_grammar_find(grammar, "\"block-comments\": {{", 0)
        assert(rule >= 0, "{path} has no block-comments rule")
        body: s5_grammar_slice_bytes(grammar, rule, s5_grammar_find(grammar, "\n    }},", rule))
        assert(body.contains("\"begin\": \"/\\\\*\"") && body.contains("\"end\": \"\\\\*/\""), "{path}: the block-comments rule must open at `/*` and close at `*/`")
        assert(body.contains("{{ \"include\": \"#block-comments\" }}"), "{path}: the block-comments rule must include itself so comments nest")
        comments: s5_grammar_find(grammar, "\"comments\": {{", 0)
        assert(comments >= 0, "{path} has no comments rule")
        section: s5_grammar_slice_bytes(grammar, comments, s5_grammar_find(grammar, "\n    }},", comments))
        assert(section.contains("{{ \"include\": \"#block-comments\" }}"), "{path}: the comments rule must reach the block-comments rule")
    }
    config: files.read("Tools/editors/vscode/language-configuration.json") ?? panic("read the VSCode language configuration")
    assert(config.contains("\"blockComment\": [\"/*\", \"*/\"]"), "the VSCode language configuration must name the block comment pair")
}

s5_grammar_first_quoted: fn(text: String, start: Int) -> String? {
    first: s5_grammar_find(text, "\"", start)
    if first < 0 -> return None
    last: s5_grammar_find(text, "\"", first + 1)
    if last < 0 -> return None
    Val(s5_grammar_slice_bytes(text, first + 1, last))
}

#Test("zed_highlight_query_mentions_only_grammar_literals") {
    guards_enter_root()
    nodes: files.read("Tools/editors/tree-sitter/src/node-types.json") ?? panic("read tree-sitter node types")
    anonymous := [String]{}
    current_type := String?{None}
    named := false
    seen_named := false
    loop line in nodes.split("\n") {
        trimmed: line.trim().copy()
        if line.starts_with("  {{") {
            current_type = None
            named = false
            seen_named = false
        } else if trimmed.starts_with("\"type\":") && current_type == None {
            colon: s5_grammar_find(trimmed, ":", 0)
            current_type = s5_grammar_first_quoted(trimmed, colon + 1)
        } else if trimmed.starts_with("\"named\":") && !seen_named {
            named = trimmed.contains("true")
            seen_named = true
        } else if line.starts_with("  }}") {
            if seen_named && !named {
                if current_type != None {
                    token: current_type ?? panic("known anonymous node type")
                    anonymous.push(token)
                }
            }
        }
    }
    query: files.read("Tools/editors/zed/languages/jet/highlights.scm") ?? panic("read Zed highlights")
    loop line in query.split("\n") {
        trimmed: line.trim().copy()
        if trimmed.starts_with(";") -> next
        at := 0
        loop {
            first: s5_grammar_find(trimmed, "\"", at)
            if first < 0 -> break
            last: s5_grammar_find(trimmed, "\"", first + 1)
            if last < 0 -> break
            token: s5_grammar_slice_bytes(trimmed, first + 1, last)
            assert(anonymous.contains(token), "Zed query mentions non-anonymous grammar literal: {token}")
            at = last + 1
        }
    }
}

// D-EDITOR-GRAMMAR1=A: the tree-sitter grammar parses every example
// with no ERROR or MISSING node. A host without tree-sitter, or without the C
// compiler it builds the parser with, reports SKIP-HOST and runs nothing.
#Test("tree_sitter_parses_every_example_without_error_or_missing_nodes") {
    guards_enter_root()
    tree_sitter: process.which("tree-sitter") ?? {
        print("SKIP-HOST: tree-sitter is not on PATH")
        return
    }
    if process.which("cc") == None {
        print("SKIP-HOST: tree-sitter builds its parser with `cc`, which is not on PATH")
        return
    }
    scratch: testing.temp_dir("tree-sitter-examples")
    library: files.join(scratch, "jet.so")
    built: process.cmd([tree_sitter, "build", "-o", library, "Tools/editors/tree-sitter"]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter build: {err}")
    assert(built.code == 0, "tree-sitter build failed: {process.combined_output(built).trim()}")
    examples: testing.corpus_entries("Examples", ".jet")
    assert(examples.len() > 0, "no Examples/**/*.jet found")
    listing: files.join(scratch, "examples.txt")
    files.write(listing, examples.map(fn(entry) { entry.path.copy() }).join("\n")) ?? panic("write {listing}: {err}")
    parsed: process.cmd([tree_sitter, "parse", "--quiet", "--lib-path", library, "--lang-name", "jet", "--paths", listing]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter parse: {err}")
    offenders := [String]{}
    loop line in process.stdout_lines(parsed) {
        if line.contains("(ERROR") || line.contains("(MISSING") -> offenders.push(line.trim().copy())
    }
    assert(offenders.len() == 0, "the tree-sitter grammar rejects {offenders.len()} example(s):\n{offenders.join("\n")}")
    assert(parsed.code == 0, "tree-sitter parse failed: {process.combined_output(parsed).trim()}")
    files.remove_all(scratch) ?? panic("remove {scratch}: {err}")
}

// Zed drops the whole Jet language when one of its queries fails to compile
// (an impossible pattern, a child listed out of source order, a node the
// grammar lacks), so every query must compile against the generated parser.
#Test("every_zed_query_compiles_against_the_tree_sitter_grammar") {
    guards_enter_root()
    tree_sitter: process.which("tree-sitter") ?? {
        print("SKIP-HOST: tree-sitter is not on PATH")
        return
    }
    if process.which("cc") == None {
        print("SKIP-HOST: tree-sitter builds its parser with `cc`, which is not on PATH")
        return
    }
    scratch: testing.temp_dir("tree-sitter-queries")
    library: files.join(scratch, "jet.so")
    built: process.cmd([tree_sitter, "build", "-o", library, "Tools/editors/tree-sitter"]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter build: {err}")
    assert(built.code == 0, "tree-sitter build failed: {process.combined_output(built).trim()}")
    sample: files.join(scratch, "sample.jet")
    files.write(sample, "Point: struct {{\n    x: Int\n}}\nmain: fn() {{\n    print(\"hi\")\n}}\n") ?? panic("write {sample}: {err}")
    failures := [String]{}
    loop name in ["highlights", "outline", "brackets", "indents", "overrides"] {
        query: "Tools/editors/zed/languages/jet/{name}.scm"
        ran: process.cmd([tree_sitter, "query", "--quiet", "--lib-path", library, "--lang-name", "jet", query, sample]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter query: {err}")
        if ran.code != 0 -> failures.push("{query}: {process.combined_output(ran).trim()}")
    }
    assert(failures.len() == 0, "Zed would drop the Jet language; these queries do not compile:\n{failures.join("\n")}")
    files.remove_all(scratch) ?? panic("remove {scratch}: {err}")
}

// S5: a block comment nests, so `/* a /* b */ c */` is one comment, and a
// `/*` inside quoted text stays text (src/scanner.c scans the comment).
#Test("tree_sitter_block_comments_nest_and_stay_text_inside_quotes") {
    guards_enter_root()
    tree_sitter: process.which("tree-sitter") ?? {
        print("SKIP-HOST: tree-sitter is not on PATH")
        return
    }
    if process.which("cc") == None {
        print("SKIP-HOST: tree-sitter builds its parser with `cc`, which is not on PATH")
        return
    }
    scratch: testing.temp_dir("tree-sitter-block-comments")
    library: files.join(scratch, "jet.so")
    built: process.cmd([tree_sitter, "build", "-o", library, "Tools/editors/tree-sitter"]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter build: {err}")
    assert(built.code == 0, "tree-sitter build failed: {process.combined_output(built).trim()}")
    sample: files.join(scratch, "sample.jet")
    files.write(sample, "/* outer /* inner */ still the outer comment */\nrun: fn() {{\n    text: \"/* not a comment */\"\n    print(text) /* a /* b */ c */\n}}\n") ?? panic("write {sample}: {err}")
    parsed: process.cmd([tree_sitter, "parse", "--lib-path", library, "--lang-name", "jet", sample]).stdout(.Capture).stderr(.Capture).run() ?? panic("run tree-sitter parse: {err}")
    tree: process.stdout_lines(parsed).join("\n")
    assert(parsed.code == 0 && !tree.contains("(ERROR") && !tree.contains("(MISSING"), "tree-sitter rejects nested block comments:\n{process.combined_output(parsed).trim()}")
    assert(tree.contains("(block_comment [0, 0] - [0, 47])"), "the nested comment on line 1 must be one block comment:\n{tree}")
    assert(tree.contains("(string_content [2, 11] - [2, 30])"), "a `/*` inside quoted text must stay text:\n{tree}")
    assert(tree.contains("(block_comment [3, 16] - [3, 33])"), "the nested trailing comment must be one block comment:\n{tree}")
    files.remove_all(scratch) ?? panic("remove {scratch}: {err}")
}
