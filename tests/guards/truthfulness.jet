use {
    s3_truth_files: core.files
    s3_truth_text: core.text
    s3_truth_parse: core.text.parse
}

// Reuse corpus_policy.jet's checked UTF-8 byte slicers rather than a second one.
// The Docs scans index one byte array per text: slicing the remaining text at
// every match made them quadratic and drove the guards harness past 12 GB (#6301).
s3_truth_find_bytes: fn(raw: [U8], needle: [U8], from: Int) -> Int {
    if needle.len() == 0 -> return from
    if from > raw.len() - needle.len() -> return -1
    first: needle[0]
    loop at in from..<(raw.len() - needle.len() + 1) {
        if raw[at] != first -> next
        matched := true
        loop j in 1..<needle.len() {
            if raw[at + j] != needle[j] {
                matched = false
                break
            }
        }
        if matched -> return at
    }
    -1
}

// The UTF-8 sequence length a lead byte starts.
s3_truth_utf8_width: fn(b: U8) -> Int Never! {
    if b < (U8{192}) -> return 1
    if b < (U8{224}) -> return 2
    if b < (U8{240}) -> return 3
    4
}

s3_truth_md_paths: fn(directory: String) -> [String] {
    entries: s3_truth_files.list_dir(directory) ?? return [String]{}
    paths := [String]{}
    loop entry in entries -> paths.push(entry.path.copy())
    paths.sort()
    result := [String]{}
    loop path in paths {
        if s3_truth_files.is_dir(path) {
            nested: s3_truth_md_paths(path)
            loop item in nested -> result.push(item)
        } else if path.ends_with(".md") && !path.ends_with("/.md") && path != ".md" {
            result.push(path)
        }
    }
    result
}

s3_truth_example_paths: fn(text: String) -> [String] {
    prefix: "Examples/"
    wanted: prefix.bytes()
    raw: text.bytes()
    result := [String]{}
    at := 0
    loop {
        pos: s3_truth_find_bytes(raw, wanted, at)
        if pos < 0 -> break
        start: pos + wanted.len()
        end := start
        // Rust char::is_alphanumeric: Unicode alphabetic OR Unicode numeric.
        loop end < raw.len() {
            width: s3_truth_utf8_width(raw[end])
            if end + width > raw.len() -> break
            if width == 1 {
                b: raw[end]
                if !s3_truth_ascii_word_byte(b) && b != (U8{46}) && b != (U8{45}) && b != (U8{47}) -> break
            } else {
                ch: policy_slice_raw(raw, end, end + width)
                if !s3_truth_text.is_alphabetic(ch) && !s3_truth_text.is_numeric(ch) -> break
            }
            end += width
        }
        tail: policy_slice_raw(raw, start, end)
        if tail.ends_with(".jet") -> result.push("{prefix}{tail}")
        at = start
    }
    result
}

// Port of tests/truthfulness.rs:258-301 and helpers304-319/1999-2015.
s3_guard_docs_examples: fn() {
    parts := [String]{s3_truth_files.read("README.md") ?? ""}
    entries: s3_truth_files.list_dir("Docs") ?? panic("Docs/ missing")
    paths := [String]{}
    loop entry in entries -> paths.push(entry.path.copy())
    paths.sort()
    loop path in paths {
        if s3_truth_files.is_dir(path) {
            // Rust excluded the top-level historical directories; dated
            // evidence is the shared definition in retirement_ratchet.jet.
            if guards_dated_evidence("{path}/") -> next
            nested: s3_truth_md_paths(path)
            loop item in nested {
                body: s3_truth_files.read(item) ?? next
                parts.push(body)
            }
        } else if path.ends_with(".md") && !path.ends_with("/.md") {
            body: s3_truth_files.read(path) ?? next
            parts.push(body)
        }
    }
    content: parts.join("")
    missing := [String]{}
    loop path in s3_truth_example_paths(content) {
        if !s3_truth_files.exists(path) -> missing.push(path)
    }
    assert(missing.len() == 0, "docs reference example files that do not exist: {missing}")
}

#Test("docs_referenced_examples_exist") {
    s3_guard_docs_examples()
}

s3_truth_ascii_word_byte: fn(b: U8) -> Bool Never! {
    (b >= (U8{65}) && b <= (U8{90})) || (b >= (U8{97}) && b <= (U8{122})) || (b >= (U8{48}) && b <= (U8{57})) || b == (U8{95})
}

s3_truth_contains_word: fn(text: String, needle: String) -> Bool {
    // parse.lower is ASCII-only, matching Rust to_ascii_lowercase exactly.
    raw: s3_truth_parse.lower(text).bytes()
    wanted: s3_truth_parse.lower(needle).bytes()
    offset := 0
    loop {
        start: s3_truth_find_bytes(raw, wanted, offset)
        if start < 0 -> return false
        end: start + wanted.len()
        before := false
        after := false
        if start > 0 -> before = s3_truth_ascii_word_byte(raw[start - 1])
        if end < raw.len() -> after = s3_truth_ascii_word_byte(raw[end])
        if !before && !after -> return true
        offset = end
    }
}

s3_truth_retired_senses: fn(text: String) -> [String] {
    codec := false
    event := false
    collecting := false
    loop raw in text.lines() {
        line: s3_truth_parse.lower(raw)
        called: line.contains("called") || line.contains("as a")
        if called && line.contains("codec") && s3_truth_contains_word(line, "stream") -> codec = true
        if called && line.contains("event") && s3_truth_contains_word(line, "stream") -> event = true
        if called && line.contains("collecting loop") && line.contains("yielding") -> collecting = true
    }
    // Original sort_unstable + dedup order and unique labels.
    result := [String]{}
    if codec -> result.push("codec mode called a stream")
    if collecting -> result.push("collecting loop called yielding")
    if event -> result.push("event called a stream")
    result
}

s3_truth_link_targets: fn(text: String) -> [String] {
    raw: text.bytes()
    open: "](".bytes()
    close: ")".bytes()
    result := [String]{}
    at := 0
    loop {
        start: s3_truth_find_bytes(raw, open, at)
        if start < 0 -> break
        end: s3_truth_find_bytes(raw, close, start + 2)
        if end < 0 -> break
        body: policy_slice_raw(raw, start + 2, end)
        first := ""
        loop word in policy_split_whitespace(body) {
            first = word.copy()
            break
        }
        result.push(first)
        at = end + 1
    }
    result
}

s3_truth_link_path: fn(raw: String) -> String {
    bytes: raw.bytes()
    start := 0
    end := bytes.len()
    // Rust trim_matches('<').trim_matches('>') in that exact order.
    loop start < end && bytes[start] == (U8{60}) -> start += 1
    loop end > start && bytes[end - 1] == (U8{60}) -> end -= 1
    loop start < end && bytes[start] == (U8{62}) -> start += 1
    loop end > start && bytes[end - 1] == (U8{62}) -> end -= 1
    trimmed: policy_slice_bytes(raw, start, end)
    bound := trimmed.bytes().len()
    hash: s3_truth_parse.find(trimmed, "#")
    question: s3_truth_parse.find(trimmed, "?")
    if hash >= 0 && hash < bound -> bound = hash
    if question >= 0 && question < bound -> bound = question
    policy_slice_bytes(trimmed, 0, bound)
}

// Port of tests/truthfulness.rs:1679-1763 and all helpers1930-1992.
s3_guard_vocabulary_senses: fn() {
    labels: [String]{"codec mode called a stream", "event called a stream", "collecting loop called yielding"}
    hostile: [String]{"The codec mode is called a stream.", "The event is called a stream.", "The collecting loop is called yielding."}
    loop i in 0..<labels.len() {
        found: s3_truth_retired_senses(hostile[i])
        matched := false
        loop label in found { if label == labels[i] -> matched = true }
        assert(matched, "hostile fixture must be rejected: {labels[i]}")
    }
    markdown: s3_truth_md_paths("Docs")
    vocabulary_path: s3_truth_files.canonicalize("Docs/spec/vocabulary.md") ?? panic("vocabulary path canonical")
    docs_root: s3_truth_files.canonicalize("Docs") ?? panic("docs path canonical")
    seen := [String:Bool]{}
    targets := [String]{}
    loop source in markdown {
        text: s3_truth_files.read(source) ?? next
        loop raw in s3_truth_link_targets(text) {
            target: s3_truth_link_path(raw)
            if target == "" || target.starts_with("/") || target.contains("://") -> next
            candidate: s3_truth_files.canonicalize(s3_truth_files.join(s3_truth_files.dirname(source), target)) ?? next
            if candidate != docs_root && !candidate.starts_with("{docs_root}/") -> next
            if !candidate.ends_with(".md") || candidate.ends_with("/.md") -> next
            // Dated evidence keeps its words as recorded (retirement_ratchet.jet).
            if guards_dated_evidence("Docs{policy_slice_bytes(candidate, docs_root.count_bytes(), candidate.count_bytes())}") -> next
            if seen.get(candidate) ?? false -> next
            _: seen.add(candidate, true)
            targets.push(candidate)
        }
    }
    violations := [String]{}
    loop target in targets {
        text: s3_truth_files.read(target) ?? next
        if target != vocabulary_path {
            retired: s3_truth_retired_senses(text)
            if retired.len() > 0 -> violations.push("{target}: retired senses: {retired}")
            has_word := false
            words: [String]{"stream", "reader", "event", "collecting loop"}
            loop word in words { if s3_truth_contains_word(text, word) -> has_word = true }
            if has_word && !text.contains("vocabulary.md") -> violations.push("{target}: uses Jet vocabulary without linking Docs/spec/vocabulary.md")
        }
    }
    assert(violations.len() == 0, "linked Markdown targets must use the vocabulary page and current senses: {violations}")
}

#Test("vocabulary_page_has_one_definition_and_no_retired_senses") {
    s3_guard_vocabulary_senses()
}

// Port of tests/truthfulness.rs:1110-1173, including the Tower-record fallback.
s3_truth_decision_id_byte: fn(b: U8) -> Bool Never! {
    s3_truth_ascii_word_byte(b) || b == (U8{45})
}

s3_truth_exact_decision_token: fn(text: String, authority: String) -> Bool {
    raw: text.bytes()
    length: authority.bytes().len()
    offset := 0
    loop offset <= raw.len() {
        found: s3_truth_parse.find_from(text, authority, offset)
        if found < 0 -> return false
        end: found + length
        before := false
        after := false
        if found > 0 -> before = s3_truth_decision_id_byte(raw[found - 1])
        if end < raw.len() -> after = s3_truth_decision_id_byte(raw[end])
        if !before && !after -> return true
        // The original match_indices is non-overlapping.
        if length > 0 {
            offset = end
        } else {
            offset = found + 1
            loop offset < raw.len() && raw[offset] >= (U8{128}) && raw[offset] < (U8{192}) -> offset += 1
        }
    }
    false
}

s3_truth_ratified_section: fn(docs: String) -> String {
    marker: "## Ratified"
    from: s3_truth_parse.find(docs, marker)
    assert(from >= 0, "Docs/spec/syntax-decisions.md missing ## Ratified")
    rest: policy_slice_bytes(docs, from + marker.bytes().len(), docs.bytes().len())
    to: s3_truth_parse.find(rest, "\n## ")
    if to < 0 -> return rest
    policy_slice_bytes(rest, 0, to)
}

s3_truth_ratified_decision_exists: fn(docs: String, tower: String, authority: String) -> Bool {
    loop raw in s3_truth_ratified_section(docs).lines() {
        line := raw.trim_start()
        if line.starts_with("- ") -> line = policy_slice_bytes(line, 2, line.bytes().len())
        if !line.starts_with("**") -> next
        rest: policy_slice_bytes(line, 2, line.bytes().len())
        end: s3_truth_parse.find(rest, "**")
        if end < 0 -> next
        heading: policy_slice_bytes(rest, 0, end)
        if s3_truth_exact_decision_token(heading, authority) -> return true
    }
    split: s3_truth_parse.rfind(authority, "=")
    id := authority
    if split >= 0 -> id = policy_slice_bytes(authority, 0, split)
    marker: "\"id\": \"{id}\""
    found: s3_truth_parse.find(tower, marker)
    if found < 0 -> return false
    tail: policy_slice_bytes(tower, found + marker.bytes().len(), tower.bytes().len())
    record_end: s3_truth_parse.find(tail, "\n      \"id\": \"")
    record := tail
    if record_end >= 0 -> record = policy_slice_bytes(tail, 0, record_end)
    if !record.contains("\"status\": \"ratified\"") -> return false
    if split < 0 -> return true
    outcome: policy_slice_bytes(authority, split + 1, authority.bytes().len())
    record.contains("\"outcome\": \"{outcome}\"")
}

s3_guard_exact_ratified_lookup: fn() {
    docs: "## Proposed\n**D-PENDING=A**: not law. See D-LIVE and D-CITED.\n## Ratified\n**D-LIVE=A**: supersedes D-CITED.\n## Declined\n**D-NOPE=A**: declined.\n"
    assert(s3_truth_ratified_decision_exists(docs, "", "D-LIVE"))
    assert(!s3_truth_ratified_decision_exists(docs, "", "D-LIV"))
    assert(!s3_truth_ratified_decision_exists(docs, "", "D-CITED"))
    assert(!s3_truth_ratified_decision_exists(docs, "", "D-PENDING=A"))
    assert(!s3_truth_ratified_decision_exists(docs, "", "D-NOPE=A"))
}

#Test("ratified_decision_lookup_requires_exact_id_and_ratified_status") {
    s3_guard_exact_ratified_lookup()
}
