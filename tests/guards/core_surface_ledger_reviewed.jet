use core.files as files

// Public teaching half of tests/core_surface_ledger.rs:43-104, called at140.
// Rust module_items/core_surface source spelling scans retire with Rust.
// Syntax::rename_target typed facts at92-103 are compiler-lib, not approximated here.
fn s3_reviewed_core_layering_teaching() {
    laws :: files.read("Docs/spec/stdlib-api-laws.md") ?? panic("read API laws")
    assert(laws.contains("D-ONCE-LAYER1=B"))
    assert(laws.contains("core.crypto.expert"))
    assert(laws.contains("core.http.client"))
    crypto :: files.read("Examples/features/crypto/random_api_split.jet") ?? panic("read crypto example")
    assert(crypto.contains("D-ONCE-LAYER1=B"))
    assert(crypto.contains("use core.crypto as crypto"))
    assert(crypto.contains("use core.crypto.expert as expert"))
    assert(crypto.contains("crypto rungs agree: {{rungs_agree}}"))
    http :: files.read("Examples/features/net/http_client.jet") ?? panic("read HTTP example")
    assert(http.contains("D-ONCE-LAYER1=B"))
    assert(http.contains("use core.http as http"))
    assert(http.contains("use core.http.client as http_client"))
    assert(http.contains("http.get("))
    assert(http.contains("http_client.request("))
}

#Test("Core surface ledger teaches the same ratified API layering") {
    s3_reviewed_core_layering_teaching()
}
