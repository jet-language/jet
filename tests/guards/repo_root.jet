// The guards read the repository relative to the working directory. A run
// started elsewhere (a case's work directory) names the checkout in
// JET_GUARDS_ROOT, and every guard test enters it before its first read.
// Unset, the working directory is the root: `jet test tests/guards` from the
// checkout runs as before.
use {
    guards_root_files: core.files
    guards_root_process: core.process
}

guards_enter_root: fn() {
    root: guards_root_process.env_get("JET_GUARDS_ROOT") ?? return
    guards_root_files.chdir(root) ?? panic("enter the repository root `{root}` named by JET_GUARDS_ROOT: {err}")
}
