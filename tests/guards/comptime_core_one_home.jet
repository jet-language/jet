use core.files as files
use core.text as text

// Same whitespace collapse as the original split_whitespace().join(" ").
fn s6_comptime_collapse_whitespace(source: String) -> String {
    words := [String]{}
    current := [String]{}
    loop scalar in source.chars() {
        rendered :: "{scalar}"
        if {
            text.is_whitespace(rendered) -> {
                if current.len() > 0 {
                    &words.push(current.join(""))
                    current = [String]{}
                }
            }
            else -> &current.push(rendered)
        }
    }
    if current.len() > 0 -> &words.push(current.join(""))
    return words.join(" ")
}

