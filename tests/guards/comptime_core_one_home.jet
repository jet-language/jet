// Rust-only: core.builtin, core.event constructor route was not selected,
// core.files.write_bytes expects [U8], core.files.write_bytes received an invalid U8,
// core.handle, core.log expects a Bool argument, core.log expects a List[LogField],
// core.log expects a LogField, core.log expects a LogSpan, core.log expects a String argument,
// core.log fields row was not selected, core.log level row was not selected,
// core.log span row was not selected, core.time.parse_rfc3339 pure-parity evaluator is registered,
// core.time.parse_rfc3339 row is registered, core.tui color profile takes no arguments,
// core.tui expected a structure, core.tui expected {expected}, core.tui expected {type_name},
// core.tui structure has no `{wanted}` field, core.tui.io_event() needs [Byte],
// core.tui.layout() needs Rect, core.tui.layout() needs [TUIConstraint],
// core.tui.list() needs [String], core.tui.table() needs [String] headers,
// core.tui.table() needs [[String]] rows, core.ui.box() needs UINode children,
// core.ui.box() needs [UINode], core.ui.node_role(): missing role.
// Diagnostic-message entries above are what the original unfiltered extractor
// actually finds; they are not reinterpreted as namespaces in the new table.
#Test("architecture classifies every comptime Core namespace") {
    source :: files.read("Compiler/JetCli/Source/Cli/CoreSources.jet") ?? panic("read canonical Core sources")
    architecture :: files.read("Docs/spec/architecture.md") ?? panic("read architecture classification")
    loop row in source.split("module_name: \"") {
        if row.starts_with("core.") {
            namespace :: row.split("\"").to_list()[0].to_string()
            assert(architecture.contains("| `{namespace}` |"), "architecture classification is missing {namespace}")
        }
    }
}

// Port of comptime_core_one_home.rs:228-268. Rust kernel include/fingerprint
// scans retire; both reference documentation predicates remain unchanged.
#Test("measurement has one semantic home") {
    source :: files.read("Docs/spec/reference/core-library.md") ?? panic("read Core reference")
    docs :: s6_comptime_collapse_whitespace(source)
    statements :: [String]{
        "first-order linear propagation with uncorrelated inputs",
        "Correlated errors are out of scope",
    }
    loop statement in statements {
        assert(docs.contains(statement), "measurement docs omit `{statement}`")
    }
}
