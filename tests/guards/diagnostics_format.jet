// Port of the What/Why/Fix table-body validator of the deleted
// tests/diagnostics_format.rs:221-324. Code shape comes from dc_is_code in
// diagnostics_coverage.jet.

// A markdown row split on unescaped `|`, each cell trimmed. `| a | b |`
// yields "", "a", "b", "".
df_markdown_cells: fn(line: String) -> [String] {
    cells := [String]{}
    current := [U8]{}
    escaped := false
    loop byte in line.bytes() {
        if byte == (U8{124}) && !escaped {
            cells.push((String.from_bytes(current) ?? panic("markdown cell must be UTF-8")).trim().copy())
            current = [U8]{}
        } else {
            current.push(byte)
        }
        escaped = byte == (U8{92}) && !escaped
    }
    cells.push((String.from_bytes(current) ?? panic("markdown cell must be UTF-8")).trim().copy())
    cells
}

df_is_wwf_header: fn(cells: [String]) -> Bool {
    cells.len() >= 5 && cells[1].lower() == "code" && cells[2].lower() == "what" && cells[3].lower() == "why" && cells[4].lower() == "fix"
}

// The code a row's first cell names, plain or in backticks; "" when none.
df_diagnostic_code: fn(cell: String) -> String {
    code := cell.copy()
    if code.count_bytes() >= 2 && code.starts_with("`") && code.ends_with("`") -> code = dc_slice(code, 1, code.count_bytes() - 1)
    if dc_is_code(code) -> code else -> ""
}

// Every malformed or incomplete row of every `| Code | What | Why | Fix |`
// table in `text`.
df_body_violations: fn(text: String) -> [String] {
    violations := [String]{}
    in_table := false
    loop (index, raw) in text.split("\n").to_list() {
        line: raw.trim().copy()
        if !line.starts_with("|") {
            in_table = false
            next
        }
        cells: df_markdown_cells(line)
        if df_is_wwf_header(cells) {
            in_table = true
            next
        }
        if !in_table || cells.all(cell -> cell.bytes().all(byte -> byte == (U8{45}))) -> next
        if cells.len() < 2 -> next
        code: df_diagnostic_code(cells[1])
        if code == "" -> next
        if cells.len() != 6 {
            violations.push("line {index + 1}: {code} — malformed What/Why/Fix row has {cells.len()} pipe-delimited cells, expected 6")
            next
        }
        if cells[2] == "" || cells[3] == "" || cells[4] == "" -> violations.push("line {index + 1}: {code} — What/Why/Fix must all be non-empty (what=\"{cells[2]}\" why=\"{cells[3]}\" fix=\"{cells[4]}\")")
    }
    violations
}

// tests/diagnostics_format.rs:221-233.
#Test("diagnostic_body_validator_rejects_malformed_rows") {
    guards_enter_root()
    malformed: "| Code | What | Why | Fix |\n| --- | --- | --- | --- |\n| E0001 | what | why | |\n| E0002 | what | why |\n| `E0003` | what | why | |\n"
    violations: df_body_violations(malformed)
    assert_eq(violations.len(), 3)
    assert(violations[0].contains("E0001") && violations[0].contains("non-empty"), violations[0])
    assert(violations[1].contains("E0002") && violations[1].contains("malformed"), violations[1])
    assert(violations[2].contains("E0003") && violations[2].contains("non-empty"), violations[2])
}
