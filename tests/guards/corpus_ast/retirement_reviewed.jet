use {
    s6_retirement_reviewed_files: core.files
    corpus_manifest.[policy_split_whitespace, guards_enter_root]
    jet_parser.[parse_generated_source]
    jet_foundation.[DIAGNOSTIC_ERROR]
    jet_lexer.[lex, lex_generated, Token, TokenTables, STRING_PART_INTERPOLATION, TOKEN_IDENT, TOKEN_STRING, TOKEN_RAW_STRING, TOKEN_INT, TOKEN_FLOAT, TOKEN_UNIT_NUMBER, TOKEN_CHAR, TOKEN_TRUE, TOKEN_FALSE, TOKEN_NULL, TOKEN_KW_IT, TOKEN_SELF, TOKEN_RPAREN, TOKEN_RBRACKET, TOKEN_RBRACE, TOKEN_PLUS_PLUS, TOKEN_MINUS_MINUS, TOKEN_GT, TOKEN_SHR, TOKEN_COLON, TOKEN_COLON_COLON, TOKEN_LPAREN, TOKEN_LBRACKET, TOKEN_STAR, TOKEN_KW_FN, TOKEN_BANG, TOKEN_QUESTION, TOKEN_HASH, TOKEN_UNIFIED_ARROW, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT, TOKEN_EOF]
}

// Failure-surface source law: walk boundaries, fenced and embedded fragments.
// Token facts use the compiler lexer, never a text substitute.
S6RetirementReviewedFragment: struct { first_line: Int source: String }
S6RetirementReviewedHit: struct { line: Int spelling: String }
// A `?` or `!` the token pass proposes, with its byte span and the end offsets
// of its neighbour tokens for the canonical rewrites (`after` is -1 unless a
// name follows: only an error type takes a moved `!`);
// `after_value` marks a `?` right after a call, an index or a literal.
S6RetirementReviewedCandidate: struct { line: Int spelling: String question: Bool after_value: Bool start: Int end: Int before: Int after: Int }
S6RetirementReviewedFence: struct { marker: Int length: Int rest: String }

s6_retirement_reviewed_slice: fn(text: String, start: Int, end: Int) -> String {
    String.from_bytes(text.bytes()[start..<end].copy()) ?? panic("source boundary")
}

s6_retirement_reviewed_skipped: fn(path: String) -> Bool {
    loop part in path.split("/") {
        if part.starts_with(".") || part.starts_with("target") || part == "build" || part == "node_modules" -> return true
    }
    false
}

s6_retirement_reviewed_walk_law: fn() {
    assert(s6_retirement_reviewed_skipped("build"))
    assert(s6_retirement_reviewed_skipped(".claude/worktrees/worker/examples"))
    assert(s6_retirement_reviewed_skipped(".agent-worktrees/worker/examples"))
    assert(!s6_retirement_reviewed_skipped("Examples"))
    tail: "que"
    live_type: "De{tail}"
    assert(s6_retirement_reviewed_contains_word("let queue: {live_type}<Int> = {live_type}.new()", live_type))
}

s6_retirement_reviewed_word_byte: fn(byte: U8) -> Bool {
    value: Int.from_u8(byte)
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || (value >= 48 && value <= 57) || value == 95
}

s6_retirement_reviewed_contains_word: fn(text: String, word: String) -> Bool {
    raw: text.bytes()
    needle: word.bytes()
    loop start in 0..<(raw.len() - needle.len() + 1) {
        matches := true
        loop at in 0..<needle.len() {
            if raw[start + at] != needle[at] -> matches = false
        }
        if !matches -> next
        end: start + needle.len()
        before: if start > 0 -> s6_retirement_reviewed_word_byte(raw[start - 1]) else -> false
        after: if end < raw.len() -> s6_retirement_reviewed_word_byte(raw[end]) else -> false
        if !before && !after -> return true
    }
    false
}

// String literal facts live in the lexer's token tables: an interpolation's
// tokens are part of its literal row, with spans in source coordinates.
s6_retirement_reviewed_collect: fn(tables: TokenTables, tokens: [Token], out: &[Token]) {
    loop token in tokens {
        if token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT || token.kind == TOKEN_EOF -> next
        out.push(token.copy())
        if (token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING) && token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION -> s6_retirement_reviewed_collect(tables, part.tokens, out)
            }
        }
    }
}

s6_retirement_reviewed_type_atom: fn(token: Token) -> Bool {
    token.kind == TOKEN_IDENT || token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACKET || token.kind == TOKEN_GT || token.kind == TOKEN_SHR
}

s6_retirement_reviewed_contract_position: fn(token: Token) -> Bool {
    s6_retirement_reviewed_type_atom(token) || token.kind == TOKEN_COLON || token.kind == TOKEN_COLON_COLON || token.kind == TOKEN_RPAREN
}

s6_retirement_reviewed_expression_end: fn(token: Token) -> Bool {
    kinds: [Int]{TOKEN_IDENT, TOKEN_STRING, TOKEN_RAW_STRING, TOKEN_INT, TOKEN_FLOAT, TOKEN_UNIT_NUMBER, TOKEN_CHAR, TOKEN_TRUE, TOKEN_FALSE, TOKEN_NULL, TOKEN_KW_IT, TOKEN_SELF, TOKEN_RPAREN, TOKEN_RBRACKET, TOKEN_RBRACE, TOKEN_PLUS_PLUS, TOKEN_MINUS_MINUS}
    kinds.contains(token.kind)
}

// An identifier's first source byte classifies it; the token span is in source coordinates.
s6_retirement_reviewed_first_byte: fn(source: String, token: Token) -> Int? {
    if token.kind != TOKEN_IDENT || token.span.end <= token.span.start -> return None
    Val(Int.from_u8(source.bytes()[token.span.start]))
}

s6_retirement_reviewed_type_name: fn(source: String, token: Token) -> Bool {
    first: s6_retirement_reviewed_first_byte(source, token) ?? return false
    first >= 65 && first <= 90
}

s6_retirement_reviewed_lower_name: fn(source: String, token: Token) -> Bool {
    first: s6_retirement_reviewed_first_byte(source, token) ?? return false
    (first >= 97 && first <= 122) || first == 95
}

s6_retirement_reviewed_result_arm: fn(source: String, tokens: [Token], index: Int) -> Bool {
    if index < 1 || index + 2 >= tokens.len() -> return false
    s6_retirement_reviewed_lower_name(source, tokens[index - 1]) && s6_retirement_reviewed_lower_name(source, tokens[index + 1]) && tokens[index + 2].kind == TOKEN_UNIFIED_ARROW
}

s6_retirement_reviewed_infix: fn(source: String, tokens: [Token], index: Int) -> Bool {
    if index < 1 || index + 1 >= tokens.len() -> return false
    previous: tokens[index - 1]
    following: tokens[index + 1]
    if !s6_retirement_reviewed_type_atom(previous) || !(s6_retirement_reviewed_type_atom(following) || following.kind == TOKEN_LPAREN) -> return false
    if s6_retirement_reviewed_result_arm(source, tokens, index) -> return false
    s6_retirement_reviewed_type_name(source, previous) || s6_retirement_reviewed_type_name(source, following)
}

s6_retirement_reviewed_type_prefix: fn(source: String, token: Token) -> Bool {
    s6_retirement_reviewed_type_name(source, token) || token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_STAR || token.kind == TOKEN_KW_FN
}

s6_retirement_reviewed_line: fn(source: String, offset: Int) -> Int {
    line := 1
    bytes: source.bytes()
    loop at in 0..<offset {
        if Int.from_u8(bytes[at]) == 10 -> line += 1
    }
    line
}

s6_retirement_reviewed_value_end: fn(token: Token) -> Bool {
    token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACKET || token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING || token.kind == TOKEN_INT || token.kind == TOKEN_FLOAT || token.kind == TOKEN_UNIT_NUMBER || token.kind == TOKEN_CHAR || token.kind == TOKEN_TRUE || token.kind == TOKEN_FALSE || token.kind == TOKEN_NULL
}

// The token pass proposes candidates by position: a `?` or `!` after an
// expression end or in a contract position.
s6_retirement_reviewed_candidates: fn(source: String) -> [S6RetirementReviewedCandidate] {
    lexed: lex(source.bytes())
    tokens := [Token]{}
    s6_retirement_reviewed_collect(lexed.tables, lexed.tokens, tokens)
    tokens.sort_by(token -> token.span.start)
    candidates := [S6RetirementReviewedCandidate]{}
    loop index in 0..<tokens.len() {
        token: tokens[index]
        proposed := ""
        if token.kind == TOKEN_BANG {
            marker_negation: index >= 2 && tokens[index - 2].kind == TOKEN_HASH
            canonical_prefix := false
            if index + 1 < tokens.len() {
                following: tokens[index + 1]
                canonical_prefix = token.span.end == following.span.start && (following.kind == TOKEN_IDENT || following.kind == TOKEN_LPAREN || following.kind == TOKEN_LBRACKET || following.kind == TOKEN_STAR || following.kind == TOKEN_KW_FN)
            }
            if marker_negation || canonical_prefix || s6_retirement_reviewed_result_arm(source, tokens, index) -> next
            if index > 0 && s6_retirement_reviewed_contract_position(tokens[index - 1]) -> proposed = "retired failure contract"
        } else if token.kind == TOKEN_QUESTION {
            contextual: index + 1 < tokens.len() && tokens[index + 1].kind == TOKEN_LPAREN
            handler: index + 2 < tokens.len() && s6_retirement_reviewed_lower_name(source, tokens[index + 1]) && tokens[index + 2].kind == TOKEN_UNIFIED_ARROW
            optional_prefix: index + 1 < tokens.len() && s6_retirement_reviewed_type_prefix(source, tokens[index + 1]) && token.span.end == tokens[index + 1].span.start
            expression_end: index > 0 && s6_retirement_reviewed_expression_end(tokens[index - 1])
            if contextual || handler || optional_prefix -> next
            if s6_retirement_reviewed_infix(source, tokens, index) || expression_end -> proposed = "retired failure propagation/type"
        }
        if proposed == "" -> next
        before: if index > 0 -> tokens[index - 1].span.end else -> -1
        after: if index + 1 < tokens.len() && tokens[index + 1].kind == TOKEN_IDENT -> tokens[index + 1].span.end else -> -1
        candidates.push(S6RetirementReviewedCandidate{line: s6_retirement_reviewed_line(source, token.span.start), spelling: proposed, question: token.kind == TOKEN_QUESTION, after_value: index > 0 && s6_retirement_reviewed_value_end(tokens[index - 1]), start: token.span.start, end: token.span.end, before: before, after: after})
    }
    candidates
}

s6_retirement_reviewed_parses: fn(source: String) -> Bool {
    if lex_generated(source.bytes()).diagnostics.len() > 0 -> return false
    parsed: parse_generated_source(source.bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return false
    }
    true
}

// Documentation quotes types (`Int?`) and contracts (`-> Int IOError!`) on
// their own, and the Core coverage ratchet stores signatures without `fn`
// (`(value: String) -> [U8]?`), so a snippet gets a parse as statements, as a
// type, as a signature tail, as a signature and as a parameter list.
s6_retirement_reviewed_snippet_current: fn(source: String) -> Bool {
    shapes: [String]{source, "probe: fn() {{\n{source}\n}}", "alias Probe: {source}", "probe: fn() {source} {{}}", "probe: fn() -> {source} {{}}", "{source} {{}}", "probe: fn{source} {{}}"}
    loop shape in shapes {
        if s6_retirement_reviewed_parses(shape) -> return true
    }
    false
}

// Embedded string fragments keep their escapes; the unescaped text is the Jet
// a JSON or source string actually carries.
s6_retirement_reviewed_unescape: fn(source: String) -> String {
    bytes: source.bytes()
    out := [U8]{}
    cursor := 0
    loop cursor < bytes.len() {
        byte: bytes[cursor]
        if Int.from_u8(byte) == 92 && cursor + 1 < bytes.len() {
            escaped: Int.from_u8(bytes[cursor + 1])
            if escaped == 110 -> out.push(U8{10})
            else if escaped == 116 -> out.push(U8{9})
            else if escaped == 34 || escaped == 92 || escaped == 39 -> out.push(bytes[cursor + 1])
            else {
                out.push(byte)
                out.push(bytes[cursor + 1])
            }
            cursor += 2
            next
        }
        out.push(byte)
        cursor += 1
    }
    String.from_bytes(out) ?? source.copy()
}

// A fragment is current Jet when the parser accepts the whole of it, as a file
// (inline package header stripped), in a snippet shape, or unescaped.
s6_retirement_reviewed_current: fn(source: String) -> Bool {
    lexed: lex_generated(source.bytes())
    if s6_retirement_reviewed_parses(policy_strip_inline_package(source, lexed.tokens)) -> return true
    if s6_retirement_reviewed_snippet_current(source) -> return true
    if !source.contains("\\") -> return false
    unescaped: s6_retirement_reviewed_unescape(source)
    s6_retirement_reviewed_parses(unescaped) || s6_retirement_reviewed_snippet_current(unescaped)
}

// One line of a fragment the parser rejects as a whole: the line is current
// when it parses as a snippet or as the line of a construct that spans lines:
// a signature or block head, a statement opening a block, a parameter, a
// field, a variant, or the closing line of a multi-line signature.
s6_retirement_reviewed_line_current: fn(line: String) -> Bool {
    if s6_retirement_reviewed_snippet_current(line) -> return true
    shapes: [String]{"{line}\n}}", "probe: fn() {{\n{line}\n}}\n}}", "probe: fn({line}) {{}}", "probe: fn({line}\n}}", "Probe: struct {{ {line} }}", "Probe: enum {{ {line} }}"}
    loop shape in shapes {
        if s6_retirement_reviewed_parses(shape) -> return true
    }
    false
}

// The canonical rewrites of a candidate on its line: drop it (propagation
// `read()?` after a call, an index or a literal; a bare `!`; a name such as
// `Apply? [y/N]` is prose or a type, never a propagation the parser can confirm), move a `!` behind the following token (`T ! E` to `T E!`), and
// for a `?` between two tokens, attach it to the left one and fail with the
// right one (`T ? E` to `T? E!`).
s6_retirement_reviewed_rewrites_current: fn(bytes: [U8], from: Int, to: Int, candidate: S6RetirementReviewedCandidate) -> Bool {
    head: s6_retirement_reviewed_slice_bytes(bytes, from, candidate.start)
    tail: s6_retirement_reviewed_slice_bytes(bytes, candidate.end, to)
    rewrites := [String]{}
    if !candidate.question || candidate.after_value -> rewrites.push("{head}{tail}")
    if candidate.after >= candidate.end && candidate.after <= to {
        between: s6_retirement_reviewed_slice_bytes(bytes, candidate.end, candidate.after)
        rest: s6_retirement_reviewed_slice_bytes(bytes, candidate.after, to)
        rewrites.push("{head}{between}!{rest}")
        if candidate.question && candidate.before >= from && candidate.before <= candidate.start {
            left: s6_retirement_reviewed_slice_bytes(bytes, from, candidate.before)
            gap: s6_retirement_reviewed_slice_bytes(bytes, candidate.before, candidate.start)
            rewrites.push("{left}?{gap}{between}!{rest}")
        }
    }
    loop rewrite in rewrites {
        if s6_retirement_reviewed_line_current(rewrite.trim().copy()) -> return true
    }
    false
}

// The parser is the grammar authority. The token pass reads `?` and `!` by
// position and cannot tell `-> Int?` or `-> Int IOError!` from retired
// propagation, because the Jet lexer emits a separate QUESTION or BANG token
// after a type name. A candidate is a retired failure spelling when the parser
// rejects its line in every shape and accepts the line once the candidate takes
// its canonical rewrite. So an accepted fragment has no hit, an unrelated error
// elsewhere in a file leaves its current lines alone, and prose, URLs and
// regular expressions that merely hold a `?` or `!` are not Jet.
s6_retirement_reviewed_hits: fn(source: String) -> [S6RetirementReviewedHit] {
    candidates: s6_retirement_reviewed_candidates(source)
    if candidates.len() == 0 || s6_retirement_reviewed_current(source) -> return [S6RetirementReviewedHit]{}
    bytes: source.bytes()
    hits := [S6RetirementReviewedHit]{}
    rejected := [Int: Bool]{}
    loop candidate in candidates {
        from := candidate.start
        loop from > 0 && Int.from_u8(bytes[from - 1]) != 10 -> from -= 1
        to := candidate.end
        loop to < bytes.len() && Int.from_u8(bytes[to]) != 10 -> to += 1
        line_rejected: rejected.get(from) ?? !s6_retirement_reviewed_line_current(s6_retirement_reviewed_slice_bytes(bytes, from, to).trim().copy())
        rejected[from] = line_rejected
        if line_rejected && s6_retirement_reviewed_rewrites_current(bytes, from, to, candidate) -> hits.push(S6RetirementReviewedHit{line: candidate.line, spelling: candidate.spelling})
    }
    hits
}

s6_retirement_reviewed_detector_law: fn() {
    // `value: !IOError` left the current list: the parser rejects it (E0003).
    current: "maybe: fn() -> Int? {{ None }}\ntyped: fn() -> Int IOError! {{ 1 }}\nunion: fn() -> Int (DbError | TimeoutError)! {{ 1 }}\nunit: fn() IOError! {{}}\ncontext: fn() -> Int IOError! {{ read()?(\"loading\") }}\nhandled: fn() -> Int IOError! {{ value ? ok -> ok ! failure -> 0 }}\nif !ready -> print(\"ready\")\n"
    assert_eq(s6_retirement_reviewed_hits(current).len(), 0)
    snippets: [String]{"Int?", "[String]?", "-> Int IOError!", "Int (DbError | TimeoutError)!", "first: fn(flag: Bool) -> Int?", "empty: Int?{{None}}", "Apply? [y/N]", "/reconnect?cursor=<sequence>", "{{2,5}}?", "exact: fn() -> Decimal Never! {{ math.decimal(\\\"1.20\\\") }}"}
    loop snippet in snippets -> assert(s6_retirement_reviewed_hits(snippet).len() == 0, "current failure syntax misread: {snippet}")
    // The Rust samples also spelled signatures without `->` (`f: fn() Int E!`);
    // the parser rejects that form itself (D-SIG-AFTER1), so each sample here
    // carries a current signature around the one retired failure spelling.
    // The Rust `null?` sample is gone: the parser accepts `x: null?`, so it
    // is not a spelling the parser authority can confirm.
    retired: [String]{
        "infix_bang: fn() -> Int ! Error {{ 1 }}\n", "infix_question: fn() -> Int ? Error {{ 1 }}\n", "bare: fn() ! {{}}\n", "propagated: fn() -> Int {{ read()? }}\n", "literal_propagation: fn() -> Bool {{ true? }}\n", "string_propagation: fn() -> String {{ \"value\"? }}\n", "run: fn() {{ x: read()? }}\n", "T ! E", "if load(path)? == {{"
    }
    loop source in retired -> assert(s6_retirement_reviewed_hits(source).len() > 0, "retired failure syntax missed: {source}")
    // An unrelated parse error leaves current lines current and retired lines retired.
    assert_eq(s6_retirement_reviewed_hits("ok: fn() -> Int? {{ None }}\nbroken: fn( {{\n").len(), 0)
    assert(s6_retirement_reviewed_hits("ok: fn() -> Int? {{ None }}\nbad: fn() {{ x: read()? }}\nbroken: fn( {{\n").len() == 1, "a retired line beside an unrelated parse error is missed")
}

s6_retirement_reviewed_fence: fn(line: String) -> S6RetirementReviewedFence? {
    trimmed: line.trim_start().copy()
    bytes: trimmed.bytes()
    if bytes.len() == 0 -> return None
    marker: Int.from_u8(bytes[0])
    if marker != 96 && marker != 126 -> return None
    length := 0
    loop length < bytes.len() && Int.from_u8(bytes[length]) == marker -> length += 1
    if length < 3 -> return None
    Val(S6RetirementReviewedFence{marker: marker, length: length, rest: s6_retirement_reviewed_slice(trimmed, length, bytes.len())})
}

s6_retirement_reviewed_inline: fn(line: String) -> [String] {
    bytes: line.bytes()
    fragments := [String]{}
    cursor := 0
    loop cursor < bytes.len() {
        if Int.from_u8(bytes[cursor]) != 96 {
            cursor += 1
            next
        }
        length := 0
        loop cursor + length < bytes.len() && Int.from_u8(bytes[cursor + length]) == 96 -> length += 1
        start: cursor + length
        close := start
        loop close < bytes.len() {
            if Int.from_u8(bytes[close]) != 96 {
                close += 1
                next
            }
            close_length := 0
            loop close + close_length < bytes.len() && Int.from_u8(bytes[close + close_length]) == 96 -> close_length += 1
            if close_length == length {
                fragments.push(s6_retirement_reviewed_slice(line, start, close))
                cursor = close + close_length
                break
            }
            close += close_length
        }
        if close >= bytes.len() -> break
    }
    fragments
}

s6_retirement_reviewed_looks_jet: fn(source: String) -> Bool {
    markers: [String]{"fn ", "alias ", "struct ", "pub fn ", "->", "-[", "fallible", "failure", "optional"}
    loop marker in markers {
        if source.contains(marker) -> return true
    }
    false
}

s6_retirement_reviewed_find: fn(text: String, needle: String, from: Int) -> Int {
    s6_retirement_reviewed_find_bytes(text.bytes(), needle.bytes(), from)
}

s6_retirement_reviewed_find_bytes: fn(raw: [U8], wanted: [U8], from: Int) -> Int {
    loop start in from..<(raw.len() - wanted.len() + 1) {
        matches := true
        loop at in 0..<wanted.len() {
            if raw[start + at] != wanted[at] -> matches = false
        }
        if matches -> return start
    }
    -1
}

s6_retirement_reviewed_slice_bytes: fn(bytes: [U8], start: Int, end: Int) -> String {
    String.from_bytes(bytes[start..<end].copy()) ?? panic("source boundary")
}

// One pass over the bytes: slices and line numbers reuse the scan position, so
// a large data file costs linear time rather than one full rescan per string.
s6_retirement_reviewed_embedded: fn(text: String) -> [S6RetirementReviewedFragment] {
    bytes: text.bytes()
    fragments := [S6RetirementReviewedFragment]{}
    cursor := 0
    line := 1
    line_cursor := 0
    loop cursor < bytes.len() {
        loop line_cursor < cursor {
            if Int.from_u8(bytes[line_cursor]) == 10 -> line += 1
            line_cursor += 1
        }
        if Int.from_u8(bytes[cursor]) == 114 {
            quote := cursor + 1
            loop quote < bytes.len() && Int.from_u8(bytes[quote]) == 35 -> quote += 1
            if quote < bytes.len() && Int.from_u8(bytes[quote]) == 34 {
                hashes: s6_retirement_reviewed_slice_bytes(bytes, cursor + 1, quote)
                close: "\"{hashes}"
                start: quote + 1
                end: s6_retirement_reviewed_find_bytes(bytes, close.bytes(), start)
                if end < 0 {
                    cursor += 1
                    next
                }
                source: s6_retirement_reviewed_slice_bytes(bytes, start, end)
                if s6_retirement_reviewed_looks_jet(source) -> fragments.push(S6RetirementReviewedFragment{first_line: line, source: source})
                cursor = end + close.bytes().len()
                next
            }
        }
        if Int.from_u8(bytes[cursor]) == 34 {
            start: cursor + 1
            end := start
            loop end < bytes.len() {
                if Int.from_u8(bytes[end]) == 92 -> end += 2
                else if Int.from_u8(bytes[end]) == 34 -> break
                else -> end += 1
            }
            if end < bytes.len() {
                source: s6_retirement_reviewed_slice_bytes(bytes, start, end)
                if s6_retirement_reviewed_looks_jet(source) -> fragments.push(S6RetirementReviewedFragment{first_line: line, source: source})
                cursor = end + 1
                next
            }
        }
        cursor += 1
    }
    fragments
}

s6_retirement_reviewed_extension: fn(path: String) -> String {
    name: path.split("/").to_list().last() ?? ""
    pieces: name.split(".").to_list()
    if pieces.len() < 2 || (pieces.len() == 2 && pieces[0] == "") -> return ""
    pieces[pieces.len() - 1]
}

s6_retirement_reviewed_fragments: fn(path: String, text: String) -> [S6RetirementReviewedFragment] {
    extension: s6_retirement_reviewed_extension(path)
    if extension == "jet" -> return [S6RetirementReviewedFragment]{S6RetirementReviewedFragment{first_line: 1, source: text}}
    if path.starts_with("Tools/editors/tree-sitter/test/corpus/") {
        end: s6_retirement_reviewed_find(text, "\n---", 0)
        source: if end < 0 -> text else -> s6_retirement_reviewed_slice(text, 0, end)
        return [S6RetirementReviewedFragment]{S6RetirementReviewedFragment{first_line: 1, source: source}}
    }
    if extension != "md" -> return s6_retirement_reviewed_embedded(text)
    fragments := [S6RetirementReviewedFragment]{}
    opened := false
    marker := 0
    length := 0
    first_line := 0
    active := false
    source := ""
    index := 0
    loop line in text.lines() {
        fence: s6_retirement_reviewed_fence(line)
        if opened {
            closing := false
            if fence == .Val(found) -> closing = found.marker == marker && found.length >= length && found.rest.trim() == ""
            if closing {
                if active -> fragments.push(S6RetirementReviewedFragment{first_line: first_line, source: source})
                opened = false
            } else if active -> source = "{source}{line}\n"
        } else if fence == .Val(found) {
            words: policy_split_whitespace(found.rest)
            language: words.first() ?? ""
            marker = found.marker
            length = found.length
            first_line = index + 2
            active = language == "jet" || language == "Jet" || language == "jetlang"
            source = ""
            opened = true
        } else {
            snippets: s6_retirement_reviewed_inline(line)
            loop snippet in snippets -> fragments.push(S6RetirementReviewedFragment{first_line: index + 1, source: snippet})
        }
        index += 1
    }
    if opened && active -> fragments.push(S6RetirementReviewedFragment{first_line: first_line, source: source})
    fragments
}

s6_retirement_reviewed_failure_skip: fn(path: String) -> Bool {
    if path.starts_with("Tools/gauntlet/results") -> return true
    excluded: [String]{".git", ".claude", ".agent-worktrees", ".opencode", ".tower", "node_modules", "build"}
    loop part in path.split("/") {
        if excluded.contains(part) || part.starts_with("target") -> return true
    }
    false
}

// `tests/cases/fmt/` holds the formatter fixtures that the Rust law allowlisted
// as `tests/fmt.rs`: they feed retired forms to the formatter fixes.
s6_retirement_reviewed_allowlisted: fn(path: String) -> Bool {
    path == "Docs/spec/syntax-decisions.md" || path == "Docs/spec/contributing/agent-engineering.md" || path == "Docs/spec/reference/prior-art.md" || path.starts_with("Docs/audits/") || path.starts_with("Docs/proposals/") || path.starts_with("Docs/research/") || path.starts_with("Tools/agent-eval/domain-foundations/") || path.starts_with("tests/ui/") || path.starts_with("tests/fuzz/") || path == "tests/guards/syntax_reconciliation.jet" || path == "Tools/notebook-test/Acceptance.jet" || path == "Compiler/Prelude/Diagnostics.jet" || path.starts_with("tests/cases/fmt/")
}

s6_retirement_reviewed_scan_file: fn(path: String, offenders: &[String]) {
    if s6_retirement_reviewed_allowlisted(path) -> return
    text: s6_retirement_reviewed_files.read(path) ?? return
    fragments: s6_retirement_reviewed_fragments(path, text)
    loop fragment in fragments {
        hits: s6_retirement_reviewed_hits(fragment.source)
        loop hit in hits -> offenders.push("{path}:{fragment.first_line + hit.line - 1}: {hit.spelling}")
    }
}

s6_retirement_reviewed_walk: fn(path: String, offenders: &[String]) {
    entries: s6_retirement_reviewed_files.list_dir(path) ?? return
    extensions: [String]{"jet", "md", "rs", "js", "json", "scm", "toml", "txt", "yaml", "yml"}
    loop entry in entries {
        kind: s6_retirement_reviewed_files.stat(entry.path) ?? next
        if kind.is_symlink -> next
        relative: "{path}/{entry.name}"
        if kind.is_dir {
            if !s6_retirement_reviewed_failure_skip(relative) -> s6_retirement_reviewed_walk(relative, offenders)
        } else if extensions.contains(s6_retirement_reviewed_extension(relative)) -> s6_retirement_reviewed_scan_file(relative, offenders)
    }
}

s6_retirement_reviewed_surface_law: fn() {
    offenders := [String]{}
    // The live tree: the Rust law walked crates, Source and corelib, which the
    // compiler, Core and Jetpack trees replaced.
    roots: [String]{"Compiler", "Core", "Jetpack", "Examples", "tests", "Docs", "Tools"}
    loop root in roots -> s6_retirement_reviewed_walk(root, offenders)
    entries: s6_retirement_reviewed_files.list_dir(".") ?? [s6_retirement_reviewed_files.DirEntry]{}
    loop entry in entries {
        if s6_retirement_reviewed_extension(entry.name) != "jet" -> next
        kind: s6_retirement_reviewed_files.stat(entry.path) ?? next
        if kind.is_file -> s6_retirement_reviewed_scan_file(entry.name, offenders)
    }
    if s6_retirement_reviewed_files.is_file("README.md") -> s6_retirement_reviewed_scan_file("README.md", offenders)
    assert(offenders.len() == 0, "retired failure syntax escaped the diagnostic/history allowlist: {offenders}")
}

#Test("retirement walk skips outputs and nested worktrees but keeps live source visible") {
    guards_enter_root()
    s6_retirement_reviewed_walk_law()
}
#Test("failure syntax detector accepts current forms only") {
    guards_enter_root()
    s6_retirement_reviewed_detector_law()
}
// Known failing: #6221 (retired `?` propagation in Compiler/JetDevserver and
// Compiler/JetDebug, JetLSP Lsp.jet:279, and two docs).
#Test("failure surface has no active retired spelling") {
    guards_enter_root()
    s6_retirement_reviewed_surface_law()
}
