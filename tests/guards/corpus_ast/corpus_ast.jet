policy_ast_test_migration_shapes: fn() PolicyError! {
    policy_check_shapes([PolicyShapeCase]{
        PolicyShapeCase{path: "Examples/Memory/reintroduced.jet", source: "run: fn() {{ delay: Duration.seconds(1.5) }}", rule: "duration-constant-safe", present: true},
        PolicyShapeCase{path: "Examples/Memory/reintroduced.jet", source: "run: fn(seconds: Float) {{ delay: Duration.seconds(seconds) }}", rule: "duration-constant-safe", present: false},
        PolicyShapeCase{path: "Examples/Text/reintroduced.jet", source: "run: fn() {{ value: Meter.from_float(source.raw() * 2) }}", rule: "unit-scalar-rewrap", present: true},
        // The Rust case named Examples/Types/Units/UnitFamily.jet. Its scope row
        // is retired: Currency is nominal (D-QUAL3, D-DIST1), `Usd * Int` is E0127,
        // so the example's rewrap is the language's own conversion. The shape keeps
        // its proof under the time examples' scope.
        PolicyShapeCase{path: "Examples/Systems/Time/reintroduced.jet", source: "subtotal: fn(price: Usd, qty: Int) -> Usd {{ Usd.from_float(price.raw() * Float.from_int(qty)) }}", rule: "unit-scalar-rewrap", present: true},
        PolicyShapeCase{path: "Examples/Text/reintroduced.jet", source: "run: fn() {{ value: Meter.from_float(source.raw() * calibrate(2.0)) }}", rule: "unit-scalar-rewrap", present: false},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "run: fn() {{ print(\"{{value:Fixed(2)}}\".replace(\",\", \"\")) }}", rule: "plain-format-fact", present: true},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "run: fn() {{ print(\"{{value:Grouped(2)}}\".replace(\",\", \"\")) }}", rule: "plain-format-fact", present: false},
        PolicyShapeCase{path: "Docs/site/generate.jet", source: "run: fn() {{ files.create_dir(\"dist\") }}", rule: "dogfood-directory-setup", present: true},
        PolicyShapeCase{path: "Docs/site/generate.jet", source: "run: fn() {{ files.create_dir_all(\"dist\") }}", rule: "dogfood-directory-setup", present: false},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "duplicate_equal: fn(left: Dyn, right: Dyn) -> Bool {{ return true }}", rule: "dyn-domain-policy", present: true},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "javascript_truthy: fn(value: Dyn) -> Bool {{ return true }}", rule: "dyn-domain-policy", present: false},
        PolicyShapeCase{path: "Jetpack/PackageModel/Source/Envelope/PathLaw.jet", source: "run: fn() {{ value: \"text\".replace(\"A\", \"a\").replace(\"B\", \"b\") }}", rule: "dogfood-ascii", present: false},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "pattern: fn() {{ value: Regex{{\"^x$\"}} }}\nrun: fn(value: String) {{\n    matched: re.match(Regex{{\"x\"}}, value)\n    print(matched.group(1) ?? \"\")\n}}", rule: "regex-capture-recipe", present: true},
        PolicyShapeCase{path: "Docs/spec/guides/first-hour.md", source: "```jet\n#CLI\nArgs: struct {{ name: String }}\n```\n```bash\njet build\n```", rule: "first-hour-doc-recipe", present: true},
    })
    lower: policy_planted_ascii_ladder()
    violations: policy_evaluate_source(policy_manifest(), "Jetpack/PackageModel/Source/Envelope/PathLaw.jet", "run: fn() {{ value: {lower} }}")
    assert(policy_has_rule(violations, "dogfood-ascii"))
    Ok()
}
#Test("semantic_migration_rules_match_only_their_structural_shapes") {
    guards_enter_root()
    policy_ast_test_migration_shapes() ?? panic("{err.message}")
}
