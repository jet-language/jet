struct PolicyShapeCase { path: String, source: String, rule: String, present: Bool }
fn policy_check_shapes(cases: [PolicyShapeCase]) PolicyError! {
    manifest :: policy_manifest()
    loop example in cases {
        violations :: policy_evaluate_source(manifest, example.path, example.source)
        assert_eq(policy_has_rule(violations, example.rule), example.present, "{example.path}: {example.rule}: {policy_occurrence_messages(violations)}")
    }
    Ok(Unit{})
}
fn policy_ast_test_reintroduced_ceremony() PolicyError! {
    cases :: [PolicyShapeCase]{
        PolicyShapeCase{path: "Examples/features/basics/hello.jet", source: "fn run() {{ print(\"hello\") }}", rule: "entry-implicit", present: true},
        PolicyShapeCase{path: "Docs/spec/guides/first-hour.md", source: "jet build Examples/features/basics/first_hour.jet", rule: "first-hour-doc-recipe", present: true},
        PolicyShapeCase{path: "Examples/features/types/typed_literal_forms.jet", source: "fn run() {{ print(\"jet build Examples/features/types/typed_literal_forms.jet\") }}", rule: "first-hour-doc-recipe", present: true},
        PolicyShapeCase{path: "Examples/features/serde/reintroduced.jet", source: "#Codable\nstruct Sample {{\n    value: Int\n}}\nfn run() {{}}", rule: "codable-structural", present: true},
        PolicyShapeCase{path: "Examples/features/memory/reintroduced.jet", source: "fn run() {{\n    delay :: Duration.hours(2) ?? return Err(\"duration\")\n}}", rule: "duration-constant-safe", present: true},
        PolicyShapeCase{path: "Examples/features/basics/reintroduced_effect.jet", source: "use core.files as fs\nfn run() -[FS, IO]> {{\n    path :: \"input.txt\"\n    text :: fs.read(path)\n    print(text)\n}}", rule: "effect-row-inference", present: true},
        PolicyShapeCase{path: "Examples/features/concurrency/parallel_scan.jet", source: "use core.files as fs\nfn run() {{\n    path :: \"input.txt\"\n    text :: fs.read(~path)\n}}", rule: "readonly-copy", present: true},
        PolicyShapeCase{path: "Examples/features/io/reintroduced.jet", source: "use core.files as fs\nfn run() {{\n    path :: \"input.txt\"\n    text :: fs.read(path) ?? return Err(\"read\")\n}}", rule: "error-identity", present: true},
        PolicyShapeCase{path: "Examples/features/concurrency/reintroduced.jet", source: "fn run() {{\n    task.group g {{\n        task.race {{1, 2}}\n    }}\n}}", rule: "task-one-child", present: true},
        PolicyShapeCase{path: "Examples/features/concurrency/reintroduced.jet", source: "fn run() {{\n    task.group g {{\n        task.any {{1, 2}}\n    }}\n}}", rule: "task-one-child", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/reintroduced.jet", source: "fn run() {{\n    line_number := 0\n    loop item in items {{\n        line_number += 1\n        seen :: line_number\n    }}\n}}", rule: "indexed-sequence", present: true},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "fn run() {{\n    value :: Regex{{\"IMG\"}}\n}}", rule: "regex-capture-recipe", present: true},
    }
    manifest :: policy_manifest()
    loop example in cases {
        violations :: policy_evaluate_source(manifest, example.path, example.source)
        rendered := ""
        loop violation in violations {
            if violation.rule == example.rule { rendered = policy_violation(violation.file, violation.rule, violation.site)
                break
            }
        }
        assert(!rendered.is_empty(), "{example.path} did not reject {example.rule}")
        assert(rendered.contains("file={example.path}"), rendered)
        assert(rendered.contains("rule={example.rule}"), rendered)
        assert(rendered.contains("site="), rendered)
        assert(rendered.contains("why="), rendered)
        assert(rendered.contains("replacement="), rendered)
    }
    Ok(Unit{})
}
#Test("card_2375_rules_reject_each_reintroduced_ceremony") { policy_ast_test_reintroduced_ceremony() }
fn policy_ast_test_walk_shapes() PolicyError! {
    policy_check_shapes([PolicyShapeCase]{
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use core.files as fs\nfn run() {{\n    entries :: fs.walk(root)\n    loop entry in entries {{\n        if !entry.is_dir -> print(entry.path)\n    }}\n}}", rule: "walk-files-filter", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use core.files as fs\nfn walk() {{\n    entries :: fs.walk(root)\n}}\nfn filter(entry: Entry) {{\n    if !entry.is_dir -> print(entry.path)\n}}", rule: "walk-files-filter", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use core.files as fs\nfn run() {{\n    entries :: fs.walk(root)\n    loop entry in entries {{\n        if entry.is_dir -> print(entry.relative) else -> print(entry.path)\n    }}\n}}", rule: "walk-files-filter", present: false},
    })
    Ok(Unit{})
}
