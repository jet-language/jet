        PolicyShapeCase{path: "Examples/features/memory/reintroduced.jet", source: "fn run() {{ delay :: Duration.seconds(1.5) }}", rule: "duration-constant-safe", present: true},
        PolicyShapeCase{path: "Examples/features/memory/reintroduced.jet", source: "fn run(seconds: Float) {{ delay :: Duration.seconds(seconds) }}", rule: "duration-constant-safe", present: false},
        PolicyShapeCase{path: "Examples/features/text/reintroduced.jet", source: "fn run() {{ value :: Meter.from_float(source.raw() * 2) }}", rule: "unit-scalar-rewrap", present: true},
        PolicyShapeCase{path: "Examples/features/types/unit_family.jet", source: "fn subtotal(price: Usd, qty: Int) -> Usd {{ Usd.from_float(price.raw() * Float.from_int(qty)) }}", rule: "unit-scalar-rewrap", present: true},
        PolicyShapeCase{path: "Examples/features/text/reintroduced.jet", source: "fn run() {{ value :: Meter.from_float(source.raw() * calibrate(2.0)) }}", rule: "unit-scalar-rewrap", present: false},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "fn run() {{ print(\"{{value:Fixed(2)}}\".replace(\",\", \"\")) }}", rule: "plain-format-fact", present: true},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "fn run() {{ print(\"{{value:Grouped(2)}}\".replace(\",\", \"\")) }}", rule: "plain-format-fact", present: false},
        PolicyShapeCase{path: "Docs/site/generate.jet", source: "fn run() {{ files.create_dir(\"dist\") }}", rule: "dogfood-directory-setup", present: true},
        PolicyShapeCase{path: "Docs/site/generate.jet", source: "fn run() {{ files.create_dir_all(\"dist\") }}", rule: "dogfood-directory-setup", present: false},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "fn duplicate_equal(left: Dyn, right: Dyn) -> Bool {{ return true }}", rule: "dyn-domain-policy", present: true},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "fn javascript_truthy(value: Dyn) -> Bool {{ return true }}", rule: "dyn-domain-policy", present: false},
        PolicyShapeCase{path: "Jetpack/PackageModel/Source/Envelope/PathLaw.jet", source: "fn run() {{ value :: \"text\".replace(\"A\", \"a\").replace(\"B\", \"b\") }}", rule: "dogfood-ascii", present: false},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "fn pattern() {{ value :: Regex{{\"^x$\"}} }}\nfn run(value: String) {{\n    matched :: re.match(Regex{{\"x\"}}, value)\n    print(matched.group(1) ?? \"\")\n}}", rule: "regex-capture-recipe", present: true},
        PolicyShapeCase{path: "Docs/spec/guides/first-hour.md", source: "```jet\n#CLI\nstruct Args {{ name: String }}\n```\n```bash\njet build\n```", rule: "first-hour-doc-recipe", present: true},
    })
    lower :: policy_planted_ascii_ladder()
    violations :: policy_evaluate_source(policy_manifest(), "Jetpack/PackageModel/Source/Envelope/PathLaw.jet", "fn run() {{ value :: {lower} }}")
    assert(policy_has_rule(violations, "dogfood-ascii"))
    Ok(Unit{})
}
