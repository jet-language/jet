// corpus_policy.rs:106-134. The engine entry is the raw process protocol, not a typed CLI entry.
policy_ast_test_engine_entry_protocol: fn() PolicyError! {
    manifest: policy_manifest()
    found := false
    loop row in manifest.sources {
        if row.selector == "file:Jetpack/CLI/Source/Entry/Main.jet" {
            found = true
            assert_eq(row.role, "raw-protocol")
            assert_eq(row.profile, "protocol")
            assert_eq(row.decision, "D-JPK-DISPATCH1=B")
        }
    }
    assert(found, "engine protocol source is inventoried")
    source: policy_ast_files.read("Jetpack/CLI/Source/Entry/Main.jet") ?? panic("read the engine entry: {err}")
    program: policy_parse_program("Jetpack/CLI/Source/Entry/Main.jet", source)
    assert(!policy_has_typed_cli_entry(program), "the engine entry must not grow a typed CLI entry")
    symbols: [String]{"cli_jetpack_main", "ENGINE_PROTOCOL_FLAG", "COMPILER_VERSION", "EXTENSION_HOST_SUBCOMMAND", "BUILD_PLUGIN_HOST_SUBCOMMAND", "cli_run"}
    loop symbol in symbols {
        assert(source.contains(symbol), "engine protocol lost {symbol}")
    }
    Ok()
}
#Test("jetpack_engine_entry_is_the_ratified_raw_process_protocol") {
    guards_enter_root()
    policy_ast_test_engine_entry_protocol() ?? panic("{err.message}")
}
policy_ast_test_cli_recipe_inventory: fn() PolicyError! {
    manifest: policy_manifest()
    policy_check_cli_recipe_inventory(manifest, ".")
    typed_selectors: [String]{"file:Tools/adoption/fixtures/clean-project/run.jet", "file:Examples/Basics/FirstHour.jet", "file:Examples/Basics/Onboarding/run.jet", "file:Docs/spec/guides/first-hour.md", "root:Tools/gauntlet/entries", "root:tests/agent_workloads/adapters", "root:tests/compiled_workloads/adapters/jet"}
    loop selector in typed_selectors {
        found := false
        loop row in manifest.sources {
            if row.selector == selector { found = true
                assert(row.profile == "typed-cli" || row.profile == "typed-cli-doc", "canonical CLI source is not typed: {selector}")
            }
        }
        assert(found, "missing CLI recipe source row: {selector}")
    }
    expert_selectors: [String]{"file:Examples/Systems/CLI/ArgsSpec.jet", "file:Examples/Systems/CLI/ArgsAudit.jet", "file:Examples/Systems/CLI/CLIArgs.jet", "file:Examples/Systems/Files/Watcher.jet", "file:Tools/gauntlet/entries/taskfile-cli/jet/run.jet"}
    loop selector in expert_selectors {
        found := false
        expected: if selector.contains("ArgsSpec.jet") || selector.contains("ArgsAudit.jet") -> "builder-cli" else -> "raw-cli"
        loop row in manifest.sources {
            if row.selector == selector { found = true
                assert(row.profile == expected, "CLI boundary drifted: {selector}")
            }
        }
        assert(found, "missing CLI recipe source row: {selector}")
    }
    starter_selectors: [String]{"producer:Compiler/JetCli/Source/Cli/Host.jet#jet_cli_new_run_source.native", "producer:Jetpack/PackageModel/Source/Manifest/Convert.jet#pkg_new_template"}
    loop selector in starter_selectors {
        found := false
        loop producer in manifest.producers { if producer.selector == selector -> found = true }
        assert(found, "missing CLI starter producer row: {selector}")
    }
    Ok()
}
#Test("cli_recipe_inventory_is_manifest_owned_and_ast_checked") {
    guards_enter_root()
    policy_ast_test_cli_recipe_inventory() ?? panic("{err.message}")
}

// corelib_parts/system.rs:1027-1041. Use the compiler's built module registry,
// not Core/ directory names: unregistered files are not necessarily modules.
policy_ast_test_core_reference: fn() {
    docs: policy_ast_files.read("Docs/spec/reference/core-library.md") ?? panic("core library reference must exist")
    missing := [String]{}
    loop module_entry in CORE_MODULE_EXPORTS {
        if module_entry.module_name == "core" -> next
        if !docs.contains("`{module_entry.module_name}`") -> missing.push(module_entry.module_name)
    }
    assert(missing.is_empty(), "Docs/spec/reference/core-library.md must list every built Core module from KNOWN_CORE_MODULES: {missing}")
}
#Test("core_reference_lists_every_built_core_module") {
    guards_enter_root()
    policy_ast_test_core_reference()
}

policy_ast_test_unicode_shell_words: fn() {
    nel: String.from_bytes([U8]{194, 133}) ?? panic("NEL UTF-8")
    nbsp: String.from_bytes([U8]{194, 160}) ?? panic("NBSP UTF-8")
    emspace: String.from_bytes([U8]{226, 128, 131}) ?? panic("EM SPACE UTF-8")
    assert_eq(policy_split_whitespace("jet{nel}run{nbsp}file"), [String]{"jet", "run", "file"})
    assert(policy_has_jet_run_command("```bash\njet{emspace}run example.jet\n```"))
    assert(!policy_has_jet_run_command("```bash\n# jet run\n```"))
    assert(!policy_has_jet_run_command("```bash\njet # run\n```"))
}
#Test("corpus document shell words use Rust Unicode whitespace") {
    guards_enter_root()
    policy_ast_test_unicode_shell_words()
}

policy_planted_ascii_ladder: fn() -> String {
    lower := "\"text\""
    loop index in 0..<26 {
        from: String.from_bytes([U8]{U8.from_int(65 + index) ?? panic("ASCII uppercase byte")}) ?? panic("ASCII")
        to: String.from_bytes([U8]{U8.from_int(97 + index) ?? panic("ASCII lowercase byte")}) ?? panic("ASCII")
        lower += ".replace(\"{from}\", \"{to}\")"
    }
    lower
}

PolicyPlantedPair: struct { rule: String, kind: String, rejected: String, clean: String }
policy_ast_test_planted_rule_pairs: fn() PolicyError! {
    ladder: policy_planted_ascii_ladder()
    pairs: [PolicyPlantedPair]{
        PolicyPlantedPair{rule: "raw-cli-fixed-shape", kind: "call:process.args", rejected: "run: fn() {{ process.args() }}", clean: "run: fn(args: Args) {{ print(args) }}"},
        PolicyPlantedPair{rule: "duration-constant-safe", kind: "call:Duration.constructor", rejected: "run: fn() {{ Duration.hours(2) }}", clean: "run: fn(hours: Int) {{ Duration.hours(hours) }}"},
        PolicyPlantedPair{rule: "unit-scalar-rewrap", kind: "call:unit-rewrap", rejected: "run: fn() {{ Meter.from_float(value.raw() * 2) }}", clean: "run: fn() {{ value * 2 }}"},
        PolicyPlantedPair{rule: "readonly-copy", kind: "call:readonly-copy", rejected: "use fs: core.files\nrun: fn() {{ fs.read(path.copy()) }}", clean: "use fs: core.files\nrun: fn() {{ fs.read(path) }}"},
        PolicyPlantedPair{rule: "error-identity", kind: "expr:error-propagation", rejected: "use fs: core.files\nrun: fn() {{ fs.read(path) ?? return Err(\"read\") }}", clean: "use fs: core.files\nrun: fn() {{ fs.read(path) }}"},
        PolicyPlantedPair{rule: "http-wrapper-json", kind: "call:http-wrapper", rejected: "run: fn(req: HTTPRequest) {{ req.body(Json) }}", clean: "run: fn(req: HTTPRequest) {{ req.json(Json) }}"},
        PolicyPlantedPair{rule: "http-message-text", kind: "call:response.text", rejected: "run: fn() {{ response.body().text(100) }}", clean: "run: fn() {{ response.text() }}"},
        PolicyPlantedPair{rule: "http-typed-json", kind: "call:request.body", rejected: "run: fn(req: HTTPRequest) {{ req.body(Json) }}", clean: "run: fn(req: HTTPRequest) {{ req.json(Json) }}"},
        PolicyPlantedPair{rule: "delimited-reader-config", kind: "call:delimited-split", rejected: "run: fn() {{ input.split(\"\\t\") }}", clean: "run: fn() {{ input.split(\"|\") }}"},
        PolicyPlantedPair{rule: "plain-format-fact", kind: "call:Fixed.replace", rejected: "run: fn() {{ \"{{value:Fixed(2)}}\".replace(\",\", \"\") }}", clean: "run: fn() {{ \"{{value:Fixed(2)}}\" }}"},
        PolicyPlantedPair{rule: "dogfood-path-containment", kind: "call:path.starts_with", rejected: "run: fn() {{ candidate.starts_with(\"{{root}}/\") }}", clean: "use paths: core.files.path\nrun: fn() {{ paths.is_relative_to(paths.of(candidate), paths.of(root)) }}"},
        PolicyPlantedPair{rule: "dogfood-json", kind: "literal:json-wire", rejected: "run: fn() {{ \"{{{{\\\"key\\\": {{value}}}}}}\" }}", clean: "run: fn() {{ json.to_string(value) }}"},
        PolicyPlantedPair{rule: "dogfood-url-query", kind: "call:url.query.split", rejected: "run: fn() {{ query.split(\"&\") }}", clean: "run: fn() {{ url.query() }}"},
        PolicyPlantedPair{rule: "dogfood-list-equality", kind: "fn:same_strings", rejected: "run: fn() {{ same_strings(left, right) }}", clean: "run: fn() {{ left == right }}"},
        PolicyPlantedPair{rule: "dogfood-directory-setup", kind: "call:fs.create_dir", rejected: "use files: core.files\nrun: fn() {{ files.create_dir(\"dir\") }}", clean: "use files: core.files\nrun: fn() {{ files.create_dir_all(\"dir\") }}"},
        PolicyPlantedPair{rule: "crypto-naming-fact", kind: "call:crypto.sha256_bytes", rejected: "use crypto: core.crypto\nrun: fn() {{ crypto.sha256_bytes(bytes) }}", clean: "use crypto: core.crypto\nrun: fn() {{ crypto.sha256(bytes).hex() }}"},
        PolicyPlantedPair{rule: "raw-cli-process-boundary", kind: "call:process.args", rejected: "run: fn() {{\n    first: process.args()\n    second: process.args()\n}}", clean: "run: fn() {{ process.args() }}"},
        PolicyPlantedPair{rule: "entry-explicit", kind: "stmt:top-level", rejected: "print(\"hello\")", clean: "run: fn() {{ print(\"hello\") }}"},
        PolicyPlantedPair{rule: "codable-structural", kind: "type:Record", rejected: "#Codable\nRecord: struct {{ value: Int }}", clean: "Record: struct {{ value: Int }}"},
        PolicyPlantedPair{rule: "effect-row-inference", kind: "fn:run", rejected: "run: fn() -[IO]> {{ print(\"hello\") }}", clean: "run: fn() {{ print(\"hello\") }}"},
        PolicyPlantedPair{rule: "task-one-child", kind: "stmt:task.group", rejected: "run: fn() {{ task.group g {{ task.race {{1, 2}} }} }}", clean: "run: fn() {{ task.race {{1, 2}} }}"},
        PolicyPlantedPair{rule: "indexed-sequence", kind: "loop:manual-counter", rejected: "run: fn() {{\n    count := 0\n    loop item in items {{\n        count += 1\n        print(count)\n    }}\n}}", clean: "run: fn() {{ loop (index, item) in items -> print(index) }}"},
        PolicyPlantedPair{rule: "dyn-domain-policy", kind: "fn:duplicate", rejected: "duplicate: fn(left: Dyn, right: Dyn) -> Bool {{ true }}", clean: "duplicate: fn(left: Dyn, right: Dyn) -> Bool {{ left.equal_unordered(right) }}"},
        PolicyPlantedPair{rule: "walk-files-filter", kind: "call:fs.walk", rejected: "use fs: core.files\nrun: fn() {{ loop entry in fs.walk(root) {{ if !entry.is_dir -> print(entry.path) }} }}", clean: "use fs: core.files\nrun: fn() {{ loop entry in fs.walk_files(root) -> print(entry.path) }}"},
        PolicyPlantedPair{rule: "regex-capture-recipe", kind: "recipe:regex-capture", rejected: "run: fn() {{ Regex{{\"x\"}} }}", clean: "run: fn() {{\n    pattern: Regex{{\"^x$\"}}\n    matched: re.match(pattern, value)\n    print(matched.group(1) ?? \"\")\n}}"},
        PolicyPlantedPair{rule: "dogfood-ascii", kind: "call:String.replace", rejected: "run: fn() {{ {ladder} }}", clean: "run: fn() {{ \"text\".to_ascii_lower() }}"},
        PolicyPlantedPair{rule: "first-hour-doc-recipe", kind: "literal:jet-build", rejected: "run: fn() {{ print(\"jet build example.jet\") }}", clean: "run: fn() {{ print(\"jet run example.jet\") }}"},
        PolicyPlantedPair{rule: "http-unused-request", kind: "param:req", rejected: "handle: fn(req: HTTPRequest) -> HTTPResponse {{ response }}", clean: "handle: fn(req: HTTPRequest) -> HTTPResponse {{ req.response() }}"},
    }
    loop pair in pairs {
        // A closed synthetic manifest makes one rule active, independently of
        // real corpus exceptions or scope changes. Checked-manifest tests above
        // still require every original source/provenance/classification.
        path: if pair.rule == "first-hour-doc-recipe" -> "Examples/Types/TypedLiteralForms.jet" else -> "planted/{pair.rule}.jet"
        manifest := PolicyManifest{sources: [PolicySourceRow]{PolicySourceRow{selector: "file:{path}", role: "canonical-teaching", profile: "typed-cli", decision: "planted", proof: "planted", owner: "corpus-policy", reason: "planted AST pair"}}, scopes: [corpus_manifest.PolicyScopeRow]{corpus_manifest.PolicyScopeRow{rule: pair.rule, selector: "file:{path}", reason: "planted AST pair"}}, producers: [corpus_manifest.PolicyProducerRow]{}, artifacts: [corpus_manifest.PolicyArtifactRow]{}, findings: [corpus_manifest.PolicyFindingRow]{}, exceptions: [corpus_manifest.PolicyExceptionRow]{}}
        bad: policy_evaluate_source(manifest, path, pair.rejected)
        assert(bad.len() == 1, "{pair.rule}: exactly one planted violation")
        assert_eq(bad[0].file, path)
        assert_eq(bad[0].rule, pair.rule)
        assert(bad[0].site.starts_with("{pair.kind}@"), "stable semantic site: {bad[0].site}")
        assert_eq(policy_occurrence_messages(bad), policy_violation(path, pair.rule, bad[0].site))
        good: policy_evaluate_source(manifest, path, pair.clean)
        assert(good.len() == 0, "{pair.rule}: clean AST shape")
    }
    Ok()
}
#Test("corpus executable AST rules planted violation and clean pairs") {
    guards_enter_root()
    policy_ast_test_planted_rule_pairs() ?? panic("{err.message}")
}

// D-ENTRY-SCRIPT1=C: every loose top-level statement in a scoped source is one
// `entry-explicit` occurrence; explicit `run: fn` and declaration-only files pass.
policy_ast_test_explicit_entry: fn() PolicyError! {
    manifest: policy_manifest()
    // The Rust original also named Examples/learn/entry_law.jet; Examples/learn left the corpus with `jet learn` (09473f1db5).
    paths: [String]{"Examples/Types/entry_law.jet", "tests/agent_workloads/llm_digest/first_program.jet"}
    accepted: [String]{"run: fn() {{ print(\"hello\") }}", "VALUE: 1\nhelper: fn() -> Int {{ VALUE }}\nrun: fn() {{ print(helper()) }}", "helper: fn() -> Int {{ 1 }}"}
    rejected: [String]{"print(\"hello\")", "print(\"before\")\nrun: fn() {{ print(\"inside\") }}\nprint(\"after\")"}
    loop path in paths {
        loop source in accepted {
            violations: policy_evaluate_source(manifest, path, source)
            assert(!policy_has_rule(violations, "entry-explicit"), "explicit execution and declaration-only files must be accepted: {path}: {policy_occurrence_messages(violations)}")
        }
        loop (index, source) in rejected {
            violations: policy_evaluate_source(manifest, path, source)
            entries := 0
            loop violation in violations {
                if violation.rule != "entry-explicit" -> next
                entries += 1
                assert(violation.site.starts_with("stmt:top-level@"), "loose execution site: {violation.site}")
            }
            assert(entries == index + 1, "loose execution: {path}: expected {index + 1}, found {entries}")
        }
    }
    loop exception in manifest.exceptions -> assert(exception.rule != "entry-explicit", "entry-explicit has no occurrence exceptions")
    Ok()
}
#Test("explicit_entry_rule_matches_ordinary_file_execution") {
    guards_enter_root()
    policy_ast_test_explicit_entry() ?? panic("{err.message}")
}
// corpus_policy.rs `inventory_is_manifest_scoped`; it lives with the package
// parser because inventory needs the declared-config exclusion.
policy_ast_test_manifest_scoped_inventory: fn() PolicyError! {
    inventory: policy_ast_inventory(policy_manifest(), ".")
    first_hour := false
    scratch := false
    loop entry in inventory.files {
        if entry.path == "Docs/spec/guides/first-hour.md" -> first_hour = true
        if entry.path == "scratch-parser-call.jet" -> scratch = true
    }
    assert(first_hour, "exact documentation source is inventoried")
    assert(inventory.provenance.len() == inventory.artifacts.len(), "every artifact must retain producer provenance")
    assert(!scratch, "sources outside manifest roots are excluded")
    Ok()
}
#Test("inventory_is_manifest_scoped") {
    guards_enter_root()
    policy_ast_test_manifest_scoped_inventory() ?? panic("{err.message}")
}
// Rust `is_declared_package_config_dir`: only a `config/` its sibling
// `package.jet` declares under `configs:` leaves the corpus.
policy_ast_test_declared_config_exclusion: fn() PolicyError! {
    manifest: policy_manifest()
    declared: "Examples/Metaprogramming/BuildTime/CompilerAPIPackage/config"
    discovery: policy_discover_manifest_files(manifest, ".")
    assert(discovery.config_candidates.contains(declared), "the package config directory is a discovery candidate")
    assert(policy_declared_config(".", declared), "compiler_api_package declares configs: [\"config/release.jet\"]")
    assert(!policy_declared_config(".", "Examples/Tooling/missing_package/config"), "a config directory without a parsable package.jet stays in the corpus")
    inventory: policy_ast_inventory(manifest, ".")
    loop entry in inventory.files -> assert(!entry.path.starts_with("{declared}/"), "declared package config left in the corpus: {entry.path}")
    Ok()
}
#Test("declared_package_config_dirs_leave_the_corpus") {
    guards_enter_root()
    policy_ast_test_declared_config_exclusion() ?? panic("{err.message}")
}
