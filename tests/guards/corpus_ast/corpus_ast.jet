        PolicyShapeCase{path: "tests/agent_workloads/adapters/incident_report.jet", source: "run: fn() {{ rows: input.split(\"\\t\") }}", rule: "delimited-reader-config", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/incident_report.jet", source: "run: fn() {{ rows: input.split(\"|\") }}", rule: "delimited-reader-config", present: false},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn(req: HTTPRequest) {{ payload: req.body(Json) }}", rule: "http-wrapper-json", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn(req: HTTPRequest) {{ payload: req.body(Json) }}", rule: "http-typed-json", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn() {{ answer: response.body().text(100) }}", rule: "http-message-text", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn() {{ answer: response.text() }}", rule: "http-message-text", present: false},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn(req: HTTPRequest) {{ payload: req.json(Json) }}", rule: "http-wrapper-json", present: false},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "run: fn(req: HTTPRequest) {{ payload: req.json(Json) }}", rule: "http-typed-json", present: false},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "handle: fn(req: HTTPRequest) -> HTTPResponse {{ return response }}", rule: "http-unused-request", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/http_api.jet", source: "handle: fn(req: HTTPRequest) -> HTTPResponse {{ return req.response() }}", rule: "http-unused-request", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ allowed: candidate.starts_with(\"{{root}}/\") }}", rule: "dogfood-path-containment", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ inside: path == root || path.starts_with(\"{{root.removesuffix(\"/\")}}/\") }}", rule: "dogfood-path-containment", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ stored: path.starts_with(\"/nix/store/\") }}", rule: "dogfood-path-containment", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ allowed: candidate == root }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "use paths: core.files.path\nrun: fn() {{ allowed: paths.is_relative_to(paths.of(candidate), paths.of(root)) }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ secure: url.starts_with(\"https://\") || url.starts_with(\"file://\") }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ local: raw.starts_with(\"./\") || raw.starts_with(\"../\") }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ closing: opening.starts_with(\"</\") }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ named: rest.starts_with(\"{{name}}-\") || value.starts_with(\"{{prefix}}.\") || line.starts_with(\"{{key}} = \") }}", rule: "dogfood-path-containment", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ same: location.starts_with(\"https://\") && location.starts_with(\"{{origin}}/\") }}", rule: "dogfood-path-containment", present: false},
        // The Rust final still evaluated these at Jetpack/CLI/Source/Entry/Main.jet,
        // which D-JPK-DISPATCH1=B (ee56d70d95) made a raw-protocol source that no
        // semantic rule reaches; any root:Jetpack dogfood source carries the scope.
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ wire: \"{{{{\\\"key\\\": {{value}}}}}}\" }}", rule: "dogfood-json", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ wire: json.to_string(value) }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ row: \"{{{{\\\"name\\\":{{quote(name)}},\\\"size\\\":{{size}}}}}}\" }}", rule: "dogfood-json", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ field: \"  \\\"sha256\\\": {{quote(sha)}},\\n\" }}", rule: "dogfood-json", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ text: \"Provenance {{{{ source: {{source}}, lock: {{lock}} }}}}\" }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ out: \"#Import c.{{abi}}: module {{{{\\n    open: fn() -> Int = \\\"{{abi}}_open\\\"\\n}}}}\\n\" }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ message: \"write `{{name}}: module {{{{ members: find(\\\"./packages\\\") }}}}` in `{{file}}`\" }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ script: \"[ \\\"$code\\\" = 0 ] || {{{{ echo \\\"{{kind}}\\\"; }}}}\" }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Source/Ingest/TreeIngest.jet", source: "run: fn() {{ arg: \"arg{{index}} ? \\\"true\\\" : \\\"false\\\"\" }}", rule: "dogfood-json", present: false},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "run: fn() {{ fields: query.split(\"&\") }}", rule: "dogfood-url-query", present: true},
        PolicyShapeCase{path: "Tools/tower/run.jet", source: "run: fn() {{ fields: url.query() }}", rule: "dogfood-url-query", present: false},
        PolicyShapeCase{path: "Jetpack/CLI/Source/Realize/ProjectPlan.jet", source: "run: fn() {{ same_strings(left, right) }}", rule: "dogfood-list-equality", present: true},
        PolicyShapeCase{path: "Jetpack/CLI/Source/Realize/ProjectPlan.jet", source: "run: fn() {{ left == right }}", rule: "dogfood-list-equality", present: false},
    })
    Ok()
}
#Test("scoped_dogfood_and_workload_recipes_have_positive_and_negative_shapes") {
    guards_enter_root()
    policy_ast_test_dogfood_and_workload_shapes() ?? panic("{err.message}")
}
