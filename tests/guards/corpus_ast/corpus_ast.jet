    policy_ast_test_protocol_override() ?? panic("{err.message}")
}

PolicyShapeCase: struct { path: String, source: String, rule: String, present: Bool }
policy_check_shapes: fn(cases: [PolicyShapeCase]) PolicyError! {
    manifest: policy_manifest()
    loop example in cases {
        violations: policy_evaluate_source(manifest, example.path, example.source)
        assert(policy_has_rule(violations, example.rule) == example.present, "{example.path}: {example.rule}: {policy_occurrence_messages(violations)}")
    }
    Ok()
}
policy_ast_test_reintroduced_ceremony: fn() PolicyError! {
    cases: [PolicyShapeCase]{
        PolicyShapeCase{path: "Examples/Basics/Hello.jet", source: "print(\"hello\")", rule: "entry-explicit", present: true},
        PolicyShapeCase{path: "Docs/spec/guides/first-hour.md", source: "jet build Examples/Basics/FirstHour.jet", rule: "first-hour-doc-recipe", present: true},
        PolicyShapeCase{path: "Examples/Types/TypedLiteralForms.jet", source: "run: fn() {{ print(\"jet build Examples/Types/TypedLiteralForms.jet\") }}", rule: "first-hour-doc-recipe", present: true},
        PolicyShapeCase{path: "Examples/Data/reintroduced.jet", source: "#Codable\nSample: struct {{\n    value: Int\n}}\nrun: fn() {{}}", rule: "codable-structural", present: true},
        PolicyShapeCase{path: "Examples/Memory/reintroduced.jet", source: "run: fn() {{\n    delay: Duration.hours(2) ?? return Err(\"duration\")\n}}", rule: "duration-constant-safe", present: true},
        PolicyShapeCase{path: "Examples/Basics/reintroduced_effect.jet", source: "use fs: core.files\nrun: fn() -[FS, IO]> {{\n    path: \"input.txt\"\n    text: fs.read(path)\n    print(text)\n}}", rule: "effect-row-inference", present: true},
        PolicyShapeCase{path: "Examples/Concurrency/Parallel/ParallelScan.jet", source: "use fs: core.files\nrun: fn() {{\n    path: \"input.txt\"\n    text: fs.read(path.copy())\n}}", rule: "readonly-copy", present: true},
        PolicyShapeCase{path: "Examples/Systems/reintroduced.jet", source: "use fs: core.files\nrun: fn() {{\n    path: \"input.txt\"\n    text: fs.read(path) ?? return Err(\"read\")\n}}", rule: "error-identity", present: true},
        PolicyShapeCase{path: "Examples/Concurrency/reintroduced.jet", source: "run: fn() {{\n    task.group g {{\n        task.race {{1, 2}}\n    }}\n}}", rule: "task-one-child", present: true},
        PolicyShapeCase{path: "Examples/Concurrency/reintroduced.jet", source: "run: fn() {{\n    task.group g {{\n        task.any {{1, 2}}\n    }}\n}}", rule: "task-one-child", present: true},
        PolicyShapeCase{path: "tests/agent_workloads/adapters/reintroduced.jet", source: "run: fn() {{\n    line_number := 0\n    loop item in items {{\n        line_number += 1\n        seen: line_number\n    }}\n}}", rule: "indexed-sequence", present: true},
        PolicyShapeCase{path: "Tools/gauntlet/entries/bulkrename/jet/run.jet", source: "run: fn() {{\n    value: Regex{{\"IMG\"}}\n}}", rule: "regex-capture-recipe", present: true},
    }
    manifest: policy_manifest()
    loop example in cases {
        violations: policy_evaluate_source(manifest, example.path, example.source)
        rendered := ""
        loop violation in violations {
            if violation.rule == example.rule { rendered = policy_violation(violation.file, violation.rule, violation.site)
                break
            }
        }
        assert(!rendered.is_empty(), "{example.path} did not reject {example.rule}")
        assert(rendered.contains("file={example.path}"), rendered)
        assert(rendered.contains("rule={example.rule}"), rendered)
        assert(rendered.contains("site="), rendered)
        assert(rendered.contains("why="), rendered)
        assert(rendered.contains("replacement="), rendered)
    }
    Ok()
}
#Test("card_2375_rules_reject_each_reintroduced_ceremony") {
    guards_enter_root()
    policy_ast_test_reintroduced_ceremony() ?? panic("{err.message}")
}
policy_ast_test_walk_shapes: fn() PolicyError! {
    policy_check_shapes([PolicyShapeCase]{
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use fs: core.files\nrun: fn() {{\n    entries: fs.walk(root)\n    loop entry in entries {{\n        if !entry.is_dir -> print(entry.path)\n    }}\n}}", rule: "walk-files-filter", present: true},
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use fs: core.files\nwalk: fn() {{\n    entries: fs.walk(root)\n}}\nfilter: fn(entry: Entry) {{\n    if !entry.is_dir -> print(entry.path)\n}}", rule: "walk-files-filter", present: false},
        PolicyShapeCase{path: "Jetpack/Store/Tests/StoreIngest.jet", source: "use fs: core.files\nrun: fn() {{\n    entries: fs.walk(root)\n    loop entry in entries {{\n        if entry.is_dir -> print(entry.relative) else -> print(entry.path)\n    }}\n}}", rule: "walk-files-filter", present: false},
    })
    Ok()
}
#Test("walk_policy_distinguishes_file_only_filters_from_directory_tree_walks") {
    guards_enter_root()
    policy_ast_test_walk_shapes() ?? panic("{err.message}")
}
