        PolicyShapeCase{path: "Examples/Crypto/reintroduced.jet", source: "use crypto: core.crypto\nrun: fn() {{ crypto.sha256(\"abc\".bytes()).hex() }}", rule: "crypto-naming-fact", present: false},
        PolicyShapeCase{path: "Examples/Crypto/reintroduced.jet", source: "run: fn() {{ sha256_bytes(\"abc\".bytes()) }}", rule: "crypto-naming-fact", present: false},
    })
    Ok()
}
