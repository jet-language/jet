policy_ast_test_protocol_override: fn() PolicyError! {
    manifest: policy_manifest()
    producer: "producer:Jetpack/Integrations/Source/Foreign/Binders/Lua.jet#pkg_lua_render_jet"
    raw: policy_evaluate_generated(manifest, producer, "decode_response: fn(raw: String, code: Int) -> Dyn Err! {{ return Ok(json.parse(raw)) }}")
    assert(raw.is_empty(), "raw JSON override is distinct: {policy_occurrence_messages(raw)}")
    ordinary: policy_evaluate_generated(manifest, producer, "decode_response: fn(raw: String, code: Int) -> Dyn Err! {{\n    response: json.parse(raw)\n    ok: response.field(\"ok\")\n    return Ok(response)\n}}")
    assert(policy_has_rule(ordinary, "generated-protocol-override"))
    Ok()
}
