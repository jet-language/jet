policy_has_rule: fn(violations: [PolicyOccurrence], rule: String) -> Bool {
    loop violation in violations { if violation.rule == rule -> return true }
    false
}
policy_ast_test_semantic_shapes: fn() PolicyError! {
    manifest: policy_manifest()
    path: "Examples/Basics/FirstHour.jet"
    positive: policy_evaluate_source(manifest, path, "run: fn() {{ args: process.args() }}")
    assert(policy_has_rule(positive, "raw-cli-fixed-shape"))
    loop violation in positive -> assert_eq(violation.file, path)
    literal: policy_evaluate_source(manifest, path, "run: fn() {{ print(\"process.args()\") }}")
    assert(!policy_has_rule(literal, "raw-cli-fixed-shape"))
    Ok()
}
#Test("semantic_rules_use_ast_shapes_not_source_text") {
    guards_enter_root()
    policy_ast_test_semantic_shapes() ?? panic("{err.message}")
}
policy_ast_test_cli_boundaries: fn() PolicyError! {
    manifest: policy_manifest()
    path: "Examples/Basics/FirstHour.jet"
    repeated: policy_evaluate_source(manifest, path, "run: fn() {{\n    first: process.args()\n    second: process.args()\n}}")
    assert(policy_has_rule(repeated, "raw-cli-process-boundary"))
    single: policy_evaluate_source(manifest, path, "run: fn() {{ args: process.args() }}")
    assert(!policy_has_rule(single, "raw-cli-process-boundary"))
    Ok()
}
#Test("cli_boundary_rules_cover_repeated_process_reads") {
    guards_enter_root()
    policy_ast_test_cli_boundaries() ?? panic("{err.message}")
}
policy_ast_test_allow_source_reason: fn() PolicyError! {
    manifest: policy_manifest()
    error := ""
    if policy_evaluate_source(manifest, "Examples/Text/unreviewed_allow.jet", "run: fn() {{ #Allow(jet.UnitScalarRewrap) print(\"kept\") }}") == {
        .Err(failure) -> error = failure.message
        .Ok(_) -> panic("maintained guidance allowance must explain itself")
    }
    assert(error.contains("reason at its source site"), error)
    policy_evaluate_source(manifest, "Examples/Text/reviewed_allow.jet", "run: fn() {{ #Allow(jet.UnitScalarRewrap, \"the example intentionally shows explicit conversion\") print(\"kept\") }}")
    Ok()
}
#Test("maintained_guidance_allow_explains_itself_at_the_source_site") {
    guards_enter_root()
    policy_ast_test_allow_source_reason() ?? panic("{err.message}")
}
policy_ast_test_response_decoder: fn() PolicyError! {
    manifest: policy_manifest()
    violations: policy_evaluate_generated(manifest, "producer:Jetpack/Integrations/Source/Foreign/Binders/Lua.jet#pkg_lua_render_jet", "run: fn() {{}}")
    assert_eq(violations.len(), 1)
    assert_eq(violations[0].rule, "bindgen-one-decoder")
    assert(policy_occurrence_messages(violations).contains("replacement="))
    no_response: policy_evaluate_generated(manifest, "producer:Jetpack/PackageModel/Source/Foreign/C/HeaderBinder.jet#pkg_cbind_generate", "run: fn() {{}}")
    assert(no_response.is_empty())
    Ok()
}
#Test("generated_protocol_check_requires_one_decoder_for_response_protocols") {
    guards_enter_root()
    policy_ast_test_response_decoder() ?? panic("{err.message}")
}
policy_ast_test_binding_renderers: fn() PolicyError! {
    manifest: policy_manifest()
    count := 0
    loop producer in manifest.producers {
        if !producer.selector.contains("/Foreign/Binders/") || producer.protocol == "no-response-protocol" -> next
        count += 1
        violations: policy_evaluate_generated(manifest, producer.selector, "decode_response: fn(raw: String, code: Int) -> Dyn Err! {{ return Ok(Dyn.Null) }}")
        assert(violations.is_empty(), "{producer.selector} did not accept one shared response decoder: {policy_occurrence_messages(violations)}")
    }
    assert_eq(count, 7)
    Ok()
}
#Test("every_response_binding_renderer_uses_the_shared_decoder_policy") {
    guards_enter_root()
    policy_ast_test_binding_renderers() ?? panic("{err.message}")
}
