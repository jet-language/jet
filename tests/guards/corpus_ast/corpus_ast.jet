fn policy_ast_test_fixture_roles() PolicyError! {
    manifest :: policy_manifest()
    policy_check_fixture_inventory(manifest, ".")
    fixture :: policy_evaluate_source(manifest, "tests/ui/args_spec_bad_parse_arity.jet", "fn run() {{ process.argv() }}")
    assert(fixture.is_empty(), "negative fixtures are role-gated")
    builder :: policy_evaluate_source(manifest, "Jetpack/CLI/Source/Entry/Main.jet", "fn run() {{\n    args.spec()\n    process.argv()\n}}")
    loop violation in builder -> assert(violation.rule != "raw-cli-fixed-shape" && violation.rule != "raw-cli-builder-shape")
    Ok(Unit{})
}
#Test("fixture_roles_and_approved_builder_boundary_are_explicit") { policy_ast_test_fixture_roles() }
fn policy_ast_test_cli_recipe_inventory() PolicyError! {
    manifest :: policy_manifest()
    policy_check_cli_recipe_inventory(manifest, ".")
    typed_selectors :: [String]{"file:Tools/adoption/fixtures/clean-project/run.jet", "file:Examples/features/basics/first_hour.jet", "file:Examples/features/basics/onboarding/run.jet", "file:Docs/spec/guides/first-hour.md", "root:Tools/gauntlet/entries", "root:tests/agent_workloads/adapters", "root:tests/compiled_workloads/adapters/jet", "file:Jetpack/CLI/Source/Entry/Main.jet"}
    loop selector in typed_selectors {
        found := false
        loop row in manifest.sources {
            if row.selector == selector { found = true
                assert(row.profile == "typed-cli" || row.profile == "typed-cli-doc", "canonical CLI source is not typed: {selector}")
            }
        }
        assert(found, "missing CLI recipe source row: {selector}")
    }
    expert_selectors :: [String]{"file:Examples/features/io/args_spec.jet", "file:Examples/features/io/args_audit.jet", "file:Examples/features/io/cli_args.jet", "file:Examples/features/io/watcher.jet", "file:Tools/gauntlet/entries/taskfile-cli/jet/run.jet"}
    loop selector in expert_selectors {
        found := false
        expected :: if selector.contains("args_spec.jet") || selector.contains("args_audit.jet") -> "builder-cli" else -> "raw-cli"
        loop row in manifest.sources {
            if row.selector == selector { found = true
                assert_eq(row.profile, expected, "CLI boundary drifted: {selector}")
            }
        }
        assert(found, "missing CLI recipe source row: {selector}")
    }
    starter_selectors :: [String]{"producer:Source/CmdCompile.rs#run_new.native_run_src", "producer:crates/jet-pkg-model/src/Package/Convert.rs#new_template"}
    loop selector in starter_selectors {
        found := false
        loop producer in manifest.producers { if producer.selector == selector -> found = true }
        assert(found, "missing CLI starter producer row: {selector}")
    }
    Ok(Unit{})
}
#Test("cli_recipe_inventory_is_manifest_owned_and_ast_checked") { policy_ast_test_cli_recipe_inventory() }

// corelib_parts/system.rs:1027-1041. Use the compiler's built module registry,
// not Core/ directory names: unregistered files are not necessarily modules.
fn policy_ast_test_core_reference() {
    docs :: policy_ast_files.read("Docs/spec/reference/core-library.md") ?? panic("core library reference must exist")
    missing := [String]{}
    loop module_entry in CORE_MODULE_EXPORTS {
        if module_entry.module_name == "core" -> next
        if !docs.contains("`{module_entry.module_name}`") -> &missing.push(module_entry.module_name)
    }
    assert(missing.is_empty(), "Docs/spec/reference/core-library.md must list every built Core module from KNOWN_CORE_MODULES: {missing}")
}
#Test("core_reference_lists_every_built_core_module") { policy_ast_test_core_reference() }

fn policy_ast_test_unicode_shell_words() {
    nel :: String.from_bytes([U8]{194, 133}) ?? panic("NEL UTF-8")
    nbsp :: String.from_bytes([U8]{194, 160}) ?? panic("NBSP UTF-8")
    emspace :: String.from_bytes([U8]{226, 128, 131}) ?? panic("EM SPACE UTF-8")
    assert_eq(policy_split_whitespace("jet{nel}run{nbsp}file"), [String]{"jet", "run", "file"})
    assert(policy_has_jet_run_command("```bash\njet{emspace}run example.jet\n```"))
    assert(!policy_has_jet_run_command("```bash\n# jet run\n```"))
    assert(!policy_has_jet_run_command("```bash\njet # run\n```"))
}
#Test("corpus document shell words use Rust Unicode whitespace") { policy_ast_test_unicode_shell_words() }

fn policy_planted_ascii_ladder() -> String {
    lower := "\"text\""
    loop index in 0..<26 {
        from :: String.from_bytes([U8]{U8.from_int(65 + index) ?? panic("ASCII uppercase byte")}) ?? panic("ASCII")
        to :: String.from_bytes([U8]{U8.from_int(97 + index) ?? panic("ASCII lowercase byte")}) ?? panic("ASCII")
        lower += ".replace(\"{from}\", \"{to}\")"
    }
    lower
}

struct PolicyPlantedPair { rule: String, kind: String, rejected: String, clean: String }
fn policy_ast_test_planted_rule_pairs() PolicyError! {
    ladder :: policy_planted_ascii_ladder()
    pairs :: [PolicyPlantedPair]{
        PolicyPlantedPair{rule: "raw-cli-fixed-shape", kind: "call:process.argv", rejected: "fn run() {{ process.argv() }}", clean: "fn run(args: Args) {{ print(args) }}"},
        PolicyPlantedPair{rule: "raw-cli-builder-shape", kind: "call:process.argv.skip", rejected: "fn run() {{ process.argv().skip(1) }}", clean: "fn run() {{ process.args() }}"},
        PolicyPlantedPair{rule: "duration-constant-safe", kind: "call:Duration.constructor", rejected: "fn run() {{ Duration.hours(2) }}", clean: "fn run(hours: Int) {{ Duration.hours(hours) }}"},
        PolicyPlantedPair{rule: "unit-scalar-rewrap", kind: "call:unit-rewrap", rejected: "fn run() {{ Meter.from_float(value.raw() * 2) }}", clean: "fn run() {{ value * 2 }}"},
        PolicyPlantedPair{rule: "readonly-copy", kind: "call:readonly-copy", rejected: "use core.files as fs\nfn run() {{ fs.read(~path) }}", clean: "use core.files as fs\nfn run() {{ fs.read(path) }}"},
        PolicyPlantedPair{rule: "error-identity", kind: "expr:error-propagation", rejected: "use core.files as fs\nfn run() {{ fs.read(path) ?? return Err(\"read\") }}", clean: "use core.files as fs\nfn run() {{ fs.read(path) }}"},
        PolicyPlantedPair{rule: "http-wrapper-json", kind: "call:http-wrapper", rejected: "fn run(req: HTTPRequest) {{ req.body(Json) }}", clean: "fn run(req: HTTPRequest) {{ req.json(Json) }}"},
        PolicyPlantedPair{rule: "http-message-text", kind: "call:response.text", rejected: "fn run() {{ response.body().text(100) }}", clean: "fn run() {{ response.text() }}"},
        PolicyPlantedPair{rule: "http-typed-json", kind: "call:request.body", rejected: "fn run(req: HTTPRequest) {{ req.body(Json) }}", clean: "fn run(req: HTTPRequest) {{ req.json(Json) }}"},
        PolicyPlantedPair{rule: "delimited-reader-config", kind: "call:delimited-split", rejected: "fn run() {{ input.split(\"\\t\") }}", clean: "fn run() {{ input.split(\"|\") }}"},
        PolicyPlantedPair{rule: "plain-format-fact", kind: "call:Fixed.replace", rejected: "fn run() {{ \"{{value:Fixed(2)}}\".replace(\",\", \"\") }}", clean: "fn run() {{ \"{{value:Fixed(2)}}\" }}"},
        PolicyPlantedPair{rule: "dogfood-path-containment", kind: "call:path.starts_with", rejected: "fn run() {{ candidate.starts_with(\"root/\") }}", clean: "fn run() {{ candidate.is_within(root) }}"},
        PolicyPlantedPair{rule: "dogfood-json", kind: "literal:json-wire", rejected: "fn run() {{ \"{{{{\\\"key\\\": {{value}}}}}}\" }}", clean: "fn run() {{ json.to_string(value) }}"},
        PolicyPlantedPair{rule: "dogfood-url-query", kind: "call:url.query.split", rejected: "fn run() {{ query.split(\"&\") }}", clean: "fn run() {{ url.query() }}"},
        PolicyPlantedPair{rule: "dogfood-list-equality", kind: "fn:same_strings", rejected: "fn run() {{ same_strings(left, right) }}", clean: "fn run() {{ left == right }}"},
        PolicyPlantedPair{rule: "dogfood-directory-setup", kind: "call:fs.create_dir", rejected: "use core.files as files\nfn run() {{ files.create_dir(\"dir\") }}", clean: "use core.files as files\nfn run() {{ files.create_dir_all(\"dir\") }}"},
        PolicyPlantedPair{rule: "crypto-naming-fact", kind: "call:crypto.sha256_bytes", rejected: "use core.crypto as crypto\nfn run() {{ crypto.sha256_bytes(bytes) }}", clean: "use core.crypto as crypto\nfn run() {{ crypto.sha256(bytes).hex() }}"},
        PolicyPlantedPair{rule: "raw-cli-process-boundary", kind: "call:process.argv", rejected: "fn run() {{\n    first :: process.argv()\n    second :: process.argv()\n}}", clean: "fn run() {{ process.argv() }}"},
        PolicyPlantedPair{rule: "entry-implicit", kind: "fn:run", rejected: "fn run() {{ print(\"hello\") }}", clean: "print(\"hello\")"},
        PolicyPlantedPair{rule: "codable-structural", kind: "type:Record", rejected: "#Codable\nstruct Record {{ value: Int }}", clean: "struct Record {{ value: Int }}"},
        PolicyPlantedPair{rule: "effect-row-inference", kind: "fn:run", rejected: "fn run() -[IO]> {{ print(\"hello\") }}", clean: "fn run() {{ print(\"hello\") }}"},
        PolicyPlantedPair{rule: "task-one-child", kind: "stmt:task.group", rejected: "fn run() {{ task.group g {{ task.race {{1, 2}} }} }}", clean: "fn run() {{ task.race {{1, 2}} }}"},
        PolicyPlantedPair{rule: "indexed-sequence", kind: "loop:manual-counter", rejected: "fn run() {{\n    count := 0\n    loop item in items {{\n        count += 1\n        print(count)\n    }}\n}}", clean: "fn run() {{ loop (index, item) in items -> print(index) }}"},
        PolicyPlantedPair{rule: "dyn-domain-policy", kind: "fn:duplicate", rejected: "fn duplicate(left: Dyn, right: Dyn) -> Bool {{ true }}", clean: "fn duplicate(left: Dyn, right: Dyn) -> Bool {{ left.equal_unordered(right) }}"},
        PolicyPlantedPair{rule: "walk-files-filter", kind: "call:fs.walk", rejected: "use core.files as fs\nfn run() {{ loop entry in fs.walk(root) {{ if !entry.is_dir -> print(entry.path) }} }}", clean: "use core.files as fs\nfn run() {{ loop entry in fs.walk_files(root) -> print(entry.path) }}"},
        PolicyPlantedPair{rule: "regex-capture-recipe", kind: "recipe:regex-capture", rejected: "fn run() {{ Regex{{\"x\"}} }}", clean: "fn run() {{\n    pattern :: Regex{{\"^x$\"}}\n    matched :: re.match(pattern, value)\n    print(matched.group(1) ?? \"\")\n}}"},
        PolicyPlantedPair{rule: "dogfood-ascii", kind: "call:String.replace", rejected: "fn run() {{ {ladder} }}", clean: "fn run() {{ \"text\".to_ascii_lower() }}"},
        PolicyPlantedPair{rule: "first-hour-doc-recipe", kind: "literal:jet-build", rejected: "fn run() {{ print(\"jet build example.jet\") }}", clean: "fn run() {{ print(\"jet run example.jet\") }}"},
        PolicyPlantedPair{rule: "http-unused-request", kind: "param:req", rejected: "fn handle(req: HTTPRequest) -> HTTPResponse {{ response }}", clean: "fn handle(req: HTTPRequest) -> HTTPResponse {{ req.response() }}"},
    }
    loop pair in pairs {
        // A closed synthetic manifest makes one rule active, independently of
        // real corpus exceptions or scope changes. Checked-manifest tests above
        // still require every original source/provenance/classification.
        path :: if pair.rule == "first-hour-doc-recipe" -> "Examples/features/types/typed_literal_forms.jet" else -> "planted/{pair.rule}.jet"
        manifest := PolicyManifest{sources: [PolicySourceRow]{PolicySourceRow{selector: "file:{path}", role: "canonical-teaching", profile: "typed-cli", decision: "planted", proof: "planted", owner: "corpus-policy", reason: "planted AST pair"}}, scopes: [corpus_manifest.PolicyScopeRow]{corpus_manifest.PolicyScopeRow{rule: pair.rule, selector: "file:{path}", reason: "planted AST pair"}}, producers: [corpus_manifest.PolicyProducerRow]{}, artifacts: [corpus_manifest.PolicyArtifactRow]{}, findings: [corpus_manifest.PolicyFindingRow]{}, exceptions: [corpus_manifest.PolicyExceptionRow]{}}
        bad :: policy_evaluate_source(manifest, path, pair.rejected)
        assert_eq(bad.len(), 1, "{pair.rule}: exactly one planted violation")
        assert_eq(bad[0].file, path)
        assert_eq(bad[0].rule, pair.rule)
        assert(bad[0].site.starts_with("{pair.kind}@"), "stable semantic site: {bad[0].site}")
        assert_eq(policy_occurrence_messages(bad), policy_violation(path, pair.rule, bad[0].site))
        good :: policy_evaluate_source(manifest, path, pair.clean)
        assert_eq(good, [PolicyOccurrence]{}, "{pair.rule}: clean AST shape")
    }
    Ok(Unit{})
}
#Test("corpus executable AST rules planted violation and clean pairs") { policy_ast_test_planted_rule_pairs() }
