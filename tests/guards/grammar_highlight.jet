// Ports of the highlight-registry gates from the deleted tests/grammar.rs
// (#6096 grammar-highlight). The Rust gates read `jet::Syntax`; the Jet
// registry is the Data/Syntax text that `jet self devtools grammars` renders
// from, so these read the same rows the generator reads.
use gh_files: core.files

GH_SYNTAX_DIR: "Compiler/JetFoundation/Data/Syntax"
GH_VSCODE: "Tools/editors/vscode/syntaxes/jet.tmLanguage.json"
GH_TREE_SITTER: "Tools/editors/tree-sitter/grammar.js"
GH_ZED: "Tools/editors/zed/languages/jet/highlights.scm"
GH_NODE_TYPES: "Tools/editors/tree-sitter/src/node-types.json"

GhToken: struct {
    text: String
    class: String
}

gh_read: fn(path: String) -> String { gh_files.read(path) ?? panic("read {path}: {err}") }

gh_slice: fn(text: String, start: Int, end: Int) -> String {
    raw: text.bytes()
    if start >= end -> return ""
    String.from_bytes(raw[start..(end - 1)]) ?? panic("grammar slice must end on UTF-8 boundaries")
}

// The byte offset of the first `needle` in `text`, for gh_slice. `String.index`
// counts Unicode scalars, so its offset only matches gh_slice while every byte
// before the needle is ASCII.
gh_index: fn(text: String, needle: String) -> Int? {
    parts: text.split(needle).to_list()
    if parts.len() < 2 -> return None
    Val(parts[0].count_bytes())
}

gh_has: fn(values: [String], value: String) -> Bool {
    loop item in values {
        if item == value -> return true
    }
    false
}

gh_is_ident: fn(text: String) -> Bool {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    loop (index, byte) in bytes {
        letter: (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) || byte == (U8{95})
        digit: byte >= (U8{48}) && byte <= (U8{57})
        if !letter && !(digit && index > 0) -> return false
    }
    true
}

// A Jet string literal body as the generator decodes it: `{{`/`}}` braces and
// the backslash escapes the registry uses.
gh_unescape: fn(body: String) -> String {
    body.replace("{{{{", "{{").replace("}}}}", "}}").replace("\\\"", "\"").replace("\\\\", "\\")
}

gh_strip_comma: fn(text: String) -> String {
    trimmed: text.trim().copy()
    if trimmed.ends_with(",") -> return gh_slice(trimmed, 0, trimmed.count_bytes() - 1).trim().copy()
    trimmed
}

// Every `NAME: "literal"` constant in the syntax registry directory
// (EditorGrammars.jet `jet_cli_grammar_constants`).
gh_constants: fn() -> [(name: String, value: String)] {
    constants := [(name: String, value: String)]{}
    loop child in (gh_files.list_dir(GH_SYNTAX_DIR) ?? panic("list {GH_SYNTAX_DIR}: {err}")) {
        if child.is_dir || !child.name.ends_with(".jet") -> next
        loop line in gh_read(child.path).split("\n") {
            at: gh_index(line, ": \"") ?? next
            name: gh_slice(line, 0, at)
            if !gh_is_ident(name) -> next
            rest: gh_slice(line, at + 3, line.count_bytes())
            close := -1
            escaped := false
            loop (index, byte) in rest.bytes() {
                if escaped {
                    escaped = false
                } else if byte == (U8{92}) {
                    escaped = true
                } else if byte == (U8{34}) {
                    close = index
                    break
                }
            }
            if close < 0 -> next
            tail: gh_slice(rest, close + 1, rest.count_bytes()).trim().copy()
            if tail != "" && !tail.starts_with("//") -> next
            constants.push((name: name, value: gh_unescape(gh_slice(rest, 0, close))))
        }
    }
    assert(constants.len() > 100, "the syntax registry constants must be readable")
    constants
}

gh_resolve: fn(constants: [(name: String, value: String)], written: String) -> String {
    if written.starts_with("\"") -> return gh_unescape(gh_slice(written, 1, written.count_bytes() - 1))
    loop constant in constants {
        if constant.name == written -> return constant.value
    }
    panic("unresolved highlight text constant {written} in {GH_SYNTAX_DIR}")
}

// Active marker rule names (EditorGrammars.jet `jet_cli_grammar_markers`): every
// top-level struct in the Prelude marker source with an `impl Marker` block.
gh_active_markers: fn() -> [String] {
    names := [String]{}
    current := String?{None}
    loop line in gh_read("Compiler/Prelude/Markers.jet").split("\n") {
        if !line.starts_with(" ") && line.contains(": struct") {
            _: gh_index(line, "{{") ?? panic("marker struct without a body: {line}")
            colon: gh_index(line, ": struct") ?? panic("marker struct without a name: {line}")
            current = Val(gh_slice(line, 0, colon).trim().copy())
        } else if line.starts_with("}}") {
            current = None
        } else if current == .Val(name) && line.trim().starts_with("impl Marker") {
            names.push(name.copy())
            current = None
        }
    }
    assert(names.len() > 0, "no marker structs in Compiler/Prelude/Markers.jet")
    names
}

// `jet::Syntax::highlighted_tokens_sorted`: the JET_HIGHLIGHT_TOKENS rows plus
// every active marker rule.
gh_tokens: fn() -> [GhToken] {
    source: gh_read("{GH_SYNTAX_DIR}/Highlights.jet")
    start: gh_index(source, "JET_HIGHLIGHT_TOKENS: [HighlightToken]{{") ?? panic("missing JET_HIGHLIGHT_TOKENS table")
    table: gh_slice(source, start, source.count_bytes())
    end: gh_index(table, "\n}}") ?? panic("unterminated JET_HIGHLIGHT_TOKENS table")
    constants: gh_constants()
    tokens := [GhToken]{}
    pending := String?{None}
    loop raw in gh_slice(table, 0, end).split("\n") {
        line: raw.trim()
        if line.starts_with("text:") {
            pending = Val(gh_resolve(constants, gh_strip_comma(gh_slice(line, 5, line.count_bytes()))))
        } else if line.starts_with("class: HighlightClass.") {
            text: pending ?? panic("highlight class without text: {line}")
            tokens.push(GhToken{text: text, class: gh_strip_comma(gh_slice(line, 22, line.count_bytes()))})
            pending = None
        }
    }
    assert(tokens.len() > 100, "every HighlightToken row must parse")
    loop name in gh_active_markers() -> tokens.push(GhToken{text: name, class: "MarkerRule"})
    tokens
}

// tests/grammar.rs:20-39: the generated block, from the start marker's line
// through the end marker's line.
gh_generated_section: fn(path: String) -> String {
    text: gh_read(path)
    start: gh_index(text, "BEGIN GENERATED JET SYNTAX HIGHLIGHTS") ?? panic("{path} is missing the generated start")
    end: gh_index(text, "END GENERATED JET SYNTAX HIGHLIGHTS") ?? panic("{path} is missing the generated end")
    assert(end > start, "{path} generated end precedes its start")
    gh_slice(text, start, end)
}

gh_regex_escape: fn(text: String) -> String {
    out := ""
    loop ch in text.chars() {
        if "\\.+*?^$()[]{{}}|/-".contains("{ch}") -> out = "{out}\\"
        out = "{out}{ch}"
    }
    out
}

gh_section_has_token: fn(section: String, token: String) -> Bool {
    escaped: gh_regex_escape(token)
    section.contains(token) || section.contains(escaped) || section.contains(escaped.replace("\\", "\\\\"))
}

gh_bracket: fn(text: String) -> Bool { gh_has(["{{", "}}", "[", "]", "(", ")"], text) }

// tests/grammar.rs:274-299.
gh_anonymous_node_types: fn() -> [String] {
    out := [String]{}
    current := String?{None}
    named := 0
    loop line in gh_read(GH_NODE_TYPES).split("\n") {
        trimmed: line.trim()
        if line.starts_with("  {{") {
            current = None
            named = 0
        } else if trimmed.starts_with("\"type\":") && current == None {
            colon: gh_index(trimmed, ":") ?? next
            value: gh_slice(trimmed, colon + 1, trimmed.count_bytes()).trim().copy()
            if value.starts_with("\"") {
                close: gh_index(gh_slice(value, 1, value.count_bytes()), "\"") ?? next
                current = Val(gh_slice(value, 1, close + 1))
            }
        } else if trimmed.starts_with("\"named\":") && named == 0 {
            named = if trimmed.contains("true") -> 1 else -> 2
        } else if line.starts_with("  }}") && named == 2 {
            if current == .Val(name) {
                if !gh_has(out, name) -> out.push(name)
            }
            current = None
        }
    }
    assert(out.len() > 10, "tree-sitter anonymous node types must be readable")
    out
}

// tests/grammar.rs:301-319.
gh_query_string_literals: fn(query: String) -> [String] {
    out := [String]{}
    loop line in query.split("\n") {
        trimmed: line.trim()
        if trimmed.starts_with(";") -> next
        parts: trimmed.split("\"").to_list()
        index := 1
        loop index + 1 < parts.len() {
            out.push(parts[index].copy())
            index += 2
        }
    }
    out
}

gh_keyword_list: fn() -> [String] { gh_registry_list("JET_KEYWORD_LIST") }

// The words of a `NAME: [String]{ CONSTANT, … }` list in PackageFiles.jet,
// each constant resolved to its spelling.
gh_registry_list: fn(list: String) -> [String] {
    source: gh_read("{GH_SYNTAX_DIR}/PackageFiles.jet")
    start: gh_index(source, "{list}: [String]{{") ?? panic("missing {list}")
    body: gh_slice(source, start, source.count_bytes())
    end: gh_index(body, "\n}}") ?? panic("unterminated {list}")
    constants: gh_constants()
    words := [String]{}
    loop raw in gh_slice(body, 0, end).split("\n") {
        if raw.contains(": ") -> next
        line: gh_strip_comma(raw.copy())
        if line == "" || line.starts_with("//") -> next
        words.push(gh_resolve(constants, line.copy()))
    }
    assert(words.len() > 0, "{list} must be readable")
    words
}

// tests/grammar.rs:366-436: the words of every `(a|b|c)` alternation in the
// `match` patterns of the VS Code grammar's `keywords` block.
gh_grammar_keyword_words: fn() -> [String] {
    words := [String]{}
    inside := false
    depth := 0
    loop raw in gh_read(GH_VSCODE).split("\n") {
        line: raw.trim()
        if line.contains("\"keywords\"") -> inside = true
        if !inside -> next
        depth += line.bytes().count(U8{123})
        depth -= line.bytes().count(U8{125})
        if depth <= 0 && !line.contains("\"keywords\"") -> inside = false
        at: gh_index(line, "\"match\"") ?? next
        after: gh_slice(line, at + 7, line.count_bytes())
        colon: gh_index(after, ":") ?? next
        value: gh_slice(after, colon + 1, after.count_bytes()).trim().copy()
        if !value.starts_with("\"") -> next
        rest := gh_slice(value, 1, value.count_bytes())
        loop {
            open: gh_index(rest, "(") ?? break
            tail: gh_slice(rest, open + 1, rest.count_bytes())
            close: gh_index(tail, ")") ?? break
            group: gh_slice(tail, 0, close)
            if !group.contains("(") && !group.contains("\\") {
                loop word in group.split("|") {
                    trimmed: word.trim().copy()
                    if gh_is_ident(trimmed) && !gh_has(words, trimmed) -> words.push(trimmed)
                }
            }
            rest = gh_slice(tail, close + 1, tail.count_bytes())
        }
    }
    assert(words.len() > 10, "the VS Code keyword patterns must be readable")
    words
}

// tests/grammar.rs:176.
#Test("every_highlight_token_is_in_each_generated_section") {
    guards_enter_root()
    sections: [GH_VSCODE, GH_TREE_SITTER].map(path -> (path: path, section: gh_generated_section(path)))
    missing := [String]{}
    loop token in gh_tokens() {
        if gh_bracket(token.text) -> next
        loop entry in sections {
            if !gh_section_has_token(entry.section, token.text) -> missing.push("{entry.path} generated section missing `{token.text}` ({token.class})")
        }
    }
    assert_eq(missing.join("\n"), "")
}

// D-MOVE-SIGIL1=A: the editor grammars colour the take mark `&&` apart from
// logical and. TextMate reads it only where a parameter type or a task capture
// starts and keeps the sigil `&` off the first half of `&&`; Zed marks it in a
// parameter list and after `task`.
#Test("take_mark_is_coloured_apart_from_logical_and") {
    guards_enter_root()
    vscode: gh_generated_section(GH_VSCODE)
    assert(vscode.contains("keyword.other.ownership.take.jet"), "{GH_VSCODE} has no take-mark scope")
    assert(vscode.contains("(?<=\\\\btask\\\\s))(&&)"), "{GH_VSCODE} take mark is not limited to parameter and task positions")
    assert(vscode.contains("&(?!&)"), "{GH_VSCODE} sigil `&` still matches the first half of logical and")
    assert(gh_generated_section(GH_TREE_SITTER).contains("const JET_HIGHLIGHT_TAKE_MARK = [\"&&\"];"), "{GH_TREE_SITTER} has no take-mark class")
    zed: gh_read(GH_ZED)
    assert(zed.contains("(parameters \"&&\" @keyword)"), "{GH_ZED} does not mark `&&` in parameter lists")
    assert(zed.contains("((control_keyword) . \"&&\" @keyword)"), "{GH_ZED} does not mark `&&` after `task`")
}

// The `#X: value` marker line: the tree-sitter section renders the
// registry's separator, and the grammar's `inbody_marker` rule parses it.
#Test("tree_sitter_parses_the_inbody_marker_line_with_the_registry_separator") {
    guards_enter_root()
    separator := ""
    loop constant in gh_constants() {
        if constant.name == "MARKER_INBODY_SEPARATOR" -> separator = constant.value
    }
    assert(separator != "", "missing MARKER_INBODY_SEPARATOR in {GH_SYNTAX_DIR}")
    assert(gh_generated_section(GH_TREE_SITTER).contains("const JET_MARKER_INBODY_SEPARATOR = \"{separator}\";"), "{GH_TREE_SITTER} does not render MARKER_INBODY_SEPARATOR")
    assert(gh_read(GH_TREE_SITTER).contains("inbody_marker:"), "{GH_TREE_SITTER} has no `inbody_marker` rule")
    assert(gh_has(gh_anonymous_node_types(), separator), "{GH_NODE_TYPES} does not list `{separator}`")
}

// tests/grammar.rs:204: the Zed generated block names exactly the word tokens
// (other than marker rules) that tree-sitter parses as anonymous literals.
#Test("zed_generated_query_covers_anonymous_highlight_words") {
    guards_enter_root()
    anonymous: gh_anonymous_node_types()
    actual := [String]{}
    loop literal in gh_query_string_literals(gh_generated_section(GH_ZED)) {
        if !gh_has(actual, literal) -> actual.push(literal)
    }
    expected := [String]{}
    loop token in gh_tokens() {
        if token.class != "MarkerRule" && gh_is_ident(token.text) && gh_has(anonymous, token.text) && !gh_has(expected, token.text) -> expected.push(token.text)
    }
    actual.sort()
    expected.sort()
    assert_eq(actual.join(" "), expected.join(" "))
}

// tests/grammar.rs:225.
#Test("syntax_keyword_list_tokens_are_classified_for_highlighting") {
    guards_enter_root()
    texts: gh_tokens().map(token -> token.text)
    missing := [String]{}
    loop keyword in gh_keyword_list() {
        if !gh_has(texts, keyword) -> missing.push(keyword)
    }
    assert_eq(missing.join(" "), "")
}

// tests/grammar.rs:465.
#Test("grammar_covers_jet_keyword_list") {
    guards_enter_root()
    words: gh_grammar_keyword_words()
    missing := [String]{}
    loop keyword in gh_keyword_list() {
        if !gh_has(words, keyword) -> missing.push(keyword)
    }
    assert_eq(missing.join(" "), "")
}

// tests/grammar.rs:493: FOREIGN_* teaching words never appear in the VS Code
// keyword patterns unless they are real Jet keywords.
#Test("grammar_excludes_foreign_words") {
    guards_enter_root()
    words: gh_grammar_keyword_words()
    keywords: gh_keyword_list()
    intruders := [String]{}
    loop constant in gh_constants() {
        if !constant.name.starts_with("FOREIGN_") || !gh_is_ident(constant.value) -> next
        if gh_has(words, constant.value) && !gh_has(keywords, constant.value) && !gh_has(intruders, constant.value) -> intruders.push(constant.value)
    }
    assert_eq(intruders.join(" "), "")
}

// The registry constants named in `names` that `words` holds (`wanted`) or
// lacks (`!wanted`), as `NAME (spelling)`.
gh_listed: fn(words: [String], names: [String], wanted: Bool) -> String {
    constants: gh_constants()
    found := [String]{}
    loop name in names {
        spelling: gh_resolve(constants, name)
        if gh_has(words, spelling) == wanted -> found.push("{name} ({spelling})")
    }
    found.join(" ")
}

// tests/lsp.rs:5710 c44_lsp_keywords_derive_from_syntax: the keyword list LSP
// completion and rename read holds the real keywords and no foreign teaching
// word or contextual literal.
#Test("lsp_keywords_derive_from_syntax") {
    guards_enter_root()
    keywords: gh_keyword_list()
    required: [String]{"KW_FN", "KW_PUB", "KW_USE", "KW_IF", "KW_ELSE", "KW_LOOP", "KW_RETURN", "KW_STRUCT", "KW_ENUM", "KW_IMPL", "KW_UNSAFE", "KW_TEST", "KW_TODO", "LIT_TRUE", "LIT_FALSE", "LIT_NULL", "KW_DISTINCT", "KW_MODULE"}
    assert_eq(gh_listed(keywords, required, false), "")
    banned: [String]{"FOREIGN_SWITCH", "FOREIGN_IMPORT", "FOREIGN_OR_FALLBACK", "FOREIGN_WHILE", "FOREIGN_FOR", "FOREIGN_MATCH", "FOREIGN_CLASS", "LIT_VALUE", "LIT_OK", "LIT_ERR"}
    assert_eq(gh_listed(keywords, banned, true), "")
}

// tests/lsp.rs:5782 c44_lsp_types_derive_from_syntax: the built-in type list
// holds the types a user writes and not the retired `Result`.
#Test("lsp_types_derive_from_syntax") {
    guards_enter_root()
    types: gh_registry_list("JET_TYPE_LIST")
    required: [String]{"TYPE_INT", "TYPE_FLOAT", "TYPE_BOOL", "TYPE_STRING", "TYPE_CHAR", "TYPE_SHARED", "TYPE_HASH_MAP", "TYPE_BTREE_MAP", "TYPE_QUEUE", "TYPE_SET"}
    assert_eq(gh_listed(types, required, false), "")
    assert_eq(gh_listed(types, [String]{"TYPE_RESULT"}, true), "")
}

// tests/lsp.rs:5528 c40_value_literal_is_not_a_keyword: `Val` is a literal
// (D-OPT-SPELL1), so rename and completion don't treat it as a keyword.
#Test("lsp_value_literal_is_not_a_keyword") {
    guards_enter_root()
    assert_eq(gh_resolve(gh_constants(), "LIT_VALUE"), "Val")
    assert(!gh_has(gh_keyword_list(), "Val"), "LIT_VALUE must stay out of JET_KEYWORD_LIST")
}

// tests/lsp.rs:5814 c44_impure_builtins_complete: the impure builtins sema and
// comptime purity share name every stdout, stderr and stdin builtin.
#Test("lsp_impure_builtins_complete") {
    guards_enter_root()
    builtins: gh_registry_list("IMPURE_BUILTINS")
    missing := [String]{}
    required: [String]{"print", "input", "eprint", "read_all_input"}
    loop name in required {
        if !gh_has(builtins, name) -> missing.push(name)
    }
    assert_eq(missing.join(" "), "")
}
