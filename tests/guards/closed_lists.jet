use closed_list_files: core.files

// The closed-list guard. A closed list is a top-level `enum` or `[String]`
// constant with three or more members in the compiler, Core or Jetpack. Each
// one is a finding keyed by file and name, never by line, so edits do not churn
// the ledgers. A file whose header says it is generated from a declared twin
// holds no findings, nor does a generated block a registered generator owns
// inside a hand-written file; any other finding passes when the kernel ledger
// keeps it closed with a reason class, when the mirror ledger names it as an
// exact copy of its one hand-written home, when the subset ledger names it as
// a checked subset view of one vocabulary, or when the migration baseline
// still lists it.
// Function-local lists are state private to one function and are not findings.
CLOSED_LIST_ROOTS: [String]{"Compiler", "Core", "Jetpack"}
CLOSED_LIST_BASELINE_PATH: "tests/guards/closed_lists/baseline.tsv"
CLOSED_LIST_KERNEL_PATH: "tests/guards/closed_lists/kernel.tsv"
CLOSED_LIST_DUPLICATES_PATH: "tests/guards/closed_lists/duplicates.tsv"
CLOSED_LIST_MIRRORS_PATH: "tests/guards/closed_lists/mirrors.tsv"
CLOSED_LIST_SUBSETS_PATH: "tests/guards/closed_lists/subsets.tsv"

// The generators that own a generated block inside a hand-written file. A
// block opens with a `// BEGIN GENERATED by <generator> …` line and closes
// with `// END GENERATED`. Its lists are no findings only when <generator> is
// listed here; that generator's `--check`, which Tools/agent/LaneCheck.jet
// runs for the file, rewrites the whole block, so a hand edit inside it
// fails. A block naming any other generator is scanned like the rest of the
// file.
CLOSED_LIST_BLOCK_GENERATORS: [String]{"Tools/agent/CoreSourceRows.jet"}
CLOSED_LIST_BLOCK_BEGIN: "// BEGIN GENERATED by "
CLOSED_LIST_BLOCK_END: "// END GENERATED"

// The migration baseline and the duplicate baseline only shrink: delete a row
// when its list moves to a declared home, then lower the ceiling to match. A
// duplicate baseline row also records how many members its pair shares, and
// that count only shrinks.
CLOSED_LIST_BASELINE: 987
CLOSED_LIST_DUPLICATE_BASELINE: 338

// The reasons a list may stay closed. Each kernel ledger row names one.
CLOSED_LIST_REASONS: [String]{"grammar", "soundness", "ir", "kernel", "protocol", "fixed-standard"}

// What a new domain list is declared as instead of a hand-written list.
CLOSED_LIST_DECLARE: "declare the vocabulary once as a Core trait with one `impl` per member (or as declaration rows in its owning module) and generate this view from it with a `--check` generator whose file header says `This file is generated by <tool>; do not edit.`"

ClosedListFinding: struct {
    path: String
    name: String
    members: [String]
}

closed_list_ident_byte: fn(byte: U8) -> Bool { s3_truth_ascii_word_byte(byte) }

closed_list_upper_byte: fn(byte: U8) -> Bool { Int.from_u8(byte) >= 65 && Int.from_u8(byte) <= 90 }

// The identifier that starts `text`, or "" when it does not start with one.
closed_list_ident_prefix: fn(text: String) -> String {
    bytes: text.bytes()
    end := 0
    loop {
        if end >= bytes.len() || !closed_list_ident_byte(bytes[end]) -> break
        end += 1
    }
    policy_slice_bytes(text, 0, end)
}

// The enum variants a member line declares: `A B C`, `Custom(String)` or
// `Report{ code: Int }`. A field, method or `impl` line declares none.
closed_list_enum_line_members: fn(line: String, out: &[String]) {
    loop word in line.trim().split(" ").to_list() {
        if word == "" -> next
        ident: closed_list_ident_prefix(word)
        if ident == "" || !closed_list_upper_byte(ident.bytes()[0]) -> return
        if ident != word {
            next_byte: Int.from_u8(word.bytes()[ident.bytes().len()])
            // `(` payload, `{` record payload, `,` separator.
            if next_byte != 40 && next_byte != 123 && next_byte != 44 -> return
        }
        out.push(ident.to_lower())
        if ident != word && Int.from_u8(word.bytes()[ident.bytes().len()]) != 44 -> return
    }
}

// The string literals on `line`, lower-cased.
closed_list_string_members: fn(line: String, out: &[String]) {
    bytes: line.bytes()
    index := 0
    loop {
        if index >= bytes.len() -> break
        if Int.from_u8(bytes[index]) == 47 && index + 1 < bytes.len() && Int.from_u8(bytes[index + 1]) == 47 -> break
        if Int.from_u8(bytes[index]) != 34 {
            index += 1
            next
        }
        start: index + 1
        end := start
        loop {
            if end >= bytes.len() -> break
            if Int.from_u8(bytes[end]) == 92 {
                end += 2
                next
            }
            if Int.from_u8(bytes[end]) == 34 -> break
            end += 1
        }
        if end > bytes.len() -> break
        out.push(policy_slice_bytes(line, start, end).to_lower())
        index = end + 1
    }
}

// Whether a header line says the file is generated: it reads "do not edit",
// opens a generated block, or names the file as generated.
closed_list_generated_line: fn(line: String) -> Bool {
    if !line.starts_with("//") -> return false
    lower: line.to_lower()
    lower.contains("do not edit") || lower.contains("begin generated") || lower.contains("generated file") || lower.contains("generated by")
}

// Whether `line` opens a generated block a registered generator owns.
closed_list_registered_block: fn(line: String) -> Bool {
    if !line.starts_with(CLOSED_LIST_BLOCK_BEGIN) -> return false
    CLOSED_LIST_BLOCK_GENERATORS.contains(line.removeprefix(CLOSED_LIST_BLOCK_BEGIN).split(" ").to_list()[0])
}

closed_list_generated_header: fn(header: String) -> Bool {
    loop line in header.lines() {
        if closed_list_generated_line(line) -> return true
    }
    false
}

// A header is the first five lines; they fit in this many bytes.
CLOSED_LIST_HEADER_BYTES: 1024

// The header of the file at `path`, read without the rest of the file:
// generated tables are most of the bytes under the roots.
closed_list_header: fn(path: String) -> String {
    bytes: closed_list_files.read_at(path, 0, CLOSED_LIST_HEADER_BYTES) ?? return ""
    cut := 0
    lines := 0
    loop index in 0..<bytes.len() {
        if Int.from_u8(bytes[index]) != 10 -> next
        cut = index
        lines += 1
        if lines == 5 -> break
    }
    if lines < 5 && bytes.len() < CLOSED_LIST_HEADER_BYTES -> cut = bytes.len()
    head := [U8]{}
    loop index in 0..<cut -> head.push(bytes[index])
    String.from_bytes(head) ?? ""
}

closed_list_unique: fn(members: [String]) -> [String] {
    seen := [String:Bool]{}
    out := [String]{}
    loop member in members {
        if member == "" || (seen.get(member) ?? false) -> next
        seen[member] = true
        out.push(member.copy())
    }
    out
}

// The byte offset just past the first `needle` in `text`, or the end.
closed_list_after: fn(text: String, needle: String) -> Int {
    bytes: text.bytes()
    width: needle.bytes().len()
    loop start in 0..<bytes.len() {
        if start + width <= bytes.len() && policy_slice_bytes(text, start, start + width) == needle -> return start + width
    }
    bytes.len()
}

// The kind a top-level line opens: "enum", "list" or "".
closed_list_opener: fn(rest: String) -> String {
    if rest.starts_with("enum {{") || rest.starts_with("enum{{") -> return "enum"
    if rest.starts_with("[String]{{") || rest.starts_with("#run {{ [String]{{") || rest.starts_with("#run {{[String]{{") -> return "list"
    ""
}

// Every closed list `text` declares at top level, outside the generated
// blocks registered generators own, for the file `path`.
closed_list_findings_in: fn(path: String, text: String, out: &[ClosedListFinding]) {
    if !text.contains(": enum") && !text.contains("[String]{{") -> return
    kind := ""
    name := ""
    members := [String]{}
    owned := false
    loop line in text.lines() {
        if owned {
            if line == CLOSED_LIST_BLOCK_END -> owned = false
            next
        }
        if kind == "" && closed_list_registered_block(line) {
            owned = true
            next
        }
        if kind != "" {
            if line.starts_with("}}") {
                unique: closed_list_unique(members)
                if unique.len() >= 3 -> out.push(ClosedListFinding{path: path, name: name, members: unique})
                kind = ""
                next
            }
            if line.trim_start().starts_with("//") -> next
            if kind == "enum" {
                if line.starts_with("    ") && !line.starts_with("     ") -> closed_list_enum_line_members(line, members)
            } else {
                closed_list_string_members(line, members)
            }
            next
        }
        if line == "" || line.starts_with(" ") || line.starts_with("\t") || line.starts_with("/") -> next
        if !line.contains(": enum") && !line.contains("[String]{{") -> next
        ident: closed_list_ident_prefix(line)
        if ident == "" -> next
        bytes: line.bytes()
        width: ident.bytes().len()
        if width + 1 >= bytes.len() || Int.from_u8(bytes[width]) != 58 -> next
        rest: policy_slice_bytes(line, width + 1, bytes.len()).trim()
        opened: closed_list_opener(rest)
        if opened == "" -> next
        name = ident
        members = [String]{}
        opener_end: closed_list_after(rest, if opened == "enum" -> "{{" else -> "]{{")
        body: policy_slice_bytes(rest, opener_end, rest.bytes().len())
        if rest.ends_with("}}") {
            if opened == "enum" {
                closed_list_enum_line_members(body, members)
            } else {
                closed_list_string_members(body, members)
            }
            unique: closed_list_unique(members)
            if unique.len() >= 3 -> out.push(ClosedListFinding{path: path, name: name, members: unique})
            next
        }
        if opened == "list" -> closed_list_string_members(body, members)
        kind = opened
    }
}

// Test sources, fixtures and vendored code hold data, not vocabularies.
closed_list_skipped_dir: fn(name: String) -> Bool {
    name.starts_with(".") || name == "node_modules" || name == "target" || name == "build" ||
    name == "Tests" || name == "tests" || name == "Fixtures" || name == "fixtures" || name == "Vendor"
}

closed_list_scan: fn(path: String, out: &[ClosedListFinding]) {
    kind: closed_list_files.stat(path) ?? return
    if kind.is_symlink -> return
    if kind.is_dir {
        loop child in (closed_list_files.list_dir(path) ?? panic("list {path}: {err}")) {
            if closed_list_skipped_dir(child.name) -> next
            closed_list_scan("{path}/{child.name}", out)
        }
        return
    }
    if !path.ends_with(".jet") || closed_list_generated_header(closed_list_header(path)) -> return
    text: closed_list_files.read(path) ?? return
    closed_list_findings_in(path, text, out)
}

closed_list_findings: fn() -> [ClosedListFinding] {
    found := [ClosedListFinding]{}
    loop root in CLOSED_LIST_ROOTS {
        assert(closed_list_files.is_dir(root), "the closed-list root {root} must exist")
        closed_list_scan(root, found)
    }
    found
}

// The rows of a ledger file: tab-separated fields; `#` lines are comments.
closed_list_rows: fn(path: String) -> [[String]] {
    text: closed_list_files.read(path) ?? panic("read {path}")
    rows := [[String]]{}
    loop line in text.lines() {
        if line == "" || line.starts_with("#") -> next
        rows.push(line.split("\t").to_list())
    }
    rows
}

closed_list_key: fn(path: String, name: String) -> String { "{path}\t{name}" }

// The failure for a new hand-written list names the form to declare instead.
closed_list_new_list_problem: fn(finding: ClosedListFinding) -> String {
    "{finding.path} {finding.name}: a new hand-written closed list ({finding.members.len()} members). Either {CLOSED_LIST_DECLARE} Or, when it must stay closed, add a row to {CLOSED_LIST_KERNEL_PATH}: file, name, reason class ({CLOSED_LIST_REASONS.join(", ")}) and the expert way out."
}

closed_list_duplicate_problem: fn(pair: String) -> String {
    "two lists share 80% or more of their members: {pair}. Keep one hand-written home: {CLOSED_LIST_DECLARE}"
}

// A mirror ledger row names a copy the compiler can't import from its home:
// copy file, copy name, home file, home name. The copy must hold the home's
// members in the home's order, so editing the copy alone fails; edit the home
// and copy it, or generate the copy. Returns the copies' keys.
closed_list_mirror_problems: fn(findings: [ClosedListFinding], rows: [[String]], problems: &[String]) -> [String] {
    at := [String:Int]{}
    loop (index, finding) in findings -> at[closed_list_key(finding.path, finding.name)] = index
    copies := [String]{}
    loop row in rows {
        if row.len() != 4 {
            problems.push("mirror ledger row needs copy file, copy name, home file and home name: {row.join("\t")}")
            next
        }
        copy_at: at.get(closed_list_key(row[0], row[1])) ?? -1
        home_at: at.get(closed_list_key(row[2], row[3])) ?? -1
        if copy_at < 0 || home_at < 0 {
            problems.push("mirror ledger row {row.join(" ")} names a list that is gone; delete the row")
            next
        }
        copies.push(closed_list_key(row[0], row[1]))
        if findings[copy_at].members.join(" ") != findings[home_at].members.join(" ") -> problems.push("{row[0]} {row[1]} is a copy of {row[2]} {row[3]} and no longer matches it. The home is the one hand-written list: edit {row[2]}, then copy it here, or generate this copy.")
    }
    copies
}

// A subset ledger row names a checked subset view of one vocabulary: view
// file, view name, the `#run` constant in that file whose check stops the
// build when a member names nothing in the vocabulary, and the vocabulary
// constant that check reads. The view is derived, not a second home: its
// duplicate pairs are the vocabulary's, and it leaves the baseline. `texts`
// holds each view file's source. Returns the views' keys.
closed_list_subset_problems: fn(findings: [ClosedListFinding], rows: [[String]], texts: [String: String], problems: &[String]) -> [String] {
    known := [String:Bool]{}
    loop finding in findings -> known[closed_list_key(finding.path, finding.name)] = true
    views := [String]{}
    loop row in rows {
        if row.len() != 4 || row[2].trim() == "" || row[3].trim() == "" {
            problems.push("subset ledger row needs view file, view name, check constant and vocabulary constant: {row.join("\t")}")
            next
        }
        if !(known.get(closed_list_key(row[0], row[1])) ?? false) {
            problems.push("subset ledger row {row.join(" ")} names a list that is gone; delete the row")
            next
        }
        text: texts.get(row[0]) ?? ""
        if !text.contains("\n{row[2]}: #run ") || !text.contains(row[3]) {
            problems.push("{row[0]} {row[1]} is in the subset ledger, but {row[0]} has no `{row[2]}: #run …` check reading {row[3]}; the check is what makes the view derived")
            next
        }
        views.push(closed_list_key(row[0], row[1]))
    }
    views
}

// Every finding the kernel ledger, the mirror or subset ledger (`copies`, the
// keys of both) or the baseline does not hold, every stale or malformed ledger
// row, and a baseline that grew or shrank past its ceiling.
closed_list_home_problems: fn(findings: [ClosedListFinding], copies: [String], problems: &[String]) {
    kernel := [String:Bool]{}
    kernel_keys := [String]{}
    loop row in closed_list_rows(CLOSED_LIST_KERNEL_PATH) {
        if row.len() != 4 || row[3].trim() == "" {
            problems.push("kernel ledger row needs file, name, reason class and way out: {row.join("\t")}")
            next
        }
        if !CLOSED_LIST_REASONS.contains(row[2]) -> problems.push("kernel ledger row {row[0]} {row[1]}: the reason class must be one of {CLOSED_LIST_REASONS.join(", ")}")
        kernel[closed_list_key(row[0], row[1])] = true
        kernel_keys.push(closed_list_key(row[0], row[1]))
    }
    baseline := [String:Bool]{}
    baseline_keys := [String]{}
    loop row in closed_list_rows(CLOSED_LIST_BASELINE_PATH) {
        if row.len() != 2 {
            problems.push("baseline row needs file and name: {row.join("\t")}")
            next
        }
        key: closed_list_key(row[0], row[1])
        if kernel.get(key) ?? false -> problems.push("{row[0]} {row[1]} is in both the baseline and the kernel ledger; keep the kernel row")
        if copies.contains(key) -> problems.push("{row[0]} {row[1]} is in both the baseline and the mirror or subset ledger; keep the mirror or subset row")
        baseline[key] = true
        baseline_keys.push(key)
    }
    print("closed-list migration baseline: {baseline_keys.len()} lists (ceiling {CLOSED_LIST_BASELINE})")
    if baseline_keys.len() > CLOSED_LIST_BASELINE -> problems.push("the closed-list baseline grew past {CLOSED_LIST_BASELINE}; a baseline row may be removed, never added")
    if baseline_keys.len() < CLOSED_LIST_BASELINE -> problems.push("the closed-list baseline shrank to {baseline_keys.len()} rows; lower CLOSED_LIST_BASELINE to {baseline_keys.len()}")
    hand := [String:Bool]{}
    loop finding in findings {
        key: closed_list_key(finding.path, finding.name)
        hand[key] = true
        if (kernel.get(key) ?? false) || (baseline.get(key) ?? false) || copies.contains(key) -> next
        problems.push(closed_list_new_list_problem(finding))
    }
    loop key in baseline_keys {
        if !(hand.get(key) ?? false) -> problems.push("baseline row {key} names no hand-written list any more; delete the row and lower CLOSED_LIST_BASELINE")
    }
    loop key in kernel_keys {
        if !(hand.get(key) ?? false) -> problems.push("kernel ledger row {key} names no hand-written list any more; delete the row")
    }
}

// The pair key, in a fixed order so either listing order finds it.
closed_list_pair_key: fn(a: ClosedListFinding, b: ClosedListFinding) -> String {
    first: closed_list_key(a.path, a.name)
    second: closed_list_key(b.path, b.name)
    ordered := [String]{first, second}
    ordered.sort()
    "{ordered[0]}\t{ordered[1]}"
}

// A pair of list positions packs into one map key as `left * SPAN + right`.
CLOSED_LIST_SPAN: 1000000

// Two hand-written lists in different files that share members: the pair
// key, how many members they share, and whether that is at least 80% of the
// smaller list's members.
ClosedListPair: struct {
    key: String
    shared: Int
    duplicate: Bool
}

// Every pair of hand-written lists in different files that share a member.
// Each member chains the lists that hold it, so only lists that share a
// member are ever compared.
closed_list_shared_pairs: fn(findings: [ClosedListFinding]) -> [ClosedListPair] {
    ids := [String:Int]{}
    chain_head := [Int]{}
    posting_list := [Int]{}
    posting_next := [Int]{}
    loop position in 0..<findings.len() {
        loop member in findings[position].members {
            id := ids.get(member) ?? -1
            if id < 0 {
                id = chain_head.len()
                ids[member] = id
                chain_head.push(-1)
            }
            posting_list.push(position)
            posting_next.push(chain_head[id])
            chain_head[id] = posting_list.len() - 1
        }
    }
    pair_index := [Int:Int]{}
    pair_left := [Int]{}
    pair_right := [Int]{}
    pair_count := [Int]{}
    loop head in chain_head {
        // Chains run from the latest list back, so `later` always exceeds `earlier`.
        later := head
        loop {
            if later < 0 -> break
            earlier := posting_next[later]
            loop {
                if earlier < 0 -> break
                key: posting_list[earlier] * CLOSED_LIST_SPAN + posting_list[later]
                slot: pair_index.get(key) ?? -1
                if slot < 0 {
                    pair_index[key] = pair_count.len()
                    pair_left.push(posting_list[earlier])
                    pair_right.push(posting_list[later])
                    pair_count.push(1)
                } else {
                    pair_count[slot] = pair_count[slot] + 1
                }
                earlier = posting_next[earlier]
            }
            later = posting_next[later]
        }
    }
    pairs := [ClosedListPair]{}
    loop slot in 0..<pair_count.len() {
        left: pair_left[slot]
        right: pair_right[slot]
        if findings[left].path == findings[right].path -> next
        left_size: findings[left].members.len()
        right_size: findings[right].members.len()
        smaller: if left_size < right_size -> left_size else -> right_size
        pairs.push(ClosedListPair{key: closed_list_pair_key(findings[left], findings[right]), shared: pair_count[slot], duplicate: pair_count[slot] * 5 >= smaller * 4})
    }
    pairs
}

// Pairs of hand-written lists in different files sharing at least 80% of the
// smaller list's members.
closed_list_duplicate_pairs: fn(findings: [ClosedListFinding]) -> [String] {
    pairs := [String]{}
    loop pair in closed_list_shared_pairs(findings) {
        if pair.duplicate -> pairs.push(pair.key)
    }
    pairs
}

// Whether one side of `pair` is a mirror copy or a subset view.
closed_list_mirror_pair: fn(pair: String, copies: [String]) -> Bool {
    loop twin in copies {
        if pair.starts_with("{twin}\t") || pair.ends_with("\t{twin}") -> return true
    }
    false
}

// Every pair of lists in different files that shares 80% or more of the
// smaller list's members and that the duplicate baseline does not hold, every
// baselined pair whose shared count differs from its row, and a baseline past
// its ceiling either way. A baselined pair is judged by its shared count
// alone: deleting a member only one of the lists holds never fails it, and a
// new shared member does, even when unique ones arrive with it. A mirror copy
// matches its home and a subset view is checked against its vocabulary, so
// their pairs are their homes' pairs.
closed_list_duplicate_problems: fn(findings: [ClosedListFinding], copies: [String], problems: &[String]) {
    pairs := [String:ClosedListPair]{}
    pair_keys := [String]{}
    loop pair in closed_list_shared_pairs(findings) {
        if closed_list_mirror_pair(pair.key, copies) -> next
        pair_keys.push(pair.key)
        pairs[pair.key] = pair
    }
    known := [String:Bool]{}
    rows := 0
    loop row in closed_list_rows(CLOSED_LIST_DUPLICATES_PATH) {
        rows += 1
        count: if row.len() == 5 -> Int.parse(row[4]) ?? -1 else -> -1
        if count < 0 {
            problems.push("duplicate baseline row needs file, name, file, name and shared count: {row.join("\t")}")
            next
        }
        key: "{row[0]}\t{row[1]}\t{row[2]}\t{row[3]}"
        known[key] = true
        shared: if pairs.get(key) == .Val(pair) -> pair.shared else -> 0
        if {
            shared == 0 -> problems.push("duplicate baseline row no longer shares a member: {key}; delete the row and lower CLOSED_LIST_DUPLICATE_BASELINE")
            shared > count -> problems.push("{key} now share {shared} members, up from {count}; a baselined pair's shared count may shrink, never grow. Keep one hand-written home: {CLOSED_LIST_DECLARE}")
            shared < count -> problems.push("{key} now share {shared} members, down from {count}; lower the row's count to {shared}")
            else -> {}
        }
    }
    print("closed-list duplicate baseline: {rows} pairs (ceiling {CLOSED_LIST_DUPLICATE_BASELINE})")
    if rows > CLOSED_LIST_DUPLICATE_BASELINE -> problems.push("the duplicate baseline grew past {CLOSED_LIST_DUPLICATE_BASELINE}; a row may be removed, never added")
    if rows < CLOSED_LIST_DUPLICATE_BASELINE -> problems.push("the duplicate baseline shrank to {rows} pairs; lower CLOSED_LIST_DUPLICATE_BASELINE to {rows}")
    loop key in pair_keys {
        pair: pairs.get(key) ?? next
        if pair.duplicate && !(known.get(key) ?? false) -> problems.push(closed_list_duplicate_problem(key))
    }
}

// One scan of the roots feeds every check.
#Test("every closed list is generated, kept closed by the kernel ledger, a checked copy or subset, or in the shrinking baseline, and no two files duplicate one") {
    guards_enter_root()
    findings: closed_list_findings()
    problems := [String]{}
    copies := closed_list_mirror_problems(findings, closed_list_rows(CLOSED_LIST_MIRRORS_PATH), problems)
    subset_rows: closed_list_rows(CLOSED_LIST_SUBSETS_PATH)
    texts := [String: String]{}
    loop row in subset_rows {
        if row.len() > 0 -> texts[row[0]] = closed_list_files.read(row[0]) ?? ""
    }
    loop view in closed_list_subset_problems(findings, subset_rows, texts, problems) -> copies.push(view)
    closed_list_home_problems(findings, copies, problems)
    closed_list_duplicate_problems(findings, copies, problems)
    assert_eq(problems.join("\n"), "")
}

#Test("a subset view counts as derived only while its file holds the #run check") {
    guards_enter_root()
    view: ClosedListFinding{path: "v.jet", name: "View", members: [String]{"net", "fs", "db"}}
    rows: [[String]]{[String]{"v.jet", "View", "VIEW_COUNT", "ROOTS"}}
    checked: [String: String]{"v.jet": "use {{ x.[ROOTS] }}\nVIEW_COUNT: #run {{ view_count(embed_file(\"v.jet\"), ROOTS) }}\n"}
    clean := [String]{}
    assert_eq(closed_list_subset_problems([ClosedListFinding]{view.copy()}, rows, checked, clean).join(","), "v.jet\tView")
    assert_eq(clean.len(), 0)
    // The operand form `NAME: #run call(...)` is the same check.
    operand: [String: String]{"v.jet": "use {{ x.[ROOTS] }}\nVIEW_COUNT: #run view_count(embed_file(\"v.jet\"), ROOTS)\n"}
    assert_eq(closed_list_subset_problems([ClosedListFinding]{view.copy()}, rows, operand, clean).join(","), "v.jet\tView")
    assert_eq(clean.len(), 0)
    unchecked := [String]{}
    assert_eq(closed_list_subset_problems([ClosedListFinding]{view.copy()}, rows, [String: String]{"v.jet": "View: enum {{ Net FS DB }}\n"}, unchecked).len(), 0)
    assert(unchecked[0].contains("has no `VIEW_COUNT: #run …` check reading ROOTS"))
    gone := [String]{}
    closed_list_subset_problems([ClosedListFinding]{}, rows, checked, gone)
    assert(gone[0].contains("names a list that is gone"))
    // A view's duplicate pairs are its vocabulary's, so they leave the duplicate ledger.
    assert(closed_list_mirror_pair("h.jet\tHOME\tv.jet\tView", [String]{"v.jet\tView"}))
}

#Test("editing a mirror copy without its home fails the mirror ledger") {
    guards_enter_root()
    home: ClosedListFinding{path: "h.jet", name: "HOME", members: [String]{"abi", "cli", "ffi"}}
    twin: ClosedListFinding{path: "c.jet", name: "COPY", members: [String]{"abi", "cli", "ffi"}}
    edited: ClosedListFinding{path: "c.jet", name: "COPY", members: [String]{"abi", "cli", "ffi", "gpu"}}
    rows: [[String]]{[String]{"c.jet", "COPY", "h.jet", "HOME"}}
    clean := [String]{}
    assert_eq(closed_list_mirror_problems([ClosedListFinding]{home.copy(), twin.copy()}, rows, clean).join(","), "c.jet\tCOPY")
    assert_eq(clean.len(), 0)
    drift := [String]{}
    closed_list_mirror_problems([ClosedListFinding]{home.copy(), edited.copy()}, rows, drift)
    assert_eq(drift.len(), 1)
    assert(drift[0].contains("c.jet COPY is a copy of h.jet HOME and no longer matches it"))
    gone := [String]{}
    closed_list_mirror_problems([ClosedListFinding]{home.copy()}, rows, gone)
    assert(gone[0].contains("names a list that is gone"))
    // A copy's duplicate pairs are its home's, so they leave the duplicate ledger.
    assert(closed_list_mirror_pair("h.jet\tHOME\tc.jet\tCOPY", [String]{"c.jet\tCOPY"}))
    assert(!closed_list_mirror_pair("a.jet\tX\th.jet\tHOME", [String]{"c.jet\tCOPY"}))
}

// The core suite's levels (Compiler/test.jet CORE_LEVELS, a kernel ledger
// row) copy the `optimize` row's values of the build-option table, which
// test.jet, a script that imports only Core, can't read.
CLOSED_LIST_CORE_LEVELS_PATH: "Compiler/test.jet"
CLOSED_LIST_BUILD_OPTIONS_PATH: "Compiler/JetFoundation/Source/Registry/BuildOptions.jet"

// The values of the build-option row `name` in `text`, the build-option
// table's source: the strings of its `values: [String]{…}` field, or None
// when no row has that name.
closed_list_build_option_values: fn(text: String, name: String) -> [String]? {
    loop line in text.lines() {
        if !line.trim().starts_with("{{name: \"{name}\",") -> next
        rest: policy_slice_bytes(line, closed_list_after(line, "values: [String]{{"), line.bytes().len())
        values := [String]{}
        closed_list_string_members(rest.split("}}").to_list()[0], values)
        return Val(values)
    }
    None
}

// The problem when CORE_LEVELS in `levels_text` (test.jet's source) is not
// the `optimize` row's values in `options_text`, naming both files; "" when
// it is.
closed_list_core_levels_problem: fn(levels_text: String, options_text: String) -> String {
    found := [ClosedListFinding]{}
    closed_list_findings_in(CLOSED_LIST_CORE_LEVELS_PATH, levels_text, found)
    levels := [String]{}
    loop finding in found {
        if finding.name == "CORE_LEVELS" -> levels = finding.members.copy()
    }
    values: closed_list_build_option_values(options_text, "optimize") ?? return "{CLOSED_LIST_BUILD_OPTIONS_PATH} has no `optimize` row for {CLOSED_LIST_CORE_LEVELS_PATH} CORE_LEVELS to copy"
    if levels == values -> return ""
    "{CLOSED_LIST_CORE_LEVELS_PATH} CORE_LEVELS ({levels.join(", ")}) is a copy of the `optimize` row's values in {CLOSED_LIST_BUILD_OPTIONS_PATH} ({values.join(", ")}) and no longer matches them; edit the row, then copy its values"
}

#Test("the core suite's levels are the optimize build option's values") {
    guards_enter_root()
    levels_text: closed_list_files.read(CLOSED_LIST_CORE_LEVELS_PATH) ?? panic("read {CLOSED_LIST_CORE_LEVELS_PATH}")
    options_text: closed_list_files.read(CLOSED_LIST_BUILD_OPTIONS_PATH) ?? panic("read {CLOSED_LIST_BUILD_OPTIONS_PATH}")
    assert_eq(closed_list_core_levels_problem(levels_text, options_text), "")
    options: "    {{name: \"optimize\", kind: BuildOptionKind.Choice, values: [String]{{\"none\", \"basic\", \"full\"}}, stock_build: \"basic\"}},\n"
    assert_eq(closed_list_core_levels_problem("CORE_LEVELS: [String]{{\"none\", \"basic\", \"full\"}}\n", options), "")
    drift: closed_list_core_levels_problem("CORE_LEVELS: [String]{{\"none\", \"basic\", \"full\", \"max\"}}\n", options)
    assert(drift.contains("Compiler/test.jet CORE_LEVELS (none, basic, full, max) is a copy of the `optimize` row's values in Compiler/JetFoundation/Source/Registry/BuildOptions.jet (none, basic, full)"))
}

#Test("the closed list scanner reads enums, string lists and generated headers") {
    guards_enter_root()
    found := [ClosedListFinding]{}
    closed_list_findings_in("a.jet", "Color: enum {{\n    Red Green\n    Blue(Int)\n    Custom{{ name: String }}\n\n    name: fn(self) -> String {{ \"x\" }}\n}}\nNAMES: #run {{ [String]{{\n    \"go\", \"Java\", // \"cobol\"\n    \"r\",\n}} }}\nSHORT: [String]{{\"a\", \"b\"}}\nInline: enum {{ A B C }}\nlocal: fn() {{ x: [String]{{\"p\", \"q\", \"r\"}} }}\n", found)
    assert_eq(found.len(), 3)
    assert_eq(found[0].name, "Color")
    assert_eq(found[0].members.join(","), "red,green,blue,custom")
    assert_eq(found[1].name, "NAMES")
    assert_eq(found[1].members.join(","), "go,java,r")
    assert_eq(found[2].members.join(","), "a,b,c")
    // A generated header, read from the file's first bytes, keeps its lists out of the findings.
    assert(closed_list_generated_header("// This file is generated by Tools/agent/X.jet; do not edit.\nKind: enum {{\n"))
    assert(closed_list_generated_header("// GENERATED FILE — do not hand-edit.\n"))
    assert(closed_list_generated_header("// BEGIN GENERATED CORE CALL ROWS\n"))
    assert(!closed_list_generated_header("// Generated views must be derived from this file. Do not hand-edit generated Rust\n"))
    assert(closed_list_generated_header(closed_list_header("Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet")))
    assert(!closed_list_generated_header(closed_list_header("Compiler/JetIR/Source/IR.jet")))
    pairs: closed_list_duplicate_pairs([ClosedListFinding]{found[1], ClosedListFinding{path: "c.jet", name: "Lang", members: [String]{"go", "java", "r", "lua"}}})
    assert_eq(pairs.len(), 1)
    assert_eq(closed_list_duplicate_pairs([ClosedListFinding]{found[1], ClosedListFinding{path: "a.jet", name: "Same", members: [String]{"go", "java", "r"}}}).len(), 0)
    assert_eq(closed_list_duplicate_pairs([ClosedListFinding]{found[1], ClosedListFinding{path: "c.jet", name: "Few", members: [String]{"go", "lua", "ada", "tcl"}}}).len(), 0)
    // Every pair that shares a member carries its shared count, below 80% too.
    few: closed_list_shared_pairs([ClosedListFinding]{found[1], ClosedListFinding{path: "c.jet", name: "Few", members: [String]{"go", "java", "ada", "tcl", "lua"}}})
    assert_eq(few.len(), 1)
    assert_eq(few[0].shared, 2)
    assert(!few[0].duplicate)
    // A failure names the declaration form to use instead and the kernel ledger.
    message: closed_list_new_list_problem(found[0])
    assert(message.contains("Core trait with one `impl` per member") && message.contains("--check") && message.contains(CLOSED_LIST_KERNEL_PATH))
    assert(closed_list_duplicate_problem(pairs[0]).contains("Core trait with one `impl` per member"))
}

// The syntax dictionary (`jet syntax`) keeps its rows' meanings, but each
// row's token is a copy of the syntax registry spelling the row names in
// `registry_name`: the registry (Compiler/JetFoundation/Data/Syntax) is the
// token's one hand-written home. A marker row names MARKER_SOURCE, the one
// marker registry (Compiler/Prelude/Markers.jet), whose structs are the
// marker names; Data/Syntax/Markers.jet holds marker syntax and copies none
// of them. A row whose `registry_name` is its token, or the generated
// trait-marker block's OWNED_TRAITS, copies no spelling.
CLOSED_LIST_SYNTAX_REGISTRY_DIR: "Compiler/JetFoundation/Data/Syntax"
CLOSED_LIST_SYNTAX_DICTIONARY_PATH: "Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet"
CLOSED_LIST_MARKER_REGISTRY_PATH: "Compiler/Prelude/Markers.jet"
CLOSED_LIST_MARKER_SYNTAX_PATH: "Compiler/JetFoundation/Data/Syntax/Markers.jet"

// The marker names `text` (a MARKER_SOURCE file) declares: its top-level
// `Name: struct` lines.
closed_list_marker_names: fn(text: String) -> [String:Int] {
    names := [String:Int]{}
    loop line in text.lines() {
        ident: closed_list_ident_prefix(line)
        if ident == "" || !policy_slice_bytes(line, ident.bytes().len(), line.bytes().len()).starts_with(": struct") -> next
        names[ident] = 1
    }
    names
}

// Every spelling (of the marker syntax file) that is a registered marker
// name: a second list of the registry's names.
closed_list_marker_syntax_copies: fn(spellings: [ClosedListSpelling], markers: [String:Int]) -> [String] {
    problems := [String]{}
    loop spelling in spellings {
        if markers.get(spelling.text) == None -> next
        problems.push("{spelling.path} {spelling.name} copies the marker name `{spelling.text}`; markers are named only by their struct in {CLOSED_LIST_MARKER_REGISTRY_PATH}, so delete the constant and read the registry")
    }
    problems
}

// One registry spelling: the constant's name, its literal as written, and
// its file.
ClosedListSpelling: struct {
    name: String
    text: String
    path: String
}

// The string literal that opens `text` at `start` (a `"`), as written, or
// None when it doesn't close on the line.
closed_list_literal_at: fn(text: String, start: Int) -> String? {
    bytes: text.bytes()
    if start >= bytes.len() || Int.from_u8(bytes[start]) != 34 -> return None
    end := start + 1
    loop {
        if end >= bytes.len() -> return None
        if Int.from_u8(bytes[end]) == 92 {
            end += 2
            next
        }
        if Int.from_u8(bytes[end]) == 34 -> return Val(policy_slice_bytes(text, start + 1, end))
        end += 1
    }
}

// The top-level `NAME: "text"` constants in `text`, the source of `path`.
closed_list_spellings_in: fn(path: String, text: String, out: &[ClosedListSpelling]) {
    loop line in text.lines() {
        ident: closed_list_ident_prefix(line)
        if ident == "" || !closed_list_upper_byte(ident.bytes()[0]) -> next
        width: ident.bytes().len()
        if !policy_slice_bytes(line, width, line.bytes().len()).starts_with(": \"") -> next
        literal: closed_list_literal_at(line, width + 2) ?? next
        out.push(ClosedListSpelling{name: ident, text: literal, path: path})
    }
}

// The field `name`'s literal on a dictionary row line, or None.
closed_list_row_field: fn(line: String, name: String) -> String? {
    needle: "{name}: \""
    at: closed_list_after(line, needle)
    if at >= line.bytes().len() -> return None
    closed_list_literal_at(line, at - 1)
}

// Every dictionary row in `dictionary` whose token differs from the registry
// spelling it names, or that names no spelling. A MARKER_SOURCE row's token
// is one of `markers`, the marker registry's names.
closed_list_syntax_dictionary_problems: fn(dictionary: String, spellings: [ClosedListSpelling], markers: [String:Int]) -> [String] {
    by_name := [String:Int]{}
    loop (index, spelling) in spellings -> by_name[spelling.name] = index
    problems := [String]{}
    loop line in dictionary.lines() {
        if !line.starts_with("    {{token: \"") -> next
        token: closed_list_row_field(line, "token") ?? next
        name: closed_list_row_field(line, "registry_name") ?? next
        if name == token || name == "OWNED_TRAITS" -> next
        if name == "MARKER_SOURCE" {
            if markers.get(token) == None -> problems.push("{CLOSED_LIST_SYNTAX_DICTIONARY_PATH} row `{token}` names MARKER_SOURCE, but {CLOSED_LIST_MARKER_REGISTRY_PATH} declares no `{token}` marker; the registry is the marker's one home")
            next
        }
        index: by_name.get(name) ?? -1
        if index < 0 {
            problems.push("{CLOSED_LIST_SYNTAX_DICTIONARY_PATH} row `{token}` names `{name}`, which no spelling in {CLOSED_LIST_SYNTAX_REGISTRY_DIR} declares; name the registry constant that spells the token")
            next
        }
        home: spellings[index]
        if home.text != token -> problems.push("{CLOSED_LIST_SYNTAX_DICTIONARY_PATH} row `{token}` is a copy of {home.path} {home.name} (`{home.text}`) and no longer matches it. The registry is the token's one hand-written home: edit {home.path}, then copy the spelling here.")
    }
    problems
}

#Test("each syntax dictionary token is the registry spelling it names") {
    guards_enter_root()
    spellings := [ClosedListSpelling]{}
    entries: closed_list_files.list_dir(CLOSED_LIST_SYNTAX_REGISTRY_DIR) ?? panic("list {CLOSED_LIST_SYNTAX_REGISTRY_DIR}")
    loop entry in entries {
        if !entry.name.ends_with(".jet") -> next
        path: "{CLOSED_LIST_SYNTAX_REGISTRY_DIR}/{entry.name}"
        closed_list_spellings_in(path, closed_list_files.read(path) ?? panic("read {path}"), spellings)
    }
    markers: closed_list_marker_names(closed_list_files.read(CLOSED_LIST_MARKER_REGISTRY_PATH) ?? panic("read {CLOSED_LIST_MARKER_REGISTRY_PATH}"))
    assert(markers.len() > 50, "{CLOSED_LIST_MARKER_REGISTRY_PATH} declares no marker structs")
    dictionary: closed_list_files.read(CLOSED_LIST_SYNTAX_DICTIONARY_PATH) ?? panic("read {CLOSED_LIST_SYNTAX_DICTIONARY_PATH}")
    problems: closed_list_syntax_dictionary_problems(dictionary, spellings, markers)
    loop problem in problems -> print(problem)
    assert_eq(problems.len(), 0)
    // Editing a copied token alone fails, naming the home; so does a row
    // that names no spelling, or a marker the registry doesn't declare.
    home := [ClosedListSpelling]{}
    closed_list_spellings_in("h.jet", "KW_BREAK: \"break\"\nKW_IF: \"if\" // the `if` keyword\n", home)
    assert_eq(home.len(), 2)
    assert_eq(home[1].text, "if")
    registry: closed_list_marker_names("Pre: struct {{\n    condition: Value\n}}\n// Post: struct\nPost: struct {{\n}}\n")
    assert_eq(registry.len(), 2)
    kept: "    {{token: \"break\", query: \"break\", registry_name: \"KW_BREAK\", kind: K.Keyword}},\n    {{token: \"Min\", registry_name: \"Min\"}},\n    {{token: \"Pre\", registry_name: \"MARKER_SOURCE\"}},\n"
    assert_eq(closed_list_syntax_dictionary_problems(kept, home, registry).len(), 0)
    drift: closed_list_syntax_dictionary_problems("    {{token: \"brake\", registry_name: \"KW_BREAK\"}},\n    {{token: \"when\", registry_name: \"KW_WHEN\"}},\n    {{token: \"Pree\", registry_name: \"MARKER_SOURCE\"}},\n", home, registry)
    assert_eq(drift.len(), 3)
    assert(drift[0].contains("row `brake` is a copy of h.jet KW_BREAK (`break`) and no longer matches it"))
    assert(drift[1].contains("names `KW_WHEN`, which no spelling"))
    assert(drift[2].contains("declares no `Pree` marker"))
}

#Test("the marker syntax file copies no marker name") {
    guards_enter_root()
    markers: closed_list_marker_names(closed_list_files.read(CLOSED_LIST_MARKER_REGISTRY_PATH) ?? panic("read {CLOSED_LIST_MARKER_REGISTRY_PATH}"))
    spellings := [ClosedListSpelling]{}
    closed_list_spellings_in(CLOSED_LIST_MARKER_SYNTAX_PATH, closed_list_files.read(CLOSED_LIST_MARKER_SYNTAX_PATH) ?? panic("read {CLOSED_LIST_MARKER_SYNTAX_PATH}"), spellings)
    assert(spellings.len() > 0, "{CLOSED_LIST_MARKER_SYNTAX_PATH} declares no syntax")
    problems: closed_list_marker_syntax_copies(spellings, markers)
    loop problem in problems -> print(problem)
    assert_eq(problems.len(), 0)
    // A name copied back into the syntax file fails, naming the registry.
    copied := [ClosedListSpelling]{}
    closed_list_spellings_in("m.jet", "RULE_PREFIX: \"#\"\nMARKER_PRE: \"Pre\"\n", copied)
    found: closed_list_marker_syntax_copies(copied, closed_list_marker_names("Pre: struct {{\n}}\n"))
    assert_eq(found.len(), 1)
    assert(found[0].contains("m.jet MARKER_PRE copies the marker name `Pre`"))
}
