use files: core.files

// Exact live example/diagnostic teaching predicates feature_acceptance.rs634-659.
s3_reviewed_static_guarantee_teaching: fn() {
    refinements: files.read("Examples/Types/Refinements.jet") ?? panic("refinements")
    assert(refinements.contains("distinct Int("))
    contracts: files.read("Examples/ErrorsAndEffects/Contracts/PrePost.jet") ?? panic("contracts")
    assert(contracts.contains("#Pre"))
    taint: files.read("Examples/ErrorsAndEffects/Effects/Taint.jet") ?? panic("taint")
    assert(taint.contains("#Input") && taint.contains("#Scrub(Input)"))
    budget: files.read("Examples/Modules/Packages/EffectBudget/package.jet") ?? panic("budget")
    assert(budget.contains("authority:"))
    replay: files.read("tests/ui/replayable_reaches_io.stderr") ?? panic("replay")
    assert(replay.contains("E0725") && replay.contains("Replayable"))
    bounds: files.read("tests/ui/fixed_list_index_bounds.stderr") ?? panic("bounds")
    assert(bounds.contains("E0965"))
}
#Test("static guarantee examples and diagnostic teaching stay live") {
    guards_enter_root()
    s3_reviewed_static_guarantee_teaching()
}
