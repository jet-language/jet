use decision_files: core.files

// The source scanner in decisions.rs:163-197 is Rust-only and retires.
// These five real-document tombstone assertions (rs139-148) survive it.
// Reuse the guard package's byte finder/slicer; Rust find/slice offsets are bytes.
s3_decision_is_digit: fn(byte: U8) -> Bool { Int.from_u8(byte) >= 48 && Int.from_u8(byte) <= 57 }

s3_decision_expand: fn(token: String) -> [String] {
    if !token.contains("/") -> return [String]{token}
    segments: token.split("/").to_list()
    first: segments[0]
    first_bytes: first.bytes()
    prefix_end := first_bytes.len()
    loop (index, byte) in first_bytes {
        if s3_decision_is_digit(byte) {
            prefix_end = index
            break
        }
    }
    prefix: s5_grammar_slice_bytes(first, 0, prefix_end)
    last: segments[segments.len() - 1]
    last_bytes: last.bytes()
    suffix_start := last_bytes.len()
    loop (index, byte) in last_bytes {
        if !s3_decision_is_digit(byte) {
            suffix_start = index
            break
        }
    }
    suffix: s5_grammar_slice_bytes(last, suffix_start, last_bytes.len())
    result := [String]{}
    loop segment in segments {
        digits := [U8]{}
        started := false
        loop byte in segment.bytes() {
            if !started && !s3_decision_is_digit(byte) -> next
            if !s3_decision_is_digit(byte) -> break
            started = true
            digits.push(byte)
        }
        number: String.from_bytes(digits) ?? panic("ASCII decision digits")
        result.push("{prefix}{number}{suffix}")
    }
    result
}

s3_guard_tombstone_provenance: fn() {
    docs: decision_files.read("Docs/spec/syntax-decisions.md") ?? panic("read syntax decisions")
    header: "### Superseded IDs (tombstones)"
    from: s5_grammar_find(docs, header, 0)
    assert(from >= 0, "syntax decisions missing tombstone section")
    begin: from + header.bytes().len()
    end: s5_grammar_find(docs, "## Enforcement", begin)
    assert(end >= begin, "syntax decisions missing enforcement after tombstones")
    section: s5_grammar_slice_bytes(docs, begin, end).replace("\n", " ")
    ids := [String]{}
    at := 0
    loop {
        start: s5_grammar_find(section, "**", at)
        if start < 0 -> break
        after: start + 2
        close: s5_grammar_find(section, "**", after)
        if close < 0 -> break
        bold: s5_grammar_slice_bytes(section, after, close)
        title: s5_grammar_find(bold, " — ", 0)
        id_part: if title >= 0 -> s5_grammar_slice_bytes(bold, 0, title) else -> bold
        loop comma_piece in id_part.split(",") {
            loop piece in comma_piece.split(" / ") {
                token: piece.trim().copy()
                if !token.starts_with("D-") -> next
                loop expanded in s3_decision_expand(token) {
                    if !ids.contains(expanded) -> ids.push(expanded)
                }
            }
        }
        at = close + 2
    }
    required: [String]{"D-CTMARKER1", "D-MARKERMOVE1", "D-MARKERMOVE2", "D-MARKERMOVE3", "D-MARKER-FAMILY1"}
    loop id in required {
        assert(ids.contains(id), "tombstone extraction regressed: missing {id}")
    }
}

#Test("tombstoned_decision_ids_carry_provenance_document_subclaims") {
    s3_guard_tombstone_provenance()
}

// Decision IDs live in Tower, the spec's rationale and decision logs, audits,
// research and proposals. The compiler, Core and Jetpack cite none: a comment
// or string states the rule itself, never the ID that ratified it.
DECISION_ID_FREE_ROOTS: [String]{"Compiler", "Core", "Jetpack"}

// The roots whose citations are still the backlog. Their count is printed on
// every run and may only shrink: lower DECISION_ID_BACKLOG as citations go.
DECISION_ID_BACKLOG_ROOTS: [String]{"Examples", "tests", "Tools/agent"}
DECISION_ID_BACKLOG: 1997

decision_id_upper: fn(byte: U8) -> Bool { Int.from_u8(byte) >= 65 && Int.from_u8(byte) <= 90 }

decision_id_word: fn(byte: U8) -> Bool {
    code: Int.from_u8(byte)
    s3_decision_is_digit(byte) || decision_id_upper(byte) || (code >= 97 && code <= 122) || code == 95
}

// Whether a decision ID starts at `start`: `D-` at a word start, an uppercase
// letter, then uppercase letters, digits and hyphens, ending in a digit at a
// word end (`D-SETTING-ORDER1`, `D-PIN2=A`).
decision_id_at: fn(bytes: [U8], start: Int) -> Bool {
    if start + 2 >= bytes.len() -> return false
    if Int.from_u8(bytes[start]) != 68 || Int.from_u8(bytes[start + 1]) != 45 -> return false
    if start > 0 && decision_id_word(bytes[start - 1]) -> return false
    if !decision_id_upper(bytes[start + 2]) -> return false
    end := start + 3
    loop {
        if end >= bytes.len() -> break
        byte: bytes[end]
        if !decision_id_upper(byte) && !s3_decision_is_digit(byte) && Int.from_u8(byte) != 45 -> break
        end = end + 1
    }
    last := end - 1
    loop {
        if Int.from_u8(bytes[last]) != 45 -> break
        last = last - 1
    }
    if !s3_decision_is_digit(bytes[last]) -> return false
    last + 1 < end || end >= bytes.len() || !decision_id_word(bytes[end])
}

decision_id_in_line: fn(line: String) -> Bool {
    if !line.contains("D-") -> return false
    bytes: line.bytes()
    loop index in 0..<bytes.len() {
        if decision_id_at(bytes, index) -> return true
    }
    false
}

// Every line under `path` that cites a decision ID, as `path:line`. Symbolic
// links (fixtures hold link cycles), hidden entries, installed node modules
// and build output are not source.
decision_id_lines: fn(path: String, out: &[String]) {
    if decision_files.is_symlink(path) -> return
    if decision_files.is_dir(path) {
        loop child in (decision_files.list_dir(path) ?? panic("list {path}: {err}")) {
            if child.name.starts_with(".") || child.name == "node_modules" || child.name == "target" -> next
            decision_id_lines(child.path, out)
        }
        return
    }
    text: decision_files.read(path) ?? return
    if !text.contains("D-") -> return
    loop (index, line) in text.lines() {
        if decision_id_in_line(line) -> out.push("{path}:{index + 1}")
    }
}

#Test("compiler_core_and_jetpack_cite_no_decision_ids") {
    found := [String]{}
    loop root in DECISION_ID_FREE_ROOTS {
        assert(decision_files.is_dir(root), "the decision-free root {root} must exist")
        decision_id_lines(root, found)
    }
    assert_eq(found.join("\n"), "")
    // The matcher sees a citation in a comment, a parenthesis and a string, and
    // not a word that merely contains `D-`.
    assert(decision_id_in_line("// D-SETTING-ORDER1=A: the layer order"))
    assert(decision_id_in_line("the gate (D-PIN2) holds"))
    assert(decision_id_in_line("why: \"D-NEVER1.\""))
    assert(!decision_id_in_line("CAD-PIN2 and D-pin2 and D-PIN and D-1"))
}

#Test("decision_id_citation_backlog_only_shrinks") {
    found := [String]{}
    loop root in DECISION_ID_BACKLOG_ROOTS -> decision_id_lines(root, found)
    print("decision-ID citation backlog: {found.len()} lines (baseline {DECISION_ID_BACKLOG})")
    assert(found.len() <= DECISION_ID_BACKLOG, "decision-ID citations grew past the backlog baseline {DECISION_ID_BACKLOG}:\n{found.join("\n")}")
}
