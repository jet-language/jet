module env.dev {
    services: {
        fixture: {
            enable: true,
            run: ["sh", "-c", "echo service-started; sleep 30"]
        },
        timeout: {
            enable: true,
            run: ["sh", "-c", "sleep 30 & child=$!; echo $child > child.pid; wait"],
            ready: "sleep 30"
        }
    }
}
