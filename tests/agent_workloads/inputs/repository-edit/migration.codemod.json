{
  "version": 2,
  "name": "RenamePrepare",
  "project": "project",
  "roots": [
    {"path": "examples", "validate": "clean"}
  ],
  "rules": [
    {
      "id": "rename-prepare",
      "kind": "symbol_rename",
      "from": {"name": "prepare", "symbol_kind": "function", "defined_in": "examples/main.jet"},
      "to": "configure",
      "matches": 2
    }
  ]
}
