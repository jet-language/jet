use core.process as process

#CLI
struct WorkloadArgs {
    root: String
}

fn run(args: WorkloadArgs) {
    root :: args.root
    timeout :: Duration.seconds(5) ?? panic("bad timeout")
    result :: process.cmd([
        "git",
        "-C",
        ~root,
        "-c",
        "core.quotePath=false",
        "diff",
        "--no-index",
        "--no-renames",
        "--name-status",
        "--",
        "before",
        "after"
    ])
        .timeout(timeout)
        .output_limit(1048576)
        .run() ?? panic("cannot run git diff")
    if result.timed_out -> panic("git diff timed out")
    if result.code != 0 && result.code != 1 -> panic("git diff exit {result.code}: {result.errors.trim()}")

    output :: ~result.output
    added := 0
    deleted := 0
    modified := 0
    rows := [String]{}
    // Raw git --name-status protocol: it is not RFC-4180 CSV.
    loop line in output.split("\n") {
        if line != "" {
            fields :: line.split("\t").to_list()
            if fields.len() != 2 -> panic("bad git name-status row: {line}")
            status :: fields[0]
            raw_path :: fields[1]
            pieces := [String]{}
            root_name := ""
            index := 0
            loop piece in raw_path.split("/") {
                if index == 0 -> root_name = piece else -> pieces.push(piece)
                index += 1
            }
            if root_name != "before" && root_name != "after" {
                panic("git path escaped roots: {raw_path}")
            }
            path :: pieces.join("/")
            kind := ""
            if status == {
                "A" -> {
                    kind = "added"
                    added += 1
                }
                "D" -> {
                    kind = "deleted"
                    deleted += 1
                }
                "M" -> {
                    kind = "modified"
                    modified += 1
                }
                else -> panic("bad git name-status row: {line}")
            }
            rows.push("{path}|{kind}")
        }
    }
    rows.sort()
    loop row in rows -> print(row)
    print("summary|added={added}|modified={modified}|deleted={deleted}")
}
