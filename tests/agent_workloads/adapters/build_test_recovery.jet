use core.files as fs
use core.term as io
use core.process as process
use core.time as time
use core.sys as env

#CLI
struct WorkloadArgs {
    input: String
}

fn run(args: WorkloadArgs) {
    input :: args.input
    jet :: env.get("JET_CORPUS_JET") ?? panic("missing Jet CLI")
    project := "project"
    fs.copy_dir(input, project) ?? panic("cannot copy build/test project")
    timeout :: Duration.seconds(30) ?? panic("bad timeout")

    invalid :: process.cmd([String]{~jet, "check", "{project}/invalid.jet"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(timeout)
        .run() ?? panic("invalid check could not run")
    if invalid.timed_out || invalid.code == 0 -> panic("invalid source did not fail closed")
    print("invalid=failed")

    checked :: process.cmd([String]{~jet, "check", "{project}/build_test_recovery.jet"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(timeout)
        .run() ?? panic("valid check could not run")
    if checked.timed_out || checked.code != 0 -> panic("valid source did not build")

    tested :: process.cmd([String]{~jet, "test", "--release", "{project}/build_test_recovery.jet"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(timeout)
        .run() ?? panic("valid test could not run")
    if tested.timed_out || tested.code != 0 -> panic("valid test did not pass")

    ran :: process.cmd([String]{~jet, "run", "--release", "{project}/build_test_recovery.jet"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(timeout)
        .run() ?? panic("valid test could not run")
    if ran.timed_out || ran.code != 0 -> panic("valid source run failed")
    print("recovery=ok")
    print("test={ran.output.trim()}")
    fs.remove_all(project) ?? panic("cannot clean build/test project")
}
