use core.env as env
use core.files as fs
use core.io as io
use core.process as process
use core.time as time

fn run() {
    args :: io.args()
    if args.len() != 2 { panic("usage: repository_semantic_edit INPUT_ROOT") }
    input :: args.get(1) ?? panic("missing input root")
    jet :: env.get("JET_CORPUS_JET") ?? panic("missing Jet CLI")
    project := "project"
    fs.copy_dir(input, project) ?? panic("cannot copy input project")
    object := "{project}/migration.codemod.json"
    result :: process.cmd([String].{~jet, "inspect", "codemod", "apply", object, "--yes"})
        .stdout(.Capture)
        .stderr(.Capture)
        .timeout(Duration.seconds(30) ?? panic("bad timeout"))
        .run() ?? panic("cannot run semantic codemod")
    if result.timed_out || result.code != 0 {
        panic("codemod failed: {result.errors}")
    }
    source :: fs.read("{project}/project/examples/main.jet") ?? panic("cannot read edited source")
    print(source.trim())
    fs.remove_all(project) ?? panic("cannot clean edited project")
}
