use core.files as fs
use core.encoding.csv as csv

struct Incident {
    service: String
    status: String
}

#CLI
struct WorkloadArgs {
    input: String
}

fn run(args: WorkloadArgs) {
    input :: args.input
    text :: fs.read(input) ?? panic("cannot read input")
    incidents := [Incident]{}
    services := [String]{}
    rejects := [String]{}
    rows :: csv.rows(
        text, delimiter: "\t", header: true, skip_blank: true
    ) ?? panic("cannot parse input")
    loop row in rows {
        fields :: row.fields
        line_number :: row.line
        if {
            fields.len() != 3 -> rejects.push("reject|{line_number}|field-count")
            fields.get(0) == .Val(service) -> {
                if fields.get(1) == .Val(status) {
                    if {
                        status != "ok" && status != "error" -> {
                            rejects.push("reject|{line_number}|status")
                        }
                        service == "" -> rejects.push("reject|{line_number}|service")
                        else -> {
                            if !services.contains(service) -> services.push(~service)
                            incidents.push(Incident{service: service, status: status})
                        }
                    }
                }
            }
        }
    }
    services.sort()
    print("accepted|{incidents.len()}")
    print("rejected|{rejects.len()}")
    loop reject in rejects -> print(reject)
    loop service in services {
        ok := 0
        errors := 0
        loop incident in incidents {
            if incident.service == service {
                if incident.status == "ok" -> ok += 1 else -> errors += 1
            }
        }
        print("{service}|ok={ok}|error={errors}")
    }
}
