use core.db as db
use core.encoding.csv as csv
use core.files as fs

#CLI
struct WorkloadArgs {
    input: String
}

fn run(args: WorkloadArgs) {
    input :: args.input
    text :: fs.read(input) ?? panic("cannot read input")
    conn :: db.open_memory()
    policy :: db.policy("agent_rows", "true") ?? panic("policy")
    scoped :: conn.with_policy(policy, "agent")
    _created :: db.migrate(scoped, "agent-rows-v1", [
        SQL{"CREATE TABLE agent_rows (id INTEGER PRIMARY KEY, name TEXT NOT NULL)"}
    ]) ?? panic("create")
    rows :: csv.rows(
        text, delimiter: "\t", header: true, skip_blank: true
    ) ?? panic("cannot parse input")
    loop row in rows {
        fields :: row.fields
        line_number :: row.line
        if fields.len() != 2 {
            print("invalid-row|{line_number}|field-count")
            _closed :: scoped.close()
            return
        }
        id :: Int.parse(fields[0]) ?? 0
        if id <= 0 {
            print("invalid-row|{line_number}|id")
            _closed :: scoped.close()
            return
        }
        name :: fields[1]
        _inserted :: scoped.execute(
            SQL{"INSERT INTO agent_rows (id, name) VALUES ({id}, {name})"}
        ) ?? panic("insert")
    }
    count_opt :: scoped.query_one(SQL{"SELECT COUNT(*) AS n FROM agent_rows"}) ?? panic("count")
    count_row :: count_opt ?? panic("count row")
    count :: db.row_int(count_row, "n") ?? 0
    selected_id :: 2
    selected_opt :: scoped.query_one(
        SQL{"SELECT name FROM agent_rows WHERE id = {selected_id}"}
    ) ?? panic("selected")
    selected_row :: selected_opt ?? panic("selected row")
    selected :: db.row_text(selected_row, "name") ?? "missing"
    print("rows={count}")
    print("selected={selected}")
    print("table=present")
    _closed :: scoped.close()
}
