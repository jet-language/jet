// Regression for the native lending-view helpers' nested pattern scopes.
enum LendingTypeProbe {
    Apply(name: String, args: [Int])
    Other
}
enum LendingFallbackProbe {
    Value(value: Int)
    Return(value: Int?)
    Block(body: [Bool], value: Int?)
    Other
}
enum LendingExprProbe {
    OrFallback(source: Bool, fallback: LendingFallbackProbe)
    Other
}
fn lending_item_shape(ty: LendingTypeProbe) -> Bool {
    if ty == .Apply("ViewMut", item_args) {
        if item_args.len() != 1 -> return false
    } else {
        return false
    }
    true
}
fn lending_fallback_scope(expr: LendingExprProbe) -> Bool {
    if expr == {
        .OrFallback(source_value, fallback) -> {
            if source_value -> return true
            if fallback == {
                .Value(value) -> return value > 0
                .Return(value) -> return value != None
                .Block(body, value) -> return body.len() > 0 || value != None
                else -> {}
            }
        }
        else -> {}
    }
    false
}
fn run() {
    assert(lending_item_shape(LendingTypeProbe.Apply{name: "ViewMut", args: [Int]{1}}))
    assert(!lending_item_shape(LendingTypeProbe.Apply{name: "ViewMut", args: [Int]{}}))
    assert(!lending_item_shape(LendingTypeProbe.Apply{name: "List", args: [Int]{1}}))
    assert(!lending_item_shape(LendingTypeProbe.Other))
    assert(lending_fallback_scope(LendingExprProbe.OrFallback{source: true, fallback: LendingFallbackProbe.Other}))
    assert(lending_fallback_scope(LendingExprProbe.OrFallback{source: false, fallback: LendingFallbackProbe.Value{value: 1}}))
    assert(lending_fallback_scope(LendingExprProbe.OrFallback{source: false, fallback: LendingFallbackProbe.Return{value: Val(1)}}))
    assert(lending_fallback_scope(LendingExprProbe.OrFallback{source: false, fallback: LendingFallbackProbe.Block{body: [Bool]{true}, value: None}}))
    assert(!lending_fallback_scope(LendingExprProbe.OrFallback{source: false, fallback: LendingFallbackProbe.Other}))
}
