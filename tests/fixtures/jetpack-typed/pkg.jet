// pkg.jet — declares the `server` executable package that `image.jet`'s
// `.Oci` fixture (`from: packages.server`) cross-checks against (E1267).
// Shared read-only by the `jetpack-typed` fixture directory's other `.jet`
// files too, but none of them reference `packages.*`, so this is inert there.
name:    "jetpack-typed-fixtures"
version: "0.1.0"
packages: {
    server: executable,
}
