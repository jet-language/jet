// services.jet — U12 supervised dev services, the executable spec for the
// `env.<name> { services: { … } }` map.
//
// `services:` here is jetpack's own dev-runtime tier (`jetpack services
// up/down/health/logs`, `jetpack dev`'s health gate) — a plain child process
// under `.jet/services/<name>/`, distinct from the jetos `system.*.services`
// tier above (a whole-machine service manager, Phase D). Same `Service`
// grammar either way (open record, required `enable: Bool`) — only the
// capture/interpretation differs.
//
// `redis`, `postgres`, `mysql`, `mariadb`, `nginx`, `minio`, `mailpit`/`mail`,
// `mailhog`, and `blackfire` need no `run`/`ready`/`ports` at all: their names
// match jetpack's built-in catalog, which supplies each
// start command, data-directory initialization, typed readiness, and package
// to realize. The database presets bind loopback and probe as root with the
// fresh no-password account. `worker`
// spells everything out by hand — any service jetpack doesn't know by name
// works the same way. `cache` is declared but disabled (`enable: false`):
// captured for `jetpack services logs` etc, never started.
// `adminer` is catalog-listed with typed facts, but its current package output
// needs a ratified PHP runtime/source projection before it can run.
module env.dev {
    services: {
        redis: { enable: true },
        postgres: { enable: true },
        worker: {
            enable: true,
            ports: [8080],
            run: ["worker", "--port", "8080"],
            ready: "curl -sf http://127.0.0.1:8080/health",
            data_dir: ".jet/services/worker/data",
        },
        cache: { enable: false },
    }
}
