fn acquire(handle: Shared<Int>) :> SharedGuard<Int> :: handle.guard_edit()

fn read_returned(handle: Shared<Int>) :> Int {
    guard :: acquire(handle)
    return guard.value
}

fn bump(handle: Shared<Int>) {
    guard :: handle.guard_edit()
    guard.value += 1
}

fn run() {
    handle := shared 6
    print(read_returned(handle))
    bump(handle)
    print(handle.guard_read().value)
}
