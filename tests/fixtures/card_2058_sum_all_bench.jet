// Card #2058: default `jet run` dev-lens probe.
// The first two output lines are semantic results. The last line is elapsed
// wall-clock milliseconds for 16 calls, after list construction.
// Measure with `jet run` and `jet run --release`; compile/setup time is outside
// the timed region.
use core.time as time

fn sum_all(xs: [Int]) Int -> {
    total := 0
    loop x in xs -> total += x
    return total
}

fn input() [Int] -> {
    xs := [Int]{}
    loop i in 0..<2000000 -> xs.push(1)
    return xs
}

fn repeat_sum(xs: [Int]) Int -> {
    total := 0
    loop i in 0..<16 -> total += sum_all(xs)
    return total
}

fn run() {
    xs :: input()
    first :: sum_all(xs)
    started :: time.now()
    repeated :: repeat_sum(xs)
    elapsed :: time.now() - started
    print(first)
    print(repeated)
    print(elapsed)
}
