// D-EXPANDCLI1 (card #183) CLI test fixture: exercises the `jet inspect expand`
// `inline` lens (D-INLINE-PARAM1 #Inline / #Inline(Always) contracts: one
// checked promise, one hint on a method).
struct Meters {
    value: Int

    #Inline(Always) fn plus(self, other: Int) -> Int {
        return self.value + other
    }
}

#Inline fn square(x: Int) -> Int {
    return x * x
}

fn run() {
    m :: Meters.{value: 7}
    print("{square(4)} {m.plus(3)}")
}
