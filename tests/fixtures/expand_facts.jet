// D-EXPANDCLI1 CLI test fixture: exercises the `jet inspect expand`
// `inline` lens (D-INLINE-PARAM1 #Inline / #Inline(Always) contracts: one
// checked promise, one hint on a method).
Meters: struct {
    value: Int

    #Inline(Always) plus: fn(self, other: Int) -> Int { self.value + other }
}

#Inline square: fn(x: Int) -> Int { x * x }

run: fn() {
    m: Meters{value: 7}
    print("{square(4)} {m.plus(3)}")
}
