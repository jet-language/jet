// Mock WebDriver BiDi endpoint for tests/cases/browser_bidi. Port of the std-only mock servers that
// tests/browser_bidi.rs ran on a thread: one WebSocket client, text frames, and the method of every
// request printed to stdout, one per line, in arrival order. Any protocol surprise prints to stderr
// and exits 1, the way the Rust server thread panicked and failed `server.join().unwrap()`.
//
// jet run BrowserBidiMock.jet -- <mode> <port> [spec.json]
//   Once listening, the mock writes LABEL.ready in its working directory (LABEL: the spec's basename
//   without .json, or the mode when there is no spec); a case awaits it before its client connects.
//   script      replies from spec.json (see run_script)
//   handshake   run_handshake: spec.json {"status": RESULT, "expect_session": BOOL}
//   malformed-session, event-storm, continuous-events
//   hostile-malformed, hostile-mismatched-id, hostile-protocol-error, hostile-timeout, hostile-no-cdp
//
// The mock speaks the WebSocket wire itself over a TCP socket rather than through core.net.ws: it
// must refuse unmasked or non-text client frames, read with a 100 ms readiness window, and end the
// exchange with a TCP FIN and no close frame, as the Rust servers did.
use {
    base64: core.encoding.base64
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    net: core.net
    process: core.process
    time: core.time
    core.encoding.[Dyn]
}

READY: "{{\"ready\":true,\"message\":\"ready\"}}"
WS_GUID: "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
MODES: ["script", "handshake", "malformed-session", "event-storm", "continuous-events", "hostile-malformed", "hostile-mismatched-id", "hostile-protocol-error", "hostile-timeout", "hostile-no-cdp"]

// The Rust tests had no deadline of their own; a client that never connects or stalls ends the
// case. The deadline covers only the run: the accept and every read wait at most until it.
DEADLINE_MS: 30000

// What is left of the run's deadline; the mock fails once it is spent.
remaining: fn(started: Instant) -> Duration {
    left: DEADLINE_MS - started.elapsed_millis()
    if left <= 0 -> fail("deadline: the client never finished the exchange")
    time.duration_ms(left)
}

fail: fn(message: String) -> Never { process.fail(1, "browser_bidi_mock: {message}") }

// --- bytes and text -------------------------------------------------------------------------------

// The first index at or after `from` where `needle` starts, or -1.
find: fn(hay: [U8], needle: [U8], from: Int) -> Int {
    last: hay.len() - needle.len()
    start := from
    loop start <= last {
        matched := true
        loop k in 0..<needle.len() {
            if hay[start + k] != needle[k] {
                matched = false
                break
            }
        }
        if matched -> return start
        start += 1
    }
    -1
}

contains: fn(text: String, part: String) -> Bool { find(text.bytes(), part.bytes(), 0) >= 0 }

sub: fn(raw: [U8], start: Int, end: Int) -> String {
    if end <= start -> return ""
    String.from_bytes(raw[start..<end].copy()) ?? fail("text is not UTF-8")
}

replace_all: fn(text: String, old: String, new: String) -> String {
    raw: text.bytes()
    pattern: old.bytes()
    out := ""
    start := 0
    loop {
        at: find(raw, pattern, start)
        if at < 0 -> break
        out = "{out}{sub(raw, start, at)}{new}"
        start = at + pattern.len()
    }
    "{out}{sub(raw, start, raw.len())}"
}

ascii_lower: fn(text: String) -> String {
    out := [U8]{}
    loop b in text.bytes() {
        n: Int{b}
        if n >= 65 && n <= 90 -> out.push(U8{n + 32}) else -> out.push(b)
    }
    String.from_bytes(out) ?? ""
}

// The bytes a lowercase hex digest spells.
hex_bytes: fn(digest: String) -> [U8] {
    digits: digest.bytes()
    out := [U8]{}
    index := 0
    loop index + 1 < digits.len() {
        out.push(U8{hex_value(digits[index]) * 16 + hex_value(digits[index + 1])})
        index += 2
    }
    out
}

hex_value: fn(digit: U8) -> Int {
    n: Int{digit}
    if n >= 97 -> return n - 87
    n - 48
}

// A spec file's basename without its `.json` extension.
without_json: fn(name: String) -> String {
    raw: name.bytes()
    suffix: ".json".bytes()
    if raw.len() >= suffix.len() && find(raw, suffix, raw.len() - suffix.len()) >= 0 -> return sub(raw, 0, raw.len() - suffix.len())
    name.copy()
}

// Port of field: the string or digit run after `"name":`.
field: fn(text: String, name: String) -> String {
    raw: text.bytes()
    marker: "\"{name}\":".bytes()
    at: find(raw, marker, 0)
    if at < 0 -> fail("missing {name}: {text}")
    start: at + marker.len()
    if start < raw.len() && raw[start] == (U8{34}) {
        close: find(raw, "\"".bytes(), start + 1)
        return sub(raw, start + 1, if close < 0 -> raw.len() - 1 else -> close)
    }
    end := start
    loop end < raw.len() && (Int{raw[end]}) >= 48 && (Int{raw[end]}) <= 57 -> end += 1
    sub(raw, start, end)
}

success: fn(id: String, result: String) -> String { "{{\"type\":\"success\",\"id\":{id},\"result\":{result}}}" }

record: fn(method: String) { print(method) }

// --- JSON spec ------------------------------------------------------------------------------------

lookup: fn(tree: Dyn, key: String) -> Dyn? {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == key -> return Val(entry.value.copy())
        }
    }
    None
}

child: fn(tree: Dyn, key: String) -> Dyn { lookup(tree, key) ?? Dyn.Null }

text: fn(tree: Dyn) -> String {
    if tree == {
        .Text(value) -> value.copy()
        .Int(value) -> "{value}"
        .Number(lexeme) -> lexeme.copy()
        .Bool(value) -> if value -> "true" else -> "false"
        .Null | .Float(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> json.to_string(tree) ?? ""
    }
}

items: fn(tree: Dyn) -> [Dyn] {
    if tree == .Array(list) -> return list.copy()
    [Dyn]{}
}

count: fn(tree: Dyn) -> Int {
    if tree == {
        .Int(value) -> value
        .Number(lexeme) -> Int.parse(lexeme) ?? 0
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> 0
    }
}

truthy: fn(tree: Dyn) -> Bool {
    if tree == {
        .Null -> false
        .Bool(value) -> value
        .Int(value) -> value != 0
        .Text(value) -> value != ""
        .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> true
    }
}

// --- the peer -------------------------------------------------------------------------------------

Peer: struct {
    stream: TCPStream
    buffer: [U8]
    ended: Bool
    started: Instant
}

// Read what the client has sent so far; an end of stream or a socket error ends the peer.
receive: fn(peer: &Peer) {
    chunk: if peer.stream.read(65536, deadline: remaining(peer.started)) == {
        .Ok(got) -> got
        .Err(failure) -> {
            _: remaining(peer.started)
            [U8]{}
        }
    }
    if chunk.len() == 0 {
        peer.ended = true
        return
    }
    loop b in chunk -> peer.buffer.push(b)
}

take_bytes: fn(peer: &Peer, n: Int) -> [U8] {
    loop peer.buffer.len() < n {
        if peer.ended -> fail("client closed while {n} bytes were expected")
        receive(peer)
    }
    out: peer.buffer[0..<n].copy()
    peer.buffer = peer.buffer[n..<peer.buffer.len()].copy()
    out
}

send: fn(peer: &Peer, bytes: [U8]) {
    if peer.stream.write_all(bytes) == {
        .Ok(_) -> {}
        .Err(_) -> {}
    }
}

// Port of accept_websocket.
accept: fn(peer: &Peer) {
    terminator: "\r\n\r\n".bytes()
    loop find(peer.buffer, terminator, 0) < 0 {
        if peer.ended -> fail("client closed during handshake")
        if peer.buffer.len() > 16 * 1024 -> fail("oversized handshake")
        receive(peer)
    }
    end: find(peer.buffer, terminator, 0) + 4
    request: sub(peer.buffer, 0, end)
    peer.buffer = peer.buffer[end..<peer.buffer.len()].copy()
    key := ""
    found := false
    loop line in request.split("\r\n").to_list() {
        raw: line.bytes()
        colon: find(raw, ":".bytes(), 0)
        name: if colon < 0 -> line.copy() else -> sub(raw, 0, colon)
        if !found && ascii_lower(name.trim()) == "sec-websocket-key" {
            key = sub(raw, colon + 1, raw.len()).trim()
            found = true
        }
    }
    if !found -> fail("websocket key")
    accepted: base64.encode(hex_bytes(crypto.sha1("{key}{WS_GUID}".bytes())))
    send(peer, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accepted}\r\n\r\n".bytes())
}

// Port of read_text_frame.
read: fn(peer: &Peer) -> String {
    head: take_bytes(peer, 2)
    if (Int{head[0]}).bit_and(15) != 1 -> fail("expected text frame")
    if (Int{head[1]}).bit_and(128) == 0 -> fail("client frame must be masked")
    short: (Int{head[1]}).bit_and(127)
    len := short
    if short == 126 {
        wide: take_bytes(peer, 2)
        len = Int{wide[0]} * 256 + Int{wide[1]}
    }
    if short == 127 {
        len = 0
        loop b in take_bytes(peer, 8) -> len = len * 256 + (Int{b})
    }
    mask: take_bytes(peer, 4)
    payload := take_bytes(peer, len)
    loop i in 0..<payload.len() -> payload[i] = payload[i].bit_xor(mask[i % 4])
    String.from_bytes(payload) ?? fail("text frame is not UTF-8")
}

// Port of write_text_frame.
write: fn(peer: &Peer, message: String) {
    bytes: message.bytes()
    frame := [U8]{U8{0x81}}
    if bytes.len() <= 125 {
        frame.push(U8{bytes.len()})
    } else {
        if bytes.len() > 65535 -> fail("mock response too large")
        frame.push(U8{126})
        frame.push(U8{bytes.len() /% 256})
        frame.push(U8{bytes.len() % 256})
    }
    loop b in bytes -> frame.push(b)
    send(peer, frame)
}

// Data pending within `ms`, the way run_handshake peeked with a 100ms read timeout.
pending: fn(peer: &Peer, ms: Int) -> Bool {
    if peer.buffer.len() > 0 -> return true
    if peer.ended -> return false
    readable: if net.tcp_ready(peer.stream, NetReadyInterest.Read, ms) == {
        .Ok(ready) -> net.ready_readable(ready)
        .Err(failure) -> false
    }
    if readable -> receive(peer)
    peer.buffer.len() > 0
}

// --- modes ----------------------------------------------------------------------------------------

// A REPLY resolved for one request: a list picks the method's 1-based occurrence (the last entry
// repeats) and {"if_contains": S, "then": REPLY, "else": REPLY} picks on the request text.
resolve: fn(reply: Dyn, request: String, n: Int) -> Dyn {
    if reply == .Array(list) {
        if list.len() == 0 -> fail("empty reply list")
        index: if n < list.len() -> n - 1 else -> list.len() - 1
        return resolve(list[index], request, n)
    }
    if lookup(reply, "if_contains") == .Val(needle) {
        branch: if contains(request, text(needle)) -> "then" else -> "else"
        return resolve(child(reply, branch), request, n)
    }
    reply.copy()
}

// spec: {"max": N, "stop": METHOD?, "replies": {METHOD: REPLY}, "after": {METHOD or METHOD#K: [FRAME...]},
//        "require": {METHOD: [SUBSTRING...]}, "forbid": {METHOD: [SUBSTRING...]}}
// REPLY is a result JSON string, {"frame": TEMPLATE} for a whole frame, {"if_contains": S, "then": REPLY,
// "else": REPLY}, or a list indexed by the method's 1-based occurrence (the last entry repeats).
// `{id}` names the request id and `{n}` the occurrence in results and frames. require/forbid are the
// request assertions the Rust server made before replying.
run_script: fn(peer: &Peer, spec: Dyn) {
    seen := [String: Int]{}
    stop: child(spec, "stop")
    loop _ in 0..<count(child(spec, "max")) {
        request: read(peer)
        id: field(request, "id")
        method: field(request, "method")
        record(method)
        n: (seen.get(method) ?? 0) + 1
        seen[method.copy()] = n
        configured: lookup(child(spec, "replies"), method) ?? fail("unexpected BiDi method {method}: {request}")
        loop wanted in items(child(child(spec, "require"), method)) {
            if !contains(request, text(wanted)) -> fail("{method} request lacks {text(wanted)}: {request}")
        }
        loop unwanted in items(child(child(spec, "forbid"), method)) {
            if contains(request, text(unwanted)) -> fail("{method} request carries {text(unwanted)}: {request}")
        }
        reply: resolve(configured, request, n)
        fill: fn(template: String) { replace_all(replace_all(template, "{{id}}", id), "{{n}}", "{n}") }
        write(peer, if reply == .Text(result) -> success(id, fill(result)) else -> fill(text(child(reply, "frame"))))
        after: child(spec, "after")
        loop frame in items(child(after, method)) -> write(peer, text(frame))
        loop frame in items(child(after, "{method}#{n}")) -> write(peer, text(frame))
        if stop == .Text(last) && method == last -> break
    }
}

// Port of run_handshake.
run_handshake: fn(peer: &Peer, spec: Dyn) {
    request: read(peer)
    record(field(request, "method"))
    write(peer, success(field(request, "id"), text(child(spec, "status"))))
    if truthy(child(spec, "expect_session")) {
        session: read(peer)
        record(field(session, "method"))
        write(peer, success(field(session, "id"), "{{\"sessionId\":\"codec\",\"capabilities\":{{}}}}"))
        end: read(peer)
        record(field(end, "method"))
        write(peer, success(field(end, "id"), "{{}}"))
    } else {
        if pending(peer, 100) -> record(field(read(peer), "method"))
    }
}

// Port of run_malformed_session.
run_malformed_session: fn(peer: &Peer) {
    loop result in [READY, "{{\"sessionId\":1,\"capabilities\":[]}}", "{{}}"] {
        request: read(peer)
        record(field(request, "method"))
        write(peer, success(field(request, "id"), result))
    }
}

// Port of run_event_storm.
run_event_storm: fn(peer: &Peer) {
    results: [READY, "{{\"sessionId\":\"storm\",\"capabilities\":{{}}}}", READY, "{{}}"]
    filler := ""
    loop _ in 0..<4000 -> filler = "{filler}x"
    loop command in 0..<4 {
        request: read(peer)
        id: field(request, "id")
        record(field(request, "method"))
        if command == 2 {
            loop index in 0..<300 {
                method: if index == 100 -> "SECRET_REMOTE_METHOD_{filler}" else -> "event.{index}"
                write(peer, "{{\"type\":\"event\",\"method\":\"{method}\",\"params\":{{}}}}")
            }
        }
        write(peer, success(id, results[command]))
    }
}

// Port of run_continuous_events.
run_continuous_events: fn(peer: &Peer) {
    loop result in [READY, "{{\"sessionId\":\"deadline\",\"capabilities\":{{}}}}"] {
        request: read(peer)
        record(field(request, "method"))
        write(peer, success(field(request, "id"), result))
    }
    record(field(read(peer), "method"))
    loop index in 0..<60 {
        write(peer, "{{\"type\":\"event\",\"method\":\"network.tick{index}\",\"params\":{{}}}}")
        time.sleep(time.duration_ms(5))
    }
    request: read(peer)
    record(field(request, "method"))
    write(peer, success(field(request, "id"), "{{}}"))
}

// Port of run_hostile and its HostileReply arms.
run_hostile: fn(peer: &Peer, mode: String) {
    request: read(peer)
    record(field(request, "method"))
    id: field(request, "id")
    if mode == {
        "hostile-malformed" -> write(peer, "{{not-json")
        "hostile-mismatched-id" -> write(peer, "{{\"type\":\"success\",\"id\":{(Int.parse(id) ?? 0) + 1},\"result\":{{}}}}")
        "hostile-protocol-error" -> write(peer, "{{\"type\":\"error\",\"id\":{id},\"error\":\"invalid argument\",\"message\":\"SECRET SERVER DATA\",\"stacktrace\":\"SECRET STACK\"}}")
        "hostile-timeout" -> time.sleep(time.duration_ms(500))
        else -> {
            write(peer, success(id, READY))
            session: read(peer)
            if field(session, "method") != "session.new" -> fail("expected session.new: {session}")
            if !contains(session, "\"capabilities\":{{\"alwaysMatch\":{{}}}}") -> fail("session.new without empty alwaysMatch: {session}")
            write(peer, success(field(session, "id"), "{{\"sessionId\":\"no-cdp\",\"capabilities\":{{\"goog:cdp\":false}}}}"))
        }
    }
}

run: fn() {
    args: process.args()
    mode: args.get(0) ?? fail("usage: BrowserBidiMock.jet MODE PORT [SPEC.json]")
    port: Int.parse(args.get(1) ?? fail("usage: BrowserBidiMock.jet MODE PORT [SPEC.json]")) ?? fail("port is not a number")
    spec_path: args.get(2)
    spec: if spec_path == .Val(path) -> json.parse(files.read(path) ?? fail("read {path}: {err}")) ?? fail("parse {path}: {err}") else -> Dyn.Null
    if !MODES.contains(mode) -> fail("unknown mode {mode}")

    started: time.instant()
    listener: net.tcp_listen("127.0.0.1:{port}") ?? fail("listen on {port}: {err}")
    label: if spec_path == .Val(path) -> without_json(files.basename(path)) else -> mode.copy()
    files.write("{label}.ready", "") ?? fail("write {label}.ready: {err}")
    stream: listener.accept(deadline: remaining(started)) ?? {
        _: remaining(started)
        fail("accept: {err}")
    }
    peer := Peer{stream: stream, buffer: [U8]{}, ended: false, started: started}
    accept(peer)
    if mode == {
        "script" -> run_script(peer, spec)
        "handshake" -> run_handshake(peer, spec)
        "malformed-session" -> run_malformed_session(peer)
        "event-storm" -> run_event_storm(peer)
        "continuous-events" -> run_continuous_events(peer)
        else -> run_hostile(peer, mode)
    }
    if peer.stream.shutdown(NetShutdown.Write) == {
        .Ok(_) -> {}
        .Err(_) -> {}
    }
}
