// Card #2058: internal JIT/AOT tier diagnostic; default `jet run` dev-lens probe.
// This workload compares Jet's default and release tiers on the same source.
// It is not a cross-language benchmark and must not support competitive claims.
// No Rust or non-Rust peer rails are declared for this fixture.
// The first two output lines are semantic results. The last line is elapsed
// wall-clock milliseconds for 16 calls, after list construction.
// The trace witness must show `sum_all` resident; its hot loop is the direct
// integer-list lowering, while the outer repeat range keeps cancellation polls.
// Measure with `jet run` and `jet run --release`; compile/setup time is outside
// the timed region.
use time: core.time

sum_all: fn(xs: [Int]) -> Int {
    total := 0
    loop x in xs -> total += x
    return total
}

input: fn() -> [Int] {
    xs := [Int]{}
    loop i in 0..<2000000 -> xs.push(1)
    return xs
}

repeat_sum: fn(xs: [Int]) -> Int {
    total := 0
    loop i in 0..<16 -> total += sum_all(xs)
    return total
}

run: fn() {
    xs: input()
    first: sum_all(xs)
    started: time.now()
    repeated: repeat_sum(xs)
    elapsed: time.now() - started
    print(first)
    print(repeated)
    print(elapsed)
}
