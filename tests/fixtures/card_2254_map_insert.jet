// Card #2254: non-corpus map-update and unique-access witness.
fn run() {
    keys := [String]{}
    loop _i in 0..<100000 {
        keys.push("hot")
    }
    counts := [String:Int]{}
    loop key in keys {
        counts[key] = (counts.get(key) ?? 0) + 1
    }
    print(counts.get("hot") ?? 0)
}
