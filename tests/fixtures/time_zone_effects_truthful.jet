// Named-zone lookup is civil policy: Env and FS.Read, never ambient Time.
use {
    core: core
    time: core.time
    tz: core.time
    core.time.[zone, parse_zoned]
}

configured: fn(name: String) -[Env, FS.Read]> Zone TimeError! { time.zone(name) }
parsed: fn(text: String) -[Env, FS.Read]> ZonedDateTime TimeError! { time.parse_zoned(text) }
qualified: fn(name: String) -[Env, FS.Read]> Zone TimeError! { core.time.zone(name) }
aliased: fn(name: String) -[Env, FS.Read]> Zone TimeError! { tz.zone(name) }
imported: fn(name: String) -[Env, FS.Read]> Zone TimeError! { zone(name) }
qualified_parse: fn(text: String) -[Env, FS.Read]> ZonedDateTime TimeError! { core.time.parse_zoned(text) }
aliased_parse: fn(text: String) -[Env, FS.Read]> ZonedDateTime TimeError! { tz.parse_zoned(text) }
imported_parse: fn(text: String) -[Env, FS.Read]> ZonedDateTime TimeError! { parse_zoned(text) }
fixed: fn() -[]> Zone Never! { time.utc() }
timestamp: fn(text: String) -[]> DateTime TimeError! { time.parse_rfc3339(text) }
run: fn() {}
