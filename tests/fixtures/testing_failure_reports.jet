use core.testing as testing

#Test("missing golden") {
    assert(testing.golden("tests/fixtures/testing_failure_reports.missing", "actual\n"))
}

#Test("unreadable golden") {
    assert(testing.golden("tests/fixtures", "actual\n"))
}

#Test("mismatched golden") {
    assert(testing.golden("tests/fixtures/testing_failure_reports.golden", "actual\n"))
}

#Test("missing fixture") {
    assert_eq(testing.fixture("tests/fixtures/testing_failure_reports.missing"), "expected\n")
}
