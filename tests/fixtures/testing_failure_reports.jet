use core.testing as testing

#Test("missing golden") {
    require(testing.golden("tests/fixtures/testing_failure_reports.missing", "actual\n"));
}

#Test("unreadable golden") {
    require(testing.golden("tests/fixtures", "actual\n"));
}

#Test("mismatched golden") {
    require(testing.golden("tests/fixtures/testing_failure_reports.golden", "actual\n"));
}

#Test("missing fixture") {
    require_eq(testing.fixture("tests/fixtures/testing_failure_reports.missing"), "expected\n");
}
