// D-COV1 fixture: `used(true)` is exercised by the test; `unused` is not.
// Coverage reports one HIT and one MISS for functions and branch outcomes.
fn used(flag: Bool) => Int {
    if flag { return 1 }
    return 0
}
fn unused() => Int = 2
fn run() {
    print("cov")
}
#Test("exercise used") {
    require_eq(used(true), 1)
}
