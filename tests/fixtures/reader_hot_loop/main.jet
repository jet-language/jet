use core.process as process

fn run() {
    n :: Int.parse(process.argv().get(1) ?? "1000000") ?? 1000000
    data :: "A".repeat(n).bytes()
    reader :: Reader.over(data)
    total := Int{0}
    loop _ in 0..<n {
        byte :: reader.read_u8() ?? return Err("short reader")
        total += Int.from_u8(byte)
    }
    keep(total)
    print(total)
}
