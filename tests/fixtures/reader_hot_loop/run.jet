#CLI
ReaderArgs: struct {
    n: Int{1000000}
}

run: fn(args: ReaderArgs) Err! {
    n: args.n
    data: "A".repeat(n).bytes()
    reader: Reader.over(data)
    total := Int{0}
    loop _ in 0..<n {
        byte: reader.read_u8() ?? return
        total += Int{byte}
    }
    keep(total)
    print(total)
}
