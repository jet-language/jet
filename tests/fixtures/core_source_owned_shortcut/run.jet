// Run this exact fixture with `jet run --interpret run.jet` and normal `jet run`.
// Both calls must execute their Jet source bodies, not retired Ambient rows.
use core.ui.host as host
use core.ui.host.shortcuts as shortcuts
fn run() {
    key :: host.shortcut(" ΑΣ ", host.UIShortcutModifiers{}) ?? panic("valid shortcut rejected")
    assert(key.key == "ας")
    bound :: shortcuts.binding(key, " ") ?? panic("space action rejected")
    assert(bound.action == " " && bound.node == None)
    if host.shortcut(" \t\n", host.UIShortcutModifiers{}) == {
        .Err(error) -> if error == {
            .InvalidRequest(message) -> assert(message == "shortcut key must not be empty")
            else -> panic("empty shortcut did not retain its typed source error")
        }
        else -> panic("empty shortcut did not retain its typed source error")
    }
    print("source shortcut and binding: pass")
}
