// D-LAYOUT-FACTS1=B: the CLI projects the same typed layout model used by
// focused `T.$layout` and full reflection.
struct PlainPacket {
    count: Int
    label: String
}

#Layout(c)
struct CPacket {
    count: U32
    flag: U8
}

#Layout(columnar)
struct ColumnPacket {
    count: Int
    label: String
}

enum PacketState {
    Ready
    Failed(String)
}

fn run() {}
