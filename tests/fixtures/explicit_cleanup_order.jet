// Shared Rust/Jet lowering witness: only explicit process exit/stop ordering.
// Ordinary return, Err, panic and cancellation are not ordering oracles here.
package: {
    name: "explicit_cleanup_order"
    authority: { allow: [Exec, Env, IO, Mem.Alloc] }
}
use {
    process: core.process
    os: core.sys
    scope: core.mem.scope
}

Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}
exit_case: fn() {
    first := Resource{name: "first"}
    defer close(first)
    _guard_1: scope.guard(fn() { print("guard 1") })
    second := Resource{name: "second"}
    defer close(second)
    _guard_2: scope.guard(fn() { print("guard 2") })
    process.exit(0)
}
stop_case: fn() {
    first := Resource{name: "first"}
    defer close(first)
    _guard_1: scope.guard(fn() { print("guard 1") })
    second := Resource{name: "second"}
    defer close(second)
    _guard_2: scope.guard(fn() { print("guard 2") })
    #Unsafe("exercise the explicit process-stop cleanup boundary") {
        os.stop(0)
    }
}
run: fn() {
    args: process.args()
    if args.len() > 0 -> stop_case() else -> exit_case()
}
