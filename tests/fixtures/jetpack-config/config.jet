// config.jet — the jetos master config (U11–U16, U18), the executable spec for
// `jet os build host` / `jet os switch host`.
//
// A `config.jet` declares one or more `System`s — whole machines, each a typed
// `target` platform, a `packages` list (U6 Pkg sugar), a keyed `services` map of
// open `Service` records (U12), and an ordered `options` list of dotted key/value
// entries (U13). `jet os <verb> <host>` selects the
// `System` named `<host>` and realizes it into a system generation.
//
// Packages here come from a first-party `core` source (a local repo carrying a
// `pkg.jet`), so `jet os build halcyon` realizes the whole machine
// offline with no Nix.
module halcyon {
    sources: {
        mine: path@./jet-pkgs,
    }
    system.halcyon: {
        target: linux.x64,
        packages: [mine.[hello, btop]],
        services: {
            openssh: { enable: true, ports: [22] },
        },
        options: [
            network.hostName: halcyon,
            filesystem.timeZone: "Europe/London",
        ],
    }
}
