// config.jet — the jetos master config (U11–U16, U18), the executable spec for
// `jet os build host` / `jet os switch host`.
//
// A `config.jet` declares one or more `System`s — whole machines, each a typed
// `target` platform, a `packages` list (U6 Pkg sugar), a keyed `services` map of
// open `Service` records (U12), and an ordered `options` list of dotted key/value
// entries (U13). `jet os <verb> <host>` selects the
// `System` named `<host>` and realizes it into a system generation.
//
// Packages here come from a first-party `core` source (a local repo carrying a
// `pkg.jet`), so `jet os build halcyon` realizes the whole machine
// offline with no Nix.
module halcyon {
    sources: {
        mine: path@./jet-pkgs,
    }
    system.halcyon: {
        target: linux.x64,
        packages: [mine.[hello, btop]],
        services: {
            openssh: { enable: true, ports: [22], hardening: "network-service", journal: "persistent" },
            backup: { enable: true, exec: "/run/current-system/sw/bin/hello", timer: "daily", tmpfiles: "d /var/lib/backup 0750 root root -" },
            metrics: { enable: true, exec: "/run/current-system/sw/bin/btop", socket: "127.0.0.1:9999" },
        },
        options: [
            network.hostName: halcyon,
            network.interface: "enp0s1",
            network.address: "192.0.2.10/24",
            network.gateway: "192.0.2.1",
            network.dns: ["1.1.1.1", "8.8.8.8"],
            network.firewall.allowedTcpPorts: [22, 443],
            network.wireless.ssid: "JetLab",
            filesystem.timeZone: "Europe/London",
            filesystem.swap.fast.device: "/dev/disk/by-label/swap",
            filesystem.swap.fast.priority: 5,
            users.nate.normal: true,
            users.nate.home: "/home/nate",
            users.nate.shell: packages.hello,
            user.nate.packages: [packages.hello, packages.btop],
            user.nate.services: ["syncthing"],
            user.nate.files.ghosttyConfig: "home/ghostty/config",
            groups.wheel.members: [users.nate],
            secrets.wifi.source: "secrets/wifi.age",
            storage.disk.main.device: "/dev/sda",
            storage.disk.main.table: .GPT,
            storage.disk.main.partitions.esp.size: "512M",
            storage.disk.main.partitions.root.size: "rest",
            storage.filesystem.root.type: .Btrfs,
            storage.ephemeralRoot: true,
            storage.persist.home.path: "/home/nate",
            storage.persist.varLib.path: "/var/lib",
            boot.loader: .Limine,
            boot.kernel: .CachyOS,
            boot.kernel.profile: .CachyOSLatest,
            boot.kernel.params: ["quiet"],
            boot.initrd.modules: ["virtio_blk", "ext4"],
            boot.initrd.systemd: true,
            boot.initrd.verbosity: "quiet",
            boot.loader.limine.maxGenerations: 7,
            boot.loader.efi.canTouchVariables: false,
            kernel.firmware: ["iwlwifi"],
            kernel.drivers: ["amdgpu", "nvme"],
            hardware.halcyon.profile: "framework-13-amd",
            hardware.halcyon.specialisation.plasmaBeta: true,
            performance.profile: .Gaming,
            performance.sysctl.vm.swappiness: 10,
            performance.zram.memoryPercent: 50,
            performance.scheduler: .ScxLavd,
            init.defaultTarget: "graphical.target",
            services.desktop.profile: .Default,
            services.displayManager: "sddm",
            services.displayManager: "gdm",
            services.displayManager.tier: .Force,
            services.audio.pipewire.enable: true,
            services.audio.rtkit.enable: true,
            services.desktop.plasma.enable: true,
            services.localization.locale: "en_US.UTF-8",
            services.localization.keyboardLayout: "us",
            services.xdg.mime.textHtml: "zen.desktop",
            services.fonts.packages: ["Inter", "JetBrainsMono"],
            services.virtualization.libvirtd.enable: true,
            services.virtualization.spice.enable: true,
            services.virtualization.swtpm.enable: true,
            services.virtualization.usbredir.enable: true,
            services.gaming.steam.enable: true,
            services.gaming.gamemode.enable: true,
            services.gaming.proton.enable: true,
            services.smartcard.pcscd.enable: true,
            apps.appimage.binfmt.enable: true,
            health.openssh.command: "systemctl is-active openssh",
            packages.overlay.nixpkgs: "overlays/nixpkgs.jet",
            packages.specialArgs.hostClass: "workstation",
            packages.disabledModules: ["stylix.kmscon"],
            packages.channel: "stable",
            theme.name: "halcyon",
            theme.polarity: .Dark,
            theme.wallpaper: "wallpapers/forest.png",
            theme.fonts.ui: "Inter",
            theme.palette.accent: "#7aa2f7",
            apps.flatpak.remotes.flathub: "https://flathub.org/repo/flathub.flatpakrepo",
            apps.flatpak.reconcile: .Exact,
            apps.flatpak.app.discord.ref: "com.discordapp.Discord",
            apps.flatpak.app.discord.permissions.filesystem: .Downloads,
            apps.appimage.app.obsidian.path: "/opt/apps/Obsidian.AppImage",
            apps.appimage.app.obsidian.integrate: true,
            apps.program.git.userName: "Nate",
            apps.program.git.userEmail: "nate@example.test",
            apps.program.git.signingKey: "ABC123",
            apps.program.ghostty.theme: "halcyon",
            apps.program.helix.theme: "halcyon",
            apps.program.vscode.extensions: ["rust-lang.rust-analyzer", "jet.jet"],
            apps.program.vscode.settings.editorFontFamily: "Inter",
            apps.program.cursor.extensions: ["jet.jet"],
            apps.program.discord.source: apps.flatpak.app.discord,
            apps.program.spicetify.theme: "halcyon",
            apps.program.browser.zen.policy.DisableTelemetry: true,
            workload.web.backend: .Container,
            workload.web.image: "ghcr.io/example/web",
            workload.web.ports: [8080],
            workload.web.mounts: ["/srv/web:/srv/web:ro"],
            workload.web.secrets: ["web-token"],
            workload.web.resources.memory: "512M",
            workload.web.resources.cpus: 2,
            workload.web.health.command: "test -f $JETOS_WORKLOAD_LOG",
            workload.web.rollback.keep: 3,
            workload.web.command: "echo workload >> $JETOS_WORKLOAD_LOG",
            workload.sandbox.backend: .MicroVM,
            workload.sandbox.package: "/boot/kernel",
            workload.sandbox.microvm.memory: "2048M",
            workload.sandbox.microvm.cpus: 2,
            workload.sandbox.health.command: "true",
            deploy.host.halcyon.pushCommand: "echo push >> $JETOS_DEPLOY_LOG",
            deploy.host.halcyon.proofCommand: "echo proof >> $JETOS_DEPLOY_LOG",
            deploy.host.halcyon.switchCommand: "echo switch >> $JETOS_DEPLOY_LOG",
            deploy.host.halcyon.healthCommand: "echo health >> $JETOS_DEPLOY_LOG",
            deploy.host.halcyon.rollbackCommand: "echo rollback >> $JETOS_DEPLOY_LOG",
            deploy.generations.keep: 2,
            deploy.autoUpgrade.enable: true,
            deploy.autoUpgrade.schedule: "daily",
        ],
    }
    image.installer: {
        from: system.halcyon,
        format: iso,
    }
    fleet.home: {
        hosts: {
            halcyon: system.halcyon,
        },
    }
}
