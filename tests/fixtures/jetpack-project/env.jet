// env.jet — a Jetpack dev environment (Jet's flake equivalent).
//
// Phase 1 directive surface (D-JPK3) with named sources (D-JPK17): declare
// sources as named values, then use the names inline with the same
// `package@source` ref syntax used everywhere else.
//
//   jetpack run                 # enter the shell with both packages
//   jetpack add fd@unstable     # append fd from the unstable source
//   jetpack build               # realize without entering
use jetpack as pkg
pub fn shell() => [JSON] :: [pkg.source("stable", "NixOS/nixpkgs/nixos-24.05@github"), pkg.source("unstable", "NixOS/nixpkgs/nixpkgs-unstable@github"), pkg.source("mine", "./jet-pkgs", "core"), pkg.packages(["ripgrep@stable", "neovim@unstable", "hello@mine"]), pkg.prompt("jetpack")]