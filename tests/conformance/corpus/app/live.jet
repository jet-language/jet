// core-conformance: app.live
use {
    application: app
    core.reactive.loadable.[Loadable]
}

#Error
LoadError: enum {
    Negative
}

load: fn(id: Int) -[DB.Read]> Int LoadError! {
    if id < 0 -> return Err(LoadError.Negative)
    id * 10
}

shown: fn(state: Loadable<Int, LoadError>) -> String {
    if state == {
        .Loaded(value) -> "loaded {value}"
        .Failed(_) -> "failed"
        else -> "pending"
    }
}

run: fn() {
    binding: application.live(load, 4)
    print(shown(application.state(binding)))
}
