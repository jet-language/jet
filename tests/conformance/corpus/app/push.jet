// core-conformance: app.push
use {
    application :: app
    core.reactive.loadable.[Loadable]
}

#Error
enum ReadError {
    Offline
}

fn reading(sensor: String) -> Int ReadError! {
    if sensor == "" -> return Err(ReadError.Offline)
    sensor.len()
}

fn shown(state: Loadable<Int, ReadError>) -> String {
    if state == {
        .Loaded(value) -> "loaded {value}"
        .Failed(_) -> "failed"
        else -> "pending"
    }
}

fn run() {
    binding :: application.subscribe(reading, "cpu")
    application.push(reading, "cpu", value: 7)
    print(shown(application.state(binding)))
}
