// core-conformance: core.auth.oauth_finish
package {
    name: "conformance_auth_oauth_finish"
    version: "0.1.0"
    authority: { holds: { allow: [Env, IO, Mem.Alloc, Rand] } }
}
use core.auth as auth

fn run() {
    print(auth.session_id(auth.oauth_finish("state", "alice", 1_700_000_000_000, 3_600_000) ?? panic("oauth rejected")))
}
