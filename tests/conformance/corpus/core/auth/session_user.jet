package {
    name: "conformance_auth_session_user"
    version: "0.1.0"
    authority: { holds: { allow: [IO, Mem.Alloc, Rand] } }
}
// core-conformance: core.auth.session_user
use core.auth as auth

fn run() {
    auth.register_user("alice", "argon2id:demo") ?? panic("register")
    session :: auth.password_login("alice", "argon2id:demo", 1_700_000_000_000, 3_600_000) ?? panic("login")
    result :: auth.session_user(session)
    print(result)
}
