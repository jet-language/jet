// core-conformance: core.auth.password_login
package {
    name: "conformance_auth_password_login"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Rand] }
}
use core.auth as auth

fn run() {
    auth.register_user("alice", "argon2id:demo") ?? panic("register")
    session :: auth.password_login("alice", "argon2id:demo", 1_700_000_000_000, 3_600_000) ?? panic("login")
    print(auth.session_user(session))
}
