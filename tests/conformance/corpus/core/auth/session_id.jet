// core-conformance: core.auth.session_id
use core.auth as auth
use core.text as text

fn run() {
    auth.register_user("alice", "argon2id:demo") ?? panic("register")
    session :: auth.password_login("alice", "argon2id:demo", 1_700_000_000_000, 3_600_000) ?? panic("login")
    result :: auth.session_id(session)
    print(text.byte_count(result) > 0)
}
