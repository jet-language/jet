// core-conformance: core.data.left_join
use data: core.data

LeftRow: struct {
    key: String
}

RightRow: struct {
    key: String
}

run: fn() {
    left: [LeftRow]{LeftRow{key: "a"}, LeftRow{key: "b"}}
    right: [RightRow]{RightRow{key: "b"}}
    joined: data.left_join(left, right, fn(left_row) { left_row.key }, fn(right_row) { right_row.key }) ?? panic("join")
    print(joined.len())
}
