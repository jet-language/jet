// core-conformance: core.data.query
use core.data as data

#Codable
struct Sale {
    item: String
    quantity: Int
}

fn run() {
    rows :: [Sale]{
        Sale{item: "small", quantity: 1},
        Sale{item: "large", quantity: 3}
    }
    query :: data.query(rows).filter(row -> row.quantity > 1)
    result :: query.collect() ?? panic("collect")
    print(result[0].item)
}
