// core-conformance: core.data.plot.line_text
use core.data.plot as plot

fn run() {
    groups :: [Group<String, Float>]{Group{key: "A", value: 1.5}}
    options :: DataLineOptions{
        title: "Values",
        x_label: "x",
        y_label: "y",
        markers: true,
        reference: Val(1.5),
        style: "solid",
        color: "#2f6f73",
        legend: "value"
    }
    result :: plot.line_text(groups, options) ?? panic("line text")
    print(result.len())
}
