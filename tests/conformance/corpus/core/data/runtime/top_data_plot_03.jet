use core.data.runtime.top_data_plot_03 as plot
use core.data.runtime.top_data_plot.[JetDataPlotValue, JetDataPlotField]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3731-3756
#Test("plot_json_and_identity_escaping_preserve_order") {
    assert(plot.jet_data_plot_json_escape("a\"b\\c\n\r\t") == "a\\\"b\\\\c\\n\\r\\t")
    assert(plot.jet_data_plot_json_escape("é") == "é")
    assert(plot.jet_data_plot_escape("\\;|,=") == "\\\\\\;\\|\\,\\=")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:3758-3777
#Test("plot_number_normalizes_negative_zero_and_names_nonfinite") {
    assert(plot.jet_data_plot_number(-0.0) == plot.jet_data_plot_number(0.0))
    assert(plot.jet_data_plot_number(F64.NAN) == "NaN")
    assert(plot.jet_data_plot_number(F64.INFINITY) == "inf")
    assert(plot.jet_data_plot_number(F64.NEG_INFINITY) == "-inf")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4301-4430
#Test("plot_empty_bounds_and_coordinate_clamping") {
    field :: JetDataPlotField{id: "value", name: "value", type_name: "F64"}
    bounds :: plot.jet_data_plot_numeric_bounds([], &field, None)!
    assert(bounds == (0.0, 1.0))
    assert(plot.jet_data_plot_svg_x(&JetDataPlotValue.Number(2.0), None, [], 0.0, 1.0, 10.0, 100.0) == 110.0)
    assert(plot.jet_data_plot_svg_x(&JetDataPlotValue.Number(-1.0), None, [], 0.0, 1.0, 10.0, 100.0) == 10.0)
    assert(plot.jet_data_plot_svg_x(&JetDataPlotValue.Text("b"), None, ["a", "b"], 0.0, 1.0, 10.0, 100.0) == 85.0)
    assert(plot.jet_data_plot_svg_y(&JetDataPlotValue.Number(0.0), None, 0.0, 1.0, 20.0, 100.0) == 120.0)
    assert(plot.jet_data_plot_svg_y(&JetDataPlotValue.Number(1.0), None, 0.0, 1.0, 20.0, 100.0) == 20.0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/DataPlot.rs:4885-4895
#Test("plot_palette_uses_bytewise_wrapping_131_hash") {
    assert(plot.jet_data_plot_palette_color("") == "#2563eb")
    assert(plot.jet_data_plot_palette_color("a") == "#dc2626")
    assert(plot.jet_data_plot_palette_color("ab") == "#0891b2")
}
