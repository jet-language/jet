// core-conformance: core.data.csv_reader
use {
    data: core.data
    stream: core.data.stream
    files: core.files
}

#Codable
Record: struct {
    value: Int
}

run: fn() {
    input: files.open("/dev/null") ?? panic("open")
    limits := data.DataLimits.safe()
    reader := data.csv_reader<Record>(input, limits) ?? panic("reader")
    if stream.next(reader) == {
        .Ok(first) -> print(first == None)
        .Err(error) -> panic("next: {error}")
    }
}
