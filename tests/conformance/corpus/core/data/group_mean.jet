// core-conformance: core.data.query.group_by.mean
use core.data as data

struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    rows :: [Ticket]{
        Ticket{team: "Core", minutes: 4.0},
        Ticket{team: "Core", minutes: 8.0}
    }
    groups :: data.query(rows)
        .group_by(ticket -> ticket.team)
        .mean(ticket -> ticket.minutes)
        .collect() ?? panic("group mean")
    print(groups[0].value)
}
