// core-conformance: core.data.line_text
use data: core.data

Sale: struct {
    month: String
    value: Float
}

run: fn() {
    rows: [Sale]{
        Sale{month: "Jan", value: 4.0},
        Sale{month: "Feb", value: 6.0}
    }
    groups: data.query(rows)
        .group_by(fn(sale) { sale.month })
        .mean(fn(sale) { sale.value })
        .collect() ?? panic("groups")
    options: DataLineOptions{
        title: "Sales",
        x_label: "month",
        y_label: "value",
        markers: true,
        reference: Val(5.0),
        style: "solid",
        color: "#2f6f73",
        legend: "value"
    }
    result: data.line_text(groups, options) ?? panic("line text")
    print(result)
}
