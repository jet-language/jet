// core-conformance: core.data.json_reader
use {
    data :: core.data
    stream :: core.data.stream
    files :: core.files
}

#Codable
struct Record {
    value: Int
}

fn run() {
    input :: files.open("/dev/null") ?? panic("open")
    limits := data.DataLimits.safe()
    reader := data.json_reader<Record>(^input, limits) ?? panic("reader")
    if stream.next(&reader) == {
        .Ok(first) -> print(first == None)
        .Err(error) -> panic("next: {error}")
    }
}
