// core-conformance: core.data.query.sort_by
struct Meeting {
    when: String
    name: String
}

fn run() {
    meetings := [Meeting]{
        Meeting{when: "2024-02", name: "later"},
        Meeting{when: "2024-01", name: "first"},
        Meeting{when: "2024-01", name: "second"}
    }
    meetings.sort_by(.when)
    print("{meetings[0].when}:{meetings[0].name},{meetings[1].when}:{meetings[1].name},{meetings[2].when}:{meetings[2].name}")
}
