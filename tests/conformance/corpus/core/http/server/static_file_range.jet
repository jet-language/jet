// core-conformance: core.http.server.static_file_range
use core.http.client as client
use core.http.server as server

fn run() {
    request :: client.request("GET", "http://127.0.0.1/")
    print(server.static_file_range(request, "/__jet_conformance_missing_static_file__", "text/plain") ? ok -> false ! error -> true)
}
