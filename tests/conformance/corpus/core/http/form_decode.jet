// core-conformance: core.http.form_decode
use api: core.http

run: fn() {
    form: api.form_decode("name=%FF+&x=%41&path=%252F&bad=%QZ")
    print(api.query_get(form, "name") ?? "missing")
    print(api.query_get(form, "x") ?? "missing")
    print(api.query_get(form, "path") ?? "missing")
    print(api.query_get(form, "bad") ?? "missing")
}
