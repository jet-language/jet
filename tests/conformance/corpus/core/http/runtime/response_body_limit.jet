// #4431 widened by Main to parse_response: exercise the actual Core parser and
// native HTTPResponse. HTTPMessage.rs:4,699–716 supplies the inclusive 1 MiB
// cap; the body length is rejected before any body copy. Core's existing
// head/status/header/framing precedence is preserved, not #4428 parity.
use core.http as http_response_limit_api

fn http_response_limit_raw(head: String, size: Int, byte: U8) -> [U8] Never! {
    raw := head.bytes()
    loop i in 0..<size {
        &raw.push(byte)
    }
    raw
}

fn http_response_limit_error(raw: [U8]) -> String Never! {
    if http_response_limit_api.parse_response("http://example.test/", raw) == {
        .Ok(_) -> return "Ok"
        .Err(error) -> {
            if error == {
                .BodyTooLarge(limit) -> return "BodyTooLarge:{limit}"
                .Protocol(version) -> return "Protocol:{version}"
                .InvalidStatus -> return "InvalidStatus"
                .InvalidHeader -> return "InvalidHeader"
                .InvalidFraming -> return "InvalidFraming"
                .UnsupportedEncoding -> return "UnsupportedEncoding"
                else -> return "unexpected error"
            }
        }
        else -> return "unexpected outcome"
    }
}

fn http_response_limit_text(raw: [U8]) -> String Never! {
    resp :: http_response_limit_api.parse_response("http://example.test/", raw) ?? return "parse failed"
    resp.text() ?? "text failed"
}

#Test("response exact byte cap is accepted with intact body") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    raw :: http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 1048576{cr}\n{cr}\n", 1048576, U8{97})
    resp :: http_response_limit_api.parse_response("http://example.test/", raw) ?? panic("cap response failed")
    assert_eq(resp.status(), 200)
    bytes :: (resp.text() ?? "text failed").bytes()
    assert_eq(bytes.len(), 1048576)
    assert_eq(bytes[0], U8{97})
    assert_eq(bytes[1048575], U8{97})
}

#Test("response cap plus one rejects with the exact body limit") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    with_length :: http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 1048577{cr}\n{cr}\n", 1048577, U8{97})
    assert_eq(http_response_limit_error(with_length), "BodyTooLarge:1048576")
    until_close :: http_response_limit_raw("HTTP/1.1 200 OK{cr}\n{cr}\n", 1048577, U8{97})
    assert_eq(http_response_limit_error(until_close), "BodyTooLarge:1048576")
}

#Test("response incomplete non CRLF oversize head and head UTF8 precede body cap") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    incomplete :: http_response_limit_raw("HTTP/1.1 200 OK{cr}\n", 1048577, U8{97})
    assert_eq(http_response_limit_error(incomplete), "InvalidFraming")
    malformed :: http_response_limit_raw("HTTP/1.1 200 OK\nX: y{cr}\n{cr}\n", 1048577, U8{97})
    assert_eq(http_response_limit_error(malformed), "InvalidFraming")
    large := http_response_limit_raw("HTTP/1.1 200 OK{cr}\nX-Large: ", 32768, U8{97})
    loop byte in "{cr}\n{cr}\n".bytes() -> &large.push(byte)
    loop i in 0..<1048577 -> &large.push(U8{97})
    assert_eq(http_response_limit_error(large), "InvalidHeader")
    invalid := "HTTP/1.1 200 OK{cr}\nX: ".bytes()
    &invalid.push(U8{255})
    loop byte in "{cr}\n{cr}\n".bytes() -> &invalid.push(byte)
    loop i in 0..<1048577 -> &invalid.push(U8{97})
    assert_eq(http_response_limit_error(invalid), "Protocol:HTTP")
}

#Test("response body cap precedes status header framing encoding and body UTF8 errors") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    heads :: [String]{
        "HTTP/1.1 2x0 OK{cr}\n{cr}\n",
        "HTTP/9 200 OK{cr}\n{cr}\n",
        "HTTP/1.1 200 OK{cr}\nBad Header: value{cr}\n{cr}\n",
        "HTTP/1.1 200 OK{cr}\nContent-Length: 0{cr}\n{cr}\n",
        "HTTP/1.1 200 OK{cr}\nContent-Length: 1{cr}\nTransfer-Encoding: chunked{cr}\n{cr}\n",
        "HTTP/1.1 200 OK{cr}\nContent-Encoding: gzip{cr}\n{cr}\n",
        "HTTP/1.1 204 No Content{cr}\n{cr}\n",
    }
    loop head in heads {
        assert_eq(http_response_limit_error(http_response_limit_raw(head, 1048577, U8{255})), "BodyTooLarge:1048576")
    }
}

#Test("response within cap keeps status header framing and encoding priority") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 2x0 OK{cr}\nContent-Length: 1{cr}\n{cr}\n", 1, U8{255})), "InvalidStatus")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 200 OK{cr}\nBad Header: value{cr}\nContent-Length: 1{cr}\n{cr}\n", 1, U8{255})), "InvalidHeader")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 1{cr}\nTransfer-Encoding: chunked{cr}\n{cr}\n", 1, U8{255})), "InvalidFraming")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 1{cr}\nContent-Encoding: gzip{cr}\n{cr}\n", 1, U8{255})), "UnsupportedEncoding")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 204 No Content{cr}\nContent-Length: 0{cr}\n{cr}\n", 0, U8{97})), "InvalidFraming")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 0{cr}\n{cr}\n", 1, U8{97})), "InvalidFraming")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 204 No Content{cr}\n{cr}\n", 1, U8{97})), "InvalidFraming")
    assert_eq(http_response_limit_error("HTTP/1.1 200 OK{cr}\nContent-Length: 1048577{cr}\n{cr}\n".bytes()), "InvalidFraming")
    assert_eq(http_response_limit_error(http_response_limit_raw("HTTP/1.1 200 OK{cr}\nContent-Length: 1{cr}\n{cr}\n", 1, U8{255})), "UnsupportedEncoding")
}

#Test("response empty 304 and multibyte bodies survive") {
    cr :: String.from_bytes([U8]{13}) ?? ""
    assert_eq(http_response_limit_text("HTTP/1.1 200 OK{cr}\n{cr}\n".bytes()), "")
    assert_eq(http_response_limit_text("HTTP/1.1 304 Not Modified{cr}\nContent-Length: 5{cr}\n{cr}\n".bytes()), "")
    assert_eq(http_response_limit_text("HTTP/1.1 200 OK{cr}\n{cr}\nhello".bytes()), "hello")
    raw :: "HTTP/1.1 200 OK{cr}\nX-Example: intact{cr}\nContent-Length: 7{cr}\n{cr}\nhé🙂".bytes()
    resp :: http_response_limit_api.parse_response("http://example.test/", raw) ?? panic("normal response failed")
    assert_eq(resp.status(), 200)
    assert_eq(resp.header("X-Example"), Val("intact"))
    assert_eq(resp.text() ?? "text failed", "hé🙂")
}
