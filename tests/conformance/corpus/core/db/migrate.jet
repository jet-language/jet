// core-conformance: core.db.migrate
use core.db as db

fn run() {
    connection :: db.open_memory()
    policy :: db.policy("items", "true") ?? panic("policy")
    scope :: connection.with_policy(policy, "owner")
    print(db.migrate(scope, "items-v1", [SQL{"CREATE TABLE items (i INTEGER)"}]) ?? panic("migrate"))
}
