// core-conformance: core.db.row_int
use core.db as db

fn run() {
    connection :: db.open_memory()
    policy :: db.policy("items", "true") ?? panic("policy")
    scope :: connection.with_policy(policy, "owner")
    migration :: db.migrate(scope, "items-v1", [SQL{"CREATE TABLE items (i INTEGER, f REAL, t TEXT, b BOOLEAN)"}])
        ?? panic("migrate")
    i :: 7
    f :: 1.5
    t :: "jet"
    b :: true
    inserted :: scope.execute(
        SQL{"INSERT INTO items (i, f, t, b) VALUES ({i}, {f}, {t}, {b})"}
    ) ?? panic("insert")
    print("setup={migration}:{inserted}")
    row :: scope.query_one(SQL{"SELECT i FROM items"}) ?? panic("query")
    print(db.row_int(row, "i") ?? -1)
}
