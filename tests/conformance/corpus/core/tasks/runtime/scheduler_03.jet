// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4723
#Test("select_cancellation_after_park_wakes_and_cleans_waiters") {
    // GATE #4565: kernel primitive
    #Unsafe("wait for actual channel and cancellation registration before cancelling the parked selector") {
        control :: JetTaskControl.new()
        channel :: JetSchedulerChannel<I64>.new()
        inner :: channel.select_inner()
        selected_inner :: inner.clone()
        selected_control :: control.clone()
        (tx, rx) :: sync_channel<JetSelectOutcome<I64>>(1)
        _ :: thread.spawn(fn() {
            jet_scheduler_set_task_control(Val(^selected_control))
            outcome :: jet_scheduler_select([^selected_inner], [])
            jet_scheduler_set_task_control(None)
            _ :: tx.send(^outcome)
        })
        deadline :: Instant.now() + Duration.from_millis(250)
        loop {
            channel_registered :: not inner.state.lock().unwrap().recv_waiters.is_empty()
            cancel_registered :: not control.cancel_waiters.lock().unwrap().is_empty()
            if channel_registered && cancel_registered -> break
            assert(Instant.now() < deadline, "select did not park")
            thread.yield_now()
        }
        control.cancel()
        assert(rx.recv_timeout(Duration.from_millis(250)).expect("cancelled select did not wake") is .Closed)
        assert(inner.state.lock().unwrap().recv_waiters.is_empty())
        assert(control.cancel_waiters.lock().unwrap().is_empty())
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4759
#Test("select_deadline_unwind_cleans_all_waiters") {
    // GATE #4565: kernel primitive
    #Unsafe("force original thread-local deadline condition and catch the real scheduler unwind") {
        control :: JetTaskControl.new()
        channel :: JetSchedulerChannel<I64>.new()
        inner :: channel.select_inner()
        jet_scheduler_set_task_control(Val(control.clone()))
        jet_scheduler_task_panic_enter()
        result :: {
            TEST_DEADLINE_EXCEEDED.with(fn(deadline) { deadline.set(true) })
            panic.catch_unwind(panic.AssertUnwindSafe(fn() { jet_scheduler_select([inner.clone()], []) }))
        }
        TEST_DEADLINE_EXCEEDED.with(fn(deadline) { deadline.set(false) })
        jet_scheduler_task_panic_leave()
        jet_scheduler_set_task_control(None)
        assert(result.is_err())
        assert(inner.state.lock().unwrap().recv_waiters.is_empty())
        assert(control.cancel_waiters.lock().unwrap().is_empty())
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4784
fn converted_payloads() -> [(&String, Box<Any + Send>)] {
    // GATE #4565: kernel primitive
    #Unsafe("build the exact native payload types used at the scheduler raise sites") {
        [("cancel", Box.new(JetCancelUnwind{})),
         ("deadline", Box.new(JetDeadlineUnwind{rendered: "Error [E3003]: Deadline exceeded while waiting in task join"})),
         ("stop report", Box.new("Stop [E3001]: select closed\n  --> a.jet:3:1\n".to_string())),
         ("deadline report", Box.new("Error [E3003]: Deadline exceeded while waiting in task join".to_string())),
         ("foreign boundary", Box.new("__jet_ffi_runtime__: os entropy: closed".to_string()))]
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4813
// Native nounwind/cleanup hook messages cannot be converted by any catch frame.
fn escaping_payloads() -> [(&String, Box<Any + Send>)] {
    // GATE #4565: kernel primitive
    #Unsafe("retain native borrowed and owned panic payload distinctions") {
        [("nounwind", Box.new("panic in a function that cannot unwind")),
         ("cleanup", Box.new("panic in a destructor during cleanup")),
         ("host defect", Box.new("called `Option::unwrap()` on a `None` value".to_string()))]
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4825
#Test("panic_hook_prints_an_escaping_task_panic_and_hides_a_converted_one") {
    // GATE #4565: kernel primitive
    decisions :: #Unsafe("probe native hook decisions inside a live real catch frame without assertions there") {
        jet_scheduler_catch_task_unwind(fn() {
            decisions := [(&String, Bool)].new()
            loop (label, payload) in converted_payloads().into_iter().chain(escaping_payloads()) {
                decisions.push((label, jet_scheduler_suppress_panic_report(&*payload)))
            }
            defect :: panic.catch_unwind(fn() { panic("interpreter defect") })
                .expect_err("the task-body panic must be captured")
            decisions.push(("raised defect", jet_scheduler_suppress_panic_report(&*defect)))
            cancel :: panic.catch_unwind(fn() { jet_task_unwind_cancel() })
                .expect_err("the cancel unwind must be captured")
            decisions.push(("raised cancel", jet_scheduler_suppress_panic_report(&*cancel)))
            ^decisions
        }).expect("the probe frame must not panic")
    }
    assert(decisions == [("cancel", true), ("deadline", true), ("stop report", true),
        ("deadline report", true), ("foreign boundary", true), ("nounwind", false),
        ("cleanup", false), ("host defect", false), ("raised defect", false), ("raised cancel", true)])
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4870
#Test("panic_hook_prints_every_payload_with_no_catch_frame_live") {
    loop (label, payload) in converted_payloads().into_iter().chain(escaping_payloads()) {
        assert(not jet_scheduler_suppress_panic_report(&*payload), "{label} must keep its message when no catch frame is live")
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4883
#Test("arbitrary_wait_payload_is_host_fault_not_jet_runtime_failure") {
    // GATE #4565: kernel primitive
    #Unsafe("classify real arbitrary native text and non-text payloads, never as Jet runtime reports") {
        match jet_scheduler_classify_unwind<()>(Box.new("host helper failed".to_string())) {
            .Panicked(message) -> assert(jet_scheduler_host_fault_reason(&message) == Val("host helper failed"))
            _ -> panic("arbitrary string payload must remain a panic status")
        }
        match jet_scheduler_classify_unwind<()>(Box.new(U8{7})) {
            .Panicked(message) -> assert(jet_scheduler_host_fault_reason(&message) == Val("scheduler wait carried a non-Jet payload"))
            _ -> panic("arbitrary payload must remain a panic status")
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4906
#Test("transported_runtime_report_is_not_reclassified_as_host_fault") {
    report :: "Stop [E3014]: foreign function failed\n  --> ffi.jet:7:1\n"
    // GATE #4565: kernel primitive
    #Unsafe("transported native report retains its diagnostic text and classification") {
        match jet_scheduler_classify_unwind<()>(Box.new(report.to_string())) {
            .Panicked(message) -> { assert(message == report); assert(jet_scheduler_host_fault_reason(&message).is_none()) }
            _ -> panic("transported runtime report must remain a panic status")
        }
    }
}
