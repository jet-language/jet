// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4686
#Test("select_ready_value_and_timer_keep_precedence_over_closed") {
    valued :: JetSchedulerChannel<I64>.new()
    sender :: valued.sender()
    assert(sender.send(7))
    drop(^sender)
    assert(select_with_timeout([^valued], []) is .Recv(_, 7))
    closed :: JetSchedulerChannel<I64>.new()
    closed.close()
    assert(select_with_timeout([^closed], [0]) is .After(0))
    closed :: JetSchedulerChannel<I64>.new()
    closed.close()
    assert(select_with_timeout([^closed], [10]) is .After(0))
}
