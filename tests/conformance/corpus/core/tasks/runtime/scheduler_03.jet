// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:3616
#Test("scheduler_backend_uses_selected_target_and_native_io_feature") {
    backend :: jet_scheduler_io_backend()
    expected :: if not jet_native_io { "portable-poll" } else {
        match target.selected_os() {
            .Linux -> "epoll"
            .MacOS | .IOS | .TvOS | .WatchOS | .FreeBSD | .NetBSD | .OpenBSD -> "kqueue"
            .Windows -> "iocp"
            _ -> "portable-poll"
        }
    }
    assert(backend == expected)
    assert(jet_scheduler_io_backend() == backend)
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:3812
#Test("scheduler_result_keeps_value_panic_cancel_and_deadline_distinct") {
    value :: JetSchedulerResult<I64>.Value(I64{17})
    match value { .Value(number) -> assert(number == I64{17}), _ -> assert(false) }
    panic :: JetSchedulerResult<I64>.Panicked("child panic")
    match panic { .Panicked(message) -> assert(message == "child panic"), _ -> assert(false) }
    cancelled :: JetSchedulerResult<I64>.Cancelled
    match cancelled { .Cancelled -> {}, _ -> assert(false) }
    deadline :: JetSchedulerResult<I64>.Deadline("rendered deadline")
    match deadline { .Deadline(message) -> assert(message == "rendered deadline"), _ -> assert(false) }
}

// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4457
fn register_record(trace: Arc<Mutex<[&String]>>, event: &String) -> {
    jet_scheduler_task_completion_register(fn() {
        // GATE #4565: kernel primitive
        #Unsafe("record completion cleanup order under the shared trace mutex") { trace.lock().unwrap().push(event) }
    })
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4467
#Test("nested_task_completion_drains_only_its_frame_in_lifo_order") {
    // GATE #4565: kernel primitive
    #Unsafe("shared trace witnesses nested cleanup order and cleanup registered during drain") {
        trace :: Arc.new(Mutex.new([&String].new()))
        outer := jet_scheduler_task_completion_begin()
        register_record(trace.clone(), "outer-first")
        register_record(trace.clone(), "outer-second")
        {
            inner := jet_scheduler_task_completion_begin()
            inner_trace :: trace.clone()
            late_trace :: trace.clone()
            jet_scheduler_task_completion_register(fn() {
                inner_trace.lock().unwrap().push("inner-first")
                register_record(late_trace.clone(), "inner-late")
            })
            register_record(trace.clone(), "inner-second")
            inner.drain()
            assert(*trace.lock().unwrap() == ["inner-second", "inner-first", "inner-late"])
        }
        assert(*trace.lock().unwrap() == ["inner-second", "inner-first", "inner-late"])
        outer.drain()
        assert(*trace.lock().unwrap() == ["inner-second", "inner-first", "inner-late", "outer-second", "outer-first"])
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4506
fn nested_task_completion_failure(trace: Arc<Mutex<[&String]>>) -> () Err! {
    _inner :: jet_scheduler_task_completion_begin()
    register_record(^trace, "failed-child")
    result: () Err! = Err("child failed")
    result?
    ()
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4517
#Test("nested_task_completion_restores_parent_on_failure_and_unwind") {
    // GATE #4565: kernel primitive
    #Unsafe("real native unwind and ordinary failure both drain the child and restore parent frame") {
        trace :: Arc.new(Mutex.new([&String].new()))
        outer := jet_scheduler_task_completion_begin()
        register_record(trace.clone(), "outer-first")
        assert(nested_task_completion_failure(trace.clone()) == Err("child failed"))
        assert(*trace.lock().unwrap() == ["failed-child"])
        panic_trace :: trace.clone()
        result :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
            _inner :: jet_scheduler_task_completion_begin()
            register_record(^panic_trace, "panicked-child")
            panic("nested task failed")
        }))
        assert(result.is_err())
        assert(*trace.lock().unwrap() == ["failed-child", "panicked-child"])
        register_record(trace.clone(), "outer-late")
        outer.drain()
        assert(*trace.lock().unwrap() == ["failed-child", "panicked-child", "outer-late", "outer-first"])
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4553
#Test("bounded_reservations_serialize_capacity_until_commit_or_drop") {
    // GATE #4565: kernel primitive
    #Unsafe("real competing sender waits for bounded capacity until held reservation is dropped") {
        channel :: JetSchedulerChannel<I64>.bounded(1)
        sender :: channel.sender()
        reservation :: sender.reserve_send().expect("reserve bounded capacity")
        assert(channel.inner.state.lock().unwrap().reserved_sends == 1)
        worker_sender :: sender.clone()
        (tx, rx) :: sync_channel<Bool>(1)
        worker :: thread.spawn(fn() {
            reservation :: worker_sender.reserve_send().expect("reserve after capacity is released")
            tx.send(reservation.commit(22).is_ok()).expect("report committed send")
        })
        deadline :: Instant.now() + Duration.from_secs(1)
        loop {
            if channel.inner.state.lock().unwrap().send_waiters.len() == 1 -> break
            assert(Instant.now() < deadline, "second sender did not wait for capacity")
            thread.yield_now()
        }
        assert(channel.inner.state.lock().unwrap().reserved_sends == 1)
        drop(^reservation)
        assert(rx.recv_timeout(Duration.from_secs(1)).expect("released reservation wakes waiting sender"))
        worker.join().expect("sender worker completed")
        assert(channel.try_receive() == Val(22))
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4587
#Test("prepared_send_publishes_receipt_and_skips_prepare_after_close") {
    // GATE #4565: kernel primitive
    #Unsafe("reservation publishes prepared value and receipt, and closed channel skips callback") {
        channel :: JetSchedulerChannel<I64>.bounded(1)
        sender :: channel.sender()
        reservation :: sender.reserve_send().expect("reserve bounded capacity")
        receipt :: reservation.commit_prepared(fn() -> Result<(I64, &String), ()> { Ok((17, "receipt")) })
            .expect("prepare and publish")
        assert(receipt == "receipt")
        assert(channel.try_receive() == Val(17))
        reservation :: sender.reserve_send().expect("reserve second capacity")
        channel.close()
        prepared :: AtomicUsize.new(0)
        result :: reservation.commit_prepared(fn() -> Result<(I64, ()), ()> {
            _ :: prepared.fetch_add(1, Ordering.SeqCst)
            Ok((19, ()))
        })
        assert(result is Err(JetSchedulerSendPrepareError.Closed))
        assert(prepared.load(Ordering.SeqCst) == 0)
        assert(channel.try_receive() == None)
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4612
#Test("non_owning_select_view_does_not_delay_receiver_close") {
    // GATE #4565: kernel primitive
    #Unsafe("select view retains state but not receiver ownership") {
        channel :: JetSchedulerChannel<I64>.new()
        view :: channel.select_view()
        drop(^channel)
        state :: view.inner.state.lock().unwrap()
        assert(state.receiver_count == 0)
        assert(state.closed)
    }
}
// Rust: crates/jet-codegen/src/Prelude/Scheduler.rs:4628
fn select_with_timeout(channels: [JetSchedulerChannel<I64>], timers: [U64]) -> JetSelectOutcome<I64> {
    // GATE #4565: kernel primitive
    #Unsafe("real selecting thread reports within the original close-wakeup timeout") {
        (tx, rx) :: sync_channel<JetSelectOutcome<I64>>(1)
        _ :: thread.spawn(fn() {
            inners :: channels.into_iter().map(fn(channel) { channel.select_inner() }).collect()
            _ :: tx.send(jet_scheduler_select(^inners, ^timers))
        })
        rx.recv_timeout(Duration.from_millis(250)).expect("select did not wake after every channel closed")
    }
}
