// core-conformance: core.testing.histories
use api: core.testing

reference_size: fn(commands: [Dyn]) -> Dyn {
    Dyn.Int(commands.len())
}

candidate_size: fn(commands: [Dyn]) -> Dyn {
    Dyn.Int(commands.len())
}

observe: fn(value: Dyn) -> Dyn { value.copy() }

run: fn() {
    comparison: api.histories<Dyn>(
        seed: 1,
        cases: 1,
        strategy: None,
        model: reference_size,
        actual: candidate_size,
        observe: observe,
    )
    print(comparison.status)
}
