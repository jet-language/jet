// core-conformance: core.testing.histories
use core.testing as api

fn reference_size(commands: [Dyn]) -> Dyn {
    Dyn.Int(commands.len())
}

fn candidate_size(commands: [Dyn]) -> Dyn {
    Dyn.Int(commands.len())
}

fn observe(value: Dyn) -> Dyn { value.copy() }

fn run() {
    comparison :: api.histories<Dyn>(
        seed: 1,
        cases: 1,
        strategy: None,
        model: reference_size,
        actual: candidate_size,
        observe: observe,
    )
    print(comparison.status)
}
