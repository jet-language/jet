use core.testing.runtime.top_testing_history.[jet_history_data_tree_capture, jet_history_type_codec, jet_history_encode_type, JetHistoryTypes]
use core.encoding.runtime.std_data_tree.DataTree

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:284-306
#Test("history_capture_distinguishes_numeric_bits_text_and_byte_shape") {
    assert_eq(jet_history_data_tree_capture(&DataTree.Int(3), 0)!, DataTree.Array([DataTree.Text("int"), DataTree.Text("3")]))
    assert_eq(jet_history_data_tree_capture(&DataTree.Text("3"), 0)!, DataTree.Array([DataTree.Text("text"), DataTree.Text("3")]))
    assert_eq(jet_history_data_tree_capture(&DataTree.Bytes([U8{0}, U8{255}]), 0)!, DataTree.Array([DataTree.Text("bytes"), DataTree.Array([DataTree.Int(0), DataTree.Int(255)])]))
    assert_ne(jet_history_data_tree_capture(&DataTree.Float(0.0), 0)!, jet_history_data_tree_capture(&DataTree.Float(-0.0), 0)!)
    assert(jet_history_data_tree_capture(&DataTree.Null, 64).is_err())
    assert(jet_history_data_tree_capture(&DataTree.Array([DataTree.Null]), 63).is_err())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:35-49
#Test("history_codec_checked_instantiation_rejects_unresolved_wrong_type_and_depth") {
    types := JetHistoryTypes{}
    codec :: jet_history_type_codec<I64>("Count", fn(value, _) { Ok(DataTree.Int(*value)) })
    &types.insert("T", ^codec)
    assert_eq(jet_history_encode_type(&types, "T", &I64{7}, 0)!, DataTree.Int(7))
    assert(jet_history_encode_type(&types, "missing", &I64{7}, 0).is_err())
    assert(jet_history_encode_type(&types, "T", &"7", 0).is_err())
    assert(jet_history_encode_type(&types, "T", &I64{7}, 64).is_err())
}

use core.testing.runtime.top_testing_history.jet_testing_history_web.[jet_testing_history_web_rng_alloc, jet_testing_history_web_rng_release, jet_testing_history_web_rng_state, jet_testing_history_web_rng_next_u64, jet_testing_history_web_rng_below, jet_testing_history_web_input_alloc, jet_testing_history_web_output_alloc, jet_testing_history_web_output_ptr, jet_testing_history_web_output_len, jet_testing_history_web_output_clear, jet_testing_history_web_call]
use jet_testing_history_foundation.HistoryRng

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:727-779
#Test("history_web_rng_reuses_released_slots_and_matches_reference_state") {
    reference := HistoryRng.new(123)
    handle :: jet_testing_history_web_rng_alloc(123)
    assert_ne(handle, 0)
    assert_eq(jet_testing_history_web_rng_state(handle), reference.state())
    assert_eq(jet_testing_history_web_rng_next_u64(handle), &reference.next_u64())
    assert_eq(jet_testing_history_web_rng_below(handle, 17), &reference.below(17))
    assert_eq(jet_testing_history_web_rng_state(handle), reference.state())
    jet_testing_history_web_rng_release(handle)
    assert_eq(jet_testing_history_web_rng_state(handle), 0)
    assert_eq(jet_testing_history_web_rng_next_u64(0), 0)
    reused :: jet_testing_history_web_rng_alloc(456)
    assert_eq(reused, handle)
    assert_eq(jet_testing_history_web_rng_state(reused), 456)
    jet_testing_history_web_rng_release(reused)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:1803-1851
#Test("history_web_buffer_allocators_reject_zero_and_oversized_spans") {
    assert_eq(jet_testing_history_web_input_alloc(0), 0)
    assert_eq(jet_testing_history_web_input_alloc(8 * 1024 * 1024 + 1), 0)
    assert_eq(jet_testing_history_web_output_alloc(0), 0)
    assert_eq(jet_testing_history_web_output_alloc(8 * 1024 * 1024 + 1), 0)
    pointer :: jet_testing_history_web_output_alloc(4)
    assert_ne(pointer, 0)
    assert_eq(jet_testing_history_web_output_ptr(), pointer)
    assert_eq(jet_testing_history_web_output_len(), 4)
    jet_testing_history_web_output_clear()
    assert_eq(jet_testing_history_web_output_len(), 0)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/TestingHistory.rs:1853-1880
#Test("history_web_invalid_input_retains_real_error_envelope") {
    assert_eq(jet_testing_history_web_call(0, 0), 0)
    assert(jet_testing_history_web_output_len() > 0)
    // GATE #4565: kernel primitive
    output :: #Unsafe("borrow current retained Web result only until clear") {
        std.slice.from_raw_parts(jet_testing_history_web_output_ptr() as USize as *const U8, jet_testing_history_web_output_len() as USize)
    }
    text :: std.str.from_utf8(output)!
    assert(text.contains("invalid testing history WebWasm wire JSON"))
    assert(text.contains("\"Err\""))
    jet_testing_history_web_output_clear()
}
