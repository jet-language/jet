// core-conformance: core.event.new
use core.event as event

fn run() {
    scope :: event.scope()
    clicked :: event.new<Int>()
    sub :: clicked.on(scope, value -> print(value))
    trace :: clicked.emit(4)
    print(clicked.listener_count())
    print(trace.delivered())
    print(sub.is_active())
}
