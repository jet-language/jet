// core-conformance: core.event.async_result
use core.event as event

fn run() {
    scope :: event.scope()
    queued :: event.async_result<Int, String>(AsyncPolicy{capacity: 1, overflow: .Block}, .Collect) ?? panic("async event")
    sub :: queued.on(scope, (value: Int) -> print(value))
    report :: queued.emit_async(7).join() ?? panic("dispatch")
    print(queued.listener_count())
    print(report.state() == .Delivered)
    print(report.delivered_handlers())
    print(sub.is_active())
    queued.close()
}
