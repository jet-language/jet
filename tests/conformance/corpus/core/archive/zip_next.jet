// core-conformance: core.archive.zip_next
use core.archive as archive

fn run() {
    data :: [U8]{72, 101, 108, 108, 111}
    zip :: archive.create("entry.txt", data) ?? panic("create")
    reader :: archive.zip_open(zip) ?? panic("zip open")
    result :: archive.zip_next(reader, 0) ?? panic("zip next")
    print(result)
}
