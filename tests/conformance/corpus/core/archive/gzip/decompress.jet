// core-conformance: core.archive.gzip.decompress
use core.archive.gzip as gzip

fn run() {
    data :: [U8]{31, 139, 8, 0, 0, 0, 0, 0, 2, 3, 203, 72, 205, 201, 201, 7, 0, 134, 166, 16, 54, 5, 0, 0, 0}
    result :: gzip.decompress(data) ?? panic("decompress")
    print(result == [U8]{104, 101, 108, 108, 111})
}
