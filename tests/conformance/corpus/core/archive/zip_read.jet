// core-conformance: core.archive.zip_read
use core.archive as archive

fn run() {
    data :: [U8]{72, 101, 108, 108, 111}
    zip :: archive.create("entry.txt", data)
    reader :: archive.zip_open(zip) ?? panic("zip open")
    result :: archive.zip_read(reader, "entry.txt") ?? panic("zip read")
    print(result == data)
}
