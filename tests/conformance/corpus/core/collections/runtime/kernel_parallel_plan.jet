use core.collections.runtime.kernel_parallel_plan as pp

// Original ParallelPlan.rs1817–1978 fixtures. Explicit U64 target boundary
// below is a portable 64-bit fixture, NOT selected-target/host evidence.
fn pure_map(len: U64) -> pp.JetParallelProof Never! {
    pp.proof_new(pp.domain_from_len(len), [pp.JetParallelAccessFact]{pp.access_read("input")},
        [pp.JetParallelEffectFact]{pp.effect_pure()},
        [pp.JetParallelDependencyFact]{pp.dependency_independent("input")}, None)
}
fn fold_proof(len: U64) -> pp.JetParallelProof Never! {
    pp.proof_new(pp.domain_from_len(len), [pp.JetParallelAccessFact]{pp.access_read("input")},
        [pp.JetParallelEffectFact]{pp.effect_reduction("sum")},
        [pp.JetParallelDependencyFact]{}, Val(pp.reduction_proven("sum")))
}
#Test("chunks_are_source_ordered_and_worker_bounded") {
    domain :: pp.domain_from_len(U64{130})
    bounds :: pp.resources_with_chunk_items(pp.resources_explicit(U64{99}, U64{3}), U64{64})
    chunks :: pp.resources_deterministic_chunks(bounds, domain, U64{18446744073709551615}) ?? panic("valid chunks rejected")
    assert_eq(chunks, [pp.JetParallelChunk]{
        pp.JetParallelChunk{ordinal: U64{0}, start: U64{0}, end: U64{64}, worker: U64{0}},
        pp.JetParallelChunk{ordinal: U64{1}, start: U64{64}, end: U64{128}, worker: U64{1}},
        pp.JetParallelChunk{ordinal: U64{2}, start: U64{128}, end: U64{130}, worker: U64{2}}
    })
}
#Test("proof_rejects_exact_dependence_and_external_effects") {
    dependent :: pp.proof_new(pp.domain_from_len(U64{8}),
        [pp.JetParallelAccessFact]{pp.access_write("total")},
        [pp.JetParallelEffectFact]{pp.effect_pure()}, [pp.JetParallelDependencyFact]{}, None)
    rejection :: pp.proof_rejection(dependent, .Map) ?? panic("dependent callback accepted")
    assert(pp.rejection_reason(rejection).contains("write-after-write on `total`"))
    external :: pp.proof_new(pp.domain_from_len(U64{8}),
        [pp.JetParallelAccessFact]{pp.access_read("input")},
        [pp.JetParallelEffectFact]{pp.effect_external("stdout")}, [pp.JetParallelDependencyFact]{}, None)
    external_rejection :: pp.proof_rejection(external, .Map) ?? panic("external callback accepted")
    assert(pp.rejection_reason(external_rejection).contains("effect `stdout`"))
}
#Test("explicit_plan_uses_sequential_fallback_for_one_chunk") {
    plan :: pp.plan_select_explicit(.Map, pure_map(U64{4}), pp.resources_explicit(U64{8}, U64{8}), U64{18446744073709551615}) ?? panic("valid plan rejected")
    assert_eq(plan.execution, pp.JetParallelExecution.Sequential(.SingleChunk))
    assert_eq(pp.chunk_range(plan.chunks[0]), (start: U64{0}, end: U64{4}))
}
// EXACT ORIGINAL NATIVE TEST, intentionally not published as a #Test until
// #4494/#4483 + packets0138/0144 provide the real measured_range callable.
// It is not replaced by a simulated timing test or counted as exercised parity.
