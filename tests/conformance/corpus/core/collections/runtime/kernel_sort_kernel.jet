use core.collections.runtime.kernel_sort_kernel.*

// Rust: crates/jet-codegen/src/Prelude/Core/SortKernel.rs:1
#Test("try_sort_keys_once_stable_and_atomic_failure") {
    xs := [(2, "a"), (1, "b"), (2, "c"), (1, "d")]
    calls := 0
    result :: jet_list_try_sort_by_key_kernel(&xs, fn(x) -> I64 Err! { calls += 1; Ok(x.0) }, fn(a, b) { a.cmp(b) })
    assert(result == .Ok(()))
    assert(calls == 4)
    assert(xs == [(1, "b"), (1, "d"), (2, "a"), (2, "c")])
    before :: xs.clone()
    failed :: jet_list_try_sort_by_key_kernel(&xs, fn(x) -> I64 Err! {
        if x.1 == "d" -> Err("key failed") else -> Ok(x.0)
    }, fn(a, b) { a.cmp(b) })
    assert(failed == .Err("key failed"))
    assert(xs == before)
}
// Rust: crates/jet-codegen/src/Prelude/Core/SortKernel.rs:39
#Test("try_partition_keeps_each_side_order") {
    assert(jet_list_try_partition_kernel([1, 2, 3, 4], fn(x) -> Bool Err! { Ok(x % 2 == 0) }) == .Ok(([2, 4], [1, 3])))
    assert(jet_list_try_partition_kernel([1, 2], fn(x) -> Bool Err! {
        if x == 2 -> Err("stop") else -> Ok(true)
    }) == .Err("stop"))
}
