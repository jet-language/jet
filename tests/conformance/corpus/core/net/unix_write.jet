// core-conformance: core.net.unix_write
use net: core.net

run: fn() {
    listener: net.unix_listen("/tmp/jet-conformance-unix-write.sock") ?? panic("listen")
    client: net.unix_connect("/tmp/jet-conformance-unix-write.sock") ?? panic("connect")
    server: net.unix_accept(listener) ?? panic("accept")
    print((() -> {
        net.unix_write(&client, "write") ?? panic("write")
        true
    })())
    print(net.unix_read(&server) ?? panic("read"))
}
