// core-conformance: core.net.udp_send_bytes_to
use core.net as net

fn run() {
    server :: net.udp_bind("127.0.0.1:0") ?? panic("server bind")
    address :: net.udp_local_addr(server) ?? panic("server address")
    transferred :: net.socket_addr_parse(net.socket_to_string(address)) ?? panic("source address")
    client_addr :: net.socket_addr_parse("127.0.0.1:0") ?? panic("source bind address")
    client :: net.udp_bind_addr(client_addr) ?? panic("client bind")
    result :: net.udp_send_bytes_to(client, "bytes".bytes(), transferred) ?? panic("send")
    packet :: net.udp_receive(server, 16) ?? panic("receive")
    print(result > 0 && net.udp_packet_data(packet) == "bytes")
}
