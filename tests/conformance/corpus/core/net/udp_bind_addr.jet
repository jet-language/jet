// core-conformance: core.net.udp_bind_addr
use core.net as net

fn run() {
    address :: net.socket_addr("127.0.0.1", 0) ?? panic("address")
    result :: net.udp_bind_addr(address) ?? panic("bind")
    local :: net.udp_local_addr(result) ?? panic("local address")
    print(net.socket_host(local))
}
