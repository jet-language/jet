// core-conformance: core.net.ready_readable
use core.net as net

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    client :: net.tcp_connect(address) ?? panic("connect")
    server :: net.tcp_accept(listener) ?? panic("accept")
    client.write_text("r") ?? panic("write")
    ready :: net.tcp_ready(&server, NetReadyInterest.Read, 1000) ?? panic("ready")
    result :: net.ready_readable(ready)
    print(result)
}
