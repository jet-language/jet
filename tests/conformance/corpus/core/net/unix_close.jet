// core-conformance: core.net.unix_close
use core.net as net

fn run() {
    listener :: net.unix_listen("/tmp/jet-conformance-unix-close.sock") ?? panic("listen")
    client :: net.unix_connect("/tmp/jet-conformance-unix-close.sock") ?? panic("connect")
    server :: net.unix_accept(listener) ?? panic("accept")
    result :: net.unix_close(&client) ?? panic("close")
    print(result)
}
