// core-conformance: core.net.unix_read_bytes
use core.net as net

fn run() {
    listener :: net.unix_listen("/tmp/jet-conformance-unix-read-bytes.sock") ?? panic("listen")
    client :: net.unix_connect("/tmp/jet-conformance-unix-read-bytes.sock") ?? panic("connect")
    server :: net.unix_accept(listener) ?? panic("accept")
    net.unix_write_all_bytes(&client, "bytes".bytes()) ?? panic("write")
    result :: net.unix_read_bytes(&server, 5) ?? panic("read")
    print(result == "bytes".bytes())
}
