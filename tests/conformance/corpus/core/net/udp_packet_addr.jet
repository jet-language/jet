// core-conformance: core.net.udp_packet_addr
use core.net as net

fn run() {
    server :: net.udp_bind("127.0.0.1:0") ?? panic("server bind")
    address :: net.udp_local_addr(server) ?? panic("server address")
    // Host-produced address -> source parser -> native UDP transport.
    transferred :: net.socket_addr_parse(net.socket_to_string(address)) ?? panic("source address")
    client_addr :: net.socket_addr_parse("127.0.0.1:0") ?? panic("source bind address")
    client :: net.udp_bind_addr(client_addr) ?? panic("client bind")
    net.udp_send_to(client, "addr", transferred) ?? panic("send")
    packet :: net.udp_receive(server, 16) ?? panic("receive")
    result :: net.udp_packet_addr(packet)
    // Host-produced packet address -> raw IP octets -> source formatter.
    ip :: net.ip_addr(net.socket_host(result)) ?? panic("packet IP")
    assert(net.ip_is_ipv4(ip))
    assert(net.socket_port(result) > 0)
    print(net.ip_to_string(ip))
}
