// core-conformance: core.net.tls.read_text
use core.net as net
use core.net.tls as tls

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    client :: net.tcp_connect(address) ?? panic("connect")
    server :: net.tcp_accept(listener) ?? panic("accept")
    net.tcp_close(&server) ?? panic("close")
    print(net.tls_connect(^client, "localhost") ? stream ->
        tls.read_text(&stream, 1) ? text -> true ! read_error -> false
        ! connect_error -> true)
}
