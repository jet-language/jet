    mux :: http_server.mux()
    mux.get("/", (req: HTTPRequest) -> Ok(http_server.response(200, "ok")))
    server :: http_server.bind("127.0.0.1:0", mux, tls: http_server.tls(cert, key)) ?? panic("server")
    addr :: server.local_addr()
    serving :: task { server.serve() }
    time.sleep(20ms)
    roots :: tls.RootCertificates.from_pem(cert.bytes()) ?? panic("roots")
    config :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("config")
    tcp :: net.tcp_connect(addr) ?? panic("connect")
    result :: tls.client(^tcp, server_name: "localhost", config: config, deadline: Duration.seconds(2)) ?? panic("tls")
    print(result.peer_identity().verified_server_name == "localhost")
    tls.close(&result) ?? panic("close")
    grace :: Duration.milliseconds(100)
    report :: server.shutdown(grace) ?? panic("shutdown")
    print(report.cancelled)
    serving.join() ?? panic("serve")
}
