// core-conformance: core.email.message
use core.email as email

fn run() {
    sender :: email.address("sender@example.com") ?? panic("sender")
    recipient :: email.address("recipient@example.net") ?? panic("recipient")
    message :: email.message(sender, [recipient], [Address]{}, "Welcome", "Hello", HTML{"<b>Hello</b>"}, [Attachment]{}) ?? panic("message")
    print((email.serialize(message) ?? panic("serialize")).len())
}
