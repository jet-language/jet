// core-conformance: core.email.address
use core.email as email

fn run() {
    sender :: email.address("Mara ☕ <mara@example.com>") ?? panic("address")
    print((email.serialize(email.message(sender, [sender], [Address]{}, "Subject", "Body", HTML{""}, [Attachment]{} ) ?? panic("message")) ?? panic("serialize")).len())
}
