// core-conformance: core.email.smtp
use core.email as email

fn run() {
    config :: email.SMTPConfig{
        host: "localhost",
        port: 2525,
        security: .StartTls,
        auth: .None,
        recipient_policy: .RequireAll,
        trust: .System,
        limits: email.Limits.safe(),
        dkim: None
    }
    print(email.smtp(config) ? ok -> true ! error -> false)
}
