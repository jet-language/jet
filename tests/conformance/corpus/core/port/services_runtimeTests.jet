// Rust: tests/services_runtime.rs:612
#Test("forged_rollout_generation_is_rejected_on_restart") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(ROLLOUT_RESTART_SOURCE)
    store :: dir.join("rollout-forged.log")
    assert_eq(run_restart_process(&bin, &store, "write", None), "handoff:2\n")
    rollout :: OSPath.from("{store.display()}.rollout")
    journal :: fs.read_to_string(&rollout).unwrap()
    forged :: journal.replace("generation:2\n", "generation:99\n")
        .replace("upgrade_to:2\n", "upgrade_to:99\n")
        .replace("worker_generation:2\n", "worker_generation:99\n")
        .replace("directory_generation:2\n", "directory_generation:99\n")
    assert_ne(journal, forged, "rollout journal fixture was not changed")
    fs.write(&rollout, forged).unwrap()
    assert(!restart_status(&bin, &store, "recover", "").success(), "a coherently forged rollout generation was accepted")
}

// Rust: tests/services_runtime.rs:690-693
// Restart distinguishes a durable store from an in-process cache.
#Test("state_adapters_survive_process_restart") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(STATE_RESTART_SOURCE)
    events :: dir.join("events.log")
    assert_eq(run_restart_process(&bin, &events, "write", Some("event-log")), "wrote:2\n")
    assert_eq(run_restart_default_process(&dir, &events, "read", Some("event-log")), "count:2\nreplay:first|second\nappended:first|second|third\n")
    events_reversed :: dir.join("events-default-to-aot.log")
    assert_eq(run_restart_default_process(&dir, &events_reversed, "write", Some("event-log")), "wrote:2\n")
    assert_eq(run_restart_process(&bin, &events_reversed, "read", Some("event-log")), "count:2\nreplay:first|second\nappended:first|second|third\n")
    snapshot :: dir.join("snapshot.log")
    assert_eq(run_restart_process(&bin, &snapshot, "write", Some("snapshot")), "wrote:state-v1\n")
    assert_eq(run_restart_default_process(&dir, &snapshot, "read", Some("snapshot")), "restored:state-v1\nrecommitted:state-v2\n")
    snapshot_reversed :: dir.join("snapshot-default-to-aot.log")
    assert_eq(run_restart_default_process(&dir, &snapshot_reversed, "write", Some("snapshot")), "wrote:state-v1\n")
    assert_eq(run_restart_process(&bin, &snapshot_reversed, "read", Some("snapshot")), "restored:state-v1\nrecommitted:state-v2\n")
    // Schema/version drift and torn append must fail closed, not shorten history.
    drift :: dir.join("events-drift.log")
    assert_eq(run_restart_process(&bin, &drift, "write", Some("event-log")), "wrote:2\n")
    loop adapter in ["schema-drift", "version-drift"] {
        assert(!restart_status(&bin, &drift, "read", adapter).success(), "a store opened under a mismatched {adapter}")
    }
    torn :: dir.join("events-torn.log")
    assert_eq(run_restart_process(&bin, &torn, "write", Some("event-log")), "wrote:2\n")
    bytes :: fs.read(&torn).unwrap()
    fs.write(&torn, bytes[..bytes.len() - 3]).unwrap()
    assert(!restart_status(&bin, &torn, "read", "event-log").success(), "a truncated state store was accepted")
}

// Rust: tests/services_runtime.rs:866-869
// Durable workflow reads must reproduce the writer's runs, steps and version conflicts.
#Test("workflow_history_survives_process_restart") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(WORKFLOW_RESTART_SOURCE)
    store :: dir.join("workflow.log")
    assert_eq(run_restart_process(&bin, &store, "write", None), "run:1\n")
    assert_eq(run_restart_process(&bin, &store, "read", None), WORKFLOW_RESTART_HISTORY)
    default_store :: dir.join("workflow-default.log")
    assert_eq(run_restart_default_process(&dir, &default_store, "write", None), "run:1\n")
    assert_eq(run_restart_default_process(&dir, &default_store, "read", None), WORKFLOW_RESTART_HISTORY)
    crossed :: dir.join("workflow-aot-to-default.log")
    assert_eq(run_restart_process(&bin, &crossed, "write", None), "run:1\n")
    assert_eq(run_restart_default_process(&dir, &crossed, "read", None), WORKFLOW_RESTART_HISTORY)
    reversed :: dir.join("workflow-default-to-aot.log")
    assert_eq(run_restart_default_process(&dir, &reversed, "write", None), "run:1\n")
    assert_eq(run_restart_process(&bin, &reversed, "read", None), WORKFLOW_RESTART_HISTORY)
    // A torn tail must be refused, not silently drop the unreadable run.
    corrupt :: dir.join("workflow-corrupt.log")
    assert_eq(run_restart_process(&bin, &corrupt, "write", None), "run:1\n")
    log :: corrupt.with_extension("log.workflows")
    bytes :: fs.read(&log).unwrap()
    fs.write(&log, bytes[..bytes.len() - 4]).unwrap()
    failed := std.process.Command.new(&bin)
    failed.env("JET_SERVICE_AUTH_STORE", &corrupt).env("JET_SERVICE_AUTH_PHASE", "read")
    output :: failed.output().unwrap()
    assert(!output.status.success(), "a truncated workflow log was accepted: {String.from_utf8_lossy(output.stdout)}")
    // Recovery must also number and persist a new run, visible to the third process.
    extended :: dir.join("workflow-extended.log")
    assert_eq(run_restart_process(&bin, &extended, "write", None), "run:1\n")
    assert_eq(run_restart_process(&bin, &extended, "extend", None), "{WORKFLOW_RESTART_HISTORY}refund:2\n")
    assert_eq(run_restart_default_process(&dir, &extended, "final", None), "{WORKFLOW_RESTART_HISTORY}refund_history:start@v1|step:credit\n")
}

// Rust: tests/services_runtime.rs:952
#Test("workflow_body_replay_reuses_recorded_steps") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(WORKFLOW_REPLAY_SOURCE)
    store :: dir.join("workflow-replay.log")
    assert_eq(run_restart_process(&bin, &store, "write", None), "written:{WORKFLOW_REPLAY_HISTORY}")
    assert_eq(run_restart_process(&bin, &store, "read", None), "replayed:{WORKFLOW_REPLAY_HISTORY}")
    assert(!restart_status(&bin, &store, "mismatch", "").success())
    assert(!restart_status(&bin, &store, "activity-mismatch", "").success())
    assert(!restart_status(&bin, &store, "completion-mismatch", "").success())
    default_store :: dir.join("workflow-replay-default.log")
    assert_eq(run_restart_default_process(&dir, &default_store, "write", None), "written:{WORKFLOW_REPLAY_HISTORY}")
    assert_eq(run_restart_default_process(&dir, &default_store, "read", None), "replayed:{WORKFLOW_REPLAY_HISTORY}")
    crossed :: dir.join("workflow-replay-crossed.log")
    assert_eq(run_restart_process(&bin, &crossed, "write", None), "written:{WORKFLOW_REPLAY_HISTORY}")
    assert_eq(run_restart_default_process(&dir, &crossed, "read", None), "replayed:{WORKFLOW_REPLAY_HISTORY}")
}

// Rust: tests/services_runtime.rs:1066-1069
// Typed wait methods publish effects through sema, with no source-text markers.
#Test("workflow_wait_methods_publish_typed_effects") {
    root :: tests.common.unique_tmp("jet_service_workflow_wait_effects")
    fs.create_dir_all(&root).unwrap()
    entry :: root.join("main.jet")
    fs.write(&entry, """
fn time_wait(workflow: ServiceWorkflow, duration: Duration) -[Time]> {
    workflow.sleep(duration) ?? return
}
fn activity_wait(workflow: ServiceWorkflow) -[IO]> {
    workflow.activity("charge", "charge-1") ?? return
    workflow.all(["charge-1"]) ?? return
}
fn run() {}
""").unwrap()
    (diagnostics, _, facts) :: jet.Driver.check_file_with_effect_facts(entry.to_str().unwrap(), None, false)
    assert(!diagnostics.iter().any(diagnostic -> diagnostic.severity == jet.Diagnostics.Severity.Error),
        "typed workflow effects should satisfy their declared rows: {diagnostics}")
    assert(facts.summaries["time_wait"].direct.contains("Time"))
    assert(facts.summaries["activity_wait"].direct.contains("IO"))
}

// Rust: tests/services_runtime.rs:1101-1104
// Record each wait once; body replay must neither sleep nor redeliver.
#Test("workflow_wait_methods_replay_their_history") {
    if !have_rustc() { return }
    (code, stdout) :: build_and_run("services_workflow_wait", WORKFLOW_WAIT_SOURCE)
    assert_eq(code, 0)
    assert_eq(stdout, "history:{WORKFLOW_WAIT_HISTORY}replay:{WORKFLOW_WAIT_HISTORY}")
    (jit_code, jit_stdout, jit_stderr) :: run_default_multi("services_workflow_wait_jit", "main.jet", [("main.jet", WORKFLOW_WAIT_SOURCE)])
    assert_eq(jit_code, 0, "default workflow wait run failed: {jit_stderr}")
    assert_eq(jit_stdout, stdout, "default workflow wait replay diverged")
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: interpreter_run("services_workflow_wait_interpreter", WORKFLOW_WAIT_SOURCE)
    assert_eq(interpreter_code, 0, "interpreter workflow wait run failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, stdout, "interpreter workflow wait replay diverged")
}

// Rust: tests/services_runtime.rs:1177-1180
// Cancellation must stop the timer and durably record its result.
#Test("workflow_sleep_cancellation_is_recorded") {
    if !have_rustc() { return }
    expected :: "cancelled\nhistory:start@v1|sleep:10000000000|sleep-cancelled\n"
    (code, stdout) :: build_and_run("services_workflow_sleep_cancel", WORKFLOW_SLEEP_CANCEL_SOURCE)
    assert_eq(code, 0)
    assert_eq(stdout, expected)
    (jit_code, jit_stdout, jit_stderr) :: run_default_multi("services_workflow_sleep_cancel_jit", "main.jet", [("main.jet", WORKFLOW_SLEEP_CANCEL_SOURCE)])
    assert_eq(jit_code, 0, "default workflow cancellation failed: {jit_stderr}")
    assert_eq(jit_stdout, stdout, "default workflow cancellation diverged")
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: interpreter_run("services_workflow_sleep_cancel_interpreter", WORKFLOW_SLEEP_CANCEL_SOURCE)
    assert_eq(interpreter_code, 0, "interpreter workflow cancellation failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, stdout, "interpreter workflow cancellation diverged")
}

// Rust: tests/services_runtime.rs:1218-1221
// Activity retry and terminal outcomes stay typed across AOT/default process restarts.
#Test("workflow_activity_outcome_survives_process_restart") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(WORKFLOW_OUTCOME_SOURCE)
    store :: dir.join("workflow-outcome.log")
    assert_eq(run_restart_process(&bin, &store, "write", None),
        "scheduled:Running\nretry:Paused\ncompleted:Finished\nrun:Finished\nobserve:Observe(workers=1, started=true, generation=1, dead_letters=0, events=0, chaos=0, draining=0, partitions=0, rollback=false, workflows=1,statuses={{running:0,paused:1,cancel_requested:0}},outcomes={{pending:0,finished:1,panicked:0,cancelled:0,deadline_blown:0}})\nhistory:{WORKFLOW_OUTCOME_HISTORY}")
    assert_eq(run_restart_process(&bin, &store, "read", None),
        "replay:Finished\nobserve:Observe(workers=1, started=true, generation=1, dead_letters=0, events=0, chaos=0, draining=0, partitions=0, rollback=false, workflows=1,statuses={{running:0,paused:1,cancel_requested:0}},outcomes={{pending:0,finished:1,panicked:0,cancelled:0,deadline_blown:0}})\nsame:Finished\nversion_after_terminal:2\nversion_history:start@v2\nhistory:{WORKFLOW_OUTCOME_HISTORY}")
    default_store :: dir.join("workflow-outcome-default.log")
    assert_eq(run_restart_default_process(&dir, &default_store, "write", None),
        "scheduled:Running\nretry:Paused\ncompleted:Finished\nrun:Finished\nobserve:Observe(workers=1, started=true, generation=1, dead_letters=0, events=0, chaos=0, draining=0, partitions=0, rollback=false, workflows=1,statuses={{running:0,paused:1,cancel_requested:0}},outcomes={{pending:0,finished:1,panicked:0,cancelled:0,deadline_blown:0}})\nhistory:{WORKFLOW_OUTCOME_HISTORY}")
    assert_eq(run_restart_default_process(&dir, &default_store, "read", None),
        "replay:Finished\nobserve:Observe(workers=1, started=true, generation=1, dead_letters=0, events=0, chaos=0, draining=0, partitions=0, rollback=false, workflows=1,statuses={{running:0,paused:1,cancel_requested:0}},outcomes={{pending:0,finished:1,panicked:0,cancelled:0,deadline_blown:0}})\nsame:Finished\nversion_after_terminal:2\nversion_history:start@v2\nhistory:{WORKFLOW_OUTCOME_HISTORY}")
}

