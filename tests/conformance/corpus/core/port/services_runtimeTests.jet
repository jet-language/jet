// Rust: tests/services_runtime.rs:19
#Test("service_runtime_exports_typed_counters_on_all_tiers") {
    if !have_rustc() { return }
    source_path :: OSPath.from(env.manifest_dir()).join("Examples/features/tooling/service_runtime/run.jet")
    source :: fs.read_to_string(source_path).unwrap()
    expected :: fs.read_to_string(OSPath.from(env.manifest_dir()).join("Examples/features/expected/tooling/service_runtime.out")).unwrap()
    (aot_code, aot_stdout, aot_stderr) :: build_and_run_full("services_observability", "service_runtime", source)
    assert_eq(aot_code, 0, "AOT observability dogfood failed: {aot_stderr}")
    assert_eq(aot_stdout, expected, "AOT observability dogfood diverged from its golden")
    (jit_code, jit_stdout, jit_stderr) :: run_default_multi("services_observability_jit", "main.jet", [("main.jet", source.as_str())])
    assert_eq(jit_code, 0, "default observability dogfood failed: {jit_stderr}")
    assert_eq(jit_stdout, expected, "default observability dogfood diverged from AOT/golden\n{jit_stderr}")
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: interpreter_run("services_observability_interpreter", source)
    assert_eq(interpreter_code, 0, "interpreter observability dogfood failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, expected, "interpreter observability dogfood diverged from AOT/golden\n{interpreter_stderr}")
}

