// Rust: tests/services_runtime.rs:428
#Test("service_authority_recovers_pending_delivery_across_process_restart") {
    if !have_rustc() { return }
    (dir, bin) :: compile_restart_binary(RESTART_SOURCE)
    store :: dir.join("authority.log")
    id_out :: run_restart_process(&bin, &store, "send", None)
    id := id_out.trim() // #4303
    assert(!id.is_empty(), "send process did not return a receipt id")
    assert_eq(run_restart_process(&bin, &store, "recover", Some(id)), "restarted:1\naccepted\norder\n")
    default_store :: dir.join("authority-default.log")
    default_id_out :: run_restart_default_process(&dir, &default_store, "send", None)
    default_id := default_id_out.trim() // #4303
    assert(!default_id.is_empty(), "default send process did not return a receipt id")
    assert_eq(run_restart_process(&bin, &default_store, "recover", Some(default_id)), "restarted:1\naccepted\norder\n")
    aot_store :: dir.join("authority-aot-to-default.log")
    aot_id_out :: run_restart_process(&bin, &aot_store, "send", None)
    aot_id := aot_id_out.trim() // #4303
    assert(!aot_id.is_empty(), "AOT send process did not return a receipt id")
    assert_eq(run_restart_default_process(&dir, &aot_store, "recover", Some(aot_id)), "restarted:1\naccepted\norder\n")
    // Receipt SHA-256 identity and acceptance HMAC must not alias altered immutable facts.
    corrupt_store :: dir.join("authority-corrupt.log")
    corrupt_id :: run_restart_process(&bin, &corrupt_store, "send", None)
    corrupt := fs.read(&corrupt_store).unwrap()
    pipes :: corrupt.iter().enumerate().filter_map((index, byte) -> if byte == b'|' { Some(index) } else { None }).collect::<[USize]>()
    assert(pipes.len() >= 10, "receipt record did not contain its framed fields")
    expires_start :: pipes[8] + 1
    expires_end :: pipes[9]
    expires_colon :: corrupt[expires_start..expires_end].iter().position(byte -> byte == b':').expect("receipt expiry field was not length framed")
    expiry_hex :: expires_start + expires_colon + 1
    corrupt[expiry_hex] = if corrupt[expiry_hex] == b'0' { b'1' } else { b'0' }
    fs.write(&corrupt_store, ^corrupt).unwrap()
    corrupt_id_trimmed := corrupt_id.trim() // #4303
    assert(!restart_status(&bin, &corrupt_store, "recover", corrupt_id_trimmed).success(), "a receipt with altered immutable facts was accepted")
    // A complete record without its final commit terminator is truncated history.
    truncated_store :: dir.join("authority-truncated.log")
    truncated_id :: run_restart_process(&bin, &truncated_store, "send", None)
    truncated := fs.read(&truncated_store).unwrap()
    assert_eq(truncated.pop(), Some(b'\n'))
    fs.write(&truncated_store, ^truncated).unwrap()
    truncated_id_trimmed := truncated_id.trim() // #4303
    assert(!restart_status(&bin, &truncated_store, "recover", truncated_id_trimmed).success(), "a truncated authority log was accepted")
}

