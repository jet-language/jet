    assert_eq(interpreter_code, 0, "interpreter workflow wait run failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, stdout, "interpreter workflow wait replay diverged")
}

// Rust: tests/services_runtime.rs:1177-1180
// Cancellation must stop the timer and durably record its result.
