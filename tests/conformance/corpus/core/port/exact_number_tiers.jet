SOURCE :: `
fn takes(v: Float) -> {
    print(v)
}

fn run() -> {
    third :: 1 / 3
    print(third)
    print(third * 3 == 1)
    print(0.1 + 0.2 == 0.3)
    fast :: Float{19.99}
    print(fast)
    takes(3.4)
    decimal :: 3.4
    print("dec={decimal}")
    print(decimal)
}
`
