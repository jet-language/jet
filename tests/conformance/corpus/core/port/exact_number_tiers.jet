// Rust: tests/exact_number_tiers.rs:36
fn have_tool(name: String) -> Bool {
    Command.new(name).arg("--version").output().map(output -> output.status.success()).unwrap_or(false)
}
// Rust: tests/exact_number_tiers.rs:44
fn have_wasm_target() -> Bool {
    Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().map(output -> output.status.success()).unwrap_or(false)
}

// Rust: tests/ffi_callbacks_tasks.rs:13
fn run_ok(command: &Command, label: String) -> {
    output :: command.output().unwrap_or_else(error -> panic("could not start {label}: {error}"))
    assert(output.status.success(), "{label} failed\nstdout:\n{String.from_utf8_lossy(output.stdout)}\nstderr:\n{String.from_utf8_lossy(output.stderr)}")
}
// Rust: tests/ffi_callbacks_tasks.rs:25
fn native_root(name: String) -> OSPath {
    temp_dir().join("jet_ffi_callbacks_tasks_{name}_{id()}")
}
// Rust: tests/ffi_callbacks_tasks.rs:32
fn write_c_library(root: OSPath) -> {
    fs.write(root.join("callback.c"), `
#include <pthread.h>
#include <stdint.h>

typedef int32_t (*callback_t)(int32_t);
typedef struct { callback_t callback; int32_t input; int32_t output; } Job;

static void *run_job(void *raw) {
    Job *job = (Job *)raw;
    job->output = job->callback(job->input);
    return 0;
}

int32_t foreign_callback(callback_t callback, int32_t input) {
    Job job = { callback, input, 0 };
    pthread_t thread;
    if (pthread_create(&thread, 0, run_job, &job) != 0) return -1;
    if (pthread_join(thread, 0) != 0) return -2;
    return job.output;
}

typedef struct { int32_t input; int32_t output; } AsyncJob;

static void *run_async_job(void *raw) {
    AsyncJob *job = (AsyncJob *)raw;
    job->output = job->input + 1;
    return 0;
}

int32_t foreign_async(int32_t input) {
    AsyncJob job = { input, 0 };
    pthread_t thread;
    if (pthread_create(&thread, 0, run_async_job, &job) != 0) return -1;
    if (pthread_join(thread, 0) != 0) return -2;
    return job.output;
}
`).unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(tool -> Command.new(tool).arg("--version").output().is_ok()).expect("a C compiler is required for the callback/task production proof")
    compile := Command.new(cc)
    compile.args(["-pthread", "-c"]).arg(root.join("callback.c")).arg("-o").arg(root.join("callback.o"))
    run_ok(&compile, "C callback worker compilation")
    archive := Command.new("ar")
    archive.args(["rcs"]).arg(root.join("libcallback.a")).arg(root.join("callback.o"))
    run_ok(&archive, "C callback archive creation")
}

