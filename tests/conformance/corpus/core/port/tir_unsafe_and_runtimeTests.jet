// Rust: tests/uninit_fixed.rs:287
#Test("every_path_initialising_a_slot_makes_it_written") {
    out :: compile(`use core.mem
fn decide(flag: Bool) -> {
    bytes := [U8#2]{ uninit }
    if {
        flag -> {
            bytes[0] = 1
            bytes[1] = 2
        }
        else -> {
            bytes[0] = 3
            bytes[1] = 4
        }
    }
    print(bytes[0])
}
fn run() -> { decide(true) }
`)
    assert(out.is_ok(), "both paths write every slot: {out.err()}")
}

// Rust: tests/uninit_fixed.rs:298
#Test("a_slot_written_on_one_path_only_stays_unwritten") {
    diagnostics :: compile(`use core.mem
fn decide(flag: Bool) -> {
    bytes := [U8#2]{ uninit }
    if {
        flag -> {
            bytes[0] = 1
            bytes[1] = 2
        }
        else -> {
            bytes[0] = 3
        }
    }
    print(bytes[1])
}
fn run() -> { decide(true) }
`).expect_err("one path leaves a slot unwritten")
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0420"), "{diagnostics}")
}
