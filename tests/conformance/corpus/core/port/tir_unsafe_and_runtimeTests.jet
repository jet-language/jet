// Rust: tests/tir_unsafe_and_runtime.rs:1173
#Test("task_join_parent_deadline_is_e3003_in_every_tier") {
    if !have_rustc() { return }
    src :: ``
fn run() -> {
    #Context(deadline: 0) {
        handle :: task 10
        handle.join() ?? 0
    }
    print("unreachable")
}
``
    (code, stdout, stderr) :: build_and_run_full("jet_tir_test", "tir_task_join_deadline", src)
    assert_eq(code, 70, stderr)
    assert_eq(stdout, "", stderr)
    assert(stderr.contains("Error [E3003]: Deadline exceeded while waiting in task join") && stderr.contains("More: jet-lang.dev/e/E3003"), stderr)
    fixture :: Scratch.new("jet_task_join_deadline_parity")
    write_test_package(fixture.path, TIR_TEST_PACKAGE)
    entry :: fixture.join("main.jet")
    fs.write(entry, src).unwrap()
    bundle := Loader.load_entry(entry.to_string_lossy().into_owned()).expect("deadline bundle should load")
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(d -> d.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "deadline program must type-check: {errors}")
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(&bundle, tier).expect("deadline fixture must execute")
        assert_ne(result.exit_code, 0, "{tier} ignored the expired deadline")
        assert_eq(result.stdout, "", "{tier} continued after the expired deadline")
        assert(result.stderr.contains("E3003"), "{tier}: {result.stderr}")
    }
}

