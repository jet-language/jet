// Rust: tests/tir_unsafe_and_runtime.rs:1003
#Test("task_all") {
    if !have_rustc() { return }
    src :: ``
fn work(value: Int, turns: Int) -> Int {
    total := value
    loop _ in 1..turns {
        total += 1
        total -= 1
    }
    return total
}
fn run() -> {
    results :: (task.all {
        work(10, 10000),
        work(20, 1),
        work(30, 100)
    }) ?? panic("task.all failed")
    print(results[0], results[1], results[2])
}
``
    assert_task_tier_parity("tir_task_all", src, "10\n20\n30\n")
}

// Rust: tests/tir_unsafe_and_runtime.rs:1031
#Test("named_task_all_maps_reverse_completion_by_field_name") {
    if !have_rustc() { return }
    src :: ``
fn slow() -> String {
    turns := 0
    loop _ in 0..<50000 {
        turns += 1
    }
    return "slow"
}
fn fast() -> Int {
    return 7
}
fn run() -> {
    values :: (task.all {
        z: slow(),
        a: fast()
    }) ?? panic("named task.all failed")
    print(values.z, values.a)
}
``
    assert_named_task_tier_parity("tir_named_task_all_order", src, "slow\n7\n")
}

// Rust: tests/tir_unsafe_and_runtime.rs:1060
#Test("task_failure_rail") {
    if !have_rustc() { return }
    src :: ``
use core.time as time

fn boom() -> Int {
    panic("boom")
    return 0
}
fn deadline() -> Int {
    #Context(deadline: 0) {
        time.sleep(1ms)
    }
    return 0
}
fn panic_rail() -> {
    task.group workers {
        failed :: task boom()
        if failed.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Cancelled -> { print("cancelled") }
                }
            }
            .Ok(_) -> { print("wrong panic variant") }
        }
    }
}
fn all_rail() -> {
    task.group workers {
        if (task.all { boom(), 2 }) == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Cancelled -> { print("cancelled") }
                }
            }
            .Ok(_) -> { print("wrong all variant") }
        }
    }
}
fn deadline_rail() -> {
    task.group workers {
        expired :: task deadline()
        if expired.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Cancelled -> { print("cancelled") }
                }
            }
            .Ok(_) -> { print("wrong deadline variant") }
        }
    }
}
fn cancel_rail() -> {
    task.group workers {
        cancelled :: task {
            time.sleep(1000ms)
        }
        cancelled.cancel()
        if cancelled.join() == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { print("panic:{reason}") }
                    .DeadlineBlown -> { print("deadline") }
                    .Cancelled -> { print("cancelled") }
                }
            }
            .Ok(_) -> { print("wrong cancel variant") }
        }
    }
}
fn run() -> {
    panic_rail()
    all_rail()
    deadline_rail()
    cancel_rail()
}
``
    assert_tiers_agree_with_application_policy("tir_task_failure_rail", src,
        "panic:boom (spawn site 0): boom\npanic:boom (spawn site 1): boom\ndeadline\ncancelled\n",
        "name: \"tir_support\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [Browser, DB, Env, Exec, FFI, FS, GPU, IO, Log, Mem.Alloc, Net, Rand, Secret, Time] }} }}\n")
}

