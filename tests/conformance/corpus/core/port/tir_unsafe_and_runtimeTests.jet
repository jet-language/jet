fn join_words(s: String) -> String {
    out := ""
    loop w in s.split(",") {
        out = "{out}[{w}]"
    }
    return out
}
fn run() -> {
    print(count_chars("hello"))
    print(join_words("a,b,c"))
}
``
    (code, stdout) :: build_and_run("tir_method_iter", src)
    assert_eq(code, 0)
