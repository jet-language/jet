// Rust: tests/tir_unsafe_and_runtime.rs:665
#Test("arena_alloc_reset_close") {
    if !have_rustc() { return }
    src :: ``
use core.mem
fn run() -> {
    arena :: mem.Arena.new()
    x :: arena.alloc(42)
    print(x)
    arena.reset()
    y :: arena.alloc(99)
    print(y)
    sized :: mem.Arena.new(capacity: 4096)
    s :: sized.alloc(7)
    print(s)
    pool :: mem.Pool.new(slots: 8)
    p :: pool.alloc(3)
    print(p)
    close(^arena)
}
``
    (code, stdout) :: build_and_run("tir_arena", src)
    assert_eq(code, 0)
    assert_eq(stdout, "42\n99\n7\n3\n")
}

