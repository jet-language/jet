// Rust: tests/comptime_sequence_parity.rs:5
use std.fs as fs
use tests.[common, tir_support]

// Rust: tests/comptime_sequence_parity.rs:392
fn check_aot_comptime(index: USize, name: String, preamble: String, expression: String) -> {
    src :: preamble + "\n" + `EXPECTED :: prep { ` + expression + ` }
fn run() -> {
    actual :: ` + expression + `
    print("{EXPECTED}")
    print("{actual}")
}
`
    // GATE #4494: real native compiler/subprocess runner, no Rust backend bridge.
    (code, stdout, stderr) :: common.build_and_run("jet_sequence", "jet_sequence_{index}", src)
    assert_eq(code, 0, "I2 violated for {name}: {stderr}")
    lines :: stdout.lines().collect()
    assert_eq(lines.len(), 2, "{name} output shape: {lines:Debug}")
    assert_eq(lines[0], lines[1], "{name} comptime/AOT mismatch")
    tir_support.assert_tiers_agree("sequence_{name}_{index}", src, stdout)
}

