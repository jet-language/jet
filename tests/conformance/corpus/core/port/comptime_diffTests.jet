fn run() -> {
    p :: Pair{left: 7, right: "seven"}
    l :: Light.Green
    print("{PAIR_VALUE.left}")
    print("{p.left}")
    print("{PAIR_VALUE.right}")
    print("{p.right}")
    print("{LIGHT_VALUE == Light.Green}")
    print("{l == Light.Green}")
}
""")
    assert_eq(stdout.lines().to_list(), ["7", "7", "seven", "seven", "true", "true"])
}

// Rust: tests/comptime_diff.rs:1137
#Test("if_expr_comptime_matches_runtime") {
    stdout :: compile_and_run("""
TRUE_VALUE :: prep { if 3 > 2 -> 10 else -> 20 }
FALSE_VALUE :: prep { if 1 > 2 -> 10 else -> 20 }
fn run() -> {
    c :: if 3 > 2 -> 10 else -> 20
    d :: if 1 > 2 -> 10 else -> 20
    print("{TRUE_VALUE}")
    print("{c}")
    print("{FALSE_VALUE}")
    print("{d}")
}
""")
    assert_eq(stdout.lines().to_list(), ["10", "10", "20", "20"])
}

// Rust: tests/comptime_diff.rs:1160
#Test("ordinary_bindings_fold_when_possible_and_silently_fall_back") {
    // Observe folding and the runtime-dependent fallback without inspecting a retired backend representation.
    src :: """
fn show(n: Int) -> {
    folded :: 40 + 2
    runtime :: n + 1
    print(folded)
    print(runtime)
}
fn run() -> { show(4) }
"""
    assert_eq(compile_and_run(src), "42\n5\n")
}
