use tests.conformance.corpus.core.port.comptime_diff.[CASES, F32_VALUE_FLOW, MODULE_CASES, LOADABLE_CASES, check_comptime_case, check_comptime_src, compile_and_run, test_parity_frame, parse_parity_output, assert_parity_output]
use tests.common as common
use jet.[Loader, Sema]
use std.thread as thread
use std.panic as panic_control
use std.sync.[Arc, Mutex]
use std.sync.atomic.[AtomicUsize, Ordering]

// Rust: tests/comptime_diff.rs:242
#Test("comptime_loadable_matches_runtime") {
    loop (i, src) in LOADABLE_CASES.iter().enumerate() {
        if payload :: panic_control.catch_unwind(|| -> check_comptime_src(10000 + i, "core.reactive.loadable", src)).err() {
            panic("Loadable case {i} failed: {common.panic_message(payload)}")
        }
    }
}

// Rust: tests/comptime_diff.rs:257
#Test("loadable_incompatible_defaults_stop_before_rustc") {
    loop (name, expression) in [("idle", "loadable.idle().or_else(7)"), ("loading", "loadable.loading().or_else(7)"), ("failed", "loadable.failed(\"offline\").or_else(7)"), ("loaded", "loadable.loaded(7).or_else(\"bad\")")] {
        src :: "use core.reactive.loadable as loadable\n\nfn run() -> {{\n    print({expression})\n}}\n"
        bundle := Loader.load_source_program(src, "loadable_default.jet").expect("load Loadable fixture")
        diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
        assert(!diags.is_empty(), "{name} incompatible fallback reached codegen")
        assert(diags.iter().any(|diag| -> diag.code == "E0112"), "{name} fallback missed the type mismatch: {diags.debug()}")
    }
}

// Rust: tests/comptime_diff.rs:284
// GATE #4494: shared atomics, mutex, panic capture and native worker threads.
#Test("comptime_matches_runtime") {
    next :: Arc.new(AtomicUsize.new(0))
    failures :: Arc.new(Mutex.new([String]{}))
    workers :: common.test_worker_count(16).min(CASES.len().max(1))
    handles := []
    loop _ in 0..<workers {
        next :: Arc.clone(next)
        failures :: Arc.clone(failures)
        &handles.push(thread.spawn(|| -> {
            loop {
                i :: next.fetch_add(1, Ordering.Relaxed)
                if i >= CASES.len() { break }
                if payload :: panic_control.catch_unwind(|| -> check_comptime_case(i, CASES[i])).err() {
                    &failures.lock().unwrap().push(common.panic_message(payload))
                }
            }
        }))
    }
    loop handle in handles { handle.join().unwrap() }
    failures :: failures.lock().unwrap()
    if !failures.is_empty() { panic(failures.join("\n\n")) }
}

