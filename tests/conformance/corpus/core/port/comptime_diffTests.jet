// Rust: tests/comptime_diff.rs:329
#Test("stream_generator_break_matches_comptime_and_runtime") {
    check_comptime_src(35000, "Stream generator early break", """
fn stop_after_two() -> Stream<Int> {
    yield 1
    yield 2
    yield 3
}
fn first() -> [Int] {
    return loop value in stop_after_two() -> {
        if value == 2 { break }
        value
    }
}
EXPECTED :: prep { first() }
fn run() -> {
    actual :: first()
    print("{EXPECTED}")
    print("{actual}")
}
""")
}

