// Rust: tests/comptime_diff.rs:443
#Test("comptime_exact_int_matches_runtime") {
    exact :: ["(9223372036854775807 + 1).to_string()", "(999999999999999999999999999999 + 999999999999999999999999999999).to_string()", "(100 - 1).to_string()", "(7 * 6).to_string()", "(2 ^ 200).to_string()", "(0 - 3).to_string()"]
    cases :: CASES.iter().enumerate().filter(|(_, expr)| -> exact.contains(expr)).to_list()
