// Rust: tests/comptime_diff.rs:557
#Test("sequential_comptime_reads_advance_the_shared_reader") {
    check_comptime_src(34001, "sequential compile-time reader reads", """
fn run() -> {
    ct :: prep { Reader.over([U8]{7, 9, 11}) }
    ct_a :: prep { ct.read_u8() ?? panic("ct a") }
    ct_b :: prep { ct.read_u8() ?? panic("ct b") }
    comptime_value :: prep { "{ct_a}|{ct_b}|{ct.remaining()}" }
    rt :: Reader.over([U8]{7, 9, 11})
    rt_a :: rt.read_u8() ?? panic("rt a")
    rt_b :: rt.read_u8() ?? panic("rt b")
    runtime_value :: "{rt_a}|{rt_b}|{rt.remaining()}"
    print("{comptime_value}")
    print("{runtime_value}")
}
""")
}

// Rust: tests/comptime_diff.rs:779
#Test("parity_frame_preserves_newlines_and_delimiter_like_bytes") {
    comptime :: "3\n__comptime_diff_frame(999)\n0\n".bytes()
    runtime :: "\n3\n__comptime_diff_frame(999)\n0".bytes()
    frame :: test_parity_frame(comptime, runtime)
    (decoded_comptime, decoded_runtime) :: parse_parity_output(frame).unwrap()
    assert_eq(decoded_comptime, comptime)
    assert_eq(decoded_runtime, runtime)
}

// Rust: tests/comptime_diff.rs:789
#Test("parity_frame_rejects_unequal_same_length_multiline_values") {
    frame :: test_parity_frame("alpha\nbeta".bytes(), "alpha\nzeta".bytes())
    failure :: panic_control.catch_unwind(|| -> assert_parity_output("adversarial", frame)).expect_err("unequal parity values must fail")
    message :: common.panic_message(failure)
    assert(message.contains("DIVERGENCE for `adversarial`"), message)
    assert(message.contains("beta") && message.contains("zeta"), message)
}

