// Rust: tests/tir_core_and_closures.rs:1392
#Test("card_2877_if_arm_explicit_copy_requires_tilde") {
    src :: `#Policy(copies: .Explicit)
fn run() -> {
    bytes :: [U8]{1}
    picked :: if bytes.len() == 0 -> { [U8]{9} } else -> { bytes }
    print(picked == bytes)
}
`
    diagnostics :: compile(src).expect_err("explicit-copy arm must be rejected")
    diagnostic :: diagnostics.iter().find(d -> { d.code == "E0120" }).expect("explicit-copy arm must report E0120")
    edit :: diagnostic.edit.expect("E0120 must carry the canonical copy edit")
    assert_eq(edit.new_text, "~")
    assert_eq(src[edit.span.start..edit.span.end], "")
}
