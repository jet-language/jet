fn run() -> {
    values :: [1, 2].map((n: Int) -> parse_default(n))
    print(values)
}
`
    assert_tiers_agree("tir_card_2860_default_helper_map", default_helper_map, "[1, 2]\n")
    explicit_ok_arms :: `fn choose(first: Bool) -> Int Err! { if first -> Ok(1) else -> Ok(2) }
fn run() -> {
    print(choose(true) ?? 0)
    print(choose(false) ?? 0)
}
`
    assert_tiers_agree("tir_card_2860_explicit_ok_arms", explicit_ok_arms, "1\n2\n")
}
