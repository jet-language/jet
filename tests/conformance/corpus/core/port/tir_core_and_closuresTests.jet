// Rust: tests/tir_core_and_closures.rs:138
#Test("core_files_absolute_path_read_matches_every_tier") {
    if !have_rustc() { return }
    repo :: OSPath.from_text(std.env.manifest_dir())
    dogfood_root :: OSPath.from_native(std.env.var_os("HOME").expect("HOME")).join(".cache/jet-dogfood").join("tir-absolute-path-read-{std.process.id()}")
    cache_root :: common.test_scratch_root("tir-core-fs-absolute-path").join(std.process.id().to_string())
    if cache_root.exists() { common.make_tree_writable(cache_root); fs.remove_dir_all(cache_root).unwrap() }
    fs.create_dir_all(cache_root).unwrap()
    fixture_source :: repo.join("dogfood/jetpack/tests/fixtures/phase1")
    fixture_root :: cache_root.join("phase1")
    stage_jetpack_phase1(fixture_source, fixture_root)
    outputs := [] as [(String, String)]
    loop (mode, release, interpret) in [("release", true, false), ("default", false, false), ("interpret", false, true)] {
        command := Command.new(std.env.cargo_bin_exe("jet"))
        command.arg("run")
        if release { command.arg("--release") }
        if interpret { command.arg("--interpret") }
        output :: command.arg("dogfood/jetpack").arg("--").args(["plan", "--json", "--offline"]).current_dir(repo).env("JET_STORE_DIR", cache_root.join("cache-{mode}")).env("JETPACK_DOGFOOD_ROOT", dogfood_root).env("JETPACK_PROJECT_ROOT", fixture_root).env("JETPACK_OFFLINE", "1").env("NO_COLOR", "1").output().unwrap()
        stdout :: String.from_utf8_lossy(output.stdout)
        stderr :: String.from_utf8_lossy(output.stderr)
        assert(output.status.success(), "{mode} absolute path read failed:\nstdout:\n{stdout}\nstderr:\n{stderr}")
        outputs.push((mode, stdout))
    }
    assert_eq(outputs[1].1, outputs[0].1, "default disagreed with release")
    assert_eq(outputs[2].1, outputs[0].1, "interpreter disagreed with release")
    common.make_tree_writable(cache_root)
    fs.remove_dir_all(cache_root).unwrap()
}
// Rust: tests/tir_core_and_closures.rs:217
#Test("closure_collection_methods") {
    if !have_rustc() { return }
    src :: `fn calc() -> Int {
    base := 10
    nums := [1, 2, 3, 4, 5]
    squares := nums.map((n: Int) -> (n * n))
    big := squares.filter((n: Int) -> (n > 5))
    shifted := nums.map((n: Int) -> (n + base))
    total := nums.reduce(0, (acc: Int, n: Int) -> (acc + n))
    has := nums.any((n: Int) -> (n > 4))
    every := nums.all((n: Int) -> (n > 0))
    print(big)
    print(shifted)
    print(has)
    print(every)
    return total
}
fn run() -> { print(calc()) }
`
    (code, stdout) :: build_and_run("tir_closure_methods", src)
    assert_eq(code, 0)
    assert_eq(stdout, "[9, 16, 25]\n[11, 12, 13, 14, 15]\ntrue\ntrue\n15\n")
}
// Rust: tests/tir_core_and_closures.rs:250
#Test("refined_collection_types_survive_tir_chains") {
    if !have_rustc() { return }
    src :: `fn use_float(value: Float) -> Float { return value + approx(1) / Float{4.0} }
fn run() -> {
    print(use_float([1, 2].fold(approx(1) / Float{2.0}, (a: Float, n: Int) -> a + approx(1) / Float{2.0})))
    print(use_float([1, 2].reduce(approx(1) / Float{2.0}, (a: Float, n: Int) -> a + approx(1) / Float{2.0})))
    print(use_float([1, 2].para_fold(() -> approx(1) / Float{2.0}, (a: Float, n: Int) -> a + approx(1) / Float{2.0}, (left: Float, right: Float) -> left + right)))
    print(use_float([1, 2].scan(approx(1) / Float{2.0}, (a: Float, n: Int) -> a + approx(1) / Float{2.0}).sum()))
    print(use_float([1, 2].map((n: Int) -> approx(3) / Float{2.0}).sum()))
    print(use_float(["1.5", "bad", "2.5"].filter_map((s: String) -> Float.parse(s)).sum()))
    print(use_float([1, 2].flat_map((n: Int) -> [approx(3) / Float{2.0}]).sum()))
    print([1, 2, 3].group_by((n: Int) -> n % 2 == 0).has_key(true))
    print([1, 2, 3].count_by((n: Int) -> n % 2).has_key(1))
    print([1, 2, 3].group_by((n: Int) -> "x").get("x"))
    print([1, 2, 3].count_by((n: Int) -> "x").get("x"))
}
`
    (code, stdout) :: build_and_run("tir_refined_collection_types", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1.75\n1.75\n1.75\n2.75\n3.25\n4.25\n3.25\ntrue\ntrue\n[1, 2, 3]\n3\n")
}
// Rust: tests/tir_core_and_closures.rs:283
#Test("parallel_collection_adapters_use_stable_bounded_chunks") {
    if !have_rustc() { return }
    values :: (0..130).map(n -> { n.to_string() }).collect().join(", ")
    src :: "fn double(n: Int) -> Int { return n * 2 }\nfn one() -> Int { return 1 }\nfn add_item(acc: Int, n: Int) -> Int { return acc + n }\nfn merge_decimal(left: Int, right: Int) -> Int { return left * 10000 + right }\nfn run() -> {\n    values :: [Int]{ {values} }\n" + `
    offset :: 1
    mapped :: values.para_map((n: Int) -> n * 2 + offset)
    named :: values.para_map(double)
    kept :: values.para_filter((n: Int) -> n % 32 == 0)
    split :: values.para_partition((n: Int) -> n % 32 == 0)
    fixed :: [Int#4]{ 1, 2, 3, 4 }
    fixed_split :: fixed.para_partition((n: Int) -> n % 2 == 0)
    empty :: [Int]{}
    // Deliberately non-associative internal tree-shape probe.
    folded :: values.para_fold(() -> 1, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left * 10000 + right)
    named_fold :: values.para_fold(one, add_item, merge_decimal)
    print("{mapped.len()}|{mapped.first()}|{mapped.last()}")
    print(named.last())
    print(kept)
    print(split.true_)
    print("{split.false_.len()}|{split.false_.first()}|{split.false_.last()}")
    print(fixed.para_map((n: Int) -> n + 1))
    print(fixed_split.false_)
    print(fixed_split.true_)
    print(empty.para_fold(() -> 7, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right))
    print(folded)
    print(named_fold)
}
`
    (code, stdout) :: build_and_run("tir_parallel_collection_chunks", src)
    assert_eq(code, 0)
    assert_eq(stdout, "130|1|259\n258\n[0, 32, 64, 96, 128]\n[0, 32, 64, 96, 128]\n125|1|129\n[2, 3, 4, 5]\n[1, 3]\n[2, 4]\n7\n201761130258\n201761130258\n")
}
