// Rust: tests/tir_core_and_closures.rs:1058
#Test("handle_methods_file_writer") {
    if !have_rustc() { return }
    tmp :: std.env.temp_dir().join("jet_tir_handle_{std.process.id()}.txt")
    path :: tmp.to_string_lossy().replace("\\", "\\\\")
    src :: "use core.files as files\nuse core.files as fs\nfn write_file(path: String, text: String) -> Int {\n    w := files.create(~path) ?? return 0\n    _r :: w.write_line(text)\n    _f :: w.flush()\n    return 1\n}\nfn run() -> {\n    done :: write_file(\"{path}\", \"hello handle\")\n    print(done)\n    contents :: fs.read(\"{path}\") ?? \"<none>\"\n    print(contents)\n}\n"
    (code, stdout) :: build_and_run("tir_handle_writer", src)
    _ :: fs.remove_file(tmp)
    assert_eq(code, 0)
    assert_eq(stdout, "1\nhello handle\n\n")
}
