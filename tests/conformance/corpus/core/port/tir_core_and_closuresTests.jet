    return n
}
fn run() -> {
    values :: [1, 0].map((n: Int) -> parse(n)) ?? {
        print(err.message)
        []
    }
    print(values)
}
`
    assert_tiers_agree("tir_card_2860_fallible_map", fallible_map, "bad\n[]\n")
