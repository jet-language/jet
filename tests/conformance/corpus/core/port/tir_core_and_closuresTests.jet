// Rust: tests/tir_core_and_closures.rs:700
#Test("fn_typed_param_call_routes_through_tir") {
    if !have_rustc() { return }
    src :: `fn apply(f: fn(Int) -> Int, x: Int) -> Int { return f(x) }
fn run() -> { print(apply((n: Int) -> (n + 1), 41)) }
`
    (code, stdout) :: build_and_run("tir_fn_param_excluded", src)
    assert_eq(code, 0)
    assert_eq(stdout, "42\n")
}
// Rust: tests/tir_core_and_closures.rs:722
#Test("block_lambda_preserves_value_tail_and_void_behavior") {
    if !have_rustc() { return }
    src :: `fn apply(f: fn(Int) -> Int, x: Int) -> Int { return f(x) }
fn visit(f: fn(Int), x: Int) -> { f(x) }
fn plus_one(x: Int) -> Int { return x + 1 }
fn run() -> {
    print(apply((n: Int) -> {
        doubled :: (n * 2)
        plus_one(doubled)
    }, 20))
    visit((n: Int) -> { print("seen {n}") }, 7)
}
`
    (code, stdout) :: build_and_run("tir_block_lambda_tail", src)
    assert_eq(code, 0, "block lambda generated Rust must compile")
    assert_eq(stdout, "41\nseen 7\n")
}
