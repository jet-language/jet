#Test("card_2860_fallible_carrier_projection_tier_parity") {
    handled_map :: `fn run() -> {
    values :: ["1", "2"].map(line -> { Int.parse(line) ?? panic("bad") })
    print(values)
}
`
    assert_tiers_agree("tir_card_2860_handled_map", handled_map, "[1, 2]\n")
    fallible_map :: `fn parse(n: Int) -> Int Err! {
