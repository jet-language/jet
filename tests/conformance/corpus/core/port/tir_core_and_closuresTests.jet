fn total(values: [Float]) -> Float {
    sum := Float{0}
    loop value in values -> sum += value
    return sum
}
fn run() -> {
    print(total(values(42)))
    loop seed in 1..<3 -> print(total(values(seed)))
}
`
    assert_tiers_agree("typed_float_heads_preserve_folded_and_runtime_values", src, "42.0\n2.0\n4.0\n")
}
