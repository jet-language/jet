// Rust: tests/crypto_entropy.rs:338
#Test("live_provider_obeys_bounds_zero_and_concurrency") {
    assert_eq(jet_crypto_entropy_bytes(0).unwrap(), [U8]{})
    filled := [U8]{0}.repeat(32)
    jet_crypto_entropy_fill(&filled).unwrap()
    assert_ne(filled, [U8]{0}.repeat(32))
    assert_eq(jet_crypto_entropy_bytes(-1), .Err(JetCryptoEntropyError.InvalidLength{operation: "core.crypto.random.bytes", parameter: "count", expected: "non-negative", actual: 1}))
    assert_eq(jet_crypto_entropy_bytes(1_048_577), .Err(JetCryptoEntropyError.OutputLength{operation: "core.crypto.random.bytes", minimum: 0, maximum: 1_048_576, actual: 1_048_577}))
    workers :: 8
    barrier :: Arc.new(Barrier.new(workers))
    joins :: (0..workers).map(|_| -> {
        worker_barrier :: Arc.clone(barrier)
        thread.spawn(move || -> {
            worker_barrier.wait()
            jet_crypto_entropy_bytes(64).unwrap()
        })
    }).collect()
    outputs :: joins.into_iter().map(|j| -> j.join().unwrap()).collect()
    assert(outputs.iter().all(|bytes| -> bytes.len() == 64))
    loop i in 0..outputs.len() {
        loop j in (i + 1)..outputs.len() { assert_ne(outputs[i], outputs[j]) }
    }
}

