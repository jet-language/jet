// Rust: tests/crypto_entropy.rs:767-861
#Test("entropy_unavailable_propagates_through_every_consumer_on_all_tiers") {
    if target.selected_os() != .Linux { return }
    arch :: target.selected_arch()
    if arch != "x86_64" && arch != "aarch64" { return }
    assert(common.have_rustc(), "AOT parity requires rustc")
    consumers :: [
        ("bytes", `use core.crypto.random as random
fn run() -> {
    print("before")
    secret :: random.bytes(32) ?? {
        print("typed failure")
        return
    }
    print("drew {secret.len()} bytes")
}
`),
        ("uuid", `use core.crypto.uuid as uuid
fn run() -> {
    print("before")
    id :: uuid.v4() ?? {
        print("typed failure")
        return
    }
    print("drew {id}")
}
`),
        ("keygen", `use core.crypto as crypto
fn run() -> {
    print("before")
    key :: crypto.generatekey() ?? {
        print("typed failure")
        return
    }
    print("drew a key: {key.public_key().bytes.len()} public bytes")
}
`),
    ]
    scratch :: common.Scratch.new("crypto-entropy-unavailable")
    fs.write(scratch.join("package.jet"), "name: \"entropy-unavailable\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc, Rand] } }\n").unwrap()
    jet_bin :: env.var("CARGO_BIN_EXE_jet").unwrap()
    normalize :: |bytes: [U8]| -> String.from_utf8_lossy(bytes).replace(scratch.path.display().to_string(), "$CASE")
    loop (name, source) in consumers {
        file :: "{name}.jet"
        fs.write(scratch.join(file), source).unwrap()
        cache :: scratch.join("cache-{name}")
        build :: Command.new(jet_bin).args(["build", file]).current_dir(scratch.path).env("JET_STORE_DIR", cache.join("aot")).env("NO_COLOR", "1").output().unwrap()
        assert(build.status.success(), "{name}: AOT build failed:\n{String.from_utf8_lossy(build.stderr)}")
        observed_tiers := []
        loop (tier, command) in [
            ("aot", Command.new(scratch.join(".jet").join("build").join(name))),
            ("default run", Command.new(jet_bin).args(["run", file])),
            ("interpreter", Command.new(jet_bin).args(["run", "--interpret", file])),
        ] {
            output :: without_os_entropy(&command).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("run")).env("JET_STORE_DIR", cache.join("build")).env("NO_COLOR", "1").output().unwrap()
            observed :: (output.status.code(), normalize(output.stdout), normalize(output.stderr))
            assert(observed.1.starts_with("before\n") && not observed.1.contains("drew"), "{name} on {tier} produced a value without entropy: {observed.debug()}")
            assert(observed.1.contains("typed failure") || (observed.0 != Val(0) && observed.2.contains("could not provide cryptographic randomness")), "{name} on {tier} did not report the entropy failure: {observed.debug()}")
            observed_tiers.push((tier, observed))
        }
        (first_tier, first) :: observed_tiers[0]
        loop (tier, observed) in observed_tiers[1..] { assert_eq(observed, first, "{name}: {tier} differs from {first_tier} without entropy") }
    }
}
