}

// Rust: tests/crypto_entropy.rs:238
#Test("wasi_interrupt_retries_zeroize_each_exact_count_buffer") {
    lifecycle :: Rc.new(RefCell.new([]))
    observed_lifecycle :: Rc.clone(lifecycle)
    jet_crypto_entropy_set_wasi_attempt_test_observer(move |event, generation, bytes| -> {
        observed_lifecycle.borrow_mut().push((event, generation, bytes.to_vec()))
    })
    zeroized :: Rc.new(RefCell.new([[U8]]{}))
    observed :: Rc.clone(zeroized)
    jet_crypto_entropy_set_zeroize_test_observer(move |bytes| -> { observed.borrow_mut().push(bytes.to_vec()) })
    calls := 0
    bytes :: jet_crypto_entropy_wasi_with_for_test(32, |out| -> {
        assert_eq(out.len(), 32)
        calls += 1
        if calls < 3 { out[0..4].fill(0xa5); 27 } else { out.fill(7); 0 }
    }).unwrap()
    assert_eq(bytes, [U8]{7}.repeat(32))
    assert_eq(calls, 3)
    jet_crypto_entropy_clear_zeroize_test_observer()
    jet_crypto_entropy_clear_wasi_attempt_test_observer()
    assert_eq(zeroized.borrow(), [[U8]{0}.repeat(32), [U8]{0}.repeat(32)])
    events :: lifecycle.borrow()
    live_attempt := None
    generations := []
    loop (event, generation, snapshot) in events.iter() {
        if event == {
            .Created -> {
                assert(live_attempt.replace(generation).is_none())
                assert_eq(snapshot, [U8]{0}.repeat(32))
                generations.push(generation)
            }
            .ProviderReturned(27) -> {
                assert_eq(live_attempt, Val(generation))
                assert_eq(snapshot[0..4], [U8]{0xa5}.repeat(4))
            }
            .ProviderReturned(0) -> {
                assert_eq(live_attempt, Val(generation))
                assert_eq(snapshot, [U8]{7}.repeat(32))
            }
            .Zeroized -> {
                assert_eq(live_attempt, Val(generation))
                assert_eq(snapshot, [U8]{0}.repeat(32))
            }
            .Released | .Returned -> { assert_eq(live_attempt.take(), Val(generation)) }
            .ProviderReturned(errno) -> { panic("unexpected WASI errno {errno}") }
        }
    }
    assert_eq(generations, [0, 1, 2])
    assert(live_attempt.is_none())
    assert(not bytes.contains(0xa5))
}

// Rust: tests/crypto_entropy.rs:306
#Test("wasi_stops_after_seventeen_interrupts") {
    generations :: Rc.new(RefCell.new([]))
    observed :: Rc.clone(generations)
    jet_crypto_entropy_set_wasi_attempt_test_observer(move |event, generation, bytes| -> {
        if event == JetCryptoWasiAttemptEvent.Released {
            assert(bytes.is_empty())
            observed.borrow_mut().push(generation)
        }
    })
    calls := 0
    result :: jet_crypto_entropy_wasi_with_for_test(8, |out| -> { calls += 1; out.fill(0xa5); 27 })
    assert_eq(result, .Err(JetCryptoEntropyError.EntropyUnavailable))
    assert_eq(calls, 17)
    jet_crypto_entropy_clear_wasi_attempt_test_observer()
    assert_eq(generations.borrow(), (0..17).collect())
}

