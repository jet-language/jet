// Rust: tests/crypto_entropy.rs:394
#Test("live_provider_remains_independent_across_process_exec") {
    if target.selected_os() != .Linux { return }
    parent_bytes :: jet_crypto_entropy_bytes(64).unwrap()
    child := Command.new(env.current_exe().unwrap()).args(["--exact", "live_provider_subprocess_child", "--nocapture"]).env("JET_CRYPTO_ENTROPY_SUBPROCESS", "1").stdout(Stdio.piped()).spawn().unwrap()
    deadline :: Instant.now() + Duration.from_secs(5)
    status :: loop {
        maybe_status :: child.try_wait().unwrap()
        if maybe_status == Val(status) { break status }
        if Instant.now() >= deadline {
            _ :: child.kill()
            _ :: child.wait()
            panic("entropy subprocess exceeded five-second deadline")
        }
        thread.sleep(Duration.from_millis(10))
    }
    assert(status.success(), "entropy subprocess failed: {status}")
    stdout := ""
    child.stdout.take().unwrap().read_to_string(&stdout).unwrap()
    encoded :: stdout.lines().find_map(|line| -> line.split_once("JET_CRYPTO_ENTROPY=").map(|(_, hex)| -> hex)).expect("child emitted entropy marker")
    assert_eq(encoded.len(), 128)
    assert(encoded.bytes().all(|byte| -> byte.is_ascii_hexdigit()))
    parent_encoded :: parent_bytes.iter().map(|byte| -> byte.to_string_radix(16).pad_start(2, "0")).collect().join("")
    assert_ne(encoded, parent_encoded)
}

