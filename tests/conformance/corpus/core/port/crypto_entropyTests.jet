// Rust: tests/crypto_entropy.rs:22
#Test("crypto_error_display_contract_is_exact_and_redacted") {
    cases :: [
        (JetCryptoEntropyError.InvalidLength{operation: "seal", parameter: "key", expected: "exactly 32", actual: 31}, "seal: key must be exactly 32; got 31"),
        (JetCryptoEntropyError.InvalidEncoding{operation: "PasswordHash.parse", value_kind: "PHC string"}, "PasswordHash.parse: PHC string is not canonical"),
        (JetCryptoEntropyError.UnsupportedVersion{operation: "PasswordHash.parse", version: 16}, "PasswordHash.parse: version 16 is not supported"),
        (JetCryptoEntropyError.UnsupportedAlgorithm{operation: "PasswordHash.parse", algorithm: "argon2i"}, "PasswordHash.parse: algorithm argon2i is not supported"),
        (JetCryptoEntropyError.OpenFailed, "encrypted data could not be opened"),
        (JetCryptoEntropyError.NonContributoryKey, "X25519 peer key does not contribute to a shared secret"),
        (JetCryptoEntropyError.OutputLength{operation: "hkdf_sha256", minimum: 0, maximum: 8160, actual: 8161}, "hkdf_sha256: output length must be 0..8160; got 8161"),
        (JetCryptoEntropyError.PasswordPolicy{reason: "public-policy-id"}, "password hash is outside Jet's accepted policy"),
        (JetCryptoEntropyError.EntropyUnavailable, "the operating system could not provide cryptographic randomness"),
        (JetCryptoEntropyError.ResourceUnavailable{resource: "Argon2 worker pool"}, "Argon2 worker pool is unavailable for this cryptographic operation"),
        (JetCryptoEntropyError.Internal{incident_id: "crypto-17"}, "Jet could not preserve a cryptographic invariant; incident crypto-17"),
    ]
    loop (error, expected) in cases {
        assert_eq(error.to_string(), expected)
        rendered :: "{error.debug()} {error}"
        loop forbidden in ["hunter2", "plaintext sentinel", "ciphertext sentinel", "/home/nate"] {
            assert(not rendered.contains(forbidden), "error leaked `{forbidden}`: {rendered}")
        }
    }
}

// Rust: tests/crypto_entropy.rs:113
#Test("actual_bridge_fixture_compiles_and_runs") {
    root :: env.current_dir().unwrap()
    dir :: env.temp_dir().join("jet-crypto-bridge-entropy-{id()}")
    // #4409 preserves NotFound versus all other pre-cleanup errors.
    if fs.remove_dir_all(dir) == {
        .Ok(()) -> {}
        .Err(error) -> {
            if error.kind() != .NotFound { panic("crypto bridge fixture pre-cleanup failed for {dir.display()}: {error}") }
        }
    }
    fs.create_dir_all(dir.join("src")).unwrap()
    fs.write(dir.join("Cargo.toml"), `
[package]
name = "jet-crypto-entropy-proof"
version = "0.0.0"
edition = "2021"
[workspace]
[dependencies]
aes-gcm = "0.10"
argon2 = { version = "=0.5.3", default-features = false, features = ["alloc", "password-hash"] }
blake3 = "1"
chacha20poly1305 = "0.10"
ed25519-dalek = "2"
hkdf = "0.12"
sha2 = "0.10"
subtle = "2"
x25519-dalek = "2"
`).unwrap()
    fixture :: root.join("tests/fixtures/crypto_bridge_entropy.rs")
    // Exact backend bridge projection remains a test comparator, not a product provider.
    fs.write(dir.join("src/lib.rs"), "#![allow(non_snake_case, dead_code)]\n" + jet_pkg_model.FFI.crypto_bridge_root_modules() + "\n" + jet_pkg_model.FFI.crypto_bridge_entropy_runtime() + "\ninclude!(" + fixture.debug() + ");\n").unwrap()
    output :: Command.new("cargo").args(["test", "--offline", "--quiet", "--manifest-path"]).arg(dir.join("Cargo.toml")).env("CARGO_TARGET_DIR", dir.join("target")).output().unwrap()
    cleanup :: fs.remove_dir_all(dir)
    assert(cleanup.is_ok(), "bridge proof left temporary artifacts")
    assert(output.status.success(), "bridge proof failed:\nstdout:\n{String.from_utf8_lossy(output.stdout)}\nstderr:\n{String.from_utf8_lossy(output.stderr)}")
}

// Rust: tests/crypto_entropy.rs:178
#Test("scripted_provider_fills_suffix_and_retries_interruption") {
    out := [U8]{0}.repeat(7)
    calls := 0
    jet_crypto_entropy_fill_with(&out, |suffix| -> {
        calls += 1
        if calls == {
            1 -> {
                suffix[0..2].copy_from_slice([U8]{1, 2})
                JetCryptoEntropyStep.Filled(2)
            }
            2 -> JetCryptoEntropyStep.Interrupted
            3 -> {
                suffix.copy_from_slice([U8]{3, 4, 5, 6, 7})
                JetCryptoEntropyStep.Filled(5)
            }
            _ -> unreachable()
        }
    }).unwrap()
    assert_eq(out, [U8]{1, 2, 3, 4, 5, 6, 7})
    assert_eq(calls, 3)
}

// Rust: tests/crypto_entropy.rs:202
#Test("failure_and_zero_fill_clear_the_entire_attempt") {
    loop terminal in [JetCryptoEntropyStep.Filled(0), JetCryptoEntropyStep.Failed] {
        out := [U8]{0xa5}.repeat(32)
        err :: jet_crypto_entropy_fill_with(&out, |suffix| -> {
            suffix[0..8].fill(0x5a)
            terminal
        }).unwrap_err()
        assert_eq(err, JetCryptoEntropyError.EntropyUnavailable)
        assert_eq(out, [U8]{0}.repeat(32), "tainted attempt must be zeroized")
    }
}

