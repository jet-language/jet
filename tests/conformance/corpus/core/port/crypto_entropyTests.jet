// Rust: tests/crypto_entropy.rs:507
#Test("auth_tokens_are_opaque_and_fail_closed_without_entropy") {
    auth_session_regression.FAIL_ENTROPY.store(false, Ordering.Relaxed)
    // Canonical provider injection replaces Rust include-time name shadowing.
    jet_crypto_entropy_set_test_provider(|suffix| -> {
        if auth_session_regression.jet_crypto_entropy_bytes(suffix.len() as I64) == {
            .Ok(bytes) -> { suffix.copy_from_slice(bytes); JetCryptoEntropyStep.Filled(suffix.len()) }
            .Err(_) -> JetCryptoEntropyStep.Failed
        }
    })
    user :: "auth-regression-{id()}@example.com"
    jet_auth_register_user(user, "password-hash").unwrap()
    first :: jet_auth_password_login(user, "password-hash", 0, 1_000).unwrap()
    second :: jet_auth_password_login(user, "password-hash", 0, 1_000).unwrap()
    assert(first.id.starts_with("sess-"))
    assert(second.id.starts_with("sess-"))
    assert_ne(first.id, second.id)
    magic :: jet_auth_magic_link_issue(user, 0, 1_000).unwrap()
    assert(magic.starts_with("magic-"))
    assert_ne(magic, "magic-" + "00".repeat(32))
    assert(jet_auth_magic_link_consume(magic, 0, 1_000).is_ok())
    auth_session_regression.FAIL_ENTROPY.store(true, Ordering.Relaxed)
    assert(jet_auth_password_login(user, "password-hash", 0, 1_000).is_err())
    assert(jet_auth_magic_link_issue(user, 0, 1_000).is_err())
    jet_crypto_entropy_clear_test_provider()
}

// Rust: tests/crypto_entropy.rs:532
#Test("uuid_entropy_shared_seam_is_live_and_fail_closed") {
    first :: jet_crypto_uuid_v4_result().expect("live entropy should produce UUID v4")
    second :: jet_crypto_uuid_v4_result().expect("live entropy should produce UUID v4")
    assert_ne(first, second, "UUID v4 must use live entropy for each call")
    ordered :: jet_crypto_uuid_v7_result(1_700_000_000_000).expect("live entropy should produce UUID v7")
    assert_eq(ordered[14..15], "7")
    jet_crypto_entropy_set_test_provider(|out| -> { out.fill(0xa5); JetCryptoEntropyStep.Failed })
    v4 :: jet_crypto_uuid_v4_result()
    v7 :: jet_crypto_uuid_v7_result(1_700_000_000_000)
    jet_crypto_entropy_clear_test_provider()
    assert_eq(v4, .Err(JetCryptoEntropyError.EntropyUnavailable))
    assert_eq(v7, .Err(JetCryptoEntropyError.EntropyUnavailable))
}

// Rust: tests/crypto_entropy.rs:553
// Retired Cranelift representation/trace checks become O0/O1/O2 behavior parity.
#Test("live_crypto_entropy_and_uuid_match_interpreter_resident_jit_and_aot") {
    assert(common.have_rustc(), "AOT parity requires rustc")
    SOURCE :: `
use core.crypto.random as crypto
use core.time as time
use core.crypto.uuid as uuid
fn run() -> {
    first :: crypto.bytes(32) ?? return
    second :: crypto.bytes(32) ?? return
    print(first.len() == 32)
    print(first != second)
    v4a :: uuid.v4() ?? return
    v4b :: uuid.v4() ?? return
    print(v4a.len() == 36)
    print(v4a != v4b)
    clk := Clock.new(1_700_000_000_000)
    v7 :: uuid.v7(&clk) ?? return
    print(v7.len() == 36)
    print(v7.slice(14, 15) == "7")
}
`
    expected :: "true\ntrue\ntrue\ntrue\ntrue\ntrue\n"
    dir :: common.unique_tmp("jet_crypto_entropy_parity")
    result :: std.panic.catch_unwind(std.panic.AssertUnwindSafe(|| -> {
        fs.create_dir_all(dir).unwrap()
        path :: dir.join("parity.jet")
        fs.write(path, SOURCE).unwrap()
        shown :: path.to_string_lossy().to_string()
        bundle := jet.Loader.load_entry(shown).expect("parity bundle should load")
        diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
        assert(diagnostics.iter().all(|diagnostic| -> diagnostic.severity != jet.Diagnostics.Severity.Error), "parity source must type-check: {diagnostics.debug()}")
        // No backend-identity assertion remains: require actual execution at each tier.
        tiers.assert_tiers_agree("jet_crypto_entropy_parity", SOURCE, expected)
        aot :: common.build_and_run("jet_crypto_entropy_parity", "parity", SOURCE)
        assert_eq(aot, (0, expected, ""))
    }))
    if (result, fs.remove_dir_all(dir)) == {
        (.Ok(()), .Ok(())) -> {}
        (.Ok(()), .Err(error)) -> { panic("crypto entropy parity artifact cleanup failed for {dir.display()}: {error}") }
        (.Err(payload), .Ok(())) -> { std.panic.resume_unwind(payload) }
        (.Err(payload), .Err(error)) -> {
            eprintln("crypto entropy parity artifact cleanup failed for {dir.display()}: {error}")
            std.panic.resume_unwind(payload)
        }
    }
}

// Rust: tests/crypto_entropy.rs:665-686
#Test("golden_i1_scan_strips_only_the_vetted_entropy_module") {
    source :: `use core.crypto.random as random
fn run() -> {
    drawn :: random.bytes(16) ?? return
    print("i1-user-marker {drawn.len()}")
}
`
    dir :: common.unique_tmp("jet_crypto_entropy_i1")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("i1.jet")
    fs.write(path, source).unwrap()
    shown :: path.to_string_lossy().to_string()
    compiled :: jet.compile_with_path(source, shown).unwrap_or_else(|diagnostics| -> { panic(jet.render_diagnostics(shown, source, diagnostics)) })
    _ :: fs.remove_dir_all(dir)
    assert(compiled.rust.contains("fn getrandom("), "a crypto program must embed the OS entropy provider")
    user :: common.strip_vetted_prelude_modules(compiled.rust)
    assert(not user.contains("fn getrandom("), "the audited provider survived the I1 scan")
    assert(not user.contains("mod jet_crypto_entropy"), "the provider module survived the I1 scan")
    assert(user.contains("i1-user-marker"), "the I1 scan removed user code")
}

