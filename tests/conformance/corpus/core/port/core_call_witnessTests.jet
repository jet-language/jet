#Test("non_corpus_printing_fixture_cannot_succeed_silently") {
    (jit_code, jit_stdout, jit_stderr) :: jit_run("core_call_witness_jit", PRINTING_FIXTURE)
    assert_not_silent("default JIT", jit_code, jit_stdout, jit_stderr)
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: interpreter_run("core_call_witness_interpreter", PRINTING_FIXTURE)
    assert_not_silent("forced interpreter", interpreter_code, interpreter_stdout, interpreter_stderr)
    if have_rustc() {
        (aot_code, aot_stdout, aot_stderr) :: build_and_run_full("jet_core_call_witness", "core_call_witness_aot", PRINTING_FIXTURE)
