fn jet() -> OSPath { OSPath.from(env.var("CARGO_BIN_EXE_jet").unwrap()) }
// Rust: tests/memory_semantics.rs:167
fn run(root: OSPath, args: [String]) -> Output {
    Command.new(jet()).args(args).current_dir(root).env("NO_COLOR", "1")
        .env("JET_MEMORY_LEDGER", root.join(".jet/memory/ledger-v1.jsonl")).output().unwrap()
}
// Rust: tests/memory_semantics.rs:179
fn assert_cli_snapshot(name: String, actual: [U8]) -> {
    expected :: fs.read(OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/cli").join(name)).unwrap()
    assert_eq(actual, expected, "CLI snapshot mismatch: {name}")
}
// Rust: tests/memory_semantics.rs:189
fn ledger(root: OSPath, rows: [String]) -> {
    path :: root.join(".jet/memory/ledger-v1.jsonl")
    fs.create_dir_all(path.parent().unwrap()).unwrap()
    fs.write(path, rows.join("\n") + "\n").unwrap()
}
// Rust: tests/memory_semantics.rs:195
fn row(kind: String, code: String, repairs: [String]) -> String {
    encoded_repairs :: repairs.iter().map(repair -> "\"{repair}\"").collect().join(",")
    "\{\"schema\":\"jet.memory.ledger\",\"version\":1,\"kind\":\"{kind}\",\"code\":\"{code}\",\"source\":\"main.jet\",\"span_start\":0,\"span_end\":6,\"byte_spans\":true,\"scope\":\"run\",\"provenance\":\"fixture\",\"detail\":\"observed\",\"expected\":\"borrow\",\"repairs\":[{encoded_repairs}]\}"
}
