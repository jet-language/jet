use jet
use jet.Interpreter.[dev_iteration, RunOutcome]
use std.sync.atomic.[AtomicU64, Ordering]
use tir_support.[build_and_run_full, build_and_run_multi, have_rustc]

// Rust: tests/numeric_widening.rs:11
INTERPRETER_SEQ :: AtomicU64.new(0)
// Rust: tests/numeric_widening.rs:14
fn compile_ok(source: String) -> jet.CompileOutput {
    jet.compile(source) ?? panic("numeric widening fixture was rejected:\n{jet.render_diagnostics(\"numeric_widening.jet\", source, err)}")
}
// Rust: tests/numeric_widening.rs:23
fn compile_error(source: String) -> String {
    diagnostics :: jet.compile(source).expect_err("numeric fixture unexpectedly compiled")
    jet.render_diagnostics("numeric_widening.jet", source, diagnostics)
}
// Rust: tests/numeric_widening.rs:28
fn write_program(name: String, files: [(String, String)]) -> OSPath {
    sequence :: INTERPRETER_SEQ.fetch_add(1, Ordering.Relaxed)
    dir :: env.temp_dir().join("jet_numeric_widen_{name}_{std.process.id()}_{sequence}")
    fs.create_dir_all(dir).unwrap()
    loop (relative, source) in files {
        path :: dir.join(relative)
        if parent :: path.parent() { fs.create_dir_all(parent).unwrap() }
        fs.write(path, source).unwrap()
    }
    dir.join("main.jet")
}
// Rust: tests/numeric_widening.rs:47
fn run_in_process(name: String, files: [(String, String)], force_interpreter: Bool) -> RunOutcome {
    path :: write_program(name, files)
    dev_iteration(path.to_str().unwrap(), false, force_interpreter)
}
// Rust: tests/numeric_widening.rs:52
fn run_interpreter(name: String, source: String) -> (I32, String, String) {
    run_in_process(name, [("main.jet", source)], true) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> (exit_code, stdout, stderr)
        RunOutcome.Problems(diagnostics) -> panic("forced interpreter rejected numeric widening: {diagnostics:#?}")
    }
}
// Rust: tests/numeric_widening.rs:65
// Retired JIT trace flags and synchronization map to the default shared O0 CLI
// execution. No JIT representation/deoptimization substrate remains.
fn run_resident(name: String, files: [(String, String)]) -> RunOutcome {
    (exit_code, stdout, stderr) :: tir_support.run_default_multi(name, "main.jet", files)
    RunOutcome.Ran{stdout: ^stdout, stderr: ^stderr, exit_code}
}
// Rust: tests/numeric_widening.rs:84
fn assert_all_tiers(name: String, source: String, expected_code: I32, expected_stdout: String) -> {
    if have_rustc() {
        (code, stdout, stderr) :: build_and_run_full("jet_numeric_widen_aot", name, source)
        assert_eq(code, expected_code, "AOT stderr:\n{stderr}")
        assert_eq(stdout, expected_stdout, "AOT stderr:\n{stderr}")
    }
    run_resident(name, [("main.jet", source)]) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, expected_code, "default-O0 stderr:\n{stderr}")
            assert_eq(stdout, expected_stdout, "default-O0 stderr:\n{stderr}")
        }
        RunOutcome.Problems(diagnostics) -> panic("default O0 rejected numeric widening: {diagnostics:#?}")
    }
    (code, stdout, stderr) :: run_interpreter(name, source)
    assert_eq(code, expected_code, "interpreter stderr:\n{stderr}")
    assert_eq(stdout, expected_stdout, "interpreter stderr:\n{stderr}")
}
// Rust: tests/numeric_widening.rs:110
fn assert_all_tiers_multi(name: String, files: [(String, String)], expected_code: I32, expected_stdout: String) -> {
    if have_rustc() {
        (code, stdout) :: build_and_run_multi(name, "main.jet", files)
        assert_eq(code, expected_code, "multi-file AOT exit drift")
        assert_eq(stdout, expected_stdout, "multi-file AOT output drift")
    }
    run_resident(name, files) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, expected_code, "default-O0 stderr:\n{stderr}")
            assert_eq(stdout, expected_stdout, "default-O0 stderr:\n{stderr}")
        }
        RunOutcome.Problems(diagnostics) -> panic("default O0 rejected imported numeric widening: {diagnostics:#?}")
    }
    run_in_process(name, files, true) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, expected_code, "interpreter stderr:\n{stderr}")
            assert_eq(stdout, expected_stdout, "interpreter stderr:\n{stderr}")
        }
        RunOutcome.Problems(diagnostics) -> panic("interpreter rejected imported numeric widening: {diagnostics:#?}")
    }
}
// Rust: tests/numeric_widening.rs:151
fn assert_trap_all_tiers(name: String, source: String) -> {
    // Rust: tests/numeric_widening.rs:152
    MESSAGE :: "whole number cannot cross into the decimal without losing precision"
    if have_rustc() {
        (code, stdout, stderr) :: build_and_run_full("jet_numeric_widen_aot", name, source)
        assert_eq(code, 70, "AOT stderr:\n{stderr}")
        assert(stdout.is_empty(), "AOT stdout:\n{stdout}")
        assert(stderr.contains(MESSAGE), "AOT stderr:\n{stderr}")
        assert(stderr.contains("[E3010]"), "AOT stderr:\n{stderr}")
    }
    run_resident(name, [("main.jet", source)]) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 70, "default-O0 stderr:\n{stderr}")
            assert(stdout.is_empty(), "default-O0 stdout:\n{stdout}")
            assert(stderr.contains(MESSAGE), "default-O0 stderr:\n{stderr}")
            assert(stderr.contains("[E3010]"), "default-O0 stderr:\n{stderr}")
        }
        RunOutcome.Problems(diagnostics) -> {
            assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0953" && diagnostic.why.contains(MESSAGE)), "default-O0 diagnostics: {diagnostics:#?}")
        }
    }
    sequence :: INTERPRETER_SEQ.fetch_add(1, Ordering.Relaxed)
    dir :: env.temp_dir().join("jet_numeric_widen_interpreter_trap_{name}_{std.process.id()}_{sequence}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, source).unwrap()
    dev_iteration(path.to_str().unwrap(), false, true) == {
        RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 70, "interpreter stderr:\n{stderr}")
            assert(stdout.is_empty(), "interpreter stdout:\n{stdout}")
            assert(stderr.contains(MESSAGE), "interpreter stderr:\n{stderr}")
            assert(stderr.contains("[E3010]"), "interpreter stderr:\n{stderr}")
        }
        RunOutcome.Problems(diagnostics) -> {
            assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0953" && diagnostic.why.contains(MESSAGE)), "interpreter diagnostics: {diagnostics:#?}")
        }
    }
}
