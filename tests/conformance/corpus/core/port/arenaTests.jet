    loop path in ["crates/jet-comptime/src/Comptime/Builtins.rs", "crates/jet-codegen/src/Codegen/TIR/eval/handles.rs"] {
        assert(read(path).contains("Core/Duration.rs"), "{path} must include the duration kernel")
    }
    pure :: read("crates/jet-comptime/src/Comptime/CorePureParity.rs")
    old_core :: read("crates/jet-codegen/src/Prelude/Core.rs")
    jit_time :: read("crates/jet-jit/src/Time.rs")
    jit_build :: read("crates/jet-jit/build.rs")
    loop fingerprint in ["365 * y + y / 4 - y / 100", "RFC3339 datetime needs Z or an offset", "value.checked_mul(scale)"] {
        assert(not pure.contains(fingerprint), "comptime copied `{fingerprint}`")
        assert(not old_core.contains(fingerprint), "Core.rs copied `{fingerprint}`")
        assert(not jit_time.contains(fingerprint), "JIT copied `{fingerprint}`")
    }
    assert(not jit_build.contains("write_time_rt"))
