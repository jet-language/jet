// Rust: tests/comptime_core_one_home.rs:9
fn read(path: String) -> String {
    fs.read_to_string(OSPath.new(env.var("CARGO_MANIFEST_DIR").unwrap()).join(path)).unwrap_or_else(|error| -> panic("read {path}: {error}"))
}
// Rust: tests/comptime_core_one_home.rs:14
fn dispatched_namespaces(source: String) -> [String:Bool] {
    namespaces := [String:Bool]{}
    loop (start, _) in source.match_indices("(\"core.") {
        namespace :: source[start + 2..]
        if namespace.find('"') is Val(end) { namespaces[namespace[..end].trim_end_matches('.').to_string()] = true }
    }
    namespaces
}
// Rust: tests/comptime_core_one_home.rs:26
#Test("architecture_classifies_every_comptime_core_namespace") {
    namespaces := dispatched_namespaces(read("crates/jet-comptime/src/Comptime/Methods/core_calls.rs"))
    loop path in ["crates/jet-comptime/src/Comptime/Methods/core_calls/impure.rs", "crates/jet-comptime/src/Comptime/CorePureParity.rs"] {
        loop namespace in dispatched_namespaces(read(path)).keys() { namespaces[namespace] = true }
    }
    namespaces["core.compute.solve"] = true
    architecture :: read("Docs/spec/architecture.md")
    keys := namespaces.keys().collect()
    &keys.sort()
    loop namespace in keys { assert(architecture.contains("| `{namespace}` |"), "architecture classification is missing {namespace}") }
}
// Rust: tests/comptime_core_one_home.rs:50
#Test("mime_and_email_have_one_semantic_home") {
    codegen :: read("crates/jet-codegen/src/Codegen/mod.rs")
    core_calls :: read("crates/jet-comptime/src/Comptime/Methods/core_calls.rs")
    pure :: read("crates/jet-comptime/src/Comptime/CorePureParity.rs")
    url_mime :: read("crates/jet-codegen/src/Prelude/CoreLib/JetStd/UrlMime.rs")
    kernel :: "JetStd/Mime.rs"
    assert(codegen.contains(kernel), "AOT must embed {kernel}")
    assert(core_calls.contains(kernel), "comptime/interpreter must include {kernel}")
    assert(codegen.contains("CoreLib/Email.rs"), "AOT must embed email kernel")
    jit :: read("crates/jet-jit/src/Net.rs")
    assert(read("crates/jet-comptime/src/Comptime/EmailAdapter.rs").contains("CoreLib/Email.rs"))
    assert(jit.contains("CoreLib/Email.rs"))
    assert(jit.contains("CoreLib/JetStd/UrlMime.rs"))
    assert(not pure.contains("fn email_"), "comptime must not regain an email implementation")
    assert(not pure.contains("\"html\" | \"htm\" => Some(\"text/html\")"))
    assert(url_mime.starts_with("    include!(\"Mime.rs\");"))
    assert(not url_mime.contains("fn jet_mime_token"))
}
