        assert(not pure.contains(fingerprint), "comptime copied `{fingerprint}`")
        assert(not core.contains(fingerprint), "Core.rs copied `{fingerprint}`")
        assert(not jit.contains(fingerprint), "JIT copied `{fingerprint}`")
    }
    assert(not build.contains("write_sketch_rt"))
}
