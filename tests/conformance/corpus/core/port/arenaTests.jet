// Rust: tests/base_encoding_2026.rs:5
BASE64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".as_bytes()
// Rust: tests/base_encoding_2026.rs:7
fn digit(byte: U8) -> U8? { BASE64.iter().position(|item| -> item == byte).map(|n| -> U8{n}) }
// Rust: tests/base_encoding_2026.rs:14
fn frozen_aot_base64(text: String) -> [U8]? {
    input :: text.bytes().filter(|b| -> not b.is_ascii_whitespace()).collect()
    if input.len() % 4 != 0 -> return None
    out := [U8]{}.with_capacity(input.len() / 4 * 3)
    loop chunk in input.chunks(4) {
        a :: digit(chunk[0])?
        b :: digit(chunk[1])?
        &out.push((a << 2) | (b >> 4))
        if chunk[2] != U8{61} {
            c :: digit(chunk[2])?
            &out.push((b << 4) | (c >> 2))
            if chunk[3] != U8{61} { d :: digit(chunk[3])?; &out.push((c << 6) | d) }
        }
    }
    Val(^out)
}
// Rust: tests/base_encoding_2026.rs:36
fn frozen_comptime_base64(text: String) -> [U8]? {
    input :: text.trim_end_matches('=').as_bytes()
    if input.len() % 4 == 1 -> return None
    out := [U8]{}.with_capacity(input.len() / 4 * 3)
    loop chunk in input.chunks(4) {
        values := [U8]{}.with_capacity(chunk.len())
        loop byte in chunk { &values.push(digit(byte)?) }
        &out.push((values[0] << 2) | (values.get(1).copied().unwrap_or(U8{0}) >> 4))
        if values.len() > 2 { &out.push((values[1] << 4) | (values[2] >> 2)) }
        if values.len() > 3 { &out.push((values[2] << 6) | values[3]) }
    }
    Val(^out)
}
// Rust: tests/base_encoding_2026.rs:58
fn url_input(text: String) -> String {
    trimmed := text.trim() // #4303
    input := trimmed.replace('-', "+").replace('_', "/")
    loop input.len() % 4 != 0 { &input.push('=') }
    input
}
// Rust: tests/base_encoding_2026.rs:66
fn frozen_base32(text: String) -> [U8]? {
    out := [U8]{}
    buffer := U32{0}
    bits := U8{0}
    loop byte in text.bytes().filter(|b| -> not b.is_ascii_whitespace() and b != U8{61}) {
        value :: match byte {
            b if b >= U8{65} and b <= U8{90} -> b - U8{65}
            b if b >= U8{97} and b <= U8{122} -> b - U8{97}
            b if b >= U8{50} and b <= U8{55} -> b - U8{50} + U8{26}
            _ -> return None
        }
        buffer = (buffer << 5) | U32{value}
        bits += U8{5}
        if bits >= U8{8} { &out.push(U8{(buffer >> (bits - U8{8})) & U32{255}}); bits -= U8{8} }
    }
    Val(^out)
}
// Rust: tests/base_encoding_2026.rs:90
fn strings(alphabet: [U8], max_len: Int, check: &(fn(String) -> ())) -> {
    input := [U8]{}.with_capacity(max_len)
    visit(alphabet, max_len, &input, &check)
}
// Rust: tests/base_encoding_2026.rs:91
fn visit(alphabet: [U8], remaining: Int, input: &[U8], check: &(fn(String) -> ())) -> {
    check(String.from_utf8(input).unwrap())
    if remaining == 0 -> return
    loop byte in alphabet {
        &input.push(byte)
        visit(alphabet, remaining - 1, &input, &check)
        _ :: &input.pop()
    }
}
// Rust: tests/base_encoding_2026.rs:110
fn check_base64_case(text: String) -> {
    aot :: frozen_aot_base64(text)
    comptime :: frozen_comptime_base64(text)
    if (aot, comptime) is (Val(a), Val(c)) { assert_eq(a, c, "historical base64 disagreement for {text.debug()}") }
    assert_eq(base_encoding_2026.decode_base64(text).ok(), aot.or(comptime), "base64 union mismatch for {text.debug()}")
    prepared :: url_input(text)
    aot :: frozen_aot_base64(prepared)
    comptime :: frozen_comptime_base64(prepared)
    if (aot, comptime) is (Val(a), Val(c)) { assert_eq(a, c, "historical base64url disagreement for {text.debug()}") }
    assert_eq(base_encoding_2026.decode_base64url(text).ok(), aot.or(comptime), "base64url union mismatch for {text.debug()}")
}
// Rust: tests/base_encoding_2026.rs:139
#Test("exhaustive_short_inputs_match_frozen_2026_engines_without_disagreement") {
    full := BASE64.to_vec()
    &full.extend_from_slice("= \n-_*.".as_bytes())
    strings(full, 3, &check_base64_case)
    strings("ABPQfgvw09+/= \n-_*.".as_bytes(), 4, &check_base64_case)
    base32 := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz234567".as_bytes().to_vec()
    &base32.extend_from_slice("= \n01*.".as_bytes())
    check_historical := |text| -> assert_eq(base_encoding_2026.decode_base32(text).ok(), frozen_base32(text), "base32 historical mismatch for {text.debug()}")
    strings(base32, 3, &check_historical)
    check_structural := |text| -> assert_eq(base_encoding_2026.decode_base32(text).ok(), frozen_base32(text), "base32 structural mismatch for {text.debug()}")
    strings("ABPZabpz237= \n01*.".as_bytes(), 4, &check_structural)
}
// Rust: tests/base_encoding_2026.rs:164
#Test("rfc4648_base64_base64url_and_base32_vectors_decode") {
    loop (plain, base64, base32) in [("", "", ""), ("f", "Zg==", "MY======"), ("fo", "Zm8=", "MZXQ===="),
        ("foo", "Zm9v", "MZXW6==="), ("foob", "Zm9vYg==", "MZXW6YQ="), ("fooba", "Zm9vYmE=", "MZXW6YTB"),
        ("foobar", "Zm9vYmFy", "MZXW6YTBOI======")] {
        assert_eq(base_encoding_2026.decode_base64(base64).unwrap(), plain.as_bytes())
        assert_eq(base_encoding_2026.decode_base64url(base64.trim_end_matches('=')).unwrap(), plain.as_bytes())
        assert_eq(base_encoding_2026.decode_base32(base32).unwrap(), plain.as_bytes())
    }
    assert_eq(base_encoding_2026.decode_base64("+/8=").unwrap(), [U8{251}, U8{255}])
    assert_eq(base_encoding_2026.decode_base64url("-_8").unwrap(), [U8{251}, U8{255}])
}

// Rust: tests/checked_text_crossings.rs:5
DECLS :: """
enum TextError { Bad }
Pattern :: distinct String
impl Pattern.CheckedText {
    type Error = TextError
    fn check(text: String) -[]> TextError! {
        if text == "" { return Err(TextError.Bad) }
        return Ok(())
    }
    fn encode_hole<T: Printable>(value: T) -[]> String { return "{value}" }
}
"""
// Rust: tests/checked_text_crossings.rs:24
fn assert_plain_string_rejected(label: String, body: String) -> {
    source :: "{DECLS}\n{body}"
    diagnostics :: compile(source).expect_err(label)
    assert(diagnostics.iter().any(|d| -> ["E0112", "E0108", "E0113", "E0905", "E0702", "E3203"].contains(d.code)), "{label} produced no checked-text type-boundary diagnostic: {diagnostics.debug()}")
}
// Rust: tests/checked_text_crossings.rs:39
#Test("plain_string_cannot_cross_checked_text_boundaries") {
    assert_plain_string_rejected("checked text parameter", """
fn accept(value: Pattern) -> {}
fn run() -> { plain :: "plain"; accept(plain) }
""")
    assert_plain_string_rejected("checked text field", """
struct Envelope { value: Pattern }
fn run() -> { plain :: "plain"; envelope :: Envelope{ value: plain } }
""")
    assert_plain_string_rejected("checked text collection", """
fn accept(values: [Pattern]) -> {}
fn run() -> { plain :: "plain"; accept([plain]) }
""")
    assert_plain_string_rejected("checked text generic", """
struct Envelope<T> { value: T }
fn run() -> { plain :: "plain"; envelope :: Envelope<Pattern>{ value: plain } }
""")
    assert_plain_string_rejected("checked text return", """
fn make() -> Pattern { plain :: "plain"; return plain }
fn run() -> {}
""")
    assert_plain_string_rejected("checked text trait method", """
trait Sink { fn put(self, value: Pattern) -> }
struct Worker {}
impl Worker.Sink { fn put(self, value: Pattern) -> {} }
fn run() -> { worker :: Worker{}; plain :: "plain"; worker.put(plain) }
""")
    assert_plain_string_rejected("checked text foreign boundary", """
use c.checked as c
#Import module c.checked { fn put(value: Pattern) -> = "put" }
fn run() -> { plain :: "plain"; c.put(plain) }
""")
}
// Rust: tests/checked_text_crossings.rs:137
#Test("email_html_body_rejects_plain_string") {
    diagnostics :: compile("""
use core.email as email
fn run() -> {
    sender :: email.address("sender@example.com") ?? panic("sender")
    email.message(sender, [sender], [Address]{}, "subject", "body", "<b>unsafe</b>", [Attachment]{})
}
""").expect_err("email HTML body accepted a plain String")
