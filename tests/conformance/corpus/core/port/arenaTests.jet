// Rust: tests/arena.rs:155
#Test("erased_initialization_does_not_leak_past_scope") {
    src :: """
use core.mem
fn erased_off() -> {
    value := Int{ uninit }
    #Off { value = 7 }
    print(value)
}
fn erased_debug() -> {
    value := Int{ uninit }
    #DebugOnly { value = 8 }
    print(value)
}
fn active_initialization() -> {
    value := Int{ uninit }
    value = 9
    print(value)
}
fn run() -> {
    erased_off()
    erased_debug()
    active_initialization()
}
"""
    codes :: error_codes(src)
    assert_eq(codes.iter().filter(|code| -> code == "E0420").count(), 2, "removed initialization facts must not escape erased scopes: {codes.debug()}")
    assert_eq(codes.len(), 2, "unexpected diagnostics: {codes.debug()}")
}
