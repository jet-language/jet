#Test("xml_has_one_semantic_home") {
    kernel :: "XmlKernel.rs"
    assert(read("crates/jet-codegen/src/Codegen/mod.rs").contains(kernel), "AOT must embed {kernel}")
    assert(read("crates/jet-foundation/src/lib.rs").contains("pub mod XmlKernel"), "JIT and comptime must import the foundation XML kernel")
    comptime :: read("crates/jet-comptime/src/Comptime/EncodingLite.rs")
    comptime_production :: comptime.split("#[cfg(test)]").next().unwrap()
    pure :: read("crates/jet-comptime/src/Comptime/CorePureParity.rs")
    jit :: read("crates/jet-jit/src/Encoding.rs")
    aot :: read("crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs")
    loop (tier, source, call) in [("AOT", aot, "jet_xml_kernel::parse_document(text)"), ("comptime/interpreter", comptime_production, "XmlKernel::parse_document(text)"), ("JIT", jit, "XmlKernel::parse_document(&clone_string(text))")] {
        assert(source.contains(call), "{tier} must pass XML source unchanged to the shared kernel")
    }
    loop operation in ["parse_document(", "parse_document_with(", "parse_document_bytes_with(", "render_document(", "render_document_bytes(", "canonical_document(", "document_root(", "expanded_name_parts(", "lookup_attribute(", "element_content(", "project_document_for_decode("] {
        assert(aot.contains("jet_xml_kernel::{operation}"))
        assert(not comptime_production.contains("XmlPull::{operation}"), "comptime bypassed XML kernel for `{operation}`")
        assert(not jit.contains("XmlPull::{operation}"), "JIT bypassed XML kernel for `{operation}`")
    }
    assert(not pure.contains("XmlPull::canonical_document("))
}
