// Rust: tests/arena.rs:16
fn unique_tmp() -> OSPath { common.unique_tmp("arena") }
// Rust: tests/arena.rs:22
fn error_codes(src: String) -> [String] {
    dir :: unique_tmp()
    fs.create_dir_all(dir).unwrap()
    tir_support.write_test_package(dir, tir_support.TIR_TEST_PACKAGE)
    path :: dir.join("fixture.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    match compile_with_path(src, shown) { Ok(_) -> [], Err(diags) -> diags.into_iter().map(|d| -> d.code.to_string()).collect() }
}
// Rust: tests/arena.rs:38
// GATE #4494: fixture filesystem and subprocess execution; source-only translation.
fn build_and_run(name: String, src: String) -> String? {
    dir0 :: unique_tmp()
    fs.create_dir_all(dir0).unwrap()
    tir_support.write_test_package(dir0, tir_support.TIR_TEST_PACKAGE)
    fpath :: dir0.join("fixture.jet")
    fs.write(fpath, src).unwrap()
    out :: compile_with_path(src, fpath.to_string_lossy()).unwrap_or_else(|d| -> panic("front end rejected a should-compile fixture: {d.iter().map(|x| -> x.code).collect().debug()}"))
    user :: common.strip_vetted_prelude_modules(out.rust)
    leaked_unsafe := [String]{}
    loop (index, line) in user.lines().enumerate() {
        if not common.unsafe_keyword_columns(line).is_empty() { &leaked_unsafe.push("line {index + 1}: {line.trim()}") }
    }
    assert(leaked_unsafe.is_empty(), "`unsafe` leaked outside the vetted prelude helpers:\n{leaked_unsafe.join("\n")}")
    if not common.have_rustc() { eprintln("note: rustc not found; compiled front end only"); return None }
    dir :: env.temp_dir()
    rs :: dir.join("jet_arena_{name}.rs")
    bin :: dir.join("jet_arena_{name}")
    fs.write(rs, out.rust).unwrap()
    c :: Command.new("rustc").args(["--edition", "2021"]).arg(rs).arg("-o").arg(bin).output().unwrap()
    assert(c.status.success(), "I2 violated: rustc rejected generated code:\n{String.from_utf8_lossy(c.stderr)}")
    r :: Command.new(bin).output().unwrap()
    Val(String.from_utf8_lossy(r.stdout).to_string())
}
// Rust: tests/arena.rs:93
#Test("alloc_and_use_compiles_and_runs") {
    src :: """
use core.mem
fn run() -> {
    arena :: mem.Arena.new()
    x :: arena.alloc(42)
    x = 43
    y :: arena.alloc(100)
    print(x)
    print(y)
    &arena.reset()
    z :: arena.alloc(7)
    print(z)
}
"""
    assert_eq(error_codes(src), [String]{}, "alloc-and-use should compile clean")
    if build_and_run("ok", src) is Val(out) { assert_eq(out, "43\n100\n7\n") }
    tir_support.assert_tiers_agree("arena_view_write", src, "43\n100\n7\n")
    tir_support.assert_example_cli_tiers_agree("memory/arena", read("Examples/features/expected/memory/arena.out"))
    tir_support.assert_example_cli_tiers_agree("memory/try_allocation", read("Examples/features/expected/memory/try_allocation.out"))
}
