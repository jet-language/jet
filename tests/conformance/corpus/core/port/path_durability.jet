use std.env as env
use std.process as process
// Rust: tests/path_durability.rs:3
fn jet_string(path: OSPath) -> String { path.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"") }
// Rust: tests/path_durability.rs:9
fn unique_dir(name: String) -> OSPath { env.temp_dir().join("jet-path-durability-{name}-{process.id()}") }
