    _ :: fs.write(dir.join(name), body)
}
// Rust: tests/encoding_variance.rs:94
fn compile_aot(dir: &OSPath, name: String, src: String) -> OSPath {
    jet_path := dir.join("{name}.jet")
    fs.write(&jet_path, src).unwrap()
    shown := jet_path.to_string_lossy()
    _ :: jet.compile_with_path(src, &shown) ?? {
        panic("front end rejected variance fixture:\n{jet.render_diagnostics(&shown, src, &err)}")
    }
    bin := dir.join(name)
    // Clean native-backend cutover: build Jet, never generate or run Rust.
    built := Command.new(env.test_binary("jet")) // GATE #4494
        .args(["build", jet_path.to_str().unwrap(), "--output", bin.to_str().unwrap()]).output().unwrap()
    assert(built.status.success(), "native compiler rejected variance fixture {name}:\n{String.from_utf8_lossy(&built.stderr)}")
    bin
}
// Rust: tests/encoding_variance.rs:134
fn run_bin(bin: &OSPath, cwd: &OSPath, environment: [(String, String)]) -> RunResult {
    cmd := Command.new(bin)
    cmd.current_dir(cwd)
    // Fresh hostile TLS every process; clear every inherited schedule.
    cmd.env_remove("JET_ENC_HOSTILE_IO")
    cmd.env_remove("JET_ENC_HOSTILE_READ_ONE")
    cmd.env_remove("JET_ENC_HOSTILE_READ_PLAN")
    cmd.env_remove("JET_ENC_HOSTILE_WRITE_MAX")
    cmd.env_remove("JET_ENC_HOSTILE_WRITE_PLAN")
    cmd.env_remove("JET_ENC_HOSTILE_INTERRUPT_READS")
    cmd.env_remove("JET_ENC_HOSTILE_INTERRUPT_WRITES")
    cmd.env_remove("JET_ENC_HOSTILE_FAIL_READ_AFTER")
    cmd.env_remove("JET_ENC_HOSTILE_FAIL_WRITE_AFTER")
    loop (k, v) in environment { cmd.env(k, v) }
    out := cmd.output().unwrap()
    RunResult{exit: out.status.code() ?? -1, stdout: String.from_utf8_lossy(&out.stdout).to_string(), stderr: String.from_utf8_lossy(&out.stderr).to_string()}
}
// Rust: tests/encoding_variance.rs:158
fn hostile(extra: [(String, String)]) -> [(String, String)] {
    environment := [("JET_ENC_HOSTILE_IO", "1")]
    environment.extend(extra.iter().map((pair) -> (~pair.0, ~pair.1)))
    environment
}
// Rust: tests/encoding_variance.rs:164
fn run_hostile(bin: &OSPath, cwd: &OSPath, extra: [(String, String)]) -> RunResult {
    owned := hostile(extra)
    run_bin(bin, cwd, owned)
}
// Rust: tests/encoding_variance.rs:173
fn lcg(state: &U64) -> U64 {
    state = state.wrapping_mul(6364136223846793005).wrapping_add(1)
    state
}
// Rust: tests/encoding_variance.rs:178
// 32 deterministic multi-chunk read plans for inputs larger than 4096.
fn recorded_chunk_plans(seed: U64, input_len: USize) -> [[USize]] {
    state := seed
    plans := [[USize]].with_capacity(CHUNK_PLAN_COUNT)
    loop plan_i in 0..CHUNK_PLAN_COUNT {
        chunks := 3 + (USize{lcg(&state) & target.usize_max()} % 6) // GATE #4483: Rust truncating usize cast.
        sizes := [USize].with_capacity(chunks)
        remaining := input_len
        loop c in 0..chunks {
            if c + 1 == chunks { sizes.push(remaining.max(1)); break }
            span := (remaining / (chunks - c)).max(1)
            take := 1 + (USize{lcg(&state) & target.usize_max()} % span)
            take := take.min(remaining.saturating_sub(chunks - c - 1).max(1))
            sizes.push(take)
            remaining = remaining.saturating_sub(take)
        }
        if sizes.iter().sum<USize>() < input_len { sizes.push(input_len) }
        assert(!sizes.is_empty(), "plan {plan_i} empty for seed {seed:#x}")
        plans.push(sizes)
    }
    plans
}
