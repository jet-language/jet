// Rust: tests/encoding_types_single_home.rs:19
fn collect_rs_files(dir: &OSPath, out: &[OSPath]) -> {
    entries := fs.read_dir(dir) ?? return // GATE #4494
    loop entry in entries.flatten() {
        path := entry.path()
        if path.is_dir() { collect_rs_files(&path, &out) }
        else if path.extension().is_some_and((ext) -> ext == "jet") { out.push(path) }
    }
}
// Rust: tests/encoding_types_single_home.rs:33
fn declaration_sites(root: &OSPath, name: String) -> [String] {
    files := [OSPath]{}
    collect_rs_files(&root.join("Core"), &files)
    files.sort()
    sites := [String]{}
    loop file in files {
        relative := file.strip_prefix(root) ?? file
        text := fs.read_to_string(&file) ?? ""
        loop (line_number, line) in text.lines().enumerate() {
            code := line.split("//").next() ?? ""
            words := code.split((character) -> character.is_whitespace() || "{}()[],:;".contains(character))
                .filter((word) -> !word.is_empty()).collect()
            is_declaration := words.windows(2).any((window) -> (window[0] == "struct" || window[0] == "enum") && window[1] == name)
            if !is_declaration { continue }
            // The private absent-cause marker is not the shared EncodingError.
            if name == "EncodingError" && (code.contains("struct EncodingError;") || code.contains("struct EncodingError ;")) { continue }
            sites.push("{relative.display()}:{line_number + 1}")
        }
    }
    sites
}

