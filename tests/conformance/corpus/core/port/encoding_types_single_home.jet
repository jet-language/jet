// Rust: tests/encoding_variance.rs:61
fn host_facts() -> String {
    // This is evidence about the actual process host, not selected-target cfg.
    commit := Command.new("git").args(["rev-parse", "HEAD"]).output().ok()
        .and_then((o) -> String.from_utf8(o.stdout).ok()) ?? "unknown"
    commit := commit.trim().to_string() // #4303
    rustc := Command.new("rustc").arg("-vV").output().ok()
        .and_then((o) -> String.from_utf8(o.stdout).ok()) ?? "rustc unavailable"
    host := rustc.lines().find((l) -> l.starts_with("host:")) ?? "host: unknown"
    "commit={commit}\nos={env.consts.OS}\narch={env.consts.ARCH}\n{host}\nseed={VARIANCE_SEED:#x}\ntier=aot-native\nplatforms_unavailable=aarch64,macos,windows\n"
}
