// Rust: tests/encoding_variance.rs:287
fn json_limit_reader_src(input_rel: String, max_total: U64) -> String {
    // Drain the stream: ObjectStart alone can precede crossing max_total_bytes.
    """
use core.encoding as encoding
use core.encoding.json as json
use core.files as files
fn run() -> {
    limits := encoding.EncodingLimits.safe()
    limits.max_total_bytes = Val($MAX)
    input :: files.open("$INPUT") ?? panic("open")
    reader :: json.reader(^input, limits) ?? panic("reader")
    loop {
        result :: reader.next()
        if result == {
            Ok(maybe) -> {
                if maybe == { None -> { print("eof"); break }; Val(_) -> {} }
            }
            Err(error) -> {
                print(error.kind == encoding.EncodingErrorKind.Limit)
                again :: reader.next()
                if again == { Err(second) -> print(error.reason == second.reason); Ok(_) -> print("not-latched") }
                break
            }
        }
    }
}
""".replace("$MAX", max_total.to_string()).replace("$INPUT", input_rel)
}
// Rust: tests/encoding_variance.rs:329
fn padded_json_object(target_len: USize) -> [U8] {
    overhead := 8
    assert(target_len >= overhead, "target too small")
    pad := target_len - overhead
    out := [U8].with_capacity(target_len)
    out.extend_from_slice("{\"d\":\"".as_bytes())
    loop _ in 0..pad { out.push(120) }
    out.extend_from_slice("\"}".as_bytes())
    assert(out.len() == target_len)
    out
}
// Rust: tests/encoding_variance.rs:342
fn padded_jsonl(target_len: USize) -> [U8] {
    prefix := "{\"n\":1,\"d\":\"".as_bytes()
    suffix := "\"}".as_bytes()
    overhead := prefix.len() + suffix.len() + 1
    assert(target_len >= overhead)
    pad := target_len - overhead
    out := [U8].with_capacity(target_len)
    out.extend_from_slice(prefix)
    loop _ in 0..pad { out.push(121) }
    out.extend_from_slice(suffix)
    out.push(10)
    assert(out.len() == target_len)
    out
}
