}
// Rust: tests/encoding_variance.rs:374
fn padded_cbor_text(target_len: USize) -> [U8] {
    payload_len := target_len.checked_sub(3).expect("cbor target too small")
    assert(payload_len <= USize{U16.MAX})
    out := [U8].with_capacity(target_len)
    out.push(0x79)
    out.extend_from_slice(&U16{payload_len}.to_be_bytes())
    loop _ in 0..payload_len { out.push(113) }
    assert(out.len() == target_len)
    out
}
// Rust: tests/encoding_variance.rs:387
fn assert_same(label: String, baseline: &RunResult, got: &RunResult) -> {
    assert(got.exit == baseline.exit, "{label} exit drift: {got.stderr}")
    assert(got.stdout == baseline.stdout, "{label} stdout drift\nbase={baseline.stdout:?}\ngot ={got.stdout:?}")
    assert(got.stderr == baseline.stderr, "{label} stderr drift")
}
// Rust: tests/encoding_variance.rs:401
fn prove_every_byte_split(label: String, bin: &OSPath, cwd: &OSPath, input_len: USize, baseline: &RunResult, log: &String) -> {
    assert(input_len <= EVERY_SPLIT_MAX, "{label}: every-split input must be ≤ {EVERY_SPLIT_MAX}, got {input_len}")
    t0 := Instant.now()
    loop split in 0..=input_len {
        rest := (input_len - split).max(1)
        plan := if split == 0 -> "{rest}" else -> "{split},{rest}"
        got := run_hostile(bin, cwd, [("JET_ENC_HOSTILE_READ_PLAN", plan)])
        if got.exit != baseline.exit || got.stdout != baseline.stdout {
            panic("{label} first difference at split={split} plan={plan}\nbase exit={baseline.exit} out={baseline.stdout:?}\ngot  exit={got.exit} out={got.stdout:?} err={got.stderr}")
        }
    }
    one := run_hostile(bin, cwd, [("JET_ENC_HOSTILE_READ_ONE", "1")])
    assert_same("{label} read-one", baseline, &one)
    log.push_str("{label}: every-split 0..={input_len} + READ_ONE ok in {t0.elapsed():?}\n")
}
// Rust: tests/encoding_variance.rs:438
fn prove_chunk_plans(label: String, bin: &OSPath, cwd: &OSPath, plans: &[[USize]], baseline: &RunResult, log: &String) -> {
    t0 := Instant.now()
    loop (i, plan) in plans.iter().enumerate() {
        plan_s := plan.iter().map((n) -> n.to_string()).collect().join(",")
        got := run_hostile(bin, cwd, [("JET_ENC_HOSTILE_READ_PLAN", plan_s)])
        if got.exit != baseline.exit || got.stdout != baseline.stdout {
            panic("{label} chunk plan {i} first difference plan={plan_s}\nbase={baseline.stdout:?}\ngot={got.stdout:?}\nerr={got.stderr}")
        }
        log.push_str("{label}: plan[{i}]={plan_s}\n")
    }
    log.push_str("{label}: {CHUNK_PLAN_COUNT} chunk plans ok in {t0.elapsed():?}\n")
}
