use tests.conformance.corpus.core.port.http_i9.*
use tests.conformance.corpus.core.port.http.[on_large_stack]
use tests.common as common
use tests.tir_support as tir_support
use std.net.[TcpListener, TcpStream]
use std.thread
use std.time.[Duration, Instant]
use std.io.[ErrorKind]
use std.sync.[Arc]
use std.sync.atomic.[AtomicBool, Ordering]
// GATE #4494: actual TCP fixtures, scoped threads and acquire/release atomics.
// GATE #4409: exact WouldBlock / ConnectionReset error-kind contracts.
// Retired Cranelift trace assertions are replaced with shared-tier behavior.

// Rust: tests/http_i9.rs:861
#Test("http_text_projections_preserve_default_limits_and_body_lifecycle_on_all_supported_tiers") {
    has_rustc :: common.have_rustc()
    tier_count :: 2 + USize{has_rustc}
    listener :: TcpListener.bind("127.0.0.1:0").expect("bind")
    address :: listener.local_addr().expect("address")
    server :: thread.spawn(() -> {
        loop _ in 0..(tier_count * 7) {
            (stream, _) := listener.accept().expect("client connection")
            request :: read_http_request(&stream)
            if request.windows(5).any(window -> window == "/over".bytes()) {
                stream.write_all("HTTP/1.1 200 OK\r\nContent-Length: 1048577\r\nConnection: close\r\n\r\n".bytes()).unwrap()
            } else if request.windows(7).any(window -> window == "/binary".bytes()) {
                stream.write_all("HTTP/1.1 200 OK\r\nContent-Length: 3\r\nConnection: close\r\n\r\n".bytes()).unwrap()
                stream.write_all([U8]{0, 0xff, 1}).unwrap()
            } else if request.windows(7).any(window -> window == "/stream".bytes()) {
                stream.write_all("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nhello".bytes()).unwrap()
            } else if request.windows(10).any(window -> window == "/truncated".bytes()) {
                stream.write_all("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nno".bytes()).unwrap()
            } else {
                stream.write_all("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello".bytes()).unwrap()
            }
            stream.flush().unwrap()
        }
    })
    source :: HTTP_TEXT_ERROR_BODIES.replace("__URL__", "http://{address}")
    expected :: "default=ok:5\nexplicit=ok:hello\nconsumed=err:BodyConsumed\nstream=ok:hello\nover=err:BodyTooLarge:1048576\nbinary=err:UnsupportedEncoding\ntruncated=err:IO:transport\n"
    on_large_stack(() -> {
        loop (use_interpreter, name) in [(false, "http_i9_text_contract_default"), (true, "http_i9_text_contract_interpreter")] {
            output :: run_with_mode(source, name, use_interpreter)
            assert_eq(output.stdout, expected)
            assert_eq(output.stderr, "")
            assert_eq(output.exit_code, 0)
        }
        if has_rustc {
            (exit_code, stdout, stderr) :: common.build_and_run("http_i9_text_contract", "aot", source)
            assert_eq(stdout, expected)
            assert_eq(stderr, "")
            assert_eq(exit_code, 0)
        }
    })
    server.join().expect("server")
}

// Rust: tests/http_i9.rs:947
#Test("http_web_defaults_forced_deopt_uses_prelude_ambient") {
    on_large_stack(() -> {
        loop use_interpreter in [false, true] {
            output :: if use_interpreter -> run_with_mode(FORCED_DEOPT, "http_i9_forced_deopt", true) else -> run(FORCED_DEOPT, "http_i9_forced_deopt")
            assert_eq(output.stderr, "")
            assert_eq(output.exit_code, 0)
            assert(output.stdout.starts_with("strasse\nReno|31|application/json|hello\nInvalidFraming\nPolicy {{ reason: "))
            assert(output.stdout.contains("CORS credentials need named origins."))
        }
        // The removed deopt/fallback representation probes become O1/O2 witnesses.
        if common.have_rustc() {
            loop tier in [tir_support.build_and_run_multi, tir_support.build_release_and_run_multi] {
                (exit_code, stdout, stderr) :: tier("http_i9_forced_deopt", "main.jet", [("main.jet", FORCED_DEOPT)])
                assert_eq(stderr, "")
                assert_eq(exit_code, 0)
                assert(stdout.starts_with("strasse\nReno|31|application/json|hello\nInvalidFraming\nPolicy {{ reason: "))
                assert(stdout.contains("CORS credentials need named origins."))
            }
        }
    })
}

