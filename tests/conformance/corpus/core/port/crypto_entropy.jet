// Rust: tests/crypto_entropy.rs:1-20
use tests.common as common
use core.crypto.runtime.top_crypto_entropy as runtime
use core.sys.target as target
use std.process.Command
use std.io.Error
use std.sync.atomic.[AtomicBool, AtomicU8, Ordering]
use core.sys.host.linux_seccomp_imports.[SockFilter, SockFprog]
use c.c.[prctl, prctl_program]
// Test-only runtime consumers use the canonical entropy, Outcome and auth owners.
// GATE #4494: thread-local test providers, native atomic and pre-exec/prctl ABI.

// Rust: tests/crypto_entropy.rs:488-504
pub module auth_session_regression {
    use std.sync.atomic.[AtomicBool, AtomicU8, Ordering]
    use core.auth.runtime.top_auth_session.*
    use core.crypto.runtime.top_sha256_raw.*
    pub const FAIL_ENTROPY: AtomicBool = AtomicBool.new(false)
    const NEXT_BYTE: AtomicU8 = AtomicU8.new(1)
    // Rust: tests/crypto_entropy.rs:495
    pub fn jet_crypto_entropy_bytes(count: I64) -> [U8] Unit! {
        if FAIL_ENTROPY.load(Ordering.Relaxed) { return .Err(()) }
        count_size :: USize.try_from(count).map_err(|_| -> ())?
        byte :: NEXT_BYTE.fetch_add(1, Ordering.Relaxed)
        return .Ok([U8]{byte}.repeat(count_size))
    }
    // Paired tests inject this deterministic provider into the sole entropy
    // seam before exercising canonical auth consumers; no include-time shadowing.
}

// Rust: tests/crypto_entropy.rs:704-765
// GATE #4483: selected architecture and Linux LP64-only variadic argument width.
pub fn without_os_entropy(command: &Command) -> &Command {
    assert(target.selected_os() == .Linux)
    arch :: target.selected_arch()
    assert(arch == "x86_64" || arch == "aarch64")
    SYS_GETRANDOM: U32 :: if arch == "x86_64" { 318 } else { 278 }
    ENOSYS: U32 :: 38
    PR_SET_NO_NEW_PRIVS: I32 :: 38
    PR_SET_SECCOMP: I32 :: 22
    SECCOMP_MODE_FILTER: U64 :: 2
    FILTER :: [SockFilter]{
        SockFilter{code: 0x20, jt: 0, jf: 0, k: 0},
        SockFilter{code: 0x15, jt: 0, jf: 1, k: SYS_GETRANDOM},
        SockFilter{code: 0x06, jt: 0, jf: 0, k: 0x0005_0000 | ENOSYS},
        SockFilter{code: 0x06, jt: 0, jf: 0, k: 0x7fff_0000},
    }
    // Rust: tests/crypto_entropy.rs:740: prctl reuses canonical Linux imports.
    #Unsafe("pre-exec closure only makes async-signal-safe prctl calls; owned filter lives through synchronous install") {
        command.pre_exec(move || -> {
            program :: SockFprog{len: FILTER.len() as U16, filter: FILTER.as_ptr()}
            zero: U64 :: 0
            if prctl(PR_SET_NO_NEW_PRIVS, 1 as U64, zero, zero, zero) != 0 ||
                prctl_program(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &program, zero, zero) != 0 {
                return .Err(Error.last_os_error())
            }
            return .Ok(())
        })
    }
}
