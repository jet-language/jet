// Rust: tests/concurrency_channels_tiers.rs:99
#Test("web_runs_the_same_channel_readiness_example") {
    scratch :: common.Scratch.new("channel-readiness-web")
    output :: jet.compile_web_with_path(channels.SOURCE, "Examples/features/concurrency/select_channel.jet")
        .unwrap_or_else(diagnostics -> panic("web target rejected channel/readiness:\n{jet.render_diagnostics("Examples/features/concurrency/select_channel.jet", channels.SOURCE, diagnostics)}"))
    web :: output.web.expect("web target must produce artifacts")
    fs.write(scratch.join("app.js"), web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(scratch.join("package.json"), `{"type":"module"}`).unwrap()
    if Command.new("node").arg("--version").output().is_ok() {
        node :: Command.new("node").current_dir(scratch.path).arg("app.js").output().expect("spawn node")
        assert(node.status.success(), "web channel example failed:\nstdout: {String.from_utf8_lossy(node.stdout)}\nstderr: {String.from_utf8_lossy(node.stderr)}")
        assert_eq(String.from_utf8_lossy(node.stdout), channels.EXPECTED)
    }
}

