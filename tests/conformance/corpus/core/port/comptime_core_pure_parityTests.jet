// Rust: tests/comptime_core_pure_parity.rs:893
#Test("rustc_backed_aot_comptime_differentials_cover_return_shapes") {
    cases :: [
        ("option/string", parity_source(`mime.extension("image/png") ?? "none"`, "use core.net.mime as mime")),
        ("result/bytes", parity_source("email_wire()", `use core.email as email
use core.encoding.hex as hex
fn email_wire() -> String {
    message :: email.message(email.address("a@example.com") ?? panic("a"), [email.address("b@example.com") ?? panic("b")], [Address]{}, "s", "body", HTML{""}, [Attachment]{}) ?? panic("m")
    return hex.encode(email.serialize(message) ?? panic("serialize"))
}`)),
        ("result/string", parity_source("xml_canonical()", `use core.encoding.xml as xml
fn xml_canonical() -> String {
    tree :: xml.parse("<r b=\"2\" a=\"1\"><x/></r>") ?? panic("xml")
    return xml.canonical(tree, xml.XMLCanonical{ mode: .Inclusive11, comments: false, inclusive_prefixes: [] }) ?? panic("canonical")
}`)),
        ("xml/float-shape-error", parity_source("xml_shape_reason(DataTree.Float(1.5))", `use core.encoding.xml as xml
fn xml_shape_reason(tree: DataTree) -> String {
    if xml.canonical(tree, xml.XMLCanonical{ mode: .Inclusive11, comments: false, inclusive_prefixes: [] }) == {
        Ok(_) -> return "unexpected success"
        Err(error) -> return error.reason
    }
    return "unreachable"
}`)),
        ("mime/observable-methods", parity_source("mime_view()", `use core.net.mime as mime
fn mime_view() -> String {
    value :: mime.parse("Text/HTML; charset=UTF-8") ?? panic("mime")
    return "{value.media_type()}|{value.subtype()}|{value.essence()}|{value.param("charset") ?? "none"}|{value.params()}|{value.to_string()}"
}`)),
        ("date/observable-methods", parity_source("date_view()", `use core.time as date
fn date_view() -> String {
    parsed :: date.parse("2024-02-29") ?? panic("date")
    clamped :: date.new(2024, 13, 40)
    return "{parsed.year()}-{parsed.month()}-{parsed.day()}|{parsed.to_string()}|{clamped.to_string()}"
}`)),
        ("time/observable-methods", parity_source("time_view()", `use core.time as time
fn time_view() -> String {
    local :: time.parse_time("23:59:58") ?? panic("time")
    datetime :: time.from_unix_ms(-1)
    period :: time.period(1, 2, 3)
    return "{local.hour()}:{local.minute()}:{local.second()}|{local.to_string()}|{datetime.to_timestamp()}|{datetime.to_unix_ms()}|{period.to_string()}"
}`)),
        ("measurement/observable-methods", parity_source("measurement_view()", `fn measurement_view() -> String {
    value :: measurement(12.5, uncertainty: 0.25)
    return "{value.value()}|{value.uncertainty()}"
}`))
    ]
    loop (label, source) in cases { _ :: check_aot_comptime(label, source) }
}
// Rust: tests/comptime_core_pure_parity.rs:955
#Test("time_plane_comptime_matches_aot_and_dev_tiers") {
    source :: parity_source("time_plane_view()", `use core.time as time
fn time_plane_view() -> String {
    wait :: 500ms
    origin :: time.instant()
    point :: origin + 5min
    delta :: point - origin
    speed :: 12meter / 2s
    return "{wait.in(.Milliseconds) ?? panic("wait")}|{delta.in(.Minutes) ?? panic("delta")}|{speed}"
}`)
    expected :: check_aot_comptime("time-plane-focused", source)
    assert_eq(expected, "500|5|6 meter/ns")
    check_dev_tiers("time-plane-focused", source, expected)
}
// Rust: tests/comptime_core_pure_parity.rs:974
#Test("registered_shared_kernel_edges_match_all_execution_tiers") {
    cases :: [
        ("mime-one-kernel", parity_source("mime_view()", `use core.net.mime as mime
fn mime_view() -> String {
    value :: mime.parse("Text/HTML; charset=UTF-8") ?? panic("mime")
    return "{value.media_type()}|{value.subtype()}|{value.essence()}|{value.param("charset") ?? "none"}|{value.params()}|{value.to_string()}"
}`)),
        ("email-one-kernel", parity_source("email_wire()", `use core.email as email
use core.encoding.hex as hex
fn email_wire() -> String {
    message :: email.message(email.address("a@example.com") ?? panic("a"), [email.address("b@example.com") ?? panic("b")], [Address]{}, "s", "body", HTML{""}, [Attachment]{}) ?? panic("m")
    return hex.encode(email.serialize(message) ?? panic("serialize"))
}`)),
        ("sketch-edge-kernel", parity_source("sketch_edges()", `use core.data.sketch.hll as hll
use core.data.sketch.tdigest as tdigest
use core.data.sketch.cms as cms
use core.data.sketch.reservoir as reservoir
fn sketch_edges() -> String {
    cardinality := hll.new()
    empty_count :: cardinality.count()
    cardinality.add("same")
    cardinality.add("same")
    distribution := tdigest.new()
    empty_quantile :: distribution.quantile(0.5)
    distribution.add(-1.0)
    distribution.add(1.0)
    frequencies := cms.new()
    missing :: frequencies.count("missing")
    frequencies.add("seen")
    sample := reservoir.new(0)
    sample.add("first")
    sample.add("second")
    return "{empty_count}|{cardinality.count()}|{empty_quantile}|{distribution.quantile(0.0)}|{distribution.quantile(1.0)}|{missing}|{frequencies.count("seen")}|{sample.sample().len()}"
}`)),
        ("time-duration-edge-kernel", parity_source("time_duration_edges()", `use core.time as time
use core.time as date
fn time_duration_edges() -> String {
    clamped :: date.new(2023, 2, 31)
    leap_end :: date.new(2024, 1, 31).add_months(1)
    negative_time :: time.from_unix_ms(-1)
    fractional :: Duration.seconds(1.75) ?? panic("fractional duration")
    negative :: Duration.milliseconds(-1500) ?? panic("negative duration")
    left :: Duration.milliseconds(500) ?? panic("left")
    right :: Duration.milliseconds(1500) ?? panic("right")
    difference :: left.difference(right)
    zero :: Duration.nanoseconds(0) ?? panic("zero")
    return "{clamped.to_string()}|{leap_end.to_string()}|{negative_time.to_timestamp()}|{negative_time.to_unix_ms()}|{negative_time.format_rfc3339()}|{fractional.in(.Milliseconds) ?? panic("fractional read")}|{negative.in(.Seconds) ?? panic("negative read")}|{difference.in(.Milliseconds) ?? panic("difference read")}|{zero.is_zero()}"
}`)),
        ("time-plane-literal-kernel", parity_source("time_plane_view()", `use core.time as time
fn time_plane_view() -> String {
    wait :: 500ms
    origin :: time.instant()
    point :: origin + 5min
    delta :: point - origin
    speed :: 12meter / 2s
    return "{wait.in(.Milliseconds) ?? panic("wait")}|{delta.in(.Minutes) ?? panic("delta")}"
}`)),
        ("xml-edge-kernel", parity_source("xml_edges()", `use core.encoding.xml as xml
fn xml_edges() -> String {
    document :: xml.parse("<catalog><book id=\"7\"><title>Hi</title></book></catalog>") ?? panic("parse")
    root :: xml.root(document) ?? panic("root")
    root_name :: xml.expanded_name(root) ?? panic("root name")
    children :: xml.content(root) ?? panic("content")
    book_name :: xml.expanded_name(children[0]) ?? panic("book name")
    attribute :: xml.attribute(children[0], "id")
    id :: attribute ?? "missing"
    return "{root_name.local}|{children.len()}|{book_name.local}|{id}|{xml.to_string(document)}"
}`)),
        ("measurement-edge-kernel", parity_source(MEASUREMENT_EXPR, MEASUREMENT_DECLS))
    ]
    loop (label, source) in cases {
        expected :: check_aot_comptime(label, source)
        if label == "sketch-edge-kernel" { assert_eq(expected, "0|1|0.0|-1.0|1.0|0|1|1") }
        if label == "time-duration-edge-kernel" { assert_eq(expected, "2023-02-28|2024-02-29|-1|-1|1969-12-31T23:59:59.999000000Z|1750|-1|-1000|true") }
        if label == "time-plane-literal-kernel" { assert_eq(expected, "500|5") }
        if label == "xml-edge-kernel" { assert_eq(expected, "catalog|1|book|7|<catalog><book id=\"7\"><title>Hi</title></book></catalog>") }
        if label == "measurement-edge-kernel" { assert_eq(expected, "3.0|5.0|3.0|5.0|0.0|9.0|4.0|0.0") }
        check_dev_tiers(label, source, expected)
    }
}
