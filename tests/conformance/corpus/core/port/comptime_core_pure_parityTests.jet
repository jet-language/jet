// Rust: tests/comptime_core_pure_parity.rs:1722
#Test("round_three_shared_kernels_keep_edge_rules_in_one_adapter_path") {
    // These source-sharing assertions inspect the retained Rust peer reference, not a runtime Rust bridge.
    root :: OSPath.from(env.manifest_dir())
    read_peer :: |path: String| -> fs.read_to_string(root.join(path)).unwrap_or_else(|error| -> panic("read {path}: {error}"))
    random :: read_peer("crates/jet-codegen/src/Prelude/Core/SeededRandom.rs")
    assert(random.contains("if high <= low"))
    assert(random.contains("probability.is_nan()"))
    assert(random.contains("std::f64::consts::TAU"))
    assert(read_peer("crates/jet-comptime/src/Comptime/Methods/dispatch.rs").contains("seeded_random_kernel::jet_seeded_rng_normal"))
    assert(read_peer("crates/jet-jit/src/Random.rs").contains("include!(\"../../jet-codegen/src/Prelude/Core/SeededRandom.rs\")"))
    path :: read_peer("crates/jet-codegen/src/Prelude/Core/Path.rs")
    assert(path.contains("ParentDir if normal_depth > 0"))
    assert(path.contains("ParentDir if !rooted"))
    assert(read_peer("crates/jet-jit/src/CoreHost.rs").contains("path_kernel::jet_std_path_normalize"))
    fmt :: read_peer("crates/jet-codegen/src/Prelude/Core/Fmt.rs")
    assert(fmt.contains("precision.clamp(0, 9)"))
    assert(fmt.contains("11..=13"))
    assert(fmt.contains("fill.is_empty()"))
    assert(read_peer("crates/jet-comptime/src/Comptime/Methods/core_calls.rs").contains("fmt_kernel::jet_fmt_percent"))
    net :: read_peer("crates/jet-codegen/src/Prelude/Core/NetPure.rs")
    assert(net.contains("text.parse()"))
    assert(net.contains("address.is_ipv4()"))
    assert(read_peer("crates/jet-comptime/src/Comptime/CorePureParity.rs").contains("super::net_pure_kernel::jet_net_pure_parse_socket_addr"))
    math :: read_peer("crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs")
    assert(math.contains("if value < 0"))
    assert(math.contains("value.unsigned_abs()"))
    assert(math.contains("x.is_nan()"))
    assert(read_peer("crates/jet-jit/build.rs").contains("MathLibPure.rs"))
    assert(read_peer("crates/jet-comptime/src/Comptime/Methods/core_calls.rs").contains("math_lib_pure::jet_std_math_gcd"))
    loadable :: read_peer("crates/jet-codegen/src/Prelude/Core/Loadable.rs")
    assert(loadable.contains("JET_LOADABLE_FAILED: u8 = 3"))
    assert(loadable.contains("jet_loadable_has_value"))
    assert(read_peer("crates/jet-jit/src/Reactive.rs").contains("loadable_kernel::jet_loadable_has_value"))
    encoding :: read_peer("crates/jet-codegen/src/Prelude/Core/EncodingBase.rs")
    assert(encoding.contains("while out.len() % 8 != 0"))
    assert(encoding.contains("s.len() % 2 != 0"))
    assert(read_peer("crates/jet-jit/src/Encoding.rs").contains("encoding_base_rt::jet_std_base32_encode"))
    text :: read_peer("crates/jet-comptime/src/Comptime/TextLite.rs")
    assert(text.contains("UnicodeTables.rs"))
    assert(text.contains("UnicodeString.rs"))
    assert(text.contains("CoreLib/Top/Text.rs"))
    assert(not text.contains("fn nfd_inner"))
    url :: read_peer("crates/jet-comptime/src/Comptime/UrlLite.rs")
    assert(url.contains("CoreLib/JetStd/UrlMime.rs"))
    assert(url.contains("jet_url_percent_decode_str"))
    assert(not url.contains("fn url_valid_scheme"))
}
