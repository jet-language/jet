}
// Rust: tests/comptime_core_pure_parity.rs:548
#Test("primitive_static_stringification_is_rejected_by_sema") {
    source :: `fn run() {
    print(Bool.to_string())
    print(Char.to_string())
}`
    diagnostics :: jet.compile(source).expect_err("primitive stringification belongs to values, not static type names")
    assert_eq(diagnostics.iter().map(|diagnostic| -> (diagnostic.code, diagnostic.what)).collect(), [("E0102", "`Bool` has no static method `to_string`"), ("E0102", "`Char` has no static method `to_string`")])
}
// Rust: tests/comptime_core_pure_parity.rs:568
#Test("public_transcript_keeps_checked_types_in_imported_functions") {
    assert_eq(exact_values(["use core.math as math", `fn imported_g(x: U8) -> Int {
    y :: math.abs(-1.0)
    return (x).leading_zeros()
}`, "imported_g(13)"]), ["4 : Int"])
}
// Rust: tests/comptime_core_pure_parity.rs:581
#Test("public_transcript_composes_email_and_codecs_exactly") {
    values :: exact_values([
        "use core.email as email", "use core.encoding.xml as xml",
        `sender :: email.address("Mara <mara@example.com>") ?? panic("sender")`,
        `recipient :: email.address("ada@example.net") ?? panic("recipient")`,
        `attachment :: email.attachment("note.txt", "Text/Plain", [104, 105]) ?? panic("attachment")`,
        `message :: email.message(sender, [recipient], [Address]{}, "Hello", "body", HTML{""}, [attachment]) ?? panic("message")`,
        "email.envelope(sender, [recipient])",
        `fn serialized(message: Message) -> Bool {
    if email.serialize(message) == {
        Ok(_) -> return true
        Err(_) -> return false
    }
    return false
}`, "serialized(message)",
        `xml.canonical(xml.parse("<r b=\"2\" a=\"1\"><x/></r>") ?? panic("xml"), xml.XMLCanonical{ mode: .Inclusive11, comments: false, inclusive_prefixes: [] }) ?? panic("canonical")`
    ])
    assert_eq(values, ["Envelope(from: Address(display: Mara, mailbox: mara@example.com), recipients: [Address(display: null, mailbox: ada@example.net)]) : Result", "true : Bool", "\"<r a=\"1\" b=\"2\"><x></x></r>\" : String"])
}
