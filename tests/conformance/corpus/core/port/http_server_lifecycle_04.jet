//RS 
//RS fn rustls_fixture_client_with_alpn(
//RS     addr: std::net::SocketAddr,
//RS     alpn_protocols: &[&[u8]],
//RS ) -> rustls::StreamOwned<rustls::ClientConnection, std::net::TcpStream> {
//RS     use rustls::client::danger::{HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier};
//RS     use rustls::pki_types::{CertificateDer, ServerName, UnixTime};
//RS     use rustls::{DigitallySignedStruct, Error as TLSError, SignatureScheme};
//RS 
//RS     let _ = rustls::crypto::ring::default_provider().install_default();
