    mux :: jet_http_mux_new()
    calls :: Arc.new(AtomicUsize.new(0))
    handler_calls :: calls.clone()
    jet_http_mux_add(&mux, "GET", "/resource", _ -> {
        _ :: handler_calls.fetch_add(1, Ordering.AcqRel)
        jet_http_srv_response(200, &"GET")
    })
    lower_handler_calls :: calls.clone()
    jet_http_mux_add(&mux, "get", "/resource", _ -> {
        _ :: lower_handler_calls.fetch_add(1, Ordering.AcqRel)
        jet_http_srv_response(200, &"get")
    })
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 16
    server :: thread.spawn(() -> {
        jet_http_server_run_listener(^listener, ^mux, ^options, ^server_shutdown, None, None, None).expect("server")
    })
    loop method in ["GET", "get"] {
        response :: exchange(addr, "{method} /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
        assert(response.starts_with("HTTP/1.1 200 OK"), "case-distinct route rejected: {response}")
        assert(response.ends_with("\r\n\r\n{method}"), "wrong case-distinct route dispatched: {response}")
    }
    loop method in ["GeT", "head", "options"] {
        response :: exchange(addr, "{method} /resource HTTP/1.1\r\nHost: local\r\n\r\nGET /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
        assert(response.starts_with("HTTP/1.1 405 Method Not Allowed"), "{method} matched uppercase semantics: {response}")
        assert(response.contains("Allow: GET, HEAD, OPTIONS, get\r\n"), "wrong exact Allow methods: {response}")
        assert_eq(response.matches("HTTP/1.1 200 OK").count(), 1, "valid unmatched method broke reuse: {response}")
        assert(response.ends_with("\r\n\r\nGET"), "uppercase successor did not dispatch: {response}")
    }
    assert_eq(calls.load(Ordering.Acquire), 5, "method case changed before routing")
    shutdown.store(true, Ordering.Release)
    report :: server.join().expect("server join")
    assert_eq(report.user_accepted, 5)
    assert_eq(report.user_completed, 5)
}

// Rust: tests/http_server_lifecycle.rs:3203
#Test("options_asterisk_reports_server_methods_without_dispatch") {
    // Rust: tests/http_server_lifecycle.rs:3207
    fn exchange(addr: SocketAddr, request: [U8]) -> String {
        stream := TcpStream.connect(addr).expect("connect")
        stream.write_all(request).expect("request write")
        stream.shutdown(Shutdown.Write).expect("finish request")
        response := [U8]{}
        buf := [U8#1024]{0}
        loop {
            read :: stream.read(&buf) ?? {
                if err.kind() == ErrorKind.ConnectionReset { break }
                panic("response read: {err}")
            }
            if read == 0 { break }
            response.extend_from_slice(buf[..<read])
        }
        String.from_utf8(^response).expect("response UTF-8")
    }
    listener :: TcpListener.bind("127.0.0.1:0").expect("bind")
    addr :: listener.local_addr().expect("address")
    mux :: jet_http_mux_new()
    calls :: Arc.new(AtomicUsize.new(0))
    loop (method, pattern) in [("GET", "/one"), ("POST", "/two"), ("get", "/three")] {
        handler_calls :: calls.clone()
        jet_http_mux_add(&mux, method, pattern, _ -> {
            _ :: handler_calls.fetch_add(1, Ordering.AcqRel)
            jet_http_srv_response(200, &"handled")
        })
    }
    middleware_calls :: Arc.new(AtomicUsize.new(0))
    middleware_events :: Arc.new(std.sync.Mutex.new([String]{}))
    wrapper_calls :: middleware_calls.clone()
    wrapper_events :: middleware_events.clone()
    jet_http_mux_middleware(&mux, Arc.new((next_handler: JetHTTPHandler) -> {
        calls :: wrapper_calls.clone()
        events :: wrapper_events.clone()
        Arc.new((req: JetHTTPRequest) -> {
            _ :: calls.fetch_add(1, Ordering.AcqRel)
            events.lock().unwrap().push("{req.method}:{req.path}")
            next_handler(^req).map(response -> {
                jet_http_srv_response_header(^response, &"X-Middleware", &"observed")
            })
        })
    }) as JetHTTPMiddleware)
    jet_http_mux_middleware(&mux, Arc.new((next_handler: JetHTTPHandler) -> {
        Arc.new((req: JetHTTPRequest) -> {
            if jet_http_srv_req_header(&req, &"X-Block").is_some() {
                Ok(jet_http_srv_response(403, &"blocked"))
            } else {
                next_handler(^req)
            }
        })
    }) as JetHTTPMiddleware)
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 16
    server :: thread.spawn(() -> {
        jet_http_server_run_listener(^listener, ^mux, ^options, ^server_shutdown, None, None, None).expect("server")
    })
    standalone :: exchange(addr, "OPTIONS * HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert(standalone.starts_with("HTTP/1.1 204 No Content"), "server-wide OPTIONS rejected: {standalone}")
    assert(standalone.contains("Allow: GET, HEAD, OPTIONS, POST, get\r\n"), "wrong server-wide Allow: {standalone}")
    assert_eq(standalone.matches("X-Middleware: observed\r\n").count(), 1, "middleware did not wrap OPTIONS exactly once: {standalone}")
    path_local :: exchange(addr, "OPTIONS /one HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert(path_local.starts_with("HTTP/1.1 204 No Content"), "path OPTIONS rejected: {path_local}")
    assert(path_local.contains("Allow: GET, HEAD, OPTIONS\r\n"), "wrong path Allow: {path_local}")
    assert_eq(path_local.matches("X-Middleware: observed\r\n").count(), 1, "middleware did not wrap path OPTIONS exactly once: {path_local}")
    blocked :: exchange(addr, "OPTIONS * HTTP/1.1\r\nHost: local\r\nX-Block: yes\r\nConnection: close\r\n\r\n".as_bytes())
    assert(blocked.starts_with("HTTP/1.1 403 Forbidden"), "middleware could not reject OPTIONS: {blocked}")
    assert(!blocked.contains("Allow:"), "rejected OPTIONS leaked method inventory: {blocked}")
    assert_eq(blocked.matches("X-Middleware: observed\r\n").count(), 1, "rejection was not wrapped exactly once: {blocked}")
    response :: exchange(addr, "OPTIONS * HTTP/1.1\r\nHost: local\r\n\r\nGET /one HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert(response.starts_with("HTTP/1.1 204 No Content"), "server-wide OPTIONS rejected: {response}")
    assert(response.contains("Allow: GET, HEAD, OPTIONS, POST, get\r\n"), "wrong server-wide Allow: {response}")
    assert_eq(response.matches("X-Middleware: observed\r\n").count(), 2, "middleware did not wrap each pipelined request once: {response}")
    assert_eq(response.matches("HTTP/1.1 200 OK").count(), 1, "OPTIONS * broke pipeline reuse: {response}")
    assert(response.ends_with("\r\n\r\nhandled"), "successor request did not dispatch: {response}")
    loop request_target in ["GET *", "GeT *", "OPTIONS **", "OPTIONS *?query"] {
        request :: "{request_target} HTTP/1.1\r\nHost: local\r\n\r\nGET /one HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n"
        response :: exchange(addr, request.as_bytes())
        assert(response.starts_with("HTTP/1.1 400 Bad Request"), "invalid asterisk-form accepted: {response}")
        assert(!response.contains("200 OK"), "invalid asterisk-form dispatched or reused: {response}")
        assert_eq(response.matches("HTTP/1.1").count(), 1, "invalid asterisk-form reused connection: {response}")
    }
    assert_eq(calls.load(Ordering.Acquire), 1, "OPTIONS or invalid asterisk-form invoked a handler")
    assert_eq(middleware_calls.load(Ordering.Acquire), 5, "OPTIONS middleware count changed")
    assert_eq(middleware_events.lock().unwrap(), ["OPTIONS:*", "OPTIONS:/one", "OPTIONS:*", "OPTIONS:*", "GET:/one"])
    shutdown.store(true, Ordering.Release)
    report :: server.join().expect("server join")
    assert_eq(report.user_accepted, 8)
    assert_eq(report.user_completed, 8)
}

// Rust: tests/http_server_lifecycle.rs:3416
#Test("connection_options_are_tokens_before_reuse_or_body_permission") {
    // Rust: tests/http_server_lifecycle.rs:3420
    fn exchange(addr: SocketAddr, request: [U8]) -> String {
        stream := TcpStream.connect(addr).expect("connect")
        stream.write_all(request).expect("request write")
        stream.shutdown(Shutdown.Write).expect("finish request")
        response := [U8]{}
        buf := [U8#1024]{0}
        loop {
            read :: stream.read(&buf) ?? {
                if err.kind() == ErrorKind.ConnectionReset { break }
                panic("response read: {err}")
            }
            if read == 0 { break }
            response.extend_from_slice(buf[..<read])
        }
        String.from_utf8(^response).expect("response UTF-8")
    }
    listener :: TcpListener.bind("127.0.0.1:0").expect("bind")
    addr :: listener.local_addr().expect("address")
    mux :: jet_http_mux_new()
    calls :: Arc.new(AtomicUsize.new(0))
    handler_calls :: calls.clone()
    jet_http_mux_add(&mux, "GET", "/resource", _ -> {
        _ :: handler_calls.fetch_add(1, Ordering.AcqRel)
        jet_http_srv_response(200, &"ok")
    })
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 16
    server :: thread.spawn(() -> {
        jet_http_server_run_listener(^listener, ^mux, ^options, ^server_shutdown, None, None, None).expect("server")
    })
    http10_extensions :: exchange(addr, "GET /resource HTTP/1.0\r\nHost: local\r\nConnection: custom!#$%&'*+-.^_`|~\r\nConnection:\tKEEP-ALIVE \t\r\n\r\nGET /resource HTTP/1.0\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert_eq(http10_extensions.matches("HTTP/1.0 200 OK").count(), 2, http10_extensions)
    empty_members :: exchange(addr, "GET /resource HTTP/1.1\r\nHost: local\r\nConnection: , ,\r\n\r\nGET /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert_eq(empty_members.matches("HTTP/1.1 200 OK").count(), 2, empty_members)
    close_dominates :: exchange(addr, "GET /resource HTTP/1.1\r\nHost: local\r\nConnection: keep-alive, extension, CLOSE\r\n\r\nGET /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
    assert_eq(close_dominates.matches("HTTP/1.1 200 OK").count(), 1, close_dominates)
    assert(close_dominates.contains("Connection: close"), close_dominates)
    loop invalid_connection in ["Connection: \"close\"", "Connection: bad/option", "Connection: bad;option", "Connection: bad option", "Connection: café", "Connection: keep-alive\r\nConnection: bad/option"] {
        request :: "GET /resource HTTP/1.1\r\nHost: local\r\n{invalid_connection}\r\n\r\nGET /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n"
        response :: exchange(addr, request.as_bytes())
        assert(response.starts_with("HTTP/1.1 400 Bad Request"), "accepted invalid Connection: {response}")
        assert(!response.contains("200 OK"), "invalid Connection dispatched or reused: {response}")
        assert_eq(response.matches("HTTP/1.1").count(), 1, "invalid Connection reused socket: {response}")
    }
    invalid_expect :: exchange(addr, "GET /resource HTTP/1.1\r\nHost: local\r\nConnection: bad/option\r\nContent-Length: 1\r\nExpect: 100-continue\r\n\r\n".as_bytes())
    assert(invalid_expect.starts_with("HTTP/1.1 400 Bad Request"), invalid_expect)
    assert(!invalid_expect.contains("100 Continue"), "invalid Connection received body permission: {invalid_expect}")
    assert_eq(calls.load(Ordering.Acquire), 5, "invalid Connection reached handler")
    shutdown.store(true, Ordering.Release)
    report :: server.join().expect("server join")
    assert_eq(report.user_accepted, 10)
    assert_eq(report.user_completed, 10)
}
