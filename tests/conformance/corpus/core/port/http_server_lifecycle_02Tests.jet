#Test("request_method_is_one_http_token_before_body_or_dispatch") {
    // Rust: tests/http_server_lifecycle.rs:2998
    fn exchange(addr: SocketAddr, request: [U8]) -> String {
        stream := TcpStream.connect(addr).expect("connect")
        stream.write_all(request).expect("request write")
        stream.shutdown(Shutdown.Write).expect("finish request")
        response := [U8]{}
        buf := [U8#1024]{0}
        loop {
            read :: stream.read(&buf) ?? {
                if err.kind() == ErrorKind.ConnectionReset { break }
                panic("response read: {err}")
            }
            if read == 0 { break }
            response.extend_from_slice(buf[..<read])
        }
        String.from_utf8(^response).expect("response UTF-8")
    }
    listener :: TcpListener.bind("127.0.0.1:0").expect("bind")
    addr :: listener.local_addr().expect("address")
    mux :: jet_http_mux_new()
    calls :: Arc.new(AtomicUsize.new(0))
    loop method in ["GET", "M-SEARCH", "custom!#$%&'*+-.^_`|~"] {
        handler_calls :: calls.clone()
        jet_http_mux_add(&mux, method, "/resource", req -> {
            _ :: handler_calls.fetch_add(1, Ordering.AcqRel)
            jet_http_srv_response(200, &req.method)
        })
    }
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 16
    server :: thread.spawn(() -> {
        jet_http_server_run_listener(^listener, ^mux, ^options, ^server_shutdown, None, None, None).expect("server")
    })
    loop method in ["GET", "M-SEARCH", "custom!#$%&'*+-.^_`|~"] {
        response :: exchange(addr, "{method} /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n".as_bytes())
        assert(response.starts_with("HTTP/1.1 200 OK"), "valid method rejected: {response}")
        assert(response.ends_with("\r\n\r\n{method}"), "method changed before dispatch: {response}")
    }
    loop invalid_method in ["G/ET", "G:ET", "G\\ET", "GÉT", "GET\t", "GE(T", "", "\u{007f}GET"] {
        request :: "{invalid_method} /resource HTTP/1.1\r\nHost: local\r\n\r\nGET /resource HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n"
        response :: exchange(addr, request.as_bytes())
        assert(response.starts_with("HTTP/1.1 400 Bad Request"), "accepted invalid method: {response}")
        assert(!response.contains("200 OK"), "invalid method dispatched or reused: {response}")
        assert_eq(response.matches("HTTP/1.1").count(), 1, "invalid method reused connection: {response}")
    }
    invalid_expect :: exchange(addr, "G/ET /resource HTTP/1.1\r\nHost: local\r\nContent-Length: 1\r\nExpect: 100-continue\r\n\r\n".as_bytes())
    assert(invalid_expect.starts_with("HTTP/1.1 400 Bad Request"), invalid_expect)
    assert(!invalid_expect.contains("100 Continue"), "invalid method received body permission: {invalid_expect}")
    assert_eq(calls.load(Ordering.Acquire), 3, "invalid method reached handler")
    shutdown.store(true, Ordering.Release)
    report :: server.join().expect("server join")
    assert_eq(report.user_accepted, 12)
    assert_eq(report.user_completed, 12)
}

