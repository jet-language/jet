        chunk := [U8].repeat(0, 512)
        loop !out.windows(4).any(window -> window == b"\r\n\r\n") {
            read :: stream.read(&chunk).unwrap()
            assert_ne(read, 0)
            out.extend_from_slice(chunk[..read])
        }
        ^out
    }
