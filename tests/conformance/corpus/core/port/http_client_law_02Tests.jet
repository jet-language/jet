            (socket, _) :: cookie_https.accept().unwrap()
            connection :: rustls.ServerConnection.new(shared_server.clone()).unwrap()
            stream := rustls.StreamOwned.new(^connection, ^socket)
            head :: String.from_utf8(request_head(&stream)).unwrap().to_ascii_lowercase()
            if request == 0 {
                assert(!head.contains("\r\ncookie:"), "unexpected seed cookie: {head}")
                stream.write_all(b"HTTP/1.1 200 OK\r\nSet-Cookie: session=secure; Path=/; Secure\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap()
            } else if request == 1 {
                assert(head.contains("\r\ncookie: session=secure\r\n"), "insecure overwrite won: {head}")
                assert(!head.contains("injected="), "HTTP set a Secure cookie: {head}")
                stream.write_all(b"HTTP/1.1 200 OK\r\nSet-Cookie: session=https-plain; Path=/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap()
            } else {
                assert(head.contains("\r\ncookie: session=https-plain\r\n"), "HTTPS replacement lost: {head}")
                stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap()
            }
            stream.flush().unwrap()
        }
    })
