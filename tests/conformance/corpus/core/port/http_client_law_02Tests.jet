use tests.common as common
use tests.conformance.corpus.core.port.http_client_law.[request_head, read_h2_frame, write_h2_frame]
use std.net.[TcpListener, TcpStream]
use std.io.[Read, Write, ErrorKind]
use std.sync.Arc
use std.sync.atomic.[AtomicBool, AtomicUsize, Ordering]
use std.time.[Duration, Instant]
use std.thread
use std.fs as fs
use std.process.[Command, Stdio]
use std.env as env
use std.process as process
use jet
use jet_http_bridge as bridge
use rustls
// GATE #4494: TLS server connection/certificate/key native bindings retain the real provider.
// GATE #4494: real sockets, FIFO files, atomic synchronization, subprocesses and TLS providers.
// GATE #4409: preserve WouldBlock separately from other accept failures.

// Rust: tests/http_client_law.rs:1803
#Test("unknown_length_upload_uses_h1_chunked_transfer_encoding") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    dir :: env.temp_dir().join("jet_http_client_upload_chunked_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    fifo :: dir.join("upload.fifo")
    assert(Command.new("mkfifo").arg(&fifo).status().unwrap().success(), "mkfifo failed")
    accepted :: Arc.new(AtomicBool.new(false))
    accepted_flag :: accepted.clone()
    seen_chunked :: Arc.new(AtomicBool.new(false))
    seen_flag :: seen_chunked.clone()
    body_len :: 96 * 1024
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        accepted_flag.store(true, Ordering.SeqCst)
        head :: request_head(&stream)
        assert(head.starts_with(b"POST /chunked HTTP/1.1\r\n"))
        head_text :: String.from_utf8_lossy(head).to_ascii_lowercase()
        assert(head_text.contains("transfer-encoding: chunked"), "missing chunked transfer: {head_text}")
        assert(!head_text.contains("content-length:"), "unexpected content-length: {head_text}")
        got := 0
        buf := [U8].repeat(0, 4096)
        pending := [U8]{}
        loop {
            read :: stream.read(&buf).unwrap()
            assert_ne(read, 0, "chunked upload ended early at {got}")
            pending.extend_from_slice(buf[..read])
            loop {
                line_end :: pending.windows(2).position(window -> window == b"\r\n")
                if line_end == None { break }
                end :: line_end.unwrap()
                line :: String.from_utf8_lossy(pending[..end]).to_string()
                _ :: pending.drain(..end + 2)
                trimmed := line.trim() // #4303
                size :: USize.from_str_radix(trimmed, 16).expect("chunk size")
                if size == 0 {
                    assert(pending.starts_with(b"\r\n") || pending.is_empty() || pending == b"\r\n")
                    stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok").unwrap()
                    return got
                }
                loop pending.len() < size + 2 {
                    read :: stream.read(&buf).unwrap()
                    assert_ne(read, 0, "chunked body truncated at {got}")
                    pending.extend_from_slice(buf[..read])
                }
                assert_eq(pending[size..size + 2], b"\r\n")
                got += size
                _ :: pending.drain(..size + 2)
                if got >= 64 * 1024 { seen_flag.store(true, Ordering.SeqCst) }
            }
        }
    })
    fifo_writer :: fifo.clone()
    writer :: thread.spawn(() -> {
        file := fs.OpenOptions.new().write(true).open(&fifo_writer).unwrap()
        first :: [U8].repeat(b'a', 32 * 1024)
        file.write_all(first).unwrap()
        deadline :: Instant.now() + Duration.from_secs(5)
        loop !accepted.load(Ordering.SeqCst) {
            assert(Instant.now() < deadline, "client buffered the chunked upload before connecting")
            thread.yield_now()
        }
        rest :: [U8].repeat(b'b', body_len - first.len())
        file.write_all(rest).unwrap()
    })
    fifo_path :: fifo.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    src :: """
use core.http.client as http
use core.http as message
use core.files as files
fn run() {
    input :: files.open("{fifo_path}") ?? panic("open")
    body :: message.Body.reader(^input) ?? panic("reader")
    req :: http.request("POST", "http://{addr}/chunked").body(body).redirects(0)
    resp :: req.send() ?? panic("send")
    print(resp.body().text(8) ?? panic("body"))
}
"""
    (code, stdout, stderr) :: common.build_and_run("jet_http_client_law", "upload_chunked", src)
    got :: server.join().unwrap()
    writer.join().unwrap()
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "ok\n")
    assert_eq(got, body_len)
    assert(seen_chunked.load(Ordering.SeqCst), "server never saw a streamed chunked upload boundary")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/http_client_law.rs:1930
#Test("h2_upload_streams_data_frames_before_body_eof") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    dir :: env.temp_dir().join("jet_http_client_upload_h2_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    fifo :: dir.join("upload.fifo")
    assert(Command.new("mkfifo").arg(&fifo).status().unwrap().success(), "mkfifo failed")
    accepted :: Arc.new(AtomicBool.new(false))
    accepted_flag :: accepted.clone()
    seen_data :: Arc.new(AtomicBool.new(false))
    seen_flag :: seen_data.clone()
    body_len :: 40 * 1024
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        accepted_flag.store(true, Ordering.SeqCst)
        stream.set_read_timeout(Some(Duration.from_secs(5))).unwrap()
        preface := [U8].repeat(0, 24)
        stream.read_exact(&preface).unwrap()
        assert_eq(preface, b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
        assert_eq(read_h2_frame(&stream).0, 4)
        write_h2_frame(&stream, 4, 0, 0, [])
        got := 0
        end := false
        loop !end {
            frame :: read_h2_frame(&stream)
            if frame.0 == 6 && frame.1 & 1 == 0 {
                write_h2_frame(&stream, 6, 1, 0, frame.3)
                next
            }
            if frame.0 == 1 { next }
            if frame.0 == 0 {
                got += frame.3.len()
                if got >= 16 * 1024 { seen_flag.store(true, Ordering.SeqCst) }
                if frame.1 & 1 != 0 { end = true }
            }
        }
        assert_eq(got, body_len)
        write_h2_frame(&stream, 1, 4, 1, [U8]{0x88, 0x0f, 0x0d, 0x01, b'2'})
        write_h2_frame(&stream, 0, 1, 1, b"ok")
        _ :: read_h2_frame(&stream)
        got
    })
    fifo_writer :: fifo.clone()
    writer :: thread.spawn(() -> {
        file := fs.OpenOptions.new().write(true).open(&fifo_writer).unwrap()
        first :: [U8].repeat(b'x', 8 * 1024)
        file.write_all(first).unwrap()
        deadline :: Instant.now() + Duration.from_secs(5)
        loop !accepted.load(Ordering.SeqCst) {
            assert(Instant.now() < deadline, "H2 client buffered the upload before connecting")
            thread.yield_now()
        }
        rest :: [U8].repeat(b'y', body_len - first.len())
        file.write_all(rest).unwrap()
    })
    fifo_path :: fifo.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    // Rust: tests/http_client_law.rs:2025-2088; the native harness is Jet, not a Rust callback.
    src :: """
use jet_http_bridge as bridge
use std.fs as fs
use std.io.Read
fn run() {
    root :: bridge.jet_http_client_new_impl()
    client :: bridge.jet_http_client_protocols_impl(root, true, false, true).unwrap()
    file := fs.File.open("{fifo_path}").unwrap()
    offset := 0
    total :: {body_len}
    body_read := () -> {
        if offset >= total { return .Ok(None) }
        want :: (64 * 1024).min(total - offset)
        chunk := [U8].repeat(0, want)
        filled := 0
        loop filled < want {
            read :: file.read(&chunk[filled..]).map_err(_ -> bridge.JetHTTPBridgeError.IO)?
            if read == 0 { break }
            filled += read
        }
        if filled == 0 { return .Ok(None) }
        chunk.truncate(filled)
        offset += filled
        .Ok(Some(^chunk))
    }
    response :: bridge.jet_http_client_send_with_stream_parts_impl(
        client, "POST", "http://{addr}/h2", [], Some(I64{total}), true, &body_read,
        None, None, None, None, None, None, None, None, Some(0), None, [], [], []
    ).unwrap()
    assert_eq(bridge.jet_http_client_body_read_impl(response.body_handle, 8).unwrap(), Some(b"ok".to_vec()))
    assert_eq(response.context.protocol, "HTTP/2")
}
"""
    (code, _, stderr) :: common.build_and_run("jet_http_client_law", "h2_upload", src)
    got :: server.join().unwrap()
    writer.join().unwrap()
    assert_eq(code, 0, "bridge H2 upload harness failed:\n{stderr}")
    assert_eq(got, body_len)
    assert(seen_data.load(Ordering.SeqCst), "server never saw streamed H2 DATA before EOF")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/http_client_law.rs:2109
#Test("public_client_proxy_none_ignores_environment_proxy") {
    origin :: TcpListener.bind("127.0.0.1:0").unwrap()
    origin_addr :: origin.local_addr().unwrap()
    proxy :: TcpListener.bind("127.0.0.1:0").unwrap()
    proxy_addr :: proxy.local_addr().unwrap()
    origin_server :: thread.spawn(() -> {
        (stream, _) := origin.accept().unwrap()
        head :: request_head(&stream)
        assert(String.from_utf8_lossy(head).starts_with("GET /direct HTTP/1.1\r\n"),
            "expected direct origin request, got {String.from_utf8_lossy(head)}")
        stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\ndirect").unwrap()
    })
    proxy_server :: thread.spawn(() -> {
        proxy.set_nonblocking(true).unwrap()
        deadline :: Instant.now() + Duration.from_millis(400)
        loop {
            if proxy.accept() == {
                .Ok(_) -> panic("environment proxy should not receive traffic")
                .Err(error) -> {
                    if error.kind() != ErrorKind.WouldBlock { panic("proxy accept failed: {error}") }
                    if Instant.now() >= deadline { break }
                    thread.yield_now()
                }
            }
        }
    })
    src :: """
use core.http.client as http
fn run() {
    client :: http.Client.new().proxy(.None)
    resp :: client.send(http.request("GET", "http://{origin_addr}/direct")) ?? panic("send")
    print(resp.body().text(16) ?? panic("body"))
}
"""
    dir :: common.unique_tmp("jet_http_client_law")
    fs.create_dir_all(&dir).unwrap()
    jet_path :: dir.join("public_proxy_none.jet")
    fs.write(&jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: jet.compile_with_path(src, shown).unwrap_or_else(diags -> {
        panic("front end rejected:\n{jet.render_diagnostics(shown, src, diags)}")
    })
    rs :: dir.join("public_proxy_none.rs")
    bin :: dir.join("public_proxy_none")
    fs.write(&rs, out.rust).unwrap()
    rustc_cmd := Command.new("rustc")
    rustc_cmd.args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if out.ffi != None {
        link :: out.ffi.unwrap()
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(dir -> dir.is_dir()) {
            rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    rustc :: rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code (I2 violation):\n{String.from_utf8_lossy(rustc.stderr)}")
    run :: Command.new(&bin)
        .env("http_proxy", "http://{proxy_addr}").env("HTTP_PROXY", "http://{proxy_addr}")
        .env("all_proxy", "http://{proxy_addr}").env("ALL_PROXY", "http://{proxy_addr}")
        .env_remove("no_proxy").env_remove("NO_PROXY").output().unwrap()
    origin_server.join().unwrap()
    proxy_server.join().unwrap()
    _ :: fs.remove_dir_all(&dir)
    assert_eq(run.status.code().unwrap_or(0), 0, "stderr:\n{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "direct\n")
}

// Rust: tests/http_client_law.rs:2212
#Test("public_client_proxy_url_sends_absolute_form") {
    proxy :: TcpListener.bind("127.0.0.1:0").unwrap()
    proxy_addr :: proxy.local_addr().unwrap()
    server :: thread.spawn(() -> {
        (stream, _) := proxy.accept().unwrap()
        head :: request_head(&stream)
        text :: String.from_utf8_lossy(head)
        assert(text.starts_with("GET http://example.invalid/via-proxy HTTP/1.1\r\n"), "expected absolute-form proxy request, got {text}")
        stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nproxy").unwrap()
    })
    src :: """
use core.http.client as http
fn run() {
    client :: http.Client.new().proxy(.URL("http://{proxy_addr}"))
    resp :: client.send(http.request("GET", "http://example.invalid/via-proxy")) ?? panic("send")
    print(resp.body().text(16) ?? panic("body"))
}
"""
    (code, stdout, stderr) :: common.build_and_run("jet_http_client_law", "public_proxy_url", src)
    server.join().unwrap()
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "proxy\n")
}

// Rust: tests/http_client_law.rs:2245
#Test("public_client_tls_custom_only_trust") {
    probe :: TcpListener.bind("127.0.0.1:0").unwrap()
    port :: probe.local_addr().unwrap().port()
    drop(^probe)
    root :: OSPath.from(env.manifest_dir())
    ca :: root.join("tests/fixtures/tls/smtp.ca.cert.pem")
    wrong_ca :: root.join("tests/fixtures/tls/localhost.cert.pem")
    cert :: root.join("tests/fixtures/tls/smtp.server.cert.pem")
    key :: root.join("tests/fixtures/tls/smtp.server.key.pem")
    server := Command.new("openssl")
        .args(["s_server", "-quiet", "-www", "-accept", port.to_string(), "-cert"])
        .arg(&cert).arg("-key").arg(&key).arg("-CAfile").arg(&ca)
        .stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("openssl s_server")
    thread.sleep(Duration.from_millis(250))
    empty_src :: """
use core.net.tls as tls
fn run() {
    empty :: [U8]{}
    if tls.RootCertificates.from_pem(empty) == {
        .Ok(_) -> print("empty-ok")
        .Err(_) -> print("empty-fail")
    }
}
"""
    (empty_code, empty_out, empty_err) :: common.build_and_run("jet_http_client_law", "public_tls_empty_root", empty_src)
    assert_eq(empty_code, 0, "stderr:\n{empty_err}")
    assert_eq(empty_out, "empty-fail\n")
    wrong :: wrong_ca.display()
    wrong_src :: """
use core.http.client as http
use core.net.tls as tls
use core.files as fs
fn run() {
    pem :: fs.read_bytes("{wrong}") ?? panic("wrong ca")
    roots :: tls.RootCertificates.from_pem(pem) ?? panic("roots")
    cfg :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("cfg")
    client :: http.Client.new().tls(cfg).protocols(false, true, false)
    if client.send(http.request("GET", "https://localhost:{port}/")) == {
        .Ok(_) -> print("ok")
        .Err(_) -> print("tls-fail")
    }
}
"""
    (wrong_code, wrong_out, wrong_err) :: common.build_and_run("jet_http_client_law", "public_tls_wrong_root", wrong_src)
    assert_eq(wrong_code, 0, "stderr:\n{wrong_err}")
    assert_eq(wrong_out, "tls-fail\n")
    pass_src :: """
use core.http.client as http
use core.net.tls as tls
use core.files as fs
fn run() {
    pem :: fs.read_bytes("{ca.display()}") ?? panic("ca")
    roots :: tls.RootCertificates.from_pem(pem) ?? panic("roots")
    cfg :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("cfg")
    client :: http.Client.new().tls(cfg).protocols(false, true, false)
    resp :: client.send(http.request("GET", "https://localhost:{port}/")) ?? panic("send")
    print(resp.status())
}
"""
    (pass_code, pass_out, pass_err) :: common.build_and_run("jet_http_client_law", "public_tls_custom_only", pass_src)
    _ :: server.kill()
    _ :: server.wait()
    assert_eq(pass_code, 0, "stderr:\n{pass_err}")
    assert_eq(pass_out, "200\n")
}

// Rust: tests/http_client_law.rs:2341
#Test("public_client_tls_identity_and_version_bounds") {
    dir :: env.temp_dir().join("jet_http_client_tls_policy_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    ca_key :: dir.join("ca.key.pem")
    ca_cert :: dir.join("ca.cert.pem")
    ca :: Command.new("openssl")
        .args(["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1", "-subj", "/CN=jet-http-ca", "-keyout"])
        .arg(&ca_key).arg("-out").arg(&ca_cert).output().expect("openssl ca")
    assert(ca.status.success(), "{String.from_utf8_lossy(ca.stderr)}")
    // Rust: tests/http_client_law.rs:2375
    make_cert :: (name: String, usage: String) -> {
        key :: dir.join("{name}.key.pem")
        csr :: dir.join("{name}.csr.pem")
        cert :: dir.join("{name}.cert.pem")
        ext :: dir.join("{name}.ext")
        serial :: dir.join("{name}.srl")
        fs.write(&ext, "subjectAltName=DNS:localhost\nextendedKeyUsage={usage}\n").unwrap()
        req :: Command.new("openssl")
            .args(["req", "-new", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN={name}", "-keyout"])
            .arg(&key).arg("-out").arg(&csr).output().unwrap()
        assert(req.status.success(), "{String.from_utf8_lossy(req.stderr)}")
        sign :: Command.new("openssl")
            .args(["x509", "-req", "-days", "1", "-CAcreateserial", "-CAserial"])
            .arg(&serial).arg("-CA").arg(&ca_cert).arg("-CAkey").arg(&ca_key)
            .arg("-extfile").arg(&ext).arg("-in").arg(&csr).arg("-out").arg(&cert).output().unwrap()
        assert(sign.status.success(), "{String.from_utf8_lossy(sign.stderr)}")
        (cert, key)
    }
    (server_cert, server_key) :: make_cert("localhost", "serverAuth")
    (client_cert, client_key) :: make_cert("jet-client", "clientAuth")
    probe :: TcpListener.bind("127.0.0.1:0").unwrap()
    version_port :: probe.local_addr().unwrap().port()
    drop(^probe)
    tls12_server := Command.new("openssl")
        .args(["s_server", "-quiet", "-www", "-tls1_2", "-accept", version_port.to_string(), "-CAfile"])
        .arg(&ca_cert).arg("-cert").arg(&server_cert).arg("-key").arg(&server_key)
        .stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("openssl tls1_2 s_server")
    thread.sleep(Duration.from_millis(250))
    version_src :: """
use core.http.client as http
use core.net.tls as tls
use core.files as fs
fn run() {
    pem :: fs.read_bytes("{ca_cert.display()}") ?? panic("ca")
    roots :: tls.RootCertificates.from_pem(pem) ?? panic("roots")
    base :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("trust")
    only13 :: base.with_version_bounds(min: .TLS13, max: .TLS13) ?? panic("tls13")
    client13 :: http.Client.new().tls(only13).protocols(false, true, false)
    if client13.send(http.request("GET", "https://localhost:{version_port}/")) == {
        .Ok(_) -> print("tls13-ok")
        .Err(_) -> print("tls13-fail")
    }
    only12 :: base.with_version_bounds(min: .TLS12, max: .TLS12) ?? panic("tls12")
    client12 :: http.Client.new().tls(only12).protocols(false, true, false)
    resp :: client12.send(http.request("GET", "https://localhost:{version_port}/")) ?? panic("tls12 send")
    print(resp.status())
}
"""
    (version_code, version_out, version_err) :: common.build_and_run("jet_http_client_law", "public_tls_version_bounds", version_src)
    _ :: tls12_server.kill()
    _ :: tls12_server.wait()
    assert_eq(version_code, 0, "stderr:\n{version_err}")
    assert_eq(version_out, "tls13-fail\n200\n")
    probe2 :: TcpListener.bind("127.0.0.1:0").unwrap()
    mtls_port :: probe2.local_addr().unwrap().port()
    drop(^probe2)
    mtls_server := Command.new("openssl")
        .args(["s_server", "-quiet", "-www", "-Verify", "1", "-verify_return_error", "-accept", mtls_port.to_string(), "-CAfile"])
        .arg(&ca_cert).arg("-cert").arg(&server_cert).arg("-key").arg(&server_key)
        .stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("openssl mtls s_server")
    thread.sleep(Duration.from_millis(250))
    mtls_src :: """
use core.http.client as http
use core.net.tls as tls
use core.files as fs
fn run() {
    ca :: fs.read_bytes("{ca_cert.display()}") ?? panic("ca")
    cert :: fs.read_bytes("{client_cert.display()}") ?? panic("cert")
    key :: fs.read_bytes("{client_key.display()}") ?? panic("key")
    roots :: tls.RootCertificates.from_pem(ca) ?? panic("roots")
    identity :: tls.ClientIdentity.from_pem(cert_chain: cert, private_key: key) ?? panic("identity")
    bare :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("bare")
    client_bare :: http.Client.new().tls(bare).protocols(false, true, false)
    if client_bare.send(http.request("GET", "https://localhost:{mtls_port}/")) == {
        .Ok(_) -> print("bare-ok")
        .Err(_) -> print("bare-fail")
    }
    cfg :: bare.with_client_identity(identity) ?? panic("with identity")
    client :: http.Client.new().tls(cfg).protocols(false, true, false)
    resp :: client.send(http.request("GET", "https://localhost:{mtls_port}/")) ?? panic("mtls send")
    print(resp.status())
}
"""
    (mtls_code, mtls_out, mtls_err) :: common.build_and_run("jet_http_client_law", "public_tls_client_identity", mtls_src)
    _ :: mtls_server.kill()
    _ :: mtls_server.wait()
    _ :: fs.remove_dir_all(&dir)
    assert_eq(mtls_code, 0, "stderr:\n{mtls_err}")
    assert_eq(mtls_out, "bare-fail\n200\n")
}

// Rust: tests/http_client_law.rs:2557
#Test("https_to_http_redirect_denied_unless_allow_http_downgrade") {
    // Rust: tests/http_client_law.rs:2583 (native harness helper)
    fn pem(path: OSPath) -> [U8] {
        text :: fs.read_to_string(path).unwrap()
        encoded :: text.lines().filter(line -> !line.starts_with("-----")).collect::<String>()
        out := [U8]{}
        bits := 0u32
        count := 0u8
        loop byte in encoded.bytes() {
            value :: if byte == {
                b'A'..=b'Z' -> byte - b'A'
                b'a'..=b'z' -> byte - b'a' + 26
                b'0'..=b'9' -> byte - b'0' + 52
                b'+' -> 62
                b'/' -> 63
                b'=' -> break
                _ -> next
            }
            bits = bits << 6 | U32.from(value)
            count += 6
            if count >= 8 {
                count -= 8
                out.push(U8{bits >> count})
                bits &= (1u32 << count).wrapping_sub(1)
            }
        }
        ^out
    }
