            stream.write_all(body.as_bytes()).unwrap()
            stream.flush().unwrap()
        }
    })
    root :: bridge.jet_http_client_new_impl()
    rooted :: bridge.jet_http_client_root_certificate_impl(root, root_cert, false).unwrap()
    client :: bridge.jet_http_client_protocols_impl(rooted, false, true, false).unwrap()
    url :: "https://localhost:{https_addr.port()}/from"
    denied :: bridge.jet_http_client_send_with_impl(
        client, "GET", url, [], None, None, None, None, None, None, None, None, None, None, None, [], [], []
    ).unwrap_err()
    assert(denied == bridge.JetHTTPBridgeError.Redirect)
    assert_eq(bridge.jet_http_client_open_body_count_impl(), 0, "HTTPS→HTTP deny must close the redirect response body")
    allowed_root :: bridge.jet_http_client_new_impl()
    allowed_rooted :: bridge.jet_http_client_root_certificate_impl(allowed_root, root_cert, false).unwrap()
    allowed_proto :: bridge.jet_http_client_protocols_impl(allowed_rooted, false, true, false).unwrap()
    allowed :: bridge.jet_http_client_allow_http_downgrade_impl(allowed_proto, true).unwrap()
    response :: bridge.jet_http_client_send_with_impl(
        allowed, "GET", url, [], None, None, None, None, None, None, None, None, None, None, None, [], [], []
    ).unwrap()
    assert_eq(response.status, 200)
    assert_eq(bridge.jet_http_client_body_read_impl(response.body_handle, 8).unwrap(), Some(b"ok".to_vec()))
    https_server.join().unwrap()
    http_server.join().unwrap()
    cookie_http :: TcpListener.bind("127.0.0.1:0").unwrap()
    cookie_http_addr :: cookie_http.local_addr().unwrap()
    cookie_http_server :: thread.spawn(() -> {
