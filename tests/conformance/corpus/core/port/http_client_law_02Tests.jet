// Rust: tests/http_client_law.rs:3703
#Test("h2_rejects_idle_stream_flood_before_queue_growth") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    closed :: Arc.new(AtomicBool.new(false))
    observed :: closed.clone()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        stream.set_read_timeout(Some(Duration.from_secs(5))).unwrap()
        stream.set_write_timeout(Some(Duration.from_secs(2))).unwrap()
        preface := [U8].repeat(0, 24)
        stream.read_exact(&preface).unwrap()
        assert_eq(preface, b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
        assert_eq(read_h2_frame(&stream).0, 4)
        write_h2_frame(&stream, 4, 0, 0, [])
        request :: loop {
            frame :: read_h2_frame(&stream)
            if frame.0 == 1 { break frame }
        }
        assert_eq(request.2, 1)
        // Keep response open; DATA for idle stream 3 must be rejected before queueing.
        write_h2_frame(&stream, 1, 4, 1, [U8]{0x88})
        chunk :: [U8].repeat(b'x', 64 * 1024)
        length :: U32{chunk.len()}.to_be_bytes()
        head := [U8].repeat(0, 9)
        head[..3].copy_from_slice(length[1..])
        head[3] = 0
        head[4] = 0
        head[5..].copy_from_slice(3u32.to_be_bytes())
        stream.write_all(head).unwrap()
        stream.write_all(chunk).unwrap()
        stream.set_read_timeout(Some(Duration.from_millis(50))).unwrap()
        deadline :: Instant.now() + Duration.from_millis(500)
        byte := [U8].repeat(0, 1)
        loop {
            if stream.read(&byte) == {
                .Ok(0) -> { observed.store(true, Ordering.Relaxed); break }
                .Ok(_) -> {}
                .Err(error) -> {
                    if error.kind() == ErrorKind.TimedOut || error.kind() == ErrorKind.WouldBlock {
                        if Instant.now() >= deadline { break }
                    } else {
                        observed.store(true, Ordering.Relaxed)
                        break
                    }
                }
            }
            if Instant.now() >= deadline { break }
        }
    })
    src :: """
use jet_http_bridge as bridge
fn run() {
    root :: bridge.jet_http_client_new_impl()
    client :: bridge.jet_http_client_protocols_impl(root, true, false, true).unwrap()
    response :: bridge.jet_http_client_send_with_impl(
        client, "GET", "http://{addr}/h2", [], None, None, None, None, None, None, None, None, None, None, None, [], [], []
    ).unwrap()
    assert_eq(response.status, 200)
    error :: bridge.jet_http_client_body_read_impl(response.body_handle, 64 * 1024).unwrap_err()
    assert_eq(error, bridge.JetHTTPBridgeError.InvalidFraming)
    bridge.jet_http_client_body_close_impl(response.body_handle)
    bridge.jet_http_client_drop_impl(client)
    bridge.jet_http_client_drop_impl(root)
}
"""
    (code, _, stderr) :: common.build_and_run("jet_http_client_law", "h2_idle_stream", src)
    server.join().unwrap()
    assert(closed.load(Ordering.Relaxed), "idle-stream peer remained open after invalid frame")
    assert_eq(code, 0, "bridge H2 idle-stream harness failed:\n{stderr}")
}

// Rust: tests/http_client_law.rs:3866
#Test("h2_bounds_queued_frames_for_another_active_stream") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    closed :: Arc.new(AtomicBool.new(false))
    observed :: closed.clone()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        stream.set_read_timeout(Some(Duration.from_secs(5))).unwrap()
        stream.set_write_timeout(Some(Duration.from_secs(2))).unwrap()
        preface := [U8].repeat(0, 24)
        stream.read_exact(&preface).unwrap()
        assert_eq(preface, b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
        assert_eq(read_h2_frame(&stream).0, 4)
        write_h2_frame(&stream, 4, 0, 0, [])
        first :: loop {
            frame :: read_h2_frame(&stream)
            if frame.0 == 1 { break frame }
        }
        assert_eq(first.2, 1)
        write_h2_frame(&stream, 1, 4, 1, [U8]{0x88})
        second :: loop {
            frame :: read_h2_frame(&stream)
            if frame.0 == 1 { break frame }
        }
        assert_eq(second.2, 3)
        write_h2_frame(&stream, 1, 4, 3, [U8]{0x88})
        chunk :: [U8].repeat(b'x', 64 * 1024)
        send := (payload: [U8]) -> {
            length :: U32{payload.len()}.to_be_bytes()
            head := [U8].repeat(0, 9)
            head[..3].copy_from_slice(length[1..])
            head[3] = 0
            head[4] = 0
            head[5..].copy_from_slice(3u32.to_be_bytes())
            stream.write_all(head).and_then(_ -> stream.write_all(payload)).is_ok()
        }
        loop _ in 0..1024 {
            if !send(chunk) { break }
        }
        stream.set_read_timeout(Some(Duration.from_millis(50))).unwrap()
        deadline :: Instant.now() + Duration.from_millis(500)
        byte := [U8].repeat(0, 1)
        loop {
            if stream.read(&byte) == {
                .Ok(0) -> { observed.store(true, Ordering.Relaxed); break }
                .Ok(_) -> {}
                .Err(error) -> {
                    if error.kind() == ErrorKind.TimedOut || error.kind() == ErrorKind.WouldBlock {
                        if Instant.now() >= deadline { break }
                    } else {
                        observed.store(true, Ordering.Relaxed)
                        break
                    }
                }
            }
            if Instant.now() >= deadline { break }
        }
    })
    src :: """
use jet_http_bridge as bridge
use std.thread
// Rust: tests/http_client_law.rs:3969
fn send(client: I64, url: String) -> bridge.JetHTTPResponseParts bridge.JetHTTPBridgeError! {
    bridge.jet_http_client_send_with_impl(
        client, "GET", url, [], None, None, None, None, None, None, None, None, None, None, None, [], [], []
    )
}
// Rust: tests/http_client_law.rs:3995
fn run() {
    url :: "http://{addr}/h2"
    root :: bridge.jet_http_client_new_impl()
    client :: bridge.jet_http_client_protocols_impl(root, true, false, true).unwrap()
    first :: send(client, url).unwrap()
    assert_eq(first.status, 200)
    second_url :: url.clone()
    second :: thread.spawn(() -> send(client, second_url).unwrap()).join().unwrap()
    assert_eq(second.status, 200)
    error :: bridge.jet_http_client_body_read_impl(first.body_handle, 64 * 1024).unwrap_err()
    assert_eq(error, bridge.JetHTTPBridgeError.InvalidFraming)
    bridge.jet_http_client_body_close_impl(first.body_handle)
    bridge.jet_http_client_body_close_impl(second.body_handle)
    bridge.jet_http_client_drop_impl(client)
    bridge.jet_http_client_drop_impl(root)
}
"""
    (code, _, stderr) :: common.build_and_run("jet_http_client_law", "h2_active_queue", src)
    server.join().unwrap()
    assert(closed.load(Ordering.Relaxed), "active-stream queue flood did not close the peer")
    assert_eq(code, 0, "bridge H2 active-queue harness failed:\n{stderr}")
}
