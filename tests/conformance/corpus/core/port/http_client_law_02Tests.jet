}

// Rust: tests/http_client_law.rs:2847
#Test("http_get_expired_ambient_deadline_fails_closed") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    hits :: Arc.new(AtomicUsize.new(0))
    server_hits :: hits.clone()
    server :: thread.spawn(() -> {
        accepted :: listener.accept()
        if accepted.is_err() { return }
        (stream, _) := accepted.unwrap()
        _ :: stream.set_read_timeout(Some(Duration.from_millis(100))).ok()
        buf := [U8].repeat(0, 1)
        // Only count a real dial that sent at least one request byte.
        if stream.read(&buf).ok().filter(n -> n > 0).is_some() {
            _ :: server_hits.fetch_add(1, Ordering.SeqCst)
            _ :: stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
        }
    })
    src :: """
use core.http.client as http
use core.time as time
fn run() {
    #Context(deadline: time.now()) {
        if http.get("http://{addr}/expired") == {
            .Ok(_) -> print("ok")
            .Err(_) -> print("timeout")
        }
    }
}
"""
    (code, stdout, stderr) :: common.build_and_run("jet_http_client_law", "get_ambient_expired", src)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "timeout\n")
    assert_eq(hits.load(Ordering.SeqCst), 0, "expired ambient must fail before dialing http.get")
    _ :: TcpStream.connect(addr)
    _ :: server.join()
}

