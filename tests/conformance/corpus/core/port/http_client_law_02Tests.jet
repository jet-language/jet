// Rust: tests/http_client_law.rs:3123
#Test("follow_same_origin_credentials_strips_authorization_on_redirect") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    server :: thread.spawn(() -> {
        loop expected_auth in [true, false] {
            (stream, _) := listener.accept().unwrap()
            first :: String.from_utf8_lossy(request_head(&stream)).to_ascii_lowercase()
            assert(first.contains("authorization: bearer secret\r\n"))
            assert(first.starts_with("get /start "))
            stream.write_all(b"HTTP/1.1 302 Found\r\nLocation: /next\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap()
            drop(^stream)
            (next_stream, _) := listener.accept().unwrap()
            second :: String.from_utf8_lossy(request_head(&next_stream)).to_ascii_lowercase()
            assert(second.starts_with("get /next "))
            if expected_auth {
                assert(second.contains("authorization: bearer secret\r\n"), "same_origin_credentials:true must keep Authorization on same-origin hop: {second}")
            } else {
                assert(!second.contains("authorization:"), "same_origin_credentials:false must strip Authorization on same-origin hop: {second}")
            }
            next_stream.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok").unwrap()
        }
    })
    loop (label, keep) in [("keep", true), ("strip", false)] {
        src :: """
use core.http.client as http
fn run() {
    client :: http.Client.new()
        .redirects(.Follow{ max: 2, same_origin_credentials: {keep} })
        .protocols(false, true, false)
    req :: http.request("GET", "http://{addr}/start").header("Authorization", "Bearer secret")
    resp :: client.send(req) ?? panic("send")
    print(resp.body().text(8) ?? panic("body"))
    print(resp.redirect_history().len())
}
"""
        (code, stdout, stderr) :: common.build_and_run("jet_http_client_law", "follow_creds_{label}", src)
        assert_eq(code, 0, "{label} stderr:\n{stderr}")
        assert_eq(stdout, "ok\n1\n", label)
    }
    server.join().unwrap()
}

// Rust: tests/http_client_law.rs:3187
#Test("cross_origin_redirect_strips_request_credentials_and_rejects_proxy_auth") {
    first_listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    second_listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    forbidden_listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    forbidden_listener.set_nonblocking(true).unwrap()
    first_addr :: first_listener.local_addr().unwrap()
    second_addr :: second_listener.local_addr().unwrap()
    forbidden_addr :: forbidden_listener.local_addr().unwrap()
    forbidden :: thread.spawn(() -> {
        deadline :: Instant.now() + Duration.from_secs(1)
        loop {
            if forbidden_listener.accept() == {
                .Ok(_) -> return true
                .Err(error) -> {
                    if error.kind() != ErrorKind.WouldBlock { return false }
                    if Instant.now() >= deadline { return false }
                    thread.yield_now()
                }
            }
        }
    })
    server :: thread.spawn(() -> {
        (first, _) := first_listener.accept().unwrap()
        first_request :: String.from_utf8_lossy(request_head(&first)).to_ascii_lowercase()
        loop header in ["authorization: bearer secret\r\n", "cookie: session=secret\r\n"] {
            assert(first_request.contains(header), "initial request omitted `{header}`: {first_request}")
        }
        assert(!first_request.contains("proxy-authorization:"), "the valid request must not carry raw proxy credentials: {first_request}")
        assert(first_request.starts_with("get /start "))
        first.write_all("HTTP/1.1 302 Found\r\nLocation: http://{second_addr}/next\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".as_bytes()).unwrap()
        drop(^first)
        (second, _) := second_listener.accept().unwrap()
        second_request :: String.from_utf8_lossy(request_head(&second)).to_ascii_lowercase()
        assert(second_request.starts_with("get /next "))
        loop header in ["authorization:", "proxy-authorization:", "cookie:"] {
            assert(!second_request.contains(header), "cross-origin redirect leaked `{header}`: {second_request}")
        }
        second.write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok").unwrap()
    })
    src :: """
use core.http.client as http
fn run() {
    client :: http.Client.new().redirects(.Follow{ max: 2, same_origin_credentials: true }).protocols(false, true, false)
    forbidden :: http.request("GET", "http://{forbidden_addr}/forbidden").header("Proxy-Authorization", "Basic secret")
    if client.send(forbidden) == {
        .Ok(_) -> print("proxy-auth accepted")
        .Err(error) -> {
            if error == .InvalidFraming -> print("proxy-auth rejected")
            else -> print("proxy-auth wrong")
        }
        else -> print("proxy-auth unexpected")
    }
    req :: http.request("GET", "http://{first_addr}/start").header("Authorization", "Bearer secret").header("Cookie", "session=secret")
    resp :: client.send(req) ?? panic("send")
    print(resp.body().text(8) ?? panic("body"))
    print(resp.redirect_history().len())
}
"""
    (code, stdout, stderr) :: common.build_and_run("jet_http_client_law", "cross_origin_creds", src)
    server.join().unwrap()
    assert(!forbidden.join().unwrap(), "raw proxy credentials reached the socket")
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "proxy-auth rejected\nok\n1\n")
}

