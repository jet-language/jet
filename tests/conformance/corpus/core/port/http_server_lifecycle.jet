// Rust: tests/http_server_lifecycle.rs:517
fn read_response(stream: &TcpStream) -> String {
    response := [] as [U8]
    chunk := [0 as U8; 1024]
    loop {
        read :: stream.read(&chunk).expect("response read")
        if read == 0 { break }
        response.extend_from_slice(chunk[..read])
        header_end :: jet_http_header_end(response)
        if header_end == None { next }
        header :: String.from_utf8(response[..header_end!]).expect("response header UTF-8")
        content_length := None as Int?
        loop line in header.split("\r\n") {
            pair :: line.split_once(":")
            if pair == None { next }
            (name, value) :: pair!
            if name.eq_ignore_ascii_case("content-length") {
                trimmed := value.trim() // #4303
                content_length = trimmed.parse<Int>().expect("response Content-Length")
                break
            }
        }
        length :: content_length.expect("response Content-Length")
        if response.len() >= header_end! + 4 + length {
            response.truncate(header_end! + 4 + length)
            break
        }
    }
    String.from_utf8(response).expect("response UTF-8")
}
// Rust: tests/http_server_lifecycle.rs:552
fn request(addr: SocketAddr, text: [U8]) -> String {
    stream := TcpStream.connect(addr).expect("connect")
    stream.write_all(text).expect("request write")
    read_response(&stream)
}
// Rust: tests/http_server_lifecycle.rs:559
fn h2_frame(kind: U8, flags: U8, stream: U32, payload: [U8]) -> [U8] {
    len :: payload.len()
    out := [(len >> 16) as U8, (len >> 8) as U8, len as U8, kind, flags]
    out.extend_from_slice((stream & 0x7fffffff).to_be_bytes())
    out.extend_from_slice(payload)
    out
}
// Rust: tests/http_server_lifecycle.rs:567
fn h2_request_headers(method: U8, path: String) -> [U8] {
    headers := [method, 0x86, 0x04, path.len() as U8]
    headers.extend_from_slice(path.bytes())
    headers.extend_from_slice([0x41, 0x05])
    headers.extend_from_slice("local".bytes())
    headers
}
// Rust: tests/http_server_lifecycle.rs:575
fn h2_literal_header(name_index: U8, value: String) -> [U8] {
    headers := [name_index, value.len() as U8]
    headers.extend_from_slice(value.bytes())
    headers
}
// Rust: tests/http_server_lifecycle.rs:581
fn h2_literal_named_header(name: String, value: String) -> [U8] {
    headers := [0 as U8, name.len() as U8]
    headers.extend_from_slice(name.bytes())
    headers.push(value.len() as U8)
    headers.extend_from_slice(value.bytes())
    headers
}
// Rust: tests/http_server_lifecycle.rs:589
fn h2_connect_headers(authority: String) -> [U8] {
    headers := h2_literal_header(0x02, "CONNECT")
    headers.extend_from_slice(h2_literal_header(0x01, authority))
    headers
}
// Rust: tests/http_server_lifecycle.rs:595
fn h2_read_frame(stream: &TcpStream) -> (U8, U8, U32, [U8]) {
    header := [0 as U8; 9]
    stream.read_exact(&header).unwrap()
    length :: ((header[0] as Int) << 16) | ((header[1] as Int) << 8) | (header[2] as Int)
    payload := [0 as U8; length]
    stream.read_exact(&payload).unwrap()
    (header[3], header[4], U32.from_be_bytes(header[5..9]) & 0x7fffffff, payload)
}
