// Rust: tests/http_server_lifecycle.rs:422
fn framing_probe(raw: [U8]) -> (U8, Int, Int) {
    state := JetHTTPTlsMessageState.new()
    loop end in 0..=raw.len() {
        match state.advance(raw[..end], 32 * 1024, 1024 * 1024) {
            JetHTTPTlsMessageStatus.Pending -> {}
            JetHTTPTlsMessageStatus.Complete(message_end) -> { return (1, message_end, state.inspected()) }
            JetHTTPTlsMessageStatus.Reject -> { return (2, end, state.inspected()) }
        }
    }
    (0, raw.len(), state.inspected())
}
