// Rust: tests/http_server_lifecycle.rs:197
fn jet_runtime_diagnostic(rendered: String) -> Never {
    std.io.stderr().write_all(rendered.bytes())
    std.io.stderr().write_all("\n".bytes())
    std.process.exit(70) // GATE #4494
}
// Rust: tests/http_server_lifecycle.rs:202
fn jet_scheduler_runtime_stop(msg: String) -> Never {
    report :: jet_render_runtime_stop("E3001", "", 0, "", "", 1, 1, msg, "")
    if jet_scheduler_panic_should_unwind() { panic(report.rendered) }
    jet_runtime_diagnostic(report.rendered)
}
// Rust: tests/http_server_lifecycle.rs:216
fn jet_runtime_stop(code: String, file: String, line: U32, msg: String) -> Never {
    report :: jet_render_runtime_stop(code, file, line, "", "", 1, 1, msg, "")
    jet_runtime_diagnostic(report.rendered)
}
// Rust: tests/http_server_lifecycle.rs:222
fn jet_runtime_caught_stop(message: String) -> {
    if message.starts_with("Stop [E") {
        std.io.stderr().write_all(message.bytes())
        if !message.ends_with("\n") { std.io.stderr().write_all("\n".bytes()) }
        return
    }
    report :: jet_render_runtime_stop("E3001", "", 0, "", "", 1, 1, message, "")
    std.io.stderr().write_all(report.rendered.bytes())
}
