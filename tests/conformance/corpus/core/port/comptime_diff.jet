//RS     "use core.text as text\nCOMPTIME_VALUE :: prep { text.upper(\"abc\") }\n\nfn run() {\n    r :: text.upper(\"abc\")\n    print(\"{COMPTIME_VALUE}\")\n    print(\"{r}\")\n}\n",
