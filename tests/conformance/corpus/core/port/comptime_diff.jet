//RS     "use core.text as text\nCOMPTIME_VALUE :: prep { text.pad_start(\"7\", 3, \"0\") }\n\nfn run() {\n    r :: text.pad_start(\"7\", 3, \"0\")\n    print(\"{COMPTIME_VALUE}\")\n    print(\"{r}\")\n}\n",
//RS     // core.math: previously only sqrt/floor/ceil/round/abs/pow/min/max/clamp/
