//RS     rt_b :: rt.read_u8() ?? panic("rt b")
//RS     runtime_value :: "{rt_a}|{rt_b}|{rt.remaining()}"
//RS 
//RS     print("{comptime_value}")
//RS     print("{runtime_value}")
//RS }
//RS "#,
//RS     );
