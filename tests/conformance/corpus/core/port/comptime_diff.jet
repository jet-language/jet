// Rust: tests/comptime_diff.rs:503
fn check_comptime_case(i: USize, expr: String) -> {
    src :: "COMPTIME_VALUE :: prep {{ {expr} }}\n\nfn run() -> {{\n    r :: {expr}\n    print(\"{{COMPTIME_VALUE}}\")\n    print(\"{{r}}\")\n}}\n"
    check_comptime_src(i, expr, src)
}

// Rust: tests/comptime_diff.rs:583
// GATE #4494: scoped native thread with compiler stack headroom.
fn check_comptime_src(i: USize, label: String, src: String) -> {
    (_, user_diags) :: Lexer.lex(src)
    assert(user_diags.is_empty(), "invalid differential fixture: {user_diags.debug()}")
    framed :: framed_comptime_src(src)
    thread.scope(|scope| -> {
        thread.Builder.new().stack_size(64 * 1024 * 1024).spawn_scoped(scope, || -> {
            bundle := Loader.load_source_program(framed, "comptime_diff.jet")
                .unwrap_or_else(|diags| -> panic("case {i} `{label}` failed the front end:\n{render_diagnostics("comptime_diff.jet", framed, diags)}"))
            diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
            assert(diags.is_empty(), "case {i} `{label}` failed the front end:\n{render_diagnostics("comptime_diff.jet", framed, diags)}")
        }).expect("spawn comptime differential compiler").join().expect("comptime differential compiler panicked")
    })
    // Retired generated-Rust inspection is replaced by the canonical native build/run boundary.
    (code, stdout, stderr) :: common.build_and_run("jet_ctdiff", "case_{i}", framed)
    assert(code == 0, "case `{label}` failed compilation or panicked at runtime:\n{stderr}")
    assert_parity_output(label, stdout.bytes())
}

// Rust: tests/comptime_diff.rs:677
fn framed_comptime_src(src: String) -> String {
    lines := src.lines().map(|line| -> line.to_string()).to_list()
    second :: lines.iter().rposition(|line| -> line.trim_start().starts_with("print(")).expect("comptime differential source needs a runtime print")
    first :: lines[..second].iter().rposition(|line| -> line.trim_start().starts_with("print(")).expect("comptime differential source needs a comptime print")
    comptime :: print_argument(lines[first])
    runtime :: print_argument(lines[second])
    // #4303: trim views are materialized before String operations.
    trimmed := lines[first].trim_start()
    indent :: lines[first][..lines[first].len() - trimmed.len()].to_string()
    lines[first] = "{indent}__comptime_diff_frame({comptime}, {runtime})"
    lines[second] = ""
    framed := "use core.encoding.hex as __comptime_diff_hex\n{lines.join("\n")}"
    &framed.push_str("\n\nfn __comptime_diff_frame(expected_text: String, actual_text: String) -> {{\n    print(\"{{__comptime_diff_hex.encode(expected_text.bytes())}}\")\n    print(\"{{__comptime_diff_hex.encode(actual_text.bytes())}}\")\n}}\n")
    framed
}

// Rust: tests/comptime_diff.rs:705
fn print_argument(line: String) -> String {
    trimmed := line.trim() // #4303
    trimmed.strip_prefix("print(").and_then(|value| -> value.strip_suffix(")"))
        .expect("comptime differential parity print must occupy one complete line").to_string()
}

// Rust: tests/comptime_diff.rs:712
fn assert_parity_output(label: String, stdout: [U8]) -> {
    (comptime, runtime) :: parse_parity_output(stdout).unwrap_or_else(|reason| -> panic("case `{label}` emitted an invalid parity frame: {reason}"))
    assert_eq(comptime, runtime, "DIVERGENCE for `{label}`: comptime gave {String.from_utf8_lossy(comptime).debug()}, runtime gave {String.from_utf8_lossy(runtime).debug()} — this is a P0 miscompile")
}

// Rust: tests/comptime_diff.rs:726
fn parse_parity_output(stdout: [U8]) -> ([U8], [U8]) Err! {
    if stdout.is_empty() || stdout[stdout.len() - 1] != 10 { return .Err("frame has no final newline") }
    framed :: stdout[..stdout.len() - 1]
    lines := framed.split(|byte| -> byte == 10)
    comptime :: lines.next().unwrap()
    runtime :: lines.next() ?? return .Err("frame has no runtime value")
    if lines.next().is_some() { return .Err("frame has trailing lines") }
    .Ok((decode_parity_hex(comptime, "comptime")?, decode_parity_hex(runtime, "runtime")?))
}

// Rust: tests/comptime_diff.rs:744
fn decode_parity_hex(encoded: [U8], label: String) -> [U8] Err! {
    if encoded.len() % 2 != 0 { return .Err("{label} hex has odd length") }
    decoded := [U8].with_capacity(encoded.len() / 2)
    loop pair in encoded.chunks_exact(2) {
        high :: hex_nibble(pair[0]) ?? return .Err("{label} hex is invalid")
        low :: hex_nibble(pair[1]) ?? return .Err("{label} hex is invalid")
        &decoded.push(high << 4 | low)
    }
    .Ok(decoded)
}

// Rust: tests/comptime_diff.rs:758
fn hex_nibble(byte: U8) -> U8? {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10 }
    none
}

// Rust: tests/comptime_diff.rs:767
fn test_parity_frame(comptime: [U8], runtime: [U8]) -> [U8] {
    frame := [U8].with_capacity((comptime.len() + runtime.len()) * 2 + 2)
    digits :: "0123456789abcdef".bytes()
    loop value in [comptime, runtime] {
        loop byte in value {
            &frame.push(digits[(byte >> 4).to_usize()])
            &frame.push(digits[(byte & 15).to_usize()])
        }
        &frame.push(10)
    }
    frame
}

// Rust: tests/comptime_diff.rs:1187
// GATE #4494: canonical native compiler/process boundary, not a Rust bridge.
fn compile_and_run(src: String) -> String {
    (code, stdout, stderr) :: common.build_and_run("jet_ct_fixture", "fixture", src)
    assert(code == 0, "fixture failed compilation or panicked at runtime:\n{stderr}")
    stdout
}
