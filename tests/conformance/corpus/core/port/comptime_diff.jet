// PORT-PENDING 1007 tests-comptime-diff: tests/comptime_diff.rs:1-1221
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! M9.5 differential battery (permanent CI). For each expression, the same
//RS //! code is evaluated twice — once as `COMPTIME_VALUE :: e;` (the sema
//RS //! tree-walking interpreter) and once as a runtime `r :: e` (generated
//RS //! Rust). The program prints both; the two lines MUST be byte-identical.
//RS //!
//RS //! Divergence is a P0 miscompile-class bug (S26 rule 6: comptime implements
//RS //! runtime semantics exactly — exact Int, IEEE f64 Float with S21 display,
//RS //! char-counted Strings (S41), BTreeMap ordering (S38)).
//RS 
//RS use std::fs;
//RS use std::process::Command;
//RS use std::sync::atomic::{AtomicUsize, Ordering};
//RS use std::sync::{Arc, Mutex};
//RS 
//RS mod common;
//RS use common::{have_rustc, panic_message, test_worker_count, unsafe_keyword_columns};
//RS 
//RS /// Expressions whose comptime and runtime evaluation must agree. Each is
//RS /// inlined verbatim on both sides, so it must be a self-contained
//RS /// expression with an inferable type.
//RS const CASES: &[&str] = &[
//RS     // Int arithmetic + operator semantics
//RS     "2 + 3 * 4",
//RS     "100 / 7",
//RS     "100 % 7",
//RS     "7 / 2",
//RS     "(0 - 17) % 5",
//RS     "(0 - 17) / 5",
//RS     "1 << 10",
//RS     "255 & 15",
//RS     // D-BITOREXPR1=A: value-position `|` is bitwise OR; `|=` remains covered
//RS     // by tests/numops.rs.
//RS     "12 | 10",
//RS     "6 ^ 3",
//RS     "1000000 * 1000000",
//RS     // Float rounding + S21 "always a decimal" display
//RS     "Float{3.0} / Float{2.0}",
//RS     "Float{10.0} / Float{4.0}",
//RS     "Float{1.0} / Float{3.0}",
//RS     "Float{5.0}",
//RS     "Float{2.0} * Float{2.0}",
//RS     "Float{0.1} + Float{0.2}",
//RS     // Bool / comparison
//RS     "3 < 5 && 2 == 2",
//RS     "10 >= 10 || false",
//RS     // String + Char ops (char-counted, S41)
//RS     "\"Hello\".to_upper()",
//RS     "\"WORLD\".to_lower()",
//RS     "\"héllo\".len()",
//RS     "\"  trim me  \".trim()",
//RS     "\"  trim me  \".trim_start()",
//RS     "\"  trim me  \".trim_end()",
//RS     "\"jet\".pad_start(5, \".\")",
//RS     "\"jet\".pad_end(5, \".\")",
//RS     "\"hello jet\".index_of(\"jet\")",
//RS     "\"banana\".count(\"an\")",
//RS     "\"Hello\".is_alphabetic()",
//RS     "\"123\".is_numeric()",
//RS     "\" \t\".is_whitespace()",
//RS     "\"jet lang\".is_ascii()",
//RS     "\"hELLO jet\".to_title()",
//RS     "(\"left:right\".split_once(\":\") ?? panic(\"split\")).before",
//RS     "\"ab\".repeat(3)",
//RS     "\"a,b,c\".split(\",\").to_list()",
//RS     "\"hello world\".replace(\"o\", \"0\")",
//RS     // List values, ordering, and methods
//RS     "[1, 2, 3]",
//RS     "[3, 1, 2]",
//RS     "[10, 20, 30][1]",
//RS     "[\"x\", \"y\", \"z\"]",
//RS     "loop value in [1, 2, 3] -> value * 2",
//RS     // Map ordering via derived lists (BTreeMap is sorted by key). `.keys()`/
//RS     // `.values()` return a lazy one-pass `Iter` (no `Display`, E0915) —
//RS     // `.to_list()` materializes it for the differential's string print.
//RS     "[\"b\": 2, \"a\": 1, \"c\": 3].keys().to_list()",
//RS     "[\"b\": 2, \"a\": 1, \"c\": 3].values().to_list()",
//RS     "\"a,b,c\".split(\",\").skip(1).first()",
//RS     "[2: \"two\", 1: \"one\"].keys().to_list()",
//RS     "Rank.from([1, 2, 3]).intersection(Rank.from([2, 3, 4])).to_list()",
//RS     "Rank.from([1, 2, 3]).difference(Rank.from([2, 3, 4])).to_list()",
//RS     "Rank.from([1, 2, 3]).symmetric_difference(Rank.from([2, 3, 4])).to_list()",
//RS     "Rank.from([1, 2]).is_subset(Rank.from([1, 2, 3]))",
//RS     "Rank.from([1, 2, 3]).is_superset(Rank.from([1, 2]))",
//RS     "Rank.from([1, 2]).is_disjoint(Rank.from([3, 4]))",
//RS     "Set.from([1, 2, 3]).intersection(Set.from([2, 3, 4])).len()",
//RS     "Set.from([1, 2, 3]).difference(Set.from([2, 3, 4])).len()",
//RS     "Set.from([1, 2, 3]).symmetric_difference(Set.from([2, 3, 4])).len()",
//RS     "Set.from([1, 2]).is_subset(Set.from([1, 2, 3]))",
//RS     "Set.from([1, 2, 3]).is_superset(Set.from([1, 2]))",
//RS     "Set.from([1, 2]).is_disjoint(Set.from([3, 4]))",
//RS     // D-INTBIG1: exact default Int keeps the machine-word path for small
//RS     // values and spills only when a result needs more than the resident word.
//RS     "(9223372036854775807 + 1).to_string()",
//RS     "(999999999999999999999999999999 + 999999999999999999999999999999).to_string()",
//RS     "(100 - 1).to_string()",
//RS     "(7 * 6).to_string()",
//RS     "(2 ^ 200).to_string()",
//RS     "(0 - 3).to_string()",
//RS ];
//RS 
//RS const F32_VALUE_FLOW: &str = r#"
//RS fn pass_f32(value: F32) -> F32 {
//RS     return value
//RS }
//RS 
//RS fn apply_f32(transform: fn(F32) -> F32, value: F32) -> F32 {
//RS     return transform(value)
//RS }
//RS 
//RS fn f32_value_flow() -> String {
//RS     literal :: F32{ 16777217.0 }
//RS     one :: F32{ 1.0 }
//RS     two :: F32{ 2.0 }
//RS     three :: F32{ 3.0 }
//RS     threshold :: F32{ 16777215.0 }
//RS     immutable :: F32{ literal + one }
//RS     mutable := F32{ literal }
//RS     mutable += one
//RS     mutable -= two
//RS     mutable *= three
//RS     mutable /= two
//RS     transform :: (value: F32) -> value + one
//RS     same :: pass_f32(literal)
//RS     wide :: Float.from_f32(literal)
//RS     narrowed :: F32.from_float(wide) ?? one
//RS     nested :: [["values": [literal, apply_f32(transform, literal), narrowed]]]
//RS     option_left :: [[[literal].get(0)]]
//RS     option_right :: [[[same].get(0)]]
//RS     result_left :: [[F32.from_float(wide)]]
//RS     result_right :: [[F32.from_float(Float.from_f32(same))]]
//RS     negative :: F32{ -literal }
//RS     difference :: F32{ literal - one }
//RS     product :: F32{ literal * two }
//RS     quotient :: F32{ literal / two }
//RS     return "{literal}|{immutable}|{mutable}|{negative}|{difference}|{product}|{quotient}|{literal == same}|{literal > threshold}|{nested[0]["values"]}|{option_left == option_right}|{result_left == result_right}"
//RS }
//RS 
//RS EXPECTED :: prep { f32_value_flow() }
//RS 
//RS fn run() {
//RS     actual :: f32_value_flow()
//RS     print("{EXPECTED}")
//RS     print("{actual}")
//RS }
//RS "#;
//RS 
//RS /// card #392: the `use core.X as alias; alias.method(...)` module-call form
//RS /// needs its own program per case (an inline expression alone can't `use`),
//RS /// so it gets a dedicated differential loop rather than reusing `CASES`.
