// Rust: tests/http_client_law.rs:598
#Test("vendored_public_suffix_snapshot_is_compact_and_keeps_rule_kinds") {
    data :: fs.read_to_string("crates/jet-pkg-model/src/Prelude/public_suffix_list.dat").unwrap()
    assert_eq(data.len(), 144039)
    assert_eq(data.lines().count(), 1)
    assert(data.is_ascii())
    rules :: data.split_whitespace().collect::<std.collections.HashSet<String>>()
    loop required in ["com", "co.uk", "*.ck", "!www.ck", "github.io", "xn--55qx5d.cn"] {
