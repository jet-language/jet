    mux :: server.mux()
    result :: server.serve("127.0.0.1:999999", mux, tls: server.tls("not a cert", "not a key"))
    if result == {
        Ok(_) -> { print("unexpected") }
        Err(e) -> { print(e) }
    }
}
`
    (code, stdout, stderr) :: common.build_and_run("jet_http_server_tls", "bad_cert", src)
    assert_eq(code, 0, "{stderr}")
    assert(stdout.contains("TLS certificate PEM did not contain a certificate"), "bad cert should stay Jet-voiced:\nstdout={stdout}\nstderr={stderr}")
}
// Rust: tests/http_server_tls.rs:74
#Test("server_tls_requires_named_tls_option") {
    src :: `use core.http.server as server
fn run() -> {
    mux :: server.mux()
    _ :: server.serve("127.0.0.1:0", mux, server.tls("cert", "key"))
}
`
    err :: compile(src).expect_err("unlabeled third server argument should be rejected")
    rendered :: render_diagnostics("tests/http_server_tls/bad_label.jet", src, err)
    assert(rendered.contains("Error [E0125]"), "{rendered}")
    assert(rendered.contains("`serve` needs `tls:` before the third argument"), "{rendered}")
}
