// Rust: tests/int_division.rs:64
#Test("storing_a_quotient_in_a_whole_number_points_at_floor_division") {
    dir :: std.env.temp_dir().join("jet_intdiv_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    loop src in [
        "fn run() -> {\n    n := 7\n    n /= 2\n    print(n)\n}\n",
        "fn run() -> {\n    n := 7\n    n = n / 2\n    print(n)\n}\n",
        "struct Boxed { value: Int }\nfn run() -> {\n    item :: Boxed{ value: 7 / 2 }\n}\n"
    ] {
        path :: dir.join("intdiv_compound.jet")
        fs.write(path, src).unwrap()
        shown :: path.to_string_lossy()
        diags :: compile_with_path(src, shown).err().unwrap_or_default()
        rendered :: render_diagnostics(shown, src, diags)
        assert(diags.iter().any(d -> { d.code == "E0108" }), "expected a type error for a quotient stored in a whole number:\n{rendered}")
        assert(rendered.contains("Use `/%` to divide and round down"), "the fix must name floor division:\n{rendered}")
    }
}
