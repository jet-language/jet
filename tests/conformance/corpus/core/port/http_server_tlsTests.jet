// Rust: tests/int_division.rs:234
#Test("exact_int_overflow_edges_agree_on_every_tier") {
    src :: SEED + `
fn run() -> {
    max :: score(9223372036854775807)
    top :: score(4611686018427387903)
    bottom :: score(-4611686018427387904)
    print(max + score(1))
    print(top + score(1))
    print(bottom - score(1))
    print((top + score(1)) - score(1))
    print(-bottom)
    print(top * score(2))
    print(bottom * score(-1))
    print(score(3037000499) * score(3037000499))
    print(score(3037000500) * score(3037000500))
    print(bottom /% score(-1))
    print(bottom %% score(-1))
    print(score(7) /% score(2))
    print(score(-7) /% score(2))
    print(score(7) /% score(-2))
    print(score(-7) /% score(-2))
    print(score(7) % score(2))
    print(score(-7) % score(2))
    print(score(7) % score(-2))
    print(score(-7) % score(-2))
    print(score(7) %% score(2))
    print(score(-7) %% score(2))
    print(score(7) %% score(-2))
    print(score(-7) %% score(-2))
    print(score(-6) % score(3))
    print(score(-6) /% score(4))
    print(bottom /% score(3))
    print(bottom % score(3))
    print((max + score(1)) /% score(-3))
    print((max + score(1)) % score(-3))
    print(score(1) << score(61))
    print(score(1) << score(62))
    print(score(-1) << score(62))
    print(score(3) << score(100))
    print(score(-7) >> score(1))
    print(score(-1) >> score(200))
    print(score(7) >> score(200))
    print(score(-12) & score(13))
    print(score(-12) | score(10))
    print(score(-12) ~| score(13))
    print(bottom ~| score(-1))
    print(score(-7) < score(2))
    print(bottom < top)
    print((max + score(1)) > top)
}
`
    assert_tiers_agree("exact_int_edges", src, "9223372036854775808\n4611686018427387904\n-4611686018427387905\n4611686018427387903\n4611686018427387904\n9223372036854775806\n4611686018427387904\n9223372030926249001\n9223372037000250000\n4611686018427387904\n0\n3\n-4\n-4\n3\n1\n1\n-1\n-1\n1\n-1\n1\n-1\n0\n-2\n-1537228672809129302\n2\n-3074457345618258603\n-1\n2305843009213693952\n4611686018427387904\n-4611686018427387904\n3802951800684688204490109616128\n-4\n-1\n0\n4\n-2\n-7\n4611686018427387903\ntrue\ntrue\ntrue\n")
}
// Rust: tests/int_division.rs:343
#Test("exact_int_inline_loop_allocations_do_not_scale") {
    if !have_rustc() { return }
    src :: `#CLI struct Args { rounds: Int }
fn churn(rounds: Int) -> Int {
    total := 0
    loop i in 0..<rounds {
        total = (total * 31 + i * 7 - 3) % 1000003
        total += (i /% 3) %% 5
    }
    total
}
fn run(args: Args) -> { print(churn(args.rounds) >= 0) }
`
    scratch :: common.Scratch.new("exact_int_allocations")
    dir :: scratch.path
    tir_support.write_test_package(dir, tir_support.TIR_TEST_PACKAGE)
    jet_path :: dir.join("churn.jet")
    fs.write(jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy()
    rust :: compile_with_path(src, shown).unwrap_or_else(diags -> { panic("front end rejected:\n{render_diagnostics(shown, src, diags)}") }).rust
    assert(!rust.contains("#[global_allocator]"), "the default AOT program must keep the hidden system heap")
    assert_eq(rust.matches("\nfn main() {\n").count(), 1, "emitted AOT program must have one entry to wrap")
    // Rust peer fixture text remains Rust; this is not a production bridge.
    counted :: rust.replacen("\nfn main() {\n", "\nfn __jet_emitted_main() {\n", 1) + `
struct JetAllocationCounter;
static JET_ALLOCATIONS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
unsafe impl std::alloc::GlobalAlloc for JetAllocationCounter {
    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
        JET_ALLOCATIONS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
        unsafe { std::alloc::GlobalAlloc::alloc(&std::alloc::System, layout) }
    }
    unsafe fn dealloc(&self, ptr: *mut u8, layout: std::alloc::Layout) {
        unsafe { std::alloc::GlobalAlloc::dealloc(&std::alloc::System, ptr, layout) }
    }
}
#[global_allocator]
static JET_ALLOCATION_COUNTER: JetAllocationCounter = JetAllocationCounter;
fn main() {
    __jet_emitted_main();
    eprintln!("jet-allocations={}", JET_ALLOCATIONS.load(std::sync::atomic::Ordering::Relaxed));
}
`
    rs :: dir.join("churn.rs")
    bin :: dir.join("churn")
    fs.write(rs, counted).unwrap()
    rustc :: Command.new("rustc").args(["--edition", "2021", "--crate-name", "churn"]).args([rs.to_str().unwrap(), "-o", bin.to_str().unwrap()]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected the counted AOT program:\n{String.from_utf8_lossy(rustc.stderr)}")
    allocations :: (rounds: String) -> {
        run :: Command.new(bin).arg(rounds).output().unwrap()
        stderr :: String.from_utf8_lossy(run.stderr)
        assert(run.status.success(), "{rounds} rounds failed: {stderr}")
        assert_eq(String.from_utf8_lossy(run.stdout), "true\n", "{rounds} rounds")
        text :: stderr.lines().find_map(line -> { line.strip_prefix("jet-allocations=") }).unwrap_or_else(() -> { panic("no allocation count in: {stderr}") })
        text.parse<Int>().unwrap()
    }
    small :: allocations("1000")
    large :: allocations("100000")
    assert(large <= small + 64, "exact-Int loop allocations scale with iterations: {small} at 1e3 vs {large} at 1e5")
}
// Rust: tests/jit_shared_ownership.rs:126
#Test("resident_jit_preserves_shared_and_closure_owner_topology") {
    // Retired Cranelift/resident trace assertions cut over to canonical O0/O1/O2/Web behavior.
    dir :: common.unique_tmp("jit_shared_ownership")
    fs.create_dir_all(dir).expect("create scratch fixture directory")
    file :: dir.join("shared_ownership.jet")
    fs.write(file, SOURCE).expect("write Shared ownership fixture")
    shown :: file.to_string_lossy()
    bundle := Loader.load_entry(shown).expect("load Shared ownership fixture")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all(d -> { d.severity != Diagnostics.Severity.Error }), "Shared ownership fixture diagnostics: {diagnostics}")
    stdout :: match Interpreter.dev_iteration(shown, false, false) {
        Interpreter.RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "O0 shared ownership stderr: {stderr}")
            assert(stderr.is_empty(), "O0 shared ownership stderr: {stderr}")
            stdout
        }
        Interpreter.RunOutcome.Problems(diagnostics) -> { panic("Shared ownership fixture failed: {diagnostics}") }
    }
    expected :: "1\n2\n2\n1\n1\n7\n8\ntrue\n8\n102\n202\n302\n2\n1\n1\n13\n1\ntrue\n11\n1\ntrue\ntrue\ntrue\n"
    assert_eq(stdout, expected)
    assert_tiers_agree("shared_closure_owner_topology", SOURCE, expected)
    fs.remove_dir_all(dir).expect("remove scratch fixture directory")
}
