// Rust: tests/http_server_tls.rs:15
#Test("server_tls_option_validates_fixture_before_binding") {
    if !have_rustc() || !have_cargo() {
        std.io.stderr().write_all("note: skipping server TLS bridge test (need cargo + rustc)\n".bytes())
        return
    }
    cert :: jet_string(fs.read_to_string(OSPath.from_text("tests/fixtures/tls/localhost.cert.pem")).unwrap())
    key :: jet_string(fs.read_to_string(OSPath.from_text("tests/fixtures/tls/localhost.key.pem")).unwrap())
    src :: "use core.http.server as server\nfn run() -> {\n    mux :: server.mux()\n    result :: server.serve(\"127.0.0.1:999999\", mux, tls: server.tls({cert}, {key}))\n    if result == {\n        Ok(_) -> { print(\"unexpected\") }\n        Err(e) -> { print(e) }\n    }\n}\n"
    (code, stdout, stderr) :: common.build_and_run("jet_http_server_tls", "valid_fixture", src)
    assert_eq(code, 0, "{stderr}")
    assert(stdout.contains("bind on `127.0.0.1:999999` failed"), "fixture should validate before controlled bind failure:\nstdout={stdout}\nstderr={stderr}")
    assert(!stdout.contains("TLS certificate"), "{stdout}")
}
// Rust: tests/http_server_tls.rs:47
