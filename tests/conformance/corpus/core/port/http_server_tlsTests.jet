// Rust: tests/int_division.rs:141
#Test("fixed_width_divide_by_zero_traps_with_prelude_wording") {
    if !have_rustc() { return }
    loop (name, src) in [
        ("u8_div_zero", `fn run() -> {
    a :: U8{10}
    zero :: U8{0}
    print(a / zero)
}
`),
        ("i8_div_zero", `fn run() -> {
    a :: I8{10}
    zero :: I8{0}
    print(a / zero)
}
`),
        ("u8_param_div_zero", `fn div(a: U8, zero: U8) -> { print(a / zero) }
fn run() -> { div(U8{10}, U8{0}) }
`),
        ("u8_call_div_zero", `fn score(n: U8) -> U8 { return n }
fn run() -> { print(score(U8{10}) / score(U8{0})) }
`)
    ] {
        (code, out, err) :: build_and_run_full("jet_intdiv", name, src)
        assert_eq(code, 70, "{name}: fixed-width / by zero must exit 70, got {code}; out={out} err={err}")
        assert(err.contains("E3010") && err.contains("divided by zero"), "{name}: expected Prelude division wording, got: {err}")
        assert(!err.contains("attempt to divide by zero"), "{name}: raw Rust panic leaked (I2): {err}")
        // Retired resident-JIT representation probe becomes the canonical O0 path.
        (run_code, run_out, run_err) :: tir_support.run_default("{name}_o0", src)
        assert_eq(run_code, 70, "{name}: jet run must exit 70 (I9), got {run_code}: {run_out}{run_err}")
        assert(run_err.contains("Stop [E3010]: `divided by zero`"), "{name}: jet run expected the E3010 Prelude stop, got: {run_err}")
        assert(!run_err.contains("E0953") && !run_err.contains("attempt to divide by zero"), "{name}: jet run must not use E0953 or raw Rust panic: {run_err}")
    }
}
