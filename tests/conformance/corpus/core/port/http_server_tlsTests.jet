// Rust: tests/int_division.rs:16
#Test("int_division_answers_the_true_quotient") {
    if !have_rustc() { return }
    src :: "{SEED}\nfn run() -> {\n    print(score(7) / score(2))\n    print(score(6) / score(2))\n    print(score(-7) / score(2))\n    print(score(1) / score(4))\n}\n"
