// Rust: tests/deadline_and_crypto_text_single_home.rs:27
fn collect_rs_files(dir: OSPath, out: &[OSPath]) -> {
    entries :: fs.read_dir(dir) ?? return
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { collect_rs_files(path, out) }
        else if path.extension().is_some_and(extension -> extension == "rs") { out.push(path) }
    }
}
// Rust: tests/dom_runtime_parity.rs:14
fn rust_backend_stage_order(ui_rs: String) -> [String] {
    start :: ui_rs.find("pub trait JetBackend").expect("Ui.rs must declare pub trait JetBackend")
    body_start :: ui_rs.slice(start).find('{').expect("trait body") + start
    body_end :: ui_rs.slice(body_start).find('}').expect("trait body end") + body_start
    stages := [String]{}
    rest := ui_rs.slice(body_start, body_end)
    loop rest.find("fn ") == .Val(fn_at) {
        rest = rest.slice(fn_at + 3)
        stages.push(rest.chars().take_while(c -> c.is_alphanumeric() || c == '_').collect<String>())
    }
    stages
}
// Rust: tests/dom_runtime_parity.rs:37
fn js_export_name(rust_stage: String) -> String { if rust_stage == "on_event" -> "onEvent" else -> rust_stage }
// Rust: tests/dom_runtime_parity.rs:45
fn js_export_order(js: String) -> [String] {
    js.lines().filter_map(line -> {
        trimmed := line.trim_start() // #4303
        rest :: trimmed.strip_prefix("export function ") ?? return None
        Val(rest.chars().take_while(c -> c.is_alphanumeric() || c == '_').collect<String>())
    }).collect()
}
// Rust: tests/dom_runtime_parity.rs:106
fn number_after(source: String, needle: String) -> Float {
    at :: source.find(needle).unwrap_or_else(() -> panic("expected {needle} in source"))
    rest :: source.slice(at + needle.len())
    digits :: rest.chars().take_while(c -> c.is_ascii_digit() || c == '.').collect<String>()
    digits.parse<Float>().unwrap_or_else(error -> panic("parse number after {needle}: {error} ({digits})"))
}
// Rust: tests/encoding_corpus.rs:11
fn fixtures_encoding() -> OSPath { root().join("tests/fixtures/encoding") }
// Rust: tests/encoding_corpus.rs:15
fn sha256_hex(bytes: [U8]) -> String { SHA256.sha256_hex(bytes) }
// Rust: tests/encoding_corpus.rs:19
fn verify_manifest(root: OSPath) -> USize {
    manifest :: fs.read_to_string(root.join("MANIFEST.tsv")).unwrap_or_else(error -> panic("missing MANIFEST.tsv under {root.display()}"))
    count := 0
    loop line in manifest.lines().filter(line -> !line.starts_with('#') && !line.is_empty()) {
        fields :: line.split('\t').collect()
        assert(fields.len() >= 4, "bad manifest row in {root.display()}: {line}")
        bytes :: fs.read(root.join(fields[0])).unwrap_or_else(error -> panic("manifest file missing: {root.display()}/{fields[0]}"))
        assert_eq(sha256_hex(bytes), fields[1], "hash drift in {root.display()}: {fields[0]}")
        assert(fields[2].starts_with("https://") || fields[2] == "local", "bad source URL in {root.display()}: {fields[2]}")
        assert(!fields[3].is_empty(), "missing license in {root.display()}")
        count += 1
    }
    count
}
// Rust: tests/encoding_corpus.rs:58
fn jet_string_literal(text: String) -> String {
    out := "\""
    loop ch in text.chars() {
        if ch == {
            '\\' -> out.push_str("\\\\")
            '"' -> out.push_str("\\\"")
            '\n' -> out.push_str("\\n")
            '{' -> out.push_str("{{{{")
            '}' -> out.push_str("}}}}")
            else -> out.push(ch)
        }
    }
    out.push('"')
    out
}
// Rust: tests/encoding_corpus.rs:74
fn jet_json_literal(json: String) -> String {
    if json.starts_with('{') && json.ends_with('}') {
        escaped :: json.slice(1, json.len() - 1).replace("\\", "\\\\").replace("\"", "\\\"")
        out := "\"{{{{"
        out.push_str(escaped)
        out.push_str("}}}}\"")
        out
    } else { jet_string_literal(json) }
}
