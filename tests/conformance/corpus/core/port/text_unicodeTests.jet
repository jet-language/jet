use std.path.Path
use std.process.Command
use jet
// GATE #4494: real native process and file operations, canonical execution-tier provider.

// Rust: tests/text_unicode.rs:66
#Test("pinned_unicode_tables_regenerate_byte_identically") {
    root :: Path.new(env("CARGO_MANIFEST_DIR"))
    checksums :: Command.new("sha256sum").args(["--check", "SHA256SUMS"]).current_dir(root.join("tests/data/unicode")).output().expect("verify vendored Unicode inputs")
    assert(checksums.status.success(), "vendored Unicode checksum mismatch:\n{String.from_utf8_lossy(checksums.stdout)}{String.from_utf8_lossy(checksums.stderr)}")
    output :: Command.new("node").args(["Tools/agent/gen-unicode-tables.mjs", "--check", "tests/data/unicode/ucd"]).current_dir(root).output().expect("run pinned Unicode generator")
    assert(output.status.success(), "pinned Unicode tables do not regenerate byte-identically:\n{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}")
}

// Rust: tests/text_unicode.rs:97
#Test("generated_rust_emits_only_the_unicode_tier_the_program_needs") {
    // Retired emitted-Rust table census is replaced by the same two programs' behavior
    // on O0/O1/O2/Web; no Rust prelude representation is part of the Jet contract.
    for (name, source, expected) in [
        ("hello", `fn run() { print("hello") }`, "hello\n"),
        ("text", `use core.text as text
fn run() { print(text.nfc("é")) }`, "é\n")
    ] {
        scratch :: common.Scratch.new("unicode_tier_{name}")
        tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
        entry :: scratch.join("main.jet")
        fs.write(entry, source).unwrap()
        bundle :: jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
        for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
            result :: common.execute_bundle(bundle, tier).expect("Unicode tier program executes")
            assert_eq(result.exit_code, 0, "Unicode {name} tier {tier:?}: {result.stderr}")
            assert_eq(result.stdout, expected)
            assert_eq(result.stderr, "")
        }
    }
}

// Rust: tests/text_unicode.rs:152
#Test("aot_prelude_passes_full_unicode_corpora") {
    // The full corpus obligations now execute canonical core.text, not a Rust prelude extraction.
    root :: Path.new(env("CARGO_MANIFEST_DIR"))
    root_text :: root.to_string_lossy().replace('\\', "\\\\")
    source :: `
use core.text as text

// Rust: tests/text_unicode.rs:169 (corpus harness)
fn cps(field: String) -> String {
    field.split_whitespace().filter_map(hex -> U32.from_str_radix(hex, 16).ok()).filter_map(Char.from_u32).collect()
}
// Rust: tests/text_unicode.rs:176 (corpus harness)
fn parse_break(line: String) -> (String, [String])? {
    full := ""
    segments: [String] := []
    current := ""
    any := false
    for token in line.split_whitespace() {
        match token {
            "÷" -> { if !current.is_empty() { segments.push(^current); current = "" } }
            "×" -> {}
            hex -> {
                ch :: Char.from_u32(U32.from_str_radix(hex, 16).ok()?)?
                full.push(ch)
                current.push(ch)
                any = true
            }
        }
    }
    if !current.is_empty() { segments.push(^current) }
    if any { Val((^full, ^segments)) } else { None }
}
// Rust: tests/text_unicode.rs:197 (corpus harness)
fn check_break(corpus: String, segment: (String) -> [String]) -> USize {
    checked := 0
    for raw in corpus.lines() {
        line := raw.split('#').next().unwrap_or("").trim() // #4303
        parsed :: parse_break(line)
        if parsed.is_none() { continue }
        (full, expected) :: parsed.unwrap()
        assert_eq(segment(full), expected, "break mismatch: {raw}")
        checked += 1
    }
    checked
}
// Rust: tests/text_unicode.rs:208 (corpus harness entry)
fn run() -> {
    normalization :: include_str("__ROOT__/tests/data/unicode/NormalizationTest.txt")
    normalization_lines := 0
    for raw in normalization.lines() {
        line := raw.split('#').next().unwrap_or("").trim() // #4303
        if line.is_empty() || line.starts_with('@') { continue }
        fields :: line.split(';').collect::<[String]>()
        if fields.len() < 5 { continue }
        c1 :: cps(fields[0]); c2 :: cps(fields[1]); c3 :: cps(fields[2])
        c4 :: cps(fields[3]); c5 :: cps(fields[4])
        for input in [c1, c2, c3] {
            assert_eq(text.nfc(input), c2)
            assert_eq(text.nfd(input), c3)
        }
        for input in [c4, c5] {
            assert_eq(text.nfc(input), c4)
            assert_eq(text.nfd(input), c5)
        }
        for input in [c1, c2, c3, c4, c5] {
            assert_eq(text.nfkc(input), c4)
            assert_eq(text.nfkd(input), c5)
        }
        normalization_lines += 1
    }
    folding :: include_str("__ROOT__/tests/data/unicode/ucd/CaseFolding.txt")
    fold_lines := 0
    for raw in folding.lines() {
        line := raw.split('#').next().unwrap_or("").trim() // #4303
        if line.is_empty() { continue }
        fields :: line.split(';').map(field -> field.trim()).collect::<[String]>()
        if fields.len() < 3 || (fields[1] != "C" && fields[1] != "F") { continue }
        assert_eq(text.casefold(cps(fields[0])), cps(fields[2]), "fold mismatch: {raw}")
        fold_lines += 1
    }
    lower: [U32:String] := [:]
    upper: [U32:String] := [:]
    for raw in include_str("__ROOT__/tests/data/unicode/ucd/UnicodeData.txt").lines() {
        fields :: raw.split(';').collect::<[String]>()
        if fields.len() < 14 { continue }
        cp :: U32.from_str_radix(fields[0], 16).unwrap()
        if !fields[12].is_empty() { _ :: upper.insert(cp, cps(fields[12])) }
        if !fields[13].is_empty() { _ :: lower.insert(cp, cps(fields[13])) }
    }
    for raw in include_str("__ROOT__/tests/data/unicode/ucd/SpecialCasing.txt").lines() {
        line := raw.split('#').next().unwrap_or("").trim() // #4303
        if line.is_empty() { continue }
        fields :: line.split(';').map(field -> field.trim()).collect::<[String]>()
        if fields.len() < 5 || !fields[4].is_empty() { continue }
        cp :: U32.from_str_radix(fields[0], 16).unwrap()
        _ :: lower.insert(cp, cps(fields[1])); _ :: upper.insert(cp, cps(fields[3]))
    }
    casing_scalars := 0
    for cp in 0..=0x10ffff {
        scalar :: Char.from_u32(cp)
        if scalar.is_none() { continue }
        input :: scalar.unwrap().to_string()
        assert_eq(text.lower(input), lower.get(cp).unwrap_or(input))
        assert_eq(text.upper(input), upper.get(cp).unwrap_or(input))
        casing_scalars += 1
    }
    assert_eq(text.lower("ΟΣ"), "ος")
    grapheme :: check_break(include_str("__ROOT__/tests/data/unicode/GraphemeBreakTest.txt"), text.graphemes)
    word :: check_break(include_str("__ROOT__/tests/data/unicode/WordBreakTest.txt"), text.word_segments)
    sentence :: check_break(include_str("__ROOT__/tests/data/unicode/SentenceBreakTest.txt"), text.sentence_segments)
    assert(normalization_lines > 15000 && fold_lines > 1500)
    assert(grapheme > 500 && word > 500 && sentence > 100)
    print("{normalization_lines} {fold_lines} {casing_scalars} {grapheme} {word} {sentence}")
}
`.replace("__ROOT__", root_text)
    scratch :: common.Scratch.new("jet_unicode_aot_corpora")
    tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
    entry :: scratch.join("unicode_aot.jet")
    fs.write(entry, source).unwrap()
    bundle :: jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(bundle, tier).expect("Unicode corpus executes")
        assert_eq(result.exit_code, 0, "Unicode corpus {tier:?} failed: {result.stderr}")
        assert_eq(result.stdout, "19965 1557 1112064 1093 1826 512\n")
        assert_eq(result.stderr, "")
    }
}

// Rust: tests/text_unicode.rs:327
#Test("unicode_text_behavior_matches_comptime_and_aot") {
    source :: `
use core.text as text
use core.regex as re
FOLDED :: prep { text.casefold("Straßeİς") }
LOWERED :: prep { text.lower("ΟΣ") }
UPPERED :: prep { text.upper("ßև") }
METHOD_LOWERED :: prep { "__PINNED_UPPER__".to_lower() }
METHOD_UPPERED :: prep { "__PINNED_LOWER__".to_upper() }
METHOD_TRIMMED :: prep { "__PINNED_SPACE__jet__PINNED_SPACE__".trim() }
KEYCAP :: prep { text.display_width("1️⃣") }
EMOJI :: prep { text.display_width("©️") }
IGNORABLE :: prep { text.display_width("́‍") }
CLASSES :: prep { text.is_alphabetic("Ж") && text.is_numeric("٣") && text.is_whitespace(" ") }
REGEX_SPACE :: prep { re.is_match(.{"\s"}, " ") }
fn run() -> {
    runtime_folded :: text.casefold("Straßeİς")
    runtime_lowered :: text.lower("ΟΣ")
    runtime_uppered :: text.upper("ßև")
    runtime_method_lowered :: "__PINNED_UPPER__".to_lower()
    runtime_method_uppered :: "__PINNED_LOWER__".to_upper()
    runtime_method_trimmed :: "__PINNED_SPACE__jet__PINNED_SPACE__".trim()
    runtime_keycap :: text.display_width("1️⃣")
    runtime_emoji :: text.display_width("©️")
    runtime_ignorable :: text.display_width("́‍")
    runtime_classes :: text.is_alphabetic("Ж") && text.is_numeric("٣") && text.is_whitespace(" ")
    runtime_regex_space :: re.is_match(.{"\s"}, " ")
    regex_alpha :: re.is_match(.{"\p{{Alphabetic}}+"}, "Ж")
    regex_number :: re.is_match(.{"\p{{Number}}+"}, "٣")
    regex_whitespace :: re.is_match(.{"\p{{White_Space}}+"}, " ")
    insensitive :: re.compile_with("k", re.flags(true, false, false)) ?? panic("regex")
    print("{FOLDED}|{runtime_folded}")
    print("{LOWERED}|{runtime_lowered}")
    print("{UPPERED}|{runtime_uppered}")
    print(METHOD_LOWERED == "__PINNED_LOWER__" && runtime_method_lowered == "__PINNED_LOWER__")
    print(METHOD_UPPERED == "__PINNED_UPPER__" && runtime_method_uppered == "__PINNED_UPPER__")
    print("{METHOD_TRIMMED}|{runtime_method_trimmed}")
    print("{KEYCAP}|{runtime_keycap}")
    print("{EMOJI}|{runtime_emoji}")
    print("{IGNORABLE}|{runtime_ignorable}")
    print("{CLASSES}|{runtime_classes}")
    print("{REGEX_SPACE}|{runtime_regex_space}")
    print(regex_alpha && regex_number && regex_whitespace && insensitive.is_match("K"))
}
`.replace("__PINNED_UPPER__", Char.from_u32(0xA7CE).unwrap().to_string()).replace("__PINNED_LOWER__", Char.from_u32(0xA7CF).unwrap().to_string()).replace("__PINNED_SPACE__", Char.from_u32(0x2003).unwrap().to_string())
    tir_support.assert_tiers_agree("jet_text_unicode_parity", source, "strassei̇σ|strassei̇σ\nος|ος\nSSԵՒ|SSԵՒ\ntrue\ntrue\njet|jet\n2|2\n2|2\n0|0\ntrue|true\ntrue|true\ntrue\n")
}

// Rust: tests/text_unicode.rs:399
#Test("scalar_inspector_names_invisible_codepoints") {
    root :: Path.new(env("CARGO_MANIFEST_DIR"))
    root_text :: root.to_string_lossy().replace('\\', "\\\\")
    source :: `
use core.text as text
// Rust: tests/text_unicode.rs:416 (inspector harness)
fn run() -> {
    checked := 0
    for raw in include_str("__ROOT__/tests/data/unicode/ucd/UnicodeData.txt").lines() {
        fields :: raw.split(';').collect::<[String]>()
        if fields.len() < 14 { continue }
        cp :: U32.from_str_radix(fields[0], 16).unwrap()
        name := fields[1]
        if name.ends_with(", First>") || name.ends_with(", Last>") { continue }
        if name == "<control>" { name = fields[10] }
        if name.is_empty() || name.starts_with('<') { continue }
        scalar :: Char.from_u32(cp)
        if scalar.is_none() { continue }
        expected :: "U+{cp:04X} {name}"
        got :: text.inspect(scalar.unwrap().to_string()).into_iter().next().unwrap()
        assert_eq(got, expected, "name mismatch for U+{cp:04X}")
        checked += 1
    }
    assert(checked > 30000, "pinned UnicodeData name rows unexpectedly low: {checked}")
    assert_eq(text.inspect("👨‍👩‍👦")[1], "U+200D ZERO WIDTH JOINER")
    print(checked)
}
`.replace("__ROOT__", root_text)
    scratch :: common.Scratch.new("jet_scalar_inspector")
    tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
    entry :: scratch.join("scalar_inspector.jet")
    fs.write(entry, source).unwrap()
    bundle :: jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(bundle, tier).expect("scalar inspector executes")
        assert_eq(result.exit_code, 0, "scalar inspector {tier:?} failed: {result.stderr}")
        assert_eq(result.stdout, "40074\n")
        assert_eq(result.stderr, "")
    }
}

// Rust: tests/text_unicode.rs:480
#Test("unicode_grapheme_zwj_requires_pictographic_context_on_all_run_tiers") {
    source :: `
use core.text as text
fn run() -> {
    unrelated := text.graphemes("a‍👨")
    print(unrelated.len())
    loop part in unrelated -> print(part)
    pictographic := text.graphemes("👨‍👩")
    print(pictographic.len())
    loop part in pictographic -> print(part)
    extended := text.graphemes("👨́‍👩")
    print(extended.len())
    loop part in extended -> print(part)
}
`
    scratch :: common.Scratch.new("unicode_grapheme_zwj_context")
    program :: scratch.join("grapheme_zwj_context.jet")
    fs.write(program, source).expect("write ZWJ context fixture")
    fs.write(scratch.join("package.jet"), "name: \"grapheme_zwj_context\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n").expect("write ZWJ context authority")
    bundle :: jet.Loader.load_entry(program.to_str().unwrap()).unwrap()
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(bundle, tier).expect("spawn ZWJ context fixture")
        assert_eq(result.exit_code, 0, "ZWJ context fixture failed in {tier:?} tier:\n{result.stderr}")
        assert_eq(result.stdout, "2\na‍\n👨\n1\n👨‍👩\n1\n👨́‍👩\n", "ZWJ context segmentation differed in {tier:?} tier")
        assert_eq(result.stderr, "")
    }
}

