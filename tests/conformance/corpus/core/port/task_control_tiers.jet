// Rust: tests/task_control_tiers.rs:268
fn run_forced_interpreter(name: String, source: String) -> String {
    dir :: std.env.temp_dir().join("jet_task_control_interp_{name}_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, source).unwrap()
    result :: match jet.Interpreter.dev_iteration(path.to_str().unwrap(), false, true) {
        jet.Interpreter.RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "forced interpreter: {stderr}")
            assert_eq(stderr, "", "forced interpreter diagnostics: {stderr}")
            stdout
        },
        jet.Interpreter.RunOutcome.Problems(diagnostics) -> panic("forced interpreter rejected {name}: {diagnostics:?}")
    }
    _ :: fs.remove_dir_all(dir)
    result
}
// Rust: tests/task_control_tiers.rs:448
// run_default_multi's trace may prefix stdout; retain only program output.
fn strip_tier_trace(stdout: String) -> String {
    stdout.lines().filter(line -> !line.starts_with("[tier")).map(line -> "{line}\n").collect::<String>()
}
