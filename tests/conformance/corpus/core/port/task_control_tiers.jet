// Rust: tests/task_control_tiers.rs:75
LOSER_CLEANUP_SOURCE :: `
use core.time as time
struct Mark { step: Int }
fn win(state: Shared<Mark>) -> Int {
    state.step = 1
    return 1
}
fn lose(state: Shared<Mark>) -> Int {
    time.sleep(100ms)
    state.step = 2
    return 2
}
fn run() -> {
    race_state :: shared Mark{ step: 0 }
    any_state :: shared Mark{ step: 0 }
    task.group workers {
        race_result :: (task.race { win(race_state), lose(race_state) }) ?? 0
        any_result :: (task.any { win(any_state), lose(any_state) }) ?? 0
        time.sleep(200ms)
        print(race_result)
        print(race_state.step)
        print(any_result)
        print(any_state.step)
    }
}
`
// Rust: tests/task_control_tiers.rs:106
fn limit_source(limit: I64) -> String {
    `
use core.tasks as tasks
use core.time as time
fn run() -> {
    (sender, receiver) :: channel<Int>()
    second_sender :: ~sender
    task.group limited(limit: {limit}) {
        first :: task {
            sender.send(1)
            time.sleep(25ms)
            sender.send(2)
        }
        receiver.receive() ?? 0
        second :: task { second_sender.send(3) }
        print(receiver.receive() ?? 0)
        print(receiver.receive() ?? 0)
        first.join() ?? panic("first task failed")
        second.join() ?? panic("second task failed")
    }
}
`.replace("{limit}", limit.to_string())
}
// Rust: tests/task_control_tiers.rs:157
fn checked_task_bundle_for(name: String, source: String) -> (jet.AST.ProgramBundle, OSPath) {
    dir :: std.env.temp_dir().join("jet_task_control_frontend_{name}_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, source).unwrap()
    shown :: path.to_string_lossy().into_owned()
    bundle := jet.Loader.load_entry(shown).expect("task source must load")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter(diagnostic -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect::<[&jet.Diagnostics.Diagnostic]>()
    assert(errors.is_empty(), "sema diagnostics: {errors:?}")
    (^bundle, dir)
}
// Rust: tests/task_control_tiers.rs:179
fn checked_task_bundle(name: String) -> (jet.AST.ProgramBundle, OSPath) {
    checked_task_bundle_for(name, SOURCE)
}
