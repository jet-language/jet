struct Scratch { dir: OSPath }
impl Scratch {
    // Rust: tests/encoding_parity.rs:30
    fn new(tag: String) -> Scratch {
        sequence :: SEQ.fetch_add(1, Ordering.Relaxed)
        dir :: env.temp_dir().join("jet_enc_parity_{tag}_{process.id()}_{sequence}")
        _ :: fs.remove_dir_all(dir)
        fs.create_dir_all(dir).unwrap()
        Scratch{dir: dir}
    }
    // Rust: tests/encoding_parity.rs:41
    fn write_project(self, edition: String, body: String) -> OSPath {
        fs.write(self.dir.join("package.jet"), "name: \"enc\"\nversion: \"0.1.0\"\nedition: \"{edition}\"\nauthority: {{ holds: {{ allow: [FS, IO, Mem.Alloc] }} }}\n").unwrap()
        path :: self.dir.join("run.jet")
        // Every tier receives the same absolute fixture paths, including the
        // in-process dev tier whose cwd remains the test runner's repository.
        fs.write(path, body.replace("@DIR@", self.dir.display().to_string())).unwrap()
        path
    }
    // Rust: tests/encoding_parity.rs:59
    fn path(self) -> @OSPath from self { @self.dir }
}
