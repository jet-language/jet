// Rust: tests/encoding_parity.rs:1550
fn assert_aot_dev_stream_parity(label: String, source: String) -> {
    on_encoding_stack(() -> assert_aot_dev_stream_parity_inner(label, source))
}
// Rust: tests/encoding_parity.rs:1554
fn assert_aot_dev_stream_parity_inner(label: String, source: String) -> {
    if !common.have_rustc() { eprintln("note: skipping {label} stream parity (need rustc)"); return }
    scratch :: Scratch.new(label)
    path :: scratch.write_project("2026", source)
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "{label} AOT stream failed: {aot.stderr}")
    assert_default_dev_matches_aot_or_honest_gap(label, path, scratch.path(), aot, false)
}
