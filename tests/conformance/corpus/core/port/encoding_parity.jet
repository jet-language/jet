//RS     let path = scratch.write_project("2026", TYPED_CSV_ENCODE);
//RS     let aot = run_aot(&path, scratch.path());
//RS     assert_eq!(aot.exit, 0, "typed CSV AOT failed: {}", aot.stderr);
//RS     // An empty success is never correct: pin the real cells, not just parity,
//RS     // so both lenses agreeing on "$xml_event" could not pass this test.
//RS     assert!(
//RS         aot.stdout.contains("item,qty\npen,3\nink,5"),
//RS         "typed CSV AOT lost the records: {}",
//RS         aot.stdout
//RS     );
//RS     assert!(
//RS         aot.stdout.contains("typed-len: 20"),
//RS         "typed CSV AOT length drifted: {}",
//RS         aot.stdout
//RS     );
//RS     assert!(
//RS         aot.stdout.contains("rows: name,score\nada,9"),
//RS         "dynamic rows CSV regressed: {}",
