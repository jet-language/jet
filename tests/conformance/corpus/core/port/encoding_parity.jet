//RS         .expect("exact-number Python fixture must execute");
//RS     assert!(
//RS         python.status.success(),
//RS         "exact-number Python fixture failed: {}",
//RS         String::from_utf8_lossy(&python.stderr)
//RS     );
//RS     assert_eq!(
//RS         String::from_utf8_lossy(&python.stdout),
//RS         concat!(
//RS             "12.340\n0.00001\n",
//RS             "12345678901234567890123456789012345678901234567890\n",
//RS             "accepted-nonfinite:2\n",
