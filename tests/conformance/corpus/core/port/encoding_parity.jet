//RS     adjacent_hi: Int
//RS     large: Int
//RS     large_exp: Int
//RS }
//RS 
//RS #Codable
//RS struct SmallI64 {
//RS     value: I64
//RS }
//RS 
//RS #Codable
//RS struct ExactIntRow {
//RS     adjacent_hi: Int
//RS     large: Int
//RS }
//RS 
//RS LIMITED_TEXT :: prep { "1{"0".repeat(1000000)}" }
//RS 
//RS fn run() {
//RS     exact_text :: fs.read("@DIR@/exact.json") ?? panic("exact JSON read")
//RS     value :: json.decode<ExactNumbers>(exact_text) ?? panic("exact JSON decode")
//RS     print(value.amount.to_string())
//RS     print(value.exponent.to_string())
//RS     print(value.whole.to_string())
//RS     print(value.tenth.to_string())
//RS     print(value.tenth_with_zero.to_string())
//RS     print(value.scientific_tenth.to_string())
//RS     print(value.adjacent_lo.to_string())
//RS     print(value.adjacent_hi.to_string())
//RS     print(value.large.to_string())
//RS     print(value.large_exp.to_string())
//RS 
//RS     stream_raw :: "{{\"adjacent_hi\":9007199254740993,\"large\":12345678901234567890123456789012345678901234567890}}"
//RS     rows :: data.json<ExactIntRow>("[{stream_raw}]") ?? panic("stream decode")
//RS     loop row in rows {
//RS         print(row.adjacent_hi.to_string())
//RS         print(row.large.to_string())
//RS     }
//RS 
//RS     json.decode<SmallI64>("{{\"value\":9223372036854775808}}") ? _value -> { print("accepted") } ! _error -> { print("i64-overflow") }
//RS     json.decode<Float>("1e400") ? _value -> { print("accepted") } ! _error -> { print("nonfinite") }
//RS     json.decode<Decimal>("NaN") ? _value -> { print("accepted") } ! _error -> { print("nan-rejected") }
//RS     json.decode<Decimal>("Infinity") ? _value -> { print("accepted") } ! _error -> { print("infinity-rejected") }
//RS     json.decode<Int>("1.5") ? _value -> { print("accepted") } ! _error -> { print("fractional-rejected") }
//RS     json.decode<Decimal>("1e1000001") ? _value -> { print("accepted") } ! _error -> { print("exponent-limit") }
//RS     mismatch_text :: fs.read("@DIR@/mismatch.json") ?? panic("mismatch JSON read")
//RS     json.decode<ExactNumbers>(mismatch_text) ? _value -> { print("accepted") } ! _error -> { print("file-mismatch") }
//RS     mismatch_raw :: "{{\"amount\":\"12.340\",\"exponent\":1E-5,\"whole\":100,\"tenth\":0.1,\"tenth_with_zero\":0.10,\"scientific_tenth\":1e-1,\"adjacent_lo\":1,\"adjacent_hi\":1,\"large\":1,\"large_exp\":1}}"
//RS     json.decode<ExactNumbers>(mismatch_raw) ? _value -> { print("accepted") } ! _error -> { print("mismatch") }
//RS     data.json<ExactNumbers>("[{mismatch_raw}]") ? _value -> { print("accepted") } ! _error -> { print("stream-mismatch") }
//RS     json.decode<String>("123") ? _value -> { print("accepted") } ! _error -> { print("string-mismatch") }
//RS     json.decode<Decimal>(@limited_text) ? _value -> { print("accepted") } ! _error -> { print("limit") }
//RS }
//RS "#;
//RS     let scratch = Scratch::new("exact_typed_json_numbers");
//RS     let path = scratch.write_project("2026", source);
//RS     fs::write(
//RS         scratch.path().join("exact.json"),
//RS         r#"{"amount":12.340,"exponent":1E-5,"whole":100,"tenth":0.1,"tenth_with_zero":0.10,"scientific_tenth":1e-1,"adjacent_lo":9007199254740992,"adjacent_hi":9007199254740993,"large":12345678901234567890123456789012345678901234567890,"large_exp":1e30}"#,
