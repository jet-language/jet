//RS /// `csv.to_string` takes either the dynamic `[[String]]` rows form or a typed
//RS /// `[T]` list of `#Codable` values. The resident JIT used to send both to the
//RS /// rows host, so a typed list rendered "$xml_event" and still reported success — silent
//RS /// data loss on the default `jet run` path (#1269). Both shapes are exercised
//RS /// here so the rows form stays covered too.
//RS const TYPED_CSV_ENCODE: &str = r#"
//RS use core.encoding.csv as csv
//RS 
//RS #Codable
//RS struct Sale {
//RS     item: String
//RS     qty: Int
//RS }
//RS 
//RS fn run() {
//RS     sales :: [Sale{item: "pen", qty: 3}, Sale{item: "ink", qty: 5}]
//RS     typed :: csv.to_string(sales)
//RS     print("typed-len: {typed.len()}")
//RS     print(typed)
//RS     rows :: [["name", "score"], ["ada", "9"]]
//RS     print("rows: {csv.to_string(rows)}")
//RS }
//RS "#;
//RS 
//RS #[test]
//RS fn typed_csv_encode_matches_aot_and_default_dev() {
//RS     on_encoding_stack(typed_csv_encode_matches_aot_and_default_dev_inner);
//RS }
//RS 
//RS fn typed_csv_encode_matches_aot_and_default_dev_inner() {
//RS     if !common::have_rustc() {
//RS         eprintln!("note: skipping typed CSV encode parity (need rustc)");
//RS         return;
//RS     }
