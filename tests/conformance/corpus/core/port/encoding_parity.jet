//RS     );
//RS 
//RS     let source = r#"
//RS use core.encoding.json as json
//RS use core.data as data
//RS use core.files as fs
//RS 
//RS #Codable
//RS struct ExactNumbers {
//RS     amount: Decimal
//RS     exponent: Decimal
//RS     whole: Decimal
