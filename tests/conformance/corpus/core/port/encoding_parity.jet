struct ProgramOutput { exit: I32, stdout: String, stderr: String }
impl ProgramOutput {
    // Rust: tests/encoding_parity.rs:72
    fn ran(stdout: String, stderr: String, exit: I32) -> ProgramOutput {
        ProgramOutput{exit: exit, stdout: ^stdout, stderr: ^stderr}
    }
}
// Rust: tests/encoding_parity.rs:81
enum DevBackend { O0, Problems }
// Rust: tests/encoding_parity.rs:87
fn on_encoding_stack<R: Send>(work: fn() -> R) -> R {
    result :: thread.scope(scope -> thread.Builder.new().stack_size(64 * 1024 * 1024).spawn_scoped(scope, ^work).expect("spawn encoding parity worker").join())
    if result == {
        .Ok(value) -> value
        .Err(payload) -> panic_runtime.resume_unwind(^payload)
    }
}
// Rust: tests/encoding_parity.rs:101
fn run_aot(jet_path: OSPath, cwd: OSPath) -> ProgramOutput {
    assert(common.have_rustc(), "AOT parity requires rustc")
    src :: fs.read_to_string(jet_path).unwrap()
    shown :: jet_path.to_string_lossy()
    out :: compile_with_path(src, shown).unwrap_or_else(diags -> panic("AOT compile rejected:\n{render_diagnostics(shown, src, diags)}"))
    rs :: cwd.join("parity_aot.rs")
    bin :: cwd.join("parity_aot")
    // Generated Rust remains the reference compiled-backend comparator, never
    // a provider or runtime fallback for the Jet port.
    fs.write(rs, out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if out.ffi == .Val(link) {
        rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(dir -> dir.is_dir()) {
            rustc.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    built :: rustc.output().unwrap()
    assert(built.status.success(), "rustc rejected generated encoding fixture:\n{String.from_utf8_lossy(built.stderr)}")
    run :: Command.new(bin).current_dir(cwd).output().unwrap()
    ProgramOutput.ran(String.from_utf8_lossy(run.stdout).into_owned(), String.from_utf8_lossy(run.stderr).into_owned(), run.status.code().unwrap_or(-1))
}
// Rust: tests/encoding_parity.rs:146
fn checked_bundle(path: String) -> jet.AST.ProgramBundle {
    bundle := jet.Loader.load_entry(path).expect("fixture should load")
    source :: fs.read_to_string(path).expect("fixture source should remain readable")
    diags :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    errors :: diags.iter().filter(d -> d.severity == jet.Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "fixture must type-check:\n{jet.render_diagnostics(path, source, diags)}")
    bundle
}
// Rust: tests/encoding_parity.rs:162
fn run_default_dev(path: String) -> (DevBackend, ProgramOutput) {
    _ :: checked_bundle(path)
    // Default dev uses the canonical O0 execution path. Retired resident-JIT
    // representation predicates are replaced by observable output parity.
    if dev_iteration(path, false, false) == {
        .Ran{stdout, stderr, exit_code} -> (DevBackend.O0, ProgramOutput.ran(^stdout, ^stderr, exit_code))
        .Problems(diags) -> {
            assert(!diags.iter().any(d -> d.code == "E2211"), "E2211 retired by #778; encoding probes must name their execution boundary: {diags.debug()}")
            detail :: diags.iter().map(d -> "{d.code}:{d.what}").collect().join("; ")
            (DevBackend.Problems, ProgramOutput.ran("", "execution gap: {detail}", 101))
        }
    }
}
// Rust: tests/encoding_parity.rs:222
fn run_forced_interpreter(path: String) -> ProgramOutput {
    if dev_iteration(path, false, true) == {
        .Ran{stdout, stderr, exit_code} -> ProgramOutput.ran(^stdout, ^stderr, exit_code)
        .Problems(diags) -> panic("forced interpreter rejected encoding probe: {diags.debug()}")
    }
}
// Rust: tests/encoding_parity.rs:235
fn assert_aot_comptime_binding_parity(label: String, source: String, jet_path: OSPath, cwd: OSPath) -> {
    aot :: run_aot(jet_path, cwd)
    assert_eq(aot.exit, 0, "{label} AOT failed: {aot.stderr}")
    lines :: aot.stdout.lines().collect()
    assert(lines.len() >= 2, "{label} expected comptime|runtime probe lines, got {lines.debug()}")
    loop (i, line) in lines.iter().enumerate() {
        (comptime, runtime) :: line.split_once('|').unwrap_or_else(() -> panic("{label} line {i} missing comptime|runtime split: {line}"))
        assert_eq(comptime, runtime, "{label} comptime/AOT divergence on line {i}: comptime={comptime.debug()} runtime={runtime.debug()}")
    }
    diags :: jet.check_with_path(jet_path.to_str().unwrap())
    assert(diags.is_empty(), "{label} sema rejected comptime fixture:\n{jet.render_diagnostics(jet_path.to_str().unwrap(), source, diags)}")
}
// Rust: tests/encoding_parity.rs:265
// Named file-backed interpreter gaps cannot claim encoding parity.
fn named_encoding_dev_gap(stderr: String) -> Bool {
    e0956 :: stderr.contains("E0956") && (stderr.contains("ResourceNew") || stderr.contains("ResourceTake") || stderr.contains("handle `") || stderr.contains("FileReader") || stderr.contains("FileWriter") || stderr.contains("JSONReader") || stderr.contains("JSONWriter") || stderr.contains("CSVReader") || stderr.contains("CSVWriter") || stderr.contains("XMLReader") || stderr.contains("XMLWriter") || stderr.contains("CBORReader") || stderr.contains("CBORWriter") || stderr.contains("JSONLReader") || stderr.contains("JSONLWriter"))
    e0953 :: stderr.contains("E0953") && (stderr.contains("stopped the build") || stderr.contains("panic"))
    e0956 || e0953
}
// Rust: tests/encoding_parity.rs:289
fn assert_default_dev_matches_aot_or_honest_gap(label: String, jet_path: OSPath, _cwd: OSPath, aot: ProgramOutput, interpreter_fallback: Bool) -> {
    (backend, dev) :: run_default_dev(jet_path.to_str().unwrap())
    eprintln("{label} default-dev backend={backend.debug()} exit={dev.exit} deopt_gap={named_encoding_dev_gap(dev.stderr)}")
    if backend == {
        .O0 -> {
            assert_eq(dev.stdout, aot.stdout, "{label} default-dev/O0 stdout drift")
            assert_eq(dev.stderr, aot.stderr, "{label} default-dev/O0 stderr drift")
            assert_eq(dev.exit, aot.exit, "{label} default-dev/O0 exit drift")
        }
        .Problems -> {
            if dev.exit == 0 {
                assert_eq(dev.stdout, aot.stdout, "{label} deopt-interp stdout drift")
                assert_eq(dev.stderr, aot.stderr, "{label} deopt-interp stderr drift")
                assert_eq(dev.exit, aot.exit, "{label} deopt-interp exit drift")
            } else if named_encoding_dev_gap(dev.stderr) {
                eprintln("note: {label} default-dev named gap (no parity claim): {dev.stderr}")
            } else if interpreter_fallback {
                interp :: run_forced_interpreter(jet_path.to_str().unwrap())
                assert_eq(interp.stdout, aot.stdout, "{label} forced-interpreter must preserve AOT encoding semantics when default-dev deopts")
                assert_eq(interp.exit, aot.exit, "{label} interpreter exit drift")
            } else {
                panic("{label} default-dev deopt failed without named encoding gap or parity: exit={dev.exit} stderr={dev.stderr}")
            }
        }
    }
}
