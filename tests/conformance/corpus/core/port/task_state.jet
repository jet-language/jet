//RS fn method_parameters_spawn_owned_captures() {
//RS     let source = r#"
//RS struct Crawler {
//RS     step: Int
//RS 
//RS     fn drain(self, _group: Group, values: ^[Int]) {
//RS         step :: self.step
//RS         handle :: task values[0] + step
//RS         print(handle.join() ?? 0)
//RS     }
//RS }
//RS 
//RS fn run() {
//RS     task.group group {
//RS         crawler :: Crawler{step: 2}
