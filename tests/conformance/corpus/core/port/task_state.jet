//RS /// Card #2006: a `return` inside a `task { … }` body is a CONDITIONAL return of
//RS /// the enclosing function — the body may run later or not at all — so every
//RS /// statement after the task stays reachable. Before the fix the body's `return`
//RS /// left `flow.reachable == false` in the ENCLOSING block, so `check_stmt`
//RS /// restored the pre-statement facts for each following statement and discarded
//RS /// its declaration: one mistake inside a task body buried its own real error
//RS /// under eleven phantom `nothing named X exists here` reports.
//RS #[test]
//RS fn a_return_inside_a_task_body_keeps_later_declarations() {
//RS     let valueless = r#"
//RS fn run() {
//RS     child :: task { return }
//RS     later :: 7
//RS     print(later)
//RS     child.detach()
//RS }
//RS "#;
//RS     let codes = all_codes(valueless);
//RS     assert!(
//RS         codes.iter().all(|code| code != "E0107" && code != "E0102"),
//RS         "a task-body return must not erase later declarations: {codes:?}"
//RS     );
//RS 
//RS     // The same program with a real mistake inside the task body: the mistake is
//RS     // reported, and nothing after the task is reported as undeclared.
//RS     let mistaken = r#"
//RS fn run() {
//RS     child :: task { return "child" }
//RS     later :: 7
//RS     print(later)
//RS     child.detach()
//RS }
//RS "#;
//RS     let codes = all_codes(mistaken);
//RS     assert!(
//RS         codes.iter().all(|code| code != "E0107" && code != "E0102"),
//RS         "the real error must not drag a phantom name cascade behind it: {codes:?}"
//RS     );
//RS     assert!(
//RS         !codes.is_empty(),
//RS         "the return handing a value back from a Unit `run` is still an error"
//RS     );
//RS }
