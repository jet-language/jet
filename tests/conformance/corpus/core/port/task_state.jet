//RS         crawler.drain(group, ^values)
//RS     }
//RS }
//RS "#;
//RS     assert_group_close_success("method_parameter_group", source, "42\n");
//RS 
//RS     // Admitting the method position does not weaken the capture rule. A group
//RS     // reached through a parameter joins in another frame, so a view capture
//RS     // could dangle; it stays E1102 exactly as it does on a free function.
//RS     let view_capture = r#"
//RS struct Crawler {
//RS     step: Int
//RS 
//RS     fn drain(self, group: Group, values: View<Int>) {
//RS         handle :: task values[0]
//RS         print(handle.join() ?? 0)
//RS     }
//RS }
//RS 
//RS fn run() {}
//RS "#;
//RS     assert_eq!(error_codes(view_capture), ["E1102"]);
//RS }
