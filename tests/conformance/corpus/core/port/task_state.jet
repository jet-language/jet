`
// Rust: tests/taskgroup_params.rs:42
fn taskgroup_project(prefix: String, name: String, source: String) -> (OSPath, OSPath) {
    dir :: env.temp_dir().join("jet_taskgroup_{prefix}_{name}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), TASKGROUP_TEST_PACKAGE).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, source).unwrap()
    (^dir, ^path)
}
// Rust: tests/taskgroup_params.rs:55
fn error_codes(source: String) -> [String] {
    jet.compile(source).expect_err("source must be rejected").into_iter().map(diagnostic -> diagnostic.code).collect()
}
// Rust: tests/taskgroup_params.rs:63
fn interpreter_outcome(name: String, source: String) -> RunOutcome {
    (dir, path) :: taskgroup_project("interp", name, source)
    outcome :: dev_iteration(path.to_str().unwrap(), false, true)
    _ :: fs.remove_dir_all(^dir)
    outcome
}
// Rust: tests/taskgroup_params.rs:70
// The retired resident-JIT compile probe now checks the canonical native front end.
fn assert_native_compiles(name: String, source: String) -> {
    join :: thread.Builder.new().name("jet-taskgroup-native-{name}").stack_size(8 * 1024 * 1024).spawn(() -> {
        (dir, path) :: taskgroup_project("native", name, source)
        bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
        errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(diagnostic -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
        assert(errors.is_empty(), "{errors:?}")
        _ :: jet.compile_with_path(source, path.to_str().unwrap()).expect("Group source must compile for native execution")
        _ :: fs.remove_dir_all(^dir)
    }).expect("spawn native compile thread")
    join.join().expect("native compile thread")
}
// Rust: tests/taskgroup_params.rs:384
fn assert_native_wait_exit(name: String, source: String, stderr_text: String, expected_stdout: String) -> {
    assert_native_compiles(name, source)
    (code, stdout, stderr) :: run_default_multi(name, "main.jet", [("main.jet", source)])
    assert_ne(code, 0, "{stderr}")
    assert_eq(stdout, expected_stdout, "{stderr}")
    assert(!stdout.contains("caller"), "{stdout:?}\n{stderr}")
    assert(stderr.contains(stderr_text), "{stderr}")
}
// Rust: tests/taskgroup_params.rs:401
fn assert_group_close_success(name: String, source: String, expected_stdout: String) -> {
    interpreted :: match interpreter_outcome(name, source) {
        .Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "interpreter: {stderr}")
            assert_eq(stderr, "", "interpreter diagnostics: {stderr}")
            ^stdout
        }
        .Problems(diags) -> panic("interpreter rejected {name}: {diags:?}")
    }
    assert_eq(interpreted, expected_stdout, "interpreter output drifted")
    // Rust: tests/taskgroup_params.rs:424-449 — resident-safety representation
    // probing is retired; retain its stack budget and front-end acceptance probe.
    probe :: thread.Builder.new().name("jet-taskgroup-native-{name}").stack_size(8 * 1024 * 1024).spawn(() -> {
        (dir, path) :: taskgroup_project("native_probe", name, source)
        bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
        errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(diagnostic -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
        assert(errors.is_empty(), "native probe rejected {name}: {errors:?}")
        _ :: jet.compile_with_path(source, path.to_str().unwrap()).expect("Group source must compile for native execution")
        _ :: fs.remove_dir_all(^dir)
    }).expect("spawn native probe")
    probe.join().expect("native probe panicked")
    (code, stdout, stderr) :: run_default_multi(name, "main.jet", [("main.jet", source), ("package.jet", TASKGROUP_TEST_PACKAGE)])
    assert_eq(code, 0, "default native: {stderr}")
    assert_eq(stderr, "", "runtime diagnostics: {stderr}")
    assert_eq(stdout, expected_stdout, "default native output drifted")
    if have_rustc() {
        (code, stdout, stderr) :: build_and_run_full("jet_taskgroup", name, source)
        assert_eq(code, 0, "AOT: {stderr}")
        assert_eq(stderr, "")
        assert_eq(stdout, expected_stdout, "AOT output drifted")
        (release_code, release_stdout, release_stderr) :: tir_support.build_release_and_run_multi("jet_taskgroup_{name}_release", "main.jet", [("main.jet", source), ("package.jet", TASKGROUP_TEST_PACKAGE)])
        assert_eq(release_code, 0, "O2: {release_stderr}")
        assert_eq(release_stderr, "")
        assert_eq(release_stdout, expected_stdout, "O2 output drifted")
    }
}
