// Rust: tests/task_state.rs:1
// Task state and join duty share the existing typestate and D-LIN1 flow facts.
// Rust: tests/task_state.rs:4
fn diagnostic_codes(source: String) -> [String] {
    match jet.compile(source) {
        .Ok(output) -> output.lints.into_iter().map(diagnostic -> diagnostic.code).collect()
        .Err(diagnostics) -> diagnostics.into_iter().map(diagnostic -> diagnostic.code).collect()
    }
}
// Rust: tests/task_state.rs:92
// Every diagnostic code, whether the source compiled or not.
fn all_codes(source: String) -> [String] {
    match jet.compile(source) {
        .Ok(output) -> output.lints.into_iter().map(diagnostic -> diagnostic.code).collect()
        .Err(diagnostics) -> diagnostics.into_iter().map(diagnostic -> diagnostic.code).collect()
    }
}

