// Rust: tests/encoding_hostile_io.rs:1-9
// D-ENCSTREAM-SURFACE1 hostile FileReader/FileWriter seam across JSON/JSONL/CSV/CBOR.
use std.fs as fs
use std.process.Command
use jet as jet
// GATE #4494 real retained files, environment and subprocess execution.

// Rust: tests/encoding_hostile_io.rs:11
pub fn build_and_run(dir: OSPath, name: String, src: String, env: [(String, String)]) -> (I32, String, String) {
    path :: dir.join("{name}.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: jet.compile_with_path(src, shown).unwrap_or_else(|diags| -> {
        panic("front end rejected fixture:\n{jet.render_diagnostics(shown, src, diags)}")
    })
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    fs.write(rs, out.rust).unwrap()
    rustc_cmd := Command.new("rustc")
    rustc_cmd.args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if out.ffi == Val(link) {
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(|dir| -> dir.is_dir()) {
            rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    rustc :: rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(rustc.stderr)}")
    cmd := Command.new(bin)
    cmd.current_dir(dir)
    loop (k, v) in env { cmd.env(k, v) }
    run :: cmd.output().unwrap()
    return (run.status.code().unwrap_or(-1), String.from_utf8_lossy(run.stdout).to_string(), String.from_utf8_lossy(run.stderr).to_string())
}

// Rust: tests/encoding_hostile_io.rs:66
pub fn hostile_env(extra: [(String, String)]) -> [(String, String)] {
    env := [("JET_ENC_HOSTILE_IO", "1")]
    env.extend(extra.iter().map(|(k, v)| -> (k.to_string(), v.to_string())))
    return env
}

// Rust: tests/encoding_hostile_io.rs:72
pub fn run_with_env(dir: OSPath, name: String, src: String, env: [(String, String)]) -> (I32, String, String) {
    path :: dir.join("{name}.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: jet.compile_with_path(src, shown).unwrap_or_else(|diags| -> {
        panic("front end rejected fixture:\n{jet.render_diagnostics(shown, src, diags)}")
    })
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    fs.write(rs, out.rust).unwrap()
    rustc_cmd := Command.new("rustc")
    rustc_cmd.args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if out.ffi == Val(link) {
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(|dir| -> dir.is_dir()) {
            rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    rustc :: rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(rustc.stderr)}")
    cmd := Command.new(bin)
    cmd.current_dir(dir)
    loop (k, v) in env { cmd.env(k, v) }
    run :: cmd.output().unwrap()
    return (run.status.code().unwrap_or(-1), String.from_utf8_lossy(run.stdout).to_string(), String.from_utf8_lossy(run.stderr).to_string())
}

// Rust: tests/encoding_hostile_io.rs:127
pub fn json_reader_fixture(input_path: String) -> String {
    return `
use core.encoding as encoding
use core.encoding.json as json
use core.files as files
fn run() -> {
    input :: files.open("@PATH@") ?? panic("open")
    reader :: json.reader(^input) ?? panic("reader")
    count := 0
    loop count < 32 {
        result :: reader.next()
        if result == {
            .Ok(maybe) -> {
                if maybe == None { break }
                count += 1
            }
            .Err(first) -> {
                again :: reader.next()
                if again == {
                    .Ok(_) -> { print("not-latched") }
                    .Err(second) -> { print(first.byte_offset == second.byte_offset && first.reason == second.reason) }
                }
                break
            }
        }
    }
    print(count)
    print("eof")
}
`.replace("@PATH@", input_path)
}

// Rust: tests/encoding_hostile_io.rs:164
pub fn json_writer_fixture(output_path: String) -> String {
    return `
use core.encoding as encoding
use core.encoding.json as json
use core.files as files
fn run() -> {
    output :: files.create("@PATH@") ?? panic("create")
    writer :: json.writer(^output) ?? panic("writer")
    writer.write(encoding.DataEvent.ObjectStart) ?? panic("object")
    writer.write(encoding.DataEvent.Key("a")) ?? panic("key")
    writer.write(encoding.DataEvent.Int(1)) ?? panic("int")
    writer.write(encoding.DataEvent.ObjectEnd) ?? panic("end")
    if writer.finish() == {
        .Ok(_) -> { print("finish-ok") }
        .Err(first) -> {
            again :: writer.finish()
            if again == {
                .Ok(_) -> { print("finish-not-latched") }
                .Err(second) -> { print(first.byte_offset == second.byte_offset && first.reason == second.reason) }
            }
        }
    }
    print(files.read("@PATH@") ?? panic("read"))
}
`.replace("@PATH@", output_path)
}

// Rust: tests/encoding_hostile_io.rs:196
pub fn jsonl_reader_fixture(input_path: String) -> String {
    return `
use core.encoding as encoding
use core.encoding.jsonl as jsonl
use core.files as files
fn run() -> {
    input :: files.open("@PATH@") ?? panic("open")
    reader :: jsonl.reader(^input) ?? panic("reader")
    first :: reader.next() ?? panic("first")
    if first == {
        Val(v) -> print(v.text() ?? "bad")
        None -> print("none")
    }
    second :: reader.next() ?? panic("second")
    if second == {
        Val(v) -> print(v.int() ?? -1)
        None -> print("none2")
    }
    eof :: reader.next() ?? panic("eof")
    if eof == None { print("eof") } else { print("bad-eof") }
}
`.replace("@PATH@", input_path)
}

// Rust: tests/encoding_hostile_io.rs:223
pub fn malformed_reader_fixture(codec: String, input_path: String) -> String {
    reader :: if codec == {
        "json" -> "json.reader(^input)"
        "jsonl" -> "jsonl.reader(^input)"
        "csv" -> "csv.reader(^input)"
        "cbor" -> "cbor.reader(^input)"
        _ -> unreachable()
    }
    return `
use core.encoding as encoding
use core.encoding.json as json
use core.encoding.jsonl as jsonl
use core.encoding.csv as csv
use core.encoding.cbor as cbor
use core.files as files
fn run() -> {
    input :: files.open("@PATH@") ?? panic("open")
    reader :: @READER@ ?? panic("reader")
    loop {
        result :: reader.next()
        if result == {
            .Ok(maybe) -> {
                if maybe == None {
                    print("eof-missed")
                    break
                }
            }
            .Err(first) -> {
                again :: reader.next()
                if again == {
                    .Ok(_) -> { print("not-latched") }
                    .Err(second) -> { print(first.byte_offset == second.byte_offset && first.reason == second.reason) }
                }
                break
            }
        }
    }
}
`.replace("@PATH@", input_path).replace("@READER@", reader)
}

// Rust: tests/encoding_hostile_io.rs:269
