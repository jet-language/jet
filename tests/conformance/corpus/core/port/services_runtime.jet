//RS 
//RS /// Durable delivery and an event log share one service tree but must not share
//RS /// one file. The delivery log and the state store use different framing, and
//RS /// the state store is read back with the adapter its header declares, so a
//RS /// durable send used to leave records the typed read could not parse: a later
//RS /// `append_event` failed on any tree that had accepted a `send_durable`.
//RS ///
//RS /// No existing check combined the two surfaces on one tree, so the collision
//RS /// only showed up in an example.
//RS const DURABLE_PLUS_EVENT_LOG_SOURCE: &str = r#"
//RS use core.service as services
//RS use core.testing as testing
//RS 
//RS fn durable_worker() {}
//RS 
//RS fn run() {
//RS     tree := services.tree("app")
//RS     tree.set_delivery(services.delivery_durable()) ?? panic("delivery")
//RS     temp := testing.temp_dir("services-delivery-eventlog")
//RS     store_path :: Path.from(temp).join("state.log").to_string()
//RS     store :: services.state_store(store_path) ?? panic("state store")
//RS     tree.set_state_event_log(store, "app-events", 1, "reversible") ?? panic("state")
//RS     worker :: tree.worker("a", durable_worker, capacity: 4) ?? panic("worker")
//RS     tree.start() ?? panic("start")
//RS 
//RS     first :: tree.send_durable(worker, "ping", key: "k1") ?? panic("durable send")
//RS     first.status() ?? panic("first status")
//RS     tree.append_event("after-durable-send") ?? panic("append after durable send")
//RS     second :: tree.send_durable(worker, "pong", key: "k2") ?? panic("second durable send")
//RS     second.status() ?? panic("second status")
//RS     tree.append_event("after-second-send") ?? panic("append after second send")
//RS 
//RS     print("events:{tree.event_count()}")
//RS }
//RS "#;
//RS 
//RS #[test]
//RS fn durable_delivery_does_not_corrupt_the_event_log_aot() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let (code, stdout) = build_and_run("services_durable_eventlog", DURABLE_PLUS_EVENT_LOG_SOURCE);
//RS     assert_eq!(code, 0, "durable send beside an event log must not fail");
//RS     assert_eq!(stdout, "events:2\n");
//RS }
//RS 
//RS #[test]
//RS fn durable_delivery_does_not_corrupt_the_event_log_default_run() {
//RS     let (code, stdout, stderr) = run_default_multi(
//RS         "services_durable_eventlog_jit",
//RS         "main.jet",
//RS         &[("main.jet", DURABLE_PLUS_EVENT_LOG_SOURCE)],
//RS     );
//RS     assert_eq!(code, 0, "default jet run failed: {stderr}");
//RS     assert_eq!(stdout, "events:2\n");
//RS }
//RS 
//RS /// #1149: the snapshot and event-log adapters must survive a reopen and refuse
//RS /// a store they cannot trust. The state store is framed with a magic line, an
//RS /// adapter line and a schema line, so garbage in the file has to surface as a
//RS /// typed error rather than a panic or a silently empty restore.
//RS const STATE_ADAPTER_SOURCE: &str = r#"
//RS use core.files as files
//RS use core.service as services
//RS use core.testing as testing
//RS 
//RS fn adapter_worker() {}
//RS 
//RS fn run() {
//RS     temp := testing.temp_dir("services-state-adapters")
//RS 
//RS     snapshot_path :: Path.from(temp).join("snapshot.log").to_string()
//RS     snap_tree := services.tree("snap")
//RS     snap_store :: services.state_store(snapshot_path) ?? panic("snapshot store")
//RS     snap_tree.set_state_snapshot(snap_store, "app-state", 1, "reversible") ?? panic("snapshot adapter")
//RS     _snap_worker :: snap_tree.worker("a", adapter_worker, capacity: 2) ?? panic("snapshot worker")
//RS     snap_tree.start() ?? panic("snapshot start")
//RS     snap_tree.commit_snapshot("state-v1") ?? panic("commit")
//RS     print("restored:{snap_tree.restore_snapshot() ?? panic("restore")}")
//RS 
//RS     event_path :: Path.from(temp).join("events.log").to_string()
//RS     log_tree := services.tree("log")
//RS     log_store :: services.state_store(event_path) ?? panic("event store")
//RS     log_tree.set_state_event_log(log_store, "app-events", 1, "reversible") ?? panic("event adapter")
//RS     _log_worker :: log_tree.worker("a", adapter_worker, capacity: 2) ?? panic("event worker")
//RS     log_tree.start() ?? panic("event start")
//RS     log_tree.append_event("first") ?? panic("first event")
//RS     log_tree.append_event("second") ?? panic("second event")
//RS     print("replay:{log_tree.replay_events()}")
//RS 
//RS     // A store the runtime cannot trust must fail closed, not restore nothing.
//RS     files.write(snapshot_path, "not a service state store") ?? panic("corrupt write")
//RS     corrupted :: snap_tree.restore_snapshot()
//RS     if corrupted == {
//RS         .Ok(_) -> { print("corrupt:accepted") }
//RS         .Err(_) -> { print("corrupt:rejected") }
//RS     }
//RS }
//RS "#;
//RS 
//RS #[test]
//RS fn state_adapters_reopen_and_reject_corrupt_stores_aot() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let (code, stdout) = build_and_run("services_state_adapters", STATE_ADAPTER_SOURCE);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(
//RS         stdout,
//RS         "restored:state-v1\nreplay:first|second\ncorrupt:rejected\n"
//RS     );
//RS }
//RS 
//RS #[test]
//RS fn state_adapters_reopen_and_reject_corrupt_stores_default_run() {
//RS     let (code, stdout, stderr) = run_default_multi(
//RS         "services_state_adapters_jit",
//RS         "main.jet",
//RS         &[("main.jet", STATE_ADAPTER_SOURCE)],
//RS     );
//RS     assert_eq!(code, 0, "default jet run failed: {stderr}");
//RS     assert_eq!(
//RS         stdout,
//RS         "restored:state-v1\nreplay:first|second\ncorrupt:rejected\n"
//RS     );
//RS }
//RS 
//RS /// The rollback path only does real work when the tree has a state adapter.
//RS /// With no adapter, `prepare_rollback` returns early and `restore_rollback`
//RS /// never touches the store, so a rollback test on a bare tree proves nothing
//RS /// about the durable body. This sets an adapter first, so the upgrade really
//RS /// copies the store aside and the rollback reads it back.
//RS const ROLLBACK_WITH_STATE_SOURCE: &str = r#"
//RS use core.sys as env
//RS use core.service as services
//RS 
//RS fn rollback_worker() {}
//RS 
//RS fn run() {
//RS     store_path :: env.get("JET_SERVICE_ROLLBACK_STORE") ?? panic("store")
//RS     policy :: env.get("JET_SERVICE_ROLLBACK_POLICY") ?? panic("policy")
//RS     tree := services.tree("cluster")
//RS     store :: services.state_store(store_path) ?? panic("state store")
//RS     tree.set_state_event_log(store, "cluster-events", 1, policy) ?? panic("state")
//RS     endpoint :: tree.worker("api", rollback_worker, capacity: 1) ?? panic("worker")
//RS     tree.start() ?? panic("start")
//RS     tree.append_event("before-upgrade") ?? panic("append")
//RS     tree.directory_register("api", endpoint) ?? panic("register")
//RS     tree.drain_worker(endpoint) ?? panic("drain")
//RS     tree.handoff_generation() ?? panic("handoff")
//RS     receipt :: tree.upgrade_receipt() ?? panic("receipt")
//RS     print("receipt:{receipt}")
//RS     tree.append_event("after-upgrade") ?? panic("append after")
//RS     rolled :: tree.rollback_generation()
//RS     if rolled == {
//RS         .Ok(generation) -> {
//RS             events :: tree.replay_events()
//RS             print("rolled:{generation}:{events}")
//RS         }
