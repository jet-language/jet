// Rust: tests/services_runtime.rs:343
fn compile_restart_binary(source: String) -> (OSPath, OSPath) {
    serial :: RESTART_SEQ.fetch_add(1, Ordering.Relaxed)
    dir :: env.temp_dir().join("jet_service_restart_{process.id()}_{serial}")
    fs.create_dir_all(&dir).unwrap()
    jet_path :: dir.join("restart.jet")
    fs.write(&jet_path, source).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: jet.compile_with_path(source, shown).unwrap_or_else(diags -> {
        panic("front end rejected:\n{jet.render_diagnostics(shown, source, diags)}")
    })
    rs :: dir.join("restart.rs")
    bin :: dir.join("restart")
    fs.write(&rs, out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if out.ffi != None {
        link :: out.ffi.unwrap()
        rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(dir -> dir.is_dir()) {
            rustc.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    result :: rustc.output().unwrap()
    assert(result.status.success(), "rustc rejected generated restart code:\n{String.from_utf8_lossy(result.stderr)}")
    (dir, bin)
}

// Rust: tests/services_runtime.rs:390
fn run_restart_process(bin: &OSPath, store: &OSPath, phase: String, id: String?) -> String {
    command := Command.new(bin)
    command.env("JET_SERVICE_AUTH_STORE", store).env("JET_SERVICE_AUTH_PHASE", phase)
    if id != None { command.env("JET_SERVICE_AUTH_ID", id.unwrap()) }
    output :: command.output().unwrap()
    assert(output.status.success(), "restart process failed: {String.from_utf8_lossy(output.stderr)}")
    String.from_utf8_lossy(output.stdout).into_owned()
}

// Rust: tests/services_runtime.rs:407
fn run_restart_default_process(dir: &OSPath, store: &OSPath, phase: String, id: String?) -> String {
    command := Command.new(env.cargo_bin_exe("jet"))
    command.args(["run", "restart.jet", "--trace-tiers"]).current_dir(dir).env("NO_COLOR", "1")
        .env("JET_SERVICE_AUTH_STORE", store).env("JET_SERVICE_AUTH_PHASE", phase)
    if id != None { command.env("JET_SERVICE_AUTH_ID", id.unwrap()) }
    output :: command.output().unwrap()
    assert(output.status.success(), "default restart process failed: {String.from_utf8_lossy(output.stderr)}")
    String.from_utf8_lossy(output.stdout).into_owned()
}

