fn rollout_worker() -> {}

fn run() -> {
    store_path :: env.get("JET_SERVICE_AUTH_STORE") ?? panic("store")
    phase :: env.get("JET_SERVICE_AUTH_PHASE") ?? panic("phase")
    tree := services.tree("rollout-restart")
