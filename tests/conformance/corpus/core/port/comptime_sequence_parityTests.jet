// Rust: tests/comptime_sequence_parity.rs:254
#Test("sequence_return_shapes_match_rustc_backed_aot") {
    cases :: [
        ("scalar", ``, `[1, 2, 3].all((n: Int) -> n > 0)`),
        ("float-literal-receiver", ``, `[1.5, 2.5].all((n: Float) -> n > 1.0)`),
        ("bool-literal-receiver", ``, `[true, false].any((b: Bool) -> b)`),
        ("float-fold-seed", ``, `[1.5, 2.5].fold(0.5, (a: Float, n: Float) -> a + n)`),
        ("bool-fold-seed", ``, `[true, false].fold(true, (a: Bool, b: Bool) -> a && b)`),
        ("float-reduce-seed", ``, `[1.5, 2.5].reduce(0.5, (a: Float, n: Float) -> a + n)`),
        ("bool-scan-seed", ``, `[true, false].scan(true, (a: Bool, b: Bool) -> a && b)`),
        ("float-para-fold-seed", ``, `[1.5, 2.5].para_fold(() -> 0.5, (a: Float, n: Float) -> a + n, (left: Float, right: Float) -> left + right)`),
        ("empty-float-sum", `fn empty_sum() -> Float {
    empty :: [Float]{}
    return empty.sum()
}`, `empty_sum()`),
        ("empty-float-product", `fn empty_product() -> Float {
    empty :: [Float]{}
    return empty.product()
}`, `empty_product()`),
        ("f32-nonempty-sum", `fn f32_values() -> [F32] { return [16777217.0, 1.0, 1.0] }`, `f32_values().sum()`),
        ("f32-nonempty-product", `fn f32_values() -> [F32] { return [16777217.0, 2.0] }`, `f32_values().product()`),
        ("f32-fold", `fn f32_values() -> [F32] { return [16777217.0, 1.0] }
fn f32_zero() -> F32 { return 0.0 }`, `f32_values().fold(f32_zero(), (a: F32, n: F32) -> a + n)`),
        ("f32-map", `fn f32_values() -> [F32] { return [16777217.0, 1.0] }
fn f32_one() -> F32 { return 1.0 }`, `f32_values().map((n: F32) -> n + f32_one())`),
        ("f32-min", `fn f32_values() -> [F32] { return [16777217.0, 1.0] }`, `f32_values().min()`),
        ("f32-max", `fn f32_values() -> [F32] { return [16777217.0, 1.0] }`, `f32_values().max()`),
        ("empty-f32-sum", `fn empty_f32_sum() -> F32 {
    empty :: [F32]{}
    return empty.sum()
}`, `empty_f32_sum()`),
        ("empty-f32-product", `fn empty_f32_product() -> F32 {
    empty :: [F32]{}
    return empty.product()
}`, `empty_f32_product()`),
        ("optional", ``, `[3, 1, 2].min()`), ("owned-list", ``, `[1, 2, 3].take(2)`), ("nested-list", ``, `[1, 2, 3, 4].chunks(3)`),
        ("map", ``, `[1, 2, 3].group_by((n: Int) -> "{n % 2}")`),
        ("tuple", ``, `[(a: 1, b: "x"), (a: 2, b: "y")].unzip().a`),
        ("result", ``, `[Int.parse("1"), Int.parse("2")].try_collect() ?? []`),
        ("view", `fn view_sum(xs: [Int]) -> Int {
    view :: xs[0..1]
    return view.fold(0, (a: Int, n: Int) -> a + n)
}`, `view_sum([10, 20, 30])`),
        ("range-fixed-index", `Die :: distinct Int(1..6)
fn pick(faces: [Int#6], roll: Die) -> Int {
    return faces[roll.raw() - 1]
}`, `pick([0, 1, 2, 3, 4, 5], Die.from_int(3))`)
    ]
    for (index, (name, preamble, expression)) in cases.iter().enumerate() { check_aot_comptime(index, name, preamble, expression) }
}

// Rust: tests/core_units_foundations.rs:7
#Test("core_units_conversion_rejects_nonfinite_and_zero_targets") {
    tir_support.assert_tiers_agree("core_units_conversion_hostile_targets", `
use core.units as units

fn run() -> {
    measured :: measurement(12.0, uncertainty: 0.5)
    converted :: units.convert(measured, 1000.0)
    print(units.show(converted))
    print(units.to_si(units.convert(measured, Float.NAN)) == 12.0)
    print(units.to_si(units.convert(measured, Float.INFINITY)) == 12.0)
    print(units.to_si(units.convert(measured, Float{0.0})) == 12.0)
    huge :: units.convert(measurement(Float.MAX, uncertainty: 1.0), 0.5)
    print(units.to_si(huge) == Float.MAX)
}
`, "0.012 ± 0.0005\ntrue\ntrue\ntrue\ntrue\n")
}

// Rust: tests/corelib_net.rs:9
#Test("core_net_socket_address_values_match_aot_default_and_interpreter") {
    scratch :: common.Scratch.new("core_net_socket_address_tiers")
    dir :: &scratch.path
    source :: `
use core.net as net

fn run() -[IO, Net, Time.Wait]> {
    address :: net.socket_addr("::1", 53) ?? panic("socket address")
    print(net.socket_to_string(address))
    if net.socket_addr("::1", 65536) == {
        .Ok(_) -> panic("out-of-range port succeeded")
        .Err(error) -> {
            print(net.error_operation(error))
            print(net.error_address(error) ?? "missing address")
            print(net.error_message(error))
            if error == {
                .InvalidInput(_) -> { print("invalid-input") }
                else -> { panic("wrong network error kind") }
            }
        }
    }
}
`
    expected :: "[::1]:53\nsocket_addr\n::1\nport must be in 0..=65535\ninvalid-input\n"
    (code, aot_stdout, stderr) :: build_and_run(dir, "net_socket_address_tiers", source, [], None)
    assert_eq(code, 0, stderr)
    assert_eq(aot_stdout, expected)
    file :: dir.join("net_socket_address_tiers.jet")
    fs.write(file, source).unwrap()
    fs.write(dir.join("package.jet"), "name: \"net_socket_address_tiers\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc, Net, Time.Wait] } }\n").unwrap()
    tir_support.assert_tiers_agree("net_socket_address_tiers", source, aot_stdout)
}

// Rust: tests/corelib_platform_email.rs:7
#Test("core_email_address_rejects_domain_labels_over_63_bytes") {
    scratch :: common.Scratch.new("email-domain-labels")
    dir :: &scratch.path
    src :: `
use core.email as email

fn run() -> {
    label_63 := "a".repeat(63)
    valid :: email.address("person@{label_63}.example") ?? panic("valid 63-byte domain label rejected")
    print(valid.mailbox == "person@{label_63}.example")
    label_64 := "a".repeat(64)
    if email.address("person@{label_64}.example") == {
        .Ok(_) -> panic("64-byte domain label accepted")
        .Err(_) -> print("overlong-label-rejected")
    }
}

`
    expected :: "true\noverlong-label-rejected"
    (code, stdout, stderr) :: build_and_run(dir, "email_domain_labels", src, [], None)
    assert_eq(code, 0, "stderr: {stderr}")
    assert_eq(stdout.trim(), expected, stdout)
    fs.write(dir.join("email_domain_labels.jet"), src).unwrap()
    tir_support.assert_tiers_agree("email_domain_labels", src, expected + "\n")
}

// Rust: tests/crypto_c12.rs:27
#Test("nominal_crypto_roles_are_rejected_during_compilation") {
    assert_single_type_error(`use core.crypto as crypto

fn run() -> {
    recipient :: crypto.X25519SecretKey.new_random() ?? return
    crypto.sign(recipient, [1, 2, 3]) ?? return
}
`, ["SigningKey", "X25519SecretKey"])
    assert_single_type_error(`use core.crypto as crypto

fn run() -> {
    signing :: crypto.SigningKey.new_random() ?? return
    recipient :: crypto.X25519SecretKey.new_random() ?? return
    sealed :: crypto.seal([recipient.public_key()], [1, 2, 3], []) ?? return
    crypto.open(signing, sealed, []) ?? return
}
`, ["X25519SecretKey", "SigningKey"])
}

// Rust: tests/crypto_c12.rs:54
#Test("typed_crypto_matches_aot_in_default_dev_with_honest_jit_boundary") {
    fs.create_dir_all(std.env.temp_dir()).unwrap()
    path :: "Examples/features/crypto/typed_crypto.jet"
    source :: fs.read_to_string(path).unwrap()
    expected :: fs.read_to_string("Examples/features/expected/crypto/typed_crypto.out").unwrap()
    bundle := jet.Loader.load_entry(path).expect("typed crypto bundle loads")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter(diagnostic -> diagnostic.severity == Severity.Error).collect()
    assert(errors.is_empty(), "typed crypto must type-check: {errors:Debug}")
    // Resident JIT and emitted Rust bridge representation checks cut over to
    // actual O0/O1/O2/Web crypto behavior using canonical native providers.
    (aot_code, aot_stdout, aot_stderr) :: common.build_and_run("jet_crypto_c12", "typed_crypto", source)
    assert_eq(aot_code, 0)
    assert_eq(aot_stderr, "")
    assert_eq(aot_stdout, expected)
    tir_support.assert_tiers_agree("typed_crypto_c12", source, expected)
}

// Rust: tests/crypto_diagnostics.rs:18
#Test("e2702_json_exits_one_and_creates_no_artifact") {
    root :: crypto_diagnostics.scratch()
    fs.write(root.join("main.jet"), `use core.crypto as crypto
fn run() -> {
    safe :: crypto.hkdf_sha256(
        crypto.Secret.from_bytes([1]), [], [], 8161
    )
}
`).unwrap()
    output :: Command.new(common.jet_bin()).args(["check", "main.jet", "--json"]).current_dir(root).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Val(1))
    assert(output.stdout.is_empty())
    json :: String.from_utf8(output.stderr).unwrap()
    assert(json.starts_with("{\"schema\":\"jet.report/v1\",\"moment\":\"compile\""), json)
    for field in ["\"code\":\"E2702\"", "\"what\":\"crypto API misuse\"", "\"reason\":\"output_length\"", "\"operation\":\"hkdf_sha256\"",
        "\"expected\":\"0..8160\"", "\"actual\":8161", "\"span\":", "\"cause\":[],\"clears\":0"] {
        assert(json.contains(field), "missing {field}: {json}")
    }
    for forbidden in ["password", "plaintext", "ciphertext", "backend", "rustc", "dependency"] {
        assert(!json.contains(forbidden), "leaked `{forbidden}`: {json}")
    }
    assert(!root.join(".jet").join("build").exists(), "check emitted a build artifact")
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/crypto_diagnostics.rs:75
#Test("e2702_json_redacts_an_absolute_input_to_its_project_path") {
    root :: crypto_diagnostics.scratch()
    project :: root.join("project")
    source_dir :: project.join("src")
    fs.create_dir_all(project.join(".git")).unwrap()
    fs.create_dir_all(source_dir).unwrap()
    source :: source_dir.join("main.jet")
    fs.write(source, `use core.crypto as crypto
fn run() -> {
    _ :: crypto.hkdf_sha256(crypto.Secret.from_bytes([1]), [], [], 8161)
}
`).unwrap()
    output :: Command.new(common.jet_bin()).arg("check").arg(source).arg("--json").current_dir(root).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Val(1))
    json :: String.from_utf8(output.stderr).unwrap()
    assert(json.contains("\"file\":\"src/main.jet\""), json)
    assert(!json.contains(root.to_string_lossy().into_owned()), "absolute path leaked: {json}")
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/crypto_diagnostics.rs:111
#Test("multiple_e2702_diagnostics_are_independent_json_lines") {
    root :: crypto_diagnostics.scratch()
    fs.write(root.join("main.jet"), `use core.crypto as crypto
fn first() -> {
    _ :: crypto.hkdf_sha256(crypto.Secret.from_bytes([1]), [], [], 8161)
}
fn second() -> {
    _ :: crypto.hkdf_sha256(crypto.Secret.from_bytes([2]), [], [], 8162)
}
fn run() -> {}
`).unwrap()
    output :: Command.new(common.jet_bin()).args(["check", "main.jet", "--json"]).current_dir(root).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Val(1))
    assert(output.stdout.is_empty())
    json :: String.from_utf8(output.stderr).unwrap()
    lines :: json.lines().collect()
    assert_eq(lines.len(), 2, json)
    for (line, actual) in lines.into_iter().zip([8161, 8162]) {
        assert(line.starts_with("{\"schema\":\"jet.report/v1\",\"moment\":\"compile\""), line)
        assert(line.contains("\"code\":\"E2702\""), line)
        assert(line.contains("\"reason\":\"output_length\""), line)
        assert(line.contains("\"operation\":\"hkdf_sha256\""), line)
        assert(line.contains("\"actual\":{actual}"), line)
    }
    assert(!root.join(".jet").join("build").exists(), "check emitted a build artifact")
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/crypto_diagnostics.rs:156
#Test("safe_raw_nonce_json_omits_inapplicable_bounds") {
    root :: crypto_diagnostics.scratch()
    fs.write(root.join("main.jet"), `use core.crypto as crypto
fn run() -> {
    _ :: crypto.seal([], [], [], nonce: [0])
}
`).unwrap()
    output :: Command.new(common.jet_bin()).args(["check", "main.jet", "--json"]).current_dir(root).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Val(1))
    json :: String.from_utf8(output.stderr).unwrap()
    assert(json.contains("\"reason\":\"raw_nonce\""), json)
    assert(json.contains("\"operation\":\"seal\""), json)
    assert(!json.contains("\"expected\":"), json)
    assert(!json.contains("\"actual\":"), json)
    assert(!root.join(".jet").join("build").exists(), "check emitted a build artifact")
    fs.remove_dir_all(root).unwrap()
}

