// Rust: tests/encoding_edition.rs:32
#Test("edition_2027_base64_strict_rejects_whitespace_without_allowance_surface") {
    root :: edition.scratch("2027_b64_strict")
    path :: edition.write_project(root, "2027", `use core.encoding.base64 as base64

fn run() -> {
    if base64.decode("Zg==\n") == {
        .Ok(_) -> print("accepted")
        .Err(reason) -> print(reason)
    }
}
`)
    diags :: check_with_path(path.to_str().unwrap())
    assert(diags.is_empty(), "edition 2027 1-arg decode must type-check:\n{render_diagnostics(path.to_str().unwrap(), "", diags)}")
    allow_root :: edition.scratch("2027_b64_allow_gap")
    allow_path :: edition.write_project(allow_root, "2027", `use core.encoding.base64 as base64

fn run() -> {
    bytes := base64.decode("Zg==\n", true, false) ?? panic("decode")
    print(bytes.len())
}
`)
    allow_diags :: check_with_path(allow_path.to_str().unwrap())
    assert(allow_diags.iter().any(d -> d.code == "E0104"),
        "named gap: 2027 allowance args must not silently type-check until wired; got:\n{render_diagnostics(allow_path.to_str().unwrap(), "", allow_diags)}")
}

