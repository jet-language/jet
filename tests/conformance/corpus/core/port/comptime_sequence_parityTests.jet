// Rust: tests/encoding_edition.rs:130
#Test("edition_2027_cbor_decode_emits_l2001_and_2028_removes_it") {
    source :: `use core.encoding.cbor as cbor

fn run() -> {
    decoded := cbor.decode([U8]{ 0x81, 0x01 }) ?? panic("decode")
    print(decoded)
}
`
    before :: edition.scratch("2027_cbor_decode")
    before_path :: edition.write_project(before, "2027", source)
    before_diags :: check_with_path(before_path.to_str().unwrap())
    assert(before_diags.iter().any(diagnostic -> diagnostic.code == "L2001"),
        "expected L2001 for cbor.decode, got: {render_diagnostics(before_path.to_str().unwrap(), "", before_diags)}")
    after :: edition.scratch("2028_cbor_decode")
    after_path :: edition.write_project(after, "2028", source)
    after_diags :: check_with_path(after_path.to_str().unwrap())
    assert(after_diags.iter().any(diagnostic -> diagnostic.code == "E2002"),
        "expected E2002 after cbor.decode removal, got: {render_diagnostics(after_path.to_str().unwrap(), "", after_diags)}")
}

// Rust: tests/encoding_edition.rs:156
#Test("user_deprecated_marker_emits_l2001_for_a_consumer") {
    root :: edition.scratch("user_deprecated")
    path :: edition.write_project(root, "2027", `#Deprecated(since: "1.2", use: "parse")
pub fn decode() -> {}

fn run() -> {
    decode()
}
`)
    diags :: check_with_path(path.to_str().unwrap())
    assert(diags.iter().any(diagnostic -> diagnostic.code == "L2001" && diagnostic.what.contains("`decode`")),
        "expected L2001 for a user #Deprecated function, got: {render_diagnostics(path.to_str().unwrap(), "", diags)}")
    removed_root :: edition.scratch("user_removed")
    removed_path :: edition.write_project(removed_root, "2028", `#Deprecated(since: "2027", use: "parse", removed_in: "2028")
pub fn decode() -> {}

fn run() -> {
    decode()
}
`)
    removed_diags :: check_with_path(removed_path.to_str().unwrap())
    assert(removed_diags.iter().any(diagnostic -> diagnostic.code == "E2002" && diagnostic.what.contains("`decode`")),
        "expected E2002 after the user marker removal edition, got: {render_diagnostics(removed_path.to_str().unwrap(), "", removed_diags)}")
    before_root :: edition.scratch("user_removed_dormant")
    before_path :: edition.write_project(before_root, "2026", `#Deprecated(since: "2027", use: "parse", removed_in: "2028")
pub fn decode() -> {}

fn run() -> {
    decode()
}
`)
    before_diags :: check_with_path(before_path.to_str().unwrap())
    assert(before_diags.iter().all(diagnostic -> diagnostic.code != "L2001" && diagnostic.code != "E2002"),
        "removed_in must stay dormant before the deprecation edition: {render_diagnostics(before_path.to_str().unwrap(), "", before_diags)}")
}

// Rust: tests/encoding_edition.rs:204
#Test("lifecycle_marker_metadata_erases_before_web_codegen") {
    source :: `#Deprecated(since: "2027", use: "replacement", removed_in: "2028")
pub fn legacy() -> { print("legacy") }
pub fn replacement() -> { print("replacement") }

fn run() -> {
    replacement()
}
`
    output :: jet.compile_web_with_path(source, "tests/fixtures/lifecycle_marker_web.jet").expect("user lifecycle marker must compile for web")
    web :: output.web.expect("user lifecycle marker must produce web artifacts")
    assert(!web.wasm_rust.contains("Deprecated"))
    assert(!web.js_app.contains("Deprecated"))
}

// Rust: tests/encoding_edition.rs:216
#Test("deprecation_fix_replaces_plain_and_core_member_names") {
    root :: edition.scratch("deprecation_fix")
    path :: edition.write_project(root, "2027", `#Deprecated(since: "2027", use: "parse")
pub fn decode() -> {}
pub fn parse() -> {}

fn run() -> {
    decode()
}
`)
    output :: Command.new(common.jet_bin()).args(["fix", path.to_str().unwrap()]).env("NO_COLOR", "1").output().unwrap()
    assert(output.status.success(), "user deprecation fix failed:\n{String.from_utf8_lossy(output.stderr)}")
    assert(fs.read_to_string(path).unwrap().contains("    parse()"), "plain replacement was not applied")
    cbor_root :: edition.scratch("cbor_deprecation_fix")
    cbor_path :: edition.write_project(cbor_root, "2027", `use core.encoding.cbor as cbor
use core.encoding.json as json

fn run() -> {
    tree := json.parse("{{}}") ?? panic("json")
    payload := cbor.encode(tree)
    print("ok")
}
`)
    output_cbor :: Command.new(common.jet_bin()).args(["fix", cbor_path.to_str().unwrap()]).env("NO_COLOR", "1").output().unwrap()
    assert(output_cbor.status.success(), "Core deprecation fix failed:\n{String.from_utf8_lossy(output_cbor.stderr)}")
    assert(fs.read_to_string(cbor_path).unwrap().contains("payload := cbor.to_bytes(tree)"), "Core replacement was not applied")
}
