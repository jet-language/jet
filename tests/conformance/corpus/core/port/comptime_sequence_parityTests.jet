// Rust: tests/comptime_sequence_parity.rs:11
#Test("parallel_adapters_match_forced_interpreter_and_default_jit_dev") {
    source :: `fn run() -> {
    values :: [1, 2, 3, 4]
    print(values.para_map((n: Int) -> n * 2))
    print(values.para_filter((n: Int) -> n % 2 == 0))
    split :: values.para_partition((n: Int) -> n % 2 == 0)
    print(split.false_)
    print(split.true_)
    print(values.para_fold(() -> 0, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right))
}
`
    tir_support.assert_tiers_agree("jet_para_dev_matrix", source, "[2, 4, 6, 8]\n[2, 4]\n[1, 3]\n[2, 4]\n10\n")
}

// Rust: tests/comptime_sequence_parity.rs:44
#Test("repl_list_and_fixed_list_sequence_methods_are_exact") {
    out :: run_transcript([
        `[1, 2, 3].all((n: Int) -> n > 0)`,
        `[1, 2, 3].any((n: Int) -> n == 2)`,
        `[1, 2, 3, 4, 5].chunks(2)`,
        `[1, 2, 3, 4].count_by((n: Int) -> "{n % 2}")`,
        `[1, 1, 2, 2, 1].dedup()`,
        `[4, 5].indexed()`,
        `["1", "bad", "2"].filter_map((s: String) -> Int.parse(s))`,
        `[7, 8].first()`,
        `[1, 2, 3].flat_map((n: Int) -> [n, n * 10])`,
        `[[1, 2], [3], [4, 5]].flatten()`,
        `[1, 2, 3].fold(10, (acc: Int, n: Int) -> acc + n)`,
        `[1, 2, 3, 4].group_by((n: Int) -> "{n % 2}")`,
        `[4, 5, 6].index_of(5)`,
        `inserted := [1, 3]`, `inserted.insert(1, 2)`, `inserted`,
        `[1, 2, 3].intersperse(0)`, `[7, 8].last()`, `[3, 9, 2].max()`,
        `["bbb", "a", "cc"].max_by((s: String) -> s.len())`, `[3, 9, 2].min()`,
        `["bbb", "a", "cc"].min_by((s: String) -> s.len())`,
        `[true, false, true].min()`, `[true, false, true].max()`,
        `[true, false, true].min_by((b: Bool) -> b)`, `[true, false, true].max_by((b: Bool) -> b)`,
        `[1, 2, 3, 4].para_filter((n: Int) -> n % 2 == 0)`,
        `[1, 2, 3].para_fold(() -> 0, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right)`,
        `[1, 2, 3].para_map((n: Int) -> n * 2)`,
        `[1, 2, 3, 4].para_partition((n: Int) -> n % 2 == 0)`,
        `[1, 2, 3, 4].partition((n: Int) -> n % 2 == 0)`,
        `[4, 5, 6].position((n: Int) -> n == 5)`, `[2, 3, 4].product()`,
        `[1, 2, 3].scan(0, (acc: Int, n: Int) -> acc + n)`, `[1, 2, 3, 4].skip(2)`,
        `[1, 2, 3, 4].skip_while((n: Int) -> n < 3)`, `[1, 2, 3, 4, 5].step_by(2)`, `[1, 2, 3, 4].sum()`,
        `[1, 2, 3, 4].take(2)`, `[1, 2, 3, 4].take_while((n: Int) -> n < 3)`,
        `["1", "2"].map((s: String) -> Int.parse(s)).try_collect()`,
        `[(a: 1, b: "x"), (a: 2, b: "y")].unzip()`, `[1, 2, 3, 4].windows(3)`, `[1, 2, 3].zip(["a", "b"])`,
        `fixed: [Int#4] :: [1, 2, 3, 4]`, `fixed.all((n: Int) -> n > 0)`, `fixed.chunks(3)`,
        `fixed.fold(0, (acc: Int, n: Int) -> acc + n)`, `fixed.zip([9, 8, 7])`
    ], None)
    expected :: [
        "true : Bool", "true : Bool", "[[1, 2], [3, 4], [5]] : List", "[0: 2, 1: 2] : Map", "[1, 2, 1] : List",
        "[(idx,item)(idx: 0, item: 4), (idx,item)(idx: 1, item: 5)] : List", "[1, 2] : List", "7 : Option",
        "[1, 10, 2, 20, 3, 30] : List", "[1, 2, 3, 4, 5] : List", "16 : Int", "[0: [2, 4], 1: [1, 3]] : Map",
        "1 : Option", "[1, 2, 3] : List", "[1, 0, 2, 0, 3] : List", "8 : Option", "9 : Option", "bbb : Option", "2 : Option", "a : Option",
        "false : Option", "true : Option", "false : Option", "true : Option", "[2, 4] : List", "6 : Int", "[2, 4, 6] : List",
        "(false_,true_)(false_: [1, 3], true_: [2, 4]) : (false_,true_)", "(false_,true_)(false_: [1, 3], true_: [2, 4]) : (false_,true_)",
        "1 : Option", "24 : Int", "[1, 3, 6] : List", "[3, 4] : List", "[3, 4] : List", "[1, 3, 5] : List", "10 : Int",
        "[1, 2] : List", "[1, 2] : List", "[1, 2] : Result", "(a,b)(a: [1, 2], b: [x, y]) : (a,b)",
        "[[1, 2, 3], [2, 3, 4]] : List", "[(a,b)(a: 1, b: a), (a,b)(a: 2, b: b)] : List", "true : Bool",
        "[[1, 2, 3], [4]] : List", "10 : Int", "[(a,b)(a: 1, b: 9), (a,b)(a: 2, b: 8), (a,b)(a: 3, b: 7)] : List"
    ]
    actual :: out.lines().filter(line -> !line.starts_with("inserted:") && !line.starts_with("fixed:")).collect()
    assert_eq(actual, expected, "full REPL output:\n{out}")
    assert(!out.contains("E0956"), "sequence method fell through: {out}")
}

// Rust: tests/comptime_sequence_parity.rs:162
#Test("repl_eager_collection_adapters_and_lazy_opt_in_are_exact") {
    out :: run_transcript([`values := [1, 2, 3]`, `values.map((n: Int) -> n * 2)`,
        `values.filter((n: Int) -> n > 1)`, `values.lazy().map((n: Int) -> n * 10).to_list()`], None)
    actual :: out.lines().filter(line -> !line.starts_with("values:")).collect()
    assert_eq(actual, ["[2, 4, 6] : List", "[2, 3] : List", "[10, 20, 30] : List"], "REPL eager/lazy output:\n{out}")
}

// Rust: tests/comptime_sequence_parity.rs:184
#Test("repl_view_and_view_mut_sequence_methods_are_exact") {
    out :: run_transcript([
        `values := [10, 20, 30, 40]`, `view :: values[1..3]`, `view.len()`, `view.is_empty()`, `view.get(1)`,
        `view.first()`, `view.last()`, `view.contains(30)`, `view.index_of(40)`,
        `view.fold(0, (acc: Int, n: Int) -> acc + n)`, `view.map((n: Int) -> n / 10)`,
        `edit :: &values[0..1]`, `edit.len()`, `edit.is_empty()`, `edit.get(1)`, `edit.first()`, `edit.last()`,
        `edit.contains(20)`, `edit.index_of(20)`, `edit.fold(0, (acc: Int, n: Int) -> acc + n)`, `edit.map((n: Int) -> n / 10)`
    ], None)
    actual :: out.lines().filter(line -> !line.starts_with("values:") && !line.starts_with("view:") && !line.starts_with("edit:")).collect()
    assert_eq(actual, ["3 : Int", "false : Bool", "30 : Option", "20 : Option", "40 : Option", "true : Bool", "2 : Option", "90 : Int", "[2, 3, 4] : List",
        "2 : Int", "false : Bool", "20 : Option", "10 : Option", "20 : Option", "true : Bool", "1 : Option", "30 : Int", "[1, 2] : List"], "full REPL output:\n{out}")
    assert(!out.contains("E0956"), "view method fell through: {out}")
}

