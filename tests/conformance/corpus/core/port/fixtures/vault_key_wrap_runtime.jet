STRESS_CANCEL :: AtomicBool.new(false)
// Rust: tests/fixtures/vault_key_wrap_runtime.rs:17
fn stress_cancelled() -> Bool { STRESS_CANCEL.load(Ordering.SeqCst) }

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:19
fn scratch(tag: String) -> OSPath {
    path :: env.temp_dir().join("jet-vault-key-wrap-{tag}-{process.id()}-{SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}")
    fs.create_dir_all(path.join(".jet")).unwrap()
    path
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:32
fn provision(root: OSPath) -> {
    keys :: root.join("keys")
    fs.create_dir(keys).unwrap()
    (identity, recipient) :: jet_vault_keygen_impl()
    fs.write(keys.join("secrets.identity"), identity).unwrap()
    fs.write(root.join(".jet/secrets-recipients"), "{recipient}\n").unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:40
fn decoded_store(root: OSPath) -> JetVaultStore {
    identity :: fs.read_to_string(root.join("keys/secrets.identity")).unwrap()
    ciphertext :: fs.read(root.join(".jet/secrets.age")).unwrap()
    plaintext :: jet_vault_decrypt_impl(&identity, &ciphertext).unwrap()
    jet_vault_decode_v2(&plaintext).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:47
fn generate<T: JetVaultKey>(root: OSPath, name: String) -> JetVaultKeyRef<T> {
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<T>(root, name).unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "provision test key").unwrap()
    jet_vault_commit_generate_at(root, ^plan, ^write).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:54
fn import<T: JetVaultKey>(root: OSPath, name: String, wrapped: JetWrappedVaultKey, unlock: JetVaultKeyUnlock) -> JetVaultKeyRef<T> JetVaultKeyWrapError! {
    plan :: jet_vault_prepare_import_wrapped_at<T>(root, name, ^wrapped, unlock)?
    write :: jet_vault_authorize_wrapped_import_impl(&plan, "restore wrapped key")?
    jet_vault_commit_import_wrapped_at(root, ^write, ^plan)
}
