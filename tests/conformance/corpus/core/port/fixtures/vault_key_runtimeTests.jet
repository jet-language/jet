// Rust: tests/fixtures/vault_key_runtime.rs:380
#Test("stale_lock_requires_age_owner_dead_pid_nonce_and_unchanged_store") {
    root :: scratch("stale-lock")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    lock :: root.join(".jet/.secrets.age.lock")
    fs.write(&lock, "repo={vault_uuid_hex(&plan.repo_uuid)} revision=0 pid=999999 process-start=1 nonce=11111111111111111111111111111111 hash={hex_bytes(&plan.start_hash)}\n").unwrap()
    old :: SystemTime.now() - Duration.from_secs(601)
    fs.File.open(&lock).unwrap().set_times(fs.FileTimes.new().set_modified(old)).unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "recover stale lock").unwrap()
    assert_eq(jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap().generation(), 1)
    assert(not lock.exists())
    assert(not fs.read_dir(root.join(".jet")).unwrap().any(|entry| -> entry.unwrap().file_name().to_string_lossy().contains("lock.stale")))
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:409
#Test("lock_drop_never_unlinks_an_inode_substituted_after_its_check") {
    root :: scratch("lock-substitution")
    provision(&root)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    guard :: vault_acquire_lock(&root, plan.repo_uuid, plan.start_revision, plan.start_hash).unwrap()
    lock :: root.join(".jet/.secrets.age.lock")
    jet_vault_set_test_fault(Some("substitute-lock-after-check"))
    drop(^guard)
    jet_vault_set_test_fault(None)
    replacement_inode :: fs.metadata(&lock).unwrap().ino()
    assert_eq(fs.read(&lock).unwrap(), b"replacement")
    assert_eq(fs.metadata(&lock).unwrap().ino(), replacement_inode)
    acquired :: root.join(".jet/.secrets.age.lock.acquired")
    assert_ne(fs.metadata(&acquired).unwrap().ino(), replacement_inode)
    fs.remove_dir_all(root).unwrap()
}

