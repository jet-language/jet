// Rust: tests/fixtures/vault_key_runtime.rs:122
#Test("jvlt2_codec_is_canonical_bounded_and_preserves_legacy_strings") {
    store := JetVaultStore.new([7; 16])
    store.revision = 1
    store.strings.push(("db_password", "hunter2"))
    bytes :: jet_vault_encode_v2(&store).unwrap()
    assert_eq(bytes.len(), 100)
    assert_eq(bytes[..4], b"JVLT")
    assert_eq(bytes[4], 2)
    assert_eq(bytes[68..], vault_hash([b"JVLT2 payload", bytes[..68]]))
    assert_eq(jet_vault_decode_v2(&bytes).unwrap(), store)
    trailing := bytes.clone()
    trailing.push(0)
    assert_eq(jet_vault_decode_v2(&trailing).unwrap_err(), JetVaultError.InvalidEncoding)
    assert_eq(jet_vault_validate_name(" ../secret ").unwrap_err(), JetVaultError.InvalidName)
    assert_eq(jet_vault_validate_name("e\u{301}").unwrap_err(), JetVaultError.InvalidName)
    assert(jet_vault_validate_name("é").is_ok())
}

// Rust: tests/fixtures/vault_key_runtime.rs:145
#Test("decoder_rejects_a_downgraded_current_generation") {
    root :: scratch("downgrade")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "first").unwrap()
    jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    plan :: jet_vault_prepare_rotate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "second").unwrap()
    jet_vault_commit_rotate_at(&root, ^plan, ^write).unwrap()
    bytes := jet_vault_encode_v2(&decoded_store(&root)).unwrap()
    current_at :: 44 + 1 + 2 + "release".len()
    bytes[current_at..current_at + 8].copy_from_slice(UInt64(1).to_le_bytes())
    hash_at :: bytes.len() - 32
    hash :: vault_hash([b"JVLT2 payload", bytes[..hash_at]])
    bytes[hash_at..].copy_from_slice(&hash)
    assert_eq(jet_vault_decode_v2(&bytes).unwrap_err(), JetVaultError.InvalidEncoding)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:167
#Test("exact_operation_preview_provider_and_session_are_bound") {
    root :: scratch("binding")
    provision(&root)
    key :: jet_crypto_signing_generate_impl().unwrap()
    plan :: jet_vault_prepare_store_at(&root, "release", ^key).unwrap()
    operation := [] as [UInt8]
    operation.extend_from_slice(b"JVLT2 operation")
    operation.extend_from_slice(&plan.repo_uuid)
    operation.extend_from_slice(plan.start_revision.to_le_bytes())
    operation.extend_from_slice(&plan.start_hash)
    operation.extend_from_slice(&plan.provider_hash)
    operation.extend_from_slice([2, 1])
    operation.extend_from_slice(UInt16(7).to_le_bytes())
    operation.extend_from_slice(b"release")
    operation.push(0)
    operation.extend_from_slice([0; 16])
    operation.extend_from_slice(UInt64(0).to_le_bytes())
    operation.extend_from_slice([0; 16])
    operation.extend_from_slice([0; 32])
    operation.extend_from_slice(UInt16(0).to_le_bytes())
    operation.extend_from_slice(&plan.public_key_hash)
    operation.extend_from_slice(&plan.key_digest)
    operation.extend_from_slice([0; 32])
    assert_eq(plan.operation_hash, vault_hash([&operation]))
    jet_vault_set_test_authorizer(|_| -> true)
    write := jet_vault_authorize_write_impl(&plan, "approved release signer").unwrap()
    preview := [] as [UInt8]
    preview.extend_from_slice(b"JVLT2 authority preview")
    preview.extend_from_slice(&plan.operation_hash)
    preview.extend_from_slice([2, 1])
    preview.extend_from_slice(&plan.repo_uuid)
    preview.extend_from_slice(UInt64(0).to_le_bytes())
    preview.extend_from_slice(UInt16(7).to_le_bytes())
    preview.extend_from_slice(b"release")
    preview.extend_from_slice(UInt64(0).to_le_bytes())
    preview.extend_from_slice(UInt64(1).to_le_bytes())
    preview.extend_from_slice(UInt16(0).to_le_bytes())
    preview.extend_from_slice(UInt16(23).to_le_bytes())
    preview.extend_from_slice(b"approved release signer")
    preview.extend_from_slice(plan.expires_unix_ms.to_le_bytes())
    assert_eq(write.preview_hash, vault_hash([&preview]))
    write.session = write.session.wrapping_add(1)
    assert_eq(jet_vault_commit_store_at(&root, ^plan, ^write).unwrap_err(), JetVaultError.Conflict)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    uuid :: vault_uuid_hex(&plan.repo_uuid)
    trust :: root.join("trust")
    fs.write(&trust, "grant:user:vault.write:{uuid}\n").unwrap()
    jet_vault_set_test_trust_path(Some(trust))
    assert(vault_headless_granted(&plan.repo_uuid))
    jet_vault_set_test_trust_path(None)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:224
#Test("historical_pairs_migrate_with_the_previewed_uuid_and_exact_start_hash") {
    root :: scratch("migration")
    provision(&root)
    identity :: fs.read_to_string(root.join("keys/secrets.identity")).unwrap()
    recipient :: fs.read_to_string(root.join(".jet/secrets-recipients")).unwrap()
    pairs :: [("token", "secret")]
    legacy :: jet_vault_encode_pairs(&pairs)
    recipient_text := recipient.trim() // #4303
    encrypted :: jet_vault_encrypt_impl([recipient_text.to_string()], &legacy).unwrap()
    fs.write(root.join(".jet/secrets.age"), ^encrypted).unwrap()
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    (_, canonical) :: vault_canonical_pairs(pairs.clone()).unwrap()
    assert_eq(plan.start_revision, 0)
    assert_eq(plan.start_hash, vault_hash([b"JVLT1 starting store", &canonical]))
    previewed_uuid :: plan.repo_uuid
    jet_vault_set_test_authorizer(|_| -> true)
    write :: jet_vault_authorize_write_impl(&plan, "migrate and provision").unwrap()
    reference :: jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    store :: decoded_store(&root)
    assert_eq(store.revision, 1)
    assert_eq(store.repo_uuid, previewed_uuid)
    assert_eq(reference.repo_uuid, previewed_uuid)
    assert_eq(store.strings, pairs)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
    _ :: identity
}

// Rust: tests/fixtures/vault_key_runtime.rs:252
#Test("linux_install_cancellation_and_durability_boundaries_are_literal") {
    root :: scratch("faults")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "initial signer").unwrap()
    jet_vault_set_test_fault(Some("cancel-before-install"))
    assert_eq(jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap_err(), JetVaultError.Conflict)
    assert(not root.join(".jet/secrets.age").exists())
    assert(not fs.read_dir(root.join(".jet")).unwrap().any(|entry| -> {
        name :: entry.unwrap().file_name().to_string_lossy()
        name.contains(".next.") or name == ".secrets.age.backup"
    }))
    jet_vault_set_test_fault(Some("cancel-after-install"))
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "initial signer").unwrap()
    first :: jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    assert_eq(first.generation(), 1)
    plan :: jet_vault_prepare_rotate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "rotate with durability fault").unwrap()
    jet_vault_set_test_fault(Some("durability-after-install"))
    assert_eq(jet_vault_commit_rotate_at(&root, ^plan, ^write).unwrap_err(), JetVaultError.DurabilityUnknown)
    assert_eq(decoded_store(&root).revision, 2, "installed revision is visible")
    assert(root.join(".jet/.secrets.age.backup").exists(), "authenticated old inode remains as recovery backup")
    fs.write(root.join(".jet/secrets.age"), b"substituted").unwrap()
    assert_eq(jet_vault_current_at<JetSigningKey>(&root, "release").unwrap(), Some(first))
    assert_eq(decoded_store(&root).revision, 1, "next open restores authenticated backup")
    assert(not root.join(".jet/.secrets.age.backup").exists())
    jet_vault_set_test_fault(None)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:289
#Test("concurrent_reader_defers_backup_recovery_until_writer_releases_lock") {
    root :: scratch("reader-writer-backup")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "initial signer").unwrap()
    jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    plan :: jet_vault_prepare_rotate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "concurrent rotation").unwrap()
    entered :: Arc.new(Barrier.new(2))
    release :: Arc.new(Barrier.new(2))
    jet_vault_set_test_backup_barrier(Some((root.clone(), entered.clone(), release.clone())))
    writer_root :: root.clone()
    writer :: thread.spawn(move || -> {
        jet_vault_set_test_fault(Some("durability-after-install"))
        result :: jet_vault_commit_rotate_at(&writer_root, ^plan, ^write)
        jet_vault_set_test_fault(None)
        result
    })
    entered.wait()
    backup :: root.join(".jet/.secrets.age.backup")
    backup_inode :: fs.metadata(&backup).unwrap().ino()
    assert_eq(jet_vault_current_at<JetSigningKey>(&root, "release").unwrap_err(), JetVaultError.Conflict)
    assert_eq(fs.metadata(&backup).unwrap().ino(), backup_inode)
    release.wait()
    assert_eq(writer.join().unwrap().unwrap_err(), JetVaultError.DurabilityUnknown)
    jet_vault_set_test_backup_barrier(None)
    assert_eq(fs.metadata(&backup).unwrap().ino(), backup_inode)
    backup_bytes :: fs.read(&backup).unwrap()
    assert_eq(vault_decode_ciphertext_at(&root, &backup_bytes).unwrap().0.revision, 1)
    assert_eq(decoded_store(&root).revision, 2)
    assert_eq(jet_vault_current_at<JetSigningKey>(&root, "release").unwrap().unwrap().generation(), 2)
    assert(not backup.exists())
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:331
#Test("linux_openat2_rejects_a_symlinked_vault_directory") {
    root :: scratch("symlink")
    actual :: root.join("actual")
    fs.create_dir(&actual).unwrap()
    fs.remove_dir(root.join(".jet")).unwrap()
    symlink(&actual, root.join(".jet")).unwrap()
    error :: if jet_vault_prepare_generate_at<JetSigningKey>(&root, "release") == {
        .Ok(_) -> panic("symlinked .jet directory was accepted")
        .Err(error) -> error
    }
    assert_eq(error, JetVaultError.UnsupportedProvider)
    fs.remove_dir_all(root).unwrap()
}

