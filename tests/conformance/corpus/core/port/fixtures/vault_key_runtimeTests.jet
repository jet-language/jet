// Rust: tests/fixtures/vault_key_runtime.rs:443
#Test("lifecycle_timestamps_do_not_decrease_when_wall_clock_rolls_back") {
    root :: scratch("clock-rollback")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "initial signer").unwrap()
    jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    before :: decoded_store(&root).keys[0].created_unix_ms
    plan :: jet_vault_prepare_rotate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "rollback rotation").unwrap()
    jet_vault_set_test_fault(Some("clock-rollback"))
    jet_vault_commit_rotate_at(&root, ^plan, ^write).unwrap()
    store :: decoded_store(&root)
    assert(store.keys[0].status_unix_ms >= before)
    assert(store.keys[1].created_unix_ms >= store.keys[0].status_unix_ms)
    jet_vault_set_test_fault(None)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:464
#Test("imported_origin_round_trips_and_invalid_combinations_reject") {
    key :: jet_crypto_signing_generate_impl().unwrap()
    key_bytes :: key.into_bytes()
    public_key_hash :: vault_public_hash(1, &key_bytes).unwrap()
    origin :: JetVaultOrigin{repo_uuid: [3; 16], name: "source", generation: 4, opaque_id: [5; 16], record_hash: [6; 32]}
    record := JetVaultRecord{name: "release", key_type: 1, generation: 1, status: JetVaultKeyStatus.Active, provenance: JetVaultProvenance.Imported, opaque_id: [2; 16], created_unix_ms: 10, status_unix_ms: 10, record_hash: [0; 32], public_key_hash: public_key_hash, reason_hash: [0; 32], origin: Some(origin.clone()), key: ^key_bytes}
    record.record_hash = vault_record_hash(&record)
    store := JetVaultStore.new([1; 16])
    store.revision = 1
    record_hash :: record.record_hash
    store.keys.push(^record)
    decoded :: jet_vault_decode_v2(&jet_vault_encode_v2(&store).unwrap()).unwrap()
    assert_eq(decoded.keys[0].origin, Some(origin))
    assert_eq(decoded.keys[0].record_hash, record_hash)
    store.keys[0].provenance = JetVaultProvenance.Generated
    store.keys[0].record_hash = vault_record_hash(&store.keys[0])
    assert_eq(jet_vault_encode_v2(&store).unwrap_err(), JetVaultError.InvalidEncoding)
}

// Rust: tests/fixtures/vault_key_runtime.rs:504
#Test("errors_and_handles_are_redacted") {
    errors :: [JetVaultError.InvalidName, JetVaultError.NotFound, JetVaultError.WrongType, JetVaultError.Revoked, JetVaultError.Locked, JetVaultError.AuthorityDenied, JetVaultError.Conflict, JetVaultError.UnsupportedProvider, JetVaultError.InvalidEncoding, JetVaultError.DurabilityUnknown, JetVaultError.Crypto(JetCryptoError.OpenFailed), JetVaultError.IO{operation: "read", redacted_path: "<vault-store>"}, JetVaultError.Internal{incident_id: "vault-17"}]
    tags :: errors.iter().map(|error| -> if error == {
        .InvalidName -> "invalid-name"
        .NotFound -> "not-found"
        .WrongType -> "wrong-type"
        .Revoked -> "revoked"
        .Locked -> "locked"
        .AuthorityDenied -> "authority-denied"
        .Conflict -> "conflict"
        .UnsupportedProvider -> "unsupported-provider"
        .InvalidEncoding -> "invalid-encoding"
        .DurabilityUnknown -> "durability-unknown"
        .Crypto(_) -> "crypto"
        .IO{..} -> "io"
        .Internal{..} -> "internal"
    }).collect()
    assert_eq(tags, ["invalid-name", "not-found", "wrong-type", "revoked", "locked", "authority-denied", "conflict", "unsupported-provider", "invalid-encoding", "durability-unknown", "crypto", "io", "internal"])
    display :: errors.iter().map(|error| -> error.to_string()).collect()
    assert_eq(display, ["invalid vault key name", "vault key not found", "vault key has a different type", "vault key is revoked", "vault is locked", "vault write authority denied", "vault changed since this write was prepared", "vault provider is unsupported on this platform", "vault store has invalid encoding", "vault write visibility is known but durability is uncertain", "vault cryptography failed: encrypted data could not be opened", "vault read failed at <vault-store>", "internal vault failure; incident vault-17"])
    shown :: errors.iter().zip(display).map(|(error, display)| -> "{error.debug()} {display}").collect().join("\n")
    loop forbidden in ["secrets.age", "AGE-SECRET", "/home/", "hunter2", "ciphertext sentinel"] {
        assert(not shown.contains(forbidden), "vault error leaked `{forbidden}`: {shown}")
    }
}

// Rust: tests/fixtures/vault_key_runtime.rs:559
#Test("stored_key_bytes_are_redacted_and_zeroized_on_drop") {
    key_bytes :: [0x5a; 32]
    public_key_hash :: vault_public_hash(2, &key_bytes).unwrap()
    record := JetVaultRecord{name: "transport", key_type: 2, generation: 1, status: JetVaultKeyStatus.Active, provenance: JetVaultProvenance.Imported, opaque_id: [2; 16], created_unix_ms: 10, status_unix_ms: 10, record_hash: [0; 32], public_key_hash: public_key_hash, reason_hash: [0; 32], origin: None, key: ^key_bytes}
    record.record_hash = vault_record_hash(&record)
    shown :: record.debug()
    assert(shown.contains("<redacted>"))
    assert(not shown.contains("90, 90"))
    observed :: Rc.new(Cell.new(false))
    witness :: observed.clone()
    jet_crypto_set_zeroize_test_observer(move |bytes| -> {
        if bytes.len() == 32 and bytes.iter().all(|byte| -> byte == 0) { witness.set(true) }
    })
    drop(^record)
    jet_crypto_clear_zeroize_test_observer()
    assert(observed.get())
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:66
#Test("key_wrap_error_projection_is_exhaustive_and_redacted") {
    errors :: [JetVaultKeyWrapError.InvalidEncoding, JetVaultKeyWrapError.UnsupportedVersion, JetVaultKeyWrapError.UnsupportedMode, JetVaultKeyWrapError.UnsupportedKeyType, JetVaultKeyWrapError.InvalidLength, JetVaultKeyWrapError.WeakPassphrase, JetVaultKeyWrapError.OpenFailed, JetVaultKeyWrapError.EntropyUnavailable, JetVaultKeyWrapError.ResourceUnavailable, JetVaultKeyWrapError.Vault(JetVaultError.NotFound), JetVaultKeyWrapError.Internal{incident_id: "key-wrap-17"}]
    tags :: errors.iter().map(|error| -> if error == {
        .InvalidEncoding -> "invalid-encoding"
        .UnsupportedVersion -> "unsupported-version"
        .UnsupportedMode -> "unsupported-mode"
        .UnsupportedKeyType -> "unsupported-key-type"
        .InvalidLength -> "invalid-length"
        .WeakPassphrase -> "weak-passphrase"
        .OpenFailed -> "open-failed"
        .EntropyUnavailable -> "entropy-unavailable"
        .ResourceUnavailable -> "resource-unavailable"
        .Vault(_) -> "vault"
        .Internal{..} -> "internal"
    }).collect()
    assert_eq(tags, ["invalid-encoding", "unsupported-version", "unsupported-mode", "unsupported-key-type", "invalid-length", "weak-passphrase", "open-failed", "entropy-unavailable", "resource-unavailable", "vault", "internal"])
    display :: errors.iter().map(|error| -> error.to_string()).collect()
    assert_eq(display, ["invalid wrapped vault key encoding", "unsupported wrapped vault key version", "unsupported wrapped vault key mode", "unsupported wrapped vault key type", "invalid wrapped vault key length", "recovery passphrase must contain 16..=1048576 bytes", "open failed", "the operating system could not provide cryptographic randomness", "cryptographic resource unavailable", "vault key not found", "internal key-wrap failure; incident key-wrap-17"])
    shown :: errors.iter().zip(display).map(|(error, display)| -> "{error.debug()} {display}").collect().join("\n")
    loop forbidden in ["secrets.age", "AGE-SECRET", "/home/", "hunter2", "ciphertext sentinel"] {
        assert(not shown.contains(forbidden), "key-wrap error leaked `{forbidden}`: {shown}")
    }
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:115
#Test("recipient_and_passphrase_round_trip_both_key_types") {
    source :: wrap.scratch("roundtrip-source")
    destination :: wrap.scratch("roundtrip-destination")
    wrap.provision(&source)
    wrap.provision(&destination)
    signing :: wrap.generate<JetSigningKey>(&source, "release")
    transport :: wrap.generate<JetX25519SecretKey>(&source, "transport")
    recovery :: jet_crypto_x25519_generate_impl().unwrap()
    recovery_public :: jet_crypto_x25519_public_typed_impl(&recovery)
    passphrase :: Secret(b"sixteen-byte recovery phrase".to_vec())
    signing_wrapped :: jet_vault_export_to_recipients_at(&source, &signing, [recovery_public.clone()]).unwrap()
    signing_restored :: wrap.import<JetSigningKey>(&destination, "release-restored", signing_wrapped.clone(), JetVaultKeyUnlock.Recipient(&recovery)).unwrap()
    assert_eq(jet_vault_load_at(&source, &signing).unwrap().public_bytes(), jet_vault_load_at(&destination, &signing_restored).unwrap().public_bytes())
    assert_eq(signing_wrapped.mode(), JetVaultKeyWrapMode.Recipient)
    assert_eq(signing_wrapped.key_type(), 1)
    assert_eq(jet_vault_wrapped_bytes_impl(&signing_wrapped), signing_wrapped.bytes())
    transport_wrapped :: jet_vault_export_to_passphrase_at(&source, &transport, &passphrase).unwrap()
    transport_restored :: wrap.import<JetX25519SecretKey>(&destination, "transport-restored", transport_wrapped.clone(), JetVaultKeyUnlock.Passphrase(&passphrase)).unwrap()
    assert_eq(jet_vault_load_at(&source, &transport).unwrap().public_bytes(), jet_vault_load_at(&destination, &transport_restored).unwrap().public_bytes())
    assert_eq(transport_wrapped.mode(), JetVaultKeyWrapMode.Passphrase)
    assert_eq(transport_wrapped.key_type(), 2)
    assert_eq(JetWrappedVaultKey.from_bytes(transport_wrapped.bytes()).unwrap(), transport_wrapped)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(source).unwrap()
    fs.remove_dir_all(destination).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:146
#Test("canonical_vectors_cover_one_and_sixteen_recipients_and_both_types") {
    signing_bytes :: [0x11; 32]
    signing_public :: JetSigningKey.from_bytes(signing_bytes.clone()).unwrap().public_bytes().try_into().unwrap()
    x25519_bytes :: [0x22; 32]
    x25519_public :: JetX25519SecretKey.from_bytes(x25519_bytes.clone()).unwrap().public_bytes().try_into().unwrap()
    signing_origin :: JetVaultOrigin{repo_uuid: [1; 16], name: "release", generation: 3, opaque_id: [2; 16], record_hash: [3; 32]}
    x25519_origin :: JetVaultOrigin{repo_uuid: [4; 16], name: "transport", generation: 7, opaque_id: [5; 16], record_hash: [6; 32]}
    recipients :: (1..=16).map(|byte| -> {
        secret :: JetX25519SecretKey([byte; 32])
        jet_crypto_x25519_public_typed_impl(&secret)
    }).collect()
    passphrase :: Secret(b"deterministic recovery phrase".to_vec())
    counter :: Rc.new(Cell.new(UInt8(0)))
    next :: counter.clone()
    jet_crypto_entropy_set_test_provider(move |out| -> {
        start :: next.get()
        loop (offset, byte) in out.iter_mut().enumerate() {
            byte = start.wrapping_add(UInt8(offset)).wrapping_add(1)
        }
        next.set(start.wrapping_add(UInt8(out.len())))
        JetCryptoEntropyStep.Filled(out.len())
    })
    one :: jvkw_export_to_recipients<JetSigningKey>(signing_origin.clone(), Zeroizing(signing_bytes.clone()), signing_public, 1_700_000_000_123, [recipients[0].clone()]).unwrap()
    sixteen :: jvkw_export_to_recipients<JetX25519SecretKey>(x25519_origin.clone(), Zeroizing(x25519_bytes.clone()), x25519_public, 1_700_000_000_123, &recipients).unwrap()
    pass_signing :: jvkw_export_to_passphrase<JetSigningKey>(^signing_origin, Zeroizing(^signing_bytes), signing_public, 1_700_000_000_123, &passphrase, jet_crypto_never_cancelled, jet_crypto_ignore_cancel, jet_pwhash_wait_noop, jet_pwhash_wait_noop).unwrap()
    pass_x25519 :: jvkw_export_to_passphrase<JetX25519SecretKey>(^x25519_origin, Zeroizing(^x25519_bytes), x25519_public, 1_700_000_000_123, &passphrase, jet_crypto_never_cancelled, jet_crypto_ignore_cancel, jet_pwhash_wait_noop, jet_pwhash_wait_noop).unwrap()
    hashes :: [&one, &sixteen, &pass_signing, &pass_x25519].iter().map(|wrapped| -> hex_bytes(&vault_hash([wrapped.bytes()]))).collect()
    assert_eq(hashes, ["4c853abf88a98887d39fa97d4bac2989e1aeffa50f23cd99450993f48a02f055", "0ee8b1798d9297317989c7bce4bc629235637602fa3d5d27f4b268555b3c45d9", "f230f5f36d00777f50926c44a656a2ffa9ff66a76b7cb3d049d77d11bc51c095", "641432fbff634bfa49ad1b2637dcb6bf947a60dec19750e0dd20e07e3656a95d"])
    assert_eq(sixteen.bytes().len(), 16 + sixteen.header_len() + 80)
    epoch_created := one.bytes()
    created_at :: 16 + 16 + 2 + "release".len() + 8 + 16 + 32
    epoch_created[created_at..created_at + 8].copy_from_slice(UInt64(0).to_le_bytes())
    assert(JetWrappedVaultKey.from_bytes(epoch_created).is_ok(), "created_unix_ms=0 is canonical")
    jet_crypto_entropy_clear_test_provider()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:188
#Test("parser_rejects_noncanonical_framing_before_secret_work") {
    root :: wrap.scratch("parser")
    wrap.provision(&root)
    reference :: wrap.generate<JetSigningKey>(&root, "release")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    wrapped :: jet_vault_export_to_recipients_at(&root, &reference, [public]).unwrap()
    assert_eq(jet_vault_export_to_recipients_at(&root, &reference, []).unwrap_err(), JetVaultKeyWrapError.InvalidLength)
    duplicate :: jet_crypto_x25519_public_typed_impl(&recipient)
    assert_eq(jet_vault_export_to_recipients_at(&root, &reference, [duplicate.clone(), duplicate]).unwrap_err(), JetVaultKeyWrapError.InvalidEncoding)
    too_many :: (1..=17).map(|byte| -> JetX25519PublicKey([byte; 32])).collect()
    assert_eq(jet_vault_export_to_recipients_at(&root, &reference, &too_many).unwrap_err(), JetVaultKeyWrapError.InvalidLength)
    bytes :: wrapped.bytes()
    cases := []
    bad := bytes.clone()
    bad[0] ^= 1
    cases.push((^bad, JetVaultKeyWrapError.InvalidEncoding))
    bad := bytes.clone()
    bad[4] = 2
    cases.push((^bad, JetVaultKeyWrapError.UnsupportedVersion))
    bad := bytes.clone()
    bad[5] = 3
    cases.push((^bad, JetVaultKeyWrapError.UnsupportedMode))
    bad := bytes.clone()
    bad[6] = 3
    cases.push((^bad, JetVaultKeyWrapError.UnsupportedKeyType))
    bad := bytes.clone()
    bad[7] = 1
    cases.push((^bad, JetVaultKeyWrapError.InvalidEncoding))
    bad := bytes.clone()
    bad[8..12].copy_from_slice(UInt32(0).to_le_bytes())
    cases.push((^bad, JetVaultKeyWrapError.InvalidLength))
    bad := bytes.clone()
    bad[12..16].copy_from_slice(UInt32(63).to_le_bytes())
    cases.push((^bad, JetVaultKeyWrapError.InvalidLength))
    bad := bytes.clone()
    bad.push(0)
    cases.push((^bad, JetVaultKeyWrapError.InvalidLength))
    loop (bytes, expected) in cases { assert_eq(JetWrappedVaultKey.from_bytes(bytes).unwrap_err(), expected) }
    assert_eq(JetWrappedVaultKey.from_bytes([0; 8193]).unwrap_err(), JetVaultKeyWrapError.InvalidLength)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:217
#Test("wrong_unlock_and_authenticated_tamper_collapse_to_open_failed") {
    root :: wrap.scratch("open-failed")
    wrap.provision(&root)
    reference :: wrap.generate<JetSigningKey>(&root, "release")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    wrong :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    wrapped :: jet_vault_export_to_recipients_at(&root, &reference, [public]).unwrap()
    jet_vault_keywrap_reset_test_crypto_counts()
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "copy", wrapped.clone(), JetVaultKeyUnlock.Recipient(&wrong)).unwrap_err(), JetVaultKeyWrapError.OpenFailed)
    assert_eq(jet_vault_keywrap_test_recipient_open_count(), 1, "no-match executes exactly one dummy X25519/HKDF/AEAD path")
    assert_eq(jet_vault_keywrap_test_x25519_count(), 1)
    assert_eq(jet_vault_keywrap_test_hkdf_count(), 2)
    assert_eq(jet_vault_keywrap_test_aead_count(), 1)
    phrase :: Secret(b"sixteen-byte passphrase".to_vec())
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "copy", wrapped.clone(), JetVaultKeyUnlock.Passphrase(&phrase)).unwrap_err(), JetVaultKeyWrapError.OpenFailed)
    assert_eq(jet_vault_prepare_import_wrapped_at<JetX25519SecretKey>(&root, "copy", wrapped.clone(), JetVaultKeyUnlock.Recipient(&recipient)).unwrap_err(), JetVaultKeyWrapError.OpenFailed)
    tampered := wrapped.bytes()
    tampered[20] ^= 1
    tampered :: JetWrappedVaultKey.from_bytes(^tampered).unwrap()
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "copy", ^tampered, JetVaultKeyUnlock.Recipient(&recipient)).unwrap_err(), JetVaultKeyWrapError.OpenFailed)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:243
#Test("same_repo_is_idempotent_but_revocation_never_reactivates") {
    root :: wrap.scratch("idempotent")
    wrap.provision(&root)
    reference :: wrap.generate<JetSigningKey>(&root, "release")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    wrapped :: jet_vault_export_to_recipients_at(&root, &reference, [public]).unwrap()
    expected_export :: "JVLA1 action=export mode=recipient outcome=BearerCopy key_type=1 origin_repo={vault_uuid_hex(&reference.repo_uuid)} origin_name=72656c65617365 origin_generation={reference.generation} origin_id={hex_bytes(&reference.opaque_id)} origin_hash={hex_bytes(&reference.record_hash)} destination=- bearer_copy=true source_revocation_recall=false mutation=false"
    assert_eq(fs.read_to_string(root.join(".jet/vault-audit")).unwrap().lines().last().unwrap(), expected_export)
    revision :: wrap.decoded_store(&root).revision
    existing :: wrap.import<JetSigningKey>(&root, "ignored", wrapped.clone(), JetVaultKeyUnlock.Recipient(&recipient)).unwrap()
    assert_eq(existing, reference)
    assert_eq(wrap.decoded_store(&root).revision, revision)
    expected_idempotent :: "JVLA1 action=import mode=recipient outcome=AlreadyPresent key_type=1 origin_repo={vault_uuid_hex(&reference.repo_uuid)} origin_name=72656c65617365 origin_generation={reference.generation} origin_id={hex_bytes(&reference.opaque_id)} origin_hash={hex_bytes(&reference.record_hash)} destination=69676e6f726564 bearer_copy=false source_revocation_recall=false mutation=false"
    assert_eq(fs.read_to_string(root.join(".jet/vault-audit")).unwrap().lines().last().unwrap(), expected_idempotent)
    retire :: jet_vault_prepare_retire_at(&root, &reference, "archive").unwrap()
    write :: jet_vault_authorize_write_impl(&retire, "retire archived key").unwrap()
    jet_vault_commit_retire_at(&root, ^retire, ^write).unwrap()
    retired_wrapped :: jet_vault_export_to_recipients_at(&root, &reference, [jet_crypto_x25519_public_typed_impl(&recipient)]).unwrap()
    retired_revision :: wrap.decoded_store(&root).revision
    assert_eq(wrap.import<JetSigningKey>(&root, "ignored", ^retired_wrapped, JetVaultKeyUnlock.Recipient(&recipient)).unwrap(), reference)
    assert_eq(wrap.decoded_store(&root).revision, retired_revision)
    revoke :: jet_vault_prepare_revoke_at(&root, &reference, "compromised").unwrap()
    write :: jet_vault_authorize_write_impl(&revoke, "revoke compromised key").unwrap()
    jet_vault_commit_revoke_at(&root, ^revoke, ^write).unwrap()
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "release-restored", ^wrapped, JetVaultKeyUnlock.Recipient(&recipient)).unwrap_err(), JetVaultKeyWrapError.Vault(JetVaultError.Revoked))
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:276
#Test("cross_repo_import_gets_new_identity_and_preserves_origin") {
    source :: wrap.scratch("cross-source")
    destination :: wrap.scratch("cross-destination")
    wrap.provision(&source)
    wrap.provision(&destination)
    reference :: wrap.generate<JetX25519SecretKey>(&source, "transport")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    wrapped :: jet_vault_export_to_recipients_at(&source, &reference, [public]).unwrap()
    revoke :: jet_vault_prepare_revoke_at(&source, &reference, "source compromised after export").unwrap()
    write :: jet_vault_authorize_write_impl(&revoke, "revoke source").unwrap()
    jet_vault_commit_revoke_at(&source, ^revoke, ^write).unwrap()
    restored :: wrap.import<JetX25519SecretKey>(&destination, "restored", ^wrapped, JetVaultKeyUnlock.Recipient(&recipient)).unwrap()
    assert_ne(restored.repo_uuid, reference.repo_uuid)
    assert_ne(restored.opaque_id, reference.opaque_id)
    store :: wrap.decoded_store(&destination)
    origin :: store.keys[0].origin.as_ref().unwrap()
    assert_eq(origin.repo_uuid, reference.repo_uuid)
    assert_eq(origin.name, "transport")
    assert_eq(origin.generation, reference.generation)
    assert_eq(origin.opaque_id, reference.opaque_id)
    assert_eq(origin.record_hash, reference.record_hash)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(source).unwrap()
    fs.remove_dir_all(destination).unwrap()
}

