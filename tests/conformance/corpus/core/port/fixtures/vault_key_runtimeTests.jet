// Rust: tests/fixtures/vault_key_runtime.rs:44
#Test("absent_store_reads_do_not_require_mutation_recipients") {
    root :: scratch("absent-read")
    assert_eq(jet_vault_current_at<JetSigningKey>(&root, "release").unwrap(), None)
    assert(jet_vault_versions_at<JetSigningKey>(&root, "release").unwrap().is_empty())
    missing :: JetVaultKeyRef<JetSigningKey>{provider: JetVaultProvider.Repo, repo_uuid: [1; 16], name: "release", generation: 1, opaque_id: [2; 16], record_hash: [3; 32], marker: PhantomData}
    assert_eq(jet_vault_load_at(&root, &missing).unwrap_err(), JetVaultError.NotFound)
    assert_eq(jet_vault_status_at(&root, &missing).unwrap_err(), JetVaultError.NotFound)
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:63
#Test("typed_generate_rotate_retire_revoke_and_conflict") {
    root :: scratch("lifecycle")
    provision(&root)
    jet_vault_set_test_authorizer(|_| -> true)
    plan :: jet_vault_prepare_generate_at<JetSigningKey>(&root, "release").unwrap()
    stale :: jet_vault_prepare_generate_at<JetX25519SecretKey>(&root, "transport").unwrap()
    write :: jet_vault_authorize_write_impl(&plan, "initial release key").unwrap()
    first :: jet_vault_commit_generate_at(&root, ^plan, ^write).unwrap()
    assert_eq(first.generation(), 1)
    assert_eq(jet_vault_status_at(&root, &first).unwrap(), JetVaultKeyStatus.Active)
    assert(jet_vault_load_at(&root, &first).is_ok())
    stale_write :: jet_vault_authorize_write_impl(&stale, "stale write").unwrap()
    assert_eq(jet_vault_commit_generate_at(&root, ^stale, ^stale_write).unwrap_err(), JetVaultError.Conflict)
    rotate :: jet_vault_prepare_rotate_at<JetSigningKey>(&root, "release").unwrap()
    write :: jet_vault_authorize_write_impl(&rotate, "quarterly rotation").unwrap()
    rotated :: jet_vault_commit_rotate_at(&root, ^rotate, ^write).unwrap()
    assert_eq(rotated.previous, first)
    assert_eq(rotated.current.generation(), 2)
    assert_eq(jet_vault_status_at(&root, &first).unwrap(), JetVaultKeyStatus.Retired)
    assert(jet_vault_load_at(&root, &first).is_ok(), "retired exact refs remain loadable")
    revoke :: jet_vault_prepare_revoke_at(&root, &first, "suspected exposure").unwrap()
    write :: jet_vault_authorize_write_impl(&revoke, "incident response").unwrap()
    jet_vault_commit_revoke_at(&root, ^revoke, ^write).unwrap()
    assert_eq(jet_vault_status_at(&root, &first).unwrap(), JetVaultKeyStatus.Revoked)
    assert_eq(jet_vault_load_at(&root, &first).unwrap_err(), JetVaultError.Revoked)
    current :: jet_vault_current_at<JetSigningKey>(&root, "release").unwrap().unwrap()
    assert_eq(current, rotated.current)
    assert_eq(jet_vault_versions_at<JetSigningKey>(&root, "release").unwrap().len(), 2)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

