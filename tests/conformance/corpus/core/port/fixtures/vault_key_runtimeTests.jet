// Rust: tests/fixtures/vault_key_wrap_runtime.rs:328
#Test("weak_passphrases_entropy_failure_cleanup_and_redaction_are_explicit") {
    root :: wrap.scratch("failures")
    wrap.provision(&root)
    reference :: wrap.generate<JetSigningKey>(&root, "release")
    weak :: Secret(b"too short".to_vec())
    assert_eq(jet_vault_export_to_passphrase_at(&root, &reference, &weak).unwrap_err(), JetVaultKeyWrapError.WeakPassphrase)
    jet_crypto_entropy_set_test_provider(|_| -> JetCryptoEntropyStep.Failed)
    recipient :: JetX25519PublicKey([9; 32])
    audit_before :: fs.read_to_string(root.join(".jet/vault-audit")).unwrap_or_default()
    assert_eq(jet_vault_export_to_recipients_at(&root, &reference, [recipient]).unwrap_err(), JetVaultKeyWrapError.EntropyUnavailable)
    assert_eq(fs.read_to_string(root.join(".jet/vault-audit")).unwrap_or_default(), audit_before, "failed export records no BearerCopy success")
    jet_crypto_entropy_clear_test_provider()
    phrase :: Secret(b"sixteen-byte passphrase".to_vec())
    wrapped :: jet_vault_export_to_passphrase_at(&root, &reference, &phrase).unwrap()
    wrong_phrase :: Secret(b"different recovery phrase".to_vec())
    jet_vault_keywrap_reset_test_crypto_counts()
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "wrong", wrapped.clone(), JetVaultKeyUnlock.Passphrase(&wrong_phrase)).unwrap_err(), JetVaultKeyWrapError.OpenFailed)
    assert_eq(jet_vault_keywrap_test_passphrase_open_count(), 1, "wrong passphrase executes one admitted Argon2 class")
    assert_eq(jet_pwhash_test_runs(), 1, "counter sits on actual Argon2 backend invocation")
    shown :: "{wrapped.debug()} {wrapped}"
    assert(shown.contains("mode:passphrase"))
    assert(shown.contains("type:signing"))
    assert(not shown.contains("sixteen-byte"))
    assert(not shown.contains("ciphertext"))
    observed :: Rc.new(Cell.new(false))
    witness :: observed.clone()
    jet_crypto_set_zeroize_test_observer(move |bytes| -> {
        if bytes.len() == 32 and bytes.iter().all(|byte| -> byte == 0) { witness.set(true) }
    })
    plan :: jet_vault_prepare_import_wrapped_at<JetSigningKey>(&root, "restored", ^wrapped, JetVaultKeyUnlock.Passphrase(&phrase)).unwrap()
    drop(^plan)
    jet_crypto_clear_zeroize_test_observer()
    assert(observed.get(), "prepared plaintext key is zeroized when abandoned")
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:368
#Test("unsupported_provider_preflight_precedes_all_secret_work") {
    source :: wrap.scratch("preflight-source")
    destination :: wrap.scratch("preflight-destination")
    wrap.provision(&source)
    wrap.provision(&destination)
    reference :: wrap.generate<JetSigningKey>(&source, "release")
    identity :: jet_crypto_x25519_generate_impl().unwrap()
    wrapped :: jet_vault_export_to_recipients_at(&source, &reference, [jet_crypto_x25519_public_typed_impl(&identity)]).unwrap()
    fs.remove_dir_all(destination.join(".jet")).unwrap()
    symlink(destination.join("keys"), destination.join(".jet")).unwrap()
    jet_vault_keywrap_reset_test_crypto_counts()
    assert_eq(jet_vault_prepare_import_wrapped_at<JetSigningKey>(&destination, "restored", ^wrapped, JetVaultKeyUnlock.Recipient(&identity)).unwrap_err(), JetVaultKeyWrapError.Vault(JetVaultError.UnsupportedProvider))
    assert_eq(jet_vault_keywrap_test_recipient_open_count(), 0)
    assert_eq(jet_vault_keywrap_test_passphrase_open_count(), 0)
    assert_eq(jet_vault_keywrap_test_x25519_count(), 0)
    assert_eq(jet_vault_keywrap_test_hkdf_count(), 0)
    assert_eq(jet_vault_keywrap_test_aead_count(), 0)
    assert_eq(jet_pwhash_test_runs(), 0)
    jet_vault_clear_test_authorizer()
    fs.remove_dir_all(source).unwrap()
    fs.remove_dir_all(destination).unwrap()
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:405
#Test("provider_platform_allowlist_is_exact") {
    assert(jvkw_provider_platform_supported("linux", "gnu", "64", "x86_64"))
    assert(jvkw_provider_platform_supported("linux", "gnu", "64", "aarch64"))
    loop target in [("linux", "musl", "64", "x86_64"), ("linux", "gnu", "32", "x86"), ("linux", "gnu", "64", "riscv64"), ("none", "", "64", "x86_64")] {
        assert(not jvkw_provider_platform_supported(target.0, target.1, target.2, target.3), "unsupported target admitted: {target.debug()}")
    }
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:413-414
struct ResetBudget {}
impl Drop for ResetBudget {
    fn drop(&self) -> { jet_pwhash_test_set_budget(0) }
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:412
#Test("pwhash_pool_proves_fifo_cancellation_exhaustion_and_exact_release") {
    _reset :: ResetBudget{}
    assert_eq(jet_pwhash_weight_kib(65_536, 1_048_576).unwrap(), 77_824)
    assert_eq(JET_PWHASH_BUDGET_KIB / 77_824, 4, "canonical budget admits exactly four maximum-password default jobs")
    weight :: jet_pwhash_weight_kib(8_192, 16).unwrap()
    jet_pwhash_test_set_budget(weight)
    first_cancel :: Arc.new(AtomicBool.new(false))
    first_entered :: Arc.new(Barrier.new(2))
    first_release :: Arc.new(Barrier.new(2))
    cancel :: first_cancel.clone()
    entered :: first_entered.clone()
    release :: first_release.clone()
    first :: thread.spawn(move || -> jet_pwhash_test_run(cancel, Some((entered, release))))
    first_entered.wait()
    (_, _, admitted_runs) :: jet_pwhash_test_snapshot()
    queued_cancel :: Arc.new(AtomicBool.new(false))
    cancel :: queued_cancel.clone()
    queued :: thread.spawn(move || -> jet_pwhash_test_run(cancel, None))
    deadline :: Instant.now() + Duration.from_secs(2)
    loop jet_pwhash_test_snapshot().1 != 1 and Instant.now() < deadline { thread.yield_now() }
    assert_eq(jet_pwhash_test_snapshot().1, 1, "second request waits at the FIFO head")
    queued_cancel.store(true, Ordering.SeqCst)
    assert_eq(queued.join().unwrap().unwrap_err(), JetPwhashRunError.Cancelled)
    assert_eq(jet_pwhash_test_snapshot().2, admitted_runs, "queued cancellation performs no Argon2 work")
    first_release.wait()
    assert(first.join().unwrap().is_ok())
    assert_eq(jet_pwhash_test_snapshot().0, 0, "admitted weight is released exactly once")
    running_cancel :: Arc.new(AtomicBool.new(false))
    running_entered :: Arc.new(Barrier.new(2))
    running_release :: Arc.new(Barrier.new(2))
    cancel :: running_cancel.clone()
    entered :: running_entered.clone()
    release :: running_release.clone()
    running :: thread.spawn(move || -> jet_pwhash_test_run(cancel, Some((entered, release))))
    running_entered.wait()
    running_cancel.store(true, Ordering.SeqCst)
    running_release.wait()
    assert_eq(running.join().unwrap().unwrap_err(), JetPwhashRunError.Cancelled, "admitted cancellation finishes then discards the backend result")
    assert_eq(jet_pwhash_test_snapshot().0, 0, "cancelled admitted weight is released exactly once")
    before_exhaustion :: jet_pwhash_test_snapshot().2
    jet_pwhash_test_set_budget(weight - 1_024)
    assert_eq(jet_pwhash_test_run(Arc.new(AtomicBool.new(false)), None).unwrap_err(), JetPwhashRunError.ResourceUnavailable)
    assert_eq(jet_pwhash_test_snapshot(), (0, 0, before_exhaustion), "budget exhaustion allocates no Argon2 arena")
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:508
struct ExitNotice { sender: mpsc.Sender<()> }
impl Drop for ExitNotice {
    fn drop(&self) -> { _ :: self.sender.send(()) }
}

// Rust: tests/fixtures/vault_key_wrap_runtime.rs:470
#Test("pwhash_wait_compensates_one_worker_and_arbitrates_cancel_with_shield") {
    env.set_var("JET_SCHEDULER_THREADS", "1")
    wrap.STRESS_CANCEL.store(false, Ordering.SeqCst)
    waits := []
    releases := []
    loop _ in 0..4 {
        entered :: Arc.new(Barrier.new(2))
        release :: Arc.new(Barrier.new(2))
        worker_entered :: entered.clone()
        worker_release :: release.clone()
        waits.push(jet_scheduler_spawn_blocking(move || -> jet_pwhash_test_run_with(wrap.stress_cancelled, Some((worker_entered, worker_release)), None, jet_scheduler_blocking_wait_enter, jet_scheduler_blocking_wait_leave)))
        entered.wait()
        releases.push(release)
    }
    loop _ in 4..9 {
        waits.push(jet_scheduler_spawn_blocking(move || -> jet_pwhash_test_run_with(wrap.stress_cancelled, None, None, jet_scheduler_blocking_wait_enter, jet_scheduler_blocking_wait_leave)))
    }
    deadline :: Instant.now() + Duration.from_secs(2)
    loop (jet_pwhash_test_snapshot().1, jet_scheduler_blocking_wait_stats().0) != (5, 9) {
        assert(Instant.now() < deadline, "nine waiters must reach four admitted plus five queued jobs: pwhash={jet_pwhash_test_snapshot().debug()}, scheduler={jet_scheduler_blocking_wait_stats().debug()}")
        thread.sleep(Duration.from_millis(1))
    }
    assert_eq(jet_pwhash_test_queued_secrets(), 5, "queued jobs retain only bounded caller-owned secret copies")
    overflows :: (0..3).map(|_| -> jet_scheduler_spawn_blocking(move || -> jet_pwhash_test_run_with(jet_scheduler_wait_point_cancelled, None, None, jet_scheduler_blocking_wait_enter, jet_scheduler_blocking_wait_leave))).collect()
    (progress_tx, progress_rx) :: mpsc.channel()
    progress :: jet_scheduler_spawn(move || -> progress_tx.send(()).unwrap())
    progress_rx.recv_timeout(Duration.from_secs(2)).expect("reserved compensation worker must defer recursive Argon jobs and run unrelated work after saturation")
    (_, current, peak) :: jet_scheduler_blocking_wait_stats()
    assert(current <= 9 and peak <= 9, "compensation thread peak must stay globally bounded: current={current}, peak={peak}")
    wrap.STRESS_CANCEL.store(true, Ordering.SeqCst)
    loop release in releases { release.wait() }
    loop wait in waits { assert_eq(wait.join().unwrap_err(), JetPwhashRunError.Cancelled) }
    progress.join()
    loop overflow in overflows { assert(overflow.join().is_ok(), "deferred Argon caller completes after saturation clears") }
    wrap.STRESS_CANCEL.store(false, Ordering.SeqCst)
    assert_eq(jet_pwhash_test_snapshot().0, 0, "cancelled admitted jobs release the full Argon arena budget")
    assert_eq(jet_pwhash_test_snapshot().1, 0, "cancel/release drains queued Argon jobs")
    assert_eq(jet_pwhash_test_queued_secrets(), 0, "cancel/release drains queued secret copies")
    deadline :: Instant.now() + Duration.from_secs(2)
    loop jet_scheduler_blocking_wait_stats().0 != 0 or jet_scheduler_blocking_wait_stats().1 != 0 {
        assert(Instant.now() < deadline, "all waits and compensation threads must drain")
        thread.yield_now()
    }
    race_entered :: Arc.new(Barrier.new(2))
    race_release :: Arc.new(Barrier.new(2))
    race_control :: JetTaskControl.new()
    entered :: race_entered.clone()
    release :: race_release.clone()
    race :: jet_scheduler_spawn_with_control(move || -> jet_pwhash_test_run_with(jet_scheduler_wait_point_cancelled, None, Some((entered, release)), jet_scheduler_blocking_wait_enter, jet_scheduler_blocking_wait_leave), race_control.clone())
    race_entered.wait()
    race_control.cancel()
    race_release.wait()
    assert_eq(race.join().unwrap_err(), JetPwhashRunError.Cancelled, "cancellation observed before final return beats completed success")
    shield_entered :: Arc.new(Barrier.new(2))
    shield_release :: Arc.new(Barrier.new(2))
    shield_completed :: Arc.new(AtomicBool.new(false))
    shield_after :: Arc.new(AtomicBool.new(false))
    (exit_tx, exit_rx) :: mpsc.channel()
    shield_control :: JetTaskControl.new()
    entered :: shield_entered.clone()
    release :: shield_release.clone()
    completed :: shield_completed.clone()
    after :: shield_after.clone()
    _shield :: jet_scheduler_spawn_with_control(move || -> {
        _exit :: ExitNotice{sender: exit_tx}
        jet_scheduler_shield_enter()
        result :: jet_pwhash_test_run_with(jet_scheduler_wait_point_cancelled, Some((entered, release)), None, jet_scheduler_blocking_wait_enter, jet_scheduler_blocking_wait_leave)
        assert(result.is_ok())
        completed.store(true, Ordering.SeqCst)
        jet_scheduler_shield_leave()
        after.store(true, Ordering.SeqCst)
    }, shield_control.clone())
    shield_entered.wait()
    shield_control.cancel()
    shield_release.wait()
    exit_rx.recv_timeout(Duration.from_secs(2)).expect("shielded task must exit at deferred cancellation")
    assert(shield_completed.load(Ordering.SeqCst), "shielded KDF completes before deferred cancellation lands")
    assert(not shield_after.load(Ordering.SeqCst), "deferred cancellation lands at shield exit")
    deadline :: Instant.now() + Duration.from_secs(2)
    loop jet_scheduler_blocking_wait_stats().0 != 0 or jet_scheduler_blocking_wait_stats().1 != 0 {
        assert(Instant.now() < deadline, "later race and shield waits must leave no compensation threads")
        thread.yield_now()
    }
}
