    arm_zero_progress("migrate-v1-read-io")
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], zero_read, never_cancelled), .Err(.SourceIo))
    clear_observed_io_fault()
    assert(!zero_read.exists())
    assert_eq(fs.read(v1_source).unwrap(), v1)
    loop boundary in ["migrate-stage-write", "migrate-output-write"] {
        output :: root.join("zero-{boundary}.jetc")
        arm_zero_progress(boundary)
        assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], output, never_cancelled), .Err(.DestinationIo))
        clear_observed_io_fault()
        assert(!output.exists())
        assert_eq(fs.read(v1_source).unwrap(), v1)
    }
    trailing_v1 := v1.clone()
    trailing_v1.extend_from_slice("unread trailing bytes".as_bytes())
    trailing_source :: root.join("historical-trailing.jetc")
    fs.write(trailing_source, trailing_v1).unwrap()
    trailing_output :: root.join("trailing-prefix.jetc")
    arm_eof_after("migrate-v1-read-io", v1.len())
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, trailing_source, [public.clone()], trailing_output, never_cancelled), .Err(.SourceIo))
    clear_observed_io_fault()
    assert(!trailing_output.exists())
    assert_eq(fs.read(trailing_source).unwrap(), trailing_v1)
    loop boundary in ["seal-source-read", "seal-output-write"] {
        output :: root.join("eintr-{boundary}.jetc")
        arm_io_error(boundary, 4)
        jet_crypto_file_seal_impl([public.clone()], source, output, never_cancelled).unwrap()
        clear_observed_io_fault()
        restored :: root.join("eintr-{boundary}.bin")
        jet_crypto_file_open_impl(&recipient, output, restored, never_cancelled).unwrap()
        assert_eq(fs.read(restored).unwrap(), plaintext)
    }
    loop (boundary, expected) in [
        ("seal-source-read", JetFileCryptoError.SourceIo), ("seal-stage-write", JetFileCryptoError.DestinationIo),
        ("seal-stage-fsync", JetFileCryptoError.DestinationIo), ("seal-output-write", JetFileCryptoError.DestinationIo),
        ("seal-output-fsync", JetFileCryptoError.DestinationIo)
    ] {
        output :: root.join("fail-{boundary}.jetc")
        arm_io_error(boundary, 28)
        assert_eq(jet_crypto_file_seal_impl([public.clone()], source, output, never_cancelled), .Err(expected))
        clear_observed_io_fault()
        assert(!output.exists())
    }
    loop (boundary, expected) in [
        ("open-input-read", JetFileCryptoError.OpenFailed), ("open-output-write", JetFileCryptoError.DestinationIo),
        ("open-output-fsync", JetFileCryptoError.DestinationIo)
    ] {
        output :: root.join("fail-{boundary}.bin")
        arm_io_error(boundary, 28)
        assert_eq(jet_crypto_file_open_impl(&recipient, stable, output, never_cancelled), .Err(expected))
        clear_observed_io_fault()
        assert(!output.exists())
    }
    loop boundary in ["migrate-v1-read-io", "migrate-stage-write", "migrate-stage-fsync", "migrate-output-write",
        "migrate-verify-fsync", "migrate-reopen-verify", "migrate-verify-read", "migrate-output-fsync"] {
        output :: root.join("fail-{boundary}.jetc")
        arm_io_error(boundary, 28)
        expected :: if boundary == "migrate-v1-read-io" -> JetFileCryptoError.SourceIo else -> JetFileCryptoError.DestinationIo
        assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], output, never_cancelled), .Err(expected))
        clear_observed_io_fault()
        assert(!output.exists())
        assert_eq(fs.read(v1_source).unwrap(), v1)
    }
    seal_post :: root.join("seal-post-install.jetc")
    arm_io_error("seal-directory-fsync", 5)
    assert_eq(jet_crypto_file_seal_impl([public.clone()], source, seal_post, never_cancelled), .Err(.DestinationIo))
    clear_observed_io_fault()
    assert(seal_post.exists())
    seal_restored :: root.join("seal-post-install.bin")
    jet_crypto_file_open_impl(&recipient, seal_post, seal_restored, never_cancelled).unwrap()
    assert_eq(fs.read(seal_restored).unwrap(), plaintext)
    open_post :: root.join("open-post-install.bin")
    arm_io_error("open-directory-fsync", 5)
    assert_eq(jet_crypto_file_open_impl(&recipient, stable, open_post, never_cancelled), .Err(.DestinationIo))
    clear_observed_io_fault()
    assert_eq(fs.read(open_post).unwrap(), plaintext)
    migrate_post :: root.join("migrate-post-install.jetc")
    arm_io_error("migrate-directory-fsync", 5)
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], migrate_post, never_cancelled), .Err(.DestinationIo))
    clear_observed_io_fault()
    assert(migrate_post.exists())
    assert_eq(fs.read(v1_source).unwrap(), v1)
    migrate_restored :: root.join("migrate-post-install.bin")
    jet_crypto_file_open_impl(&recipient, migrate_post, migrate_restored, never_cancelled).unwrap()
    assert_eq(fs.read(migrate_restored).unwrap(), plaintext)
    winner :: root.join("winner.jetc")
    fs.write(winner, "winner".as_bytes()).unwrap()
    arm_io_error("seal-directory-fsync", 5)
    assert_eq(jet_crypto_file_seal_impl([public], source, winner, never_cancelled), .Err(.DestinationExists))
    assert_eq(jet_crypto_file_io_test_hits(), 0)
    jet_crypto_clear_file_io_test_fault()
    assert_eq(fs.read(winner).unwrap(), "winner".as_bytes())
    assert(fs.read_dir(root).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".jetc-")))
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:1565
#Test("jetc_v2_entropy_failure_occurs_after_verified_snapshot_and_publishes_nothing") {
    root :: test_dir("entropy")
    source :: root.join("source.bin")
    envelope :: root.join("sealed.jetc")
    fs.write(source, "snapshot first".as_bytes()).unwrap()
    fail_entropy()
    assert_eq(jet_crypto_file_seal_impl([JetX25519PublicKey([U8#32].filled(9))], source, envelope, never_cancelled),
        .Err(JetFileCryptoError.SealFailed(JetCryptoError.EntropyUnavailable)))
    jet_crypto_entropy_clear_test_provider()
    assert(!envelope.exists())
    assert_eq(fs.read(source).unwrap(), "snapshot first".as_bytes())
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:1588
#Test("jetc_v2_linux_publication_holds_parent_and_never_replaces_a_racer") {
    if core.sys.target.selected_os() != "linux" { return }
    root :: test_dir("publish-races")
    source :: root.join("source.bin")
    fs.write(source, "held parent".as_bytes()).unwrap()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    parent :: root.join("seal-parent")
    moved :: root.join("seal-parent-moved")
    fs.create_dir(parent).unwrap()
    destination :: parent.join("sealed.jetc")
    arm_publish_race(PublishRace.SwapParent("seal-stage", parent.clone(), moved.clone()))
    assert_eq(jet_crypto_file_seal_impl([public.clone()], source, destination, never_cancelled), .Err(.DestinationIo))
    assert(!destination.exists())
    assert(!moved.join("sealed.jetc").exists())
    assert(fs.read_dir(moved).unwrap().next().is_none())
    race_parent :: root.join("race-parent")
    fs.create_dir(race_parent).unwrap()
    raced :: race_parent.join("sealed.jetc")
    arm_publish_race(PublishRace.CreateDestination("seal-output", raced.clone()))
    assert_eq(jet_crypto_file_seal_impl([public.clone()], source, raced, never_cancelled), .Err(.DestinationExists))
    assert_eq(fs.read(raced).unwrap(), "racer".as_bytes())
    assert_eq(fs.read_dir(race_parent).unwrap().count(), 1)
    stable_parent :: root.join("stable-parent")
    fs.create_dir(stable_parent).unwrap()
    envelope :: stable_parent.join("sealed.jetc")
    jet_crypto_file_seal_impl([public], source, envelope, never_cancelled).unwrap()
    open_parent :: root.join("open-parent")
    open_moved :: root.join("open-parent-moved")
    fs.create_dir(open_parent).unwrap()
    restored :: open_parent.join("restored.bin")
    arm_publish_race(PublishRace.SwapParent("open-output", open_parent.clone(), open_moved.clone()))
    assert_eq(jet_crypto_file_open_impl(&recipient, envelope, restored, never_cancelled), .Err(.DestinationIo))
    assert(!restored.exists())
    assert(!open_moved.join("restored.bin").exists())
    assert(fs.read_dir(open_moved).unwrap().next().is_none())
    real_parent :: root.join("real-parent")
    linked_parent :: root.join("linked-parent")
    fs.create_dir(real_parent).unwrap()
    std.os.unix.fs.symlink(real_parent, linked_parent).unwrap()
    linked_destination :: linked_parent.join("sealed.jetc")
    assert_eq(jet_crypto_file_seal_impl([jet_crypto_x25519_public_typed_impl(&recipient)], source, linked_destination, never_cancelled), .Err(.DestinationIo))
    assert(!real_parent.join("sealed.jetc").exists())
    PUBLISH_RACE.with(slot -> assert(slot.borrow().is_none()))
    jet_crypto_clear_file_boundary_test_observer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:1689
#Test("jetc_v2_linux_anonymous_inodes_ignore_every_former_temp_namespace") {
    if core.sys.target.selected_os() != "linux" { return }
    root :: test_dir("anonymous-inodes")
    source :: root.join("source.bin")
    plaintext :: "anonymous inode payload".as_bytes()
    fs.write(source, plaintext).unwrap()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    stage_parent :: root.join("seal-stage-parent")
    fs.create_dir(stage_parent).unwrap()
    stage_envelope :: stage_parent.join("sealed.jetc")
    replace_candidate_at("seal-stage", stage_parent, "jetc-stage")
    jet_crypto_file_seal_impl([public.clone()], source, stage_envelope, never_cancelled).unwrap()
    assert_attacker_candidates(stage_parent, "jetc-stage")
    assert_not_attacker(stage_envelope)
    output_parent :: root.join("seal-output-parent")
    fs.create_dir(output_parent).unwrap()
    output_envelope :: output_parent.join("sealed.jetc")
    replace_candidate_at("seal-output", output_parent, "jetc-output")
    jet_crypto_file_seal_impl([public.clone()], source, output_envelope, never_cancelled).unwrap()
    assert_attacker_candidates(output_parent, "jetc-output")
    assert_not_attacker(output_envelope)
    open_parent :: root.join("open-output-parent")
    fs.create_dir(open_parent).unwrap()
    restored :: open_parent.join("restored.bin")
    replace_candidate_at("open-output", open_parent, "jetc-open")
    jet_crypto_file_open_impl(&recipient, stage_envelope, restored, never_cancelled).unwrap()
    assert_eq(fs.read(restored).unwrap(), plaintext)
    assert_attacker_candidates(open_parent, "jetc-open")
    key :: (0..<32).map(n -> n as U8).collect()
    nonce :: (0..<12).map(n -> n as U8).collect()
    historical :: "historical anonymous migration".as_bytes()
    ciphertext :: ChaCha20Poly1305.new_from_slice(key).unwrap().encrypt(ChaNonce.from_slice(nonce), historical.as_slice()).unwrap()
    v1 := "JETC".as_bytes().to_vec()
    v1.extend_from_slice([U8]{1, 1})
    v1.extend_from_slice(nonce)
    v1.extend_from_slice(ciphertext)
    v1_source :: root.join("historical.jetc")
    fs.write(v1_source, v1).unwrap()
    migrate_stage_parent :: root.join("migrate-stage-parent")
    fs.create_dir(migrate_stage_parent).unwrap()
    migrated_stage :: migrate_stage_parent.join("migrated.jetc")
    replace_candidate_at("migrate-stage", migrate_stage_parent, "jetc-stage")
    jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], migrated_stage, never_cancelled).unwrap()
    assert_attacker_candidates(migrate_stage_parent, "jetc-stage")
    assert_not_attacker(migrated_stage)
    assert_eq(fs.read(v1_source).unwrap(), v1)
    migrate_output_parent :: root.join("migrate-output-parent")
    fs.create_dir(migrate_output_parent).unwrap()
    migrated_output :: migrate_output_parent.join("migrated.jetc")
    replace_candidate_at("migrate-output", migrate_output_parent, "jetc-output")
    jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], migrated_output, never_cancelled).unwrap()
    assert_attacker_candidates(migrate_output_parent, "jetc-output")
    assert_not_attacker(migrated_output)
    assert_ne(fs.read(migrated_output).unwrap(), historical)
    swapped_parent :: root.join("migrate-swapped-parent")
    moved_parent :: root.join("migrate-swapped-parent-moved")
    fs.create_dir(swapped_parent).unwrap()
    swapped_output :: swapped_parent.join("migrated.jetc")
    arm_publish_race(PublishRace.SwapParent("migrate-output", swapped_parent.clone(), moved_parent.clone()))
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public], swapped_output, never_cancelled), .Err(.DestinationIo))
    assert(!swapped_output.exists())
    assert(!moved_parent.join("migrated.jetc").exists())
    assert(fs.read_dir(moved_parent).unwrap().next().is_none())
    assert_eq(fs.read(v1_source).unwrap(), v1)
    PUBLISH_RACE.with(slot -> assert(slot.borrow().is_none()))
    jet_crypto_clear_file_boundary_test_observer()
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:1807
#Test("every_secret_bearing_nominal_zeroizes_on_drop") {
    observed :: Rc.new(RefCell.new([[U8]]{}))
    snapshots :: Rc.clone(observed)
    jet_crypto_set_zeroize_test_observer(bytes -> snapshots.borrow_mut().push(bytes.to_vec()))
    drop(Secret([U8].filled(17, 1)))
    drop(JetSigningKey([U8].filled(18, 2)))
    drop(JetX25519SecretKey([U8].filled(19, 3)))
    drop(JetSharedSecret([U8].filled(20, 4)))
    jet_crypto_clear_zeroize_test_observer()
    assert_eq(*observed.borrow(), [[U8].filled(17, 0), [U8].filled(18, 0), [U8].filled(19, 0), [U8].filled(20, 0)])
}
