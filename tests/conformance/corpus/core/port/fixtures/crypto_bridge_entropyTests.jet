use jet_pkg_model.Crypto.*
use jet_codegen.ExpiringSecret.[JetExpiringSecret, JetExpired]
use tests.conformance.corpus.core.port.fixtures.crypto_bridge_entropy.*
use std.[fs, env, process]
use std.cell.RefCell
use std.rc.Rc
// GATE #4494: real crypto providers, test-only entropy/fault injection, zeroization observers and filesystem.
// GATE #4483: Linux tests select the target OS, not the build host.

// Rust: tests/fixtures/crypto_bridge_entropy.rs:41
#Test("expiry_and_wrapper_drop_zeroize_owned_values") {
    struct ObservedSecret { bytes: [U8] }
    // Rust: tests/fixtures/crypto_bridge_entropy.rs:44
    impl Drop for ObservedSecret {
        fn drop(&self) -> { zeroize(&self.bytes) }
    }
    observed :: Rc.new(RefCell.new([[U8]]{}))
    snapshots :: Rc.clone(observed)
    jet_crypto_set_zeroize_test_observer(bytes -> snapshots.borrow_mut().push(bytes.to_vec()))
    clock :: ManualClock.new(0)
    expired := JetExpiringSecret.new(ObservedSecret{bytes: [U8].filled(17, 1)}, 0, clock.observer())
    clock.set(1)
    assert_eq(expired.with(_ -> ()), .Err(JetExpired))
    drop(expired)
    drop(JetExpiringSecret.new(ObservedSecret{bytes: [U8].filled(18, 2)}, 0, clock.observer()))
    jet_crypto_clear_zeroize_test_observer()
    assert_eq(*observed.borrow(), [[U8].filled(17, 0), [U8].filled(18, 0)])
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:260
#Test("file_crypto_error_projection_is_exhaustive_and_redacted") {
    public :: [JetFileCryptoError.OpenFailed, JetFileCryptoError.SealFailed(JetCryptoError.EntropyUnavailable), JetFileCryptoError.SourceIo, JetFileCryptoError.DestinationExists, JetFileCryptoError.DestinationIo]
    assert_eq(public.iter().map(file_error_tag).collect(), ["open-failed", "seal-failed", "source-io", "destination-exists", "destination-io"])
    assert_eq(file_error_tag(&JetFileCryptoError.Cancelled), "internal-cancelled")
    rendered :: public.iter().map(error -> error.to_string()).collect()
    assert_eq(rendered, ["encrypted file could not be opened", "encrypted file seal failed: the operating system could not provide cryptographic randomness", "encrypted file source I/O failed", "encrypted file destination already exists", "encrypted file destination I/O failed"])
    joined :: rendered.join("\n")
    loop forbidden in ["hunter2", "plaintext sentinel", "ciphertext sentinel", "/home/nate"] {
        assert(!joined.contains(forbidden), "file error leaked {forbidden}: {joined}")
    }
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:291
#Test("every_bridge_entropy_consumer_fails_without_output") {
    plaintext :: "secret".as_bytes().to_vec()
    fail_entropy()
    assert(jet_crypto_seal_typed_impl([JetX25519PublicKey([U8#32].filled(7))], plaintext, []) == .Err(JetCryptoError.EntropyUnavailable))
    jet_crypto_entropy_clear_test_provider()
    fail_entropy()
    assert_eq(jet_crypto_keygen_impl(), .Err("the operating system could not provide cryptographic randomness"))
    jet_crypto_entropy_clear_test_provider()
    fail_entropy()
    assert_eq(jet_crypto_password_hash_impl("password"), .Err("the operating system could not provide cryptographic randomness"))
    jet_crypto_entropy_clear_test_provider()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:317
#Test("entropy_failure_stays_typed_until_each_public_bridge_boundary") {
