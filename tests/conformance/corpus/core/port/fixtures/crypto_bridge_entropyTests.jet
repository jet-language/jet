// Rust: tests/fixtures/crypto_bridge_entropy.rs:575
#Test("argon2id_rfc_and_expert_known_answers_kill_argon2i_mutation") {
    rfc :: jet_pwhash_rfc9106_test_run().expect("canonical Argon2id worker")
    rfc_expected :: decode_hex("0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")
    assert_eq(rfc.bytes(), rfc_expected)
    params :: argon2.ParamsBuilder.new().m_cost(32).t_cost(3).p_cost(4)
        .data(argon2.AssociatedData.new([U8#12].filled(0x04)).unwrap()).build().unwrap()
    argon2i := [U8#32].filled(0)
    argon2.Argon2.new_with_secret([U8#8].filled(0x03), argon2.Algorithm.Argon2i, argon2.Version.V0x13, params).unwrap()
        .hash_password_into([U8#32].filled(0x01), [U8#16].filled(0x02), &argon2i).unwrap()
    assert_ne(argon2i.as_slice(), rfc_expected, "Argon2i mutation must fail the RFC oracle")
    password :: jet_crypto_secret_from_text_impl("password")
    actual :: jet_crypto_expert_argon2id_impl(&password, "somesalt".as_bytes().to_vec(), 65_536, 2, 1, 32).expect("canonical expert Argon2id worker")
    expected :: decode_hex("09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7")
    assert_eq(jet_crypto_expert_secret_bytes_impl(&actual), expected)
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:615
#Test("jetc_v1_expert_open_accepts_only_the_pinned_grammar") {
    source :: fs.read_to_string(env.manifest_dir().join("crates/jet-pkg-model/src/Prelude/Crypto.rs")).unwrap()
    loop retired in ["fn seal_with_algo(", "fn open_envelope(", "fn jet_crypto_seal_impl(", "fn jet_crypto_open_impl(", "fn jet_crypto_seal_algo_impl("] {
        assert(!source.contains(retired), "retired JETC v1 path remains: {retired}")
    }
    assert_eq(source.matches("pub fn jet_crypto_expert_open_v1_impl(").count(), 1)
    key :: (0..<32).map(n -> n as U8).collect()
    nonce :: (0..<12).map(n -> n as U8).collect()
    plaintext :: "historical JETC v1".as_bytes().to_vec()
    loop (algorithm, ciphertext) in [
        (1 as U8, ChaCha20Poly1305.new_from_slice(key).unwrap().encrypt(ChaNonce.from_slice(nonce), plaintext.as_slice()).map_err(_ -> JetCryptoError.OpenFailed)),
        (2 as U8, jet_crypto_expert_aes256gcm_seal_impl(key, nonce, plaintext, []))
    ] {
        encrypted :: ciphertext.expect("pinned v1 cipher")
        envelope := "JETC".as_bytes().to_vec()
        envelope.extend_from_slice([1 as U8, algorithm])
        envelope.extend_from_slice(nonce)
        envelope.extend_from_slice(encrypted)
        expected :: if algorithm == 1 -> "4a4554430101000102030405060708090a0be1927b744665cc23d6ef1fb9dd494d43bf41ffb4f45df6e23cf92a743b8c2c35892f"
            else -> "4a4554430102000102030405060708090a0b2f6ba56faa97ab78ec2db7c1f4bd3b4df5e703347885e9b8d1d5780ecb37c61ac49c"
        assert_eq(hex_encode(envelope), expected)
        assert_eq(jet_crypto_expert_open_v1_impl(key, envelope), .Ok(plaintext.clone()))
        loop mutation in 0..<5 {
            hostile := envelope.clone()
            if mutation == {
                0 -> { hostile[0] ^= 1 }
                1 -> { hostile[4] = 2 }
                2 -> { hostile[5] = 3 }
                3 -> { hostile[hostile.len() - 1] ^= 1 }
                4 -> { hostile.push(0) }
            }
            assert_eq(jet_crypto_expert_open_v1_impl(key, hostile), .Err(.OpenFailed))
        }
    }
    assert_eq(jet_crypto_expert_open_v1_impl([U8].filled(31, 0), [U8].filled(34, 0)), .Err(.OpenFailed))
    assert_eq(jet_crypto_expert_open_v1_impl(key, [U8].filled(33, 0)), .Err(.OpenFailed))
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:662
#Test("jetc_v1_migration_reseals_to_verified_v2_without_touching_source") {
    root :: test_dir("migration")
    key :: (0..<32).map(n -> n as U8).collect()
    nonce :: (0..<12).map(n -> n as U8).collect()
    plaintext :: "historical migration payload".as_bytes().to_vec()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    recipients :: [jet_crypto_x25519_public_typed_impl(&recipient)]
    loop (algorithm, ciphertext) in [
        (1 as U8, ChaCha20Poly1305.new_from_slice(key).unwrap().encrypt(ChaNonce.from_slice(nonce), plaintext.as_slice()).map_err(_ -> JetCryptoError.OpenFailed)),
        (2 as U8, jet_crypto_expert_aes256gcm_seal_impl(key, nonce, plaintext, []))
    ] {
        v1 := "JETC".as_bytes().to_vec()
        v1.extend_from_slice([1 as U8, algorithm])
        v1.extend_from_slice(nonce)
        v1.extend_from_slice(ciphertext.unwrap())
        source :: root.join("source-{algorithm}.jetc")
        migrated :: root.join("migrated-{algorithm}.jetc")
        restored :: root.join("restored-{algorithm}.bin")
        fs.write(source, v1).unwrap()
        jet_crypto_expert_migrate_v1_impl(key, source, recipients.clone(), migrated, never_cancelled).unwrap()
        assert_eq(fs.read(source).unwrap(), v1)
        assert_eq(fs.read(migrated).unwrap()[..8], [U8]{74, 69, 84, 67, 2, 1, 1, 0})
        jet_crypto_file_open_impl(&recipient, migrated, restored, never_cancelled).unwrap()
        assert_eq(fs.read(restored).unwrap(), plaintext)
    }
    source :: root.join("source-1.jetc")
    original :: fs.read(source).unwrap()
    existing :: root.join("existing.jetc")
    fs.write(existing, "keep".as_bytes()).unwrap()
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, source, recipients.clone(), existing, never_cancelled), .Err(.DestinationExists))
    assert_eq(fs.read(existing).unwrap(), "keep".as_bytes())
    assert_eq(fs.read(source).unwrap(), original)
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, source, recipients.clone(), source, never_cancelled), .Err(.DestinationExists))
    assert_eq(fs.read(source).unwrap(), original)
    wrong_output :: root.join("wrong-key.jetc")
    assert_eq(jet_crypto_expert_migrate_v1_impl([U8].filled(32, 9), source, recipients.clone(), wrong_output, never_cancelled), .Err(.OpenFailed))
    assert(!wrong_output.exists())
    hostile :: root.join("hostile.jetc")
    absent :: root.join("absent.jetc")
    fs.write(hostile, [U8]{74, 69, 84, 67, 1, 1, 98, 97, 100}).unwrap()
    assert_eq(jet_crypto_expert_migrate_v1_impl(key, hostile, recipients, absent, never_cancelled), .Err(.OpenFailed))
    assert(!absent.exists())
    assert(fs.read_dir(root).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".jetc-")))
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:763
#Test("bech32m_recipient_parser_rejects_hostile_noncanonical_text") {
    key :: JetX25519PublicKey([U8#32].filled(0))
    canonical :: jet_crypto_x25519_public_text_impl(&key)
    assert_eq(canonical.len(), 68)
    assert_eq(jet_crypto_x25519_public_from_text_impl(canonical.clone()).unwrap().0, [U8#32].filled(0))
    checksum := canonical.clone().into_bytes()
    replacement :: if checksum.last() == Val(113 as U8) -> 112 as U8 else -> 113 as U8
    checksum[checksum.len() - 1] = replacement
    loop hostile in [canonical.to_uppercase(), canonical[..67].to_string(), "{canonical}q",
        canonical.replacen("jetx25519", "jetx25518", 1), String.from_utf8(checksum).unwrap(), "jetx255191" + "q".repeat(58)] {
        assert(jet_crypto_x25519_public_from_text_impl(hostile).is_err())
    }
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:798
#Test("jetc_v2_streams_authenticated_chunks_and_publishes_without_overwrite") {
    root :: test_dir("roundtrip")
    source :: root.join("source.bin")
    envelope :: root.join("sealed.jetc")
    restored :: root.join("restored.bin")
    wrong_output :: root.join("wrong.bin")
    plain := [U8].filled(JETC_V2_CHUNK + 17, 0x5a)
    plain[0] = 1
    plain[JETC_V2_CHUNK] = 2
    fs.write(source, plain).unwrap()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    jet_crypto_file_seal_impl([public], source, envelope, never_cancelled).unwrap()
    encoded :: fs.read(envelope).unwrap()
    assert_eq(encoded[..8], [U8]{74, 69, 84, 67, 2, 1, 1, 0})
    header_len :: U32.from_le_bytes(encoded[8..12].try_into().unwrap()) as USize
    body_len :: U64.from_le_bytes(encoded[12..20].try_into().unwrap()) as USize
    assert_eq(header_len, JETC_V2_HEADER_BASE + JETC_V2_STANZA + 16)
    assert_eq(encoded.len(), 20 + header_len + body_len)
    body :: encoded[20 + header_len..]
    assert_eq(U32.from_le_bytes(body[..4].try_into().unwrap()), JETC_V2_CHUNK as U32)
    assert_eq(body[4], 0)
    final_at :: 5 + JETC_V2_CHUNK + 16
    assert_eq(U32.from_le_bytes(body[final_at..final_at + 4].try_into().unwrap()), 17)
    assert_eq(body[final_at + 4], 1)
    jet_crypto_file_open_impl(&recipient, envelope, restored, never_cancelled).unwrap()
    assert_eq(fs.read(restored).unwrap(), plain)
    wrong :: jet_crypto_x25519_generate_impl().unwrap()
    assert_eq(jet_crypto_file_open_impl(&wrong, envelope, wrong_output, never_cancelled), .Err(.OpenFailed))
    assert(!wrong_output.exists())
    fs.write(restored, "do not replace".as_bytes()).unwrap()
    assert_eq(jet_crypto_file_open_impl(&recipient, envelope, restored, never_cancelled), .Err(.DestinationExists))
    assert_eq(fs.read(restored).unwrap(), "do not replace".as_bytes())
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:863
#Test("jetc_v2_record_boundaries_are_canonical") {
    root :: test_dir("record-boundaries")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    loop (name, size, expected) in [
        ("empty", 0, [(0 as U32, 1 as U8)]),
        ("chunk-minus-one", JETC_V2_CHUNK - 1, [((JETC_V2_CHUNK - 1) as U32, 1 as U8)]),
        ("chunk", JETC_V2_CHUNK, [(JETC_V2_CHUNK as U32, 0 as U8), (0 as U32, 1 as U8)]),
        ("chunk-plus-one", JETC_V2_CHUNK + 1, [(JETC_V2_CHUNK as U32, 0 as U8), (1 as U32, 1 as U8)])
    ] {
        source :: root.join("{name}.bin")
        envelope :: root.join("{name}.jetc")
        restored :: root.join("{name}.out")
        plaintext :: (0..<size).map(index -> (index % 251) as U8).collect()
        fs.write(source, plaintext).unwrap()
        jet_crypto_file_seal_impl([public.clone()], source, envelope, never_cancelled).unwrap()
        encoded :: fs.read(envelope).unwrap()
        header_len :: U32.from_le_bytes(encoded[8..12].try_into().unwrap()) as USize
        body_len :: U64.from_le_bytes(encoded[12..20].try_into().unwrap())
        assert_eq(jetc_v2_plain_len(body_len), Val(size as U64))
        at := 20 + header_len
        records := [(U32, U8)]{}
        loop at < encoded.len() {
            length :: U32.from_le_bytes(encoded[at..at + 4].try_into().unwrap())
            flags :: encoded[at + 4]
            assert(jetc_v2_record_shape_valid(length as USize, flags))
            records.push((length, flags))
            at += 5 + length as USize + 16
        }
        assert_eq(at, encoded.len())
        assert_eq(records, expected)
        jet_crypto_file_open_impl(&recipient, envelope, restored, never_cancelled).unwrap()
        assert_eq(fs.read(restored).unwrap(), plaintext)
        assert_eq(fs.read(source).unwrap(), plaintext)
    }
    assert(fs.read_dir(root).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".jetc-")))
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:916
#Test("jetc_v2_rechecks_staged_snapshot_hash_and_eof_before_final") {
    if core.sys.target.selected_os() != "linux" { return }
    root :: test_dir("stage-recheck")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    expected :: "verified bytes".as_bytes()
    loop (name, staged, distinct_identity) in [
        ("identity", expected, true), ("changed", "tampered bytes".as_bytes(), false),
        ("trailing", "verified bytesattacker trailing bytes".as_bytes(), false)
    ] {
        destination :: root.join("{name}.jetc")
        parent :: hold_destination_parent(destination).unwrap()
        stage := create_unlinked_stage(parent).unwrap()
        stage.write_all(staged).unwrap()
        stage.sync_all().unwrap()
        identity_stage :: distinct_identity.then(() -> {
            file := create_unlinked_stage(parent).unwrap()
            file.write_all(expected).unwrap()
            file.sync_all().unwrap()
            file
        })
        metadata :: identity_stage.as_ref().unwrap_or(&stage).metadata().unwrap()
        stage.seek(std.io.SeekFrom.Start(0)).unwrap()
        assert_eq(seal_jetc_v2_from_snapshot([jet_crypto_x25519_public_typed_impl(&recipient)],
            JetcSnapshot{file: ^stage, length: expected.len() as U64, hash: Sha256.digest(expected).into(), metadata: metadata},
            parent, destination, never_cancelled, false), .Err(.SourceIo), "stage {name}")
        assert(!destination.exists())
    }
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:964
#Test("jetc_v2_streams_exact_max_and_rejects_oversize_before_staging") {
    if core.sys.target.selected_os() != "linux" { return }
    root :: test_dir("oversize-source")
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    public :: jet_crypto_x25519_public_typed_impl(&recipient)
    exact :: root.join("exact-max.bin")
    exact_destination :: root.join("exact-max.jetc")
    sparse := fs.File.create(exact).unwrap()
    sparse.write_all("exact-max-source".as_bytes()).unwrap()
    sparse.set_len(JETC_V2_MAX_PLAINTEXT).unwrap()
    drop(sparse)
    assert_eq(fs.metadata(exact).unwrap().len(), JETC_V2_MAX_PLAINTEXT)
    arm_eof_after("seal-source-read", 1)
    assert_eq(jet_crypto_file_seal_impl([public.clone()], exact, exact_destination, never_cancelled), .Err(.SourceIo))
    assert(jet_crypto_file_io_test_hits() >= 2, "exact maximum must enter bounded streaming")
    jet_crypto_clear_file_io_test_fault()
    assert(!exact_destination.exists())
    source :: root.join("over-max.bin")
    destination :: root.join("over-max.jetc")
    oversized := fs.File.create(source).unwrap()
    oversized.write_all("oversize-source".as_bytes()).unwrap()
    oversized.seek(std.io.SeekFrom.Start(JETC_V2_MAX_PLAINTEXT)).unwrap()
    oversized.write_all([U8]{0x7f}).unwrap()
    drop(oversized)
    assert_eq(fs.metadata(source).unwrap().len(), JETC_V2_MAX_PLAINTEXT + 1)
    arm_oversize_boundary_trap()
    assert_eq(jet_crypto_file_seal_impl([public], source, destination, cancel_at_boundary), .Err(.SourceIo))
    jet_crypto_clear_file_boundary_test_observer()
    OVERSIZE_BOUNDARY_HIT.with(hit -> assert(!hit.get()))
    CANCEL_NOW.with(cancel -> assert(!cancel.get()))
    assert(!destination.exists())
    assert_eq(fs.metadata(source).unwrap().len(), JETC_V2_MAX_PLAINTEXT + 1)
    preserved := fs.File.open(source).unwrap()
    prefix := [U8#15].filled(0)
    preserved.read_exact(&prefix).unwrap()
    assert_eq(prefix, "oversize-source".as_bytes())
    preserved.seek(std.io.SeekFrom.Start(JETC_V2_MAX_PLAINTEXT)).unwrap()
    marker := [U8#1].filled(0)
    preserved.read_exact(&marker).unwrap()
    assert_eq(marker, [U8]{0x7f})
    assert(fs.read_dir(root).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".jetc-")))
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:1028
#Test("jetc_v2_rejects_tamper_truncation_append_and_cancellation_without_output") {
    root :: test_dir("hostile")
    source :: root.join("source.bin")
    envelope :: root.join("sealed.jetc")
    fs.write(source, "authenticated file".as_bytes()).unwrap()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    jet_crypto_file_seal_impl([jet_crypto_x25519_public_typed_impl(&recipient)], source, envelope, never_cancelled).unwrap()
    canonical :: fs.read(envelope).unwrap()
    header_len :: U32.from_le_bytes(canonical[8..12].try_into().unwrap()) as USize
    body_at :: 20 + header_len
    assert_eq(jetc_v2_body_len(0), Val(21))
    assert_eq(jetc_v2_body_len((JETC_V2_CHUNK - 1) as U64), Val(JETC_V2_CHUNK as U64 + 20))
    assert_eq(jetc_v2_body_len(JETC_V2_CHUNK as U64), Val(JETC_V2_CHUNK as U64 + 42))
    assert_eq(jetc_v2_body_len(JETC_V2_CHUNK as U64 + 1), Val(JETC_V2_CHUNK as U64 + 43))
    assert_eq(jetc_v2_body_len(JETC_V2_MAX_PLAINTEXT), Val(JETC_V2_MAX_BODY_LEN))
    assert_eq(jetc_v2_body_len(JETC_V2_MAX_PLAINTEXT + 1), None)
    assert_eq(jetc_v2_plain_len(20), None)
    assert_eq(jetc_v2_plain_len(JETC_V2_CHUNK as U64 + 21), None)
    assert_eq(jetc_v2_plain_len(JETC_V2_MAX_BODY_LEN), Val(JETC_V2_MAX_PLAINTEXT))
    assert_eq(jetc_v2_plain_len(JETC_V2_MAX_BODY_LEN + 1), None)
    assert(jetc_v2_record_shape_valid(JETC_V2_CHUNK, 0))
    assert(jetc_v2_record_shape_valid(0, 1))
    assert(jetc_v2_record_shape_valid(JETC_V2_CHUNK - 1, 1))
    assert(!jetc_v2_record_shape_valid(JETC_V2_CHUNK - 1, 0))
    assert(!jetc_v2_record_shape_valid(JETC_V2_CHUNK, 1))
    assert(!jetc_v2_record_shape_valid(0, 2))
    assert(jetc_v2_container_len_matches(20 + header_len as U64 + JETC_V2_MAX_BODY_LEN, header_len, JETC_V2_MAX_BODY_LEN))
    assert(!jetc_v2_container_len_matches(21 + header_len as U64 + JETC_V2_MAX_BODY_LEN, header_len, JETC_V2_MAX_BODY_LEN + 1))
    loop name in ["tampered", "truncated", "appended", "v1", "kind", "suite", "fixed-flags", "header-cap",
        "body-cap", "chunk-size", "recipient-zero", "recipient-cap", "metadata", "recipient-id", "zero-public", "record-length", "record-flags"] {
        hostile := canonical.clone()
        if name == {
            "tampered" -> { hostile[hostile.len() - 1] ^= 1 }
            "truncated" -> { _ :: hostile.pop() }
            "appended" -> { hostile.push(0) }
            "v1" -> { hostile[4] = 1 }
            "kind" -> { hostile[5] = 2 }
            "suite" -> { hostile[6] = 2 }
            "fixed-flags" -> { hostile[7] = 1 }
            "header-cap" -> { hostile[8..12].copy_from_slice((32 as U32 * 1024 * 1024 + 1).to_le_bytes()) }
            "body-cap" -> { hostile[12..20].copy_from_slice((JETC_V2_MAX_BODY_LEN + 1).to_le_bytes()) }
            "chunk-size" -> { hostile[84..88].copy_from_slice((1 as U32).to_le_bytes()) }
            "recipient-zero" -> { hostile[88..90].copy_from_slice((0 as U16).to_le_bytes()) }
            "recipient-cap" -> { hostile[88..90].copy_from_slice((257 as U16).to_le_bytes()) }
            "metadata" -> { hostile[90..94].copy_from_slice((1 as U32).to_le_bytes()) }
            "recipient-id" -> { hostile[94] ^= 1 }
            "zero-public" -> { hostile[110..142].fill(0) }
            "record-length" -> { hostile[body_at..body_at + 4].copy_from_slice((JETC_V2_CHUNK as U32 + 1).to_le_bytes()) }
            "record-flags" -> { hostile[body_at + 4] = 2 }
        }
        input :: root.join("{name}.jetc")
        output :: root.join("{name}.out")
        fs.write(input, hostile).unwrap()
        assert_eq(jet_crypto_file_open_impl(&recipient, input, output, never_cancelled), .Err(.OpenFailed))
        assert(!output.exists())
    }
    cancelled :: root.join("cancelled.out")
    assert_eq(jet_crypto_file_open_impl(&recipient, envelope, cancelled, always_cancelled), .Err(.Cancelled))
    assert(!cancelled.exists())
    fs.remove_dir_all(root).unwrap()
}

