}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:350
#Test("prior_crypto_suite_still_uses_live_entropy") {
    plaintext :: "round trip".as_bytes().to_vec()
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    envelope :: jet_crypto_seal_typed_impl([jet_crypto_x25519_public_typed_impl(&recipient)], plaintext, []).unwrap()
    assert_eq(jet_crypto_open_typed_impl(&recipient, envelope, []).unwrap(), plaintext)
    (seed, public) :: jet_crypto_keygen_impl().unwrap()
    assert_eq(seed.len(), 32)
