    loop boundary in ["seal-stage", "seal-output", "seal-record", "seal-final", "seal-before-publish"] {
        output :: root.join("{boundary}.jetc")
        arm_cancellation(boundary)
        assert_eq(jet_crypto_file_seal_impl([public.clone()], source, output, cancel_at_boundary), .Err(.Cancelled), "seal cancellation boundary {boundary}")
        assert_cancellation_fired()
        assert(!output.exists())
    }
    loop boundary in ["open-output", "open-record", "open-before-publish"] {
        output :: root.join("{boundary}.bin")
        arm_cancellation(boundary)
        assert_eq(jet_crypto_file_open_impl(&recipient, envelope, output, cancel_at_boundary), .Err(.Cancelled), "open cancellation boundary {boundary}")
        assert_cancellation_fired()
        assert(!output.exists())
    }
    key :: (0..<32).map(n -> n as U8).collect()
    nonce :: (0..<12).map(n -> n as U8).collect()
    ciphertext :: ChaCha20Poly1305.new_from_slice(key).unwrap().encrypt(ChaNonce.from_slice(nonce), plaintext.as_slice()).unwrap()
    v1 := "JETC".as_bytes().to_vec()
