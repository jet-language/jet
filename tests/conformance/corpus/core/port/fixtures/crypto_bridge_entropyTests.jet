    loop boundary in ["migrate-v1-read", "migrate-stage", "migrate-output", "migrate-record", "migrate-final", "migrate-verify-record", "migrate-before-publish"] {
        output :: root.join("{boundary}.jetc")
        arm_cancellation(boundary)
        assert_eq(jet_crypto_expert_migrate_v1_impl(key, v1_source, [public.clone()], output, cancel_at_boundary), .Err(.Cancelled), "migration cancellation boundary {boundary}")
        assert_cancellation_fired()
        assert(!output.exists())
        assert_eq(fs.read(v1_source).unwrap(), v1)
    }
    jet_crypto_clear_file_boundary_test_observer()
    assert(fs.read_dir(root).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".jetc-")))
    fs.remove_dir_all(root).unwrap()
}

