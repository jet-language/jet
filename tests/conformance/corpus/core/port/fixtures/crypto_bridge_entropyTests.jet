    assert(jet_crypto_password_verify_impl("password", stored))
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:372
#Test("keygen_zeroizes_provider_copy_and_stack_seed") {
    zeroized :: Rc.new(RefCell.new([[U8]]{}))
    observed :: Rc.clone(zeroized)
    jet_crypto_entropy_set_zeroize_test_observer(bytes -> {
        if bytes.len() == 32 { observed.borrow_mut().push(bytes.to_vec()) }
    })
    (seed, public) :: jet_crypto_keygen_impl().unwrap()
    jet_crypto_entropy_clear_zeroize_test_observer()
    assert_eq(seed.len(), 32)
    assert_eq(public.len(), 32)
    assert(seed.iter().any(byte -> byte != 0))
    assert(zeroized.borrow().len() >= 2)
    assert(zeroized.borrow().iter().all(snapshot -> snapshot == [U8].filled(32, 0)))
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:393
#Test("typed_recipient_envelopes_are_canonical_and_fail_closed") {
    alice :: jet_crypto_x25519_generate_impl().unwrap()
    bob :: jet_crypto_x25519_generate_impl().unwrap()
    wrong :: jet_crypto_x25519_generate_impl().unwrap()
    plain :: "purpose-bound payload".as_bytes().to_vec()
    aad :: "tenant-7".as_bytes().to_vec()
    sealed :: jet_crypto_seal_typed_impl([jet_crypto_x25519_public_typed_impl(&bob), jet_crypto_x25519_public_typed_impl(&alice)], plain, aad).unwrap()
    bytes :: jet_crypto_sealed_bytes_impl(&sealed)
    assert_eq(bytes[..4], "JETV".as_bytes())
    unsupported_version := bytes.clone()
    unsupported_version[4] = 2
    assert(jet_crypto_sealed_from_bytes_impl(unsupported_version) == .Err(JetCryptoError.UnsupportedVersion{operation: "Sealed.from_bytes", version: 2}))
    unsupported_algorithm := bytes.clone()
    unsupported_algorithm[5] = 3
    if jet_crypto_sealed_from_bytes_impl(unsupported_algorithm) == {
        .Err(.UnsupportedAlgorithm(operation, algorithm)) -> { assert_eq(operation, "Sealed.from_bytes"); assert_eq(algorithm, "3") }
        else -> panic("JETV suite id must remain public")
    }
    assert_eq(jet_crypto_open_typed_impl(&alice, jet_crypto_sealed_from_bytes_impl(bytes.clone()).unwrap(), aad).unwrap(), plain)
    assert_eq(jet_crypto_open_typed_impl(&wrong, jet_crypto_sealed_from_bytes_impl(bytes.clone()).unwrap(), aad), .Err(JetCryptoError.OpenFailed))
    assert_eq(jet_crypto_open_typed_impl(&alice, jet_crypto_sealed_from_bytes_impl(bytes.clone()).unwrap(), "wrong".as_bytes().to_vec()), .Err(JetCryptoError.OpenFailed))
    tampered := bytes
    tampered[tampered.len() - 1] ^= 1
    assert_eq(jet_crypto_open_typed_impl(&alice, jet_crypto_sealed_from_bytes_impl(tampered).unwrap(), aad), .Err(JetCryptoError.OpenFailed))
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:418
#Test("typed_secret_wrap_sign_kdf_and_password_paths_preserve_roles") {
    recipient :: jet_crypto_x25519_generate_impl().unwrap()
    secret :: jet_crypto_secret_from_text_impl("do not print")
    wrapped :: jet_crypto_wrap_typed_impl(&secret, jet_crypto_x25519_public_typed_impl(&recipient)).unwrap()
    bytes :: jet_crypto_wrapped_bytes_impl(&wrapped)
    assert_eq(bytes[..4], "JETW".as_bytes())
    unwrapped :: jet_crypto_unwrap_typed_impl(&recipient, jet_crypto_wrapped_from_bytes_impl(bytes).unwrap()).unwrap()
    assert(jet_crypto_constant_time_secret_impl(&secret, &unwrapped))
    derived :: jet_crypto_hkdf_typed_impl(&secret, [], "domain".as_bytes().to_vec(), 32).unwrap()
    assert(!jet_crypto_constant_time_secret_impl(&secret, &derived))
    assert_eq(jet_crypto_hkdf_typed_impl(&secret, [], [], -1).err().unwrap().to_string(), "hkdf_sha256: output length must be 0..8160; got -1")
    signing :: jet_crypto_signing_generate_impl().unwrap()
    message :: "release".as_bytes().to_vec()
    signature :: jet_crypto_sign_typed_impl(&signing, message).unwrap()
    assert(jet_crypto_verify_typed_impl(jet_crypto_signing_public_impl(&signing), message, signature).unwrap())
    stored :: jet_crypto_password_hash_typed_impl(&secret).unwrap()
    assert(jet_crypto_password_verify_typed_impl(&secret, &stored).unwrap())
    weak_memory :: stored.0.replacen("m=65536", "m=4096", 1)
    assert(jet_crypto_password_parse_impl(weak_memory) == .Err(.PasswordPolicy(_)))
    extra_parameter :: stored.0.replacen(",p=1$", ",p=1,x=1$", 1)
    assert(jet_crypto_password_parse_impl(extra_parameter.clone()) == .Err(.InvalidEncoding("PasswordHash.parse", "PHC parameters")))
    assert(jet_crypto_password_verify_typed_impl(&secret, &JetPasswordHash(extra_parameter)) == .Err(.InvalidEncoding("password_verify", "PHC parameters")))
    wrong_algorithm :: JetPasswordHash(stored.0.replacen("$argon2id$", "$argon2i$", 1))
    assert_eq(jet_crypto_password_verify_typed_impl(&secret, &wrong_algorithm), .Err(.UnsupportedAlgorithm("password_verify", "argon2i")))
    if jet_crypto_password_parse_impl(wrong_algorithm.0) == {
        .Err(.UnsupportedAlgorithm(operation, algorithm)) -> { assert_eq(operation, "PasswordHash.parse"); assert_eq(algorithm, "argon2i") }
        else -> panic("argon2i must remain a typed unsupported algorithm")
    }
    wrong_d :: JetPasswordHash(stored.0.replacen("$argon2id$", "$argon2d$", 1))
    assert_eq(jet_crypto_password_verify_typed_impl(&secret, &wrong_d), .Err(.UnsupportedAlgorithm("password_verify", "argon2d")))
    unknown :: JetPasswordHash(stored.0.replacen("$argon2id$", "$argon2x$", 1))
    assert_eq(jet_crypto_password_verify_typed_impl(&secret, &unknown), .Err(.UnsupportedAlgorithm("password_verify", "argon2x")))
    wrong_version :: JetPasswordHash(stored.0.replacen("$v=19$", "$v=16$", 1))
    assert_eq(jet_crypto_password_verify_typed_impl(&secret, &wrong_version), .Err(.UnsupportedVersion("password_verify", 16)))
    assert(jet_crypto_password_parse_impl(wrong_version.0) == .Err(.UnsupportedVersion("PasswordHash.parse", 16)))
    wide_version :: JetPasswordHash(stored.0.replacen("$v=19$", "$v=300$", 1))
    assert_eq(jet_crypto_password_verify_typed_impl(&secret, &wide_version), .Err(.UnsupportedVersion("password_verify", 300)))
    wrong :: jet_crypto_secret_from_text_impl("wrong")
    stored_again :: jet_crypto_password_hash_typed_impl(&secret).unwrap()
    assert(!jet_crypto_password_verify_typed_impl(&wrong, &stored_again).unwrap())
}

// Rust: tests/fixtures/crypto_bridge_entropy.rs:470
#Test("expert_surface_matches_reference_vectors_and_bounds") {
    key :: [U8].filled(32, 0x80)
    xnonce :: [U8].filled(24, 0x24)
    anonce :: [U8].filled(12, 0x12)
    message :: "expert crypto".as_bytes().to_vec()
    aad :: "tenant".as_bytes().to_vec()
    xsealed :: jet_crypto_expert_xchacha20poly1305_seal_impl(key, xnonce, message, aad).unwrap()
    assert_eq(jet_crypto_expert_xchacha20poly1305_open_impl(key, xnonce, xsealed, aad).unwrap(), message)
    asealed :: jet_crypto_expert_aes256gcm_seal_impl(key, anonce, message, aad).unwrap()
    assert_eq(jet_crypto_expert_aes256gcm_open_impl(key, anonce, asealed, aad).unwrap(), message)
    assert_eq(jet_crypto_expert_xchacha20poly1305_open_impl(key, xnonce, xsealed, "wrong".as_bytes().to_vec()), .Err(.OpenFailed))
    assert(jet_crypto_expert_aes256gcm_seal_impl(key, xnonce, message, aad) == .Err(.InvalidLength(_, "nonce", _, _)))
    seed :: decode_hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    public :: decode_hex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    expected :: decode_hex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    signature :: jet_crypto_expert_ed25519_sign_impl(seed, []).unwrap()
    assert_eq(jet_crypto_signature_bytes_impl(&signature), expected)
    assert(jet_crypto_expert_ed25519_verify_strict_impl(public, [], expected).unwrap())
    alice_secret :: decode_hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    bob_public :: decode_hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
    shared_expected :: decode_hex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    shared :: jet_crypto_expert_x25519_impl(alice_secret, bob_public, true).unwrap()
    assert(jet_crypto_constant_time_secret_impl(&shared, &jet_crypto_secret_from_bytes_impl(shared_expected)))
    assert(jet_crypto_expert_x25519_impl(alice_secret, [U8].filled(32, 0), true) == .Err(.NonContributoryKey))
    ikm :: [U8].filled(22, 0x0b)
    salt :: decode_hex("000102030405060708090a0b0c")
    info :: decode_hex("f0f1f2f3f4f5f6f7f8f9")
    expected_okm :: decode_hex("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
    okm :: jet_crypto_expert_hkdf_sha256_impl(ikm, salt, info, 42).unwrap()
    assert(jet_crypto_constant_time_secret_impl(&okm, &jet_crypto_secret_from_bytes_impl(expected_okm)))
    assert(jet_crypto_expert_hkdf_sha256_impl(ikm, salt, info, 8161) == .Err(.OutputLength(_, _, _, _)))
    assert_eq(jet_crypto_expert_hkdf_sha256_impl(ikm, salt, info, -1).err().unwrap().to_string(), "expert.hkdf_sha256_raw: output length must be 0..8160; got -1")
    password :: jet_crypto_secret_from_text_impl("password")
    derived :: jet_crypto_expert_argon2id_impl(&password, "12345678".as_bytes().to_vec(), 8192, 1, 1, 32).unwrap()
    assert_eq(jet_crypto_expert_secret_bytes_impl(&derived).len(), 32)
    assert(jet_crypto_expert_argon2id_impl(&password, "short".as_bytes().to_vec(), 8192, 1, 1, 32) == .Err(.InvalidLength(_, "salt", _, _)))
    assert_eq(jet_crypto_expert_argon2id_impl(&password, "12345678".as_bytes().to_vec(), 8192, 1, 1, -1).err().unwrap().to_string(), "expert.argon2id: output length must be 16..64; got -1")
}

