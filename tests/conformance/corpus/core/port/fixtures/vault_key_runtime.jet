use jet_foundation.RuntimeDiagnosticCore.*
use jet_foundation.Outcome.*
use core.crypto.runtime.top_crypto_entropy.*
use jet_pkg_model.Crypto.*
use jet_pkg_model.VaultNfc.*
use jet_pkg_model.SecretsCrypto.*
use std.fs as fs
use std.env as env
use std.process as process
use std.time.[SystemTime, UNIX_EPOCH]
// GATE #4494 native filesystem, process and clock operations use std names.

// Rust: tests/fixtures/vault_key_runtime.rs:15
fn scratch(tag: String) -> OSPath {
    path :: env.temp_dir().join("jet-vault-key-{tag}-{process.id()}-{SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}")
    fs.create_dir_all(path.join(".jet")).unwrap()
    path
}

// Rust: tests/fixtures/vault_key_runtime.rs:28
fn provision(root: OSPath) -> {
    keys :: root.join("keys")
    fs.create_dir(keys).unwrap()
    (identity, recipient) :: jet_vault_keygen_impl()
    fs.write(keys.join("secrets.identity"), identity).unwrap()
    fs.write(root.join(".jet/secrets-recipients"), "{recipient}\n").unwrap()
}

// Rust: tests/fixtures/vault_key_runtime.rs:36
fn decoded_store(root: OSPath) -> JetVaultStore {
    identity :: fs.read_to_string(root.join("keys/secrets.identity")).unwrap()
    ciphertext :: fs.read(root.join(".jet/secrets.age")).unwrap()
    plaintext :: jet_vault_decrypt_impl(&identity, &ciphertext).unwrap()
    jet_vault_decode_v2(&plaintext).unwrap()
}
