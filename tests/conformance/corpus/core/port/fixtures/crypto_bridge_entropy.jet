// Rust: tests/fixtures/crypto_bridge_entropy.rs:222
fn assert_attacker_candidates(parent: OSPath, prefix: String) -> {
    assert_eq(fs.read(parent.join(".{prefix}-attacker")).unwrap(), "attacker-replacement".as_bytes())
    assert_eq(fs.read(parent.join(".{prefix}-attacker-moved")).unwrap(), "attacker-original".as_bytes())
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:228
fn assert_not_attacker(path: OSPath) -> {
    bytes :: fs.read(path).unwrap()
    assert_ne(bytes, "attacker-original".as_bytes())
    assert_ne(bytes, "attacker-replacement".as_bytes())
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:234
fn decode_hex(text: String) -> [U8] {
    text.as_bytes().chunks_exact(2).map(pair -> {
        digit :: (byte: U8) -> if byte == {
            48..=57 -> byte - 48
            97..=102 -> byte - 97 + 10
            else -> panic("invalid test hex")
        }
        digit(pair[0]) << 4 | digit(pair[1])
    }).collect()
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:248
fn file_error_tag(error: &crypto.JetFileCryptoError) -> String {
    if error == {
        .OpenFailed -> "open-failed"
        .SealFailed(_) -> "seal-failed"
        .SourceIo -> "source-io"
        .DestinationExists -> "destination-exists"
        .DestinationIo -> "destination-io"
        .Cancelled -> "internal-cancelled"
    }
}
