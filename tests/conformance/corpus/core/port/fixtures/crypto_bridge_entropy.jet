fn never_cancelled() -> Bool { false }
// Rust: tests/fixtures/crypto_bridge_entropy.rs:784
fn always_cancelled() -> Bool { true }
// Rust: tests/fixtures/crypto_bridge_entropy.rs:786
fn test_dir(name: String) -> OSPath {
    path :: env.temp_dir().join("jetc-v2-{name}-{process.id()}-{std.thread.current().id()}")
    _ :: fs.remove_dir_all(path)
    fs.create_dir(path).unwrap()
    path
}
