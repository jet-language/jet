// Rust: tests/fixtures/crypto_bridge_entropy.rs:83
// Linux test state only, thread-local to preserve concurrent fixture isolation.
enum PublishRace {
    SwapParent(at: String, parent: OSPath, moved: OSPath)
    CreateDestination(at: String, destination: OSPath)
    ReplaceCandidate(at: String, parent: OSPath, prefix: String)
    AppendFile(at: String, path: OSPath)
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:91
PUBLISH_RACE :: Local<RefCell<PublishRace?>>.new(() -> RefCell.new(None))
CANCEL_BOUNDARY :: Local<RefCell<String?>>.new(() -> RefCell.new(None))
CANCEL_NOW :: Local<Cell<Bool>>.new(() -> Cell.new(false))
OVERSIZE_BOUNDARY_HIT :: Local<Cell<Bool>>.new(() -> Cell.new(false))
// Rust: tests/fixtures/crypto_bridge_entropy.rs:99
fn publication_race(created: String) -> {
    PUBLISH_RACE.with(slot -> {
        state := slot.borrow_mut()
        ready :: if state.as_ref() == {
            Val(.SwapParent(at, _, _)) -> at == created
            Val(.CreateDestination(at, _)) -> at == created
            Val(.ReplaceCandidate(at, _, _)) -> at == created
            Val(.AppendFile(at, _)) -> at == created
            None -> false
        }
        if !ready { return }
        if state.take().unwrap() == {
            .SwapParent(_, parent, moved) -> {
                fs.rename(parent, moved).unwrap()
                fs.create_dir(parent).unwrap()
            }
            .CreateDestination(_, destination) -> { fs.write(destination, "racer".as_bytes()).unwrap() }
            .ReplaceCandidate(_, parent, prefix) -> {
                assert(fs.read_dir(parent).unwrap().all(entry -> !entry.unwrap().file_name().to_string_lossy().starts_with(".{prefix}-")))
                candidate :: parent.join(".{prefix}-attacker")
                moved :: parent.join(".{prefix}-attacker-moved")
                fs.write(candidate, "attacker-original".as_bytes()).unwrap()
                fs.rename(candidate, moved).unwrap()
                fs.write(candidate, "attacker-replacement".as_bytes()).unwrap()
            }
            .AppendFile(_, path) -> { fs.OpenOptions.new().append(true).open(path).unwrap().write_all("trailing byte".as_bytes()).unwrap() }
        }
    })
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:138
fn arm_publish_race(action: PublishRace) -> {
    PUBLISH_RACE.with(slot -> { *slot.borrow_mut() = Val(action) })
    crypto.jet_crypto_set_file_boundary_test_observer(publication_race)
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:144
fn cancellation_boundary(observed: String) -> {
    CANCEL_BOUNDARY.with(slot -> {
        if slot.borrow().is_some_and(boundary -> boundary == observed) {
            _ :: slot.borrow_mut().take()
            CANCEL_NOW.with(cancel -> cancel.set(true))
        }
    })
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:154
fn arm_cancellation(boundary: String) -> {
    CANCEL_BOUNDARY.with(slot -> { *slot.borrow_mut() = Val(boundary) })
    CANCEL_NOW.with(cancel -> cancel.set(false))
    crypto.jet_crypto_set_file_boundary_test_observer(cancellation_boundary)
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:161
fn cancel_at_boundary() -> Bool { CANCEL_NOW.with(cancel -> cancel.get()) }
// Rust: tests/fixtures/crypto_bridge_entropy.rs:166
fn assert_cancellation_fired() -> {
    CANCEL_BOUNDARY.with(slot -> assert(slot.borrow().is_none()))
    CANCEL_NOW.with(cancel -> assert(cancel.get()))
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:172
fn record_oversize_boundary(observed: String) -> {
    if observed == "seal-stage" || observed == "seal-output" {
        OVERSIZE_BOUNDARY_HIT.with(hit -> hit.set(true))
        CANCEL_NOW.with(cancel -> cancel.set(true))
    }
}
// Rust: tests/fixtures/crypto_bridge_entropy.rs:180
fn arm_oversize_boundary_trap() -> {
    OVERSIZE_BOUNDARY_HIT.with(hit -> hit.set(false))
    CANCEL_NOW.with(cancel -> cancel.set(false))
    crypto.jet_crypto_set_file_boundary_test_observer(record_oversize_boundary)
}
