// Rust: tests/fixtures/crypto_bridge_entropy.rs:17
struct ManualClock {
    now: Arc<AtomicI64>
    // Rust: tests/fixtures/crypto_bridge_entropy.rs:22
    fn new(now: I64) -> ManualClock { ManualClock{now: Arc.new(AtomicI64.new(now))} }
    // Rust: tests/fixtures/crypto_bridge_entropy.rs:28
    fn set(&self, now: I64) -> { self.now.store(now, Ordering.Relaxed) }
    // Rust: tests/fixtures/crypto_bridge_entropy.rs:32
    fn observer(&self) -> fn() -> I64 {
        now :: Arc.clone(self.now)
        () -> now.load(Ordering.Relaxed)
    }
}
