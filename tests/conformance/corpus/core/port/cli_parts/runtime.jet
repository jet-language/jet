use tests.cli.*
use std.fs as fs
use std.process.[Command, Output]
use std.env as env
use jet.CLI
use jet.Syntax

// Rust: tests/cli_parts/runtime.rs:411
// Run twice so the second check replays its receipt.
fn check_twice(dir: OSPath, args: [String]) -> [String] {
    run :: () -> {
        // GATE #4494: retained native process descriptors and environment.
        output :: Command.new(jet()).args(args).current_dir(dir)
            .env("JET_RECEIPT_DIR", dir.join(".jet/receipts"))
            .env_remove("JET_RECEIPT_BYPASS").env("NO_COLOR", "1").env("TERM", "dumb")
            .output().unwrap()
        assert(output.status.success(), "jet {args:Debug} failed:\n{String.from_utf8_lossy(output.stderr)}")
        "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}"
    }
    [run(), run()]
}

// Rust: tests/cli_parts/runtime.rs:868
fn help_stdout(args: [String]) -> String {
    // GATE #4494: native subprocess execution.
    out :: Command.new(jet()).args(args).env("NO_COLOR", "1").output().unwrap()
    assert(out.status.success(), "jet {args:Debug} failed: {out:Debug}")
    String.from_utf8_lossy(out.stdout).replace(env.package_version(), "VERSION")
}

// Rust: tests/cli_parts/runtime.rs:879
fn listed_commands(screen: String, heading: String) -> [String] {
    section :: screen.split_once(heading).unwrap_or_else(() -> panic("missing `{heading}` section:\n{screen}")).1
    section.lines().take_while(line -> !line.is_empty())
        .filter_map(line -> line.strip_prefix("  jet "))
        .map(rest -> rest.split_whitespace().next().unwrap().to_string()).collect()
}

