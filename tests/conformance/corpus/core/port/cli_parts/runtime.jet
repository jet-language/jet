//RS         &file,
//RS         r#"use core.encoding.json as json
//RS 
//RS pub fn show() Never! {
//RS     data :: json.parse(`{"a":1}`) ?? panic("json")
//RS     r :: json.canonical(data)
//RS     print(r)
//RS }
//RS 
//RS pub fn sign() -> String {
//RS     data :: json.parse(`{"a":1}`)
//RS     r :: json.canonical(data)
//RS     r
//RS }
//RS 
//RS pub fn already_migrated() Never! {
//RS     data :: json.parse(`{"a":1}`) ?? panic("json")
//RS     r :: json.canonical(data) ?? panic("value is not canonical JSON")
//RS     print(r)
//RS }
//RS "#,
//RS     )
//RS     .unwrap();
//RS 
//RS     let run_fix = |file: &Path| -> String {
//RS         let out = Command::new(jet())
//RS             .args(["fix", file.to_str().unwrap(), "--edition=2027"])
//RS             .output()
//RS             .unwrap();
//RS         assert!(
//RS             out.status.success(),
//RS             "jet fix failed:\nstdout: {}\nstderr: {}",
//RS             String::from_utf8_lossy(&out.stdout),
//RS             String::from_utf8_lossy(&out.stderr)
//RS         );
//RS         fs::read_to_string(file).unwrap()
//RS     };
//RS 
//RS     let after_first = run_fix(&file);
//RS     assert!(
//RS         after_first.contains("json.canonical(data) ?? panic(\"value is not canonical JSON\")\n    print(r)\n}\n\npub fn sign"),
//RS         "infallible fn `show` must get the panic fallback:\n{after_first}"
//RS     );
//RS     assert!(
//RS         after_first.contains("r :: json.canonical(data)\n    r\n}"),
//RS         "fallible fn `sign` must use automatic propagation, not a panic fallback:\n{after_first}"
//RS     );
//RS     assert!(
//RS         !after_first.contains("value is not canonical JSON\") ?? panic"),
//RS         "an already-migrated call must not be rewritten twice:\n{after_first}"
//RS     );
//RS 
//RS     // Re-running the migration must be a byte-identical no-op — this is the
//RS     // idempotency the space-before-`??` bug broke.
//RS     let after_second = run_fix(&file);
//RS     assert_eq!(
//RS         after_first, after_second,
//RS         "`jet fix --edition=2027` must be idempotent on a re-run"
//RS     );
//RS }
