    stub :: "before\n// BEGIN GENERATED JET SYNTAX HIGHLIGHTS\nstale\n// END GENERATED JET SYNTAX HIGHLIGHTS\nafter\n"
    files :: ["Tools/editors/vscode/syntaxes/jet.tmLanguage.json", "Tools/editors/jet.tmGrammar", "Tools/editors/tree-sitter/grammar.js", "Tools/editors/zed/languages/jet/highlights.scm"]
