    assert(quiet.status.success(), "`jet budget check --quiet` must be accepted, not E2102: {quiet:Debug}")
    assert_eq(quiet.status.code(), loud.status.code(), "--quiet must not change the exit code")
    assert(String.from_utf8_lossy(quiet.stderr).trim().is_empty(), "jet budget check --quiet must suppress its recap line, got: {String.from_utf8_lossy(quiet.stderr)}")
}

// Rust: tests/cli_parts/runtime.rs:1552
#Test("measured_test_targets_filter_and_json_match_test_runner_contract") {
    if !common.have_rustc() { return }
    dir :: isolated_cwd("bench_runner_contract")
    fs.create_dir_all(dir.join("nested")).unwrap()
    source :: `fn run() {}

#Test("needle") {
    assert_eq(1, 1)
}

#Test("other") {
    assert_eq(2, 2)
}

#Test("measured-needle") { .measure {
    assert_eq(1, 1)
} }

#Test("measured-other") { .measure {
    assert_eq(2, 2)
} }
`
    fs.write(dir.join("root.jet"), source).unwrap()
    fs.write(dir.join("nested/child.jet"), source).unwrap()
    tests :: Command.new(jet()).args(["test", "--show-default", ".", "--filter=needle", "--capture=all"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(tests.status.success(), "test target failed: {String.from_utf8_lossy(tests.stderr)}")
    test_stdout :: String.from_utf8_lossy(tests.stdout)
    assert(test_stdout.contains("needle"), "filtered test missing needle: {test_stdout}")
    assert(!test_stdout.contains("other: pass"), "filtered test ran other: {test_stdout}")
    measured :: Command.new(jet()).args(["test", "--show-default", ".", "--measure", "--filter=measured-needle", "--capture=all"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(measured.status.success(), "measured test target failed:\nstdout:\n{String.from_utf8_lossy(measured.stdout)}\nstderr:\n{String.from_utf8_lossy(measured.stderr)}")
    measured_stdout :: String.from_utf8_lossy(measured.stdout)
    assert_eq(measured_stdout.matches("measured-needle").count(), 2, "directory measurement must run one selected claim per file: {measured_stdout}")
    assert(!measured_stdout.contains("measured-other"), "filtered measurement ran other: {measured_stdout}")
    json :: Command.new(jet()).args(["test", "--show-default", ".", "--measure", "--filter=measured-needle", "--json"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(json.status.success(), "measured test JSON target failed: {String.from_utf8_lossy(json.stderr)}")
    json_stdout :: String.from_utf8_lossy(json.stdout)
    records :: json_stdout.lines().map(line -> parse_json(line).unwrap_or_else(_ -> panic("measurement JSON line does not parse: {line}"))).collect()
    assert_eq(records.len(), 2, "JSON must contain one record per selected claim: {json_stdout}")
    for record in records {
        match record {
            .Object(_) -> {}
            _ -> panic("measurement JSON record is not an object")
        }
        name_matches :: match record.get("name").ok() {
            Val(.Text(name)) -> name == "measured-needle"
            Val(.TypedText(name)) -> name == "measured-needle"
            _ -> false
        }
        assert(name_matches, "JSON claim name is wrong: {record:Debug}")
        assert(record.get("mean_ns").is_ok(), "JSON measurement has no mean: {record:Debug}")
    }
}

