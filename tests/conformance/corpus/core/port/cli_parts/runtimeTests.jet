// Rust: tests/cli_parts/runtime.rs:819
#Test("top_level_help_lists_job_vocabulary_only") {
    out :: Command.new(jet()).arg("help").env("NO_COLOR", "1").output().unwrap()
    assert(out.status.success(), "help failed: {out:Debug}")
    stdout :: String.from_utf8_lossy(out.stdout)
    assert(stdout.contains("jet jobs"), "help must list `jet jobs`: {stdout}")
    assert(stdout.contains("jobs [--graph|--status|--explain|--watch[=<on|off>]] [<name> [<job args>...]]"), "help must show that job arguments follow the job name: {stdout}")
    assert(stdout.contains("List, inspect, watch, or run named project jobs"), "help must describe the jobs command: {stdout}")
    assert(!stdout.contains("tasks"), "retired task CLI vocabulary leaked: {stdout}")
    retired_flag :: "--" + "task"
    assert(!stdout.contains(retired_flag), "retired job flag leaked: {stdout}")
    for golden in ["tests/cli/completions_fish.txt", "tests/cli/completions_zsh.txt", "tests/cli/man.txt"] {
        snapshot :: fs.read_to_string(OSPath.from(env.manifest_dir()).join(golden)).unwrap_or_else(error -> panic("read {golden}: {error}"))
        assert(snapshot.contains("jobs") && snapshot.contains("List, inspect, watch, or run named project jobs"), "{golden} must use the canonical jobs vocabulary")
        assert(!snapshot.contains("tasks") && !snapshot.contains(retired_flag), "{golden} leaked retired task CLI vocabulary")
    }
}

// Rust: tests/cli_parts/runtime.rs:894
#Test("help_lists_commands_by_frequency_rank") {
    help :: help_stdout(["help"])
    listed :: listed_commands(help, "\nUsage:\n")
    position :: (name: String) -> listed.iter().position(word -> word == name).unwrap_or_else(() -> panic("`jet help` omits `{name}`:\n{help}"))
    for common in ["run", "check", "new", "test"] {
        for rare in ["registry", "db", "bind"] {
            assert(position(common) < position(rare), "`{common}` must precede `{rare}` in `jet help`:\n{help}")
        }
    }
    registry_order :: CLI.commands_in(CLI.HelpOrder.Frequency).into_iter()
        .filter(command -> CLI.is_canonical_top_level(command.name)).map(command -> command.name.to_string()).collect()
    assert_eq(listed, registry_order, "`jet help` must follow frequency_rank")
    assert_eq(help, help_stdout(["help", "--sort", "frequency"]), "`--sort frequency` is the default order")
    greeting :: help_stdout(["--color=never"])
    headline :: listed_commands(greeting, "\nGet started:\n")
    assert(headline.len() >= 3 && headline.iter().any(name -> name == "run"), "the greeting must show the headline commands:\n{greeting}")
    in_help_order :: headline.iter().map(name -> position(name)).collect()
    assert(in_help_order.windows(2).all(pair -> pair[0] < pair[1]), "the greeting must list its commands in `jet help` order:\n{greeting}")
    check_snapshot("help_frequency.txt", help)
}

// Rust: tests/cli_parts/runtime.rs:940
#Test("help_sort_az_lists_a_to_z") {
    az :: help_stdout(["help", "--sort", "az"])
    listed :: listed_commands(az, "\nUsage:\n")
    every := CLI.COMMANDS.iter().filter(command -> CLI.is_canonical_top_level(command.name)).map(command -> command.name.to_string()).collect()
    every.sort_by_key(name -> name.to_ascii_lowercase())
    assert_eq(listed, every, "`--sort az` must list every command A to Z")
    assert_eq(listed_commands(help_stdout(["help", "--sort=az"]), "\nUsage:\n"), every)
    za :: help_stdout(["help", "--sort", "za"])
    every.reverse()
    assert_eq(listed_commands(za, "\nUsage:\n"), every, "`--sort za` must list every command Z to A")
    unknown :: Command.new(jet()).args(["help", "--sort", "alpha"]).env("NO_COLOR", "1").output().unwrap()
    stderr :: String.from_utf8_lossy(unknown.stderr)
    assert(!unknown.status.success() && stderr.contains("E2104") && stderr.contains("frequency, az, za"), "an unknown order must name the valid ones: {unknown:Debug}")
    check_snapshot("help_az.txt", az)
}

// Rust: tests/cli_parts/runtime.rs:974
#Test("command_overrides_report_themselves_and_default_bypasses_them") {
    if !common.have_rustc() { return }
    dir :: isolated_cwd("command_override_precedence")
    file :: dir.join("override.jet")
    fs.write(file, `use core.testing as testing

fn test(suite: TestSuite) {
    print("override")
    suite.run()
}

#Test("stock") {
    print("stock")
}

fn run() {}
`).unwrap()
    override_run :: Command.new(jet()).args(["test", "override.jet", "--serial", "--capture=all"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(override_run.status.success(), "override failed: {override_run:Debug}")
    override_stdout :: String.from_utf8_lossy(override_run.stdout)
    override_stderr :: String.from_utf8_lossy(override_run.stderr)
    assert(override_stderr.contains("jet test: using fn test override"), override_stderr)
    assert(override_stdout.contains("override"), override_stdout)
    assert(override_stdout.contains("stock: pass"), override_stdout)
    stock_run :: Command.new(jet()).args(["test", "override.jet", "--show-default", "--serial", "--capture=all"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(stock_run.status.success(), "stock failed: {stock_run:Debug}")
    stock_stdout :: String.from_utf8_lossy(stock_run.stdout)
    stock_stderr :: String.from_utf8_lossy(stock_run.stderr)
    assert(!stock_stderr.contains("using fn test override"), stock_stderr)
    assert(!stock_stdout.contains("override\n"), stock_stdout)
    assert(stock_stdout.contains("stock"), stock_stdout)
    assert(stock_stdout.contains("stock: pass"), stock_stdout)
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/cli_parts/runtime.rs:1044
#Test("command_role_home_overrides_stock_and_show_default_reports_stock") {
    dir :: isolated_cwd("command_role_home")
    fs.write(dir.join("package.jet"), "name: \"command-role-home\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join("run.jet"), "fn helper() {{}}\n").unwrap()
    fs.write(dir.join("@run.jet"), "fn run() {{ print(\"role\") }}\n").unwrap()
    role :: Command.new(jet()).arg("run").current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(role.status.success(), "role command failed: {role:Debug}")
    assert(String.from_utf8_lossy(role.stdout).contains("role"))
    fs.write(dir.join("explicit.jet"), "fn run() {{ print(\"file scope\") }}\n").unwrap()
    file_scope :: Command.new(jet()).args(["run", "explicit.jet"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(file_scope.status.success(), "file-scope command failed: {file_scope:Debug}")
    file_scope_stdout :: String.from_utf8_lossy(file_scope.stdout)
    assert(file_scope_stdout.contains("file scope"), file_scope_stdout)
    assert(!file_scope_stdout.contains("role\n"), file_scope_stdout)
    stock_dir :: dir.join("stock")
    fs.create_dir_all(stock_dir).unwrap()
    fs.write(stock_dir.join("package.jet"), "name: \"command-role-stock\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(stock_dir.join("run.jet"), "fn run() {{ print(\"stock\") }}\n").unwrap()
    fs.write(stock_dir.join("@run.jet"), "fn run() {{ print(\"role\") }}\n").unwrap()
    stock :: Command.new(jet()).args(["run", "--show-default"]).current_dir(stock_dir).env("NO_COLOR", "1").output().unwrap()
    assert(stock.status.success(), "stock command failed: {stock:Debug}")
    stock_stdout :: String.from_utf8_lossy(stock.stdout)
    assert(String.from_utf8_lossy(stock.stderr).contains("jet run: using stock default"), "{stock:Debug}")
    assert(stock_stdout.contains("stock"), stock_stdout)
    assert(!stock_stdout.contains("role\n"), stock_stdout)
    scaffold :: Command.new(jet()).args(["new", "scaffold", "--template", "overrides"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(scaffold.status.success(), "scaffold failed: {scaffold:Debug}")
    for file in Syntax.COMMAND_ROLE_FILES {
        source :: fs.read_to_string(dir.join("scaffold").join(file)).unwrap()
        assert(source.contains("jet ") && source.contains("--show-default"), "{file}: {source}")
    }
    duplicate_dir :: isolated_cwd("command_role_duplicate")
    fs.write(duplicate_dir.join("package.jet"), "name: \"command-role-duplicate\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(duplicate_dir.join("run.jet"), "fn run() {{}}\n").unwrap()
    fs.write(duplicate_dir.join("@run.jet"), "fn run() {{}}\n").unwrap()
    fs.write(duplicate_dir.join("a.jet"), "fn run() {{}}\n").unwrap()
    fs.write(duplicate_dir.join("b.jet"), "fn run() {{}}\n").unwrap()
    duplicate :: Command.new(jet()).arg("run").current_dir(duplicate_dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(duplicate.status.code(), Val(1), "{duplicate:Debug}")
    duplicate_stderr :: String.from_utf8_lossy(duplicate.stderr)
    assert(duplicate_stderr.contains("Error [E3540]"), duplicate_stderr)
    assert(duplicate_stderr.contains("Why:") && duplicate_stderr.contains("Fix:"), duplicate_stderr)
}

// Rust: tests/cli_parts/runtime.rs:1160
#Test("per_command_help_flag_works_without_running_the_command") {
    dir :: isolated_cwd("help_flag_build")
    for (cmd, flag) in [("build", "--help"), ("check", "-h"), ("new", "--help")] {
        out :: Command.new(jet()).args([cmd, flag]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert(out.status.success(), "`{cmd} {flag}`: {out:Debug}")
        stdout :: String.from_utf8_lossy(out.stdout)
        assert(stdout.contains(cmd), "`{cmd} {flag}` help text missing the command name: {stdout}")
        assert(!stdout.contains("Error ["), "`{cmd} {flag}` ran the command instead of printing help: {stdout}")
    }
    assert(!dir.join("new").exists(), "`jet new --help` must not create a project")
}

// Rust: tests/cli_parts/runtime.rs:1195
#Test("owns_flag_vocabulary_help_flag_prints_help_not_execute") {
    dir :: isolated_cwd("help_flag_owns_vocab")
    for (cmd, flag) in [("prove", "--help"), ("budget", "-h"), ("clean", "--help"), ("update", "-h"), ("image", "--help"), ("trust", "--help")] {
        assert(CLI.owns_flag_vocabulary(cmd), "test assumption: `{cmd}` should own a flag vocabulary")
        out :: Command.new(jet()).args([cmd, flag]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert(out.status.success(), "`{cmd} {flag}` must print help and exit 0: {out:Debug}")
        stdout :: String.from_utf8_lossy(out.stdout)
        assert(stdout.contains(cmd), "`{cmd} {flag}` help text missing the command name: {stdout}")
        assert(out.stderr.is_empty(), "`{cmd} {flag}` must not print to stderr: {String.from_utf8_lossy(out.stderr)}")
    }
    assert(!dir.join(".jet").exists(), "`--help` on an owns_flag_vocabulary command must not do real work")
}

