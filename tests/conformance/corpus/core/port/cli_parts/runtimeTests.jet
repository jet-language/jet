// Rust: tests/cli_parts/runtime.rs:722
#Test("formerly_prose_only_flags_are_real_flag_rows") {
    flags :: ["--ar", "--clang", "--facts", "--no-sign", "--pkg", "--registry"]
    man :: CLI.man_page("0.0.0")
    bash :: CLI.completions_bash()
    zsh :: CLI.completions_zsh()
    fish :: CLI.completions_fish()
    powershell :: CLI.completions_powershell()
    for flag in flags {
        assert(CLI.is_known_flag(flag), "`{flag}` must be a known flag")
        assert(man.contains(flag), "man page missing `{flag}`")
        assert(bash.contains(flag), "bash completions missing `{flag}`")
        assert(zsh.contains(flag), "zsh completions missing `{flag}`")
        assert(powershell.contains(flag), "powershell completions missing `{flag}`")
        assert(fish.contains(flag.trim_start_matches("--")), "fish completions missing `{flag}`")
    }
    assert_eq(CLI.closest_flag("--pk"), Val("--pkg"))
    assert_eq(CLI.closest_flag("--regsitry"), Val("--registry"))
}

