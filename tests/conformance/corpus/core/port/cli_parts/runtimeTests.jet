// Rust: tests/cli_parts/runtime.rs:504
#Test("perf_and_structural_merge_never_raw_exit") {
    root :: OSPath.new(env.manifest_dir())
    for relative in ["Source/CmdPerf.rs", "Source/CmdStructuralMerge.rs"] {
        path :: root.join(relative)
        source :: fs.read_to_string(path).unwrap_or_else(e -> panic("read {relative}: {e}"))
        for (line_no, line) in source.lines().enumerate() {
            trimmed := line.trim() // #4303
            all_digits :: (s: String) -> !s.is_empty() && s.chars().all(c -> c.is_ascii_digit())
            is_raw_exit_call :: trimmed.starts_with("exit(") && all_digits(trimmed[5..].trim_end_matches(';').trim_end_matches(')'))
            is_raw_outcome_exit :: trimmed.starts_with("Outcome::Exit(") && all_digits(trimmed[14..].trim_end_matches(';').trim_end_matches(')'))
            is_raw_return :: trimmed.strip_prefix("return ").is_some_and(rest -> all_digits(rest.trim_end_matches(';')))
            assert(!is_raw_exit_call && !is_raw_outcome_exit && !is_raw_return,
                "{relative}:{line_no + 1}: raw exit-code literal `{trimmed}` — use jet_foundation::ExitCodes")
        }
    }
}

// Rust: tests/cli_parts/runtime.rs:534
#Test("uncoded_errors") {
    root :: OSPath.new(env.manifest_dir()).join("Source")
    for entry in fs.read_dir(root).unwrap() {
        path :: entry.unwrap().path()
        if path.extension().and_then(value -> value.to_str()) != Val("rs") { continue }
        source :: fs.read_to_string(path).unwrap()
        compact: String :: source.chars().filter(ch -> !ch.is_whitespace()).collect()
        rest := compact.as_str()
        loop {
            at :: rest.find("eprintln!(")
            if at.is_none() { break }
            after_macro :: rest[at.unwrap() + "eprintln!(".len()..]
            after_raw :: after_macro.strip_prefix('r').unwrap_or(after_macro)
            after_hashes :: after_raw.trim_start_matches('#')
            assert(!after_hashes.starts_with("\"error:") && !after_hashes.starts_with("\"Error:"),
                "{path.display()} contains a bare eprintln error; use the shared Diagnostic renderer with a registered code")
            rest = after_macro
        }
    }
}

// Rust: tests/cli_parts/runtime.rs:563
#Test("generic_cli_diagnostics_match_registered_snapshots") {
    cases :: [
        ("E2104", "`jet inspect example` needs an entry file", include_str("../fixtures/cli-diagnostics/E2104.stderr")),
        ("E2105", "couldn't read `package.jet`: permission denied", include_str("../fixtures/cli-diagnostics/E2105.stderr"))
    ]
    for (code, what, expected) in cases {
        (why, fix) :: if code == "E2104" {
            ("Jet needs valid command input before it can run this command", "correct the named argument or input, then run the command again")
        } else {
            ("Jet could not complete the named file, tool, or operating-system operation", "correct the named problem, then run the command again")
        }
        diagnostic :: Diagnostic.error(code, what.to_string(), why.to_string(), fix.to_string(), None)
        assert_eq(diagnostic.render_colored("", "", false), expected)
    }
}

// Rust: tests/cli_parts/runtime.rs:603
#Test("inspect_reserved_lists_keywords_teaching_words_and_sigils") {
    out :: Command.new(jet()).args(["inspect", "reserved"]).env("NO_COLOR", "1").output().unwrap()
    assert(out.status.success(), "{out:Debug}")
    text :: String.from_utf8_lossy(out.stdout)
    for word in ["copy", "mut", "take", "const", "unsafe"] {
        assert(text.contains(word), "reserved report missing teaching-reserved word `{word}`: {text}")
    }
    for sigil in ["::", ":=", "&", "^", "~", "@"] {
        assert(text.contains(sigil), "reserved report missing sigil `{sigil}`: {text}")
    }
    assert(text.contains("fn"), "reserved report missing a real keyword: {text}")
    out_json :: Command.new(jet()).args(["inspect", "reserved", "--json"]).env("NO_COLOR", "1").output().unwrap()
    assert(out_json.status.success(), "{out_json:Debug}")
    json :: String.from_utf8_lossy(out_json.stdout)
    assert(json.contains("\"keywords\":["), json)
    assert(json.contains("\"teaching_reserved\":["), json)
    assert(json.contains("\"sigils\":["), json)
    _ :: parse_json(json).unwrap_or_else(_ -> panic("reserved --json must parse: {json}"))
}

// Rust: tests/cli_parts/runtime.rs:646
#Test("quiet_suppresses_status_output_without_changing_behavior") {
    loud :: env.temp_dir().join("jet_cli_quiet_init_loud")
    quiet :: env.temp_dir().join("jet_cli_quiet_init_quiet")
    _ :: fs.remove_dir_all(loud)
    _ :: fs.remove_dir_all(quiet)
    fs.create_dir_all(loud).unwrap()
    fs.create_dir_all(quiet).unwrap()
    loud_out :: Command.new(jet()).arg("init").current_dir(loud).env("NO_COLOR", "1").output().unwrap()
    assert(loud_out.status.success(), "{loud_out:Debug}")
    assert(!String.from_utf8_lossy(loud_out.stderr).trim().is_empty(), "jet init without --quiet should print a confirmation")
    quiet_out :: Command.new(jet()).args(["init", "--quiet"]).current_dir(quiet).env("NO_COLOR", "1").output().unwrap()
    assert(quiet_out.status.success(), "{quiet_out:Debug}")
    assert(String.from_utf8_lossy(quiet_out.stdout).trim().is_empty() && String.from_utf8_lossy(quiet_out.stderr).trim().is_empty(),
        "jet init --quiet must suppress its non-error status line, got: {quiet_out:Debug}")
    assert(quiet.join(Syntax.PACKAGE_FILE).is_file(), "--quiet must not change what init creates")
    _ :: fs.remove_dir_all(loud)
    _ :: fs.remove_dir_all(quiet)
}

