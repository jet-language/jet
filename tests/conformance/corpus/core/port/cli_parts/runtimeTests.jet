// Rust: tests/cli_parts/runtime.rs:12
#Test("jet_fix_edition_2027_rewrites_json_canonical_and_is_idempotent") {
    dir :: isolated_cwd("jsoncanon_fix")
    file :: dir.join("run.jet")
    fs.write(file, """use core.encoding.json as json

pub fn show() Never! {
    data :: json.parse(`{"a":1}`) ?? panic("json")
    r :: json.canonical(data)
    print(r)
}

pub fn sign() -> String {
    data :: json.parse(`{"a":1}`)
    r :: json.canonical(data)
    r
}

pub fn already_migrated() Never! {
    data :: json.parse(`{"a":1}`) ?? panic("json")
    r :: json.canonical(data) ?? panic("value is not canonical JSON")
    print(r)
}
""").unwrap()
    run_fix :: (file: OSPath) -> {
        out :: Command.new(jet()).args(["fix", file.to_str().unwrap(), "--edition=2027"]).output().unwrap()
        assert(out.status.success(), "jet fix failed:\nstdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
        fs.read_to_string(file).unwrap()
    }
    after_first :: run_fix(file)
    assert(after_first.contains("json.canonical(data) ?? panic(\"value is not canonical JSON\")\n    print(r)\n}\n\npub fn sign"), "infallible fn `show` must get the panic fallback:\n{after_first}")
    assert(after_first.contains("r :: json.canonical(data)\n    r\n}"), "fallible fn `sign` must use automatic propagation, not a panic fallback:\n{after_first}")
    assert(!after_first.contains("value is not canonical JSON\") ?? panic"), "an already-migrated call must not be rewritten twice:\n{after_first}")
    after_second :: run_fix(file)
    assert_eq(after_first, after_second, "`jet fix --edition=2027` must be idempotent on a re-run")
}

// Rust: tests/cli_parts/runtime.rs:78
#Test("jet_fix_reports_one_print_family_migration_per_retired_spelling") {
    dir :: isolated_cwd("print_family_fix")
    file :: dir.join("run.jet")
    source :: "use core.term as io\n\nfn run() {{\n    io.println(\"line\")\n    value :: \"value\"\n    io.sprint(value)\n    io.repr(value)\n}}\n"
    fs.write(file, source).unwrap()
    preview :: Command.new(jet()).args(["fix", file.to_str().unwrap(), "--dry-run"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(preview.status.success(), "jet fix --dry-run failed: {String.from_utf8_lossy(preview.stderr)}")
    report :: String.from_utf8_lossy(preview.stderr)
    assert(report.contains("would apply 3 fixes"), report)
    assert(report.contains("rewrote 3 retired print-family spellings (D-ONCE-PRINT1=A)"), report)
    assert_eq(fs.read_to_string(file).unwrap(), source)
    applied :: Command.new(jet()).args(["fix", file.to_str().unwrap()]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(applied.status.success(), "jet fix failed: {String.from_utf8_lossy(applied.stderr)}")
    assert_eq(fs.read_to_string(file).unwrap(), "use core.term as io\n\nfn run() {{\n    io.print(\"line\")\n    value :: \"value\"\n    print(\"{{value}}\")\n    print(\"{{value:Debug}}\")\n}}\n")
}

// Rust: tests/cli_parts/runtime.rs:122
#Test("jet_fix_apply_writes_replay_log_and_undo_restores_source") {
    dir :: isolated_cwd("fix_replay")
    file :: dir.join("run.jet")
    original :: "use core.term as io\n\nfn run() {{\n    io.println(\"line\")\n    value :: \"value\"\n    io.sprint(value)\n    io.repr(value)\n}}\n"
    fs.write(file, original).unwrap()
    applied :: Command.new(jet()).args(["fix", file.to_str().unwrap()]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(applied.status.success(), "jet fix failed: {String.from_utf8_lossy(applied.stderr)}")
    log :: String.from_utf8_lossy(applied.stderr).lines()
        .find_map(line -> line.trim().strip_prefix("log: ")).map(OSPath.from).expect("jet fix must print replay log path")
    assert(log.is_file(), "replay log missing: {log.display()}")
    log_bytes :: fs.read(log).unwrap()
    log_text :: String.from_utf8_lossy(log_bytes)
    assert(log_text.contains("\"operation\": \"fix\""))
    assert(log_text.contains("\"kind\":\"rewrite\""), log_text)
    assert(log_text.contains("\"rule_id\":\"jet-fix\""), log_text)
    assert(fs.read_to_string(file).unwrap().contains("io.print(\"line\")"))
    undone :: Command.new(jet()).args(["inspect", "codemod", "undo", log.to_str().unwrap()]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(undone.status.success(), "fix undo failed: {String.from_utf8_lossy(undone.stderr)}")
    assert_eq(fs.read_to_string(file).unwrap(), original)
}

// Rust: tests/cli_parts/runtime.rs:169
#Test("check_fix_and_format_are_deterministic_for_safe_edits_and_profile_precedence") {
    dir :: isolated_cwd("check_fix_fmt_determinism")
    file :: dir.join("run.jet")
    control :: dir.join("control.jet")
    package :: dir.join("package.jet")
    source :: "fn run(){{println(\"safe\")}}\n"
    fs.write(file, source).unwrap()
    fs.write(control, "fn run(){{print(\"safe\")}}\n").unwrap()
    machine_payload :: (output: Output) -> {
        stdout :: String.from_utf8_lossy(output.stdout)
        stderr :: String.from_utf8_lossy(output.stderr)
        if stdout.trim_start().starts_with('{') { stdout.trim().to_owned() } else { stderr.trim().to_owned() }
    }
    check :: (extra: [String]) -> {
        command := Command.new(jet())
        command.args(["check", file.to_str().unwrap(), "--json"]).args(extra).current_dir(dir).env("NO_COLOR", "1")
        command.output().unwrap()
    }
    parse_status :: (output: Output) -> {
        payload :: machine_payload(output)
        assert(!payload.is_empty(), "check emitted no machine report")
        parse_json(payload).unwrap_or_else(_ -> panic("invalid machine report:\n{payload}"))
    }
    diagnostic_report :: (status: DataTree) -> {
        match json_get(status, "reports").unwrap() {
            .Array(reports) -> reports.first().cloned().expect("diagnostic status must contain one report")
            _ -> panic("diagnostic status reports is not an array")
        }
    }
    report :: (output: Output) -> parse_status(output)
    first_report :: (status: DataTree) -> diagnostic_report(status)
    assert_safe_edit :: (value: DataTree) -> {
        assert_eq(json_str(json_get(value, "applicability").unwrap()).unwrap(), "safe")
        edits :: match json_get(value, "fix_edits").unwrap() {
            .Array(edits) -> edits
            _ -> panic("fix_edits is not an array")
        }
        assert_eq(edits.len(), 1)
        edit :: &edits[0]
        assert_eq(json_str(json_get(edit, "file").unwrap()).unwrap(), file.to_str().unwrap())
        assert_eq(json_str(json_get(edit, "safety").unwrap()).unwrap(), "behavior-preserving")
        span :: json_get(edit, "span").unwrap()
        start :: json_int(json_get(span, "start").unwrap()).unwrap() as USize
        end :: json_int(json_get(span, "end").unwrap()).unwrap() as USize
        new_text :: json_str(json_get(edit, "new_text").unwrap()).unwrap()
        assert_eq(source[start..end], "println")
        assert_eq(new_text, "print")
    }
    absent_first :: check([])
    absent_second :: check([])
    assert_eq(absent_first.status.code(), Val(1))
    assert_eq(absent_first.status.code(), absent_second.status.code())
    assert_eq(machine_payload(absent_first), machine_payload(absent_second))
    absent_report :: report(absent_first)
    absent_diagnostic :: first_report(absent_report)
    assert_safe_edit(absent_diagnostic)
    package_source :: `name: "check-fix-format-determinism"
version: "0.1.0"
authority: {
    holds: { allow: [IO] }
}
settings: { marker: String = "package" }

build: {
    staging: Build{ optimize: basic, settings: { marker: "profile" } },
}
`
    fs.write(package, package_source).unwrap()
    package_bytes :: fs.read(package).unwrap()
    configured :: check(["--profile=staging", "--set", "marker=cli"])
    assert_eq(configured.status.code(), Val(1))
    configured_report :: report(configured)
    configured_diagnostic :: first_report(configured_report)
    assert_safe_edit(configured_diagnostic)
    assert_eq(json_get(absent_diagnostic, "code"), json_get(configured_diagnostic, "code"))
    assert_eq(json_get(absent_diagnostic, "applicability"), json_get(configured_diagnostic, "applicability"))
    assert_eq(json_get(absent_diagnostic, "fix_edits"), json_get(configured_diagnostic, "fix_edits"))
    preview :: () -> Command.new(jet()).args(["fix", file.to_str().unwrap(), "--dry-run"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    preview_first :: preview()
    preview_second :: preview()
    assert(preview_first.status.success(), "fix preview failed: {machine_payload(preview_first)}")
    assert_eq(preview_first.status.code(), preview_second.status.code())
    assert_eq(preview_first.stdout, preview_second.stdout)
    assert_eq(preview_first.stderr, preview_second.stderr)
    assert_eq(fs.read_to_string(file).unwrap(), source)
    applied :: Command.new(jet()).args(["fix", file.to_str().unwrap()]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(applied.status.success(), "jet fix failed: {machine_payload(applied)}")
    fixed :: fs.read_to_string(file).unwrap()
    assert(fixed.contains("print(\"safe\")"), fixed)
    assert(!fixed.contains("println"), fixed)
    assert_eq(fs.read(package).unwrap(), package_bytes)
    fmt_preview :: () -> Command.new(jet()).args(["fmt", file.to_str().unwrap(), "--check", "--json"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    fmt_first :: fmt_preview()
    fmt_second :: fmt_preview()
    assert_eq(fmt_first.status.code(), fmt_second.status.code())
    assert_eq(fmt_first.stdout, fmt_second.stdout)
    assert_eq(fmt_first.stderr, fmt_second.stderr)
    assert_eq(fs.read_to_string(file).unwrap(), fixed)
    formatted :: Command.new(jet()).args(["fmt", file.to_str().unwrap()]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(formatted.status.success(), "jet fmt failed: {String.from_utf8_lossy(formatted.stderr)}")
    run :: (path: OSPath) -> Command.new(jet()).args(["run", "--profile=debug", path.to_str().unwrap()])
        .current_dir(dir).env("JET_STORE_DIR", dir.join("store")).env("JET_RUN_CACHE_DIR", dir.join("run-cache"))
        .env("NO_COLOR", "1").output().unwrap()
    expected :: run(control)
    assert(expected.status.success(), "control run failed: {String.from_utf8_lossy(expected.stderr)}")
    assert_eq(expected.stdout, b"safe\n")
    actual :: run(file)
    assert(actual.status.success(), "fixed run failed: {String.from_utf8_lossy(actual.stderr)}")
    assert_eq(actual.stdout, expected.stdout)
    configured_clean :: check(["--profile=staging", "--set", "marker=cli"])
    assert(configured_clean.status.success(), "configured check failed: {machine_payload(configured_clean)}")
    configured_clean_report :: report(configured_clean)
    provenance :: json_get(configured_clean_report, "provenance").unwrap()
    assert_eq(json_str(json_get(provenance, "profile").unwrap()).unwrap(), "staging")
    assert_eq(fs.read(package).unwrap(), package_bytes)
}

// Rust: tests/cli_parts/runtime.rs:440
#Test("clean_check_prints_one_line") {
    dir :: isolated_cwd("clean_check_one_line")
    fs.write(dir.join("package.jet"), "name: \"hello\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join("run.jet"), "fn run() {{\n    print(\"hello, world\")\n}}\n").unwrap()
    for output in check_twice(dir, ["check", "run.jet"]) { check_snapshot("check_clean_one_line.txt", output) }
    entry :: dir.canonicalize().unwrap().join("run.jet")
    for output in check_twice(dir, ["check"]) {
        assert_eq(output, "ok: `{entry.display()}` has no problems\n", "clean project check must print one line")
    }
    verbose :: Command.new(jet()).args(["check", "--verbose", "run.jet"]).current_dir(dir)
        .env("JET_RECEIPT_BYPASS", "1").env("NO_COLOR", "1").output().unwrap()
    stdout :: String.from_utf8_lossy(verbose.stdout)
    assert(verbose.status.success(), stdout)
    assert(stdout.starts_with("check: passed ("), stdout)
    assert_eq(stdout.lines().filter(line -> line.starts_with("proof: ")).count(), 4, stdout)
    _ :: fs.remove_dir_all(dir)
}

