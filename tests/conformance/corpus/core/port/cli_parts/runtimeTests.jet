#Test("quiet_accepted_and_suppresses_budget_check_recap") {
    // Rust: tests/cli_parts/runtime.rs:1501
    fn budget_dir(tag: String) -> OSPath {
        dir :: isolated_cwd(tag)
        init :: Command.new(jet()).arg("init").current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert(init.status.success(), "{init:Debug}")
        fs.write(dir.join("run.jet"), "fn run() {{\n    print(\"hi\")\n}}\n").unwrap()
        dir
    }
    loud_dir :: budget_dir("quiet_budget_loud")
    loud :: Command.new(jet()).args(["budget", "check"]).current_dir(loud_dir).env("NO_COLOR", "1").output().unwrap()
    assert(loud.status.success(), "{loud:Debug}")
