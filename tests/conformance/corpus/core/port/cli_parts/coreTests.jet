// Rust: tests/cli_parts/core.rs:630
#Test("isolated_cwd_never_reuses_executing_fixture_path") {
    if target.selected_os() != "linux" { return }
    first :: isolated_cwd("executing_fixture_collision")
    executable :: first.join("cli-test-holder")
    fs.copy(env.current_exe().unwrap(), executable).unwrap()
    ready :: first.join("ready")
    // Derive the full test path, preserving exact-filter selection after module moves.
    child_test :: match module_path().split_once("::") {
        Val(pair) -> "{pair.after}::isolated_cwd_child_holds_executable",
        None -> "isolated_cwd_child_holds_executable"
    }
    child := Command.new(executable).args(["--exact", child_test]).env("JET_CLI_EXECUTABLE_HOLDER_READY", ready).stdin(Stdio.piped()).stdout(Stdio.null()).stderr(Stdio.piped()).spawn().unwrap()
    deadline :: Instant.now() + Duration.from_secs(10)
    ready_seen :: loop {
        if ready.is_file() { break true }
        if child.try_wait().unwrap().is_some() or Instant.now() >= deadline { break false }
        thread.sleep(Duration.from_millis(1))
    }
    second :: if ready_seen { Val(isolated_cwd("executing_fixture_collision")) } else { None }
    copy_result :: second.as_ref().map(|dir| -> fs.copy(env.current_exe().unwrap(), dir.join("cli-test-holder")))
    release_result :: child.stdin.as_mut().unwrap().write_all([U8]{1})
    drop(child.stdin.take())
    output :: child.wait_with_output().unwrap()
    _ :: fs.remove_dir_all(first)
    if second is Val(path) { _ :: fs.remove_dir_all(path) }
    assert(ready_seen, "holder exited or timed out: {String.from_utf8_lossy(output.stderr)}")
    assert(output.status.success(), "holder failed: {String.from_utf8_lossy(output.stderr)}")
    release_result.unwrap()
    second_path :: second.unwrap()
    assert_ne(first, second_path, "fixture path reused while stale executable was running")
    copy_result.unwrap().unwrap()
}

// Rust: tests/cli_parts/core.rs:699
#Test("budget_usage_and_preflight_fail_without_artifacts") {
    dir :: budget_project("budget_no_artifact", 10)
    loop argv in [
        ["budget", "check", "--unknown"],
        ["budget", "update", "--baseline", "ci/linux", "--reason", "no gate"],
        ["budget", "report"],
        ["budget", "check", "--json", "--unknown"],
        ["budget", "check", "--unknown", "--json"],
        ["budget", "check", "--json", "--json"],
        ["budget", "check", "--annotations", "gitlab"],
        ["budget", "update", "--baseline", "CI/Linux"],
        ["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--accept-regression", "--reason", "invalid"],
        ["budget", "update", "--baseline", "ci/linux", "--yes", "-y"]
    ] {
        out :: Command.new(jet()).args(argv).current_dir(dir).output().unwrap()
        assert_eq(out.status.code(), Val(2))
        assert(out.stdout.is_empty())
        assert(not dir.join(".jet").exists(), "usage failure created an artifact")
    }
    fs.write(dir.join("src/run.jet"), "fn run( {\n").unwrap()
    out :: Command.new(jet()).args(["budget", "check"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(1))
    assert(not dir.join(".jet").exists(), "compiler preflight created an artifact")
}

// Rust: tests/cli_parts/core.rs:755
#Test("budget_check_uses_real_compiler_fact_and_writes_verified_report") {
    dir :: budget_project("budget_check", 10)
    out :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
    assert(out.stderr.is_empty())
    value :: CanonicalJson.parse_canonical(out.stdout).unwrap()
    text :: String.from_utf8(out.stdout).unwrap()
    assert(text.contains("\"schema\":\"jet.status/v1\""))
    assert(text.contains("\"budget\":{"))
    assert(text.contains("\"budget_id\":\"package:public-api\""))
    assert(text.contains("\"num\":1"), "public API count must be measured: {text}")
    reports :: fs.read_dir(dir.join(".jet/perf/reports")).unwrap().collect_results().unwrap()
    assert_eq(reports.len(), 1)
    bytes :: fs.read(reports[0].path()).unwrap()
    verify_budget_report(bytes).unwrap()
    command :: match value { .Object(v) -> v, _ -> panic("command JSON is not an object") }
    report :: match canonical_field(command["budget"], "report") { .Object(v) -> v, _ -> panic("report is not an object") }
    content :: match report["content"] { .Object(v) -> v, _ -> panic("content is not an object") }
    tool :: match content["toolchain"] { .Object(v) -> v, _ -> panic("toolchain is not an object") }
    loop key in ["compiler_build_id", "stdlib_id", "runner_id"] {
        id :: match tool[key] { .String(v) -> v, _ -> panic("{key} is not text") }
        assert_eq(id.len(), 64, "{key} must identify real executable bytes")
        assert(id.bytes().all(|byte| -> byte.is_ascii_hexdigit()))
        assert(id != "jet" and id != "stdlib" and id != "compiler")
    }
    subject :: match content["subject"] { .Object(v) -> v, _ -> panic("subject is not an object") }
    triple :: match subject["target_triple"] { .String(v) -> v, _ -> panic("target triple is not text") }
    assert(triple.split("-").count() >= 3, "target triple must be canonical: {triple}")
    measured_start :: match subject["measured_start"] { .String(v) -> v, _ -> panic("measurement start is not text") }
    measured_end :: match subject["measured_end"] { .String(v) -> v, _ -> panic("measurement end is not text") }
    assert(measured_start < measured_end, "measurement must cover preflight and evidence: {measured_start}..{measured_end}")
    measurements :: match content["measurements"] { .Array(v) -> v, _ -> panic("measurements is not an array") }
    measurement :: match measurements[0] { .Object(v) -> v, _ -> panic("measurement is not an object") }
    provider :: match measurement["provider"] { .Object(v) -> v, _ -> panic("provider is not an object") }
    loop key in ["cpu_model", "kernel", "power_governor"] {
        value :: match provider[key] { .String(v) -> v, _ -> panic("{key} is not text") }
        assert(not value.is_empty() and value != "compiler" and value != "unknown")
    }
}

