}

// Rust: tests/cli_parts/core.rs:126
#Test("lua_bind_runs_embedded_vm_and_recovers_after_hostile_calls") {
    if Command.new("lua").arg("-v").output().is_err() { return }
    dir :: isolated_cwd("lua_bind_e2e")
    root :: OSPath.from(env.manifest_dir())
    example :: root.join("Examples/interop/lua")
    fs.copy(example.join("ops.lua"), dir.join("ops.lua")).unwrap()
    fs.copy(example.join("main.jet"), dir.join("main.jet")).unwrap()
    bind :: Command.new(jet()).args(["inspect", "bind", "lua", "ops.lua", "--pkg", "ops"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(bind.status.success(), "Lua bind failed:\n{String.from_utf8_lossy(bind.stderr)}")
    cache :: dir.join(".jet/bindings/lua")
    assert(cache.join("libjet_lua_ops.a").is_file())
    provenance :: fs.read_to_string(cache.join("ops.provenance")).unwrap()
    assert(provenance.contains("state=per-session\ntransport=datatree+table-view\ntable-view=zero-copy\nhook=instructions\n"))
    generated :: fs.read_to_string(cache.join("ops.jet")).unwrap()
    assert(generated.contains("pub struct TableView") and generated.contains("pub fn counters_view(session: Session, deadline_ms: Int) -> TableView LuaError! {") and generated.contains("pub fn view_get_int(view: TableView, key: String) -> Int LuaError! {") and generated.contains("pub fn view_set_int(view: TableView, key: String, value: Int) -> Bool LuaError! {"))
    run :: Command.new(jet()).args(["run", "--profile=debug", "main.jet"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(run.status.success(), "embedded Lua binding did not run:\n{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), fs.read_to_string(example.join("expected.out")).unwrap())
    fs.copy(root.join("tests/fixtures/lua_lifecycle.c"), dir.join("lifecycle.c")).unwrap()
    lua_path :: fs.read_to_string(cache.join("ops.lua-path")).unwrap()
    lua_dir := lua_path.trim() // #4303
    link_dir :: "-L{lua_dir}"
    rpath :: "-Wl,-rpath,{lua_dir}"
    cc :: Command.new("cc").arg("lifecycle.c").args(["-L.jet/bindings/lua", "-l:libjet_lua_ops.a"]).arg(link_dir).arg(rpath).args(["-llua", "-lpthread", "-ldl", "-lm", "-o", "lifecycle"]).current_dir(dir).output().unwrap()
    assert(cc.status.success(), "Lua lifecycle probe link failed:\n{String.from_utf8_lossy(cc.stderr)}")
    lifecycle :: Command.new(dir.join("lifecycle")).current_dir(dir).output().unwrap()
    assert(lifecycle.status.success(), "Lua lifecycle probe failed: {lifecycle.status.code().debug()}")
}

// Rust: tests/cli_parts/core.rs:212
#Test("lua_bind_discovers_without_executing_and_launders_parse_errors") {
    if Command.new("luac").arg("-v").output().is_err() { return }
    dir :: isolated_cwd("lua_bind_static")
    script :: dir.join("static.lua")
    fs.write(script, "error('discovery executed source')\n-- function fake(input) end\nlocal function hidden(input) return input end\nfunction visible(input) return input end\n").unwrap()
    bind :: Command.new(jet()).args(["inspect", "bind", "lua"]).arg(script).args(["--pkg", "static_ops"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert(bind.status.success(), "static Lua discovery failed:\n{String.from_utf8_lossy(bind.stderr)}")
    generated :: fs.read_to_string(dir.join(".jet/bindings/lua/static_ops.jet")).unwrap()
    assert(generated.contains("pub fn visible("))
    assert(not generated.contains("pub fn fake(") and not generated.contains("pub fn hidden("))
    invalid :: dir.join("invalid.lua")
    fs.write(invalid, "function broken(input)\n  return {\nend\n").unwrap()
    failed :: Command.new(jet()).args(["inspect", "bind", "lua"]).arg(invalid).args(["--pkg", "bad"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(failed.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(stderr.contains("Error [E3208]"))
    assert(not stderr.contains("invalid.lua:") and not stderr.contains("near 'end'"), "raw Lua parser detail escaped: {stderr}")
}

// Rust: tests/cli_parts/core.rs:255
#Test("lua_bind_rejects_generated_fixed_abi_names") {
    if Command.new("luac").arg("-v").output().is_err() { return }
    dir :: isolated_cwd("lua_bind_reserved_helpers")
    loop name in ["take_error", "view_release"] {
        script :: dir.join("{name}.lua")
        fs.write(script, "function {name}(input) return input end\n").unwrap()
        package :: "reserved_{name}"
        failed :: Command.new(jet()).args(["inspect", "bind", "lua"]).arg(script).args(["--pkg", package]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(failed.status.code(), Val(1))
        stderr :: String.from_utf8_lossy(failed.stderr)
        assert(stderr.contains("Error [E3208]") and stderr.contains("`{name}` cannot be exported"), "{stderr}")
        assert(not stderr.contains("E0105"), "duplicate generated extern escaped binder validation: {stderr}")
        assert(not dir.join(".jet/bindings/lua/{package}.jet").exists())
    }
}

// Rust: tests/cli_parts/core.rs:294
#Test("jobs_lists_documented_scheduled_project_jobs_and_matches_run_outside_projects") {
    project :: isolated_cwd("jobs_project")
    fs.write(project.join("package.jet"), "name: \"job_runner\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(project.join("run.jet"), read("Examples/features/devloop/job_runner.jet")).unwrap()
    listed :: Command.new(jet()).arg("jobs").current_dir(project).env("NO_COLOR", "1").output().unwrap()
    assert_eq(listed.status.code(), Val(0), "{String.from_utf8_lossy(listed.stderr)}")
    assert_eq(String.from_utf8(listed.stdout).unwrap(), "{"greet".pad_end(11, " ")}  [ship] Say hello from a shipped project job\n{"seed_data".pad_end(11, " ")}  [dev] Seed local data (every 5min)\n{"inspect_job".pad_end(11, " ")}  [internal]\n")
    unknown :: Command.new(jet()).args(["run", "run.jet", "--", "missing"]).current_dir(project).env("NO_COLOR", "1").output().unwrap()
    unknown_stderr :: String.from_utf8_lossy(unknown.stderr)
    assert(not unknown.status.success(), "{unknown_stderr}")
    assert(unknown_stderr.contains("E1294"), "{unknown_stderr}")
    assert(unknown_stderr.contains("declared jobs: greet, seed_data, inspect_job"), "{unknown_stderr}")
    release :: Command.new(jet()).args(["build", "--release", "run.jet"]).current_dir(project).env("NO_COLOR", "1").output().unwrap()
    assert(release.status.success(), "{String.from_utf8_lossy(release.stderr)}")
    assert(String.from_utf8_lossy(release.stdout).contains("stripped 2 dev job(s): seed_data, inspect_job (mark #Job(.Ship) to include)"), "{String.from_utf8_lossy(release.stdout)}")
    shipped :: Command.new(project.join(".jet/build/run")).arg("greet").current_dir(project).output().unwrap()
    assert(shipped.status.success(), "{String.from_utf8_lossy(shipped.stderr)}")
    assert(String.from_utf8_lossy(shipped.stdout).contains("hello from job"))
    stripped :: Command.new(project.join(".jet/build/run")).arg("seed_data").current_dir(project).output().unwrap()
    assert(not stripped.status.success())
    // Built binary refuses stripped jobs with registered E1294 and only advertises dispatchable jobs.
    stripped_stderr :: String.from_utf8_lossy(stripped.stderr)
    assert(stripped_stderr.contains("E1294"), "{stripped_stderr}")
    assert(stripped_stderr.contains("no job named `seed_data`"), "{stripped_stderr}")
    assert(stripped_stderr.contains("declared jobs: greet"), "{stripped_stderr}")
    assert(not stripped_stderr.contains("seed_data, inspect_job"), "a release binary must not advertise stripped jobs: {stripped_stderr}")
    help :: Command.new(jet()).arg("help").output().unwrap()
    assert(help.status.success())
    assert(String.from_utf8_lossy(help.stdout).contains("jet jobs"), "jet help must list job discovery")
    outside :: isolated_cwd("jobs_outside_project")
    jobs_error :: Command.new(jet()).arg("jobs").current_dir(outside).env("NO_COLOR", "1").output().unwrap()
    run_error :: Command.new(jet()).arg("run").current_dir(outside).env("NO_COLOR", "1").output().unwrap()
    assert_eq(jobs_error.status.code(), run_error.status.code())
    assert_eq(jobs_error.stderr, run_error.stderr)
    fixture :: OSPath.from(env.manifest_dir()).join("Examples/features/packages/monorepo")
    workspace :: isolated_cwd("jobs_workspace")
    fs.remove_dir_all(workspace).unwrap()
    copy_dir_all(fixture, workspace)
    hello :: workspace.join("packages/hello/hello.jet")
    hello_source := fs.read_to_string(hello).unwrap()
    &hello_source.push_str("\n#[Job, Doc(\"Say hello from this workspace member\")] fn greet() {}\n")
    fs.write(hello, hello_source).unwrap()
    ambiguous :: Command.new(jet()).arg("jobs").current_dir(workspace).env("NO_COLOR", "1").output().unwrap()
    ambiguous_stderr :: String.from_utf8_lossy(ambiguous.stderr)
    assert_eq(ambiguous.status.code(), Val(2), "{ambiguous_stderr}")
    assert(ambiguous_stderr.contains("`jet jobs` is ambiguous"), "{ambiguous_stderr}")
    assert(ambiguous_stderr.contains("hello") and ambiguous_stderr.contains("ranker"), "{ambiguous_stderr}")
    assert(ambiguous_stderr.contains("jet jobs -p <member>") and not ambiguous_stderr.contains("jet run"), "{ambiguous_stderr}")
    selected :: Command.new(jet()).args(["jobs", "-p", "hello"]).current_dir(workspace).env("NO_COLOR", "1").output().unwrap()
    assert_eq(selected.status.code(), Val(0), "{String.from_utf8_lossy(selected.stderr)}")
    // A bare #Job is .Dev; every listing includes its scope.
    assert_eq(String.from_utf8(selected.stdout).unwrap(), "greet  [dev] Say hello from this workspace member\n")
}

// Rust: tests/cli_parts/core.rs:469
#Test("project_parts_lists_skipped_explicit_and_conflicting_modules") {
    dir :: isolated_cwd("project_parts")
    fs.write(dir.join("main.jet"), "module app { }\nfn run() {}\n").unwrap()
    fs.write(dir.join("bench.jet"), "module _bench { }\n").unwrap()
    skipped :: Command.new(jet()).args(["project", "parts", "--skipped"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(skipped.status.code(), Val(0))
    stdout :: String.from_utf8(skipped.stdout).unwrap()
    assert(stdout.contains("skipped") and stdout.contains("_bench"), "{stdout}")
    assert(not stdout.contains("app"), "{stdout}")
    fs.write(dir.join("main.jet"), "use project._bench\nmodule app { }\nfn run() {}\n").unwrap()
    explicit :: Command.new(jet()).args(["project", "parts", "--json"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(explicit.status.code(), Val(0))
    explicit_stdout :: String.from_utf8(explicit.stdout).unwrap()
    assert(explicit_stdout.contains("\"name\":\"project._bench\"") and explicit_stdout.contains("\"state\":\"explicit\""), "{explicit_stdout}")
    fs.write(dir.join("other.jet"), "module _bench { }\n").unwrap()
    conflict :: Command.new(jet()).args(["project", "parts"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(conflict.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(conflict.stderr)
    assert(stderr.contains("Error [E0606]:"), "{stderr}")
    assert(stderr.contains(" Why:"), "{stderr}")
    assert(stderr.contains(" Fix:"), "{stderr}")
}

// Rust: tests/cli_parts/core.rs:521
#Test("project_parts_lists_plain_source_files") {
    dir :: isolated_cwd("project_parts_plain_files")
    loop name in ["one", "two", "three", "four", "five"] { fs.write(dir.join("{name}.jet"), "fn run() {}\n").unwrap() }
    listed :: Command.new(jet()).args(["project", "parts"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(listed.status.code(), Val(0))
    stdout :: String.from_utf8(listed.stdout).unwrap()
    assert_eq(stdout.lines().count(), 5, "{stdout}")
    loop name in ["one", "two", "three", "four", "five"] {
        assert(stdout.contains("project.{name}"), "{stdout}")
        assert(stdout.contains("{name}.jet"), "{stdout}")
    }
    skipped :: Command.new(jet()).args(["project", "parts", "--skipped"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(skipped.status.code(), Val(0))
    assert(skipped.stdout.is_empty(), "unexpected stdout: {skipped.stdout.debug()}")
    json :: Command.new(jet()).args(["project", "parts", "--json"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(json.status.code(), Val(0))
    text :: String.from_utf8(json.stdout).unwrap()
    assert(parse_json(text).is_ok(), "project parts JSON must parse: {text}")
    assert(text.contains("\"name\":\"project.one\"") and text.contains("\"path\":\"five.jet\""), "{text}")
}

// Rust: tests/cli_parts/core.rs:574
#Test("project_parts_reports_authority_scan_failures") {
    if target.selected_family() != "unix" { return }
    dir :: isolated_cwd("project_parts_authority_failure")
    loop (name, source) in [("one.jet", "module one { }\n"), ("two.jet", "module two { }\n"), ("three.jet", "module three { }\n"), ("four.jet", "module four { }\n"), ("five.jet", "module five { }\n")] { fs.write(dir.join(name), source).unwrap() }
    std.os.unix.fs.symlink("missing-target", dir.join("result")).unwrap() // GATE #4494
    loop args in [["project", "parts"], ["project", "parts", "--skipped"]] {
        output :: Command.new(jet()).args(args).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), Val(1))
        assert(output.stdout.is_empty(), "unexpected stdout: {output.stdout.debug()}")
        stderr :: String.from_utf8(output.stderr).unwrap()
        assert(stderr.contains("Error [E1334]:") and stderr.contains("result"), "{stderr}")
        assert(stderr.contains(" Why:") and stderr.contains(" Fix:"), "{stderr}")
    }
}

