// Rust: tests/cli_parts/core.rs:863
#Test("budget_build_artifact_measures_real_selected_binary") {
    dir :: artifact_budget_project("budget_build_artifact", 100_000_000)
    out :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0), "stdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert(out.stderr.is_empty())
    command :: match CanonicalJson.parse_canonical(out.stdout).unwrap() { .Object(v) -> v, _ -> panic("command object") }
    report :: match canonical_field(command["budget"], "report") { .Object(v) -> v, _ -> panic("report object") }
    content :: match report["content"] { .Object(v) -> v, _ -> panic("content object") }
    subject :: match content["subject"] { .Object(v) -> v, _ -> panic("subject object") }
    artifact :: match subject["artifact"] { .Object(v) -> v, _ -> panic("artifact identity") }
    bytes :: match artifact["bytes"] { .Integer(v) -> v, _ -> panic("artifact byte count") }
    digest :: match artifact["sha256"] { .String(v) -> v, _ -> panic("artifact digest") }
    artifact_path :: dir.join(".jet/build/run")
    metadata :: fs.metadata(artifact_path).unwrap()
    assert_eq(bytes, metadata.len().to_string())
    assert_eq(digest, sha256_file_hex(artifact_path).unwrap())
    measurements :: match content["measurements"] { .Array(v) -> v, _ -> panic("measurements") }
    measurement :: match measurements[0] { .Object(v) -> v, _ -> panic("measurement") }
    samples :: match measurement["samples"] { .Array(v) -> v, _ -> panic("samples") }
    sample :: match samples[0] { .Object(v) -> v, _ -> panic("sample") }
    assert_eq(sample["num"], CanonicalJson.Integer(metadata.len().to_string()))
    provider :: match measurement["provider"] { .Object(v) -> v, _ -> panic("provider") }
    assert_eq(provider["kind"], CanonicalJson.String("BuildArtifact"))
    assert_eq(measurement["unit"], CanonicalJson.String("Bytes"))
}

// Rust: tests/cli_parts/core.rs:935
#Test("budget_report_collects_mixed_providers_measurement_locally") {
    dir :: mixed_budget_project("budget_mixed_providers")
    out :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0), "stdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert(out.stderr.is_empty())
    command :: match CanonicalJson.parse_canonical(out.stdout).unwrap() { .Object(v) -> v, _ -> panic("command object") }
    report :: match canonical_field(command["budget"], "report") { .Object(v) -> v, _ -> panic("report object") }
    content :: match report["content"] { .Object(v) -> v, _ -> panic("content object") }
    measurements :: match content["measurements"] { .Array(v) -> v, _ -> panic("measurements") }
    assert_eq(measurements.len(), 2)
    providers := [String:String]{}
    loop item in measurements {
        measurement :: match item { .Object(v) -> v, _ -> panic("measurement object") }
        id :: match measurement["budget_id"] { .String(v) -> v, _ -> panic("budget id") }
        provider :: match measurement["provider"] { .Object(v) -> v, _ -> panic("provider") }
        kind :: match provider["kind"] { .String(v) -> v, _ -> panic("provider kind") }
        samples :: match measurement["samples"] { .Array(v) -> v, _ -> panic("samples") }
        assert_eq(samples.len(), 1, "{id} must own its provider sample")
        &providers.insert(id.clone(), kind.clone())
    }
    assert_eq(providers.get("package:binary"), Val("BuildArtifact"))
    assert_eq(providers.get("package:public-api"), Val("CompilerFacts"))
    subject :: match content["subject"] { .Object(v) -> v, _ -> panic("subject") }
    artifact :: match subject["artifact"] { .Object(v) -> v, _ -> panic("shared artifact provenance") }
    bytes :: match artifact["bytes"] { .Integer(v) -> v, _ -> panic("artifact bytes") }
    assert_eq(bytes, fs.metadata(dir.join(".jet/build/run")).unwrap().len().to_string())
    report_path :: fs.read_dir(dir.join(".jet/perf/reports")).unwrap().next().unwrap().unwrap().path()
    verify_budget_report(fs.read(report_path).unwrap()).unwrap()
}

// Rust: tests/cli_parts/core.rs:1020
#Test("build_enforces_deterministic_fail_budgets_and_reuses_relevant_identity") {
    dir :: mixed_budget_project("build_budget_gates")
    source_path :: dir.join("src/run.jet")
    passing :: fs.read_to_string(source_path).unwrap()
    failing :: passing.replace(".AtMost(10)", ".AtMost(0)")
    fs.write(source_path, failing).unwrap()
    failed :: Command.new(jet()).args(["build", "src/run.jet"]).current_dir(dir).output().unwrap()
    assert_eq(failed.status.code(), Val(1), "stdout: {String.from_utf8_lossy(failed.stdout)}\nstderr: {String.from_utf8_lossy(failed.stderr)}")
    assert(not String.from_utf8_lossy(failed.stdout).contains("built:"), "failed budget claimed build success")
    assert(String.from_utf8_lossy(failed.stderr).contains("Error [E2907]: performance budget public-api regressed"), "{String.from_utf8_lossy(failed.stderr)}")
    report_dir :: dir.join(".jet/perf/reports")
    assert_eq(fs.read_dir(report_dir).unwrap().count(), 1)
    fs.write(source_path, passing).unwrap()
    passed :: Command.new(jet()).args(["build", "src/run.jet"]).current_dir(dir).output().unwrap()
    assert_eq(passed.status.code(), Val(0), "stdout: {String.from_utf8_lossy(passed.stdout)}\nstderr: {String.from_utf8_lossy(passed.stderr)}")
    assert(String.from_utf8_lossy(passed.stderr).contains("budgets: 2 budgets passed · report "))
    assert_eq(fs.read_dir(report_dir).unwrap().count(), 2, "source/spec change must refresh evidence")
    reused :: Command.new(jet()).args(["build", "src/run.jet"]).current_dir(dir).output().unwrap()
    assert_eq(reused.status.code(), Val(0), "{String.from_utf8_lossy(reused.stderr)}")
    assert_eq(fs.read_dir(report_dir).unwrap().count(), 2, "unchanged relevant identity must reuse canonical report")
    ci :: Command.new(jet()).args(["build", "src/run.jet", "--profile=ci"]).current_dir(dir).output().unwrap()
    assert_eq(ci.status.code(), Val(0), "stdout: {String.from_utf8_lossy(ci.stdout)}\nstderr: {String.from_utf8_lossy(ci.stderr)}")
    assert_eq(fs.read_dir(report_dir).unwrap().count(), 3, "CI profile identity must refresh evidence")
    profiles := [String]{}
    loop entry in fs.read_dir(report_dir).unwrap() {
        value :: CanonicalJson.parse_canonical(fs.read(entry.unwrap().path()).unwrap()).unwrap()
        report :: match value { .Object(v) -> v, _ -> panic("report") }
        content :: match report["content"] { .Object(v) -> v, _ -> panic("content") }
        subject :: match content["subject"] { .Object(v) -> v, _ -> panic("subject") }
        profile :: match subject["profile"] { .String(v) -> v, _ -> panic("profile") }
        &profiles.push(profile.clone())
    }
    assert(profiles.iter().any(|profile| -> profile == "dev"))
    assert(profiles.iter().any(|profile| -> profile == "ci"))
}

// Rust: tests/cli_parts/core.rs:1130
#Test("budget_bench_measurement_bootstraps_then_consumes_compatible_history") {
    dir :: benchmark_budget_project("budget_bench_measurement")
    bootstrap :: Command.new(jet()).args(["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--reason", "initial benchmark", "--yes", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(bootstrap.status.code(), Val(0), "stdout: {String.from_utf8_lossy(bootstrap.stdout)}\nstderr: {String.from_utf8_lossy(bootstrap.stderr)}")
    first :: match CanonicalJson.parse_canonical(bootstrap.stdout).unwrap() { .Object(v) -> v, _ -> panic("command") }
    first_report :: match canonical_field(first["budget"], "report") { .Object(v) -> v, _ -> panic("report") }
    first_content :: match first_report["content"] { .Object(v) -> v, _ -> panic("content") }
    first_measurements :: match first_content["measurements"] { .Array(v) -> v, _ -> panic("measurements") }
    first_measurement :: match first_measurements[0] { .Object(v) -> v, _ -> panic("measurement") }
    samples :: match first_measurement["samples"] { .Array(v) -> v, _ -> panic("samples") }
    assert_eq(samples.len(), 20)
    assert(first_measurement["statistics"] is .Object(_))
    assert(first_measurement["policy"] is .Object(_))
    assert_eq(first_measurement["history"], CanonicalJson.Null)
    assert_eq(first_measurement["baseline"], CanonicalJson.Null)
    provider :: match first_measurement["provider"] { .Object(v) -> v, _ -> panic("provider") }
    assert_eq(provider["kind"], CanonicalJson.String("BenchMeasurement"))
    assert_eq(provider["identity"], CanonicalJson.String("parse"))
    first_id :: match first_report["report_id"] { .String(v) -> v.clone(), _ -> panic("report id") }
    check :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert(check.status.code() == Val(0) or check.status.code() == Val(1), "stdout: {String.from_utf8_lossy(check.stdout)}\nstderr: {String.from_utf8_lossy(check.stderr)}")
    second :: match CanonicalJson.parse_canonical(check.stdout).unwrap() { .Object(v) -> v, _ -> panic("command") }
    report :: match canonical_field(second["budget"], "report") { .Object(v) -> v, _ -> panic("report") }
    content :: match report["content"] { .Object(v) -> v, _ -> panic("content") }
    measurements :: match content["measurements"] { .Array(v) -> v, _ -> panic("measurements") }
    measurement :: match measurements[0] { .Object(v) -> v, _ -> panic("measurement") }
    history :: match measurement["history"] { .Object(v) -> v, _ -> panic("history") }
    ids :: match history["report_ids"] { .Array(v) -> v, _ -> panic("ids") }
    assert_eq(ids, [CanonicalJson.String(first_id.clone())])
    baseline :: match measurement["baseline"] { .Object(v) -> v, _ -> panic("baseline") }
    pooled :: match baseline["pooled_samples"] { .Array(v) -> v, _ -> panic("pooled") }
    assert_eq(pooled.len(), 20)
    decision :: match measurement["decision"] { .Object(v) -> v, _ -> panic("decision") }
    assert_ne(decision["evidence"], CanonicalJson.String("unavailable"))
    results :: match canonical_field(second["budget"], "results") { .Array(v) -> v, _ -> panic("results") }
    result :: match results[0] { .Object(v) -> v, _ -> panic("result") }
    assert_eq(result["baseline_report_ids"], CanonicalJson.Array([CanonicalJson.String(first_id)]))
    assert_eq(result["metric"], measurement["metric"])
    assert_eq(result["lower95"], decision["lower95"])
    assert_eq(result["upper95"], decision["upper95"])
    assert_eq(result["trend"], decision["trend"])
    assert_eq(result["reason"], decision["reason"])
}
