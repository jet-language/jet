// Rust: tests/memory_semantics.rs:485
#Test("gc_promotions_append_to_the_configured_cross_run_memory_ledger") {
    root :: common.unique_tmp("jet_memory_gc_feed")
    fs.create_dir_all(root).unwrap()
    source :: root.join("gc.jet")
    fs.write(source, `#Policy(gc)
#[!Equatable, !Comparable]
enum Link {
    End(Int)
    Next(Link)
}
fn promoted_cycle() -> Link {
    first := Link.Next(Link.End(1))
    second := Link.Next(first)
    first = Link.Next(second)
    return first
}
fn run() {
    cycle :: promoted_cycle()
    print(cycle)
}
`).unwrap()
    source_text :: source.to_str().unwrap()
    first :: run(root, ["run", source_text])
    assert(first.status.success(), "first GC run failed: {String.from_utf8_lossy(first.stderr)}")
    assert_eq(String.from_utf8_lossy(first.stdout), "Next(Next(Next(End(1))))\n")
    ledger_path :: root.join(".jet/memory/ledger-v1.jsonl")
    first_ledger :: fs.read_to_string(ledger_path).unwrap()
    first_rows :: first_ledger.lines().count()
    assert(first_rows > 0, "the exercised GC run wrote no witnesses")
    assert(first_ledger.lines().all(row -> row.contains("\"kind\":\"gc\"") && row.contains("\"provenance\":\"")))
    second :: run(root, ["run", source_text])
    assert(second.status.success(), "second GC run failed: {String.from_utf8_lossy(second.stderr)}")
    assert_eq(String.from_utf8_lossy(second.stdout), "Next(Next(Next(End(1))))\n")
    persisted :: fs.read_to_string(ledger_path).unwrap()
    assert_eq(persisted.lines().count(), first_rows * 2)
    audit :: run(root, ["audit", "memory", "--json"])
    assert(audit.status.success(), "memory audit failed: {String.from_utf8_lossy(audit.stderr)}")
    audit_text :: String.from_utf8_lossy(audit.stdout)
    assert(audit_text.contains("\"coverage\":\"exercised runs only\""))
    assert(audit_text.contains("\"witnesses\":{first_rows * 2}"))
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/memory_semantics.rs:558
#Test("erased_memory_policy_and_bounds_facts_do_not_escape") {
    erased_policy :: `fn need(value: String) { print(value) }
fn run() {
    source :: "  hello  "
    view :: source.trim()
    #Off {
        #Policy(copies: .Explicit) { print("erased") }
    }
    need(view)
}
`
    jet.compile(erased_policy).expect("an erased explicit-copy policy must be restored")
    active_policy :: `fn need(value: String) { print(value) }
fn run() {
    source :: "  hello  "
    view :: source.trim()
    #Policy(copies: .Explicit) { need(view) }
}
`
    diagnostics :: jet.compile(active_policy).expect_err("active copy policy must remain strict")
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E2307"), "active explicit-copy policy lost its refusal: {diagnostics:#?}")
    erased_bounds :: `fn run() {
    values :: [Int#2]{1, 2}
    #Off { print(values[0]) }
    print(values[2])
}
`
    bounds_diagnostics :: jet.compile(erased_bounds).expect_err("out-of-range indexing must remain rejected")
    assert(bounds_diagnostics.iter().any(diagnostic -> diagnostic.code == "E0965"), "erased bounds facts must not make a later out-of-range read valid: {bounds_diagnostics:#?}")
}
