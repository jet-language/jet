// Rust: tests/memory_semantics.rs:23
#Test("memory_denial_parser_keeps_the_canonical_effect_row") {
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(MEMORY_DENIAL_SOURCE)
    assert(lexer_diagnostics.is_empty(), "lex: {lexer_diagnostics:?}")
    program :: jet.Parser.parse(tokens).expect("memory denial source parses")
    function :: program.items.iter().find_map(item -> item == {
        Item.Func(function) -> if function.name == "run" { Val(function) } else { None }
        _ -> None
    }).expect("run function")
    effects :: function.declared_effects.as_ref().expect("declared denial row").iter().map((name, _) -> name.as_str()).collect()
    assert_eq(effects, ["!Mem.Alloc"])
    (positive_tokens, positive_lex) :: jet.Lexer.lex("fn run() -[Mem.Alloc(above: 1)]> {}")
    assert(positive_lex.is_empty(), "lex positive row: {positive_lex:?}")
    diagnostics :: jet.Parser.parse(positive_tokens).expect_err("bounded rights are denial-only")
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0119" && diagnostic.fix.contains("!Mem.Alloc(above: 1)")))
}
// Rust: tests/memory_semantics.rs:57
#Test("parameterized_memory_rights_are_denials_not_positive_effects") {
    error :: jet.Package.PackageFacts.parse("name: \"memory\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Mem.Alloc(above: 65536)] } }\n", "test").expect_err("a bounded memory right must be a denial")
    assert(error == {
        jet.Package.PackageParseError.BadEffectsBlock(detail) -> detail.contains("authority.holds.deny")
        _ -> false
    })
}
// Rust: tests/memory_semantics.rs:71
#Test("manifest_memory_denial_reaches_the_same_sema_fact_pass") {
    root :: common.unique_tmp("jet_manifest_memory_denial")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("package.jet"), "name: \"memory\"\nversion: \"0.1.0\"\nauthority: { holds: { deny: [Mem.Alloc] } }\n").unwrap()
    fs.write(root.join("main.jet"), "fn run() { print(\"frame {1}\") }\n").unwrap()
    bundle := jet.Loader.load_entry(root.join("main.jet").to_str().unwrap()).unwrap()
    assert_eq(bundle.package_guarantees.memory_denials, ["Mem.Alloc"])
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0921"), "manifest denial did not reach the memory fact pass: {diagnostics:#?}")
    _ :: fs.remove_dir_all(root)
}
