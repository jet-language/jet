// Rust: tests/memory_semantics.rs:236
#Test("one_table_names_the_shared_read_view_copy_kernel_for_every_tier") {
    view_of :: (element: Type) -> Type.Apply{name: "View", args: [element]}
    str_view :: view_of(Type.Named("str"))
    int_view :: view_of(Type.Int)
    tagged_str_view :: Type.Tagged{marker: TagMarker.User("ReadAlias"), inner: str_view.clone()}
    fake_string_view :: Type.Apply{name: "foo.View", args: [Type.Named("str")]}
    fake_list_view :: Type.Apply{name: "foo.ViewMut", args: [Type.Int]}
    malformed_view_placeholder :: Type.Apply{name: "View<>", args: [Type.Named("str")]}
    assert_eq(view_copy_kind(str_view), Val(MirViewCopyKind.String))
    assert_eq(view_copy_kind(str_view).expect("string kind").symbol(), "jet_string_view_copy")
    assert_eq(view_copy_owned_type(str_view), Val(Type.String))
    assert_eq(view_copy_kind(int_view), Val(MirViewCopyKind.List))
    assert_eq(view_copy_kind(int_view).expect("list kind").symbol(), "jet_view_copy")
    assert_eq(view_copy_owned_type(int_view), Val(Type.List(Type.Int)))
    assert_eq(view_copy_kind(tagged_str_view), Val(MirViewCopyKind.String))
    assert_eq(view_copy_owned_type(tagged_str_view), Val(Type.String))
    assert_eq(view_copy_kind(fake_string_view), None)
    assert_eq(view_copy_kind(fake_list_view), None)
    assert_eq(view_copy_kind(malformed_view_placeholder), None)
    assert_eq(view_copy_kind(Type.List(Type.Int)), Val(MirViewCopyKind.List))
    assert_eq(view_copy_kind(Type.String), Val(MirViewCopyKind.String))
    assert_eq(view_copy_owned_type(Type.String), None)
    crate_root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap()).join("crates/jet-codegen/src")
    rust_kernel :: fs.read_to_string(crate_root.join("Prelude/Core/ViewCopy.rs")).unwrap()
    js_kernel :: fs.read_to_string(crate_root.join("Prelude/Core/ViewCopy.js")).unwrap()
    loop symbol in ["jet_view_copy", "jet_string_view_copy"] {
        assert(rust_kernel.contains("fn {symbol}"), "Prelude/Core/ViewCopy.rs must declare {symbol}")
        assert(js_kernel.contains("function {symbol}"), "Prelude/Core/ViewCopy.js must declare {symbol}")
    }
    producer :: fs.read_to_string(crate_root.join("Codegen/TIR/mod.rs")).unwrap()
    assert(producer.contains("MirViewCopyKind"))
    assert(!producer.contains("\"jet_string_view_copy\""))
    assert(!producer.contains("\"jet_view_copy\""))
    lambda_producer :: fs.read_to_string(crate_root.join("Codegen/TIR/lower/lambdas.rs")).unwrap()
    assert(lambda_producer.contains("view_copy_kind"))
    assert(lambda_producer.contains(".symbol()"))
    assert(!lambda_producer.contains("\"jet_string_view_copy\""))
    assert(!lambda_producer.contains("\"jet_view_copy\""))
    loop engine in [crate_root.join("Codegen/MIRRust.rs"), crate_root.join("Codegen/MIRWeb.rs"), crate_root.join("Codegen/MIREval.rs")] {
        text :: fs.read_to_string(engine).unwrap()
        assert(text.contains("mir_view_copy_kind") || text.contains("MirViewCopyKind"), "{engine.display()} must consume the canonical MIR view-copy classifier")
    }
    // Retired JIT representation probe maps to shared-runtime behavior at hosted tiers.
    tir_support.assert_example_cli_tiers_agree("memory/string_view", fs.read_to_string("Examples/features/expected/memory/string_view.out").unwrap())
}
// Rust: tests/memory_semantics.rs:348
#Test("computed_field_nested_value_blocks_use_and_invalidate_sibling_dependencies") {
    src :: `struct Score {
    enabled: Bool
    base: Int
    bonus: Int
    #Memo
    total: Int -> if enabled -> {
        subtotal :: base + bonus
        subtotal
    } else -> base
}
fn run() {
    score := Score{enabled: true, base: 10, bonus: 2}
    print(score.total)
    score.bonus = 7
    print(score.total)
}
`
    tir_support.assert_tiers_agree("computed_field_nested_value", src, "12\n17\n")
}
// Rust: tests/memory_semantics.rs:372
#Test("exercised_memory_ledger_reports_empty_gc_sentry_and_combined_runs") {
    root :: common.unique_tmp("jet_memory_audit")
    fs.create_dir_all(root).unwrap()
    ledger(root, [])
    empty :: run(root, ["audit", "memory", "--json"])
    assert(empty.status.success(), String.from_utf8_lossy(empty.stderr))
    assert_cli_snapshot("memory_audit_empty.txt", empty.stdout)
    empty_json :: String.from_utf8_lossy(empty.stdout)
    assert(empty_json.contains("\"coverage\":\"exercised runs only\""))
    assert(empty_json.contains("\"witnesses\":0"))
    gc :: row("gc", "gc", ["own the value directly"])
    ledger(root, [gc])
    gc_only :: run(root, ["audit", "memory", "--json"])
    gc_json :: String.from_utf8_lossy(gc_only.stdout)
    assert(gc_only.status.success(), String.from_utf8_lossy(gc_only.stderr))
    assert_cli_snapshot("memory_audit_gc.txt", gc_only.stdout)
    assert(gc_json.contains("\"kind\":\"gc\""))
    assert(gc_json.contains("\"witnesses\":1"))
    sentry :: row("sentry", "R0802", ["move the raw access"])
    ledger(root, [sentry])
    sentry_only :: run(root, ["audit", "memory", "--json"])
    sentry_json :: String.from_utf8_lossy(sentry_only.stdout)
    assert(sentry_only.status.success(), String.from_utf8_lossy(sentry_only.stderr))
    assert_cli_snapshot("memory_audit_sentry.txt", sentry_only.stdout)
    assert(sentry_json.contains("\"kind\":\"sentry\""))
    assert(sentry_json.contains("\"witnesses\":1"))
    ledger(root, [gc, sentry])
    combined :: run(root, ["audit", "memory", "--json"])
    combined_json :: String.from_utf8_lossy(combined.stdout)
    assert(combined.status.success(), String.from_utf8_lossy(combined.stderr))
    assert_cli_snapshot("memory_audit_combined.txt", combined.stdout)
    assert(combined_json.contains("\"kind\":\"gc\""))
    assert(combined_json.contains("\"kind\":\"sentry\""))
    assert(combined_json.contains("\"witnesses\":2"))
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/memory_semantics.rs:431
#Test("memory_fix_applies_one_exact_repair_and_names_ambiguous_options") {
    root :: common.unique_tmp("jet_memory_fix")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("main.jet"), "borrow").unwrap()
    exact :: row("gc", "gc", ["owned"])
    ledger(root, [exact])
    fixed :: run(root, ["fix", "memory"])
    assert(fixed.status.success(), String.from_utf8_lossy(fixed.stderr))
    assert_cli_snapshot("memory_fix_exact.txt", fixed.stdout)
    assert_eq(fs.read_to_string(root.join("main.jet")).unwrap(), "owned")
    fs.write(root.join("main.jet"), "borrow").unwrap()
    ambiguous :: row("gc", "gc", ["owned", "#Policy(gc) borrow"])
    ledger(root, [ambiguous])
    unchanged :: run(root, ["fix", "memory"])
    assert(unchanged.status.success(), String.from_utf8_lossy(unchanged.stderr))
    assert_cli_snapshot("memory_fix_ambiguous.txt", unchanged.stdout)
    stdout :: String.from_utf8_lossy(unchanged.stdout)
    assert(stdout.contains("options: main.jet:0..6 observed"))
    assert(stdout.contains("  - owned"))
    assert(stdout.contains("  - #Policy(gc) borrow"))
    assert_eq(fs.read_to_string(root.join("main.jet")).unwrap(), "borrow")
    _ :: fs.remove_dir_all(root)
}
