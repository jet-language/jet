// Rust: tests/memory_semantics.rs:110
#Test("memory_denial_matches_the_dev_interpreter_path") {
    root :: common.unique_tmp("jet_memory_denial_dev")
    fs.create_dir_all(root).unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, MEMORY_DENIAL_SOURCE).unwrap()
    output :: Command.new(jet()).args(["dev", entry.to_str().unwrap(), "--interpret", "--watch=off"]).current_dir(root).env("NO_COLOR", "1").output().unwrap()
    assert(output.status.success(), "dev rejected the memory denial source: {String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8_lossy(output.stdout), "memory denial\n")
    _ :: fs.remove_dir_all(root)
}
