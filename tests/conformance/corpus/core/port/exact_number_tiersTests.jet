// Rust: tests/ffi_callbacks_tasks.rs:97
#Test("foreign_callback_reenters_jet_and_completes_on_a_jet_task") {
    if selected_family() != "unix" { return }
    root :: native_root("success")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).unwrap()
    write_c_library(root)
    fs.write(root.join("package.jet"), "name: \"ffi-callback-task\"\nversion: \"0.1.0\"\ndeps: {{ callback: c@\"{root.display()}\" }}\n").unwrap()
    source :: `use c.callback as c

fn increment(value: I32) -[]> I32 {
    return value + 1
}

#Import module c.callback {
    fn foreign_callback(callback: fn(I32) -[]> I32, value: I32) -> I32 = "foreign_callback"
    fn foreign_async(value: I32) -> I32 = "foreign_async"
}

fn foreign_work() -> I32 {
    return c.foreign_async(41)
}

fn run() -> {
    print(c.foreign_callback(increment, 41))
    print(c.foreign_callback((value) -> value + 1, 41))
    task.group ffi_workers {
        result :: task foreign_work()
        print(result.join() ?? panic("foreign task failed"))
    }
}
`
    jet_path :: root.join("main.jet")
    fs.write(jet_path, source).unwrap()
    output :: compile_with_path(source, jet_path.to_str().unwrap()).unwrap_or_else(diags -> panic("callback/task source was rejected:\n{render_diagnostics(jet_path.to_str().unwrap(), source, diags)}"))
    callback :: output.rust.find("extern \"C\" fn __jet_increment").expect("named callback must use the stable C trampoline")
    callback_end :: callback + output.rust[callback..].find("\n}\n").expect("named callback must have a complete generated body")
    assert(output.rust[callback..callback_end].contains("jet_ffi_callback_boundary"))
    inline_callback :: output.rust.find("extern \"C\" fn __jet_c_callback_").expect("inline callback must use the stable C trampoline")
    inline_callback_end :: inline_callback + output.rust[inline_callback..].find("\n}\n").expect("inline callback must have a complete generated body")
    assert(output.rust[inline_callback..inline_callback_end].contains("jet_ffi_callback_boundary"))
    rust_path :: root.join("main.rs")
    binary :: root.join("main")
    fs.write(rust_path, output.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(rust_path).arg("-o").arg(binary).arg("-L").arg("native={root.display()}").args(["-l", "static=callback", "-l", "pthread"])
    run_ok(&rustc, "generated callback/task Rust link")
    run :: Command.new(binary).output().unwrap()
    assert(run.status.success(), "generated callback/task program failed: {String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "42\n42\n42\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/ffi_callbacks_tasks.rs:188
#Test("foreign_task_boundary_rejects_non_sendable_captured_state") {
    if selected_family() != "unix" { return }
    source :: `use c.callback as c

fn increment(value: I32) -[]> I32 {
    return value + 1
}

#Import module c.callback {
    fn foreign_callback(callback: fn(I32) -[]> I32, value: I32) -> I32 = "foreign_callback"
    fn foreign_async(value: I32) -> I32 = "foreign_async"
}

fn foreign_work() -> I32 {
    return c.foreign_async(41)
}

fn launch(^cell: Cell<Int>) -> {
    task.group ffi_workers {
        result :: task {
            _ :: foreign_work()
            _ :: cell
        }
        result.join() ?? panic("foreign task failed")
    }
}

fn run() -> {}
`
    path :: native_root("reject").join("main.jet")
    root :: path.parent().unwrap()
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).unwrap()
    fs.write(path, source).unwrap()
    diagnostics :: compile_with_path(source, path.to_str().unwrap()).expect_err("a Cell captured across the foreign task boundary must be rejected")
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E1102"), "missing task-boundary rejection: {diagnostics:?}")
    assert(!diagnostics.iter().any(diagnostic -> diagnostic.code == "E3203"), "the valid callback ABI must not be blamed for the captured state: {diagnostics:?}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/floor_division.rs:24
#Test("floor_division_rounds_down_through_zero") {
    if !have_rustc() { return }
    src :: SEED + `
fn run() -> {
    two :: seed(2)
    print(seed(7) /% two)
    print(seed(-7) /% two)
    print(seed(6) /% two)
    print(seed(-6) /% two)
    print(seed(7) /% seed(-2))
    print(seed(-7) /% seed(-2))
}
`
    (code, out) :: build_and_run("floordiv_signs", src)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "3\n-4\n3\n-3\n-4\n3\n", "{out}")
}
// Rust: tests/floor_division.rs:50
#Test("floor_division_on_floats_and_in_place") {
    if !have_rustc() { return }
    src :: SEED + `
fn run() -> {
    print(7.5 /% 2.0)
    print(-7.5 /% 2.0)
    running := seed(9)
    running /%= seed(2)
    print(running)
    running /%= seed(-2)
    print(running)
}
`
    (code, out) :: build_and_run("floordiv_float_compound", src)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "3.0\n-4.0\n4\n-2\n", "{out}")
}
// Rust: tests/floor_division.rs:76
#Test("floor_division_groups_with_the_division_family") {
    if !have_rustc() { return }
    src :: SEED + `
fn run() -> {
    print(seed(20) /% seed(3) /% seed(2))
    print(seed(20) /% (seed(3) /% seed(2)))
    print(seed(2) * seed(7) /% seed(4))
    print(seed(7) /% seed(2) + seed(1))
}
`
    (code, out) :: build_and_run("floordiv_grouping", src)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "3\n20\n3\n4\n", "{out}")
}
