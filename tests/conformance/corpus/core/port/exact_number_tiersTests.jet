// Rust: tests/floor_division.rs:438
#Test("args_divisor_uses_live_invocation_argv") {
    src :: "use core.term as io\n{SEED}\nfn run() -> {{\n    raw :: process.argv().get(1) ?? \"0\"\n    print(seed(10) /% (Int.parse(raw) ?? 0))\n}}\n"
    (code, out, err) :: jit_run_with_env_args("jit_args_live_divisor", src, [], ["5"])
    assert_eq(code, 0, "live args divisor must run: out={out} err={err}")
    assert_eq(out, "2\n", "10 /% 5 from argv, got: {out}")
    assert(!err.contains("E0953") && !err.contains("comptime"), "args divisor must not use comptime voice: {err}")
}
