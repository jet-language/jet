// Rust: tests/floor_division.rs:260
#Test("the_division_family_agrees_on_every_tier") {
    src :: SEED + `
fn run() -> {
    two :: seed(2)
    print(seed(7) /% two)
    print(seed(-7) /% two)
    print(seed(7) /% seed(-2))
    print(seed(-7) /% seed(-2))
    print(seed(7) % two)
    print(seed(-7) % two)
    print(seed(7) %% two)
    print(seed(-7) %% two)
    print(7.5 /% 2.0)
    print(-7.5 /% 2.0)
    running := seed(9)
    running /%= seed(2)
    print(running)
    slot := seed(-3)
    slot %= seed(5)
    print(slot)
    debt := seed(-7)
    debt %%= seed(5)
    print(debt)
}
`
    assert_tiers_agree("division_family_tiers", src, "3\n-4\n-4\n3\n1\n1\n1\n-1\n3.0\n-4.0\n4\n2\n-2\n")
}
