// Rust: tests/floor_division.rs:122
#Test("floor_division_and_modulo_satisfy_the_division_identity") {
    if !have_rustc() { return }
    src :: SEED + `
fn check(a: Int, b: Int) -> {
    print(b * (a /% b) + a % b == a)
}

fn run() -> {
    check(seed(7), seed(2))
    check(seed(-7), seed(2))
    check(seed(7), seed(-2))
    check(seed(-7), seed(-2))
    check(seed(9), seed(3))
    check(seed(-9), seed(3))
}
`
    (code, out) :: build_and_run("floordiv_identity", src)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "true\ntrue\ntrue\ntrue\ntrue\ntrue\n", "{out}")
}
