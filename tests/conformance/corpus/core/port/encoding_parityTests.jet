// Rust: tests/encoding_parity.rs:451
fn configured_csv_options_match_aot_default_dev_and_interpreter_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping configured CSV parity (need rustc)"); return }
    scratch :: Scratch.new("configured_csv")
    path :: scratch.write_project("2026", CONFIGURED_CSV_RUNTIME)
    fs.write(scratch.path().join("package.jet"), "name: \"configured-csv\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc] }} }}\n").unwrap()
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "configured CSV AOT failed: {aot.stderr}")
    expected :: "1\n3\nada\nline1|line2\n1\ntrue\n"
    assert_eq(aot.stdout, expected, "configured CSV AOT output drift")
    (_, dev) :: run_default_dev(path.to_str().unwrap())
    assert_eq(dev.exit, 0, "configured CSV default-dev failed: {dev.stderr}")
    assert_eq(dev.stdout, aot.stdout, "configured CSV default-dev drift")
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter.exit, 0, "configured CSV interpreter failed: {interpreter.stderr}")
    assert_eq(interpreter.stdout, aot.stdout, "configured CSV interpreter drift")
}
// Rust: tests/encoding_parity.rs:476
