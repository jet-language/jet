// Rust: tests/encoding_parity.rs:1567
#Test("json_stream_reader_writer_matches_aot_and_default_dev") {
    on_encoding_stack(() -> {
        assert(common.have_rustc(), "criterion 5 requires rustc: the canonical encoding_json_stream example must execute across all tiers")
        root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
        jet_path :: root.join("Examples/features/serde/encoding_json_stream.jet")
        python_path :: root.join("Examples/features/serde/encoding_json_stream.py")
        expected_path :: root.join("Examples/features/expected/serde/encoding_json_stream.out")
        expected :: fs.read_to_string(expected_path).expect("canonical encoding golden")
        expected_json :: "{{\"a\":1,\"b\":2}}"
        expected_events :: "event:ObjectStart\nevent:Key:a\nevent:Int:1\nevent:Key:b\nevent:Int:2\nevent:ObjectEnd\n"
        expected_runtime :: "{expected_events}read-count:6\neof\n{expected_json}\n"
        assert_eq(expected, expected_runtime, "canonical golden must pin each JSON stream event identity and serialized content")
        python_scratch :: Scratch.new("json-stream-python")
        python_output_path :: python_scratch.path().join("python.json")
        python :: Command.new("python3").arg(python_path).arg(python_output_path).output().expect("matched Python encoding fixture must execute")
        assert(python.status.success(), "matched Python encoding fixture failed:\n{String.from_utf8_lossy(python.stderr)}")
        assert_eq(String.from_utf8_lossy(python.stdout), expected_json, "matched Python fixture serialized content")
        assert_eq(fs.read_to_string(python_output_path).expect("Python fixture output"), expected_json, "matched Python fixture file content")
        canonical_source :: fs.read_to_string(jet_path).expect("canonical encoding source")
        scratch :: Scratch.new("json-stream-canonical")
        staged_path :: scratch.write_project("2026", canonical_source)
        aot :: run_aot(staged_path, scratch.path())
        (backend, dev) :: run_default_dev(staged_path.to_str().unwrap())
        assert_eq(backend, DevBackend.O0, "canonical encoding example must execute on default O0")
        interpreter :: run_forced_interpreter(staged_path.to_str().unwrap())
        loop (label, output) in [("AOT", aot), ("default O0", dev), ("forced interpreter", interpreter)] {
            assert_eq(output.exit, 0, "{label} canonical encoding run failed: {output.stderr}")
            assert(output.stderr.is_empty(), "{label} emitted stderr: {output.stderr}")
            assert_eq(output.stdout, expected_runtime, "{label} output drifted from the canonical serialized stream")
            assert(output.stdout.contains(expected_json), "{label} output is missing serialized JSON content")
        }
        assert_eq(dev, aot, "default O0 drifted from canonical AOT")
        assert_eq(interpreter, aot, "forced interpreter drifted from canonical AOT")
        tir_support.assert_tiers_agree("json_stream_canonical", canonical_source, expected_runtime)
    })
}
