    assert_eq(dev, aot, "hostile JSON/TOML default run diverged from AOT")
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter, aot, "hostile JSON/TOML forced interpreter diverged from AOT")
}
