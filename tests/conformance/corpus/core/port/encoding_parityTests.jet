// Rust: tests/encoding_parity.rs:480
fn serde_examples_match_aot_default_resident_jit_and_interpreter_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping serde example parity (need rustc)"); return }
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    scratch :: Scratch.new("serde_examples")
    loop (stem, expected) in [
        ("serde/encoding_breadth", "{{\"a\":1,\"b\":2}}\ntrue\n2\ntrue\n<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>\ntrue\n{{\"a\":1,\"b\":2}}\naGk\n2\nNBUQ====\n2\n"),
        ("serde/serde_generic", "{{\"value\":7}}\n42\n{{\"value\":\"hi\"}}\n{{\"raw\":9}}\n3\n"),
        ("serde/codable_default", "{{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}}\nweb\n[80, 443]\nprod\n{{\"name\":\"web\",\"ports\":[80,443],\"env\":\"prod\"}}\n[8080]\n")
    ] {
        jet_path :: root.join("Examples/features").join("{stem}.jet")
        expected_path :: root.join("Examples/features/expected").join("{stem}.out")
        assert_eq(fs.read_to_string(expected_path).expect("serde golden output"), expected, "{stem} golden output drifted")
        aot :: run_aot(jet_path, scratch.path())
        expected_output :: ProgramOutput.ran(expected.to_string(), "", 0)
        assert_eq(aot, expected_output, "{stem} AOT output drifted")
        (backend, default_run) :: run_default_dev(jet_path.to_str().unwrap())
        assert_eq(backend, DevBackend.O0, "{stem} default run must use O0")
        assert_eq(default_run, aot, "{stem} default run diverged from AOT")
        interpreter :: run_forced_interpreter(jet_path.to_str().unwrap())
        assert_eq(interpreter, aot, "{stem} interpreter diverged from AOT")
    }
}
