// Rust: tests/encoding_parity.rs:955
fn cbor_migration_plan_matches_aot_and_forced_deopt_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping CBOR migration parity (need rustc)"); return }
    source :: `
use core.encoding.cbor as cbor
use core.text as text
#Codable
struct ScoreRank { value: Int }
// v1: legacyId/name/score; v2 removes legacyId; v3 renames/converts; v4 adds hostName.
#[PublishedSchema, Codable, RenameAll(camel)]
struct Profile {
    display_name: String
    score: ScoreRank
    host_name: String
}
migration Profile { remove legacy_id }
migration Profile {
    rename name -> display_name
    change score: Int -> ScoreRank via { (n) -> ScoreRank{ value: n } }
}
migration Profile { add host_name: String = "localhost" }
fn decode_old() -[]> String {
    bytes :: [U8]{
        0xa3,
        0x64, 0x6e, 0x61, 0x6d, 0x65,
        0x63, 0x41, 0x64, 0x61,
        0x65, 0x73, 0x63, 0x6f, 0x72, 0x65,
        0x18, 0x5f,
        0x68, 0x6c, 0x65, 0x67, 0x61, 0x63, 0x79, 0x49, 0x64,
        0x09
    }
    profile :: cbor.decode<Profile>(~bytes) ?? panic("decode")
    return "{profile.display_name}|{profile.score.value}|{profile.host_name}"
}
fn forced_deopt() -[]> String {
    if text.casefold("Straße") != "strasse" { panic("casefold") }
    bytes :: [U8]{
        0xa3,
        0x64, 0x6e, 0x61, 0x6d, 0x65,
        0x63, 0x41, 0x64, 0x61,
        0x65, 0x73, 0x63, 0x6f, 0x72, 0x65,
        0x18, 0x5f,
        0x68, 0x6c, 0x65, 0x67, 0x61, 0x63, 0x79, 0x49, 0x64,
        0x09
    }
    profile :: cbor.decode<Profile>(~bytes) ?? panic("decode")
    return "{profile.display_name}|{profile.score.value}|{profile.host_name}"
}
fn failed_change() -[]> String {
    bytes :: [U8]{
        0xa3,
        0x64, 0x6e, 0x61, 0x6d, 0x65,
        0x63, 0x41, 0x64, 0x61,
        0x65, 0x73, 0x63, 0x6f, 0x72, 0x65,
        0x63, 0x62, 0x61, 0x64,
        0x68, 0x6c, 0x65, 0x67, 0x61, 0x63, 0x79, 0x49, 0x64,
        0x09
    }
    cbor.decode<Profile>(~bytes) ? _value -> return "accepted" ! error -> return "{error[0].path}:{error[0].reason}"
}
fn run() -> {
    print(forced_deopt())
    print(failed_change())
}
`
    scratch :: Scratch.new("cbor_migration_deopt")
    path :: scratch.write_project("2026", source)
    fs.write(scratch.path().join("package.jet"), "name: \"enc\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc] }} }}\n").unwrap()
    _ :: checked_bundle(path.to_str().unwrap())
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "migration corpus AOT failed: {aot.stderr}")
    assert_eq(aot.stdout, "Ada|95|localhost\nscore:expected Int, found text \"bad\"\n")
    (backend, dev) :: run_default_dev(path.to_str().unwrap())
    assert_eq(backend, DevBackend.O0)
    assert_eq(dev, aot)
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter, aot, "migration interpreter drift")
    tir_support.assert_tiers_agree("cbor_migration_deopt", source, aot.stdout)
}
