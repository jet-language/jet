// Rust: tests/encoding_parity.rs:694
fn json_quoted_unicode_and_duplicate_key_errors_match_all_tiers_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping JSON quoted Unicode parity (need rustc)"); return }
    source :: `
use core.encoding as encoding
use core.encoding.json as json
fn run() -> {
    value :: json.parse("{{\"text\":\"quote: \\\" and music: \\uD834\\uDD1E\"}}") ?? panic("valid JSON")
    print(json.to_string(value))
    json.parse("{{\"a\":1,\"a\":}}") ? _value -> {
        print("duplicate accepted")
    } ! error -> {
        print("{error.kind == encoding.EncodingErrorKind.Syntax}|{error.path}|{error.reason}")
    }
}
`
    scratch :: Scratch.new("json_quoted_unicode_duplicate_key")
    path :: scratch.write_project("2026", source)
    expected :: "{{\"text\":\"quote: \\\" and music: 𝄞\"}}\ntrue|/a|duplicate object key `a`\n"
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "JSON quoted Unicode AOT failed: {aot.stderr}")
    assert_eq(aot.stdout, expected)
    (backend, dev) :: run_default_dev(path.to_str().unwrap())
    assert_eq(dev, aot, "default-dev backend: {backend.debug()}")
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter, aot, "forced interpreter diverged")
}
// Rust: tests/encoding_parity.rs:728
#Test("cbor_typed_schema_matches_comptime_default_dev_and_deopt") {
    on_encoding_stack(cbor_typed_schema_matches_comptime_default_dev_and_deopt_inner)
}
// Rust: tests/encoding_parity.rs:732
fn cbor_typed_schema_matches_comptime_default_dev_and_deopt_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping typed CBOR schema parity (need rustc)"); return }
    source :: `
use core.encoding.cbor as cbor
use core.encoding.hex as hex
use core.text as text
#Codable
struct Packet { id: Int, payload: [U8] }
ROOT :: prep { hex.encode(cbor.to_bytes_canonical([U8]{222, 173}) ?? panic("root")) }
PACKET :: prep { hex.encode(cbor.to_bytes_canonical(Packet{ id: 7, payload: [222, 173] }) ?? panic("packet")) }
fn gap() -[]> String {
    folded := text.casefold("Straße")
    if folded != "strasse" { panic("casefold") }
    actual_root := hex.encode(cbor.to_bytes_canonical([U8]{222, 173}) ?? panic("root"))
    actual_packet := hex.encode(cbor.to_bytes_canonical(Packet{ id: 7, payload: [222, 173] }) ?? panic("packet"))
    return "{actual_root}|{actual_packet}"
}
fn run() -> {
    print("{ROOT}|{PACKET}")
    print(gap())
}
`
    scratch :: Scratch.new("cbor_typed_schema")
    path :: scratch.write_project("2026", source)
    _ :: checked_bundle(path.to_str().unwrap())
    expected :: "42dead|a262696407677061796c6f616442dead\n42dead|a262696407677061796c6f616442dead\n"
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "typed CBOR AOT failed: {aot.stderr}")
    assert_eq(aot.stdout, expected)
    (backend, dev) :: run_default_dev(path.to_str().unwrap())
    assert_eq(dev.exit, 0, "typed CBOR default-dev failed: {dev.stderr}")
    assert_eq(dev.stdout, expected, "default-dev backend: {backend.debug()}")
    assert_eq(backend, DevBackend.O0)
    // Mixed JIT/deopt representation checks become shared compiled-tier and
    // interpreter behavior checks, retaining the named gap function.
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter, aot)
    tir_support.assert_tiers_agree("cbor_typed_schema", source, expected)
}
// Rust: tests/encoding_parity.rs:792
#Test("cbor_codable_bodies_match_aot_resident_and_forced_deopt") {
    on_encoding_stack(cbor_codable_bodies_match_aot_resident_and_forced_deopt_inner)
}
// Rust: tests/encoding_parity.rs:796
fn cbor_codable_bodies_match_aot_resident_and_forced_deopt_inner() -> {
    if !common.have_rustc() { eprintln("note: skipping forced-deopt Codable parity (need rustc)"); return }
    source :: `
use core.encoding.cbor as cbor
use core.encoding.hex as hex
use core.text as text

struct Token { raw: String }
impl Token.Encode {
    fn encode(self) -> DataTree { DataTree.Text("wire") }
}
impl Token.Decode {
    fn decode(tree: DataTree) -[]> Token ![FieldError] {
        value :: tree.text()
        if value != "wire" {
            return Err([FieldError{ path: "$xml_event", reason: "bad token" }])
        }
        return Ok(Token{ raw: "decoded" })
    }
}
#Codable
enum Event { Idle, Count(Int) }
#Codable
struct Wrap<T> { value: T }
#[Codable, RenameAll(camel)]
struct Packet {
    display_name: String
    token: Token
    event: Event
    bytes: [U8]
    numbers: [Int]
    labels: [String:Int]
    maybe: ?Int
    score: Float
    letter: Char
}
fn resident() -[]> String {
    value := Packet{
        display_name: "Ada",
        token: Token{ raw: "ignored" },
        event: Event.Count(7),
        bytes: [222, 173],
        numbers: [-2, 3],
        labels: [String:Int]{ "x": 6 },
        maybe: Val(8),
        score: 1.5,
        letter: 'Z'
    }
    encoded := cbor.to_bytes_canonical(value) ?? panic("encode")
    decoded := cbor.decode<Packet>(~encoded) ?? panic("decode {err}")
    roundtrip := cbor.to_bytes_canonical(decoded) ?? panic("re-encode")
    boxed := cbor.decode<Wrap<Int>>([U8]{ 0xa1, 0x65, 0x76, 0x61, 0x6c, 0x75, 0x65, 0x0b }) ?? panic("generic decode")
    boxed_wire := cbor.to_bytes_canonical(boxed) ?? panic("generic encode")
    boxed_back := cbor.decode<Wrap<Int>>(~boxed_wire) ?? panic("generic roundtrip")
    return "{hex.encode(encoded)}|{hex.encode(roundtrip)}|{decoded.token.raw}|{boxed_back.value}"
}
fn forced_deopt(seed: String) -[]> String {
    folded := text.casefold(seed)
    if folded != "strasse" { panic("casefold") }
    value := Packet{
        display_name: "Ada",
        token: Token{ raw: "ignored" },
        event: Event.Count(7),
        bytes: [222, 173],
        numbers: [-2, 3],
        labels: [String:Int]{ "x": 6 },
        maybe: Val(8),
        score: 1.5,
        letter: 'Z'
    }
    encoded := cbor.to_bytes_canonical(value) ?? panic("encode")
    decoded := cbor.decode<Packet>(~encoded) ?? panic("decode {err}")
    roundtrip := cbor.to_bytes_canonical(decoded) ?? panic("re-encode")
    boxed := cbor.decode<Wrap<Int>>([U8]{ 0xa1, 0x65, 0x76, 0x61, 0x6c, 0x75, 0x65, 0x0b }) ?? panic("generic decode")
    boxed_wire := cbor.to_bytes_canonical(boxed) ?? panic("generic encode")
    boxed_back := cbor.decode<Wrap<Int>>(~boxed_wire) ?? panic("generic roundtrip")
    return "{hex.encode(encoded)}|{hex.encode(roundtrip)}|{decoded.token.raw}|{boxed_back.value}"
}
fn run() -> {
    print(resident())
    print(forced_deopt("Straße"))
}
`
    scratch :: Scratch.new("cbor_codable_deopt")
    path :: scratch.write_project("2026", source)
    fs.write(scratch.path().join("package.jet"), "name: \"enc\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc] }} }}\n").unwrap()
    _ :: checked_bundle(path.to_str().unwrap())
    aot :: run_aot(path, scratch.path())
    assert_eq(aot.exit, 0, "Codable corpus AOT failed: {aot.stderr}")
    lines := aot.stdout.lines()
    resident :: lines.next().expect("resident output")
    deopt :: lines.next().expect("deopt output")
    assert_eq(resident, deopt, "AOT corpus functions diverged")
    assert(resident.ends_with("|decoded|11"), "custom and generic Decode bodies did not run: {resident}")
    assert(lines.next().is_none(), "unexpected AOT output: {aot.stdout}")
    (backend, dev) :: run_default_dev(path.to_str().unwrap())
    assert_eq(backend, DevBackend.O0)
    assert_eq(dev, aot)
    interpreter :: run_forced_interpreter(path.to_str().unwrap())
    assert_eq(interpreter, aot, "codec corpus interpreter drift")
    tir_support.assert_tiers_agree("cbor_codable_deopt", source, aot.stdout)
}
