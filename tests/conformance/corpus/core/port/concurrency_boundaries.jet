// Rust: tests/concurrency_boundaries.rs:1
use tests.common as common
use jet.[compile, CompileOutput]
use std.fs as fs
use std.env as env
use std.process.[Command]

// Rust: tests/concurrency_boundaries.rs:3
fn error_codes(source: String) -> [String] {
    compile(source).expect_err("adversarial data-race source must not compile").into_iter().map(|diagnostic| -> diagnostic.code).collect()
}
// Rust: tests/concurrency_boundaries.rs:43
fn assert_rejected(source: String, code: String) -> {
    codes :: error_codes(source)
    assert(codes.iter().any(|found| -> found == code), "expected {code}, got {codes.debug()}")
}
// Rust: tests/concurrency_boundaries.rs:496
// D-TASKBORROW1=A: groups join all children; loans require disjoint writes.
// Detached tasks and channels retain ownership-only crossing rules.
// Rust: tests/concurrency_boundaries.rs:501
fn assert_accepted(source: String) -> CompileOutput {
    match compile(source) {
        Ok(output) -> output
        Err(diagnostics) -> panic("source must compile, got {diagnostics.iter().map(|diagnostic| -> diagnostic.code.clone()).collect<[String]>().debug()}")
    }
}
// Rust: tests/concurrency_boundaries.rs:514
PARTICLES :: """
struct Particle { position: Int, velocity: Int }
"""

// Rust: tests/concurrency_boundaries.rs:193,243,264,476,535
// Native behavioral replacements for retired generated-Rust storage/spawn checks.
// GATE #4494: filesystem and process provider; exercises real synchronized work.
fn assert_native_crossing(name: String, source: String, expected: String) -> {
    _ :: assert_accepted(source)
    scratch :: common.Scratch.new("crossing_{name}")
    fs.write(scratch.join("fixture.jet"), source).expect("write concurrency fixture")
    executable :: env.var("CARGO_BIN_EXE_jet").unwrap()
    build :: Command.new(executable).args(["build", "fixture.jet"]).current_dir(scratch.path)
        .env("JET_STORE_DIR", scratch.join("cache/build")).env("NO_COLOR", "1").output().expect("build concurrency fixture")
    assert(build.status.success(), "{name} native build failed: {String.from_utf8_lossy(build.stderr)}")
    aot :: Command.new(scratch.join(".jet/build/fixture")).current_dir(scratch.path).output().expect("run concurrency fixture")
    assert_eq(aot.status.code(), Val(0), "{name} native execution failed: {String.from_utf8_lossy(aot.stderr)}")
    assert_eq(String.from_utf8_lossy(aot.stdout), expected, "{name} native synchronized result changed")
    loop (tier, args) in [("default", ["run", "fixture.jet"]), ("release", ["run", "--release", "fixture.jet"])] {
        output :: Command.new(executable).args(args).current_dir(scratch.path)
            .env("JET_STORE_DIR", scratch.join("cache/{tier}/build")).env("JET_RUN_CACHE_DIR", scratch.join("cache/{tier}/run"))
            .env("NO_COLOR", "1").output().expect("run native concurrency tier")
        assert_eq(output.status.code(), Val(0), "{name} {tier} execution failed: {String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected, "{name} {tier} synchronized result changed")
    }
}
