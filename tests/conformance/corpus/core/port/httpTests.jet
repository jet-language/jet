}

// Rust: tests/http_dependency_audit.rs:20
#Test("http_manifests_have_no_new_external_http_or_compression_crates") {
    forbidden :: ["hyper", "reqwest", "ureq", "attohttpc", "isahc", "surf", "awc", "actix-web", "axum", "warp", "tiny_http", "flate2", "libflate", "brotli", "async-compression", "tokio", "h2 ", "http-body"]
    loop path in ["crates/jet-codegen/Cargo.toml", "crates/jet-pkg-model/Cargo.toml"] {
        text :: read(path)
        loop needle in forbidden {
            if needle == "h2 " { next }
            needle_eq :: "{needle} ="
            needle_dot :: "{needle}."
            assert(!text.contains(needle_eq) && !text.lines().any(line -> {
                trimmed := line.trim_start() // #4303
                trimmed.starts_with(needle) && (trimmed[needle.len()..].starts_with(" =") || trimmed[needle.len()..].starts_with("."))
            }) && !text.contains(needle_dot), "{path} must not depend on `{needle}`")
        }
        if path.ends_with("jet-pkg-model/Cargo.toml") {
            assert(text.contains("rustls"), "jet-pkg-model may keep the ratified rustls TLS bridge")
        }
    }
}
// Rust: tests/http_dependency_audit.rs:78
#Test("http_prelude_sources_do_not_import_forbidden_http_crates") {
    forbidden_imports :: ["use ureq", "use hyper", "use reqwest", "use flate2", "use brotli", "use tokio", "extern crate ureq", "extern crate hyper", "extern crate flate2"]
    sources :: ["crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPMessage.rs", "crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPRoute.rs", "crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPClient.rs", "crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs", "crates/jet-codegen/src/Prelude/CoreLib/Top/Ws.rs", "crates/jet-pkg-model/src/Prelude/HTTP.rs"]
    loop path in sources {
        text :: read(path)
        loop needle in forbidden_imports { assert(!text.contains(needle), "{path} must not import `{needle}`") }
    }
    client :: read("crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPClient.rs")
    assert(!client.to_ascii_lowercase().contains("ureq"), "HTTPClient prelude must not mention ureq")
}
// Rust: tests/http_dependency_audit.rs:113
#Test("unsupported_target_variant_is_mapped_from_bridge_and_server_bind") {
    bridge :: read("crates/jet-codegen/src/Codegen/TIR/emit/core_calls.rs")
    assert(bridge.contains("JetHTTPBridgeError::UnsupportedTarget => JetHTTPError::UnsupportedTarget") && bridge.contains("JetHTTPOperation::ClientConnect"), "client bridge must map UnsupportedTarget to ClientConnect")
    assert(bridge.contains("unsupported-target:server-bind"), "server bind must map UnsupportedTarget before IO fallback")
    assert(bridge.contains("JetHTTPOperation::ServerBind"), "server bind UnsupportedTarget must name ServerBind")
    server :: read("crates/jet-codegen/src/Prelude/CoreLib/Top/HTTPServer.rs")
    assert(server.contains("unsupported-target:server-bind"), "server bind must preflight unsupported targets")
    client :: read("crates/jet-pkg-model/src/Prelude/HTTP.rs")
    assert(client.contains("JetHTTPBridgeError::UnsupportedTarget"), "client send must be able to return UnsupportedTarget")
}
