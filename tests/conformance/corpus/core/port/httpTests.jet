// Rust: tests/resource_close.rs:94
#Test("defer_close_has_explicit_tir_codegen_and_stable_formatting") {
    out :: compile(SIMPLE)
    assert(out.rust.contains("JetDeferredClose"), "{out.rust}")
    assert(out.rust.contains("__jet_Close::close(__jet___resource_resource_") && out.rust.contains(".take())"), "{out.rust}")
    once :: format_source(SIMPLE).expect("deferred close should format")
    assert(once.contains("defer close(^resource)"), "{once}")
    twice :: format_source(once).expect("formatted deferred close should parse")
    assert_eq(once, twice)
}
