// Rust: tests/http.rs:49
#Test("jit_http_readiness_uses_shared_scheduler_poller") {
    scheduler :: read("crates/jet-codegen/src/Prelude/Scheduler.rs")
    net :: read("crates/jet-codegen/src/Prelude/CoreLib/Top/NetHTTP.rs")
    loop symbol in ["jet_scheduler_io_wait", "jet_scheduler_tcp_listener_io_wait", "jet_scheduler_tcp_stream_ready_wait", "jet_scheduler_udp_io_wait"] {
        assert(scheduler.contains("pub fn {symbol}"), "Prelude scheduler does not define {symbol}")
    }
    if selected_family() == "unix" {
        assert(net.contains("jet_scheduler_tcp_stream_ready_wait(stream, read, write, operation)"), "TCP stream waits must use the shared raw-fd poller")
    }
    if have_rustc() { on_large_stack(() -> { assert_http_example_matches_all_tiers("http_readiness") }) }
}
// Rust: tests/http.rs:82
#Test("resident_http_stop_uses_the_shared_runtime_boundary") {
    source :: `use core.http as http
fn run() -> {
    _ :: http.get("http://127.0.0.1:0/") ?? panic("resident HTTP failure")
}
`
    loop run in [tir_support.run_default_multi, tir_support.build_and_run_multi, tir_support.build_release_and_run_multi] {
        (code, stdout, stderr) :: run("resident_http_stop", "main.jet", [("main.jet", source)])
        assert_eq(code, 70, "resident HTTP failure must use the shared runtime report boundary: {stdout} {stderr}")
        assert(stderr.contains("Stop [E3001]"), "resident HTTP failure must retain registered runtime stop: {stderr}")
        assert_eq(stderr.matches("Stop [E3001]").count(), 1, "resident HTTP stop must be rendered once: {stderr}")
    }
}
