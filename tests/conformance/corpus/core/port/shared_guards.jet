// D-SHAREDGUARD1=A: expert Shared guards keep one meaning across execution tiers.
use tests.common as common
use std.fs as fs
use std.process.Command
use std.thread
// GATE #4494: real compiler-stack threads and native subprocesses.

// Rust: tests/shared_guards.rs:9
QUEUE :: include_str("../Examples/features/memory/shared_guard_queue.jet")
// Rust: tests/shared_guards.rs:11
CANCEL_WAIT :: `
fn mark_started(started: Shared<Int>, began: Condition) -> {
    started_guard :: started.guard_edit()
    started_guard.value = 1
    began.notify_all()
}
fn wait_until_cancel(handle: Shared<Int>, changed: Condition, started: Shared<Int>, began: Condition) -> Int {
    mark_started(started, began)
    guard :: handle.guard_edit()
    guard.wait(changed, value -> value == 1) ?? panic("wait failed")
    return 1
}
fn finish_after_start(started: Shared<Int>, began: Condition) -> Int {
    started_guard :: started.guard_edit()
    started_guard.wait(began, value -> value == 1) ?? panic("start failed")
    return 7
}
fn run() -> {
    cell := shared 0
    changed := Condition.new()
    started := shared 0
    began := Condition.new()
    task.group workers {
        print((task.race {
            wait_until_cancel(cell, changed, started, began),
            finish_after_start(started, began)
        }) ?? panic("race failed"))
    }
    reacquired :: cell.guard_edit()
    reacquired.value += 1
    print(reacquired.value)
}
`
// Rust: tests/shared_guards.rs:53
EARLY_EXITS :: `
#Error
enum EarlyExitError { Stop }
fn return_early(handle: Shared<Int>) -> {
    guard :: handle.guard_edit()
    guard.value += 1
    return
}
fn fail_early(handle: Shared<Int>) -> Int EarlyExitError! {
    guard :: handle.guard_edit()
    guard.value += 1
    return .Err(EarlyExitError.Stop)
}
fn run() -> {
    cell := shared 0
    return_early(cell)
    _ :: fail_early(cell) ?? 0
    guard :: cell.guard_edit()
    guard.value += 1
    print(guard.value)
}
`
