//RS /// A generator whose `yield` sits inside `#Shield`. The consumer's `break`
//RS /// cancels the producer child while it is parked at that yield.
//RS const SHIELDED_STREAM_SOURCE: &str = r#"
//RS fn shielded_tail() -> Stream<Int> {
//RS     #Shield {
//RS         yield 1
//RS         print("shielded: after")
//RS     }
//RS     print("unshielded: after")
//RS     yield 2
//RS }
//RS 
//RS fn run() {
//RS     loop x in shielded_tail() {
//RS         print("consumer: {x}")
//RS         break
//RS     }
//RS     print("closed")
//RS }
//RS "#;
//RS 
//RS const SHIELDED_STREAM_EXPECTED: &str = "consumer: 1\nshielded: after\nclosed\n";
//RS 
//RS /// D-CONC-STREAM1=A + D-CANCELMODEL1=C: `yield` is a wait point and drop-close
//RS /// is a cancel, so a cancel that arrives while the producer is inside `#Shield`
//RS /// is DEFERRED to the region exit — exactly as for any other cancelled task.
//RS /// The shielded tail runs, the unshielded tail never does, and the consumer's
//RS /// `break` is still ordinary completion, not a program error.
//RS ///
//RS /// This is the case a stream-local shutdown law got wrong: it stopped the
//RS /// producer at the yield and skipped the shielded tail, because it read a
//RS /// stream-only cancellation fact instead of the task wait policy. One law
//RS /// cannot disagree with itself, so all three tiers print the same transcript.
//RS #[test]
//RS fn a_shielded_yield_defers_the_consumer_cancel_on_every_tier() {
