//RS     );
//RS     assert_eq!(code, 0, "default JIT: {stderr}");
//RS     assert_eq!(
//RS         strip_tier_trace(&stdout),
//RS         SHIELDED_STREAM_EXPECTED,
//RS         "JIT drifted: {stderr}"
//RS     );
//RS 
//RS     if have_rustc() {
//RS         let (code, stdout) = build_and_run("shielded_stream", SHIELDED_STREAM_SOURCE);
//RS         assert_eq!(code, 0);
//RS         assert_eq!(stdout, SHIELDED_STREAM_EXPECTED);
