// Rust: tests/comptime_core_pure_parity.rs:470
fn exact_values(inputs: [String]) -> [String] {
    // Match the product compiler's sized stack rather than the test runner's platform-default stack.
    output :: thread.scope(|scope| -> thread.Builder.new().name("comptime-core-pure-transcript").stack_size(64 * 1024 * 1024).spawn_scoped(scope, || -> run_transcript(inputs, None)).expect("spawn transcript compiler stack").join().expect("transcript compiler stack panicked"))
    assert(not output.contains("error ["), "transcript failed:\n{output}")
    output.lines().filter(|line| -> line.contains(" : ")).map(|line| -> line.to_string()).collect()
}

// Rust: tests/comptime_core_pure_parity.rs:780
fn parity_source(expression: String, imports: String) -> String {
    "{imports}\nEXPECTED :: prep {{ {expression} }}\n\nfn run() {{\n    actual :: {expression}\n    print(\"{{EXPECTED}}\")\n    print(\"{{actual}}\")\n}}\n"
}
// Rust: tests/comptime_core_pure_parity.rs:786
fn rustc_aot_stdout(label: String, source: String) -> String {
    assert(common.have_rustc(), "{label} requires rustc")
    compiled :: jet.Driver.compile_generated_src(source, "comptime_core_pure_parity.jet", jet.Sema.CompileMode.Run).unwrap_or_else(|diags| -> panic("{label} front-end failure:\n{jet.render_diagnostics("comptime_core_pure_parity.jet", source, diags)}"))
    id :: SEQ.fetch_add(1, Ordering.Relaxed)
    dir :: common.unique_tmp("jet_core_pure_{id}")
    fs.create_dir_all(dir).unwrap()
    rust :: dir.join("main.rs")
    binary :: dir.join("main")
    fs.write(rust, compiled.rust).unwrap()
    rustc := Command.new("rustc")
    &rustc.args(["--edition", "2021"]).arg(rust).arg("-o").arg(binary)
    if compiled.ffi is Val(link) {
        &rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop directory in link.dependency_dirs().filter(|directory| -> directory.is_dir()) {
            &rustc.arg("-L").arg("dependency={directory.display()}")
        }
    }
    built :: rustc.output().unwrap()
    assert(built.status.success(), "rustc rejected {label}:\n{String.from_utf8_lossy(built.stderr)}")
    run :: Command.new(binary).output().unwrap()
    assert(run.status.success(), "{label} runtime failed")
    String.from_utf8(run.stdout).unwrap()
}
// Rust: tests/comptime_core_pure_parity.rs:835
fn check_aot_comptime(label: String, source: String) -> String {
    output :: rustc_aot_stdout(label, source)
    lines :: output.lines().collect()
    assert_eq(lines.len(), 2, "{label} emitted unexpected output: {lines.debug()}")
    assert_eq(lines[0], lines[1], "{label} comptime/AOT divergence")
    lines[0].to_string()
}
// Rust: tests/comptime_core_pure_parity.rs:847
fn check_dev_tiers(label: String, source: String, expected: String) -> {
    check_dev_tiers_with_boundary(label, source, expected, false)
}
// Rust: tests/comptime_core_pure_parity.rs:851
fn check_dev_tiers_with_boundary(label: String, source: String, expected: String, force_interpreter: Bool) -> {
    check_dev_tier_output(label, source, "{expected}\n{expected}\n", force_interpreter)
}
// Rust: tests/comptime_core_pure_parity.rs:865
fn check_dev_tier_output(label: String, source: String, expected: String, force_interpreter: Bool) -> {
    id :: SEQ.fetch_add(1, Ordering.Relaxed)
    dir :: common.unique_tmp("jet_core_pure_dev_{id}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("{label}.jet")
    fs.write(path, source).unwrap()
    shown :: path.to_string_lossy()
    loop (tier, interpreter_only) in [("interpreter", true), ("default-dev", false)] {
        match dev_iteration(shown, force_interpreter and interpreter_only, interpreter_only) {
            .Ran { stdout, stderr, exit_code } -> {
                assert_eq(exit_code, 0, "{label} {tier} exit")
                assert_eq(stderr, "", "{label} {tier} stderr")
                assert_eq(stdout, expected, "{label} {tier} stdout")
            },
            .Problems(diags) -> panic("{label} {tier} failed: {diags.debug()}")
        }
    }
}

