// Rust: tests/corelib_parts/net.rs:2
#Test("core_net_dns_txt_and_srv_are_real_udp_queries") {
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
    addr := socket.local_addr().unwrap()
    server := thread.spawn(() -> {
        loop _ in 0..2 {
            buf := [U8].repeat(0, 512)
            (n, peer) := socket.recv_from(&buf).unwrap()
            resp := dns_fixture_response(buf[..n])
            socket.send_to(&resp, peer).unwrap()
        }
    })
    dir := env.temp_dir().join("jet_core_net_dns_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> {
    txts :: net.dns_txt_at("$ADDR", "service.example.test", 1000) ?? panic("txt")
    print(txts[0])
    srvs :: net.dns_srv_at("$ADDR", "_jet._tcp.example.test", 1000) ?? panic("srv")
    print("{net.dns_srv_target(srvs[0])}:{net.dns_srv_port(srvs[0])}")
}
""".replace("$ADDR", addr.to_string())
    (code, stdout, stderr) := build_and_run(&dir, "dns_fixture", &src, [], None)
    server.join().unwrap()
    assert(code == 0, stderr)
    assert(stdout == "jet\nsrv.example.test:443\n")
}

// Rust: tests/corelib_parts/net.rs:35
#Test("core_net_dns_udp_truncation_retries_tcp_and_reads_cname_additional") {
    (tcp, udp, addr) := bind_dns_dual_protocol_fixture()
    server := thread.spawn(() -> {
        udp_query := [U8].repeat(0, 512)
        (n, peer) := udp.recv_from(&udp_query).unwrap()
        udp.send_to(&dns_truncated_response(udp_query[..n]), peer).unwrap()
        (stream, _) := tcp.accept().unwrap()
        prefix := [U8].repeat(0, 2)
        stream.read_exact(&prefix).unwrap()
        tcp_query := [U8].repeat(0, USize{U16.from_be_bytes(prefix)})
        stream.read_exact(&tcp_query).unwrap()
        response := dns_cname_additional_response(&tcp_query)
        stream.write_all(&U16{response.len()}.to_be_bytes()).unwrap()
        stream.write_all(&response).unwrap()
    })
    dir := env.temp_dir().join("jet_core_net_dns_tcp_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> {
    ips :: net.dns_a_at("$ADDR", "service.example.test", 1000) ?? panic("dns")
    print(net.ip_to_string(ips[0]))
}
""".replace("$ADDR", addr.to_string())
    (code, stdout, stderr) := build_and_run(&dir, "dns_tcp_cname", &src, [], None)
    server.join().unwrap()
    assert(code == 0, stderr)
    assert(stdout == "192.0.2.42\n")
}

// Rust: tests/corelib_parts/net.rs:77
#Test("core_net_dns_timeout_is_one_budget_across_udp_and_tcp") {
    (tcp, udp, addr) := bind_dns_dual_protocol_fixture()
    server := thread.spawn(() -> {
        query := [U8].repeat(0, 512)
        (n, peer) := udp.recv_from(&query).unwrap()
        started := Instant.now()
        thread.sleep(Duration.from_millis(70))
        udp.send_to(&dns_truncated_response(query[..n]), peer).unwrap()
        (stream, _) := tcp.accept().unwrap()
        stream.set_read_timeout(Val(Duration.from_millis(500))).unwrap()
        prefix := [U8].repeat(0, 2)
        stream.read_exact(&prefix).unwrap()
        request := [U8].repeat(0, USize{U16.from_be_bytes(prefix)})
        stream.read_exact(&request).unwrap()
        closed := [U8].repeat(0, 1)
        _ :: stream.read(&closed)
        started.elapsed()
    })
    dir := env.temp_dir().join("jet_core_net_dns_budget_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> {
    _ :: net.dns_a_at("$ADDR", "service.example.test", 120) ?? panic("dns total timeout")
}
""".replace("$ADDR", addr.to_string())
    (code, _stdout, stderr) := build_and_run(&dir, "dns_total_budget", &src, [], None)
    elapsed := server.join().unwrap()
    assert(code != 0, "stalled DNS TCP fallback unexpectedly succeeded")
    assert(stderr.contains("dns total timeout"), stderr)
    assert(elapsed < Duration.from_millis(190), "UDP and TCP each received a fresh timeout: {elapsed:?}")
}

// Rust: tests/corelib_parts/net.rs:114
#Test("core_net_dns_platform_resolver_policy_uses_native_sources") {
    // Native source oracle replaces inspection of the retired Rust prelude.
    net := fs.read_to_string(common.repo_root().join("Core/net/runtime/top_net_http_02.jet")).unwrap()
    assert(net.contains("selected_os()") && net.contains(".Linux"))
    assert(net.contains("/etc/resolv.conf"))
    assert(net.contains(".MacOS") && net.contains("scutil") && net.contains("--dns"))
    assert(net.contains(".Windows") && net.contains("Get-DNSClientServerAddress"))
    assert(net.contains("$_.ServerAddresses"))
    assert(!net.contains("ipconfig"))
    assert(!net.contains("1.1.1.1"))
}

