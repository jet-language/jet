}

// Rust: tests/corelib_parts/net.rs:164
#Test("core_net_dns_rejects_wrong_transaction_id") {
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
    addr := socket.local_addr().unwrap()
    server := thread.spawn(() -> {
        query := [U8].repeat(0, 512)
        (n, peer) := socket.recv_from(&query).unwrap()
        response := dns_fixture_response(query[..n])
        wrong := U16.from_be_bytes([response[0], response[1]]).wrapping_add(1)
        response[0..2].copy_from_slice(&wrong.to_be_bytes())
        socket.send_to(&response, peer).unwrap()
    })
    dir := env.temp_dir().join("jet_core_net_dns_bad_id_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> { _ :: net.dns_txt_at("$ADDR", "service.example.test", 1000) ?? panic("forged DNS accepted") }
""".replace("$ADDR", addr.to_string())
    (code, _stdout, stderr) := build_and_run(&dir, "dns_bad_id", &src, [], None)
    server.join().unwrap()
    assert(code != 0, "forged transaction ID was accepted")
    assert(stderr.contains("forged DNS accepted"), stderr)
}

// Rust: tests/corelib_parts/net.rs:195
#Test("core_net_dns_transaction_ids_are_not_a_fixed_sequence") {
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
