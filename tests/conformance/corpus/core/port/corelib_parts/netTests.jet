            query := [U8].repeat(0, 512)
            (n, peer) := socket.recv_from(&query).unwrap()
            ids[U16.from_be_bytes([query[0], query[1]])] = true
            socket.send_to(&dns_fixture_response(query[..n]), peer).unwrap()
        }
        ids
    })
    dir := env.temp_dir().join("jet_core_net_dns_ids_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> {
    loop _i in 0..8 { _ :: net.dns_txt_at("$ADDR", "service.example.test", 1000) ?? panic("dns") }
}
""".replace("$ADDR", addr.to_string())
    (code, _stdout, stderr) := build_and_run(&dir, "dns_ids", &src, [], None)
    ids := server.join().unwrap()
    assert(code == 0, stderr)
    assert(ids.len() > 1, "all nine DNS queries reused one transaction ID")
}

// Rust: tests/corelib_parts/net.rs:231
fn run_rejected_dns_response(tag: String, make_response: fn(&[U8]) -> [U8]) -> String {
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
    addr := socket.local_addr().unwrap()
    server := thread.spawn(() -> {
        query := [U8].repeat(0, 512)
        (n, peer) := socket.recv_from(&query).unwrap()
        socket.send_to(&make_response(query[..n]), peer).unwrap()
    })
    dir := env.temp_dir().join("jet_core_net_dns_reject_{tag}_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> { _ :: net.dns_a_at("$ADDR", "service.example.test", 1000) ?? panic("invalid DNS accepted") }
""".replace("$ADDR", addr.to_string())
    (code, _stdout, stderr) := build_and_run(&dir, tag, &src, [], None)
    server.join().unwrap()
    assert(code != 0, "invalid DNS response was accepted: {tag}")
    stderr
}

// Rust: tests/corelib_parts/net.rs:264
#Test("core_net_dns_rejects_non_response_and_cyclic_compression") {
    // Rust: tests/corelib_parts/net.rs:265
    fn non_response(query: &[U8]) -> [U8] {
        response := dns_fixture_response(query)
        response[2] &= 0x7f
        response
    }
    // Rust: tests/corelib_parts/net.rs:270
    fn cyclic_compression(query: &[U8]) -> [U8] {
        end := dns_question_end(query)
        record_start := end
        response := [U8]{}
        response.extend_from_slice(query[0..2])
        response.extend_from_slice(&U16{0x8180}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{0}.to_be_bytes())
        response.extend_from_slice(&U16{0}.to_be_bytes())
        response.extend_from_slice(query[12..end])
        response.push(0xc0 | (U8{record_start >> 8} & 0x3f))
        response.push(U8{record_start})
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U32{0}.to_be_bytes())
        response.extend_from_slice(&U16{4}.to_be_bytes())
        response.extend_from_slice([192, 0, 2, 1])
        response
    }
    qr := run_rejected_dns_response("dns_not_response", non_response)
    assert(qr.contains("invalid DNS accepted"), qr)
    cycle := run_rejected_dns_response("dns_pointer_cycle", cyclic_compression)
    assert(cycle.contains("invalid DNS accepted"), cycle)
}

// Rust: tests/corelib_parts/net.rs:298
#Test("core_net_dns_rejects_reserved_header_forward_pointer_and_impossible_counts") {
    // Rust: tests/corelib_parts/net.rs:299
    fn reserved_header(query: &[U8]) -> [U8] {
        response := dns_cname_additional_response(query)
        response[3] |= 0x40
        response
    }
    // Rust: tests/corelib_parts/net.rs:304
    fn forward_pointer(query: &[U8]) -> [U8] {
        end := dns_question_end(query)
        record_start := end
        pointer_target := record_start + 6
        response := [U8]{}
        response.extend_from_slice(query[0..2])
        response.extend_from_slice(&U16{0x8180}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{0}.to_be_bytes())
        response.extend_from_slice(&U16{0}.to_be_bytes())
        response.extend_from_slice(query[12..end])
        response.push(0xc0 | (U8{pointer_target >> 8} & 0x3f))
        response.push(U8{pointer_target})
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U32{0}.to_be_bytes())
        response.extend_from_slice(&U16{4}.to_be_bytes())
        response.extend_from_slice([192, 0, 2, 1])
        response
    }
    // Rust: tests/corelib_parts/net.rs:325
    fn impossible_counts(query: &[U8]) -> [U8] {
        end := dns_question_end(query)
        response := [U8]{}
        response.extend_from_slice(query[0..2])
        response.extend_from_slice(&U16{0x8180}.to_be_bytes())
        response.extend_from_slice(&U16{1}.to_be_bytes())
        response.extend_from_slice(&U16.MAX.to_be_bytes())
        response.extend_from_slice(&U16.MAX.to_be_bytes())
        response.extend_from_slice(&U16.MAX.to_be_bytes())
        response.extend_from_slice(query[12..end])
        response
    }
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
    addr := socket.local_addr().unwrap()
    server := thread.spawn(() -> {
        responses: [fn(&[U8]) -> [U8]] := [reserved_header, forward_pointer, impossible_counts]
        loop response in responses {
            query := [U8].repeat(0, 512)
            (n, peer) := socket.recv_from(&query).unwrap()
            socket.send_to(&response(query[..n]), peer).unwrap()
        }
    })
    dir := env.temp_dir().join("jet_core_net_dns_hostile_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
fn run() -> {
    if net.dns_a_at("$ADDR", "service.example.test", 1000) == {
        .Ok(_) -> panic("reserved DNS header accepted")
        .Err(_) -> print("rejected")
    }
    if net.dns_a_at("$ADDR", "service.example.test", 1000) == {
        .Ok(_) -> panic("forward DNS pointer accepted")
        .Err(_) -> print("rejected")
    }
    if net.dns_a_at("$ADDR", "service.example.test", 1000) == {
        .Ok(_) -> panic("impossible DNS counts accepted")
        .Err(_) -> print("rejected")
    }
}
""".replace("$ADDR", addr.to_string())
    (code, stdout, stderr) := build_and_run(&dir, "dns_hostile_bounds", &src, [], None)
    server.join().unwrap()
    assert(code == 0, stderr)
    assert(stdout == "rejected\nrejected\nrejected\n")
}

// Rust: tests/corelib_parts/net.rs:382
#Test("core_net_dns_wire_lookup_observes_task_cancellation") {
    socket := UdpSocket.bind("127.0.0.1:0").unwrap()
    addr := socket.local_addr().unwrap()
    dir := env.temp_dir().join("jet_core_net_dns_cancel_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src := """
use core.net as net
use core.tasks as tasks
use core.time as time
fn run() -> {
    (ready_tx, ready_rx) :: channel<Int>()
    lookup :: task {
        ready_tx.send(1)
        if net.dns_a_at("$ADDR", "service.example.test", 5000) == {
            .Ok(_) -> print("unexpected DNS response")
            .Err(error) -> print(net.error_message(error))
        }
    }
    _ready :: ready_rx.receive() ?? panic("ready")
    time.sleep(50ms)
    lookup.cancel()
    lookup.join() ?? panic("lookup task failed")
}
""".replace("$ADDR", addr.to_string())
    (code, stdout, stderr) := build_and_run(&dir, "dns_task_cancel", &src, [], None)
    drop(socket)
    assert(code == 0, stderr)
    assert(stdout == "network operation cancelled during DNS lookup for `service.example.test`\n")
}

