    assert(dns_resolver_policy.jet_net_dns_parse_windows_addresses("{192.0.2.55, 2001:db8::55}\r\n\r\n") == ["192.0.2.55:53", "[2001:db8::55]:53"])
}

// Rust: tests/corelib_parts/net.rs:148
#Test("core_net_dns_platform_resolver_parsers_reject_noise_and_malformed_entries") {
    assert(dns_resolver_policy.jet_net_dns_parse_resolv_conf("nameserver nope\nnot-nameserver 192.0.2.1\nnameserver [broken\n").is_empty())
