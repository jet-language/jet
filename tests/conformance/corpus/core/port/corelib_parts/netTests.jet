// Rust: tests/corelib_parts/net.rs:985
#Test("core_ioerror_preserves_kind_operation_and_resource") {
    scratch := common.Scratch.new("jet_core_ioerror_tree")
    dir := scratch.path.clone()
    tir_support.write_test_package(&dir, tir_support.TIR_TEST_PACKAGE)
    source := """
use core.files as fs
use core.net as net
use core.process as process
fn receive<T: Reader>(&stream: T, limit: Int) -[IO]> [U8] IOError! { return stream.read(limit) }
fn operation_name(operation: IOOperation) -[]> String {
    if operation == {
        .Read -> return "read"
        .Write -> return "write"
        .Flush -> return "flush"
        .Connect -> return "connect"
        .Accept -> return "accept"
        .Close -> return "close"
        .Resolve -> return "resolve"
        .Codec -> return "codec"
    }
}
fn run() -[Exec, FS, IO, Net, Time.Wait]> {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    address :: net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("address"))
    client := net.tcp_connect(address) ?? panic("connect")
    if receive(&client, 0) == {
        .Ok(_) -> panic("zero read succeeded")
        .Err(error) -> {
            if error == {
                .InvalidInput(context) -> print(if operation_name(context.operation) == "read" -> "invalid-read" else -> "invalid-other")
                else -> { print("other") }
            }
        }
    }
    if fs.read("definitely-missing/ioerror-tree") == {
        .Ok(_) -> panic("missing file read succeeded")
        .Err(error) -> {
            if error == {
                .NotFound(context) -> print(context.resource ?? "missing-resource")
                else -> { print("other") }
            }
        }
    }
    if fs.write(".", "cannot replace directory") == {
        .Ok(_) -> panic("directory write succeeded")
        .Err(error) -> {
            if error == {
                .Other(context) -> print(if operation_name(context.operation) == "write" -> "write" else -> "wrong-write-operation")
                else -> { print("wrong-write-kind") }
            }
        }
    }
    if process.run_spec(process.cmd([])) == {
        .Ok(_) -> panic("empty command succeeded")
        .Err(error) -> {
            if error == {
                .InvalidInput(context) -> print(if operation_name(context.operation) == "resolve" -> "empty-command" else -> "wrong-command-operation")
                else -> { print("wrong-command-kind") }
            }
        }
    }
    if process.pipeline([]) == {
        .Ok(_) -> panic("empty pipeline succeeded")
        .Err(error) -> {
            if error == {
                .InvalidInput(context) -> print(if operation_name(context.operation) == "resolve" -> "empty-pipeline" else -> "wrong-pipeline-operation")
                else -> { print("wrong-pipeline-kind") }
            }
        }
    }
    if process.run_spec(process.cmd(["unused"]).env("BAD=NAME", "value")) == {
        .Ok(_) -> panic("invalid environment succeeded")
        .Err(error) -> {
            if error == {
                .InvalidInput(context) -> print(if operation_name(context.operation) == "resolve" -> context.resource ?? "missing-env-resource" else -> "wrong-env-operation")
                else -> { print("wrong-env-kind") }
            }
        }
    }
}
"""
    (code, stdout, stderr) := build_and_run(&dir, "ioerror_tree", source, [], None)
    assert(code == 0, stderr)
    expected := "invalid-read\ndefinitely-missing/ioerror-tree\nwrite\nempty-command\nempty-pipeline\nBAD=NAME\n"
    assert(stdout == expected)
    file := dir.join("ioerror_tree.jet")
    fs.write(&file, source).unwrap()
    if Interpreter.dev_iteration(file.to_str().unwrap(), false, false) == {
        .Ran { stdout, stderr, exit_code } -> assert((exit_code, stdout, stderr) == (0, expected, ""))
        other -> panic("IOError tree did not run in default dev: {other:?}")
    }
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/corelib_parts/net.rs:1093
#Test("core_ioerror_debug_renders_in_aot_and_dev") {
    scratch := common.Scratch.new("jet_core_ioerror_debug")
    dir := scratch.path.clone()
    tir_support.write_test_package(&dir, tir_support.TIR_TEST_PACKAGE)
    source := """
fn activate_core() -[IO]> String { return input() ?? "" }
fn fail() -[]> Int IOError! {
    return Err(IOError.InvalidInput(IOContext{
        operation: .Read, resource: None, os_code: None, cause: Val("debug"),
    }))
}
fn fail_other() -[]> Int IOError! {
    return Err(IOError.Other(IOContext{
        cause: Val("denied"), os_code: Val(13), resource: Val("out.txt"), operation: .Write,
    }))
}
fn run() -> {
    print("{42:Debug}")
    debug :: "debug"
    print("{debug:Debug}")
    print("{[1, 2, 3]:Debug}")
    if fail() == {
        .Ok(_) -> panic("failure succeeded")
        .Err(error) -> { print("{error:Debug}"); print("{error}") }
    }
    if fail_other() == {
        .Ok(_) -> panic("other failure succeeded")
        .Err(error) -> { print("{error:Debug}"); print("{error}") }
    }
}
"""
    expected := "42\n\"debug\"\n[1, 2, 3]\n"
        + "InvalidInput(IOContext { operation: Read, resource: None, os_code: None, cause: Val(\"debug\") })\n"
        + "invalid input during read: debug\n"
        + "Other(IOContext { operation: Write, resource: Val(\"out.txt\"), os_code: Val(13), cause: Val(\"denied\") })\n"
        + "I/O error during write `out.txt`: denied\n"
    (code, aot_stdout, stderr) := build_and_run(&dir, "ioerror_debug", source, [], None)
    assert(code == 0, stderr)
    assert(aot_stdout == expected)
    assert(!aot_stdout.contains("<enum IOOperation>"))
    file := dir.join("ioerror_debug.jet")
    fs.write(&file, source).unwrap()
    default_dev_stdout := if Interpreter.dev_iteration(file.to_str().unwrap(), false, false) == {
        .Ran { stdout, stderr, exit_code } -> {
            assert((exit_code, stdout, stderr) == (0, expected, ""))
            stdout
        }
        other -> panic("IOError Show/Debug did not run in default dev: {other:?}")
    }
    // Retired resident-JIT/deopt/fallback flags become cross-tier behavior.
    tir_support.assert_tiers_agree(&source, expected)
    forced_interpreter_stdout := if Interpreter.dev_iteration(file.to_str().unwrap(), false, true) == {
        .Ran { stdout, stderr, exit_code } -> {
            assert((exit_code, stdout, stderr) == (0, expected, ""))
            stdout
        }
        other -> panic("IOError Show/Debug did not run in forced interpreter: {other:?}")
    }
    assert(default_dev_stdout == aot_stdout)
    assert(forced_interpreter_stdout == aot_stdout)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/corelib_parts/net.rs:1197
#Test("card_2417_ioerror_fixture_matches_aot_default_jit_and_interpreter") {
    root := common.repo_root()
    fixture := root.join("tests/ui/ioerror_display_migration.jet")
    source := fs.read_to_string(&fixture).expect("Card #2417 IOError fixture")
    assert(source.contains("IOError.Other(IOContext"), "Card #2417 fixture must exercise ordinary IOError, not BuildError")
    assert(source.contains("print(\"{error}\")"), "Card #2417 fixture must exercise bare Display interpolation")
    shown := fixture.to_string_lossy()
    checked := jet.compile_with_path(&source, &shown) ?? {
        panic("Card #2417 IOError fixture was rejected:\n{jet.render_diagnostics(&shown, &source, &err)}")
    }
    assert(checked.lints.iter().filter((diagnostic) -> diagnostic.code == "L0520").count() == 1,
        "Card #2417 fixture must retain exactly one L0520 witness")
    snapshot := fs.read_to_string(root.join("tests/ui/ioerror_display_migration.stderr")).expect("Card #2417 IOError snapshot")
    loop expected in [
        "Warning [L0520] (display_migration): `IOError` has no `Display` impl",
        "Why: Display is the user-facing interpolation hook; Debug is for `{value:Debug}`",
        "Fix: add `impl IOError.Display { fn display(self) -> String { … } }`",
    ] {
        assert(snapshot.contains(expected), "Card #2417 snapshot lost {expected:?}")
    }
    build_snapshot := fs.read_to_string(root.join("tests/ui_lint/build_entry_liveness.warn")).expect("BuildError exclusion snapshot")
    assert(build_snapshot.contains("MissingDisplay"), "BuildError exclusion snapshot lost its ordinary neighboring L0520 witness")
    assert(!build_snapshot.contains("BuildError"), "BuildError must remain excluded from the display migration snapshot")
    dir := env.temp_dir().join("jet_card_2417_ioerror_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    expected := "I/O error during read: missing input\n"
    (code, aot_stdout, stderr) := build_and_run(&dir, "ioerror_display_migration", &source, [], None)
    assert(code == 0, stderr)
    assert(aot_stdout == expected)
    file := dir.join("ioerror_display_migration.jet")
    fs.write(&file, &source).unwrap()
    default_dev_stdout := if Interpreter.dev_iteration(file.to_str().unwrap(), false, false) == {
        .Ran { stdout, stderr, exit_code } -> { assert((exit_code, stderr) == (0, "")); stdout }
        other -> panic("Card #2417 IOError fixture failed in default dev: {other:?}")
    }
    forced_interpreter_stdout := if Interpreter.dev_iteration(file.to_str().unwrap(), false, true) == {
        .Ran { stdout, stderr, exit_code } -> { assert((exit_code, stderr) == (0, "")); stdout }
        other -> panic("Card #2417 IOError fixture failed in forced interpreter: {other:?}")
    }
    assert(default_dev_stdout == aot_stdout)
    assert(forced_interpreter_stdout == aot_stdout)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/corelib_parts/net.rs:1295
#Test("core_ioerror_native_flush_preserves_operation") {
    if target.selected_os() == .Linux {
        dir := env.temp_dir().join("jet_core_ioerror_flush_{process.id()}")
        _ :: fs.remove_dir_all(&dir)
        fs.create_dir_all(&dir).unwrap()
        (code, stdout, stderr) := build_and_run(&dir, "ioerror_flush", """
use core.files as files
fn run() -> {
    output := files.create("/dev/full") ?? panic("open")
    output.write_line("buffered") ?? panic("buffer")
    if &output.flush() == {
        .Ok(_) -> panic("flush succeeded")
        .Err(error) -> {
            if error == {
                .Other(context) -> print(if context.operation == .Flush -> "flush" else -> "wrong-flush-operation")
                else -> { print("wrong-flush-kind") }
            }
        }
    }
}
""", [], None)
        assert(code == 0, stderr)
        assert(stdout == "flush\n")
        _ :: fs.remove_dir_all(&dir)
    }
}

// Rust: tests/corelib_parts/net.rs:1331
#Test("core_net_tcp_read_persistent_timeout_uses_scheduler_budget") {
    dir := env.temp_dir().join("jet_core_net_task_timeout_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) := build_and_run(&dir, "net_task_timeout", """
use core.net as net
use core.tasks as tasks
use core.time as time
fn run() -> {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    typed_address :: net.listener_local_socket_addr(listener) ?? panic("address")
    address :: net.socket_to_string(typed_address)
    client :: task {
        stream := net.tcp_connect(address) ?? panic("connect")
        time.sleep(100ms)
        stream.close() ?? panic("close")
    }
    stream := net.tcp_accept(listener) ?? panic("accept")
    net.set_read_timeout(&stream, 20) ?? panic("timeout")
    if stream.read(1) == { .Ok(_) -> print("unexpected read"); .Err(error) -> print(net.error_message(error)) }
    client.join() ?? panic("client task failed")
}
""", [], None)
    assert(code == 0, stderr)
    assert(stdout.contains("deadline exceeded while waiting in tcp read"), stdout)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/corelib_parts/net.rs:1373
#Test("core_net_tcp_expired_deadlines_return_typed_timeouts") {
    dir := env.temp_dir().join("jet_core_net_expired_deadlines_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) := build_and_run(&dir, "net_expired_deadlines", """
use core.net as net
use core.tasks as tasks
use core.time as time
fn run() -> {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    typed_address :: net.listener_local_socket_addr(listener) ?? panic("address")
    address :: net.socket_to_string(typed_address)
    server :: task {
        first := net.tcp_accept(listener) ?? return
        time.sleep(100ms)
        first.close() ?? return
        second := net.tcp_accept(listener) ?? return
        time.sleep(100ms)
        second.close() ?? return
    }
    first := net.tcp_connect(address) ?? panic("first connect")
    net.set_read_timeout(&first, 0) ?? panic("zero timeout")
    if first.read(1) == { .Ok(_) -> print("unexpected first read"); .Err(error) -> print(net.error_message(error)) }
    first.close() ?? panic("first close")
    second := net.tcp_connect(address) ?? panic("second connect")
    #Context(deadline: time.now() - 1) {
        if second.read(1) == { .Ok(_) -> print("unexpected second read"); .Err(error) -> print(net.error_message(error)) }
    }
    second.close() ?? panic("second close")
    server.join() ?? panic("server task failed")
}
""", [], None)
    assert(code == 0, stderr)
    assert(stdout == "deadline exceeded while waiting in tcp read\ndeadline exceeded while waiting in tcp read\n")
    assert(!stderr.contains("E3003"), "typed timeout escaped as runtime deadline: {stderr}")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/corelib_parts/net.rs:1433
#Test("core_net_tcp_write_all_uses_one_absolute_deadline") {
    dir := env.temp_dir().join("jet_core_net_write_deadline_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) := build_and_run(&dir, "net_write_deadline", """
use core.net as net
use core.tasks as tasks
use core.time as time
fn run() -> {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    typed_address :: net.listener_local_socket_addr(listener) ?? panic("address")
    address :: net.socket_to_string(typed_address)
    server :: task {
        stream := net.tcp_accept(listener) ?? return
        loop {
            chunk := stream.read(65536) ?? return
            if chunk.len() == 0 { return }
            time.sleep(15ms)
        }
    }
    client := net.tcp_connect(address) ?? panic("connect")
    net.set_write_timeout(&client, 80) ?? panic("timeout")
    started := time.now()
    if client.write_text("x".repeat(16000000)) == {
        .Ok(_) -> print("unexpected write")
        .Err(error) -> print(net.error_message(error))
    }
    elapsed := time.now() - started
    print(elapsed < 300)
    client.close() ?? panic("close")
    server.join() ?? panic("server task failed")
}
""", [], None)
    assert(code == 0, stderr)
    assert(stdout == "deadline exceeded while waiting in tcp write\ntrue\n")
    _ :: fs.remove_dir_all(&dir)
}

