    assert_eq(stderr, "")
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/corelib_parts/encoding_streams.rs:1589
#Test("csv_stream_records_are_incremental_rfc4180_bounded_and_terminal") {
    dir :: env.temp_dir().join("jet_csv_stream_{id()}")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"csv_stream\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [FS, IO, Mem.Alloc] } }\n").unwrap()
    input_path :: dir.join("input.csv")
    output_path :: dir.join("output.csv")
    malformed_path :: dir.join("malformed.csv")
    invalid_utf8_path :: dir.join("invalid-utf8.csv")
    item_limit_path :: dir.join("item-limit.csv")
    total_limit_path :: dir.join("total-limit.csv")
    options_path :: dir.join("options.tsv")
    fs.write(input_path, "a,\"b,b\",\"c\"\"c\",\"line1\nline2\"\x0D\nlast,,tail").unwrap()
    fs.write(malformed_path, "\"bad").unwrap()
    fs.write(invalid_utf8_path, [U8]{97, 44, 0xff}).unwrap()
    fs.write(item_limit_path, "\"abcd\"\x0D\n").unwrap()
    fs.write(total_limit_path, "a,b\x0D\n").unwrap()
    fs.write(options_path, "name\tnote\x0D\n\x0D\nAda\t\"line1\x0D\nline2\"\x0D\n").unwrap()
    input :: input_path.to_string_lossy().replace("\\", "\\\\")
    output :: output_path.to_string_lossy().replace("\\", "\\\\")
    malformed :: malformed_path.to_string_lossy().replace("\\", "\\\\")
    invalid_utf8 :: invalid_utf8_path.to_string_lossy().replace("\\", "\\\\")
    item_limit :: item_limit_path.to_string_lossy().replace("\\", "\\\\")
    total_limit :: total_limit_path.to_string_lossy().replace("\\", "\\\\")
    options :: options_path.to_string_lossy().replace("\\", "\\\\")
    source :: `
use core.encoding as encoding
use core.encoding.csv as csv
use core.files as files
fn run() -> {
    output :: files.create("@OUTPUT@") ?? panic("create")
    writer :: csv.writer(^output) ?? panic("writer")
    writer.write(["a", "b,b", "c\"c", "line1\nline2"]) ?? panic("write first")
    writer.write(["last", "", "tail"]) ?? panic("write second")
    &writer.flush() ?? panic("flush")
    writer.finish() ?? panic("finish")
    writer.finish() ?? panic("finish twice")
    if writer.write(["late"]) == {
        .Ok(_) -> { print("write-after-finish-missed") }
        .Err(writer_first) -> {
            if &writer.flush() == {
                .Ok(_) -> { print("writer-terminal-missed") }
                .Err(writer_second) -> { print(writer_first.byte_offset == writer_second.byte_offset && writer_first.reason == writer_second.reason) }
            }
        }
    }
    input :: files.open("@INPUT@") ?? panic("open")
    reader :: csv.reader(^input) ?? panic("reader")
    first :: reader.next()
    if first == {
        .Val(row) -> {
            print(row.fields[0])
            print(row.line)
            print(row.fields[1])
            print(row.fields[2])
            print(row.fields[3])
        }
        .None -> { print("first-missing") }
    }
    second :: reader.next()
    if second == {
        .Val(row) -> {
            print(row.fields[0])
            print(row.line)
            print(row.fields[1] == "")
            print(row.fields[2])
        }
        .None -> { print("second-missing") }
    }
    eof :: reader.next()
    if eof == { .Val(_) -> { print(false) } .None -> { print(true) } }
    eof_again :: reader.next()
    if eof_again == { .Val(_) -> { print(false) } .None -> { print(true) } }
    options_input :: files.open("@OPTIONS@") ?? panic("options open")
    options_reader :: csv.reader(^options_input, delimiter: "\t", header: true, skip_blank: true) ?? panic("options reader")
    options_first :: options_reader.next()
    crlf :: String.from_bytes([U8]{"\x0D\x0A"}) ?? panic("crlf")
    if options_first == {
        .Val(row) -> {
            print(row.line)
            print(row.fields[0])
            print(&row.fields[1].replace(crlf, "|"))
        }
        .None -> { print("options-missing") }
    }
    options_eof :: options_reader.next()
    if options_eof == { .Val(_) -> { print(false) } .None -> { print(true) } }
    malformed_input :: files.open("@MALFORMED@") ?? panic("malformed open")
    malformed_reader :: csv.reader(^malformed_input) ?? panic("malformed reader")
    if malformed_reader.next() == {
        .Ok(_) -> { print("malformed-missed") }
        .Err(malformed_first) -> {
            if malformed_reader.next() == {
                .Ok(_) -> { print("malformed-terminal-missed") }
                .Err(malformed_second) -> {
                    print(malformed_first.path)
                    print(malformed_first.byte_offset == malformed_second.byte_offset && malformed_first.reason == malformed_second.reason)
                }
            }
        }
    }
    invalid_utf8_input :: files.open("@INVALID@") ?? panic("invalid utf8 open")
    invalid_utf8_reader :: csv.reader(^invalid_utf8_input) ?? panic("invalid utf8 reader")
    if invalid_utf8_reader.next() == {
        .Ok(_) -> { print("invalid-utf8-missed") }
        .Err(error) -> {
            print(error.byte_offset)
            print(error.line ?? 0)
            print(error.column ?? 0)
            print(error.path)
        }
    }
    item_limits := encoding.EncodingLimits.safe()
    item_limits.max_item_bytes = 3
    item_input :: files.open("@ITEM@") ?? panic("item open")
    item_reader :: csv.reader(^item_input, item_limits) ?? panic("item reader")
    if item_reader.next() == {
        .Ok(_) -> { print("item-limit-missed") }
        .Err(item_first) -> {
            if item_reader.next() == {
                .Ok(_) -> { print("item-terminal-missed") }
                .Err(item_second) -> {
                    print(item_first.path)
                    print(item_first.byte_offset == item_second.byte_offset && item_first.reason == item_second.reason)
                }
            }
        }
    }
    total_limits := encoding.EncodingLimits.safe()
    total_limits.max_total_bytes = Val(3)
    total_input :: files.open("@TOTAL@") ?? panic("total open")
    total_reader :: csv.reader(^total_input, total_limits) ?? panic("total reader")
    if total_reader.next() == {
        .Ok(_) -> { print("total-limit-missed") }
        .Err(total_first) -> {
            if total_reader.next() == {
                .Ok(_) -> { print("total-terminal-missed") }
                .Err(total_second) -> {
                    print(total_first.byte_offset)
                    print(total_first.path)
                    print(total_first.reason == total_second.reason)
                }
            }
        }
    }
    writer_limits := encoding.EncodingLimits.safe()
    writer_limits.max_item_bytes = 3
    limited_output :: files.create("@OUTPUT@.limited") ?? panic("limited create")
    limited_writer :: csv.writer(^limited_output, writer_limits) ?? panic("limited writer")
    if limited_writer.write(["abcd"]) == {
        .Ok(_) -> { print("writer-limit-missed") }
        .Err(limited_first) -> {
            _ :: limited_writer.finish() ?? {
                print(limited_first.path)
                print(limited_first.reason == err.reason)
                return
            }
            print("writer-limit-terminal-missed")
            return
        }
    }
}
`.replace("@INPUT@", input).replace("@OUTPUT@", output).replace("@MALFORMED@", malformed).replace("@INVALID@", invalid_utf8).replace("@ITEM@", item_limit).replace("@TOTAL@", total_limit).replace("@OPTIONS@", options)
    (code, stdout, stderr) :: build_and_run(dir, "csv_stream", source, [], None)
    assert_eq(code, 0, "stderr: {stderr}")
    assert_eq(stdout, "true\na\n1\nb,b\nc\"c\nline1\nline2\nlast\n3\ntrue\ntail\ntrue\ntrue\n3\nAda\nline1|line2\ntrue\n$[0][0]\ntrue\n2\n1\n4\n$[0][1]\n$[0][0]\ntrue\n3\n$[0][1]\ntrue\n$[0][0]\ntrue\n")
    assert_eq(fs.read_to_string(output_path).unwrap(), "a,\"b,b\",\"c\"\"c\",\"line1\nline2\"\x0D\nlast,,tail\x0D\n")
    assert_eq(stderr, "")
    dev_path :: dir.join("csv_stream.jet")
    fs.write(dev_path, source).unwrap()
    if jet.Interpreter.dev_iteration(dev_path.to_str().unwrap(), false, false) == {
        .Ran{stdout: dev_stdout, stderr: dev_stderr, exit_code} -> { assert_eq((exit_code, dev_stdout, dev_stderr), (0, stdout, "")) }
        other -> { panic("CSV stream default-dev failed: {other.debug()}") }
    }
    assert_eq(fs.read_to_string(output_path).unwrap(), "a,\"b,b\",\"c\"\"c\",\"line1\nline2\"\x0D\nlast,,tail\x0D\n")
    _ :: fs.remove_dir_all(dir)
}
