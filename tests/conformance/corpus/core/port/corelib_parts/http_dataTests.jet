// Rust: tests/corelib_parts/http_data.rs:1413
#Test("io_prompt_helpers_validate_choices_and_refuse_non_tty_secrets") {
    if !common.have_rustc() { return }
    dir :: env.temp_dir().join("jet_corelib_prompts_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    source :: include_str("Examples/features/io/terminal_parity.jet")
    answers :: common.example_stdin("io/terminal_parity").expect("io/terminal_parity has stdin answers")
    (code, stdout, stderr) :: build_and_run(dir, "terminal_parity", source, [], Val(answers.piped))
    assert_eq(code, 0, "prompt fixture failed: {stderr}")
    assert_eq(stdout, include_str("Examples/features/expected/io/terminal_parity.out"))
    assert_eq(stderr, include_str("Examples/features/expected/io/terminal_parity.stderr.out"))
    if sys.target.selected_family() == "unix" {
        bin :: dir.join("terminal_parity")
        quoted :: "'" + bin.display().to_string().replace("'", "'\\''") + "'"
        shell_line :: "exec {quoted}"
        child := Command.new("script").args(["-qfec", shell_line, "/dev/null"]).env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("util-linux script must allocate a real PTY")
        child.stdin.take().expect("PTY stdin").write_all(answers.tty().as_bytes()).expect("write terminal answers")
        output :: child.wait_with_output().expect("collect PTY transcript")
        shown :: String.from_utf8_lossy(output.stdout)
        assert(output.status.success(), "PTY prompt failed:\n{shown}")
        assert(shown.contains("secret length: 6"), shown)
        without_report :: shown.replace("secret length: 6", "")
        assert(!without_report.contains("secret"), "secret was echoed:\n{shown}")
    }
    _ :: fs.remove_dir_all(dir)
}
