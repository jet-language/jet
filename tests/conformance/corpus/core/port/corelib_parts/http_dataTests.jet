// Rust: tests/corelib_parts/http_data.rs:1309
#Test("core_data_schema_empty_table_and_series_law") {
    if !common.have_rustc() { return }
    dir :: env.temp_dir().join("jet_corelib_data_schema_empty_{process.id()}")
