//RS 
//RS     limits := encoding.EncodingLimits.safe()
//RS     limits.buffer_bytes = 4096
//RS     limits.max_depth = 1
//RS     limits.max_item_bytes = 100000
//RS     limits.max_expansion_bytes = 0
