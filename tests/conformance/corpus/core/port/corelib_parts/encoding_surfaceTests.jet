use core.encoding.xml as xml
fn show(result: DataTree XMLError!) -> String {
    if result == {
        .Ok(_) -> { return "accepted" }
        .Err(error) -> {
            return "{error.byte_offset}|{error.line}|{error.column}|{error.path}|{error.reason}"
        }
    }
    return "unreachable"
}
