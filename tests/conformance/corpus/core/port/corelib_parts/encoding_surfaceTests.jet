ATTRIBUTE :: prep { show(xml.parse("<r a='&#0;'/>")) }
NAMESPACE :: prep { show(xml.parse("<r xmlns='&#0;'/>")) }
fn run() -> {
    runtime_numeric :: show(xml.parse("<r>&#0;</r>"))
    runtime_attribute :: show(xml.parse("<r a='&#0;'/>"))
