use std.fs as fs
use std.process.[Command, Output]
use std.thread
use tests.common as common
use tests.tir_support as tir_support
use jet.[CompileOutput, compile_with_path, render_diagnostics]
// GATE #4494: real filesystem, process and scoped-thread primitives.

// Rust: tests/http.rs:9
struct HttpOutput { stdout: String, stderr: String, exit_code: I32 }
// Rust: tests/http.rs:15
fn on_large_stack(work: fn() ->) -> {
    thread.scope(scope -> {
        thread.Builder.new().stack_size(64 * 1024 * 1024).spawn_scoped(scope, ^work).unwrap().join().unwrap()
    })
}
// Rust: tests/http.rs:26
fn run_dev(path: OSPath, use_interpreter: Bool) -> HttpOutput {
    source :: fs.read_to_string(path).unwrap()
    (code, stdout, stderr) :: if use_interpreter -> tir_support.interpreter_run(path.to_string_lossy(), source) else -> tir_support.jit_run(path.to_string_lossy(), source)
    HttpOutput{stdout: ^stdout, stderr: ^stderr, exit_code: code}
}
// Rust: tests/http.rs:44
fn example_path(name: String) -> OSPath { workspace_root().join("Examples/features/net/{name}.jet") }
// Rust: tests/http.rs:94
fn assert_http_example_matches_all_tiers(name: String) -> {
    path :: example_path(name)
    source :: fs.read_to_string(path).unwrap()
    expected :: fs.read_to_string(workspace_root().join("Examples/features/expected/net/{name}.out")).unwrap()
    interpreted :: run_dev(path, true)
    assert_eq(interpreted.stdout, expected, "{name} interpreter stdout")
    assert_eq(interpreted.stderr, "", "{name} interpreter stderr")
    assert_eq(interpreted.exit_code, 0, "{name} interpreter exit code")
    default :: run_dev(path, false)
    assert_eq(default.stdout, expected, "{name} default stdout")
    assert_eq(default.stderr, "", "{name} default stderr")
    assert_eq(default.exit_code, 0, "{name} default exit code")
    (code, aot_stdout, aot_stderr) :: common.build_and_run("jet_{name}", name, source)
    assert_eq(code, 0, "{name} AOT exit code: {aot_stderr}")
    assert_eq(aot_stdout, expected, "{name} AOT stdout")
    assert_eq(aot_stderr, "", "{name} AOT stderr")
    (release_code, release_stdout, release_stderr) :: tir_support.build_release_and_run_multi("http_{name}_release", "main.jet", [("main.jet", source)])
    assert_eq(release_code, 0, "{name} release exit code: {release_stderr}")
    assert_eq(release_stdout, expected, "{name} release stdout")
    assert_eq(release_stderr, "", "{name} release stderr")
}

// Rust: tests/http_dependency_audit.rs:9
fn workspace_root() -> OSPath { OSPath.from(env!("CARGO_MANIFEST_DIR")) }
// Rust: tests/http_dependency_audit.rs:13
fn read(path: String) -> String {
    fs.read_to_string(workspace_root().join(path)).unwrap_or_else(error -> panic("failed to read {path}: {error}"))
}

// Rust: tests/resource_close.rs:8
SIMPLE :: `
struct Resource { name: String }

impl Resource.Close {
    fn close(^self) -> {
        print("close {self.name}")
    }
}

fn run() -> {
    resource := Resource{ name: "dev" }
    defer close(^resource)
    print("body")
}
`
// Rust: tests/resource_close.rs:24
fn compile(src: String) -> CompileOutput {
    root :: common.unique_tmp("jet_resource_close_compile")
    fs.create_dir_all(root).unwrap()
    path :: root.join("main.jet")
    fs.write(path, src).unwrap()
    compile_with_path(src, path.to_str().unwrap()).unwrap_or_else(diags -> panic("{render_diagnostics(path.to_str().unwrap(), src, diags)}"))
}
// Rust: tests/resource_close.rs:37
fn codes(src: String) -> [String] {
    match jet.compile(src) {
        Ok(_) -> [],
        Err(diags) -> diags.into_iter().map(d -> d.code.to_string()).collect()
    }
}
// Rust: tests/resource_close.rs:44
fn compile_and_run(src: String, tag: String) -> Output {
    assert(common.have_rustc(), "resource-close runtime proof needs rustc")
    compiled :: compile(src)
    run_compiled(^compiled.rust, tag)
}
// Rust: tests/resource_close.rs:53
fn compile_and_run_with_scheduler_unwind(src: String, tag: String) -> Output {
    assert(common.have_rustc(), "resource-close runtime proof needs rustc")
    compiled :: compile(src)
    entry_init :: "fn main() {\n    jet_std_env_init();"
    rust :: compiled.rust.replacen(entry_init, "fn main() {\n    jet_std_env_init();\n    jet_scheduler_task_panic_enter();", 1)
    assert_ne(rust, compiled.rust, "scheduler unwind probe did not attach to entry init")
    run_compiled(^rust, tag)
}
// Rust: tests/resource_close.rs:72
fn run_compiled(rust: ^String, tag: String) -> Output {
    root :: common.unique_tmp(tag)
    fs.create_dir_all(root).unwrap()
    rs :: root.join("main.rs")
    bin :: root.join("main")
    fs.write(rs, ^rust).unwrap()
    built :: Command.new("rustc").args(["--edition", "2021"]).arg(rs).arg("-o").arg(bin).output().unwrap()
    assert(built.status.success(), "rustc rejected deferred-close output:\n{String.from_utf8_lossy(built.stderr)}")
    Command.new(bin).output().unwrap()
}
