//RS //! Source-owned memory/ownership contract coverage across execution tiers.
//RS //!
//RS //! The allocator and scope surfaces are compiler-owned typed boundaries; this
//RS //! test keeps their observable lifetime and cleanup behavior in one hostile
//RS //! scenario rather than duplicating backend-specific expectations.
//RS 
//RS mod common;
//RS mod tir_support;
//RS 
//RS #[test]
//RS fn allocator_reset_close_and_scope_cleanup_keep_one_lifetime_contract() {
//RS     tir_support::assert_tiers_agree(
//RS         "core_memory_foundations",
//RS         r#"
//RS use core.mem
//RS use core.mem.scope as scope
//RS 
//RS fn run() {
//RS     arena :: mem.Arena.new(capacity: 32)
//RS     first :: arena.alloc(7)
//RS     print(first)
//RS 
//RS     // Reset is reusable, but the first view is no longer live past this edge.
//RS     &arena.reset()
//RS     second :: arena.alloc(11)
//RS     print(second)
//RS 
//RS     // Fallible allocation keeps the typed provider report identical on every tier.
//RS     fixed :: mem.Fixed.new(size: 40)
//RS     fixed.try_alloc(7) ? value -> {
//RS         print("success {value}")
//RS     }
//RS     ! error -> {
//RS         print("unexpected failure {error.requested_bytes} {error.allocator}")
//RS     }
//RS     fixed.try_alloc(9) ? value -> {
//RS         print("unexpected success {value}")
//RS     }
//RS     ! error -> {
//RS         print("failure {error.requested_bytes} {error.allocator}")
//RS     }
//RS     close(^fixed)
//RS 
//RS     // Scope guards run in reverse declaration order, before the function exits.
//RS     _outer :: scope.guard(() -> print("outer cleanup"))
//RS     _inner :: scope.guard(() -> print("inner cleanup"))
//RS     print("live")
//RS 
//RS     // close is terminal ownership transfer; no view remains live here.
//RS     close(^arena)
//RS }
//RS "#,
//RS         "7\n11\nsuccess 7\nfailure 8 Fixed\nlive\ninner cleanup\nouter cleanup\n",
//RS     );
//RS }
// END-PORT-PENDING 1012 tests/core_memory_foundations.rs:1-55

