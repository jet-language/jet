// Rust: tests/record_conformance.rs:53
fn hex(bytes: [UInt8]) -> String {
    out := ""
    loop byte in bytes { out.push_str(byte.format("02x")) }
    out
}

// Rust: tests/record_conformance.rs:60
fn jet_string(value: String) -> String {
    out := "\""
    loop ch in value.chars() {
        if ch == {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\n' -> out.push_str("\\n")
            '{' -> out.push_str("{{")
            '}' -> out.push_str("}}")
            _ -> out.push(ch)
        }
    }
    out.push('"')
    out
}

// Rust: tests/record_conformance.rs:76
fn jet_bytes(bytes: [UInt8]) -> String {
    items :: bytes.iter().map(|byte| -> byte.to_string()).collect()
    "[U8]{{{items.join(", ")}}}"
}
// Rust: tests/record_conformance.rs:81
fn jet_int(value: Int64) -> String {
    if value >= 0 { value.to_string() } else { "(0 - {value.unsigned_abs()})" }
}
// Rust: tests/record_conformance.rs:91
fn jet_value(value: RecordValue) -> String {
    if value == {
        .Null -> "RecordValue.Null"
        .Bool(flag) -> "RecordValue.Bool{{value: {flag}}}"
        .Int(number) -> "RecordValue.Int{{value: {jet_int(number)}}}"
        .Str(text) -> "RecordValue.Str{{value: {jet_string(text)}}}"
        .Bytes(bytes) -> "RecordValue.Bytes{{value: {jet_bytes(bytes)}}}"
        .List(values) -> "RecordValue.List{{values: [RecordValue]{{{values.iter().map(jet_value).collect().join(", ")}}}}}"
        .Map(fields) -> {
            // Rust BTreeMap iterates sorted keys; reverse once for sort coverage.
            keys := fields.keys().collect()
            keys.sort()
            rendered :: keys.iter().rev().map(|name| -> "RecordField{{name: {jet_string(name)}, value: {jet_value(fields[name])}}}").collect().join(", ")
            "RecordValue.Map{{fields: [RecordField]{{{rendered}}}}}"
        }
        .Digest(digest) -> "RecordValue.Digest{{value: {jet_bytes(digest)}}}"
    }
}
// Rust: tests/record_conformance.rs:115
fn jet_sections(sections: [RecordSection]) -> String {
    rendered :: sections.iter().map(|section| -> "RecordSection{{id: {section.tag}, elements: [RecordValue]{{{section.elements.iter().map(jet_value).collect().join(", ")}}}}}").collect()
    "[RecordSection]{{{rendered.join(", ")}}}"
}
// Rust: tests/record_conformance.rs:129
fn map(fields: [(String, RecordValue)]) -> RecordValue {
    values := [:] as [String:RecordValue]
    loop (name, value) in fields { values[name.to_string()] = value.clone() }
    RecordValue.Map(^values)
}

