// Rust: tests/record_conformance.rs:206
fn sealed(body: [UInt8]) -> [UInt8] {
    bytes := body.to_vec()
    bytes.extend_from_slice(sha256(body))
    bytes
}
// Rust: tests/record_conformance.rs:214
fn body_with(strings: [String], elements: [[UInt8]]) -> [UInt8] {
    body := [0x4a, 0x45, 0x54, 0x52, 1, 1, 0x73] as [UInt8]
    body.push(UInt8(strings.len()))
    loop text in strings {
        body.push(UInt8(text.len()))
        body.extend_from_slice(text.as_bytes())
    }
    body.extend_from_slice([1, 1, UInt8(elements.len())])
    loop element in elements { body.push(UInt8(element.len())) }
    loop element in elements { body.extend_from_slice(element) }
    body
}
// Rust: tests/record_conformance.rs:233
fn decode_fixtures() -> [[UInt8]] {
    valid :: encode_record("jet.items/v1", &record_fixtures()[1].1).expect("fixture encodes")
    flipped := valid.clone()
    flipped[flipped.len() - 1] ^= 1
    bad_magic := valid.clone()
    bad_magic[3] = 0x58
    trailing := body_with(["a"], [[4, 0]])
    trailing.push(0)
    [
        valid.clone(), encode_record("jet.program/v1", []).expect("empty record encodes"), valid[..20].to_vec(), flipped, bad_magic,
        sealed([0x4a, 0x45, 0x54, 0x52, 2, 1, 0x73, 0, 0]),
        sealed([0x4a, 0x45, 0x54, 0x52, 0x81, 0, 1, 0x73, 0, 0]),
        sealed([0x4a, 0x45, 0x54, 0x52, 1, 1, 0x73, 0, 2, 1, 0, 1, 0]),
        sealed([0x4a, 0x45, 0x54, 0x52, 1, 1, 0x73, 1, 1, 0xff, 0]),
        sealed(body_with(["b", "a"], [[7, 2, 0, 0, 1, 0]])),
        sealed(body_with(["a"], [[7, 2, 0, 0, 0, 0]])),
        sealed(body_with([], [[4, 5]])), sealed(body_with([], [[9]])), sealed(body_with([], [[0, 0]])), sealed(body_with([], [[5, 3, 1]])),
        sealed(body_with([], [[3, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x02]])), sealed(trailing)
    ]
}
// Rust: tests/record_conformance.rs:262
fn rust_decode_line(bytes: [UInt8]) -> String {
    if decode_record(bytes) == {
        .Ok(record) -> {
            again :: encode_record(&record.schema, &record.sections).expect("decoded record re-encodes")
            "decode ok {hex(again)} {hex(record.digest)}"
        }
        .Err(error) -> "decode {error}"
    }
}
