// Rust: tests/taskgroup_params.rs:98
#Test("named_function_parameters_spawn_copy_and_owned_captures") {
    if !have_rustc() { return }
    // Bare task targets the innermost active group, not a qualified parameter.
    source :: `
fn spawn_one(group: Group, value: Int) -> {
    handle :: task value + 1
    print(handle.join() ?? 0)
}
fn spawn_owned(group: Group, values: ^[Int]) -> {
    handle :: task values[0]
    print(handle.join() ?? 0)
}
fn spawn_both(group: Group) -> {
    left :: task 20
    right :: task 22
    print((left.join() ?? 0) + (right.join() ?? 0))
}
fn run() -> {
    task.group group {
        spawn_one(group, 41)
        values :: [7, 8, 9]
        spawn_owned(group, ^values)
        task.group inner { spawn_both(inner) }
    }
}
`
    (code, stdout) :: build_and_run("taskgroup_parameter", source)
    assert_eq(code, 0)
    assert_eq(stdout, "42\n7\n42\n")
}
