// Rust: tests/taskgroup_params.rs:217
#Test("taskgroup_type_is_second_class") {
    loop (source, expected) in [
        (`struct Bad { group: Group }
fn run() -> {}
`, ["E1110"]),
        (`fn bad() -> Group { return 0 }
fn run() -> {}
`, ["E1110", "E0113"]),
        (`struct Bad { step: Int
    fn bad(self) -> Group { return 0 }
}
fn run() -> {}
`, ["E1110", "E0113"]),
        (`fn run() -> { group: Group :: 0 }
`, ["E0003"]),
        (`fn run() -> { f :: (group: Group) -> 0 }
`, ["E0119"]),
        (`fn bad(group: Group) -> { alias :: group }
fn run() -> {}
`, ["E0120"]),
        (`fn bad(group: Group) -> { groups :: [group] }
fn run() -> {}
`, ["E1110"]),
        (`fn bad(group: Group) -> { pair :: (group: group, n: 1) }
fn run() -> {}
`, ["E1110"]),
        (`fn bad(group: Group) -> { maybe :: Val(group) }
fn run() -> {}
`, ["E1110"])
    ] {
        assert_eq(error_codes(source), expected, "{source}")
    }
}
// Rust: tests/taskgroup_params.rs:255
#Test("taskgroup_cannot_escape_in_a_closure") {
    source :: `
fn use_group(group: Group) -> Int { 1 }
fn escape(group: Group) -> fn() -> Int { return () -> use_group(group) }
fn run() -> {}
`
    assert_eq(error_codes(source), ["E1110", "E0403"])
    method_escape :: `
fn use_group(group: Group) -> Int { 1 }
struct Crawler {
    step: Int
    fn escape(self, group: Group) -> fn() -> Int { return () -> use_group(group) }
}
fn run() -> {}
`
    assert_eq(error_codes(method_escape), ["E1110", "E0403"])
}
// Rust: tests/taskgroup_params.rs:291
#Test("method_parameters_spawn_owned_captures") {
    source :: `
struct Crawler {
    step: Int
    fn drain(self, _group: Group, values: ^[Int]) -> {
        step :: self.step
        handle :: task values[0] + step
        print(handle.join() ?? 0)
    }
}
fn run() -> {
    task.group group {
        crawler :: Crawler{step: 2}
        values :: [40]
        crawler.drain(group, ^values)
    }
}
`
    assert_group_close_success("method_parameter_group", source, "42\n")
    view_capture :: `
struct Crawler {
    step: Int
    fn drain(self, group: Group, values: View<Int>) -> {
        handle :: task values[0]
        print(handle.join() ?? 0)
    }
}
fn run() -> {}
`
    assert_eq(error_codes(view_capture), ["E1102"])
}
// Rust: tests/taskgroup_params.rs:332
#Test("evaluator_supports_taskgroup_combinators") {
    source :: `
use core.time as time
fn slow_seven() -> Int { time.sleep(30ms)
    return 7 }
fn slow_eleven() -> Int { time.sleep(30ms)
    return 11 }
fn run() -> {
    task.group all_group {
        values :: (task.all { 1, 2 }) ?? panic("all failed")
        print(values[0] + values[1])
    }
    task.group race_group { print((task.race { slow_seven(), 8 }) ?? panic("race failed")) }
    task.group any_group { print((task.any { slow_eleven(), 12 }) ?? panic("any failed")) }
}
`
    interpreted :: match interpreter_outcome("combinators", source) {
        .Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "{stderr}")
            ^stdout
        }
        .Problems(diags) -> panic("interpreter rejected task groups: {diags:?}")
    }
    assert_eq(interpreted, "3\n8\n12\n")
    (code, stdout, stderr) :: run_default_multi("taskgroup_combinators", "main.jet", [("main.jet", source)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, interpreted, "{stderr}")
    if have_rustc() {
        (code, stdout) :: build_and_run("taskgroup_combinators", source)
        assert_eq(code, 0)
        assert_eq(stdout, interpreted)
    }
}
// Rust: tests/taskgroup_params.rs:476
#Test("native_cancellation_closes_group_before_caller_continues") {
    source :: `
use core.time as time
fn wait_in_group(sender: Sender<Int>) -> {
    task.group group {
        child :: task {
            sender.send(1)
            time.sleep(10ms)
            print("settled")
        }
        time.sleep(10000ms)
        child.join() ?? panic("child failed")
    }
}
fn run() -> {
    (sender, ready) :: channel<Int>()
    outer :: task wait_in_group(sender)
    ready.receive() ?? panic("child did not start")
    outer.cancel()
    if outer.join() == {
        .Err(_) -> { print("cancelled") }
        .Ok(_) -> { print("ok") }
    }
    print("caller")
}
`
    assert_group_close_success("taskgroup_cancel", source, "settled\ncancelled\ncaller\n")
}
// Rust: tests/taskgroup_params.rs:508
#Test("native_deadline_closes_group_before_caller_continues") {
    source :: `
use core.time as time
fn leave_on_deadline() -> {
    task.group group {
        child :: task {
            total := 0
            loop n in 0..<2000000 { total += n }
            print("settled")
        }
        #Context(deadline: time.now() - 1) { time.sleep(10000ms) }
        child.join() ?? panic("child failed")
    }
}
fn run() -> {
    leave_on_deadline()
    print("caller")
}
`
    assert_native_wait_exit("taskgroup_deadline_exit", source, "E3003", "settled\n")
}
// Rust: tests/taskgroup_params.rs:535
#Test("native_panicked_wait_closes_group_before_caller_continues") {
    source :: `
struct Gate { step: Int }
fn slow_value(gate: Shared<Gate>) -> Int {
    gate.step = 1
    total := 0
    loop n in 0..<2000000 { total += n }
    print("settled")
    return 1
}
fn fail_after_start(gate: Shared<Gate>) -> Int {
    loop gate.step == 0 {}
    panic("wait failed")
    return 0
}
fn leave_on_wait_panic() -> {
    gate :: shared Gate{ step: 0 }
    task.group group {
        slow :: task slow_value(gate)
        _ignored :: (task.any { fail_after_start(gate) }) ?? 0
        slow.join() ?? panic("slow child failed")
    }
}
fn run() -> {
    leave_on_wait_panic()
    print("caller")
}
`
    assert_group_close_success("taskgroup_wait_panic", source, "settled\ncaller\n")
}
// Rust: tests/taskgroup_params.rs:578
#Test("local_task_binding_is_not_parsed_as_spawn_syntax") {
    reserved :: `
fn run() -> {
    task :: [7]
    print(task[0])
}
`
    diagnostics :: jet.compile(reserved).expect_err("task is a reserved word")
    refusal :: diagnostics.iter().find(diagnostic -> diagnostic.code == "E0003").expect("the reserved word must be refused at the name that spells it")
    assert(refusal.what.contains("`task`") && refusal.what.contains("reserved"), "the refusal must name the reservation, not a generic parse confusion: {refusal:?}")
    free_selectors :: `
fn run() -> {
    all :: 1
    race :: 2
    any :: 4
    group :: 8
    print(all + race + any + group)
}
`
    _ :: jet.compile(free_selectors).expect("all, race, any, and group are free identifiers")
}
// Rust: tests/taskgroup_params.rs:612
#Test("early_return_closes_group_before_caller_continues") {
    source :: `
fn spawn_bad(_group: Group) -> { _bad :: task panic("child") }
fn leave() -> Int {
    task.group group {
        spawn_bad(group)
        total := 0
        loop n in 0..<2000000 { total += n }
        return 1
    }
    return 0
}
fn run() -> {
    leave()
    print("after")
}
`
    (interpreted_stdout, interpreted_stderr) :: match interpreter_outcome("early_return", source) {
        .Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "{stderr}")
            (^stdout, ^stderr)
        }
        .Problems(diags) -> panic("interpreter rejected child panic: {diags:?}")
    }
    assert_eq(interpreted_stdout, "after\n")
    assert_eq(interpreted_stderr, "")
    (code, stdout, stderr) :: run_default_multi("taskgroup_early_return", "main.jet", [("main.jet", source)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, "after\n", "{stderr}")
    assert_eq(stderr, "", "runtime diagnostics: {stderr}")
    if have_rustc() {
        (code, stdout, stderr) :: build_and_run_full("jet_taskgroup", "taskgroup_early_return", source)
        assert_eq(code, 0, "{stderr}")
        assert_eq(stdout, "after\n", "{stderr}")
        assert_eq(stderr, "", "{stderr}")
    }
}
