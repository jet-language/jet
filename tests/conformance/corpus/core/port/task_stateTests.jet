// Rust: tests/task_state.rs:19
#Test("task_join_duty_uses_the_dlin1_obligation_pass") {
    unjoined :: `
fn run() -> {
    handle :: task 42
    print(0)
}
`
    diagnostics :: diagnostic_codes(unjoined)
    assert(diagnostics.iter().any(code -> code == "L1101"), "missing shared join-duty error: {diagnostics:?}")
    joined :: `
fn run() -> {
    handle :: task 42
    print(handle.join() ?? 0)
}
`
    codes :: diagnostic_codes(joined)
    assert(codes.iter().all(code -> code != "L1101"), "joining must discharge the D-LIN1 duty: {codes:?}")
}
// Rust: tests/task_state.rs:46
#Test("a_task_handle_list_is_consumed_by_pop_and_join") {
    source :: `
fn run() -> {
    workers := [Task<()>].{}
    &workers.push(task { })
    loop workers.len() > 0 {
        worker :: &workers.pop() ?? panic("missing worker")
        worker.join() ?? panic("worker failed")
    }
}
`
    _ :: jet.compile(source).expect("a [Task<T>] list is not #SingleUse; popping and joining each handle must compile")
}
// Rust: tests/task_state.rs:62
#Test("task_lifecycle_joins_through_the_shared_flow_fact_walker") {
    source :: `
fn run() -> {
    handle :: task 42
    if {
        true -> handle.join() ?? 0
        else -> handle.detach()
    }
}
`
    output :: jet.compile(source).expect("both branches must discharge the task duty")
    assert(output.lints.iter().any(diagnostic -> diagnostic.code == "L0152"), "joined task states must report the shared typestate divergence: {output.lints:?}")
    assert(output.lints.iter().all(diagnostic -> diagnostic.code != "L1101"), "the shared D-LIN1 pass must not report a task consumed on both branches: {output.lints:?}")
}
// Rust: tests/task_state.rs:114
// A task body's return is conditional in its enclosing function: declarations
// after it stay reachable, even when the body itself contains a real mistake.
#Test("a_return_inside_a_task_body_keeps_later_declarations") {
    valueless :: `
fn run() -> {
    child :: task { return }
    later :: 7
    print(later)
    child.detach()
}
`
    codes :: all_codes(valueless)
    assert(codes.iter().all(code -> code != "E0107" && code != "E0102"), "a task-body return must not erase later declarations: {codes:?}")
    mistaken :: `
fn run() -> {
    child :: task { return "child" }
    later :: 7
    print(later)
    child.detach()
}
`
    mistaken_codes :: all_codes(mistaken)
    assert(mistaken_codes.iter().all(code -> code != "E0107" && code != "E0102"), "the real error must not drag a phantom name cascade behind it: {mistaken_codes:?}")
    assert(!mistaken_codes.is_empty(), "the return handing a value back from a Unit run is still an error")
}

