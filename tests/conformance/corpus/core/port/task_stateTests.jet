// Rust: tests/taskgroup_params.rs:169
#Test("default_run_joins_helper_spawn_before_outer_exit") {
    match interpreter_outcome("parameter_join", OUTER_GROUP_HELPER) {
        .Ran{stdout, stderr, exit_code} -> {
            assert_eq(exit_code, 0, "{stderr}")
