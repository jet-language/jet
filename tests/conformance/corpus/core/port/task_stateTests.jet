        }
        .Problems(diags) -> panic("interpreter rejected helper spawn: {diags:?}")
    }
    assert_native_compiles("parameter_join", OUTER_GROUP_HELPER)
    (code, stdout, stderr) :: run_default_multi("taskgroup_parameter_join", "main.jet", [("main.jet", OUTER_GROUP_HELPER), ("package.jet", TASKGROUP_TEST_PACKAGE)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, "inside\ntask\nafter\n", "{stderr}")
    assert_eq(stderr, "")
}
