//RS /// c109 Phase 13: handle methods. A FileWriter (from `files.create`) routes through
//RS /// the TIR for `write_line`/`flush` (the `&mut` handle arms of `emit_builtin_method`).
//RS /// A handle binding also forces `let mut` even when bound immutably — the parity fix
//RS /// to the TIR `Let`. Proves the handle-method emit + the forced-mut binding.
//RS #[test]
//RS fn handle_methods_file_writer() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     // Write/read through an absolute temp path so the test leaves no repo artifact.
//RS     let tmp = std::env::temp_dir().join(format!("jet_tir_handle_{}.txt", std::process::id()));
//RS     let tmp_str = tmp.to_string_lossy().replace('\\', "\\\\");
//RS     let src = format!(
//RS         "\
//RS use core.files as files
//RS use core.files as fs
//RS fn write_file(path: String, text: String) -> Int {{
//RS     w := files.create(~path) ?? return 0
