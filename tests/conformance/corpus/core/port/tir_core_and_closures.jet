// Rust: tests/tir_core_and_closures.rs:1
// TIR core and closures integration fixtures; paired tests retain behavioral witnesses.
use tests.common as common
use tests.tir_support as tir_support
use std.fs as fs
use std.process.[Command]
// Rust: tests/tir_core_and_closures.rs:125
fn stage_jetpack_phase1(source: OSPath, destination: OSPath) -> {
    // GATE #4494: real native directory and file-copy providers.
    fs.create_dir_all(destination).expect("create staged Jetpack fixture")
    loop name in ["package.jet", "env.jet"] {
        fs.copy(source.join(name), destination.join(name)).unwrap_or_else(error -> { panic("copy Jetpack fixture {name}: {error}") })
    }
    lock :: destination.join(".jet/lock")
    fs.create_dir_all(lock.parent().unwrap()).expect("create staged Jetpack lock directory")
    fs.copy(source.join("fixture-state/lock"), lock).unwrap_or_else(error -> { panic("stage Jetpack fixture lock: {error}") })
}
