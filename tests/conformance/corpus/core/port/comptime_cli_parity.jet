// Rust: tests/comptime_cli_parity.rs:527
fn checked_enum_discriminants(path: OSPath, enum_name: String) -> [(String, i64?)] {
    bundle := Loader.load_entry(path.to_str().expect("enum discriminant fixture path is valid UTF-8"))
        .unwrap_or_else(|diagnostics| -> panic("enum discriminant fixture failed to load: {diagnostics.debug()}"))
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter(|diagnostic| -> diagnostic.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "enum discriminant fixture failed sema: {errors.debug()}")
    bundle.modules[bundle.entry].items.iter().find_map(|item| -> match item {
        AST.Item.Enum(definition) if definition.name == enum_name -> Val(definition.variants.iter().map(|variant| -> (variant.name.clone(), variant.discriminant)).collect())
        _ -> None
    }).unwrap_or_else(|| -> panic("enum `{enum_name}` was not registered"))
}
// Rust: tests/comptime_cli_parity.rs:559
fn assert_enum_discriminants(path: OSPath, enum_name: String, expected: [(String, i64?)]) -> {
    observed :: checked_enum_discriminants(path, enum_name)
    assert_eq(observed.len(), expected.len(), "enum `{enum_name}` variant count changed: {observed.debug()}")
    loop (actual, (expected_name, expected_value)) in observed.iter().zip(expected.iter()) {
        assert_eq(actual.0.as_str(), expected_name)
        assert_eq(actual.1, expected_value, "enum `{enum_name}` code for `{expected_name}` changed")
    }
}
// Rust: tests/comptime_cli_parity.rs:579
fn assert_enum_discriminant_error(path: OSPath, source: String, expression: String, expected_what: String) -> {
    bundle := Loader.load_entry(path.to_str().expect("enum discriminant diagnostic path is valid UTF-8"))
        .unwrap_or_else(|diagnostics| -> panic("enum diagnostic fixture failed to load: {diagnostics.debug()}"))
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    diagnostic :: diagnostics.iter().find(|diagnostic| -> diagnostic.code == "E0035")
        .unwrap_or_else(|| -> panic("missing E0035 for `{expression}`: {diagnostics.debug()}"))
    start :: source.find(expression).unwrap_or_else(|| -> panic("expression `{expression}` is absent from fixture"))
    assert_eq(diagnostic.what, expected_what)
    assert_eq(diagnostic.span, Val(Diagnostics.Span.new(start, start + expression.len())), "diagnostic span changed for `{expression}`")
}
// Rust: tests/comptime_cli_parity.rs:976
fn assert_cli_rejection(output: Output, label: String, expected: [String]) -> {
    stderr :: String.from_utf8_lossy(output.stderr)
    assert_eq(output.status.code(), Val(2), "{label} returned the wrong exit status:\n{stderr}")
    assert(output.stdout.is_empty(), "{label} wrote to stdout")
    loop text in expected { assert(stderr.contains(text), "{label} omitted `{text}`:\n{stderr}") }
}
// Rust: tests/comptime_cli_parity.rs:1191
fn help_body(output: [u8]) -> &[u8] {
    newline :: output.iter().position(|byte| -> byte == 10u8).expect("generated CLI help must have a Usage line")
    &output[newline + 1..]
}
