// Rust: tests/comptime_cli_parity.rs:9
// Ordinary nominal types and CheckedText use the same native/run paths.
TIER_PARITY_STEMS :: ["cli/subcommands", "concurrency/freeze_capture", "comptime/embed", "comptime/embed_bytes", "comptime/find", "comptime/find_empty", "tooling/checked_text_type"]

// Rust: tests/comptime_cli_parity.rs:19
// GATE #4494: native filesystem operations.
fn copy_comptime_fixture(root: OSPath, destination: OSPath, stem: String) -> String {
    file_name :: stem.rsplit('/').next().expect("comptime stem has a file name")
    fs.copy(root.join("Examples/features").join("{stem}.jet"), destination.join("{file_name}.jet"))
        .unwrap_or_else(|error| -> panic("copy `{stem}` fixture: {error}"))
    assets :: match stem {
        "comptime/embed" -> ["motd.txt"]
        "comptime/embed_bytes" -> ["logo.bin"]
        "comptime/find" | "comptime/find_empty" -> ["find_inputs/alpha-1.txt", "find_inputs/nested/beta-2.txt", "find_inputs/nested/gamma-3.txt"]
        _ -> []
    }
    loop relative in assets {
        target :: destination.join(relative)
        if parent :: target.parent() { fs.create_dir_all(parent).expect("create comptime fixture asset directory") }
        fs.copy(root.join("Examples/features/comptime").join(relative), target)
            .unwrap_or_else(|error| -> panic("copy `{relative}` for `{stem}`: {error}"))
    }
    "{file_name}.jet"
}

// Rust: tests/comptime_cli_parity.rs:54
fn copy_build_stamp_fixture(root: OSPath, destination: OSPath) -> {
    fs.copy(root.join("Examples/features/comptime/build_stamp.jet"), destination.join("build_stamp.jet")).expect("copy build stamp example")
    lock_dir :: destination.join(".jet")
    fs.create_dir_all(lock_dir).expect("create build stamp lock directory")
    fs.copy(root.join("tests/fixtures/build_stamp.lock"), lock_dir.join("lock")).expect("copy build stamp lock fixture")
}

// Rust: tests/comptime_cli_parity.rs:69
// GATE #4494: actual native subprocess provider and retained output/status.
fn run_jet(args: [String], project: OSPath, cache: OSPath) -> Output {
    fs.create_dir_all(cache).expect("create isolated Jet cache")
    Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(args).current_dir(project)
        .env("JET_STORE_DIR", cache.join("build")).env("JET_RUN_CACHE_DIR", cache.join("run"))
        .env("NO_COLOR", "1").output().unwrap_or_else(|error| -> panic("spawn `{args.join(" ")}`: {error}"))
}

// Rust: tests/comptime_cli_parity.rs:81
fn assert_tier_parity_case(root: OSPath, scratch: common.Scratch, stem: String) -> {
    case_dir :: scratch.join(stem.replace('/', "_"))
    fs.create_dir_all(case_dir).expect("create comptime parity case directory")
    file_name :: copy_comptime_fixture(root, case_dir, stem)
    expected_path :: root.join("Examples/features/expected/{stem}.out")
    expected :: fs.read(expected_path).unwrap_or_else(|error| -> panic("missing golden for `{stem}`: {error}"))
    cache :: case_dir.join("cache")
    build :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["build", file_name]).current_dir(case_dir)
        .env("JET_STORE_DIR", cache.join("aot")).env("NO_COLOR", "1").output()
        .unwrap_or_else(|error| -> panic("failed to spawn AOT build for `{stem}`: {error}"))
    assert(build.status.success(), "AOT build failed for `{stem}`:\nstdout:\n{String.from_utf8_lossy(build.stdout)}\nstderr:\n{String.from_utf8_lossy(build.stderr)}")
    binary_name :: file_name.strip_suffix(".jet").expect("Jet fixture extension")
    aot :: Command.new(case_dir.join(".jet").join("build").join(binary_name)).current_dir(case_dir).output()
        .unwrap_or_else(|error| -> panic("failed to run AOT binary for `{stem}`: {error}"))
    assert(aot.status.success(), "AOT run failed for `{stem}`:\n{String.from_utf8_lossy(aot.stderr)}")
    assert_eq(aot.stdout, expected, "AOT output differs from the checked-in golden for `{stem}`")
    output :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", file_name, "--trace-tiers"]).current_dir(case_dir)
        .env("JET_RUN_CACHE_DIR", cache.join("run")).env("JET_STORE_DIR", cache.join("build")).env("NO_COLOR", "1").output()
        .unwrap_or_else(|error| -> panic("failed to spawn `jet run` for `{stem}`: {error}"))
    trace :: String.from_utf8_lossy(output.stderr)
    assert(output.status.success(), "default `jet run` failed for `{stem}`:\nstdout:\n{String.from_utf8_lossy(output.stdout)}\nstderr:\n{trace}")
    assert(trace.lines().any(|line| -> line.starts_with("run") && line.contains("tier1 native")), "default `jet run` did not report resident native execution for `{stem}`:\n{trace}")
    assert(!trace.contains("tier0 interp"), "default `jet run` deopted to the interpreter for `{stem}`:\n{trace}")
    assert_eq(output.stdout, expected, "default `jet run` output differs from the checked-in golden for `{stem}`")
    interpreted_cache :: cache.join("interpret")
    interpreted :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "--interpret", file_name, "--trace-tiers"]).current_dir(case_dir)
        .env("JET_RUN_CACHE_DIR", interpreted_cache.join("run")).env("JET_STORE_DIR", interpreted_cache.join("build")).env("NO_COLOR", "1").output()
        .unwrap_or_else(|error| -> panic("failed to spawn interpreted `jet run` for `{stem}`: {error}"))
    interpreted_trace :: String.from_utf8_lossy(interpreted.stderr)
    assert(interpreted.status.success(), "interpreted `jet run` failed for `{stem}`:\nstdout:\n{String.from_utf8_lossy(interpreted.stdout)}\nstderr:\n{interpreted_trace}")
    assert(interpreted_trace.contains("tier0 interp"), "forced interpreter did not report interpreter execution for `{stem}`:\n{interpreted_trace}")
    assert(!interpreted_trace.contains("E2201"), "forced interpreter deopted for `{stem}`:\n{interpreted_trace}")
    assert_eq(interpreted.stdout, expected, "interpreter output differs from the checked-in golden for `{stem}`")
}

