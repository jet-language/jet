    _ :: values.para_map((n: Int) -> pending.get() + n)
}
"""
    assert_native_crossing("signal_parallel", source, "")
}
// Rust: tests/concurrency_boundaries.rs:264
#Test("derived_and_computed_cross_task_without_rustc_send_ice") {
    derived_source :: """
use core.reactive as reactive
fn run() {
    base := reactive.signal(1)
    twice := reactive.derived(() -> (base.get() * 2))
    worker :: task {
        print(twice.get())
    }
    worker.join() ?? panic("task failed")
}
"""
    assert_native_crossing("derived_task", derived_source, "2\n")
    computed_source :: """
use core.reactive as reactive
use core.tasks as tasks
fn run() {
    base := reactive.signal(1)
    twice := reactive.computed(() -> (base.get() * 2))
    (tx, rx) :: channel<Computed<Int>>()
    tx.send(~twice)
    got :: rx.receive() ?? panic("recv")
    print(got.get())
}
"""
    assert_native_crossing("computed_channel", computed_source, "2\n")
}
