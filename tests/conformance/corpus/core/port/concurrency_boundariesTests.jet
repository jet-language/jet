    worker :: task print(guard.value)
    worker.join() ?? panic("task failed")
}
""", "E1102")
}
// Rust: tests/concurrency_boundaries.rs:67
#Test("local_cell_rejects_task_channel_shared_and_parallel_crossings") {
    assert_rejected("""
fn cross(cell: Cell<Int>) {
    worker :: task {
        _ :: cell
    }
    worker.join() ?? panic("task failed")
}
fn run() {}
""", "E1102")
    assert_rejected("""
use core.tasks as tasks
fn cross(cell: Cell<Int>) {
    (tx, rx) :: channel<Cell<Int>>()
    tx.send(^cell)
}
fn run() {}
""", "E1102")
    assert_rejected("""
fn cross(cell: Cell<Int>) {
    values :: [1, 2, 3]
    _ :: values.para_map((n: Int) -> {
        _ :: cell
        return n
    })
}
fn run() {}
""", "E1102")
}
// Rust: tests/concurrency_boundaries.rs:109
#Test("shared_constructor_rejects_local_cell_at_the_constructor") {
    source :: """
fn cross(cell: Cell<Int>) {
    _ :: shared cell
}
fn run() {}
"""
    diagnostics :: compile(source).expect_err("`shared cell` must fail in sema")
    error :: diagnostics.iter().find(|diagnostic| -> diagnostic.code == "E1102" && diagnostic.what.contains("cannot be stored in `Shared<T>`"))
        .expect("E1102 must point at the `shared` construction instead of a later task use")
    start :: error.span.expect("E1102 must have a source span").start
    assert(source[start..].starts_with("cell"), "E1102 must point at the constructed Cell value: {error.debug()}")
}
// Rust: tests/concurrency_boundaries.rs:132
#Test("shared_constructor_rejects_cell_nested_in_a_struct") {
    source :: """
struct Holder { value: Cell<Int> }
fn cross(holder: Holder) {
    _ :: shared holder
}
fn run() {}
"""
    diagnostics :: compile(source).expect_err("`shared` on a struct containing a Cell must fail in sema")
    assert(diagnostics.iter().any(|diagnostic| -> diagnostic.code == "E1102" && diagnostic.what.contains("cannot be stored in `Shared<T>`")), "{diagnostics.debug()}")
}
