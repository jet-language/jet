// Rust: tests/concurrency_boundaries.rs:359
#Test("task_and_parallel_writes_use_one_registered_rejection_shape") {
    task :: compile("""
fn run() {
    count := 0
    worker :: task { count += 1 }
    worker.join() ?? panic("task failed")
}
""").expect_err("task write must be rejected").into_iter().find(|diagnostic| -> diagnostic.code == "E1101").expect("task write must use E1101")
    parallel :: compile("""
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_map((n: Int) -> { &seen.push(n) })
}
""").expect_err("parallel write must be rejected").into_iter().find(|diagnostic| -> diagnostic.code == "E1101").expect("parallel write must use E1101")
    assert_eq(task.why, parallel.why)
    assert_eq(task.fix, parallel.fix)
    assert(task.what.contains("task capture"))
    assert(parallel.what.contains("parallel worker"))
}
