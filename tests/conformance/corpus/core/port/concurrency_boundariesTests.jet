// Rust: tests/concurrency_boundaries.rs:778
#Test("a_taskgroup_parameter_cannot_lend_a_borrow") {
    // Join runs in caller's frame; this frame cannot prove owner lifetime.
    source :: """
fn spawn_view(group: Group, values: View<Int>) {
    handle :: task values[0]
    print(handle.join() ?? panic("task failed"))
}
fn run() {}
"""
    assert_rejected(source, "E1102")
}
// Rust: tests/concurrency_boundaries.rs:792
#Test("crossing_prover_keeps_the_ratified_before_after_matrix") {
    // D-PARCAPTURE1=D: prover/voice changes cannot alter the safe crossing set.
    cases :: [
        ("task capture", """
fn run() {
    frozen :: freeze(41)
    worker :: task frozen
    print(worker.join() ?? 0)
}
""", None),
        ("parallel adapter", """
fn run() {
    values :: [1, 2, 3]
    doubled :: values.para_map((n: Int) -> n * 2)
    print(doubled)
}
""", None),
        ("parallel local cell", """
fn cross(cell: Cell<Int>) {
    values :: [1, 2, 3]
    _ :: values.para_map((n: Int) -> {
        _ :: cell
        return n
    })
}
fn run() {}
""", Val("E1102")),
        ("parallel fixed backing", """
use core.mem
fn run() {
    fixed :: mem.Fixed.new(size: 128)
    values :: [1, 2, 3]
    _ :: values.para_map((n: Int) -> {
        _ :: fixed
        return n
    })
}
""", Val("E1102")),
        ("safe kernel", """
#Kernel(.parallel) fn add(left: Int, right: Int) -> Int { left + right }
fn run() { print(add(20, 22)) }
""", None),
        ("task mutable capture", """
fn run() {
    count := 0
    worker :: task { count += 1 }
    worker.join() ?? panic("task failed")
}
""", Val("E1101")),
        ("parallel mutable capture", """
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_map((n: Int) -> { &seen.push(n) })
}
""", Val("E1101")),
        ("kernel effect", """
#Kernel(.parallel) fn noisy(value: Int) -> Int {
    print(value)
    return value
}
fn run() { print(noisy(1)) }
""", Val("E1102")),
        ("kernel local cell", """
#Kernel(.parallel) fn blocked(cell: Cell<Int>) -> Int { 0 }
fn run() {}
""", Val("E1102")),
        ("local cell", """
fn cross(cell: Cell<Int>) {
    worker :: task { _ :: cell }
    worker.join() ?? panic("task failed")
}
fn run() {}
""", Val("E1102")),
        ("fixed backing", """
use core.mem
fn run() {
    fixed :: mem.Fixed.new(size: 128)
    worker :: task { _ :: fixed }
    worker.join() ?? panic("task failed")
}
""", Val("E1102"))]
    loop (name, source, expected_code) in cases {
        match (expected_code, compile(source)) {
            (None, Ok(_)) -> {}
            (None, Err(diagnostics)) -> panic("{name} changed from accepted: {diagnostics.debug()}")
            (Val(code), Ok(_)) -> panic("{name} changed from rejected: expected {code}")
            (Val(code), Err(diagnostics)) -> assert(diagnostics.iter().any(|diagnostic| -> diagnostic.code == code), "{name} lost {code}: {diagnostics.debug()}")
        }
    }
}
