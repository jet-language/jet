// Rust: tests/concurrency_boundaries.rs:167
#Test("local_cell_guard_types_are_not_sendable") {
    loop guard in ["CellReadGuard<Int>", "CellEditGuard<Int>"] {
        source :: """
fn cross(guard: {guard}) {
    worker :: task {
        _ :: guard
    }
    worker.join() ?? panic("task failed")
}
fn run() {}
"""
        codes :: error_codes(source)
        assert(codes.iter().any(|code| -> code == "E1102"), "task capture must keep the task-boundary diagnostic: {codes.debug()}")
        assert(codes.iter().all(|code| -> code != "E0217"), "aggregate-storage E0217 must not shadow task-boundary E1102: {codes.debug()}")
    }
}
// Rust: tests/concurrency_boundaries.rs:193
#Test("signal_crosses_task_and_channel_without_rustc_send_ice") {
    task_source :: """
use core.reactive as reactive
fn run() {
    pending := reactive.signal(0)
    worker :: task {
        &pending.set(1)
    }
    worker.join() ?? panic("task failed")
    print(pending.get())
}
"""
    assert_native_crossing("signal_task", task_source, "1\n")
    channel_source :: """
use core.reactive as reactive
use core.tasks as tasks
fn run() {
    pending := reactive.signal(0)
    (tx, rx) :: channel<Signal<Int>>()
    tx.send(~pending)
    got :: rx.receive() ?? panic("recv")
    print(got.get())
}
"""
    assert_native_crossing("signal_channel", channel_source, "0\n")
}
