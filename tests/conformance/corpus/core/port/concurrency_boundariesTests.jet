// Rust: tests/concurrency_boundaries.rs:535
#Test("taskgroup_children_borrow_disjoint_write_places") {
    source :: """{PARTICLES}
fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3}, {position: 30, velocity: 4} }
        task.group g {
        left :: &particles[0]
        right :: &particles[2]
        a :: task {
            left.position += left.velocity
            left.position
        }
        b :: task {
            right.position += right.velocity
            right.position
        }
    }
}
"""
    // Behavior verifies the group spawn loan is closed by join, not emitted Rust text.
    _ :: assert_accepted(source)
    observed :: source.replace("\n}\n", "\n    print(particles[0].position)\n    print(particles[2].position)\n}\n")
    assert_native_crossing("disjoint_group", observed, "12\n34\n")
}
