// Rust: tests/concurrency_boundaries.rs:650
#Test("a_group_cannot_lend_an_owner_declared_inside_its_own_block") {
    // Owner drops before group joins, so loan could outlive it.
    source :: """{PARTICLES}
fn run() {
        task.group g {
        particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        left :: &particles[0]
        a :: task {
            left.position += 1
            left.position
        }
    }
}
"""
    assert_rejected(source, "E1102")
}
// Rust: tests/concurrency_boundaries.rs:670
#Test("a_lent_owner_cannot_be_moved_before_the_group_joins") {
    // Spawn is the last lexical view use, but the running child's loan stays live.
    source :: """{PARTICLES}
fn eat(ps: ^[Particle]) -> Int { ps.len() }
fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        task.group g {
        left :: &particles[0]
        a :: task {
            left.position += left.velocity
            left.position
        }
        n :: eat(^particles)
        print(n)
    }
}
"""
    assert_rejected(source, "E1101")
}
// Rust: tests/concurrency_boundaries.rs:695
#Test("a_lent_place_cannot_be_written_by_the_parent_before_the_group_joins") {
    // Parent write races child write through the same place.
    source :: """{PARTICLES}
fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        task.group g {
        left :: &particles[0]
        a :: task {
            left.position += left.velocity
            left.position
        }
        particles[0].position = 99
    }
}
"""
    assert_rejected(source, "E1101")
}
// Rust: tests/concurrency_boundaries.rs:716
#Test("a_write_lent_place_cannot_be_read_by_the_parent_before_the_group_joins") {
    // Sequential reads beside a write view are legal; concurrent reads race it.
    source :: """{PARTICLES}
fn run() {
    particles := [Particle]{ {position: 10, velocity: 2}, {position: 20, velocity: 3} }
        task.group g {
        left :: &particles[0]
        a :: task {
            left.position += left.velocity
            left.position
        }
        print(particles[0].position)
    }
}
"""
    assert_rejected(source, "E1101")
}
