// Rust: tests/concurrency_boundaries.rs:1
use tests.conformance.corpus.core.port.concurrency_boundaries.[error_codes, assert_rejected, assert_accepted, PARTICLES, assert_native_crossing]
use jet.[compile]
use jet_foundation.Syntax.[MARKER_LOCAL, MARKER_SHARED]
use std.fs as fs
use std.env as env

// Rust: tests/concurrency_boundaries.rs:12
#Test("architecture_states_datarace1_c_guarantee") {
    architecture :: fs.read_to_string(OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Docs/spec/architecture.md")).unwrap()
    assert(architecture.contains("D-DATARACE1=C is law"), "architecture must state the ratified D-DATARACE1=C guarantee")
    assert(architecture.contains("lock-ordered `Arc` storage") || architecture.contains("lock-ordered Arc storage"), "architecture must state synchronized reactive storage")
    assert(!architecture.contains("own the open choice"), "architecture must not treat D-DATARACE1 as an open choice after ratification")
    assert(!architecture.contains("leans on rustc"), "architecture must not leave reactive crossings on a rustc Send backstop")
    assert_eq(MARKER_LOCAL, "Local", "#Local must be registered in Syntax.rs (D-DATARACE1=C / I7)")
    assert_eq(MARKER_SHARED, "Shared", "#Shared must be registered in Syntax.rs (D-DATARACE1=C / I7)")
}
