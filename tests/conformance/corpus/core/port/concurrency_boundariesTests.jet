// Rust: tests/concurrency_boundaries.rs:410
#Test("every_parallel_adapter_rejects_mutable_captures") {
    cases :: [
        ("para_map", """
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_map((n: Int) -> {
        &seen.push(n)
    })
}
"""),
        ("para_filter", """
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_filter((n: Int) -> {
        seen.push(n)
    })
}
"""),
        ("para_partition", """
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_partition((n: Int) -> {
        &seen.push(n)
    })
}
"""),
        ("para_fold", """
fn run() {
    seen := [Int]{}
    values :: [1, 2, 3]
    values.para_fold(
        () -> 0,
        (total: Int, n: Int) -> {
            &seen.push(n)
        },
        (left: Int, right: Int) -> left + right
    )
}
""")]
    loop (method, source) in cases {
        codes :: error_codes(source)
        assert(codes.iter().any(|code| -> code == "E1101"), "{method} must reject mutable captures with E1101, got {codes.debug()}")
    }
}
