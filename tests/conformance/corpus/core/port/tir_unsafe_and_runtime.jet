//RS 
//RS /// Regression for a real memory-safety bug: sema's D-VERDICT-1308-1 implicit
//RS /// comptime fold used to bake `mem.address_of`'s TIR-eval synthetic "stable
//RS /// place identity" (an FNV-1a hash, meaningful only inside that evaluator) as
//RS /// a literal AOT `i64` — the compiled program then dereferenced a wild
//RS /// address. The one syntactic guard that used to sit in
//RS /// crates/jet-sema/src/Sema/CheckerCore/bindings.rs was bypassable by any
//RS /// wrapping form (e.g. one extra `( )`, preserved as `Expr::Paren` under
//RS /// D-FMTPARENS1=A) and never covered the `@` / method-call / constant
//RS /// paths at all. Fixed at the one place the value is actually minted
//RS /// (crates/jet-codegen/src/Codegen/TIR/eval/exprs.rs's CoreCall handling for
//RS /// `core.mem.address_of`): it now refuses outside `runtime_execution`,
//RS /// so every fold attempt — however it's spelled or reached — declines and
//RS /// falls through to real runtime codegen instead.
//RS #[test]
//RS fn mem_address_of_never_folds_plain_or_parenthesized() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     for (name, addr_init) in [
//RS         ("tir_addr_of_plain", "mem.address_of(cell)"),
//RS         ("tir_addr_of_paren", "(mem.address_of(cell))"),
//RS     ] {
//RS         let src = format!(
//RS             "\
//RS use core.mem
//RS #Unsafe(\"reads through a raw pointer; addr must be a live, valid Int\")
//RS fn read_reg(addr: Int) -> Int {{
//RS     p :: mem.Ptr<Int>.from_addr(addr)
//RS     return mem.volatile_read(p)
//RS }}
//RS fn run() {{
//RS     cell :: 1337
//RS     addr :: {addr_init}
//RS     #Unsafe(\"addr is the address of `cell`, a live Int on this stack frame\") {{
//RS         print(read_reg(addr))
//RS     }}
//RS }}
//RS "
//RS         );
//RS         let (code, stdout) = build_and_run(name, &src);
//RS         assert_eq!(code, 0, "case {name}");
//RS         assert_eq!(stdout, "1337\n", "case {name}");
//RS     }
//RS }
//RS 
//RS /// The explicit `@` path demands a compile-time answer (unlike the
//RS /// silent-decline implicit path above) — `mem.address_of` genuinely has none,
//RS /// so it must now surface a real diagnostic instead of silently baking the
//RS /// same wild-address bug under an even stronger "I promise this is checked"
//RS /// spelling.
