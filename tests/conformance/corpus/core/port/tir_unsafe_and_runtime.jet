//RS /// c109 Phase 20: the polymorphic core specials (`math.abs/min/max/clamp`,
//RS /// `random.pick/shuffle`, `io.eprint`). Their return type is arg-type dependent
//RS /// (resolved by sema's bespoke `infer_core_call`) and written onto the
//RS /// `Expr::MethodCall.resolved_ret` field, read at lowering so the TIR is total
//RS /// (I3). The emit forms (`(x).abs()`, `(a).min(b)`, `jet_std_random_pick(&(xs))`,
//RS /// `eprintln!`) reproduce `emit_core_call` byte-for-byte. `random.pick` returns
//RS /// `?Int` (the element type wrapped in Option), proving the resolved_ret writeback.
//RS /// parity: guard tests/tir_unsafe_and_runtime.rs::polymorphic_core_specials
//RS #[test]
//RS fn polymorphic_core_specials() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS use core.math as math
//RS use core.math.random as random
//RS use core.term as io
//RS fn calc() -> Int {
//RS     a :: math.abs((-5))
//RS     b :: math.min(3, 7)
//RS     c :: math.max(3, 7)
//RS     d :: math.clamp(15, 0, 10)
//RS     io.eprint(\"trace: {a} {b} {c} {d}\")
//RS     xs := [1, 2, 3]
//RS     random.shuffle(&xs)
//RS     p :: random.pick(xs)
//RS     return ((((a + b) + c) + d) + (p ?? 0))
//RS }
//RS fn run() {
//RS     print(calc())
//RS }
//RS ";
//RS     let (code, _stdout) = build_and_run("tir_poly_specials", src);
//RS     assert_eq!(code, 0);
//RS     // a=5, b=3, c=7, d=10, p ∈ {1,2,3}; sum = 25 + p ∈ {26,27,28}.
//RS }
//RS 
//RS /// c109 Phase 20: HTTPRequest/HTTPResponse method accessors (`req.method()`/
//RS /// `req.path()`/`req.body()`/`req.header(n)`/`req.param(n)`/`resp.status()`/
//RS /// `resp.body()`/`resp.header(n)`). These carry `recv_type == Some(HTTPRequest|
//RS /// HTTPResponse)`; now that the lambda-param type is written back onto `p.ty`
//RS /// (sema), the slot type is total and the handle-op shape selects correctly. The
//RS /// emit (`(recv).<field>.clone()`, `(recv).headers.get(&a0).cloned()`,
//RS /// `jet_http_request_param(&(recv), &(a0))`) reproduces `emit_builtin_method`
//RS /// byte-for-byte. `handle` is a typed free function (the example form); it routes.
