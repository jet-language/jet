//RS     address :: prep { mem.address_of(cell_value) }
//RS     print(address)
//RS }
//RS ";
//RS     let diags = jet::compile(src).expect_err("@ mem.address_of must not silently fold");
//RS     assert!(
//RS         diags.iter().any(|d| d.code == "E0956"),
//RS         "expected E0956 (can't run at compile time), got: {diags:?}"
//RS     );
//RS }
