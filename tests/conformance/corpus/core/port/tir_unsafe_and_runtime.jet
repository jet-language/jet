// TIR unsafe and runtime integration tests; assertions live in the paired Tests file.
// Rust: tests/tir_unsafe_and_runtime.rs:1
use std.fs as fs
use std.env as env
use std.process as process
use tests.tir_support.[assert_tiers_agree, assert_tiers_agree_with_application_policy, build_and_run, build_and_run_full, have_rustc, write_test_package, TIR_TEST_PACKAGE]
use tests.common as common
use jet.[Loader, Sema, Diagnostics]

// Rust: tests/tir_unsafe_and_runtime.rs:15
pub const FROM_ADDR_SOURCE: String = ``
use core.mem as _mem

fn run() -> {
    value :: 7
    #Unsafe("value is live on this stack frame and the pointer never escapes") {
        addr :: _mem.address_of(value)
        result :: _mem.Ptr<Int>.from_addr(addr)
        print(result.*)
    }
}
``

// Rust: tests/tir_unsafe_and_runtime.rs:851
pub fn assert_task_tier_parity(name: String, src: String, expected_stdout: String) -> {
    (code, stdout) :: build_and_run(name, src)
    assert_eq(code, 0)
    assert_eq(stdout, expected_stdout)
    // GATE #4494: native fixture staging; retired JIT trace becomes actual tier execution.
    dir :: env.temp_dir().join("jet_{name}_parity_{process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("task bundle should load")
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(diagnostic -> diagnostic.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "task program must type-check: {errors}")
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(&bundle, tier).expect("task program must execute")
        assert_eq(result.exit_code, code, "{tier} exit drift: stdout={result.stdout} stderr={result.stderr}")
        assert_eq(result.stderr, "", "{tier} stderr drift: stdout={result.stdout}")
        assert_eq(result.stdout, stdout, "{tier} ordered output drift")
    }
}

// Rust: tests/tir_unsafe_and_runtime.rs:915
pub fn assert_named_task_tier_parity(name: String, src: String, expected_stdout: String) -> {
    (aot_code, aot_stdout) :: build_and_run(name, src)
    assert_eq(aot_code, 0)
    assert_eq(aot_stdout, expected_stdout)
    // GATE #4494; the named carrier is checked by behavior, not retired deopt flags.
    dir :: env.temp_dir().join("jet_{name}_parity_{process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("named task bundle should load")
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(diagnostic -> diagnostic.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "named task program must type-check: {errors}")
    for tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(&bundle, tier).expect("named task program must execute")
        assert_eq(result.exit_code, aot_code, "named task {tier} exit drift")
        assert_eq(result.stdout, aot_stdout, "named task {tier} stdout drift")
        assert_eq(result.stderr, "", "named task {tier} stderr drift")
    }
}

