// Rust: tests/task_control_tiers.rs:390
#Test("explicit_group_limit_matches_aot_jit_and_interpreter") {
    loop limit in [I64{1}, I64{0}, I64{-3}] {
        source :: control.limit_source(limit)
        expected :: "2\n3\n"
        if have_rustc() {
            (aot_code, aot_stdout) :: build_and_run("task_group_limit_{limit}", source)
            assert_eq(aot_code, 0)
            assert_eq(aot_stdout, expected)
        }
        (code, stdout, stderr) :: run_default_multi("task_group_limit_{limit}", "main.jet", [("main.jet", source)])
        assert_eq(code, 0, "{stderr}")
        assert_eq(stdout, expected, "default tier drifted for limit {limit}: {stderr}")
        (bundle, dir) :: control.checked_task_bundle_for("limit_{limit}", source)
        loop tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
            result :: common.execute_bundle(&bundle, tier).expect("task group limit must execute")
            assert_eq((result.exit_code, result.stdout, result.stderr), (0, expected, ""))
        }
        _ :: fs.remove_dir_all(dir)
        interpreted :: control.run_forced_interpreter("limit_{limit}", source)
        assert_eq(interpreted, expected, "forced interpreter drifted for limit {limit}")
    }
}
// Rust: tests/task_control_tiers.rs:422
#Test("task_combinators_cancel_losers_on_every_tier") {
    expected :: "1\n1\n1\n1\n"
    interpreted :: control.run_forced_interpreter("loser_cleanup", control.LOSER_CLEANUP_SOURCE)
    assert_eq(interpreted, expected)
    (code, stdout, stderr) :: run_default_multi("task_loser_cleanup", "main.jet", [("main.jet", control.LOSER_CLEANUP_SOURCE)])
    assert_eq(code, 0, "default tier: {stderr}")
    assert_eq(stdout, expected, "default tier output drifted: {stderr}")
    (bundle, dir) :: control.checked_task_bundle_for("loser_cleanup", control.LOSER_CLEANUP_SOURCE)
    loop tier in [common.ExecutionTier.O0, common.ExecutionTier.O1, common.ExecutionTier.O2, common.ExecutionTier.Web] {
        result :: common.execute_bundle(&bundle, tier).expect("loser cleanup must execute")
        assert_eq((result.exit_code, result.stdout, result.stderr), (0, expected, ""))
    }
    _ :: fs.remove_dir_all(dir)
    if have_rustc() {
        (code, stdout) :: build_and_run("task_loser_cleanup", control.LOSER_CLEANUP_SOURCE)
        assert_eq(code, 0)
        assert_eq(stdout, expected)
    }
}
