// Rust: tests/record_conformance.rs:310
#Test("jet_record_codec_and_package_keys_match_rust_bytes") {
    repo :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    program := ""
    loop source in records.JET_SOURCES {
        program.push_str(fs.read_to_string(repo.join(source)).expect("read Jet codec source"))
        program.push('\n')
    }
    program.push_str(records.JET_HARNESS)
    program.push_str("\nfn run() {\n")
    expected := []
    loop (schema, sections) in records.record_fixtures() {
        program.push_str("    conformance_encode({records.jet_string(schema)}, {records.jet_sections(&sections)})\n")
        bytes :: encode_record(schema, &sections).expect("fixture encodes")
        expected.push("encode {records.hex(bytes)}")
    }
    loop bytes in records.decode_fixtures() {
        program.push_str("    conformance_decode({records.jet_bytes(&bytes)})\n")
        expected.push(records.rust_decode_line(&bytes))
    }
    loop (index, fixture) in records.key_fixtures().iter().enumerate() {
        files :: fixture.files.iter().map(|(path, source)| -> "PackageKeySourceFile{{relative_path: {records.jet_string(path)}, source: {records.jet_string(source)}}}").collect().join(", ")
        manifest :: fixture.manifest.map_or("None", |text| -> "Val({records.jet_string(text)})")
        facts :: fixture.facts.iter().map(|(name, value)| -> "PackageKeyTargetFact{{name: {records.jet_string(name)}, value: {records.jet_string(value)}}}").collect().join(", ")
        dependencies :: fixture.dependencies.iter().map(|(identity, digest)| -> "PackageKeyDependency{{identity: {records.jet_string(identity)}, interface_digest: {records.jet_string(digest)}}}").collect().join(", ")
        program.push_str("    source_{index} :: package_key_source_digest([PackageKeySourceFile]{{{files}}}, {manifest})\n")
        program.push_str("    facts_{index} :: package_key_target_facts_digest([PackageKeyTargetFact]{{{facts}}})\n")
        program.push_str("    key_{index} :: package_key_check_key({records.jet_string(fixture.compiler)}, facts_{index}, {records.jet_string(fixture.package)}, source_{index}, [PackageKeyDependency]{{{dependencies}}})\n")
        program.push_str("    print(\"keys {{source_{index}}} {{facts_{index}}} {{key_{index}}}\")\n")
        source_files :: fixture.files.iter().map(|(path, source)| -> (path.to_string(), source.as_bytes())).collect()
        source :: source_digest(&source_files, fixture.manifest.map(|text| -> text.as_bytes()))
        target_facts :: target_facts_digest(fixture.facts.iter().map(|(name, value)| -> (name.to_string(), value.to_string())).collect())
        key :: package_check_key(fixture.compiler, &target_facts, fixture.package, &source, fixture.dependencies.iter().map(|(identity, digest)| -> (identity.to_string(), digest.to_string())).collect())
        expected.push("keys {source} {target_facts} {key}")
    }
    program.push_str("}\n")
    scratch :: common.Scratch.new("record-conformance")
    fs.write(scratch.join("main.jet"), &program).expect("write conformance program")
    output :: process.Command.new(env.var_os("CARGO_BIN_EXE_jet").unwrap()).args(["run", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join("store")).env("NO_COLOR", "1").output().expect("run the Jet record codec")
    stdout :: String.from_utf8_lossy(&output.stdout)
    assert(output.status.success(), "Jet record codec failed\nstdout:\n{stdout}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
    actual :: stdout.lines().map(|line| -> line.to_string()).collect()
    assert_eq(actual.len(), expected.len(), "Jet printed a different number of lines:\n{stdout}")
    loop (index, (actual, expected)) in actual.iter().zip(&expected).enumerate() {
        assert_eq(actual, expected, "line {index} differs between the Jet and Rust codecs")
    }
}
