    tiers.assert_tiers_agree("exact_int_power", `FOLDED :: prep { 2 ^ 200 }
fn show_exact(value: Int) { print(value) }
fn raise(base: Int, exponent: Int) -> Int { return base ^ exponent }
fn run() {
    show_exact(raise(2, 200))
    show_exact(FOLDED)
}`, "1606938044258990275541962092341162602522202993782792835301376\n1606938044258990275541962092341162602522202993782792835301376\n")
}

// Rust: tests/power_and_exclusive_or.rs:142
#Test("power_assign_raises_in_place") {
    (code, out) :: tiers.build_and_run("power_assign", `fn run() {
    growth := 2
    growth ^= 10
    print(growth)
    price := 1.5
    price ^= 2.0
    print(price)
}`)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "1024\n2.25\n", "{out}")
}

// Rust: tests/power_and_exclusive_or.rs:163
#Test("exclusive_or_uses_the_tilde_pipe_spelling") {
    (code, out) :: tiers.build_and_run("exclusive_or", `fn run() {
    print(12 ~| 10)
    acc := 0
    loop byte in [17, 42, 99, 8] { acc ~|= byte }
    print(acc)
}`)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "6\n80\n", "{out}")
}

// Rust: tests/power_and_exclusive_or.rs:182
#Test("exclusive_or_needs_matching_integer_widths") {
    assert(accepts("xor_same_width", "fn run() {\n    a :: U8{12}\n    b :: U8{10}\n    print(a ~| b)\n}\n"))
    mixed :: diagnostic_codes("xor_mixed_width", "fn run() {\n    a :: U8{12}\n    b :: I8{10}\n    print(a ~| b)\n}\n")
    assert(mixed.iter().any(|code| -> code == "E0109"), "mixed widths must report E0109, got {mixed.debug()}")
    floats :: diagnostic_codes("xor_floats", "fn run() {\n    print(1.5 ~| 2.5)\n}\n")
    assert(floats.iter().any(|code| -> code == "E0109"), "exclusive-or on floats must report E0109, got {floats.debug()}")
}

// Rust: tests/power_and_exclusive_or.rs:207
#Test("prefix_take_and_copy_survive_the_rebind") {
    (code, out) :: tiers.build_and_run("prefix_sigils", `struct Sword { power: Int }
fn melt(item: ^Sword) -> Int { return item.power }
fn run() {
    blade :: Sword{ power: 3 }
    print(melt(^blade))
    flags :: 12
    source :: 5
    print(flags ~| ~source)
    print(flags ^ 2)
}`)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "3\n9\n144\n", "{out}")
}

