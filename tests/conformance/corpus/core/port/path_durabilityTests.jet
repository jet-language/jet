// Rust: tests/path_durability.rs:14
#Test("normalize_is_lexical_rooted_and_platform_native") {
    windows :: target.selected_os() == "windows"
    absolute :: if windows { "C:/../../alpha/../beta" } else { "/../../alpha/../beta" }
    root :: if windows { "C:/" } else { "/" }
    windows_cases :: if windows { `
    print(Path.from("C:../../leaf").normalize().to_string())
    print(Path.from("//server/share/../../leaf").normalize().to_string())` } else { "" }
    src :: "fn run() {{\n    print(Path.from(\"../../alpha/./beta/../gamma\").normalize().to_string())\n    print(Path.from(\"{absolute}\").normalize().to_string())\n    print(Path.from(\"\").normalize().to_string())\n    print(Path.from(\"{root}\").normalize().to_string()){windows_cases}\n}}\n"
    (code, stdout, stderr) :: common.build_and_run("jet_path_durability", "normalize", &src)
    assert_eq(code, 0, "generated program failed: {stderr}")
    sep :: if windows { "\\" } else { "/" }
    expected := ["..{sep}..{sep}alpha{sep}gamma", if windows { "C:{sep}beta" } else { "{sep}beta" }, "", if windows { "C:{sep}" } else { sep }]
    if windows {
        expected.push("C:..{sep}..{sep}leaf")
        expected.push("\\\\server{sep}share{sep}leaf")
    }
    assert_eq(stdout, "{expected.join("\n")}\n")
}

// Rust: tests/path_durability.rs:69
#Test("generated_normalizer_uses_platform_components") {
    // Retired generated-Rust structure checks become lexical behavior across tiers.
    tiers.assert_tiers_agree("normalize_components", `fn run() { print(Path.from("a/../b").normalize().to_string()) }`, "b\n")
}

// Rust: tests/path_durability.rs:79
#Test("generated_atomic_write_has_durable_replace_contract") {
    // The native provider owns create-new/write-all/sync/Drop/parent-sync and
    // Windows ReplaceFileW/MoveFileExW; exercise the public atomic contract.
    src :: `use core.files as fs
fn run() {
    bytes :: [U8]{ 1, 2, 3 }
    fs.write_atomic("atomic.bin", bytes) ?? panic("atomic write failed")
    actual :: fs.read_bytes("atomic.bin") ?? panic("atomic read failed")
    if actual != bytes { panic("atomic payload changed") }
    fs.remove("atomic.bin") ?? panic("atomic cleanup failed")
}`
    (code, _, stderr) :: common.build_and_run_in_scratch("jet_path_durability", "atomic_contract", src)
    assert_eq(code, 0, "atomic-write contract failed: {stderr}")
}

// Rust: tests/path_durability.rs:110
#Test("relative_atomic_write_syncs_the_current_directory_and_reports_success") {
    src :: `use core.files as fs
fn run() {
    bytes :: [U8]{ 110, 101, 119 }
    fs.write_atomic("relative.bin", bytes) ?? panic("relative atomic write failed")
    written :: fs.read("relative.bin") ?? panic("relative read failed")
    fs.remove("relative.bin") ?? panic("relative cleanup failed")
    print(written)
}`
    (code, stdout, stderr) :: common.build_and_run_in_scratch("jet_path_durability", "atomic_relative", src)
    assert_eq(code, 0, "relative atomic write failed: {stderr}")
    assert_eq(stdout, "new\n")
}

// Rust: tests/path_durability.rs:133
#Test("windows_atomic_replace_rejects_embedded_nul_without_touching_prefix_target") {
    if target.selected_os() == "windows" {
        root :: env.temp_dir().join("jet-path-nul-{process.id()}")
        _ :: fs.remove_dir_all(&root)
        fs.create_dir_all(&root).unwrap()
        destination :: root.join("prefix-target.bin")
        temp :: root.join("temp.bin")
        fs.write(&destination, b"old").unwrap()
        fs.write(&temp, b"new").unwrap()
        invalid :: |path: OSPath| -> {
            units := path.as_os_str().encode_wide().collect()
            units.push(0)
            units.extend("suffix".encode_utf16())
            OSPath.from_wide(&units)
        }
        // GATE #4494 native Windows held replacement, no generated Rust callback.
        target_error :: jet_atomic_windows.replace(&temp, &invalid(destination)).unwrap_err()
        assert_eq(target_error.kind(), std.io.ErrorKind.InvalidInput)
        assert_eq(fs.read(&destination).unwrap(), b"old")
        temp_error :: jet_atomic_windows.replace(&invalid(temp), &destination).unwrap_err()
        assert_eq(temp_error.kind(), std.io.ErrorKind.InvalidInput)
        assert_eq(fs.read(&destination).unwrap(), b"old")
        _ :: fs.remove_dir_all(root)
    }
}

// Rust: tests/path_durability.rs:210
#Test("atomic_write_retries_collision_replaces_and_cleans_failed_temp") {
    root :: unique_dir("hostile")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    destination :: root.join("target.bin")
    blocked :: root.join("blocked")
    fs.create_dir(&blocked).unwrap()
    fs.write(&destination, b"old").unwrap()
    if target.selected_family() == "unix" {
        fs.set_permissions(&destination, fs.Permissions.from_mode(0o640)).unwrap()
    }
    src :: "use core.files as fs\nuse core.sys as os\nfn run() {{\n    root :: \"{jet_string(&root)}\"\n    stale :: Path.from(root).join(\".jet_tmp_{{os.pid()}}_0\")\n    fs.write(stale, \"stale\") ?? panic(\"stale setup failed\")\n    bytes :: [U8]{{ 110, 101, 119 }}\n    fs.write_atomic(\"{jet_string(&destination)}\", bytes) ?? panic(\"replacement failed\")\n    fs.write_atomic(\"{jet_string(&blocked)}\", bytes) ?? panic(\"expected replacement failure\")\n}}\n"
    (code, _, _) :: common.build_and_run("jet_path_durability", "atomic_hostile", &src)
    assert_eq(code, 70, "directory replacement must fail through Jet panic")
    assert_eq(fs.read(&destination).unwrap(), b"new")
    if target.selected_family() == "unix" {
        assert_eq(fs.metadata(&destination).unwrap().permissions().mode() & 0o777, 0o640)
    }
    debris :: fs.read_dir(&root).unwrap().filter_map(|entry| -> entry.ok()).filter(|entry| -> entry.file_name().to_string_lossy().starts_with(".jet_tmp_")).collect()
    assert_eq(debris.len(), 1, "only the forced stale collision may remain")
    assert_eq(fs.read(debris[0].path()).unwrap(), b"stale")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/path_durability.rs:273
#Test("concurrent_atomic_writers_leave_one_whole_payload") {
    root :: unique_dir("concurrent")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    destination :: root.join("target.bin")
    fs.write(&destination, b"old").unwrap()
    a :: [65; 257] as [UInt8]
    b :: [66; 263] as [UInt8]
    a_text :: "A".repeat(a.len())
    b_text :: "B".repeat(b.len())
    list :: |bytes: [UInt8]| -> bytes.iter().map(|byte| -> byte.to_string()).collect().join(", ")
    src :: "use core.files as fs\nfn write_a() -[IO]> Int {{\n    bytes :: [U8]{{ {list(a)} }}\n    loop _ in 1..25 {{ fs.write_atomic(\"{jet_string(&destination)}\", bytes) ?? panic(\"writer a failed\") }}\n    return 1\n}}\nfn write_b() -[IO]> Int {{\n    bytes :: [U8]{{ {list(b)} }}\n    loop _ in 1..25 {{ fs.write_atomic(\"{jet_string(&destination)}\", bytes) ?? panic(\"writer b failed\") }}\n    return 2\n}}\nfn observe() -[IO]> Int {{\n    loop _ in 1..100 {{\n        value :: fs.read(\"{jet_string(&destination)}\") ?? panic(\"observer read failed\")\n        if value != \"old\" && value != \"{a_text}\" && value != \"{b_text}\" {{ panic(\"observer saw torn atomic-write payload\") }}\n    }}\n    return 3\n}}\nfn run() {{\n    task.group g {{\n        a :: task write_a()\n        b :: task write_b()\n        observer :: task observe()\n    }}\n}}\n"
    (code, _, stderr) :: common.build_and_run("jet_path_durability", "atomic_concurrent", &src)
    assert_eq(code, 0, "concurrent atomic writers failed: {stderr}")
    final_bytes :: fs.read(&destination).unwrap()
    assert(final_bytes == a or final_bytes == b, "observed torn atomic-write payload")
    debris :: fs.read_dir(&root).unwrap().filter_map(|entry| -> entry.ok()).any(|entry| -> entry.file_name().to_string_lossy().starts_with(".jet_tmp_"))
    assert(not debris, "successful concurrent writes left temporary debris")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/power_and_exclusive_or.rs:47
#Test("power_groups_right_and_beats_unary_minus") {
    (code, out) :: tiers.build_and_run("power_grouping", `fn run() {
    print(2 ^ 3 ^ 2)
    print((2 ^ 3) ^ 2)
    print(-3 ^ 2)
    print((-3) ^ 2)
    print(2 * 3 ^ 2)
    print(2 ^ 3 * 2)
}`)
    assert_eq(code, 0, "{out}")
    assert_eq(out, "512\n64\n-9\n9\n18\n16\n", "{out}")
}

// Rust: tests/power_and_exclusive_or.rs:70
#Test("power_result_types_follow_the_operands") {
    assert(accepts("int_pow", "{WANT}fn run() {{\n    want_int(2 ^ 10)\n}}\n"))
    assert(accepts("neg_pow_fraction", "{WANT}fn run() {{\n    print((2 ^ -1).numerator())\n}}\n"))
    assert(not diagnostic_codes("neg_pow_float", "{WANT}fn run() {{\n    want_float(2 ^ -1)\n}}\n").is_empty(), "a written negative exponent must not infer an approximate Float")
    assert(not diagnostic_codes("neg_pow_int", "{WANT}fn run() {{\n    want_int(2 ^ -1)\n}}\n").is_empty(), "a negative exponent must not infer a whole number")
    assert(accepts("float_operand", "{WANT}fn run() {{\n    want_float(Float{{2.0}} ^ 10)\n}}\n"))
    assert(not diagnostic_codes("float_operand_int", "{WANT}fn run() {{\n    want_int(Float{{2.0}} ^ 10)\n}}\n").is_empty(), "a Float operand must not infer a whole number")
}

