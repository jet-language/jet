    cert :: include_str("../tests/fixtures/tls/localhost.cert.pem").to_string()
    key :: include_str("../tests/fixtures/tls/localhost.key.pem").to_string()
    server :: jet_http_server_bind_tls("127.0.0.1:0", mux, JetHTTPServerTls{cert_pem: cert, key_pem: key},
        (cert, key) -> http_server_tls_runtime.jet_http_server_tls_validate_impl(cert, key),
        (cert, key, stream, on_request, on_h2, should_stop) -> http_server_tls_runtime.jet_http_server_tls_session_impl(cert, key, stream, on_request, on_h2, should_stop)
    ).expect("bind rustls h2")
    addr: SocketAddr :: jet_http_server_local_addr(server).expect("addr").parse().expect("parse")
    serving :: server.clone()
    serve :: thread.spawn(() -> jet_http_server_serve(serving))
    // Two concurrent streams share one negotiated TLS connection.
    client := rustls_fixture_client_with_alpn(addr, ["h2".as_bytes()])
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/trailers"))).unwrap()
    client.write_all(h2_frame(1, 0x5, 3, h2_request_headers(0x82, "/fast"))).unwrap()
    client.write_all(h2_frame(0, 0, 1, "body".as_bytes())).unwrap()
    request_trailers := h2_literal_named_header("x-trace", "one")
    request_trailers.extend_from_slice(h2_literal_named_header("x-trace", "two"))
    client.write_all(h2_frame(1, 0x5, 1, request_trailers)).unwrap()
    client.flush().unwrap()
    assert_eq(client.conn.alpn_protocol(), Val("h2".as_bytes()))
    stream_one_body: [U8] := []
    stream_one_trailers: [(String, String)] := []
    stream_one_done := false
    stream_three_body: [U8] := []
    stream_three_done := false
    decoder := JetHTTP2Hpack.new()
    loop !stream_one_done || !stream_three_done {
        frame :: jet_http2_read_frame(&client).unwrap()
        if frame.stream == 1 && frame.kind == 0 {
            stream_one_body.extend_from_slice(frame.payload)
            assert_eq(frame.flags & 0x1, 0, "TLS H2 DATA ended before trailers")
        } else if frame.stream == 1 && frame.kind == 1 {
            headers :: jet_http2_decode_headers(&decoder, frame.payload).unwrap()
            if frame.flags & 0x1 != 0 {
                stream_one_trailers = ^headers
                stream_one_done = true
            }
        } else if frame.stream == 3 && frame.kind == 0 {
            stream_three_body.extend_from_slice(frame.payload)
            stream_three_done = frame.flags & 0x1 != 0
        }
    }
    assert_eq(stream_one_body, "tls-h2:body".as_bytes())
    assert_eq(stream_three_body, "fast".as_bytes())
    assert_eq(stream_one_trailers.into_iter().filter_map((name, value) -> if name == "x-trace" { Val(^value) } else { None }).collect(), ["first", "second"])
    assert_eq(calls.load(Ordering.Acquire), 2)
    client.write_all(h2_frame(7, 0, 0, [U8]{0}.repeat(8))).unwrap()
    client.flush().unwrap()
    drop(^client)
    // An oversized frame on a second TLS connection closes before handler completion.
    bounded := rustls_fixture_client_with_alpn(addr, ["h2".as_bytes()])
    bounded.write_all(JET_HTTP2_PREFACE).unwrap()
    bounded.write_all(h2_frame(4, 0, 0, [])).unwrap()
    bounded.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/trailers"))).unwrap()
    bounded.write_all(h2_frame(0, 0, 1, [U8]{0}.repeat(JET_HTTP2_MAX_FRAME + 1))).unwrap()
    bounded.flush().unwrap()
    assert_eq(bounded.conn.alpn_protocol(), Val("h2".as_bytes()))
    bounded_goaway := false
    bounded_closed := false
    for _ in 0..4 {
        match jet_http2_read_frame(&bounded) {
            Ok(frame) if frame.kind == 7 -> {
                bounded_goaway = true
                assert_eq(frame.payload[..4], U32{1}.to_be_bytes())
                assert_eq(frame.payload[4..8], U32{1}.to_be_bytes())
            }
            Ok(_) -> {}
            Err(_) -> { bounded_closed = true; break }
        }
    }
    assert(bounded_goaway, "oversized TLS H2 frame omitted protocol GOAWAY")
    assert(bounded_closed, "oversized TLS H2 frame did not close the connection")
    assert_eq(calls.load(Ordering.Acquire), 2, "bounded request completed a handler")
    // An open request proves shutdown sends GOAWAY and respects its grace.
    draining := rustls_fixture_client_with_alpn(addr, ["h2".as_bytes()])
    draining.write_all(JET_HTTP2_PREFACE).unwrap()
    draining.write_all(h2_frame(4, 0, 0, [])).unwrap()
    draining.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/trailers"))).unwrap()
    draining.write_all(h2_frame(0, 0, 1, "partial".as_bytes())).unwrap()
    draining.flush().unwrap()
    assert_eq(draining.conn.alpn_protocol(), Val("h2".as_bytes()))
    loop {
        frame :: jet_http2_read_frame(&draining).unwrap()
        if frame.kind == 4 && frame.stream == 0 { break }
    }
    started :: Instant.now()
    report :: jet_http_server_shutdown(server, jet_std.Duration{ms: 40}).expect("shutdown")
    assert(started.elapsed() < Duration.from_millis(1500), "{report:?}")
    saw_goaway := false
    loop {
        result :: jet_http2_read_frame(&draining)
        if result.is_err() { break }
        frame :: result.unwrap()
        if frame.kind == 7 {
            saw_goaway = true
            assert_eq(frame.payload[..4], U32{1}.to_be_bytes())
            break
        }
    }
    assert(saw_goaway, "TLS H2 shutdown omitted GOAWAY")
    assert_eq(report.user_accepted, 3, "{report:?}")
    assert_eq(report.user_completed + report.user_cancelled, report.user_accepted, "{report:?}")
    assert_eq(calls.load(Ordering.Acquire), 2, "partial request completed during shutdown")
    _ :: serve.join().expect("serve join")
}

// Rust: tests/http_server_lifecycle.rs:7146
#Test("builtin_middleware_timeout_body_limit_cors_compress_and_access_log") {
    HTTP_ACCESS_LOG_LINES.get_or_init(() -> Mutex.new([])).lock().unwrap().clear()
    slow :: jet_http_mw_timeout(jet_std.Duration{ms: 30}, Arc.new(_ -> {
        thread.sleep(Duration.from_millis(120))
        Ok(jet_http_srv_response(200, "slow"))
    }))
    timed :: slow(JetHTTPRequest.server("GET", "/slow", [], JetHTTPHeaders.new()))
    assert_eq(timed.unwrap().status, 504)
    limited :: jet_http_mw_body_limit(4, Arc.new(_ -> Ok(jet_http_srv_response(200, "ok"))))
    big := JetHTTPRequest.server("POST", "/", [U8]{0}.repeat(8), JetHTTPHeaders.new())
    big.body = JetHTTPBody.from_bytes([U8]{0}.repeat(8))
    assert(matches(limited(^big), Err(JetHTTPError.BodyTooLarge{limit: 4})))
    policy :: jet_http_cors_policy(JetHTTPCorsOrigins.List(["https://app.example"]), [], [], false, 86_400).unwrap()
    cors :: jet_http_mw_cors(policy, Arc.new(_ -> Ok(jet_http_srv_response(200, "ok"))))
    preflight_headers := JetHTTPHeaders.new()
    preflight_headers.append("origin", "https://app.example").unwrap()
    preflight_headers.append("access-control-request-method", "POST").unwrap()
    preflight :: cors(JetHTTPRequest.server("OPTIONS", "/api", [], ^preflight_headers)).unwrap()
    assert_eq(preflight.status, 204)
    assert_eq(preflight.headers.get("access-control-allow-origin"), Val("https://app.example"))
    compress :: jet_http_mw_compress(JetHTTPCompressEncoding.Gzip, Arc.new(_ -> Ok(jet_http_srv_response(200, "compressible"))))
    gzip_headers := JetHTTPHeaders.new()
    gzip_headers.append("accept-encoding", "gzip").unwrap()
    gzip :: compress(JetHTTPRequest.server("GET", "/", [], ^gzip_headers)).unwrap()
    assert_eq(gzip.headers.get("content-encoding"), Val("gzip"))
    assert(gzip.body.bytes(64).unwrap().starts_with([0x1f, 0x8b]))
    logged :: jet_http_mw_access_log(Arc.new(_ -> Ok(jet_http_srv_response(201, "x"))))
    req := JetHTTPRequest.server("GET", "/logs/1", [], JetHTTPHeaders.new())
    req.route_template = Val("/logs/:id")
    assert_eq(logged(^req).unwrap().status, 201)
    lines :: HTTP_ACCESS_LOG_LINES.get().unwrap().lock().unwrap()
    assert_eq(lines.len(), 1)
    assert(lines[0].contains("route=/logs/:id"))
    assert(lines[0].contains("status=201"))
    assert(!lines[0].contains("secret"))
}

// Rust: tests/http_server_lifecycle.rs:7241
#Test("static_files_handler_serves_root_index_and_rejects_traversal") {
    root :: env.temp_dir().join("jet-http-static-handler-{process.id()}-{SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}")
    fs.create_dir_all(root.join("nested")).unwrap()
    fs.write(root.join("index.html"), "index".as_bytes()).unwrap()
    fs.write(root.join("nested/data.bin"), [U8]{1, 2, 3}).unwrap()
    handler :: jet_http_srv_static_files_handler("", root.to_string_lossy().into_owned(), JetHTTPStaticOptions.safe())
    ok :: handler(JetHTTPRequest.server("GET", "/nested/data.bin", [], JetHTTPHeaders.new())).unwrap()
    assert_eq(ok.status, 200)
    assert_eq(ok.body.bytes(16).unwrap(), [U8]{1, 2, 3})
    index :: handler(JetHTTPRequest.server("GET", "/", [], JetHTTPHeaders.new())).unwrap()
    assert_eq(index.body.bytes(16).unwrap(), "index".as_bytes())
    blocked :: handler(JetHTTPRequest.server("GET", "/../secret", [], JetHTTPHeaders.new())).unwrap()
    assert_eq(blocked.status, 404)
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/http_server_lifecycle.rs:7289
// D-HTTP-STATIC-FILES1=A: defaults refuse hostile paths; expert options open exactly one.
#Test("static_files_mount_refuses_escapes_dotfiles_and_link_escapes") {
    base :: env.temp_dir().join("jet-http-static-hostile-{process.id()}-{SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}")
    root :: base.join("public")
    fs.create_dir_all(root.join("nested")).unwrap()
    fs.write(base.join("secret.txt"), "outside".as_bytes()).unwrap()
    fs.write(root.join("index.html"), "index".as_bytes()).unwrap()
    fs.write(root.join(".env"), "TOKEN=private".as_bytes()).unwrap()
    fs.write(root.join("nested/app.css"), "body{}".as_bytes()).unwrap()
    if target.selected_family() == "unix" {
        std.os.unix.fs.symlink(base.join("secret.txt"), root.join("escape.txt")).unwrap()
        std.os.unix.fs.symlink(root.join("nested/app.css"), root.join("inside.css")).unwrap()
    }
    get :: (path: String) -> JetHTTPRequest.server("GET", path.to_string(), [], JetHTTPHeaders.new())
    serve :: (path: String, options: JetHTTPStaticOptions) -> jet_http_srv_static_files(get(path), "/assets", root, options).unwrap()
    safe :: JetHTTPStaticOptions.safe()
    assert_eq(serve("/assets/nested/app.css", safe).status, 200)
    assert_eq(serve("/assets/", safe).body.bytes(64).unwrap(), "index".as_bytes())
    assert_eq(serve("/nested/app.css", safe).status, 404)
    assert_eq(serve("/assetsother/app.css", safe).status, 404)
    assert_eq(serve("/assets/../secret.txt", safe).status, 404)
    assert_eq(serve("/assets/nested/../../secret.txt", safe).status, 404)
    assert_eq(serve("/assets/%2e%2e/secret.txt", safe).status, 404)
    assert_eq(serve("/assets/%2fsecret.txt", safe).status, 404)
    assert_eq(serve("/assets/.env", safe).status, 404)
    dotfiles := safe
    dotfiles.dotfiles = true
    assert_eq(serve("/assets/.env", dotfiles).status, 200)
    if target.selected_family() == "unix" {
        assert_eq(serve("/assets/escape.txt", safe).status, 404)
        assert_eq(serve("/assets/inside.css", safe).status, 404)
        links := safe
        links.follow_links = true
        assert_eq(serve("/assets/escape.txt", links).status, 404)
        assert_eq(serve("/assets/inside.css", links).status, 200)
    }
    no_index := safe
    no_index.index = false
    assert_eq(serve("/assets/", no_index).status, 404)
    mux :: jet_http_mux_new()
    jet_http_srv_static_files_mount(mux, "/assets", root.to_string_lossy().into_owned(), safe)
    served :: jet_http_mux_dispatch(mux, get("/assets/nested/app.css")).unwrap()
    assert_eq(served.status, 200)
    assert_eq(served.headers.get("content-type"), Val("text/css; charset=utf-8"))
    head :: jet_http_mux_dispatch(mux, JetHTTPRequest.server("HEAD", "/assets/nested/app.css", [], JetHTTPHeaders.new())).unwrap()
    assert_eq(head.status, 200)
    assert_eq(jet_http_mux_dispatch(mux, get("/assets/.env")).unwrap().status, 404)
    fs.remove_dir_all(base).unwrap()
}

// Rust: tests/http_server_lifecycle.rs:7397
// D-HTTP-CORS1=A: absent policy adds no headers; credentialed Any is refused.
#Test("cors_policy_rejects_any_origin_with_credentials_and_stamps_named_origins") {
    refused :: jet_http_cors_policy(JetHTTPCorsOrigins.Any, [], [], true, 86_400)
    reason :: match refused {
        Err(JetHTTPError.Policy{reason}) -> ^reason
        _ -> panic("`.Any` origins with credentials must be refused")
    }
    assert(reason.contains("CORS credentials need named origins"))
    assert(reason.contains("set credentials to false"))
    bare :: jet_http_mux_new()
    jet_http_mux_add(bare, "GET", "/api", _ -> jet_http_srv_response(200, "ok"))
    origin_headers := JetHTTPHeaders.new()
    origin_headers.append("origin", "https://app.example").unwrap()
    plain :: jet_http_mux_dispatch(bare, JetHTTPRequest.server("GET", "/api", [], origin_headers.clone())).unwrap()
    assert_eq(plain.headers.get("access-control-allow-origin"), None)
    policy :: jet_http_cors_policy(JetHTTPCorsOrigins.List(["https://app.example"]), ["GET", "POST"], ["content-type"], true, 600).unwrap()
    mux :: jet_http_mux_new()
    jet_http_srv_install_cors(mux, policy)
    jet_http_mux_add(mux, "GET", "/api", _ -> {
        response := jet_http_srv_response(200, "ok")
        _ :: response.headers.set("vary", "accept-encoding")
        response
    })
    preflight_headers := origin_headers.clone()
    preflight_headers.append("access-control-request-method", "POST").unwrap()
    preflight :: jet_http_mux_dispatch(mux, JetHTTPRequest.server("OPTIONS", "/api", [], ^preflight_headers)).unwrap()
    assert_eq(preflight.status, 204)
    assert_eq(preflight.headers.get("access-control-allow-origin"), Val("https://app.example"))
    assert_eq(preflight.headers.get("access-control-allow-methods"), Val("GET, POST"))
    assert_eq(preflight.headers.get("access-control-allow-headers"), Val("content-type"))
    assert_eq(preflight.headers.get("access-control-allow-credentials"), Val("true"))
    assert_eq(preflight.headers.get("access-control-max-age"), Val("600"))
    allowed :: jet_http_mux_dispatch(mux, JetHTTPRequest.server("GET", "/api", [], ^origin_headers)).unwrap()
    assert_eq(allowed.headers.get("access-control-allow-origin"), Val("https://app.example"))
    assert_eq(allowed.headers.get("vary"), Val("accept-encoding, origin"))
    other := JetHTTPHeaders.new()
    other.append("origin", "https://evil.example").unwrap()
    denied :: jet_http_mux_dispatch(mux, JetHTTPRequest.server("GET", "/api", [], ^other)).unwrap()
    assert_eq(denied.status, 200)
    assert_eq(denied.headers.get("access-control-allow-origin"), None)
    any :: jet_http_cors_policy(JetHTTPCorsOrigins.Any, [], [], false, 0).unwrap()
    any_mux :: jet_http_mux_new()
    jet_http_srv_install_cors(any_mux, any)
    jet_http_mux_add(any_mux, "GET", "/api", _ -> jet_http_srv_response(200, "ok"))
    anywhere := JetHTTPHeaders.new()
    anywhere.append("origin", "https://anywhere.example").unwrap()
    wide :: jet_http_mux_dispatch(any_mux, JetHTTPRequest.server("GET", "/api", [], ^anywhere)).unwrap()
    assert_eq(wide.headers.get("access-control-allow-origin"), Val("*"))
}

// Rust: tests/http_server_lifecycle.rs:7530
// D-HTTP-JSON1=A: JSON content type and shared body framing cap.
#Test("server_json_sets_the_content_type_and_the_body_cap_still_holds") {
    response :: jet_http_srv_json(201, "payload")
    assert_eq(response.status, 201)
    assert_eq(response.headers.get("content-type"), Val("application/json; charset=utf-8"))
    assert_eq(response.body.bytes(64).unwrap(), "{\"ok\":true}".as_bytes())
    body :: JetHTTPBody.from_text("{\"a\":1}")
    decoded: String :: jet_http_body_json(body, 64).unwrap()
    assert_eq(decoded, "{\"a\":1}")
    oversized :: JetHTTPBody.from_text("{\"a\":1}")
    assert(matches(jet_http_body_json::<String>(oversized, 2), Err(JetHTTPError.BodyTooLarge{limit: 2})))
}
