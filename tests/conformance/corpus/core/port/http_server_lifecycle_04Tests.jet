#Test("http2_handlers_overlap_reset_drops_queued_data_and_completed_streams_release_capacity") {
    CHILD :: "JET_HTTP2_BLOCKING_BODY_TEST_CHILD"
    if env.var_os(CHILD).is_none() {
        status :: Command.new(env.current_exe().unwrap()).args(["--exact", "http2_handlers_overlap_reset_drops_queued_data_and_completed_streams_release_capacity", "--nocapture"]).env(CHILD, "1").env("JET_SCHEDULER_THREADS", "1").status().expect("spawn isolated HTTP/2 blocking-body test")
        assert(status.success(), "isolated HTTP/2 blocking-body test failed")
        return
    }
    // Rust: tests/http_server_lifecycle.rs:5350
    struct BlockingBody {
        started: mpsc.Sender<()>?
        wake: Arc<(Mutex<Bool>, Condvar)>
        dropped: Arc<AtomicUsize>
    }
    impl BlockingBody.io.Read {
        // Rust: tests/http_server_lifecycle.rs:5357
        fn read(self: &BlockingBody, _output: &[U8]) -> USize io.Error! {
            if self.started.take() == .Val(started) { _ :: started.send(()) }
            (cancelled, wake) :: @self.wake
            guard := cancelled.lock().unwrap()
            loop !*guard { guard = wake.wait(^guard).unwrap() }
            Err(io.Error.from(io.ErrorKind.Interrupted))
        }
    }
    impl BlockingBody.Drop {
        // Rust: tests/http_server_lifecycle.rs:5371
        fn drop(self: &BlockingBody) -> { _ :: self.dropped.fetch_add(1, Ordering.AcqRel) }
    }
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "POST", "/slow-body", request -> {
        body :: request.body.bytes(64).unwrap()
        jet_http_srv_response(200, body.len().to_string())
    })
    jet_http_mux_add(mux, "GET", "/fast", _ -> jet_http_srv_response(200, "fast"))
    jet_http_mux_add(mux, "GET", "/large", _ -> {
        response := jet_http_srv_empty_response(200)
        response.body = JetHTTPBody.from_bytes([U8]{7}.repeat(100_000))
        response
    })
    jet_http_mux_add(mux, "POST", "/ignore", _ -> jet_http_srv_response(200, "ignored"))
    (response_started_tx, response_started_rx) :: mpsc.channel()
    response_wake :: Arc.new((Mutex.new(false), Condvar.new()))
    response_dropped :: Arc.new(AtomicUsize.new(0))
    response_closed :: Arc.new(AtomicUsize.new(0))
    handler_wake :: response_wake.clone()
    handler_dropped :: response_dropped.clone()
    handler_closed :: response_closed.clone()
    jet_http_mux_add(mux, "GET", "/slow-response", _ -> {
        response := jet_http_srv_empty_response(200)
        source_wake :: handler_wake.clone()
        close_wake :: handler_wake.clone()
        close_count :: handler_closed.clone()
        response.body = JetHTTPBody.reader_cancellable(BlockingBody{started: Val(response_started_tx.clone()), wake: source_wake, dropped: handler_dropped.clone()}, Val(4), () -> {
            _ :: close_count.fetch_add(1, Ordering.AcqRel)
            (cancelled, wake) :: @close_wake
            *cancelled.lock().unwrap() = true
            wake.notify_all()
        })
        response
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 1
    options.read_idle_timeout = Duration.from_secs(2)
    server :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, AtomicBool.new(false), None, None))
    client.set_read_timeout(Val(Duration.from_secs(2))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/slow-body"))).unwrap()
    client.write_all(h2_frame(0, 0, 1, "part".as_bytes())).unwrap()
    client.flush().unwrap()
    deadline :: Instant.now() + Duration.from_secs(1)
    loop jet_scheduler_blocking_wait_stats().0 == 0 {
        assert(Instant.now() < deadline, "request Body did not enter a scheduler-aware blocking wait")
        thread.yield_now()
    }
    assert_eq(JET_OBSERVE_WORKERS.load(Ordering.Relaxed), 1)
    client.write_all(h2_frame(1, 0x5, 3, h2_request_headers(0x82, "/fast"))).unwrap()
    client.write_all(h2_frame(6, 0, 0, "12345678".as_bytes())).unwrap()
    client.flush().unwrap()
    fast := false
    ping := false
    loop !fast || !ping {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        fast |= kind == 0 && stream == 3 && payload == "fast".as_bytes()
        ping |= kind == 6 && flags & 1 != 0 && payload == "12345678".as_bytes()
    }
    assert(jet_scheduler_blocking_wait_stats().2 >= 1, "one blocked worker did not receive bounded compensation")
    client.write_all(h2_frame(0, 0x1, 1, "done".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 0 && stream == 1 && payload == "8".as_bytes() { break }
    }
    blocked_response_id :: 5
    client.write_all(h2_frame(1, 0x5, blocked_response_id, h2_request_headers(0x82, "/slow-response"))).unwrap()
    client.flush().unwrap()
    response_started_rx.recv_timeout(Duration.from_secs(1)).expect("response Body producer did not start")
    client.write_all(h2_frame(1, 0x5, 7, h2_request_headers(0x82, "/fast"))).unwrap()
    client.write_all(h2_frame(6, 0, 0, "bodyping".as_bytes())).unwrap()
    client.flush().unwrap()
    fast = false
    ping = false
    loop !fast || !ping {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        fast |= kind == 0 && stream == 7 && payload == "fast".as_bytes()
        ping |= kind == 6 && flags & 1 != 0 && payload == "bodyping".as_bytes()
        assert(!(kind == 0 && stream == blocked_response_id), "blocked response produced DATA before release")
    }
    client.write_all(h2_frame(3, 0, blocked_response_id, U32{8}.to_be_bytes())).unwrap()
    client.flush().unwrap()
    reset_deadline :: Instant.now() + Duration.from_secs(1)
    loop {
        (waits, threads, _) :: jet_scheduler_blocking_wait_stats()
        if response_closed.load(Ordering.Acquire) == 1 && response_dropped.load(Ordering.Acquire) == 1 && waits == 0 && threads == 0 { break }
        assert(Instant.now() < reset_deadline, "RST did not close and drop blocked response source: close={response_closed.load(Ordering.Acquire)} drop={response_dropped.load(Ordering.Acquire)} scheduler={jet_scheduler_blocking_wait_stats().debug()}")
        thread.yield_now()
    }
    // More than two sequential successes prove completed stream entries release capacity.
    loop stream_id in (9..29).step_by(2) {
        client.write_all(h2_frame(1, 0x5, stream_id, h2_request_headers(0x82, "/fast"))).unwrap()
        client.flush().unwrap()
        loop {
            (kind, _, stream, payload) :: h2_read_frame(&client)
            assert(!(kind == 0 && stream == blocked_response_id), "cancelled response producer emitted late DATA")
            if kind == 0 && stream == stream_id && payload == "fast".as_bytes() { break }
        }
    }
    large_id :: 29
    client.write_all(h2_frame(4, 0, 0, [0, 4, 0, 0, 0, 1])).unwrap()
    client.write_all(h2_frame(1, 0x5, large_id, h2_request_headers(0x82, "/large"))).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 0 && stream == large_id && !payload.is_empty() { break }
    }
    client.write_all(h2_frame(3, 0, large_id, U32{8}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(8, 0, 0, U32{100_000}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(8, 0, large_id, U32{100_000}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(6, 0, 0, "reset-ok".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        assert(!(kind == 0 && stream == large_id), "RST stream emitted late DATA")
        if kind == 6 && flags & 1 != 0 && payload == "reset-ok".as_bytes() { break }
    }
    ignored_id :: 31
    client.write_all(h2_frame(4, 0, 0, [0, 4, 0, 0, 0xff, 0xff])).unwrap()
    client.write_all(h2_frame(1, 0x4, ignored_id, h2_request_headers(0x83, "/ignore"))).unwrap()
    client.write_all(h2_frame(0, 0, ignored_id, "body".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        assert(!(kind == 8 && stream == ignored_id), "receive credit was returned before application consumption")
        if kind == 0 && stream == ignored_id && payload == "ignored".as_bytes() { break }
    }
    client.write_all(h2_frame(3, 0, ignored_id, U32{8}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(7, 0, 0, [U8#8]{0, 0, 0, 0, 0, 0, 0, 0})).unwrap()
    client.flush().unwrap()
    assert(server.join().unwrap().is_ok())
}
// Rust: tests/http_server_lifecycle.rs:5647
#Test("http2_uses_configured_header_body_and_size_limits") {
    // Rust: tests/http_server_lifecycle.rs:5650
    fn serve_once(options: JetHTTPServerOptions, write_client: fn(&TcpStream) -> ()) -> () Err! {
        mux :: jet_http_mux_new()
        jet_http_mux_add(mux, "POST", "/echo", request -> {
            size :: request.body.bytes(64).map(body -> body.len()).unwrap_or(0)
            jet_http_srv_response(200, size.to_string())
        })
        listener :: TcpListener.bind("127.0.0.1:0").unwrap()
        addr :: listener.local_addr().unwrap()
        client := TcpStream.connect(addr).unwrap()
        (server, _) := listener.accept().unwrap()
        worker :: thread.spawn(() -> jet_http2_serve(&server, mux, options, AtomicBool.new(false), None, None))
        client.write_all(JET_HTTP2_PREFACE).unwrap()
        client.write_all(h2_frame(4, 0, 0, [])).unwrap()
        write_client(&client)
        client.flush().unwrap()
        worker.join().unwrap()
    }
    short := JetHTTPServerOptions.safe()
    short.read_header_timeout = Duration.from_millis(25)
    short.read_idle_timeout = Duration.from_secs(1)
    header_error :: serve_once(short, client -> {
        client.write_all(h2_frame(1, 0, 1, h2_request_headers(0x83, "/echo"))).unwrap()
        thread.sleep(Duration.from_millis(60))
    }).unwrap_err()
    assert(header_error.contains("timed out") || header_error.contains("ended early"), header_error)
    bounded := JetHTTPServerOptions.safe()
    bounded.max_body_bytes = 4
    body_error :: serve_once(bounded, client -> {
        client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/echo"))).unwrap()
        client.write_all(h2_frame(0, 0x1, 1, "12345".as_bytes())).unwrap()
        _ :: client.shutdown(std.net.Shutdown.Write)
    }).unwrap_err()
    assert_eq(body_error, "HTTP/2 request body is too large")
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "POST", "/echo", request -> {
        size :: request.body.bytes(64).map(body -> body.len()).unwrap_or(0)
        jet_http_srv_response(200, size.to_string())
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    options := JetHTTPServerOptions.safe()
    options.read_body_timeout = Duration.from_millis(25)
    options.read_idle_timeout = Duration.from_secs(1)
    worker :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, AtomicBool.new(false), None, None))
    client.set_read_timeout(Val(Duration.from_secs(1))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/echo"))).unwrap()
    client.flush().unwrap()
    pinger := client.try_clone().unwrap()
    pings :: thread.spawn(() -> {
        loop sequence in U64{0}..U64{20} {
            if pinger.write_all(h2_frame(6, 0, 0, sequence.to_be_bytes())).is_err() { break }
            _ :: pinger.flush()
            thread.sleep(Duration.from_millis(5))
        }
    })
    deadline_started :: Instant.now()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 3 && stream == 1 { assert_eq(payload, U32{8}.to_be_bytes()); break }
    }
    assert(deadline_started.elapsed() < Duration.from_millis(250), "frequent PING traffic extended the incomplete-body deadline")
    pings.join().unwrap()
    client.write_all(h2_frame(7, 0, 0, [U8#8]{0, 0, 0, 0, 0, 0, 0, 0})).unwrap()
    client.flush().unwrap()
    assert(worker.join().unwrap().is_ok())
}
// Rust: tests/http_server_lifecycle.rs:5776
#Test("native_http2_routes_huffman_headers_and_enforces_stream_framing") {
    // Rust: tests/http_server_lifecycle.rs:5779
    fn frame(kind: U8, flags: U8, stream: U32, payload: [U8]) -> [U8] {
        len :: payload.len()
        out := [U8]{U8(len >> 16), U8(len >> 8), U8(len), kind, flags}
        out.extend_from_slice((stream & 0x7fff_ffff).to_be_bytes())
        out.extend_from_slice(payload)
        out
    }
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "GET", "/", _ -> jet_http_srv_response(200, "h2-ok"))
    jet_http_mux_add(mux, "GET", "/large", _ -> {
        response := jet_http_srv_response(200, "")
        response.body = JetHTTPBody.from_bytes([U8]{7}.repeat(70_000))
        response
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    stop :: shutdown.clone()
    server :: thread.spawn(() -> jet_http_server_run_listener(^listener, ^mux, JetHTTPServerOptions.safe(), ^stop, None, None, None).unwrap())
    stream := TcpStream.connect(addr).unwrap()
    stream.set_read_timeout(Val(Duration.from_secs(2))).unwrap()
    stream.write_all("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".as_bytes()).unwrap()
    stream.write_all(frame(4, 0, 0, [])).unwrap()
    // RFC 7541 C.4.1: Huffman-encoded authority.
    stream.write_all(frame(1, 0x5, 1, [0x82, 0x86, 0x84, 0x41, 0x8c, 0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff])).unwrap()
    stream.flush().unwrap()
    wire: [U8] := []
    deadline :: Instant.now() + Duration.from_secs(2)
    loop !wire.windows(5).any(part -> part == "h2-ok".as_bytes()) && Instant.now() < deadline {
        chunk := [U8]{0}.repeat(4096)
        if stream.read(&chunk) == {
            .Ok(0) -> break
            .Ok(read) -> wire.extend_from_slice(chunk[..read])
            .Err(error) -> {
                if error.kind() == io.ErrorKind.WouldBlock || error.kind() == io.ErrorKind.TimedOut { break }
                panic("HTTP/2 response read failed: {error}")
            }
        }
    }
    assert(wire.windows(5).any(part -> part == "h2-ok".as_bytes()), "HTTP/2 DATA missing: {wire.debug()}")
    assert(wire.windows(9).any(header -> header[3] == 4), "server SETTINGS missing")
    assert(wire.windows(9).any(header -> header[3] == 1 && header[8] == 1), "stream-1 HEADERS missing")
    large_headers :: [U8]{0x82, 0x86, 0x04, 0x06, 47, 108, 97, 114, 103, 101, 0x41, 0x05, 108, 111, 99, 97, 108}
    stream.write_all(frame(1, 0x5, 3, large_headers)).unwrap()
    stream.flush().unwrap()
    received: USize := 0
    loop received < 65_000 {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        if header[3] == 0 && U32.from_be_bytes(header[5..9].try_into().unwrap()) == 3 {
            assert(payload.iter().all(byte -> *byte == 7))
            received += payload.len()
        }
    }
    assert(received < 70_000, "server ignored HTTP/2 flow control")
    stream.write_all(frame(8, 0, 0, U32{70_000}.to_be_bytes())).unwrap()
    stream.write_all(frame(8, 0, 3, U32{70_000}.to_be_bytes())).unwrap()
    stream.flush().unwrap()
    ended := false
    loop !ended {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        if header[3] == 0 && U32.from_be_bytes(header[5..9].try_into().unwrap()) == 3 {
            received += payload.len()
            ended = header[4] & 0x1 != 0
        }
    }
    assert_eq(received, 70_000)
    // Dynamic index 62 reuses the incrementally indexed authority.
    stream.write_all(frame(1, 0x5, 5, [0x82, 0x86, 0x84, 0xbe])).unwrap()
    stream.flush().unwrap()
    reused: [U8] := []
    loop !reused.windows(5).any(part -> part == "h2-ok".as_bytes()) {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        reused.extend(^payload)
    }
    shutdown.store(true, Ordering.Release)
    drop(^stream)
    report :: server.join().unwrap()
    assert_eq(report.user_accepted, 1)
    empty_mux :: jet_http_mux_new()
    (client, server_stream) := {
        listener :: TcpListener.bind("127.0.0.1:0").unwrap()
        addr :: listener.local_addr().unwrap()
        client :: TcpStream.connect(addr).unwrap()
        (server, _) :: listener.accept().unwrap()
        (client, server)
    }
    client.write_all("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".as_bytes()).unwrap()
    client.write_all(frame(0, 0, 0, "illegal stream-zero data".as_bytes())).unwrap()
    client.flush().unwrap()
    server_stream.set_read_timeout(Val(Duration.from_secs(1))).unwrap()
    assert(jet_http2_serve(&server_stream, empty_mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None).is_err())
}

// Rust: tests/http_server_lifecycle.rs:5958
#Test("http2_shutdown_sends_goaway_with_last_stream_and_drains_active") {
    mux :: jet_http_mux_new()
    (entered_tx, entered_rx) :: mpsc.channel()
    jet_http_mux_add_handler(mux, "POST", "/slow", Arc.new(request -> {
        entered_tx.send(()).expect("entered")
        assert_eq(request.body.text(64)?, "")
        assert_eq(jet_http_srv_req_trailers(request)?.first("x-drain"), Val("done"))
        Ok(jet_http_srv_response(200, "drained"))
    }))
    jet_http_mux_add(mux, "GET", "/late", _ -> jet_http_srv_response(200, "too late"))
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 1
    options.shutdown_grace = Duration.from_secs(2)
    options.read_idle_timeout = Duration.from_secs(2)
    server :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, server_shutdown, None, None))
    client.set_read_timeout(Val(Duration.from_millis(50))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/slow"))).unwrap()
    client.flush().unwrap()
    // Rust: tests/http_server_lifecycle.rs:6016
    read_frame :: (stream: &TcpStream) -> (U8, U8, U32, [U8])? {
        header := [U8]{0}.repeat(9)
        match stream.read_exact(&header) {
            Ok(()) -> {}
            Err(error) -> {
                if error.kind() == io.ErrorKind.WouldBlock || error.kind() == io.ErrorKind.TimedOut { return None }
                panic("frame header: {error}")
            }
        }
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).expect("frame payload")
        Val((header[3], header[4], U32.from_be_bytes(header[5..9].try_into().unwrap()) & 0x7fff_ffff, ^payload))
    }
    saw_server_settings := false
    deadline :: Instant.now() + Duration.from_secs(1)
    loop !saw_server_settings {
        assert(Instant.now() < deadline, "missing SETTINGS")
        frame :: read_frame(&client)
        if frame.is_none() { continue }
        (kind, flags, stream, _) :: frame.unwrap()
        if kind == 4 && stream == 0 {
            saw_server_settings = true
            if flags & 0x1 == 0 { client.write_all(h2_frame(4, 0x1, 0, [])).unwrap() }
        }
    }
    entered_rx.recv_timeout(Duration.from_secs(1)).expect("handler entered")
    shutdown.store(true, Ordering.Release)
    goaway_last: U32? := None
    saw_body := false
    refused_late := false
    trailing_sent := false
    late_headers_sent := false
    late_data_sent := false
    drain_deadline :: Instant.now() + Duration.from_secs(2)
    loop Instant.now() < drain_deadline && (goaway_last.is_none() || !saw_body || !refused_late) {
        if goaway_last.is_some() && !trailing_sent {
            client.write_all(h2_frame(1, 0x5, 1, h2_literal_named_header("x-drain", "done"))).unwrap()
            client.flush().unwrap()
            trailing_sent = true
        }
        if goaway_last.is_some() && !late_headers_sent {
            // HEADERS after GOAWAY must RST immediately (flushed).
            client.write_all(h2_frame(1, 0x5, 3, h2_request_headers(0x82, "/late"))).unwrap()
            client.flush().unwrap()
            late_headers_sent = true
        }
        if refused_late && !late_data_sent {
            // DATA on a higher/unknown stream must be discarded, not kill drain.
            client.write_all(h2_frame(0, 0x1, 5, "late".as_bytes())).unwrap()
            client.flush().unwrap()
            late_data_sent = true
        }
        frame :: read_frame(&client)
        if frame.is_none() { continue }
        (kind, _, stream, payload) :: frame.unwrap()
        match kind {
            7 -> {
                assert_eq(stream, 0)
                assert(payload.len() >= 8, "GOAWAY payload too short")
                last :: U32.from_be_bytes(payload[..4].try_into().unwrap()) & 0x7fff_ffff
                error :: U32.from_be_bytes(payload[4..8].try_into().unwrap())
                assert_eq(error, 0, "GOAWAY should be NO_ERROR")
                goaway_last = Val(last)
            }
            0 if stream == 1 -> {
                if payload.windows(7).any(part -> part == "drained".as_bytes()) { saw_body = true }
            }
            3 if stream == 3 -> {
                assert_eq(payload.len(), 4)
                assert_eq(U32.from_be_bytes(payload[..4].try_into().unwrap()), 7)
                assert(!saw_body, "RST refuse must flush before the active handler finishes")
                refused_late = true
            }
            _ -> {}
        }
    }
    assert_eq(goaway_last, Val(1), "GOAWAY must advertise the accepted last stream")
    assert(saw_body, "active request must drain after GOAWAY")
    assert(refused_late, "streams after GOAWAY must be refused")
    assert(trailing_sent, "accepted stream trailers must be exercised after GOAWAY")
    assert(late_data_sent, "late DATA after GOAWAY must be exercised")
    server.join().expect("server join").expect("http2 serve must survive discarded late DATA")
}

// Rust: tests/http_server_lifecycle.rs:6145
#Test("http2_goaway_discards_orphan_continuation_without_aborting_drain") {
    mux :: jet_http_mux_new()
    (entered_tx, entered_rx) :: mpsc.channel()
    release :: Arc.new(AtomicBool.new(false))
    handler_release :: release.clone()
    jet_http_mux_add(mux, "GET", "/slow", _ -> {
        entered_tx.send(()).expect("entered")
        deadline :: Instant.now() + Duration.from_secs(2)
        loop !handler_release.load(Ordering.Acquire) {
            assert(Instant.now() < deadline, "release timed out")
            thread.sleep(Duration.from_millis(5))
        }
        jet_http_srv_response(200, "drained")
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 1
    options.shutdown_grace = Duration.from_secs(2)
    options.read_idle_timeout = Duration.from_secs(2)
    server :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, server_shutdown, None, None))
    client.set_read_timeout(Val(Duration.from_millis(50))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x5, 1, h2_request_headers(0x82, "/slow"))).unwrap()
    client.flush().unwrap()
    // Rust: tests/http_server_lifecycle.rs:6197
    read_frame :: (stream: &TcpStream) -> (U8, U8, U32, [U8])? {
        header := [U8]{0}.repeat(9)
        match stream.read_exact(&header) {
            Ok(()) -> {}
            Err(error) -> {
                if error.kind() == io.ErrorKind.WouldBlock || error.kind() == io.ErrorKind.TimedOut { return None }
                panic("frame header: {error}")
            }
        }
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).expect("frame payload")
        Val((header[3], header[4], U32.from_be_bytes(header[5..9].try_into().unwrap()) & 0x7fff_ffff, ^payload))
    }
    saw_server_settings := false
    deadline :: Instant.now() + Duration.from_secs(1)
    loop !saw_server_settings {
        assert(Instant.now() < deadline, "missing SETTINGS")
        frame :: read_frame(&client)
        if frame.is_none() { continue }
        (kind, flags, stream, _) :: frame.unwrap()
        if kind == 4 && stream == 0 {
            saw_server_settings = true
            if flags & 0x1 == 0 { client.write_all(h2_frame(4, 0x1, 0, [])).unwrap() }
        }
    }
    entered_rx.recv_timeout(Duration.from_secs(1)).expect("handler entered")
    shutdown.store(true, Ordering.Release)
    goaway_last: U32? := None
    saw_body := false
    refused_partial := false
    partial_headers_sent := false
    continuation_sent := false
    released := false
    drain_deadline :: Instant.now() + Duration.from_secs(2)
    loop Instant.now() < drain_deadline && (goaway_last.is_none() || !saw_body || !continuation_sent) {
        if goaway_last.is_some() && !partial_headers_sent {
            // Refuse partial HEADERS, then discard orphan CONTINUATION without aborting drain.
            client.write_all(h2_frame(1, 0x0, 3, h2_request_headers(0x82, "/late"))).unwrap()
            client.flush().unwrap()
            partial_headers_sent = true
        }
        if refused_partial && !continuation_sent {
            client.write_all(h2_frame(9, 0x4, 3, [])).unwrap()
            client.flush().unwrap()
            continuation_sent = true
        }
        if continuation_sent && !released {
            release.store(true, Ordering.Release)
            released = true
        }
        frame :: read_frame(&client)
        if frame.is_none() { continue }
        (kind, _, stream, payload) :: frame.unwrap()
        match kind {
            7 -> {
                assert_eq(stream, 0)
                assert(payload.len() >= 8, "GOAWAY payload too short")
                last :: U32.from_be_bytes(payload[..4].try_into().unwrap()) & 0x7fff_ffff
                error :: U32.from_be_bytes(payload[4..8].try_into().unwrap())
                assert_eq(error, 0, "GOAWAY should be NO_ERROR")
                goaway_last = Val(last)
            }
            0 if stream == 1 -> {
                if payload.windows(7).any(part -> part == "drained".as_bytes()) { saw_body = true }
            }
            3 if stream == 3 -> {
                assert_eq(payload.len(), 4)
                assert_eq(U32.from_be_bytes(payload[..4].try_into().unwrap()), 7)
                refused_partial = true
            }
            _ -> {}
        }
    }
    assert_eq(goaway_last, Val(1), "GOAWAY must advertise the accepted last stream")
    assert(refused_partial, "partial HEADERS after GOAWAY must be refused")
    assert(continuation_sent, "orphan CONTINUATION after GOAWAY must be exercised")
    assert(saw_body, "active request must drain after orphan CONTINUATION")
    release.store(true, Ordering.Release)
    server.join().expect("server join").expect("http2 serve must survive post-GOAWAY orphan CONTINUATION")
}

// Rust: tests/http_server_lifecycle.rs:6320
#Test("http2_serve_honors_dynamic_grace_over_options_shutdown_grace") {
    mux :: jet_http_mux_new()
    (entered_tx, entered_rx) :: mpsc.channel()
    hold :: Arc.new(AtomicBool.new(true))
    handler_hold :: hold.clone()
    jet_http_mux_add(mux, "GET", "/slow", _ -> {
        _ :: entered_tx.send(())
        loop handler_hold.load(Ordering.Acquire) { thread.sleep(Duration.from_millis(5)) }
        jet_http_srv_response(200, "late")
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: shutdown.clone()
    grace_ms :: Arc.new(AtomicU64.new(45))
    server_grace :: grace_ms.clone()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 1
    // Ignoring dynamic_grace_ms would wait five seconds.
    options.shutdown_grace = Duration.from_secs(5)
    options.read_idle_timeout = Duration.from_secs(2)
    server :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, server_shutdown, Val(server_grace.as_ref()), None))
    client.set_read_timeout(Val(Duration.from_millis(40))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x5, 1, h2_request_headers(0x82, "/slow"))).unwrap()
    client.flush().unwrap()
    deadline :: Instant.now() + Duration.from_secs(1)
    loop {
        assert(Instant.now() < deadline, "missing SETTINGS")
        frame :: h2_try_read_frame(&client)
        if frame.is_none() { continue }
        (kind, flags, stream, _) :: frame.unwrap()
        if kind == 4 && stream == 0 {
            if flags & 0x1 == 0 { client.write_all(h2_frame(4, 0x1, 0, [])).unwrap() }
            break
        }
    }
    entered_rx.recv_timeout(Duration.from_secs(1)).expect("handler entered")
    started :: Instant.now()
    shutdown.store(true, Ordering.Release)
    server.join().expect("join").expect("serve ok")
    elapsed :: started.elapsed()
    assert(elapsed < Duration.from_millis(800), "dynamic grace ignored; waited options.shutdown_grace: {elapsed:?}")
    hold.store(false, Ordering.Release)
}

// Rust: tests/http_server_lifecycle.rs:6402
#Test("http2_server_api_shutdown_grace_reaches_h2_drain") {
    // A completed report while the handler is held proves H2 grace rather than TCP kill.
    mux :: jet_http_mux_new()
    (entered_tx, entered_rx) :: mpsc.channel()
    hold :: Arc.new(AtomicBool.new(true))
    handler_hold :: hold.clone()
    jet_http_mux_add(mux, "GET", "/slow", _ -> {
        _ :: entered_tx.send(())
        loop handler_hold.load(Ordering.Acquire) { thread.sleep(Duration.from_millis(5)) }
        jet_http_srv_response(200, "late")
    })
    server :: jet_http_server_bind("127.0.0.1:0", mux, None, None).expect("bind")
    addr :: jet_http_server_local_addr(server).expect("local addr")
    serving :: server.clone()
    serve :: thread.spawn(() -> jet_http_server_serve(serving))
    client := TcpStream.connect(addr).expect("connect")
    client.set_read_timeout(Val(Duration.from_millis(40))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x5, 1, h2_request_headers(0x82, "/slow"))).unwrap()
    client.flush().unwrap()
    deadline :: Instant.now() + Duration.from_secs(1)
    loop {
        assert(Instant.now() < deadline, "missing SETTINGS before shutdown")
        frame :: h2_try_read_frame(&client)
        if frame.is_none() { continue }
        (kind, flags, stream, _) :: frame.unwrap()
        if kind == 4 && stream == 0 && flags & 0x1 == 0 {
            client.write_all(h2_frame(4, 0x1, 0, [])).unwrap()
            break
        }
    }
    entered_rx.recv_timeout(Duration.from_secs(1)).expect("handler entered")
    started :: Instant.now()
    report :: jet_http_server_shutdown(server, jet_std.Duration{ms: 250}).expect("shutdown")
    elapsed :: started.elapsed()
    assert(hold.load(Ordering.Acquire), "handler must still be held — completion must come from H2 grace cancel, not a finished response")
    assert_eq(report.user_cancelled, 0, "listener force-closed the socket; H2 did not honor Server.shutdown grace: {report:?}")
    assert_eq(report.user_completed, report.user_accepted, "H2 drain must complete within Server.shutdown grace without TCP kill: {report:?}")
    assert(report.user_accepted >= 1, "{report:?}")
    assert(elapsed < Duration.from_millis(1500), "Server.shutdown(grace) did not bound H2 drain: {elapsed:?}")
    assert(elapsed > Duration.from_millis(50), "shutdown returned too fast to prove grace drain: {elapsed:?}")
    saw_goaway := false
    observe :: Instant.now() + Duration.from_millis(400)
    loop !saw_goaway && Instant.now() < observe {
        if h2_try_read_frame(&client) == .Val((kind, _, stream, payload)) {
            if kind == 7 && stream == 0 && payload.len() >= 8 {
                last :: U32.from_be_bytes(payload[..4].try_into().unwrap()) & 0x7fff_ffff
                error :: U32.from_be_bytes(payload[4..8].try_into().unwrap())
                assert_eq(last, 1, "Server API GOAWAY must carry last-stream")
                assert_eq(error, 0, "Server API GOAWAY must be NO_ERROR")
                saw_goaway = true
            }
        }
    }
    assert(saw_goaway, "Server.shutdown must drive H2 GOAWAY")
    hold.store(false, Ordering.Release)
    _ :: serve.join().expect("serve join")
}

// Rust: tests/http_server_lifecycle.rs:6532
#Test("tls_chunk_framing_scan_is_incremental_and_bounded") {
    valid :: "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\nTrailer: X-Checksum\r\n\r\n1 ; name=value\r\nx\r\n0\r\nX-Checksum: done\r\n\r\n".as_bytes()
    (status, end, inspected) :: http_server_tls_runtime.framing_probe(valid)
    assert_eq((status, end), (1, valid.len()))
    assert(inspected <= valid.len() * 4, "valid scan was not linear: {inspected}")
    repeated_length :: "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 1, 1\r\n\r\nx".as_bytes()
    assert_eq(http_server_tls_runtime.framing_probe(repeated_length).0, 1, "valid repeated Content-Length was rejected")
    hostile := "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n".as_bytes().to_vec()
    hostile.extend([U8]{102}.repeat(32 * 1024 + 1))
    (status, consumed, inspected) :: http_server_tls_runtime.framing_probe(hostile)
    assert_eq(status, 2, "unbounded chunk-size line was not rejected")
    assert(consumed <= hostile.len())
    assert(inspected <= consumed * 4, "hostile scan was not linear: {inspected}/{consumed}")
}

// Rust: tests/http_server_lifecycle.rs:6560
#Test("tls_oversized_content_length_chunk_and_framing_return_413") {
    mux :: jet_http_mux_new()
    calls :: Arc.new(AtomicUsize.new(0))
    handler_calls :: calls.clone()
    jet_http_mux_add(mux, "POST", "/", _ -> {
        _ :: handler_calls.fetch_add(1, Ordering.AcqRel)
        jet_http_srv_response(200, "unexpected")
    })
    cert :: include_str("../tests/fixtures/tls/localhost.cert.pem").to_string()
    key :: include_str("../tests/fixtures/tls/localhost.key.pem").to_string()
    server :: jet_http_server_bind_tls("127.0.0.1:0", mux, JetHTTPServerTls{cert_pem: cert, key_pem: key},
        (cert, key) -> http_server_tls_runtime.jet_http_server_tls_validate_impl(cert, key),
        (cert, key, stream, on_request, on_h2, should_stop) -> http_server_tls_runtime.jet_http_server_tls_session_impl(cert, key, stream, on_request, on_h2, should_stop)
    ).expect("bind rustls tls")
    addr: SocketAddr :: jet_http_server_local_addr(server).expect("addr").parse().expect("parse")
    serving :: server.clone()
    serve :: thread.spawn(() -> jet_http_server_serve(serving))
    requests := [
        "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1048577\r\n\r\n".as_bytes().to_vec(),
        "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n100001\r\n".as_bytes().to_vec()
    ]
    long_line := "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n".as_bytes().to_vec()
    long_line.extend([U8]{102}.repeat(32 * 1024 + 1))
    requests.push(^long_line)
    for request in requests {
        started :: Instant.now()
        client := rustls_fixture_client(addr)
        response :: rustls_exchange(&client, request)
        assert(response.starts_with("HTTP/1.1 413 Payload Too Large"), "{response}")
        assert(started.elapsed() < Duration.from_secs(2))
    }
    assert_eq(calls.load(Ordering.Acquire), 0, "oversized TLS body reached handler")
    _ :: jet_http_server_shutdown(server, jet_std.Duration{ms: 200}).expect("shutdown")
    _ :: serve.join().expect("serve join")
}

// Rust: tests/http_server_lifecycle.rs:6628
#Test("tls_rustls_keep_alive_and_server_shutdown") {
    // Real TLS: bind → keep-alive reuse → shutdown prevents another request.
    mux :: jet_http_mux_new()
    jet_http_srv_install_request_id(mux)
    calls :: Arc.new(AtomicUsize.new(0))
    handler_calls :: calls.clone()
    jet_http_mux_add(mux, "GET", "/", _ -> {
        n :: handler_calls.fetch_add(1, Ordering.AcqRel) + 1
        jet_http_srv_response(200, "ok{n}")
    })
    encoded_calls :: calls.clone()
    jet_http_mux_add_handler(mux, "POST", "/encoded", Arc.new(req -> {
        assert_eq(req.headers.first("content-encoding"), None)
        assert_eq(req.headers.first("content-length"), None)
        body :: req.body.text(1024)?
        _ :: encoded_calls.fetch_add(1, Ordering.AcqRel)
        Ok(jet_http_srv_response(200, body))
    }))
    trailer_calls :: calls.clone()
    jet_http_mux_add_handler(mux, "POST", "/trailers", Arc.new(req -> {
        assert(matches(jet_http_srv_req_trailers(req), Err(JetHTTPError.InvalidFraming)))
        body :: req.body.text(1024)?
        trailers :: jet_http_srv_req_trailers(req)?
        assert_eq(trailers.first("x-checksum"), Val("tls-in"))
        _ :: trailer_calls.fetch_add(1, Ordering.AcqRel)
        response := jet_http_srv_response(200, "")
        response.body = JetHTTPBody.reader(io.Cursor.new(^body), None)
        trailers := JetHTTPHeaders.new()
        trailers.append("X-Checksum", "tls-out").unwrap()
        jet_http_srv_response_trailers(^response, ^trailers)
    }))
    jet_http_mux_add_handler(mux, "GET", "/error", Arc.new(_ -> Err(JetHTTPError.Internal{incident_id: "private-tls-handler-error"})))
    cert :: include_str("../tests/fixtures/tls/localhost.cert.pem").to_string()
    key :: include_str("../tests/fixtures/tls/localhost.key.pem").to_string()
    tls :: JetHTTPServerTls{cert_pem: cert, key_pem: key}
    server :: jet_http_server_bind_tls("127.0.0.1:0", mux, tls,
        (cert, key) -> http_server_tls_runtime.jet_http_server_tls_validate_impl(cert, key),
        (cert, key, stream, on_request, on_h2, should_stop) -> http_server_tls_runtime.jet_http_server_tls_session_impl(cert, key, stream, on_request, on_h2, should_stop)
    ).expect("bind rustls tls")
    addr: SocketAddr :: jet_http_server_local_addr(server).expect("addr").parse().expect("parse")
    serving :: server.clone()
    serve :: thread.spawn(() -> jet_http_server_serve(serving))
    client := rustls_fixture_client(addr)
    first :: rustls_exchange(&client, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n".as_bytes())
    second :: rustls_exchange(&client, "GET / HTTP/1.1\r\nHost: localhost\r\nX-Request-Id: tls-client-id\r\n\r\n".as_bytes())
    encoded_request := "POST /encoded HTTP/1.1\r\nHost: localhost\r\nContent-Encoding: gzip\r\nContent-Length: {HELLO_GZIP.len()}\r\n\r\n".into_bytes()
    encoded_request.extend_from_slice(HELLO_GZIP)
    encoded :: rustls_exchange(&client, encoded_request)
    trailers :: rustls_exchange(&client, "POST /trailers HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\nTrailer: X-Checksum\r\n\r\n3\r\ntls\r\n0\r\nX-Checksum: tls-in\r\n\r\n".as_bytes())
    failed :: rustls_exchange(&client, "GET /error HTTP/1.1\r\nHost: localhost\r\n\r\n".as_bytes())
    assert(first.contains("\r\n\r\nok1"), "{first}")
    assert(second.contains("\r\n\r\nok2"), "{second}")
    assert(second.to_ascii_lowercase().contains("x-request-id: tls-client-id\r\n"), "{second}")
    assert(encoded.contains("\r\n\r\nhello gzip"), "{encoded}")
    assert(trailers.contains("Trailer: X-Checksum\r\n"), "{trailers}")
    assert(trailers.ends_with("3\r\ntls\r\n0\r\nX-Checksum: tls-out\r\n\r\n"), "{trailers}")
    assert(failed.starts_with("HTTP/1.1 500 Internal Server Error"), "{failed}")
    assert(failed.lines().any(line -> line.to_ascii_lowercase().starts_with("x-request-id: req-")), "uncorrelated TLS failure: {failed}")
    assert(!failed.contains("private"), "private TLS failure leaked: {failed}")
    assert_eq(calls.load(Ordering.Acquire), 4)
    started :: Instant.now()
    report :: jet_http_server_shutdown(server, jet_std.Duration{ms: 200}).expect("shutdown")
    _ :: client.write_all("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n".as_bytes())
    _ :: client.flush()
    thread.sleep(Duration.from_millis(40))
    assert_eq(calls.load(Ordering.Acquire), 4, "Server.shutdown must stop rustls keep-alive reuse without client Connection: close")
    assert(started.elapsed() < Duration.from_millis(1500), "{report:?}")
    assert_eq(report.user_accepted, 1, "{report:?}")
    assert_eq(report.user_completed + report.user_cancelled, report.user_accepted, "{report:?}")
    _ :: serve.join().expect("serve join")
}

