use tests.conformance.corpus.core.port.http_server_lifecycle.*
use tests.conformance.corpus.core.port.http_server_lifecycle_03.*
use tests.conformance.corpus.core.port.http_server_lifecycle_04.*
use std.io as io
use std.env as env
use std.process.Command
use std.sync.[Arc, Mutex, Condvar]
use std.sync.atomic.[AtomicUsize, AtomicBool, Ordering]
use std.sync.mpsc as mpsc
use std.net.[TcpListener, TcpStream]
use std.time.[Duration, Instant]
use std.thread as thread
// GATE #4494: native sockets, process isolation, channels, atomics and cancellable blocking body.
// GATE #4409: preserve Interrupted from the cancelled body producer.

// Rust: tests/http_server_lifecycle.rs:5328
#Test("http2_handlers_overlap_reset_drops_queued_data_and_completed_streams_release_capacity") {
    CHILD :: "JET_HTTP2_BLOCKING_BODY_TEST_CHILD"
    if env.var_os(CHILD).is_none() {
        status :: Command.new(env.current_exe().unwrap()).args(["--exact", "http2_handlers_overlap_reset_drops_queued_data_and_completed_streams_release_capacity", "--nocapture"]).env(CHILD, "1").env("JET_SCHEDULER_THREADS", "1").status().expect("spawn isolated HTTP/2 blocking-body test")
        assert(status.success(), "isolated HTTP/2 blocking-body test failed")
        return
    }
    // Rust: tests/http_server_lifecycle.rs:5350
    struct BlockingBody {
        started: mpsc.Sender<()>?
        wake: Arc<(Mutex<Bool>, Condvar)>
        dropped: Arc<AtomicUsize>
    }
    impl BlockingBody.io.Read {
        // Rust: tests/http_server_lifecycle.rs:5357
        fn read(self: &BlockingBody, _output: &[U8]) -> USize io.Error! {
            if self.started.take() == .Val(started) { _ :: started.send(()) }
            (cancelled, wake) :: @self.wake
            guard := cancelled.lock().unwrap()
            loop !*guard { guard = wake.wait(^guard).unwrap() }
            Err(io.Error.from(io.ErrorKind.Interrupted))
        }
    }
    impl BlockingBody.Drop {
        // Rust: tests/http_server_lifecycle.rs:5371
        fn drop(self: &BlockingBody) -> { _ :: self.dropped.fetch_add(1, Ordering.AcqRel) }
    }
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "POST", "/slow-body", request -> {
        body :: request.body.bytes(64).unwrap()
        jet_http_srv_response(200, body.len().to_string())
    })
    jet_http_mux_add(mux, "GET", "/fast", _ -> jet_http_srv_response(200, "fast"))
    jet_http_mux_add(mux, "GET", "/large", _ -> {
        response := jet_http_srv_empty_response(200)
        response.body = JetHTTPBody.from_bytes([U8]{7}.repeat(100_000))
        response
    })
    jet_http_mux_add(mux, "POST", "/ignore", _ -> jet_http_srv_response(200, "ignored"))
    (response_started_tx, response_started_rx) :: mpsc.channel()
    response_wake :: Arc.new((Mutex.new(false), Condvar.new()))
    response_dropped :: Arc.new(AtomicUsize.new(0))
    response_closed :: Arc.new(AtomicUsize.new(0))
    handler_wake :: response_wake.clone()
    handler_dropped :: response_dropped.clone()
    handler_closed :: response_closed.clone()
    jet_http_mux_add(mux, "GET", "/slow-response", _ -> {
        response := jet_http_srv_empty_response(200)
        source_wake :: handler_wake.clone()
        close_wake :: handler_wake.clone()
        close_count :: handler_closed.clone()
        response.body = JetHTTPBody.reader_cancellable(BlockingBody{started: Val(response_started_tx.clone()), wake: source_wake, dropped: handler_dropped.clone()}, Val(4), () -> {
            _ :: close_count.fetch_add(1, Ordering.AcqRel)
            (cancelled, wake) :: @close_wake
            *cancelled.lock().unwrap() = true
            wake.notify_all()
        })
        response
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    options := JetHTTPServerOptions.safe()
    options.workers = 1
    options.admission_queue = 1
    options.read_idle_timeout = Duration.from_secs(2)
    server :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, AtomicBool.new(false), None, None))
    client.set_read_timeout(Val(Duration.from_secs(2))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/slow-body"))).unwrap()
    client.write_all(h2_frame(0, 0, 1, "part".as_bytes())).unwrap()
    client.flush().unwrap()
    deadline :: Instant.now() + Duration.from_secs(1)
    loop jet_scheduler_blocking_wait_stats().0 == 0 {
        assert(Instant.now() < deadline, "request Body did not enter a scheduler-aware blocking wait")
        thread.yield_now()
    }
    assert_eq(JET_OBSERVE_WORKERS.load(Ordering.Relaxed), 1)
    client.write_all(h2_frame(1, 0x5, 3, h2_request_headers(0x82, "/fast"))).unwrap()
    client.write_all(h2_frame(6, 0, 0, "12345678".as_bytes())).unwrap()
    client.flush().unwrap()
    fast := false
    ping := false
    loop !fast || !ping {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        fast |= kind == 0 && stream == 3 && payload == "fast".as_bytes()
        ping |= kind == 6 && flags & 1 != 0 && payload == "12345678".as_bytes()
    }
    assert(jet_scheduler_blocking_wait_stats().2 >= 1, "one blocked worker did not receive bounded compensation")
    client.write_all(h2_frame(0, 0x1, 1, "done".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 0 && stream == 1 && payload == "8".as_bytes() { break }
    }
    blocked_response_id :: 5
    client.write_all(h2_frame(1, 0x5, blocked_response_id, h2_request_headers(0x82, "/slow-response"))).unwrap()
    client.flush().unwrap()
    response_started_rx.recv_timeout(Duration.from_secs(1)).expect("response Body producer did not start")
    client.write_all(h2_frame(1, 0x5, 7, h2_request_headers(0x82, "/fast"))).unwrap()
    client.write_all(h2_frame(6, 0, 0, "bodyping".as_bytes())).unwrap()
    client.flush().unwrap()
    fast = false
    ping = false
    loop !fast || !ping {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        fast |= kind == 0 && stream == 7 && payload == "fast".as_bytes()
        ping |= kind == 6 && flags & 1 != 0 && payload == "bodyping".as_bytes()
        assert(!(kind == 0 && stream == blocked_response_id), "blocked response produced DATA before release")
    }
    client.write_all(h2_frame(3, 0, blocked_response_id, U32{8}.to_be_bytes())).unwrap()
    client.flush().unwrap()
    reset_deadline :: Instant.now() + Duration.from_secs(1)
    loop {
        (waits, threads, _) :: jet_scheduler_blocking_wait_stats()
        if response_closed.load(Ordering.Acquire) == 1 && response_dropped.load(Ordering.Acquire) == 1 && waits == 0 && threads == 0 { break }
        assert(Instant.now() < reset_deadline, "RST did not close and drop blocked response source: close={response_closed.load(Ordering.Acquire)} drop={response_dropped.load(Ordering.Acquire)} scheduler={jet_scheduler_blocking_wait_stats().debug()}")
        thread.yield_now()
    }
    // More than two sequential successes prove completed stream entries release capacity.
    loop stream_id in (9..29).step_by(2) {
        client.write_all(h2_frame(1, 0x5, stream_id, h2_request_headers(0x82, "/fast"))).unwrap()
        client.flush().unwrap()
        loop {
            (kind, _, stream, payload) :: h2_read_frame(&client)
            assert(!(kind == 0 && stream == blocked_response_id), "cancelled response producer emitted late DATA")
            if kind == 0 && stream == stream_id && payload == "fast".as_bytes() { break }
        }
    }
    large_id :: 29
    client.write_all(h2_frame(4, 0, 0, [0, 4, 0, 0, 0, 1])).unwrap()
    client.write_all(h2_frame(1, 0x5, large_id, h2_request_headers(0x82, "/large"))).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 0 && stream == large_id && !payload.is_empty() { break }
    }
    client.write_all(h2_frame(3, 0, large_id, U32{8}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(8, 0, 0, U32{100_000}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(8, 0, large_id, U32{100_000}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(6, 0, 0, "reset-ok".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, flags, stream, payload) :: h2_read_frame(&client)
        assert(!(kind == 0 && stream == large_id), "RST stream emitted late DATA")
        if kind == 6 && flags & 1 != 0 && payload == "reset-ok".as_bytes() { break }
    }
    ignored_id :: 31
    client.write_all(h2_frame(4, 0, 0, [0, 4, 0, 0, 0xff, 0xff])).unwrap()
    client.write_all(h2_frame(1, 0x4, ignored_id, h2_request_headers(0x83, "/ignore"))).unwrap()
    client.write_all(h2_frame(0, 0, ignored_id, "body".as_bytes())).unwrap()
    client.flush().unwrap()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        assert(!(kind == 8 && stream == ignored_id), "receive credit was returned before application consumption")
        if kind == 0 && stream == ignored_id && payload == "ignored".as_bytes() { break }
    }
    client.write_all(h2_frame(3, 0, ignored_id, U32{8}.to_be_bytes())).unwrap()
    client.write_all(h2_frame(7, 0, 0, [U8#8]{0, 0, 0, 0, 0, 0, 0, 0})).unwrap()
    client.flush().unwrap()
    assert(server.join().unwrap().is_ok())
}
// Rust: tests/http_server_lifecycle.rs:5647
#Test("http2_uses_configured_header_body_and_size_limits") {
    // Rust: tests/http_server_lifecycle.rs:5650
    fn serve_once(options: JetHTTPServerOptions, write_client: fn(&TcpStream) -> ()) -> () Err! {
        mux :: jet_http_mux_new()
        jet_http_mux_add(mux, "POST", "/echo", request -> {
            size :: request.body.bytes(64).map(body -> body.len()).unwrap_or(0)
            jet_http_srv_response(200, size.to_string())
        })
        listener :: TcpListener.bind("127.0.0.1:0").unwrap()
        addr :: listener.local_addr().unwrap()
        client := TcpStream.connect(addr).unwrap()
        (server, _) := listener.accept().unwrap()
        worker :: thread.spawn(() -> jet_http2_serve(&server, mux, options, AtomicBool.new(false), None, None))
        client.write_all(JET_HTTP2_PREFACE).unwrap()
        client.write_all(h2_frame(4, 0, 0, [])).unwrap()
        write_client(&client)
        client.flush().unwrap()
        worker.join().unwrap()
    }
    short := JetHTTPServerOptions.safe()
    short.read_header_timeout = Duration.from_millis(25)
    short.read_idle_timeout = Duration.from_secs(1)
    header_error :: serve_once(short, client -> {
        client.write_all(h2_frame(1, 0, 1, h2_request_headers(0x83, "/echo"))).unwrap()
        thread.sleep(Duration.from_millis(60))
    }).unwrap_err()
    assert(header_error.contains("timed out") || header_error.contains("ended early"), header_error)
    bounded := JetHTTPServerOptions.safe()
    bounded.max_body_bytes = 4
    body_error :: serve_once(bounded, client -> {
        client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/echo"))).unwrap()
        client.write_all(h2_frame(0, 0x1, 1, "12345".as_bytes())).unwrap()
        _ :: client.shutdown(std.net.Shutdown.Write)
    }).unwrap_err()
    assert_eq(body_error, "HTTP/2 request body is too large")
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "POST", "/echo", request -> {
        size :: request.body.bytes(64).map(body -> body.len()).unwrap_or(0)
        jet_http_srv_response(200, size.to_string())
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    client := TcpStream.connect(addr).unwrap()
    (server_stream, _) := listener.accept().unwrap()
    options := JetHTTPServerOptions.safe()
    options.read_body_timeout = Duration.from_millis(25)
    options.read_idle_timeout = Duration.from_secs(1)
    worker :: thread.spawn(() -> jet_http2_serve(&server_stream, mux, options, AtomicBool.new(false), None, None))
    client.set_read_timeout(Val(Duration.from_secs(1))).unwrap()
    client.write_all(JET_HTTP2_PREFACE).unwrap()
    client.write_all(h2_frame(4, 0, 0, [])).unwrap()
    client.write_all(h2_frame(1, 0x4, 1, h2_request_headers(0x83, "/echo"))).unwrap()
    client.flush().unwrap()
    pinger := client.try_clone().unwrap()
    pings :: thread.spawn(() -> {
        loop sequence in U64{0}..U64{20} {
            if pinger.write_all(h2_frame(6, 0, 0, sequence.to_be_bytes())).is_err() { break }
            _ :: pinger.flush()
            thread.sleep(Duration.from_millis(5))
        }
    })
    deadline_started :: Instant.now()
    loop {
        (kind, _, stream, payload) :: h2_read_frame(&client)
        if kind == 3 && stream == 1 { assert_eq(payload, U32{8}.to_be_bytes()); break }
    }
    assert(deadline_started.elapsed() < Duration.from_millis(250), "frequent PING traffic extended the incomplete-body deadline")
    pings.join().unwrap()
    client.write_all(h2_frame(7, 0, 0, [U8#8]{0, 0, 0, 0, 0, 0, 0, 0})).unwrap()
    client.flush().unwrap()
    assert(worker.join().unwrap().is_ok())
}
// Rust: tests/http_server_lifecycle.rs:5776
#Test("native_http2_routes_huffman_headers_and_enforces_stream_framing") {
    // Rust: tests/http_server_lifecycle.rs:5779
    fn frame(kind: U8, flags: U8, stream: U32, payload: [U8]) -> [U8] {
        len :: payload.len()
        out := [U8]{U8(len >> 16), U8(len >> 8), U8(len), kind, flags}
        out.extend_from_slice((stream & 0x7fff_ffff).to_be_bytes())
        out.extend_from_slice(payload)
        out
    }
    mux :: jet_http_mux_new()
    jet_http_mux_add(mux, "GET", "/", _ -> jet_http_srv_response(200, "h2-ok"))
    jet_http_mux_add(mux, "GET", "/large", _ -> {
        response := jet_http_srv_response(200, "")
        response.body = JetHTTPBody.from_bytes([U8]{7}.repeat(70_000))
        response
    })
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    stop :: shutdown.clone()
    server :: thread.spawn(() -> jet_http_server_run_listener(^listener, ^mux, JetHTTPServerOptions.safe(), ^stop, None, None, None).unwrap())
    stream := TcpStream.connect(addr).unwrap()
    stream.set_read_timeout(Val(Duration.from_secs(2))).unwrap()
    stream.write_all("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".as_bytes()).unwrap()
    stream.write_all(frame(4, 0, 0, [])).unwrap()
    // RFC 7541 C.4.1: Huffman-encoded authority.
    stream.write_all(frame(1, 0x5, 1, [0x82, 0x86, 0x84, 0x41, 0x8c, 0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff])).unwrap()
    stream.flush().unwrap()
    wire: [U8] := []
    deadline :: Instant.now() + Duration.from_secs(2)
    loop !wire.windows(5).any(part -> part == "h2-ok".as_bytes()) && Instant.now() < deadline {
        chunk := [U8]{0}.repeat(4096)
        if stream.read(&chunk) == {
            .Ok(0) -> break
            .Ok(read) -> wire.extend_from_slice(chunk[..read])
            .Err(error) -> {
                if error.kind() == io.ErrorKind.WouldBlock || error.kind() == io.ErrorKind.TimedOut { break }
                panic("HTTP/2 response read failed: {error}")
            }
        }
    }
    assert(wire.windows(5).any(part -> part == "h2-ok".as_bytes()), "HTTP/2 DATA missing: {wire.debug()}")
    assert(wire.windows(9).any(header -> header[3] == 4), "server SETTINGS missing")
    assert(wire.windows(9).any(header -> header[3] == 1 && header[8] == 1), "stream-1 HEADERS missing")
    large_headers :: [U8]{0x82, 0x86, 0x04, 0x06, 47, 108, 97, 114, 103, 101, 0x41, 0x05, 108, 111, 99, 97, 108}
    stream.write_all(frame(1, 0x5, 3, large_headers)).unwrap()
    stream.flush().unwrap()
    received: USize := 0
    loop received < 65_000 {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        if header[3] == 0 && U32.from_be_bytes(header[5..9].try_into().unwrap()) == 3 {
            assert(payload.iter().all(byte -> *byte == 7))
            received += payload.len()
        }
    }
    assert(received < 70_000, "server ignored HTTP/2 flow control")
    stream.write_all(frame(8, 0, 0, U32{70_000}.to_be_bytes())).unwrap()
    stream.write_all(frame(8, 0, 3, U32{70_000}.to_be_bytes())).unwrap()
    stream.flush().unwrap()
    ended := false
    loop !ended {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        if header[3] == 0 && U32.from_be_bytes(header[5..9].try_into().unwrap()) == 3 {
            received += payload.len()
            ended = header[4] & 0x1 != 0
        }
    }
    assert_eq(received, 70_000)
    // Dynamic index 62 reuses the incrementally indexed authority.
    stream.write_all(frame(1, 0x5, 5, [0x82, 0x86, 0x84, 0xbe])).unwrap()
    stream.flush().unwrap()
    reused: [U8] := []
    loop !reused.windows(5).any(part -> part == "h2-ok".as_bytes()) {
        header := [U8#9]{0, 0, 0, 0, 0, 0, 0, 0, 0}
        stream.read_exact(&header).unwrap()
        length :: (USize(header[0]) << 16) | (USize(header[1]) << 8) | USize(header[2])
        payload := [U8]{0}.repeat(length)
        stream.read_exact(&payload).unwrap()
        reused.extend(^payload)
    }
    shutdown.store(true, Ordering.Release)
    drop(^stream)
    report :: server.join().unwrap()
    assert_eq(report.user_accepted, 1)
    empty_mux :: jet_http_mux_new()
    (client, server_stream) := {
        listener :: TcpListener.bind("127.0.0.1:0").unwrap()
        addr :: listener.local_addr().unwrap()
        client :: TcpStream.connect(addr).unwrap()
        (server, _) :: listener.accept().unwrap()
        (client, server)
    }
    client.write_all("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".as_bytes()).unwrap()
    client.write_all(frame(0, 0, 0, "illegal stream-zero data".as_bytes())).unwrap()
    client.flush().unwrap()
    server_stream.set_read_timeout(Val(Duration.from_secs(1))).unwrap()
    assert(jet_http2_serve(&server_stream, empty_mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None).is_err())
}
