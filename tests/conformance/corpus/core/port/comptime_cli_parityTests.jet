        loop (label, output) in [("AOT", &aot), ("default `jet run`", &default)] {
            assert(output.status.success(), "{label} typed entry {argv.debug()} failed:\n{String.from_utf8_lossy(output.stderr)}")
            assert_eq(String.from_utf8_lossy(output.stdout), expected, "{label} typed entry {argv.debug()} decoded the wrong values")
        }
    }
}
// Rust: tests/comptime_cli_parity.rs:990
#Test("canonical_cli_recipe_rejects_bad_argv_and_matches_native_tiers") {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    scratch :: common.Scratch.new("canonical_cli_recipe")
    fixtures :: [("Examples/features/cli/typed_entry_args.jet", "typed.jet"), ("Examples/features/io/args_spec.jet", "builder.jet"), ("Examples/features/cli/positionals.jet", "positionals.jet")]
    loop (source, name) in fixtures {
        fs.copy(root.join(source), scratch.join(name)).unwrap_or_else(|error| -> panic("copy `{source}`: {error}"))
    }
    binaries := [(String, OSPath)]{}
    loop (_, name) in fixtures {
        build :: run_jet(["build", name], scratch.path, scratch.join("cache/build-{name}"))
        assert(build.status.success(), "AOT build of `{name}` failed:\n{String.from_utf8_lossy(build.stderr)}")
        stem :: name.strip_suffix(".jet").expect("fixture extension")
        &binaries.push((name, scratch.join(".jet").join("build").join(stem)))
    }
    loop (name, binary) in binaries {
        aot_help :: Command.new(binary).arg("--help").current_dir(scratch.path).output().unwrap_or_else(|error| -> panic("run AOT `{name} --help`: {error}"))
        default_help :: run_jet(["run", name, "--", "--help"], scratch.path, scratch.join("cache/help-default-{name}"))
        interpreted_help :: run_jet(["run", "--interpret", name, "--", "--help"], scratch.path, scratch.join("cache/help-interpreter-{name}"))
        loop (tier, output) in [("AOT", &aot_help), ("default `jet run`", &default_help), ("interpreter", &interpreted_help)] {
            assert_eq(output.status.code(), Val(0), "{tier} `{name} --help` failed:\n{String.from_utf8_lossy(output.stderr)}")
            assert(String.from_utf8_lossy(output.stdout).contains("Usage:"), "{tier} `{name} --help` omitted Usage")
        }
        assert_eq(help_body(aot_help.stdout), help_body(default_help.stdout), "AOT and default help body differs for `{name}`")
        assert_eq(help_body(aot_help.stdout), help_body(interpreted_help.stdout), "AOT and interpreter help body differs for `{name}`")
        bad_cases :: if name == "positionals.jet" {
            [("unknown", ["add", "--not-a-real-option"], ["unknown option", "Usage:"]), ("surplus", ["add", "accepted", "surplus-a", "surplus-b"], ["unexpected arguments", "`surplus-a`", "`surplus-b`", "Usage:"])]
        } else {
            [("unknown", ["--not-a-real-option"], ["unknown option", "Usage:"]), ("surplus", ["surplus-a", "surplus-b"], ["unexpected arguments", "`surplus-a`", "`surplus-b`", "Usage:"])]
        }
        loop (case, args, expected) in bad_cases {
            aot :: Command.new(binary).args(args).current_dir(scratch.path).output().unwrap_or_else(|error| -> panic("run AOT `{name}` {case}: {error}"))
            assert_cli_rejection(aot, "AOT `{name}` {case}", expected)
            run_args := ["run", name, "--"]
            &run_args.extend(args.iter().copied())
            default :: run_jet(run_args, scratch.path, scratch.join("cache/{case}-default-{name}"))
            assert_cli_rejection(default, "default `jet run` `{name}` {case}", expected)
            interpreted_args := ["run", "--interpret", name, "--"]
            &interpreted_args.extend(args.iter().copied())
            interpreted :: run_jet(interpreted_args, scratch.path, scratch.join("cache/{case}-interpreter-{name}"))
            assert_cli_rejection(interpreted, "interpreter `{name}` {case}", expected)
        }
    }
    (_, positionals) :: binaries.iter().find(|(name, _)| -> name == "positionals.jet").expect("positionals fixture binary")
    args :: ["add", "bare-loses", "--text", "named-wins"]
    aot :: Command.new(positionals).args(args).current_dir(scratch.path).output().expect("run AOT named-over-positional CLI")
    default :: run_jet(["run", "positionals.jet", "--", "add", "bare-loses", "--text", "named-wins"], scratch.path, scratch.join("cache/named-default"))
    interpreted :: run_jet(["run", "--interpret", "positionals.jet", "--", "add", "bare-loses", "--text", "named-wins"], scratch.path, scratch.join("cache/named-interpreter"))
    loop (tier, output) in [("AOT", &aot), ("default `jet run`", &default), ("interpreter", &interpreted)] {
        assert(output.status.success(), "{tier} named-over-positional CLI failed:\n{String.from_utf8_lossy(output.stderr)}")
        stdout :: String.from_utf8_lossy(output.stdout)
        assert(stdout.contains("named-wins"), "{tier} lost named value: {stdout}")
        assert(!stdout.contains("bare-loses"), "{tier} kept bare value: {stdout}")
    }
    assert_eq(aot.stdout, default.stdout)
    assert_eq(aot.stdout, interpreted.stdout)
}
// Rust: tests/comptime_cli_parity.rs:1200
#Test("builder_cli_named_value_overrides_positional_on_all_native_tiers") {
    scratch :: common.Scratch.new("builder_cli_named_precedence")
    fs.write(scratch.join("builder_named.jet"), """
use core.args as args
use core.process as process

fn run() {
    spec :: args.spec()
        .option("name", "display name", "NAME")
        .positional("name", "display name")
    parsed :: spec.parse_or_exit(process.argv())
    print(parsed.option("name") ?? "none")
}
""").expect("write builder precedence fixture")
    build :: run_jet(["build", "builder_named.jet"], scratch.path, scratch.join("cache/build"))
    assert(build.status.success(), "AOT build failed:\n{String.from_utf8_lossy(build.stderr)}")
    binary :: scratch.join(".jet/build/builder_named")
    args :: ["bare-loses", "--name", "named-wins"]
    aot :: Command.new(binary).args(args).current_dir(scratch.path).output().expect("run AOT builder precedence fixture")
    default :: run_jet(["run", "builder_named.jet", "--", "bare-loses", "--name", "named-wins"], scratch.path, scratch.join("cache/named-default"))
    interpreted :: run_jet(["run", "--interpret", "builder_named.jet", "--", "bare-loses", "--name", "named-wins"], scratch.path, scratch.join("cache/named-interpreter"))
    loop (tier, output) in [("AOT", &aot), ("default `jet run`", &default), ("interpreter", &interpreted)] {
        assert_eq(output.status.code(), Val(0), "{tier} builder precedence failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), "named-wins\n", "{tier} did not prefer the named value")
    }
    assert_eq(aot.stdout, default.stdout)
    assert_eq(aot.stdout, interpreted.stdout)
}
