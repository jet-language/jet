// Rust: tests/comptime_cli_parity.rs:331
#Test("computed_constants_match_aot_default_and_interpreter") {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    scratch :: common.Scratch.new("computed_constants_parity")
    source :: scratch.join("computed_constants.jet")
    fs.copy(root.join("Examples/features/comptime/computed_constants.jet"), source).expect("copy computed constants example")
    source_text :: fs.read_to_string(source).expect("read computed constants source")
    _ :: compile_with_path(source_text, source.to_string_lossy()).unwrap_or_else(|diags| -> panic("computed constants front end rejected: {diags.debug()}"))
    assert_enum_discriminants(source, "Code", [("First", Val(41i64)), ("Second", None)])
    expected :: fs.read(root.join("Examples/features/expected/comptime/computed_constants.out")).expect("read computed constants golden")
    cache :: scratch.join("cache")
    build :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["build", "computed_constants.jet"]).current_dir(scratch.path).env("JET_STORE_DIR", cache.join("build")).env("NO_COLOR", "1").output().expect("build computed constants example")
    assert(build.status.success(), "AOT computed constants build failed:\n{String.from_utf8_lossy(build.stderr)}")
    aot :: Command.new(scratch.join(".jet/build/computed_constants")).current_dir(scratch.path).output().expect("run AOT computed constants example")
    assert(aot.status.success(), "AOT computed constants run failed:\n{String.from_utf8_lossy(aot.stderr)}")
    default :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "computed_constants.jet"]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("run")).env("JET_STORE_DIR", cache.join("default")).env("NO_COLOR", "1").output().expect("run computed constants through default jet run")
    assert(default.status.success(), "default computed constants run failed:\n{String.from_utf8_lossy(default.stderr)}")
    interpreted :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "--interpret", "computed_constants.jet"]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("interpret-run")).env("JET_STORE_DIR", cache.join("interpret-build")).env("NO_COLOR", "1").output().expect("run computed constants through the interpreter")
    assert(interpreted.status.success(), "interpreter computed constants run failed:\n{String.from_utf8_lossy(interpreted.stderr)}")
    assert_eq(aot.stdout, expected, "AOT output differs from the golden")
    assert_eq(default.stdout, expected, "default `jet run` output differs from the golden")
    assert_eq(interpreted.stdout, expected, "interpreter output differs from the golden")
}
// Rust: tests/comptime_cli_parity.rs:602
#Test("comptime_enum_discriminants_keep_explicit_codes_when_implicit_case_moves") {
    scratch :: common.Scratch.new("enum_discriminant_codes")
    loop (stem, source, expected) in [("wire_code", ENUM_DISCRIMINANT_SOURCE, ENUM_DISCRIMINANTS), ("wire_code_implicit_first", ENUM_DISCRIMINANT_SOURCE_IMPLICIT_FIRST, ENUM_DISCRIMINANTS_IMPLICIT_FIRST)] {
        filename :: "{stem}.jet"
        path :: scratch.join(filename)
        fs.write(path, source).expect("write enum discriminant fixture")
        shown :: path.to_string_lossy()
        _ :: compile_with_path(source, shown).unwrap_or_else(|diagnostics| -> panic("enum discriminant codegen failed: {diagnostics.debug()}"))
        assert_enum_discriminants(path, "WireCode", expected)
    }
}
// Rust: tests/comptime_cli_parity.rs:627
#Test("comptime_enum_discriminants_keep_duplicates_and_report_invalid_expressions") {
    duplicate_scratch :: common.Scratch.new("enum_discriminant_duplicates")
    duplicate_path :: duplicate_scratch.join("duplicate_codes.jet")
    fs.write(duplicate_path, DUPLICATE_ENUM_DISCRIMINANT_SOURCE).expect("write duplicate enum discriminant fixture")
    shown :: duplicate_path.to_string_lossy()
    _ :: compile_with_path(DUPLICATE_ENUM_DISCRIMINANT_SOURCE, shown).unwrap_or_else(|diagnostics| -> panic("duplicate enum codes failed to compile: {diagnostics.debug()}"))
    assert_enum_discriminants(duplicate_path, "DuplicateCode", [("First", Val(7i64)), ("Second", Val(7i64))])
    loop (name, source, expression, expected_what) in ENUM_DISCRIMINANT_DIAGNOSTICS {
        scratch :: common.Scratch.new("enum_discriminant_{name}")
        path :: scratch.join("invalid.jet")
        fs.write(path, source).expect("write enum diagnostic fixture")
        assert_enum_discriminant_error(path, source, expression, expected_what)
    }
}
// Rust: tests/comptime_cli_parity.rs:650
#Test("job_runner_help_and_named_jobs_match_default_run_aot_and_goldens") {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    scratch :: common.Scratch.new("job_runner_cli_parity")
    source :: scratch.join("job_runner.jet")
    fs.write(scratch.join("package.jet"), "name: \"job_runner\"\nversion: \"0.1.0\"\n").expect("write job runner package manifest")
    fs.copy(root.join("Examples/features/devloop/job_runner.jet"), source).expect("copy job runner example")
    help_expected :: fs.read(root.join("Examples/features/expected/devloop/job_runner.out")).expect("read job runner help golden")
    cache :: scratch.join("cache")
    default_help :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "job_runner.jet"]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("default-run")).env("JET_STORE_DIR", cache.join("default-build")).env("NO_COLOR", "1").output().expect("run job runner through default jet run")
    assert(default_help.status.success(), "default job runner help failed:\n{String.from_utf8_lossy(default_help.stderr)}")
    assert_eq(default_help.stdout, help_expected)
    build :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["build", "job_runner.jet"]).current_dir(scratch.path).env("JET_STORE_DIR", cache.join("aot-build")).env("NO_COLOR", "1").output().expect("build job runner example")
    assert(build.status.success(), "AOT job runner build failed:\n{String.from_utf8_lossy(build.stderr)}")
    aot_help :: Command.new(scratch.join(".jet/build/job_runner")).current_dir(scratch.path).output().expect("run AOT job runner help")
    assert(aot_help.status.success(), "AOT job runner help failed:\n{String.from_utf8_lossy(aot_help.stderr)}")
    assert_eq(aot_help.stdout, help_expected)
    assert_eq(default_help.stdout, aot_help.stdout)
    default_jobs_help :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "job_runner.jet", "--", "--help"]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("job-help-run")).env("JET_STORE_DIR", cache.join("job-help-build")).env("NO_COLOR", "1").output().expect("show default job subcommand help")
    aot_jobs_help :: Command.new(scratch.join(".jet/build/job_runner")).arg("--help").current_dir(scratch.path).output().expect("show AOT job subcommand help")
    assert(default_jobs_help.status.success())
    assert(aot_jobs_help.status.success())
    assert(String.from_utf8_lossy(default_jobs_help.stdout).contains("greet"))
    assert(String.from_utf8_lossy(aot_jobs_help.stdout).contains("greet"))
    assert(!String.from_utf8_lossy(default_jobs_help.stdout).contains("inspect"))
    assert(!String.from_utf8_lossy(aot_jobs_help.stdout).contains("inspect"))
    loop (job, golden_name) in [("greet", "job_runner.greet.out"), ("seed_data", "job_runner.seed_data.out")] {
        expected :: fs.read(root.join("Examples/features/expected/devloop").join(golden_name)).unwrap_or_else(|error| -> panic("read named job golden `{golden_name}`: {error}"))
        default_job :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "job_runner.jet", "--", job]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("{job}-run")).env("JET_STORE_DIR", cache.join("{job}-build")).env("NO_COLOR", "1").output().unwrap_or_else(|error| -> panic("run named job `{job}`: {error}"))
        assert(default_job.status.success(), "default named job `{job}` failed:\n{String.from_utf8_lossy(default_job.stderr)}")
        assert_eq(default_job.stdout, expected, "default job `{job}` differs from golden")
        aot_job :: Command.new(scratch.join(".jet/build/job_runner")).arg(job).current_dir(scratch.path).output().unwrap_or_else(|error| -> panic("run AOT named job `{job}`: {error}"))
        assert(aot_job.status.success(), "AOT named job `{job}` failed:\n{String.from_utf8_lossy(aot_job.stderr)}")
        assert_eq(aot_job.stdout, expected, "AOT job `{job}` differs from golden")
        assert_eq(default_job.stdout, aot_job.stdout)
    }
}
// Rust: tests/comptime_cli_parity.rs:773
#Test("documented_cli_program_matches_aot_default_interpreter_and_goldens") {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    scratch :: common.Scratch.new("cli_docs_parity")
    source :: scratch.join("subcommands.jet")
    fs.copy(root.join("Examples/features/cli/subcommands.jet"), source).expect("copy CLI example")
    cache :: scratch.join("cache")
    build :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["build", "subcommands.jet"]).current_dir(scratch.path).output().expect("build CLI example")
    assert(build.status.success(), "AOT CLI build failed:\n{String.from_utf8_lossy(build.stderr)}")
    binary :: scratch.join(".jet/build/subcommands")
    loop args in [["--help"], ["serve", "--help"]] {
        aot :: Command.new(binary).args(args).current_dir(scratch.path).output().expect("run AOT CLI help")
        run_args := ["run", "subcommands.jet", "--"]
        &run_args.extend_from_slice(args)
        jit :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(run_args).current_dir(scratch.path).output().expect("run default CLI help")
        assert(aot.status.success(), "AOT help failed: {String.from_utf8_lossy(aot.stderr)}")
        assert(jit.status.success(), "default `jet run` help failed: {String.from_utf8_lossy(jit.stderr)}")
        assert_eq(aot.stdout, jit.stdout, "AOT and default `jet run` help differ for {args.debug()}")
        help :: String.from_utf8_lossy(aot.stdout)
        if args == ["--help"] {
            loop fact in ["-v, --verbose", "--config CONFIG", "plan                     preview changes", "serve                    Start the service and listen for requests", "import                   Import one data file"] {
                assert(help.contains(fact), "root help omitted {fact}: {help}")
            }
            assert_eq(help.matches("--config").count(), 1, "root help repeated shared config: {help}")
        } else {
            // #3733: command help contains command options, not root options.
            expected :: fs.read_to_string(root.join("Examples/features/expected/cli/subcommands.serve_help.out")).expect("read command help golden")
            assert_eq(help, expected, "command help differs from golden")
            assert(help.contains("--port PORT") && help.contains("[default: 3000]"), "command help omitted serve's --port: {help}")
            assert(!help.contains("--config"), "command help repeated the shared config: {help}")
        }
    }
    loop (args, golden_name) in [(["--config", "prod", "serve", "--port", "8080"], "subcommands.serve.out"), (["plan", "--config", "prod"], "subcommands.plan.out")] {
        expected :: fs.read(root.join("Examples/features/expected/cli").join(golden_name)).unwrap_or_else(|error| -> panic("read CLI command golden `{golden_name}`: {error}"))
        aot :: Command.new(binary).args(args).current_dir(scratch.path).output().expect("run AOT CLI command")
        run_args := ["run", "subcommands.jet", "--"]
        &run_args.extend_from_slice(args)
        default :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(run_args).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("{golden_name}-run")).env("JET_STORE_DIR", cache.join("{golden_name}-build")).env("NO_COLOR", "1").output().expect("run default CLI command")
        loop (label, output) in [("AOT", &aot), ("default `jet run`", &default)] {
            assert(output.status.success(), "{label} CLI command {args.debug()} failed:\n{String.from_utf8_lossy(output.stderr)}")
            assert_eq(output.stdout, expected, "{label} CLI command {args.debug()} differs from golden")
        }
    }
    unknown :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "subcommands.jet", "--", "--confg", "prod"]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", cache.join("unknown-run")).env("JET_STORE_DIR", cache.join("unknown-build")).env("NO_COLOR", "1").output().expect("run CLI with an unknown flag")
    assert(!unknown.status.success(), "unknown CLI flag was accepted")
    unknown_stderr :: String.from_utf8_lossy(unknown.stderr)
    assert(unknown_stderr.contains("--config"), "unknown CLI flag lost its suggestion:\n{unknown_stderr}")
}
