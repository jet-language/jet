// Rust: tests/core_math_numeric.rs:7
#Test("core_math_constants_and_rounding_match_across_tiers") {
    tir_support.assert_tiers_agree("core_math_numeric_boundaries", """
use core.math as math
fn run() -> {
    print(math.pi())
    print(math.round(1.4))
    print(math.round(1.5))
    print(math.round(-1.4))
    print(math.round(-1.5))
    print(math.round(0.5))
    print(math.round(-0.5))
}
""", "3.141592653589793\n1\n2\n-1\n-2\n1\n-1\n")
}

// Rust: tests/core_math_numeric.rs:28
#Test("core_math_exact_int_crosses_native_width_on_every_tier") {
    tir_support.assert_tiers_agree("core_math_exact_int_boundaries", """
use core.math as math
fn run() -> {
    print(math.checked_abs(-9223372036854775808) ?? -1)
    print(math.checked_neg(-9223372036854775808) ?? -1)
    print(math.checked_add(9223372036854775807, 1) ?? -1)
    print(math.checked_sub(-9223372036854775808, 1) ?? 0)
    print(math.checked_mul(9223372036854775808, 2) ?? -1)
    print(math.checked_div(-9223372036854775808, -1) ?? -1)
    print(math.checked_rem(-9223372036854775808, -1) ?? -1)
    print(math.checked_pow(2, 100) ?? -1)
    print(math.saturating_add(9223372036854775807, 1))
    print(math.saturating_mul(9223372036854775808, 2))
    print(math.int_pow(2, 100))
    print(math.sum_int([Int]{9223372036854775807, 1}))
    print(math.prod_int([Int]{9223372036854775808, 2}))
    print(math.abs_diff(-9223372036854775808, 9223372036854775808))
    print(math.checked_div(1, 0) == None)
    print(math.checked_pow(2, -1) == None)
    print(math.checked_div(-7, 3) ?? 0)
    print(math.checked_rem(-7, 3) ?? 0)
    floored :: math.div_mod(-7, 3)
    print(floored.quot)
    print(floored.rem)
    euclidean :: math.div_mod(-7, -3)
    print(euclidean.quot)
    print(euclidean.rem)
    truncated :: math.div_rem(-7, 3)
    print(truncated.quot)
    print(truncated.rem)
    wide :: math.div_mod(18446744073709551616, 3)
    print(wide.quot)
}
""", "9223372036854775808\n9223372036854775808\n9223372036854775808\n-9223372036854775809\n18446744073709551616\n9223372036854775808\n0\n1267650600228229401496703205376\n9223372036854775808\n18446744073709551616\n1267650600228229401496703205376\n9223372036854775808\n18446744073709551616\n18446744073709551616\ntrue\ntrue\n-2\n-1\n-3\n2\n3\n2\n-2\n-1\n6148914691236517205\n")
}

// Rust: tests/core_memory_foundations.rs:11
#Test("allocator_reset_close_and_scope_cleanup_keep_one_lifetime_contract") {
    tir_support.assert_tiers_agree("core_memory_foundations", """
use core.mem
use core.mem.scope as scope
fn run() -> {
    arena :: mem.Arena.new(capacity: 32)
    first :: arena.alloc(7)
    print(first)
    &arena.reset()
    second :: arena.alloc(11)
    print(second)
    fixed :: mem.Fixed.new(size: 40)
    fixed.try_alloc(7) ? value -> { print("success {value}") }
    ! error -> { print("unexpected failure {error.requested_bytes} {error.allocator}") }
    fixed.try_alloc(9) ? value -> { print("unexpected success {value}") }
    ! error -> { print("failure {error.requested_bytes} {error.allocator}") }
    close(^fixed)
    _outer :: scope.guard(() -> print("outer cleanup"))
    _inner :: scope.guard(() -> print("inner cleanup"))
    print("live")
    close(^arena)
}
""", "7\n11\nsuccess 7\nfailure 8 Fixed\nlive\ninner cleanup\nouter cleanup\n")
}

// Rust: tests/core_net_tls.rs:13
// GATE #4494 native tier providers; #4409 preserves exact invalid-input classification.
#Test("tls_rejects_empty_dns_labels_before_transport_on_all_tiers") {
    expected_error :: "invalid input during connect `bad..example`: host is empty or contains invalid endpoint syntax"
    tiers :: [
        ("default run", tir_support.jit_run("core_net_tls_invalid_dns_label", fixtures.INVALID_DNS_LABEL_SOURCE)),
        ("forced interpreter", tir_support.interpreter_run("core_net_tls_invalid_dns_label", fixtures.INVALID_DNS_LABEL_SOURCE)),
        ("AOT", tir_support.build_and_run_full("jet_core_net_tls_invalid_dns_label", "core_net_tls_invalid_dns_label", fixtures.INVALID_DNS_LABEL_SOURCE))
    ]
    baseline :: tiers[0].1
    loop (tier, result) in tiers {
        assert_eq(result, baseline, "{tier} disagreed on the TLS error")
        assert_eq(result.0, 1, "{tier} must report the invalid server name")
        assert(result.1.is_empty(), "{tier} wrote stdout: {result.1.debug()}")
        assert(result.2.contains(expected_error), "{tier} lost TLS error classification or context:\n{result.2}")
    }
}

// Rust: tests/core_net_tls.rs:51
#Test("tcp_stream_and_listener_reject_public_fields_and_forged_records") {
    source :: """
use core.net as net
fn run() -> {
    stream :: net.tcp_connect("127.0.0.1:1") ?? panic("connect")
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    print(stream.fd)
    print(stream.host)
    print(stream.port)
    print(listener.fd)
    print(listener.host)
    print(listener.port)
    _ :: net.TCPStream{fd: 0, host: "forged", port: 1}
    _ :: net.TCPListener{fd: 0, host: "forged", port: 1}
}
"""
    diagnostics :: tir_support.compile_source("private_tcp_handles", source).expect_err("public TCP fields and fabricated handles must be rejected")
    assert_eq(diagnostics.iter().filter(|diagnostic| -> diagnostic.code == "E0605").count(), 12,
        "all six private TCP field reads and six forged record fields must be rejected: {diagnostics.debug()}")
}

// Rust: tests/core_path_foundations.rs:7
#Test("core_path_containment_normalizes_and_rejects_traversal") {
    tir_support.assert_tiers_agree("core_path_foundations", """
use core.files.path as api
fn run() -> {
    print(api.is_relative_to("/srv/root/./a/../file", "/srv/root"))
    print(api.is_relative_to("srv\\root\\file", "srv/root"))
    print(api.is_relative_to("srv/root/link/../file", "srv/root"))
    print(api.is_relative_to("/srv/rooted/file", "/srv/root"))
    print(api.is_relative_to("/srv/root/../outside", "/srv/root"))
    print(api.is_relative_to("child/file", "."))
    print(api.is_relative_to("../outside", "."))
    print(api.is_relative_to("..foo/file", "."))
    print(api.is_relative_to("C:\\root\\child", "C:/root"))
    print(api.is_relative_to("/srv/root", "srv/root"))
}
""", "true\ntrue\ntrue\nfalse\nfalse\ntrue\nfalse\ntrue\ntrue\nfalse\n")
}

