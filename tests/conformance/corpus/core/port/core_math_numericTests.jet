// Rust: tests/core_testing_history.rs:158
#Test("core_testing_histories_callback_failure_becomes_unavailable_across_i9_tiers") {
    tiers :: [
        ("default run", tir_support.jit_run("core_testing_histories_callback_failure", fixtures.CALLBACK_FAILURE_SOURCE)),
        ("forced interpreter", tir_support.interpreter_run("core_testing_histories_callback_failure", fixtures.CALLBACK_FAILURE_SOURCE)),
        ("AOT", tir_support.build_and_run_full("jet_core_testing_histories_callback_failure", "core_testing_histories_callback_failure", fixtures.CALLBACK_FAILURE_SOURCE))
    ]
    baseline :: tiers[0].1
    loop (tier, result) in tiers {
        assert_eq(result, baseline, "{tier} disagreed on callback failure")
        assert_eq(result.0, 0, "{tier} failed:\n{result.2}")
        assert(result.1.starts_with("unavailable\n"), "{tier} did not preserve the unavailable comparison:\n{result.1}")
        assert(result.1.contains("history callback marker"), "{tier} lost the typed callback failure:\n{result.1}")
        assert(result.2.is_empty(), "{tier} wrote stderr: {result.2.debug()}")
    }
}

// Rust: tests/core_time_foundations.rs:7
#Test("core_time_epoch_splits_and_rejects_integer_overflow_across_tiers") {
    tir_support.assert_tiers_agree("core_time_epoch_foundations", """
use core.time as time
fn run() -> {
    print(time.from_unix_nanoseconds(-1).format_rfc3339())
    print(time.from_unix_microseconds(-1).format_rfc3339())
    print(time.from_unix_ms(-1).format_rfc3339())
    print(time.from_unix_seconds(-1).format_rfc3339())
    if time.parse("2024-02-29") == {
        .Ok(date) -> print("leap:{date}")
        .Err(_) -> print("leap:rejected")
    }
    if time.parse("2023-02-29") == {
        .Ok(_) -> print("bad-leap:accepted")
        .Err(_) -> print("bad-leap:rejected")
    }
    if time.parse("9223372036854775808-01-01") == {
        .Ok(_) -> print("wide-year:accepted")
        .Err(_) -> print("wide-year:rejected")
    }
}
""", "1969-12-31T23:59:59.999999999Z\n1969-12-31T23:59:59.999999000Z\n1969-12-31T23:59:59.999000000Z\n1969-12-31T23:59:59Z\nleap:2024-02-29\nbad-leap:rejected\nwide-year:rejected\n")
}

