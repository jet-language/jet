use core.math.runtime.top_math_lib_pure.[JetComplex]
use core.math.runtime.top_math_complex_traits.*
use core.prelude.runtime.kernel_values.[JetShow, JetDisplay, JetDebug]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathComplexTraits.rs:5/11/17
#Test("complex_native_trait_adapters_share_canonical_display") {
    value :: JetComplex.from_parts(1.5, -2.0)
    assert_eq(value.jet_show(), value.to_string_rep())
    assert_eq(value.jet_display(), value.to_string_rep())
    assert_eq(value.jet_debug(), value.to_string_rep())
    assert_eq(value.jet_show(), "1.5 - 2i")
}
