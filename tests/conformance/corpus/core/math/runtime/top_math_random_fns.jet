use core.math.runtime.top_math_random_fns.*

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:106/122/128/324
#Test("ambient_or_world_rng_reseeding_replays_the_same_stream") {
    jet_std_random_seed(73)
    first :: jet_std_random_bytes(12)
    jet_std_random_seed(73)
    second :: jet_std_random_bytes(12)
    assert_eq(first, second)
    assert_eq(first.len(), 12)
    assert_eq(jet_std_random_getrandbits(-1), 0)
    assert(jet_std_random_bytes(-1).is_empty())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:69/78/84/142/161/176/264
#Test("math_and_random_degenerate_domains_preserve_original_return_values") {
    assert_eq(jet_std_math_sign(F64.NAN), I64{0})
    assert_eq(jet_std_math_checked_pow(2, -1), None)
    assert_eq(jet_std_math_int_pow(2, -1), I64{0})
    assert_eq(jet_std_random_int(4, 4), I64{4})
    assert_eq(jet_std_random_randrange(4, 2), I64{4})
    assert(not jet_std_random_bool(F64.NAN))
    assert(jet_std_random_bool(1.0))
    assert_eq(jet_std_random_exponential(F64.NAN), 0.0)
    assert_eq(jet_std_random_binomial(8, 1.0), I64{8})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomFns.rs:182/275/282/305
#Test("random_selection_rejects_missing_weights_and_bounds_without_replacement") {
    xs :: [I64{10}, I64{20}, I64{30}]
    assert_eq(jet_std_random_weighted_pick(&xs, &[0.0, -1.0, F64.NAN]), None)
    assert_eq(jet_std_random_weighted_pick(&xs, &[1.0]), None)
    assert(jet_std_random_choices(&xs, -3).is_empty())
    jet_std_random_seed(17)
    selected := jet_std_random_sample(&xs, 9)
    selected.sort()
    assert_eq(selected, xs)
}
