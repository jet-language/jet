use core.math.runtime.top_math_lib_pure.*

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:14/26/33/45
#Test("complex_arithmetic_uses_shared_pair_policy_and_signed_display") {
    left :: JetComplex.from_parts(1.0, 2.0)
    right :: JetComplex.from_parts(3.0, -4.0)
    product :: left.mul(&right)
    assert_eq(product.real, 11.0)
    assert_eq(product.imaginary, 2.0)
    quotient :: product.div(&right)
    assert_eq(quotient.real, 1.0)
    assert_eq(quotient.imaginary, 2.0)
    assert_eq(right.to_string_rep(), "3 - 4i")
    assert_eq(JetComplex.from_parts(0.0, -0.0).to_string_rep(), "0 - 0i")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:143/165/194/208
#Test("statistics_compensated_sum_and_prefix_sequences_preserve_order") {
    assert_eq(jet_std_math_fsum([1.0e16, 1.0, 1.0, -1.0e16]), 2.0)
    assert_eq(jet_stats_cumsum([1.0, 2.0, 3.0]), [1.0, 3.0, 6.0])
    assert_eq(jet_stats_cumprod([2.0, 3.0, 4.0]), [2.0, 6.0, 24.0])
    assert_eq(jet_stats_moving_average([1.0, 3.0, 5.0], 2), [1.0, 2.0, 4.0])
    assert_eq(jet_stats_ewma([2.0, 4.0, 8.0], 0.5), [2.0, 3.0, 5.5])
    assert(jet_stats_zscore([2.0, 2.0]).is_empty())
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:269/335/342/355/369
#Test("statistics_quantiles_and_tied_modes_preserve_first_occurrence") {
    assert_eq(jet_stats_quantile([4.0, 1.0, 3.0, 2.0], 0.25), Val(1.75))
    assert_eq(jet_stats_median_low([4.0, 1.0, 3.0, 2.0]), Val(2.0))
    assert_eq(jet_stats_median_high([4.0, 1.0, 3.0, 2.0]), Val(3.0))
    assert_eq(jet_stats_mode([3.0, 2.0, 3.0, 2.0]), Val(3.0))
    assert_eq(jet_stats_multimode([3.0, 2.0, 3.0, 2.0]), [3.0, 2.0])
    assert_eq(jet_stats_quantile([], 0.5), None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:388/393/409/424/595
#Test("statistics_sample_population_and_histogram_denominators_remain_distinct") {
    assert_eq(jet_stats_pvariance([1.0, 3.0]), Val(1.0))
    assert_eq(jet_stats_variance([1.0, 3.0]), Val(2.0))
    assert_eq(jet_stats_covariance([1.0, 3.0], [2.0, 6.0]), Val(4.0))
    assert_eq(jet_stats_covariance_population([1.0, 3.0], [2.0, 6.0]), Val(2.0))
    assert_eq(jet_stats_histogram([2.0, 2.0, 2.0], 3), [I64{3}, I64{0}, I64{0}])
    assert_eq(jet_stats_histogram([0.0, 1.0, 2.0], 2), [I64{1}, I64{2}])
    assert_eq(jet_stats_covariance([1.0], [2.0]), None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:783/787/795/799/812/820
#Test("math_word_bits_rounding_and_remainder_semantics_remain_distinct") {
    assert_eq(jet_std_math_div_mod(-7, 3), (I64{-3}, I64{2}))
    assert_eq(jet_std_math_div_rem(-7, 3), (I64{-2}, I64{-1}))
    assert_eq(jet_std_math_round(2.5), I64{3})
    assert_eq(jet_std_math_round(-2.5), I64{-3})
    assert_eq(jet_std_math_min_f64(F64.NAN, 7.0), 7.0)
    assert_eq(jet_std_math_to_bits(-0.0), I64.MIN)
    assert(jet_std_math_from_bits(I64.MIN).is_sign_negative())
    assert_eq(jet_std_math_to_bits(jet_std_math_from_bits(I64{0x3ff0000000000000})), I64{0x3ff0000000000000})
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:894/904/1714
#Test("integer_number_theory_preserves_checked_intermediate_failures") {
    assert_eq(jet_std_math_gcd(-18, 24), I64{6})
    assert_eq(jet_std_math_lcm(6, -8), I64{24})
    assert_eq(jet_std_math_gcd_many(&[I64{18}, I64{24}, I64{30}]), I64{6})
    assert_eq(jet_std_math_lcm_many(&[]), I64{0})
    assert_eq(jet_std_math_powmod(-2, 3, 5), Val(I64{2}))
    assert_eq(jet_std_math_powmod(2, 0, 1), Val(I64{0}))
    assert_eq(jet_std_math_powmod(2, -1, 5), None)
    // The source squares the factor even on the final iteration.
    assert_eq(jet_std_math_powmod(I64.MAX - 1, 1, I64.MAX), None)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:972/980/988/995/1012/1061
#Test("combinator_sequence_filters_keep_original_boundaries") {
    assert_eq(jet_comb_compress([1, 2, 3], [true, false]), [I64{1}])
    assert_eq(jet_comb_drop([1, 2], -1), [I64{1}, I64{2}])
    assert_eq(jet_comb_takewhile([1, 2, -1, 3], true), [I64{1}, I64{2}])
    assert_eq(jet_comb_dropwhile([1, 2, -1, 3], true), [I64{-1}, I64{3}])
    assert_eq(jet_comb_islice([0, 1, 2, 3, 4], 1, 5, 2), [I64{1}, I64{3}])
    assert(jet_comb_islice([1, 2], 0, 2, 0).is_empty())
    assert_eq(jet_comb_accumulate([I64.MAX, 1, -1]), [I64.MAX, I64.MAX, I64.MAX - 1])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:1076/1109/1137/1165/1238
#Test("combinator_enumeration_keeps_position_duplicates_and_empty_identity") {
    assert_eq(jet_comb_permutations([1, 1], 2), [[I64{1}, I64{1}], [I64{1}, I64{1}]])
    assert_eq(jet_comb_combinations([1, 2, 3], 2), [[I64{1}, I64{2}], [I64{1}, I64{3}], [I64{2}, I64{3}]])
    assert_eq(jet_comb_combinations_with_replacement([1, 2], 2), [[I64{1}, I64{1}], [I64{1}, I64{2}], [I64{2}, I64{2}]])
    assert_eq(jet_comb_product([], 0), [[]])
    assert(jet_comb_product([], 1).is_empty())
    assert_eq(jet_comb_powerset([1, 2]), [[], [I64{1}], [I64{2}], [I64{1}, I64{2}]])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:1303/1325/1340/1352/1364/1368/1386
#Test("pure_heap_and_bisection_keep_input_owners_and_tie_rules") {
    input :: [I64{3}, I64{1}, I64{2}]
    heap :: jet_coll_heapify(&input)
    assert_eq(input, [I64{3}, I64{1}, I64{2}])
    assert_eq(heap[0], I64{1})
    (rest, popped) :: jet_coll_heappop_pure(&heap)
    assert_eq(popped, Val(I64{1}))
    assert_eq(rest, [I64{2}, I64{3}])
    assert_eq(jet_coll_heappushpop_pure(&heap, 0), (heap.clone(), I64{0}))
    assert_eq(jet_coll_heapreplace_pure(&[], 7), ([I64{7}], None))
    sorted :: [I64{1}, I64{2}, I64{2}, I64{3}]
    assert_eq(jet_coll_bisect_left(&sorted, 2), I64{1})
    assert_eq(jet_coll_bisect_right(&sorted, 2), I64{3})
    assert_eq(jet_coll_merge_sorted(&[I64{1}, I64{3}], &[I64{1}, I64{2}]), [I64{1}, I64{1}, I64{2}, I64{3}])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/MathLibPure.rs:1480/1493/1497/1674/1739/1743
#Test("fixed_width_word_helpers_cover_minimum_value_and_half_open_ranges") {
    assert_eq(jet_std_math_digits(I64.MIN), I64{19})
    assert_eq(jet_std_math_digits(0), I64{1})
    assert_eq(jet_std_math_leading_ones(-1), I64{64})
    assert_eq(jet_std_math_trailing_ones(-1), I64{64})
    assert_eq(jet_std_math_checked_sub(I64.MIN, 1), None)
    assert_eq(jet_std_math_abs_diff(I64.MIN, I64.MAX), I64{-1})
    assert(jet_std_math_in_range(2, 2, 3))
    assert(!jet_std_math_in_range(3, 2, 3))
}
