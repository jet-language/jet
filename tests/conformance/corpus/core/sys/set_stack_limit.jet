// core-conformance: core.sys.set_stack_limit
use os: core.sys

run: fn() {
    limit: os.stack_limit() ?? panic("stack_limit")
    os.set_stack_limit(limit.soft, limit.hard) ?? panic("set_stack_limit")
    after: os.stack_limit() ?? panic("stack_limit after")
    print(after.soft == limit.soft && after.hard == limit.hard)
}
