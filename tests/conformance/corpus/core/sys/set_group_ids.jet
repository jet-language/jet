// core-conformance: core.sys.set_group_ids
use os: core.sys

run: fn() {
    #Unsafe("set the effective group ID to the one it already is, which needs no privilege, then refuse an ID out of range") {
        before: os.group_ids() ?? panic("group_ids")
        os.set_group_ids(effective: before.effective) ?? panic("set_group_ids(effective:)")
        after: os.group_ids() ?? panic("group_ids after")
        refused: os.set_group_ids(saved: 4294967295) ? ok -> false ! error -> (if error == {
            .InvalidInput(_) -> true
            .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
        })
        print(after.real == before.real && after.effective == before.effective && after.saved == before.saved && refused)
    }
}
