// core-conformance: core.sys.cpu_time
use os: core.sys

run: fn() {
    own: os.cpu_time() ?? panic("cpu_time")
    parent: os.cpu_time(os.getppid()) ?? panic("cpu_time(getppid())")
    missing: os.cpu_time(4194305) ? spent -> false ! error -> (if error == {
        .NotFound(_) -> true
        .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
    })
    print((own.in(.Nanoseconds) ?? 0) > 0 && (parent.in(.Nanoseconds) ?? -1) >= 0 && missing)
}
