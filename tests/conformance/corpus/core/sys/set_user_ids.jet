// core-conformance: core.sys.set_user_ids
use os: core.sys

run: fn() {
    #Unsafe("set the effective user ID to the one it already is, which needs no privilege, then refuse an ID out of range") {
        before: os.user_ids() ?? panic("user_ids")
        os.set_user_ids(effective: before.effective) ?? panic("set_user_ids(effective:)")
        after: os.user_ids() ?? panic("user_ids after")
        refused: os.set_user_ids(real: -2) ? ok -> false ! error -> (if error == { .InvalidInput(_) -> true else -> false })
        print(after.real == before.real && after.effective == before.effective && after.saved == before.saved && refused)
    }
}
