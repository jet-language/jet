// core-conformance: core.sys.groups
use os: core.sys

run: fn() {
    // The first group of /etc/group is found again by its name and its ID; a
    // name with a colon is never a group.
    rows: os.groups() ?? panic("groups")
    if rows.len() == 0 -> panic("/etc/group lists no group")
    named: os.group(rows[0].name) ?? panic("group")
    by_id: os.group_by_id(rows[0].gid) ?? panic("group_by_id")
    missing: if os.group("no such group: a colon never names one") == {
        .Ok(row) -> row == None
        .Err(error) -> false
    }
    print(named.gid == rows[0].gid && by_id.gid == rows[0].gid && missing)
}
