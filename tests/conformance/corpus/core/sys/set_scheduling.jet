// core-conformance: core.sys.set_scheduling
use os: core.sys

run: fn() {
    #Unsafe("move this short-lived witness to batch time sharing and back; neither needs privilege") {
        before: os.scheduling() ?? panic("scheduling")
        os.set_scheduling(.Batch) ?? panic("set_scheduling(.Batch)")
        batch: os.scheduling() ? policy -> (if policy == { .Batch -> true else -> false }) ! error -> false
        os.set_scheduling(before) ?? panic("set_scheduling(before)")
        // The priority check runs before the kernel sees the call.
        refused: os.set_scheduling(.RoundRobin{priority: 100}) ? ok -> false ! error -> (if error == { .InvalidInput(_) -> true else -> false })
        print(batch && refused)
    }
}
