// core-conformance: core.sys.set_wall_clock
use {
    os: core.sys
    time: core.time
}

run: fn() {
    #Unsafe("a time before 1970 is refused before it reaches the kernel, so the clock never changes") {
        refused: os.set_wall_clock(time.from_unix_seconds(-1)) ? ok -> false ! error -> (if error == { .InvalidInput(_) -> true else -> false })
        print(refused)
    }
}
