use core.sys.runtime.top_platform_family.[jet_std_os_family]
use core.sys.target as target
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/PlatformFamily.rs:3.
#Test("os_family_is_selected_target_not_compiler_host") {
    expected :: match target.selected_family() { .Unix -> "unix", .Windows -> "windows", .Wasm -> "wasm", .Other -> "" }
    assert(jet_std_os_family() == expected)
}
