// core-conformance: core.files.write
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-write")
    path :: Path.from(root).join("fixture.txt")
    files.write(path, "fixture").drop("the witness only needs call completion")
    print(true)
    text :: files.read(path) ?? panic("read")
    assert((text == "fixture"))
    files.remove_all(root) ?? panic("cleanup")
}
