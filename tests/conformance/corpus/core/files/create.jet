// core-conformance: core.files.create
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-create")
    path :: Path.from(root).join("fixture.txt")
    writer :: files.create(path) ?? panic("create")
    writer.write_line("fixture") ?? panic("write")
    writer.flush().drop("the witness only needs flush completion")
    print(true)
}
