// core-conformance: core.files.rename
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-rename")
    source: Path.from(root).join("source.txt")
    destination: Path.from(root).join("destination.txt")
    writer: files.create(source) ?? panic("create")
    writer.write_line("fixture") ?? panic("write")
    writer.flush() ?? panic("flush")
    print((() -> {
        files.rename(source, destination)
        true
    })())
}
