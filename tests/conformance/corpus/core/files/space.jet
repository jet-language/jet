// core-conformance: core.files.space
use api: core.files

run: fn() {
    room: api.space(".") ?? panic("space: {err}")
    print(room.total >= room.free && room.free >= room.available && room.available >= 0)
    print(room.used() == room.total - room.free)
    percent: room.used_percent()
    print(percent >= 0.0 && percent <= 100.0)
}
