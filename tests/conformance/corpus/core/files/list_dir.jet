// core-conformance: core.files.list_dir
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-list-dir")
    path :: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    result :: files.list_dir(root) ?? panic("list_dir")
    print(result.len())
    files.remove_all(root) ?? panic("cleanup")
}
