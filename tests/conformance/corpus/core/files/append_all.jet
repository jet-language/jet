// core-conformance: core.files.append_all
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-append-all")
    path: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    files.append_all(path, "+") ?? panic("append_all")
    print(true)
    text: files.read(path) ?? panic("read")
    assert((text == "fixture+"))
    files.remove_all(root) ?? panic("cleanup")
}
