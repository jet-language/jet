// core-conformance: core.files.append
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-append")
    path :: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    writer :: files.append(path) ?? panic("append")
    writer.write_line("+") ?? panic("write")
    writer.flush().drop("the witness only needs flush completion")
    print(true)
    files.remove_all(root) ?? panic("cleanup")
}
