    windows_decomposition("a/b/c", [String]{"a", "b", "c"}, false, false, Val("a/b"), Val("c"))
    windows_decomposition("a\\b\\c", [String]{"a", "b", "c"}, false, false, Val("a\\b"), Val("c"))
    windows_decomposition("\\a", [String]{"\\", "a"}, true, false, Val("\\"), Val("a"))
    windows_decomposition("c:\\foo.txt", [String]{"c:", "\\", "foo.txt"}, true, true, Val("c:\\"), Val("foo.txt"))
    windows_decomposition("\\\\server\\share\\foo.txt", [String]{"\\\\server\\share", "\\", "foo.txt"}, true, true, Val("\\\\server\\share\\"), Val("foo.txt"))
    windows_decomposition("\\\\server\\share", [String]{"\\\\server\\share", "\\"}, true, true, None, None)
    windows_decomposition("\\\\server", [String]{"\\", "server"}, true, false, Val("\\"), Val("server"))
    windows_decomposition("\\\\?\\bar\\foo.txt", [String]{"\\\\?\\bar", "\\", "foo.txt"}, true, true, Val("\\\\?\\bar\\"), Val("foo.txt"))
    windows_decomposition("\\\\?\\bar", [String]{"\\\\?\\bar"}, true, true, None, None)
