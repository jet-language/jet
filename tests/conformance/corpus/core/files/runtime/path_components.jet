fn push_case(platform: path_kernel.PathPlatform, original: String, added: String, expected: String) Never! {
    path := path_test(platform, original)
    source :: path_test(platform, added)
    path_kernel.push(&path, source)
    assert_eq(path_kernel.display(path), expected)
    // The borrowed span entry is the same actual push law, not another parser.
    second := path_test(platform, original)
    path_kernel.push_span(&second, source, path_kernel.PathSpan{start: 0, end: source.encoded.len()})
    assert_eq(second.encoded, path.encoded)
}
fn unix_push(original: String, added: String, expected: String) Never! { _ :: push_case(path_kernel.PathPlatform.Unix, original, added, expected) }
fn windows_push(original: String, added: String, expected: String) Never! { _ :: push_case(path_kernel.PathPlatform.Windows, original, added, expected) }

#Test("std 1.90 PathBuf push Unix: all 13 original rows") {
    _ :: unix_push("", "foo", "foo")
    _ :: unix_push("foo", "bar", "foo/bar")
    _ :: unix_push("foo/", "bar", "foo/bar")
    _ :: unix_push("foo//", "bar", "foo//bar")
    _ :: unix_push("foo/.", "bar", "foo/./bar")
    _ :: unix_push("foo./.", "bar", "foo././bar")
    _ :: unix_push("foo", "", "foo/")
    _ :: unix_push("foo", ".", "foo/.")
    _ :: unix_push("foo", "..", "foo/..")
    _ :: unix_push("foo", "/", "/")
    _ :: unix_push("/foo/bar", "/", "/")
    _ :: unix_push("/foo/bar", "/baz", "/baz")
    unix_push("/foo/bar", "./baz", "/foo/bar/./baz")
}

