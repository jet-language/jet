// Rust std 1.90.0 library/std/tests/path.rs: test_decompositions_unix/windows,
// test_push, test_pop, test_compare (component equality/prefix/suffix portion),
// test_only_separators/non_ascii_unicode/embedded_newline, test_stem_ext,
// test_set_extension/with_extension; pure platform state. Ordering/hash,
// allocator, OS absolute resolution and Cygwin are outside this packet.
use core.files.runtime.kernel_path_components as path_kernel

fn path_test(platform: path_kernel.PathPlatform, text: String) -> path_kernel.OSPath Never! {
    path_kernel.from_text(text, platform)
}
fn path_optional(path: path_kernel.OSPath, extent: path_kernel.PathSpan?) -> String? Never! {
    span :: extent ?? return None
    Val(path_kernel.display_span(path, span))
}
fn decomposition(platform: path_kernel.PathPlatform, text: String, expected: [String], rooted: Bool, absolute: Bool, parent: String?, name: String?) Never! {
    path :: path_test(platform, text)
    assert_eq(path_kernel.has_root(path), rooted)
    assert_eq(path_kernel.is_absolute(path), absolute)
    assert_eq(path_kernel.is_relative(path), !absolute)
    forward := path_kernel.components(path)
    loop word in expected {
        value :: path_kernel.next(path, &forward) ?? panic("missing forward component")
        assert_eq(path_kernel.component_display(path, value), word)
    }
    assert(path_kernel.next(path, &forward) == None)
    assert(path_kernel.next_back(path, &forward) == None)
    reverse := path_kernel.components(path)
    at := expected.len()
    loop at > 0 {
        at = at - 1
        value :: path_kernel.next_back(path, &reverse) ?? panic("missing reverse component")
        assert_eq(path_kernel.component_display(path, value), expected[at])
    }
    assert(path_kernel.next_back(path, &reverse) == None)
    assert(path_kernel.next(path, &reverse) == None)
    // Every front/back meet point: roots/prefixes must not be emitted twice.
    loop split in 0..expected.len() {
        mixed := path_kernel.components(path)
        loop i in 0..<split {
            value :: path_kernel.next(path, &mixed) ?? panic("mixed forward")
            assert_eq(path_kernel.component_display(path, value), expected[i])
        }
        i := expected.len()
        loop i > split {
            i = i - 1
            value :: path_kernel.next_back(path, &mixed) ?? panic("mixed back")
            assert_eq(path_kernel.component_display(path, value), expected[i])
        }
        assert(path_kernel.next(path, &mixed) == None)
        assert(path_kernel.next_back(path, &mixed) == None)
    }
    assert_eq(path_optional(path, path_kernel.parent_span(path)), parent)
    assert_eq(path_optional(path, path_kernel.file_name_span(path)), name)
}
fn unix_decomposition(text: String, expected: [String], rooted: Bool, parent: String?, name: String?) Never! {
    decomposition(path_kernel.PathPlatform.Unix, text, expected, rooted, rooted, parent, name)
}
fn windows_decomposition(text: String, expected: [String], rooted: Bool, absolute: Bool, parent: String?, name: String?) Never! {
    decomposition(path_kernel.PathPlatform.Windows, text, expected, rooted, absolute, parent, name)
}

#Test("std 1.90 Unix decompositions: all 30 original component/root/parent/name rows") {
    unix_decomposition("", [String]{}, false, None, None)
    unix_decomposition("foo", [String]{"foo"}, false, Val(""), Val("foo"))
    unix_decomposition("/", [String]{"/"}, true, None, None)
    unix_decomposition("/foo", [String]{"/", "foo"}, true, Val("/"), Val("foo"))
    unix_decomposition("foo/", [String]{"foo"}, false, Val(""), Val("foo"))
    unix_decomposition("/foo/", [String]{"/", "foo"}, true, Val("/"), Val("foo"))
    unix_decomposition("foo/bar", [String]{"foo", "bar"}, false, Val("foo"), Val("bar"))
    unix_decomposition("/foo/bar", [String]{"/", "foo", "bar"}, true, Val("/foo"), Val("bar"))
    unix_decomposition("///foo///", [String]{"/", "foo"}, true, Val("/"), Val("foo"))
    unix_decomposition("///foo///bar", [String]{"/", "foo", "bar"}, true, Val("///foo"), Val("bar"))
    unix_decomposition("./.", [String]{"."}, false, Val(""), None)
    unix_decomposition("/..", [String]{"/", ".."}, true, Val("/"), None)
    unix_decomposition("../", [String]{".."}, false, Val(""), None)
    unix_decomposition("foo/.", [String]{"foo"}, false, Val(""), Val("foo"))
    unix_decomposition("foo/..", [String]{"foo", ".."}, false, Val("foo"), None)
    unix_decomposition("foo/./", [String]{"foo"}, false, Val(""), Val("foo"))
    unix_decomposition("foo/./bar", [String]{"foo", "bar"}, false, Val("foo"), Val("bar"))
    unix_decomposition("foo/../", [String]{"foo", ".."}, false, Val("foo"), None)
    unix_decomposition("foo/../bar", [String]{"foo", "..", "bar"}, false, Val("foo/.."), Val("bar"))
    unix_decomposition("./a", [String]{".", "a"}, false, Val("."), Val("a"))
    unix_decomposition(".", [String]{"."}, false, Val(""), None)
    unix_decomposition("./", [String]{"."}, false, Val(""), None)
    unix_decomposition("a/b", [String]{"a", "b"}, false, Val("a"), Val("b"))
    unix_decomposition("a//b", [String]{"a", "b"}, false, Val("a"), Val("b"))
    unix_decomposition("a/./b", [String]{"a", "b"}, false, Val("a"), Val("b"))
    unix_decomposition("a/b/c", [String]{"a", "b", "c"}, false, Val("a/b"), Val("c"))
    unix_decomposition(".foo", [String]{".foo"}, false, Val(""), Val(".foo"))
    unix_decomposition("a/.foo", [String]{"a", ".foo"}, false, Val("a"), Val(".foo"))
    unix_decomposition("a/.rustfmt.toml", [String]{"a", ".rustfmt.toml"}, false, Val("a"), Val(".rustfmt.toml"))
    unix_decomposition("a/.x.y.z", [String]{"a", ".x.y.z"}, false, Val("a"), Val(".x.y.z"))
}

