fn pop_case(platform: path_kernel.PathPlatform, original: String, expected: String, changed: Bool) Never! {
    path := path_test(platform, original)
    assert_eq(path_kernel.pop(&path), changed)
    assert_eq(path_kernel.display(path), expected)
}
fn windows_pop(original: String, expected: String, changed: Bool) Never! { _ :: pop_case(path_kernel.PathPlatform.Windows, original, expected, changed) }

#Test("std 1.90 pop: 9 shared rows on both platforms and 25 Windows rows") {
    platforms :: [path_kernel.PathPlatform]{path_kernel.PathPlatform.Unix, path_kernel.PathPlatform.Windows}
    loop platform in platforms {
        _ :: pop_case(platform, "", "", false)
        _ :: pop_case(platform, "/", "/", false)
        _ :: pop_case(platform, "foo", "", true)
        _ :: pop_case(platform, ".", "", true)
        _ :: pop_case(platform, "/foo", "/", true)
        _ :: pop_case(platform, "/foo/bar", "/foo", true)
        _ :: pop_case(platform, "foo/bar", "foo", true)
        _ :: pop_case(platform, "foo/.", "", true)
        _ :: pop_case(platform, "foo//bar", "foo", true)
    }
    _ :: windows_pop("a\\b\\c", "a\\b", true)
    _ :: windows_pop("\\a", "\\", true)
    _ :: windows_pop("\\", "\\", false)
    _ :: windows_pop("C:\\a\\b", "C:\\a", true)
    _ :: windows_pop("C:\\a", "C:\\", true)
    _ :: windows_pop("C:\\", "C:\\", false)
    _ :: windows_pop("C:a\\b", "C:a", true)
    _ :: windows_pop("C:a", "C:", true)
    _ :: windows_pop("C:", "C:", false)
    _ :: windows_pop("\\\\server\\share\\a\\b", "\\\\server\\share\\a", true)
    _ :: windows_pop("\\\\server\\share\\a", "\\\\server\\share\\", true)
    _ :: windows_pop("\\\\server\\share", "\\\\server\\share", false)
    _ :: windows_pop("\\\\?\\a\\b\\c", "\\\\?\\a\\b", true)
    _ :: windows_pop("\\\\?\\a\\b", "\\\\?\\a\\", true)
    _ :: windows_pop("\\\\?\\a", "\\\\?\\a", false)
    _ :: windows_pop("\\\\?\\C:\\a\\b", "\\\\?\\C:\\a", true)
    _ :: windows_pop("\\\\?\\C:\\a", "\\\\?\\C:\\", true)
    _ :: windows_pop("\\\\?\\C:\\", "\\\\?\\C:\\", false)
    _ :: windows_pop("\\\\?\\UNC\\server\\share\\a\\b", "\\\\?\\UNC\\server\\share\\a", true)
    _ :: windows_pop("\\\\?\\UNC\\server\\share\\a", "\\\\?\\UNC\\server\\share\\", true)
    _ :: windows_pop("\\\\?\\UNC\\server\\share", "\\\\?\\UNC\\server\\share", false)
    _ :: windows_pop("\\\\.\\a\\b\\c", "\\\\.\\a\\b", true)
    _ :: windows_pop("\\\\.\\a\\b", "\\\\.\\a\\", true)
    _ :: windows_pop("\\\\.\\a", "\\\\.\\a", false)
    windows_pop("\\\\?\\a\\b\\", "\\\\?\\a\\", true)
}

fn optional_owned_display(path: path_kernel.OSPath?) -> String? Never! {
    value :: path ?? return None
    Val(path_kernel.display(value))
}
fn strip_case(platform: path_kernel.PathPlatform, text: String, base: String, expected: String?) Never! {
    path :: path_test(platform, text)
    root :: path_test(platform, base)
    assert_eq(path_optional(path, path_kernel.strip_prefix_span(path, root)), expected)
    assert_eq(optional_owned_display(path_kernel.strip_prefix(path, root)), expected)
    assert_eq(path_kernel.starts_with(path, root), expected != None)
    // Compare optional values; bare Val(...) after == is a binding pattern.
    assert_eq(path_kernel.equals(path, root), expected == (Val("")))
    assert_eq(path_kernel.ends_with(path, root), expected == (Val("")) || base == "")
}
#Test("std 1.90 compare: every original strip_prefix row on actual platform state") {
    platforms :: [path_kernel.PathPlatform]{path_kernel.PathPlatform.Unix, path_kernel.PathPlatform.Windows}
    loop platform in platforms {
        _ :: strip_case(platform, "", "", Val(""))
        _ :: strip_case(platform, "foo", "", Val("foo"))
        _ :: strip_case(platform, "", "foo", None)
        _ :: strip_case(platform, "foo", "foo", Val(""))
        _ :: strip_case(platform, "foo/", "foo", Val(""))
        _ :: strip_case(platform, "foo//", "foo", Val(""))
        _ :: strip_case(platform, "foo///", "foo", Val(""))
        _ :: strip_case(platform, "foo/.", "foo", Val(""))
        _ :: strip_case(platform, "foo/./bar", "foo/bar", Val(""))
        _ :: strip_case(platform, "foo/.//bar", "foo/bar", Val(""))
        _ :: strip_case(platform, "foo//./bar", "foo/bar", Val(""))
        _ :: strip_case(platform, "foo/bar", "foo", Val("bar"))
        _ :: strip_case(platform, "foo/bar", "foobar", None)
        _ :: strip_case(platform, "foo/bar/baz", "foo/bar", Val("baz"))
        _ :: strip_case(platform, "foo/bar", "foo/bar/baz", None)
        _ :: strip_case(platform, "./foo/bar/", ".", Val("foo/bar"))
    }
    windows :: path_kernel.PathPlatform.Windows
    _ :: strip_case(windows, "C:\\src\\rust\\cargo-test\\test\\Cargo.toml", "c:\\src\\rust\\cargo-test\\test", Val("Cargo.toml"))
    _ :: strip_case(windows, "c:\\foo", "C:\\foo", Val(""))
    _ :: strip_case(windows, "C:\\foo\\.\\bar.txt", "C:\\foo\\bar.txt", Val(""))
    _ :: strip_case(windows, "C:\\foo\\.", "C:\\foo", Val(""))
    _ :: strip_case(windows, "\\\\?\\C:\\foo\\.\\bar.txt", "\\\\?\\C:\\foo\\bar.txt", None)
    _ :: strip_case(windows, "//server/share/pkg/a", "\\\\server\\share\\pkg", Val("a"))
    _ :: strip_case(windows, "C:\\pkg2\\a", "C:\\pkg", None)
    unix :: path_kernel.PathPlatform.Unix
    _ :: strip_case(unix, "/pkg2/a", "/pkg", None)
    _ :: strip_case(unix, "/pkg//a/./b///", "/pkg", Val("a/./b"))
    strip_case(unix, "/pkg/a", "/pkg//./", Val("a"))
}

#Test("std Windows prefix witnesses: exact drives, slash namespace and broken UNC") {
    windows :: path_kernel.PathPlatform.Windows
    assert_eq(path_kernel.parse_prefix(path_test(windows, "\\\\?\\C:/windows/system32/notepad.exe")).kind, path_kernel.PrefixKind.VerbatimDisk)
    assert_eq(path_kernel.parse_prefix(path_test(windows, "\\\\?\\C:\\windows\\system32\\notepad.exe")).kind, path_kernel.PrefixKind.VerbatimDisk)
    spellings :: [String]{"//?/C:/windows/system32/notepad.exe", "//?/C:\\windows\\system32\\notepad.exe", "/\\?\\C:\\windows\\system32\\notepad.exe", "\\\\?/C:\\windows\\system32\\notepad.exe"}
    loop spelling in spellings {
        path :: path_test(windows, spelling)
        prefix :: path_kernel.parse_prefix(path)
        assert_eq(prefix.kind, path_kernel.PrefixKind.UNC)
        assert_eq(path_kernel.display_span(path, prefix.first), "?")
        assert_eq(path_kernel.display_span(path, prefix.second), "C:")
    }
    windows_decomposition("\\\\foo\\\\bar\\\\", [String]{"\\", "foo", "bar"}, true, false, Val("\\\\foo"), Val("bar"))
    windows_decomposition("//foo//bar//", [String]{"\\", "foo", "bar"}, true, false, Val("//foo"), Val("bar"))
    path :: path_test(windows, "c:")
    cursor := path_kernel.components(path)
    value :: path_kernel.next(path, &cursor) ?? panic("drive")
    assert_eq(path_kernel.component_display(path, value), "c:")
    assert_eq(cursor.prefix.drive, U8{67})
    assert_eq(path_kernel.display_span(path, path_kernel.remaining_span(path, cursor)), "")
    assert_eq(path_kernel.parse_prefix(path_test(windows, "\\\\?\\C:foo")).kind, path_kernel.PrefixKind.Verbatim)
    assert_eq(path_kernel.parse_prefix(path_test(windows, "1:foo")).kind, path_kernel.PrefixKind.Absent)
}

#Test("std separators, Unicode, embedded newline and Unix drive/backslash traps") {
    unix_decomposition("/////", [String]{"/"}, true, None, None)
    windows_decomposition("/////", [String]{"\\"}, true, false, None, None)
    unix_decomposition("/tmp/❤/🚀/file.txt", [String]{"/", "tmp", "❤", "🚀", "file.txt"}, true, Val("/tmp/❤/🚀"), Val("file.txt"))
    unix_decomposition("foo\nbar", [String]{"foo\nbar"}, false, Val(""), Val("foo\nbar"))
    unix_decomposition("c:foo\\bar", [String]{"c:foo\\bar"}, false, Val(""), Val("c:foo\\bar"))
    unix_decomposition("\\\\server\\share", [String]{"\\\\server\\share"}, false, Val(""), Val("\\\\server\\share"))
    windows_decomposition("\\\\?\\C:\\a\\.\\..\\b", [String]{"\\\\?\\C:", "\\", "a", ".", "..", "b"}, true, true, Val("\\\\?\\C:\\a\\.\\.."), Val("b"))
}

fn identity_case(platform: path_kernel.PathPlatform, text: String, expected: String) Never! {
    path :: path_test(platform, text)
    assert_eq(path_kernel.display(path_kernel.normalize_identity(path)), expected)
    // Independent composition over the same real component owner: preserve the
    // compiler's pop-unconditionally/push-component rule for exceptional normals.
    reference := path_test(platform, "")
    cursor := path_kernel.components(path)
    loop {
        value :: path_kernel.next(path, &cursor) ?? break
        if value.kind == path_kernel.ComponentKind.ParentDir {
            _ :: path_kernel.pop(&reference)
        } else {
            if value.kind != path_kernel.ComponentKind.CurDir -> path_kernel.push_component(&reference, path, value)
        }
    }
    assert_eq(path_kernel.normalize_identity(path).encoded, reference.encoded)
}
#Test("PackageIdentity normalization is component-pop, not user collapse") {
    unix :: path_kernel.PathPlatform.Unix
    identity_case(unix, "../../a", "a")
    identity_case(unix, "a/../../b", "b")
    identity_case(unix, "./a//b/../c/.", "a/c")
    identity_case(unix, "/../../a", "/a")
    identity_case(unix, "", "")
    identity_case(unix, "..", "")
    identity_case(unix, ".", "")
    identity_case(unix, "C:a\\..\\b", "C:a\\..\\b")
    windows :: path_kernel.PathPlatform.Windows
    identity_case(windows, "c:..\\..\\a", "c:a")
    identity_case(windows, "C:\\..\\a", "C:\\a")
    identity_case(windows, "\\\\server\\share\\..\\a", "\\\\server\\share\\a")
    identity_case(windows, "\\\\?\\C:\\a\\.\\..\\b", "\\\\?\\C:\\b")
    identity_case(windows, "\\\\?\\C:\\foo/bar", "\\\\?\\C:\\foo\\bar")
    identity_case(windows, "\\\\?\\C:\\foo/../bar", "\\\\?\\C:\\bar")
    identity_case(windows, "C:\\a\\D:foo\\..\\bar", "D:bar")
    identity_case(windows, "\\\\?\\C:\\a\\D:foo/..\\bar", "D:foo/..\\bar")
    identity_case(windows, "\\\\?\\C:\\a\\/foo\\..\\bar", "\\\\?\\C:\\bar")
    identity_case(windows, "\\\\?\\C:\\a\\D:foo/./\\bar\\..", "D:foo")
    assert_eq(path_kernel.slash(path_test(unix, "a\\b")), "a/b")
    assert_eq(path_kernel.slash(path_test(unix, "")), ".")
}

#Test("OS bytes preserve invalid Unix identity and unpaired Windows UTF16 until display") {
    bytes :: [U8]{47, 112, 107, 103, 47, 255, 47, 97}
    path :: path_kernel.from_encoded(~bytes, path_kernel.PathPlatform.Unix)
    assert_eq(path.encoded, bytes)
    assert(path_kernel.to_str(path) == None)
    assert_eq(path_kernel.display(path), "/pkg/�/a")
    normalized :: path_kernel.normalize_identity(path)
    assert_eq(normalized.encoded, bytes)
    root :: path_test(path_kernel.PathPlatform.Unix, "/pkg")
    rest :: path_kernel.strip_prefix(path, root) ?? panic("invalid-byte strip")
    assert_eq(rest.encoded, [U8]{255, 47, 97})
    wide :: [U16]{67, 58, 92, 55296, 92, 56320, 92, 55357, 56960}
    windows :: path_kernel.from_windows_wide(wide)
    assert_eq(path_kernel.to_windows_wide(windows), wide)
    assert_eq(windows.encoded, [U8]{67, 58, 92, 237, 160, 128, 92, 237, 176, 128, 92, 240, 159, 154, 128})
    assert(path_kernel.to_str(windows) == None)
    assert_eq(path_kernel.display(windows), "C:\\�\\�\\🚀")
    assert_eq(path_kernel.slash(windows), "C:/�/�/🚀")
    assert_eq(path_kernel.normalize_identity(windows).encoded, windows.encoded)
    cursor := path_kernel.components(windows)
    _ :: path_kernel.next(windows, &cursor)
    _ :: path_kernel.next(windows, &cursor)
    surrogate :: path_kernel.next(windows, &cursor) ?? panic("surrogate component")
    assert_eq(surrogate.span.start, 3)
    assert_eq(surrogate.span.end, 6)
    assert_eq(path_kernel.component_display(windows, surrogate), "�")
}

#Test("borrowed path extents preserve retained spelling and never scan adjacent fields") {
    source :: path_test(path_kernel.PathPlatform.Unix, "x/pkg//a/./b///y")
    root :: path_test(path_kernel.PathPlatform.Unix, "z/pkgq")
    remainder :: path_kernel.strip_prefix_spans(source, path_kernel.PathSpan{start: 1, end: 14}, root, path_kernel.PathSpan{start: 1, end: 5}) ?? panic("span strip")
    assert_eq(path_kernel.display_span(source, remainder), "a/./b")
    source_windows :: path_test(path_kernel.PathPlatform.Windows, "xc:\\pkg\\aq")
    root_windows :: path_test(path_kernel.PathPlatform.Windows, "yC:\\pkgz")
    suffix :: path_kernel.strip_prefix_spans(source_windows, path_kernel.PathSpan{start: 1, end: 9}, root_windows, path_kernel.PathSpan{start: 1, end: 7}) ?? panic("drive span strip")
    assert_eq(path_kernel.display_span(source_windows, suffix), "a")
}

fn prefix_next_case(text: String, verbatim: Bool, component: String, rest: String) Never! {
    path :: path_test(path_kernel.PathPlatform.Windows, text)
    split :: path_kernel.prefix_next_component(path, path_kernel.PathSpan{start: 0, end: path.encoded.len()}, verbatim)
    assert_eq(path_kernel.display_span(path, split.component), component)
    assert_eq(path_kernel.display_span(path, split.rest), rest)
}
#Test("std Windows parse_next_component: all six original bounded byte parser rows") {
    _ :: prefix_next_case("server\\share", true, "server", "share")
    _ :: prefix_next_case("server/share", true, "server/share", "")
    _ :: prefix_next_case("server/share", false, "server", "share")
    _ :: prefix_next_case("server\\", false, "server", "")
    _ :: prefix_next_case("\\server\\", false, "", "server\\")
    prefix_next_case("servershare", false, "servershare", "")
}

fn file_parts_case(platform: path_kernel.PathPlatform, text: String, stem: String?, extension: String?) Never! {
    path :: path_test(platform, text)
    assert_eq(path_optional(path, path_kernel.file_stem_span(path)), stem)
    assert_eq(path_optional(path, path_kernel.extension_span(path)), extension)
}
#Test("std 1.90 stem and extension: all 11 original rows on both platforms") {
    platforms :: [path_kernel.PathPlatform]{path_kernel.PathPlatform.Unix, path_kernel.PathPlatform.Windows}
    loop platform in platforms {
        _ :: file_parts_case(platform, "foo", Val("foo"), None)
        _ :: file_parts_case(platform, "foo.", Val("foo"), Val(""))
        _ :: file_parts_case(platform, ".foo", Val(".foo"), None)
        _ :: file_parts_case(platform, "foo.txt", Val("foo"), Val("txt"))
        _ :: file_parts_case(platform, "foo.bar.txt", Val("foo.bar"), Val("txt"))
        _ :: file_parts_case(platform, "foo.bar.", Val("foo.bar"), Val(""))
        _ :: file_parts_case(platform, ".", None, None)
        _ :: file_parts_case(platform, "..", None, None)
        _ :: file_parts_case(platform, ".x.y.z", Val(".x.y"), Val("z"))
        _ :: file_parts_case(platform, "..x.y.z", Val("..x.y"), Val("z"))
        _ :: file_parts_case(platform, "", None, None)
        _ :: file_parts_case(platform, "a/.rustfmt.toml", Val(".rustfmt"), Val("toml"))
        _ :: file_parts_case(platform, "a/.x.y.z", Val(".x.y"), Val("z"))
    }
    windows :: path_kernel.PathPlatform.Windows
    spellings :: [String]{"c:\\foo.txt", "\\\\server\\share\\foo.txt", "\\\\?\\bar\\foo.txt", "\\\\?\\UNC\\server\\share\\foo.txt", "\\\\?\\C:\\foo.txt"}
    loop spelling in spellings -> _ :: file_parts_case(windows, spelling, Val("foo"), Val("txt"))
    _ :: file_parts_case(windows, "\\\\?\\C:\\foo.txt.zip", Val("foo.txt"), Val("zip"))
    _ :: file_parts_case(windows, "\\\\?\\C:\\.foo.txt.zip", Val(".foo.txt"), Val("zip"))
    file_parts_case(windows, "\\\\?\\C:\\.foo", Val(".foo"), None)
}
fn extension_case(platform: path_kernel.PathPlatform, original: String, extension: String, expected: String, changed: Bool) Never! {
    path := path_test(platform, original)
    source :: path_test(platform, original)
    assert_eq(path_kernel.set_extension(&path, extension), changed)
    assert_eq(path_kernel.display(path), expected)
    assert_eq(path_kernel.display(path_kernel.with_extension(source, extension)), expected)
}
#Test("std 1.90 set_extension 13 and with_extension 17 original rows on both platforms") {
    platforms :: [path_kernel.PathPlatform]{path_kernel.PathPlatform.Unix, path_kernel.PathPlatform.Windows}
    loop platform in platforms {
        extension_case(platform, "foo", "txt", "foo.txt", true)
        extension_case(platform, "foo.bar", "txt", "foo.txt", true)
        extension_case(platform, "foo.bar.baz", "txt", "foo.bar.txt", true)
        extension_case(platform, ".test", "txt", ".test.txt", true)
        extension_case(platform, "foo.txt", "", "foo", true)
        extension_case(platform, "foo", "", "foo", true)
        extension_case(platform, "", "foo", "", false)
        extension_case(platform, ".", "foo", ".", false)
        extension_case(platform, "foo/", "bar", "foo.bar", true)
        extension_case(platform, "foo/.", "bar", "foo.bar", true)
        extension_case(platform, "..", "foo", "..", false)
        extension_case(platform, "foo/..", "bar", "foo/..", false)
        extension_case(platform, "/", "foo", "/", false)
        extension_case(platform, "aaa_aaa_aaa", "bbb_bbb", "aaa_aaa_aaa.bbb_bbb", true)
        extension_case(platform, "bbb_bbb", "aaa_aaa_aaa", "bbb_bbb.aaa_aaa_aaa", true)
        extension_case(platform, "ccc.aaa_aaa_aaa", "bbb_bbb", "ccc.bbb_bbb", true)
        extension_case(platform, "ccc.bbb_bbb", "aaa_aaa_aaa", "ccc.aaa_aaa_aaa", true)
    }
    unix :: path_kernel.PathPlatform.Unix
    extension_case(unix, "path/to/file", "d\\test", "path/to/file.d\\test", true)
    bytes :: [U8]{255, 46, 111, 108, 100}
    opaque := path_kernel.from_encoded(~bytes, unix)
    assert(path_kernel.set_extension(&opaque, "jet"))
    assert_eq(opaque.encoded, [U8]{255, 46, 106, 101, 116})
    windows := path_kernel.from_windows_wide([U16]{67, 58, 92, 55296, 46, 111, 108, 100})
    assert(path_kernel.set_extension(&windows, "jet"))
    assert_eq(path_kernel.to_windows_wide(windows), [U16]{67, 58, 92, 55296, 46, 106, 101, 116})
}
