    windows_decomposition("\\\\.\\foo\\bar", [String]{"\\\\.\\foo", "\\", "bar"}, true, true, Val("\\\\.\\foo\\"), Val("bar"))
    windows_decomposition("\\\\.\\foo", [String]{"\\\\.\\foo", "\\"}, true, true, None, None)
