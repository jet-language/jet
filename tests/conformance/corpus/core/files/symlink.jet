// core-conformance: core.files.symlink
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-symlink")
    source :: Path.from(root).join("source.txt")
    link :: Path.from(root).join("link.txt")
    files.write(source, "fixture") ?? panic("seed")
    files.symlink(source, link).drop("the witness only needs call completion")
    print(true)
    assert((files.exists(link) == true))
    files.remove_all(root) ?? panic("cleanup")
}
