// core-conformance: core.files.read_at
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-read-at")
    path: Path.from(root).join("fixture.bin")
    files.write_bytes(path, [U8]{65, 66, 67, 68}) ?? panic("seed")
    result: files.read_at(path, 1, 2) ?? panic("read_at")
    assert((result.len() == 2))
    files.remove_all(root) ?? panic("cleanup")
}
