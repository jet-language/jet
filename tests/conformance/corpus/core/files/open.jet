// core-conformance: core.files.open
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-open")
    path :: Path.from(root).join("fixture.txt")
    writer :: files.create(path) ?? panic("create")
    writer.write_line("fixture") ?? panic("write")
    writer.flush() ?? panic("flush")
    reader :: files.open(path) ?? panic("open")
    print(reader.lines().get(0) ?? "")
}
