// core-conformance: core.files.write_bytes
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-write-bytes")
    path :: Path.from(root).join("fixture.bin")
    result :: files.write_bytes(path, [U8]{65, 66, 67, 68})
    print(result)
    files.remove_all(root) ?? panic("cleanup")
}
