// core-conformance: core.files.write_atomic
use {
    files :: core.files
    testing :: core.testing
}

fn run() {
    root :: testing.temp_dir("files-write-atomic")
    path :: Path.from(root).join("fixture.bin")
    print((() -> {
        files.write_atomic(path, [U8]{65, 66, 67, 68})
        true
    })())
    files.remove_all(root) ?? panic("cleanup")
}
