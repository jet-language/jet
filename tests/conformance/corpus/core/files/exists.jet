// core-conformance: core.files.exists
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-exists")
    path :: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    result :: files.exists(path)
    assert((result == true))
    files.remove_all(root) ?? panic("cleanup")
}
