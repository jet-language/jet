// core-conformance: core.files.remove_dir
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-remove-dir")
    path: Path.from(root).join("child")
    files.create_dir_all(path) ?? panic("create")
    print((fn() {
        files.remove_dir(path)
        true
    })())
    files.remove_all(root) ?? panic("cleanup")
}
