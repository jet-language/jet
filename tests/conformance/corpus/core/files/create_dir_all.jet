// core-conformance: core.files.create_dir_all
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-create-dir-all")
    path :: Path.from(root).join("nested").join("child")
    result :: files.create_dir_all(path)
    print(result)
    files.remove_all(root) ?? panic("cleanup")
}
