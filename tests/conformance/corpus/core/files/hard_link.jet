// core-conformance: core.files.hard_link
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-hard-link")
    source :: Path.from(root).join("source.txt")
    destination :: Path.from(root).join("destination.txt")
    files.write(source, "fixture") ?? panic("seed")
    files.hard_link(source, destination).drop("the witness only needs call completion")
    print(true)
    text :: files.read(destination) ?? panic("read")
    assert((text == "fixture"))
    files.remove_all(root) ?? panic("cleanup")
}
