// core-conformance: core.files.fsync
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-fsync")
    path: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    files.fsync(path) ?? panic("fsync")
    print(true)
    files.remove_all(root) ?? panic("cleanup")
}
