// core-conformance: core.files.create_dir
use {
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("files-create-dir")
    path: Path.from(root).join("child")
    files.create_dir(path) ?? panic("create_dir")
    print(true)
    files.remove_all(root) ?? panic("cleanup")
}
