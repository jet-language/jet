// core-conformance: core.files.canonicalize
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-canonicalize")
    path :: Path.from(root).join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    result :: files.canonicalize(path) ?? panic("canonicalize")
    print(result.len() > 0)
    files.remove_all(root) ?? panic("cleanup")
}
