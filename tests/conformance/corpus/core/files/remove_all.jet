// core-conformance: core.files.remove_all
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("files-remove-all")
    path :: Path.from(root).join("nested").join("fixture.txt")
    files.write(path, "fixture") ?? panic("seed")
    result :: files.remove_all(root)
    print(result)
}
