    assert_eq(text.words("a_a,:a"), [String]{"a_a", "a"})
    // UAX #29 word corpus line 1959
    assert_eq(text.words("a,.1"), [String]{"a", "1"})
    // UAX #29 word corpus line 1960
    assert_eq(text.words("a_1,.1"), [String]{"a_1", "1"})
    // UAX #29 word corpus line 1961
    assert_eq(text.words("a_a,.1"), [String]{"a_a", "1"})
    // UAX #29 word corpus line 1962
    assert_eq(text.words("a,.a"), [String]{"a", "a"})
    // UAX #29 word corpus line 1963
    assert_eq(text.words("a_1,.a"), [String]{"a_1", "a"})
    // UAX #29 word corpus line 1964
    assert_eq(text.words("a_a,.a"), [String]{"a_a", "a"})
    // UAX #29 word corpus line 1965
    assert_eq(text.words("a,,1"), [String]{"a", "1"})
    // UAX #29 word corpus line 1966
    assert_eq(text.words("a_1,,1"), [String]{"a_1", "1"})
    // UAX #29 word corpus line 1967
    assert_eq(text.words("a_a,,1"), [String]{"a_a", "1"})
    // UAX #29 word corpus line 1968
    assert_eq(text.words("a,,a"), [String]{"a", "a"})
    // UAX #29 word corpus line 1969
    assert_eq(text.words("a_1,,a"), [String]{"a_1", "a"})
    // UAX #29 word corpus line 1970
    assert_eq(text.words("a_a,,a"), [String]{"a_a", "a"})
    print("1944 words UAX29 KATs passed")
}
