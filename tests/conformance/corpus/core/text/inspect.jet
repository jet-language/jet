// core-conformance: core.text.inspect
use core.text as text

fn run() {
    assert_eq(text.inspect("A\u{200D}\n😀"), [
        "U+0041 LATIN CAPITAL LETTER A",
        "U+200D ZERO WIDTH JOINER",
        "U+000A LINE FEED (LF)",
        "U+1F600 GRINNING FACE",
    ])
    assert_eq(text.inspect("\u{0378}\u{4E00}"), [
        "U+0378 UNASSIGNED",
        "U+4E00 UNASSIGNED",
    ])
    result :: text.inspect("jet")
    print(result.len())
}
