// #4426: Rust Text.rs:887-921 default width and :939-940 scalar predicates.
// Unicode 17.0.0 JUCD assets are generated by gen-unicode-tables.mjs; no local
// ranges. Expected widths follow the Rust portable-default policy (not CJK).
use core.text as text_width

#Test("pinned default display width regression matrix") {
    cases :: [
        (text: "", width: 0),
        (text: "a", width: 1),
        (text: "★", width: 1), // U+2605, Ambiguous, not Emoji_Presentation
        (text: "​", width: 0), // U+200B
        (text: "ְ", width: 0), // Hebrew Mn, U+05B0
        (text: "ً", width: 0), // Arabic Mn, U+064B
        (text: "ऀ", width: 0), // Mn, CCC zero, U+0900
        (text: "⃝", width: 0), // Me, U+20DD
        (text: "؜", width: 0), // Cf and Default_Ignorable, U+061C
        (text: "؀", width: 1), // Cf Prepend, not Default_Ignorable, U+0600
        (text: "؀a", width: 1),
        (text: "aְ", width: 1),
        (text: "aً", width: 1),
        (text: String.from_bytes([U8]{0}) ?? panic("control fixture"), width: 0),
        (text: String.from_bytes([U8]{9, 13, 10, 127}) ?? panic("control fixture"), width: 0),
        (text: "界", width: 2),
        (text: "Ａ", width: 2),
        (text: "©", width: 1),
        (text: "©️", width: 2),
        (text: "a️", width: 1), // VS16 alone does not select emoji width
        (text: "́‍", width: 0), // U+0301 U+200D
        (text: "1⃣", width: 2), // U+0031 U+20E3
        (text: "1️⃣", width: 2),
        (text: "#️⃣", width: 2),
        (text: "*️⃣", width: 2),
        (text: "a⃣", width: 1), // exact keycap base rule
        (text: "⃣", width: 0),
        (text: "🇺🇸", width: 2),
        (text: "👩‍💻", width: 2),
        (text: "a★界​b", width: 5),
    ]
    loop row in cases -> assert_eq(text_width.display_width(row.text), row.width)
}

#Test("pinned Alphabetic and Numeric regression matrix") {
    cases :: [
        (text: "", alphabetic: false, numeric: false),
        (text: "aZ", alphabetic: true, numeric: false),
        (text: ";", alphabetic: false, numeric: false), // U+037E GREEK QUESTION MARK
        (text: "a;b", alphabetic: false, numeric: false),
        (text: "²", alphabetic: false, numeric: true), // No, U+00B2
        (text: "٣", alphabetic: false, numeric: true), // Nd
        (text: "Ⅻ", alphabetic: true, numeric: true), // Nl
        (text: "½", alphabetic: false, numeric: true),
        (text: "ͅ", alphabetic: true, numeric: false), // Other_Alphabetic Mn, U+0345
        (text: "ְ", alphabetic: true, numeric: false), // U+05B0
        (text: "Ж界", alphabetic: true, numeric: false),
        (text: "𐐀", alphabetic: true, numeric: false), // U+10400
        (text: "𝟎", alphabetic: false, numeric: true), // U+1D7CE
        (text: "2²٣", alphabetic: false, numeric: true),
        (text: "x²", alphabetic: false, numeric: false),
        (text: "★", alphabetic: false, numeric: false),
    ]
    loop row in cases {
        assert_eq(text_width.is_alphabetic(row.text), row.alphabetic)
        assert_eq(text_width.is_numeric(row.text), row.numeric)
    }
}

#Test("adjacent word classification and GB11 share pinned properties") {
    assert_eq(text_width.words("a;b"), [String]{"a", "b"})
    assert_eq(text_width.words("x²"), [String]{"x", "²"})
    assert_eq(text_width.graphemes("©‍©"), [String]{"©‍©"})
    assert_eq(text_width.display_width("©‍©"), 1)
}

// Rust Text.rs:416-466: literal pair/state segmentation feeding :916-921.
#Test("GB9c Indic conjunct state joins Consonant Linker Consonant only") {
    assert_eq(text_width.graphemes("क्ष"), [String]{"क्ष"}) // U+0915 U+094D U+0937
    assert_eq(text_width.display_width("क्ष"), 1)
    assert_eq(text_width.graphemes("क्‍ष"), [String]{"क्‍ष"}) // InCB Extend ZWJ keeps the linker state
    assert_eq(text_width.display_width("क्‍ष"), 1)
    assert_eq(text_width.graphemes("नमस्ते"), [String]{"न", "म", "स्ते"})
    assert_eq(text_width.display_width("नमस्ते"), 3)
    assert_eq(text_width.graphemes("क्a"), [String]{"क्", "a"})
    assert_eq(text_width.display_width("क्a"), 2)
    assert_eq(text_width.graphemes("कष"), [String]{"क", "ष"}) // no linker, no conjunct
    assert_eq(text_width.display_width("कष"), 2)
}

#Test("GB6-GB8 use pinned Hangul L V T LV LVT classes beyond modern jamo") {
    assert_eq(text_width.graphemes("ᄓᅡ"), [String]{"ᄓᅡ"}) // U+1113 L, U+1161 V
    assert_eq(text_width.display_width("ᄓᅡ"), 2)
    assert_eq(text_width.graphemes("ꥠᅡ"), [String]{"ꥠᅡ"}) // U+A960 L extended-A
    assert_eq(text_width.display_width("ꥠᅡ"), 2)
    assert_eq(text_width.graphemes("ᄀힰ"), [String]{"ᄀힰ"}) // U+1100 L, U+D7B0 V extended-B
    assert_eq(text_width.display_width("ᄀힰ"), 2)
    assert_eq(text_width.graphemes("가ᇃ"), [String]{"가ᇃ"}) // U+AC00 LV, U+11C3 T
    assert_eq(text_width.display_width("가ᇃ"), 2)
    assert_eq(text_width.graphemes("각가"), [String]{"각", "가"}) // LVT then LV breaks
    assert_eq(text_width.display_width("각가"), 4)
}

#Test("GB11 pictographic state survives ZWJ runs and adjacent control RI states") {
    assert_eq(text_width.graphemes("👩‍‍💻"), [String]{"👩‍‍💻"}) // U+1F469 ZWJ ZWJ U+1F4BB
    assert_eq(text_width.display_width("👩‍‍💻"), 2)
    assert_eq(text_width.graphemes("a‍👨"), [String]{"a‍", "👨"})
    assert_eq(text_width.display_width("a‍👨"), 3)
    assert_eq(text_width.graphemes("🇺🇸🇫"), [String]{"🇺🇸", "🇫"})
    assert_eq(text_width.display_width("🇺🇸🇫"), 4)
    assert_eq(text_width.graphemes(""), [String]{})
    assert_eq(text_width.display_width(""), 0)
    crlf :: String.from_bytes([U8]{97, 13, 10, 98}) ?? panic("CRLF fixture")
    assert_eq(text_width.graphemes(crlf), [String]{"a", String.from_bytes([U8]{13, 10}) ?? panic("CRLF part"), "b"})
    assert_eq(text_width.display_width(crlf), 2)
    bel_mark :: String.from_bytes([U8]{7, 204, 129}) ?? panic("control mark fixture")
    assert_eq(text_width.graphemes(bel_mark), [String]{String.from_bytes([U8]{7}) ?? panic("BEL part"), "́"})
    assert_eq(text_width.display_width(bel_mark), 0)
}
