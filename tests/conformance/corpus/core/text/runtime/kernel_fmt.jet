// core.text.fmt public contract rows (owner rulings on #4588, logged with Main):
// one implementation in Core/text/fmt.jet; the runtime kernel_fmt adapters delegate.
use core.text.fmt as fmt

#Test("fmt rows ruled by the owner and the unchanged shared rows") {
    assert_eq(fmt.percent(12345.6, 0), "1,234,560%")
    assert_eq(fmt.percent(Float{0.1234}, 1), "12.3%")
    assert_eq(fmt.sci(1234.0, 2), "1.23e3")
    assert_eq(fmt.sci(9.999, 2), "1.00e1")
    assert_eq(fmt.sci(0.00123, 2), "1.23e-3")
    assert_eq(fmt.sci(0.0, 2), "0.00e0")
    assert_eq(fmt.sci(Float{123.4}, 2), "1.23e2")
    assert_eq(fmt.pretty("P{{x: 1, y: 2}}"), "P {{\n  x: 1,\n  y: 2\n}}")
    assert_eq(fmt.pretty("[]"), "[]")
    assert_eq(fmt.pretty("[:]"), "[:]")
    assert_eq(fmt.pretty("[REDACTED]"), "[REDACTED]")
    assert_eq(fmt.pretty("jet"), "jet")
    assert_eq(fmt.pretty("Org {{title: \"a{{{{b}}}}c\", teams: [Team {{name: \"core\"}}]}}"), "Org {{\n  title: \"a{{{{b}}}}c\",\n  teams: [\n    Team {{\n      name: \"core\"\n    }}\n  ]\n}}")
    assert_eq(fmt.bytes(1536), "1.5 KB")
    assert_eq(fmt.bytes(1000), "1 KB")
    assert_eq(fmt.bytes(1024), "1 KB")
    assert_eq(fmt.bytes(1500000000), "1.5 GB")
    assert_eq(fmt.bytes(999), "999 B")
    assert_eq(fmt.bytes(25000000), "25 MB")
    assert_eq(fmt.bytes(-2048), "-2 KB")
    assert_eq(fmt.decimal(0.125, 2), "0.13")
    assert_eq(fmt.decimal(-0.0001, 2), "0.00")
    assert_eq(fmt.decimal(Float{12.34}, 2), "12.34")
    assert_eq(fmt.grouped(Float{1234.5678}, 2), "1,234.57")
    assert_eq(fmt.pad("ab", 5, ""), "ab   ")
    assert_eq(fmt.pad_center("x", 4, "ab"), "axab")
    assert_eq(fmt.pad_center("x", 3, "."), ".x.")
    assert_eq(fmt.pad_left("7", 3, "0"), "007")
    assert_eq(fmt.pad_right("go", 4, "."), "go..")
    assert_eq(fmt.number(1204331), "1,204,331")
    assert_eq(fmt.hex(255, 4), "00ff")
    assert_eq(fmt.hex(-255, 4), "-00ff")
    assert_eq(fmt.bin(10), "1010")
    assert_eq(fmt.oct(10), "12")
    assert_eq(fmt.ordinal(21), "21st")
    assert_eq(fmt.ordinal(112), "112th")
    assert_eq(fmt.plural(2, "row", "rows"), "2 rows")
    assert_eq(fmt.duration(222000), "3m 42s")
    assert_eq(fmt.duration(-5), "-5ms")
    assert_eq(fmt.duration(90061000), "1d 1h 1m")
}
