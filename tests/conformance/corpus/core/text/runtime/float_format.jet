#Test("all pinned fixed f64 extreme and unlimited zero-run rows BOTH signs") {
    maximum :: raw(U64{0x7fefffffffffffff})
    integer :: ""
    fixed(maximum, 0, integer)
    fixed(maximum, 10, "{integer}.0000000000")
    minimum :: raw(U64{1})
    fixed(minimum, 0, "0")
    fixed(minimum, 1, "0.0")
    fixed(minimum, 10, "0.0000000000")
    fixed(minimum, 100, zeros("0.", 100, ""))
    fixed(minimum, 1000, zeros("0.", 323, ""))
    fixed(F64{0.0}, 50000, zeros("0.", 50000, ""))
    fixed(F64{10.0}, 50000, zeros("10.", 50000, ""))
    fixed(F64{1.0}, 50000, zeros("1.", 50000, ""))
    fixed(F64{0.1}, 50000, zeros("0.1000000000000000055511151231257827021181583404541015625", 49945, ""))
    fixed(F64{1e-20}, 50000, zeros("0.00000000000000000000999999999999999945153271454209571651729503702787392447107715776066783064379706047475337982177734375", 49881, ""))
    // Exact pinned formatter MAX precision, not a scratch-size clamp.
    fixed(F64{1.0}, 65535, zeros("1.", 65535, ""))
}

// Source check_exact / check_exact_one, including every original f64 Paxson
// Table3/Table4 row. The oracle rounds the literal decimal fixture, not value.
fn check_digits(d: &dec.Decoded, capacity: Int, limit: Int, expected: String, exponent: Int) Never! {
    b := [U8#1024]{uninit}
    g :: grisu.exact(d, &b, capacity, limit)
    assert_eq(text(&b, g.len), expected)
    assert_eq(g.exp, exponent)
    r :: dragon.exact(d, &b, capacity, limit)
    assert_eq(text(&b, r.len), expected)
    assert_eq(r.exp, exponent)
}
fn exact_case(value: F64, literal: String, exponent: Int) Never! {
    d :: dec.finite(bits_policy.float_policy_to_bits(value))
    fixture :: literal.bytes()
    cut := fixture.len()
    loop i in 0..<fixture.len() {
        if fixture[i] == (U8{32}) { cut = i; break }
    }
    last :: if cut < fixture.len() -> cut else -> fixture.len() - 1
    loop len in 1..<last {
        expected := [U8]{}
        loop i in 0..<len -> &expected.push(fixture[i])
        k := exponent
        tie :: fixture[len] == (U8{53}) && (fixture[len - 1] & U8{1}) == (U8{0}) && len + 1 < fixture.len() && fixture[len + 1] == (U8{32})
        if fixture[len] >= (U8{53}) && !tie {
            j := len
            loop j > 0 && expected[j - 1] == (U8{57}) { j -= 1; expected[j] = U8{48} }
            if j == 0 { expected[0] = U8{49}; k += 1 } else { expected[j - 1] += U8{1} }
        }
        oracle :: String.from_bytes(^expected) ?? panic("literal oracle")
        check_digits(&d, len, -32768, oracle, k)
        check_digits(&d, 1024, k - len, oracle, k)
        if k - len <= 0 -> fixed(value, len - k, if k <= 0 -> zeros("0.", -k, oracle) else -> decimal_oracle(oracle, k))
    }
    if fixture[0] > (U8{53}) -> check_digits(&d, 1024, exponent, "1", exponent + 1)
    if cut < fixture.len() {
        prefix := [U8]{}
        loop i in 0..<cut -> &prefix.push(fixture[i])
        literal_prefix :: String.from_bytes(^prefix) ?? panic("literal prefix")
        loop len in cut..<(fixture.len() - 1) {
            oracle :: zeros(literal_prefix, len - cut, "")
            check_digits(&d, len, -32768, oracle, exponent)
            check_digits(&d, 1024, exponent - len, oracle, exponent)
        }
    }
}
fn decimal_oracle(literal: String, exp: Int) -> String Never! {
    fixture :: literal.bytes()
    out := [U8]{}
    loop i in 0..<fixture.len() {
        if i == exp -> &out.push(U8{46})
        &out.push(fixture[i])
    }
    String.from_bytes(^out) ?? panic("literal decimal")
}
#Test("all pinned exact f64 sanity literal rows at every requested digit") {
    exact_case(F64{0.1}, "1000000000000000055511151231257827021181", 0)
    exact_case(F64{0.45}, "4500000000000000111022302462515654042363", 0)
    exact_case(F64{0.5}, "5                                       ", 0)
    exact_case(F64{0.95}, "9499999999999999555910790149937383830547", 0)
    exact_case(F64{100.0}, "1                                       ", 3)
    exact_case(F64{999.5}, "9995000000000000000000000000000000000000", 3)
    exact_case(F64{1.0}/F64{3.0}, "3333333333333333148296162562473909929394", 0)
    exact_case(F64{3.141592}, "3141592000000000162174274009885266423225", 1)
    exact_case(F64{3.141592e17}, "3141592                                 ", 18)
    exact_case(F64{1e23}, "99999999999999991611392                 ", 23)
    exact_case(raw(U64{0x7fefffffffffffff}), "1797693134862315708145274237317043567980", 309)
    exact_case(raw(U64{0x0010000000000000}), "2225073858507201383090232717332404064219", -307)
    exact_case(raw(U64{1}), "         ", -323)
}
fn stress(mant: U64, exp: Int, literal: String, exponent: Int) Never! {
    // Every pinned stress mantissa has 53 significant bits; no libm ldexp.
    bits :: ((U64.from_int(exp + 1075) ?? panic("fixture exponent")) << 52) | (mant & U64{0xfffffffffffff})
    d :: dec.finite(bits)
    check_digits(&d, literal.bytes().len(), -32768, literal, exponent)
    check_digits(&d, 1024, exponent - literal.bytes().len(), literal, exponent)
}
