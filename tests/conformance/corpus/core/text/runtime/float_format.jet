// Adjacent IEEE words straddle exact binary ties. Literal decimal oracles are
// round-to-nearest, ties-to-even, independent of either formatter strategy.
#Test("fixed adjacent-bit half-even ties preserve both signs") {
    fixed(raw(U64{0x3fdfffffffffffff}), 0, "0")
    fixed(raw(U64{0x3fe0000000000000}), 0, "0")
    fixed(raw(U64{0x3fe0000000000001}), 0, "1")
    fixed(raw(U64{0x3ff7ffffffffffff}), 0, "1")
    fixed(raw(U64{0x3ff8000000000000}), 0, "2")
    fixed(raw(U64{0x3ff8000000000001}), 0, "2")
    fixed(raw(U64{0x4003ffffffffffff}), 0, "2")
    fixed(raw(U64{0x4004000000000000}), 0, "2")
    fixed(raw(U64{0x4004000000000001}), 0, "3")
    fixed(raw(U64{0x3fbfffffffffffff}), 2, "0.12")
    fixed(raw(U64{0x3fc0000000000000}), 2, "0.12")
    fixed(raw(U64{0x3fc0000000000001}), 2, "0.13")
    fixed(raw(U64{0x3febffffffffffff}), 2, "0.87")
    fixed(raw(U64{0x3fec000000000000}), 2, "0.88")
    fixed(raw(U64{0x3fec000000000001}), 2, "0.88")
}

// Exact boundary values are (2^52-1)/2^1074, 2^52/2^1074,
// (2^52+1)/2^1074, and 1/2^1074. Leading zeros are literal runs, not
// expected values obtained by running a candidate formatter/parser.
#Test("fixed normal subnormal boundary precision rows preserve both signs") {
    loop word in [U64]{0x000fffffffffffff,0x0010000000000000,0x0010000000000001} {
        fixed(raw(word), 307, zeros("0.", 307, ""))
        fixed(raw(word), 308, zeros("0.", 307, "2"))
        fixed(raw(word), 309, zeros("0.", 307, "22"))
        fixed(raw(word), 310, zeros("0.", 307, "223"))
    }
    fixed(raw(U64{0x000fffffffffffff}), 324, zeros("0.", 307, "22250738585072009"))
    fixed(raw(U64{0x0010000000000000}), 324, zeros("0.", 307, "22250738585072014"))
    fixed(raw(U64{0x0010000000000001}), 324, zeros("0.", 307, "22250738585072019"))
    fixed(raw(U64{1}), 323, zeros("0.", 323, ""))
    fixed(raw(U64{1}), 324, zeros("0.", 323, "5"))
    fixed(raw(U64{1}), 325, zeros("0.", 323, "49"))
    fixed(raw(U64{2}), 323, zeros("0.", 322, "1"))
    fixed(raw(U64{2}), 324, zeros("0.", 322, "10"))
    fixed(raw(U64{2}), 325, zeros("0.", 323, "99"))
}

// Original coretests/tests/num/flt2dec/strategy/grisu.rs tests:
// test_cached_power and test_max_pow10_no_more_than, full f64 range.
#Test("pinned Grisu cached powers cover every f64 exponent interval") {
    first :: cache.power(-1087)
    last :: cache.power(1039)
    assert_eq(first.k, -308)
    assert_eq(first.fp.e, -1087)
    assert_eq(last.k, 332)
    assert_eq(last.fp.e, 1039)
    loop exponent in -1137..<961 {
        low :: -60 - exponent - 64
        high :: -32 - exponent - 64
        selected :: cache.power(high)
        assert(low <= selected.fp.e && selected.fp.e <= high)
    }
}
#Test("pinned Grisu max pow10 covers each decimal transition") {
    previous := U64{1}
    loop k in 1..<10 {
        ten :: previous * U64{10}
        below :: grisu.max_pow10(ten - U64{1})
        exact :: grisu.max_pow10(ten)
        assert_eq(below.k, k - 1)
        assert_eq(below.ten, previous)
        assert_eq(exact.k, k)
        assert_eq(exact.ten, ten)
        previous = ten
    }
}

// Original coretests/tests/num/flt2dec/strategy/dragon.rs::test_mul_pow10.
#Test("pinned Dragon cached pow10 agrees with incremental powers through 339") {
    previous := big.from_word(U64{1})
    loop exponent in 1..<340 {
        current := big.from_word(U64{1})
        big.pow10(&current, exponent)
        big.mul_small(&previous, U64{10})
        assert_eq(big.compare(&current, &previous), I32{0})
        previous = ^current
    }
}

// The public fmt Count(u16) gateway rejects 65536 before reading specials.
// Exercise the real stop and exact payload; #4494 remains an activation gate.
#Test("fixed precision above u16 refuses finite zeros infinities and NaNs before rendering") {
    loop word in [U64]{0,0x8000000000000000,0x3ff0000000000000,0xbff0000000000000,
        0x7ff0000000000000,0xfff0000000000000,0x7ff8000000000000,0xfff8000000000001} {
        loop precision in [Int]{65536,65537} {
            outcome :: unwind.catch_unwind(unwind.AssertUnwindSafe(fn() {
                fmt.fixed(raw(word), precision)
            }))
            if outcome == {
                .Ok(_) -> panic("out-of-range precision was accepted")
                .Err(payload) -> assert_eq(payload.downcast_ref<String>(), Val("Formatting argument out of range"))
            }
        }
    }
}
