// Literal oracle from Rust 1.97.1 8bab26f4f68e0e26f0bb7960be334d5b520ea452:
// library/coretests/tests/fmt/float.rs (f64 default/fixed cases), and
// num/flt2dec/mod.rs f64_shortest_sanity_test, f64_exact_sanity_test,
// to_shortest_str_test, to_shortest_exp_str_test, to_exact_fixed_str_test.
// No expected byte is obtained from a float formatter or candidate parser.
// Unexercised compiler/storage gates are retained: generic fixed buffers and
// initialized-prefix loans #4494, private source graph #4500, usize target #4483.
use core.mem
use core.math.runtime.kernel_float_policy as bits_policy
use core.text.runtime.kernel_float_format as fmt
use core.text.runtime.float_format.decoded as dec
use core.text.runtime.float_format.grisu as grisu
use core.text.runtime.float_format.dragon as dragon
use core.text.runtime.float_format.big as big
use core.text.runtime.float_format.cached as cache
// Same canonical native unwind seam as Foundation/Tests/CompilerStack.jet.
// #4494: real same-thread panic capture/payload, not a simulated refusal.
use std.panic as unwind

fn raw(word: U64) -> F64 Never! { bits_policy.float_policy_from_bits(word) }
fn text(buf: &[U8#N], len: Int) -> String Never! {
    out := [U8]{}
    loop i in 0..<len -> &out.push(buf[i])
    String.from_bytes(^out) ?? panic("ASCII fixture")
}
fn zeros(prefix: String, n: Int, suffix: String) -> String Never! {
    out := [U8]{}
    loop b in prefix.bytes() -> &out.push(b)
    loop i in 0..<n -> &out.push(U8{48})
    loop b in suffix.bytes() -> &out.push(b)
    String.from_bytes(^out) ?? panic("literal zero run")
}
fn defaults(value: F64, display: String, debug: String) Never! {
    assert_eq(fmt.display(value), display)
    assert_eq(fmt.debug(value), debug)
    assert_eq(fmt.display(-value), "-{display}")
    assert_eq(fmt.debug(-value), "-{debug}")
}
fn fixed(value: F64, precision: Int, expected: String) Never! {
    assert_eq(fmt.fixed(value, precision), expected)
    assert_eq(fmt.fixed(-value, precision), "-{expected}")
}
fn shortest(value: F64, expected: String, exp: Int) Never! {
    d :: dec.finite(bits_policy.float_policy_to_bits(value))
    b := [U8#17]{uninit}
    g :: grisu.shortest(&d, &b)
    assert_eq(text(&b, g.len), expected)
    assert_eq(g.exp, exp)
    r :: dragon.shortest(&d, &b)
    assert_eq(text(&b, r.len), expected)
    assert_eq(r.exp, exp)
}
#Test("all pinned f64 shortest sanity rows and Dragon tie fallback") {
    shortest(F64{0.1}, "1", 0)
    shortest(F64{100.0}, "1", 3)
    shortest(F64{1.0} / F64{3.0}, "3333333333333333", 0)
    shortest(F64{1.00000762939453125}, "10000076293945313", 1)
    shortest(F64{3.141592}, "3141592", 1)
    shortest(F64{3.141592e17}, "3141592", 18)
    shortest(raw(U64{0x43f0000000000000}), "18446744073709552", 20)
    shortest(F64{1e23}, "1", 24)
    shortest(raw(U64{0x7fefffffffffffff}), "17976931348623157", 309)
    shortest(raw(U64{0x0010000000000000}), "22250738585072014", -307)
    shortest(raw(U64{1}), "5", -323)
    d :: dec.finite(bits_policy.float_policy_to_bits(F64{1.00000762939453125}))
    b := [U8#17]{uninit}
    assert_eq(grisu.shortest_opt(&d, &b), None)
}
#Test("pinned synthetic inclusive/exclusive shortest carry cases") {
    b := [U8#17]{uninit}
    d := dec.Decoded{mant: U64{99999999999999999}, minus: U64{1}, plus: U64{1}, exp: 0, inclusive: true}
    r :: grisu.shortest(&d, &b)
    assert_eq(text(&b, r.len), "1")
    assert_eq(r.exp, 18)
    d.inclusive = false
    q :: grisu.shortest(&d, &b)
    assert_eq(text(&b, q.len), "99999999999999999")
    assert_eq(q.exp, 17)
}
#Test("default signed zeros infinities all NaN signs and payloads") {
    assert_eq(fmt.display(raw(U64{0})), "0")
    assert_eq(fmt.display(raw(U64{0x8000000000000000})), "-0")
    assert_eq(fmt.debug(raw(U64{0})), "0.0")
    assert_eq(fmt.debug(raw(U64{0x8000000000000000})), "-0.0")
    loop bits in [U64]{0x7ff0000000000001,0x7ff8000000000000,0x7fffffffffffffff,0xfff0000000000001,0xfff8000000000000,0xffffffffffffffff} {
        assert_eq(fmt.display(raw(bits)), "NaN")
        assert_eq(fmt.debug(raw(bits)), "NaN")
        loop p in [Int]{0,1,2,64,1025} -> assert_eq(fmt.fixed(raw(bits), p), "NaN")
    }
    assert_eq(fmt.display(raw(U64{0x7ff0000000000000})), "inf")
    assert_eq(fmt.debug(raw(U64{0xfff0000000000000})), "-inf")
    loop p in [Int]{0,1,2,64,1025} {
        assert_eq(fmt.fixed(raw(U64{0x7ff0000000000000}), p), "inf")
        assert_eq(fmt.fixed(raw(U64{0xfff0000000000000}), p), "-inf")
        fixed(F64{0.0}, p, if p == 0 -> "0" else -> zeros("0.", p, ""))
    }
}
