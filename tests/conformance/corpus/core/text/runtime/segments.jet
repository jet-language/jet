// Rust CoreLib/Top/Text.rs:563-694,779-885 owned UAX #29 word/sentence
// segmentation. tests/text_unicode.rs:176-206,269-278 check_break ports 1:1
// below over every applicable pinned Unicode 17.0.0 WordBreakTest/SentenceBreakTest
// data line (source SHA256SUMS below); non-scalar surrogate rows cannot form UTF-8.
// Borrowed word_views (Text.rs:699-763) remain held on #4392.
use core.text as text_public
use core.text.runtime.kernel_text_segments as text_segments
use core.text.runtime.kernel_unicode_string as text_segment_string

fn segment_text(points: [Int]) -> String Never! {
    out := [U8]{}
    loop cp in points -> text_segment_string.append_cp(&out, cp)
    String.from_bytes(out) ?? panic("segment fixture")
}

fn break_hex(token: String) -> Int Never! {
    value := 0
    loop b in token.bytes() {
        digit := Int.from_u8(b)
        digit = if digit >= 65 -> digit - 55 else -> digit - 48
        value = value * 16 + digit
    }
    value
}

// tests/text_unicode.rs:176-206 parse_break/check_break: ÷ closes a nonempty
// expected segment, × continues it, hex tokens append one scalar.
fn break_case(row: String, sentence: Bool) Never! {
    full := [U8]{}
    current := [U8]{}
    expected := [String]{}
    loop token in row.split(" ") {
        if token == "×" -> next
        if token == "÷" {
            if current.len() > 0 {
                &expected.push(String.from_bytes(current) ?? panic("break segment"))
                current = [U8]{}
            }
            next
        }
        cp :: break_hex(token)
        text_segment_string.append_cp(&full, cp)
        text_segment_string.append_cp(&current, cp)
    }
    if current.len() > 0 -> &expected.push(String.from_bytes(current) ?? panic("break segment"))
    input :: String.from_bytes(full) ?? panic("break input")
    actual :: if sentence -> text_segments.sentence_segments(input) else -> text_segments.word_segments(input)
    assert_eq(actual, expected)
}

// Rust jet_text_words:689-694 filter: any Alphabetic or Numeric scalar.
#Test("words keep UAX segments with Alphabetic or Numeric scalars") {
    assert_eq(text_public.words(""), [String]{})
    assert_eq(text_public.words("one two"), [String]{"one", "two"})
    assert_eq(text_public.words("Hi, κόσμε 123."), [String]{"Hi", "κόσμε", "123"})
    assert_eq(text_public.words("hello world's foo"), [String]{"hello", "world's", "foo"})
    assert_eq(text_public.words("can’t 3.14 a.b 1,000"), [String]{"can’t", "3.14", "a.b", "1,000"})
    assert_eq(text_public.words("a;b"), [String]{"a", "b"}) // MidNum, WB6 needs MidLetter
    assert_eq(text_public.words("a:b"), [String]{"a:b"}) // WB6/WB7 MidLetter
    assert_eq(text_public.words("a: b."), [String]{"a", "b"})
    assert_eq(text_public.words("x²"), [String]{"x", "²"}) // U+00B2 is WB Other, No numeric
    assert_eq(text_public.words("_foo_bar __ -"), [String]{"_foo_bar"}) // WB13a/b ExtendNumLet
    assert_eq(text_public.words("カタカナ ひらがな"), [String]{"カタカナ", "ひ", "ら", "が", "な"})
    assert_eq(text_public.words("a  b"), [String]{"a", "b"})
    assert_eq(text_segments.word_segments("a  b"), [String]{"a", "  ", "b"}) // WB3d
    assert_eq(text_segments.word_segments(""), [String]{})
}

#Test("word segments Hebrew quotes regional indicators ZWJ Format and newlines") {
    // WB7a Hebrew × Single_Quote; WB7b/WB7c Hebrew " Hebrew.
    assert_eq(text_public.words(segment_text([Int]{0x05D0, 0x27})), [String]{segment_text([Int]{0x05D0, 0x27})})
    gershayim :: segment_text([Int]{0x05D0, 0x22, 0x05D1})
    assert_eq(text_public.words(gershayim), [String]{gershayim})
    assert_eq(text_segments.word_segments(segment_text([Int]{0x05D0, 0x22, 0x61})), [String]{segment_text([Int]{0x05D0}), segment_text([Int]{0x22}), "a"})
    // WB15/WB16 RI pairs; no Alphabetic/Numeric scalar so words() drops them.
    flags :: segment_text([Int]{0x1F1FA, 0x1F1F8, 0x1F1EB, 0x1F1F7, 0x1F1E9})
    assert_eq(text_segments.word_segments(flags), [String]{segment_text([Int]{0x1F1FA, 0x1F1F8}), segment_text([Int]{0x1F1EB, 0x1F1F7}), segment_text([Int]{0x1F1E9})})
    assert_eq(text_public.words(flags), [String]{})
    // WB3c ZWJ × Extended_Pictographic after WB4 attaches the ZWJ to "a".
    zwj :: segment_text([Int]{0x61, 0x200D, 0x1F468})
    assert_eq(text_public.words(zwj), [String]{zwj})
    // WB4 Format/Extend attach; WB8 then joins the digits.
    soft :: segment_text([Int]{0x31, 0xAD, 0x32, 0x301})
    assert_eq(text_public.words(soft), [String]{soft})
    // WB3/WB3a/WB3b and WB4 does not attach Extend after a newline.
    crlf :: segment_text([Int]{0x61, 13, 10, 0x308, 0x62})
    assert_eq(text_segments.word_segments(crlf), [String]{"a", segment_text([Int]{13, 10}), segment_text([Int]{0x308}), "b"})
    assert_eq(text_public.words(crlf), [String]{"a", "b"})
}

// Rust jet_text_sentences:880-885: pinned White_Space trim, empty dropped.
#Test("sentences apply SB rules then trim pinned whitespace") {
    assert_eq(text_public.sentences(""), [String]{})
    assert_eq(text_public.sentences("One. Two!"), [String]{"One.", "Two!"})
    assert_eq(text_segments.sentence_segments("One. Two!"), [String]{"One. ", "Two!"})
    assert_eq(text_public.sentences("Mr. smith went. Home"), [String]{"Mr. smith went.", "Home"}) // SB8
    assert_eq(text_public.sentences("Pi is 3.14 today."), [String]{"Pi is 3.14 today."}) // SB6
    assert_eq(text_public.sentences("e.G. Next"), [String]{"e.G.", "Next"}) // SB7 then SB11
    assert_eq(text_public.sentences("Hello?! World"), [String]{"Hello?!", "World"}) // SB8a
    assert_eq(text_public.sentences("(Hi.) Next"), [String]{"(Hi.)", "Next"}) // SB9-SB11 Close Sp
    assert_eq(text_public.sentences("Etc., more"), [String]{"Etc., more"}) // SB8a SContinue
    assert_eq(text_public.sentences("No end"), [String]{"No end"})
}

#Test("sentences paragraph separators and non-ASCII whitespace trim") {
    newline :: segment_text([Int]{0x61, 10, 0x62, 13, 10, 0x63})
    assert_eq(text_segments.sentence_segments(newline), [String]{segment_text([Int]{0x61, 10}), segment_text([Int]{0x62, 13, 10}), "c"})
    assert_eq(text_public.sentences(newline), [String]{"a", "b", "c"})
    separators :: segment_text([Int]{0x61, 0x2029, 0x2029, 0x62})
    assert_eq(text_segments.sentence_segments(separators), [String]{segment_text([Int]{0x61, 0x2029}), segment_text([Int]{0x2029}), "b"})
    assert_eq(text_public.sentences(separators), [String]{"a", "b"})
    blank :: segment_text([Int]{0x20, 0x20, 10, 0x3000, 0x20})
    assert_eq(text_public.sentences(blank), [String]{})
    // U+2003 é space 漢 😀 U+0301 . U+3000 Ж ! U+00A0: SB5 attaches the accent,
    // SB11 breaks after the ideographic space, interior whitespace is kept.
    mixed :: segment_text([Int]{0x2003, 0xE9, 0x20, 0x6F22, 0x1F600, 0x301, 0x2E, 0x3000, 0x416, 0x21, 0xA0})
    first :: segment_text([Int]{0xE9, 0x20, 0x6F22, 0x1F600, 0x301, 0x2E})
    second :: segment_text([Int]{0x416, 0x21})
    assert_eq(text_public.sentences(mixed), [String]{first, second})
    accent :: segment_text([Int]{0x78, 0x301, 0x20, 0x3000})
    assert_eq(text_public.sentences(accent), [String]{segment_text([Int]{0x78, 0x301})})
}

