// core-conformance: core.ui.reactive_render
use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    backend: ui.null_backend()
    label: reactive.signal("one")
    print(ui.reactive_render(fn() {
        node: ui.text(label.get())
        ui.mount(backend, node)
    }))
    print(backend.render_count())
    label.set("two")
    print(backend.render_count())
}
