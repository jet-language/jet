use core.ui.runtime.ui_02.[JetUiAriaRole, JetUiNodeKind, JetTuiEvent, JetSize, jet_ui_text_input, jet_ui_node_accessibility]
use jet_ui_host.[JetUiImeMode, JetUiAccessibility]
use core.ui.runtime.ui_02.[JetTuiColorProfile, JetTuiCapabilities, JetTuiStyle, JetTuiColor, JetTuiList, JetTuiListState, JetRect, JetNullBackend, JetInputEvent, JetEventResult, JetTuiWidget, JetTuiStatefulWidget, jet_tui_display_width, jet_tui_truncate, jet_tui_pad]

// Rust: crates/jet-codegen/src/Prelude/Ui.rs:49
#Test("ui_interactive_roles_are_only_button_and_text_input") {
    assert(JetUiAriaRole.Button.is_interactive())
    assert(JetUiAriaRole.TextInput.is_interactive())
    assert(!JetUiAriaRole.Label.is_interactive())
    assert(!JetUiAriaRole.Container.is_interactive())
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:302-328
#Test("ui_text_input_retains_canonical_node_and_accessibility_metadata") {
    node :: jet_ui_text_input("é𐐀", JetUiImeMode.Disabled)
    assert(node.label == "é𐐀" && node.width == 2.0 && node.height == 1.0)
    assert(node.role == Val(JetUiAriaRole.TextInput))
    assert(node.kind == JetUiNodeKind.TextInput && node.ime == Val(JetUiImeMode.Disabled))
    metadata :: JetUiAccessibility{name: Val("editable title"), description: Val("two scalars"), states: []}
    decorated :: jet_ui_node_accessibility(^node, metadata.clone())
    assert(decorated.accessibility == Val(metadata))
    assert(decorated.label == "é𐐀" && decorated.children.is_empty())
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:366-404
#Test("tui_event_constructors_preserve_typed_payloads") {
    assert(JetTuiEvent.key("Enter") == JetTuiEvent.Key(code: "Enter", modifiers: 0))
    assert(JetTuiEvent.key_with_modifiers("x", 3) == JetTuiEvent.Key(code: "x", modifiers: 3))
    assert(JetTuiEvent.resize(80.0, 24.0) == JetTuiEvent.Resize(size: JetSize{width: 80.0, height: 24.0}))
    assert(JetTuiEvent.timer("tick", -1) == JetTuiEvent.Timer(id: "tick", elapsed_ms: -1))
    assert(JetTuiEvent.io("socket", [0, 255]) == JetTuiEvent.IO(channel: "socket", payload: [0, 255]))
    assert(JetTuiEvent.focus(false) == JetTuiEvent.Focus(focused: false))
}

// Rust: crates/jet-codegen/src/Prelude/Ui.rs:449-643
#Test("tui_profile_and_style_share_portable_presentation_kernel") {
    plain :: JetTuiCapabilities.plain(0, 0)
    assert(plain.width == 1 && plain.height == 1 && !plain.color && !plain.unicode)
    assert(JetTuiColorProfile.TrueColor.name() == "truecolor")
    style :: JetTuiStyle.new().foreground(JetTuiColor.RGB(255, 0, 0)).bold(true)
    assert(style.render("→界", &plain) == ">?")
    assert(jet_tui_display_width("a界́") == 3)
    assert(jet_tui_truncate("a界b", 2) == "a")
    assert(jet_tui_pad("界", 4) == "界  ")
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:789-820
#Test("tui_list_scrolls_selected_row_into_same_canonical_tree") {
    list :: JetTuiList.new(["zero", "one", "two", "three"])
    state := JetTuiListState{}
    state.select(3)
    node :: list.render(JetRect{x: 0.0, y: 0.0, width: 8.0, height: 2.0}, &state)
    assert(state.selected() == 3 && state.offset() == 2)
    assert(node.kind == JetUiNodeKind.Box && node.children.len() == 2)
    assert(node.children[0].label == "  two" && node.children[1].label == "> three")
}
// Rust: crates/jet-codegen/src/Prelude/Ui.rs:1528-1647
#Test("null_backend_shared_focus_routes_tab_and_preserves_empty_group") {
    backend :: JetNullBackend.new()
    backend.set_focus_group([jet_ui_text_input("first", JetUiImeMode.Disabled), jet_ui_text_input("second", JetUiImeMode.Disabled)])
    assert(backend.focused_label() == "first")
    assert(backend.dispatch_event(JetInputEvent.Key(code: "TAB")) == JetEventResult.Handled)
    assert(backend.focused_label() == "second")
    backend.set_focus_group([])
    assert(backend.focused_label() == "")
    assert(backend.dispatch_event(JetInputEvent.Key(code: "")) == JetEventResult.Ignored)
}
