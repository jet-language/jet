// Duration.rs scalar policy, including the duration rows of
// tests/comptime_core_pure_parity.rs (fractional 1750ms, negative -1s,
// difference -1000ms and zero). Signed128 rounding acceptance is retained in
// the blocked carrier repro corpus; it is not claimed by these scalar tests.
use core.time.runtime.kernel_duration as duration
use core.math as duration_test_math

#Test("duration checked integer constructors preserve i64 bounds") {
    assert_eq(duration.scale(I64{1750}, I64{1000000}) ?? I64{0}, I64{1750000000})
    assert_eq(duration.scale(I64.MIN, I64{1}) ?? I64{0}, I64.MIN)
    assert_eq(duration.scale(I64.MAX, I64{1}) ?? I64{0}, I64.MAX)
    assert(duration.scale(I64.MAX, I64{2}) == None)
    assert(duration.scale(I64.MIN, I64{-1}) == None)
    assert_eq(duration.scale(I64.MIN, I64{0}) ?? I64{1}, I64{0})
    assert_eq(duration.scale(I64{-3}, I64{-1000}) ?? I64{0}, I64{3000})
}

#Test("duration float constructors check finiteness and exclusive positive bound") {
    assert_eq(duration.from_float(1.75, I64{1000000000}) ?? I64{0}, I64{1750000000})
    assert_eq(duration.from_float(-1.75, I64{1}) ?? I64{0}, I64{-1})
    assert_eq(duration.from_float(-0.9, I64{1}) ?? I64{1}, I64{0})
    assert_eq(duration.from_float(-9223372036854775808.0, I64{1}) ?? I64{0}, I64.MIN)
    assert_eq(duration.from_float(9223372036854774784.0, I64{1}) ?? I64{0}, I64{9223372036854774784})
    assert(duration.from_float(9223372036854775808.0, I64{1}) == None)
    assert(duration.from_float(-9223372036854777856.0, I64{1}) == None)
    infinity :: duration_test_math.from_bits(9218868437227405312)
    nan :: duration_test_math.from_bits(9221120237041090560)
    assert(duration.from_float(infinity, I64{1}) == None)
    assert(duration.from_float(-infinity, I64{1}) == None)
    assert(duration.from_float(nan, I64{1}) == None)
    assert(duration.from_float(infinity, I64{0}) == None)
    assert_eq(duration.from_float(1.75, I64{-1000}) ?? I64{0}, I64{-1750})
}

#Test("duration scale and checked divide are checked and truncate toward zero") {
    assert_eq(duration.scale(I64{-5}, I64{3}) ?? I64{0}, I64{-15})
    assert(duration.scale(I64.MAX, I64{2}) == None)
    assert(duration.scale(I64.MIN, I64{-1}) == None)
    assert_eq(duration.divide(I64{-7}, I64{3}) ?? I64{0}, I64{-2})
    assert_eq(duration.divide(I64{7}, I64{-3}) ?? I64{0}, I64{-2})
    assert_eq(duration.divide(I64{-7}, I64{-3}) ?? I64{0}, I64{2})
    assert_eq(duration.divide(I64.MIN, I64{1}) ?? I64{0}, I64.MIN)
    assert(duration.divide(I64.MIN, I64{-1}) == None)
    assert(duration.divide(I64{1}, I64{0}) == None)
}

#Test("duration constructor and scaling errors are exact") {
    assert_eq(duration.SCALE_ERROR_REASON, "duration scaling overflowed or divided by zero")
    assert_eq(duration.INT_ERROR_REASON, "duration is outside the supported range")
    assert_eq(duration.FLOAT_ERROR_REASON, "duration must be finite and inside the supported range")
}

#Test("duration whole unit reads truncate negative fractions") {
    assert_eq(duration.whole_units(I64{1750000000}, I64{1000000}), I64{1750})
    assert_eq(duration.whole_units(I64{-1500000000}, I64{1000000000}), I64{-1})
    assert_eq(duration.whole_units(I64{7}, I64{-3}), I64{-2})
    assert_eq(duration.whole_units(I64{-7}, I64{-3}), I64{2})
    assert_eq(duration.total_seconds(I64{-999999999}), I64{0})
    assert_eq(duration.total_seconds(I64{-1500000000}), I64{-1})
    assert_eq(duration.seconds_value(I64{-1500000000}), -1.5)
    assert(duration.is_zero(I64{0}))
    assert(!duration.is_zero(I64{-1}))
    difference :: duration.sub(I64{500000000}, I64{1500000000})
    assert_eq(duration.whole_units(difference, I64{1000000}), I64{-1000})
}

#Test("duration fixed units recognize every Rust spelling and no others") {
    cases :: [(unit: String, ns: I64)]{
        (unit: "nanosecond", ns: I64{1}), (unit: "nanoseconds", ns: I64{1}), (unit: "ns", ns: I64{1}),
        (unit: "microsecond", ns: I64{1000}), (unit: "microseconds", ns: I64{1000}), (unit: "us", ns: I64{1000}), (unit: "µs", ns: I64{1000}),
        (unit: "millisecond", ns: I64{1000000}), (unit: "milliseconds", ns: I64{1000000}), (unit: "ms", ns: I64{1000000}),
        (unit: "second", ns: I64{1000000000}), (unit: "seconds", ns: I64{1000000000}), (unit: "s", ns: I64{1000000000}),
        (unit: "minute", ns: I64{60000000000}), (unit: "minutes", ns: I64{60000000000}), (unit: "min", ns: I64{60000000000}),
        (unit: "hour", ns: I64{3600000000000}), (unit: "hours", ns: I64{3600000000000}), (unit: "h", ns: I64{3600000000000}),
        (unit: "day", ns: I64{86400000000000}), (unit: "days", ns: I64{86400000000000}), (unit: "d", ns: I64{86400000000000}),
        (unit: "week", ns: I64{604800000000000}), (unit: "weeks", ns: I64{604800000000000}), (unit: "w", ns: I64{604800000000000}),
    }
    loop item in cases {
        assert_eq(duration.unit_nanoseconds(item.unit) ?? I64{0}, item.ns)
    }
    assert(duration.unit_nanoseconds("month") == None)
    assert(duration.unit_nanoseconds("MS") == None)
    assert(duration.unit_nanoseconds("") == None)
    assert_eq(duration.total_in(I64{1500000000}, "seconds"), 1.5)
    assert_eq(duration.total_in(I64{-1500000000}, "s"), -1.5)
    assert_eq(duration.total_in(I64{1000}, "µs"), 1.0)
    assert_eq(duration.total_in(I64{1}, "month"), 0.0)
}

#Test("duration abs negation sign and arithmetic saturate only at i64 boundary") {
    assert_eq(duration.abs(I64.MIN), I64.MAX)
    assert_eq(duration.abs(I64{-17}), I64{17})
    assert_eq(duration.abs(I64{17}), I64{17})
    assert_eq(duration.negated(I64.MIN), I64.MAX)
    assert_eq(duration.negated(I64.MAX), I64{-9223372036854775807})
    assert_eq(duration.sign(I64.MIN), I64{-1})
    assert_eq(duration.sign(I64{0}), I64{0})
    assert_eq(duration.sign(I64.MAX), I64{1})
    assert_eq(duration.add(I64.MAX, I64{1}), I64.MAX)
    assert_eq(duration.add(I64.MIN, I64{-1}), I64.MIN)
    assert_eq(duration.add(I64.MIN, I64.MAX), I64{-1})
    assert_eq(duration.sub(I64.MIN, I64{1}), I64.MIN)
    assert_eq(duration.sub(I64.MAX, I64{-1}), I64.MAX)
    assert_eq(duration.sub(I64.MIN, I64.MAX), I64.MIN)
    assert_eq(duration.sub(I64.MAX, I64.MIN), I64.MAX)
}

#Test("duration show uses the canonical ns suffix") {
    assert_eq(duration.show(I64{0}), "0ns")
    assert_eq(duration.show(I64{-17}), "-17ns")
    assert_eq(duration.show(I64.MIN), "-9223372036854775808ns")
    assert_eq(duration.show(I64.MAX), "9223372036854775807ns")
}

// The harness asserts that these primitive divisions stop; it does not
// assert Rust's engine-specific panic text or source location.
#Test("duration infallible whole-unit division traps on zero and signed overflow") {
    .expect_fail {
        _ :: duration.whole_units(I64{1}, I64{0})
    }
    .expect_fail {
        _ :: duration.whole_units(I64.MIN, I64{-1})
    }
}
