// core-conformance: core.log.set_sink
use {
    files :: core.files
    log :: core.log
    testing :: core.testing
}

fn run() {
    root :: testing.temp_dir("log-set-sink")
    path :: Path.from(root).join("events.jsonl").to_string()
    print((() -> {
        log.set_sink("jsonl", path)
        true
    })())
    files.remove_all(root) ?? panic("cleanup")
}
