// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:2011
#Test("contended_transaction_waits_and_applies_its_body_once") {
    // GATE #4565: kernel primitive
    #Unsafe("real native thread, channel and mutex retain the original blocked-commit scheduling control") {
        protocol :: JetSharedProtocol.new()
        held :: protocol.acquire(true, fn() { false }).unwrap()
        log_lines :: Arc.new(Mutex.new([String]{}))
        (ready_tx, ready_rx) :: mpsc.channel()
        worker_protocol :: protocol.clone()
        worker_log_lines :: log_lines.clone()
        worker :: thread.spawn(fn() {
            transaction := jet_shared_transaction_begin()
            transaction.record_edit(^worker_protocol, Box.new(fn() { worker_log_lines.lock().unwrap().push("transaction-body") }))
            ready_tx.send(()).unwrap()
            transaction.commit()
        })
        ready_rx.recv_timeout(Duration.from_secs(1)).expect("transaction worker reached the lock wait")
        assert(log_lines.lock().unwrap().is_empty(), "a blocked commit must not log")
        drop(^held)
        worker.join().unwrap()
        assert_eq(*log_lines.lock().unwrap(), ["transaction-body"], "the committed transaction emits its body log exactly once")
    }
}
