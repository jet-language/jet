// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:2108
#Test("notify_between_registration_and_park_is_not_lost") {
    // GATE #4565: kernel primitive
    #Unsafe("native channels force notification between registration and park across 64 real waiter schedules") {
        loop _ in 0..64 {
            protocol :: JetSharedProtocol.new()
            condition :: JetConditionProtocol.new()
            waiter :: Arc.new(BlockingWaiter.new())
            rescue :: waiter.clone()
            ready :: Arc.new(AtomicBool.new(false))
            (registered_tx, registered_rx) :: mpsc.channel()
            (park_tx, park_rx) :: mpsc.channel()
            (done_tx, done_rx) :: mpsc.channel()
            worker_condition :: condition.clone()
            worker_ready :: ready.clone()
            worker :: thread.spawn(fn() {
                permit :: protocol.acquire(true, fn() { false }).unwrap()
                checks := Usize{0}
                result :: jet_shared_condition_wait<()>(permit.as_ref(), &worker_condition,
                    fn() -> Bool ()! {
                        checks += 1
                        if checks == 2 {
                            registered_tx.send(()).unwrap()
                            park_rx.recv().unwrap()
                            return Ok(false)
                        }
                        Ok(worker_ready.load(Ordering.Acquire))
                    }, fn() { waiter.clone() })
                done_tx.send(result.is_ok()).unwrap()
            })
            registered_rx.recv_timeout(Duration.from_secs(1)).expect("waiter registers before the second predicate check")
            ready.store(true, Ordering.Release)
            condition.notify_one()
            park_tx.send(()).unwrap()
            done :: done_rx.recv_timeout(Duration.from_secs(1))
            if done.is_err() { rescue.wake() }
            assert_eq(done.ok(), Val(true))
            worker.join().unwrap()
        }
    }
}
