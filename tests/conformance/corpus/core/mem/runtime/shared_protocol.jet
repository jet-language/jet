// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:1894
#Test("transaction_stage_failure_discards_all_participants_before_rollback") {
    // GATE #4565: kernel primitive
    #Unsafe("native mutex and atomic observations preserve the original failure/discard test ordering") {
        first :: Arc.new(TransactionTestOwner{order: 1, state: Arc.new(Mutex.new(TransactionTestOwnerState.default()))})
        second :: Arc.new(TransactionTestOwner{order: 2, state: Arc.new(Mutex.new(TransactionTestOwnerState.default()))})
        first_owner :: first.clone() as Arc<JetSharedCanonicalOwner>
        second_owner :: second.clone() as Arc<JetSharedCanonicalOwner>
        applied :: Arc.new(AtomicBool.new(false))
        rolled_back :: Arc.new(AtomicBool.new(false))
        transaction := jet_shared_transaction_begin()
        loop (owner, state, fail) in [(first_owner, first.state.clone(), false), (second_owner, second.state.clone(), true)] {
            staged_state :: state.clone()
            transaction.record_edit_with_staged_commit(^owner, Box.new(fn() {}),
                Box.new(fn(_) {
                    staged_state.lock().unwrap().staged = true
                    if fail { Err("participant staging rejected") } else { Ok(()) }
                }), Box.new(fn(_) { state.lock().unwrap().published = true }))
        }
        rollback_flag :: rolled_back.clone()
        transaction.record_rollback(Box.new(fn() { rollback_flag.store(true, Ordering.Release) }))
        apply_flag :: applied.clone()
        result :: transaction.try_commit_with(fn() { apply_flag.store(true, Ordering.Release) })
        assert_eq(result, Err("participant staging rejected"))
        assert(!applied.load(Ordering.Acquire))
        assert(rolled_back.load(Ordering.Acquire))
        loop owner in [first, second] {
            state :: owner.state.lock().unwrap()
            assert(!state.staged)
            assert(!state.published)
            assert_eq(state.discards, 1)
        }
    }
}
// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:1956
#Test("full_path_map_and_split_preserve_parent_prefix_and_one_permit") {
    protocol :: JetSharedProtocol.new()
    root :: jet_shared_guard_acquire(&protocol, true, fn() { false }).unwrap()
    mapped :: jet_shared_guard_map_path(&root, &[4, 7], true).unwrap()
    assert(!root.held())
    assert_eq(mapped.path(), &[4, 7])
    (first, second) :: jet_shared_guard_split_path(&mapped, &[10, 11], &[20, 21, 22], true).unwrap()
    assert(!mapped.held())
    assert_eq(first.path(), &[4, 7, 10, 11])
    assert_eq(second.path(), &[4, 7, 20, 21, 22])
    assert(first.held())
    assert(second.held())
    // GATE #4565: kernel primitive
    #Unsafe("compare native permit identity through the public checked guard accessor") { assert(Arc.ptr_eq(&first.permit_arc(), &second.permit_arc())) }
}
