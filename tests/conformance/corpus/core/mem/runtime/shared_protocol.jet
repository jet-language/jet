// Rust: crates/jet-codegen/src/Prelude/SharedProtocol.rs:2218
#Test("ordered_guard_acquisition_preserves_indices_and_shares_duplicate_permits") {
    // GATE #4565: kernel primitive
    #Unsafe("native alias identity observes shared duplicate permits while retaining each guard's own capability") {
        first :: JetSharedProtocol.new()
        second :: JetSharedProtocol.new()
        guards :: jet_shared_guard_acquire_ordered([(11, second.clone(), false), (7, first.clone(), true), (12, first.clone(), false)])
        indices := guards.iter().map(fn((index, _)) { *index }).collect<[Usize]>()
        indices.sort_unstable()
        assert_eq(indices, [7, 11, 12])
        assert(guards.iter().all(fn((_, guard)) { guard.held() }))
        editability := guards.iter().map(fn((index, guard)) { (*index, guard.editable()) }).collect<[(Usize, Bool)]>()
        editability.sort_unstable_by_key(fn((index, _)) { *index })
        assert_eq(editability, [(7, true), (11, false), (12, false)])
        permit_editability := guards.iter().map(fn((index, guard)) { (*index, guard.permit().editable()) }).collect<[(Usize, Bool)]>()
        permit_editability.sort_unstable_by_key(fn((index, _)) { *index })
        assert_eq(permit_editability, [(7, true), (11, false), (12, true)])
        first_guard :: guards.iter().find(fn((index, _)) { *index == 7 }).unwrap()
        duplicate_guard :: guards.iter().find(fn((index, _)) { *index == 12 }).unwrap()
        assert(Arc.ptr_eq(&first_guard.1.permit_arc(), &duplicate_guard.1.permit_arc()))
        drop(^guards)
        assert(jet_shared_acquire(&first, true, fn() { false }).is_some())
        assert(jet_shared_acquire(&second, true, fn() { false }).is_some())
    }
}
