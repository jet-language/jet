// core-conformance: core.mem.volatile_write
use core.mem as mem

fn run() {
    value := 7
    #Unsafe("value is live on this stack frame and the pointer never escapes") {
        addr :: mem.address_of(value)
        pointer :: mem.Ptr<Int>.from_addr(addr)
        result :: mem.volatile_write(pointer, 8)
        seen :: mem.volatile_read(pointer)
        print(result, seen)
    }
}
