// core-conformance: core.term.binread
use {
    term :: core.term
    files :: core.files
    testing :: core.testing
}

fn run() {
    root :: testing.temp_dir("term-binread")
    path :: Path.from(root).join("fixture.bin")
    files.write_bytes(path, [U8]{65, 66, 67}) ?? panic("seed")
    result :: term.binread(path) ?? return
    print(result.len())
    files.remove_all(root) ?? panic("cleanup")
}
