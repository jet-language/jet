// core-conformance: core.term.binwrite
use core.term as term
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("term-binwrite")
    path :: Path.from(root).join("fixture.bin")
    print((() -> {
        term.binwrite(path, [U8]{65, 66, 67})
        true
    })())
    files.remove_all(root) ?? panic("cleanup")
}
