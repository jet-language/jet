use core.process.runtime.top_fs_io_env_os_testing.*
use core.prelude.runtime.std_open.EnvError
use core.encoding.runtime.std_data_tree.DataTree
use jet_foundation.Syntax.TEXT_NUL

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:529-545
#Test("logical_env_validates_names_and_values_without_os_mutation") {
    assert(jet_env_validate_name("PORT_PACKET_0270").is_ok())
    assert(jet_env_validate_name("").is_err())
    assert(jet_env_validate_name("A=B").is_err())
    assert(jet_env_validate_name("A" + TEXT_NUL + "B").is_err())
    assert(jet_env_validate_value("").is_ok())
    assert(jet_env_validate_value("A=B").is_ok())
    match jet_env_validate_value("A" + TEXT_NUL + "B") {
        Err(EnvError.InvalidValue) -> {}
        else -> panic("NUL environment value must fail InvalidValue")
    }
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:648-675
#Test("logical_env_tree_preserves_case_insensitive_replacement_and_nested_shape") {
    tree := DataTree.Object([])
    jet_env_insert_tree(&tree, &["db", "host"], "first")
    jet_env_insert_tree(&tree, &["DB", "HOST"], "second")
    jet_env_insert_tree(&tree, &["db", "port"], "5432")
    assert_eq(tree, DataTree.Object([("db", DataTree.Object([
        ("host", DataTree.Text("second")), ("port", DataTree.Text("5432"))
    ]))]))
    jet_env_insert_tree(&tree, &["DB"], "scalar")
    assert_eq(tree, DataTree.Object([("db", DataTree.Text("scalar"))]))
    jet_env_insert_tree(&tree, &["db", "next"], "child")
    assert_eq(tree, DataTree.Object([
        ("db", DataTree.Text("scalar")),
        ("db", DataTree.Object([("next", DataTree.Text("child"))]))
    ]))
    unchanged :: tree.clone()
    jet_env_insert_tree(&tree, &[], "ignored")
    assert_eq(tree, unchanged)
    text := DataTree.Text("unchanged")
    jet_env_insert_tree(&text, &["ignored"], "ignored")
    assert_eq(text, DataTree.Text("unchanged"))
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:924-937
#Test("snapshot_name_sanitization_is_ascii_and_one_scalar_one_replacement") {
    assert_eq(sanitize_test_name(""), "case")
    assert_eq(sanitize_test_name("A-z_09"), "A-z_09")
    assert_eq(sanitize_test_name("a/b c"), "a_b_c")
    assert_eq(sanitize_test_name("é🙂"), "__")
}

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/FSIoEnvOsTesting.rs:29-31
#Test("filesystem_ignore_option_retains_empty_name_distinct_from_absent") {
    assert_eq(jet_std_fs_walk_ignore_name(None), None)
    assert_eq(jet_std_fs_walk_ignore_name(Val("")), Val(""))
    assert_eq(jet_std_fs_walk_ignore_name(Val(".gitignore")), Val(".gitignore"))
}
