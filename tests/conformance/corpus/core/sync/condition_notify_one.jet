// core-conformance: core.sync.condition_notify_one
// coverage: Condition.new, guard.wait, notify_one, one waiter
// web: not-applicable (the web target has no browser scheduler)

struct State {
    ready: Bool
}

fn wait_for_ready(state: Shared<State>, changed: Condition, armed: Sender<Int>, woke: Sender<Int>) {
    guard :: state.guard_edit()
    armed.send(1)
    guard.wait(changed, value -> value.ready) ?? panic("wait failed")
    woke.send(1)
}

fn run() {
    state :: shared State{ready: false}
    changed :: Condition.new()
    (armed_sender, armed) :: channel<Int>(capacity: 1)
    (woke_sender, woke) :: channel<Int>(capacity: 1)

    waiter :: task wait_for_ready(state, changed, armed_sender, woke_sender)
    armed.receive() ?? panic("waiter was not armed")
    {
        guard :: state.guard_edit()
        guard.value.ready = true
        changed.notify_one()
    }
    print("notify_one:{woke.receive() ?? panic(\"waiter did not wake\")}")
    waiter.join() ?? panic("waiter failed")
}
