// core-conformance: core.sync.map_merge
use core.sync as sync

fn run() {
    left_map :: sync.map_new()
    left :: sync.map_set(left_map, "left", "one")
    right_map :: sync.map_new()
    right :: sync.map_set(right_map, "right", "two")
    merged :: sync.map_merge(left, right)
    print(merged)
}
