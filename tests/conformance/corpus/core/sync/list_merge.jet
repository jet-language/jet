// core-conformance: core.sync.list_merge
use core.sync as sync

fn run() {
    left_list :: sync.list_new()
    left :: sync.list_push(left_list, "replica-a", "left")
    right_list :: sync.list_new()
    right :: sync.list_push(right_list, "replica-b", "right")
    merged :: sync.list_merge(left, right)
    print(merged)
}
