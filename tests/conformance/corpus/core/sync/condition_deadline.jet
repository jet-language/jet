// core-conformance: core.sync.condition_deadline
// coverage: Condition.new, guard.wait, already-passed deadline, structured E3003
// web: not-applicable (the web target has no browser scheduler)

State: struct {
    ready: Bool
}

wait_for_deadline: fn(state: Shared<State>, changed: Condition) {
    guard: state.guard_edit()
    guard.wait(changed, fn(value) { value.ready }) ?? panic("wait failed")
    panic("deadline wait completed")
}

run: fn() {
    state: Shared{State{ready: false}}
    changed: Condition.new()
    #Deadline(0ms) {
        waiter: task wait_for_deadline(state, changed)
        outcome: waiter.join()
        if outcome == {
            .Ok(_) -> print("deadline:unexpected-success")
            .Err(error) -> {
                if error == {
                    .DeadlineBlown -> print("deadline:E3003")
                    else -> print("deadline:wrong-failure")
                }
            }
        }
    }
}
