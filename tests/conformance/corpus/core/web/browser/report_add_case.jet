// core-conformance: core.web.browser.report_add_case
use core.web.browser as api

fn run() {
    config :: api.config()
    report :: api.report_new(config)
    case :: BrowserTestCase{name: "jet", selected: true, attempts: [BrowserTestAttempt]{}}
    print(api.report_add_case(report, case).cases.len())
}
