// core-conformance: core.web.invalidate
use core.web as web
use core.reactive.loadable.[Loadable]

#Error
enum LoadError {
    Negative
}

fn load(id: Int) -[DB.Read]> Int LoadError! {
    if id < 0 -> return Err(LoadError.Negative)
    id * 10
}

fn shown(state: Loadable<Int, LoadError>) -> String {
    if state == {
        .Loaded(value) -> "loaded {value}"
        .Failed(_) -> "failed"
        else -> "pending"
    }
}

fn run() {
    binding :: web.live(load, 4)
    print(shown(web.state(binding)))
    web.invalidate(load)
    print(shown(web.state(binding)))
    print(web.live_stats())
}
