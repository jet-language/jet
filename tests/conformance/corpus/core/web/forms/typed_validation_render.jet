// core-conformance: core.web.forms.typed_validation_render
use core.web.forms as api

fn run() {
    form :: api.typed(api.input("jet", [WebFormFieldSpec]{}) ?? panic("input"), "jet") ?? panic("typed")
    chain :: api.typed_validate_field(form, "jet", .Immediate, value -> {})
    print(api.typed_validation_render(chain))
}
