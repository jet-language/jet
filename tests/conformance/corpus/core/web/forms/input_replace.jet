// core-conformance: core.web.forms.input_replace
use api: core.web.forms

run: fn() {
    input: api.input("jet", [WebFormFieldSpec]{}) ?? panic("input")
    replacement: WebFormFieldSpec{name: "jet", value_type: .String, required: true, default: None, label: "Jet", control: .Text, group: None, wire_name: "jet"}
    print(api.input_replace(input, "jet", replacement) == .Ok(_))
}
