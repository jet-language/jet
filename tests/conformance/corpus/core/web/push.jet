// core-conformance: core.web.push
use {
    web: core.web
    core.reactive.loadable.[Loadable]
}

#Error
ReadError: enum {
    Offline
}

reading: fn(sensor: String) -> Int ReadError! {
    if sensor == "" -> return Err(ReadError.Offline)
    sensor.len()
}

shown: fn(state: Loadable<Int, ReadError>) -> String {
    if state == {
        .Loaded(value) -> "loaded {value}"
        .Failed(_) -> "failed"
        else -> "pending"
    }
}

run: fn() {
    binding: web.subscribe(reading, "cpu")
    web.push(reading, "cpu", value: 7)
    print(shown(web.state(binding)))
}
