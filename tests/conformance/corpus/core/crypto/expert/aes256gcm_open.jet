// core-conformance: core.crypto.expert.aes256gcm_open
use core.crypto.expert as expert

fn run() {
    key :: [U8]{0xb5, 0x2c, 0x50, 0x5a, 0x37, 0xd7, 0x8e, 0xda, 0x5d, 0xd3, 0x4f, 0x20, 0xc2, 0x25, 0x40, 0xea, 0x1b, 0x58, 0x96, 0x3c, 0xf8, 0xe5, 0xbf, 0x8f, 0xfa, 0x85, 0xf9, 0xf2, 0x49, 0x25, 0x05, 0xb4}
    nonce :: [U8]{0x51, 0x6c, 0x33, 0x92, 0x9f, 0xa5, 0x32, 0x84, 0xff, 0x46, 0x3d, 0x07}
    ciphertext :: [U8]{0xbd, 0xc1, 0xac, 0x88, 0x4d, 0x33, 0x24, 0x57, 0xa1, 0xd2, 0x66, 0x4f, 0x16, 0x8c, 0x76, 0xf0}
    #Unsafe("fixed NIST AES-256-GCM vector") {
        result :: expert.aes256gcm_open(key, nonce, ciphertext, [U8]{}) ?? return Err("open")
        print(result == [U8]{})
    }
}
