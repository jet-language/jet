// core-conformance: core.crypto.expert.secret_bytes
use {
    crypto: core.crypto
    expert: core.crypto.expert
}

run: fn() {
    secret: crypto.Secret.from_bytes([U8]{0x01, 0x02, 0x03, 0x04})
    #Unsafe("inspect fixed secret bytes") {
        result: expert.secret_bytes(secret)
        print(result == [U8]{0x01, 0x02, 0x03, 0x04})
    }
}
