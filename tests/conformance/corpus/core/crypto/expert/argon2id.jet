// core-conformance: core.crypto.expert.argon2id
use core.crypto as crypto
use core.crypto.expert as expert

fn run() {
    password :: crypto.Secret.from_text("password")
    salt :: "somesalt".bytes()
    #Unsafe("fixed Argon2id known-answer vector") {
        result :: expert.argon2id(password, salt, 65536, 2, 1, 32) ?? panic("argon2id")
        print(expert.secret_bytes(result) == [U8]{0x09, 0x31, 0x61, 0x15, 0xd5, 0xcf, 0x24, 0xed, 0x5a, 0x15, 0xa3, 0x1a, 0x3b, 0xa3, 0x26, 0xe5, 0xcf, 0x32, 0xed, 0xc2, 0x47, 0x02, 0x98, 0x7c, 0x02, 0xb6, 0x56, 0x6f, 0x61, 0x91, 0x3c, 0xf7})
    }
}
