// core-conformance: core.crypto.expert.shared_secret_bytes
use core.crypto as crypto
use core.crypto.expert as expert

fn run() {
    alice :: crypto.X25519SecretKey.new_random() ?? return Err("alice")
    bob :: crypto.X25519SecretKey.new_random() ?? return Err("bob")
    shared :: crypto.x25519(alice, bob.public_key()) ?? return Err("shared")
    #Unsafe("inspect shared-secret length") {
        result :: expert.shared_secret_bytes(shared)
        print(result.len() == 32)
    }
}
