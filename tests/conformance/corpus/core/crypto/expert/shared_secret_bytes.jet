// core-conformance: core.crypto.expert.shared_secret_bytes
use {
    crypto :: core.crypto
    expert :: core.crypto.expert
}

fn run() {
    alice :: crypto.X25519SecretKey.new_random() ?? panic("alice")
    bob :: crypto.X25519SecretKey.new_random() ?? panic("bob")
    shared :: crypto.x25519(alice, bob.public_key()) ?? panic("shared")
    #Unsafe("inspect shared-secret length") {
        result :: expert.shared_secret_bytes(shared)
        print(result.len() == 32)
    }
}
