// core-conformance: core.crypto.expert.x25519_secret_bytes
use core.crypto as crypto
use core.crypto.expert as expert

fn run() {
    key :: crypto.X25519SecretKey.new_random() ?? return Err("x25519 key")
    #Unsafe("inspect generated X25519 secret bytes") {
        result :: expert.x25519_secret_bytes(key)
        print(result.len() == 32)
    }
}
