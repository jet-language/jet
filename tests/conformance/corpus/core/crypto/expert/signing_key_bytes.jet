// core-conformance: core.crypto.expert.signing_key_bytes
use {
    crypto :: core.crypto
    expert :: core.crypto.expert
}

fn run() {
    key :: crypto.SigningKey.new_random() ?? panic("signing key")
    #Unsafe("inspect generated signing-key bytes") {
        result :: expert.signing_key_bytes(key)
        print(result.len() == 32)
    }
}
