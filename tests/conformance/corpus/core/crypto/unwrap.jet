// core-conformance: core.crypto.unwrap
use core.crypto as crypto

fn run() {
    secret :: crypto.Secret.from_bytes([U8]{0x01, 0x02, 0x03})
    recipient :: crypto.X25519SecretKey.new_random() ?? return Err("recipient")
    wrapped :: crypto.wrap(secret, recipient.public_key()) ?? return Err("wrap")
    result :: crypto.unwrap(recipient, wrapped) ?? return Err("unwrap")
    print(crypto.constant_time_equal(result, secret))
}
