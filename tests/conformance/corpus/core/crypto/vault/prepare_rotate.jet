// core-conformance: core.crypto.vault.prepare_rotate
use core.crypto as crypto
use core.crypto.vault as vault

fn run() -[Secret, IO]> {
    plan :: vault.prepare_rotate<crypto.SigningKey>("") ?? return
    write :: vault.authorize_write(&plan, "fixed prepare-rotate authorization") ?? return
    result :: vault.commit_rotate(^write, ^plan) ?? return
    print(result.current)
}
