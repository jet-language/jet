// core-conformance: core.crypto.vault.authorize_write
use {
    crypto: core.crypto
    vault: core.crypto.vault
}

run: fn() -[Secret, IO]> {
    plan: vault.prepare_generate<crypto.SigningKey>("__core_conformance_authorize") ?? return
    write: vault.authorize_write(plan, "fixed conformance authorization") ?? return
    result: vault.commit_generate(^write, ^plan) ?? return
    print(result)
}
