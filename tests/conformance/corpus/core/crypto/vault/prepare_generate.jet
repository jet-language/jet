// core-conformance: core.crypto.vault.prepare_generate
use core.crypto as crypto
use core.crypto.vault as vault

fn run() -[Secret, IO]> {
    plan :: vault.prepare_generate<crypto.SigningKey>("") ?? return
    write :: vault.authorize_write(&plan, "fixed prepare-generate authorization") ?? return
    result :: vault.commit_generate(^write, ^plan) ?? return
    print(result)
}
