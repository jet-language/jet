// core-conformance: core.crypto.vault.commit_generate
use {
    crypto :: core.crypto
    vault :: core.crypto.vault
}

fn run() -[Secret, IO]> {
    plan :: vault.prepare_generate<crypto.SigningKey>("__core_conformance_generate") ?? return
    write :: vault.authorize_write(plan, "fixed generate authorization") ?? return
    result :: vault.commit_generate(^write, ^plan) ?? return
    print(result)
}
