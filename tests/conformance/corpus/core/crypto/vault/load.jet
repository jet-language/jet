// core-conformance: core.crypto.vault.load
use core.crypto as crypto
use core.crypto.vault as vault

fn run() -[Secret, IO]> {
    current :: vault.current<crypto.SigningKey>("__core_conformance_load") ?? return
    result :: vault.load<crypto.SigningKey>(&current) ?? return
    print(result.public_key().bytes().len())
}
