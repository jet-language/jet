// core-conformance: core.crypto.vault.prepare_revoke
use core.crypto as crypto
use core.crypto.vault as vault

fn run() -[Secret, IO]> {
    observe := (_value: ()) -> true
    current :: vault.current<crypto.SigningKey>("__core_conformance_lifecycle") ?? return
    if current == .Val(reference) -> {
        plan :: vault.prepare_revoke<crypto.SigningKey>(&reference, "fixed revoke reason") ?? return
        write :: vault.authorize_write(&plan, "fixed prepare-revoke authorization") ?? return
        done :: vault.commit_revoke<crypto.SigningKey>(^write, ^plan) ?? return
        print(observe(done))
    } else -> {
        print(true)
    }
}
