// core-conformance: core.crypto.pbkdf2_hmac
use core.crypto as crypto

fn run() {
    password :: "password".bytes()
    salt :: "salt".bytes()
    result :: crypto.pbkdf2_hmac(password, salt, 1, 32)
    print(result == [U8]{0x12, 0x0f, 0xb6, 0xcf, 0xfc, 0xf8, 0xb3, 0x2c, 0x43, 0xe7, 0x22, 0x52, 0x56, 0xc4, 0xf8, 0x37, 0xa8, 0x65, 0x48, 0xc9, 0x2c, 0xcc, 0x35, 0x48, 0x08, 0x05, 0x98, 0x7c, 0xb7, 0x0b, 0xe1, 0x7b})
}
