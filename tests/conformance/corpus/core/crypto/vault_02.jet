// Rust: crates/jet-pkg-model/src/Prelude/SecretsCrypto.rs:2028
pub fn jet_vault_clear_test_authorizer() -> { VAULT_AUTHORIZER.with((slot) -> slot.borrow_mut().replace(None)) }
