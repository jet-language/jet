// Rust: crates/jet-pkg-model/src/Prelude/SecretsCrypto.rs:2889
static VAULT_TEST_BACKUP_BARRIER: Mutex<(OSPath, Arc<Barrier>, Arc<Barrier>)?> = Mutex.new(None)
// Rust: crates/jet-pkg-model/src/Prelude/SecretsCrypto.rs:2898
pub fn jet_vault_set_test_backup_barrier(barriers: ^(OSPath, Arc<Barrier>, Arc<Barrier>)?) -> {
    guard :: VAULT_TEST_BACKUP_BARRIER.lock().unwrap()
    guard.replace(^barriers)
}
