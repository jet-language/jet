// core-conformance: core.crypto.blake3
use core.crypto as crypto

fn run() {
    result :: crypto.blake3([U8]{0x61, 0x62, 0x63})
    print(result.hex().len() == 64)
    print(result.bytes() == [U8]{0x64, 0x37, 0xb3, 0xac, 0x38, 0x46, 0x51, 0x33, 0xff, 0xb6, 0x3b, 0x75, 0x27, 0x3a, 0x8d, 0xb5, 0x48, 0xc5, 0x58, 0x46, 0x5d, 0x79, 0xdb, 0x03, 0xfd, 0x35, 0x9c, 0x6c, 0xd5, 0xbd, 0x9d, 0x85})
}
