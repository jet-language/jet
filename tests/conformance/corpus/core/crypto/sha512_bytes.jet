// core-conformance: core.crypto.sha512_bytes
use core.crypto as crypto

fn run() {
    input :: [U8]{0x61, 0x62, 0x63}
    result :: crypto.sha512_bytes(input)
    print(result == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
}
