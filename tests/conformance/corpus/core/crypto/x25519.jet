// core-conformance: core.crypto.x25519
use core.crypto as crypto
use core.crypto.expert as expert

fn run() {
    alice :: crypto.X25519SecretKey.new_random() ?? panic("alice")
    bob :: crypto.X25519SecretKey.new_random() ?? panic("bob")
    shared :: crypto.x25519(alice, bob.public_key()) ?? panic("shared secret")
    #Unsafe("inspect shared-secret length") {
        print(expert.shared_secret_bytes(shared).len() == 32)
    }
}
