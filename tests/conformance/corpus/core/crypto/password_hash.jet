// core-conformance: core.crypto.password_hash
use core.crypto as crypto

fn run() {
    password :: crypto.Secret.from_text("correct horse battery staple")
    result :: crypto.password_hash(password) ?? panic("password hash")
    print(result.text().starts_with("$argon2id$v=19$m=65536,t=3,p=1$"))
}
