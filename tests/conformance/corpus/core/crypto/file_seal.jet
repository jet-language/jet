// core-conformance: core.crypto.file_seal
use core.crypto as crypto
use core.files as fs

fn run() {
    source_text :: "/tmp/jet_core_crypto_file_seal_source"
    sealed_text :: "/tmp/jet_core_crypto_file_seal_output"
    if fs.exists(source_text) -> fs.remove(source_text) ?? return Err("cleanup")
    if fs.exists(sealed_text) -> fs.remove(sealed_text) ?? return Err("cleanup")
    source :: Path.from(source_text)
    sealed :: Path.from(sealed_text)
    source.write_atomic([U8]{0x61, 0x62, 0x63}) ?? return Err("source")
    recipient :: crypto.X25519SecretKey.new_random() ?? return Err("recipient")
    result :: crypto.file_seal([recipient.public_key()], source, sealed)
    print(result == .Ok(()))
    if fs.exists(source_text) -> fs.remove(source_text) ?? return Err("cleanup")
    if fs.exists(sealed_text) -> fs.remove(sealed_text) ?? return Err("cleanup")
}
