// Jet execution UNEXERCISED at capture; run this corpus after composed Core rebuild.
use core.crypto.expert as expert
use core.crypto.[CryptoError]

fn check(key: [U8], nonce: [U8], plain: [U8], aad: [U8], cipher: [U8], fail: Bool) {
    #Unsafe("published KAT or frozen seed AES-GCM fixture") {
        if fail {
            if expert.aes256gcm_open(key, nonce, cipher, aad) == {
                .Err(error) -> assert_eq(error, CryptoError.OpenFailed)
                .Ok(_) -> panic("invalid authentication accepted")
            }
        } else {
            assert_eq(expert.aes256gcm_seal(key, nonce, plain, aad) ?? panic("seal"), cipher)
            assert_eq(expert.aes256gcm_open(key, nonce, cipher, aad) ?? panic("open"), plain)
            bad := cipher.copy()
            bad[bad.len() - 1] = bad[bad.len() - 1] ~| U8{1}
            if expert.aes256gcm_open(key, nonce, bad, aad) == {
                .Err(error) -> assert_eq(error, CryptoError.OpenFailed)
                .Ok(_) -> panic("tampered tag accepted")
            }
        }
    }
}

