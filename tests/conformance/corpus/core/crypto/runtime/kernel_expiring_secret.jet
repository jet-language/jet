use core.crypto.[Secret]
use core.crypto.runtime.kernel_expiring_secret.[JetExpiringSecret]
use std.sync.[Arc]
use std.sync.atomic.[AtomicI64, Ordering]

// Rust: crates/jet-codegen/src/Prelude/Core/ExpiringSecret.rs:9
#Test("expiring_secret_deadline_is_inclusive_and_expiration_terminal") {
    clock :: Arc.new(AtomicI64.new(100))
    owned_clock :: clock.clone()
    secret :: JetExpiringSecret.new(Secret.from_text("secret"), 10,
        fn() { owned_clock.load(Ordering.Acquire) })
    clock.store(110, Ordering.Release)
    assert(secret.with(fn(value) { value.bytes.len() }) == Ok(6))
    clock.store(111, Ordering.Release)
    match secret.with(fn(value) { value.bytes.len() }) {
        Err(_) -> {},
        Ok(_) -> panic("expired secret remained accessible"),
    }
    clock.store(100, Ordering.Release)
    match secret.with(fn(value) { value.bytes.len() }) {
        Err(_) -> {},
        Ok(_) -> panic("expired secret revived after clock rewind"),
    }
}
// Rust: crates/jet-codegen/src/Prelude/Core/ExpiringSecret.rs:9
#Test("expiring_secret_saturating_deadline") {
    secret :: JetExpiringSecret.new(Secret.from_text("x"), I64{20}, fn() { I64.MAX })
    assert(secret.with(fn(value) { value.bytes.len() }) == Ok(1))
}
