// SHA256Raw.rs:2-116 and SHAFamily.rs:3-23,47-58,149-213.
// Byte-policy vectors; public fixed-array hex and #Static no-copy cutover are separate gates.
use core.crypto.runtime.kernel_sha256 as sha_kernel
use core.crypto as crypto_api

fn sha_repeated_byte(byte: U8, count: Int) -> [U8] Never! {
    out := [U8]{}
    loop _ in 0..<count -> &out.push(byte)
    out
}

#Test("empty") {
    input :: [U8]{}
    assert(sha_kernel.sha256_bytes(input) == [U8]{227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{209, 74, 2, 140, 42, 58, 43, 201, 71, 97, 2, 187, 40, 130, 52, 196, 21, 162, 176, 31, 130, 142, 166, 42, 197, 179, 228, 47}, "SHA-224 bytes")
}

#Test("abc") {
    input :: [U8]{97, 98, 99}
    assert(sha_kernel.sha256_bytes(input) == [U8]{186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35, 176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{35, 9, 125, 34, 52, 5, 216, 34, 134, 66, 164, 119, 189, 162, 85, 179, 42, 173, 188, 228, 189, 160, 179, 247, 227, 108, 157, 167}, "SHA-224 bytes")
}

#Test("padding and multi-block 55") {
    input :: sha_repeated_byte(U8{97}, 55)
    assert(sha_kernel.sha256_bytes(input) == [U8]{159, 67, 144, 248, 211, 12, 45, 217, 46, 201, 240, 149, 182, 94, 43, 154, 233, 176, 169, 37, 165, 37, 142, 36, 28, 159, 30, 145, 15, 115, 67, 24}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{251, 11, 214, 38, 167, 12, 40, 84, 29, 250, 120, 27, 181, 204, 77, 125, 127, 86, 98, 42, 88, 240, 26, 11, 29, 221, 100, 111}, "SHA-224 bytes")
}

#Test("padding and multi-block 56") {
    input :: sha_repeated_byte(U8{97}, 56)
    assert(sha_kernel.sha256_bytes(input) == [U8]{179, 84, 57, 164, 172, 111, 9, 72, 182, 214, 249, 227, 198, 175, 15, 95, 89, 12, 226, 15, 27, 222, 112, 144, 239, 121, 112, 104, 110, 198, 115, 138}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{212, 8, 84, 252, 156, 175, 23, 32, 103, 19, 111, 46, 41, 225, 56, 11, 20, 98, 107, 246, 240, 221, 6, 119, 159, 130, 13, 205}, "SHA-224 bytes")
}

#Test("padding and multi-block 63") {
    input :: sha_repeated_byte(U8{97}, 63)
    assert(sha_kernel.sha256_bytes(input) == [U8]{125, 62, 116, 160, 93, 125, 177, 91, 206, 74, 217, 236, 6, 88, 234, 152, 227, 240, 110, 238, 207, 22, 180, 198, 255, 242, 218, 69, 125, 220, 47, 52}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{29, 78, 5, 31, 77, 111, 237, 42, 99, 253, 36, 33, 230, 88, 52, 206, 192, 13, 100, 69, 101, 83, 222, 52, 150, 174, 139, 29}, "SHA-224 bytes")
}

#Test("padding and multi-block 64") {
    input :: sha_repeated_byte(U8{97}, 64)
    assert(sha_kernel.sha256_bytes(input) == [U8]{255, 224, 84, 254, 122, 224, 203, 109, 198, 92, 58, 249, 182, 29, 82, 9, 244, 57, 133, 29, 180, 61, 11, 165, 153, 115, 55, 223, 21, 70, 104, 235}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{168, 140, 213, 205, 230, 214, 254, 145, 54, 164, 229, 139, 73, 22, 116, 97, 234, 149, 211, 136, 202, 43, 219, 122, 253, 195, 203, 244}, "SHA-224 bytes")
}

#Test("padding and multi-block 65") {
    input :: sha_repeated_byte(U8{97}, 65)
    assert(sha_kernel.sha256_bytes(input) == [U8]{99, 83, 97, 196, 139, 185, 234, 177, 65, 152, 231, 110, 168, 171, 127, 26, 65, 104, 93, 106, 214, 42, 169, 20, 109, 48, 29, 79, 23, 235, 10, 224}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{255, 135, 22, 246, 0, 175, 66, 149, 157, 14, 251, 82, 225, 242, 27, 1, 187, 50, 135, 51, 0, 147, 68, 213, 17, 194, 153, 251}, "SHA-224 bytes")
}

#Test("padding and multi-block 256") {
    input :: sha_repeated_byte(U8{97}, 256)
    assert(sha_kernel.sha256_bytes(input) == [U8]{2, 215, 22, 13, 119, 225, 140, 100, 71, 190, 128, 194, 227, 85, 199, 237, 67, 136, 84, 82, 113, 112, 44, 80, 37, 59, 9, 20, 198, 92, 229, 254}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{240, 75, 174, 216, 176, 39, 161, 141, 150, 161, 72, 82, 32, 132, 29, 55, 90, 27, 180, 87, 103, 96, 205, 21, 164, 205, 177, 161}, "SHA-224 bytes")
}

#Test("binary bytes") {
    input :: [U8]{0, 255, 128, 1, 0, 127, 254, 16, 32, 200}
    assert(sha_kernel.sha256_bytes(input) == [U8]{46, 103, 255, 251, 87, 112, 143, 212, 84, 233, 170, 90, 237, 5, 147, 41, 229, 68, 188, 113, 106, 122, 151, 87, 251, 251, 170, 218, 236, 182, 242, 233}, "SHA-256 bytes")
    assert(sha_kernel.sha224_bytes(input) == [U8#28]{98, 168, 175, 163, 103, 152, 129, 198, 234, 92, 74, 167, 217, 254, 150, 110, 43, 227, 186, 227, 33, 181, 244, 157, 140, 95, 228, 129}, "SHA-224 bytes")
}

#Test("repeated input retains original bytes") {
    input :: [U8]{97, 98, 99}
    first :: sha_kernel.sha256_bytes(input)
    second :: sha_kernel.sha256_bytes(input)
    assert(crypto_api.constant_time_equal_bytes(first, second), "repeat digest")
    assert(input == [U8]{97, 98, 99}, "input unchanged")
}

#Test("RFC4231 case 1") {
    key :: sha_repeated_byte(U8{11}, 20)
    data :: [U8]{72, 105, 32, 84, 104, 101, 114, 101}
    assert(crypto_api.hmac_sha256(key, data) == [U8]{176, 52, 76, 97, 216, 219, 56, 83, 92, 168, 175, 206, 175, 11, 241, 43, 136, 29, 194, 0, 201, 131, 61, 167, 38, 233, 55, 108, 46, 50, 207, 247}, "HMAC-SHA256")
}

#Test("RFC4231 case 2") {
    key :: [U8]{74, 101, 102, 101}
    data :: [U8]{119, 104, 97, 116, 32, 100, 111, 32, 121, 97, 32, 119, 97, 110, 116, 32, 102, 111, 114, 32, 110, 111, 116, 104, 105, 110, 103, 63}
    assert(crypto_api.hmac_sha256(key, data) == [U8]{91, 220, 193, 70, 191, 96, 117, 78, 106, 4, 36, 38, 8, 149, 117, 199, 90, 0, 63, 8, 157, 39, 57, 131, 157, 236, 88, 185, 100, 236, 56, 67}, "HMAC-SHA256")
}

#Test("RFC4231 case 3") {
    key :: sha_repeated_byte(U8{170}, 20)
    data :: sha_repeated_byte(U8{221}, 50)
    assert(crypto_api.hmac_sha256(key, data) == [U8]{119, 62, 169, 30, 54, 128, 14, 70, 133, 77, 184, 235, 208, 145, 129, 167, 41, 89, 9, 139, 62, 248, 193, 34, 217, 99, 85, 20, 206, 213, 101, 254}, "HMAC-SHA256")
}

#Test("RFC4231 case 6 long key") {
    key :: sha_repeated_byte(U8{170}, 131)
    data :: [U8]{84, 101, 115, 116, 32, 85, 115, 105, 110, 103, 32, 76, 97, 114, 103, 101, 114, 32, 84, 104, 97, 110, 32, 66, 108, 111, 99, 107, 45, 83, 105, 122, 101, 32, 75, 101, 121, 32, 45, 32, 72, 97, 115, 104, 32, 75, 101, 121, 32, 70, 105, 114, 115, 116}
    assert(crypto_api.hmac_sha256(key, data) == [U8]{96, 228, 49, 89, 30, 224, 182, 127, 13, 138, 38, 170, 203, 245, 183, 127, 142, 11, 198, 33, 55, 40, 197, 20, 5, 70, 4, 15, 14, 227, 127, 84}, "HMAC-SHA256")
}

#Test("canonical constant-time equality boundaries") {
    empty :: [U8]{}
    zeros :: [U8]{0}
    left :: [U8]{0, 255, 128}
    right :: [U8]{0, 255, 129}
    assert(crypto_api.constant_time_equal_bytes(empty, empty), "empty equal")
    assert(!crypto_api.constant_time_equal_bytes(empty, zeros), "empty unequal length")
    assert(!crypto_api.constant_time_equal_bytes(zeros, empty), "reverse unequal length")
    assert(crypto_api.constant_time_equal_bytes(left, left), "binary equal")
    assert(!crypto_api.constant_time_equal_bytes(left, right), "binary unequal")
}
