use core.crypto as crypto
use core.crypto.runtime.top_sha_family as family
use core.encoding.[bytes_to_hex]
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:93-147
#Test("sha_family_sha1_canonical_rounds_match_abc") {
    assert(crypto.sha1("abc".bytes()) == "a9993e364706816aba3e25717850c26c9cd0d89d")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:149-213
#Test("sha_family_sha224_canonical_iv_and_seven_word_truncation") {
    assert(crypto.sha224("abc".bytes()) == "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
    assert(crypto.sha224("".bytes()) == "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:260-277,375-377
#Test("sha_family_sha384_full_width_framing") {
    assert(family.jet_crypto_sha384_hex("abc".bytes()) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:345-365,379-393
#Test("sha_family_sha3_standard_empty_digests") {
    assert(family.jet_crypto_sha3_224_hex("".bytes()) == "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7")
    assert(family.jet_crypto_sha3_256_hex("".bytes()) == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
    assert(family.jet_crypto_sha3_384_hex("".bytes()) == "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004")
    assert(family.jet_crypto_sha3_512_hex("".bytes()) == "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:347-352
#Test("sha_family_sha3_rust_two_block_delimiter_at_rate_minus_one") {
    data := [U8]{}
    loop _ in 0..<135 -> &data.push(U8{0})
    // Explicitly absorb the reference's first 136-byte block, whose final
    // byte is 0x06, then a second zero block ending in 0x80.
    state := [Int]{}
    loop _ in 0..<25 -> &state.push(0)
    state[16] = 6 << 56
    crypto.keccak_f(&state)
    state[16] = state[16] ~| (128 << 56)
    crypto.keccak_f(&state)
    expected := [U8]{}
    loop i in 0..<32 -> &expected.push(U8{(state[i /% 8] >> ((i % 8) * 8)) & 255})
    assert(family.jet_crypto_sha3_256_hex(data) == bytes_to_hex(expected[0..<32]))
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:395-427
#Test("sha_family_pbkdf2_empty_contract_and_rfc_vectors") {
    password :: "password".bytes()
    salt :: "salt".bytes()
    assert(family.jet_crypto_pbkdf2_hmac(password, salt, 0, 32).is_empty())
    assert(family.jet_crypto_pbkdf2_hmac(password, salt, 1, -1).is_empty())
    assert(family.jet_crypto_pbkdf2_hmac(password, salt, 1, 67108865).is_empty())
    assert(family.jet_crypto_pbkdf2_hmac(password, salt, 1, 0).is_empty())
    once :: family.jet_crypto_pbkdf2_hmac(password, salt, 1, 32)
    assert(bytes_to_hex(once[0..<32]) == "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")
    twice :: family.jet_crypto_pbkdf2_hmac(password, salt, 2, 32)
    assert(bytes_to_hex(twice[0..<32]) == "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43")
    truncated :: family.jet_crypto_pbkdf2_hmac(password, salt, 2, 17)
    assert(bytes_to_hex(truncated[0..<17]) == "ae4d0c95af6b46d32d0adff928f06dd02a3")
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/SHAFamily.rs:429-468
#Test("sha_family_incremental_digest_is_nondestructive_and_bounded") {
    hasher := family.jet_crypto_hasher_new()
    assert(family.jet_crypto_hasher_digest(&hasher) == crypto.sha256("".bytes()).hex())
    data := [U8]{}
    loop i in 0..<200 -> &data.push(U8{i % 256})
    family.jet_crypto_hasher_update(&hasher, data[0..<63])
    assert(family.jet_crypto_hasher_digest(&hasher) == crypto.sha256(data[0..<63]).hex())
    family.jet_crypto_hasher_update(&hasher, data[63..<65])
    first :: family.jet_crypto_hasher_digest(&hasher)
    assert(first == crypto.sha256(data[0..<65]).hex())
    assert(family.jet_crypto_hasher_digest(&hasher) == first)
    family.jet_crypto_hasher_update(&hasher, data[65..<200])
    assert(family.jet_crypto_hasher_digest(&hasher) == crypto.sha256(data).hex())
    assert(hasher.buffer.len() == 8)
}
