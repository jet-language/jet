// core-conformance: core.compute.maximum
use core.compute as compute

fn run() {
    left :: compute.from_list([1.0, 4.0]) ?? panic("left")
    right :: compute.from_list([3.0, 2.0]) ?? panic("right")
    result :: compute.maximum(left, right) ?? panic("maximum")
    print(compute.to_list(result))
}
