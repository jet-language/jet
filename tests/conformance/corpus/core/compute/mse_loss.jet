// core-conformance: core.compute.mse_loss
use core.compute as compute

fn run() {
    left :: compute.from_list([1.0, 3.0]) ?? panic("left")
    right :: compute.from_list([2.0, 1.0]) ?? panic("right")
    result :: compute.mse_loss(left, right) ?? panic("mse")
    print(compute.to_list(result))
}
