// core-conformance: core.compute.vjp
use core.compute as compute

fn product(left: Tensor, right: Tensor) Tensor -> compute.mul(left, right) ?? panic("product")

fn run() {
    left :: compute.from_list([2.0]) ?? panic("left")
    right :: compute.from_list([3.0]) ?? panic("right")
    result :: compute.vjp(product, ~left, ~right)
    print(compute.to_list(result.value))
}
