// core-conformance: core.compute.sgd_step
use core.compute as compute

fn run() {
    parameter :: compute.from_list([4.0, 2.0]) ?? panic("parameter")
    gradient :: compute.from_list([1.0, 2.0]) ?? panic("gradient")
    result :: compute.sgd_step(parameter, gradient, 0.5) ?? panic("sgd")
    print(compute.to_list(result))
}
