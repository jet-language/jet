// core-conformance: core.compute.sparse_mv
use core.compute as compute

fn run() {
    source :: compute.matrix(2, 2, 1.0) ?? panic("source")
    sparse :: compute.to_sparse(source) ?? panic("sparse")
    vector :: compute.from_list([2.0, 3.0]) ?? panic("vector")
    result :: compute.sparse_mv(sparse, vector) ?? panic("sparse mv")
    print(compute.to_list(result))
}
