// core-conformance: core.compute.matmul_f32_tile
use core.compute as compute

fn run() {
    left :: compute.matrix(2, 2, 2.0) ?? panic("left")
    right :: compute.matrix(2, 2, 3.0) ?? panic("right")
    result :: compute.matmul_f32_tile(left, right) ?? panic("tile")
    print(compute.numel(result))
}
