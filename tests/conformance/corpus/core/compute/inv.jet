// core-conformance: core.compute.inv
use core.compute as compute

fn run() {
    values :: compute.from_list([4.0, 7.0, 2.0, 6.0]) ?? panic("values")
    matrix :: compute.reshape(values, [2, 2]) ?? panic("reshape")
    result :: compute.inv(matrix) ?? panic("inv")
    print(compute.to_list(result))
}
