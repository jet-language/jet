// core-conformance: core.compute.value_and_gradient
use compute: core.compute

product: fn(left: Tensor, right: Tensor) -> Tensor { compute.mul(left, right) ?? panic("product") }

run: fn() {
    left: compute.from_list([2.0]) ?? panic("left")
    right: compute.from_list([3.0]) ?? panic("right")
    result: compute.value_and_gradient(product, left.copy(), right.copy(), wrt: [left])
    print(compute.to_list(result.value))
}
