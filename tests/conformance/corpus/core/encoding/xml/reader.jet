// core-conformance: core.encoding.xml.reader
use core.encoding.xml as xml
use core.files as files
use core.testing as testing

fn run() {
    root :: testing.temp_dir("xml-reader")
    path :: Path.from(root).join("value.xml")
    files.write(path, "<r>ok</r>") ?? panic("fixture")
    input :: files.open(path) ?? panic("open")
    reader :: xml.reader(^input) ?? panic("reader")
    print(reader.next() ?? panic("next"))
}
