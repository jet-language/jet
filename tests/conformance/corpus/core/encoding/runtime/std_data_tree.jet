use core.encoding.runtime.std_data_tree.[DataTree, FieldError, EncodingLimits, EncodingError, EncodingFormat, EncodingErrorKind, jet_datatree_encode_i64, jet_datatree_encode_u64, jet_datatree_int, jet_datatree_int_payload, decode_int, decode_bool, decode_float, decode_string, jet_enc_csv_decode_rows, render_datatree_json, jet_std_json_coerce_walk]

// Behavioral controls for Rust: crates/jet-foundation/src/DataTree.rs:1-66
#Test("ordered carrier first key lookup") {
    tree :: DataTree.Object([("x", .Int(1)), ("x", .Int(2)), ("y", .Text("three"))])
    assert(tree.get("x") == Ok(DataTree.Int(1)))
    assert(tree.get("absent") == Err("missing key `absent`"))
    assert(DataTree.TypedText("s").as_str() == Ok("s"))
    assert(DataTree.Int(1).as_array() == Err("expected a DataTree array"))
    entries :: tree.as_object() ?? panic("ordered object expected")
    assert(entries.len() == 3)
}
// Behavioral controls for Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:69-112
#Test("exact integer carrier boundary") {
    assert(jet_datatree_encode_i64(I64{4611686018427387903}) == DataTree.Int(4611686018427387903))
    assert(jet_datatree_encode_i64(I64{4611686018427387904}) == DataTree.Number("4611686018427387904"))
    assert(jet_datatree_encode_u64(U64{18446744073709551615}) == DataTree.Number("18446744073709551615"))
    assert(jet_datatree_int(18446744073709551616) == DataTree.Number("18446744073709551616"))
    assert(jet_datatree_int_payload(DataTree.Number("18446744073709551616")) == Val(18446744073709551616))
}
// Behavioral controls for Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:220-396
#Test("dynamic access and unordered duplicate objects") {
    values :: DataTree.Array([.Int(3), .Text("four")])
    assert(values.at(I64{-1}) == Ok(DataTree.Text("four")))
    assert(values.at(I64{-9223372036854775808}) == Err(FieldError.at("[-9223372036854775808]", "index -9223372036854775808 out of bounds (len 2)")))
    assert(DataTree.Int(3).text() == Err(FieldError.one("expected text, got 3")))
    a :: DataTree.Object([("x", .Int(1)), ("x", .Int(2))])
    b :: DataTree.Object([("x", .Int(2)), ("x", .Int(1))])
    assert(a.equal_unordered(b))
    assert(!a.equal_unordered(DataTree.Object([("x", .Int(1)), ("x", .Int(1))])))
    assert(!DataTree.Array([.Int(1), .Int(2)]).equal_unordered(DataTree.Array([.Int(2), .Int(1)])))
    assert(!DataTree.Text("a").equal_unordered(DataTree.TypedText("a")))
}
// Behavioral controls for Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/DataTree.rs:35-47,451-605
#Test("typed text strictness and accumulated paths") {
    assert(decode_int(DataTree.Text(" 42 ")) == Ok(42))
    assert(decode_int(DataTree.Number("42e1")) == Ok(420))
    assert(decode_int(DataTree.TypedText("42")) == Err(FieldError.one("expected Int, found text \"42\"")))
    assert(decode_bool(DataTree.Text(" true ")) == Ok(true))
    assert(decode_bool(DataTree.TypedText("true")) == Err(FieldError.one("expected Bool, found text \"true\"")))
    assert(decode_float(DataTree.Number("1e2")) == Ok(100.0))
    assert(decode_string(DataTree.Number("1")) == Err(FieldError.one("expected Text, found number 1")))
    errors :: FieldError.under_errors("parent", [FieldError{path: "[2]", reason: "bad"}, FieldError{path: "child", reason: "worse"}])
    assert(errors == [FieldError{path: "parent[2]", reason: "bad"}, FieldError{path: "parent.child", reason: "worse"}])
}
// Behavioral controls for Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs:14-158
#Test("safe encoding limits and CSV error accumulation") {
    limits :: EncodingLimits.safe()
    assert(limits.buffer_bytes == 65536 && limits.max_depth == 256 && limits.max_total_bytes == None)
    result :: jet_enc_csv_decode_rows<Int, DataTree, FieldError>([["x"], ["1"], ["bad"], ["worse"]],
        (value: DataTree) -> Int [FieldError]! { decode_int(value.field("x")) },
        (path: String, errors: ^[FieldError]) -> [FieldError] Never! { FieldError.under_errors(path, ^errors) },
        (text: String) -> DataTree Never! { .Text(^text) },
        (entries: ^[(String, DataTree)]) -> DataTree Never! { .Object(^entries) })
    assert(result == Err([FieldError{path: "row 2", reason: "expected Int, found text \"bad\""}, FieldError{path: "row 3", reason: "expected Int, found text \"worse\""}]))
}
// Behavioral controls for Rust: crates/jet-codegen/src/Prelude/CoreLib/JetStd/JSONDataTree.rs:27-219
#Test("JSON ordered rendering and lenient coercions") {
    tree :: DataTree.Object([("z", .Number("10000000000000000001")), ("a", .Float(5.0))])
    assert(render_datatree_json(tree, false, 0) == "{{\"z\":10000000000000000001,\"a\":5.0}}")
    assert(render_datatree_json(DataTree.Bytes([U8{1}, U8{255}]), true, 0) == "[1,255]")
    audit := [String]{}
    coerced :: jet_std_json_coerce_walk(DataTree.Array([.Text("true"), .TypedText("2.5"), .Text("NaN")]), "root", (line: String) -> { &audit.push(^line) })
    assert(coerced == DataTree.Array([.Bool(true), .Float(2.5), .Text("NaN")]))
    assert(audit.len() == 2)
}
