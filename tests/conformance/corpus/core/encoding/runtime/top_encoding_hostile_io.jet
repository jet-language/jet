use core.encoding.runtime.top_encoding_hostile_io.[JetEncodingHostileIoState, JetEncodingHostileIoPlan, jet_encoding_hostile_parse_plan, jet_encoding_hostile_io_apply_interrupt]

// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:103
#Test("hostile schedule ignores empty invalid and zero entries") {
    assert(jet_encoding_hostile_parse_plan(&" 1,0,,bad, 3,-2,5 ") == [1, 3, 5])
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:61
#Test("hostile read schedule repeats last cap") {
    state := JetEncodingHostileIoState.fresh()
    state.read_plan = [2, 4]
    plan :: JetEncodingHostileIoPlan{}
    assert(state.next_read_cap(plan, 10) == 2)
    assert(state.next_read_cap(plan, 10) == 4)
    assert(state.next_read_cap(plan, 3) == 3)
    assert(state.read_plan_idx == 2)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:77
#Test("hostile write schedule overrides fixed chunk") {
    state := JetEncodingHostileIoState.fresh()
    state.write_plan = [0, 5]
    plan :: JetEncodingHostileIoPlan{write_chunk: 2}
    assert(state.next_write_chunk(plan, 10) == 1)
    assert(state.next_write_chunk(plan, 10) == 5)
    assert(state.next_write_chunk(plan, 3) == 3)
}
// Rust: crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingHostileIo.rs:197
#Test("hostile interrupts decrement only selected direction") {
    state := JetEncodingHostileIoState.fresh()
    plan :: JetEncodingHostileIoPlan{interrupt_reads: U8{2}, interrupt_writes: U8{3}}
    assert(jet_encoding_hostile_io_apply_interrupt(&state, plan, true).is_err())
    assert(state.plan.unwrap().interrupt_reads == U8{1})
    assert(state.plan.unwrap().interrupt_writes == U8{3})
    assert(state.stats.interrupts == U64{1})
    assert(jet_encoding_hostile_io_apply_interrupt(&state, JetEncodingHostileIoPlan{}, false).is_ok())
    assert(state.stats.interrupts == U64{1})
}
