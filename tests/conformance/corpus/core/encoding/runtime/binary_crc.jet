// EncodingBase.rs:6–116,239–520: hex/CRC public policy and the private fixed
// binary kernel. The final Float tests retain the literal IEEE expectations
// HELD #4467; independent proofs exclude only those tests and Float callables.
// Public checked binary behavior/cutover remains HELD on ballot #4472.
use core.encoding.runtime.kernel_binary as binary_crc_kernel
use core.encoding.hex as binary_crc_hex

fn binary_crc_min() -> I64 Never! { I64{-9223372036854775807} - I64{1} }

fn binary_crc_format_error(format: String, expected: String) Never! {
    _ :: binary_crc_kernel.jet_std_binary_calcsize(format) ?? {
        assert_eq(err.message, expected)
        return
    }
    panic("expected binary format error")
}

fn binary_crc_pack_error(format: String, values: [I64], expected: String) Never! {
    view :: values[0..<values.len()]
    _ :: binary_crc_kernel.jet_std_binary_pack(format, view) ?? {
        assert_eq(err.message, expected)
        return
    }
    panic("expected binary pack error")
}

fn binary_crc_pack(format: String, values: [I64]) -> [U8] Never! {
    view :: values[0..<values.len()]
    binary_crc_kernel.jet_std_binary_pack(format, view) ?? panic("binary pack failed")
}

fn binary_crc_unpack(format: String, data: [U8]) -> [I64] Never! {
    view :: data[0..<data.len()]
    binary_crc_kernel.jet_std_binary_unpack(format, view) ?? panic("binary unpack failed")
}

fn binary_crc_unpack_error(format: String, data: [U8], expected: String) Never! {
    view :: data[0..<data.len()]
    _ :: binary_crc_kernel.jet_std_binary_unpack(format, view) ?? {
        assert_eq(err.message, expected)
        return
    }
    panic("expected binary unpack error")
}

fn binary_crc_iter(format: String, data: [U8]) -> [[I64]] Never! {
    view :: data[0..<data.len()]
    binary_crc_kernel.jet_std_binary_iter_unpack(format, view) ?? panic("binary iter_unpack failed")
}

fn binary_crc_iter_error(format: String, data: [U8], expected: String) Never! {
    view :: data[0..<data.len()]
    _ :: binary_crc_kernel.jet_std_binary_iter_unpack(format, view) ?? {
        assert_eq(err.message, expected)
        return
    }
    panic("expected binary iter_unpack error")
}

fn binary_crc_decode_error(text: String, expected: String) Never! {
    _ :: binary_crc_hex.decode(text) ?? {
        assert_eq(err.reason, expected)
        return
    }
    panic("expected hex decode error")
}

#Test("binary named packers truncate like Rust as-casts") {
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u8(I64{300}), [U8]{44})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u8(I64{-1}), [U8]{255})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_i8(I64{-128}), [U8]{128})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u16le(I64{4660}), [U8]{52, 18})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u16be(I64{4660}), [U8]{18, 52})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u16le(I64{-2}), [U8]{254, 255})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u16be(I64{65537}), [U8]{0, 1})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u32le(I64{-1}), [U8]{255, 255, 255, 255})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u32be(I64{16909060}), [U8]{1, 2, 3, 4})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u32le(I64{4294967296}), [U8]{0, 0, 0, 0})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u64le(I64{-2}), [U8]{254, 255, 255, 255, 255, 255, 255, 255})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u64be(binary_crc_min()), [U8]{128, 0, 0, 0, 0, 0, 0, 0})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u64le(I64{72623859790382856}), [U8]{8, 7, 6, 5, 4, 3, 2, 1})
}

#Test("binary named unpackers offsets extents and u64 reinterpretation") {
    data :: [U8]{1, 2, 3, 4, 5, 6, 7, 8, 255}
    view :: data[0..<data.len()]
    assert(binary_crc_kernel.jet_std_binary_unpack_u8(view, I64{-1}) == None)
    assert(binary_crc_kernel.jet_std_binary_unpack_u8(view, I64{9}) == None)
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u8(view, I64{8}) ?? panic("u8"), I64{255})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u16le(view, I64{1}) ?? panic("u16le"), I64{770})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u16be(view, I64{1}) ?? panic("u16be"), I64{515})
    assert(binary_crc_kernel.jet_std_binary_unpack_u16le(view, I64{8}) == None)
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u32le(view, I64{0}) ?? panic("u32le"), I64{67305985})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u32be(view, I64{0}) ?? panic("u32be"), I64{16909060})
    assert(binary_crc_kernel.jet_std_binary_unpack_u32be(view, I64{6}) == None)
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64le(view, I64{0}) ?? panic("u64le"), I64{578437695752307201})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64be(view, I64{0}) ?? panic("u64be"), I64{72623859790382856})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64be(view, I64{1}) ?? panic("u64be+1"), I64{144964032628459775})
    assert(binary_crc_kernel.jet_std_binary_unpack_u64le(view, I64{2}) == None)
    assert(binary_crc_kernel.jet_std_binary_unpack_u16le(view, I64{9223372036854775807}) == None)
    ones :: [U8]{255, 255, 255, 255, 255, 255, 255, 255}
    ones_view :: ones[0..<ones.len()]
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64le(ones_view, I64{0}) ?? panic("ones64"), I64{-1})
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u32le(ones_view, I64{4}) ?? panic("ones32"), I64{4294967295})
    high :: [U8]{128, 0, 0, 0, 0, 0, 0, 0}
    high_view :: high[0..<high.len()]
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64be(high_view, I64{0}) ?? panic("min"), binary_crc_min())
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_u64le(high_view, I64{0}) ?? panic("128"), I64{128})
}

#Test("binary sign_extend range and bit fill") {
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{255}, I64{8}), I64{-1})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{127}, I64{8}), I64{127})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{32768}, I64{16}), I64{-32768})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{98303}, I64{16}), I64{32767})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{5}, I64{1}), I64{-1})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{4}, I64{1}), I64{0})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{2147483648}, I64{32}), I64{-2147483648})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{-1}, I64{64}), I64{-1})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{255}, I64{0}), I64{255})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{255}, I64{65}), I64{255})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(I64{255}, I64{-8}), I64{255})
    assert_eq(binary_crc_kernel.jet_std_binary_sign_extend(binary_crc_min(), I64{63}), I64{0})
}

#Test("binary format prefixes repeats calcsize and error order") {
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("") ?? panic("empty"), I64{0})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("<") ?? panic("prefix"), I64{0})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("<hHiq") ?? panic("mixed"), I64{16})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("3I") ?? panic("repeat"), I64{12})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("0q") ?? panic("zero repeat"), I64{8})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("!x") ?? panic("pad"), I64{1})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("@B") ?? panic("native"), I64{1})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("=lLcbB") ?? panic("codes"), I64{11})
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("1152921504606846976q") ?? panic("2^63"), binary_crc_min())
    assert_eq(binary_crc_kernel.jet_std_binary_calcsize("18446744073709551615x") ?? panic("u64 max"), I64{-1})
    binary_crc_format_error("z", "unknown binary format character `z`")
    binary_crc_format_error("z3", "unknown binary format character `z`")
    binary_crc_format_error("3", "binary format repeat count is missing a type")
    binary_crc_format_error("<3", "binary format repeat count is missing a type")
    binary_crc_format_error("é", "unknown binary format character `Ã`")
    binary_crc_format_error(" B", "unknown binary format character ` `")
    binary_crc_format_error("99999999999999999999B", "binary format repeat count overflowed")
    binary_crc_format_error("18446744073709551616x", "binary format repeat count overflowed")
    binary_crc_format_error("2305843009213693952q", "binary format size overflowed")
}

#Test("binary pack order padding counts and errors") {
    assert_eq(binary_crc_pack("<hB", [I64]{-2, 300}), [U8]{254, 255, 44})
    assert_eq(binary_crc_pack(">hI", [I64]{1, 16909060}), [U8]{0, 1, 1, 2, 3, 4})
    assert_eq(binary_crc_pack("=H", [I64]{1}), [U8]{1, 0})
    assert_eq(binary_crc_pack("@H", [I64]{1}), [U8]{1, 0})
    assert_eq(binary_crc_pack("!H", [I64]{1}), [U8]{0, 1})
    assert_eq(binary_crc_pack("H", [I64]{1}), [U8]{1, 0})
    assert_eq(binary_crc_pack("2xB", [I64]{5}), [U8]{0, 0, 5})
    assert_eq(binary_crc_pack("0B", [I64]{7}), [U8]{7})
    assert_eq(binary_crc_pack("3B", [I64]{1, 2, 3}), [U8]{1, 2, 3})
    assert_eq(binary_crc_pack("cbB", [I64]{-1, 128, 256}), [U8]{255, 128, 0})
    assert_eq(binary_crc_pack("q", [I64]{binary_crc_min()}), [U8]{0, 0, 0, 0, 0, 0, 0, 128})
    assert_eq(binary_crc_pack(">Q", [I64]{-1}), [U8]{255, 255, 255, 255, 255, 255, 255, 255})
    assert_eq(binary_crc_pack("", [I64]{}), [U8]{})
    binary_crc_pack_error("BB", [I64]{1}, "binary pack expected 2 values, got 1")
    binary_crc_pack_error("2xB", [I64]{1, 2}, "binary pack expected 1 values, got 2")
    binary_crc_pack_error("z", [I64]{1, 2}, "unknown binary format character `z`")
}

#Test("binary unpack unsigned codes trailing bytes and short buffers") {
    assert_eq(binary_crc_unpack("<hB", [U8]{254, 255, 44}), [I64]{65534, 44})
    assert_eq(binary_crc_unpack("b", [U8]{255}), [I64]{255})
    assert_eq(binary_crc_unpack(">i", [U8]{255, 255, 255, 254}), [I64]{4294967294})
    assert_eq(binary_crc_unpack(">q", [U8]{255, 255, 255, 255, 255, 255, 255, 255}), [I64]{-1})
    assert_eq(binary_crc_unpack("<Q", [U8]{0, 0, 0, 0, 0, 0, 0, 128}), [I64]{binary_crc_min()})
    assert_eq(binary_crc_unpack("B", [U8]{1, 2}), [I64]{1})
    assert_eq(binary_crc_unpack("I", [U8]{0, 0, 0, 0, 0}), [I64]{0})
    assert_eq(binary_crc_unpack("xB", [U8]{9, 7}), [I64]{7})
    assert_eq(binary_crc_unpack("2H", [U8]{1, 0, 2, 0}), [I64]{1, 2})
    assert_eq(binary_crc_unpack(">2H", [U8]{1, 0, 2, 0}), [I64]{256, 512})
    assert_eq(binary_crc_unpack("=H", [U8]{1, 0}), [I64]{1})
    assert_eq(binary_crc_unpack("x", [U8]{0}), [I64]{})
    binary_crc_unpack_error("I", [U8]{0, 0, 0}, "binary unpack needs 4 bytes, got 3")
    binary_crc_unpack_error("Iz", [U8]{}, "unknown binary format character `z`")
}

#Test("binary iter_unpack records and size errors") {
    assert_eq(binary_crc_iter("<H", [U8]{1, 0, 2, 0}), [[I64]]{[I64]{1}, [I64]{2}})
    assert_eq(binary_crc_iter(">BH", [U8]{1, 0, 2, 3, 0, 4}), [[I64]]{[I64]{1, 2}, [I64]{3, 4}})
    assert_eq(binary_crc_iter("H", [U8]{}), [[I64]]{})
    assert_eq(binary_crc_iter("x", [U8]{0, 0}), [[I64]]{[I64]{}, [I64]{}})
    binary_crc_iter_error("H", [U8]{1, 2, 3}, "binary iter_unpack buffer length is not a multiple of the format size")
    binary_crc_iter_error("", [U8]{}, "binary iter_unpack needs a positive format size")
    binary_crc_iter_error("<", [U8]{1}, "binary iter_unpack needs a positive format size")
    binary_crc_iter_error("1152921504606846976q", [U8]{}, "binary iter_unpack format size is invalid")
    binary_crc_iter_error("18446744073709551615x", [U8]{}, "binary iter_unpack format size is invalid")
    binary_crc_iter_error("z", [U8]{}, "unknown binary format character `z`")
}

#Test("crc32 ISO 3309 vectors") {
    assert_eq(binary_crc_hex.crc32([U8]{}), 0)
    assert_eq(binary_crc_hex.crc32("abc".bytes()), 891568578)
    assert_eq(binary_crc_hex.crc32("123456789".bytes()), 3421780262)
    assert_eq(binary_crc_hex.crc32("The quick brown fox jumps over the lazy dog".bytes()), 1095738169)
    assert_eq(binary_crc_hex.crc32([U8]{0, 255, 128}), 2178787136)
}

#Test("crc_hqx CCITT vectors and masked seeds") {
    assert_eq(binary_crc_hex.crc_hqx([U8]{}, 0), 0)
    assert_eq(binary_crc_hex.crc_hqx([U8]{}, -1), 65535)
    assert_eq(binary_crc_hex.crc_hqx([U8]{}, 74565), 9029)
    assert_eq(binary_crc_hex.crc_hqx("123456789".bytes(), 0), 12739)
    assert_eq(binary_crc_hex.crc_hqx("123456789".bytes(), 65535), 10673)
    assert_eq(binary_crc_hex.crc_hqx("123456789".bytes(), 7439), 58828)
    assert_eq(binary_crc_hex.crc_hqx("123456789".bytes(), -65536), 12739)
    assert_eq(binary_crc_hex.crc_hqx("abc".bytes(), 0), 40406)
    assert_eq(binary_crc_hex.crc_hqx("The quick brown fox jumps over the lazy dog".bytes(), 0), 61640)
    assert_eq(binary_crc_hex.crc_hqx([U8]{0, 255, 128}, 0), 37495)
}

#Test("hex encode upper separator and is_hex byte policy") {
    assert_eq(binary_crc_hex.encode([U8]{0, 15, 171, 255}), "000fabff")
    assert_eq(binary_crc_hex.encode_upper([U8]{0, 15, 171, 255}), "000FABFF")
    assert_eq(binary_crc_hex.encode_upper([U8]{}), "")
    assert_eq(binary_crc_hex.encode_sep([U8]{1, 171, 255}, ":"), "01:ab:ff")
    assert_eq(binary_crc_hex.encode_sep([U8]{}, ":"), "")
    assert_eq(binary_crc_hex.encode_sep([U8]{1}, "::"), "01")
    assert_eq(binary_crc_hex.encode_sep([U8]{1, 2}, "→"), "01→02")
    assert_eq(binary_crc_hex.encode_sep([U8]{1, 2}, ""), "0102")
    assert(!binary_crc_hex.is_hex(""))
    assert(binary_crc_hex.is_hex("0aFF"))
    assert(!binary_crc_hex.is_hex("abc"))
    assert(!binary_crc_hex.is_hex("zz"))
    assert(!binary_crc_hex.is_hex("é"))
    assert(!binary_crc_hex.is_hex("0x"))
    assert_eq(binary_crc_hex.b2a_base64([U8]{102}), "Zg==\n")
    assert_eq(binary_crc_hex.b2a_base64([U8]{}), "\n")
}

#Test("hex decode byte length precedes digit scan") {
    assert_eq(binary_crc_hex.decode("0aFF") ?? panic("decode"), [U8]{10, 255})
    assert_eq(binary_crc_hex.decode("") ?? panic("empty"), [U8]{})
    binary_crc_decode_error("abc", "odd-length hex string; hex text encodes whole bytes, so the length must be even")
    binary_crc_decode_error("zz", "invalid hex digit; expected 0-9, a-f, or A-F")
    binary_crc_decode_error("0g", "invalid hex digit; expected 0-9, a-f, or A-F")
    binary_crc_decode_error("aé", "odd-length hex string; hex text encodes whole bytes, so the length must be even")
    binary_crc_decode_error("é", "invalid hex digit; expected 0-9, a-f, or A-F")
    assert_eq(binary_crc_hex.a2b_qp("a=3Db"), [U8]{97, 61, 98})
    assert_eq(binary_crc_hex.a2b_qp("=4a"), [U8]{74})
    assert_eq(binary_crc_hex.a2b_qp("=zz"), [U8]{61, 122, 122})
}

#Test("hex dump rows offsets padding and printable range") {
    assert_eq(binary_crc_hex.dump([U8]{}), "")
    assert_eq(binary_crc_hex.dump("Hello".bytes()), "00000000  48 65 6c 6c 6f                                   Hello\n")
    expected :: "00000000  00 1f 20 41 7e 7f 80 ff 0a 09 30 31 32 33 34 35  .. A~.....012345\n00000010  36                                               6\n"
    assert_eq(binary_crc_hex.dump([U8]{0, 31, 32, 65, 126, 127, 128, 255, 10, 9, 48, 49, 50, 51, 52, 53, 54}), expected)
}

#Test("binary every struct code width endian and repeat") {
    byte_codes :: [String]{"c", "b", "B"}
    loop code in byte_codes {
        assert_eq(binary_crc_pack(code, [I64]{-1}), [U8]{255})
        assert_eq(binary_crc_unpack(code, [U8]{255}), [I64]{255})
    }
    short_codes :: [String]{"h", "H"}
    loop code in short_codes {
        assert_eq(binary_crc_pack("<2{code}", [I64]{4660, -2}), [U8]{52, 18, 254, 255})
        assert_eq(binary_crc_pack(">2{code}", [I64]{4660, -2}), [U8]{18, 52, 255, 254})
        assert_eq(binary_crc_unpack("<2{code}", [U8]{52, 18, 254, 255}), [I64]{4660, 65534})
        assert_eq(binary_crc_unpack(">2{code}", [U8]{18, 52, 255, 254}), [I64]{4660, 65534})
    }
    word_codes :: [String]{"i", "I", "l", "L"}
    loop code in word_codes {
        assert_eq(binary_crc_pack("<2{code}", [I64]{16909060, -2}), [U8]{4, 3, 2, 1, 254, 255, 255, 255})
        assert_eq(binary_crc_pack(">2{code}", [I64]{16909060, -2}), [U8]{1, 2, 3, 4, 255, 255, 255, 254})
        assert_eq(binary_crc_unpack("<2{code}", [U8]{4, 3, 2, 1, 254, 255, 255, 255}), [I64]{16909060, 4294967294})
        assert_eq(binary_crc_unpack(">2{code}", [U8]{1, 2, 3, 4, 255, 255, 255, 254}), [I64]{16909060, 4294967294})
    }
    wide_codes :: [String]{"q", "Q"}
    loop code in wide_codes {
        little :: [U8]{8, 7, 6, 5, 4, 3, 2, 1, 254, 255, 255, 255, 255, 255, 255, 255}
        big :: [U8]{1, 2, 3, 4, 5, 6, 7, 8, 255, 255, 255, 255, 255, 255, 255, 254}
        assert_eq(binary_crc_pack("<2{code}", [I64]{72623859790382856, -2}), little)
        assert_eq(binary_crc_pack(">2{code}", [I64]{72623859790382856, -2}), big)
        assert_eq(binary_crc_unpack("<2{code}", little), [I64]{72623859790382856, -2})
        assert_eq(binary_crc_unpack(">2{code}", big), [I64]{72623859790382856, -2})
    }
    assert_eq(binary_crc_pack("00x000B", [I64]{7}), [U8]{0, 7})
    assert_eq(binary_crc_unpack("00x000B", [U8]{255, 7}), [I64]{7})
    assert_eq(binary_crc_unpack("", [U8]{255}), [I64]{})
    binary_crc_pack_error("", [I64]{1}, "binary pack expected 0 values, got 1")
    binary_crc_pack_error("18446744073709551616B", [I64]{}, "binary format repeat count overflowed")
    binary_crc_unpack_error("2305843009213693952q", [U8]{}, "binary format size overflowed")
    binary_crc_unpack_error("18446744073709551615x", [U8]{}, "binary unpack needs 18446744073709551615 bytes, got 0")
    binary_crc_iter_error("3", [U8]{1}, "binary format repeat count is missing a type")
}

#Test("binary every named reader rejects negative short and maximum offsets") {
    empty :: [U8]{}
    empty_view :: empty[0..<empty.len()]
    offsets :: [I64]{-1, 0, 9223372036854775807}
    loop offset in offsets {
        assert(binary_crc_kernel.jet_std_binary_unpack_u8(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u16le(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u16be(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u32le(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u32be(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u64le(empty_view, offset) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_u64be(empty_view, offset) == None)
    }
    assert_eq(binary_crc_kernel.jet_std_binary_pack_i8(I64{256}), [U8]{0})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_u32be(I64{4294967296}), [U8]{0, 0, 0, 0})
}

#Test("CRC whole byte alphabet and CCITT streaming seeds") {
    alphabet := [U8]{}
    loop value in 0..<256 -> &alphabet.push(U8{value})
    assert_eq(binary_crc_hex.crc32(alphabet), 688229491)
    assert_eq(binary_crc_hex.crc_hqx(alphabet, 0), 32341)
    assert_eq(binary_crc_hex.crc_hqx(alphabet, 65535), 16317)
    prefix :: binary_crc_hex.crc_hqx("1234".bytes(), 65535)
    assert_eq(binary_crc_hex.crc_hqx("56789".bytes(), prefix), 10673)
    assert_eq(binary_crc_hex.crc32([U8]{0}), 3523407757)
    assert_eq(binary_crc_hex.crc32([U8]{255}), 4278190080)
    assert_eq(binary_crc_hex.crc_hqx([U8]{0}, 0), 0)
    assert_eq(binary_crc_hex.crc_hqx([U8]{255}, 0), 7920)
    encoded :: binary_crc_hex.encode(alphabet)
    assert_eq(binary_crc_hex.decode(encoded) ?? panic("alphabet decode"), alphabet)
    assert(binary_crc_hex.is_hex(binary_crc_hex.encode_upper(alphabet)))
    binary_crc_decode_error("00 0", "invalid hex digit; expected 0-9, a-f, or A-F")
    binary_crc_decode_error("g", "odd-length hex string; hex text encodes whole bytes, so the length must be even")
}

// HELD #4467: real Float↔U64 #Import scalar ABI/native registration, no fake.
#Test("held binary Float packers preserve IEEE endian zero subnormal and infinity bits") {
    assert_eq(binary_crc_kernel.jet_std_binary_pack_f64le(Float{1.0}), [U8]{0, 0, 0, 0, 0, 0, 240, 63})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_f64be(Float{1.0}), [U8]{63, 240, 0, 0, 0, 0, 0, 0})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_f64le(-Float{0.0}), [U8]{0, 0, 0, 0, 0, 0, 0, 128})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_f64be(Float{4.9406564584124654e-324}), [U8]{0, 0, 0, 0, 0, 0, 0, 1})
    assert_eq(binary_crc_kernel.jet_std_binary_pack_f64be(Float.INFINITY), [U8]{127, 240, 0, 0, 0, 0, 0, 0})
}

#Test("held binary Float unpackers preserve arbitrary payload bits and offset extents") {
    patterns :: [[U8]]{
        [U8]{0, 0, 0, 0, 0, 0, 0, 0},
        [U8]{128, 0, 0, 0, 0, 0, 0, 0},
        [U8]{0, 0, 0, 0, 0, 0, 0, 1},
        [U8]{127, 240, 0, 0, 0, 0, 0, 0},
        [U8]{255, 240, 0, 0, 0, 0, 0, 0},
        [U8]{127, 248, 0, 0, 0, 0, 0, 66},
        [U8]{255, 248, 0, 0, 0, 0, 0, 66},
    }
    loop big in patterns {
        little := [U8]{}
        loop index in 0..<8 -> &little.push(big[7 - index])
        big_view :: big[0..<big.len()]
        little_view :: little[0..<little.len()]
        be :: binary_crc_kernel.jet_std_binary_unpack_f64be(big_view, I64{0}) ?? panic("f64be")
        le :: binary_crc_kernel.jet_std_binary_unpack_f64le(little_view, I64{0}) ?? panic("f64le")
        assert_eq(binary_crc_kernel.jet_std_binary_pack_f64be(be), big)
        assert_eq(binary_crc_kernel.jet_std_binary_pack_f64le(le), little)
        assert(binary_crc_kernel.jet_std_binary_unpack_f64be(big_view, I64{-1}) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_f64le(little_view, I64{1}) == None)
        assert(binary_crc_kernel.jet_std_binary_unpack_f64be(big_view, I64{9223372036854775807}) == None)
    }
    data :: [U8]{255, 63, 240, 0, 0, 0, 0, 0, 0, 255}
    view :: data[0..<data.len()]
    assert_eq(binary_crc_kernel.jet_std_binary_unpack_f64be(view, I64{1}) ?? panic("f64+1"), Float{1.0})
}
