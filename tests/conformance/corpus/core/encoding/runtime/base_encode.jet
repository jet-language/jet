// EncodingBase.rs:117–237; RFC 4648 §10 and tests/fixtures/encoding/rfc4648/vectors.tsv.
// Decoder edition/error union and DataTree.Bytes (#4452) are intentionally unchanged.
use core.encoding.base64 as base_encode_test64
use core.encoding.base32 as base_encode_test32
use core.encoding.runtime.kernel_base_encode as base_encode_test_kernel

#Test("RFC4648 empty") {
    input :: [U8]{}
    assert_eq(base_encode_test64.encode(input), "")
    assert_eq(base_encode_test64.encode_url(input), "")
    assert_eq(base_encode_test64.encode_url_padded(input), "")
    assert_eq(base_encode_test32.encode(input), "")
    assert_eq(base_encode_test32.b32hexencode(input), "")
    assert_eq(base_encode_test64.encodebytes(input), "")
}

#Test("RFC4648 f") {
    input :: [U8]{102}
    assert_eq(base_encode_test64.encode(input), "Zg==")
    assert_eq(base_encode_test64.encode_url(input), "Zg")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zg==")
    assert_eq(base_encode_test32.encode(input), "MY======")
    assert_eq(base_encode_test32.b32hexencode(input), "CO======")
    assert_eq(base_encode_test64.encodebytes(input), "Zg==\n")
}

#Test("RFC4648 fo") {
    input :: [U8]{102, 111}
    assert_eq(base_encode_test64.encode(input), "Zm8=")
    assert_eq(base_encode_test64.encode_url(input), "Zm8")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zm8=")
    assert_eq(base_encode_test32.encode(input), "MZXQ====")
    assert_eq(base_encode_test32.b32hexencode(input), "CPNG====")
    assert_eq(base_encode_test64.encodebytes(input), "Zm8=\n")
}

#Test("RFC4648 foo") {
    input :: [U8]{102, 111, 111}
    assert_eq(base_encode_test64.encode(input), "Zm9v")
    assert_eq(base_encode_test64.encode_url(input), "Zm9v")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zm9v")
    assert_eq(base_encode_test32.encode(input), "MZXW6===")
    assert_eq(base_encode_test32.b32hexencode(input), "CPNMU===")
    assert_eq(base_encode_test64.encodebytes(input), "Zm9v\n")
}

#Test("RFC4648 foob") {
    input :: [U8]{102, 111, 111, 98}
    assert_eq(base_encode_test64.encode(input), "Zm9vYg==")
    assert_eq(base_encode_test64.encode_url(input), "Zm9vYg")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zm9vYg==")
    assert_eq(base_encode_test32.encode(input), "MZXW6YQ=")
    assert_eq(base_encode_test32.b32hexencode(input), "CPNMUOG=")
    assert_eq(base_encode_test64.encodebytes(input), "Zm9vYg==\n")
}

#Test("RFC4648 fooba") {
    input :: [U8]{102, 111, 111, 98, 97}
    assert_eq(base_encode_test64.encode(input), "Zm9vYmE=")
    assert_eq(base_encode_test64.encode_url(input), "Zm9vYmE")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zm9vYmE=")
    assert_eq(base_encode_test32.encode(input), "MZXW6YTB")
    assert_eq(base_encode_test32.b32hexencode(input), "CPNMUOJ1")
    assert_eq(base_encode_test64.encodebytes(input), "Zm9vYmE=\n")
}

#Test("RFC4648 foobar") {
    input :: [U8]{102, 111, 111, 98, 97, 114}
    assert_eq(base_encode_test64.encode(input), "Zm9vYmFy")
    assert_eq(base_encode_test64.encode_url(input), "Zm9vYmFy")
    assert_eq(base_encode_test64.encode_url_padded(input), "Zm9vYmFy")
    assert_eq(base_encode_test32.encode(input), "MZXW6YTBOI======")
    assert_eq(base_encode_test32.b32hexencode(input), "CPNMUOJ1E8======")
    assert_eq(base_encode_test64.encodebytes(input), "Zm9vYmFy\n")
}

#Test("high bytes and tails 1") {
    input :: [U8]{255}
    assert_eq(base_encode_test64.encode(input), "/w==")
    assert_eq(base_encode_test64.encode_url(input), "_w")
    assert_eq(base_encode_test64.encode_url_padded(input), "_w==")
    assert_eq(base_encode_test32.encode(input), "74======")
    assert_eq(base_encode_test32.b32hexencode(input), "VS======")
}

#Test("high bytes and tails 2") {
    input :: [U8]{251, 255}
    assert_eq(base_encode_test64.encode(input), "+/8=")
    assert_eq(base_encode_test64.encode_url(input), "-_8")
    assert_eq(base_encode_test64.encode_url_padded(input), "-_8=")
    assert_eq(base_encode_test32.encode(input), "7P7Q====")
    assert_eq(base_encode_test32.b32hexencode(input), "VFVG====")
}

#Test("high bytes and tails 3") {
    input :: [U8]{0, 128, 255}
    assert_eq(base_encode_test64.encode(input), "AID/")
    assert_eq(base_encode_test64.encode_url(input), "AID_")
    assert_eq(base_encode_test64.encode_url_padded(input), "AID_")
    assert_eq(base_encode_test32.encode(input), "ACAP6===")
    assert_eq(base_encode_test32.b32hexencode(input), "020FU===")
}

#Test("high bytes and tails 4") {
    input :: [U8]{0, 127, 128, 254}
    assert_eq(base_encode_test64.encode(input), "AH+A/g==")
    assert_eq(base_encode_test64.encode_url(input), "AH-A_g")
    assert_eq(base_encode_test64.encode_url_padded(input), "AH-A_g==")
    assert_eq(base_encode_test32.encode(input), "AB7YB7Q=")
    assert_eq(base_encode_test32.b32hexencode(input), "01VO1VG=")
}

#Test("high bytes and tails 5") {
    input :: [U8]{255, 254, 253, 252, 251}
    assert_eq(base_encode_test64.encode(input), "//79/Ps=")
    assert_eq(base_encode_test64.encode_url(input), "__79_Ps")
    assert_eq(base_encode_test64.encode_url_padded(input), "__79_Ps=")
    assert_eq(base_encode_test32.encode(input), "777P37H3")
    assert_eq(base_encode_test32.b32hexencode(input), "VVVFRV7R")
}

