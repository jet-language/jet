#Test("padding uses UTF-8 bytes and unpad removes every trailing equals") {
    assert_eq(base_encode_test64.pad(""), "")
    assert_eq(base_encode_test64.pad("a"), "a===")
    assert_eq(base_encode_test64.pad("ab"), "ab==")
    assert_eq(base_encode_test64.pad("abc"), "abc=")
    assert_eq(base_encode_test64.pad("abcd"), "abcd")
    assert_eq(base_encode_test64.pad("é"), "é==")
    assert_eq(base_encode_test64.pad("€"), "€=")
    assert_eq(base_encode_test64.pad("😀"), "😀")
    assert_eq(base_encode_test64.pad("é="), "é==")
    assert_eq(base_encode_test64.unpad(""), "")
    assert_eq(base_encode_test64.unpad("======"), "")
    assert_eq(base_encode_test64.unpad("Zg======"), "Zg")
    assert_eq(base_encode_test64.unpad("a=b=="), "a=b")
    assert_eq(base_encode_test64.unpad("a= "), "a= ")
    assert_eq(base_encode_test64.unpad("é😀=="), "é😀")
    assert_eq(base_encode_test64.unpad("😀"), "😀")
}

#Test("public encoder aliases use the canonical owner") {
    input :: [U8]{102, 111, 111}
    assert_eq(base_encode_test64.b64encode(input), "Zm9v")
    assert_eq(base_encode_test64.standard_b64encode(input), "Zm9v")
    assert_eq(base_encode_test64.urlsafe_b64encode(input), "Zm9v")
    assert_eq(base_encode_test64.b32encode(input), "MZXW6===")
    assert_eq(base_encode_test64.b32hexencode(input), "CPNMU===")
    assert_eq(base_encode_test32.b32encode(input), "MZXW6===")
    assert_eq(base_encode_test64.b2a_base64(input), "Zm9v\n")
    empty :: [U8]{}
    assert_eq(base_encode_test64.b2a_base64(empty), "\n")
}

#Test("borrowed extent excludes prefix and suffix and preserves original input") {
    input :: [U8]{255, 102, 111, 111, 128}
    window :: input[1..<4]
    assert_eq(base_encode_test_kernel.encode64(window), "Zm9v")
    assert_eq(base_encode_test_kernel.encode32(window), "MZXW6===")
    assert_eq(base_encode_test_kernel.encode32_hex(window), "CPNMU===")
    assert_eq(base_encode_test_kernel.encode64_url(window), "Zm9v")
    assert_eq(base_encode_test_kernel.encode64_bytes(window), "Zm9v\n")
    // Preserve element reads while the view is live: a whole-owner final
    // assert_eq moves input before the emitted view drop (#4421, E0502).
    assert_eq(input.len(), 5)
    assert_eq(input[0], U8{255})
    assert_eq(input[1], U8{102})
    assert_eq(input[2], U8{111})
    assert_eq(input[3], U8{111})
    assert_eq(input[4], U8{128})
}
