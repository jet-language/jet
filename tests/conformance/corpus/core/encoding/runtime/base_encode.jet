#Test("encodebytes 76-byte LF boundary 115") {
    input := [U8]{}
    loop _ in 0..<115 -> &input.push(U8{102})
    assert_eq(base_encode_test64.encodebytes(input), "ZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZm\nZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZm\nZg==\n")
