// core-conformance: core.encoding.csv.rows
use core.encoding.csv as csv
use core.encoding.[EncodingError, EncodingErrorKind]

fn run() {
    crlf :: String.from_bytes([U8]{"\x0D\x0A"}) ?? panic("fixture")
    raw :: String.from_bytes([U8]{"name\tnote\x0D\x0A\x0D\x0Aada\t\"line1\x0D\x0Aline2\"\x0D\x0A"}) ?? panic("fixture")
    result :: csv.rows(
        raw,
        delimiter: "\t", header: true, skip_blank: true
    ) ?? panic("rows")
    print(result.len())
    print(result[0].line)
    print(result[0].fields[0])
    note :: result[0].fields[1]
    print(note.replace(crlf, "|"))
}

// Rust CsvKernel.rs push/finish tests plus DB bounded-row precedence.
fn csv_test_error(text: String) -> EncodingError Never! {
    if csv.rows(text) == { .Err(error) -> error; .Ok(_) -> panic("malformed CSV accepted") }
}
fn csv_test_cr() -> String Never! { String.from_bytes([U8]{U8{13}}) ?? panic("CR is UTF-8") }

#Test("CSV skip_blank follows record content not decoded field width") {
    physical :: csv.rows("\n,\n,,\n\"\"\n \n", skip_blank: true) ?? panic("CSV")
    assert_eq(physical.len(), 2)
    assert_eq(physical[0].line, 4)
    assert_eq(physical[0].fields, [String]{""})
    assert_eq(physical[1].line, 5)
    all :: csv.rows("\n,\n,,\n\"\"\n", skip_blank: false) ?? panic("CSV")
    assert_eq(all.len(), 4)
    assert_eq(all[2].fields.len(), 3)
}

#Test("CSV preserves record opening line and quoted CRLF bytes") {
    physical :: csv.rows(",\"é\n中\"{csv_test_cr()}\n\"\",z{csv_test_cr()}\n") ?? panic("CSV")
    assert_eq(physical.len(), 2)
    assert_eq(physical[0].line, 1)
    assert_eq(physical[0].fields, [String]{"", "é\n中"})
    assert_eq(physical[1].line, 3)
    quoted :: csv.rows("\"a{csv_test_cr()}\nb\",c") ?? panic("CSV")
    assert_eq(quoted[0].fields[0], "a{csv_test_cr()}\nb")
    // Rust treats a CR inside an open quote as field content, including bare CR.
    bare :: csv.rows("\"a{csv_test_cr()}b\",c") ?? panic("CSV")
    assert_eq(bare[0].fields[0], "a{csv_test_cr()}b")
}

#Test("CSV bare CR errors retain CR location before a later scalar or EOF") {
    error :: csv_test_error("x{csv_test_cr()}z")
    assert(error.kind == EncodingErrorKind.Syntax)
    assert_eq(error.line ?? 0, 1)
    assert_eq(error.column ?? 0, 2)
    // #4367: Core byte_offset emits i64 while Int literals emit JetInt.
    assert_eq("{error.byte_offset}", "1")
    assert_eq(csv.error_message(error), "E2701: CSV row 1, line 1, column 2 — bare CR is not a record ending")
    end :: csv_test_error("a,b\nx{csv_test_cr()}")
    assert_eq(csv.error_message(end), "E2701: CSV row 2, line 2, column 2 — bare CR is not a record ending")
    closed :: csv_test_error("\"a\"{csv_test_cr()}z")
    assert_eq(closed.column ?? 0, 4)
}

#Test("CSV scalar columns physical record index and all syntax reasons") {
    error :: csv_test_error("\n,\né\"x")
    assert_eq(error.path, "/records/3/fields/1")
    assert_eq(error.column ?? 0, 2)
    assert_eq("{error.byte_offset}", "5")
    assert_eq(csv.error_message(error), "E2701: CSV row 3, line 3, column 2 — quote inside an unquoted field")
    closed :: csv_test_error("\"中\"x")
    assert_eq(closed.column ?? 0, 4)
    assert_eq(closed.reason, "only quote, comma, CRLF, LF, or EOF may follow a closing quote")
    if csv.rows("\"x\"!", delimiter: "中") == {
        .Err(e) -> assert_eq(e.reason, "only quote, delimiter, CRLF, LF, or EOF may follow a closing quote")
        .Ok(_) -> panic("closing quote accepted")
    }
}

#Test("CSV EOF truncation points one scalar beyond the final field character") {
    error :: csv_test_error("a,\"open\nb,c")
    assert(error.kind == EncodingErrorKind.Truncated)
    assert_eq(error.line ?? 0, 2)
    assert_eq(error.column ?? 0, 4)
    assert_eq(error.reason, "quoted field ended before its closing quote")
    unicode :: csv_test_error("\"é")
    assert_eq(unicode.column ?? 0, 3)
}

#Test("CSV quote escapes unicode delimiter header and EOF cases") {
    physical :: csv.rows("h中v{csv_test_cr()}\n\"say \"\"hi\"\"\"中末", delimiter: "中", header: true) ?? panic("CSV")
    assert_eq(physical.len(), 1)
    assert_eq(physical[0].line, 2)
    assert_eq(physical[0].fields, [String]{"say \"hi\"", "末"})
    assert_eq((csv.rows("") ?? panic("CSV")).len(), 0)
    assert_eq((csv.rows("x\n") ?? panic("CSV")).len(), 1)
    assert_eq((csv.rows("\"\"") ?? panic("CSV")).len(), 1)
    assert_eq((csv.rows(",") ?? panic("CSV")).len(), 0)
}

#Test("CSV delimiter refusal uses the foundation reason") {
    delimiters :: [String]{"", "ab", "\"", csv_test_cr(), "\n"}
    loop delimiter in delimiters {
        if csv.rows("", delimiter: delimiter) == {
            .Err(e) -> {
                assert(e.kind == EncodingErrorKind.Unsupported)
                assert_eq(csv.error_message(e), "E2701: CSV delimiter must be exactly one character other than quote or line ending")
            }
            .Ok(_) -> panic("bad delimiter accepted")
        }
    }
}

#Test("CSV bounded engine refuses immediately after completed excess record") {
    if csv.rows_bounded("h\nx\ny\n\"unterminated", 2) == {
        .Err(e) -> {
            assert(e.kind == EncodingErrorKind.Limit)
            assert_eq(e.reason, "CSV input has more than the 2-record limit")
        }
        .Ok(_) -> panic("bound ignored")
    }
    assert_eq((csv.rows_bounded("h\nx", 2) ?? panic("CSV")).len(), 2)
    if csv.rows_bounded("h\nx\ny", 2) == { .Err(e) -> assert(e.kind == EncodingErrorKind.Limit); .Ok(_) -> panic("EOF bound ignored") }
    // Malformed excess row fails before it can complete (same as Rust push).
    if csv.rows_bounded("h\nx\nz\"", 2) == { .Err(e) -> assert(e.kind == EncodingErrorKind.Syntax); .Ok(_) -> panic("bad excess row accepted") }
}

// Rust options_and_physical_lines_apply_to_records (CsvKernel.rs:405-419).
#Test("CSV physical first record is header even when blank records are skipped") {
    rows :: csv.rows("name\tage{csv_test_cr()}\n{csv_test_cr()}\nAda\t36{csv_test_cr()}\n\"Grace{csv_test_cr()}\nHopper\"\t85", delimiter: "\t", header: true) ?? panic("CSV")
    assert_eq(rows[0].fields, [String]{"Ada", "36"})
    assert_eq(rows[0].line, 3)
    assert_eq(rows[1].fields, [String]{"Grace{csv_test_cr()}\nHopper", "85"})
    assert_eq(rows[1].line, 4)
    blank_header :: csv.rows("\nreal\nx", header: true) ?? panic("CSV")
    assert_eq(blank_header.len(), 2)
    assert_eq(blank_header[0].fields[0], "real")
}

#Test("CSV whole-value and dictionary callers share the row engine") {
    physical :: csv.rows("a,b\n\"\",x") ?? panic("CSV")
    dicts :: csv.dict_rows("a,b\n\"\",x") ?? panic("CSV")
    assert_eq(csv.dict_get(dicts[0], "a") ?? "missing", "")
    assert_eq(csv.dict_get(dicts[0], "b") ?? "missing", "x")
    assert_eq(csv.to_string(physical), "a,b\n,x\n")
    if csv.parse("x{csv_test_cr()}z") == {
        .Err(e) -> assert_eq(e.reason, "bare CR is not a record ending")
        .Ok(_) -> panic("parse bypassed engine")
    }
    if csv.dict_rows("a\nx{csv_test_cr()}z") == {
        .Err(e) -> assert_eq(csv.error_message(e), "E2701: CSV row 2, line 2, column 2 — bare CR is not a record ending")
        .Ok(_) -> panic("dict_rows bypassed engine")
    }
}
