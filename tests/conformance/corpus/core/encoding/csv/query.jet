// core-conformance: core.encoding.csv.query
use {
    csv :: core.encoding.csv
    files :: core.files
    testing :: core.testing
}

#Codable
struct Sale {
    item: String
    qty: Int
}

fn run() {
    root :: testing.temp_dir("csv-query")
    path :: Path.from(root).join("sales.csv")
    files.write(path, "item,qty\npen,3\n") ?? panic("fixture")
    query :: csv.query<Sale>(
        path.to_string(),
        SQL{"SELECT * FROM sales WHERE qty > 1"}
    ) ?? panic("query")
    result :: query.collect() ?? panic("collect")
    print(result[0].qty)
}
