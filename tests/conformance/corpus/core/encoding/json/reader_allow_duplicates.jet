// core-conformance: core.encoding.json.reader_allow_duplicates
use {
    json :: core.encoding.json
    files :: core.files
    testing :: core.testing
}

fn run() {
    root :: testing.temp_dir("json-reader-allow-duplicates")
    path :: Path.from(root).join("value.json")
    files.write(path, "{{\"a\":1,\"a\":2}}") ?? panic("fixture")
    input :: files.open(path) ?? panic("open")
    reader :: json.reader_allow_duplicates(^input) ?? panic("reader")
    result :: reader.next() ?? panic("next")
    if result == {
        .ObjectStart -> print(true)
        else -> print(false)
    }
}
