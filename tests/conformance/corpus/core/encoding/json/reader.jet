// core-conformance: core.encoding.json.reader
use {
    json: core.encoding.json
    files: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("json-reader")
    path: Path.from(root).join("value.json")
    files.write(path, "{{\"a\":1}}") ?? panic("fixture")
    input: files.open(path) ?? panic("open")
    reader: json.reader(^input) ?? panic("reader")
    result: reader.next() ?? panic("next")
    if result == {
        .ObjectStart -> print(true)
        else -> print(false)
    }
}
