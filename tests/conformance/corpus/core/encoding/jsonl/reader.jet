// core-conformance: core.encoding.jsonl.reader
use {
    jsonl :: core.encoding.jsonl
    files :: core.files
    testing :: core.testing
}

fn run() {
    root :: testing.temp_dir("jsonl-reader")
    path :: Path.from(root).join("values.jsonl")
    files.write(path, "{{\"a\":1}}\n") ?? panic("fixture")
    input :: files.open(path) ?? panic("open")
    reader :: jsonl.reader(^input) ?? panic("reader")
    print(reader.next() ?? panic("next"))
}
