{
  "description": "editor receives the full registry report and shared row fix",
  "source": "#[Codable]\nstruct Widget {\n    label: String\n}\n\nfn run() {\n    print(\"ok\")\n}\n",
  "steps": [
    {
      "send": {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}},
      "expect_contains": ["codeActionProvider"]
    },
    {
      "send": {"jsonrpc":"2.0","method":"initialized","params":{}},
      "expect_notification": null
    },
    {
      "open": {"uri": "file:///tmp/lsp_editor_report_test.jet"},
      "expect_notification": "publishDiagnostics",
      "expect_contains": [
        "\"message\":\"one marker is written without brackets\"",
        "\"codeDescription\":{\"href\":\"jet://explain/E0999\"}",
        "\"data\":{\"schema\":\"jet.report/v1\"",
        "\"why\":\"brackets group two or more markers; one marker stays bare\"",
        "\"fix\":\"replace `#[Codable]` with `#Codable`\"",
        "\"new_text\":\"#Codable\""
      ]
    },
    {
      "send": {"jsonrpc":"2.0","id":2,"method":"textDocument/codeAction","params":{"textDocument":{"uri":"file:///tmp/lsp_editor_report_test.jet"},"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":10}},"context":{"diagnostics":[]}}},
      "expect_contains": ["quickfix", "replace `#[Codable]` with `#Codable`", "\"newText\":\"#Codable\""]
    },
    {
      "send": {"jsonrpc":"2.0","id":99,"method":"shutdown","params":{}},
      "expect_contains": ["result"]
    }
  ]
}
