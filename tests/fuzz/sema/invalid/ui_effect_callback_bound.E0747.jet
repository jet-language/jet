// D-EFF2: a callback exceeding its parameter's `#Pure` effect bound is E0747.
// `transform` demands a pure callback; `noisy` carries the `IO` effect, so the
// bound is broken at the call site.

transform: fn(items: [Int], f: fn(Int) -[]> Int { ) -> [Int] { }
    return items.map(fn(x) { f(x) })
}

noisy: fn(n: Int) -> Int {
    print("{n}")
    return n
}

run: fn() {
    r: transform([1, 2], noisy)
    print("{r}")
}
