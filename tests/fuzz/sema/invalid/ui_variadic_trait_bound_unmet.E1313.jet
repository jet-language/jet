// E1313: a trait-bounded variadic call-site argument doesn't implement the
// bound trait (D-ANY-JAI1). `log(Int) Int` has no `Renderable` impl.
log_all: fn(parts: ...Renderable) {
    loop p in parts {
        print("{p}")
    }
}

run: fn() {
    double: fn(x: Int) { x * 2 }
    log_all(1, double)
}
