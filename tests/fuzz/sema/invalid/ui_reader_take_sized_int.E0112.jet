// D-SHIFT1 + S42: `take` wants an `Int` length; sized ints convert
// explicitly (`Int.from_u16(count)`), never implicitly.
fn run() {
    bytes :: [U8].{ 0x01, 0x02, 0x03, 0x04 }
    r :: Reader.over(bytes)
    count :: r.read_u16_le() ?? panic("short")
    tail :: r.take(count) ?? panic("short")
    print("{tail.len()}")
}
