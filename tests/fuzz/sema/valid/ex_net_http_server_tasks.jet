// E2-M10: HTTP server with tasks/channels — one task per connection.
// The handler function receives an HttpRequest and returns an HttpResponse;
// the server task accepts one connection (for golden-test determinism).
use core.http as http
use core.http.server as server
use core.net as net
use core.tasks as tasks

fn handle(req: HttpRequest) => HttpResponse {
    greeting :: "hello from Jet! method={req.method()} path={req.path()}"
    return server.response(200, greeting)
}

fn run() {
    (sender, ch) :: tasks.channel<String>()
    // Start the server in a background task (handles one request for golden-test determinism).
    tasks.spawn(() => {
        listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
        addr :: listener.local_addr() ?? panic("address failed")
        sender.send(~addr)
        stream :: listener.accept() ?? panic("accept failed")
        req_raw :: stream.read_text(8192) ?? panic("read failed")
        req :: http.parse(req_raw)
        resp :: handle(req)
        body :: resp.body().text(1048576) ?? panic("body failed")
        net.tcp_reply(^stream, "{resp.status()}", body) ?? panic("tcp reply")
    })
    addr :: ch.receive() ?? panic("no address")
    // Send one HTTP request and print the response body (not the address).
    resp :: http.get("http://{addr}/") ?? panic("http get failed")
    print(resp.body().text(8388608) ?? panic("body failed"))
}
