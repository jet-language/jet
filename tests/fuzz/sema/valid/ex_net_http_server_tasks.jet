// E2-M10: HTTP server with tasks — one serve_once per connection.
// The handler receives an HTTPRequest and returns an HTTPResponse; the server
// task accepts one connection (for golden-test determinism).
use core.http.client as http
use core.http.server as server
use core.net as net
use core.tasks as tasks

fn handle(req: HTTPRequest) => HTTPResponse ? HTTPError {
    greeting :: "hello from Jet! method={req.method()} path={req.path()}"
    return Ok(server.response(200, greeting))
}

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
    addr :: listener.local_addr() ?? panic("address failed")
    mux :: server.mux()
    mux.get("/", (req: HTTPRequest) => handle(req))
    t :: tasks.spawn(() => {
        server.serve_once_listener(listener, mux) ?? panic("serve failed")
    })
    resp :: http.get("http://{addr}/") ?? panic("http get failed")
    print(resp.body().text(8388608) ?? panic("body failed"))
    t.join()
}
