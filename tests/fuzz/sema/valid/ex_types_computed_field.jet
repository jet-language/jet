struct Stats {
    strength: Int
    gear_mod: Int
    attack: Int => strength * 2 + gear_mod
    threat: Int => attack + gear_mod
}

fn run() {
    s := Stats.{strength: 10, gear_mod: 3}
    print("attack: {s.attack}")
    print("threat: {s.threat}")
    s2 := Stats.{strength: 10, gear_mod: 8}
    print("attack2: {s2.attack}")
}
