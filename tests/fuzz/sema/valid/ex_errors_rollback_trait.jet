// 122 — D-TXN-ROLLBACK layer 2: the `Rollback` trait.
// A type implementing `Rollback` supplies a cheap `snapshot`/`restore` pair
// used instead of a full clone. `Ledger` records only the balance on entry.
Ledger: struct {
    balance: Int
    name: String

    impl Rollback {
        Snapshot: LedgerSnap

        snapshot: fn(self) -> LedgerSnap { return LedgerSnap{balance: self.balance} }

        restore: fn(&self, snap: &&LedgerSnap) { self.balance = snap.balance }
    }
}

LedgerSnap: struct {
    balance: Int
}

TxnErr: enum {
    Overdraft
}

transfer: fn(from: &Ledger, to: &Ledger, amount: Int) -> Int TxnErr! {
    #Transact(tx) {
        from.balance -= amount
        to.balance += amount
        if from.balance < 0 -> return Err(TxnErr.Overdraft)
    }
    return Ok(amount)
}

run: fn() {
    alice := Ledger{balance: 100, name: "Alice"}
    bob := Ledger{balance: 0, name: "Bob"}
    print("=== successful transfer ===")
    r: transfer(alice, bob, 40) ?? (-1)
    print(alice.balance)
    print(bob.balance)
    print("=== overdraft: balances restored by Rollback ===")
    s: transfer(alice, bob, 200) ?? (-1)
    print(alice.balance)
    print(bob.balance)
    print(s)
}
