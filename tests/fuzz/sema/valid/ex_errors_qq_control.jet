// 150 — `?? break` and `?? next` (D-ORRETURN-ERG1=B).
// All fallback exits live under `??`: value fallback, return, break, next.
fn run() {
    lines :: ["42", "bad", "7", "oops", "13"]
    total := 0
    loop line; lines {
        n :: Int.parse(line) ?? next
        total = total + n
    }
    print(total)
    // `?? break` exits the loop on first failure.
    loop line; lines {
        n :: Int.parse(line) ?? break
        total = total + n
    }
    print(total)
}
