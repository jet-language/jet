// Errors as values: four separate routes.
// - Explicit failure return: `return Err(...)` leaves with a failure and the
//   final `Ok(...)` is the success exit.
// - Unmarked fallible call: `age: parse_age("7")` binds the success value, or
//   leaves the calling function with the callee's failure. The call carries
//   no extra punctuation.
// - Fallback recovery: `parse_age("42") ?? 0` consumes the failure here and
//   the fallback value takes its place; nothing leaves the function.
// - Result table: `if result == { .Ok(...) ... .Err(...) ... }` reads both
//   routes and handles each one in place.
// `#Error` makes this application-owned family eligible for a typed failure
// contract. `run` names no failure type, and `ParseError` declares no
// conversion into the default `Err`, so each fallible call in `run` needs a
// fallback or a table: a bare `age: parse_age("7")` there is rejected
// (tests/ui/fallible_entry_unhandled.jet records the rejection and its
// repair).
#Error
ParseError: enum {
    Empty
    BadDigit(String)
}

parse_age: fn(raw: String) -> Int ParseError! {
    // An explicit `Err` exits this function. A plain fallible call in a
    // caller propagates that result; final `Ok` is the success expression.
    if raw == "" -> return Err(ParseError.Empty)
    if raw == "x" -> return Err(ParseError.BadDigit(raw.copy()))
    Ok(42)
}

load: fn() -> Int ParseError! {
    // This unmarked call either binds the successful age or returns the
    // ParseError from `load`; the final expression runs only on success.
    age: parse_age("7")
    Ok(age * 2)
}

run: fn() {
    // `??` is local fallback recovery: a parse failure becomes 0 and the
    // entry continues. It is not the same exit as propagation from `load`.
    parsed_age: parse_age("42") ?? 0
    print(parsed_age)
    doubled_age: load() ?? 0
    print(doubled_age)

    // A pattern table observes both result routes and handles the error
    // explicitly, so neither branch propagates out of `run`.
    // Debug is the developer-facing representation, preserving quoted
    // payloads; bare Display is reserved for user-facing presentation.
    if parse_age("x") == {
        .Ok(age) -> print(age)
        .Err(error) -> print("{error:Debug}")
    }
}
