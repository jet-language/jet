// 13 — Errors as values (M4, S34/S35/S36/S7).
enum ParseError {
    Empty
    BadDigit(String)
}

fn parse_age(raw: String) => Int ? ParseError {
    if raw == "" { return Err(ParseError.Empty) }
    if raw == "x" { return Err(ParseError.BadDigit(~raw)) }
    return Ok(42)
}

fn load() => Int ? ParseError {
    n :: parse_age("7")?
    return Ok((n * 2))
}

fn run() {
    a :: parse_age("42") ?? 0
    print(a)
    doubled :: load() ?? 0
    print(doubled)
    if parse_age("x") == {
        .Ok(n) -> { print(n) }
        .Err(e) -> { print(e) }
    }
}
