// D-ROUTE1=A: HTTP router — typed path inputs, 404/405.
// mux.get/post register routes; dynamic fields bind to handler inputs.
// app.serve_once drives one connection at a time so golden output order
// stays fixed.
use {
    web: core.web
    http: core.http.client
    server: core.http.server
    net: core.net
    tasks: core.tasks
}

handle_root: fn(req: HTTPRequest) -> HTTPResponse HTTPError! { Ok(server.response(200, "welcome")) }

handle_user: fn(id: String) -> HTTPResponse HTTPError! {
    return Ok(server.response(200, "user={id}"))
}

handle_create: fn(req: HTTPRequest) -> HTTPResponse HTTPError! { Ok(server.response(201, "created")) }

run: fn() {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
    addr: listener.local_addr() ?? panic("address failed")
    mux: web.app()
    mux.get("/", fn(req: HTTPRequest) { handle_root(req) })
    mux.get("/users/:id", fn(id: String) { handle_user(id) })
    mux.post("/users", fn(req: HTTPRequest) { handle_create(req) })
    t: task {
        loop i in [0, 1, 2, 3] {
            mux.serve_once(listener) ?? panic("serve failed")
        }
    }
    r1: http.get("http://{addr}/") ?? panic("GET / failed")
    print(r1.body().text(8388608) ?? panic("body failed"))
    r2: http.get("http://{addr}/users/42") ?? panic("GET /users/42 failed")
    print(r2.body().text(8388608) ?? panic("body failed"))
    r3: http.post("http://{addr}/users", "") ?? panic("POST /users failed")
    print(r3.body().text(8388608) ?? panic("body failed"))
    r4: http.get("http://{addr}/missing") ?? panic("GET /missing failed")
    print(r4.status())
    t.join() ?? panic("server failed")
}
