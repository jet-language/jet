// 181 — D-INDEX-HOOK: expert `mytype[k]` via Index + IndexMut
struct Tile {
    value: Int
}

struct Grid {
    cells: [Tile]
}

impl Grid.Index {
    type Key = Int
    type Value = Int

    fn get(self, k: Int) => (Int?) {
        if k < 0 || k >= self.cells.len() { return None }
        return Val(self.cells[k].value)
    }
}

impl Grid.IndexMut {
    fn set(&self, k: Int, v: Int) {
        if k >= 0 && k < self.cells.len() { self.cells[k].value = v }
    }
}

fn run() {
    g := Grid.{cells: [Tile.{value: 1}, Tile.{value: 2}]}
    g[1] = 99
    print("g[1]: {g[1]}")
}
