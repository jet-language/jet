// D-TESTKIT1=A, D-TEST1: a parameterized `#Test fn` is a property test.
//
// `jet test` generates inputs for its parameters and, on a failure, shrinks
// the input greedily to a minimal counterexample.
//
// Try: `jet test Examples/features/tooling/fuzz_demo.jet`
fn reverse(xs: [Int]) -> [Int] {
    out := [Int]{}
    loop x in xs -> &out.insert(0, x)
    return out
}

fn run() { print("{reverse([1, 2, 3])}") }

// A true invariant: reversing twice returns the original list, for every
// generated list. `jet test` finds no counterexample (there is none) — the
// demo shows the clean-run report shape, not a failure.
#Test fn reverse_twice_is_identity(xs: [Int]) {
    assert_eq(reverse(reverse(xs)), xs)
}
