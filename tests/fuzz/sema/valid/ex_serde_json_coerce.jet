// Strict untyped JSON decode (core.encoding.json.decode): every scalar keeps
// the JSON type it was written as. A quoted "8080" stays text and an
// unquoted 8080 is a number, read with `.Number(text)`; nothing is coerced.
use json: core.encoding.json

run: fn() {
    raw: "{{\"port\":8080,\"enabled\":true,\"name\":\"api\",\"build\":\"8080\"}}"
    data: json.decode(raw) ?? panic("bad json")
    if data == .Object(_) {
        port: data.field("port") ?? Dyn.Null
        name: data.field("name") ?? Dyn.Null
        enabled: data.field("enabled") ?? Dyn.Null
        build: data.field("build") ?? Dyn.Null
        if port == .Number(text) {
            n: Int.parse(text) ?? panic("port is not an Int")
            print(n + 1)
        }
        if name == .Text(s) -> print(s)
        if enabled == .Bool(b) -> print(b)
        if build == .Text(s) -> print(s)
    }
}
