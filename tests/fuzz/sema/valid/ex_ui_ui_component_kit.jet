use ui: core.ui

Label: struct {
    text: String
}

label: fn(text: String) -> Label { return Label{text: text.copy()} }

label_view: fn(value: Label) -> UINode { ui.text(value.text) }

Input: struct {
    value: String
    placeholder: String
}

input: fn(placeholder: String) -> Input { return Input{value: "", placeholder: placeholder.copy()} }

input_view: fn(value: Input) -> UINode {
    shown := value.value.copy()
    if value.value == "" -> shown = value.placeholder.copy()
    return ui.node_role(shown, 20.0, 1.0, ui.aria_role_text_input())
}

Button: struct {
    label: String
}

button: fn(label: String) -> Button { return Button{label: label.copy()} }

button_view: fn(value: Button) -> UINode { ui.button(value.label) }

container: fn(children: [UINode]) -> UINode { ui.box(children) }

run: fn() {
    tree := container([label_view(label("Name")), input_view(input("type")), button_view(button("Save"))])
    backend := ui.null_backend()
    backend.paint(tree)
}
