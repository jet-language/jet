// 17 — Strings & Char (M5).
fn run() {
    loop c in "héllo".chars() -> print(c)
    print("  hi  ".trim())
    parts :: "a,b,c".split(",")
    print(parts.len())
    // D-STR-AFTER1: first-occurrence substring split.
    print("nate@jet-lang.dev".after("@"))
    print("nate@jet-lang.dev".before("@"))
    // `sep` absent -> the whole original string on both sides.
    print("no-at-sign".after("@"))
    print("no-at-sign".before("@"))
}
