use core.time.datetime as datetime

fn run() {
    // Unix epoch: 2024-03-15 12:30:45 UTC
    ts: Int :: 1710502245
    dt :: datetime.from_timestamp(ts)
    print(dt.to_timestamp())
    d :: dt.date()
    print(d.to_string())
    print(dt.hour())
    print(dt.minute())
    print(dt.second())
    print(dt.to_string())
}
