// `#Caps(…) { … }` (D-EFF1) restricts a block to a fixed set of effects: only
// those listed may be used inside, directly or through any call it reaches.
// An out-of-set effect is a compile error (E0741). The region is a plain
// lexical block in codegen — the restriction is a compile-time proof only.
fn announce(label: String, n: Int) #(Io) {
    print("{label}: {n}")
}

fn run() {
    // Inside, only `Io` is permitted — `announce` uses exactly `Io`, so it fits.
    #Caps(Io) {
        announce("answer", 42)
    }
}
