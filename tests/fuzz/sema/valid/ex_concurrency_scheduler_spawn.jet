// 160 — D-ASYNCRT1=A M2: M:N scheduler — spawn pool + channel wake-on-send.
use core.tasks as tasks

fn run() {
    (sender, ch) :: tasks.channel<Int>()
    loop i, 1..1000 {
        dup :: ~sender
        dup2 :: ~sender
        task dup.send(1)
    }
    total := 0
    loop i, 1..1000 {
        total += (ch.receive() ?? panic("channel closed"))
    }
    print(total)
}
