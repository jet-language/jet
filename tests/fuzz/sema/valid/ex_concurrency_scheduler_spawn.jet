// 160 — D-ASYNCRT1=A M2: M:N scheduler — spawn pool + channel wake-on-send.
use core.tasks as tasks

fn run() {
    { sender, receiver: ch } :: channel<Int>()
    loop i in 1..1000 {
        dup :: sender.copy()
        dup2 :: sender.copy()
        task dup.send(1)
    }
    total := 0
    loop i in 1..1000 -> total += (ch.receive() ?? panic("channel closed"))
    print(total)
}
