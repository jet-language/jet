// Typed Core data schema + ingest/select slice (D-WD9, D-DATA-SURFACE1, #237 C1).
use core.data as data

#Codable
struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    raw :: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0"
    rows :: data.csv<Ticket>(raw) ?? panic("bad csv")
    cols :: data.schema(rows)
    loop c in cols -> print("{c.name}:{c.type_name}")
    selected :: data.query(rows)
        .filter((t) -> t.minutes >= 5.0)
        .collect() ?? panic("filter")
    print("selected:{data.count(selected)}")
    loop t in selected -> print("{t.team}:{t.minutes}")
    print("{data.status()[4].step}:{data.status()[4].path}")
}
