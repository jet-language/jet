// D-DATAFLOW1=A: bounded typed pull stream + typed DataError.
use core.data as data
use core.files as files

#Codable
struct Event {
    service: String
    latency_ms: Float
}

fn run() {
    path :: "/tmp/jet_data_stream_bounds.csv"
    files.write(path, "service,latency_ms\napi,10.0\napi,20.0\ndb,5.0\napi,30.0") ?? panic("write")
    input :: files.open(path) ?? panic("open")
    limits := data.DataLimits.safe()
    limits.max_output_rows = 2
    reader :: data.csv_reader<Event>(^input, limits) ?? panic("reader")
    first :: reader.next() ?? panic("next")
    print("first: {first.service} {first.latency_ms}")
    if data.stream.collect(reader) == {
        .Ok(rows) -> {
            groups :: data.query(rows)
                .group_by((e) -> e.service)
                .mean((e) -> e.latency_ms)
                .collect() ?? panic("group mean")
            print("unexpected ok {data.count(groups)}")
        }
        .Err(error) -> print("{error}")
    }
    empty_vals :: [Float]{}
    if data.mean(empty_vals) == {
        .Ok(v) -> { print("unexpected mean {v}") }
        .Err(error) -> print("{error}")
    }
    if data.quantile([1.0, 2.0], 1.5) == {
        .Ok(v) -> { print("unexpected q {v}") }
        .Err(error) -> print("{error}")
    }
}
