// core.http.server: function-first mux with path params.
use {
    web: core.web
    http_server: core.http.server
    net: core.net
    tasks: core.tasks
}

run: fn() {
    mux: web.app()
    mux.get("/", fn(req: HTTPRequest) { Ok(http_server.response(200, "hello from mux")) })
    mux.get("/ping", fn(req: HTTPRequest) { Ok(http_server.response(200, "pong")) })
    mux.post("/echo", fn(req: HTTPRequest) { Ok(http_server.response(200, req.body().text(1048576) ?? "invalid body")) })
    print("mux ready")
}
