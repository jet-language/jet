// Typed Core data JSON ingest + select slice (D-WD9, D-DATA-SURFACE1, #237 C1).
use core.data as data

#Codable
struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    raw :: "[{{\"team\":\"Core\",\"minutes\":4.0}},{{\"team\":\"Tools\",\"minutes\":5.0}},{{\"team\":\"Core\",\"minutes\":8.0}}]"
    rows :: data.json<Ticket>(raw) ?? panic("bad json")
    cols :: data.schema(rows)
    loop c in cols -> print("{c.name}:{c.type_name}")
    selected :: data.query(rows)
        .filter((t) -> t.minutes >= 5.0)
        .collect() ?? panic("filter")
    print("selected:{data.count(selected)}")
    loop t in selected -> print("{t.team}:{t.minutes}")
    print("{data.status()[5].step}:{data.status()[5].path}")
}
