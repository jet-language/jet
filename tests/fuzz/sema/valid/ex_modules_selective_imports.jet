// D-CORE-USELIST1=A: `use mod.[a, b]` and `use alias: mod.item`.
// Items are brought into scope directly; aliases resolve name conflicts.
// Grouped: `abs` imported under the local name `absolute`.
use {
    math.[clamp]
    absolute: math.abs
}

math: module {
    clamp: fn(x: Int, lo: Int, hi: Int) -> Int {
        if x < lo -> return lo
        if x > hi -> return hi
        return x
    }

    abs: fn(x: Int) -> Int {
        if x < 0 -> return -x
        return x
    }
}

run: fn() {
    print(clamp(15, 0, 10))
    print(absolute(-7))
}
