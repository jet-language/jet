// 84 — String parsing and line splitting (c97 / D-STRPARSE1).
fn run() {
    // Int.parse(text) — fallible integer parse, returns Int ? ParseError.
    n :: Int.parse("42") ?? -1
    print((n + 1))
    // A bad parse takes the `??` fallback.
    bad :: Int.parse("oops") ?? -1
    print(bad)
    // String.lines() — split text into its lines.
    text :: "first\nsecond\nthird"
    lines :: text.lines()
    print(lines.len())
    loop line; lines {
        print(line)
    }
    // Sum the numbers on each line.
    total := 0
    loop row; "10\n20\n30".lines() {
        total += (Int.parse(row) ?? 0)
    }
    print(total)
}
