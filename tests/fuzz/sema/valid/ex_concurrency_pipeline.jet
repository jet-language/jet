use core.tasks as tasks

fn run() {
    (s1, ch) :: channel<Int>()
    s2 :: ~s1
    s3 :: ~s1
    t1 :: task {
        s1.send(30)
    }
    t2 :: task {
        s2.send(10)
    }
    t3 :: task {
        s3.send(20)
    }
    t1.join() ?? panic("task 1 failed")
    t2.join() ?? panic("task 2 failed")
    t3.join() ?? panic("task 3 failed")
    s1.close()
    s2.close()
    s3.close()
    results := [Int]{}
    loop value in ch -> results.push(value)
    results.sort()
    loop x in results -> print(x)
}
