// E2-M15: typed no-OS target example.
// Build with:
//   jet build --target=board.sensor_v1 61_freestanding.jet
//
// Only core-level APIs are used: no file I/O, no network, no threads.
// The named target profile admits only APIs supported by its typed providers.
use math: core.math

clamp: fn(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo -> return lo
    if x > hi -> return hi
    return x
}

run: fn() {
    a: clamp(15, 0, 10)
    b: clamp((-3), 0, 10)
    root: math.sqrt(16.0)
    print("freestanding: clamp(15,0,10)={a}, clamp(-3,0,10)={b}, sqrt(16)={root}")
}
