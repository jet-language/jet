// Access-capability sigils (D-MEM1): the capability rides the type — `&T` write,
// `^T` move/take — and the call site mirrors it. Receivers carry the sigil on
// `self`. Plain `T` / `self` is read (the default, no sigil).
Player: struct {
    hp: Int
    name: String
}

// `&Player` = the callee may edit the player; `amount: Int` is plain read.
damage: fn(p: &Player, amount: Int) { p.hp -= amount }

// Plain `Player` = shared/read access at a call boundary — no sigil needed.
report: fn(p: Player) { print("{p.name}: {p.hp}") }

impl Player {
    show: fn(self) -> Int { self.hp }

    heal: fn(&self, amount: Int) { self.hp += amount }
}

run: fn() {
    p := Player{hp: 100, name: "Aria"}
    damage(&p, 30)  // call site mirrors the `&` write capability
    report(p)  // plain read, no sigil
    &p.heal(10)  // receiver `&self`, clean method-call syntax
    print(p.show())
}
