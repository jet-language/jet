// E2-M9: jet.csv — parse and clean a CSV table.
use core.encoding.csv as csv

fn run() {
    raw :: "name,score,grade\nAlice,95,A\nBob,\"82\",B\nCarol,71,C"
    rows :: csv.parse(raw) ?? panic("csv parse failed")
    loop row; rows {
        name :: row[0]
        score :: row[1]
        print("{name}: {score}")
    }
    rebuilt :: csv.to_string(rows)
    print((rebuilt.len() > 0))
}
