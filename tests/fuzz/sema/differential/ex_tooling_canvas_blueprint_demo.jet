fn helper() -> Int {
    return 1
}

fn square(n: Int) -> Int {
    return n * n
}

fn summarize(limit: Int) -> Int {
    if true {
        print("branch")
    } else {
        print("else")
    }
    total := square(limit)
    if total > 10 {
        return total
    } else {
        return total + 1
    }
}

fn run() {
    print(summarize(4))
}
