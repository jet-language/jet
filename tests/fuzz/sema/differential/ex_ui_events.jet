package: {
    name: "ui_events"
    version: "0.1.0"
    authority: { allow: [Exec, IO, Mem.Alloc, Time.Wait] }
}
// One typed Event/Hook family.
use event: core.event

EventLabel: trait {
    label: fn(self) -[]> String
}

PublishedEvent: struct {
    value: String

    impl EventLabel {
        label: fn(self) -[]> String { return self.value }
    }
}

show_publish: fn(outcome: HookOutcome<Int, String>) {
    if outcome == {
        .Continue(value) -> print("publish {value}")
        .Cancel -> print("publish cancelled")
        .Fail(error) -> print("publish failed {error}")
    }
}

run: fn() {
    scope: event.scope()
    clicked: event.new<Int>()
    sub: clicked.on(scope, fn(n) { print("clicked {n}") })
    clicked.once(scope, fn(n) { print("once {n}") })
    first: clicked.emit(1)
    print(first.summary())
    second: clicked.emit(2)
    print(second.summary())
    print("active {scope.active_count()}")
    sub.unsubscribe()
    third: clicked.emit(3)
    print(third.summary())
    print("active {scope.active_count()}")
    before_save: event.hook<Int, String>("allow")
    before_save.on_priority(scope, 10, fn(n) { "seen {n}" })
    print(before_save.run(5, "fallback"))
    async_scope: event.scope()
    queued: event.async_result<Int, String>(AsyncPolicy{capacity: 1, overflow: .Block}, .Collect) ?? panic("policy")
    queued.on(async_scope, fn(n: Int) { print("async {n}") })
    async_report: queued.emit_async(7).join() ?? panic("join")
    print("async delivered={async_report.state() == .Delivered} handlers={async_report.delivered_handlers()}")
    queued.close()
    decision_scope: event.scope()
    before_publish: event.decision_hook<Int, String>(HookPolicy.FirstCancelElseTransform)
    before_publish.on_priority(decision_scope, 10, fn(n: Int) { HookDecision.Transform(n + 1) })
    before_publish.on(decision_scope, fn(n: Int) { HookDecision.Continue })
    show_publish(before_publish.run(7))
    scope.cancel()
    print("after cancel {scope.active_count()}")
}
