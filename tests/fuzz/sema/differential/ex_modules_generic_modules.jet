// D-CONF-GENSPELL1=A: generic module templates and aliases (card #91).
//
// A generic module is a module template parameterised by types and values.
// `cache: module<K>` defines the template; `int_cache: cache<Int>`
// instantiates it, producing a concrete module with all type params resolved.
cache: module<K> {
    key_of: fn(k: K) -> String { "key" }

    describe: fn() -> String { "generic cache" }
}

int_cache: cache<Int>

run: fn() {
    k: int_cache.key_of(42)
    d: int_cache.describe()
    print(k)
    print(d)
}
