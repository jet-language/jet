// D-PREP-SURFACE2=A: `#run { … }` execution block.
// Runs at build time via the comptime interpreter; erases entirely — no runtime
// Rust is emitted (I3). A value that outlives it is prepared explicitly with
// `name: #run value`.
LIMIT: #run 1000

BASE: #run 10

run: fn() {
    ratio: #run { LIMIT /% BASE }
    // Build-time assertion: verify constants are valid before compiling.
    #run {
        if ratio < 1 -> panic("limit must be >= base")
    }
    print("limit: {LIMIT}")
    print("base: {BASE}")
    print("ratio: {ratio}")
}
