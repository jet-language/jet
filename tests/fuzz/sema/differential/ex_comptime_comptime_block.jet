// D-META-STAGE1=B: `@ { … }` execution block.
// Runs at build time via the comptime interpreter; erases entirely — no runtime
// Rust is emitted (I3). A block-local comptime binding can be spliced into
// runtime code with `@name` after the block.
@LIMIT :: 1000

@BASE :: 10

fn run() {
    // Build-time assertion: verify constants are valid before compiling.
    @ {
        @ratio :: @LIMIT /% @BASE
        if @ratio < 1 -> panic("limit must be >= base")
    }
    // The block ran at build time and produced no runtime code. Its comptime
    // binding leaks into the surrounding comptime scope, so `@ratio` splices a
    // runtime literal.
    print("limit: {@LIMIT}")
    print("base: {@BASE}")
    print("ratio: {@ratio}")
}
