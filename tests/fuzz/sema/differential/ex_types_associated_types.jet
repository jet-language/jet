// 113 — associated types on a trait (D-LIB2). A trait may declare a `type` its
// impls fill in. `Indexed` names an element type `Elem` it returns; `Nums` sets
// `Elem = Int`. Method signatures use the abstract `Elem` in the trait and the
// concrete type in the impl — the checker resolves one against the other, and an
// impl that forgets to set `type Elem = …` is rejected (E0913).
trait Indexed {
    type Elem
    fn at(self, i: Int) -> Elem
    fn count(self) -> Int
}

struct Nums {
    vals: [Int]
}

impl Nums.Indexed {
    type Elem = Int

    fn at(self, i: Int) -> Int { return self.vals[i] }

    fn count(self) -> Int { return self.vals.len() }
}

fn run() {
    n :: Nums.{vals: [10, 20, 30]}
    print(n.at(0))
    print(n.at(2))
    print(n.count())
}
