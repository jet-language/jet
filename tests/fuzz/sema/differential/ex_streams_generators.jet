// D-STREAMYIELD1: a generator returns `Stream<T>` and uses `yield` to hand a
// value to the consumer, suspending until the next pull. One keyword
// (`yield`), one type (`Stream<T>`); consumers are ordinary loops — no
// async/await coloring anywhere.
fn count(n: Int) => Stream<Int> {
    i := 0
    loop i < n {
        yield i
        i += 1
    }
}

fn run() {
    loop x; count(3) {
        print("{x}")
    }
}
