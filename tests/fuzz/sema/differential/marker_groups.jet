// Shared native/Source compiler input: fixed arguments and nested lexical names.
Fast: struct {
    impl Marker {
        group: #[Inline(.Always), Scalar]
    }
}
#Fast local: fn(value: Int) -> Int { return value + 1 }

library: module {
    Label: struct {
        text: String

        impl Marker {
            sites: [.Function]
        }
    }
    Traced: struct {
        impl Marker {
            group: #[Label("fixed"), Inline]
        }
    }
    #Traced work: fn(value: Int) -> Int { return value * 2 }
}

run: fn() {
    print("local:{local(6)}")
    print("nested:{library.work(6)}")
}
