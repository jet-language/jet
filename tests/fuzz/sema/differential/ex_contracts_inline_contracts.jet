// Checked `#Inline` contracts.
// `#Inline` is a soft hint (the compiler is free to ignore it; never an
// error). `#Inline(Always)` is a guarantee: every direct call is inlined on
// every tier (O0, O1, O2 and compile-time code), or the build fails naming
// why (a call of itself or a cycle of marked calls, address taken, too
// large, `#Scrub`, or a read of `context.trace`) — never a silent miss.
// Methods take the mark too; `jet inspect choices` lists each inlined call.
#Inline square: fn(x: Int) -> Int { x * x }

#Inline(Always) double: fn(x: Int) -> Int { x * 2 }

Meters: struct {
    value: Int

    #Inline(Always) plus: fn(self, other: Int) -> Int { self.value + other }
}

run: fn() {
    m: Meters{value: 7}
    print("{square(4)} {double(5)} {m.plus(3)}")
}
// --- expected output --------------------------------------------------
// 16 10 10
