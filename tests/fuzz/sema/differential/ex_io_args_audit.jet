// D-COREARGS1: one ArgsSpec model covers builder-driven CLIs with short flags,
// typed options, defaults, repeated values, subcommands, suggestions, and
// completion text.
use core.args as args

fn run() {
    serve :: args.spec()
        .option_int("port", "listen port", "PORT")

    spec :: args.spec()
        .flag_short("verbose", "v", "print extra detail")
        .option_int("jobs", "worker count", "N")
        .option_default("mode", "run mode", "MODE", "fast")
        .option_choice("color", "color policy", "WHEN", "auto,always,never")
        .repeat("tag", "classification tag", "TAG")
        .subcommand("serve", "run the server", serve)
        .version("args-audit 1.0")

    argv :: ["tool", "-vv", "--jobs", "4", "--color=never", "--tag", "alpha", "--tag=beta", "serve", "--port", "8080"]
    parsed :: spec.parse(argv) ?? panic("bad args")

    print(parsed.flag("verbose"))
    print(parsed.option_int("jobs") ?? 0)
    print(parsed.option("mode") ?? "")
    print(parsed.option("color") ?? "")
    print(parsed.options("tag").len())
    print(parsed.subcommand() ?? "")
    print(parsed.option_int("port") ?? 0)
    print(spec.completion("bash").contains("--jobs"))
}
