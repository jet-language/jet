// D-META-EFFECT1: shared Core effect facts admit deterministic `core.math`
// calls at compile time; ambient modules remain gated.
// The results are constant-folded into the binary — no runtime math involved.
use core.math as math

SQRT4 :: prep { math.sqrt(4.0) }

POW2 :: prep { math.pow(2.0, 8.0) }

FLOORED :: prep { math.floor(3.7) }

CEILED :: prep { math.ceil(2.1) }

MAXI :: prep { math.max(10.0, 20.0) }

fn run() {
    print(SQRT4)
    print(POW2)
    print(FLOORED)
    print(CEILED)
    print(MAXI)
}
