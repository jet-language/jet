// D-META-EFFECT1: shared Core effect facts admit deterministic `core.math`
// calls at compile time; ambient modules remain gated.
// The results are constant-folded into the binary — no runtime math involved.
use math: core.math

SQRT4: #run math.sqrt(4.0)

POW2: #run { Float{2.0}.pow(Float{8.0}) }

FLOORED: #run math.floor(3.7)

CEILED: #run math.ceil(2.1)

MAXI: #run max(10.0, 20.0)

run: fn() {
    print(SQRT4)
    print(POW2)
    print(FLOORED)
    print(CEILED)
    print(MAXI)
}
