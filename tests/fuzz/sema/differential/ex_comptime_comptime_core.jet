// D-META-EFFECT1: shared Core effect facts admit deterministic `core.math`
// calls at compile time; ambient modules remain gated.
// The results are constant-folded into the binary — no runtime math involved.
use math: core.math

SQRT4: comptime { math.sqrt(4.0) }

POW2: comptime { Float{2.0}.pow(Float{8.0}) }

FLOORED: comptime { math.floor(3.7) }

CEILED: comptime { math.ceil(2.1) }

MAXI: comptime { max(10.0, 20.0) }

run: fn() {
    print(SQRT4)
    print(POW2)
    print(FLOORED)
    print(CEILED)
    print(MAXI)
}
