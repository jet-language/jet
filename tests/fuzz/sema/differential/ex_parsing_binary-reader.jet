// D-SHIFT1 (c7shift): `binary.Reader` — the "shift" kernel from linear
// stream parsing (Jai's `shift` primitive), without a dedicated operator.
// `Reader.over(bytes)` wraps a `[U8]` buffer; every read advances the
// position and returns `? Error` — a bounds miss is an ordinary error
// value, never a panic or silent truncation (I1).
fn run() {
    // header/count/payload wire shape: a little-endian u32 magic, a
    // little-endian u16 item count, then that many raw bytes.
    packet: [U8] :: [0x2a, 0x00, 0x00, 0x00, 0x03, 0x00, 0x10, 0x20, 0x30]
    // magic = 42
    // count = 3
    // payload
    r :: Reader.over(packet)
    magic :: r.read_u32_le() ?? panic("bad packet: no magic")
    count :: r.read_u16_le() ?? panic("bad packet: no count")
    // `take` wants an `Int` length; sized ints convert explicitly (S42).
    payload :: r.take(Int.from_u16(count)) ?? panic("bad packet: short payload")
    print("magic={magic} count={count} payload_len={payload.len()}")
    print("remaining={r.remaining()} is_at_end={r.is_at_end()}")
    // A bounds miss is an ordinary error value — `?`-composable, never a panic.
    short: [U8] :: [0x01]
    r2 :: Reader.over(short)
    if r2.read_u32_le() == {
        Ok(v) -> {
            print("unexpected ok: {v}")
        }
        Err(e) -> {
            print("expected error: {e}")
        }

    }
}
