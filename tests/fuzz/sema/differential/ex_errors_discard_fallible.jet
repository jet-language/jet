// D-IGNORERET2=A: explicit discard of fallible / #MustUse results.
// `.drop("reason")` is the sole discard spelling (D-MARK-DISCARD1=A —
// the `#Suppress(MustUse) { … }` lexical-scope form is retired outright).
use core.files as fs

fn run() {
    // `.drop("reason")` silences E0402 for a fallible result.
    fs.write("/tmp/jet_discard_out.txt", "hello").drop("best-effort write, not critical")
    fs.write("/tmp/jet_discard_a.txt", "x").drop("best-effort write, not critical")
    fs.write("/tmp/jet_discard_b.txt", "y").drop("best-effort write, not critical")
    print("discard ok")
}
