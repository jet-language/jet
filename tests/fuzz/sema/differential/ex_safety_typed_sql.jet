// D-TYPEDTEXT1/2: a string literal in a position expecting `Sql`/`Html`, or a
// prefix literal (`sql"..."` / `html"..."`) with no expected type, elaborates to
// a checked value. Each `{hole}` becomes a bound parameter (Sql) or an escaped
// insertion (Html); a runtime `String` can never fill the position directly
// (E0149) — `.raw("…")` is the sole audited escape.
fn run_query(q: Sql) {
    print("template: {q.template()}")
    print("param count: {q.params().len()}")
}

fn render(h: Html) {
    print("html: {h.text()}")
}

fn run() {
    id :: 42
    q :: sql"select * from incidents where id = {id}"
    run_query(q)
    name :: "<script>alert(1)</script>"
    page :: html"<p>{name}</p>"
    render(page)
    trusted :: Html.raw("<b>audited</b>")
    render(trusted)
}
