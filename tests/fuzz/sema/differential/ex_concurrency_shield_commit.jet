// D-SHIELDNAME1=A / R12: AOT and dev both defer race cancellation until the
// shielded commit finishes. Code after the block never runs.
use time: core.time

shielded_commit: fn() -> Int {
    #Shield {
        time.sleep(20ms)
        print("committed")
    }
    print("after shield")
    return 1
}

fast_seven: fn() -> Int { 7 }

run: fn() {
    task.group g {
        winner: task.race {shielded_commit(), fast_seven()} ?? panic("race failed")
        print(winner)
    }
}
