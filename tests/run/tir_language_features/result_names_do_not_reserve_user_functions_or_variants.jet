
enum Wrapped {
    Val(Int)
    Ok(Int)
    Err(Int)
}

fn Ok(value: Int) -> Int {
    return (value + 10)
}

fn Err(value: Int) -> Int {
    return (value + 20)
}

fn run() {
    print(Ok(1))
    print(Err(2))
    wrapped :: Wrapped.Val(7)
    if wrapped == {
        .Val(value) -> { print(value) }
        .Ok(value) -> { print(value) }
        .Err(value) -> { print(value) }
    }
}
