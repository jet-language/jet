// A consuming method (`&&self`) takes the value and drops it when it
// returns, like a free function with a `&&` parameter does. A struct holding a
// listener closes it there, so its port rebinds right after the call, whether
// the method body is empty or moves a field out.
package: {
    name: "consuming_method_drops_self"
    authority: { allow: [IO, Mem.Alloc, Net] }
}

use net: core.net

Reservation: struct {
    ports: [Int]
    listeners: [TCPListener]

    release_empty: fn(&&self) {}
    release_field: fn(&&self) {
        held: self.listeners
    }
}

reserve: fn() -[Net]> Reservation NetError! {
    held := [TCPListener]{}
    listener: net.tcp_listen("127.0.0.1:0")
    address: net.listener_local_socket_addr(listener)
    held.push(listener)
    Reservation{ports: [Int]{net.socket_port(address)}, listeners: held}
}

release_free: fn(reservation: &&Reservation) {}

try_bind: fn(label: String, port: Int) -[Net, IO]> {
    if net.tcp_listen("127.0.0.1:{port}") == {
        .Ok(_) -> print("{label}: rebind ok")
        .Err(error) -> print("{label}: rebind FAILED {error}")
    }
}

run: fn() {
    empty: reserve() ?? panic("reserve empty")
    empty_port: empty.ports[0]
    empty.release_empty()
    try_bind("consume empty", empty_port)
    field: reserve() ?? panic("reserve field")
    field_port: field.ports[0]
    field.release_field()
    try_bind("consume field", field_port)
    free: reserve() ?? panic("reserve free")
    free_port: free.ports[0]
    release_free(free)
    try_bind("free fn", free_port)
}
