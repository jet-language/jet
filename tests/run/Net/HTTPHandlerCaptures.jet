// A route handler closure captures enclosing locals: a policy-scoped DB
// handle (a borrowed resource) and a plain String. The handler runs once per
// request on the server task; the enclosing function keeps using the same
// scope afterwards, so the captured handle shares the one connection.
// app.serve_once drives one connection at a time so golden output order
// stays fixed.
package: {
    name: "http_handler_captures"
    authority: { allow: [DB, DB.Read, DB.Write, FS.Read, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use {
    web: core.web
    db: core.db
    http: core.http.client
    server: core.http.server
    net: core.net
}

post_order: fn(addr: String, user: String) -> String Never! {
    if http.request("POST", "http://{addr}/order").header("x-user", user).send() == {
        .Ok(resp) -> "{resp.status()} {resp.text() ?? "invalid body"}"
        .Err(_) -> "request failed"
    }
}

run: fn() (HTTPError | NetError | TaskFailure)! {
    conn: db.open_memory() ?? panic("open")
    policy: db.policy("orders", "true") ?? panic("policy")
    scope: conn.with_policy(policy, "service")
    db.migrate(scope, "orders-v1", [SQL{"CREATE TABLE orders (user TEXT)"}]) ?? panic("migrate")
    greeting: "accepted"

    listener: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
    addr: listener.local_addr() ?? panic("address failed")
    mux: web.app()
    mux.post("/order", fn(req: HTTPRequest) {
        user: req.header("x-user") ?? "anonymous"
        scope.execute(SQL{"INSERT INTO orders (user) VALUES ({user})"}) ?? panic("insert")
        Ok(server.response(200, "{greeting} {user}"))
    })
    t: task {
        mux.serve_once(listener) ?? panic("serve failed")
        mux.serve_once(listener) ?? panic("serve failed")
    }
    print(post_order(addr, "alice"))
    print(post_order(addr, "bob"))
    t.join() ?? panic("server failed")

    row: scope.query_one(SQL{"SELECT COUNT(*) AS n FROM orders"}) ?? panic("count")
    print("rows after requests: {db.row_int(row, "n") ?? 0}")
}
