no blank line: GET /health host=localhost id=a body=[]
trailing newline: GET /health host=localhost id=b body=[]
blank line: GET /health host=localhost id=c body=[]
crlf head: GET /health host=localhost id=d body=[]
crlf framed: GET /health host=localhost id=e body=[]
body: POST /orders host=localhost id=- body=[hello]
unreadable: GET / host=- id=- body=[]
