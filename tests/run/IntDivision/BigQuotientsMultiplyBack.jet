// Big Int floor division multiplies back. For every dividend n and divisor d
// here, q = n /% d and r = n % d give q * d + r == n, with r from 0 toward d
// and smaller than d in size. The operands have one to nine base-1e9 limbs,
// both signs, and top limbs of 1, 7, 99999999, 100000000, 123456789 and
// 999999999, where the runtime's quotient-limb bounds (Int.jet
// int_division) cut the divisor's top two limbs to nine digits. The digest
// and the sample quotients pin the answers themselves.
LIMB: 1000000000

number: fn(top: Int, fill: Int, length: Int, negative: Bool) -> Int {
    value := top
    loop i in 1..<length -> value = value * LIMB + (fill + i * 104729) % LIMB
    if negative -> -value else -> value
}

run: fn() {
    tops: [Int]{1, 7, 99999999, 100000000, 123456789, 999999999}
    fills: [Int]{0, 999999999, 314159265}
    values := [Int]{}
    loop length in 1..<10 {
        loop top in tops {
            loop fill in fills {
                values.push(number(top, fill, length, (length + top + fill) % 2 == 1))
            }
        }
    }
    checked := 0
    wrong := 0
    digest := 0
    loop n in values {
        loop d in values {
            q: n /% d
            r: n % d
            inside: if d > 0 -> r >= 0 && r < d else -> r <= 0 && r > d
            if q * d + r != n || !inside {
                wrong += 1
                if wrong <= 5 -> print("wrong: {n} /% {d} gave {q} rest {r}")
            }
            digest = (digest * 31 + q % 1000003 + r % 999983) % 4294967291
            checked += 1
        }
    }
    print("{checked} divisions, {wrong} wrong, digest {digest}")
    print(values[values.len() - 1] /% values[30])
    print(values[values.len() - 2] % values[60])
    print(number(999999999, 999999999, 9, false) /% number(1, 0, 3, false))
    print(number(1, 0, 9, false) /% number(999999999, 999999999, 2, false))
}
