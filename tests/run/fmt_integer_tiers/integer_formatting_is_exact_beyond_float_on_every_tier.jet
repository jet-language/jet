// #6608: core.text fmt formats whole numbers in exact Int arithmetic, so
// magnitudes with no exact Float (above 2^53) format on every tier.
use fmt: core.text.fmt

run: fn() {
    values: [9223372036854775807, -9223372036854775807, 9007199254740993, 18446744073709551615]
    loop value in values {
        print("{fmt.bytes(value)} | {fmt.number(value)} | {fmt.ordinal(value)} | {fmt.duration(value)} | {fmt.hex(value, 0)}")
    }
    print(fmt.bytes(1250))
    print(fmt.bytes(9960))
    print(fmt.bytes(999999))
    print(fmt.bytes(-1001))
}
