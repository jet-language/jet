//! An explicit move is never a copy. A value moved with `^` into a struct
//! literal field, a list element, an enum payload, a `shared` cell, a
//! consuming argument, a return, or an assignment keeps its one identity:
//! its Close runs exactly once, when its last owner ends.
Secret: struct {
    id: Int
    token: String
}

impl Secret.Close {
    close: fn(&&self) { print("close {self.id}") }
}

Holder: struct {
    inner: Secret
}

consume: fn(item: &&Secret) { print("consume {item.id}") }

give: fn(item: &&Secret) -> Secret {
    print("give {item.id}")
    return item.move()
}

struct_field: fn() {
    s: Secret{id: 1, token: "owned"}
    held: Holder{inner: s.move()}
    print("struct {held.inner.id}")
}

list_element: fn() {
    s: Secret{id: 2, token: "owned"}
    held: [Secret]{s.move()}
    print("list {held.len()}")
}

enum_payload: fn() {
    s: Secret{id: 3, token: "owned"}
    held: Val(s.move())
    if held == .Val(inner) -> print("option {inner.id}")
}

shared_operand: fn() {
    s: Secret{id: 4, token: "owned"}
    cell: shared Holder{inner: s.move()}
    guard: cell.guard_read()
    print("shared {guard.value.inner.id}")
}

argument: fn() {
    s: Secret{id: 5, token: "owned"}
    consume(s)
    print("argument done")
}

returned: fn() {
    s: Secret{id: 6, token: "owned"}
    back: give(s)
    print("returned {back.id}")
}

assigned: fn() {
    held := Holder{inner: Secret{id: 7, token: "owned"}}
    s: Secret{id: 8, token: "owned"}
    held.inner = s.move()
    print("assigned {held.inner.id}")
}

run: fn() {
    struct_field()
    list_element()
    enum_payload()
    shared_operand()
    argument()
    returned()
    assigned()
}
