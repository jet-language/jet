// #4711: `defer close(log)` moves `log` when the scope exits, not on the
// `defer` line, so the statements after the `defer` still read `log`; the
// deferred close consumes it last.
Log: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("close {self.name}") }
    }
}

run: fn() {
    log: Log{name: "audit"}
    defer close(log)
    print("open {log.name}")
    print("still open {log.name}")
}
