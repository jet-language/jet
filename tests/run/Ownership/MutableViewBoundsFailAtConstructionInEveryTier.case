# The same construction-time Stop is checked on every kit tier; engine-internal interpreter APIs retire.
step: built
exit: 70
stderr: ~ "Stop [E3001]: `panic: can't view 1 items from 2 to 2 (inclusive)`" # the out-of-range mutable view stops when it is built
stderr: ~ "MutableViewBoundsFailAtConstructionInEveryTier.jet:5" # the stop names the construction line of `outside` in Jet terms
