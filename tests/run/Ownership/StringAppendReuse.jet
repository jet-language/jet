// String += and empty assignment preserve caller-buffer contents and aliasing.
Badge: struct {
    name: String
    level: Int
}

shout: fn(out: &String, word: String) {
    out += word
    out += "!"
}

refill: fn(out: &String, count: Int) {
    out = ""
    loop i in 0..<count -> out += "{i}"
}

run: fn() {
    line := ""
    loop i in 0..<4 {
        if i % 2 == 0 -> line += "ab" else -> line += "xyz"
    }
    print(line)
    tail: "-end"
    line += tail
    print(line)
    line += line
    print(line)
    badge := Badge{name: "Ada", level: 3}
    badge.name += " Lovelace"
    print("{badge.name} {badge.level}")
    greeting := "hi"
    shout(greeting, " there")
    print(greeting)
    refill(greeting, 5)
    print(greeting)
    refill(greeting, 3)
    print(greeting)
    badge.name = ""
    badge.name += "Grace"
    print("{badge.name} {badge.level}")
    print(line.len())
}
