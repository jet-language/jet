// A panic inside a registered close, while the body's own Stop is pending,
// is process-fatal: the remaining closes do not run and the report names the
// close's panic.
Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) {
            print("close {self.name}")
            if self.name == "second" {
                panic("close stop")
            }
        }
    }
}

fail: fn() {
    first := Resource{name: "first"}
    defer close(first)
    second := Resource{name: "second"}
    defer close(second)
    print("body")
    panic("stop")
}

run: fn() { fail() }
