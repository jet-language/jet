package: {
    name: "comptime_foreign_branch_not_taken"
    version: "0.1.0"
    authority: { allow: [Exec, FFI, IO, Mem.Alloc] }
}
// A comptime fold reaches an `#FFI(asm)` function only on a branch it never
// takes: the comptime closure skips the inline-foreign body instead of
// type-checking code it can never run, and the runtime call still works.
use core.mem

#[Unsafe("the operands are scalar registers and the early-written r10 clobber does not overlap live inputs"), FFI(asm)]
add_registers: fn(a: Int, b: Int) -> Int {
    """
    mov r10, {a}
    add r10, {b}
    mov {a}, r10 ; -> return
    ; clobbers r10
    """
}

pick: fn(n: Int) -> Int {
    if n > 100 {
        #Unsafe("call the audited register-only assembly contract") {
            return add_registers(n, 1)
        }
    }
    n * 2
}

run: fn() {
    folded: comptime { pick(21) }
    print(folded)
    print(pick(200))
}
