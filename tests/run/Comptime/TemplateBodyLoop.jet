// A `comptime loop` inside a generated method body unrolls once per field:
// `self.#{f}` pastes the field in expression and assignment positions, and
// each unrolled iteration's locals (`value`, `twice`) are its own, so the
// repeated names are not E0118.
Totals: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) -[Meta.Generate]> {
            tname: target.name
            impl #{tname} {
                total: fn(self) -> Int {
                    sum := 0
                    comptime loop f in target.reflect().fields {
                        value: self.#{f}
                        sum += value
                    }
                    sum
                }

                double: fn(&self) {
                    comptime loop f in target.reflect().fields {
                        twice: self.#{f} * 2
                        self.#{f} = twice
                    }
                }
            }
        }
    }
}

#Totals
Point: struct {
    x: Int
    y: Int
}

run: fn() {
    point := Point{x: 1, y: 2}
    print(point.total())
    point.double()
    print(point.total())
}
