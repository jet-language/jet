// A module `Shared` cell: the build stores its literal starting value, no
// code runs before `run`, and every read and write reaches the one cell.
Registry: struct { names: [String] count: Int }

REGISTRY: Shared{Registry{names: [String]{"seed"}, count: 0}}

add: fn(name: String) {
    REGISTRY.names.push(name.copy())
    REGISTRY.count += 1
}

run: fn() {
    print(REGISTRY.count)
    add("a")
    add("b")
    print(REGISTRY.names.join(","))
    print(REGISTRY.count)
}
