// A `Rename(layout: …)` field reports its layout shape name: typed `[.name]`
// selection finds it under that name, and the reflected layout row carries the
// same name, while its byte facts stay those of the declared field.
LayoutName: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            info: target.reflect().layout
            selected: info[.port_slot]
            selected_name: selected.name
            selected_offset: selected.offset
            reflected_name: target.reflect().layout.fields[0].name
            plain_name: target.reflect().layout.fields[1].name
            layout_name: fn(self) -> String Never! { "{selected_name}:{selected_offset}:{reflected_name}:{plain_name}" }
        }
    }
}

#[Layout(c), LayoutName]
Endpoint: struct {
    #Rename(name: "port", layout: "port_slot") port: U32
    host: U8
}

run: fn() {
    endpoint: Endpoint{port: 80, host: 1}
    print(endpoint.layout_name())
}
