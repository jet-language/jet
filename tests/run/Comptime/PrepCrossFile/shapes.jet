// Declarations whose values run.jet prepares while building.
Grid: struct {
    width: Int
    height: Int
}

Corner: enum {
    Origin
    Far(Int)
}

square_grid: fn(side: Int) -> Grid { Grid{width: side, height: side} }

corner_at: fn(distance: Int) -> Corner {
    if distance == 0 -> return Corner.Origin
    Corner.Far(distance)
}
