// A `#run` value may call a function declared in another
// file, through a member import or a qualified name. The callee's body runs
// while building with its own file's names in scope, so it can call a third
// file and build that file's structs and enums. At runtime the constants
// are finished literals.
use {
    "tables"
    "shapes"
    tables.[build_squares]
    shapes.[Grid, Corner]
}

// A member-imported function.
SQUARES: #run build_squares(5)

// A qualified call; the callee calls a third file.
CUBES: #run tables.build_cubes(4)

// A struct and an enum declared in another file.
GRID: #run shapes.square_grid(3)
CORNER: #run shapes.corner_at(7)

area: fn(grid: Grid) -> Int { grid.width * grid.height }

describe: fn(corner: Corner) -> String {
    if corner == {
        .Origin -> "origin"
        .Far(distance) -> "far {distance}"
    }
}

run: fn() {
    print(SQUARES)
    print(CUBES)
    print(area(GRID))
    print(describe(CORNER))
}
