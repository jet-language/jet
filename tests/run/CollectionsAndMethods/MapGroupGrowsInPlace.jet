// A group taken out of a Map with `get ?? <empty List>`, pushed onto and
// stored back grows the entry in place. The result matches the in-place form,
// a copy of the Map made before an update keeps its groups, and a missing key
// starts a new group.
Person: struct {
    name: String
    dept: String
}

run: fn() {
    people: [Person]{Person{name: "ana", dept: "eng"}, Person{name: "bo", dept: "ops"}, Person{name: "cy", dept: "eng"}, Person{name: "di", dept: "eng"}}
    by_dept := [String:[String]]{}
    loop p in people {
        group := by_dept.get(p.dept) ?? [String]{}
        group.push(p.name)
        by_dept[p.dept] = group
    }
    print(by_dept["eng"])
    print(by_dept["ops"])

    people_by_dept := [String:[Person]]{}
    loop p in people {
        group := people_by_dept.get(p.dept) ?? [Person]{}
        group.push(p.copy())
        people_by_dept[p.dept] = group
    }
    print("{people_by_dept["eng"].len()} {people_by_dept["eng"][2].name} {people_by_dept["ops"][0].name}")

    before: by_dept
    loop i in 0..<3 {
        k: "ops"
        name: "n{i}"
        group := by_dept.get(k) ?? [String]{}
        group.push(name)
        by_dept[k] = group
    }
    print(before["ops"])
    print(by_dept["ops"])

    in_place := [Int:[Int]]{}
    taken := [Int:[Int]]{}
    loop i in 0..<1000 {
        key: i % 7
        doubled: i * 2
        if !in_place.has_key(key) -> in_place[key] = [Int]{}
        in_place[key].push(i)
        in_place[key].push(doubled)
        bucket := taken.get(key) ?? [Int]{}
        bucket.push(i)
        bucket.push(doubled)
        taken[key] = bucket
    }
    same := true
    loop key in in_place.keys() {
        if in_place[key] != taken[key] -> same = false
    }
    print("{taken.len()} {taken[3].len()} {taken[3][0]} {taken[3][1]} {same}")
}
