// #4884: a key Stop drops exactly the initialized prefix of owning inline
// keys. Later key callbacks do not run and the receiver is not reordered.
Rows: struct {
    values: [Int]

    impl Close {
        close: fn(&&self) { print("receiver: {self.values}") }
    }
}

OwnedKey: struct {
    rank: Int
    label: String

    impl Close {
        close: fn(&&self) { print("close {self.label}") }
    }
}

key: fn(value: Int, label: String) -> OwnedKey {
    print("key {value} {label}")
    if value == 30 {
        panic("sort key")
    }
    OwnedKey{rank: value, label: "key-{value}"}
}

run: fn() {
    rows := Rows{values: [50, 40, 30, 20, 10]}
    label: "owned key capture {rows.values.len()}"
    rows.values.sort_by((value: Int) -> key(value, label))
    print("unreachable")
}
