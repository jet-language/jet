// The rest of the List surface.
run: fn() {
    xs := [1, 2, 3, 4, 5]
    print(xs.starts_with([1, 2]))
    print(xs.ends_with([4, 5]))
    print(xs.slice(1, 4))
    print(xs.copy().equal(xs))
    print(xs.binary_search(3) ?? -1)
    print(xs.union([4, 5, 6]))
    print(xs.intersection([0, 2, 4]))
    print(xs.difference([2, 4]))
    print(xs.random() ?? -1)
    mm := xs.min_max()
    print(mm?.min ?? -1)
    print(mm?.max ?? -1)

    // The earlier List surface checks.
    ys := [1, 2, 1]
    print((ys.remove(1)) ?? 0)
    print(ys.count(1))
    zs := [1, 2, 1]
    print(zs.replace(1, 9))
    print(zs)
}
