// A comparator Stop precedes payload relocation. The owned closure
// capture and scalar scratch are released before the receiver's scope Close.
Rows: struct {
    values: [Int]

    impl Close {
        close: fn(&&self) { print("receiver: {self.values}") }
    }
}

fail_compare: fn(a: Int, b: Int, label: String) -> Ordering Never! {
    print("compare {label}")
    panic("sort comparator")
}

run: fn() {
    rows := Rows{values: [3, 1, 2]}
    label: "owned comparator capture {rows.values.len()}"
    rows.values.sort_by(fn(a: Int, b: Int) { fail_compare(a, b, label) })
    print("unreachable")
}
