#Error
ClassifyError: enum {
    Bad(String)
}
classify: fn(x: Int) -> Int ClassifyError! {
    if x == 0 {
        return Err(ClassifyError.Bad("bad"))
    }
    return Ok((x + 10))
}
run: fn() {
    classify(5) ? n -> { print(n) } ! e -> { print(e) }
    classify(0) ? n -> { print(n) } ! e -> { print(e) }
}
