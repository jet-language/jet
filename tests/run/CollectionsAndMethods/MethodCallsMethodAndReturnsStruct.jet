Vec2: struct {
    x: Int
    y: Int

    make: fn(x: Int, y: Int) -[]> Vec2 {
        return Vec2{ x: x, y: y }
    }
    sum: fn(self) -[]> Int {
        return (self.x + self.y)
    }
    shifted: fn(self, dx: Int) -[]> Vec2 {
        return Vec2{ x: (self.x + dx), y: self.y }
    }
}
run: fn() {
    p: Vec2.make(3, 4)
    q: p.shifted(10)
    print(q.sum())
}
