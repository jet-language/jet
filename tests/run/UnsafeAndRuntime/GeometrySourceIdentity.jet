// Main's veto-able family identity ruling: golden is UNOBSERVED.
use {
    math: core.math
    reflect: core.reflect
}
screen: fn(value: &&ScreenPoint) -> math.ScreenPoint { value.move() }
world: fn(value: &&WorldPoint) -> math.WorldPoint { value.move() }
view: fn(value: &&ViewPoint) -> math.ViewPoint { value.move() }
camera: fn(value: &&CameraPoint) -> math.CameraPoint { value.move() }
device: fn(value: &&DevicePoint) -> math.DevicePoint { value.move() }
screen_delta: fn(value: &&ScreenDelta) -> math.ScreenDelta { value.move() }
world_delta: fn(value: &&WorldDelta) -> math.WorldDelta { value.move() }
view_delta: fn(value: &&ViewDelta) -> math.ViewDelta { value.move() }
camera_delta: fn(value: &&CameraDelta) -> math.CameraDelta { value.move() }
device_delta: fn(value: &&DeviceDelta) -> math.DeviceDelta { value.move() }
dynamic: fn(value: &&Point2<Float, World>) -> math.Point2<Float, World> { value.move() }
dynamic_delta: fn(value: &&Delta2<Float, World>) -> math.Delta2<Float, World> { value.move() }
error: fn(value: &&TransformError) -> math.TransformError { value.move() }
run: fn() {
    a: ScreenPoint.new(1.0, 2.0)
    b: screen(a.copy())
    print(reflect.of(a).type_name() == reflect.of(b).type_name())
    print("{a}" == ("{b}"))
    assert_eq(world(WorldPoint.new(1.0, 2.0)).x, 1.0)
    assert_eq(view(ViewPoint.new(1.0, 2.0)).y, 2.0)
    assert_eq(camera(CameraPoint.new(1.0, 2.0)).x, 1.0)
    assert_eq(device(DevicePoint.new(1.0, 2.0)).y, 2.0)
    assert_eq(screen_delta(ScreenDelta.new(1.0, 2.0)).x, 1.0)
    assert_eq(world_delta(WorldDelta.new(1.0, 2.0)).y, 2.0)
    assert_eq(view_delta(ViewDelta.new(1.0, 2.0)).x, 1.0)
    assert_eq(camera_delta(CameraDelta.new(1.0, 2.0)).y, 2.0)
    assert_eq(device_delta(DeviceDelta.new(1.0, 2.0)).x, 1.0)
    p: dynamic(Point2<Float, World>.new(1.0, 2.0, 11))
    d: dynamic_delta(Delta2<Float, World>.new(3.0, 4.0, 11))
    print((p + d ?? panic("dynamic arithmetic")).frame_id)
    assert_eq(error(TransformError{message: "frame"}).message, "frame")
}
