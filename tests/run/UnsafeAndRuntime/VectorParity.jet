// Vec2, Vec3 and Vec4 share one surface: scaling by a Float on either side,
// display, and length_sq, distance and distance_sq.
use math: core.math

run: fn() {
    a: math.Vec2.new(3.0, 4.0)
    print(a)  // Vec2 { lanes: [3.0, 4.0] }
    print((a * 2.0).to_array())  // [6, 8]
    print((2.0 * a).to_array())  // [6, 8]
    print((a / 2.0).to_array())  // [1.5, 2]
    print((12.0 / a).to_array())  // [4, 3]
    print(a.length_sq())  // 25
    print(a.distance(math.Vec2.new(0.0, 0.0)))  // 5
    print(a.distance_sq(math.Vec2.new(1.0, 1.0)))  // 4 + 9 = 13
    b: math.Vec3.new(1.0, 2.0, 2.0)
    print(b)  // Vec3 { lanes: [1.0, 2.0, 2.0] }
    print((b * 2.0).to_array())  // [2, 4, 4]
    print(b.length_sq())  // 9
    print(b.distance(math.Vec3.new(0.0, 0.0, 0.0)))  // 3
    print(b.distance_sq(math.Vec3.new(1.0, 1.0, 1.0)))  // 0 + 1 + 1 = 2
    c: math.Vec4.new(1.0, 2.0, 3.0, 4.0)
    print(c)  // Vec4 { lanes: [1.0, 2.0, 3.0, 4.0] }
    print((c * 2.0).to_array())  // [2, 4, 6, 8]
    print((2.0 * c).to_array())  // [2, 4, 6, 8]
    print((c / 2.0).to_array())  // [0.5, 1, 1.5, 2]
    print((12.0 / c).to_array())  // [12, 6, 4, 3]
    print(c.length_sq())  // 30
    print(c.distance(math.Vec4.new(1.0, 2.0, 3.0, 0.0)))  // 4
    print(c.distance_sq(math.Vec4.splat(1.0)))  // 0 + 1 + 4 + 9 = 14
}
