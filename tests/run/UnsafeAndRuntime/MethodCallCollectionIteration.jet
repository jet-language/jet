count_chars: fn(s: String) -> Int {
    n := 0
    loop c in s.chars() {
        n+= 1
    }
    return n
}
join_words: fn(s: String) -> String {
    out := ""
    loop w in s.split(",") {
        out = "{out}[{w}]"
    }
    return out
}
run: fn() {
    print(count_chars("hello"))
    print(join_words("a,b,c"))
}
