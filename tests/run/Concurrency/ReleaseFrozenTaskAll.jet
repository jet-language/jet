package: {
    name: "release_frozen_task_all"
    authority: { allow: [IO, Mem.Alloc, Time.Wait] }
}

Snapshot: struct {
    value: Int
}

get: fn(s: Snapshot) -> Int { s.value }

run: fn() {
    source := Snapshot{value: 41}
    frozen: freeze(source)
    values: task.all {get(frozen), get(frozen)} ?? panic("task.all failed")
    print(values[0], values[1])
}
