// Exact Int products at every operand shape the runtime multiplies
// (Int.jet jet_int_mul): inline by inline past the inline range, inline by
// boxed, boxed by inline and boxed by boxed, with one to eight base-1e9
// limbs, both signs, zero limbs inside and top limbs of 1 and 999999999.
// Each product divides back exactly, commutes, associates and distributes;
// the digest and the sample products pin the answers themselves.
LIMB: 1000000000

number: fn(top: Int, fill: Int, length: Int, negative: Bool) -> Int {
    value := top
    loop i in 1..<length -> value = value * LIMB + (if i % 3 == 0 -> 0 else -> (fill + i * 7919) % LIMB)
    if negative -> -value else -> value
}

run: fn() {
    tops: [Int]{1, 2, 999999999, 123456789}
    fills: [Int]{0, 999999999}
    values := [Int]{3, -7, 4611686018427387903, -4611686018427387904}
    loop length in 1..<9 {
        loop top in tops {
            loop fill in fills {
                values.push(number(top, fill, length, (length + top + fill) % 2 == 1))
            }
        }
    }
    checked := 0
    wrong := 0
    digest := 0
    loop a in values {
        loop b in values {
            p: a * b
            if p /% b != a || p % b != 0 || p != b * a || (p * 3) * b != a * ((b * 3) * b) || a * (b + 5) != p + a * 5 {
                wrong += 1
                if wrong <= 5 -> print("wrong: {a} * {b} gave {p}")
            }
            digest = (digest * 31 + p % 1000003) % 4294967291
            checked += 1
        }
    }
    print("{checked} products, {wrong} wrong, digest {digest}")
    print(values[2] * values[2])
    print(values[3] * values[2])
    print(number(999999999, 999999999, 8, false) * number(999999999, 999999999, 5, true))
    print(number(1, 0, 7, false) * 999999999)
    print(-1000000000 * number(2, 0, 4, false))
    two := 1
    loop _ in 0..<1074 -> two = two * 2
    print(two)
}
