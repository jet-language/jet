
present: fn() -> String { Ok("ok") }
note_value: fn() -[IO]> String {
    print("evaluated")
    return "unexpected"
}
wrapped: fn() -[IO]> String {
    value: present()?("never {note_value()}")
    return Ok(value)
}
run: fn() {
    if wrapped() == {
        .Ok(value) -> { print(value) }
        .Err(_) -> { print("failed") }
    }
}
