fn count_chars(s: String) -> Int {
    n := 0
    loop c in s.chars() {
        n+= 1
    }
    return n
}
fn join_words(s: String) -> String {
    out := ""
    loop w in s.split(",") {
        out = "{out}[{w}]"
    }
    return out
}
fn run() {
    print(count_chars("hello"))
    print(join_words("a,b,c"))
}
