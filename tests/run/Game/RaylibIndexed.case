# Each presented frame overwrites JET_RAYLIB_CAPTURE, so the file holds the
# last of the 35 replayed frames; every tier must produce the same bytes.
env: JET_RAYLIB_CAPTURE={work}/frame.pam
step: built
stdout: = RaylibIndexed.out
file: frame.pam sha256 = "bbb451a3cfc9ac9effea806fd65029a026256066d8a81697c2dd3572b85e1eb9"
