use {
    fs: core.files
    game: core.game
    rt: core.rt
    ui: core.ui
    core.color.[Color]
    core.term.[Key]
    games
}

Position: struct {
    x: Int
}

Velocity: struct {
    dx: Int
}

// Resolve the fixture root for both a repository checkout and an installed
// package. The asset itself remains a real file; this only chooses its root.
battery_root: fn() -> String {
    candidates: [String]{
        "tests/run/Game/Battery",
        "battery",
        ".",
    }
    loop candidate in candidates {
        if fs.exists("{candidate}/assets/player.atlas") -> return candidate
    }
    return "."
}

// One frame: the sprite, text and shape draws and every input query. The
// script holds no events, so every key and button is up, none was pressed
// or released, and the pointer has not moved from (0, 0).
draw_frame: fn(frame: ui.Frame, atlas: ui.TextureAtlas) -> String {
    frame.clear_background(Color{r: 20, g: 24, b: 32, a: 255})
    frame.draw_sprite(atlas, "hero", 100, 40)
    frame.draw_rectangle(100, 40, 16, 16, Color{r: 245, g: 245, b: 245, a: 255})
    frame.draw_line(0, 239, 319, 239, Color{r: 232, g: 35, b: 42, a: 255})
    frame.draw_circle(160, 120, 6, Color{r: 255, g: 59, b: 65, a: 255})
    frame.draw_triangle(10, 200, 30, 200, 20, 180, Color{r: 11, g: 11, b: 13, a: 255})
    frame.draw_text("Jet games", 8, 8, 16, Color{r: 255, g: 220, b: 120, a: 255})
    space: Key.Char(' ')
    down: frame.is_key_down(space)
    up: frame.is_key_up(space)
    pressed: frame.is_key_pressed(space)
    released: frame.is_key_released(space)
    button_down: frame.is_mouse_button_down(.Left)
    button_up: frame.is_mouse_button_up(.Left)
    clicked: frame.is_mouse_button_pressed(.Left)
    let_go: frame.is_mouse_button_released(.Left)
    x: frame.get_mouse_x()
    y: frame.get_mouse_y()
    at_origin: frame.get_mouse_position() == ui.point(0.0, 0.0)
    "keyboard:{down}/{up}/{pressed}/{released} mouse:{button_down}/{button_up}/{clicked}/{let_go} at:{x},{y} origin:{at_origin}"
}

run: fn() {
    root: battery_root()
    atlas_path: "{root}/assets/player.atlas"
    sound_path: "{root}/assets/jump.wav"
    replay_path: "{root}/runs/demo.jetreplay"

    scene := game.Scene.new("games_battery")
    image: scene.assets.image(atlas_path) ?? panic("image fixture")
    sound: scene.assets.sound(sound_path) ?? panic("sound fixture")
    scene.input.bind("jump", "Space")
    scene.input.bind("move_left", "Left")
    scene.component<Position>()
    scene.component<Velocity>()
    rows: scene.query<Position, Velocity>()
    print("query={rows.len()} row={rows[0]}")
    scene.on_frame(
    fn(frame) {
        if frame.input.pressed("jump") -> print("scene_input={frame.index}")
    },
    )

    nodes: [games.SceneNode]{
        {parent: -1, local: games.Transform{x: 100, y: 40}},
        {parent: 0, local: games.Transform{x: 20, y: 5}},
    }
    child: games.world_transform(nodes, 1)
    print("scene_child_world={child.x},{child.y}")

    player: games.AABB{x: 18, y: 20, w: 8, h: 8}
    wall: games.AABB{x: 20, y: 20, w: 8, h: 8}
    hit_count := 0
    if games.aabb_overlaps(player, wall) -> hit_count += 1
    print("aabb_hits={hit_count}")

    accumulator := games.accumulator_new(16)
    loop frame in 0..<8 {
        accumulator = games.accumulator_advance(accumulator, 17)
        alpha: games.accumulator_alpha_thousand(accumulator)
        render_tick: games.interpolate(accumulator.previous_tick, accumulator.current_tick, alpha)
        print("frame={frame} fixed_tick={accumulator.current_tick} render_tick={render_tick}")
    }

    window: ui.headless(width: 320, height: 240, script: [[ui.UIEvent]]{[ui.UIEvent]{}}) ?? panic("a 320x240 window")
    atlas: ui.load_texture_atlas(atlas_path)
    input := ""
    loop frame in window.frames() {
        if frame.index > 0 -> break
        input = draw_frame(frame, atlas)
    }
    print("window=headless frames={window.checksums().len()}")
    print("input_matrix={input}")
    print("atlas={atlas.name()} loaded:{atlas.loaded()}")

    replay: game.Replay.record(replay_path)
    transcript: game.run(scene, replay: replay, frames: 600)
    // Paths print relative to the fixture root, so the output is the same
    // from a repository checkout and from the package directory.
    shown_root: "{root}/"
    print(transcript.replace(shown_root, ""))

    state: games.SaveState{x: accumulator.current_tick, paused: false}
    paused_state: games.pause_toggle(state)
    encoded: games.save_encode(paused_state)
    save_dir: fs.temp_dir("games-battery-save") ?? panic("save temp dir")
    save_path: "{save_dir.path}/save.txt"
    fs.write(save_path, encoded) ?? panic("save write")
    restored_raw: fs.read(save_path) ?? panic("save read")
    restored: games.save_decode(restored_raw)
    fs.remove(save_path) ?? panic("save remove")
    print("save_round_trip=x:{restored.x} paused:{restored.paused}")

    // `core.rt` owns callback scheduling and stream cancellation. The lambda
    // only consumes its reusable block, with no allocation, wait, or I/O.
    stream := rt.callback(
    48000,
    256,
    fn(samples) {
        total := Float{0.0}
        loop sample in samples -> total += sample
    },
    )
    stream.next_deadline().drop("the stream is armed; this run does not schedule against its first deadline")
    stream.cancel()
    receipt: stream.receipt()
    // Callback and miss counts are host timing observations; the golden
    // prints the requested shape and the joined worker only.
    print("audio_callback=cancelled rate:{receipt.requested_rate_hz} frames:{receipt.requested_frames} cancelled:{stream.is_cancelled()} joined:{receipt.end_identity > 0}")
    print("music_stream=unavailable")
    image_text: "{image:Debug}".replace(shown_root, "")
    sound_text: "{sound:Debug}".replace(shown_root, "")
    print("scene_image={image_text} scene_sound={sound_text}")
}
