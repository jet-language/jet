Sink: trait {
    absorb: fn(self, value: Float) -> Float
}
Holder: struct {
    offset: Float

    impl Sink {
        absorb: fn(self, value: Float) -[]> Float {
            return value + self.offset
        }
    }
}
run: fn() {
    holder: Holder{ offset: 1.0 }
    sinks: [Sink]{ holder }
    print(sinks.len())
}
