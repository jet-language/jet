
RecordKey: struct { value: U64 }
Snapshot: struct { fields: [String], type_id: RecordKey, type_name: String }
run: fn() {
    snapshot := Snapshot{fields: [String]{"field"}, type_id: RecordKey{value: U64{7}}, type_name: "record"}
    fields := ^snapshot.fields
    id := ^snapshot.type_id
    name := ^snapshot.type_name
    print(fields.len())
    print(id.value)
    print(name)
}
