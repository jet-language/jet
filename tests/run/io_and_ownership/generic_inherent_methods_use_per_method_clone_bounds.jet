
Measure: trait {
    measure: fn(self) -> Int
}

Holder: struct<T> {
    reader: fn(T) -> Int

    inspect: fn(self) -[]> Int {
        return 1
    }

    copy_tagged: fn(self, value: #Input T) -[]> #Input T {
        return value.copy()
    }
}

increment: fn(value: Int) -[]> Int { return value + 1 }
read_callback: fn(value: fn(Int) -> Int) -[]> Int { return 1 }
read_measure: fn(value: Measure) -[]> Int { return 2 }
read_string: fn(value: String) -[]> Int { return value.len() }

run: fn() {
    callbacks: Holder<fn(Int) -> Int>{reader: read_callback}
    measures: Holder<Measure>{reader: read_measure}
    strings: Holder<String>{reader: read_string}
    print(callbacks.inspect())
    print(measures.inspect())
    copied: strings.copy_tagged(#Input "copy")
    print(3)
}
