// D-IMPLDOT1: in an `impl` head, a module alias binds to the segment
// after it. `impl Local.inner.Shout` implements `inner.Shout` for `Local`;
// before, the parser read type `Local.inner` and trait `Shout`, and the impl
// failed E0902. A module-qualified type keeps its trait
// (`impl inner.Loud.Mine`), and both alias segments may appear
// (`impl inner.Loud.inner.Shout`).
inner: module {
    Shout: trait {
        shout: fn(self) -> String
    }

    Loud: struct {
        level: Int
    }

    announce: fn<S: Shout>(value: S) -> String { value.shout() }
}

Mine: trait {
    mine: fn(self) -> Int
}

Local: struct {
    n: Int

    impl inner.Shout {
        shout: fn(self) -> String { "LOCAL {self.n}" }
    }
}

impl inner.Loud.Mine {
    mine: fn(self) -> Int { self.level * 10 }
}

impl inner.Loud.inner.Shout {
    shout: fn(self) -> String { "LOUD {self.level}" }
}

run: fn() {
    print(Local{n: 1}.shout())
    print(inner.Loud{level: 2}.mine())
    print(inner.announce(inner.Loud{level: 3}))
    print(inner.announce(Local{n: 4}))
}
