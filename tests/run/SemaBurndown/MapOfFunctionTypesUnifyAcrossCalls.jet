// #4314: two spellings of the same map-of-function type are one type: a
// literal, a parameter, a return type and a stored field all unify.
double: fn(n: Int) -> Int { n * 2 }

square: fn(n: Int) -> Int { n * n }

Table: struct {
    ops: [String:fn(Int) -> Int]
}

build: fn() -> [String:fn(Int) -> Int] {
    [String:fn(Int) -> Int]{"double": double, "square": square}
}

has: fn(ops: [String:fn(Int) -> Int], name: String) -> Bool {
    if ops.get(name) == { .Val(_) -> true else -> false }
}

run: fn() {
    ops: [String:fn(Int) -> Int]{"double": double, "square": square}
    print(has(ops, "double"))
    print(has(build(), "cube"))
    table: Table{ops: build()}
    print(has(table.ops, "square"))
    f: ops.get("square") ?? return
    print(f(5))
}
