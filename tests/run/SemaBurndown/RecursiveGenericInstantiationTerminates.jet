// #4390: generic instantiation terminates when a generic type reaches itself
// through a map of a generic value (the QueryEngine<T> unit, the GC port's
// GCState<O>) or through its own field (Tree<T>). Each instance is keyed by
// its type identity, so a cycle reuses the instance already in flight.
Subject: struct {
    name: String
}

Key: struct {
    subject: Subject
    rev: Int
}

Memo: struct<T> {
    value: T
    deps: [Key]
    rev: Int
}

QueryEngine: struct<T> {
    memos: [Key: Memo<T>]
    revision: Int

    new: fn() -> QueryEngine<T> { QueryEngine<T>{memos: [Key: Memo<T>]{}, revision: 0} }

    put: fn(&self, key: Key, value: T, deps: [Key]) {
        self.memos[key] = Memo<T>{value: value, deps: deps, rev: self.revision}
    }

    memo_key_valid: fn(self, key: Key, depth: Int) -> Bool {
        if depth > 8 -> return false
        entry: self.memos.get(key) ?? return false
        self.memo_entry_valid(entry, depth + 1)
    }

    memo_entry_valid: fn(self, entry: Memo<T>, depth: Int) -> Bool {
        loop dep in entry.deps {
            if !self.memo_key_valid(dep, depth) -> return false
        }
        entry.rev <= self.revision
    }

    size: fn(self) -> Int { self.memos.len() }
}

GCEntry: struct<O> {
    object: O
    marked: Bool
}

GCState: struct<O> {
    entries: [U64: GCEntry<O>]

    new: fn() -> GCState<O> { GCState<O>{entries: [U64: GCEntry<O>]{}} }

    insert: fn(&self, id: U64, object: O) { self.entries[id] = GCEntry<O>{object: object, marked: false} }

    count: fn(self) -> Int { self.entries.len() }
}

GCTestObject: struct {
    n: Int
}

Tree: struct<T> {
    value: T
    children: [Tree<T>]

    count: fn(self) -> Int {
        total := 1
        loop child in self.children {
            total += child.count()
        }
        total
    }
}

depth: fn<T>(tree: Tree<T>) -> Int {
    best := 0
    loop child in tree.children {
        d: depth<T>(child)
        if d > best -> best = d
    }
    best + 1
}

key: fn(name: String, rev: Int) -> Key { Key{subject: Subject{name: name}, rev: rev} }

run: fn() {
    empty: QueryEngine<Int>.new()
    print(empty.size())
    engine := QueryEngine<String>.new()
    engine.put(key("a", 1), "A", [Key]{})
    engine.put(key("b", 1), "B", [Key]{key("a", 1)})
    print(engine.size())
    print(engine.memo_key_valid(key("b", 1), 0))
    print(engine.memo_key_valid(key("c", 1), 0))
    state := GCState<GCTestObject>.new()
    state.insert(U64{1}, GCTestObject{n: 3})
    state.insert(U64{2}, GCTestObject{n: 4})
    print(state.count())
    leaf: Tree<String>{value: "b", children: [Tree<String>]{}}
    middle: Tree<String>{value: "m", children: [Tree<String>]{leaf}}
    root: Tree<String>{value: "a", children: [Tree<String>]{middle, leaf.copy()}}
    print(root.count())
    print(depth(root))
}
