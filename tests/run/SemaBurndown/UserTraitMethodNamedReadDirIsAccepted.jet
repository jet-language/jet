// #4430: the retired raw `read_dir` refusal applies only to the Core target;
// a user trait or struct method of that name is an ordinary method.
Lister: trait {
    read_dir: fn(self, path: String) -> [String]
}

Fake: struct {
    root: String

    impl Lister {
        read_dir: fn(self, path: String) -> [String] {
            [String]{self.root, path}
        }
    }
}

Plain: struct {
    count: Int

    read_dir: fn(self) -> Int { self.count }
}

list_all: fn(host: Fake) -> Int {
    host.read_dir("x").len()
}

run: fn() {
    f: Fake{ root: "r" }
    print(list_all(f))
    print(f.read_dir("y")[1])
    print(Plain{ count: 4 }.read_dir())
}
