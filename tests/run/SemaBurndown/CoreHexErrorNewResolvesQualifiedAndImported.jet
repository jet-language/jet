// Core's public associated function HexError.new is reachable through
// the module (`hex.HexError.new`) and through an imported name; the imported
// name is core.encoding.hex's alias of core.encoding.HexError.
use {
    hex: core.encoding.hex
    core.encoding.hex.[HexError]
}

run: fn() {
    qualified: hex.HexError.new("qualified") ?? return
    imported: HexError.new("imported") ?? return
    print(qualified.reason)
    print(imported.reason)
    if hex.decode("zz") == {
        .Ok(_) -> print("accepted")
        .Err(error) -> print(error.reason == HexError.new(error.reason).reason)
    }
}
