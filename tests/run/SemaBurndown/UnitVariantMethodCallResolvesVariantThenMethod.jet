// #4322: `Role.Root.label()` names the variant `Role.Root`, then calls its
// method; it is not a variant path `Root.label`.
Role: enum {
    Root
    Guest(name: String)

    label: fn(self) -> String {
        if self == {
            .Root -> "root"
            .Guest(name) -> "guest {name}"
        }
    }
}

run: fn() {
    print(Role.Root.label())
    print(Role.Guest{ name: "ada" }.label())
    print(Role.Root.label().len())
}
