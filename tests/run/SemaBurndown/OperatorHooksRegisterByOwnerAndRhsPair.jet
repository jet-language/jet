// An operator hook registers under its owner and right-hand type, so
// one owner carries `Add` for itself and `Add(Int)` side by side, and each
// call site dispatches by the operand pair (the duplicate-pair refusal is
// tests/ui/operator_duplicate_hook.jet).
Ratio: struct {
    num: Int
    den: Int

    impl Add {
        add: fn(self, rhs: Ratio) -> Ratio { return Ratio{num: self.num * rhs.den + rhs.num * self.den, den: self.den * rhs.den} }
    }

    impl Add(Int) #Commutative {
        add: fn(self, rhs: Int) -> Ratio { return Ratio{num: self.num + rhs * self.den, den: self.den} }
    }

    impl Mul {
        mul: fn(self, rhs: Ratio) -> Ratio { return Ratio{num: self.num * rhs.num, den: self.den * rhs.den} }
    }

    impl Mul(Int) {
        mul: fn(self, rhs: Int) -> Ratio { return Ratio{num: self.num * rhs, den: self.den} }
    }
}

show: fn(r: Ratio) -> String {
    "{r.num}/{r.den}"
}

run: fn() {
    half: Ratio{num: 1, den: 2}
    third: Ratio{num: 1, den: 3}
    print(show(half + third))
    print(show(half + 1))
    print(show(2 + third))
    print(show(half * third))
    print(show(third * 4))
}
