// #4433: a method's own type parameter is in scope in its signature and in
// its body, as a free function's is.
Box: struct {
    n: Int

    apply: fn<U>(self, f: fn(Int) -> U) -> U {
        held: [U]{f(self.n)}
        return held[0]
    }

    pair: fn<A, B>(self, first: A, second: B) -> [B] {
        firsts: [A]{first}
        out: [B]{second}
        print("{firsts.len()} {self.n}")
        return out
    }
}

run: fn() {
    b: Box{ n: 3 }
    print(b.apply(fn(x: Int) { x * 2 }))
    print(b.apply(fn(x: Int) { "n={x}" }))
    print(b.pair("label", 4.5).len())
}
