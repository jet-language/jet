// A generic module specialized by a provider type keeps its type
// parameters and bounds (`N: Native`), and the file names the instance's
// members through the instance alias: in a struct field, in an impl head that
// implements a file trait for an instance type (`impl seam_m8.Handle.Labelled`),
// and in an impl head that implements an instance trait for a file type
// (`impl Provider.gc_m8.Native`, D-IMPLDOT1). A bound inside an instance or an
// inline module names that module's own trait (`<W: Native>`).
Native: trait {
    strong_count: fn(self) -> Int
}

Labelled: trait {
    label: fn(self) -> String
}

Provider: struct {
    count: Int

    impl Native {
        strong_count: fn(self) -> Int { self.count }
    }
}

seam: module<N: Native> {
    Handle: struct {
        native: N
    }

    impl Handle.Native {
        strong_count: fn(self) -> Int { self.native.strong_count() * 10 }
    }

    strong_count: fn(value: N) -> Int { value.strong_count() }

    bounded: fn<M: Native>(value: M) -> Int { value.strong_count() + 1 }

    via_bound: fn(value: N) -> Int { bounded(value) + bounded(Handle{native: value}) }
}

seam_m8: seam<Provider>

seam_alias: seam_m8

Outer: struct {
    inner: seam_m8.Handle
    others: [seam_alias.Handle]

    impl gc_m8.Native {
        strong_count: fn(self) -> Int { self.inner.strong_count() + self.others.len() }
    }
}

impl seam_m8.Handle.Labelled {
    label: fn(self) -> String { "handle {self.native.strong_count()}" }
}

gc: module<O>(scale: Int) {
    Native: trait {
        strong_count: fn(self) -> Int
    }

    weighted: fn<W: Native>(value: W) -> Int { value.strong_count() * scale }

    count_of: fn(values: [O]) -> Int { values.len() }
}

gc_m8: gc<Provider>(3)

plain: module {
    Native: trait {
        strong_count: fn(self) -> Int
    }

    Box: struct {
        count: Int
    }

    impl Box.Native {
        strong_count: fn(self) -> Int { self.count }
    }

    doubled: fn<N: Native>(value: N) -> Int { value.strong_count() * 2 }
}

run: fn() {
    p: Provider{count: 3}
    print(seam_m8.strong_count(p))
    print(seam_m8.via_bound(Provider{count: 4}))
    h: seam_m8.Handle{native: Provider{count: 5}}
    print(h.label())
    outer: Outer{inner: h, others: [seam_alias.Handle]{seam_alias.Handle{native: Provider{count: 6}}}}
    print(outer.inner.strong_count())
    print(gc_m8.weighted(outer))
    print(plain.doubled(plain.Box{count: 8}))
    print(gc_m8.count_of([Provider]{p, Provider{count: 7}}))
}
