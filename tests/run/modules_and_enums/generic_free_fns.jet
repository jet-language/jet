fn id<T>(x: ^T) -> T {
    return x
}
fn pick<T>(a: ^T, b: ^T, first: Bool) -> T {
    if first {
        return a
    }
    return b
}
fn firstof<T>(xs: ^[T]) -> T {
    return xs[0].copy()
}
fn wrap<T>(x: ^T) -> [T] {
    return [x]
}
fn run() {
    print("{id(5)}")
    print("{pick(1, 2, true)}")
    print("{firstof([10, 20, 30])}")
    ys :: wrap(7)
    print("{ys[0]}")
}
