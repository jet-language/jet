enum Tree {
    Leaf(Int)
    Node(Tree)
}
fn wrap(inner: Tree) -> Tree {
    return Tree.Node(inner.copy())
}
fn leaf_val(t: Tree) -> Int {
    if t == {
        .Leaf(n) -> { return n }
        .Node(inner) -> { return 0 }
    }
    return 0
}
fn run() {
    a :: Tree.Leaf(7)
    b :: wrap(a)
    print("{leaf_val(b)}")
}
