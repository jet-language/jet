Tree: enum {
    Leaf(Int)
    Node(Tree)
}
wrap: fn(inner: Tree) -> Tree {
    return Tree.Node(inner.copy())
}
leaf_val: fn(t: Tree) -> Int {
    if t == {
        .Leaf(n) -> { return n }
        .Node(inner) -> { return 0 }
    }
    return 0
}
run: fn() {
    a: Tree.Leaf(7)
    b: wrap(a)
    print("{leaf_val(b)}")
}
