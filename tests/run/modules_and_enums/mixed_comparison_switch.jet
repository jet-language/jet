grade: fn(score: Int) -> String {
    if score == {
        100 -> { return "A+" }
        90..99 -> { return "A" }
        80..89 -> { return "B" }
        else -> { return "F" }
    }
    return "?"
}
run: fn() {
    print(grade(85))
    print(grade(95))
    print(grade(100))
    print(grade(50))
}
