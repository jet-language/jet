Speaker: trait {
    say: fn(self, msg: String) -> String
}
Voice: struct {
    prefix: String
}
impl Voice.Speaker {
    say: fn(self, msg: String) -> String {
        p: self.prefix
        return "{p}: {msg}"
    }
}
Megaphone: struct {
    inner: Voice
}
impl Megaphone.Speaker using inner
run: fn() {
    v := Voice{ prefix: "HEY" }
    m := Megaphone{ inner: v }
    print(m.say("go"))
}
