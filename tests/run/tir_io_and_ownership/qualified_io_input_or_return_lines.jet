use core.term as io
fn collect() -[IO]> [String] {
    out := [String]{}
    loop true {
        line :: io.input("> ") ?? return out.copy()
        if line == "" {
            break
        }
        &out.push(line)
    }
    return out
}
fn run() {
    got :: collect()
    print("count={got.len()}")
    loop g in got {
        print(g)
    }
    print("done")
}
