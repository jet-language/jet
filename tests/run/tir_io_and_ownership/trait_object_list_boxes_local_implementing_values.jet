trait Sink {
    fn absorb(self, value: Float) -> Float
}
struct Holder {
    offset: Float

    impl Sink {
        fn absorb(self, value: Float) -[]> Float {
            return value + self.offset
        }
    }
}
fn run() {
    holder :: Holder{ offset: 1.0 }
    sinks :: [Sink]{ holder }
    print(sinks.len())
}
