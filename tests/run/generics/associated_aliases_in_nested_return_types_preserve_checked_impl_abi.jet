
Indexed: trait {
    Elem: type
    at: fn(self, i: Int) -> Elem?
    count: fn(self) -> Elem
}
Nums: struct {
    values: [Int]
    impl Indexed {
        Elem: Int
        at: fn(self, i: Int) -> Int? { Val(self.values[i]) }
        count: fn(self) -> Int { self.values.len() }
    }
}
run: fn() {
    nums: Nums{values: [10, 20]}
    print(nums.at(1) ?? -1)
    print(nums.count() ?? -1)
}
