// A constant divisor's remainder multiplies the quotient back by the divisor:
// as an immediate when the divisor fits 32 bits, else from a register. Each of
// `/%`, `%` and `%%` by negative divisors and by divisors at both edges of the
// 32-bit immediate range must agree with the same division by a divisor known
// only at run time, for Int and for I64.
by_constants: fn(n: Int) -> [Int] {
    [Int]{
        n /% -3, n % -3, n %% -3,
        n /% -641, n % -641, n %% -641,
        n /% 2147483647, n % 2147483647, n %% 2147483647,
        n /% 2147483648, n % 2147483648, n %% 2147483648,
        n /% -2147483648, n % -2147483648, n %% -2147483648,
        n /% -2147483649, n % -2147483649, n %% -2147483649,
        n /% -2305843009213693953, n % -2305843009213693953, n %% -2305843009213693953,
    }
}

words_by_constants: fn(n: I64) -> [I64] {
    [I64]{
        n /% I64{-7}, n % I64{-7}, n %% I64{-7},
        n /% I64{2147483647}, n % I64{2147483647}, n %% I64{2147483647},
        n /% I64{2147483648}, n % I64{2147483648}, n %% I64{2147483648},
        n /% I64{-2147483649}, n % I64{-2147483649}, n %% I64{-2147483649},
    }
}

by_values: fn(n: Int, divisors: [Int]) -> [Int] {
    out := [Int]{}
    loop d in divisors {
        out.push(n /% d)
        out.push(n % d)
        out.push(n %% d)
    }
    out
}

words_by_values: fn(n: I64, divisors: [I64]) -> [I64] {
    out := [I64]{}
    loop d in divisors {
        out.push(n /% d)
        out.push(n % d)
        out.push(n %% d)
    }
    out
}

run: fn() {
    divisors: [Int]{-3, -641, 2147483647, 2147483648, -2147483648, -2147483649, -2305843009213693953}
    word_divisors: [I64]{I64{-7}, I64{2147483647}, I64{2147483648}, I64{-2147483649}}
    inputs := [Int]{0, 1, -1, 2147483647, -2147483647, 2147483648, -2147483648, 4294967296, -4294967297, 4611686018427387903, -4611686018427387904, 9223372036854775807, -9223372036854775808}
    n := -1000
    loop n <= 1000 {
        inputs.push(n * 2147483659)
        n += 1
    }
    mismatches := 0
    word_mismatches := 0
    loop value in inputs {
        if by_constants(value) != by_values(value, divisors) -> mismatches += 1
        word: I64{value}
        if words_by_constants(word) != words_by_values(word, word_divisors) -> word_mismatches += 1
    }
    print(inputs.len())
    print(mismatches)
    print(word_mismatches)
    print(by_constants(-7)[0..<3])
    print(by_constants(-4294967297)[9..<12])
    print(by_constants(9223372036854775807)[15..<18])
    print(words_by_constants(I64{-9223372036854775807})[0..<3])
}
