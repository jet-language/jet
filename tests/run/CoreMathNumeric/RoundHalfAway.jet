// nearest-integer ties go away from zero.
use math: core.math

run: fn() {
    neg_two_half: math.round(Float{-2.5})
    neg_one_half: math.round(Float{-1.5})
    neg_zero_half: math.round(Float{-0.5})
    pos_zero_half: math.round(Float{0.5})
    pos_one_half: math.round(Float{1.5})
    pos_two_half: math.round(Float{2.5})
    print("neg-2.5={neg_two_half}")
    print("neg-1.5={neg_one_half}")
    print("neg-0.5={neg_zero_half}")
    print("pos-0.5={pos_zero_half}")
    print("pos-1.5={pos_one_half}")
    print("pos-2.5={pos_two_half}")
}
