// A derive and a marker template read an enum's cases from `cases`. The
// built-in Equatable and Comparable derives match every case, a grouped one
// and a named payload included; a user marker unrolls one arm per case and
// reads each case's index and payload fields; and a marker on a case,
// grouped or not, reads that case's CaseInfo.
CaseIndex: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            tname: target.name
            impl #{tname} {
                case_index: fn(self) -> Int {
                    at := -1
                    #loop case in target.reflect().cases {
                        if self == {
                            .#{case} -> { at = case.index }
                            else -> {}
                        }
                    }
                    at
                }

                payload_count: fn(self) -> Int {
                    count := 0
                    #loop case in target.reflect().cases {
                        if self == {
                            .#{case} -> {
                                #loop field in case.reflect().fields {
                                    count += 1
                                }
                            }
                            else -> {}
                        }
                    }
                    count
                }
            }
        }
    }
}

CaseNote: struct {
    label: String

    impl Marker {
        sites: [.Variant]

        expand: fn(self, target: Target) {
            made: "note_{self.label}"
            seen: "{target.name} is case {target.index}"
            impl Notes {
                #{made}: fn() -> String { #{seen} }
            }
        }
    }
}

Notes: struct {}

#[Equatable, Comparable, CaseIndex]
Signal: enum {
    Quit
    #CaseNote("move") Move(Int)
    Paint {
        Fill(Int)
        #CaseNote("stroke") Stroke(width: Int, style: Int)
    }
}

run: fn() {
    signals: [Signal]{Signal.Quit, Signal.Move(3), Signal.Paint.Fill(7), Signal.Paint.Stroke{width: 2, style: 1}}
    loop signal in signals {
        print("case {signal.case_index()} with {signal.payload_count()} payload fields")
    }
    print(Signal.Move(3) == Signal.Move(3))
    print(Signal.Move(3) == Signal.Move(4))
    print(Signal.Paint.Stroke{width: 2, style: 1} == Signal.Paint.Stroke{width: 2, style: 1})
    print(Signal.Paint.Fill(7) == Signal.Paint.Stroke{width: 2, style: 1})
    print(Signal.Quit.compare(Signal.Move(1)) == .Less)
    print(Signal.Paint.Fill(9).compare(Signal.Paint.Fill(2)) == .Greater)
    print(Signal.Paint.Stroke{width: 2, style: 1}.compare(Signal.Paint.Stroke{width: 2, style: 5}) == .Less)
    print(Notes.note_move())
    print(Notes.note_stroke())
}
