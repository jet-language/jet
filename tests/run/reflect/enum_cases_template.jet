// A derive and a marker template read an enum's cases from `cases`. The
// built-in Equatable and Comparable derives match every case, grouped ones
// and named payloads included; a user marker unrolls one row per case and
// reads each case's name, index and payload fields; and a marker on a case,
// grouped or not, reads that case's CaseInfo.
CaseRows: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            tname: target.name
            impl #{tname} {
                case_rows: fn() -> [String] {
                    rows := [String]{}
                    leaf := ""
                    index := 0
                    fields := 0
                    #loop case in target.reflect().cases {
                        leaf = case.name
                        index = case.index
                        fields = 0
                        #loop field in case.reflect().fields {
                            fields += 1
                        }
                        rows.push("{leaf} is case {index} with {fields} payload fields")
                    }
                    rows
                }
            }
        }
    }
}

CaseNote: struct {
    label: String

    impl Marker {
        sites: [.Variant]

        expand: fn(self, target: Target) {
            made: "note_{self.label}"
            seen: "{target.name} is case {target.index}"
            impl Notes {
                #{made}: fn() -> String { #{seen} }
            }
        }
    }
}

Notes: struct {}

#[Equatable, Comparable, CaseRows]
Signal: enum {
    Quit
    #CaseNote("move") Move(Int)
    Resize(w: Int, h: Int)
    Paint {
        Fill(Int)
        #CaseNote("stroke") Stroke(width: Int, style: Int)
    }
}

run: fn() {
    loop row in Signal.case_rows() -> print(row)
    print(Signal.Move(3) == Signal.Move(3))
    print(Signal.Move(3) == Signal.Move(4))
    print(Signal.Resize{w: 2, h: 1} == Signal.Resize{w: 2, h: 1})
    print(Signal.Paint.Fill(7) == Signal.Paint.Fill(7))
    print(Signal.Paint.Fill(7) == Signal.Paint.Fill(8))
    print(Signal.Paint.Fill(7) == Signal.Move(7))
    print(Signal.Quit.compare(Signal.Move(1)) == .Less)
    print(Signal.Paint.Fill(9).compare(Signal.Paint.Fill(2)) == .Greater)
    print(Signal.Resize{w: 2, h: 1}.compare(Signal.Resize{w: 2, h: 5}) == .Less)
    print(Signal.Resize{w: 2, h: 1}.compare(Signal.Paint.Fill(0)) == .Less)
    print(Notes.note_move())
    print(Notes.note_stroke())
}
