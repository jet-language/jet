struct Tree {
    value: Int
    child: Tree?
}
fn sum(t: Tree) -> Int {
    total := t.value
kid ::  t.child 
    if kid == {
        .Val(c) -> {
            total = total + sum(c)
        }
        .None -> {}
    }
    return total
}
fn run() {
    root :: Tree{
        value: 3,
        child: Val(Tree{
            value: 2,
            child: Val(Tree{ value: 1, child: None })
        })
    }
    print(sum(root))
}
