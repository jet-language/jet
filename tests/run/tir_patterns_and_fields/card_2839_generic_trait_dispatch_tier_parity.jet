

trait Shape {
    fn area(self) -> Float
}

struct Circle {
    radius: Float

    impl Shape {
        fn area(self) -> Float { self.radius * self.radius }
    }
}

struct Square {
    side: Float
}

impl Square.Shape {
    fn area(self) -> Float { self.side * self.side }
}

fn run() {
    shapes :: [Shape]{Circle{radius: 2.0}, Square{side: 3.0}}
    loop shape in shapes -> print(shape.area())
    print(shapes.len())
}
