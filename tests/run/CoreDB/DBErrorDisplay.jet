// A `DBError` renders as the driver's message wherever it is shown: bare
// interpolation, an explicit `:Debug`, and its conversion to the default `Err`.
package: {
    name: "db_error_display"
    authority: { allow: [DB, IO, Mem.Alloc, Time.Wait] }
}

use db: core.db

failing_step: fn(scope: DBScope) -> Int {
    // The DBError converts to `Err` through its one display hook.
    db.migrate(scope, "v1", [SQL{"ALTER TABLE missing_table ADD COLUMN x INTEGER"}])
}

run: fn() {
    conn: db.open_memory()
    policy: db.policy("item", "true") ?? panic("policy")
    scope: conn.with_policy(policy, "owner")
    if db.migrate(scope, "v1", [SQL{"ALTER TABLE missing_table ADD COLUMN x INTEGER"}]) == {
        .Ok(steps) -> print("applied {steps}")
        .Err(e) -> {
            print("display: {e}")
            print("debug: {e:Debug}")
        }
    }
    if failing_step(scope) == {
        .Ok(steps) -> print("applied {steps}")
        .Err(e) -> print("as Err: {e.message}")
    }
}
