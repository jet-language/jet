// `find` and `level` write no failure contract, so the cases they create form
// their own error types, `FindError` and `LevelError`. Each shows with `{e}`
// and `{e:Debug}` as a written `#Error enum` does. `level` also fails with a
// message, so its failures are the open union `Err | LevelError`, which shows
// the member that arrived.
find: fn(book: [String:Int], name: String) -> Int {
    if name == "" -> return Err(.Blank)
    if book.has_key(name) -> return book[name]
    Err(.NotFound(name.copy()))
}

level: fn(raw: String) -> Int {
    if raw == "" -> return Err(.Empty)
    if raw == "x" -> return Err("odd input")
    7
}

show_find: fn(book: [String:Int], name: String) -> String {
    if find(book, name) == {
        .Ok(n) -> "found {n}"
        .Err(e) -> "failed: {e} ({e:Debug})"
    }
}

show_level: fn(raw: String) -> String {
    if level(raw) == {
        .Ok(n) -> "level {n}"
        .Err(e) -> "failed: {e}"
    }
}

run: fn() {
    book: ["ada": 36]
    print(show_find(book, "ada"))
    print(show_find(book, "zed"))
    print(show_find(book, ""))
    print(show_level("x"))
    print(show_level(""))
    print(show_level("3"))
}
