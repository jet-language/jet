// Function values inside Option and Result carriers: `or_err`,
// `??`, `map`, if-let, a match, propagation and a generic carrier over a
// function payload, next to the same combinators over struct and enum
// payloads. A Result of a function and a fallible function are different
// types, and an Option `map` whose callback calls a named function yields
// that callback's success (or passes its failure up).

lower: fn(s: String) -> String { s.to_lower() }

upper: fn(s: String) -> String { s.to_upper() }

double: fn(x: Int) -> Int { x * 2 }

triple: fn(x: Int) -> Int { x * 3 }

Pair: struct { count: Int, label: String }

Shape: enum {
    Circle(r: Int)
    Rect(w: Int, h: Int)
}

area: fn(shape: Shape) -> Int {
    if shape == {
        .Circle(r) -> r * r * 3
        .Rect(w, h) -> w * h
    }
}

find_shape: fn(present: Bool) -> Shape? {
    if present -> return Val(Shape.Rect{w: 2, h: 5})
    None
}

even_tens: fn(x: Int) -> Int Err! {
    if x % 2 != 0 -> return Err("odd {x}")
    Ok(x * 10)
}

mapped_tens: fn(value: Int?) -> Int Err! {
    mapped: value.map(fn(x) { even_tens(x) })
    Ok(mapped ?? -1)
}

find: fn(present: Bool) -> (fn(Int) -> Int)? {
    if present -> return Val(double)
    None
}

find_pair: fn(present: Bool) -> Pair? {
    if present -> return Val(Pair{count: 7, label: "seven"})
    None
}

make: fn(present: Bool) -> (fn(Int) -> Int) Err! {
    if present -> return Ok(double)
    Err("no handler")
}

apply: fn(present: Bool) -> Int Err! {
    handler: make(present)
    Ok(handler(21))
}

pick: fn<T>(value: T?) -> T Err! {
    return if value == {
        .Val(payload) -> Ok(payload)
        .None -> Err("absent")
    }
}

run: fn() {
    commands: [String:fn(String) -> String]{"lower": lower, "upper": upper}
    shout: commands.get("upper").or_err("missing upper handler") ?? lower
    quiet: commands.get("quiet").or_err("missing quiet handler") ?? lower
    fallback: commands.get("quiet") ?? upper
    print("map: {shout("Hi")} {quiet("Hi")} {fallback("Hi")}")

    found: find(true).or_err("none") ?? triple
    missing: find(false).or_err("none") ?? triple
    print("option or_err: {found(10)} {missing(10)}")
    print("option ??: {(find(true) ?? triple)(5)} {(find(false) ?? triple)(5)}")
    print("option map: {find(true).map(fn(f) { f(4) }) ?? -1} {find(false).map(fn(f) { f(4) }) ?? -1}")
    if find(true) == .Val(f) -> print("if-let: {f(6)}")
    if find(false) == {
        .Val(f) -> print("match: {f(1)}")
        .None -> print("match: none")
    }

    made: make(true) ?? triple
    unmade: make(false) ?? triple
    print("result: {made(10)} {unmade(10)}")
    print("propagate: {apply(true) ?? -1} {apply(false) ?? -1}")
    picked: pick(find(true)) ?? triple
    unpicked: pick(find(false)) ?? triple
    print("generic: {picked(50)} {unpicked(50)}")

    pair: find_pair(true).or_err("none") ?? Pair{count: 0, label: "zero"}
    no_pair: find_pair(false).or_err("none") ?? Pair{count: 0, label: "zero"}
    print("struct: {pair.count} {pair.label} {no_pair.count} {no_pair.label}")
    print("struct map: {find_pair(true).map(fn(p) { p.label }) ?? "none"}")
    generic_pair: pick(find_pair(true)) ?? Pair{count: 0, label: "zero"}
    print("struct generic: {generic_pair.label}")
    print("enum map: {find_shape(true).map(fn(s) { area(s) }) ?? -1} {find_shape(false).map(fn(s) { area(s) }) ?? -1}")
    print("named map: {Int?{Val(41)}.map(fn(x) { triple(x) }) ?? -1}")
    print("fallible map: {mapped_tens(Val(8)) ?? -9} {mapped_tens(Int?{None}) ?? -9} {mapped_tens(Val(3)) ?? -9}")
}
