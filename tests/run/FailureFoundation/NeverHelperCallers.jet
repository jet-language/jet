// Explicit `Never!` helpers are plain values in every caller (#6425): inside a
// matching failure domain, beside a declared conversion, under local `??`
// handling, in an Option-return caller and in a plain caller. An explicit `Ok`
// carrier in a `Never!` body stays valid. The web build of this program is the
// cases row web_build/web_never_helper_callers_match_native_output.
#Error
ParseErr: enum {
    Empty
}

#Error
AppErr: enum {
    Parse(ParseErr)
    Missing(String)
}

impl AppErr.From(ParseErr) { from: fn(error: ParseErr) -> AppErr { AppErr.Parse(error) } }

double: fn(n: Int) -> Int Never! { n * 2 }

label: fn(text: String) -> String Never! { "<{text}>" }

// The helper's value inside a caller of another failure domain.
parse: fn(text: String) -> Int ParseErr! {
    if text == "" -> return Err(ParseErr.Empty)
    Ok(double(text.len()))
}

// The `Never!` call needs no conversion; the declared ParseErr -> AppErr route
// carries only `parse`'s failure.
load: fn(text: String) -> Int AppErr! {
    base: double(3)
    parsed: parse(text)
    Ok(base + parsed)
}

// An Option-return caller uses the helper's value directly.
find: fn(items: [String], wanted: String) -> String? {
    loop item in items {
        if item == wanted -> return Val(label(item))
    }
    None
}

// The explicit carrier spelling of a `Never!` body.
explicit: fn(n: Int) -> Int Never! {
    return Ok(double(n))
}

run: fn() {
    print(double(21))
    print(load("abcd") ?? 0)
    print(load("") ?? 0)
    if load("") == {
        .Ok(value) -> { print(value) }
        .Err(_error) -> { print("error") }
    }
    print(find(["a", "b"], "b") ?? "none")
    print(find(["a"], "z") ?? "none")
    print(explicit(5))
    print(label("x"))
}
