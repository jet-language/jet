#Error
FetchError: struct {
    message: String
}

load_text: fn(ok: Bool) -> String FetchError! {
    if ok -> return Ok("ready")
    return Err(FetchError{message: "offline"})
}

recovered: fn(ok: Bool) -> String {
    value: load_text(ok) ?? {
        print("handled {err.message}")
        return "recovered"
    }
    return value
}

chained: fn(ok: Bool) -> Int FetchError! {
    value: load_text(ok)?("chained fetch")
    return Ok(value.len())
}

run: fn() {
    print(recovered(true))
    print(recovered(false))

    fallback: load_text(false) ?? {
        print("value fallback")
        "fallback"
    }
    print(fallback)

    print(chained(true) ?? 0)
}
