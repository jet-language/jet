// The failure type minted from an unannotated function's cases leaves `run`
// with no declared conversion: its text becomes the `Err` message, and the
// report names the conversion it took.
find: fn(book: [String:Int], name: String) -> Int {
    if book.has_key(name) -> return book[name]
    Err(.NotFound(name.copy()))
}

run: fn() {
    book: ["ada": 36]
    print(find(book, "ada"))
    print(find(book, "zed"))
}
