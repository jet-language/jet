// #5477: a panic inside `#Transact` rolls back like every other non-commit
// exit: the changed balance is restored (through the Ledger's `Rollback`
// implementation, which says so), then the `on_rollback` hooks run newest
// first. A hook that fails is never fatal: its failure is appended to the
// panic's report after "while rolling back, this also failed:", and the next
// hook still runs. After the rollback the panic keeps propagating
// as usual, so the program stops with the panic's report.
Ledger: struct {
    balance: Int
}

LedgerSnap: struct {
    balance: Int
}

impl Ledger.Rollback {
    Snapshot: LedgerSnap

    snapshot: fn(self) -> LedgerSnap { return LedgerSnap{balance: self.balance} }

    restore: fn(&self, snap: &&LedgerSnap) {
        print("balance {self.balance} restored to {snap.balance}")
        self.balance = snap.balance
    }
}

audit: fn() {
    panic("the audit log is unavailable")
}

withdraw: fn(ledger: &Ledger) {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("hook: release the hold"))
        tx.on_rollback(() -> audit())
        tx.on_rollback(() -> print("hook: notify the owner"))
        panic("the card was declined")
    }
}

run: fn() {
    ledger := Ledger{balance: 100}
    withdraw(ledger)
    print("not reached: balance {ledger.balance}")
}
