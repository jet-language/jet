// #6281 c125 (#4488): a Never value fills a success-value slot. `v ?? panic(…)`
// binds the Int it unwraps, and a tail `panic(…)` ends a `-> Int` function;
// the stopped arm adds no value to the join.
pick: fn(v: Int?) -> Int {
    y := v ?? panic("no value")
    y + 1
}

positive: fn(n: Int) -> Int {
    if n > 0 -> return n
    panic("not positive")
}

run: fn() {
    print(pick(Val(41)))
    print(positive(3))
}
