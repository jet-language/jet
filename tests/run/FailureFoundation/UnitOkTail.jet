// An arrowless unit-fallible signature preserves its typed failure carrier.
// `Ok()` returns Unit success, including in early returns and terminal arms;
// terminal `Err(...)` returns the declared error rather than a default error.
#Error
StepError: enum {
    Refused
}

step: fn(name: String) StepError! {
    print("step {name}")
    Ok()
}

guarded: fn(value: Int) StepError! {
    if value < 0 -> return Err(StepError.Refused)
    if value == 0 {
        print("early")
        return Ok()
    }
    print("late")
    Ok()
}

chain: fn(value: Int) StepError! {
    step("chain")
    guarded(value)
    Ok()
}

refused: fn() StepError! {
    if true == {
        true -> Err(StepError.Refused)
        else -> Ok()
    }
}

run: fn() {
    loop value in [0, 1, -1] {
        if chain(value) == {
            .Ok(_) -> print("ok {value}")
            .Err(error) -> print(error)
        }
    }
    if refused() == {
        .Ok(_) -> print("unexpected")
        .Err(error) -> print(error)
    }
}
