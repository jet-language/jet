// A unit-fallible function's error contract parses on either side of its
// effect arrow: `before` writes `MakeError! -[IO]>`, `after` writes
// `-[IO]> MakeError!`, and both are the same signature.
#Error
MakeError: enum { Failed }

before: fn(n: Int) MakeError! -[IO]> {
    if n < 0 -> return Err(MakeError.Failed)
    print("before {n}")
}

after: fn(n: Int) -[IO]> MakeError! {
    if n < 0 -> return Err(MakeError.Failed)
    print("after {n}")
}

run: fn() {
    before(1) ?? print("before failed")
    after(2) ?? print("after failed")
    before(-1) ?? print("before failed")
    after(-2) ?? print("after failed")
}
