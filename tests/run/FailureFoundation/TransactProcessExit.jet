// #5477: `process.exit` inside `#Transact` rolls back like every other
// non-commit exit: the changed balance is restored (through the Ledger's
// `Rollback` implementation, which says so), then the `on_rollback` hook runs,
// in the cleanup that runs before the process exits with the requested
// code.
package: {
    name: "transact_process_exit"
    authority: { allow: [Exec, IO] }
}

use process: core.process

Ledger: struct {
    balance: Int

    impl Rollback {
        Snapshot: LedgerSnap

        snapshot: fn(self) -> LedgerSnap { return LedgerSnap{balance: self.balance} }

        restore: fn(&self, snap: &&LedgerSnap) {
            print("balance {self.balance} restored to {snap.balance}")
            self.balance = snap.balance
        }
    }
}

LedgerSnap: struct {
    balance: Int
}

leave: fn() {
    process.exit(0)
}

withdraw: fn(ledger: &Ledger) {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("hook: release the hold"))
        print("exiting inside the transaction")
        leave()
    }
}

run: fn() {
    ledger := Ledger{balance: 100}
    withdraw(ledger)
    print("not reached: balance {ledger.balance}")
}
