// #5477: every exit of a `#Transact` block other than its clean end rolls back
// the same way: the values the block changed are restored (here through the
// Ledger's `Rollback` implementation, which says so), then the `on_rollback`
// hooks run newest first. Shown here: an early return, a failure that
// propagates and a `break` out of the block. A hook that fails is never
// fatal: its failure is reported on stderr after "while rolling back, this
// also failed:", the remaining hooks still run, and the program goes on.
// transact_panic_rollback.jet shows a panic, transact_process_exit.jet and
// transact_os_stop.jet an exit. A cancellation or a deadline rolls back as a
// panic does.
package: {
    name: "transact_exit_kinds"
    authority: { allow: [IO] }
}

Ledger: struct {
    name: String
    balance: Int

    impl Rollback {
        Snapshot: LedgerSnap

        snapshot: fn(self) -> LedgerSnap { return LedgerSnap{balance: self.balance} }

        restore: fn(&self, snap: &&LedgerSnap) {
            print("  {self.name}: balance {self.balance} restored to {snap.balance}")
            self.balance = snap.balance
        }
    }
}

LedgerSnap: struct {
    balance: Int
}

#Error
Refused: enum {
    Closed
}

refuse: fn() -> Int Refused! {
    Err(Refused.Closed)
}

audit: fn() {
    panic("the audit log is unavailable")
}

commit: fn(ledger: &Ledger) {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("  commit: hook (never runs)"))
    }
}

early_return: fn(ledger: &Ledger) -> Int {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("  early return: first hook"))
        tx.on_rollback(() -> print("  early return: second hook"))
        if ledger.balance < 1000 -> return -1
    }
    0
}

failure: fn(ledger: &Ledger) -> Int Refused! {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("  failure: first hook"))
        tx.on_rollback(() -> print("  failure: second hook"))
        _: refuse()
    }
    Ok(0)
}

loop_break: fn(ledger: &Ledger) {
    loop {
        #Transact(tx) {
            ledger.balance -= 10
            tx.on_rollback(() -> print("  break: hook"))
            break
        }
    }
}

failing_hook: fn(ledger: &Ledger) -> Int {
    #Transact(tx) {
        ledger.balance -= 10
        tx.on_rollback(() -> print("  failing hook: first hook still runs"))
        tx.on_rollback(() -> audit())
        tx.on_rollback(() -> print("  failing hook: third hook"))
        if ledger.balance < 1000 -> return -1
    }
    0
}

run: fn() {
    ledger := Ledger{name: "ledger", balance: 1000}
    print("commit:")
    commit(ledger)
    print("  balance {ledger.balance}")

    print("early return:")
    _: early_return(ledger)
    print("  balance {ledger.balance}")

    print("failure:")
    _: failure(ledger) ?? -1
    print("  balance {ledger.balance}")

    print("break:")
    loop_break(ledger)
    print("  balance {ledger.balance}")

    print("failing hook:")
    _: failing_hook(ledger)
    print("  balance {ledger.balance}")
}
