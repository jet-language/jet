// Direct `.Ok` / `.Err` matching preserves a local structured error family.
#Error
ParseError: struct {
    message: String
}

parse: fn(raw: String) -> Int ParseError! {
    if raw == "" -> return Err(ParseError{message: "empty input"})
    return Ok(7)
}

show: fn(raw: String) {
    if parse(raw) == {
        .Ok(value) -> print("ok: {value}")
        .Err(error) -> print("err: {error.message}")
    }
}

run: fn() {
    show("jet")
    show("")
}
