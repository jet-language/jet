enum Sign {
    Pos
    Neg
    Zero

    fn make_pos() -[]> Sign {
        return Sign.Pos
    }
    fn to_num(self) -[]> Int {
        if self == {
            .Pos -> { return 1 }
            .Neg -> { return 0 }
            .Zero -> { return 0 }
        }
    }
}
fn run() {
    s :: Sign.make_pos()
    print(s.to_num())
}
