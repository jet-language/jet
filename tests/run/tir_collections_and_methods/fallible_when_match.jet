#Error
enum ClassifyError {
    Bad(String)
}
fn classify(x: Int) -> Int ClassifyError! {
    if x == 0 {
        return Err(ClassifyError.Bad("bad"))
    }
    return Ok((x + 10))
}
fn run() {
    classify(5) ? n -> { print(n) } ! e -> { print(e) }
    classify(0) ? n -> { print(n) } ! e -> { print(e) }
}
