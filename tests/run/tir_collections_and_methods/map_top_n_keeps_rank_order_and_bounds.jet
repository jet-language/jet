
fn run() {
    counts := [String:Int]{}
    counts["b"] = 2
    counts["d"] = 1
    counts["a"] = 2
    counts["c"] = 3
    loop item in counts.top_n(2) -> print("{item.key}:{item.value}")
    print(counts.top_n(0).len())
    print(counts.top_n(-1).len())
    loop item in counts.top_n(10) -> print("{item.key}:{item.value}")
}
