fn apply(f: fn(Int) -> Int, x: Int) -> Int {
    return f(x)
}
fn visit(f: fn(Int), x: Int) {
    f(x)
}
fn plus_one(x: Int) -> Int {
    return x + 1
}
fn run() {
    print(apply((n: Int) -> {
        doubled :: (n * 2)
        plus_one(doubled)
    }, 20))
    visit((n: Int) -> {
        print("seen {n}")
    }, 7)
}
