use {
    math: core.math
    crypto: core.crypto
}
calc: fn(a: Float) -> Float {
    r: math.sqrt(a)
    f: math.floor(r)
    c: math.ceil(r)
    return (f + c)
}
make_path: fn(a: String, b: String) -> String {
    return Path.from(a).join(b).to_string()
}
hash: fn(s: String) -> String {
    return crypto.sha256(s.bytes()).hex()
}
run: fn() {
    print(calc(16.0))
    print(make_path("/usr", "bin"))
    print(hash("hello"))
}
