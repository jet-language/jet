use Tree: core.encoding.Dyn

tree_weight: fn(value: Tree) -> Int {
    if value == {
        .Int(weight) -> weight
        .Null | .Bool(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> 0
    }
}

run: fn() {
    print("core carriers")
    print(tree_weight(Tree.Int(7)))
}
