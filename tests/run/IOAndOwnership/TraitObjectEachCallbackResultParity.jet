#Error
VisitError: enum {
    Stop
}
Shape: trait {
    name: fn(self) -[]> String
}
Circle: struct {
    radius: Float
    impl Shape {
        name: fn(self) -[]> String {
            return "circle"
        }
    }
}
Square: struct {
    side: Float

    impl Shape {
        name: fn(self) -[]> String {
            return "square"
        }
    }
}
visit_ok: fn(s: Shape) VisitError! {
    name: s.name()
    print(name)
    return
}
visit_fail: fn(s: Shape) VisitError! {
    name: s.name()
    print(name)
    if name == "circle" {
        return Err(VisitError.Stop)
    }
    return
}
consume_plain: fn() -[]> Unit {
    shapes: [Shape]{ Circle{radius: 1.0}, Square{side: 2.0} }
    shapes.each((s) -> {})
}
consume_ok: fn() VisitError! {
    shapes: [Shape]{ Circle{radius: 1.0}, Square{side: 2.0} }
    shapes.each((s) -> visit_ok(s))
    return
}
consume_fail: fn() VisitError! {
    shapes: [Shape]{ Circle{radius: 1.0}, Square{side: 2.0} }
    shapes.each((s) -> visit_fail(s))
    return
}
run: fn() {
    consume_ok() ? ok -> { print("callback-ok") } ! error -> { print("callback-ok-failed") }
    consume_fail() ? ok -> { print("callback-failed-missed") } ! error -> { print("callback-failed") }
    consume_plain()
    print("plain-ok")
}
