fn grade(score: Int) -> String {
    if score == {
        0..59 -> { return "F" }
        60..69 -> { return "D" }
        70..89 -> { return "C" }
        90..100 -> { return "A" }
        else -> { return "?" }
    }
}
fn run() {
    print(grade(95))
    print(grade(72))
    print(grade(45))
    print(grade(120))
}
