Light: enum {
    Red
    Yellow
    Green
}
next: fn(light: Light) -> Light {
    if light == {
        .Red -> { return Light.Yellow }
        .Yellow -> { return Light.Green }
        .Green -> { return Light.Red }
    }
}
label: fn(light: Light) -> String {
    if light == {
        .Red -> { return "stop" }
        .Yellow -> { return "caution" }
        .Green -> { return "go" }
    }
}
run: fn() {
    start: Light.Red
    print(label(start))
    print(label(next(start)))
}
