trait Shape {
    fn area(self) -> Float
    fn name(self) -> String
}
struct Circle {
    radius: Float
    impl Shape {
        fn area(self) -> Float {
            return ((3.0 * self.radius) * self.radius)
        }
        fn name(self) -> String {
            return "circle"
        }
    }
}
struct Square {
    side: Float
}
impl Square.Shape {
    fn area(self) -> Float {
        return (self.side * self.side)
    }
    fn name(self) -> String {
        return "square"
    }
}
fn describe(s: Shape) -> String {
    return "{s.name()}: {s.area()}"
}
fn run() {
shapes :: [Shape]{ Circle{radius: 2.0}, Square{side: 3.0} }
    shapes.each((s) -> {
        print(describe(s))
    })
}
