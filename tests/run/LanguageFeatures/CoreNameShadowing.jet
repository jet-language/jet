// A program's own declarations keep their identity when a loaded Core module
// declares types with the same names. `core.ui.host` declares
// `UICancellation: enum { User Closed Headless Superseded Programmatic }` and
// `UIFileFilter: struct { label extensions mime_types }`; the declarations
// below reuse both names with other variants and other fields. Folded `#run`
// constants, field reads and matches must all resolve to these declarations,
// never to Core's (#4003).
use core.ui.host

UICancellation: enum {
    Monospace
    Title
    Body
}

UIFileFilter: struct {
    size: Int
    style: UICancellation?
    family: String
}

FACES: #run {
    [UIFileFilter]{
        UIFileFilter{family: "Serif", size: 12, style: Val(UICancellation.Body)},
        UIFileFilter{family: "Code", size: 10, style: Val(UICancellation.Monospace)},
        UIFileFilter{family: "Plain", size: 9, style: None},
    }
}

ORDER: #run { [UICancellation]{UICancellation.Title, UICancellation.Body} }

describe: fn(style: UICancellation) -> String {
    if style == {
        .Monospace -> "fixed-width"
        .Title -> "heading"
        .Body -> "running text"
    }
}

run: fn() {
    loop face in FACES {
        if face.style == {
            .Val(style) -> print("{face.family} {face.size}pt {style} ({describe(style)})")
            .None -> print("{face.family} {face.size}pt unstyled")
        }
    }
    loop style in ORDER {
        print("{style}: {describe(style)}")
    }
}
