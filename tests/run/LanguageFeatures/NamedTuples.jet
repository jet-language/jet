bounds: fn() -> (max: Int, min: Int) { return (min: 0, max: 10) }

// Member order is part of a record's type, so q compares with p only once a
// typed slot has converted it by name.
as_xy: fn(cell: (x: Int, y: Int)) -> (x: Int, y: Int) { cell.copy() }

run: fn() {
    p: (x: 1, y: 2)
    q: (y: 3, x: 4)
    same_shape: (p == as_xy(q))
    { x: a, y: b }: p.copy()
    print("{p.x} {p.y} {a} {b} {same_shape}")
    pair: bounds()
    print("{pair.min} {pair.max}")
}
