// #2356: statement-position payload dispatch for user enums and Dyn.
Marker: enum {
    Label(String)
    Count(Int)
    Empty
}

show_marker: fn(value: Marker) {
    if value == {
        .Label(text) -> print("marker:{text}")
        .Count(_) -> print("marker:count")
        .Empty -> print("marker:empty")
    }
}

show: fn(value: Dyn) {
    if value == {
        .Text(text) -> print("text:{text}")
        .Int(_) -> print("int")
        .Null -> print("null")
        else -> print("other")
    }
}

run: fn() {
    show_marker(.Label("hello"))
    show_marker(.Count(42))
    show_marker(.Empty)
    show(Dyn.Text("hello"))
    show(Dyn.Int(42))
    show(Dyn.Null)
    show(Dyn.Bool(true))
}
