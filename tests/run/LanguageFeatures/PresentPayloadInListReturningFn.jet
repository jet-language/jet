// In a function that returns `[T]?`, only the returned list is shaped by that
// return type. A `Val(...)` built for a field or a list element keeps its own
// type: a struct literal stays the struct, an enum literal stays the enum.
Label: struct {
    name: String
}

Default: enum {
    Text(value: String)
    Flag(value: Bool)
}

Arg: struct {
    text: String
    label: Label?
}

label_all: fn(args: [Arg], name: String) -> [Arg]? {
    if args.len() == 0 -> return None
    labelled := args
    loop index in 0..<labelled.len() {
        labelled[index].label = Val(Label{name: "{name}{index}"})
    }
    Val(labelled)
}

defaults: fn(csv: Bool) -> [Default?]? {
    found := [Default?]{None}
    if csv {
        found.push(Val(Default.Text{value: ","}))
        found.push(Val(Default.Flag{value: false}))
    }
    Val(found)
}

run: fn() {
    args: [Arg]{Arg{text: "a", label: None}, Arg{text: "b", label: None}}
    labelled: label_all(args, "arg") ?? [Arg]{}
    loop arg in labelled -> print("{arg.text}: {arg.label?.name ?? "-"}")
    print(label_all([Arg]{}, "none") == None)
    entries := [Default?]{}
    if defaults(true) == .Val(list) -> entries = list
    loop entry in entries {
        if entry == {
            .Val(.Text(value)) -> print("text {value}")
            .Val(.Flag(value)) -> print("flag {value}")
            .None -> print("none")
        }
    }
}
