// Names that hold a foreign teaching word or a keyword's letters are ordinary
// bindings: `switch` and `import` are not Jet keywords, and `printer`,
// `in_count` and `sprint` only contain keyword spellings (tests/lsp.rs:5456
// c40_is_keyword_retired_words_not_keywords, tests/lsp.rs:5625
// c40_keyword_like_identifier_usable_as_variable).
run: fn() {
    switch_count: 0
    import_count: 1
    printer: "hp"
    in_count: 3
    sprint: 9.8
    print("{switch_count} {import_count} {printer} {in_count} {sprint}")
}
