// A record may hold an optional file handle and compare it with None.
use files: core.files

Holder: struct {
    reader: files.FileReader?
}

has_reader: fn(holder: Holder) -> Bool {
    holder.reader != None
}

lacks_reader: fn(holder: Holder) -> Bool {
    holder.reader == None
}

run: fn() {
    holder: Holder{reader: None}
    print("has reader: {has_reader(holder)}")
    print("lacks reader: {lacks_reader(holder)}")
}
