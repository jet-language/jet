// `loop line in reader.lines()` reads one line a pass from the reader itself,
// fresh or kept (#6087 c2): every trailing CR and LF goes, a line longer than
// the reader's 8192-byte buffer arrives whole, a last line without an LF
// counts, and a non-ASCII line is checked as UTF-8. A kept reader stays where
// the loop left it, so after a `break` read_line returns the next line.
package: {
    name: "file_lines_read_in_place"
    authority: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] }
}

use files: core.files

run: fn() {
    dir: files.tmpdir("jet-file-lines-") ?? panic("tmpdir")
    path: files.join(dir, "lines.txt")
    long := ""
    loop _ in 0..<10000 -> long += "x"
    files.write(path, "alpha\r\n\n\r\nbeta\r\r\n{long}\nhéllo wörld\ntail") ?? panic("write")
    count := 0
    loop line in (files.open(path) ?? panic("open")).lines() {
        shown: if line.len() > 16 -> "{line.len()} bytes of x" else -> "[{line}]"
        print("{count}: {shown}")
        count += 1
    }
    reader := files.open(path) ?? panic("open kept")
    loop line in reader.lines() {
        print("kept: [{line}]")
        if line == "beta" -> break
    }
    after: reader.read_line() ?? "none"
    print("after the break: {after.len()} bytes")
    rest := 0
    loop _ in reader.lines() -> rest += 1
    print("lines left: {rest}")
    print("at the end: {reader.read_line() ?? "none"}")
    files.remove_all(dir) ?? panic("remove")
}
