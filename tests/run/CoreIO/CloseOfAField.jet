// A Close method may close a field it owns directly, `close(self.inner.move())`,
// the same as through a binding (`inner := &&self.inner; close(inner)`):
// the field's own Close runs once, at that point.
package: {
    name: "close_of_a_field"
    authority: { allow: [IO, Mem.Alloc] }
}

Inner: struct {
    label: String

    impl Close {
        close: fn(&&self) -[IO]> { print("close inner {self.label}") }
    }
}

Direct: struct {
    inner: Inner

    impl Close {
        close: fn(&&self) -[IO]> {
            print("close direct")
            close(self.inner)
        }
    }
}

Bound: struct {
    inner: Inner

    impl Close {
        close: fn(&&self) -[IO]> {
            inner := self.inner.move()
            close(inner)
        }
    }
}

scoped: fn() -[IO]> {
    held: Direct{inner: Inner{label: "scoped"}}
    print("scope ends with {held.inner.label}")
}

run: fn() {
    direct: Direct{inner: Inner{label: "direct"}}
    close(direct)
    bound: Bound{inner: Inner{label: "bound"}}
    close(bound)
    scoped()
    print("done")
}
