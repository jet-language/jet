use json: core.encoding.json
run: fn() {
    raw: "{{\"name\":\"jet\",\"ok\":true}}"
    data: json.parse(raw) ?? panic("bad json")
    if data == .Object(entries) {
        print(entries.len())
    }
    obj := [String:Dyn]{}
    obj["name"] = Dyn.Text("jet")
    obj["ok"] = Dyn.Bool(true)
    obj["none"] = Dyn.Null
    print(json.to_string(Dyn.Object(obj)))
}
