
Wrapped: enum {
    Val(Int)
    Ok(Int)
    Err(Int)
}

Ok: fn(value: Int) -> Int {
    return (value + 10)
}

user_err: fn(value: Int) -> Int {
    return (value + 20)
}

run: fn() {
    print(Ok(1))
    print(user_err(2))
    wrapped: Wrapped.Val(7)
    if wrapped == {
        .Val(value) -> { print(value) }
        .Ok(value) -> { print(value) }
        .Err(value) -> { print(value) }
    }
}
