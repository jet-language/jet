// A variant arm's guard may test a different enum value: `form == .Iterator`
// compares `form`, never the switch subject.
Form: enum { Unconditional Counted Iterator }

Op: enum {
    RangeInit(a: Int, b: Int)
    IterInit(a: Int, b: Int)
    IterAdvance(a: Int, value: Int)
    Other
}

Instr: struct {
    operation: Op
    result: Int?
}

pick: fn(instructions: [Instr], form: Form) -> Int? {
    loop instruction in instructions {
        if instruction.operation == {
            .RangeInit(_, _) && form == .Counted -> return Val(1)
            .IterInit(_, _) && form == .Iterator -> return Val(2)
            .RangeInit(_, _) | .IterInit(_, _) | .IterAdvance(_, _) | .Other -> {}
        }
    }
    None
}

pick_local: fn(op: Op, form: Form) -> Int {
    if op == {
        .RangeInit(_, _) && form == .Counted -> 1
        .IterInit(_, _) && form == .Iterator -> 2
        .RangeInit(_, _) | .IterInit(_, _) | .IterAdvance(_, _) | .Other -> 0
    }
}

run: fn() {
    instructions: [Instr]{Instr{operation: Op.IterInit{a: 1, b: 2}, result: None}, Instr{operation: Op.RangeInit{a: 0, b: 3}, result: Val(3)}}
    print(pick(instructions, Form.Iterator) ?? 0)
    print(pick(instructions, Form.Counted) ?? 0)
    print(pick(instructions, Form.Unconditional) ?? 0)
    print(pick_local(Op.IterInit{a: 1, b: 2}, Form.Iterator))
    print(pick_local(Op.IterInit{a: 1, b: 2}, Form.Counted))
}
