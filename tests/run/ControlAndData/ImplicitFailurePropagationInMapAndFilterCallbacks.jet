
source: fn(value: Int) -> Int {
    if value == 0 {
        return Err("source failed")
    }
    return value
}

source_flag: fn(value: Int) -> Bool {
    if value == 0 {
        return Err("source failed")
    }
    return value > 1
}

add_one: fn(value: Int) -> Int { value + 1 }
retain_flag: fn(value: Bool) -> Bool { value }

run: fn() {
    values: [1, 2]
    mapped: values.map(fn(value: Int) { add_one(source(value)) }) ?? []
    filtered: values.filter(fn(value: Int) { retain_flag(source_flag(value)) }) ?? []
    mapped_block: values.map(fn(value: Int) {
        add_one(source(value))
    }) ?? []
    filtered_block: values.filter(fn(value: Int) {
        retain_flag(source_flag(value))
    }) ?? []
    mapped_failed: [0, 1].map(fn(value: Int) {
        add_one(source(value))
    }) ?? []
    filtered_failed: [0, 1].filter(fn(value: Int) {
        retain_flag(source_flag(value))
    }) ?? []
    print(mapped[0])
    print(mapped[1])
    print(filtered.len())
    print(mapped_block[0])
    print(mapped_block[1])
    print(filtered_block.len())
    print(mapped_failed.len())
    print(filtered_failed.len())
}
