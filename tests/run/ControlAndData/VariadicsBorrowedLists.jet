// #4894: forwarding read parameters never consumes the caller's List or String.
join: fn(parts: ...String) -> String { parts.join(",") }
fresh: fn() -> [String] { [String]{"fresh"} }
inspect: fn(parts: [String], item: String) {
    print(join(...parts))
    print(join(...parts))
    print(join(item, item))
    print(item)
    print(parts.join(","))
}

run: fn() {
    parts: [String]{"one", "two"}
    item: "borrowed"
    inspect(parts, item)
    print(parts.join(","))
    print(item)
    print(join(...[String]{"literal"}))
    print(join(...fresh()))
}
