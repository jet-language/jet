
Holder: struct {
    value: Int

    bump: fn(self, by: Int) -> Int {
        return add(self.value + by)
    }
}

source: fn(value: Int) -> Int {
    if value == 0 {
        return Err("source failed")
    }
    return value
}

add: fn(value: Int) -> Int { value + 1 }

is_zero: fn(value: Int) -> Bool { value == 0 }

argument: fn(value: Int) -> Int {
    return add(source(value))
}

nested: fn(value: Int) -> Int {
    return source(value) + 1
}

branch: fn(value: Int) -> Int {
    if is_zero(value) {
        source(value)
    }
    return value
}

branch_value: fn(value: Int) -> Int {
    return if is_zero(value) -> { source(value) } else -> { value + 1 }
}

closure: fn(value: Int) -> Int {
    worker: fn(n: Int) { source(n) + 1 }
    return worker(value)
}

method: fn(value: Int) -> Int {
    holder: Holder{ value: source(value) }
    return add(holder.bump(1))
}

run: fn() {
    print(argument(2) ?? 0)
    print(nested(2) ?? 0)
    print(branch(0) ?? 99)
    print(closure(2) ?? 0)
    print(method(2) ?? 0)
    print(branch_value(0) ?? 99)
}
