// Loops whose back edges repeat their exit tests (X64Select ir_x64_rotate):
// one exit, two exits from `&&`/`||`, a test on a value the body updates, a
// loop that never runs its body, an inner loop that leaves through its
// outer loop's test, and a loop exit followed by more work. Every loop must
// run the same passes on every tier.
count_below: fn(n: Int) -> Int {
    i := 0
    loop i < n {
        i += 1
    }
    i
}

both_tests: fn(n: Int, limit: Int) -> Int {
    i := 0
    sum := 0
    loop i < n && i * i < limit {
        sum += i
        i += 1
    }
    sum * 1000 + i
}

either_test: fn(n: Int) -> Int {
    i := 0
    passes := 0
    loop i % 7 != 6 || passes < n {
        passes += 1
        i += 1
    }
    passes * 1000 + i
}

steps: fn(start: Int) -> Int {
    x := start
    taken := 0
    loop x != 1 {
        x = if x % 2 == 0 -> x /% 2 else -> 3 * x + 1
        taken += 1
    }
    taken
}

grid: fn(rows: Int, cols: Int) -> Int {
    total := 0
    r := 0
    loop r < rows {
        c := 0
        loop c < cols {
            total += r * cols + c
            c += 1
        }
        r += 1
    }
    total
}

first_square_over: fn(limit: Int) -> Int {
    found := -1
    outer: loop a in 1..<100 {
        b := a
        loop b * b <= limit {
            if b * a * a > limit {
                found = b
                break(outer)
            }
            b += 1
        }
    }
    found
}

run: fn() {
    print(count_below(0))
    print(count_below(-5))
    print(count_below(17))
    print(both_tests(100, 50))
    print(both_tests(5, 1000))
    print(both_tests(0, 1000))
    print(either_test(0))
    print(either_test(20))
    print(steps(1))
    print(steps(27))
    print(steps(97))
    print(grid(0, 5))
    print(grid(4, 0))
    print(grid(13, 7))
    print(first_square_over(50))
    print(first_square_over(0))
}
