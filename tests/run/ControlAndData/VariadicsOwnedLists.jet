// An owned variadic pack and an explicitly moved spread each drop once.
join_owned: fn(parts: &&...String) -> String { parts.join(",") }

run: fn() {
    print(join_owned())
    print(join_owned("one", "two"))
    parts: [String]{"three", "four"}
    print(join_owned(...parts))
    fresh: join_owned(...[String]{"five", "six"})
    print(fresh)
}
