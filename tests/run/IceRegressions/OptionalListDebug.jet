// A list of optionals renders each element through the `T?` Display and Debug
// paths, a bare `None` element takes the literal's optional type
// on AOT, and `assert_eq` checks a bare `None` against the left side's
// optional type.
code: fn() -> String? { Val("E1231") }

missing: fn() -> String? { None }

run: fn() {
    codes: [String?]{code(), missing(), None}
    print(codes)
    print("{codes:Debug}")
    assert_eq(codes, [String?]{Val("E1231"), None, None})
    assert_eq(missing(), None)
    assert_eq(codes[1], None)
    print("ok")
}
