enum Light {
    Red
    Yellow
    Green
}
fn next(light: Light) -> Light {
    if light == {
        .Red -> { return Light.Yellow }
        .Yellow -> { return Light.Green }
        .Green -> { return Light.Red }
    }
}
fn label(light: Light) -> String {
    if light == {
        .Red -> { return "stop" }
        .Yellow -> { return "caution" }
        .Green -> { return "go" }
    }
}
fn run() {
    start :: Light.Red
    print(label(start))
    print(label(next(start)))
}
