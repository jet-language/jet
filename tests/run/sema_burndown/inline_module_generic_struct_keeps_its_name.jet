// #6171: an inline module's generic struct keeps its hoisted name wherever
// it is written with type arguments: in a literal inside the module
// (`Holder<Int>{…}`), in a literal through the module (`plain.Holder<Box>{…}`)
// and in a type (`plain.Holder<Int>`). The same holds through a generic-module
// instance (`shelf_i.Holder<shelf_i.Box>{…}`). Before, the head of
// `Holder<…>` kept its source spelling and failed E0107.
module plain {
    struct Box {
        count: Int
    }

    struct Holder<N> {
        value: N
    }

    fn make(value: Int) -> Holder<Int> { Holder<Int>{value: value} }

    fn boxed(count: Int) -> Holder<Box> { Holder<Box>{value: Box{count: count}} }
}

module shelf<N>(base: Int) {
    struct Box {
        count: N
    }

    struct Holder<V> {
        value: V
    }

    fn make(count: N) -> Holder<Box> { Holder<Box>{value: Box{count: count}} }

    fn offset() -> Int { base }
}

module shelf_i :: shelf<Int>(10)

fn read(holder: plain.Holder<Int>) -> Int { holder.value }

fn run() {
    print(read(plain.make(1)))
    print(plain.boxed(2).value.count)
    boxed :: plain.Holder<plain.Box>{value: plain.Box{count: 3}}
    print(boxed.value.count)
    print(read(plain.Holder<Int>{value: 4}))
    nested :: plain.Holder<[plain.Holder<Int>]>{value: [plain.Holder<Int>]{plain.make(5), plain.make(6)}}
    print(nested.value.len() + nested.value[1].value)
    held :: shelf_i.Holder<shelf_i.Box>{value: shelf_i.Box{count: 3}}
    print(held.value.count + shelf_i.offset())
    print(shelf_i.make(4).value.count)
    many :: shelf_i.Holder<[Int]>{value: [Int]{1, 2}}
    print(many.value.len())
}
