// #6172: a callee's type parameter spelled like the caller's in-scope one is
// a different variable. `wrap<T>` passing `[T]` to `size<T>` binds the
// callee's `T` to the caller's `[T]`, inferred or written explicitly, and an
// explicit list argument also works with no value arguments (`slots<[Int]>()`).
// Before, the solver read the caller's `T` as the callee's own: inference
// reported E0904, and the explicit spelling stopped with an internal error.
trait Weighed {
    fn weight(self) -> Int
}

struct Stone {
    kilos: Int
}

impl Stone.Weighed {
    fn weight(self) -> Int { self.kilos }
}

fn size<T>(values: T) -> Int { 1 }

fn count<T>(values: [T]) -> Int { values.len() }

fn slots<T>() -> Int { 7 }

fn heaviest<T: Weighed>(values: [T]) -> Int {
    best := 0
    loop value in values {
        if value.weight() > best -> best = value.weight()
    }
    best
}

fn first<T>(values: [T]) -> T { values[0] }

fn inferred<T>(value: T) -> Int {
    items :: [T]{value, value}
    size(items) + count(items)
}

fn explicit<T>(value: T) -> Int {
    1 + size<[T]>([T]{value})
}

fn nested<T>(value: T) -> Int {
    count<[T]>([[T]]{[T]{value}, [T]{value, value}})
}

fn bounded<T: Weighed>(value: T) -> Int {
    heaviest([T]{value})
}

fn forwarded<T>(values: [T]) -> T {
    first(values)
}

fn listed<T>(value: T) -> Int {
    slots<[T]>() + slots<T>()
}

fn run() {
    print(inferred(5))
    print(explicit("a"))
    print(nested(true))
    print(bounded(Stone{kilos: 9}))
    print(forwarded([Int]{4, 5}))
    print(slots<[Int]>())
    print(listed(true))
}
