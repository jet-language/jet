// #6172: a callee's type parameter spelled like the caller's in-scope one is
// a different variable. `wrap<T>` passing `[T]` to `size<T>` binds the
// callee's `T` to the caller's `[T]`, inferred or written explicitly, and an
// explicit list argument also works with no value arguments (`slots<[Int]>()`).
// Before, the solver read the caller's `T` as the callee's own: inference
// reported E0904, and the explicit spelling stopped with an internal error.
Weighed: trait {
    weight: fn(self) -> Int
}

Stone: struct {
    kilos: Int
}

impl Stone.Weighed {
    weight: fn(self) -> Int { self.kilos }
}

size: fn<T>(values: T) -> Int { 1 }

count: fn<T>(values: [T]) -> Int { values.len() }

slots: fn<T>() -> Int { 7 }

heaviest: fn<T: Weighed>(values: [T]) -> Int {
    best := 0
    loop value in values {
        if value.weight() > best -> best = value.weight()
    }
    best
}

first: fn<T>(values: [T]) -> T { values[0] }

inferred: fn<T>(value: T) -> Int {
    items: [T]{value, value}
    size(items) + count(items)
}

explicit: fn<T>(value: T) -> Int {
    1 + size<[T]>([T]{value})
}

nested: fn<T>(value: T) -> Int {
    count<[T]>([[T]]{[T]{value}, [T]{value, value}})
}

bounded: fn<T: Weighed>(value: T) -> Int {
    heaviest([T]{value})
}

forwarded: fn<T>(values: [T]) -> T {
    first(values)
}

listed: fn<T>(value: T) -> Int {
    slots<[T]>() + slots<T>()
}

run: fn() {
    print(inferred(5))
    print(explicit("a"))
    print(nested(true))
    print(bounded(Stone{kilos: 9}))
    print(forwarded([Int]{4, 5}))
    print(slots<[Int]>())
    print(listed(true))
}
