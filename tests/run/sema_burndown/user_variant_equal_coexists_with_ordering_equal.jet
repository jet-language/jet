// #4447: variant names are scoped to their enum, so a user `DiffOp.Equal`
// does not collide with the built-in `Ordering.Equal`; both are used in one
// function, qualified and through the expected type.
enum DiffOp {
    Equal(text: String)
    Insert(text: String)
    Delete(text: String)
}

fn show(op: DiffOp, order: Ordering) -> String {
    left :: if op == {
        .Equal(text) -> "={text}"
        .Insert(text) -> "+{text}"
        .Delete(text) -> "-{text}"
    }
    right :: if order == {
        .Equal -> "same"
        .Less -> "before"
        .Greater -> "after"
    }
    "{left} {right}"
}

fn run() {
    print(show(DiffOp.Equal{ text: "a" }, Ordering.Equal))
    print(show(.Insert{ text: "b" }, .Less))
    print(show(DiffOp.Delete{ text: "c" }, Ordering.Greater))
    print(DiffOp.Equal{ text: "x" } == DiffOp.Equal{ text: "x" })
}
