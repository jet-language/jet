// #4324: a tail-position match takes the function's return type as the
// expected type of its arms only; the scrutinee's call chain is checked on
// its own.
#Error
Fault: struct {
    reason: String
}

Spec: struct {
    text: String
}

impl Spec {
    run: fn(self) -> Int Fault! {
        if self.text == "" -> return Err(Fault{reason: "empty"})
        self.text.len()
    }
}

make: fn(text: String) -> Spec {
    Spec{text: text}
}

succeeded: fn(text: String) -> Bool Never! {
    if make(text).run() == {
        .Ok(n) -> n > 2
        .Err(_) -> false
    }
}

run: fn() {
    print(succeeded("abc"))
    print(succeeded("ab"))
    print(succeeded(""))
}
