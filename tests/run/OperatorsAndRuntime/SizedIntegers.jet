run: fn() {
red: U8{ 255 }
channel: I32{ 100000 }
depth: I8{ -120 }
    print(red)
    print(channel)
    print(depth)
total: I64{ 9000000000 }
    print(total + 1)
half: U8{ 100 }
    print(half + half)
bytes: [U8]{ 104, 105, 33 }
    print(bytes)
wide: I64{ Int{red} }
    print(wide)
clamped: checked(U8{channel}) ?? 255
    print(clamped)
    print(U8.MAX)
    print(I32.MIN)
flags: U8{ 13 }
    print(flags.count_ones())
    print(Float.INFINITY.is_infinite())
hi: U8{ 200 }
lo: U8{ 100 }
    print(wrapping(hi + lo))
    print(saturating(hi + lo))
fallback: U8{ 0 }
    print(checked(hi + lo) ?? fallback)
}
