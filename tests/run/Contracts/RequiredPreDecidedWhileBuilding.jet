// A `#Pre` condition written `#run { … }` is decided for each call while
// building, from that call's arguments; a call it holds for needs no
// run-time check. tests/ui/contract_required_pre_false.jet is the call it
// refuses.
#Pre(#run { lanes == 4 || lanes == 8 }, "need 4 or 8")
sum: fn(lanes: Int, values: [Int]) -> Int {
    total := 0
    loop value in values -> total += value
    total
}

run: fn() {
    print(sum(4, [1, 2, 3, 4]))
}
