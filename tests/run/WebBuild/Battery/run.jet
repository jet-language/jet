use {
    battery: web
    files: core.files
    http: core.http
    client: core.http.client
    server: core.http.server
    net: core.net
    core_web: core.web
}

// The App graph's pages read this fixture when the graph is served; the
// request run below migrates its own temporary database.
DB_PATH: "/tmp/jet-web-battery.sqlite"

app_home: fn() -> WebPage {
    count: battery.count_orders(DB_PATH) ?? return core_web.page("Orders unavailable", "<p>database read failed</p>")
    return battery.ssr_orders_page(count, "alice")
}

app_orders: fn() -> WebPage {
    count: battery.count_orders(DB_PATH) ?? return core_web.page("Orders unavailable", "<p>database read failed</p>")
    return battery.ssr_orders_page(count, "alice")
}

app_orders_loader: fn() -> String { "orders:list" }

app_create_action: fn(input: battery.NewOrder) -> String {
    inserted: battery.insert_order(DB_PATH, input.item, input.quantity) ?? return "database write failed"
    return "created={inserted}"
}

app_graph: fn() -> App {
    return core_web
        .app()
        .ssr()
        .route("/", app_home)
        .route("/orders", app_orders)
        .loader(app_orders, app_orders_loader, true)
        .route("/orders/:id", app_order_detail)
        .action("create-order", app_create_action)
        .form("order", app_create_action)
        .island()
        .assets("public")
        .hydration_dev()
}


#Codable
Login: struct {
    user: String
    password: String
}
#Codable
OrderSearch: struct {
    limit: Int
}

app_order_detail: fn(id: Int, search: OrderSearch) -> WebPage {
    return core_web.page(
        "Order",
        "<main><h1>Order {id}</h1><p>limit={search.limit}</p></main>"
    )
}


RouteState: struct {
    cache_version: Int
    session_id: String
}

Orders: struct {
    path: String
    state: Shared<RouteState>

    #Server.Get("/")
    home: fn(self) -> HTTPResponse HTTPError! {
        Ok(battery.ok_response("<h1>Orders</h1><a href=\"/orders\">list</a>"))
    }

    #Server.Get("/old")
    redirect: fn(self) -> HTTPResponse HTTPError! {
        Ok(battery.redirect_response("/orders"))
    }

    #Server.Get("/orders")
    list: fn(self, req: HTTPRequest) -> HTTPResponse HTTPError! {
        count: battery.count_orders(self.path) ?? return Ok(battery.status_response(500, "database read failed"))
        version: self.state.guard_read().value.cache_version
        body: "<h1>Orders</h1><p>request-path={req.path()}</p><p>orders={count}</p><p>cache={version}</p>"
        Ok(battery.ok_response(body))
    }

    #Server.Get("/orders/:id")
    detail: fn(self, id: Int) -> HTTPResponse HTTPError! {
        if id < 1 -> return Ok(battery.not_found_response("bad order id"))
        Ok(battery.ok_response("<h1>Order {id}</h1><p>{battery.order_detail_path(id)}</p>"))
    }

    #Server.Post("/orders")
    create: fn(self, req: HTTPRequest) -> HTTPResponse HTTPError! {
        fields: http.form_decode(req.text() ?? return Ok(battery.invalid_response("unreadable form")))
        item: http.query_get(fields, "item") ?? return Ok(battery.invalid_response("missing item"))
        quantity_text: http.query_get(fields, "quantity") ?? return Ok(battery.invalid_response("missing quantity"))
        view: battery.validate_order_form(item, quantity_text)
        if !view.valid -> return Ok(battery.invalid_response(view.errors))
        quantity: quantity_text.to_int() ?? return Ok(battery.invalid_response(view.errors))
        inserted: battery.insert_order(self.path, item, quantity) ?? return Ok(battery.status_response(500, "database write failed"))
        self.state.guard_edit().value.cache_version += 1
        Ok(battery.created_response("created order rows={inserted}"))
    }

    #Server.Post("/login")
    login: fn(self, req: HTTPRequest) -> HTTPResponse HTTPError! {
        input: req.json<Login>() ?? return Ok(battery.invalid_response("invalid login"))
        state: battery.login_state(input.user, input.password) ?? return Ok(battery.status_response(401, "login failed"))
        self.state.guard_edit().value.session_id = state.session_id
        response: battery.ok_response("logged in")
        Ok(response.header("set-cookie", state.cookie))
    }

    #Server.Get("/protected")
    protected: fn(self, req: HTTPRequest) -> HTTPResponse HTTPError! {
        cookie: req.header("cookie") ?? return Ok(battery.status_response(401, "login required"))
        session_id: self.state.guard_read().value.session_id
        status: battery.protected_status(session_id, cookie)
        if status != 200 -> return Ok(battery.status_response(status, "login required"))
        Ok(battery.ok_response("protected orders"))
    }
}

run: fn() {
    // Each run migrates and seeds its own database file, so concurrent runs
    // never share rows and every status below is deterministic.
    dir: files.temp_dir("web-battery") ?? panic("no temp directory")
    db_path: files.join(dir.path, "orders.sqlite")
    _migration: battery.migrate_orders(db_path) ?? panic("migration failed")
    _reset: battery.reset_orders(db_path) ?? panic("reset failed")
    seeded_count: battery.seed_orders(db_path) ?? panic("seed failed")

    _app_graph: app_graph()
    _page: battery.ssr_orders_page(seeded_count, "alice")
    print("route-list:{battery.order_list_path(3)}")
    print("route-detail:{battery.order_detail_path(1)}")
    decoded_limit: battery.decode_limit("/orders/1?limit=3") ?? panic("limit not decoded")
    print("query-decode:{decoded_limit}")
    print("route-report:{battery.route_report("/orders/1?limit=3")}")
    print("form-valid:{battery.validate_order_form("pen", "3").valid}")
    print("form-invalid:{battery.form_error_display("", "0")}")
    print("query:{battery.query_report(db_path)}")
    print("island:{battery.island_props(seeded_count, "alice")}")
    print("register:{battery.register_demo_user()}")
    print("login-ok:{battery.login_status("alice", "argon2id:demo")}")
    print("login-failure:{battery.login_status("alice", "wrong")}")

    login_state: battery.login_state("alice", "argon2id:demo") ?? panic("login failed")
    state: Shared{RouteState{cache_version: 0, session_id: login_state.session_id}}
    print("protected-ok:{battery.protected_status(login_state.session_id, login_state.cookie)}")
    print("protected-failure:{battery.protected_status("missing", "")}")

    listener: net.tcp_listen("127.0.0.1:0")
    addr: listener.local_addr()
    // Each route is registered once: the tagged methods of the mounted
    // `Orders` value, plus the static assets (`public/`, relative to the
    // project directory the example runs in).
    mux: core_web.app()
    mux.mount(Orders{path: db_path, state: state})
    mux.static_files("/assets", "public")
    task_handle: task {
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
    }

    home: client.get("http://{addr}/")
    print("home:{home.status()}")
    // Redirects are not followed here, so the 303 and its location show.
    redirected: client.request("GET", "http://{addr}/old").redirects(0).send()
    print("redirect:{redirected.status()}:{redirected.header("location") ?? "missing"}")
    listed: client.get("http://{addr}/orders?limit=3")
    print("list-before:{listed.status()}:{listed.body().text(8192) ?? "bad"}")
    created_request: client.request("POST", "http://{addr}/orders").form("item", "pen").form("quantity", "3")
    created: created_request.send()
    print("create:{created.status()}")
    listed_after: client.get("http://{addr}/orders")
    print("list-after:{listed_after.status()}:{listed_after.body().text(8192) ?? "bad"}")
    detail: client.get("http://{addr}/orders/1")
    protected_failure_request: client.get("http://{addr}/protected")
    print("protected-failure-http:{protected_failure_request.status()}")
    print("detail:{detail.status()}")
    login_request: client.request("POST", "http://{addr}/login").json(Login{user: "alice", password: "argon2id:demo"})
    logged: login_request.send()
    set_cookie: logged.header("set-cookie") ?? return
    print("login:{logged.status()}:cookie={set_cookie.starts_with("jet_session=")}")
    protected_request: client.request("GET", "http://{addr}/protected").cookie("jet_session", state.guard_read().value.session_id)
    protected_response: protected_request.send()
    print("protected:{protected_response.status()}")
    asset: client.get("http://{addr}/assets/index.html")
    print("asset:{asset.status()}:{asset.body().text(8192) ?? "bad"}")
    task_handle.join() ?? panic("server task failed")
}
