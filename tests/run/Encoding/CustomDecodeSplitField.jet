// A hand-written Decode that splits its text into a list runs when the
// type is a field of a structurally decoded struct, on every tier.
use json: core.encoding.json

Handle: struct {
    name: String
    host: String

    impl Decode {
        decode: fn(tree: Dyn) -> Handle [FieldError]! {
            text: tree.text()
            parts: text.split("@").to_list()
            return Ok(Handle{name: parts[0], host: parts[1]})
        }
    }
}

Account: struct {
    owner: Handle
}

account: fn(label: String, raw: String) {
    value: json.decode<Account>(raw) ?? {
        print("account {label}: {err}")
        return
    }
    print("account {label}: {value.owner.name} at {value.owner.host}")
}

run: fn() {
    account("custom wins", "{{\"owner\":\"ada@lovelace.org\"}}")
}
