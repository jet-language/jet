// Fixed-width Reader reads load in place at the handle's position: every
// width, sign and byte order in sequence, the exact-fit boundary, and a
// short read that reports its error without moving the position.
values: fn(r: Reader) -> Int Err! {
    total := 0
    total += Int{r.read_u8()}
    total += Int{r.read_i8()}
    total += Int{r.read_u16_le()} + Int{r.read_u16_be()}
    total += Int{r.read_i16_le()} + Int{r.read_i16_be()}
    total += Int{r.read_u32_le()} + Int{r.read_u32_be()}
    total += Int{r.read_i32_le()} + Int{r.read_i32_be()}
    total
}

run: fn() {
    ints: Reader.over([U8]{0xFF, 0xFF, 0x01, 0x02, 0x01, 0x02, 0xFE, 0xFF, 0xFF, 0xFE, 0x01, 0x02, 0x03, 0x04, 0x01, 0x02, 0x03, 0x04, 0xFF, 0xFF, 0xFF, 0x80, 0x80, 0x00, 0x00, 0x01})
    print(values(ints) ?? -1)
    print(ints.is_at_end())

    wide: Reader.over([U8]{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x88, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x88, 0x88, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x88, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01})
    print(wide.read_u64_le() ?? 0)
    print(wide.read_i64_le() ?? 0)
    print(wide.read_u64_be() ?? 0)
    print(wide.read_i64_be() ?? 0)

    floats: Reader.over([U8]{0x00, 0x00, 0xC0, 0x3F, 0x3F, 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x40, 0x40, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00})
    print(floats.read_f32_le() ?? 0.0)
    print(floats.read_f32_be() ?? 0.0)
    print(floats.read_f64_le() ?? 0.0)
    print(floats.read_f64_be() ?? 0.0)

    edge: Reader.over([U8]{0x2A, 0x10, 0x20, 0x30, 0x40})
    print(edge.peek() ?? 0)
    print(edge.peek() ?? 0)
    print(edge.read_u8() ?? 0)
    if edge.read_u32_be() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> print(error)
    }
    print(edge.read_u16_le() ?? 0)
    print(edge.remaining())
    print(edge.read_u8() ?? 0)
    if edge.peek() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> print(error)
    }
    print(edge.read_u16_le() ?? 7)

    short: Reader.over([U8]{0x01, 0x02, 0x03})
    if short.read_u32_le() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> print(error)
    }
    print(short.remaining())
    print(short.read_u16_be() ?? 0)
    print(short.read_i8() ?? 0)
    if short.read_f64_le() == {
        .Ok(value) -> { print(value) }
        .Err(error) -> print(error)
    }

    sum := 0
    pairs: Reader.over([U8]{0x01, 0x00, 0x02, 0x00, 0x03})
    loop {
        pair: pairs.read_u16_le() ?? break
        sum += Int{pair}
    }
    print("{sum} {pairs.remaining()}")
}
