// `:Fixed(n)`, `:Grouped(n)`, fmt.decimal and fmt.grouped round the exact
// binary value of a Float at n decimals, half away from zero (owner ruling
// 2026-10-05, #4588; #5072 c24). A negative value keeps its sign when it
// rounds to zero (-0.004 prints "-0.00", as Rust, JS and Python do; #5072
// c51); -0.0 prints unsigned. 2.675 is stored as
// 2.67499999999999982236431605997495353221893310546875, so it prints 2.67,
// while an exact tie such as 0.125 or 62.5 rounds away from zero. The rows
// cover values on both sides of a half, exact ties, negatives, -0.0, values
// past 2^52 and 1e21, the smallest subnormal, and more than 22 places.
use fmt: core.text.fmt

same: fn(label: String, selector: String, call: String) -> String {
    if selector != call -> panic("{label}: selector |{selector}| but call |{call}|")
    selector.copy()
}

run: fn() {
    zero := [Float]{0.5, 1.5, 2.5, -2.5, 62.5, -0.4, -0.0, 0.49999999999999994, 4503599627370495.5, 9007199254740993.0, 1e21, 1.5e300}
    loop x in zero {
        text: same("{x}:Fixed(0)", "{x:Fixed(0)}", fmt.decimal(x, 0))
        grouped: same("{x}:Grouped(0)", "{x:Grouped(0)}", fmt.grouped(x, 0))
        print("{x} :Fixed(0) {text} :Grouped(0) {grouped}")
    }
    one := [Float]{1.45, -1.45, 0.05, 0.25, -0.25, 0.35, 2.675, 1e21, 123456.75}
    loop x in one {
        text: same("{x}:Fixed(1)", "{x:Fixed(1)}", fmt.decimal(x, 1))
        grouped: same("{x}:Grouped(1)", "{x:Grouped(1)}", fmt.grouped(x, 1))
        print("{x} :Fixed(1) {text} :Grouped(1) {grouped}")
    }
    two := [Float]{2.675, -2.675, 0.125, -0.125, 1.005, 1.255, 0.285, 8.345, 0.045, -0.005, -0.004, -0.0001, -0.0, 5e-324, 1234567.125, 1e22, 0.1}
    loop x in two {
        text: same("{x}:Fixed(2)", "{x:Fixed(2)}", fmt.decimal(x, 2))
        grouped: same("{x}:Grouped(2)", "{x:Grouped(2)}", fmt.grouped(x, 2))
        print("{x} :Fixed(2) {text} :Grouped(2) {grouped}")
    }
    many := [Float]{0.1, 2.675, 1.0 / 3.0, -0.000000000000000000000001}
    loop x in many {
        text: same("{x}:Fixed(25)", "{x:Fixed(25)}", fmt.decimal(x, 25))
        print("{x} :Fixed(25) {text}")
    }
    print("literal 2.675:Fixed(2) {Float{2.675}:Fixed(2)}")
    print("literal 1.45:Fixed(1) {Float{1.45}:Fixed(1)}")
    print("literal 62.5:Fixed(0) {Float{62.5}:Fixed(0)}")
    print("literal 0.125:Fixed(2) {Float{0.125}:Fixed(2)}")
    print("literal -2.5:Fixed(0) {Float{-2.5}:Fixed(0)}")
}
