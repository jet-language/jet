// The example links one local C adapter and the system
// zlib dependency, then uses a Rust crate bridge in the same executable.
// `jet build` compiles the adapter in native/ from source. From the
// repository root, build and run the executable with:
//   jet build tests/run/Foundations/Bridges/run.jet
//   ./build/run
// The compiler binds native/zreader.h when its cache is missing or stale; to
// refresh the checked binding by hand:
//   jet inspect bind tests/run/Foundations/Bridges/native/zreader.h
name: "foundation_bridges"
version: "0.1.0"
edition: "2026"
authority: {
    allow: [Exec, FFI, IO, Mem.Alloc],
}
deps: {
    zreader: c@"native",
    z: c@nixpkgs:pkgsStatic.zlib,
}
