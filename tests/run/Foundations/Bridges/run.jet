// One executable crosses two native boundaries.  The C
// adapter owns a gzFile-backed reader and returns an explicit handle; Jet owns
// that handle until the matching close call.  zlibVersion is a direct C import,
// while b64encode is a real Rust-crate bridge. The adapter's header binds on a
// cache miss: `.jet/bindings/c/zreader.jet` is generated from native/zreader.h.
use {
    zl: c.z
    z: "native/zreader.h"
}

#Import c.z: module {
    zlibVersion: fn() -> String = "zlibVersion"
}

extern rust "base64@0.22" {
    b64encode: fn(s: String) -> String = "base64::encode"

}

run: fn() {
    handle := z.jet_z_open("tests/run/Foundations/Bridges/sample.txt.gz")
    if handle == 0 -> panic("zlib reader could not open sample")
    first: z.jet_z_read_count(handle)
    print(first)
    print(zl.zlibVersion())
    second: z.jet_z_read_count(handle)
    print(second)
    z.jet_z_close(handle)

    print(b64encode("rust bridge file marker"))
}
