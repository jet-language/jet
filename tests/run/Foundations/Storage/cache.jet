use {
    fs: core.files
    crypto: core.crypto
}

cache_key: fn(value: String) -> String { crypto.sha256(value.bytes()).hex() }

cache_store: fn(root: Path, value: String) -> String {
    fs.create_dir_all(root) ?? panic("cache root")
    key: cache_key(value)
    target: root.join(key)
    if !fs.exists(target) {
        fs.write_atomic(target, value.bytes()) ?? panic("cache write")
        fs.fsync(target) ?? panic("cache fsync")
    }
    return key
}

cache_load: fn(root: Path, key: String) -> String? {
    target: root.join(key)
    if !fs.exists(target) -> return .None
    return Val(fs.read(target) ?? "")
}
