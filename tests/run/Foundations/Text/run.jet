use {
    files: core.files
    process: core.process
    re: core.regex
    text: core.text
    time: core.time
}

BPEModel: struct {
    merges: [String]
    words: Int
    tokens: Int
}

ScanResult: struct {
    bytes: Int
    lines: Int
    matches: Int
    millis: Int
}

pair_key: fn(left: String, right: String) -> String { "{left}|{right}" }

merge_sequence: fn(sequence: [String], key: String) -> [String] {
    pieces: key.split("|").to_list()
    left: pieces.get(0) ?? ""
    right: pieces.get(1) ?? ""
    merged: "{left}{right}"
    result := [String]{}
    index := 0
    loop index < sequence.len() {
        current: sequence.get(index) ?? ""
        next: sequence.get(index + 1) ?? ""
        if {
            index + 1 < sequence.len() && pair_key(current, next) == key -> {
                result.push(merged.copy())
                index += 2
            }
            else -> {
                result.push(current)
                index += 1
            }
        }
    }
    return result
}

train_bpe: fn(corpus: String) -> BPEModel {
    words: text.words(corpus)
    sequences := [[String]]{}
    loop word in words -> sequences.push(text.graphemes(word))
    merges := [String]{}
    loop _round in 0..<12 {
        counts := [String:Int]{}
        loop sequence in sequences {
            if sequence.len() > 1 {
                loop index in 0..<(sequence.len() - 1) {
                    left: sequence.get(index) ?? ""
                    right: sequence.get(index + 1) ?? ""
                    key: pair_key(left, right)
                    counts[key] = (counts.get(key) ?? 0) + 1
                }
            }
        }
        best := ""
        best_count := 0
        loop (key, count) in counts {
            if count > best_count {
                best = key
                best_count = count
            }
        }
        if best_count == 0 -> break
        merges.push(best.copy())
        next_sequences := [[String]]{}
        loop sequence in sequences -> next_sequences.push(merge_sequence(sequence, best))
        sequences = next_sequences
    }
    token_count := 0
    loop sequence in sequences -> token_count += sequence.len()
    return BPEModel{merges: merges, words: words.len(), tokens: token_count}
}

encode_text: fn(source: String, model: BPEModel) -> [String] {
    encoded := [String]{}
    loop word in text.words(source) {
        sequence := text.graphemes(word)
        loop merge in model.merges -> sequence = merge_sequence(sequence, merge)
        loop token in sequence -> encoded.push(token)
    }
    return encoded
}

// A 256 KiB corpus and a 25 MB log keep every tier of this golden row under a
// few seconds; the sizes still exercise BPE training and a mapped line scan.
corpus_fixture: fn() -> String {
    target: 262_144
    seed: "Hello café नमस्ते سلام — Jet text views\n"
    seed_bytes: text.byte_count(seed)
    repeats: target /% seed_bytes
    body: seed.repeat(repeats)
    remaining: target - text.byte_count(body)
    return "{body}{"x".repeat(remaining)}"
}

write_log_fixture: fn(path: Path) -> Int {
    base: "INFO request user_id=1\nWARN request user_id=2\nERROR request user_id=42\n"
    base_bytes: text.byte_count(base)
    block_size: 1000
    padding: "{"X".repeat(block_size - base_bytes - 1)}\n"
    block: "{base}{padding}"
    if text.byte_count(block) != block_size -> panic("log fixture block size")
    blocks: 25_000
    files.write(path, block.repeat(blocks)) ?? panic("write 25 MB log fixture")
    files.fsync(path) ?? panic("fsync 25 MB log fixture")
    return blocks
}

scan_logs: fn(path: Path) -> ScanResult {
    mapped: files.map(path) ?? panic("map log fixture")
    pattern: re.compile("ERROR .* user_id=\\d+") ?? panic("compile log pattern")
    started: time.instant()
    line_count := 0
    match_count := 0
    loop line in mapped.lines() {
        line_count += 1
        value: String.from_bytes(line.copy()) ?? panic("decode mapped log line")
        if re.is_match(pattern, value) -> match_count += 1
    }
    return ScanResult{
        bytes: mapped.len(),
        lines: line_count,
        matches: match_count,
        millis: started.elapsed_millis(),
    }
}

// The typed HarfBuzz handle remains gated by. This example
// still performs real shaping through the audited `hb-shape` process boundary.
discover_font: fn(language: String) -[Exec, Time.Wait]> String? {
    spec: process.cmd(["fc-match", "-f", "%{{file}}", "sans:lang={language}"])
        .stdout(.Capture)
        .stderr(.Capture)
    result: process.run_spec(spec) ?? return None
    if !result.success -> return None
    font: result.output.trim()
    if font.len() == 0 -> return None
    return Val(font)
}

shape_with_harfbuzz: fn(font: String, sample: String) -[Exec, Time.Wait]> String {
    spec: process.cmd(["hb-shape", "--output-format=json", font, sample])
        .stdout(.Capture)
        .stderr(.Capture)
    result: process.run_spec(spec) ?? return "unavailable:hb-shape"
    if !result.success -> return "unavailable:hb-shape"
    return result.output.trim()
}

run: fn() {
    corpus: corpus_fixture()
    corpus_bytes: text.byte_count(corpus)
    bpe_started: time.instant()
    model: train_bpe(corpus)
    bpe_millis: bpe_started.elapsed_millis()
    sample_tokens: encode_text("Hello café नमस्ते سلام", model)
    if corpus_bytes != 262_144 -> panic("corpus fixture size")
    if model.merges.len() != 12 -> panic("BPE did not run twelve rounds")
    if sample_tokens.len() == 0 -> panic("BPE encoder returned no tokens")
    // Elapsed times vary per host; the example measures them but prints only
    // the deterministic facts.
    if bpe_millis < 0 -> panic("BPE clock ran backwards")
    print("bpe bytes={corpus_bytes} words={model.words} merges={model.merges.len()} tokens={model.tokens} sample_tokens={sample_tokens.len()}")

    segmented: "Café 👨‍👩‍👦. Привет κόσμε नमस्ते سلام! One. Two?"
    graphemes: text.graphemes(segmented).len()
    words: text.words(segmented).len()
    sentences: text.sentences(segmented).len()
    normalized: text.nfc("Café")
    caseless: text.caseless_eq("Straße", "STRASSE")
    if graphemes == 0 || words == 0 || sentences == 0 {
        panic("text segmentation returned no units")
    }
    if normalized != "Café" -> panic("NFC normalization")
    if !caseless -> panic("Unicode caseless comparison")
    print("segments bytes={text.byte_count(segmented)} scalars={text.scalar_count(segmented)} graphemes={graphemes} words={words} sentences={sentences}")
    print("normalized={normalized}")
    print("casefold_equal={caseless}")

    scratch: files.temp_dir("jet-foundation-text") ?? panic("text temp dir")
    log_path: Path.from(scratch.path).join("logs_25m.txt")
    expected_matches: write_log_fixture(log_path)
    scan: scan_logs(log_path)
    if scan.bytes != 25_000_000 -> panic("25 MB scan size")
    if scan.matches != expected_matches -> panic("streaming scan match count")
    if scan.millis < 0 -> panic("scan clock ran backwards")
    print("scan bytes={scan.bytes} lines={scan.lines} matches={scan.matches}")

    // Shaping uses the host's fonts and HarfBuzz build, so glyph ids differ
    // per host: the example checks that a present shaper returns glyph JSON.
    arabic_font: discover_font("ar") ?? ""
    devanagari_font: discover_font("hi") ?? ""
    arabic_shape: if arabic_font == "" -> "unavailable:font" else -> shape_with_harfbuzz(arabic_font, "سلام")
    devanagari_shape: if devanagari_font == "" -> "unavailable:font" else -> shape_with_harfbuzz(devanagari_font, "नमस्ते")
    if !arabic_shape.starts_with("unavailable:") && !arabic_shape.starts_with("[") -> panic("Arabic shaping returned no glyph JSON")
    if !devanagari_shape.starts_with("unavailable:") && !devanagari_shape.starts_with("[") -> panic("Devanagari shaping returned no glyph JSON")
    print("shape_arabic=checked")
    print("shape_devanagari=checked")
    print("text_probe_complete")
}
