use {
    build_api: core.build
    compiler: core.compiler
}

SOURCE: #run "old_name: fn(value: Int) -> Int {{ 41 }}\nrun: fn() -> Int {{ 2 }}\n"

LEXED: #run { compiler.lex(SOURCE) ?? panic("compiler lex failed") }

PARSED: #run { compiler.parse(SOURCE) ?? panic("compiler parse failed") }

CHECKED: #run { compiler.check(PARSED) ?? panic("compiler check failed") }

TOKENS: #run LEXED.tokens().len()

ITEMS: #run PARSED.items().len()

FUNCTIONS: #run CHECKED.functions().len()

build: fn(b: Build) {
    b.generate("facts") {
        tooling_facts: fn() -> String { "tokens={TOKENS}; items={ITEMS}; functions={FUNCTIONS}" }
    }

    before: b.add_executable(
    "tooling_before",
    ["run.jet"],
    [],
    )
    before_plan: b.plan(before)
    before_graph: build_api.graph(before_plan)

    after: b.add_executable(
    "tooling_after",
    ["run.jet", "input.jet"],
    [],
    )
    after_plan: b.plan(after)
    after_graph: build_api.graph(after_plan)
    diff: build_api.receipt_diff(before_graph, after_graph)

    if before_graph.targets.len() == 0 -> panic("build graph query returned no target")
    if after_graph.files.len() <= before_graph.files.len() {
        panic("build graph query lost source files")
    }
    if diff.file_deltas.len() == 0 && diff.key_deltas.len() == 0 {
        panic("build graph diff was empty")
    }

    b.default(after)
}

run: fn() {
    print("compiler facts: tokens={TOKENS}; items={ITEMS}; functions={FUNCTIONS}")
    print("build graph: graph=checked; diff=checked")
}
