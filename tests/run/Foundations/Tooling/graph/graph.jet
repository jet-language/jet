build: fn(b: Build) -[IO]> {
    #Impure("build action writes declared output") {
        shell: b.probe("shell", "find_program", "sh")
        action: b.run("stamp", b.found(shell), ["IO"])
        action.arg("-c")
        action.arg("printf graph2 > stamp.txt")
        action.reads("graph.jet")
        action.writes("stamp.txt")
        app: b.add_executable("graph_probe", ["graph.jet"], [action])
        b.default(app)
    }
}

run: fn() { print("graph probe") }
