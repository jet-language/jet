// Meter, centimeter, the canonical Time
// Duration, Speed, Acceleration, and Hertz below come from the shipped
// #UnitFamily declarations in Prelude/Units.jet. No parallel struct-based
// units are introduced here.
acceleration_for: fn(distance: Meter, elapsed: Duration) -> MeterPerSecondSquared {
    return distance / elapsed / elapsed
}

// #2776: keep this real cross-file fallible boundary in the example. The
// native lowering ICE is a compiler gate, not a reason to replace it with a
// non-fallible or simulated provider.
checked_meters_add: fn(left: Meter, right: Meter) -> Meter Err! {
    sum: left + right
    if !sum.raw().is_finite() -> return Err("meter sum is not finite")
    return Ok(sum)
}

speed_after: fn(acceleration: MeterPerSecondSquared, elapsed: Duration) -> MeterPerSecond {
    return acceleration * elapsed
}

distance_after: fn(speed: MeterPerSecond, elapsed: Duration) -> Meter { return speed * elapsed }
