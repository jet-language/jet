use json: core.encoding.json

#Codable
PackageRow: struct {
    name: String
}

#Codable
ListReport: struct {
    schema: String
    packages: [PackageRow]
}

list_json: fn() -> String {
    return json.to_string(ListReport{
        schema: "jet.report/v1",
        packages: [PackageRow{name: "jet"}]
    })
}
