use json: core.encoding.json

#Codable
ListReport: struct {
    schema: String
    status: String

    label: fn(self) -> String { self.status }
}

list_json: fn(status: String) -> String {
    return json.to_string(ListReport{schema: "jet.report/v1", status: status})
}

mk: fn() -> ListReport { ListReport{schema: "jet.report/v1", status: "ok"} }

round_trip: fn(wire: String) -> String {
    report: json.decode<ListReport>(wire) ?? panic("declaring module decode")
    return report.status
}
