

Shape: trait {
    area: fn(self) -> Float
}

Circle: struct {
    radius: Float

    impl Shape {
        area: fn(self) -> Float { self.radius * self.radius }
    }
}

Square: struct {
    side: Float

    impl Shape {
        area: fn(self) -> Float { self.side * self.side }
    }
}

run: fn() {
    shapes: [Shape]{Circle{radius: 2.0}, Square{side: 3.0}}
    loop shape in shapes -> print(shape.area())
    print(shapes.len())
}
