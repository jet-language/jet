// An enum match whose subject is used after the match: each payload binding
// reads its payload, the subject stays whole, and no arm copies (or leaks)
// the whole subject, matched or not.
Blob: struct {
    data: [Int]
    text: String
}

Node: enum {
    Leaf(blob: Blob)
    Other(blob: Blob)
    Empty
}

run: fn() {
    node: Node.Leaf{blob: Blob{data: [Int]{1, 2, 3}, text: "leaf"}}
    total := 0
    loop k in 0..<4 {
        if node == {
            .Leaf(blob) -> total += blob.data.len()
            .Other(_) | .Empty -> total += 100
        }
        if node == {
            .Other(blob) -> total += blob.data.len() * 1000
            .Leaf(_) | .Empty -> total += 1
        }
    }
    if node == {
        .Leaf(blob) -> print("after {blob.text} {total}")
        .Other(_) | .Empty -> print("empty {total}")
    }
}
