// S31: outside an `if` condition a pattern test is a Bool value, and a name
// in its pattern is a fresh binding that nothing can read. It never compares
// against an outer binding: `root == .Val(other)` is true for any present
// value, and reusing a name that already holds a value there is E0118.
// Compare with a value by writing a parenthesized payload,
// `root == Val((name))`.
Shape: enum {
    Circle(Int)
    Pair(left: Int, right: Int)
}

even_successor: fn(n: Int) -> Int Err! {
    if n % 2 != 0 -> return Err("odd")
    Ok(n + 1)
}

same_label_pattern: fn(label: String?, root: String?) -> Bool {
    if label == .Val(name) -> return name != "" && root == .Val(other)
    false
}

same_label_value: fn(label: String?, root: String?) -> Bool {
    if label == .Val(name) -> return root == Val((name))
    false
}

is_present: fn(value: Int?) -> Bool {
    value == .Val(found)
}

is_pair: fn(shape: Shape) -> Bool {
    shape == .Pair(left, right)
}

is_even: fn(n: Int) -> Bool {
    even_successor(n) == .Ok(value)
}

run: fn() {
    print(same_label_pattern(Val("outer"), Val("inner")))
    print(same_label_pattern(Val("outer"), None))
    print(same_label_value(Val("outer"), Val("inner")))
    print(same_label_value(Val("outer"), Val("outer")))
    print(is_present(Val(3)))
    print(is_present(None))
    print(is_pair(Shape.Pair{left: 1, right: 2}))
    print(is_pair(Shape.Circle(1)))
    print(is_even(4))
    print(is_even(3))
}
