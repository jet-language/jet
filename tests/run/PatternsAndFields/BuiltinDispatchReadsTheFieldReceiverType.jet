ScanEntry: struct {
    relative: String
    marks: [Int]
}
run: fn() {
    entry := ScanEntry{ relative: "a-b-c", marks: [1, 2, 1] }
    print(entry.relative.replace("-", "/"))
    print(entry.relative.len())
    print(entry.marks.replace(2, 9))
    print(entry.marks)
    plain := [1, 2, 1]
    print(plain.replace(2, 9))
    print(plain)
}
