
flatten_words: fn(contents: String) -> [String] {
    return contents.lines().map(fn(line: String) { line.split(" ").to_list() }).flatten()
}
flatten_string_rows: fn() -> [String] { [[String]]{{"red"}, {"blue", "green"}}.flatten() }
run: fn() {
    words: flatten_words("one two\nthree four")
    neighbors: flatten_words("five six")
    rows: flatten_string_rows()
    print(words.len())
    print(words[0])
    print(words[3])
    print(neighbors[1])
    print(rows[2])
}
