package: {
    name: "tooling_data_stream_bounds"
    version: "0.1.0"
    authority: { allow: [FS, IO, Mem.Alloc] }
}

// Bounded typed pull stream + typed DataError.
use {
    data: core.data
    files: core.files
    stream: core.data.stream
    testing: core.testing
}
#Codable
Event: struct {
    service: String
    latency_ms: Float
}

run: fn() {
    root: testing.temp_dir("jet-data-stream-bounds")
    path: Path.from(root).join("events.csv").to_string()
    files.write(path, "service,latency_ms\napi,10.0\napi,20.0\ndb,5.0\napi,30.0\n") ?? panic("write")
    input: files.open(path) ?? panic("open")
    limits := data.DataLimits.safe()
    limits.max_groups = 1
    limits.max_output_rows = 10
    reader := data.csv_reader<Event>(input, limits) ?? panic("reader")
    first: stream.next(reader) ?? panic("next")
    print("first: {first.service} {first.latency_ms}")
    // The query reads the rest of the stream under the reader's limits, so
    // grouping two services past `max_groups 1` refuses.
    if data.query(reader)
        .group_by(fn(e) { e.service })
        .mean(fn(e) { e.latency_ms })
        .collect() == {
        .Ok(grouped_rows) -> { print("unexpected ok {grouped_rows.len()}") }
        .Err(error) -> { print("{error}") }
    }
    if data.mean([Float]{}) == {
        .Ok(v) -> { print("unexpected mean {v}") }
        .Err(error) -> { print("{error}") }
    }
    if data.quantile([1.0, 2.0], 1.5) == {
        .Ok(v) -> { print("unexpected q {v}") }
        .Err(error) -> { print("{error}") }
    }
}
