// An enum whose variants differ in width boxes each value at its own
// variant's size: construction, recursive edges, copies, List moves,
// replacement and drops all keep each box's size. Every way a place takes
// another variant gives it a new box: a write parameter's assignment, a swap
// through write parameters, a write window into a payload, a field
// assignment, a write into a comptime constant's copy, and List moves.
Node: enum {
    Leaf
    Num(Int)
    Name(String)
    Pair(left: Node, right: Node)
    Wide(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, label: String, items: [Int])
}

Holder: struct {
    node: Node
    tag: Int
}

SEED: #run make(1)

make: fn(i: Int) -> Node {
    if i % 5 == {
        0 -> Node.Leaf
        1 -> Node.Num(i)
        2 -> Node.Name("n{i}")
        3 -> Node.Pair{left: Node.Num(i), right: Node.Name("ab")}
        else -> Node.Wide{a: 1, b: 2, c: 3, d: 4, e: 5, f: i, label: "wide", items: [Int]{i, 1}}
    }
}

total: fn(n: Node) -> Int {
    if n == {
        .Leaf -> 0
        .Num(v) -> v
        .Name(s) -> s.len()
        .Pair(left, right) -> total(left) + total(right)
        .Wide(a, b, c, d, e, f, label, items) -> {
            sum := a + b + c + d + e + f + label.len()
            loop item in items -> sum += item
            sum
        }
    }
}

widen: fn(n: &Node, i: Int) { n = make(5 * i + 4) }

swap_nodes: fn(a: &Node, b: &Node) {
    held: a.copy()
    a = b.copy()
    b = held
}

widen_left: fn(n: &Node) {
    if &n == {
        .Pair(left, _) -> left = make(9)
        .Leaf | .Num(_) | .Name(_) | .Wide(_, _, _, _, _, _, _, _) -> {}
    }
}

bump: fn(n: &Node) {
    if &n == {
        .Num(v) -> v += 100
        .Leaf | .Name(_) | .Pair(_, _) | .Wide(_, _, _, _, _, _, _, _) -> {}
    }
}

paths: fn() -> Int {
    small := Node.Leaf
    widen(small, 1)
    other := Node.Num(3)
    swap_nodes(small, other)
    pair := make(3)
    widen_left(pair)
    holder := Holder{node: Node.Leaf, tag: 2}
    wide: make(14)
    holder.node = wide
    seeded := SEED
    bump(seeded)
    first: total(seeded)
    seeded = make(19)
    list := [Node]{Node.Leaf, make(24)}
    list.reverse()
    list[1] = make(29)
    first + total(small) + total(other) + total(pair) + total(holder.node) + total(seeded) + total(list[0]) + total(list[1]) + holder.tag
}

run: fn() {
    nodes := [Node]{}
    loop i in 0..<40 -> nodes.push(make(i))
    kept: nodes[3].copy()
    nodes[3] = make(4)
    sum := 0
    loop node in nodes -> sum += total(node)
    print("{sum} {total(kept)}")
    print(paths())
}
