id: fn<T>(x: &&T) -> T {
    return x
}
pick: fn<T>(a: &&T, b: &&T, first: Bool) -> T {
    if first {
        return a
    }
    return b
}
firstof: fn<T>(xs: &&[T]) -> T {
    return xs[0].copy()
}
wrap: fn<T>(x: &&T) -> [T] {
    return [x]
}
run: fn() {
    print("{id(5)}")
    print("{pick(1, 2, true)}")
    print("{firstof([10, 20, 30])}")
    ys: wrap(7)
    print("{ys[0]}")
}
