// core.data.sketch values are plain values (D-COPY-DEFAULT1=A): a copy holds
// its own state, with no handle shared with the original, so adding to one
// leaves the other unchanged. That holds for an unmarked binding of a name
// used again later (hll, cms), which shares until the first write, and for
// an explicit `.copy()` (tdigest, reservoir). A reservoir's copy holds its
// own sampler RNG state too: the same adds after the copy give both the same
// sample.
use {
    hll: core.data.sketch.hll
    tdigest: core.data.sketch.tdigest
    cms: core.data.sketch.cms
    reservoir: core.data.sketch.reservoir
}

run: fn() {
    distinct := hll.new()
    distinct.add("apple")
    more := distinct
    more.add("banana")
    more.add("cherry")
    print("hll: {distinct.count()} {more.count()}")  // 1 3

    digest := tdigest.new()
    digest.add(7.0)
    other := digest.copy()
    other.add(1.0)
    print("tdigest: {digest.quantile(0.5)} {other.quantile(0.5)}")  // 7.0 1.0

    counts := cms.new()
    counts.add("hello")
    twin := counts
    twin.add("hello")
    twin.add("world")
    print("cms: {counts.count("hello")} {counts.count("world")} {twin.count("hello")} {twin.count("world")}")  // 1 0 2 1

    // Past capacity, so the sampler's RNG has run before the copy.
    first: [String]{"a", "b", "c", "d", "e"}
    later: [String]{"f", "g", "h", "i", "j", "k", "l", "m"}
    sampler := reservoir.new(2)
    loop item in first -> sampler.add(item)
    before: sampler.sample()
    fork := sampler.copy()
    loop item in later -> fork.add(item)
    print("reservoir original unchanged: {sampler.sample() == before}")  // true
    loop item in later -> sampler.add(item)
    print("reservoir same adds, same sample: {sampler.sample() == fork.sample()}")  // true
    print("reservoir: {sampler.sample()}")
}
