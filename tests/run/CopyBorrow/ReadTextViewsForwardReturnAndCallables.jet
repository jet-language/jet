
length: fn(text: String) -> Int { text.len() }
forward: fn(text: String) -> Int { length(text) }
owned: fn(text: String) -> String { text.copy() }
apply: fn(callback: fn(String) -> Int, text: String) -> Int { callback(text) }
inspect: fn<T>(_value: T) -> Int { 7 }
generic_forward: fn(text: String) -> Int { inspect(text) }
run: fn() {
    text := "  hello  "
    view: text.trim()
    print(forward(view))
    print(owned(view))
    print(apply(length, view))
    reader: fn(value: String) -> Int { (length(value) + text.len()) }
    print(apply(reader, view))
    print(generic_forward(view))
    print(inspect(text))
    print(inspect("literal"))
}
