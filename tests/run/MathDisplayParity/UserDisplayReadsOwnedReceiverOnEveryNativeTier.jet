Label: struct {
    text: String

    impl Display {
        display: fn(self) -> String { "label:{self.text}" }
    }
}

Envelope: struct {
    text: String
    impl Display {
        display: fn(self) -> String { "envelope:{self.text}" }
    }
}

show: fn(value: Label) {
    print(value)
    print("interpolation:{value}")
    print(value.display())
    print("retained:{value.text}")
}

run: fn() {
    value: Label{text: "kept"}
    show(value)
    print("after:{value.text}")
    nested: Envelope{text: "kept"}
    print("{nested}")
    print(nested.display())
    print("after:{nested.text}")
}
