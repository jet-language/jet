// A bounded type parameter forwarded to another generic with the same bound,
// both with an explicit type argument and with inference.
Shape: trait {
    area: fn(self) -> Int
}

Square: struct {
    side: Int

    impl Shape {
        area: fn(self) -> Int { self.side * self.side }
    }
}

inner: fn<P: Shape>(shape: P) -> Int { shape.area() }

outer_explicit: fn<P: Shape>(shape: P) -> Int { inner<P>(shape) }

outer_inferred: fn<P: Shape>(shape: P) -> Int { inner(shape) }

run: fn() {
    print(outer_explicit(Square{side: 3}))
    print(outer_inferred(Square{side: 3}))
}
