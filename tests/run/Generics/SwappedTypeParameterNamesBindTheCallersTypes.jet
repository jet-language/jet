// A caller whose type parameters reuse the callee's names in the other
// order (`swapped<U, T>` calling `pair<T, U>`) binds each callee parameter
// to the caller's type, not back to the callee's own.
pair: fn<T, U>(a: T, b: U) -> T {
    a
}

second: fn<T, U>(a: T, b: U) -> U {
    b
}

swapped: fn<U, T>(a: U, b: T) -> U {
    pair(a, b)
}

swapped_second: fn<U, T>(a: U, b: T) -> T {
    second(a, b)
}

explicit: fn<U, T>(a: U, b: T) -> U {
    pair<U, T>(a, b)
}

run: fn() {
    print(swapped(1, "x"))
    print(swapped("y", 2))
    print(swapped_second(1, "x"))
    print(swapped_second(true, 3.5))
    print(explicit(7, "z"))
}
