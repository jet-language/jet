// A generic struct literal with no type arguments infers them from its
// written fields, as a call infers them from its arguments.
Top: struct<T> {
    value: T
}

Pair: struct<A, B> {
    first: A
    second: B
    items: [A]
}

run: fn() {
    t: Top{value: 1}
    print(t.value + 1)
    s: Top{value: "hi"}
    print(s.value)
    p: Pair{first: 2, second: "two", items: [Int]{3, 4}}
    print(p.first + p.items[1])
    print(p.second)
}
