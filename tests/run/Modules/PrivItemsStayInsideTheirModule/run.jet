// `priv` hides one declaration. In a module it is usable by
// that module and its children; at the top level of a package, by every file
// of the package (`tidy` lives in tidy.jet); `priv(package)` widens a module's
// item to its whole package.
text: module {
    priv pad: fn(s: String) -> String { "  {s}" }

    priv(package) width: fn() -> Int { 8 }

    banner: fn(s: String) -> String { pad(s) }

    inner: module {
        framed: fn(s: String) -> String { "|{text.pad(s)}|" }
    }
}

run: fn() {
    print(text.banner("hi"))
    print(text.inner.framed("hi"))
    print(text.width())
    print(tidy("x"))
}
