trait Speaker {
    fn say(self, msg: String) -> String
}
struct Voice {
    prefix: String
}
impl Voice.Speaker {
    fn say(self, msg: String) -> String {
        p :: self.prefix
        return "{p}: {msg}"
    }
}
struct Megaphone {
    inner: Voice
}
impl Megaphone.Speaker using inner
fn run() {
    v := Voice{ prefix: "HEY" }
    m := Megaphone{ inner: v }
    print(m.say("go"))
}
