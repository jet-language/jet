struct Point {
    x: Int
    y: Int
}
enum Shape {
    Dot(Point)
    Line(Int)
}
fn mk(p: Point) -> Shape {
    return Shape.Dot(p.copy())
}
fn first(s: Shape) -> Int {
    if s == {
        .Dot(p) -> { return p.x }
        .Line(n) -> { return n }
    }
    return 0
}
fn run() {
    pt :: Point{ x: 3, y: 4 }
    sh :: mk(pt)
    print("{first(sh)}")
}
