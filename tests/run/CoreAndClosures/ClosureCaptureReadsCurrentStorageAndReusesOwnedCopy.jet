
run: fn() {
    first := 41
    first_read: fn() -> Int { first }
    first_items: [first_read]
    print(first_items[0]())
    print(first_items[0]())

    current := 1
    print(current)
    current = 7
    current_read: fn() -> Int { current }
    current_items: [current_read]
    print(current_items[0]())
    print(current)
}
