
run: fn() {
    first := 41
    first_read: fn() { first }
    first_items: [first_read]
    print(first_items[0].call())
    print(first_items[0].call())

    current := 1
    print(current)
    current = 7
    current_read: fn() { current }
    current_items: [current_read]
    print(current_items[0].call())
    print(current)
}
