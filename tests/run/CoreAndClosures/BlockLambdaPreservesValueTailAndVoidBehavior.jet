apply: fn(f: fn(Int) -> Int, x: Int) -> Int {
    return f(x)
}
visit: fn(f: fn(Int), x: Int) {
    f(x)
}
plus_one: fn(x: Int) -> Int {
    return x + 1
}
run: fn() {
    print(apply(fn(n: Int) {
        doubled: (n * 2)
        plus_one(doubled)
    }, 20))
    visit(fn(n: Int) {
        print("seen {n}")
    }, 7)
}
