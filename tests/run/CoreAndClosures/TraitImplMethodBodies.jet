Shape: trait {
    area: fn(self) -> Float
    name: fn(self) -> String
}
Circle: struct {
    radius: Float
    impl Shape {
        area: fn(self) -> Float {
            return ((3.0 * self.radius) * self.radius)
        }
        name: fn(self) -> String {
            return "circle"
        }
    }
}
Square: struct {
    side: Float

    impl Shape {
        area: fn(self) -> Float {
            return (self.side * self.side)
        }
        name: fn(self) -> String {
            return "square"
        }
    }
}
describe: fn(s: Shape) -> String {
    return "{s.name()}: {s.area()}"
}
run: fn() {
shapes: [Shape]{ Circle{radius: 2.0}, Square{side: 3.0} }
    shapes.each(fn(s) {
        print(describe(s))
    })
}
