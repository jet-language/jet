package: {
    name: "functions_never_callback_fits_unit_slot"
    version: "0.1.0"
    authority: { allow: [Exec] }
}

// A callback that never returns (it panics or exits) fits a `fn()` slot:
// `Never` is the bottom type, so the caller's view of the return is never
// observed. Naming a function item as a value copies the reference, so the
// item stays usable after an alias takes it.
use process: core.process

call: fn(f: fn()) { f() }

named: fn() { print("named") }

run: fn() {
    alias: named
    call(named)
    call(alias)
    call(fn() {
        print("exiting")
        process.exit(0)
    })
    print("unreachable")
}
