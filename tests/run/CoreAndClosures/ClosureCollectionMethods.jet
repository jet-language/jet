calc: fn() -> Int {
    base := 10
    nums := [1, 2, 3, 4, 5]
    squares := nums.map(fn(n: Int) { (n * n) })
    big := squares.filter(fn(n: Int) { (n > 5) })
    shifted := nums.map(fn(n: Int) { (n + base) })
    total := nums.reduce(0, fn(acc: Int, n: Int) { (acc + n) })
    has := nums.any(fn(n: Int) { (n > 4) })
    every := nums.all(fn(n: Int) { (n > 0) })
    print(big)
    print(shifted)
    print(has)
    print(every)
    return total
}
run: fn() {
    print(calc())
}
