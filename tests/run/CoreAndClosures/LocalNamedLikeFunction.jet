// A local value wins an unqualified call name. Select the declared function
// explicitly through its module while still reading the same-named local.
labels: module {
    describe: fn(value: Int) -> String {
        "v{value}"
    }
}

label: fn(value: Int) -> String {
    describe: "local"
    "{describe}:{labels.describe(value)}"
}

run: fn() {
    print(label(4))
}
