
fail: fn(message: String) -> Int Err! {
    return Err(message)
}
run: fn() {
    value: fail("outer") ?? {
        print(err.message)
        inner: fail("inner") ?? {
            print(err.message)
            0
        }
        read_outer: () -> err.message
        print(read_outer())
        inner + 1
    }
    print(value)
}
