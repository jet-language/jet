widen: fn(red: U8) -> I64 {
    return I64{red}
}
narrow: fn(channel: I32) -> U8 {
    return checked(U8{channel}) ?? 255
}
to_real: fn(x: Int) -> Float {
    return Float.from_int(x)
}
truncate: fn(x: Float) -> U8 {
    return U8.from_float(x) ?? 255
}
narrow_float: fn(x: Float) -> F32 Err! {
    return F32.from_float(x)
}
run: fn() {
    print(widen(255))
    print(narrow(100))
    print(narrow(100000))
    print(to_real(3))
    print(truncate(42.9))
    print(truncate(300.0))
    print(narrow_float(2.0) ?? F32.from_int(0))
    print(narrow_float(1e100) ?? F32.from_int(-1))
}
