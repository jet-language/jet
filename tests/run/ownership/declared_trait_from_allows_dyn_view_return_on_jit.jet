
trait Slice {
    fn head(self) -[]> View<Int> from self
}

struct Packet {
    data: [Int]
}

impl Packet.Slice {
    fn head(self) -> View<Int> from self { self.data[0..1] }
}

fn first(s: Slice) -[..E]> View<Int> from s {
    return s.head()
}

fn run() {
    boxed :: [Slice]{Packet{ data: [9, 8, 7] }}
    print(first(boxed[0])[0])
}
