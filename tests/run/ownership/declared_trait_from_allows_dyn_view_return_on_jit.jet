
Slice: trait {
    head: fn(self) -[]> View<Int> from self
}

Packet: struct {
    data: [Int]
}

impl Packet.Slice {
    head: fn(self) -> View<Int> from self { self.data[0..1] }
}

first: fn(s: Slice) -[..E]> View<Int> from s {
    return s.head()
}

run: fn() {
    boxed: [Slice]{Packet{ data: [9, 8, 7] }}
    print(first(boxed[0])[0])
}
