
fn run() {
    values := [1, 2, 3, 4]
    parts :: &values.split_write(2) ?? panic("split failed")
    parts.left[0] = 10
    parts.right[1] = 40

    &values.edit_disjoint([0, 2], (left, right) -> {
        left[0] = left[0] + 1
        right[0] = right[0] + 2
    }) ?? panic("edit failed")

    selected :: &values.get_disjoint_write([1, 3]) ?? panic("selection failed")
    loop edit in selected {
        edit[0] = edit[0] + 5
    }
    print(values)
}
