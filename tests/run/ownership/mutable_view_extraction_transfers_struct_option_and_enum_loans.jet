
Edit: struct { values: ViewMut<Int> }
Choice: enum {
    First(ViewMut<Int>)
    Second(ViewMut<Int>)
}

edit: fn(values: &[Int]) -[]> Edit {
    window: &values[0..1]
    return Edit{ values: window }
}

maybe: fn(values: &[Int]) -[]> ViewMut<Int>? {
    window: &values[0..1]
    return Val(window)
}

choose: fn(values: &[Int], first: Bool) -[]> Choice {
    window: &values[0..1]
    if first { return Choice.First(window) }
    return Choice.Second(window)
}

run: fn() {
    struct_values := [1, 2]
    aggregate: edit(struct_values)
    struct_part: aggregate.values
    struct_part[0] = 3
    print(struct_part[0])

    option_values := [4, 5]
    optional: maybe(option_values)
    if optional == Val(option_part) {
        option_part[0] = 6
        print(option_part[0])
    }

    enum_values := [7, 8]
    selected: choose(enum_values, false)
    if selected == {
        .First(enum_part) -> {
            enum_part[0] = 9
            print(enum_part[0])
        }
        .Second(enum_part) -> {
            enum_part[0] = 10
            print(enum_part[0])
        }
    }
}
