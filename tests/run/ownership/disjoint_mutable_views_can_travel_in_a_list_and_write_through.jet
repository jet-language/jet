
edits: fn(values: &[Int]) -[]> [ViewMut<Int>] {
    first: &values[0..1]
    second: &values[2..3]
    return [first, second]
}

run: fn() {
    values := [7, 8, 9, 10]
    selected: edits(values)
    selected[0][0] = 11
    selected[1][0] = 12
    print(selected[0][0])
    print(selected[1][0])
}
