Profile: struct {
    handle: (String?)
}
Account: struct {
    details: Profile
}
handle_of: fn(a: (Account?)) -[]> (String?) {
    return a?.details?.handle
}
run: fn() {
    p: Profile{ handle: Val("jay") }
    acct: Account{ details: p }
    print(handle_of(Val(acct)) ?? "none")
    print(handle_of(None) ?? "none")
}
