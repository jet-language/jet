
fn run() {
    value :: 2
    v :: 3
    k :: "apple"
    item :: 0
    i :: 9
    if i < 0 {
        print(item)
    }
    xs := [value, v]
    xs[1] = value
    loop (list_index, list_item) in xs {
        print("{list_index}:{list_item}")
    }
    counts := [String:Int]{}
    counts[k] = value
    loop (map_key, map_value) in counts {
        print("{map_key}={map_value}")
    }
}
