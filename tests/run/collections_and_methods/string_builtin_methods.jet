fn run() {
    s := "  Hello, World  "
    t := s.trim()
    print(t.to_upper())
    print(t.to_lower())
    print(t.len())
    print(t.starts_with("Hello"))
    print(t.ends_with("World"))
    print(t.replace("World", "Jet"))
    print("ab".repeat(3))
    print(t.contains("World"))
    parts := "a,b,c".split(",")
    print(parts.len())
}
