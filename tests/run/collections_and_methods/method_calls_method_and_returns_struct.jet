struct Vec2 {
    x: Int
    y: Int

    fn make(x: Int, y: Int) -[]> Vec2 {
        return Vec2{ x: x, y: y }
    }
    fn sum(self) -[]> Int {
        return (self.x + self.y)
    }
    fn shifted(self, dx: Int) -[]> Vec2 {
        return Vec2{ x: (self.x + dx), y: self.y }
    }
}
fn run() {
    p :: Vec2.make(3, 4)
    q :: p.shifted(10)
    print(q.sum())
}
