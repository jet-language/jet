Sign: enum {
    Pos
    Neg
    Zero

    make_pos: fn() -[]> Sign {
        return Sign.Pos
    }
    to_num: fn(self) -[]> Int {
        if self == {
            .Pos -> { return 1 }
            .Neg -> { return 0 }
            .Zero -> { return 0 }
        }
    }
}
run: fn() {
    s: Sign.make_pos()
    print(s.to_num())
}
