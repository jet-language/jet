#Error
ParseError: enum {
    Empty
    BadDigit(Int)
}
parse_age: fn(raw: Int) -> Int ParseError! {
    if raw == 0 {
        return Err(ParseError.Empty)
    }
    if raw == 1 {
        return Err(ParseError.BadDigit(raw))
    }
    return Ok((raw * 2))
}
load: fn(raw: Int) -> Int ParseError! {
    n: parse_age(raw)
    return Ok((n + 1))
}
run: fn() {
    a: load(21) ?? 0
    print(a)
    b: load(0) ?? 99
    print(b)
}
