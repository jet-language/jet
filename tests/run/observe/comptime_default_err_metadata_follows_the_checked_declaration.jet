// The default Err lowers from its checked Prelude declaration in compile-time
// evaluation too: comptime code builds fresh errors, converts with `?` and a
// context frame and copies them, and a comptime Err (fresh, or the failure
// of a fallible call) reaches the program with its message, code, cause and
// the metadata its conversion and context frame recorded.
impl IOError -> Err {
    return Err("store unavailable", code: "E_STORE")
}

read_store: fn() -> Int IOError! {
    return Err(IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: None,
        os_code: None,
        cause: Val("disk offline"),
    }))
}

get_user: fn() -> Int Err! {
    value: read_store()?("loading store")
    value
}

fresh_errors: fn() -> String {
    literal: Err{message: "plain", code: Val("E1"), cause: None}
    call: Err("plain", code: "E1")
    caused: Err{message: "outer", code: None, cause: Val(Err("inner"))}
    inner: caused.cause ?? Err("none")
    "{literal == call} {literal.message} {literal.code ?? "none"} {literal.cause == None} {inner.message}"
}

kept_errors: fn() -> String {
    if get_user() == .Err(failed) {
        kept: failed.copy()
        bare: Err("store unavailable", code: "E_STORE")
        return "{kept == failed} {kept == bare} {kept.message} {kept.code ?? "none"}"
    }
    "no error"
}

failure: fn() -> Err {
    if get_user() == .Err(failed) -> return failed
    Err("no error")
}

FRESH: comptime { fresh_errors() }
KEPT: comptime { kept_errors() }
VALUE: comptime { Err{message: "outer", code: Val("E1"), cause: Val(Err("inner"))} }
FAILED: comptime { failure() }

run: fn() {
    print(FRESH)
    print(KEPT)
    print(VALUE.message)
    print(VALUE.code ?? "none")
    print(VALUE.cause ?? Err("none"))
    built: Err{message: "outer", code: Val("E1"), cause: Val(Err("inner"))}
    print(VALUE == built)
    print(FAILED.message)
    print(FAILED.code ?? "none")
    bare: Err("store unavailable", code: "E_STORE")
    print(FAILED == bare)
    here: failure()
    print(FAILED == here)
}
