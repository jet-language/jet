// The default Err lowers from its checked Prelude declaration: a fresh error
// holds the declared metadata default (no identity, context or conversion),
// and copy keeps the metadata a conversion and a context frame recorded.
impl IOError -> Err {
    return Err("store unavailable", code: "E_STORE")
}

fn read_store() -> Int IOError! {
    return Err(IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: None,
        os_code: None,
        cause: Val("disk offline"),
    }))
}

fn get_user() -> Int Err! {
    value :: read_store()?("loading store")
    value
}

fn fresh_errors() {
    literal :: Err{message: "plain", code: Val("E1"), cause: None}
    call :: Err("plain", code: "E1")
    print(literal == call)
    print(literal.message)
    print(literal.code ?? "none")
    print(literal.cause == None)
    caused :: Err{message: "outer", code: None, cause: Val(Err("inner"))}
    print(caused.cause ?? Err("none"))
}

fn run() {
    fresh_errors()
    if get_user() == .Err(failed) {
        kept :: failed.copy()
        print(kept == failed)
        bare :: Err("store unavailable", code: "E_STORE")
        print(kept == bare)
        print(kept.message)
        print(kept.code ?? "none")
    }
}
