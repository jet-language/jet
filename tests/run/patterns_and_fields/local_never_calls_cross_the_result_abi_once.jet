
bool_level_10: fn(left: Bool, right: Bool) -> Bool Never! {
    return left == right
}

bool_level_9: fn(left: Bool, right: Bool) -> Bool Never! {
    return if {
        left -> bool_level_10(left, right)
        else -> bool_level_10(right, left)
    }
}

bool_level_8: fn(left: Bool, right: Bool) -> Bool Never! {
    return bool_level_9(left, right)
}

bool_level_7: fn(left: Bool, right: Bool) -> Bool Never! {
    return if {
        right -> bool_level_8(left, right)
        else -> bool_level_8(right, left)
    }
}

bool_level_6: fn(left: Bool, right: Bool) -> Bool Never! {
    return bool_level_7(left, right)
}

bool_level_5: fn(left: Bool, right: Bool) -> Bool Never! {
    return if {
        left -> bool_level_6(left, right)
        else -> bool_level_6(right, left)
    }
}

bool_level_4: fn(left: Bool, right: Bool) -> Bool Never! {
    return bool_level_5(left, right)
}

bool_level_3: fn(left: Bool, right: Bool) -> Bool Never! {
    return if {
        right -> bool_level_4(left, right)
        else -> bool_level_4(right, left)
    }
}

bool_level_2: fn(left: Bool, right: Bool) -> Bool Never! {
    return bool_level_3(left, right)
}

bool_level_1: fn(left: Bool, right: Bool) -> Bool Never! {
    return if {
        left -> bool_level_2(left, right)
        else -> bool_level_2(right, left)
    }
}

int_helper: fn(value: Int) -> Int Never! {
    return value
}

run: fn() {
    if bool_level_1(false, true) -> print("wrong") else -> print("no")
    if int_helper(7) == 7 {
        print("int")
    }
    print(bool_level_1(true, true) ?? false)
    print(int_helper(9) ?? 0)
}
