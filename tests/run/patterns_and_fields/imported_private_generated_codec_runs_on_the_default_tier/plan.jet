use core.encoding.json as json

#Codable
struct PackageRow {
    name: String
}

#Codable
struct ListReport {
    schema: String
    packages: [PackageRow]
}

fn list_json() -> String {
    return json.to_string(ListReport{
        schema: "jet.report/v1",
        packages: [PackageRow{name: "jet"}]
    })
}
