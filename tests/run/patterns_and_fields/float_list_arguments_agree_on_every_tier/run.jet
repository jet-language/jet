
first: fn(values: [Float]) -> Float { values.first() ?? 0.0 }
last: fn(values: [Float]) -> Float { values.last() ?? 0.0 }
sorted_first: fn(values: [Float]) -> Float {
    sorted_values := values.copy()
    &sorted_values.sort()
    return sorted_values.first() ?? 0.0
}
ordered: fn(left: Float, right: Float) -> Bool { left < right }
list_ordered: fn(left: [Float], right: [Float]) -> Bool { left < right }
run: fn() {
    values: [Float]{1.0, 2.0}
    print(first(values))
    print(last(values))
    print(sorted_first([Float]{2.0, 1.0}))
    print(ordered(values[0], values[1]))
    print(list_ordered(values, [Float]{1.0, 3.0}))
}
