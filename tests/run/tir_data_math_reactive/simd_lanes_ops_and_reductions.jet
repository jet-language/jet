fn run() {
v :: F32x4(1.0, 2.0, 3.0, 4.0)
w :: F32x4(10.0, 20.0, 30.0, 40.0)
s :: F32x4{ v + w }
    print(s.to_array())
    print(v[2])
    print(v.sum())
    print(v.reduce(.Max))
    print(v.reduce(.Mul))
    print(v.reduce(.Avg))
    print(F32x4.splat(5.0).to_array())
d :: F64x2.from_array([1.5, 2.5])
    print(d.sum())
}
