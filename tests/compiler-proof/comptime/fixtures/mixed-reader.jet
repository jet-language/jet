use core.encoding.json as json
use core.files as fs

fn run() {
    ct :: comptime { Reader.over([U8]{7, 9, 11}) }
    ct_a :: comptime { ct.read_u8() ?? panic("ct a") }
    ct_b :: comptime { ct.read_u8() ?? panic("ct b") }
    comptime_value :: comptime { "{ct_a}|{ct_b}|{ct.remaining()}" }

    rt :: Reader.over([U8]{7, 9, 11})
    rt_a :: rt.read_u8() ?? panic("rt a")
    rt_b :: rt.read_u8() ?? panic("rt b")
    runtime_value :: "{rt_a}|{rt_b}|{rt.remaining()}"

    print("{comptime_value}")
    print("{runtime_value}")
    mode :: env.get("JET_COMPTIME_MODE") ?? "unknown"
    operation_id :: env.get("JET_COMPTIME_OPERATION_ID") ?? "mixed-reader-mutation-fallible"
    journal_path :: env.get("JET_COMPTIME_OBSERVATION_PATH") ?? ""
    if journal_path != "" {
        observations :: Dyn.Object([
            "result": Dyn.Object([
                "comptime": Dyn.Text("{comptime_value}"),
                "runtime": Dyn.Text("{runtime_value}")
            ]),
            "typed_failure": Dyn.Array([]),
            "mutation": Dyn.Array([
                Dyn.Object([
                    "stage": Dyn.Text("comptime"),
                    "binding": Dyn.Text("ct"),
                    "operation": Dyn.Text("Reader.read_u8"),
                    "consumed": Dyn.Int(2),
                    "remaining": Dyn.Int(1)
                ]),
                Dyn.Object([
                    "stage": Dyn.Text("runtime"),
                    "binding": Dyn.Text("rt"),
                    "operation": Dyn.Text("Reader.read_u8"),
                    "consumed": Dyn.Int(2),
                    "remaining": Dyn.Int(1)
                ])
            ]),
            "input_consumption": Dyn.Array([
                Dyn.Object([
                    "stage": Dyn.Text("comptime"),
                    "input": Dyn.Array([Dyn.Int(7), Dyn.Int(9), Dyn.Int(11)]),
                    "consumed": Dyn.Array([Dyn.Int(7), Dyn.Int(9)]),
                    "remaining": Dyn.Array([Dyn.Int(11)])
                ]),
                Dyn.Object([
                    "stage": Dyn.Text("runtime"),
                    "input": Dyn.Array([Dyn.Int(7), Dyn.Int(9), Dyn.Int(11)]),
                    "consumed": Dyn.Array([Dyn.Int(7), Dyn.Int(9)]),
                    "remaining": Dyn.Array([Dyn.Int(11)])
                ])
            ]),
            "ordered_effects": Dyn.Array([
                Dyn.Text("stdout:{comptime_value}"),
                Dyn.Text("stdout:{runtime_value}")
            ]),
            "cleanup": Dyn.Array([
                Dyn.Text("ct-reader"),
                Dyn.Text("rt-reader")
            ]),
            "resource_premises": Dyn.Object([
                "fuel": Dyn.Text("finite"),
                "input": Dyn.Text("fixed-bytes"),
                "allocation": Dyn.Text("successful")
            ]),
            "schedule": Dyn.Text("source-order"),
            "allowed_schedules": Dyn.Array([Dyn.Text("source-order")])
        ])
        record :: Dyn.Object([
            "operation_id": Dyn.Text(operation_id),
            "mode": Dyn.Text(mode),
            "observations": observations
        ])
        fs.write(journal_path, json.to_string(record) + "\n") ?? panic("comptime observation journal")
    }
}
