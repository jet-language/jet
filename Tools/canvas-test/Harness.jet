// The Canvas scenario context: one driven tab on a running `jet dev --canvas`
// server, and the page and server helpers every scenario shares. A helper
// that reads the page evaluates JavaScript through the driver; the page's
// test hooks live on `window.__jetCanvasTest` (Compiler/JetCanvas/Source/
// CanvasAssets/js).
use {
    files: core.files
    time: core.time
}

Ctx: struct {
    d: Driver
    port: Int
    session: String
    out_dir: String
    scenario: String
    seed: Int
    browser: String
    program_target: String
}

// --- the driver, as the scenarios use it -------------------------------------

eval: fn(c: Ctx, expression: String) -> Dyn Failure! { driver_eval(c.d, expression) }

eval_text: fn(c: Ctx, expression: String) -> String Failure! { Ok(text(eval(c, expression))) }

eval_bool: fn(c: Ctx, expression: String) -> Bool Failure! { Ok(truthy(eval(c, expression))) }

eval_num: fn(c: Ctx, expression: String) -> Float Failure! { Ok(num(eval(c, expression))) }

navigate: fn(c: Ctx, url: String) Failure! { driver_navigate(c.d, url) }

// Click a viewport point, then let the Canvas settle.
click: fn(c: Ctx, x: Float, y: Float) Failure! {
    driver_click(c.d, x, y, 0, 1, [String]{})
    sleep_ms(120)
    Ok()
}

// Click a point with no settle pause (the driver's own click).
raw_click: fn(c: Ctx, x: Float, y: Float) Failure! { driver_click(c.d, x, y, 0, 1, [String]{}) }

click_mod: fn(c: Ctx, x: Float, y: Float, modifiers: [String]) Failure! { driver_click(c.d, x, y, 0, 1, modifiers) }

right_click: fn(c: Ctx, x: Float, y: Float) Failure! { driver_click(c.d, x, y, 2, 1, [String]{}) }

double_click: fn(c: Ctx, x: Float, y: Float) Failure! { driver_click(c.d, x, y, 0, 2, [String]{}) }

// Click the centre of the node titled (or containing) `title`.
click_node: fn(c: Ctx, title: String) Failure! {
    p: node(c, title)
    click(c, p.x, p.y)
}

drag: fn(c: Ctx, from: Point, to: Point) Failure! { driver_drag(c.d, from, to, 12, [String]{}) }

drag_steps: fn(c: Ctx, from: Point, to: Point, steps: Int) Failure! { driver_drag(c.d, from, to, steps, [String]{}) }

drag_mod: fn(c: Ctx, from: Point, to: Point, steps: Int, modifiers: [String]) Failure! { driver_drag(c.d, from, to, steps, modifiers) }

// One pointer step: "down" and "up" press and release the primary button at
// the point, "move" moves there; buttons stay held between calls.
mouse: fn(c: Ctx, kind: String, x: Float, y: Float) Failure! {
    actions := [Dyn]{move_action(x, y, 0)}
    if kind == "down" -> actions.push(button_action("pointerDown", 0))
    if kind == "up" -> actions.push(button_action("pointerUp", 0))
    driver_pointer(c.d, actions, [String]{})
}

mouse_mod: fn(c: Ctx, kind: String, x: Float, y: Float, modifiers: [String]) Failure! {
    actions := [Dyn]{move_action(x, y, 0)}
    if kind == "down" -> actions.push(button_action("pointerDown", 0))
    if kind == "up" -> actions.push(button_action("pointerUp", 0))
    driver_pointer(c.d, actions, modifiers)
}

wheel: fn(c: Ctx, x: Float, y: Float, delta_y: Float) Failure! { driver_wheel(c.d, x, y, 0.0, delta_y) }

wheel_xy: fn(c: Ctx, x: Float, y: Float, delta_x: Float, delta_y: Float) Failure! { driver_wheel(c.d, x, y, delta_x, delta_y) }

// Type `value` key by key, then let the page settle.
type_text: fn(c: Ctx, value: String) Failure! {
    driver_type(c.d, value)
    sleep_ms(80)
    Ok()
}

// Type `value` with no settle pause (CDP's Input.insertText role).
insert_text: fn(c: Ctx, value: String) Failure! { driver_type(c.d, value) }

press: fn(c: Ctx, key: String) Failure! { driver_keys(c.d, [String]{key}) }

shortcut: fn(c: Ctx, keys: [String]) Failure! { driver_keys(c.d, keys) }

release_input: fn(c: Ctx) Failure! { driver_release(c.d) }

set_viewport: fn(c: Ctx, width: Int, height: Int) Failure! { driver_set_viewport(c.d, width, height) }

add_preload: fn(c: Ctx, function_declaration: String) -> String Failure! { driver_add_preload(c.d, function_declaration) }

remove_preload: fn(c: Ctx, id: String) Failure! { driver_remove_preload(c.d, id) }

// Save `<out_dir>/<scenario>-<name>.png`; its path.
screenshot: fn(c: Ctx, name: String) -> String Failure! {
    files.create_dir_all(c.out_dir) ?? return Err(fail_with("cannot create {c.out_dir}: {err}"))
    driver_screenshot(c.d, "{c.out_dir}/{c.scenario}-{name}.png")
}

// --- waits ----------------------------------------------------------------------

// Poll the page until `expression` is truthy, for 8 s.
wait_js: fn(c: Ctx, expression: String, label: String) Failure! { wait_js_ms(c, expression, label, C_WAIT_MS) }

wait_js_ms: fn(c: Ctx, expression: String, label: String, ms: Int) Failure! {
    w: deadline(ms)
    loop alive(w) {
        if eval_bool(c, expression) -> return Ok()
        pause()
    }
    Err(fail_with("timed out waiting for {label}"))
}

timeout: fn(label: String) -> Failure { fail_with("timed out waiting for {label}") }

// --- the Canvas page -------------------------------------------------------------

session_url: fn(c: Ctx, path: String) -> String {
    if c.session == "" -> return path.copy()
    joiner: if path.contains("?") -> "&" else -> "?"
    "{path}{joiner}session={url_encode(c.session)}"
}

url_encode: fn(value: String) -> String {
    out := ""
    loop byte in value.bytes() {
        ch: Int.from_u8(byte)
        safe: (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 45 || ch == 46 || ch == 95 || ch == 126
        if safe {
            out = "{out}{String.from_bytes([U8]{byte}) ?? ""}"
        } else {
            out = "{out}%{hex2(ch)}"
        }
    }
    out
}

hex2: fn(value: Int) -> String {
    digits: "0123456789ABCDEF"
    "{digits.slice(value /% 16..<value /% 16 + 1)}{digits.slice(value % 16..<value % 16 + 1)}"
}

// Open the Canvas on `port` and wait for its hit map; the load time in ms.
open_canvas_at: fn(c: Ctx, port: Int) -> Float Failure! {
    query: if c.session == "" -> "" else -> "?session={url_encode(c.session)}"
    navigate(c, "http://127.0.0.1:{port}/canvas{query}")
    wait_for_canvas(c)
    eval_num(c, "(() => {{ const navigation = performance.getEntriesByType('navigation')[0]; return performance.now() - (navigation ? navigation.startTime : 0); }})()")
}

open_canvas: fn(c: Ctx) -> Float Failure! { open_canvas_at(c, c.port) }

wait_for_canvas: fn(c: Ctx) Failure! {
    wait_js(c, "(() => {{ const s = window.__jetCanvasTest; return !!s && s.nodeCount > 0 && Object.keys(s.nodeBounds || {{}}).length > 0; }})()", "Canvas hit map")
}

state: fn(c: Ctx) -> Dyn Failure! { eval(c, "window.__jetCanvasTest || null") }

// A pin of the node titled (or containing) `node_title`: by name, then by
// direction, then its first pin.
pin: fn(c: Ctx, node_title: String, pin_name: String) -> Point Failure! {
    title: q(node_title)
    name: q(pin_name)
    found: eval(c, """
        (() => {{
          const state = window.__jetCanvasTest || {{}};
          const title = {title}, name = {name};
          const node = Object.values(state.nodeBounds || {{}}).find((n) => n.title === title || n.title.includes(title));
          if (!node) return {{ error: "node not found: " + title }};
          const pins = ((state.hitMap && state.hitMap.pins) || []).filter((p) => p.node_id === node.node_id);
          const pin = pins.find((p) => p.name === name || p.name.includes(name)) || pins.find((p) => p.direction === name) || pins[0];
          if (!pin) return {{ error: "pin not found: " + title + "." + name }};
          const point = state.pinPoints && state.pinPoints[pin.pin_id];
          if (point && Number.isFinite(point.client_x) && Number.isFinite(point.client_y)) return {{ x: point.client_x, y: point.client_y }};
          const r = document.getElementById("jet-canvas-view").getBoundingClientRect();
          return {{ x: r.left + pin.cx, y: r.top + pin.cy }};
        }})()
        """)
    point_or_error(found)
}

// The centre of the node titled (or containing) `node_title`.
node: fn(c: Ctx, node_title: String) -> Point Failure! {
    title: q(node_title)
    found: eval(c, """
        (() => {{
          const state = window.__jetCanvasTest || {{}};
          const title = {title};
          const node = Object.values(state.nodeBounds || {{}}).find((n) => n.title === title || n.title.includes(title));
          if (!node) return {{ error: "node not found: " + title }};
          const r = document.getElementById("jet-canvas-view").getBoundingClientRect();
          return {{ x: r.left + node.x + node.w / 2, y: r.top + node.y + node.h / 2 }};
        }})()
        """)
    point_or_error(found)
}

point_or_error: fn(found: Dyn) -> Point Failure! {
    problem: text(at(found, "error"))
    if problem != "" -> return Err(fail_with(problem))
    Ok(Point{x: num(at(found, "x")), y: num(at(found, "y"))})
}

// The Canvas element's client rect: left, top, width, height.
canvas_rect: fn(c: Ctx) -> Dyn Failure! {
    eval(c, "(() => {{ const r = document.getElementById('jet-canvas-view').getBoundingClientRect(); return {{ left: r.left, top: r.top, width: r.width, height: r.height }}; }})()")
}

drag_pin: fn(c: Ctx, node_title: String, pin_name: String, dx: Float, dy: Float) Failure! {
    from: pin(c, node_title, pin_name)
    drag(c, from, Point{x: from.x + dx, y: from.y + dy})
    sleep_ms(120)
    Ok()
}

open_pin_action_menu: fn(c: Ctx, node_title: String, pin_name: String) Failure! {
    drag_pin(c, node_title, pin_name, 190.0, 30.0)
    if menu_open(c) -> return Ok()
    opened: eval_bool(c, "window.__jetCanvasTest.openPinMenu({q(node_title)}, {q(pin_name)})")
    if !opened {
        p: pin(c, node_title, pin_name)
        right_click(c, p.x, p.y)
    }
    sleep_ms(120)
    Ok()
}

menu_open: fn(c: Ctx) -> Bool Failure! {
    eval_bool(c, "(() => {{ const menu = document.getElementById('context-menu'); return !!menu && menu.classList.contains('is-open'); }})()")
}

load_core_catalog: fn(c: Ctx, query: String) Failure! {
    eval(c, "window.__jetCanvasTest.loadCoreCatalog({q(query)})")
    wait_js(c, "Number(window.__jetCanvasCoreCatalogPalette || 0) > 0", "Core catalog palette")
}

open_core_catalog_palette: fn(c: Ctx, query: String) Failure! {
    eval(c, "window.__jetCanvasTest.openCoreCatalogPalette({q(query)})")
    sleep_ms(120)
    Ok()
}

switch_graph: fn(c: Ctx, title: String) Failure! {
    if !eval_bool(c, "window.__jetCanvasTest.switchGraphByTitle({q(title)})") -> return Err(fail_with("graph not found: {title}"))
    wait_for_canvas(c)
}

expect_menu: fn(c: Ctx, label: String) Failure! {
    wait_js(c, "(() => {{ const menu = document.getElementById('context-menu'); return !!menu && menu.classList.contains('is-open') && (menu.textContent.includes({q(label)}) || menu.innerHTML.includes({q(label)})); }})()", "menu containing {label}")
}

pick_entry: fn(c: Ctx, label: String) Failure! {
    ok: eval_bool(c, "(() => {{ const button = Array.from(document.querySelectorAll('#context-menu [data-menu-action]')).find((b) => b.textContent.includes({q(label)})); if (!button) return false; button.click(); return true; }})()")
    if !ok {
        menu: eval_text(c, "(() => {{ const el = document.getElementById('context-menu'); return el ? el.textContent : ''; }})()")
        return Err(fail_with("menu entry not found: {label}\nmenu: {menu}"))
    }
    sleep_ms(500)
    wait_for_canvas(c)
}

expect_node_count: fn(c: Ctx, min: Int) Failure! {
    wait_js(c, "(() => {{ const s = window.__jetCanvasTest; return !!s && s.nodeCount >= {min}; }})()", "node count >= {min}")
}

expect_source_contains: fn(c: Ctx, needle: String) Failure! {
    url: q(session_url(c, "/canvas/source"))
    body: eval_text(c, "fetch({url}, {{ cache: 'no-store' }}).then((r) => r.text())")
    if !body.contains(needle) {
        last: eval_text(c, "JSON.stringify({{ tx: window.__jetCanvasLastTx || null, result: window.__jetCanvasLastTxResult || null }})")
        return Err(fail_with("source missing {q(needle)}\n{body}\nlast: {last}"))
    }
    Ok()
}

// Fetch `/canvas/<kind>` for the shown source; `reader` is `text` or `json`.
fetch_shown: fn(c: Ctx, kind: String, reader: String) -> Dyn Failure! {
    base: q(session_url(c, "/canvas/{kind}"))
    eval(c, """
        (() => {{
          const base = {base};
          const sourceId = window.__jetCanvasTest?.doc?.source_id;
          const suffix = sourceId ? (base.includes("?") ? "&" : "?") + "source_id=" + encodeURIComponent(sourceId) : "";
          return fetch(base + suffix, {{ cache: "no-store" }}).then((r) => r.{reader}());
        }})()
        """)
}

source: fn(c: Ctx) -> String Failure! { Ok(text(fetch_shown(c, "source", "text"))) }

graph: fn(c: Ctx) -> Dyn Failure! { fetch_shown(c, "graph", "json") }

ui_doc: fn(c: Ctx) -> Dyn Failure! { eval(c, "window.__jetCanvasTest && window.__jetCanvasTest.doc") }

problems: fn(c: Ctx) -> [Dyn] Failure! { Ok(items(eval(c, "(window.__jetCanvasTest && window.__jetCanvasTest.problems) || []"))) }

diagnostics_by_node: fn(c: Ctx) -> Dyn Failure! { eval(c, "(window.__jetCanvasTest && window.__jetCanvasTest.diagnosticsByNode) || []") }

// Wait for a problem whose code is `code` (or whose rendering names it; any
// problem when `code` is empty), and return it.
expect_problem: fn(c: Ctx, code: String) -> Dyn Failure! {
    w: deadline(C_WAIT_MS)
    loop alive(w) {
        loop problem in problems(c) {
            if code == "" || text(at(problem, "code")) == code || text(at(problem, "rendered")).contains(code) -> return Ok(problem)
        }
        pause()
    }
    Err(timeout("problem {code}"))
}

set_source_editor: fn(c: Ctx, value: String) Failure! {
    if !eval_bool(c, "window.__jetCanvasTest.setSourceEditor({q(value)})") -> return Err(fail_with("source editor helper missing"))
    Ok()
}

check_current_source: fn(c: Ctx) Failure! {
    eval(c, "window.__jetCanvasTest.checkCurrentSource()")
    Ok()
}

jump_problem: fn(c: Ctx, index: Int) -> Dyn Failure! { eval(c, "window.__jetCanvasTest.jumpProblem({index})") }

// POST `body` (a JSON value) to `/canvas/query`; the JSON reply.
query: fn(c: Ctx, body: Dyn) -> Dyn Failure! {
    url: q(session_url(c, "/canvas/query"))
    payload: q(js(body))
    eval(c, "fetch({url}, {{ method: 'POST', headers: {{ 'content-type': 'application/json' }}, body: {payload} }}).then((r) => r.json())")
}

// POST a transaction for the shown source; `{ok, json}`.
transaction: fn(c: Ctx, body: Dyn) -> Dyn Failure! { transaction_js(c, js(body)) }

// The same with the request given as a JavaScript object expression.
transaction_js: fn(c: Ctx, body: String) -> Dyn Failure! {
    url: q(session_url(c, "/canvas/transaction"))
    eval(c, """
        (() => {{
          const request = Object.assign({{}}, {body});
          const sourceId = window.__jetCanvasTest?.doc?.source_id;
          if (sourceId && !request.source_id) request.source_id = sourceId;
          return fetch({url}, {{ method: "POST", headers: {{ "content-type": "application/json" }}, body: JSON.stringify(request) }}).then((r) => r.json().then((json) => ({{ ok: r.ok, json }})));
        }})()
        """)
}

// Post a transaction through the page's own path; `{ok, json}`.
ui_transaction: fn(c: Ctx, body: Dyn) -> Dyn Failure! { ui_transaction_js(c, js(body)) }

ui_transaction_js: fn(c: Ctx, body: String) -> Dyn Failure! {
    if !eval_bool(c, "window.__jetCanvasTest.postTransaction({body})") -> return Err(fail_with("UI transaction helper missing"))
    wait_js(c, "window.__jetCanvasLastTxResult !== null && window.__jetCanvasLastTxResult !== undefined", "UI transaction result")
    eval(c, "(() => {{ const json = window.__jetCanvasLastTxResult; return {{ ok: !(json && json.ok === false), json }}; }})()")
}

undo: fn(c: Ctx) -> String Failure! { history_step(c, "undo") }

redo: fn(c: Ctx) -> String Failure! { history_step(c, "redo") }

// Undo or redo through the page and wait for the restored revision; the source.
history_step: fn(c: Ctx, step: String) -> String Failure! {
    before: source(c)
    depth: if step == "undo" -> "undoDepth" else -> "redoDepth"
    if num(at(state(c), depth)) < 1.0 -> return Err(fail_with("{step} helper missing or stack empty"))
    started: eval_bool(c, "(() => {{ window.__jetCanvasHistoryPromise = window.__jetCanvasTest.{step}(); return typeof window.__jetCanvasHistoryPromise?.then === 'function'; }})()")
    if !started -> return Err(fail_with("{step} helper did not return asynchronous completion"))
    eval(c, "window.__jetCanvasHistoryPromise")
    fresh: graph(c)
    ui: ui_doc(c)
    fresh_text: text(at(fresh, "source_text"))
    restored: !is_null(fresh) && !is_null(ui) && fresh_text != before && js(at(ui, "source_id")) == js(at(fresh, "source_id")) && js(at(ui, "revision")) == js(at(fresh, "revision")) && text(at(ui, "source_text")) == fresh_text
    if !restored {
        facts: js(obj([(key: "freshSource", value: at(fresh, "source_id")), (key: "freshRevision", value: at(fresh, "revision")), (key: "uiSource", value: at(ui, "source_id")), (key: "uiRevision", value: at(ui, "revision"))]))
        return Err(fail_with("{step} UI did not reach restored revision/source: {facts}"))
    }
    Ok(fresh_text)
}

replace_source: fn(c: Ctx, value: String) -> Dyn Failure! {
    current: graph(c)
    result: transaction(c, obj([(key: "schema_version", value: Dyn.Int(1)), (key: "op", value: Dyn.Text("replace_source")), (key: "revision", value: at(current, "revision")), (key: "source", value: Dyn.Text(value.copy()))]))
    if !truthy(at(result, "ok")) {
        reply: js(at(result, "json"))
        return Err(fail_with("replace_source failed: {reply}"))
    }
    wait_for_canvas(c)
    Ok(at(result, "json"))
}

nonblank_pixels: fn(c: Ctx) -> Int Failure! {
    Ok(int(eval(c, """
        (() => {{
          const canvas = document.getElementById("jet-canvas-view");
          const ctx = canvas.getContext("2d");
          const w = Math.min(canvas.width, 160), h = Math.min(canvas.height, 120);
          const data = ctx.getImageData(0, 0, w, h).data;
          let count = 0;
          for (let i = 0; i < data.length; i += 4) if (data[i] || data[i + 1] || data[i + 2]) count++;
          return count;
        }})()
        """)))
}
