#!/usr/bin/env jet
// The web backend browser acceptance matrix over the static server:
//
//   jet run --allow=Env,Exec,FS,IO,Net,Time Tools/web-test/Acceptance.jet -- --port <port> [--browser chromium|firefox]
//
// Each of the five bundles (/click, /reactive, /compute, /callback,
// /lifecycle) serves an m2 manifest whose hex source map is a version 3 map
// with mappings and sources, non-empty app.js, jet_dom_runtime.js, app.wasm and
// both maps, and an app.js that names app.js.map. core.browser then
// launches the engine pinned in the working directory's `.jet/lock` and
// drives each page over WebDriver BiDi: the click DOM keeps one tree while its
// text and colour update, the reactive page paints its final text, the wasm
// compute and callback pages print 42 to the console, and the lifecycle page
// removes and restores a child. It prints `PASS web backend browser
// acceptance matrix` and exits 0, or names the failed check and exits 1.
use {
    browser: core.browser
    core.browser.[Browser, BrowserProtocol]
    client: core.http.client
    hex: core.encoding.hex
    json: core.encoding.json
    process: core.process
    time: core.time
}

C_WAIT_MS: 20000
C_POLL_MS: 80
C_BODY_LIMIT: 268435456

// Collects console.log lines, and console errors and uncaught page errors
// (prefixed `error:`), before any page script runs.
C_CONSOLE_HOOK: "() => {{ window.__jetAcceptanceLogs = []; const keep = (prefix, args) => window.__jetAcceptanceLogs.push(prefix + args.map((v) => String(v)).join(' ')); console.log = (...args) => keep('', args); console.error = (...args) => keep('error: ', args); window.addEventListener('error', (event) => keep('error: ', [event.message])); window.addEventListener('unhandledrejection', (event) => keep('error: ', [event.reason])); }}"

C_DOM_BOX: "(() => {{ const app = document.getElementById('jet-app'); const box = app?.firstElementChild; if (!box) return 'null'; return JSON.stringify({{ children: String(app.children.length), text: box.textContent || '', background: box.style.background || box.style.backgroundColor || '' }}); }})()"

C_LIFECYCLE_LABELS: "JSON.stringify(Array.from(document.querySelectorAll('#jet-app > *')).map((el) => el.textContent))"

C_LOGGED_42: "(window.__jetAcceptanceLogs || []).some((line) => line.trim() === '42')"

#Error
Failure: struct {
    message: String

    impl Display {
        display: fn(self) -> String { self.message }
    }
}

// The launched session and the BiDi context id of the tab it drives.
Driver: struct {
    session: Browser
    bidi: BrowserProtocol
    context: String
}

// The click and reactive pages' root facts.
DomBox: struct {
    children: Int
    text: String
    background: String
}

run: fn() {
    args: process.args()
    port: option(args, "--port") ?? ""
    engine: option(args, "--browser") ?? "chromium"
    if (Int.parse(port) ?? 0) <= 0 {
        process.fail(2, "usage: Acceptance.jet --port <port> [--browser chromium|firefox]")
    }
    origin: "http://127.0.0.1:{port}"
    prefixes: [String]{"/click", "/reactive", "/compute", "/callback", "/lifecycle"}
    loop prefix in prefixes {
        check_bundle(origin, prefix) ?? fail(err.message)
    }
    driver: open(engine) ?? fail(err.message)
    matrix(driver, origin) ?? {
        driver.session.close().drop("the engine also stops with the session's last owner")
        fail(err.message)
    }
    driver.session.close().drop("the engine also stops with the session's last owner")
    print("PASS web backend browser acceptance matrix")
}

check_bundle: fn(origin: String, prefix: String) Failure! {
    manifest: json.parse(fetch_text(origin, "{prefix}/web.manifest.json")) ?? return Err(Failure{message: "{prefix} manifest is not JSON: {err}"})
    check(text(field(manifest, "status")) == "m2", "{prefix} manifest status")
    source_map: text(field(manifest, "sourceMap"))
    check(source_map != "", "{prefix} sourceMap missing")
    raw: hex.decode(source_map.removeprefix("0x").removeprefix("0X")) ?? return Err(Failure{message: "{prefix} sourceMap is not hex: {err}"})
    map: json.parse(String.from_bytes_lossy(raw)) ?? return Err(Failure{message: "{prefix} source map is not JSON: {err}"})
    check(field(map, "version") == .Int(3), "{prefix} source map version")
    check(text(field(map, "mappings")) != "", "{prefix} source map mappings")
    check(items(field(map, "sources")).len() > 0, "{prefix} source map sources")
    bundle_files: [String]{"app.js", "jet_dom_runtime.js", "app.wasm", "app.js.map", "app.wasm.map"}
    loop file in bundle_files {
        check(fetch_bytes(origin, "{prefix}/{file}") > 0, "{prefix}/{file} empty")
    }
    check(fetch_text(origin, "{prefix}/app.js").contains("sourceMappingURL=app.js.map"), "{prefix} app.js sourceMappingURL")
    Ok()
}

matrix: fn(d: Driver, origin: String) Failure! {
    preload: Dyn.Object([(key: String, value: Dyn)]{
        (key: "functionDeclaration", value: Dyn.Text(C_CONSOLE_HOOK)),
        (key: "contexts", value: Dyn.Array([Dyn]{Dyn.Text(d.context.copy())})),
    })
    command(d.bidi, "script.addPreloadScript", preload)

    navigate(d, "{origin}/click/index.html")
    first: wait_box(d, "", "click initial paint")
    check(first.children == 2, "click create: {first.children} children")
    check(first.text.contains("Clicks: 0"), "click initial text: {first.text}")
    check(first.background.contains("rgb(51, 102, 255)") || first.background.contains("#3366ff"), "click initial color: {first.background}")
    perform(d, "document.querySelector('#jet-app button').click()")
    second: wait_box(d, "Clicks: 1", "click update")
    check(second.children == 2, "click reuse: {second.children} children")
    check(second.background.contains("rgb(232, 121, 12)") || second.background.contains("#e8790c"), "click updated color: {second.background}")
    perform(d, "document.querySelector('#jet-app button').click()")
    third: wait_box(d, "Clicks: 2", "click second update")
    check(third.children == 2, "click still one tree: {third.children} children")

    navigate(d, "{origin}/reactive/index.html")
    wait_box(d, "world", "reactive final paint")

    navigate(d, "{origin}/compute/index.html")
    wait_for(d, C_LOGGED_42, "wasm compute console")

    navigate(d, "{origin}/callback/index.html")
    perform(d, "document.getElementById('go').click()")
    wait_for(d, C_LOGGED_42, "wasm callback click")

    navigate(d, "{origin}/lifecycle/index.html")
    initial: wait_labels(d, 2, "lifecycle initial nodes")
    check(initial.contains("keep") && initial.contains("drop"), "lifecycle initial: {initial.join("|")}")
    perform(d, "document.getElementById('hide').click()")
    removed: wait_labels(d, 1, "lifecycle remove child")
    check(removed[0] == "keep", "lifecycle remove left: {removed.join("|")}")
    perform(d, "document.getElementById('show').click()")
    restored: wait_labels(d, 2, "lifecycle restore child")
    check(restored.contains("drop"), "lifecycle restore: {restored.join("|")}")
    Ok()
}

// Poll the click/reactive root until it exists and its text holds `fragment`.
wait_box: fn(d: Driver, fragment: String, label: String) -> DomBox Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        if evaluate(d, C_DOM_BOX) == .Val(raw) && raw != "null" {
            tree: json.parse(raw) ?? return Err(Failure{message: "{label}: the DOM facts are not JSON: {err}"})
            found: DomBox{children: number(field(tree, "children")), text: text(field(tree, "text")), background: text(field(tree, "background"))}
            if found.text.contains(fragment) -> return Ok(found)
        }
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    page: evaluate(d, "document.location.href + ' ' + document.body.innerHTML.slice(0, 400) + ' logs: ' + (window.__jetAcceptanceLogs || []).join(' | ')") ?? "unreadable"
    Err(Failure{message: "timed out waiting for {label}; the page is {page}"})
}

// Poll the lifecycle node labels until there are `count` of them; one label
// must be `keep` when only one remains.
wait_labels: fn(d: Driver, count: Int, label: String) -> [String] Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        if evaluate(d, C_LIFECYCLE_LABELS) == .Val(raw) {
            tree: json.parse(raw) ?? return Err(Failure{message: "{label}: the labels are not JSON: {err}"})
            labels := [String]{}
            loop entry in items(tree) -> labels.push(text(entry))
            if labels.len() == count && (count != 1 || labels[0] == "keep") -> return Ok(labels)
        }
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    Err(Failure{message: "timed out waiting for {label}"})
}

// Poll until `expression` is `true`; a thrown page error counts as not yet.
wait_for: fn(d: Driver, expression: String, label: String) Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        if evaluate(d, expression) == .Val(value) && value == "true" -> return Ok()
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    Err(Failure{message: "timed out waiting for {label}"})
}

// Run a page action once; a thrown page error fails the matrix.
perform: fn(d: Driver, expression: String) Failure! {
    if evaluate(d, expression) == {
        .Val(_) -> Ok()
        None -> {
            page: evaluate(d, "document.body.innerHTML.slice(0, 600)") ?? "unreadable"
            Err(Failure{message: "page action threw: {expression}; the page is {page}"})
        }
        .Err(error) -> Err(error)
    }
}

// The page value of `expression` as `String(value)` after awaiting it, or
// None when the page threw.
evaluate: fn(d: Driver, expression: String) -> String? Failure! {
    params: Dyn.Object([(key: String, value: Dyn)]{
        (key: "expression", value: Dyn.Text("(async () => String(await ({expression})))()")),
        (key: "target", value: Dyn.Object([(key: String, value: Dyn)]{(key: "context", value: Dyn.Text(d.context.copy()))})),
        (key: "awaitPromise", value: Dyn.Bool(true)),
        (key: "resultOwnership", value: Dyn.Text("none")),
    })
    reply: command(d.bidi, "script.evaluate", params)
    if text(field(reply, "type")) != "success" -> return Ok(None)
    Ok(Val(text(field(field(reply, "result"), "value"))))
}

navigate: fn(d: Driver, address: String) Failure! {
    command(d.bidi, "browsingContext.navigate", Dyn.Object([(key: String, value: Dyn)]{
        (key: "context", value: Dyn.Text(d.context.copy())),
        (key: "url", value: Dyn.Text(address.copy())),
        (key: "wait", value: Dyn.Text("complete")),
    }))
    Ok()
}

// Launch the locked engine and open one tab.
open: fn(engine: String) -> Driver Failure! {
    session: browser.launch(engine) ?? return Err(Failure{message: "{engine} launch failed: {err}"})
    bidi: session.protocol("bidi") ?? return Err(Failure{message: "BiDi protocol unavailable: {err}"})
    created: command(bidi, "browsingContext.create", Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("tab"))}))
    context: text(field(created, "context"))
    if context == "" -> return Err(Failure{message: "browsingContext.create returned no context"})
    Ok(Driver{session: session, bidi: bidi, context: context})
}

command: fn(bidi: BrowserProtocol, method: String, params: Dyn) -> Dyn Failure! {
    wire: json.to_string(params) ?? return Err(Failure{message: "{method} parameters cannot be encoded: {err}"})
    reply: bidi.send(method, wire) ?? return Err(Failure{message: "{method} failed: {err}"})
    tree: json.parse(reply) ?? return Err(Failure{message: "{method} reply is not JSON: {err}"})
    Ok(tree)
}

fetch_response: fn(origin: String, path: String) -> HTTPResponse Failure! {
    response: client.get("{origin}{path}") ?? return Err(Failure{message: "{path} request failed: {err}"})
    if response.status() < 200 || response.status() > 299 -> return Err(Failure{message: "{path} returned {response.status()}"})
    Ok(response)
}

fetch_text: fn(origin: String, path: String) -> String Failure! {
    response: fetch_response(origin, path)
    body: response.text(C_BODY_LIMIT) ?? return Err(Failure{message: "{path} body is not text: {err}"})
    Ok(body)
}

fetch_bytes: fn(origin: String, path: String) -> Int Failure! {
    response: fetch_response(origin, path)
    body: response.body().bytes(C_BODY_LIMIT) ?? return Err(Failure{message: "{path} body cannot be read: {err}"})
    Ok(body.len())
}

check: fn(condition: Bool, message: String) Failure! {
    if !condition -> return Err(Failure{message: message})
    Ok()
}

field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

items: fn(tree: Dyn) -> [Dyn] {
    if tree == .Array(list) -> return list.copy()
    [Dyn]{}
}

text: fn(tree: Dyn) -> String {
    if tree == .Text(value) -> return value.copy()
    ""
}

// A count the page sent as decimal text; -1 when it is not one.
number: fn(tree: Dyn) -> Int {
    Int.parse(text(tree)) ?? (0 - 1)
}

option: fn(args: [String], name: String) -> String? {
    loop index in 0..<args.len() {
        if args[index] == name && index + 1 < args.len() -> return Val(args[index + 1].copy())
    }
    None
}

fail: fn(message: String) -> Never { process.fail(1, message) }
