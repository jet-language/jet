#!/usr/bin/env jet
// Publish immutable index targets first, then the signed mutable manifest.
// Signers and the uploader are explicit executables; this tool never holds a
// private key and never runs on a user machine. A signer runs as
// `SIGNER REQUEST OUTPUT`, the uploader as `UPLOAD SOURCE DESTINATION`.
// Usage:
//   jet Tools/jetpack-nix-index/Publish.jet --target-root DIR --manifest FILE
//     [--manifest-request FILE] --destination URL --sign-index SIGNER
//     --sign-manifest SIGNER --upload UPLOADER
use {
    files: core.files
    process: core.process
    sys: core.sys
}

OPTIONS: ["--target-root", "--manifest", "--manifest-request", "--destination", "--sign-index", "--sign-manifest", "--upload"]
REQUIRED: ["--target-root", "--manifest", "--destination", "--sign-index", "--sign-manifest", "--upload"]

// A refusal and the exit status it ends the run with: 2 for a usage error,
// 1 for the rest.
#Error
PublishError: struct {
    message: String
    code: Int
}

run: fn() {
    if publish(process.args()) == {
        .Ok(_) -> print("published immutable targets, then manifest")
        .Err(error) -> {
            if error.message == "" -> process.exit(error.code)
            process.fail(error.code, error.message)
        }
    }
}

failed: fn(message: String) -> PublishError Never! {
    PublishError{message: message, code: 1}
}

publish: fn(args: [String]) -[Env, Exec, FS, Time.Wait]> PublishError! {
    values := [String: String]{}
    index := 0
    loop index < args.len() {
        name: args[index]
        if !OPTIONS.contains(name) -> return Err(PublishError{message: "unknown option: {name}", code: 2})
        if index + 1 >= args.len() || args[index + 1] == "" -> return Err(PublishError{message: "missing {name.removeprefix("--").replace("-", " ")}", code: 2})
        values[name] = args[index + 1]
        index += 2
    }
    loop name in REQUIRED {
        if (values.get(name) ?? "") == "" -> return Err(PublishError{message: "missing {name.replace("-", "_").replace("__", "--")}", code: 2})
    }
    target_root: values["--target-root"]
    manifest: values["--manifest"]
    destination: values["--destination"]
    upload: values["--upload"]
    manifest_request: values.get("--manifest-request") ?? "{manifest}.sig.request"
    if !files.is_file(manifest) -> return Err(failed("manifest is missing"))
    if !files.is_file(manifest_request) -> return Err(failed("manifest signing request is missing; caller must provide the domain-prefixed bytes"))

    loop target in targets(target_root) ?? return Err(err) {
        request: "{target}.sig.request"
        signature: "{target}.sig.json"
        if !files.is_file(request) -> return Err(failed("missing signing request: {request}"))
        sign_immutable(values["--sign-index"], request, signature) ?? return Err(err)
        relative: target.removeprefix("{target_root}/")
        call([upload.copy(), target.copy(), "{destination}/{relative}"]) ?? return Err(err)
        call([upload.copy(), signature.copy(), "{destination}/{relative}.sig.json"]) ?? return Err(err)
    }
    manifest_signature: "{manifest}.sig.json"
    sign_immutable(values["--sign-manifest"], manifest_request, manifest_signature) ?? return Err(err)
    call([upload.copy(), manifest.copy(), "{destination}/manifest.json"]) ?? return Err(err)
    call([upload.copy(), manifest_signature.copy(), "{destination}/manifest.json.sig.json"]) ?? return Err(err)
    Ok()
}

// Every regular `*.json.zst` file under `root`, in byte order of its path.
targets: fn(root: String) -[FS]> [String] PublishError! {
    found := [String]{}
    pending := [root.copy()]
    loop pending.len() > 0 {
        dir: pending.pop() ?? break
        entries: files.list_dir(dir) ?? return Err(failed("cannot list {dir}: {err}"))
        loop entry in entries {
            path: "{dir}/{entry.name}"
            info: files.stat(path) ?? return Err(failed("cannot inspect {path}: {err}"))
            if info.is_symlink -> next
            if {
                info.is_dir -> pending.push(path)
                info.is_file && entry.name.ends_with(".json.zst") -> found.push(path)
                else -> {}
            }
        }
    }
    found.sort()
    Ok(found)
}

// Run `argv` on the terminal's stdio; a nonzero exit (or a signal) ends the
// run with that status, as `set -e` ends the shell.
call: fn(argv: [String]) -[Exec, Time.Wait]> PublishError! {
    receipt: process.cmd(argv.copy()).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? return Err(failed("cannot run {argv[0]}: {err}"))
    if receipt.signal == .Val(number) -> return Err(PublishError{message: "", code: 128 + number})
    if receipt.code != 0 -> return Err(PublishError{message: "", code: receipt.code})
    Ok()
}

// Sign `request` into `output` once: the signer writes a temporary file
// beside it, which must be a regular file. An existing signature must hold
// the same bytes; a new one is renamed into place.
sign_immutable: fn(signer: String, request: String, output: String) -[Env, Exec, FS, Time.Wait]> PublishError! {
    temporary: "{output}.partial.{sys.getpid()}"
    if call([signer.copy(), request.copy(), temporary.copy()]) == .Err(error) {
        files.remove(temporary).drop("the partial signature is removed best-effort")
        return Err(error)
    }
    made: files.stat(temporary) ?? return Err(failed("signer did not create a regular file: {temporary}"))
    if made.is_symlink || !made.is_file {
        files.remove(temporary).drop("the partial signature is removed best-effort")
        return Err(failed("signer did not create a regular file: {temporary}"))
    }
    if files.stat(output) == .Ok(existing) {
        if existing.is_symlink || !existing.is_file {
            files.remove(temporary).drop("the partial signature is removed best-effort")
            return Err(failed("signature output is not a regular file: {output}"))
        }
        fresh: files.read_bytes(temporary) ?? return Err(failed("cannot read {temporary}: {err}"))
        held: files.read_bytes(output) ?? return Err(failed("cannot read {output}: {err}"))
        files.remove(temporary).drop("the partial signature is removed best-effort")
        if fresh != held -> return Err(failed("immutable signature changed: {output}"))
        return Ok()
    }
    files.rename(temporary, output) ?? return Err(failed("cannot move {temporary} to {output}: {err}"))
    Ok()
}
