#!/usr/bin/env jet
// Give a compiler that a seed built from this checkout the seed's runtime pack
// and identity (Docs/spec/contributing/bootstrap.md). The pack is reused only
// when it was built from this checkout's runtime inputs: its provenance.json
// lists the source, backend and lifecycle inventories
// Tools/packaging/prebuild-runtime.mjs hashed, and each is recomputed here the
// same way and must match file for file. On a match, `<seed>/jet-runtime/`
// replaces the one beside the compiler and `<seed>/IDENTITY` is copied beside
// it; on a mismatch nothing is written.
// Usage (from the checkout root): jet run Tools/packaging/ReuseSeedRuntime.jet -- <seed-dir> <jet>
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    term: core.term
}

RUNTIME_MANIFEST: "Compiler/JetRuntime/sources.list"
RUNTIME_PACKAGE: "Compiler/JetRuntime/package.jet"
RUNTIME_LIFECYCLE: "Compiler/JetRuntime/lifecycle.list"
// The runtime object's producers, as prebuild-runtime.mjs lists them.
BACKEND_SOURCES: [String]{"Compiler/JetIR/Source", "Compiler/JetBackend/Source", "Compiler/JetWeb/Source", "Compiler/JetWasm/Source"}

InventoryFile: struct {
    path: String
    sha256: String
}

Inventory: struct {
    name: String
    sha256: String
    files: [InventoryFile]
}

fail: fn(message: String) -> Never {
    term.eprint("reuse-seed-runtime: {message}")
    process.exit(1)
}

// prebuild-runtime.mjs `inventory`: the sorted unique paths, each file's
// sha256, and one sha256 over `<path byte count>:<path>:<size>:<bytes>` per file.
inventory: fn(name: String, paths: [String]) -> Inventory {
    sorted := paths
    sorted.sort()
    total := crypto.new()
    rows := [InventoryFile]{}
    loop path in sorted {
        if rows.len() > 0 && rows[rows.len() - 1].path == path -> next
        bytes: files.read_bytes(path) ?? fail("can't read `{path}`: {err}")
        total.update("{path.count_bytes()}:{path}:{bytes.len()}:".bytes())
        total.update(bytes)
        rows.push(InventoryFile{path: path.copy(), sha256: crypto.sha256(bytes).hex()})
    }
    Inventory{name: name, sha256: total.digest(), files: rows}
}

// Every `.jet` file under `directory`, as a checkout-relative path.
jet_files: fn(directory: String) -> [String] {
    found := [String]{}
    entries: files.walk_files(directory) ?? fail("can't list `{directory}`: {err}")
    loop entry in entries {
        if entry.relative.ends_with(".jet") -> found.push("{directory}/{entry.relative}")
    }
    found
}

// The three inventories prebuild-runtime.mjs records, for this checkout.
checkout_inventories: fn() -> [Inventory] {
    manifest: files.read(RUNTIME_MANIFEST) ?? fail("can't read `{RUNTIME_MANIFEST}`: {err}")
    sources := [String]{RUNTIME_MANIFEST, RUNTIME_PACKAGE}
    loop raw in manifest.split("\n") {
        row: raw.trim()
        if row != "" && !row.starts_with("#") -> sources.push(row.copy())
    }
    backend := [String]{}
    loop directory in BACKEND_SOURCES {
        loop path in jet_files(directory) -> backend.push(path)
    }
    [Inventory]{inventory("source", sources), inventory("backendInputs", backend), inventory("lifecycle", [String]{RUNTIME_LIFECYCLE})}
}

field: fn(value: Dyn, key: String) -> Dyn? Never! {
    if value == {
        .Object(fields) -> {
            loop entry in fields {
                if entry.key == key -> return Val(entry.value.copy())
            }
        }
        else -> {}
    }
    None
}

text: fn(value: Dyn?) -> String Never! {
    if value == {
        .Val(.Text(found)) -> found
        else -> ""
    }
}

// One provenance inventory: its `sha256` and its `files` rows.
recorded_inventory: fn(provenance: Dyn, name: String, origin: String) -> Inventory {
    recorded: field(provenance, name) ?? fail("`{origin}` has no `{name}` inventory")
    rows := [InventoryFile]{}
    if field(recorded, "files") == {
        .Val(.Array(items)) -> {
            loop item in items -> rows.push(InventoryFile{path: text(field(item, "path")), sha256: text(field(item, "sha256"))})
        }
        else -> fail("`{origin}` has no `{name}` file list")
    }
    Inventory{name: name, sha256: text(field(recorded, "sha256")), files: rows}
}

// The paths whose bytes differ between the two inventories, or that only one lists.
differing: fn(recorded: Inventory, checkout: Inventory) -> [String] {
    theirs := [String: String]{}
    loop row in recorded.files {
        theirs[row.path.copy()] = row.sha256.copy()
    }
    ours := [String: String]{}
    paths := [String]{}
    loop row in checkout.files {
        ours[row.path.copy()] = row.sha256.copy()
        if theirs.get(row.path) != Val(row.sha256) -> paths.push(row.path.copy())
    }
    loop row in recorded.files {
        if ours.get(row.path) == None -> paths.push(row.path.copy())
    }
    paths.sort()
    paths
}

run: fn() {
    args: process.args()
    if args.len() != 2 -> fail("usage: jet run Tools/packaging/ReuseSeedRuntime.jet -- <seed-dir> <jet>")
    seed: args[0].copy()
    compiler: args[1].copy()
    if !files.exists(RUNTIME_MANIFEST) -> fail("run this from the root of a Jet checkout: `{RUNTIME_MANIFEST}` is missing")
    if !files.exists(compiler) -> fail("the compiler `{compiler}` does not exist")
    pack: files.join(seed, "jet-runtime")
    origin: files.join(pack, "provenance.json")
    identity: files.join(seed, "IDENTITY")
    if !files.exists(identity) -> fail("the seed has no `{identity}`")
    provenance: json.parse(files.read(origin) ?? fail("can't read the seed's runtime provenance `{origin}`: {err}")) ?? fail("`{origin}` is not JSON: {err}")
    changed := [String]{}
    total := 0
    loop checkout in checkout_inventories() {
        recorded: recorded_inventory(provenance, checkout.name, origin)
        total += checkout.files.len()
        if recorded.sha256 == checkout.sha256 -> next
        paths: differing(recorded, checkout)
        if paths.len() == 0 -> fail("`{origin}` records a `{checkout.name}` hash its own file rows do not give")
        loop path in paths -> changed.push(path)
    }
    if changed.len() > 0 {
        fail("the seed's runtime pack `{pack}` was not built from this checkout: {changed.len()} of this checkout's {total} runtime input files differ from the pack's, first `{changed[0]}`.\nUse the latest published Jet release as the seed (its runtime pack matches its commit), or rebuild the runtime pack for this checkout with `Tools/packaging/prebuild-runtime.sh {compiler}`.")
    }
    directory: files.dirname(files.absolute(compiler) ?? fail("can't resolve `{compiler}`: {err}"))
    destination: files.join(directory, "jet-runtime")
    if files.exists(destination) -> files.remove_all(destination) ?? fail("can't replace `{destination}`: {err}")
    files.copy_dir(pack, destination) ?? fail("can't copy `{pack}` to `{destination}`: {err}")
    files.copy(identity, files.join(directory, "IDENTITY")) ?? fail("can't copy `{identity}` beside `{compiler}`: {err}")
    term.print("reuse-seed-runtime: {total} runtime input files match; installed `{pack}` and `{identity}` beside `{compiler}`")
}
