// Rust: Tools/ci/compiled-workload-peer-launcher.rs:414
fn install_disabled_network_filter() -> Err! {
    socket :: peer_socket_syscall(selected_arch()).map_err(reason -> reason.message)?
    filter :: peer_disabled_network_filter(socket)
    #Unsafe("the stack filter and C SockFprog stay live until synchronous prctl copies all four rows") {
        program :: SockFprog { len: filter.len() as U16, filter: filter.as_ptr() }
        if peer_prctl_no_new_privileges() != 0 {
            error :: io.Error.last_os_error()
            return Err("Linux peer isolation unavailable: seccomp no_new_privs failed: {error}")
        }
        if peer_prctl_socket_filter(&program as *SockFprog) != 0 {
            error :: io.Error.last_os_error()
            return Err("Linux peer isolation unavailable: seccomp socket filter failed: {error}")
        }
    }
    Ok()
}

// Rust: Tools/ci/compiled-workload-peer-launcher.rs:463
fn linux_capability_check() -> Err! {
    bwrap :: peer_find_on_path("bwrap", false).ok_or_else(() -> "Linux peer isolation unavailable: bubblewrap (`bwrap`) is not available on PATH")?
    shell :: peer_find_on_path("sh", false).ok_or_else(() -> "Linux peer isolation unavailable: POSIX `sh` is not available on PATH")?
    ip :: peer_find_on_path("ip", false).ok_or_else(() -> "Linux peer isolation unavailable: `ip` is required to enable loopback-only networking")?
    launcher :: env.current_exe().and_then(path -> fs.canonicalize(path)).map_err(error -> "Linux peer isolation unavailable: launcher path cannot be resolved: {error}")?
    root :: peer_probe_root().map_err(reason -> reason.message)?
    loop policy in [PeerNetworkPolicy.Disabled, PeerNetworkPolicy.LoopbackOnly] {
        args := peer_linux_base_args(root, root, policy)
        args.push("--")
        args.push(launcher.to_string_lossy().into_owned())
        if policy == PeerNetworkPolicy.LoopbackOnly {
            args.extend(["--internal-loopback", ip, shell, "-c", "exit 0"])
        } else {
            args.extend(["--internal-disabled", shell, "-c", "exit 0"])
        }
        result :: Command.new(bwrap).args(args).stdout(Stdio.null()).stderr(Stdio.piped()).output()
            .map_err(error -> "Linux peer isolation unavailable: bubblewrap {policy:?} probe failed: {error}")?
        if !result.status.success() {
            _ :: fs.remove_dir_all(root)
            stderr := String.from_utf8_lossy(result.stderr) // #4303
            return Err("Linux peer isolation unavailable: bubblewrap {policy:?} probe exited {result.status}{peer_clean_probe_stderr(stderr)}")
        }
    }
    _ :: fs.remove_dir_all(root)
    Ok()
}
