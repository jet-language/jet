// Rust: Tools/ci/compiled-workload-peer-launcher.rs:339
fn capability_check() -> Err! {
    match selected_os() {
        "linux" -> linux_capability_check()
        "macos" -> macos_capability_check()
        "windows" -> windows_capability_check()
        host -> Err("unsupported host `{host}`: native peer isolation is implemented only on Linux, macOS, and Windows")
    }
}
