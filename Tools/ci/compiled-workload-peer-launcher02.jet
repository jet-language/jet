// Rust: Tools/ci/compiled-workload-peer-launcher.rs:578
fn run_linux(invocation: PeerInvocation) -> ExitStatus Err! {
    bwrap :: peer_find_on_path("bwrap", false).ok_or_else(() -> "Linux peer isolation unavailable: bubblewrap disappeared from PATH")?
    ip :: peer_find_on_path("ip", false).ok_or_else(() -> "Linux peer isolation unavailable: `ip` disappeared from PATH")?
    launcher :: env.current_exe().and_then(path -> fs.canonicalize(path)).map_err(error -> "Linux peer isolation unavailable: launcher path cannot be resolved: {error}")?
    command :: peer_resolve_program(invocation.command, false).map_err(reason -> reason.message)?
    stamp :: SystemTime.now().duration_since(UNIX_EPOCH).map_err(error -> "Linux peer isolation clock failed: {error}")?.as_nanos()
    status_file :: OSPath.from(invocation.root).join(".compiled-workload-peer-status-{process.id()}-{stamp}")
    fs.OpenOptions.new().write(true).create_new(true).open(status_file)
        .map_err(error -> "Linux peer isolation signal status cannot be created at `{status_file.display()}`: {error}")?
    child_command := Command.new(bwrap)
    child_command.args(peer_linux_base_args(invocation.root, invocation.cwd, invocation.network)).arg("--").arg(launcher)
    if invocation.network == PeerNetworkPolicy.LoopbackOnly {
        child_command.arg("--internal-loopback").arg("--status-file").arg(status_file).arg(ip).arg(command).args(invocation.args)
    } else {
        child_command.arg("--internal-disabled").arg("--status-file").arg(status_file).arg(command).args(invocation.args)
    }
    result :: run_unix_child(^child_command)
    reported :: peer_read_linux_signal(status_file.to_string_lossy()).map_err(reason -> reason.message)
    cleanup :: fs.remove_file(status_file)
    if Err(reason) :: cleanup -> return Err("Linux peer isolation signal status cannot be removed from `{status_file.display()}`: {reason}")
    match reported {
        Ok(signal) if signal.is_some() -> {
            number :: signal.unwrap() as I32
            signal_hook(number, none)
            peer_raise_signal(number)
            Err("Linux peer isolation signal {number} could not propagate")
        }
        Ok(_) -> result
        Err(reason) -> Err(reason)
    }
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:650
