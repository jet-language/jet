// GATE #4494: windows_status/windows_output_with_read_only_mounts exact native provider ABI.

// Rust: Tools/ci/compiled-workload-peer-launcher.rs:730
fn windows_capability_check() -> Err! {
    status :: windows_native.windows_status()
    if !status.available -> return Err("Windows peer isolation unavailable: {status.reason}")
    netsh :: peer_resolve_program("netsh", true).map_err(reason -> reason.message)?
    result :: Command.new(netsh).args(["advfirewall", "show", "allprofiles"]).stdout(Stdio.null()).stderr(Stdio.piped()).output()
        .map_err(error -> "Windows peer isolation unavailable: Firewall probe failed: {error}")?
    if !result.status.success() {
        stderr := String.from_utf8_lossy(result.stderr) // #4303
        return Err("Windows peer isolation unavailable: Firewall probe exited {result.status}{peer_clean_probe_stderr(stderr)}")
    }
    Ok()
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:756
// FirewallGuard -> PeerFirewallGuard (370-423): install763, add_rule787,
// cleanup823 and Drop845 map to install373/add_rule391/cleanup400/Close418.

// Rust: Tools/ci/compiled-workload-peer-launcher.rs:850
fn run_invocation(invocation: PeerInvocation) -> ExitStatus Err! {
    task_id :: invocation.task_id
    result :: match selected_os() {
        "linux" -> run_linux(^invocation)
        "macos" -> run_macos(^invocation)
        "windows" -> run_windows(^invocation)
        else -> Err("native peer isolation is unavailable on this host")
    }
    result.map_err(reason -> "task `{task_id}`: {reason}")
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:875
fn run_macos(invocation: PeerInvocation) -> ExitStatus Err! {
    command :: peer_resolve_program(invocation.command, false).map_err(reason -> reason.message)?
    profile :: peer_macos_profile(invocation.root, invocation.network)
    child_command := Command.new("/usr/bin/sandbox-exec")
    child_command.args(["-p", profile]).arg(command).args(invocation.args).current_dir(invocation.cwd)
    run_unix_child(^child_command)
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:888
fn run_windows(invocation: PeerInvocation) -> ExitStatus Err! {
    command :: peer_resolve_program(invocation.command, true).map_err(reason -> reason.message)?
    firewall := PeerFirewallGuard.install(command, invocation.network).map_err(reason -> reason.message)?
    environment :: env.vars().collect<[String:String]>()
    result :: windows_native.windows_output_with_read_only_mounts(command, invocation.args, OSPath.from(invocation.root), none, environment,
        invocation.network == PeerNetworkPolicy.LoopbackOnly, true, true, [], none, none)
        .map_err(error -> "Windows peer isolation launch failed: {error:?}")
    cleanup :: firewall.as_mut().map(guard -> guard.cleanup()).transpose()
    if Err(error) :: cleanup -> return Err(error.message)
    output :: result?
    io.stdout().write_all(output.output.stdout).map_err(error -> "stdout propagation failed: {error}")?
    io.stderr().write_all(output.output.stderr).map_err(error -> "stderr propagation failed: {error}")?
    Ok(output.output.status)
}

// Rust: Tools/ci/compiled-workload-peer-launcher.rs:921
static FORWARDED_SIGNAL :: AtomicI32.new(0)
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:924
#FFI(c)
fn forward_signal(signal: I32) -> {
    // GATE #4494: no-runtime-entry callback, no allocation/locking/tagged Int conversion.
    FORWARDED_SIGNAL.store(signal, Ordering.Release)
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:929
fn install_signal_handlers() -> {
    signal_hook(2, forward_signal)
    signal_hook(15, forward_signal)
    signal_hook(1, forward_signal)
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:938
fn run_unix_child(command: Command) -> ExitStatus Err! { run_unix_child_inner(^command, false) }
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:943
fn run_linux_inner_child(command: Command) -> ExitStatus Err! { run_unix_child_inner(^command, true) }
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:948
fn run_unix_child_inner(command: Command, cleanup_namespace: Bool) -> ExitStatus Err! {
    install_signal_handlers()
    command.process_group(0)
    command.stdin(Stdio.inherit()).stdout(Stdio.inherit()).stderr(Stdio.inherit())
    child := command.spawn().map_err(error -> "native peer isolation child could not start: {error}")?
    process_group :: child.id() as I32
    loop {
        if signal :: take_signal() {
            peer_kill_group(process_group, signal)
            _ :: cleanup_namespace_processes(signal, cleanup_namespace)
            _ :: child.wait()
            peer_kill_group(process_group, 9)
            _ :: cleanup_namespace_processes(9, cleanup_namespace)
            signal_hook(signal, none)
            peer_raise_signal(signal)
            return Err("launcher interrupted by signal {signal}")
        }
        match child.try_wait() {
            Ok(status) if status.is_some() -> {
                peer_kill_group(process_group, 15)
                cleanup_error := cleanup_namespace_processes(15, cleanup_namespace).err()
                thread.sleep(Duration.from_millis(25))
                peer_kill_group(process_group, 9)
                cleanup_error = cleanup_namespace_processes(9, cleanup_namespace).err().or(cleanup_error)
                if reason :: cleanup_error -> return Err(reason)
                return Ok(status.unwrap())
            }
            Ok(_) -> thread.sleep(Duration.from_millis(5))
            Err(error) -> {
                peer_kill_group(process_group, 15)
                _ :: cleanup_namespace_processes(15, cleanup_namespace)
                _ :: child.wait()
                peer_kill_group(process_group, 9)
                _ :: cleanup_namespace_processes(9, cleanup_namespace)
                return Err("native peer isolation wait failed: {error}")
            }
        }
    }
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1003
fn take_signal() -> I32? {
    signal :: FORWARDED_SIGNAL.swap(0, Ordering.AcqRel)
    if signal != 0 -> signal else -> none
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1009
fn cleanup_namespace_processes(signal: I32, enabled: Bool) -> Err! {
    if !enabled -> return Ok()
    if selected_os() == "linux" {
        own :: process.id() as I32
        entries :: fs.read_dir("/proc").map_err(error -> "Linux peer process tree cannot be enumerated: {error}")?
        loop entry in entries {
            entry :: entry.map_err(error -> "Linux peer process tree cannot be enumerated: {error}")?
            name :: entry.file_name()
            text :: name.to_str() ?? next
            pid :: text.parse<I32>().ok() ?? next
            if pid <= 1 || pid == own -> next
            result :: #Unsafe("only other processes in this private Linux PID namespace are signalled; own supervisor and namespace init are excluded") {
                peer_os.kill(pid, signal)
            }
            if result == -1 {
                error :: io.Error.last_os_error()
                if error.raw_os_error() != 3 -> return Err("Linux peer process tree signal failed for pid {pid}: {error}")
            }
        }
    }
    Ok()
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1046
// kill_group -> peer_kill_group (443-447), negative private PGID raw native ABI.
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1053
fn finish_status(status: ExitStatus) -> Never {
    os :: selected_os()
    if os == "linux" || os == "macos" {
        if code :: status.code() -> process.exit(code)
        if signal :: status.signal() {
            signal_hook(signal, none)
            peer_raise_signal(signal)
            process.exit(128 + signal)
        }
        process.exit(PEER_EXIT_UNSUPPORTED)
    }
    if os == "windows" -> process.exit(status.code().unwrap_or(PEER_EXIT_UNSUPPORTED))
    process.exit(PEER_EXIT_UNSUPPORTED)
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1080
// kill/raise/signal/prctl native declarations remain the sole c.c/libc ABI owner.
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1092
// kill_process_group reuses that same native kill leaf through peer_kill_group.
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:1097
fn signal_hook(signal_number: I32, handler: (fn(I32) ->)?) -> {
    #Unsafe("POSIX null handler is SIG_DFL; non-null handler is the no-runtime-entry atomic-only C callback") {
        _ :: peer_os.signal(signal_number, handler)
    }
}
