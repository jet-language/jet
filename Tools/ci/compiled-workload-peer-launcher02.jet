use c.c as peer_os
// GATE #4494: actual process-group pre-exec ownership, native atomics, nullable
// no-runtime-entry signal callbacks, synchronous seccomp borrowed C ABI and
// AppContainer execution. No ambient fallback or Rust bridge.
// GATE #4483: every original cfg arm dispatches using selected target facts.

