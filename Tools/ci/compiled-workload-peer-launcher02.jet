// Rust: Tools/ci/compiled-workload-peer-launcher.rs:42
fn run() -> {
    args :: env.args().skip(1).collect<[String]>()
    if selected_os() == "linux" {
        if args.first().is_some_and(arg -> arg == "--internal-disabled") -> run_internal_disabled(args[1..])
        if args.first().is_some_and(arg -> arg == "--internal-loopback") -> run_internal_loopback(args[1..])
    }
    if args == ["--version"] {
        print(PEER_ISOLATION_CONTRACT)
        return
    }
    if args == ["--contract"] {
        match capability_check() { Ok(()) -> print(PEER_ISOLATION_CONTRACT); Err(reason) -> peer_fail(reason) }
        return
    }
    result :: peer_parse_invocation(args).map_err(reason -> reason.message).and_then(invocation -> {
        capability_check()?
        run_invocation(^invocation)
    })
    match result { Ok(status) -> finish_status(status); Err(reason) -> peer_fail(reason) }
}

// Rust: Tools/ci/compiled-workload-peer-launcher.rs:72
// run_internal_status_file is owned by peer_internal_status_file (305-311):
// status_file and command_index represent the same borrowed tail without copies.
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:86
fn run_internal_disabled(args: &[String]) -> Never {
    match install_disabled_network_filter() { Ok(()) -> {}; Err(reason) -> peer_fail(reason) }
    parsed :: peer_internal_status_file(args).unwrap_or_else(reason -> peer_fail(reason.message))
    run_internal_supervisor(args[parsed.command_index..], parsed.status_file.map(OSPath.from))
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:98
fn run_internal_loopback(args: &[String]) -> Never {
    parsed :: peer_internal_status_file(args).unwrap_or_else(reason -> peer_fail(reason.message))
    tail := args[parsed.command_index..]
    ip :: tail.first().unwrap_or_else(() -> peer_fail("loopback-only internal runner received no ip command"))
    if tail.get(1).is_none() -> peer_fail("loopback-only internal runner received no command")
    status :: Command.new(ip).args(["link", "set", "lo", "up"]).stdout(Stdio.null()).stderr(Stdio.null()).status()
        .map_err(error -> "loopback-only internal runner could not start `{ip}`: {error}")
    match status {
        Ok(status) if status.success() -> {}
        Ok(status) -> peer_fail("loopback-only internal runner `{ip}` exited {status}")
        Err(reason) -> peer_fail(reason)
    }
    run_internal_supervisor(tail[1..], parsed.status_file.map(OSPath.from))
}
// Rust: Tools/ci/compiled-workload-peer-launcher.rs:121
fn run_internal_supervisor(args: &[String], status_file: OSPath?) -> Never {
    command :: args.first().unwrap_or_else(() -> peer_fail("internal runner received no command"))
    child_command := Command.new(command)
    child_command.args(args[1..])
    match run_linux_inner_child(^child_command) {
        Ok(status) -> {
            if (path, signal) :: (status_file, status.signal()) {
                fs.write(path, [signal as U8]).map_err(error -> "internal runner signal status could not propagate: {error}")
                    .unwrap_or_else(reason -> peer_fail(reason))
            }
            finish_status(status)
        }
        Err(reason) -> peer_fail(reason)
    }
}

