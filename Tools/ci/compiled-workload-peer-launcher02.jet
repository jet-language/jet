// Rust: Tools/ci/compiled-workload-peer-launcher.rs:665
fn macos_capability_check() -> Err! {
    sandbox :: OSPath.from("/usr/bin/sandbox-exec")
    if !sandbox.is_file() -> return Err("macOS peer isolation unavailable: native Seatbelt `{sandbox.display()}` is unavailable")
    root :: peer_probe_root().map_err(reason -> reason.message)?
    loop policy in [PeerNetworkPolicy.Disabled, PeerNetworkPolicy.LoopbackOnly] {
        profile :: peer_macos_profile(root, policy)
        result :: Command.new(sandbox).args(["-p", profile, "/usr/bin/true"]).current_dir(root).stdout(Stdio.null()).stderr(Stdio.piped()).output()
            .map_err(error -> "macOS peer isolation unavailable: Seatbelt probe failed: {error}")?
        if !result.status.success() {
            _ :: fs.remove_dir_all(root)
            stderr := String.from_utf8_lossy(result.stderr) // #4303
            return Err("macOS peer isolation unavailable: Seatbelt probe for {peer_network_name(policy)} exited {result.status}{peer_clean_probe_stderr(stderr)}")
        }
    }
    _ :: fs.remove_dir_all(root)
    Ok()
}
