#!/usr/bin/env jet
// D-CI1: run one required gate and leave a candidate-bound receipt, including
// the failure path. Callers upload the report even when the gate is red.
//
// Usage (from the repository root):
//   jet Tools/ci/CiEvidence.jet --report-dir DIR -- COMMAND [ARG ...]
//
// DIR receives command.stdout, command.stderr, toolchain.txt, candidate.txt
// (jet.ci-candidate.v1) and receipt.txt (jet.ci-evidence.v1). A reused DIR
// holding any of them is refused before the command runs, so an old pass never
// sits beside a new failure. An identity problem (no 40-hex candidate commit,
// a candidate other than GITHUB_SHA or the checkout, a GitHub runner without
// its OS or architecture, an artifact name that does not end in the
// candidate) is a failure receipt and exit 78 without running the command. A
// receipt that cannot be finalized is exit 78 too: never a green gate.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

FAILED_IDENTITY: 78

Evidence: struct {
    root: String
    dir: String
    candidate: String
    checkout: String
    runner_os: String
    runner_arch: String
    artifact_name: String
    signature_candidate: String
    release_candidate: String
    started_at: String
    source_hash: String
    workflow_hash: String
    toolchain_hash: String
    command: [String]
}

run: fn() {
    args: process.args()
    if args.len() < 4 || args[0] != "--report-dir" || args[2] != "--" {
        process.fail(64, "usage: jet Tools/ci/CiEvidence.jet --report-dir DIR -- COMMAND [ARG ...]")
    }
    process.exit(gate(repo_root(), args[1], args[3..<args.len()]))
}

// The checkout holding this tool, else the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    tool: "/Tools/ci/CiEvidence.jet"
    script: sys.executable()
    if script.ends_with(tool) -> return script.removesuffix(tool)
    files.cwd() ?? "."
}

hash_file: fn(path: String) -[FS]> String Never! {
    if !files.is_file(path) -> return "unavailable"
    bytes: files.read_bytes(path) ?? return "unavailable"
    crypto.sha256(bytes).hex()
}

run_text: fn(argv: [String], dir: String) -[Exec, Time.Wait]> String Never! {
    receipt: process.cmd(argv).cwd(dir).run() ?? return ""
    if receipt.code != 0 -> return ""
    receipt.output.trim()
}

is_hex: fn(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70)) -> return false
    }
    true
}

pad: fn(value: Int, width: Int) -> String Never! {
    text := "{value}"
    loop text.len() < width -> text = "0{text}"
    text
}

utc_stamp: fn() -[Time]> String Never! {
    now: time.now()
    clock: now.time()
    "{time.isoformat_date(now.date())}T{pad(clock.hour(), 2)}:{pad(clock.minute(), 2)}:{pad(clock.second(), 2)}Z"
}

// `uname -s` spelling of the running system: Linux, Darwin, FreeBSD ...
system_name: fn() -[Env]> String Never! {
    name: sys.sysname()
    if {
        name == "macos" || name == "darwin" -> "Darwin"
        name == "freebsd" -> "FreeBSD"
        name == "" -> "unknown"
        else -> "{name[0..<1].upper()}{name[1..<name.len()]}"
    }
}

// One argument as bash's `printf %q` writes it.
shell_quote: fn(arg: String) -> String Never! {
    if arg == "" -> return "''"
    safe: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789,._+:@%/-="
    control := false
    loop ch in arg.chars() {
        if "{ch}" == "\n" || "{ch}" == "\t" || "{ch}" == "\r" -> control = true
    }
    out := ""
    if control {
        loop ch in arg.chars() {
            piece: "{ch}"
            out = if {
                piece == "\n" -> "{out}\\n"
                piece == "\t" -> "{out}\\t"
                piece == "\r" -> "{out}\\r"
                piece == "'" -> "{out}\\'"
                piece == "\\" -> "{out}\\\\"
                else -> "{out}{piece}"
            }
        }
        return "$'{out}'"
    }
    loop ch in arg.chars() {
        piece: "{ch}"
        out = if safe.contains(piece) -> "{out}{piece}" else -> "{out}\\{piece}"
    }
    out
}

evidence_paths: fn(dir: String) -> [String] Never! {
    [String]{"{dir}/command.stdout", "{dir}/command.stderr", "{dir}/receipt.txt", "{dir}/toolchain.txt", "{dir}/candidate.txt"}
}

regular: fn(path: String) -[FS]> Bool Never! { files.is_file(path) && !files.is_symlink(path) }

gate: fn(root: String, dir: String, command: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    files.create_dir_all(dir) ?? {
        term.eprint("cannot create the report directory {dir}: {err}")
        return 1
    }
    stdout_file: "{dir}/command.stdout"
    stderr_file: "{dir}/command.stderr"
    toolchain: "{dir}/toolchain.txt"
    github: (process.env_nonempty("GITHUB_ACTIONS") ?? "") == "true" || (process.env_nonempty("GITHUB_ACTIONS") ?? "") == "1"
    checkout: run_text([String]{"git", "-C", root, "rev-parse", "--verify", "HEAD"}, root)
    candidate: process.env_nonempty("JET_CI_CANDIDATE_COMMIT") ?? (process.env_nonempty("GITHUB_SHA") ?? checkout)
    runner_os := process.env_nonempty("RUNNER_OS") ?? (process.env_nonempty("GITHUB_RUNNER_OS") ?? "")
    runner_arch := process.env_nonempty("RUNNER_ARCH") ?? (process.env_nonempty("GITHUB_RUNNER_ARCH") ?? "")
    problems := [String]{}

    // A reused report directory can otherwise leave a previous pass beside a
    // new failed command. Refuse stale or non-regular evidence paths before
    // running the gate; a failure receipt can still replace a stale regular
    // file below.
    loop path in evidence_paths(dir) {
        if files.is_symlink(path) || (files.exists(path) && !files.is_file(path)) {
            problems.push("evidence path is not a regular file: {path}")
        } else if files.is_file(path) {
            problems.push("evidence report contains stale file: {path}")
        }
    }
    if github && runner_os == "" -> problems.push("GitHub runner OS identity is missing")
    if github && runner_arch == "" -> problems.push("GitHub runner architecture identity is missing")
    if runner_os == "" -> runner_os = if github -> "unknown" else -> system_name()
    if runner_arch == "" -> runner_arch = if github -> "unknown" else -> sys.arch()

    files.write(stdout_file, "") ?? problems.push("cannot initialize evidence stdout: {stdout_file}")
    nix: run_text([String]{"nix", "--version"}, root)
    files.write(toolchain, "=== nix ===\n{if nix == "" -> "(unavailable)" else -> nix}\n") ?? problems.push("cannot write toolchain evidence: {toolchain}")

    artifact_name: process.env_nonempty("JET_CI_ARTIFACT_NAME") ?? "not-published"
    signature_candidate: process.env_nonempty("JET_CI_SIGNATURE_CANDIDATE") ?? candidate
    release_candidate: process.env_nonempty("JET_CI_RELEASE_CANDIDATE") ?? candidate
    evidence: Evidence{
        root: root.copy(), dir: dir.copy(), candidate: candidate.copy(), checkout: checkout.copy(),
        runner_os: runner_os.copy(), runner_arch: runner_arch.copy(), artifact_name: artifact_name.copy(),
        signature_candidate: signature_candidate.copy(), release_candidate: release_candidate.copy(), started_at: utc_stamp(),
        source_hash: hash_file("{root}/flake.lock"), workflow_hash: hash_file("{root}/.github/workflows/ci.yml"),
        toolchain_hash: hash_file(toolchain), command: command.copy(),
    }

    if candidate == "" || !is_hex(candidate) -> problems.push("missing or invalid candidate commit identity")
    if candidate.len() != 40 -> problems.push("candidate commit identity must be a 40-character SHA-1")
    github_sha: process.env_nonempty("GITHUB_SHA") ?? ""
    if github_sha != "" && candidate != github_sha -> problems.push("candidate commit does not match GITHUB_SHA: {candidate} != {github_sha}")
    if checkout != "" && candidate != checkout -> problems.push("candidate commit does not match checked-out revision: {candidate} != {checkout}")
    if artifact_name != "not-published" && !artifact_name.ends_with("-{candidate}") -> problems.push("artifact name does not identify candidate: {artifact_name}")
    if signature_candidate != candidate -> problems.push("signature candidate does not match candidate commit: {signature_candidate} != {candidate}")
    if release_candidate != candidate -> problems.push("release metadata candidate does not match candidate commit: {release_candidate} != {candidate}")
    if evidence.source_hash == "unavailable" || evidence.workflow_hash == "unavailable" || evidence.toolchain_hash == "unavailable" {
        problems.push("candidate identity hash is unavailable")
    }

    if problems.len() > 0 {
        files.write(stderr_file, "{problems[0]}\n") ?? ()
        term.eprint(problems[0])
        if !finalize(evidence, "fail", "{FAILED_IDENTITY}") -> term.eprint("evidence finalization failed; refusing a green gate")
        return FAILED_IDENTITY
    }

    spec: process.cmd(command).stdin(.Inherit).stdout(.Capture).stderr(.Capture).output_limit(1073741824)
    results: process.run_all([ProcessSpec]{spec}, 1) ?? return start_failed(evidence, "{err}")
    receipt: results[0] ?? return start_failed(evidence, "{err}")
    code: if receipt.signal == .Val(number) -> 128 + number else -> receipt.code
    files.write(stdout_file, receipt.output) ?? ()
    files.write(stderr_file, receipt.errors) ?? ()
    out := term.stdout()
    out.write(receipt.output).drop("gate stdout")
    errors := term.stderr()
    errors.write(receipt.errors).drop("gate stderr")
    status: if code == 0 && candidate != "" && candidate != "unknown" -> "pass" else -> "fail"
    if !finalize(evidence, status, "{code}") {
        term.eprint("evidence finalization failed; refusing a green gate")
        return if code == 0 -> FAILED_IDENTITY else -> code
    }
    code
}

// The command could not start: bash's `command not found` status.
start_failed: fn(evidence: Evidence, reason: String) -[Env, FS, IO]> Int Never! {
    message: "{evidence.command[0]}: {reason}"
    files.write("{evidence.dir}/command.stderr", "{message}\n") ?? ()
    term.eprint(message)
    if !finalize(evidence, "fail", "127") -> term.eprint("evidence finalization failed; refusing a green gate")
    127
}

// Write candidate.txt then receipt.txt, each through a temporary file, and
// confirm every evidence file is a regular file.
finalize: fn(e: Evidence, status: String, command_exit: String) -[Env, FS, IO]> Bool Never! {
    matrix: process.env_nonempty("JET_CI_SUPPORT_MATRIX") ?? "{e.runner_os}/{e.runner_arch}"
    run_id: process.env_nonempty("GITHUB_RUN_ID") ?? "local"
    attempt: process.env_nonempty("GITHUB_RUN_ATTEMPT") ?? "1"
    ref: process.env_nonempty("GITHUB_REF") ?? "local"
    shown: if e.candidate == "" -> "unknown" else -> e.candidate.copy()
    bindings: "source_candidate_commit={e.candidate}\ntoolchain_candidate_commit={e.candidate}\nartifact_candidate_commit={e.candidate}\nsignature_candidate_commit={e.signature_candidate}\ntest_candidate_commit={e.candidate}\nsupport_matrix_candidate_commit={e.candidate}\nprovenance_candidate_commit={e.candidate}\nrelease_metadata_candidate_commit={e.release_candidate}\n"
    manifest: "schema=jet.ci-candidate.v1\ncandidate_commit={e.candidate}\n{bindings}source_revision={if e.checkout == "" -> "unknown" else -> e.checkout}\nsource_manifest_sha256={e.source_hash}\nworkflow_sha256={e.workflow_hash}\ntoolchain_sha256={e.toolchain_hash}\nartifact_name={e.artifact_name}\nsignature=not-required-for-ci-test-gate\nsupport_matrix={matrix}\nprovenance=github-actions:{run_id}/{attempt}\nrelease_ref={ref}\n"
    candidate_path: "{e.dir}/candidate.txt"
    if !replace(candidate_path, manifest) -> return false
    quoted := ""
    loop arg in e.command -> quoted = "{quoted}{shell_quote(arg)} "
    receipt := "schema=jet.ci-evidence.v1\nstatus={status}\ncandidate_commit={shown}\ncandidate_manifest={candidate_path}\n{bindings}"
    receipt = "{receipt}runner_os={e.runner_os}\nrunner_arch={e.runner_arch}\nworkflow={process.env_nonempty("GITHUB_WORKFLOW") ?? "CI"}\njob={process.env_nonempty("GITHUB_JOB") ?? "local"}\nrun_id={run_id}\nrun_attempt={attempt}\nevent={process.env_nonempty("GITHUB_EVENT_NAME") ?? "local"}\nref={ref}\n"
    receipt = "{receipt}test_shard={process.env_nonempty("JET_TEST_SHARD") ?? "not-applicable"}\ntest_shard_count={process.env_nonempty("JET_TEST_SHARD_COUNT") ?? "not-applicable"}\nsupport_matrix={matrix}\nartifact_name={e.artifact_name}\nprovenance=github-actions:{run_id}/{attempt}\nrelease_ref={ref}\n"
    receipt = "{receipt}source_manifest_sha256={e.source_hash}\nworkflow_sha256={e.workflow_hash}\ntoolchain_sha256={e.toolchain_hash}\nstarted_at={e.started_at}\ncommand_exit={command_exit}\ncommand={quoted}\nstdout={e.dir}/command.stdout\nstderr={e.dir}/command.stderr\nsignature=not-required-for-ci-test-gate\npublication=github-actions-artifact\n"
    if !replace("{e.dir}/receipt.txt", receipt) -> return false
    loop path in evidence_paths(e.dir) {
        if !regular(path) {
            term.eprint("evidence report incomplete: missing regular file {path}")
            return false
        }
    }
    true
}

// Replace `path` with `text` through a temporary file; refuse a symlink or a
// non-file at `path`.
replace: fn(path: String, text: String) -[Env, FS]> Bool Never! {
    if files.is_symlink(path) || (files.exists(path) && !files.is_file(path)) -> return false
    temporary: "{path}.tmp.{sys.pid()}"
    files.write(temporary, text) ?? return false
    files.rename(temporary, path) ?? {
        files.remove(temporary) ?? ()
        return false
    }
    regular(path)
}

#Test("arguments are quoted the way printf %q writes them") {
    assert_eq(shell_quote("bash"), "bash")
    assert_eq(shell_quote(""), "''")
    assert_eq(shell_quote("printf 'gate-ok\\n'"), "printf\\ \\'gate-ok\\\\n\\'")
    assert_eq(shell_quote("a\nb"), "$'a\\nb'")
    assert_eq(shell_quote("--report-dir=/x/y"), "--report-dir=/x/y")
}
