#!/usr/bin/env jet
// Card #1414: the workload Tools/ci/CompiledWorkloadPeerLauncherCheck.jet runs
// under the native peer launcher. Each mode prints what the sandbox allowed,
// so the check compares exact output. Built with `jet build`, never run alone.
// Usage: compiled-workload-peer-probe write|network|descendant|delayed|signal|result
use {
    files :: core.files
    net :: core.net
    process :: core.process
    sys :: core.sys
    term :: core.term
    time :: core.time
}

// An address in TEST-NET-2 (RFC 5737): never routed, so only a sandbox that
// lets the connect attempt out could see anything but a timeout.
EXTERNAL :: "198.51.100.1:9"
CONNECT_TIMEOUT_MS :: 350

fn run() {
    args :: process.args()
    mode :: if args.len() > 0 -> args[0].copy() else -> ""
    if mode == "write" {
        write_mode()
    } else if mode == "network" {
        network_mode()
    } else if mode == "descendant" {
        descendant_mode()
    } else if mode == "delayed" {
        delayed_mode()
    } else if mode == "signal" {
        signal_mode()
    } else if mode == "result" {
        term.print("stdout-exact")
        term.eprint("stderr-exact")
        process.exit(23)
    } else {
        process.exit(91)
    }
}

// The working directory is writable; the file outside the root is not.
fn write_mode() -[Env, Exec, FS, IO]> {
    files.write("inside", "inside\n") ?? {
        term.eprint("inside write failed: {err}")
        process.exit(1)
        return
    }
    outside :: process.env_get("PEER_OUTSIDE") ?? ""
    if files.write(outside, "outside\n") == {
        .Ok(_) -> term.print("outside=allowed")
        .Err(_) -> term.print("outside=blocked")
    }
}

fn network_mode() -[IO, Net, Time.Wait]> {
    term.print(if loopback_reachable() -> "loopback=allowed" else -> "loopback=blocked")
    term.print(if external_reachable() -> "external=allowed" else -> "external=blocked")
}

// A listener on an ephemeral loopback port accepts a connection.
fn loopback_reachable() -[Net, Time.Wait]> Bool Never! {
    listener :: net.tcp_listen("127.0.0.1:0") ?? return false
    addr :: net.listener_local_socket_addr(listener) ?? return false
    if net.tcp_connect_timeout(addr, CONNECT_TIMEOUT_MS) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

fn external_reachable() -[Net, Time.Wait]> Bool Never! {
    addr :: net.socket_addr_parse(EXTERNAL) ?? return false
    if net.tcp_connect_timeout(addr, CONNECT_TIMEOUT_MS) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

// Leaves a detached `delayed` child behind; the launcher must end it.
fn descendant_mode() -[Env, Exec, IO]> {
    if process.cmd([String]{sys.executable(), "delayed"}).detached().spawn() == {
        .Ok(_) -> term.print("spawned")
        .Err(failure) -> {
            term.eprint("descendant spawn failed: {failure}")
            process.exit(1)
        }
    }
    process.exit(0)
}

fn delayed_mode() -[Env, FS, Time]> {
    time.sleep(600ms)
    marker :: process.env_get("PEER_MARKER") ?? return
    files.write(marker, "survived\n") ?? ()
}

fn signal_mode() -[Env, Exec, Time]> {
    #Unsafe("posix kill: the probe ends itself with SIGTERM so the check observes the launcher propagating a signal death") {
        sys.kill(sys.getpid(), 15) ?? ()
    }
    time.sleep(1000ms)
    process.exit(92)
}
