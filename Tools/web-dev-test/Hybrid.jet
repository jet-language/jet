#!/usr/bin/env jet
// The `jet dev --target=web --canvas` hybrid status matrix in a real browser:
//
//   jet run --allow=Env,Exec,FS,IO,Net,Time Tools/web-dev-test/Hybrid.jet -- \
//     --port <port> --source <app.jet> [--terminal-transcript <file>] [--browser chromium|firefox]
//
// core.web.browser launches the engine pinned in the working directory's
// `.jet/lock` and drives the dev page over WebDriver BiDi. The ready pill
// names the port and one client; a broken save opens the build-error overlay
// (title, diagnostic code and source, footer matching the pill) while app.js
// stays last-good; Esc collapses the overlay but keeps the error pill; taking
// the page offline shows the reconnecting pill and shade, the terminal and
// /__jet_dev_status report reconnecting over the retained error, and a clean
// save while offline rebuilds underneath the reconnect state; back online the
// page reloads to ready with the rebuilt app.js. It prints `PASS hybrid
// dev-server browser matrix` and exits 0, or names the failed check and exits 1.
use {
    browser: core.web.browser
    core.web.browser.[Browser, BrowserProtocol]
    client: core.http.client
    files: core.files
    json: core.encoding.json
    process: core.process
    time: core.time
}

C_WAIT_MS: 15000
C_POLL_MS: 80
C_BODY_LIMIT: 268435456
// WebDriver's Escape key, U+E00C.
C_ESCAPE_UTF8: [U8]{238, 128, 140}

C_FETCH_APP_JS: "fetch('/app.js', {{cache:'no-store'}}).then((r) => r.text())"
C_PILL: "(document.querySelector('#jet-dev-pill .label')?.textContent || '')"
C_OVERLAY: "JSON.stringify({{ title: document.querySelector('#jet-dev-overlay h3')?.textContent || '', body: document.querySelector('#jet-dev-overlay pre')?.textContent || '', footer: document.querySelector('#jet-dev-overlay footer')?.textContent || '', pill: document.querySelector('#jet-dev-pill .label')?.textContent || '' }})"

#Error
Failure: struct {
    message: String

    impl Display {
        display: fn(self) -> String { self.message }
    }
}

// The launched session and the BiDi context id of the tab it drives.
Driver: struct {
    session: Browser
    bidi: BrowserProtocol
    context: String
}

Options: struct {
    port: String
    source: String
    transcript: String
}

run: fn() {
    args: process.args()
    options: Options{port: option(args, "--port") ?? "", source: option(args, "--source") ?? "", transcript: option(args, "--terminal-transcript") ?? ""}
    engine: option(args, "--browser") ?? "chromium"
    if (Int.parse(options.port) ?? 0) <= 0 || options.source == "" {
        eprint("usage: Hybrid.jet --port <port> --source <app.jet> [--terminal-transcript <file>] [--browser chromium|firefox]")
        process.exit(2)
    }
    driver: open(engine) ?? fail(err.message)
    matrix(driver, options) ?? {
        driver.session.close().drop("the engine also stops with the session's last owner")
        fail(err.message)
    }
    driver.session.close().drop("the engine also stops with the session's last owner")
    print("PASS hybrid dev-server browser matrix")
}

matrix: fn(d: Driver, o: Options) Failure! {
    original: files.read(o.source) ?? return Err(Failure{message: "cannot read {o.source}: {err}"})
    broken: original.replace("print(size.height)", "missing_hybrid_symbol()")
    recovered: original.replace("ui.node(\"hello\",", "ui.node(\"hello there\",")
    check(broken != original && recovered != original, "fixture markers missing")

    navigate(d, "http://127.0.0.1:{o.port}/")
    wait_for(d, "{C_PILL}.includes('ready') && {C_PILL}.includes('1 client')", "ready browser parity pill")
    ready: value(d, C_PILL)
    check(ready.contains("localhost:{o.port}"), "ready pill missing port: {ready}")
    initial_js: value(d, C_FETCH_APP_JS)
    perform(d, "window.__jetReconnectProbe = 'must disappear on recovery'")

    files.write(o.source, broken) ?? return Err(Failure{message: "cannot write {o.source}: {err}"})
    wait_for(d, "document.getElementById('jet-dev-overlay')?.style.display === 'flex'", "expanded build-error overlay")
    overlay: json.parse(value(d, C_OVERLAY)) ?? return Err(Failure{message: "overlay facts are not JSON: {err}"})
    title: text(field(overlay, "title"))
    body: text(field(overlay, "body"))
    check(title.contains("Build failed — app.jet"), "bad overlay title: {title}")
    check(body.contains("Error [jet.UnknownFunction]"), "diagnostic code missing: {body}")
    check(body.contains("missing_hybrid_symbol"), "diagnostic body missing source: {body}")
    check(text(field(overlay, "footer")).starts_with(text(field(overlay, "pill"))), "overlay footer drifted from parity pill")
    check(value(d, C_FETCH_APP_JS) == initial_js, "broken rebuild replaced last-good app.js")

    press(d, String.from_bytes(C_ESCAPE_UTF8) ?? "")
    wait_for(d, "document.getElementById('jet-dev-overlay')?.style.display === 'none'", "Esc overlay collapse")
    check(value(d, "{C_PILL}.startsWith('error')") == "true", "Esc hid shared error status")

    reconnects_before: transcript(o).count("jet dev  [reconnecting]")
    set_offline(d, true)
    wait_for(d, "{C_PILL}.startsWith('reconnecting')", "reconnecting pill")
    check(value(d, "document.getElementById('jet-dev-shade')?.style.display === 'block'") == "true", "reconnecting state did not dim last-good page")
    if o.transcript != "" {
        wait_log(o, 0, "jet dev  [reconnecting]", reconnects_before + 1, "missing_hybrid_symbol", "matching terminal reconnect state over retained error")
    }
    reconnect_error: status(o)
    check(text(field(reconnect_error, "state")) == "reconnecting", "server did not override error: {json.to_string(reconnect_error) ?? ""}")
    check(text(field(reconnect_error, "code")) == "E0102", "reconnect lost error code: {json.to_string(reconnect_error) ?? ""}")
    check(text(field(reconnect_error, "diagnostic")).contains("missing_hybrid_symbol"), "reconnect lost diagnostic: {json.to_string(reconnect_error) ?? ""}")

    // Rebuild clean while the transport stays offline: the browser keeps its
    // local reconnect state, and the terminal keeps the shared reconnect
    // override across building -> ready, publishing the rebuild underneath.
    offline_offset: transcript(o).len()
    files.write(o.source, recovered) ?? return Err(Failure{message: "cannot write {o.source}: {err}"})
    if o.transcript != "" {
        wait_log(o, offline_offset, "save app.jet  →  rebuilt", 1, "", "offline clean rebuild under reconnect override")
        log: transcript(o)
        offline_build: log.slice(offline_offset, log.len())
        check(offline_build.contains("jet dev  [reconnecting] waiting for connection"), "offline rebuild lost reconnect header: {offline_build}")
        check(!offline_build.contains("jet dev  [building]"), "building leaked through reconnect: {offline_build}")
        check(!offline_build.contains("jet dev  [ready]"), "ready leaked through reconnect: {offline_build}")
    }
    reconnect_ready: status(o)
    check(text(field(reconnect_ready, "state")) == "reconnecting", "server did not override rebuilt ready: {json.to_string(reconnect_ready) ?? ""}")
    check(text(field(reconnect_ready, "code")) == "", "clean rebuild retained stale error: {json.to_string(reconnect_ready) ?? ""}")
    check(number(field(reconnect_ready, "last_build_ms")) > 0, "reconnect lost last build: {json.to_string(reconnect_ready) ?? ""}")

    readies_before: transcript(o).count("jet dev  [ready]")
    set_offline(d, false)
    wait_for(d, "{C_PILL}.startsWith('ready')", "ready after reconnect")
    check(value(d, "typeof window.__jetReconnectProbe === 'undefined'") == "true", "recovered connection did not reload last-good page")
    if o.transcript != "" {
        wait_log(o, 0, "jet dev  [ready]", readies_before + 1, "", "terminal ready after browser recovery")
    }
    wait_for(d, "{C_PILL}.startsWith('ready') && document.getElementById('jet-dev-overlay')?.style.display === 'none'", "clean rebuild recovery")
    check(value(d, C_FETCH_APP_JS) != initial_js, "clean recovery did not publish rebuilt app.js")
    Ok()
}

// The terminal transcript so far; empty when the run records none.
transcript: fn(o: Options) -> String {
    if o.transcript == "" -> return ""
    files.read(o.transcript) ?? ""
}

status: fn(o: Options) -> Dyn Failure! {
    response: client.get("http://127.0.0.1:{o.port}/__jet_dev_status") ?? return Err(Failure{message: "/__jet_dev_status request failed: {err}"})
    body: response.text(C_BODY_LIMIT) ?? return Err(Failure{message: "/__jet_dev_status body is not text: {err}"})
    tree: json.parse(body) ?? return Err(Failure{message: "/__jet_dev_status is not JSON: {err}"})
    Ok(tree)
}

set_offline: fn(d: Driver, offline: Bool) Failure! {
    conditions: if offline -> Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("offline"))}) else -> Dyn.Null
    command(d.bidi, "emulation.setNetworkConditions", Dyn.Object([(key: String, value: Dyn)]{
        (key: "networkConditions", value: conditions),
        (key: "contexts", value: Dyn.Array([Dyn]{Dyn.Text(d.context.copy())})),
    }))
    Ok()
}

press: fn(d: Driver, key: String) Failure! {
    down: Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("keyDown")), (key: "value", value: Dyn.Text(key.copy()))})
    up: Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("keyUp")), (key: "value", value: Dyn.Text(key.copy()))})
    source: Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("key")), (key: "id", value: Dyn.Text("keyboard")), (key: "actions", value: Dyn.Array([Dyn]{down, up}))})
    command(d.bidi, "input.performActions", Dyn.Object([(key: String, value: Dyn)]{
        (key: "context", value: Dyn.Text(d.context.copy())),
        (key: "actions", value: Dyn.Array([Dyn]{source})),
    }))
    Ok()
}

// Poll the transcript past byte `offset` until it holds `needle` at least
// `times` times and also holds `also`.
wait_log: fn(o: Options, offset: Int, needle: String, times: Int, also: String, label: String) Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        log: transcript(o)
        tail: if log.len() > offset -> log.slice(offset, log.len()) else -> ""
        if tail.count(needle) >= times && tail.contains(also) -> return Ok()
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    Err(Failure{message: "timed out waiting for {label}"})
}

// Poll until `expression` is `true`; a thrown page error counts as not yet.
wait_for: fn(d: Driver, expression: String, label: String) Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        if evaluate(d, expression) == .Val(found) && found == "true" -> return Ok()
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    Err(Failure{message: "timed out waiting for {label}"})
}

// The page value of `expression`; a thrown page error fails the matrix.
value: fn(d: Driver, expression: String) -> String Failure! {
    if evaluate(d, expression) == {
        .Val(found) -> Ok(found)
        None -> Err(Failure{message: "page expression threw: {expression}"})
        .Err(error) -> Err(error)
    }
}

perform: fn(d: Driver, expression: String) Failure! {
    value(d, expression)
    Ok()
}

// The page value of `expression` as `String(value)` after awaiting it, or
// None when the page threw.
evaluate: fn(d: Driver, expression: String) -> String? Failure! {
    params: Dyn.Object([(key: String, value: Dyn)]{
        (key: "expression", value: Dyn.Text("(async () => String(await ({expression})))()")),
        (key: "target", value: Dyn.Object([(key: String, value: Dyn)]{(key: "context", value: Dyn.Text(d.context.copy()))})),
        (key: "awaitPromise", value: Dyn.Bool(true)),
        (key: "resultOwnership", value: Dyn.Text("none")),
    })
    reply: command(d.bidi, "script.evaluate", params)
    if text(field(reply, "type")) != "success" -> return Ok(None)
    Ok(Val(text(field(field(reply, "result"), "value"))))
}

navigate: fn(d: Driver, address: String) Failure! {
    command(d.bidi, "browsingContext.navigate", Dyn.Object([(key: String, value: Dyn)]{
        (key: "context", value: Dyn.Text(d.context.copy())),
        (key: "url", value: Dyn.Text(address.copy())),
        (key: "wait", value: Dyn.Text("complete")),
    }))
    Ok()
}

// Launch the locked engine and open one tab.
open: fn(engine: String) -> Driver Failure! {
    session: browser.launch(engine) ?? return Err(Failure{message: "{engine} launch failed: {err}"})
    bidi: session.protocol("bidi") ?? return Err(Failure{message: "BiDi protocol unavailable: {err}"})
    created: command(bidi, "browsingContext.create", Dyn.Object([(key: String, value: Dyn)]{(key: "type", value: Dyn.Text("tab"))}))
    context: text(field(created, "context"))
    if context == "" -> return Err(Failure{message: "browsingContext.create returned no context"})
    Ok(Driver{session: session, bidi: bidi, context: context})
}

command: fn(bidi: BrowserProtocol, method: String, params: Dyn) -> Dyn Failure! {
    wire: json.to_string(params) ?? return Err(Failure{message: "{method} parameters cannot be encoded: {err}"})
    reply: bidi.send(method, wire) ?? return Err(Failure{message: "{method} failed: {err}"})
    tree: json.parse(reply) ?? return Err(Failure{message: "{method} reply is not JSON: {err}"})
    Ok(tree)
}

check: fn(condition: Bool, message: String) Failure! {
    if !condition -> return Err(Failure{message: message})
    Ok()
}

field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text: fn(tree: Dyn) -> String {
    if tree == .Text(found) -> return found.copy()
    ""
}

number: fn(tree: Dyn) -> Int {
    if tree == .Int(found) -> found else -> 0 - 1
}

option: fn(args: [String], name: String) -> String? {
    loop index in 0..<args.len() {
        if args[index] == name && index + 1 < args.len() -> return Val(args[index + 1].copy())
    }
    None
}

fail: fn(message: String) -> Never {
    eprint(message)
    process.exit(1)
}
