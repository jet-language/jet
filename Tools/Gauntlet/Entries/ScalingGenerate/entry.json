{
  "name": "scaling-generate",
  "mode": "tool",
  "description": "The compiler scaling gate's corpus generator generate.mjs (with package.mjs, corpora.mjs, domains.mjs and mixed.mjs) and its Jet twin generate/run.jet (over the jet_scaling_corpora package: Packages.jet, Corpora.jet, Domains.jet and Mixed.jet), #5072 c7: list the shapes, write every stress shape and every domain shape at a small size and two mixed packages into a new directory, and refuse an unknown shape, a zero size, a bad seed, an out-of-range mixed input and an existing output. Each writing case's check.jet states the printed JSON line (the entry relative to the case directory), every written file with its size and digest, and whether the printed source_sha256 is the digest of the written package; the refusals print nothing and exit 2. The fixtures hold `existing/main.jet`, the output a regeneration must not overwrite.",
  "tool": {
    "original": "Tools/Perf/Scaling/Generate.mjs",
    "jet": "Tools/Perf/Scaling/Generate/run.jet",
    "fixtures": "fixtures",
    "cases": [
      {
        "args": [
          "--list"
        ],
        "expected": "Expected/list.out"
      },
      {
        "args": [
          "modules",
          "4",
          "--seed",
          "2",
          "out"
        ],
        "check": "check.jet",
        "expected": "Expected/modules.out"
      },
      {
        "args": [
          "small-fns",
          "5",
          "--seed",
          "3",
          "out"
        ],
