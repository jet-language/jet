{
  "name": "RootsMjs",
  "mode": "tool",
  "description": "The dev tool roots roots.mjs and its Jet twin Roots.jet in Tools/Agent (#5072 c9): roots.mjs asks roots.sh, so both read the one table Tools/Agent/roots.env; a root is what the machine's ${XDG_CONFIG_HOME:-~/.config}/jet/env sets, else the environment's value (empty is unset), else the table's default derived from $HOME and the XDG directories, joined as the shell joins, with no normalizing. Imported, roots.mjs gives node tools the roots; run with root names, it prints `NAME=value` for each, as Roots.jet does, and exits 64 at a name that is not one of its nine (the eight table roots and JET_DEV_WORKTREE). One case points XDG_CONFIG_HOME at RootsSh's quoting env file, which both programs apply, and the rest at a directory without one. Every case sets every root so the machine's own leak into nothing, and the XDG data and config directories are relative so no path names the machine. HOME and XDG_CACHE_HOME stay the machine's, because the harness starts both programs through Tools/Agent/JetEnv.jet, which keeps its dev shells there; RootsSh's check.jet writes the machine's cache directory as `$XDG_CACHE_HOME` and its home directory as `<HOME>`. The cases cover the defaults, the environment over the defaults (JET_BIN, the jet under test, included), roots joined from values with doubled slashes, `.`, `..` and trailing slashes, the env file, JET_DEV_WORKTREE, a name that is not a root, and no name.",
  "tool": {
    "original": "Tools/Agent/roots.mjs",
    "jet": "Tools/Agent/Roots.jet",
    "fixtures": "../RootsSh/Fixtures",
    "token_gaps": [
      "#5072 c56",
      "#5072 c57"
    ],
    "cases": [
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/defaults.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "/env/state", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "/env/base", "JET_TARGET_ROOT": "", "JET_SEEDS": "/env/seeds", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/environment.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "/env/scratch", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "/env/seed", "JET_BIN": "/env/bin/jet", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/seed-and-bin.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "/env//state/", "JET_SCRATCH_ROOT": "/env//scratch/../x/", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "../seed/./", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data/./", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/joined.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "quoting"}, "check": "../RootsSh/check.jet", "expected": "Expected/env-file.out"},
      {"args": ["JET_SEED", "JET_ROOT", "JET_RUN_ROOT"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "exit": 64, "expected": "Expected/unknown.out"},
      {"args": ["JET_STATE_ROOT", "JET_DEV_WORKTREE"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/dev-worktree.out"},
      {"args": [], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../RootsSh/check.jet", "expected": "Expected/none.out"}
    ]
  }
}
