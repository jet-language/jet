// The hardening manifest generator: the denominator of Core surface rows,
// read from the compiler's own registries, route tables and Core parse.
name: "jet_hardening"
version: "0.0.1"
edition: "2026"
authority: { allow: [Exec, FS, IO, Mem.Alloc] }
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jet_lexer: ../../Compiler/JetLexer,
    jet_parser: ../../Compiler/JetParser,
    jet_ir: ../../Compiler/JetIR,
    jet_eval: ../../Compiler/JetEval,
}
