// The hardening manifest generator: the denominator of Core surface rows,
// read from the compiler's own registries, route tables and Core parse; the
// #2337 regression seeds, run on every tier; and the construct generator's
// seeded programs, checked and run on every tier.
name: "jet_hardening"
version: "0.0.1"
edition: "2026"
authority: { allow: [Env, Exec, FS, IO, Mem.Alloc, Time] }
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jet_lexer: ../../Compiler/JetLexer,
    jet_parser: ../../Compiler/JetParser,
    jet_ir: ../../Compiler/JetIR,
    jet_eval: ../../Compiler/JetEval,
}
