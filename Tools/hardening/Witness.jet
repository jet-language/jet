// Read one conformance witness through the parser and name the sink that
// observes the Core result. A witness is the program at
// tests/conformance/corpus/<module path>/<member>.jet: it imports the module
// once, calls the member once, and must observe what the call returns.
//
// Each expression on the way from the call to its statement leaves one frame,
// `kind:name`, so the walk can ask what the program does with the result:
// observe it (print, eprint, assert), bind it (and then trace that name), or
// drop it. The row's result class makes the check type-aware: an opaque
// result needs a follow-up operation (a method, field, operator, argument,
// branch or error propagation) before observation, a unit result may be
// observed by a later effect, and a never result is its own observation.

use {
    jet_parser.[parse_source]
    jet_foundation.[Program, Stmt, Expr, CallArg, OrFallback, ast_visit_body]
}

OBSERVERS: [String]{"print", "eprint", "assert"}
TRACE_DEPTH: 8

Sink: struct {
    kind: String
    operation: String
    follow_up: String
    via: String
    result_class: String
}

WitnessCheck: struct {
    sink: Sink?
    errors: [String]
}

Probe: enum {
    Member(alias: String, member: String)
    Local(name: String)
    Name(name: String)
}

// One place the probe matched: the frames from the function body down to
// the match, whether a later statement observes anything, and the function.
// `at` is the byte offset of the call's name: a desugared form such as
// `x ? ok -> a ! error -> b` reaches one call through two paths.
Hit: struct {
    chain: [String]
    later: Bool
    function: String
    at: Int
}

hit_at: fn(expression: Expr) -> Int Never! {
    if expression == {
        .MethodCall(_, _, method_span, _, _, _, _) -> method_span.start
        .Call(call, _) -> call.name_span.start
        .Ident(_, span, _) -> span.start
        else -> -1
    }
}

// The driver reads an inline `package: { … }` carrier, the first item after
// leading comments, and blanks it before the parser runs
// (jet_driver_mask_inline_package in Compiler/JetDriver). Blank it the same
// way, keeping every newline so diagnostics keep their lines.
mask_inline_package: fn(text: String) -> String Never! {
    bytes := text.bytes()
    at := 0
    loop at < bytes.len() {
        byte: bytes[at]
        if byte == (U8{32}) || byte == (U8{9}) || byte == (U8{10}) || byte == (U8{13}) {
            at += 1
            next
        }
        if byte == (U8{47}) && at + 1 < bytes.len() && bytes[at + 1] == (U8{47}) {
            loop at < bytes.len() && bytes[at] != (U8{10}) -> at += 1
            next
        }
        break
    }
    word: "package".bytes()
    if at + word.len() > bytes.len() -> return text.copy()
    loop index in 0..<word.len() {
        if bytes[at + index] != word[index] -> return text.copy()
    }
    open := at + word.len()
    loop open < bytes.len() && (bytes[open] == (U8{32}) || bytes[open] == (U8{9})) -> open += 1
    if open < bytes.len() && bytes[open] == (U8{58}) -> open += 1
    loop open < bytes.len() && (bytes[open] == (U8{32}) || bytes[open] == (U8{9})) -> open += 1
    if open >= bytes.len() || bytes[open] != (U8{123}) -> return text.copy()
    depth := 0
    quoted := false
    end := -1
    index := open
    loop index < bytes.len() && end < 0 {
        byte: bytes[index]
        if {
            quoted && byte == (U8{92}) -> index += 1
            quoted && byte == (U8{34}) -> quoted = false
            quoted -> {}
            byte == (U8{34}) -> quoted = true
            byte == (U8{123}) -> depth += 1
            byte == (U8{125}) -> {
                depth -= 1
                if depth == 0 -> end = index
            }
        }
        index += 1
    }
    if end < 0 -> return text.copy()
    loop offset in at..<end + 1 {
        if bytes[offset] != (U8{10}) && bytes[offset] != (U8{13}) -> bytes[offset] = U8{32}
    }
    String.from_bytes(bytes) ?? text.copy()
}

offset_line: fn(text: String, offset: Int) -> Int Never! {
    line := 1
    loop (index, byte) in text.bytes() {
        if index >= offset -> break
        if byte == (U8{10}) -> line += 1
    }
    line
}

observed_chain: fn(chain: [String]) -> Bool Never! {
    loop frame in chain {
        parts: frame.partition(":")
        if parts.head == "arg" && is_observer(parts.tail) -> return true
    }
    false
}

Reading: struct {
    end: String
    name: String
    follow_up: String
    operation: String
    propagated: Bool
}

is_observer: fn(name: String) -> Bool Never! {
    loop observer in OBSERVERS {
        if observer == name -> return true
    }
    false
}

observes: fn(body: [Stmt]) -> Bool Never! {
    names := [String]{}
    ast_visit_body(body, (expression: Expr) -> note_call_name(names, expression), true)
    loop name in names {
        if is_observer(name) -> return true
    }
    false
}

observes_from: fn(body: [Stmt], start: Int) -> Bool Never! {
    loop index in start..<body.len() {
        if observes([Stmt]{body[index].copy()}) -> return true
    }
    false
}

note_call_name: fn(names: &[String], expression: Expr) Never! {
    if expression == .Call(call, _) -> names.push(call.name.copy())
}

with_frame: fn(chain: [String], frame: String) -> [String] Never! {
    out := chain.copy()
    out.push(frame)
    out
}

probe_matches: fn(expression: Expr, probe: Probe) -> Bool Never! {
    if probe == {
        .Member(alias, member) -> {
            if expression == .MethodCall(receiver, method, _, _, _, _, _) {
                if method != member -> return false
                if receiver == .Ident(name, _, _) -> return name == alias
                // `alias.Type<T>.member(...)`: the member is reached through a
                // generic receiver of the module.
                if receiver == .Field(base, _, _, _) {
                    if base == .Ident(name, _, _) -> return name == alias
                }
            }
            false
        }
        .Local(name) -> {
            if expression == .Call(call, _) -> return call.name == name
            false
        }
        .Name(name) -> {
            if expression == .Ident(found, _, _) -> return found == name
            false
        }
    }
}

fallback_frame: fn(fallback: OrFallback) -> String Never! {
    if fallback == {
        .Panic(_, _) -> "fallback:panic"
        .Value(_) -> "fallback:value"
        .Block(_, _, _) -> "fallback:block"
        .Return(value, _) -> {
            if value == .Val(returned) {
                if returned == .Err(_, _, _) -> return "fallback:return-err"
                if returned == .Call(call, _) {
                    if call.name == "Err" -> return "fallback:return-err"
                }
            }
            "fallback:return"
        }
        else -> "fallback:other"
    }
}

// What one walk looks for, whether an observer runs after the current
// statement, and which function holds the walked code.
Walk: struct {
    probe: Probe
    later: Bool
    function: String
}

observed_later: fn(walk: Walk) -> Walk Never! {
    Walk{probe: walk.probe.copy(), later: true, function: walk.function.copy()}
}

walk_args: fn(args: [CallArg], frame: String, chain: [String], walk: Walk, hits: &[Hit]) Never! {
    inner: with_frame(chain, frame)
    loop argument in args -> walk_expr(argument.expr, inner, walk, hits)
}

walk_expr: fn(expression: Expr, chain: [String], walk: Walk, hits: &[Hit]) Never! {
    if probe_matches(expression, walk.probe) {
        at: hit_at(expression)
        known := false
        loop old in hits {
            if at >= 0 && old.at == at -> known = true
        }
        if !known -> hits.push(Hit{chain: chain.copy(), later: walk.later, function: walk.function.copy(), at: at})
    }
    if expression == {
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> walk_expr(value, with_frame(chain, "interp"), walk, hits)
        }
        .ListLit(values, _, _) -> loop value in values -> walk_expr(value, with_frame(chain, "wrap"), walk, hits)
        .CompareChain(values, _, _, _, _) -> loop value in values -> walk_expr(value, with_frame(chain, "op"), walk, hits)
        .Unary(_, value, _, _) -> walk_expr(value, with_frame(chain, "op"), walk, hits)
        .Binary(_, left, right, _, _) -> {
            walk_expr(left, with_frame(chain, "op"), walk, hits)
            walk_expr(right, with_frame(chain, "op"), walk, hits)
        }
        .Paren(value, _, _) -> walk_expr(value, with_frame(chain, "paren"), walk, hits)
        .Try(value, _, _, note, _) -> {
            walk_expr(value, with_frame(chain, "fallback:try"), walk, hits)
            if note == .Val(note_value) -> walk_expr(note_value, with_frame(chain, "other"), walk, hits)
        }
        .Field(value, member, _, _) -> walk_expr(value, with_frame(chain, "field:{member}"), walk, hits)
        .OptField(value, member, _, _, _, _) -> walk_expr(value, with_frame(chain, "field:{member}"), walk, hits)
        .MemberSpread(value, _, _, _) | .Spread(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) | .Present(value, _, _) | .Tainted(value, _, _, _) -> walk_expr(value, with_frame(chain, "wrap"), walk, hits)
        .Deref(value, _, _) | .RawOf(value, _, _) | .Copy(value, _, _) | .Place(value, _, _, _) -> walk_expr(value, with_frame(chain, "paren"), walk, hits)
        .MapLit(entries, _, _) -> loop entry in entries {
            walk_expr(entry.key, with_frame(chain, "wrap"), walk, hits)
            walk_expr(entry.value, with_frame(chain, "wrap"), walk, hits)
        }
        .Index(base, index, _, _, _) -> {
            walk_expr(base, with_frame(chain, "op"), walk, hits)
            walk_expr(index, with_frame(chain, "op"), walk, hits)
        }
        .Slice(base, start, end, range, _, _) -> {
            walk_expr(base, with_frame(chain, "op"), walk, hits)
            walk_expr(start, with_frame(chain, "op"), walk, hits)
            walk_expr(end, with_frame(chain, "op"), walk, hits)
            if range == .Val(value) -> walk_expr(value, with_frame(chain, "op"), walk, hits)
        }
        .Range(left, right, _, _, _) -> {
            walk_expr(left, with_frame(chain, "op"), walk, hits)
            walk_expr(right, with_frame(chain, "op"), walk, hits)
        }
        .Call(call, _) -> walk_args(call.args, "arg:{call.name}", chain, walk, hits)
        .MethodCall(receiver, method, _, _, _, args, _) | .OptMethodCall(receiver, method, _, _, args, _, _) -> {
            walk_expr(receiver, with_frame(chain, "recv:{method}"), walk, hits)
            walk_args(args, "arg:.{method}", chain, walk, hits)
        }
        .CallValue(callee, args, _, _) -> {
            // `print((() -> { call ?? panic(..); true })())`: the observer
            // runs after the invoked body, so the body's effects are observed.
            invoked: if !walk.later && observed_chain(chain) -> observed_later(walk) else -> walk.copy()
            walk_expr(callee, with_frame(chain, "recv:()"), invoked, hits)
            walk_args(args, "arg:()", chain, walk, hits)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> walk_expr(field.value, with_frame(chain, "wrap"), walk, hits)
        .TupleLit(fields, _, _, _) -> loop field in fields -> walk_expr(field.value, with_frame(chain, "wrap"), walk, hits)
        .TypedLit(_, body, _, _) -> if body == {
            .Fields(fields) -> loop field in fields -> walk_expr(field.value, with_frame(chain, "wrap"), walk, hits)
            .Elements(values) -> loop value in values -> walk_expr(value, with_frame(chain, "wrap"), walk, hits)
            .Entries(entries) -> loop entry in entries {
                walk_expr(entry.key, with_frame(chain, "wrap"), walk, hits)
                walk_expr(entry.value, with_frame(chain, "wrap"), walk, hits)
            }
            .Value(value) -> walk_expr(value, with_frame(chain, "wrap"), walk, hits)
            else -> {}
        }
        .EnumLit(_, _, _, args, _, _, _) -> loop argument in args {
            if argument == { .Positional(value) | .Named(_, value) -> walk_expr(value, with_frame(chain, "wrap"), walk, hits) }
        }
        .PatternTest(subject, _, _, _) -> walk_expr(subject, with_frame(chain, "op"), walk, hits)
        .OrFallback(value, fallback, _, _, _) -> {
            walk_expr(value, with_frame(chain, fallback_frame(fallback)), walk, hits)
            other: with_frame(chain, "other")
            if fallback == {
                .Value(alternative) -> walk_expr(alternative, other, walk, hits)
                .Block(body, tail, _) -> {
                    walk_body(body, other, walk, hits)
                    if tail == .Val(tail_value) -> walk_expr(tail_value, other, walk, hits)
                }
                .Return(returned, _) -> if returned == .Val(returned_value) -> walk_expr(returned_value, other, walk, hits)
                .Panic(_, args) -> walk_args(args, "other", chain, walk, hits)
                else -> {}
            }
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            walk_expr(condition, with_frame(chain, "cond:{observes(then_body) || observes(else_body)}"), walk, hits)
            block: with_frame(chain, "block")
            walk_body(then_body, block, walk, hits)
            walk_expr(then_value, block, walk, hits)
            walk_body(else_body, block, walk, hits)
            walk_expr(else_value, block, walk, hits)
        }
        .Lambda(lambda, _) -> if lambda.body == {
            .Expr(value) -> walk_expr(value, with_frame(chain, "lambda"), walk, hits)
            .Block(body) -> walk_body(body, with_frame(chain, "lambda"), walk, hits)
        }
        .PtrFromAddr(_, _, _, address, _, _) -> walk_expr(address, with_frame(chain, "other"), walk, hits)
        else -> {}
    }
}

walk_body: fn(body: [Stmt], chain: [String], walk: Walk, hits: &[Hit]) Never! {
    loop index in 0..<body.len() {
        step: if !walk.later && observes_from(body, index + 1) -> observed_later(walk) else -> walk.copy()
        walk_statement(body[index], chain, step, hits)
    }
}

walk_statement: fn(statement: Stmt, chain: [String], walk: Walk, hits: &[Hit]) Never! {
    block: with_frame(chain, "block")
    if statement == {
        .Expr(value) | .DeferClose(value, _) -> walk_expr(value, with_frame(chain, "stmt"), walk, hits)
        .Val(binding) -> walk_expr(binding.init, with_frame(chain, "bind:{binding.name}"), walk, hits)
        .Assign(_, _, _, value) -> walk_expr(value, with_frame(chain, "assign"), walk, hits)
        .Return(value, _) -> if value == .Val(value) -> walk_expr(value, with_frame(chain, "return"), walk, hits)
        .BreakValue(value, _) | .Yield(value, _) | .BreakLabelValue(_, _, value, _) -> walk_expr(value, with_frame(chain, "return"), walk, hits)
        .While(condition, body, _, _, _) -> {
            walk_expr(condition, with_frame(chain, "cond:{observes(body)}"), walk, hits)
            walk_body(body, block, walk, hits)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            iterated: with_frame(chain, "cond:{observes(body)}")
            if kind == {
                .Range(start, end, step, _) -> {
                    walk_expr(start, iterated, walk, hits)
                    walk_expr(end, iterated, walk, hits)
                    if step == .Val(value) -> walk_expr(value, iterated, walk, hits)
                }
                .In(collection, step) -> {
                    walk_expr(collection, iterated, walk, hits)
                    if step == .Val(value) -> walk_expr(value, iterated, walk, hits)
                }
            }
            walk_body(body, block, walk, hits)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            observed := false
            loop arm in arms {
                if observes(arm.body) -> observed = true
            }
            if else_body == .Val(body) {
                if observes(body) -> observed = true
            }
            walk_expr(subject, with_frame(chain, "cond:{observed}"), walk, hits)
            loop arm in arms {
                walk_expr(arm.cond, block, walk, hits)
                walk_body(arm.body, block, walk, hits)
            }
            if else_body == .Val(body) -> walk_body(body, block, walk, hits)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) | .Layout(_, _, body, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .TaskGroup(_, _, _, body, _) | .ContextBlock(_, body, _) | .AssumeDet(_, _, body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> walk_body(body, block, walk, hits)
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            walk_expr(init.init, with_frame(chain, "bind:{init.name}"), walk, hits)
            walk_expr(condition, with_frame(chain, "cond:{observes(body)}"), walk, hits)
            if step == .Val(value) -> walk_statement(value, block, walk, hits)
            walk_body(body, block, walk, hits)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            walk_expr(condition, with_frame(chain, "other"), walk, hits)
            walk_body(then_body, block, walk, hits)
            if else_body == .Val(body) -> walk_body(body, block, walk, hits)
        }
        else -> {}
    }
}

scan: fn(program: Program, probe: Probe) -> [Hit] Never! {
    hits := [Hit]{}
    loop item in program.items {
        if item == .Func(function) -> walk_body(function.body, [String]{}, Walk{probe: probe.copy(), later: false, function: function.name.copy()}, hits)
    }
    hits
}

// Read a chain from the match outward, collecting the first follow-up
// operation, until something ends the value's life.
read_chain: fn(chain: [String]) -> Reading Never! {
    follow := ""
    propagated := false
    index := chain.len() - 1
    loop index >= 0 {
        frame: chain[index].partition(":")
        kind: frame.head
        name: frame.tail
        if kind == {
            "fallback" -> {
                if name == "panic" || name == "try" {
                    propagated = true
                    if follow == "" -> follow = "error-propagation"
                }
            }
            "recv" -> if follow == "" -> follow = "method {name}"
            "field" -> if follow == "" -> follow = "field {name}"
            "op" -> if follow == "" -> follow = "operator"
            "arg" -> {
                if is_observer(name) -> return Reading{end: "observed", name: "", follow_up: follow, operation: name.copy(), propagated: propagated}
                if follow == "" -> follow = "argument of {name}"
            }
            "cond" -> {
                if follow == "" -> follow = "branch"
                if name == "true" -> return Reading{end: "observed", name: "", follow_up: follow, operation: "branch", propagated: propagated}
            }
            "bind" -> return Reading{end: "bound", name: name.copy(), follow_up: follow, operation: "", propagated: propagated}
            "stmt" -> return Reading{end: "statement", name: "", follow_up: follow, operation: "", propagated: propagated}
            "return" -> return Reading{end: "returned", name: "", follow_up: follow, operation: "", propagated: propagated}
            "assign" -> return Reading{end: "assigned", name: "", follow_up: follow, operation: "", propagated: propagated}
            else -> {}
        }
        index -= 1
    }
    Reading{end: "statement", name: "", follow_up: follow, operation: "", propagated: propagated}
}

// Follow a bound name to an observer. An opaque result counts only when an
// operation reads it on the way, at the binding or at the use.
trace: fn(program: Program, name: String, follow: String, result_class: String, depth: Int, via: String) -> Sink? Never! {
    if depth > TRACE_DEPTH -> return None
    loop hit in scan(program, Probe.Name{name: name.copy()}) {
        reading: read_chain(hit.chain)
        merged: if reading.follow_up != "" -> reading.follow_up.copy() else -> follow.copy()
        if reading.end == "observed" {
            if result_class == "opaque" && merged == "" -> next
            return Val(Sink{kind: "bound", operation: reading.operation.copy(), follow_up: merged, via: via.copy(), result_class: result_class.copy()})
        }
        if reading.end == "bound" && reading.name != "" && !reading.name.starts_with("_") {
            if trace(program, reading.name, merged, result_class, depth + 1, "{via} -> {reading.name}") == .Val(sink) -> return Val(sink.copy())
        }
    }
    None
}

module_probes: fn(program: Program, module_name: String, member: String) -> [Probe] Never! {
    probes := [Probe]{}
    loop decl in program.imports {
        if decl.kind == {
            .Module(name, _) -> {
                if name == module_name -> probes.push(Probe.Member{alias: decl.alias.copy(), member: member.copy()})
            }
            .Unqualified(module_alias, _, items, _, _) -> {
                if module_alias == module_name {
                    loop item in items {
                        if item.original == member {
                            local: if item.alias == .Val(alias) -> alias.copy() else -> item.original.copy()
                            probes.push(Probe.Local{name: local})
                        }
                    }
                }
            }
            else -> {}
        }
    }
    probes
}

inspect_witness: fn(key: String, text: String, module_name: String, member: String, result_class: String) -> WitnessCheck Never! {
    errors := [String]{}
    marker: "// core-conformance: {key}"
    lines: text.split("\n").to_list()
    if lines.len() == 0 || lines[0].trim_end() != marker -> errors.push("first line must be `{marker}`")
    markers := 0
    loop line in lines {
        if line.trim() == marker -> markers += 1
    }
    if markers > 1 -> errors.push("expected one `{marker}` marker, found {markers}")
    source: mask_inline_package(text)
    parsed: parse_source(source.bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.code.starts_with("E") {
            line: if diagnostic.span == .Val(span) -> offset_line(source, span.start) else -> 0
            errors.push("witness does not parse: line {line}: {diagnostic.code} {diagnostic.what}")
            return WitnessCheck{sink: None, errors: errors}
        }
    }
    program: parsed.program
    probes: module_probes(program, module_name, member)
    if probes.len() != 1 {
        errors.push("expected one import of `{member}` from `{module_name}`, found {probes.len()}")
        return WitnessCheck{sink: None, errors: errors}
    }
    hits: scan(program, probes[0])
    if hits.len() != 1 {
        errors.push("expected one call of `{key}`, found {hits.len()}")
        return WitnessCheck{sink: None, errors: errors}
    }
    hit: hits[0]
    run_unit := false
    run_found := false
    run_calls := [String]{}
    loop item in program.items {
        if item == .Func(function) {
            if function.name == "run" {
                run_found = true
                run_unit = function.return_type == None
                ast_visit_body(function.body, (expression: Expr) -> note_call_name(run_calls, expression), true)
            }
        }
    }
    if !run_found {
        errors.push("compile-only witness: no `run: fn()` executes the call")
        return WitnessCheck{sink: None, errors: errors}
    }
    if hit.function != "run" {
        reached := false
        loop name in run_calls {
            if name == hit.function -> reached = true
        }
        if !reached {
            errors.push("compile-only witness: `{hit.function}` holds the call but `run` never calls it")
            return WitnessCheck{sink: None, errors: errors}
        }
    }
    if hit.function == "run" && run_unit {
        loop frame in hit.chain {
            if frame == "fallback:return-err" {
                errors.push("Unit run cannot use ?? return Err(...) propagation")
                return WitnessCheck{sink: None, errors: errors}
            }
        }
    }
    verdict: judge(program, hit, result_class, 0)
    loop problem in verdict.errors -> errors.push(problem.copy())
    if errors.len() > 0 -> return WitnessCheck{sink: None, errors: errors}
    verdict
}

// Name the sink for one hit, or say why there is none. A result returned
// from a helper is judged again at the helper's single call site.
judge: fn(program: Program, hit: Hit, result_class: String, depth: Int) -> WitnessCheck Never! {
    errors := [String]{}
    reading: read_chain(hit.chain)
    sink := Sink?{None}
    if reading.end == {
        "observed" -> {
            if {
                result_class == "opaque" && reading.follow_up == "" -> errors.push("opaque result needs a follow-up operation before observation")
                else -> sink = Val(Sink{kind: "direct", operation: reading.operation.copy(), follow_up: reading.follow_up.copy(), via: "", result_class: result_class.copy()})
            }
        }
        "bound" -> {
            if {
                reading.name == "" -> errors.push("a destructured result cannot be traced to an observer")
                reading.name.starts_with("_") -> errors.push("result is bound to discard name {reading.name}")
                trace(program, reading.name, reading.follow_up, result_class, 0, reading.name) == .Val(found) -> sink = Val(found.copy())
                result_class == "opaque" -> errors.push("bound result {reading.name} never reaches print/eprint/assert through a follow-up operation")
                else -> errors.push("bound result {reading.name} is never observed by print/eprint/assert")
            }
        }
        "statement" -> {
            if {
                result_class == "never" -> sink = Val(Sink{kind: "never-effect", operation: "exit", follow_up: "", via: "", result_class: result_class.copy()})
                reading.propagated && hit.later && result_class != "opaque" -> sink = Val(Sink{kind: "propagated", operation: "later-observer", follow_up: "error-propagation", via: "", result_class: result_class.copy()})
                result_class == "unit" && hit.later -> sink = Val(Sink{kind: "unit-effect", operation: "later-observer", follow_up: "", via: "", result_class: result_class.copy()})
                else -> errors.push("result has no observable sink: the call is compile-only or its value is discarded")
            }
        }
        "returned" -> {
            if hit.function == "run" || depth >= TRACE_DEPTH -> return WitnessCheck{sink: None, errors: [String]{"result is returned, not observed"}}
            sites: scan(program, Probe.Local{name: hit.function.copy()})
            if sites.len() != 1 -> return WitnessCheck{sink: None, errors: [String]{"result is returned from `{hit.function}`, which is called {sites.len()} times; a witness observes one call"}}
            // An operation applied before the return already reached
            // into an opaque result.
            next_class: if result_class == "opaque" && reading.follow_up != "" -> "value" else -> result_class.copy()
            outer: judge(program, sites[0], next_class, depth + 1)
            if outer.sink == .Val(found) {
                via: if found.via == "" -> "return of {hit.function}" else -> "return of {hit.function}, {found.via}"
                follow: if reading.follow_up != "" -> reading.follow_up.copy() else -> found.follow_up.copy()
                return WitnessCheck{sink: Val(Sink{kind: found.kind.copy(), operation: found.operation.copy(), follow_up: follow, via: via, result_class: result_class.copy()}), errors: [String]{}}
            }
            return outer
        }
        else -> errors.push("result is {reading.end}, not observed")
    }
    if errors.len() > 0 -> return WitnessCheck{sink: None, errors: errors}
    WitnessCheck{sink: sink, errors: errors}
}
