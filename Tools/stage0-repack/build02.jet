// Mount the canonical bootstrap Host/Runner Jet owners from the source root.
// Rust: Tools/stage0-repack/build.rs:8
use std.env as env // GATE #4494: native build environment.
use std.fs as fs // GATE #4494: native source validation/output write.
use core.build as build // GATE #4494: build dependency and cfg declarations.
use jet_foundation.[quoted_string] // GATE #4500: source/debug quoting.

// Rust: Tools/stage0-repack/build.rs:11
fn run() -[FS, Env, IO]> {
    build.rerun_if_env_changed("JET_REPACK_SOURCE_ROOT")
    // This cfg is selected only for the packaged compiler artifact.
    build.check_cfg("jet_bootstrap_compiler_artifact")
    root_input :: OSPath.from(env.var_os("JET_REPACK_SOURCE_ROOT")
        .expect("JET_REPACK_SOURCE_ROOT (set by repack.sh)"))
    root :: root_input.canonicalize()
        ?? panic("JET_REPACK_SOURCE_ROOT `{root_input.display()}`: {err}")
    path :: (relative: String) -> String {
        file :: root.join(relative)
        assert(file.is_file(), "bootstrap source `{file.display()}` is missing")
        quoted_string(file.to_string_lossy())
    }
    out := String.new()
    &out.push_str("pub const BOOTSTRAP_CANONICAL_SOURCE_ROOT: String = {quoted_string(root.to_string_lossy())}\n")
    // The sole inventory in build.jet retains every original module/export and
    // its Rust authority path. Mount the corresponding Jet source, not Rust.
    // BuildIdentity is the first inventory row and was the separate include.
    loop module in repack_bootstrap_modules() {
        _ :: path(module.relative_path)
        jet_relative :: module.relative_path.strip_suffix(".rs").expect("bootstrap source extension").to_string() + ".jet"
        file :: root.join(jet_relative)
        assert(file.is_file(), "bootstrap source `{file.display()}` is missing")
        &out.push_str("use {quoted_string(file.to_string_lossy())} as {module.module_name}\n")
    }
    // Rust: Tools/stage0-repack/build.rs:51
    // Keep all five bridge inventories, their authored order and full export
    // sets; these bind the canonical owners without duplicate model types.
    loop bridge in repack_bootstrap_bridges() {
        &out.push_str("use {bridge.module_name}.[\n")
        loop exported in bridge.exports -> &out.push_str("    {exported},\n")
        &out.push_str("]\n")
    }
    // Rust: Tools/stage0-repack/build.rs:78
    target :: OSPath.from(env.var_os("OUT_DIR").expect("OUT_DIR")).join("host_modules.jet")
    fs.write(target, out) ?? panic("cannot write `{target.display()}`: {err}")
}
