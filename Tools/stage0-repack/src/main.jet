// Rust: Tools/stage0-repack/src/main.rs:48
// COMPILER_ENTRY_RELATIVE is canonical REPACK_COMPILER_ENTRY_RELATIVE in ../main.jet.
// Rust: Tools/stage0-repack/src/main.rs:51
// Failure uses the canonical RepackError message carrier, without changed text.
// Rust: Tools/stage0-repack/src/main.rs:53
fn run() -[FS, Env, IO, Time]> {
    repack() ?? {
        eprintln("stage0-repack: {err.message}")
        process.exit(1)
    }
}

