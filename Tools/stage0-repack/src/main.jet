// Rust: Tools/stage0-repack/src/main.rs:159
// Original internal run is repack; the sole program entry above is fn run().
fn repack() -[FS, Env, IO, Time]> RepackError! {
    // The canonical invocation policy consumes only the first two arguments.
    args :: env.args_os().skip(1).take(2).map((arg) -> arg.to_string_lossy().to_string()).collect()
    invocation :: repack_invocation(args)
    keep :: invocation.keep
    compiler_project :: OSPath.from(invocation.compiler_project)
    started :: time.instant()
    eprintln("stage0-repack: Host/Runner sources from `{BOOTSTRAP_CANONICAL_SOURCE_ROOT}`")
    image_bytes :: repack_read(repack_files.join(keep, "stage-zero.image"))
    kept :: repack_parse_image(image_bytes, mem.size_of<Usize>())
    program :: mir_program_from_image_bytes(kept.payload)
        ?? return Err(repack_error("cannot decode the kept compiler MIR: {err}"))
    repack_lap(started, "decoded compiler MIR from stage-zero.image")
    lease :: open_authorized_sources(compiler_project, OSPath.from(REPACK_COMPILER_ENTRY_RELATIVE))
        ?? return Err(repack_error("cannot authorize `{compiler_project.display()}`: {err.debug()}"))
    digest :: compiler_image_source_authority_digest(lease.snapshot())
    repack_check_source_authority(invocation.compiler_project, digest, kept.source_authority_digest)

    // Rust: Tools/stage0-repack/src/main.rs:194
    ffi_record :: repack_read_text(repack_files.join(keep, "stage-zero.ffi"))
    ffi :: repack_ffi_record(ffi_record).map((record) -> {
        dir :: OSPath.from(record.directory)
        FfiLink{
            crate_name: ~record.crate_name,
            cache_identity: dir.file_name().map((name) -> name.to_string_lossy().to_string()).unwrap_or(String.new()),
            provenance_path: OSPath.new(), rlib_path: OSPath.new(), cdylib_path: OSPath.new(),
            target_deps_dir: OSPath.new(), host_deps_dir: OSPath.new(),
            helper_bin_path: None, secrets_helper_bin_path: None,
            handle_facts: [], link_closure: Default.default()
        }
    })
    // Rust: Tools/stage0-repack/src/main.rs:213
    execution := MirRustExecutionConfig.for_artifact(kept.artifact)
    execution.ffi = ffi
    execution.emit_types = true
    execution.emit_foreign = true
    execution.emit_metadata = false
    execution.emit_runtime = true
    execution.prune_unreachable_codecs = true
    metadata_config :: MirRustConfig{
        target: TargetLayout.host(), target_kind: MirRustTarget.Native,
        root_prefix: "", execution: ~execution
    }
    prepare_config :: MirRustConfig{
        target: ~metadata_config.target, target_kind: MirRustTarget.Native,
        root_prefix: "crate::", execution: ^execution
    }
    reference :: repack_read_text(repack_files.join(keep, "reference.rs"))
    reference_len :: reference.bytes().len()
    snapshot :: lease.snapshot()
    artifact :: run_compiler_work(() -> {
        metadata :: mir_rust_aot_metadata(program, metadata_config)
        prepare_bootstrap_artifact_from_aot(^reference, program, snapshot, prepare_config, metadata)
            ?? return Err(repack_error("stage-zero Host/Runner packaging failed: {err}"))
    })
    repack_lap(started, "packaged")
    // Rust: Tools/stage0-repack/src/main.rs:242
    // Complete canonical post-packaging policy ../main.jet251-298 owns the
    // image-presence check, first-run base copy/prefix derivation, task_roots
    // selection/stripping, byte/line comparisons, image-before-source publication,
    // extent error, and all three final source writes in exact authored order.
    repack_finish(keep, BOOTSTRAP_CANONICAL_SOURCE_ROOT, reference_len,
        ^artifact.source, artifact.compiler_image, image_bytes, started)
}
