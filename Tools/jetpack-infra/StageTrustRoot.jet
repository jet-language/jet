#!/usr/bin/env jet
// Prepare Docs/site/dist/keys from externally supplied public trust files.
// This launcher never creates or accepts private signing material: it runs
// the native jetpack-trust-root binary that JETPACK_TRUST_ROOT_BIN names as
// `export --output OUTPUT ARGS...`. OUTPUT is JET_TRUST_OUTPUT, else this
// checkout's Docs/site/dist/keys. The exit status is the binary's (128 + N
// for signal N).
// Usage (from anywhere inside the checkout):
//   jet Tools/jetpack-infra/StageTrustRoot.jet --index-key KEY --cache-key KEY --toolchain-key KEY --bootstrap ROOT
use {
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
}

TOOL: "/Tools/jetpack-infra/StageTrustRoot.jet"

run: fn() {
    process.exit(stage(process.args()))
}

stage: fn(args: [String]) -[Env, Exec, FS, IO, Time.Wait]> Int Never! {
    binary: sys.get("JETPACK_TRUST_ROOT_BIN") ?? ""
    if binary == "" {
        term.eprint("JETPACK_TRUST_ROOT_BIN must name the native jetpack-trust-root binary")
        return 1
    }
    if !files.is_file(binary) || !files.can_execute(binary) {
        term.eprint("missing {binary}; set JETPACK_TRUST_ROOT_BIN to the native jetpack-trust-root binary")
        return 1
    }
    output := sys.get("JET_TRUST_OUTPUT") ?? ""
    if output == "" {
        repo: repo_root()
        if repo == "" {
            term.eprint("StageTrustRoot: no checkout holds {TOOL}")
            return 1
        }
        output = "{repo}/Docs/site/dist/keys"
    }
    argv := [String]{binary, "export", "--output", output}
    argv.extend(args.copy())
    receipt: process.cmd(argv).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? {
        term.eprint("StageTrustRoot: {binary} could not start: {err}")
        return 127
    }
    if receipt.signal == .Val(number) -> return 128 + number
    receipt.code
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? return ""
    loop {
        if files.exists("{dir}{TOOL}") -> return dir
        if dir == "/" || dir == "" -> return ""
        dir = files.dirname(dir)
    }
}
