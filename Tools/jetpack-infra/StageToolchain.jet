#!/usr/bin/env jet
// Prepare an unsigned toolchain channel tree and its domain-prefixed signing
// requests. The private signing keys stay with the external release signer;
// this tool only lays out bytes and digests. Every publication file is
// immutable: an existing file with other bytes is an error, and no path
// through a symbolic link is written or read.
// Usage (from anywhere):
//   jet Tools/jetpack-infra/StageToolchain.jet --version V --sequence N --output DIR
//     [--channel NAME] [--min-version V] [--published-at UNIX] [--expires-at UNIX]
//     --artifact TARGET=FILE ...
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

MAX_ARTIFACT_BYTES: 536870912
MAX_MANIFEST_BYTES: 1048576
MAX_ARTIFACTS: 64
MANIFEST_TTL_SECONDS: 2592000
// The largest integer a JSON reader keeps exactly (2^53 - 1).
SAFE_INTEGER: 9007199254740991
READ_CHUNK: 65536
POSITIVE: Regex{"^[1-9][0-9]*$"}
COMPONENT: Regex{"^[A-Za-z0-9._+-]+$"}
SEMVER: Regex{"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"}
VALUED: ["--version", "--sequence", "--channel", "--min-version", "--published-at", "--expires-at", "--output"]

#Error
StageError: struct {
    message: String
}

Artifact: struct {
    target: String
    file: String
}

Options: struct {
    version: String
    sequence: Int
    channel: String
    min_version: String
    published_at: Int
    expires_at: Int
    output: String
    artifacts: [Artifact]
}

Staged: struct {
    target: String
    path: String
    sha256: String
    bytes: [U8]
}

// What a path names, without following a final link.
Entry: enum {
    Missing
    Present(files.Stat)
}

run: fn() {
    if stage(process.args()) == {
        .Ok(output) -> print("prepared toolchain channel at {output}; external signatures and hosting remain pending")
        .Err(error) -> {
            term.eprint("stage-toolchain: {error.message}")
            process.exit(1)
        }
    }
}

failed: fn(message: String) -> StageError Never! {
    StageError{message: message}
}

usage: fn() -> String Never! {
    "usage: StageToolchain.jet --version <version> --sequence <n> --output <dir> [--channel <name>] [--min-version <version>] [--published-at <unix-seconds>] [--expires-at <unix-seconds>] --artifact <target>=<file> ..."
}

// Stage the channel tree the arguments describe: the output directory.
stage: fn(args: [String]) -[Env, FS, Time]> String StageError! {
    options: parse_args(args) ?? return Err(err)
    directory(options.output, "publication output") ?? return Err(err)
    order := [Int]{}
    loop index in 0..<options.artifacts.len() {
        at := order.len()
        loop at > 0 && options.artifacts[order[at - 1]].target > options.artifacts[index].target {
            at -= 1
        }
        order.insert(at, index)
    }
    staged := [Staged]{}
    loop index in order {
        artifact: options.artifacts[index]
        if staged.len() > 0 && staged[staged.len() - 1].target == artifact.target {
            return Err(failed("duplicate artifact target {artifact.target}"))
        }
        size: regular(artifact.file, "artifact input") ?? return Err(err)
        bytes: read_bounded(artifact.file, size, "artifact input", MAX_ARTIFACT_BYTES) ?? return Err(err)
        staged.push(Staged{
            target: artifact.target,
            path: "v1/{options.channel}/{options.version}/jet-{options.version}-{artifact.target}",
            sha256: crypto.sha256(bytes).hex(),
            bytes: bytes,
        })
    }
    manifest: manifest_bytes(options, staged)
    if manifest.len() > MAX_MANIFEST_BYTES -> return Err(failed("manifest exceeds the {MAX_MANIFEST_BYTES} byte bound"))
    manifest_path: "{options.output}/v1/{options.channel}/manifest.json"
    immutable(manifest_path, manifest) ?? return Err(err)
    immutable("{manifest_path}.sig.request", signing_request("jet-toolchain-channel-v1", manifest)) ?? return Err(err)
    loop artifact in staged {
        artifact_path: "{options.output}/{artifact.path}"
        immutable(artifact_path, artifact.bytes) ?? return Err(err)
        immutable("{artifact_path}.sig.request", signing_request("jet-toolchain-artifact-v1", artifact.bytes)) ?? return Err(err)
    }
    Ok(options.output)
}

// The manifest as compact JSON and a newline. Every string in it is a
// validated version or component (`[A-Za-z0-9._+-]`), so none needs escaping.
manifest_bytes: fn(options: Options, staged: [Staged]) -> [U8] Never! {
    entries: staged.map((artifact: Staged) -> "{{\"target\":\"{artifact.target}\",\"path\":\"{artifact.path}\",\"sha256\":\"{artifact.sha256}\",\"size\":{artifact.bytes.len()},\"signature\":\"{artifact.path}.sig.json\"}}")
    "{{\"schema\":1,\"channel\":\"{options.channel}\",\"version\":\"{options.version}\",\"sequence\":{options.sequence},\"published_at\":{options.published_at},\"expires_at\":{options.expires_at},\"min_version\":\"{options.min_version}\",\"artifacts\":[{entries.join(",")}]}}\n".bytes()
}

// The bytes the release signer signs: the domain line, then the payload.
signing_request: fn(domain: String, payload: [U8]) -> [U8] Never! {
    request := "{domain}\n".bytes()
    // copy: the caller keeps the payload it publishes beside the request
    request.extend(payload.copy())
    request
}

parse_args: fn(args: [String]) -[Env, FS, Time]> Options StageError! {
    artifacts := [Artifact]{}
    version := ""
    sequence := 0
    channel := "stable"
    min_version := "1.0.0"
    published := Int?{None}
    expires := Int?{None}
    output := ""
    index := 0
    loop index < args.len() {
        name: args[index]
        index += 1
        value: if index < args.len() -> args[index] else -> ""
        if name != "--artifact" && !VALUED.contains(name) -> return Err(failed("{usage()}\nunknown option {name}"))
        index += 1
        if name != "--artifact" && (value == "" || value.starts_with("--")) -> return Err(failed("{name} needs a value"))
        if name == {
            "--artifact" -> {
                split: value.partition("=")
                if split.sep == "" || split.head == "" || split.tail == "" -> return Err(failed("--artifact needs target=path"))
                artifacts.push(Artifact{target: split.head, file: split.tail})
            }
            "--version" -> version = value
            "--sequence" -> sequence = parse_positive(value, "sequence") ?? return Err(err)
            "--channel" -> channel = value
            "--min-version" -> min_version = value
            "--published-at" -> published = Val(parse_positive(value, "published-at") ?? return Err(err))
            "--expires-at" -> expires = Val(parse_positive(value, "expires-at") ?? return Err(err))
            "--output" -> output = value
            else -> {}
        }
    }
    if version == "" || sequence == 0 || output == "" || artifacts.len() == 0 {
        return Err(failed("{usage()}\nversion, sequence, output, and at least one artifact are required"))
    }
    validate_semver(version, "version") ?? return Err(err)
    validate_component(channel, "channel") ?? return Err(err)
    validate_semver(min_version, "min-version") ?? return Err(err)
    if artifacts.len() > MAX_ARTIFACTS -> return Err(failed("too many artifact inputs"))
    published_at: published ?? time.now().to_timestamp()
    expires_at: expires ?? published_at + MANIFEST_TTL_SECONDS
    if expires_at > SAFE_INTEGER -> return Err(failed("expires-at is outside the safe integer range"))
    if expires_at <= published_at -> return Err(failed("expires-at must be after published-at"))
    if expires_at - published_at > MANIFEST_TTL_SECONDS -> return Err(failed("expires-at exceeds the 30-day freshness window"))
    resolved := [Artifact]{}
    loop artifact in artifacts {
        validate_component(artifact.target, "artifact target") ?? return Err(err)
        resolved.push(Artifact{target: artifact.target, file: resolve(artifact.file) ?? return Err(err)})
    }
    Ok(Options{
        version: version,
        sequence: sequence,
        channel: channel,
        min_version: min_version,
        published_at: published_at,
        expires_at: expires_at,
        output: resolve(output) ?? return Err(err),
        artifacts: resolved,
    })
}

parse_positive: fn(value: String, label: String) -> Int StageError! {
    if !POSITIVE.is_match(value) -> return Err(failed("{label} must be a positive integer"))
    if value.len() > 16 -> return Err(failed("{label} is outside the safe integer range"))
    parsed: Int.parse(value) ?? return Err(failed("{label} is outside the safe integer range"))
    if parsed > SAFE_INTEGER -> return Err(failed("{label} is outside the safe integer range"))
    Ok(parsed)
}

validate_semver: fn(value: String, label: String) StageError! {
    if !SEMVER.is_match(value) -> return Err(failed("{label} must be a SemVer major.minor.patch value"))
    Ok()
}

validate_component: fn(value: String, label: String) StageError! {
    if value == "." || value == ".." || !COMPONENT.is_match(value) -> return Err(failed("{label} contains unsafe characters"))
    Ok()
}

// `path` made absolute against the working directory, with `.` and `..` folded.
resolve: fn(path: String) -[Env, FS]> String StageError! {
    absolute: files.absolute(path) ?? return Err(failed("cannot resolve {path}: {err}"))
    Ok(files.normpath(absolute))
}

// The absolute path's leading directories, then the path itself.
prefixes: fn(path: String) -> [String] Never! {
    out := [String]{}
    cursor := ""
    loop component in path.split("/") {
        if component == "" -> next
        cursor = "{cursor}/{component}"
        out.push(cursor.copy())
    }
    out
}

// What is at `path`, without following a final link.
entry: fn(path: String, label: String) -[FS]> Entry StageError! {
    if files.stat(path) == {
        .Ok(info) -> Ok(Entry.Present(info))
        .Err(.NotFound(_)) -> Ok(Entry.Missing)
        .Err(error) -> Err(failed("{label} path cannot be inspected: {path}: {error}"))
    }
}

reject_symlink_ancestors: fn(target: String, label: String) -[FS]> StageError! {
    steps: prefixes(target)
    loop (index, cursor) in steps {
        info: entry(cursor, label) ?? return Err(err)
        if info == {
            .Missing -> break
            .Present(found) -> {
                if found.is_symlink -> return Err(failed("{label} path traverses a symlink: {cursor}"))
                if index + 1 < steps.len() && !found.is_dir -> return Err(failed("{label} path has a non-directory ancestor: {cursor}"))
            }
        }
    }
    Ok()
}

// The size of the regular, non-empty, in-bound file at `file`.
regular: fn(file: String, label: String) -[FS]> Int StageError! {
    reject_symlink_ancestors(file, label) ?? return Err(err)
    info: entry(file, label) ?? return Err(err)
    found: if info == {
        .Present(stat) -> stat
        .Missing -> return Err(failed("{label} is missing: {file}"))
    }
    if found.is_symlink || !found.is_file -> return Err(failed("{label} is not a regular file: {file}"))
    if found.size == 0 -> return Err(failed("{label} is empty"))
    if found.size > MAX_ARTIFACT_BYTES -> return Err(failed("{label} exceeds the {MAX_ARTIFACT_BYTES} byte bound"))
    Ok(found.size)
}

// The bytes of `file`, refusing a final link, more than `limit` bytes, and
// a file whose size moved away from `size` while it was read.
read_bounded: fn(file: String, size: Int, label: String, limit: Int) -[FS]> [U8] StageError! {
    reader := files.open(file, links: .Refuse) ?? return Err(failed("{label} cannot be opened: {file}: {err}"))
    bytes := [U8]{}
    loop {
        chunk: reader.read(READ_CHUNK) ?? return Err(failed("{label} cannot be read: {file}: {err}"))
        if chunk.len() == 0 -> break
        if bytes.len() + chunk.len() > limit -> return Err(failed("{label} exceeds the {limit} byte bound"))
        bytes.extend(chunk)
    }
    if bytes.len() != size -> return Err(failed("{label} changed while it was read"))
    if bytes.len() == 0 -> return Err(failed("{label} is empty"))
    Ok(bytes)
}

// Make `dir` and its missing ancestors, each a real directory.
directory: fn(dir: String, label: String) -[FS]> StageError! {
    loop cursor in prefixes(dir) {
        info := entry(cursor, label) ?? return Err(err)
        if info == .Missing {
            files.create_dir_all(cursor) ?? return Err(failed("{label} cannot be created: {cursor}: {err}"))
            info = entry(cursor, label) ?? return Err(err)
        }
        if info == .Present(found) && !found.is_symlink && found.is_dir -> next
        return Err(failed("{label} is not a real directory: {cursor}"))
    }
    Ok()
}

// Publish `bytes` at `file` once: an existing file must already hold them.
// A new file is written beside it, synced, renamed into place, and its
// directory synced.
immutable: fn(file: String, bytes: [U8]) -[Env, FS]> StageError! {
    reject_symlink_ancestors(file, "publication") ?? return Err(err)
    existing: entry(file, "publication") ?? return Err(err)
    if existing == .Present(found) {
        if found.is_symlink || !found.is_file -> return Err(failed("publication path is not a regular file: {file}"))
        if found.size != bytes.len() -> return Err(failed("immutable publication file changed: {file}"))
        held: read_bounded(file, found.size, "existing publication file", bytes.len()) ?? return Err(err)
        if held != bytes -> return Err(failed("immutable publication file changed: {file}"))
        return Ok()
    }
    parent: files.dirname(file)
    directory(parent, "publication parent") ?? return Err(err)
    reject_symlink_ancestors(file, "publication") ?? return Err(err)
    partial: "{file}.partial-{sys.getpid()}"
    reject_symlink_ancestors(partial, "publication temporary file") ?? return Err(err)
    if files.lexists(partial) -> return Err(failed("publication temporary file is already present: {partial}"))
    writer := files.create(partial, if_exists: .Refuse, mode: Val(0o644), links: .Refuse) ?? return Err(failed("publication temporary file cannot be created: {partial}: {err}"))
    if publish(writer, partial, file, parent, bytes) == .Err(error) {
        files.remove(partial).drop("the partial file is removed best-effort")
        return Err(failed("publication write failed: {file}: {error}"))
    }
    Ok()
}

publish: fn(writer: &files.FileWriter, partial: String, file: String, parent: String, bytes: [U8]) IOError! -[FS]> {
    writer.write_all(bytes) ?? return Err(err)
    writer.fsync() ?? return Err(err)
    files.rename(partial, file) ?? return Err(err)
    held: files.open_directory(parent) ?? return Err(err)
    held.fsync()
}

#Test("the manifest is compact JSON in target order with domain-prefixed requests") {
    options: Options{
        version: "1.2.3", sequence: 7, channel: "stable", min_version: "1.0.0",
        published_at: 10, expires_at: 20, output: "/out", artifacts: [Artifact]{},
    }
    staged: [Staged{target: "x86_64-unknown-linux-gnu", path: "v1/stable/1.2.3/jet-1.2.3-x86_64-unknown-linux-gnu", sha256: "ab", bytes: "hi".bytes()}]
    text: String.from_bytes(manifest_bytes(options, staged)) ?? panic("UTF-8 manifest")
    assert_eq(text, "{{\"schema\":1,\"channel\":\"stable\",\"version\":\"1.2.3\",\"sequence\":7,\"published_at\":10,\"expires_at\":20,\"min_version\":\"1.0.0\",\"artifacts\":[{{\"target\":\"x86_64-unknown-linux-gnu\",\"path\":\"v1/stable/1.2.3/jet-1.2.3-x86_64-unknown-linux-gnu\",\"sha256\":\"ab\",\"size\":2,\"signature\":\"v1/stable/1.2.3/jet-1.2.3-x86_64-unknown-linux-gnu.sig.json\"}}]}}\n")
    assert_eq(String.from_bytes(signing_request("jet-toolchain-channel-v1", "{{}}".bytes())) ?? "", "jet-toolchain-channel-v1\n{{}}")
}

semver_passes: fn(value: String) -> Bool Never! {
    validate_semver(value, "version") ?? return false
    true
}

component_passes: fn(value: String) -> Bool Never! {
    validate_component(value, "target") ?? return false
    true
}

#Test("versions, components and integers follow the publisher's rules") {
    assert(semver_passes("1.2.3-rc.1+build.5"))
    assert(!semver_passes("01.2.3"))
    assert(component_passes("x86_64-unknown-linux-gnu"))
    assert(!component_passes(".."))
    assert(!component_passes("a/b"))
    assert_eq(parse_positive("42", "sequence") ?? -1, 42)
    assert_eq(parse_positive("042", "sequence") ?? -1, -1)
    assert_eq(parse_positive("9007199254740992", "sequence") ?? -1, -1)
    assert_eq(prefixes("/a/b/c"), ["/a", "/a/b", "/a/b/c"])
}
