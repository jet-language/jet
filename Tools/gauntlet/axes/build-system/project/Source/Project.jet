// The build-system axis project (Nix peer); the twin of generate.mjs's
// generator.
//
// One medium project, two build systems. The program is the mid-size
// build-time workload (jet_midsize_units: 90 units folded into one checksum
// line), split into one source file per 10 units so a one-file edit is a real
// incremental change:
//   jet/  a Jet package: package.jet, the build program @build.jet
//         (`build: fn` registers one executable), run.jet, units_0..8.jet
//   nix/  a flake: flake.nix (stdenv.mkDerivation over src/), flake.lock
//         pinning the repository's own nixpkgs, src/Makefile, src/main.c,
//         src/units.h, src/units_0..8.c
// Both artifacts print Tools/perf/build-time/midsize.out byte for byte. The
// measurement manifest pins these files, so the text below is the project
// byte for byte, the header naming generate.mjs included.
use {
    jet_midsize_units.[MODULUS, UNITS, every_unit, jet_fold, jet_unit, seed, unit_constants]
    files: core.files
    json: core.encoding.json
}

FILES: 9
UNITS_PER_FILE: UNITS /% FILES
SYSTEM: "x86_64-linux"
HEADER: "Build-system axis project (generated by Tools/gauntlet/axes/build-system/generate.mjs; do not edit)."

// The units of source file `file`, rendered by `render`, one after another.
file_units: fn(file: Int, render: fn(Int) -> String) -> String {
    out := [String]{}
    loop k in 0..<UNITS_PER_FILE -> out.push(render(file * UNITS_PER_FILE + k))
    out.join("\n")
}

c_unit: fn(i: Int) -> String {
    k: unit_constants(i)
    """
        /* Unit {i}: state step, classification, and scoring. */
        typedef struct {{
            int64_t a;
            int64_t b;
            int64_t c;
        }} State{i};

        enum {{ KIND{i}_LOW, KIND{i}_MID, KIND{i}_HIGH }};

        typedef struct {{
            int tag;
            int64_t v;
        }} Kind{i};

        static Kind{i} classify_{i}(int64_t x) {{
            if (x < {k.t1}) {{
                return (Kind{i}){{KIND{i}_LOW, x}};
            }}
            if (x < {k.t2}) {{
                return (Kind{i}){{KIND{i}_MID, x - {k.t1}}};
            }}
            return (Kind{i}){{KIND{i}_HIGH, 0}};
        }}

        static int64_t score_{i}(Kind{i} kind) {{
            switch (kind.tag) {{
            case KIND{i}_LOW:
                return kind.v * {k.c1} + 1;
            case KIND{i}_MID:
                return kind.v * {k.c2} + 7;
            default:
                return {k.c3};
            }}
        }}

        static State{i} step_{i}(State{i} s, int64_t x) {{
            int64_t a = (s.a * {k.c1} + x + 1) % {MODULUS};
            int64_t b = (s.b + a * {k.c2}) % {MODULUS};
            int64_t c = (s.c + a + b * 3) % {MODULUS};
            return (State{i}){{a, b, c}};
        }}

        int64_t unit_{i}(int64_t seed) {{
            State{i} s = {{seed % {MODULUS}, {k.c2}, {k.c3}}};
            int64_t values[{k.n}];
            for (int64_t j = 0; j < {k.n}; j++) {{
                s = step_{i}(s, j);
                values[j] = score_{i}(classify_{i}(s.a % 1000));
            }}
            int64_t total = 0;
            for (int64_t j = 0; j < {k.n}; j++) {{
                if (values[j] % 2 == 0) {{
                    total += values[j];
                }} else {{
                    total += values[j] * 3;
                }}
            }}
            return (total + s.b + s.c) % {MODULUS};
        }}

        """
}

// The text at JSON pointer `path` of the repository's flake.lock.
lock_text: fn(lock: Dyn, path: String) -> String Err! {
    value: json.pointer(lock, path) ?? return Err("flake.lock has nothing at {path}")
    if value == .Text(text) -> return Ok(text.copy())
    Err("flake.lock's {path} is not text")
}

// Every file of the project, by path under the output directory, with the
// flake pinning the nixpkgs that `repo`'s own flake.lock locks.
project: fn(repo: String) -[FS]> [String:String] Err! {
    lock: json.parse(files.read(files.join(repo, "flake.lock"))) ?? return Err("flake.lock: {err}")
    input: lock_text(lock, "/nodes/{lock_text(lock, "/root")}/inputs/nixpkgs")
    locked: json.pointer(lock, "/nodes/{input}/locked") ?? return Err("flake.lock's nixpkgs input is not locked")
    owner: lock_text(locked, "/owner")
    repository: lock_text(locked, "/repo")
    rev: lock_text(locked, "/rev")
    kind: lock_text(locked, "/type")
    pinned: Dyn{[String: Dyn]{
        "nodes": [
            "nixpkgs": ["locked": locked, "original": ["owner": owner, "repo": repository, "rev": rev, "type": kind]],
            "root": ["inputs": ["nixpkgs": "nixpkgs"]],
        ],
        "root": "root",
        "version": 7,
    }}
    out := [String:String]{}
    sources := ["\"run.jet\""]
    objects := ["main.o"]
    loop file in 0..<FILES {
        name: "units_{file}"
        sources.push("\"{name}.jet\"")
        objects.push("{name}.o")
        out["jet/{name}.jet"] = "// {HEADER}\n{file_units(file, jet_unit)}"
        out["nix/src/{name}.c"] = "/* {HEADER} */\n#include \"units.h\"\n\n{file_units(file, c_unit)}"
    }
    out["jet/package.jet"] = "// {HEADER}\nname: \"medium\"\nversion: \"0.1.0\"\nedition: \"2026\"\n"
    out["jet/@build.jet"] = "// {HEADER}\nbuild: fn(b: Build) {{\n    app: b.add_executable(\"medium\", [{sources.join(", ")}], [])\n    b.default(app)\n}}\n"
    out["jet/run.jet"] = "// {HEADER}\nrun: fn() {{\n    total := 0\n{every_unit(jet_fold)}\n    print(\"checksum {{total}}\")\n}}\n"
    out["nix/flake.nix"] = """
        # {HEADER}
        {{
          inputs.nixpkgs.url = "github:{owner}/{repository}/{rev}";

          outputs =
            {{ self, nixpkgs }}:
            let
              pkgs = nixpkgs.legacyPackages.{SYSTEM};
            in
            {{
              packages.{SYSTEM}.default = pkgs.stdenv.mkDerivation {{
                pname = "medium";
                version = "0.1.0";
                src = ./src;
                enableParallelBuilding = true;
                installPhase = "install -Dm755 medium $out/bin/medium";
              }};
            }};
        }}

        """
    out["nix/flake.lock"] = "{json.stringify(pinned, 2)}\n"
    out["nix/src/Makefile"] = "# {HEADER}\nOBJS = {objects.join(" ")}\n\nmedium: $(OBJS)\n\t$(CC) -O1 -o $@ $(OBJS)\n\n%.o: %.c units.h\n\t$(CC) -O1 -c $<\n"
    out["nix/src/units.h"] = "/* {HEADER} */\n#include <stdint.h>\n\n{every_unit(i -> "int64_t unit_{i}(int64_t seed);")}\n"
    out["nix/src/main.c"] = "/* {HEADER} */\n#include <inttypes.h>\n#include <stdio.h>\n#include \"units.h\"\n\nint main(void) {{\n    int64_t total = 0;\n{every_unit(i -> "    total = (total * 31 + unit_{i}({seed(i)})) % {MODULUS};")}\n    printf(\"checksum %\" PRId64 \"\\n\", total);\n    return 0;\n}}\n"
    Ok(out)
}

// Writes the project into `out_dir`.
write_project: fn(out_dir: String, repo: String) -[FS]> Err! {
    loop (name, text) in project(repo) {
        path: files.join(out_dir, name)
        files.create_dir_all(files.dirname(path))
        files.write(path, text)
    }
}
