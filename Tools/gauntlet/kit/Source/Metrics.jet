// A gauntlet metric and its loss-owner category: the key of an entry's
// measurement-manifest `loss_owners` row whose card owns a loss on it.
LossOwner: struct {
    metric: String
    category: String
}

// Every metric that has a loss-owner category, in the gauntlet's order.
LOSS_OWNERS: [LossOwner]{
    {metric: "runtime_wall_seconds", category: "runtime"},
    {metric: "runtime_first_stdout_seconds", category: "runtime"},
    {metric: "service_latency_ms_p50", category: "latency"},
    {metric: "service_latency_ms_p99", category: "latency"},
    {metric: "service_startup_seconds", category: "runtime"},
    {metric: "runtime_peak_rss_kb", category: "rss"},
    {metric: "peak_rss_bytes", category: "rss"},
    {metric: "cold_build_seconds", category: "build"},
    {metric: "warm_build_seconds", category: "build"},
    {metric: "binary_bytes", category: "binary"},
    {metric: "artifact_bytes", category: "binary"},
    {metric: "wasm_bytes", category: "binary"},
    {metric: "loc", category: "source"},
    {metric: "source_bytes", category: "source"},
    {metric: "tokens", category: "source"},
    {metric: "source_tokens", category: "source"},
}

// The loss-owner category of a gauntlet metric.
loss_owner_category: fn(metric: String) -> String? {
    owner: LOSS_OWNERS.find(fn(owner) { owner.metric == metric }) ?? return None
    Val(owner.category.copy())
}

#Test("each metric names its loss-owner category, and an unknown metric none") {
    assert_eq(loss_owner_category("runtime_first_stdout_seconds"), Val("runtime"))
    assert_eq(loss_owner_category("service_latency_ms_p99"), Val("latency"))
    assert_eq(loss_owner_category("peak_rss_bytes"), Val("rss"))
    assert_eq(loss_owner_category("warm_build_seconds"), Val("build"))
    assert_eq(loss_owner_category("wasm_bytes"), Val("binary"))
    assert_eq(loss_owner_category("source_tokens"), Val("source"))
    assert_eq(loss_owner_category("lines_per_second"), None)
}
