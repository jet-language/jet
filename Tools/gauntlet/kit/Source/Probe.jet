// One probe of a service under measurement, over HTTP or a line protocol,
// whether its answer is the one the entry expects, and why not. The twins
// of httpProbe, lineProbe, serviceProbe, probeMatches, probeMismatch and
// headerMismatch in Tools/gauntlet/harness/run.mjs.
use {
    client: core.http.client
    http: core.http
    json: core.encoding.json
    net: core.net
    time: core.time
}

// How long one service probe may take, in milliseconds.
PROBE_TIMEOUT_MS: 5000

// Response headers a repeat of which Node drops, keeping the first.
SINGLE_HEADERS: ["age", "authorization", "content-length", "content-type", "etag", "expires", "from", "host", "if-modified-since", "if-unmodified-since", "last-modified", "location", "max-forwards", "proxy-authorization", "referer", "retry-after", "server", "user-agent"]

// What one HTTP probe of the service on local `port` answered: `ok`, then
// the status, headers (named in lowercase, repeats merged as Node merges
// them) and body of a response, or the error of a request that failed, and
// the latency in milliseconds. `probe` names the `method` (GET by default),
// `path` and `body`; a request that takes `timeout_ms` fails.
http_probe: fn(port: Int, probe: Dyn, timeout_ms: Int) -[Net, Time, Time.Wait]> Dyn {
    started: time.instant()
    method: or_text(member(probe, "method"), "GET")
    path: if truthy_at(probe, "path") -> js_text(dyn_at(probe, "path")) else -> "/"
    request := client.request(method, "http://127.0.0.1:{port}{path}").timeout(timeout_ms).redirects(0)
    if value_at(probe, "body") == .Val(sent) -> request = request.body(js_text(sent))
    answer: request.send() ?? return failed_probe(probe_error(err, port, started, timeout_ms), started)
    body: answer.text() ?? return failed_probe(probe_error(err, port, started, timeout_ms), started)
    out := Dyn.object()
    out["ok"] = Dyn.Bool(true)
    out["status"] = Dyn.Int(answer.status())
    out["headers"] = node_headers(answer.headers.fields)
    out["body"] = Dyn.Text(body)
    out["latencyMs"] = latency(started)
    out
}

// Whether the answer `result` to `probe` over `protocol` is the expected
// one: a line service's body is the expected line; an HTTP service's
// status and body are the expected ones when the probe names them, and its
// headers carry every expected header.
probe_matches: fn(probe: Dyn, result: Dyn, protocol: Dyn) -> Bool {
    if !truthy_at(result, "ok") -> return false
    if protocol == Dyn.Text("line") -> return strictly_equal(value_at(result, "body"), value_at(probe, "expect"))
    expected_status: value_at(probe, "expectStatus")
    expected_body: value_at(probe, "expectBody")
    (expected_status == None || strictly_equal(value_at(result, "status"), expected_status)) &&
        (expected_body == None || strictly_equal(value_at(result, "body"), expected_body)) &&
        expected_headers_match(dyn_at(probe, "expectHeaders"), dyn_at(result, "headers"))
}

// Whether the response headers `actual` carry every header of `expected`,
// named in any case, a content type compared as a media type.
expected_headers_match: fn(expected: Dyn, actual: Dyn) -> Bool {
    if !is_header_map(expected) || !(actual == .Object(_)) -> return false
    lowered := Dyn.object()
    loop header in members(actual) -> lowered[header.key.lower()] = header.value
    members(expected).all(fn(header) { header_matches(header.key, js_text(header.value), dyn_at(lowered, header.key.lower())) })
}

// Whether the response header `found` is a string that compares equal to
// the expected `value` of the header `name`.
header_matches: fn(name: String, value: String, found: Dyn) -> Bool {
    if found == .Text(actual) -> return normalized_header_value(name, actual) == normalized_header_value(name, value)
    false
}

// A header value as it is compared: trimmed; a content type's media type
// and parameter names also in lowercase and its parameters sorted.
normalized_header_value: fn(name: String, value: String) -> String {
    trimmed: value.trim()
    if name.lower() != "content-type" -> return trimmed
    parts: trimmed.split(";").to_list()
    parameters := parts.slice(1, parts.len()).map(fn(part) { normalized_parameter(part) })
    parameters.sort()
    [parts[0].trim().lower()].concat(parameters).join(";")
}

// A content-type parameter as it is compared: its name trimmed and in
// lowercase, its value trimmed.
normalized_parameter: fn(part: String) -> String {
    pieces: part.split("=").to_list()
    if pieces.len() == 1 -> return part.trim().lower()
    "{pieces[0].trim().lower()}={pieces.slice(1, pieces.len()).join("=").trim()}"
}

// The probe's answer when the request failed.
failed_probe: fn(error: String, started: time.Instant) -> Dyn {
    out := Dyn.object()
    out["ok"] = Dyn.Bool(false)
    out["error"] = Dyn.Text(error.copy())
    out["latencyMs"] = latency(started)
    out
}

// The error Node gives for a request to local `port` that failed: a request
// still unanswered once `timeout_ms` passed since `started` timed out, one
// that could not connect was refused, and any other one hung up.
probe_error: fn(error: HTTPError, port: Int, started: time.Instant, timeout_ms: Int) -> String {
    if {
        error == .Timeout(_) || started.elapsed().ns >= timeout_ms * 1000000 -> "HTTP probe timeout"
        error == .Connect(_) -> "connect ECONNREFUSED 127.0.0.1:{port}"
        else -> "socket hang up"
    }
}

// The milliseconds since `started`.
latency: fn(started: time.Instant) -> Dyn {
    Dyn.Float(Float.from_int(started.elapsed().ns) / Float{1000000.0})
}

// Response headers as Node gives them: each name in lowercase once, in the
// order first seen; a repeated set-cookie as an array, a repeated cookie
// joined by `; `, a repeat of a single-valued header dropped and any other
// repeat joined by `, `.
node_headers: fn(fields: [http.Header]) -> Dyn {
    out := Dyn.object()
    loop field in fields {
        name: field.name.lower()
        seen: dyn_at(out, name)
        out[name] = if {
            name == "set-cookie" -> Dyn.Array(items_at(seen, "").concat([Dyn.Text(field.value.copy())]))
            seen == .Text(first) && SINGLE_HEADERS.contains(name) -> Dyn.Text(first)
            seen == .Text(first) && name == "cookie" -> Dyn.Text("{first}; {field.value}")
            seen == .Text(first) -> Dyn.Text("{first}, {field.value}")
            else -> Dyn.Text(field.value.copy())
        }
    }
    out
}

// What one probe of the line service on local `port` answered: `ok` and
// the first line it sent (all it sent when it closed before a newline), or
// the error of a probe that failed, and the latency in milliseconds. The
// probe sends its `send` text, then closes its write side; a probe still
// unanswered once `timeout_ms` pass fails.
line_probe: fn(port: Int, probe: Dyn, timeout_ms: Int) -[Net, Time, Time.Wait]> Dyn {
    started: time.instant()
    address: net.socket_addr_parse("127.0.0.1:{port}") ?? return failed_probe("{err}", started)
    stream := net.tcp_connect_timeout(address, timeout_ms) ?? return failed_probe(line_error(started, timeout_ms, "connect ECONNREFUSED 127.0.0.1:{port}"), started)
    sent: if dyn_at(probe, "send") == .Null -> "" else -> js_text(dyn_at(probe, "send"))
    net.tcp_write_text(stream, sent) ?? return closed_probe(stream, failed_probe("{err}", started))
    net.tcp_shutdown(stream, NetShutdown.Write) ?? return closed_probe(stream, failed_probe("{err}", started))
    body := [U8]{}
    loop {
        remaining: timeout_ms - started.elapsed_millis()
        if remaining <= 0 -> return closed_probe(stream, failed_probe("line probe timeout", started))
        ready: net.tcp_ready(stream, NetReadyInterest.Read, remaining) ?? return closed_probe(stream, failed_probe(line_error(started, timeout_ms, "{err}"), started))
        if !net.ready_readable(ready) -> return closed_probe(stream, failed_probe("line probe timeout", started))
        part: net.tcp_read_bytes(stream, 8192) ?? return closed_probe(stream, failed_probe("{err}", started))
        if part.len() == 0 -> break
        body = body.concat(part)
        text: String.from_bytes_lossy(body)
        if text.index_of("\n") == .Val(newline) -> return closed_probe(stream, answered_line(text.slice(0, newline + 1), started))
    }
    closed_probe(stream, answered_line(String.from_bytes_lossy(body), started))
}

// A line probe's error: a timeout once `timeout_ms` passed since `started`,
// else `error`.
line_error: fn(started: time.Instant, timeout_ms: Int, error: String) -> String {
    if started.elapsed_millis() >= timeout_ms -> "line probe timeout" else -> error
}

// The line probe's answer `body`.
answered_line: fn(body: &&String, started: time.Instant) -> Dyn {
    out := Dyn.object()
    out["ok"] = Dyn.Bool(true)
    out["body"] = Dyn.Text(body)
    out["latencyMs"] = latency(started)
    out
}

// `result`, once `stream` is closed.
closed_probe: fn(&stream: TCPStream, result: &&Dyn) -> Dyn {
    net.tcp_close(stream).drop("the probe is answered whether or not its socket closes cleanly")
    result
}

// One probe of the service on local `port` over `protocol`: a line probe
// for "line", else an HTTP probe, each failing after 5 seconds.
service_probe: fn(port: Int, probe: Dyn, protocol: String) -[Net, Time, Time.Wait]> Dyn {
    if protocol == "line" -> line_probe(port, probe, PROBE_TIMEOUT_MS) else -> http_probe(port, probe, PROBE_TIMEOUT_MS)
}

// Why the answer `result` to `probe` over `protocol` is not the expected
// one: the error of a probe that failed, else the first part that differs.
probe_mismatch: fn(probe: Dyn, result: Dyn, protocol: String) -> String {
    if !truthy_at(result, "ok") -> return js_text(dyn_at(result, "error"))
    if protocol == "line" -> return "body {json_shown(value_at(result, "body"))}, expected {json_shown(value_at(probe, "expect"))}"
    expected_status: value_at(probe, "expectStatus")
    if expected_status != None && !strictly_equal(value_at(result, "status"), expected_status) -> return "status {js_text(dyn_at(result, "status"))}, expected {js_text(dyn_at(probe, "expectStatus"))}"
    expected_body: value_at(probe, "expectBody")
    if expected_body != None && !strictly_equal(value_at(result, "body"), expected_body) -> return "body {json_shown(value_at(result, "body"))}, expected {json_shown(expected_body)}"
    header_mismatch(probe, result)
}

// The first expected header of `probe` the answer `result` lacks or
// carries with another value.
header_mismatch: fn(probe: Dyn, result: Dyn) -> String {
    expected: dyn_at(probe, "expectHeaders")
    if !is_header_map(expected) -> return "missing expected response headers"
    lowered := Dyn.object()
    if dyn_at(result, "headers") == .Object(_) {
        loop header in members(dyn_at(result, "headers")) -> lowered[header.key.lower()] = header.value
    }
    loop header in members(expected) {
        found: value_at(lowered, header.key.lower()) ?? return "header {header.key} is missing, expected {json.stringify(header.value)}"
        if !header_matches(header.key, js_text(header.value), found) -> return "header {header.key} was {json.stringify(found)}, expected {json.stringify(header.value)}"
    }
    "response headers did not match expected values"
}

// `value` as JSON.stringify writes it; `undefined` for none.
json_shown: fn(value: Dyn?) -> String {
    found: value ?? return "undefined"
    json.stringify(found)
}

#Test("a content type matches as a media type with sorted parameters; another header only trimmed") {
    assert_eq(normalized_header_value("Content-Type", " Text/HTML ; Q=1 ; charset=UTF-8 ; flag "), "text/html;charset=UTF-8;flag;q=1")
    assert_eq(normalized_header_value("X-Trace", " Abc "), "Abc")
    assert(expected_headers_match(Dyn{[String: Dyn]{"content-type": "text/html;charset=UTF-8"}}, Dyn{[String: Dyn]{"Content-Type": "text/html; charset=UTF-8"}}))
    assert(!expected_headers_match(Dyn{[String: Dyn]{"content-type": "text/html; charset=utf-8"}}, Dyn{[String: Dyn]{"content-type": "text/html; charset=UTF-8"}}))
    assert(!expected_headers_match(Dyn.object(), Dyn{[String: Dyn]{"content-type": "text/html"}}))
}

#Test("a probe matches only an answer that is ok and as expected") {
    answer: Dyn{[String: Dyn]{"ok": Dyn.Bool(true), "status": Dyn.Int(200), "body": "hi", "headers": Dyn{[String: Dyn]{"content-type": "text/plain"}}}}
    probe: Dyn{[String: Dyn]{"expectStatus": Dyn.Int(200), "expectBody": "hi", "expectHeaders": Dyn{[String: Dyn]{"Content-Type": "text/plain"}}}}
    assert(probe_matches(probe, answer, Dyn.Text("http")))
    assert(!probe_matches(Dyn{[String: Dyn]{"expectStatus": Dyn.Null, "expectHeaders": Dyn{[String: Dyn]{"Content-Type": "text/plain"}}}}, answer, Dyn.Text("http")))
    assert(!probe_matches(Dyn{[String: Dyn]{"expectStatus": Dyn.Int(200)}}, answer, Dyn.Null))
    assert(probe_matches(Dyn{[String: Dyn]{"expect": "hi"}}, answer, Dyn.Text("line")))
    assert(!probe_matches(probe, Dyn{[String: Dyn]{"ok": Dyn.Bool(false)}}, Dyn.Text("http")))
}

#Test("repeated response headers merge as Node merges them") {
    fields: [http.Header]{
        http.Header{name: "Set-Cookie", value: "a=1"},
        http.Header{name: "X-Many", value: "a"},
        http.Header{name: "set-cookie", value: "b=2"},
        http.Header{name: "x-many", value: "b"},
        http.Header{name: "Server", value: "one"},
        http.Header{name: "Server", value: "two"},
    }
    assert_eq(json.stringify(node_headers(fields)), "{{\"set-cookie\":[\"a=1\",\"b=2\"],\"x-many\":\"a, b\",\"server\":\"one\"}}")
}
