use core.[http.server, net]

ServerState: struct {
    stopped: Bool
}

#CLI
Args: struct {
    port: String
}

reply: fn(status: Int, body: String) -> HTTPResponse HTTPError! { Ok(server.response(status, body).header("content-type", "application/json")) }

kv: fn(key: String, req: HTTPRequest, store: Shared<[String:String]>, put: Bool) -> HTTPResponse HTTPError! {
    if put {
        value: req.body().text(8388608) ?? ""
        store.guard_edit().value[key] = value
        return reply(200, "{{\"stored\":\"{key}\"}}")
    }
    stored: store.guard_read().value.get(key) ?? return reply(404, "{{\"error\":\"not found\"}}")
    return reply(200, "{{\"key\":\"{key}\",\"value\":\"{stored}\"}}")
}

run: fn(args: Args) (HTTPError | IOError | NetError)! {
    listener: net.tcp_listen("127.0.0.1:{args.port}")
    store: Shared{[String:String]{}}
    state: Shared{ServerState{stopped: false}}
    mux: server.mux()
    mux.get("/health", () -> reply(200, "{{\"status\":\"ok\"}}"))
    mux.put("/kv/:key", (key: String, req: HTTPRequest) -> kv(key, req, store, true))
    mux.get("/kv/:key", (key: String, req: HTTPRequest) -> kv(key, req, store, false))
    mux.get("/shutdown", () -> {
        state.stopped = true
        reply(200, "{{\"bye\":true}}")
    })
    loop {
        if state.stopped -> break
        server.serve_once_listener(listener, mux) ?? panic("serve failed")
    }
}
