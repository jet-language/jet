use core.[files, time]

#CLI
Args: struct {
    path: String
}

run: fn(args: Args) Err! {
    meetings := files.read(args.path).lines().filter(fn(line) { line != "" }).map(fn(line) {
        fields: line.split_once("|") ?? panic("bad meeting")
        (name: fields.before, when: time.parse_rfc3339(fields.after) ?? panic("bad timestamp"))
    })
    meetings.sort_by(.when)
    loop (position, meeting) in meetings {
        gap: if position == 0 -> "-" else -> "{meeting.when.difference(meetings[position - 1].when).in(.Minutes)}"
        print("{meeting.name} utc={meeting.when.format_rfc3339()} day={meeting.when.format("%a")} gap={gap}")
    }
    print("span {meetings[meetings.len() - 1].when.difference(meetings[0].when).in(.Minutes)} minutes {meetings.len()}")
}
