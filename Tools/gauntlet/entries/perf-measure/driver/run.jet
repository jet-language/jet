// The gauntlet driver of the kit's Measure module (#5072 c7), the twin of
// driver.mjs beside it: one command per measure.mjs export, printing its
// result as JSON.
//
//   jet driver trace FILE | strict FILE IDENTITY | phases TRACE SAMPLES OFFSET
//              | cpu SAMPLES T... | counters FILE | tree | run
package: {
    name: "perf_measure_driver"
    version: "0.0.1"
    deps: {
        jet_perf_kit: ../../../../perf/kit,
    }
}

use {
    files: core.files
    jet_perf_kit.[KIT_ZERO, MeasureError, MeasureOptions, Sample, completed_from, counters_json, cpu_at, field, items, json_stringify, measure_host, number_from_text, parse_counters, phase_table, phase_table_json, read_failure, read_trace, run_measured, safe_integer, sample_tree, to_number]
    json: core.encoding.json
    process: core.process
    time: core.time
}

USAGE: "usage: driver trace|strict|phases|cpu|counters|tree|run|timeout ..."
QUIET: "sleep 3 </dev/null >/dev/null 2>&1"

// An error's message (a JSON refusal is a SyntaxError) and exit 1.
fail: fn(error: MeasureError) -[Exec, IO]> Never {
    if error.syntax -> print("error: SyntaxError") else -> print("error: {error.message}")
    process.exit(1)
}

// JSON.parse(readFileSync(file)).
read_json: fn(file: String) -[Exec, FS, IO]> Dyn {
    text: files.read(file) ?? fail(read_failure(file, err))
    json.parse(text) ?? fail(MeasureError{message: "{err}", syntax: true})
}

samples_of: fn(value: Dyn) -> [Sample] {
    out := [Sample]{}
    loop item in items(Val(value)) -> out.push(Sample{t_ns: to_number(field(item, "tNs")), cpu_ns: to_number(field(item, "cpuNs")), threads: 0, rss_bytes: 0, processes: 0})
    out
}

show_trace: fn(argv: [String]) -[Exec, FS, IO]> {
    events: read_trace(argv[1], None) ?? fail(err)
    print(json_stringify(Dyn.Array(events), 0))
}

show_strict: fn(argv: [String]) -[Exec, FS, IO]> {
    identity: read_json(argv[2])
    completed: completed_from(safe_integer(field(Val(identity), "exitCode")), field(Val(identity), "pid"), field(Val(identity), "startedUnixMs"), field(Val(identity), "finishedUnixMs"))
    events: read_trace(argv[1], Val(completed)) ?? fail(err)
    print("{events.len()} events")
}

show_phases: fn(argv: [String]) -[Exec, FS, IO]> {
    events: read_trace(argv[1], None) ?? fail(err)
    table: phase_table(events, samples_of(read_json(argv[2])), number_from_text(argv[3]))
    print(json_stringify(phase_table_json(table), 2))
}

show_cpu: fn(argv: [String]) -[Exec, FS, IO]> {
    samples: samples_of(read_json(argv[1]))
    out := [Dyn]{}
    loop at in 2..<argv.len() -> out.push(Dyn.Float(cpu_at(samples, number_from_text(argv[at]))))
    print(json_stringify(Dyn.Array(out), 0))
}

show_counters: fn(argv: [String]) -[Exec, FS, IO]> {
    text: files.read(argv[1]) ?? fail(read_failure(argv[1], err))
    counters: parse_counters(text) ?? fail(err)
    print(json_stringify(counters_json(counters), 2))
}

// A shell holding two sleeps, sampled once they run.
show_tree: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> {
    child: process.cmd([String]{"sh", "-c", "{QUIET} & {QUIET} & wait"}).stdout(.Capture).stderr(.Capture).spawn() ?? fail(MeasureError{message: "{err}", syntax: false})
    time.sleep(300ms)
    tree: sample_tree(child.id(), measure_host())
    print("processes {tree.processes} threads {tree.threads} rss {tree.rss_bytes > 0} cpu {tree.cpu_ns >= KIT_ZERO}")
    child.kill().drop("the shell's group may be gone already")
    child.wait().drop("the shell was killed")
}

show_run: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> {
    measured: run_measured([String]{"true"}, MeasureOptions{cwd: None, env: None, stdout_path: "out.txt", stderr_path: "err.txt", timeout_ms: 0}) ?? {
        print("files {files.exists("out.txt")} {files.exists("err.txt")} {files.exists("err.txt.time")}")
        fail(err)
    }
    if measured.code == .Val(code) -> print("code {code}") else -> print("code null")
}

// A tree past its 300 ms timeout: the whole tree is killed, so the
// background writer never writes late.txt.
show_timeout: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> {
    measured: run_measured([String]{"sh", "-c", "(sleep 1; echo late > late.txt) & sleep 5"}, MeasureOptions{cwd: None, env: None, stdout_path: "out.txt", stderr_path: "err.txt", timeout_ms: 300}) ?? fail(err)
    time.sleep(1500ms)
    code: if measured.code == .Val(number) -> "{number}" else -> "null"
    print("code {code} signal {measured.signal ?? "null"} killed {measured.killed} late {files.exists("late.txt")}")
}

usage: fn() -[Exec, IO]> Never {
    print(USAGE)
    process.exit(2)
}

run: fn() {
    argv: process.args()
    command: if argv.len() > 0 -> argv[0] else -> ""
    if {
        command == "trace" -> show_trace(argv)
        command == "strict" -> show_strict(argv)
        command == "phases" -> show_phases(argv)
        command == "cpu" -> show_cpu(argv)
        command == "counters" -> show_counters(argv)
        command == "tree" -> show_tree()
        command == "run" -> show_run()
        command == "timeout" -> show_timeout()
        else -> usage()
    }
}
