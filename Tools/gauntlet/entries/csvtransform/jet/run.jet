use core.[data, files]

#Codable
Sale: struct {
    region: String
    #Allow(jet.FloatMoney, "the contract sums binary64 amounts, as main.py does")
    amount: Float
}

#CLI
Args: struct {
    input: String
}

run: fn(args: Args) Err! {
    sales: data.csv<Sale>(files.read(args.input)).filter(fn(sale) { sale.amount > 0.0 })
    groups: sales.group_by(.region)
    regions := groups.keys().to_list()
    regions.sort()
    loop region in regions {
        amounts: groups[region].map(.amount)
        print("{region} n={amounts.len()} sum={amounts.sum():Fixed(2)}")
    }
    print("total n={sales.len()} sum={sales.map(.amount).sum():Fixed(2)}")
}
