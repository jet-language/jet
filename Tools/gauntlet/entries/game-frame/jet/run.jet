use {
    ui: core.ui
    env: core.sys
    files: core.files
}

// A 2D game's frame loop on core.ui's software rasterizer: 1200 frames of a
// 320x200 headless window, each a clear, a scrolling tile map of opaque 15x15
// tiles, 48 translucent 12x12 sprites, a translucent HUD bar and two lines of
// bitmap-font text (one translucent at scale 2). With JET_FRAME_CAPTURE set,
// the final frame is written there as a PAM.
#CLI
Args: struct {}
run: fn(args: Args) {
    frames: 1200
    palette: [ui.Color]{
        ui.color(0, 0, 0, 0),
        ui.color(52, 101, 164, 255),
        ui.color(78, 154, 6, 255),
        ui.color(196, 160, 0, 255),
    }
    sky: ui.color(16, 20, 32, 255)
    bar: ui.color(0, 0, 0, 160)
    white: ui.color(255, 255, 255, 255)
    gold: ui.color(255, 220, 120, 200)
    title: "JET RASTER"
    tiles := 0
    sprites := 0
    glyphs := 0
    // One empty event list per frame; the headless window closes after the last.
    script := [[ui.UIEvent]]{}
    loop _ in 0..<frames -> script.push([ui.UIEvent]{})
    window: ui.headless(width: 320, height: 200, script: script) ?? panic("a 320x200 window")
    loop frame in window.frames() {
        f: frame.index
        if f >= frames -> break
        frame.clear_background(sky)
        scroll: f % 16
        base: f /% 16
        loop ty in 0..<12 {
            loop tx in 0..<21 {
                p: ((tx + base) * 7 + ty * 5) % 4
                if p == 0 -> next
                frame.draw_rectangle(tx * 16 - scroll, ty * 16 + 8, 15, 15, palette[p])
                tiles += 1
            }
        }
        loop i in 0..<48 {
            x: (i * 41 + f * (1 + i % 4)) % 344 - 12
            y: (i * 29 + f * (1 + i % 3)) % 224 - 12
            frame.draw_rectangle(x, y, 12, 12, ui.color((i * 53) % 256, (i * 97) % 256, (i * 31 + f) % 256, 180))
            sprites += 1
        }
        frame.draw_rectangle(0, 0, 320, 12, bar)
        hud: "SCORE {(f * 7) % 100000} FRAME {f}"
        frame.draw_text(hud, 4, 2, 10, white)
        frame.draw_text(title, 196, 176, 20, gold)
        glyphs += hud.len() + title.len()
    }
    capture: env.get("JET_FRAME_CAPTURE") ?? ""
    if capture != "" {
        image: window.load_image_from_screen()
        bytes := "P7\nWIDTH {image.width()}\nHEIGHT {image.height()}\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n".bytes()
        bytes.extend(image.pixels())
        files.write_bytes(capture, bytes) ?? panic("write {capture}: {err}")
    }
    print("frames={frames} tiles={tiles} sprites={sprites} glyphs={glyphs}")
}
