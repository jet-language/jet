use {
    ui: core.ui
    core.color.[Color]
    env: core.sys
    files: core.files
}

// A 2D game's frame loop on core.ui's software rasterizer: 1200 frames of a
// 320x200 headless window, each a clear, a scrolling tile map of opaque 15x15
// tiles, 48 translucent 12x12 sprites, a translucent HUD bar and two lines of
// 5x7 bitmap-font text (one translucent at scale 2), drawn as rectangles as
// the other rails draw them. With JET_FRAME_CAPTURE set, the final frame is
// written there as a PAM.
#CLI
Args: struct {}
run: fn(args: Args) {
    frames: 1200
    palette: [Color]{
        Color{r: 0, g: 0, b: 0, a: 0},
        Color{r: 52, g: 101, b: 164, a: 255},
        Color{r: 78, g: 154, b: 6, a: 255},
        Color{r: 196, g: 160, b: 0, a: 255},
    }
    sky: Color{r: 16, g: 20, b: 32, a: 255}
    bar: Color{r: 0, g: 0, b: 0, a: 160}
    white: Color{r: 255, g: 255, b: 255, a: 255}
    gold: Color{r: 255, g: 220, b: 120, a: 200}
    title: "JET RASTER"
    tiles := 0
    sprites := 0
    glyphs := 0
    // One empty event list per frame; the headless window closes after the last.
    script := [[ui.UIEvent]]{}
    loop _ in 0..<frames -> script.push([ui.UIEvent]{})
    window: ui.headless(width: 320, height: 200, script: script) ?? panic("a 320x200 window")
    loop frame in window.frames() {
        f: frame.index
        if f >= frames -> break
        frame.clear_background(sky)
        scroll: f % 16
        base: f /% 16
        loop ty in 0..<12 {
            loop tx in 0..<21 {
                p: ((tx + base) * 7 + ty * 5) % 4
                if p == 0 -> next
                frame.draw_rectangle(tx * 16 - scroll, ty * 16 + 8, 15, 15, palette[p])
                tiles += 1
            }
        }
        loop i in 0..<48 {
            x: (i * 41 + f * (1 + i % 4)) % 344 - 12
            y: (i * 29 + f * (1 + i % 3)) % 224 - 12
            frame.draw_rectangle(x, y, 12, 12, Color{r: U8{(i * 53) % 256}, g: U8{(i * 97) % 256}, b: U8{(i * 31 + f) % 256}, a: 180})
            sprites += 1
        }
        frame.draw_rectangle(0, 0, 320, 12, bar)
        hud: "SCORE {(f * 7) % 100000} FRAME {f}"
        bitmap_text(frame, hud, 4, 2, 1, white)
        bitmap_text(frame, title, 196, 176, 2, gold)
        glyphs += hud.len() + title.len()
    }
    capture: env.get("JET_FRAME_CAPTURE") ?? ""
    if capture != "" {
        image: window.load_image_from_screen()
        bytes := "P7\nWIDTH {image.width()}\nHEIGHT {image.height()}\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n".bytes()
        bytes.extend(image.pixels())
        files.write_bytes(capture, bytes) ?? panic("write {capture}: {err}")
    }
    print("frames={frames} tiles={tiles} sprites={sprites} glyphs={glyphs}")
}

// The 5x7 font for ASCII 0x20..0x7E: five column bytes per glyph, bit 0
// the top row, a 6-pixel advance at scale 1.
FONT5X7: [Int]{
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5F, 0x00, 0x00, 0x00, 0x07, 0x00, 0x07, 0x00, 0x14, 0x7F, 0x14, 0x7F, 0x14, 0x24, 0x2A, 0x7F, 0x2A, 0x12,
    0x23, 0x13, 0x08, 0x64, 0x62, 0x36, 0x49, 0x55, 0x22, 0x50, 0x00, 0x05, 0x03, 0x00, 0x00, 0x00, 0x1C, 0x22, 0x41, 0x00, 0x00, 0x41, 0x22, 0x1C, 0x00,
    0x08, 0x2A, 0x1C, 0x2A, 0x08, 0x08, 0x08, 0x3E, 0x08, 0x08, 0x00, 0x50, 0x30, 0x00, 0x00, 0x08, 0x08, 0x08, 0x08, 0x08, 0x00, 0x60, 0x60, 0x00, 0x00,
    0x20, 0x10, 0x08, 0x04, 0x02, 0x3E, 0x51, 0x49, 0x45, 0x3E, 0x00, 0x42, 0x7F, 0x40, 0x00, 0x42, 0x61, 0x51, 0x49, 0x46, 0x21, 0x41, 0x45, 0x4B, 0x31,
    0x18, 0x14, 0x12, 0x7F, 0x10, 0x27, 0x45, 0x45, 0x45, 0x39, 0x3C, 0x4A, 0x49, 0x49, 0x30, 0x01, 0x71, 0x09, 0x05, 0x03, 0x36, 0x49, 0x49, 0x49, 0x36,
    0x06, 0x49, 0x49, 0x29, 0x1E, 0x00, 0x36, 0x36, 0x00, 0x00, 0x00, 0x56, 0x36, 0x00, 0x00, 0x08, 0x14, 0x22, 0x41, 0x00, 0x14, 0x14, 0x14, 0x14, 0x14,
    0x00, 0x41, 0x22, 0x14, 0x08, 0x02, 0x01, 0x51, 0x09, 0x06, 0x32, 0x49, 0x79, 0x41, 0x3E, 0x7E, 0x11, 0x11, 0x11, 0x7E, 0x7F, 0x49, 0x49, 0x49, 0x36,
    0x3E, 0x41, 0x41, 0x41, 0x22, 0x7F, 0x41, 0x41, 0x22, 0x1C, 0x7F, 0x49, 0x49, 0x49, 0x41, 0x7F, 0x09, 0x09, 0x09, 0x01, 0x3E, 0x41, 0x49, 0x49, 0x7A,
    0x7F, 0x08, 0x08, 0x08, 0x7F, 0x00, 0x41, 0x7F, 0x41, 0x00, 0x20, 0x40, 0x41, 0x3F, 0x01, 0x7F, 0x08, 0x14, 0x22, 0x41, 0x7F, 0x40, 0x40, 0x40, 0x40,
    0x7F, 0x02, 0x0C, 0x02, 0x7F, 0x7F, 0x04, 0x08, 0x10, 0x7F, 0x3E, 0x41, 0x41, 0x41, 0x3E, 0x7F, 0x09, 0x09, 0x09, 0x06, 0x3E, 0x41, 0x51, 0x21, 0x5E,
    0x7F, 0x09, 0x19, 0x29, 0x46, 0x46, 0x49, 0x49, 0x49, 0x31, 0x01, 0x01, 0x7F, 0x01, 0x01, 0x3F, 0x40, 0x40, 0x40, 0x3F, 0x1F, 0x20, 0x40, 0x20, 0x1F,
    0x3F, 0x40, 0x38, 0x40, 0x3F, 0x63, 0x14, 0x08, 0x14, 0x63, 0x07, 0x08, 0x70, 0x08, 0x07, 0x61, 0x51, 0x49, 0x45, 0x43, 0x00, 0x7F, 0x41, 0x41, 0x00,
    0x02, 0x04, 0x08, 0x10, 0x20, 0x00, 0x41, 0x41, 0x7F, 0x00, 0x04, 0x02, 0x01, 0x02, 0x04, 0x40, 0x40, 0x40, 0x40, 0x40, 0x00, 0x01, 0x02, 0x04, 0x00,
    0x20, 0x54, 0x54, 0x54, 0x78, 0x7F, 0x48, 0x44, 0x44, 0x38, 0x38, 0x44, 0x44, 0x44, 0x20, 0x38, 0x44, 0x44, 0x48, 0x7F, 0x38, 0x54, 0x54, 0x54, 0x18,
    0x08, 0x7E, 0x09, 0x01, 0x02, 0x0C, 0x52, 0x52, 0x52, 0x3E, 0x7F, 0x08, 0x04, 0x04, 0x78, 0x00, 0x44, 0x7D, 0x40, 0x00, 0x20, 0x40, 0x44, 0x3D, 0x00,
    0x7F, 0x10, 0x28, 0x44, 0x00, 0x00, 0x41, 0x7F, 0x40, 0x00, 0x7C, 0x04, 0x18, 0x04, 0x78, 0x7C, 0x08, 0x04, 0x04, 0x78, 0x38, 0x44, 0x44, 0x44, 0x38,
    0x7C, 0x14, 0x14, 0x14, 0x08, 0x08, 0x14, 0x14, 0x18, 0x7C, 0x7C, 0x08, 0x04, 0x04, 0x08, 0x48, 0x54, 0x54, 0x54, 0x20, 0x04, 0x3F, 0x44, 0x40, 0x20,
    0x3C, 0x40, 0x40, 0x20, 0x7C, 0x1C, 0x20, 0x40, 0x20, 0x1C, 0x3C, 0x40, 0x30, 0x40, 0x3C, 0x44, 0x28, 0x10, 0x28, 0x44, 0x0C, 0x50, 0x50, 0x50, 0x3C,
    0x44, 0x64, 0x54, 0x4C, 0x44, 0x00, 0x08, 0x36, 0x41, 0x00, 0x00, 0x00, 0x7F, 0x00, 0x00, 0x00, 0x41, 0x36, 0x08, 0x00, 0x08, 0x04, 0x08, 0x10, 0x08,
}

// ASCII text in the 5x7 font at a whole-pixel scale, one rectangle per
// vertical run of a glyph column; a byte outside the font draws as "?".
bitmap_text: fn(frame: ui.Frame, text: String, x: Int, y: Int, scale: Int, color: Color) {
    pen := x
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        glyph: if code >= 32 && code <= 126 -> code - 32 else -> 31
        loop column in 0..<5 {
            bits: FONT5X7[glyph * 5 + column]
            row := 0
            loop row < 7 {
                if (bits >> row).bit_and(1) == 0 {
                    row += 1
                    next
                }
                start: row
                loop row < 7 && (bits >> row).bit_and(1) != 0 -> row += 1
                frame.draw_rectangle(pen + column * scale, y + start * scale, scale, (row - start) * scale, color)
            }
        }
        pen += 6 * scale
    }
}
