use core.http.client as http_client

struct Item {
    id: Int
    name: String
    qty: Int
}

struct Listing {
    items: [Item]
}

#CLI
struct Args {
    base: String
}

fn run(args: Args) !HTTPError {
    endpoint :: args.base
    listing_response :: http_client.get("{endpoint}/items") ?? panic("GET failed")
    listing :: listing_response.json<Listing>() ?? panic("decode failed")
    print("items {listing.items.len()}")

    loop id in [2, 5, 99] {
        response :: http_client.get("{endpoint}/items/{id}") ?? panic("GET failed")
        if {
            response.status() == 404 -> print("item {id} missing")
            else -> {
                item :: response.json<Item>() ?? panic("decode failed")
                print("item {item.id} {item.name} qty={item.qty}")
            }
        }
    }
    print("total-qty {listing.items.map(item -> item.qty).sum()}")
}
