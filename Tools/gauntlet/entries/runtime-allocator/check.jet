// What a runtime-allocator case produced (PortBars.jet runs this in the case
// directory with the file holding the program's output), with the case
// directory written as `<case>`: the printed text, then for each of out/ and
// done/ that exists its entries in name order and its build.json. The source
// hashes of allocator.c and allocator.rs print as `<sha256>` when they are 64
// hex digits, so the expected output does not pin those sources.
use {
    files: core.files
    process: core.process
    regex: core.regex
}

#CLI
Check: struct {
    #Doc("The file holding the program's output") stdout: String
}

run: fn(check: Check) {
    here: files.collapse(files.absolute(".") ?? process.fail(1, "{err}"))
    printed: files.read(check.stdout) ?? process.fail(1, "{err}")
    if printed != "" -> print(printed.replace(here, "<case>").remove_suffix("\n"))
    loop dir in ["out", "done"] {
        if !files.is_dir(dir) -> next
        names := (files.list_dir(dir) ?? process.fail(1, "{err}")).map(entry -> entry.name.copy())  // copy: the list outlives the entries
        names.sort()
        print(if names.len() == 0 -> "{dir}/:" else -> "{dir}/: {names.join(" ")}")
        build: files.join(dir, "build.json")
        if !files.exists(build) -> next
        text: files.read(build) ?? process.fail(1, "{err}")
        loop line in text.replace(here, "<case>").remove_suffix("\n").lines() {
            if regex.full_match(Regex{" *\"(driver|rust)\": \"[0-9a-f]{{64}}\",?"}, line) {
                print(regex.replace(Regex{"[0-9a-f]{{64}}"}, line, "<sha256>"))
                next
            }
            print(line)
        }
    }
}
