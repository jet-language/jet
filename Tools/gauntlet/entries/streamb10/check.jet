// The job of a streamb10 case, as facts (PortBars.jet runs it in the case
// directory with the file holding the program's output): what integrate10.sh
// was given and found in the seed, the seeds made, and which batch and
// unstaged SUB the report names.
use {
    files: core.files
    process: core.process
}

run: fn() {
    printed: files.read(process.args()[0])
    print((files.read("integrate10.facts") ?? "integrate10 did not run").trim())
    seeds := (loop entry in files.list_dir("lanes/Main/integ") -> entry.name).filter(fn(name) { name.starts_with("seed-") })
    seeds.sort()
    print("seeds: {seeds.join(" ")}".trim_end())
    print("names subs/Lane-9: {printed.contains("subs/Lane-9")}")
    print("names b2: {printed.contains("b2")}")
}
