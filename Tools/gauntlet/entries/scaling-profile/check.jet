// The scaling-profile `real` case: every row resolved to a `Compiler/<file>:<line>`
// must point at that function's declaration; prints each resolved name.
use {
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
}

ENTRY: "/Tools/gauntlet/entries/scaling-profile/check.jet"

run: fn() {
    repo: sys.executable().removesuffix(ENTRY)
    printed: files.read(process.args()[0]) ?? stop("{err}")
    loop line in printed.lines() {
        if !line.contains("%  ") -> next
        parts: line.split("  ").to_list()
        source: parts[parts.len() - 1]
        if !source.starts_with("Compiler/") -> next
        place: source.partition(" ")
        at: place.head.split(":").to_list()
        number: Int.parse(at[1]) ?? stop("not a line number: {source}")
        lines: (files.read("{repo}/{at[0]}") ?? stop("{err}")).split("\n").to_list()
        if number < 1 || number > lines.len() || !lines[number - 1].contains("{place.tail}: fn") -> stop("{source} does not declare {place.tail}")
        print("resolved {place.tail}")
    }
}

stop: fn(message: String) -> Never {
    term.eprint(message)
    process.exit(1)
}
