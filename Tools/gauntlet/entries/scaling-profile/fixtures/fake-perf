#!/bin/sh
# perf for the scaling-profile cases: `perf script -i DIR/perf.data -F time,ip,sym --ns`
# prints DIR/perf-script.txt, the samples as perf script writes them.
if [ "$1" != script ] || [ "$2" != -i ]; then
    echo "fake-perf: unexpected arguments: $*" >&2
    exit 3
fi
exec cat "${3%perf.data}perf-script.txt"
