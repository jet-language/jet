use files: core.files

#CLI
Args: struct {
    path: String
}

run: fn(args: Args) Err! {
    r: Reader.over(files.read_bytes(args.path) ?? return)
    r.take_pattern([U8]{"JGB1"}) ?? return
    n: Int{r.read_u32_le() ?? return}
    sum7 := Float{0.0}
    hash := U64{14695981039346656037}
    loop _ in 0..<n {
        i: r.read_u32_le() ?? return
        v: r.read_f64_le() ?? return
        l: r.read_u16_le() ?? return
        if i % 7 == 0 -> sum7 += v
        name: r.take(l) ?? return
        loop b in name {
            hash = wrapping(((hash).bit_xor(U64{b})) * U64{1099511628211})
        }
    }
    print("records {n}\nsum7 {sum7:Fixed(6)}\nfnv {Int{hash}:Hex(16)}")
}
