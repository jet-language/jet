{
  "name": "scaling-corpora",
  "mode": "tool",
  "description": "The scaling gate's corpus libraries Tools/perf/scaling/corpora.mjs, domains.mjs, mixed.mjs and package.mjs and their Jet twin, the jet_scaling_corpora package (Tools/perf/scaling/corpora: Corpora.jet, Domains.jet, Mixed.jet and Packages.jet), #5072 c7, each run by a driver that prints one export's result: SHAPES (name, kind, unit, base and dimension, stress shapes then domains), LAYOUTS and DOMAINS; both MODULUS values; corpus of stress and domain shapes in the files and single layouts (kind, expected diagnostics, code lines, digest and file names) and its refusals (an unknown shape, a zero size, an unknown layout); mixedSources (digest, expected stdout, line, byte and item counts) and its refusals (zero code lines, a seed past 32 bits); countLines and both isCodeLine exports over blank, comment, indented and unterminated lines; both sourceDigest exports and codeLines (package.jet excluded); manifest's name sanitizing; the mulberry32 stream of random (its raw words, int and pick, for seeds that wrap to 32 bits); consumerTree below, at and past one and two group levels; finish with and without an existing main.jet; and pack with a given and the default file size, an empty item included. generate.mjs's entry (scaling-generate) writes every shape; this one runs each export the libraries have, so the census counts the four libraries as covered.",
  "tool": {
    "original": "Tools/gauntlet/harness/drivers/scaling-corpora.mjs",
    "jet": "Tools/gauntlet/entries/scaling-corpora/driver/run.jet",
    "cases": [
      {
        "args": [
          "shapes"
        ],
        "expected": "expected/shapes.out"
      },
      {
        "args": [
          "layouts"
        ],
        "expected": "expected/layouts.out"
      },
      {
        "args": [
          "domains"
        ],
        "expected": "expected/domains.out"
      },
      {
        "args": [
          "modulus"
        ],
        "expected": "expected/modulus.out"
      },
      {
        "args": [
          "corpus",
          "modules",
          "4",
          "1",
          "files"
        ],
        "expected": "expected/corpus-modules.out"
      },
      {
        "args": [
          "corpus",
          "modules",
          "4",
          "1",
          "single"
        ],
        "expected": "expected/corpus-modules-single.out"
      },
      {
        "args": [
          "corpus",
          "diagnostics",
          "3",
          "7",
          "single"
        ],
        "expected": "expected/corpus-diagnostics-single.out"
      },
      {
        "args": [
          "corpus",
          "impls-traits",
          "40",
          "2",
          "files"
        ],
        "expected": "expected/corpus-impls-traits.out"
      },
      {
        "args": [
          "corpus",
          "web",
          "700",
          "2",
          "files"
        ],
        "expected": "expected/corpus-web.out"
      },
      {
        "args": [
          "corpus",
          "generic-lib",
          "400",
          "3",
          "single"
        ],
        "expected": "expected/corpus-generic-lib-single.out"
      },
      {
        "args": [
          "corpus",
          "nope",
          "4",
          "1",
          "files"
        ],
        "exit": 1,
        "expected": "expected/corpus-unknown.out"
      },
      {
        "args": [
          "corpus",
          "modules",
          "0",
          "1",
          "files"
        ],
        "exit": 1,
        "expected": "expected/corpus-zero.out"
      },
      {
        "args": [
          "corpus",
          "modules",
          "4",
          "1",
          "tiled"
        ],
        "exit": 1,
        "expected": "expected/corpus-layout.out"
      },
      {
        "args": [
          "mixed",
          "120",
          "5"
        ],
        "expected": "expected/mixed.out"
      },
      {
        "args": [
          "mixed",
          "0",
          "5"
        ],
        "exit": 1,
        "expected": "expected/mixed-zero.out"
      },
      {
        "args": [
          "mixed",
          "120",
          "4294967296"
        ],
        "exit": 1,
        "expected": "expected/mixed-seed.out"
      },
      {
        "args": [
          "mixed",
          "120",
          "x"
        ],
        "exit": 1,
        "expected": "expected/mixed-nan-seed.out"
      },
      {
        "args": [
          "corpus",
          "modules",
          "x",
          "x",
          "files"
        ],
        "exit": 1,
        "expected": "expected/corpus-nan.out"
      },
      {
        "args": [
          "lines",
          "a\n  // c\n\t\n  x  \n//\n"
        ],
        "expected": "expected/lines.out"
      },
      {
        "args": [
          "lines",
          "one"
        ],
        "expected": "expected/lines-unterminated.out"
      },
      {
        "args": [
          "lines",
          ""
        ],
        "expected": "expected/lines-empty.out"
      },
      {
        "args": [
          "lines",
          "\ufeff// c\nx"
        ],
        "expected": "expected/lines-bom.out"
      },
      {
        "args": [
          "digest",
          "main.jet",
          "run: fn() {}\n",
          "package.jet",
          "name: \"x\"\n",
          "b.jet",
          "// c\nx\n"
        ],
        "expected": "expected/digest.out"
      },
      {
        "args": [
          "digest"
        ],
        "expected": "expected/digest-empty.out"
      },
      {
        "args": [
          "digest",
          "a.jet",
          "\ufeff// c\nx\n"
        ],
        "expected": "expected/digest-bom.out"
      },
      {
        "args": [
          "manifest",
          "my-bench.v2"
        ],
        "expected": "expected/manifest.out"
      },
      {
        "args": [
          "manifest",
          "café au lait"
        ],
        "expected": "expected/manifest-accent.out"
      },
      {
        "args": [
          "random",
          "1",
          "6"
        ],
        "expected": "expected/random.out"
      },
      {
        "args": [
          "random",
          "0",
          "4"
        ],
        "expected": "expected/random-zero.out"
      },
      {
        "args": [
          "random",
          "-1",
          "4"
        ],
        "expected": "expected/random-negative.out"
      },
      {
        "args": [
          "random",
          "4294967297",
          "3"
        ],
        "expected": "expected/random-wide.out"
      },
      {
        "args": [
          "tree",
          "5",
          "small"
        ],
        "expected": "expected/tree-small.out"
      },
      {
        "args": [
          "tree",
          "32",
          "edge"
        ],
        "expected": "expected/tree-edge.out"
      },
      {
        "args": [
          "tree",
          "40",
          "mid"
        ],
        "expected": "expected/tree-mid.out"
      },
      {
        "args": [
          "tree",
          "1100",
          "big"
        ],
        "expected": "expected/tree-big.out"
      },
      {
        "args": [
          "finish",
          "demo",
          "a,b"
        ],
        "expected": "expected/finish.out"
      },
      {
        "args": [
          "finish",
          "demo",
          "a",
          "x: 1"
        ],
        "expected": "expected/finish-main.out"
      },
      {
        "args": [
          "pack",
          "p",
          "3,2,5",
          "4"
        ],
        "expected": "expected/pack.out"
      },
      {
        "args": [
          "pack",
          "p",
          "2,0"
        ],
        "expected": "expected/pack-empty-item.out"
      },
      {
        "args": [
          "pack",
          "p",
          "599,1,3"
        ],
        "expected": "expected/pack-default.out"
      },
      {
        "args": [
          "pack",
          "p",
          "3,2,x",
          "two"
        ],
        "expected": "expected/pack-nan.out"
      }
    ]
  }
}
