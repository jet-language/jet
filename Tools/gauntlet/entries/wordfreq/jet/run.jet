use files: core.files

// Word counts over whitespace-separated words. top_n ranks by count
// (descending) and word, the order the contract asks for.
#CLI
Args: struct {
    path: String
}

run: fn(args: Args) IOError! {
    counts: files.read(args.path).words().counts()
    loop item in counts.top_n(20) -> print("{item.value} {item.key}")
    print("distinct {counts.len()} total {counts.values().sum()}")
}
