// The roots a roots-sh or roots-mjs case printed (PortBars.jet and the
// gauntlet harness run this in the case directory with the file holding the
// program's output), with the machine's cache directory written as
// `$XDG_CACHE_HOME`. The cases leave XDG_CACHE_HOME as the machine sets it:
// the harness starts both programs through Tools/agent/JetEnv.jet, which
// keeps its dev shells there.
use {
    files: core.files
    process: core.process
}

run: fn() {
    set: process.env_get("XDG_CACHE_HOME") ?? ""
    cache: if set != "" -> set else -> "{process.env_get("HOME") ?? ""}/.cache"
    loop line in files.read(process.args()[0]).lines() -> print(line.replace("={cache}/", "=$XDG_CACHE_HOME/"))
}
