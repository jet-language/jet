JET_SCRATCH_ROOT=~/scratch:~/second
JET_RUN_ROOT=/run; JET_RUN_ROOT+=/more # appended
readonly R_IN_FIXTURE=/r
export JET_BASE_ROOT=$R_IN_FIXTURE${UNSET_IN_FIXTURE:=/assigned}$UNSET_IN_FIXTURE
EMPTY_IN_FIXTURE=
JET_TARGET_ROOT=/t${A_IN_FIXTURE:+/set}${EMPTY_IN_FIXTURE:+/empty}${EMPTY_IN_FIXTURE+/defined}${NONE_IN_FIXTURE+/none}
export A_IN_FIXTURE=/later JET_SEEDS=$A_IN_FIXTURE/seeds JET_SEED
export JET_DEV_WORKTREE=/srv/forms
