# Quoting, references and expansions in the env file format roots.sh
# documents, as a sourcing bash and Roots.jet read them alike.
JET_STATE_ROOT="$HOME/expanded"
  JET_SCRATCH_ROOT="$JET_STATE_ROOT/sub"   # a comment after a value
JET_RUN_ROOT='$HOME/literal'
JET_BASE_ROOT="${HOME}/base"'/$single'\$escaped"\"q\\\x"
EMPTY_IN_FIXTURE=
export JET_TARGET_ROOT=${UNSET_IN_FIXTURE:-"$HOME/targets"}:${EMPTY_IN_FIXTURE:-empty}:${EMPTY_IN_FIXTURE-unset}x
export JET_SEEDS=/${UNSET_IN_FIXTURE-dash}/${JET_SCRATCH_ROOT:?is set}/a#b
export JET_SEED=${JET_SEED:-${UNSET_IN_FIXTURE:-/nested/${EMPTY_IN_FIXTURE:-deep}}}
JET_DEV_WORKTREE=/srv/tree\ with' spaces'
NOT_A_ROOT=1
