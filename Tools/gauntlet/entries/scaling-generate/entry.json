          "10",
          "--seed",
          "8",
          "out"
        ],
        "check": "check.jet",
        "expected": "expected/generics.out"
      },
      {
        "args": [
          "comptime",
          "11",
          "--seed",
          "9",
          "out"
        ],
        "check": "check.jet",
        "expected": "expected/comptime.out"
      },
      {
        "args": [
          "data-tables",
