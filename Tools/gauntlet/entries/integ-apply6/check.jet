// The job of an integ-apply6 case, as facts (PortBars.jet runs it in the case
// directory, which is also the integ directory, with the file holding the
// program's output): each line it printed, by its words; every integ file it
// left, the diffs by a hash of their bytes and the rest whole; and every file
// of the composed tree by a hash of its bytes.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
}

// The integ files a run leaves, by suffix or name.
INTEG_SUFFIXES: [".files", ".apply", ".status", ".dropped", ".rebased", ".out"]
INTEG_NAMES: ["failed", "order", "generators", "regen.patch", "linemerge.tmp"]

// Whether `name` is an integ file.
integ_file: fn(name: String) -> Bool {
    loop suffix in INTEG_SUFFIXES {
        if name.ends_with(suffix) -> return true
    }
    INTEG_NAMES.contains(name)
}

// The first 12 hex digits of the SHA-256 of the file at `path`.
digest: fn(path: String) -> String { crypto.sha256(files.read_bytes(path) ?? [U8]{}).hex().slice(0, 12) }

// The sorted names in `dir`.
names_in: fn(dir: String) -> [String] {
    names := loop entry in (files.list_dir(dir) ?? []) -> entry.name
    names.sort()
    names
}

// Prints each file under `dir` with its digest, symbolic links as links.
walk: fn(dir: String) {
    loop name in names_in(dir) {
        path: "{dir}/{name}"
        if {
            files.is_symlink(path) -> print("{path} (link)")
            files.is_dir(path) -> walk(path)
            else -> print("{path} {digest(path)}")
        }
    }
}

run: fn() {
    loop line in files.read(process.args()[0]).lines().filter(fn(line) { line.trim() != "" }) -> print(line.words().join(" "))
    loop name in names_in(".") {
        if !files.is_file(name) || !integ_file(name) -> next
        if {
            name.ends_with(".rebased") || name == "regen.patch" -> print("{name} {digest(name)}")
            else -> {
                print("{name}:")
                loop line in (files.read(name) ?? "").lines() -> print("  {line}")
            }
        }
    }
    walk("tree")
}
