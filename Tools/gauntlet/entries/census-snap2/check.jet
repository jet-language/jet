// The job of a census-snap2 case, as facts (PortBars.jet runs it in the case
// directory with the file holding the program's output): each line it
// printed by its first three words (a pass and its rc and rows, a row by
// place, kind and code), then every report and snapshot file it left, with
// its line count.
use {
    files: core.files
    process: core.process
}

// Prints each file under `dir`, symbolic links as links.
walk: fn(dir: String) {
    names := loop entry in (files.list_dir(dir) ?? []) -> entry.name
    names.sort()
    loop name in names {
        path: "{dir}/{name}"
        if {
            files.is_symlink(path) -> print("{path} (link)")
            files.is_dir(path) -> walk(path)
            else -> print("{path}: {(files.read(path) ?? "").lines().len()} lines")
        }
    }
}

run: fn() {
    loop line in files.read(process.args()[0]).lines() -> print(line.words().slice(0, 3).join(" "))
    walk("census")
    walk("discovery")
}
