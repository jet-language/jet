// The job of a lane-commit case, as facts (PortBars.jet runs it in the case
// directory with the file holding the program's output): the lines it
// printed; the worktree's commits (sha, author, subject, changed paths) and
// status; and every job left in the case's queue with its files and, for a
// finished one, its exit status and output.
use {
    files: core.files
    process: core.process
}

// The sorted names in `dir`.
names_in: fn(dir: String) -> [String] {
    names := loop entry in (files.list_dir(dir) ?? []) -> entry.name
    names.sort()
    names
}

run: fn() {
    print(files.read(process.args()[0]).trim_end())
    print(Sh{"git -C repo/work log {"--format=%h %an %s"} --name-status"}.text().trim_end())
    print("status:")
    print(Sh{"git -C repo/work status --porcelain"}.text().trim_end())
    queue: "{process.env_get("JET_RUN_ROOT") ?? "run"}/commit-queue"
    // An interrupted original leaves its precommit log, a dot file, in the queue.
    loop job in names_in(queue).filter(fn(name) { !name.starts_with(".") }) {
        path: "{queue}/{job}"
        // This call's own job is named by the time and the caller's pid.
        print("job {if job.starts_with("0") -> job else -> "(this call's)"}: {names_in(path).join(" ")}".trim_end())
        loop name in ["lane", "rc", "out"] {
            text: files.read("{path}/{name}") ?? next
            print("  {name}: {text.trim_end().lines().join(" / ")}")
        }
    }
}
