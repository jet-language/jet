use core.files

#CLI
Args: struct {
    path: Path
}

run: fn(args: Args) {
    entries: files.list_dir(args.path).filter(entry -> !entry.is_dir)
    pattern: Regex{"IMG_(\d+)\.jpeg"}
    photos := entries.filter_map(entry -> pattern.match_full(entry.name)).to_list()
    photos.sort_by(photo -> photo.group_int(1) ?? 0)
    loop (index, photo) in photos {
        target: "photo-{index + 1:PadLeft(4, "0")}.jpg"
        files.rename(args.path.join(photo.text), args.path.join(target))
        print("renamed {photo.text} -> {target}")
    }
    print("renamed {photos.len()} skipped {entries.len() - photos.len()}")
}
