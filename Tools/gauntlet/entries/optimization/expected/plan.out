    {
      "id": "conditional-parallel-scheduling",
      "title": "Conditional parallel scheduling",
      "owner_card": "#2922",
      "production_owner": "crates/jet-foundation/src/Acceleration.rs and parallel crossover owner",
      "required_peers": [
        "rust",
        "python",
        "c",
        "zig",
        "node"
      ],
      "machine_domain": {
        "kernel": "Finite independent Int iterations with no shared mutation, IO, callbacks, or early exit; each result is deterministic.",
        "schedule": "para_map preserves source order and uses a bounded worker limit; cancellation and lowest failing index are part of the contract.",
        "gate": "Automatic acceleration is eligible only above the 1024-item floor when projected gain is at least 2x spawn cost plus the bandwidth floor; first chunk timing is retained.",
        "resources": "Parallelism uses the existing pool and bounded per-cache-block memory; no new threads are created by the experiment."
      },
      "premises": [
        "Every iteration is independent and has the same typed result and failure behavior.",
        "The pool limit, chunk partition, and cancellation policy are recorded.",
        "The candidate and control consume the same 1024-item input and output all required observations.",
        "A cost win is reported per mode/tier and is not inferred from sampled or historical probes."
      ],
      "falsifier": "Use a callback with shared mutation or an injected failure at the lowest index. Any duplicate/missing result, changed failure index, cleanup leak, or speed claim below the gate rejects automatic parallel scheduling.",
      "observations": {
        "result": "Byte-exact ordered output and complete result count.",
        "typed_failure": "Same lowest failing index, failure type, and sibling cancellation behavior.",
        "mutation": "No shared mutable cell is written by independent iterations; output slots are disjoint.",
        "input_consumption": "Each input is consumed exactly once and no work past cancellation is reported as completed.",
        "ordered_effects": "Effectful callbacks are excluded unless their order is explicitly preserved.",
        "cleanup": "Every worker, chunk, and resource is joined/released on success and failure.",
        "resource_premises": "Pool size, spawn cost, cache-block bytes, bandwidth floor, and peak memory are recorded.",
        "schedule": "Control is sequential; candidate records chunks, worker limit, first chunk timing, and completion order.",
        "allowed_schedules": "Only bounded schedules proved independent and order-equivalent are eligible; a sampled crossover is not proof.",
        "identity": "Schedule, input, target, compiler, and harness identities are joined for each raw row."
      },
      "rule_record": {
        "candidate_rule": "select bounded parallel scheduling only after legality and D-ACCEL1 cost gate",
        "selected_rule": null,
        "rejected_rule": null,
        "decision": "awaiting same-job cost and owner choice",
        "owner_card": "#2922"
      },
