    {
      "id": "range-alias-fusion-vectorization",
      "title": "Range and alias facts for fusion/vectorization",
      "owner_card": "#2895",
      "production_owner": "crates/jet-foundation/src/MIROptimization.rs and Acceleration.rs",
      "required_peers": [
        "rust",
        "python",
        "c",
        "zig",
        "node"
      ],
      "machine_domain": {
        "index": "Finite half-open integer ranges with checked bounds; the exact input length is part of identity.",
        "storage": "Mutable contiguous list storage with explicit alias relation; a write window cannot overlap a read window unless the contract proves the overlap-safe order.",
        "lanes": "Integer lanes preserve element order and exact integer results; no masked lane may consume an element twice or hide a failure.",
        "target": "The report records vector width, alignment, bounds-check policy, and target representation before comparing cost."
      },
      "premises": [
        "The range endpoints and stride are unchanged.",
        "Read/write windows are disjoint or the transformation proves an overlap-safe direction.",
        "The body has no observable effect or early failure that lane reordering would change.",
        "Every bounds and alias fact is attached to the source identity."
      ],
      "falsifier": "Run the negative control with overlapping read/write windows and an effectful body. A changed element, duplicate read, changed lowest failure, or reordered print rejects fusion/vectorization.",
      "observations": {
        "result": "Byte-exact output list and reduction value for every element.",
        "typed_failure": "Same bounds, alias, and body failure class at the same lowest index.",
        "mutation": "Same cells are written once, in the same visible final state; no hidden temporary replaces an observed alias.",
        "input_consumption": "Same range cardinality and read count; no speculative extra read beyond the source window.",
        "ordered_effects": "Effects in the loop body retain source order; effectful bodies are not widened.",
        "cleanup": "Temporary vector buffers and borrowed views release in the same order on success and failure.",
        "resource_premises": "Alignment, lane width, allocation, and alias proofs are present and target-bound.",
        "schedule": "Sequential index order is the control; candidate lane order is explicit.",
        "allowed_schedules": "Only non-overlapping, order-equivalent lanes may be fused or vectorized.",
        "identity": "Range, storage, and alias facts carry the source and input digests into the inspect record."
      },
      "rule_record": {
        "candidate_rule": "fuse or widen only from explicit range and non-overlap facts",
        "selected_rule": null,
        "rejected_rule": null,
        "decision": "awaiting same-job cost and owner choice",
        "owner_card": "#2895"
      },
