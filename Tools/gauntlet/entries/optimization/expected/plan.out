    {
      "id": "checked-arithmetic-float",
      "title": "Checked arithmetic and Float rewrites",
      "owner_card": "#2895",
      "production_owner": "crates/jet-foundation/src/MIROptimization.rs and Acceleration.rs",
      "required_peers": [
        "rust",
        "python",
        "c",
        "zig",
        "node"
      ],
      "machine_domain": {
        "integer": "Jet Int is a target-described signed fixed-width two's-complement value; checked add traps before an unrepresentable result. The target width must be recorded before a result is usable.",
        "float": "IEEE-754 binary64, round-to-nearest-ties-to-even, with signed zero, NaN, infinity, and evaluation order observable; reassociation and fast-math are forbidden unless separately stated.",
        "target": "The report must bind the exact compiler target triple and floating-point lowering configuration; host defaults are not a proof."
      },
      "premises": [
        "Every integer operation has a checked representability premise for the declared target width.",
        "Float operands are finite only when the source record says so; no real-number associativity premise is inferred.",
        "The source preserves operand evaluation order and typed failure order.",
        "The candidate and control consume byte-identical input and emit the same target representation."
      ],
      "falsifier": "Use the authored Float counterexample (1e16 + -1e16) + 1 versus 1e16 + (-1e16 + 1), and a target-width checked overflow boundary. Any changed bit, failure class, or effect order rejects the rewrite.",
      "observations": {
        "result": "Byte-exact numeric output, including signed-zero and NaN spelling where the runtime exposes it.",
        "typed_failure": "Overflow and invalid-operation class, source identity, and lowest failing operation/index.",
        "mutation": "No mutation may be introduced or removed around the arithmetic expression.",
        "input_consumption": "Same operands, count, and consumption order; no skipped value after a checked failure.",
        "ordered_effects": "Print/callback effects occur in source order and are not duplicated by speculative evaluation.",
        "cleanup": "Any failure unwinds the same owned temporaries in the same order.",
        "resource_premises": "Target width, floating-point mode, and checked-operation availability are recorded facts.",
        "schedule": "Single-threaded expression order is unchanged.",
        "allowed_schedules": "Only schedules proved equivalent under the numeric contract are admitted; unrestricted reassociation is not admitted.",
        "identity": "The inspected operation points to the same source span and compiler candidate identity as the raw record."
      },
      "rule_record": {
        "candidate_rule": "reassociate only under a checked machine-number contract",
        "selected_rule": null,
        "rejected_rule": null,
        "decision": "awaiting same-job cost and owner choice",
        "owner_card": "#2895"
      },
