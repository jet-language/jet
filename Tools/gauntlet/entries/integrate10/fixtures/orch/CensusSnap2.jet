// A stand-in for CensusSnap2.jet in the integrate10 fixture: the one stand-in
// body is census-snap2.sh beside it.
use {
    files: core.files
    process: core.process
    sys: core.sys
}

run: fn() -> Never { process.exec(["bash", "{files.dirname(sys.executable())}/census-snap2.sh"].concat(process.args())) }
