// A stand-in for IntegApply6.jet in the integrate10 fixture: the one stand-in
// body is integ-apply6.sh beside it.
use {
    files: core.files
    process: core.process
    sys: core.sys
}

run: fn() -> Never { process.exec(["bash", "{files.dirname(sys.executable())}/integ-apply6.sh"].concat(process.args())) }
