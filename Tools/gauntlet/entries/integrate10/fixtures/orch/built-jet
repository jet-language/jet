#!/usr/bin/env bash
# A stand-in for the compiler the integrate10 fixture's census builds: test lines and goldens run it as $JET.
case "$1" in
  passes) echo "ok ($JET_COMPILER_IDENTITY)"; exit 0 ;;
  fails) shift; for row in "$@"; do echo "FAIL $row (12ms)"; done; echo "error: $# failed"; exit 1 ;;
  regresses) shift; for row in "$@"; do echo "FAIL $row (40µs)"; done; echo "FAIL extra-$1 (1.5s)"; echo "error: éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"; exit 1 ;;
  newfail) echo "FAIL sema (7ms)"; echo "an Error line"; for n in $(seq 1 7); do echo "tail $n"; done; exit 1 ;;
  broken) echo "panic: the batch compiler crashed"; for n in $(seq 1 7); do echo "trace $n"; done; exit 101 ;;
  test)
    [ "$2 $3 $4" = "Compiler --profile golden" ] || exit 9
    echo "golden $5 ran in $JET_TOOLCHAIN_ROOT"
    case "$5" in *Prelude*) exit 1 ;; esac ;;
  *) exit 9 ;;
esac
