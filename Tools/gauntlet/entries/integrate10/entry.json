{
  "name": "integrate10",
  "mode": "tool",
  "description": "Main's integration pass integrate10.sh and its Jet twin Integrate10.jet (#5072 c15): export origin/dev from the dev worktree's repository, apply INTEG_PRE's stacked patches and then every SUB through integ-apply6.sh, stop on a failed regeneration, run the census (census-snap2.sh under capped.sh) with the files the applied SUBs touch, then every ratchet check with the seed at once, link the batch compiler and jetpacks, run each SUB's test lines four SUBs at a time with runsub6.sh, rerun the failing ones on a clean dev export with the seed, run the goldens that cite a touched Core or Prelude file, and write the report; it prints the applied SUBs' lines, the census and ratchet results, the jetpack choice and the report's path. The fixtures hold the dev repository (dev.git, whose export links back to the fixture's lanes and subs), the worktree's repository that fetches it (work.git), the SUBs (subs), the census rows (rows), a stand-in seed (seed), stand-ins for integ-apply6.sh, census-snap2.sh and the compiler the census builds (orch), and stand-ins for Main's capped.sh and runsub6.sh (lanes/scratch/Main). The cases run under LC_ALL=C, so the original's sorts keep the byte order the twin's do.",
  "tool": {
    "original": "Tools/agent/orchestrator/integrate10.sh",
    "jet": "Tools/agent/orchestrator/Integrate10.jet",
    "fixtures": "fixtures",
    "cases": [
      {
        "args": [
          "b1",
          "subs/A-1/",
          "subs/B-1",
          "subs/C-1",
          "subs/D-1",
          "subs/E-1",
          "subs/F-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "INTEG_PRE": "pre1:subs/P-1 subs/P-2"
        },
        "expected": "expected/batch.out"
      },
      {
        "args": [
          "b2",
          "subs/A-1",
          "subs/C-1",
          "subs/E-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "STANDIN_CENSUS": "sum",
          "STANDIN_RATCHET_FAIL": "1"
        },
        "expected": "expected/census-failed.out"
      },
      {
        "args": [
          "b3",
          "subs/A-1",
          "subs/D-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "STANDIN_UNBUILT": "1",
          "STANDIN_NO_RATCHETS": "1"
        },
        "expected": "expected/unbuilt.out"
      },
      {
        "args": [
          "b4"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C"
        },
        "expected": "expected/no-subs.out"
      },
      {
        "args": [
          "b5",
          "subs/A-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "STANDIN_REGEN_RC": "1"
        },
        "exit": 3,
        "expected": "expected/regen-failed.out"
      },
      {
        "args": [
          "b6",
          "subs/A-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "STANDIN_APPLY_FAIL": "1"
        },
        "exit": 2,
        "expected": "expected/apply-failed.out"
      },
      {
        "args": [
          "b7",
          "subs/A-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "INTEG_PRE": "pre1:subs/P-1 pre1:subs/P-bad"
        },
        "exit": 2,
        "expected": "expected/pre-failed.out"
      },
      {
        "args": [
          "b8",
          "subs/A-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "missing.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C"
        },
        "exit": 2,
        "expected": "expected/export-failed.out"
      },
      {
        "args": [],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C"
        },
        "exit": 1,
        "expected": "expected/no-args.out"
      }
    ]
  }
}
