{
  "name": "integrate10",
  "mode": "tool",
  "description": "Main's integration pass integrate10.sh and its Jet twin Integrate10.jet (#5072 c15, c35, c9): export origin/dev from the dev worktree's repository, apply INTEG_PRE's stacked patches and then every SUB through integ-apply6.sh (the twin through its own twin IntegApply6.jet), stop on a failed regeneration, run the census (census-snap2.sh, the twin CensusSnap2.jet, under capped.sh) with the files the applied SUBs touch, then every ratchet check with the seed at once, link the batch compiler and jetpacks, run each SUB's test lines four SUBs at a time with runsub6.sh, rerun the failing ones on a clean dev export with the seed, run the goldens that cite a touched Core or Prelude file, and write the report; it prints the applied SUBs' lines, the census and ratchet results, the jetpack choice and the report's path. The fixtures hold the dev repository (dev.git, whose export links back to the fixture's lanes and subs), the worktree's repository that fetches it (work.git), the SUBs (subs), the census rows (rows), a stand-in seed (seed), stand-ins for integ-apply6.sh and census-snap2.sh (IntegApply6.jet and CensusSnap2.jet beside them run them, so both sides get the same steps) and for the compiler the census builds (orch), and stand-ins for Main's capped.sh and runsub6.sh (lanes/scratch/Main). The cases run under LC_ALL=C, so the original's sorts keep the byte order the twin's do. Each case's check.jet states the job: what the pass printed, then for each batch every file and link it left (the composed tree aside) with the status, rc and list files whole, and the report.",
  "tool": {
    "original": "Tools/agent/orchestrator/integrate10.sh",
    "jet": "Tools/agent/orchestrator/Integrate10.jet",
    "fixtures": "fixtures",
    "token_gaps": [
      "#5072 c39",
      "#5072 c40"
    ],
    "cases": [
      {
        "args": [
          "b1",
          "subs/A-1/",
          "subs/B-1",
          "subs/C-1",
          "subs/D-1",
          "subs/E-1",
          "subs/F-1"
        ],
        "env": {
          "JET_STATE_ROOT": "lanes",
          "JET_SCRATCH_ROOT": ".",
          "JET_SEED": "seed",
          "JET_DEV_WORKTREE": "work.git",
          "JET_ORCHESTRATOR_DIR": "orch",
          "GIT_CONFIG_GLOBAL": "/dev/null",
          "GIT_CONFIG_NOSYSTEM": "1",
          "LC_ALL": "C",
          "INTEG_PRE": "pre1:subs/P-1 subs/P-2"
        },
        "check": "check.jet",
        "expected": "expected/batch.out"
      },
      {
