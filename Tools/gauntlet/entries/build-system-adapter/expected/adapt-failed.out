{"comparisons":{"nix":{"cells":{"eval":{"jet":20,"peer":200,"ratio":0.1,"status":"measured","verdict":"win"},"incremental":{"jet":20,"peer":null,"ratio":null,"status":"unmeasured","verdict":"unmeasured"},"noop":{"jet":200,"peer":200,"ratio":1,"status":"measured","verdict":"loss"}},"verdict":"unmeasured"}},"contract":{"basis":"Owner direction 2026-10-28: Jet's build and package system must be lightning fast and substantially faster than Nix, as well as more powerful and easier to use, audit and reason about. Nix is a required peer.","cells":[{"id":"eval","jet":["{jet}","check","@build.jet"],"meaning":"evaluate the build configuration without building","nix":["nix","eval","--raw","{flake}.drvPath"],"prepare":"nothing; the previous round left the project built","target":{"ratio_max":0.25}},{"id":"noop","jet":["{jet}","build"],"meaning":"rebuild with nothing changed","nix":["nix","build","--no-link","--print-out-paths","--option","substitute","false","{flake}"],"prepare":"nothing; the previous build is current","target":{"ratio_max":0.25}},{"id":"incremental","jet":["{jet}","build"],"meaning":"rebuild after a one-file edit","nix":["nix","build","--no-link","--print-out-paths","--option","substitute","false","{flake}"],"prepare":"append one new unused function to the peer's edit file","target":{"ratio_max":0.25}},{"id":"cold_cache","jet":["{jet}","build"],"meaning":"build a checkout with no local build state while a populated cache or substituter holds the current build","nix":["nix","build","--store","{nix_store}","--no-link","--print-out-paths","--option","substituters","{nix_cache}","--option","require-sigs","false","{flake}"],"prepare":"jet: remove the package's .jet directory and keep JET_STORE_DIR; nix: copy the current output to the file:// cache and delete it from the private store","target":{"ratio_lt":1}},{"id":"scratch","jet":["{jet}","build"],"meaning":"hermetic from-scratch build of the project with its toolchain present","nix":["nix","build","--no-link","--print-out-paths","--rebuild","--option","substitute","false","{flake}"],"prepare":"jet: remove the package's .jet directory and empty JET_STORE_DIR; nix: --rebuild runs the derivation again in its sandbox","target":{"ratio_lt":1}}],"comparator":"ratio = jet median / nix median; eval, noop and incremental need ratio <= 0.25, cold_cache and scratch need ratio < 1.00; a failed command, wrong output or missing sample fails closed","fairness":["one program, byte-identical output, validated after every timed build","fresh process per sample; peers interleaved, order alternating per round","preparation is never timed","Nix keeps its evaluation cache and its own toolchain closure; Jet keeps its shipped runtime and Core","Nix local cells run without substituter queries, so unreachable caches cost Nix nothing"],"harness":"fake-harness.mjs","metric":"wall_ns","peers":[{"builds":"jet build in the package root; JET_STORE_DIR under the work dir","id":"jet","required":true},{"builds":"the system daemon store with substitution off for local cells; a private local store and a file:// binary cache for cold_cache","id":"nix","required":true}],"project":{"edit_files":{"jet":"jet/units_4.jet","nix":"nix/src/units_4.c"},"expected_output_file":"Tools/perf/build-time/midsize.out","generator":"node Tools/gauntlet/axes/build-system/generate.mjs {dir}","shape":"the mid-size build-time program (Tools/perf/build-time/midsize.mjs, 90 units) in 9 unit files plus the entry; Jet: a package whose @build.jet `build: fn` registers one executable; Nix: a flake whose stdenv.mkDerivation runs make over the same program in C (gcc -O1, parallel), nixpkgs pinned to the repository's flake.lock"},"samples":5,"schema":"gauntlet-axis-build-system-v1","status":"required","warmups":1},"id":"build_system","metric":"wall_ns","metrics":{"eval":{"jet_wall_ns":20,"nix_wall_ns":200},"incremental":{"jet_wall_ns":20,"nix_wall_ns":null},"noop":{"jet_wall_ns":200,"nix_wall_ns":200}},"publication":{"blockers":["incremental (nix): `nix build` exited 1: no space left","noop: jet/nix 1 misses {\"ratio_max\":0.25}","incremental: jet/nix unmeasured misses {\"ratio_max\":0.25}"],"status":"blocked"},"receipt":"run/axes/build_system/receipt.json","required":true,"schema":"gauntlet-axis-build-system-v1","status":"incomplete","verdicts":{"nix":"unmeasured"}}
