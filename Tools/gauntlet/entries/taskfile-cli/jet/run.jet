use core.[encoding.json, files, process]

Task: struct { id: Int, text: String, done: Bool }
Store: struct { tasks: [Task] }

save: fn(tasks: [Task]) Err! {
    files.write("tasks.json", json.to_string(Store{tasks: tasks}))
}

run: fn() Err! {
    args: process.args()
    command: args.get(0) ?? ""
    tasks := if files.exists("tasks.json") -> json.decode<Store>(files.read("tasks.json")).tasks else -> [Task]{}

    if command == {
        "add" -> {
            text: args.get(1) ?? ""
            tasks.push(Task{id: tasks.len() + 1, text: text.copy(), done: false})
            save(tasks)
            print("added {tasks.len()} {text}")
        }
        "done" -> {
            id: Int.parse(args.get(1) ?? "") ?? -1
            if tasks.position(fn(task) { task.id == id }) == {
                .Val(at) -> {
                    tasks[at].done = true
                    save(tasks)
                    print("done {id}")
                }
                .None -> print("no task {id}")
            }
        }
        "list" -> {
            done: tasks.count_where(fn(task) { task.done })
            loop task in tasks -> print("[{if task.done -> "x" else -> " "}] {task.id} {task.text}")
            print("open {tasks.len() - done} done {done}")
        }
        else -> {}
    }
}
