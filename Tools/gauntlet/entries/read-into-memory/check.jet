// The job of a read-into-memory case, as facts (the harness runs it in the
// case directory with the file holding the program's output): every field of
// the printed summary but the host facts and the command line, which name the
// machine and the program. The stand-ins fix the builds and the counting
// facts; peak RSS is the gauntlet timer's real reading of the stand-in
// program, so for it the facts are that it was measured and judged.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
}

// A positive number (parsed JSON holds numbers as their lexemes).
measured: fn(value: Dyn) -> Bool {
    if value == {
        .Int(number) -> return number > 0
        .Float(number) -> return number > 0.0
        .Number(lexeme) -> return !lexeme.starts_with("-") && lexeme.partition("e").head.bytes().any(b -> b >= (U8{49}) && b <= (U8{57}))
        .Null | .Bool(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return false
    }
}

run: fn() {
    summary: json.parse(files.read(process.args()[0]) ?? panic("no output file: {err}")) ?? panic("the output is not JSON: {err}")
    if summary == .Object(entries) {
        loop entry in entries {
            key: entry.key
            if key == "host" || key == "generated_command" -> next
            if key.contains("peak_rss") {
                print("{key}: {if measured(entry.value) -> "measured" else -> "missing"}")
                next
            }
            if key == "metric_verdicts" && entry.value == .Object(verdicts) {
                loop verdict in verdicts {
                    shown: json.dumps(verdict.value) ?? "?"
                    if verdict.key == "peak_rss_kb" {
                        print("verdict {verdict.key}: {if verdict.value == .Text(_) -> "judged" else -> shown}")
                    } else {
                        print("verdict {verdict.key}: {shown}")
                    }
                }
                next
            }
            print("{key}: {json.dumps(entry.value) ?? "?"}")
        }
    }
}
