#!/bin/sh
# Stand-in for `gdb -q -batch ... -ex "run 2>ERR" -x facts.py BINARY`: runs
# BINARY with its stderr in ERR and prints the counting policy's facts, fixed
# per arm (the counted surface build allocates less than the plain one).
for arg in "$@"; do
  case $arg in
    "run 2>"*) err=${arg#run 2>} ;;
  esac
  binary=$arg
done
[ -n "$err" ] || exit 2
"$binary" >/dev/null 2>"$err" || exit 3
case $binary in
  */surface-counted/*) echo "ALLOCATOR-FACTS mode=1 allocations=49841 high_water=145240" ;;
  */plain-counted/*) echo "ALLOCATOR-FACTS mode=1 allocations=82689 high_water=147240" ;;
  *) exit 4 ;;
esac
