{
  "name": "roots-mjs",
  "mode": "tool",
  "description": "The dev tool roots roots.mjs and its Jet twin Roots.jet in Tools/agent (#5072 c9): a root is the environment's value (empty is unset), else the default derived from $HOME and the XDG directories, joined as node's path.join joins. Imported, roots.mjs gives node tools the roots; run with root names, it prints `NAME=value` for each, as Roots.jet does, and exits 64 at a name that is not one of its eight (JET_DEV_WORKTREE is roots.sh's alone). roots.mjs reads no file: one case points XDG_CONFIG_HOME at roots-sh's quoting env file, which both programs ignore, and the rest at a directory without one. Every case sets every root so the machine's own leak into nothing, and the XDG data and config directories are relative so no path names the machine. HOME and XDG_CACHE_HOME stay the machine's, because the harness starts both programs through Tools/agent/JetEnv.jet, which keeps its dev shells there; roots-sh's check.jet writes the machine's cache directory as `$XDG_CACHE_HOME` and its home directory as `<HOME>`. The cases cover the defaults, the environment over the defaults (JET_BIN, the jet under test, included), roots joined from values with doubled slashes, `.`, `..` and trailing slashes, the ignored env file, a name that is not a root after one that is (JET_ROOT, then JET_DEV_WORKTREE), and no name.",
  "tool": {
    "original": "Tools/agent/roots.mjs",
    "jet": "Tools/agent/Roots.jet",
    "fixtures": "../roots-sh/fixtures",
    "cases": [
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "expected": "expected/defaults.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "/env/state", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "/env/base", "JET_TARGET_ROOT": "", "JET_SEEDS": "/env/seeds", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "expected": "expected/environment.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "/env/scratch", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "/env/seed", "JET_BIN": "/env/bin/jet", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "expected": "expected/seed-and-bin.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "/env//state/", "JET_SCRATCH_ROOT": "/env//scratch/../x/", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "../seed/./", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data/./", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "expected": "expected/joined.out"},
      {"args": ["JET_STATE_ROOT", "JET_SCRATCH_ROOT", "JET_RUN_ROOT", "JET_BASE_ROOT", "JET_TARGET_ROOT", "JET_SEEDS", "JET_SEED", "JET_BIN"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "quoting"}, "check": "../roots-sh/check.jet", "expected": "expected/env-file-ignored.out"},
      {"args": ["JET_SEED", "JET_ROOT", "JET_RUN_ROOT"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "exit": 64, "expected": "expected/unknown.out"},
      {"args": ["JET_STATE_ROOT", "JET_DEV_WORKTREE"], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "exit": 64, "expected": "expected/dev-worktree.out"},
      {"args": [], "env": {"JET_STATE_ROOT": "", "JET_SCRATCH_ROOT": "", "JET_RUN_ROOT": "", "JET_BASE_ROOT": "", "JET_TARGET_ROOT": "", "JET_SEEDS": "", "JET_SEED": "", "JET_BIN": "", "JET_DEV_WORKTREE": "/srv/checkout", "XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "none"}, "check": "../roots-sh/check.jet", "expected": "expected/none.out"}
    ]
  }
}
