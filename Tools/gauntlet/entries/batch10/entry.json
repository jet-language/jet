{
  "name": "batch10",
  "mode": "tool",
  "description": "The Lander's batch10.sh and its Jet twin Batch10.jet (#5072 c15): hold the SUBs that wait for a seed, run integrate10.sh, and when the census or a generator fails, quarantine the SUBs it names (with every later SUB of the same lead) and run the rest once more. The fixtures hold six batches, their SUBs and a stand-in integrate10.sh that prints its arguments and exits with the code in rc/BATCH.",
  "tool": {
    "original": "Tools/agent/orchestrator/batch10.sh",
    "jet": "Tools/agent/orchestrator/Batch10.jet",
    "fixtures": "fixtures",
    "cases": [
      {
        "args": ["b1", "subs/A-1", "subs/B-1/", "subs/C-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "expected": "expected/ready.out"
      },
      {
        "args": ["b2", "subs/A-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "exit": 2,
        "expected": "expected/stopped.out"
      },
      {
        "args": ["b3", "subs/L-1", "subs/L-2", "subs/M-1", "subs/N-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "expected": "expected/regen.out"
      },
      {
        "args": ["b4", "subs/P-1", "subs/Q-1", "subs/P-2", "subs/R-1", "subs/S-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "exit": 3,
        "expected": "expected/quarantined.out"
      },
      {
        "args": ["b5", "subs/T-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "exit": 1,
        "expected": "expected/unattributed.out"
      },
      {
        "args": ["b6", "subs/U-1"],
        "env": {"JET_SCRATCH_ROOT": ".", "JET_ORCHESTRATOR_DIR": "."},
        "exit": 1,
        "expected": "expected/all-blamed.out"
      }
    ]
  }
}
