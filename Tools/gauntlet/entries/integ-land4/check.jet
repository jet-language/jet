// The job of an integ-land4 case, as facts (PortBars.jet runs it in the case
// directory, the dev worktree, with the file holding the program's output):
// what it printed, the worktree's last commits and status, origin's dev, the
// queue files and each batch's landed-file lists and commit messages.
use {
    files: core.files
    process: core.process
}

// `git ARGS` here (the case's GIT_DIR), its output.
git: fn(args: [String]) -> String { process.cmd(["git"].concat(args)).run().output.trim_end() }

run: fn() {
    loop line in files.read(process.args()[0]).lines() -> print(line.trim_end())
    print("HEAD: {git(["log", "--format=%h %s | %b", "-n", "2"]).replace("\n", " ")}")
    print("status: {git(["status", "--porcelain=v1", "-uno"]).replace("\n", " ")}".trim_end())
    print("origin dev: {git(["--git-dir=origin.git", "rev-parse", "--short", "dev"])}")
    loop name in ["batch-queue.txt", "landed-subs.txt"] -> print("{name}: {(files.read("scratch/Main/{name}") ?? "none").trim_end().replace("\n", " ")}")
    batches := loop entry in files.list_dir("lanes/Main/integ") -> entry.name
    batches.sort()
    loop batch in batches {
        made := (loop entry in files.list_dir("lanes/Main/integ/{batch}") -> entry.name).filter(name -> name.ends_with(".landfiles") || name.ends_with(".commitmsg"))
        made.sort()
        loop name in made -> print("{batch}/{name}: {files.read("lanes/Main/integ/{batch}/{name}").trim_end().replace("\n", " | ")}".trim_end())
    }
}
