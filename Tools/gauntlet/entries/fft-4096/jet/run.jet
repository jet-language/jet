use core.[compute, math]

// Every real and imaginary scalar must be within this absolute tolerance.
run: fn() Err! {
    tolerance: 0.000000001
    signal := compute.zeros([4096])
    compute.set(signal, [0], 1.0)
    output: compute.to_list(compute.fft(signal))
    if output.len() != 8192 -> panic("fft validation: {output.len()} scalars")
    failures := 0
    loop i in 0..<4096 {
        if !(math.abs(output[2 * i] - 1.0) <= tolerance) -> failures += 1
        if !(math.abs(output[2 * i + 1]) <= tolerance) -> failures += 1
    }
    if failures != 0 -> panic("fft validation failed: {failures}")
    print("fft4096 checked=8192 tolerance=1e-9")
}
