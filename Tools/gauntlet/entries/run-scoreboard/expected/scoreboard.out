01-win.json	{"strict_performance_policy":{"schema":"jet.strict-performance-policy.v3","id":"AGENTS.md#strict-performance-gate","version":3,"comparison":"per_cell_and_metric","comparators":{"win":"<1","loss":">=1"},"failure_statuses":["missing","wrong","unavailable","uncovered","mismatched","inconclusive"],"foundations":[{"id":"numerics","required":true,"cells":["numerics.float-kernel","numerics.fft","numerics.tensor-map","numerics.int-kernel"],"metrics":"all"},{"id":"text","required":true,"cells":["text.kernel","text.regex-kernel","text.regex-find-all-large","text.report-cli","text.script"],"metrics":"all"},{"id":"files","required":true,"cells":["files.script","files.orchestration"],"metrics":"all"},{"id":"concurrency","required":true,"cells":["concurrency.app","concurrency.service"],"metrics":"all"},{"id":"networking","required":true,"cells":["netserv.client","netserv.service"],"metrics":"all"},{"id":"build_time","required":true,"cells":"all","metrics":["cold_build_seconds","warm_build_seconds"]},{"id":"run_time","required":true,"cells":"all","metrics":"runtime"}],"critical_areas":[{"id":"web","required":true,"cells":["webfront.widget","webfront.app"],"metrics":"all"},{"id":"games","required":false,"activation":"first_party_battery","cells":[],"metrics":"all"},{"id":"cli_and_scripts","required":true,"cells":["cli.app","cli.hello","text.report-cli","text.script","formats.csv-cli","files.script"],"metrics":"all"},{"id":"data_analysis","required":true,"cells":["formats.csv-cli","numerics.script","numerics.notebook"],"metrics":"all"},{"id":"backend_services","required":true,"cells":["concurrency.service","netserv.service"],"metrics":"all"},{"id":"ai_ml_applications","required":false,"activation":"first_party_battery","cells":[],"metrics":"all"},{"id":"gui_applications","required":false,"activation":"first_party_battery","cells":[],"metrics":"all"},{"id":"embedded","required":true,"cells":["embedded.kernel","embedded.data"],"metrics":"all"}],"first_party_battery_required":true,"historical_receipts":"immutable_recorded_policy","ceiling":{"stages":[{"id":"peer_floor","role":"initial","against":"every_matched_peer","comparators":{"win":"<1","loss":">=1"}},{"id":"machine_ceiling","role":"final","against":"hand_written_machine_code","comparators":{"meet":"<=1","miss":">1"}}],"closes_cell":"peer_floor","peer_win_closes_cell":true,"ceiling_gate":"reported_until_hill_climbing_opens","required_cells":"every_required_cell","metrics":{"runtime":"cycles","latency":"cycles","binary":"bytes"},"references":"Tools/perf/asm-parity/cells.json","reference_source":"ref.S","reference_link":"gauntlet","missing_reference":"uncovered","reference_technique":"best_known_for_the_workload","better_technique":"replaces_reference_and_raises_target"},"text":"Jet's performance target has two stages. The first stage is the peer floor, and it is a hard, structural requirement: a Jet program must be faster and use less peak memory than the same program in every other language. Jet/peer must be below `1.00` for every matched peer, for each required cell and for both wall time and peak memory. Rust is judged like every other peer, with no parity band. A loss to any peer on either metric is a codegen, runtime or Core failure. It is fixed generally and structurally, so that any Jet program beats the other languages, never only the measured one. The second and final stage is the machine ceiling: hand-written, maximally optimized machine code for the same workload, which Jet must match or beat in both cycles and bytes (Jet/ceiling at most `1.00`). Jet aims as close to the ceiling as it can. Closing the remaining ceiling gap is the hill-climbing stage: until the owner opens it, a cell passes the gate on the peer floor, and its ceiling ratio is measured and reported but does not fail the gate.\n\nEvery required cell needs a ceiling reference: an asm-parity cell (Tools/perf/asm-parity) that names its gauntlet cell and does the work with the best known technique for the workload (SIMD, algorithmic, or syscall-level), not a naive transliteration. A cell without a reference is uncovered and fails the gate once hill climbing opens the ceiling stage. A better technique replaces the reference and raises the target.\n\nRequired cells cover the foundations (numerics, text, files, concurrency, networking, build time, and run time) plus one real workload in each critical area: web, games, CLI and scripts, data analysis, backend services, GUI applications, and embedded. A niche becomes required only when Jet ships a first-party battery for it; never claim a niche win without one.\n\nApply the comparator separately to each cell and metric. Never average away a loss, substitute an easier workload or tier, drop a peer, or accept wrong, unavailable, uncovered, mismatched, or inconclusive evidence. A performance card, milestone, dashboard, or release gate stays open while any required cell fails. Never trade semantics, diagnostics, determinism, safety, or I9 parity for a score. Manifests and gates must encode this policy; prose alone is not evidence. Historical receipts stay immutable under the policy they were recorded with and never weaken the current gate."},"contract":"gauntlet-scoreboard-v1","primary_metric_by_mode":{"batch":"runtime_wall_seconds","batch-steps":"runtime_wall_seconds","service":"service_latency_ms_p50","web":"runtime_first_stdout_seconds","web-app":"runtime_first_stdout_seconds"},"verdict_policy":{"win":"<1","loss":">=1","unmeasured":"missing row, tier, metric, or byte verification"},"validation_issues":["fixture/jet/run/edited: gated cache state is missing or not measured","fixture/jet/run/repeat: gated cache state is missing or not measured","matrix is missing the strict performance policy"],"cells":[{"id":"fixture.cell","domain":"text","kind":"application","entries":[{"entry":"fixture","mode":"batch","status":"ok","primary_metric":"runtime_wall_seconds","primary_verdict":"win","jet":1,"jet_tiers":{"aot":"ok","run":"ok","dev":"unavailable"},"tiers_ready":true,"peers":[{"language":"rust","applicable":true,"status":"ok","jet":1,"peer":2,"trace_only_tiers":[],"jet_configuration":"jet","required_tiers":["aot"],"tier_policy":{"aot":{"required":true}},"peer_sample":{"binding":"immutable_peer_row_reused_per_declared_jet_tier","source":"rows.rust.metrics","language":"rust","source_sha256":"rust-source"},"ratio":0.5,"verdict":"win","tier_verdicts":{"aot":"win"},"all_required_tiers_verdict":"win","metric_comparisons":{"runtime_wall_seconds":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"runtime_peak_rss_kb":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"runtime_first_stdout_seconds":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"cold_build_seconds":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"warm_build_seconds":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"binary_bytes":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"loc":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"source_bytes":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"tokens":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null},"source_tokens":{"status":"measured","applicability":{"status":"required"},"tiers":{"aot":{"status":"measured","jet":1,"peer":2,"ratio":0.5,"verdict":"win","evidence":null,"noise":null,"confidence":null,"reason":null}},"verdict":"win","reason":null}},"metric_verdicts":{"runtime_wall_seconds":"win","runtime_peak_rss_kb":"win","runtime_first_stdout_seconds":"win","cold_build_seconds":"win","warm_build_seconds":"win","binary_bytes":"win","loc":"win","source_bytes":"win","tokens":"win","source_tokens":"win"},"metric_failures":[]}],"run_reference":null,"metric_verdicts":{"runtime_wall_seconds":"win","runtime_peak_rss_kb":"win","runtime_first_stdout_seconds":"win","cold_build_seconds":"win","warm_build_seconds":"win","binary_bytes":"win","loc":"win","source_bytes":"win","tokens":"win","source_tokens":"win"},"metric_failures":[],"loss_owners":[],"verdict":"win"}],"metric_verdicts":{"runtime_wall_seconds":"win","runtime_peak_rss_kb":"win","runtime_first_stdout_seconds":"win","cold_build_seconds":"win","warm_build_seconds":"win","binary_bytes":"win","loc":"win","source_bytes":"win","tokens":"win","source_tokens":"win"},"metric_failures":[],"peer_verdict":"win","ceiling":{"required":false,"status":"uncovered","references":[],"metrics":{"runtime_wall_seconds":{"measure":"cycles","verdict":"uncovered","rows":[],"reason":"no hand-written machine-code reference names this cell"},"runtime_first_stdout_seconds":{"measure":"cycles","verdict":"uncovered","rows":[],"reason":"no hand-written machine-code reference names this cell"},"binary_bytes":{"measure":"bytes","verdict":"uncovered","rows":[],"reason":"no hand-written machine-code reference names this cell"}},"verdict":"uncovered"},"ceiling_verdict":"uncovered","verdict":"win","loss_owners":[]}],"summary":{"cells":1,"win":1,"loss":0,"unmeasured":0,"unmeasured_allowed":0,"unmeasured_required":0,"metric_win":10,"metric_loss":0,"metric_unmeasured":0,"metric_not_applicable":0,"ceiling_meet":0,"ceiling_miss":0,"ceiling_uncovered":1,"ceiling_unmeasured":0},"ceiling_coverage":{"references":"Tools/perf/asm-parity/cells.json","covered":[],"uncovered":["fixture.cell"],"measured":false},"loss_owners":{"declared":{},"tower":{"status":"available","revision":1},"unresolved":[]}}
