== PerfScalingGate-timing.sh mode 755 mtime +1 s
#!/usr/bin/env bash
# proofq: mem=25G time=50M kind=measure
# #4601: timing; rc=1 is gate evidence, not an invalid run.
set -u
cd '<repo>' || exit 2
Tools/agent/JetEnv.jet bash 'state/disk-guard.sh' --check 30 'state/scaling-gate' || exit $?
flock 'state/scaling-gate.lock' Tools/agent/JetEnv.jet jet Tools/perf/scaling/run-gate '--compiler' 'lin=command:true {n}' '--shape' 'huge-fns' '--shape' 'fan-in' '--shape' 'web' '--shape' 'game' '--shape' 'cli' '--shape' 'data' '--shape' 'gui' '--shape' 'embedded' '--shape' 'compiler' '--shape' 'scientific' '--shape' 'generic-lib' '--shape' 'generated' '--steps' '2' '--domain-ladder' '125000,1000000' '--memory-max' '24G' '--timeout' '20' '--stop-after' 'Infinity' '--seed' '1' '--jet-command' 'build' '--work-dir' '<case>/work/timing' '--build-root' 'state/scaling-gate' '--mode' 'timing' '--jobs' '1' '--layout' 'files' '--layout' 'single'
rc=$?
echo "gate rc=$rc (1 = failures recorded in receipt.json)"
[ "$rc" -le 1 ]
