state/proofq/queue/ScalingGate-counters-1.sh
state/proofq/queue/ScalingGate-counters-2.sh
state/proofq/queue/PerfScalingGate-timing.sh
== PerfScalingGate-timing.sh mode 755 mtime +1 s
#!/usr/bin/env bash
# proofq: mem=25G time=50M kind=measure
# #4601: timing; rc=1 is gate evidence, not an invalid run.
set -u
cd '<repo>' || exit 2
Tools/agent/JetEnv.jet bash 'state/disk-guard.sh' --check 30 '<case>/build' || exit $?
flock 'state/scaling-gate.lock' Tools/agent/JetEnv.jet jet Tools/perf/scaling/run-gate '--compiler' 'jet=jet:<case>/bin/jet' '--compiler' 'cmd=command:sh '\''it'\''"s" {n}' '--shape' 'fan-in' '--steps' '2' '--domain-ladder' '125000,1000000' '--memory-max' '24G' '--timeout' '20' '--stop-after' 'Infinity' '--seed' '3' '--jet-command' 'check' '--work-dir' '<case>/work/timing' '--build-root' '<case>/build' '--mode' 'timing' '--jobs' '1' '--layout' 'single' '--base' 'fan-in=8'
rc=$?
echo "gate rc=$rc (1 = failures recorded in receipt.json)"
[ "$rc" -le 1 ]
== ScalingGate-counters-1.sh mode 755 mtime +0 s
#!/usr/bin/env bash
# proofq: mem=18G time=50M kind=test
# #4601: counters; rc=1 is gate evidence, not an invalid run.
set -u
cd '<repo>' || exit 2
Tools/agent/JetEnv.jet bash 'state/disk-guard.sh' --check 30 '<case>/build' || exit $?
flock --shared 'state/scaling-gate.lock' Tools/agent/JetEnv.jet jet Tools/perf/scaling/run-gate '--compiler' 'jet=jet:<case>/bin/jet' '--compiler' 'cmd=command:sh '\''it'\''"s" {n}' '--shape' 'small-fns' '--steps' '4' '--domain-ladder' '125000,250000,500000,1000000' '--memory-max' '8G' '--timeout' '22' '--stop-after' '30' '--seed' '3' '--jet-command' 'check' '--work-dir' '<case>/work/counter-1' '--build-root' '<case>/build' '--mode' 'counters' '--jobs' '2' '--layout' 'single' '--ladder' 'small-fns=2,4'
rc=$?
echo "gate rc=$rc (1 = failures recorded in receipt.json)"
[ "$rc" -le 1 ]
