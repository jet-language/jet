// Legal slow control: same disjoint range with an extra checked helper.
triple_then_subtract: fn(value: Int) -> Int { (value * 3) - value }

run: fn() {
    values: [Int]{1, 2, 3, 4}
    total := 0
    loop index in 0..<values.len() {
        total += triple_then_subtract(values[index])
    }
    print(total)
}
