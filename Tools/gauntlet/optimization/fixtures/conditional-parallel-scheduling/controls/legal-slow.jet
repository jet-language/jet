// Legal slow control: same sequential schedule with an extra pure helper call.
square: fn(value: Int) -> Int { value * value }

run: fn() {
    values := [Int]{}
    loop index in 0..<1024 {
        &values.push(index)
    }
    results := [Int]{}
    loop value in values {
        &results.push(square(value))
    }
    print("{results[0]}:{results[1023]}")
}
