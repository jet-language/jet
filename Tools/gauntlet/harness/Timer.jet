// Run one command, or a JSON list of commands one after another, and print one
// JSON timing sample (schema jet.gauntlet.timer.v2): wall time, time to the
// first stdout byte, peak resident memory and the exit code (a sequence's
// first nonzero one), with each command's times as `steps`. The gauntlet's
// timer; timer.py is its reference original.
//
// usage: Timer [IGNORED...] -- COMMAND [ARG...]
//        Timer --sequence-json '[["cmd", "arg"], ...]'
//
// As in timer.py, `--sequence-json` anywhere wins, and a single command is
// everything after the first `--`. A refusal prints `{"error": …}` and exits
// 64. A command word that is not a string, or that holds a NUL byte, ends
// the timer with exit 1 and no sample when that command's turn comes (where
// timer.py's Popen raises). A command that cannot start ends the sample with
// exit code 127 and its error.
//
// Each command runs through launch.c beside this file, so its times and peak
// memory are its own, not the timer's: the launcher's clock brackets just the
// command (exec to reap), and its peak is each process's exact VmHWM.
// JET_GAUNTLET_LAUNCHER names a launcher already built from launch.c;
// without it the timer builds one with `cc`.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
}

// One command's times from its start; a sample's are its commands' summed.
Times: struct {
    wall_time_ns: Int
    wall_seconds: Float
    exit_code: Int
    time_to_first_stdout_ns: Int?
    time_to_first_stdout_seconds: Float?
}

// The one JSON object the timer prints: the times at its top level, beside
// the schema, the clock they are read from, the peak resident memory, a
// sequence's steps and a command's error.
Sample: struct {
    schema: String
    clock: Dyn
    #Flatten times: Times
    peak_rss_kb: Int
    steps: [Times]?
    error: String?
}

// What the launcher reports of one command.
Launched: struct {
    times: Times
    peak_kb: Int
    exec_errno: Int
}

// Times the commands one after another as one sample: its wall time is the
// sum of theirs, its first stdout byte the first one's (after the commands
// before it), its peak the largest and its exit code the first nonzero. A
// sequence's sample keeps each command's times as its steps. When its turn
// comes, a command whose word is not a string fails its decode, and one
// whose word holds a NUL byte fails its spawn as invalid input: either ends
// the timer with exit 1 and no sample, as timer.py's Popen raises.
run: fn() {
    args: process.args()
    sequence: args.index_of("--sequence-json")
    commands: if sequence == {
        .Val(at) -> sequence_of(args.get(at + 1) ?? refuse("sequence-json requires a value"))
        None -> [Dyn]{Dyn.from(single_of(args))}
    }
    scratch: files.temp_dir("jet-timer") ?? refuse("cannot make the timer's scratch directory: {err}")
    launch: launcher(scratch.path)
    report: files.join(scratch.path, "report")
    wall_ns := 0
    first_ns := Int?{None}
    peak_kb := 0
    exit_code := 0
    steps := [Times]{}
    error := String?{None}
    loop words in commands {
        command: words.decode<[String]>()
        step: run_child(launch, report, command.copy()) ?? return Err("{err}")
        if first_ns == None -> first_ns = step.times.time_to_first_stdout_ns.map(fn(gap) { wall_ns + gap })
        wall_ns += step.times.wall_time_ns
        if step.peak_kb > peak_kb -> peak_kb = step.peak_kb
        if step.exec_errno != 0 {
            exit_code = 127
            error = Val("cannot run `{command[0]}`: exec failed (errno {step.exec_errno})")
            break
        }
        if exit_code == 0 -> exit_code = step.times.exit_code
        steps.push(step.times)
    }
    sample: Sample{
        times: times_of(wall_ns, first_ns, exit_code),
        schema: "jet.gauntlet.timer.v2",
        clock: json.parse("{{\"source\":\"launch.c\",\"implementation\":\"clock_gettime(CLOCK_MONOTONIC)\",\"resolution_ns\":1,\"monotonic\":true,\"adjustable\":false}}"),
        peak_rss_kb: peak_kb,
        steps: sequence.map(fn(_) { steps }),
        error: error
    }
    print(json.to_string(sample))
}

// The command after the first `--`.
single_of: fn(args: [String]) -> [String] {
    separator: args.index_of("--") ?? refuse("timer requires -- before command")
    command: args.slice(separator + 1, args.len())
    if command.len() == 0 -> refuse("timer requires a command")
    command
}

// The commands of a --sequence-json value, a non-empty JSON list of
// non-empty lists; as with Python's json, a repeated key keeps its last value.
sequence_of: fn(encoded: String) -> [Dyn] {
    tree: json.parse_allow_duplicates(encoded) ?? refuse("invalid sequence JSON: {err}")
    commands: tree.decode<[[Dyn]]>() ?? [[Dyn]]{}
    if commands.len() == 0 || commands.contains([Dyn]{}) -> refuse("sequence must be a non-empty list of commands")
    loop words in commands -> Dyn.Array(words.copy())
}

// The launcher JET_GAUNTLET_LAUNCHER names, else one built into `scratch`
// from the launch.c beside this script.
launcher: fn(scratch: String) -> String {
    if sys.get("JET_GAUNTLET_LAUNCHER") == .Val(built) && built != "" -> return built
    path: files.join(scratch, "launch")
    source: files.join(files.dirname(sys.executable()), "launch.c")
    receipt: process.cmd([String]{"cc", "-O2", "-o", path, source}).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? refuse("cannot build the launcher from {source}: {err}")
    if receipt.code != 0 -> refuse("cannot build the launcher from {source}: cc exited {receipt.code}")
    path
}

// Runs `command` through the launcher with its stdout drained through a
// pipe, stdin and stderr inherited.
run_child: fn(launch: String, report: String, command: [String]) -> Launched IOError! {
    argv := [String]{launch, report}
    loop word in command { argv.push(word.copy()) }
    child: process.cmd(argv).stdin(.Inherit).stdout(.Stream).stderr(.Inherit).spawn()
    loop _ in child.stdout.chunks(65536) {}
    receipt: child.wait()
    text: files.read(report) ?? refuse("the launcher exited {receipt.code} without its report: {err}")
    launched_of(text) ?? refuse("the launcher exited {receipt.code} without its report")
}

// The launcher's report as Launched: its `end` line's exit code (minus a
// signal's number), wall time, first stdout byte's time (-1 for none), peak
// KiB, user and system time, and exec errno. None without an end line.
launched_of: fn(text: String) -> Launched? {
    end := [String]{}
    loop line in text.split("\n") {
        fields: line.split(" ").to_list()
        if fields[0] == "end" -> end = fields
    }
    if end.len() != 8 -> return None
    first_ns: report_int(end[3])
    Val(Launched{times: times_of(report_int(end[2]), if first_ns < 0 -> None else -> Val(first_ns), report_int(end[1])), peak_kb: report_int(end[4]), exec_errno: report_int(end[7])})
}

report_int: fn(field: String) -> Int {
    Int.parse(field) ?? refuse("the launcher's report holds `{field}`, not a number")
}

// A wall time, a first stdout byte's time and an exit code as Times.
times_of: fn(wall_ns: Int, first_ns: Int?, exit_code: Int) -> Times Never! {
    Times{wall_time_ns: wall_ns, wall_seconds: Float{wall_ns} / 1000000000.0, exit_code: exit_code, time_to_first_stdout_ns: first_ns, time_to_first_stdout_seconds: first_ns.map(fn(ns) { Float{ns} / 1000000000.0 })}
}

// Prints the refusal as timer.py does, `{"error": message}`, and exits 64.
refuse: fn(message: String) -> Never {
    print("{{\"error\": {json.dumps(Dyn.Text(message.copy())) ?? panic("timer refusal: {err}")}}}")
    process.exit(64)
}

#Test("a sample flattens its times beside the schema, clock and steps") {
    times: Times{wall_time_ns: 500000000, wall_seconds: 0.5, exit_code: 3, time_to_first_stdout_ns: None, time_to_first_stdout_seconds: None}
    sample: Sample{schema: "s", clock: Dyn.Text("c"), times: times, peak_rss_kb: 7, steps: Val([Times]{times}), error: None}
    assert_eq(json.to_string(sample) ?? panic("sample: {err}"), "{{\"schema\":\"s\",\"clock\":\"c\",\"wall_time_ns\":500000000,\"wall_seconds\":0.5,\"exit_code\":3,\"peak_rss_kb\":7,\"steps\":[{{\"wall_time_ns\":500000000,\"wall_seconds\":0.5,\"exit_code\":3}}]}}")
}

#Test("a launcher report gives the command's times, peak and exec errno") {
    ran: launched_of("start 41 1000\nend -9 4000 500 144 10 20 0\n") ?? panic("a full report reads")
    assert_eq(ran.times.wall_time_ns, 4000)
    assert_eq(ran.times.time_to_first_stdout_ns, Val(500))
    assert_eq(ran.times.exit_code, -9)
    assert_eq(ran.peak_kb, 144)
    assert_eq(ran.exec_errno, 0)
    failed: launched_of("start 41 1000\nend 127 2000 -1 1196 0 30 2\n") ?? panic("a failed exec's report reads")
    assert(failed.times.time_to_first_stdout_ns == None && failed.exec_errno == 2)
    assert(launched_of("start 41 1000\n") == None)
    refused: if run_child("true", "report", [String]{"true", String.from_bytes_lossy([U8]{97, 0, 98})}) == {
        .Ok(_) -> false
        .Err(error) -> if error == .InvalidInput(_) -> true else -> false
    }
    assert(refused)
}

#Test("a step's seconds are its nanoseconds over 10^9") {
    times: times_of(1500000000, Val(0), 0)
    assert_eq(times.wall_seconds, Float{times.wall_time_ns} / 1000000000.0)
    assert_eq(times.time_to_first_stdout_ns, Val(0))
    assert_eq(times.time_to_first_stdout_seconds, Val(0.0))
}

#Test("a sequence is a list of word lists, decoded to strings at each command's turn") {
    commands: sequence_of("[[\"sh\", \"-c\", \"exit 3\"], [7], [\"true\"]]")
    assert_eq(commands.len(), 3)
    assert_eq(commands[0].decode<[String]>() ?? panic("words: {err}"), [String]{"sh", "-c", "exit 3"})
    assert_eq(commands[1].decode<[String]>() ?? [String]{"not text"}, [String]{"not text"})
    assert_eq(single_of([String]{"ignored", "--", "true", "--"}), [String]{"true", "--"})
}
