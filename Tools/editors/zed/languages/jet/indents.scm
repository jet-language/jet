; Indent inside every bracketed construct; the closing delimiter dedents.
(block "}" @end) @indent
(record_literal "}" @end) @indent
(record_body "}" @end) @indent
(interpolation "}" @end) @indent
(paren_expr ")" @end) @indent
(parameters ")" @end) @indent
(arguments ")" @end) @indent
(bracket_expr "]" @end) @indent
(list_import "]" @end) @indent
(attribute_list "]" @end) @indent
