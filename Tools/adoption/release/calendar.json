{
  "schema": "jet.adoption.release-calendar/v1",
  "status": "ratified-awaiting-schedule",
  "decision": "D-ADOPT-LTS1",
  "policy": {
    "cadence": "annual",
    "active_months": 12,
    "maintenance_months": 24,
    "total_months": 36,
    "maximum_overlapping_lines": 3,
    "notice_rule": "publish calendar changes at least six months before effect; never shorten a live LTS line",
    "backport_rule": "active: security, critical compiler/runtime correctness, supported-host/toolchain breakage, and severe performance regressions; maintenance: security and critical data-loss, memory-safety, type-safety, or miscompilation fixes; no new language behavior"
  },
  "first_lts": {
    "start": "{owner:D-ADOPT-LTS1.first_lts_start}",
    "active_until": "{owner:D-ADOPT-LTS1.first_lts_active_until}",
    "maintenance_until": "{owner:D-ADOPT-LTS1.first_lts_maintenance_until}",
    "eol": "{owner:D-ADOPT-LTS1.first_lts_eol}",
    "replacement": "{owner:D-ADOPT-LTS1.first_lts_replacement}"
  },
  "support_matrix": {
    "editions": "{owner:D-ADOPT-LTS1.supported_editions}",
    "hosts": "{owner:D-ADOPT-LTS1.supported_hosts}"
  },
  "owner_fields": [
    "first_lts.start",
    "first_lts.active_until",
    "first_lts.maintenance_until",
    "first_lts.eol",
    "first_lts.replacement",
    "support_matrix.editions",
    "support_matrix.hosts"
  ]
}
