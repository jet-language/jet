// The responsible-code profile of one compile (Tower #4601), the twin of
// Tools/Perf/Scaling/Profile.mjs's profileRun: BUILD_DIR/profile.jettrace
// (the compile under `jet perf attach -- <compile>`, `wrap`, which samples
// its CPU from outside it and keeps each sample's time and call stack in the
// trace's `timeline` section), each sample assigned to the JET_TRACE_FILE
// phase span it falls in, and per phase the top self functions and the top
// inclusive compiler functions, each with the file and line that declares
// it. Tools/Perf/Scaling/Profile/run.jet prints it; Gate.jet stores it in a
// receipt.
use {
    files: core.files
    json: core.encoding.json
    math: core.math
    process: core.process
}

TOP: 12

// JSON never reads as Bytes, so this stands for JavaScript's `undefined`.
UNDEFINED: Dyn.Bytes([U8]{})

// A top-level phase span (label == kind) in unix seconds.
Interval: struct {
    phase: String,
    start: Float,
    end: Float,
}

// Symbol counts in first-seen order; `at` is each symbol's row.
Counts: struct {
    at: [String:Int],
    rows: [{symbol: String, count: Int}],
}

PhaseCounts: struct {
    phase: String,
    samples: Int,
    own: Counts,
    inclusive: Counts,
}

PhaseProfile: struct {
    phase: String,
    samples: Int,
    own: [Row],
    inclusive: [Row],
}

// A function the samples were in: its name, its source (`<file>:<line>
// <bare name>`, None when its image names no declaration), and whether the
// compiler owns it, declared under `Compiler/`.
Function: struct {
    name: String,
    source: String?,
    owned: Bool,
}

// A trace's samples: each one's time in unix seconds and its frames, indexes
// into `functions` from the innermost.
Timeline: struct {
    functions: [Function],
    samples: [{t: Float, frames: [Int]}],
}

// A field as a JavaScript template literal prints it.
shown: fn(value: Dyn, key: String) -> String Never! {
    if value.get(key) == .Val(field) -> field.to_text() ?? "" else -> "undefined"
}

// A numeric field, NaN when absent or not a number.
number: fn(value: Dyn, key: String) -> Float Never! {
    (value.get(key) ?? Dyn.Null).float() ?? math.NAN
}

// An array field's items, none when absent or not an array.
items: fn(value: Dyn, key: String) -> [Dyn] Never! {
    found: value.get(key) ?? return [Dyn]{}
    if found == .Array(list) -> list.copy() else -> [Dyn]{}
}

// Trace time 0 is the `trace.start` event's `args.unix_ms`. Spans pair per
// thread and kind (`${tid}\0${cat}`, kept unambiguous by the length prefix);
// an end without a begin is ignored, and unclosed spans come last, in
// first-opened order, running to infinity.
phase_intervals: fn(events: [Dyn]) -> [Interval] Never! {
    origin: if events.find(fn(event) { shown(event, "name") == "trace.start" }) == .Val(start) -> number(start.get("args") ?? Dyn.Null, "unix_ms") / Float{1000.0} else -> Float{0.0}
    slots := [String:Int]{}
    open := [{phase: String, starts: [Float]}]{}
    intervals := [Interval]{}
    loop event in events {
        ph: shown(event, "ph")
        if (ph != "B" && ph != "E") || (event.get("name") ?? UNDEFINED) != (event.get("cat") ?? UNDEFINED) {
            next
        }
        phase: shown(event, "cat")
        tid: shown(event, "tid")
        key: "{tid.len()}:{tid}{phase}"
        t: origin + number(event, "ts") / 1000000.0
        if ph == "B" {
            if !slots.has_key(key) {
                slots[key] = open.len()
                open.push({phase: phase, starts: [Float]{}})
            }
            open[slots[key]].starts.push(t)
            next
        }
        slot: slots.get(key) ?? next
        begun: open[slot].starts.pop() ?? next
        intervals.push(Interval{phase: phase, start: begun, end: t})
    }
    loop span in open {
        loop begun in span.starts {
            intervals.push(Interval{phase: span.phase.copy(), start: begun, end: math.INFINITY})
        }
    }
    intervals
}

// The `timeline` section of the `jet perf attach` trace `file`: its
// functions, and its samples, each one's microseconds since the section's
// `origin_unix_ns` and its innermost node, whose chain of parents in
// `nodes` gives its frames. Nothing when the trace is missing or has no
// timeline.
timeline: fn(file: String) -> Timeline {
    sampled := Timeline{functions: [Function]{}, samples: []}
    text: files.read(file) ?? return sampled
    trace: json.parse(text) ?? return sampled
    found := Dyn.Null
    loop section in items(trace.get("content") ?? Dyn.Null, "receipt_sections") {
        if shown(section, "name") == "timeline" -> found = section.get("value") ?? Dyn.Null
    }
    origin: Float.from_int((found.get("origin_unix_ns") ?? Dyn.Null).int() ?? 0) / 1000000000.0
    loop each in items(found, "functions") {
        name: shown(each, "name")
        declared: if each.get("file") == .Val(path) -> path.to_text() ?? "" else -> ""
        parts: name.split(".").to_list()
        source: if declared == "" -> String?{None} else -> Val("{declared}:{shown(each, "line")} {parts[parts.len() - 1]}")
        sampled.functions.push(Function{name: name, source: source, owned: declared.starts_with("Compiler/") || declared.contains("/Compiler/")})
    }
    nodes: loop node in items(found, "nodes") -> node.int() ?? -1
    flat: loop word in items(found, "samples") -> word.int() ?? -1
    at := 0
    loop at + 1 < flat.len() {
        frames := [Int]{}
        node := flat[at + 1]
        loop node >= 0 && 2 * node + 1 < nodes.len() && nodes[2 * node] < sampled.functions.len() {
            frames.push(nodes[2 * node])
            node = nodes[2 * node + 1]
        }
        sampled.samples.push({t: origin + Float.from_int(flat[at]) / 1000000.0, frames: frames})
        at += 2
    }
    sampled
}

// The phase at unix second `t`: the latest-starting interval holding it, a
// later one winning a tie.
phase_at: fn(intervals: [Interval], t: Float) -> String? Never! {
    best := -1
    loop i in 0..<intervals.len() {
        if t < intervals[i].start || t >= intervals[i].end -> next
        if best < 0 || intervals[i].start >= intervals[best].start -> best = i
    }
    if best < 0 -> None else -> Val(intervals[best].phase.copy())
}

count: fn(counts: ^Counts, symbol: String) {
    row: counts.at.get(symbol) ?? counts.rows.len()
    if row == counts.rows.len() {
        counts.at[symbol.copy()] = row
        counts.rows.push({symbol: symbol.copy(), count: 0})
    }
    counts.rows[row].count += 1
}

// The TOP most counted symbols under `below`, by count (a tie keeps the
// first seen first), with their share of `total` and their source.
ranked: fn(counts: Counts, total: Int, below: Float, sources: [String:String]) -> [Row] Never! {
    rows := counts.rows.filter(fn(row) { Float{row.count} < below })
    rows.sort_by(fn(a, b) { b.count <=> a.count })
    out := [Row]{}
    loop row in rows.take(TOP) {
        source: if sources.get(row.symbol) == .Val(found) -> Val("{found}") else -> String?{None}
        out.push(Row{share: Float{row.count} / Float{max(1, total)}, symbol: row.symbol.copy(), source: source})
    }
    out
}

// JavaScript object key order: array-index names ascending, then the rest,
// which a stable sort keeps in insertion order.
key_rank: fn(name: String) -> Int Never! {
    value: Int.parse(name) ?? return 4294967295
    if value >= 0 && value < 4294967295 && "{value}" == name -> value else -> 4294967295
}

// The argv prefix that samples a compile from outside it into
// `dir`/profile.jettrace: `jet perf attach` of $JET, else the jet on PATH.
wrap: fn(dir: String) -[Env]> [String] Never! {
    [process.env_get("JET") ?? "jet", "perf", "attach", "--quiet", "--out", files.join(dir, "profile.jettrace"), "--"]
}

// `dir/profile.jettrace`'s samples, attributed to the `wanted` phases of
// `trace_file` (its object rows; a partial or unparsable row is skipped).
// Inclusive rows leave out functions on 95% or more of a phase's samples, the
// phase driver itself. A function's source is that of the first function of
// its name in the trace that has one.
profile: fn(dir: String, trace_file: String, wanted: [String]) -> [PhaseProfile] Err! {
    events := [Dyn]{}
    loop raw in files.read(trace_file).split("\n") {
        line: raw.trim().removesuffix(",")
        if !line.starts_with("{{") -> next
        event: json.parse(line) ?? next
        events.push(event)
    }
    slots := [String:Int]{}
    tallies := [PhaseCounts]{}
    loop phase in wanted {
        if slots.has_key(phase) -> next
        slots[phase.copy()] = tallies.len()
        tallies.push(PhaseCounts{phase: phase.copy(), samples: 0, own: Counts{at: [String:Int]{}, rows: []}, inclusive: Counts{at: [String:Int]{}, rows: []}})
    }
    intervals := [Interval]{}
    loop interval in phase_intervals(events) {
        if slots.has_key(interval.phase) -> intervals.push(interval)
    }
    sampled: timeline(files.join(dir, "profile.jettrace"))
    loop sample in sampled.samples {
        at: slots[phase_at(intervals, sample.t) ?? next]
        tallies[at].samples += 1
        count(tallies[at].own, if sample.frames.len() > 0 -> sampled.functions[sample.frames[0]].name else -> "?")
        seen := [String]{}
        loop frame in sample.frames {
            function: sampled.functions[frame]
            if seen.contains(function.name) || !function.owned -> next
            seen.push(function.name.copy())
            count(tallies[at].inclusive, function.name)
        }
    }
    sources := [String:String]{}
    loop function in sampled.functions {
        if sources.has_key(function.name) -> next
        if function.source == .Val(source) -> sources[function.name.copy()] = source.copy()
    }
    tallies.sort_by(fn(a, b) { key_rank(a.phase) <=> key_rank(b.phase) })
    phases := [PhaseProfile]{}
    loop tally in tallies {
        phases.push(PhaseProfile{phase: tally.phase.copy(), samples: tally.samples, own: ranked(tally.own, tally.samples, math.INFINITY, sources), inclusive: ranked(tally.inclusive, tally.samples, Float{0.95} * Float{tally.samples}, sources)})
    }
    Ok(phases)
}
