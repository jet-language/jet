// The responsible-code profile of one compile (Tower #4601), the twin of
// Tools/Perf/Scaling/Profile.mjs's command line: the profile of BUILD_DIR's
// profile.jettrace against TRACE_FILE's phases (jet_scaling_gate's
// Profile.jet), per phase its samples, top self functions and top inclusive
// compiler functions with their sources.
//
//   jet Tools/Perf/Scaling/Profile BUILD_DIR TRACE_FILE PHASE...   (BUILD_DIR holds profile.jettrace)
package: {
    name: "scaling_profile"
    version: "0.0.1"
    deps: {
        // A root package declares each directory its dependencies reach.
        jet_scaling_corpora: ../Corpora,
        jet_scaling_gate: ../Gate,
    }
}

use {
    jet_scaling_gate.[Row, profile]
    fmt: core.text.fmt
    process: core.process
}

print_rows: fn(rows: [Row]) {
    loop row in rows {
        print("{fmt.decimal(row.share * Float{100.0}, 1).pad_start(5, " ")}%  {row.symbol.slice(0..<min(120, row.symbol.len()))}  {row.source ?? ""}")
    }
}

run: fn() {
    args: process.args()
    if args.len() < 3 || args[0] == "" || args[1] == "" {
        process.fail(2, "Usage: jet Tools/Perf/Scaling/Profile BUILD_DIR TRACE_FILE PHASE...   (BUILD_DIR holds profile.jettrace)")
    }
    // An unreadable trace ends the run with exit 1, as an uncaught error ends
    // profile.mjs.
    phases: profile(args[0], args[1], args[2..<args.len()]) ?? process.fail(1, err.message)
    loop phase in phases {
        print("== {phase.phase}: {phase.samples} samples")
        print("-- self")
        print_rows(phase.own)
        print("-- inclusive compiler functions")
        print_rows(phase.inclusive)
    }
}
