// Core source receipt: `jet run` of hello, its system calls traced by
// `jet perf attach --lens=syscalls`, names no file under a toolchain tree's
// `Core/` or `Compiler/Prelude/`. Core and Prelude come from the compiler's
// own records, out of tree and inside a checkout.
//
//   jet Tools/Perf/CoreStrace/run.jet -- --jet PATH [--work DIR] [--out DIR]
//
// Two runs, each with an empty JET_STORE_DIR and XDG_CACHE_HOME, no
// JET_TOOLCHAIN_ROOT or JET_SEED, and NO_COLOR=1:
//
//   out-of-tree  jet run hello.jet in <work>/hello, a file printing "hello"
//   checkout     jet run Examples/Basics/Hello.jet in this checkout
//
// Each runs once under the trace, every thread and child included, and
// `jet perf view` prints its calls. Its file calls are those that name a
// path (FILE_CALLS) or read a directory (getdents64), and a call names the
// tree when its line holds `/Core/` or `/Compiler/Prelude/`.
//
// --out DIR (default <work>) gets receipt.md: the compiler (the IDENTITY
// file beside --jet and its `--version`), each run's file calls, its calls
// on the tree and verdict, any calls on the tree, and each run's count of
// its statx, openat and getdents64 calls and their errors. Only those calls
// on the tree, when there are any, name a path on this machine.
//
// Exit 0 when neither run names the tree, 1 when one does; a usage error
// or a run that fails ends it with its report on stderr and exit 1 before
// any receipt.
use core.[files, process, sys, term, time]

TIMEOUT_SECONDS: 300

OUTPUT_LIMIT: 268435456

// The path parts of a toolchain tree's Core and Prelude sources.
CORE_PART: "/Core/"

PRELUDE_PART: "/Compiler/Prelude/"

// The x86-64 system calls that name a path, as strace's `%file` class
// holds them, and the one that reads a directory.
FILE_CALLS: [String]{
    "access",
    "acct",
    "chdir",
    "chmod",
    "chown",
    "chroot",
    "creat",
    "execve",
    "execveat",
    "faccessat",
    "faccessat2",
    "fanotify_mark",
    "fchmodat",
    "fchmodat2",
    "fchownat",
    "futimesat",
    "getxattr",
    "inotify_add_watch",
    "lchown",
    "lgetxattr",
    "link",
    "linkat",
    "listxattr",
    "llistxattr",
    "lremovexattr",
    "lsetxattr",
    "lstat",
    "mkdir",
    "mkdirat",
    "mknod",
    "mknodat",
    "mount",
    "name_to_handle_at",
    "newfstatat",
    "open",
    "openat",
    "openat2",
    "pivot_root",
    "quotactl",
    "readlink",
    "readlinkat",
    "removexattr",
    "rename",
    "renameat",
    "renameat2",
    "rmdir",
    "setxattr",
    "stat",
    "statfs",
    "statx",
    "swapoff",
    "swapon",
    "symlink",
    "symlinkat",
    "truncate",
    "umount2",
    "unlink",
    "unlinkat",
    "uselib",
    "utime",
    "utimensat",
    "utimes",
    "getdents64",
}

// The calls the receipt counts for each run.
COUNTED_CALLS: [String]{"statx", "openat", "getdents64"}

// A run: its name, its working directory, its entry and what it prints.
Probe: struct {
    name: String,
    cwd: String,
    entry: String,
    shown: String,
    stdout: String,
}

// A run's receipt: its file calls, the ones that name the tree, and its
// count table.
Traced: struct {
    calls: Int,
    on_tree: [String],
    counted: [String],
}

run: fn() -> Never Err! {
    // The checkout: three up from Tools/Perf, which holds this program's directory.
    root: files.normalize("{sys.executable()}/../../../..")
    argv: process.args()
    tmp: process.env_get_or("TMPDIR", "/tmp")
    args := [String:String]{
        "jet": "",
        "work": files.join(tmp, "jet-core-sources"),
        "out": "",
    }
    i := 0
    loop i < argv.len() {
        key: argv[i].remove_prefix("--")
        if !args.has_key(key) || i + 1 >= argv.len() {
            return Err("unknown or incomplete option {argv[i]}")
        }
        args[key] = argv[i + 1].copy()  // copy: the argv keeps its items
        i += 2
    }
    jet: args["jet"]
    if !jet.starts_with("/") -> return Err("--jet takes the compiler's absolute path")
    work: files.normalize(args["work"])
    out: if args["out"] == "" -> work else -> args["out"]
    files.remove_all(work) ?? ()
    hello: files.join(work, "hello")
    files.create_dir_all(hello)
    files.write(files.join(hello, "hello.jet"), "run: fn() {{\n    print(\"hello\")\n}}\n")
    files.create_dir_all(out)
    probes: [Probe]{
        Probe{name: "out-of-tree", cwd: hello, entry: "hello.jet", shown: "jet run hello.jet", stdout: "hello\n"},
        Probe{name: "checkout", cwd: root, entry: "Examples/Basics/Hello.jet", shown: "jet run Examples/Basics/Hello.jet", stdout: "hello, world\n"},
    }
    traced := [Traced]{}
    loop probe in probes {
        ran: trace(jet, work, probe)
        term.eprint("{probe.name}: {ran.calls} file calls, {ran.on_tree.len()} on the tree")
        traced.push(ran)
    }
    lines := [String]{"# Core source receipt", ""}
    lines.extend(compiler_lines(jet))
    lines.push("Each run had an empty JET_STORE_DIR and XDG_CACHE_HOME, no JET_TOOLCHAIN_ROOT or JET_SEED, and NO_COLOR=1, under `jet perf attach --lens=syscalls`, every thread and child traced. File calls are its calls that name a path or read a directory (getdents64); a call on the tree names a path holding `/Core/` or `/Compiler/Prelude/`. Produced by `jet Tools/Perf/CoreStrace/run.jet`.")
    lines.extend([String]{"", "| Run | Command | File calls | On the tree | Verdict |", "|---|---|---:|---:|---|"})
    failed := false
    loop (index, probe) in probes {
        ran: traced[index]
        verdict: if ran.on_tree.len() == 0 -> "PASS" else -> "FAIL"
        if ran.on_tree.len() > 0 -> failed = true
        lines.push("| {probe.name} | `{probe.shown}` | {ran.calls} | {ran.on_tree.len()} | {verdict} |")
    }
    loop (index, probe) in probes {
        ran: traced[index]
        lines.extend([String]{"", "## {probe.name}", "", "`{probe.shown}`, its statx, openat and getdents64 calls:", "", "| Call | Calls | Errors |", "|---|---:|---:|"})
        lines.extend(ran.counted)
        if ran.on_tree.len() > 0 {
            lines.extend([String]{"", "Calls on the tree:", "", "```"})
            lines.push(ran.on_tree.join("\n"))
            lines.push("```")
        }
    }
    files.write(files.join(out, "receipt.md"), "{lines.join("\n")}\n")
    print(files.join(out, "receipt.md"))
    process.exit(if failed -> 1 else -> 0)
}

// The compiler's lines: its IDENTITY file (beside it) and the first line of
// its `--version`.
compiler_lines: fn(jet: String) -> [String] Err! {
    identity_file: files.join(files.dirname(jet), "IDENTITY")
    identity: if files.exists(identity_file) -> files.read(identity_file).trim() else -> "none (no IDENTITY file beside it)"
    version: process.cmd([jet, "--version"]).output_limit(1048576).run()
    named: if version.output.trim() != "" -> version.output.trim() else -> version.errors.trim()
    [String]{"Compiler: identity `{identity}`, `jet --version`: `{named.partition("\n").head}`.", ""}
}

// `probe` run once traced in <work>/runs/<name>, then its calls as
// `jet perf view` prints them: `  <pid> <name>(<args>) = <result>`.
trace: fn(jet: String, work: String, probe: Probe) -> Traced Err! {
    dir: files.join(work, "runs/{probe.name}")
    files.create_dir_all(dir)
    saved: files.join(dir, "run.jettrace")
    spawn(jet, dir, probe, [String]{jet, "perf", "attach", "--lens=syscalls", "--out", saved, "--"})
    viewed: process.cmd([jet, "perf", "view", saved]).env("NO_COLOR", "1").timeout(time.duration_seconds(TIMEOUT_SECONDS)).output_limit(OUTPUT_LIMIT).run()
    if viewed.code != 0 {
        return Err("{probe.name}: jet perf view failed (exit {viewed.code}): {viewed.errors.trim()}")
    }
    files.write(files.join(dir, "calls.txt"), viewed.output)
    calls := 0
    on_tree := [String]{}
    counts := [Int]{0, 0, 0}
    errors := [Int]{0, 0, 0}
    loop line in viewed.output.split("\n") {
        name: call_name(line) ?? next
        if !FILE_CALLS.contains(name) -> next
        calls += 1
        if line.contains(CORE_PART) || line.contains(PRELUDE_PART) -> on_tree.push(line.trim())
        loop (index, counted) in COUNTED_CALLS {
            if name != counted -> next
            counts[index] = counts[index] + 1
            if line.contains(") = -1 ") -> errors[index] = errors[index] + 1
        }
    }
    counted := [String]{}
    loop (index, name) in COUNTED_CALLS {
        counted.push("| {name} | {counts[index]} | {errors[index]} |")
    }
    Ok(Traced{calls: calls, on_tree: on_tree, counted: counted})
}

// The call a line of `jet perf view` names, or None for a line that is no
// call: `  <pid> <name>(`.
call_name: fn(line: String) -> String? {
    if !line.starts_with("  ") -> return None
    rest: line.trim()
    space: rest.partition(" ")
    if space.tail == "" -> return None
    open: space.tail.partition("(")
    if open.tail == "" || open.head.contains(" ") -> return None
    Val(open.head.copy())
}

// One run of `probe` after the `tracer` words, with its own empty store
// and cache in <dir>.
spawn: fn(jet: String, dir: String, probe: Probe, tracer: [String]) Err! {
    store: files.join(dir, "store")
    cache: files.join(dir, "cache")
    files.create_dir_all(store)
    files.create_dir_all(cache)
    argv := tracer
    argv.extend([String]{jet, "run", probe.entry})
    spec: process.cmd(argv).cwd(probe.cwd).env_remove("JET_TOOLCHAIN_ROOT").env_remove("JET_SEED").env("JET_STORE_DIR", store).env("XDG_CACHE_HOME", cache).env("NO_COLOR", "1")
    receipt: spec.timeout(time.duration_seconds(TIMEOUT_SECONDS)).output_limit(OUTPUT_LIMIT).run()
    files.write(files.join(dir, "run.stdout"), receipt.output)
    files.write(files.join(dir, "run.stderr"), receipt.errors)
    if receipt.timed_out || receipt.signal != None || receipt.code != 0 {
        return Err("{probe.name} failed (exit {receipt.code}, timed out {receipt.timed_out}); its output is in {dir}")
    }
    if receipt.output != probe.stdout {
        return Err("{probe.name} printed {receipt.output.debug()}, not {probe.stdout.debug()}")
    }
}
