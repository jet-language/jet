// The memory kernel's resize: 4096 appends over 256 byte lists. Each one
// grows a list by a drawn count of bytes, from 1 to 64 and weighted to the
// small ones, with mem.list_append, which grows a full buffer in place or
// moves it. A list that would pass 1 KiB starts over empty, which releases
// its buffer. `n` passes over them; the sum adds each list's length after
// each append.
use mem: core.mem

#CLI
Args: struct {
    n: Int
}

// One operation: the list it grows and the bytes it appends.
Op: struct {
    slot: Int
    size: Int
}

OPS: 4096

SLOTS: 256

LIMIT: 1024

// The next state of a 31-bit linear congruential generator.
next: fn(state: Int) -> Int { (state * 1103515245 + 12345).bit_and(2147483647) }

// The operations: per operation one draw picks the count (its top bits a
// class of up to 8, 16, 32 or 64 bytes, the count from bits 12 up) and a
// second the list (bits 16 to 23). The generator's low bits repeat too soon
// to pick a class.
operations: fn() -> [Op] {
    ops := [Op]{}
    state := 12345
    loop _ in 0..<OPS {
        state = next(state)
        class: (state >> 28).bit_and(3)
        size: 1 + (state >> 12).bit_and((8 << class) - 1)
        state = next(state)
        ops.push(Op{slot: (state >> 16).bit_and(SLOTS - 1), size: size})
    }
    ops
}

run: fn(args: Args) {
    passes: if args.n > 0 -> args.n else -> 1
    ops: operations()
    source := [U8]{}
    loop i in 0..<64 -> source.push(U8{i})
    lists := [[U8]]{}
    loop _ in 0..<SLOTS -> lists.push([U8]{})
    total := 0
    #Unsafe("every append reads the first `op.size` of the 64 bytes `source` holds, and `source` neither grows nor drops while the appends run") {
        from: mem.Ptr<U8>.from_addr(mem.address_of(source[0]))
        loop _ in 0..<passes {
            loop op in ops {
                if lists[op.slot].len() + op.size > LIMIT -> lists[op.slot] = [U8]{}
                _: mem.list_append<U8>(lists[op.slot], from, op.size)  // the resize
                total += lists[op.slot].len()
            }
        }
    }
    print("sum {total}")
}
