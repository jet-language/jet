// The plain arm of the profile-overhead pair
// (Tools/Perf/ProfileOverheadPair.jet): Zoned/main.jet without its zone,
// frame marks and plots.
#CLI
Args: struct {
    n: Int,
}

PARTICLES: 4096

// One particle's update: a step of a linear congruential walk.
step: fn(state: Int, i: Int) -> Int { (state * 1103515245 + 12345 + i) %% 2147483648 }

frame: fn(seed: Int) -> Int {
    ^acc: seed
    loop i in 0..<PARTICLES -> acc = step(acc, i)
    acc
}

run: fn(args: Args) {
    ^total: 0
    loop f in 0..<args.n -> total = frame(total + f)
    print(total)
}
