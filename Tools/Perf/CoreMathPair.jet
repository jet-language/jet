#!/usr/bin/env jet
// The Core math pair in one command: what building core.math's Float leaves
// (sqrt, floor, ceil, trunc, fabs, fma, fmod, the IEEE class tests, cmp and
// the bit casts) from their Jet bodies in Core costs against the compiler
// rows that routed them before. One program (Tools/Perf/CoreMathPair, a
// sin/exp loop through those leaves) is built with `--release` at -O1 and at
// -O2 by two compilers: `--jet`, which builds the bodies, and `--rows`, one
// that still carries the rows. Both binaries are run TRIALS times through the
// gauntlet's launcher (Tools/Gauntlet/Harness/launch.c), the arms alternating
// which runs first, and must print the same bits. Per level and per metric
// (wall time, user-mode cycles, peak memory) it takes bodies/rows of the
// upper medians and the shared harness's paired bootstrap interval of that
// ratio (Tools/Gauntlet/Harness/performance-surface.mjs). A metric is a loss
// when the interval's lower bound is above 1: the bodies are slower or bigger
// beyond noise. The command exits 0 only when no metric is a loss. `--output`
// writes the receipt as JSON. It is a timed measurement: run it alone, on the
// reference machine.
//
// usage (from the repository root; needs cc unless JET_GAUNTLET_LAUNCHER
// names a launcher built from launch.c):
//   jet Tools/Perf/CoreMathPair.jet --rows PATH [--jet PATH] [--n N] [--trials T] [--output FILE]
// The default `--jet` is Tools/Agent/JetEnv.jet's `jet`.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    regex: core.regex
    stats: core.math.stats
    sys: core.sys
}

PROGRAM: "Tools/Perf/CoreMathPair/main.jet"

LAUNCH: "Tools/Gauntlet/Harness/launch.c"

JET_ENV: "Tools/Agent/JetEnv.jet"

ARMS: [String]{"bodies", "rows"}

LEVELS: [String]{"-O1", "-O2"}

// Each run's argument: about a fifth of a second of math per run.
DEFAULT_N: "400000"

// The shared harness's paired trials and bootstrap.
DEFAULT_TRIALS: "100"

BOOTSTRAP_RESAMPLES: 10000

BOOTSTRAP_SEED: 2977

BOOTSTRAP_LOWER_RANK: 250

BOOTSTRAP_UPPER_RANK: 9750

// One timed run, from the launcher's report.
Run: struct {
    wall_ns: Int,
    cycles: Int,
    peak_kb: Int,
}

Metric: struct {
    bodies_median: Int,
    rows_median: Int,
    ratio: Float,
    lower95: Float,
    upper95: Float,
    verdict: String,
}

Level: struct {
    level: String,
    trials: Int,
    wall_ns: Metric,
    cycles_u: Metric?,
    peak_rss_kb: Metric,
    bodies_wall_ns: [Int],
    rows_wall_ns: [Int],
}

Host: struct {
    platform: String,
    release: String,
    arch: String,
    cpu_model: String?,
    cpu_count: Int,
}

Receipt: struct {
    schema: String,
    program: String,
    n: Int,
    levels: [Level],
    host: Host,
    generated_command: String,
    verdict: String,
}

fail: fn(message: String) -[Exec, IO]> Never { process.fail(1, "core math pair: {message}") }

argument: fn(argv: [String], name: String, fallback: String) -> String {
    loop at in 0..<argv.len() {
        if argv[at] == name {
            return if at + 1 < argv.len() -> argv[at + 1].copy() else -> fail("{name} needs a value")
        }
    }
    fallback.copy()
}

count: fn(text: String, name: String) -> Int {
    value: Int.parse(text) ?? fail("{name} is not a number: {text}")
    if value <= 0 -> fail("{name} must be above 0")
    value
}

// The program built by one arm's compiler at one level into `dir`, its
// binary.
build: fn(root: String, jet: [String], arm: Int, level: String, dir: String) -> String {
    files.create_dir_all(dir) ?? fail("{dir}: {err}")
    source: files.read(files.join(root, PROGRAM)) ?? fail("{PROGRAM}: {err}")
    files.write(files.join(dir, "main.jet"), source) ?? fail("{dir}/main.jet: {err}")
    ^argv: jet.copy()
    argv.extend([String]{"build", "--release", level, "main.jet"})
    built: process.cmd(argv).cwd(dir).run() ?? fail("{argv.join(" ")}: {err}")
    binary: files.join(dir, ".jet/build/main")
    if !built.success || !files.exists(binary) {
        fail("{ARMS[arm]} {level} does not build:\n{built.output}{built.errors}")
    }
    binary
}

// The launcher's report of one run: its `end` line (exit code, wall ns,
// first stdout ns, peak KiB, user us, system us, exec errno) and its
// `cycles` line (-1 when the counter could not open).
run_of: fn(report: String) -> Run {
    ^end: [String]{}
    ^cycles: -1
    loop line in report.split("\n") {
        fields: line.split(" ").to_list()
        if fields[0] == "cycles" && fields.len() == 2 -> cycles = Int.parse(fields[1]) ?? -1
        if fields[0] == "end" -> end = fields
    }
    if end.len() != 8 -> fail("the launcher's report has no end line:\n{report}")
    if end[1] != "0" || end[7] != "0" -> fail("a timed run exited {end[1]} (exec errno {end[7]})")
    Run{wall_ns: Int.parse(end[2]) ?? fail("wall time {end[2]}"), cycles: cycles, peak_kb: Int.parse(end[4]) ?? fail("peak {end[4]}")}
}

// One timed run of `binary`, which must print `expected`.
timed: fn(launch: String, report: String, binary: String, n: String, expected: String) -> Run {
    ran: process.cmd([String]{launch, report, binary, "--n", n}).run() ?? fail("{binary}: {err}")
    if ran.output != expected {
        fail("{binary} --n {n} printed other bits than its pair:\n{ran.output}")
    }
    run_of(files.read(report) ?? fail("{report}: {err}"))
}

// The shared harness's paired index bootstrap of median(bodies) /
// median(rows): a 32-bit linear congruential draw seeded with BOOTSTRAP_SEED
// picks each resample's indices; the bounds are nearest ranks.
metric: fn(bodies: [Int], rows: [Int]) -> Metric {
    ^state: BOOTSTRAP_SEED
    ^ratios: [Float]{}
    loop _ in 0..<BOOTSTRAP_RESAMPLES {
        ^picked_bodies: [Int]{}
        ^picked_rows: [Int]{}
        loop _ in 0..<bodies.len() {
            state = (state * 1664525 + 1013904223) %% 4294967296
            selected: state * bodies.len() /% 4294967296
            picked_bodies.push(bodies[selected])
            picked_rows.push(rows[selected])
        }
        bodies_median: stats.median_high_int(picked_bodies) ?? fail("no samples")
        rows_median: stats.median_high_int(picked_rows) ?? fail("no samples")
        ratios.push(Float.from_int(bodies_median) / Float.from_int(rows_median))
    }
    ratios.sort()
    lower: ratios[BOOTSTRAP_LOWER_RANK - 1]
    upper: ratios[BOOTSTRAP_UPPER_RANK - 1]
    bodies_median: stats.median_high_int(bodies) ?? fail("no samples")
    rows_median: stats.median_high_int(rows) ?? fail("no samples")
    verdict: if {
        lower > 1.0 -> "loss"
        upper < 1.0 -> "win"
        else -> "even"
    }
    Metric{bodies_median: bodies_median, rows_median: rows_median, ratio: Float.from_int(bodies_median) / Float.from_int(rows_median), lower95: lower, upper95: upper, verdict: verdict}
}

// Both arms at one level, TRIALS paired runs, the bodies first on even
// trials. The rows arm's untimed run gives the bits both must print.
level_of: fn(launch: String, scratch: String, bodies: String, rows: String, level: String, n: String, trials: Int) -> Level {
    report: files.join(scratch, "report")
    expected: process.cmd([String]{rows, "--n", n}).run() ?? fail("{rows}: {err}")
    if !expected.success -> fail("rows {level} --n {n} exited {expected.code}")
    ^bodies_runs: [Run]{}
    ^rows_runs: [Run]{}
    loop trial in 0..<trials {
        if trial %% 2 == 0 -> bodies_runs.push(timed(launch, report, bodies, n, expected.output))
        rows_runs.push(timed(launch, report, rows, n, expected.output))
        if trial %% 2 == 1 -> bodies_runs.push(timed(launch, report, bodies, n, expected.output))
    }
    bodies_wall: bodies_runs.map(fn(run) { run.wall_ns })
    rows_wall: rows_runs.map(fn(run) { run.wall_ns })
    counted: bodies_runs.all(fn(run) { run.cycles >= 0 }) && rows_runs.all(fn(run) { run.cycles >= 0 })
    Level{
        level: level.copy(),
        trials: trials,
        wall_ns: metric(bodies_wall, rows_wall),
        cycles_u: if counted -> Val(metric(bodies_runs.map(fn(run) { run.cycles }), rows_runs.map(fn(run) { run.cycles }))) else -> None,
        peak_rss_kb: metric(bodies_runs.map(fn(run) { run.peak_kb }), rows_runs.map(fn(run) { run.peak_kb })),
        bodies_wall_ns: bodies_wall,
        rows_wall_ns: rows_wall,
    }
}

cpu_model: fn() -> String? {
    found: regex.match(Regex{"model name\s*:\s*(.*)"}, files.read("/proc/cpuinfo") ?? "") ?? return None
    Val(found.groups[0].copy())
}

line_of: fn(name: String, metric: Metric) -> String {
    "{name} bodies {metric.bodies_median} rows {metric.rows_median} ratio {metric.ratio} [{metric.lower95}, {metric.upper95}] {metric.verdict}"
}

// The launcher JET_GAUNTLET_LAUNCHER names, as the gauntlet's timer takes it,
// else one built into `scratch` from launch.c with `cc`.
launcher: fn(root: String, scratch: String) -> String {
    if sys.get("JET_GAUNTLET_LAUNCHER") == .Val(built) && built != "" -> return built
    path: files.join(scratch, "launch")
    cc: process.cmd([String]{"cc", "-O2", "-o", path, files.join(root, LAUNCH)}).run() ?? fail("cannot build the launcher from {LAUNCH}: {err}")
    if !cc.success -> fail("cannot build the launcher from {LAUNCH}:\n{cc.output}{cc.errors}")
    path
}

run: fn() {
    argv: process.args()
    root: files.cwd() ?? fail("cannot read the working directory: {err}")
    if !files.exists(files.join(root, PROGRAM)) -> fail("run this from the repository root")
    given: argument(argv, "--jet", "")
    jet: if given == "" -> [String]{files.join(root, JET_ENV), "jet"} else -> [String]{given}
    rows_jet: argument(argv, "--rows", "")
    if rows_jet == "" {
        fail("--rows names the compiler that still routes core.math's Float leaves through its rows")
    }
    n_text: argument(argv, "--n", DEFAULT_N)
    n: count(n_text, "--n")
    trials: count(argument(argv, "--trials", DEFAULT_TRIALS), "--trials")
    output: argument(argv, "--output", "")
    scratch_dir: files.temp_dir("core-math-pair") ?? fail("cannot make a scratch directory: {err}")
    scratch: scratch_dir.path
    launch: launcher(root, scratch)
    ^levels: [Level]{}
    ^loss: false
    loop level in LEVELS {
        bodies: build(root, jet, 0, level, files.join(scratch, "bodies{level}"))
        rows: build(root, [String]{rows_jet}, 1, level, files.join(scratch, "rows{level}"))
        measured: level_of(launch, scratch, bodies, rows, level, n_text, trials)
        print("{level} {line_of("wall_ns", measured.wall_ns)}")
        if measured.cycles_u == .Val(cycles) -> print("{level} {line_of("cycles_u", cycles)}")
        print("{level} {line_of("peak_rss_kb", measured.peak_rss_kb)}")
        if measured.wall_ns.verdict == "loss" || measured.peak_rss_kb.verdict == "loss" {
            loss = true
        }
        if measured.cycles_u == .Val(cycles) && cycles.verdict == "loss" -> loss = true
        levels.push(measured)
    }
    verdict: if loss -> "fail" else -> "pass"
    receipt: Receipt{
        schema: "jet.perf.core-math-pair.v1",
        program: PROGRAM,
        n: n,
        levels: levels,
        host: Host{platform: sys.name(), release: sys.release(), arch: sys.arch(), cpu_model: cpu_model(), cpu_count: sys.cpu_count()},
        generated_command: "jet Tools/Perf/CoreMathPair.jet --n {n} --trials {trials}",
        verdict: verdict.copy(),
    }
    if output != "" {
        files.write(output, "{json.to_string_pretty(receipt) ?? fail("the receipt: {err}")}\n") ?? fail("{output}: {err}")
    }
    print("core math pair: {verdict}")
    if verdict != "pass" -> process.exit(1)
}

#Test("a launcher report gives a run's wall time, cycles and peak") {
    run: run_of("start 12 5\ncycles 900\nend 0 2500 -1 4096 10 2 0\n")
    assert_eq(run.wall_ns, 2500)
    assert_eq(run.cycles, 900)
    assert_eq(run.peak_kb, 4096)
}

#Test("bodies slower in every trial are a loss, even ones are not") {
    rows: loop at in 0..<100 -> 1000 + at %% 7
    slower: loop at in 0..<100 -> 1100 + at %% 7
    assert_eq(metric(slower, rows).verdict, "loss")
    assert_eq(metric(rows, rows).verdict, "even")
    assert_eq(metric(rows, slower).verdict, "win")
}
