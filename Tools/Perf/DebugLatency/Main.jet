#!/usr/bin/env jet
// Debugger latency: the time `jet debug` takes to its first stop, per step
// and per evaluation, against LLDB driving the same O0 image the same way.
// Usage (from the repository root):
//   jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R] [--bar MS] [--stop entry|nested]
// Defaults: the `jet` and `lldb` on PATH, 2000 functions, 20 steps, 5 runs,
// no bar. With no LLDB on PATH and no `--lldb`, only `jet debug` is timed and
// LLDB's column is `-`: the measurement needs nothing but jet.
//
// It writes a package whose program has N small functions, and whose `run`
// calls each in turn one line at a time and then `tally` LATENCY_HITS
// times (latency_run_tail), to a temporary directory, and builds its O0
// image once (`jet build -O0 --output-dir`), as an editor builds the program
// it launches. Both debuggers then drive that one image. It times:
//   - build: that build again, warm, the median of R runs;
//   - first_stop: `jet debug --break prog.jet:L out/prog` with an empty
//     stdin, which continues from the first stop to the program's end, from
//     the start to its exit; and `lldb -b` on the image with `breakpoint
//     set`, `run` and `continue`; the median of R runs;
//   - the rest in R sessions of each debugger, driven one command at a time
//     on its stdin (latency_jet_drive, latency_lldb_drive). Each sample is
//     the time from sending a command to the end of the debugger's answer
//     (latency_ask), and each measure the median of its samples:
//       - print_place: `print total` (LLDB: `frame variable total`);
//       - print_first: the session's first call expression, LATENCY_CALL;
//       - second_eval: a second new expression at the same stop;
//       - per_step: each of K `n` (`next`);
//       - print_again: LATENCY_CALL again, at the stop after the first step;
//       - watch_per_stop: K more steps, each with the LATENCY_WATCHES
//         expressions evaluated at its stop, to the last one's answer.
//         `jet debug` takes the step and its prints as one write, as an
//         editor sends its watch expressions after a stop; LLDB runs them as
//         `target stop-hook`s, one per expression;
//       - condition_per_hit: a breakpoint on `tally`'s last line with
//         LATENCY_CONDITION, which reads six locals and is false at every
//         hit; then `continue` to the program's end, over LATENCY_HITS.
//         `jet debug` runs the condition in the program, so no hit stops
//         it, and a reply that says it checks the condition at each hit
//         fails the measure. LLDB checks it at each hit, whose cost moves
//         with the program's resident size, its share in huge pages and the
//         machine's load, so the report gives them (LatencyTarget).
// L is the line of the first call in `run`. With `--stop nested` the N
// functions move to a second source of the package, lib.jet, beside
// `outer` and `inner`; `run` calls `outer` first, which calls `inner`, and
// L is `inner`'s first call: the stop is two calls deep in a function of a
// source that is not the entry (latency_nested_lib), where `total` is
// `inner`'s own local. A debugger run whose output does not report the
// breakpoint stop fails the measurement, and so does a failed LLDB session
// when LLDB is timed: no bar against LLDB goes unjudged. It prints the
// image's SHA-256, both tools' versions and the exact commands as `#`
// lines, then one tab-separated row per measure in milliseconds, then each
// bar's verdict (latency_verdicts).
// With `--bar MS` it fails, after the rows, when `jet debug`'s first stop
// took more than MS milliseconds.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    term: core.term
    time: core.time
}

LatencyOptions: struct {
    jet: String,
    lldb: String?,
    functions: Int,
    steps: Int,
    runs: Int,
    bar: Int?,
    // `--stop nested`: the stop is in lib.jet's `inner` (latency_nested_lib).
    nested: Bool{false},
}

// LLDB's version and first stop, when LLDB was timed.
LatencyLldb: struct {
    version: String,
    stop: Int,
}

// One sample of a measure, in microseconds.
LatencySample: struct {
    measure: String,
    us: Int,
}

// The debugged program when its condition's hits were timed: its resident
// size and the part of it in transparent huge pages, in KiB, and the
// machine's load (/proc/loadavg's three averages).
LatencyTarget: struct {
    resident_kib: Int,
    huge_kib: Int,
    load: String,
}

// One debugger's samples, in the order its sessions took them, and its
// last session's program.
LatencyTimes: struct {
    samples: [LatencySample],
    target: LatencyTarget?,
}

// A measure's medians in microseconds: `jet debug`'s, and LLDB's when it
// was timed.
LatencyRow: struct {
    measure: String,
    jet: Int,
    lldb: Int?,
}

LatencyRuns: struct {
    image_sha256: String,
    jet_version: String,
    build: Int,
    debug_stop: Int,
    lldb: LatencyLldb?,
    rows: [LatencyRow]{[LatencyRow]{}},
    jet_target: LatencyTarget?{None},
    lldb_target: LatencyTarget?{None},
}

// What ends a debugger's answer: `marker` seen `count` times since the
// command was sent, with a line end after the last when `line`. Output
// holding a line with `refused` first is the debugger refusing it.
LatencyUntil: struct {
    marker: String,
    count: Int,
    line: Bool,
    refused: String,
}

// A debugger's answer to one command, and the microseconds from sending
// the command to its end.
LatencyAnswer: struct {
    text: String,
    us: Int,
}

// The call expression the print measures evaluate: a call of one of the
// program's functions on the stopped function's local.
LATENCY_CALL: "f_1(total)"

// LATENCY_CALL as LLDB takes it. The image's debug information gives `f_1`
// no return type (LLDB reads it as `void (Int)`), so LLDB calls it and
// prints nothing unless the call casts it to its real type.
LATENCY_LLDB_CALL: "((long (*)(long))f_1)(total)"

// The second new expression at the first stop (second_eval).
LATENCY_SECOND: "total + 1"

// The expressions watch_per_stop evaluates at each stop: the local, three
// new expressions and the call.
latency_watches: fn() -> [String] Never! {
    [String]{"total", "total + 2", "total * 2", "total % 7", LATENCY_CALL}
}

// `expression` as LLDB takes it.
latency_lldb_expression: fn(expression: String) -> String Never! {
    if expression == LATENCY_CALL -> LATENCY_LLDB_CALL else -> expression.copy()
}

// The hits of condition_per_hit: `run` calls `tally` this many times.
LATENCY_HITS: 1000

// `tally`'s last line, where condition_per_hit's breakpoint is.
LATENCY_TALLY_SUM: "    a + b + c + d + e + f"

// condition_per_hit's condition: false at every hit, and it reads six of
// `tally`'s locals, more than a call's registers hold, so the placed code
// takes them by a table.
LATENCY_CONDITION: "a + b + c + d + e + f < 0"

// `jet debug`'s prompt, which ends each of its answers.
LATENCY_PROMPT: "(Jet) "

// The longest a debugger session may take before it is stopped.
LATENCY_SESSION_SECONDS: 1800

usage: fn() -[IO]> Int Never! {
    term.eprint("usage: jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R] [--bar MS] [--stop entry|nested]")
    2
}

// The package the program builds in: it only prints.
LATENCY_PACKAGE: "name: \"debug_latency\"\nversion: \"0.1.0\"\nauthority: {{ allow: [IO] }}\n"

// The image, relative to the work directory every command runs in.
LATENCY_IMAGE: "out/prog"

// The program: N functions of five lines each (the last one blank), then
// `run`, which calls each in turn, then the tail (latency_run_tail).
latency_program: fn(functions: Int) -> String Never! {
    ^lines: latency_functions(functions)
    lines.push("run: fn() {{")
    lines.push("    ^total: 0")
    loop index in 0..<functions -> lines.push("    total = f_{index}(total)")
    lines.extend(latency_run_tail())
    lines.join("\n")
}

// The end of `run`, after its calls: `tally` LATENCY_HITS times, then the
// print; then `tally`, whose six locals the condition reads.
latency_run_tail: fn() -> [String] Never! {
    [String]{
        "    loop k in 0..<{LATENCY_HITS} -> total = (total + tally(k)) % 1000",
        "    print(\"{{total}}\")",
        "}}",
        "",
        "tally: fn(n: Int) -> Int {{",
        "    a: n + 1",
        "    b: n + 2",
        "    c: n + 3",
        "    d: n + 4",
        "    e: n + 5",
        "    f: n + 6",
        LATENCY_TALLY_SUM,
        "}}",
        "",
    }
}

// The line of `tally`'s last line in the entry `program`.
latency_tally_line: fn(program: String) -> Int Never! {
    loop (index, line) in program.split("\n").to_list() {
        if line == LATENCY_TALLY_SUM -> return index + 1
    }
    0
}

// The N functions, five lines each (the last one blank).
latency_functions: fn(functions: Int) -> [String] Never! {
    ^lines: [String]{}
    loop index in 0..<functions {
        lines.push("f_{index}: fn(x: Int) -> Int {{")
        lines.push("    y: x + {index}")
        lines.push("    y % 1000")
        lines.push("}}")
        lines.push("")
    }
    lines
}

// `--stop nested`'s entry: `run` calls `outer` (latency_nested_lib), then
// each of the N functions in turn, then the tail (latency_run_tail).
latency_nested_program: fn(functions: Int) -> String Never! {
    ^lines: [String]{"run: fn() {{", "    ^total: 0", "    total = outer(total)"}
    loop index in 0..<functions -> lines.push("    total = f_{index}(total)")
    lines.extend(latency_run_tail())
    lines.join("\n")
}

// `--stop nested`'s second source, lib.jet: the N functions, then `outer`,
// which calls `inner`, whose `total` is its own local; the stop is
// `inner`'s first call.
latency_nested_lib: fn(functions: Int) -> String Never! {
    ^lines: latency_functions(functions)
    lines.push("outer: fn(x: Int) -> Int {{")
    lines.push("    inner(x + 1)")
    lines.push("}}")
    lines.push("")
    lines.push("inner: fn(x: Int) -> Int {{")
    lines.push("    ^total: x + 2")
    lines.push("    total = f_2(total)")
    lines.push("    total = f_3(total)")
    lines.push("    total")
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

// The entry source, prog.jet.
latency_entry: fn(options: LatencyOptions) -> String Never! {
    if options.nested -> latency_nested_program(options.functions) else -> latency_program(options.functions)
}

// The lines of the program's sources.
latency_source_lines: fn(options: LatencyOptions) -> Int Never! {
    lines: latency_entry(options).split("\n").to_list().len() - 1
    if !options.nested -> return lines
    lines + latency_nested_lib(options.functions).split("\n").to_list().len() - 1
}

// The source the stop is in: prog.jet, or lib.jet with `--stop nested`.
latency_break_file: fn(nested: Bool{false}) -> String Never! {
    if nested -> "lib.jet" else -> "prog.jet"
}

// The line of the stop: the first call in `run` (latency_program), or with
// `nested` the first call in `inner` (latency_nested_lib).
latency_break_line: fn(functions: Int, nested: Bool{false}) -> Int Never! {
    if nested -> 5 * functions + 7 else -> 5 * functions + 3
}

// The middle of `values` in order.
latency_median: fn(values: [Int]) -> Int Never! {
    if values.len() == 0 -> return 0
    ^sorted: values.copy()
    sorted.sort()
    sorted[sorted.len() /% 2]
}

// The milliseconds `argv` takes, run in `work` with `input` as its whole
// stdin, or the reason it failed. Its output must hold `stopped`, the
// debugger's report of the breakpoint stop, so a run that never stopped is
// never timed.
latency_time: fn(argv: [String], work: String, input: String, stopped: String) -[Exec, Time, Time.Wait]> Int Err! {
    watch: time.start()
    child: process.cmd(argv).cwd(work).stdin(.Stream).stdout(.Capture).stderr(.Capture).spawn() ?? return Err("{argv[0]} did not start: {err}")
    child.stdin.write(input) ?? return Err("{argv[0]} took no input: {err}")
    child.stdin.close()
    receipt: child.wait() ?? return Err("{argv[0]} did not finish: {err}")
    elapsed: time.elapsed(watch).ns /% 1000000
    if !receipt.success {
        return Err("`{argv.join(" ")}` failed with {receipt.code}: {receipt.errors}")
    }
    if !receipt.output.contains(stopped) {
        return Err("`{argv.join(" ")}` never printed `{stopped}`: {receipt.output}")
    }
    Ok(elapsed)
}

// The median of `runs` timings of `argv`.
latency_median_time: fn(argv: [String], work: String, input: String, stopped: String, runs: Int) -[Exec, Time, Time.Wait]> Int Err! {
    ^times: [Int]{}
    loop _ in 0..<runs -> times.push(latency_time(argv, work, input, stopped) ?? return Err(err))
    Ok(latency_median(times))
}

// The first line `tool --version` prints, or the reason it printed none.
latency_version: fn(tool: String) -[Exec, Time.Wait]> String Err! {
    receipt: process.cmd([String]{tool, "--version"}).stdout(.Capture).stderr(.Capture).run() ?? return Err("{tool} did not start: {err}")
    if !receipt.success {
        return Err("`{tool} --version` failed with {receipt.code}: {receipt.errors}")
    }
    Ok(receipt.output.trim().split("\n").to_list()[0])
}

// The build that writes the image: `jet debug`'s own O0 build.
latency_build_argv: fn(jet: String) -> [String] Never! {
    [String]{jet, "build", "-O0", "--output-dir=out", "prog.jet"}
}

// `jet debug` on the built image, stopping at `line` of `file`.
latency_debug_argv: fn(jet: String, file: String, line: Int) -> [String] Never! {
    [String]{jet, "debug", "--break", "{file}:{line}", LATENCY_IMAGE}
}

// The LLDB argv that stops at `line` of `file` in the image and continues
// to the program's end.
latency_lldb_argv: fn(lldb: String, file: String, line: Int) -> [String] Never! {
    [String]{lldb, "-b", "-o", "breakpoint set --file {file} --line {line}", "-o", "run", "-o", "continue", LATENCY_IMAGE}
}

// `argv` as a shell would take it: a word with a space in single quotes.
latency_command_text: fn(argv: [String]) -> String Never! {
    words: loop word in argv -> if word.contains(" ") -> "'{word}'" else -> word.copy()
    words.join(" ")
}

// Whether `text`, a debugger's output since a command was sent, holds the
// whole answer `until` names.
latency_answered: fn(text: String, until: LatencyUntil) -> Bool Never! {
    parts: text.split(until.marker).to_list()
    if parts.len() <= until.count -> return false
    !until.line || parts[parts.len() - 1].contains("\n")
}

// Sends `command` (none when empty) to the debugger `child` and reads its
// output until the answer `until` names has arrived: the answer, and the
// microseconds from the send to its last byte.
latency_ask: fn(child: ProcessChild, command: String, until: LatencyUntil) -[Exec, Time]> LatencyAnswer Err! {
    watch: time.start()
    if command != "" {
        child.stdin.write(command) ?? return Err("couldn't send `{command.trim()}`: {err}")
    }
    ^bytes: [U8]{}
    loop {
        us: time.elapsed(watch).ns /% 1000
        // A read may end inside a UTF-8 sequence; the next completes it.
        text: String.from_bytes(bytes) ?? ""
        if latency_answered(text, until) -> return Ok(LatencyAnswer{text: text, us: us})
        if until.refused != "" && text.contains(until.refused) && text.after(until.refused).contains("\n") {
            return Err("`{command.trim()}` was refused: {text.trim()}")
        }
        chunk: child.stdout.read_bytes(65536) ?? return Err("couldn't read the answer to `{command.trim()}`: {err}")
        if chunk.len() == 0 {
            return Err("the debugger ended before it answered `{command.trim()}`: {text.trim()}")
        }
        bytes.extend(chunk)
    }
}

// `jet debug`'s answer to `command`: `count` prompts, holding `expect`, and
// no expression it couldn't evaluate.
latency_jet_ask: fn(child: ProcessChild, command: String, expect: String, count: Int) -[Exec, Time]> LatencyAnswer Err! {
    answer: latency_ask(child, command, LatencyUntil{marker: LATENCY_PROMPT, count: count, line: false, refused: ""}) ?? return Err(err)
    if !answer.text.contains(expect) || answer.text.contains("Can't evaluate") {
        return Err("`jet debug` answered `{command.trim()}` without `{expect}`: {answer.text.trim()}")
    }
    Ok(answer)
}

// LLDB's answer to `command`: a line holding `marker`, `count` times.
latency_lldb_ask: fn(child: ProcessChild, command: String, marker: String, count: Int) -[Exec, Time]> LatencyAnswer Err! {
    latency_ask(child, command, LatencyUntil{marker: marker, count: count, line: true, refused: "error: "})
}

// The process under the debugger `pid` (its child, or a child's child)
// running the image, if there is one.
latency_target_pid: fn(pid: Int) -[FS]> Int? Never! {
    ^pending: [Int]{pid}
    ^at: 0
    loop at < pending.len() {
        current: pending[at]
        at += 1
        executable: files.read_link("/proc/{current}/exe") ?? ""
        if current != pid && executable.ends_with("/{LATENCY_IMAGE}") -> return Val(current)
        threads: files.list_dir("/proc/{current}/task") ?? next
        loop thread in threads {
            children: files.read(files.join(thread.path, "children")) ?? next
            loop word in children.trim().split(" ") {
                found: Int.parse(word) ?? next
                pending.push(found)
            }
        }
    }
    None
}

// The KiB a /proc `text` gives on its line starting `field`; 0 without one.
latency_kib: fn(text: String, field: String) -> Int Never! {
    loop row in text.split("\n") {
        if row.starts_with(field) -> return Int.parse(row.after(field).trim().before(" ")) ?? 0
    }
    0
}

// The program under the debugger `pid`, now (LatencyTarget).
latency_target: fn(pid: Int) -[FS]> LatencyTarget Err! {
    target: latency_target_pid(pid) ?? return Err("no process under the debugger runs {LATENCY_IMAGE}")
    status: files.read("/proc/{target}/status") ?? return Err("couldn't read the program's status: {err}")
    rollup: files.read("/proc/{target}/smaps_rollup") ?? return Err("couldn't read the program's memory: {err}")
    averages: (files.read("/proc/loadavg") ?? return Err("couldn't read the load: {err}")).split(" ").to_list()
    if averages.len() < 3 -> return Err("the load has no three averages")
    Ok(LatencyTarget{resident_kib: latency_kib(status, "VmRSS:"), huge_kib: latency_kib(rollup, "AnonHugePages:"), load: "{averages[0]} {averages[1]} {averages[2]}"})
}

// `argv`, a debugger, started on stdin and stdout streams in `work`, its
// errors on the same stream.
latency_spawn: fn(argv: [String], work: String) -[Exec]> ProcessChild Err! {
    spec: process.cmd(argv).cwd(work).stdin(.Stream).stdout(.Stream).stderr(.Stdout).timeout(time.duration_seconds(LATENCY_SESSION_SECONDS))
    spec.spawn() ?? return Err("{argv[0]} did not start: {err}")
}

// Stops the session `child` that failed.
latency_stop: fn(child: ProcessChild) -[Exec, Time.Wait]> Never! {
    child.kill().drop("the debugger may have exited already")
    child.wait().drop("the debugger is stopped either way")
}

// Ends the session `child` once its program has finished: its input
// closed, then its exit.
latency_end: fn(child: ProcessChild) -[Exec, Time.Wait]> Err! {
    child.stdin.close()
    receipt: child.wait() ?? return Err("the debugger did not finish: {err}")
    if !receipt.success -> return Err("the debugger failed with {receipt.code}")
    Ok()
}

// One `jet debug` session's samples (see the header).
latency_jet_session: fn(options: LatencyOptions, work: String, tally: Int) -[Exec, FS, Time, Time.Wait]> LatencyTimes Err! {
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    child: latency_spawn(latency_debug_argv(options.jet, file, line), work) ?? return Err(err)
    timed: latency_jet_drive(child, options.steps, file, line, tally) ?? {
        latency_stop(child)
        return Err(err)
    }
    latency_end(child) ?? return Err(err)
    Ok(timed)
}

latency_jet_drive: fn(child: ProcessChild, steps: Int, file: String, line: Int, tally: Int) -[Exec, FS, Time]> LatencyTimes Err! {
    ^samples: [LatencySample]{}
    _: latency_jet_ask(child, "", "Breakpoint hit  {file}:{line}", 1) ?? return Err(err)
    place: latency_jet_ask(child, "print total\n", "total = ", 1) ?? return Err(err)
    samples.push(LatencySample{measure: "print_place", us: place.us})
    first: latency_jet_ask(child, "print {LATENCY_CALL}\n", "{LATENCY_CALL} = ", 1) ?? return Err(err)
    samples.push(LatencySample{measure: "print_first", us: first.us})
    second: latency_jet_ask(child, "print {LATENCY_SECOND}\n", "{LATENCY_SECOND} = ", 1) ?? return Err(err)
    samples.push(LatencySample{measure: "second_eval", us: second.us})
    loop step in 0..<steps {
        stepped: latency_jet_ask(child, "n\n", "", 1) ?? return Err(err)
        samples.push(LatencySample{measure: "per_step", us: stepped.us})
        if step == 0 {
            again: latency_jet_ask(child, "print {LATENCY_CALL}\n", "{LATENCY_CALL} = ", 1) ?? return Err(err)
            samples.push(LatencySample{measure: "print_again", us: again.us})
        }
    }
    watches: latency_watches()
    prints: loop watch in watches -> "print {watch}\n"
    loop _ in 0..<steps {
        watched: latency_jet_ask(child, "n\n{prints.join("")}", "{watches[watches.len() - 1]} = ", watches.len() + 1) ?? return Err(err)
        samples.push(LatencySample{measure: "watch_per_stop", us: watched.us})
    }
    _: latency_jet_ask(child, "break prog.jet:{tally} if {LATENCY_CONDITION}\n", "The condition runs in the program", 1) ?? return Err(err)
    target: latency_target(child.id()) ?? return Err(err)
    // A stop before the end (the condition failed) ends the measure.
    hits: latency_ask(child, "c\n", LatencyUntil{marker: "Program finished", count: 1, line: true, refused: "Breakpoint hit"}) ?? return Err(err)
    samples.push(LatencySample{measure: "condition_per_hit", us: hits.us /% LATENCY_HITS})
    Ok(LatencyTimes{samples: samples, target: Val(target)})
}

// One LLDB session's samples, the same commands as latency_jet_drive's.
latency_lldb_session: fn(lldb: String, options: LatencyOptions, work: String, tally: Int) -[Exec, FS, Time, Time.Wait]> LatencyTimes Err! {
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    child: latency_spawn([String]{lldb, LATENCY_IMAGE}, work) ?? return Err(err)
    timed: latency_lldb_drive(child, options.steps, file, line, tally) ?? {
        latency_stop(child)
        return Err(err)
    }
    latency_end(child) ?? return Err(err)
    Ok(timed)
}

latency_lldb_drive: fn(child: ProcessChild, steps: Int, file: String, line: Int, tally: Int) -[Exec, FS, Time]> LatencyTimes Err! {
    ^samples: [LatencySample]{}
    // Each `expr` answers `(type) $N = value`.
    value: ") $"
    _: latency_lldb_ask(child, "breakpoint set --file {file} --line {line}\n", "Breakpoint 1: ", 1) ?? return Err(err)
    // The program runs with its stdio on /dev/null and no terminal of its
    // own (`--no-stdio`). Given one, LLDB forwards its own stdin to the
    // program while the program runs, a byte at a time, and under load it
    // was still reading when the next command came: it took that
    // command's first bytes (`(lldb) ext` for `next`) or all of it.
    _: latency_lldb_ask(child, "process launch --no-stdio\n", "stop reason = breakpoint", 1) ?? return Err(err)
    place: latency_lldb_ask(child, "frame variable total\n", "total = ", 1) ?? return Err(err)
    samples.push(LatencySample{measure: "print_place", us: place.us})
    first: latency_lldb_ask(child, "expr -- {LATENCY_LLDB_CALL}\n", value, 1) ?? return Err(err)
    samples.push(LatencySample{measure: "print_first", us: first.us})
    second: latency_lldb_ask(child, "expr -- {LATENCY_SECOND}\n", value, 1) ?? return Err(err)
    samples.push(LatencySample{measure: "second_eval", us: second.us})
    loop step in 0..<steps {
        stepped: latency_lldb_ask(child, "next\n", "stop reason = ", 1) ?? return Err(err)
        samples.push(LatencySample{measure: "per_step", us: stepped.us})
        if step == 0 {
            again: latency_lldb_ask(child, "expr -- {LATENCY_LLDB_CALL}\n", value, 1) ?? return Err(err)
            samples.push(LatencySample{measure: "print_again", us: again.us})
        }
    }
    watches: latency_watches()
    loop watch in watches {
        _: latency_lldb_ask(child, "target stop-hook add -o 'expr -- {latency_lldb_expression(watch)}'\n", " added.", 1) ?? return Err(err)
    }
    loop _ in 0..<steps {
        // The hooks answer before the stop's report.
        watched: latency_lldb_ask(child, "next\n", "stop reason = ", 1) ?? return Err(err)
        if watched.text.split(value).to_list().len() <= watches.len() {
            return Err("a step's stop hooks gave fewer than {watches.len()} values: {watched.text.trim()}")
        }
        samples.push(LatencySample{measure: "watch_per_stop", us: watched.us})
    }
    _: latency_lldb_ask(child, "breakpoint set --file prog.jet --line {tally}\n", "Breakpoint 2: ", 1) ?? return Err(err)
    // `breakpoint modify` prints nothing; the listing after it shows the
    // condition taken.
    _: latency_lldb_ask(child, "breakpoint modify -c '{LATENCY_CONDITION}' 2\nbreakpoint list 2\n", "Condition: {LATENCY_CONDITION}", 1) ?? return Err(err)
    target: latency_target(child.id()) ?? return Err(err)
    // A stop before the exit (the condition failed) ends the measure.
    hits: latency_ask(child, "continue\n", LatencyUntil{marker: "exited with status", count: 1, line: true, refused: "stop reason = "}) ?? return Err(err)
    samples.push(LatencySample{measure: "condition_per_hit", us: hits.us /% LATENCY_HITS})
    Ok(LatencyTimes{samples: samples, target: Val(target)})
}

// The microseconds of `measure`'s samples.
latency_samples: fn(samples: [LatencySample], measure: String) -> [Int] Never! {
    ^picked: [Int]{}
    loop sample in samples {
        if sample.measure == measure -> picked.push(sample.us)
    }
    picked
}

// A row per measure, in the order `jet` first took them, each the median
// of its samples.
latency_medians: fn(jet: [LatencySample], lldb: [LatencySample]) -> [LatencyRow] Never! {
    ^rows: [LatencyRow]{}
    loop sample in jet {
        seen: loop row in rows {
            if row.measure == sample.measure {
                break true
            }
        } ?? false
        if seen -> next
        lldb_us: latency_samples(lldb, sample.measure)
        lldb_median: if lldb_us.len() > 0 -> Val(latency_median(lldb_us)) else -> None
        rows.push(LatencyRow{measure: "{sample.measure}", jet: latency_median(latency_samples(jet, sample.measure)), lldb: lldb_median})
    }
    rows
}

latency_measure: fn(options: LatencyOptions, work: String) -[Exec, FS, Time, Time.Wait]> LatencyRuns Err! {
    files.write(files.join(work, "package.jet"), LATENCY_PACKAGE) ?? return Err("couldn't write the package: {err}")
    entry: latency_entry(options)
    files.write(files.join(work, "prog.jet"), entry) ?? return Err("couldn't write the program: {err}")
    if options.nested {
        files.write(files.join(work, "lib.jet"), latency_nested_lib(options.functions)) ?? return Err("couldn't write the program's lib.jet: {err}")
    }
    build: latency_build_argv(options.jet)
    // The first build writes the image both debuggers drive and fills the
    // build cache; the timed ones are warm.
    _: latency_time(build, work, "", "") ?? return Err(err)
    image: files.read_bytes(files.join(work, LATENCY_IMAGE)) ?? return Err("couldn't read the image: {err}")
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    tally: latency_tally_line(entry)
    debug: latency_debug_argv(options.jet, file, line)
    ^jet_samples: [LatencySample]{}
    ^jet_target: LatencyTarget?{None}
    loop _ in 0..<options.runs {
        timed: latency_jet_session(options, work, tally) ?? return Err("a jet debug session: {err.message}")
        jet_samples.extend(timed.samples)
        jet_target = timed.target
    }
    ^lldb: LatencyLldb?{None}
    ^lldb_samples: [LatencySample]{}
    ^lldb_target: LatencyTarget?{None}
    if options.lldb == .Val(tool) {
        timed: LatencyLldb{
            version: latency_version(tool) ?? return Err(err),
            stop: latency_median_time(latency_lldb_argv(tool, file, line), work, "", "stop reason = breakpoint", options.runs) ?? return Err(err),
        }
        lldb = Val(timed)
        loop _ in 0..<options.runs {
            session: latency_lldb_session(tool, options, work, tally) ?? return Err("an lldb session: {err.message}")
            lldb_samples.extend(session.samples)
            lldb_target = session.target
        }
    }
    Ok(
        LatencyRuns{
            image_sha256: crypto.sha256(image).hex(),
            jet_version: latency_version(options.jet) ?? return Err(err),
            build: latency_median_time(build, work, "", "", options.runs) ?? return Err(err),
            debug_stop: latency_median_time(debug, work, "", "Breakpoint hit  {file}:{line}", options.runs) ?? return Err(err),
            lldb: lldb,
            rows: latency_medians(jet_samples, lldb_samples),
            jet_target: jet_target,
            lldb_target: lldb_target,
        },
    )
}

// `us` microseconds as milliseconds, to a tenth.
latency_ms: fn(us: Int) -> String Never! { "{us /% 1000}.{(us % 1000) /% 100}" }

// The program condition_per_hit ran under `debugger`.
latency_target_text: fn(debugger: String, target: LatencyTarget) -> String Never! {
    "# condition_per_hit under {debugger}: the program resident {target.resident_kib} KiB, {target.huge_kib} KiB of it in huge pages; load {target.load}"
}

// The report: the image, the tools and the commands, then the rows, then
// the bars' verdicts. LLDB's column is `-` when LLDB was not timed.
latency_rows: fn(options: LatencyOptions, runs: LatencyRuns) -> [String] Never! {
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    ^rows: [String]{
        "# image {LATENCY_IMAGE} sha256 {runs.image_sha256}",
        "# jet {runs.jet_version}",
    }
    ^lldb_line: "# lldb not timed: none on PATH and no `--lldb`"
    ^lldb_stop: "-"
    if runs.lldb == .Val(lldb) {
        lldb_line = "# lldb {lldb.version}"
        lldb_stop = "{lldb.stop}"
    }
    rows.push(lldb_line)
    rows.push("# build: {latency_command_text(latency_build_argv(options.jet))}")
    rows.push("# jet_debug first_stop: {latency_command_text(latency_debug_argv(options.jet, file, line))} < /dev/null")
    rows.push("# jet_debug session: {latency_command_text(latency_debug_argv(options.jet, file, line))}, one command at a time")
    if options.lldb == .Val(tool) {
        rows.push("# lldb first_stop: {latency_command_text(latency_lldb_argv(tool, file, line))}")
        rows.push("# lldb session: {latency_command_text([String]{tool, LATENCY_IMAGE})}, one command at a time")
    }
    stop: if options.nested -> ", the stop two calls deep in lib.jet" else -> ""
    rows.push("# {options.functions} functions, {latency_source_lines(options)} lines{stop}, {options.steps} steps, {LATENCY_HITS} hits, {options.runs} runs, milliseconds: build and first_stop the median run, the rest the median sample")
    rows.push("measure\tjet_debug\tlldb")
    rows.push("build\t{runs.build}\t-")
    rows.push("first_stop\t{runs.debug_stop}\t{lldb_stop}")
    loop row in runs.rows {
        lldb_ms: if row.lldb == .Val(us) -> latency_ms(us) else -> "-"
        rows.push("{row.measure}\t{latency_ms(row.jet)}\t{lldb_ms}")
    }
    if runs.jet_target == .Val(target) -> rows.push(latency_target_text("jet_debug", target))
    if runs.lldb_target == .Val(target) -> rows.push(latency_target_text("lldb", target))
    loop verdict in latency_verdicts(runs) -> rows.push(verdict)
    if options.bar == .Val(bar) {
        verdict: if latency_bar_missed(options, runs) -> "missed" else -> "met"
        rows.push("# bar: jet_debug first_stop at most {bar} ms: {verdict}")
    }
    rows
}

// The bars `jet debug` is held to, each with its verdict: every measure,
// first_stop with them, at most LLDB's on the same image and host, judged
// only when LLDB was timed.
latency_verdicts: fn(runs: LatencyRuns) -> [String] Never! {
    ^verdicts: [String]{}
    if runs.lldb == .Val(lldb) {
        verdicts.push(latency_bar("first_stop", met: runs.debug_stop <= lldb.stop))
    }
    loop row in runs.rows {
        if row.lldb == .Val(lldb_us) {
            verdicts.push(latency_bar(row.measure, met: row.jet <= lldb_us))
        }
    }
    verdicts
}

// The bar on `measure`: at most LLDB's, and whether it was `met`.
latency_bar: fn(measure: String, met: Bool{false}) -> String Never! {
    "# bar: jet_debug {measure} at most lldb's: {latency_verdict(met: met)}"
}

latency_verdict: fn(met: Bool{false}) -> String Never! { if met -> "met" else -> "missed" }

// Whether `jet debug`'s first stop took longer than the bar, if there is one.
latency_bar_missed: fn(options: LatencyOptions, runs: LatencyRuns) -> Bool Never! {
    if options.bar == .Val(bar) -> return runs.debug_stop > bar
    false
}

debug_latency: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    args: process.args()
    ^options: LatencyOptions{jet: process.which("jet") ?? "jet", lldb: process.which("lldb"), functions: 2000, steps: 20, runs: 5, bar: None}
    ^at: 0
    loop at < args.len() {
        if at + 1 >= args.len() -> return usage()
        value: args[at + 1]
        if args[at] == {
            "--jet" -> options.jet = value.copy()
            "--lldb" -> options.lldb = Val(value.copy())
            "--functions" -> options.functions = Int.parse(value) ?? return usage()
            "--steps" -> options.steps = Int.parse(value) ?? return usage()
            "--runs" -> options.runs = Int.parse(value) ?? return usage()
            "--bar" -> options.bar = Val(Int.parse(value) ?? return usage())
            "--stop" -> {
                if value != "entry" && value != "nested" -> return usage()
                options.nested = value == "nested"
            }
            else -> return usage()
        }
        at += 2
    }
    // The session takes 2K steps from the stop, every one in `run`'s calls.
    if options.functions < 1 || options.steps < 1 || 2 * options.steps >= options.functions || options.runs < 1 || (options.nested && options.functions < 4) {
        return usage()
    }
    work: files.temp_dir("jet-debug-latency") ?? {
        term.eprint("debug latency: couldn't make a work directory: {err}")
        return 1
    }
    runs: latency_measure(options, work.path) ?? {
        term.eprint("debug latency: {err.message} (the program is in {work.path})")
        return 1
    }
    files.remove_all(work.path).drop("a work directory left behind is only disk")
    loop row in latency_rows(options, runs) -> print(row)
    if latency_bar_missed(options, runs) -> return 1
    0
}

run: fn() {
    code: debug_latency()
    if code != 0 -> process.exit(code)
}

#Test("the break line is the first call in run") {
    program: latency_program(3)
    lines: program.split("\n").to_list()
    assert_eq(lines[latency_break_line(3) - 1], "    total = f_0(total)")
    assert_eq(lines[latency_break_line(3) + 1], "    total = f_2(total)")
    assert_eq(lines[0], "f_0: fn(x: Int) -> Int {{")
    assert_eq(lines[latency_break_line(3) + 2], "    loop k in 0..<1000 -> total = (total + tally(k)) % 1000")
    assert_eq(lines[latency_break_line(3) + 4], "}}")
}

#Test("the condition's breakpoint is tally's last line, after its six locals") {
    program: latency_program(3)
    lines: program.split("\n").to_list()
    line: latency_tally_line(program)
    assert_eq(lines[line - 1], LATENCY_TALLY_SUM)
    assert_eq(lines[line - 2], "    f: n + 6")
    assert_eq(lines[line - 8], "tally: fn(n: Int) -> Int {{")
    assert_eq(latency_tally_line(latency_nested_program(4)), 4 + 15)
    assert_eq(latency_source_lines(LatencyOptions{jet: "jet", lldb: None, functions: 10, steps: 4, runs: 1, bar: None}), 75)
}

#Test("a nested stop is inner's first call, two calls deep in lib.jet") {
    lib: latency_nested_lib(4).split("\n").to_list()
    line: latency_break_line(4, nested: true)
    assert_eq(lib[line - 1], "    total = f_2(total)")
    assert_eq(lib[line - 3], "inner: fn(x: Int) -> Int {{")
    assert_eq(lib[line - 6], "    inner(x + 1)")
    assert_eq(latency_source_lines(LatencyOptions{jet: "jet", lldb: None, functions: 4, steps: 1, runs: 1, bar: None, nested: true}), 6 * 4 + 26)
    assert_eq(latency_nested_program(4).split("\n").to_list()[2], "    total = outer(total)")
    assert_eq(latency_break_file(nested: true), "lib.jet")
}

#Test("the package allows only printing") {
    assert_eq(LATENCY_PACKAGE.split("\n").to_list()[2], "authority: {{ allow: [IO] }}")
}

#Test("both debuggers drive the one built image") {
    assert_eq(latency_debug_argv("jet", "prog.jet", 13), [String]{"jet", "debug", "--break", "prog.jet:13", "out/prog"})
    lldb: latency_lldb_argv("lldb", "lib.jet", 13)
    assert_eq(lldb[3], "breakpoint set --file lib.jet --line 13")
    assert_eq(lldb[lldb.len() - 1], "out/prog")
    assert_eq(latency_build_argv("jet"), [String]{"jet", "build", "-O0", "--output-dir=out", "prog.jet"})
}

#Test("an answer ends at its marker's count, and at a line end when asked") {
    prompt: LatencyUntil{marker: LATENCY_PROMPT, count: 2, line: false, refused: ""}
    assert(!latency_answered("n\n12 | x\n(Jet) print total\n", prompt))
    assert(latency_answered("n\n12 | x\n(Jet) print total\ntotal = 3\n(Jet) ", prompt))
    value: LatencyUntil{marker: ") $", count: 1, line: true, refused: "error: "}
    assert(!latency_answered("(lldb) expr -- total\n(Int) $0 = ", value))
    assert(latency_answered("(lldb) expr -- total\n(Int) $0 = 3\n", value))
}

#Test("lldb calls the function cast to its type, and the other watches as they are") {
    watches: latency_watches()
    assert_eq(watches.len(), 5)
    assert_eq(latency_lldb_expression(watches[0]), "total")
    assert_eq(latency_lldb_expression(watches[watches.len() - 1]), "((long (*)(long))f_1)(total)")
    assert_eq(latency_kib("Name:\tprog\nVmRSS:\t   1532 kB\n", "VmRSS:"), 1532)
    assert_eq(latency_kib("Rss: 1 kB\n", "AnonHugePages:"), 0)
}

#Test("the rows are each measure's median sample, against lldb's") {
    jet: [LatencySample]{
        LatencySample{measure: "print_place", us: 300},
        LatencySample{measure: "per_step", us: 900},
        LatencySample{measure: "per_step", us: 700},
        LatencySample{measure: "per_step", us: 800},
    }
    lldb: [LatencySample]{LatencySample{measure: "per_step", us: 2000}}
    rows: latency_medians(jet, lldb)
    assert_eq(rows.len(), 2)
    assert_eq(rows[0].lldb, None)
    assert_eq(rows[1].jet, 800)
    assert_eq(rows[1].lldb, Val(2000))
    assert_eq(latency_ms(12345), "12.3")
    assert_eq(latency_ms(80), "0.0")
}

#Test("the report names the image, the tools and the commands, then the rows and the bars") {
    options: LatencyOptions{jet: "jet", lldb: Val("lldb"), functions: 10, steps: 4, runs: 1, bar: None}
    lldb: LatencyLldb{version: "lldb version 21", stop: 400}
    measured: [LatencyRow]{
        LatencyRow{measure: "print_place", jet: 15000, lldb: Val(4000)},
        LatencyRow{measure: "print_first", jet: 300000, lldb: Val(16000)},
        LatencyRow{measure: "second_eval", jet: 40000, lldb: Val(5000)},
        LatencyRow{measure: "per_step", jet: 1200, lldb: Val(2500)},
        LatencyRow{measure: "watch_per_stop", jet: 9000, lldb: Val(5000)},
        LatencyRow{measure: "condition_per_hit", jet: 2400, lldb: Val(300)},
    }
    target: LatencyTarget{resident_kib: 1532, huge_kib: 0, load: "1.00 2.00 3.00"}
    rows: latency_rows(options, LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 900, lldb: Val(lldb), rows: measured, jet_target: Val(target)})
    text: rows.join("\n")
    assert_eq(rows[0], "# image out/prog sha256 ab12")
    assert_eq(rows[4], "# jet_debug first_stop: jet debug --break prog.jet:53 out/prog < /dev/null")
    assert_eq(rows[6], "# lldb first_stop: lldb -b -o 'breakpoint set --file prog.jet --line 53' -o run -o continue out/prog")
    assert_eq(rows[8], "# 10 functions, 75 lines, 4 steps, 1000 hits, 1 runs, milliseconds: build and first_stop the median run, the rest the median sample")
    assert_eq(rows[11], "first_stop\t900\t400")
    assert(text.contains("print_place\t15.0\t4.0\n"), text)
    assert(text.contains("condition_per_hit\t2.4\t0.3\n"), text)
    assert(text.contains("# condition_per_hit under jet_debug: the program resident 1532 KiB, 0 KiB of it in huge pages; load 1.00 2.00 3.00"), text)
    assert(text.contains("# bar: jet_debug first_stop at most lldb's: missed"), text)
    assert(text.contains("# bar: jet_debug per_step at most lldb's: met"), text)
    assert(text.contains("# bar: jet_debug print_place at most lldb's: missed"), text)
    assert(text.contains("# bar: jet_debug print_first at most lldb's: missed"), text)
    assert(text.contains("# bar: jet_debug second_eval at most lldb's: missed"), text)
    assert(text.contains("# bar: jet_debug watch_per_stop at most lldb's: missed"), text)
    assert(text.contains("# bar: jet_debug condition_per_hit at most lldb's: missed"), text)
    fast: [LatencyRow]{LatencyRow{measure: "print_first", jet: 7000, lldb: Val(7400)}}
    even: latency_verdicts(LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 400, lldb: Val(lldb), rows: fast})
    assert_eq(even, [String]{"# bar: jet_debug first_stop at most lldb's: met", "# bar: jet_debug print_first at most lldb's: met"})
}

// c34: the measurement needs nothing but jet; the bar fails the run after
// the rows are printed.
#Test("without lldb only jet debug is timed, and the bar judges its first stop") {
    options: LatencyOptions{jet: "jet", lldb: None, functions: 10, steps: 4, runs: 1, bar: Val(200)}
    measured: [LatencyRow]{LatencyRow{measure: "per_step", jet: 1000, lldb: None}}
    runs: LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 60, lldb: None, rows: measured}
    rows: latency_rows(options, runs)
    assert_eq(rows[2], "# lldb not timed: none on PATH and no `--lldb`")
    assert(!rows.join("\n").contains("# lldb first_stop"), rows.join("\n"))
    assert_eq(rows[rows.len() - 3], "first_stop\t60\t-")
    assert_eq(rows[rows.len() - 2], "per_step\t1.0\t-")
    assert_eq(rows[rows.len() - 1], "# bar: jet_debug first_stop at most 200 ms: met")
    assert(!latency_bar_missed(options, runs))
    slow: LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 201, lldb: None}
    assert(latency_bar_missed(options, slow))
    assert_eq(latency_rows(options, slow)[latency_rows(options, slow).len() - 1], "# bar: jet_debug first_stop at most 200 ms: missed")
}
