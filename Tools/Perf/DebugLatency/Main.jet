#!/usr/bin/env jet
// Debugger latency: the time `jet debug` takes to its first stop and per
// step, against LLDB driving the same O0 image the same way.
// Usage (from the repository root):
//   jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R]
// Defaults: the `jet` and `lldb` on PATH, 2000 functions, 20 steps, 5 runs.
//
// It writes a package whose program has N small functions, and whose `run`
// calls each in turn one line at a time, to a temporary directory, and
// builds its O0 image once the way `jet debug` does (`jet build -O0
// --output-dir`). Both debuggers then drive that one image, and it times,
// each the median of R runs:
//   - build: that build again, warm;
//   - jet debug, first stop: `jet debug --break prog.jet:L out/prog` with
//     an empty stdin, which continues from the first stop to the program's
//     end (its last N - K calls are cheap), from the start to its exit;
//   - jet debug, per step: the same with K `n` lines first; the extra time
//     over the first stop, per step;
//   - lldb, first stop: `lldb -b` on the image with `breakpoint set`, `run`
//     and `continue`;
//   - lldb, per step: the same with K `next` commands before `continue`.
// L is the line of the first call in `run`. A debugger run whose output
// does not report the breakpoint stop fails the measurement. It prints the
// image's SHA-256, both tools' versions and the exact commands as `#`
// lines, then one tab-separated row per measure in milliseconds.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    term: core.term
    time: core.time
}

LatencyOptions: struct {
    jet: String,
    lldb: String,
    functions: Int,
    steps: Int,
    runs: Int,
}

LatencyRuns: struct {
    image_sha256: String,
    jet_version: String,
    lldb_version: String,
    build: Int,
    debug_stop: Int,
    debug_steps: Int,
    lldb_stop: Int,
    lldb_steps: Int,
}

usage: fn() -[IO]> Int Never! {
    term.eprint("usage: jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R]")
    2
}

// The package the program builds in: it only prints.
LATENCY_PACKAGE: "name: \"debug_latency\"\nversion: \"0.1.0\"\nauthority: {{ allow: [IO] }}\n"

// The image, relative to the work directory every command runs in.
LATENCY_IMAGE: "out/prog"

// The program: N functions of five lines each (the last one blank), then
// `run`, which calls each in turn.
latency_program: fn(functions: Int) -> String Never! {
    lines := [String]{}
    loop index in 0..<functions {
        lines.push("f_{index}: fn(x: Int) -> Int {{")
        lines.push("    y: x + {index}")
        lines.push("    y % 1000")
        lines.push("}}")
        lines.push("")
    }
    lines.push("run: fn() {{")
    lines.push("    total := 0")
    loop index in 0..<functions -> lines.push("    total = f_{index}(total)")
    lines.push("    print(\"{{total}}\")")
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

// The line of the first call in `run` (latency_program).
latency_break_line: fn(functions: Int) -> Int Never! { 5 * functions + 3 }

// The middle of `values` in order.
latency_median: fn(values: [Int]) -> Int Never! {
    if values.len() == 0 -> return 0
    sorted := values.copy()
    sorted.sort()
    sorted[sorted.len() /% 2]
}

// The milliseconds `argv` takes, run in `work` with `input` as its whole
// stdin, or the reason it failed. Its output must hold `stopped`, the
// debugger's report of the breakpoint stop, so a run that never stopped is
// never timed.
latency_time: fn(argv: [String], work: String, input: String, stopped: String) -[Exec, Time, Time.Wait]> Int Err! {
    watch: time.start()
    child: process.cmd(argv).cwd(work).stdin(.Stream).stdout(.Capture).stderr(.Capture).spawn() ?? return Err("{argv[0]} did not start: {err}")
    child.stdin.write(input) ?? return Err("{argv[0]} took no input: {err}")
    child.stdin.close()
    receipt: child.wait() ?? return Err("{argv[0]} did not finish: {err}")
    elapsed: time.elapsed(watch).ns /% 1000000
    if !receipt.success {
        return Err("`{argv.join(" ")}` failed with {receipt.code}: {receipt.errors}")
    }
    if !receipt.output.contains(stopped) {
        return Err("`{argv.join(" ")}` never printed `{stopped}`: {receipt.output}")
    }
    Ok(elapsed)
}

// The median of `runs` timings of `argv`.
latency_median_time: fn(argv: [String], work: String, input: String, stopped: String, runs: Int) -[Exec, Time, Time.Wait]> Int Err! {
    times := [Int]{}
    loop _ in 0..<runs -> times.push(latency_time(argv, work, input, stopped) ?? return Err(err))
    Ok(latency_median(times))
}

// The first line `tool --version` prints, or the reason it printed none.
latency_version: fn(tool: String) -[Exec, Time.Wait]> String Err! {
    receipt: process.cmd([String]{tool, "--version"}).stdout(.Capture).stderr(.Capture).run() ?? return Err("{tool} did not start: {err}")
    if !receipt.success {
        return Err("`{tool} --version` failed with {receipt.code}: {receipt.errors}")
    }
    Ok(receipt.output.trim().split("\n").to_list()[0])
}

// The build that writes the image: `jet debug`'s own O0 build.
latency_build_argv: fn(jet: String) -> [String] Never! {
    [String]{jet, "build", "-O0", "--output-dir=out", "prog.jet"}
}

// `jet debug` on the built image, stopping at `line` of prog.jet. Its stdin
// holds the steps.
latency_debug_argv: fn(jet: String, line: Int) -> [String] Never! {
    [String]{jet, "debug", "--break", "prog.jet:{line}", LATENCY_IMAGE}
}

// The LLDB argv that stops at `line` of prog.jet in the image, takes `steps`
// steps over, and continues to the program's end.
latency_lldb_argv: fn(lldb: String, line: Int, steps: Int) -> [String] Never! {
    argv := [String]{lldb, "-b", "-o", "breakpoint set --file prog.jet --line {line}", "-o", "run"}
    loop _ in 0..<steps {
        argv.push("-o")
        argv.push("next")
    }
    argv.push("-o")
    argv.push("continue")
    argv.push(LATENCY_IMAGE)
    argv
}

// `argv` as a shell would take it: a word with a space in single quotes.
latency_command_text: fn(argv: [String]) -> String Never! {
    words: loop word in argv -> if word.contains(" ") -> "'{word}'" else -> word.copy()
    words.join(" ")
}

latency_measure: fn(options: LatencyOptions, work: String) -[Exec, FS, Time, Time.Wait]> LatencyRuns Err! {
    files.write(files.join(work, "package.jet"), LATENCY_PACKAGE) ?? return Err("couldn't write the package: {err}")
    files.write(files.join(work, "prog.jet"), latency_program(options.functions)) ?? return Err("couldn't write the program: {err}")
    build: latency_build_argv(options.jet)
    // The first build writes the image both debuggers drive and fills the
    // build cache; the timed ones are warm.
    _: latency_time(build, work, "", "") ?? return Err(err)
    image: files.read_bytes(files.join(work, LATENCY_IMAGE)) ?? return Err("couldn't read the image: {err}")
    line: latency_break_line(options.functions)
    debug: latency_debug_argv(options.jet, line)
    debug_stopped: "Breakpoint hit  prog.jet:{line}"
    lldb_stopped: "stop reason = breakpoint"
    nexts: "n\n".repeat(options.steps)
    Ok(
        LatencyRuns{
            image_sha256: crypto.sha256(image).hex(),
            jet_version: latency_version(options.jet) ?? return Err(err),
            lldb_version: latency_version(options.lldb) ?? return Err(err),
            build: latency_median_time(build, work, "", "", options.runs) ?? return Err(err),
            debug_stop: latency_median_time(debug, work, "", debug_stopped, options.runs) ?? return Err(err),
            debug_steps: latency_median_time(debug, work, nexts, debug_stopped, options.runs) ?? return Err(err),
            lldb_stop: latency_median_time(latency_lldb_argv(options.lldb, line, 0), work, "", lldb_stopped, options.runs) ?? return Err(err),
            lldb_steps: latency_median_time(latency_lldb_argv(options.lldb, line, options.steps), work, "", lldb_stopped, options.runs) ?? return Err(err),
        },
    )
}

// The report: the image, the tools and the commands, then the rows. Per
// step is the extra time of K steps over the first stop, over K.
latency_rows: fn(options: LatencyOptions, runs: LatencyRuns) -> [String] Never! {
    line: latency_break_line(options.functions)
    debug_step: (runs.debug_steps - runs.debug_stop) /% options.steps
    lldb_step: (runs.lldb_steps - runs.lldb_stop) /% options.steps
    [String]{
        "# image {LATENCY_IMAGE} sha256 {runs.image_sha256}",
        "# jet {runs.jet_version}",
        "# lldb {runs.lldb_version}",
        "# build: {latency_command_text(latency_build_argv(options.jet))}",
        "# jet_debug first_stop: {latency_command_text(latency_debug_argv(options.jet, line))} < /dev/null",
        "# jet_debug per_step: the same with {options.steps} `n` lines on stdin",
        "# lldb first_stop: {latency_command_text(latency_lldb_argv(options.lldb, line, 0))}",
        "# lldb per_step: {latency_command_text(latency_lldb_argv(options.lldb, line, options.steps))}",
        "# {options.functions} functions, {options.steps} steps, median of {options.runs} runs, milliseconds",
        "measure\tjet_debug\tlldb",
        "build\t{runs.build}\t-",
        "first_stop\t{runs.debug_stop}\t{runs.lldb_stop}",
        "per_step\t{debug_step}\t{lldb_step}",
    }
}

debug_latency: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    args: process.args()
    options := LatencyOptions{jet: process.which("jet") ?? "jet", lldb: process.which("lldb") ?? "lldb", functions: 2000, steps: 20, runs: 5}
    at := 0
    loop at < args.len() {
        if at + 1 >= args.len() -> return usage()
        value: args[at + 1]
        if args[at] == {
            "--jet" -> options.jet = value.copy()
            "--lldb" -> options.lldb = value.copy()
            "--functions" -> options.functions = Int.parse(value) ?? return usage()
            "--steps" -> options.steps = Int.parse(value) ?? return usage()
            "--runs" -> options.runs = Int.parse(value) ?? return usage()
            else -> return usage()
        }
        at += 2
    }
    if options.functions < 1 || options.steps < 1 || options.steps > options.functions || options.runs < 1 {
        return usage()
    }
    work: files.temp_dir("jet-debug-latency") ?? {
        term.eprint("debug latency: couldn't make a work directory: {err}")
        return 1
    }
    runs: latency_measure(options, work.path) ?? {
        term.eprint("debug latency: {err.message} (the program is in {work.path})")
        return 1
    }
    files.remove_all(work.path).drop("a work directory left behind is only disk")
    loop row in latency_rows(options, runs) -> print(row)
    0
}

run: fn() {
    code: debug_latency()
    if code != 0 -> process.exit(code)
}

#Test("the break line is the first call in run") {
    program: latency_program(3)
    lines: program.split("\n").to_list()
    assert_eq(lines[latency_break_line(3) - 1], "    total = f_0(total)")
    assert_eq(lines[latency_break_line(3) + 1], "    total = f_2(total)")
    assert_eq(lines[0], "f_0: fn(x: Int) -> Int {{")
    assert_eq(lines[latency_break_line(3) + 3], "}}")
}

#Test("the package allows only printing") {
    assert_eq(LATENCY_PACKAGE.split("\n").to_list()[2], "authority: {{ allow: [IO] }}")
}

#Test("both debuggers drive the one built image") {
    assert_eq(latency_debug_argv("jet", 13), [String]{"jet", "debug", "--break", "prog.jet:13", "out/prog"})
    lldb: latency_lldb_argv("lldb", 13, 1)
    assert_eq(lldb[lldb.len() - 1], "out/prog")
    assert_eq(latency_build_argv("jet"), [String]{"jet", "build", "-O0", "--output-dir=out", "prog.jet"})
}

#Test("the report names the image, the tools and the commands, then the rows") {
    options: LatencyOptions{jet: "jet", lldb: "lldb", functions: 10, steps: 4, runs: 1}
    rows: latency_rows(options, LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", lldb_version: "lldb version 21", build: 300, debug_stop: 900, debug_steps: 1300, lldb_stop: 400, lldb_steps: 480})
    assert_eq(rows[0], "# image out/prog sha256 ab12")
    assert_eq(rows[4], "# jet_debug first_stop: jet debug --break prog.jet:53 out/prog < /dev/null")
    assert_eq(rows[6], "# lldb first_stop: lldb -b -o 'breakpoint set --file prog.jet --line 53' -o run -o continue out/prog")
    assert_eq(rows[11], "first_stop\t900\t400")
    assert_eq(rows[12], "per_step\t100\t20")
}
