#!/usr/bin/env jet
// Debugger latency: the time `jet debug` takes to its first stop and per
// step, against LLDB driving the same O0 image the same way.
// Usage (from the repository root):
//   jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R] [--bar MS] [--stop entry|nested]
// Defaults: the `jet` and `lldb` on PATH, 2000 functions, 20 steps, 5 runs,
// no bar. With no LLDB on PATH and no `--lldb`, only `jet debug` is timed and
// LLDB's column is `-`: the measurement needs nothing but jet.
//
// It writes a package whose program has N small functions, and whose `run`
// calls each in turn one line at a time, to a temporary directory, and
// builds its O0 image once the way `jet debug` does (`jet build -O0
// --output-dir`). Both debuggers then drive that one image, and it times,
// each the median of R runs:
//   - build: that build again, warm;
//   - jet debug, first stop: `jet debug --break prog.jet:L out/prog` with
//     an empty stdin, which continues from the first stop to the program's
//     end (its last N - K calls are cheap), from the start to its exit;
//   - jet debug, per step: the same with K `n` lines first; the extra time
//     over the first stop, per step;
//   - lldb, first stop: `lldb -b` on the image with `breakpoint set`, `run`
//     and `continue`;
//   - lldb, per step: the same with K `next` commands before `continue`;
//   - the evaluations at the stop (latency_probes), each the extra time of
//     a session with its commands over the session without them, in both
//     debuggers: print_place (`print total`), print_first (the first call
//     expression), print_again (the same call at a later stop),
//     second_eval (a second new expression at the same stop) and
//     watch_per_stop (K steps with a watch on `total`, per step; the watch
//     is deleted after the steps, so the run to the program's end that
//     follows doesn't stop at its every later write).
// L is the line of the first call in `run`. With `--stop nested` the N
// functions move to a second source of the package, lib.jet, beside
// `outer` and `inner`; `run` calls `outer` first, which calls `inner`, and
// L is `inner`'s first call: the stop is two calls deep in a function of a
// source that is not the entry (latency_nested_lib), where `total` is
// `inner`'s own local. A debugger run whose output
// does not report the breakpoint stop fails the measurement; an LLDB
// evaluation that fails leaves its column `-` with the reason. It prints the
// image's SHA-256, both tools' versions and the exact commands as `#`
// lines, then one tab-separated row per measure in milliseconds, then each
// bar's verdict (latency_verdicts). With `--bar MS` it fails, after the
// rows, when `jet debug`'s first stop took more than MS milliseconds.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    term: core.term
    time: core.time
}

LatencyOptions: struct {
    jet: String,
    lldb: String?,
    functions: Int,
    steps: Int,
    runs: Int,
    bar: Int?,
    // `--stop nested`: the stop is in lib.jet's `inner` (latency_nested_lib).
    nested: Bool{false},
}

// LLDB's version and timings, when LLDB was timed.
LatencyLldb: struct {
    version: String,
    stop: Int,
    steps: Int,
}

LatencyRuns: struct {
    image_sha256: String,
    jet_version: String,
    build: Int,
    debug_stop: Int,
    debug_steps: Int,
    lldb: LatencyLldb?,
    probes: [LatencyProbeTime]{[LatencyProbeTime]{}},
}

// One evaluation measure at the stop (latency_probes): the session input
// `jet debug` takes with the measured commands and without them, and the
// LLDB commands after the stop that do the same; the measure is the extra
// time, over `per`.
LatencyProbe: struct {
    measure: String,
    jet_with: String,
    jet_base: String,
    lldb_with: [String],
    lldb_base: [String],
    per: Int,
}

// A probe's milliseconds: `jet debug`'s, and LLDB's or why it has none.
LatencyProbeTime: struct {
    measure: String,
    jet: Int,
    lldb: Int?,
    lldb_note: String,
}

// The call expression the print probes evaluate: a call of one of the
// program's functions on the stopped function's local.
LATENCY_CALL: "f_1(total)"

// `first`, then `rest`.
latency_prepend: fn(first: String, rest: [String]) -> [String] Never! {
    out := [String]{first}
    loop item in rest -> out.push("{item}")
    out
}

// The evaluation probes, for `steps` steps.
latency_probes: fn(steps: Int) -> [LatencyProbe] Never! {
    nexts: "n\n".repeat(steps)
    lldb_nexts: (loop _ in 0..<steps -> "next")
    call: "expr -- {LATENCY_CALL}"
    // The watch's steps, then the watch deleted (LLDB numbers it 1, jet
    // debug 2, after the breakpoint).
    lldb_watched := latency_prepend("watchpoint set variable total", lldb_nexts)
    lldb_watched.push("watchpoint delete 1")
    [LatencyProbe]{
        LatencyProbe{measure: "print_place", jet_with: "print total\n", jet_base: "", lldb_with: [String]{"frame variable total"}, lldb_base: [String]{}, per: 1},
        LatencyProbe{measure: "print_first", jet_with: "print {LATENCY_CALL}\n", jet_base: "", lldb_with: [String]{call}, lldb_base: [String]{}, per: 1},
        LatencyProbe{
            measure: "print_again",
            jet_with: "print {LATENCY_CALL}\nn\nprint {LATENCY_CALL}\n",
            jet_base: "print {LATENCY_CALL}\nn\n",
            lldb_with: [String]{call, "next", call},
            lldb_base: [String]{call, "next"},
            per: 1,
        },
        LatencyProbe{
            measure: "second_eval",
            jet_with: "print total + 1\nprint total + 2\n",
            jet_base: "print total + 1\n",
            lldb_with: [String]{"expr -- total + 1", "expr -- total + 2"},
            lldb_base: [String]{"expr -- total + 1"},
            per: 1,
        },
        LatencyProbe{
            measure: "watch_per_stop",
            jet_with: "watch total\n{nexts}delete 2\n",
            jet_base: nexts,
            lldb_with: lldb_watched,
            lldb_base: lldb_nexts,
            per: steps,
        },
    }
}

usage: fn() -[IO]> Int Never! {
    term.eprint("usage: jet run Tools/Perf/DebugLatency/Main.jet -- [--jet PATH] [--lldb PATH] [--functions N] [--steps K] [--runs R] [--bar MS] [--stop entry|nested]")
    2
}

// The package the program builds in: it only prints.
LATENCY_PACKAGE: "name: \"debug_latency\"\nversion: \"0.1.0\"\nauthority: {{ allow: [IO] }}\n"

// The image, relative to the work directory every command runs in.
LATENCY_IMAGE: "out/prog"

// The program: N functions of five lines each (the last one blank), then
// `run`, which calls each in turn.
latency_program: fn(functions: Int) -> String Never! {
    lines := latency_functions(functions)
    lines.push("run: fn() {{")
    lines.push("    total := 0")
    loop index in 0..<functions -> lines.push("    total = f_{index}(total)")
    lines.push("    print(\"{{total}}\")")
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

// The N functions, five lines each (the last one blank).
latency_functions: fn(functions: Int) -> [String] Never! {
    lines := [String]{}
    loop index in 0..<functions {
        lines.push("f_{index}: fn(x: Int) -> Int {{")
        lines.push("    y: x + {index}")
        lines.push("    y % 1000")
        lines.push("}}")
        lines.push("")
    }
    lines
}

// `--stop nested`'s entry: `run` calls `outer` (latency_nested_lib), then
// each of the N functions in turn.
latency_nested_program: fn(functions: Int) -> String Never! {
    lines := [String]{"run: fn() {{", "    total := 0", "    total = outer(total)"}
    loop index in 0..<functions -> lines.push("    total = f_{index}(total)")
    lines.push("    print(\"{{total}}\")")
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

// `--stop nested`'s second source, lib.jet: the N functions, then `outer`,
// which calls `inner`, whose `total` is its own local; the stop is
// `inner`'s first call.
latency_nested_lib: fn(functions: Int) -> String Never! {
    lines := latency_functions(functions)
    lines.push("outer: fn(x: Int) -> Int {{")
    lines.push("    inner(x + 1)")
    lines.push("}}")
    lines.push("")
    lines.push("inner: fn(x: Int) -> Int {{")
    lines.push("    total := x + 2")
    lines.push("    total = f_2(total)")
    lines.push("    total = f_3(total)")
    lines.push("    total")
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

// The source the stop is in: prog.jet, or lib.jet with `--stop nested`.
latency_break_file: fn(nested: Bool{false}) -> String Never! {
    if nested -> "lib.jet" else -> "prog.jet"
}

// The line of the stop: the first call in `run` (latency_program), or with
// `nested` the first call in `inner` (latency_nested_lib).
latency_break_line: fn(functions: Int, nested: Bool{false}) -> Int Never! {
    if nested -> 5 * functions + 7 else -> 5 * functions + 3
}

// The middle of `values` in order.
latency_median: fn(values: [Int]) -> Int Never! {
    if values.len() == 0 -> return 0
    sorted := values.copy()
    sorted.sort()
    sorted[sorted.len() /% 2]
}

// The milliseconds `argv` takes, run in `work` with `input` as its whole
// stdin, or the reason it failed. Its output must hold `stopped`, the
// debugger's report of the breakpoint stop, so a run that never stopped is
// never timed.
latency_time: fn(argv: [String], work: String, input: String, stopped: String) -[Exec, Time, Time.Wait]> Int Err! {
    watch: time.start()
    child: process.cmd(argv).cwd(work).stdin(.Stream).stdout(.Capture).stderr(.Capture).spawn() ?? return Err("{argv[0]} did not start: {err}")
    child.stdin.write(input) ?? return Err("{argv[0]} took no input: {err}")
    child.stdin.close()
    receipt: child.wait() ?? return Err("{argv[0]} did not finish: {err}")
    elapsed: time.elapsed(watch).ns /% 1000000
    if !receipt.success {
        return Err("`{argv.join(" ")}` failed with {receipt.code}: {receipt.errors}")
    }
    if !receipt.output.contains(stopped) {
        return Err("`{argv.join(" ")}` never printed `{stopped}`: {receipt.output}")
    }
    Ok(elapsed)
}

// The median of `runs` timings of `argv`.
latency_median_time: fn(argv: [String], work: String, input: String, stopped: String, runs: Int) -[Exec, Time, Time.Wait]> Int Err! {
    times := [Int]{}
    loop _ in 0..<runs -> times.push(latency_time(argv, work, input, stopped) ?? return Err(err))
    Ok(latency_median(times))
}

// The first line `tool --version` prints, or the reason it printed none.
latency_version: fn(tool: String) -[Exec, Time.Wait]> String Err! {
    receipt: process.cmd([String]{tool, "--version"}).stdout(.Capture).stderr(.Capture).run() ?? return Err("{tool} did not start: {err}")
    if !receipt.success {
        return Err("`{tool} --version` failed with {receipt.code}: {receipt.errors}")
    }
    Ok(receipt.output.trim().split("\n").to_list()[0])
}

// The build that writes the image: `jet debug`'s own O0 build.
latency_build_argv: fn(jet: String) -> [String] Never! {
    [String]{jet, "build", "-O0", "--output-dir=out", "prog.jet"}
}

// `jet debug` on the built image, stopping at `line` of `file`. Its stdin
// holds the steps.
latency_debug_argv: fn(jet: String, file: String, line: Int) -> [String] Never! {
    [String]{jet, "debug", "--break", "{file}:{line}", LATENCY_IMAGE}
}

// The LLDB argv that stops at `line` of `file` in the image, takes `steps`
// steps over, and continues to the program's end.
latency_lldb_argv: fn(lldb: String, file: String, line: Int, steps: Int) -> [String] Never! {
    latency_lldb_session(lldb, file, line, (loop _ in 0..<steps -> "next"))
}

// The LLDB argv that stops at `line` of `file` in the image, runs
// `commands` there and continues to the program's end.
latency_lldb_session: fn(lldb: String, file: String, line: Int, commands: [String]) -> [String] Never! {
    argv := [String]{lldb, "-b", "-o", "breakpoint set --file {file} --line {line}", "-o", "run"}
    loop command in commands {
        argv.push("-o")
        argv.push("{command}")
    }
    argv.push("-o")
    argv.push("continue")
    argv.push(LATENCY_IMAGE)
    argv
}

// `argv` as a shell would take it: a word with a space in single quotes.
latency_command_text: fn(argv: [String]) -> String Never! {
    words: loop word in argv -> if word.contains(" ") -> "'{word}'" else -> word.copy()
    words.join(" ")
}

// LLDB's extra milliseconds for `probe`: its session with the probe's
// commands over the one without them, over `per`.
latency_lldb_probe: fn(lldb: String, file: String, line: Int, work: String, probe: LatencyProbe, runs: Int) -[Exec, Time, Time.Wait]> Int Err! {
    stopped: "stop reason = breakpoint"
    with_ms: latency_median_time(latency_lldb_session(lldb, file, line, probe.lldb_with), work, "", stopped, runs) ?? return Err(err)
    base_ms: latency_median_time(latency_lldb_session(lldb, file, line, probe.lldb_base), work, "", stopped, runs) ?? return Err(err)
    Ok((with_ms - base_ms) /% probe.per)
}

latency_measure: fn(options: LatencyOptions, work: String) -[Exec, FS, Time, Time.Wait]> LatencyRuns Err! {
    files.write(files.join(work, "package.jet"), LATENCY_PACKAGE) ?? return Err("couldn't write the package: {err}")
    entry: if options.nested -> latency_nested_program(options.functions) else -> latency_program(options.functions)
    files.write(files.join(work, "prog.jet"), entry) ?? return Err("couldn't write the program: {err}")
    if options.nested {
        files.write(files.join(work, "lib.jet"), latency_nested_lib(options.functions)) ?? return Err("couldn't write the program's lib.jet: {err}")
    }
    build: latency_build_argv(options.jet)
    // The first build writes the image both debuggers drive and fills the
    // build cache; the timed ones are warm.
    _: latency_time(build, work, "", "") ?? return Err(err)
    image: files.read_bytes(files.join(work, LATENCY_IMAGE)) ?? return Err("couldn't read the image: {err}")
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    debug: latency_debug_argv(options.jet, file, line)
    debug_stopped: "Breakpoint hit  {file}:{line}"
    lldb_stopped: "stop reason = breakpoint"
    nexts: "n\n".repeat(options.steps)
    lldb := LatencyLldb?{None}
    if options.lldb == .Val(tool) {
        timed: LatencyLldb{
            version: latency_version(tool) ?? return Err(err),
            stop: latency_median_time(latency_lldb_argv(tool, file, line, 0), work, "", lldb_stopped, options.runs) ?? return Err(err),
            steps: latency_median_time(latency_lldb_argv(tool, file, line, options.steps), work, "", lldb_stopped, options.runs) ?? return Err(err),
        }
        lldb = Val(timed)
    }
    // Each distinct `jet debug` session is timed once; the probes share them.
    sessions := [String:Int]{}
    probes := [LatencyProbeTime]{}
    loop probe in latency_probes(options.steps) {
        inputs: [String]{probe.jet_with, probe.jet_base}
        loop input in inputs {
            if !sessions.has_key(input) {
                sessions[input] = latency_median_time(debug, work, input, debug_stopped, options.runs) ?? return Err("{probe.measure}: {err}")
            }
        }
        timed := LatencyProbeTime{measure: "{probe.measure}", jet: (sessions[probe.jet_with] - sessions[probe.jet_base]) /% probe.per, lldb: None, lldb_note: ""}
        if options.lldb == .Val(tool) {
            ms: latency_lldb_probe(tool, file, line, work, probe, options.runs) ?? {
                timed.lldb_note = "{err.message}"
                probes.push(timed)
                next
            }
            timed.lldb = Val(ms)
        }
        probes.push(timed)
    }
    Ok(
        LatencyRuns{
            image_sha256: crypto.sha256(image).hex(),
            jet_version: latency_version(options.jet) ?? return Err(err),
            build: latency_median_time(build, work, "", "", options.runs) ?? return Err(err),
            debug_stop: latency_median_time(debug, work, "", debug_stopped, options.runs) ?? return Err(err),
            debug_steps: latency_median_time(debug, work, nexts, debug_stopped, options.runs) ?? return Err(err),
            lldb: lldb,
            probes: probes,
        },
    )
}

// The report: the image, the tools and the commands, then the rows, then
// the bar's verdict when there is one. Per step is the extra time of K steps
// over the first stop, over K; LLDB's column is `-` when LLDB was not timed.
latency_rows: fn(options: LatencyOptions, runs: LatencyRuns) -> [String] Never! {
    file: latency_break_file(nested: options.nested)
    line: latency_break_line(options.functions, nested: options.nested)
    debug_step: (runs.debug_steps - runs.debug_stop) /% options.steps
    rows := [String]{
        "# image {LATENCY_IMAGE} sha256 {runs.image_sha256}",
        "# jet {runs.jet_version}",
    }
    lldb_line := "# lldb not timed: none on PATH and no `--lldb`"
    lldb_stop := "-"
    lldb_step := "-"
    if runs.lldb == .Val(lldb) {
        lldb_line = "# lldb {lldb.version}"
        lldb_stop = "{lldb.stop}"
        lldb_step = "{(lldb.steps - lldb.stop) /% options.steps}"
    }
    rows.push(lldb_line)
    rows.push("# build: {latency_command_text(latency_build_argv(options.jet))}")
    rows.push("# jet_debug first_stop: {latency_command_text(latency_debug_argv(options.jet, file, line))} < /dev/null")
    rows.push("# jet_debug per_step: the same with {options.steps} `n` lines on stdin")
    if options.lldb == .Val(tool) {
        rows.push("# lldb first_stop: {latency_command_text(latency_lldb_argv(tool, file, line, 0))}")
        rows.push("# lldb per_step: {latency_command_text(latency_lldb_argv(tool, file, line, options.steps))}")
    }
    // The lines of the program's sources: run's 1 + N + 3 after the
    // functions, and with `nested` lib.jet's 10 after them.
    lines: if options.nested -> 6 * options.functions + 15 else -> latency_break_line(options.functions) + options.functions + 1
    stop: if options.nested -> ", the stop two calls deep in lib.jet" else -> ""
    rows.push("# {options.functions} functions, {lines} lines{stop}, {options.steps} steps, median of {options.runs} runs, milliseconds")
    rows.push("measure\tjet_debug\tlldb")
    rows.push("build\t{runs.build}\t-")
    rows.push("first_stop\t{runs.debug_stop}\t{lldb_stop}")
    rows.push("per_step\t{debug_step}\t{lldb_step}")
    loop probe in runs.probes {
        lldb_ms: if probe.lldb == .Val(ms) -> "{ms}" else -> "-"
        rows.push("{probe.measure}\t{probe.jet}\t{lldb_ms}")
    }
    loop probe in runs.probes {
        if probe.lldb_note != "" {
            rows.push("# lldb {probe.measure} not timed: {probe.lldb_note.split("\n").to_list()[0]}")
        }
    }
    loop verdict in latency_verdicts(options, runs) -> rows.push(verdict)
    if options.bar == .Val(bar) {
        verdict: if latency_bar_missed(options, runs) -> "missed" else -> "met"
        rows.push("# bar: jet_debug first_stop at most {bar} ms: {verdict}")
    }
    rows
}

// The bars `jet debug` is held to, each with its verdict: per_step within
// LLDB's plus 1 ms; print_place within LLDB's plus 10 ms; print_again and
// watch_per_stop within twice LLDB's; print_first at most 250 ms; and
// second_eval at most 100 ms. A bar against LLDB is judged only when LLDB
// was timed.
latency_verdicts: fn(options: LatencyOptions, runs: LatencyRuns) -> [String] Never! {
    verdicts := [String]{}
    if runs.lldb == .Val(lldb) {
        debug_step: (runs.debug_steps - runs.debug_stop) /% options.steps
        lldb_step: (lldb.steps - lldb.stop) /% options.steps
        verdicts.push("# bar: jet_debug per_step at most lldb's + 1 ms: {latency_verdict(debug_step <= lldb_step + 1)}")
    }
    loop probe in runs.probes {
        if probe.measure == "print_first" {
            verdicts.push("# bar: jet_debug print_first at most 250 ms: {latency_verdict(probe.jet <= 250)}")
        }
        if probe.measure == "second_eval" {
            verdicts.push("# bar: jet_debug second_eval at most 100 ms: {latency_verdict(probe.jet <= 100)}")
        }
        if probe.lldb == .Val(lldb_ms) {
            if probe.measure == "print_place" {
                verdicts.push("# bar: jet_debug print_place at most lldb's + 10 ms: {latency_verdict(probe.jet <= lldb_ms + 10)}")
            }
            if probe.measure == "print_again" || probe.measure == "watch_per_stop" {
                verdicts.push("# bar: jet_debug {probe.measure} at most twice lldb's: {latency_verdict(probe.jet <= 2 * lldb_ms)}")
            }
        }
    }
    verdicts
}

latency_verdict: fn(met: Bool) -> String Never! { if met -> "met" else -> "missed" }

// Whether `jet debug`'s first stop took longer than the bar, if there is one.
latency_bar_missed: fn(options: LatencyOptions, runs: LatencyRuns) -> Bool Never! {
    if options.bar == .Val(bar) -> return runs.debug_stop > bar
    false
}

debug_latency: fn() -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    args: process.args()
    options := LatencyOptions{jet: process.which("jet") ?? "jet", lldb: process.which("lldb"), functions: 2000, steps: 20, runs: 5, bar: None}
    at := 0
    loop at < args.len() {
        if at + 1 >= args.len() -> return usage()
        value: args[at + 1]
        if args[at] == {
            "--jet" -> options.jet = value.copy()
            "--lldb" -> options.lldb = Val(value.copy())
            "--functions" -> options.functions = Int.parse(value) ?? return usage()
            "--steps" -> options.steps = Int.parse(value) ?? return usage()
            "--runs" -> options.runs = Int.parse(value) ?? return usage()
            "--bar" -> options.bar = Val(Int.parse(value) ?? return usage())
            "--stop" -> {
                if value != "entry" && value != "nested" -> return usage()
                options.nested = value == "nested"
            }
            else -> return usage()
        }
        at += 2
    }
    if options.functions < 1 || options.steps < 1 || options.steps > options.functions || options.runs < 1 || (options.nested && options.functions < 4) {
        return usage()
    }
    work: files.temp_dir("jet-debug-latency") ?? {
        term.eprint("debug latency: couldn't make a work directory: {err}")
        return 1
    }
    runs: latency_measure(options, work.path) ?? {
        term.eprint("debug latency: {err.message} (the program is in {work.path})")
        return 1
    }
    files.remove_all(work.path).drop("a work directory left behind is only disk")
    loop row in latency_rows(options, runs) -> print(row)
    if latency_bar_missed(options, runs) -> return 1
    0
}

run: fn() {
    code: debug_latency()
    if code != 0 -> process.exit(code)
}

#Test("the break line is the first call in run") {
    program: latency_program(3)
    lines: program.split("\n").to_list()
    assert_eq(lines[latency_break_line(3) - 1], "    total = f_0(total)")
    assert_eq(lines[latency_break_line(3) + 1], "    total = f_2(total)")
    assert_eq(lines[0], "f_0: fn(x: Int) -> Int {{")
    assert_eq(lines[latency_break_line(3) + 3], "}}")
}

#Test("a nested stop is inner's first call, two calls deep in lib.jet") {
    lib: latency_nested_lib(4).split("\n").to_list()
    line: latency_break_line(4, nested: true)
    assert_eq(lib[line - 1], "    total = f_2(total)")
    assert_eq(lib[line - 3], "inner: fn(x: Int) -> Int {{")
    assert_eq(lib[line - 6], "    inner(x + 1)")
    assert_eq(lib.len() + latency_nested_program(4).split("\n").to_list().len(), 6 * 4 + 15 + 2)
    assert_eq(latency_nested_program(4).split("\n").to_list()[2], "    total = outer(total)")
    assert_eq(latency_break_file(nested: true), "lib.jet")
}

#Test("the package allows only printing") {
    assert_eq(LATENCY_PACKAGE.split("\n").to_list()[2], "authority: {{ allow: [IO] }}")
}

#Test("both debuggers drive the one built image") {
    assert_eq(latency_debug_argv("jet", "prog.jet", 13), [String]{"jet", "debug", "--break", "prog.jet:13", "out/prog"})
    lldb: latency_lldb_argv("lldb", "lib.jet", 13, 1)
    assert_eq(lldb[3], "breakpoint set --file lib.jet --line 13")
    assert_eq(lldb[lldb.len() - 1], "out/prog")
    assert_eq(latency_build_argv("jet"), [String]{"jet", "build", "-O0", "--output-dir=out", "prog.jet"})
}

#Test("the report names the image, the tools and the commands, then the rows") {
    options: LatencyOptions{jet: "jet", lldb: Val("lldb"), functions: 10, steps: 4, runs: 1, bar: None}
    lldb: LatencyLldb{version: "lldb version 21", stop: 400, steps: 480}
    rows: latency_rows(options, LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 900, debug_steps: 1300, lldb: Val(lldb)})
    assert_eq(rows[0], "# image out/prog sha256 ab12")
    assert_eq(rows[4], "# jet_debug first_stop: jet debug --break prog.jet:53 out/prog < /dev/null")
    assert_eq(rows[6], "# lldb first_stop: lldb -b -o 'breakpoint set --file prog.jet --line 53' -o run -o continue out/prog")
    assert_eq(rows[8], "# 10 functions, 64 lines, 4 steps, median of 1 runs, milliseconds")
    assert_eq(rows[11], "first_stop\t900\t400")
    assert_eq(rows[12], "per_step\t100\t20")
    assert_eq(rows[13], "# bar: jet_debug per_step at most lldb's + 1 ms: missed")
    assert_eq(rows.len(), 14)
}

#Test("each probe is a row against lldb's, and the bars judge them") {
    options: LatencyOptions{jet: "jet", lldb: Val("lldb"), functions: 10, steps: 4, runs: 1, bar: None}
    lldb: LatencyLldb{version: "lldb version 21", stop: 400, steps: 480}
    probes: [LatencyProbeTime]{
        LatencyProbeTime{measure: "print_place", jet: 15, lldb: Val(4), lldb_note: ""},
        LatencyProbeTime{measure: "print_first", jet: 300, lldb: None, lldb_note: "error: use of undeclared identifier"},
        LatencyProbeTime{measure: "second_eval", jet: 40, lldb: Val(5), lldb_note: ""},
        LatencyProbeTime{measure: "watch_per_stop", jet: 9, lldb: Val(5), lldb_note: ""},
    }
    rows: latency_rows(options, LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 900, debug_steps: 984, lldb: Val(lldb), probes: probes})
    text: rows.join("\n")
    assert(text.contains("print_place\t15\t4\n"), text)
    assert(text.contains("print_first\t300\t-\n"), text)
    assert(text.contains("# lldb print_first not timed: error: use of undeclared identifier"), text)
    assert(text.contains("# bar: jet_debug per_step at most lldb's + 1 ms: met"), text)
    assert(text.contains("# bar: jet_debug print_place at most lldb's + 10 ms: missed"), text)
    assert(text.contains("# bar: jet_debug print_first at most 250 ms: missed"), text)
    assert(text.contains("# bar: jet_debug second_eval at most 100 ms: met"), text)
    assert(text.contains("# bar: jet_debug watch_per_stop at most twice lldb's: met"), text)
}

#Test("the probes measure against their own base sessions") {
    probes: latency_probes(3)
    assert_eq(probes.len(), 5)
    assert_eq(probes[0].jet_with, "print total\n")
    assert_eq(probes[2].jet_base, "print f_1(total)\nn\n")
    assert_eq(probes[4].jet_with, "watch total\nn\nn\nn\ndelete 2\n")
    assert_eq(probes[4].per, 3)
    assert_eq(latency_lldb_session("lldb", "prog.jet", 13, [String]{"frame variable total"})[7], "frame variable total")
}

// c34: the measurement needs nothing but jet; the bar fails the run after
// the rows are printed.
#Test("without lldb only jet debug is timed, and the bar judges its first stop") {
    options: LatencyOptions{jet: "jet", lldb: None, functions: 10, steps: 4, runs: 1, bar: Val(200)}
    runs: LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 60, debug_steps: 100, lldb: None}
    rows: latency_rows(options, runs)
    assert_eq(rows[2], "# lldb not timed: none on PATH and no `--lldb`")
    assert(!rows.join("\n").contains("# lldb first_stop"), rows.join("\n"))
    assert_eq(rows[rows.len() - 3], "first_stop\t60\t-")
    assert_eq(rows[rows.len() - 2], "per_step\t10\t-")
    assert_eq(rows[rows.len() - 1], "# bar: jet_debug first_stop at most 200 ms: met")
    assert(!latency_bar_missed(options, runs))
    slow: LatencyRuns{image_sha256: "ab12", jet_version: "jet 0.1", build: 300, debug_stop: 201, debug_steps: 300, lldb: None}
    assert(latency_bar_missed(options, slow))
    assert_eq(latency_rows(options, slow)[latency_rows(options, slow).len() - 1], "# bar: jet_debug first_stop at most 200 ms: missed")
}
