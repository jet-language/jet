// Cold Core compile receipt: the wall, peak memory and trace spans of two
// gauntlet twins compiled cold, out of tree, by one compiler.
//
//   jet Tools/Perf/CoreCold/run.jet -- --jet PATH [--runs 3] [--cpus LIST]
//       [--work DIR] [--out DIR] [--time PATH]
//
// The twins and what they need are copied from this checkout to <work>/tree
// (every file but the `.jet` build folders), so the compiler finds no
// toolchain tree and takes Core from its own records. The programs, each run
// in <work>/tree/Tools (the optimization twin in its entry's fixtures):
//
//   scaling-check  jet check Gauntlet/Entries/ScalingCorpora/Driver/run.jet
//   scaling-run    jet Gauntlet/Entries/ScalingCorpora/Driver/run.jet -- shapes
//   optimization   jet <work>/tree/Tools/Gauntlet/Optimization/Optimization/run.jet
//                      -- plan --manifest manifest.json
//
// Each program runs --runs times (default 3) in rounds, every program once a
// round, pinned to --cpus (a list such as 24-31; default every CPU). Every run
// is cold: an empty JET_STORE_DIR and XDG_CACHE_HOME, no JET_TOOLCHAIN_ROOT or
// JET_SEED, NO_COLOR=1 and its own trace (`--trace=FILE`). It runs under GNU time
// (--time; default the first `time` on PATH): the wall is spawn to reap of
// GNU time, the peak is GNU time's %M, the compiler's ru_maxrss. GNU time is
// the compiler's parent, so none of this program's memory carries into it.
//
// --out DIR (default Tools/Perf/CoreCold/receipt in this checkout) gets
// receipt.md: the compiler (the IDENTITY file beside --jet and its
// `--version`), every run's wall and peak, the medians, each limit's verdict,
// and the median run's top-level spans and Core counters; and
// <program>.trace.json, the median run's trace (the run of median wall). MB
// is 10^6 bytes. No path in the receipt names this machine. The limits:
//
//   scaling-check  comptime.bodies (wall over every lane) at most 150 ms
//   scaling-run    wall under 500 ms, peak under 200 MB
//   optimization   wall under 1 s, peak under 400 MB
//
// Exit 0 when every limit holds, 1 when one does not; a usage error or a run
// that fails ends it with its report on stderr and exit 1 before any receipt.
use {
    core.[files, process, sys, term, time]
    core.encoding.json
}

// What the twins need, relative to the checkout.
COPIED: [String]{
    "Tools/Agent/JetEnv.jet",
    "Tools/Gauntlet/Entries/Optimization",
    "Tools/Gauntlet/Entries/ScalingCorpora",
    "Tools/Gauntlet/Harness/run.mjs",
    "Tools/Gauntlet/Kit",
    "Tools/Gauntlet/Optimization",
    "Tools/Perf/Scaling/Corpora",
}

SCALING: "Gauntlet/Entries/ScalingCorpora/Driver/run.jet"

OPTIMIZATION: "Tools/Gauntlet/Optimization/Optimization/run.jet"

OUTPUT_LIMIT: 268435456

TIMEOUT_SECONDS: 300

// A program: its name, its working directory under <work>/tree, the jet
// arguments, and its limits (-1: none).
Program: struct {
    name: String,
    cwd: String,
    args: [String],
    shown: String,
    bodies_max_ms: Int,
    wall_max_ms: Int,
    peak_max_mb: Int,
}

// One run: wall (ns), GNU time's peak (KiB), its trace and the trace's
// comptime.bodies wall (µs).
Run: struct {
    wall_ns: Int,
    peak_kib: Int,
    trace: String,
    bodies_us: Int,
}

TraceArgs: struct {
    value: Int?,
}

TraceEvent: struct {
    name: String,
    ph: String,
    ts: Int?,
    tid: Int?,
    args: TraceArgs?,
}

// An open span: its lane, name, start, whether it is top level on the
// opening lane, and whether its end has come.
Open: struct {
    lane: Int,
    name: String,
    start_us: Int,
    top: Bool,
    closed: Bool,
}

Total: struct {
    name: String,
    value: Int,
}

// A trace's top-level spans of the opening lane (µs, summed by name in first
// order), comptime.bodies' wall over every lane (µs), the first span start to
// the last span end (µs) and the Core counters.
Summary: struct {
    top: [Total],
    bodies_us: Int,
    traced_us: Int,
    counters: [Total],
}

run: fn() -> Never Err! {
    // The checkout: three up from Tools/Perf, which holds this program's directory.
    root: files.normalize("{sys.executable()}/../../../..")
    argv: process.args()
    tmp: process.env_get_or("TMPDIR", "/tmp")
    args := [String:String]{
        "jet": "",
        "runs": "3",
        "cpus": "",
        "work": files.join(tmp, "jet-core-cold"),
        "out": files.join(root, "Tools/Perf/CoreCold/receipt"),
        "time": gnu_time(),
    }
    i := 0
    loop i < argv.len() {
        key: argv[i].remove_prefix("--")
        if !args.has_key(key) || i + 1 >= argv.len() {
            return Err("unknown or incomplete option {argv[i]}")
        }
        args[key] = argv[i + 1].copy()  // copy: the argv keeps its items
        i += 2
    }
    jet: args["jet"]
    if !jet.starts_with("/") -> return Err("--jet takes the compiler's absolute path")
    if args["time"] == "" -> return Err("no GNU time on PATH; name it with --time")
    runs: Int.parse(args["runs"].trim()) ?? 0
    if runs < 1 -> return Err("--runs must be a positive integer")
    cpus: parse_cpus(args["cpus"])
    work: files.normalize(args["work"])
    out: args["out"]
    tree: files.join(work, "tree")
    files.remove_all(work) ?? ()
    loop path in COPIED { copy_tree(files.join(root, path), files.join(tree, path)) }
    files.create_dir_all(out)
    programs: [Program]{
        Program{name: "scaling-check", cwd: "Tools", args: [String]{"check", SCALING}, shown: "jet check {SCALING}", bodies_max_ms: 150, wall_max_ms: -1, peak_max_mb: -1},
        Program{name: "scaling-run", cwd: "Tools", args: [String]{SCALING, "--", "shapes"}, shown: "jet {SCALING} -- shapes", bodies_max_ms: -1, wall_max_ms: 500, peak_max_mb: 200},
        Program{name: "optimization", cwd: "Tools/Gauntlet/Entries/Optimization/Fixtures", args: [String]{files.join(tree, OPTIMIZATION), "--", "plan", "--manifest", "manifest.json"}, shown: "jet <tree>/{OPTIMIZATION} -- plan --manifest manifest.json", bodies_max_ms: -1, wall_max_ms: 1000, peak_max_mb: 400},
    }
    measured := [[Run]]{}
    loop _ in programs -> measured.push([Run]{})
    loop round in 1..<(runs + 1) {
        loop p in 0..<programs.len() {
            ran: measure(jet, args["time"], cpus, work, tree, programs[p], round)
            term.eprint("{programs[p].name}.{round}: {ms(ran.wall_ns * 10 /% 1000000)} ms, {mb(ran.peak_kib)} MB")
            measured[p].push(ran)
        }
    }
    lines := [String]{"# Cold Core compile receipt", ""}
    lines.extend(compiler_lines(jet))
    pinned: if cpus.len() > 0 -> " pinned to CPUs {args["cpus"]}," else -> ""
    lines.push("Each program ran {runs} times cold and out of tree, in rounds of every program once,{pinned} each with an empty JET_STORE_DIR and XDG_CACHE_HOME, no JET_TOOLCHAIN_ROOT or JET_SEED, and its own trace (`--trace=FILE`, the JET_TRACE_FILE spans), under GNU time. Wall is spawn to reap of GNU time; peak is GNU time's %M (the compiler's ru_maxrss). Each value is the median of the runs; MB is 10^6 bytes. Produced by `jet Tools/Perf/CoreCold/run.jet`.")
    lines.extend([String]{"", "| Program | Command | Wall ms (runs) | Wall ms | Peak MB (runs) | Peak MB | comptime.bodies ms | Limit | Verdict |", "|---|---|---|---:|---|---:|---:|---|---|"})
    failed := false
    loop p in 0..<programs.len() {
        program: programs[p]
        rows: measured[p]
        wall: median(rows.map(fn(r) { r.wall_ns }))
        peak: median(rows.map(fn(r) { r.peak_kib }))
        bodies: median(rows.map(fn(r) { r.bodies_us }))
        limits := [String]{}
        held := true
        if program.bodies_max_ms >= 0 {
            limits.push("comptime.bodies <= {program.bodies_max_ms} ms")
            if bodies > program.bodies_max_ms * 1000 -> held = false
        }
        if program.wall_max_ms >= 0 {
            limits.push("wall < {program.wall_max_ms} ms")
            if wall >= program.wall_max_ms * 1000000 -> held = false
        }
        if program.peak_max_mb >= 0 {
            limits.push("peak < {program.peak_max_mb} MB")
            if peak * 1024 >= program.peak_max_mb * 1000000 -> held = false
        }
        if !held -> failed = true
        walls: rows.map(fn(r) { ms(r.wall_ns * 10 /% 1000000) }).join(", ")
        peaks: rows.map(fn(r) { mb(r.peak_kib) }).join(", ")
        verdict: if held -> "PASS" else -> "FAIL"
        lines.push("| {program.name} | `{program.shown}` | {walls} | {ms(wall * 10 /% 1000000)} | {peaks} | {mb(peak)} | {ms(bodies /% 100)} | {limits.join(", ")} | {verdict} |")
    }
    loop p in 0..<programs.len() {
        program: programs[p]
        chosen: median_run(measured[p])
        saved: "{program.name}.trace.json"
        files.copy(chosen.trace, files.join(out, saved))
        summary: summarize(files.read(chosen.trace))
        lines.extend([String]{"", "## {program.name}", "", "The median run: wall {ms(chosen.wall_ns * 10 /% 1000000)} ms (the compile and the program's own run), traced {ms(summary.traced_us /% 100)} ms (first span start to last span end), peak {mb(chosen.peak_kib)} MB, trace `{saved}`.", "", "| Top-level span | ms |", "|---|---:|"})
        loop span in summary.top -> lines.push("| {span.name} | {ms(span.value /% 100)} |")
        lines.extend([String]{"", "| Counter | Value |", "|---|---:|"})
        loop counter in summary.counters -> lines.push("| {counter.name} | {counter.value} |")
    }
    files.write(files.join(out, "receipt.md"), "{lines.join("\n")}\n")
    print(files.join(out, "receipt.md"))
    process.exit(if failed -> 1 else -> 0)
}

// GNU time (`-f`, `-o`): the first executable `time` on PATH (the shell's
// `time` is a keyword, not this), or "" when there is none.
gnu_time: fn() -> String {
    on_path: process.env_get_or("PATH", "").split(":").to_list().find(fn(dir) { dir != "" && files.can_execute("{dir}/time") })
    if on_path == .Val(dir) -> return "{dir}/time"
    ""
}

// "24-31,40" as its CPUs.
parse_cpus: fn(text: String) -> [Int] {
    cpus := [Int]{}
    loop part in text.split(",") {
        span: part.trim().partition("-")
        first: Int.parse(span.head) ?? next
        last: if span.sep == "" -> first else -> Int.parse(span.tail) ?? first
        loop cpu in first..<(last + 1) -> cpus.push(cpu)
    }
    cpus
}

// Every file under `from` but the `.jet` build folders, to `to`; a file is
// copied as itself.
copy_tree: fn(from: String, to: String) Err! {
    if !files.is_dir(from) {
        files.create_dir_all(files.dirname(to))
        files.copy(from, to)
        return
    }
    loop entry in files.walk_files(from, skip: [String]{".jet"}) {
        found: entry ?? return Err("could not walk {from}: {err}")
        target: files.join(to, files.relative(found.path, from))
        files.create_dir_all(files.dirname(target))
        files.copy(found.path, target)
    }
}

// The compiler's lines: its IDENTITY file (beside it) and the first line of
// its `--version`.
compiler_lines: fn(jet: String) -> [String] Err! {
    identity_file: files.join(files.dirname(jet), "IDENTITY")
    identity: if files.exists(identity_file) -> files.read(identity_file).trim() else -> "none (no IDENTITY file beside it)"
    version: process.cmd([jet, "--version"]).output_limit(1048576).run()
    named: if version.output.trim() != "" -> version.output.trim() else -> version.errors.trim()
    [String]{"Compiler: identity `{identity}`, `jet --version`: `{named.partition("\n").head}`.", ""}
}

// One cold run of `program`, round `round`, in <work>/runs/<name>.<round>.
measure: fn(jet: String, gnu: String, cpus: [Int], work: String, tree: String, program: Program, round: Int) -> Run Err! {
    dir: files.join(work, "runs/{program.name}.{round}")
    store: files.join(dir, "store")
    cache: files.join(dir, "cache")
    trace: files.join(dir, "trace.json")
    time_file: files.join(dir, "time")
    files.create_dir_all(store)
    files.create_dir_all(cache)
    // `--trace=FILE` follows the verb (`check`), or comes first when the
    // program runs a file.
    at: if program.args[0] == "check" -> 1 else -> 0
    argv := [String]{gnu, "-f", "%M", "-o", time_file, jet}
    argv.extend(program.args[0..<at])
    argv.push("--trace={trace}")
    argv.extend(program.args[at..<program.args.len()])
    spec := process.cmd(argv).cwd(files.join(tree, program.cwd)).env_remove("JET_TOOLCHAIN_ROOT").env_remove("JET_SEED").env("JET_STORE_DIR", store).env("XDG_CACHE_HOME", cache).env("NO_COLOR", "1")
    spec = spec.timeout(time.duration_seconds(TIMEOUT_SECONDS)).output_limit(OUTPUT_LIMIT)
    if cpus.len() > 0 -> spec = spec.cpu_affinity(cpus.copy())  // copy: every run pins to the same CPUs
    started: time.instant()
    receipt: spec.run()
    wall_ns: started.elapsed().ns
    files.write(files.join(dir, "stdout"), receipt.output)
    files.write(files.join(dir, "stderr"), receipt.errors)
    if receipt.timed_out || receipt.signal != None || receipt.code != 0 {
        return Err("{program.name}.{round} failed (exit {receipt.code}, timed out {receipt.timed_out}); its output is in {dir}")
    }
    // GNU time's last line: a signal's note can come before it.
    timed: files.read(time_file).trim().split("\n").to_list()
    peak: Int.parse(timed[timed.len() - 1].trim()) ?? return Err("{program.name}.{round}: GNU time wrote no peak")
    Ok(Run{wall_ns: wall_ns, peak_kib: peak, trace: trace.copy(), bodies_us: summarize(files.read(trace)).bodies_us})  // copy: the run keeps its trace's path
}

// The run of median wall.
median_run: fn(runs: [Run]) -> Run {
    sorted := runs.copy()  // copy: the receipt keeps the runs in their order
    sorted.sort_by(fn(r) { r.wall_ns })
    sorted[sorted.len() /% 2].copy()  // copy: the sorted list is dropped
}

// The middle value, or the rounded mean of the middle two.
median: fn(values: [Int]) -> Int Never! {
    sorted := values.copy()  // copy: the values keep their run order
    sorted.sort()
    m: sorted.len() /% 2
    if sorted.len() % 2 == 1 -> return sorted[m]
    (sorted[m - 1] + sorted[m] + 1) /% 2
}

// Tenths as "N.N".
ms: fn(tenths: Int) -> String Never! { "{tenths /% 10}.{tenths %% 10}" }

// KiB as MB (10^6 bytes) to one decimal.
mb: fn(kib: Int) -> String Never! { ms(kib * 1024 /% 100000) }

// The trace's summary. A trace a run cut short has no closing bracket; its
// events are one per line.
summarize: fn(text: String) -> Summary {
    top := [Total]{}
    counters := [Total]{}
    open := [Open]{}
    bodies := [{start: Int, end: Int}]{}
    lane := -1
    first := -1
    end_us := 0
    loop raw in text.split("\n") {
        line: raw.trim().remove_suffix(",")
        if line == "" || line == "[" || line == "]" -> next
        event: json.decode<TraceEvent>(line) ?? next
        if event.ph == "C" {
            if !event.name.starts_with("core.") && !event.name.starts_with("load.core") -> next
            value: event.args?.value ?? next
            at := 0
            loop at < counters.len() && counters[at].name != event.name -> at += 1
            if at == counters.len() -> counters.push(Total{name: event.name.copy(), value: 0})  // copy: the summary outlives the event
            counters[at].value += value
            next
        }
        if event.ph != "B" && event.ph != "E" -> next
        ts: event.ts ?? next
        tid: event.tid ?? next
        if event.ph == "B" {
            if lane < 0 -> lane = tid
            if first < 0 -> first = ts
            outer: tid == lane && !open.any(fn(o) { o.lane == lane && !o.closed })
            open.push(Open{lane: tid, name: event.name.copy(), start_us: ts, top: outer, closed: false})  // copy: the open span outlives the event
            next
        }
        if ts > end_us -> end_us = ts
        at := open.len() - 1
        loop at >= 0 && (open[at].closed || open[at].lane != tid || open[at].name != event.name) {
            at -= 1
        }
        if at < 0 -> next
        open[at].closed = true
        start: open[at].start_us
        if event.name == "comptime.bodies" -> bodies.push({start: start, end: ts})
        if open[at].top {
            found := 0
            loop found < top.len() && top[found].name != event.name -> found += 1
            if found == top.len() -> top.push(Total{name: event.name.copy(), value: 0})  // copy: the summary outlives the event
            top[found].value += ts - start
        }
        // The closed spans at the end leave, so the search stays short.
        loop open.len() > 0 {
            last: open.pop() ?? break
            if !last.closed {
                open.push(last)
                break
            }
        }
    }
    bodies.sort_by(fn(b) { b.start })
    bodies_us := 0
    union_start := 0
    union_end := -1
    loop span in bodies {
        if union_end >= 0 && span.start <= union_end {
            if span.end > union_end -> union_end = span.end
            next
        }
        if union_end >= 0 -> bodies_us += union_end - union_start
        union_start = span.start
        union_end = span.end
    }
    if union_end >= 0 -> bodies_us += union_end - union_start
    Summary{top: top, bodies_us: bodies_us, traced_us: if first < 0 -> 0 else -> end_us - first, counters: counters}
}
