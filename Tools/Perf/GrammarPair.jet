#!/usr/bin/env jet
// The grammar pair gate in one command: is a Core text format read through a
// `Grammar` literal at least as fast as the hand-written parser it replaces?
// A pair is a row of the manifest's `grammar_pairs` list
// (Tools/Gauntlet/measurement-manifest.json): a Hand arm that runs the hand
// parser and a Grammar arm that reads the same corpus through a grammar into
// the same value, each a `main.jet` taking `--corpus PATH --n N`, parsing the
// corpus N times and printing the row's expected output. Both arms are built
// with `--release` at each of the row's levels and run TRIALS times through
// the gauntlet's launcher (Tools/Gauntlet/Harness/launch.c), the arms
// alternating which runs first. Per level and per metric (wall time,
// user-mode cycles, peak memory) it takes grammar/hand of the upper medians
// and the shared harness's paired bootstrap interval of that ratio
// (Tools/Gauntlet/Harness/performance-surface.mjs). A metric is a loss when
// the interval's lower bound is above 1: the grammar arm is slower or bigger
// beyond noise. The command exits 0 only when no metric is a loss; a hand
// parser is deleted only in the landing whose pair passes. `--output` writes
// the receipt as JSON. It is a timed measurement: run it alone, on the
// reference machine.
//
// usage (from the repository root; needs cc unless JET_GAUNTLET_LAUNCHER
// names a launcher built from launch.c):
//   jet Tools/Perf/GrammarPair.jet --pair NAME [--jet PATH] [--n N] [--trials T] [--output FILE]
// The default compiler is Tools/Agent/JetEnv.jet's `jet`; N and T default to
// the row's.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    regex: core.regex
    stats: core.math.stats
    sys: core.sys
}

MANIFEST: "Tools/Gauntlet/measurement-manifest.json"

LAUNCH: "Tools/Gauntlet/Harness/launch.c"

JET_ENV: "Tools/Agent/JetEnv.jet"

// The shared harness's bootstrap.
BOOTSTRAP_RESAMPLES: 10000

BOOTSTRAP_SEED: 2977

BOOTSTRAP_LOWER_RANK: 250

BOOTSTRAP_UPPER_RANK: 9750

// One row of the manifest's `grammar_pairs` list.
PairRow: struct {
    id: String,
    hand: String,
    grammar: String,
    corpus: String,
    expected_output: String,
    n: Int,
    levels: [String],
    trials: Int,
}

PairList: struct {
    pairs: [PairRow],
}

Manifest: struct {
    grammar_pairs: PairList,
}

// One timed run, from the launcher's report.
Run: struct {
    wall_ns: Int,
    cycles: Int,
    peak_kb: Int,
}

Metric: struct {
    grammar_median: Int,
    hand_median: Int,
    ratio: Float,
    lower95: Float,
    upper95: Float,
    verdict: String,
}

Level: struct {
    level: String,
    trials: Int,
    wall_ns: Metric,
    cycles_u: Metric?,
    peak_rss_kb: Metric,
    grammar_wall_ns: [Int],
    hand_wall_ns: [Int],
}

Host: struct {
    platform: String,
    release: String,
    arch: String,
    cpu_model: String?,
    cpu_count: Int,
}

Receipt: struct {
    schema: String,
    pair: String,
    n: Int,
    levels: [Level],
    host: Host,
    generated_command: String,
    verdict: String,
}

fail: fn(message: String) -[Exec, IO]> Never { process.fail(1, "grammar pair: {message}") }

argument: fn(argv: [String], name: String, fallback: String) -> String {
    loop at in 0..<argv.len() {
        if argv[at] == name {
            return if at + 1 < argv.len() -> argv[at + 1].copy() else -> fail("{name} needs a value")
        }
    }
    fallback.copy()
}

count: fn(text: String, name: String) -> Int {
    value: Int.parse(text) ?? fail("{name} is not a number: {text}")
    if value <= 0 -> fail("{name} must be above 0")
    value
}

// The manifest row named `name`.
pair_of: fn(manifest: Manifest, name: String) -> PairRow {
    loop row in manifest.grammar_pairs.pairs {
        if row.id == name -> return row.copy()
    }
    known: manifest.grammar_pairs.pairs.map(fn(row) { row.id.copy() })
    fail("no grammar pair is named `{name}`; the manifest has {known.join(", ")}")
}

// One arm's `main.jet` built at one level into `dir`, its binary.
build: fn(root: String, jet: [String], arm: String, level: String, dir: String) -> String {
    files.create_dir_all(dir) ?? fail("{dir}: {err}")
    source: files.read(files.join(root, "{arm}/main.jet")) ?? fail("{arm}/main.jet: {err}")
    files.write(files.join(dir, "main.jet"), source) ?? fail("{dir}/main.jet: {err}")
    ^argv: jet.copy()
    argv.extend([String]{"build", "--release", level, "main.jet"})
    built: process.cmd(argv).cwd(dir).run() ?? fail("{argv.join(" ")}: {err}")
    binary: files.join(dir, ".jet/build/main")
    if !built.success || !files.exists(binary) {
        fail("{arm} {level} does not build:\n{built.output}{built.errors}")
    }
    binary
}

// The launcher's report of one run: its `end` line (exit code, wall ns,
// first stdout ns, peak KiB, user us, system us, exec errno) and its
// `cycles` line (-1 when the counter could not open).
run_of: fn(report: String) -> Run {
    ^end: [String]{}
    ^cycles: -1
    loop line in report.split("\n") {
        fields: line.split(" ").to_list()
        if fields[0] == "cycles" && fields.len() == 2 -> cycles = Int.parse(fields[1]) ?? -1
        if fields[0] == "end" -> end = fields
    }
    if end.len() != 8 -> fail("the launcher's report has no end line:\n{report}")
    if end[1] != "0" || end[7] != "0" -> fail("a timed run exited {end[1]} (exec errno {end[7]})")
    Run{wall_ns: Int.parse(end[2]) ?? fail("wall time {end[2]}"), cycles: cycles, peak_kb: Int.parse(end[4]) ?? fail("peak {end[4]}")}
}

// One timed run of `binary` over the corpus, which must print `expected`.
timed: fn(launch: String, report: String, binary: String, corpus: String, n: String, expected: String) -> Run {
    ran: process.cmd([String]{launch, report, binary, "--corpus", corpus, "--n", n}).run() ?? fail("{binary}: {err}")
    if ran.output != expected {
        fail("{binary} --n {n} printed other output than the pair expects:\n{ran.output}")
    }
    run_of(files.read(report) ?? fail("{report}: {err}"))
}

// The shared harness's paired index bootstrap of median(grammar) /
// median(hand): a 32-bit linear congruential draw seeded with
// BOOTSTRAP_SEED picks each resample's indices; the bounds are nearest ranks.
metric: fn(grammar: [Int], hand: [Int]) -> Metric {
    ^state: BOOTSTRAP_SEED
    ^ratios: [Float]{}
    loop _ in 0..<BOOTSTRAP_RESAMPLES {
        ^picked_grammar: [Int]{}
        ^picked_hand: [Int]{}
        loop _ in 0..<grammar.len() {
            state = (state * 1664525 + 1013904223) %% 4294967296
            selected: state * grammar.len() /% 4294967296
            picked_grammar.push(grammar[selected])
            picked_hand.push(hand[selected])
        }
        grammar_median: stats.median_high_int(picked_grammar) ?? fail("no samples")
        hand_median: stats.median_high_int(picked_hand) ?? fail("no samples")
        ratios.push(Float.from_int(grammar_median) / Float.from_int(hand_median))
    }
    ratios.sort()
    lower: ratios[BOOTSTRAP_LOWER_RANK - 1]
    upper: ratios[BOOTSTRAP_UPPER_RANK - 1]
    grammar_median: stats.median_high_int(grammar) ?? fail("no samples")
    hand_median: stats.median_high_int(hand) ?? fail("no samples")
    verdict: if {
        lower > 1.0 -> "loss"
        upper < 1.0 -> "win"
        else -> "even"
    }
    Metric{grammar_median: grammar_median, hand_median: hand_median, ratio: Float.from_int(grammar_median) / Float.from_int(hand_median), lower95: lower, upper95: upper, verdict: verdict}
}

// Both arms at one level, TRIALS paired runs, the grammar arm first on even
// trials.
level_of: fn(launch: String, scratch: String, grammar: String, hand: String, level: String, corpus: String, n: String, trials: Int, expected: String) -> Level {
    report: files.join(scratch, "report")
    ^grammar_runs: [Run]{}
    ^hand_runs: [Run]{}
    loop trial in 0..<trials {
        if trial %% 2 == 0 -> grammar_runs.push(timed(launch, report, grammar, corpus, n, expected))
        hand_runs.push(timed(launch, report, hand, corpus, n, expected))
        if trial %% 2 == 1 -> grammar_runs.push(timed(launch, report, grammar, corpus, n, expected))
    }
    grammar_wall: grammar_runs.map(fn(run) { run.wall_ns })
    hand_wall: hand_runs.map(fn(run) { run.wall_ns })
    counted: grammar_runs.all(fn(run) { run.cycles >= 0 }) && hand_runs.all(fn(run) { run.cycles >= 0 })
    Level{
        level: level.copy(),
        trials: trials,
        wall_ns: metric(grammar_wall, hand_wall),
        cycles_u: if counted -> Val(metric(grammar_runs.map(fn(run) { run.cycles }), hand_runs.map(fn(run) { run.cycles }))) else -> None,
        peak_rss_kb: metric(grammar_runs.map(fn(run) { run.peak_kb }), hand_runs.map(fn(run) { run.peak_kb })),
        grammar_wall_ns: grammar_wall,
        hand_wall_ns: hand_wall,
    }
}

cpu_model: fn() -> String? {
    found: regex.match(Regex{"model name\s*:\s*(.*)"}, files.read("/proc/cpuinfo") ?? "") ?? return None
    Val(found.groups[0].copy())
}

line_of: fn(name: String, metric: Metric) -> String {
    "{name} grammar {metric.grammar_median} hand {metric.hand_median} ratio {metric.ratio} [{metric.lower95}, {metric.upper95}] {metric.verdict}"
}

// The launcher JET_GAUNTLET_LAUNCHER names, as the gauntlet's timer takes it,
// else one built into `scratch` from launch.c with `cc`.
launcher: fn(root: String, scratch: String) -> String {
    if sys.get("JET_GAUNTLET_LAUNCHER") == .Val(built) && built != "" -> return built
    path: files.join(scratch, "launch")
    cc: process.cmd([String]{"cc", "-O2", "-o", path, files.join(root, LAUNCH)}).run() ?? fail("cannot build the launcher from {LAUNCH}: {err}")
    if !cc.success -> fail("cannot build the launcher from {LAUNCH}:\n{cc.output}{cc.errors}")
    path
}

run: fn() {
    argv: process.args()
    root: files.cwd() ?? fail("cannot read the working directory: {err}")
    if !files.exists(files.join(root, MANIFEST)) -> fail("run this from the repository root")
    name: argument(argv, "--pair", "")
    if name == "" -> fail("name the pair to measure with --pair")
    manifest: json.decode<Manifest>(files.read(files.join(root, MANIFEST)) ?? fail("{MANIFEST}: {err}")) ?? fail("{MANIFEST} has no readable grammar_pairs list: {err}")
    pair: pair_of(manifest, name)
    given: argument(argv, "--jet", "")
    jet: if given == "" -> [String]{files.join(root, JET_ENV), "jet"} else -> [String]{given}
    n_text: argument(argv, "--n", "{pair.n}")
    n: count(n_text, "--n")
    trials: count(argument(argv, "--trials", "{pair.trials}"), "--trials")
    output: argument(argv, "--output", "")
    corpus: files.join(root, pair.corpus)
    expected: files.read(files.join(root, pair.expected_output)) ?? fail("{pair.expected_output}: {err}")
    scratch_dir: files.temp_dir("grammar-pair") ?? fail("cannot make a scratch directory: {err}")
    scratch: scratch_dir.path
    launch: launcher(root, scratch)
    ^levels: [Level]{}
    ^loss: false
    loop level in pair.levels {
        grammar: build(root, jet, pair.grammar, level, files.join(scratch, "grammar{level}"))
        hand: build(root, jet, pair.hand, level, files.join(scratch, "hand{level}"))
        measured: level_of(launch, scratch, grammar, hand, level, corpus, n_text, trials, expected)
        print("{level} {line_of("wall_ns", measured.wall_ns)}")
        if measured.cycles_u == .Val(cycles) -> print("{level} {line_of("cycles_u", cycles)}")
        print("{level} {line_of("peak_rss_kb", measured.peak_rss_kb)}")
        if measured.wall_ns.verdict == "loss" || measured.peak_rss_kb.verdict == "loss" {
            loss = true
        }
        if measured.cycles_u == .Val(cycles) && cycles.verdict == "loss" -> loss = true
        levels.push(measured)
    }
    verdict: if loss -> "fail" else -> "pass"
    receipt: Receipt{
        schema: "jet.perf.grammar-pair.v1",
        pair: pair.id.copy(),
        n: n,
        levels: levels,
        host: Host{platform: sys.name(), release: sys.release(), arch: sys.arch(), cpu_model: cpu_model(), cpu_count: sys.cpu_count()},
        generated_command: "jet Tools/Perf/GrammarPair.jet --pair {pair.id} --n {n} --trials {trials}",
        verdict: verdict.copy(),
    }
    if output != "" {
        files.write(output, "{json.to_string_pretty(receipt) ?? fail("the receipt: {err}")}\n") ?? fail("{output}: {err}")
    }
    print("grammar pair {pair.id}: {verdict}")
    if verdict != "pass" -> process.exit(1)
}

#Test("a launcher report gives a run's wall time, cycles and peak") {
    run: run_of("start 12 5\ncycles 900\nend 0 2500 -1 4096 10 2 0\n")
    assert_eq(run.wall_ns, 2500)
    assert_eq(run.cycles, 900)
    assert_eq(run.peak_kb, 4096)
}

#Test("a grammar arm slower in every trial is a loss, an even one is not") {
    hand: loop at in 0..<100 -> 1000 + at %% 7
    slower: loop at in 0..<100 -> 1100 + at %% 7
    assert_eq(metric(slower, hand).verdict, "loss")
    assert_eq(metric(hand, hand).verdict, "even")
    assert_eq(metric(hand, slower).verdict, "win")
}

#Test("a pair is the manifest row with its id") {
    row: PairRow{id: "ini", hand: "H", grammar: "G", corpus: "c", expected_output: "e", n: 1, levels: [String]{"-O1"}, trials: 2}
    manifest: Manifest{grammar_pairs: PairList{pairs: [PairRow]{row}}}
    assert_eq(pair_of(manifest, "ini").grammar, "G")
}
