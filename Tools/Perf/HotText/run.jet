// The Jet twin of Tools/Perf/hot-text.mjs. Writes Compiler/JetCLI/hot-text.list:
// the compiler's own functions that the workload's runs enter
// (Tools/Perf/HotText/Workload: a hello, a few small programs that use what
// everyday code does, each a `jet run`, and a small script run as
// `jet script.jet`), the functions more of those runs enter first and, among
// as many, first entry first; then the functions a hello `jet check` and
// `jet build` add, first entry first. Every run compiles its program, as
// nothing is kept, so the functions every run enters come first and share
// the fewest pages, and those most everyday programs enter (number
// formatting, interpolation, string and list methods, a struct's method, a
// match, a loop) come next, before what only some of them reach. `jet build`
// of Compiler/JetCLI lays them out first and its data in the order they
// reach it, so a run touches few pages of the compiler's image and a start
// faults in fewer.
// With `--twins <checkout>`, the functions the cold compiles of the
// scaling-corpora and optimization twins (Tools/Perf/CoreCold/run.jet's
// programs) add come next, each traced as that receipt runs it: out of
// tree, with Core from the compiler's own records.
// Names that no longer name a function are skipped by the build (`--trace`
// counter ir.object.hot_missing). A closure's name keeps while edits move
// its source (JetIR ir_closure_key), and a missing name whose symbol ends in
// a key hash hands its place to the functions of the same stem the list does
// not name when there are no more of them than such names (JetIR
// ir_x64_hot_order), so rows go stale mostly as functions are renamed or
// removed and helpers' hashes change, and the list misses functions added
// since it was traced; `--image` says when a regenerated list is due.
//
//   jet Tools/Perf/HotText/run.jet -- --jet <jet> [--out Compiler/JetCLI/hot-text.list] [--twins <checkout>]
//   jet Tools/Perf/HotText/run.jet --check
//   jet Tools/Perf/HotText/run.jet -- --image <jet>
//
// `--check` needs no build: it fails, listing them, when rows of the list
// name no function the sources declare (hot_text_row_declared). `--image`
// reads the built compiler <jet>: it fails, listing them, when more than
// IMAGE_MISSING_PERCENT percent of the rows name no function of <jet>.
//
// <jet> is a built compiler beside its jet-runtime/ directory. Only the
// compiler's own functions are listed: its object is the link's first input,
// so they are the functions below the first one the runtime pack
// (jet-runtime/jet_runtime.pack.o) defines; libc and libgcc, when a link
// takes them, come after the pack. The environment names the toolchain as for
// any run (JET_TOOLCHAIN_ROOT, JET_COMPILER_IDENTITY). Needs a C compiler
// (`$CC`, default `cc`) and ptrace of a child: each command runs under
// Tools/Perf/fntrace.c, which puts a breakpoint at every function of <jet>
// and records each one's first entry. A failure ends the run with its report
// on stderr and exit 1.
use {
    core.[collections, crypto, files, process, sys]
    core.encoding.binary
    core.text.fmt
}

USAGE: "usage: jet Tools/Perf/HotText/run.jet -- --jet <jet> [--out <file>] [--twins <checkout>] | --check | -- --image <jet>"

LIST: "Compiler/JetCLI/hot-text.list"

// The most rows of the list, in percent, that a built compiler may lack
// before `--image` fails. A cycle's renames and removals cost a few rows
// each and little layout; past this, the hot functions those rows named sit
// among the cold ones, each run faults their pages in apart, and the list is
// due to be regenerated.
IMAGE_MISSING_PERCENT: 3

// The private Core parts: Core sources that are no public module, each
// built under its own module name.
PARTS: "Compiler/Prelude/CoreSourceParts.tsv"

// The source trees the compiler is built from.
SOURCE_DIRS: [String]{"Compiler", "Core", "Jetpack"}

// A copy of one function: an owned clone, a lambda in it, a generic
// instance, a foreign asm body, or the program entry's wrapper.
COPY_SUFFIX: Regex{"(?:\.own\d+|__lambda_[0-9a-f]{{16}}|__[0-9a-f]{{16}}|__asm|__entry)$"}

// A function's declaration, after any attributes (`#Unsafe("why") name: fn`).
FN_DECL: Regex{"^\s*(?:#\w+(?:\((?:\"[^\"]*\"|[^()\"])*\))?\s+)*(\w+)\s*:\s*fn\b"}

TYPE_DECL: Regex{"^(\w+)(?:<[^>]*>)?\s*:\s*(?:struct|enum)\b"}

// The workload's programs: each trace runs one in a fresh project.
WORKLOAD: "Tools/Perf/HotText/Workload"

// The twins' files a `--twins` trace needs, copied out of the checkout as
// Tools/Perf/CoreCold/run.jet copies them.
TWIN_COPIED: [String]{
    "Tools/Agent/JetEnv.jet",
    "Tools/Gauntlet/Entries/Optimization",
    "Tools/Gauntlet/Entries/ScalingCorpora",
    "Tools/Gauntlet/Harness/run.mjs",
    "Tools/Gauntlet/Kit",
    "Tools/Gauntlet/Optimization",
    "Tools/Perf/Scaling/Corpora",
}

TWIN_SCALING: "Gauntlet/Entries/ScalingCorpora/Driver/run.jet"

TWIN_OPTIMIZATION: "Tools/Gauntlet/Optimization/Optimization/run.jet"

// One trace: its program (a file of WORKLOAD) and the argv it runs with, in
// a fresh project, or (`dir` not empty) in `dir` of the twins' copy, out of
// tree. The `ranked` traces are the workload's runs, whose functions are
// listed by how many of them enter each (ranked_names).
Trace: struct {
    file: String,
    argv: [String],
    dir: String,
    ranked: Bool,
}

Symbol: struct {
    value: Int,
    name: String,
}

run: fn() -> Never Err! {
    // The checkout: three up from Tools/Perf, which holds this program's directory.
    root: files.normalize("{sys.executable()}/../../../..")
    argv: process.args()
    if argv.len() == 1 && argv[0] == "--check" {
        print(check(root))
        process.exit(0)
    }
    if argv.len() == 2 && argv[0] == "--image" {
        print(check_image(root, files.resolve(argv[1])))
        process.exit(0)
    }
    args := [String:String]{"jet": "", "out": files.join(root, LIST), "twins": ""}
    i := 0
    loop i < argv.len() {
        key: argv[i].remove_prefix("--")
        if !args.has_key(key) || i + 1 >= argv.len() -> return Err(USAGE)
        args[key] = files.resolve(argv[i + 1])
        i += 2
    }
    jet: args["jet"]
    if jet == "" -> return Err("--jet is required")
    jet_bytes: files.read_bytes(jet)
    pack_path: files.join(files.dirname(jet), "jet-runtime/jet_runtime.pack.o")
    pack: function_symbols(files.read_bytes(pack_path), pack_path).map(fn(symbol) { symbol.name }).to_set()
    symbols: function_symbols(jet_bytes, jet)
    boundary: symbols.filter(fn(symbol) { pack.has(symbol.name) }).map(fn(symbol) { symbol.value }).min() ?? return Err("{jet} defines none of the runtime pack's functions")
    // `main` is the object's first function whatever the list says.
    addresses := [Int]{}
    by_address := [Int:String]{}
    loop symbol in symbols.filter(fn(symbol) { symbol.value < boundary && symbol.name != "main" }) {
        if by_address.has_key(symbol.value) -> next
        addresses.push(symbol.value)
        by_address[symbol.value] = symbol.name.copy()  // copy: the map owns its names
    }
    work: files.temp_dir("hot-text")
    tracer: files.join(work.path, "fntrace")
    process.cmd([process.env_nonempty("CC") ?? "cc", "-O2", "-o", tracer, files.join(root, "Tools/Perf/fntrace.c")]).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run_checked()
    address_file: files.join(work.path, "addresses")
    files.write(address_file, "{addresses.map(fn(value) { fmt.hex(value, 1) }).join("\n")}\n")
    traces := [Trace]{
        {file: "hello.jet", argv: [String]{"run", "hello.jet"}, dir: "", ranked: true},
        {file: "numbers.jet", argv: [String]{"run", "numbers.jet"}, dir: "", ranked: true},
        {file: "text.jet", argv: [String]{"run", "text.jet"}, dir: "", ranked: true},
        {file: "shapes.jet", argv: [String]{"run", "shapes.jet"}, dir: "", ranked: true},
        {file: "script.jet", argv: [String]{"script.jet", "script.jet"}, dir: "", ranked: true},
        {file: "hello.jet", argv: [String]{"check", "hello.jet"}, dir: "", ranked: false},
        {file: "hello.jet", argv: [String]{"build", "hello.jet"}, dir: "", ranked: false},
    }
    twins: files.join(work.path, "twins")
    if args["twins"] != "" {
        loop path in TWIN_COPIED {
            twin_copy(files.join(args["twins"], path), files.join(twins, path))
        }
        traces.push({file: "", argv: [String]{"check", TWIN_SCALING}, dir: "Tools", ranked: false})
        traces.push({file: "", argv: [String]{TWIN_SCALING, "--", "shapes"}, dir: "Tools", ranked: false})
        traces.push({file: "", argv: [String]{files.join(twins, TWIN_OPTIMIZATION), "--", "plan", "--manifest", "manifest.json"}, dir: "Tools/Gauntlet/Entries/Optimization/Fixtures", ranked: false})
    }
    names := [String]{}
    listed := Set<String>.new()
    ranked := [[String]]{}
    loop index in 0..<traces.len() {
        trace: traces[index]
        // Each trace has a user cache of its own, empty, and a project of its
        // own unless it runs in the twins' copy; that one also has an empty
        // store and names no toolchain tree, as a cold run out of tree.
        entered: files.join(work.path, "{index}.entered")
        command := process.cmd([tracer, address_file, entered, "--", jet].concat(trace.argv)).env("XDG_CACHE_HOME", files.join(work.path, "cache-{index}"))
        if {
            trace.dir == "" -> {
                project: files.join(work.path, "trace-{index}")
                files.create_dir_all(project)
                files.copy(files.join(files.join(root, WORKLOAD), trace.file), files.join(project, trace.file))
                command = command.cwd(project)
            }
            else -> {
                command = command.cwd(files.join(twins, trace.dir)).env("JET_STORE_DIR", files.join(work.path, "store-{index}")).env_remove("JET_TOOLCHAIN_ROOT").env_remove("JET_SEED")
            }
        }
        command.stdin(.Capture).stdout(.Capture).stderr(.Inherit).run_checked()
        traced := [String]{}
        loop line in files.read(entered).split("\n").filter(fn(line) { line != "" }) {
            name: by_address.get(Int.from_radix(line, 16) ?? return Err("Cannot convert 0x{line} to a BigInt")) ?? next
            traced.push(name.copy())  // copy: the map keeps its names
        }
        if trace.ranked {
            ranked.push(traced)
            // The last of the workload's runs: their functions come first.
            if index + 1 < traces.len() && traces[index + 1].ranked -> next
            loop name in ranked_names(ranked) {
                listed.add(name.copy())  // copy: the set and the list each keep the name
                names.push(name)
            }
            next
        }
        loop name in traced {
            if listed.add(name.copy()) -> names.push(name)  // copy: the set and the list each keep the name
        }
    }
    digest: String.from_bytes_lossy(crypto.sha256(jet_bytes).hex().bytes()[0..<16])
    twin_runs: if args["twins"] != "" -> ", then the scaling-corpora twin's cold `jet check` and run and the optimization twin's cold run" else -> ""
    lines: [String]{
        "# Generated by `node Tools/Perf/HotText.mjs`; do not edit.",
        "# The {names.len()} functions the runs of Tools/Perf/HotText/Workload's programs entered, those more runs entered first, then those a hello `jet check` and `jet build`{twin_runs} added, first entry first (jet sha256 {digest}).",
    }.concat(names)
    files.write(args["out"], "{lines.join("\n")}\n")
    print("{args["out"]}: {names.len()} functions")
    process.exit(0)
}

// The names the workload's runs entered (`entries`: per run its entered
// names, first entry first): those more runs entered first, then, among as
// many, the one entered first in run order first.
ranked_names: fn(entries: [[String]]) -> [String] Never! {
    order := [String]{}
    counts := [String:Int]{}
    loop names in entries {
        seen := Set<String>.new()
        loop name in names {
            if !seen.add(name.copy()) -> next
            count: counts.get(name) ?? 0
            if count == 0 -> order.push(name.copy())
            counts[name.copy()] = count + 1
        }
    }
    rows := loop (at, name) in order -> {name: name.copy(), count: counts[name], at: at}
    rows.sort_by(fn(left: {name: String, count: Int, at: Int}, right: {name: String, count: Int, at: Int}) { (right.count <=> left.count).then(left.at <=> right.at) })
    loop row in rows -> row.name.copy()
}

#Test("the workload's functions come by how many runs entered them, then by first entry") {
    ranked: ranked_names(
        [[String]]{
            [String]{"parse", "print", "parse"},
            [String]{"lower", "print"},
            [String]{"print", "lower", "emit"},
        },
    )
    assert(ranked == [String]{"print", "lower", "parse", "emit"})
}

// Copies `from`, a file or a directory without its `.jet` build folders, to
// `to`.
twin_copy: fn(from: String, to: String) Err! {
    if !files.is_dir(from) {
        files.create_dir_all(files.dirname(to))
        files.copy(from, to)
        return
    }
    loop walked in files.walk_files(from, skip: [String]{".jet"}) {
        entry: walked ?? return Err("cannot walk {from}: {err}")
        target: files.join(to, files.relative(entry.path, from))
        files.create_dir_all(files.dirname(target))
        files.copy(entry.path, target)
    }
}

// `--check`: the list's rows that name no function the sources declare, as
// the failure, else how many rows were read.
check: fn(root: String) -> String Err! {
    declared: hot_text_declared(root)
    rows: files.read(files.join(root, LIST)).lines().filter(fn(line) { line != "" && !line.starts_with("#") })
    stale: rows.filter(fn(row) { !hot_text_row_declared(declared, row) })
    if stale.len() > 0 {
        return Err("{LIST}: {stale.len()} of {rows.len()} rows name no function the sources declare; regenerate the list (jet Tools/Perf/HotText/run.jet -- --jet <jet>):\n{stale.join("\n")}")
    }
    Ok("{LIST}: all {rows.len()} rows name a function the sources declare")
}

// `--image`: the list's rows that name no function of the built compiler
// `jet`, as the failure when they are more than IMAGE_MISSING_PERCENT
// percent of the rows (image_missing_over), else how many there are.
check_image: fn(root: String, jet: String) -> String Err! {
    names: function_symbols(files.read_bytes(jet), jet).map(fn(symbol) { symbol.name }).to_set()
    rows: files.read(files.join(root, LIST)).lines().filter(fn(line) { line != "" && !line.starts_with("#") })
    missing: rows.filter(fn(row) { !names.has(row) })
    report: "{LIST}: {missing.len()} of {rows.len()} rows name no function of {jet}"
    if image_missing_over(missing.len(), rows.len()) {
        return Err("{report}, over {IMAGE_MISSING_PERCENT}%; regenerate the list (jet Tools/Perf/HotText/run.jet -- --jet {jet}):\n{missing.join("\n")}")
    }
    Ok(report)
}

// Whether `missing` of `rows` rows are more than IMAGE_MISSING_PERCENT
// percent of them.
image_missing_over: fn(missing: Int, rows: Int) -> Bool Never! {
    missing * 100 > rows * IMAGE_MISSING_PERCENT
}

#Test("the image check fails past its share of missing rows") {
    assert(!image_missing_over(0, 11234))
    assert(!image_missing_over(337, 11234))
    assert(image_missing_over(338, 11234))
    assert(image_missing_over(1, 0))
}

// What the sources declare, under the names the build gives functions
// (JetIR ir_symbol_name: the module and the name made one C identifier). A
// source file's module is its name, so `jet_cli_run: fn` in Host.jet, or a
// method of that name there, is `Host_jet_cli_run`. A Core file's module is
// `core.` and its directories' snake_case names, then the file's own unless
// it names its directory: `decode_scalars: fn` in
// Core/Text/Runtime/KernelTextWidth.jet is
// `core_text_runtime_kernel_text_width_decode_scalars`, and `read: fn` in
// Core/Files/Files.jet is `core_files_read`. A private Core part's module is
// its name in PARTS: `start: fn` in Core/Crypto/MD.jet is
// `__core_crypto_md_start`. `modules` holds every file's modules, `typed`
// those that declare a struct or an enum, whose order the compiler derives
// (`<module>_compare`).
HotTextDeclared: struct {
    functions: Set<String>,
    modules: Set<String>,
    typed: Set<String>,
}

hot_text_declared: fn(root: String) -> HotTextDeclared Err! {
    declared := HotTextDeclared{functions: Set.from([String]{}), modules: Set.from([String]{}), typed: Set.from([String]{})}
    parts: hot_text_parts(files.read(files.join(root, PARTS)))
    loop dir in SOURCE_DIRS {
        top: files.join(root, dir)
        loop walked in files.walk_files(top) {
            entry: walked ?? return Err("cannot walk {top}: {err}")
            if !entry.relative.ends_with(".jet") -> next
            hot_text_declare(declared, hot_text_modules(dir, entry.relative, parts), files.read(files.join(top, entry.relative)))
        }
    }
    Ok(declared)
}

// The private Core parts of `table` (PARTS' rows: module, owner, path, ...)
// by their source path.
hot_text_parts: fn(table: String) -> [String:String] Never! {
    parts := [String:String]{}
    loop line in table.lines() {
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() > 2 -> parts[fields[2].copy()] = fields[0].copy()  // copy: the map owns its rows
    }
    parts
}

// The module names the build may give the file at `relative` under `dir`;
// `parts` maps a private Core part's path to its module.
hot_text_modules: fn(dir: String, relative: String, parts: [String:String]) -> [String] Never! {
    stem: files.stem(relative)
    if dir != "Core" -> return [String]{stem}
    if parts.get("Core/{relative}") == .Val(part) -> return [String]{part}
    segments: relative.split("/").to_list()
    path: ["core"].concat(segments[0..<segments.len() - 1].map(fn(segment) { hot_text_snake(segment) })).join("_")
    [String]{path, "{path}_{hot_text_snake(stem)}"}
}

// The snake_case name of a PascalCase path segment, as the compiler names
// Core modules (`KernelTextWidth` is `kernel_text_width`, `HTTPServer` is
// `http_server`).
hot_text_snake: fn(segment: String) -> String Never! {
    bytes: segment.bytes()
    out := [U8]{}
    loop index in 0..<bytes.len() {
        code: Int{bytes[index]}
        upper: code >= 65 && code <= 90
        if upper && index > 0 {
            previous: Int{bytes[index - 1]}
            following: if index + 1 < bytes.len() -> (Int{bytes[index + 1]}) else -> 0
            acronym_end: previous >= 65 && previous <= 90 && following >= 97 && following <= 122
            if acronym_end || (previous >= 97 && previous <= 122) || (previous >= 48 && previous <= 57) {
                out.push(U8{95})
            }
        }
        out.push(if upper -> U8{code + 32} else -> bytes[index])
    }
    String.from_bytes_lossy(out)
}

// Adds what `text`, the source of a file the build names by `modules`,
// declares.
hot_text_declare: fn(declared: &HotTextDeclared, modules: [String], text: String) Never! {
    loop prefix in modules -> declared.modules.add(prefix.copy())  // copy: the set owns its names
    loop line in text.lines() {
        if FN_DECL.match(line) == .Val(found) {
            name: found.group(1) ?? next
            loop prefix in modules -> declared.functions.add("{prefix}_{name}")
        } else if TYPE_DECL.is_match(line) {
            loop prefix in modules -> declared.typed.add(prefix.copy())
        }
    }
}

// Whether list row `row` names a function `declared` holds. A row may name
// a copy of one (COPY_SUFFIX); `jet_ir_` rows are helpers the build makes
// (drops, clones, stop polls), with no source to check. The build also makes
// a module's failure conversions (`<module>_errconv_<Source>_to_<Target>`)
// and a typed module's computed-field getters (`<module>___computed_<field>`).
hot_text_row_declared: fn(declared: HotTextDeclared, row: String) -> Bool Never! {
    name := row.copy()
    loop COPY_SUFFIX.is_match(name) -> name = COPY_SUFFIX.replace_first(name, "")
    if name.starts_with("jet_ir_") || declared.functions.has(name) -> return true
    if declared.modules.has(name.split("_errconv_").to_list()[0]) && name.contains("_errconv_") {
        return true
    }
    if declared.typed.has(name.split("___computed_").to_list()[0]) && name.contains("___computed_") {
        return true
    }
    name.ends_with("_compare") && declared.typed.has(name.remove_suffix("_compare"))
}

#Test("a row names a declared function, a copy of one, or a build-made helper") {
    declared := HotTextDeclared{functions: Set.from([String]{}), modules: Set.from([String]{}), typed: Set.from([String]{})}
    parts: hot_text_parts("# module\towner\tpath\n__core_crypto_md\tcore.crypto\tCore/Crypto/MD.jet\t__core_crypto_md\t\t\n")
    hot_text_declare(declared, hot_text_modules("Compiler", "JetCLI/Source/CLI/Host.jet", parts), "jet_cli_run: fn() {{\n    open: fn(self) -> Int {{ 1 }}\n}}\nRow: struct {{\n}}\n#Unsafe(\"the caller owns `n()` bytes\") put_text: fn(at: Int) -> Int {{ at }}\n")
    hot_text_declare(declared, hot_text_modules("Compiler", "JetCLI/Source/CLI/Plain.jet", parts), "plain: fn() -> Int {{ 1 }}\n")
    hot_text_declare(declared, hot_text_modules("Core", "Files/Files.jet", parts), "is_dir: fn(path: String) -> Bool {{ false }}\n")
    hot_text_declare(declared, hot_text_modules("Core", "Text/Runtime/KernelTextWidth.jet", parts), "decode_scalars: fn(text: String) -> [Int] {{ [] }}\n")
    hot_text_declare(declared, hot_text_modules("Core", "Crypto/MD.jet", parts), "start: fn() -> Int {{ 0 }}\n")
    assert(hot_text_row_declared(declared, "Host_jet_cli_run"))
    assert(hot_text_row_declared(declared, "Host_open"))
    assert(hot_text_row_declared(declared, "Host_put_text"))
    assert(hot_text_row_declared(declared, "Host_jet_cli_run.own2"))
    assert(hot_text_row_declared(declared, "Host_jet_cli_run__lambda_c6ecc473a20ea58a"))
    assert(hot_text_row_declared(declared, "Host_jet_cli_run__4c09dc3a67987b87"))
    assert(hot_text_row_declared(declared, "Host_compare"))
    assert(hot_text_row_declared(declared, "Host___computed_path"))
    assert(hot_text_row_declared(declared, "Plain_errconv_IOError_to_LockError"))
    assert(hot_text_row_declared(declared, "core_files_is_dir"))
    assert(hot_text_row_declared(declared, "core_text_runtime_kernel_text_width_decode_scalars"))
    assert(hot_text_row_declared(declared, "__core_crypto_md_start"))
    assert(hot_text_row_declared(declared, "jet_ir_drop_7906809aed821885"))
    assert(!hot_text_row_declared(declared, "Host_jet_cli_parse_root"))
    assert(!hot_text_row_declared(declared, "Plain___computed_path"))
    assert(!hot_text_row_declared(declared, "Gone_errconv_IOError_to_LockError"))
    assert(!hot_text_row_declared(declared, "core_files_compare"))
    assert(!hot_text_row_declared(declared, "core_files_stat"))
    assert(!hot_text_row_declared(declared, "core_text_decode_scalars"))
    assert(!hot_text_row_declared(declared, "core_crypto_md_start"))
    assert(!hot_text_row_declared(declared, "__core_crypto_md_hash_start"))
    assert_eq(hot_text_snake("HTTPServer"), "http_server")
    assert_eq(hot_text_snake("SSL"), "ssl")
}

// The little-endian `format` fields of the ELF file `bytes` at `at`.
fields: fn(bytes: [U8], at: Int, format: String, path: String) -> [Int] Err! {
    width: binary.calcsize(format) ?? 0
    Ok(binary.unpack(format, collections.slice_clamped(bytes, at, at + width)) ?? return Err("{path}: not an ELF file, or one cut short"))
}

// Every sized FUNC symbol of the ELF file `bytes`, in symbol-table order.
function_symbols: fn(bytes: [U8], path: String) -> [Symbol] Err! {
    // e_shoff, then e_shnum.
    header: fields(bytes, 40, "<Q12xH", path)
    symbols := [Symbol]{}
    loop k in 0..<header[1] {
        // sh_type, sh_offset, sh_size and sh_link.
        table: fields(bytes, header[0] + 64 * k, "<4xI16xQQI", path)
        if table[0] != 2 -> next
        strings: fields(bytes, header[0] + 64 * table[3], "<24xQ", path)
        loop entry in 0..<(table[2] + 23) /% 24 {
            // st_name, st_info, st_value and st_size.
            symbol: fields(bytes, table[1] + 24 * entry, "<IB3xQQ", path)
            if symbol[1] & 15 != 2 || symbol[3] == 0 -> next
            symbols.push(Symbol{value: symbol[2], name: c_string(bytes, strings[0] + symbol[0])})
        }
    }
    Ok(symbols)
}

// The NUL-ended text at `start` of `bytes`; none past their end.
c_string: fn(bytes: [U8], start: Int) -> String Never! {
    end := min(start, bytes.len())
    loop end < bytes.len() && bytes[end] != 0 -> end += 1
    String.from_bytes_lossy(bytes[min(start, end)..<end])
}
