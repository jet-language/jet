// Everyday arithmetic: Int and Float values, their operators and formatting
// in interpolation, and a loop that sums.
run: fn() {
    count: 12
    price: 4.25
    total: price * 3.0
    print("{count} items, {total} for three")
    print("halves {count /% 5}, left {count % 5}, cubed {count.pow(3)}")
    ^sum: 0
    loop n in 1..<11 -> sum += n * n
    print("squares to 10: {sum}, mean {Float{sum} / 10.0}")
}
