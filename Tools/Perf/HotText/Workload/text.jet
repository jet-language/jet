// Everyday text and list work: string methods, a list's map, filter and
// sort, and joining the result.
run: fn() {
    line: "  the quick brown fox jumps over the lazy dog  "
    words: line.trim().split(" ").to_list()
    long: words.filter(fn(w) { w.len() > 3 }).map(fn(w) { w.to_upper() })
    sorted := words.copy()
    sorted.sort()
    print("{words.len()} words, long: {long.join(", ")}")
    print("first sorted: {sorted[0]}, has fox: {line.contains("fox")}")
    print(line.trim().replace("dog", "cat"))
}
