// The Jet twin of Tools/Perf/JetcProfile/Live.sh: `jet perf attach` samples a
// running jet, and the processes it started, from outside for the window
// given (`500ms`, `20s`; 20 seconds when none is), and `jet perf view` shows
// which of their functions the CPU was in. It attaches only; it never starts
// or restarts the compiler.
//
//   jet Tools/Perf/JetcProfile/Live/run.jet -- PID [WINDOW]
//
// JET names the jet that attaches, else the one on PATH. JET_PROFILE_OUT names
// the output directory; its default and the roots under it come from
// Tools/Agent/roots.sh's table. A failing step ends the run with its status,
// its report on stderr.
use core.[files, process, regex, sys, term, time]

USAGE: "usage: live.sh <pid> [<window>, as 500ms or 20s]"

run: fn() -> Never Err! {
    args: process.args()
    window: if args.len() == 2 -> args[1] else -> "20s"
    if args.len() < 1 || args.len() > 2 || !regex.is_match(Regex{"^[1-9][0-9]*$"}, args[0]) || !regex.is_match(Regex{"^[1-9][0-9]*(ms|s)$"}, window) {
        process.fail(2, USAGE)
    }
    pid: args[0]
    step(Sh{"kill -0 {pid}"}.status())
    jet: process.env_nonempty("JET") ?? "jet"
    // What sourcing roots.sh leaves set: the environment with the machine's
    // env file over it, the two roots, and the output directory over them.
    loaded: sys.env_file("{sys.config_dir() ?? ""}/jet/env")
    stamp: time.now().in_host_zone().format("%Y%m%d-%H%M%S")
    roots: sys.env_text(
        """
        JET_STATE_ROOT=${{JET_STATE_ROOT:-${{XDG_CACHE_HOME:-$HOME/.cache}}/jet-dev}}
        JET_SCRATCH_ROOT=${{JET_SCRATCH_ROOT:-$JET_STATE_ROOT}}
        JET_PROFILE_OUT=${{JET_PROFILE_OUT:-$JET_SCRATCH_ROOT/sol/SolJetcProfile/jetc-{pid}-{stamp}}}
        """,
        loaded,
    )
    out: roots["JET_PROFILE_OUT"]
    files.create_dir_all(out)
    term.eprint("Sampling PID {pid} for {window}; output: {out}")
    trace: files.join(out, "attach.jettrace")
    step(Sh{"{jet} perf attach {pid} --for={window} --out {trace}"}.status())
    view: Sh{"{jet} perf view {trace}"}.run()
    step(view.code)
    shown: files.join(out, "view.txt")
    files.write(shown, view.output)
    stdout := term.stdout()
    stdout.write_bytes(files.read_bytes(shown))
    print("Artifacts: {out} (attach.jettrace, view.txt)")
    process.exit(0)
}

// Ends the program with the status of a step that failed.
step: fn(status: Int) -[Exec]> {
    if status != 0 -> process.exit(status)
}
