package: {
    name: "llm_probe"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use {
    web: core.web
    http_client: core.http.client
    http_server: core.http.server
    net: core.net
}

handle_completion: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    body: req.body().text(4096) ?? ""
    if body.contains("tool_result") {
        return Ok(http_server.sse("data: {{\"choices\":[{{\"delta\":{{\"content\":\"done\"}}}}]}}\n\ndata: [DONE]\n\n"))
    }
    return Ok(http_server.sse("data: {{\"choices\":[{{\"delta\":{{\"tool_calls\":[{{\"id\":\"call-1\",\"function\":{{\"name\":\"lookup\",\"arguments\":\"{{\\\"key\\\":\\\"jet\\\"}}\"}}}}]}}}}]}}\n\ndata: [DONE]\n\n"))
}

run: fn() (HTTPError | NetError | TaskFailure)! {
    listener: net.tcp_listen("127.0.0.1:0")
    addr: listener.local_addr()
    mux: web.app()
    mux.post("/v1/chat/completions", fn(req: HTTPRequest) { handle_completion(req) })
    t: task {
        mux.serve_once(listener)
        mux.serve_once(listener)
    }
    loop step in 0..<2 {
        body := if {
            step == 0 -> "{{\"model\":\"mock\",\"stream\":true,\"messages\":[{{\"role\":\"user\",\"content\":\"lookup\"}}]}}"
            else -> "{{\"model\":\"mock\",\"stream\":true,\"tool_result\":{{\"id\":\"call-1\",\"content\":\"ok\"}}}}"
        }
        req: http_client.request("POST", "http://{addr}/v1/chat/completions").body(body).header("content-type", "application/json").read_timeout(1000)
        resp: req.send()
        text: resp.body().text(8 * 1024 * 1024) ?? "invalid body"
        streamed: text.contains("data:")
        tool_call: text.contains("tool_calls")
        print("step={step} status={resp.status()} streamed={streamed} tool_call={tool_call}")
    }
    t.join()
    print("bounded_tool_loop=2")
}
