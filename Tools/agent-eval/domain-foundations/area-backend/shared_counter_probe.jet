package: {
    name: "shared_counter_probe"
    authority: { allow: [IO, Mem.Alloc, Mem.Rc, Time.Wait] }
}

Counter: struct {
    value: Int
}

increment: fn(counter: Shared<Counter>) {
    counter.guard_edit().value.value += 1
}

run: fn() {
    counter: shared Counter{value: 0}
    workers := [Task<()>]{}
    loop _ in 1..1000 {
        workers.push(task {
            increment(counter)
        })
    }
    loop workers.len() > 0 {
        worker: workers.pop() ?? panic("missing worker")
        worker.join() ?? panic("worker failed")
    }
    print("count:{counter.guard_read().value.value}")
}
