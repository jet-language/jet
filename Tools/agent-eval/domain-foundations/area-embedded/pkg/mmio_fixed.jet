use mem: core.mem

gpio_register_write: fn(value: Int) -> Int {
    #Unsafe("board.sensor_v1 GPIO register 0x40000100 is a volatile MMIO word") {
        pointer: mem.Ptr<Int>.from_addr(0x40000100)
        mem.volatile_write(pointer, value)
        return mem.volatile_read(pointer)
    }
}

run: fn() {
    print("fixed MMIO function admitted")
}
