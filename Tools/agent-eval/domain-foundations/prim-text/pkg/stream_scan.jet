package {
    name: "stream_scan"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Time, Time.Wait] }
}

use {
    files :: core.files
    re :: core.regex
    time :: core.time
}

fn run() {
    path :: Path.from("/home/nate/.cache/jet-dev/dx3/prim-text/fixtures/logs_100m.txt")
    handle :: files.open(path.copy())
    pattern :: Regex{"ERROR .* user_id=\d+"}
    started :: time.instant()
    lines := 0
    matches := 0
    loop line in handle.lines() {
        lines += 1
        if pattern.is_match(line) {
            matches += 1
        }
    }
    print("lines={lines} matches={matches} elapsed_ms={started.elapsed_millis()}")
}
