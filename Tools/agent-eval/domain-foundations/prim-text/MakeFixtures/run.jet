// Writes the prim-text benchmark inputs: fixtures/corpus_1m.txt (1 MiB of a
// mixed-script seed line) and fixtures/logs_100m.txt (100 MB of three log lines),
// each the seed repeated and cut at the exact size.
// Usage (from the repository root):
//   jet run Tools/agent-eval/domain-foundations/prim-text/MakeFixtures
use core.files as files
use core.process as process
use core.term as term

FIXTURES :: "Tools/agent-eval/domain-foundations/prim-text/fixtures"
CORPUS_BYTES :: 1048576
LOGS_BYTES :: 100000000

fn repeated(seed: String, size: Int) -> [U8] Never! {
    bytes :: seed.bytes()
    out := [U8]{}
    loop out.len() < size {
        loop byte in bytes {
            if out.len() == size -> break
            &out.push(byte)
        }
    }
    out
}

fn write_fixture(name: String, bytes: [U8]) -[FS.Write, IO]> Bool Never! {
    path :: "{FIXTURES}/{name}"
    if files.write_bytes(path, bytes) == {
        .Ok(_) -> true
        .Err(error) -> {
            term.eprint("make_fixtures: cannot write {path}: {error}")
            false
        }
    }
}

fn run() {
    if files.create_dir_all(FIXTURES) == {
        .Ok(_) -> {}
        .Err(error) -> {
            term.eprint("make_fixtures: cannot create {FIXTURES}: {error}")
            process.exit(1)
        }
    }
    corpus :: repeated("Hello café κόσμε नमस्ते سلام — Jet tokenizer search. The quick brown fox jumps over 42 logs; user_id=31415 level=INFO.\n", CORPUS_BYTES)
    if !write_fixture("corpus_1m.txt", corpus) -> process.exit(1)
    log_seed :: "2026-09-02T00:00:00Z INFO api request user_id=31415 path=/orders status=200\n2026-09-02T00:00:01Z WARN api retry user_id=27182 path=/orders status=503\n2026-09-02T00:00:02Z ERROR db timeout user_id=16180 path=/orders status=500\n"
    logs :: repeated(log_seed, LOGS_BYTES)
    if !write_fixture("logs_100m.txt", logs) -> process.exit(1)
    print("corpus_1m_bytes={corpus.len()}")
    print("logs_100m_bytes={logs.len()}")
}
