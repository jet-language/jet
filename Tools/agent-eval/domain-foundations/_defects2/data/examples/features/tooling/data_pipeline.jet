use data: core.data

#Codable
Ticket: struct {
    team: String
    minutes: Float
}

#Codable
Budget: struct {
    team: String
    owner: String
}

must_stay_deferred: fn(ticket: Ticket) -> Bool {
    panic("lazy filter ran before collect")
    return false
}

no_minutes: fn() -> Float? { None }

run: fn() {
    raw: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nDocs,3.0"
    rows: data.csv<Ticket>(raw) ?? panic("bad csv")
    budget_raw: "team,owner\nCore,Ada\nCore,Lin\nTools,Grace"
    budgets: data.csv<Budget>(budget_raw) ?? panic("bad budget")
    table: data.table(rows)
    lazy: data.lazy(table)
    deferred: data.lazy_filter(lazy, fn(t) { must_stay_deferred(t) })
    print("deferred: {data.plan(deferred)[1]}")
    planned: data.lazy_sort_by(data.lazy_filter(lazy, fn(t) { t.minutes >= 4.0 }), fn(t) { t.team })
    collected: data.collect(planned) ?? panic("collect")
    planned_rows: data.rows(collected)
    focused: data.filter(rows, fn(t) { t.minutes >= 4.0 })
    sorted: data.sort_by(focused, fn(t) { t.team }) ?? panic("sort")
    groups: data.group_sum(sorted, fn(t) { t.team }, fn(t) { t.minutes }) ?? panic("group_sum")
    joined: data.inner_join(sorted, budgets, fn(t) { t.team }, fn(b) { b.team }) ?? panic("join")
    left: data.left_join(rows, budgets, fn(t) { t.team }, fn(b) { b.team }) ?? panic("left")
    pivot: data.pivot_sum(rows, fn(t) { t.team }, fn(t) { if t.minutes >= 5.0 -> "long" else -> "short" }, fn(t) { t.minutes }) ?? panic("pivot")
    values: [Float]{4.0, 5.0, 8.0, 3.0}
    summary: data.describe(values) ?? panic("describe")
    rolling: data.rolling_mean(values, 2) ?? panic("rolling")
    maybe_minutes: [Val(Float{4.0}), no_minutes(), Val(Float{8.0}), no_minutes()]
    series: data.series(maybe_minutes)
    print(data.count(sorted))
    print(data.count(table))
    print(data.count(planned))
    print(data.count(planned_rows))
    print(data.plan(planned)[2])
    loop ticket in planned_rows -> print("planned: {ticket.team} {ticket.minutes}")
    print(data.missing_count(series))
    print(data.bar_text(groups) ?? panic("bar"))
    loop pair in joined -> print("join: {pair.left.team} -> {pair.right.owner}")
    loop pair in left {
        if pair.right == {
            .Val(budget) -> { print("left: {pair.left.team} -> {budget.owner}") }
            .None -> { print("left: {pair.left.team} -> none") }
        }
    }
    loop cell in pivot -> print("{cell.row_key}|{cell.column_key} count={cell.count} sum={cell.sum}")
    print(summary.count)
    print(summary.median)
    print(rolling[2])
}
