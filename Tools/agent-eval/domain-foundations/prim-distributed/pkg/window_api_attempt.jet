// Deliberately probes the missing unbounded stream surface.
Event: struct {
    key: String
    timestamp: Int
    value: Int
}

source: fn() -> Stream<Event> {
    yield Event{key: "a", timestamp: 1, value: 1}
}

run: fn() {
    keyed: source().key_by(fn(event: Event) { event.key })
    print(keyed)
}
