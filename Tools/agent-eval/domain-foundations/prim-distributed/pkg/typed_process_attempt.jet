// Deliberately probes whether a ProcessChild exposes a typed message endpoint.
package {
    name: "typed_process_attempt"
    authority: { holds: { allow: [Exec, Mem.Alloc, Time.Wait] } }
}

use core.process as process

fn run() {
    child :: process.cmd(["echo", "ready"]).spawn() ?? panic("spawn failed")
    child.send(7)
    child.wait() ?? panic("wait failed")
}
