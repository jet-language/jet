// Child process for prim-distributed message passing.
package {
    name: "socket_worker"
    authority: { allow: [Exec.Args, Mem.Alloc, Net, Time.Wait] }
}

use {
    net :: core.net
    process :: core.process
}

fn run() {
    args :: process.argv()
    addr :: args.get(1) ?? panic("missing listener address")
    stream :: net.tcp_connect(addr)
    request :: stream.read_text(8192)
    value :: request.trim().to_int() ?? panic("typed message was not Int")
    response :: (value * value).to_string()
    stream.write_all(response.bytes())
    stream.close()
}
