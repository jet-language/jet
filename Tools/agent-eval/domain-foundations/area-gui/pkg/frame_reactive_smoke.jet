package: {
    name: "frame_reactive_smoke"
    authority: { allow: [Browser, Env, IO, Mem.Alloc] }
}

use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    body := reactive.signal("old")
    backend := ui.tui_backend()
    render_backend: backend.copy()
    ui.reactive_render(fn() {
        ui.mount(render_backend, ui.box([
            ui.text(body.get()),
            ui.button("Save", on_click: fn() { print("save") })
        ]))
    })
    loop line in backend.frame_lines() -> print("frame: {line}")
    body.set("new")
    loop line in backend.frame_lines() -> print("updated: {line}")
}
