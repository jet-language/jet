package: {
    name: "reactive_conditional_smoke"
    authority: { allow: [Browser, IO, Mem.Alloc] }
}

use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    selected := reactive.signal(0)
    backend := ui.tui_backend()
    render_backend: backend.copy()
    ui.reactive_render(() -> {
        marker: if selected.get() == 0 -> "* " else -> "  "
        ui.mount(render_backend, ui.text("{marker}Meeting"))
    })
    print("initial: {backend.render_count()}")
    &selected.set(1)
    print("updated: {backend.render_count()}")
}
