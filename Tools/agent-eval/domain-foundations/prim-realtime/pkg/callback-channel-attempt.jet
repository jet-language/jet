package {
    name: "callback-channel-attempt"
    authority: { holds: { allow: [IO, Time.Wait] } }
}

fn callback(&buffer: [Float#4], tx: Sender<Int>) -[!Mem.Alloc, !Time]> {
    loop i in 0..<buffer.len() {
        buffer[i] = 0.5
    }
    tx.send(1)
}

fn run() {
    buffer := [Float#4]{0.0, 0.0, 0.0, 0.0}
    { sender: tx, receiver: rx } :: channel<Int>(capacity: 1)
    callback(&buffer, tx)
    print(rx.receive() ?? 0)
}
