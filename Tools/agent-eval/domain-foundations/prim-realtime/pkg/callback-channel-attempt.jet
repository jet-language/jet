package: {
    name: "callback-channel-attempt"
    authority: { allow: [IO, Time.Wait] }
}

callback: fn(&buffer: [Float#4], tx: Sender<Int>) -[!Mem.Alloc, !Time]> {
    loop i in 0..<buffer.len() {
        buffer[i] = 0.5
    }
    tx.send(1)
}

run: fn() {
    buffer := [Float#4]{0.0, 0.0, 0.0, 0.0}
    { sender: tx, receiver: rx }: channel<Int>(capacity: 1)
    callback(buffer, tx)
    print(rx.receive() ?? 0)
}
