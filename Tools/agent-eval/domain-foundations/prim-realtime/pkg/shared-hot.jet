package: {
    name: "shared-hot"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Mem.Rc] }
}

package: {
    name: "prim-realtime-shared-hot"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Mem.Rc] }
}

State: struct {
    ready: Int
}

hot: fn(state: Shared<State>) -[!Mem.Alloc, !Time]> {
    state.ready += 1
}

run: fn() {
    state: Shared{State{ready: 0}}
    hot(state)
    print("ready={state.ready}")
}
