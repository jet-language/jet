package: {
    name: "channel-deadline"
    version: "0.1.0"
    authority: { allow: [IO, Time, Mem.Alloc] }
}

package: {
    name: "prim-realtime-channel-deadline"
    version: "0.1.0"
    authority: { allow: [IO, Time, Mem.Alloc] }
}

use time: core.time

hot: fn(tx: Sender<Int>) -[!Time]> {
    tx.send(1)
}

run: fn() {
    (tx, rx): channel<Int>(capacity: 1)
    tx.send(0)
    #Context(deadline: time.now() + 5) {
        hot(tx)
    }
    print(rx.receive() ?? 0)
}
