use core.mem

make_buffer: fn() -[!Mem.Alloc]> [Float#4] {
    buffer := [Float#4]{ uninit }
    loop i in 0..<buffer.len() -> buffer[i] = 0.0
    return buffer
}

fill: fn(buffer: &[Float#4]) -[!Mem.Alloc]> {
    loop i in 0..<buffer.len() -> buffer[i] = 0.25
}

run: fn() {
    buffer := make_buffer()
    fill(buffer)
    print(buffer[0])
}
