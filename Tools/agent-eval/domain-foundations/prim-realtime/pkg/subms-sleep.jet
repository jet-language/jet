package: {
    name: "subms-sleep"
    version: "0.1.0"
    authority: { allow: [IO, Time, Mem.Alloc] }
}
use time: core.time

run: fn() {
    started: time.instant()
    loop i in 0..<100 -> time.sleep(999999ns)
    elapsed_us: started.elapsed().in(.Microseconds)
    print("requested_total_us=99999")
    print("elapsed_total_us={elapsed_us}")
}
