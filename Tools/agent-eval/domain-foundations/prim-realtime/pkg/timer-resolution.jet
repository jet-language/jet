package: {
    name: "timer-resolution"
    version: "0.1.0"
    authority: { allow: [IO, Time, Mem.Alloc] }
}
use time: core.time

run: fn() {
    started: time.instant()
    time.sleep(5333333ns)
    elapsed: started.elapsed().in(.Microseconds)
    print("requested_us=5333")
    print("elapsed_us={elapsed}")
}
