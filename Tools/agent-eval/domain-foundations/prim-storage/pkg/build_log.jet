package {
    name: "build_log"
    authority: { holds: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] } }
}

use "log" as log
fn run() {
    p :: Path.from("/home/nate/.cache/jet-dev/dx3/prim-storage/build-log.txt")
    _ok :: log.append_record(~p, "event") ?? false
    _records :: log.read_records(~p) ?? []
    print("log-built")
}
