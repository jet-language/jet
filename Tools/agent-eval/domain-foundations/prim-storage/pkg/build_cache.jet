package {
    name: "build_cache"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc] }
}

use cache :: "cache"
fn run() {
    root :: Path.from("$JET_STATE_ROOT/dx3/prim-storage/build-cache")
    key :: cache.cache_store(root, "payload")
    value :: cache.cache_load(root, key) ?? "missing"
    print(value)
}
