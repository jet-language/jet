package: {
    name: "crossrepeat"
    authority: { allow: [FS.Write, IO, Mem.Alloc] }
}

use {
    fs: core.files
    log: "log"
}

run: fn() {
    p: Path.from("$JET_STATE_ROOT/dx3/prim-storage/cross.txt")
    a: log.append_record(p.copy(), "a") ?? false
    fs.append_all(p.copy(), "b") ?? panic("b")
    print("{a}")
}
