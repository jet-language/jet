use log: "log"

kv_put: fn(path: Path, key: String, value: String) -> Bool {
    return log.append_record(path, "put|{key}|{value}")
}

kv_delete: fn(path: Path, key: String) -> Bool {
    return log.append_record(path, "del|{key}")
}

kv_replay: fn(path: Path) -> [String:String] {
    state := [String:String]{}
    records: log.read_records(path)
    loop record in records {
        parts: record.split("|").to_list()
        if parts.len() >= 2 {
            op: parts[0]
            key: parts[1]
            if op == "put" && parts.len() >= 3 -> state[key] = parts[2]
            if op == "del" -> state.remove(key).drop("delete tombstone")
        }
    }
    return state
}

kv_get: fn(path: Path, key: String) -> String? {
    state: kv_replay(path) ?? panic("kv replay")
    return state.get(key)
}

kv_compact: fn(path: Path) -> Bool {
    state: kv_replay(path) ?? panic("kv replay")
    compacted := [String]{}
    loop (key, value) in state -> compacted.push("put|{key}|{value}")
    return log.compact_records(path, compacted)
}
