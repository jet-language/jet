package: {
    name: "repeat"
    authority: { allow: [FS.Write, IO, Mem.Alloc] }
}

use fs: core.files

append_ok: fn(path: Path, text: String) -> Bool {
    fs.append_all(path, text) ?? return false
    fs.fsync(path) ?? return false
    return true
}

run: fn() {
    p: Path.from("$JET_STATE_ROOT/dx3/prim-storage/repeat.txt")
    a: append_ok(p.copy(), "a") ?? false
    b: append_ok(p.copy(), "b") ?? false
    print("{a} {b}")
}
