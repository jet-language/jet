package: {
    name: "imports3"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc] }
}

use {
    fs: core.files
    log: "log"
    kv: "kv"
    pool: "pool"
    queue: "queue"
}

run: fn() {
    root: "$JET_STATE_ROOT/dx3/prim-storage"
    if fs.exists(root) -> fs.remove_all(root) ?? panic("cleanup")
    fs.create_dir_all(root) ?? panic("create")
    p: Path.from(root).join("imports3.txt")
    _a: log.append_record(p.copy(), "a") ?? false
    fs.append_all(p.copy(), "b") ?? panic("b")
    print("ok")
}
