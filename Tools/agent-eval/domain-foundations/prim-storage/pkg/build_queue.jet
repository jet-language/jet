package {
    name: "build_queue"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] }
}

use queue :: "queue"
fn run() {
    p :: Path.from("$JET_STATE_ROOT/dx3/prim-storage/build-queue.txt")
    a :: Path.from("$JET_STATE_ROOT/dx3/prim-storage/build-acks.txt")
    _ok :: queue.queue_publish(p, "id", "payload") ?? false
    pending :: queue.queue_pending(p, a, "group")
    print(pending)
}
