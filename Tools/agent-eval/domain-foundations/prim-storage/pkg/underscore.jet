package {
    name: "underscore"
    authority: { holds: { allow: [FS.Write, IO, Mem.Alloc] } }
}

use core.files as fs
use "log" as log

fn run() {
    p :: Path.from("/home/nate/.cache/jet-dev/dx3/prim-storage/under.txt")
    _a :: log.append_record(p.copy(), "a") ?? false
    fs.append_all(p.copy(), "b") ?? panic("b")
    print("ok")
}
