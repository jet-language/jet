#Import c.jet_cpp_reader: module {
    take_error: fn() Int = "jet_cpp_reader_take_error"
    reader_new: fn() Int = "jet_cpp_reader_reader_new"
    reader_close: fn(handle: Int) = "jet_cpp_reader_reader_close"
    reader_next_line_length: fn(handle: Int) Int = "jet_cpp_reader_reader_next_line_length"
}
use c: c.jet_cpp_reader

run: fn() {
    handle := c.reader_new()
    print(c.reader_next_line_length(handle))
    print(c.reader_next_line_length(handle))
    c.reader_close(handle)
}
