enum RuleCondition {
    AtLeast(Int)
    Equals(Int)
}

enum RuleAction {
    Add(Int)
    Set(Int)
}

struct Rule {
    priv name: String
    priv fact: String
    priv condition: RuleCondition
    priv action: RuleAction
}

fn matches(condition: RuleCondition, value: Int) -> Bool {
    if condition == {
        .AtLeast(limit) -> value >= limit
        .Equals(target) -> value == target
    }
}

fn apply(action: RuleAction, facts: &[String:Int], key: String) -> String {
    if action == {
        .Add(delta) -> {
            next :: (facts.get(key.copy()) ?? 0) + delta
            facts[key] = next
            return "{key}={next}"
        }
        .Set(next) -> {
            facts[key] = next
            return "{key}={next}"
        }
    }
}

fn fire(facts: &[String:Int], rules: [Rule]) -> [String] {
    events := [String]{}
    loop rule in rules {
        value :: facts.get(rule.fact.copy()) ?? 0
        if !matches(rule.condition.copy(), value) -> &events.push("{rule.name}:skip")
        else -> &events.push("{rule.name}:{apply(rule.action.copy(), &facts, rule.fact.copy())}")
    }
    return events
}

fn sample() -> [String] {
    facts := [String:Int]{"score": 7}
    rules :: [Rule]{
        { name: "bonus", fact: "score", condition: RuleCondition.AtLeast(5), action: RuleAction.Add(3) },
        { name: "cap", fact: "score", condition: RuleCondition.AtLeast(20), action: RuleAction.Set(20) },
        { name: "award", fact: "score", condition: RuleCondition.Equals(10), action: RuleAction.Add(1) }
    }
    return fire(&facts, rules)
}
