use math: core.math

Node: enum {
    Const(Float)
    Var(String)
    Add
    Mul
    Neg
}

Expr: struct {
    priv code: [Node]
}

one: fn(node: Node) -> Expr { Expr{ code: [Node]{node} } }

constant: fn(value: Float) -> Expr { one(Node.Const(value)) }

variable: fn(name: String) -> Expr { one(Node.Var(name.copy())) }

add: fn(left: Expr, right: Expr) -> Expr {
    code := [Node]{}
    &code.extend(left.code.copy())
    &code.extend(right.code.copy())
    &code.push(Node.Add)
    return Expr{ code: code }
}

mul: fn(left: Expr, right: Expr) -> Expr {
    code := [Node]{}
    &code.extend(left.code.copy())
    &code.extend(right.code.copy())
    &code.push(Node.Mul)
    return Expr{ code: code }
}

neg: fn(value: Expr) -> Expr {
    code := [Node]{}
    &code.extend(value.code.copy())
    &code.push(Node.Neg)
    return Expr{ code: code }
}

show: fn(expr: Expr) -> String {
    stack := [String]{}
    loop token in expr.code {
        if token == {
            .Const(value) -> &stack.push("{value}")
            .Var(name) -> &stack.push(name)
            .Add -> {
                right: &stack.pop() ?? "?"
                left: &stack.pop() ?? "?"
                &stack.push("({left} + {right})")
            }
            .Mul -> {
                right: &stack.pop() ?? "?"
                left: &stack.pop() ?? "?"
                &stack.push("({left} * {right})")
            }
            .Neg -> {
                value: &stack.pop() ?? "?"
                &stack.push("(-{value})")
            }
        }
    }
    return &stack.pop() ?? "?"
}

zero_expr: fn() -> Expr { constant(0.0) }

is_zero: fn(expr: Expr) -> Bool {
    if expr.code.len() == 1 {
        token: expr.code[0]
        if token == .Const(value) -> return math.abs(value) < 0.000001
    }
    return false
}

simplify: fn(expr: Expr) -> Expr {
    stack := [Expr]{}
    loop token in expr.code {
        if token == {
            .Const(value) -> &stack.push(constant(value))
            .Var(name) -> &stack.push(variable(name))
            .Neg -> {
                value: &stack.pop() ?? zero_expr()
                &stack.push(neg(simplify(value)))
            }
            .Add -> {
                right: &stack.pop() ?? zero_expr()
                left: &stack.pop() ?? zero_expr()
                if is_zero(left) {
                    &stack.push(right.copy())
                } else {
                    if is_zero(right) -> &stack.push(left.copy())
                    else -> &stack.push(add(left.copy(), right.copy()))
                }
            }
            .Mul -> {
                right: &stack.pop() ?? zero_expr()
                left: &stack.pop() ?? zero_expr()
                if is_zero(left) || is_zero(right) -> &stack.push(zero_expr())
                else -> &stack.push(mul(left.copy(), right.copy()))
            }
        }
    }
    return &stack.pop() ?? zero_expr()
}

Dual: struct {
    priv expr: Expr
    priv deriv: Expr
}

derivative: fn(expr: Expr, wrt: String) -> Expr {
    stack := [Dual]{}
    loop token in expr.code {
        if token == {
            .Const(value) -> &stack.push(Dual{ expr: constant(value), deriv: zero_expr() })
            .Var(name) -> {
                term: variable(name.copy())
                if name == wrt -> &stack.push(Dual{ expr: term, deriv: one(Node.Const(1.0)) })
                else -> &stack.push(Dual{ expr: term, deriv: zero_expr() })
            }
            .Neg -> {
                item: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
                &stack.push(Dual{ expr: neg(item.expr.copy()), deriv: neg(item.deriv.copy()) })
            }
            .Add -> {
                right: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
                left: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
                &stack.push(Dual{
                    expr: add(left.expr.copy(), right.expr.copy()),
                    deriv: add(left.deriv.copy(), right.deriv.copy())
                })
            }
            .Mul -> {
                right: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
                left: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
                first: mul(left.deriv.copy(), right.expr.copy())
                second: mul(left.expr.copy(), right.deriv.copy())
                &stack.push(Dual{
                    expr: mul(left.expr.copy(), right.expr.copy()),
                    deriv: add(first, second)
                })
            }
        }
    }
    item: &stack.pop() ?? Dual{ expr: zero_expr(), deriv: zero_expr() }
    return item.deriv
}

sample: fn() -> Expr {
    x: variable("x")
    two: constant(2.0)
    return add(mul(two.copy(), x.copy()), constant(0.0))
}
