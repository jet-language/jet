module symbolic

fn run() {
    x :: symbolic.variable("x")
    two :: symbolic.constant(2.0)
    expr :: symbolic.add(symbolic.mul(two.copy(), x.copy()), symbolic.constant(0.0))
    simplified :: symbolic.simplify(expr.copy())
    deriv :: symbolic.derivative(simplified.copy(), "x")
    print("expr={symbolic.show(expr.copy())}")
    print("simplified={symbolic.show(simplified.copy())}")
    print("derivative={symbolic.show(deriv.copy())}")
}
