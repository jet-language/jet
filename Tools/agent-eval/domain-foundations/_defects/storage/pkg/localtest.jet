package: {
    name: "localtest"
    authority: { allow: [FS.Write, IO, Mem.Alloc] }
}

use log: "log"

run: fn() {
    p: Path.from("$HOME/.cache/jet-luna/dx3/prim-storage/local.txt")
    a: log.append_record(p.copy(), "a") ?? false
    b: log.append_record(p.copy(), "b") ?? false
    print("{a} {b}")
}
