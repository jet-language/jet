package {
    name: "localtest"
    authority: { holds: { allow: [FS.Write, IO, Mem.Alloc] } }
}

use "log" as log

fn run() {
    p :: Path.from("/home/nate/.cache/jet-luna/dx3/prim-storage/local.txt")
    a :: log.append_record(p.copy(), "a") ?? false
    b :: log.append_record(p.copy(), "b") ?? false
    print("{a} {b}")
}
