package: {
    name: "fall"
    authority: { allow: [FS.Write, IO] }
}

use fs: core.files

ok_write: fn(path: Path) -> Bool {
    fs.write(path, "x") ?? return false
    return true
}

run: fn() {
    p: Path.from("$HOME/.cache/jet-luna/dx3/prim-storage/fall.txt")
    value: ok_write(p) ?? false
    print(value)
}
