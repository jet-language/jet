package {
    name: "build_cache"
    authority: { holds: { allow: [FS.Read, FS.Write, IO, Mem.Alloc] } }
}

use "cache" as cache
fn run() {
    root :: Path.from("/home/nate/.cache/jet-luna/dx3/prim-storage/build-cache")
    key :: cache.cache_store(root, "payload")
    value :: cache.cache_load(root, key) ?? "missing"
    print(value)
}
