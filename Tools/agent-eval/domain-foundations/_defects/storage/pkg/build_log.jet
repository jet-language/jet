package {
    name: "build_log"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] }
}

use "log" as log
fn run() {
    p :: Path.from("/home/nate/.cache/jet-luna/dx3/prim-storage/build-log.txt")
    _ok :: log.append_record(p.copy(), "event") ?? false
    _records :: log.read_records(p.copy()) ?? []
    print("log-built")
}
