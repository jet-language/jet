package {
    name: "directrepeat"
    authority: { allow: [FS.Read, FS.Write, IO] }
}

use fs :: core.files

fn run() {
    p :: Path.from("/home/nate/.cache/jet-luna/dx3/prim-storage/direct.txt")
    fs.append_all(p.copy(), "a") ?? panic("a")
    fs.append_all(p.copy(), "b") ?? panic("b")
    print(fs.read(p.copy()) ?? panic("read"))
}
