package {
    name: "underscore"
    authority: { allow: [FS.Write, IO, Mem.Alloc] }
}

use {
    fs :: core.files
    log :: "log"
}

fn run() {
    p :: Path.from("$HOME/.cache/jet-luna/dx3/prim-storage/under.txt")
    _a :: log.append_record(p.copy(), "a") ?? false
    fs.append_all(p.copy(), "b") ?? panic("b")
    print("ok")
}
