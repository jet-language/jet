package: {
    name: "localtest2"
    authority: { allow: [FS.Write, IO, Mem.Alloc] }
}

use log: "log"

require: fn(ok: Bool, message: String) {
    if !ok -> panic(message)
}

run: fn() {
    root: "$HOME/.cache/jet-luna/dx3/prim-storage"
    p: Path.from("{root}/local2.txt")
    a: log.append_record(p.copy(), "a") ?? false
    require(a, "a")
    b: log.append_record(Path.from("{root}/local2.txt"), "b") ?? false
    require(b, "b")
    print("{a} {b}")
}
