use compute: core.compute
loss: fn(w: Tensor, x: Tensor) -> Tensor { compute.mul(w, x) ?? panic("loss") }
run: fn() {
    w: compute.from_list([2.0]) ?? panic("w")
    x: compute.from_list([4.0]) ?? panic("x")
    { w: dw, x: dx }: compute.gradient(loss, w.copy(), x.copy())
    print("dw={compute.to_list(dw)} dx={compute.to_list(dx)}")
}
