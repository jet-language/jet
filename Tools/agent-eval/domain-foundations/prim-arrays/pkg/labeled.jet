use compute: core.compute

Coordinate: struct {
    name: String
    labels: [String]
}

LabeledArray: struct {
    values: Tensor
    dims: [String]
    coords: [Coordinate]
}

find_text: fn(xs: [String], needle: String) -> Int? {
    i := 0
    loop i < xs.len() {
        if xs[i] == needle -> return Val(i)
        i += 1
    }
    return None
}


 
coordinate: fn(name: String, labels: [String]) -> Coordinate { Coordinate{name: name, labels: labels} }

make: fn(values: Tensor, dims: [String], coords: [Coordinate]) -> LabeledArray { LabeledArray{
    values: values,
    dims: dims,
    coords: coords
} }
