use core.compute as compute

struct Coordinate {
    name: String
    labels: [String]
}

struct LabeledArray {
    values: Tensor
    dims: [String]
    coords: [Coordinate]
}

fn find_text(xs: [String], needle: String) -> Int? {
    i := 0
    loop i < xs.len() {
        if xs[i] == needle -> return Val(i)
        i += 1
    }
    return None
}


 
fn coordinate(name: String, labels: [String]) -> Coordinate { Coordinate{name: name, labels: labels} }

fn make(values: Tensor, dims: [String], coords: [Coordinate]) -> LabeledArray { LabeledArray{
    values: values,
    dims: dims,
    coords: coords
} }
