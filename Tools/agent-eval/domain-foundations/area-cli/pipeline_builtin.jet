package {
    name: "pipeline_builtin"
    authority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }
}

use core.process as process

fn run() {
    source :: process.cmd(["printf", "keep-one\nskip\nkeep-two\n"])
    filter :: process.cmd(["grep", "keep"])
    result :: process.pipeline([source, filter]) ?? panic("pipeline")
    print("exit={result.code} output={result.output.trim()}")
}
