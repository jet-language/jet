package: {
    name: "defs_probe"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc] }
}

use {
    data: core.data
    files: core.files
}

#Codable
Observation: struct { team: String segment: String x: Float y: Float value: Float }
#Codable
Owner: struct { team: String owner: String }
#Codable
Summary: struct { team: String mean: Float }
#Codable
Joined: struct { team: String owner: String mean: Float }
#Codable
Regression: struct { slope: Float intercept: Float r_squared: Float }
#Codable
AnalysisReceipt: struct { rows: Int columns: Int filtered: Int groups: Int joined: Int pivot_cells: Int window_width: Int svg_bytes: Int tensor_shape: [Int] regression: Regression }
mark: fn(stage: String) { files.write("$JET_STATE_ROOT/dx3/area-data/stage.txt", stage) ?? panic("mark") }
run: fn() {
    raw: files.read("$JET_STATE_ROOT/dx3/area-data/fixture-100k.csv") ?? panic("read")
    rows: data.csv<Observation>(raw) ?? panic("csv")
    mark("loaded")
    print("rows={rows.len()}")
}
