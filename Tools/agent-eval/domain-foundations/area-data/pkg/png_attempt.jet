use data: core.data

#Codable
Row: struct {
    team: String
    value: Float
}

run: fn() {
    rows: data.csv<Row>("team,value\nA,2.0") ?? panic("csv")
    groups: data.query(rows)
        .group_by(r -> r.team)
        .mean(r -> r.value)
        .collect() ?? panic("groups")
    png: data.bar_png(groups)
    print(png.len())
}
