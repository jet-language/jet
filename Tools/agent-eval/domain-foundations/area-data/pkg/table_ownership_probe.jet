package {
    name: "table_ownership_probe"
    authority: { allow: [FS.Read, IO, Mem.Alloc] }
}

use {
    data :: core.data
    files :: core.files
}

#Codable
struct Row { team: String value: Float }

fn run() {
    raw :: files.read("$JET_STATE_ROOT/dx3/area-data/fixture-100k.csv") ?? panic("read")
    rows :: data.csv<Row>(raw) ?? panic("csv")
    print("table={data.count(rows)} rows={rows.len()} schema={data.schema(rows).len()}")
}
