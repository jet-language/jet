use data: core.data

#Codable
Row: struct { team: String value: Float }

#Codable
Owner: struct { team: String owner: String }

#Codable
Summary: struct { team: String mean: Float }

#Codable
Joined: struct { team: String owner: String mean: Float }

join_summaries: fn(rows: [Summary], owners: [Owner]) -> [Joined] {
    out := [Joined]{}
    loop row in rows {
        loop owner in owners {
            if row.team == owner.team {
                out.push(Joined{team: row.team, owner: owner.owner, mean: row.mean})
                break
            }
        }
    }
    return out
}

run: fn() {
    rows: data.csv<Row>("team,value\nA,2.0\nB,4.0\nA,6.0\n") ?? panic("csv")
    groups: data.query(rows)
        .group_by(row -> row.team)
        .mean(row -> row.value)
        .collect() ?? panic("groups")
    summaries := [Summary]{}
    loop group in groups {
        summaries.push(Summary{team: group.key, mean: group.value})
    }
    owners: [Owner]{{team: "A", owner: "Ada"}, {team: "B", owner: "Grace"}}
    joined: join_summaries(summaries, owners)
    print("groups={groups.len()} joined={joined.len()} {joined[0].owner} {joined[1].mean}")
}
