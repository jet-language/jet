package: {
    name: "data_ops_probe"
    authority: { allow: [FS.Read, IO, Mem.Alloc] }
}

use {
    data: core.data
    files: core.files
}

#Codable
Observation: struct {
    team: String
    segment: String
    x: Float
    y: Float
    value: Float
}

run: fn() {
    raw: files.read("$JET_STATE_ROOT/dx3/area-data/fixture-100k.csv") ?? panic("read")
    rows: data.csv<Observation>(raw) ?? panic("csv")
    filtered: data.query(rows)
        .filter(fn(row) { row.value >= 50.0 })
        .collect() ?? panic("filter")
    groups: data.query(filtered)
        .group_by(fn(row) { row.team })
        .mean(fn(row) { row.value })
        .collect() ?? panic("group")
    sums: data.query(filtered)
        .group_by(fn(row) { row.team })
        .sum(fn(row) { row.value })
        .collect() ?? panic("sum")
    pivot: data.pivot_sum(filtered, fn(row) { row.team }, fn(row) { row.segment }, fn(row) { row.value }) ?? panic("pivot")
    values := [Float]{}
    loop row in filtered {
        values.push(row.value)
    }
    rolling: data.rolling_mean(values, 5) ?? panic("rolling")
    desc: data.describe(values) ?? panic("describe")
    print("rows={rows.len()} filtered={filtered.len()} groups={groups.len()} sums={sums.len()} pivot={pivot.len()} rolling={rolling.len()} count={desc.count}")
}
