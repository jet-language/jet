use data: core.data

#Codable
Row: struct {
    team: String
    value: Float
}

run: fn() {
    rows: data.csv<Row>("team,value\nA,1.0\nB,2.0\nA,3.0") ?? panic("csv")
    groups: data.query(rows)
        .group_by(r -> r.team)
        .mean(r -> r.value)
        .collect() ?? panic("group")
    print("rows={data.count(rows)} groups={data.count(groups)}")
}
