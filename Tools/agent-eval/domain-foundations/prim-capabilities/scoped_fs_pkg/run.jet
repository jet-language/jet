use fs :: core.files

fn run() {
    inside :: fs.read("$JET_STATE_ROOT/dx3/prim-capabilities/inputs/allowed.txt") ?? "inside-failed"
    outside :: fs.read("$JET_STATE_ROOT/dx3/prim-capabilities/inputs-outside.txt") ?? "outside-failed"
    print("inside={inside.trim()}")
    print("outside={outside.trim()}")
}
