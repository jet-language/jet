struct Meter {
    priv value: Float
}

struct Centimeter {
    priv value: Float
}

struct Second {
    priv value: Float
}

struct Hertz {
    priv value: Float
}

struct Speed {
    priv value: Float
}

struct Acceleration {
    priv value: Float
}

fn meter(value: Float) -> Meter { Meter{ value: value } }
fn centimeter(value: Float) -> Centimeter { Centimeter{ value: value } }
fn second(value: Float) -> Second { Second{ value: value } }
fn hertz(value: Float) -> Hertz { Hertz{ value: value } }

fn meters_add(left: Meter, right: Meter) -> Meter { Meter{ value: left.value + right.value } }
fn checked_meters_add(left: Meter, right: Meter) -> Meter Err! {
    sum :: left.value + right.value
    if !sum.is_finite() -> return Err("meter sum is not finite")
    return Ok(Meter{ value: sum })
}
fn meter_to_centimeter(value: Meter) -> Centimeter { Centimeter{ value: value.value * 100.0 } }
fn centimeters_to_meter(value: Centimeter) -> Meter { Meter{ value: value.value / 100.0 } }
fn meters_per_second(distance: Meter, elapsed: Second) -> Speed { Speed{ value: distance.value / elapsed.value } }
fn speed_per_second(speed: Speed, elapsed: Second) -> Meter { Meter{ value: speed.value * elapsed.value } }
fn meters_per_second_squared(distance: Meter, elapsed: Second) -> Acceleration { Acceleration{ value: distance.value / (elapsed.value * elapsed.value) } }
fn acceleration_step(acceleration: Acceleration, elapsed: Second) -> Speed { Speed{ value: acceleration.value * elapsed.value } }
fn format_meter(value: Meter) -> String { value.value }} m"
fn format_centimeter(value: Centimeter) -> String { value.value }} cm"
fn format_speed(value: Speed) -> String { value.value }} m/s"
fn format_hertz(value: Hertz) -> String { value.value }} Hz"
fn finite_positive(value: Float) -> Bool { value > 0.0 }
