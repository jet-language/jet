Meter: struct {
    priv value: Float
}

Centimeter: struct {
    priv value: Float
}

Second: struct {
    priv value: Float
}

Hertz: struct {
    priv value: Float
}

Speed: struct {
    priv value: Float
}

Acceleration: struct {
    priv value: Float
}

meter: fn(value: Float) -> Meter { Meter{ value: value } }
centimeter: fn(value: Float) -> Centimeter { Centimeter{ value: value } }
second: fn(value: Float) -> Second { Second{ value: value } }
hertz: fn(value: Float) -> Hertz { Hertz{ value: value } }

meters_add: fn(left: Meter, right: Meter) -> Meter { Meter{ value: left.value + right.value } }
checked_meters_add: fn(left: Meter, right: Meter) -> Meter Err! {
    sum: left.value + right.value
    if !sum.is_finite() -> return Err("meter sum is not finite")
    return Ok(Meter{ value: sum })
}
meter_to_centimeter: fn(value: Meter) -> Centimeter { Centimeter{ value: value.value * 100.0 } }
centimeters_to_meter: fn(value: Centimeter) -> Meter { Meter{ value: value.value / 100.0 } }
meters_per_second: fn(distance: Meter, elapsed: Second) -> Speed { Speed{ value: distance.value / elapsed.value } }
speed_per_second: fn(speed: Speed, elapsed: Second) -> Meter { Meter{ value: speed.value * elapsed.value } }
meters_per_second_squared: fn(distance: Meter, elapsed: Second) -> Acceleration { Acceleration{ value: distance.value / (elapsed.value * elapsed.value) } }
acceleration_step: fn(acceleration: Acceleration, elapsed: Second) -> Speed { Speed{ value: acceleration.value * elapsed.value } }
format_meter: fn(value: Meter) -> String { value.value }} m"
format_centimeter: fn(value: Centimeter) -> String { value.value }} cm"
format_speed: fn(value: Speed) -> String { value.value }} m/s"
format_hertz: fn(value: Hertz) -> String { value.value }} Hz"
finite_positive: fn(value: Float) -> Bool { value > 0.0 }
