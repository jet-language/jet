Meter: struct {
    value: Float

    impl Add {
        add: fn(self, rhs: Meter) -> Meter { Meter{ value: self.value + rhs.value } }
    }

    impl Div {
        div: fn(self, rhs: Second) -> Speed { Speed{ value: self.value / rhs.value } }
    }
}
Second: struct { value: Float }
Speed: struct { value: Float }

run: fn() {
    a: Meter{ value: 1.0 }
    b: Meter{ value: 2.0 }
    t: Second{ value: 0.5 }
    print((a + b).value)
    print((a / t).value)
}
