Quantity: struct<D> {
    value: Float

    impl Add {
        add: fn(self, rhs: Quantity) -> Quantity { Quantity{ value: self.value + rhs.value } }
    }
}
MeterDim: struct {}

meter: fn(value: Float) -> Quantity<MeterDim> { Quantity<MeterDim>{ value: value } }

run: fn() {
    a: meter(1.0)
    b: meter(2.0)
    print((a + b).value)
}
