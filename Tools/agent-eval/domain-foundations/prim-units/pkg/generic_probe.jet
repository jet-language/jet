Quantity: struct<D> {
    value: Float
}

MeterDim: struct {

}

SecondDim: struct {

}

// The probe asked for type-level dimension arithmetic (`Quantity<A * B>`); a
// type argument is a type, so the quotient dimension is named as one.
Per: struct<A, B> {

}

meter: fn(value: Float) -> Quantity<MeterDim> { Quantity<MeterDim>{value: value} }

second: fn(value: Float) -> Quantity<SecondDim> { Quantity<SecondDim>{value: value} }

divide: fn<A, B>(left: Quantity<A>, right: Quantity<B>) -> Quantity<Per<A, B>> {
    return Quantity<Per<A, B>>{value: left.value / right.value}
}

run: fn() { print(divide(meter(2.0), second(1.0)).value) }
