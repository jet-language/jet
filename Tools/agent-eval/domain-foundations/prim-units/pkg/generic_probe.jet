struct Quantity<D> {
    value: Float
}

struct MeterDim {}
struct SecondDim {}

fn meter(value: Float) Quantity<MeterDim> -> Quantity<MeterDim>{ value: value }
fn second(value: Float) Quantity<SecondDim> -> Quantity<SecondDim>{ value: value }

fn divide<A, B>(left: Quantity<A>, right: Quantity<B>) Quantity<A * B> -> {
    return Quantity<A * B>{ value: left.value / right.value }
}

fn run() {
    print(divide(meter(2.0), second(1.0)).value)
}
