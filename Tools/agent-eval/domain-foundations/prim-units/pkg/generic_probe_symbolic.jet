Quantity: struct<D> {
    value: Float
}

MeterDim: struct {}
SecondDim: struct {}
Product: struct<A, B> {}

meter: fn(value: Float) -> Quantity<MeterDim> { Quantity<MeterDim>{ value: value } }
second: fn(value: Float) -> Quantity<SecondDim> { Quantity<SecondDim>{ value: value } }

divide: fn<A, B>(left: Quantity<A>, right: Quantity<B>) -> Quantity<Product<A, B>> {
    return Quantity<Product<A, B>>{ value: left.value / right.value }
}

run: fn() {
    value: divide(meter(2.0), second(1.0))
    print(value.value)
}
