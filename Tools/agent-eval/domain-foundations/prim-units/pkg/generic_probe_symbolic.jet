struct Quantity<D> {
    value: Float
}

struct MeterDim {}
struct SecondDim {}
struct Product<A, B> {}

fn meter(value: Float) Quantity<MeterDim> -> Quantity<MeterDim>{ value: value }
fn second(value: Float) Quantity<SecondDim> -> Quantity<SecondDim>{ value: value }

fn divide<A, B>(left: Quantity<A>, right: Quantity<B>) Quantity<Product<A, B>> -> {
    return Quantity<Product<A, B>>{ value: left.value / right.value }
}

fn run() {
    value :: divide(meter(2.0), second(1.0))
    print(value.value)
}
