struct Quantity<D> {
    value: Float
}
struct MeterDim {}

impl Quantity<MeterDim>.Add {
    fn add(self, rhs: Quantity<MeterDim>) Quantity<MeterDim> -> Quantity<MeterDim>{ value: self.value + rhs.value }
}

fn meter(value: Float) Quantity<MeterDim> -> Quantity<MeterDim>{ value: value }

fn run() {
    a :: meter(1.0)
    b :: meter(2.0)
    print((a + b).value)
}
