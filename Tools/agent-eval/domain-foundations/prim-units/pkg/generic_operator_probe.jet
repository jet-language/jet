// The probe asked for `+` on one instantiation (`Quantity<MeterDim>` only).
// An impl sits in its type's body, so it covers every `Quantity<D>`.
Quantity: struct<D> {
    value: Float

    impl Add {
        add: fn(self, rhs: Quantity<D>) -> Quantity<D> {
            Quantity<D>{value: self.value + rhs.value}
        }
    }
}

MeterDim: struct {

}

meter: fn(value: Float) -> Quantity<MeterDim> { Quantity<MeterDim>{value: value} }

run: fn() {
    a: meter(1.0)
    b: meter(2.0)
    print((a + b).value)
}
