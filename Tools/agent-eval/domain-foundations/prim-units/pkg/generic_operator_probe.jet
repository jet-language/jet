Quantity: struct<D> {
    value: Float
}
MeterDim: struct {}

impl Quantity<MeterDim>.Add {
    add: fn(self, rhs: Quantity<MeterDim>) -> Quantity<MeterDim> { Quantity<MeterDim>{ value: self.value + rhs.value } }
}

meter: fn(value: Float) -> Quantity<MeterDim> { Quantity<MeterDim>{ value: value } }

run: fn() {
    a: meter(1.0)
    b: meter(2.0)
    print((a + b).value)
}
