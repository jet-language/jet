D: struct {
    value: Int

    impl Add {
        add: fn(self, rhs: D) -> D {
            pair: align(self, rhs)
            return D{value: pair.a + pair.b}
        }
    }
}
align: fn(left: D, right: D) -> (a: Int, b: Int) { (a: left.value, b: right.value) }
run: fn() {
    print(D{value: 1} + D{value: 2})
}
