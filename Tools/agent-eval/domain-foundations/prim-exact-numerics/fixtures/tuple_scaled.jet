D: struct {
    value: Int
    scale: Int
}
align: fn(left: D, right: D) -> (a: Int, b: Int, c: Int) {
    if left.scale == right.scale -> return (a: left.value, b: right.value, c: left.scale)
    return (a: left.value * 10, b: right.value, c: right.scale)
}
run: fn() {
    a: align(D{value: 1, scale: 2}, D{value: 2, scale: 2})
    print(a.a)
}
