#!/usr/bin/env jet
// Render the variable tables of Docs/spec/reference/environment.md, the
// compiler's name constants in Compiler/JetFoundation/Source/Registry/EnvironmentNames.jet,
// the test kit's copy of them in Compiler/JetTestKit/Source/EnvironmentNames.jet
// and the runtime's name accessors in Compiler/JetRuntime/Source/EnvironmentNames.jet
// from JET_ENVIRONMENT_VARIABLES, the one hand-written home of the environment
// variables Jet reads (Compiler/JetFoundation/Source/Registry/EnvironmentVariables.jet).
// Each section of the registry is one table between its generated marker
// lines; the prose around the tables is the page's own. Code spells each name
// through its generated constant. The test kit, which depends on no package,
// has its own copy of the constants; the runtime, which cannot import the
// registry, spells each name through its generated accessor.
// Usage: jet Tools/agent/EnvironmentRows.jet [--check|--write]
// --check fails when a table, a constant file or the accessor file differs
// from what the registry gives it; --write rewrites them.
use {
    files: core.files
    process: core.process
}

REGISTRY_PATH: "Compiler/JetFoundation/Source/Registry/EnvironmentVariables.jet"
PAGE_PATH: "Docs/spec/reference/environment.md"
FOUNDATION_PATH: "Compiler/JetFoundation/Source/Registry/EnvironmentNames.jet"
FOUNDATION_HEADER: "// Generated by Tools/agent/EnvironmentRows.jet from JET_ENVIRONMENT_VARIABLES\n// (Compiler/JetFoundation/Source/Registry/EnvironmentVariables.jet): edit the\n// registry, then run the generator with --write. Code spells each environment\n// variable through one of these: ENV_<VARIABLE> for an exact row,\n// ENV_PREFIX_<FAMILY> for a family row (the text before its `*`).\n"
KIT_PATH: "Compiler/JetTestKit/Source/EnvironmentNames.jet"
KIT_HEADER: "// Generated by Tools/agent/EnvironmentRows.jet from JET_ENVIRONMENT_VARIABLES\n// (Compiler/JetFoundation/Source/Registry/EnvironmentVariables.jet): edit the\n// registry, then run the generator with --write. The test kit, which depends on\n// no package, and the code that imports it spell each environment variable\n// through one of these: ENV_<VARIABLE> for an exact row, ENV_PREFIX_<FAMILY>\n// for a family row (the text before its `*`). They are the compiler's\n// constants (Compiler/JetFoundation/Source/Registry/EnvironmentNames.jet).\n"
RUNTIME_PATH: "Compiler/JetRuntime/Source/EnvironmentNames.jet"
RUNTIME_HEADER: "// Generated by Tools/agent/EnvironmentRows.jet from JET_ENVIRONMENT_VARIABLES\n// (Compiler/JetFoundation/Source/Registry/EnvironmentVariables.jet): edit the\n// registry, then run the generator with --write. The runtime spells each\n// environment variable through one of these: env_name_<variable> for an exact\n// row, env_prefix_<family> for a family row (the text before its `*`).\n"
ROW_OPEN: "    {{name: \""
SECTION_FIELD: ", section: JetEnvironmentSection."
READER_FIELD: ", reader: \""
VALUE_FIELD: ", value: \""
MEANING_FIELD: ", meaning: \""
// The registry's section enum opens on this line; its one line of cases is
// the page's sections, in page order.
SECTION_ENUM_OPEN: "\nJetEnvironmentSection: enum {{\n"

#Error
EnvironmentRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> EnvironmentRowsError Never! {
    EnvironmentRowsError{message: "environment rows: {message}"}
}

// One row of JET_ENVIRONMENT_VARIABLES, its strings as they read.
EnvironmentRow: struct {
    name: String
    section: String
    reader: String
    value: String
    meaning: String
}

// A string literal read off the front of a row: its text, and the row after
// its closing quote.
Taken: struct {
    text: String
    rest: String
}

// The Jet string literal `text` opens with (its opening quote already gone),
// or None when it never closes.
take_literal: fn(text: String) -> Taken? Never! {
    literal := [U8]{}
    rest := [U8]{}
    escaped := false
    closed := false
    loop byte in text.bytes() {
        if closed {
            rest.push(byte)
            next
        }
        code: Int.from_u8(byte)
        if escaped {
            literal.push(byte)
            escaped = false
            next
        }
        if code == 92 {
            escaped = true
            next
        }
        if code == 34 {
            closed = true
            next
        }
        literal.push(byte)
    }
    if !closed -> return None
    raw: String.from_bytes(literal) ?? return None
    Val(Taken{text: raw.replace("{{{{", "{{").replace("}}}}", "}}"), rest: String.from_bytes(rest) ?? ""})
}

// The text after `field` at the front of `line`, or None.
after_field: fn(line: String, field: String) -> String? Never! {
    if !line.starts_with(field) -> return None
    Val(line.removeprefix(field))
}

// The row on `line`, or None when it does not spell one in the registry's shape.
read_row: fn(line: String) -> EnvironmentRow? Never! {
    rest := after_field(line, ROW_OPEN) ?? return None
    name: take_literal(rest) ?? return None
    rest = after_field(name.rest, SECTION_FIELD) ?? return None
    section: rest.partition(",").head
    rest = after_field(rest.removeprefix(section), READER_FIELD) ?? return None
    reader: take_literal(rest) ?? return None
    rest = after_field(reader.rest, VALUE_FIELD) ?? return None
    value: take_literal(rest) ?? return None
    rest = after_field(value.rest, MEANING_FIELD) ?? return None
    meaning: take_literal(rest) ?? return None
    if meaning.rest != "}}," -> return None
    Val(EnvironmentRow{name: name.text, section: section, reader: reader.text, value: value.text, meaning: meaning.text})
}

// The cases of the registry's section enum, in order.
read_sections: fn(registry: String) -> [String] EnvironmentRowsError! {
    opened: registry.partition(SECTION_ENUM_OPEN)
    if opened.sep == "" -> return Err(rows_fail("{REGISTRY_PATH} declares no JetEnvironmentSection enum"))
    sections := [String]{}
    loop word in opened.tail.partition("\n").head.split(" ") {
        if word != "" -> sections.push(word.copy())
    }
    if sections.len() == 0 -> return Err(rows_fail("{REGISTRY_PATH}: JetEnvironmentSection lists no cases on its first line"))
    Ok(sections)
}

// The rows of JET_ENVIRONMENT_VARIABLES in `registry`, in order.
read_rows: fn(registry: String, sections: [String]) -> [EnvironmentRow] EnvironmentRowsError! {
    opened: registry.partition("\nJET_ENVIRONMENT_VARIABLES: [JetEnvironmentVariable]{{\n")
    if opened.sep == "" -> return Err(rows_fail("{REGISTRY_PATH} declares no JET_ENVIRONMENT_VARIABLES list"))
    rows := [EnvironmentRow]{}
    loop line in opened.tail.lines() {
        if line == "}}" -> return Ok(rows)
        row: read_row(line) ?? return Err(rows_fail("{REGISTRY_PATH}: `{line}` is not a one-line row"))
        if !sections.contains(row.section) -> return Err(rows_fail("{row.name} names the section {row.section}, which the page has no table for"))
        rows.push(row)
    }
    Err(rows_fail("{REGISTRY_PATH}: JET_ENVIRONMENT_VARIABLES never closes"))
}

block_open: fn(section: String) -> String Never! {
    "<!-- BEGIN GENERATED ENVIRONMENT VARIABLES: {section} (Tools/agent/EnvironmentRows.jet; edit {REGISTRY_PATH}) -->"
}

block_close: fn(section: String) -> String Never! {
    "<!-- END GENERATED ENVIRONMENT VARIABLES: {section} -->"
}

// The table of `section`'s rows.
render_table: fn(rows: [EnvironmentRow], section: String) -> String Never! {
    internal: section == "Internal"
    table := if internal -> "| Variable | Read by | Purpose |\n| --- | --- | --- |\n" else -> "| Variable | Accepted value | Effect |\n| --- | --- | --- |\n"
    loop row in rows {
        if row.section != section -> next
        middle: if internal -> "`{row.reader}`" else -> row.value
        table = "{table}| `{row.name}` | {middle} | {row.meaning} |\n"
    }
    table
}

// `page` with each section's table rendered from `registry`.
render_page: fn(registry: String, page: String) -> String EnvironmentRowsError! {
    sections: read_sections(registry) ?? return Err(err)
    rows: read_rows(registry, sections) ?? return Err(err)
    out := page.copy()
    loop section in sections {
        open: block_open(section)
        close: block_close(section)
        before: out.partition("{open}\n")
        if before.sep == "" -> return Err(rows_fail("{PAGE_PATH} has no `{open}` line"))
        after: before.tail.partition("{close}\n")
        if after.sep == "" -> return Err(rows_fail("{PAGE_PATH} has no `{close}` line"))
        if after.tail.contains(open) -> return Err(rows_fail("{PAGE_PATH} has two {section} tables"))
        out = "{before.head}{open}\n{render_table(rows, section)}{close}\n{after.tail}"
    }
    Ok(out)
}

// The compiler's constant for `row`.
foundation_constant: fn(row: EnvironmentRow) -> String Never! {
    text: row.name.removesuffix("*")
    name: if text != row.name -> "ENV_PREFIX_{text.removesuffix("_")}" else -> "ENV_{text}"
    "{name}: \"{text}\"\n"
}

// The runtime's accessor for `row`: its name, and the text it yields.
runtime_accessor: fn(row: EnvironmentRow) -> String Never! {
    text: row.name.removesuffix("*")
    name: if text != row.name -> "env_prefix_{text.removesuffix("_").lower()}" else -> "env_name_{text.lower()}"
    "{name}: fn() -> I64 {{\n    rt_static_text(\"{text}\")\n}}\n"
}

// A constant file for `registry` under `header`: one constant per row, in order.
render_constants: fn(registry: String, header: String) -> String EnvironmentRowsError! {
    sections: read_sections(registry) ?? return Err(err)
    rows: read_rows(registry, sections) ?? return Err(err)
    out := "{header}\n"
    loop row in rows -> out = "{out}{foundation_constant(row)}"
    Ok(out)
}

// The runtime's accessor file for `registry`: one accessor per row, in order.
render_runtime: fn(registry: String) -> String EnvironmentRowsError! {
    sections: read_sections(registry) ?? return Err(err)
    rows: read_rows(registry, sections) ?? return Err(err)
    out := RUNTIME_HEADER.copy()
    loop row in rows -> out = "{out}\n{runtime_accessor(row)}"
    Ok(out)
}

read_text: fn(path: String) -[FS]> String EnvironmentRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

environment_rows_main: fn(args: [String]) -[FS]> String EnvironmentRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: EnvironmentRows.jet [--check|--write]"))
    registry: read_text(REGISTRY_PATH) ?? return Err(err)
    page: read_text(PAGE_PATH) ?? return Err(err)
    // A missing generated file is written fresh, as a stale one is.
    foundation := ""
    if files.is_file(FOUNDATION_PATH) -> foundation = read_text(FOUNDATION_PATH) ?? return Err(err)
    kit := ""
    if files.is_file(KIT_PATH) -> kit = read_text(KIT_PATH) ?? return Err(err)
    runtime := ""
    if files.is_file(RUNTIME_PATH) -> runtime = read_text(RUNTIME_PATH) ?? return Err(err)
    outputs: [(path: String, current: String, generated: String)]{
        (path: PAGE_PATH, current: page, generated: render_page(registry, page) ?? return Err(err)),
        (path: FOUNDATION_PATH, current: foundation, generated: render_constants(registry, FOUNDATION_HEADER) ?? return Err(err)),
        (path: KIT_PATH, current: kit, generated: render_constants(registry, KIT_HEADER) ?? return Err(err)),
        (path: RUNTIME_PATH, current: runtime, generated: render_runtime(registry) ?? return Err(err)),
    }
    stale := [String]{}
    loop output in outputs {
        if output.current == output.generated -> next
        stale.push(output.path.copy())
        if mode == "--write" -> files.write(output.path, output.generated) ?? return Err(rows_fail("cannot write {output.path}: {err}"))
    }
    if stale.len() == 0 -> return Ok("environment rows check passed: {PAGE_PATH}, {FOUNDATION_PATH}, {KIT_PATH} and {RUNTIME_PATH} match")
    if mode == "--write" -> return Ok("environment rows written: {stale.join(", ")}")
    Err(rows_fail("{stale.join(" and ")} differ from {REGISTRY_PATH}; run jet Tools/agent/EnvironmentRows.jet --write"))
}

run: fn() { print(environment_rows_main(process.args()) ?? process.fail(1, err.message)) }

MINIMAL_REGISTRY: "// rows\nJetEnvironmentSection: enum {{\n    User Maintainer Internal\n}}\n\nJET_ENVIRONMENT_VARIABLES: [JetEnvironmentVariable]{{\n    {{name: \"JET_A\", section: JetEnvironmentSection.User, reader: \"a.jet\", value: \"`1`\", meaning: \"Says \\\"a\\\" in `{{{{a}}}}`.\"}},\n    {{name: \"JET_B_*\", section: JetEnvironmentSection.Internal, reader: \"b.jet\", value: \"\", meaning: \"Hands b on.\"}},\n}}\n"

minimal_page: fn() -> String Never! {
    blocks := "# Page\n"
    loop section in read_sections(MINIMAL_REGISTRY) ?? panic(err.message) -> blocks = "{blocks}\n{block_open(section)}\nstale\n{block_close(section)}\n"
    blocks
}

// The error text render_page reports, or "" when it renders.
render_error: fn(registry: String, page: String) -> String Never! {
    if render_page(registry, page) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the page's variable tables match JET_ENVIRONMENT_VARIABLES") {
    if environment_rows_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("each section renders its own table, and rendering twice changes nothing") {
    rendered: render_page(MINIMAL_REGISTRY, minimal_page()) ?? panic(err.message)
    user: "{block_open("User")}\n| Variable | Accepted value | Effect |\n| --- | --- | --- |\n| `JET_A` | `1` | Says \"a\" in `{{a}}`. |\n{block_close("User")}\n"
    assert(rendered.contains(user), rendered)
    assert(rendered.contains("{block_open("Maintainer")}\n| Variable | Accepted value | Effect |\n| --- | --- | --- |\n{block_close("Maintainer")}\n"), rendered)
    assert(rendered.contains("| `JET_B_*` | `b.jet` | Hands b on. |\n{block_close("Internal")}"), rendered)
    assert(!rendered.contains("stale"), rendered)
    assert_eq(render_page(MINIMAL_REGISTRY, rendered) ?? panic(err.message), rendered)
}

#Test("the constant files spell each exact row's name and each family's prefix through one constant") {
    rendered: render_constants(MINIMAL_REGISTRY, FOUNDATION_HEADER) ?? panic(err.message)
    assert(rendered.starts_with("{FOUNDATION_HEADER}\n"), rendered)
    assert(rendered.contains("\nENV_JET_A: \"JET_A\"\n"), rendered)
    assert(rendered.ends_with("\nENV_PREFIX_JET_B: \"JET_B_\"\n"), rendered)
    kit: render_constants(MINIMAL_REGISTRY, KIT_HEADER) ?? panic(err.message)
    assert_eq(kit.removeprefix(KIT_HEADER), rendered.removeprefix(FOUNDATION_HEADER))
}

#Test("the runtime file spells each exact row's name and each family's prefix through one accessor") {
    rendered: render_runtime(MINIMAL_REGISTRY) ?? panic(err.message)
    assert(rendered.starts_with(RUNTIME_HEADER), rendered)
    assert(rendered.contains("\nenv_name_jet_a: fn() -> I64 {{\n    rt_static_text(\"JET_A\")\n}}\n"), rendered)
    assert(rendered.ends_with("\nenv_prefix_jet_b: fn() -> I64 {{\n    rt_static_text(\"JET_B_\")\n}}\n"), rendered)
}

#Test("a registry or page the tables cannot come from is refused") {
    assert(render_error(MINIMAL_REGISTRY.replace("Section.Internal", "Section.Other"), minimal_page()).contains("names the section Other"))
    assert(render_error(MINIMAL_REGISTRY.replace(", meaning:", ", purpose:"), minimal_page()).contains("is not a one-line row"))
    assert(render_error(MINIMAL_REGISTRY.replace("JET_ENVIRONMENT_VARIABLES", "OTHER"), minimal_page()).contains("declares no JET_ENVIRONMENT_VARIABLES list"))
    assert(render_error(MINIMAL_REGISTRY.replace("JetEnvironmentSection: enum", "Sections: enum"), minimal_page()).contains("declares no JetEnvironmentSection enum"))
    assert(render_error(MINIMAL_REGISTRY, minimal_page().replace("{block_close("Internal")}\n", "")).contains("has no `<!-- END GENERATED ENVIRONMENT VARIABLES: Internal -->` line"))
}
