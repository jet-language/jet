#!/usr/bin/env jet
// The ONE command an implementation worker may run.
//
// Workers are source-only so that one agent owns the build lane and the disk,
// but every integration break a worker can cause (an unclosed `impl`, a stale
// module path after a split, wrong visibility, a renamed variant, a mismatched
// delimiter) is what `jet check` prints in one keep-going pass. So a worker
// type-checks its own patch with the admitted native compiler named by $JET.
// The default run checks the whole compiler project (Compiler/, the unit the
// native self-host builds) with JET_KEEP_GOING=1, so every error in every item
// is reported at once. A path argument checks that file or project instead.
// A path under Compiler/JetRuntime is checked in its assembled mode (#6670):
// the one unit Compiler/JetRuntime/sources.list assembles, as the runtime
// build (Compiler/Toolchain/RuntimePack.jet unit) assembles it, with each
// diagnostic located at the listed source line it came from. A shared source
// the list also names (Compiler/JetBackend/Source/OS/*.jet) is checked in its
// own package and in the assembled unit.
// A Compiler/Prelude source is checked as the compiler embeds it (#6670 c1).
// First the check that holds the compiler's copies of it equal to it: `jet
// check` of Compiler/JetFoundation/Source/Registry/CoreCallRows.jet, whose
// build-time tables read Core.rows and CoreSourceParts.tsv, for those two;
// CoreSourceRows.jet for Effects.jet, the Core surface ledger for CoreSurfaceInventory.rows,
// DiagnosticRows.jet for Diagnostics.jet, OwnedTraitRows.jet for Traits.jet
// and core/prelude.jet, and Compiler/Toolchain/PreludeSources.jet (the
// `prelude-sources` step of `jet build Compiler`, run from Compiler/) for
// Markers.jet, Derives.jet, Errors.jet and Units.jet. Then every Prelude Jet
// file the compiler embeds gets `jet check --prelude`: every `.jet` file but
// the readers' core/prelude.jet, which the compiler does not embed; a jet
// without that mode prints PRELUDE UNCHECKED and never CHECK OK. A `.rows`
// or `.tsv` table is never Jet: its generator check is its whole check.
// A Core source is checked as Core, the library that may define `__` names:
// a public module or a private part (its row in `jet inspect structure --core
// --json`, the compiler's CORE_SOURCE_OWNED_ROWS) as the
// one-import probe of its module that Tools/agent/CoreModuleCheck.jet uses,
// then as `jet check Core` (every Core body, called or not), with this
// checkout as the toolchain root; a runtime unit as itself, which the
// compiler admits as that Core row. Core/Effects/Effects.jet, Core's service
// effects, and Core/Compiler/Meta.jet, the metaprogramming effects, are part
// of the canonical effect source: each gets CoreSourceRows.jet's check, then
// its own `jet check`. Core/Compiler/Lang.jet holds CoreSourceRows.jet's
// generated Effect and FFILanguage block, so it gets that check, then the
// Core check. Any other Core path with no row fails.
// Every mode first runs the personal-information guard (#6564 c5),
// Jetpack/Bootstrap/Assemble.jet's check mode, which refuses an unlisted Jetpack source
// or a drifted compiler slice (its Jet tool runs under $JET too, not the seed),
// the unsafe-region ratchet in --check mode
// (#6605), which refuses any #Unsafe region Docs/spec/safety.md does not
// record, and any recorded row the checkout no longer has, the vocabulary
// rows in --check mode, which refuse a package Source/Vocabulary.jet that
// differs from the package's Vocabulary.tsv, the diagnostic census in --check
// mode (Tools/agent/DiagnosticCensus.jet), which refuses a stale
// tests/diagnostics_census.tsv and any active code that is dead or shown by no
// ui snapshot, report fixture or case unless the shrink-only
// tests/diagnostics_census_baseline.tsv admits it, and the script-pairing guard
// (Tools/agent/ScriptPairing.jet --check), which refuses a script in another
// language that the change adds without its gauntlet pair.
//
// It does not run tests or formatters, regenerate artifacts, or build a
// compiler. Those stay with the orchestrator.
//
// Usage (from the repository root):
//   JET=/path/to/jet jet Tools/agent/LaneCheck.jet          the whole compiler
//   JET=/path/to/jet jet Tools/agent/LaneCheck.jet <path>   one file or project
//   jet Tools/agent/LaneCheck.jet --runtime-generators      runtime tables only
//   jet Tools/agent/LaneCheck.jet --personal-info [DIR]     the guard alone
//   jet Tools/agent/LaneCheck.jet --patterns                the guard's rules,
//     one "path<TAB>regex" (case-sensitive) or "word<TAB>regex" (any case)
//     line each, for Tools/release/Publish.jet's release search
//
// Reading the output: errors are grouped by file. An error in a file YOU did not
// touch belongs to another worker editing the same checkout: report it in your
// final message, do not fix it.
//
// The personal-information guard: committed files name no home path, user
// name, host name, personal email, machine mount or dev tool root. Write a
// neutral placeholder instead: ~ or $HOME, $USER, $JET_SCRATCH_ROOT,
// $JET_STATE_ROOT, $JET_RUN_ROOT, or an example account such as `user` on
// `devhost`. The patterns come from the machine running the check (the same
// rules Tower's Tools/tower/app/personal-info.mjs builds), so no file holds
// personal data: the home directory, /home/$USER, /Users/$USER,
// /etc/profiles/per-user/$USER, $JET_SCRATCH_ROOT and every mount under /mnt,
// /media and /run/media, the state root (the jet-dev dir of the user cache,
// under any home spelling or bare), the run root (the tdev dir of /tmp), git's
// user.email and, as whole words in any case, git's user.name, the GitHub
// handle in a noreply email, the login name and the host name (generic names
// such as `runner` are skipped). Every file is searched except .git, paths the
// checkout's .gitignore excludes, and chain build state (.chain*). The guard
// exits 0 when clean, 65 with the offending files when not, 64 when it cannot
// run.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

run: fn() {
    args: process.args()
    repo: repo_root()
    if args.len() > 0 && args[0] == "--personal-info" {
        if args.len() > 2 -> usage("jet Tools/agent/LaneCheck.jet --personal-info [DIR]")
        process.exit(personal_info_guard(if args.len() == 2 -> args[1] else -> repo))
    }
    if args.len() > 0 && args[0] == "--patterns" {
        if args.len() != 1 -> usage("jet Tools/agent/LaneCheck.jet --patterns")
        loop rule in personal_info_rules(machine_identity(files.cwd() ?? repo)) -> print("{rule.kind}\t{rule.source}")
        return
    }
    if personal_info_guard(repo) != 0 {
        print("CHECK FAILED — personal or machine information in the checkout (see above)")
        process.exit(1)
    }
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    assembly: assembly_spec(jet, repo).run() ?? return assembly_refused("{jet} could not run Jetpack/Bootstrap/Assemble.jet: {err}")
    if assembly.code != 0 || assembly.signal != None -> return assembly_refused(process.combined_output(assembly).trim_end())
    unsafe_ratchet(repo)
    vocabulary_rows(repo)
    body_host_call_rows(repo)
    diagnostic_census(repo)
    script_pairing(repo)
    if args.len() > 0 && args[0] == "--runtime-generators" {
        if args.len() != 1 -> usage("jet Tools/agent/LaneCheck.jet --runtime-generators")
        process.exit(runtime_generators(repo))
    }
    if args.len() > 1 -> usage("JET=/path/to/jet jet Tools/agent/LaneCheck.jet [path]")
    process.exit(compiler_check(repo, args))
}

assembly_refused: fn(output: String) -[Exec, IO]> Never {
    print(output)
    print("CHECK FAILED — the Jetpack assembly check refused the sources (unlisted file or compiler-slice drift, see above)")
    process.exit(1)
}

// An environment setting of a child run.
Setting: struct {
    name: String
    value: String
}

// The Jetpack assembly check's environment. Its Jet tool
// (Tools/agent/CompilerPackages.jet `sources`) runs under JET_BIN, else the
// current seed, against this checkout's Core; the seed's Core part table
// predates every part Core gained since it (#6694 c18: Core/Crypto's
// `__core_crypto_md` is no core module to it). So the tool runs under the jet
// being checked, as Compiler/test.jet and Jetpack/Bootstrap/Check.jet run it.
assembly_env: fn(jet: String) -> [Setting] {
    [Setting]{Setting{name: "JETPACK_WORKER", value: "lanecheck"}, Setting{name: "JET_BIN", value: jet}}
}

assembly_spec: fn(jet: String, repo: String) -[Exec]> ProcessSpec {
    spec := process.cmd([String]{jet, "Jetpack/Bootstrap/Assemble.jet", "check"}).cwd(repo)
    loop setting in assembly_env(jet) {
        spec = spec.env(setting.name, setting.value)
    }
    spec
}

// The unsafe-region ratchet with $JET, else the `jet` on PATH; it never writes.
unsafe_ratchet: fn(repo: String) -[Env, Exec, FS, IO]> () {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    ratchet: process.cmd([String]{jet, "Tools/agent/UnsafeRatchet.jet", "--check"}).cwd(repo).run() ?? return check_refused("", "{jet} could not run Tools/agent/UnsafeRatchet.jet: {err}")
    if ratchet.code == 0 && ratchet.signal == None -> return
    check_refused(process.combined_output(ratchet).trim_end(), "the unsafe-region ratchet differs from Docs/spec/safety.md (see above; record an audited row with jet Tools/agent/UnsafeRatchet.jet --update)")
}

// The vocabulary rows check with $JET, else the `jet` on PATH; it never writes.
vocabulary_rows: fn(repo: String) -[Env, Exec, FS, IO]> () {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    rows: process.cmd([String]{jet, "Tools/agent/VocabularyRows.jet", "--check"}).cwd(repo).run() ?? return check_refused("", "{jet} could not run Tools/agent/VocabularyRows.jet: {err}")
    if rows.code == 0 && rows.signal == None -> return
    check_refused(process.combined_output(rows).trim_end(), "a generated Source/Vocabulary.jet differs from its Vocabulary.tsv (see above; regenerate with jet Tools/agent/VocabularyRows.jet --write)")
}

// The BodyHostCall rows check with $JET, else the `jet` on PATH; it never writes.
body_host_call_rows: fn(repo: String) -[Env, Exec, FS, IO]> () {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    rows: process.cmd([String]{jet, "Tools/agent/BodyHostCallRows.jet", "--check"}).cwd(repo).run() ?? return check_refused("", "{jet} could not run Tools/agent/BodyHostCallRows.jet: {err}")
    if rows.code == 0 && rows.signal == None -> return
    check_refused(process.combined_output(rows).trim_end(), "Compiler/JetFoundation/Source/Facts/BodyHostCall.jet differs from THostCall (see above; regenerate with jet Tools/agent/BodyHostCallRows.jet --write)")
}

// The diagnostic census check with $JET, else the `jet` on PATH; it never writes.
diagnostic_census: fn(repo: String) -[Env, Exec, FS, IO]> () {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    census: process.cmd([String]{jet, "Tools/agent/DiagnosticCensus.jet", "--check"}).cwd(repo).run() ?? return check_refused("", "{jet} could not run Tools/agent/DiagnosticCensus.jet: {err}")
    if census.code == 0 && census.signal == None -> return
    check_refused(process.combined_output(census).trim_end(), "the diagnostic census refused the tree (see above; regenerate with jet Tools/agent/DiagnosticCensus.jet --write; a new dead or uncarried code needs its emitter or its ui snapshot, report fixture or case, not a baseline row)")
}

// The script-pairing guard with $JET, else the `jet` on PATH; it never writes.
script_pairing: fn(repo: String) -[Env, Exec, FS, IO]> () {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    pairing: process.cmd([String]{jet, "Tools/agent/ScriptPairing.jet", "--check"}).cwd(repo).run() ?? return check_refused("", "{jet} could not run Tools/agent/ScriptPairing.jet: {err}")
    if pairing.code == 0 && pairing.signal == None -> return
    check_refused(process.combined_output(pairing).trim_end(), "the change adds a script in another language without its gauntlet pair (see above)")
}

check_refused: fn(output: String, reason: String) -[Exec, IO]> () {
    if output != "" -> print(output)
    print("CHECK FAILED — {reason}")
    process.exit(1)
}

usage: fn(text: String) -[Exec, IO]> Never { process.fail(64, "usage: {text}") }

// The checkout holding this tool, else the nearest directory at or above the
// working directory that holds it.
repo_root: fn() -[Env, Exec, FS, IO]> String Never! {
    tool: "/Tools/agent/LaneCheck.jet"
    script: sys.executable()
    if script.ends_with(tool) -> return script.removesuffix(tool)
    start: files.cwd() ?? "/"
    dir := start.copy()
    loop !files.exists("{dir}{tool}") {
        if dir == "/" || dir == "" {
            process.fail(1, "lane-check: run from inside the Jet checkout (no Tools/agent/LaneCheck.jet above {start})")
        }
        dir = files.dirname(dir)
    }
    dir
}

user_cache: fn() -[Env]> String Never! {
    "{process.env_nonempty("XDG_CACHE_HOME") ?? "{process.env_nonempty("HOME") ?? ""}/.cache"}/jet"
}

// --- runtime generators -----------------------------------------------------

// Runtime-only freshness gate (no compiler under test): the runtime's
// generated tables against their sources. It runs with $JET, else the `jet`
// on PATH.
runtime_generators: fn(repo: String) -[Env, Exec, FS, IO, Time.Wait]> Int Never! {
    jet: process.env_nonempty("JET") ?? (process.which("jet") ?? "jet")
    receipt: process.cmd([String]{jet, "Tools/agent/RuntimeGenerators.jet", "--check"}).cwd(repo).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? {
        print("CHECK FAILED — {jet} could not run Tools/agent/RuntimeGenerators.jet: {err}")
        return 1
    }
    if receipt.code == 0 && receipt.signal == None {
        print("CHECK OK")
        return 0
    }
    print("CHECK FAILED — a runtime generator reported stale output")
    1
}

// --- Compiler/Prelude -------------------------------------------------------

PRELUDE_TREE: "Compiler/Prelude"
// The readers' prelude: a Jet module only a generator reads, which the
// compiler does not embed, so its generator check is its whole check.
PRELUDE_READERS_MODULE: "core/prelude.jet"
PRELUDE_UNCHECKED: "PRELUDE UNCHECKED: needs a seed with the prelude check mode"
// The compiler source whose build-time tables read Core.rows and
// CoreSourceParts.tsv (Compiler/JetFoundation/Source/CoreDeclarations).
CORE_DECLARATION_TABLES: "Compiler/JetFoundation/Source/Registry/CoreCallRows.jet"

// Whether `relative` is a Prelude source LaneCheck checks: a `.jet`, `.rows`
// or `.tsv` file under Compiler/Prelude other than its package.jet.
prelude_source: fn(relative: String) -> Bool Never! {
    if !relative.starts_with("{PRELUDE_TREE}/") || relative.removeprefix("{PRELUDE_TREE}/") == "package.jet" -> return false
    relative.ends_with(".jet") || relative.ends_with(".rows") || relative.ends_with(".tsv")
}

// The command whose `--check` holds the compiler's copies of Prelude file
// `name` (its path under Compiler/Prelude) equal to it, run with `jet`; empty
// when no generator reads the file. A Toolchain/ generator is a step of
// `jet build Compiler` and runs from the Compiler package; the rest run from
// the checkout.
prelude_generator: fn(name: String, jet: String) -> [String] Never! {
    if name == {
        "Core.rows" | "CoreSourceParts.tsv" -> [String]{jet, "check", CORE_DECLARATION_TABLES}
        "Effects.jet" -> [String]{jet, "Tools/agent/CoreSourceRows.jet", "--check"}
        "CoreSurfaceInventory.rows" -> [String]{jet, "Tools/agent/CoreSurfaceLedger.jet", "--check"}
        "Diagnostics.jet" -> [String]{jet, "Tools/agent/DiagnosticRows.jet", "--check"}
        "Traits.jet" | "core/prelude.jet" -> [String]{jet, "Tools/agent/OwnedTraitRows.jet", "--check"}
        "Markers.jet" | "Derives.jet" | "Errors.jet" | "Units.jet" -> [String]{jet, "Toolchain/PreludeSources.jet", "--check"}
        else -> [String]{}
    }
}

// Whether `jet` has `jet check --prelude`: given no file, that mode alone
// refuses with its own usage line.
prelude_mode: fn(repo: String, jet: String) -[Exec, Time.Wait]> Bool Never! {
    receipt: process.cmd([String]{jet, "check", "--prelude"}).cwd(repo).env("NO_COLOR", "1").run() ?? return false
    process.combined_output(receipt).contains("`jet check --prelude` checks one Compiler/Prelude")
}

// A Prelude source (`relative`, at `target`): its generator check, then, for
// a Prelude Jet file the compiler embeds, `jet check --prelude`. None when
// that file needs the mode and `jet` has none.
prelude_check: fn(repo: String, jet: String, relative: String, target: String, scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran? Never! {
    name: relative.removeprefix("{PRELUDE_TREE}/")
    generator: prelude_generator(name, jet)
    text := ""
    generated := 0
    if generator.len() > 0 {
        ran: generator_check(repo, generator, relative)
        text = ran.text
        generated = ran.code
    }
    if !name.ends_with(".jet") || name == PRELUDE_READERS_MODULE -> return Val(Ran{code: generated, text: text})
    // A generator failure is reported beside the prelude check, not instead of it.
    if !prelude_mode(repo, jet) {
        if generated != 0 -> return Val(Ran{code: generated, text: text})
        return None
    }
    checked: run_check(repo, jet, [String]{"check", "--prelude", target}, scratch)
    code := checked.code
    if generated != 0 {
        code = generated
    }
    Val(Ran{code: code, text: "{text}{checked.text}"})
}

// `generator` (a `--check` command) run for `relative`: code 1 and a closing
// error line when a compiler copy of it differs.
generator_check: fn(repo: String, generator: [String], relative: String) -[Env, Exec]> Ran Never! {
    command: generator.join(" ")
    folder: if generator[1].starts_with("Toolchain/") -> "{repo}/Compiler" else -> repo
    receipt: process.cmd(generator).cwd(folder).env("JET_TOOLCHAIN_ROOT", process.env_nonempty("JET_TOOLCHAIN_ROOT") ?? repo).output_limit(268435456).run() ?? return Ran{code: 127, text: "error: {relative}: `{command}` could not start: {err}\n"}
    output: process.combined_output(receipt)
    if receipt.code != 0 || receipt.signal != None -> return Ran{code: 1, text: "{output}\nerror: {relative}: `{command}` failed: a compiler copy of it differs (see above)\n"}
    Ran{code: 0, text: output}
}

// Core's service effects and the metaprogramming effects are no Core module:
// the compiler embeds them in its canonical effect source, so their check is
// CoreSourceRows.jet's, as for Prelude/Effects.jet, then the file's own
// `jet check`.
CORE_EFFECTS_SOURCE: "Core/Effects/Effects.jet"
META_EFFECTS_SOURCE: "Core/Compiler/Meta.jet"
// Core/Compiler/Lang.jet is a Core module whose Effect and FFILanguage enums
// are a block CoreSourceRows.jet writes from the effect sources, so its check
// is CoreSourceRows.jet's, then the Core check.
LANG_SOURCE: "Core/Compiler/Lang.jet"

core_effects_check: fn(repo: String, jet: String, relative: String, target: String, scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    generated: generator_check(repo, [String]{jet, "Tools/agent/CoreSourceRows.jet", "--check"}, relative)
    checked: run_check(repo, jet, [String]{"check", target}, scratch)
    Ran{code: if generated.code != 0 -> generated.code else -> checked.code, text: "{generated.text}{checked.text}"}
}

core_lang_check: fn(repo: String, jet: String, relative: String, target: String, scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    generated: generator_check(repo, [String]{jet, "Tools/agent/CoreSourceRows.jet", "--check"}, relative)
    checked: core_check(repo, jet, relative, target, scratch)
    Ran{code: if generated.code != 0 -> generated.code else -> checked.code, text: "{generated.text}{checked.text}"}
}

// --- compiler check ---------------------------------------------------------

compiler_check: fn(repo: String, args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    jet: process.env_nonempty("JET") ?? ""
    if jet == "" || !files.is_file(jet) {
        term.eprint("lane-check: JET must name the admitted native jet compiler binary")
        return 64
    }
    // Scratch, the assembled unit and logs stay on disk, never on a RAM-backed
    // /tmp: JET_TEST_SCRATCH, else <JET_SCRATCH_ROOT>/lane-check, else Jet's
    // user cache.
    scratch: process.env_nonempty("JET_TEST_SCRATCH") ?? (if (process.env_nonempty("JET_SCRATCH_ROOT") ?? "") != "" -> "{process.env_nonempty("JET_SCRATCH_ROOT") ?? ""}/lane-check" else -> "{user_cache()}/lane-check")
    files.create_dir_all(scratch) ?? {
        term.eprint("lane-check: cannot create {scratch}: {err}")
        return 1
    }
    log: "{scratch}/jet-lane-check.{sys.pid()}{time.unix_ns() % 1000000}"
    target: if args.len() == 1 -> files.realpath(args[0]) ?? args[0] else -> "{repo}/Compiler"

    // A memory floor alone is not enough: concurrent callers can read "plenty
    // free" in the same instant and then all start together, so at most
    // JET_CHECK_SLOTS lanes hold a slot and the rest wait for one. Each check
    // runs with its address space capped (JET_CHECK_MEM, default 20G: the
    // whole-compiler check measured 15.4G resident); JET_CHECK_MEM=off runs
    // it uncapped.
    slots: int_or(process.env_nonempty("JET_CHECK_SLOTS") ?? "2", 2)
    lockdir: "{user_cache()}/lane-check-slots"
    files.create_dir_all(lockdir) ?? {
        term.eprint("lane-check: cannot create {lockdir}: {err}")
        return 1
    }
    held := [FileLock]{}
    loop slot in 1..<(if slots < 1 -> 2 else -> slots + 1) {
        lock: files.try_lock("{lockdir}/{slot}") ?? next
        held.push(lock)
        break
    }
    if held.len() == 0 {
        // Every slot is busy: wait on slot 1 rather than spin.
        lock: files.lock("{lockdir}/1") ?? {
            term.eprint("lane-check: cannot lock {lockdir}/1: {err}")
            return 1
        }
        held.push(lock)
    }
    // The log exists from the start and its .rc only once the check ends, so a
    // killed check leaves a log without a status: incomplete, never success.
    files.write(log, "") ?? term.eprint("lane-check: cannot write {log}: {err}")
    root: files.realpath(repo) ?? repo.copy()
    relative: if target.starts_with("{root}/") -> target.removeprefix("{root}/") else -> ""
    runtime_owned: relative == RUNTIME_TREE || relative.starts_with("{RUNTIME_TREE}/")
    runtime_shared: !runtime_owned && relative != "" && runtime_sources(repo).paths.contains(relative)
    ran := Ran{code: 0, text: ""}
    if {
        runtime_owned -> ran = runtime_check(repo, jet, scratch)
        prelude_source(relative) -> ran = prelude_check(repo, jet, relative, target, scratch) ?? {
            held.clear()
            print(PRELUDE_UNCHECKED)
            return 1
        }
        relative == CORE_EFFECTS_SOURCE || relative == META_EFFECTS_SOURCE -> ran = core_effects_check(repo, jet, relative, target, scratch)
        relative == LANG_SOURCE -> ran = core_lang_check(repo, jet, relative, target, scratch)
        relative.starts_with("Core/") && relative.ends_with(".jet") -> ran = core_check(repo, jet, relative, target, scratch)
        else -> ran = run_check(repo, jet, [String]{"check", target}, scratch)
    }
    if runtime_shared {
        assembled: runtime_check(repo, jet, scratch)
        ran = Ran{code: if ran.code != 0 -> ran.code else -> assembled.code, text: "{ran.text}{assembled.text}"}
    }
    held.clear()
    files.write(log, ran.text) ?? term.eprint("lane-check: cannot write {log}: {err}")
    files.write("{log}.rc", "{ran.code}\n") ?? term.eprint("lane-check: cannot write {log}.rc: {err}")
    term.eprint("lane-check: complete compiler log: {log}")
    print(report(ran.text, ran.code).removesuffix("\n"))
    ran.code
}

int_or: fn(text: String, fallback: Int) -> Int Never! {
    if text == "" -> return fallback
    value := 0
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return fallback
        value = value * 10 + code - 48
    }
    value
}

Ran: struct {
    code: Int
    text: String
}

mem_available_mb: fn() -[FS]> Int Never! {
    text: files.read("/proc/meminfo") ?? return 0
    loop line in text.lines() {
        if line.starts_with("MemAvailable:") -> return int_or(line.removeprefix("MemAvailable:").trim().partition(" ").head, 0) /% 1024
    }
    0
}

// JET_CHECK_MEM's size (`20G`, `512M`, `4096K` or bare bytes) in bytes, or
// -1 when it is not one.
memory_bytes: fn(text: String) -> Int Never! {
    scale := 1
    digits := text.copy()
    if text.ends_with("G") {
        scale = 1073741824
        digits = text.removesuffix("G").copy()
    } else if text.ends_with("M") {
        scale = 1048576
        digits = text.removesuffix("M").copy()
    } else if text.ends_with("K") {
        scale = 1024
        digits = text.removesuffix("K").copy()
    }
    count: int_or(digits, -1)
    if count <= 0 -> return -1
    count * scale
}

// `jet` with `command` (`check TARGET` or `check --prelude TARGET`), its
// address space capped at JET_CHECK_MEM (default 20G; `off` for none).
run_check: fn(repo: String, jet: String, command: [String], scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    floor_mb: int_or(process.env_nonempty("JET_MIN_FREE_MB") ?? "8000", 8000)
    loop _ in 0..<90 {
        available: mem_available_mb()
        if available >= floor_mb -> break
        term.eprint("lane-check: waiting for memory ({available}MB < {floor_mb}MB floor)")
        time.sleep(10s)
    }
    memory: process.env_nonempty("JET_CHECK_MEM") ?? "20G"
    limit: if memory == "off" -> 0 else -> memory_bytes(memory)
    if limit < 0 -> return Ran{code: 64, text: "lane-check: JET_CHECK_MEM must be `off` or a size such as 20G, 512M or 4096K, not `{memory}`\n"}
    argv := [String]{jet.copy()}
    argv.extend(command.copy())
    spec := process.cmd(argv).cwd(repo).env("JET_KEEP_GOING", "1").env("TMPDIR", scratch).env("TMP", scratch).env("TEMP", scratch)
        .env("JET_TOOLCHAIN_ROOT", process.env_nonempty("JET_TOOLCHAIN_ROOT") ?? repo).timeout(1800s).output_limit(1073741824)
    if limit > 0 -> spec = spec.memory_limit(limit)
    results: process.run_all([ProcessSpec]{spec}, 1) ?? return Ran{code: 127, text: "lane-check: {argv[0]} could not start: {err}\n"}
    if results[0] == {
        .Ok(receipt) -> {
            code: if receipt.timed_out -> 124 else -> if receipt.signal == .Val(number) -> 128 + number else -> receipt.code
            Ran{code: code, text: "{receipt.output}{receipt.errors}"}
        }
        .Err(error) -> if error == {
            .ResourceLimit(_) -> Ran{code: 125, text: "lane-check: {argv[0]} stopped at its memory cap (JET_CHECK_MEM={memory}): {error}\n"}
            .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .AlreadyExists(_) | .Unsupported(_) -> Ran{code: 127, text: "lane-check: {argv[0]} could not start: {error}\n"}
        }
    }
}

// A compiler diagnostic's first line: `error[...]`, `error:` or `Error [...]`.
diagnostic_head: fn(line: String) -> Bool Never! {
    line.starts_with("error[") || line.starts_with("error:") || line.starts_with("Error [")
}

Located: struct {
    head: String
    location: String
}

// `CHECK OK`, or `CHECK FAILED` with every diagnostic grouped by file and then
// the complete compiler output.
report: fn(text: String, code: Int) -> String Never! {
    lines: text.split("\n").to_list()
    found := [Located]{}
    loop index in 0..<lines.len() {
        if !diagnostic_head(lines[index]) -> next
        location := ""
        stop: if index + 6 < lines.len() -> index + 6 else -> lines.len()
        loop next_index in index + 1..<stop {
            if diagnostic_head(lines[next_index]) -> break
            marker: lines[next_index].trim_start()
            if marker.starts_with("-->") {
                location = marker.removeprefix("-->").trim().partition(" ").head
                break
            }
        }
        found.push(Located{head: lines[index].copy(), location: location})
    }
    if found.len() == 0 && code == 0 -> return "CHECK OK"
    if found.len() == 0 -> return "CHECK FAILED — jet check exited {code} without a compiler diagnostic\n{text}"
    keys := [String]{}
    order := [String]{}
    loop entry in found {
        key := file_of(entry.location)
        if key == "" -> key = "(no location)"
        if !order.contains(key) -> order.push(key.copy())
        keys.push(key)
    }
    out := "CHECK FAILED — {found.len()} error(s) in {order.len()} file(s)\n"
    loop key in order {
        out = "{out}\n{key}\n"
        loop index in 0..<found.len() {
            if keys[index] != key -> next
            entry: found[index]
            shown: if entry.location == "" -> entry.head.copy() else -> "{entry.location}: {entry.head}"
            out = "{out}  {shown}\n"
        }
    }
    "{out}\n--- complete compiler output ---\n{text}"
}

// `path:line:col` without its `:line:col`.
file_of: fn(location: String) -> String Never! {
    parts: location.split(":").to_list()
    if parts.len() >= 3 && int_or(parts[parts.len() - 1], -1) >= 0 && int_or(parts[parts.len() - 2], -1) >= 0 {
        return parts[0..<parts.len() - 2].join(":")
    }
    location.copy()
}

// --- Core sources ------------------------------------------------------------

// What a Core source checks as: the module whose probe loads it (a private
// part's owner, else its own module), or itself when it is a runtime unit.
CoreRow: struct {
    probe_module: String
    runtime: Bool
}

// Text field `key` of a JSON object, or "" when it is absent or not text.
json_text: fn(value: Dyn, key: String) -> String Never! {
    found: value.get(key) ?? return ""
    if found == .Text(content) -> return content.copy()
    ""
}

// The row of the Core source at `relative` in `structure` (the output of
// `jet inspect structure --core --json`), or None.
core_row: fn(structure: String, relative: String) -> CoreRow? Never! {
    answer: json.parse(structure) ?? return None
    core: answer.get("core") ?? return None
    listed: core.get("sources") ?? return None
    sources: if listed == .Array(rows) -> rows.copy() else -> return None
    loop source in sources {
        if json_text(source, "path") != relative -> next
        owner: json_text(source, "owner")
        runtime: (source.get("runtime") ?? Dyn.Null) == .Bool(true)
        return Val(CoreRow{probe_module: if owner != "" -> owner else -> json_text(source, "module"), runtime: runtime})
    }
    None
}

// CoreModuleCheck.jet's one-import probe of Core module `name`.
core_probe_source: fn(name: String) -> String Never! {
    "use {name}\n\nmain: fn() {{\n    print(\"ok\")\n}}\n"
}

// `relative` (a Core source) checked as the compiler loads Core: from this
// checkout (run_check's JET_TOOLCHAIN_ROOT), with Core's privileges. A public
// module or a private part checks as its module's one-import probe, which
// checks the bodies a program importing it alone reaches, then as `jet check
// Core`, which checks every Core body, called or not.
core_check: fn(repo: String, jet: String, relative: String, target: String, scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    // Asked from Compiler/, a package: a jet built before `--core` stopped
    // resolving the inspect target refuses it where no package.jet is found.
    asked: process.cmd([String]{jet, "inspect", "structure", "--core", "--json"}).cwd("{repo}/Compiler").env("NO_COLOR", "1").output_limit(268435456).run() ?? return Ran{code: 1, text: "lane-check: `{jet} inspect structure --core --json` could not start: {err}\n"}
    if asked.code != 0 || asked.signal != None -> return Ran{code: 1, text: "{process.combined_output(asked)}\nlane-check: `{jet} inspect structure --core --json` failed\n"}
    row: core_row(asked.output, relative) ?? return Ran{code: 1, text: "lane-check: {relative} is no Core source of `{jet} inspect structure --core --json`; declare it in Compiler/Prelude/Core.rows or CoreSourceParts.tsv and rebuild the compiler\n"}
    if row.runtime -> return run_check(repo, jet, [String]{"check", target}, scratch)
    dir: "{scratch}/core-probe.{sys.pid()}"
    files.create_dir_all(dir) ?? return Ran{code: 1, text: "lane-check: cannot create {dir}: {err}\n"}
    probe: "{dir}/probe.jet"
    files.write(probe, core_probe_source(row.probe_module)) ?? return Ran{code: 1, text: "lane-check: cannot write {probe}: {err}\n"}
    term.eprint("lane-check: {relative} checks as Core module {row.probe_module}: {probe}, then as `jet check Core`")
    alone: run_check(repo, jet, [String]{"check", probe}, scratch)
    every: run_check(repo, jet, [String]{"check", "{repo}/Core"}, scratch)
    Ran{code: if alone.code != 0 -> alone.code else -> every.code, text: "{alone.text}{every.text}"}
}

// --- assembled runtime ------------------------------------------------------

RUNTIME_TREE: "Compiler/JetRuntime"
RUNTIME_SOURCES: "Compiler/JetRuntime/sources.list"
RUNTIME_PACKAGE: "Compiler/JetRuntime/package.jet"

// Where one line of the assembled runtime unit came from: a listed source and
// its 1-based line, or no path for the unit's Core import header.
UnitLine: struct {
    path: String
    line: Int
}

RuntimeUnit: struct {
    text: String
    lines: [UnitLine]
    problem: String
}

// The runtime's explicit source manifest: every non-empty, non-comment line,
// none twice.
runtime_sources: fn(repo: String) -[FS]> (paths: [String], problem: String) Never! {
    paths := [String]{}
    text: files.read("{repo}/{RUNTIME_SOURCES}") ?? return (paths: paths, problem: "cannot read {RUNTIME_SOURCES}: {err}")
    loop raw in text.split("\n") {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        if paths.contains(line) -> return (paths: [String]{}, problem: "{RUNTIME_SOURCES} lists {line} twice")
        paths.push(line.copy())
    }
    if paths.len() == 0 -> return (paths: paths, problem: "{RUNTIME_SOURCES} lists no source")
    (paths: paths, problem: "")
}

runtime_unit: fn(repo: String) -[FS]> RuntimeUnit Never! {
    listed: runtime_sources(repo)
    if listed.problem != "" -> return RuntimeUnit{text: "", lines: [UnitLine]{}, problem: listed.problem}
    texts := [String]{}
    loop path in listed.paths {
        text: files.read("{repo}/{path}") ?? return RuntimeUnit{text: "", lines: [UnitLine]{}, problem: "cannot read {path}: {err}"}
        texts.push(text)
    }
    assemble_runtime(listed.paths, texts)
}

// The runtime unit Compiler/Toolchain/RuntimePack.jet `unit` assembles: each listed source with its
// `use` lines (and a multi-line `use x.[` continuation) dropped behind a
// `// [unit source: PATH]` line, after the distinct Core imports they named
// and one blank line.
assemble_runtime: fn(paths: [String], texts: [String]) -> RuntimeUnit Never! {
    uses := [String]{}
    body := [String]{}
    origins := [UnitLine]{}
    loop index in 0..<paths.len() {
        path: paths[index]
        body.push("// [unit source: {path}]")
        origins.push(UnitLine{path: path.copy(), line: 1})
        importing := false
        number := 0
        loop line in unblock_uses(texts[index]).split("\n") {
            number += 1
            if line.starts_with("use ") {
                if core_use(line) && !uses.contains(line) -> uses.push(line.copy())
                importing = line.contains("[") && !line.contains("]")
                next
            }
            if importing {
                if line.contains("]") -> importing = false
                next
            }
            body.push(line.copy())
            origins.push(UnitLine{path: path.copy(), line: number})
        }
    }
    lines := [UnitLine]{}
    loop _ in 0..<(uses.len() + 1) -> lines.push(UnitLine{path: "", line: 0})
    lines.extend(origins)
    text := uses.copy()
    text.push("")
    text.extend(body)
    RuntimeUnit{text: text.join("\n"), lines: lines, problem: ""}
}

// `use core.x` or `use alias: core.x`.
core_use: fn(line: String) -> Bool Never! {
    rest: line.removeprefix("use ")
    if rest.starts_with("core.") -> return true
    parts: rest.partition(": ")
    parts.sep != "" && parts.head != "" && parts.head.bytes().all(b -> word_byte(b)) && parts.tail.starts_with("core.")
}

word_byte: fn(b: U8) -> Bool Never! {
    (b >= (U8{48}) && b <= (U8{57})) || (b >= (U8{65}) && b <= (U8{90})) || (b >= (U8{97}) && b <= (U8{122})) || b == (U8{95})
}

space_byte: fn(b: U8) -> Bool Never! { b == (U8{32}) || b == (U8{9}) || b == (U8{10}) || b == (U8{13}) || b == (U8{11}) || b == (U8{12}) }

// A `use { … }` block rewritten as one `use` line per row, keeping every line:
// `use {` and its `}` turn to spaces and each row's last four columns of
// indentation become `use `. `pub use { … }` stays as written.
unblock_uses: fn(text: String) -> String Never! {
    lines := text.split("\n").to_list()
    indent := ""
    open := false
    depth := 0
    loop at in 0..<lines.len() {
        line: lines[at].copy()
        if !open {
            trimmed: line.trim_start()
            lead: line.removesuffix(trimmed)
            if lead.bytes().all(b -> space_byte(b)) && trimmed.starts_with("use {{") && trimmed.removeprefix("use {{").trim() == "" {
                indent = lead.copy()
                open = true
                lines[at] = " ".repeat(line.len())
            }
            next
        }
        closer: "{indent}}}"
        if depth == 0 && line.trim_end() == closer {
            open = false
            lines[at] = " ".repeat(line.len())
            next
        }
        row: "{indent}    "
        if depth == 0 && line.starts_with(row) {
            rest: line.removeprefix(row)
            first: if rest.count_bytes() > 0 -> rest.bytes()[0] else -> U8{0}
            if (first >= (U8{65}) && first <= (U8{90})) || (first >= (U8{97}) && first <= (U8{122})) || first == (U8{95}) || first == (U8{34}) -> lines[at] = "{indent}use {rest}"
        }
        loop b in line.partition("//").head.bytes() {
            if b == (U8{91}) -> depth += 1
            if b == (U8{93}) -> depth -= 1
        }
    }
    lines.join("\n")
}

// The assembled unit checked beside a copy of the runtime's package.jet, with
// every location in the unit moved to the source line it came from.
runtime_check: fn(repo: String, jet: String, scratch: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    unit: runtime_unit(repo)
    if unit.problem != "" -> return Ran{code: 1, text: "lane-check: the runtime unit cannot be assembled: {unit.problem}\n"}
    dir: "{scratch}/runtime-unit.{sys.pid()}"
    files.create_dir_all(dir) ?? return Ran{code: 1, text: "lane-check: cannot create {dir}: {err}\n"}
    manifest: files.read("{repo}/{RUNTIME_PACKAGE}") ?? return Ran{code: 1, text: "lane-check: cannot read {RUNTIME_PACKAGE}: {err}\n"}
    files.write("{dir}/package.jet", manifest) ?? return Ran{code: 1, text: "lane-check: cannot write {dir}/package.jet: {err}\n"}
    path: "{dir}/unit.jet"
    files.write(path, unit.text) ?? return Ran{code: 1, text: "lane-check: cannot write {path}: {err}\n"}
    term.eprint("lane-check: assembled runtime unit: {path}")
    ran: run_check(repo, jet, [String]{"check", path}, scratch)
    Ran{code: ran.code, text: runtime_locations(ran.text, path, unit.lines)}
}

// The compiler output with each `--> unit.jet:LINE:COL` naming the listed
// source and line instead.
runtime_locations: fn(text: String, unit_path: String, lines: [UnitLine]) -> String Never! {
    out := [String]{}
    loop line in text.split("\n") {
        trimmed: line.trim_start()
        location: trimmed.removeprefix("-->").trim().partition(" ")
        file: file_of(location.head)
        parts: location.head.split(":").to_list()
        if !trimmed.starts_with("-->") || file == location.head || (file != unit_path && !unit_path.ends_with("/{file}")) {
            out.push(line.copy())
            next
        }
        number: int_or(parts[parts.len() - 2], -1)
        if number < 1 || number > lines.len() || lines[number - 1].path == "" {
            out.push(line.copy())
            next
        }
        origin: lines[number - 1]
        tail: if location.sep == "" -> "" else -> " {location.tail}"
        out.push("{line.removesuffix(trimmed)}--> {origin.path}:{origin.line}:{parts[parts.len() - 1]}{tail}")
    }
    out.join("\n")
}

// --- personal-information guard ---------------------------------------------

Identity: struct {
    home: String
    user: String
    host: String
    scratch_root: String
    mounts: [String]
    email: String
    name: String
}

Rule: struct {
    kind: String
    find: String
    source: String
}

// Names too common to be personal; a machine using one is not flagged by it.
GENERIC_NAMES: [String]{"admin", "arch", "build", "builder", "ci", "debian", "dev", "devhost", "fedora", "localhost", "nixos", "owner", "root", "runner", "test", "tester", "ubuntu", "user", "users"}

escape_pcre: fn(text: String) -> String Never! {
    out := ""
    loop ch in text.chars() {
        if "\\^$.*+?()[]{{}}|/".contains("{ch}") -> out = "{out}\\"
        out = "{out}{ch}"
    }
    out
}

within: fn(path: String, root: String) -> Bool Never! { path == root || path.starts_with("{root}/") }

trim_slashes: fn(text: String) -> String Never! {
    out := text
    loop out.ends_with("/") -> out = out.removesuffix("/")
    out
}

// /proc/mounts escapes space, tab, newline and backslash as octal \NNN.
unescape_mount: fn(text: String) -> String Never! {
    bytes: text.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        if Int.from_u8(bytes[index]) == 92 && octal3(bytes, index + 1) >= 0 {
            out.push(U8.from_int(octal3(bytes, index + 1)) ?? U8{63})
            index += 4
            next
        }
        out.push(bytes[index])
        index += 1
    }
    String.from_bytes_lossy(out)
}

octal3: fn(bytes: [U8], at: Int) -> Int Never! {
    if at + 3 > bytes.len() -> return -1
    value := 0
    loop index in at..<at + 3 {
        code: Int.from_u8(bytes[index])
        if code < 48 || code > 55 -> return -1
        value = value * 8 + code - 48
    }
    value
}

machine_mounts: fn() -[FS]> [String] Never! {
    out := [String]{}
    text: files.read("/proc/mounts") ?? return out
    loop line in text.lines() {
        fields: line.split(" ").to_list()
        if fields.len() < 2 -> next
        mount: unescape_mount(fields[1])
        if (mount.starts_with("/mnt/") && mount.len() > 5) || (mount.starts_with("/media/") && mount.len() > 7) || (mount.starts_with("/run/media/") && mount.len() > 11) -> out.push(mount)
    }
    out
}

git_config: fn(key: String, dir: String) -[Exec, Time.Wait]> String Never! {
    receipt: process.cmd([String]{"git", "config", "--get", key}).cwd(dir).run() ?? return ""
    if receipt.code != 0 -> return ""
    receipt.output.trim()
}

machine_identity: fn(dir: String) -[Env, Exec, FS, Time.Wait]> Identity Never! {
    Identity{
        home: process.env_nonempty("HOME") ?? "",
        user: process.env_nonempty("USER") ?? (process.env_nonempty("LOGNAME") ?? ""),
        host: sys.hostname().partition(".").head,
        scratch_root: process.env_nonempty("JET_SCRATCH_ROOT") ?? "",
        mounts: machine_mounts(),
        email: git_config("user.email", dir),
        name: git_config("user.name", dir),
    }
}

RuleSet: struct {
    rules: [Rule]
    seen: [String]
}

add_path: fn(set: &RuleSet, raw: String) Never! {
    find: trim_slashes(raw)
    if find.len() < 2 || set.seen.contains(find) -> return
    set.seen.push(find.copy())
    set.rules.push(Rule{kind: "path", find: find.copy(), source: "{escape_pcre(find)}(?![\\w-])"})
}

add_word: fn(set: &RuleSet, raw: String) Never! {
    find: raw.trim()
    lower: find.lower()
    if find.len() < 3 || GENERIC_NAMES.contains(lower) || set.seen.contains(lower) -> return
    set.seen.push(lower)
    set.rules.push(Rule{kind: "word", find: find.copy(), source: "\\b{escape_pcre(find)}\\b"})
}

// The GitHub handle in a `<digits>+<handle>@users.noreply.github.com` address.
noreply_handle: fn(email: String) -> String Never! {
    suffix: "@users.noreply.github.com"
    if !email.lower().ends_with(suffix) -> return ""
    local: email[0..<email.len() - suffix.len()]
    parts: local.partition("+")
    if parts.sep == "" || int_or(parts.head, -1) < 0 || parts.tail == "" || parts.tail.contains("@") -> return ""
    parts.tail
}

// Path rules match a literal path that does not continue into a longer name;
// word rules match a whole word in any letter case.
personal_info_rules: fn(identity: Identity) -> [Rule] Never! {
    set := RuleSet{rules: [Rule]{}, seen: [String]{}}
    home: identity.home
    login: if identity.user != "root" -> identity.user else -> ""
    scratch: if identity.scratch_root != "" && !within(identity.scratch_root, home) && !within(identity.scratch_root, "/tmp") -> trim_slashes(identity.scratch_root) else -> ""
    if login != "" -> add_path(set, "/etc/profiles/per-user/{login}")
    if scratch != "" -> add_path(set, scratch)
    loop mount in identity.mounts -> add_path(set, mount)
    if home != "" && home != "/" -> add_path(set, home)
    if login != "" {
        add_path(set, "/home/{login}")
        add_path(set, "/Users/{login}")
    }
    if identity.email != "" -> add_path(set, identity.email)
    if identity.name != "" -> add_word(set, identity.name)
    handle: noreply_handle(identity.email)
    if handle != "" -> add_word(set, handle)
    if login != "" -> add_word(set, login)
    if identity.host != "" -> add_word(set, identity.host)
    // Every spelling of the state root, the machine's home first, then the
    // bare cache-relative form. Both roots are joined from parts so this file
    // does not match its own rules.
    state_root: [String]{".cache", "jet-dev"}.join("/")
    prefixes := [String]{}
    if home != "" && home != "/" -> prefixes.push(home.copy())
    if login != "" {
        prefixes.push("/home/{login}")
        prefixes.push("/Users/{login}")
    }
    prefixes.extend([String]{"${{HOME}}", "$HOME", "~"})
    forms := [String]{}
    loop prefix in prefixes {
        form: "{prefix}/{state_root}"
        if !forms.contains(form) -> forms.push(form)
    }
    forms.push(state_root.copy())
    escaped := [String]{}
    loop form in forms -> escaped.push(escape_pcre(form))
    set.rules.push(Rule{kind: "path", find: forms[0].copy(), source: "(?:{escaped.join("|")})(?![\\w-])"})
    run_root: [String]{"", "tmp", "tdev"}.join("/")
    set.rules.push(Rule{kind: "path", find: run_root.copy(), source: "(?:{escape_pcre(run_root)})(?![\\w-])"})
    set.rules
}

grep_args: fn(rules: [Rule], kind: String) -> [String] Never! {
    out := [String]{}
    loop rule in rules {
        if rule.kind == kind -> out.extend([String]{"-e", rule.source.copy()})
    }
    out
}

GREP_EXCLUDES: [String]{"--", ".", ":!.git", ":!.chain", ":!.chain-base", ":!.chain-lock"}

// Refuse personal or machine information anywhere in `dir` (#6564 c5).
personal_info_guard: fn(dir: String) -[Env, Exec, FS, IO, Time.Wait]> Int Never! {
    if !files.is_dir(dir) {
        term.eprint("personal-info-guard: {dir} is not a directory")
        return 64
    }
    if process.which("git") == None {
        term.eprint("personal-info-guard: git is required")
        return 64
    }
    rules: personal_info_rules(machine_identity(dir))
    path_args: grep_args(rules, "path")
    word_args: grep_args(rules, "word")
    found := [String]{}
    passes: [(flags: [String], args: [String])]{(flags: [String]{"-l"}, args: path_args), (flags: [String]{"-l", "-i"}, args: word_args)}
    loop pass in passes {
        if pass.args.len() == 0 -> next
        argv := [String]{"git", "grep", "--no-index", "--exclude-standard", "-I", "-P"}
        argv.extend(pass.flags)
        argv.extend(pass.args)
        argv.extend(GREP_EXCLUDES)
        receipt: process.cmd(argv).cwd(dir).output_limit(268435456).run() ?? {
            term.eprint("personal-info-guard: git grep could not start: {err}")
            return 64
        }
        if receipt.code > 1 || receipt.signal != None {
            term.eprint("personal-info-guard: git grep failed (rc={receipt.code})")
            return 64
        }
        loop name in receipt.output.lines() {
            if name != "" && !found.contains(name) -> found.push(name.copy())
        }
    }
    if found.len() == 0 -> return 0
    term.eprint("personal-info-guard: {found.len()} file(s) name this machine's home, user, host, email or mounts.")
    term.eprint("Write ~ or $HOME, $USER, $JET_SCRATCH_ROOT, $JET_STATE_ROOT, $JET_RUN_ROOT, `user` or `devhost` instead (#6564 c5). First hits:")
    shown := 0
    loop file in found {
        if shown == 20 -> break
        shown += 1
        line := first_hit(dir, file, path_args, [String]{})
        if line == "" -> line = first_hit(dir, file, word_args, [String]{"-i"})
        term.eprint("  {hit_text(line)}")
    }
    65
}

// A hit line as the guard shows it: its first 200 bytes.
hit_text: fn(line: String) -> String Never! {
    if line.len() > 200 -> line[0..<200] else -> line.copy()
}

first_hit: fn(dir: String, file: String, args: [String], flags: [String]) -[Exec, Time.Wait]> String Never! {
    if args.len() == 0 -> return ""
    argv := [String]{"git", "grep", "--no-index", "-I", "-P", "-n", "-m", "1"}
    argv.extend(flags.copy())
    argv.extend(args.copy())
    argv.extend([String]{"--", file})
    receipt: process.cmd(argv).cwd(dir).output_limit(268435456).run() ?? return ""
    receipt.output.partition("\n").head
}

#Test("the report passes a clean run and groups every diagnostic by file") {
    assert_eq(report("Finished fixture check\n", 0), "CHECK OK")
    failed: report("beginning\nend\n", 17)
    assert(failed.starts_with("CHECK FAILED — jet check exited 17 without a compiler diagnostic\n"))
    assert(failed.contains("beginning\nend\n"))
    text := ""
    loop n in 1..<9 -> text = "{text}error[E0308]: independent error {n}\n  --> src/shared.jet:{n}:1\n"
    text = "{text}Error [jet.StrayCharacter]: bad escape\n  --> other.jet:3:7\n    |\ncomplete diagnostic tail retained\n"
    grouped: report(text, 101)
    assert(grouped.starts_with("CHECK FAILED — 9 error(s) in 2 file(s)\n"))
    loop n in 1..<9 -> assert(grouped.contains("src/shared.jet:{n}:1: error[E0308]: independent error {n}"))
    assert(grouped.contains("\nother.jet\n  other.jet:3:7: Error [jet.StrayCharacter]: bad escape\n"))
    assert(grouped.ends_with("--- complete compiler output ---\n{text}"))
}

#Test("personal-information rules follow the machine's identity") {
    identity: Identity{home: "/home/ada", user: "ada", host: "lovelace", scratch_root: "/mnt/big", mounts: [String]{"/mnt/big", "/media/usb"}, email: "12+adagh@users.noreply.github.com", name: "Ada King"}
    rules: personal_info_rules(identity)
    finds := [String]{}
    loop rule in rules -> finds.push("{rule.kind}:{rule.find}")
    assert(finds.contains("path:/etc/profiles/per-user/ada"))
    assert(finds.contains("path:/mnt/big"))
    assert(finds.contains("path:/media/usb"))
    assert(finds.contains("path:/home/ada"))
    assert(finds.contains("path:/Users/ada"))
    assert(finds.contains("word:Ada King"))
    assert(finds.contains("word:adagh"))
    assert(finds.contains("word:ada"))
    assert(finds.contains("word:lovelace"))
    assert_eq(rules[0].source, "\\/etc\\/profiles\\/per-user\\/ada(?![\\w-])")
    generic: personal_info_rules(Identity{home: "/root", user: "root", host: "runner", scratch_root: "", mounts: [String]{}, email: "", name: ""})
    loop rule in generic -> assert(rule.kind == "path")
    assert_eq(unescape_mount("/mnt/my\\040disk"), "/mnt/my disk")
    assert_eq(noreply_handle("someone@example.com"), "")
}

#Test("the runtime unit drops imports behind source markers and maps locations back") {
    alloc: "use core.mem\nuse {{\n    jet_backend.[\n        os_store_i64,\n    ]\n    m: core.mem\n}}\nalloc: fn() {{}}\n"
    text: "use core.mem\nuse jet_runtime.Alloc\ntext: fn() {{}}\n"
    unit: assemble_runtime([String]{"R/Alloc.jet", "R/Text.jet"}, [String]{alloc, text})
    assert_eq(unit.text, "use core.mem\nuse m: core.mem\n\n// [unit source: R/Alloc.jet]\n     \n \nalloc: fn() {{}}\n\n// [unit source: R/Text.jet]\ntext: fn() {{}}\n")
    assert_eq(unit.lines.len(), 11)
    assert_eq(unit.lines[6].path, "R/Alloc.jet")
    assert_eq(unit.lines[6].line, 8)
    assert_eq(unit.lines[9].line, 3)
    assert(core_use("use core.files") && core_use("use cf: core.files") && !core_use("use jet_backend.x") && !core_use("use a b: core.x"))
    moved: runtime_locations("Error [jet.UnknownFunction]: no\n  --> /s/unit.jet:10:5 here\n  --> other.jet:9:5\n  --> /s/unit.jet:1:1\n", "/s/unit.jet", unit.lines)
    assert_eq(moved, "Error [jet.UnknownFunction]: no\n  --> R/Text.jet:3:5 here\n  --> other.jet:9:5\n  --> /s/unit.jet:1:1\n")
}

#Test("a Prelude source is routed to its generator check and the prelude mode") {
    assert(prelude_source("Compiler/Prelude/Traits.jet") && prelude_source("Compiler/Prelude/CoreSourceParts.tsv") && prelude_source("Compiler/Prelude/Core.rows") && prelude_source("Compiler/Prelude/core/prelude.jet"))
    assert(!prelude_source("Compiler/Prelude/package.jet") && !prelude_source("Compiler/Prelude/Assets/host.js") && !prelude_source("Compiler/Prelude") && !prelude_source("Compiler/JetCli/Source/Cli/Front.jet"))
    assert_eq(prelude_generator("Effects.jet", "/j"), [String]{"/j", "Tools/agent/CoreSourceRows.jet", "--check"})
    assert_eq(prelude_generator("Core.rows", "/j"), [String]{"/j", "check", CORE_DECLARATION_TABLES})
    assert_eq(prelude_generator("CoreCallExtensions.jet", "/j"), [String]{})
    assert_eq(prelude_generator("CoreSurfaceInventory.rows", "/j"), [String]{"/j", "Tools/agent/CoreSurfaceLedger.jet", "--check"})
    assert_eq(prelude_generator("Diagnostics.jet", "/j")[1], "Tools/agent/DiagnosticRows.jet")
    assert_eq(prelude_generator("core/prelude.jet", "/j")[1], "Tools/agent/OwnedTraitRows.jet")
    assert_eq(prelude_generator("Units.jet", "/j")[1], "Toolchain/PreludeSources.jet")
    assert_eq(prelude_generator("Facts.jet", "/j").len(), 0)
}

#Test("a Core source checks as its module, its part's owner, or its runtime unit") {
    registry: "{{\"schema\":\"jet.status/v1\",\"core\":{{\"sources\":[{{\"path\":\"Core/Encoding/Encoding.jet\",\"module\":\"core.encoding\",\"owner\":\"\",\"runtime\":false}},{{\"path\":\"Core/Encoding/Stream.jet\",\"module\":\"__s\",\"owner\":\"core.encoding\",\"runtime\":false}},{{\"path\":\"Core/Files/Runtime/K.jet\",\"module\":\"core.files.runtime.k\",\"owner\":\"\",\"runtime\":true}}]}}}}"
    own: core_row(registry, "Core/Encoding/Encoding.jet") ?? panic("no module row")
    assert_eq(own.probe_module, "core.encoding")
    assert(!own.runtime)
    part: core_row(registry, "Core/Encoding/Stream.jet") ?? panic("no part row")
    assert_eq(part.probe_module, "core.encoding")
    runtime: core_row(registry, "Core/Files/Runtime/K.jet") ?? panic("no runtime row")
    assert(runtime.runtime)
    assert(core_row(registry, "Core/Encoding") == None && core_row(registry, "Core/Files/Runtime/K") == None)
    assert_eq(core_probe_source("core.encoding"), "use core.encoding\n\nmain: fn() {{\n    print(\"ok\")\n}}\n")
}

#Test("JET_CHECK_MEM sizes read as bytes; anything else is refused") {
    assert_eq(memory_bytes("20G"), 21474836480)
    assert_eq(memory_bytes("512M"), 536870912)
    assert_eq(memory_bytes("4096K"), 4194304)
    assert_eq(memory_bytes("65536"), 65536)
    assert_eq(memory_bytes("G"), -1)
    assert_eq(memory_bytes("0G"), -1)
    assert_eq(memory_bytes("20GB"), -1)
}

#Test("the Jetpack assembly check runs its Jet tool under the checked jet, not the seed") {
    tool := ""
    loop setting in assembly_env("/opt/jet/bin/jet") {
        if setting.name == "JET_BIN" -> tool = setting.value
    }
    assert_eq(tool, "/opt/jet/bin/jet")
}
