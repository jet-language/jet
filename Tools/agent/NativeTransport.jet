#!/usr/bin/env jet
// The production Jet CLI transport of the native fixture runners. Each
// command logs its output and run record beside PREFIX (PREFIX.front.log,
// PREFIX.front.run.json); fresh artifacts, never a completion line, prove
// that the requested native feed was produced.
// Usage (from the repository root):
//   jet Tools/agent/NativeTransport.jet library JET FILE PREFIX LIFECYCLE [--exports LIST] [--set NAME=VALUE]... [--timeout MS]
//       `JET doc FILE` in FILE's directory with the native library hooks: the
//       object, exports, ABI and threads files beside PREFIX, lowered against
//       LIFECYCLE and, given one, the C export list LIST
//   jet Tools/agent/NativeTransport.jet program JET FILE ROOT PREFIX [--set NAME=VALUE]... [--timeout MS]
//       `JET build FILE` in ROOT (given a transport package.jet when it has
//       none), copied to PREFIX.exe
//   jet Tools/agent/NativeTransport.jet stage JET PACK OUT
//       stage JET and PACK's runtime directory into OUT, or confirm the
//       copies already there are unchanged
// library and program print {"run": RECORD, "problem": null | {"verdict",
// "detail"}} (program adds "binary"); stage prints {"jet": OUT/jet}. The jet
// they run inherits this process's environment without its JET_BOOTSTRAP_*
// and JET_FRONT_* hooks, plus each --set. MS 0 waits without a deadline; the
// default is JET_FRONT_TIMEOUT_MS, else 600000.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    term: core.term
    time: core.time
}

USAGE: "usage: jet Tools/agent/NativeTransport.jet library JET FILE PREFIX LIFECYCLE [--exports LIST] [--set NAME=VALUE]... [--timeout MS] | program JET FILE ROOT PREFIX [--set NAME=VALUE]... [--timeout MS] | stage JET PACK OUT"
DEFAULT_TIMEOUT_MS: 600000
OUTPUT_LIMIT: 134217728
TRANSPORT_PACKAGE: "name: \"compiler_registry_transport\"\nversion: \"0.0.1\"\nedition: \"2026\"\nauthority: {{ allow: [Env, Exec, Exec.Args, FS, IO, Mem.Alloc, Time.Wait, FFI] }}\n"
LIBRARY_ARTIFACTS: [String]{".o", ".exports", ".abi.json", ".threads"}

Setting: struct {
    name: String
    value: String
}

Options: struct {
    positional: [String]
    exports: String
    settings: [Setting]
    timeout_ms: Int
}

// One finished command: its exit status, or the signal, timeout or spawn
// failure that ended it.
Ran: struct {
    code: Int?
    signal: Int?
    error: String?
    stdout: String
    stderr: String
}

run: fn() {
    args: process.args()
    if args.len() == 0 -> return fail(USAGE)
    options: parse_options(args)
    command: args[0]
    at: options.positional
    if command == "library" && at.len() == 4 -> return print(library(at[0], at[1], at[2], at[3], options))
    if command == "program" && at.len() == 4 && options.exports == "" -> return print(program(at[0], at[1], at[2], at[3], options))
    if command == "stage" && at.len() == 3 && options.exports == "" && options.settings.len() == 0 -> return print(stage(at[0], at[1], at[2]))
    fail(USAGE)
}

fail: fn(message: String) -[Exec, IO]> Never {
    term.eprint("native transport: {message}")
    process.exit(1)
}

parse_options: fn(args: [String]) -[Env, Exec, IO]> Options Never! {
    options := Options{positional: [String]{}, exports: "", settings: [Setting]{}, timeout_ms: default_timeout_ms()}
    at := 1
    loop at < args.len() {
        name: args[at]
        if !name.starts_with("--") {
            options.positional.push(name.copy())
            at += 1
            next
        }
        if at + 1 >= args.len() -> return fail(USAGE)
        value: args[at + 1]
        if name == {
            "--exports" -> options.exports = value.copy()
            "--timeout" -> options.timeout_ms = Int.parse(value) ?? return fail("--timeout `{value}` is not a whole number of milliseconds")
            "--set" -> options.settings.push(setting(value) ?? return fail("--set `{value}` is not NAME=VALUE"))
            else -> return fail(USAGE)
        }
        at += 2
    }
    options
}

setting: fn(text: String) -> Setting? Never! {
    at: text.find("=")
    if at <= 0 -> return None
    Val(Setting{name: text.slice(0, at), value: text.slice(at + 1, text.count_bytes())})
}

default_timeout_ms: fn() -[Env]> Int Never! {
    text: process.env_get("JET_FRONT_TIMEOUT_MS") ?? return DEFAULT_TIMEOUT_MS
    Int.parse(text) ?? DEFAULT_TIMEOUT_MS
}

// A transport child inherits neither bootstrap modes nor stale front-end hooks.
strips_transport: fn(name: String) -> Bool Never! {
    name.starts_with("JET_BOOTSTRAP_") || name.starts_with("JET_FRONT_")
}

texts: fn(items: [String]) -> Dyn Never! { Dyn.Array(items.map(item -> Dyn.Text(item.copy()))) }

maybe_int: fn(value: Int?) -> Dyn Never! {
    if value == .Val(number) -> return Dyn.Int(number)
    Dyn.Null
}

maybe_text: fn(value: String?) -> Dyn Never! {
    if value == .Val(text) -> return Dyn.Text(text.copy())
    Dyn.Null
}

// `jet ARGS` in `cwd`: the transport environment plus `hooks` and the
// caller's settings, its output and run record written beside `prefix`.
front: fn(jet: String, args: [String], cwd: String, hooks: [Setting], options: Options, prefix: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Dyn Never! {
    files.create_dir_all(files.dirname(prefix)) ?? return fail("`{files.dirname(prefix)}` cannot be created: {err}")
    argv := [String]{jet.copy()}
    loop arg in args -> argv.push(arg.copy())
    spec := process.cmd(argv).cwd(cwd).output_limit(OUTPUT_LIMIT)
    if options.timeout_ms > 0 -> spec = spec.timeout(time.duration_ms(options.timeout_ms))
    keys: process.env_keys() ?? [String]{}
    loop name in keys {
        if strips_transport(name) -> spec = spec.env_remove(name)
    }
    loop given in options.settings {
        if strips_transport(given.name) -> spec = spec.env_remove(given.name) else -> spec = spec.env(given.name, given.value)
    }
    loop hook in hooks -> spec = spec.env(hook.name, hook.value)
    ran: finished(spec, options.timeout_ms)
    files.write("{prefix}.front.log", "{ran.stdout}{ran.stderr}") ?? return fail("`{prefix}.front.log` cannot be written: {err}")
    record: Dyn.Object([String: Dyn]{
        "command": Dyn.Text(jet.copy()),
        "args": texts(args),
        "cwd": Dyn.Text(cwd.copy()),
        "status": maybe_int(ran.code),
        "signal": maybe_int(ran.signal),
        "error": maybe_text(ran.error),
        "stdout": Dyn.Text(ran.stdout.copy()),
        "stderr": Dyn.Text(ran.stderr.copy()),
    })
    text: json.to_string_pretty(record) ?? return fail("the run record cannot be encoded: {err}")
    files.write("{prefix}.front.run.json", "{text}\n") ?? return fail("`{prefix}.front.run.json` cannot be written: {err}")
    record
}

finished: fn(spec: ProcessSpec, timeout_ms: Int) -[Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    receipt: spec.run() ?? return Ran{code: None, signal: None, error: Val("{err}"), stdout: "", stderr: ""}
    if receipt.timed_out -> return Ran{code: None, signal: receipt.signal, error: Val("timed out after {timeout_ms} ms"), stdout: receipt.output.copy(), stderr: receipt.errors.copy()}
    code: if receipt.signal == None -> Val(receipt.code) else -> None
    Ran{code: code, signal: receipt.signal, error: None, stdout: receipt.output.copy(), stderr: receipt.errors.copy()}
}

// A command that did not exit 0 produced no artifact, whatever it printed.
command_problem: fn(record: Dyn) -> String? Never! {
    status: field(record, "status")
    if status == .Int(0) && field(record, "error") == Dyn.Null -> return None
    exit: if {
        status != Dyn.Null -> json.dumps(status) ?? "null"
        else -> json.dumps(field(record, "signal")) ?? "null"
    }
    reason: if field(record, "error") == .Text(message) -> message.copy() else -> text_field(record, "stderr")
    Val("native Jet exit {exit}: {reason}")
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

outcome: fn(record: Dyn, problem: String?, binary: String) -> String Never! {
    entries := [String: Dyn]{"run": record}
    entries["problem"] = if problem == .Val(detail) -> Dyn.Object([String: Dyn]{"verdict": Dyn.Text("no-artifact"), "detail": Dyn.Text(detail.copy())}) else -> Dyn.Null
    if binary != "" -> entries["binary"] = Dyn.Text(binary.copy())
    json.dumps(Dyn.Object(entries)) ?? "{{}}"
}

remove_stale: fn(paths: [String]) -[Exec, FS, IO]> () {
    loop path in paths {
        if files.exists(path) -> files.remove(path) ?? return fail("`{path}` cannot be removed: {err}")
    }
}

absolute: fn(path: String) -[Env, Exec, FS, IO]> String Never! {
    files.absolute(path) ?? fail("`{path}` cannot be resolved: {err}")
}

// The library seam runs under `jet doc`, as runtime packaging does: `jet
// check` stops before lowering, so it has no C export rows to build.
library: fn(jet: String, file: String, prefix: String, lifecycle: String, options: Options) -[Env, Exec, FS, IO, Time, Time.Wait]> String Never! {
    source: absolute(file)
    base: absolute(prefix)
    list: absolute(lifecycle)
    if !files.exists(list) -> return fail("native library lifecycle list `{list}` is missing")
    remove_stale([String]{"{base}.o", "{base}.exports", "{base}.abi.json", "{base}.threads", "{base}.issues"})
    hooks := [Setting]{Setting{name: "JET_FRONT_LIBRARY_OBJECT_OUTPUT", value: base.copy()}, Setting{name: "JET_FRONT_LIBRARY_LIFECYCLE", value: list.copy()}}
    if options.exports != "" -> hooks.push(Setting{name: "JET_FRONT_LIBRARY_EXPORTS", value: absolute(options.exports)})
    record: front(jet, [String]{"doc", source}, files.dirname(source), hooks, options, base)
    outcome(record, library_problem(record, base), "")
}

library_problem: fn(record: Dyn, prefix: String) -[FS]> String? Never! {
    failed: command_problem(record)
    if files.exists("{prefix}.issues") -> return Val(files.read("{prefix}.issues") ?? "`{prefix}.issues` cannot be read: {err}")
    if failed != None -> return failed
    loop suffix in LIBRARY_ARTIFACTS {
        if !files.exists("{prefix}{suffix}") -> return Val("native library hook omitted {suffix}")
    }
    None
}

program: fn(jet: String, file: String, root: String, prefix: String, options: Options) -[Env, Exec, FS, IO, Time, Time.Wait]> String Never! {
    source: absolute(file)
    home: absolute(root)
    base: absolute(prefix)
    manifest: "{home}/package.jet"
    if !files.exists(manifest) -> files.write(manifest, TRANSPORT_PACKAGE) ?? return fail("`{manifest}` cannot be written: {err}")
    built: "{home}/.jet/build/{files.basename(source).removesuffix(".jet")}"
    remove_stale([String]{built, "{base}.exe", "{base}.issues", "{base}.pack-issues"})
    record: front(jet, [String]{"build", source}, home, [Setting]{}, options, base)
    if command_problem(record) == .Val(detail) -> return outcome(record, Val(detail), "")
    if !files.exists(built) -> return outcome(record, Val("native build did not emit a fresh executable"), "")
    files.copy(built, "{base}.exe") ?? return fail("`{base}.exe` cannot be written: {err}")
    files.set_mode("{base}.exe", 0o755) ?? return fail("`{base}.exe` cannot be made executable: {err}")
    outcome(record, None, "{base}.exe")
}

copy_tree: fn(from: String, to: String) -[Exec, FS, IO]> () {
    files.create_dir_all(to) ?? return fail("`{to}` cannot be created: {err}")
    listed: files.list_dir(from) ?? return fail("`{from}` cannot be listed: {err}")
    loop entry in listed {
        source: "{from}/{entry.name}"
        meta: files.stat(source, .Follow) ?? return fail("`{source}` cannot be read: {err}")
        if meta.is_dir {
            copy_tree(source, "{to}/{entry.name}")
            next
        }
        files.copy(source, "{to}/{entry.name}") ?? return fail("`{source}` cannot be copied: {err}")
        files.set_mode("{to}/{entry.name}", meta.mode % 4096) ?? return fail("`{to}/{entry.name}` mode: {err}")
    }
}

digest: fn(path: String) -[FS]> String Never! {
    crypto.sha256(files.read_bytes(path) ?? return "").hex()
}

// The production CLI resolves its runtime beside its executable: stage the
// given jet and the runtime directory holding PACK's key directory exactly,
// never a previously installed runtime.
stage: fn(jet: String, pack: String, out: String) -[Env, Exec, FS, IO]> String Never! {
    binary: absolute(jet)
    packed: absolute(pack)
    home: absolute(out)
    staged: "{home}/jet"
    staged_pack: "{home}/jet-runtime/{files.basename(files.dirname(packed))}/jet_runtime.pack.o"
    unchanged: !files.exists(home) || (files.exists(staged) && files.exists(staged_pack) && digest(staged) == digest(binary) && digest(staged_pack) == digest(packed))
    if !unchanged -> return fail("staged transport toolchain changed")
    if !files.exists(home) -> stage_fresh(binary, packed, home)
    json.dumps(Dyn.Object([String: Dyn]{"jet": Dyn.Text(staged)})) ?? "{{}}"
}

stage_fresh: fn(binary: String, packed: String, home: String) -[Exec, FS, IO]> () {
    staged: "{home}/jet"
    files.create_dir_all(home) ?? return fail("`{home}` cannot be created: {err}")
    files.copy(binary, staged) ?? return fail("`{binary}` cannot be staged: {err}")
    files.set_mode(staged, 0o755) ?? return fail("`{staged}` cannot be made executable: {err}")
    copy_tree(files.dirname(files.dirname(packed)), "{home}/jet-runtime")
}

#Test("a toolchain is staged once and then confirmed unchanged") {
    dir: files.mkdtemp("native-transport-stage") ?? panic("a temporary directory cannot be made: {err}")
    jet: completion_only(dir)
    pack: "{dir}/runtime/key/jet_runtime.pack.o"
    files.create_dir_all(files.dirname(pack)) ?? panic("{pack}: {err}")
    files.write(pack, "pack") ?? panic("{pack}: {err}")
    files.write("{dir}/runtime/native.key", "key") ?? panic("{dir}: {err}")
    out: "{dir}/toolchain"
    first: json.parse(stage(jet, pack, out)) ?? panic("stage output: {err}")
    assert_eq(text_field(first, "jet"), "{out}/jet")
    assert_eq(files.read("{out}/jet-runtime/key/jet_runtime.pack.o") ?? "", "pack")
    assert_eq(files.read("{out}/jet-runtime/native.key") ?? "", "key")
    assert_eq(stage(jet, pack, out), json.dumps(first) ?? "-")
    files.remove_all(dir) ?? panic("{dir}: {err}")
}

#Test("a native command counts only a zero exit without a spawn error") {
    ok: Dyn.Object([String: Dyn]{"status": Dyn.Int(0), "signal": Dyn.Null, "error": Dyn.Null, "stderr": Dyn.Text("")})
    assert_eq(command_problem(ok), None)
    failed: Dyn.Object([String: Dyn]{"status": Dyn.Int(1), "signal": Dyn.Null, "error": Dyn.Null, "stderr": Dyn.Text("boom")})
    assert_eq(command_problem(failed), Val("native Jet exit 1: boom"))
    killed: Dyn.Object([String: Dyn]{"status": Dyn.Null, "signal": Dyn.Int(9), "error": Dyn.Null, "stderr": Dyn.Text("")})
    assert_eq(command_problem(killed), Val("native Jet exit 9: "))
    refused: Dyn.Object([String: Dyn]{"status": Dyn.Null, "signal": Dyn.Null, "error": Dyn.Text("spawn refused"), "stderr": Dyn.Text("")})
    assert_eq(command_problem(refused), Val("native Jet exit null: spawn refused"))
}

#Test("the transport environment drops bootstrap and front-end hooks only") {
    assert(strips_transport("JET_BOOTSTRAP_MODE"))
    assert(strips_transport("JET_FRONT_LIBRARY_OBJECT_OUTPUT"))
    assert(!strips_transport("JET_TOOLCHAIN_ROOT"))
    assert(!strips_transport("JET_RUNTIME_PACK"))
    assert_eq(setting("JET_STORE_DIR=/a=b").map(found -> "{found.name}|{found.value}"), Val("JET_STORE_DIR|/a=b"))
    assert_eq(setting("=x").map(found -> found.name), None)
    assert_eq(setting("NAME").map(found -> found.name), None)
}

// A stand-in jet that completes without writing any artifact.
completion_only: fn(dir: String) -[FS]> String Never! {
    path: "{dir}/jet"
    files.write(path, "#!/bin/sh\necho command completed\n") ?? panic("{path}: {err}")
    files.set_mode(path, 0o755) ?? panic("{path}: {err}")
    path
}

test_options: fn() -> Options Never! {
    Options{positional: [String]{}, exports: "", settings: [Setting]{Setting{name: "JET_BOOTSTRAP_MODE", value: "factory"}}, timeout_ms: 60000}
}

#Test("a library runs doc FILE and refuses completion without fresh artifacts") {
    dir: files.mkdtemp("native-transport-library") ?? panic("a temporary directory cannot be made: {err}")
    jet: completion_only(dir)
    file: "{dir}/unit.jet"
    prefix: "{dir}/fixture"
    lifecycle: "{dir}/lifecycle.list"
    files.write(file, "run: fn() {{}}\n") ?? panic("{file}: {err}")
    files.write(lifecycle, "explicit lifecycle fixture\n") ?? panic("{lifecycle}: {err}")
    loop suffix in ([String]{".o", ".exports", ".abi.json", ".threads", ".issues"}) -> files.write("{prefix}{suffix}", "stale artifact") ?? panic("{prefix}{suffix}: {err}")
    printed: json.parse(library(jet, file, prefix, lifecycle, test_options())) ?? panic("library output: {err}")
    assert_eq(text_field(field(printed, "problem"), "detail"), "native library hook omitted .o")
    assert_eq(json.dumps(field(field(printed, "run"), "status")) ?? "", "0")
    assert_eq(files.read(lifecycle) ?? "", "explicit lifecycle fixture\n")
    loop suffix in ([String]{".o", ".exports", ".abi.json", ".threads", ".issues"}) -> assert(!files.exists("{prefix}{suffix}"))
    record: json.parse(files.read("{prefix}.front.run.json") ?? "") ?? panic("run record: {err}")
    assert_eq(json.dumps(field(record, "args")) ?? "", json.dumps(texts([String]{"doc", file})) ?? "-")
    assert_eq(text_field(record, "stdout"), "command completed\n")
    files.remove_all(dir) ?? panic("{dir}: {err}")
}

#Test("a program build that completes without an executable is no native feed") {
    dir: files.mkdtemp("native-transport-program") ?? panic("a temporary directory cannot be made: {err}")
    jet: completion_only(dir)
    file: "{dir}/unit.jet"
    prefix: "{dir}/case"
    files.write(file, "run: fn() {{}}\n") ?? panic("{file}: {err}")
    files.write("{prefix}.exe", "stale executable") ?? panic("{prefix}.exe: {err}")
    printed: json.parse(program(jet, file, dir, prefix, test_options())) ?? panic("program output: {err}")
    assert_eq(text_field(field(printed, "problem"), "detail"), "native build did not emit a fresh executable")
    assert(!files.exists("{prefix}.exe"))
    assert_eq(files.read("{dir}/package.jet") ?? "", TRANSPORT_PACKAGE)
    assert_eq(text_field(field(printed, "run"), "cwd"), dir)
    files.remove_all(dir) ?? panic("{dir}: {err}")
}
