#!/usr/bin/env jet
// Classify every diagnostic code into tests/diagnostics_census.tsv, one row
// per typed row of Compiler/Prelude/Diagnostics.jet and per emitted code with
// no row:
// - status: the row's `status` (active, retired, reserved), or `unregistered`;
// - emission: `compiler` when a compiler stage source emits the code (parse,
//   sema, comptime, lowering: any Compiler/ package TOOL_ROOTS does not
//   name), `tool` when only a tool, the runtime, Jetpack or Core emits it,
//   else `dead`;
// - carriage: where a rendered output shows the code, the first of `ui` (a
//   tests/ui or tests/ui_lint snapshot), `fixture` (a report fixture under
//   tests/fixtures/*-diagnostics, or a `.txt` report under tests/cli or
//   tests/release), `case` (a tests/cases case or its stderr, stdout or
//   `.warn` file), else `none`.
// A source emits a code by writing it alone between quotes or brackets
// (`"E3413"`, `[E0001]`), by opening its message text with it
// (`"E2416: invalid .env line"`), or by writing a report header with the
// row's type path (`[jet.MissingEngine]`). The scan covers every `.jet` file
// under Compiler/, Jetpack/ and Core/ except test packages, fixtures, dot
// directories and the registry's own files. rustc's codes (RUSTC_CODES) are
// never a Jet emission: a source names them only to classify or set aside
// cargo output, and the i2 test of tests/guards/diagnostics_coverage.jet
// keeps them out of every raise site and report.
// A rendered output carries a code as a report opener or bracket (`[E0749]`,
// `[jet.FetchHashMismatch]`), a quoted code, or its `jet-lang.dev/e/` link;
// a case carries it that way on any line that is not a `#` comment.
//
// The gate. A row is a gap when it is:
// - `dead`: active, and nothing emits it;
// - `uncarried`: active and emitted, and no rendered output shows it;
// - `no-ui`: active, a compiler stage emits it, and no ui snapshot shows it
//   (a compiler diagnostic needs its ui snapshot; a fixture or case covers
//   only a code tools, the runtime, Jetpack or Core emit);
// - `unregistered`: emitted with no typed row;
// - `emitted`: retired or reserved, which blocks the code's reuse, yet a
//   source still emits it.
// tests/diagnostics_census_baseline.tsv admits today's gaps, each with the
// card that owns it, and only shrinks.
// --check fails when the census differs from what the tree gives it, when a
// gap is not in the baseline, when a baseline row is no longer a gap, and
// when the baseline lists a row that HEAD's copy does not.
// --write rewrites the census, drops every baseline row that is no longer a
// gap, and then applies the same gate; it never adds a baseline row.
// Usage: jet Tools/agent/DiagnosticCensus.jet [--check|--write]
use {
    files: core.files
    process: core.process
}

CENSUS_PATH: "tests/diagnostics_census.tsv"
BASELINE_PATH: "tests/diagnostics_census_baseline.tsv"
SOURCE_PATH: "Compiler/Prelude/Diagnostics.jet"
// The registry lists every code by construction; it is not an emission site.
REGISTRY_FILES: [String]{"Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet", "Compiler/Prelude/Diagnostics.jet"}
EMIT_ROOTS: [String]{"Compiler", "Jetpack", "Core"}
RUSTC_CODES: [String]{"E0061", "E0277", "E0425"}
// The emitters that are not a compiler stage: the package manager, Core, the
// runtime, and the compiler's tool and command packages.
TOOL_ROOTS: [String]{"Jetpack/", "Core/", "Compiler/JetRuntime/", "Compiler/JetCli/", "Compiler/JetBuildSession/", "Compiler/JetCanvas/", "Compiler/JetDebug/", "Compiler/JetDevserver/", "Compiler/JetImpact/", "Compiler/JetLSP/", "Compiler/JetRepl/", "Compiler/JetSemIndex/", "Compiler/JetTestKit/", "Compiler/Toolchain/"}
UI_ROOTS: [String]{"tests/ui", "tests/ui_lint"}
FIXTURE_ROOTS: [String]{"tests/fixtures/cli-diagnostics", "tests/fixtures/jetpack-diagnostics", "tests/fixtures/module-eval-diagnostics"}
// Directories whose `.txt` files are rendered CLI and tool reports.
REPORT_ROOTS: [String]{"tests/cli", "tests/release"}
CASE_ROOTS: [String]{"tests/cases"}
GENERATED_BY: "# Generated by Tools/agent/DiagnosticCensus.jet; do not edit."
COLUMNS: "# code\ttype\tstatus\temission\tcarriage"
BASELINE_HEADER: "# The gaps tests/diagnostics_census.tsv shows that Tools/agent/DiagnosticCensus.jet\n# --check still admits, each with the card that owns it. The list only\n# shrinks: --write drops a row once it is no longer a gap, and --check\n# refuses a row HEAD's copy lacks.\n# code\ttype\tgap\towner"

#Error
DiagnosticCensusError: struct {
    message: String
}

census_fail: fn(message: String) -> DiagnosticCensusError Never! {
    DiagnosticCensusError{message: "diagnostic census: {message}"}
}

CensusRow: struct {
    code: String
    // The row's type path (`jet.FetchHashMismatch`), `-` for an unregistered code.
    name: String
    status: String
    // `compiler`, `tool` or `dead`.
    emitter: String
    carriage: String
}

// The codes and type paths a set of files shows.
CensusTokens: struct {
    codes: [String]
    names: [String]
}

// What the rendered outputs show, by carriage.
CensusCarriers: struct {
    ui: CensusTokens
    fixture: CensusTokens
    cases: CensusTokens
}

// A gap the baseline admits, and the card that owns it.
BaselineRow: struct {
    code: String
    name: String
    gap: String
    owner: String
}

census_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    if start >= end -> return ""
    String.from_bytes(text.bytes()[start..(end - 1)]) ?? panic("a census slice must end on UTF-8 boundaries")
}

census_add: fn(values: &[String], value: String) Never! {
    // copy: `value` is a view into the scanned text.
    if !values.contains(value) -> values.push(value.copy())
}

census_digits: fn(bytes: [U8], from: Int) -> Bool Never! {
    bytes.len() > from && bytes.slice(from, bytes.len()).all(fn(byte) { byte >= (U8{48}) && byte <= (U8{57}) })
}

// A letter code (`E0001`, `L0516`, `W0410`, `R0801`, `JT0001`) or a
// word-shaped code (`E-WEB-RUN`).
census_is_code: fn(code: String) -> Bool Never! {
    bytes: code.bytes()
    if bytes.len() == 5 && (code.starts_with("E") || code.starts_with("L") || code.starts_with("W") || code.starts_with("R")) -> return census_digits(bytes, 1)
    if bytes.len() == 6 && code.starts_with("JT") -> return census_digits(bytes, 2)
    if !code.starts_with("E-") && !code.starts_with("L-") -> return false
    words: census_slice(code, 2, bytes.len()).split("-").to_list()
    words.len() >= 2 && words.all(fn(word) { word != "" && word.bytes().all(fn(byte) { (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{48}) && byte <= (U8{57})) }) })
}

census_code_byte: fn(byte: U8) -> Bool Never! {
    (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{48}) && byte <= (U8{57})) || byte == (U8{45})
}

// The codes `text` writes alone between quotes or brackets, or quoted and
// followed by `: `.
census_quoted_codes: fn(text: String, codes: &[String]) Never! {
    bytes: text.bytes()
    loop (index, byte) in bytes {
        if byte != (U8{34}) && byte != (U8{91}) -> next
        close: if byte == (U8{34}) -> U8{34} else -> U8{93}
        end := index + 1
        loop end < bytes.len() && census_code_byte(bytes[end]) -> end += 1
        coded_text: byte == (U8{34}) && end + 1 < bytes.len() && bytes[end] == (U8{58}) && bytes[end + 1] == (U8{32})
        if end > index + 1 && end < bytes.len() && (bytes[end] == close || coded_text) {
            code: census_slice(text, index + 1, end)
            if census_is_code(code) -> census_add(codes, code)
        }
    }
}

// The type paths `text` writes between brackets (`[jet.MissingEngine]`).
census_type_paths: fn(text: String, names: &[String]) Never! {
    bytes: text.bytes()
    loop (index, byte) in bytes {
        if byte != (U8{91}) -> next
        end := index + 1
        loop end < bytes.len() && (census_code_byte(bytes[end]) || (bytes[end] >= (U8{97}) && bytes[end] <= (U8{122})) || bytes[end] == (U8{46})) -> end += 1
        if end < bytes.len() && bytes[end] == (U8{93}) {
            name: census_slice(text, index + 1, end)
            if name.starts_with("jet.") -> census_add(names, name)
        }
    }
}

// The codes `text` links as `jet-lang.dev/e/<CODE>`.
census_linked_codes: fn(text: String, codes: &[String]) Never! {
    bytes: text.bytes()
    loop (index, byte) in bytes {
        if byte != (U8{47}) || index + 3 >= bytes.len() || bytes[index + 1] != (U8{101}) || bytes[index + 2] != (U8{47}) -> next
        end := index + 3
        loop end < bytes.len() && census_code_byte(bytes[end]) -> end += 1
        code: census_slice(text, index + 3, end)
        if census_is_code(code) -> census_add(codes, code)
    }
}

// The typed rows: each `X: struct {` whose `impl Diagnostic` block names its
// `code` and, unless it is active, its `status` is the type `jet.X`.
census_registered_rows: fn(text: String) -> [CensusRow] DiagnosticCensusError! {
    rows := [CensusRow]{}
    name := ""
    code := ""
    status := ""
    loop line in text.split("\n") {
        if {
            !line.starts_with(" ") && line.ends_with(": struct {{") -> name = "jet.{census_slice(line, 0, line.count_bytes() - 10)}"
            line == "    impl Diagnostic {{" -> {
                code = ""
                status = "active"
            }
            line.starts_with("        code: \"") && line.ends_with("\"") -> code = census_slice(line, 15, line.count_bytes() - 1)
            line.starts_with("        status: .") -> status = census_slice(line, 17, line.count_bytes()).lower()
            line == "    }}" && status != "" -> {
                if code == "" -> return Err(census_fail("{name} has an `impl Diagnostic` without a code"))
                // copy: the scan's `code`, `name` and `status` move on to the next row.
                rows.push(CensusRow{code: code.copy(), name: name.copy(), status: status.copy(), emitter: "dead", carriage: "none"})
                status = ""
            }
        }
    }
    if rows.len() < 100 -> return Err(census_fail("{SOURCE_PATH} holds {rows.len()} typed rows; it must be readable"))
    Ok(rows)
}

// Which files a walk keeps: a compiler source, a rendered snapshot or case,
// or a rendered report text.
CensusFiles: enum {
    Sources
    Snapshots
    Reports
}

census_keeps: fn(kind: CensusFiles, path: String) -> Bool Never! {
    if kind == {
        .Sources -> path.ends_with(".jet") && !REGISTRY_FILES.contains(path)
        .Snapshots -> path.ends_with("/stderr") || path.ends_with("/stdout") || path.ends_with(".stderr") || path.ends_with(".stdout") || path.ends_with(".warn") || path.ends_with(".case")
        .Reports -> path.ends_with(".txt")
    }
}

// Every file under `directory` that `kind` keeps, skipping dot directories
// and any directory `skip` names.
census_walk: fn(directory: String, skip: [String], kind: CensusFiles, out: &[String]) -[FS]> () DiagnosticCensusError! {
    if !files.exists(directory) -> return Ok()
    entries: files.list_dir(directory) ?? return Err(census_fail("cannot list {directory}: {err}"))
    loop child in entries {
        if child.name.starts_with(".") -> next
        if {
            child.is_dir -> {
                if !skip.contains(child.name) -> census_walk(child.path, skip, kind, out) ?? return Err(err)
            }
            // copy: the paths outlive the directory listing.
            census_keeps(kind, child.path) -> out.push(child.path.copy())
        }
    }
    Ok()
}

census_read: fn(path: String) -[FS]> String DiagnosticCensusError! {
    files.read(path) ?? return Err(census_fail("cannot read {path}: {err}"))
}

// What the compiler stages, and apart from them the tools, runtime, Jetpack
// and Core, emit.
CensusEmitters: struct {
    compiler: CensusTokens
    tool: CensusTokens
}

census_tool_source: fn(path: String) -> Bool Never! {
    TOOL_ROOTS.any(fn(root) { path.starts_with(root) })
}

census_rustc_code: fn(code: String) -> Bool Never! {
    RUSTC_CODES.contains(code)
}

// The codes and type paths the compiler, package manager and Core sources emit.
census_emitted: fn() -[FS]> CensusEmitters DiagnosticCensusError! {
    paths := [String]{}
    loop root in EMIT_ROOTS -> census_walk(root, [String]{"Tests", "Fixtures", "fixtures"}, .Sources, paths) ?? return Err(err)
    emitters := CensusEmitters{compiler: CensusTokens{codes: [String]{}, names: [String]{}}, tool: CensusTokens{codes: [String]{}, names: [String]{}}}
    loop path in paths {
        text: census_read(path) ?? return Err(err)
        if {
            census_tool_source(path) -> {
                census_quoted_codes(text, emitters.tool.codes)
                census_type_paths(text, emitters.tool.names)
            }
            else -> {
                census_quoted_codes(text, emitters.compiler.codes)
                census_type_paths(text, emitters.compiler.names)
            }
        }
    }
    emitters.compiler.codes = emitters.compiler.codes.filter(fn(code) { !census_rustc_code(code) })
    emitters.tool.codes = emitters.tool.codes.filter(fn(code) { !census_rustc_code(code) })
    Ok(emitters)
}

// What one rendered output shows: its codes, links and type paths. A case
// shows them on its lines that are not `#` comments.
census_carried_text: fn(path: String, text: String, tokens: &CensusTokens) Never! {
    if !path.ends_with(".case") {
        census_quoted_codes(text, tokens.codes)
        census_linked_codes(text, tokens.codes)
        census_type_paths(text, tokens.names)
        return
    }
    kept := [String]{}
    loop line in text.split("\n") {
        // copy: the kept lines outlive the split of `text`.
        if !line.trim().starts_with("#") -> kept.push(line.copy())
    }
    shown: kept.join("\n")
    census_quoted_codes(shown, tokens.codes)
    census_linked_codes(shown, tokens.codes)
    census_type_paths(shown, tokens.names)
}

// What the rendered outputs of the files under `roots` that `kind` keeps show.
census_tokens: fn(roots: [String], kind: CensusFiles) -[FS]> CensusTokens DiagnosticCensusError! {
    paths := [String]{}
    loop root in roots -> census_walk(root, [String]{}, kind, paths) ?? return Err(err)
    tokens := CensusTokens{codes: [String]{}, names: [String]{}}
    loop path in paths {
        text: census_read(path) ?? return Err(err)
        census_carried_text(path, text, tokens)
    }
    Ok(tokens)
}

census_carriers: fn() -[FS]> CensusCarriers DiagnosticCensusError! {
    ui: census_tokens(UI_ROOTS, .Snapshots) ?? return Err(err)
    fixture := census_tokens(FIXTURE_ROOTS, .Snapshots) ?? return Err(err)
    reports: census_tokens(REPORT_ROOTS, .Reports) ?? return Err(err)
    loop code in reports.codes -> census_add(fixture.codes, code)
    loop name in reports.names -> census_add(fixture.names, name)
    cases: census_tokens(CASE_ROOTS, .Snapshots) ?? return Err(err)
    Ok(CensusCarriers{ui: ui, fixture: fixture, cases: cases})
}

census_shows: fn(tokens: CensusTokens, row: CensusRow) -> Bool Never! {
    tokens.codes.contains(row.code) || tokens.names.contains(row.name)
}

census_carriage: fn(carriers: CensusCarriers, row: CensusRow) -> String Never! {
    if {
        census_shows(carriers.ui, row) -> "ui"
        census_shows(carriers.fixture, row) -> "fixture"
        census_shows(carriers.cases, row) -> "case"
        else -> "none"
    }
}

// The census of the typed rows `registry` holds, given what the sources emit
// and what the rendered outputs carry, sorted by code, then type path.
census_rows: fn(registry: String, emitters: CensusEmitters, carriers: CensusCarriers) -> [CensusRow] DiagnosticCensusError! {
    rows := census_registered_rows(registry) ?? return Err(err)
    known := [String]{}
    loop row in rows -> census_add(known, row.code)
    loop codes in ([[String]]{emitters.compiler.codes, emitters.tool.codes}) {
        loop code in codes {
            if !known.contains(code) {
                // copy: the row and `known` each keep the code.
                rows.push(CensusRow{code: code.copy(), name: "-", status: "unregistered", emitter: "dead", carriage: "none"})
                known.push(code.copy())
            }
        }
    }
    loop at in 0..<rows.len() {
        emitter: if {
            census_shows(emitters.compiler, rows[at]) -> "compiler"
            census_shows(emitters.tool, rows[at]) -> "tool"
            else -> "dead"
        }
        carriage: census_carriage(carriers, rows[at])
        rows[at].emitter = emitter
        rows[at].carriage = carriage
    }
    rows.sort_by(fn(left: CensusRow, right: CensusRow) {
        if left.code != right.code -> return if left.code < right.code -> Ordering.Less else -> Ordering.Greater
        if left.name < right.name -> return Ordering.Less
        if left.name > right.name -> return Ordering.Greater
        Ordering.Equal
    })
    Ok(rows)
}

census_line: fn(row: CensusRow) -> String Never! {
    "{row.code}\t{row.name}\t{row.status}\t{row.emitter}\t{row.carriage}"
}

census_render: fn(rows: [CensusRow]) -> String Never! {
    // copy: the rendered lines own their text.
    lines := [String]{GENERATED_BY.copy(), COLUMNS.copy()}
    loop row in rows -> lines.push(census_line(row))
    "{lines.join("\n")}\n"
}

// The tab-separated rows of `text` with `width` columns, skipping blank and
// `#` lines.
census_columns: fn(path: String, text: String, width: Int) -> [[String]] DiagnosticCensusError! {
    rows := [[String]]{}
    loop (index, line) in text.lines() {
        if line == "" || line.starts_with("#") -> next
        columns: line.split("\t").to_list()
        if columns.len() != width -> return Err(census_fail("{path}:{index + 1} has {columns.len()} columns, not {width}"))
        // copy: the rows outlive the split of `text`.
        rows.push(columns.map(fn(column) { column.copy() }))
    }
    Ok(rows)
}

census_parse: fn(text: String) -> [CensusRow] DiagnosticCensusError! {
    rows := [CensusRow]{}
    loop columns in census_columns(CENSUS_PATH, text, 5) ?? return Err(err) {
        rows.push(CensusRow{code: columns[0], name: columns[1], status: columns[2], emitter: columns[3], carriage: columns[4]})
    }
    Ok(rows)
}

// The gap a row is (see the file comment), else "".
census_gap: fn(row: CensusRow) -> String Never! {
    if {
        row.status == "unregistered" -> "unregistered"
        row.status != "active" -> if row.emitter == "dead" -> "" else -> "emitted"
        row.emitter == "dead" -> "dead"
        row.carriage == "none" -> "uncarried"
        row.emitter == "compiler" && row.carriage != "ui" -> "no-ui"
        else -> ""
    }
}

baseline_parse: fn(text: String) -> [BaselineRow] DiagnosticCensusError! {
    rows := [BaselineRow]{}
    loop columns in census_columns(BASELINE_PATH, text, 4) ?? return Err(err) {
        rows.push(BaselineRow{code: columns[0], name: columns[1], gap: columns[2], owner: columns[3]})
    }
    Ok(rows)
}

baseline_render: fn(rows: [BaselineRow]) -> String Never! {
    // copy: the rendered lines own their text.
    lines := [String]{BASELINE_HEADER.copy()}
    loop row in rows -> lines.push("{row.code}\t{row.name}\t{row.gap}\t{row.owner}")
    "{lines.join("\n")}\n"
}

baseline_admits: fn(baseline: [BaselineRow], code: String, name: String, gap: String) -> Bool Never! {
    baseline.any(fn(row) { row.code == code && row.name == name && row.gap == gap })
}

// Whether `rows` still shows `entry`'s code with `entry`'s gap.
baseline_open: fn(rows: [CensusRow], entry: BaselineRow) -> Bool Never! {
    loop row in rows {
        if row.code == entry.code && row.name == entry.name && census_gap(row) == entry.gap -> return true
    }
    false
}

// The baseline rows that are still gaps in `rows`.
baseline_shrunk: fn(baseline: [BaselineRow], rows: [CensusRow]) -> [BaselineRow] Never! {
    kept := [BaselineRow]{}
    loop entry in baseline {
        if baseline_open(rows, entry) -> kept.push(BaselineRow{code: "{entry.code}", name: "{entry.name}", gap: "{entry.gap}", owner: "{entry.owner}"})
    }
    kept
}

// Every way `rows` and `baseline` break the gate, one line each. `before` is
// HEAD's baseline, when HEAD has one.
census_gate: fn(rows: [CensusRow], baseline: [BaselineRow], before: [BaselineRow]?) -> [String] Never! {
    problems := [String]{}
    loop row in rows {
        gap: census_gap(row)
        if gap == "" || baseline_admits(baseline, row.code, row.name, gap) -> next
        if {
            gap == "dead" -> problems.push("{row.code} ({row.name}) is active but nothing emits it: remove the row, or emit it")
            gap == "uncarried" -> problems.push("{row.code} ({row.name}) is emitted but no ui snapshot, report fixture or case shows it: add one")
            gap == "no-ui" -> problems.push("{row.code} ({row.name}) is a compiler diagnostic that no ui snapshot shows: add one under tests/ui")
            gap == "unregistered" -> problems.push("{row.code} is emitted without a typed row in {SOURCE_PATH}: register it, or stop emitting it")
            else -> problems.push("{row.code} ({row.name}) is {row.status} but a source still emits it: stop emitting it, or make the row active")
        }
    }
    loop entry in baseline {
        if !baseline_open(rows, entry) -> problems.push("{entry.code} ({entry.name}) is no longer {entry.gap}: run --write to drop it from {BASELINE_PATH}")
    }
    if before == .Val(head) {
        loop entry in baseline {
            if !baseline_admits(head, entry.code, entry.name, entry.gap) -> problems.push("{entry.code} ({entry.name}) is new in {BASELINE_PATH}, which only shrinks: emit and carry the code instead")
        }
    }
    problems
}

// The rows that differ between two censuses, at most `limit`.
census_changed: fn(current: [CensusRow], proposed: [CensusRow], limit: Int) -> [String] Never! {
    old := [String]{}
    loop row in current -> old.push(census_line(row))
    fresh := [String]{}
    loop row in proposed -> fresh.push(census_line(row))
    changed := [String]{}
    loop line in fresh {
        if !old.contains(line) && changed.len() < limit -> changed.push("+ {line}")
    }
    loop line in old {
        if !fresh.contains(line) && changed.len() < limit -> changed.push("- {line}")
    }
    changed
}

census_summary: fn(rows: [CensusRow]) -> String Never! {
    active := 0
    ui := 0
    gaps := [String]{"dead", "uncarried", "no-ui", "unregistered", "emitted"}
    counts := [Int]{0, 0, 0, 0, 0}
    loop row in rows {
        if row.status == "active" -> active += 1
        if row.status == "active" && row.carriage == "ui" -> ui += 1
        gap: census_gap(row)
        loop at in 0..<gaps.len() {
            if gaps[at] == gap -> counts[at] = counts[at] + 1
        }
    }
    shown := [String]{}
    loop at in 0..<gaps.len() -> shown.push("{counts[at]} {gaps[at]}")
    "{rows.len()} rows, {active} active, {ui} active in ui snapshots; gaps: {shown.join(", ")}"
}

// HEAD's baseline text, or None outside a checkout or before HEAD has one.
baseline_head_text: fn() -[Exec, Time.Wait]> String? Never! {
    receipt: process.cmd([String]{"git", "show", "HEAD:{BASELINE_PATH}"}).stdout(.Capture).stderr(.Capture).run() ?? return None
    if receipt.code != 0 -> return None
    // copy: the text outlives the receipt.
    Val(receipt.output.copy())
}

diagnostic_census_main: fn(args: [String]) -[Exec, FS, Time.Wait]> String DiagnosticCensusError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(census_fail("usage: jet Tools/agent/DiagnosticCensus.jet [--check|--write]"))
    registry: census_read(SOURCE_PATH) ?? return Err(err)
    emitters: census_emitted() ?? return Err(err)
    carriers: census_carriers() ?? return Err(err)
    rows: census_rows(registry, emitters, carriers) ?? return Err(err)
    generated: census_render(rows)
    current_text: files.read(CENSUS_PATH) ?? ""
    baseline_text: files.read(BASELINE_PATH) ?? ""
    baseline := baseline_parse(baseline_text) ?? return Err(err)
    before := [BaselineRow]?{None}
    if baseline_head_text() == .Val(head_text) -> before = Val(baseline_parse(head_text) ?? return Err(err))
    if {
        mode == "--write" -> {
            if current_text != generated -> files.write(CENSUS_PATH, generated) ?? return Err(census_fail("cannot write {CENSUS_PATH}: {err}"))
            baseline = baseline_shrunk(baseline, rows)
            shrunk: baseline_render(baseline)
            if shrunk != baseline_text -> files.write(BASELINE_PATH, shrunk) ?? return Err(census_fail("cannot write {BASELINE_PATH}: {err}"))
        }
        current_text != generated -> {
            current: census_parse(current_text) ?? return Err(err)
            changed: census_changed(current, rows, 40)
            return Err(census_fail("{CENSUS_PATH} differs from the tree:\n{changed.join("\n")}\nrun jet Tools/agent/DiagnosticCensus.jet --write"))
        }
    }
    problems: census_gate(rows, baseline, before)
    if problems.len() > 0 -> return Err(census_fail("every gap needs a row in {BASELINE_PATH}, which only shrinks:\n{problems.join("\n")}"))
    Ok("diagnostic census {if mode == "--write" -> "written" else -> "check passed"}: {census_summary(rows)}")
}

run: fn() { print(diagnostic_census_main(process.args()) ?? process.fail(1, err.message)) }

// A test row of type `jet.T<code>`.
census_test_row: fn(code: String, status: String, emitter: String, carriage: String) -> CensusRow Never! {
    CensusRow{code: "{code}", name: "jet.T{code}", status: "{status}", emitter: "{emitter}", carriage: "{carriage}"}
}

census_test_entry: fn(code: String, gap: String) -> BaselineRow Never! {
    BaselineRow{code: "{code}", name: "jet.T{code}", gap: "{gap}", owner: "#1"}
}

#Test("the census reads emitted codes, links and type paths, and nothing else") {
    tokens := CensusTokens{codes: [String]{}, names: [String]{}}
    census_quoted_codes("fail(\"E3413\", x) [E0001] \"E2416: bad line\" \"E9\" [EOF] \"E2417 later\"", tokens.codes)
    assert_eq(tokens.codes, [String]{"E3413", "E0001", "E2416"})
    census_linked_codes("More: jet-lang.dev/e/E0749\nsee /e/nothing", tokens.codes)
    assert_eq(tokens.codes, [String]{"E3413", "E0001", "E2416", "E0749"})
    census_type_paths("Error [jet.FetchHashMismatch]: x [Other.Name] [jet.Lint]", tokens.names)
    assert_eq(tokens.names, [String]{"jet.FetchHashMismatch", "jet.Lint"})
    case_tokens := CensusTokens{codes: [String]{}, names: [String]{}}
    census_carried_text("t/a.case", "# \"E0001\" in a comment\nstderr: ~ \"E0749\" # the denial\n", case_tokens)
    assert_eq(case_tokens.codes, [String]{"E0749"})
    assert(census_is_code("E-WEB-RUN") && census_is_code("JT0001") && !census_is_code("E-WEB") && !census_is_code("E01"))
    assert(census_rustc_code("E0277") && !census_rustc_code("E0308"))
}

#Test("the census classifies rows by emitter and first carriage, names their gaps, and round-trips its rendering") {
    row_a: "A: struct {{\n    impl Diagnostic {{\n        code: \"E0001\"\n    }}\n}}\n"
    registry: "{row_a.repeat(100)}B: struct {{\n    impl Diagnostic {{\n        code: \"E0002\"\n        status: .Retired\n    }}\n}}\nC: struct {{\n    impl Diagnostic {{\n        code: \"E0003\"\n    }}\n}}\nD: struct {{\n    impl Diagnostic {{\n        code: \"E0004\"\n    }}\n}}\n"
    emitters: CensusEmitters{compiler: CensusTokens{codes: [String]{"E0003", "E0004"}, names: [String]{}}, tool: CensusTokens{codes: [String]{"E0009"}, names: [String]{"jet.B"}}}
    carriers: CensusCarriers{ui: CensusTokens{codes: [String]{"E0004"}, names: [String]{}}, fixture: CensusTokens{codes: [String]{"E0003"}, names: [String]{}}, cases: CensusTokens{codes: [String]{"E0001", "E0003"}, names: [String]{}}}
    rows: census_rows(registry, emitters, carriers) ?? panic(err.message)
    assert_eq(census_line(rows[0]), "E0001\tjet.A\tactive\tdead\tcase")
    assert_eq(census_line(rows[100]), "E0002\tjet.B\tretired\ttool\tnone")
    assert_eq(census_line(rows[101]), "E0003\tjet.C\tactive\tcompiler\tfixture")
    assert_eq(census_line(rows[102]), "E0004\tjet.D\tactive\tcompiler\tui")
    assert_eq(census_line(rows[103]), "E0009\t-\tunregistered\ttool\tnone")
    assert_eq([String]{census_gap(rows[0]), census_gap(rows[100]), census_gap(rows[101]), census_gap(rows[102]), census_gap(rows[103])}, [String]{"dead", "emitted", "no-ui", "", "unregistered"})
    assert_eq(census_gap(census_test_row("E0005", "active", "tool", "case")), "")
    assert_eq(census_gap(census_test_row("E0006", "active", "tool", "none")), "uncarried")
    assert(census_tool_source("Jetpack/Source/Fetch.jet") && census_tool_source("Compiler/JetRuntime/Source/Panic.jet") && !census_tool_source("Compiler/JetSema/Source/Check.jet"))
    assert_eq(census_render(census_parse(census_render(rows)) ?? panic(err.message)), census_render(rows))
}

#Test("the gate admits only baseline gaps, and the baseline only shrinks") {
    rows: [CensusRow]{census_test_row("E0001", "active", "tool", "ui"), census_test_row("E0002", "active", "dead", "none"), census_test_row("E0003", "active", "tool", "none"), census_test_row("E0004", "retired", "dead", "none")}
    baseline: [BaselineRow]{census_test_entry("E0002", "dead"), census_test_entry("E0003", "uncarried")}
    assert_eq(census_gate(rows, baseline, Val(baseline)), [String]{})
    assert_eq(census_gate(rows, [BaselineRow]{census_test_entry("E0002", "dead")}, None), [String]{"E0003 (jet.TE0003) is emitted but no ui snapshot, report fixture or case shows it: add one"})
    fixed: [CensusRow]{census_test_row("E0002", "active", "dead", "none"), census_test_row("E0003", "active", "tool", "case")}
    assert_eq(census_gate(fixed, baseline, None), [String]{"E0003 (jet.TE0003) is no longer uncarried: run --write to drop it from tests/diagnostics_census_baseline.tsv"})
    assert_eq(baseline_shrunk(baseline, fixed).len(), 1)
    grown: [BaselineRow]{census_test_entry("E0002", "dead"), census_test_entry("E0003", "uncarried")}
    assert_eq(census_gate(rows, grown, Val([BaselineRow]{census_test_entry("E0002", "dead")})), [String]{"E0003 (jet.TE0003) is new in tests/diagnostics_census_baseline.tsv, which only shrinks: emit and carry the code instead"})
    assert_eq(baseline_render(baseline_parse(baseline_render(baseline)) ?? panic(err.message)), baseline_render(baseline))
}

#Test("the committed census matches the tree, and the gate passes") {
    rows: census_rows(census_read(SOURCE_PATH) ?? panic(err.message), census_emitted() ?? panic(err.message), census_carriers() ?? panic(err.message)) ?? panic(err.message)
    assert_eq(files.read(CENSUS_PATH) ?? "", census_render(rows))
    assert_eq(census_gate(rows, baseline_parse(files.read(BASELINE_PATH) ?? "") ?? panic(err.message), None), [String]{})
}
