#!/usr/bin/env jet
// Render the diagnostic types of Compiler/Prelude/Diagnostics.jet, the one
// hand-written home of each diagnostic fact, into every copy built from it:
// the Foundation registry rows, the repair-coverage baseline
// (tests/diagnostics_coverage_baseline.txt), the snapshot-coverage allowlist
// (tests/diagnostics_coverage_allowlist.tsv, from the rows, the codes the
// sources name and the reports the snapshots render) and the explain pages
// (Docs/site/dist/e/<CODE>/index.html). Each type is a struct whose `String`
// fields come first and whose last member is its `impl Diagnostic` block; the
// block is read as source text: its constants are literals, and its what, why
// and fix bodies are one string literal each whose `{self.field}` holes the
// registry keeps as `{{field}}` placeholders.
// Both modes also read every `.jet` and `.S` file under Compiler/, Core/ and
// Jetpack/ (tests and fixtures aside): no hand-written file may build report
// text (a `Error [CODE]`-style heading or a `jet-lang.dev/e/` link), since
// every report renders from its row through Diagnostics/Render.jet, and each
// generated or assembly copy of a runtime report must match its row. They
// read every spec page under Docs/spec too: each `E####` or `L####` code a
// page cites must name a row (a retired or reserved row keeps an old code
// explainable). Every row's texts follow the plain-words rubric of
// Docs/spec/diagnostics.md: a Why gives a reason, not a placeholder, no
// meaning, What, Why or Fix names a decision ID, and an active row states a
// meaning of its own words, not its What again, and a Fix that is a step,
// not the placeholder. A row's code letter follows its severity: a lint
// takes an `L` code and no other row does. The codes registered before that
// law sit in LETTER_LAW_EXCEPTIONS, which may only shrink.
// Usage: jet Tools/agent/DiagnosticRows.jet [--check|--write]
// --check fails when any copy differs from what the rows give it; --write
// rewrites the copies and removes pages no row owns.
// The rows also give the dated safety audit under Docs/audits: each active
// error row's `safety_class`, its reason and its expert path, and the sealed
// floors with the first place the compiler reports each. Both modes refuse an
// active error row in SAFETY_RANGES that states no `safety_class`, and an
// active row whose code no source line reports unless UNREPORTED_CODES, which
// only shrinks, lists it.
use {
    files: core.files
    process: core.process
    time: core.time
}

SOURCE_PATH: "Compiler/Prelude/Diagnostics.jet"
ROWS_PATH: "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet"
GENERATED_BY: "// This file is generated by Tools/agent/DiagnosticRows.jet; do not edit."
BASELINE_PATH: "tests/diagnostics_coverage_baseline.txt"
BASELINE_HEADER: "# Generated by Tools/agent/DiagnosticRows.jet from Compiler/Prelude/Diagnostics.jet; do not edit.\n# One line per plane of active rows: plane, rows with a structured edit, rows with a no-fix reason, total.\n# A plane is a row's stage list joined with `/`. The generator refuses a change that leaves more rows with neither.\n"
PAGES_DIR: "Docs/site/dist/e"
PAGE_GENERATED_BY: "<!-- Generated by Tools/agent/DiagnosticRows.jet; do not edit. -->"
// The ui corpora whose snapshots a page may cite as its worked example,
// searched in this order. A corpus whose name ends in `_lint` snapshots its
// loose rows as `.warn`.
SNAPSHOT_DIRS: [String]{"tests/ui", "tests/ui_lint"}
// The case directories whose `.warn` files pin a rendered report a case
// compares with `stderr: =`, searched after the ui corpora.
CASE_SNAPSHOT_DIRS: [String]{"tests/cases/ui_lint_style"}
// The path a compiler diagnostic's type name is read under: reports print
// `Error [jet.UnusedParameter]`, and `#Allow` and `jet explain` take it.
NAME_PATH: "jet."
// The spec pages, whose diagnostic codes must each name a row.
SPEC_DIR: "Docs/spec"
// The codes registered before the letter law whose letter disagrees with
// their severity (Docs/spec/diagnostics.md: codes are never renumbered).
// Lints with a non-`L` code: E2818, E2930, E2931, E2934, JT0101 and the
// reserved W0410; a blocking row with an `L` code: L1101. The list only
// shrinks: a code whose letter matches again, or whose row is gone, fails the
// check until it is removed here, and a new mismatch can't be added.
LETTER_LAW_EXCEPTIONS: [String]{"E2818", "E2930", "E2931", "E2934", "JT0101", "L1101", "W0410"}

// The dated safety audit: the date --write wrote it, then AUDIT_NAME, in
// AUDIT_DIR.
AUDIT_DIR: "Docs/audits"
AUDIT_NAME: "-diagnostic-safety-audit.md"
// The code ranges, as a code's first three characters, whose active error
// rows must state a `safety_class`. The list grows until it holds every code.
SAFETY_RANGES: [String]{"E00", "E01", "E02", "E03", "E04", "E05", "E06", "E07", "E08", "E09", "E10", "E11", "E12", "E13", "E14", "E18", "E20", "E21", "E22", "E23", "E24", "E25", "E26", "E27", "E28", "E29", "E30", "E31", "E32", "E33", "E34", "E35", "E36", "E42", "E-A", "E-C", "E-E", "E-F", "E-M", "E-O", "E-S", "E-T", "E-W", "JT0", "L11", "R08"}
// Where a sealed floor's report site is looked for first.
SEMA_ROOT: "Compiler/JetSema/"
// A diagnostic code in compiler source: quoted whole, as `sema_error("E0212", …)`
// passes it, at the head of a message, as `"E2416: env var …"`, or in a runtime
// report's brackets, as `Runtime fault [R0801]: …`.
QUOTED_CODE: Regex{"[\x22\[]((?:E|R|JT|L|W)[0-9]{{4}}|E-[A-Z]+(?:-[A-Z]+)*)[\x22\]:]"}
// The active rows no source reports yet: the `jet os` verbs whose engine has
// not landed, which Jetpack/JetOS refuses until it does. Every other active
// row has a line under REPORT_ROOTS that reports its code. The list only
// shrinks: a listed code that a line reports, or whose row is no longer
// active, fails both modes until it is removed here, and the list may hold no
// more than UNREPORTED_CEILING codes; lower the ceiling with each removal.
UNREPORTED_CODES: [String]{"E1278", "E1279", "E1280", "E1281", "E1282", "E1283", "E1284", "E1285", "E1286", "E1287", "E1288", "E1289", "E1290", "E1291"}
UNREPORTED_CEILING: 14

STRUCT_OPEN: Regex{"^(\w+): struct \x7B$"}
STRUCT_FIELD: Regex{"^    ([a-z][a-z0-9_]*): String$"}
IMPL_OPEN: "    impl Diagnostic {{"
IMPL_CLOSE: "    }}"
CONSTANT: Regex{"^        ([a-z_]+): (.+)$"}
TEXT_LINE: Regex{"^        (what|why|fix): fn\(self\) -> String \{{ (\x22.*\x22) \}}$"}
TEXT_OPEN: Regex{"^        (what|why|fix): fn\(self\) -> String \x7B$"}
TEXT_BODY: Regex{"^            (\x22.*\x22)$"}
LITERAL: Regex{"^\x22((?:[^\x22\\]|\\.)*)\x22$"}
CASE: Regex{"^\.([A-Z][A-Za-z]*)$"}
// `structured_fix: .Replace{from: "…", to: "…"}` and `.Remove{text: "…"}`.
REPLACE_FIX: Regex{"^\.Replace\{{from: (\x22(?:[^\x22\\]|\\.)*\x22), to: (\x22(?:[^\x22\\]|\\.)*\x22)\}}$"}
REMOVE_FIX: Regex{"^\.Remove\{{text: (\x22(?:[^\x22\\]|\\.)*\x22)\}}$"}
STAGE_LIST: Regex{"^\[(\.[A-Z][a-z]*(?:, \.[A-Z][a-z]*)*)\]$"}
LINT_NAME: Regex{"^[a-z][a-z0-9_]*$"}
// The rubric's placeholder Why and Fix, and its decision IDs (`D-…`, `S…`).
PLACEHOLDER_WHY: Regex{"The registered .* rule applies here"}
PLACEHOLDER_FIX: Regex{"^Follow the guidance for "}
DECISION_ID: Regex{"\bD-[A-Z0-9-]+|\bS[0-9]+\b"}

#Error
DiagnosticRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> DiagnosticRowsError Never! {
    DiagnosticRowsError{message: "diagnostic rows: {message}"}
}

// One `name: value` constant or one text body, as written.
DiagnosticEntry: struct {
    name: String
    value: String
}

// One diagnostic struct and its `impl Diagnostic` block as written.
DiagnosticSource: struct {
    name: String
    fields: [String]
    constants: [DiagnosticEntry]
    texts: [DiagnosticEntry]
}

// One file with its text: a snapshot as read, or a copy as generated.
TextFile: struct {
    path: String
    text: String
}

// What one row gives the coverage baseline, its explain page and the safety audit.
RowFacts: struct {
    code: String
    // The type path a report's header prints: `jet.` and the impl's type.
    name: String
    active: Bool
    // A `.Error` row, not a `.Lint`.
    error: Bool
    // `severity: .Lint`; the letter law reads it against the code.
    lint: Bool
    plane: String
    // A structured fix other than `CryptoMisuse`, which carries evidence, not an edit.
    edit: Bool
    // A `no_fix` reason (`.Design` unless written `None`).
    reason: Bool
    what: String
    why: String
    fix: String
    // `Soundness`, `Opinion`, or "" when the row states no `safety_class`;
    // its `safety_reason` and `expert_path` as a reader sees them.
    safety_class: String
    safety_reason: String
    expert_path: String
}

RenderedRow: struct {
    text: String
    facts: RowFacts
    // The row's breaks of the plain-words rubric, each naming its code.
    rubric: [String]
}

RenderedRows: struct {
    text: String
    facts: [RowFacts]
}

// One plane's line of the coverage baseline.
PlaneCount: struct {
    plane: String
    edits: Int
    reasons: Int
    total: Int
}

entry: fn(entries: [DiagnosticEntry], name: String) -> String? Never! {
    loop row in entries {
        if row.name == name -> return Val(row.value.copy())
    }
    None
}

// The raw body of a one-line string literal, escapes kept as written.
literal_body: fn(text: String, context: String) -> String DiagnosticRowsError! {
    found: LITERAL.match(text) ?? return Err(rows_fail("{context}: expected one string literal, found `{text}`"))
    Ok(found.groups[0].copy())
}

// A text body with each `{self.field}` hole written as the registry's
// `{{field}}` placeholder. Every hole must read one of the struct's fields,
// and `{{`/`}}` stay escaped braces.
registry_text: fn(body: String, fields: [String], context: String) -> String DiagnosticRowsError! {
    bytes: body.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        byte: Int{bytes[index]}
        // `\`, `{{` and `}}` copy two bytes as written.
        if byte == 92 || ((byte == 123 || byte == 125) && index + 1 < bytes.len() && Int{bytes[index + 1]} == byte) {
            out.push(bytes[index])
            if index + 1 < bytes.len() -> out.push(bytes[index + 1])
            index += 2
            next
        }
        if byte == 125 -> return Err(rows_fail("{context}: a lone `}}` in a text"))
        if byte != 123 {
            out.push(bytes[index])
            index += 1
            next
        }
        close := index + 1
        loop close < bytes.len() && (Int{bytes[close]}) != 125 -> close += 1
        if close >= bytes.len() -> return Err(rows_fail("{context}: an unclosed `{{` hole"))
        hole: String.from_bytes(bytes.slice(index + 1, close)) ?? return Err(rows_fail("{context}: a hole is not UTF-8"))
        if !hole.starts_with("self.") -> return Err(rows_fail("{context}: the hole `{{{hole}}}` reads something other than a `self` field"))
        field: hole.remove_prefix("self.")
        if !fields.contains(field) -> return Err(rows_fail("{context}: the hole `{{{hole}}}` reads no field of the struct"))
        loop part in "{{{{{field}}}}}".bytes() -> out.push(part)
        index = close + 1
    }
    Ok(String.from_bytes(out) ?? body.copy())
}

// A registry text as a reader sees it: `{{` and `}}` are one brace, so a
// `{{field}}` placeholder shows as `{field}`; `\"` and `\\` are the quote and
// the backslash, and `\n`, `\t` and `\r` their control bytes.
display_text: fn(text: String, context: String) -> String DiagnosticRowsError! {
    bytes: text.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        byte: Int{bytes[index]}
        paired: index + 1 < bytes.len() && (byte == 92 || ((byte == 123 || byte == 125) && Int{bytes[index + 1]} == byte))
        if !paired {
            out.push(bytes[index])
            index += 1
            next
        }
        after: Int{bytes[index + 1]}
        if byte != 92 || after == 34 || after == 92 {
            out.push(bytes[index + 1])
        } else if after == 110 {
            out.push((U8{10}))
        } else if after == 116 {
            out.push((U8{9}))
        } else if after == 114 {
            out.push((U8{13}))
        } else {
            return Err(rows_fail("{context}: a backslash escape other than `\\\"`, `\\\\`, `\\n`, `\\t` or `\\r` (byte {after})"))
        }
        index += 2
    }
    Ok(String.from_bytes(out) ?? text.copy())
}

read_sources: fn(source_text: String) -> [DiagnosticSource] DiagnosticRowsError! {
    lines: source_text.split("\n").to_list()
    sources := [DiagnosticSource]{}
    index := 0
    loop index < lines.len() {
        line: lines[index]
        if STRUCT_OPEN.match(line) == .Val(struct_open) {
            name: struct_open.groups[0].copy()
            context: "{name}: struct"
            declared := [String]{}
            index += 1
            loop index < lines.len() {
                if STRUCT_FIELD.match(lines[index]) == .Val(field) {
                    declared.push(field.groups[0].copy())
                    index += 1
                    next
                }
                break
            }
            if declared.len() > 0 && index < lines.len() && lines[index] == "" -> index += 1
            if index >= lines.len() || lines[index] != IMPL_OPEN -> return Err(rows_fail("{context}: expected its `String` fields, then `impl Diagnostic {{`"))
            constants := [DiagnosticEntry]{}
            texts := [DiagnosticEntry]{}
            index += 1
            loop index < lines.len() && lines[index] != IMPL_CLOSE {
                body: lines[index]
                if {
                    TEXT_LINE.match(body) == .Val(one_line) -> texts.push(DiagnosticEntry{name: one_line.groups[0].copy(), value: one_line.groups[1].copy()})
                    TEXT_OPEN.match(body) == .Val(opened) -> {
                        literal: if index + 2 < lines.len() && lines[index + 2] == "        }}" -> TEXT_BODY.match(lines[index + 1]) else -> None
                        found: literal ?? return Err(rows_fail("{context}: `{opened.groups[0]}` must be one string literal"))
                        texts.push(DiagnosticEntry{name: opened.groups[0].copy(), value: found.groups[0].copy()})
                        index += 2
                    }
                    CONSTANT.match(body) == .Val(constant) -> {
                        if entry(constants, constant.groups[0]) != None -> return Err(rows_fail("{context}: `{constant.groups[0]}` is given twice"))
                        constants.push(DiagnosticEntry{name: constant.groups[0].copy(), value: constant.groups[1].copy()})
                    }
                    body.trim() != "" -> return Err(rows_fail("{context}: unparsed line `{body}`"))
                }
                index += 1
            }
            if index + 1 >= lines.len() || lines[index + 1] != "}}" -> return Err(rows_fail("{context}: `impl Diagnostic` must be the struct's last member"))
            sources.push(DiagnosticSource{name: name, fields: declared, constants: constants, texts: texts})
            index += 2
            next
        }
        if line.starts_with("    ") || line.starts_with("}}") -> return Err(rows_fail("unparsed line `{line}`"))
        index += 1
    }
    if sources.len() == 0 -> return Err(rows_fail("{SOURCE_PATH} declares no diagnostic type"))
    Ok(sources)
}

// The case of a `.Case` constant.
constant_case: fn(value: String, context: String) -> String DiagnosticRowsError! {
    found: CASE.match(value) ?? return Err(rows_fail("{context}: expected a `.Case`, found `{value}`"))
    Ok(found.groups[0].copy())
}

// The literal body of a string constant, or `fallback` when the impl omits it.
constant_literal: fn(source: DiagnosticSource, name: String, fallback: String) -> String DiagnosticRowsError! {
    value: entry(source.constants, name) ?? return Ok(fallback.copy())
    literal_body(value, "{source.name}.{name}")
}

render_row: fn(source: DiagnosticSource) -> RenderedRow DiagnosticRowsError! {
    context: "{source.name}: struct"
    known: [String]{"code", "severity", "lint_name", "stage", "moment", "status", "meaning", "detail", "structured_fix", "no_fix", "fix_next", "fix_safety", "safety_class", "safety_reason", "expert_path"}
    loop constant in source.constants {
        if !known.contains(constant.name) -> return Err(rows_fail("{context}: unknown constant `{constant.name}`"))
    }
    if entry(source.constants, "code") == None -> return Err(rows_fail("{context}: a compiler diagnostic states its `code`"))
    code_text: constant_literal(source, "code", "") ?? return Err(err)
    texts := [String]{}
    parts: [String]{"what", "why", "fix"}
    loop part in parts {
        literal: entry(source.texts, part) ?? return Err(rows_fail("{context}: `{part}: fn` is missing"))
        body: literal_body(literal, "{context}.{part}") ?? return Err(err)
        texts.push(registry_text(body, source.fields, "{context}.{part}") ?? return Err(err))
    }
    rubric := [String]{}
    if PLACEHOLDER_WHY.is_match(texts[1]) -> rubric.push("{code_text} why is a placeholder")
    loop (index, part) in parts {
        if DECISION_ID.find(texts[index]) == .Val(id) -> rubric.push("{code_text} {part} names decision {id}")
    }
    severity: constant_case(entry(source.constants, "severity") ?? ".Error", "{context}.severity") ?? return Err(err)
    has_lint: entry(source.constants, "lint_name") != None
    lint: constant_literal(source, "lint_name", "") ?? return Err(err)
    // A retired lint may keep no selector: nothing names it in `#Allow` any more.
    retired: (entry(source.constants, "status") ?? "") == ".Retired"
    if {
        severity == "Lint" && !has_lint && !retired -> return Err(rows_fail("{context}: a `.Lint` diagnostic needs a `lint_name`"))
        severity == "Lint" && has_lint && LINT_NAME.match(lint) == None -> return Err(rows_fail("{context}: lint name `{lint}` is not snake_case"))
        severity != "Lint" && severity != "Error" -> return Err(rows_fail("{context}: a compiler diagnostic is `.Error` or `.Lint`, not `.{severity}`"))
        severity == "Error" && has_lint -> return Err(rows_fail("{context}: only a `.Lint` diagnostic has a `lint_name`"))
    }
    severity_int: if severity == "Lint" -> 2 else -> 1
    lint_text: if has_lint -> "Val(\"{lint}\")" else -> "None"
    moment: constant_case(entry(source.constants, "moment") ?? ".Compile", "{context}.moment") ?? return Err(err)
    status: constant_case(entry(source.constants, "status") ?? ".Active", "{context}.status") ?? return Err(err)
    // A retired or reserved row runs in no stage, so it states none and its
    // row's stage is empty; an active row without one runs in sema.
    stages := if status == "Active" -> "sema" else -> ""
    if entry(source.constants, "stage") == .Val(stage_list) {
        if status != "Active" -> return Err(rows_fail("{context}: a `.{status}` row runs in no stage, so it states no `stage`"))
        list: STAGE_LIST.match(stage_list) ?? return Err(rows_fail("{context}: unparsed stage list `{stage_list}`"))
        stages = list.groups[0].replace(", .", "/").remove_prefix(".").lower()
    }
    meaning: constant_literal(source, "meaning", texts[0]) ?? return Err(err)
    written_meaning: entry(source.constants, "meaning") != None
    if written_meaning {
        if DECISION_ID.find(meaning) == .Val(id) -> rubric.push("{code_text} meaning names decision {id}")
    }
    // The What is one message; an active row's meaning names the failure
    // apart from any message, so a missing one or a copy of the What fails.
    if {
        status == "Active" && !written_meaning -> rubric.push("{code_text} states no meaning")
        status == "Active" && meaning == texts[0] -> rubric.push("{code_text} meaning repeats its what")
    }
    if status == "Active" && PLACEHOLDER_FIX.is_match(texts[2]) -> rubric.push("{code_text} fix is a placeholder")
    detail: entry(source.constants, "detail") ?? "false"
    if detail != "true" && detail != "false" -> return Err(rows_fail("{context}: `detail` is `true` or `false`"))
    written_fix: entry(source.constants, "structured_fix") ?? ""
    edit := ""
    structured := "None"
    if REPLACE_FIX.match(written_fix) == .Val(replace) {
        edit = "Replace"
        from: literal_body(replace.groups[0], "{context}.structured_fix") ?? return Err(err)
        to: literal_body(replace.groups[1], "{context}.structured_fix") ?? return Err(err)
        structured = "Val(DiagnosticRegistryFix.Replace{{from: \"{from}\", to: \"{to}\"}})"
    } else if REMOVE_FIX.match(written_fix) == .Val(remove) {
        edit = "Remove"
        text: literal_body(remove.groups[0], "{context}.structured_fix") ?? return Err(err)
        structured = "Val(DiagnosticRegistryFix.Remove{{text: \"{text}\"}})"
    } else if written_fix != "" {
        edit = constant_case(written_fix, "{context}.structured_fix") ?? return Err(err)
        if edit == "Replace" -> return Err(rows_fail("{context}: a `.Replace` fix is written `.Replace{{from: \"…\", to: \"…\"}}`"))
        if edit == "Remove" -> return Err(rows_fail("{context}: a `.Remove` fix is written `.Remove{{text: \"…\"}}`"))
        structured = "Val(DiagnosticRegistryFix.{edit})"
    }
    has_next: entry(source.constants, "fix_next") != None
    next_text: constant_literal(source, "fix_next", texts[2]) ?? return Err(err)
    written_no_fix: entry(source.constants, "no_fix") ?? ".Design"
    if written_no_fix == "None" && has_next -> return Err(rows_fail("{context}: `fix_next` needs a `no_fix` reason"))
    no_fix_kind: if written_no_fix == "None" -> "" else -> constant_case(written_no_fix, "{context}.no_fix") ?? return Err(err)
    no_fix: if no_fix_kind == "" -> "None" else -> "Val(DiagnosticNoFixReason{{kind: DiagnosticNoFixReasonKind.{no_fix_kind}, next: \"{next_text}\"}})"
    safety := "None"
    if entry(source.constants, "fix_safety") == .Val(written_safety) {
        grade: constant_case(written_safety, "{context}.fix_safety") ?? return Err(err)
        safety = "Val(DiagnosticFixSafety.{grade})"
    }
    class := ""
    if entry(source.constants, "safety_class") == .Val(written_class) {
        class = constant_case(written_class, "{context}.safety_class") ?? return Err(err)
        if class != "Soundness" && class != "Opinion" -> return Err(rows_fail("{context}: a `safety_class` is `.Soundness` or `.Opinion`, not `.{class}`"))
        if status != "Active" || severity != "Error" -> return Err(rows_fail("{context}: only an active `.Error` row states a `safety_class`"))
    }
    has_safety_reason: entry(source.constants, "safety_reason") != None
    has_expert: entry(source.constants, "expert_path") != None
    if class == "" && status == "Active" && severity == "Error" && in_safety_ranges(code_text) -> return Err(rows_fail("{context}: `{code_text}` is an active error row in a classified range, so it states a `safety_class` and its `safety_reason`"))
    if (class != "") != has_safety_reason -> return Err(rows_fail("{context}: a `safety_class` and a `safety_reason` come together"))
    if (class == "Soundness") != has_expert -> return Err(rows_fail("{context}: a `.Soundness` row, and only one, states its `expert_path`"))
    safety_reason: display_text(constant_literal(source, "safety_reason", "") ?? return Err(err), "{context}.safety_reason") ?? return Err(err)
    expert_path: display_text(constant_literal(source, "expert_path", "") ?? return Err(err), "{context}.expert_path") ?? return Err(err)
    text: [String]{
        "    {{",
        "        code: \"{code_text}\",",
        "        name: \"{NAME_PATH}{source.name}\",",
        "        lint_name: {lint_text},",
        "        stage: \"{stages}\",",
        "        severity: {severity_int},",
        "        moment: DiagnosticMoment.{moment},",
        "        status: DiagnosticRegistryStatus.{status},",
        "        meaning: \"{meaning}\",",
        "        what: \"{texts[0]}\",",
        "        why: \"{texts[1]}\",",
        "        fix: \"{texts[2]}\",",
        "        detail: {detail},",
        "        structured_fix: {structured},",
        "        fix_safety: {safety},",
        "        no_fix_reason: {no_fix},",
        "    }},",
    }.join("\n")
    shown := [String]{}
    loop (index, part) in parts -> shown.push(display_text(texts[index], "{context}.{part}") ?? return Err(err))
    Ok(RenderedRow{text: text, rubric: rubric, facts: RowFacts{
        code: code_text,
        name: "{NAME_PATH}{source.name}",
        active: status == "Active",
        error: severity == "Error",
        lint: severity == "Lint",
        plane: stages,
        edit: edit != "" && edit != "CryptoMisuse",
        reason: no_fix_kind != "",
        what: shown[0],
        why: shown[1],
        fix: shown[2],
        safety_class: class,
        safety_reason: safety_reason,
        expert_path: expert_path,
    }})
}

// Whether `code` is in SAFETY_RANGES, whose active error rows state a `safety_class`.
in_safety_ranges: fn(code: String) -> Bool Never! {
    loop range in SAFETY_RANGES {
        if code.starts_with(range) -> return true
    }
    false
}

render_rows: fn(source: String) -> RenderedRows DiagnosticRowsError! {
    rows: read_sources(source) ?? return Err(err)
    codes := [String]{}
    rendered := [String]{}
    facts := [RowFacts]{}
    rubric := [String]{}
    loop row in rows {
        one: render_row(row) ?? return Err(err)
        if codes.contains(one.facts.code) -> return Err(rows_fail("code `{one.facts.code}` is used twice"))
        codes.push(one.facts.code)
        rendered.push(one.text)
        facts.push(one.facts)
        loop problem in one.rubric -> rubric.push(problem.copy())
    }
    if rubric.len() > 0 -> return Err(rows_fail("{rubric.len()} row texts break the plain-words rubric of Docs/spec/diagnostics.md (a Why gives a reason; no human text names a decision ID; an active row's meaning is its own words and its Fix a step): {rubric.join("; ")}"))
    Ok(RenderedRows{text: "{GENERATED_BY}\nDIAGNOSTIC_ROWS: #run {{ [DiagnosticRegistryRow]{{\n{rendered.join("\n")}\n}} }}\n", facts: facts})
}

// The rows whose code letter breaks the letter law, and the exceptions that
// no longer name a breaking row. A lint takes an `L` code and no other row
// does; `exceptions` names the frozen older codes that keep their letter.
letter_law_problems: fn(rows: [RowFacts], exceptions: [String]) -> [String] Never! {
    problems := [String]{}
    breaking := [String]{}
    loop row in rows {
        if row.lint == row.code.starts_with("L") -> next
        breaking.push(row.code.copy()) // copy: the row keeps its code
        if exceptions.contains(row.code) -> next
        if row.lint {
            problems.push("{row.code} is a lint, so its code takes the letter `L`")
        } else {
            problems.push("{row.code} is not a lint, so its code can't take the letter `L`")
        }
    }
    loop code in exceptions {
        if !breaking.contains(code) -> problems.push("{code} is in LETTER_LAW_EXCEPTIONS but no row breaks the letter law under it; remove it from the list")
    }
    problems
}

// The active rows' counts per plane, in plane order. An active row may carry a
// structured edit or a no-fix reason, never both.
plane_counts: fn(facts: [RowFacts]) -> [PlaneCount] DiagnosticRowsError! {
    slots := [String:Int]{}
    counts := [PlaneCount]{}
    loop row in facts {
        if !row.active -> next
        if row.edit && row.reason -> return Err(rows_fail("{row.code}: an active row has a `structured_fix` or a `no_fix` reason, not both; write `no_fix: None` beside the fix"))
        slot := counts.len()
        if slots.get(row.plane) == .Val(found) {
            slot = found
        } else {
            slots[row.plane] = slot
            counts.push(PlaneCount{plane: row.plane, edits: 0, reasons: 0, total: 0})
        }
        counts[slot].total += 1
        if row.edit -> counts[slot].edits += 1
        if row.reason -> counts[slot].reasons += 1
    }
    counts.sort_by(fn(count) { count.plane })
    Ok(counts)
}

// The rows with neither an edit nor a reason, per plane, in a baseline text.
uncovered_in: fn(baseline: String) -> [String:Int] DiagnosticRowsError! {
    uncovered := [String:Int]{}
    loop line in baseline.split("\n") {
        if line == "" || line.starts_with("#") -> next
        fields: line.split(" ").to_list()
        if fields.len() != 4 -> return Err(rows_fail("{BASELINE_PATH}: unparsed line `{line}`"))
        edits: Int.parse(fields[1]) ?? return Err(rows_fail("{BASELINE_PATH}: unparsed line `{line}`"))
        reasons: Int.parse(fields[2]) ?? return Err(rows_fail("{BASELINE_PATH}: unparsed line `{line}`"))
        total: Int.parse(fields[3]) ?? return Err(rows_fail("{BASELINE_PATH}: unparsed line `{line}`"))
        uncovered[fields[0]] = total - edits - reasons
    }
    Ok(uncovered)
}

// The coverage baseline the rows give. `committed` is the baseline on disk:
// no plane may gain a row with neither a structured edit nor a no-fix reason.
render_baseline: fn(facts: [RowFacts], committed: String) -> String DiagnosticRowsError! {
    counts: plane_counts(facts) ?? return Err(err)
    before: uncovered_in(committed) ?? return Err(err)
    lines := [String]{}
    loop count in counts {
        now: count.total - count.edits - count.reasons
        floor: before.get(count.plane) ?? 0
        if now > floor -> return Err(rows_fail("plane `{count.plane}` would have {now} active rows with neither a `structured_fix` nor a `no_fix` reason, up from {floor}; give the new row one"))
        lines.push("{count.plane} {count.edits} {count.reasons} {count.total}")
    }
    Ok("{BASELINE_HEADER}{lines.join("\n")}\n")
}

// The snapshot-coverage allowlist the ui suite's coverage entry
// (kit_ui_coverage in Compiler/JetTestKit/Source/Ui.jet) reads: every code
// with no snapshot coverage, derived as that entry derives it.
ALLOWLIST_PATH: "tests/diagnostics_coverage_allowlist.tsv"
ALLOWLIST_HEADER: "# Generated by Tools/agent/DiagnosticRows.jet from Compiler/Prelude/Diagnostics.jet, the sources and the snapshots; do not edit.\n# Every code without snapshot coverage: left-only, an active row a source names that no snapshot renders;\n# right-only, a code a snapshot renders that no active row a source names owns. The generator refuses a\n# change that adds a row: give the code a snapshot. Each row is on the card that covers every code.\n# code\tside\tcard\n"
ALLOWLIST_CARD: "Tower #6752"
// The coverage entry's own source, which holds the codes coverage leaves out.
KIT_UI_PATH: "Compiler/JetTestKit/Source/Ui.jet"
KIT_UI_EXCLUDED: "kit_ui_excluded: fn(code: String) -> Bool {{\n    kit_expect_named(["
// The source trees whose `.jet` files may name an emitted code, and the
// directories under them the scan skips.
COVERAGE_ROOTS: [String]{"Compiler", "Jetpack", "Core"}
COVERAGE_SKIPPED: [String]{"Tests", "Fixtures", "fixtures"}
// The report snapshots beyond the ui corpora: a directory and the suffix of
// the files directly in it.
COVERAGE_REPORTS: [String]{"tests/cli\t.txt", "tests/release\t.txt", "tests/fixtures/cli-diagnostics\t.stderr", "tests/fixtures/jetpack-diagnostics\t.stderr", "tests/fixtures/module-eval-diagnostics\t.stderr"}
REPORT_OPENERS: [String]{"Error [", "Warning [", "Stop [", "Lint ["}

code_byte: fn(byte: Int) -> Bool Never! { (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 45 }

digits: fn(text: String) -> Bool Never! { text.bytes().all(fn(byte) { Int{byte} >= 48 && Int{byte} <= 57 }) }

// A code a report header may print: an uppercase letter, then uppercase
// letters, digits and dashes.
report_code: fn(code: String) -> Bool Never! {
    bytes: code.bytes()
    if bytes.len() == 0 || (Int{bytes[0]}) < 65 || (Int{bytes[0]}) > 90 -> return false
    bytes.all(fn(byte) { code_byte(Int{byte}) })
}

// A code a source names: `E`, `L` or `W` and four digits, `JT` and four
// digits, or `E-`/`L-` and two or more dash-separated uppercase words.
source_code: fn(code: String) -> Bool Never! {
    bytes: code.bytes()
    first: if bytes.len() > 0 -> (Int{bytes[0]}) else -> 0
    if bytes.len() == 5 && (first == 69 || first == 76 || first == 87) && digits(String.from_bytes(bytes.slice(1, 5)) ?? "") -> return true
    if bytes.len() == 6 && code.starts_with("JT") && digits(text_after(code, "JT")) -> return true
    if !code.starts_with("E-") && !code.starts_with("L-") -> return false
    words: (String.from_bytes(bytes.slice(2, bytes.len())) ?? "").split("-").to_list()
    words.len() >= 2 && words.all(fn(word) { word != "" && word.bytes().all(fn(byte) { code_byte(Int{byte}) && Int{byte} != 45 }) })
}

add_code: fn(codes: &[String], code: String) {
    if !codes.contains(code) -> codes.push(code.copy())
}

// The codes `text` names in double quotes or square brackets.
source_codes: fn(text: String, codes: &[String]) {
    bytes: text.bytes()
    loop (index, raw) in bytes {
        byte: Int{raw}
        if byte != 34 && byte != 91 -> next
        close: if byte == 34 -> 34 else -> 93
        end := index + 1
        loop end < bytes.len() && code_byte(Int{bytes[end]}) {
            end += 1
        }
        if end == index + 1 || end >= bytes.len() || (Int{bytes[end]}) != close -> next
        code: String.from_bytes(bytes.slice(index + 1, end)) ?? next
        if source_code(code) -> add_code(codes, code)
    }
}

// The codes the `.jet` sources under `directory` name, outside test, fixture
// and hidden directories (a build's `.jet` holds generated copies of the
// registry) and the registry's own two files.
emitted_codes: fn(directory: String, codes: &[String]) DiagnosticRowsError! -[FS]> {
    if !files.exists(directory) -> return Ok()
    loop child in (files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))) {
        path: "{directory}/{child.name}"
        if child.is_dir {
            if !child.name.starts_with(".") && !COVERAGE_SKIPPED.contains(child.name) -> emitted_codes(path, codes) ?? return Err(err)
        } else if child.name.ends_with(".jet") && path != SOURCE_PATH && path != ROWS_PATH {
            text: files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
            source_codes(text, codes)
        }
    }
    Ok()
}

// The codes the report headers in `text` name: a header names a row by its
// type path (`Error [jet.UnknownName]`) or names a code.
report_codes: fn(facts: [RowFacts], text: String, codes: &[String]) {
    loop line in text.split("\n") {
        loop opener in REPORT_OPENERS {
            if !line.starts_with(opener) -> next
            rest: text_after(line, opener)
            if !rest.contains("]") -> break
            token: text_before(rest, "]")
            if token.starts_with(NAME_PATH) {
                loop row in facts {
                    if row.name == token -> add_code(codes, row.code)
                }
            } else if report_code(token) {
                add_code(codes, token)
            }
            break
        }
    }
}

// The codes every rendered report the coverage entry reads names: the ui
// corpora's snapshots and the report files of COVERAGE_REPORTS.
rendered_codes: fn(facts: [RowFacts]) -[FS]> [String] DiagnosticRowsError! {
    codes := [String]{}
    loop directory in SNAPSHOT_DIRS {
        loop snapshot in (ui_snapshots("", directory, directory.ends_with("_lint")) ?? return Err(err)) -> report_codes(facts, snapshot.text, codes)
    }
    loop pair in COVERAGE_REPORTS {
        directory: text_before(pair, "\t")
        suffix: text_after(pair, "\t")
        if !files.exists(directory) -> next
        loop child in (files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))) {
            if child.is_dir || !child.name.ends_with(suffix) -> next
            text: files.read(child.path) ?? return Err(rows_fail("cannot read {child.path}: {err}"))
            report_codes(facts, text, codes)
        }
    }
    Ok(codes)
}

// The codes coverage leaves out, as the coverage entry's source lists them.
excluded_codes: fn(kit: String) -> [String] DiagnosticRowsError! {
    if !kit.contains(KIT_UI_EXCLUDED) -> return Err(rows_fail("{KIT_UI_PATH} no longer opens kit_ui_excluded with `{KIT_UI_EXCLUDED.replace("\n", "\\n")}`"))
    listed: text_before(text_after(kit, KIT_UI_EXCLUDED), "]")
    codes := [String]{}
    loop part in listed.split(",") {
        quoted: part.trim()
        code: if quoted.starts_with("\"") && quoted.ends_with("\"") && quoted.count_bytes() > 2 -> text_before(text_after(quoted, "\""), "\"") else -> ""
        if !report_code(code) -> return Err(rows_fail("{KIT_UI_PATH}: kit_ui_excluded lists `{quoted}`, not a quoted code"))
        codes.push(code.copy())
    }
    Ok(codes)
}

// The allowlist: each active row a source names that no snapshot renders
// (left-only), then each rendered code no such row owns (right-only), each
// side in code order, leaving out `excluded`. `committed` is the allowlist on
// disk: no row may join it.
render_allowlist: fn(facts: [RowFacts], emitted: [String], rendered: [String], excluded: [String], committed: String) -> String DiagnosticRowsError! {
    left := [String]{}
    loop row in facts {
        if row.active && emitted.contains(row.code) && !excluded.contains(row.code) -> add_code(left, row.code)
    }
    right := [String]{}
    loop code in rendered {
        if !excluded.contains(code) -> add_code(right, code)
    }
    rows := [String]{}
    ordered_left := left.copy()
    ordered_left.sort()
    loop code in ordered_left {
        if !right.contains(code) -> rows.push("{code}\tleft-only")
    }
    ordered_right := right.copy()
    ordered_right.sort()
    loop code in ordered_right {
        if !left.contains(code) -> rows.push("{code}\tright-only")
    }
    before := [String]{}
    loop line in committed.split("\n") {
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() >= 2 -> before.push("{fields[0]}\t{fields[1]}")
    }
    added := [String]{}
    loop row in rows {
        if !before.contains(row) -> added.push(row.replace("\t", " "))
    }
    if added.len() > 0 -> return Err(rows_fail("{ALLOWLIST_PATH} would gain {added.len()} uncovered codes ({added.join(", ")}); give each a snapshot under tests/ui"))
    lines := [String]{}
    loop row in rows -> lines.push("{row}\t{ALLOWLIST_CARD}")
    if lines.len() == 0 -> return Ok(ALLOWLIST_HEADER.copy())
    Ok("{ALLOWLIST_HEADER}{lines.join("\n")}\n")
}

// The allowlist the rows, the sources and the snapshots give.
allowlist: fn(facts: [RowFacts]) -[FS]> String DiagnosticRowsError! {
    kit: files.read(KIT_UI_PATH) ?? return Err(rows_fail("cannot read {KIT_UI_PATH}: {err}"))
    excluded: excluded_codes(kit) ?? return Err(err)
    emitted := [String]{}
    loop root in COVERAGE_ROOTS -> emitted_codes(root, emitted) ?? return Err(err)
    rendered: rendered_codes(facts) ?? return Err(err)
    committed: if files.exists(ALLOWLIST_PATH) -> files.read(ALLOWLIST_PATH) ?? return Err(rows_fail("cannot read {ALLOWLIST_PATH}: {err}")) else -> ""
    render_allowlist(facts, emitted, rendered, excluded, committed)
}

// Whether a UI source is a fixture module the suite imports rather than runs:
// it has a `// @fixture_module` directive line.
fixture_module: fn(source: String) -> Bool Never! {
    loop raw in source.split("\n") {
        line: raw.trim()
        if !line.starts_with("//") -> next
        directive: text_after(line, "//").trim()
        if directive == "@fixture_module" || directive.starts_with("@fixture_module ") || directive.starts_with("@fixture_module\t") -> return true
    }
    false
}

// The snapshot a row owns at `path` (relative to `root`): none when the row
// has none, else that one file.
owned_snapshot: fn(root: String, path: String) -[FS]> [TextFile] DiagnosticRowsError! {
    found := [TextFile]{}
    disk: if root == "" -> path.copy() else -> "{root}/{path}"
    if !files.exists(disk) -> return Ok(found)
    text: files.read(disk) ?? return Err(rows_fail("cannot read {path}: {err}"))
    found.push(TextFile{path: path.copy(), text: text})
    Ok(found)
}

// The snapshot of every row the ui suite runs under `directory`, in path
// order with each directory's entries sorted by name. A row is what
// kit_ui_collect (Compiler/JetTestKit/Source/Ui.jet) runs: a directory with a
// `run.jet` or `main.jet` entry owns its `stderr` and one with a
// `workspace.jet` entry owns the `<dir>.stderr` beside it; a loose `.jet`
// source that is no `.fixed.jet` companion, manifest or fixture module owns
// `<stem>.stderr` (`<stem>.warn` in a lint corpus). Any other file, and any
// dot-directory such as a build's `.jet`, is not a snapshot the suite owns,
// so a checkout's leftovers never move a page. Paths are relative to `root`.
ui_snapshots: fn(root: String, directory: String, lint: Bool) -[FS]> [TextFile] DiagnosticRowsError! {
    found := [TextFile]{}
    at: if root == "" -> directory.copy() else -> "{root}/{directory}"
    if !files.exists(at) -> return Ok(found)
    children := files.list_dir(at) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    children.sort_by(fn(child) { child.name })
    loop child in children {
        if child.name.starts_with(".") -> next
        shown: "{directory}/{child.name}"
        owned := ""
        if child.is_dir {
            entries: [String]{"run.jet", "main.jet", "workspace.jet"}
            entry := ""
            loop name in entries {
                if entry == "" && files.exists("{child.path}/{name}") -> entry = name.copy()
            }
            if entry == "" {
                loop snapshot in (ui_snapshots(root, shown, lint) ?? return Err(err)) -> found.push(snapshot)
                next
            }
            owned = if entry == "workspace.jet" -> "{shown}.stderr" else -> "{shown}/stderr"
        } else {
            if !child.name.ends_with(".jet") || child.name.ends_with(".fixed.jet") || child.name == "package.jet" || child.name == "workspace.jet" -> next
            source: files.read(child.path) ?? return Err(rows_fail("cannot read {shown}: {err}"))
            if fixture_module(source) -> next
            stem: shown.remove_suffix(".jet")
            owned = if lint -> "{stem}.warn" else -> "{stem}.stderr"
        }
        loop snapshot in (owned_snapshot(root, owned) ?? return Err(err)) -> found.push(snapshot)
    }
    Ok(found)
}

// The `.warn` snapshots directly under a case directory, sorted by name: each
// is the rendered report a case there compares with `stderr: =`.
case_snapshots: fn(root: String, directory: String) -[FS]> [TextFile] DiagnosticRowsError! {
    found := [TextFile]{}
    at: if root == "" -> directory.copy() else -> "{root}/{directory}"
    if !files.exists(at) -> return Ok(found)
    children := files.list_dir(at) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    children.sort_by(fn(child) { child.name })
    loop child in children {
        if child.is_dir || !child.name.ends_with(".warn") -> next
        loop snapshot in (owned_snapshot(root, "{directory}/{child.name}") ?? return Err(err)) -> found.push(snapshot)
    }
    Ok(found)
}

// Each `[jet.Name]` marker's first snapshot, as an index into `snapshots`.
first_snapshots: fn(snapshots: [TextFile]) -> [String:Int] Never! {
    first := [String:Int]{}
    loop (at, snapshot) in snapshots {
        loop (index, part) in snapshot.text.split("[jet.").to_list() {
            if index == 0 || !part.contains("]") -> next
            name: "jet.{part.split("]").to_list()[0]}"
            if first.get(name) == None -> first[name] = at
        }
    }
    first
}

html_escape: fn(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        entity: if {
            byte == (U8{38}) -> "&amp;"
            byte == (U8{60}) -> "&lt;"
            byte == (U8{62}) -> "&gt;"
            byte == (U8{34}) -> "&quot;"
            byte == (U8{39}) -> "&#39;"
            byte == (U8{0}) -> "&#0;"
            else -> ""
        }
        if entity == "" {
            out.push(byte)
        } else {
            loop part in entity.bytes() -> out.push(part)
        }
    }
    String.from_bytes(out) ?? value.copy()
}

// A row's explain page: its what, why and fix as a reader sees them, and the
// first UI snapshot that names it as the worked example.
render_page: fn(row: RowFacts, example: TextFile?) -> String Never! {
    code: html_escape(row.code)
    what: html_escape(row.what)
    why: html_escape(row.why)
    fix: html_escape(row.fix)
    worked: if example == {
        .Val(snapshot) -> "<p>First UI snapshot mentioning <code>{code}</code>: <code>{html_escape(snapshot.path)}</code>.</p>\n<pre class=\"diag\">{html_escape(snapshot.text)}</pre>"
        .None -> "<p>No UI snapshot currently mentions this code.</p>"
    }
    lines: [String]{
        PAGE_GENERATED_BY,
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "<meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
        "<title>{code} — Jet diagnostic</title>",
        "<meta name=\"description\" content=\"{what}\">",
        "<meta property=\"og:title\" content=\"{code} — Jet diagnostic\">",
        "<meta property=\"og:description\" content=\"{what}\">",
        "<link rel=\"icon\" type=\"image/svg+xml\" href=\"../../assets/favicon.svg\">",
        "<link rel=\"stylesheet\" href=\"../../assets/site.css\">",
        "</head>",
        "<body>",
        "<header class=\"wrap nav\">",
        "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>",
        "<nav><ul class=\"nav-links\">",
        "<li><a href=\"../../tour.html\">Tour</a></li>",
        "<li><a href=\"../../install.html\">Install</a></li>",
        "<li><a href=\"../index.html\" aria-current=\"page\">Error codes</a></li>",
        "</ul></nav>",
        "</header>",
        "<main>",
        "<section class=\"wrap page\">",
        "<div class=\"page-header\">",
        "<p class=\"eyebrow\">// diagnostic</p>",
        "<h1>{code}</h1>",
        "<p>{what}</p>",
        "</div>",
        "</section>",
        "<article class=\"wrap article\">",
        "<h2>What</h2>",
        "<p class=\"diag-copy what\" data-registry-field=\"what\">{what}</p>",
        "<h2>Why</h2>",
        "<p class=\"diag-copy why\" data-registry-field=\"why\">{why}</p>",
        "<h2>Fix</h2>",
        "<p class=\"diag-copy fix\" data-registry-field=\"fix\">{fix}</p>",
        "<h2>Worked example</h2>",
        worked,
        "<p><a href=\"../index.html\">Back to all error codes</a></p>",
        "</article>",
        "</main>",
        "<footer class=\"footer\">",
        "<div class=\"wrap footer-grid\">",
        "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>",
        "<p class=\"made\">Generated from Jet's diagnostic registry and UI snapshots.</p>",
        "</div>",
        "</footer>",
        "</body>",
        "</html>",
    }
    "{lines.join("\n")}\n"
}

page_path: fn(code: String) -> String Never! { "{PAGES_DIR}/{code}/index.html" }

render_pages: fn(facts: [RowFacts], snapshots: [TextFile]) -> [TextFile] Never! {
    first: first_snapshots(snapshots)
    pages := [TextFile]{}
    loop row in facts {
        example := TextFile?{None}
        if first.get(row.name) == .Val(at) -> example = Val(snapshots[at].copy())
        pages.push(TextFile{path: page_path(row.code), text: render_page(row, example)})
    }
    pages
}

// The `.html` files under `directory`.
html_under: fn(directory: String) -[FS]> [String] DiagnosticRowsError! {
    found := [String]{}
    loop child in (files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))) {
        if child.is_dir {
            loop path in (html_under(child.path) ?? return Err(err)) -> found.push(path)
        } else if child.name.ends_with(".html") {
            found.push(child.path)
        }
    }
    Ok(found)
}

// The pages under PAGES_DIR that no row owns, beside its hand-written index.
stale_pages: fn(pages: [TextFile]) -[FS]> [String] DiagnosticRowsError! {
    stale := [String]{}
    if !files.exists(PAGES_DIR) -> return Ok(stale)
    owned := [String:Bool]{}
    loop page in pages -> owned[page.path] = true
    loop path in (html_under(PAGES_DIR) ?? return Err(err)) {
        if path != "{PAGES_DIR}/index.html" && owned.get(path) == None -> stale.push(path)
    }
    stale.sort()
    Ok(stale)
}

// Every copy the rows give, each with its path: the registry rows, the
// coverage baseline, the snapshot-coverage allowlist and one explain page per
// row.
generated_files: fn(rows: RenderedRows) -[FS]> [TextFile] DiagnosticRowsError! {
    committed: if files.exists(BASELINE_PATH) -> files.read(BASELINE_PATH) ?? return Err(rows_fail("cannot read {BASELINE_PATH}: {err}")) else -> ""
    baseline: render_baseline(rows.facts, committed) ?? return Err(err)
    snapshots := [TextFile]{}
    loop directory in SNAPSHOT_DIRS {
        loop snapshot in (ui_snapshots("", directory, directory.ends_with("_lint")) ?? return Err(err)) -> snapshots.push(snapshot)
    }
    loop directory in CASE_SNAPSHOT_DIRS {
        loop snapshot in (case_snapshots("", directory) ?? return Err(err)) -> snapshots.push(snapshot)
    }
    covered: allowlist(rows.facts) ?? return Err(err)
    generated := [TextFile]{TextFile{path: ROWS_PATH, text: rows.text}, TextFile{path: BASELINE_PATH, text: baseline}, TextFile{path: ALLOWLIST_PATH, text: covered}}
    loop page in render_pages(rows.facts, snapshots) -> generated.push(page)
    Ok(generated)
}

// The value of one hex digit byte, or -1.
hex_digit: fn(byte: Int) -> Int Never! {
    if byte >= 48 && byte <= 57 -> return byte - 48
    if byte >= 97 && byte <= 102 -> return byte - 87
    if byte >= 65 && byte <= 70 -> return byte - 55
    0 - 1
}

// The string literals on one source line, each as the program prints it:
// `\n`, `\t`, `\r`, `\"`, `\\`, a `\xHH` byte and an octal byte are their
// bytes, and in Jet source `{{` and `}}` are one brace. An interpolation's
// own quotes split a literal; each part keeps the text on its side.
line_literals: fn(line: String, jet: Bool) -> [String] Never! {
    bytes: line.bytes()
    found := [String]{}
    index := 0
    loop index < bytes.len() {
        if (Int{bytes[index]}) != 34 {
            index += 1
            next
        }
        out := [U8]{}
        index += 1
        loop index < bytes.len() && (Int{bytes[index]}) != 34 {
            byte: Int{bytes[index]}
            paired: index + 1 < bytes.len() && Int{bytes[index + 1]} == byte
            if jet && (byte == 123 || byte == 125) && paired {
                out.push(bytes[index])
                index += 2
                next
            }
            if byte != 92 || index + 1 >= bytes.len() {
                out.push(bytes[index])
                index += 1
                next
            }
            after: Int{bytes[index + 1]}
            index += 2
            value := -1
            if after == 110 {
                value = 10
            } else if after == 116 {
                value = 9
            } else if after == 114 {
                value = 13
            } else if after == 34 || after == 92 {
                value = after
            } else if after == 120 && index + 1 < bytes.len() && hex_digit(Int{bytes[index]}) >= 0 && hex_digit(Int{bytes[index + 1]}) >= 0 {
                value = hex_digit(Int{bytes[index]}) * 16 + hex_digit(Int{bytes[index + 1]})
                index += 2
            } else if after >= 48 && after <= 55 {
                value = after - 48
                digits := 1
                loop digits < 3 && index < bytes.len() && (Int{bytes[index]}) >= 48 && (Int{bytes[index]}) <= 55 {
                    value = value * 8 + Int{bytes[index]} - 48
                    index += 1
                    digits += 1
                }
            }
            if value >= 0 && value <= 255 {
                out.push(checked(U8{value}) ?? bytes[index - 1])
            } else {
                out.push(bytes[index - 2])
                out.push(bytes[index - 1])
            }
        }
        index += 1
        found.push(String.from_bytes(out) ?? "")
    }
    found
}

// The files that hold the report rows themselves, and the one renderer that
// turns a row into report text. Report text written anywhere else is a copy.
REPORT_HOMES: [String]{SOURCE_PATH, ROWS_PATH, "Compiler/JetFoundation/Source/Diagnostics/Render.jet"}
// The source trees whose programs print reports.
REPORT_ROOTS: [String]{"Compiler", "Core", "Jetpack"}
// A report heading that names a code or type, the way a hand-built report
// writes it: `Error [E0102]`, `Stop [{code}]`, `warning [jet.Name]`, or a
// literal that ends at the bracket for a `+` to finish.
REPORT_HEADING: Regex{"(?:Error|Warning|Stop|error|warning) ?\[(?:\x7B|jet\.|[A-Z][A-Z]?[0-9][0-9][0-9][0-9]|$)"}
REPORT_LINK: "jet-lang.dev/e/"
// A copied report's heading code and its More link's code.
COPY_HEADING: Regex{"\[([A-Z][A-Z]?[0-9][0-9][0-9][0-9])\]: "}
COPY_LINK: Regex{"More: jet-lang\.dev/e/([A-Z][A-Z]?[0-9][0-9][0-9][0-9])"}

// What the report-site check read and found. `code_sites` maps a code to
// the `path:line` that best shows where the compiler reports it, and
// `site_ranks` to that line's site_rank.
ReportSites: struct {
    files: Int
    copies: Int
    problems: [String]
    code_sites: [String:String]
    site_ranks: [String:Int]
}

// The `.jet` and `.S` files under `directory`, outside test, fixture and
// hidden directories and the test kit (JetTestKit matches the reports a
// compiler under test prints; it builds none), each directory's entries sorted
// by name.
report_sources: fn(directory: String) -[FS]> [String] DiagnosticRowsError! {
    children := files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    children.sort_by(fn(child) { child.name })
    found := [String]{}
    loop child in children {
        if child.is_dir {
            skipped: child.name.starts_with(".") || child.name == "Tests" || child.name == "tests" || child.name == "Fixtures" || child.name == "fixtures" || child.name.ends_with(".fixture") || child.name == "JetTestKit"
            if skipped -> next
            loop path in (report_sources(child.path) ?? return Err(err)) -> found.push(path)
        } else if child.name.ends_with(".jet") || child.name.ends_with(".S") {
            found.push(child.path.copy())
        }
    }
    Ok(found)
}

row_for: fn(rows: [RowFacts], code: String) -> RowFacts? Never! {
    loop row in rows {
        if row.code == code -> return Val(row)
    }
    None
}

// `text` after the first `marker`, or "" when it has none.
text_after: fn(text: String, marker: String) -> String Never! {
    at: text.find(marker)
    if at < 0 -> return ""
    String.from_bytes(text.bytes().slice(at + marker.bytes().len(), text.bytes().len())) ?? ""
}

// `text` before the first `marker`, or all of it when it has none.
text_before: fn(text: String, marker: String) -> String Never! {
    at: text.find(marker)
    if at < 0 -> return text.copy()
    String.from_bytes(text.bytes().slice(0, at)) ?? ""
}

// The problems in one literal of a generated or assembly copy of a runtime
// report, which cannot reach the registry while it runs. A heading's text
// must agree with its row's What up to the What's first hole, and the Why and
// Fix before a More link must be that row's own.
copy_problems: fn(rows: [RowFacts], text: String, at: String) -> [String] Never! {
    problems := [String]{}
    loop heading in COPY_HEADING.matches(text) {
        code: heading.groups[0]
        row: row_for(rows, code) ?? {
            problems.push("{at}: `[{code}]` names no diagnostic row")
            next
        }
        stem: text_before(row.what, "{{")
        // A What that writes its own heading (`Runtime fault [R0801]: …`) is
        // copied whole, heading and all.
        if stem.contains("[{code}]: ") {
            if !text.contains(stem) -> problems.push("{at}: the {code} What `{text.replace("\n", "\\n")}` is not its row's What `{row.what}`")
            next
        }
        shown: text_before(text_after(text, "[{code}]: "), "\n")
        if !shown.starts_with(stem) && !stem.starts_with(shown) -> problems.push("{at}: the {code} heading `{shown}` is not its row's What `{row.what}`")
    }
    loop link in COPY_LINK.matches(text) {
        code: link.groups[0]
        row: row_for(rows, code) ?? {
            problems.push("{at}: `More: {REPORT_LINK}{code}` names no diagnostic row")
            next
        }
        parts: text_before(text, link.text).split(" Fix: ").to_list()
        if parts.len() < 2 -> next
        fix: parts[parts.len() - 1].remove_suffix("\n")
        if fix != row.fix -> problems.push("{at}: the {code} Fix `{fix}` is not its row's Fix `{row.fix}`")
        if !parts[parts.len() - 2].contains(" Why: ") -> next
        whys: parts[parts.len() - 2].split(" Why: ").to_list()
        why: whys[whys.len() - 1].remove_suffix("\n")
        if why != row.why -> problems.push("{at}: the {code} Why `{why}` is not its row's Why `{row.why}`")
    }
    problems
}

// The report problems in one source file: a hand-written file may not build
// report text, and a generated or assembly copy must match its rows.
file_report_problems: fn(rows: [RowFacts], path: String, text: String) -> ReportSites Never! {
    lines: text.split("\n").to_list()
    assembly: path.ends_with(".S")
    copied: assembly || (lines.len() > 0 && lines[0].lower().contains("generated by"))
    found := ReportSites{files: 1, copies: 0, problems: [String]{}, code_sites: [String:String]{}, site_ranks: [String:Int]{}}
    loop (index, line) in lines {
        loop literal in line_literals(line, !assembly) {
            at: "{path}:{index + 1}"
            if copied {
                named: COPY_HEADING.is_match(literal) || COPY_LINK.is_match(literal)
                if named -> found.copies += 1
                // A copy is checked by its code, so a `generated by` line
                // cannot excuse a heading or link that names none.
                if !named && (REPORT_HEADING.is_match(literal) || literal.contains(REPORT_LINK)) -> found.problems.push("{at}: generated report text `{literal.replace("\n", "\\n")}` names no code, so no row can check it; spell the row's code")
                loop problem in copy_problems(rows, literal, at) -> found.problems.push(problem)
            } else if REPORT_HEADING.is_match(literal) || literal.contains(REPORT_LINK) {
                found.problems.push("{at}: hand-built report text `{literal.replace("\n", "\\n")}`; build its Diagnostic and render it with diagnostic_render")
            }
        }
    }
    found
}

// Every source file a report may be printed from, checked against the rows,
// and the line that best shows where each quoted code is reported.
report_sites: fn(rows: [RowFacts]) -[FS]> ReportSites DiagnosticRowsError! {
    sites := ReportSites{files: 0, copies: 0, problems: [String]{}, code_sites: [String:String]{}, site_ranks: [String:Int]{}}
    loop root in REPORT_ROOTS {
        loop path in (report_sources(root) ?? return Err(err)) {
            if REPORT_HOMES.contains(path) -> next
            text: files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
            one: file_report_problems(rows, path, text)
            sites.files += 1
            sites.copies += one.copies
            loop problem in one.problems -> sites.problems.push(problem)
            if !QUOTED_CODE.is_match(text) -> next
            loop (index, line) in text.split("\n").to_list() {
                loop quoted in QUOTED_CODE.matches(line) {
                    code: quoted.groups[0]
                    rank: site_rank(path, line, code)
                    if (sites.site_ranks.get(code) ?? 4) <= rank -> next
                    sites.site_ranks[code.copy()] = rank
                    sites.code_sites[code.copy()] = "{path}:{index + 1}"
                }
            }
        }
    }
    Ok(sites)
}

// How well a line that quotes `code` shows where the compiler reports it:
// 0, a sema call that passes the code first; 1, such a call elsewhere; 2,
// another sema line; 3, any other line. The first line of the lowest rank wins.
site_rank: fn(path: String, line: String, code: String) -> Int Never! {
    called: line.contains("(\"{code}\"")
    sema: path.starts_with(SEMA_ROOT)
    if called && sema -> return 0
    if called -> return 1
    if sema -> return 2
    3
}

// The active rows no source line reports and `listed` does not exempt, and
// the listed codes that no longer need it: one a line reports, or one that
// names no active row. `listed` may hold no more than `ceiling` codes.
unreported_problems: fn(facts: [RowFacts], sites: ReportSites, listed: [String], ceiling: Int) -> [String] Never! {
    problems := [String]{}
    if listed.len() > ceiling -> problems.push("UNREPORTED_CODES holds {listed.len()} codes, more than its ceiling of {ceiling}; the list only shrinks")
    active := [String]{}
    loop row in facts {
        if !row.active -> next
        active.push(row.code.copy()) // copy: the row keeps its code
        if sites.code_sites.get(row.code) != None || listed.contains(row.code) -> next
        problems.push("{row.code} ({row.name}) is an active row that no line under {REPORT_ROOTS.join(", ")} reports; add the check that reports it, or retire the row")
    }
    loop code in listed {
        if !active.contains(code) {
            problems.push("{code} is in UNREPORTED_CODES but names no active row; remove it from the list")
        } else if sites.code_sites.get(code) == .Val(site) {
            problems.push("{code} is in UNREPORTED_CODES but {site} reports it; remove it from the list")
        }
    }
    problems
}

// A table cell: a `|` would end it.
audit_cell: fn(text: String) -> String Never! { text.replace("|", "\\|") }

// The safety audit the rows give: every classified active error row, the
// soundness rows an expert opt-in lifts, and the sealed floors, each floor
// with the first place the compiler reports it.
render_audit: fn(facts: [RowFacts], sites: ReportSites) -> String Never! {
    soundness := 0
    opinion := 0
    pending := 0
    floors := [String]{}
    unreported := [String]{}
    lifted := [String]{}
    classified := [String]{}
    loop row in facts {
        if !row.active || !row.error -> next
        if row.safety_class == "" {
            pending += 1
            next
        }
        type_name: row.name.remove_prefix(NAME_PATH)
        classified.push("| {row.code} | {type_name} | {row.safety_class.lower()} | {audit_cell(row.safety_reason)} |")
        if row.safety_class == "Opinion" {
            opinion += 1
            next
        }
        soundness += 1
        if !row.expert_path.starts_with("none: ") {
            lifted.push("| {row.code} | {type_name} | {audit_cell(row.expert_path)} |")
            next
        }
        reason: audit_cell(row.expert_path.remove_prefix("none: "))
        site: sites.code_sites.get(row.code) ?? {
            unreported.push("| {row.code} | {type_name} | {reason} |")
            next
        }
        floors.push("| {row.code} | {type_name} | {site} | {reason} |")
    }
    floors.sort()
    unreported.sort()
    lifted.sort()
    classified.sort()
    ranges := [String]{}
    loop range in SAFETY_RANGES -> ranges.push("{range}xx")
    [String]{
        "# Diagnostic safety audit",
        "",
        "<!-- Generated by Tools/agent/DiagnosticRows.jet from {SOURCE_PATH}; do not edit. -->",
        "",
        "An error refuses a program for one of two reasons. A soundness error stops a memory, type, aliasing or resource fault, or the loss of a guarantee such as a capability or what a reviewer reads. An opinion error refuses a program that would run safely, for clarity or style. A reason that begins `Finding:` records a row whose code or name does not match one meaning.",
        "",
        "Each row states its class in `safety_class` and why in `safety_reason`. A soundness row also states its `expert_path`: the opt-in that reaches the same program, or `none:` and why nothing can.",
        "",
        "Classified ranges: {ranges.join(", ")}. They hold {soundness + opinion} active error rows: {soundness} soundness and {opinion} opinion. The other ranges hold {pending} active error rows with no class yet.",
        "",
        "## Sealed floors",
        "",
        "A sealed floor is a soundness error that no `#Unsafe` block or other opt-in lifts. Its site is the first compiler call that passes the code to a report, in sema when sema has one. A code no call passes shows the first line that quotes it: whole, at the head of a message, or in a runtime report's brackets.",
        "",
        "| Code | Type | Reported at | Why no expert path reaches the program |",
        "|---|---|---|---|",
        floors.join("\n"),
        "",
        "## Sealed floors no source reports",
        "",
        "These soundness rows have no expert path, but no line under {REPORT_ROOTS.join(", ")} passes or quotes their code, so no program meets them today: they are the `UNREPORTED_CODES` of Tools/agent/DiagnosticRows.jet, a list that only shrinks. Each becomes a sealed floor once a report site names it, or is retired.",
        "",
        "| Code | Type | Why no expert path reaches the program |",
        "|---|---|---|",
        unreported.join("\n"),
        "",
        "## Soundness errors an expert can lift",
        "",
        "| Code | Type | Expert path |",
        "|---|---|---|",
        lifted.join("\n"),
        "",
        "## Every classified row",
        "",
        "| Code | Type | Class | Reason |",
        "|---|---|---|---|",
        classified.join("\n"),
        "",
    }.join("\n")
}

// The committed safety audit's path, or "" when there is none.
committed_audit: fn() -[FS]> String DiagnosticRowsError! {
    found := ""
    loop child in (files.list_dir(AUDIT_DIR) ?? return Err(rows_fail("cannot list {AUDIT_DIR}: {err}"))) {
        if child.is_dir || !child.name.ends_with(AUDIT_NAME) -> next
        if found != "" -> return Err(rows_fail("two safety audits, {found} and {child.path}; remove the older"))
        found = child.path.copy()
    }
    Ok(found)
}

// What the spec-citation check read and found.
SpecCitations: struct {
    pages: Int
    cited: Int
    problems: [String]
}

// Whether `byte` can continue a word: an ASCII letter, digit or `_`.
word_byte: fn(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// The diagnostic codes one line cites: an `E` or `L` and four digits, as a
// whole word. A `#L1234` link anchor names a line, not a code.
cited_codes: fn(line: String) -> [String] Never! {
    bytes: line.bytes()
    found := [String]{}
    loop (index, byte) in bytes {
        head: Int{byte}
        if (head != 69 && head != 76) || index + 5 > bytes.len() -> next
        if index > 0 && (word_byte(Int{bytes[index - 1]}) || Int{bytes[index - 1]} == 35) -> next
        if index + 5 < bytes.len() && word_byte(Int{bytes[index + 5]}) -> next
        digits := true
        loop at in (index + 1)..<(index + 5) {
            digit: Int{bytes[at]}
            if digit < 48 || digit > 57 -> digits = false
        }
        if digits -> found.push(String.from_bytes(bytes.slice(index, index + 5)) ?? "")
    }
    found
}

// The `.md` files under `directory`, each directory's entries sorted by name.
spec_pages: fn(directory: String) -[FS]> [String] DiagnosticRowsError! {
    children := files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    children.sort_by(fn(child) { child.name })
    found := [String]{}
    loop child in children {
        if child.name.starts_with(".") -> next
        if child.is_dir {
            loop path in (spec_pages(child.path) ?? return Err(err)) -> found.push(path)
        } else if child.name.ends_with(".md") {
            found.push(child.path.copy())
        }
    }
    Ok(found)
}

// The codes one page cites, and each that names no row as `path:line`.
page_citations: fn(known: [String:Bool], path: String, text: String) -> SpecCitations Never! {
    found := SpecCitations{pages: 1, cited: 0, problems: [String]{}}
    loop (index, line) in text.split("\n").to_list() {
        loop code in cited_codes(line) {
            found.cited += 1
            if known.get(code) == None -> found.problems.push("{path}:{index + 1}: {code} names no diagnostic row; cite the code the compiler reports, or describe the rule without one")
        }
    }
    found
}

// Every spec page's cited codes, checked against the rows.
spec_citations: fn(rows: [RowFacts]) -[FS]> SpecCitations DiagnosticRowsError! {
    known := [String:Bool]{}
    loop row in rows -> known[row.code] = true
    found := SpecCitations{pages: 0, cited: 0, problems: [String]{}}
    loop path in (spec_pages(SPEC_DIR) ?? return Err(err)) {
        text: files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
        one: page_citations(known, path, text)
        found.pages += 1
        found.cited += one.cited
        loop problem in one.problems -> found.problems.push(problem)
    }
    Ok(found)
}

diagnostic_rows_main: fn(args: [String]) -[FS, Time]> String DiagnosticRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: DiagnosticRows.jet [--check|--write]"))
    source: files.read(SOURCE_PATH) ?? return Err(rows_fail("cannot read {SOURCE_PATH}: {err}"))
    rows: render_rows(source) ?? return Err(err)
    letter: letter_law_problems(rows.facts, LETTER_LAW_EXCEPTIONS)
    if letter.len() > 0 -> return Err(rows_fail("{letter.len()} codes break the letter law of Docs/spec/diagnostics.md:\n{letter.join("\n")}"))
    generated: generated_files(rows) ?? return Err(err)
    stale: stale_pages(generated) ?? return Err(err)
    sites: report_sites(rows.facts) ?? return Err(err)
    sites_failure: "{sites.problems.len()} report sites do not render through their rows:\n{sites.problems.join("\n")}"
    unreported: unreported_problems(rows.facts, sites, UNREPORTED_CODES, UNREPORTED_CEILING)
    unreported_failure: "{unreported.len()} active rows or listed codes break the report-site rule:\n{unreported.join("\n")}"
    citations: spec_citations(rows.facts) ?? return Err(err)
    citations_failure: "{citations.problems.len()} spec citations name no diagnostic row:\n{citations.problems.join("\n")}"
    differing := [String]{}
    loop file in generated {
        current: if files.exists(file.path) -> files.read(file.path) ?? return Err(rows_fail("cannot read {file.path}: {err}")) else -> ""
        if current == file.text -> next
        differing.push(file.path.copy())
        if mode != "--write" -> next
        if file.path.starts_with("{PAGES_DIR}/") -> files.create_dir_all(file.path.remove_suffix("/index.html")) ?? return Err(rows_fail("cannot create the directory of {file.path}: {err}"))
        files.write(file.path, file.text) ?? return Err(rows_fail("cannot write {file.path}: {err}"))
    }
    audit: render_audit(rows.facts, sites)
    audit_at: committed_audit() ?? return Err(err)
    audit_current: if audit_at == "" -> "" else -> files.read(audit_at) ?? return Err(rows_fail("cannot read {audit_at}: {err}"))
    audit_differs: audit_current != audit
    if audit_differs -> differing.push(if audit_at == "" -> "{AUDIT_DIR}/<date>{AUDIT_NAME}" else -> audit_at.copy())
    if mode == "--write" {
        if audit_differs {
            dated: "{AUDIT_DIR}/{time.isoformat_date(time.today())}{AUDIT_NAME}"
            files.write(dated, audit) ?? return Err(rows_fail("cannot write {dated}: {err}"))
            if audit_at != "" && audit_at != dated -> files.remove(audit_at) ?? return Err(rows_fail("cannot remove {audit_at}: {err}"))
        }
        loop path in stale -> files.remove(path) ?? return Err(rows_fail("cannot remove {path}: {err}"))
        written := [String]{}
        if sites.problems.len() > 0 -> written.push(sites_failure)
        if unreported.len() > 0 -> written.push(unreported_failure)
        if citations.problems.len() > 0 -> written.push(citations_failure)
        if written.len() > 0 -> return Err(rows_fail(written.join("\n")))
        return Ok("diagnostic copies written: {differing.len()} rewritten, {stale.len()} stale pages removed, {generated.len() + 1} in all")
    }
    loop path in stale -> differing.push("{path} (no diagnostic row owns this page)")
    failures := [String]{}
    if differing.len() > 0 {
        first := [String]{}
        loop path in differing {
            if first.len() == 10 -> break
            first.push(path.copy())
        }
        failures.push("{differing.len()} copies differ from {SOURCE_PATH}; run jet Tools/agent/DiagnosticRows.jet --write. First: {first.join(", ")}")
    }
    if sites.problems.len() > 0 -> failures.push(sites_failure)
    if unreported.len() > 0 -> failures.push(unreported_failure)
    if citations.problems.len() > 0 -> failures.push(citations_failure)
    if failures.len() > 0 -> return Err(rows_fail(failures.join("\n")))
    Ok("diagnostic rows check passed: {generated.len() + 1} copies match, the safety audit among them; {sites.files} source files read, none builds a report by hand, {sites.copies} runtime report copies match their rows, every active row but the {UNREPORTED_CODES.len()} listed unreported has a report site, and {citations.cited} codes cited in {citations.pages} spec pages each name a row")
}

run: fn() { print(diagnostic_rows_main(process.args()) ?? process.fail(1, err.message)) }

// The error text render_rows reports for `source`, or "" when it accepts it.
diagnostic_rows_error: fn(source: String) -> String Never! {
    if render_rows(source) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

// The error text render_baseline reports for `source`'s rows over the
// committed baseline `committed`, or "" when it accepts them.
baseline_error: fn(source: String, committed: String) -> String Never! {
    rows: render_rows(source) ?? return err.message
    if render_baseline(rows.facts, committed) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

MINIMAL_ROW: "BadPath: struct {{\n    path: String\n\n    impl Diagnostic {{\n        code: \"E9999\"\n        meaning: \"A route that doesn't start at the root\"\n        what: fn(self) -> String {{ \"route `{{self.path}}` must start with /\" }}\n        why: fn(self) -> String {{ \"routes are matched from the \\\"site\\\" root\" }}\n        fix: fn(self) -> String {{ \"write {{{{/path}}}}\" }}\n    }}\n}}\n"
MINIMAL_CODE: "        code: \"E9999\"\n"
MINIMAL_MEANING: "        meaning: \"A route that doesn't start at the root\"\n"

#Test("every generated copy matches its Prelude row") {
    if diagnostic_rows_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("a diagnostic type that breaks the source rules is refused") {
    row: MINIMAL_ROW
    code: MINIMAL_CODE
    rendered: (render_rows(row) ?? panic("the minimal row did not render: {err.message}")).text
    assert(rendered.contains("what: \"route `{{{{path}}}}` must start with /\","))
    assert(rendered.contains("fix: \"write {{{{/path}}}}\","))
    assert(rendered.contains("no_fix_reason: Val(DiagnosticNoFixReason{{kind: DiagnosticNoFixReasonKind.Design, next: \"write {{{{/path}}}}\"}}),"))
    assert(diagnostic_rows_error(row.replace("self.path", "self.route")).contains("reads no field"))
    assert(diagnostic_rows_error(row.replace("{{self.path}}", "{{path}}")).contains("other than a `self` field"))
    assert(diagnostic_rows_error(row.replace(code, "")).contains("states its `code`"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        severity: .Lint\n")).contains("needs a `lint_name`"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        severity: .Lint\n        status: .Retired\n")) == "")
    assert(diagnostic_rows_error(row.replace(code, "{code}        severity: .Warning\n")).contains("`.Error` or `.Lint`"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        colour: .Red\n")).contains("unknown constant"))
    assert(diagnostic_rows_error(row.replace("    }}\n}}\n", "    }}\n    extra: fn() {{}}\n}}\n")).contains("last member"))
    assert(diagnostic_rows_error(row.replace("    path: String\n\n", "")).contains("reads no field"))
    assert(diagnostic_rows_error("{row}{row}").contains("used twice"))
    assert(diagnostic_rows_error(row.replace("site", "si\\qte")).contains("backslash escape"))
}

#Test("a placeholder Why or a decision ID in a row's text is refused, naming every code") {
    row: MINIMAL_ROW
    placeholder: row.replace("routes are matched from the \\\"site\\\" root", "The registered sema rule applies here").replace("must start with /", "must start with / (S12)")
    decision: row.replace("doesn't start at the root\"", "doesn't start at the root (S9)\"").replace("E9999", "E9998").replace("write {{{{/path}}}}", "see D-ROUTE-1")
    error: diagnostic_rows_error("{placeholder}{decision}")
    assert(error.contains("4 row texts break the plain-words rubric"))
    assert(error.contains("E9999 why is a placeholder"))
    assert(error.contains("E9999 what names decision S12"))
    assert(error.contains("E9998 meaning names decision S9"))
    assert(error.contains("E9998 fix names decision D-ROUTE-1"))
    assert_eq(diagnostic_rows_error(row.replace("start with /", "start with /S")), "")
}

#Test("an active row with no written meaning, or one that repeats its What, is refused, naming every code") {
    row: MINIMAL_ROW
    missing: row.replace(MINIMAL_MEANING, "")
    repeated: row.replace(MINIMAL_MEANING, "        meaning: \"route `x` must start with /\"\n").replace("E9999", "E9998").replace("{{self.path}}", "x").replace("    path: String\n\n", "")
    error: diagnostic_rows_error("{missing}{repeated}")
    assert(error.contains("2 row texts break the plain-words rubric"), error)
    assert(error.contains("E9999 states no meaning"), error)
    assert(error.contains("E9998 meaning repeats its what"), error)
    statuses: [String]{"Retired", "Reserved"}
    loop status in statuses {
        assert_eq(diagnostic_rows_error(missing.replace(MINIMAL_CODE, "{MINIMAL_CODE}        status: .{status}\n")), "")
    }
}

#Test("an active row whose Fix is the placeholder is refused; a retired or reserved row may keep it") {
    placeholder: MINIMAL_ROW.replace("write {{{{/path}}}}", "Follow the guidance for E9999")
    error: diagnostic_rows_error(placeholder)
    assert(error.contains("1 row texts break the plain-words rubric"), error)
    assert(error.contains("E9999 fix is a placeholder"), error)
    statuses: [String]{"Retired", "Reserved"}
    loop status in statuses {
        assert_eq(diagnostic_rows_error(placeholder.replace(MINIMAL_CODE, "{MINIMAL_CODE}        status: .{status}\n")), "")
    }
}

#Test("every Prelude row's Why gives a reason, every active row's Fix is a step, and no human text names a decision ID") {
    source: files.read(SOURCE_PATH) ?? panic("cannot read {SOURCE_PATH}: {err}")
    rows: render_rows(source) ?? panic(err.message)
    assert(rows.facts.len() > 0)
}

#Test("a code's letter follows its severity, and the frozen exceptions only shrink") {
    lint_code: "{MINIMAL_CODE}        severity: .Lint\n        lint_name: \"bad_path\"\n"
    blocking: (render_rows(MINIMAL_ROW) ?? panic(err.message)).facts
    loose_source: MINIMAL_ROW.replace(MINIMAL_CODE, lint_code.replace("E9999", "L9998")).replace("BadPath:", "LooseBadPath:")
    both: (render_rows("{MINIMAL_ROW}{loose_source}") ?? panic(err.message)).facts
    assert_eq(letter_law_problems(both, [String]{}), [String]{})
    e_lint: (render_rows(MINIMAL_ROW.replace(MINIMAL_CODE, lint_code)) ?? panic(err.message)).facts
    assert_eq(letter_law_problems(e_lint, [String]{}), [String]{"E9999 is a lint, so its code takes the letter `L`"})
    assert_eq(letter_law_problems(e_lint, [String]{"E9999"}), [String]{})
    l_blocking: (render_rows(MINIMAL_ROW.replace("E9999", "L9999")) ?? panic(err.message)).facts
    assert_eq(letter_law_problems(l_blocking, [String]{}), [String]{"L9999 is not a lint, so its code can't take the letter `L`"})
    assert_eq(letter_law_problems(blocking, [String]{"E9999"}), [String]{"E9999 is in LETTER_LAW_EXCEPTIONS but no row breaks the letter law under it; remove it from the list"})
    assert_eq(letter_law_problems(blocking, [String]{"E8888"}), [String]{"E8888 is in LETTER_LAW_EXCEPTIONS but no row breaks the letter law under it; remove it from the list"})
}

#Test("the Prelude rows keep the letter law with exactly the frozen exceptions") {
