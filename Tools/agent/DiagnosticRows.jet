}

#Test("a structured fix renders as its registry fix") {
    row: MINIMAL_ROW
    code: MINIMAL_CODE
    replace: (render_rows(row.replace(code, "{code}        structured_fix: .Replace{{from: \"=\", to: \":\"}}\n        no_fix: None\n")) ?? panic(err.message)).text
    assert(replace.contains("structured_fix: Val(DiagnosticRegistryFix.Replace{{from: \"=\", to: \":\"}}),"))
    remove: (render_rows(row.replace(code, "{code}        structured_fix: .Remove{{text: \",\"}}\n        no_fix: None\n")) ?? panic(err.message)).text
    assert(remove.contains("structured_fix: Val(DiagnosticRegistryFix.Remove{{text: \",\"}}),"))
    plain: (render_rows(row.replace(code, "{code}        structured_fix: .SourceEdit\n        no_fix: None\n")) ?? panic(err.message)).text
    assert(plain.contains("structured_fix: Val(DiagnosticRegistryFix.SourceEdit),"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        structured_fix: .Replace\n")).contains("is written `.Replace{{from:"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        structured_fix: .Remove\n")).contains("is written `.Remove{{text:"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        edit: .SourceEdit\n")).contains("unknown constant"))
}

#Test("only an active row has a stage") {
    row: MINIMAL_ROW
    code: MINIMAL_CODE
    active: (render_rows(row.replace(code, "{code}        stage: [.Parse, .Sema]\n")) ?? panic(err.message)).text
    assert(active.contains("        stage: \"parse/sema\","))
    assert((render_rows(row) ?? panic(err.message)).text.contains("        stage: \"sema\","))
    statuses: [String]{"Retired", "Reserved"}
    loop status in statuses {
        inactive: (render_rows(row.replace(code, "{code}        status: .{status}\n")) ?? panic(err.message)).text
        assert(inactive.contains("        stage: \"\","))
        staged: row.replace(code, "{code}        status: .{status}\n        stage: [.Sema]\n")
        assert(diagnostic_rows_error(staged).contains("a `.{status}` row runs in no stage"))
    }
}

#Test("an active error row in a classified range states its safety class, and the audit lists it") {
    row: MINIMAL_ROW.replace("E9999", "E0299")
    code: "        code: \"E0299\"\n"
    unclassified: diagnostic_rows_error(row)
    assert(unclassified.contains("is an active error row in a classified range"), unclassified)
    opinion: "{code}        safety_class: .Opinion\n        safety_reason: \"it would run safely\"\n"
    assert(diagnostic_rows_error(row.replace(code, opinion)) == "")
    assert(diagnostic_rows_error(row.replace(code, "{code}        safety_class: .Opinion\n")).contains("come together"))
    assert(diagnostic_rows_error(row.replace(code, "{opinion}        expert_path: \"an `#Unsafe` block\"\n")).contains("only one, states its `expert_path`"))
    sound: "{code}        safety_class: .Soundness\n        safety_reason: \"a | b\"\n"
    assert(diagnostic_rows_error(row.replace(code, sound)).contains("only one, states its `expert_path`"))
    assert(diagnostic_rows_error(row.replace(code, "{code}        safety_class: .Maybe\n        safety_reason: \"x\"\n")).contains("`.Soundness` or `.Opinion`"))
    assert(diagnostic_rows_error(row.replace(code, "{opinion}        status: .Retired\n")).contains("only an active `.Error` row"))
    sites := ReportSites{files: 0, copies: 0, problems: [String]{}, code_sites: [String:String]{}, site_ranks: [String:Int]{}}
    floor: (render_rows(row.replace(code, "{sound}        expert_path: \"none: nothing reaches it\"\n")) ?? panic(err.message)).facts
    assert(render_audit(floor, sites).contains("| E0299 | BadPath | nothing reaches it |"))
    sites.code_sites["E0299"] = "Compiler/JetSema/b.jet:7"
    audit: render_audit(floor, sites)
    assert(audit.contains("| E0299 | BadPath | Compiler/JetSema/b.jet:7 | nothing reaches it |"))
    assert(!audit.contains("| E0299 | BadPath | nothing reaches it |"))
    assert_eq(site_rank("Compiler/JetSema/b.jet", "    sema_error(\"E0299\", span)", "E0299"), 0)
    assert_eq(site_rank("Compiler/JetParser/a.jet", "    parse_error(\"E0299\", span)", "E0299"), 1)
    assert_eq(site_rank("Compiler/JetSema/b.jet", "    codes: [\"E0298\", \"E0299\"]", "E0299"), 2)
    assert_eq(site_rank("Compiler/JetCli/c.jet", "    codes: [\"E0298\", \"E0299\"]", "E0299"), 3)
    quoted := [String]{}
    lines: [String]{"    sema_error(\"E-SUBJECT-CALL\", span)", "    push(rt_static_text(\"E2416: env var \"))", "    rt_static_text(\"Runtime fault [R0801]: raw\")", "    row(\"JT0198\")", "    lint(\"L0530\", span)", "    codes: [\"W0410\"]", "    x: \"Error\" + \"E-mail\""}
    loop line in lines {
        loop found in QUOTED_CODE.matches(line) -> quoted.push(found.groups[0].copy())
    }
    assert_eq(quoted.join(" "), "E-SUBJECT-CALL E2416 R0801 JT0198 L0530 W0410")
    assert(audit.contains("| E0299 | BadPath | soundness | a \\| b |"))
    lifted: (render_rows(row.replace(code, "{sound}        expert_path: \"an `#Unsafe` block\"\n")) ?? panic(err.message)).facts
    assert(render_audit(lifted, sites).contains("| E0299 | BadPath | an `#Unsafe` block |"))
    assert(render_audit((render_rows(row.replace("E0299", "E9999")) ?? panic(err.message)).facts, sites).contains("hold 1 active error rows with no class yet"))
}

#Test("an active row needs a report site, and the unreported codes only shrink") {
    facts: (render_rows(MINIMAL_ROW) ?? panic(err.message)).facts
    sites := ReportSites{files: 0, copies: 0, problems: [String]{}, code_sites: [String:String]{}, site_ranks: [String:Int]{}}
    assert_eq(unreported_problems(facts, sites, [String]{}, 0), [String]{"E9999 (jet.BadPath) is an active row that no line under Compiler, Core, Jetpack reports; add the check that reports it, or retire the row"})
    assert_eq(unreported_problems(facts, sites, [String]{"E9999"}, 1), [String]{})
    assert_eq(unreported_problems(facts, sites, [String]{"E9999"}, 0), [String]{"UNREPORTED_CODES holds 1 codes, more than its ceiling of 0; the list only shrinks"})
    assert_eq(unreported_problems(facts, sites, [String]{"E9999", "E8888"}, 2), [String]{"E8888 is in UNREPORTED_CODES but names no active row; remove it from the list"})
    retired: (render_rows(MINIMAL_ROW.replace(MINIMAL_CODE, "{MINIMAL_CODE}        status: .Retired\n")) ?? panic(err.message)).facts
    assert_eq(unreported_problems(retired, sites, [String]{}, 0), [String]{})
    sites.code_sites["E9999"] = "Compiler/JetSema/b.jet:7"
    assert_eq(unreported_problems(facts, sites, [String]{}, 0), [String]{})
    assert_eq(unreported_problems(facts, sites, [String]{"E9999"}, 1), [String]{"E9999 is in UNREPORTED_CODES but Compiler/JetSema/b.jet:7 reports it; remove it from the list"})
    assert(UNREPORTED_CODES.len() <= UNREPORTED_CEILING)
}

#Test("a literal reads as the program prints it") {
    assert_eq(line_literals("x \"a\\xe2\\x80\\x94b\" y \"c\\\\d\\n\"", false).join("|"), "a—b|c\\d\n")
    assert_eq(line_literals("t(\"{{{{x}}}} {{y}}\")", true).join("|"), "{{x}} {{y}}")
    assert_eq(line_literals("t(\"{{{{x}}}}\")", false).join("|"), "{{{{x}}}}")
}

#Test("only the renderer builds report text, and a runtime copy matches its row") {
    rows: (render_rows(MINIMAL_ROW.replace("E9999", "E3999")) ?? panic(err.message)).facts
    built: file_report_problems(rows, "a.jet", "f: fn() {{\n    x: \"Error [{{code}}]: {{what}}\"\n}}\n")
    assert_eq(built.problems.len(), 1)
    assert(built.problems[0].starts_with("a.jet:2: hand-built report text"), built.problems[0])
    assert_eq(file_report_problems(rows, "a.jet", "y: \"More: jet-lang.dev/e/E0001\"\n").problems.len(), 1)
    assert_eq(file_report_problems(rows, "a.jet", "y: \"Stop [jet.BadPath]: no\"\n").problems.len(), 1)
    assert_eq(file_report_problems(rows, "a.jet", "y: \"Warning [\" + code + \"]: no\"\n").problems.len(), 1)
    assert_eq(file_report_problems(rows, "a.jet", "// Error [E0001] in a comment\nz: \"no report here\"\n").problems.len(), 0)
    head: "a: fn() -> I64 {{ t(\"Stop [E3999]: route `\") }}"
    tail: "b: fn() -> I64 {{ t(\"` must start with /\\n Why: routes are matched from the \\\"site\\\" root\\n Fix: write {{{{/path}}}}\\nMore: jet-lang.dev/e/E3999\\n\") }}"
    generated: "// Generated by a generator; do not hand-edit.\n{head}\n{tail}\n"
    matched: file_report_problems(rows, "b.jet", generated)
    assert_eq(matched.problems.join("\n"), "")
    assert_eq(matched.copies, 2)
    assert(file_report_problems(rows, "b.jet", generated.replace("are matched", "are routed")).problems[0].contains("the E3999 Why"))
    assert(file_report_problems(rows, "b.jet", generated.replace("{{{{/path}}}}", "{{{{path}}}}")).problems[0].contains("the E3999 Fix"))
    assert(file_report_problems(rows, "b.jet", generated.replace("route `", "path `")).problems[0].contains("the E3999 heading"))
    assert(file_report_problems(rows, "b.jet", generated.replace("e/E3999", "e/E3998")).problems[0].contains("names no diagnostic row"))
    unnamed: file_report_problems(rows, "b.jet", "// Generated by a generator; do not hand-edit.\ny: \"Error [{{code}}]: {{what}}\"\n")
    assert(unnamed.problems.len() == 1 && unnamed.problems[0].contains("names no code"))
    assembly: "texts:\n    .asciz \"Stop [E3999]: route\"\n    .asciz \" Fix: write {{/path}}\\nMore: jet-lang.dev/e/E3999\\n\"\n"
    assert_eq(file_report_problems(rows, "c.S", assembly).problems.join("\n"), "")
    assert_eq(file_report_problems(rows, "c.S", assembly.replace("{{/path}}", "/path")).problems.len(), 1)
}

#Test("a spec page may cite only a code that has a row") {
    known := [String:Bool]{}
    known["E0107"] = true
    known["L0103"] = true
    assert_eq(cited_codes("E0107, `L0103` and (E0108); not XE0109, E01090, E010 or [line 12](#L1234)").join("|"), "E0107|L0103|E0108")
    assert_eq(cited_codes("E0107–E0109").join("|"), "E0107|E0109")
    page: page_citations(known, "Docs/spec/a.md", "intro\nan unknown name is E0107\nthe old rule was E0125, see [here](#L0125)\n")
    assert_eq(page.cited, 2)
    assert_eq(page.problems.len(), 1)
    assert(page.problems[0].starts_with("Docs/spec/a.md:3: E0125 names no diagnostic row"), page.problems[0])
}

#Test("a row's page shows its texts as a reader sees them") {
    facts: (render_rows(MINIMAL_ROW) ?? panic("the minimal row did not render: {err.message}")).facts[0]
    assert_eq(facts.name, "jet.BadPath")
    assert_eq(facts.what, "route `{{path}}` must start with /")
    assert_eq(facts.why, "routes are matched from the \"site\" root")
    assert_eq(facts.fix, "write {{/path}}")
    page: render_page(facts, None)
    assert(page.starts_with("{PAGE_GENERATED_BY}\n"))
    assert(page.contains("<p class=\"diag-copy what\" data-registry-field=\"what\">route `{{path}}` must start with /</p>"))
    assert(page.contains("<p class=\"diag-copy why\" data-registry-field=\"why\">routes are matched from the &quot;site&quot; root</p>"))
    assert(page.contains("<p>No UI snapshot currently mentions this code.</p>"))
    cited: render_page(facts, Val(TextFile{path: "tests/ui/a.stderr", text: "Error [jet.BadPath]: <x>"}))
    assert(cited.contains("<code>tests/ui/a.stderr</code>.</p>\n<pre class=\"diag\">Error [jet.BadPath]: &lt;x&gt;</pre>"))
}

#Test("a page cites the first snapshot that names its row") {
    snapshots: [TextFile]{
        TextFile{path: "a", text: "Error [jet.Foo]: one\n"},
        TextFile{path: "b", text: "[jet.Foo] [jet.[jet.Bar] [jet.Baz"},
    }
    first: first_snapshots(snapshots)
    assert(first.get("jet.Foo") == Val(0))
    assert(first.get("jet.Bar") == Val(1))
    assert(first.get("jet.Baz") == None)
}

#Test("a page's example comes only from the snapshots the ui suite runs") {
    root: files.mkdtemp("diagnostic-rows-") ?? panic("scratch: {err}")
    directories: [String]{"tests/ui/g", "tests/ui/p", "tests/ui/w", "tests/ui/.jet/build", "tests/ui_lint"}
    loop directory in directories -> files.create_dir_all("{root}/{directory}") ?? panic("{directory}: {err}")
    written: [String]{
        "tests/ui/a.jet", "tests/ui/a.stderr", "tests/ui/a.fixed.jet", "tests/ui/stray.stderr",
        "tests/ui/mod.stderr", "tests/ui/g/nested.jet", "tests/ui/g/nested.stderr",
        "tests/ui/p/run.jet", "tests/ui/p/stderr", "tests/ui/p/extra.stderr",
        "tests/ui/w/workspace.jet", "tests/ui/w.stderr", "tests/ui/.jet/build/x.stderr",
        "tests/ui_lint/l.jet", "tests/ui_lint/l.warn", "tests/ui_lint/l.stderr",
    }
    loop path in written -> files.write("{root}/{path}", "Error [jet.Foo]: {path}\n") ?? panic("{path}: {err}")
    files.write("{root}/tests/ui/mod.jet", "// @fixture_module\nhelper: fn() {{}}\n") ?? panic("mod.jet: {err}")
    ui: (ui_snapshots(root, "tests/ui", false) ?? panic(err.message)).map(fn(file) { file.path })
    assert_eq(ui, [String]{"tests/ui/a.stderr", "tests/ui/g/nested.stderr", "tests/ui/p/stderr", "tests/ui/w.stderr"})
    lint: (ui_snapshots(root, "tests/ui_lint", true) ?? panic(err.message)).map(fn(file) { file.path })
    assert_eq(lint, [String]{"tests/ui_lint/l.warn"})
    assert_eq((ui_snapshots(root, "tests/absent", false) ?? panic(err.message)).len(), 0)
    files.create_dir_all("{root}/tests/cases/s/c.fixture") ?? panic("case dir: {err}")
    planted: [String]{"tests/cases/s/c.case", "tests/cases/s/c.warn", "tests/cases/s/c.fixture/c.warn"}
    loop path in planted -> files.write("{root}/{path}", "Warning [jet.Foo]: {path}\n") ?? panic("{path}: {err}")
    cases: (case_snapshots(root, "tests/cases/s") ?? panic(err.message)).map(fn(file) { file.path })
    assert_eq(cases, [String]{"tests/cases/s/c.warn"})
    files.remove_all(root) ?? panic("remove scratch: {err}")
}

