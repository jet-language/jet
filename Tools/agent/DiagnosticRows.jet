}

#Test("the coverage baseline counts each plane and never gains an uncovered row") {
    header: BASELINE_HEADER
    assert_eq(baseline_error(MINIMAL_ROW, ""), "")
    rows: render_rows(MINIMAL_ROW) ?? panic("the minimal row did not render: {err.message}")
    assert_eq(render_baseline(rows.facts, "") ?? panic(err.message), "{header}sema 0 1 1\n")
    uncovered: MINIMAL_ROW.replace(MINIMAL_CODE, "{MINIMAL_CODE}        no_fix: None\n")
    assert(baseline_error(uncovered, "").contains("up from 0"))
    assert(baseline_error(uncovered, "{header}sema 0 0 1\n") == "")
    retired: uncovered.replace(MINIMAL_CODE, "{MINIMAL_CODE}        status: .Retired\n")
    assert(baseline_error(retired, "") == "")
    both: MINIMAL_ROW.replace(MINIMAL_CODE, "{MINIMAL_CODE}        structured_fix: .Remove{{text: \"x\"}}\n")
    assert(baseline_error(both, "").contains("not both"))
    assert(baseline_error(MINIMAL_ROW, "sema 0 1\n").contains("unparsed line"))
}

#Test("the coverage allowlist lists each uncovered code and never gains one") {
    codes := [String]{}
    source_codes("x: \"E0109\" [L0302] \"FS\" \"E-WEB-ABI-TYPE\" \"JT0001\" \"E-X\" \"E01090\" [W0001", codes)
    assert_eq(codes, [String]{"E0109", "L0302", "E-WEB-ABI-TYPE", "JT0001"})
    rows: render_rows(MINIMAL_ROW) ?? panic(err.message)
    rendered := [String]{}
    report_codes(rows.facts, "Error [jet.BadPath]: x\n Warning [E0001]: indented\nStop [FFI01]: meta\nLint [jet.Unknown]: y\n", rendered)
    assert_eq(rendered, [String]{"E9999", "FFI01"})
    assert_eq(excluded_codes("{KIT_UI_EXCLUDED}\"E0061\", \"E0277\"], code)\n") ?? panic(err.message), [String]{"E0061", "E0277"})
    if excluded_codes("{KIT_UI_EXCLUDED}E0061], code)\n") == .Ok(found) -> panic("an unquoted exclusion was read: {found.join(", ")}")
    if excluded_codes("kit_ui_excluded: fn(code: String) -> Bool {{ false }}\n") == .Ok(found) -> panic("a moved exclusion list was read: {found.join(", ")}")
    head: ALLOWLIST_HEADER
    committed: "{head}E9999\tleft-only\t{ALLOWLIST_CARD}\nFFI01\tright-only\t{ALLOWLIST_CARD}\nE0002\tleft-only\t{ALLOWLIST_CARD}\n"
    uncovered: render_allowlist(rows.facts, [String]{"E9999"}, [String]{"FFI01", "E0061"}, [String]{"E0061"}, committed) ?? panic(err.message)
    assert_eq(uncovered, "{head}E9999\tleft-only\t{ALLOWLIST_CARD}\nFFI01\tright-only\t{ALLOWLIST_CARD}\n")
    covered: render_allowlist(rows.facts, [String]{"E9999"}, [String]{"E9999"}, [String]{}, committed) ?? panic(err.message)
    assert_eq(covered, head)
    if render_allowlist(rows.facts, [String]{"E9999"}, [String]{}, [String]{}, head) == {
        .Ok(text) -> panic("a new uncovered code was admitted: {text}")
        .Err(error) -> assert(error.message.contains("would gain 1 uncovered codes (E9999 left-only)"))
    }
}
