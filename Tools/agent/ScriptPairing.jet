#!/usr/bin/env jet
// The script-pairing guard and the script census.
//
// New tooling may be written first in another language, but it lands paired:
// a change that adds a script in another language (a .mjs, .js, .cjs, .ts,
// .sh, .bash or .py file, or an extensionless file whose `#!` line names an
// interpreter other than jet) is refused unless a gauntlet entry under
// Tools/gauntlet/entries/ pairs it with its Jet twin in the same change.
// The exemptions sit in one place, EXEMPTIONS: JavaScript that runs in a
// browser, and the test, example and workload subjects (files a case,
// fixture, example or measured workload reads or runs as its subject, not
// tooling). The peer programs a
// gauntlet comparison runs Jet against are exempt too (peer_program): an
// optimization fixture's peer-* programs and the files of an axis's rails
// other than its jet/ rail. Nix files are not scripts by this rule.
//
// A script is paired in one of three ways:
// - a tool entry (`"mode": "tool"`) names a repository script as
//   `tool.original` and its Jet twin as `tool.jet`, and holds the shared
//   fixtures (`tool.fixtures`, a directory in the entry, when the tool reads
//   any; a stand-in program there, such as a fake `jet`, is the pair's too)
//   and the parity check: `tool.cases`, each the `args` both programs
//   run with (and, when given, the `env` variables they run under and the
//   `exit` code both must give, 0 otherwise) and the `expected` output file
//   in the entry. A case with a `check` (a Jet program in the entry) proves
//   the job: run with `jet` in the case directory after each program, with
//   the path of a file holding the program's output, it prints the facts the
//   job left (files, commits, queue lines, the facts the report states), and
//   that print must be `expected` byte for byte; a case without one compares
//   the programs' own output byte for byte. `tool.token_gaps`, when given,
//   names what closes the twin's token gap (Core API criteria such as
//   "#5072 c36", syntax ballots such as "D-SH-RUN1")
//   (Tools/gauntlet/harness/run.mjs runs each program in a fresh copy of the
//   fixtures; `--entry NAME` runs one entry);
// - a comparison entry (any other mode) holds its peer programs itself: every
//   file in its directory is paired when the entry lists `jet` among its
//   languages and has its jet/ directory and its expected output (a service
//   entry checks its probe instead);
// - a workload directory under WORKLOAD_ROOTS (a ScriptBench workload) holds
//   its peers beside its Jet program run.jet and its expected.out.
// A library an entry's driver (a `tool.original` under DRIVERS_ROOT, which
// runs a library's exports) imports by a relative path is covered by the
// entries whose drivers import it once those drivers import every export
// it has; until then it stays unpaired, and the census names the exports
// no driver imports. A test script (`*.test.mjs`) is covered when each
// script it imports relatively is paired or covered, and counts with those
// entries, not as an unpaired tool.
// The tool entries are the one home of which Jet program replaces which
// script; the census is computed from the tree on demand and never stored.
//
// A tool entry switches over when its original moves into the entry's own
// directory, kept there only as the reference its twin is judged against.
// The original keeps running until its entry passes the port-bar judge
// (JUDGE, Tools/gauntlet/PortBars.jet: the job, wall time and peak memory
// decide, beside the reasoning bar; tokens are reported, never failing), so
// `--check` runs that judge on each switched entry the change touches (a
// file in the entry or its Jet twin) and refuses the change while the entry
// loses a bar.
//
// Usage (from the repository root):
//   jet Tools/agent/ScriptPairing.jet --check [--base REV]
//     the guard: every script added since REV (default HEAD), staged,
//     unstaged or untracked, is paired or exempt, every tool entry is
//     complete, and every switched entry the change touches passes the
//     port-bar judge. Exits 0 when clean, 65 naming each refusal, 64 when
//     it cannot run.
//   jet Tools/agent/ScriptPairing.jet --census
//     every script in another language in the checkout, one
//     `path<TAB>class<TAB>pair` row each (class: browser, subject, peer,
//     paired, covered or unpaired; pair: the entry and the Jet twin, or the
//     entries that cover it), then the counts.
use {
    json: core.encoding.json
    files: core.files
    process: core.process
    sys: core.sys
}

ENTRIES_ROOT: "Tools/gauntlet/entries"
// Directories whose subdirectories are workloads: peers beside run.jet and
// expected.out.
WORKLOAD_ROOTS: [String]{"Tools/perf/scriptbench"}
SCRIPT_EXTENSIONS: [String]{".mjs", ".js", ".cjs", ".ts", ".sh", ".bash", ".py"}
// `#!` interpreters that are Nix, which the rule exempts.
NIX_INTERPRETERS: [String]{"nix", "nix-shell"}
PAIRING_RULE: "write its Jet twin and a gauntlet entry (Tools/gauntlet/entries/<name>/entry.json, \"mode\": \"tool\") that names it as `tool.original`, the twin as `tool.jet`, its fixtures and its `tool.cases` with expected output, in the same change (AGENTS.md, Tooling in other languages)"
// The port-bar judge a switched entry must pass.
JUDGE: "Tools/gauntlet/PortBars.jet"
// Where the optimization fixtures hold their peer-* programs.
OPTIMIZATION_FIXTURES: "Tools/gauntlet/optimization/fixtures/"
// The axes: an axis directory with a jet/ rail holds its peers' rails
// beside it.
AXES_ROOT: "Tools/gauntlet/axes/"
// Where an entry's driver sits: the original that runs a library's exports,
// which covers the scripts it imports.
DRIVERS_ROOT: "Tools/gauntlet/harness/drivers/"
// The names of a test script, which counts with what it imports.
TEST_SUFFIXES: [String]{".test.mjs", ".test.js"}
// The declarations an `export` line names.
EXPORT_KEYWORDS: [String]{"function", "function*", "class", "const", "let", "var"}
// What ends the name a declaration declares.
IDENTIFIER_STOPS: [String]{"(", " ", "=", "{{", ";", ",", ":"}

#Error
PairingError: struct {
    message: String
}

pairing_fail: fn(message: String) -> PairingError Never! { PairingError{message: "script-pairing: {message}"} }

// What the rule makes of one file.
FileClass: enum { Jet Other Browser Subject Peer Script }

// Every script under `root` is exempt as `class`; with `js_only`, only its
// .js and .mjs files.
Exemption: struct {
    root: String
    class: FileClass
    js_only: Bool
}

// The exemptions, in one place.
EXEMPTIONS: [Exemption]{
    // JavaScript that runs in a browser: the canvas assets the web build
    // ships, and the website.
    Exemption{root: "Compiler/JetCanvas/", class: .Browser, js_only: true},
    Exemption{root: "Docs/site/", class: .Browser, js_only: true},
    // Test, example and workload subjects.
    Exemption{root: "tests/cases/", class: .Subject, js_only: false},
    Exemption{root: "tests/fixtures/", class: .Subject, js_only: false},
    Exemption{root: "tests/run/", class: .Subject, js_only: false},
    Exemption{root: "tests/agent_workloads/inputs/", class: .Subject, js_only: false},
    Exemption{root: "Examples/", class: .Subject, js_only: false},
    // The self-hosting study's workloads: Tools/perf/selfhost/run.mjs copies
    // each into an isolated workspace and runs its inputs there (a native
    // provider's build script among them); the driver itself is a tool.
    Exemption{root: "Tools/perf/selfhost/workloads/", class: .Subject, js_only: false},
}

// A script the entries pair: the entry and the Jet twin.
Pair: struct {
    entry: String
    twin: String
}

// A tool entry's original, or a comparison entry's directory (with a
// trailing slash), and the pair it gives.
Pairing: struct {
    path: String
    pair: Pair
}

// One relative import of a JavaScript file: the script it names and the
// names it takes (`default` for a default import), or with `all` every
// export (`import * as name`).
Import: struct {
    path: String
    names: [String]
    all: Bool
}

// An import of an entry's driver, which covers what it takes.
Cover: struct {
    entry: String
    taken: Import
}

// How the entries cover a script no entry pairs: the entries that do, and
// what keeps it uncovered (the exports no driver imports, or a test's
// imports that are neither paired nor covered).
Coverage: struct {
    entries: [String]
    missing: [String]
}

// Every pairing the entries make, the imports of their drivers, the
// problems of incomplete tool entries, and why each incomplete comparison
// entry pairs nothing.
Entries: struct {
    pairings: [Pairing]
    covers: [Cover]
    problems: [String]
    incomplete: [Pairing]
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

array_field: fn(tree: Dyn, name: String) -> [Dyn] Never! {
    if field(tree, name) == .Array(items) -> return items.copy()
    [Dyn]{}
}

base_name: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    if split.sep == "" -> return path.copy()
    split.tail.copy()
}

// Whether the file name has no extension: no dot after its first byte.
extensionless: fn(path: String) -> Bool Never! {
    name: base_name(path)
    name.len() > 0 && !name.slice(1, name.len()).contains(".")
}

// The interpreter a `#!` line names: the program's base name, or for
// `env` the first word that is not a flag or a VAR=value assignment.
// "" when `first_line` is not a `#!` line.
shebang_interpreter: fn(first_line: String) -> String Never! {
    if !first_line.starts_with("#!") -> return ""
    words := [String]{}
    loop word in first_line.slice(2, first_line.len()).trim().split(" ").to_list() {
        if word.trim() != "" -> words.push(word.trim())
    }
    if words.len() == 0 -> return ""
    program: base_name(words[0])
    if program != "env" -> return program
    loop word in words.slice(1, words.len()) {
        if word.starts_with("-") || word.contains("=") -> next
        return base_name(word)
    }
    ""
}

// The class of `path`; `first_line` is its first line, read only for an
// extensionless file.
file_class: fn(path: String, first_line: String) -> FileClass Never! {
    if path.ends_with(".jet") -> return .Jet
    if !SCRIPT_EXTENSIONS.any(extension -> path.ends_with(extension)) {
        if !extensionless(path) -> return .Other
        interpreter: shebang_interpreter(first_line)
        if interpreter == "" || interpreter == "jet" || NIX_INTERPRETERS.contains(interpreter) -> return .Other
    }
    javascript: path.ends_with(".js") || path.ends_with(".mjs")
    loop exemption in EXEMPTIONS {
        if path.starts_with(exemption.root) && (javascript || !exemption.js_only) -> return exemption.class
    }
    .Script
}

// The first line of an extensionless file under `repo` (at most 256 bytes),
// else "".
first_line_of: fn(repo: String, path: String) -[FS]> String Never! {
    if !extensionless(path) -> return ""
    head: files.read_at(files.join(repo, path), 0, 256) ?? return ""
    String.from_bytes_lossy(head).partition("\n").head.copy()
}

// The class of the file `path` under `repo`: file_class, with a peer
// program (peer_program) as .Peer.
class_of: fn(repo: String, path: String) -[FS]> FileClass Never! {
    class: file_class(path, first_line_of(repo, path))
    if class == .Script && peer_program(repo, path) -> return .Peer
    class
}

// Whether the script `path` is a peer program a gauntlet comparison runs
// Jet against: a peer-* program of an optimization fixture, or a file in a
// rail of an axis that has a jet/ rail, other than that jet/ rail.
peer_program: fn(repo: String, path: String) -[FS]> Bool Never! {
    if path.starts_with(OPTIMIZATION_FIXTURES) -> return base_name(path).starts_with("peer")
    if !path.starts_with(AXES_ROOT) -> return false
    parts: path.slice(AXES_ROOT.len(), path.len()).split("/").to_list()
    parts.len() > 2 && parts[1] != "jet" && files.is_dir(files.join(repo, "{AXES_ROOT}{parts[0]}/jet"))
}

// The relative imports (`from './lib.mjs'`) of the JavaScript file `path`,
// with their paths in the checkout; none for another file.
js_imports: fn(repo: String, path: String) -[FS]> [Import] Never! {
    out := [Import]{}
    if !path.ends_with(".mjs") && !path.ends_with(".js") -> return out
    text: files.read(files.join(repo, path)) ?? return out
    dir: files.dirname(path)
    statement := ""
    loop line in text.lines() {
        trimmed: line.trim()
        if statement == "" && !trimmed.starts_with("import ") -> next
        statement = "{statement} {trimmed}".trim()
        quoted: statement.partition(" from ").tail.trim()
        if !quoted.starts_with("'") && !quoted.starts_with("\"") {
            if statement.contains(";") -> statement = ""
            next
        }
        specifier: quoted.slice(1, quoted.len()).partition(quoted.slice(0, 1)).head
        clause: statement.partition(" from ").head.removeprefix("import").trim()
        statement = ""
        if specifier.starts_with(".") -> out.push(Import{path: files.normalize("{dir}/{specifier}"), names: imported_names(clause), all: clause.contains("*")})
    }
    out
}

// The names an import clause takes: `default` for a default import, and
// each name in its braces (the exported name, before any `as`).
imported_names: fn(clause: String) -> [String] Never! {
    names := [String]{}
    braced: clause.partition("{{")
    first: braced.head.partition(",").head.trim()
    if first != "" && !first.starts_with("*") -> names.push("default")
    loop part in braced.tail.partition("}}").head.split(",") {
        name: part.trim().partition(" as ").head.trim()
        if name != "" -> names.push(name.copy())
    }
    names
}

// What the JavaScript file `path` exports, in source order: each declared
// `export function`, `class`, `const`, `let` or `var`, each name of an
// `export {…}` list (its `as` name), and `default`.
js_exports: fn(repo: String, path: String) -[FS]> [String] Never! {
    names := [String]{}
    text: files.read(files.join(repo, path)) ?? return names
    listing := false
    loop line in text.lines() {
        code: line.partition("//").head.trim()
        if listing {
            names.extend(listed_names(code.partition("}}").head))
            listing = !code.contains("}}")
            next
        }
        if !code.starts_with("export ") -> next
        declared: code.removeprefix("export ").trim().removeprefix("async ").trim()
        if declared.starts_with("{{") {
            inner: declared.removeprefix("{{")
            names.extend(listed_names(inner.partition("}}").head))
            listing = !inner.contains("}}")
            next
        }
        if declared.starts_with("default") {
            names.push("default")
            next
        }
        keyword: declared.partition(" ")
        if !EXPORT_KEYWORDS.contains(keyword.head) -> next
        name := keyword.tail.trim().removeprefix("*").trim()
        loop stop in IDENTIFIER_STOPS -> name = name.partition(stop).head
        if name != "" -> names.push(name)
    }
    names
}

// The exported names of a fragment of an `export {…}` list: each item's
// `as` name, else its own.
listed_names: fn(fragment: String) -> [String] Never! {
    names := [String]{}
    loop part in fragment.split(",") {
        item: part.trim().partition(" as ")
        name: if item.sep == "" -> item.head.trim() else -> item.tail.trim()
        if name != "" -> names.push(name.copy())
    }
    names
}

// The names of the directories in `repo`/`root`, in name order.
subdirectories: fn(repo: String, root: String, found: &Entries) -[FS]> [String] Never! {
    names := [String]{}
    if !files.is_dir(files.join(repo, root)) -> return names
    listed: files.list_dir(files.join(repo, root)) ?? {
        found.problems.push("{root} cannot be listed: {err}")
        return names
    }
    loop item in listed {
        if item.is_dir -> names.push(item.name.copy())
    }
    names.sort()
    names
}

// The pairings, covers, problems and incomplete entries of every entry
// under `repo`/ENTRIES_ROOT and every workload under WORKLOAD_ROOTS, in
// name order.
read_entries: fn(repo: String) -[FS]> Entries Never! {
    found := Entries{pairings: [Pairing]{}, covers: [Cover]{}, problems: [String]{}, incomplete: [Pairing]{}}
    loop name in subdirectories(repo, ENTRIES_ROOT, found) {
        dir: "{ENTRIES_ROOT}/{name}"
        manifest: "{dir}/entry.json"
        text: files.read(files.join(repo, manifest)) ?? next
        tree: json.parse(text) ?? {
            found.incomplete.push(Pairing{path: "{dir}/", pair: Pair{entry: name.copy(), twin: "{manifest} is not JSON: {err}"}})
            next
        }
        if text_field(tree, "mode") == "tool" {
            tool_entry(repo, name, tree, found)
            next
        }
        why: comparison_gap(repo, dir, tree)
        if {
            why == "" -> found.pairings.push(Pairing{path: "{dir}/", pair: Pair{entry: name.copy(), twin: "{dir}/jet"}})
            else -> found.incomplete.push(Pairing{path: "{dir}/", pair: Pair{entry: name.copy(), twin: why}})
        }
    }
    loop root in WORKLOAD_ROOTS {
        loop name in subdirectories(repo, root, found) {
            dir: "{root}/{name}"
            twin: "{dir}/run.jet"
            complete: files.is_file(files.join(repo, twin)) && files.is_file(files.join(repo, "{dir}/expected.out"))
            if {
                complete -> found.pairings.push(Pairing{path: "{dir}/", pair: Pair{entry: dir.copy(), twin: twin}})
                else -> found.incomplete.push(Pairing{path: "{dir}/", pair: Pair{entry: dir.copy(), twin: "it has no run.jet and expected.out"}})
            }
        }
    }
    covers := [Cover]{}
    loop known in found.pairings {
        if !known.path.starts_with(DRIVERS_ROOT) -> next
        loop taken in js_imports(repo, known.path) -> covers.push(Cover{entry: known.pair.entry.copy(), taken: taken})
    }
    found.covers = covers
    found
}

// Records the pairing a tool entry makes, or each part it lacks.
tool_entry: fn(repo: String, name: String, tree: Dyn, found: &Entries) -[FS]> () {
    dir: "{ENTRIES_ROOT}/{name}"
    tool: field(tree, "tool")
    original: text_field(tool, "original")
    twin: text_field(tool, "jet")
    problems := [String]{}
    if text_field(tree, "name") != name -> problems.push("its `name` is not `{name}`")
    if {
        original == "" -> problems.push("it names no `tool.original`")
        !files.is_file(files.join(repo, original)) -> problems.push("its original `{original}` does not exist")
        class_of(repo, original) != .Script -> problems.push("its original `{original}` is not a script in another language")
    }
    if {
        !twin.ends_with(".jet") -> problems.push("its `tool.jet` is not a Jet program")
        !files.is_file(files.join(repo, twin)) -> problems.push("its Jet twin `{twin}` does not exist")
    }
    fixtures: text_field(tool, "fixtures")
    if fixtures != "" && !files.is_dir(files.join(repo, "{dir}/{fixtures}")) -> problems.push("its fixtures `{dir}/{fixtures}` are not a directory")
    cases: array_field(tool, "cases")
    if cases.len() == 0 -> problems.push("it has no `tool.cases` parity check")
    loop index in 0..<cases.len() {
        case: cases[index]
        args_listed := false
        if field(case, "args") == .Array(listed) -> args_listed = listed.len() >= 0
        if !args_listed -> problems.push("case {index + 1} has no `args` array")
        expected: text_field(case, "expected")
        if {
            expected == "" -> problems.push("case {index + 1} names no `expected` output")
            !files.is_file(files.join(repo, "{dir}/{expected}")) -> problems.push("case {index + 1}'s expected output `{dir}/{expected}` does not exist")
        }
        check: text_field(case, "check")
        if check != "" && (!check.ends_with(".jet") || !files.is_file(files.join(repo, "{dir}/{check}"))) -> problems.push("case {index + 1}'s check `{dir}/{check}` is not a Jet program")
    }
    loop known in found.pairings {
        if original != "" && known.path == original -> problems.push("`{original}` is already the original of entry `{known.pair.entry}`")
    }
    if problems.len() > 0 {
        found.problems.push("tool entry `{dir}`: {problems.join("; ")}")
        return
    }
    found.pairings.push(Pairing{path: original.copy(), pair: Pair{entry: name.copy(), twin: twin.copy()}})
    // The fixtures are what the pair runs on: a stand-in program there (a
    // fake `jet` or `git`) belongs to the pair, as a comparison entry's peers do.
    if fixtures != "" -> found.pairings.push(Pairing{path: "{dir}/{fixtures.removesuffix("/")}/", pair: Pair{entry: name.copy(), twin: twin.copy()}})
}

// Why a comparison entry pairs nothing, or "" when it is complete.
comparison_gap: fn(repo: String, dir: String, tree: Dyn) -[FS]> String Never! {
    languages: array_field(tree, "languages")
    if !languages.any(language -> language == .Text("jet")) -> return "it does not list `jet` among its languages"
    if !files.is_dir(files.join(repo, "{dir}/jet")) -> return "it has no jet/ directory"
    if text_field(tree, "mode") == "service" -> return ""
    expected: text_field(field(tree, "spec"), "expected")
    named: if expected == "" -> "expected.out" else -> expected
    if !files.is_file(files.join(repo, "{dir}/{named}")) -> return "it has no expected output `{dir}/{named}`"
    ""
}

// The pair of `path`: a tool entry naming it as its original, else the
// complete comparison entry holding it.
pair_of: fn(entries: Entries, path: String) -> Pair? Never! {
    loop known in entries.pairings {
        if known.path == path || (known.path.ends_with("/") && path.starts_with(known.path)) -> return Val(known.pair.copy())
    }
    None
}

// Whether `coverage` covers its script: an entry covers it and nothing is
// missing.
covered: fn(coverage: Coverage) -> Bool Never! { coverage.entries.len() > 0 && coverage.missing.len() == 0 }

// How the entries cover the script `path` without pairing it: a test
// script by what it imports, any other as a library its drivers import.
covering: fn(repo: String, entries: Entries, path: String) -[FS]> Coverage Never! {
    if TEST_SUFFIXES.any(suffix -> path.ends_with(suffix)) -> return test_coverage(repo, entries, path)
    library_coverage(repo, entries, path)
}

// The entries whose driver imports the library `path`, in name order, and
// each export of it (in source order) that none of those drivers imports.
library_coverage: fn(repo: String, entries: Entries, path: String) -[FS]> Coverage Never! {
    names := [String]{}
    taken := [String]{}
    all := false
    loop known in entries.covers {
        if known.taken.path != path -> next
        if !names.contains(known.entry) -> names.push(known.entry.copy())
        all = all || known.taken.all
        taken.extend(known.taken.names)
    }
    names.sort()
    if names.len() == 0 || all -> return Coverage{entries: names, missing: [String]{}}
    Coverage{entries: names, missing: js_exports(repo, path).filter(name -> !taken.contains(name))}
}

// The entries of the scripts the test script `path` imports, in name
// order, and each import that is neither paired nor covered.
test_coverage: fn(repo: String, entries: Entries, path: String) -[FS]> Coverage Never! {
    names := [String]{}
    missing := [String]{}
    loop taken in js_imports(repo, path) {
        own: if pair_of(entries, taken.path) == .Val(pair) -> Coverage{entries: [String]{pair.entry.copy()}, missing: [String]{}} else -> library_coverage(repo, entries, taken.path)
        if !covered(own) {
            missing.push(taken.path.copy())
            next
        }
        loop name in own.entries {
            if !names.contains(name) -> names.push(name.copy())
        }
    }
    names.sort()
    Coverage{entries: names, missing: missing}
}

// Why the incomplete comparison entry holding `path` pairs nothing, or "".
incomplete_reason: fn(entries: Entries, path: String) -> String Never! {
    loop known in entries.incomplete {
        if path.starts_with(known.path) -> return "entry `{known.pair.entry}` is incomplete: {known.pair.twin}"
    }
    ""
}

// The refusal for each added path that is a script neither paired nor
// covered, then every incomplete tool entry.
refusals: fn(repo: String, added: [String], entries: Entries) -[FS]> [String] Never! {
    out := [String]{}
    loop path in added {
        if class_of(repo, path) != .Script || pair_of(entries, path) != None -> next
        coverage: covering(repo, entries, path)
        if covered(coverage) -> next
        why: incomplete_reason(entries, path)
        detail: if {
            why != "" -> " ({why})"
            coverage.missing.len() > 0 -> " (missing: {coverage.missing.join(", ")})"
            else -> ""
        }
        out.push("{path}: a script in another language with no gauntlet pair{detail}; {PAIRING_RULE}")
    }
    loop problem in entries.problems -> out.push(problem.copy())
    out
}

// Whose repository a git read sees.
// - Caller: the caller's, as git finds it: its GIT_DIR, GIT_INDEX_FILE and
//   GIT_WORK_TREE when exported, which a checkout with no `.git` of its own
//   (a land tree) needs.
// - Own: the repository at `repo` alone, whatever the caller exports.
GitScope: enum { Caller Own }

git_lines: fn(repo: String, args: [String], scope: GitScope) -[Exec, Time.Wait]> [String] PairingError! {
    argv := [String]{"git", "-c", "core.quotepath=off"}
    argv.extend(args.copy())
    receipt: git_command(repo, argv, scope).output_limit(268435456).run() ?? return Err(pairing_fail("git cannot start: {err}"))
    if receipt.code != 0 || receipt.signal != None -> return Err(pairing_fail("{argv.join(" ")} failed ({receipt.code}): {receipt.errors.trim()}"))
    lines := [String]{}
    loop line in receipt.output.lines() {
        if line != "" -> lines.push(line.copy())
    }
    Ok(lines)
}

// `argv`, a git command, run in `repo` on the repository `scope` names.
git_command: fn(repo: String, argv: [String], scope: GitScope) -> process.ProcessSpec {
    spec: process.cmd(argv).cwd(repo)
    if scope == {
        .Caller -> spec
        .Own -> spec.env_remove("GIT_DIR").env_remove("GIT_INDEX_FILE").env_remove("GIT_WORK_TREE")
    }
}

// The files added since `base`, staged, unstaged or untracked; a rename is
// not an addition.
added_files: fn(repo: String, base: String, scope: GitScope) -[Exec, Time.Wait]> [String] PairingError! {
    added: git_lines(repo, [String]{"diff", "--name-only", "--find-renames", "--diff-filter=A", base, "--"}, scope) ?? return Err(err)
    untracked: git_lines(repo, [String]{"ls-files", "--others", "--exclude-standard"}, scope) ?? return Err(err)
    out := added.copy()
    loop path in untracked {
        if !out.contains(path) -> out.push(path.copy())
    }
    out.sort()
    Ok(out)
}

// Every file changed since `base`, staged, unstaged or untracked; a rename
// is both of its paths.
changed_files: fn(repo: String, base: String, scope: GitScope) -[Exec, Time.Wait]> [String] PairingError! {
    changed: git_lines(repo, [String]{"diff", "--name-only", "--no-renames", base, "--"}, scope) ?? return Err(err)
    untracked: git_lines(repo, [String]{"ls-files", "--others", "--exclude-standard"}, scope) ?? return Err(err)
    out := changed.copy()
    loop path in untracked {
        if !out.contains(path) -> out.push(path.copy())
    }
    out.sort()
    Ok(out)
}

// The tool entries `changed` touches whose original sits in the entry's own
// directory: the entries that switched over to their Jet twin.
switched_entries: fn(entries: Entries, changed: [String]) -> [String] Never! {
    out := [String]{}
    loop known in entries.pairings {
        dir: "{ENTRIES_ROOT}/{known.pair.entry}/"
        if known.path.ends_with("/") || !known.path.starts_with(dir) || out.contains(known.pair.entry) -> next
        if changed.any(path -> path.starts_with(dir) || path == known.pair.twin) -> out.push(known.pair.entry.copy())
    }
    out
}

// The refusal for each of `names` that loses a port bar, with the bars it
// loses as JUDGE reports them.
judge_refusals: fn(repo: String, names: [String]) -[Env, Exec, Time.Wait]> [String] Never! {
    jet: process.env_get("JET") ?? "jet"
    out := [String]{}
    loop name in names {
        command: "{JUDGE} --entry {name}"
        receipt: process.cmd([String]{jet.copy(), files.join(repo, JUDGE), "--repo", repo.copy(), "--entry", name.copy()}).cwd(repo).output_limit(268435456).run() ?? {
            out.push("tool entry `{ENTRIES_ROOT}/{name}` switches to its Jet twin, but `{command}` cannot start: {err}")
            next
        }
        if receipt.code == 0 && receipt.signal == None -> next
        lost := [String]{}
        loop line in receipt.output.lines() {
            cells: line.split("\t").to_list()
            if cells.len() == 4 && cells[0] == name && cells[1] != "verdict" && cells[2] == "FAIL" -> lost.push("{cells[1]}: {cells[3]}")
        }
        why: if lost.len() > 0 -> lost.join("; ") else -> "it exited {receipt.code}: {receipt.errors.trim()}"
        out.push("tool entry `{ENTRIES_ROOT}/{name}` switches to its Jet twin before it wins every port bar (`{command}`): {why}; the original keeps running until it does")
    }
    out
}

// Every file of the checkout, tracked or untracked and not ignored.
checkout_files: fn(repo: String, scope: GitScope) -[Exec, Time.Wait]> [String] PairingError! {
    listed: git_lines(repo, [String]{"ls-files", "--cached", "--others", "--exclude-standard"}, scope) ?? return Err(err)
    out := listed.copy()
    out.sort()
    Ok(out)
}

// The census rows: every script in another language, its class and pair.
census_rows: fn(repo: String, paths: [String], entries: Entries) -[FS]> [String] Never! {
    rows := [String]{}
    loop path in paths {
        if !files.is_file(files.join(repo, path)) -> next
        class: class_of(repo, path)
        if class == {
            .Browser -> rows.push("{path}\tbrowser\t")
            .Subject -> rows.push("{path}\tsubject\t")
            .Peer -> rows.push("{path}\tpeer\t")
            .Script -> {
                pair: pair_of(entries, path) ?? {
                    coverage: covering(repo, entries, path)
                    row: if {
                        covered(coverage) -> "{path}\tcovered\t{coverage.entries.join(" ")}"
                        coverage.missing.len() > 0 -> "{path}\tunpaired\tmissing: {coverage.missing.join(" ")}"
                        else -> "{path}\tunpaired\t"
                    }
                    rows.push(row)
                    next
                }
                rows.push("{path}\tpaired\t{pair.entry} {pair.twin}")
            }
            .Jet | .Other -> next
        }
    }
    rows
}

CENSUS_CLASSES: [String]{"paired", "unpaired", "browser", "subject", "covered", "peer"}

census_counts: fn(rows: [String]) -> String Never! {
    parts := [String]{}
    loop name in CENSUS_CLASSES {
        count := 0
        loop row in rows {
            if row.partition("\t").tail.partition("\t").head == name -> count += 1
        }
        parts.push("{name} {count}")
    }
    "scripts {rows.len()}: {parts.join(", ")}"
}

// The checkout holding this tool, else the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    tool: "/Tools/agent/ScriptPairing.jet"
    script: sys.executable()
    if script.ends_with(tool) -> return script.removesuffix(tool)
    files.cwd() ?? "."
}

usage: fn() -[Exec, IO]> Never {
    process.fail(64, "usage: jet Tools/agent/ScriptPairing.jet --check [--base REV] | --census")
}

run: fn() {
    args: process.args()
    repo: repo_root()
    if args.len() == 1 && args[0] == "--census" {
        paths: checkout_files(repo, .Caller) ?? process.fail(64, err.message)
        rows: census_rows(repo, paths, read_entries(repo))
        loop row in rows -> print(row)
        print(census_counts(rows))
        return
    }
    if args.len() == 0 || args[0] != "--check" -> usage()
    base: if args.len() == 3 && args[1] == "--base" -> args[2].copy() else -> "HEAD"
    if args.len() != 1 && args.len() != 3 -> usage()
    added: added_files(repo, base, .Caller) ?? process.fail(64, err.message)
    changed: changed_files(repo, base, .Caller) ?? process.fail(64, err.message)
    entries: read_entries(repo)
    refused := refusals(repo, added, entries)
    refused.extend(judge_refusals(repo, switched_entries(entries, changed)))
    if refused.len() == 0 {
        print("script pairing: ok ({added.len()} added file(s))")
        return
    }
    process.fail(65, refused.map(line -> "script-pairing: {line}").join("\n"))
}

#Test("a script is named by its extension or a non-Jet `#!` line; browser JS, subjects and Nix are exempt") {
    assert(file_class("Tools/x/run.mjs", "") == .Script)
    assert(file_class("Tools/x/run.py", "") == .Script)
    assert(file_class("Tools/x/types.d.ts", "") == .Script)
    assert(file_class("Compiler/JetCanvas/Source/CanvasAssets/js/review.js", "") == .Browser)
    assert(file_class("Docs/site/assets/site.js", "") == .Browser)
    assert(file_class("Compiler/JetCanvas/build.sh", "") == .Script)
    assert(file_class("tests/cases/source_import/lib.py", "") == .Subject)
    assert(file_class("Examples/Interop/FFI/add.js", "") == .Subject)
    assert(file_class("tests/agent_workloads/adapters/run.bash", "") == .Script)
    assert(file_class("Tools/x/Run.jet", "#!/usr/bin/env -S jet -A") == .Jet)
    assert(file_class("Tools/x/run", "#!/usr/bin/env -S jet -A") == .Other)
    assert(file_class("Tools/x/run", "#!/usr/bin/env python3") == .Script)
    assert(file_class("Tools/x/run", "#!/bin/sh") == .Script)
    assert(file_class("Tools/x/run", "#!/usr/bin/env nix-shell") == .Other)
    assert(file_class("Tools/x/flake.nix", "") == .Other)
    assert(file_class("Tools/x/README", "plain text") == .Other)
    assert(file_class("Tools/x/data.tsv", "#!/bin/sh") == .Other)
    assert_eq(shebang_interpreter("#!/usr/bin/env FOO=1 -S node --flag"), "node")
    assert_eq(shebang_interpreter("#! /bin/bash -e"), "bash")
    assert_eq(shebang_interpreter("// not a shebang"), "")
    assert(extensionless(".envrc") && extensionless("a/b/run") && !extensionless("a/b.c/run.sh"))
}

// A scratch checkout with one commit, for the planted cases; its git sees it
// alone, as the planted reads (GitScope.Own) do.
planted_repo: fn() -[Env, Exec, FS, Time.Wait]> String Never! {
    dir: files.mkdtemp("script-pairing") ?? panic("a temporary directory cannot be made: {err}")
    files.write("{dir}/README.md", "planted\n") ?? panic("{dir}: {err}")
    steps: [[String]]{
        [String]{"git", "init", "-q"},
        [String]{"git", "add", "README.md"},
        [String]{"git", "-c", "user.name=planted", "-c", "user.email=planted@example.invalid", "commit", "-q", "-m", "base"},
    }
    loop argv in steps {
        receipt: git_command(dir, argv, .Own).run() ?? panic("git cannot start: {err}")
        assert_eq(receipt.code, 0)
    }
    dir
}

plant: fn(dir: String, path: String, text: String) -[FS]> () {
    files.create_dir_all(files.dirname(files.join(dir, path))) ?? panic("{path}: {err}")
    files.write(files.join(dir, path), text) ?? panic("{path}: {err}")
}

#Test("a planted unpaired script is refused by name; a paired script and a browser asset pass") {
    dir: planted_repo()
    plant(dir, "Tools/stray/report.mjs", "console.log(1)\n")
    plant(dir, "Tools/stray/fetch", "#!/usr/bin/env python3\nprint(1)\n")
    plant(dir, "Tools/count/count.py", "print(3)\n")
    plant(dir, "Tools/count/Count.jet", "run: fn() {{ print(3) }}\n")
    plant(dir, "{ENTRIES_ROOT}/count/entry.json", "{{\"name\": \"count\", \"mode\": \"tool\", \"tool\": {{\"original\": \"Tools/count/count.py\", \"jet\": \"Tools/count/Count.jet\", \"fixtures\": \"fixtures\", \"cases\": [{{\"args\": [], \"expected\": \"expected/plain.out\"}}]}}}}\n")
    plant(dir, "{ENTRIES_ROOT}/count/fixtures/input.txt", "3\n")
    plant(dir, "{ENTRIES_ROOT}/count/fixtures/fake-git.sh", "#!/bin/sh\necho 3\n")
    plant(dir, "{ENTRIES_ROOT}/count/expected/plain.out", "3\n")
    plant(dir, "{ENTRIES_ROOT}/sum/entry.json", "{{\"name\": \"sum\", \"mode\": \"batch\", \"languages\": [\"jet\", \"python\"]}}\n")
    plant(dir, "{ENTRIES_ROOT}/sum/python/main.py", "print(2)\n")
    plant(dir, "{ENTRIES_ROOT}/sum/jet/run.jet", "run: fn() {{ print(2) }}\n")
    plant(dir, "{ENTRIES_ROOT}/sum/expected.out", "2\n")
    plant(dir, "{ENTRIES_ROOT}/half/entry.json", "{{\"name\": \"half\", \"mode\": \"batch\", \"languages\": [\"python\"]}}\n")
    plant(dir, "{ENTRIES_ROOT}/half/python/main.py", "print(1)\n")
    plant(dir, "Compiler/JetCanvas/Source/CanvasAssets/js/clock.js", "export const now = () => 0;\n")
    plant(dir, "tests/cases/port_python/input.py", "print(4)\n")
    plant(dir, "{WORKLOAD_ROOTS[0]}/w99-echo/peer.py", "print(5)\n")
    plant(dir, "{WORKLOAD_ROOTS[0]}/w99-echo/run.jet", "run: fn() {{ print(5) }}\n")
    plant(dir, "{WORKLOAD_ROOTS[0]}/w99-echo/expected.out", "5\n")
    added: added_files(dir, "HEAD", .Own) ?? panic(err.message)
    assert(added.contains("Tools/stray/report.mjs") && added.contains("Compiler/JetCanvas/Source/CanvasAssets/js/clock.js"))
    refused: refusals(dir, added, read_entries(dir))
    assert_eq(refused.len(), 3)
    assert(refused[0].starts_with("{ENTRIES_ROOT}/half/python/main.py: a script in another language with no gauntlet pair (entry `half` is incomplete: it does not list `jet` among its languages); "))
    assert(refused[1].starts_with("Tools/stray/fetch: a script in another language with no gauntlet pair; "))
    assert(refused[2].starts_with("Tools/stray/report.mjs: a script in another language with no gauntlet pair; "))
    rows: census_rows(dir, checkout_files(dir, .Own) ?? panic(err.message), read_entries(dir))
    assert(rows.contains("Tools/count/count.py\tpaired\tcount Tools/count/Count.jet"))
    assert(rows.contains("{ENTRIES_ROOT}/count/fixtures/fake-git.sh\tpaired\tcount Tools/count/Count.jet"))
    assert(rows.contains("{ENTRIES_ROOT}/sum/python/main.py\tpaired\tsum {ENTRIES_ROOT}/sum/jet"))
    assert(rows.contains("{WORKLOAD_ROOTS[0]}/w99-echo/peer.py\tpaired\t{WORKLOAD_ROOTS[0]}/w99-echo {WORKLOAD_ROOTS[0]}/w99-echo/run.jet"))
    assert(rows.contains("Compiler/JetCanvas/Source/CanvasAssets/js/clock.js\tbrowser\t"))
    assert(rows.contains("tests/cases/port_python/input.py\tsubject\t"))
    assert_eq(census_counts(rows), "scripts 9: paired 4, unpaired 3, browser 1, subject 1, covered 0, peer 0")
    files.remove_all(dir) ?? ()
}

#Test("a selfhost workload's script is a subject; a tool script beside the workloads still needs its pair") {
    dir: planted_repo()
    plant(dir, "Tools/perf/selfhost/workloads/ffi/native/build.sh", "#!/bin/sh\ncc -c foreign.c\n")
    plant(dir, "Tools/perf/selfhost/report.mjs", "console.log(1)\n")
    added: added_files(dir, "HEAD", .Own) ?? panic(err.message)
    refused: refusals(dir, added, read_entries(dir))
    assert_eq(refused.len(), 1)
    assert(refused[0].starts_with("Tools/perf/selfhost/report.mjs: a script in another language with no gauntlet pair; "))
    rows: census_rows(dir, checkout_files(dir, .Own) ?? panic(err.message), read_entries(dir))
    assert(rows.contains("Tools/perf/selfhost/workloads/ffi/native/build.sh\tsubject\t"))
    assert(rows.any(row -> row.starts_with("Tools/perf/selfhost/report.mjs\tunpaired\t")))
    assert_eq(census_counts(rows), "scripts 2: paired 0, unpaired 1, browser 0, subject 1, covered 0, peer 0")
    files.remove_all(dir) ?? ()
}

#Test("a library whose every export a driver imports, and a test of it, are covered; peer programs are exempt; the rest is refused") {
    dir: planted_repo()
    plant(dir, "{DRIVERS_ROOT}tally.mjs", "import {{\n  add,\n  total as sum,\n}} from '../tally-lib.mjs';\nimport {{ used }} from \"../partial.mjs\";\nimport fs from 'node:fs';\nconsole.log(add(1, 2));\n")
    plant(dir, "Tools/gauntlet/harness/tally-lib.mjs", "export const add = (a, b) => a + b;\nexport async function total(list) {{ return 0; }}\n")
    plant(dir, "Tools/gauntlet/harness/tally-lib.test.mjs", "import {{ add }} from \"./tally-lib.mjs\";\n")
    plant(dir, "Tools/gauntlet/harness/partial.mjs", "export function used() {{}}\nconst spare = 1, other = 2;\nexport {{\n  spare, // kept\n  other as renamed,\n}};\n")
    plant(dir, "Tools/gauntlet/harness/partial.test.mjs", "import {{ used }} from './partial.mjs';\n")
    plant(dir, "Tools/gauntlet/harness/other.test.mjs", "import {{ add }} from './tally-lib.mjs';\nimport {{ stray }} from './stray.mjs';\n")
    plant(dir, "Tools/gauntlet/harness/stray.mjs", "export const stray = 1;\n")
    plant(dir, "Tools/tally/Tally.jet", "run: fn() {{ print(3) }}\n")
    plant(dir, "{ENTRIES_ROOT}/tally/entry.json", "{{\"name\": \"tally\", \"mode\": \"tool\", \"tool\": {{\"original\": \"{DRIVERS_ROOT}tally.mjs\", \"jet\": \"Tools/tally/Tally.jet\", \"cases\": [{{\"args\": [], \"expected\": \"expected/plain.out\"}}]}}}}\n")
    plant(dir, "{ENTRIES_ROOT}/tally/expected/plain.out", "3\n")
    plant(dir, "Tools/tool/tool.mjs", "import {{ help }} from './helper.mjs';\n")
    plant(dir, "Tools/tool/helper.mjs", "export const help = 1;\n")
    plant(dir, "Tools/tool/Tool.jet", "run: fn() {{ print(1) }}\n")
    plant(dir, "{ENTRIES_ROOT}/tool/entry.json", "{{\"name\": \"tool\", \"mode\": \"tool\", \"tool\": {{\"original\": \"Tools/tool/tool.mjs\", \"jet\": \"Tools/tool/Tool.jet\", \"cases\": [{{\"args\": [], \"expected\": \"expected/plain.out\"}}]}}}}\n")
    plant(dir, "{ENTRIES_ROOT}/tool/expected/plain.out", "1\n")
    plant(dir, "{OPTIMIZATION_FIXTURES}sum/peer-node.mjs", "console.log(2)\n")
    plant(dir, "{AXES_ROOT}reload/jet/run.jet", "run: fn() {{ print(1) }}\n")
    plant(dir, "{AXES_ROOT}reload/js/server.mjs", "console.log(1)\n")
    plant(dir, "{AXES_ROOT}reload/driver.mjs", "console.log(1)\n")
    plant(dir, "{AXES_ROOT}gen/js/build.mjs", "console.log(1)\n")
    entries: read_entries(dir)
    imports: js_imports(dir, "{DRIVERS_ROOT}tally.mjs")
    assert_eq(imports.map(taken -> taken.path.copy()), [String]{"Tools/gauntlet/harness/tally-lib.mjs", "Tools/gauntlet/harness/partial.mjs"})
    assert_eq(imports[0].names, [String]{"add", "total"})
    assert_eq(js_exports(dir, "Tools/gauntlet/harness/partial.mjs"), [String]{"used", "spare", "renamed"})
    refused: refusals(dir, added_files(dir, "HEAD", .Own) ?? panic(err.message), entries)
    assert_eq(refused.len(), 7)
    assert(refused[0].starts_with("{AXES_ROOT}gen/js/build.mjs: a script in another language with no gauntlet pair; "))
    assert(refused[1].starts_with("{AXES_ROOT}reload/driver.mjs: a script in another language with no gauntlet pair; "))
    assert(refused[2].starts_with("Tools/gauntlet/harness/other.test.mjs: a script in another language with no gauntlet pair (missing: Tools/gauntlet/harness/stray.mjs); "))
    assert(refused[3].starts_with("Tools/gauntlet/harness/partial.mjs: a script in another language with no gauntlet pair (missing: spare, renamed); "))
    assert(refused[4].starts_with("Tools/gauntlet/harness/partial.test.mjs: a script in another language with no gauntlet pair (missing: Tools/gauntlet/harness/partial.mjs); "))
    assert(refused[5].starts_with("Tools/gauntlet/harness/stray.mjs: a script in another language with no gauntlet pair; "))
    assert(refused[6].starts_with("Tools/tool/helper.mjs: a script in another language with no gauntlet pair; "))
    rows: census_rows(dir, checkout_files(dir, .Own) ?? panic(err.message), entries)
    assert(rows.contains("{DRIVERS_ROOT}tally.mjs\tpaired\ttally Tools/tally/Tally.jet"))
    assert(rows.contains("Tools/gauntlet/harness/tally-lib.mjs\tcovered\ttally"))
    assert(rows.contains("Tools/gauntlet/harness/tally-lib.test.mjs\tcovered\ttally"))
    assert(rows.contains("Tools/gauntlet/harness/partial.mjs\tunpaired\tmissing: spare renamed"))
    assert(rows.contains("Tools/gauntlet/harness/partial.test.mjs\tunpaired\tmissing: Tools/gauntlet/harness/partial.mjs"))
    assert(rows.contains("Tools/gauntlet/harness/other.test.mjs\tunpaired\tmissing: Tools/gauntlet/harness/stray.mjs"))
    assert(rows.contains("Tools/tool/helper.mjs\tunpaired\t"))
    assert(rows.contains("{OPTIMIZATION_FIXTURES}sum/peer-node.mjs\tpeer\t"))
    assert(rows.contains("{AXES_ROOT}reload/js/server.mjs\tpeer\t"))
    assert_eq(census_counts(rows), "scripts 13: paired 2, unpaired 7, browser 0, subject 0, covered 2, peer 2")
    files.remove_all(dir) ?? ()
}

#Test("a tool entry missing its twin, fixtures or parity check is refused part by part") {
    dir: planted_repo()
    plant(dir, "Tools/count/count.py", "print(3)\n")
    plant(dir, "{ENTRIES_ROOT}/count/entry.json", "{{\"name\": \"count\", \"mode\": \"tool\", \"tool\": {{\"original\": \"Tools/count/count.py\", \"jet\": \"Tools/count/Count.jet\", \"fixtures\": \"fixtures\", \"cases\": [{{\"expected\": \"expected/plain.out\", \"check\": \"check.sh\"}}]}}}}\n")
    refused: refusals(dir, added_files(dir, "HEAD", .Own) ?? panic(err.message), read_entries(dir))
    assert_eq(refused.len(), 2)
    assert(refused[0].starts_with("Tools/count/count.py: a script in another language with no gauntlet pair; "))
    assert_eq(refused[1], "tool entry `{ENTRIES_ROOT}/count`: its Jet twin `Tools/count/Count.jet` does not exist; its fixtures `{ENTRIES_ROOT}/count/fixtures` are not a directory; case 1 has no `args` array; case 1's expected output `{ENTRIES_ROOT}/count/expected/plain.out` does not exist; case 1's check `{ENTRIES_ROOT}/count/check.sh` is not a Jet program")
    files.remove_all(dir) ?? ()
}

#Test("a tool entry whose original moved into its own directory has switched over, and a change to it asks the port-bar judge") {
    twin: Pair{entry: "count", twin: "Tools/count/Count.jet"}
    entries: Entries{pairings: [Pairing]{
        Pairing{path: "{ENTRIES_ROOT}/count/count.py", pair: twin},
        Pairing{path: "{ENTRIES_ROOT}/count/fixtures/", pair: twin},
        Pairing{path: "Tools/sum/sum.py", pair: Pair{entry: "sum", twin: "Tools/sum/Sum.jet"}},
    }, covers: [Cover]{}, problems: [String]{}, incomplete: [Pairing]{}}
    assert_eq(switched_entries(entries, [String]{"README.md", "Tools/count/count.py"}), [String]{})
    assert_eq(switched_entries(entries, [String]{"{ENTRIES_ROOT}/count/count.py", "Tools/count/count.py"}), [String]{"count"})
    assert_eq(switched_entries(entries, [String]{"Tools/count/Count.jet"}), [String]{"count"})
    assert_eq(switched_entries(entries, [String]{"Tools/sum/Sum.jet", "{ENTRIES_ROOT}/sum/entry.json"}), [String]{})
}

#Test("a planted read sees its own checkout under an exported GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE; a caller read follows them") {
    decoy: planted_repo()
    plant(decoy, "Tools/decoy/fetch.py", "print(0)\n")
    bare: files.mkdtemp("script-pairing-tree") ?? panic("a temporary directory cannot be made: {err}")
    names: ["GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE"]
    saved: names.map(name -> sys.get(name))
    sys.set("GIT_DIR", "{decoy}/.git")
    sys.set("GIT_INDEX_FILE", "{decoy}/.git/index")
    sys.set("GIT_WORK_TREE", decoy)
    dir: planted_repo()
    plant(dir, "Tools/stray/report.mjs", "console.log(1)\n")
    added: added_files(dir, "HEAD", .Own) ?? [String]{err.message}
    listed: checkout_files(dir, .Own) ?? [String]{err.message}
    followed: added_files(bare, "HEAD", .Caller) ?? [String]{err.message}
    loop index in 0..<names.len() {
        if saved[index] == {
            .Val(value) -> sys.set(names[index], value)
            .None -> sys.unset(names[index]) ?? false
        }
    }
    assert_eq(added, [String]{"Tools/stray/report.mjs"})
    assert_eq(listed, [String]{"README.md", "Tools/stray/report.mjs"})
    assert_eq(followed, [String]{"Tools/decoy/fetch.py"})
    loop path in [dir, decoy, bare] -> files.remove_all(path) ?? ()
}
