#!/usr/bin/env bash
# Run one command in Jet's core shell, reusing nix-direnv's cache when present.
# `jet-env full <cmd>` selects FFI/browser/VM integration tooling.
# A tool that needs only jet or node runs without it; it is for the commands
# that need host tools Jet does not supply yet: the runtime pack's C toolchain
# (cc, ar, nm, crt files, a static musl), suite rows that require host tools,
# and GNU as for the fault report.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="core"
if [ "${1:-}" = "full" ]; then
  profile="full"
  shift
elif [ "${1:-}" = "proof" ]; then
  profile="proof"
  shift
fi
if [ "$#" -eq 0 ]; then
  echo "usage: Tools/agent/jet-env [full] <command> [args...]" >&2
  exit 64
fi
# The development command means the admitted native compiler named by $JET,
# not the prebuilt Jet package the Nix shell may also put on PATH.
if [ "$1" = "jet" ] && [ -n "${JET:-}" ]; then
  shift
  set -- "$JET" "$@"
fi

# /tmp is RAM-backed tmpfs on this machine; build output or test scratch there
# fills swap and triggers kernel OOM kills. Check after every environment
# boundary: direnv and nix can import these variables after the outer process
# starts.
check_scratch_dirs() {
  local name value resolved
  for name in JET_SCRATCH_ROOT JET_TEST_SCRATCH_DIR JET_DEV_ORACLE_CACHE_DIR CARGO_TARGET_DIR; do
    value="${!name:-}"
    [ -n "$value" ] || continue
    resolved="$(realpath -m -- "$value")"
    case "$resolved" in
      /tmp|/tmp/*)
        echo "jet-env: $name=$value is on tmpfs /tmp (RAM-backed)." >&2
        echo "jet-env: artifacts there cause OOM crashes; use the configured disk-backed scratch filesystem." >&2
        exit 64
        ;;
    esac
  done
}

# Apply after direnv/nix as well: shell imports may replace the caller's
# environment. A machine-wide fan-out of foreign helper builds (user Rust FFI,
# measured peers) can exhaust shared RAM.
ensure_command_resources() {
  export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
}

check_scratch_dirs

# `direnv export` returns cached environment assignments when `.envrc` has
# been allowed. Execute the requested command once; never fall back after its
# own failure, which would duplicate writes/tests.
if command -v direnv >/dev/null 2>&1; then
  if env_dump="$(cd "$repo" && JET_DEV_SHELL="$profile" direnv export bash 2>/dev/null)"; then
    eval "$env_dump"
    check_scratch_dirs
    ensure_command_resources
    exec "$@"
  fi
fi

# Inside `nix develop`, re-enter this script's cache selection via bash -c so
# the check sees the shell's PATH.
joined="$(printf '%q ' "$@")"
if [ "$profile" = "full" ] || [ "$profile" = "proof" ]; then
  flake_shell="$profile"
else
  flake_shell="default"
fi

# The shell depends only on flake.nix and flake.lock: the dev shells never read
# `self`, and the shell hook derives JET_ROOT from its working directory at run
# time. So the cached profile is keyed on those two files' content and built
# from a snapshot holding just them. A flake change then costs one small store
# copy machine-wide, where evaluating "${repo}#…" copied the whole checkout per
# tree. Native profiles retain the shell's toolchain across GC.
cache_key="$({ sha256sum < "$repo/flake.nix"; sha256sum < "$repo/flake.lock"; } | sha256sum)"
cache_key="${cache_key%% *}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/jet/dev-shells"
cached_shell="$cache_dir/${cache_key}-$flake_shell"
if [ ! -e "$cached_shell" ]; then
  mkdir -p "$cache_dir"
  snapshot="$cache_dir/src-$cache_key"
  # One builder per key; the lock is released before the requested command runs.
  (
    flock 9
    if [ ! -e "$cached_shell" ]; then
      if [ ! -d "$snapshot" ]; then
        staging="$(mktemp -d "$cache_dir/.src-$cache_key.XXXXXX")"
        cp -- "$repo/flake.nix" "$repo/flake.lock" "$staging/"
        mv -T -- "$staging" "$snapshot"
      fi
      cd -- "$repo"
      nix develop --profile "$cached_shell" "path:$snapshot#$flake_shell" -c true
    fi
  ) 9> "$snapshot.lock"
fi
shell_args=("$cached_shell")
# The shell hook derives JET_ROOT from its working directory (git toplevel,
# else $PWD) and runs "$JET_ROOT/Tools/agent/clean-nix-tmp.sh", so enter the
# shell from this checkout and return to the caller's directory for the command.
caller_dir="$PWD"
cd -- "$repo"
exec nix develop "${shell_args[@]}" -c bash --noprofile --norc -c "cd -- $(printf %q "$caller_dir") || exit 64; $(declare -f check_scratch_dirs ensure_command_resources); check_scratch_dirs; ensure_command_resources; exec $joined"
