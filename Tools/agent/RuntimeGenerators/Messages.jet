        MessageLiteral{name: "live_schema", text: "],\"schema_version\":1,\"pid\":"},
        MessageLiteral{name: "live_start", text: ",\"start_id\":\""},
        MessageLiteral{name: "live_captured", text: "\",\"captured_ms\":"},
        MessageLiteral{name: "live_tasks", text: ",\"tasks\":["},
        MessageLiteral{name: "live_events", text: "],\"event_observations\":["},
