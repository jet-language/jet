// The runtime's generated message tables, from their one source each.
// Usage: jet run Tools/agent/RuntimeGenerators -- [--check] [--defects-only]
//   (default)        rewrite every stale output
//   --check          write nothing; report every stale output
//   --defects-only   regenerate only the private trap defect rows, refusing
//                    when the frozen ordinary trap projection differs
use core.files as files
use core.process as process
use core.term as term

struct GeneratedFile {
    path: String
    text: String
}

// The file's text, or None when it does not exist.
fn read_output(path: String) -[FS]> String? GeneratorError! {
    if !files.exists(path) -> return Ok(None)
    text :: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
    Ok(Val(text))
}

fn output_current(path: String, expected: String) -[FS]> Bool GeneratorError! {
    if read_output(path) == {
        .Ok(found) -> if found == {
            .Val(text) -> return Ok(text == expected)
            .None -> return Ok(false)
        }
        .Err(error) -> return Err(error)
    }
}

fn write_output(path: String, text: String) GeneratorError! {
    files.write(path, text) ?? return Err(generator_fail("cannot write {path}: {err}"))
}

fn runtime_generators_main(args: [String]) -[FS]> String GeneratorError! {
    check := false
    defects_only := false
    loop arg in args {
        if {
            arg == "--check" -> check = true
            arg == "--defects-only" -> defects_only = true
            else -> return Err(generator_fail("usage: jet run Tools/agent/RuntimeGenerators -- [--check] [--defects-only]"))
        }
    }
    registry :: files.read(REGISTRY_PATH) ?? return Err(generator_fail("cannot read {REGISTRY_PATH}: {err}"))
    routes :: files.read(ROUTES_PATH) ?? return Err(generator_fail("cannot read {ROUTES_PATH}: {err}"))
    debug :: files.read(DEBUG_PATH) ?? return Err(generator_fail("cannot read {DEBUG_PATH}: {err}"))
    problems := [String]{}
    if render_trap_messages(registry, routes, debug) == {
        .Ok(trap) -> {
            source_current :: output_current(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
            defects_current :: output_current(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
            if trap_messages_plan(check, defects_only, source_current, defects_current) == {
                .Ok(plan) -> {
                    if plan.write_source -> write_output(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
                    if plan.write_defects -> write_output(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
                }
                .Err(error) -> &problems.push(error.message)
            }
        }
        .Err(error) -> &problems.push(error.message)
    }
    if defects_only {
        if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
        return Ok("")
    }
    outputs := [GeneratedFile]{
        GeneratedFile{path: SCHEDULER_TARGET_PATH, text: render_scheduler_messages()},
        GeneratedFile{path: TEST_TARGET_PATH, text: render_test_messages()},
    }
    if render_observe_messages(registry) == {
        .Ok(text) -> &outputs.push(GeneratedFile{path: OBSERVE_TARGET_PATH, text: text})
        .Err(error) -> &problems.push(error.message)
    }
    if render_services_messages(registry) == {
        .Ok(text) -> &outputs.push(GeneratedFile{path: SERVICES_TARGET_PATH, text: text})
        .Err(error) -> &problems.push(error.message)
    }
    loop output in outputs {
        current :: output_current(output.path, output.text) ?? return Err(err)
        if current -> next
        if check {
            &problems.push("{output.path} is stale; run jet run Tools/agent/RuntimeGenerators")
        } else {
            write_output(output.path, output.text) ?? return Err(err)
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    if check -> return Ok("runtime generated messages are current")
    Ok("")
}

fn run() {
    if runtime_generators_main(process.args()) == {
        .Ok(message) -> {
            if message != "" -> print(message)
        }
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}
