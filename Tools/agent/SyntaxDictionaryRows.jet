#!/usr/bin/env jet
// Render the token and marker rows of the syntax dictionary
// (Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet) from the one
// hand-written home of each. A token row's spelling, registry name and kind
// come from JET_HIGHLIGHT_TOKENS, the syntax registry's
// (Compiler/JetFoundation/Data/Syntax) classification of every keyword,
// sigil, operator, literal, built-in and built-in type a user types. A marker
// row comes from a marker struct of Compiler/Prelude/Markers.jet. A keyword
// spelled as a marker name is a marker row; a spelling two registry constants
// share is one row, the first constant's; and a marker whose row
// Tools/agent/OwnedTraitRows.jet renders from Compiler/Prelude/Traits.jet is
// left to that block. A row's meanings are the dictionary's own hand-written
// prose: rendering keeps the meanings the row's token has in the file, and a
// hand-written row outside the blocks whose token the registry now classifies
// moves into its block with its meanings.
// Usage: jet Tools/agent/SyntaxDictionaryRows.jet [--check|--write]
// --check fails when a block differs from what the sources give it;
// --write rewrites the blocks.
use {
    files: core.files
    process: core.process
}

REGISTRY_DIR: "Compiler/JetFoundation/Data/Syntax"
MARKERS_PATH: "Compiler/Prelude/Markers.jet"
DICTIONARY_PATH: "Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet"
HIGHLIGHTS_OPEN: "JET_HIGHLIGHT_TOKENS: [HighlightToken]{{"
TOKENS_OPEN: "    // The tokens of JET_HIGHLIGHT_TOKENS, generated by Tools/agent/SyntaxDictionaryRows.jet; do not edit."
TOKENS_CLOSE: "    // End of the generated tokens."
MARKERS_OPEN: "    // The markers of Compiler/Prelude/Markers.jet, generated by Tools/agent/SyntaxDictionaryRows.jet; do not edit."
MARKERS_CLOSE: "    // End of the generated markers."
TRAITS_OPEN: "    // The trait markers of Compiler/Prelude/Traits.jet, generated by Tools/agent/OwnedTraitRows.jet; do not edit."
TRAITS_CLOSE: "    // End of the generated trait markers."
ROW_OPEN: "    {{token: \""
MEANINGS_FIELD: ", meanings: "
NO_MEANINGS: "[JetCLISyntaxMeaning]{{}}}},"
// The registry every marker row names.
MARKER_REGISTRY: "MARKER_SOURCE"

#Error
SyntaxDictionaryRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> SyntaxDictionaryRowsError Never! {
    SyntaxDictionaryRowsError{message: "syntax dictionary rows: {message}"}
}

// Whether `code` (a byte) is an ASCII letter, digit or underscore.
name_byte: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

// The name `line` opens with: its leading ASCII letters, digits and underscores.
leading_name: fn(line: String) -> String Never! {
    bytes := [U8]{}
    loop byte in line.bytes() {
        if !name_byte(Int{byte}) -> break
        bytes.push(byte)
    }
    String.from_bytes(bytes) ?? ""
}

// Every top-level `NAME: "spelling"` constant of `text`, by name, as written.
read_spellings: fn(text: String, out: &[String:String]) {
    loop line in text.lines() {
        name: leading_name(line)
        if name == "" -> next
        first: Int{name.bytes()[0]}
        if first < 65 || first > 90 -> next
        rest: line.removeprefix(name)
        if !rest.starts_with(": \"") -> next
        literal := [U8]{}
        escaped := false
        closed := false
        loop byte in rest.removeprefix(": \"").bytes() {
            code: Int{byte}
            if !escaped && code == 34 {
                closed = true
                break
            }
            escaped = !escaped && code == 92
            literal.push(byte)
        }
        if closed -> out[name] = String.from_bytes(literal) ?? ""
    }
}

// One JET_HIGHLIGHT_TOKENS row: the constant that spells the token, and its
// highlight class.
HighlightRow: struct {
    name: String
    class: String
}

// The rows of JET_HIGHLIGHT_TOKENS in `text`, in order, or None when `text`
// declares no such list.
read_highlights: fn(text: String) -> [HighlightRow]? Never! {
    opened: text.partition("\n{HIGHLIGHTS_OPEN}\n")
    if opened.sep == "" -> return None
    rows := [HighlightRow]{}
    name := ""
    loop line in opened.tail.lines() {
        if line == "}}" -> break
        entry: line.trim().removesuffix(",")
        if entry.starts_with("text: ") -> name = entry.removeprefix("text: ")
        if entry.starts_with("class: HighlightClass.") {
            rows.push(HighlightRow{name: name, class: entry.removeprefix("class: HighlightClass.")})
            name = ""
        }
    }
    Val(rows)
}

// The dictionary kind of a highlight class, or None for a class it has no kind for.
kind_of_class: fn(class: String) -> String? Never! {
    if class == {
        "KeywordControl" | "KeywordDeclaration" | "KeywordOwnership" | "KeywordOther" -> Val("Keyword")
        "TakeMark" | "Sigil" -> Val("Sigil")
        "Operator" -> Val("Operator")
        "Literal" -> Val("Literal")
        "Builtin" -> Val("Builtin")
        "TypeBuiltin" -> Val("Type")
        else -> None
    }
}

// The marker names `text` (a Prelude marker file) declares: its top-level
// `Name: struct` lines, in order.
read_markers: fn(text: String) -> [String] Never! {
    names := [String]{}
    loop line in text.lines() {
        name: leading_name(line)
        if name != "" && line.removeprefix(name).starts_with(": struct") -> names.push(name)
    }
    names
}

// The text between the `open` and `close` lines of `dictionary`.
block_of: fn(dictionary: String, open: String, close: String) -> String SyntaxDictionaryRowsError! {
    before: dictionary.partition("{open}\n")
    if before.sep == "" -> return Err(rows_fail("{DICTIONARY_PATH} has no `{open.trim()}` line"))
    after: before.tail.partition("{close}\n")
    if after.sep == "" -> return Err(rows_fail("{DICTIONARY_PATH} has no `{close.trim()}` line"))
    if after.tail.contains(open) -> return Err(rows_fail("{DICTIONARY_PATH} has two `{open.trim()}` blocks"))
    Ok(after.head)
}

// `dictionary` with the rows between its `open` and `close` lines replaced by `rows`.
replace_block: fn(dictionary: String, open: String, close: String, rows: String) -> String SyntaxDictionaryRowsError! {
    _: block_of(dictionary, open, close) ?? return Err(err)
    before: dictionary.partition("{open}\n")
    after: before.tail.partition("{close}\n")
    Ok("{before.head}{open}\n{rows}{close}\n{after.tail}")
}

// The token a dictionary row line spells, or "" when `line` is no row.
row_token: fn(line: String) -> String Never! {
    if !line.starts_with(ROW_OPEN) -> return ""
    line.removeprefix(ROW_OPEN).partition("\"").head
}

// The key a row's meanings are kept by: its token, apart for a marker.
row_key: fn(token: String, marker: Bool) -> String Never! {
    if marker -> "#{token}" else -> token
}

// The key of the row on `line`, or "" when `line` is no row.
line_key: fn(line: String) -> String Never! {
    token: row_token(line)
    if token == "" -> return ""
    row_key(token, line.contains("kind: JetCLISyntaxKind.Marker,"))
}

// The meanings of every row of `dictionary`, as written, by row key.
read_meanings: fn(dictionary: String) -> [String:String] Never! {
    meanings := [String:String]{}
    loop line in dictionary.lines() {
        key: line_key(line)
        if key == "" -> next
        written: line.partition(MEANINGS_FIELD)
        if written.sep != "" && meanings.get(key) == None -> meanings[key] = written.tail.copy()
    }
    meanings
}

// The tokens of the rows in `block`.
block_tokens: fn(block: String) -> [String] Never! {
    tokens := [String]{}
    loop line in block.lines() {
        token: row_token(line)
        if token != "" -> tokens.push(token)
    }
    tokens
}

render_row: fn(token: String, display: String, registry: String, kind: String, meanings: [String:String]) -> String Never! {
    written: meanings.get(row_key(token, kind == "Marker")) ?? NO_MEANINGS
    "{ROW_OPEN}{token}\", query: \"{token.lower()}\", display_query: \"{display}\", registry_name: \"{registry}\", kind: JetCLISyntaxKind.{kind}{MEANINGS_FIELD}{written}\n"
}

// `dictionary` without the rows outside its generated blocks whose key is in
// `generated`: a hand-written row the registry now gives a block.
drop_moved_rows: fn(dictionary: String, generated: [String:Int]) -> String Never! {
    kept := [String]{}
    inside := false
    loop line in dictionary.split("\n") {
        if line == TOKENS_OPEN || line == MARKERS_OPEN || line == TRAITS_OPEN -> inside = true
        if line == TOKENS_CLOSE || line == MARKERS_CLOSE || line == TRAITS_CLOSE -> inside = false
        if !inside && generated.get(line_key(line)) != None -> next
        kept.push(line.copy())
    }
    kept.join("\n")
}

// `dictionary` with its token and marker blocks rendered from `registry`
// (the texts of the syntax registry's files) and `markers_text` (the Prelude
// marker file).
render_dictionary: fn(registry: [String], markers_text: String, dictionary: String) -> String SyntaxDictionaryRowsError! {
    spellings := [String:String]{}
    highlights := [HighlightRow]{}
    lists := 0
    loop text in registry {
        read_spellings(text, spellings)
        if read_highlights(text) == .Val(rows) {
            highlights = rows
            lists += 1
        }
    }
    if lists != 1 -> return Err(rows_fail("{REGISTRY_DIR} declares JET_HIGHLIGHT_TOKENS {lists} times, not once"))
    markers := read_markers(markers_text)
    if markers.len() == 0 -> return Err(rows_fail("{MARKERS_PATH} declares no marker structs"))
    meanings: read_meanings(dictionary)
    generated := [String:Int]{}
    token_rows := ""
    loop row in highlights {
        spelling: spellings.get(row.name) ?? return Err(rows_fail("JET_HIGHLIGHT_TOKENS names {row.name}, which no spelling in {REGISTRY_DIR} declares"))
        kind: kind_of_class(row.class) ?? return Err(rows_fail("JET_HIGHLIGHT_TOKENS gives {row.name} the class {row.class}, which no dictionary kind stands for"))
        if kind == "Keyword" && markers.contains(spelling) -> next
        if generated.get(spelling) != None -> next
        generated[spelling] = 1
        token_rows = "{token_rows}{render_row(spelling, spelling.lower(), row.name, kind, meanings)}"
    }
    traits: block_tokens(block_of(dictionary, TRAITS_OPEN, TRAITS_CLOSE) ?? return Err(err))
    markers.sort()
    marker_rows := ""
    loop name in markers {
        if traits.contains(name) -> next
        generated[row_key(name, true)] = 1
        marker_rows = "{marker_rows}{render_row(name, "#{name.lower()}", MARKER_REGISTRY, "Marker", meanings)}"
    }
    with_tokens: replace_block(dictionary, TOKENS_OPEN, TOKENS_CLOSE, token_rows) ?? return Err(err)
    with_markers: replace_block(with_tokens, MARKERS_OPEN, MARKERS_CLOSE, marker_rows) ?? return Err(err)
    Ok(drop_moved_rows(with_markers, generated))
}

read_text: fn(path: String) -[FS]> String SyntaxDictionaryRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

generated_dictionary: fn() -[FS]> String SyntaxDictionaryRowsError! {
    entries: files.list_dir(REGISTRY_DIR) ?? return Err(rows_fail("cannot list {REGISTRY_DIR}: {err}"))
    names := [String]{}
    loop entry in entries {
        if entry.name.ends_with(".jet") -> names.push(entry.name.copy())
    }
    names.sort()
    registry := [String]{}
    loop name in names -> registry.push(read_text("{REGISTRY_DIR}/{name}") ?? return Err(err))
    markers_text: read_text(MARKERS_PATH) ?? return Err(err)
    dictionary: read_text(DICTIONARY_PATH) ?? return Err(err)
    render_dictionary(registry, markers_text, dictionary)
}

syntax_dictionary_rows_main: fn(args: [String]) -[FS]> String SyntaxDictionaryRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: SyntaxDictionaryRows.jet [--check|--write]"))
    generated: generated_dictionary() ?? return Err(err)
    current: read_text(DICTIONARY_PATH) ?? return Err(err)
    if current == generated -> return Ok("syntax dictionary rows check passed: {DICTIONARY_PATH} matches")
    if mode == "--write" {
        files.write(DICTIONARY_PATH, generated) ?? return Err(rows_fail("cannot write {DICTIONARY_PATH}: {err}"))
        return Ok("syntax dictionary rows written: {DICTIONARY_PATH}")
    }
    Err(rows_fail("{DICTIONARY_PATH} differs from JET_HIGHLIGHT_TOKENS or {MARKERS_PATH}; run jet Tools/agent/SyntaxDictionaryRows.jet --write"))
}

run: fn() { print(syntax_dictionary_rows_main(process.args()) ?? process.fail(1, err.message)) }

MINIMAL_REGISTRY: "KW_FN: \"fn\" // a function\nKW_UNSAFE: \"Unsafe\"\nOP_AND: \"&&\"\nSIGIL_MOVE: \"&&\"\nTYPE_SHARED: \"Shared\"\n{HIGHLIGHTS_OPEN}\n    // Declarations\n    {{\n        text: KW_FN,\n        class: HighlightClass.KeywordDeclaration,\n    }},\n    {{\n        text: KW_UNSAFE,\n        class: HighlightClass.KeywordDeclaration,\n    }},\n    {{\n        text: OP_AND,\n        class: HighlightClass.Operator,\n    }},\n    {{\n        text: SIGIL_MOVE,\n        class: HighlightClass.TakeMark,\n    }},\n    {{\n        text: TYPE_SHARED,\n        class: HighlightClass.TypeBuiltin,\n    }},\n}}\n"
MINIMAL_MARKERS: "Unsafe: struct {{\n}}\n\n// Hidden: struct {{ }}\nShared: struct {{\n}}\nCodable: struct {{\n}}\nAs: struct {{\n    impl Marker {{ sites: [.Field] }}\n}}\n"
MINIMAL_DICTIONARY: "ROWS: [Row]{{\n{TOKENS_OPEN}\n    {{token: \"fn\", query: \"fn\", display_query: \"fn\", registry_name: \"KW_FN\", kind: JetCLISyntaxKind.Keyword, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{text: \"Declares a function.\"}}}}}},\n{TOKENS_CLOSE}\n    {{token: \"&&\", query: \"&&\", display_query: \"&&\", registry_name: \"OP_AND\", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{text: \"Both.\"}}}}}},\n    {{token: \"after\"}},\n{MARKERS_OPEN}\n{MARKERS_CLOSE}\n{TRAITS_OPEN}\n    {{token: \"Codable\", query: \"codable\"}},\n{TRAITS_CLOSE}\n}}\n"

// The error text render_dictionary reports, or "" when it renders.
render_error: fn(registry: String, markers: String, dictionary: String) -> String Never! {
    if render_dictionary([String]{registry}, markers, dictionary) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the dictionary's token and marker rows match their sources") {
    if syntax_dictionary_rows_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("a token row keeps its meanings, a shared spelling is one row, and a keyword spelled as a marker is a marker row") {
    rendered: render_dictionary([String]{MINIMAL_REGISTRY}, MINIMAL_MARKERS, MINIMAL_DICTIONARY) ?? panic(err.message)
    tokens: "{TOKENS_OPEN}\n    {{token: \"fn\", query: \"fn\", display_query: \"fn\", registry_name: \"KW_FN\", kind: JetCLISyntaxKind.Keyword, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{text: \"Declares a function.\"}}}}}},\n    {{token: \"&&\", query: \"&&\", display_query: \"&&\", registry_name: \"OP_AND\", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{text: \"Both.\"}}}}}},\n    {{token: \"Shared\", query: \"shared\", display_query: \"shared\", registry_name: \"TYPE_SHARED\", kind: JetCLISyntaxKind.Type, meanings: [JetCLISyntaxMeaning]{{}}}},\n{TOKENS_CLOSE}\n    {{token: \"after\"}},\n"
    assert(rendered.contains(tokens), rendered)
    markers: "{MARKERS_OPEN}\n    {{token: \"As\", query: \"as\", display_query: \"#as\", registry_name: \"MARKER_SOURCE\", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{{}}}},\n    {{token: \"Shared\", query: \"shared\", display_query: \"#shared\", registry_name: \"MARKER_SOURCE\", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{{}}}},\n    {{token: \"Unsafe\", query: \"unsafe\", display_query: \"#unsafe\", registry_name: \"MARKER_SOURCE\", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{{}}}},\n{MARKERS_CLOSE}\n{TRAITS_OPEN}\n    {{token: \"Codable\", query: \"codable\"}},\n"
    assert(rendered.contains(markers), rendered)
    // The hand-written `&&` row moved into the block; rendering twice changes nothing.
    assert(!rendered.contains("{TOKENS_CLOSE}\n    {{token: \"&&\""), rendered)
    assert_eq(render_dictionary([String]{MINIMAL_REGISTRY}, MINIMAL_MARKERS, rendered) ?? panic(err.message), rendered)
}

#Test("a source the rows cannot come from is refused") {
    assert(render_error(MINIMAL_REGISTRY.replace("text: TYPE_SHARED,", "text: TYPE_WHEN,"), MINIMAL_MARKERS, MINIMAL_DICTIONARY).contains("JET_HIGHLIGHT_TOKENS names TYPE_WHEN, which no spelling"))
    assert(render_error(MINIMAL_REGISTRY.replace("HighlightClass.TypeBuiltin", "HighlightClass.Shade"), MINIMAL_MARKERS, MINIMAL_DICTIONARY).contains("the class Shade, which no dictionary kind"))
    assert(render_error(MINIMAL_REGISTRY.replace("JET_HIGHLIGHT_TOKENS", "OTHER_TOKENS"), MINIMAL_MARKERS, MINIMAL_DICTIONARY).contains("declares JET_HIGHLIGHT_TOKENS 0 times"))
    assert(render_error(MINIMAL_REGISTRY, "// none\n", MINIMAL_DICTIONARY).contains("declares no marker structs"))
    assert(render_error(MINIMAL_REGISTRY, MINIMAL_MARKERS, MINIMAL_DICTIONARY.replace("{MARKERS_CLOSE}\n", "")).contains("has no `// End of the generated markers.` line"))
}
