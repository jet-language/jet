#!/usr/bin/env jet
// Render each package's closed vocabularies from their one declaration: the
// package's Vocabulary.tsv (Compiler/<Package>/Vocabulary.tsv or
// Jetpack/<Package>/Vocabulary.tsv) holds one row per variant, and this tool
// writes the enum declarations to the package's Source/Vocabulary.jet. The
// package is flat, so every module reads the enums by name; the module that
// owns a vocabulary keeps its methods (`impl Type { … }`) by hand.
// A row is four tab-separated columns: the type, its markers (`#Error`, the
// same on every row of the type, or empty), the variant, and the variant's
// payload as written (`(name: String)`, or empty). A type's rows are
// contiguous and in declaration order. Lines starting with `#` are comments.
// Usage: jet Tools/agent/VocabularyRows.jet [--check|--write]
// --check fails when a Source/Vocabulary.jet differs from its rows; --write
// rewrites them.
use {
    files: core.files
    process: core.process
    term: core.term
}

PACKAGE_ROOTS: [String]{"Compiler", "Jetpack"}
ROWS_NAME: "Vocabulary.tsv"
OUTPUT_NAME: "Source/Vocabulary.jet"
GENERATED_BY: "// This file is generated by Tools/agent/VocabularyRows.jet; do not edit."
TYPE_NAME: Regex{"^[A-Z][A-Za-z0-9]*$"}
MARKER: Regex{"^#[A-Z][A-Za-z0-9]*$"}

#Error
VocabularyRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> VocabularyRowsError Never! {
    VocabularyRowsError{message: "vocabulary rows: {message}"}
}

VocabularyVariant: struct {
    name: String
    payload: String
}

VocabularyType: struct {
    name: String
    markers: String
    variants: [VocabularyVariant]
}

// One package's rows file and the file generated from it.
VocabularyFile: struct {
    rows_path: String
    output_path: String
}

// The vocabulary types `text` (a Vocabulary.tsv read from `path`) declares.
vocabulary_types: fn(path: String, text: String) -> [VocabularyType] VocabularyRowsError! {
    types := [VocabularyType]{}
    seen := [String]{}
    loop (index, line) in text.lines() {
        if line == "" || line.starts_with("#") -> next
        at: "{path}:{index + 1}"
        columns: line.split("\t").to_list()
        if columns.len() != 4 -> return Err(rows_fail("{at}: a row has 4 tab-separated columns (type, markers, variant, payload)"))
        type_name: columns[0]
        markers: columns[1]
        variant: columns[2]
        payload: columns[3]
        if !TYPE_NAME.is_match(type_name) -> return Err(rows_fail("{at}: `{type_name}` is not a type name"))
        if !TYPE_NAME.is_match(variant) -> return Err(rows_fail("{at}: `{variant}` is not a variant name"))
        if markers != "" {
            loop marker in markers.split(" ").to_list() {
                if !MARKER.is_match(marker) -> return Err(rows_fail("{at}: `{marker}` is not a marker"))
            }
        }
        if payload != "" && !(payload.starts_with("(") && payload.ends_with(")")) -> return Err(rows_fail("{at}: the payload `{payload}` is not a parenthesized field list"))
        if types.len() > 0 && types[types.len() - 1].name == type_name {
            last := types[types.len() - 1]
            if last.markers != markers -> return Err(rows_fail("{at}: `{type_name}` has different markers on different rows"))
            loop known in last.variants {
                if known.name == variant -> return Err(rows_fail("{at}: `{type_name}.{variant}` is declared twice"))
            }
            last.variants.push(VocabularyVariant{name: variant, payload: payload})
            types[types.len() - 1] = last
            next
        }
        if seen.contains(type_name) -> return Err(rows_fail("{at}: the rows of `{type_name}` are not contiguous"))
        seen.push(type_name.copy())
        types.push(VocabularyType{name: type_name, markers: markers, variants: [VocabularyVariant]{VocabularyVariant{name: variant, payload: payload}}})
    }
    if types.len() == 0 -> return Err(rows_fail("{path} declares no vocabulary"))
    Ok(types)
}

// The generated Source/Vocabulary.jet of the package whose rows are `rows_path`.
render_vocabulary: fn(rows_path: String, types: [VocabularyType]) -> String Never! {
    out := "{GENERATED_BY}\n// The closed vocabularies declared one row per variant in {rows_path};\n// the module that owns each vocabulary keeps its methods.\n"
    loop vocabulary in types {
        out = "{out}\n"
        if vocabulary.markers != "" {
            loop marker in vocabulary.markers.split(" ").to_list() -> out = "{out}{marker}\n"
        }
        out = "{out}{vocabulary.name}: enum {{\n"
        loop variant in vocabulary.variants -> out = "{out}    {variant.name}{variant.payload}\n"
        out = "{out}}}\n"
    }
    out
}

// Every package under PACKAGE_ROOTS with a Vocabulary.tsv, in path order.
vocabulary_files: fn() -[FS]> [VocabularyFile] VocabularyRowsError! {
    found := [VocabularyFile]{}
    loop root in PACKAGE_ROOTS {
        listed := files.list_dir(root) ?? return Err(rows_fail("cannot list {root}: {err}"))
        listed.sort_by((left: DirEntry, right: DirEntry) -> left.name <=> right.name)
        loop entry in listed {
            if !entry.is_dir -> next
            rows_path: "{root}/{entry.name}/{ROWS_NAME}"
            if !files.is_file(rows_path) -> next
            if !files.is_dir("{root}/{entry.name}/Source") -> return Err(rows_fail("{rows_path} has no Source directory beside it"))
            found.push(VocabularyFile{rows_path: rows_path, output_path: "{root}/{entry.name}/{OUTPUT_NAME}"})
        }
    }
    Ok(found)
}

vocabulary_rows_main: fn(args: [String]) -[FS]> String VocabularyRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: jet Tools/agent/VocabularyRows.jet [--check|--write]"))
    stale := [String]{}
    count := 0
    loop file in (vocabulary_files() ?? return Err(err)) {
        text: files.read(file.rows_path) ?? return Err(rows_fail("cannot read {file.rows_path}: {err}"))
        types: vocabulary_types(file.rows_path, text) ?? return Err(err)
        count += types.len()
        generated: render_vocabulary(file.rows_path, types)
        current: files.read(file.output_path) ?? ""
        if current == generated -> next
        if mode == "--write" {
            files.write(file.output_path, generated) ?? return Err(rows_fail("cannot write {file.output_path}: {err}"))
        } else {
            stale.push(file.output_path.copy())
        }
    }
    if stale.len() > 0 -> return Err(rows_fail("{stale.join(", ")} differ from their Vocabulary.tsv; run jet Tools/agent/VocabularyRows.jet --write"))
    if mode == "--write" -> return Ok("vocabulary rows written ({count} vocabularies)")
    Ok("vocabulary rows check passed ({count} vocabularies)")
}

run: fn() {
    if vocabulary_rows_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The error text vocabulary_types reports for `text`, or "" when it accepts it.
vocabulary_rows_error: fn(text: String) -> String Never! {
    if vocabulary_types("t.tsv", text) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("vocabulary rows render contiguous enums and reject malformed rows") {
    rows: "# comment\nPhase\t\tReady\t\nPhase\t\tPaused\t\nFault\t#Error\tTimeout\t(after_ms: Int)\n"
    types: vocabulary_types("t.tsv", rows) ?? panic("the rows did not parse: {err.message}")
    assert_eq(types.len(), 2)
    rendered: render_vocabulary("t.tsv", types)
    assert(rendered.starts_with(GENERATED_BY))
    assert(rendered.contains("\nPhase: enum {{\n    Ready\n    Paused\n}}\n"))
    assert(rendered.contains("\n#Error\nFault: enum {{\n    Timeout(after_ms: Int)\n}}\n"))
    assert(vocabulary_rows_error("Phase\tReady\t\n").contains("4 tab-separated columns"))
    assert(vocabulary_rows_error("phase\t\tReady\t\n").contains("not a type name"))
    assert(vocabulary_rows_error("Phase\t\tReady\t\nPhase\t\tReady\t\n").contains("declared twice"))
    assert(vocabulary_rows_error("Phase\t\tReady\t\nFault\t\tTimeout\t\nPhase\t\tPaused\t\n").contains("not contiguous"))
    assert(vocabulary_rows_error("Fault\t#Error\tTimeout\t\nFault\t\tCrash\t\n").contains("different markers"))
    assert(vocabulary_rows_error("Fault\tError\tTimeout\t\n").contains("not a marker"))
    assert(vocabulary_rows_error("Fault\t\tTimeout\tafter_ms: Int\n").contains("parenthesized"))
    assert(vocabulary_rows_error("# only a comment\n").contains("declares no vocabulary"))
}

#Test("every package's generated vocabulary matches its rows") {
    loop file in (vocabulary_files() ?? panic(err.message)) {
        text: files.read(file.rows_path) ?? panic("cannot read {file.rows_path}")
        types: vocabulary_types(file.rows_path, text) ?? panic(err.message)
        assert_eq(files.read(file.output_path) ?? "", render_vocabulary(file.rows_path, types))
    }
}
