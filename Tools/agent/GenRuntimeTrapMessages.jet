// Heap-free runtime stop literals. Keep the active diagnostic registry as the
// source of row prose; emitted words use the audited stack-write OS leaf.
// Usage: jet run Tools/agent/GenRuntimeTrapMessages.jet -- [--check] [--defects-only]
package {
    name: "gen-runtime-trap-messages"
    version: "0.1.0"
    edition: "2026"
    authority: {
        holds: {
            allow: [Exec, Exec.Args, FS.Read, FS.Write, IO, Mem]
        }
    }
}

use core.files as files
use core.process as process
use core.term as term

REGISTRY_PATH :: "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet"
TARGET_PATH :: "Compiler/JetRuntime/Source/TrapMessages.jet"
DEFECT_TARGET_PATH :: "Compiler/JetRuntime/Source/TrapDefectMessages.jet"
ROUTES_PATH :: "Compiler/JetBackend/Source/Lower/Routes.jet"
DEBUG_PATH :: "Compiler/JetFoundation/Source/Text/RustDebug.jet"
GENERATED_BY :: "// Generated by Tools/agent/GenRuntimeTrapMessages.jet; do not hand-edit.\n"

#Error
struct TrapMessagesError {
    message: String
}

struct TrapLiteral {
    name: String
    text: String
}

// Bytes `start..<end` of `text`; String.find reports byte offsets.
fn byte_slice(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

fn byte_len(text: String) -> Int Never! { text.bytes().len() }

fn trap_fail(message: String) -> TrapMessagesError Never! {
    TrapMessagesError{message: message}
}

// The value of the quoted literal that starts at `text`'s first byte (a `"`),
// and the byte length of its source spelling.
struct QuotedLiteral {
    value: String
    spelling_len: Int
}

fn quoted_literal(text: String) -> QuotedLiteral? Never! {
    bytes :: text.bytes()
    if bytes.len() == 0 || Int.from_u8(bytes[0]) != 34 -> return None
    out := [U8]{}
    index := 1
    loop index < bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == 34 -> return Val(QuotedLiteral{value: String.from_bytes_lossy(out), spelling_len: index + 1})
        if code == 92 {
            if index + 1 >= bytes.len() -> return None
            escaped :: Int.from_u8(bytes[index + 1])
            if {
                escaped == 34 || escaped == 92 -> &out.push(bytes[index + 1])
                escaped == 110 -> &out.push(U8.from_int(10) ?? return None)
                escaped == 116 -> &out.push(U8.from_int(9) ?? return None)
                escaped == 114 -> &out.push(U8.from_int(13) ?? return None)
                else -> return None
            }
            index += 2
            next
        }
        &out.push(bytes[index])
        index += 1
    }
    None
}

// The `name` field of the registry row for `code`, with `{{`/`}}` unescaped.
fn registry_field(registry: String, code: String, name: String) -> String TrapMessagesError! {
    marker :: "\n        code: \"{code}\","
    start :: registry.find(marker)
    if start < 0 -> return Err(trap_fail("missing runtime row {code}"))
    before :: byte_slice(registry, 0, start)
    if !before.ends_with("DiagnosticRegistryRow{{") && !before.ends_with("\n    {{") -> return Err(trap_fail("missing runtime row {code}"))
    rest :: byte_slice(registry, start + byte_len(marker), byte_len(registry))
    end := byte_len(rest)
    next_named :: rest.find("DiagnosticRegistryRow{{")
    if next_named >= 0 && next_named < end -> end = next_named
    next_plain :: rest.find("\n    {{\n        code:")
    if next_plain >= 0 && next_plain < end -> end = next_plain
    row :: byte_slice(rest, 0, end)
    field_marker :: "\n        {name}: "
    at :: row.find(field_marker)
    if at < 0 -> return Err(trap_fail("missing {code}.{name}"))
    after :: byte_slice(row, at + byte_len(field_marker), byte_len(row))
    literal :: quoted_literal(after) ?? return Err(trap_fail("missing {code}.{name}"))
    if !String.from_bytes_lossy(after.bytes()[literal.spelling_len..<after.bytes().len()]).starts_with(",") -> return Err(trap_fail("missing {code}.{name}"))
    Ok(literal.value.replace("{{{{", "{{").replace("}}}}", "}}"))
}

// The native TLS refusal is defined once, in the lowering that reports it at
// compile time; the runtime's stop and String-error leaves use this projection.
fn native_tls_refusal(routes: String) -> String TrapMessagesError! {
    marker :: "\nfn lower_tls_transport_message() -> String Never! {{\n    "
    at :: routes.find(marker)
    if at < 0 -> return Err(trap_fail("missing Lower/Routes.jet lower_tls_transport_message literal"))
    rest :: byte_slice(routes, at + byte_len(marker), byte_len(routes))
    literal :: quoted_literal(rest) ?? return Err(trap_fail("missing Lower/Routes.jet lower_tls_transport_message literal"))
    if !String.from_bytes_lossy(rest.bytes()[literal.spelling_len..<rest.bytes().len()]).starts_with("\n}}") -> return Err(trap_fail("missing Lower/Routes.jet lower_tls_transport_message literal"))
    if literal.value == "" -> return Err(trap_fail("native TLS refusal must be printable ASCII for word projection"))
    loop byte in literal.value.bytes() {
        code :: Int.from_u8(byte)
        if code < 32 || code > 126 -> return Err(trap_fail("native TLS refusal must be printable ASCII for word projection"))
    }
    Ok(literal.value)
}

// The little-endian signed machine word of bytes `start..<end` (at most 8):
// a signed literal preserves all eight bytes.
fn packed_word(bytes: [U8], start: Int, end: Int) -> Int Never! {
    word := 0
    scale := 1
    loop index in start..<end {
        byte :: Int.from_u8(bytes[index])
        // Only the eighth byte carries the sign; its weight is 2^56.
        if index - start == 7 && byte >= 128 {
            word += (byte - 256) * scale
        } else {
            word += byte * scale
        }
        if index - start < 7 -> scale *= 256
    }
    word
}

fn emit(name: String, text: String, sink: String) -> String Never! {
    bytes :: text.bytes()
    out := "fn {name}() {{\n"
    owned := "fn trap_build_{byte_slice(name, 5, byte_len(name))}(builder: I64) {{\n"
    at := 0
    loop at < bytes.len() {
        end :: if at + 8 < bytes.len() -> at + 8 else -> bytes.len()
        word :: packed_word(bytes, at, end)
        out = "{out}    {sink}(I64{{{word}}}, I64{{{end - at}}})\n"
        if sink == "trap_write_word" -> owned = "{owned}    rt_text_push_word(builder, I64{{{word}}}, I64{{{end - at}}})\n"
        at += 8
    }
    if sink == "trap_write_word" -> return "{out}}}\n\n{owned}}}\n"
    "{out}}}\n"
}

// Text before / after the `{msg}` hole of a registry template.
fn before_hole(text: String) -> String Never! {
    at :: text.find("{{msg}}")
    if at < 0 -> text else -> byte_slice(text, 0, at)
}

fn after_hole(text: String) -> String Never! {
    at :: text.find("{{msg}}")
    if at < 0 -> "" else -> byte_slice(text, at + byte_len("{{msg}}"), byte_len(text))
}

// The canonical Rust Debug escaped-interval table, as numbers.
fn debug_intervals(debug: String) -> [Int] TrapMessagesError! {
    open :: debug.find("[Int]{{")
    if open < 0 -> return Err(trap_fail("missing Rust Debug scalar interval table"))
    rest :: byte_slice(debug, open + byte_len("[Int]{{"), byte_len(debug))
    // The body runs to the first `}` followed by optional space and `}`.
    body_end := -1
    search := 0
    loop {
        close :: byte_slice(rest, search, byte_len(rest)).find("}}")
        if close < 0 -> break
        at :: search + close
        after :: byte_slice(rest, at + 1, byte_len(rest)).trim_start()
        if after.starts_with("}}") {
            body_end = at
            break
        }
        search = at + 1
    }
    if body_end < 0 -> return Err(trap_fail("missing Rust Debug scalar interval table"))
    values := [Int]{}
    current := -1
    loop byte in byte_slice(rest, 0, body_end).bytes() {
        code :: Int.from_u8(byte)
        if code >= 48 && code <= 57 {
            current = if current < 0 -> code - 48 else -> current * 10 + code - 48
        } else if current >= 0 {
            &values.push(current)
            current = -1
        }
    }
    if current >= 0 -> &values.push(current)
    if values.len() % 2 != 0 -> return Err(trap_fail("invalid Rust Debug intervals"))
    loop index in 1..<values.len() {
        if values[index] < values[index - 1] -> return Err(trap_fail("invalid Rust Debug intervals"))
    }
    Ok(values)
}

struct TrapOutputs {
    source: String
    defects: String
}

fn render_trap_messages(registry: String, routes: String, debug: String) -> TrapOutputs TrapMessagesError! {
    source := "{GENERATED_BY}// Word constants are little-endian UTF-8. No String carrier, allocation,\n// mutable global, or numeric runtime is reached while writing these rows.\n\n"
    loop code in ["E3001", "E3010", "E3011", "E0128"] {
        why :: registry_field(registry, code, "why") ?? return Err(err)
        fix :: registry_field(registry, code, "fix") ?? return Err(err)
        source = "{source}// {code} Why: {why}\n// Fix: {fix}\n"
        source = "{source}{emit("trap_footer_{code.lower()}", " Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{code}\n", "trap_write_word")}\n"
    }
    e3001_what :: registry_field(registry, "E3001", "what") ?? return Err(err)
    e3010_what :: registry_field(registry, "E3010", "what") ?? return Err(err)
    e0128_what :: registry_field(registry, "E0128", "what") ?? return Err(err)
    layout_what :: if e3001_what.find("{{msg}}") < 0 -> e3001_what else -> "{before_hole(e3001_what)}invalid box layout{after_hole(e3001_what)}"
    source = "{source}{emit("trap_invalid_layout_head", "Stop [E3001]: {layout_what}\n  --> <core.prelude>:0\n", "trap_write_word")}"
    tls :: native_tls_refusal(routes) ?? return Err(err)
    literals :: [TrapLiteral]{
        TrapLiteral{name: "header_panic", text: "Stop [E3001]: {before_hole(e3001_what)}"},
        TrapLiteral{name: "header_numeric", text: "Stop [E3010]: {before_hole(e3010_what)}"},
        TrapLiteral{name: "header_todo", text: "Stop [E3011]: `"},
        TrapLiteral{name: "header_zip", text: "Stop [E0128]: {before_hole(e0128_what)}"},
        TrapLiteral{name: "zip_end", text: "{after_hole(e0128_what)}\n"},
        TrapLiteral{name: "collections_end", text: "`\n  --> <core.collections>:0\n"},
        TrapLiteral{name: "sequence_count", text: "sequence count must be nonnegative"},
        TrapLiteral{name: "sequence_step", text: "step_by requires a positive step"},
        TrapLiteral{name: "sequence_chunks", text: "chunks requires a positive size"},
        TrapLiteral{name: "sequence_windows", text: "windows requires a positive size"},
        TrapLiteral{name: "cursor_step", text: "iterator loop stride must be positive"},
        TrapLiteral{name: "cursor_exhausted", text: "iterator loop value requested after exhaustion"},
        TrapLiteral{name: "location", text: "  --> "},
        TrapLiteral{name: "colon", text: ":"},
        TrapLiteral{name: "in_function", text: " in "},
        TrapLiteral{name: "newline", text: "\n"},
        TrapLiteral{name: "space", text: " "},
        TrapLiteral{name: "gutter_line", text: "|\n"},
        TrapLiteral{name: "gutter_source", text: " | "},
        TrapLiteral{name: "gutter_caret", text: "| "},
        TrapLiteral{name: "caret", text: "^"},
        TrapLiteral{name: "message_end", text: "`\n"},
        TrapLiteral{name: "prelude_end", text: "`\n  --> <core.prelude>:0\n"},
        TrapLiteral{name: "overflow", text: "This arithmetic overflows the value's type (the result is outside its range)"},
        TrapLiteral{name: "divide_zero", text: "divided by zero"},
        TrapLiteral{name: "native_index_range", text: "native Int argument exceeds host range"},
        TrapLiteral{name: "list_head", text: "the list has "},
        TrapLiteral{name: "list_position", text: " items, so position "},
        TrapLiteral{name: "list_end", text: " doesn't exist`\n  --> <core.prelude>:0\n"},
        TrapLiteral{name: "unreachable", text: "internal error: entered unreachable code: "},
        TrapLiteral{name: "locals", text: "locals: "},
        TrapLiteral{name: "todo", text: "#Todo at "},
        TrapLiteral{name: "todo_expected", text: " — expected "},
        TrapLiteral{name: "expected", text: "expected: "},
        TrapLiteral{name: "got", text: ", got: "},
        TrapLiteral{name: "range_head", text: "can't "},
        TrapLiteral{name: "range_slice", text: "slice"},
        TrapLiteral{name: "range_view", text: "view"},
        TrapLiteral{name: "range_items", text: " items from "},
        TrapLiteral{name: "range_to", text: " to "},
        TrapLiteral{name: "range_open", text: " ("},
        TrapLiteral{name: "exclusive", text: "exclusive"},
        TrapLiteral{name: "inclusive", text: "inclusive"},
        TrapLiteral{name: "range_end", text: ")`\n"},
        TrapLiteral{name: "native_tls", text: tls},
    }
    loop literal in literals -> source = "{source}\n{emit("trap_msg_{literal.name}", literal.text, "trap_write_word")}"
    // Retype the canonical Debug interval table at generation time. Runtime
    // arithmetic stays fixed-width; only list indices cross the exact-Int seam.
    values :: debug_intervals(debug) ?? return Err(err)
    source = "{source}\n// Canonical Text/RustDebug.jet intervals, retyped to machine words.\n"
    source = "{source}TRAP_DEBUG_RANGE_COUNT :: prep {{ I64{{{values.len() /% 2}}} }}\n"
    source = "{source}TRAP_DEBUG_RANGES :: prep {{ [I64]{{\n"
    row_start := 0
    loop row_start < values.len() {
        row_end :: if row_start + 12 < values.len() -> row_start + 12 else -> values.len()
        words := [String]{}
        loop index in row_start..<row_end -> &words.push("I64{{{values[index]}}}")
        source = "{source}    {words.join(", ")},\n"
        row_start += 12
    }
    source = "{source}}} }}\n"
    // Both projections use the same canonical facts. Scoped private generation
    // validates the frozen ordinary bytes first; default generation remains the
    // canonical producer for both projections after the frozen gate is lifted.
    defects := "{GENERATED_BY}// NO-TLS host-defect rows: raw stack-word writes only; no capture,\n// String carrier, allocation, callback, mutable global, or numeric runtime.\n\n"
    defects = "{defects}{emit("trap_defect_unreachable_head", "internal error: entered unreachable code: ", "trap_write_word_raw")}"
    defects = "{defects}\n{emit("trap_defect_newline", "\n", "trap_write_word_raw")}"
    Ok(TrapOutputs{source: source, defects: defects})
}

// The file's text, or None when it does not exist.
fn read_output(path: String) -[FS]> String? TrapMessagesError! {
    if !files.exists(path) -> return Ok(None)
    text :: files.read(path) ?? return Err(trap_fail("cannot read {path}: {err}"))
    Ok(Val(text))
}

struct TrapWritePlan {
    write_source: Bool
    write_defects: Bool
    message: String
}

// What one run writes. The ordinary projection is frozen under
// --defects-only: any mismatch there fails before even the private rows are
// written. --check never writes. The default run is the canonical producer of
// both projections.
fn trap_messages_plan(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> TrapWritePlan TrapMessagesError! {
    if defects_only && !source_current -> return Err(trap_fail("TrapMessages.jet differs from canonical facts; frozen output was not written"))
    if check {
        if !source_current -> return Err(trap_fail("TrapMessages.jet is stale; run jet run Tools/agent/GenRuntimeTrapMessages.jet"))
        if !defects_current -> return Err(trap_fail("TrapDefectMessages.jet is stale; run jet run Tools/agent/GenRuntimeTrapMessages.jet"))
        return Ok(TrapWritePlan{write_source: false, write_defects: false, message: "runtime trap messages and private host-defect rows are current"})
    }
    Ok(TrapWritePlan{write_source: !defects_only && !source_current, write_defects: !defects_current, message: ""})
}

fn trap_messages_main(args: [String]) -[FS]> String TrapMessagesError! {
    check := false
    defects_only := false
    loop arg in args {
        if {
            arg == "--check" -> check = true
            arg == "--defects-only" -> defects_only = true
            else -> return Err(trap_fail("usage: GenRuntimeTrapMessages.jet [--check] [--defects-only]"))
        }
    }
    registry :: files.read(REGISTRY_PATH) ?? return Err(trap_fail("cannot read {REGISTRY_PATH}: {err}"))
    routes :: files.read(ROUTES_PATH) ?? return Err(trap_fail("cannot read {ROUTES_PATH}: {err}"))
    debug :: files.read(DEBUG_PATH) ?? return Err(trap_fail("cannot read {DEBUG_PATH}: {err}"))
    outputs :: render_trap_messages(registry, routes, debug) ?? return Err(err)
    source_current :: if read_output(TARGET_PATH) == {
        .Ok(found) -> if found == {
            .Val(text) -> text == outputs.source
            .None -> false
        }
        .Err(error) -> {
            return Err(error)
        }
    }
    defects_current :: if read_output(DEFECT_TARGET_PATH) == {
        .Ok(found) -> if found == {
            .Val(text) -> text == outputs.defects
            .None -> false
        }
        .Err(error) -> {
            return Err(error)
        }
    }
    plan :: trap_messages_plan(check, defects_only, source_current, defects_current) ?? return Err(err)
    if plan.write_source -> files.write(TARGET_PATH, outputs.source) ?? return Err(trap_fail("cannot write {TARGET_PATH}: {err}"))
    if plan.write_defects -> files.write(DEFECT_TARGET_PATH, outputs.defects) ?? return Err(trap_fail("cannot write {DEFECT_TARGET_PATH}: {err}"))
    Ok(plan.message)
}

fn run() {
    if trap_messages_main(process.args()) == {
        .Ok(message) -> {
            if message != "" -> print(message)
        }
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The (word, count) lines of generated function `name` written through `sink`.
fn emitted_words(source: String, name: String, sink: String) -> [String] Never! {
    words := [String]{}
    inside := false
    header :: "fn {name}() {{"
    loop line in source.split("\n") {
        if line == header {
            inside = true
            next
        }
        if !inside -> next
        if line == "}}" -> break
        trimmed :: line.trim()
        if !trimmed.starts_with("{sink}(I64{{") -> return [String]{}
        &words.push(byte_tail_of(trimmed, byte_len(sink)))
    }
    words
}

fn byte_tail_of(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

fn plan_error(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> String Never! {
    if trap_messages_plan(check, defects_only, source_current, defects_current) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the private defect rows are the ordinary unreachable prefix and newline words") {
    registry :: files.read(REGISTRY_PATH) ?? panic("the registry did not read")
    routes :: files.read(ROUTES_PATH) ?? panic("the lowering routes did not read")
    debug :: files.read(DEBUG_PATH) ?? panic("the Debug table did not read")
    outputs :: render_trap_messages(registry, routes, debug) ?? panic("the trap messages did not render: {err.message}")
    prefix :: emitted_words(outputs.defects, "trap_defect_unreachable_head", "trap_write_word_raw")
    newline :: emitted_words(outputs.defects, "trap_defect_newline", "trap_write_word_raw")
    assert_eq(prefix, emitted_words(outputs.source, "trap_msg_unreachable", "trap_write_word"))
    assert_eq(newline, emitted_words(outputs.source, "trap_msg_newline", "trap_write_word"))
    // 42 bytes: five full words and a two-byte tail; the newline is one byte.
    counts :: loop word in prefix -> word.split("I64{{").to_list()[2]
    assert_eq(counts, ["8}})", "8}})", "8}})", "8}})", "8}})", "2}})"])
    assert_eq(newline.len(), 1)
    assert(newline[0].ends_with(", I64{{1}})"))
    assert_eq(outputs.defects.split("\nfn ").to_list().len() - 1 + (if outputs.defects.starts_with("fn ") -> 1 else -> 0), 2)
}

#Test("check never writes; the frozen gate fails before any write; the default produces both") {
    current :: trap_messages_plan(true, false, true, true) ?? panic("current outputs fail the check")
    assert(!current.write_source && !current.write_defects)
    assert(plan_error(true, false, false, true).contains("TrapMessages.jet is stale"))
    assert(plan_error(true, true, true, false).contains("TrapDefectMessages.jet is stale"))
    assert(plan_error(false, true, false, false).contains("frozen output was not written"))
    assert(plan_error(true, true, false, true).contains("frozen output was not written"))
    scoped :: trap_messages_plan(false, true, true, false) ?? panic("scoped generation refused")
    assert(!scoped.write_source && scoped.write_defects)
    canonical :: trap_messages_plan(false, false, false, false) ?? panic("default generation refused")
    assert(canonical.write_source && canonical.write_defects)
    unchanged :: trap_messages_plan(false, false, true, true) ?? panic("default generation refused")
    assert(!unchanged.write_source && !unchanged.write_defects)
}
