// The dev tool roots for node tools: the twin of Tools/agent/roots.mjs
// (gauntlet tool entry roots-mjs). A root is the environment's value (empty
// is unset), else the default derived from $HOME and the XDG directories,
// joined as node's path.join joins; no file is read.
//
//   jet Tools/agent/Roots.jet NAME...
//
// prints `NAME=value` for each root named (JET_STATE_ROOT, JET_SCRATCH_ROOT,
// JET_RUN_ROOT, JET_BASE_ROOT, JET_TARGET_ROOT, JET_SEEDS, JET_SEED, JET_BIN),
// as `node roots.mjs NAME...` does, and exits 64 at any other name.
// Tools/agent/orchestrator/Roots.jet is the twin of roots.sh.
use {
    files: core.files
    process: core.process
    sys: core.sys
}

// `$name` when it is set and not empty, else `under` joined under `dir`.
env_or: fn(name: String, dir: String, under: String) -[Env]> String Never! {
    process.env_nonempty(name) ?? files.join_all([String]{dir, under})
}

state: fn() -[Env, FS.Read]> String Never! {
    env_or("JET_STATE_ROOT", sys.cache_dir() ?? "", "jet-dev")
}

scratch: fn() -[Env, FS.Read]> String Never! { process.env_nonempty("JET_SCRATCH_ROOT") ?? state() }

seeds: fn() -[Env, FS.Read]> String Never! {
    env_or("JET_SEEDS", sys.data_dir() ?? "", "jet-seeds")
}

seed: fn() -[Env, FS.Read]> String Never! { env_or("JET_SEED", seeds(), "current") }

// The root `name` names: None when it is not a root.
root: fn(name: String) -[Env, FS.Read]> String? Never! {
    if name == {
        "JET_STATE_ROOT" -> Val(state())
        "JET_SCRATCH_ROOT" -> Val(scratch())
        "JET_RUN_ROOT" -> Val(env_or("JET_RUN_ROOT", scratch(), "run"))
        "JET_BASE_ROOT" -> Val(env_or("JET_BASE_ROOT", scratch(), "discovery/base"))
        "JET_TARGET_ROOT" -> Val(env_or("JET_TARGET_ROOT", scratch(), "targets"))
        "JET_SEEDS" -> Val(seeds())
        "JET_SEED" -> Val(seed())
        // The jet under test, which `jet test` passes its children.
        "JET_BIN" -> Val(env_or("JET_BIN", seed(), "jet"))
        else -> None
    }
}

run: fn() {
    loop name in process.args() -> print("{name}={root(name) ?? process.fail(64, "roots: unknown root {name}")}")
}
