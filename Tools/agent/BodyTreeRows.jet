#!/usr/bin/env jet
// Render the flat body's enums (Compiler/JetFoundation/Source/Facts) from
// their one declaration each in Compiler/JetSema/Source/Sema/Tree.jet:
// BodyHostCall from THostCall and StmtKind from TStmt. Sema's BodyFlatten.jet
// lowers the checked tree node for node, so each body variant is its tree
// variant with every checked child (a `TExpr`, and for statements a `TStmt`)
// written as its BodyTree node index `Int`, every tree type with a body form
// written as that form, and the tree types both sides share kept as written.
// The declaration is read as text: the lines from `<Tree>: enum {` to the next
// line that is `}`, comments copied as written. A variant naming any other
// tree type fails the render, so a new tree type is given its body form here.
// Usage: jet Tools/agent/BodyTreeRows.jet [--check|--write]
// --check fails when a generated file differs from its declaration; --write
// rewrites them.
use {
    files: core.files
    process: core.process
    term: core.term
}

SOURCE_PATH: "Compiler/JetSema/Source/Sema/Tree.jet"
GENERATED_BY: "// This file is generated by Tools/agent/BodyTreeRows.jet; do not edit."
// Tree-side type names; each one is a checked child, has a body form, or is
// shared by both sides.
TREE_TYPE: Regex{"T[A-Z][A-Za-z0-9]*"}

// One generated enum: the tree declaration it renders, the file and enum it
// writes, the lines under the header, the checked children written as node
// indices, the tree types with a body form (tree name, body name) and the
// tree types both sides share.
BodyTreeView: struct {
    source_open: String
    output_path: String
    output_open: String
    lede: [String]
    children: [String]
    forms: [[String]]
    shared: [String]
}

body_tree_views: fn() -> [BodyTreeView] {
    [BodyTreeView]{
        BodyTreeView{
            source_open: "THostCall: enum {{",
            output_path: "Compiler/JetFoundation/Source/Facts/BodyHostCall.jet",
            output_open: "BodyHostCall: enum {{",
            lede: [String]{
                "// BodyHostCall is THostCall over the flat body: each checked child is its",
                "// BodyTree node index. THostCall is declared in {SOURCE_PATH}.",
            },
            children: [String]{"TExpr"},
            forms: [[String]]{},
            shared: [String]{"TOptionProbe"},
        },
        BodyTreeView{
            source_open: "TStmt: enum {{",
            output_path: "Compiler/JetFoundation/Source/Facts/BodyStmt.jet",
            output_open: "StmtKind: enum {{",
            lede: [String]{
                "// StmtKind is TStmt over the flat body: each checked child statement or",
                "// expression is its BodyTree node index, and each other checked child is",
                "// its body form. TStmt is declared in {SOURCE_PATH}.",
            },
            children: [String]{"TStmt", "TExpr"},
            forms: [[String]]{
                [String]{"TContract", "BodyContract"},
                [String]{"TPattern", "BodyPattern"},
                [String]{"TPlace", "BodyPlace"},
                [String]{"TTaskGroupArgs", "BodyTaskGroupArgs"},
                [String]{"TIfCond", "BodyIfCond"},
                [String]{"TMatchArm", "BodyMatchArm"},
                [String]{"TRangeArm", "BodyRangeArm"},
                [String]{"TMixedArm", "BodyMixedArm"},
                [String]{"TLambda", "BodyLambda"},
                [String]{"TContextGuard", "BodyContextGuard"},
                [String]{"TScopeMemberKind", "BodyScopeMemberKind"},
            },
            shared: [String]{
                "TLocal", "TLetTy", "TGCPromotion", "TDestructureBinding", "TBinaryOp", "TContractResult",
                "TForInMethod", "TBranchClass", "TUnsafeGate", "TTransactionSnapshot",
            },
        },
    }
}

#Error
BodyTreeRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> BodyTreeRowsError Never! {
    BodyTreeRowsError{message: "body tree rows: {message}"}
}

// The body spelling of tree type `name` in `view`, or None when it has none.
body_tree_type: fn(view: BodyTreeView, name: String) -> String? Never! {
    if view.children.contains(name) -> return Val("Int")
    if view.shared.contains(name) -> return Val(name.copy())
    loop form in view.forms {
        if form[0] == name -> return Val(form[1].copy())
    }
    None
}

// The body form of one line of the tree declaration.
body_tree_line: fn(view: BodyTreeView, line: String, number: Int) -> String BodyTreeRowsError! {
    if line.trim_start().starts_with("//") -> return Ok(line.copy())
    names: TREE_TYPE.find_all(line)
    pieces: TREE_TYPE.split(line)
    out := [String]{pieces[0].copy()}
    loop (index, name) in names {
        body: body_tree_type(view, name) ?? return Err(rows_fail("{SOURCE_PATH}:{number} names `{name}`, a tree type with no body form"))
        out.push(body)
        out.push(pieces[index + 1].copy())
    }
    Ok(out.join(""))
}

// The generated file of `view` for the text of Tree.jet.
render_body_tree: fn(view: BodyTreeView, text: String) -> String BodyTreeRowsError! {
    lines: text.split("\n").to_list()
    start: loop (index, line) in lines {
        if line == view.source_open -> break index
    } ?? return Err(rows_fail("{SOURCE_PATH} declares no `{view.source_open}` line"))
    out := [String]{GENERATED_BY}
    loop line in view.lede -> out.push(line.copy())
    out.push("")
    out.push(view.output_open.copy())
    index := start + 1
    loop index < lines.len() {
        line: lines[index]
        if line == "}}" {
            out.push("}}")
            out.push("")
            return Ok(out.join("\n"))
        }
        out.push(body_tree_line(view, line, index + 1) ?? return Err(err))
        index += 1
    }
    Err(rows_fail("{SOURCE_PATH}: `{view.source_open}` has no closing `}}` line"))
}

body_tree_rows_main: fn(args: [String]) -[FS]> String BodyTreeRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: jet Tools/agent/BodyTreeRows.jet [--check|--write]"))
    text: files.read(SOURCE_PATH) ?? return Err(rows_fail("cannot read {SOURCE_PATH}: {err}"))
    stale := [String]{}
    loop view in body_tree_views() {
        generated: render_body_tree(view, text) ?? return Err(err)
        if (files.read(view.output_path) ?? "") == generated -> next
        if mode == "--check" {
            stale.push("{view.output_path} differs from {view.source_open.split(":").to_list()[0]} in {SOURCE_PATH}")
            next
        }
        files.write(view.output_path, generated) ?? return Err(rows_fail("cannot write {view.output_path}: {err}"))
    }
    if stale.len() > 0 -> return Err(rows_fail("{stale.join("; ")}; run jet Tools/agent/BodyTreeRows.jet --write"))
    if mode == "--check" -> return Ok("body tree rows check passed")
    Ok("body tree rows written")
}

run: fn() {
    if body_tree_rows_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The error text render_body_tree reports for `text` under the view at
// `index`, or "" when it accepts it.
body_tree_rows_error: fn(index: Int, text: String) -> String Never! {
    if render_body_tree(body_tree_views()[index], text) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("body host call rows write each tree child as its node index") {
    tree: "X: enum {{\n}}\nTHostCall: enum {{\n    // A call.\n    Method(receiver: TExpr, args: [TExpr], kind: TOptionProbe)\n    Probe(inner: TExpr?)\n}}\n"
    rendered: render_body_tree(body_tree_views()[0], tree) ?? panic("the declaration did not render: {err.message}")
    assert(rendered.starts_with(GENERATED_BY))
    assert(rendered.contains("\nBodyHostCall: enum {{\n    // A call.\n    Method(receiver: Int, args: [Int], kind: TOptionProbe)\n    Probe(inner: Int?)\n}}\n"))
    assert(body_tree_rows_error(0, "Y: enum {{\n}}\n").contains("declares no"))
    assert(body_tree_rows_error(0, "THostCall: enum {{\n    Spawn(body: TLambda)\n}}\n").contains("no body form"))
    assert(body_tree_rows_error(0, "THostCall: enum {{\n    Wrap(kind: TExprKind)\n}}\n").contains("no body form"))
    assert(body_tree_rows_error(0, "THostCall: enum {{\n    Open\n").contains("no closing"))
}

#Test("statement kind rows write children as node indices, tree types as their body forms, and shared types as written") {
    tree: "TStmt: enum {{\n    Contract(contract: TContract)\n    Scope(pre: [TContract], body: [TStmt], result: TContractResult, value: TExpr?)\n    Reactive(executable: TLambda, span: Span)\n}}\n"
    rendered: render_body_tree(body_tree_views()[1], tree) ?? panic("the declaration did not render: {err.message}")
    assert(rendered.starts_with(GENERATED_BY))
    assert(rendered.contains("\nStmtKind: enum {{\n    Contract(contract: BodyContract)\n    Scope(pre: [BodyContract], body: [Int], result: TContractResult, value: Int?)\n    Reactive(executable: BodyLambda, span: Span)\n}}\n"))
    assert(body_tree_rows_error(1, "TStmt: enum {{\n    Hold(kind: TExprKind)\n}}\n").contains("`TExprKind`, a tree type with no body form"))
}

#Test("the generated body enums match their tree declarations") {
    text: files.read(SOURCE_PATH) ?? panic("cannot read {SOURCE_PATH}")
    loop view in body_tree_views() -> assert_eq(files.read(view.output_path) ?? "", render_body_tree(view, text) ?? panic(err.message))
}
