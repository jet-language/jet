#!/usr/bin/env jet
// Render the protocol traits of Compiler/Prelude/Traits.jet, the one
// declaration of each trait the compiler owns, into every copy built from it:
// OWNED_TRAITS (Compiler/JetFoundation/Source/Registry/OwnedTraitRows.jet),
// which the parser, sema and the CLI read, and the trait-marker rows of the
// syntax dictionary (the generated block of
// Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet). The source is read as
// text in one strict shape: `Name: trait {` blocks, with `Literal: module {`
// around the literal capabilities, whose members are `column: Bool{true}` or
// `column: String{"…"}` facts, `Name: type` associated types and
// `name: fn(…)` requirements ending `Never!` or `Error!`.
// Usage: jet Tools/agent/OwnedTraitRows.jet [--check|--write]
// --check fails when a copy differs from what the declarations give it;
// --write rewrites the copies.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
}

SOURCE_PATH: "Compiler/Prelude/Traits.jet"
// The prelude that declares `CheckedText: trait` for readers.
PRELUDE_PATH: "Compiler/Prelude/core/prelude.jet"
CHECKED_TEXT_DECLARATION: "CheckedText: trait {{"
ROWS_PATH: "Compiler/JetFoundation/Source/Registry/OwnedTraitRows.jet"
DICTIONARY_PATH: "Compiler/JetCli/Source/Cli/SyntaxDictionaryData.jet"
GENERATED_BY: "// This file is generated by Tools/agent/OwnedTraitRows.jet; do not edit."
DICTIONARY_OPEN: "    // The trait markers of Compiler/Prelude/Traits.jet, generated by Tools/agent/OwnedTraitRows.jet; do not edit."
DICTIONARY_CLOSE: "    // End of the generated trait markers."
// The registry the dictionary's trait-marker rows name.
REGISTRY_NAME: "OWNED_TRAITS"

MODULE_OPEN: Regex{"^([A-Z][A-Za-z]*): module \{{$"}
TRAIT_OPEN: Regex{"^([A-Z][A-Za-z]*): trait \{{$"}
FLAG: Regex{"^([a-z_]+): Bool\{{true\}}$"}
TEXT: Regex{"^([a-z_]+): String\{{\x22([^\x22\\{{}}]*)\x22\}}$"}
ASSOCIATED: Regex{"^([A-Z][A-Za-z]*): type$"}
METHOD_OPEN: Regex{"^[a-z][a-z0-9_]*: fn\("}
NAME: Regex{"^[A-Z][A-Za-z0-9]*$"}
METHOD_NAME: Regex{"^[a-z][a-z0-9_]*$"}
FLAG_COLUMNS: [String]{"local", "bare_bound", "raw_return", "any_receiver", "commutative", "codec", "derived", "checked_text", "auto_derive", "bundle", "through_elements"}
TEXT_COLUMNS: [String]{"operators", "auto_derive_family", "bundle_family", "requires", "shares"}
// The columns that name a family marker.
FAMILY_COLUMNS: [String]{"auto_derive_family", "bundle_family"}

#Error
OwnedTraitRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> OwnedTraitRowsError Never! {
    OwnedTraitRowsError{message: "owned trait rows: {message}"}
}

// One `column: Bool{true}` or `column: String{"…"}` fact; a flag's value is "true".
TraitFact: struct {
    name: String
    value: String
}

TraitParam: struct {
    name: String
    ty: String
}

// One `name: fn(…)` requirement as written.
TraitMethod: struct {
    name: String
    // "" for a static method, else `self`, `&self` or `&&self`.
    receiver: String
    params: [TraitParam]
    // The written return type, "" when the method writes no `->`.
    returns: String
    // `Never` or the written error type.
    error: String
}

// One `Name: trait` block as written.
TraitSource: struct {
    name: String
    line: Int
    // Declared inside `Literal: module`.
    literal: Bool
    facts: [TraitFact]
    associated: [String]
    methods: [TraitMethod]
}

TextFile: struct {
    path: String
    text: String
}

fact: fn(source: TraitSource, name: String) -> String? Never! {
    loop row in source.facts {
        if row.name == name -> return Val(row.value.copy())
    }
    None
}

flag: fn(source: TraitSource, name: String) -> Bool Never! {
    fact(source, name) != None
}

// The space-separated words of a text fact, empty when the trait omits it.
words: fn(source: TraitSource, name: String) -> [String] Never! {
    value: fact(source, name) ?? return [String]{}
    out := [String]{}
    loop word in value.split(" ").to_list() {
        if word != "" -> out.push(word.copy())
    }
    out
}

parse_method: fn(text: String, context: String) -> TraitMethod OwnedTraitRowsError! {
    if !text.ends_with("!") -> return Err(rows_fail("{context}: a requirement ends `Never!` or `Error!`, found `{text}`"))
    head: text.remove_suffix("!").partition(": fn(")
    if head.sep == "" || METHOD_NAME.match(head.head) == None -> return Err(rows_fail("{context}: expected `name: fn(…)`, found `{text}`"))
    signature: head.tail.rpartition(") ")
    if signature.sep == "" -> return Err(rows_fail("{context}: expected `) -> Type Error!` or `) Error!`, found `{text}`"))
    returns := ""
    error := signature.tail.copy()
    if signature.tail.starts_with("-> ") {
        result: signature.tail.remove_prefix("-> ").rpartition(" ")
        if result.sep == "" -> return Err(rows_fail("{context}: `-> Type` takes its error after it (`-> Type Never!`), found `{text}`"))
        returns = result.head.copy()
        error = result.tail.copy()
    }
    if error.contains(" ") || error == "" -> return Err(rows_fail("{context}: expected one error type before `!`, found `{text}`"))
    receiver := ""
    params := [TraitParam]{}
    loop written in signature.head.split(", ").to_list() {
        if written == "" -> next
        if params.len() == 0 && receiver == "" && (written == "self" || written == "&self" || written == "&&self") {
            receiver = written.copy()
            next
        }
        param: written.partition(": ")
        if param.sep == "" || METHOD_NAME.match(param.head) == None -> return Err(rows_fail("{context}: expected `name: Type`, found `{written}`"))
        params.push(TraitParam{name: param.head.copy(), ty: param.tail.copy()})
    }
    Ok(TraitMethod{name: head.head.copy(), receiver: receiver, params: params, returns: returns, error: error})
}

read_traits: fn(source_text: String) -> [TraitSource] OwnedTraitRowsError! {
    lines: source_text.split("\n").to_list()
    traits := [TraitSource]{}
    group := ""
    index := 0
    loop index < lines.len() {
        line: lines[index]
        index += 1
        if line.trim() == "" || line.trim().starts_with("//") -> next
        if group == "" && MODULE_OPEN.match(line) == .Val(opened) {
            if opened.groups[0] != "Literal" -> return Err(rows_fail("line {index}: only `Literal: module` groups traits, found `{line}`"))
            group = opened.groups[0].copy()
            next
        }
        if group != "" && line == "}}" {
            group = ""
            next
        }
        indent: if group == "" -> "" else -> "    "
        opened: (if line.starts_with(indent) -> TRAIT_OPEN.match(line.remove_prefix(indent)) else -> None) ?? return Err(rows_fail("line {index}: expected `{indent}Name: trait {{`, found `{line}`"))
        name: if group == "" -> opened.groups[0].copy() else -> "{group}.{opened.groups[0]}"
        context: "trait {name}"
        start: index
        facts := [TraitFact]{}
        associated := [String]{}
        methods := [TraitMethod]{}
        member_indent: "{indent}    "
        loop index < lines.len() && lines[index] != "{indent}}}" {
            member: lines[index]
            index += 1
            if member.trim() == "" || member.trim().starts_with("//") -> next
            if !member.starts_with(member_indent) || member.remove_prefix(member_indent).starts_with(" ") -> return Err(rows_fail("line {index}: {context}: members sit one level in, found `{member}`"))
            body: member.remove_prefix(member_indent)
            if {
                FLAG.match(body) == .Val(column) -> {
                    if !FLAG_COLUMNS.contains(column.groups[0]) -> return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is not a flag column ({FLAG_COLUMNS.join(", ")})"))
                    if fact_named(facts, column.groups[0]) -> return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is given twice"))
                    facts.push(TraitFact{name: column.groups[0].copy(), value: "true"})
                }
                TEXT.match(body) == .Val(column) -> {
                    if !TEXT_COLUMNS.contains(column.groups[0]) -> return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is not a text column ({TEXT_COLUMNS.join(", ")})"))
                    if fact_named(facts, column.groups[0]) -> return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is given twice"))
                    if column.groups[1].trim() == "" -> return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is empty; omit it"))
                    facts.push(TraitFact{name: column.groups[0].copy(), value: column.groups[1].copy()})
                }
                ASSOCIATED.match(body) == .Val(declared) -> {
                    if associated.contains(declared.groups[0]) -> return Err(rows_fail("line {index}: {context}: `{declared.groups[0]}: type` is declared twice"))
                    associated.push(declared.groups[0].copy())
                }
                METHOD_OPEN.match(body) != None -> methods.push(parse_method(body, "line {index}: {context}") ?? return Err(err))
                true -> return Err(rows_fail("line {index}: {context}: expected a fact column, `Name: type` or `name: fn(…)`, found `{body}`"))
            }
        }
        if index >= lines.len() -> return Err(rows_fail("line {start}: {context} is not closed"))
        index += 1
        loop existing in traits {
            if existing.name == name -> return Err(rows_fail("line {start}: {context} is declared twice"))
        }
        traits.push(TraitSource{name: name, line: start, literal: group != "", facts: facts, associated: associated, methods: methods})
    }
    if group != "" -> return Err(rows_fail("`module {group}` is not closed"))
    if traits.len() == 0 -> return Err(rows_fail("{SOURCE_PATH} declares no trait"))
    Ok(traits)
}

fact_named: fn(facts: [TraitFact], name: String) -> Bool Never! {
    loop row in facts {
        if row.name == name -> return true
    }
    false
}

// The `Type` constructor of a written type.
render_type: fn(text: String, context: String) -> String OwnedTraitRowsError! {
    if text.ends_with("?") {
        inner: render_type(text.remove_suffix("?"), context) ?? return Err(err)
        return Ok("Type.Option{{inner: {inner}}}")
    }
    if text.starts_with("[") && text.ends_with("]") {
        body: text.remove_prefix("[").remove_suffix("]")
        pair: body.partition(": ")
        if pair.sep != "" && pair.head.split("[").to_list().len() == pair.head.split("]").to_list().len() {
            key: render_type(pair.head, context) ?? return Err(err)
            value: render_type(pair.tail, context) ?? return Err(err)
            return Ok("Type.Map{{key: {key}, key_span: None, value: {value}}}")
        }
        element: render_type(body, context) ?? return Err(err)
        return Ok("Type.List{{element: {element}}}")
    }
    if text == {
        "Int" -> return Ok("Type.Int")
        "Float" -> return Ok("Type.Float")
        "Bool" -> return Ok("Type.Bool")
        "String" -> return Ok("Type.String")
        "U8" -> return Ok("Type.IntN{{signed: false, bits: 8}}")
        else -> {}
    }
    if NAME.match(text) == None -> return Err(rows_fail("{context}: cannot read the type `{text}`"))
    Ok("Type.Named{{name: \"{text}\"}}")
}

// What an `OwnedMethod` returns: None for no value, else the value or the
// `Result` of value and error.
render_returns: fn(method: TraitMethod, context: String) -> String OwnedTraitRowsError! {
    if method.returns == "" {
        if method.error == "Never" -> return Ok("None")
        err_type: render_type(method.error, context) ?? return Err(err)
        return Ok("Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: {err_type}}})")
    }
    ok: render_type(method.returns, context) ?? return Err(err)
    if method.error == "Never" -> return Ok("Val({ok})")
    err_type: render_type(method.error, context) ?? return Err(err)
    Ok("Val(Type.Result{{ok: {ok}, err: {err_type}}})")
}

render_method: fn(method: TraitMethod, any_receiver: Bool, context: String) -> String OwnedTraitRowsError! {
    where: "{context}.{method.name}"
    receiver: if method.receiver == {
        "" -> "OwnedReceiver.Static"
        "self" -> if any_receiver -> "OwnedReceiver.Any" else -> "OwnedReceiver.Fixed{{access: AccessConvention.Read}}"
        "&self" -> "OwnedReceiver.Fixed{{access: AccessConvention.Write}}"
        else -> "OwnedReceiver.Fixed{{access: AccessConvention.Move}}"
    }
    if any_receiver && method.receiver != "self" -> return Err(rows_fail("{where}: `any_receiver` takes a plain `self`"))
    params := [String]{}
    loop param in method.params {
        ty: render_type(param.ty, where) ?? return Err(err)
        params.push("OwnedParam{{name: \"{param.name}\", ty: {ty}}}")
    }
    returns: render_returns(method, where) ?? return Err(err)
    Ok("OwnedMethod{{name: \"{method.name}\", receiver: {receiver}, params: [OwnedParam]{{{params.join(", ")}}}, returns: {returns}}}")
}

quoted: fn(names: [String]) -> String Never! {
    parts := [String]{}
    loop name in names -> parts.push("\"{name}\"")
    "[String]{{{parts.join(", ")}}}"
}

optional_text: fn(source: TraitSource, name: String) -> String Never! {
    value: fact(source, name) ?? return "None"
    "Val(\"{value}\")"
}

// The contract kinds a trait's facts and placement select; a valid trait selects at most one.
contract_kinds: fn(source: TraitSource) -> [String] Never! {
    kinds := [String]{}
    if flag(source, "codec") -> kinds.push("codec")
    if flag(source, "derived") -> kinds.push("derived")
    if flag(source, "checked_text") -> kinds.push("checked_text")
    if fact(source, "operators") != None -> kinds.push("operators")
    if source.literal -> kinds.push("module Literal")
    kinds
}

sole_method: fn(source: TraitSource, context: String, kind: String) -> TraitMethod OwnedTraitRowsError! {
    if source.methods.len() != 1 -> return Err(rows_fail("{context}: a `{kind}` trait declares exactly one `fn`"))
    Ok(source.methods[0])
}

// One OWNED_TRAITS row.
render_row: fn(source: TraitSource, traits: [TraitSource], checked_text_declared: Bool) -> String OwnedTraitRowsError! {
    context: "line {source.line}: trait {source.name}"
    kinds: contract_kinds(source)
    if kinds.len() > 1 -> return Err(rows_fail("{context}: {kinds.join(" and ")} select different contracts"))
    kind: if kinds.len() == 1 -> kinds[0].copy() else -> "methods"
    if kind != "methods" && (fact(source, "shares") != None || flag(source, "any_receiver")) -> return Err(rows_fail("{context}: `shares` and `any_receiver` belong to a methods trait"))
    if kind != "operators" && flag(source, "commutative") -> return Err(rows_fail("{context}: `commutative` belongs to an operator trait"))
    loop name in words(source, "requires") {
        if name == source.name || !declared(traits, name) -> return Err(rows_fail("{context}: `requires` names `{name}`, which is not another trait here"))
    }
    loop name in words(source, "shares") {
        if name == source.name || !declared(traits, name) -> return Err(rows_fail("{context}: `shares` names `{name}`, which is not another trait here"))
    }
    contract := ""
    if kind == {
        "operators" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            if method.receiver != "self" || method.params.len() != 1 || method.params[0].ty != "Rhs" || !source.associated.contains("Rhs") || method.error != "Never" || method.returns == "" -> return Err(rows_fail("{context}: an operator hook is `Rhs: type` and `hook: fn(self, rhs: Rhs) -> Result Never!`"))
            result := "None"
            if !source.associated.contains(method.returns) {
                fixed: render_type(method.returns, context) ?? return Err(err)
                result = "Val({fixed})"
            }
            contract = "OwnedContract.Operator{{hook: \"{method.name}\", result: {result}}}"
        }
        "codec" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            contract = "OwnedContract.Codec{{verb: \"{method.name}\"}}"
        }
        "module Literal" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            if method.name != "from_literal" || method.receiver != "" || method.params.len() != 1 -> return Err(rows_fail("{context}: a literal capability is `from_literal: fn(value: Source) -> Self Never!`"))
            literal_source: render_type(method.params[0].ty, context) ?? return Err(err)
            contract = "OwnedContract.Literal{{source: {literal_source}}}"
        }
        "checked_text" -> {
            if source.methods.len() > 0 || source.associated.len() > 0 -> return Err(rows_fail("{context}: `checked_text` takes its methods from {PRELUDE_PATH}"))
            if !checked_text_declared -> return Err(rows_fail("{context}: {PRELUDE_PATH} no longer declares `CheckedText: trait`"))
            contract = "OwnedContract.CheckedText"
        }
        "derived" -> {
            if source.methods.len() > 0 || source.associated.len() > 0 -> return Err(rows_fail("{context}: a derived trait declares no member the compiler reads"))
            contract = "OwnedContract.Derived"
        }
        else -> {
            if source.methods.len() == 0 -> return Err(rows_fail("{context}: a methods trait declares at least one `fn`"))
            lines := [String]{}
            loop method in source.methods {
                rendered: render_method(method, flag(source, "any_receiver"), "trait {source.name}") ?? return Err(err)
                lines.push("        {rendered},\n")
            }
            shares: optional_text(source, "shares")
            contract = "OwnedContract.Methods{{methods: [OwnedMethod]{{\n{lines.join("")}    }}, associated: {quoted(source.associated)}, shares: {shares}}}"
        }
    }
    Ok("    OwnedTrait{{name: \"{source.name}\", local: {flag(source, "local")}, bare_bound: {flag(source, "bare_bound")}, raw_return: {flag(source, "raw_return")}, contract: {contract}, operators: {quoted(words(source, "operators"))}, commutative: {flag(source, "commutative")}, requires: {quoted(words(source, "requires"))}, auto_derive: {flag(source, "auto_derive")}, auto_derive_family: {optional_text(source, "auto_derive_family")}, bundle: {flag(source, "bundle")}, bundle_family: {optional_text(source, "bundle_family")}, through_elements: {flag(source, "through_elements")}}},")
}

declared: fn(traits: [TraitSource], name: String) -> Bool Never! {
    loop source in traits {
        if source.name == name -> return true
    }
    false
}

// The facts no single trait can check: one trait per operator, and family
// markers that name no trait.
check_table: fn(traits: [TraitSource]) OwnedTraitRowsError! {
    operators := [String]{}
    loop source in traits {
        loop symbol in words(source, "operators") {
            if operators.contains(symbol) -> return Err(rows_fail("trait {source.name}: the operator `{symbol}` already belongs to another trait"))
            operators.push(symbol.copy())
        }
        loop column in FAMILY_COLUMNS {
            family: fact(source, column) ?? next
            if declared(traits, family) -> return Err(rows_fail("trait {source.name}: the family marker `{family}` is also a trait name"))
        }
    }
}

render_rows: fn(source_text: String, checked_text_declared: Bool) -> String OwnedTraitRowsError! {
    traits: read_traits(source_text) ?? return Err(err)
    check_table(traits) ?? return Err(err)
    rows := [String]{}
    loop source in traits -> rows.push(render_row(source, traits, checked_text_declared) ?? return Err(err))
    Ok("// Source: {SOURCE_PATH}\n// Source SHA-256: {crypto.sha256(source_text).hex()}\n{GENERATED_BY}\n// Every trait the compiler owns, in declaration order; OwnedTraits.jet\n// holds the row shape and the questions its readers ask.\nOWNED_TRAITS: [OwnedTrait]{{\n{rows.join("\n")}\n}}\n")
}

// The traits a marker covers, written for a reader: `Encode` and `Decode`.
spelled: fn(names: [String]) -> String Never! {
    parts := [String]{}
    loop name in names -> parts.push("`{name}`")
    if parts.len() == 2 -> return "{parts[0]} and {parts[1]}"
    parts.join(", ")
}

// What `#{marker}` means, read from the table.
marker_text: fn(marker: String, traits: [TraitSource]) -> String Never! {
    derives := [String]{}
    bundles := [String]{}
    loop source in traits {
        if (source.name == marker && flag(source, "auto_derive")) || fact(source, "auto_derive_family") == Val((marker)) -> derives.push(source.name.copy())
        if (source.name == marker && flag(source, "bundle")) || fact(source, "bundle_family") == Val((marker)) -> bundles.push(source.name.copy())
    }
    parts := [String]{}
    if derives.len() > 0 -> parts.push("On a struct or enum, derives {spelled(derives)} from its fields; `#!{marker}` refuses it.")
    if bundles.len() > 0 -> parts.push("On a distinct type, keeps the base type's {spelled(bundles)}.")
    parts.join(" ")
}

// The dictionary rows of every derive and bundle marker, sorted by token.
render_dictionary_rows: fn(source_text: String) -> String OwnedTraitRowsError! {
    traits: read_traits(source_text) ?? return Err(err)
    markers := [String]{}
    loop source in traits {
        if (flag(source, "auto_derive") || flag(source, "bundle")) && !markers.contains(source.name) -> markers.push(source.name.copy())
        loop column in FAMILY_COLUMNS {
            family: fact(source, column) ?? next
            if !markers.contains(family) -> markers.push(family.copy())
        }
    }
    markers.sort()
    rows := [String]{}
    loop marker in markers {
        query: marker.lower()
        rows.push("    {{token: \"{marker}\", query: \"{query}\", display_query: \"#{query}\", registry_name: \"{REGISTRY_NAME}\", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{position: \"\", text: \"{marker_text(marker, traits)}\", example: \"#{marker} …\", afterwards: \"\", related_codes: [String]{{}}}}}}}},\n")
    }
    Ok("{DICTIONARY_OPEN}\n{rows.join("")}{DICTIONARY_CLOSE}\n")
}

// `dictionary` with its generated block replaced by `block`.
replace_dictionary_block: fn(dictionary: String, block: String) -> String OwnedTraitRowsError! {
    before: dictionary.partition("{DICTIONARY_OPEN}\n")
    if before.sep == "" -> return Err(rows_fail("{DICTIONARY_PATH} has no `{DICTIONARY_OPEN.trim()}` line"))
    after: before.tail.partition("{DICTIONARY_CLOSE}\n")
    if after.sep == "" -> return Err(rows_fail("{DICTIONARY_PATH} has no `{DICTIONARY_CLOSE.trim()}` line"))
    if after.tail.contains(DICTIONARY_OPEN) -> return Err(rows_fail("{DICTIONARY_PATH} has two generated trait-marker blocks"))
    Ok("{before.head}{block}{after.tail}")
}

read_text: fn(path: String) -[FS]> String OwnedTraitRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

generated_files: fn() -[FS]> [TextFile] OwnedTraitRowsError! {
    source_text: read_text(SOURCE_PATH) ?? return Err(err)
    prelude: read_text(PRELUDE_PATH) ?? return Err(err)
    rows: render_rows(source_text, prelude.contains(CHECKED_TEXT_DECLARATION)) ?? return Err(err)
    dictionary: read_text(DICTIONARY_PATH) ?? return Err(err)
    block: render_dictionary_rows(source_text) ?? return Err(err)
    next_dictionary: replace_dictionary_block(dictionary, block) ?? return Err(err)
    Ok([TextFile]{TextFile{path: ROWS_PATH, text: rows}, TextFile{path: DICTIONARY_PATH, text: next_dictionary}})
}

owned_trait_rows_main: fn(args: [String]) -[FS]> String OwnedTraitRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: OwnedTraitRows.jet [--check|--write]"))
    generated: generated_files() ?? return Err(err)
    differing := [String]{}
    loop file in generated {
        current: if files.exists(file.path) -> read_text(file.path) ?? return Err(err) else -> ""
        if current == file.text -> next
        differing.push(file.path.copy())
        if mode == "--write" -> files.write(file.path, file.text) ?? return Err(rows_fail("cannot write {file.path}: {err}"))
    }
    if mode == "--write" -> return Ok("owned trait copies written: {differing.len()} rewritten of {generated.len()}")
    if differing.len() == 0 -> return Ok("owned trait rows check passed: {generated.len()} copies match")
    Err(rows_fail("{differing.join(", ")} differ from {SOURCE_PATH}; run jet Tools/agent/OwnedTraitRows.jet --write"))
}

run: fn() { print(owned_trait_rows_main(process.args()) ?? process.fail(1, err.message)) }

// The error text render_rows reports for `source`, or "" when it accepts it.
rows_error: fn(source: String) -> String Never! {
    if render_rows(source, true) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

MINIMAL_TRAITS: "// Two traits.\nAdd: trait {{\n    local: Bool{{true}}\n    operators: String{{\"+\"}}\n    Rhs: type\n    Output: type\n    add: fn(self, rhs: Rhs) -> Output Never!\n}}\n\nDriver: trait {{\n    auto_derive: Bool{{true}}\n    auto_derive_family: String{{\"Bundle\"}}\n    query: fn(&self, sql: SQL) -> [[String: DBValue]] DBError!\n    close: fn(&&self) IOError!\n}}\n\nLiteral: module {{\n    Int: trait {{\n        from_literal: fn(value: Int) -> Self Never!\n    }}\n}}\n"

#Test("every generated copy matches its Prelude declaration") {
    if owned_trait_rows_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("a declaration renders its contract, types and facts") {
    rendered: render_rows(MINIMAL_TRAITS, true) ?? panic("the minimal traits did not render: {err.message}")
    assert(rendered.contains("OwnedTrait{{name: \"Add\", local: true, bare_bound: false, raw_return: false, contract: OwnedContract.Operator{{hook: \"add\", result: None}}, operators: [String]{{\"+\"}}, commutative: false, requires: [String]{{}},"))
    assert(rendered.contains("OwnedMethod{{name: \"query\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Write}}, params: [OwnedParam]{{OwnedParam{{name: \"sql\", ty: Type.Named{{name: \"SQL\"}}}}}}, returns: Val(Type.Result{{ok: Type.List{{element: Type.Map{{key: Type.String, key_span: None, value: Type.Named{{name: \"DBValue\"}}}}}}, err: Type.Named{{name: \"DBError\"}}}})}}"))
    assert(rendered.contains("OwnedMethod{{name: \"close\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Move}}, params: [OwnedParam]{{}}, returns: Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: Type.Named{{name: \"IOError\"}}}})}}"))
    assert(rendered.contains("auto_derive: true, auto_derive_family: Val(\"Bundle\"),"))
    assert(rendered.contains("OwnedTrait{{name: \"Literal.Int\", local: false, bare_bound: false, raw_return: false, contract: OwnedContract.Literal{{source: Type.Int}},"))
    block: render_dictionary_rows(MINIMAL_TRAITS) ?? panic(err.message)
    assert(block.contains("{{token: \"Bundle\", query: \"bundle\", display_query: \"#bundle\", registry_name: \"OWNED_TRAITS\","))
    assert(block.contains("text: \"On a struct or enum, derives `Driver` from its fields; `#!Bundle` refuses it.\""))
}

#Test("a declaration that breaks the source rules is refused") {
    traits: MINIMAL_TRAITS
    assert(rows_error(traits.replace("    local: Bool{{true}}\n", "    local: Bool{{false}}\n")).contains("expected a fact column"))
    assert(rows_error(traits.replace("    local: Bool{{true}}\n", "    lokal: Bool{{true}}\n")).contains("not a flag column"))
    assert(rows_error(traits.replace("    operators", "    codec: Bool{{true}}\n    operators")).contains("select different contracts"))
    assert(rows_error(traits.replace("Driver: trait", "Add: trait")).contains("declared twice"))
    assert(rows_error(traits.replace("(self, rhs: Rhs)", "(self, other: Int)")).contains("an operator hook is"))
    assert(rows_error(traits.replace(" -> Output Never!", " -> Output")).contains("ends `Never!`"))
    assert(rows_error(traits.replace("String{{\"Bundle\"}}", "String{{\"Add\"}}")).contains("also a trait name"))
    assert(rows_error(traits.replace("    auto_derive: Bool{{true}}\n", "    requires: String{{\"Missing\"}}\n")).contains("not another trait here"))
    assert(rows_error(traits.replace("    auto_derive: Bool{{true}}\n", "    commutative: Bool{{true}}\n    auto_derive: Bool{{true}}\n")).contains("belongs to an operator trait"))
    assert(rows_error(traits.replace("Literal: module", "Other: module")).contains("only `Literal: module`"))
    assert(rows_error(traits.replace("value: Int)", "value: (Int))")).contains("cannot read the type"))
}

#Test("the dictionary block is replaced in place") {
    dictionary: "a\n{DICTIONARY_OPEN}\nold\n{DICTIONARY_CLOSE}\nb\n"
    assert_eq(replace_dictionary_block(dictionary, "{DICTIONARY_OPEN}\nnew\n{DICTIONARY_CLOSE}\n") ?? panic(err.message), "a\n{DICTIONARY_OPEN}\nnew\n{DICTIONARY_CLOSE}\nb\n")
    assert(replace_dictionary_block("a\n", "") == .Err(_))
}
