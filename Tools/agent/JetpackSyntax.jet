#!/usr/bin/env jet
// Generates the copies of the syntax registry that compiled code reads. The
// constants of Compiler/JetFoundation/Data/Syntax are the one home of every
// syntax spelling, and that folder is data, not part of any package. Each
// target below gets one generated file: Jetpack/Foundation/Source/
// SyntaxRegistry.jet for the Jetpack unit, and Compiler/JetFoundation/Source/
// Registry/SyntaxRegistry.jet for the compiler's foundation package. A file
// carries exactly the registry constants its unit's sources name or another
// package imports from the unit's foundation package, and the registry
// constants those name, as the registry spells them. A name the unit
// declares itself stays the unit's, so the file leaves it out. In Jetpack
// such a declaration is a hand copy and is refused, unless it sits in a
// Compiler source the Jetpack unit shares.
// Usage: jet Tools/agent/JetpackSyntax.jet [--check|--write]
//   --check  fail when a generated file is absent or stale, or a Jetpack
//            source declares a registry name (the default)
//   --write  rewrite the generated files
// Run it from the repository root; every path is relative to it.
use {
    files: core.files
    process: core.process
}

SYNTAX_DIR: "Compiler/JetFoundation/Data/Syntax"
GENERATED_BY: "// This file is generated by Tools/agent/JetpackSyntax.jet from Compiler/JetFoundation/Data/Syntax; do not edit."
USAGE: "usage: jet Tools/agent/JetpackSyntax.jet [--check|--write]"

// One generated copy of the registry and the unit it serves.
SyntaxTarget: struct {
    output: String
    // The unit's name in the generated file's header.
    unit: String
    // The assembly lists that name the unit's sources; with none, the unit
    // is every `.jet` file under `unit_dir`.
    unit_lists: [String]
    unit_dir: String
    // How an import list from the unit's foundation package opens.
    import_list: String
    // Where a unit source that declares a registry name is a hand copy, or
    // "" when the unit's own declarations are allowed to stand.
    owned_prefix: String
}

JETPACK_TARGET: SyntaxTarget{
    output: "Jetpack/Foundation/Source/SyntaxRegistry.jet",
    unit: "the Jetpack unit",
    unit_lists: [String]{"Jetpack/Bootstrap/sources.list", "Jetpack/Bootstrap/tests.list"},
    unit_dir: "",
    import_list: "jetpack_foundation.[",
    owned_prefix: "Jetpack/",
}

// jet_foundation keeps its own declarations: Policy/MarkerNames.jet declares
// marker names the registry also spells.
COMPILER_TARGET: SyntaxTarget{
    output: "Compiler/JetFoundation/Source/Registry/SyntaxRegistry.jet",
    unit: "the jet_foundation package",
    unit_lists: [String]{},
    unit_dir: "Compiler/JetFoundation/Source",
    import_list: "jet_foundation.[",
    owned_prefix: "",
}

// The trees whose packages may import a foundation package, and the
// directories a walk skips.
IMPORT_ROOTS: [String]{"Compiler", "Jetpack", "Tools", "tests"}
IMPORT_SKIP: [String]{".jet", ".git", "target"}
// How a registry constant's value may start for the copy to stand alone:
// literals, lists of strings or integers, comptime blocks over them, and
// other registry constants.
VALUE_STARTS: [String]{"\"", "'", "-", "[String]{{", "[Int]{{", "#run {{", "String.from_bytes("}

#Error
JetpackSyntaxError: struct {
    message: String
}

syntax_fail: fn(message: String) -> JetpackSyntaxError Never! {
    JetpackSyntaxError{message: "jetpack syntax: {message}"}
}

// One top-level constant of the registry: the comment lines right above it
// and its declaration lines, each newline-terminated.
RegistryConstant: struct {
    name: String
    comments: String
    declaration: String
}

// A registry file's path and its source.
SourceFile: struct {
    path: String
    text: String
}

byte_tail: fn(text: String, start: Int) -> String Never! {
    bytes: text.bytes()
    String.from_bytes_lossy(bytes[start..<bytes.len()])
}

name_byte: fn(code: Int, at: Int) -> Bool Never! {
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || (at > 0 && code >= 48 && code <= 57)
}

// The name a line declares at its left margin (`NAME: `), or "".
declared_name: fn(line: String) -> String Never! {
    bytes: line.bytes()
    end := 0
    loop end < bytes.len() && name_byte(Int.from_u8(bytes[end]), end) -> end += 1
    if end == 0 || end + 1 >= bytes.len() || Int.from_u8(bytes[end]) != 58 || Int.from_u8(bytes[end + 1]) != 32 -> return ""
    String.from_bytes_lossy(bytes[0..<end])
}

// A registry constant's name is upper case: letters, digits and `_`.
constant_name: fn(name: String) -> Bool Never! {
    if name == "" -> return false
    loop byte in name.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 65 && code <= 90) || (code >= 48 && code <= 57) || code == 95) -> return false
    }
    true
}

// A declaration goes on while its lines are indented or close a bracket at
// the margin.
continues_declaration: fn(line: String) -> Bool Never! {
    line.starts_with(" ") || line.starts_with("\t") || line.starts_with("}}") || line.starts_with("]") || line.starts_with(")")
}

// The upper-case constants `source` declares, in order, each with the
// comment lines right above it.
registry_constants: fn(source: String) -> [RegistryConstant] Never! {
    found := [RegistryConstant]{}
    lines: source.lines()
    comments := ""
    at := 0
    loop at < lines.len() {
        line: lines[at]
        at += 1
        if line.starts_with("//") {
            comments = "{comments}{line}\n"
            next
        }
        name: declared_name(line)
        if !constant_name(name) {
            comments = ""
            next
        }
        declaration := "{line}\n"
        loop at < lines.len() && continues_declaration(lines[at]) {
            declaration = "{declaration}{lines[at]}\n"
            at += 1
        }
        found.push(RegistryConstant{name: name, comments: comments, declaration: declaration})
        comments = ""
    }
    found
}

// Every top-level name `source` declares at its left margin.
declared_names: fn(source: String) -> [String] Never! {
    names := [String]{}
    loop line in source.lines() {
        name: declared_name(line)
        if name != "" -> names.push(name)
    }
    names
}

// How many bytes equal to `code` run from `at`.
run_len: fn(bytes: [U8], at: Int, code: Int) -> Int Never! {
    end := at
    loop end < bytes.len() && Int.from_u8(bytes[end]) == code -> end += 1
    end - at
}

// The upper-case words `source` names as code: outside comments, raw text
// and string text, but inside a string's `{…}` interpolations.
code_names: fn(source: String) -> [String] Never! {
    bytes: source.bytes()
    names := [String]{}
    // The open string's quote run: 0 in code, 1 in "…", 3 in """…""".
    quotes := 0
    // Each open interpolation's string quote run and the brace depth of the
    // code around that string, outermost first; `depth` is the innermost
    // code's.
    open_quotes := [Int]{}
    open_depths := [Int]{}
    depth := 0
    at := 0
    loop at < bytes.len() {
        code: Int.from_u8(bytes[at])
        next_code: if at + 1 < bytes.len() -> Int.from_u8(bytes[at + 1]) else -> 0
        if quotes > 0 {
            if {
                code == 92 -> at += 2
                code == 34 && (quotes == 1 || run_len(bytes, at, 34) >= 3) -> {
                    at += quotes
                    quotes = 0
                }
                code == 123 && next_code == 123 -> at += 2
                code == 125 && next_code == 125 -> at += 2
                code == 123 -> {
                    open_quotes.push(quotes)
                    open_depths.push(depth)
                    depth = 0
                    quotes = 0
                    at += 1
                }
                else -> at += 1
            }
            next
        }
        if {
            code == 47 && next_code == 47 -> {
                loop at < bytes.len() && Int.from_u8(bytes[at]) != 10 -> at += 1
            }
            code == 34 -> {
                quotes = if run_len(bytes, at, 34) >= 3 -> 3 else -> 1
                at += quotes
            }
            code == 96 -> {
                ticks: run_len(bytes, at, 96)
                at += ticks
                loop at < bytes.len() {
                    if Int.from_u8(bytes[at]) == 96 {
                        closing: run_len(bytes, at, 96)
                        at += closing
                        if closing == ticks -> break
                    } else {
                        at += 1
                    }
                }
            }
            code == 39 -> {
                at += 1
                loop at < bytes.len() && Int.from_u8(bytes[at]) != 39 {
                    step: if Int.from_u8(bytes[at]) == 92 -> 2 else -> 1
                    at += step
                }
                at += 1
            }
            code == 123 -> {
                depth += 1
                at += 1
            }
            code == 125 && depth == 0 && open_quotes.len() > 0 -> {
                quotes = open_quotes[open_quotes.len() - 1]
                depth = open_depths[open_depths.len() - 1]
                _ := open_quotes.pop()
                _ := open_depths.pop()
                at += 1
            }
            code == 125 -> {
                depth -= 1
                at += 1
            }
            name_byte(code, 0) -> {
                start: at
                loop at < bytes.len() && name_byte(Int.from_u8(bytes[at]), at - start) -> at += 1
                name: String.from_bytes_lossy(bytes[start..<at])
                if constant_name(name) -> names.push(name)
            }
            code >= 48 && code <= 57 -> {
                loop at < bytes.len() && name_byte(Int.from_u8(bytes[at]), 1) -> at += 1
            }
            else -> at += 1
        }
    }
    names
}

// The value text of a declaration line: what follows `NAME: `.
declared_value: fn(constant: RegistryConstant) -> String Never! {
    byte_tail(constant.declaration, constant.name.bytes().len() + 2)
}

// Whether a copy of `constant` stands alone in the unit: a literal, a list or
// comptime block of them, or another registry constant.
standalone_value: fn(constant: RegistryConstant) -> Bool Never! {
    value: declared_value(constant)
    loop start in VALUE_STARTS {
        if value.starts_with(start) -> return true
    }
    head: value.partition(" ").head.trim()
    first: if head.bytes().len() > 0 -> Int.from_u8(head.bytes()[0]) else -> 0
    (first >= 48 && first <= 57) || head == "true" || head == "false" || constant_name(head)
}

// The registry's constants in file order, refusing a name declared twice.
read_registry: fn(sources: [SourceFile]) -> [RegistryConstant] JetpackSyntaxError! {
    constants := [RegistryConstant]{}
    owner := [String: String]{}
    loop source in sources {
        found: registry_constants(source.text)
        loop constant in found {
            seen: owner.get(constant.name) ?? ""
            if seen != "" -> return Err(syntax_fail("{constant.name} is declared in both {seen} and {source.path}"))
            // copy: the owner map outlives the borrowed name and path.
            owner[constant.name.copy()] = source.path.copy()
        }
        constants.extend(found)
    }
    Ok(constants)
}

// The names every `<import_list>…]` import list in `text` brings in, for
// an import list such as `jetpack_foundation.[`.
foundation_imports: fn(text: String, import_list: String) -> [String] Never! {
    names := [String]{}
    parts: text.split(import_list).to_list()
    loop index in 1..<parts.len() {
        list: parts[index].split("]").to_list()[0]
        loop entry in list.split(",") {
            name: entry.trim().split(" ").to_list()[0]
            if name != "" -> names.push(name)
        }
    }
    names
}

// The generated file of `target` for `unit`, the unit's sources other than
// the generated file itself, and `imported`, the names packages import from
// the unit's foundation package, given the registry `constants`.
render_registry: fn(constants: [RegistryConstant], target: SyntaxTarget, unit: [SourceFile], imported: [String]) -> String JetpackSyntaxError! {
    registry := [String: Int]{}
    index := 0
    loop constant in constants {
        // copy: the index map outlives the loop's borrowed name.
        registry[constant.name.copy()] = index
        index += 1
    }
    declared := [String: Bool]{}
    copies := [String]{}
    loop source in unit {
        loop name in declared_names(source.text) {
            if registry.get(name) != None && target.owned_prefix != "" && source.path.starts_with(target.owned_prefix) -> copies.push("{source.path} declares {name}")
            // copy: the map outlives the borrowed name.
            declared[name.copy()] = true
        }
    }
    if copies.len() > 0 -> return Err(syntax_fail("{copies.len()} declarations in {target.owned_prefix} copy a name {SYNTAX_DIR} owns; delete them so the generated {target.output} carries the registry's:\n{copies.join("\n")}"))
    wanted := [String: Bool]{}
    pending := [String]{}
    // copy: the import names stay the caller's.
    loop name in imported -> pending.push(name.copy())
    loop source in unit -> pending.extend(code_names(source.text))
    loop pending.len() > 0 {
        // copy: the pop below drops the list's slot.
        name: pending[pending.len() - 1].copy()
        _ := pending.pop()
        if declared.get(name) != None || wanted.get(name) != None -> next
        at: registry.get(name) ?? -1
        if at < 0 -> next
        wanted[name] = true
        pending.extend(code_names(declared_value(constants[at])))
    }
    unfit := [String]{}
    out := [String]{GENERATED_BY, "// Each constant is the registry's, with its comments; the tool keeps", "// exactly those {target.unit}'s sources name or packages import.", ""}
    loop constant in constants {
        if wanted.get(constant.name) == None -> next
        if !standalone_value(constant) {
            // copy: the list outlives the borrowed name.
            unfit.push(constant.name.copy())
        }
        if constant.comments != "" && out[out.len() - 1] != "" -> out.push("")
        out.push("{constant.comments}{constant.declaration.trim_end()}")
    }
    if unfit.len() > 0 -> return Err(syntax_fail("{target.unit} names registry constants whose value needs a type the unit lacks: {unfit.join(", ")}"))
    Ok("{out.join("\n")}\n")
}

read_source: fn(path: String) -[FS]> SourceFile JetpackSyntaxError! {
    text: files.read(path) ?? return Err(syntax_fail("could not read {path}: {err}"))
    // copy: the source keeps its own path.
    Ok(SourceFile{path: path.copy(), text: text})
}

// The registry files, in path order.
registry_sources: fn() -[FS]> [SourceFile] JetpackSyntaxError! {
    paths := files.glob("{SYNTAX_DIR}/*.jet") ?? return Err(syntax_fail("could not list {SYNTAX_DIR}: {err}"))
    paths.sort()
    sources := [SourceFile]{}
    loop path in paths -> sources.push(read_source(path) ?? return Err(err))
    Ok(sources)
}

// The unit's sources, without the generated file: those the assembly lists
// name, or every `.jet` file under the unit's folder.
unit_sources: fn(target: SyntaxTarget) -[FS]> [SourceFile] JetpackSyntaxError! {
    sources := [SourceFile]{}
    loop list in target.unit_lists {
        text: files.read(list) ?? return Err(syntax_fail("could not read {list}: {err}"))
        loop line in text.lines() {
            path: line.trim()
            if path == "" || path.starts_with("#") || path == target.output -> next
            sources.push(read_source(path) ?? return Err(err))
        }
    }
    if target.unit_dir == "" -> return Ok(sources)
    paths := [String]{}
    loop entry in files.walk_files(target.unit_dir, skip: IMPORT_SKIP) {
        found: entry ?? return Err(syntax_fail("could not walk {target.unit_dir}: {err}"))
        // copy: the list outlives the walk's entry.
        if found.path.ends_with(".jet") && found.path != target.output -> paths.push(found.path.copy())
    }
    paths.sort()
    loop path in paths -> sources.push(read_source(path) ?? return Err(err))
    Ok(sources)
}

// Every name a `.jet` file under IMPORT_ROOTS imports from each target's
// foundation package, one list per target.
imported_names: fn(targets: [SyntaxTarget]) -[FS]> [[String]] JetpackSyntaxError! {
    names := [[String]]{}
    loop _ in targets -> names.push([String]{})
    loop root in IMPORT_ROOTS {
        loop entry in files.walk_files(root, skip: IMPORT_SKIP) {
            found: entry ?? return Err(syntax_fail("could not walk {root}: {err}"))
            if !found.path.ends_with(".jet") -> next
            text: files.read(found.path) ?? return Err(syntax_fail("could not read {found.path}: {err}"))
            loop index in 0..<targets.len() {
                if text.contains(targets[index].import_list) -> names[index].extend(foundation_imports(text, targets[index].import_list))
            }
        }
    }
    Ok(names)
}

jetpack_syntax_main: fn(args: [String]) -[FS]> String JetpackSyntaxError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(syntax_fail(USAGE))
    constants: read_registry(registry_sources() ?? return Err(err)) ?? return Err(err)
    targets: [SyntaxTarget]{JETPACK_TARGET, COMPILER_TARGET}
    imported: imported_names(targets) ?? return Err(err)
    report := [String]{}
    loop index in 0..<targets.len() {
        target: targets[index]
        generated: render_registry(constants, target, unit_sources(target) ?? return Err(err), imported[index]) ?? return Err(err)
        current: if files.exists(target.output) -> files.read(target.output) ?? return Err(syntax_fail("could not read {target.output}: {err}")) else -> ""
        if current == generated {
            report.push("{target.output} is up to date")
            next
        }
        if mode == "--check" -> return Err(syntax_fail("{target.output} differs from {SYNTAX_DIR}; run jet Tools/agent/JetpackSyntax.jet --write"))
        files.write(target.output, generated) ?? return Err(syntax_fail("could not write {target.output}: {err}"))
        report.push("wrote {target.output}")
    }
    Ok(report.join("\n"))
}

run: fn() { print(jetpack_syntax_main(process.args()) ?? process.fail(1, err.message)) }

#Test("a registry constant keeps its comments and its continued declaration") {
    source: "// Section.\n\n/// The first.\nFIRST: \"a\" // S1\nLIST: [String]{{\n    FIRST,\n}}\nType: struct {{\n    x: Int\n}}\nlower: \"b\"\n"
    constants: registry_constants(source)
    // FIRST and LIST; `Type` and `lower` are not constants.
    assert_eq(constants.len(), 2)
    assert_eq(constants[0].name, "FIRST")
    // The section comment ends at the blank line.
    assert_eq(constants[0].comments, "/// The first.\n")
    assert_eq(constants[0].declaration, "FIRST: \"a\" // S1\n")
    assert_eq(constants[1].declaration, "LIST: [String]{{\n    FIRST,\n}}\n")
    // Every margin declaration counts as declared.
    assert_eq(declared_names(source), [String]{"FIRST", "LIST", "Type", "lower"})
}

#Test("code names skip comments and string text but read interpolations") {
    source: "x: A_B + f(\"C_D {{{{E}}}} {{H_I.join(\"{{J}}\")}}\") // K_L\ny: 'M' + N\n"
    // C_D and E are string text, K_L is a comment and 'M' is a character.
    assert_eq(code_names(source), [String]{"A_B", "H_I", "J", "N"})
}

#Test("the generated file carries the named constants and what they name, in registry order") {
    registry: read_registry([SourceFile]{
        SourceFile{path: "a.jet", text: "UNUSED: \"u\"\n/// Verbs.\nVERBS: [String]{{\n    VERB_GO,\n}}\nVERB_GO: \"go\"\nSHARED: \"s\"\n"},
    }) ?? panic("registry: {err.message}")
    unit: [SourceFile]{
        SourceFile{path: "Compiler/Shared.jet", text: "SHARED: \"s\"\n"},
        SourceFile{path: "Jetpack/A.jet", text: "run: fn() {{ print(VERBS.join(\", \")); print(SHARED) }}\n"},
    }
    generated: render_registry(registry, JETPACK_TARGET, unit, [String]{}) ?? panic("render: {err.message}")
    // VERB_GO comes through VERBS; SHARED stays with the Compiler source that
    // declares it; UNUSED is left out.
    assert_eq(generated, "{GENERATED_BY}\n// Each constant is the registry's, with its comments; the tool keeps\n// exactly those the Jetpack unit's sources name or packages import.\n\n/// Verbs.\nVERBS: [String]{{\n    VERB_GO,\n}}\nVERB_GO: \"go\"\n")
}

#Test("a name a package imports from a target's foundation package is carried") {
    importer: "use {{\n    jetpack_artifact_store.[Store]\n    jetpack_foundation.[\n        HOME_DIR, other_fn,\n    ]\n    jet_foundation.[COMMENT_PREFIX]\n}}\n"
    assert_eq(foundation_imports(importer, JETPACK_TARGET.import_list), [String]{"HOME_DIR", "other_fn"})
    assert_eq(foundation_imports(importer, COMPILER_TARGET.import_list), [String]{"COMMENT_PREFIX"})
    registry: read_registry([SourceFile]{SourceFile{path: "a.jet", text: "HOME_DIR: \"/h\"\nUNUSED: \"u\"\n"}}) ?? panic("registry: {err.message}")
    generated: render_registry(registry, JETPACK_TARGET, [SourceFile]{}, foundation_imports(importer, JETPACK_TARGET.import_list)) ?? panic("render: {err.message}")
    assert(generated.ends_with("\nHOME_DIR: \"/h\"\n"))
    assert(!generated.contains("UNUSED"))
}

#Test("a Jetpack hand copy of a registry name is refused, naming the file") {
    registry: read_registry([SourceFile]{SourceFile{path: "a.jet", text: "VERB_GO: \"go\"\n"}}) ?? panic("registry: {err.message}")
    unit: [SourceFile]{SourceFile{path: "Jetpack/Syntax.jet", text: "VERB_GO: \"go\"\nuse_it: fn() {{ print(VERB_GO) }}\n"}}
    if render_registry(registry, JETPACK_TARGET, unit, [String]{}) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error.message.contains("Jetpack/Syntax.jet declares VERB_GO"))
    }
}

#Test("a registry name declared twice, or a named constant of another type, is refused") {
    twice: [SourceFile]{SourceFile{path: "a.jet", text: "X_Y: \"1\"\n"}, SourceFile{path: "b.jet", text: "X_Y: \"2\"\n"}}
    if read_registry(twice) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message, "jetpack syntax: X_Y is declared in both a.jet and b.jet")
    }
    registry: read_registry([SourceFile]{SourceFile{path: "a.jet", text: "ROWS: [Row]{{}}\nCOUNT: 3\nALIAS: COUNT\n"}}) ?? panic("registry: {err.message}")
    unit: [SourceFile]{SourceFile{path: "Jetpack/A.jet", text: "f: fn() {{ print(ROWS.len() + ALIAS) }}\n"}}
    if render_registry(registry, JETPACK_TARGET, unit, [String]{}) == {
        // ROWS needs the Row type; COUNT and ALIAS stand alone.
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error.message.ends_with(": ROWS"))
    }
}
