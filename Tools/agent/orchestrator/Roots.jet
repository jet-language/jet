// The dev tool roots for the orchestrator's Jet twins: the twin of
// Tools/agent/roots.sh, which their originals source (gauntlet tool entry
// roots-sh). A root is what the machine's ${XDG_CONFIG_HOME:-$HOME/.config}/jet/env
// sets, else the environment's value, else the default derived from $HOME and
// the XDG directories; the checkout is the one holding the program (three up
// from its directory, as roots.sh's is two up from its own), unless set.
//
//   jet Tools/agent/orchestrator/Roots.jet NAME...
//
// prints `NAME=value` for each root named, as `bash roots.sh NAME...` does,
// and exits 64 at any other name. Tools/agent/Roots.jet is the twin of
// roots.mjs.
//
// The env file is read as `.` sources it, in the format roots.sh documents
// (sys.env_file), with no shell; a command outside it, or an unset
// ${NAME:?word}, is a failure that roots() passes up, so the program exits 1,
// as a failing file ends roots.sh.
use core.[files, process, sys]

// The eight roots and their values, roots.sh's table: each line's default
// takes an unset or empty root's place, a later line seeing an earlier one.
roots: fn() -> [String:String] {
    vars := sys.env_file("{sys.config_dir() ?? ""}/jet/env")
    vars["checkout"] = files.normalize("{sys.executable()}/../../../..")
    sys.env_text("""
        JET_STATE_ROOT=${{JET_STATE_ROOT:-${{XDG_CACHE_HOME:-$HOME/.cache}}/jet-dev}}
        JET_SCRATCH_ROOT=${{JET_SCRATCH_ROOT:-$JET_STATE_ROOT}}
        JET_RUN_ROOT=${{JET_RUN_ROOT:-$JET_SCRATCH_ROOT/run}}
        JET_BASE_ROOT=${{JET_BASE_ROOT:-$JET_SCRATCH_ROOT/discovery/base}}
        JET_TARGET_ROOT=${{JET_TARGET_ROOT:-$JET_SCRATCH_ROOT/targets}}
        JET_SEEDS=${{JET_SEEDS:-${{XDG_DATA_HOME:-$HOME/.local/share}}/jet-seeds}}
        JET_SEED=${{JET_SEED:-$JET_SEEDS/current}}
        JET_DEV_WORKTREE=${{JET_DEV_WORKTREE:-$checkout}}
        """, vars)
}

run: fn() {
    vars: roots()
    loop name in process.args() {
        print("{name}={vars.get(name) ?? process.fail(64, "roots: unknown root {name}")}")
    }
}
