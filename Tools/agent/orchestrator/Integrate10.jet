// Integrate10.jet BATCH SUB...: Main's integration pass. Each SUB is an inbox
// folder ($JET_SCRATCH_ROOT/lanes/Main/inbox/<Lead>-<n>/) holding `patch`
// (git apply -p1 against origin/dev), `msg`, `tests` (one shell command per
// line, run from the tree root with `jet` = the compiler this pass builds)
// and `cards`. Steps, all collect-all:
//   1. export origin/dev to integ/BATCH/tree, apply INTEG_PRE's stacked SUBs
//      ("BATCH:SUB ...", already tested in a batch still landing), then every
//      SUB through IntegApply6.jet (a SUB that does not apply is reported and
//      skipped); a failed regeneration stops the pass (3);
//   2. one census of the composed tree through CensusSnap2.jet under a 32G
//      cap, then every ratchet check with the seed at once; every keep-going
//      row is attributed to the SUBs whose touched files it names;
//   3. if the build produced a compiler, every SUB's tests run with it four
//      SUBs at a time (runsub6.sh), the failing ones rerun on a clean dev
//      export with the seed, and the goldens citing a touched Core or Prelude
//      file run.
// Writes integ/BATCH/REPORT.md (one section per SUB: OK, or every failure
// found) and prints its path.
//
// The Jet twin of integrate10.sh (gauntlet tool entry integrate10): the
// batches are in $JET_SCRATCH_ROOT/lanes/Main/integ, the dev worktree is
// $JET_DEV_WORKTREE and the seed $JET_SEED; IntegApply6.jet and
// CensusSnap2.jet are the ones in $JET_ORCHESTRATOR_DIR (this program's
// directory unless set), run by $JET (`jet` on PATH unless set), and
// capped.sh and runsub6.sh are Main's, in $JET_STATE_ROOT/scratch/Main, the
// roots as Roots.jet finds them.
use {
    files: core.files
    process: core.process
    regex: core.regex
    roots: "Roots"
    sys: core.sys
}

// The test durations a FAIL row drops before two runs' rows are compared.
DURATION: Regex{"[0-9]+(\.[0-9]+)? ?(ms|s|µs)"}
// The touched files whose lines goldens cite.
CORE_SOURCE: Regex{"^(Core|Compiler/Prelude)/.*\.jet$"}

// Ends the run with `code` after `line`.
stop: fn(line: String, code: Int) -> Never {
    print(line)
    process.exit(code)
}

// A finished child's exit status, 124 when its timeout stopped it.
rc: fn(receipt: ProcessReceipt) -> Int { if receipt.timed_out -> 124 else -> receipt.code }

// The lines of the file at `path`, none when it can't be read.
lines_of: fn(path: String) -> [String] { files.read_or(path, "").lines() }

// `lines` sorted, each once.
unique: fn(lines: [String]) -> [String] {
    sorted := lines
    sorted.sort()
    sorted.dedup().to_list()
}

// The names in `dir` that `matching` names, sorted.
named: fn(dir: String, matching: String) -> [String] {
    names := loop entry in files.list_dir_or(dir, [], matching: matching) -> entry.name
    names.sort()
    names
}

// `git archive COMMIT` of the dev worktree unpacked into `dir`.
unpack: fn(w: String, commit: String, dir: String) -> Bool {
    piped: process.pipeline([Sh{"git -C {w} archive {commit}"}.spec(), Sh{"tar -x -C {dir}"}.spec()]) ?? return false
    piped.success
}

// The FAIL rows of a test log without their durations, sorted once each.
fail_rows: fn(path: String) -> [String] {
    unique(loop line in lines_of(path).filter(fn(line) { line.contains("FAIL") }) -> regex.replace(DURATION, line, ""))
}

// The report lines of one SUB test line; whether it counts against the SUB.
test_entry: fn(out: &[String], tests: String, k: Int, code: String, line: String) -> Bool {
    if code == "0" {
        out.push("- PASS `{line}`")
        return false
    }
    o: "{tests}.{k}.out"
    bo: "{tests}.{k}.base.out"
    base_rc: files.read_or("{tests}.{k}.base.rc", "0").trim()
    raw: files.read_or(o, "")
    log: raw.lines()
    if base_rc != "0" && files.is_file(bo) {
        ours: fail_rows(o)
        theirs: fail_rows(bo)
        fresh: ours.filter(fn(row) { !theirs.contains(row) })
        if fresh.len() == 0 && ours.len() > 0 {
            out.push("- PRE-EXISTING rc={code} `{line}`: every FAIL row also fails on origin/dev with the seed ({bo})")
            return false
        }
        out.push("- FAIL rc={code} `{line}` (full output {o}; dev with the seed also fails, rc={base_rc}, {bo}). FAIL rows not on dev:")
        out.push("```")
        out.extend(if fresh.len() > 0 -> fresh.slice(0, 25) else -> log.filter(fn(text) { ["error", "Error", "panic", "failed"].any(fn(word) { text.contains(word) }) }).slice(0, 25).concat(raw.last_lines(5)))
        out.push("```")
        return true
    }
    out.push("- FAIL rc={code} `{line}` (full output {o}; passes on origin/dev with the seed or was not rerun):")
    out.push("```")
    out.extend(log.filter(fn(text) { ["FAIL", "error", "Error", "panic", "failed"].any(fn(word) { text.contains(word) }) }).slice(0, 25).concat(raw.last_lines(5)))
    out.push("```")
    true
}

run: fn() {
    args: process.args()
    if args.len() == 0 || args[0] == "" -> process.fail(1, "usage: jet Tools/agent/orchestrator/Integrate10.jet BATCH SUB...")
    batch: args[0]
    subs: args.slice(1, args.len())
    r: roots.roots()
    w: r["JET_DEV_WORKTREE"]
    g: "{r["JET_STATE_ROOT"]}/scratch/Main"
    o: process.env_nonempty("JET_ORCHESTRATOR_DIR") ?? files.dirname(sys.executable())
    i: "{r["JET_SCRATCH_ROOT"]}/lanes/Main/integ/{batch}"
    t: "{i}/tree"
    files.remove_all(i) ?? ()
    loop dir in [t, "{i}/tests", "{i}/bin"] -> files.create_dir_all(dir)
    if !(Sh{"git -C {w} fetch -q origin"}.ok()) -> stop("integrate: export failed", 2)
    based: Sh{"git -C {w} rev-parse --short origin/dev"}.run() ?? stop("integrate: export failed", 2)
    base: based.output.trim()
    if based.code != 0 || !unpack(w, "origin/dev", t) -> stop("integrate: export failed", 2)
    files.write("{i}/BASE", "{base}\n")
    report_path: "{i}/REPORT.md"
    report := ["# Integration {batch} on origin/dev {base}", ""]
    files.write(report_path, "{report.join("\n")}\n")
    stacked := [String]{}
    loop ps in (process.env_nonempty("INTEG_PRE") ?? "").words() {
        // An item without a batch names the SUB for both.
        parts: ps.partition(":")
        pb: parts.head
        pd: if parts.sep == "" -> ps else -> parts.tail
        if !(Sh{"git -C {t} apply -p1 {files.join(files.cwd(), "{pd}/patch")}"}.ok()) -> stop("integrate: pre {pd} does not apply", 2)
        stacked.push(pb.copy())
        files.write("{i}/PRE", "{stacked.join("\n")}\n")
        print("PRE {files.basename(pd)} from {pb}")
    }
    // Apply (three-way, generated files excluded and regenerated): IntegApply6.jet prints the applied SUBs last.
    apply: Sh{"jet -A {"{o}/IntegApply6.jet"} {t} {i}"}.extend(subs).spec().stderr(.Stdout).run()
    files.write("{i}/apply.out", apply.output)
    if apply.code != 0 -> stop("integrate: the apply step failed: {apply.output.lines().filter(fn(line) { line.starts_with("integ-apply:") }).last() ?? ""}", 2)
    listing: apply.output.partition("--applied--\n")
    if listing.head != "" -> print(listing.head.trim_end())
    applied: listing.tail.words()
    // A generator that fails on the composed sources leaves every generated table stale: report the regeneration.
    if listing.head.lines().any(fn(line) { line.starts_with("REGEN ") && !line.ends_with(" rc=0") }) {
        report.push("REGEN FAILED: the census did not run.")
        loop name in named(i, "regen.*.out") -> report.extend(["", "{name}:", "```"].concat(files.read_or("{i}/{name}", "").last_lines(20)).concat(["```"]))
        files.write(report_path, "{report.join("\n")}\n")
        files.write("{i}/REGENFAIL", "REGENFAIL\n")
        stop(report_path, 3)
    }
    // The census: every file any applied SUB touches selects the Jetpack pass when it is under Jetpack/.
    touched := [String]{}
    loop s in applied -> touched.extend(lines_of("{i}/{files.basename(s)}.files"))
    touched = unique(touched)
    print("census start")
    census: Sh{"bash {"{g}/capped.sh"} 32G jet -A {"{o}/CensusSnap2.jet"}"}.extend(touched).spec().env("CENSUS_TREE", t).env("CENSUS_OUT", "{i}/census").env("CAP_CPUS", "16-31").stderr(.Stdout).run()
    files.write("{i}/census.out", census.output)
    crc := census.code
    print("census rc={crc}")
    // The repository ratchets and generator checks (Land.jet ratchets), with the seed on the composed tree, all at once.
    seed: files.canonicalize(r["JET_SEED"])
    id: files.read("{seed}/IDENTITY").trim()
    ratchets: Sh{"{"{seed}/jet"} Tools/agent/Land.jet ratchets"}.spec().cwd(t).env("JET_COMPILER_IDENTITY", id).env("JET_TOOLCHAIN_ROOT", t).run().output.lines()
    files.create_dir_all("{i}/ratchets")
    if ratchets.len() == 0 -> files.write("{i}/ratchets/none.out", "no ratchets listed\n")
    checks: process.run_all(loop tool in ratchets -> Sh{"nice -n 19 {"{seed}/jet"} {tool} --check"}.spec().cwd(t).env("JET_COMPILER_IDENTITY", id).env("JET_TOOLCHAIN_ROOT", t).timeout(900s).stderr(.Stdout), ratchets.len() + 1)
    summary := census.output.lines().filter(fn(line) { line.contains(" rc=") || line.contains("rows=") })
    failures := [String]{}
    rrc := if ratchets.len() == 0 -> 1 else -> 0
    loop at in 0..<ratchets.len() {
        name: files.basename(ratchets[at])
        receipt: checks[at] ?? stop("integrate: ratchet {name}: {err}", 2)
        files.write("{i}/ratchets/{name}.out", receipt.output)
        files.write("{i}/ratchets/{name}.rc", "{rc(receipt)}\n")
        summary.push("ratchet {name} rc={rc(receipt)}")
        if rc(receipt) != 0 {
            rrc = 1
            failures.extend(["Ratchet {name} failed:", "```"].concat(receipt.output.last_lines(30)).concat(["```"]))
        }
    }
    print("ratchets rc={rrc}")
    if rrc != 0 -> crc = 1
    self_jet: "{t}/Compiler/JetCli/.jet/build/jet"
    built: files.can_execute(self_jet)
    if built -> files.symlink(self_jet, "{i}/bin/jet", replace: true)
    // The engine `jet` talks to must be the seed's jetpack, whose identity JET_COMPILER_IDENTITY names.
    if files.can_execute("{seed}/jetpack") -> files.symlink("{seed}/jetpack", "{i}/bin/jetpack", replace: true)
    // The engine beside the batch compiler must be the jetpack this tree builds: the census's hosted bootstrap
    // names it as hosted-binary.
    hb: (lines_of("{i}/census/jetpack.log").filter(fn(line) { line.starts_with("hosted-binary: ") }).last() ?? "").words().get(1) ?? ""
    if {
        hb != "" && files.can_execute(hb) -> {
            packed: "{i}/bin/jetpack.built"
            files.copy(hb, packed)
            files.set_mode(packed, files.stat(hb).mode % 512)
            files.symlink(packed, "{i}/bin/jetpack", replace: true)
            if built -> files.symlink(packed, "{files.dirname(files.canonicalize(self_jet))}/jetpack", replace: true)
            print("tests use the built jetpack {hb}")
        }
        else -> print("no built jetpack (census jetpack row failed); tests use the seed's")
    }
    runsub: fn(step: String, sub: String) -> ProcessSpec { Sh{"bash {"{g}/runsub6.sh"} {step} {sub}"}.spec().env("I", i).env("T", t).env("SELF", self_jet).env("ID", id).env("G", g).env("B", "{i}/basetree").env("C0", seed).stdout(.Inherit).stderr(.Inherit) }
    golden_rcs := [String]{}
    if built {
        // Every SUB runs its test lines as one job, four SUBs at a time.
        _ := process.run_all(loop s in applied.filter(fn(s) { files.read_or("{s}/tests", "") != "" }) -> runsub("new", s), 4)
        // A failing line reruns on a clean origin/dev export with the seed, so rows that already fail on dev are
        // told apart from the ones this batch introduces (a FAIL row present in both counts as pre-existing).
        failing: loop name in named("{i}/tests", "*.rc").filter(fn(name) { lines_of("{i}/tests/{name}").any(fn(line) { !line.starts_with("0\t") }) }) -> name.removesuffix(".rc")
        if failing.len() > 0 {
            loop dir in ["{i}/basetree", "{i}/basebin"] -> files.create_dir_all(dir)
            _ := unpack(w, base, "{i}/basetree")
            files.symlink("{seed}/jet", "{i}/basebin/jet", replace: true)
            files.symlink("{seed}/jetpack", "{i}/basebin/jetpack", replace: true)
            _ := process.run_all(loop name in failing -> runsub("base", name), 4)
            files.remove_all("{i}/basetree")
        }
        // Goldens that cite a line of a Core or Prelude file this batch touches (`<corelib>/Core/X.jet:N`) drift
        // when that file moves; run each one so the batch, not the release gate, catches it.
        cited := [String]{}
        loop f in touched.filter(fn(f) { regex.is_match(CORE_SOURCE, f) }) -> cited.extend(Sh{"git grep -l --no-index -F {"<corelib>/{f}:"} -- *.out"}.spec().cwd(t).run().output.lines())
        cited = unique(cited)
        files.write("{i}/goldens.list", cited.map(fn(path) { "{path}\n" }).join(""))
        loop golden in cited {
            stem: golden.removesuffix(".out").removesuffix(".err")
            ran: Sh{"bash {"{g}/capped.sh"} 24G nice -n 19 jet test Compiler --profile golden {stem}"}.spec().cwd(t)
                .env("PATH", "{i}/bin:{process.env_nonempty("PATH") ?? ""}").env("JET", self_jet).env("JET_COMPILER_IDENTITY", id).env("JET_TOOLCHAIN_ROOT", t).env("CAP_CPUS", "16-31")
                .timeout(1800s).stderr(.Stdout).run()
            files.write("{i}/goldens.{stem.replace("/", "_")}.out", ran.output)
            golden_rcs.push("{rc(ran)}\t{stem}")
            summary.push("golden {stem} rc={rc(ran)}")
        }
        if golden_rcs.len() > 0 -> files.write("{i}/goldens.rc", "{golden_rcs.join("\n")}\n")
    }
    // The report: the summary, then one section per SUB.
    rows := [String]{}
    loop name in named("{i}/census", "*keep-going.tsv") -> rows.extend(lines_of("{i}/census/{name}"))
    report.extend(["Census rc={crc} (built compiler: {if built -> "yes" else -> "no"}). Summary:", "```"].concat(summary).concat(["```"]).concat(failures).concat([""]))
    loop sub in subs {
        n: files.basename(sub.removesuffix("/"))
        report.push("## {n}")
        if files.is_file("{i}/{n}.status") {
            report.extend(["Does not apply to origin/dev {base}:", "```"].concat(lines_of("{i}/{n}.apply").slice(0, 20)).concat(["```", ""]))
            next
        }
        mine: lines_of("{i}/{n}.files").filter(fn(path) { path != "" })
        hits: unique(rows.filter(fn(row) { mine.any(fn(path) { row.contains(path) }) }))
        bad := hits.len() > 0
        if bad -> report.extend(["Census rows in files this patch touches:", "```"].concat(hits).concat(["```"]))
        tests: "{i}/tests/{n}"
        if {
            files.is_file("{tests}.rc") -> {
                entries: lines_of("{tests}.rc")
                loop at in 0..<entries.len() {
                    parts: entries[at].partition("\t")
                    if test_entry(report, tests, at + 1, parts.head, parts.tail) -> bad = true
                }
            }
            !built -> {
                bad = true
                report.push("Tests not run: the composed tree did not build (see census).")
            }
            else -> report.push("No tests listed.")
        }
        verdict: !bad && crc == 0
        report.extend(["", if verdict -> "**OK**" else -> "**NOT OK**", ""])
        files.write("{i}/{n}.status", if verdict -> "OK\n" else -> "BAD\n")
    }
    if crc != 0 {
        named_paths := [String]{}
        loop s in applied -> named_paths.extend(lines_of("{i}/{files.basename(s)}.files").filter(fn(path) { path.trim() != "" }))
        report.extend(["## Census rows not in any submitted file", "```"].concat(rows.filter(fn(row) { !named_paths.any(fn(path) { row.contains(path) }) }).slice(0, 40)).concat(["```"]))
    }
    files.write(report_path, "{report.join("\n")}\n")
    print(report_path)
}
