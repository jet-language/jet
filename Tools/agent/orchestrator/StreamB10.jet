// StreamB10.jet A_BATCH B_BATCH SUB...: as soon as A_BATCH's census has a
// stage-1 compiler with its runtime, runs B_BATCH (the SUBs that need a seed
// carrying A's rows) through integrate10.sh with that compiler as its seed.
// The Jet twin of streamB10.sh (gauntlet tool entry streamb10): the batches
// live in $JET_SCRATCH_ROOT/lanes/Main/integ, the seed's IDENTITY and jetpack
// come from $JET_SEED (the roots as Roots.jet finds them), and integrate10.sh
// is the one in $JET_ORCHESTRATOR_DIR, this program's directory unless set.
use {
    files: core.files
    process: core.process
    roots: "Roots"
    sys: core.sys
    time: core.time
}

run: fn() {
    args: process.args()
    if args.len() < 2 -> process.fail(1, "usage: jet Tools/agent/orchestrator/StreamB10.jet A_BATCH B_BATCH SUB...")
    r: roots.roots()
    integ: "{r["JET_SCRATCH_ROOT"]}/lanes/Main/integ"
    loop {
        census: files.read_or("{integ}/{args[0]}/census.out", "")
        if census.has_line_prefix("runtime rc=0") -> break
        if census.has_line("^(runtime rc=1|build rc=[1-9]|check rc=[1-9])") {
            print("streamB: {args[0]} has no compiler")
            process.exit(2)
        }
        time.sleep(30s)
    }
    seed: "{integ}/seed-{args[0]}"
    build: "{integ}/{args[0]}/tree/Compiler/JetCli/.jet/build"
    current: files.canonicalize(r["JET_SEED"])
    files.remove_all(seed) ?? ()
    files.create_dir_all(seed)
    files.copy("{build}/jet", "{seed}/jet")
    files.copy_dir("{build}/jet-runtime", "{seed}/jet-runtime")
    files.copy("{current}/IDENTITY", "{seed}/IDENTITY")
    files.symlink("{current}/jetpack", "{seed}/jetpack")
    print("streamB: seed {seed} ready")
    subs: args.slice(2, args.len())
    loop sub in subs {
        if !files.is_dir(sub) -> print("streamB: not staged, skipped: {sub}")
    }
    integrate: "{process.env_nonempty("JET_ORCHESTRATOR_DIR") ?? files.dirname(sys.executable())}/integrate10.sh"
    batch: Sh{"{integrate} {args[1]}"}.extend(subs.filter(sub -> files.is_dir(sub))).spec().env("CENSUS_JET_DIR", seed).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run()
    if batch.code != 0 -> process.exit(batch.code)
}
