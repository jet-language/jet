// VerifyRows.jet ROWS OUTDIR [JET]: runs every "criterion<TAB>profile<TAB>filter"
// row of ROWS as `jet test Compiler --profile P --filter F` from the dev
// worktree, six at a time on CPUs 0-11, each under a 600 s timeout with its
// output in OUTDIR/C.P.F.out, and prints one line per row: criterion,
// profile, filter, PASS count, FAIL count, rc. The Jet twin of
// verify-rows.sh (gauntlet tool entry verify-rows); the dev worktree is
// $JET_DEV_WORKTREE as Roots.jet finds it.
use {
    files: core.files
    process: core.process
    roots: "Roots"
}

// The number after `"KEY":` in a testkit summary line, 0 when it has none.
count: fn(summary: String, key: String) -> Int {
    summary.partition("\"{key}\":").tail.partition(",").head.partition("}}").head.to_int() ?? 0
}

run: fn() {
    args: process.args()
    if args.len() < 2 || args.len() > 3 -> process.fail(2, "usage: jet Tools/agent/orchestrator/VerifyRows.jet ROWS OUTDIR [JET]")
    out: args[1]
    given: args.get(2) ?? "jet"
    // A JET given as a relative path still names it from the worktree.
    jet: if given.contains("/") && !given.starts_with("/") -> "{files.cwd()}/{given}" else -> given
    rows: files.read(args[0]).tsv_records().filter(cells -> cells.len() >= 3)
    files.create_dir_all(out)
    cpus: loop cpu in 0..<12 -> cpu
    specs: loop row in rows -> Sh{"{jet} test Compiler --profile {row[1]} --filter {row[2]}"}.spec().cwd(roots.worktree()).stderr(.Stdout).output_limit(268435456).timeout(600s).cpu_affinity(cpus)
    results: process.run_all(specs, 6)
    loop at in 0..<rows.len() {
        row: rows[at]
        log: "{out}/{row[0]}.{row[1]}.{row[2]}.out"
        receipt: results[at] ?? {
            files.write(log, "{err}\n")
            print("{row[0]}\t{row[1]}\t{row[2]}\tPASS=0\tFAIL=0\trc=127")
            next
        }
        files.write(log, receipt.output)
        summary: receipt.output.lines().filter(line -> line.starts_with("{{\"PASS\"")).last() ?? ""
        print("{row[0]}\t{row[1]}\t{row[2]}\tPASS={count(summary, "PASS")}\tFAIL={count(summary, "FAIL")}\trc={if receipt.timed_out -> 124 else -> receipt.code}")
    }
}
