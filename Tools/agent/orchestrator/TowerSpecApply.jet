// TowerSpecApply.jet SPEC.json [--go]: applies a spec of Tower card edits.
// Spec: [{num, title?, bodyReplace?:[[from,to]], planReplace?:[[from,to]], body?, plan?,
//         rewrite?:{n:text}, replace?:[[n,from,to]] (n="*" = every open criterion),
//         remove?:[n], add?:[text], log:text, close?:evidence, closeKind?, addTags?:[t]}]
// Without --go: dry run printing the changes.
//
// The Jet twin of tower-spec-apply.mjs (gauntlet tool entry tower-spec-apply):
// cards are read with `node Tools/tower/tower.mjs` in $TOWER_SPEC_REPO (this
// checkout unless set) and written through Main's Tower writer,
// $TOWER_SPEC_WRITER ($JET_STATE_ROOT/scratch/Main/tower-dev.mjs unless set),
// which takes the card patches from $TOWER_SPEC_PATCHES
// ($JET_SCRATCH_ROOT/lanes/Main unless set), the roots as Roots.jet finds
// them. A relative root names a path in the caller's directory.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    roots: "Roots"
    sys: core.sys
    term: core.term
}

// `v` when it is text, else "".
str: fn(v: Dyn) -> String { if v == .Text(t) -> t.copy() else -> "" }

// The text field `key` of `v`, "" when it has none.
text: fn(v: Dyn, key: String) -> String { str(v.get(key) ?? Dyn.Null) }

// The list field `key` of `v`, empty when it has none.
list: fn(v: Dyn, key: String) -> [Dyn] { if v.get(key) == .Val(.Array(l)) -> l.copy() else -> [] }

// A criterion number as the spec or card writes it.
label: fn(v: Dyn?) -> String {
    if v == .Val(.Text(t)) -> return t.copy()
    json.dumps(v ?? Dyn.Null) ?? ""
}

// The first `limit` characters of `t`, marked with … when it was longer.
cut: fn(t: String, limit: Int) -> String { if t.len() > limit -> "{t.slice(0, limit)}…" else -> t.copy() }

// `argv` in the Tower checkout with the caller's git index unset: its stdout.
node: fn(repo: String, argv: [String]) -> String Err! {
    r: process.cmd(argv).cwd(repo).env_remove("GIT_INDEX_FILE").stderr(.Inherit).output_limit(67108864).run() ?? return Err("Command failed: {argv.join(" ")}")
    if r.code != 0 -> return Err("Command failed: {argv.join(" ")}")
    Ok(r.output)
}

card: fn(repo: String, num: String) -> Dyn Err! {
    j: json.parse(node(repo, ["node", "Tools/tower/tower.mjs", "card", "show", num, "--json"]) ?? return Err(err)) ?? return Err("{err}")
    Ok(if j.get("card") == .Val(.Object(_)) -> j.get("card") ?? j else -> j)
}

// The Tower writer's trimmed answer to `args`.
tower: fn(repo: String, writer: String, args: [String]) -> String Err! {
    Ok((node(repo, ["node", writer].concat(args).concat(["--by", "Main"])) ?? return Err(err)).trim())
}

// `t` with every `from` replaced by `to`; `place` names it when `from` is absent.
sub: fn(t: String, from: String, to: String, place: String) -> String Err! {
    if !t.contains(from) -> return Err("{place}: text not found: {from}")
    Ok(t.replace(from, to))
}

// The index of criterion `n` in `crit`.
by_n: fn(crit: [Dyn], n: Dyn?, num: String) -> Int Err! {
    loop at in 0..<crit.len() {
        if label(crit[at].get("n")) == label(n) -> return Ok(at)
    }
    Err("#{num} no c{label(n)}")
}

apply: fn(s: Dyn, repo: String, writer: String, patches: String, go: Bool{false}) Err! {
    num: label(s.get("num"))
    c: card(repo, num) ?? return Err(err)
    crit := list(c, "criteria")
    changes := [String]{}
    rewrite: s.get("rewrite") ?? Dyn.object()
    loop key in rewrite.keys() {
        at: by_n(crit, Dyn.Text(key), num) ?? return Err(err)
        if text(crit[at], "status") != "open" -> return Err("#{num} c{key} is {text(crit[at], "status")}")
        new: text(rewrite, key)
        changes.push("c{key} REWRITE\n   old: {text(crit[at], "text")}\n   new: {new}")
        crit[at]["text"] = Dyn.Text(new)
    }
    loop step in list(s, "replace") {
        p: if step == .Array(l) -> l.concat([Dyn.Null, Dyn.Null, Dyn.Null]) else -> [Dyn.Null, Dyn.Null, Dyn.Null]
        from: str(p[1])
        to: str(p[2])
        every: p[0] == Dyn.Text("*")
        targets := [Int]{}
        if !every -> targets.push(by_n(crit, p[0], num) ?? return Err(err))
        loop at in 0..<crit.len() {
            if every && text(crit[at], "status") == "open" && text(crit[at], "text").contains(from) -> targets.push(at)
        }
        if targets.len() == 0 -> return Err("#{num} *: no open criterion has {from}")
        loop at in targets {
            n: label(crit[at].get("n"))
            crit[at]["text"] = Dyn.Text(sub(text(crit[at], "text"), from, to, "#{num} c{n}") ?? return Err(err))
            changes.push("c{n} REPLACE '{from}' -> '{to}'")
        }
    }
    removed := [Int]{}
    loop n in list(s, "remove") {
        at: by_n(crit, n, num) ?? return Err(err)
        if text(crit[at], "status") != "open" -> return Err("#{num} c{label(n)} is {text(crit[at], "status")}, not removable")
        removed.push(at)
    }
    next := 0
    kept := [Dyn]{}
    loop at in 0..<crit.len() {
        n: label(crit[at].get("n")).to_int() ?? 0
        if n > next -> next = n
        if !removed.contains(at) -> kept.push(crit[at].copy())
    }
    loop added in list(s, "add") {
        next += 1
        kept.push(Dyn.Object(["n": Dyn.Int(next), "text": added.copy(), "status": Dyn.Text("open")]))
        changes.push("c{next} ADD {str(added)}")
    }
    loop at in removed -> changes.push("c{label(crit[at].get("n"))} REMOVE {text(crit[at], "text")}")
    patch := Dyn.object()
    if changes.len() > 0 -> patch["criteria"] = Dyn.Array(kept)
    title: text(s, "title")
    if title != "" {
        patch["title"] = Dyn.Text(title)
        changes.push("TITLE {text(c, "title")}\n   -> {title}")
    }
    loop field in ["body", "plan"] {
        old: text(c, field)
        new := old.copy()
        loop pair in list(s, "{field}Replace") {
            p: if pair == .Array(l) -> l.concat([Dyn.Null, Dyn.Null]) else -> [Dyn.Null, Dyn.Null]
            new = sub(new, str(p[0]), str(p[1]), "#{num} {field}") ?? return Err(err)
        }
        if s.has(field) -> new = text(s, field)
        if new != old {
            patch[field] = Dyn.Text(new.copy())
            changes.push("{field.upper()} changed ({old.len()} -> {new.len()} chars)")
        }
    }
    if s.has("addTags") -> patch["addTags"] = s.get("addTags") ?? Dyn.Null
    quoted: loop at in removed -> "c{label(crit[at].get("n"))} \"{cut(text(crit[at], "text"), 140).words().join(" ")}\""
    log: "{text(s, "log")}{if removed.len() > 0 -> " Removed as superseded: {quoted.join("; ")}." else -> ""}"
    close: text(s, "close")
    print("\n#### #{num} {text(c, "title")} [{text(c, "phase")}]\n  {changes.join("\n  ")}{if close != "" -> "\n  CLOSE: {close}" else -> ""}\n  LOG: {log}")
    if !go -> return Ok()
    if patch.len() > 0 {
        file: "{patches}/obe-patch-{num}.json"
        files.write(file, json.dumps(patch) ?? "") ?? return Err("{err}")
        print("  {tower(repo, writer, ["card", "update", num, "--file", file]) ?? return Err(err)}")
    }
    if log.trim() != "" -> print("  {tower(repo, writer, ["card", "log", num, "--text", log.trim()]) ?? return Err(err)}")
    if close == "" -> return Ok()
    kind: if text(s, "closeKind") != "" -> ["--kind", text(s, "closeKind")] else -> [String]{}
    loop k in list(card(repo, num) ?? return Err(err), "criteria") {
        if text(k, "status") == "open" -> print("  {tower(repo, writer, ["card", "criteria", num, "--meet", label(k.get("n")), "--evidence", close].concat(kind)) ?? return Err(err)}")
    }
    print("  {tower(repo, writer, ["card", "update", num, "--phase", "done"]) ?? return Err(err)}")
    Ok()
}

run: fn() {
    args: process.args()
    if args.len() == 0 {
        term.eprint("usage: jet Tools/agent/orchestrator/TowerSpecApply.jet SPEC.json [--go]")
        process.exit(1)
    }
    spec: json.parse(files.read(args[0]))
    tool: "/Tools/agent/orchestrator/TowerSpecApply.jet"
    checkout: if sys.executable().ends_with(tool) -> sys.executable().removesuffix(tool) else -> "."
    repo: files.absolute(roots.env_or("TOWER_SPEC_REPO", checkout))
    writer: files.absolute(roots.env_or("TOWER_SPEC_WRITER", "{roots.state()}/scratch/Main/tower-dev.mjs"))
    patches: files.absolute(roots.env_or("TOWER_SPEC_PATCHES", roots.main()))
    failed := 0
    loop s in (if spec == .Array(l) -> l.copy() else -> [Dyn]{}) {
        if apply(s, repo, writer, patches, go: args.contains("--go")) == .Err(e) {
            failed += 1
            print("!!!! #{label(s.get("num"))}: {e.message.partition("\n").head}")
        }
    }
    print(if failed > 0 -> "\nFAILED {failed}" else -> "\nALL OK")
}
