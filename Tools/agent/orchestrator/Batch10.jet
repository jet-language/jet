// Batch10.jet BATCH SUB...: one integration cycle that does not let one bad
// submission hold back the rest.
//   1. SUBs whose meta says `seed:` something other than none wait for that
//      seed and are listed as HELD.
//   2. integrate10.sh BATCH with the rest.
//   3. If the census failed, a SUB is QUARANTINED when a census row names
//      one of its touched files (Core/X/Y.jet, <corelib>/Core/X/Y.jet, or
//      module path Core/X/Y), or an error's quoted source line (`NNN | text`
//      under an `Error [` header in census/*.err) is a line its patch adds,
//      with every later SUB of the same lead. integrate10.sh BATCH-r then
//      runs once more with the others.
//
// The Jet twin of batch10.sh (gauntlet tool entry batch10): the batches live
// in $JET_SCRATCH_ROOT/lanes/Main/integ, the roots as Roots.jet finds them,
// and integrate10.sh is the one in $JET_ORCHESTRATOR_DIR, this program's
// directory unless set.
use {
    files: core.files
    process: core.process
    regex: core.regex
    roots: "Roots"
    sys: core.sys
}

// Ends the run with `code` after `message`.
fail: fn(message: String, code: Int) -> Never {
    print(message)
    process.exit(code)
}

// The text of the files in `dir` that `matching` names, in name order.
read_all: fn(dir: String, matching: String) -> String {
    names := files.list_dir_or(dir, [], matching: matching).map(entry -> entry.name)
    names.sort()
    names.map(name -> files.read("{dir}/{name}")).join("")
}

// The lines a patch adds, trimmed.
added: fn(patch: String) -> [String] {
    loop line in patch.lines().filter(line -> line.starts_with("+") && !line.starts_with("++")) -> line.removeprefix("+").trim()
}

// A SUB's lead: its name up to the last `-`.
lead: fn(name: String) -> String {
    parts: name.rpartition("-")
    if parts.sep == "" -> name else -> parts.head
}

// Whether a line `patch` adds holds a word `word` matches.
adds_word: fn(patch: String, word: Regex) -> Bool {
    added(patch).any(line -> word.is_match(line))
}

// The SUBs of `run` that `hits` names, each with every later SUB of its
// lead, and the others; a SUB whose patch did not apply is in neither.
quarantine: fn(integ: String, run: [String], hits: [Bool]) -> (blamed: [String], keep: [String]) {
    blamed := [String]{}
    keep := [String]{}
    loop at in 0..<run.len() {
        name: files.basename(run[at])
        if files.read_or("{integ}/{name}.status", "").trim() == "NOAPPLY" -> next
        his: lead(name)
        if hits[at] || blamed.any(other -> lead(other) == his) -> blamed.push(name) else -> keep.push(run[at])
    }
    (blamed: blamed, keep: keep)
}

// The files the census rows name: column 2 without `<corelib>/`, its final `:line.col` and `.jet`.
census_rows: fn(integ: String) -> [String] {
    text: "{read_all("{integ}/census", "*keep-going.tsv")}{files.read_or("{integ}/census.out", "")}"
    place: regex.compile(":[0-9.]*$")
    loop cells in text.tsv_records().filter(cells -> cells.len() > 1) -> place.replace(cells[1].replace("<corelib>/", ""), "").removesuffix(".jet")
}

// The source lines quoted under Error headers (not warnings or notes) in census/*.err, trimmed, longer than 8.
error_lines: fn(integ: String) -> [String] {
    quoted: regex.compile("^ *[0-9]+ \\| (.*)$")
    out := [String]{}
    in_error := false
    loop line in read_all("{integ}/census", "*.err").lines() {
        if {
            line.starts_with("Error [") -> in_error = true
            line.starts_with("Warning [") || line.starts_with("Note [") -> in_error = false
            in_error && quoted.match(line) == .Val(m) && m.groups[0].trim().len() > 8 -> out.push(m.groups[0].trim())
        }
    }
    out
}

run: fn() {
    main: "{roots.roots()["JET_SCRATCH_ROOT"]}/lanes/Main"
    integrate: "{process.env_nonempty("JET_ORCHESTRATOR_DIR") ?? files.dirname(sys.executable())}/integrate10.sh"
    // One batch at a time: two runs of the same BATCH would write into one integ dir.
    _held: files.try_lock("{main}/integ/.batch.lock") ?? fail("batch: another batch holds the lock", 75)
    args: process.args()
    if args.len() == 0 -> process.fail(1, "usage: jet Tools/agent/orchestrator/Batch10.jet BATCH SUB...")
    batch: args[0]
    run := [String]{}
    loop given in args.slice(1, args.len()) {
        sub: given.removesuffix("/")
        seeds: files.read_or("{sub}/meta", "").lines().filter(line -> line.starts_with("seed:"))
        seed: if seeds.len() > 0 -> seeds[0].removeprefix("seed:").trim() else -> ""
        if seed != "" && seed != "none" -> print("HELD {files.basename(sub)} (seed: {seed})") else -> run.push(sub)
    }
    // rc 2: the export or the apply step stopped (integrate10 printed why); there is no census to attribute.
    if (Sh{"{integrate} {batch}"}.extend(run).status()) == 2 -> fail("batch: integrate stopped before the census (rc 2)", 2)
    integ: "{main}/integ/{batch}"
    if files.is_file("{integ}/REGENFAIL") {
        // Blame the SUBs whose added lines carry a name the failing generator quotes (`core.math.__from_bits_f32` gives
        // __from_bits_f32), with every later SUB of the same lead.
        names: (loop m in regex.compile("`([^`]+)`").matches(read_all(integ, "regen.*.out")) -> m.groups[0].rpartition(".").tail).filter(name -> name.len() > 3)
        word: regex.compile("\\b({(loop name in names -> regex.escape(name)).join("|")})\\b")
        split: quarantine(integ, run, loop sub in run -> names.len() > 0 && adds_word(files.read_or("{sub}/patch", ""), word))
        if split.blamed.len() == 0 -> fail("batch: a generator failed but no submission adds a name it quotes; see {integ}/REPORT.md", 1)
        print("QUARANTINED (regen) {split.blamed.join(" ")}")
        process.exit(Sh{"{integrate} {"{batch}-r"}"}.extend(split.keep).status())
    }
    if files.read_or("{integ}/REPORT.md", "").has_line_prefix("Census rc=0 ") -> process.exit(0)
    rows: census_rows(integ)
    errors: error_lines(integ)
    hits := [Bool]{}
    loop sub in run {
        name: files.basename(sub)
        paths: files.read_or("{integ}/{name}.files", "").lines().filter(path -> path != "")
        rebased: files.read_or("{integ}/{name}.rebased", "")
        hits.push(paths.concat(loop path in paths -> path.removesuffix(".jet")).any(line -> rows.contains(line)) || added(if rebased != "" -> rebased else -> files.read_or("{sub}/patch", "")).any(line -> errors.contains(line)))
    }
    split: quarantine(integ, run, hits)
    if split.blamed.len() == 0 -> fail("batch: the census failed but no row or error line names a submission; see {integ}/REPORT.md", 1)
    print("QUARANTINED {split.blamed.join(" ")}")
    if split.keep.len() == 0 -> process.exit(1)
    code: Sh{"{integrate} {"{batch}-r"}"}.extend(split.keep).status()
    if code != 0 -> process.exit(code)
}
