// CensusSnap2.jet <file>...: collect-all census of a SNAPSHOT: HEAD of the
// dev worktree plus the named worktree files (the orchestrator's own
// uncommitted edits), so other lanes' uncommitted work in the shared tree
// never enters it. Output: $JET_SCRATCH_ROOT/discovery/r14p/census.
// Passes, all in package form in the snapshot:
//   1. `jet check Compiler/JetCli` on the seed, with keep-going.
//   2. `jet build Compiler` with keep-going, so optimize, lowering, object
//      and link rows are caught before a commit lands.
//   3. tests/guards on the seed, failing only on a problem guards-known.txt
//      does not list (CENSUS_GUARDS=0 skips).
//   4. The runtime pack beside the compiler just built.
//   5. The self-check of Compiler/JetCli and of Core with that compiler
//      (CENSUS_SELFCHECK=0 skips).
//   6. The hosted Jetpack build, when a named file is under Jetpack/
//      (CENSUS_JETPACK=0 skips).
// CENSUS_TREE names a prepared tree used as is, with CENSUS_OUT for its
// reports; CENSUS_BUILD=0 stops after the check; CENSUS_JET_DIR names another
// compiler install (default: the seed). Exit: 0 clean; 1 rows or failure; 2
// setup failure.
//
// The Jet twin of census-snap2.sh (gauntlet tool entry census-snap2): the dev
// worktree is $JET_DEV_WORKTREE, the seed $JET_SEED, the lock is in
// $JET_RUN_ROOT, and jetenv.sh, census-errors.mjs, guards-gate.mjs,
// guards-known.txt, runtime-pack-check.sh and jpwrap.sh are Main's, in
// $JET_STATE_ROOT/scratch/Main, the roots as Roots.jet finds them.
use {
    files: core.files
    process: core.process
    roots: "Roots"
    sys: core.sys
    term: core.term
    time: core.time
}

// Ends the run with `code` after `message` on stderr.
quit: fn(message: String, code: Int) -> Never {
    term.eprint(message)
    process.exit(code)
}

// A finished pass's exit status: 124 when its time ran out.
rc: fn(receipt: ProcessReceipt) -> Int { if receipt.timed_out -> 124 else -> receipt.code }

// `bash jetenv.sh TREE JET ARGS` on CPUs 16-27 with `vars` set and, for a
// check or build, a 1 GiB stack.
jetenv: fn(g: String, jet: String, args: [String], vars: [String: String], stack: Bool{true}) -> ProcessSpec {
    argv: if stack -> ["prlimit", "--stack=1073741824:1073741824", "--"] else -> [String]{}
    spec := process.cmd(argv.concat(["bash", "{g}/jetenv.sh", ".", jet]).concat(args)).cpu_affinity(loop cpu in 16..<28 -> cpu)
    loop (name, value) in vars -> spec = spec.env(name, value)
    spec
}

// Runs `spec` with its stdout in `out` and its stderr in `errors` ("": in
// `out` too); its exit status, 1 when `out` can't be written.
pass: fn(spec: ProcessSpec, out: String, errors: String{""}) -> Int {
    files.write(out, "") ?? return 1
    receipt: (if errors == "" -> spec.stderr(.Stdout) else -> spec).run()
    files.write(out, receipt.output)
    if errors != "" -> files.write(errors, receipt.errors)
    rc(receipt)
}

// The rows of a keep-going report, its header aside.
rows: fn(tsv: String) -> Int {
    count: (files.read(tsv) ?? "").lines().len()
    if count > 0 -> count - 1 else -> 0
}

// Prints the first `limit` lines census-errors.mjs gives for a keep-going report.
census_errors: fn(g: String, tsv: String, limit: Int) {
    loop line in process.cmd(["node", "{g}/census-errors.mjs", tsv, "."]).stderr(.Stdout).run().output.lines().slice(0, limit) -> print(line)
}

// A build row's kind, code and message.
row_key: fn(line: String) -> String {
    fields: line.split("\t").to_list().concat(["", "", ""])
    "{fields[0]}\t{fields[2]}\t{fields[3]}"
}

// Prints the build report's ten commonest rows by kind, code and message,
// each with its count, most frequent first (ties in reverse byte order).
build_rows: fn(tsv: String) {
    lines: (files.read(tsv) ?? "").lines()
    keys := loop line in lines.slice(1, lines.len()) -> row_key(line)
    keys.sort()
    counted := [(count: Int, key: String)]{}
    loop key in keys {
        if counted.len() > 0 && counted[counted.len() - 1].key == key -> counted[counted.len() - 1].count += 1 else -> counted.push((count: 1, key: key))
    }
    // Ranked by a fixed-width count first, so byte order is count order.
    ranked := loop row in counted -> "{1000000000 + row.count} {row.count} {row.key}"
    ranked.sort()
    loop back in 0..<(if ranked.len() < 10 -> ranked.len() else -> 10) -> print(ranked[ranked.len() - 1 - back].partition(" ").tail)
}

// The runtime pass: the pack the build wrote beside the compiler just built,
// else the packager's.
runtime: fn(g: String, self_jet: String, out: String, id: String) {
    beside: "{files.dirname(files.canonicalize(self_jet) ?? self_jet)}/jet-runtime"
    built: "Compiler/JetCli/.jet/build/jet-runtime"
    if files.is_file("Compiler/Toolchain/RuntimePack.jet") {
        if !files.exists(beside) && files.is_dir(built) -> files.symlink(files.canonicalize(built), beside)
        if !files.is_file("{beside}/native.key") {
            print("runtime rc=1 (no jet-runtime/native.key beside {self_jet})")
            process.exit(1)
        }
        return print("runtime rc=0 (jet build Compiler)")
    }
    packed: process.cmd(["bash", "{g}/runtime-pack-check.sh", self_jet, ".", "{out}/runtime", id]).stderr(.Stdout).run()
    loop line in packed.output.lines() -> print(line)
    if rc(packed) != 0 -> process.exit(1)
    if files.is_symlink(beside) -> files.remove(beside)
    files.symlink(files.canonicalize("{out}/runtime/out"), beside)
}

// The hosted Jetpack pass with the compiler just built.
jetpack: fn(g: String, self_jet: String, out: String, id: String) {
    home: "{out}/tmp.jetpack.{sys.pid()}"
    files.create_dir_all(home)
    log: "{out}/jetpack.log"
    _ := pass(process.cmd(["bash", "{g}/jpwrap.sh", "check", "--hosted"])
        .env("HOME", home).env("JET_HOME", "{home}/.jet").env("JET", self_jet).env("JET_COMPILER_IDENTITY", id)
        .env("JET_TOOLCHAIN_ROOT", ".").env("JETPACK_WORKER", "precommit").env("JET_STATE_ROOT", "{out}/jetpack-state")
        .timeout(time.duration_seconds(1200)), log)
    files.remove_all(home)
    text: files.read(log) ?? ""
    if text.contains("JETPACK HOSTED OK") -> return print("jetpack rc=0")
    print("jetpack rc=1 (see {log})")
    loop line in text.lines().filter(line -> line.starts_with("Error") || line.starts_with("  -->")).slice(0, 20) -> print(line)
    process.exit(1)
}

// The snapshot: HEAD of the worktree, then each named worktree file over it;
// a named file the worktree no longer has is a deletion.
snapshot: fn(worktree: String, tree: String, named: [String]) {
    files.remove_all(tree) ?? ()
    files.create_dir_all(tree)
    exported: if process.pipeline([process.cmd(["git", "archive", "HEAD"]).cwd(worktree), process.cmd(["tar", "-x", "-C", tree])]) == {
        .Ok(receipt) -> receipt.success
        .Err(_) -> false
    }
    if !exported {
        print("EXPORT FAILED")
        process.exit(2)
    }
    loop path in named {
        if {
            files.exists("{worktree}/{path}") -> {
                files.create_dir_all("{tree}/{files.dirname(path)}")
                files.copy("{worktree}/{path}", "{tree}/{path}")
            }
            else -> files.remove("{tree}/{path}") ?? ()
        }
    }
}

run: fn() {
    named: process.args()
    g: "{roots.state()}/scratch/Main"
    run_root: roots.run_dir()
    files.create_dir_all(run_root)
    // Its own lock AND its own directories: precommit censuses never queue behind lanes' long checks, and
    // never share r14 with Tools/agent/land/census-snap.sh (vbatch's launch census).
    _held: files.lock("{run_root}/precommit-census.lock")
    prepared: roots.env_or("CENSUS_TREE", "")
    tree: if prepared == "" -> "{roots.scratch()}/discovery/r14p/snap" else -> prepared
    compiler: files.canonicalize(roots.env_or("CENSUS_JET_DIR", roots.seed()))
    id: roots.env_or("CENSUS_JET_IDENTITY", (files.read("{compiler}/IDENTITY") ?? "").trim())
    at: roots.env_or("CENSUS_OUT", "{roots.scratch()}/discovery/r14p/census")
    files.remove_all(at) ?? ()
    files.create_dir_all(at)
    if prepared == "" -> snapshot(roots.worktree(), tree, named)
    // From here on, a relative root or report names a path from the tree, as in the original.
    files.chdir(tree) ?? quit("census: cd {tree}: {err}", 2)
    seed: "{compiler}/jet"
    check_rc: pass(jetenv(g, seed, ["check", "--threads", "12", "Compiler/JetCli"], ["JET_COMPILER_IDENTITY": id, "JET_TOOLCHAIN_ROOT": roots.env_or("CENSUS_TOOLCHAIN_ROOT", "."), "JET_KEEP_GOING": "1", "JET_KEEP_GOING_REPORT": "{at}/check-keep-going.tsv"]), "{at}/check.out", "{at}/check.err")
    print("check rc={check_rc}")
    // The keep-going report is the census: a dependency package's errors reach the stderr only as E0626.
    census_errors(g, "{at}/check-keep-going.tsv", 21)
    if check_rc != 0 -> process.exit(1)
    if roots.env_or("CENSUS_BUILD", "1") == "0" -> process.exit(0)
    files.remove_all("Compiler/JetCli/.jet/build") ?? ()
    build_rc: pass(jetenv(g, seed, ["build", "--threads", "12", "Compiler"], ["JET_COMPILER_IDENTITY": id, "JET_TOOLCHAIN_ROOT": roots.env_or("CENSUS_BUILD_ROOT", "."), "JET_KEEP_GOING": "1", "JET_KEEP_GOING_REPORT": "{at}/build-keep-going.tsv"]).timeout(time.duration_seconds(1800)), "{at}/build.out", "{at}/build.err")
    build_rows_count: rows("{at}/build-keep-going.tsv")
    print("build rc={build_rc} rows={build_rows_count}")
    build_rows("{at}/build-keep-going.tsv")
    if build_rc != 0 || build_rows_count != 0 {
        // The head of the build's stderr, about 600 bytes of it.
        shown := 0
        loop line in (files.read("{at}/build.err") ?? "").lines() {
            if shown >= 600 -> break
            print(line)
            shown += line.len() + 1
        }
        process.exit(1)
    }
    // Guards pass: tests/guards on the seed, failing only on a guard row or closed-list problem not in
    // guards-known.txt. CENSUS_GUARDS_TIMEOUT is in seconds, 0 for no limit.
    if roots.env_or("CENSUS_GUARDS", "1") == "1" {
        limit: roots.env_or("CENSUS_GUARDS_TIMEOUT", "2400").to_int() ?? 2400
        guards: jetenv(g, seed, ["test", "tests/guards"], ["JET_COMPILER_IDENTITY": id, "JET_TOOLCHAIN_ROOT": "."], stack: false)
        _ := pass(if limit > 0 -> guards.timeout(time.duration_seconds(limit)) else -> guards, "{at}/guards.out")
        gate: process.cmd(["node", "{g}/guards-gate.mjs", "{at}/guards.out", "{g}/guards-known.txt"]).stderr(.Stdout).run()
        loop line in gate.output.lines() -> print(line)
        print("guards rc={rc(gate)}")
        if rc(gate) != 0 -> process.exit(1)
    }
    // The compiler `jet build Compiler` just built (JetCli's executable target `jet`).
    self_jet: "{files.canonicalize(".")}/Compiler/JetCli/.jet/build/jet"
    runtime(g, self_jet, at, id)
    // Self-check pass: the compiler just built checks the compiler packages, then every Core body, with
    // keep-going, as chain s2 does.
    if roots.env_or("CENSUS_SELFCHECK", "1") == "1" {
        loop package in ["Compiler/JetCli", "Core"] {
            name: if package == "Core" -> "selfcheck-core" else -> "selfcheck"
            tsv: "{at}/{name}-keep-going.tsv"
            code: pass(jetenv(g, self_jet, ["check", "--threads", "12", package], ["JET_COMPILER_IDENTITY": id, "JET_TOOLCHAIN_ROOT": ".", "JET_KEEP_GOING": "1", "JET_KEEP_GOING_REPORT": tsv]).timeout(time.duration_seconds(1200)), "{at}/{name}.out", "{at}/{name}.err")
            count: rows(tsv)
            print("{name} rc={code} rows={count}")
            census_errors(g, tsv, 11)
            if code != 0 || count != 0 -> process.exit(1)
        }
    }
    // Hosted Jetpack pass, when a named file is under Jetpack/: the compiler census alone never compiles Jetpack.
    if named.any(path -> path.starts_with("Jetpack/")) && roots.env_or("CENSUS_JETPACK", "1") == "1" -> jetpack(g, self_jet, at, id)
}
