// IntegApply6.jet TREE I SUB...: applies each SUB's patch to the export TREE
// in order, recording integ files in I. Generated files (a "This file is
// generated by Tools/..." header in the tree's copy) are excluded from every
// patch and regenerated once at the end by the generators they name, so two
// SUBs that both touch a generated table never conflict. Every other hunk
// applies with a three-way merge against the base blobs in the main
// repository, so a SUB built on an older dev still applies when its context
// moved but its lines did not. A SUB that still conflicts is NOAPPLY and
// leaves the tree as it was. Each applied SUB's effective diff (generated
// files excluded) is saved as I/SUB.rebased for integ-land; the regeneration
// diff is I/regen.patch. Prints APPLIED/NOAPPLY lines and, last, the applied
// SUB paths one per line after a line "--applied--".
//
// The Jet twin of integ-apply6.sh (gauntlet tool entry integ-apply6): the
// base blobs are the objects of the repository $JET_DEV_WORKTREE belongs to,
// the generators run with the seed $JET_SEED, and linemerge.mjs is Main's, in
// $JET_STATE_ROOT/scratch/Main, the roots as Roots.jet finds them. Paths a
// git step reads are given to git as named, so a relative one is from TREE.
use {
    files: core.files
    process: core.process
    roots: "Roots"
    time: core.time
}

// A header line that names its file's generator, and the name in it after
// "generated by ".
GENERATED_HEADER: Regex{"[Gg]enerated by Tools/[^ ;]+.*do not edit"}
GENERATOR_NAME: Regex{"[Gg]enerated by Tools/[^ ;]+"}
// A conflict marker line a three-way merge leaves.
CONFLICT_MARKER: Regex{"^(<<<<<<<|=======|>>>>>>>)( |$)"}

// Ends the run with `code` after `line`.
stop: fn(line: String, code: Int) -> Never {
    print(line)
    process.exit(code)
}

// The base commit: the export with every tracked file (-f: some match
// .gitignore, as Tools/script-census.tsv does), the main repository's objects
// at hand for the three-way merges; whether every step succeeded. The integ
// repository commits as integ and never starts an automatic gc: a detached
// auto gc started by one SUB's commit raced the next commit and broke HEAD
// (every later .rebased and regen.patch came out empty while APPLIED still
// printed).
based: fn(tree: String, worktree: String) -> Bool {
    if !(Sh{"git -C {tree} init -q"}.ok()) -> return false
    files.append_all("{tree}/.git/config", "[user]\n\tname = integ\n\temail = integ@local\n[gc]\n\tauto = 0\n[maintenance]\n\tauto = false\n")
    common: Sh{"git -C {worktree} rev-parse --path-format=absolute --git-common-dir"}.run()
    if common.code != 0 -> return false
    files.write("{tree}/.git/objects/info/alternates", "{common.output.trim()}/objects\n")
    Sh{"git -C {tree} add -A -f"}.ok() && Sh{"git -C {tree} commit -qm base --no-verify"}.ok() && Sh{"git -C {tree} tag base"}.ok()
}

// The generator a file's header names in its first 40 lines, one trailing `.`
// dropped; "" when none does.
generator_of: fn(path: String) -> String {
    loop line in files.read_or(path, "").first_lines(40) {
        if !GENERATED_HEADER.is_match(line) -> next
        found: GENERATOR_NAME.find(line) ?? ""
        return found.slice(13, found.len()).removesuffix(".")
    }
    ""
}

// A SUB's lead: its name up to the last `-`.
lead: fn(name: String) -> String {
    parts: name.rpartition("-")
    if parts.sep == "" -> name else -> parts.head
}

// A file whose every conflict lies inside a generated region keeps ours there
// ("ours"); any other conflict is "none".
marker_mode: fn(path: String) -> String {
    generated := false
    bad := false
    seen := false
    loop line in files.read_or(path, "").lines() {
        if line.contains("unsafe-ratchet:begin") || line.contains("BEGIN GENERATED") -> generated = true
        if CONFLICT_MARKER.is_match(line) {
            bad = bad || !generated
            seen = true
        }
        if line.contains("unsafe-ratchet:end") || line.contains("END GENERATED") -> generated = false
    }
    if seen && !bad -> "ours" else -> "none"
}

// A scratch directory holding the base, ours and theirs of an unmerged `path` as `b`, `o` and `t`.
stages: fn(tree: String, path: String) -> String {
    work: files.mkdtemp("integ-apply")
    files.write("{work}/b", Sh{"git -C {tree} show {":1:{path}"}"}.run().output)
    files.write("{work}/o", Sh{"git -C {tree} show {":2:{path}"}"}.run().output)
    files.write("{work}/t", Sh{"git -C {tree} show {":3:{path}"}"}.run().output)
    work
}

// The mode a conflict the markers leave unresolved merges by: "union" when
// every conflict hunk is a pure addition on both sides (an empty base part);
// else "lines" when linemerge.mjs merges neighbouring-line edits (and name
// additions to one `{ a, b }` set line) line by line, its result in
// I/linemerge.tmp; else "none".
staged_mode: fn(tree: String, integ: String, g: String, path: String) -> String {
    work: stages(tree, path)
    open := false
    hunks := 0
    in_base := false
    bad := false
    loop line in (Sh{"git merge-file --diff3 -p {"{work}/o"} {"{work}/b"} {"{work}/t"}"}.run().output.lines()) {
        if {
            line.starts_with("<<<<<<< ") -> {
                open = true
                hunks += 1
            }
            line.starts_with("||||||| ") -> in_base = open
            line == "=======" -> in_base = false
            line.starts_with(">>>>>>> ") -> {
                open = false
                in_base = false
            }
            in_base -> bad = true
        }
    }
    mode := if hunks > 0 && !bad -> "union" else -> "none"
    if mode == "none" {
        merged: Sh{"node {"{g}/linemerge.mjs"} {"{work}/o"} {"{work}/b"} {"{work}/t"}"}.run()
        files.write("{integ}/linemerge.tmp", merged.output)
        if merged.code == 0 -> mode = "lines"
    }
    files.remove_all(work)
    mode
}

// Records SUB `name` as not applied, `note` after its name.
failed: fn(integ: String, name: String, note: String{""}) {
    print("NOAPPLY {name}{note}")
    files.write("{integ}/{name}.status", "NOAPPLY\n")
    files.append_all("{integ}/failed", "{name}\n")
}

// Applies SUB `sub`; whether it applied.
apply_sub: fn(tree: String, integ: String, g: String, sub: String, order: &[String], failures: &[String]) -> Bool {
    s: sub.removesuffix("/")
    n: files.basename(s)
    listed: (loop cells in (Sh{"git apply --numstat {"{s}/patch"}"}.run().output.tsv_records()) -> cells.get(2) ?? "")
    files.write("{integ}/{n}.files", (loop path in listed -> "{path}\n").join(""))
    excluded := [String]{}
    loop f in listed.filter(f -> f != "") {
        path: "{tree}/{f}"
        // An edit of a file an earlier SUB in this batch deleted is dropped (the deleting SUB replaced the file's
        // role, e.g. ScriptLead-1 computes the script census that Tools/script-census.tsv held by hand).
        if !files.exists(path) && (Sh{"git -C {tree} cat-file -e {"base:{f}"}"}.run().success) {
            by: Sh{"git -C {tree} log --format=%s --diff-filter=D -1 -- {f}"}.text()
            if by != "" {
                excluded.push("--exclude={f}")
                files.append_all("{integ}/{n}.dropped", "dropped edit of {f}: deleted by {by}\n")
            }
            next
        }
        // Agent policy and skill prose may quote the generated-file header; it is never generated.
        if !files.is_file(path) || f == "AGENTS.md" || f.starts_with(".agents/") -> next
        // The safety ledger is written whole by UnsafeRatchet --update (its regions move with every source line).
        generator: if f == "Docs/spec/safety.md" -> "Tools/agent/UnsafeRatchet.jet" else -> generator_of(path)
        if generator == "" -> next
        excluded.push("--exclude={f}")
        files.append_all("{integ}/generators", "{generator}\t{f}\n")
    }
    his: lead(n)
    // The SUBs its meta's stack lines name (`stack: a, b`; a bare number is a SUB of the same lead); with no
    // meta file, a SUB stacks on the previous SUB of the same lead in this batch.
    meta: files.read_or("{s}/meta", "")
    stacked := [String]{}
    loop line in meta.lines().filter(line -> line.starts_with("stack:")) {
        loop d in line.removeprefix("stack:").replace(",", " ").words().filter(d -> d != "none") -> stacked.push(if d.contains("-") -> d else -> "{his}-{d}")
    }
    if !files.is_file("{s}/meta") {
        same: order.filter(other -> lead(files.basename(other)) == his)
        if same.len() > 0 -> stacked.push(files.basename(same[same.len() - 1]))
    }
    files.append_all("{integ}/order", "{s}\n")
    order.push(s.copy())
    apply_log: "{integ}/{n}.apply"
    dependency: stacked.filter(d -> failures.contains(d))
    if dependency.len() > 0 {
        files.write(apply_log, "stack dependency {dependency[dependency.len() - 1]} did not apply\n")
        failed(integ, n)
        failures.push(n)
        return false
    }
    applied: Sh{"git -C {tree} apply --3way -p1"}.extend(excluded.concat(["{s}/patch"])).spec().stderr(.Stdout).run()
    files.write(apply_log, applied.output)
    // Conflicts left by the three-way merge are resolved only where the answer is mechanical:
    //  - every conflict lies inside a generated region (`unsafe-ratchet:begin..end`, `BEGIN GENERATED..END
    //    GENERATED`): keep ours there and rerun that region's generator;
    //  - a .tsv row table: keep both sides' rows (union);
    //  - every conflict hunk is a pure addition on both sides (an empty base part): keep both, ours first
    //    (union); the census then checks the composed file.
    // Any other conflict makes the SUB NOAPPLY.
    conflicts: Sh{"git -C {tree} diff --name-only --diff-filter=U"}.lines()
    clean := applied.code == 0 || conflicts.len() > 0
    loop f in conflicts {
        mode := if f.ends_with(".tsv") -> "union" else -> marker_mode("{tree}/{f}")
        if mode == "none" -> mode = staged_mode(tree, integ, g, f)
        if mode == "none" {
            clean = false
            files.append_all(apply_log, "unresolvable conflict outside a generated region: {f}\n")
            break
        }
        if {
            mode == "lines" -> files.copy("{integ}/linemerge.tmp", "{tree}/{f}")
            else -> {
                work: stages(tree, f)
                files.write("{tree}/{f}", Sh{"git merge-file {"--{mode}"} -p {"{work}/o"} {"{work}/b"} {"{work}/t"}"}.run().output)
                files.remove_all(work)
            }
        }
        _ := Sh{"git -C {tree} add -- {f}"}.ok()
        files.append_all(apply_log, "resolved {f} ({mode})\n")
        if mode == "ours" -> files.append_all("{integ}/generators", "{if files.read("{tree}/{f}").contains("unsafe-ratchet:begin") -> "Tools/agent/UnsafeRatchet.jet" else -> "Tools/agent/CoreSourceRows.jet"}\t{f}\n")
    }
    clean = clean && Sh{"git -C {tree} diff --name-only --diff-filter=U"}.lines().len() == 0
    if clean && (Sh{"git -C {tree} add -A"}.ok()) && (Sh{"git -C {tree} diff --cached --quiet HEAD"}.ok()) {
        // The patch changes nothing on this tree: an earlier SUB of the batch already carries it (post42h2: Main-2).
        files.append_all(apply_log, "already in the tree: every change of this patch is carried by an earlier SUB\n")
        failed(integ, n, " (empty)")
        failures.push(n)
        return false
    }
    if !clean {
        _ := Sh{"git -C {tree} reset -q --hard HEAD"}.ok()
        _ := Sh{"git -C {tree} clean -qfd"}.ok()
        failed(integ, n)
        failures.push(n)
        return false
    }
    if !(Sh{"git -C {tree} commit -qm {n} --no-verify"}.ok()) -> stop("integ-apply: commit of {n} failed; the integ repo is broken, stopping", 2)
    rebased: Sh{"git -C {tree} diff --binary HEAD~1 HEAD"}.run()
    if rebased.code != 0 -> stop("integ-apply: diff of {n} failed; stopping", 2)
    files.write("{integ}/{n}.rebased", rebased.output)
    if rebased.output == "" -> stop("integ-apply: {n}.rebased is empty; stopping", 2)
    print("APPLIED {n}")
    true
}

// Regenerates every generated file an applied SUB touched, with the seed,
// from the composed sources.
regenerate: fn(tree: String, integ: String) {
    seed: files.canonicalize(roots.seed())
    // The runtime generator outputs (RuntimeStopExports and the rest) go stale whenever a SUB changes a runtime
    // export, and no SUB names them: regenerate them in every batch.
    files.append_all("{integ}/generators", "Tools/agent/RuntimeGenerators.jet\tall\n")
    names := loop line in files.read("{integ}/generators").lines() -> line.partition("\t").head
    names.sort()
    identity: files.read("{seed}/IDENTITY").trim()
    loop gen in names.dedup().to_list() {
        if {
            !gen.starts_with("Tools/") || !gen.ends_with(".jet") -> print("REGEN-SKIP {gen} (not a Jet generator)")
            !files.is_file("{tree}/{gen}") -> print("REGEN-SKIP {gen} (missing)")
            else -> {
                flag: if {
                    gen.ends_with("/DiagnosticRows.jet") -> ["--write"]
                    gen.ends_with("/UnsafeRatchet.jet") -> ["--update"]
                    else -> [String]{}
                }
                run: Sh{"nice -n 19 {"{seed}/jet"} {gen}"}.extend(flag).spec().cwd(tree).env("JET_COMPILER_IDENTITY", identity).env("JET_TOOLCHAIN_ROOT", tree)
                    .timeout(time.duration_seconds(900)).cpu_affinity(loop cpu in 16..<32 -> cpu).stderr(.Stdout).run()
                files.write("{integ}/regen.{files.basename(gen)}.out", run.output)
                print((["REGEN", gen].concat(flag).concat(["rc={if run.timed_out -> 124 else -> run.code}"])).join(" "))
            }
        }
    }
}

run: fn() {
    args: process.args()
    if args.len() < 2 -> process.fail(1, "usage: jet Tools/agent/orchestrator/IntegApply6.jet TREE I SUB...")
    tree: args[0]
    integ: args[1]
    g: "{roots.state()}/scratch/Main"
    if !based(tree, roots.worktree()) -> stop("integ-apply: init failed", 2)
    files.write("{integ}/generators", "")
    order := [String]{}
    failures := [String]{}
    applied := [String]{}
    loop sub in args.slice(2, args.len()) {
        if apply_sub(tree, integ, g, sub, order, failures) -> applied.push(sub.removesuffix("/"))
    }
    // INTEG_POST="patch ...": Main's fixups that must apply plainly (no three-way, no keep-ours) to the composed
    // tree after every SUB, such as deleting ledger proof rows a merge kept. They land inside regen.patch.
    loop patch in roots.env_or("INTEG_POST", "").words() -> print("{if (Sh{"git -C {tree} apply -p1 {patch}"}.ok()) -> "POST" else -> "POST-FAIL"} {patch}")
    regenerate(tree, integ)
    if (Sh{"git -C {tree} add -A"}.ok()) -> files.write("{integ}/regen.patch", Sh{"git -C {tree} diff --cached --binary HEAD"}.run().output)
    files.remove_all("{tree}/.git")
    print("--applied--")
    loop path in applied -> print(path)
}
