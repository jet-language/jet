// IntegLand4.jet BATCH SUB...: lands the named submissions of a passed
// integration batch on dev, one commit each, in the order given (the order
// integrate.sh applied them). Refuses unless integ/BATCH's census and
// ratchets passed, each SUB's status is OK, and origin/dev is still the
// batch's BASE (any other movement means the composed tree was not the one
// tested: rerun integrate.sh). Commits in the dev worktree stage exactly
// each patch's files; the author's lane name goes in a Lane: trailer. Pushes
// once, then appends the shas to batch-queue.txt.
//
// The Jet twin of integ-land4.sh (gauntlet tool entry integ-land4): the
// batches live in $JET_SCRATCH_ROOT/lanes/Main/integ, the dev worktree is
// $JET_DEV_WORKTREE, and batch-queue.txt and landed-subs.txt are Main's, in
// $JET_STATE_ROOT/scratch/Main, the roots as Roots.jet finds them.
use {
    files: core.files
    process: core.process
    roots: "Roots"
}

// The directories the tree-only check never enters.
SKIPPED_DIRS: [".jet", ".git", "target", "node_modules", ".chain"]

// Ends the run with exit code 1 after `message`.
fail: fn(message: String) -> Never {
    print(message)
    process.exit(1)
}

// The files under `tree` (below `rel`) that git does not track, build output aside.
tree_only: fn(tree: String, rel: String, tracked: [String], out: &[String]) {
    loop entry in files.list_dir_or("{tree}/{rel}", []) {
        path: if rel == "" -> entry.name.copy() else -> "{rel}/{entry.name}"
        if {
            entry.is_dir && !files.is_symlink(entry.path) -> { if !SKIPPED_DIRS.contains(entry.name) -> tree_only(tree, path, tracked, out) }
            !tracked.contains(path) -> out.push(path)
        }
    }
}

// Stages `patch` and commits exactly the paths it staged with `message`; the new commit's short sha.
commit: fn(patch: String, landfiles: String, msgfile: String, message: String) -> String {
    if !(Sh{"git apply -p1 --index {patch}"}.ok()) -> return ""
    // Every path the patch staged, rename sources included (numstat names only the rename target: b6d left 12 behind).
    staged: Sh{"git diff --cached --name-only --no-renames"}.lines()
    files.write(landfiles, staged.map(path -> "{path}\n").join(""))
    files.write(msgfile, message)
    if !(Sh{"git commit -q -F {msgfile} --"}.extend(staged).ok()) -> return "-"
    Sh{"git rev-parse --short HEAD"}.text()
}

run: fn() {
    args: process.args()
    if args.len() == 0 -> process.fail(1, "usage: jet Tools/agent/orchestrator/IntegLand4.jet BATCH SUB...")
    batch: args[0]
    r: roots.roots()
    queue: "{r["JET_STATE_ROOT"]}/scratch/Main"
    integ: "{r["JET_SCRATCH_ROOT"]}/lanes/Main/integ/{batch}"
    if !files.read_or("{integ}/REPORT.md", "").has_line_prefix("Census rc=0 ") -> fail("integ-land: batch {batch} did not pass its census/ratchets")
    // Every git step and tree path below is the dev worktree's.
    files.chdir(r["JET_DEV_WORKTREE"]) ?? process.exit(2)
    if (Sh{"git status --porcelain=v1 -uno"}.text()) != "" -> fail("integ-land: dev worktree has changes")
    _ := Sh{"git fetch -q origin"}.ok()
    base: files.read("{integ}/BASE").trim()
    // origin/dev may have moved past BASE only by changes that are not build inputs and share no file with this
    // batch: the net diff BASE..origin/dev may touch no Compiler/, Core/, Jetpack/ or Tools/ file and none of the
    // batch files.
    lists: loop entry in files.list_dir(integ, matching: "*.files") -> entry.name
    listed := [String]{}
    loop name in lists -> listed.extend(files.read("{integ}/{name}").lines())
    bad: Sh{"git diff --name-only {base} origin/dev"}.lines().filter(path -> ["Compiler/", "Core/", "Jetpack/", "Tools/"].any(top -> path.starts_with(top)) || listed.contains(path))
    if bad.len() > 0 -> fail("integ-land: origin/dev moved from {base} in build inputs or batch files: {bad.join(" ")}; rerun integrate.sh")
    if !(Sh{"git merge -q --ff-only origin/dev"}.ok()) -> fail("integ-land: cannot fast-forward the worktree to origin/dev")
    landed := [String]{}
    loop given in args.slice(1, args.len()) {
        sub: given.removesuffix("/")
        name: files.basename(sub)
        if files.read_or("{integ}/{name}.status", "").trim() != "OK" {
            print("integ-land: {name} is not OK in {batch}; stopping before it")
            break
        }
        rebased: "{integ}/{name}.rebased"
        // An empty .rebased means the integ repo lost the commit (b6d: gc race); the raw patch is not what was tested.
        if (files.getsize(rebased) ?? -1) == 0 -> fail("integ-land: {rebased} is empty; rebuild it (rebuild-rebased.sh) before landing")
        lane: name.rpartition("-").head
        sha: commit(if files.exists(rebased) -> rebased else -> "{sub}/patch", "{integ}/{name}.landfiles", "{integ}/{name}.commitmsg", "{files.read("{sub}/msg")}\nLane: {if lane == "" -> name else -> lane}\nIntegrated: {batch} on {base}\n")
        if sha == "" -> fail("integ-land: {name} does not apply on {Sh{"git rev-parse --short HEAD"}.text()}")
        if sha == "-" -> fail("integ-land: commit of {name} failed")
        landed.push("{sha} {name}")
    }
    if landed.len() == 0 -> process.exit(1)
    // The generated tables integ-apply regenerated from the composed sources land last, only when EVERY SUB the
    // batch applied landed (b4b: landing a subset with the full regen put SchedLead-6 rows on dev without their source).
    applied: lists.filter(name -> name != "regen.files").len()
    // INTEG_LANDED_BEFORE=k: k SUBs of this batch already landed in an earlier, interrupted run.
    done: landed.len() + ((process.env_nonempty("INTEG_LANDED_BEFORE") ?? "0").to_int() ?? 0)
    if files.read_or("{integ}/regen.patch", "") != "" {
        if done != applied -> fail("integ-land: not every SUB landed, so regen.patch was not applied; rerun the generators")
        sha: commit("{integ}/regen.patch", "{integ}/regen.files", "{integ}/regen.commitmsg", "integration: regenerate the generated tables for {batch}\n\nIntegrated: {batch} on {base}\n")
        if sha == "" || sha == "-" -> fail("integ-land: regen commit failed")
        landed.push("{sha} regen")
    }
    // The landed tree must be the tested composed tree, byte for byte, before anything is pushed.
    leftovers: Sh{"git status --porcelain=v1 -uno"}.lines()
    if leftovers.len() > 0 -> fail("integ-land: staged leftovers after landing: {leftovers.slice(0, 5).join(" ")}")
    if done >= applied {
        tracked: Sh{"git -c core.quotepath=off ls-files"}.lines()
        drift := [String]{}
        loop path in tracked {
            tested: "{integ}/tree/{path}"
            if {
                files.is_symlink(path) -> next
                !files.exists(tested) -> { if files.exists(path) -> drift.push("NOTINTREE {path}") }
                (files.read_bytes(path) ?? []) != (files.read_bytes(tested) ?? []) -> drift.push("DIFF {path}")
            }
        }
        only := [String]{}
        tree_only("{integ}/tree", "", tracked, only)
        loop path in only -> drift.push("ONLYINTREE {path}")
        if drift.len() > 0 -> fail("integ-land: landed tree differs from {integ}/tree: {drift.slice(0, 8).join(" ")}")
    }
    pushed: Sh{"git fetch -q origin"}.ok() && Sh{"git merge-base --is-ancestor origin/dev HEAD"}.ok() && Sh{"git push -q origin HEAD:dev"}.ok()
    if !pushed -> fail("integ-land: push failed")
    loop entry in landed {
        parts: entry.partition(" ")
        files.append_all("{queue}/batch-queue.txt", "{parts.head}\n")
        if parts.tail != "regen" -> files.append_all("{queue}/landed-subs.txt", "{parts.tail}\n")
        print("LANDED {entry}")
    }
}
