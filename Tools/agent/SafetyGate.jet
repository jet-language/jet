#!/usr/bin/env jet
// Standing native safety gate (#4619): strict native safety admission. Missing
// coverage is never a pass. Native producers publish `native_safety` in the
// admitted artifacts JSON; Docs/spec/safety.md owns the contract.
//
// Usage:
//     jet Tools/agent/SafetyGate.jet OUT ARTIFACTS_JSON [SEED COUNT [--prepare]]
//     jet Tools/agent/SafetyGate.jet --source OUT JET [SEED COUNT]
// The first form is the full gate: PASS exits 0, findings FAIL 1, an
// infrastructure error 2, unavailable coverage GAP 3. `--prepare` only writes
// the generated corpus and its hash. `--source` is the VerifyFull leg without
// admitted native artifacts: the two unsafe-wrapper diagnostic fixtures under
// JET and the generated corpus, whose every case the model must define (0 or 1).
//
// The corpus is a type-directed fuzz generator plus stateful Core API
// programs. Each fuzz case is a generated Jet program and the stdout a model
// evaluator computes for it, written in the Examples layout under
// OUT/corpus/Examples/features/{fuzz,core}/s<seed>_<n>.jet with expected/.
// The generator draws from the syntax the feature goldens and the memory
// corpus use: Int and Bool bindings (`:`, `:=` only when the program mutates
// them), every Int operator at Jet's precedence with minimal parentheses,
// compound assignment, `if` statements, arm tables and `if` values, counted,
// conditional and list loops with `break` and `next`, lists (literal, push,
// indexed read and write, len, printing), one struct (literal, field write,
// printing), Strings (literals, interpolation, `+=`, `.copy()` copies, moves out
// of a binding, which then stays unused, `len`, equality), helper functions
// taking Int, String, list and struct parameters, early returns, a bounded
// recursive helper, and prints inside helpers (so call and short-circuit order
// are observable). Every choice is typed by the bindings in scope. The model
// evaluates with i64 semantics (`/%` and `%` floor, `%%` truncates, `>>` is
// arithmetic); a program whose evaluation overflows, divides by zero, indexes
// out of range or runs too long is discarded and redrawn, so every expected
// output is defined behavior. A failing case reproduces from its seed; the
// .jet is the repro.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    time: core.time
}

TOOL: "/Tools/agent/SafetyGate.jet"
USAGE: "usage: jet Tools/agent/SafetyGate.jet OUT ARTIFACTS_JSON [SEED COUNT [--prepare]]\n       jet Tools/agent/SafetyGate.jet --source OUT JET [SEED COUNT]"
TIERS: [String]{"O0", "O1", "O2"}
ADDITIONAL_COVERAGE: [String]{
    "native stack redzones/use-after-return",
    "uninitialized-memory/undefined-behavior instrumentation",
    "data-race instrumentation",
    "sanitized native compiler self-build",
    "IR Lint alias.exclusive/view.valid/send.boundary mutation controls",
    "inline moved-payload/Option-unwrap and backedge aliases",
}
GOLDEN_AREAS: [String]{"Memory/", "Collections/", "Text/", "LowLevel/", "Concurrency/"}
WRAPPER_FIXTURES: [String]{"lowlevel_mem_direct_import_without_unsafe", "sys_posix_wrapper_without_unsafe"}
WRAPPER_DIAGNOSTICS: [Int]{3, 2}
UNSAFE_DIAGNOSTIC: "Error [jet.UnsafeCallOutsideUnsafe]"
DEFAULT_SEED: 4
DEFAULT_COUNT: 50
CHECK_TIMEOUT_MS: 3600000

I64_MAX: 9223372036854775807
I64_MIN: -9223372036854775808
STEP_LIMIT: 20000
OUTPUT_LIMIT: 300
// `s += s` in a loop doubles a String; the model discards such programs long
// before the evaluator's own string limit.
STRING_LIMIT: 4096
ATTEMPTS: 200
WORD: 4294967296
MASK: 4294967295
LETTERS: [String]{"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", " ", "k", "l", "m", "-", ":", ".", ","}
COMPARE: [String]{"==", "!=", "<", ">", "<=", ">="}
ATOM: 11

#Error
GateError: struct {
    message: String
}

gate_fail: fn(message: String) -> GateError Never! { GateError{message: message.copy()} }

// The model discards a program whose evaluation is not defined behavior.
#Error
Reject: struct {
    reason: String
}

// ---------------------------------------------------------------- generator

// One binding the generator knows: its type ("Int", "Bool", "Str", "List" or
// "Struct") and what later statements may still do with it.
Var: struct {
    name: String
    ty: String
    mutable: Bool
    mutated: Bool
    moved: Bool
    frozen: Int
    loops: Int
}

// One expression node. `s` is the name, list, base, function or literal text;
// `op` the operator or field; `args` the call arguments, list or struct
// elements and format parts; `conds`/`vals` the arms of an `if` value.
Expr: struct {
    k: String
    v: Int
    b: Bool
    s: String
    op: String
    l: Int
    r: Int
    args: [Int]
    conds: [Int]
    vals: [Int]
}

// One statement node; `bodies` holds the `if` arm bodies.
Stmt: struct {
    k: String
    name: String
    op: String
    e: Int
    idx: Int
    f: String
    binding: Int
    conds: [Int]
    bodies: [[Int]]
    otherwise: [Int]
    has_otherwise: Bool
    body: [Int]
    lo: Int
    hi: Int
    inclusive: Bool
    limit: Int
    index: String
    item: String
    parts: [Int]
}

Fun: struct {
    name: String
    params: [Int]
    guard: Int
    body: [Int]
}

Ctx: struct {
    loops: Int
    in_loop: Bool
    in_fn: Bool
    prints: Bool
    nest: Int
}

Choice: struct {
    name: String
    weight: Float
}

// A value an interpolation or a format may name.
Hole: struct {
    k: String
    name: String
    f: String
}

// The generator state and the program it builds, as arenas of nodes.
Gen: struct {
    state: Int
    n: Int
    vars: [Var]
    scopes: [[Int]]
    exprs: [Expr]
    stmts: [Stmt]
    fns: [Fun]
    has_struct: Bool
    sname: String
    fields: [String]
    run: [Int]
}

Case: struct {
    stem: String
    source: String
    stdout: String
    stderr: String
    status: Int?
}

new_gen: fn(state: Int) -> Gen Never! {
    Gen{state: state, n: 0, vars: [Var]{}, scopes: [[Int]]{}, exprs: [Expr]{}, stmts: [Stmt]{}, fns: [Fun]{}, has_struct: false, sname: "", fields: [String]{}, run: [Int]{}}
}

// mulberry32 over a per-attempt seed: the first four sha256 bytes of the key,
// little-endian.
seed_state: fn(key: String) -> Int Never! {
    bytes: crypto.sha256(key).as_bytes()
    Int{bytes[0]} + Int{bytes[1]} * 256 + Int{bytes[2]} * 65536 + Int{bytes[3]} * 16777216
}

imul: fn(a: Int, b: Int) -> Int Never! { (a * b).bit_and(MASK) }

// The next 32-bit draw; a draw `u` stands for the double u / 2^32.
draw: fn(g: &Gen) -> Int Never! {
    g.state = (g.state + 1831565813).bit_and(MASK)
    t := g.state
    t = imul(t.bit_xor(t >> 15), t.bit_or(1))
    t = t.bit_xor((t + imul(t.bit_xor(t >> 7), t.bit_or(61))).bit_and(MASK))
    t.bit_xor(t >> 14)
}

// floor(r * n): the product of a 32-bit draw and a small n is exact.
rand_int: fn(g: &Gen, n: Int) -> Int Never! { (draw(g) * n) /% WORD }

real: fn(g: &Gen) -> Float Never! { Float{draw(g)} / 4294967296.0 }

chance: fn(g: &Gen, p: Float) -> Bool Never! { real(g) < p }

choice: fn(name: String, weight: Float) -> Choice Never! { Choice{name: name.copy(), weight: weight} }

// `weight` when there are `count` candidates, else no weight.
live: fn(count: Int, weight: Float) -> Float Never! { if count > 0 -> weight else -> 0.0 }

weighted: fn(g: &Gen, pairs: [Choice]) -> String Never! {
    total := Float{0.0}
    loop pair in pairs {
        if pair.weight > 0.0 -> total += pair.weight
    }
    x := real(g) * total
    last := ""
    loop pair in pairs {
        if pair.weight <= 0.0 -> next
        last = pair.name.copy()
        x -= pair.weight
        if x < 0.0 -> return pair.name.copy()
    }
    last
}

pick_index: fn(g: &Gen, items: [Int]) -> Int Never! { items[rand_int(g, items.len())] }

pick_text: fn(g: &Gen, items: [String]) -> String Never! { items[rand_int(g, items.len())].copy() }

pick_name: fn(g: &Gen, items: [Int]) -> String Never! {
    at: pick_index(g, items)
    g.vars[at].name.copy()
}

pick_field: fn(g: &Gen) -> String Never! {
    fields: g.fields.copy()
    pick_text(g, fields)
}

// A `k` node ("var", "len" or "copy") naming one of `items`.
var_ref: fn(g: &Gen, k: String, items: [Int]) -> Int Never! {
    name: pick_name(g, items)
    named_node(g, k, name)
}

fresh: fn(g: &Gen, prefix: String) -> String Never! {
    name: "{prefix}{g.n}"
    g.n += 1
    name
}

// The live bindings of `ty` in scope order. A moved String binding is gone
// for the rest of the program.
vars_of: fn(g: Gen, ty: String) -> [Int] Never! {
    out := [Int]{}
    loop scope in g.scopes {
        loop at in scope {
            if !g.vars[at].moved && g.vars[at].ty == ty -> out.push(at)
        }
    }
    out
}

mutable_of: fn(g: Gen, ty: String) -> [Int] Never! { vars_of(g, ty).filter(fn(at) { g.vars[at].mutable }) }

// A mutable local binding nothing has assigned yet.
local_var: fn(name: String, ty: String, loops: Int) -> Var Never! {
    Var{name: name.copy(), ty: ty.copy(), mutable: true, mutated: false, moved: false, frozen: 0, loops: loops}
}

// A binding the program never assigns: a parameter or a loop variable.
fixed_var: fn(name: String, ty: String) -> Var Never! {
    Var{name: name.copy(), ty: ty.copy(), mutable: false, mutated: false, moved: false, frozen: 0, loops: 0}
}

add_var: fn(g: &Gen, v: Var) -> Int Never! {
    g.vars.push(v.copy())
    g.vars.len() - 1
}

declare: fn(g: &Gen, at: Int) -> Int Never! {
    g.scopes[g.scopes.len() - 1].push(at)
    at
}

drop_scope: fn(g: &Gen) -> () {
    g.scopes = g.scopes[0..<g.scopes.len() - 1]
}

blank_expr: fn(k: String) -> Expr Never! {
    Expr{k: k.copy(), v: 0, b: false, s: "", op: "", l: -1, r: -1, args: [Int]{}, conds: [Int]{}, vals: [Int]{}}
}

add_expr: fn(g: &Gen, e: Expr) -> Int Never! {
    g.exprs.push(e.copy())
    g.exprs.len() - 1
}

// `l op k` for a literal `k`.
bin_int: fn(g: &Gen, op: String, l: Int, k: Int) -> Int Never! {
    r: int_node(g, k)
    bin(g, op, l, r)
}

int_node: fn(g: &Gen, v: Int) -> Int Never! {
    e := blank_expr("int")
    e.v = v
    add_expr(g, e)
}

named_node: fn(g: &Gen, k: String, s: String) -> Int Never! {
    e := blank_expr(k)
    e.s = s.copy()
    add_expr(g, e)
}

bin: fn(g: &Gen, op: String, l: Int, r: Int) -> Int Never! {
    e := blank_expr("bin")
    e.op = op.copy()
    e.l = l
    e.r = r
    add_expr(g, e)
}

unary: fn(g: &Gen, k: String, inner: Int) -> Int Never! {
    e := blank_expr(k)
    e.l = inner
    add_expr(g, e)
}

field_node: fn(g: &Gen, base: String, f: String) -> Int Never! {
    e := blank_expr("field")
    e.s = base.copy()
    e.op = f.copy()
    add_expr(g, e)
}

literal: fn(g: &Gen) -> Int Never! {
    kind: weighted(g, [Choice]{choice("small", 6.0), choice("negative", 2.0), choice("medium", 1.0), choice("large", 1.0), choice("extreme", 0.3)})
    value: if kind == {
        "small" -> rand_int(g, 21)
        "negative" -> -1 - rand_int(g, 20)
        "medium" -> rand_int(g, 1000)
        "large" -> large_literal(g)
        else -> if rand_int(g, 2) == 0 -> I64_MAX else -> -I64_MAX
    }
    int_node(g, value)
}

large_literal: fn(g: &Gen) -> Int Never! {
    sign: if rand_int(g, 2) == 0 -> -1 else -> 1
    shift: 20 + rand_int(g, 42)
    extra: rand_int(g, 1000)
    sign * ((1 << shift) + extra)
}

int_leaf: fn(g: &Gen) -> Int Never! { leaf(g, 2.0) }

// A leaf with no list index: index expressions use these.
plain_leaf: fn(g: &Gen) -> Int Never! { leaf(g, 0.0) }

leaf: fn(g: &Gen, index_weight: Float) -> Int Never! {
    ints: vars_of(g, "Int")
    lists: vars_of(g, "List")
    structs: vars_of(g, "Struct")
    strs: vars_of(g, "Str")
    kind: weighted(g, [Choice]{
        choice("lit", 4.0), choice("var", live(ints.len(), 6.0)), choice("len", live(lists.len(), 1.0)),
        choice("index", live(lists.len(), index_weight)), choice("field", live(structs.len(), 2.0)), choice("slen", live(strs.len(), 1.0)),
    })
    if kind == {
        "var" -> return var_ref(g, "var", ints)
        "len" -> return var_ref(g, "len", lists)
        "slen" -> return var_ref(g, "len", strs)
        "field" -> {
            base: pick_name(g, structs)
            f: pick_field(g)
            return field_node(g, base, f)
        }
        "index" -> {
            list: pick_name(g, lists)
            return index_node(g, list)
        }
        else -> {}
    }
    literal(g)
}

// `xs[0]` or `xs[e % xs.len()]`, so the index is always in range.
index_node: fn(g: &Gen, list: String) -> Int Never! {
    idx: list_index(g, list)
    e := blank_expr("index")
    e.s = list.copy()
    e.l = idx
    add_expr(g, e)
}

list_index: fn(g: &Gen, list: String) -> Int Never! {
    if chance(g, 0.25) -> return int_node(g, 0)
    inner: plain_leaf(g)
    size: named_node(g, "len", list)
    bin(g, "%", inner, size)
}

divisor: fn(g: &Gen, depth: Int) -> Int Never! {
    inner: int_expr(g, depth)
    k: 2 + rand_int(g, 8)
    modulo: bin_int(g, "%", inner, k)
    bin_int(g, "+", modulo, 1)
}

callable: fn(g: Gen) -> [Int] Never! {
    out := [Int]{}
    loop at in 0..<g.fns.len() {
        if g.fns[at].params.all(fn(p) { g.vars[p].ty == "Int" || vars_of(g, g.vars[p].ty).len() > 0 }) -> out.push(at)
    }
    out
}

call: fn(g: &Gen, f: Int, depth: Int) -> Int Never! {
    params: g.fns[f].params.copy()
    guard: g.fns[f].guard
    args := [Int]{}
    loop i in 0..<params.len() {
        ty: g.vars[params[i]].ty.copy()
        if ty != "Int" {
            live: vars_of(g, ty)
            arg: var_ref(g, "var", live)
            args.push(arg)
            next
        }
        arg: int_expr(g, depth)
        if i == 0 && guard > 0 {
            guarded_arg: bin_int(g, "%", arg, guard)
            args.push(guarded_arg)
            next
        }
        args.push(arg)
    }
    e := blank_expr("call")
    e.s = g.fns[f].name.copy()
    e.args = args
    add_expr(g, e)
}

int_expr: fn(g: &Gen, depth: Int) -> Int Never! {
    if depth <= 0 || chance(g, 0.25) -> return int_leaf(g)
    reachable: callable(g)
    kind: weighted(g, [Choice]{choice("arith", 8.0), choice("div", 2.0), choice("bit", 2.0), choice("shift", 1.0), choice("neg", 1.0), choice("call", live(reachable.len(), 2.0))})
    d: depth - 1
    if kind == {
        "arith" -> {
            op: weighted(g, [Choice]{choice("+", 3.0), choice("-", 3.0), choice("*", 2.0)})
            return pair(g, op, d)
        }
        "div" -> {
            op: pick_text(g, [String]{"/%", "%", "%%"})
            left: int_expr(g, d)
            right: if chance(g, 0.8) -> divisor(g, d) else -> int_expr(g, d)
            return bin(g, op, left, right)
        }
        "bit" -> {
            op: pick_text(g, [String]{"&", "|", "~|"})
            return pair(g, op, d)
        }
        "shift" -> {
            op: pick_text(g, [String]{"<<", ">>"})
            left: int_expr(g, d)
            k: rand_int(g, 9)
            return bin_int(g, op, left, k)
        }
        "neg" -> {
            inner: int_expr(g, d)
            return unary(g, "neg", inner)
        }
        else -> {}
    }
    f: reachable[rand_int(g, reachable.len())]
    call(g, f, d)
}

pair: fn(g: &Gen, op: String, d: Int) -> Int Never! {
    left: int_expr(g, d)
    right: int_expr(g, d)
    bin(g, op, left, right)
}

bool_expr: fn(g: &Gen, depth: Int) -> Int Never! {
    bools: vars_of(g, "Bool")
    strs: vars_of(g, "Str")
    if depth <= 0 || chance(g, 0.2) -> return bool_leaf(g, bools, strs)
    kind: weighted(g, [Choice]{choice("cmp", 6.0), choice("and", 2.0), choice("or", 2.0), choice("not", 1.0)})
    d: depth - 1
    if kind == {
        "cmp" -> {
            op: pick_text(g, COMPARE)
            left: int_expr(g, d)
            right: int_expr(g, d)
            return bin(g, op, left, right)
        }
        "not" -> {
            inner: bool_expr(g, d)
            return unary(g, "not", inner)
        }
        else -> {}
    }
    op: if kind == "and" -> "&&" else -> "||"
    left: bool_expr(g, d)
    right: bool_expr(g, d)
    bin(g, op, left, right)
}

bool_leaf: fn(g: &Gen, bools: [Int], strs: [Int]) -> Int Never! {
    kind: weighted(g, [Choice]{choice("lit", 1.0), choice("var", live(bools.len(), 3.0)), choice("cmp", 4.0), choice("scmp", live(strs.len(), 1.0))})
    if kind == {
        "lit" -> {
            e := blank_expr("bool")
            e.b = chance(g, 0.5)
            return add_expr(g, e)
        }
        "var" -> return var_ref(g, "var", bools)
        "scmp" -> {
            op: pick_text(g, [String]{"==", "!="})
            left: var_ref(g, "var", strs)
            right: if chance(g, 0.5) -> var_ref(g, "var", strs) else -> text_node(g)
            return bin(g, op, left, right)
        }
        else -> {}
    }
    op: pick_text(g, COMPARE)
    left: int_expr(g, 1)
    right: int_expr(g, 1)
    bin(g, op, left, right)
}

if_value: fn(g: &Gen) -> Int Never! {
    e := blank_expr("ifx")
    count: 1 + rand_int(g, 3)
    loop _ in 0..<count {
        e.conds.push(bool_expr(g, 2))
        e.vals.push(int_expr(g, 2))
    }
    e.r = int_expr(g, 2)
    add_expr(g, e)
}

// String values: literals, interpolations of the bindings in scope, and
// explicit copies (`s.copy()`). Moves (`t: s`) are generated as bindings.
text: fn(g: &Gen) -> String Never! {
    count: rand_int(g, 6)
    out := ""
    loop _ in 0..<count -> out = "{out}{LETTERS[rand_int(g, LETTERS.len())]}"
    out
}

text_node: fn(g: &Gen) -> Int Never! { text_part(g, "str") }

// A literal node of `k` ("str" or "text") with fresh text.
text_part: fn(g: &Gen, k: String) -> Int Never! {
    value: text(g)
    named_node(g, k, value)
}

hole_node: fn(g: &Gen, hole: Hole) -> Int Never! {
    if hole.k == "field" -> return field_node(g, hole.name, hole.f)
    named_node(g, hole.k, hole.name)
}

str_expr: fn(g: &Gen) -> Int Never! {
    strs: vars_of(g, "Str")
    holes := [Hole]{}
    loop at in vars_of(g, "Int") -> holes.push(Hole{k: "var", name: g.vars[at].name.copy(), f: ""})
    loop at in strs -> holes.push(Hole{k: "var", name: g.vars[at].name.copy(), f: ""})
    loop at in strs -> holes.push(Hole{k: "len", name: g.vars[at].name.copy(), f: ""})
    kind: weighted(g, [Choice]{choice("lit", 3.0), choice("fmt", live(holes.len(), 3.0)), choice("copy", live(strs.len(), 2.0))})
    if kind == {
        "copy" -> return var_ref(g, "copy", strs)
        "lit" -> return text_node(g)
        else -> {}
    }
    e := blank_expr("strfmt")
    count: 1 + rand_int(g, 3)
    loop _ in 0..<count {
        e.args.push(text_part(g, "text"))
        hole: holes[rand_int(g, holes.len())].copy()
        e.args.push(hole_node(g, hole))
    }
    if chance(g, 0.5) -> e.args.push(text_part(g, "text"))
    add_expr(g, e)
}

blank_stmt: fn(k: String) -> Stmt Never! {
    Stmt{
        k: k.copy(), name: "", op: "", e: -1, idx: -1, f: "", binding: -1, conds: [Int]{}, bodies: [[Int]]{}, otherwise: [Int]{},
        has_otherwise: false, body: [Int]{}, lo: -1, hi: -1, inclusive: false, limit: 0, index: "", item: "", parts: [Int]{},
    }
}

add_stmt: fn(g: &Gen, s: Stmt) -> [Int] Never! {
    g.stmts.push(s.copy())
    [Int]{g.stmts.len() - 1}
}

decl: fn(g: &Gen, at: Int, init: Int) -> [Int] Never! {
    s := blank_stmt("decl")
    s.binding = at
    s.e = init
    add_stmt(g, s)
}

assign: fn(g: &Gen, name: String, op: String, e: Int) -> [Int] Never! {
    s := blank_stmt("assign")
    s.name = name.copy()
    s.op = op.copy()
    s.e = e
    add_stmt(g, s)
}

// `if cond -> <one statement>`.
guarded: fn(g: &Gen, cond: Int, body: [Int]) -> [Int] Never! {
    s := blank_stmt("if")
    s.conds.push(cond)
    s.bodies.push(body.copy())
    add_stmt(g, s)
}

block: fn(g: &Gen, count: Int, ctx: Ctx) -> [Int] Never! {
    g.scopes.push([Int]{})
    out := [Int]{}
    loop _ in 0..<count -> out.extend(stmt(g, ctx))
    drop_scope(g)
    out
}

inner_ctx: fn(ctx: Ctx) -> Ctx Never! { Ctx{loops: ctx.loops, in_loop: ctx.in_loop, in_fn: ctx.in_fn, prints: ctx.prints, nest: ctx.nest + 1} }

loop_ctx: fn(ctx: Ctx) -> Ctx Never! { Ctx{loops: ctx.loops + 1, in_loop: true, in_fn: ctx.in_fn, prints: ctx.prints, nest: ctx.nest + 1} }

stmt: fn(g: &Gen, ctx: Ctx) -> [Int] Never! {
    ints: mutable_of(g, "Int")
    bools: mutable_of(g, "Bool")
    lists: vars_of(g, "List")
    open: lists.filter(fn(at) { g.vars[at].mutable && g.vars[at].frozen == 0 })
    structs: mutable_of(g, "Struct")
    strs: mutable_of(g, "Str")
    // A move out of a binding made in an enclosing loop would repeat (E: use after move).
    movable: strs.filter(fn(at) { g.vars[at].loops == ctx.loops })
    deeper: ctx.nest < 3
    looping: ctx.loops < 2 && deeper
    has_struct: g.has_struct
    // Each scale is 1.0 where its statement kind may appear here, else 0.0.
    printing: if ctx.prints -> Float{1.0} else -> Float{0.0}
    nesting: if deeper -> Float{1.0} else -> Float{0.0}
    looped: if looping -> Float{1.0} else -> Float{0.0}
    structured: if has_struct -> Float{1.0} else -> Float{0.0}
    jumping: if ctx.in_loop -> Float{1.0} else -> Float{0.0}
    returning: if ctx.in_fn -> Float{1.0} else -> Float{0.0}
    kind: weighted(g, [Choice]{
        choice("int", 5.0), choice("bool", 1.0), choice("assign", live(ints.len(), 4.0)), choice("assignBool", live(bools.len(), 0.5)),
        choice("print", 4.0 * printing), choice("if", 3.0 * nesting),
        choice("range", 2.0 * looped), choice("while", 1.5 * looped),
        choice("list", 1.5), choice("push", live(open.len(), 1.5)), choice("setidx", live(open.len(), 1.0)),
        choice("foreach", live(lists.len(), 1.5 * looped)),
        choice("struct", 1.0 * structured), choice("setfield", live(structs.len(), 1.5)),
        choice("str", 2.0), choice("append", live(strs.len(), 2.0)), choice("assignStr", live(strs.len(), 0.5)), choice("move", live(movable.len(), 0.7)),
        choice("jump", 1.0 * jumping), choice("return", 0.7 * returning),
    })
    inner: inner_ctx(ctx)
    if kind == {
        "int" -> {
            init: if chance(g, 0.1) -> if_value(g) else -> int_expr(g, 2)
            // `v: xs[i]` and `v: p.f` bind a read view that blocks later writes
            // to the owner (E0212); `:=` binds an owned copy.
            owned: g.exprs[init].k == "index" || g.exprs[init].k == "field"
            v := local_var(fresh(g, "v"), "Int", 0)
            v.mutated = owned
            return declare_new(g, v, init)
        }
        "bool" -> {
            init: bool_expr(g, 2)
            v: local_var(fresh(g, "b"), "Bool", 0)
            return declare_new(g, v, init)
        }
        "assign" -> {
            name: mark_mutated(g, ints)
            op: weighted(g, [Choice]{choice("=", 3.0), choice("+=", 3.0), choice("-=", 2.0), choice("*=", 1.0), choice("/%=", 1.0), choice("%=", 1.0)})
            e: if op == "/%=" || op == "%=" -> divisor(g, 1) else -> int_expr(g, 2)
            return assign(g, name, op, e)
        }
        "assignBool" -> {
            name: mark_mutated(g, bools)
            e: bool_expr(g, 2)
            return assign(g, name, "=", e)
        }
        "str" -> {
            init: str_expr(g)
            v: local_var(fresh(g, "s"), "Str", ctx.loops)
            return declare_new(g, v, init)
        }
        "append" -> {
            name: mark_mutated(g, strs)
            all: vars_of(g, "Str")
            e: if chance(g, 0.3) -> var_ref(g, "var", all) else -> str_expr(g)
            return assign(g, name, "+=", e)
        }
        "assignStr" -> {
            name: mark_mutated(g, strs)
            e: str_expr(g)
            return assign(g, name, "=", e)
        }
        "move" -> {
            source: pick_index(g, movable)
            moved: g.vars[source].name.copy()
            init: named_node(g, "var", moved)
            g.vars[source].moved = true
            v: local_var(fresh(g, "s"), "Str", ctx.loops)
            return declare_new(g, v, init)
        }
        "print" -> return print_stmt(g)
        "if" -> return if_stmt(g, inner)
        "range" -> return range_stmt(g, inner)
        "while" -> return while_stmt(g, ctx)
        "list" -> {
            e := blank_expr("list")
            count: 1 + rand_int(g, 4)
            loop _ in 0..<count -> e.args.push(int_expr(g, 1))
            init: add_expr(g, e)
            v: local_var(fresh(g, "xs"), "List", 0)
            return declare_new(g, v, init)
        }
        "push" -> {
            s := blank_stmt("push")
            s.name = mark_mutated(g, open)
            s.e = int_expr(g, 2)
            return add_stmt(g, s)
        }
        "setidx" -> {
            s := blank_stmt("setidx")
            s.name = mark_mutated(g, open)
            // Compound assignment cannot target an indexed slot (E0164).
            s.op = "="
            s.idx = list_index(g, s.name)
            s.e = int_expr(g, 2)
            return add_stmt(g, s)
        }
        "foreach" -> return foreach_stmt(g, lists, ctx)
        "struct" -> {
            e := blank_expr("struct")
            e.s = g.sname.copy()
            loop _ in g.fields.copy() -> e.args.push(int_expr(g, 1))
            init: add_expr(g, e)
            v: local_var(fresh(g, "p"), "Struct", 0)
            return declare_new(g, v, init)
        }
        "setfield" -> {
            s := blank_stmt("setfield")
            s.name = mark_mutated(g, structs)
            s.f = pick_field(g)
            s.op = pick_text(g, [String]{"=", "+=", "-="})
            s.e = int_expr(g, 2)
            return add_stmt(g, s)
        }
        "jump" -> {
            cond: bool_expr(g, 1)
            jump: if chance(g, 0.5) -> "break" else -> "next"
            body: add_stmt(g, blank_stmt(jump))
            return guarded(g, cond, body)
        }
        else -> {}
    }
    cond: bool_expr(g, 1)
    s := blank_stmt("return")
    s.e = int_expr(g, 2)
    body: add_stmt(g, s)
    guarded(g, cond, body)
}

// A new binding in the innermost scope, declared from `init`.
declare_new: fn(g: &Gen, v: Var, init: Int) -> [Int] Never! {
    at: add_var(g, v)
    placed: declare(g, at)
    decl(g, placed, init)
}

// One of `items`, now mutated; its name.
mark_mutated: fn(g: &Gen, items: [Int]) -> String Never! {
    at: pick_index(g, items)
    g.vars[at].mutated = true
    g.vars[at].name.copy()
}

while_stmt: fn(g: &Gen, ctx: Ctx) -> [Int] Never! {
    name: fresh(g, "c")
    c := fixed_var(name, "Int")
    c.mutated = true
    counter: add_var(g, c)
    declare(g, counter)
    count: 1 + rand_int(g, 4)
    body: block(g, count, loop_ctx(ctx))
    zero: int_node(g, 0)
    out := decl(g, counter, zero)
    s := blank_stmt("while")
    s.name = name.copy()
    s.body = body
    s.limit = 1 + rand_int(g, 6)
    out.extend(add_stmt(g, s))
    out
}

if_stmt: fn(g: &Gen, inner: Ctx) -> [Int] Never! {
    s := blank_stmt("if")
    count: 1 + rand_int(g, 3)
    loop _ in 0..<count {
        s.conds.push(bool_expr(g, 2))
        size: 1 + rand_int(g, 3)
        s.bodies.push(block(g, size, inner))
    }
    if chance(g, 0.4) {
        s.has_otherwise = true
        size: 1 + rand_int(g, 2)
        s.otherwise = block(g, size, inner)
    }
    add_stmt(g, s)
}

range_stmt: fn(g: &Gen, inner: Ctx) -> [Int] Never! {
    s := blank_stmt("range")
    s.lo = if chance(g, 0.7) -> int_node(g, 0) else -> random_node(g, 4)
    s.hi = if chance(g, 0.6) -> random_node(g, 6) else -> range_bound(g)
    s.name = fresh(g, "i")
    at: add_var(g, fixed_var(s.name, "Int"))
    g.scopes.push([Int]{at})
    size: 1 + rand_int(g, 4)
    s.body = block(g, size, Ctx{loops: inner.loops + 1, in_loop: true, in_fn: inner.in_fn, prints: inner.prints, nest: inner.nest})
    drop_scope(g)
    s.inclusive = chance(g, 0.3)
    add_stmt(g, s)
}

// A literal below `n`.
random_node: fn(g: &Gen, n: Int) -> Int Never! {
    value: rand_int(g, n)
    int_node(g, value)
}

range_bound: fn(g: &Gen) -> Int Never! {
    inner: int_expr(g, 1)
    k: 2 + rand_int(g, 5)
    bin_int(g, "%", inner, k)
}

foreach_stmt: fn(g: &Gen, lists: [Int], ctx: Ctx) -> [Int] Never! {
    list: pick_index(g, lists)
    s := blank_stmt("foreach")
    s.name = g.vars[list].name.copy()
    scope := [Int]{}
    if chance(g, 0.4) {
        s.index = fresh(g, "i")
        scope.push(add_var(g, fixed_var(s.index, "Int")))
    }
    s.item = fresh(g, "x")
    scope.push(add_var(g, fixed_var(s.item, "Int")))
    g.vars[list].frozen += 1
    g.scopes.push(scope)
    size: 1 + rand_int(g, 3)
    s.body = block(g, size, loop_ctx(ctx))
    drop_scope(g)
    g.vars[list].frozen -= 1
    add_stmt(g, s)
}

print_stmt: fn(g: &Gen) -> [Int] Never! {
    ints: vars_of(g, "Int")
    bools: vars_of(g, "Bool")
    lists: vars_of(g, "List")
    structs: vars_of(g, "Struct")
    strs: vars_of(g, "Str")
    kind: weighted(g, [Choice]{choice("interp", 4.0), choice("expr", 2.0), choice("bool", 1.0), choice("list", live(lists.len(), 1.0)), choice("struct", live(structs.len(), 0.7)), choice("str", live(strs.len(), 1.0))})
    s := blank_stmt("print")
    if kind == {
        "str" -> s.e = var_ref(g, "var", strs)
        "expr" -> s.e = int_expr(g, 2)
        "bool" -> s.e = bool_expr(g, 2)
        "list" -> s.e = var_ref(g, "var", lists)
        "struct" -> s.e = var_ref(g, "var", structs)
        else -> s = interp_stmt(g, ints, bools, strs, structs)
    }
    add_stmt(g, s)
}

interp_stmt: fn(g: &Gen, ints: [Int], bools: [Int], strs: [Int], structs: [Int]) -> Stmt Never! {
    holes := [Hole]{}
    loop at in ints -> holes.push(Hole{k: "var", name: g.vars[at].name.copy(), f: ""})
    loop at in bools -> holes.push(Hole{k: "var", name: g.vars[at].name.copy(), f: ""})
    loop at in strs -> holes.push(Hole{k: "var", name: g.vars[at].name.copy(), f: ""})
    loop at in structs {
        loop f in g.fields -> holes.push(Hole{k: "field", name: g.vars[at].name.copy(), f: f.copy()})
    }
    s := blank_stmt("interp")
    title: fresh(g, "t")
    s.parts.push(named_node(g, "text", title))
    count: if holes.len() > 0 -> 1 + rand_int(g, 3) else -> 0
    loop i in 0..<count {
        s.parts.push(named_node(g, "text", if i > 0 -> " " else -> " = "))
        hole: holes[rand_int(g, holes.len())].copy()
        s.parts.push(hole_node(g, hole))
    }
    s
}

helper: fn(g: &Gen, index: Int) -> Fun Never! {
    types := [String]{"Int", "Int", "Int", "Int", "List", "Str"}
    if g.has_struct -> types.push("Struct")
    count: 1 + rand_int(g, 3)
    params := [Int]{}
    loop i in 0..<count {
        ty: pick_text(g, types)
        params.push(add_var(g, fixed_var("a{index}_{i}", ty)))
    }
    g.scopes = [[Int]]{params.copy()}
    prints: chance(g, 0.3)
    ctx: Ctx{loops: 0, in_loop: false, in_fn: true, prints: prints, nest: 1}
    size: 1 + rand_int(g, 5)
    body := block(g, size, ctx)
    s := blank_stmt("return")
    s.e = int_expr(g, 2)
    body.extend(add_stmt(g, s))
    Fun{name: "h{index}", params: params, guard: 0, body: body}
}

recursive: fn(g: &Gen, index: Int) -> Fun Never! {
    n: add_var(g, fixed_var("n", "Int"))
    acc: add_var(g, fixed_var("acc", "Int"))
    name: "r{index}"
    g.scopes = [[Int]]{[Int]{n, acc}}
    ctx: Ctx{loops: 0, in_loop: false, in_fn: true, prints: false, nest: 2}
    back := blank_stmt("return")
    back.e = named_node(g, "var", "acc")
    base_case: add_stmt(g, back)
    n_ref: named_node(g, "var", "n")
    bottom: bin_int(g, "<=", n_ref, 0)
    body := guarded(g, bottom, base_case)
    size: rand_int(g, 3)
    body.extend(block(g, size, ctx))
    step := blank_expr("call")
    step.s = name.copy()
    n_next: named_node(g, "var", "n")
    step.args.push(bin_int(g, "-", n_next, 1))
    step.args.push(int_expr(g, 2))
    stepped: add_expr(g, step)
    tail: if chance(g, 0.5) -> stepped else -> recursive_tail(g, stepped)
    s := blank_stmt("return")
    s.e = tail
    body.extend(add_stmt(g, s))
    Fun{name: name, params: [Int]{n, acc}, guard: 12, body: body}
}

recursive_tail: fn(g: &Gen, stepped: Int) -> Int Never! {
    op: pick_text(g, [String]{"+", "-", "~|"})
    right: int_expr(g, 1)
    bin(g, op, stepped, right)
}

program: fn(g: &Gen) -> () {
    if chance(g, 0.6) {
        all: [String]{"x", "y", "z", "w"}
        count: 2 + rand_int(g, 3)
        g.fields = all[0..<count]
        number: rand_int(g, 10)
        g.sname = "Pt{number}"
        g.has_struct = true
    }
    helpers: rand_int(g, 4)
    loop i in 0..<helpers {
        made: helper(g, i)
        g.fns.push(made)
    }
    if chance(g, 0.4) {
        made: recursive(g, helpers)
        g.fns.push(made)
    }
    // `run` ends by printing every binding still in scope, so a computation
    // no other print observed still reaches stdout.
    g.scopes = [[Int]]{[Int]{}}
    ctx: Ctx{loops: 0, in_loop: false, in_fn: false, prints: true, nest: 0}
    count: 10 + rand_int(g, 20)
    run := [Int]{}
    loop _ in 0..<count -> run.extend(stmt(g, ctx))
    loop at in g.scopes[0].copy() {
        if g.vars[at].moved -> next
        s := blank_stmt("print")
        name: g.vars[at].name.copy()
        s.e = named_node(g, "var", name)
        run.extend(add_stmt(g, s))
    }
    g.run = run
}

// ---------------------------------------------------------------- renderer

Rendered: struct {
    text: String
    prec: Int
}

precedence: fn(op: String) -> Int Never! {
    if op == {
        "||" -> 1
        "&&" -> 2
        "|" -> 4
        "~|" -> 5
        "&" -> 6
        "<<" -> 7
        ">>" -> 7
        "+" -> 8
        "-" -> 8
        else -> if COMPARE.contains(op) -> 3 else -> 9
    }
}

bit_method: fn(op: String) -> String Never! {
    if op == {
        "&" -> "bit_and"
        "|" -> "bit_or"
        "~|" -> "bit_xor"
        else -> ""
    }
}

atom: fn(text: String) -> Rendered Never! { Rendered{text: text.copy(), prec: ATOM} }

render: fn(g: Gen, at: Int) -> Rendered Never! {
    e: g.exprs[at]
    if e.k == {
        "int" -> atom(if e.v < 0 -> "({e.v})" else -> "{e.v}")
        "bool" -> atom(if e.b -> "true" else -> "false")
        "str" -> atom("\"{e.s}\"")
        "strfmt" -> atom("\"{parts_text(g, e.args)}\"")
        "copy" -> atom("{e.s}.copy()")
        "var" -> atom(e.s)
        "len" -> atom("{e.s}.len()")
        "index" -> atom("{e.s}[{expr(g, e.l)}]")
        "field" -> atom("{e.s}.{e.op}")
        "call" -> atom("{e.s}({e.args.map(fn(arg) { expr(g, arg) }).join(", ")})")
        "neg" -> atom("(-{grouped(g, e.l)})")
        "not" -> Rendered{text: "!{grouped(g, e.l)}", prec: 10}
        else -> render_bin(g, e)
    }
}

render_bin: fn(g: Gen, e: Expr) -> Rendered Never! {
    method: bit_method(e.op)
    if method != "" -> return atom("{grouped(g, e.l)}.{method}({expr(g, e.r)})")
    p: precedence(e.op)
    l: render(g, e.l)
    r: render(g, e.r)
    // Comparisons do not chain, and `&&` mixed with `||` needs parentheses (E0082).
    left: if l.prec < p || (p == 3 && l.prec == 3) || logic(p, l.prec) -> "({l.text})" else -> l.text.copy()
    right: if r.prec <= p || logic(p, r.prec) -> "({r.text})" else -> r.text.copy()
    Rendered{text: "{left} {e.op} {right}", prec: p}
}

logic: fn(p: Int, child: Int) -> Bool Never! { p <= 2 && child <= 2 && child != p }

expr: fn(g: Gen, at: Int) -> String Never! { render(g, at).text }

grouped: fn(g: Gen, at: Int) -> String Never! {
    r: render(g, at)
    if r.prec == ATOM -> return r.text.copy()
    "({r.text})"
}

// Format parts: literal text as written, every other part as `{expr}`.
parts_text: fn(g: Gen, parts: [Int]) -> String Never! {
    out := ""
    loop part in parts {
        piece: if g.exprs[part].k == "text" -> g.exprs[part].s.copy() else -> "{{{expr(g, part)}}}"
        out = "{out}{piece}"
    }
    out
}

simple: fn(g: Gen, at: Int) -> String? Never! {
    s: g.stmts[at]
    if s.k == {
        "assign" -> Val("{s.name} {s.op} {expr(g, s.e)}")
        "print" -> Val("print({expr(g, s.e)})")
        "interp" -> Val("print(\"{parts_text(g, s.parts)}\")")
        "push" -> Val("&{s.name}.push({expr(g, s.e)})")
        "setidx" -> Val("{s.name}[{expr(g, s.idx)}] {s.op} {expr(g, s.e)}")
        "setfield" -> Val("{s.name}.{s.f} {s.op} {expr(g, s.e)}")
        "break" -> Val("break")
        "next" -> Val("next")
        "return" -> Val("return {expr(g, s.e)}")
        else -> None
    }
}

// A body that is one simple statement, as that statement's text.
single: fn(g: Gen, body: [Int]) -> String? Never! {
    if body.len() != 1 -> return None
    simple(g, body[0])
}

lines: fn(g: Gen, stmts: [Int], depth: Int) -> [String] Never! {
    pad: "    ".repeat(depth)
    out := [String]{}
    loop at in stmts {
        if simple(g, at) == .Val(one) {
            out.push("{pad}{one}")
            next
        }
        s: g.stmts[at]
        if s.k == {
            "decl" -> out.extend(decl_lines(g, s, pad))
            "if" -> out.extend(if_lines(g, s, pad, depth))
            "range" -> {
                bound: if s.inclusive -> ".." else -> "..<"
                out.extend(nested(g, "loop {s.name} in {grouped(g, s.lo)}{bound}{grouped(g, s.hi)}", s.body, pad, depth))
            }
            "while" -> {
                out.push("{pad}loop {s.name} < {s.limit} {{")
                out.push("{pad}    {s.name} += 1")
                out.extend(lines(g, s.body, depth + 1))
                out.push("{pad}}}")
            }
            "foreach" -> {
                binding: if s.index != "" -> "({s.index}, {s.item})" else -> s.item.copy()
                out.extend(nested(g, "loop {binding} in {s.name}", s.body, pad, depth))
            }
            else -> panic("lines: {s.k}")
        }
    }
    out
}

nested: fn(g: Gen, head: String, body: [Int], pad: String, depth: Int) -> [String] Never! {
    if single(g, body) == .Val(one) -> return [String]{"{pad}{head} -> {one}"}
    out := [String]{"{pad}{head} {{"}
    out.extend(lines(g, body, depth + 1))
    out.push("{pad}}}")
    out
}

decl_lines: fn(g: Gen, s: Stmt, pad: String) -> [String] Never! {
    v: g.vars[s.binding]
    bind: if v.mutated -> "{pad}{v.name} := " else -> "{pad}{v.name}: "
    init: g.exprs[s.e]
    if init.k == {
        "list" -> return [String]{"{bind}[{init.args.map(fn(arg) { expr(g, arg) }).join(", ")}]"}
        "struct" -> {
            fields := [String]{}
            loop i in 0..<init.args.len() -> fields.push("{g.fields[i]}: {expr(g, init.args[i])}")
            return [String]{"{bind}{init.s}{{{fields.join(", ")}}}"}
        }
        "ifx" -> {
            if init.conds.len() == 1 -> return [String]{"{bind}if {expr(g, init.conds[0])} -> {expr(g, init.vals[0])} else -> {expr(g, init.r)}"}
            out := [String]{"{bind}if {{"}
            loop i in 0..<init.conds.len() -> out.push("{pad}    {expr(g, init.conds[i])} -> {expr(g, init.vals[i])}")
            out.push("{pad}    else -> {expr(g, init.r)}")
            out.push("{pad}}}")
            return out
        }
        else -> {}
    }
    [String]{"{bind}{expr(g, s.e)}"}
}

if_lines: fn(g: Gen, s: Stmt, pad: String, depth: Int) -> [String] Never! {
    if s.conds.len() == 1 && !s.has_otherwise {
        if single(g, s.bodies[0]) == .Val(one) -> return [String]{"{pad}if {expr(g, s.conds[0])} -> {one}"}
    }
    out := [String]{"{pad}if {{"}
    loop i in 0..<s.conds.len() {
        out.push("{pad}    {expr(g, s.conds[i])} -> {{")
        out.extend(lines(g, s.bodies[i], depth + 2))
        out.push("{pad}    }}")
    }
    if s.has_otherwise {
        out.push("{pad}    else -> {{")
        out.extend(lines(g, s.otherwise, depth + 2))
        out.push("{pad}    }}")
    }
    out.push("{pad}}}")
    out
}

type_name: fn(g: Gen, ty: String) -> String Never! {
    if ty == {
        "Int" -> "Int"
        "List" -> "[Int]"
        "Str" -> "String"
        else -> g.sname.copy()
    }
}

source: fn(g: Gen, header: String) -> String Never! {
    out := [String]{"// {header}"}
    if g.has_struct {
        out.push("")
        out.push("{g.sname}: struct {{")
        loop f in g.fields -> out.push("    {f}: Int")
        out.push("}}")
    }
    loop f in g.fns {
        params: f.params.map(fn(p) { "{g.vars[p].name}: {type_name(g, g.vars[p].ty)}" }).join(", ")
        out.push("")
        out.push("{f.name}: fn({params}) -> Int {{")
        out.extend(lines(g, f.body, 1))
        out.push("}}")
    }
    out.push("")
    out.push("run: fn() {{")
    out.extend(lines(g, g.run, 1))
    out.push("}}")
    "{out.join("\n")}\n"
}

// ---------------------------------------------------------------- model

// A model value: "int", "bool", "str", "list" or "struct" (whose field values
// are `items`, in the program's field order).
Value: struct {
    k: String
    i: Int
    b: Bool
    s: String
    items: [Int]
}

// `k` is "", "break", "next" or "return".
Signal: struct {
    k: String
    v: Value
}

// Bindings as one stack; a call frame cannot see below its `base`, and each
// scope starts at a `marks` entry.
Machine: struct {
    names: [String]
    values: [Value]
    marks: [Int]
    base: Int
    out: [String]
    steps: Int
    depth: Int
}

int_value: fn(i: Int) -> Value Never! { Value{k: "int", i: i, b: false, s: "", items: [Int]{}} }

// A comparison's Bool value, from its operands' ordering.
compared: fn(op: String, order: Ordering) -> Value Never! {
    holds: if op == {
        "==" -> order == Ordering.Equal
        "!=" -> order != Ordering.Equal
        "<" -> order == Ordering.Less
        ">" -> order == Ordering.Greater
        "<=" -> order != Ordering.Greater
        else -> order != Ordering.Less
    }
    Value{k: "bool", i: 0, b: holds, s: "", items: [Int]{}}
}

str_value: fn(s: String) -> Value Never! { Value{k: "str", i: 0, b: false, s: s.copy(), items: [Int]{}} }

items_value: fn(k: String, items: [Int]) -> Value Never! { Value{k: k.copy(), i: 0, b: false, s: "", items: items} }

no_signal: fn() -> Signal Never! { Signal{k: "", v: int_value(0)} }

reject: fn(reason: String) -> Reject Never! { Reject{reason: reason.copy()} }

within_limits: fn(v: Value) -> Value Reject! {
    if v.k == "int" && (v.i > I64_MAX || v.i < I64_MIN) -> return Err(reject("overflow"))
    if v.k == "str" && v.s.len() > STRING_LIMIT -> return Err(reject("string size"))
    Ok(v)
}

checked_int: fn(i: Int) -> Value Reject! { within_limits(int_value(i)) }

arith: fn(op: String, a: Value, b: Value) -> Value Reject! {
    if a.k == "str" {
        if op == "+" -> return within_limits(str_value("{a.s}{b.s}"))
        return Ok(compared(op, a.s <=> b.s))
    }
    x: a.i
    y: b.i
    if op == {
        "+" -> checked_int(x + y)
        "-" -> checked_int(x - y)
        "*" -> checked_int(x * y)
        "/%" -> if y == 0 -> Err(reject("division by zero")) else -> checked_int(x /% y)
        // i64::MIN by -1 overflows in the remainder too.
        "%" -> remainder(op, x, y)
        "%%" -> remainder(op, x, y)
        "&" -> Ok(int_value(x.bit_and(y)))
        "|" -> Ok(int_value(x.bit_or(y)))
        "~|" -> Ok(int_value(x.bit_xor(y)))
        "<<" -> checked_int(x << y)
        ">>" -> Ok(int_value(x >> y))
        else -> Ok(compared(op, x <=> y))
    }
}

// `%` floors and `%%` truncates; i64::MIN by -1 overflows in the remainder too.
remainder: fn(op: String, x: Int, y: Int) -> Value Reject! {
    if y == 0 -> return Err(reject("division by zero"))
    if x == I64_MIN && y == -1 -> return Err(reject("overflow"))
    Ok(int_value(if op == "%" -> x % y else -> x %% y))
}

show: fn(g: Gen, v: Value) -> String Never! {
    if v.k == {
        "int" -> "{v.i}"
        "bool" -> if v.b -> "true" else -> "false"
        "str" -> v.s.copy()
        "list" -> "[{v.items.map(fn(item) { "{item}" }).join(", ")}]"
        else -> struct_text(g, v)
    }
}

struct_text: fn(g: Gen, v: Value) -> String Never! {
    fields := [String]{}
    loop i in 0..<v.items.len() -> fields.push("{g.fields[i]}: {v.items[i]}")
    "{g.sname} {{ {fields.join(", ")} }}"
}

slot: fn(m: Machine, name: String) -> Int Never! {
    at := m.names.len() - 1
    loop at >= m.base {
        if m.names[at] == name -> return at
        at -= 1
    }
    panic("model: unbound {name}")
}

lookup: fn(m: Machine, name: String) -> Value Never! { m.values[slot(m, name)].copy() }

define: fn(m: &Machine, name: String, v: Value) -> () {
    m.names.push(name.copy())
    m.values.push(v.copy())
}

open_scope: fn(m: &Machine) -> () { m.marks.push(m.names.len()) }

close_scope: fn(m: &Machine) -> () {
    mark: m.marks[m.marks.len() - 1]
    m.marks = m.marks[0..<m.marks.len() - 1]
    m.names = m.names[0..<mark]
    m.values = m.values[0..<mark]
}

tick: fn(m: &Machine) Reject! {
    m.steps += 1
    if m.steps > STEP_LIMIT -> return Err(reject("steps"))
    Ok()
}

emit: fn(m: &Machine, line: String) Reject! {
    m.out.push(line.copy())
    if m.out.len() > OUTPUT_LIMIT -> return Err(reject("output"))
    Ok()
}

eval: fn(m: &Machine, g: Gen, at: Int) -> Value Reject! {
    e: g.exprs[at]
    if e.k == {
        "int" -> Ok(int_value(e.v))
        "bool" -> Ok(Value{k: "bool", i: 0, b: e.b, s: "", items: [Int]{}})
        "str" -> Ok(str_value(e.s))
        "copy" -> Ok(lookup(m, e.s))
        "var" -> Ok(lookup(m, e.s))
        "strfmt" -> within_limits(str_value(format(m, g, e.args) ?? return Err(err)))
        "neg" -> checked_int(-(eval(m, g, e.l) ?? return Err(err)).i)
        "not" -> Ok(Value{k: "bool", i: 0, b: !(eval(m, g, e.l) ?? return Err(err)).b, s: "", items: [Int]{}})
        "len" -> {
            value: lookup(m, e.s)
            Ok(int_value(if value.k == "str" -> value.s.len() else -> value.items.len()))
        }
        "field" -> Ok(int_value(lookup(m, e.s).items[field_index(g, e.op)]))
        "index" -> {
            list: lookup(m, e.s)
            i: (eval(m, g, e.l) ?? return Err(err)).i
            if i < 0 || i >= list.items.len() -> return Err(reject("index"))
            Ok(int_value(list.items[i]))
        }
        "call" -> call_fn(m, g, e)
        "ifx" -> {
            loop i in 0..<e.conds.len() {
                if (eval(m, g, e.conds[i]) ?? return Err(err)).b -> return eval(m, g, e.vals[i])
            }
            eval(m, g, e.r)
        }
        "list" -> Ok(items_value("list", eval_all(m, g, e.args) ?? return Err(err)))
        "struct" -> Ok(items_value("struct", eval_all(m, g, e.args) ?? return Err(err)))
        else -> eval_bin(m, g, e)
    }
}

eval_bin: fn(m: &Machine, g: Gen, e: Expr) -> Value Reject! {
    left: eval(m, g, e.l) ?? return Err(err)
    if e.op == "&&" && !left.b -> return Ok(left)
    if e.op == "||" && left.b -> return Ok(left)
    right: eval(m, g, e.r) ?? return Err(err)
    if e.op == "&&" || e.op == "||" -> return Ok(right)
    arith(e.op, left, right)
}

eval_all: fn(m: &Machine, g: Gen, args: [Int]) -> [Int] Reject! {
    out := [Int]{}
    loop arg in args -> out.push((eval(m, g, arg) ?? return Err(err)).i)
    Ok(out)
}

format: fn(m: &Machine, g: Gen, parts: [Int]) -> String Reject! {
    out := ""
    loop part in parts {
        if g.exprs[part].k == "text" {
            out = "{out}{g.exprs[part].s}"
            next
        }
        value: eval(m, g, part) ?? return Err(err)
        out = "{out}{show(g, value)}"
    }
    Ok(out)
}

field_index: fn(g: Gen, f: String) -> Int Never! {
    loop i in 0..<g.fields.len() {
        if g.fields[i] == f -> return i
    }
    panic("model: no field {f}")
}

call_fn: fn(m: &Machine, g: Gen, e: Expr) -> Value Reject! {
    found := -1
    loop i in 0..<g.fns.len() {
        if g.fns[i].name == e.s -> found = i
    }
    if found < 0 -> panic("model: no function {e.s}")
    f: g.fns[found]
    args := [Value]{}
    loop arg in e.args -> args.push(eval(m, g, arg) ?? return Err(err))
    m.depth += 1
    if m.depth > 64 -> return Err(reject("depth"))
    saved: m.base
    m.base = m.names.len()
    open_scope(m)
    loop i in 0..<f.params.len() -> define(m, g.vars[f.params[i]].name, args[i].copy())
    signal: exec(m, g, f.body) ?? return Err(err)
    close_scope(m)
    m.base = saved
    m.depth -= 1
    if signal.k != "return" -> panic("model: {f.name} fell off its end")
    Ok(signal.v)
}

update: fn(op: String, current: Value, value: Value) -> Value Reject! {
    if op == "=" -> return Ok(value)
    arith(op[0..<op.len() - 1], current, value)
}

exec: fn(m: &Machine, g: Gen, stmts: [Int]) -> Signal Reject! {
    loop at in stmts {
        signal: run_stmt(m, g, at) ?? return Err(err)
        if signal.k != "" -> return Ok(signal)
    }
    Ok(no_signal())
}

// A body in its own scope; `next` ends only this iteration.
scoped: fn(m: &Machine, g: Gen, stmts: [Int]) -> Signal Reject! {
    open_scope(m)
    signal: exec(m, g, stmts) ?? return Err(err)
    close_scope(m)
    Ok(signal)
}

run_stmt: fn(m: &Machine, g: Gen, at: Int) -> Signal Reject! {
    tick(m) ?? return Err(err)
    s: g.stmts[at]
    if s.k == {
        "decl" -> {
            value: eval(m, g, s.e) ?? return Err(err)
            define(m, g.vars[s.binding].name, value)
        }
        "assign" -> {
            value: eval(m, g, s.e) ?? return Err(err)
            where: slot(m, s.name)
            m.values[where] = update(s.op, m.values[where], value) ?? return Err(err)
        }
        "print" -> {
            value: eval(m, g, s.e) ?? return Err(err)
            emit(m, show(g, value)) ?? return Err(err)
        }
        "interp" -> {
            line: format_unchecked(m, g, s.parts) ?? return Err(err)
            emit(m, line) ?? return Err(err)
        }
        "push" -> {
            value: eval(m, g, s.e) ?? return Err(err)
            where: slot(m, s.name)
            m.values[where].items.push(value.i)
            if m.values[where].items.len() > 1000 -> return Err(reject("list size"))
        }
        "setidx" -> {
            where: slot(m, s.name)
            i: (eval(m, g, s.idx) ?? return Err(err)).i
            value: eval(m, g, s.e) ?? return Err(err)
            if i < 0 || i >= m.values[where].items.len() -> return Err(reject("index"))
            updated: update(s.op, int_value(m.values[where].items[i]), value) ?? return Err(err)
            m.values[where].items[i] = updated.i
        }
        "setfield" -> {
            value: eval(m, g, s.e) ?? return Err(err)
            where: slot(m, s.name)
            f: field_index(g, s.f)
            updated: update(s.op, int_value(m.values[where].items[f]), value) ?? return Err(err)
            m.values[where].items[f] = updated.i
        }
        "break" -> return Ok(Signal{k: "break", v: int_value(0)})
        "next" -> return Ok(Signal{k: "next", v: int_value(0)})
        "return" -> return Ok(Signal{k: "return", v: eval(m, g, s.e) ?? return Err(err)})
        "if" -> {
            loop i in 0..<s.conds.len() {
                if (eval(m, g, s.conds[i]) ?? return Err(err)).b -> return scoped(m, g, s.bodies[i])
            }
            if s.has_otherwise -> return scoped(m, g, s.otherwise)
        }
        "range" -> return run_range(m, g, s)
        "while" -> return run_while(m, g, s)
        "foreach" -> return run_foreach(m, g, s)
        else -> panic("model: {s.k}")
    }
    Ok(no_signal())
}

// An interpolated print: its text has no String bound.
format_unchecked: fn(m: &Machine, g: Gen, parts: [Int]) -> String Reject! { format(m, g, parts) }

// What one loop iteration's signal does: "" continues, "break" stops the
// loop, anything else leaves the loop with that signal.
iteration: fn(signal: Signal) -> String Never! {
    if signal.k == "next" -> return ""
    signal.k.copy()
}

run_range: fn(m: &Machine, g: Gen, s: Stmt) -> Signal Reject! {
    lo: (eval(m, g, s.lo) ?? return Err(err)).i
    top: (eval(m, g, s.hi) ?? return Err(err)).i
    hi: if s.inclusive -> top + 1 else -> top
    i := lo
    loop i < hi {
        tick(m) ?? return Err(err)
        open_scope(m)
        define(m, s.name, int_value(i))
        signal: exec(m, g, s.body) ?? return Err(err)
        close_scope(m)
        if iteration(signal) == {
            "" -> {}
            "break" -> return Ok(no_signal())
            else -> return Ok(signal)
        }
        i += 1
    }
    Ok(no_signal())
}

run_while: fn(m: &Machine, g: Gen, s: Stmt) -> Signal Reject! {
    where: slot(m, s.name)
    loop m.values[where].i < s.limit {
        tick(m) ?? return Err(err)
        m.values[where] = int_value(m.values[where].i + 1)
        signal: scoped(m, g, s.body) ?? return Err(err)
        if iteration(signal) == {
            "" -> {}
            "break" -> return Ok(no_signal())
            else -> return Ok(signal)
        }
    }
    Ok(no_signal())
}

run_foreach: fn(m: &Machine, g: Gen, s: Stmt) -> Signal Reject! {
    items: lookup(m, s.name).items
    loop i in 0..<items.len() {
        tick(m) ?? return Err(err)
        open_scope(m)
        if s.index != "" -> define(m, s.index, int_value(i))
        define(m, s.item, int_value(items[i]))
        signal: exec(m, g, s.body) ?? return Err(err)
        close_scope(m)
        if iteration(signal) == {
            "" -> {}
            "break" -> return Ok(no_signal())
            else -> return Ok(signal)
        }
    }
    Ok(no_signal())
}

new_machine: fn() -> Machine Never! {
    Machine{names: [String]{}, values: [Value]{}, marks: [Int]{}, base: 0, out: [String]{}, steps: 0, depth: 0}
}

// A program and its expected stdout, redrawn until the model accepts it.
generate_case: fn(seed: Int, index: Int) -> Case GateError! {
    loop attempt in 0..<ATTEMPTS {
        g := new_gen(seed_state("jet-safety-fuzz:{seed}:{index}:{attempt}"))
        program(g)
        m := new_machine()
        if exec(m, g, g.run) == .Err(_) -> next
        stdout: m.out.map(fn(line) { "{line}\n" }).join("")
        header: "Generated by Tools/agent/SafetyGate.jet: seed {seed}, case {index}, attempt {attempt}."
        return Ok(Case{stem: "", source: source(g, header), stdout: stdout, stderr: "", status: Val(0)})
    }
    Err(gate_fail("seed {seed} case {index}: no defined program in {ATTEMPTS} attempts"))
}

// A case number as at least four digits.
pad4: fn(index: Int) -> String Never! {
    digits: "{index}"
    if digits.len() >= 4 -> return digits
    "{"0".repeat(4 - digits.len())}{digits}"
}

// Stateful Core/runtime API stress, independently modeled without executing
// Jet. Keeps all indexes valid; invalid UTF-8 is a defined fallible decode,
// not UB.
generate_core_case: fn(seed: Int, index: Int) -> Case Never! {
    rng := new_gen(seed_state("jet-core-safety-fuzz:{seed}:{index}"))
    statements := [String]{"m := [String:Int]{{}}", "xs := [Int]{{}}"}
    output := [String]{}
    map := [String: Int]{}
    list := [Int]{}
    loop step in 0..<64 {
        key: "k{(draw(rng) * 8) /% WORD}"
        value: (draw(rng) * 1000) /% WORD
        if step % 4 == {
            0 -> {
                statements.push("m[\"{key}\"] = {value}")
                statements.push("&xs.push({value})")
                map[key] = value
                list.push(value)
            }
            1 -> {
                statements.push("print(m.get(\"{key}\") ?? -1)")
                statements.push("print(xs.len())")
                output.push("{map.get(key) ?? -1}")
                output.push("{list.len()}")
            }
            2 -> {
                statements.push("print((&m.pop(\"{key}\")) ?? -1)")
                statements.push("print((&xs.pop()) ?? -1)")
                output.push("{map.pop(key) ?? -1}")
                output.push("{list.pop() ?? -1}")
            }
            else -> {
                statements.push("saved{step}: xs.copy()")
                statements.push("&xs.push({value})")
                statements.push("print(saved{step}.len())")
                statements.push("print(xs.len())")
                output.push("{list.len()}")
                output.push("{list.len() + 1}")
                list.push(value)
            }
        }
    }
    count: 1 + (draw(rng) * 32) /% WORD
    bytes := [Int]{}
    loop _ in 0..<count -> bytes.push(65 + (draw(rng) * 26) /% WORD)
    statements.push("print(String.from_bytes([U8]{{{bytes.map(fn(b) { "{b}" }).join(", ")}}}) ?? \"bad\")")
    output.push(String.from_bytes(bytes.map(fn(b) { checked(U8{b}) ?? U8{0} })) ?? "")
    invalid: [[Int]]{[Int]{255}, [Int]{128}, [Int]{226, 130}, [Int]{192, 175}, [Int]{237, 160, 128}, [Int]{244, 144, 128, 128}}
    loop sequence in invalid {
        statements.push("print(String.from_bytes([U8]{{{sequence.map(fn(b) { "{b}" }).join(", ")}}}) ?? \"invalid\")")
        output.push("invalid")
    }
    body: statements.map(fn(line) { "    {line}" }).join("\n")
    Case{
        stem: "",
        source: "// Core API fuzz: seed {seed}, case {index}\nrun: fn() {{\n{body}\n}}\n",
        stdout: output.map(fn(line) { "{line}\n" }).join(""),
        stderr: "",
        status: Val(0),
    }
}

// ---------------------------------------------------------------- gate

Corpus: struct {
    features: String
    cases: [Case]
    case_list: String
    sha256: String
}

Check: struct {
    name: String
    verdict: String
    detail: String
}

Verdict: struct {
    stem: String
    verdict: String
    detail: String
}

Entry: struct {
    path: String
    stem: String
}

hash: fn(bytes: [U8]) -> String Never! { crypto.sha256(bytes).hex() }

slug: fn(stem: String) -> String Never! {
    out := [U8]{}
    open := false
    loop byte in stem.bytes() {
        code: Int{byte}
        word: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 45
        if word {
            out.push(byte)
            open = false
            next
        }
        if !open -> out.push(U8{95})
        open = true
    }
    String.from_bytes(out) ?? ""
}

prepare_corpus: fn(out: String, seed: Int, count: Int) -[FS]> Corpus GateError! {
    if count < 1 -> return Err(gate_fail("seed/count must be integers; count must be positive"))
    features: "{out}/corpus/Examples/features"
    cases := [Case]{}
    digest := [U8]{}
    loop kind in ([String]{"fuzz", "core"}) {
        files.create_dir_all("{features}/{kind}") ?? return Err(gate_fail("`{features}/{kind}` cannot be created: {err}"))
        files.create_dir_all("{features}/expected/{kind}") ?? return Err(gate_fail("`{features}/expected/{kind}` cannot be created: {err}"))
        loop index in 0..<count {
            stem: "{kind}/s{seed}_{pad4(index)}"
            made: if kind == "fuzz" -> generate_case(seed, index) ?? return Err(err) else -> generate_core_case(seed, index)
            files.write("{features}/{stem}.jet", made.source) ?? return Err(gate_fail("`{stem}.jet` cannot be written: {err}"))
            files.write("{features}/expected/{stem}.out", made.stdout) ?? return Err(gate_fail("`{stem}.out` cannot be written: {err}"))
            loop part in ([String]{stem, made.source, made.stdout}) {
                digest.extend(part.bytes())
                digest.push(U8{0})
            }
            cases.push(Case{stem: stem.copy(), source: made.source.copy(), stdout: made.stdout.copy(), stderr: "", status: Val(0)})
        }
    }
    case_list: "{out}/fuzz.cases"
    files.write(case_list, "{cases.map(fn(c) { c.stem.copy() }).join("\n")}\n") ?? return Err(gate_fail("`{case_list}` cannot be written: {err}"))
    Ok(Corpus{features: features, cases: cases, case_list: case_list, sha256: hash(digest)})
}

// The golden entries under Examples, as kit_golden_collect
// (Compiler/JetTestKit/Source/Golden.jet) finds them: every flat `.jet` is an
// entry, a `run.jet` folder is one entry, and a package or workspace folder
// without `run.jet` is not an entry.
collect_golden_entries: fn(examples: String) -[FS]> [Entry] Never! {
    entries := [Entry]{}
    if files.is_dir(examples) -> visit(examples, examples, entries)
    entries.sort_by(fn(left: Entry, right: Entry) { left.stem <=> right.stem })
    entries
}

visit: fn(root: String, dir: String, entries: &[Entry]) -[FS]> () {
    children := files.list_dir(dir) ?? return
    children.sort_by(fn(left: DirEntry, right: DirEntry) { left.name <=> right.name })
    loop child in children {
        if child.name.starts_with(".") -> next
        path: "{dir}/{child.name}"
        if child.is_dir {
            if files.exists("{path}/run.jet") {
                entries.push(Entry{path: "{path}/run.jet", stem: relative(root, path)})
                next
            }
            if !files.exists("{path}/package.jet") && !files.exists("{path}/workspace.jet") -> visit(root, path, entries)
            next
        }
        if child.name.ends_with(".jet") && child.name != "package.jet" && child.name != "workspace.jet" {
            entries.push(Entry{path: path.copy(), stem: relative(root, path).removesuffix(".jet")})
        }
    }
}

relative: fn(root: String, path: String) -> String Never! { path.removeprefix("{root}/") }

// The first two tab-separated columns of each nonempty line.
columns: fn(text: String) -> [String: String] Never! {
    out := [String: String]{}
    loop line in text.trim().split("\n").to_list() {
        if line == "" -> next
        cells: line.split("\t").to_list()
        out[cells[0]] = if cells.len() > 1 -> cells[1].copy() else -> ""
    }
    out
}

falsy: fn(value: Dyn) -> Bool Never! {
    if value == {
        .Null -> true
        .Bool(flag) -> !flag
        .Text(word) -> word == ""
        .Int(number) -> number == 0
        .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> false
    }
}

// The native run left all three of a case's output files.
has_outputs: fn(base: String) -[FS]> Bool Never! {
    loop ext in ([String]{".stdout", ".stderr", ".status.json"}) {
        if !files.exists("{base}{ext}") -> return false
    }
    true
}

compare_native: fn(directory: String, cases: [Case]) -[FS]> [Verdict] Never! {
    rows: columns(files.read("{directory}/results.tsv") ?? "")
    out := [Verdict]{}
    loop c in cases {
        base: "{directory}/run/{slug(c.stem)}"
        result: rows.get(c.stem) ?? "absent"
        if ([String]{"wrong", "lower-crash", "convert-error"}).contains(result) {
            out.push(Verdict{stem: c.stem.copy(), verdict: "fail", detail: "native result {result}"})
            next
        }
        missing: !has_outputs(base)
        if result != "pass" || missing {
            out.push(Verdict{stem: c.stem.copy(), verdict: "gap", detail: "native result {result}"})
            next
        }
        actual: json.parse(files.read("{base}.status.json") ?? "") ?? Dyn.Null
        status: int_field(actual, "status")
        stdout: files.read("{base}.stdout") ?? ""
        stderr: files.read("{base}.stderr") ?? ""
        differs: status != c.status || !falsy(field(actual, "signal")) || !falsy(field(actual, "error")) || stdout != c.stdout || stderr != c.stderr
        if differs {
            shown: if status == .Val(code) -> "{code}" else -> "null"
            out.push(Verdict{stem: c.stem.copy(), verdict: "fail", detail: "model/golden differs (status {shown})"})
            next
        }
        out.push(Verdict{stem: c.stem.copy(), verdict: "pass", detail: "model/golden agrees"})
    }
    out
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

int_field: fn(tree: Dyn, name: String) -> Int? Never! {
    if field(tree, name) == {
        .Int(value) -> Val(value)
        .Number(lexeme) -> Val(Int.parse(lexeme) ?? return None)
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> None
    }
}

// An additional-coverage receipt counts only when it is hashed, names this
// head and coverage, passes and checked a positive number of cases.
coverage_receipt: fn(input: Dyn, head: String, coverage: String) -[FS]> Bool Never! {
    path: text_field(input, "receipt")
    if path == "" || text_field(input, "sha256") == "" || !files.exists(path) -> return false
    bytes: files.read_bytes(path) ?? return false
    receipt: json.parse(String.from_bytes(bytes) ?? return false) ?? return false
    checked_cases: int_field(receipt, "checked_cases") ?? return false
    failures_empty: if field(receipt, "failures") == .Array(items) -> items.len() == 0 else -> false
    hash(bytes) == text_field(input, "sha256") && text_field(receipt, "head") == head && text_field(receipt, "coverage") == coverage
        && text_field(receipt, "verdict") == "PASS" && checked_cases > 0 && checked_cases <= 9007199254740991 && failures_empty
}

Gate: struct {
    out: String
    repo: String
    checks: [Check]
    gaps: [String]
}

add: fn(gate: &Gate, name: String, verdict: String, detail: String) -> () {
    gate.checks.push(Check{name: name.copy(), verdict: verdict.copy(), detail: detail.copy()})
}

Ran: struct {
    code: Int
    detail: String
    output: String
}

// Run `argv` in the checkout and keep its whole output in OUT/<name>.log.
command: fn(gate: Gate, name: String, argv: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Never! {
    log: "{gate.out}/{name}.log"
    receipt: process.cmd(argv).cwd(gate.repo).timeout(time.duration_ms(CHECK_TIMEOUT_MS)).output_limit(67108864).run() ?? {
        files.write(log, "{err}\n") ?? ()
        return Ran{code: -1, detail: "error {err}", output: ""}
    }
    output: "{receipt.output}{receipt.errors}"
    files.write(log, output) ?? ()
    detail: if receipt.signal != None || receipt.timed_out -> "signal" else -> "exit {receipt.code}"
    code: if receipt.signal != None || receipt.timed_out -> -1 else -> receipt.code
    Ran{code: code, detail: detail, output: output}
}

occurrences: fn(haystack: String, needle: String) -> Int Never! { haystack.split(needle).to_list().len() - 1 }

// The two unsafe-wrapper fixtures must each report exactly their
// jet.UnsafeCallOutsideUnsafe diagnostics and exit 1.
wrapper_fixtures: fn(gate: &Gate, jet: String, checker_head: String, head: String) -[Env, Exec, FS, IO, Time, Time.Wait]> () {
    loop i in 0..<WRAPPER_FIXTURES.len() {
        fixture: WRAPPER_FIXTURES[i]
        expected: WRAPPER_DIAGNOSTICS[i]
        if jet == "" || !files.exists(jet) || checker_head != head {
            add(gate, fixture, "gap", "no exact-head admitted checker")
            next
        }
        check: command(gate, fixture, [String]{jet, "check", "{gate.repo}/tests/ui/{fixture}.jet"})
        found: occurrences(check.output, UNSAFE_DIAGNOSTIC)
        verdict: if check.code == 1 && found == expected -> "pass" else -> "fail"
        add(gate, fixture, verdict, "{check.detail}; {found}/{expected} jet.UnsafeCallOutsideUnsafe; {fixture}.log")
    }
}

golden_area: fn(stem: String) -> Bool Never! {
    loop area in GOLDEN_AREAS {
        if stem.starts_with(area) -> return true
    }
    false
}

golden_cases: fn(repo: String) -[FS]> [Case] Never! {
    out := [Case]{}
    loop entry in collect_golden_entries("{repo}/Examples") {
        if !golden_area(entry.stem) -> next
        expected: files.read("{repo}/Examples/{entry.stem}.out") ?? next
        stderr: files.read("{repo}/Examples/{entry.stem}.stderr.out") ?? ""
        out.push(Case{stem: entry.stem.copy(), source: files.read(entry.path) ?? "", stdout: expected, stderr: stderr, status: Val(0)})
    }
    out
}

// JSON.stringify's string form: quotes, backslashes and control characters
// escaped, everything else as is.
json_text: fn(value: String) -> String Never! {
    out := [U8]{U8{34}}
    loop byte in value.bytes() {
        code: Int{byte}
        escape: if code == {
            34 -> "\\\""
            92 -> "\\\\"
            8 -> "\\b"
            12 -> "\\f"
            10 -> "\\n"
            13 -> "\\r"
            9 -> "\\t"
            else -> if code < 32 -> "\\u00{hex_byte(code)}" else -> ""
        }
        if escape == "" {
            out.push(byte)
            next
        }
        out.extend(escape.bytes())
    }
    out.push(U8{34})
    String.from_bytes(out) ?? ""
}

hex_byte: fn(code: Int) -> String Never! {
    digits: "0123456789abcdef"
    "{digits[code /% 16..<code /% 16 + 1]}{digits[code % 16..<code % 16 + 1]}"
}

// The golden corpus digest: sha256 of the case list in JSON.stringify form.
golden_digest: fn(cases: [Case]) -> String Never! {
    rows: cases.map(fn(c) { "{{\"stem\":{json_text(c.stem)},\"stdout\":{json_text(c.stdout)},\"stderr\":{json_text(c.stderr)},\"source\":{json_text(c.source)}}}" })
    hash("[{rows.join(",")}]".bytes())
}

run_gate: fn(out: String, artifacts: String, seed: Int, count: Int, mode: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int GateError! {
    files.create_dir_all(out) ?? return Err(gate_fail("`{out}` cannot be created: {err}"))
    // Delete neither caller-owned artifacts nor historical receipts; every run has a unique out.
    if files.exists("{out}/safety-summary.json") -> return Err(gate_fail("receipt already exists: {out}"))
    repo: repo_root()
    bytes: files.read_bytes(artifacts) ?? return Err(gate_fail("`{artifacts}` cannot be read: {err}"))
    manifest: json.parse(String.from_bytes(bytes) ?? return Err(gate_fail("`{artifacts}` is not UTF-8"))) ?? return Err(gate_fail("`{artifacts}` is not JSON"))
    head: text_field(manifest, "dev_head")
    if !admitted_head(head) -> return Err(gate_fail("artifacts must name an admitted dev_head"))
    gate := Gate{out: out.copy(), repo: repo.copy(), checks: [Check]{}, gaps: [String]{}}
    pin: command(gate, "source-pin", [String]{"git", "rev-parse", "HEAD"})
    if pin.code != 0 -> return Err(gate_fail("cannot identify safety source tree"))
    source_head: pin.output.trim()
    if !source_head.starts_with(head) -> gate.gaps.push("artifact head {head} differs from audited source {source_head}")
    corpus: prepare_corpus(out, seed, count) ?? return Err(err)
    summary := [String: Dyn]{
        "schema": Dyn.Text("jet-native-safety-v1"),
        "head": Dyn.Text(head.copy()),
        "artifacts_sha256": Dyn.Text(hash(bytes)),
        "seed": Dyn.Int(seed),
        "count": Dyn.Int(count),
        "source_head": Dyn.Text(source_head.copy()),
        "corpus_sha256": Dyn.Text(corpus.sha256.copy()),
        "corpus_features": Dyn.Text(corpus.features.copy()),
    }
    if mode == "prepare" {
        print(json.to_string_pretty(Dyn.Object(summary.copy())) ?? return Err(gate_fail("the summary cannot be encoded: {err}")))
        return Ok(0)
    }

    // The registry can retain an older release binary while the current head's
    // debug compiler is admitted. Core source is embedded; stale release output
    // cannot prove the audited wrappers. Native admission may bind a checker.
    native: field(manifest, "native_safety")
    checker: checker_of(manifest, native, head)
    jet: text_field(checker, "path")
    summary["checker"] = checker.copy()
    // Ratchet's lower-count mode rewrites its baseline. Use a private baseline copy.
    baseline: "{out}/safety-baseline.md"
    files.write(baseline, files.read("{repo}/Docs/spec/safety.md") ?? return Err(gate_fail("Docs/spec/safety.md cannot be read: {err}"))) ?? return Err(gate_fail("`{baseline}` cannot be written: {err}"))
    if jet == "" || !files.exists(jet) {
        add(gate, "core-unsafe-audit", "gap", "no admitted checker to run Tools/agent/UnsafeRatchet.jet")
    }
    if jet != "" && files.exists(jet) {
        audit: command(gate, "core-audit", [String]{jet, "{repo}/Tools/agent/UnsafeRatchet.jet", "--baseline", baseline})
        add(gate, "core-unsafe-audit", if audit.code == 0 -> "pass" else -> "fail", "{audit.detail}; core-audit.log")
    }
    wrapper_fixtures(gate, jet, text_field(checker, "head"), head)

    goldens: golden_cases(repo)
    golden_hash: golden_digest(goldens)
    golden_list: "{out}/golden.cases"
    files.write(golden_list, "{goldens.map(fn(c) { c.stem.copy() }).join("\n")}\n") ?? return Err(gate_fail("`{golden_list}` cannot be written: {err}"))
    summary["golden_sha256"] = Dyn.Text(golden_hash.copy())
    summary["golden_count"] = Dyn.Int(goldens.len())
    if goldens.len() == 0 -> add(gate, "golden-corpus", "fail", "empty golden coverage")
    loop tier in TIERS {
        tier_input: field(field(native, "tiers"), tier)
        native_tier(gate, head, seed, count, tier, "fuzz", field(tier_input, "fuzz"), corpus.cases, corpus.sha256)
        native_tier(gate, head, seed, count, tier, "golden", field(tier_input, "golden"), goldens, golden_hash)
    }
    // No native producer provides these today; never call ASan full I1 proof.
    loop gap in ADDITIONAL_COVERAGE {
        if !coverage_receipt(field(field(native, "additional_coverage"), gap), head, gap) -> gate.gaps.push(gap.copy())
    }
    loop c in gate.checks {
        if c.verdict == "gap" -> gate.gaps.push("{c.name}: {c.detail}")
    }
    failures: gate.checks.filter(fn(c) { c.verdict == "fail" })
    verdict: if failures.len() > 0 -> "FAIL" else -> if gate.gaps.len() > 0 -> "GAP" else -> "PASS"
    code: if failures.len() > 0 -> 1 else -> if gate.gaps.len() > 0 -> 3 else -> 0
    summary["checks"] = Dyn.Array(gate.checks.map(fn(c) { check_tree(c) }))
    summary["gaps"] = Dyn.Array(gate.gaps.map(fn(gap) { Dyn.Text(gap.copy()) }))
    summary["failures"] = Dyn.Array(failures.map(fn(c) { check_tree(c) }))
    summary["verdict"] = Dyn.Text(verdict)
    summary["exit_code"] = Dyn.Int(code)
    document: json.to_string_pretty(Dyn.Object(summary.copy())) ?? return Err(gate_fail("the summary cannot be encoded: {err}"))
    files.write("{out}/safety-summary.json", "{document}\n") ?? return Err(gate_fail("the summary cannot be written: {err}"))
    report := [String]{"gate: {verdict}", "head: {head}", "seed: {seed}; generated cases: {count * 2}; goldens: {goldens.len()}"}
    loop c in failures -> report.push("FAIL {c.name}: {c.detail}")
    loop gap in gate.gaps -> report.push("GAP {gap}")
    files.write("{out}/safety-summary.txt", "{report.join("\n")}\n") ?? return Err(gate_fail("the summary text cannot be written: {err}"))
    print(document)
    Ok(code)
}

admitted_head: fn(head: String) -> Bool Never! {
    if head.len() < 7 || head.len() > 40 -> return false
    head.bytes().all(fn(byte) { (Int{byte} >= 48 && Int{byte} <= 57) || (Int{byte} >= 97 && Int{byte} <= 102) })
}

checker_of: fn(manifest: Dyn, native: Dyn, head: String) -> Dyn Never! {
    bound: field(native, "checker")
    if bound == .Object(_) -> return bound
    debug: text_field(manifest, "debug_jet")
    path: if debug != "" -> debug else -> text_field(manifest, "release_jet")
    Dyn.Object([String: Dyn]{"path": Dyn.Text(path), "head": Dyn.Text(head.copy())})
}

check_tree: fn(c: Check) -> Dyn Never! {
    Dyn.Object([String: Dyn]{"name": Dyn.Text(c.name.copy()), "verdict": Dyn.Text(c.verdict.copy()), "detail": Dyn.Text(c.detail.copy())})
}

// One admitted native tier output for one case family.
native_tier: fn(gate: &Gate, head: String, seed: Int, count: Int, tier: String, kind: String, input: Dyn, cases: [Case], digest: String) -[FS]> () {
    name: "{tier}-{kind}"
    directory: text_field(input, "directory")
    if directory == "" -> return add(gate, name, "gap", "no admitted native producer output")
    receipt: json.parse(files.read("{directory}/native-safety-input.json") ?? return add(gate, name, "gap", "native-safety-input.json cannot be read")) ?? return add(gate, name, "gap", "native-safety-input.json is not JSON")
    bound: text_field(receipt, "head") == head && text_field(receipt, "backend") == "jet-native" && text_field(receipt, "tier") == tier
        && text_field(receipt, "corpus_sha256") == digest && (int_field(receipt, "seed") ?? -1) == seed && (int_field(receipt, "count") ?? -1) == count
    if !bound -> return add(gate, name, "gap", "native provenance/corpus/seed mismatch")
    loop row in compare_native(directory, cases) -> add(gate, "{name}/{row.stem}", row.verdict, row.detail)
    lint: columns(files.read("{directory}/lint.tsv") ?? "")
    loop c in cases {
        if !lint.has_key(c.stem) {
            add(gate, "{name}-lint/{c.stem}", "gap", "no independent IR Lint receipt")
            next
        }
        state: lint.get(c.stem) ?? ""
        verdict: if state == "clean" -> "pass" else -> "fail"
        detail: if state == "" -> "no independent IR Lint receipt" else -> state.copy()
        add(gate, "{name}-lint/{c.stem}", verdict, detail)
    }
    runtime: field(input, "runtime")
    library: text_field(runtime, "library")
    library_hash: if library != "" && files.exists(library) -> hash(files.read_bytes(library) ?? [U8]{}) else -> ""
    negative: field(runtime, "negative_control")
    admitted: library_hash != "" && library_hash == text_field(runtime, "sha256") && text_field(runtime, "head") == head
        && text_field(runtime, "instrumentation") == "address" && text_field(negative, "receipt") != ""
    if !admitted -> return add(gate, "{name}-runtime", "gap", "missing exact-head instrumented runtime archive/negative control")
    if !negative_control(negative, head, library_hash) -> return add(gate, "{name}-negative-control", "gap", "ASan/LSan negative-control receipt incomplete or stale")
    language: text_field(runtime, "language")
    if language != "Jet" -> add(gate, "{name}-rust-free-runtime", "gap", "runtime language {if language == "" -> "unspecified" else -> language}")
    if text_field(receipt, "frontend_language") != "Jet" || text_field(receipt, "compiler_language") != "Jet" {
        add(gate, "{name}-rust-free-compiler", "gap", "compiler/front-end still depends on Rust")
    }
    add(gate, "{name}-sanitize", "gap", "no native code sanitizer on the JetIR backend")
}

negative_control: fn(negative: Dyn, head: String, runtime_sha256: String) -[FS]> Bool Never! {
    bytes: files.read_bytes(text_field(negative, "receipt")) ?? return false
    receipt: json.parse(String.from_bytes(bytes) ?? return false) ?? return false
    detected: if field(receipt, "detected") == .Array(items) -> items.map(fn(item) { if item == .Text(word) -> word.copy() else -> "" }) else -> [String]{}
    hash(bytes) == text_field(negative, "sha256") && text_field(receipt, "head") == head && text_field(receipt, "runtime_sha256") == runtime_sha256
        && ([String]{"heap-buffer-overflow", "heap-use-after-free", "leak"}).all(fn(kind) { detected.contains(kind) })
}

// The VerifyFull leg: the wrapper fixtures under `jet` and the generated
// corpus, which the model must define in full.
run_source: fn(out: String, jet: String, seed: Int, count: Int) -[Env, Exec, FS, IO, Time, Time.Wait]> Int GateError! {
    files.create_dir_all(out) ?? return Err(gate_fail("`{out}` cannot be created: {err}"))
    if files.exists("{out}/safety-summary.txt") -> return Err(gate_fail("receipt already exists: {out}"))
    gate := Gate{out: out.copy(), repo: repo_root(), checks: [Check]{}, gaps: [String]{}}
    wrapper_fixtures(gate, jet, "", "")
    corpus: prepare_corpus(out, seed, count) ?? return Err(err)
    add(gate, "corpus", "pass", "{corpus.cases.len()} model-defined cases; sha256 {corpus.sha256}")
    failures: gate.checks.filter(fn(c) { c.verdict != "pass" })
    verdict: if failures.len() > 0 -> "FAIL" else -> "PASS"
    report := [String]{"gate: {verdict} (source)", "seed: {seed}; generated cases: {count * 2}"}
    loop c in gate.checks -> report.push("{c.verdict.upper()} {c.name}: {c.detail}")
    text: "{report.join("\n")}\n"
    files.write("{out}/safety-summary.txt", text) ?? return Err(gate_fail("the summary text cannot be written: {err}"))
    print(text.trim_end())
    Ok(if failures.len() > 0 -> 1 else -> 0)
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? return ""
    loop {
        if files.exists("{dir}{TOOL}") -> return dir
        if dir == "/" || dir == "" -> return ""
        dir = files.dirname(dir)
    }
}

number: fn(text: String, fallback: Int) -> Int GateError! {
    if text == "" -> return Ok(fallback)
    Ok(Int.parse(text) ?? return Err(gate_fail("seed/count must be integers; count must be positive")))
}

safety_main: fn(args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int GateError! {
    if args.len() > 0 && args[0] == "--source" {
        if args.len() < 3 || args.len() > 5 -> return Err(gate_fail(USAGE))
        seed: number(if args.len() > 3 -> args[3] else -> "", DEFAULT_SEED) ?? return Err(err)
        count: number(if args.len() > 4 -> args[4] else -> "", DEFAULT_COUNT) ?? return Err(err)
        return run_source(absolute(args[1]), args[2], seed, count)
    }
    if args.len() < 2 || args.len() > 5 || (args.len() == 5 && args[4] != "--prepare") -> return Err(gate_fail(USAGE))
    seed: number(if args.len() > 2 -> args[2] else -> "", DEFAULT_SEED) ?? return Err(err)
    count: number(if args.len() > 3 -> args[3] else -> "", DEFAULT_COUNT) ?? return Err(err)
    mode: if args.len() == 5 -> "prepare" else -> "gate"
    run_gate(absolute(args[0]), args[1], seed, count, mode)
}

absolute: fn(path: String) -[Env, FS]> String Never! { files.absolute(path) ?? path.copy() }

run: fn() {
    code: safety_main(process.args()) ?? process.fail(2, "safety-gate: {err.message}")
    process.exit(code)
}

// ---------------------------------------------------------------- tests

scratch: fn(name: String) -[Env, FS, Time]> String Never! {
    base: process.env_get("JET_TEST_SCRATCH_DIR") ?? process.env_get("TMPDIR") ?? "/tmp"
    dir: "{base}/safety-gate-{name}-{sys.pid()}-{time.unix_ns()}"
    files.create_dir_all(dir) ?? panic("{dir}: {err}")
    dir
}

native_result: fn(dir: String, stem: String, verdict: String, stdout: String, stderr: String, status: String) -[FS]> () {
    files.create_dir_all("{dir}/run") ?? panic("run: {err}")
    files.write("{dir}/results.tsv", "{stem}\t{verdict}\tfixture\n") ?? panic("results: {err}")
    base: "{dir}/run/{slug(stem)}"
    files.write("{base}.stdout", stdout) ?? panic("stdout: {err}")
    files.write("{base}.stderr", stderr) ?? panic("stderr: {err}")
    files.write("{base}.status.json", "{{\"status\":{status},\"signal\":null,\"error\":null}}") ?? panic("status: {err}")
}

#Test("native O0/O1/O2 are required, with independent output/status/stderr checks") {
    assert_eq(TIERS, [String]{"O0", "O1", "O2"})
    dir: scratch("native")
    cases: [Case]{Case{stem: "core/case", source: "", stdout: "ok\n", stderr: "", status: Val(0)}}
    assert_eq(compare_native(dir, cases)[0].verdict, "gap")
    native_result(dir, "core/case", "unsupported", "ok\n", "", "0")
    assert_eq(compare_native(dir, cases)[0].verdict, "gap")
    native_result(dir, "core/case", "wrong", "ok\n", "", "0")
    assert_eq(compare_native(dir, cases)[0].verdict, "fail")
    native_result(dir, "core/case", "pass", "ok\n", "", "0")
    assert_eq(compare_native(dir, cases)[0].verdict, "pass")
    loop bad in ([[String]]{[String]{"bad\n", "", "0"}, [String]{"ok\n", "bad\n", "0"}, [String]{"ok\n", "", "70"}, [String]{"ok\n", "", "null"}}) {
        native_result(dir, "core/case", "pass", bad[0], bad[1], bad[2])
        assert_eq(compare_native(dir, cases)[0].verdict, "fail")
    }
    assert_eq(slug("a/b c.d"), "a_b_c_d")
    files.remove_all(dir) ?? ()
}

#Test("seed-4 model cannot exceed String bounds; Core API programs deterministic and distinct") {
    loop index in 0..<200 {
        made: generate_case(4, index) ?? panic(err.message)
        assert(made.source.contains("run: fn("))
        assert(made.stdout.len() < 2000000)
    }
    made: generate_core_case(4, 0)
    again: generate_core_case(4, 0)
    assert_eq(made.source, again.source)
    assert_eq(made.stdout, again.stdout)
    assert(made.source != generate_core_case(5, 0).source)
    assert(made.source.contains("String.from_bytes"))
    assert(made.source.contains("m.pop"))
    assert(made.source.contains("saved3: xs.copy()"))
    assert_eq(made.stdout.split("\n").to_list().filter(fn(line) { line == "invalid" }).len(), 6)
}

#Test("the generator draws mulberry32 from the sha256 key and keeps exact i64 bounds") {
    rng := new_gen(seed_state("a"))
    assert_eq(rng.state, 310482890)
    first: draw(rng)
    assert(first >= 0 && first <= MASK)
    assert_eq(I64_MAX + 1, 1 << 63)
    assert(checked_int(I64_MAX + 1) == .Err(_))
    assert_eq((arith("%", int_value(-7), int_value(2)) ?? panic("mod")).i, 1)
    assert_eq((arith("%%", int_value(-7), int_value(2)) ?? panic("rem")).i, -1)
    assert_eq((arith("/%", int_value(-7), int_value(2)) ?? panic("div")).i, -4)
    assert(arith("%", int_value(I64_MIN), int_value(-1)) == .Err(_))
}

#Test("corpus digest binds model, source, seed and case count") {
    a: prepare_corpus(scratch("a"), 4, 3) ?? panic(err.message)
    b: prepare_corpus(scratch("b"), 4, 3) ?? panic(err.message)
    c: prepare_corpus(scratch("c"), 5, 3) ?? panic(err.message)
    assert_eq(a.cases.len(), 6)
    assert_eq(a.sha256, b.sha256)
    assert(a.sha256 != c.sha256)
    listed: files.read(a.case_list) ?? panic("case list")
    assert_eq(listed.trim().split("\n").to_list().len(), 6)
    assert(prepare_corpus(scratch("zero"), 4, 0) == .Err(_))
    assert(number("1.5", 0) == .Err(_))
    loop corpus in ([Corpus]{a, b, c}) -> files.remove_all(files.dirname(files.dirname(files.dirname(corpus.features)))) ?? ()
}

#Test("additional coverage requires exact-head hashed nonempty passing evidence") {
    dir: scratch("coverage")
    path: "{dir}/coverage.json"
    files.write(path, "{{\"head\":\"abcdef123\",\"coverage\":\"stack\",\"verdict\":\"PASS\",\"checked_cases\":2,\"failures\":[]}}") ?? panic("write")
    input: receipt_input(path)
    assert(coverage_receipt(input, "abcdef123", "stack"))
    assert(!coverage_receipt(input, "old", "stack"))
    assert(!coverage_receipt(input, "abcdef123", "races"))
    assert(!coverage_receipt(Dyn.Object([String: Dyn]{"receipt": Dyn.Text(path.copy()), "sha256": Dyn.Text("wrong")}), "abcdef123", "stack"))
    files.write(path, "{{\"head\":\"abcdef123\",\"coverage\":\"stack\",\"verdict\":\"PASS\",\"checked_cases\":0,\"failures\":[]}}") ?? panic("write")
    assert(!coverage_receipt(receipt_input(path), "abcdef123", "stack"))
    files.remove_all(dir) ?? ()
}

receipt_input: fn(path: String) -[FS]> Dyn Never! {
    Dyn.Object([String: Dyn]{"receipt": Dyn.Text(path.copy()), "sha256": Dyn.Text(hash(files.read_bytes(path) ?? panic("read")))})
}

#Test("#4754 whole inline moved-payload/Option-unwrap/backedge class stays a required gate") {
    coverage: "inline moved-payload/Option-unwrap and backedge aliases"
    assert(ADDITIONAL_COVERAGE.contains(coverage))
    assert(!coverage_receipt(Dyn.Null, "abcdef123", coverage))
    dir: scratch("payload")
    path: "{dir}/payload-class.json"
    files.write(path, "{{\"head\":\"abcdef123\",\"coverage\":\"{coverage}\",\"verdict\":\"FAIL\",\"checked_cases\":2,\"failures\":[\"native UAF\"]}}") ?? panic("write")
    assert(!coverage_receipt(receipt_input(path), "abcdef123", coverage))
    files.write(path, "{{\"head\":\"abcdef123\",\"coverage\":\"{coverage}\",\"verdict\":\"PASS\",\"checked_cases\":2,\"failures\":[]}}") ?? panic("write")
    assert(coverage_receipt(receipt_input(path), "abcdef123", coverage))
    files.remove_all(dir) ?? ()
}

#Test("the golden digest is JSON.stringify of the case list") {
    control: String.from_bytes([U8]{U8{120}, U8{1}}) ?? panic("bytes")
    cases: [Case]{Case{stem: "Memory/a", source: "q\"\\\n\t", stdout: control, stderr: "", status: Val(0)}}
    assert_eq(json_text("q\"\\\n\t"), "\"q\\\"\\\\\\n\\t\"")
    assert_eq(json_text(control), "\"x\\u0001\"")
    assert_eq(golden_digest(cases), hash("[{{\"stem\":\"Memory/a\",\"stdout\":\"x\\u0001\",\"stderr\":\"\",\"source\":\"q\\\"\\\\\\n\\t\"}}]".bytes()))
}
