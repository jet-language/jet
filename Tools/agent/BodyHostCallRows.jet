#!/usr/bin/env jet
// Render BodyHostCall (Compiler/JetFoundation/Source/Facts/BodyHostCall.jet),
// the flat body's host-call enum, from its one declaration: THostCall in
// Compiler/JetSema/Source/Sema/Tree.jet. Sema's BodyFlatten.jet lowers the
// checked tree node for node, so each body variant is its tree variant with
// every checked child `TExpr` written as its BodyTree node index `Int`. The
// declaration is read as text: the lines from `THostCall: enum {` to the next
// line that is `}`, comments copied as written. A variant naming another tree
// type (`TLambda`, `TExprKind`) has no body form here and fails the render.
// Usage: jet Tools/agent/BodyHostCallRows.jet [--check|--write]
// --check fails when the generated file differs from the declaration; --write
// rewrites it.
use {
    files: core.files
    process: core.process
    term: core.term
}

SOURCE_PATH: "Compiler/JetSema/Source/Sema/Tree.jet"
OUTPUT_PATH: "Compiler/JetFoundation/Source/Facts/BodyHostCall.jet"
GENERATED_BY: "// This file is generated by Tools/agent/BodyHostCallRows.jet; do not edit."
SOURCE_OPEN: "THostCall: enum {{"
OUTPUT_OPEN: "BodyHostCall: enum {{"
// The checked child a body variant writes as its node index.
TREE_CHILD: "TExpr"
// Tree-side type names; each one but TREE_CHILD and the shared probe kind
// has no body form.
TREE_TYPE: Regex{"T[A-Z][A-Za-z0-9]*"}
SHARED_TREE_TYPE: "TOptionProbe"

#Error
BodyHostCallRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> BodyHostCallRowsError Never! {
    BodyHostCallRowsError{message: "body host call rows: {message}"}
}

// The body form of one line of the THostCall declaration.
body_host_call_line: fn(line: String, number: Int) -> String BodyHostCallRowsError! {
    if line.trim_start().starts_with("//") -> return Ok(line.copy())
    loop name in TREE_TYPE.find_all(line) {
        if name != TREE_CHILD && name != SHARED_TREE_TYPE -> return Err(rows_fail("{SOURCE_PATH}:{number} names `{name}`, a tree type with no body form"))
    }
    Ok(line.replace(TREE_CHILD, "Int"))
}

// The generated BodyHostCall.jet for the text of Tree.jet.
render_body_host_call: fn(text: String) -> String BodyHostCallRowsError! {
    lines: text.split("\n").to_list()
    start: loop (index, line) in lines {
        if line == SOURCE_OPEN -> break index
    } ?? return Err(rows_fail("{SOURCE_PATH} declares no `{SOURCE_OPEN}` line"))
    out := [String]{
        GENERATED_BY,
        "// BodyHostCall is THostCall over the flat body: each checked child is its",
        "// BodyTree node index. THostCall is declared in {SOURCE_PATH}.",
        "",
        OUTPUT_OPEN,
    }
    index := start + 1
    loop index < lines.len() {
        line: lines[index]
        if line == "}}" {
            out.push("}}")
            out.push("")
            return Ok(out.join("\n"))
        }
        out.push(body_host_call_line(line, index + 1) ?? return Err(err))
        index += 1
    }
    Err(rows_fail("{SOURCE_PATH}: `{SOURCE_OPEN}` has no closing `}}` line"))
}

body_host_call_rows_main: fn(args: [String]) -[FS]> String BodyHostCallRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(rows_fail("usage: jet Tools/agent/BodyHostCallRows.jet [--check|--write]"))
    text: files.read(SOURCE_PATH) ?? return Err(rows_fail("cannot read {SOURCE_PATH}: {err}"))
    generated: render_body_host_call(text) ?? return Err(err)
    current: files.read(OUTPUT_PATH) ?? ""
    if current == generated -> return Ok("body host call rows check passed")
    if mode == "--check" -> return Err(rows_fail("{OUTPUT_PATH} differs from THostCall in {SOURCE_PATH}; run jet Tools/agent/BodyHostCallRows.jet --write"))
    files.write(OUTPUT_PATH, generated) ?? return Err(rows_fail("cannot write {OUTPUT_PATH}: {err}"))
    Ok("body host call rows written")
}

run: fn() {
    if body_host_call_rows_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The error text render_body_host_call reports for `text`, or "" when it accepts it.
body_host_call_rows_error: fn(text: String) -> String Never! {
    if render_body_host_call(text) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("body host call rows write each tree child as its node index") {
    tree: "X: enum {{\n}}\nTHostCall: enum {{\n    // A call.\n    Method(receiver: TExpr, args: [TExpr], kind: TOptionProbe)\n    Probe(inner: TExpr?)\n}}\n"
    rendered: render_body_host_call(tree) ?? panic("the declaration did not render: {err.message}")
    assert(rendered.starts_with(GENERATED_BY))
    assert(rendered.contains("\nBodyHostCall: enum {{\n    // A call.\n    Method(receiver: Int, args: [Int], kind: TOptionProbe)\n    Probe(inner: Int?)\n}}\n"))
    assert(body_host_call_rows_error("Y: enum {{\n}}\n").contains("declares no"))
    assert(body_host_call_rows_error("THostCall: enum {{\n    Spawn(body: TLambda)\n}}\n").contains("no body form"))
    assert(body_host_call_rows_error("THostCall: enum {{\n    Wrap(kind: TExprKind)\n}}\n").contains("no body form"))
    assert(body_host_call_rows_error("THostCall: enum {{\n    Open\n").contains("no closing"))
}

#Test("the generated BodyHostCall matches THostCall") {
    text: files.read(SOURCE_PATH) ?? panic("cannot read {SOURCE_PATH}")
    assert_eq(files.read(OUTPUT_PATH) ?? "", render_body_host_call(text) ?? panic(err.message))
}
