#!/usr/bin/env jet
// Validate ballot payload files against the rules Tower applies when a
// ballot is posted (Tools/tower/app/store.mjs `ballotGaps` and
// `addDecision`, ballot process 5). Only the payload is read. No Tower store,
// board or state root is opened, and nothing is written, so it runs from a
// fresh clone with only `jet`. Rules that need the board use only what the
// payload carries: a short ballot's card tags come from its `cardTags` or
// `card.tags`. Whether `cardId` names a live card, whether `id` is already
// taken, and whether a verdict's `supersededBy` exists are left to Tower's
// gate at posting time.
//
// Usage: jet Tools/agent/ballots/Validate.jet [--update] <payload.json>...
// `--update` reads the payloads as updates of ballots already on the board.
// The new-ballot rules are then skipped: the recommended option need not be
// A, listed first, and no title is required. Exit status is 1 when any
// payload has a gap.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
    term: core.term
}

// Tower's ballot process (store.mjs BALLOT_PROCESS_VERSION): one fresh
// adversarial review pass.
REVIEW_PASS_KEYS: [String]{"adversarial"}

// A payload for a new ballot (`addDecision`) or an edit of one already on
// the board (`updateDecision`).
Posting: enum {
    New
    Update
}

PLAIN_SENTENCE_WORDS: 32
PLAIN_PARAGRAPH_WORDS: 90
SURFACE_MITIGATION_WORDS: 24
SURFACE_GIST_WORDS: 22
SURFACE_LESSON_WORDS: 70
SURFACE_WHY_WORDS: 40
SURFACE_SENTENCE_WORDS: 24
SURFACE_BULLET_WORDS: 14
SURFACE_TOTAL_WORDS: 430
SURFACE_CODE_LINES: 14
SURFACE_JARGON: [String]{"ratchet", "seam", "facet", "substrate", "tier-parity", "tier parity", "ring 0", "ring 1", "rings"}
SITUATION_MIN_CHARS: 300
SITUATION_MAX_CHARS: 1200
DISSENT_AUTHOR: "Author model family: "
DISSENT_ADVERSARIAL: " Adversarial model family: "
FRESH_AGENT: "Fresh agent: "
TRIO_SIDES: [String]{"current", "wild"}
BULLET_LISTS: [String]{"gains", "losses"}
OPTION_PARTS: [String]{"name", "detail", "code"}

// ---- payload values ----------------------------------------------------

// Field `name` of an object, `Dyn.Null` when absent.
field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

// JavaScript `Object.hasOwn`.
has_field: fn(tree: Dyn, name: String) -> Bool Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return true
        }
    }
    false
}

field_names: fn(tree: Dyn) -> [String] Never! {
    names := [String]{}
    if tree == .Object(entries) {
        loop entry in entries -> names.push(entry.key.copy())
    }
    names
}

// store.mjs `plainObject`.
is_object: fn(value: Dyn) -> Bool Never! {
    if value == .Object(_) -> return true
    false
}

is_array: fn(value: Dyn) -> Bool Never! {
    if value == .Array(_) -> return true
    false
}

is_null: fn(value: Dyn) -> Bool Never! {
    if value == .Null -> return true
    false
}

is_text: fn(value: Dyn) -> Bool Never! {
    if value == .Text(_) -> return true
    false
}

// The items of an array, none for any other value (`Array.isArray(v) ? v : []`).
items: fn(value: Dyn) -> [Dyn] Never! {
    if value == .Array(list) -> return list.copy()
    [Dyn]{}
}

// `typeof v === 'string' ? v : ''`.
string_value: fn(value: Dyn) -> String Never! {
    if value == .Text(text) -> return text.copy()
    ""
}

// JavaScript `String(v || '')` for the values a payload holds: a falsy value
// gives "".
js_text: fn(value: Dyn) -> String Never! {
    if value == {
        .Text(text) -> text.copy()
        .Int(number) -> if number == 0 -> "" else -> "{number}"
        .Number(lexeme) -> if lexeme == "0" -> "" else -> lexeme.copy()
        .Bool(flag) -> if flag -> "true" else -> ""
        .Array(list) -> {
            parts := [String]{}
            loop item in list -> parts.push(js_text(item))
            parts.join(",")
        }
        .Object(_) -> "[object Object]"
        .Null | .Float(_) | .Bytes(_) | .DateTime(_) -> ""
    }
}

// `v && String(v).trim()`: the value is set and not blank.
present: fn(value: Dyn) -> Bool Never! { js_text(value).trim() != "" }

// `o?.key || fallback`.
key_or: fn(item: Dyn, fallback: String) -> String Never! {
    key: js_text(field(item, "key"))
    if key == "" -> return fallback.copy()
    key
}

// ---- prose -----------------------------------------------------------------

// store.mjs `words(text).length`: runs that start with a letter or number and
// continue through letters, numbers, `'`, `’` and `-`. A letter here is a
// Unicode Alphabetic scalar, which also takes in the combining vowel signs
// that JavaScript's `\p{L}` leaves out; English prose counts the same.
word_count: fn(text: String) -> Int Never! {
    count := 0
    inside := false
    loop scalar in text.chars() {
        piece: "{scalar}"
        if inside && (word_scalar(piece) || piece == "'" || piece == "’" || piece == "-") -> next
        inside = false
        if word_scalar(piece) {
            inside = true
            count += 1
        }
    }
    count
}

word_scalar: fn(scalar: String) -> Bool Never! { scalar.is_alphabetic() || scalar.is_numeric() }

// `text.split(/(?<=[.!?])\s+/).filter(Boolean)`.
sentence_list: fn(text: String) -> [String] Never! {
    out := [String]{}
    current := [String]{}
    last := ""
    in_space := false
    splitting := false
    loop scalar in text.chars() {
        piece: "{scalar}"
        if piece.is_whitespace() {
            if !in_space {
                in_space = true
                splitting = last == "." || last == "!" || last == "?"
                if splitting {
                    sentence: current.join("")
                    if sentence != "" -> out.push(sentence)
                    current = [String]{}
                }
            }
            if !splitting -> current.push(piece)
            next
        }
        in_space = false
        current.push(piece.copy())
        last = piece
    }
    sentence: current.join("")
    if sentence != "" -> out.push(sentence)
    out
}

// store.mjs `sentences`: the trimmed text's sentences.
sentences: fn(text: String) -> [String] Never! { sentence_list(text.trim()) }

// Ends a whitespace run inside `paragraph_list`: a run holding two or more
// newlines (`\n\s*\n`) closes the current paragraph.
close_run: fn(out: &[String], current: &[String], run: &[String]) Never! {
    first := -1
    last := -1
    loop index in 0..<run.len() {
        if run[index] != "\n" -> next
        if first < 0 -> first = index
        last = index
    }
    if {
        first >= 0 && last > first -> {
            loop index in 0..<first -> current.push(run[index])
            out.push(current.join(""))
            current = [String]{}
            loop index in (last + 1)..<run.len() -> current.push(run[index])
        }
        else -> loop piece in run -> current.push(piece.copy())
    }
    run = [String]{}
}

// `text.split(/\n\s*\n/)`.
paragraph_list: fn(text: String) -> [String] Never! {
    out := [String]{}
    current := [String]{}
    run := [String]{}
    loop scalar in text.chars() {
        piece: "{scalar}"
        if piece.is_whitespace() {
            run.push(piece)
            next
        }
        if run.len() > 0 -> close_run(out, current, run)
        current.push(piece)
    }
    if run.len() > 0 -> close_run(out, current, run)
    out.push(current.join(""))
    out
}

FenceOpener: struct {
    mark: String
    marker: String
    rest: String
}

// `/^ {0,3}(`{3,}|~{3,})(.*)$/`: up to three spaces, then three or more of
// one fence character. `.` stops at CR, U+2028 and U+2029, so a line holding
// one is not an opener.
fence_opener: fn(line: String) -> FenceOpener? Never! {
    spaces := 0
    mark := ""
    count := 0
    rest := [String]{}
    loop scalar in line.chars() {
        piece: "{scalar}"
        if mark == "" {
            if piece == " " && spaces < 3 {
                spaces += 1
                next
            }
            if piece != "`" && piece != "~" -> return None
            mark = piece
            count = 1
            next
        }
        if rest.len() == 0 && piece == mark {
            count += 1
            next
        }
        if piece == "\r" || unicode_line_break(piece) -> return None
        rest.push(piece)
    }
    if count < 3 -> return None
    markers := [String]{}
    loop _ in 0..<count -> markers.push(mark.copy())
    Val(FenceOpener{mark: mark, marker: markers.join(""), rest: rest.join("")})
}

// store.mjs `proseDensityGaps`: paragraphs over 90 words and sentences over
// 32, with fenced code blocks left out.
prose_density_gaps: fn(label: String, value: Dyn) -> [String] Never! {
    text: js_text(value)
    gaps := [String]{}
    if text.trim() == "" -> return gaps
    kept := [String]{}
    fence := ""
    fence_mark := ""
    loop line in text.split("\n") {
        opener: fence_opener(line)
        if fence != "" {
            if opener == .Val(open) && open.mark == fence_mark && open.marker.len() >= fence.len() && open.rest.trim() == "" -> fence = ""
            kept.push("")
            next
        }
        if opener == .Val(open) && !(open.marker.starts_with("`") && open.rest.contains("`")) {
            fence = open.marker.copy()
            fence_mark = open.mark.copy()
            kept.push("")
            next
        }
        kept.push(line.copy())
    }
    paragraph_number := 0
    loop paragraph in paragraph_list(kept.join("\n").trim()) {
        paragraph_number += 1
        paragraph_words: word_count(paragraph)
        if paragraph_words > PLAIN_PARAGRAPH_WORDS -> gaps.push("{label} paragraph {paragraph_number} has {paragraph_words} words (max {PLAIN_PARAGRAPH_WORDS})")
        sentence_number := 0
        loop sentence in sentence_list(paragraph) {
            sentence_number += 1
            sentence_words: word_count(sentence)
            if sentence_words > PLAIN_SENTENCE_WORDS -> gaps.push("{label} sentence {sentence_number} has {sentence_words} words (max {PLAIN_SENTENCE_WORDS})")
        }
    }
    gaps
}

// store.mjs `exampleProseDensityGaps`: sentences over 32 words, line by line.
example_prose_density_gaps: fn(label: String, value: Dyn) -> [String] Never! {
    text: js_text(value)
    gaps := [String]{}
    if text.trim() == "" -> return gaps
    line_number := 0
    loop line in text.split("\n") {
        line_number += 1
        sentence_number := 0
        loop sentence in sentence_list(line) {
            sentence_number += 1
            sentence_words: word_count(sentence)
            if sentence_words > PLAIN_SENTENCE_WORDS -> gaps.push("{label} line {line_number} sentence {sentence_number} has {sentence_words} words (max {PLAIN_SENTENCE_WORDS})")
        }
    }
    gaps
}

is_digit: fn(piece: String) -> Bool Never! {
    bytes: piece.bytes()
    bytes.len() == 1 && Int{bytes[0]} >= 48 && Int{bytes[0]} <= 57
}

// U+2028 LINE SEPARATOR or U+2029 PARAGRAPH SEPARATOR.
unicode_line_break: fn(piece: String) -> Bool Never! {
    bytes: piece.bytes()
    bytes.len() == 3 && Int{bytes[0]} == 226 && Int{bytes[1]} == 128 && (Int{bytes[2]} == 168 || Int{bytes[2]} == 169)
}

line_terminator: fn(piece: String) -> Bool Never! { piece == "\n" || piece == "\r" || unicode_line_break(piece) }

space_at: fn(scalars: [String], position: Int) -> Bool Never! { position < scalars.len() && scalars[position].is_whitespace() }

// What a line of `scalars` starts with at `at`, after `^\s*`: "bullet"
// (`[-*+•]\s`), "number" (`\d+[.)]\s`), "heading" (`#{1,6}\s`), "fence"
// (three or more backticks or tildes) or "".
line_marker: fn(scalars: [String], at: Int) -> String Never! {
    index := at
    loop {
        if index >= scalars.len() || !scalars[index].is_whitespace() -> break
        index += 1
    }
    if index >= scalars.len() -> return ""
    first: scalars[index]
    if first == "-" || first == "*" || first == "+" || first == "•" {
        if space_at(scalars, index + 1) -> return "bullet"
    }
    if first == "`" || first == "~" {
        run := 0
        loop {
            if index + run >= scalars.len() || scalars[index + run] != first -> break
            run += 1
        }
        if run >= 3 -> return "fence"
        return ""
    }
    if first == "#" {
        run := 0
        loop {
            if index + run >= scalars.len() || scalars[index + run] != "#" -> break
            run += 1
        }
        if run <= 6 && space_at(scalars, index + run) -> return "heading"
        return ""
    }
    if is_digit(first) {
        run := 0
        loop {
            if index + run >= scalars.len() || !is_digit(scalars[index + run]) -> break
            run += 1
        }
        end: index + run
        if end < scalars.len() && (scalars[end] == "." || scalars[end] == ")") && space_at(scalars, end + 1) -> return "number"
    }
    ""
}

// The markers some line of `text` starts with (multiline `^`).
line_markers: fn(text: String) -> [String] Never! {
    scalars := [String]{}
    loop scalar in text.chars() -> scalars.push("{scalar}")
    found := [String]{}
    loop index in 0..<(scalars.len() + 1) {
        if index > 0 && !line_terminator(scalars[index - 1]) -> next
        marker: line_marker(scalars, index)
        if marker != "" && !found.contains(marker) -> found.push(marker)
    }
    found
}

ascii_lower: fn(text: String) -> String Never! {
    bytes := [U8]{}
    loop byte in text.bytes() {
        code: Int{byte}
        bytes.push(if code >= 65 && code <= 90 -> checked(U8{code + 32}) ?? byte else -> byte)
    }
    String.from_bytes(bytes) ?? text.copy()
}

word_byte: fn(bytes: [U8], at: Int) -> Bool Never! {
    if at < 0 || at >= bytes.len() -> return false
    code: Int{bytes[at]}
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

// The first SURFACE_JARGON term (`\b…\b`, any case) in `text`, as written, or "".
jargon_in: fn(text: String) -> String Never! {
    lower: ascii_lower(text).bytes()
    best := -1
    best_length := 0
    loop term in SURFACE_JARGON {
        needle: term.bytes()
        loop start in 0..<(lower.len() - needle.len() + 1) {
            if best >= 0 && start >= best -> break
            matched := true
            loop offset in 0..<needle.len() {
                if lower[start + offset] != needle[offset] {
                    matched = false
                    break
                }
            }
            if !matched || word_byte(lower, start - 1) || word_byte(lower, start + needle.len()) -> next
            best = start
            best_length = needle.len()
            break
        }
    }
    if best < 0 -> return ""
    String.from_bytes(text.bytes()[best..<(best + best_length)]) ?? ""
}

// ---- review passes ---------------------------------------------------------

Dissent: struct {
    author: String
    adversarial: String
    agent: String
    summary: String
}

// `/^<prefix>([^.]+)\./`: the text after `prefix` up to the first `.` (at
// least one character), and the text after that `.`.
prefixed_field: fn(text: String, prefix: String) -> (value: String, rest: String)? Never! {
    if !text.starts_with(prefix) -> return None
    tail: text.remove_prefix(prefix)
    if tail.find(".") <= 0 -> return None
    parts: tail.partition(".")
    Val((value: parts.head.copy(), rest: parts.tail.copy()))
}

// store.mjs `dissentMetadata`.
dissent: fn(pass: Dyn) -> Dissent? Never! {
    if !is_text(pass) -> return None
    text: string_value(pass)
    author: prefixed_field(text, DISSENT_AUTHOR) ?? return None
    adversarial: prefixed_field(author.rest, DISSENT_ADVERSARIAL) ?? return None
    body: adversarial.rest.trim()
    if prefixed_field(body, FRESH_AGENT) == .Val(reviewer) {
        return Val(Dissent{author: author.value.trim(), adversarial: adversarial.value.trim(), agent: reviewer.value.trim(), summary: reviewer.rest.trim()})
    }
    Val(Dissent{author: author.value.trim(), adversarial: adversarial.value.trim(), agent: "", summary: body.copy()})
}

// store.mjs `dissentMetadataGaps` for an open ballot (a fresh reviewer is required).
dissent_metadata_gaps: fn(payload: Dyn) -> [String] Never! {
    metadata: dissent(field(field(payload, "reviewPasses"), "adversarial"))
    if metadata == .Val(found) && found.author != "" && found.adversarial != "" {
        if found.agent == "" -> return [String]{"reviewPasses.adversarial (model provenance must be followed by `Fresh agent: <agent-id>.`)"}
        return [String]{}
    }
    [String]{"reviewPasses.adversarial (must begin with `Author model family: <family>. Adversarial model family: <family>.`)"}
}

// store.mjs `reviewPassSummary`: an adversarial pass without its provenance.
review_pass_summary: fn(key: String, pass: Dyn) -> Dyn Never! {
    if key == "adversarial" && dissent(pass) == .Val(found) && found.summary != "" -> return Dyn.Text(found.summary)
    pass.copy()
}

// ---- gaps ------------------------------------------------------------------

// store.mjs `mitigationGaps`.
mitigation_gaps: fn(label: String, item: Dyn) -> [String] Never! {
    gaps := [String]{}
    if has_field(item, "whyUnavoidable") -> gaps.push("{label} (use mitigation, not whyUnavoidable)")
    mitigation: field(item, "mitigation")
    if is_text(mitigation) && line_markers(string_value(mitigation)).len() > 0 -> gaps.push("{label}.mitigation (plain prose, no lists, headings, or code blocks)")
    gaps
}

// store.mjs `plainLanguageGaps`.
plain_language_gaps: fn(payload: Dyn) -> [String] Never! {
    gaps := [String]{}
    gaps.extend(prose_density_gaps("title", field(payload, "title")))
    gaps.extend(prose_density_gaps("gist", field(payload, "gist")))
    gaps.extend(prose_density_gaps("lesson", field(payload, "lesson")))
    gaps.extend(prose_density_gaps("explainer", field(payload, "explainer")))
    gaps.extend(prose_density_gaps("story", field(payload, "story")))
    gaps.extend(example_prose_density_gaps("inWild", field(payload, "inWild")))
    gaps.extend(prose_density_gaps("detail", field(payload, "detail")))
    loop option in items(field(payload, "options")) {
        key: key_or(option, "?")
        gaps.extend(prose_density_gaps("option {key} name", field(option, "name")))
        gaps.extend(prose_density_gaps("option {key}", field(option, "detail")))
        gaps.extend(prose_density_gaps("option {key} technical", field(option, "technical")))
    }
    loop comparison in items(field(payload, "comparisons")) {
        lang: js_text(field(comparison, "lang"))
        gaps.extend(prose_density_gaps("comparison {if lang == "" -> "?" else -> lang}", field(comparison, "note")))
    }
    recommendation: field(payload, "recommendation")
    gaps.extend(prose_density_gaps("recommendation why", field(recommendation, "why")))
    gaps.extend(prose_density_gaps("recommendation tradeoff", field(recommendation, "tradeoff")))
    loop rejected in items(field(recommendation, "whyNot")) {
        gaps.extend(prose_density_gaps("recommendation why not {key_or(rejected, "?")}", field(rejected, "reason")))
    }
    index := 0
    loop item in items(field(recommendation, "losses")) {
        index += 1
        loss: if is_object(item) -> field(item, "loss") else -> item.copy()
        mitigation: if is_object(item) -> field(item, "mitigation") else -> Dyn.Null
        gaps.extend(prose_density_gaps("recommendation loss {index}", loss))
        gaps.extend(prose_density_gaps("recommendation loss {index} mitigation", mitigation))
    }
    hybrid: field(payload, "hybrid")
    gaps.extend(prose_density_gaps("hybrid synthesis", field(hybrid, "synthesis")))
    loop item in items(field(hybrid, "harvest")) {
        key: key_or(item, "?")
        gaps.extend(prose_density_gaps("hybrid {key} aspect", field(item, "aspect")))
        gaps.extend(prose_density_gaps("hybrid {key} use", field(item, "use")))
    }
    loop key in REVIEW_PASS_KEYS {
        gaps.extend(prose_density_gaps("reviewPasses.{key}", review_pass_summary(key, field(field(payload, "reviewPasses"), key))))
    }
    check: field(payload, "checkInstructions")
    if is_text(check) -> gaps.extend(prose_density_gaps("checkInstructions", check))
    gaps
}

Prose: struct {
    label: String
    text: String
}

// The option keys of `options[]` that are set, in order.
option_keys: fn(payload: Dyn) -> [String] Never! {
    keys := [String]{}
    loop option in items(field(payload, "options")) {
        key: js_text(field(option, "key"))
        if key != "" -> keys.push(key)
    }
    keys
}

// The `reason` of the `whyNot` entry whose key is `key`.
why_not_reason: fn(why_not: [Dyn], key: String) -> String Never! {
    loop item in why_not {
        if field(item, "key") == .Text(found) && found == key -> return string_value(field(item, "reason")).trim()
    }
    ""
}

// One `need` of store.mjs `surfaceGaps`: a missing value is a gap, a present
// one is prose and may have a word limit (0 for none).
need: fn(gaps: &[String], prose: &[Prose], label: String, value: Dyn, limit: Int) Never! {
    text: string_value(value).trim()
    if text == "" {
        gaps.push("surface.{label}")
        return
    }
    prose.push(Prose{label: label.copy(), text: text.copy()})
    count: word_count(text)
    if limit > 0 && count > limit -> gaps.push("surface.{label} has {count} words (max {limit})")
}

// store.mjs `surfaceGaps`: the short owner-facing reading surface.
surface_gaps: fn(payload: Dyn, posting: Posting) -> [String] Never! {
    surface: field(payload, "surface")
    if !is_object(surface) -> return [String]{"surface (object)"}
    gaps := [String]{}
    prose := [Prose]{}
    need(gaps, prose, "gist", field(surface, "gist"), SURFACE_GIST_WORDS)
    gist: string_value(field(surface, "gist")).trim()
    if gist != "" && !gist.ends_with("?") -> gaps.push("surface.gist (must be a question)")
    need(gaps, prose, "lesson", field(surface, "lesson"), SURFACE_LESSON_WORDS)
    if paragraph_list(string_value(field(surface, "lesson")).trim()).len() > 1 -> gaps.push("surface.lesson (one paragraph maximum)")
    trio: field(surface, "trio")
    loop side in TRIO_SIDES {
        pane: field(trio, side)
        need(gaps, prose, "trio.{side}.note", field(pane, "note"), 0)
        if string_value(field(pane, "code")).trim() == "" -> gaps.push("surface.trio.{side}.code")
    }
    if string_value(field(field(trio, "wild"), "lang")).trim() == "" -> gaps.push("surface.trio.wild.lang")
    keys: option_keys(payload)
    surface_options: items(field(surface, "options"))
    surface_keys := [String]{}
    loop option in surface_options -> surface_keys.push(js_text(field(option, "key")))
    // Tower compares the NUL-joined key lists.
    nul: String.from_bytes([U8]{U8{0}}) ?? ""
    if surface_keys.join(nul) != keys.join(nul) -> gaps.push("surface.options (keys must match options[] in order)")
    loop option in surface_options {
        key: key_or(option, "?")
        need(gaps, prose, "options[{key}].name", field(option, "name"), 0)
        need(gaps, prose, "options[{key}].gist", field(option, "gist"), 0)
        loop list in BULLET_LISTS {
            entries: items(field(option, list))
            if entries.len() > 3 || (list == "gains" && entries.len() < 1) {
                gaps.push("surface.options[{key}].{list} ({if list == "gains" -> "need 1-3 real items" else -> "at most 3 real items"})")
            }
            index := 0
            loop entry in entries {
                index += 1
                need(gaps, prose, "options[{key}].{list}[{index}]", entry, 0)
                count: word_count(string_value(entry).trim())
                if count > SURFACE_BULLET_WORDS -> gaps.push("surface.options[{key}].{list}[{index}] has {count} words (max {SURFACE_BULLET_WORDS})")
            }
        }
        code: string_value(field(field(option, "proposed"), "code")).trim()
        if {
            code == "" -> gaps.push("surface.options[{key}].proposed.code")
            code.split("\n").to_list().len() > SURFACE_CODE_LINES -> gaps.push("surface.options[{key}].proposed.code (max {SURFACE_CODE_LINES} lines)")
        }
    }
    recommendation: field(surface, "recommendation")
    rec: field(payload, "rec")
    if field(recommendation, "rec") != rec -> gaps.push("surface.recommendation.rec (must equal rec)")
    if posting == .New && keys.len() > 0 && (keys[0] != "A" || rec != Dyn.Text("A")) -> gaps.push("rec (new ballots list the recommended option first, as A)")
    need(gaps, prose, "recommendation.why", field(recommendation, "why"), SURFACE_WHY_WORDS)
    loop list in BULLET_LISTS {
        entries: items(field(recommendation, list))
        if list == "gains" && entries.len() == 0 -> gaps.push("surface.recommendation.gains")
        if entries.len() > 3 -> gaps.push("surface.recommendation.{list} (at most 3 real items)")
        index := 0
        loop entry in entries {
            index += 1
            label: "recommendation.{list}[{index}]"
            if list == "losses" {
                if !is_object(entry) {
                    shown: string_value(entry).trim()
                    gaps.push("surface.{label}{if shown == "" -> "" else -> " \"{shown}\""} (must include mitigation)")
                    next
                }
                gaps.extend(mitigation_gaps("surface.{label}", entry))
                loss: string_value(field(entry, "loss")).trim()
                mitigation: string_value(field(entry, "mitigation")).trim()
                if {
                    loss == "" -> gaps.push("surface.{label}.loss (required)")
                    else -> {
                        prose.push(Prose{label: "{label}.loss", text: loss.copy()})
                        count: word_count(loss)
                        if count >= SURFACE_BULLET_WORDS -> gaps.push("surface.{label}.loss has {count} words (under {SURFACE_BULLET_WORDS} words)")
                    }
                }
                if {
                    mitigation == "" -> gaps.push("surface.{label}.mitigation (required for \"{if loss == "" -> "?" else -> loss}\")")
                    else -> {
                        prose.push(Prose{label: "{label}.mitigation", text: mitigation.copy()})
                        count: word_count(mitigation)
                        if count >= SURFACE_MITIGATION_WORDS -> gaps.push("surface.{label}.mitigation has {count} words (under {SURFACE_MITIGATION_WORDS} words)")
                    }
                }
                next
            }
            need(gaps, prose, label, entry, 0)
            count: word_count(string_value(entry).trim())
            if count > SURFACE_BULLET_WORDS -> gaps.push("surface.{label} has {count} words (max {SURFACE_BULLET_WORDS})")
        }
    }
    why_not: items(field(recommendation, "whyNot"))
    loop key in keys {
        if rec == Dyn.Text(key) -> next
        reason: why_not_reason(why_not, key)
        if {
            reason == "" -> gaps.push("surface.recommendation.whyNot[{key}]")
            else -> prose.push(Prose{label: "recommendation.whyNot[{key}]", text: reason.copy()})
        }
    }
    need(gaps, prose, "recommendation.tradeoff", field(recommendation, "tradeoff"), 0)
    total := 0
    loop entry in prose {
        total += word_count(entry.text)
        loop sentence in sentences(entry.text) {
            count: word_count(sentence)
            if count > SURFACE_SENTENCE_WORDS -> gaps.push("surface.{entry.label} sentence has {count} words (max {SURFACE_SENTENCE_WORDS})")
        }
        jargon: jargon_in(entry.text)
        if jargon != "" -> gaps.push("surface.{entry.label} uses project jargon \"{jargon}\"")
    }
    if total > SURFACE_TOTAL_WORDS -> gaps.push("surface prose has {total} words (max {SURFACE_TOTAL_WORDS})")
    gaps
}

// store.mjs `situationGaps`: 300-1200 characters of plain prose.
situation_gaps: fn(situation: Dyn) -> [String] Never! {
    text: string_value(situation).trim()
    if text == "" -> return [String]{"situation"}
    gaps := [String]{}
    // JavaScript string length: UTF-16 code units.
    length := 0
    loop scalar in text.chars() -> length += if "{scalar}".count_bytes() == 4 -> 2 else -> 1
    if length < SITUATION_MIN_CHARS || length > SITUATION_MAX_CHARS -> gaps.push("situation has {length} characters (need {SITUATION_MIN_CHARS}-{SITUATION_MAX_CHARS})")
    markers: line_markers(text)
    if markers.contains("bullet") || markers.contains("number") -> gaps.push("situation (plain prose, not a bullet list)")
    if markers.contains("heading") -> gaps.push("situation (plain prose, no headings)")
    if markers.contains("fence") -> gaps.push("situation (plain prose, no code blocks)")
    index := 0
    loop sentence in sentences(text) {
        index += 1
        count: word_count(sentence)
        if count > PLAIN_SENTENCE_WORDS -> gaps.push("situation sentence {index} has {count} words (max {PLAIN_SENTENCE_WORDS})")
    }
    gaps
}

// store.mjs `shortBallotGaps` with the card tags the payload carries.
short_ballot_gaps: fn(payload: Dyn) -> [String] Never! {
    gaps := [String]{}
    tags := [String]{}
    loop entry in items(field(payload, "cardTags")) -> tags.push(ascii_lower(js_text(entry).trim()))
    loop entry in items(field(field(payload, "card"), "tags")) -> tags.push(ascii_lower(js_text(entry).trim()))
    blocked := [String]{}
    if ascii_lower(js_text(field(payload, "group")).trim()) == "syntax" -> blocked.push("syntax-group decisions require a full ballot")
    if tags.contains("carve-out") -> blocked.push("cards tagged carve-out require a full ballot")
    if tags.contains("full") -> blocked.push("cards tagged full require a full ballot")
    if {
        blocked.len() > 0 -> gaps.push("short ballot refused: {blocked.join("; ")}")
        items(field(payload, "options")).len() > 3 && !present(field(payload, "shortAuthorizedBy")) -> gaps.push("shortAuthorizedBy (short profile without owner authorization is limited to one mechanism with at most three options)")
    }
    if !is_null(field(payload, "reviewPasses")) -> gaps.push("short ballots must omit reviewPasses")
    gaps
}

// The options whose `name` is missing, each shown by its key or else by its
// place in that list (`#<n>`, as Tower numbers them).
options_missing: fn(options: [Dyn], name: String) -> [String] Never! {
    missing := [String]{}
    loop option in options {
        if !present(field(option, name)) -> missing.push(key_or(option, "#{missing.len() + 1}"))
    }
    missing
}

// store.mjs `ballotGaps` for an open ballot of the current process, with
// the reading surface required.
ballot_gaps: fn(payload: Dyn, posting: Posting) -> [String] Never! {
    gaps := surface_gaps(payload, posting)
    mode := js_text(field(payload, "ballotMode"))
    if mode == "" -> mode = "full"
    if mode != "full" && mode != "short" -> gaps.push("ballotMode (full or short)")
    if mode == "full" || string_value(field(payload, "situation")).trim() != "" -> gaps.extend(situation_gaps(field(payload, "situation")))
    if !present(field(payload, "gist")) -> gaps.push("gist")
    if {
        !present(field(payload, "lesson")) -> gaps.push("lesson")
        paragraph_list(js_text(field(payload, "lesson")).trim()).len() > 1 -> gaps.push("lesson (one paragraph maximum)")
    }
    if !present(field(payload, "story")) -> gaps.push("story")
    if !present(field(payload, "inWild")) -> gaps.push("inWild")
    options: items(field(payload, "options"))
    keys: option_keys(payload)
    if options.len() < 2 -> gaps.push("options (need at least 2)")
    if options.len() >= 2 {
        unkeyed := false
        loop option in options {
            if !present(field(option, "key")) -> unkeyed = true
        }
        if unkeyed -> gaps.push("options[].key")
        loop name in OPTION_PARTS {
            missing: options_missing(options, name)
            if missing.len() > 0 -> gaps.push("options[].{name} (missing on {missing.join(", ")})")
        }
        duplicates := [String]{}
        loop index in 0..<keys.len() {
            first := 0
            loop at in 0..<keys.len() {
                if keys[at] == keys[index] {
                    first = at
                    break
                }
            }
            if first != index && !duplicates.contains(keys[index]) -> duplicates.push(keys[index])
        }
        if duplicates.len() > 0 -> gaps.push("options[].key (duplicate: {duplicates.join(", ")})")
    }
    rec: field(payload, "rec")
    if !present(rec) -> gaps.push("rec")
    if js_text(rec) != "" && !(is_text(rec) && keys.contains(string_value(rec))) -> gaps.push("rec (must match an option key)")
    recommendation: field(payload, "recommendation")
    if !is_object(recommendation) && !is_array(recommendation) -> gaps.push("recommendation")
    if is_object(recommendation) || is_array(recommendation) {
        if !present(field(recommendation, "why")) -> gaps.push("recommendation.why")
        if !present(field(recommendation, "tradeoff")) -> gaps.push("recommendation.tradeoff")
        why_not: items(field(recommendation, "whyNot"))
        loop key in keys {
            if rec == Dyn.Text(key) -> next
            reason := ""
            loop item in why_not {
                if field(item, "key") == .Text(found) && found == key {
                    reason = js_text(field(item, "reason")).trim()
                    break
                }
            }
            if reason == "" -> gaps.push("recommendation.whyNot[{key}]")
        }
        index := 0
        loop item in items(field(recommendation, "losses")) {
            index += 1
            if !is_object(item) {
                gaps.push("recommendation.losses[{index}] \"{js_text(item).trim()}\" (must include mitigation)")
                next
            }
            loss: string_value(field(item, "loss")).trim()
            gaps.extend(mitigation_gaps("recommendation.losses[{index}]", item))
            if loss == "" -> gaps.push("recommendation.losses[{index}].loss (required)")
            if string_value(field(item, "mitigation")).trim() == "" -> gaps.push("recommendation.losses[{index}].mitigation (required for \"{if loss == "" -> "?" else -> loss}\")")
        }
    }
    passes: field(payload, "reviewPasses")
    if {
        mode == "full" && !is_object(passes) -> gaps.push("reviewPasses")
        mode == "full" -> {
            loop key in field_names(passes) {
                if !REVIEW_PASS_KEYS.contains(key) -> gaps.push("reviewPasses.{key} (unexpected)")
            }
            loop key in REVIEW_PASS_KEYS {
                summary: string_value(review_pass_summary(key, field(passes, key)))
                if {
                    summary.trim() == "" -> gaps.push("reviewPasses.{key} (need text)")
                    sentences(summary).len() > 2 -> gaps.push("reviewPasses.{key} (need 1-2 sentences)")
                }
            }
            gaps.extend(dissent_metadata_gaps(payload))
        }
        mode == "short" -> gaps.extend(short_ballot_gaps(payload))
    }
    dense: plain_language_gaps(payload)
    if dense.len() > 0 -> gaps.push("plain language: {dense.join("; ")}")
    gaps
}

// The posting rules of store.mjs `addDecision` (or, for `update`,
// `updateDecision`) that read only the payload, then `ballotGaps`.
payload_gaps: fn(payload: Dyn, posting: Posting) -> [String] Never! {
    if !is_object(payload) -> return [String]{"the payload is not a JSON object"}
    gaps := [String]{}
    if !present(field(payload, "cardId")) -> gaps.push("cardId")
    if field(payload, "draft") != Dyn.Bool(false) -> gaps.push("posting payload must set draft:false")
    if posting == .New && !present(field(payload, "title")) -> gaps.push("E_INVALID: decision needs a title")
    group: js_text(field(payload, "group"))
    if group == "acceptance" || js_text(field(payload, "id")).starts_with("D-ACCEPT-") -> gaps.push("E_INVALID: acceptance ballots are system-generated; use the card acceptance workflow")
    situation: field(payload, "situation")
    if !is_null(situation) && !is_text(situation) -> gaps.push("E_INVALID: decision situation must be a string")
    if group == "verdict" {
        superseded: string_value(field(payload, "supersededBy")).trim()
        if superseded == "" -> gaps.push("E_INVALID: verdict needs a supersession link (`supersededBy`)")
        if superseded != "" && superseded == js_text(field(payload, "id")) -> gaps.push("E_INVALID: verdict cannot supersede itself")
    }
    gaps.extend(ballot_gaps(payload, posting))
    gaps
}

run: fn() {
    posting := Posting.New
    paths := [String]{}
    loop arg in process.args() {
        if {
            arg == "--update" -> posting = .Update
            else -> paths.push(arg.copy())
        }
    }
    if paths.len() == 0 {
        process.fail(2, "usage: jet Tools/agent/ballots/Validate.jet [--update] <payload.json>...")
    }
    failed := 0
    loop path in paths {
        text: files.read(path) ?? {
            term.eprint("{path}: cannot read: {err}")
            failed += 1
            next
        }
        payload: json.parse(text) ?? {
            term.eprint("{path}: not JSON: {err}")
            failed += 1
            next
        }
        gaps: payload_gaps(payload, posting)
        id: js_text(field(payload, "id"))
        shown: if id == "" -> path.copy() else -> "{path} ({id})"
        if gaps.len() == 0 {
            print("ok {shown}")
            next
        }
        failed += 1
        print("{shown}: {gaps.len()} {if gaps.len() == 1 -> "gap" else -> "gaps"}")
        loop gap in gaps -> print("  - {gap}")
    }
    if failed > 0 -> process.exit(1)
}

#Test("words count letter and number runs with apostrophes and hyphens") {
    assert_eq(word_count("It's a well-known fact, 42 times."), 6)
    assert_eq(word_count("— ’tis -x"), 2)
    assert_eq(word_count(""), 0)
}

#Test("sentences split after . ! ? and whitespace, and paragraphs at blank lines") {
    assert_eq(sentence_list("One. Two!  Three?four. x"), [String]{"One.", "Two!", "Three?four.", "x"})
    assert_eq(sentence_list(" a.b c"), [String]{" a.b c"})
    assert_eq(paragraph_list("a\n b\n \n\nc"), [String]{"a\n b", "c"})
    assert_eq(paragraph_list(""), [String]{""})
}

#Test("fenced code is not prose, and fences close on a matching bare marker") {
    words := [String]{}
    loop _ in 0..<40 -> words.push("word")
    long: words.join(" ")
    assert_eq(prose_density_gaps("story", Dyn.Text("```jet\n{long}\n```\nshort.")).len(), 0)
    assert_eq(prose_density_gaps("story", Dyn.Text("{long}.")), [String]{"story sentence 1 has 40 words (max 32)"})
    assert(fence_opener("```js `x`") != None)
    assert(fence_opener("    ```") == None)
    assert(fence_opener("``~") == None)
}

#Test("line markers find lists, headings and fences at any line start") {
    assert_eq(line_markers("plain\n  - item"), [String]{"bullet"})
    assert_eq(line_markers("1) one\n## head\n~~~"), [String]{"number", "heading", "fence"})
    assert_eq(line_markers("####### no\n-x\n2.x"), [String]{})
}

#Test("jargon matches whole words in any case and reports the written form") {
    assert_eq(jargon_in("A Seam here"), "Seam")
    assert_eq(jargon_in("seamless tier parity"), "tier parity")
    assert_eq(jargon_in("nothing"), "")
}

#Test("an adversarial pass needs model provenance and a fresh agent") {
    payload: json.parse("{{\"reviewPasses\":{{\"adversarial\":\"Author model family: A. Adversarial model family: B. Fresh agent: R1. Fine.\"}}}}") ?? panic("json")
    assert_eq(dissent_metadata_gaps(payload).len(), 0)
    assert_eq(string_value(review_pass_summary("adversarial", field(field(payload, "reviewPasses"), "adversarial"))), "Fine.")
    stale: json.parse("{{\"reviewPasses\":{{\"adversarial\":\"Author model family: A. Adversarial model family: B. Fine.\"}}}}") ?? panic("json")
    assert_eq(dissent_metadata_gaps(stale), [String]{"reviewPasses.adversarial (model provenance must be followed by `Fresh agent: <agent-id>.`)"})
}

#Test("an empty payload names every required part") {
    payload: json.parse("{{}}") ?? panic("json")
    gaps: payload_gaps(payload, .New)
    assert(gaps.contains("cardId"))
    assert(gaps.contains("posting payload must set draft:false"))
    assert(gaps.contains("surface (object)"))
    assert(gaps.contains("situation"))
    assert(gaps.contains("options (need at least 2)"))
    assert(gaps.contains("reviewPasses"))
    assert(!payload_gaps(payload, .Update).contains("E_INVALID: decision needs a title"))
}
