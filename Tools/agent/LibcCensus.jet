#!/usr/bin/env jet
// The libc census: every C23 and POSIX.1-2024 function family, the Jet Core
// API that covers it, or GAP. The families are POSIX.1-2024's System
// Interfaces index (which carries the C17 library) plus the functions C23
// added; each lists its C names, the header that declares them and the Jet
// names that do the same job.
//
// A row's `jet` names are checked, never trusted: `core.<module>.<member>` (or
// a bare module) must be exported by Compiler/Prelude/Core.jet,
// `core.<module>.<Type>.<method>` must name a type that module exports and a
// method its source declares, and `<Type>.<method>` must be a built-in method,
// static or collection operation row. Every unresolved name is reported. With
// no argument the script checks the rows, then prints the census as Markdown:
// the per-area summary, the gap list by area and every family. --check (and
// this file's #Test) checks the rows only.
//
// Usage (from the repository root): jet Tools/agent/LibcCensus.jet [--check]
use {
    files: core.files
    process: core.process
    term: core.term
}

CORE_PRELUDE_PATH: "Compiler/Prelude/Core.jet"
BUILTIN_METHODS_PATH: "Compiler/JetFoundation/Source/Registry/BuiltinMethods.jet"
BUILTIN_STATICS_PATH: "Compiler/JetFoundation/Source/Registry/BuiltinStatics.jet"
COLLECTIONS_PATH: "Compiler/JetFoundation/Source/Collections.jet"
USAGE: "usage: jet Tools/agent/LibcCensus.jet [--check]"

#Error
CensusError: struct {
    message: String
}

census_fail: fn(message: String) -> CensusError Never! {
    CensusError{message: message}
}

// Covered: the Jet names do the family's job. Partial: they do part of it; the
// note says what is missing. Language: the language itself does the job, with
// no library call. NotNeeded: the owner ruled that Jet does not need the
// family; the note cites the ruling. Gap: Jet has no counterpart.
Coverage: enum {
    Covered
    Partial
    Language
    NotNeeded
    Gap
}

coverage_label: fn(coverage: Coverage) -> String Never! {
    if coverage == {
        .Covered -> "covered"
        .Partial -> "partial"
        .Language -> "language"
        .NotNeeded -> "not needed"
        .Gap -> "GAP"
    }
}

// One C function family. `names` are its C functions (macros included where
// the standard specifies them as functions); each suffix of `variants` adds
// name+suffix for every name, as math.h's f and l forms. A name with `*` is a
// pattern for an optional annex's generated set and counts as one family, not
// as functions.
Family: struct {
    area: String
    header: String
    standard: String
    names: String
    variants: String
    jet: String
    coverage: Coverage
    note: String
}

C23: "C23"
POSIX: "POSIX"
// Every not-needed note cites this ruling (#6696 c2): Jet's text is UTF-8 and
// locale-independent, message catalogs are a library's concern, and the
// obsolete or insecure interfaces stay out.
OWNER_RULING: "owner ruling on #6696"

FAMILIES: [Family]{
    // ---- Math ----
    {area: "Math", header: "math.h", standard: C23, names: "acos asin atan atan2 cos sin tan", variants: "f l", jet: "core.math.acos core.math.asin core.math.atan core.math.atan2 core.math.cos core.math.sin core.math.tan", coverage: .Covered, note: "correctly rounded; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "acosh asinh atanh cosh sinh tanh", variants: "f l", jet: "core.math.acosh core.math.asinh core.math.atanh core.math.cosh core.math.sinh core.math.tanh", coverage: .Covered, note: "musl 1.2.5's algorithms, bit for bit, except that acosh is NaN for every x below 1"},
    {area: "Math", header: "math.h", standard: C23, names: "exp exp2 expm1 log log10 log1p log2 logp1", variants: "f l", jet: "core.math.exp core.math.exp2 core.math.exp_m1 core.math.ln core.math.log10 core.math.ln_1p core.math.log2", coverage: .Covered, note: "correctly rounded; logp1 is C23's name for log1p; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "pow sqrt cbrt hypot", variants: "f l", jet: "Float.pow core.math.sqrt core.math.cbrt core.math.hypot", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "erf erfc lgamma tgamma", variants: "f l", jet: "core.math.erf core.math.erfc core.math.lgamma core.math.gamma", coverage: .Covered, note: "musl 1.2.5's algorithms, bit for bit"},
    {area: "Math", header: "math.h", standard: C23, names: "ceil floor trunc round lround llround", variants: "f l", jet: "core.math.ceil core.math.floor core.math.trunc core.math.round", coverage: .Covered, note: "lround and llround are round followed by an Int conversion"},
    {area: "Math", header: "math.h", standard: C23, names: "rint nearbyint lrint llrint roundeven", variants: "f l", jet: "core.math.round_even", coverage: .Covered, note: "Jet fixes round-to-nearest-even, so rint and nearbyint are round_even; lrint and llrint are round_even followed by an Int conversion"},
    {area: "Math", header: "math.h", standard: C23, names: "frexp ldexp modf scalbn scalbln ilogb llogb logb", variants: "f l", jet: "core.math.frexp core.math.ldexp core.math.modf core.math.scaleb core.math.ilogb core.math.logb", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "fmod remainder remquo", variants: "f l", jet: "core.math.fmod core.math.remainder core.math.rem_quo", coverage: .Covered, note: "musl 1.2.5's algorithms, bit for bit"},
    {area: "Math", header: "math.h", standard: C23, names: "fmax fmin fdim", variants: "f l", jet: "core.math.max_float core.math.min_float core.math.fdim", coverage: .Covered, note: "musl 1.2.5's algorithms, bit for bit"},
    {area: "Math", header: "math.h", standard: C23, names: "fabs", variants: "f l", jet: "core.math.fabs", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "fma", variants: "f l", jet: "core.math.fma", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "copysign nextafter nexttoward nextup nextdown nan", variants: "f l", jet: "core.math.copysign core.math.next_after core.math.next_up core.math.next_down core.math.NAN core.math.set_payload", coverage: .Covered, note: "nexttoward is next_after (Float is the widest format); nan with a tag is set_payload of the tag's number"},
    {area: "Math", header: "math.h", standard: C23, names: "fpclassify isfinite isinf isnan isnormal signbit issubnormal iszero iscanonical", variants: "", jet: "core.math.is_finite core.math.is_inf core.math.is_nan core.math.is_normal core.math.sign_bit core.math.is_subnormal core.math.is_zero core.math.is_canonical", coverage: .Covered, note: "fpclassify is the is_* predicates"},
    {area: "Math", header: "math.h", standard: C23, names: "issignaling", variants: "", jet: "core.math.is_signaling", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "isgreater isgreaterequal isless islessequal islessgreater isunordered iseqsig", variants: "", jet: "core.math.is_nan", coverage: .Language, note: "Float comparison operators are quiet; isunordered is is_nan of either operand"},
    {area: "Math", header: "math.h", standard: POSIX, names: "j0 j1 jn y0 y1 yn", variants: "", jet: "", coverage: .Gap, note: "no Bessel functions"},
    {area: "Math", header: "math.h", standard: C23, names: "cospi sinpi tanpi", variants: "f l", jet: "core.math.cos_pi core.math.sin_pi core.math.tan_pi", coverage: .Covered, note: "correctly rounded; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "acospi asinpi atanpi atan2pi", variants: "f l", jet: "core.math.acos_pi core.math.asin_pi core.math.atan_pi core.math.atan2_pi", coverage: .Covered, note: "correctly rounded; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "exp10", variants: "f l", jet: "core.math.exp10", coverage: .Covered, note: "correctly rounded; the f form is an all-F32 call"},
    {area: "Math", header: "math.h", standard: C23, names: "exp10m1 exp2m1", variants: "f l", jet: "core.math.exp10_m1 core.math.exp2_m1", coverage: .Covered, note: "correctly rounded; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "log10p1 log2p1", variants: "f l", jet: "core.math.log10_1p core.math.log2_1p", coverage: .Covered, note: "correctly rounded; the f forms are all-F32 calls"},
    {area: "Math", header: "math.h", standard: C23, names: "rsqrt", variants: "f l", jet: "core.math.rsqrt", coverage: .Covered, note: "correctly rounded; the f form is an all-F32 call"},
    {area: "Math", header: "math.h", standard: C23, names: "pown powr", variants: "f l", jet: "core.math.pow_n core.math.pow_r", coverage: .Covered, note: "correctly rounded; the f forms are F32 calls with an Int exponent for pown"},
    {area: "Math", header: "math.h", standard: C23, names: "compoundn rootn", variants: "f l", jet: "core.math.compound_n core.math.root_n", coverage: .Covered, note: "correctly rounded; the f forms are F32 calls with an Int exponent"},
    {area: "Math", header: "math.h", standard: C23, names: "fromfp ufromfp fromfpx ufromfpx", variants: "f l", jet: "core.math.round_to_signed core.math.round_to_unsigned core.math.Rounding", coverage: .Covered, note: "the x forms are the same calls: Jet has no inexact flag to raise"},
    {area: "Math", header: "math.h", standard: C23, names: "fmaximum fminimum fmaximum_mag fminimum_mag fmaximum_num fminimum_num fmaximum_mag_num fminimum_mag_num", variants: "f l", jet: "core.math.maximum core.math.minimum core.math.maximum_mag core.math.minimum_mag core.math.maximum_num core.math.minimum_num core.math.maximum_mag_num core.math.minimum_mag_num", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "fadd faddl daddl fsub fsubl dsubl fmul fmull dmull fdiv fdivl ddivl ffma ffmal dfmal fsqrt fsqrtl dsqrtl", variants: "", jet: "", coverage: .Gap, note: "no correctly rounded narrowing arithmetic"},
    {area: "Math", header: "math.h", standard: C23, names: "canonicalize totalorder totalordermag getpayload setpayload setpayloadsig", variants: "f l", jet: "core.math.canonicalize core.math.total_order core.math.total_order_mag core.math.get_payload core.math.set_payload core.math.set_payload_signaling", coverage: .Covered, note: ""},
    {area: "Math", header: "math.h", standard: C23, names: "*fN *fNx", variants: "", jet: "F32 Float", coverage: .Partial, note: "optional Annex H interchange-format variants of every math.h function; F32 and Float are binary32 and binary64, with no binary16 or binary128"},
    {area: "Math", header: "math.h", standard: C23, names: "*dN quantizedN samequantumdN quantumdN llquantexpdN encodedecdN decodedecdN encodebindN decodebindN", variants: "", jet: "core.math.Decimal", coverage: .Partial, note: "optional decimal floating point; Decimal is exact arbitrary-precision decimal, not IEEE 754 decimal32/64/128"},
    // ---- Floating-point environment ----
    {area: "Floating-point environment", header: "fenv.h", standard: C23, names: "feclearexcept fegetexceptflag feraiseexcept fesetexceptflag fetestexcept fesetexcept fetestexceptflag", variants: "", jet: "", coverage: .Gap, note: "Jet has no floating-point status flags"},
    {area: "Floating-point environment", header: "fenv.h", standard: C23, names: "fegetround fesetround fegetenv feholdexcept fesetenv feupdateenv fegetmode fesetmode fe_dec_getround fe_dec_setround", variants: "", jet: "", coverage: .Gap, note: "Jet fixes round-to-nearest-even and has no floating-point environment"},
    // ---- Complex ----
    {area: "Complex", header: "complex.h", standard: C23, names: "CMPLX CMPLXF CMPLXL", variants: "", jet: "core.math.Complex", coverage: .Covered, note: ""},
    {area: "Complex", header: "complex.h", standard: C23, names: "creal cimag conj cabs", variants: "f l", jet: "core.math.Complex core.math.real core.math.imag core.math.conj", coverage: .Covered, note: "Complex has abs and the arithmetic operators"},
    {area: "Complex", header: "complex.h", standard: C23, names: "carg cproj cexp clog cpow csqrt csin ccos ctan casin cacos catan csinh ccosh ctanh casinh cacosh catanh", variants: "f l", jet: "", coverage: .Gap, note: "no complex elementary functions"},
    // ---- Integer arithmetic ----
    {area: "Integer arithmetic", header: "stdlib.h", standard: C23, names: "abs labs llabs div ldiv lldiv", variants: "", jet: "core.math.abs core.math.div_rem", coverage: .Covered, note: ""},
    {area: "Integer arithmetic", header: "inttypes.h", standard: C23, names: "imaxabs imaxdiv", variants: "", jet: "core.math.abs core.math.div_rem", coverage: .Covered, note: ""},
    {area: "Integer arithmetic", header: "stdckdint.h", standard: C23, names: "ckd_add ckd_sub ckd_mul", variants: "", jet: "core.math.checked_add core.math.checked_sub core.math.checked_mul", coverage: .Covered, note: ""},
    // ---- Bit utilities ----
    {area: "Bit utilities", header: "stdbit.h", standard: C23, names: "stdc_leading_zeros stdc_leading_ones stdc_trailing_zeros stdc_trailing_ones stdc_count_zeros stdc_count_ones stdc_bit_width", variants: "_uc _us _ui _ul _ull", jet: "Int.leading_zeros core.math.leading_ones Int.trailing_zeros core.math.trailing_ones Int.count_zeros Int.count_ones Int.bit_length", coverage: .Covered, note: ""},
    {area: "Bit utilities", header: "stdbit.h", standard: C23, names: "stdc_first_leading_zero stdc_first_leading_one stdc_first_trailing_zero stdc_first_trailing_one stdc_has_single_bit stdc_bit_floor stdc_bit_ceil", variants: "_uc _us _ui _ul _ull", jet: "Int.leading_zeros Int.trailing_zeros Int.count_ones Int.bit_length", coverage: .Partial, note: "each is one expression over the counts; no direct names"},
    {area: "Bit utilities", header: "strings.h", standard: POSIX, names: "ffs ffsl ffsll", variants: "", jet: "Int.trailing_zeros", coverage: .Covered, note: "ffs is trailing_zeros plus one, 0 for 0"},
    {area: "Bit utilities", header: "endian.h", standard: POSIX, names: "be16toh be32toh be64toh htobe16 htobe32 htobe64 htole16 htole32 htole64 le16toh le32toh le64toh", variants: "", jet: "core.encoding.binary.pack_u16be core.encoding.binary.unpack_u16be core.encoding.binary.pack_u32le core.encoding.binary.unpack_u64be", coverage: .Covered, note: "byte order is explicit in the pack and unpack names"},
    {area: "Bit utilities", header: "arpa/inet.h", standard: POSIX, names: "htonl htons ntohl ntohs", variants: "", jet: "core.encoding.binary.pack_u32be core.encoding.binary.unpack_u32be core.encoding.binary.pack_u16be core.encoding.binary.unpack_u16be", coverage: .Covered, note: ""},
    // ---- Characters ----
    {area: "Characters", header: "ctype.h", standard: C23, names: "isalnum isalpha isdigit isspace isupper islower isprint iscntrl tolower toupper", variants: "", jet: "core.text.parse.is_alnum core.text.is_alphabetic core.text.parse.is_digit core.text.parse.is_space core.text.parse.is_upper core.text.parse.is_lower String.isprintable core.text.has_control core.text.lower core.text.upper", coverage: .Covered, note: "Unicode-aware and locale-independent"},
    {area: "Characters", header: "ctype.h", standard: C23, names: "isblank isgraph ispunct isxdigit", variants: "", jet: "core.text.parse.is_blank core.text.parse.is_graphic core.text.parse.is_punctuation core.text.parse.is_hex_digit", coverage: .Covered, note: "ASCII, as the C locale classifies"},
    {area: "Characters", header: "ctype.h", standard: POSIX, names: "isalnum_l isalpha_l isblank_l iscntrl_l isdigit_l isgraph_l islower_l isprint_l ispunct_l isspace_l isupper_l isxdigit_l tolower_l toupper_l", variants: "", jet: "", coverage: .NotNeeded, note: "Jet's classification is locale-independent, so it takes no locale object (owner ruling on #6696)"},
    {area: "Characters", header: "wctype.h", standard: C23, names: "iswalnum iswalpha iswdigit iswspace iswupper iswlower iswprint iswcntrl towlower towupper", variants: "", jet: "core.text.parse.is_alnum core.text.is_alphabetic core.text.parse.is_digit core.text.parse.is_space core.text.parse.is_upper core.text.parse.is_lower String.isprintable core.text.has_control core.text.lower core.text.upper", coverage: .Covered, note: "Jet strings are Unicode, so the wide forms are the same calls"},
    {area: "Characters", header: "wctype.h", standard: C23, names: "iswblank iswgraph iswpunct iswxdigit", variants: "", jet: "core.text.is_blank core.text.is_graphic core.text.is_punctuation core.text.parse.is_hex_digit", coverage: .Covered, note: "Unicode General_Category; a hexadecimal digit is ASCII in C too"},
    {area: "Characters", header: "wctype.h", standard: C23, names: "iswctype wctype towctrans wctrans", variants: "", jet: "core.text.is_alphabetic core.text.upper", coverage: .Language, note: "a class or mapping is a function value: pass a closure such as `w -> text.is_alphabetic(w)` where C passes a wctype_t or wctrans_t"},
    {area: "Characters", header: "wctype.h", standard: POSIX, names: "iswalnum_l iswalpha_l iswblank_l iswcntrl_l iswctype_l iswdigit_l iswgraph_l iswlower_l iswprint_l iswpunct_l iswspace_l iswupper_l iswxdigit_l towctrans_l towlower_l towupper_l wctrans_l wctype_l", variants: "", jet: "", coverage: .NotNeeded, note: "Jet's classification is locale-independent, so it takes no locale object (owner ruling on #6696)"},
    // ---- Strings and memory blocks ----
    {area: "Strings", header: "string.h", standard: C23, names: "memcpy memmove memcmp memchr memccpy", variants: "", jet: "Bytes.copy_to Bytes.compare Bytes.index_of", coverage: .Covered, note: "memccpy is index_of then copy_to"},
    {area: "Strings", header: "string.h", standard: C23, names: "memset", variants: "", jet: "core.crypto.wipe", coverage: .Language, note: "a loop assigns a value over an index range of a list; core.crypto.wipe zeroes a whole [U8]"},
    {area: "Strings", header: "string.h", standard: POSIX, names: "memmem", variants: "", jet: "Bytes.index_of", coverage: .Covered, note: ""},
    {area: "Strings", header: "string.h", standard: C23, names: "memset_explicit", variants: "", jet: "core.crypto.wipe", coverage: .Covered, note: "each byte is an effectful store that no optimization drops; spare capacity is zeroed too"},
    {area: "Strings", header: "string.h", standard: C23, names: "strcpy strncpy strcat strncat strdup strndup", variants: "", jet: "String.slice", coverage: .Language, note: "String values are owned and immutable: `+`, interpolation and slice replace copying into buffers"},
    {area: "Strings", header: "string.h", standard: POSIX, names: "stpcpy stpncpy strlcpy strlcat", variants: "", jet: "String.slice", coverage: .Language, note: "String values are owned; no destination buffers"},
    {area: "Strings", header: "string.h", standard: C23, names: "strcmp strncmp strcoll strxfrm", variants: "", jet: "String.compare core.text.collate core.text.collation_key", coverage: .Covered, note: "collation is Unicode collation, not locale collation"},
    {area: "Strings", header: "string.h", standard: POSIX, names: "strcoll_l strxfrm_l", variants: "", jet: "core.text.collate core.text.collation_key", coverage: .Covered, note: "Unicode collation; a locale argument is not needed (owner ruling on #6696)"},
    {area: "Strings", header: "strings.h", standard: POSIX, names: "strcasecmp strncasecmp strcasecmp_l strncasecmp_l", variants: "", jet: "core.text.caseless_eq core.text.casefold", coverage: .Covered, note: "Unicode case folding"},
    {area: "Strings", header: "string.h", standard: C23, names: "strchr strrchr strstr strlen strtok", variants: "", jet: "String.find String.rfind String.contains String.len String.count_bytes String.split", coverage: .Covered, note: ""},
    {area: "Strings", header: "string.h", standard: POSIX, names: "strnlen strtok_r", variants: "", jet: "String.count_bytes String.split", coverage: .Covered, note: ""},
    {area: "Strings", header: "string.h", standard: C23, names: "strpbrk strspn strcspn", variants: "", jet: "core.regex.find", coverage: .Partial, note: "a character-class regex; no direct span call"},
    {area: "Strings", header: "string.h", standard: C23, names: "strerror", variants: "", jet: "", coverage: .Language, note: "errors are typed values that carry and print their message"},
    {area: "Strings", header: "string.h", standard: POSIX, names: "strerror_l strerror_r", variants: "", jet: "", coverage: .Language, note: "errors are typed values that carry and print their message"},
    {area: "Strings", header: "unistd.h", standard: POSIX, names: "swab", variants: "", jet: "core.encoding.binary.byteswap", coverage: .Covered, note: "byteswap(data, 2); an odd length is an error"},
    {area: "Strings", header: "stdlib.h", standard: C23, names: "*_s", variants: "", jet: "", coverage: .Language, note: "optional Annex K bounds-checked interfaces; every Jet string and list access is bounds-checked"},
    // ---- Wide and multibyte text ----
    {area: "Wide and multibyte text", header: "stdlib.h", standard: C23, names: "mblen mbtowc wctomb mbstowcs wcstombs", variants: "", jet: "String.chars String.bytes String.from_bytes", coverage: .Covered, note: "UTF-8; locale multibyte encodings are not needed (owner ruling on #6696)"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: C23, names: "btowc wctob mbrlen mbrtowc wcrtomb mbsinit mbsrtowcs wcsrtombs", variants: "", jet: "String.chars String.bytes String.from_bytes", coverage: .Covered, note: "UTF-8, converted whole; locale multibyte encodings and their restartable state are not needed (owner ruling on #6696)"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: POSIX, names: "mbsnrtowcs wcsnrtombs", variants: "", jet: "String.chars String.bytes String.from_bytes", coverage: .Covered, note: "UTF-8; locale multibyte encodings are not needed (owner ruling on #6696)"},
    {area: "Wide and multibyte text", header: "uchar.h", standard: C23, names: "c16rtomb c32rtomb mbrtoc16 mbrtoc32 mbrtoc8 c8rtomb", variants: "", jet: "String.chars String.encode String.from_bytes", coverage: .Covered, note: "char32 is Char; UTF-16 through encode; locale multibyte encodings are not needed (owner ruling on #6696)"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: C23, names: "wcscpy wcsncpy wcscat wcsncat wcscmp wcsncmp wcscoll wcsxfrm wcschr wcsrchr wcsstr wcspbrk wcsspn wcscspn wcstok wcslen wmemcpy wmemmove wmemcmp wmemchr wmemset", variants: "", jet: "String.find String.compare core.text.collate", coverage: .Language, note: "Jet strings are Unicode; the wide functions are the String API"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: POSIX, names: "wcpcpy wcpncpy wcsdup wcsnlen wcslcpy wcslcat wcscasecmp wcsncasecmp wcscasecmp_l wcsncasecmp_l wcscoll_l wcsxfrm_l", variants: "", jet: "String.slice core.text.caseless_eq core.text.collate", coverage: .Language, note: "Jet strings are Unicode; no locale argument"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: C23, names: "fgetwc fgetws fputwc fputws fwide getwc getwchar putwc putwchar ungetwc fwprintf fwscanf swprintf swscanf vfwprintf vfwscanf vswprintf vswscanf vwprintf vwscanf wprintf wscanf", variants: "", jet: "core.term.print core.term.readline", coverage: .Language, note: "streams carry UTF-8 Strings; there is no wide orientation"},
    {area: "Wide and multibyte text", header: "wchar.h", standard: POSIX, names: "open_wmemstream", variants: "", jet: "Bytes.write", coverage: .Language, note: "a Bytes buffer is the memory stream"},
