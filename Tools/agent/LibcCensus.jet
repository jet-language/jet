// One C name of a family, or its pattern.
family_names: fn(family: Family) -> [String] Never! {
    out := [String]{}
    suffixes := [String]{}
    if family.variants != "" {
        loop suffix in family.variants.split(" ") -> suffixes.push(suffix.copy())
    }
    loop name in family.names.split(" ") {
        out.push(name.copy())
        if name.contains("*") -> next
        loop suffix in suffixes -> out.push("{name}{suffix}")
    }
    out
}

is_pattern: fn(name: String) -> Bool Never! { name.contains("*") }

// Core.jet's exported members, keyed by module.
core_exports: fn() -[FS]> [String: [String]] CensusError! {
    text: files.read(CORE_PRELUDE_PATH) ?? return Err(census_fail("cannot read {CORE_PRELUDE_PATH}: {err}"))
    out := [String: [String]]{}
    loop line in text.split("\n") {
        if !line.starts_with("module ") -> next
        open: line.find(" exports {{ ")
        if open < 0 -> next
        name: line.slice(7, open)
        rest: line.slice(open + 11, line.len())
        close: rest.find(" }}")
        if close < 0 -> next
        members := [String]{}
        loop member in rest.slice(0, close).split(", ") -> members.push(member.copy())
        out[name] = members
    }
    if out.len() == 0 -> return Err(census_fail("{CORE_PRELUDE_PATH} exports no modules"))
    Ok(out)
}

// Core.jet's source file of each source module, keyed by module.
core_sources: fn() -[FS]> [String: String] CensusError! {
    text: files.read(CORE_PRELUDE_PATH) ?? return Err(census_fail("cannot read {CORE_PRELUDE_PATH}: {err}"))
    out := [String: String]{}
    loop line in text.split("\n") {
        if !line.starts_with("source_module ") -> next
        at: line.find(" path ")
        if at < 0 -> next
        rest: line.slice(at + 6, line.len())
        end: rest.find(" ")
        if end < 0 -> next
        out[line.slice(14, at)] = rest.slice(0, end)
    }
    Ok(out)
}

// Whether `source` declares method `method` of `type_name`: a `method: fn`
// line (after any markers) inside the type's `Type: struct {` body or one of
// its `impl Type` blocks.
declares_method: fn(source: String, type_name: String, method: String) -> Bool Never! {
    inside := false
    loop line in source.split("\n") {
        if line == "}}" {
            inside = false
            next
        }
        if !line.starts_with(" ") && line != "" {
            inside = line.starts_with("{type_name}: struct {{") || line.starts_with("impl {type_name} {{") || line.starts_with("impl {type_name}.")
            next
        }
        if !inside -> next
        item: line.trim()
        if item.starts_with("{method}: fn") || item.contains(") {method}: fn") -> return true
    }
    false
}

// The receiver families of the built-in tables that a `<Type>.<method>` claim
// may name.
METHOD_RECEIVERS: [String: [String]]{
    "String": [String]{"String"},
    "Bytes": [String]{"Bytes"},
    "Scalar": [String]{"Scalar"},
    "Float": [String]{"Float", "Scalar"},
    "Int": [String]{"Integer", "ExactInt", "FixedInt", "Scalar"},
    "Atomic": [String]{"Atomic", "AtomicAdd", "AtomicInt"},
    "AtomicAdd": [String]{"AtomicAdd"},
}

// Whether `owner.method` is a built-in method, static or collection operation.
builtin_resolves: fn(owner: String, method: String, methods: String, statics: String, collections: String) -> Bool Never! {
    receivers: METHOD_RECEIVERS.get(owner) ?? [String]{}
    loop receiver in receivers {
        if methods.contains("receiver: BuiltinMethodReceiver.{receiver}, name: \"{method}\"") -> return true
    }
    if statics.contains("owner: \"{owner}\", method: \"{method}\"") -> return true
    collections.contains("receivers: CollectionReceivers.{owner}, name: \"{method}\"")
}

// Every claimed Jet name that does not resolve.
unresolved: fn(exports: [String: [String]], sources: [String: String]) -[FS]> [String] CensusError! {
    methods: files.read(BUILTIN_METHODS_PATH) ?? return Err(census_fail("cannot read {BUILTIN_METHODS_PATH}: {err}"))
    statics: files.read(BUILTIN_STATICS_PATH) ?? return Err(census_fail("cannot read {BUILTIN_STATICS_PATH}: {err}"))
    collections: files.read(COLLECTIONS_PATH) ?? return Err(census_fail("cannot read {COLLECTIONS_PATH}: {err}"))
    problems := [String]{}
    loop family in FAMILIES {
        if family.coverage == .NotNeeded && !family.note.contains(OWNER_RULING) -> problems.push("{family.names}: a not-needed family's note does not cite the {OWNER_RULING}")
        if family.jet == "" {
            if family.coverage == .Covered || family.coverage == .Partial -> problems.push("{family.names}: a {coverage_label(family.coverage)} family names no Jet API")
            next
        }
        if family.coverage == .Gap || family.coverage == .NotNeeded -> problems.push("{family.names}: a {coverage_label(family.coverage)} family names Jet API {family.jet}")
        loop claim in family.jet.split(" ") {
            if claim == "F32" || claim == "Float" -> next
            if claim.starts_with("core.") {
                if exports.has_key(claim) -> next
                dot: claim.rfind(".")
                owner: claim.slice(0, dot)
                member: claim.slice(dot + 1, claim.len())
                if exports.has_key(owner) {
                    members: exports.get(owner) ?? [String]{}
                    if !members.contains(member) -> problems.push("{family.names}: {claim} is not exported by {CORE_PRELUDE_PATH}")
                    next
                }
                type_dot: owner.rfind(".")
                home: owner.slice(0, type_dot)
                type_name: owner.slice(type_dot + 1, owner.len())
                if !(exports.get(home) ?? [String]{}).contains(type_name) {
                    problems.push("{family.names}: {claim}: {owner} is neither a module nor a type exported by {CORE_PRELUDE_PATH}")
                    next
                }
                path: sources.get(home) ?? ""
                if path == "" {
                    problems.push("{family.names}: {claim}: {CORE_PRELUDE_PATH} names no source file for {home}")
                    next
                }
                source: files.read(path) ?? return Err(census_fail("cannot read {path}: {err}"))
                if !declares_method(source, type_name, member) -> problems.push("{family.names}: {claim}: {path} declares no method {member} of {type_name}")
                next
            }
            dot: claim.find(".")
            if dot < 0 {
                problems.push("{family.names}: {claim} is neither core.<module>.<member> nor <Type>.<method>")
                next
            }
            if !builtin_resolves(claim.slice(0, dot), claim.slice(dot + 1, claim.len()), methods, statics, collections) -> problems.push("{family.names}: {claim} is not a built-in method, static or collection operation")
        }
    }
    seen := [String: String]{}
    loop family in FAMILIES {
        loop name in family_names(family) {
            if seen.has_key(name) -> problems.push("{name} is listed twice")
            seen[name] = family.header
        }
    }
    Ok(problems)
}

// The order areas first appear in FAMILIES.
areas: fn() -> [String] Never! {
    out := [String]{}
    loop family in FAMILIES {
        if !out.contains(family.area) -> out.push(family.area.copy())
    }
    out
}

function_count: fn(family: Family) -> Int Never! {
    count := 0
    loop name in family_names(family) {
        if !is_pattern(name) -> count += 1
    }
    count
}

cell: fn(text: String) -> String Never! { if text == "" -> "" else -> text.replace("|", "\\|") }

code_list: fn(text: String) -> String Never! {
    if text == "" -> return ""
    parts := [String]{}
    loop word in text.split(" ") -> parts.push("`{word}`")
    parts.join(" ")
}

c_names: fn(family: Family) -> String Never! {
    shown: code_list(family.names)
    if family.variants == "" -> return shown
    "{shown} (and the {family.variants.split(" ").join(", ")} forms)"
}

report: fn() -> String Never! {
    lines := [String]{}
    lines.push("# libc census")
    lines.push("")
    lines.push("Printed by `jet Tools/agent/LibcCensus.jet`, which first checks that every Jet API a row names exists.")
    lines.push("")
    lines.push("Each row is one function family of C23 or POSIX.1-2024 (whose System Interfaces include C17's library), the Jet API that does its job, and a status:")
    lines.push("")
    lines.push("- **covered**: the named Jet API does the family's job.")
    lines.push("- **partial**: the named Jet API does part of it; the note says what is missing.")
    lines.push("- **language**: the Jet language itself does the job, with no library call.")
    lines.push("- **not needed**: the owner ruled that Jet does not need the family; the note cites the ruling.")
    lines.push("- **GAP**: Jet has no counterpart.")
    lines.push("")
    lines.push("Standard `C23` marks an ISO C function (POSIX.1-2024 carries those C17 already had); `POSIX` marks a POSIX-only one. A name with `*` stands for an optional annex's generated set.")
    lines.push("")
    lines.push("## Summary")
    lines.push("")
    lines.push("| Area | Families | Functions | Covered | Partial | Language | Not needed | GAP |")
    lines.push("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |")
    totals := [Int]{0, 0, 0, 0, 0, 0, 0}
    loop area in areas() {
        counts := [Int]{0, 0, 0, 0, 0, 0, 0}
        loop family in FAMILIES {
            if family.area != area -> next
            counts[0] = counts[0] + 1
            counts[1] = counts[1] + function_count(family)
            slot: if family.coverage == {
                .Covered -> 2
                .Partial -> 3
                .Language -> 4
                .NotNeeded -> 5
                .Gap -> 6
            }
            counts[slot] = counts[slot] + 1
        }
        loop index in 0..<7 -> totals[index] = totals[index] + counts[index]
        lines.push("| {area} | {counts[0]} | {counts[1]} | {counts[2]} | {counts[3]} | {counts[4]} | {counts[5]} | {counts[6]} |")
    }
    lines.push("| **Total** | {totals[0]} | {totals[1]} | {totals[2]} | {totals[3]} | {totals[4]} | {totals[5]} | {totals[6]} |")
    lines.push("")
    lines.push("## Gaps by area")
    lines.push("")
    lines.push("Every GAP and partial family, grouped by area.")
    loop area in areas() {
        rows := [String]{}
        loop family in FAMILIES {
            if family.area != area -> next
            if family.coverage == {
                .Gap -> rows.push(if family.note == "" -> "- GAP: {c_names(family)} (`{family.header}`)" else -> "- GAP: {c_names(family)} (`{family.header}`): {family.note}")
                .Partial -> rows.push("- partial: {c_names(family)} (`{family.header}`): {family.note}")
                else -> {}
            }
        }
        if rows.len() == 0 -> next
        lines.push("")
        lines.push("### {area}")
        lines.push("")
        loop row in rows -> lines.push(row)
    }
    lines.push("")
    lines.push("## Families")
    loop area in areas() {
        lines.push("")
        lines.push("### {area}")
        lines.push("")
        lines.push("| Header | Standard | C functions | Jet | Status | Note |")
        lines.push("| --- | --- | --- | --- | --- | --- |")
        loop family in FAMILIES {
            if family.area != area -> next
            lines.push("| `{family.header}` | {family.standard} | {cell(c_names(family))} | {cell(code_list(family.jet))} | {coverage_label(family.coverage)} | {cell(family.note)} |")
        }
    }
    lines.join("\n")
}

census_main: fn(args: [String]) -[FS]> String CensusError! {
    check_only: args.len() == 1 && args[0] == "--check"
    if args.len() > 1 || (args.len() == 1 && !check_only) -> return Err(census_fail(USAGE))
    exports: core_exports()
    sources: core_sources()
    problems: unresolved(exports, sources)
    if problems.len() > 0 -> return Err(census_fail("libc census: {problems.len()} row problem(s)\n{problems.join("\n")}"))
    if check_only -> return Ok("libc census: every Jet API of {FAMILIES.len()} families resolves")
    Ok(report())
}

#Test("every Jet API the census names exists") {
    exports: core_exports() ?? panic(err.message)
    problems: unresolved(exports, core_sources() ?? panic(err.message)) ?? panic(err.message)
    assert_eq(problems.join("\n"), "")
}

run: fn() {
    if census_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}
