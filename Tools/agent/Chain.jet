#!/usr/bin/env jet
// The compiler chain: export a tree, build its stages through the content
// addressed stage store, take a machine build slot, and the hashing, change
// classification, store and binary checks the chain reads.
//
//   jet Tools/agent/Chain.jet TREE LEVEL|--auto [--out DIR] [--base COMMIT] [--dry-run|--check-gate]
//   jet Tools/agent/Chain.jet export DIR [COMMIT] [PATCH...]
//   jet Tools/agent/Chain.jet seed-published INSTALL_DIR
//   jet Tools/agent/Chain.jet slot [--small|--release] -- CMD...
//   jet Tools/agent/Chain.jet diff TREE BASE REPO
//   jet Tools/agent/Chain.jet plan TREE DIFF.json
//   jet Tools/agent/Chain.jet inputs TREE
//   jet Tools/agent/Chain.jet dirhash DIR
//   jet Tools/agent/Chain.jet packhash DIR
//   jet Tools/agent/Chain.jet evict STORE CAP_GB
//   jet Tools/agent/Chain.jet trapscan ELF
//
// TREE LEVEL runs the chain of a source export (never a git worktree):
//   check         the seed's `jet check` of the packages the tree changes
//                 against its base (`plan` names them)
//   s1            seed builds s1 and its runtime pack, pack1 (`jet build
//                 Compiler` makes both)
//   full          s1, s2 (by s1, with pack2), s3 (by s2): FIXED_POINT when
//                 s2 == s3 (jet and jet.o)
//   full+threads  full, then t1 (s2 with --threads 1) == s3
// --auto picks the level from `plan` (the reasons go to REPORT.md). Results:
// DIR (default TREE/.chain) holds RESULT (TSV: stage status rc wall_s
// peak_rss_mb sha256 key note, then a verdict row), REPORT.md, s1/ s2/ s3/ t1/
// (jet, jet.o, jet-runtime/), keys/ and logs/. The base is --base, else the
// commit `export` wrote to TREE/.chain-base, else dev HEAD. full and
// full+threads need the tree's preflight receipt for the seed (`Land.jet
// receipt check`); --check-gate only checks it. --dry-run builds nothing,
// takes no slot and prints each stage's key and whether the store holds it.
//
// Every stage has a key: SHA-256 over its material (kind, builder sha, its
// pack hash, the `inputs` hash of the tree files the stage reads, identity,
// args) and the canonical root. A stage whose key is in the store is REUSED:
// copied out and verified, never rebuilt. The rest build at the canonical
// root $JET_SCRATCH_ROOT/discovery/r14/snap: each build stage runs in the dev
// shell (Tools/agent/JetEnv.jet --norust, which supplies the C toolchain and
// static musl the runtime pack needs) in a private user and mount namespace
// with the tree bound there, so equal sources give equal binaries whatever
// the tree's path. Only
// clean results are stored (rc 0, no keep-going rows, no `todo` traps). The
// chain first probes the store; a complete hit takes no slot, else the
// stages the store lacks run in one build slot. Each stage process runs in a
// memory scope of CHAIN_MEMMAX (default 24G) with no swap, on the slot's
// CPUs. Settings: CHAIN_SEED (default $JET_SEEDS/current), CHAIN_STORE
// (default $JET_SCRATCH_ROOT/stagestore, cap 20 GB; $JET_RUN_ROOT/stagestore,
// cap 4 GB, when scratch has under 40 GB free), CHAIN_STORE_CAP_GB.
//
// `export` writes COMMIT (default HEAD) of the dev checkout to DIR with
// `git archive`, applies each PATCH and records the commit in DIR/.chain-base.
// `seed-published` stores the lander's census build of INSTALL_DIR (with its
// pack) as the s1 of the tree at the canonical root.
//
// `slot` runs CMD in a machine build slot (A B C D, see take_slot) on its
// CPUs, at nice 19 in the idle I/O class, in a memory scope of
// SLOT_MEMORY_MAX (default 16G) plus 2G, with SLOT_CPUS, CHAIN_CPUS and
// CAP_CPUS set; --small (or SLOT_SMALL=1) queues it in the small class.
// --release takes the release gate's slot R (CPUs 8-31, SLOT_MEMORY_MAX
// default 24G): it claims R, so no other job takes a slot while it waits or
// runs, and holds A, B, C and D once the jobs in them end. Every job appends
// a row to $JET_RUN_ROOT/slot-ledger.tsv.
//
// `diff` prints JSON {base, changed: [{path, status, sha}], digest}: TREE
// against git commit BASE of the checkout REPO. `plan` prints JSON {level,
// reasons, members}: the --auto level and the check members of a `diff`.
// `inputs` prints "HASH N": the content hash and count of the tree files a
// build stage reads. `dirhash` prints the
// content hash of a directory (a runtime pack): every file's relative path and
// bytes. `packhash` prints the digest two runtime packs compare by: every
// file, as `dirhash` reads it, except that the pack's provenance.json counts
// as its canonical JSON without compilerSha256 and recipeSha256, which name
// the compiler that built the pack.
// `evict` removes the least recently used entries of a stage store until it
// is under CAP_GB. Every content hash is SHA-256 over a domain string and a
// NUL, then per file in byte order: u64 big-endian path length, path, u64
// big-endian length, bytes; a symlink counts as "symlink:" and its target.
//
// `trapscan` lists the functions of a built jet that carry a keep-going
// `todo` trap (#5662): `lea "todo"(%rip)` .. `mov $4,%rsi; call
// jet_rt_unreachable`. A sema keep-going stub lowers to exactly that; the
// compiler source has no `todo` expression, so a clean compiler prints
// nothing. Exit 1 when any is found, 2 when the binary has no symbol table or
// no jet_rt_unreachable.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

run: fn() {
    args: process.args()
    if args.len() == 0 -> usage()
    verb: args[0]
    if verb == "trapscan" && args.len() == 2 -> process.exit(trapscan(args[1]))
    if verb == "diff" && args.len() == 4 {
        print(render_diff(diff(absolute(args[1]), args[2], args[3])))
        process.exit(0)
    }
    if verb == "plan" && args.len() == 3 {
        print(render_plan(plan(absolute(args[1]), args[2])))
        process.exit(0)
    }
    if verb == "inputs" && args.len() == 2 {
        tree: absolute(args[1])
        inputs: stage_inputs(tree)
        print("{content_hash(tree, inputs, "chain-build-inputs-v2")} {inputs.len()}")
        process.exit(0)
    }
    if verb == "dirhash" && args.len() == 2 {
        print(dirhash(absolute(args[1])))
        process.exit(0)
    }
    if verb == "packhash" && args.len() == 2 {
        print(packhash(absolute(args[1])))
        process.exit(0)
    }
    if verb == "evict" && args.len() == 3 -> process.exit(evict(args[1], args[2]))
    if verb == "export" && args.len() >= 2 -> process.exit(export_tree(roots(), args.slice(1, args.len())))
    if verb == "seed-published" && args.len() == 2 -> process.exit(chain_main([String]{}, args[1]))
    if verb == "slot" -> process.exit(slot_main(args.slice(1, args.len())))
    if verb == "inroot" -> process.exit(inroot(args.slice(1, args.len())))
    if args.len() >= 2 -> process.exit(chain_main(args, ""))
    usage()
}

usage: fn() -[Exec, IO]> Never {
    term.eprint("usage: jet Tools/agent/Chain.jet TREE LEVEL|--auto [--out DIR] [--base COMMIT] [--dry-run|--check-gate]")
    term.eprint("       (LEVEL: check, s1, full, full+threads)")
    term.eprint("       jet Tools/agent/Chain.jet export DIR [COMMIT] [PATCH...]")
    term.eprint("       jet Tools/agent/Chain.jet seed-published INSTALL_DIR")
    term.eprint("       jet Tools/agent/Chain.jet slot [--small|--release] -- CMD...")
    term.eprint("       jet Tools/agent/Chain.jet diff TREE BASE REPO")
    term.eprint("       jet Tools/agent/Chain.jet plan TREE DIFF.json")
    term.eprint("       jet Tools/agent/Chain.jet inputs TREE")
    term.eprint("       jet Tools/agent/Chain.jet dirhash DIR")
    term.eprint("       jet Tools/agent/Chain.jet packhash DIR")
    term.eprint("       jet Tools/agent/Chain.jet evict STORE CAP_GB")
    term.eprint("       jet Tools/agent/Chain.jet trapscan ELF")
    process.exit(64)
}

fail: fn(message: String) -[Exec, IO]> Never {
    term.eprint("Chain.jet: {message}")
    process.exit(1)
}

absolute: fn(path: String) -[Env, Exec, FS, IO]> String Never! {
    if path.starts_with("/") -> return path.copy()
    files.join(files.cwd() ?? fail("no current directory: {err}"), path)
}

// --- content hashes ---------------------------------------------------------

// Directory names a tree walk skips (build outputs), beside dot names.
SKIPPED: ["target", "build", "node_modules", "bin"]

lstat: fn(path: String) -[Exec, FS, IO]> files.Stat Never! { files.stat(path) ?? fail("cannot stat `{path}`: {err}") }

list: fn(path: String) -[Exec, FS, IO]> [files.DirEntry] Never! { files.list_dir(path) ?? fail("cannot list `{path}`: {err}") }

// Every file under `dir` (relative to `root`), skipping dot names and build
// output names, appended to `out`; `dir` itself when it is not a directory,
// nothing when it does not exist.
walk_into: fn(root: String, dir: String, out: &[String]) -[Exec, FS, IO]> {
    if !files.exists(files.join(root, dir)) -> return
    if !lstat(files.join(root, dir)).is_dir {
        out.push(dir.copy())
        return
    }
    pending := [String]{dir.copy()}
    at := 0
    loop at < pending.len() {
        rel: pending[at].copy()
        at += 1
        loop entry in list(files.join(root, rel)) {
            if entry.name.starts_with(".") || SKIPPED.contains(entry.name) -> next
            child: "{rel}/{entry.name}"
            if lstat(files.join(root, child)).is_dir -> pending.push(child) else -> out.push(child)
        }
    }
}

// `paths` sorted in byte order without repeats.
unique: fn(paths: [String]) -> [String] Never! {
    sorted := paths.copy()
    sorted.sort()
    out := [String]{}
    loop path in sorted {
        if out.len() > 0 && out[out.len() - 1] == path -> next
        out.push(path.copy())
    }
    out
}

be64: fn(value: Int) -> [U8] Never! {
    out := [U8]{}
    loop _ in 0..<8 -> out.push(U8{0})
    rest := value
    loop k in 0..<8 {
        out[7 - k] = U8.from_int(rest % 256) ?? U8{0}
        rest = rest /% 256
    }
    out
}

// The bytes a content hash reads for `path`: a symlink's target text after
// `link_prefix`, else the file's bytes.
entry_bytes: fn(path: String, link_prefix: String) -[Exec, FS, IO]> [U8] Never! {
    if lstat(path).is_symlink -> return "{link_prefix}{files.read_link(path) ?? fail("cannot read link `{path}`: {err}")}".bytes()
    files.read_bytes(path) ?? fail("cannot read `{path}`: {err}")
}

// SHA-256 over `domain`, a NUL, then per path (sorted, unique): u64 path
// length, path, u64 length, bytes.
content_hash: fn(root: String, paths: [String], domain: String) -[Exec, FS, IO]> String Never! {
    hasher := crypto.new()
    head := domain.bytes()
    head.push(U8{0})
    hasher.update(head)
    loop path in unique(paths) {
        bytes: entry_bytes(files.join(root, path), "symlink:")
        hasher.update(be64(path.count_bytes()))
        hasher.update(path.bytes())
        hasher.update(be64(bytes.len()))
        hasher.update(bytes)
    }
    hasher.digest()
}

// Every file under `dir` (relative to it), dot names included.
all_files: fn(dir: String) -[Exec, FS, IO]> [String] Never! {
    found := [String]{}
    pending := [String]{""}
    at := 0
    loop at < pending.len() {
        rel: pending[at].copy()
        at += 1
        loop entry in list(if rel == "" -> dir.copy() else -> files.join(dir, rel)) {
            child: if rel == "" -> entry.name.copy() else -> "{rel}/{entry.name}"
            if lstat(files.join(dir, child)).is_dir -> pending.push(child) else -> found.push(child)
        }
    }
    found
}

dirhash: fn(dir: String) -[Exec, FS, IO]> String Never! { content_hash(dir, all_files(dir), "chain-dirhash-v1") }

// --- pack comparison --------------------------------------------------------

// The provenance.json fields that name the compiler which built a runtime
// pack: s1 and s2 differ, so pack1 and pack2 differ in them even when every
// object and archive is the same.
BUILDER_FIELDS: ["compilerSha256", "recipeSha256"]

PackFile: struct {
    path: String
    bytes: [U8]
}

// A pack's provenance.json.
provenance_path: fn(path: String) -> Bool Never! { path == "provenance.json" }

// A provenance.json as packs compare it: canonical JSON of the object
// without BUILDER_FIELDS; None when it is not a JSON object.
comparable_provenance: fn(bytes: [U8]) -> [U8]? Never! {
    tree: json.parse(String.from_bytes_lossy(bytes)) ?? return None
    if tree == .Object(entries) {
        kept := [String: Dyn]{}
        loop entry in entries {
            if !BUILDER_FIELDS.contains(entry.key) -> kept[entry.key.copy()] = entry.value.copy()
        }
        text: json.canonical(Dyn.Object(kept)) ?? return None
        return Val(text.bytes())
    }
    None
}

// The digest packs compare by: every file framed as a content hash frames
// it, each provenance.json as `comparable_provenance`; None when one is not a
// JSON object.
pack_digest: fn(pack: [PackFile]) -> String? Never! {
    sorted := pack.copy()
    sorted.sort_by((left: PackFile, right: PackFile) -> {
        if left.path < right.path -> return Ordering.Less
        if left.path > right.path -> return Ordering.Greater
        Ordering.Equal
    })
    hasher := crypto.new()
    head := "chain-pack-compare-v1".bytes()
    head.push(U8{0})
    hasher.update(head)
    loop file in sorted {
        bytes: if provenance_path(file.path) -> comparable_provenance(file.bytes) ?? return None else -> file.bytes.copy()
        hasher.update(be64(file.path.count_bytes()))
        hasher.update(file.path.bytes())
        hasher.update(be64(bytes.len()))
        hasher.update(bytes)
    }
    Val(hasher.digest())
}

// The pack-comparison digest of the runtime pack DIR.
packhash: fn(dir: String) -[Exec, FS, IO]> String Never! { pack_compare(dir) ?? fail("a provenance.json of `{dir}` is not a JSON object") }

// `packhash` of DIR, None when a provenance.json of it is not a JSON object.
pack_compare: fn(dir: String) -[Exec, FS, IO]> String? Never! {
    pack := [PackFile]{}
    loop path in all_files(dir) -> pack.push(PackFile{path: path.copy(), bytes: entry_bytes(files.join(dir, path), "symlink:")})
    pack_digest(pack)
}

// --- stage inputs -----------------------------------------------------------

// The dev tool roots' `jet` that runs repository tools: JET_BIN, else the seed.
tool_jet: fn() -[Env]> String Never! {
    bin: process.env_get("JET_BIN") ?? ""
    if bin != "" -> return bin
    seed: process.env_get("JET_SEED") ?? ""
    if seed != "" -> return "{seed}/jet"
    seeds: process.env_get("JET_SEEDS") ?? ""
    if seeds != "" -> return "{seeds}/current/jet"
    data: process.env_get("XDG_DATA_HOME") ?? ""
    if data != "" -> return "{data}/jet-seeds/current/jet"
    "{process.env_get("HOME") ?? ""}/.local/share/jet-seeds/current/jet"
}

// The output rows of Tools/agent/CompilerPackages.jet of `tree`.
compiler_packages: fn(tree: String, args: [String]) -[Env, Exec, FS, IO, Time.Wait]> [String] Never! {
    argv := [String]{tool_jet(), files.join(tree, "Tools/agent/CompilerPackages.jet"), "--root", tree.copy()}
    argv.extend(args.copy())
    receipt: process.cmd(argv).output_limit(268435456).run() ?? fail("{argv[0]}: {err}")
    if receipt.errors.trim() != "" -> term.eprint(receipt.errors.trim())
    if !receipt.success -> fail("Tools/agent/CompilerPackages.jet {args[0]} failed (exit {receipt.code})")
    rows := [String]{}
    loop row in receipt.output.split("\n") {
        if row != "" -> rows.push(row.copy())
    }
    rows
}

// A build stage (`jet build Compiler`, which makes jet and its runtime pack)
// reads the compiler's source identity inputs (workspace files, every package
// the compiler compiles, Core), the Prelude and runtime trees the toolchain
// root serves, the pack recipe (Compiler/Toolchain), Core's vendored C (its
// own packages, which the Core walk skips), every runtime source
// sources.list names, and the dev-shell definition, which fixes the C
// toolchain and musl. Sorted and unique.
stage_inputs: fn(tree: String) -[Env, Exec, FS, IO, Time.Wait]> [String] Never! {
    read := compiler_packages(tree, [String]{"inputs"})
    loop extra in ([String]{"Compiler/Prelude", "Compiler/JetRuntime", "Compiler/Toolchain", "Core/Vendor/Sqlite3", "Core/Vendor/Mbedtls", "env.jet", "flake.nix", "flake.lock"}) -> walk_into(tree, extra, read)
    sources: files.join(tree, "Compiler/JetRuntime/sources.list")
    if files.exists(sources) {
        text: files.read(sources) ?? fail("cannot read `{sources}`: {err}")
        loop line in text.split("\n") {
            row: line.trim()
            if row == "" || row.starts_with("#") -> next
            if files.exists(files.join(tree, row)) -> read.push(row.copy())
        }
    }
    unique(read)
}

// --- diff -------------------------------------------------------------------

Change: struct {
    path: String
    status: String
    sha: String
}

Diff: struct {
    base: String
    changed: [Change]
    digest: String
}

// Git's blob id: sha1 of `blob <length>\0<bytes>`.
blob_hash: fn(bytes: [U8]) -> String Never! {
    framed := "blob {bytes.len()}".bytes()
    framed.push(U8{0})
    framed.extend(bytes.copy())
    crypto.sha1(framed)
}

// The NUL-separated fields of `bytes`, empty ones dropped.
nul_fields: fn(bytes: [U8]) -> [String] Never! {
    out := [String]{}
    start := 0
    loop at in 0..<bytes.len() {
        if Int.from_u8(bytes[at]) != 0 -> next
        if at > start -> out.push(String.from_bytes_lossy(bytes.slice(start, at)))
        start = at + 1
    }
    if bytes.len() > start -> out.push(String.from_bytes_lossy(bytes.slice(start, bytes.len())))
    out
}

// TREE against git commit BASE of REPO: added (A), modified (M) and deleted
// (D) files, by git blob id. Directories the base does not have are skipped
// when they are dot or build-output names (chain outputs, .jet caches,
// keep-going reports), and so is an untracked dot file (.chain-base, a lock),
// so only source changes count.
diff: fn(tree: String, base: String, repo: String) -[Env, Exec, FS, IO, Time.Wait]> Diff Never! {
    listed: process.cmd([String]{"git", "-C", repo.copy(), "ls-tree", "-r", "-z", "--full-tree", base.copy()}).output_limit(268435456).run() ?? fail("git: {err}")
    if !listed.success -> fail("git ls-tree {base} in {repo} failed: {listed.errors.trim()}")
    base_sha := [String: String]{}
    base_paths := [String]{}
    prefixes := [String: Bool]{}
    loop row in nul_fields(listed.output.bytes()) {
        split: row.partition("\t")
        meta: split.head.split(" ").to_list()
        if meta.len() < 3 || meta[1] != "blob" -> next
        path: split.tail.copy()
        base_sha[path.copy()] = meta[2].copy()
        base_paths.push(path.copy())
        prefix := path.copy()
        loop prefix.contains("/") {
            prefix = prefix.rpartition("/").head.copy()
            prefixes[prefix.copy()] = true
        }
    }
    seen := [String: Bool]{}
    changed := [Change]{}
    pending := [String]{""}
    at := 0
    loop at < pending.len() {
        rel: pending[at].copy()
        at += 1
        loop entry in list(if rel == "" -> tree.copy() else -> files.join(tree, rel)) {
            child: if rel == "" -> entry.name.copy() else -> "{rel}/{entry.name}"
            dot: entry.name.starts_with(".")
            if lstat(files.join(tree, child)).is_dir {
                if !prefixes.has_key(child) && (dot || SKIPPED.contains(entry.name)) -> next
                pending.push(child)
                next
            }
            known: base_sha.get(child) ?? ""
            tracked: base_sha.has_key(child)
            if !tracked && dot -> next
            seen[child.copy()] = true
            sha: blob_hash(entry_bytes(files.join(tree, child), ""))
            if !tracked {
                changed.push(Change{path: child.copy(), status: "A", sha: sha})
            } else if known != sha {
                changed.push(Change{path: child.copy(), status: "M", sha: sha})
            }
        }
    }
    loop path in base_paths {
        if !seen.has_key(path) -> changed.push(Change{path: path.copy(), status: "D", sha: ""})
    }
    changed.sort_by((left: Change, right: Change) -> {
        if left.path < right.path -> return Ordering.Less
        if left.path > right.path -> return Ordering.Greater
        Ordering.Equal
    })
    hasher := crypto.new()
    head := "chain-diff-v1".bytes()
    head.push(U8{0})
    head.extend(base.bytes())
    head.push(U8{0})
    hasher.update(head)
    loop change in changed -> hasher.update("{change.status} {change.path} {change.sha}\n".bytes())
    Diff{base: base.copy(), changed: changed, digest: hasher.digest()}
}

render_diff: fn(diff: Diff) -> String Never! {
    rows := [String]{}
    loop change in diff.changed -> rows.push("{{\"path\":{json_text(change.path)},\"status\":{json_text(change.status)},\"sha\":{json_text(change.sha)}}}")
    "{{\"base\":{json_text(diff.base)},\"changed\":[{rows.join(",")}],\"digest\":{json_text(diff.digest)}}}"
}

// `text` as a JSON string, escaped as JavaScript's JSON.stringify does.
json_text: fn(text: String) -> String Never! {
    out := [U8]{U8{34}}
    loop letter in text.bytes() {
        code: Int.from_u8(letter)
        if code == 34 || code == 92 {
            out.push(U8{92})
            out.push(letter)
        } else if code < 32 {
            high: code /% 16
            low: code % 16
            escape: if code == 8 -> "\\b" else if code == 9 -> "\\t" else if code == 10 -> "\\n" else if code == 12 -> "\\f" else if code == 13 -> "\\r" else -> "\\u00{HEX.slice(high..<high + 1)}{HEX.slice(low..<low + 1)}"
            out.extend(escape.bytes())
        } else {
            out.push(letter)
        }
    }
    out.push(U8{34})
    String.from_bytes_lossy(out)
}

HEX: "0123456789abcdef"

// --- plan -------------------------------------------------------------------

// --auto classes, judged per changed path; the chain level is the highest
// class any path needs.
//   full : the code generator and what it links or evaluates: JetIR,
//          JetBackend, JetEval (compile-time evaluation), JetRuntime, Prelude,
//          Bootstrap, the Compiler workspace files, the runtime pack recipe
//          (Compiler/Toolchain), the dev shell (flake.nix/flake.lock), and any
//          compiler source whose file name names comptime, lowering, linking,
//          native objects, emission, the scheduler or threads.
//   s1   : the rest of the compiler front end `jet build Compiler` compiles
//          (JetFoundation, JetLexer, JetParser, JetSema, JetBuildSession,
//          JetDriver, JetCli and the Jetpack packages it reaches) and root
//          env.jet.
//   check: Tests/tests, Examples, Tools, Docs, Core library sources, packages
//          the compiler does not build (JetLSP, JetRepl, ...), and anything no
//          chain stage reads.
FULL_DIRS: ["Compiler/JetIR/", "Compiler/JetBackend/", "Compiler/JetEval/", "Compiler/JetRuntime/", "Compiler/Prelude/", "Compiler/Bootstrap/", "Compiler/Toolchain/"]
FULL_FILES: ["Compiler/package.jet", "Compiler/build.jet", "flake.nix", "flake.lock"]
FULL_NAMES: ["comptime", "lower", "link", "native", "emit", "codegen", "object", "sched", "thread", "parallel"]

Plan: struct {
    level: String
    reasons: [String]
    members: [String]
}

Class: struct {
    level: String
    reason: String
}

rank: fn(level: String) -> Int Never! { if level == "full" -> 2 else if level == "s1" -> 1 else -> 0 }

// The class of the changed `path`; `read` holds the paths a build stage reads.
classify: fn(path: String, read: [String: Bool]) -> Class Never! {
    parts: path.split("/").to_list()
    if parts.contains("Tests") || parts.contains("tests") -> return Class{level: "check", reason: "tests"}
    if FULL_FILES.contains(path) -> return Class{level: "full", reason: if path.starts_with("flake") -> "dev shell definition" else -> "Compiler workspace file"}
    loop dir in FULL_DIRS {
        if path.starts_with(dir) -> return Class{level: "full", reason: "{dir.slice(0..<dir.count_bytes() - 1)} (code generation, runtime or runtime pack)"}
    }
    if parts[0] == "Core" -> return Class{level: "check", reason: "Core library source"}
    if parts[0] == "Examples" || parts[0] == "Docs" || parts[0] == "Tools" -> return Class{level: "check", reason: parts[0].copy()}
    if read.has_key(path) {
        name: parts[parts.len() - 1].lower()
        loop word in FULL_NAMES {
            if name.contains(word) -> return Class{level: "full", reason: "compiler source named for comptime/lowering/linking/emission/scheduler/threads"}
        }
        area: if parts.len() > 1 -> "{parts[0]}/{parts[1]}" else -> parts[0].copy()
        return Class{level: "s1", reason: "compiler front end ({area})"}
    }
    if path == "env.jet" -> return Class{level: "s1", reason: "toolchain env.jet"}
    Class{level: "check", reason: "not read by any chain stage"}
}

// The package a changed file belongs to: its nearest directory with a
// package.jet, "" when none has one.
owner_package: fn(tree: String, path: String) -[FS]> String Never! {
    dir := path.copy()
    loop dir.contains("/") {
        dir = dir.rpartition("/").head.copy()
        if files.exists(files.join(tree, "{dir}/package.jet")) -> return dir.copy()
    }
    ""
}

// The --auto level of a `diff` (DIFF.json), why, and the packages `check`
// checks.
plan: fn(tree: String, diff_path: String) -[Env, Exec, FS, IO, Time.Wait]> Plan Never! {
    text: files.read(diff_path) ?? fail("cannot read `{diff_path}`: {err}")
    parsed: json.parse(text) ?? fail("`{diff_path}` is not JSON: {err}")
    paths := [String]{}
    loop change in array_field(parsed, "changed") -> paths.push(text_field(change, "path"))
    read := [String: Bool]{}
    loop path in stage_inputs(tree) -> read[path.copy()] = true
    selector := [String]{"select"}
    selector.extend(paths.copy())
    loop path in compiler_packages(tree, selector) -> read[path.copy()] = true
    compiler_dirs := [String: Bool]{}
    loop row in compiler_packages(tree, [String]{"packages"}) {
        fields: row.split("\t").to_list()
        if fields.len() > 1 -> compiler_dirs[fields[1].copy()] = true
    }
    level := "check"
    keys := [String]{}
    grouped := [[String]]{}
    members := [String]{}
    loop path in paths {
        class: classify(path, read)
        if rank(class.level) > rank(level) -> level = class.level.copy()
        key: "{class.level}: {class.reason}"
        slot := keys.len()
        loop index in 0..<keys.len() {
            if keys[index] == key {
                slot = index
                break
            }
        }
        if slot == keys.len() {
            keys.push(key)
            grouped.push([String]{})
        }
        grouped[slot].push(path.copy())
        if !path.ends_with(".jet") -> next
        // A compiler package (or Core, which every compiler package reads) is
        // checked through Compiler/JetCli, whose check covers every package it
        // depends on; other packages are checked themselves.
        owner := if path.starts_with("Core/") -> "Compiler/JetCli" else -> owner_package(tree, path)
        if compiler_dirs.has_key(owner) -> owner = "Compiler/JetCli"
        if owner != "" && !members.contains(owner) -> members.push(owner.copy())
    }
    reasons := [String]{}
    loop wanted in ([Int]{2, 1, 0}) {
        loop index in 0..<keys.len() {
            key: keys[index]
            if rank(key.partition(":").head) != wanted -> next
            named: grouped[index]
            shown := [String]{}
            loop place in 0..<named.len() {
                if place < 4 -> shown.push(named[place].copy())
            }
            plural: if named.len() == 1 -> "" else -> "s"
            more: if named.len() > 4 -> " ..." else -> ""
            reasons.push("{key} ({named.len()} file{plural}: {shown.join(" ")}{more})")
        }
    }
    if paths.len() == 0 -> reasons.push("no changes against the base: check (nothing to check)")
    members.sort()
    Plan{level: level, reasons: reasons, members: members}
}

render_plan: fn(plan: Plan) -> String Never! {
    reasons := [String]{}
    loop reason in plan.reasons -> reasons.push(json_text(reason))
    members := [String]{}
    loop member in plan.members -> members.push(json_text(member))
    "{{\"level\":{json_text(plan.level)},\"reasons\":[{reasons.join(",")}],\"members\":[{members.join(",")}]}}"
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

array_field: fn(tree: Dyn, name: String) -> [Dyn] Never! {
    if field(tree, name) == .Array(items) -> return items.copy()
    [Dyn]{}
}

// --- store ------------------------------------------------------------------

StoreEntry: struct {
    name: String
    dir: String
    bytes: Int
    used: Int
}

GIB: 1073741824

stage_key: fn(name: String) -> Bool Never! {
    if name.count_bytes() != 64 -> return false
    loop letter in name.bytes() {
        code: Int.from_u8(letter)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// The `bytes=N` row of a store entry's meta, 0 when it has none.
meta_bytes: fn(meta: String) -> Int Never! {
    loop line in meta.split("\n") {
        if line.starts_with("bytes=") -> return Int.parse(line.slice(6..<line.count_bytes())) ?? 0
    }
    0
}

// Remove the least recently used entries of STORE (by the mtime of each
// entry's .used, else of the entry) until its entries' meta `bytes` total is
// at most CAP_GB; entries without a readable meta are not counted.
evict: fn(store: String, cap_text: String) -[Exec, FS, IO]> Int Never! {
    cap_gb: Float.parse(cap_text) ?? {
        term.eprint("Chain.jet evict: CAP_GB `{cap_text}` is not a number")
        return 64
    }
    if cap_gb < 0.0 {
        term.eprint("Chain.jet evict: CAP_GB `{cap_text}` is negative")
        return 64
    }
    print(evict_store(store, cap_text, cap_gb))
    0
}

// `evict` of STORE to `cap_gb` (shown as `cap_text`); the line it reports.
evict_store: fn(store: String, cap_text: String, cap_gb: Float) -[Exec, FS, IO]> String Never! {
    cap: cap_gb * Float.from_int(GIB)
    entries := [StoreEntry]{}
    loop item in list(store) {
        if !stage_key(item.name) -> next
        dir: files.join(store, item.name)
        meta: files.read(files.join(dir, "meta")) ?? next
        used: files.getmtime(files.join(dir, ".used")) ?? files.getmtime(dir) ?? 0
        entries.push(StoreEntry{name: item.name.copy(), dir: dir, bytes: meta_bytes(meta), used: used})
    }
    total := 0
    loop entry in entries -> total += entry.bytes
    entries.sort_by((left: StoreEntry, right: StoreEntry) -> {
        if left.used < right.used -> return Ordering.Less
        if left.used > right.used -> return Ordering.Greater
        Ordering.Equal
    })
    gone := [String]{}
    loop entry in entries {
        if Float.from_int(total) <= cap -> break
        files.remove_all(entry.dir) ?? ()
        total -= entry.bytes
        gone.push(entry.name.slice(0..<16))
    }
    named: if gone.len() > 0 -> ": {gone.join(" ")}" else -> ""
    "store {hundredths(total)} GB of {cap_text} GB; evicted {gone.len()}{named}"
}

// `bytes` in GiB with two decimals, rounded half up.
hundredths: fn(bytes: Int) -> String Never! {
    scaled: (bytes * 200 + GIB) /% (2 * GIB)
    cents: scaled % 100
    "{scaled /% 100}.{if cents < 10 -> "0" else -> ""}{cents}"
}

// --- roots ------------------------------------------------------------------

// `name` from the environment, else `fallback`; an empty value is unset.
env_or: fn(name: String, fallback: String) -[Env]> String Never! {
    value: process.env_get(name) ?? ""
    if value != "" -> value.copy() else -> fallback.copy()
}

// The value `${XDG_CONFIG_HOME:-~/.config}/jet/env` assigns to `name`.
env_file_value: fn(name: String) -[Env, FS]> String? Never! {
    home: env_or("HOME", "")
    text: files.read("{env_or("XDG_CONFIG_HOME", "{home}/.config")}/jet/env") ?? return None
    found := ""
    seen := false
    loop raw in text.lines() {
        line: raw.trim().removeprefix("export ").trim()
        parts: line.partition("=")
        if parts.sep == "" || parts.head != name -> next
        value := parts.tail
        quoted: (value.starts_with("\"") && value.ends_with("\"")) || (value.starts_with("'") && value.ends_with("'"))
        if value.len() >= 2 && quoted -> value = value.removeprefix("\"").removesuffix("\"").removeprefix("'").removesuffix("'")
        found = value.replace("$HOME", home)
        seen = true
    }
    if seen -> Val(found) else -> None
}

root_of: fn(name: String, fallback: String) -[Env, FS]> String Never! { env_or(name, env_file_value(name) ?? fallback) }

// The dev tool roots (the table of Tools/agent/roots.sh), the checkout whose
// tools run (JET_TOOLCHAIN_ROOT, else the current directory) and the
// canonical build root.
Roots: struct {
    state: String
    scratch: String
    run: String
    seeds: String
    tools: String
    repo: String
    r14: String
    root: String
}

roots: fn() -[Env, Exec, FS, IO]> Roots Never! {
    home: env_or("HOME", "")
    state: root_of("JET_STATE_ROOT", "{env_or("XDG_CACHE_HOME", "{home}/.cache")}/jet-dev")
    scratch: root_of("JET_SCRATCH_ROOT", state)
    run: root_of("JET_RUN_ROOT", "{scratch}/run")
    seeds: root_of("JET_SEEDS", "{env_or("XDG_DATA_HOME", "{home}/.local/share")}/jet-seeds")
    named: env_or("JET_TOOLCHAIN_ROOT", "")
    tools: if named != "" -> absolute(named) else -> files.cwd() ?? fail("no current directory: {err}")
    r14: "{scratch}/discovery/r14"
    Roots{state: state, scratch: scratch, run: run, seeds: seeds, tools: tools.copy(), repo: root_of("JET_DEV_WORKTREE", tools), r14: r14.copy(), root: "{r14}/snap"}
}

// --- small helpers ----------------------------------------------------------

under: fn(path: String, dir: String) -> Bool Never! { path == dir || path.starts_with("{dir}/") }

prefix: fn(text: String, count: Int) -> String Never! { if text.count_bytes() <= count -> text.copy() else -> text.slice(0..<count).copy() }

pad: fn(text: String, width: Int) -> String Never! {
    out := text.copy()
    loop out.count_bytes() < width -> out = "{out} "
    out
}

basename: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    parts[parts.len() - 1].copy()
}

first_line: fn(path: String) -[FS]> String Never! { (files.read(path) ?? "").partition("\n").head.trim().copy() }

// Nanoseconds as seconds with one decimal.
tenths: fn(ns: Int) -> String Never! {
    scaled: (ns + 50000000) /% 100000000
    "{scaled /% 10}.{scaled % 10}"
}

// The UTC wall clock as HH:MM:SS, after the date and `date_sep` when one is given.
now_text: fn(date_sep: String?) -[Time]> String Never! {
    now: time.now()
    clock: "{two(now.hour())}:{two(now.minute())}:{two(now.second())}"
    if date_sep == .Val(sep) -> "{time.strftime("%Y-%m-%d", now)}{sep}{clock}" else -> clock
}

two: fn(n: Int) -> String Never! { if n < 10 -> "0{n}" else -> "{n}" }

stamp: fn() -[Time]> String Never! { now_text(.Val(" ")) }

say: fn(text: String) -[IO, Time]> { print("{now_text(None)} {text}") }

sha_file: fn(path: String) -[Exec, FS, IO]> String Never! {
    hasher := crypto.new()
    hasher.update(files.read_bytes(path) ?? fail("cannot read `{path}`: {err}"))
    hasher.digest()
}

// `24G`, `512M`, `64K` or a byte count, in bytes.
memory_bytes: fn(text: String) -> Int Never! {
    units: [String]{"K", "M", "G"}
    loop at in 0..<units.len() {
        if !text.ends_with(units[at]) -> next
        scale := 1024
        loop _ in 0..<at -> scale *= 1024
        return (Int.parse(text.removesuffix(units[at])) ?? 0) * scale
    }
    Int.parse(text) ?? 0
}

// `4-9,20-25` as the CPUs it names.
parse_cpus: fn(text: String) -> [Int] Never! {
    cpus := [Int]{}
    loop part in text.split(",") {
        span: part.trim().partition("-")
        first: Int.parse(span.head) ?? next
        last: if span.sep == "" -> first else -> Int.parse(span.tail) ?? first
        loop cpu in first..<(last + 1) -> cpus.push(cpu)
    }
    cpus
}

// The lane a path names (`.../lanes/<Lane>/...` or `.../tdev/<Lane>/...`).
lane_of: fn(text: String) -> String Never! {
    markers: [String]{"tdev/", "lanes/"}
    loop marker in markers {
        rest: text.partition(marker)
        if rest.sep == "" -> next
        count := 0
        loop letter in rest.tail.bytes() {
            code: Int.from_u8(letter)
            if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) -> break
            count += 1
        }
        if count > 0 -> return rest.tail.slice(0..<count).copy()
    }
    ""
}

// PATH without the directories that hold cargo, rustc or rustup: the
// compiler chain must not need them.
RUST_TOOLS: ["cargo", "rustc", "rustup"]

norust_path: fn() -[Env, FS]> String Never! {
    kept := [String]{}
    loop dir in env_or("PATH", "").split(":") {
        holds := false
        loop name in RUST_TOOLS {
            if files.is_file(files.join(dir, name)) -> holds = true
        }
        if !holds -> kept.push(dir.copy())
    }
    kept.join(":")
}

git_line: fn(repo: String, args: [String]) -[Env, Exec, FS, IO, Time.Wait]> String? Never! {
    argv := [String]{"git", "-C", repo.copy()}
    argv.extend(args.copy())
    receipt: process.cmd(argv).output_limit(268435456).run() ?? return None
    if !receipt.success -> return None
    Val(receipt.output.trim().copy())
}

// The rows of a keep-going report after its header.
keep_going_rows: fn(path: String) -[FS]> Int Never! {
    text: files.read(path) ?? return 0
    lines: text.split("\n").to_list()
    count := 0
    loop at in 1..<lines.len() {
        if lines[at] != "" -> count += 1
    }
    count
}

// The first two lines of a stage's error log, on one line.
err_head: fn(path: String) -[FS]> String Never! {
    text: files.read(path) ?? return ""
    kept := [String]{}
    loop line in text.split("\n") {
        if line.starts_with("norust: ") -> next
        kept.push(line.replace("\t", " "))
        if kept.len() == 2 -> break
    }
    prefix(kept.join(" "), 160)
}

// --- copies -----------------------------------------------------------------

// Plain copies, never hard links: the compiler refuses source and pack inputs
// with more than one link (E2105). A copy is writable by its owner.
copy_plain: fn(from: String, to: String) -[Exec, FS, IO]> {
    files.copy(from, to) ?? fail("cannot copy `{from}` to `{to}`: {err}")
    mode: lstat(to).mode % 4096
    if (mode /% 128) % 2 == 0 -> files.set_mode(to, mode + 128) ?? ()
}

copy_tree: fn(from: String, to: String) -[Exec, FS, IO]> {
    files.create_dir_all(to) ?? fail("cannot create `{to}`: {err}")
    loop entry in list(from) {
        source: files.join(from, entry.name)
        target: files.join(to, entry.name)
        found: lstat(source)
        if found.is_symlink {
            files.symlink(files.read_link(source) ?? fail("cannot read link `{source}`: {err}"), target) ?? fail("cannot link `{target}`: {err}")
        } else if found.is_dir {
            copy_tree(source, target)
        } else {
            copy_plain(source, target)
        }
    }
}

same_file: fn(left: String, right: String) -[FS]> Bool Never! {
    one: files.read_bytes(left) ?? return false
    two: files.read_bytes(right) ?? return false
    one == two
}

// `mode` without its write bits.
without_write: fn(mode: Int) -> Int Never! {
    out := mode % 4096
    bits: [Int]{128, 16, 2}
    loop bit in bits {
        if (out /% bit) % 2 == 1 -> out -= bit
    }
    out
}

// --- export -----------------------------------------------------------------

// `export DIR [COMMIT] [PATCH...]`.
export_tree: fn(r: Roots, args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    dir: absolute(args[0])
    commit: if args.len() > 1 -> args[1].copy() else -> "HEAD"
    sha: git_line(r.repo, [String]{"rev-parse", "--verify", "{commit}^{{commit}}"}) ?? {
        print("Chain.jet export: unknown commit {commit}")
        return 2
    }
    if under(dir, r.r14) {
        print("refuse: {dir} is under {r.r14}")
        return 2
    }
    files.remove_all(dir) ?? ()
    files.create_dir_all(dir) ?? fail("cannot create `{dir}`: {err}")
    archive: "{dir}.export-{sys.pid()}.tar"
    archived: process.cmd([String]{"git", "-C", r.repo.copy(), "archive", "--format=tar", "-o", archive, sha.copy()}).run() ?? fail("git archive: {err}")
    ok := archived.success
    if ok {
        unpacked: process.cmd([String]{"tar", "-x", "-f", archive, "-C", dir.copy()}).run() ?? fail("tar: {err}")
        ok = unpacked.success
    }
    files.remove(archive) ?? ()
    if !ok {
        print("EXPORT FAILED")
        return 1
    }
    patches := 0
    loop at in 2..<args.len() {
        applied: process.cmd([String]{"git", "apply", absolute(args[at])}).cwd(dir).run() ?? fail("git apply: {err}")
        if !applied.success {
            print("APPLY FAILED {args[at]}")
            return 1
        }
        patches += 1
    }
    files.write(files.join(dir, ".chain-base"), "{sha}\n") ?? fail("cannot write `{dir}/.chain-base`: {err}")
    print("exported {prefix(sha, 10)} + {patches} patch(es) to {dir}")
    0
}

// --- the chain --------------------------------------------------------------

LEVELS: ["check", "s1", "full", "full+threads"]

ChainOptions: struct {
    tree: String
    level: String
    auto: Bool
    out: String
    base: String
    dry: Bool
    gate: Bool
}

parse_chain: fn(args: [String]) -[Env, Exec, FS, IO]> ChainOptions Never! {
    options := ChainOptions{tree: absolute(args[0]), level: "", auto: false, out: "", base: "", dry: false, gate: false}
    at := 1
    loop at < args.len() {
        arg: args[at].copy()
        at += 1
        if arg == "--auto" {
            options.auto = true
            next
        }
        if arg == "--dry-run" {
            options.dry = true
            next
        }
        if arg == "--check-gate" {
            options.gate = true
            next
        }
        if arg == "--out" && at < args.len() {
            options.out = absolute(args[at])
            at += 1
            next
        }
        if arg == "--base" && at < args.len() {
            options.base = args[at].copy()
            at += 1
            next
        }
        if LEVELS.contains(arg) {
            options.level = arg.copy()
            next
        }
        term.eprint("Chain.jet: unknown argument {arg}")
        usage()
    }
    if options.level == "" && !options.auto -> usage()
    options
}

// One chain run: its roots, tree, store and the stage results so far.
Chain: struct {
    r: Roots
    tree: String
    level: String
    auto: Bool
    out: String
    logs: String
    base: String
    base_src: String
    seed: String
    cid: String
    ver: String
    mem: Int
    store: String
    cap: String
    work: String
    nsdir: String
    mode: String
    rows: [String]
    sha: [String: String]
    pk: [String: String]
    miss: String
    cpus: [Int]
    seed_sha: String
    seed_pk: String
    bin: String
    digest: String
    members: [String]
    reasons: [String]
    nchanged: String
    started: Int
}

// Free GB of the file system holding `path`, 0 when unknown.
free_gb: fn(path: String) -[Env, Exec, FS, IO, Time.Wait]> Int Never! {
    receipt: process.cmd([String]{"df", "--output=avail", "-BG", path.copy()}).run() ?? return 0
    lines: receipt.output.trim().split("\n").to_list()
    if lines.len() < 2 -> return 0
    Int.parse(lines[1].trim().removesuffix("G")) ?? 0
}

// `TREE LEVEL|--auto ...`, or `seed-published INSTALL_DIR` when `seedpub`
// names the install.
chain_main: fn(args: [String], seedpub: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    r: roots()
    options: if seedpub != "" -> ChainOptions{tree: r.root.copy(), level: "s1", auto: false, out: "{r.run}/chain-work/seedpub-{sys.pid()}", base: "", dry: false, gate: false} else -> parse_chain(args)
    tree: options.tree.copy()
    if !files.is_dir(files.join(tree, "Compiler")) || !files.is_dir(files.join(tree, "Tools/agent")) {
        print("Chain.jet: {tree} is not a source export")
        return 2
    }
    if seedpub == "" && under(tree, r.r14) {
        print("Chain.jet: refuse a tree under {r.r14} (the canonical root)")
        return 2
    }
    base := options.base.copy()
    base_src := "--base"
    if base == "" {
        recorded: first_line(files.join(tree, ".chain-base"))
        if recorded != "" {
            base = recorded.copy()
            base_src = ".chain-base"
        } else {
            base = "HEAD"
            base_src = "dev HEAD (no .chain-base; pass --base)"
        }
    }
    base_sha: git_line(r.repo, [String]{"rev-parse", "--verify", "{base}^{{commit}}"}) ?? {
        print("Chain.jet: unknown base {base}")
        return 2
    }
    out: if options.out == "" -> files.join(tree, ".chain") else -> options.out.copy()
    dirs: [String]{out.copy(), "{out}/logs", "{out}/keys"}
    loop dir in dirs -> files.create_dir_all(dir) ?? fail("cannot create `{dir}`: {err}")
    named_seed: env_or("CHAIN_SEED", "{r.seeds}/current")
    seed: files.canonicalize(named_seed) ?? fail("no seed at `{named_seed}`: {err}")
    cid: first_line(files.join(seed, "IDENTITY"))
    if cid == "" -> fail("`{seed}/IDENTITY` names no identity")
    store := env_or("CHAIN_STORE", "")
    cap := "20"
    if store == "" {
        if free_gb(r.scratch) >= 40 {
            store = "{r.scratch}/stagestore"
        } else {
            store = "{r.run}/stagestore"
            cap = "4"
        }
    }
    cap = env_or("CHAIN_STORE_CAP_GB", cap)
    files.create_dir_all(store) ?? fail("cannot create `{store}`: {err}")
    work: "{r.run}/chain-work/{sys.pid()}"
    files.create_dir_all("{work}/tmp") ?? fail("cannot create `{work}/tmp`: {err}")
    // Every stage inherits these.
    sys.set("CARGO_INCREMENTAL", "0")
    sys.set("JET_TARGET_CAP_GB", "120")
    cargo_vars: [String]{"CARGO_TARGET_DIR", "CARGO_HOME", "RUSTUP_HOME", "RUSTC"}
    loop name in cargo_vars -> sys.unset(name) ?? false
    sys.set_core_file_limit(Val(0), Val(0)) ?? ()
    sys.set_stack_limit(Val(1073741824), Val(1073741824)) ?? ()
    nsdir: "{r.run}/chain-ns/{sys.pid()}"
    c := Chain{r: r, tree: tree, level: options.level.copy(), auto: options.auto, out: out.copy(), logs: "{out}/logs", base: base_sha, base_src: base_src, seed: seed.copy(), cid: cid.copy(), ver: cid.partition("#").head.copy(), mem: memory_bytes(env_or("CHAIN_MEMMAX", "24G")), store: store, cap: cap, work: work.copy(), nsdir: nsdir.copy(), mode: "", rows: [String]{}, sha: [String: String]{}, pk: [String: String]{}, miss: "", cpus: [Int]{}, seed_sha: "", seed_pk: "", bin: "-", digest: "-", members: [String]{}, reasons: [String]{}, nchanged: "not computed (explicit level)", started: time.unix_ns()}
    code: chain_run(c, options, seedpub)
    files.remove_all(work) ?? ()
    files.remove_all(nsdir) ?? ()
    code
}

chain_run: fn(c: &Chain, options: ChainOptions, seedpub: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    if options.auto || c.level == "check" {
        found: diff(c.tree, c.base, c.r.repo)
        diff_path: files.join(c.out, "diff.json")
        files.write(diff_path, render_diff(found)) ?? fail("cannot write `{diff_path}`: {err}")
        planned: plan(c.tree, diff_path)
        c.digest = found.digest.copy()
        c.nchanged = changed_summary(found.changed)
        c.members = planned.members.copy()
        c.reasons = planned.reasons.copy()
        if options.auto {
            if c.level == "" -> c.level = planned.level.copy()
            print("--auto: level {planned.level} (base {prefix(c.base, 10)} from {c.base_src}; changes: {c.nchanged})")
            loop reason in planned.reasons -> print("  why: {reason}")
            if planned.members.len() > 0 -> print("  check members: {planned.members.join(" ")}")
        }
    }
    // Self-hosting needs the tree's preflight receipt for this seed; check,
    // s1 and --dry-run are ungated.
    if options.gate || !options.dry {
        if c.level == "full" || c.level == "full+threads" {
            gate: process.cmd([String]{files.join(c.seed, "jet"), files.join(c.r.tools, "Tools/agent/Land.jet"), "receipt", "check", "Chain.jet", c.tree.copy(), c.seed.copy()}).cwd(c.r.tools).env("JET_COMPILER_IDENTITY", c.cid).env("JET_TOOLCHAIN_ROOT", c.r.tools).stdout(.Inherit).stderr(.Inherit).run() ?? fail("Tools/agent/Land.jet receipt: {err}")
            if !gate.success -> return 2
        } else if options.gate {
            print("Chain.jet: level {c.level} is ungated (full and full+threads need a preflight receipt)")
        }
        if options.gate -> return 0
    }
    c.seed_sha = sha_file(files.join(c.seed, "jet"))
    c.seed_pk = dirhash(files.join(c.seed, "jet-runtime"))
    if c.level != "check" -> c.bin = content_hash(c.tree, stage_inputs(c.tree), "chain-build-inputs-v2")
    if seedpub != "" -> return seed_published(c, seedpub)
    if options.dry {
        c.mode = "dry"
        got: chain(c)
        print("dry run: level {c.level}, store {c.store}")
        loop row in c.rows {
            cells: row.split("\t").to_list()
            print("  {pad(cells[0], 6)} {cells[1]} key {prefix(cells[6], 16)} {cells[7]}")
        }
        if got == 3 -> print("  {c.miss} and every later stage would build (later keys depend on {c.miss}'s output)")
        if got == 0 -> print("  every stage is in the store: the run would take no slot")
        return 0
    }
    // Inside a slot (SLOT_CPUS set) the chain runs inline.
    held: env_or("SLOT_CPUS", "")
    if held != "" {
        c.cpus = parse_cpus(held)
        c.mode = "run"
        chain(c)
        return finish(c, "CPUs {held}")
    }
    lock_path: files.join(c.tree, ".chain-lock")
    _tree_lock: files.lock(lock_path) ?? fail("cannot lock `{lock_path}`: {err}")
    // Reuse what the store holds; a complete hit finishes without a slot.
    c.mode = "probe"
    probed: chain(c)
    if probed == 0 -> return finish(c, "none (every stage REUSED)")
    if probed != 3 -> return finish(c, "none (a stage failed while reusing)")
    small := true
    seen := false
    loop stage in stage_order(c.level) {
        if stage == c.miss -> seen = true
        if seen && (stage.starts_with("s") || stage == "t1") -> small = false
    }
    say("queueing in a build slot (SLOT_SMALL={if small -> "1" else -> "0"}) from stage {c.miss}")
    slot: take_slot(c.r, small, c.level == "s1")
    export_slot(slot.cpus)
    c.cpus = parse_cpus(slot.cpus)
    started: time.unix_ns()
    c.mode = "run"
    chain(c)
    code: finish(c, "CPUs {slot.cpus} (one slot for every stage the store lacked)")
    ledger(c.r, slot.name, slot.queued, lane_of(c.tree), started, code, peak_mb(c), "Chain.jet {c.tree} {c.level}")
    code
}

stage_order: fn(level: String) -> [String] Never! {
    if level == "check" -> return [String]{"check"}
    if level == "s1" -> return [String]{"s1"}
    if level == "full" -> return [String]{"s1", "s2", "s3"}
    [String]{"s1", "s2", "s3", "t1"}
}

changed_summary: fn(changed: [Change]) -> String Never! {
    if changed.len() == 0 -> return "0 file(s)"
    shown := [String]{}
    loop at in 0..<changed.len() {
        if at == 6 -> break
        shown.push("{changed[at].status} {changed[at].path}")
    }
    "{changed.len()} file(s): {shown.join(", ")}{if changed.len() > 6 -> ", ..." else -> ""}"
}

// The chain for its level in its mode (dry: resolve keys from the store only;
// probe: reuse what the store holds and stop at the first stage it lacks;
// run: build every stage it lacks). 3 at a miss in dry and probe.
chain: fn(c: &Chain) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    c.rows = [String]{}
    c.miss = ""
    if c.level == "check" -> return check_stage(c)
    got := build_stage(c, "s1", c.seed.copy(), c.seed_sha.copy(), c.seed_pk.copy(), c.cid.copy(), 12)
    if got != 0 || c.level == "s1" -> return got
    s1_dir: files.join(c.out, "s1")
    s2_dir: files.join(c.out, "s2")
    got = build_stage(c, "s2", s1_dir, c.sha.get("s1") ?? "", c.pk.get("s1") ?? "", c.cid.copy(), 12)
    if got != 0 -> return got
    s2: c.sha.get("s2") ?? ""
    pack2: c.pk.get("s2") ?? ""
    next_identity: "{c.ver}#{s2}"
    got = build_stage(c, "s3", s2_dir, s2, pack2, next_identity, 12)
    if got != 0 || c.level != "full+threads" -> return got
    build_stage(c, "t1", s2_dir, s2, pack2, next_identity, 1)
}

// One RESULT row: stage status rc wall_s peak_rss_mb sha256 key note.
rec: fn(c: &Chain, cells: [String]) { c.rows.push(cells.join("\t")) }

since: fn(t0: Int) -[Time]> String Never! { tenths(time.unix_ns() - t0) }

// A stage's key: SHA-256 over its material lines and the canonical root.
key_of: fn(c: &Chain, mat: [String]) -> String Never! {
    text := "chain-stage-v1\n"
    loop line in mat -> text = "{text}{line}\n"
    hasher := crypto.new()
    hasher.update("{text}root={c.r.root}\n".bytes())
    hasher.digest()
}

write_keys: fn(c: &Chain, name: String, mat: [String]) -[FS]> { files.write(files.join(c.out, "keys/{name}.txt"), "{mat.join("\n")}\n") ?? () }

find_entry: fn(c: &Chain, k: String) -[FS]> String Never! {
    stores: [String]{c.store.copy(), "{c.r.scratch}/stagestore", "{c.r.run}/stagestore"}
    loop store in stores {
        if files.is_file("{store}/{k}/meta") -> return "{store}/{k}"
    }
    ""
}

meta_of: fn(entry: String, name: String) -[FS]> String Never! {
    text: files.read(files.join(entry, "meta")) ?? return ""
    head: "{name}="
    loop line in text.split("\n") {
        if line.starts_with(head) -> return line.removeprefix(head).copy()
    }
    ""
}

touch_used: fn(entry: String) -[FS]> { files.write(files.join(entry, ".used"), "") ?? () }

// Store `src` (a build's jet and jet.o, a pack's jet-runtime/, or a check's
// logs) under `k` with meta `lines`, built in a temp dir and renamed in; then
// evict the store to its cap.
store_put: fn(c: &Chain, k: String, kind: String, src: String, lines: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> {
    dest: files.join(c.store, k)
    if files.is_dir(dest) -> return
    tmp: files.join(c.store, ".tmp.{k}.{sys.pid()}")
    files.remove_all(tmp) ?? ()
    files.create_dir_all(tmp) ?? fail("cannot create `{tmp}`: {err}")
    if kind == "build" {
        names: [String]{"jet", "jet.o"}
        loop name in names {
            if files.exists(files.join(src, name)) -> copy_plain(files.join(src, name), files.join(tmp, name))
        }
        copy_tree(files.join(src, "jet-runtime"), files.join(tmp, "jet-runtime"))
    } else {
        loop entry in list(src) -> copy_plain(files.join(src, entry.name), files.join(tmp, entry.name))
    }
    bytes := 0
    loop rel in all_files(tmp) -> bytes += lstat(files.join(tmp, rel)).size
    meta := lines.copy()
    meta.push("created={stamp()}")
    meta.push("bytes={bytes}")
    files.write(files.join(tmp, "meta"), "{meta.join("\n")}\n") ?? fail("cannot write `{tmp}/meta`: {err}")
    loop rel in all_files(tmp) {
        path: files.join(tmp, rel)
        found: lstat(path)
        if found.is_file -> files.set_mode(path, without_write(found.mode)) ?? ()
    }
    touch_used(tmp)
    files.rename(tmp, dest) ?? files.remove_all(tmp) ?? ()
    _evicting: files.lock(files.join(c.store, ".evict.lock")) ?? return
    files.write(files.join(c.logs, "evict.log"), "{evict_store(c.store, c.cap, Float.parse(c.cap) ?? 20.0)}\n") ?? ()
}

build_mat: fn(c: &Chain, builder: String, builder_pack: String, identity: String, threads: Int) -> [String] Never! {
    [String]{"kind=build", "builder={builder}", "builderpack={builder_pack}", "inputs={c.bin}", "identity={identity}", "args=JetEnv.jet --norust jet build --threads {threads} Compiler", "env=JET_KEEP_GOING=1"}
}

StageRun: struct {
    rc: Int
    ns: Int
    rss: Int
}

// Run one stage process, its output to logs/NAME.out and logs/NAME.err,
// under the chain's memory cap (no swap) and the slot's CPUs. `vars` are
// its NAME=VALUE settings. A `canonical` stage runs with the tree mounted at
// the canonical root in a private mount namespace (`inroot`), from there.
stage_run: fn(c: &Chain, name: String, argv: [String], vars: [String], seconds: Int, canonical: Bool) -[Env, Exec, FS, IO, Time, Time.Wait]> StageRun Never! {
    spec := process.cmd(argv).cwd(c.tree)
    if canonical {
        files.create_dir_all(files.join(c.nsdir, "snap")) ?? fail("cannot create `{c.nsdir}/snap`: {err}")
        inner := [String]{"unshare", "-r", "-m", "--propagation", "private", files.join(c.seed, "jet"), files.join(c.r.tools, "Tools/agent/Chain.jet"), "inroot", c.nsdir.copy(), c.tree.copy(), c.r.r14.copy(), c.r.root.copy(), "{sys.getuid()}", "{sys.getgid()}"}
        inner.extend(vars.copy())
        inner.push("--")
        inner.extend(argv.copy())
        spec = process.cmd(inner).cwd(c.r.tools)
    } else {
        loop setting in vars {
            parts: setting.partition("=")
            spec = spec.env(parts.head, parts.tail)
        }
    }
    spec = spec.memory_scope(c.mem).timeout(time.duration_seconds(seconds)).output_limit(1073741824)
    if c.cpus.len() > 0 -> spec = spec.cpu_affinity(c.cpus.copy())
    t0: time.unix_ns()
    receipt: spec.run() ?? {
        files.write(files.join(c.logs, "{name}.err"), "{argv[0]}: {err}\n") ?? ()
        return StageRun{rc: 127, ns: time.unix_ns() - t0, rss: 0}
    }
    files.write(files.join(c.logs, "{name}.out"), receipt.output) ?? ()
    files.write(files.join(c.logs, "{name}.err"), receipt.errors) ?? ()
    rc := receipt.code
    if receipt.signal == .Val(number) -> rc = 128 + number
    if receipt.timed_out -> rc = 124
    StageRun{rc: rc, ns: time.unix_ns() - t0, rss: (receipt.peak_memory_bytes ?? 0) /% 1048576}
}

// `inroot NSDIR TREE R14 ROOT UID GID [NAME=VALUE]... -- CMD...`, as root of
// a new user and mount namespace: our own empty NSDIR over R14 (so nothing
// the lander deletes is a mount point of ours) and TREE at ROOT, then CMD from
// ROOT as UID:GID with the settings.
inroot: fn(args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    if args.len() < 8 -> usage()
    at := 6
    vars := [String]{}
    loop at < args.len() && args[at] != "--" {
        vars.push(args[at].copy())
        at += 1
    }
    if at + 1 >= args.len() -> usage()
    if !bind(args[0], args[2]) || !bind(args[1], args[3]) {
        term.eprint("chain: canonical root bind failed")
        return 97
    }
    argv := [String]{"unshare", "--user", "--map-user={args[4]}", "--map-group={args[5]}"}
    loop rest in (at + 1)..<args.len() -> argv.push(args[rest].copy())
    spec := process.cmd(argv).cwd(args[3]).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit)
    loop setting in vars {
        parts: setting.partition("=")
        spec = spec.env(parts.head, parts.tail)
    }
    receipt: spec.run() ?? {
        term.eprint("chain: {argv[4]}: {err}")
        return 127
    }
    if receipt.signal == .Val(number) -> return 128 + number
    receipt.code
}

bind: fn(from: String, to: String) -[Exec, IO, Time.Wait]> Bool Never! {
    receipt: process.cmd([String]{"mount", "--bind", from.copy(), to.copy()}).run() ?? return false
    receipt.success
}

// build_stage: NAME (jet, jet.o and its runtime pack jet-runtime/) built by
// BUILDER_DIR/jet (sha BUILDER, its pack hash BUILDER_PACK) under IDENTITY:
// `jet build --threads THREADS Compiler` at the canonical root, in the dev
// shell, which supplies the C toolchain and static musl the pack links.
// 0 built or reused, 1 failed, 3 a miss outside a run.
build_stage: fn(c: &Chain, n: String, builder_dir: String, builder: String, builder_pack: String, identity: String, threads: Int) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    mat: build_mat(c, builder, builder_pack, identity, threads)
    k: key_of(c, mat)
    write_keys(c, n, mat)
    t0: time.unix_ns()
    dir: files.join(c.out, n)
    jet: files.join(dir, "jet")
    found := find_entry(c, k)
    if found != "" {
        c.sha[n.copy()] = meta_of(found, "sha256")
        c.pk[n.copy()] = meta_of(found, "packhash")
        if c.mode != "dry" {
            files.create_dir_all(dir) ?? fail("cannot create `{dir}`: {err}")
            files.remove(jet) ?? ()
            files.remove("{jet}.o") ?? ()
            files.remove_all(files.join(dir, "jet-runtime")) ?? ()
            copy_plain(files.join(found, "jet"), jet)
            if files.exists(files.join(found, "jet.o")) -> copy_plain(files.join(found, "jet.o"), "{jet}.o")
            copy_tree(files.join(found, "jet-runtime"), files.join(dir, "jet-runtime"))
            if sha_file(jet) != (c.sha.get(n) ?? "") || dirhash(files.join(dir, "jet-runtime")) != (c.pk.get(n) ?? "") {
                files.remove(jet) ?? ()
                files.remove_all(files.join(dir, "jet-runtime")) ?? ()
                found = ""
            }
        }
    }
    if found != "" {
        touch_used(found)
        sha: c.sha.get(n) ?? ""
        rec(c, [String]{n.copy(), "REUSED", "0", since(t0), meta_of(found, "rss_mb"), sha.copy(), k.copy(), "pack {prefix(c.pk.get(n) ?? "", 16)}, native.key {prefix(meta_of(found, "native_key"), 16)}; built {meta_of(found, "created")} in {meta_of(found, "wall_s")}s by {meta_of(found, "lane")}"})
        say("{n} REUSED {prefix(k, 16)} (jet {prefix(sha, 16)}, pack {prefix(c.pk.get(n) ?? "", 16)})")
        return 0
    }
    if c.mode != "run" {
        c.miss = n.copy()
        say("{n} needs a build (key {prefix(k, 16)})")
        return 3
    }
    say("{n}: {basename(builder_dir)} builds Compiler (--threads {threads})")
    build_out: files.join(c.tree, "Compiler/JetCli/.jet/build")
    files.remove_all(build_out) ?? ()
    files.remove_all(dir) ?? ()
    files.create_dir_all(dir) ?? fail("cannot create `{dir}`: {err}")
    report: files.join(c.logs, "{n}-keep-going.tsv")
    files.create_dir_all("{c.work}/tmp") ?? ()
    builder_jet: files.join(builder_dir, "jet")
    vars: [String]{"JET_COMPILER_IDENTITY={identity}", "JET_TOOLCHAIN_ROOT={c.r.root}", "JET_KEEP_GOING=1", "JET_KEEP_GOING_REPORT={report}", "TMPDIR={c.work}/tmp", "PATH={norust_path()}"}
    argv: [String]{builder_jet.copy(), "{c.r.root}/Tools/agent/JetEnv.jet", "--norust", builder_jet.copy(), "build", "--threads", "{threads}", "Compiler"}
    ran: stage_run(c, n, argv, vars, 3600, true)
    rows: keep_going_rows(report)
    built: files.join(build_out, "jet")
    pack: files.join(dir, "jet-runtime")
    if files.is_file(built) {
        files.copy(built, jet) ?? ()
        if files.is_file("{built}.o") -> files.copy("{built}.o", "{jet}.o") ?? ()
    }
    if files.is_file(files.join(build_out, "jet-runtime/native.key")) -> copy_tree(files.join(build_out, "jet-runtime"), pack)
    files.remove_all(build_out) ?? ()
    if !files.is_file(jet) || !files.is_file(files.join(pack, "native.key")) {
        failure: err_head(files.join(c.logs, "{n}.err"))
        rec(c, [String]{n.copy(), "FAILED", "{ran.rc}", tenths(ran.ns), "{ran.rss}", "-", k.copy(), "{if files.is_file(jet) -> "no runtime pack" else -> "no binary"}; keep-going rows={rows}; {failure}"})
        say("{n} FAILED rc={ran.rc} rows={rows} (logs {c.logs}/{n}.err)")
        return 1
    }
    sha: sha_file(jet)
    c.sha[n.copy()] = sha.copy()
    hash: dirhash(pack)
    c.pk[n.copy()] = hash.copy()
    native_key: first_line(files.join(pack, "native.key"))
    // #5662: a seed without the census fix installs keep-going `todo` traps
    // with no row; the binary tells.
    traps := "scan-failed"
    scanned: trap_owners(files.read_bytes(jet) ?? [U8]{})
    if scanned == .Val(owners) {
        files.write(files.join(c.logs, "{n}-traps.txt"), owners.join("\n")) ?? ()
        traps = "{owners.len()}"
    }
    wall: tenths(ran.ns)
    if ran.rc == 0 && rows == 0 && traps == "0" {
        lines := [String]{"stage={n}", "kind=build", "sha256={sha}", "packhash={hash}", "native_key={native_key}", "wall_s={wall}", "rss_mb={ran.rss}", "lane={lane_of(c.tree)}", "tree={c.tree}"}
        lines.extend(mat)
        store_put(c, k, "build", dir, lines)
        rec(c, [String]{n.copy(), "BUILT", "0", wall, "{ran.rss}", sha.copy(), k.copy(), "pack {prefix(hash, 16)}, native.key {prefix(native_key, 16)}; stored"})
    } else {
        rec(c, [String]{n.copy(), "DIRTY", "{ran.rc}", wall, "{ran.rss}", sha.copy(), k.copy(), "binary with rc={ran.rc} keep-going rows={rows} traps={traps} (not stored; {c.logs}/{n}-traps.txt)"})
    }
    say("{n} built rc={ran.rc} rows={rows} traps={traps} wall {wall}s rss {ran.rss}MB (jet {prefix(sha, 16)}, pack {prefix(hash, 16)}, native.key {prefix(native_key, 16)})")
    0
}

// check_stage: the seed's `jet check` of each member, from the tree (no
// canonical root: check writes no artifact).
check_stage: fn(c: &Chain) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    mat: [String]{"kind=check", "seed={c.seed_sha}", "seedpack={c.seed_pk}", "base={c.base}", "diff={c.digest}", "members={c.members.join(" ")}", "identity={c.cid}", "args=check --threads 12", "env=JET_KEEP_GOING=1"}
    k: key_of(c, mat)
    write_keys(c, "check", mat)
    t0: time.unix_ns()
    if c.members.len() == 0 {
        rec(c, [String]{"check", "OK", "0", "0", "0", "-", k.copy(), "no package touched: nothing to check"})
        say("check: no package touched")
        return 0
    }
    found: find_entry(c, k)
    if found != "" {
        if c.mode != "dry" {
            loop entry in list(found) {
                if entry.name.starts_with("check-") -> copy_plain(files.join(found, entry.name), files.join(c.logs, entry.name))
            }
        }
        touch_used(found)
        rc: meta_of(found, "rc")
        summary: meta_of(found, "summary")
        rec(c, [String]{"check", "REUSED", rc.copy(), since(t0), meta_of(found, "rss_mb"), "-", k.copy(), summary.copy()})
        say("check REUSED {prefix(k, 16)}: {summary}")
        return if rc == "0" -> 0 else -> 1
    }
    if c.mode != "run" {
        c.miss = "check"
        say("check needs a run (key {prefix(k, 16)})")
        return 3
    }
    worst := 0
    peak := 0
    wall := 0
    transient := false
    sums := [String]{}
    loop member in c.members {
        n: "check-{member.replace("/", "_")}"
        say("check {member} with {basename(c.seed)}")
        report: files.join(c.logs, "{n}-keep-going.tsv")
        vars: [String]{"JET_COMPILER_IDENTITY={c.cid}", "JET_TOOLCHAIN_ROOT={c.tree}", "JET_KEEP_GOING=1", "JET_KEEP_GOING_REPORT={report}", "TMPDIR={c.work}/tmp", "PATH={norust_path()}"}
        argv: [String]{files.join(c.seed, "jet"), "check", "--threads", "12", member.copy()}
        ran: stage_run(c, n, argv, vars, 1200, false)
        rows: keep_going_rows(report)
        if ran.rc >= 124 -> transient = true
        if ran.rc != 0 || rows != 0 -> worst = 1
        if ran.rss > peak -> peak = ran.rss
        wall += ran.ns
        sums.push("{member} rc={ran.rc} rows={rows}")
        say("check {member} rc={ran.rc} rows={rows} {tenths(ran.ns)}s")
    }
    summary: sums.join(";")
    if !transient {
        kept: files.join(c.work, "chk")
        files.create_dir_all(kept) ?? fail("cannot create `{kept}`: {err}")
        loop entry in list(c.logs) {
            if entry.name.starts_with("check-") -> copy_plain(files.join(c.logs, entry.name), files.join(kept, entry.name))
        }
        lines := [String]{"stage=check", "kind=check", "rc={worst}", "summary={summary}", "wall_s={tenths(wall)}", "rss_mb={peak}", "lane={lane_of(c.tree)}", "tree={c.tree}"}
        lines.extend(mat)
        store_put(c, k, "check", kept, lines)
    }
    rec(c, [String]{"check", if worst == 0 -> "OK" else -> "FAILED", "{worst}", tenths(wall), "{peak}", "-", k.copy(), summary.copy()})
    worst
}

same_build: fn(c: &Chain, left: String, right: String) -[FS]> Bool Never! {
    one: files.join(c.out, left)
    two: files.join(c.out, right)
    if !same_file("{one}/jet", "{two}/jet") -> return false
    if !files.exists("{one}/jet.o") && !files.exists("{two}/jet.o") -> return true
    same_file("{one}/jet.o", "{two}/jet.o")
}

// The largest peak of the stages this run built, in MB.
peak_mb: fn(c: &Chain) -> Int Never! {
    peak := 0
    loop row in c.rows {
        cells: row.split("\t").to_list()
        if cells[1] == "REUSED" -> next
        value: Int.parse(cells[4]) ?? 0
        if value > peak -> peak = value
    }
    peak
}

// The verdict of the run, RESULT and REPORT.md; the exit code.
finish: fn(c: &Chain, slot_note: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    verdict := "OK"
    code := 0
    note := ""
    failed := [String]{}
    check_rc := ""
    loop row in c.rows {
        cells: row.split("\t").to_list()
        if cells[1] == "FAILED" -> failed.push(cells[0].copy())
        if cells[0] == "check" -> check_rc = cells[2].copy()
    }
    if c.level == "check" {
        if check_rc != "0" {
            verdict = "FAILED"
            code = 1
        }
    } else if failed.len() > 0 {
        verdict = "FAILED"
        code = 1
        note = "stage(s) failed: {failed.join(" ")}"
    } else if c.level == "s1" {
        note = "s1 jet {prefix(c.sha.get("s1") ?? "", 16)}, pack1 {prefix(c.pk.get("s1") ?? "", 16)}"
    } else {
        s2: c.sha.get("s2") ?? ""
        s3: c.sha.get("s3") ?? ""
        if same_build(c, "s2", "s3") {
            verdict = "FIXED_POINT"
            jet_o: files.join(c.out, "s2/jet.o")
            note = "s2 == s3 (jet {prefix(s2, 16)}{if files.exists(jet_o) -> ", jet.o {prefix(sha_file(jet_o), 16)}" else -> ""})"
        } else {
            verdict = "NOT_FIXED"
            code = 1
            note = "s2 {prefix(s2, 16)} != s3 {prefix(s3, 16)}"
        }
        rec(c, [String]{"fixed_point", if verdict == "FIXED_POINT" -> "SAME" else -> "DIFFERENT", "{code}", "0", "0", s3.copy(), "-", "cmp s2 s3 (jet and jet.o)"})
        if c.level == "full+threads" {
            t1: c.sha.get("t1") ?? ""
            if same_build(c, "t1", "s3") {
                rec(c, [String]{"threads1", "SAME", "0", "0", "0", t1.copy(), "-", "cmp t1 (--threads 1) s3"})
                note = "{note}; t1 (--threads 1) == s3"
            } else {
                rec(c, [String]{"threads1", "DIFFERENT", "1", "0", "0", t1.copy(), "-", "cmp t1 (--threads 1) s3"})
                verdict = "THREADS_DIFFER"
                code = 1
                note = "{note}; t1 {prefix(t1, 16)} != s3"
            }
        }
        // Compared without the provenance fields that name the building
        // compiler (s1 for pack1, s2 for pack2).
        one: pack_compare(files.join(c.out, "s1/jet-runtime")) ?? ""
        two: pack_compare(files.join(c.out, "s2/jet-runtime")) ?? ""
        if one == "" || two == "" {
            note = "{note}; pack1 and pack2 not compared (packhash failed)"
        } else {
            note = "{note}; pack1 {if one == two -> "==" else -> "!="} pack2 bytes (provenance without compilerSha256, recipeSha256)"
        }
    }
    write_report(c, verdict, code, note, slot_note)
    code
}

write_report: fn(c: &Chain, verdict: String, code: Int, note: String, slot_note: String) -[Env, Exec, FS, IO, Time]> {
    total: since(c.started)
    rows := [String]{"stage\tstatus\trc\twall_s\tpeak_rss_mb\tsha256\tkey\tnote"}
    rows.extend(c.rows.copy())
    rows.push("verdict\t{verdict}\t{code}\t{total}\t{peak_mb(c)}\t{c.sha.get("s3") ?? c.sha.get("s1") ?? "-"}\t-\tlevel={c.level} {note}")
    staged: files.join(c.out, "RESULT.new")
    files.write(staged, "{rows.join("\n")}\n") ?? fail("cannot write `{staged}`: {err}")
    files.rename(staged, files.join(c.out, "RESULT")) ?? fail("cannot rename `{staged}`: {err}")
    md := [String]{"# Chain.jet {c.level}: {c.tree}", "", "- base: {prefix(c.base, 10)} ({c.base_src}); changes: {c.nchanged}"}
    if c.reasons.len() > 0 {
        md.push("- why this level:{if c.auto -> " (--auto)" else -> ""}")
        loop reason in c.reasons -> md.push("  - {reason}")
    }
    if c.level == "check" -> md.push("- check members: {if c.members.len() == 0 -> "none" else -> c.members.join(" ")}")
    md.push("- seed: {basename(c.seed)} ({c.cid}); build inputs {prefix(c.bin, 16)}")
    md.push("- store: {c.store} (cap {c.cap} GB, LRU); canonical build root {c.r.root} (private mount namespace)")
    md.push("- slot: {slot_note}")
    md.push("")
    md.push("| stage | status | rc | wall s | peak RSS MB | sha256 | key | note |")
    md.push("|---|---|---:|---:|---:|---|---|---|")
    loop row in c.rows {
        cells: row.split("\t").to_list()
        md.push("| {cells[0]} | {if cells[1] == "REUSED" -> "**REUSED**" else -> cells[1].copy()} | {cells[2]} | {cells[3]} | {cells[4]} | {prefix(cells[5], 16)} | {prefix(cells[6], 16)} | {cells[7]} |")
    }
    md.push("")
    md.push("**{verdict}** {note} (wall {total} s)")
    text: md.join("\n")
    files.write(files.join(c.out, "REPORT.md"), "{text}\n") ?? fail("cannot write `{c.out}/REPORT.md`: {err}")
    print("== {c.out}/REPORT.md")
    print(text)
}

// `seed-published INSTALL_DIR` (`Land.jet publish base`): INSTALL_DIR holds
// the compiler and runtime pack the lander's census built at the canonical
// root; they are that tree's s1, so store them under the key a chain
// computes, only when nothing about that claim is assumed: the snap's build
// output is still these bytes (jet and pack), it is newer than the seed, the
// census build was clean, the identity is the seed's, and the pack was
// lowered by this compiler.
seed_published: fn(c: &Chain, install: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    seedpub: files.canonicalize(install) ?? {
        print("seed-published: no install at {install}")
        return 2
    }
    built: files.join(c.r.root, "Compiler/JetCli/.jet/build/jet")
    census_report: files.join(c.r.r14, "census/build-keep-going.tsv")
    published: sha_file(files.join(seedpub, "jet"))
    pack: files.join(seedpub, "jet-runtime")
    built_pack: files.join(c.r.root, "Compiler/JetCli/.jet/build/jet-runtime")
    if !files.is_file(built) || sha_file(built) != published || !files.is_file(files.join(pack, "native.key")) || !files.is_dir(built_pack) || dirhash(pack) != dirhash(built_pack) {
        print("seed-published: {c.r.root} no longer holds this build of {seedpub}/jet and its jet-runtime; nothing stored")
        return 1
    }
    seed_time: files.getmtime(files.join(c.seed, "jet")) ?? 0
    if seed_time >= (files.getmtime(built) ?? 0) {
        print("seed-published: seed {basename(c.seed)} is newer than the census build; nothing stored")
        return 1
    }
    if !files.is_file(census_report) || keep_going_rows(census_report) != 0 || (files.getmtime(census_report) ?? 0) <= seed_time {
        print("seed-published: census build was not clean; nothing stored")
        return 1
    }
    if first_line(files.join(seedpub, "IDENTITY")) != c.cid {
        print("seed-published: identity is not the seed's; nothing stored")
        return 1
    }
    provenance: json.parse(files.read(files.join(pack, "provenance.json")) ?? "") ?? Dyn.Null
    if text_field(provenance, "compilerSha256") != published {
        print("seed-published: the pack was not lowered by this compiler; nothing stored")
        return 1
    }
    mat: build_mat(c, c.seed_sha.copy(), c.seed_pk.copy(), c.cid.copy(), 12)
    k: key_of(c, mat)
    if files.is_dir(files.join(c.store, k)) {
        print("seed-published: s1 {prefix(k, 16)} already stored")
        return 0
    }
    s1: files.join(c.out, "s1")
    files.create_dir_all(s1) ?? fail("cannot create `{s1}`: {err}")
    copy_plain(files.join(seedpub, "jet"), files.join(s1, "jet"))
    copy_tree(pack, files.join(s1, "jet-runtime"))
    hash: dirhash(files.join(s1, "jet-runtime"))
    lines := [String]{"stage=s1", "kind=build", "sha256={published}", "packhash={hash}", "native_key={first_line(files.join(s1, "jet-runtime/native.key"))}", "wall_s=-", "rss_mb=-", "lane=lander census", "tree={c.r.root} ({first_line(files.join(seedpub, "COMMIT"))})"}
    lines.extend(mat)
    store_put(c, k, "build", s1, lines)
    files.remove_all(c.out) ?? ()
    print("seed-published: s1 {prefix(k, 16)} stored (jet {prefix(published, 16)}, pack {prefix(hash, 16)})")
    0
}

// --- build slots ------------------------------------------------------------

// Three machine-wide build slots split by physical core (CPU N and N+16 are
// SMT siblings): A = cores 4-9, B = cores 10-15, C = both (only while
// MemAvailable > 26 GB), and D = both for short builds only (MemAvailable >
// 30 GB). A and B never share a physical core, so a measurement in one is not
// skewed by its neighbour's SMT sibling; cores 0-3 stay free for the desktop.
// The release slot R (CPUs 8-31, 24 threads; CPUs 0-7 stay free) is the
// release gate's: it holds A, B, C and D at once (take_release_slot).
SLOT_NAMES: ["A", "B", "C", "D"]
RELEASE_SLOT_CPUS: "8-31"

slot_cpus: fn(name: String) -> String Never! {
    if name == "A" -> return "4-9,20-25"
    if name == "B" -> return "10-15,26-31"
    if name == "R" -> return RELEASE_SLOT_CPUS
    "4-15,20-31"
}

SlotTaken: struct {
    name: String
    cpus: String
    queued: Int
    locks: [files.FileLock]
}

mem_available_gb: fn() -[FS]> Int Never! {
    text: files.read("/proc/meminfo") ?? return 0
    loop line in text.split("\n") {
        if !line.starts_with("MemAvailable:") -> next
        return (Int.parse(line.removeprefix("MemAvailable:").trim().partition(" ").head) ?? 0) /% 1048576
    }
    0
}

// The I/O pressure (`some` avg10, whole percent).
io_pressure: fn() -[FS]> Int Never! {
    text: files.read("/proc/pressure/io") ?? return 0
    loop line in text.split("\n") {
        if !line.starts_with("some ") -> next
        return Int.parse(line.partition("avg10=").tail.partition(".").head) ?? 0
    }
    0
}

// Milliseconds the NVMe disks spent doing I/O, summed.
disk_ms: fn() -[FS]> Int Never! {
    text: files.read("/proc/diskstats") ?? return 0
    total := 0
    loop line in text.split("\n") {
        cells := [String]{}
        loop cell in line.split(" ") {
            if cell != "" -> cells.push(cell.copy())
        }
        if cells.len() < 13 || !cells[2].starts_with("nvme") || cells[2].contains("p") -> next
        total += Int.parse(cells[12]) ?? 0
    }
    total
}

// The first ticket of a live waiter; a dead waiter's ticket is removed.
head_ticket: fn(queue: String) -[FS]> String Never! {
    names := [String]{}
    listed: files.list_dir(queue) ?? [files.DirEntry]{}
    loop entry in listed -> names.push(entry.name.copy())
    names.sort()
    loop name in names {
        parts: name.split("-").to_list()
        if files.exists("/proc/{parts[parts.len() - 1]}") -> return files.join(queue, name)
        files.remove(files.join(queue, name)) ?? ()
    }
    ""
}

// Wait for a build slot. Waiters are served in ticket order: each holds a
// ticket in $JET_RUN_ROOT/slot-queue and only the first live ticket may take
// a free slot. Classes: SLOT_PRIORITY=1 with Main's key first, then small
// jobs (under ~2 min and ~3 GB) and short builds, then the rest, each first
// come, first served. A slot opens only while MemAvailable > 20 GB and the
// I/O pressure is below 85% or the NVMe disks were under 50% busy over the
// last wait (a task parked in iowait holds PSI near 90% while the disks sit
// idle). A reserved slot ($JET_RUN_ROOT/slot-S-reserved) is taken only with
// SLOT_RESERVED=1. No slot opens while the release slot is claimed
// (release_claimed).
take_slot: fn(r: Roots, small: Bool, short: Bool) -[Env, Exec, FS, IO, Time, Time.Wait]> SlotTaken Never! {
    queue: files.join(r.run, "slot-queue")
    files.create_dir_all(queue) ?? fail("cannot create `{queue}`: {err}")
    class := if small -> 1 else -> 2
    if env_or("SLOT_PRIORITY", "0") == "1" {
        key: first_line(files.join(r.state, "scratch/Main/.slot-key"))
        offered: env_or("SLOT_PRIORITY_KEY", "")
        if offered != "" && offered == key {
            class = 0
        } else {
            term.eprint("slot: SLOT_PRIORITY=1 ignored (Main's class only); queueing in class {class}")
        }
    }
    if short && class == 2 -> class = 1
    queued: time.unix_ns()
    ticket: files.join(queue, "{class}-{queued}-{sys.pid()}")
    files.write(ticket, "") ?? fail("cannot write `{ticket}`: {err}")
    busy_then := disk_ms()
    then := time.unix_ns()
    time.sleep(time.duration_seconds(2))
    loop {
        mem: mem_available_gb()
        io := io_pressure()
        busy_now: disk_ms()
        now: time.unix_ns()
        // Percent of the elapsed wall time the disks (summed) were busy.
        busy: (busy_now - busy_then) * 100000000 /% (now - then + 1)
        busy_then = busy_now
        then = now
        if io >= 85 && busy < 50 -> io = 0
        head: head_ticket(queue) == ticket
        if mem > 20 && io < 85 && (head || short) && !release_claimed(r) {
            loop name in SLOT_NAMES {
                if name == "D" && !(short && mem > 30) -> next
                if name != "D" && !head -> next
                if name == "C" && mem <= 26 -> next
                if files.exists(files.join(r.run, "slot-{name}-reserved")) && env_or("SLOT_RESERVED", "0") != "1" -> next
                lock: files.try_lock(files.join(r.run, "build-slot-{name}.lock")) ?? next
                files.remove(ticket) ?? ()
                locks := [files.FileLock]{}
                locks.push(lock)
                return SlotTaken{name: name.copy(), cpus: slot_cpus(name), queued: queued, locks: locks}
            }
        }
        time.sleep(time.duration_seconds(10))
    }
}

// The release gate's claim on the release slot: $JET_RUN_ROOT/slot-R.pid
// names the live process that waits for or holds it.
release_claim: fn(r: Roots) -> String Never! {
    files.join(r.run, "slot-R.pid")
}

release_claimed: fn(r: Roots) -[FS]> Bool Never! {
    pid: first_line(release_claim(r))
    pid != "" && files.exists("/proc/{pid}")
}

// Wait for the release slot: claim it first, so no other job takes a slot
// from then on (their waiters queue behind it), then take A, B, C and D one
// by one as the jobs in them end. One claim at a time: a second release
// waits for the first's to end.
take_release_slot: fn(r: Roots) -[Env, Exec, FS, IO, Time, Time.Wait]> SlotTaken Never! {
    queued: time.unix_ns()
    claim: release_claim(r)
    me: "{sys.pid()}"
    loop {
        if !release_claimed(r) {
            files.write(claim, "{me}\n") ?? fail("cannot write `{claim}`: {err}")
            if first_line(claim) == me -> break
        }
        time.sleep(time.duration_seconds(10))
    }
    locks := [files.FileLock]{}
    held := [String]{}
    loop {
        loop name in SLOT_NAMES {
            if held.contains(name) -> next
            lock: files.try_lock(files.join(r.run, "build-slot-{name}.lock")) ?? next
            locks.push(lock)
            held.push(name.copy())
        }
        if held.len() == SLOT_NAMES.len() -> return SlotTaken{name: "R", cpus: RELEASE_SLOT_CPUS, queued: queued, locks: locks}
        time.sleep(time.duration_seconds(2))
    }
}

export_slot: fn(cpus: String) -[Env]> {
    names: [String]{"SLOT_CPUS", "CHAIN_CPUS", "CAP_CPUS"}
    loop name in names -> sys.set(name, cpus)
}

// One row per job in $JET_RUN_ROOT/slot-ledger.tsv: when, slot, lane, how
// long it waited and ran, its exit code, its peak memory and its command.
ledger: fn(r: Roots, slot: String, queued: Int, lane: String, started: Int, code: Int, peak: Int, command: String) -[FS, Time]> {
    now: time.unix_ns()
    row: "{now_text(.Val("_"))}\t{slot}\t{if lane == "" -> "?" else -> lane.copy()}\twait={(started - queued) /% 1000000000}s\trun={(now - started) /% 1000000000}s\trc={code}\tmaxrss={peak}MB\t{prefix(command, 200)}\n"
    files.append_all(files.join(r.run, "slot-ledger.tsv"), row) ?? ()
}

// `slot [--small|--release] -- CMD...`: CMD in a build slot, on its CPUs, in
// the idle I/O class at nice 19, in a memory scope of SLOT_MEMORY_MAX
// (default 16G; 24G in the release slot, exported to CMD) plus 2G with no
// swap, so an overrun job dies alone. Exports SLOT_CPUS, CHAIN_CPUS and
// CAP_CPUS to it; SLOT_SMALL=1 is --small. --release takes the release slot
// (take_release_slot).
slot_main: fn(args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    small := env_or("SLOT_SMALL", "0") == "1"
    release := false
    at := 0
    if args.len() > 0 && args[0] == "--small" {
        small = true
        at = 1
    } else if args.len() > 0 && args[0] == "--release" {
        release = true
        at = 1
    }
    if args.len() <= at + 1 || args[at] != "--" -> usage()
    command := [String]{}
    loop rest in (at + 1)..<args.len() -> command.push(args[rest].copy())
    r: roots()
    slot: if release -> take_release_slot(r) else -> take_slot(r, small, false)
    export_slot(slot.cpus)
    memory: env_or("SLOT_MEMORY_MAX", if release -> "24G" else -> "16G")
    if release -> sys.set("SLOT_MEMORY_MAX", memory)
    sys.set_core_file_limit(Val(0), Val(0)) ?? ()
    argv := [String]{"nice", "-n", "19"}
    argv.extend(command.copy())
    shown: command.join(" ")
    lane: lane_of("{files.cwd() ?? ""} {shown}")
    started: time.unix_ns()
    receipt: process.cmd(argv).cpu_affinity(parse_cpus(slot.cpus)).io_idle().memory_scope(memory_bytes(memory) + 2 * GIB).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? {
        if release -> files.remove(release_claim(r)) ?? ()
        term.eprint("slot: {command[0]}: {err}")
        ledger(r, slot.name, slot.queued, lane, started, 127, 0, shown)
        return 127
    }
    code := receipt.code
    if receipt.signal == .Val(number) -> code = 128 + number
    if release -> files.remove(release_claim(r)) ?? ()
    ledger(r, slot.name, slot.queued, lane, started, code, (receipt.peak_memory_bytes ?? 0) /% 1048576, shown)
    code
}

// --- trapscan ---------------------------------------------------------------

trapscan: fn(path: String) -[FS, IO]> Int Never! {
    bytes: files.read_bytes(path) ?? {
        term.eprint("trapscan: {path} cannot be read: {err}")
        return 2
    }
    found: trap_owners(bytes) ?? {
        term.eprint("trapscan: no symbol table or no jet_rt_unreachable in {path}")
        return 2
    }
    loop name in found -> print(name)
    if found.len() > 0 -> 1 else -> 0
}

// A PT_LOAD program header.
Load: struct {
    executable: Bool
    off: Int
    vaddr: Int
    filesz: Int
}

// A function symbol, `order` its place in the symbol table.
Symbol: struct {
    value: Int
    order: Int
    name: String
}

// The sorted owners of the `todo` traps of an x86-64 ELF image, None when it
// has no symbol table or no jet_rt_unreachable.
trap_owners: fn(b: [U8]) -> [String]? Never! {
    if b.len() < 64 -> return None
    phoff: le(b, 32, 8)
    phentsize: le(b, 54, 2)
    phnum: le(b, 56, 2)
    shoff: le(b, 40, 8)
    shentsize: le(b, 58, 2)
    shnum: le(b, 60, 2)
    loads := [Load]{}
    loop i in 0..<phnum {
        p: phoff + i * phentsize
        if le(b, p, 4) != 1 -> next
        loads.push(Load{executable: le(b, p + 4, 4) % 2 == 1, off: le(b, p + 8, 8), vaddr: le(b, p + 16, 8), filesz: le(b, p + 32, 8)})
    }
    symbols := [Symbol]{}
    unreachable := -1
    loop i in 0..<shnum {
        s: shoff + i * shentsize
        // SHT_SYMTAB
        if le(b, s + 4, 4) != 2 -> next
        off: le(b, s + 24, 8)
        size: le(b, s + 32, 8)
        link: le(b, s + 40, 4)
        ent: le(b, s + 56, 8)
        if ent <= 0 -> next
        strings: le(b, shoff + link * shentsize + 24, 8)
        at := off
        loop at + ent <= off + size {
            // STT_FUNC
            if Int.from_u8(b[at + 4]) % 16 == 2 {
                name: c_string(b, strings + le(b, at, 4))
                value: le(b, at + 8, 8)
                if name == "jet_rt_unreachable" -> unreachable = value
                symbols.push(Symbol{value: value, order: symbols.len(), name: name})
            }
            at += ent
        }
    }
    if unreachable < 0 -> return None
    symbols.sort_by((left: Symbol, right: Symbol) -> {
        if left.value != right.value -> return if left.value < right.value -> Ordering.Less else -> Ordering.Greater
        if left.order < right.order -> return Ordering.Less
        if left.order > right.order -> return Ordering.Greater
        Ordering.Equal
    })
    found := [String]{}
    loop load in loads {
        if !load.executable -> next
        end: load.off + load.filesz
        at := load.off
        loop at + 12 <= end {
            // mov $0x4,%rsi ; call rel32
            if byte(b, at) == 72 && byte(b, at + 1) == 199 && byte(b, at + 2) == 198 && le(b, at + 3, 4) == 4 && byte(b, at + 7) == 232 {
                call: load.vaddr + (at + 7 - load.off)
                if call + 5 + signed32(le(b, at + 8, 4)) == unreachable {
                    floor := at - 24
                    if floor < load.off -> floor = load.off
                    back := at - 7
                    loop back >= floor {
                        // lea rel32(%rip),%rax
                        if byte(b, back) == 72 && byte(b, back + 1) == 141 && byte(b, back + 2) == 5 {
                            target: file_offset(loads, load.vaddr + (back - load.off) + 7 + signed32(le(b, back + 3, 4)))
                            if target >= 0 && target + 4 <= b.len() && byte(b, target) == 116 && byte(b, target + 1) == 111 && byte(b, target + 2) == 100 && byte(b, target + 3) == 111 {
                                name: owner(symbols, call)
                                if !found.contains(name) -> found.push(name)
                            }
                            break
                        }
                        back -= 1
                    }
                }
            }
            at += 1
        }
    }
    found.sort()
    Val(found)
}

byte: fn(b: [U8], at: Int) -> Int Never! { Int.from_u8(b[at]) }

// The `width`-byte little-endian unsigned value at `at`.
le: fn(b: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = value * 256 + Int.from_u8(b[at + width - 1 - k])
    value
}

signed32: fn(value: Int) -> Int Never! { if value >= 2147483648 -> value - 4294967296 else -> value }

// The NUL-terminated name at `at`.
c_string: fn(b: [U8], at: Int) -> String Never! {
    end := at
    loop end < b.len() && Int.from_u8(b[end]) != 0 -> end += 1
    String.from_bytes_lossy(b.slice(at, end))
}

// The file offset of the virtual address `va`, -1 outside every load.
file_offset: fn(loads: [Load], va: Int) -> Int Never! {
    loop load in loads {
        if va >= load.vaddr && va < load.vaddr + load.filesz -> return load.off + (va - load.vaddr)
    }
    -1
}

// The function whose start is the last at or before `va`.
owner: fn(symbols: [Symbol], va: Int) -> String Never! {
    lo := 0
    hi := symbols.len() - 1
    best := "?"
    loop lo <= hi {
        mid: (lo + hi) /% 2
        if symbols[mid].value <= va {
            best = symbols[mid].name.copy()
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    best
}

put: fn(b: &[U8], at: Int, width: Int, value: Int) {
    rest := value
    loop k in 0..<width {
        b[at + k] = U8.from_int(rest % 256) ?? U8{0}
        rest = rest /% 256
    }
}

put_text: fn(b: &[U8], at: Int, text: String) {
    place := at
    loop letter in text.bytes() {
        b[place] = letter
        place += 1
    }
}

#Test("a todo trap is listed under the function that holds it") {
    image := [U8]{}
    loop _ in 0..<544 -> image.push(U8{0})
    // ELF header: one program header at 64, three section headers at 256.
    put(image, 32, 8, 64)
    put(image, 40, 8, 256)
    put(image, 54, 2, 56)
    put(image, 56, 2, 1)
    put(image, 58, 2, 64)
    put(image, 60, 2, 3)
    // PT_LOAD, R+X, the whole image at address 0.
    put(image, 64, 4, 1)
    put(image, 68, 4, 5)
    put(image, 96, 8, 544)
    // lea "todo"(%rip),%rax at 128; mov $4,%rsi at 135; call jet_rt_unreachable at 142.
    code: [Int]{72, 141, 5, 65, 0, 0, 0, 72, 199, 198, 4, 0, 0, 0, 232, 13, 0, 0, 0}
    loop at in 0..<code.len() -> put(image, 128 + at, 1, code[at])
    put_text(image, 200, "todo")
    // Section 1: the symbol table at 448 (two entries), its strings in section 2 at 512.
    put(image, 324, 4, 2)
    put(image, 344, 8, 448)
    put(image, 352, 8, 48)
    put(image, 360, 4, 2)
    put(image, 376, 8, 24)
    put(image, 408, 8, 512)
    put(image, 448, 4, 1)
    put(image, 452, 1, 2)
    put(image, 456, 8, 120)
    put(image, 472, 4, 7)
    put(image, 476, 1, 2)
    put(image, 480, 8, 160)
    put_text(image, 513, "owner")
    put_text(image, 519, "jet_rt_unreachable")
    assert_eq(trap_owners(image), Val([String]{"owner"}))
    image[200] = U8{84}
    assert_eq(trap_owners(image), Val([String]{}))
    image[519] = U8{74}
    assert_eq(trap_owners(image), None)
}

#Test("a content hash frames each path and its bytes") {
    assert_eq(be64(258), [U8]{U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{1}, U8{2}})
    assert_eq(unique([String]{"b", "a/b", "a", "b"}), [String]{"a", "a/b", "b"})
}

#Test("JSON strings escape as JSON.stringify does") {
    control: String.from_bytes_lossy([U8]{U8{1}})
    assert_eq(json_text("a\"b\\c\nd{control}é"), "\"a\\\"b\\\\c\\nd\\u0001é\"")
}

#Test("the --auto class of a changed path") {
    read := [String: Bool]{}
    read["Compiler/JetSema/Source/Check.jet"] = true
    read["Compiler/JetSema/Source/Lowering.jet"] = true
    assert_eq(classify("Compiler/JetIR/Source/Ir.jet", read).level, "full")
    assert_eq(classify("Compiler/JetSema/Source/Check.jet", read).reason, "compiler front end (Compiler/JetSema)")
    assert_eq(classify("Compiler/JetSema/Source/Lowering.jet", read).level, "full")
    assert_eq(classify("Compiler/JetSema/Tests/Check.jet", read).reason, "tests")
    assert_eq(classify("Core/Text/Text.jet", read).level, "check")
    assert_eq(classify("env.jet", read).level, "s1")
    assert_eq(classify("README.md", read).reason, "not read by any chain stage")
}

#Test("store sizes print in GiB with two decimals") {
    assert_eq(hundredths(0), "0.00")
    assert_eq(hundredths(GIB * 3 /% 2), "1.50")
    assert_eq(hundredths(GIB * 20 + GIB /% 20), "20.05")
}

// A runtime pack whose provenance names `compiler` and `recipe`, whose other
// provenance field is `object`, and whose object holds `byte`.
sample_pack: fn(compiler: String, recipe: String, object: String, byte: Int) -> [PackFile] Never! {
    provenance: "{{\"backend\":\"jet-native\",\"compilerSha256\":\"{compiler}\",\"objectSha256\":\"{object}\",\"recipeSha256\":\"{recipe}\"}}"
    [PackFile]{
        PackFile{path: "provenance.json", bytes: provenance.bytes()},
        PackFile{path: "native.key", bytes: "f2a10ea90b64b2a5df415c5912d5a42da5d3cda2c0cd122c0e42117dea596b33\n".bytes()},
        PackFile{path: "jet_runtime.pack.o", bytes: [U8]{U8{127}, U8{69}, U8.from_int(byte) ?? U8{0}}},
    }
}

#Test("runtime packs compare without the compiler that built them") {
    pack1: pack_digest(sample_pack("s1", "r1", "o", 7))
    assert(pack1 != None)
    assert_eq(pack_digest(sample_pack("s2", "r2", "o", 7)), pack1)
    assert(pack_digest(sample_pack("s1", "r1", "o", 8)) != pack1)
    assert(pack_digest(sample_pack("s1", "r1", "other", 7)) != pack1)
    broken := sample_pack("s1", "r1", "o", 7)
    broken[0] = PackFile{path: "provenance.json", bytes: "[1]".bytes()}
    assert_eq(pack_digest(broken), None)
}
