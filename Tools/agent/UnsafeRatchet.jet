#!/usr/bin/env jet
// Unsafe-region ratchet and CoreLib unsafe audit.
//
// Every user-written `#Unsafe` region in the checkout is one row of the
// generated baseline in Docs/spec/safety.md. Growth fails; a shrink that only
// removes exact rows rewrites the baseline; `--update` approves any change;
// `--check` never writes and fails on any difference, shrink included (the
// lane gate: Tools/agent/LaneCheck.jet runs it before every check).
// The CoreLib audit (#4619) then requires every raw operation in `Core/**` to
// sit inside an audited gate, and every safe abstraction (a plain fn that
// opens an `#Unsafe` block) to carry a reviewer's proof in the safety.md
// registry. A `.jet` directory holds Jet's own project state (generated FFI
// bindings, build output, staged test projects), never user-written source, so
// it never moves the baseline.
//
// The scanner works on UTF-8 bytes. Positions and columns match the source
// text: a column counts Unicode scalars, as the baseline rows always have.
//
// Usage (from the repository root):
//   jet Tools/agent/UnsafeRatchet.jet [--update | --check] [--root PATH] [--baseline PATH]
use {
    json: core.encoding.json
    files: core.files
    process: core.process
    regex: core.regex
    sys: core.sys
    term: core.term
}

COMMAND: "jet Tools/agent/UnsafeRatchet.jet"
BEGIN: "<!-- unsafe-ratchet:begin -->"
END: "<!-- unsafe-ratchet:end -->"
DATA_BEGIN: "<!-- unsafe-ratchet:data"
DATA_END: "-->"
ABSTRACTIONS_BEGIN: "<!-- unsafe-abstractions:begin -->"
ABSTRACTIONS_END: "<!-- unsafe-abstractions:end -->"
CORELIB_DIRECTORY: "Core"
SKIP_DIRECTORIES: [".agent-worktrees", ".cache", ".claude", ".git", ".jet", ".tmp", "build", "node_modules", "result", "target"]

// Raw operations, spelled as the CoreLib reaches them: postfix dereference
// `p.*`, address-based pointer construction, volatile access, and the POSIX
// controls sema gates through the `core.sys` intrinsics
// (Compiler/JetSema/Source/Sema/Calls/Core.jet `sema_call_core_posix_control`,
// E3101).
RAW_OPERATIONS: ["pointer dereference", "pointer from address", "volatile access", "POSIX control"]
POINTER_DEREFERENCE: Regex{"\.\*"}
POINTER_FROM_ADDRESS: Regex{"\bPtr\s*<[^>]*>\s*\.\s*from_addr\s*\("}
VOLATILE_ACCESS: Regex{"\bcore\s*\.\s*mem\s*\.\s*volatile_(?:read|write)\b"}
POSIX_CONTROL: Regex{"\bcore\s*\.\s*sys\s*\.\s*(?:fork|setuid|setgid|set_user_ids|set_group_ids|setpgid|setpgrp|setsid|initgroups|kill|reset_signal|wait|waitpid|pipe|close_fd|mkfifo|mknod|umask|getpriority|setpriority|set_scheduling|set_wall_clock|utime|atexit|stop)\s*\("}
MANIFEST_NAME: "^name\\s*:\\s*\"([^\"]+)\""
LETTER: Regex{"\p{{L}}"}
LETTER_OR_NUMBER: Regex{"[\p{{L}}\p{{N}}]"}

NEWLINE: 10
BANG: 33
QUOTE: 34
HASH: 35
APOSTROPHE: 39
OPEN_PAREN: 40
CLOSE_PAREN: 41
STAR: 42
COMMA: 44
DOT: 46
SLASH: 47
COLON: 58
SEMICOLON: 59
OPEN_BRACKET: 91
BACKSLASH: 92
CLOSE_BRACKET: 93
UNDERSCORE: 95
BACKTICK: 96
OPEN_BRACE: 123
CLOSE_BRACE: 125

#Error
RatchetError: struct {
    message: String
}

ratchet_fail: fn(message: String) -> RatchetError { RatchetError{message: message} }

Options: struct {
    root: String
    baseline: String
    update: Bool
    check: Bool
    help: Bool
}

Region: struct {
    package: String
    file: String
    line: Int
    column: Int
    reason: String
}

PackageCount: struct {
    name: String
    count: Int
}

// The scanned or recorded rows: regions in baseline order, counts by package name.
Census: struct {
    total: Int
    counts: [PackageCount]
    regions: [Region]
}

Baseline: struct {
    text: String
    census: Census
}

UnsafeArguments: struct {
    end: Int
    reason: String?
}

UnsafeMarker: struct {
    end: Int
    reason: String
}

MarkerGroup: struct {
    end: Int
    // Markers named Unsafe, not negated, with a plain reason literal; the
    // first one's reason.
    reasoned_unsafe: Int
    reason: String
}

LineCursor: struct {
    offset: Int
    line: Int
    line_start: Int
}

Frame: struct {
    name: String
    is_unsafe: Bool
    line: Int
    depth: Int
    gates: [Int]
}

Abstraction: struct {
    file: String
    function: String
    line: Int
    gates: [Int]
}

Violation: struct {
    file: String
    line: Int
    column: Int
    operation: String
}

RawHit: struct {
    index: Int
    operation: Int
}

AbstractionRow: struct {
    file: String
    function: String
}

CoreLibScan: struct {
    abstractions: [Abstraction]
    violations: [Violation]
}

RowChanges: struct {
    added: [Region]
    removed: [Region]
}

CountChange: struct {
    name: String
    before: Int
    after: Int
}

usage: fn() -> String {
    [String]{
        "usage: {COMMAND} [--update | --check] [--root PATH] [--baseline PATH]",
        "",
        "Scan user-written Jet unsafe regions and compare them with the committed baseline.",
        "A lower count updates the baseline only for exact-row removals. Use --update to approve changes.",
        "--check never writes: any difference from the baseline, a shrink included, fails.",
    }.join("\n")
}

// ---------------------------------------------------------------------------
// Bytes and text

byte_at: fn(source: [U8], index: Int) -> Int {
    if index < 0 || index >= source.len() -> return -1
    Int{source[index]}
}

byte_len: fn(text: String) -> Int { text.bytes().len() }

// The text of bytes `start..<end` of `text`.
byte_slice: fn(text: String, start: Int, end: Int) -> String { String.from_bytes_lossy(text.bytes()[start..<end]) }

byte_tail: fn(text: String, start: Int) -> String { byte_slice(text, start, byte_len(text)) }

span_text: fn(source: [U8], start: Int, end: Int) -> String { String.from_bytes_lossy(source[start..<end]) }

// `word` sits at `index`.
bytes_at: fn(source: [U8], index: Int, word: String) -> Bool {
    expected: word.bytes()
    if index < 0 || index + expected.len() > source.len() -> return false
    loop offset in 0..<expected.len() {
        if source[index + offset] != expected[offset] -> return false
    }
    true
}

comment_at: fn(source: [U8], index: Int) -> Bool {
    byte_at(source, index) == SLASH && (byte_at(source, index + 1) == SLASH || byte_at(source, index + 1) == STAR)
}

triple_quote_at: fn(source: [U8], index: Int) -> Bool {
    byte_at(source, index) == QUOTE && byte_at(source, index + 1) == QUOTE && byte_at(source, index + 2) == QUOTE
}

// Byte width of the UTF-8 scalar whose first byte is `lead`.
scalar_width: fn(lead: Int) -> Int {
    if lead < 192 -> return 1
    if lead < 224 -> return 2
    if lead < 240 -> return 3
    4
}

is_continuation: fn(byte: Int) -> Bool { byte >= 128 && byte < 192 }

code_point: fn(source: [U8], index: Int) -> Int {
    lead: byte_at(source, index)
    width: scalar_width(lead)
    if width == 1 -> return lead
    value := if width == 2 -> lead - 192 else if width == 3 -> lead - 224 else -> lead - 240
    loop offset in 1..<width -> value = value * 64 + byte_at(source, index + offset) - 128
    value
}

scalar_text: fn(source: [U8], index: Int) -> String {
    end: index + scalar_width(byte_at(source, index))
    span_text(source, index, if end > source.len() -> source.len() else -> end)
}

ascii_letter: fn(byte: Int) -> Bool { (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }

ascii_digit: fn(byte: Int) -> Bool { byte >= 48 && byte <= 57 }

identifier_start_at: fn(source: [U8], index: Int) -> Bool {
    byte: byte_at(source, index)
    if byte < 0 -> return false
    if byte < 128 -> return byte == UNDERSCORE || ascii_letter(byte)
    LETTER.full_match(scalar_text(source, index))
}

identifier_char_at: fn(source: [U8], index: Int) -> Bool {
    byte: byte_at(source, index)
    if byte < 0 -> return false
    if byte < 128 -> return byte == UNDERSCORE || ascii_letter(byte) || ascii_digit(byte)
    LETTER_OR_NUMBER.full_match(scalar_text(source, index))
}

// The scalar ending just before `index` is an identifier character. An astral
// scalar never counts: the JavaScript checker this replaced read one UTF-16
// unit back, a lone low surrogate.
identifier_char_before: fn(source: [U8], index: Int) -> Bool {
    start := index - 1
    if start < 0 -> return false
    loop start > 0 && is_continuation(byte_at(source, start)) -> start -= 1
    if scalar_width(byte_at(source, start)) == 4 -> return false
    identifier_char_at(source, start)
}

// Byte width of the ECMAScript `\s` scalar at `index`, 0 when there is none.
space_width: fn(source: [U8], index: Int) -> Int {
    byte: byte_at(source, index)
    if byte == 32 || (byte >= 9 && byte <= 13) -> return 1
    if byte < 128 || scalar_width(byte) == 4 -> return 0
    point: code_point(source, index)
    if point == 160 || point == 5760 || (point >= 8192 && point <= 8202) || point == 8232 || point == 8233 || point == 8239 || point == 8287 || point == 12288 || point == 65279 {
        return scalar_width(byte)
    }
    0
}

skip_space: fn(source: [U8], start: Int) -> Int {
    index := start
    loop {
        width: space_width(source, index)
        if width == 0 -> return index
        index += width
    }
    index
}

skip_comment: fn(source: [U8], start: Int) -> Int {
    if byte_at(source, start + 1) == SLASH {
        index := start + 2
        loop index < source.len() {
            if (Int{source[index]}) == NEWLINE -> return index + 1
            index += 1
        }
        return source.len()
    }
    depth := 1
    index := start + 2
    loop index < source.len() {
        if byte_at(source, index) == SLASH && byte_at(source, index + 1) == STAR {
            depth += 1
            index += 2
        } else if byte_at(source, index) == STAR && byte_at(source, index + 1) == SLASH {
            depth -= 1
            if depth == 0 -> return index + 2
            index += 2
        } else {
            index += 1
        }
    }
    source.len()
}

skip_layout: fn(source: [U8], start: Int) -> Int {
    index := start
    loop {
        spaced: skip_space(source, index)
        if spaced != index {
            index = spaced
        } else if comment_at(source, index) {
            index = skip_comment(source, index)
        } else {
            return index
        }
    }
    index
}

// The end of quoted text opened at `start`; unterminated text runs to the end.
skip_quoted: fn(source: [U8], start: Int, triple: Bool, quote: Int) -> Int {
    width: if triple -> 3 else -> 1
    index := start + width
    loop index < source.len() {
        byte: Int{source[index]}
        if byte == BACKSLASH {
            index += 2
        } else if byte == quote && (!triple || triple_quote_at(source, index)) {
            return index + width
        } else {
            index += 1
        }
    }
    source.len()
}

// The end of the comment or quoted text that starts at `index`, else -1.
skip_literal: fn(source: [U8], index: Int) -> Int {
    byte: byte_at(source, index)
    if comment_at(source, index) -> return skip_comment(source, index)
    if triple_quote_at(source, index) -> return skip_quoted(source, index, true, QUOTE)
    if byte == QUOTE || byte == BACKTICK || byte == APOSTROPHE -> return skip_quoted(source, index, false, byte)
    return -1
}

skip_balanced: fn(source: [U8], start: Int, open: Int, close: Int) -> Int {
    depth := 0
    index := start
    loop index < source.len() {
        literal_end: skip_literal(source, index)
        if literal_end >= 0 {
            index = literal_end
            next
        }
        byte: Int{source[index]}
        if byte == open {
            depth += 1
        } else if byte == close {
            depth -= 1
            if depth == 0 -> return index + 1
        }
        index += 1
    }
    source.len()
}

closer: fn(open: Int) -> Int {
    if open == OPEN_PAREN -> return CLOSE_PAREN
    if open == OPEN_BRACKET -> return CLOSE_BRACKET
    CLOSE_BRACE
}

// A plain Jet string body: `\n \t \" \\` and doubled braces only. Any other
// escape or a single brace (interpolation) is not a plain reason.
decode_jet_string: fn(source: [U8], start: Int, end: Int) -> String? {
    out := [U8]{}
    index := start
    loop index < end {
        byte: Int{source[index]}
        next_byte: if index + 1 < end -> (Int{source[index + 1]}) else -> -1
        if byte == BACKSLASH {
            if next_byte == 110 {
                out.push(U8{10})
            } else if next_byte == 116 {
                out.push(U8{9})
            } else if next_byte == QUOTE || next_byte == BACKSLASH {
                out.push(source[index + 1])
            } else {
                return None
            }
            index += 2
        } else if (byte == OPEN_BRACE || byte == CLOSE_BRACE) && next_byte == byte {
            out.push(source[index])
            index += 2
        } else if byte == OPEN_BRACE || byte == CLOSE_BRACE {
            return None
        } else {
            out.push(source[index])
            index += 1
        }
    }
    Val(String.from_bytes_lossy(out))
}

quoted_reason_at: fn(source: [U8], start: Int) -> String? {
    if byte_at(source, start) != QUOTE || triple_quote_at(source, start) -> return None
    end: skip_quoted(source, start, false, QUOTE)
    if end <= start || byte_at(source, end - 1) != QUOTE -> return None
    decode_jet_string(source, start + 1, end - 1)
}

skip_marker_argument: fn(source: [U8], start: Int) -> Int {
    index := start
    loop index < source.len() {
        literal_end: skip_literal(source, index)
        if literal_end >= 0 {
            index = literal_end
            next
        }
        byte: Int{source[index]}
        if byte == OPEN_PAREN || byte == OPEN_BRACKET || byte == OPEN_BRACE {
            index = skip_balanced(source, index, byte, closer(byte))
            next
        }
        if byte == COMMA || byte == CLOSE_PAREN -> return index
        index += 1
    }
    source.len()
}

// The end of `identifier` at `start`.
identifier_end: fn(source: [U8], start: Int) -> Int {
    index := start + scalar_width(byte_at(source, start))
    loop identifier_char_at(source, index) -> index += scalar_width(byte_at(source, index))
    index
}

// The argument list of `#Unsafe(` at `start` and its reason: the first
// positional or `reason:` argument when it is a plain string literal.
unsafe_arguments_at: fn(source: [U8], start: Int) -> UnsafeArguments? {
    end: skip_balanced(source, start, OPEN_PAREN, CLOSE_PAREN)
    if end <= start || byte_at(source, end - 1) != CLOSE_PAREN -> return None
    index := skip_layout(source, start + 1)
    positional := 0
    reason := String?{None}
    loop index < end - 1 {
        labelled := false
        label_is_reason := false
        if identifier_start_at(source, index) {
            label_end: identifier_end(source, index)
            after_label: skip_layout(source, label_end)
            if byte_at(source, after_label) == COLON {
                labelled = true
                label_is_reason = span_text(source, index, label_end) == "reason"
                index = skip_layout(source, after_label + 1)
            }
        }
        if (label_is_reason || (!labelled && positional == 0)) && reason == None {
            reason = quoted_reason_at(source, index)
        }
        index = skip_marker_argument(source, index)
        if byte_at(source, index) != COMMA -> break
        if !labelled -> positional += 1
        index = skip_layout(source, index + 1)
    }
    Val(UnsafeArguments{end: end, reason: reason})
}

// `#Unsafe("reason")` at `start` that opens a block or marks a function.
unsafe_marker_at: fn(source: [U8], start: Int) -> UnsafeMarker? {
    if byte_at(source, start) != HASH -> return None
    name: skip_layout(source, start + 1)
    if !bytes_at(source, name, "Unsafe") || identifier_char_at(source, name + 6) -> return None
    open: skip_layout(source, name + 6)
    if byte_at(source, open) != OPEN_PAREN -> return None
    arguments: unsafe_arguments_at(source, open) ?? return None
    reason: arguments.reason ?? return None
    if !leads_to_block_or_function(source, arguments.end) -> return None
    Val(UnsafeMarker{end: arguments.end, reason: reason})
}

// The `[` of a `#[...]` marker group at `start`, else -1.
marker_group_start: fn(source: [U8], start: Int) -> Int {
    if byte_at(source, start) != HASH -> return -1
    bracket: skip_layout(source, start + 1)
    if byte_at(source, bracket) == OPEN_BRACKET -> bracket else -> -1
}

marker_group_at: fn(source: [U8], start: Int) -> MarkerGroup? {
    bracket: marker_group_start(source, start)
    if bracket < 0 -> return None
    reasoned_unsafe := 0
    first_reason := ""
    index := bracket + 1
    loop index < source.len() {
        index = skip_layout(source, index)
        if byte_at(source, index) == CLOSE_BRACKET -> return Val(MarkerGroup{end: index + 1, reasoned_unsafe: reasoned_unsafe, reason: first_reason})
        negated := false
        if byte_at(source, index) == BANG {
            negated = true
            index = skip_layout(source, index + 1)
        }
        if !identifier_start_at(source, index) -> return None
        name_end: identifier_end(source, index)
        is_unsafe: span_text(source, index, name_end) == "Unsafe"
        index = skip_layout(source, name_end)
        reason := String?{None}
        if byte_at(source, index) == OPEN_PAREN {
            if is_unsafe {
                arguments: unsafe_arguments_at(source, index) ?? UnsafeArguments{end: skip_balanced(source, index, OPEN_PAREN, CLOSE_PAREN), reason: None}
                reason = arguments.reason
                index = arguments.end
            } else {
                index = skip_balanced(source, index, OPEN_PAREN, CLOSE_PAREN)
            }
        }
        if is_unsafe && !negated && reason != None {
            if reasoned_unsafe == 0 -> first_reason = reason ?? ""
            reasoned_unsafe += 1
        }
        index = skip_layout(source, index)
        if byte_at(source, index) == COMMA {
            index += 1
            next
        }
        if byte_at(source, index) == CLOSE_BRACKET -> return Val(MarkerGroup{end: index + 1, reasoned_unsafe: reasoned_unsafe, reason: first_reason})
        return None
    }
    None
}

// The end of a bare `#Name` or `#Name(...)` marker at `start`, else -1.
skip_bare_marker: fn(source: [U8], start: Int) -> Int {
    if byte_at(source, start) != HASH -> return -1
    index := skip_layout(source, start + 1)
    if byte_at(source, index) == BANG -> index = skip_layout(source, index + 1)
    if !identifier_start_at(source, index) -> return -1
    index = skip_layout(source, identifier_end(source, index))
    if byte_at(source, index) != OPEN_PAREN -> return index
    end: skip_balanced(source, index, OPEN_PAREN, CLOSE_PAREN)
    if end > index && byte_at(source, end - 1) == CLOSE_PAREN -> end else -> -1
}

fn_keyword_at: fn(source: [U8], index: Int) -> Bool {
    byte_at(source, index) == 102 && byte_at(source, index + 1) == 110 && !identifier_char_at(source, index + 2)
}

// A `name: fn`, `pub name: fn` or `Owner.name: fn` declaration head at `index`:
// the offset of its `fn` keyword, or -1.
colon_fn_at: fn(source: [U8], index: Int) -> Int {
    start := index
    if bytes_at(source, start, "pub") && !identifier_char_at(source, start + 3) -> start = skip_layout(source, start + 3)
    if !identifier_start_at(source, start) -> return -1
    end := identifier_end(source, start)
    loop byte_at(source, end) == DOT && identifier_start_at(source, end + 1) -> end = identifier_end(source, end + 1)
    if byte_at(source, end) != COLON -> return -1
    keyword: skip_layout(source, end + 1)
    if fn_keyword_at(source, keyword) -> keyword else -> -1
}

leads_to_function: fn(source: [U8], start: Int) -> Bool {
    index := skip_layout(source, start)
    loop {
        if byte_at(source, index) == SEMICOLON {
            index = skip_layout(source, index + 1)
        } else if marker_group_start(source, index) >= 0 {
            group: marker_group_at(source, index) ?? return false
            index = skip_layout(source, group.end)
        } else if byte_at(source, index) == HASH {
            end: skip_bare_marker(source, index)
            if end < 0 -> return false
            index = skip_layout(source, end)
        } else {
            break
        }
    }
    fn_keyword_at(source, index) || colon_fn_at(source, index) >= 0
}

leads_to_block_or_function: fn(source: [U8], start: Int) -> Bool {
    index: skip_layout(source, start)
    byte_at(source, index) == OPEN_BRACE || leads_to_function(source, index)
}

// Line and scalar column of `index`; calls must not move backwards.
locate: fn(source: [U8], cursor: &LineCursor, index: Int) -> (line: Int, column: Int) {
    loop cursor.offset < index {
        if (Int{source[cursor.offset]}) == NEWLINE {
            cursor.line += 1
            cursor.line_start = cursor.offset + 1
        }
        cursor.offset += 1
    }
    column := 1
    loop offset in cursor.line_start..<index {
        if !is_continuation(Int{source[offset]}) -> column += 1
    }
    (line: cursor.line, column: column)
}

scan_source: fn(source: [U8], file: String, owner: String, regions: &[Region]) {
    cursor := LineCursor{offset: 0, line: 1, line_start: 0}
    index := 0
    loop index < source.len() {
        byte: Int{source[index]}
        if byte == SLASH || byte == QUOTE || byte == BACKTICK || byte == APOSTROPHE {
            literal_end: skip_literal(source, index)
            if literal_end >= 0 {
                index = literal_end
                next
            }
        }
        if byte == HASH {
            if marker_group_start(source, index) >= 0 {
                if marker_group_at(source, index) == {
                    .Val(group) -> {
                        if group.reasoned_unsafe == 1 && leads_to_function(source, group.end) {
                            at: locate(source, cursor, index)
                            regions.push(Region{package: owner.copy(), file: file.copy(), line: at.line, column: at.column, reason: group.reason.copy()})
                        }
                        index = group.end
                        next
                    }
                    .None -> {}
                }
            }
            if unsafe_marker_at(source, index) == {
                .Val(marker) -> {
                    at: locate(source, cursor, index)
                    regions.push(Region{package: owner.copy(), file: file.copy(), line: at.line, column: at.column, reason: marker.reason.copy()})
                    index = marker.end
                    next
                }
                .None -> {}
            }
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Tree walk

// User-written `.jet` files under `base`, as sorted paths relative to it.
jet_files: fn(base: String, relative: String, out: &[String]) RatchetError! -[FS]> {
    directory: if relative == "" -> base else -> files.join(base, relative)
    entries: files.list_dir(directory) ?? return Err(ratchet_fail("cannot list {directory}: {err}"))
    names := [String]{}
    loop entry in entries -> names.push(entry.name.copy())
    names.sort_by(fn(left: String, right: String) { left <=> right })
    loop name in names {
        path: files.join(directory, name)
        if files.is_symlink(path) -> next
        child: if relative == "" -> name.copy() else -> "{relative}/{name}"
        if files.is_dir(path) {
            if SKIP_DIRECTORIES.contains(name) -> next
            jet_files(base, child, out) ?? return Err(err)
        } else if files.is_file(path) && name.ends_with(".jet") {
            out.push(child)
        }
    }
    Ok()
}

// Bytes of the UTF-8 text in `path`; invalid sequences read as U+FFFD.
read_source: fn(path: String) -[FS]> [U8] RatchetError! {
    raw: files.read_bytes(path) ?? return Err(ratchet_fail("cannot read {path}: {err}"))
    Ok(String.from_bytes_lossy(raw).bytes())
}

read_text: fn(path: String) -[FS]> String RatchetError! {
    raw: files.read_bytes(path) ?? return Err(ratchet_fail("cannot read {path}: {err}"))
    Ok(String.from_bytes_lossy(raw))
}

// The manifest's `name:` value, or "" when there is no manifest or no name.
manifest_name: fn(path: String) -[FS]> String RatchetError! {
    if !files.exists(path) -> return Ok("")
    text: read_text(path) ?? return Err(err)
    pattern: regex.compile_with(MANIFEST_NAME, regex.flags(false, true, false)) ?? return Err(ratchet_fail("manifest name pattern: {err}"))
    found: pattern.match(text) ?? return Ok("")
    Ok(found.groups[0].copy())
}

// A region's owner is its top-level repository directory (Compiler, Core,
// Jetpack, Tools, Examples, tests, ...). A file at the scanned root belongs to
// the root package manifest, which is how a single-package checkout is keyed.
package_name: fn(root: String, file: String) -[FS]> String RatchetError! {
    if !file.contains("/") {
        package: manifest_name(files.join(root, "package.jet")) ?? return Err(err)
        if package != "" -> return Ok(package)
        pkg: manifest_name(files.join(root, "pkg.jet")) ?? return Err(err)
        return Ok(if pkg != "" -> pkg else -> "root")
    }
    Ok(file.partition("/").head)
}

compare_regions: fn(left: Region, right: Region) -> Ordering {
    by_package: left.package <=> right.package
    if by_package != .Equal -> return by_package
    by_file: left.file <=> right.file
    if by_file != .Equal -> return by_file
    by_line: left.line <=> right.line
    if by_line != .Equal -> return by_line
    by_column: left.column <=> right.column
    if by_column != .Equal -> return by_column
    left.reason <=> right.reason
}

scan: fn(root: String) -[FS]> Census RatchetError! {
    paths := [String]{}
    jet_files(root, "", paths) ?? return Err(err)
    regions := [Region]{}
    loop file in paths {
        source: read_source(files.join(root, file)) ?? return Err(err)
        owner: package_name(root, file) ?? return Err(err)
        scan_source(source, file, owner, regions)
    }
    // #6319: sort_by with a named comparator crashes; the lambda forwards to it.
    regions.sort_by(fn(left: Region, right: Region) { compare_regions(left, right) })
    counts := [PackageCount]{}
    loop region in regions {
        last: counts.len() - 1
        if last >= 0 && counts[last].name == region.package {
            counts[last].count += 1
        } else {
            counts.push(PackageCount{name: region.package.copy(), count: 1})
        }
    }
    Ok(Census{total: regions.len(), counts: counts, regions: regions})
}

// ---------------------------------------------------------------------------
// CoreLib audit (#4619). Every raw operation in the CoreLib (`Core/**`) must
// sit inside an audited gate, and a CoreLib function that opens an `#Unsafe`
// block without being an `#Unsafe` function itself is a safe abstraction: it
// discharges the obligation for every caller, so it needs a recorded proof in
// the safety.md registry. Otherwise a plain public `fn` launders the gate (a
// caller reaches the raw operation with no `#Unsafe` of its own).

// The source with every comment and quoted text blanked to spaces (line breaks
// kept), so offsets match the source and nothing quoted looks like code.
blank_literals: fn(source: [U8]) -> [U8] {
    code := source.copy()
    index := 0
    loop index < source.len() {
        literal_end: skip_literal(source, index)
        if literal_end < 0 {
            index += 1
            next
        }
        loop offset in index..<literal_end {
            if (Int{code[offset]}) != NEWLINE -> code[offset] = (U8{32})
        }
        index = literal_end
    }
    code
}

// Raw-operation matches in `code`, ordered by offset then operation. Each byte
// past ASCII stands in as U+0001 so match offsets are byte offsets.
raw_hits: fn(code: [U8]) -> [RawHit] {
    ascii := [U8]{}
    loop byte in code -> ascii.push(if Int{byte} < 128 -> byte else -> U8{1})
    text: String.from_bytes_lossy(ascii)
    hits := [RawHit]{}
    if text.contains(".*") {
        loop found in POINTER_DEREFERENCE.matches(text) -> hits.push(RawHit{index: found.start, operation: 0})
    }
    if text.contains("Ptr") {
        loop found in POINTER_FROM_ADDRESS.matches(text) -> hits.push(RawHit{index: found.start, operation: 1})
    }
    if text.contains("volatile_") {
        loop found in VOLATILE_ACCESS.matches(text) -> hits.push(RawHit{index: found.start, operation: 2})
    }
    if text.contains("sys") {
        loop found in POSIX_CONTROL.matches(text) -> hits.push(RawHit{index: found.start, operation: 3})
    }
    hits.sort_by(fn(left: RawHit, right: RawHit) { if left.index != right.index -> left.index <=> right.index else -> left.operation <=> right.operation })
    hits
}

scan_corelib_source: fn(source: [U8], file: String, result: &CoreLibScan) {
    code: blank_literals(source)
    hits: raw_hits(code)
    cursor := LineCursor{offset: 0, line: 1, line_start: 0}
    frames := [Frame]{}
    gates := [Int]{}
    unsafe_frames := 0
    depth := 0
    parens := 0
    has_pending := false
    pending_name := ""
    pending_unsafe := false
    pending_line := 0
    pending_parens := 0
    next_function_unsafe := false
    pending_gate := false
    hit := 0
    index := 0
    loop index < code.len() {
        byte: Int{code[index]}
        if byte == HASH {
            group: if marker_group_start(source, index) >= 0 -> marker_group_at(source, index) else -> None
            if group == {
                .Val(found) -> {
                    if found.reasoned_unsafe > 0 && leads_to_function(source, found.end) -> next_function_unsafe = true
                    index = found.end
                    next
                }
                .None -> {}
            }
            if unsafe_marker_at(source, index) == {
                .Val(marker) -> {
                    if leads_to_function(source, marker.end) {
                        next_function_unsafe = true
                    } else {
                        pending_gate = true
                    }
                    index = marker.end
                    next
                }
                .None -> {}
            }
        }
        if !identifier_char_before(code, index) && byte_at(code, index - 1) != DOT && identifier_start_at(code, index) {
            keyword: if fn_keyword_at(code, index) -> -1 else -> colon_fn_at(code, index)
            if keyword >= 0 {
                name_start: if bytes_at(code, index, "pub") && !identifier_char_at(code, index + 3) -> skip_layout(code, index + 3) else -> index
                has_pending = true
                pending_name = span_text(code, name_start, identifier_end(code, name_start))
                pending_unsafe = next_function_unsafe
                pending_line = locate(source, cursor, index).line
                pending_parens = parens
                next_function_unsafe = false
                index = keyword + 2
                next
            }
        }
        if fn_keyword_at(code, index) && !identifier_char_before(code, index) {
            name_start: skip_layout(code, index + 2)
            if identifier_start_at(code, name_start) {
                name_end: identifier_end(code, name_start)
                has_pending = true
                pending_name = span_text(code, name_start, name_end)
                pending_unsafe = next_function_unsafe
                pending_line = locate(source, cursor, index).line
                pending_parens = parens
                next_function_unsafe = false
                index = name_end
                next
            }
        }
        if byte == OPEN_PAREN || byte == OPEN_BRACKET {
            parens += 1
        } else if byte == CLOSE_PAREN || byte == CLOSE_BRACKET {
            parens -= 1
        } else if byte == OPEN_BRACE {
            depth += 1
            if pending_gate {
                gates.push(depth)
                pending_gate = false
                if frames.len() > 0 -> frames[frames.len() - 1].gates.push(locate(source, cursor, index).line)
            } else if has_pending && parens == pending_parens {
                frames.push(Frame{name: pending_name.copy(), is_unsafe: pending_unsafe, line: pending_line, depth: depth, gates: [Int]{}})
                if pending_unsafe -> unsafe_frames += 1
                has_pending = false
            }
        } else if byte == CLOSE_BRACE {
            // A default parameter can close a value literal before the function body.
            if parens == pending_parens -> has_pending = false
            if gates.len() > 0 && gates[gates.len() - 1] == depth -> _ := gates.pop()
            if frames.len() > 0 && frames[frames.len() - 1].depth == depth {
                frame: frames.pop() ?? panic("a checked frame vanished")
                if frame.is_unsafe -> unsafe_frames -= 1
                if frame.gates.len() > 0 && !frame.is_unsafe {
                    result.abstractions.push(Abstraction{file: file.copy(), function: frame.name.copy(), line: frame.line, gates: frame.gates.copy()})
                }
            }
            depth -= 1
        }
        loop hit < hits.len() && hits[hit].index < index -> hit += 1
        if gates.len() == 0 && unsafe_frames == 0 {
            loop hit < hits.len() && hits[hit].index == index {
                at: locate(source, cursor, index)
                result.violations.push(Violation{file: file.copy(), line: at.line, column: at.column, operation: RAW_OPERATIONS[hits[hit].operation].copy()})
                hit += 1
            }
        }
        index += 1
    }
}

scan_corelib: fn(root: String) -[FS]> CoreLibScan RatchetError! {
    result := CoreLibScan{abstractions: [Abstraction]{}, violations: [Violation]{}}
    directory: files.join(root, CORELIB_DIRECTORY)
    if !files.exists(directory) -> return Ok(result)
    paths := [String]{}
    jet_files(directory, "", paths) ?? return Err(err)
    loop file in paths {
        source: read_source(files.join(directory, file)) ?? return Err(err)
        scan_corelib_source(source, "{CORELIB_DIRECTORY}/{file}", result)
    }
    Ok(result)
}

object_fields: fn(value: Dyn) -> [(key: String, value: Dyn)]? {
    if value == {
        .Object(fields) -> return Val(fields.copy())
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> return None
    }
}

// The last value of `key`, as JSON.parse keeps the last duplicate.
field: fn(fields: [(key: String, value: Dyn)], key: String) -> Dyn? {
    index := fields.len() - 1
    loop index >= 0 {
        if fields[index].key == key -> return Val(fields[index].value.copy())
        index -= 1
    }
    None
}

text_field: fn(fields: [(key: String, value: Dyn)], key: String) -> String? {
    value: field(fields, key) ?? return None
    if value == {
        .Text(text) -> return Val(text.copy())
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return None
    }
}

// A JSON integer: an Int, or a numeric lexeme with an integral value.
integer: fn(value: Dyn) -> Int? {
    if value == {
        .Int(number) -> return Val(number)
        .Number(lexeme) -> {
            number: Int.parse(lexeme) ?? return None
            return Val(number)
        }
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return None
    }
}

int_field: fn(fields: [(key: String, value: Dyn)], key: String) -> Int? {
    value: field(fields, key) ?? return None
    integer(value)
}

json_text: fn(text: String) -> String RatchetError! {
    encoded: json.to_string(Dyn.Text(text.copy())) ?? return Err(ratchet_fail("cannot encode JSON text: {err}"))
    Ok(encoded)
}

// UTF-16 code units of `text`, the length JavaScript strings report.
utf16_length: fn(text: String) -> Int {
    total := 0
    loop scalar in text.chars() -> total += if "{scalar}".bytes().len() == 4 -> 2 else -> 1
    total
}

// The registry is one JSON array between the abstraction markers in the
// baseline document: `{ "file", "function", "proof" }` rows written by a
// reviewer. The checker never invents a proof; `--update` leaves it alone.
// A document with neither marker has an empty registry.
read_abstractions: fn(text: String) -> [AbstractionRow] RatchetError! {
    begin: text.find(ABSTRACTIONS_BEGIN)
    end: text.find(ABSTRACTIONS_END)
    if begin < 0 && end < 0 -> return Ok([AbstractionRow]{})
    if begin < 0 || end < begin -> return Err(ratchet_fail("safe-abstraction registry markers are unbalanced"))
    registry: byte_slice(text, begin + byte_len(ABSTRACTIONS_BEGIN), end)
    fence: registry.find("```json\n")
    if fence < 0 -> return Err(ratchet_fail("safe-abstraction registry has no ```json block"))
    body: byte_tail(registry, fence + byte_len("```json\n"))
    close: body.find("\n```")
    if close < 0 -> return Err(ratchet_fail("safe-abstraction registry has no ```json block"))
    parsed: json.parse(byte_slice(body, 0, close)) ?? return Err(ratchet_fail("safe-abstraction registry has invalid JSON: {err}"))
    items := [Dyn]{}
    if parsed == {
        .Array(values) -> items = values.copy()
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> return Err(ratchet_fail("safe-abstraction registry must be a JSON array"))
    }
    rows := [AbstractionRow]{}
    loop item in items {
        fields: object_fields(item) ?? [(key: String, value: Dyn)]{}
        file: text_field(fields, "file")
        function: text_field(fields, "function")
        proof: text_field(fields, "proof")
        if file == None || function == None || proof == None || utf16_length((proof ?? "").trim()) < 20 {
            row: json.to_string(item) ?? return Err(ratchet_fail("cannot encode JSON row: {err}"))
            return Err(ratchet_fail("safe-abstraction registry row needs file, function and a proof of at least 20 characters: {row}"))
        }
        rows.push(AbstractionRow{file: file ?? "", function: function ?? ""})
    }
    Ok(rows)
}

check_corelib: fn(root: String, baseline_text: String) -[FS]> String RatchetError! {
    current: scan_corelib(root) ?? return Err(err)
    rows: read_abstractions(baseline_text) ?? return Err(err)
    recorded := [String: Bool]{}
    loop row in rows -> recorded["{row.file}\t{row.function}"] = true
    problems := [String]{}
    loop violation in current.violations {
        problems.push("  - {violation.file}:{violation.line}:{violation.column} {violation.operation} outside an audited #Unsafe gate")
    }
    found := [String: Bool]{}
    loop abstraction in current.abstractions {
        key: "{abstraction.file}\t{abstraction.function}"
        found[key.copy()] = true
        if recorded.get(key) == None {
            lines: loop line in abstraction.gates -> "{line}"
            problems.push("  - {abstraction.file}:{abstraction.line} fn {abstraction.function} opens #Unsafe at line {lines.join(", ")} but is not an #Unsafe function and has no recorded safe-abstraction proof")
        }
    }
    loop row in rows {
        if found.get("{row.file}\t{row.function}") == None {
            problems.push("  - stale safe-abstraction row: {row.file} fn {row.function} no longer opens an #Unsafe block")
        }
    }
    if problems.len() == 0 -> return Ok("")
    lines := [String]{"CoreLib unsafe audit failed:"}
    loop problem in problems -> lines.push(problem)
    lines.push("make the function `#Unsafe(\"<caller contract>\") name: fn …` so every caller audits the call, or record why it is a safe")
    lines.push("abstraction in the safety.md unsafe-abstractions registry (file, function, proof).")
    Ok(lines.join("\n"))
}

// ---------------------------------------------------------------------------
// Baseline document

// JavaScript truthiness of a parsed JSON value.
truthy: fn(value: Dyn) -> Bool {
    if value == {
        .Null -> return false
        .Bool(flag) -> return flag
        .Int(number) -> return number != 0
        .Number(lexeme) -> return (Float.parse(lexeme) ?? 0.0) != 0.0
        .Float(number) -> return number != 0.0
        .Text(text) -> return text != ""
        .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return true
    }
}

census_from_json: fn(parsed: Dyn) -> Census RatchetError! {
    invalid: "unsafe baseline has invalid data"
    fields: object_fields(parsed) ?? return Err(ratchet_fail(invalid))
    schema: int_field(fields, "schema") ?? return Err(ratchet_fail(invalid))
    total: int_field(fields, "total") ?? return Err(ratchet_fail(invalid))
    counts_value: field(fields, "counts") ?? return Err(ratchet_fail(invalid))
    regions_value: field(fields, "regions") ?? return Err(ratchet_fail(invalid))
    if schema != 1 || !truthy(counts_value) -> return Err(ratchet_fail(invalid))
    items := [Dyn]{}
    if regions_value == {
        .Array(values) -> items = values.copy()
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> return Err(ratchet_fail(invalid))
    }
    if total != items.len() -> return Err(ratchet_fail("unsafe baseline total does not match its region rows"))
    regions := [Region]{}
    loop item in items {
        row: object_fields(item) ?? return Err(ratchet_fail("unsafe baseline has an invalid region row"))
        package: text_field(row, "package")
        file: text_field(row, "file")
        line: int_field(row, "line")
        column: int_field(row, "column")
        reason: text_field(row, "reason")
        if package == None || file == None || line == None || column == None || reason == None {
            return Err(ratchet_fail("unsafe baseline has an invalid region row"))
        }
        regions.push(Region{package: package ?? "", file: file ?? "", line: line ?? 0, column: column ?? 0, reason: reason ?? ""})
    }
    counts := [PackageCount]{}
    loop region in regions {
        known := false
        loop index in 0..<counts.len() {
            if counts[index].name == region.package {
                counts[index].count += 1
                known = true
            }
        }
        if !known -> counts.push(PackageCount{name: region.package.copy(), count: 1})
    }
    counts.sort_by(fn(left: PackageCount, right: PackageCount) { left.name <=> right.name })
    recorded: object_fields(counts_value) ?? return Err(ratchet_fail("unsafe baseline counts do not match its region rows"))
    matches := recorded.len() == counts.len()
    loop index in 0..<counts.len() {
        if !matches -> break
        matches = recorded[index].key == counts[index].name && integer(recorded[index].value) == Val(counts[index].count)
    }
    if !matches -> return Err(ratchet_fail("unsafe baseline counts do not match its region rows"))
    Ok(Census{total: total, counts: counts, regions: regions})
}

census_json: fn(census: Census) -> Dyn {
    counts := [String: Dyn]{}
    loop entry in census.counts -> counts[entry.name.copy()] = Dyn.Int(entry.count)
    regions := [Dyn]{}
    loop region in census.regions {
        regions.push(Dyn.Object([String: Dyn]{"package": Dyn.Text(region.package.copy()), "file": Dyn.Text(region.file.copy()), "line": Dyn.Int(region.line), "column": Dyn.Int(region.column), "reason": Dyn.Text(region.reason.copy())}))
    }
    Dyn.Object([String: Dyn]{"schema": Dyn.Int(1), "total": Dyn.Int(census.total), "counts": Dyn.Object(counts), "regions": Dyn.Array(regions)})
}

markdown_cell: fn(value: String) -> String {
    value.replace("&", "&amp;").replace("|", "&#124;").replace("<", "&lt;").replace(">", "&gt;")
}

render_section: fn(census: Census) -> String RatchetError! {
    data: json.to_string_pretty(census_json(census)) ?? return Err(ratchet_fail("cannot encode the baseline data: {err}"))
    lines := [String]{"{DATA_BEGIN}\n{data}\n{DATA_END}", "", "### Counts", "", "| crate/package | regions |", "| --- | ---: |"}
    if census.counts.len() == 0 -> lines.push("| (none) | 0 |")
    loop entry in census.counts -> lines.push("| {markdown_cell(entry.name)} | {entry.count} |")
    lines.push("| **total** | **{census.total}** |")
    lines.push("")
    lines.push("### Regions")
    lines.push("")
    lines.push("| crate/package | file | line | reason |")
    lines.push("| --- | --- | ---: | --- |")
    if census.regions.len() == 0 -> lines.push("| (none) | (none) | - | (none) |")
    loop region in census.regions {
        reason: json_text(region.reason) ?? return Err(err)
        lines.push("| {markdown_cell(region.package)} | {markdown_cell(region.file)} | {region.line}:{region.column} | {markdown_cell(reason)} |")
    }
    Ok(lines.join("\n"))
}

// Byte offsets of the generated section's markers, or None.
section_bounds: fn(text: String) -> (begin: Int, end: Int)? {
    begin: text.find(BEGIN)
    end: text.find(END)
    if begin < 0 || end < 0 || end < begin -> return None
    Val((begin: begin, end: end))
}

baseline_document: fn(text: String, census: Census) -> String RatchetError! {
    section: render_section(census) ?? return Err(err)
    bounds: section_bounds(text) ?? return Ok("{text.trim_end()}\n\n{BEGIN}\n{section}\n{END}\n")
    Ok("{byte_slice(text, 0, bounds.begin)}{BEGIN}\n{section}\n{END}{byte_tail(text, bounds.end + byte_len(END))}")
}

parse_baseline: fn(path: String, text: String) -> Baseline RatchetError! {
    bounds: section_bounds(text) ?? return Err(ratchet_fail("baseline {path} has no unsafe-ratchet section"))
    body := byte_slice(text, bounds.begin + byte_len(BEGIN), bounds.end)
    if body.starts_with("\n") -> body = byte_tail(body, 1)
    if body.ends_with("\n") -> body = byte_slice(body, 0, byte_len(body) - 1)
    header: "{DATA_BEGIN}\n"
    if !body.starts_with(header) -> return Err(ratchet_fail("baseline {path} has no unsafe-ratchet data"))
    rest: byte_tail(body, byte_len(header))
    close: rest.find("\n{DATA_END}")
    if close < 0 -> return Err(ratchet_fail("baseline {path} has no unsafe-ratchet data"))
    parsed: json.parse(byte_slice(rest, 0, close)) ?? return Err(ratchet_fail("baseline {path} has invalid JSON: {err}"))
    census: census_from_json(parsed) ?? return Err(err)
    rendered: render_section(census) ?? return Err(err)
    if body != rendered -> return Err(ratchet_fail("baseline {path} has stale generated rows; run the ratchet with --update"))
    Ok(Baseline{text: text.copy(), census: census})
}

read_baseline: fn(path: String) -[FS]> Baseline RatchetError! {
    if !files.exists(path) -> return Err(ratchet_fail("missing baseline {path}"))
    text: read_text(path) ?? return Err(err)
    parse_baseline(path, text)
}

// ---------------------------------------------------------------------------
// Ratchet

semantic_key: fn(region: Region) -> String {
    "{byte_len(region.package)}:{region.package}{byte_len(region.file)}:{region.file}{region.reason}"
}

exact_key: fn(region: Region) -> String {
    "{byte_len(region.package)}:{region.package}{byte_len(region.file)}:{region.file}{region.line}:{region.column}:{region.reason}"
}

tally: fn(regions: [Region], exact: Bool) -> [String: Int] {
    remaining := [String: Int]{}
    loop region in regions {
        key: if exact -> exact_key(region) else -> semantic_key(region)
        remaining[key.copy()] = (remaining.get(key) ?? 0) + 1
    }
    remaining
}

// Current rows with no counterpart left in `remaining`, which they consume.
unmatched: fn(current: [Region], remaining: &[String: Int], exact: Bool) -> [Region] {
    added := [Region]{}
    loop region in current {
        key: if exact -> exact_key(region) else -> semantic_key(region)
        count: remaining.get(key) ?? 0
        if count > 0 {
            remaining[key.copy()] = count - 1
        } else {
            added.push(region.copy())
        }
    }
    added
}

same_regions: fn(current: Census, baseline: Census) -> Bool {
    if current.regions.len() != baseline.regions.len() -> return false
    loop index in 0..<current.regions.len() {
        if exact_key(current.regions[index]) != exact_key(baseline.regions[index]) -> return false
    }
    true
}

stale_rows: fn(current: Census, baseline: Census) -> RowChanges {
    remaining := tally(baseline.regions, true)
    added: unmatched(current.regions, remaining, true)
    removed := [Region]{}
    loop region in baseline.regions {
        key: exact_key(region)
        count: remaining.get(key) ?? 0
        if count > 0 {
            remaining[key.copy()] = count - 1
            removed.push(region.copy())
        }
    }
    RowChanges{added: added, removed: removed}
}

count_of: fn(counts: [PackageCount], name: String) -> Int {
    loop entry in counts {
        if entry.name == name -> return entry.count
    }
    0
}

increases: fn(current: Census, baseline: Census) -> [CountChange] {
    names := [String]{}
    loop entry in current.counts {
        if !names.contains(entry.name) -> names.push(entry.name.copy())
    }
    loop entry in baseline.counts {
        if !names.contains(entry.name) -> names.push(entry.name.copy())
    }
    names.sort_by(fn(left: String, right: String) { left <=> right })
    changes := [CountChange]{}
    loop name in names {
        before: count_of(baseline.counts, name)
        after: count_of(current.counts, name)
        if after > before -> changes.push(CountChange{name: name.copy(), before: before, after: after})
    }
    changes
}

region_line: fn(region: Region) -> String RatchetError! {
    reason: json_text(region.reason) ?? return Err(err)
    Ok("  - {region.package} {region.file}:{region.line}:{region.column} reason {reason}")
}

format_growth: fn(changes: [CountChange], added: [Region]) -> String RatchetError! {
    lines := [String]{"unsafe-region baseline grew:"}
    loop change in changes -> lines.push("  {change.name}: {change.before} -> {change.after}")
    lines.push("new regions:")
    if added.len() == 0 -> lines.push("  (baseline rows changed without enough named rows to identify the additions)")
    loop region in added -> lines.push(region_line(region) ?? return Err(err))
    lines.push("update the committed baseline in the same change:")
    lines.push("  {COMMAND} --update")
    Ok(lines.join("\n"))
}

format_stale: fn(changes: RowChanges) -> String RatchetError! {
    lines := [String]{"unsafe-region baseline is stale; semantic site rows changed:", "current rows:"}
    if changes.added.len() == 0 -> lines.push("  (none)")
    loop region in changes.added -> lines.push(region_line(region) ?? return Err(err))
    lines.push("baseline rows no longer present:")
    if changes.removed.len() == 0 -> lines.push("  (none)")
    loop region in changes.removed -> lines.push(region_line(region) ?? return Err(err))
    lines.push("refresh the committed baseline in the same change:")
    lines.push("  {COMMAND} --update")
    Ok(lines.join("\n"))
}

write_text: fn(path: String, text: String) RatchetError! -[FS]> {
    files.write(path, text) ?? return Err(ratchet_fail("cannot write {path}: {err}"))
    Ok()
}

// Compare the scan with the baseline; false when the check failed.
ratchet: fn(options: Options) -[FS, IO]> Bool RatchetError! {
    current: scan(options.root) ?? return Err(err)
    baseline: read_baseline(options.baseline) ?? {
        if !options.update -> return Err(err)
        text: if files.exists(options.baseline) -> read_text(options.baseline) ?? return Err(err) else -> "# Safety\n"
        write_text(options.baseline, baseline_document(text, current) ?? return Err(err)) ?? return Err(err)
        print("unsafe ratchet: initialized baseline with {current.total} regions")
        return Ok(true)
    }
    if options.update {
        write_text(options.baseline, baseline_document(baseline.text, current) ?? return Err(err)) ?? return Err(err)
        print("unsafe ratchet: baseline updated to {current.total} regions")
        return Ok(true)
    }
    grown: increases(current, baseline.census)
    if grown.len() > 0 {
        remaining := tally(baseline.census.regions, false)
        term.eprint(format_growth(grown, unmatched(current.regions, remaining, false)) ?? return Err(err))
        return Ok(false)
    }
    if current.total < baseline.census.total {
        changes: stale_rows(current, baseline.census)
        if changes.added.len() > 0 {
            term.eprint(format_stale(changes) ?? return Err(err))
            return Ok(false)
        }
        if options.check {
            term.eprint("{format_stale(changes) ?? return Err(err)}\nunsafe ratchet: --check never writes; run {COMMAND} to record the shrink")
            return Ok(false)
        }
        write_text(options.baseline, baseline_document(baseline.text, current) ?? return Err(err)) ?? return Err(err)
        print("unsafe ratchet: baseline decreased to {current.total} regions")
        return Ok(true)
    }
    if !same_regions(current, baseline.census) {
        term.eprint(format_stale(stale_rows(current, baseline.census)) ?? return Err(err))
        return Ok(false)
    }
    print("unsafe ratchet: {current.total} regions; baseline unchanged")
    Ok(true)
}

// `path` made absolute against the working directory, with `.` and `..` resolved.
resolved: fn(path: String) -[FS, Env]> String RatchetError! {
    absolute: files.absolute(path) ?? return Err(ratchet_fail("cannot resolve {path}: {err}"))
    Ok(files.collapse(absolute))
}

parse_args: fn(args: [String]) -[FS, Env]> Options RatchetError! {
    root: resolved(".") ?? return Err(err)
    options := Options{root: root.copy(), baseline: files.join(root, "Docs/spec/safety.md"), update: false, check: false, help: false}
    index := 0
    loop index < args.len() {
        arg: args[index]
        if arg == "--update" {
            options.update = true
        } else if arg == "--check" {
            options.check = true
        } else if arg == "--root" || arg == "--baseline" {
            index += 1
            value: if index < args.len() -> args[index].copy() else -> ""
            if value == "" -> return Err(ratchet_fail("{arg} needs a path"))
            path: resolved(value) ?? return Err(err)
            if arg == "--root" {
                options.root = path
            } else {
                options.baseline = path
            }
        } else if arg == "--help" {
            options.help = true
            return Ok(options)
        } else {
            return Err(ratchet_fail("unknown option {arg}\n\n{usage()}"))
        }
        index += 1
    }
    if options.update && options.check -> return Err(ratchet_fail("--update and --check exclude each other\n\n{usage()}"))
    Ok(options)
}

// Run the ratchet and the CoreLib audit; false when either failed.
unsafe_ratchet_main: fn(args: [String]) -[FS, Env, IO]> Bool RatchetError! {
    options: parse_args(args) ?? return Err(err)
    if options.help {
        print(usage())
        return Ok(true)
    }
    passed := ratchet(options) ?? return Err(err)
    baseline_text: if files.exists(options.baseline) -> read_text(options.baseline) ?? return Err(err) else -> ""
    problems: check_corelib(options.root, baseline_text) ?? return Err(err)
    if problems != "" {
        term.eprint(problems)
        passed = false
    } else {
        print("unsafe ratchet: CoreLib raw operations all gated; every safe abstraction has a recorded proof")
    }
    Ok(passed)
}

run: fn() {
    passed: unsafe_ratchet_main(process.args()) ?? process.fail(1, "unsafe ratchet: {err.message}")
    if !passed -> process.exit(1)
}

// ---------------------------------------------------------------------------
// Tests

scanned: fn(text: String, file: String) -> [Region] {
    regions := [Region]{}
    scan_source(text.bytes(), file, "pkg", regions)
    regions
}

audited: fn(text: String) -> CoreLibScan {
    result := CoreLibScan{abstractions: [Abstraction]{}, violations: [Violation]{}}
    scan_corelib_source(text.bytes(), "Core/Sys/Sys.jet", result)
    result
}

#Test("blocks and function markers are regions; comments, text and interpolated reasons are not") {
    source: "// #Unsafe(\"comment\") {{}}\na: fn() {{\n    s: \"#Unsafe(\\\"text\\\") {{}}\"\n    é #Unsafe(\"block \\\"one\\\" {{{{x}}}}\") {{ }}\n}}\n#Unsafe(reason: \"marked\")\n#Inline\nb: fn() {{}}\n#Unsafe(\"x{{y}}\") {{}}\n#[Unsafe(\"grouped\"), Inline] c: fn() {{}}\n#[Unsafe(\"one\"), Unsafe(\"two\")] d: fn() {{}}\n#Unsafe(\"no body\")\nlet x = 1\n"
    regions: scanned(source, "a.jet")
    assert_eq(regions.len(), 3)
    assert_eq(regions[0].line, 4)
    assert_eq(regions[0].column, 7)
    assert_eq(regions[0].reason, "block \"one\" {{x}}")
    assert_eq(regions[1].line, 6)
    assert_eq(regions[1].reason, "marked")
    assert_eq(regions[2].line, 10)
    assert_eq(regions[2].reason, "grouped")
}

#Test("nested block comments and unterminated text end the scan cleanly") {
    regions: scanned("/* outer /* inner */ #Unsafe(\"hidden\") {{}} */\n#Unsafe(\"seen\") {{}}\n\"open", "b.jet")
    assert_eq(regions.len(), 1)
    assert_eq(regions[0].line, 2)
    assert_eq(regions[0].column, 1)
}

#Test("CoreLib raw operations need a gate and safe abstractions are reported") {
    ungated: audited("spawn: fn() -> Int {{\n    core.sys.fork()\n}}\n")
    assert_eq(ungated.violations.len(), 1)
    assert_eq(ungated.violations[0].operation, "POSIX control")
    assert_eq(ungated.violations[0].line, 2)
    assert_eq(ungated.violations[0].column, 5)
    laundered: audited("fork: fn() -> Int {{\n    #Unsafe(\"child\") {{\n        core.sys.fork()\n    }}\n}}\n")
    assert_eq(laundered.violations.len(), 0)
    assert_eq(laundered.abstractions.len(), 1)
    assert_eq(laundered.abstractions[0].function, "fork")
    assert_eq(laundered.abstractions[0].gates[0], 2)
    marked: audited("#Unsafe(\"callers fork\")\nfork: fn() -> Int {{\n    #Unsafe(\"child\") {{ core.sys.fork() }}\n    p.*\n}}\n")
    assert_eq(marked.violations.len(), 0)
    assert_eq(marked.abstractions.len(), 0)
    defaults: audited("default_plain: fn(options: Opts = Opts{{}}) {{\n    x\n}}\ndefault_gated: fn(options: Opts = Opts{{}}) {{\n    #Unsafe(\"gate\") {{ q.* }}\n}}\n")
    assert_eq(defaults.abstractions.len(), 1)
    assert_eq(defaults.abstractions[0].function, "default_gated")
    quoted: audited("f: fn() {{ s: \"core.sys.kill(1)\" // p.*\n}}\n")
    assert_eq(quoted.violations.len(), 0)
}

#Test("the generated section round-trips and stale rows are refused") {
    census: Census{total: 1, counts: [PackageCount]{PackageCount{name: "Core", count: 1}}, regions: [Region]{Region{package: "Core", file: "Core/A.jet", line: 3, column: 5, reason: "a|b <c>"}}}
    document: baseline_document("# Safety\n\n", census) ?? panic("render: {err.message}")
    assert(document.starts_with("# Safety\n\n{BEGIN}\n{DATA_BEGIN}\n{{\n  \"schema\": 1,\n  \"total\": 1,\n  \"counts\": {{\n    \"Core\": 1\n  }},"))
    assert(document.contains("| Core | Core/A.jet | 3:5 | \"a&#124;b &lt;c&gt;\" |\n{END}\n"))
    baseline: parse_baseline("safety.md", document) ?? panic("parse: {err.message}")
    assert_eq(baseline.census.regions[0].reason, "a|b <c>")
    if parse_baseline("safety.md", document.replace("| 3:5 |", "| 3:6 |")) == {
        .Ok(_) -> panic("a stale table row was accepted")
        .Err(error) -> assert_eq(error.message, "baseline safety.md has stale generated rows; run the ratchet with --update")
    }
    empty: render_section(Census{total: 0, counts: [PackageCount]{}, regions: [Region]{}}) ?? panic("empty: {err.message}")
    assert(empty.contains("| (none) | 0 |\n| **total** | **0** |"))
    assert(empty.ends_with("| (none) | (none) | - | (none) |"))
}

#Test("growth names the added rows and a pure shrink has no added rows") {
    one: Region{package: "P", file: "a.jet", line: 1, column: 1, reason: "r"}
    two: Region{package: "P", file: "b.jet", line: 1, column: 1, reason: "s"}
    small: Census{total: 1, counts: [PackageCount]{PackageCount{name: "P", count: 1}}, regions: [Region]{one.copy()}}
    large: Census{total: 2, counts: [PackageCount]{PackageCount{name: "P", count: 2}}, regions: [Region]{one.copy(), two.copy()}}
    grown: increases(large, small)
    assert_eq(grown.len(), 1)
    remaining := tally(small.regions, false)
    added: unmatched(large.regions, remaining, false)
    assert_eq(added.len(), 1)
    assert_eq(added[0].file, "b.jet")
    shrink: stale_rows(small, large)
    assert_eq(shrink.added.len(), 0)
    assert_eq(shrink.removed.len(), 1)
}

#Test("registry rows need a proof of twenty characters") {
    good: "{ABSTRACTIONS_BEGIN}\n```json\n[{{\"file\": \"Core/A.jet\", \"function\": \"f\", \"proof\": \"the caller contract is discharged here\"}}]\n```\n{ABSTRACTIONS_END}"
    rows: read_abstractions(good) ?? panic("rows: {err.message}")
    assert_eq(rows.len(), 1)
    assert_eq(rows[0].function, "f")
    if read_abstractions(good.replace("the caller contract is discharged here", "short")) == {
        .Ok(_) -> panic("a short proof was accepted")
        .Err(error) -> assert(error.message.starts_with("safe-abstraction registry row needs file, function and a proof of at least 20 characters: "))
    }
    missing: read_abstractions("no registry") ?? panic("none: {err.message}")
    assert_eq(missing.len(), 0)
}

#Test("--check compares without writing and excludes --update") {
    checked: parse_args([String]{"--check"}) ?? panic("--check: {err.message}")
    assert(checked.check && !checked.update)
    if parse_args([String]{"--check", "--update"}) == {
        .Ok(_) -> panic("--check with --update was accepted")
        .Err(error) -> assert(error.message.starts_with("--update and --check exclude each other"))
    }
}
