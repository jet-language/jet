#!/usr/bin/env jet
// Generates Core/Text/CollationTable.jet, the table behind `text.collate` and
// `text.collation_key` (D-TEXT-COLLATE1=A): the CLDR root collation order for
// Unicode 17.0.0, which English uses untailored.
// Inputs, both vendored and listed in tests/data/unicode/SHA256SUMS:
//   tests/data/unicode/uca/allkeys_CLDR.txt  (CLDR 48 root, UCA 17.0.0)
//   tests/data/unicode/ucd/PropList.txt      (Unified_Ideograph, for implicit weights)
// Usage (from the repository root):
//   jet Tools/agent/CollationTable.jet           rewrite the table
//   jet Tools/agent/CollationTable.jet --check   fail when the table is stale
use core.crypto as crypto
use core.files as files
use core.process as process
use core.term as term

ALLKEYS_PATH :: "tests/data/unicode/uca/allkeys_CLDR.txt"
PROPLIST_PATH :: "tests/data/unicode/ucd/PropList.txt"
SUMS_PATH :: "tests/data/unicode/SHA256SUMS"
TARGET_PATH :: "Core/Text/CollationTable.jet"
ABSENT :: 16777215
HEX_DIGITS :: "0123456789ABCDEF"
#Error
struct TableError {
    message: String
}

// One allkeys row: 1-3 scalars and their collation elements, each
// (primary, secondary, tertiary). Variable weighting is non-ignorable, so the
// `*` marker carries no meaning here.
struct KeyRow {
    scalars: [Int]
    elements: [Int]
    rank: Int
}

fn fail(message: String) -> TableError {
    TableError{message: message}
}

fn hex_value(text: String) -> Int TableError! {
    if text.len() == 0 -> return Err(fail("empty hex field"))
    value := 0
    loop byte in text.bytes() {
        digit :: Int.from_u8(byte)
        is_decimal :: digit >= 48 && digit <= 57
        if !is_decimal && (digit < 65 || digit > 70) -> return Err(fail("bad hex field '{text}'"))
        value = value * 16 + digit - (if is_decimal -> 48 else -> 55)
    }
    Ok(value)
}

// `[.2528.0020.0002][*0209.0020.0002]` -> flat (p, s, t) triples.
fn parse_elements(text: String) -> [Int] TableError! {
    out := [Int]{}
    rest := text.trim()
    loop {
        if rest == "" -> return Ok(out)
        opened :: rest.partition("[")
        if opened.sep == "" || opened.head.trim() != "" -> return Err(fail("bad element list '{text}'"))
        closed :: opened.tail.partition("]")
        if closed.sep == "" -> return Err(fail("unclosed element in '{text}'"))
        body :: closed.head
        weights :: body.replace("*", ".").split(".").to_list()
        if weights.len() != 4 || weights[0] != "" -> return Err(fail("element '{body}' is not three weights"))
        loop at in 1..<4 -> &out.push(hex_value(weights[at]))
        rest = closed.tail.trim()
    }
}

fn parse_allkeys(source: String) -> [KeyRow] TableError! {
    rows := [KeyRow]{}
    version_seen := false
    loop raw in source.split("\n") {
        line :: raw.partition("#").head.trim()
        if line == "" -> next
        if line.starts_with("@version") {
            if line != "@version 17.0.0" -> return Err(fail("{ALLKEYS_PATH} is {line}, expected @version 17.0.0"))
            version_seen = true
            next
        }
        if line.starts_with("@") -> return Err(fail("unexpected directive '{line}'"))
        fields :: line.partition(";")
        if fields.sep == "" -> return Err(fail("row without ';': '{line}'"))
        scalars := [Int]{}
        loop word in fields.head.trim().split(" ") {
            if word != "" -> &scalars.push(hex_value(word))
        }
        if scalars.len() < 1 || scalars.len() > 3 -> return Err(fail("row key '{fields.head}' has {scalars.len()} scalars"))
        elements :: parse_elements(fields.tail)
        if elements.len() == 0 -> return Err(fail("row '{line}' has no elements"))
        slot := 0
        loop weight in elements {
            limit :: if slot == 2 -> 255 else -> 65535
            if weight > limit -> return Err(fail("weight {weight} of '{line}' exceeds {limit}"))
            slot = if slot == 2 -> 0 else -> slot + 1
        }
        &rows.push(KeyRow{scalars: scalars, elements: elements, rank: key_rank(scalars)})
    }
    if !version_seen -> return Err(fail("{ALLKEYS_PATH} has no @version line"))
    Ok(rows)
}

// Unified_Ideograph ranges from PropList.txt as flat (first, last) pairs.
fn parse_unified_ideographs(source: String) -> [Int] TableError! {
    ranges := [Int]{}
    loop raw in source.split("\n") {
        line :: raw.partition("#").head.trim()
        if line == "" -> next
        fields :: line.partition(";")
        if fields.tail.trim() != "Unified_Ideograph" -> next
        span :: fields.head.trim().partition("..")
        first :: hex_value(span.head.trim())
        last :: if span.sep == "" -> first else -> hex_value(span.tail.trim())
        &ranges.push(first)
        &ranges.push(last)
    }
    if ranges.len() == 0 -> return Err(fail("{PROPLIST_PATH} lists no Unified_Ideograph ranges"))
    Ok(ranges)
}

// Rows sort by scalar sequence; a shorter key sorts before its extensions.
// Scalars are below 2^21, so three of them pack into one Int.
fn key_rank(scalars: [Int]) -> Int {
    rank := 0
    used := 0
    loop scalar in scalars {
        rank = rank * 2097152 + (if used == 0 -> scalar else -> scalar + 1)
        used += 1
    }
    loop _pad in used..<3 -> rank *= 2097152
    rank
}

fn sorted_rows(rows: [KeyRow]) -> [KeyRow] Never! {
    out := [KeyRow]{}
    loop row in rows -> &out.push(row)
    &out.sort_by((row: KeyRow) -> row.rank)
    out
}

fn push_le(out: &[U8], value: Int, width: Int) {
    loop at in 0..<width -> &out.push(U8{(value >> (8 * at)).bit_and(Int{255})})
}

struct Tables {
    singles: [U8]
    single_count: Int
    contractions: [U8]
    contraction_count: Int
    elements: [U8]
    element_count: Int
}

// Singles: 7-byte rows [scalar:3, first element:3, element count:1].
// Contractions: 13-byte rows [scalar:3, scalar:3, scalar:3 (ABSENT when the
// key is shorter), first element:3, element count:1].
// Elements: 5-byte rows [primary:2, secondary:2, tertiary:1]. All little-endian.
fn build_tables(rows: [KeyRow]) -> Tables TableError! {
    singles := [U8]{}
    contractions := [U8]{}
    elements := [U8]{}
    single_count := 0
    contraction_count := 0
    element_count := 0
    previous := -1
    loop row in sorted_rows(rows) {
        if row.rank == previous -> return Err(fail("duplicate key {row.scalars}"))
        previous = row.rank
        count :: row.elements.len() /% 3
        if count > 255 -> return Err(fail("key {row.scalars} has {count} elements"))
        if {
            row.scalars.len() == 1 -> {
                push_le(&singles, row.scalars[0], 3)
                push_le(&singles, element_count, 3)
                push_le(&singles, count, 1)
                single_count += 1
            }
            else -> {
                loop at in 0..<3 -> push_le(&contractions, if at < row.scalars.len() -> row.scalars[at] else -> ABSENT, 3)
                push_le(&contractions, element_count, 3)
                push_le(&contractions, count, 1)
                contraction_count += 1
            }
        }
        loop at in 0..<count {
            push_le(&elements, row.elements[at * 3], 2)
            push_le(&elements, row.elements[at * 3 + 1], 2)
            push_le(&elements, row.elements[at * 3 + 2], 1)
        }
        element_count += count
    }
    if element_count >= ABSENT -> return Err(fail("{element_count} elements overflow a 3-byte index"))
    Ok(Tables{singles: singles, single_count: single_count, contractions: contractions, contraction_count: contraction_count, elements: elements, element_count: element_count})
}

fn byte_literal(bytes: [U8]) -> String {
    digits :: HEX_DIGITS.bytes()
    out := [U8]{}
    loop byte in bytes {
        value :: Int.from_u8(byte)
        &out.push(U8{92})
        &out.push(U8{120})
        &out.push(digits[value >> 4])
        &out.push(digits[value.bit_and(Int{15})])
    }
    String.from_bytes_lossy(out)
}

// A JUCD schema-1 asset (Core/Text/Runtime/UnicodeAssets.jet `valid`): the
// 40-byte header, then `count` records of `stride` bytes, then the pool.
fn jucd(kind: Int, count: Int, stride: Int, records: [U8], pool: [U8]) -> [U8] {
    out := [U8]{}
    loop byte in "JUCD".bytes() -> &out.push(byte)
    push_le(&out, 1, 2)
    push_le(&out, 0, 2)
    push_le(&out, 17, 3)
    push_le(&out, 0, 1)
    pool_offset :: 40 + records.len()
    header :: [Int]{kind, count, stride, 40, pool_offset, pool.len(), pool_offset + pool.len()}
    loop value in header -> push_le(&out, value, 4)
    loop byte in records -> &out.push(byte)
    loop byte in pool -> &out.push(byte)
    out
}

// Unified_Ideograph (first, last) pairs as kind-2 range rows, sorted by first.
fn ideograph_rows(ranges: [Int]) -> [U8] {
    starts := [Int]{}
    loop at in 0..<ranges.len() /% 2 -> &starts.push(at)
    &starts.sort_by((at: Int) -> ranges[at * 2])
    out := [U8]{}
    loop at in starts {
        push_le(&out, ranges[at * 2], 3)
        push_le(&out, ranges[at * 2 + 1], 3)
    }
    out
}

fn render(tables: Tables, ideographs: [Int], allkeys_sha: String) -> String {
    range_count :: ideographs.len() /% 2
    lines := [String]{
        "// GENERATED FILE — do not hand-edit.",
        "// Source: Tools/agent/CollationTable.jet against the vendored CLDR 48 root",
        "// table tests/data/unicode/uca/allkeys_CLDR.txt (UCA 17.0.0, sha256 {allkeys_sha})",
        "// and the Unified_Ideograph ranges of tests/data/unicode/ucd/PropList.txt.",
        "// Regenerate: jet Tools/agent/CollationTable.jet",
        "// Compiler-private data part of core.text, read only by text.collate and",
        "// text.collation_key. JUCD schema 1, Unicode 17.0.0, little-endian.",
        "",
        "// Kind 9: {tables.single_count} single-scalar keys, 7 bytes each, sorted by scalar:",
        "// [scalar:3, first element:3, element count:1]. The pool holds the",
        "// {tables.element_count} collation elements of every key, 5 bytes each:",
        "// [primary:2, secondary:2, tertiary:1].",
        "COLLATION_ELEMENTS :: [U8]{{\"{byte_literal(jucd(9, tables.single_count, 7, tables.singles, tables.elements))}\"}}",
        "",
        "// Kind 10: {tables.contraction_count} contraction keys, 13 bytes each, sorted by scalars:",
        "// [scalar:3, scalar:3, scalar:3 ({ABSENT} past the key's end), first element:3,",
        "// element count:1]. Element indexes point into COLLATION_ELEMENTS' pool.",
        "COLLATION_CONTRACTIONS :: [U8]{{\"{byte_literal(jucd(10, tables.contraction_count, 13, tables.contractions, [U8]{}))}\"}}",
        "",
        "// Kind 2: {range_count} Unified_Ideograph ranges [first:3, last:3], for implicit weights.",
        "COLLATION_UNIFIED_IDEOGRAPHS :: [U8]{{\"{byte_literal(jucd(2, range_count, 6, ideograph_rows(ideographs), [U8]{}))}\"}}",
        "",
    }
    lines.join("\n")
}

// The digest SHA256SUMS records for `name`, or an error naming the gap.
fn pinned_digest(sums: String, name: String) -> String TableError! {
    loop raw in sums.split("\n") {
        fields :: raw.partition("  ")
        if fields.sep != "" && fields.tail.trim() == name -> return Ok(fields.head.trim())
    }
    Err(fail("{SUMS_PATH} does not pin {name}"))
}

fn read_pinned(path: String, sums: String) -[FS]> String TableError! {
    bytes :: files.read_bytes(path) ?? return Err(fail("cannot read {path}: {err}"))
    expected :: pinned_digest(sums, path.partition("tests/data/unicode/").tail)
    actual :: crypto.sha256(bytes).hex()
    if actual != expected -> return Err(fail("{path} sha256 {actual}, SHA256SUMS pins {expected}"))
    String.from_bytes(bytes) ?? return Err(fail("{path} is not UTF-8"))
}

fn generated_text() -[FS]> String TableError! {
    sums :: files.read(SUMS_PATH) ?? return Err(fail("cannot read {SUMS_PATH}: {err}"))
    allkeys :: read_pinned(ALLKEYS_PATH, sums)
    proplist :: read_pinned(PROPLIST_PATH, sums)
    tables :: build_tables(parse_allkeys(allkeys))
    Ok(render(tables, parse_unified_ideographs(proplist), pinned_digest(sums, "uca/allkeys_CLDR.txt")))
}

fn table_main(args: [String]) -[FS]> String TableError! {
    check :: args.len() == 1 && args[0] == "--check"
    if args.len() > 1 || (args.len() == 1 && !check) -> return Err(fail("usage: CollationTable.jet [--check]"))
    text :: generated_text()
    if check {
        current :: files.read(TARGET_PATH) ?? return Err(fail("cannot read {TARGET_PATH}: {err}"))
        if current != text -> return Err(fail("{TARGET_PATH} is stale; run jet Tools/agent/CollationTable.jet"))
        return Ok("collation-table: {TARGET_PATH} is current")
    }
    files.write(TARGET_PATH, text) ?? return Err(fail("cannot write {TARGET_PATH}: {err}"))
    Ok("collation-table: wrote {TARGET_PATH}")
}

fn run() {
    if table_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

#Test("allkeys rows parse into scalars and weight triples") {
    rows :: parse_allkeys("@version 17.0.0\n0061 ; [.2075.0020.0002] # a\n006C 00B7 ; [.2528.0020.0002][.0000.011F.0002]\n") ?? panic(err.message)
    assert_eq(rows.len(), 2)
    assert_eq(rows[1].scalars, [Int]{108, 183})
    assert_eq(rows[1].elements, [Int]{9512, 32, 2, 0, 287, 2})
    assert_eq(hex_value("FFFE") ?? -1, 65534)
}

#Test("the checked-in table matches the vendored inputs") {
    assert_eq(table_main([String]{"--check"}) ?? err.message, "collation-table: {TARGET_PATH} is current")
}
