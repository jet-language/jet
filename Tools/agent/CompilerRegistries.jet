#!/usr/bin/env jet
// The compiler-owned registry census and runner. No oracle, selection filter,
// skip or Rust emission.
// Usage (from the repository root):
//   jet Tools/agent/CompilerRegistries.jet manifest SHA [--out DIR]
//       write DIR/manifest.json (and print it): every registry under
//       Compiler/*/Tests, the testkit cases entry and the retired rows, all
//       bound to the pinned source of SHA
//   jet Tools/agent/CompilerRegistries.jet run --jet JET --manifest JSON [--runtime DIR] [--receipt JSON] [--shard I/N]
//       execute every listed entry (or the one-based shard I of N) and write
//       the receipt (default JSON.receipt.json); exit 0 only when all PASS
// Both run on an immutable export: from a checkout without a sibling
// ../source.manifest.json, SHA is exported through Tools/agent/ProofSource.jet
// and the export's copy of this script runs instead. BLOCKED entries stay in
// the manifest and fail the receipt. Support files and non-registry test
// inputs stay visible in the inventory, never counted as executed registries.
// A package registry runs in place inside its Tests package; a JetRuntime Test
// registry runs as an assembled standalone file; the native runtime and
// backend registries run through their transports, which assemble each
// fixture with Compiler/Toolchain/RuntimePack.jet, lower it through the
// candidate jet, link its C host and check the real native verdict.
use {
    base64: core.encoding.base64
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    regex: core.regex
    sys: core.sys
    term: core.term
    time: core.time
}

USAGE: "usage: jet Tools/agent/CompilerRegistries.jet manifest SHA [--out DIR] | run --jet JET --manifest JSON [--runtime DIR] [--receipt JSON] [--shard I/N]"
TOOL: "/Tools/agent/CompilerRegistries.jet"
FLAGS: [String]{"--jet", "--manifest", "--receipt", "--out", "--runtime", "--shard"}
SOURCE_LIST: "Compiler/JetRuntime/sources.list"
RETIRED: "Compiler/JetTestKit/retired-with-rust.tsv"
// The testkit cases entry: `jet test Compiler --profile registries`, every
// case including the opt-in ones, its verdicts in JET_CI_EVIDENCE_DIR.
KIT_PACKAGE: "Compiler"
KIT_PROFILE: "registries"
RT: "Compiler/JetRuntime/Tests/"
BE: "Compiler/JetBackend/Tests/"
// The tool a plain or C transport assembles its runtime unit with, run on
// the Compiler package.
RUNTIME_UNIT_TOOL: "Compiler/Toolchain/RuntimePack.jet"
// The runtime-pack-roots-NAME.s inputs of the Link fixtures.
PACK_ROOTS_INPUTS: [String]{"object", "archive", "consumer", "missing"}
TEST_SCHEMA: "jet.test.v1"
REGISTRY_TIMEOUT_MS: 3500000
TRANSPORT_TIMEOUT_MS: 600000
REGISTRY_PACKAGE: "name: \"compiler_registry\"\nversion: \"0.0.1\"\nedition: \"2026\"\n"
// The C host of a plain transport: it registers the process arguments a stop
// reports, attaches the main thread and runs the fragment's exported entry.
PLAIN_DRIVER: "#include <stdint.h>\nextern char **environ;\nextern void jet_rt_host_arguments(int64_t,char **,char **);\nextern void jet_rt_thread_attach(void),jet_rt_thread_detach(void);\nextern void jet_rt_plain_fixture(void);\nint main(int argc,char **argv) {{ jet_rt_host_arguments(argc,argv,environ); jet_rt_thread_attach(); jet_rt_plain_fixture(); jet_rt_thread_detach(); return 0; }}\n"
// The ICU root primary order of the ASCII names a repository holds: the order
// the inventory walk lists directory entries in.
ROOT_PRIMARY_ORDER: " _-,;:!?.'\"()[]{{}}@*/\\&#%`^+<=>|~$0123456789abcdefghijklmnopqrstuvwxyz"
CRYPTO: [String]{"AgeCodec", "AgeV1", "CryptoAead", "CryptoChaCha", "CryptoEd25519", "CryptoEd25519Signature", "CryptoEntropy", "CryptoHash", "CryptoHkdf", "CryptoOsEntropy", "CryptoWipe", "CryptoX25519", "Sha256"}
// The crypto witnesses whose committed stdout files pin a sha256 in their
// fixtures JSON, and the counts the World entropy provider must refuse
// before any provider call.
CRYPTO_FROZEN: [String]{"CryptoEd25519Signature", "CryptoEntropy", "CryptoHash", "CryptoOsEntropy", "CryptoWipe"}
WORLD_ENTROPY_COUNTS: [String]{"0", "-1", "1048577", "7"}
// The process witnesses and the flags their C hosts compile with.
PROCESS_WITNESSES: [String]{"ProcessExecution", "TerminalProcess"}
FREESTANDING_CFLAGS: [String]{"-std=c11", "-O1", "-fno-stack-protector", "-fno-PIE", "-no-pie", "-fno-builtin", "-Wall", "-Wextra", "-Werror"}
C_FIXTURES: [String]{"EnvironmentLeaves", "FaultSchedule", "IterCharge", "ProgressState", "HostFault", "HostRestart", "FloatBits", "TerminalColor", "TrapReport", "VaultHooks", "VaultProvider", "Thread", "HostSpawn", "CompilerEnv", "CompilerRoutes", "CompilerNeededJSON", "CompilerNeededURL", "CompilerNeededMathText", "DynNative"}
// The fragments the world/sentry C host drives, composed into one unit in
// this order, and the C hosts that link against the same object.
WORLD_SENTRY: [String]{"World", "Sentry", "TestScope", "AllocationPolicy"}
WORLD_SENTRY_LINKED: [String]{"LogicalEnvironmentTests", "LinkNativeTests"}
// The strict C flags of a committed C host; the channel host keeps the
// internal fixture exports and the optimizer its races were measured under.
STRICT_CFLAGS: [String]{"-std=c11", "-Wall", "-Wextra", "-Werror"}
// The Shared weak host links against the Shared publication object.
PUBLICATION_LINKED: "shared-weak-fixture"
WEAK_EXPECTED: "Shared weak no resurrection/payload once/last weak frees Cell96 ok\nShared weak upgrade versus final strong drop 256 races ok\nShared physical clean/dirty/abort/resume/alias once/logical versus pin lifetime ok\n"
// The lines the channel host prints, one per witness, in any order.
CHANNEL_LINES: [String]{"queue/close/owners ok", "select source-order/probe/timers ok", "shared concurrent edits/drop ok", "select wake handoff parity ok", "reservations/stopped output/permit cleanup ok", "shared concurrent readers/writer priority ok", "shared guards concurrent readers/writer exclusion/priority ok", "shared guard retain/drop/read-only commit/overflow stop ok"}

#Error
Problem: struct {
    message: String
    impl Display {
        display: fn(self) -> String { self.message.copy() }
    }
    impl Debug {
        debug: fn(&&self) -> String Never! { self.message.copy() }
    }
}

problem: fn(message: String) -> Problem Never! { Problem{message: message} }

Options: struct {
    command: String
    head: String
    jet: String
    manifest: String
    receipt: String
    out: String
    runtime: String
    shard: String
}

Setting: struct {
    name: String
    value: String
}

// One inventory row: a file under Compiler/<package>/Tests.
Census: struct {
    package: String
    source: String
    sha256: String
    names: [String]
    entry: Bool
    role: String
}

// One registry to account for: a census row and its id and mode.
Registry: struct {
    row: Census
    id: String
    mode: String
}

Retirement: struct {
    path: String
    reason: String
    sha256: String?
}

Kit: struct {
    sources: [String]
    tree: Dyn
    cases: [String]
    retired_cases: [Dyn]
    pending: Int
    rust_tools: Int
}

// How a native registry is driven: the runner under Compiler/*/Tests and the
// verdict that admits it. `blocked` names a registry without a transport.
// `fragments` names the fragments a plain transport's unit composes and
// `cflags` the flags its C host compiles with; `calls` the runs of a
// committed Jet runner.
Spec: struct {
    kind: String
    name: String
    runner: String
    call: String?
    expected: String
    witness: String
    expected_file: String
    blocked: String
    fragments: [String]
    cflags: [String]
    calls: [RunnerCall]
}

// One run of a committed Jet runner and its exact stdout (stderr stays
// empty). `witness` is the C host the transport links against the runtime
// object and hands over; without one the runner links its own fixture against
// the link inputs. `mode` is the operand that selects the run, if any.
RunnerCall: struct {
    mode: String
    witness: String
    expected: String
}

Runtime: struct {
    dir: String
    pack: String
    object: String
    pack_sha256: String
    object_sha256: String
}

// One transport run: its staged toolchain and the evidence of every command.
Lane: struct {
    id: String
    out: String
    repo: String
    log_dir: String
    jet: String
    runtime_dir: String
    pack: String
    object: String
    evidence: [Dyn]
}

Ran: struct {
    code: Int
    signal: Int?
    timed_out: Bool
    stdout: String
    stderr: String
}

run: fn() {
    args: process.args()
    repo: repo_root()
    options: parse_options(args)
    head: if options.command == "manifest" -> options.head.copy() else -> manifest_head(options.manifest)
    use_pinned_source(repo, head, args)
    if options.command == "manifest" -> return generate(repo, options)
    if options.command == "run" -> return run_registries(repo, options)
    fail(USAGE)
}

fail: fn(message: String) -[Exec, IO]> Never {
    term.eprint("compiler registries: {message}")
    process.exit(1)
}

env_or: fn(name: String, fallback: String) -[Env]> String Never! {
    value: process.env_get(name) ?? return fallback.copy()
    if value == "" -> return fallback.copy()
    value
}

jet_cli: fn() -[Env]> String Never! { env_or("JET", "jet") }

// The shared scratch root of Tools/agent/roots.sh.
scratch_root: fn() -[Env]> String Never! {
    cache: env_or("XDG_CACHE_HOME", "{env_or("HOME", "")}/.cache")
    env_or("JET_SCRATCH_ROOT", env_or("JET_STATE_ROOT", "{cache}/jet-dev"))
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, Exec, FS, IO]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? "/"
    loop {
        if files.exists("{dir}/Tools/agent/ProofSource.jet") -> return dir
        if dir == "/" || dir == "" -> return fail("run from inside the Jet checkout")
        dir = files.dirname(dir)
    }
}

absolute: fn(path: String) -[Env, Exec, FS, IO]> String Never! {
    files.absolute(path) ?? fail("`{path}` cannot be resolved: {err}")
}

parse_options: fn(args: [String]) -[Env, Exec, FS, IO]> Options Never! {
    options := Options{command: "", head: "", jet: "", manifest: "", receipt: "", out: "", runtime: "", shard: ""}
    if args.len() == 0 -> return fail(USAGE)
    options.command = args[0].copy()
    at := 1
    if options.command == "manifest" && args.len() > 1 {
        options.head = args[1].copy()
        at = 2
    }
    loop at < args.len() {
        name: args[at]
        value: if at + 1 < args.len() -> args[at + 1].copy() else -> ""
        if !FLAGS.contains(name) || value == "" -> return fail(USAGE)
        if name == "--shard" && options.command != "run" -> return fail(USAGE)
        if name == "--shard" {
            options.shard = value
        } else {
            resolved: absolute(value)
            if name == "--jet" -> options.jet = resolved
            if name == "--manifest" -> options.manifest = resolved
            if name == "--receipt" -> options.receipt = resolved
            if name == "--out" -> options.out = resolved
            if name == "--runtime" -> options.runtime = resolved
        }
        at += 2
    }
    if options.command == "run" && options.jet == "" {
        jet: env_or("JET", "")
        if jet != "" -> options.jet = absolute(jet)
    }
    options
}

manifest_head: fn(path: String) -[Env, Exec, FS, IO]> String Never! {
    if path == "" -> return ""
    text: files.read(path) ?? return fail("`{path}` cannot be read: {err}")
    tree: json.parse(text) ?? return fail("`{path}` is not JSON: {err}")
    text_field(tree, "head")
}

is_full_sha: fn(text: String) -> Bool Never! {
    text.len() == 40 && text.bytes().all(byte -> (byte >= U8{48} && byte <= U8{57}) || (byte >= U8{97} && byte <= U8{102}))
}

proof_path: fn(repo: String) -> String Never! { "{files.dirname(repo)}/source.manifest.json" }

// SOURCE's pinned commit, once Tools/agent/ProofSource.jet confirms it still
// holds the bytes its sibling source.manifest.json records.
pinned: fn(source: String, head: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String Problem! {
    ran: process.cmd([String]{jet_cli(), "{source}/Tools/agent/ProofSource.jet", "check", source, head}).cwd(source).run() ?? return Err(problem("the proof source check cannot start: {err}"))
    if ran.code != 0 || ran.signal != None {
        reason: ran.errors.trim()
        return Err(problem(if reason != "" -> reason.copy() else -> "proof source check failed for {source}"))
    }
    ran.output.trim().copy()
}

current_head: fn(repo: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String Problem! {
    path: proof_path(repo)
    text: files.read(path) ?? return Err(problem("`{path}` cannot be read: {err}"))
    tree: json.parse(text) ?? return Err(problem("`{path}` is not JSON: {err}"))
    pinned(repo, text_field(tree, "commit")) ?? return Err(err)
}

use_pinned_source: fn(repo: String, head: String, args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> () {
    if !is_full_sha(head) -> return fail("registry source requires a full committed SHA")
    if files.exists(proof_path(repo)) {
        pinned(repo, head) ?? return fail(err.message)
        return
    }
    exported: process.cmd([String]{jet_cli(), "{repo}/Tools/agent/ProofSource.jet", head, repo}).cwd(repo).output_limit(8388608).run() ?? return fail("the source export cannot start: {err}")
    if exported.code != 0 || exported.signal != None -> return fail("the source export of {head} failed: {exported.errors.trim()}")
    source: exported.output.trim().copy()
    pinned(source, head) ?? return fail(err.message)
    argv := [String]{jet_cli(), "{source}{TOOL}"}
    loop arg in args -> argv.push(arg.copy())
    child: process.cmd(argv).cwd(source).stdout(.Inherit).stderr(.Inherit).run() ?? return fail("the pinned copy cannot start: {err}")
    process.exit(if child.signal != None -> 1 else -> child.code)
}

// --- inventory ---------------------------------------------------------------

primary_rank: fn(scalar: String) -> Int Never! {
    folded: scalar.lower()
    at: ROOT_PRIMARY_ORDER.find(folded)
    if at >= 0 && folded.count_bytes() == 1 -> return at
    rank := 0
    loop byte in folded.bytes() -> rank = rank * 256 + Int.from_u8(byte)
    ROOT_PRIMARY_ORDER.count_bytes() + rank
}

primary_ranks: fn(name: String) -> [Int] Never! {
    ranks := [Int]{}
    loop scalar in name.chars() -> ranks.push(primary_rank("{scalar}"))
    ranks
}

// Primary rank first; on a tie lowercase sorts before uppercase.
collate: fn(left: String, right: String) -> Ordering Never! {
    primary: primary_ranks(left) <=> primary_ranks(right)
    if primary != .Equal -> return primary
    right <=> left
}

// The files ending in `extension` under `directory` (repository-relative),
// in collation order; package.jet is a manifest, never a member.
files_under: fn(repo: String, directory: String, extension: String) -[Env, Exec, FS, IO]> [String] Never! {
    listed := files.list_dir("{repo}/{directory}") ?? return fail("`{directory}` cannot be listed: {err}")
    listed.sort_by((left: DirEntry, right: DirEntry) -> collate(left.name, right.name))
    out := [String]{}
    loop entry in listed {
        path: "{directory}/{entry.name}"
        meta: files.stat("{repo}/{path}") ?? return fail("`{path}` cannot be read: {err}")
        if meta.is_symlink -> return fail("registry inventory must not follow symlinks: {repo}/{path}")
        if meta.is_dir {
            loop nested in files_under(repo, path, extension) -> out.push(nested)
        } else if entry.name.ends_with(extension) && entry.name != "package.jet" {
            out.push(path)
        }
    }
    out
}

blank_bytes: fn(out: &[U8], raw: [U8], start: Int, end: Int) Never! {
    stop: if end < raw.len() -> end else -> raw.len()
    loop at in start..<stop -> out.push(if raw[at] == (U8{10}) -> U8{10} else -> U8{32})
}

starts_at: fn(raw: [U8], at: Int, word: String) -> Bool Never! {
    needle: word.bytes()
    if at + needle.len() > raw.len() -> return false
    loop k in 0..<needle.len() {
        if raw[at + k] != needle[k] -> return false
    }
    true
}

index_of: fn(raw: [U8], word: String, from: Int) -> Int Never! {
    at := from
    loop at < raw.len() {
        if starts_at(raw, at, word) -> return at
        at += 1
    }
    -1
}

// Comments and literals blanked without moving offsets: a Test inside a
// parser input string is not a registry member. Jet nests block comments and
// has backtick literals and triple-quoted bodies.
code_mask: fn(raw: [U8]) -> [U8] Never! {
    out := [U8]{}
    i := 0
    n: raw.len()
    loop i < n {
        start: i
        b: raw[i]
        if starts_at(raw, i, "//") {
            loop i < n && raw[i] != (U8{10}) -> i += 1
            blank_bytes(out, raw, start, i)
        } else if starts_at(raw, i, "/*") {
            i += 2
            depth := 1
            loop i < n && depth > 0 {
                if starts_at(raw, i, "/*") {
                    depth += 1
                    i += 2
                } else if starts_at(raw, i, "*/") {
                    depth -= 1
                    i += 2
                } else {
                    i += 1
                }
            }
            blank_bytes(out, raw, start, i)
        } else if starts_at(raw, i, "\"\"\"") {
            end: index_of(raw, "\"\"\"", i + 3)
            i = if end < 0 -> n else -> end + 3
            blank_bytes(out, raw, start, i)
        } else if b == (U8{34}) || b == (U8{96}) || b == (U8{39}) {
            i += 1
            loop i < n {
                if raw[i] == (U8{92}) && b != (U8{96}) {
                    i += 2
                    next
                }
                closing: raw[i] == b
                i += 1
                if closing -> break
            }
            blank_bytes(out, raw, start, i)
        } else {
            out.push(b)
            i += 1
        }
    }
    out
}

is_space: fn(b: U8) -> Bool Never! { b == (U8{32}) || b == (U8{9}) || b == (U8{10}) || b == (U8{13}) || b == (U8{11}) || b == (U8{12}) }

skip_space: fn(raw: [U8], from: Int) -> Int Never! {
    at := from
    loop at < raw.len() && is_space(raw[at]) -> at += 1
    at
}

// The exact literal names of the `#Test(...)` declarations of `text`.
tests_in: fn(text: String) -> [String] Problem! {
    raw: text.bytes()
    masked: code_mask(raw)
    names := [String]{}
    at := 0
    loop {
        found: index_of(masked, "#Test", at)
        if found < 0 -> break
        at = found + 5
        open: skip_space(masked, at)
        if open >= masked.len() || masked[open] != (U8{40}) -> next
        quote: skip_space(raw, open + 1)
        if quote >= raw.len() || raw[quote] != (U8{34}) -> return Err(problem("registry Test must have an exact literal name"))
        end := quote + 1
        closed := false
        loop end < raw.len() {
            if raw[end] == (U8{92}) {
                end += 2
                next
            }
            if raw[end] == (U8{34}) {
                closed = true
                break
            }
            end += 1
        }
        if !closed -> return Err(problem("registry Test must have an exact literal name"))
        literal: String.from_bytes(raw.slice(quote, end + 1)) ?? return Err(problem("registry Test must have an exact literal name"))
        parsed: json.parse(literal) ?? return Err(problem("registry Test name {literal} is not a JSON string literal: {err}"))
        if parsed == .Text(name) -> names.push(name.copy()) else -> return Err(problem("registry Test must have an exact literal name"))
    }
    names
}

Patterns: struct {
    entry: Regex
    abi: Regex
    nested: Regex
}

patterns: fn() -[Exec, IO]> Patterns Never! {
    Patterns{
        entry: regex.compile_with("^run:\\s*fn\\s*\\(", regex.flags(false, true, false)) ?? fail("entry pattern: {err}"),
        abi: regex.compile_with("\\bfn\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\(|^\\s*(?:#[A-Za-z]+(?:\\([^)\\n]*\\))?\\s+)*(?:pub\\s+)?[A-Za-z_][A-Za-z0-9_.]*:\\s*fn\\s*[(<]", regex.flags(false, true, false)) ?? fail("ABI pattern: {err}"),
        nested: regex.compile("/Tests/(?:[A-Za-z0-9]+\\.fixture/)?(?:fixtures|Fixtures)/") ?? fail("fixture pattern: {err}"),
    }
}

sha256_file: fn(repo: String, path: String) -[Env, Exec, FS, IO]> String Never! {
    crypto.sha256(files.read_bytes("{repo}/{path}") ?? return fail("`{path}` cannot be read: {err}")).hex()
}

inventory: fn(repo: String) -[Env, Exec, FS, IO]> [Census] Never! {
    found := [Census]{}
    shapes: patterns()
    packages := files.list_dir("{repo}/Compiler") ?? return fail("Compiler cannot be listed: {err}")
    packages.sort_by((left: DirEntry, right: DirEntry) -> collate(left.name, right.name))
    loop item in packages {
        if !item.is_dir || !files.is_dir("{repo}/Compiler/{item.name}/Tests") -> next
        loop source in files_under(repo, "Compiler/{item.name}/Tests", ".jet") {
            text: files.read("{repo}/{source}") ?? return fail("`{source}` cannot be read: {err}")
            masked: String.from_bytes(code_mask(text.bytes())) ?? return fail("`{source}` masks to invalid UTF-8")
            names: tests_in(text) ?? return fail(err.message)
            entry: shapes.entry.is_match(masked)
            abi_registry: source.ends_with("Tests.jet") && shapes.abi.is_match(masked)
            nested_input: shapes.nested.is_match(source)
            role: if !nested_input && (names.len() > 0 || entry || abi_registry) -> "registry" else -> "support-or-fixture"
            found.push(Census{package: item.name.copy(), source: source, sha256: crypto.sha256(text.bytes()).hex(), names: names, entry: entry, role: role})
        }
    }
    found
}

census_dyn: fn(rows: [Census]) -> Dyn Never! {
    Dyn.Array(rows.map(row -> Dyn.Object([String: Dyn]{
        "package": Dyn.Text(row.package.copy()),
        "source": Dyn.Text(row.source.copy()),
        "sha256": Dyn.Text(row.sha256.copy()),
        "names": texts(row.names),
        "entry": Dyn.Bool(row.entry),
        "role": Dyn.Text(row.role.copy()),
    })))
}

texts: fn(items: [String]) -> Dyn Never! { Dyn.Array(items.map(item -> Dyn.Text(item.copy()))) }

retirements: fn(repo: String) -[Env, Exec, FS, IO]> [Retirement] Never! {
    text: files.read("{repo}/{RETIRED}") ?? return fail("`{RETIRED}` cannot be read: {err}")
    rows := [Retirement]{}
    loop line in text.split("\n") {
        if line.trim() == "" || line.starts_with("#") -> next
        cells: line.split("\t").to_list()
        if cells.len() != 2 || cells[0] == "" || cells[1] == "" -> return fail("retired rows need an exact source ID and reason")
        path: cells[0].copy()
        sha: if files.exists("{repo}/{path}") -> Val(sha256_file(repo, path)) else -> None
        rows.push(Retirement{path: path, reason: cells[1].copy(), sha256: sha})
    }
    rows
}

retirement_dyn: fn(row: Retirement, status: String) -> Dyn Never! {
    entries := [String: Dyn]{"path": Dyn.Text(row.path.copy()), "reason": Dyn.Text(row.reason.copy())}
    if row.sha256 == .Val(sha) -> entries["sha256"] = Dyn.Text(sha.copy())
    if status != "" -> entries["status"] = Dyn.Text(status.copy())
    Dyn.Object(entries.copy())
}

registry_rows: fn(repo: String, census: [Census]) -[Env, Exec, FS, IO]> [Registry] Never! {
    retired: retirements(repo).map(row -> row.path.copy())
    rows := [Registry]{}
    loop row in census {
        if row.role != "registry" || retired.contains(row.source) -> next
        id: row.source.removeprefix("Compiler/").removesuffix(".jet")
        rows.push(Registry{row: row.copy(), id: id.copy(), mode: if row.names.len() > 0 -> "test" else -> "run"})
        if row.names.len() > 0 && row.entry -> rows.push(Registry{row: row.copy(), id: "{id}.run", mode: "run"})
    }
    rows
}

// The testkit cases entry's inputs: the Compiler manifest that declares its
// `registries` profile and the retirement table; the corpus engine is part of
// the jet under test.
testkit_inventory: fn(repo: String) -[Env, Exec, FS, IO]> Kit Never! {
    sources := [String]{"{KIT_PACKAGE}/package.jet"}
    sources.push(RETIRED)
    table: retirements(repo)
    retired := [Dyn]{}
    pending := [Dyn]{}
    retired_ids := [String]{}
    loop row in table {
        if !row.path.starts_with("tests/cases/") -> next
        if row.reason.starts_with("Retired with Rust:") {
            retired.push(retirement_dyn(row, ""))
            retired_ids.push(row.path.copy())
        }
        if row.reason.starts_with("PRODUCT INTEROP RED:") -> pending.push(retirement_dyn(row, "RED"))
    }
    cases: files_under(repo, "tests/cases", ".case").filter(path -> !retired_ids.contains(path))
    requirement: regex.compile("^(?:requires: tool:|when tool |step(?: [^:]+)?: )") ?? return fail("requirement pattern: {err}")
    rust: regex.compile("\\b(?:cargo|rustc|rustup)\\b") ?? return fail("Rust tool pattern: {err}")
    requirements := [Dyn]{}
    case_rows := [Dyn]{}
    loop path in cases {
        bytes: files.read_bytes("{repo}/{path}") ?? return fail("`{path}` cannot be read: {err}")
        case_rows.push(Dyn.Object([String: Dyn]{"path": Dyn.Text(path.copy()), "sha256": Dyn.Text(crypto.sha256(bytes).hex())}))
        text: String.from_bytes(bytes) ?? return fail("`{path}` is not UTF-8")
        number := 0
        loop line in text.split("\n") {
            number += 1
            if requirement.is_match(line) && rust.is_match(line) {
                requirements.push(Dyn.Object([String: Dyn]{"path": Dyn.Text(path.copy()), "line": Dyn.Int(number), "source": Dyn.Text(line.copy())}))
            }
        }
    }
    source_rows: sources.map(path -> Dyn.Object([String: Dyn]{"path": Dyn.Text(path.copy()), "sha256": Dyn.Text(sha256_file(repo, path))}))
    tree: Dyn.Object([String: Dyn]{
        "sources": Dyn.Array(source_rows),
        "cases": Dyn.Array(case_rows.copy()),
        "retiredCases": Dyn.Array(retired.copy()),
        "pendingProductInterop": Dyn.Array(pending.copy()),
        "rustToolRequirements": Dyn.Array(requirements.copy()),
    })
    Kit{sources: sources.copy(), tree: tree, cases: cases, retired_cases: retired.copy(), pending: pending.len(), rust_tools: requirements.len()}
}

// --- imports of an assembled standalone registry ----------------------------

// A `use { … }` block rewritten as one `use` line per row, keeping every line
// and byte offset: `use {` and its `}` turn to spaces and each row's last four
// columns of indentation become `use `. `pub use { … }` stays as written.
unblock_uses: fn(text: String) -> String Never! {
    lines := text.split("\n").to_list()
    indent := ""
    open := false
    depth := 0
    loop at in 0..<lines.len() {
        line: lines[at].copy()
        if !open {
            trimmed: line.trim_start()
            lead: line.removesuffix(trimmed)
            if lead.bytes().all(b -> is_space(b)) && trimmed.starts_with("use {{") && trimmed.removeprefix("use {{").trim() == "" {
                indent = lead.copy()
                open = true
                lines[at] = " ".repeat(line.len())
            }
            next
        }
        closer: "{indent}}}"
        if depth == 0 && line.trim_end() == closer {
            open = false
            lines[at] = " ".repeat(line.len())
            next
        }
        row: "{indent}    "
        if depth == 0 && line.starts_with(row) {
            rest: line.removeprefix(row)
            first: if rest.count_bytes() > 0 -> rest.bytes()[0] else -> U8{0}
            if (first >= (U8{65}) && first <= (U8{90})) || (first >= (U8{97}) && first <= (U8{122})) || first == (U8{95}) || first == (U8{34}) -> lines[at] = "{indent}use {rest}"
        }
        code: line.partition("//").head
        loop b in code.bytes() {
            if b == (U8{91}) -> depth += 1
            if b == (U8{93}) -> depth -= 1
        }
    }
    lines.join("\n")
}

blank_match: fn(found: Match) -> String Never! {
    out := [U8]{}
    blank_bytes(out, found.text.bytes(), 0, found.text.bytes().len())
    String.from_bytes(out) ?? ""
}

// Package imports blanked; a repeated single-line Core import blanked.
strip_imports: fn(text: String) -[Exec, IO]> String Never! {
    // `(?:\n|\z)`, not a multiline `$`: Core regex's `$` matches only at the end of the text.
    package_import: regex.compile_with("^use (?:jet_\\w+|compiler_bootstrap)\\.(?:\\[[^\\]]*\\]|[A-Za-z_][A-Za-z0-9_]*[ \\t]*(?:\\n|\\z))", regex.flags(false, true, false)) ?? return fail("import pattern: {err}")
    core_import: regex.compile("use (?:[A-Za-z_][A-Za-z0-9_]*: )?core\\.[^\\[\\n]*") ?? return fail("Core import pattern: {err}")
    blanked: package_import.replace_all_with(unblock_uses(text), blank_match)
    seen := [String]{}
    lines := [String]{}
    loop line in blanked.split("\n") {
        if core_import.full_match(line) {
            key: line.trim_end()
            if seen.contains(key) {
                lines.push(" ".repeat(line.len()))
                next
            }
            seen.push(key.copy())
        }
        lines.push(line.copy())
    }
    lines.join("\n")
}

// --- transports ---------------------------------------------------------------

spec: fn(kind: String, name: String, runner: String) -> Spec Never! {
    Spec{kind: kind, name: name, runner: runner, call: None, expected: "", witness: "", expected_file: "", blocked: "", fragments: [String]{}, cflags: STRICT_CFLAGS.copy(), calls: [RunnerCall]{}}
}

runner_call: fn(mode: String, witness: String, expected: String) -> RunnerCall Never! {
    RunnerCall{mode: mode, witness: if witness == "" -> "" else -> "{RT}{witness}.c", expected: "{expected}\n"}
}

// The fragments a plain transport's unit composes, in order: the Shared
// transaction, condition and observe witnesses build on the channel one, and
// every crypto witness links the one object all the crypto fragments compose.
plain_fragments: fn(name: String) -> [String] Never! {
    if WORLD_SENTRY.contains(name) -> return WORLD_SENTRY.copy()
    if CRYPTO.contains(name) -> return CRYPTO.copy()
    if name == {
        "SharedThread" -> [String]{"Thread", "SharedThread"}
        "Stm" -> [String]{"Channel", "Stm"}
        "Sync" -> [String]{"Channel", "Stm", "Sync"}
        "Observe" -> [String]{"Channel", "Stm", "Sync", "Observe"}
        "SharedPublication" -> [String]{"Channel", "SharedPublication"}
        "CollectionsStop" -> [String]{"Collections", "CollectionsStop"}
        else -> [String]{name.copy()}
    }
}

// The flags a plain transport's C host compiles with: the sync host selects
// its condition and observe witnesses by define, and the process and codec
// hosts build freestanding, the process ones with their Jet fixture hooks.
plain_cflags: fn(name: String) -> [String] Never! {
    flags := STRICT_CFLAGS.copy()
    if name == {
        "Channel" -> return [String]{"-O2", "-DJET_CHANNEL_INTERNAL"}
        "SharedThread" -> return [String]{"-DJET_SHARED_TLS_FIXTURE"}
        "CollectionsStop" -> return [String]{"-Wall", "-Wextra", "-Werror"}
        "ProcessExecution" | "TerminalProcess" -> {
            flags = FREESTANDING_CFLAGS.copy()
            flags.push("-DJET_PROCESS_JET_FIXTURES=1")
        }
        "CodecCSV" | "CodecEnv" | "DynCodec" | "CompilerFileLeaves" -> flags = FREESTANDING_CFLAGS.copy()
        "Sync" -> flags.push("-DJET_CONDITION_FIXTURE")
        "Observe" -> flags.extend([String]{"-DJET_CONDITION_FIXTURE", "-DJET_OBSERVE_FIXTURE"})
        else -> {}
    }
    flags
}

// The exact stdout of the sync host: its STM lines, then the condition and
// observe lines its defines select.
sync_expected: fn(name: String) -> String Never! {
    lines := [String]{
        "STM nested commit transfer/rollback/clone parity ok",
        "STM two-thread body gate serialization ok",
        "STM prepare rejection/no publication/drop/revision stop ok",
        "STM dropped uncommitted root releases second-thread gate ok",
    }
    if name != "Stm" -> lines.push("Condition FIFO/drain/pending/wait/cancel/unheld access+drop ok")
    if name == "Observe" -> lines.push("Observe empty/parked exact report/owned once ok")
    "{lines.join("\n")}\n"
}

// The collections stop host's exact stdout: every stopped-result family and
// every focused review edge restores the allocator's live payload total.
collections_stop_expected: fn() -> String Never! {
    out := ""
    loop family in 0..<13 -> out = "{out}family {family}: live payloads restored\n"
    loop edge in 0..<11 -> out = "{out}review {edge}: live payloads restored\n"
    out
}

// The collections stop unit instruments only the iterator source: its frees
// and its progress advances go through the fragment's wrappers, which
// delegate the real call once and then stop via the real budget rail.
collections_stop_unit: fn(unit: String) -> String Problem! {
    marker: "// [unit source: "
    segments := [String]{}
    instrumented := false
    loop segment in unit.split(marker) {
        if instrumented || !segment.starts_with("Compiler/JetRuntime/Source/Iter.jet]") {
            segments.push(segment.copy())
            next
        }
        loop call in ([String]{"jet_rt_free(", "jet_rt_progress_state_advance("}) {
            if !segment.contains(call) -> return Err(problem("the iterator source never calls `{call}`"))
        }
        segments.push(segment.replace("jet_rt_free(", "coll_stop_free(").replace("jet_rt_progress_state_advance(", "coll_stop_progress_advance("))
        instrumented = true
    }
    if !instrumented -> return Err(problem("the unit has no canonical iterator source boundary"))
    Ok(segments.join(marker))
}

// The committed Jet runners under Compiler/JetRuntime/Tests and their runs.
runner_calls: fn(name: String) -> [RunnerCall] Never! {
    if name == {
        "RunDuration" -> [RunnerCall]{runner_call("", "", "Jet-only Duration C ABI fixture passed")}
        "RunAllocParity" -> [RunnerCall]{runner_call("", "", "alloc parity: 10 checked-allocator cases passed")}
        "RunNativeLayout" -> [RunnerCall]{runner_call("", "", "Layout6: 12 draft literals exact; native/seed 42 observations + 3 fatal modes + ownership OK")}
        "RunNativeTextNormalize" -> [RunnerCall]{runner_call("", "", "NFC2 Unicode17 20034 rows / both routes / ownership OK")}
        "RunIntCabi" -> [RunnerCall]{runner_call("", "", "exact Int ABI: 9962 numeric/float cases + 6 stopped reports, clone/drop and concurrent hazard fixture; Jet-only provider")}
        "RunIntWiden" -> [RunnerCall]{runner_call("", "", "Jet-only exact Int widening C ABI fixture passed")}
        "RunExecutionFixtures" -> [RunnerCall]{runner_call("", "execution-fixture", "native execution witness: all cases passed")}
        "StopWitness" -> [RunnerCall]{
            runner_call("data-sequence", "DynWitness", "8 Dyn List/Entries std Vec bounds/capacity process goldens passed"),
            runner_call("scalar-reflect", "ScalarReflectWitness", "ScalarReflect bounds: exit 101, exact unsigned-index body and stdout flushed"),
        }
        "UiWitness" -> [RunnerCall]{
            runner_call("choices", "UiCarriersChoicesWitness", "UI choices: ownership and record-variant stop byte-identical"),
            runner_call("cursor", "UiCursorWitness", "UI canonical Cursor: real-provider ownership byte-identical"),
            runner_call("events", "UiEventsWitness", "UI events: real-provider ownership byte-identical"),
            runner_call("form-action-error", "UiFormActionErrorWitness", "UI ActionError: real consumed producers and transitive ownership byte-identical"),
            runner_call("key", "UiKeyWitness", "UI Key: exhaustive real-provider oracle and record-variant stop byte-identical"),
            runner_call("view-snapshots", "UiViewSnapshotsWitness", "UI view snapshots: real-provider ownership byte-identical"),
        }
        else -> [RunnerCall]{}
    }
}

specification: fn(id: String) -> Spec? Never! {
    if id.starts_with("JetRuntime/Tests/") {
        name: id.removeprefix("JetRuntime/Tests/").removesuffix("Tests")
        // A plain transport calls its entry from the generated driver, runs
        // the committed C host `witness` that drives the fragment, or for a
        // codec fixture generates the driver around its export.
        plain: if name == {
            "Alloc" -> Val((call: Val("alloc_tests"), witness: "", expected: "alloc tests: ok\n"))
            "Collections" -> Val((call: Val("collections_tests"), witness: "", expected: ""))
            "Scan" -> Val((call: Val("scan_tests"), witness: "", expected: ""))
            "Text" -> Val((call: Val("text_tests"), witness: "", expected: ""))
            "Unicode" -> Val((call: Val("unicode_tests"), witness: "", expected: ""))
            "Secret" -> Val((call: Val("secret_tests"), witness: "", expected: "secret tests: ok\n"))
            "FilesWalk" -> Val((call: Val("files_walk_tests"), witness: "", expected: ""))
            "HostParallelism" -> Val((call: Val("host_parallelism_tests"), witness: "", expected: ""))
            "TestSuite" -> Val((call: None, witness: "{RT}test-suite-fixture.c", expected: "test suite: ok\n"))
            "Parallel" -> Val((call: None, witness: "{RT}parallel-fixture.c", expected: ""))
            "Scheduler" -> Val((call: None, witness: "{RT}scheduler-fixture.c", expected: ""))
            "World" | "Sentry" | "TestScope" | "AllocationPolicy" -> Val((call: None, witness: "{RT}world-sentry-fixture.c", expected: ""))
            "Channel" -> Val((call: None, witness: "{RT}channel-fixture.c", expected: ""))
            "Stm" | "Sync" | "Observe" -> Val((call: None, witness: "{RT}sync-fixture.c", expected: sync_expected(name)))
            "SharedPublication" -> Val((call: None, witness: "{RT}shared-publication-fixture.c", expected: "Shared World race/loser once/register once/reset owner only ok\nShared Process race/loser once/no World registration ok\n"))
            "SharedThread" -> Val((call: None, witness: "{RT}thread-fixture.c", expected: ""))
            "CollectionsStop" -> Val((call: None, witness: "{RT}collections-stop.c", expected: collections_stop_expected()))
            "ProcessExecution" | "TerminalProcess" -> Val((call: None, witness: "{RT}{name}Witness.c", expected: ""))
            "CodecCSV" | "CodecEnv" | "DynCodec" | "CompilerFileLeaves" -> Val((call: None, witness: "", expected: ""))
            else -> if CRYPTO.contains(name) -> Val((call: None, witness: "{RT}{name}Witness.c", expected: "")) else -> None
        }
        if plain == .Val(table) {
            found := spec("plain", name, RUNTIME_UNIT_TOOL)
            found.call = table.call.copy()
            found.witness = table.witness.copy()
            found.expected = table.expected.copy()
            found.fragments = plain_fragments(name)
            found.cflags = plain_cflags(name)
            if PROCESS_WITNESSES.contains(name) || CRYPTO_FROZEN.contains(name) -> found.expected_file = "{RT}{name}Witness.stdout"
            return Val(found)
        }
        if C_FIXTURES.contains(name) -> return Val(spec("c", name, RUNTIME_UNIT_TOOL))
        calls: runner_calls(name)
        if calls.len() > 0 {
            found := spec("runner", name, "{RT}{name}.jet")
            found.calls = calls
            return Val(found)
        }
        found := spec("blocked", name, "")
        found.blocked = "No registered transport for {id}; the source must not be counted without an exact native verdict"
        return Val(found)
    }
    // A CLI behavior runner: `jet run RUNNER -- <jet> <scratch>` from the
    // repository root prints exactly its verdict.
    if id == "JetCli/Tests/RunKeep" {
        found := spec("cli", "RunKeep", "Compiler/JetCli/Tests/RunKeep.fixture/RunKeep.jet")
        found.expected = "run-keep: reuse, the background full build, source/Core/compiler rebuilds, stop parity and the 64-program cap: ok\n"
        return Val(found)
    }
    if id == "JetCli/Tests/RunEval" {
        found := spec("cli", "RunEval", "Compiler/JetCli/Tests/RunEval.fixture/RunEval.jet")
        found.expected = "run-eval: `jet -e` and `jet run -e` print, separate statements with `;`, rerun their entry file, refuse an undefined name before running and refuse a `-e` after the program or with `jet dev`: ok\n"
        return Val(found)
    }
    if id == "JetCli/Tests/RunCFfi" {
        found := spec("cli", "RunCFfi", "Compiler/JetCli/Tests/RunCFfi.jet")
        // The expected stream of the example it runs at both tiers.
        found.witness = "Examples/Interop/FFI/NativeC.out"
        found.expected = "native_c: native O0/O2 identical\n"
        return Val(found)
    }
    if !id.starts_with("JetBackend/Tests/") -> return None
    name: id.removeprefix("JetBackend/Tests/")
    if name == "LinkIndexes" -> return Val(spec("indices", "", "{BE}LinkIndexes.fixture/LinkIndexes.jet"))
    if name == "LinkPackRoots" -> return Val(spec("roots", "", "{BE}LinkPackRoots.fixture/LinkPackRoots.jet"))
    if name == "LinkRuntime" -> return Val(spec("link", "", "{BE}LinkRuntime.fixture/LinkRuntime.jet"))
    if name == "NativeInlineC" {
        found := spec("cli", name, "{BE}NativeInlineC.fixture/NativeInlineC.jet")
        // The program it builds twice, once with its shared definition removed.
        found.witness = "tests/fixtures/native_inline_c_shared_state.jet"
        found.expected = "native inline C shared state and whole-bridge refusal: passed\n"
        return Val(found)
    }
    None
}

// The manifest's view of a transport: exactly the fields its kind uses.
spec_dyn: fn(found: Spec, runner_sha256: String) -> Dyn Never! {
    entries := [String: Dyn]{"type": Dyn.Text(found.kind.copy())}
    if found.kind == "indices" || found.kind == "roots" || found.kind == "link" {
        entries["runner"] = Dyn.Text(found.runner.copy())
    } else {
        entries["name"] = Dyn.Text(found.name.copy())
        if found.kind == "plain" || found.kind == "cli" -> entries["expected"] = Dyn.Text(found.expected.copy())
        if found.kind == "plain" {
            entries["call"] = if found.call == .Val(call) -> Dyn.Text(call.copy()) else -> Dyn.Null
            entries["fragments"] = texts(found.fragments)
            entries["cflags"] = texts(found.cflags)
        }
        entries["runner"] = Dyn.Text(found.runner.copy())
        if found.witness != "" -> entries["witness"] = Dyn.Text(found.witness.copy())
        if found.expected_file != "" -> entries["expectedFile"] = Dyn.Text(found.expected_file.copy())
        if found.kind == "runner" {
            entries["calls"] = Dyn.Array(found.calls.map(call -> Dyn.Object([String: Dyn]{"mode": Dyn.Text(call.mode.copy()), "witness": Dyn.Text(call.witness.copy()), "expected": Dyn.Text(call.expected.copy())})))
        }
    }
    entries["runnerSha256"] = Dyn.Text(runner_sha256.copy())
    Dyn.Object(entries.copy())
}

// A registry fragment lives in its Tests package's fixture directory; its
// identity and C witness are named from the Tests package itself.
transport_home: fn(source: String) -[Exec, IO]> String Never! {
    fragment: regex.compile("/[A-Za-z0-9]+\\.fixture/") ?? return fail("fixture pattern: {err}")
    fragment.replace_first(source, "/")
}

// The transport a registry id names: its Tests package's file, without the
// fixture directory it lives in or the `.run` of an entry beside its Tests.
transport_key: fn(id: String) -[Exec, IO]> String Never! {
    transport_home("Compiler/{id}").removeprefix("Compiler/").removesuffix(".run")
}

// The manifest entry of a registry a transport drives; it keeps the
// registry's id, so the run accounts for exactly the censused registries.
prepare_transport: fn(repo: String, registry: Registry, out: String, adapter: String) -[Env, Exec, FS, IO]> Dyn? Never! {
    row: registry.row
    id: registry.id.copy()
    home: "Compiler/{transport_key(id)}"
    found: specification(transport_key(id)) ?? return None
    sources := [String]{row.source.copy()}
    if found.witness != "" -> sources.push(found.witness.copy())
    if found.expected_file != "" -> sources.push(found.expected_file.copy())
    if found.kind == "plain" && CRYPTO.contains(found.name) -> sources.extend(crypto_inputs(found.name))
    loop name in found.fragments {
        fragment: "{RT}Fragments.fixture/{name}Tests.jet"
        if !sources.contains(fragment) -> sources.push(fragment)
    }
    if found.fragments == WORLD_SENTRY {
        loop name in WORLD_SENTRY_LINKED -> sources.push("{RT}{name}.c")
    }
    if found.kind == "plain" && found.name == "SharedPublication" -> sources.push("{RT}{PUBLICATION_LINKED}.c")
    loop call in found.calls {
        if call.witness != "" && !sources.contains(call.witness) -> sources.push(call.witness.copy())
    }
    witness: "{home}.c"
    if found.kind == "c" && files.exists("{repo}/{witness}") -> sources.push(witness)
    if found.kind == "indices" || found.kind == "roots" || found.kind == "link" || found.kind == "cli" {
        sources.push("{files.dirname(found.runner)}/package.jet")
        if found.kind == "roots" || found.kind == "link" {
            loop name in PACK_ROOTS_INPUTS -> sources.push("{BE}LinkPackRoots.fixture/runtime-pack-roots-{name}.s")
        }
    }
    entry := [String: Dyn]{
        "id": Dyn.Text(id.copy()),
        "package": Dyn.Text(row.package.copy()),
        "mode": Dyn.Text("run"),
        "kind": Dyn.Text("transport"),
        "path": Dyn.Text(adapter.copy()),
        "cwd": Dyn.Text("{out}/{id}"),
        "sha256": Dyn.Text(crypto.sha256(files.read_bytes(adapter) ?? return fail("`{adapter}` cannot be read: {err}")).hex()),
        "testCount": Dyn.Int(1),
        "stdout": Dyn.Text("JET_COMPILER_REGISTRY PASS {id} tests=1\n"),
        "sources": texts(sources),
        "sourceManifests": texts([String]{SOURCE_LIST}),
    }
    if found.blocked != "" {
        entry["status"] = Dyn.Text("BLOCKED")
        entry["reason"] = Dyn.Text(found.blocked.copy())
    } else {
        entry["transport"] = spec_dyn(found, sha256_file(repo, found.runner))
    }
    Val(Dyn.Object(entry.copy()))
}

// The argument vectors the C driver of a `c` transport runs with.
driver_runs: fn(found: Spec, out: String) -> [[String]] Never! {
    if found.name == "CompilerEnv" -> return [[String]]{[String]{}, [String]{"empty"}}
    if found.name == "CompilerRoutes" -> return [[String]]{[String]{out.copy()}}
    [[String]]{[String]{}}
}

// The C export a codec or file-leaf fragment tests, or "" for any other name.
codec_export: fn(name: String) -> String Never! {
    if name == {
        "CodecCSV" -> "jet_rt_codec_csv_fixture"
        "CodecEnv" -> "jet_rt_codec_env_fixture"
        "DynCodec" -> "jet_rt_dyn_codec_fixture"
        "CompilerFileLeaves" -> "jet_rt_compiler_file_leaves_fixture"
        else -> ""
    }
}

// The generated C driver of a codec fixture: it runs the export as the body
// of jet_rt_main and exits with the runtime status, else the export's. The
// file-leaf export takes the path it writes, which the driver then unlinks.
codec_driver: fn(name: String, export: String) -> String Never! {
    leaves: name == "CompilerFileLeaves"
    signature: if leaves -> "int64_t" else -> "void"
    call: if leaves -> "Text *path = jet_rt_string_from_static(fixture_path, (int64_t)strlen(fixture_path));\nfixture_result = {export}((int64_t)(intptr_t)path);\njet_rt_string_drop(path);" else -> "fixture_result = {export}();"
    declaration: if leaves -> "static char *fixture_path;\n" else -> ""
    setup: if leaves -> "if (argc != 2) return 99;\nfixture_path = argv[1];\n" else -> ""
    cleanup: if leaves -> "if (unlink(fixture_path) != 0 && fixture_result == 0 && status == 0) return 98;\n" else -> ""
    "#include <stdint.h>\n#include <string.h>\n#include <unistd.h>\ntypedef struct Text Text;\nextern char **environ;\nextern void jet_rt_host_arguments(int64_t, char **, char **);\nextern int32_t jet_rt_main(void (*body)(void));\nextern Text *jet_rt_string_from_static(const void *, int64_t);\nextern void jet_rt_string_drop(Text *);\nextern int64_t {export}({signature});\nstatic int64_t fixture_result;\n{declaration}static void exercise(void) {{\n{call}\n}}\nint main(int argc, char **argv) {{\n{setup}jet_rt_host_arguments(argc, argv, environ);\nint32_t status = jet_rt_main(exercise);\n{cleanup}return status != 0 ? status : (int)fixture_result;\n}}\n"
}

// The committed inputs a crypto row's verdict reads beside its witness.
crypto_inputs: fn(name: String) -> [String] Never! {
    if name == "AgeV1" -> return [String]{"{RT}AgeV1Fixtures.json"}
    if !CRYPTO_FROZEN.contains(name) -> return [String]{}
    inputs := [String]{"{RT}{name}Fixtures.json"}
    if name == "CryptoOsEntropy" -> inputs.push("{RT}CryptoOsEntropyWorld.stderr")
    inputs
}

c_driver: fn(name: String, repo: String) -> String? Never! {
    head: "#define _GNU_SOURCE\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
    exported: if name == {
        "FaultSchedule" -> Val("jet_rt_fault_schedule_fixture")
        "IterCharge" -> Val("jet_rt_iter_charge_fixture")
        "ProgressState" -> Val("jet_rt_progress_state_fixture")
        "CompilerNeededJSON" -> Val("jet_rt_compiler_needed_json_fixture")
        "CompilerNeededURL" -> Val("jet_rt_compiler_needed_url_fixture")
        "CompilerNeededMathText" -> Val("jet_rt_compiler_math_text_fixture")
        "DynNative" -> Val("jet_rt_dyn_native_fixture")
        else -> None
    }
    if exported == .Val(symbol) -> return Val("{head}extern char **environ;\nextern void jet_rt_host_arguments(int64_t,char **,char **);\nextern int64_t {symbol}(void);\nint main(int argc,char **argv) {{ jet_rt_host_arguments(argc,argv,environ); return (int){symbol}(); }}\n")
    if name == "EnvironmentLeaves" -> return Val("{head}extern char **environ;\nextern int64_t jet_rt_environment_leaves_fixture(int64_t,int64_t,int64_t);\nint main(int argc,char **argv) {{ char invalid[]=\"JET_LEAF_INVALID=\\xff\"; if (putenv(invalid)||setenv(\"JET_LEAF_EMPTY\",\"\",1)||unsetenv(\"JET_LEAF_MISSING\")) return 100; return (int)jet_rt_environment_leaves_fixture(argc,(intptr_t)argv,(intptr_t)environ); }}\n")
    if name == "HostFault" -> return Val("{head}extern int64_t jet_rt_host_fault_fixture(int64_t,_Bool);\nint main(int argc,char **argv) {{ (void)argv; return (int)jet_rt_host_fault_fixture((intptr_t)\"A\",argc>1); }}\n")
    // The restart layout is a main's startup stack: envp's NULL, then an
    // empty auxiliary vector (AT_NULL). The recorder the startup environment
    // arms (in the file it names, which `jet test` creates) must hold the
    // read before the restart and none after it.
    if name == "HostRestart" -> return Val("{head}extern char **environ;\nextern int64_t jet_rt_host_restart_fixture(int64_t,int64_t,int64_t,int64_t,int64_t);\nstatic char *next_argv[]={{\"driver\",\"again\",\"more\",NULL}};\nstatic char *next_envp[]={{\"JET_RESTART_NEW=after\",NULL,NULL,NULL}};\nstatic char reads[65536];\nint main(int argc,char **argv) {{ FILE *log=fopen(\"reads.log\",\"wb\"); if (!log) return 100; fclose(log); if (setenv(\"JET_RESTART_OLD\",\"before\",1)||unsetenv(\"JET_RESTART_NEW\")||setenv(\"JET_TEST_READS_PATH\",\"reads.log\",1)) return 100; int code=(int)jet_rt_host_restart_fixture(argc,(intptr_t)argv,(intptr_t)environ,(intptr_t)next_argv,(intptr_t)next_envp); if (code) return code; log=fopen(\"reads.log\",\"rb\"); if (!log) return 101; size_t length=fread(reads,1,sizeof reads,log); fclose(log); if (!memmem(reads,length,\"EJET_RESTART_OLD\",16)) return 102; if (memmem(reads,length,\"JET_RESTART_NEW\",15)) return 103; return 0; }}\n")
    if name == "FloatBits" -> return Val("{head}extern int64_t jet_rt_test_f64_bits(double);\nextern double jet_rt_test_f64_from_bits(int64_t);\nint main(void) {{ const uint64_t words[]={{0,UINT64_C(0x8000000000000000),1,UINT64_C(0x7ff0000000000000),UINT64_C(0xfff0000000000000),UINT64_C(0x7ff8000000000001),UINT64_C(0x3ff0000000000000),UINT64_C(0xffffffffffffffff)}}; for(unsigned i=0;i<sizeof(words)/sizeof(*words);i++) {{ double value; memcpy(&value,&words[i],8); if((uint64_t)jet_rt_test_f64_bits(value)!=words[i]) return 1; value=jet_rt_test_f64_from_bits((int64_t)words[i]); uint64_t back; memcpy(&back,&value,8); if(back!=words[i]) return 2; }} return 0; }}\n")
    if name == "TerminalColor" -> return Val("{head}#include <pthread.h>\nextern void jet_rt_thread_attach(void),jet_rt_thread_detach(void);\nextern int64_t jet_rt_terminal_color_fixture(void);\nstatic void *worker(void *unused) {{ (void)unused; jet_rt_thread_attach(); int64_t code=jet_rt_terminal_color_fixture(); jet_rt_thread_detach(); return (void *)(intptr_t)code; }}\nint main(void) {{ if(jet_rt_terminal_color_fixture()) return 1; pthread_t thread; void *result; if(pthread_create(&thread,NULL,worker,NULL)||pthread_join(thread,&result)) return 2; return result!=NULL; }}\n")
    if name == "TrapReport" -> return Val("#define main registry_cabi_main\n#include \"{repo}/{RT}CAbiDriver.c\"\n#undef main\n#include <stdlib.h>\nextern int64_t jet_rt_trap_report_fixture(int64_t,int64_t,_Bool);\nextern void jet_rt_panic_message(const void *,int64_t);\nstatic int64_t callback(int64_t kind) {{ if(kind==0) jet_rt_panic_message(\"registry boom\",13); else if(kind==1) numeric_stop(); else if(kind==2) require(); else if(kind==3) require_eq(); else panic_case(); return 0; }}\nint main(int argc,char **argv) {{ if(argc!=3) return 2; return (int)jet_rt_trap_report_fixture((intptr_t)callback,strtol(argv[1],NULL,10),!strcmp(argv[2],\"captured\")); }}\n")
    None
}

// The bytes of the first `rt_static_text("…")` literal in `source`, undoing
// the generators' escapes (Tools/agent/RuntimeGenerators.jet static_text).
static_text_literal: fn(source: String, what: String) -> String Problem! {
    literal: regex.compile("rt_static_text\\(\"((?:[^\"\\\\]|\\\\.)*)\"\\)") ?? return Err(problem("static text pattern: {err}"))
    loop found in literal.matches(source) {
        body: (found.group(1) ?? "").bytes()
        bytes := [U8]{}
        at := 0
        loop at < body.len() {
            code: Int.from_u8(body[at])
            if code == 92 && at + 1 < body.len() {
                escaped: Int.from_u8(body[at + 1])
                plain: if escaped == {
                    110 -> 10
                    92 -> 92
                    34 -> 34
                    else -> return Err(problem("{what} has an unknown static text escape"))
                }
                bytes.push(U8{plain})
                at += 2
                next
            }
            if (code == 123 || code == 125) && at + 1 < body.len() && Int.from_u8(body[at + 1]) == code {
                bytes.push(U8{code})
                at += 2
                next
            }
            bytes.push(U8{code})
            at += 1
        }
        decoded: String.from_bytes(bytes) ?? return Err(problem("{what} is not UTF-8"))
        return Ok(decoded)
    }
    Err(problem("{what} has no static text"))
}

// The committed trap literal `name` of TrapMessages.jet: its static text
// (`<name>_text`), or its little-endian signed word rows. No runtime
// manufactures the expected report.
trap_literal: fn(repo: String, name: String) -[FS]> String Problem! {
    text: files.read("{repo}/Compiler/JetRuntime/Source/TrapMessages.jet") ?? return Err(problem("TrapMessages.jet cannot be read: {err}"))
    raw: "\n{text}".bytes()
    static_head: "\n{name}_text: fn() -> I64 {{ "
    line: index_of(raw, static_head, 0)
    if line >= 0 {
        end: index_of(raw, "\n", line + 1)
        if end < 0 -> return Err(problem("missing frozen trap literal {name}"))
        source: String.from_bytes(raw.slice(line, end)) ?? return Err(problem("trap literal {name} is not UTF-8"))
        decoded: static_text_literal(source, "trap literal {name}") ?? return Err(err)
        return Ok(decoded)
    }
    open: index_of(raw, "\n{name}: fn() {{\n", 0)
    if open < 0 -> return Err(problem("missing frozen trap literal {name}"))
    start: open + "\n{name}: fn() {{\n".count_bytes()
    close: index_of(raw, "\n}}", start - 1)
    if close < 0 -> return Err(problem("missing frozen trap literal {name}"))
    body: String.from_bytes(raw.slice(start, close + 1)) ?? return Err(problem("trap literal {name} is not UTF-8"))
    row: regex.compile("trap_write_word\\(I64\\{{(-?\\d+)\\}}, I64\\{{(\\d+)\\}}\\)") ?? return Err(problem("trap pattern: {err}"))
    bytes := [U8]{}
    loop found in row.matches(body) {
        word: Int.parse(found.group(1) ?? "") ?? return Err(problem("trap literal {name} has an invalid word"))
        count: Int.parse(found.group(2) ?? "") ?? return Err(problem("trap literal {name} has an invalid width"))
        loop i in 0..<count {
            v: (word >> (i * 8)).bit_and(255)
            bytes.push(U8{v})
        }
    }
    literal: String.from_bytes(bytes) ?? return Err(problem("trap literal {name} is not UTF-8"))
    literal
}

// The committed owned text `name` of SchedulerMessages.jet: its static text,
// which must be exactly as long as the text it sizes.
scheduler_literal: fn(repo: String, name: String) -[FS]> String Problem! {
    text: files.read("{repo}/Compiler/JetRuntime/Source/SchedulerMessages.jet") ?? return Err(problem("SchedulerMessages.jet cannot be read: {err}"))
    raw: "\n{text}".bytes()
    open: index_of(raw, "\n{name}: fn() -> I64 {{\n", 0)
    if open < 0 -> return Err(problem("missing frozen scheduler literal {name}"))
    close: index_of(raw, "\n}}", open + 1)
    if close < 0 -> return Err(problem("missing frozen scheduler literal {name}"))
    body: String.from_bytes(raw.slice(open, close)) ?? return Err(problem("scheduler literal {name} is not UTF-8"))
    sized: regex.compile("scheduler_text_new\\(I64\\{{(\\d+)\\}}\\)") ?? return Err(problem("scheduler pattern: {err}"))
    length := -1
    loop found in sized.matches(body) {
        length = Int.parse(found.group(1) ?? "") ?? -1
        break
    }
    literal: static_text_literal(body, "scheduler literal {name}") ?? return Err(err)
    if literal.count_bytes() != length -> return Err(problem("scheduler literal {name} is {literal.count_bytes()} bytes, not {length}"))
    Ok(literal)
}

strips_transport: fn(name: String) -> Bool Never! {
    name.starts_with("JET_BOOTSTRAP_") || name.starts_with("JET_FRONT_")
        || ([String]{"JET_TEST_FILTER", "JET_NATIVE_TEST_ID", "FX_ONLY", "FX_HEAD", "FX_EXCLUDE", "SELFHOST_SKIP", "SELFHOST_ROOTS"}).contains(name)
}

strips_registry: fn(name: String) -> Bool Never! {
    name == "JET_RUNTIME_PACK" || name.starts_with("JET_FRONT_") || name.starts_with("JET_BOOTSTRAP_") || name.starts_with("FX_")
        || ([String]{"JET_TEST_FILTER", "JET_TEST_SHUFFLE_SEED", "JET_TEST_SERIAL", "JET_TEST_TRACE_TIERS", "JET_NATIVE_TEST_ID", "JET_NATIVE_TEST_REPORT_PATH", "JET_NATIVE_TEST_RECORDS_PATH", "JET_UPDATE_SNAPSHOTS", "JET_SCHEMA_CACHE_DIR"}).contains(name)
}

// A registry child's environment: the caller's, without selection, tracing or
// front-end hooks, and with this checkout as the toolchain root.
registry_spec: fn(argv: [String], cwd: String, repo: String, extra: [Setting], timeout_ms: Int) -[Env, Exec]> ProcessSpec Never! {
    spec := process.cmd(argv).cwd(cwd).timeout(time.duration_ms(timeout_ms)).output_limit(134217728)
    keys: process.env_keys() ?? [String]{}
    loop name in keys {
        if strips_registry(name) {
            spec = spec.env_remove(name)
        }
    }
    spec = spec.env("JET_TOOLCHAIN_ROOT", repo).env("JET_TEST_JSON", "1").env("NO_COLOR", "1").env("TERM", "dumb")
    loop setting in extra {
        spec = spec.env(setting.name, setting.value)
    }
    spec
}

front_timeout_ms: fn() -[Env]> Int Never! { Int.parse(env_or("JET_FRONT_TIMEOUT_MS", "")) ?? TRANSPORT_TIMEOUT_MS }

registry_timeout_ms: fn() -[Env]> Int Never! { Int.parse(env_or("JET_REGISTRY_TIMEOUT_MS", "")) ?? REGISTRY_TIMEOUT_MS }

signal_dyn: fn(value: Int?) -> Dyn Never! {
    if value == .Val(number) -> return Dyn.Int(number)
    Dyn.Null
}

// Run one transport command with its evidence logged; any exit other than
// `expected` (or a signal or timeout) fails the transport.
execute: fn(lane: &Lane, command: String, args: [String], cwd: String, extra: [Setting], expected: Int, timeout_ms: Int) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Problem! {
    argv := [String]{command.copy()}
    loop arg in args -> argv.push(arg.copy())
    spec := process.cmd(argv).cwd(cwd).timeout(time.duration_ms(timeout_ms)).output_limit(134217728)
    keys: process.env_keys() ?? [String]{}
    loop name in keys {
        if strips_transport(name) {
            spec = spec.env_remove(name)
        }
    }
    spec = spec.env("JET_TOOLCHAIN_ROOT", lane.repo).env("JET_KEEP_GOING", "1").env("JET", lane.jet).env("JET_RUN", lane.jet)
        .env("JET_RUNTIME_PACK", lane.pack).env("JET_RUNTIME_JET_OBJECT", lane.object).env("JET_RUNTIME_OBJECT", lane.object)
        .env("JET_RUNTIME_C_LIB", lane.object).env("NO_COLOR", "1").env("TERM", "dumb")
    loop setting in extra {
        spec = spec.env(setting.name, setting.value)
    }
    prefix: "{lane.log_dir}/{lane.id.replace("/", "_")}-{lane.evidence.len()}"
    receipt: spec.run() ?? {
        files.write("{prefix}.stdout", "") ?? return Err(problem("`{prefix}.stdout` cannot be written: {err}"))
        files.write("{prefix}.stderr", "") ?? return Err(problem("`{prefix}.stderr` cannot be written: {err}"))
        lane.evidence.push(evidence_row(command, args, cwd, Dyn.Null, Dyn.Null, Dyn.Text("{err}"), prefix))
        return Err(problem("{command}: {err}; see {prefix}"))
    }
    files.write("{prefix}.stdout", receipt.output) ?? return Err(problem("`{prefix}.stdout` cannot be written: {err}"))
    files.write("{prefix}.stderr", receipt.errors) ?? return Err(problem("`{prefix}.stderr` cannot be written: {err}"))
    code: if receipt.signal != None || receipt.timed_out -> Dyn.Null else -> Dyn.Int(receipt.code)
    failure: if receipt.timed_out -> Dyn.Text("timed out after {timeout_ms} ms") else -> Dyn.Null
    lane.evidence.push(evidence_row(command, args, cwd, code, signal_dyn(receipt.signal), failure, prefix))
    if receipt.timed_out -> return Err(problem("{command}: timed out after {timeout_ms} ms; see {prefix}"))
    if receipt.signal == .Val(number) -> return Err(problem("{command}: signal {number}; see {prefix}"))
    if receipt.code != expected -> return Err(problem("{command}: {receipt.code}; see {prefix}"))
    Ran{code: receipt.code, signal: None, timed_out: false, stdout: receipt.output.copy(), stderr: receipt.errors.copy()}
}

evidence_row: fn(command: String, args: [String], cwd: String, code: Dyn, signal: Dyn, failure: Dyn, prefix: String) -> Dyn Never! {
    Dyn.Object([String: Dyn]{
        "command": Dyn.Text(command.copy()),
        "args": texts(args),
        "cwd": Dyn.Text(cwd.copy()),
        "code": code,
        "signal": signal,
        "error": failure,
        "stdoutPath": Dyn.Text("{prefix}.stdout"),
        "stderrPath": Dyn.Text("{prefix}.stderr"),
    })
}

// A repository Jet tool, run by the jet running this script (jet_cli).
jet_tool: fn(lane: &Lane, script: String, args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> Ran Problem! {
    argv := [String]{"{lane.repo}/{script}"}
    loop arg in args -> argv.push(arg.copy())
    binary: jet_cli()
    cwd: lane.out.copy()
    execute(lane, binary, argv, cwd, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
}

exact: fn(ran: Ran, stdout: String, stderr: String) Problem! {
    if ran.stdout == stdout && ran.stderr == stderr -> return Ok()
    shown: json.dumps(Dyn.Object([String: Dyn]{"stdout": Dyn.Text(ran.stdout.copy()), "stderr": Dyn.Text(ran.stderr.copy()), "expectedStdout": Dyn.Text(stdout.copy()), "expectedStderr": Dyn.Text(stderr.copy())})) ?? ""
    Err(problem("exact native verdict differs: {shown}"))
}

// One front-end command of the production CLI, with its log and record.
front: fn(lane: &Lane, args: [String], prefix: String, cwd: String, extra: [Setting]) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    files.create_dir_all(files.dirname(prefix)) ?? return Err(problem("`{prefix}` cannot be prepared: {err}"))
    binary: lane.jet.copy()
    ran: execute(lane, binary, args, cwd, extra, 0, front_timeout_ms()) ?? return Err(err)
    files.write("{prefix}.front.log", "{ran.stdout}{ran.stderr}") ?? return Err(problem("`{prefix}.front.log` cannot be written: {err}"))
    record: Dyn.Object([String: Dyn]{"command": Dyn.Text(lane.jet.copy()), "args": texts(args), "cwd": Dyn.Text(cwd.copy()), "status": Dyn.Int(ran.code), "signal": Dyn.Null, "error": Dyn.Null, "stdout": Dyn.Text(ran.stdout.copy()), "stderr": Dyn.Text(ran.stderr.copy())})
    text: json.to_string_pretty(record) ?? return Err(problem("the front record cannot be encoded: {err}"))
    files.write("{prefix}.front.run.json", "{text}\n") ?? return Err(problem("`{prefix}.front.run.json` cannot be written: {err}"))
    Ok()
}

// Lower `file` as a native library through `jet doc`, the runtime-library
// seam (`jet check` lowers no #Export(c) body): the front-end hook writes its
// object, exports, ABI, thread and issue files beside `prefix`.
library: fn(lane: &Lane, file: String, prefix: String, lifecycle: String, exports: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    if !files.exists(lifecycle) -> return Err(problem("native library lifecycle list `{lifecycle}` is missing"))
    loop suffix in ([String]{".o", ".exports", ".abi.json", ".threads", ".issues"}) {
        if files.exists("{prefix}{suffix}") -> files.remove("{prefix}{suffix}") ?? return Err(problem("`{prefix}{suffix}` cannot be removed: {err}"))
    }
    hooks := [Setting]{Setting{name: "JET_FRONT_LIBRARY_OBJECT_OUTPUT", value: prefix.copy()}, Setting{name: "JET_FRONT_LIBRARY_LIFECYCLE", value: lifecycle.copy()}}
    if exports != "" -> hooks.push(Setting{name: "JET_FRONT_LIBRARY_EXPORTS", value: exports.copy()})
    front(lane, [String]{"doc", file}, prefix, files.dirname(file), hooks) ?? return Err(err)
    if files.exists("{prefix}.issues") -> return Err(problem(files.read("{prefix}.issues") ?? ""))
    loop suffix in ([String]{".o", ".exports", ".abi.json", ".threads"}) {
        if !files.exists("{prefix}{suffix}") -> return Err(problem("native library hook omitted {suffix}"))
    }
    Ok()
}

// The runtime imports jet_rt_fault_report, which Jet's linker writes into each
// image; this platform link assembles it from the shared report source.
link: fn(lane: &Lane, source: String, object: String, binary: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    link_with(lane, STRICT_CFLAGS, source, object, binary)
}

link_with: fn(lane: &Lane, cflags: [String], source: String, object: String, binary: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    report_object: fault_report(lane) ?? return Err(err)
    args := cflags.copy()
    args.extend([String]{source, object, report_object, "-lpthread", "-ldl", "-lm", "-o", binary})
    execute(lane, env_or("CC", "cc"), args, lane.out.copy(), [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
    Ok()
}

// The object that defines jet_rt_fault_report, assembled into the lane.
fault_report: fn(lane: &Lane) -[Env, Exec, FS, IO, Time, Time.Wait]> String Problem! {
    cwd: lane.out.copy()
    repo: lane.repo.copy()
    report: "{cwd}/fault-report.S"
    report_object: "{cwd}/fault-report.o"
    files.write(report, "    .text\n    .globl jet_rt_fault_report\n    .type jet_rt_fault_report, @function\njet_rt_fault_report:\n    .include \"{repo}/Compiler/JetRuntime/Assets/FaultReport/report.S\"\n    .size jet_rt_fault_report, . - jet_rt_fault_report\n") ?? return Err(problem("`{report}` cannot be written: {err}"))
    execute(lane, "as", [String]{"--64", "-o", report_object, report}, cwd, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
    report_object
}

// The real GNU-as inputs of the runtime-pack fixtures, assembled into the
// lane: runtime.o, archive.o, consumer.o, missing.o and runtime.a.
pack_roots_inputs: fn(lane: &Lane) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    cwd: lane.out.copy()
    loop name in PACK_ROOTS_INPUTS {
        object: if name == "object" -> "runtime.o" else -> "{name}.o"
        source: "{lane.repo}/{BE}LinkPackRoots.fixture/runtime-pack-roots-{name}.s"
        execute(lane, "as", [String]{"--64", "-o", "{cwd}/{object}", source}, cwd, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
    }
    execute(lane, "ar", [String]{"rcs", "{cwd}/runtime.a", "{cwd}/archive.o"}, cwd, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
    Ok()
}

// A committed Jet runner, run from the repository root by the lane's jet:
// each call's C witness is linked against the runtime object and handed over,
// and a runner without one links its fixture against the same link inputs.
// Every call must print exactly its line and nothing on stderr.
runner_verdict: fn(lane: &Lane, found: Spec) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    script: "{lane.repo}/{found.runner}"
    loop call in found.calls {
        label: if call.mode == "" -> "run" else -> call.mode.copy()
        args := [String]{"-A", script.copy()}
        if call.witness == "" {
            report_object: fault_report(lane) ?? return Err(err)
            args.extend([String]{"{out}/{label}", lane.object.copy(), report_object, "-lpthread", "-ldl", "-lm"})
        } else {
            binary: "{out}/{label}.bin"
            link(lane, "{lane.repo}/{call.witness}", lane.object.copy(), binary) ?? return Err(err)
            if call.mode != "" -> args.extend([String]{call.mode.copy(), "{out}/{label}"})
            args.push(binary)
        }
        ran: execute(lane, lane.jet.copy(), args, lane.repo.copy(), [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        exact(ran, call.expected, "") ?? return Err(problem("{found.name} {label}: {err.message}"))
    }
    Ok()
}

read_json: fn(path: String) -[FS]> Dyn Problem! {
    text: files.read(path) ?? return Err(problem("`{path}` cannot be read: {err}"))
    parsed: json.parse(text) ?? return Err(problem("`{path}` is not JSON: {err}"))
    parsed
}

copy_tree: fn(from: String, to: String) Problem! -[FS]> {
    files.create_dir_all(to) ?? return Err(problem("`{to}` cannot be created: {err}"))
    listed: files.list_dir(from) ?? return Err(problem("`{from}` cannot be listed: {err}"))
    loop entry in listed {
        source: "{from}/{entry.name}"
        meta: files.stat(source, .Follow) ?? return Err(problem("`{source}` cannot be read: {err}"))
        if meta.is_dir {
            copy_tree(source, "{to}/{entry.name}") ?? return Err(err)
            next
        }
        files.copy(source, "{to}/{entry.name}") ?? return Err(problem("`{source}` cannot be copied: {err}"))
        files.set_mode("{to}/{entry.name}", meta.mode % 4096) ?? return Err(problem("`{to}/{entry.name}` mode: {err}"))
    }
    Ok()
}

sha256_path: fn(path: String) -[FS]> String Problem! {
    crypto.sha256(files.read_bytes(path) ?? return Err(problem("`{path}` cannot be read: {err}"))).hex()
}

// The production CLI resolves its runtime beside its executable: stage the
// supplied jet and runtime exactly, never a previously installed runtime.
stage_toolchain: fn(jet: String, runtime: Runtime, out: String) -[FS]> String Problem! {
    staged: "{out}/jet"
    staged_pack: "{out}/jet-runtime/jet_runtime.pack.o"
    if !files.exists(out) {
        files.create_dir_all(out) ?? return Err(problem("`{out}` cannot be created: {err}"))
        files.copy(jet, staged) ?? return Err(problem("`{jet}` cannot be staged: {err}"))
        files.set_mode(staged, 0o755) ?? return Err(problem("`{staged}` cannot be made executable: {err}"))
        copy_tree(runtime.dir, "{out}/jet-runtime") ?? return Err(err)
    } else if !files.exists(staged) || !files.exists(staged_pack) || (sha256_path(staged) ?? "") != (sha256_path(jet) ?? "-") || (sha256_path(staged_pack) ?? "") != runtime.pack_sha256 {
        return Err(problem("staged transport toolchain changed"))
    }
    staged
}

run_transport: fn(entry: Dyn, repo: String, jet: String, log_dir: String, runtime: Runtime, adapter: String) -[Env, Exec, FS, IO, Time, Time.Wait]> (ran: Ran, evidence: [Dyn]) Problem! {
    id: text_field(entry, "id")
    found: specification(transport_key(id)) ?? return Err(problem("unknown transport {id}"))
    if found.blocked != "" -> return Err(problem(found.blocked))
    runner_sha: text_field(field(entry, "transport"), "runnerSha256")
    if int_field(entry, "testCount") != Val(1) || text_field(entry, "sha256") != (sha256_path(adapter) ?? "") || runner_sha != (sha256_path("{repo}/{found.runner}") ?? "") {
        return Err(problem("transport source/count changed: {id}"))
    }
    out: text_field(entry, "cwd")
    files.create_dir_all(out) ?? return Err(problem("`{out}` cannot be created: {err}"))
    files.create_dir_all(log_dir) ?? return Err(problem("`{log_dir}` cannot be created: {err}"))
    staged: stage_toolchain(jet, runtime, "{log_dir}/toolchain") ?? return Err(err)
    lane := Lane{id: id.copy(), out: out.copy(), repo: repo.copy(), log_dir: log_dir.copy(), jet: staged, runtime_dir: runtime.dir.copy(), pack: runtime.pack.copy(), object: runtime.object.copy(), evidence: [Dyn]{}}
    if drive(lane, found) == {
        .Ok(_) -> {}
        .Err(failure) -> return (ran: Ran{code: 1, signal: None, timed_out: false, stdout: "", stderr: "{failure.message}\n"}, evidence: lane.evidence.copy())
    }
    (ran: Ran{code: 0, signal: None, timed_out: false, stdout: text_field(entry, "stdout"), stderr: ""}, evidence: lane.evidence.copy())
}

// The transport body: the native build or library, the C driver, and the
// exact verdict its kind admits.
drive: fn(lane: &Lane, found: Spec) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    repo: lane.repo.copy()
    staged: lane.jet.copy()
    if found.kind == "plain" {
        // One runtime per image: the fragment and the runtime sources lower
        // as a library that a C host links. A program would link this
        // runtime copy beside the pack's, whose startup thread state the
        // fragment's own init then overwrites.
        raw: "{out}/raw"
        native: "{out}/native"
        files.create_dir_all("{native}/Source") ?? return Err(problem("`{native}/Source` cannot be created: {err}"))
        unit_args := [String]{"--root", "{repo}/Compiler", "unit", raw}
        loop name in found.fragments {
            unit_args.push("--test")
            unit_args.push(name.copy())
        }
        jet_tool(lane, found.runner, unit_args) ?? return Err(err)
        assembled: files.read("{raw}/unit.jet") ?? return Err(problem("`{raw}/unit.jet` cannot be read: {err}"))
        unit: if found.name == "CollectionsStop" -> collections_stop_unit(assembled) ?? return Err(err) else -> assembled.copy()
        entry: if found.call == .Val(call) -> "\n#Export(c) jet_rt_plain_fixture: fn() {{ {call}() }}\n" else -> ""
        export: codec_export(found.name)
        if entry == "" && found.witness == "" && export == "" -> return Err(problem("plain transport {found.name} names no entry"))
        fixture: "{native}/Source/Fixture.jet"
        files.write(fixture, "{unit}{entry}") ?? return Err(problem("`{fixture}` cannot be written: {err}"))
        package: files.read("{repo}/Compiler/JetRuntime/package.jet") ?? return Err(problem("`Compiler/JetRuntime/package.jet` cannot be read: {err}"))
        files.write("{native}/package.jet", package) ?? return Err(problem("`{native}/package.jet` cannot be written: {err}"))
        // The fragments witness the allocator a program built without
        // `--checked-alloc` runs, so the checked heap's init hook stays out;
        // a process witness is a C host that links the runtime object itself,
        // so it runs checked and observes the checked heap's frees.
        checked: PROCESS_WITNESSES.contains(found.name)
        rows: files.read("{repo}/Compiler/JetRuntime/lifecycle.list") ?? return Err(problem("`Compiler/JetRuntime/lifecycle.list` cannot be read: {err}"))
        kept := [String]{}
        loop row in rows.split("\n") {
            if checked || !row.starts_with("jet_rt_alloc_check_init ") -> kept.push(row.copy())
        }
        lifecycle: "{native}/lifecycle.list"
        files.write(lifecycle, kept.join("\n")) ?? return Err(problem("`{lifecycle}` cannot be written: {err}"))
        library(lane, fixture, "{native}/fixture", lifecycle, "") ?? return Err(err)
        generated: "{native}/driver.c"
        driver: if found.witness != "" -> "{repo}/{found.witness}" else -> generated.copy()
        if found.witness == "" {
            source: if export != "" -> codec_driver(found.name, export) else -> PLAIN_DRIVER.copy()
            files.write(generated, source) ?? return Err(problem("`{generated}` cannot be written: {err}"))
        }
        binary: "{native}/driver"
        link_with(lane, found.cflags, driver, "{native}/fixture.o", binary) ?? return Err(err)
        if found.name == "Scheduler" -> return scheduler_verdict(lane, binary)
        if found.fragments == WORLD_SENTRY -> return world_sentry_verdict(lane, binary, "{native}/fixture.o")
        if found.name == "Channel" -> return channel_verdict(lane, binary)
        if found.name == "SharedPublication" -> return publication_verdict(lane, binary, "{native}/fixture.o", found.expected)
        if CRYPTO.contains(found.name) -> return crypto_verdict(lane, found.name, binary)
        expected: if found.expected_file != "" -> files.read("{repo}/{found.expected_file}") ?? return Err(problem("`{found.expected_file}` cannot be read: {err}")) else -> found.expected.copy()
        // The file-leaf export writes, reads back and removes the path given.
        args: if found.name == "CompilerFileLeaves" -> [String]{"{out}/file-leaves.data"} else -> [String]{}
        ran: execute(lane, binary, args, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        return exact(ran, expected, "")
    }
    if found.kind == "c" -> return c_verdict(lane, found)
    if found.kind == "runner" -> return runner_verdict(lane, found)
    if found.kind == "indices" || found.kind == "roots" {
        if found.kind == "roots" -> pack_roots_inputs(lane) ?? return Err(err)
        expected: if found.kind == "indices" -> "link section indexes: pass\n" else -> "runtime pack object roots: pass\n"
        ran: execute(lane, staged, [String]{"run", "{repo}/{found.runner}"}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        exact(ran, expected, "") ?? return Err(err)
        if found.kind == "indices" -> return Ok()
    }
    if found.kind == "link" {
        pack_roots_inputs(lane) ?? return Err(err)
        linked: execute(lane, staged, [String]{"run", "{repo}/{found.runner}", "--", "{out}/consumer", "{out}/consumer.o", "{out}/runtime.o", "{out}/runtime.a"}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        receipt: regex.compile("linked .+: [0-9]+ bytes; read [0-9]+ ms, link [0-9]+ ms, write [0-9]+ ms\\n") ?? return Err(problem("linker pattern: {err}"))
        if !receipt.full_match(linked.stdout) || linked.stderr != "" -> return Err(problem("linker artifact receipt differs"))
    }
    if found.kind == "roots" || found.kind == "link" {
        consumer: execute(lane, "{out}/consumer", [String]{}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        return exact(consumer, "", "")
    }
    if found.kind == "cli" {
        ran: execute(lane, staged, [String]{"run", "{repo}/{found.runner}", "--", staged.copy(), "{out}/scratch"}, repo, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        return exact(ran, found.expected, "")
    }
    Err(problem("unimplemented transport {found.kind}"))
}

// The scheduler host walks its tasks silently at 1, 2 and 8 workers, then
// stops on a root panic that the process edge reports exactly as the
// committed literals compose it: no runtime manufactures the golden.
scheduler_verdict: fn(lane: &Lane, binary: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    repo: lane.repo.copy()
    loop threads in ([String]{"1", "2", "8"}) {
        ran: execute(lane, binary, [String]{}, out, [Setting]{Setting{name: "JET_SCHEDULER_THREADS", value: threads.copy()}}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        exact(ran, "", "") ?? return Err(problem("JET_SCHEDULER_THREADS={threads}: {err.message}"))
    }
    header: trap_literal(repo, "trap_msg_header_panic") ?? return Err(err)
    cancelled: scheduler_literal(repo, "scheduler_msg_cancelled") ?? return Err(err)
    prelude: trap_literal(repo, "trap_msg_prelude_end") ?? return Err(err)
    footer: trap_literal(repo, "trap_footer_e3001") ?? return Err(err)
    panicked: execute(lane, binary, [String]{"root-panic"}, out, [Setting]{}, 70, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
    exact(panicked, "", "{header}{cancelled}{prelude}{footer}")
}

// The world/sentry host runs the world, sentry, test-scope and allocation
// policy witnesses silently under a memory ledger, and its source gate
// silently. Its `ledger` mode records one expired-stack row through a normal
// return, `ledger-stop` the same row through the R0802 stop with one
// `exit: 70` line; the two ledgers are byte-equal, each a fresh owner-only
// file (0600) in an owner-only directory (0700). The logical-environment and
// link-native hosts link against the same object and run: each prints exactly
// the lines its C source `puts`. Every failure is reported.
world_sentry_verdict: fn(lane: &Lane, binary: String, object: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    repo: lane.repo.copy()
    failures := [String]{}
    loop name in WORLD_SENTRY_LINKED {
        source: "{repo}/{RT}{name}.c"
        host: "{out}/native/{name}"
        if link(lane, source, object, host) == {
            .Err(failed) -> failures.push("{name} link: {failed.message}")
            .Ok(_) -> {
                expected: puts_lines(source) ?? {
                    failures.push("{name}: {err.message}")
                    next
                }
                failures.extend(step_failures(name, execute(lane, host, [String]{}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS), expected, ""))
            }
        }
    }
    ledgers: "{out}/ledgers"
    files.remove_all(ledgers) ?? ()
    silent: Setting{name: "JET_MEMORY_LEDGER", value: "{ledgers}/checks/ledger.jsonl"}
    failures.extend(step_failures("witnesses", execute(lane, binary, [String]{}, out, [Setting]{silent}, 0, TRANSPORT_TIMEOUT_MS), "", ""))
    failures.extend(step_failures("source-gate", execute(lane, binary, [String]{"source-gate"}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS), "", ""))
    returned: "{ledgers}/return/ledger.jsonl"
    stopped: "{ledgers}/stop/ledger.jsonl"
    recorded: Setting{name: "JET_MEMORY_LEDGER", value: returned.copy()}
    failures.extend(step_failures("ledger", execute(lane, binary, [String]{"ledger"}, out, [Setting]{recorded}, 0, TRANSPORT_TIMEOUT_MS), "*", "*"))
    stopping: Setting{name: "JET_MEMORY_LEDGER", value: stopped.copy()}
    failures.extend(step_failures("ledger-stop", execute(lane, binary, [String]{"ledger-stop"}, out, [Setting]{stopping}, 70, TRANSPORT_TIMEOUT_MS), "", "R0802"))
    texts := [String]{}
    loop path in ([String]{returned, stopped}) {
        text: files.read(path) ?? {
            failures.push("`{path}` cannot be read: {err}")
            next
        }
        if text == "" || text.trim_end().split("\n").to_list().len() != 1 -> failures.push("`{path}` does not hold exactly one ledger row")
        file_mode: (files.stat(path) ?? return Err(problem("`{path}` cannot be inspected: {err}"))).mode % 512
        dir_mode: (files.stat(files.dirname(path)) ?? return Err(problem("`{files.dirname(path)}` cannot be inspected: {err}"))).mode % 512
        if file_mode != 384 || dir_mode != 448 -> failures.push("`{path}` is not an owner-only file (0600) in an owner-only directory (0700)")
        texts.push(text)
    }
    if texts.len() == 2 && texts[0] != texts[1] -> failures.push("the returned and stopped ledgers differ")
    if failures.len() > 0 -> return Err(problem("world/sentry verdict: {failures.join("; ")}"))
    Ok()
}

// The channel host runs its queue, select, reservation and Shared witnesses
// silently on stderr, printing each witness's line; a select on closed or
// empty channels with no ready arm is a scheduler stop, which spec S36
// delivers as E3001 with exit 70: no output, and a report naming the panic.
channel_verdict: fn(lane: &Lane, binary: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    failures := [String]{}
    if execute(lane, binary, [String]{}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) == {
        .Err(failed) -> failures.push("witnesses: {failed.message}")
        .Ok(ran) -> {
            if ran.stderr != "" -> failures.push("witnesses: stderr {json.dumps(Dyn.Text(ran.stderr.copy())) ?? ""} is not empty")
            printed: ran.stdout.split("\n").to_list()
            loop line in CHANNEL_LINES {
                if !printed.contains(line) -> failures.push("witnesses: stdout lacks `{line}`")
            }
        }
    }
    stops: [[String]]{[String]{"select-closed", "select closed"}, [String]{"select-empty", "select: no arms registered"}}
    loop stop in stops {
        mode: stop[0].copy()
        if execute(lane, binary, [String]{mode.copy()}, out, [Setting]{}, 70, TRANSPORT_TIMEOUT_MS) == {
            .Err(failed) -> failures.push("{mode}: {failed.message}")
            .Ok(ran) -> {
                if ran.stdout != "" -> failures.push("{mode}: stdout {json.dumps(Dyn.Text(ran.stdout.copy())) ?? ""} is not empty")
                if !ran.stderr.starts_with("Stop [E3001]: `panic: {stop[1]}`") -> failures.push("{mode}: stderr does not open with the E3001 `panic: {stop[1]}` report")
            }
        }
    }
    if failures.len() > 0 -> return Err(problem("channel verdict: {failures.join("; ")}"))
    Ok()
}

// The Shared publication host prints its World and Process race lines; the
// Shared weak host, linked against the same object, its three lines.
publication_verdict: fn(lane: &Lane, binary: String, object: String, expected: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    failures := step_failures("publication", execute(lane, binary, [String]{}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS), expected, "")
    host: "{out}/native/{PUBLICATION_LINKED}"
    if link(lane, "{lane.repo}/{RT}{PUBLICATION_LINKED}.c", object, host) == {
        .Err(failed) -> failures.push("{PUBLICATION_LINKED} link: {failed.message}")
        .Ok(_) -> failures.extend(step_failures(PUBLICATION_LINKED, execute(lane, host, [String]{}, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS), WEAK_EXPECTED, ""))
    }
    if failures.len() > 0 -> return Err(problem("Shared publication verdict: {failures.join("; ")}"))
    Ok()
}

// Why a world/sentry step failed: its run failed, or its stdout is not
// `stdout`, or its stderr is not `stderr` ("*" admits any output). A stderr of
// "R0802" is the sentry stop report: it names R0802 and holds exactly one
// `exit: 70` line.
step_failures: fn(step: String, result: Ran Problem!, stdout: String, stderr: String) -> [String] Never! {
    ran: if result == {
        .Ok(done) -> done
        .Err(failed) -> return [String]{"{step}: {failed.message}"}
    }
    failures := [String]{}
    if stdout != "*" && ran.stdout != stdout -> failures.push("{step}: stdout {json.dumps(Dyn.Text(ran.stdout.copy())) ?? ""} is not {json.dumps(Dyn.Text(stdout.copy())) ?? ""}")
    if stderr == "R0802" {
        exits := [String]{}
        loop line in ran.stderr.split("\n") {
            if line.starts_with("exit: ") -> exits.push(line.copy())
        }
        if !ran.stderr.contains("R0802") -> failures.push("{step}: the stop report does not name R0802")
        if exits.len() != 1 || exits[0] != "exit: 70" -> failures.push("{step}: the report's exit lines [{exits.join(" | ")}] are not one `exit: 70`")
    } else if stderr != "*" && ran.stderr != stderr {
        failures.push("{step}: stderr {json.dumps(Dyn.Text(ran.stderr.copy())) ?? ""} is not {json.dumps(Dyn.Text(stderr.copy())) ?? ""}")
    }
    failures
}

// A crypto row runs its own KAT witness against the one composed object:
// exact stdout from the committed literal, empty stderr, the World entropy
// stops, and for AgeV1 every frozen open and seal vector.
crypto_verdict: fn(lane: &Lane, name: String, binary: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    failures := [String]{}
    if name == "AgeV1" {
        failures.extend(age_failures(lane, binary) ?? return Err(err))
    } else {
        expected: witness_stdout(lane.repo, name) ?? return Err(err)
        if expected == "" -> failures.push("{name}: the witness commits no stdout literal")
        if CRYPTO_FROZEN.contains(name) {
            metadata: read_json("{lane.repo}/{RT}{name}Fixtures.json") ?? return Err(err)
            if crypto.sha256(expected).hex() != text_field(metadata, "stdoutSha256") -> failures.push("{name}: the frozen stdout reference is damaged")
        }
        timeout: if name == "CryptoEd25519Signature" -> 300000 else -> 60000
        failures.extend(step_failures(name, execute(lane, binary, [String]{}, lane.out.copy(), [Setting]{}, 0, timeout), expected, ""))
        if name == "CryptoOsEntropy" -> failures.extend(world_entropy_failures(lane, binary) ?? return Err(err))
    }
    if failures.len() > 0 -> return Err(problem("crypto verdict: {failures.join("; ")}"))
    Ok()
}

// The deterministic World refuses every listed count with the frozen stop.
world_entropy_failures: fn(lane: &Lane, binary: String) -[Env, Exec, FS, IO, Time, Time.Wait]> [String] Problem! {
    metadata: read_json("{lane.repo}/{RT}CryptoOsEntropyFixtures.json") ?? return Err(err)
    world: field(metadata, "world")
    path: "{lane.repo}/{RT}CryptoOsEntropyWorld.stderr"
    expected: files.read(path) ?? return Err(problem("`{path}` cannot be read: {err}"))
    code: int_field(world, "exitCode") ?? return Err(problem("CryptoOsEntropyFixtures.json names no World exit code"))
    failures := [String]{}
    if crypto.sha256(expected).hex() != text_field(world, "stderrSha256") -> failures.push("CryptoOsEntropy: the frozen World stop reference is damaged")
    loop count in WORLD_ENTROPY_COUNTS {
        failures.extend(step_failures("world {count}", execute(lane, binary, [String]{"world", count.copy()}, lane.out.copy(), [Setting]{}, code, 60000), "", expected))
    }
    Ok(failures)
}

// A frozen AgeV1 cipher: base64 in the fixtures JSON, pinned by its sha256.
age_cipher: fn(test: Dyn) -> [U8] Problem! {
    name: text_field(test, "name")
    cipher: base64.decode(text_field(test, "cipher")) ?? return Err(problem("{name}: the frozen cipher is not base64: {err}"))
    if crypto.sha256(cipher).hex() != text_field(test, "cipherSha256") -> return Err(problem("{name}: the frozen cipher is damaged"))
    Ok(cipher)
}

// Every frozen AgeV1 vector: each case opens (or is refused) to its plaintext
// digest, and each seal reproduces its frozen cipher byte for byte.
age_failures: fn(lane: &Lane, binary: String) -[Env, Exec, FS, IO, Time, Time.Wait]> [String] Problem! {
    frozen: read_json("{lane.repo}/{RT}AgeV1Fixtures.json") ?? return Err(err)
    material: "{lane.out}/age-material"
    files.create_dir_all(material) ?? return Err(problem("`{material}` cannot be created: {err}"))
    failures := [String]{}
    loop test in array_field(frozen, "cases") {
        name: text_field(test, "name")
        cipher: age_cipher(test) ?? return Err(err)
        path: "{material}/{name}.age"
        files.write_bytes(path, cipher) ?? return Err(problem("`{path}` cannot be written: {err}"))
        valid: if field(test, "valid") == .Bool(true) -> "1" else -> "0"
        plain: if field(test, "plainSha256") == .Text(digest) -> digest.copy() else -> "-"
        failures.extend(step_failures("open {name}", execute(lane, binary, [String]{"open", text_field(test, "identity"), path, valid, plain}, lane.out.copy(), [Setting]{}, 0, 60000), "", ""))
    }
    loop test in array_field(frozen, "seals") {
        name: text_field(test, "name")
        cipher: age_cipher(test) ?? return Err(err)
        plain: base64.decode(text_field(test, "plain")) ?? return Err(problem("{name}: the frozen plaintext is not base64: {err}"))
        count: int_field(test, "recipientCount") ?? return Err(problem("{name}: the frozen seal names no recipient count"))
        plain_path: "{material}/{name}.plain"
        cipher_path: "{material}/{name}.age"
        capture_path: "{material}/{name}.capture.age"
        files.write_bytes(plain_path, plain) ?? return Err(problem("`{plain_path}` cannot be written: {err}"))
        files.write_bytes(cipher_path, cipher) ?? return Err(problem("`{cipher_path}` cannot be written: {err}"))
        sealed: step_failures("seal {name}", execute(lane, binary, [String]{"seal", text_field(test, "identity"), plain_path, cipher_path, "{count}", capture_path}, lane.out.copy(), [Setting]{}, 0, 60000), "", "")
        if sealed.len() > 0 {
            failures.extend(sealed)
            next
        }
        captured: files.read_bytes(capture_path) ?? return Err(problem("`{capture_path}` cannot be read: {err}"))
        if captured != cipher -> failures.push("seal {name}: the Jet capture differs from the frozen cipher")
    }
    Ok(failures)
}

// A witness's committed stdout: its .stdout file, or else the lines its C
// source `puts`.
witness_stdout: fn(repo: String, name: String) -[FS]> String Problem! {
    stdout_file: "{repo}/{RT}{name}Witness.stdout"
    if files.exists(stdout_file) -> return files.read(stdout_file) ?? return Err(problem("`{stdout_file}` cannot be read: {err}"))
    puts_lines("{repo}/{RT}{name}Witness.c")
}

// The lines the C source at `path` `puts`, each ending in a newline.
puts_lines: fn(path: String) -[FS]> String Problem! {
    source: files.read(path) ?? return Err(problem("`{path}` cannot be read: {err}"))
    puts: regex.compile("puts\\((\"(?:\\\\.|[^\"\\\\])*\")\\);") ?? return Err(problem("puts pattern: {err}"))
    out := ""
    loop found in puts.matches(source) {
        parsed: json.parse(found.group(1) ?? "") ?? return Err(problem("witness literal is not a JSON string: {err}"))
        if parsed == .Text(line) -> out = "{out}{line}\n"
    }
    out
}

c_verdict: fn(lane: &Lane, found: Spec) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: lane.out.copy()
    repo: lane.repo.copy()
    // The runtime unit with this fixture's test fragment, as the package's
    // Source/Runtime.jet beside its manifest.
    jet_tool(lane, found.runner, [String]{"--root", "{repo}/Compiler", "unit", "{out}/library", "--test", found.name}) ?? return Err(err)
    files.create_dir_all("{out}/library/Source") ?? return Err(problem("`{out}/library/Source` cannot be created: {err}"))
    files.rename("{out}/library/unit.jet", "{out}/library/Source/Runtime.jet") ?? return Err(problem("`{out}/library/unit.jet` cannot be moved: {err}"))
    library(lane, "{out}/library/Source/Runtime.jet", "{out}/jet_runtime_jet", "{repo}/Compiler/JetRuntime/lifecycle.list", "") ?? return Err(err)
    source: if found.name == {
        "VaultHooks" | "VaultProvider" -> "{repo}/{RT}{found.name}Witness.c"
        "Thread" -> "{repo}/{RT}thread-fixture.c"
        "HostSpawn" | "CompilerEnv" | "CompilerRoutes" -> "{repo}/{RT}{found.name}Tests.c"
        else -> "{out}/driver.c"
    }
    driver: "{out}/driver.c"
    if source == driver {
        text: c_driver(found.name, repo) ?? return Err(problem("no C source {found.name}"))
        files.write(source, text) ?? return Err(problem("`{source}` cannot be written: {err}"))
    }
    binary: "{out}/driver"
    link(lane, source, "{out}/jet_runtime_jet.o", binary) ?? return Err(err)
    if found.name == "HostFault" {
        plain: execute(lane, binary, [String]{}, out, [Setting]{}, 101, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        exact(plain, "", "A\n") ?? return Err(err)
        unreachable: trap_literal(repo, "trap_msg_unreachable") ?? return Err(err)
        trapped: execute(lane, binary, [String]{"unreachable"}, out, [Setting]{}, 101, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        return exact(trapped, "", "{unreachable}A\n")
    }
    if found.name == "TrapReport" {
        header: trap_literal(repo, "trap_msg_header_panic") ?? return Err(err)
        prelude: trap_literal(repo, "trap_msg_prelude_end") ?? return Err(err)
        footer: trap_literal(repo, "trap_footer_e3001") ?? return Err(err)
        simple: "{header}registry boom{prelude}{footer}"
        loop kind in 0..<5 {
            direct: execute(lane, binary, [String]{"{kind}", "direct"}, out, [Setting]{}, 70, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
            captured: execute(lane, binary, [String]{"{kind}", "captured"}, out, [Setting]{}, 70, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
            stop: if kind == 1 -> "Stop [E3010]:" else -> "Stop [E3001]:"
            if direct.stdout != "" || !direct.stderr.starts_with(stop) -> return Err(problem("trap report process-edge verdict differs"))
            exact(captured, "", direct.stderr) ?? return Err(err)
            if kind == 0 -> exact(direct, "", simple) ?? return Err(err)
        }
        return Ok()
    }
    expected: if found.name == {
        "VaultHooks" -> "vault hooks witness OK (TLS ownership, exact stops, 8 root-filtered two-phase barriers)\n"
        "VaultProvider" -> "vault witness OK (13 errors, legacy+JVLT2 codec, imported origin/default entropy, native Secret redaction/wipe, long-origin hash, duplicate priority)\n"
        "Thread" -> "tls ok\n"
        "HostSpawn" -> "process raw: ok\n"
        "CompilerEnv" -> "compiler environment routes: Jet-only (Rust frozen)\n"
        "CompilerRoutes" -> "compiler routes: Jet-only (Rust frozen)\n"
        else -> ""
    }
    loop args in driver_runs(found, out) {
        ran: execute(lane, binary, args, out, [Setting]{}, 0, TRANSPORT_TIMEOUT_MS) ?? return Err(err)
        exact(ran, expected, "") ?? return Err(err)
    }
    Ok()
}

// --- manifest -------------------------------------------------------------------

registry_environment: fn(repo: String, cwd: String, sources: [String]) -[Env, Exec, FS, IO]> Dyn Never! {
    scratch: "{cwd}/scratch"
    entries := [String: Dyn]{"TMPDIR": Dyn.Text(scratch.copy())}
    loop source in sources {
        text: files.read("{repo}/{source}") ?? return fail("`{source}` cannot be read: {err}")
        if text.contains("\"JET_CLI_FMT_TEST_ROOT\"") {
            entries["JET_CLI_FMT_TEST_ROOT"] = Dyn.Text(scratch.copy())
            break
        }
    }
    Dyn.Object(entries.copy())
}

write_json: fn(path: String, value: Dyn) -[Env, Exec, FS, IO]> String Never! {
    text: json.to_string_pretty(value) ?? return fail("`{path}` cannot be encoded: {err}")
    files.write(path, "{text}\n") ?? return fail("`{path}` cannot be written: {err}")
    text
}

generate: fn(repo: String, options: Options) -[Env, Exec, FS, IO, Time, Time.Wait]> () {
    head: current_head(repo) ?? return fail(err.message)
    if options.head != head -> return fail("manifest requires its pinned committed source SHA")
    out: if options.out != "" -> options.out.copy() else -> "{scratch_root()}/RegistryRunnerLead/{options.head}"
    if out == repo || out.starts_with("{repo}/") -> return fail("registry outputs belong outside the repository")
    if files.exists("{out}/manifest.json") -> return fail("manifest output already sealed: {out}; choose a fresh --out")
    files.create_dir_all(out) ?? return fail("`{out}` cannot be created: {err}")
    adapter: sys.executable()
    census: inventory(repo)
    manifests: Dyn.Array([Dyn]{Dyn.Object([String: Dyn]{"path": Dyn.Text(SOURCE_LIST), "sha256": Dyn.Text(sha256_file(repo, SOURCE_LIST))})})
    entries := [Dyn]{}
    loop registry in registry_rows(repo, census) {
        row: registry.row
        mode: registry.mode
        standalone: row.package == "JetRuntime" && mode == "test"
        if !standalone {
            if prepare_transport(repo, registry, out, adapter) == .Val(transport) {
                entries.push(transport)
                next
            }
        }
        reason := ""
        if !row.entry && row.names.len() == 0 -> reason = "hand-ABI fixture has no run or Test entry; its exact native/C witness must be registered"
        if row.package == "JetRuntime" && !standalone -> reason = "runtime hand-ABI registries require their native C fixture driver/runtime source assembly; not a compiler Test harness"
        if row.package == "JetBackend" && row.entry -> reason = "backend artifact/FFI registry needs its fixture source assembly plus native artifact execution/checker; a returned fn run is not its success verdict"
        id: registry.id.copy()
        cwd: "{out}/{id}"
        sources: [String]{row.source.copy()}
        if !standalone {
            // Package form: the registry is its own file inside its Tests
            // package, which declares and imports the compiler packages it
            // uses; it runs in place.
            path: "{repo}/{row.source}"
            entry := [String: Dyn]{
                "id": Dyn.Text(id.copy()),
                "package": Dyn.Text(row.package.copy()),
                "mode": Dyn.Text(mode.copy()),
                "kind": Dyn.Text("package"),
                "path": Dyn.Text(path.copy()),
                "cwd": Dyn.Text(cwd.copy()),
                "sha256": Dyn.Text(sha256_file(repo, row.source)),
                "stdout": if mode == "test" -> Dyn.Text(TEST_SCHEMA) else -> Dyn.Null,
                "testCount": Dyn.Int(if mode == "test" -> row.names.len() else -> 1),
                "testNames": if mode == "test" -> texts(row.names) else -> Dyn.Array([Dyn]{}),
                "sources": texts(sources),
                "sourceManifests": texts([String]{SOURCE_LIST}),
            }
            entry["environment"] = registry_environment(repo, cwd, sources)
            if reason != "" {
                entry["status"] = Dyn.Text("BLOCKED")
                entry["reason"] = Dyn.Text(reason.copy())
            }
            entries.push(Dyn.Object(entry.copy()))
            next
        }
        entry := [String: Dyn]{
            "id": Dyn.Text(id.copy()),
            "package": Dyn.Text(row.package.copy()),
            "mode": Dyn.Text(mode.copy()),
            "path": Dyn.Text("{cwd}/registry.jet"),
            "cwd": Dyn.Text(cwd.copy()),
            "sha256": Dyn.Text(row.sha256.copy()),
            "stdout": Dyn.Text(TEST_SCHEMA),
            "testCount": Dyn.Int(row.names.len()),
            "sources": texts(sources),
            "sourceManifests": texts([String]{SOURCE_LIST}),
        }
        entry["environment"] = registry_environment(repo, cwd, sources)
        if reason != "" {
            entry["status"] = Dyn.Text("BLOCKED")
            entry["reason"] = Dyn.Text(reason.copy())
            entries.push(Dyn.Object(entry.copy()))
            next
        }
        text: files.read("{repo}/{row.source}") ?? return fail("`{row.source}` cannot be read: {err}")
        // The source's launch line is a comment once the source no longer
        // starts the file.
        launch: if text.starts_with("#!") -> "//" else -> ""
        body: "\n// [compiler registry source: {row.source}]\n{launch}{strip_imports(text)}\n"
        names: tests_in(body) ?? return fail(err.message)
        entry["sha256"] = Dyn.Text(crypto.sha256(body.bytes()).hex())
        entry["testNames"] = texts(names)
        entry["testCount"] = Dyn.Int(names.len())
        files.create_dir_all(cwd) ?? return fail("`{cwd}` cannot be created: {err}")
        files.write("{cwd}/registry.jet", body) ?? return fail("`{cwd}/registry.jet` cannot be written: {err}")
        files.write("{cwd}/package.jet", REGISTRY_PACKAGE) ?? return fail("`{cwd}/package.jet` cannot be written: {err}")
        entries.push(Dyn.Object(entry.copy()))
    }
    kit: testkit_inventory(repo)
    kit_entry: "{repo}/{KIT_PACKAGE}/package.jet"
    summary: "{{\"PASS\":{kit.cases.len()},\"FAIL\":0,\"KNOWN-FAILING\":0,\"UNEXPECTED-PASS\":0,\"UNSUPPORTED\":0,\"SKIP-HOST\":0,\"OPT-IN\":0,\"REFUSED\":0,\"ERROR\":0,\"TIMEOUT\":0,\"suites\":[\"cases\"]}}\n"
    testkit := [String: Dyn]{
        "id": Dyn.Text("testkit/cases"),
        "package": Dyn.Text("testkit"),
        "mode": Dyn.Text("run"),
        "kind": Dyn.Text("testkit"),
        "path": Dyn.Text(kit_entry.copy()),
        "cwd": Dyn.Text(repo.copy()),
        "sha256": Dyn.Text(sha256_path(kit_entry) ?? return fail(err.message)),
        "stdout": Dyn.Text(summary),
        "testCount": Dyn.Int(kit.cases.len()),
        "sources": texts(kit.sources),
        "caseNames": texts(kit.cases),
    }
    if kit.pending > 0 || kit.rust_tools > 0 {
        testkit["status"] = Dyn.Text("BLOCKED")
        testkit["reason"] = Dyn.Text(if kit.pending > 0 -> "{kit.pending} mandatory user Rust product cases remain RED; see testkit.pendingProductInterop (not retired or excluded)" else -> "full testkit cases have {kit.rust_tools} active Rust tool requirements/guards; removing Rust would skip required case branches. See testkit.rustToolRequirements for exact paths/lines")
    }
    entries.push(Dyn.Object(testkit.copy()))
    after: current_head(repo) ?? return fail(err.message)
    if options.head != after -> return fail("pinned source changed during assembly")
    proof: proof_path(repo)
    proof_tree: read_json(proof) ?? return fail(err.message)
    compiler_retired: retirements(repo).filter(row -> row.path.starts_with("Compiler/")).map(row -> retirement_dyn(row, ""))
    manifest: Dyn.Object([String: Dyn]{
        "head": Dyn.Text(options.head.copy()),
        "completeCompilerRegistries": Dyn.Bool(true),
        "repo": Dyn.Text(repo.copy()),
        "sourceProof": Dyn.Object([String: Dyn]{"path": Dyn.Text(proof.copy()), "sha256": Dyn.Text(sha256_path(proof) ?? return fail(err.message)), "tree": Dyn.Text(text_field(proof_tree, "tree"))}),
        "sourceManifests": manifests,
        "inventory": census_dyn(census),
        "testkit": kit.tree,
        "entries": Dyn.Array(entries.copy()),
        "retiredWithRust": Dyn.Object([String: Dyn]{"testkitCases": Dyn.Array(kit.retired_cases.copy()), "compilerRegistries": Dyn.Array(compiler_retired)}),
    })
    print(write_json("{out}/manifest.json", manifest))
}

// --- run ------------------------------------------------------------------------

// Testkit's one-based I/N convention over the id-sorted manifest; validate the
// full manifest before calling.
partition: fn(entries: [Dyn], shard: String) -> [Dyn] Problem! {
    if shard == "" -> return entries.copy()
    shape: regex.compile("([1-9][0-9]*)/([1-9][0-9]*)") ?? return Err(problem("shard pattern: {err}"))
    if !shape.full_match(shard) -> return Err(problem("invalid registry shard; expected I/N"))
    parts: shard.partition("/")
    index: Int.parse(parts.head) ?? -1
    count: Int.parse(parts.tail) ?? -1
    if index < 1 || count < 1 || index > 9007199254740991 || count > 9007199254740991 || index > count -> return Err(problem("invalid registry shard I/N"))
    sorted := entries.copy()
    sorted.sort_by((left: Dyn, right: Dyn) -> text_field(left, "id") <=> text_field(right, "id"))
    picked := [Dyn]{}
    loop offset in 0..<sorted.len() {
        if offset % count == index - 1 -> picked.push(sorted[offset].copy())
    }
    picked
}

native_runtime: fn(jet: String, runtime: String) -[FS]> Runtime Problem! {
    requested: if runtime != "" -> runtime.copy() else -> "{files.dirname(jet)}/jet-runtime"
    dir: files.canonicalize(requested) ?? return Err(problem("`{requested}` cannot be resolved: {err}"))
    pack: "{dir}/jet_runtime.pack.o"
    object: "{dir}/jet_runtime_jet.o"
    provenance: read_json("{dir}/provenance.json") ?? return Err(err)
    pack_sha: sha256_path(pack) ?? return Err(err)
    object_sha: sha256_path(object) ?? return Err(err)
    if text_field(provenance, "backend") != "jet-native" || int_field(provenance, "rustObjects") != Val(0) || int_field(provenance, "llvmObjects") != Val(0)
        || text_field(provenance, "packSha256") != pack_sha || text_field(provenance, "objectSha256") != object_sha {
        return Err(problem("registry transports require matching Jet-native, zero-Rust/LLVM runtime pack/object provenance"))
    }
    Runtime{dir: dir.copy(), pack: pack, object: object, pack_sha256: pack_sha, object_sha256: object_sha}
}

canonical: fn(value: Dyn) -> String Never! { json.canonical(value) ?? "" }

sorted_texts: fn(items: [String]) -> [String] Never! {
    out := items.copy()
    out.sort()
    out
}

RunTally: struct {
    total: Int
    passed: Int
    blocked: Int
    failed: Int
    entries: [Dyn]
    runtime: Dyn?
    reason: String?
}

receipt_dyn: fn(status: String, header: [String: Dyn], tally: RunTally, shard: String, full_total: Int) -> Dyn Never! {
    entries := header.copy()
    entries["status"] = Dyn.Text(status.copy())
    out := [String: Dyn]{"status": Dyn.Text(status.copy())}
    loop pair in header -> out[pair.key] = pair.value.copy()
    out["total"] = Dyn.Int(tally.total)
    out["passed"] = Dyn.Int(tally.passed)
    out["blocked"] = Dyn.Int(tally.blocked)
    out["failed"] = Dyn.Int(tally.failed)
    out["entries"] = Dyn.Array(tally.entries.copy())
    if shard != "" {
        out["shard"] = Dyn.Text(shard.copy())
        out["fullTotal"] = Dyn.Int(full_total)
    }
    if tally.runtime == .Val(runtime) -> out["runtime"] = runtime.copy()
    if tally.reason == .Val(reason) -> out["reason"] = Dyn.Text(reason.copy())
    Dyn.Object(out.copy())
}

run_registries: fn(repo: String, options: Options) -[Env, Exec, FS, IO, Time, Time.Wait]> () {
    if options.jet == "" || options.manifest == "" -> return fail(USAGE)
    jet: files.canonicalize(options.jet) ?? return fail("`{options.jet}` cannot be resolved: {err}")
    bytes: files.read_bytes(options.manifest) ?? return fail("`{options.manifest}` cannot be read: {err}")
    manifest: read_json(options.manifest) ?? return fail(err.message)
    head: current_head(repo) ?? return fail(err.message)
    entries: array_field(manifest, "entries")
    proof_sha: sha256_path(proof_path(repo)) ?? return fail(err.message)
    if text_field(manifest, "head") != head || text_field(manifest, "repo") != repo || text_field(field(manifest, "sourceProof"), "sha256") != proof_sha
        || field(manifest, "completeCompilerRegistries") != .Bool(true) || entries.len() == 0 {
        return fail("complete pinned-source manifest required")
    }
    // Re-census: a forged or truncated entries array cannot turn omissions into PASS.
    current: inventory(repo)
    required := registry_rows(repo, current).map(row -> row.id.copy())
    required.push("testkit/cases")
    ids: entries.map(entry -> text_field(entry, "id"))
    distinct := [String]{}
    loop id in ids {
        if !distinct.contains(id) -> distinct.push(id.copy())
    }
    if distinct.len() != ids.len() || sorted_texts(ids) != sorted_texts(required) -> return fail("manifest does not account for every current registry")
    if canonical(census_dyn(current)) != canonical(field(manifest, "inventory")) -> return fail("registry source inventory changed since manifest")
    loop source in array_field(manifest, "sourceManifests") {
        path: text_field(source, "path")
        if sha256_file(repo, path) != text_field(source, "sha256") -> return fail("source manifest changed: {path}")
    }
    if canonical(testkit_inventory(repo).tree) != canonical(field(manifest, "testkit")) -> return fail("testkit sources/cases changed since manifest")
    // Partition only after every full-manifest integrity and completeness check.
    selected: partition(entries, options.shard) ?? return fail(err.message)
    receipt_path: if options.receipt != "" -> options.receipt.copy() else -> "{options.manifest}.receipt.json"
    files.create_dir_all(files.dirname(receipt_path)) ?? return fail("`{receipt_path}` cannot be prepared: {err}")
    log_dir: "{receipt_path}.logs"
    files.create_dir_all(log_dir) ?? return fail("`{log_dir}` cannot be created: {err}")
    header: [String: Dyn]{
        "head": Dyn.Text(text_field(manifest, "head")),
        "jet": Dyn.Text(jet.copy()),
        "jetSha256": Dyn.Text(sha256_path(jet) ?? return fail(err.message)),
        "manifestSha256": Dyn.Text(crypto.sha256(bytes).hex()),
        "sourceProof": field(manifest, "sourceProof"),
    }
    tally := RunTally{total: selected.len(), passed: 0, blocked: 0, failed: 0, entries: [Dyn]{}, runtime: None, reason: None}
    loaded := Loaded{runtime: None, error: ""}
    if selected.any(entry -> text_field(entry, "kind") == "transport" && text_field(entry, "status") != "BLOCKED") -> loaded = load_runtime(jet, options.runtime)
    if loaded.runtime == .Val(found) {
        tally.runtime = Val(Dyn.Object([String: Dyn]{"runtimeDir": Dyn.Text(found.dir.copy()), "runtimePack": Dyn.Text(found.pack.copy()), "runtimeObject": Dyn.Text(found.object.copy()), "packSha256": Dyn.Text(found.pack_sha256.copy()), "objectSha256": Dyn.Text(found.object_sha256.copy())}))
    }
    adapter: sys.executable()
    loop entry in selected {
        result := [String: Dyn]{"id": field(entry, "id"), "mode": field(entry, "mode"), "testCount": field(entry, "testCount")}
        if text_field(entry, "status") == "BLOCKED" {
            result["status"] = Dyn.Text("BLOCKED")
            result["reason"] = field(entry, "reason")
            tally.blocked += 1
        } else if text_field(entry, "kind") == "transport" && loaded.error != "" {
            result["status"] = Dyn.Text("BLOCKED")
            result["reason"] = Dyn.Text("runtime prerequisite: {loaded.error}")
            tally.blocked += 1
        } else {
            if run_entry(result, entry, manifest, repo, jet, log_dir, loaded.runtime, adapter) == {
                .Ok(_) -> {
                    result["status"] = Dyn.Text("PASS")
                    tally.passed += 1
                }
                .Err(failure) -> {
                    result["status"] = Dyn.Text("FAIL")
                    result["reason"] = Dyn.Text(failure.message.copy())
                    tally.failed += 1
                }
            }
        }
        tally.entries.push(Dyn.Object(result.copy()))
        write_json(receipt_path, receipt_dyn("FAIL", header, tally, options.shard, entries.len()))
    }
    if current_head(repo) == {
        .Ok(final) -> {
            if final != text_field(manifest, "head") {
                tally.failed += 1
                tally.reason = Val("pinned source changed during registry run: source SHA changed")
            }
        }
        .Err(failure) -> {
            tally.failed += 1
            tally.reason = Val("pinned source changed during registry run: {failure.message}")
        }
    }
    status: if tally.passed == tally.total && tally.blocked == 0 && tally.failed == 0 -> "PASS" else -> "FAIL"
    write_json(receipt_path, receipt_dyn(status, header, tally, options.shard, entries.len()))
    print("{status} compiler registries {tally.passed}/{tally.total}; blocked={tally.blocked} failed={tally.failed}; {receipt_path}")
    process.exit(if status == "PASS" -> 0 else -> 1)
}

Loaded: struct {
    runtime: Runtime?
    error: String
}

load_runtime: fn(jet: String, dir: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Loaded Never! {
    if native_runtime(jet, dir) == {
        .Ok(found) -> Loaded{runtime: Val(found.copy()), error: ""}
        .Err(failure) -> Loaded{runtime: None, error: failure.message.copy()}
    }
}

exit_problem: fn(what: String, ran: ProcessReceipt, timeout_ms: Int) -> String Never! {
    if ran.timed_out -> return "{what} timed out after {timeout_ms} ms"
    if ran.signal == .Val(number) -> return "{what} exit null, signal {number}"
    "{what} exit {ran.code}, signal null"
}

// Execute one manifest entry; `result` gathers the command, logs and report.
run_entry: fn(result: &[String: Dyn], entry: Dyn, manifest: Dyn, repo: String, jet: String, log_dir: String, runtime: Runtime?, adapter: String) Problem! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    mode: text_field(entry, "mode")
    count: int_field(entry, "testCount") ?? 0
    path: text_field(entry, "path")
    kind: text_field(entry, "kind")
    id: text_field(entry, "id")
    if (mode != "run" && mode != "test") || count < 1 || (sha256_path(path) ?? "") != text_field(entry, "sha256") -> return Err(problem("invalid or changed assembled registry"))
    stem: "{log_dir}/{id.replace("/", "_")}"
    timeout_ms: registry_timeout_ms()
    started: time.unix_ns()
    command := [String]{}
    cwd := text_field(entry, "cwd")
    code := Dyn.Null
    signal := Dyn.Null
    stdout := ""
    stderr := ""
    failure := ""
    if kind == "testkit" {
        loop source in array_field(field(manifest, "testkit"), "sources") {
            name: text_field(source, "path")
            if (sha256_path("{repo}/{name}") ?? "") != text_field(source, "sha256") -> return Err(problem("testkit input changed: {name}"))
        }
        evidence: "{stem}.evidence"
        files.create_dir_all(evidence) ?? return Err(problem("`{evidence}` cannot be created: {err}"))
        command = [String]{jet, "test", KIT_PACKAGE, "--profile", KIT_PROFILE}
        cwd = repo.copy()
        settings: [Setting]{Setting{name: "JET_CI_EVIDENCE_DIR", value: evidence.copy()}}
        child: registry_spec(command, repo, repo, settings, timeout_ms).run() ?? return Err(problem("the testkit cases cannot start: {err}"))
        stdout = child.output.copy()
        stderr = child.errors.copy()
        if !child.timed_out && child.signal == None {
            code = Dyn.Int(child.code)
        }
        signal = signal_dyn(child.signal)
        failure = if child.timed_out || child.signal != None || child.code != 0 -> exit_problem("registry", child, timeout_ms) else -> ""
        if failure == "" {
            report: read_json("{evidence}/cases.json") ?? return Err(err)
            rows: array_field(report, "results")
            names: rows.map(row -> text_field(row, "case"))
            expected: array_field(entry, "caseNames").map(name -> if name == .Text(text) -> text.copy() else -> "")
            ran_by: files.realpath(text_field(report, "jet")) ?? ""
            if ran_by != (files.realpath(jet) ?? jet) || rows.len() != count || rows.any(row -> text_field(row, "status") != "PASS") || sorted_texts(names) != sorted_texts(expected) {
                return Err(problem("testkit cases contain missing, non-PASS, skipped, or unexpected outcomes"))
            }
            result["report"] = report
        }
    } else if kind == "transport" {
        found: runtime ?? return Err(problem("runtime prerequisite: no native runtime"))
        ran: run_transport(entry, repo, jet, log_dir, found, adapter) ?? return Err(err)
        command = [String]{"native-registry-transport", path, id}
        code = Dyn.Int(ran.ran.code)
        stdout = ran.ran.stdout.copy()
        stderr = ran.ran.stderr.copy()
        result["transportEvidence"] = Dyn.Array(ran.evidence.copy())
        failure = if ran.ran.code != 0 -> "registry exit {ran.ran.code}, signal null" else -> ""
    } else {
        command = [String]{jet, mode}
        if mode == "test" {
            command.push("--capture=all")
            command.push("--color=never")
        }
        command.push(path)
        sources: array_field(entry, "sources").map(source -> if source == .Text(text) -> text.copy() else -> "")
        environment: field(entry, "environment")
        if canonical(environment) != canonical(registry_environment(repo, cwd, sources)) -> return Err(problem("registry environment changed since manifest"))
        scratch: text_field(environment, "TMPDIR")
        files.create_dir_all(scratch) ?? return Err(problem("`{scratch}` cannot be created: {err}"))
        result["environment"] = environment.copy()
        extra := [Setting]{}
        if environment == .Object(pairs) {
            loop pair in pairs {
                if pair.value == .Text(value) -> extra.push(Setting{name: pair.key.copy(), value: value.copy()})
            }
        }
        child: registry_spec(command, cwd, repo, extra, timeout_ms).run() ?? return Err(problem("the registry cannot start: {err}"))
        stdout = child.output.copy()
        stderr = child.errors.copy()
        if !child.timed_out && child.signal == None -> code = Dyn.Int(child.code)
        signal = signal_dyn(child.signal)
        failure = if child.timed_out || child.signal != None || child.code != 0 -> exit_problem("registry", child, timeout_ms) else -> ""
    }
    files.write("{stem}.stdout", stdout) ?? return Err(problem("`{stem}.stdout` cannot be written: {err}"))
    files.write("{stem}.stderr", stderr) ?? return Err(problem("`{stem}.stderr` cannot be written: {err}"))
    result["command"] = texts(command)
    result["cwd"] = Dyn.Text(cwd.copy())
    result["code"] = code
    result["signal"] = signal
    result["milliseconds"] = Dyn.Int((time.unix_ns() - started) /% 1000000)
    result["stdoutLog"] = Dyn.Text("{stem}.stdout")
    result["stderrLog"] = Dyn.Text("{stem}.stderr")
    if failure != "" -> return Err(problem(failure))
    if mode == "test" {
        reports := [Dyn]{}
        loop line in stdout.split("\n") {
            parsed: json.parse(line) ?? next
            if text_field(parsed, "schema") == text_field(entry, "stdout") -> reports.push(parsed)
        }
        if reports.len() != 1 -> return Err(problem("exact canonical jet.test.v1 success report required"))
        report: reports[0].copy()
        tests: field(report, "tests")
        listed: if tests == .Array(items) -> Val(items.copy()) else -> None
        if field(report, "ok") != .Bool(true) || int_field(report, "failed") != Val(0) || int_field(report, "skipped") != Val(0) || int_field(report, "unexpectedPasses") != Val(0) || listed == None {
            return Err(problem("test report contains failure, skip, or invalid success fields"))
        }
        items: listed ?? [Dyn]{}
        passed: int_field(report, "passed") ?? -1
        expected_failures: int_field(report, "expectedFailures") ?? -1
        if items.len() != count || passed < 0 || expected_failures < 0 || passed + expected_failures != count -> return Err(problem("executed test count does not match registry"))
        ran_names: items.map(test -> text_field(test, "name"))
        names: array_field(entry, "testNames").map(name -> if name == .Text(text) -> text.copy() else -> "")
        if sorted_texts(ran_names) != sorted_texts(names) -> return Err(problem("executed test names do not match complete registry"))
        result["report"] = report
    }
    Ok()
}

// --- JSON fields -----------------------------------------------------------------

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

int_field: fn(tree: Dyn, name: String) -> Int? Never! {
    if field(tree, name) == {
        .Int(value) -> Val(value)
        .Number(lexeme) -> Val(Int.parse(lexeme) ?? return None)
        else -> None
    }
}

array_field: fn(tree: Dyn, name: String) -> [Dyn] Never! {
    if field(tree, name) == .Array(items) -> return items.copy()
    [Dyn]{}
}

// --- tests -------------------------------------------------------------------------

test_repo: fn() -[Env, Exec, FS, IO]> String Never! {
    dir := files.cwd() ?? "/"
    loop {
        if files.exists("{dir}/Tools/agent/ProofSource.jet") -> return dir
        if dir == "/" || dir == "" -> panic("run the test from inside the Jet checkout")
        dir = files.dirname(dir)
    }
}

shard_ids: fn(entries: [Dyn], shard: String) -> [String] Never! {
    (partition(entries, shard) ?? panic("shard {shard}: {err}")).map(entry -> text_field(entry, "id"))
}

#Test("registry shards are deterministic, disjoint and cover the complete manifest") {
    ids: [String]{"Z", "A", "T", "B", "Q", "C", "P"}
    manifest: ids.map(id -> Dyn.Object([String: Dyn]{"id": Dyn.Text(id.copy())}))
    assert_eq(shard_ids(manifest, ""), ids)
    reversed := manifest.copy()
    reversed.reverse()
    loop count in ([Int]{1, 2, 3, 10}) {
        all := [String]{}
        loop index in 1..<(count + 1) {
            picked: shard_ids(manifest, "{index}/{count}")
            assert_eq(shard_ids(reversed, "{index}/{count}"), picked)
            loop id in picked -> all.push(id.copy())
        }
        assert_eq(all.len(), ids.len())
        assert_eq(sorted_texts(all), sorted_texts(ids))
    }
}

#Test("invalid registry shards cannot run a partial manifest") {
    manifest: [Dyn]{Dyn.Object([String: Dyn]{"id": Dyn.Text("A")})}
    loop shard in ([String]{"0/2", "3/2", "1/0", "-1/2", "1", "1/2/3", "1.5/2", "1/9007199254740992"}) {
        if partition(manifest, shard) == {
            .Ok(_) -> panic("shard {shard} was accepted")
            .Err(found) -> assert(found.message.starts_with("invalid registry shard"))
        }
    }
}

#Test("the census reads Test names outside comments and literals only") {
    text: "// #Test(\"commented\")\n/* outer /* #Test(\"nested\") */ */\nx: \"#Test(\\\"quoted\\\")\"\n#Test(\"real \\\"one\\\"\") {{ }}\n#Test (\n  \"spaced\") {{ }}\n"
    assert_eq(tests_in(text) ?? panic("names: {err}"), [String]{"real \"one\"", "spaced"})
    if tests_in("#Test(name) {{ }}\n") == {
        .Ok(_) -> panic("an unnamed Test was accepted")
        .Err(_) -> {}
    }
}

#Test("a standalone registry keeps offsets and drops package and repeated Core imports") {
    text: "use {{\n    files: core.files\n    jet_lex.Token\n}}\nuse files: core.files\nuse compiler_bootstrap.[a,\nb]\nrun: fn() {{ }}\n"
    stripped: strip_imports(text)
    assert_eq(stripped.count_bytes(), text.count_bytes())
    lines: stripped.split("\n").to_list()
    assert_eq(lines[1], "use files: core.files")
    assert_eq(lines[2].trim(), "")
    assert_eq(lines[4].trim(), "")
    assert_eq(lines[5].trim(), "")
    assert_eq(lines[6].trim(), "")
    assert_eq(lines[7], "run: fn() {{ }}")
}

// The registry of a runtime fragment, as registry_rows censuses it.
fragment_registry: fn(name: String) -> Registry Never! {
    source: "Compiler/JetRuntime/Tests/Fragments.fixture/{name}Tests.jet"
    row: Census{package: "JetRuntime", source: source.copy(), sha256: "", names: [String]{}, entry: false, role: "registry"}
    Registry{row: row, id: source.removeprefix("Compiler/").removesuffix(".jet"), mode: "run"}
}

#Test("runtime C transports run their complete witness variants") {
    repo: test_repo()
    loop name in ([String]{"CompilerEnv", "CompilerRoutes", "CompilerNeededJSON", "CompilerNeededURL", "CompilerNeededMathText", "DynNative"}) {
        entry: prepare_transport(repo, fragment_registry(name), "/native/registries", "{repo}{TOOL}") ?? panic("{name}: no transport")
        transport: field(entry, "transport")
        assert_eq(text_field(transport, "type"), "c")
        assert_eq(text_field(transport, "name"), name)
        assert_eq(int_field(entry, "testCount"), Val(1))
        found: specification(transport_key(text_field(entry, "id"))) ?? panic("{name}: no specification")
        out: text_field(entry, "cwd")
        expected: if name == "CompilerEnv" -> [[String]]{[String]{}, [String]{"empty"}} else if name == "CompilerRoutes" -> [[String]]{[String]{out}} else -> [[String]]{[String]{}}
        assert_eq(driver_runs(found, out), expected)
        sources: array_field(entry, "sources")
        if name == "CompilerEnv" || name == "CompilerRoutes" -> assert(sources.contains(Dyn.Text("Compiler/JetRuntime/Tests/{name}Tests.c")))
    }
}

#Test("crypto, codec and process rows are plain transports over their real fixtures") {
    repo: test_repo()
    loop name in ([String]{"CodecCSV", "CodecEnv", "DynCodec", "CompilerFileLeaves", "ProcessExecution", "TerminalProcess", "AgeV1", "CryptoHash", "CryptoOsEntropy", "Sha256"}) {
        entry: prepare_transport(repo, fragment_registry(name), "/native/registries", "{repo}{TOOL}") ?? panic("{name}: no transport")
        found: specification(transport_key(text_field(entry, "id"))) ?? panic("{name}: no specification")
        assert_eq(found.kind, "plain")
        sources: array_field(entry, "sources")
        codec: codec_export(name) != ""
        assert_eq(codec, name.starts_with("Codec") || name.starts_with("Dyn") || name == "CompilerFileLeaves")
        if codec {
            assert_eq(found.witness, "")
            assert_eq(found.fragments, [String]{name})
            assert_eq(found.cflags, FREESTANDING_CFLAGS)
            assert(codec_driver(name, codec_export(name)).contains("{codec_export(name)}("))
        } else {
            assert_eq(found.witness, "Compiler/JetRuntime/Tests/{name}Witness.c")
            assert(sources.contains(Dyn.Text(found.witness.copy())))
        }
        if PROCESS_WITNESSES.contains(name) {
            assert_eq(found.expected_file, "Compiler/JetRuntime/Tests/{name}Witness.stdout")
            assert(found.cflags.contains("-DJET_PROCESS_JET_FIXTURES=1"))
        }
        if CRYPTO.contains(name) {
            assert_eq(found.fragments, CRYPTO)
            loop input in crypto_inputs(name) -> assert(sources.contains(Dyn.Text(input.copy())))
        }
    }
    assert(codec_driver("CompilerFileLeaves", "jet_rt_compiler_file_leaves_fixture").contains("unlink(fixture_path)"))
    assert_eq(crypto_inputs("CryptoOsEntropy"), [String]{"{RT}CryptoOsEntropyFixtures.json", "{RT}CryptoOsEntropyWorld.stderr"})
    assert_eq(crypto_inputs("AgeV1"), [String]{"{RT}AgeV1Fixtures.json"})
    assert_eq(crypto_inputs("Sha256"), [String]{})
}

#Test("a plain transport runs its generated entry driver or its committed C host") {
    repo: test_repo()
    loop name in ([String]{"Alloc", "FilesWalk", "HostParallelism", "TestSuite", "Parallel", "Scheduler", "World", "Sentry", "TestScope", "AllocationPolicy", "Channel", "Stm", "Sync", "Observe", "SharedPublication", "SharedThread", "CollectionsStop"}) {
        entry: prepare_transport(repo, fragment_registry(name), "/native/registries", "{repo}{TOOL}") ?? panic("{name}: no transport")
        transport: field(entry, "transport")
        assert_eq(text_field(transport, "type"), "plain")
        assert_eq(text_field(transport, "runner"), RUNTIME_UNIT_TOOL)
        call: if name == {
            "Alloc" -> "alloc_tests"
            "FilesWalk" -> "files_walk_tests"
            "HostParallelism" -> "host_parallelism_tests"
            else -> ""
        }
        if call != "" {
            assert_eq(text_field(transport, "call"), call)
            assert(field(transport, "witness") == Dyn.Null)
            assert(field(transport, "fragments") == texts([String]{name.copy()}))
            next
        }
        host: if name == {
            "TestSuite" -> "Compiler/JetRuntime/Tests/test-suite-fixture.c"
            "Parallel" | "Scheduler" | "Channel" -> "Compiler/JetRuntime/Tests/{name.lower()}-fixture.c"
            "Stm" | "Sync" | "Observe" -> "Compiler/JetRuntime/Tests/sync-fixture.c"
            "SharedPublication" -> "Compiler/JetRuntime/Tests/shared-publication-fixture.c"
            "SharedThread" -> "Compiler/JetRuntime/Tests/thread-fixture.c"
            "CollectionsStop" -> "Compiler/JetRuntime/Tests/collections-stop.c"
            else -> "Compiler/JetRuntime/Tests/world-sentry-fixture.c"
        }
        assert(field(transport, "call") == Dyn.Null)
        assert_eq(text_field(transport, "witness"), host)
        expected: if name == {
            "TestSuite" -> "test suite: ok\n"
            "Stm" | "Sync" | "Observe" -> sync_expected(name)
            "SharedPublication" -> "Shared World race/loser once/register once/reset owner only ok\nShared Process race/loser once/no World registration ok\n"
            "CollectionsStop" -> collections_stop_expected()
            else -> ""
        }
        assert_eq(text_field(transport, "expected"), expected)
        sources: array_field(entry, "sources")
        assert(sources.contains(Dyn.Text(host)))
        // Every composed fragment and every linked host pins the row.
        fragments: if name == {
            "Stm" -> [String]{"Channel", "Stm"}
            "Sync" -> [String]{"Channel", "Stm", "Sync"}
            "Observe" -> [String]{"Channel", "Stm", "Sync", "Observe"}
            "SharedPublication" -> [String]{"Channel", "SharedPublication"}
            "CollectionsStop" -> [String]{"Collections", "CollectionsStop"}
            "SharedThread" -> [String]{"Thread", "SharedThread"}
            else -> if WORLD_SENTRY.contains(name) -> WORLD_SENTRY.copy() else -> [String]{name.copy()}
        }
        assert(field(transport, "fragments") == texts(fragments))
        loop fragment in fragments -> assert(sources.contains(Dyn.Text("Compiler/JetRuntime/Tests/Fragments.fixture/{fragment}Tests.jet")))
        if WORLD_SENTRY.contains(name) {
            loop linked in WORLD_SENTRY_LINKED -> assert(sources.contains(Dyn.Text("Compiler/JetRuntime/Tests/{linked}.c")))
        }
        assert_eq(sources.contains(Dyn.Text("Compiler/JetRuntime/Tests/shared-weak-fixture.c")), name == "SharedPublication")
        cflags: if name == {
            "Channel" -> [String]{"-O2", "-DJET_CHANNEL_INTERNAL"}
            "SharedThread" -> [String]{"-DJET_SHARED_TLS_FIXTURE"}
            "CollectionsStop" -> [String]{"-Wall", "-Wextra", "-Werror"}
            "Sync" -> [String]{"-std=c11", "-Wall", "-Wextra", "-Werror", "-DJET_CONDITION_FIXTURE"}
            "Observe" -> [String]{"-std=c11", "-Wall", "-Wextra", "-Werror", "-DJET_CONDITION_FIXTURE", "-DJET_OBSERVE_FIXTURE"}
            else -> [String]{"-std=c11", "-Wall", "-Wextra", "-Werror"}
        }
        assert(field(transport, "cflags") == texts(cflags))
    }
}

#Test("the collections stop row instruments only the iterator source and expects every family") {
    iter: "// [unit source: Compiler/JetRuntime/Source/Iter.jet]\nx: jet_rt_free(a)\njet_rt_progress_state_advance(state)\n"
    unit: "head jet_rt_free(h)\n{iter}// [unit source: Compiler/JetRuntime/Source/Text.jet]\njet_rt_free(t)\njet_rt_progress_state_advance(t)\n"
    instrumented: collections_stop_unit(unit) ?? panic(err.message)
    assert_eq(instrumented, "head jet_rt_free(h)\n// [unit source: Compiler/JetRuntime/Source/Iter.jet]\nx: coll_stop_free(a)\ncoll_stop_progress_advance(state)\n// [unit source: Compiler/JetRuntime/Source/Text.jet]\njet_rt_free(t)\njet_rt_progress_state_advance(t)\n")
    loop refused in ([String]{"// [unit source: Compiler/JetRuntime/Source/Text.jet]\njet_rt_free(t)\n", "// [unit source: Compiler/JetRuntime/Source/Iter.jet]\njet_rt_free(a)\n"}) {
        if collections_stop_unit(refused) == {
            .Ok(_) -> panic("a unit without both iterator calls was instrumented")
            .Err(_) -> {}
        }
    }
    lines: collections_stop_expected().split("\n").to_list()
    assert_eq(lines.len(), 25)
    assert_eq(lines[0], "family 0: live payloads restored")
    assert_eq(lines[12], "family 12: live payloads restored")
    assert_eq(lines[13], "review 0: live payloads restored")
    assert_eq(lines[23], "review 10: live payloads restored")
    assert_eq(lines[24], "")
}

#Test("a transport entry keeps its registry id and a runner row runs its calls") {
    repo: test_repo()
    fragment: prepare_transport(repo, fragment_registry("Alloc"), "/native/registries", "{repo}{TOOL}") ?? panic("Alloc: no transport")
    assert_eq(text_field(fragment, "id"), "JetRuntime/Tests/Fragments.fixture/AllocTests")
    assert_eq(transport_key("JetRuntime/Tests/Fragments.fixture/AllocTests"), "JetRuntime/Tests/AllocTests")
    row: Census{package: "JetRuntime", source: "Compiler/JetRuntime/Tests/UiWitness.jet", sha256: "", names: [String]{"t"}, entry: true, role: "registry"}
    entry: prepare_transport(repo, Registry{row: row, id: "JetRuntime/Tests/UiWitness.run", mode: "run"}, "/native/registries", "{repo}{TOOL}") ?? panic("UiWitness: no transport")
    assert_eq(text_field(entry, "id"), "JetRuntime/Tests/UiWitness.run")
    transport: field(entry, "transport")
    assert_eq(text_field(transport, "type"), "runner")
    assert_eq(text_field(transport, "runner"), "Compiler/JetRuntime/Tests/UiWitness.jet")
    assert_eq(array_field(transport, "calls").len(), 6)
    assert(array_field(entry, "sources").contains(Dyn.Text("Compiler/JetRuntime/Tests/UiKeyWitness.c")))
    loop name in ([String]{"RunDuration", "RunIntWiden", "RunExecutionFixtures", "StopWitness"}) {
        found: specification("JetRuntime/Tests/{name}") ?? panic("{name}: no specification")
        assert_eq(found.kind, "runner")
        assert(found.calls.all(call -> call.expected.ends_with("\n")))
    }
}

#Test("process-edge goldens decode the committed runtime report literals") {
    repo: test_repo()
    assert_eq(trap_literal(repo, "trap_msg_header_panic") ?? panic(err.message), "Stop [E3001]: `panic: ")
    assert_eq(trap_literal(repo, "trap_msg_prelude_end") ?? panic(err.message), "`\n  --> <core.prelude>:0\n")
    assert_eq(scheduler_literal(repo, "scheduler_msg_cancelled") ?? panic(err.message), "task cancelled at a cooperative wait point")
    assert((trap_literal(repo, "trap_footer_e3001") ?? panic(err.message)).starts_with(" Why: The program hit a `panic`"))
    assert_eq(static_text_literal("rt_static_text(\"a\\\\b\\\"c{{{{d}}}}\\n\")", "escapes") ?? panic(err.message), "a\\b\"c{{d}}\n")
    if trap_literal(repo, "trap_msg_no_such_literal") == {
        .Ok(_) -> panic("a missing trap literal decoded")
        .Err(_) -> {}
    }
}
