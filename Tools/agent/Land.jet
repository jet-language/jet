    assert_eq(results_counts("{{\"schema\":1,\"counts\":{{\"pass\":3,\"fail\":1}},\"rows\":[]}}"), "{{\"pass\":3,\"fail\":1}}")
    assert_eq(results_counts("{{\"rows\":[]}}"), "")
}

#Test("a release gate run becomes one batch-log line") {
    assert_eq(train_verdict(0, "x\nPASS: a0.0.34 ready\n", "0123456789abcdef", "/w/t.log"), "RELEASE READY a0.0.34 from 0123456789; run the commands in /w/t.log")
    assert_eq(train_verdict(1, "FAIL: gains 3 < 10\nFAIL: rows\n", "0123456789abcdef", "/w/t.log"), "release gate 0123456789: not released (gains 3 < 10; rows)")
    assert_eq(train_verdict(2, "boom\n", "0123456789abcdef", "/w/t.log"), "release gate 0123456789: could not start rc=2 (boom)")
}

#Test("a checker or assembler file, or no file, reaches every area; else the areas whose sources hold one") {
    areas: [String]{"CLI", "NixEval", "Trust"}
    sources: [[String]]{[String]{"Jetpack/CLI/Source/Main.jet", "Jetpack/Trust/Source/Key.jet"}, [String]{"Jetpack/NixEval/Source/Eval.jet"}, [String]{"Jetpack/Trust/Source/Key.jet"}}
    assert_eq(areas_reached(areas, [[String]]{}, [String]{"Core/Text/Fmt.jet"}), areas)
    assert_eq(areas_reached(areas, [[String]]{}, [String]{"Jetpack/Bootstrap/Assemble.jet"}), areas)
    assert_eq(areas_reached(areas, [[String]]{}, [String]{}), areas)
    assert_eq(areas_reached(areas, sources, [String]{"Jetpack/Trust/Source/Key.jet"}), [String]{"CLI", "Trust"})
    assert_eq(areas_reached(areas, sources, [String]{"Tools/agent/Land.jet"}), [String]{})
}

#Test("an area's cap is its peak and a fifth plus the margin; unmeasured counts AREA_UNMEASURED") {
    assert_eq(area_cap(1000), 1200 + AREA_MARGIN)
    assert_eq(area_cap(0), AREA_UNMEASURED + AREA_UNMEASURED /% 5 + AREA_MARGIN)
}

#Test("an area the cap killed checks again alone under the budget, or the forced cap, when that is larger (#6761)") {
    assert_eq(area_again(6 * GIB, 0, 20 * GIB), 20 * GIB)
    assert_eq(area_again(6 * GIB, 0, 6 * GIB), 0)
    assert_eq(area_again(6 * GIB, 0, 0), 0)
    assert_eq(area_again(GIB, GIB, 20 * GIB), 0)
    assert_eq(area_again(GIB, 2 * GIB, 20 * GIB), 2 * GIB)
    assert_eq(cap_of([String]{"CLI", "JetOS"}, [Int]{7, 6}, "JetOS"), 6)
    assert_eq(cap_of([String]{"CLI"}, [Int]{7}, "Nix"), AREA_UNMEASURED)
    assert_eq(peak_after(5 * GIB, GIB, 1), 5 * GIB)
    assert_eq(peak_after(5 * GIB, 6 * GIB, 1), 6 * GIB)
    assert_eq(peak_after(5 * GIB, GIB, 0), GIB)
}

#Test("areas pack largest first into lanes under the budget, the rest join the least loaded lane") {
    lanes: pack_lanes([String]{"D", "A", "B", "E", "C"}, [Int]{1, 4, 4, 1, 4}, 9)
    assert_eq(lanes.len(), 3)
    assert_eq(lanes[0].areas, [String]{"A", "C"})
    assert_eq(lanes[0].width, 4)
    assert_eq(lanes[0].load, 8)
    assert_eq(lanes[1].areas, [String]{"B"})
    assert_eq(lanes[2].areas, [String]{"D", "E"})
    assert_eq(lanes[2].width, 1)
    one: pack_lanes([String]{"Big"}, [Int]{20}, 9)
    assert_eq(one.len(), 1)
    assert_eq(pack_lanes([String]{}, [Int]{}, 9).len(), 0)
    assert_eq(pack_lanes([String]{"A", "B"}, [Int]{4, 4}, 0).len(), 1)
    assert_eq(area_budget(33 * GIB), 21 * GIB)
    assert_eq(area_budget(60 * GIB), AREA_BUDGET_MAX)
    assert_eq(area_budget(8 * GIB), 0)
}

#Test("a guard shard fails on a FAIL line or a missing tally") {
    assert_eq(guard_failures("a: pass\nb c: FAIL\n3 passed, 1 failed\n"), [String]{"  FAIL b c"})
    assert_eq(guard_failures("a: pass\n1 passed, 0 failed\n"), [String]{})
    assert_eq(guard_failures("a: pass\n36 passed, 0 failed, 0 skipped\n"), [String]{})
    assert_eq(guard_failures("a: pass\n0 passed, 0 failed, 0 skipped, 1 expected-fail\n"), [String]{})
    assert_eq(guard_failures("a: pass\n"), [String]{"  did not finish (no `N passed, M failed` tally)"})
    shards: [PassRun]{PassRun{name: "guards", rc: 0, seconds: 70, peak: 0, note: "shard 1/2 rc=0", lines: [String]{}}, PassRun{name: "guards", rc: 1, seconds: 90, peak: 0, note: "shard 2/2 rc=1", lines: [String]{"  FAIL x"}}}
    run: guards_run(shards)
    assert_eq(run.rc, 1)
    assert_eq(run.seconds, 90)
    assert_eq(run.lines, [String]{"guards rc=1 shards=2", "  shard 2/2 rc=1:", "  FAIL x"})
}

#Test("area peaks keep the last row per area and skip malformed rows") {
    peaks: read_peaks("A\t10\nbad\nB\t0\nA\t12\nC\t7\n")
    assert_eq(peak_rows(peaks), "A\t12\nC\t7\n")
    assert_eq(peak_of(peaks, "C"), 7)
    assert_eq(peak_of(peaks, "B"), 0)
    assert_eq(peak_rows(with_peak(peaks, "C", 9)), "A\t12\nC\t9\n")
}

#Test("phases.tsv lists the passes in pass order, then the areas; a pass not run counts nowhere") {
    runs: [PassRun]{
        PassRun{name: "area:CLI", rc: 0, seconds: 50, peak: 4194304, note: "cap 4M", lines: [String]{}},
        PassRun{name: "selfcheck", rc: 1, seconds: 30, peak: 0, note: "cap 12G", lines: [String]{}},
        PassRun{name: "", rc: 0, seconds: 0, peak: 0, note: "", lines: [String]{}},
        PassRun{name: "check", rc: 0, seconds: 90, peak: 0, note: "cap 12G", lines: [String]{}},
    }
    assert_eq(phase_rows(runs), "phase\tseconds\trc\tpeak_mb\tnote\ncheck\t90\t0\t0\tcap 12G\nselfcheck\t30\t1\t0\tcap 12G\narea:CLI\t50\t0\t4\tcap 4M\n")
    assert_eq(census_rc(runs), 1)
    assert_eq(census_rc([PassRun]{PassRun{name: "", rc: 1, seconds: 0, peak: 0, note: "", lines: [String]{}}}), 0)
    assert(pass_clean(runs, "check"))
    assert(!pass_clean(runs, "selfcheck"))
    assert(!pass_clean(runs, "build"))
}
