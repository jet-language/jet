#!/usr/bin/env jet
// Land patches on a checkout, queue them for the landing service, run that
// service, publish what it landed, and run the collect-all census that admits
// compiler commits and expensive launches.
//
//   jet Tools/agent/Land.jet land [--scratch-copy DIR] PATCH MSG [PATCH MSG]...
//   jet Tools/agent/Land.jet queue LANE BASE...
//   jet Tools/agent/Land.jet census [FILE]...
//   jet Tools/agent/Land.jet precommit FILE...
//   jet Tools/agent/Land.jet prescreen PATCH [EARLIER_PATCH]...
//   jet Tools/agent/Land.jet receipt identity TREE
//   jet Tools/agent/Land.jet receipt check LAUNCHER TREE SEED_DIR
//   jet Tools/agent/Land.jet receipt commit LAUNCHER REPO COMMIT SEED_DIR
//   jet Tools/agent/Land.jet serve
//   jet Tools/agent/Land.jet batch LIST
//   jet Tools/agent/Land.jet publish latest | base COMMIT | jetpack COMMIT
//   jet Tools/agent/Land.jet release-train SHA
//
// `land` commits a stack of patches on the checkout it runs in, one commit
// per patch, with the message in the MSG file after it. The checkout must
// have no tracked changes. Every patch is applied in order, the patched tree
// passes the lane check (Tools/agent/LaneCheck.jet with $JET, else `jet` on
// PATH), and only then are the commits built in a private index and
// published with one compare-and-swap of HEAD. A patch that does not apply,
// or a failed check, puts the worktree back as it was and leaves HEAD where
// it was. The lane check covers the whole compiler and Jetpack's assembly
// when a patch touches Compiler, Core, Jetpack or a sources.list, and
// otherwise every .jet file the patches leave behind. The landing service
// (`serve`) runs the full census before it commits; `land`
// is the direct path for a checkout with no service, such as a fresh clone.
//
// `--scratch-copy DIR` clones the checkout into DIR first (DIR must not
// exist), copies the checkout's git user.name and user.email into the clone,
// and lands there. The checkout itself is not touched.
//
// `queue` adds land jobs for the landing service: each BASE names BASE.patch
// and BASE.msg, queued in order as one lane's stack. The stack must apply in
// order on HEAD of $JET_DEV_WORKTREE (else this checkout); that is checked in
// a temporary index, so the worktree is not touched. Speed lanes must carry a
// Pareto line in each message (owner order: Pareto work first):
//   `PARETO: <wall seconds> s`     a measured same-run wall saving >= 0.5 s;
//   `PARETO-STAGE: <design>`       a stage of an approved >= 1.5 s design;
//   `SMALL-WIN: <wall seconds> s`  a smaller win, accepted only while the lane
//                                  has an approved design in the Pareto list
//                                  ($PARETO_APPROVED, else
//                                  $JET_SCRATCH_ROOT/lanes/Main/pareto-approved.txt).
// Jobs go to $JET_RUN_ROOT/land-queue/<epoch>-<lane>[n].job.
//
// `census` is the collect-all preflight (AGENTS.md) of a snapshot: HEAD of
// $JET_DEV_WORKTREE (CENSUS_COMMIT names another commit) plus the named
// worktree files, so other lanes' uncommitted work never enters it; a named
// file the worktree no longer has is deleted from the snapshot. In package
// form in the snapshot, with the seed ($JET_SEED, else CENSUS_JET_DIR):
// `jet check Compiler/JetCli` (sema of the CLI and every package it depends
// on), then `jet build Compiler` in the dev shell (optimize, lowering,
// object and link rows; it also makes the runtime pack the new compiler
// lowers, as chain s1 does, and regenerates the sources git keeps, which
// must come out as committed or the census prints STALE), then that
// compiler's own `jet check Compiler/JetCli` (as
// chain s2 does) and its `jet check Core` (every Core body, called or not;
// it moves to the seed's check once the seed carries `jet check Core`), each
// with keep-going and every row of its report listed at its file:line. Each
// pass runs with its own memory cap (HEAVY_MEMORY).
// CENSUS_BUILD=0 stops after the check, CENSUS_SELFCHECK=0 before the
// self-checks. Output: $JET_SCRATCH_ROOT/discovery/r14/{snap,census}. A clean
// census of every pass writes the snapshot's preflight receipt, which
// `Tools/agent/Chain.jet TREE full` and Tools/release `admit` and `build` require.
// Exit: 0 clean; 1 rows or a failed pass; 2 setup failure.
//
// `precommit` runs the census for a commit touching FILE... when one of them
// is a compiler input (or a runtime, backend, Core or Jetpack source or a
// sources.list), with every pass, then, for every commit, the repository
// ratchets `--check` in the worktree with the seed, RATCHET_JOBS at once
// (RATCHETS: the unsafe-region baseline in Docs/spec/safety.md, the Core
// coverage list, and every generator with committed output that is not a
// step of `jet build Compiler`: the diagnostic, Core source, owned-trait and
// vocabulary rows, the lexical ledger, the collation table, the runtime
// tables and the Unicode tables). Every pass runs and reports its rows; it
// prints PRECOMMIT OK or PRECOMMIT FAILED.
//
// `ratchets` prints RATCHETS, one tool per line, for a lander that runs them
// itself.
//
// `prescreen` is the lander's admission check of one job: PATCH, after the
// EARLIER_PATCHes already admitted, applied to an export of HEAD, then the
// seed's keep-going `jet check Compiler/JetCli` when the patches touch a
// compiler input. Exit: 0 clean; 1 check rows (printed); 3 does not apply.
//
// `receipt` reads preflight receipts ($JET_STATE_ROOT/preflight/<sha256 of
// the source identity>.json). `identity` prints TREE's compiler source
// identity (Tools/agent/CompilerPackages.jet identity); `check` admits a
// launch of TREE by the seed SEED_DIR, and
// `commit` one of COMMIT of the checkout REPO (from an export of it). Each
// prints `LAUNCHER: admitted by ...` (exit 0) or the refusal, which names the
// census to run (exit 1); exit 2 is a setup failure.
//
// `serve` is the landing service, run from the tools checkout. Every minute
// it takes the jobs `queue` wrote, admits each one (`prescreen`: all at once
// when HEAD with every queued patch checks clean, else one by one after the
// ones admitted before it), lands the admitted jobs as one `batch` and, when
// the batch fails, bisects it: every clean half lands, and a failing job, or
// the rest of its lane's stack, goes back to its lane. Each job's verdict is
// $JET_RUN_ROOT/land-results/<job>.result (LANDED <sha>, STALE or REJECTED
// with the rows); the service log is $JET_RUN_ROOT/lander.log. It waits while
// the dev worktree has tracked changes and exits when
// $JET_RUN_ROOT/lander.stop exists.
//
// `batch` lands the jobs of LIST (`LANE<TAB>MSG<TAB>PATCH[<TAB>NAME]` lines,
// absolute paths) on $JET_DEV_WORKTREE under $JET_RUN_ROOT/commit.lock with
// one verification: every patch that applies (a patch already on dev is
// skipped; a lane's later patches are left once one does not apply), the
// regenerated views and runtime generator outputs, then one seed `precommit`
// of every path. Patches that share a file land as one commit. The commits
// are built in a private index and published with one compare-and-swap of
// HEAD; a failed precommit or commit leaves HEAD and the worktree as they
// were. A landed batch is then published (`publish latest`, then `publish
// base` of HEAD) and handed to the release train. The report is
// $JET_RUN_ROOT/batch-land.log. Exit: 0 landed or nothing applied; 2 setup
// failure; 3 the worktree has tracked changes; 5 precommit failed; 6 the
// commits could not be made.
//
// `publish latest` makes the batch-verified census compiler (with a runtime
// pack) $JET_SCRATCH_ROOT/discovery/b2/install-latest. `publish base COMMIT`
// keeps install-latest, which must say COMMIT, as $JET_BASE_ROOT/<sha> for
// lanes (base/latest is the newest), seeds it into the chain stage store,
// gives it the jetpack of an input-identical published commit, and wants its
// golden census: a golden worker (a user unit) runs the newest wanted one in
// a build slot, then builds the commit's jetpack when none could be reused.
// `publish jetpack COMMIT` (inside a build slot) gives a published base its
// jetpack.
//
// `release-train SHA` records SHA as the newest pending dev HEAD and, unless
// $JET_RELEASE_WORK/paused exists, starts the release train (a user unit):
// one train at a time gates the newest pending HEAD with
// `Tools/release/Main.jet -- admit` and writes its verdict to the batch log.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

SPEED_LANES: [String]{"O0Speed", "RustOut"}
COMPILER_PREFIXES: [String]{"Compiler/", "Core/", "Jetpack/"}
IDENTITY_KEYS: [String]{"user.name", "user.email"}
JOB_FILES: [String]{".patch", ".msg"}
// The preflight receipt: its schema, the census passes it vouches for, and
// the trees an export needs for the source identity.
RECEIPT_SCHEMA: "jet.preflight-receipt.v1"
RECEIPT_PASSES: [String]{"check", "build", "runtime-pack", "selfcheck", "selfcheck-core"}
IDENTITY_TREES: [String]{"Compiler", "Core", "Jetpack"}
// The generated CoreSourceRows views: a patch whose only conflict is in them
// is admitted around them (the batch regenerates them from its sources).
GENERATED_VIEWS: [String]{"Compiler/JetCli/Source/Cli/CoreSources.jet", "Compiler/JetCli/Source/Cli/CoreStructureRows.jet", "Compiler/JetFoundation/Source/Registry/CoreCallRows.jet", "Compiler/JetFoundation/Source/Registry/CoreEnumRows.jet", "Compiler/JetFoundation/Source/Registry/CoreSourceOwned.jet", "Compiler/JetFoundation/Source/Registry/EffectVocabulary.jet"}
// Every heavy pass: its memory capped at HEAVY_MEMORY in its own systemd scope
// (the whole process tree, the runtime pack's steps among them, shares the
// cap; an address-space limit would count the fibers' reserved stacks, not
// memory), low priority, pinned CPUs and the compiler's 1 GiB stack.
HEAVY_MEMORY: "32G"
HEAVY_CPUS: "16-27"
HEAVY_STACK: "--stack=1073741824:1073741824"
// The ratchets every commit keeps, each run as `jet TOOL --check`, and how
// many run at once.
RATCHETS: [String]{
    "Tools/agent/UnsafeRatchet.jet",
    "Tools/agent/CoreCoverage.jet",
    "Tools/agent/DiagnosticRows.jet",
    "Tools/agent/CoreSourceRows.jet",
    "Tools/agent/OwnedTraitRows.jet",
    "Tools/agent/VocabularyRows.jet",
    "Tools/agent/LexicalLedger.jet",
    "Tools/agent/CollationTable.jet",
    "Tools/agent/RuntimeGenerators.jet",
    "Tools/agent/UnicodeTables.jet",
}
RATCHET_JOBS: 5

run: fn() {
    args: process.args()
    if args.len() == 0 -> usage()
    // Every git call names its index itself; an index inherited from the
    // caller would point the checkout's own commands at someone else's.
    sys.unset("GIT_INDEX_FILE") ?? false
    rest: args[1..<args.len()]
    code: if args[0] == {
        "land" -> land_main(rest)
        "queue" -> queue_main(rest)
        "census" -> census_main(rest)
        "precommit" -> precommit_main(rest)
        "ratchets" -> ratchets_main(rest)
        "prescreen" -> prescreen_main(rest)
        "receipt" -> receipt_main(rest)
        "serve" -> serve_main(rest)
        "batch" -> batch_main(rest)
        "publish" -> publish_main(rest)
        "release-train" -> release_train_main(rest)
        else -> usage()
    }
    process.exit(code)
}

usage: fn() -[Exec, IO]> Never {
    term.eprint("usage: jet Tools/agent/Land.jet land [--scratch-copy DIR] PATCH MSG [PATCH MSG]...")
    term.eprint("       jet Tools/agent/Land.jet queue LANE BASE...")
    term.eprint("       jet Tools/agent/Land.jet census [FILE]...")
    term.eprint("       jet Tools/agent/Land.jet precommit FILE...")
    term.eprint("       jet Tools/agent/Land.jet ratchets")
    term.eprint("       jet Tools/agent/Land.jet prescreen PATCH [EARLIER_PATCH]...")
    term.eprint("       jet Tools/agent/Land.jet receipt identity TREE")
    term.eprint("       jet Tools/agent/Land.jet receipt check LAUNCHER TREE SEED_DIR")
    term.eprint("       jet Tools/agent/Land.jet receipt commit LAUNCHER REPO COMMIT SEED_DIR")
    term.eprint("       jet Tools/agent/Land.jet serve")
    term.eprint("       jet Tools/agent/Land.jet batch LIST")
    term.eprint("       jet Tools/agent/Land.jet publish latest | base COMMIT | golden-worker | golden-run | jetpack COMMIT")
    term.eprint("       jet Tools/agent/Land.jet release-train SHA | --run")
    process.exit(64)
}

// --- processes --------------------------------------------------------------

Ran: struct {
    code: Int
    output: String
    errors: String
}

// `argv` run in `dir`, with GIT_INDEX_FILE set to `index` unless it is "".
run_in: fn(dir: String, argv: [String], index: String) -[Exec, Time.Wait]> Ran Never! {
    spec := process.cmd(argv).cwd(dir).output_limit(268435456)
    if index != "" -> spec = spec.env("GIT_INDEX_FILE", index)
    receipt: spec.run() ?? return Ran{code: 127, output: "", errors: "{argv[0]}: {err}"}
    code: if receipt.signal == .Val(_) -> 128 else -> receipt.code
    Ran{code: code, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

git: fn(dir: String, args: [String]) -[Exec, Time.Wait]> Ran Never! {
    argv := [String]{"git"}
    argv.extend(args.copy())
    run_in(dir, argv, "")
}

git_index: fn(dir: String, index: String, args: [String]) -[Exec, Time.Wait]> Ran Never! {
    argv := [String]{"git"}
    argv.extend(args.copy())
    run_in(dir, argv, index)
}

// The first line of a command's error output, else of its output.
first_line: fn(ran: Ran) -> String Never! {
    text: if ran.errors.trim() != "" -> ran.errors.trim() else -> ran.output.trim()
    text.partition("\n").head.copy()
}

env_or: fn(name: String, fallback: String) -[Env]> String Never! {
    value: process.env_get(name) ?? return fallback.copy()
    if value == "" -> return fallback.copy()
    value
}

// The jet binary the lane check runs: $JET, else the first `jet` file on
// PATH, as an absolute path (LaneCheck.jet needs a binary path, not a
// command name); "jet" when neither names one.
jet_binary: fn() -[Env, FS]> String Never! {
    named: env_or("JET", "jet")
    if named.contains("/") -> return files.canonicalize(named) ?? named.copy()
    loop dir in env_or("PATH", "").split(":") {
        if dir == "" -> next
        candidate: files.join(dir, named)
        if files.is_file(candidate) -> return files.canonicalize(candidate) ?? candidate.copy()
    }
    named.copy()
}

// --- roots (Tools/agent/roots.sh) -------------------------------------------

// The value `${XDG_CONFIG_HOME:-~/.config}/jet/env` assigns to `name`, the
// file the shell tools source first.
env_file_value: fn(name: String) -[Env, FS]> String? Never! {
    home: env_or("HOME", "")
    path: "{env_or("XDG_CONFIG_HOME", "{home}/.config")}/jet/env"
    text: files.read(path) ?? return None
    found := ""
    seen := false
    loop raw in text.lines() {
        line: raw.trim().removeprefix("export ").trim()
        parts: line.partition("=")
        if parts.sep == "" || parts.head != name -> next
        value := parts.tail
        quoted: (value.starts_with("\"") && value.ends_with("\"")) || (value.starts_with("'") && value.ends_with("'"))
        if value.len() >= 2 && quoted -> value = value.removeprefix("\"").removesuffix("\"").removeprefix("'").removesuffix("'")
        found = value.replace("$HOME", home)
        seen = true
    }
    if seen -> Val(found) else -> None
}

root: fn(name: String, fallback: String) -[Env, FS]> String Never! { env_or(name, env_file_value(name) ?? fallback) }

state_root: fn() -[Env, FS]> String Never! { root("JET_STATE_ROOT", "{env_or("XDG_CACHE_HOME", "{env_or("HOME", "")}/.cache")}/jet-dev") }

scratch_root: fn() -[Env, FS]> String Never! { root("JET_SCRATCH_ROOT", state_root()) }

run_root: fn() -[Env, FS]> String Never! { root("JET_RUN_ROOT", "{scratch_root()}/run") }

// The top of the checkout the command runs in, "" outside one.
checkout_top: fn() -[Exec, FS, Env, Time.Wait]> String Never! {
    here: files.cwd() ?? return ""
    top: git(here, [String]{"rev-parse", "--show-toplevel"})
    if top.code != 0 -> return ""
    top.output.trim()
}

absolute: fn(path: String) -[FS, Env]> String Never! { files.absolute(path) ?? path.copy() }

// --- patches ----------------------------------------------------------------

// The paths a patch touches (`git apply --numstat -z`): each changed path,
// and both sides of a rename.
touched_paths: fn(dir: String, patch: String) -[Exec, Time.Wait]> [String] Never! {
    stat: git(dir, [String]{"apply", "--numstat", "-z", patch})
    paths := [String]{}
    if stat.code != 0 -> return paths
    fields: nul_fields(stat.output)
    index := 0
    loop {
        if index >= fields.len() -> break
        field: fields[index]
        index += 1
        if field == "" -> next
        // `added<TAB>deleted<TAB>path`, or `added<TAB>deleted<TAB>` followed by
        // the old and the new path of a rename.
        counts: field.partition("\t")
        name: counts.tail.partition("\t").tail
        if name != "" {
            if !paths.contains(name) -> paths.push(name.copy())
            next
        }
        loop _ in 0..<2 {
            if index < fields.len() && !paths.contains(fields[index]) -> paths.push(fields[index].copy())
            index += 1
        }
    }
    paths
}

nul_fields: fn(text: String) -> [String] Never! {
    fields := [String]{}
    current := [U8]{}
    loop byte in text.bytes() {
        if Int.from_u8(byte) == 0 {
            fields.push(String.from_bytes_lossy(current))
            current = [U8]{}
            next
        }
        current.push(byte)
    }
    if current.len() > 0 -> fields.push(String.from_bytes_lossy(current))
    fields
}

compiler_input: fn(path: String) -> Bool Never! {
    if path.ends_with("sources.list") -> return true
    loop prefix in COMPILER_PREFIXES {
        if path.starts_with(prefix) -> return true
    }
    false
}

// --- land -------------------------------------------------------------------

Pair: struct {
    patch: String
    message: String
}

#Error
LandError: struct {
    message: String
}

land_main: fn(args: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    copy_dir := ""
    positional := [String]{}
    index := 0
    loop {
        if index >= args.len() -> break
        arg: args[index]
        index += 1
        if arg == "--scratch-copy" {
            if index >= args.len() -> usage()
            copy_dir = absolute(args[index])
            index += 1
            next
        }
        positional.push(arg.copy())
    }
    if positional.len() == 0 || positional.len() % 2 != 0 -> usage()
    pairs := [Pair]{}
    loop at in 0..<(positional.len() /% 2) {
        patch: absolute(positional[at * 2])
        message: absolute(positional[at * 2 + 1])
        needed: [String]{patch, message}
        loop path in needed {
            if !files.exists(path) {
                term.eprint("land: no file {path}")
                return 2
            }
        }
        pairs.push(Pair{patch: patch, message: message})
    }
    source: checkout_top()
    if source == "" {
        term.eprint("land: run this inside a git checkout")
        return 2
    }
    if copy_dir == "" -> return land(source, pairs)
    target: scratch_copy(source, copy_dir) ?? {
        term.eprint("land: {err.message}")
        return 2
    }
    land(target, pairs)
}

// Clone `source` into `dir` with the checkout's commit identity.
scratch_copy: fn(source: String, dir: String) -[Exec, FS, IO, Time.Wait]> String LandError! {
    if files.exists(dir) -> return Err(LandError{message: "{dir} already exists; a scratch copy needs a new directory"})
    cloned: git(source, [String]{"clone", "--quiet", "--no-hardlinks", source, dir})
    if cloned.code != 0 -> return Err(LandError{message: "git clone into {dir} failed: {first_line(cloned)}"})
    loop key in IDENTITY_KEYS {
        value: git(source, [String]{"config", "--get", key})
        if value.code == 0 -> git(dir, [String]{"config", key, value.output.trim()})
    }
    head: git(dir, [String]{"rev-parse", "--abbrev-ref", "HEAD"})
    print("scratch copy {dir} of {source} at {head.output.trim()}")
    Ok(dir.copy())
}

land: fn(dir: String, pairs: [Pair]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    dirty: git(dir, [String]{"status", "--porcelain", "--untracked-files=no"})
    if dirty.code != 0 || dirty.output.trim() != "" {
        term.eprint("land: {dir} has tracked changes; commit or move them first")
        if dirty.output.trim() != "" -> term.eprint(dirty.output.trim())
        return 3
    }
    pre: git(dir, [String]{"rev-parse", "--verify", "HEAD"}).output.trim()
    applied := [String]{}
    touched := [String]{}
    loop pair in pairs {
        name: files.basename(pair.patch)
        touched.extend(touched_paths(dir, pair.patch))
        apply: git(dir, [String]{"apply", pair.patch})
        if apply.code != 0 {
            term.eprint("land: {name} does not apply on {pre.slice(0..<10)}: {first_line(apply)}")
            revert(dir, applied)
            return 4
        }
        applied.push(pair.patch.copy())
        print("applied {name}")
    }
    if !check(dir, touched) {
        revert(dir, applied)
        term.eprint("land: the check failed; the worktree is back at {pre.slice(0..<10)} and nothing was committed")
        return 5
    }
    landed: commit_stack(dir, pre, pairs) ?? {
        revert(dir, applied)
        term.eprint("land: {err.message}; the worktree is back at {pre.slice(0..<10)} and HEAD did not move")
        return 6
    }
    // The worktree already is the new HEAD; bring the checkout's index along.
    git(dir, [String]{"read-tree", "--reset", "HEAD"})
    git(dir, [String]{"update-index", "-q", "--refresh"})
    loop line in landed -> print("landed {line}")
    print("HEAD {git(dir, [String]{"rev-parse", "--short", "HEAD"}).output.trim()} in {dir}")
    0
}

// Undo the applied patches, newest first.
revert: fn(dir: String, applied: [String]) Never! -[Exec, IO, Time.Wait]> {
    loop step in 0..<applied.len() {
        patch: applied[applied.len() - 1 - step]
        undone: git(dir, [String]{"apply", "-R", patch})
        if undone.code != 0 -> term.eprint("land: could not revert {files.basename(patch)}: {first_line(undone)}; check `git status` in {dir}")
    }
}

// The lane check (Tools/agent/LaneCheck.jet, with $JET, else `jet` on PATH)
// of the patched tree: the whole compiler, with Jetpack's assembly check,
// when a patch touches a compiler input, else each touched .jet file. Both
// run the personal-information guard and the script-pairing guard first; a
// patch with no Jet source runs the script-pairing guard alone. Error rows
// are shown as the check prints them.
check: fn(dir: String, touched: [String]) -[Exec, Env, FS, IO, Time.Wait]> Bool Never! {
    jet: jet_binary()
    compiler := false
    targets := [String]{}
    loop path in touched {
        if compiler_input(path) -> compiler = true
        if path.ends_with(".jet") && files.exists(files.join(dir, path)) -> targets.push(path.copy())
    }
    if compiler -> targets = [String]{""}
    if targets.len() == 0 {
        receipt: process.cmd([String]{jet, "Tools/agent/ScriptPairing.jet", "--check"}).cwd(dir).env("JET_TOOLCHAIN_ROOT", dir).run() ?? {
            term.eprint("check: cannot run {jet}: {err}")
            return false
        }
        if receipt.code == 0 && receipt.signal == None {
            print("check: no Jet sources touched; the apply check and the script-pairing guard are the check")
            return true
        }
        term.eprint("check: the script-pairing guard failed (exit {receipt.code})")
        if receipt.errors.trim() != "" -> term.eprint(receipt.errors.trim())
        return false
    }
    clean := true
    loop target in targets {
        argv := [String]{jet, "Tools/agent/LaneCheck.jet"}
        if target != "" -> argv.push(target.copy())
        label: if target == "" -> "the compiler" else -> target.copy()
        receipt: process.cmd(argv).cwd(dir).env("JET", jet).env("JET_TOOLCHAIN_ROOT", dir).output_limit(268435456).run() ?? {
            term.eprint("check: cannot run {jet}: {err}")
            return false
        }
        if receipt.code == 0 && receipt.signal == None {
            print("check: {label} ok")
            next
        }
        clean = false
        term.eprint("check: {label} failed (exit {receipt.code})")
        if receipt.output.trim() != "" -> term.eprint(receipt.output.trim())
        if receipt.errors.trim() != "" -> term.eprint(receipt.errors.trim())
    }
    clean
}

// One commit per patch, chained on `pre` in a private index; HEAD moves once,
// and only if it is still `pre`. Returns `<short sha> <subject>` per commit.
commit_stack: fn(dir: String, pre: String, pairs: [Pair]) -[Exec, Env, FS, Time.Wait]> [String] LandError! {
    index_path: git(dir, [String]{"rev-parse", "--git-path", "land-index"}).output.trim()
    index: if index_path.starts_with("/") -> index_path.copy() else -> files.join(dir, index_path)
    files.remove(index) ?? ()
    tip := pre.copy()
    landed := [String]{}
    failure := ""
    read: git_index(dir, index, [String]{"read-tree", pre})
    if read.code != 0 -> failure = "read-tree of {pre.slice(0..<10)} failed: {first_line(read)}"
    loop pair in pairs {
        if failure != "" -> break
        staged: git_index(dir, index, [String]{"apply", "--cached", pair.patch})
        if staged.code != 0 {
            failure = "{files.basename(pair.patch)} does not stage: {first_line(staged)}"
            break
        }
        tree: git_index(dir, index, [String]{"write-tree"})
        if tree.code != 0 {
            failure = "write-tree failed: {first_line(tree)}"
            break
        }
        made: git(dir, [String]{"commit-tree", tree.output.trim(), "-p", tip, "-F", pair.message})
        if made.code != 0 {
            failure = "commit-tree for {files.basename(pair.patch)} failed: {first_line(made)}"
            break
        }
        tip = made.output.trim()
        subject: git(dir, [String]{"log", "-1", "--format=%h %s", tip}).output.trim()
        landed.push(subject)
    }
    files.remove(index) ?? ()
    if failure != "" -> return Err(LandError{message: failure})
    // The commits must carry exactly the checked worktree.
    worktree: git(dir, [String]{"diff", "--quiet", tip, "--"})
    if worktree.code != 0 -> return Err(LandError{message: "the commits do not match the checked worktree"})
    moved: git(dir, [String]{"update-ref", "-m", "land: {pairs.len()} commit(s) on {pre.slice(0..<10)}", "HEAD", tip, pre})
    if moved.code != 0 -> return Err(LandError{message: "update-ref of HEAD {pre.slice(0..<10)} failed (HEAD moved?): {first_line(moved)}"})
    Ok(landed)
}

// --- queue ------------------------------------------------------------------

queue_main: fn(args: [String]) -[Exec, Env, FS, IO, Time]> Int Never! {
    if args.len() < 2 -> usage()
    lane: args[0]
    bases := [String]{}
    loop base in args[1..<args.len()] -> bases.push(absolute(base))
    loop base in bases {
        loop ext in JOB_FILES {
            if !files.exists("{base}{ext}") {
                term.eprint("NOT QUEUED: missing {base}{ext}")
                return 1
            }
        }
    }
    if SPEED_LANES.contains(lane) {
        refusal: pareto_refusal(lane, bases)
        if refusal != "" {
            print(refusal)
            return 1
        }
    }
    worktree: root("JET_DEV_WORKTREE", checkout_top())
    if worktree == "" {
        term.eprint("NOT QUEUED: no dev worktree (set JET_DEV_WORKTREE or run inside the checkout)")
        return 2
    }
    if !stack_applies(worktree, bases) {
        print("NOT QUEUED: rebase the failing patches onto HEAD")
        return 1
    }
    queue: "{run_root()}/land-queue"
    files.create_dir_all("{queue}/taken") ?? {
        term.eprint("NOT QUEUED: cannot create {queue}: {err}")
        return 2
    }
    start := time.now().to_timestamp()
    loop at in 0..<bases.len() {
        base: bases[at]
        suffix: if bases.len() > 1 -> "{at + 1}" else -> ""
        name := "{start + at}-{lane}{suffix}"
        // Never overwrite a queued or taken job with the same second-based name.
        loop {
            if !files.exists("{queue}/{name}.job") && !files.exists("{queue}/taken/{name}.job") -> break
            start += 1
            name = "{start + at}-{lane}{suffix}"
        }
        writer: files.create("{queue}/{name}.job", if_exists: .Refuse) ?? {
            term.eprint("NOT QUEUED: cannot create {queue}/{name}.job: {err}")
            return 2
        }
        writer.write_all("{lane}\t{base}.msg\t{base}.patch\n".bytes()) ?? {
            term.eprint("NOT QUEUED: cannot write {queue}/{name}.job: {err}")
            return 2
        }
        writer.fsync() ?? ()
        print("queued {name}")
    }
    0
}

// Why a speed lane's stack may not be queued, "" when it may.
pareto_refusal: fn(lane: String, bases: [String]) -[Env, FS]> String Never! {
    approved_file: env_or("PARETO_APPROVED", "{scratch_root()}/lanes/Main/pareto-approved.txt")
    approved := false
    if files.read(approved_file) == .Ok(text) {
        loop line in text.lines() {
            if line.partition("\t").head == lane -> approved = true
        }
    }
    loop base in bases {
        message: files.read("{base}.msg") ?? ""
        wall: tagged_seconds(message, "PARETO:")
        stage := false
        loop line in message.lines() {
            if line.starts_with("PARETO-STAGE:") && line.remove_prefix("PARETO-STAGE:").trim() != "" -> stage = true
        }
        small: tagged_seconds(message, "SMALL-WIN:") != None
        if stage || (wall ?? -1.0) >= 0.5 -> next
        if small && approved -> next
        if small -> return "NOT QUEUED: {base} is a small win, but {lane} has no approved Pareto design yet; send the big-win design first (owner order: Pareto work first)"
        return "NOT QUEUED: {base}.msg needs a PARETO: >=0.5 s, PARETO-STAGE: or SMALL-WIN: line"
    }
    ""
}

// The seconds of the first line `<marker> [-]<number> s` (a `s` word follows
// the number), as `/^<marker>\s*-?([0-9.]+)\s*s\b/m` reads it.
tagged_seconds: fn(message: String, marker: String) -> Float? Never! {
    loop line in message.lines() {
        if !line.starts_with(marker) -> next
        rest: line.remove_prefix(marker).trim_start().remove_prefix("-")
        digits := [U8]{}
        loop byte in rest.bytes() {
            code: Int.from_u8(byte)
            if !((code >= 48 && code <= 57) || code == 46) -> break
            digits.push(byte)
        }
        if digits.len() == 0 -> next
        number: String.from_bytes_lossy(digits)
        after: rest.remove_prefix(number).trim_start()
        if !after.starts_with("s") -> next
        unit_end: after.remove_prefix("s").bytes()
        if unit_end.len() > 0 {
            code: Int.from_u8(unit_end[0])
            if (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 -> next
        }
        return Val(Float.parse(number) ?? 0.0)
    }
    None
}

// Do the patches apply in order on HEAD of `worktree`? Checked in a temporary
// index, so the worktree is not touched. Prints `OK <patch>` or
// `FAIL <patch>: <reason>` for each.
stack_applies: fn(worktree: String, bases: [String]) -[Exec, Env, FS, IO, Time.Wait]> Bool Never! {
    scratch: run_root()
    files.create_dir_all(scratch) ?? ()
    index: "{scratch}/stackidx.{sys.pid()}"
    files.remove(index) ?? ()
    clean := true
    read: git_index(worktree, index, [String]{"read-tree", "HEAD"})
    if read.code != 0 {
        print("FAIL read-tree of HEAD in {worktree}: {first_line(read)}")
        return false
    }
    loop base in bases {
        name: "{files.basename(base)}.patch"
        applied: git_index(worktree, index, [String]{"apply", "--cached", "{base}.patch"})
        if applied.code == 0 {
            print("OK   {name}")
            next
        }
        clean = false
        print("FAIL {name}: {first_line(applied)}")
    }
    files.remove(index) ?? ()
    clean
}

// --- the compiler in package form -------------------------------------------
// Tools/agent/CompilerPackages.jet is the one compiler package model: the
// packages `jet build Compiler` compiles, the compiler's inputs and its source
// identity. Land runs the dev worktree's copy of it on a tree with the seed.

// The nonblank lines CompilerPackages.jet prints for `args` on `tree`.
compiler_packages_run: fn(tree: String, args: [String]) -[Exec, Env, FS, Time.Wait]> [String] LandError! {
    argv := [String]{"{seed_dir()}/jet", files.join(dev_worktree(), "Tools/agent/CompilerPackages.jet"), "--root", tree}
    argv.extend(args.copy()) // copy: the caller keeps its arguments
    ran: run_in(tree, argv, "")
    if ran.code != 0 -> return Err(LandError{message: "Tools/agent/CompilerPackages.jet {args[0]} on {tree} failed: {first_line(ran)}"})
    lines := [String]{}
    loop line in ran.output.lines() {
        if line != "" -> lines.push(line.copy())
    }
    lines
}

// The compiler's source identity of `tree`: `<binary>@<version>#<sha256>`.
compiler_source_identity: fn(tree: String) -[Exec, Env, FS, Time.Wait]> String LandError! {
    rows: compiler_packages_run(tree, [String]{"identity"}) ?? return Err(err)
    if rows.len() != 1 -> return Err(LandError{message: "Tools/agent/CompilerPackages.jet identity on {tree} printed {rows.len()} lines"})
    rows[0].copy()
}

// The repo-relative directories of the compiler's packages in `tree`.
compiler_package_dirs: fn(tree: String) -[Exec, Env, FS, Time.Wait]> [String] LandError! {
    rows: compiler_packages_run(tree, [String]{"packages"}) ?? return Err(err)
    dirs := [String]{}
    loop row in rows -> dirs.push(row.partition("\t").tail.copy())
    dirs
}

// The repo-relative `paths` that are compiler inputs of `tree`.
compiler_input_paths: fn(tree: String, paths: [String]) -[Exec, Env, FS, Time.Wait]> [String] LandError! {
    if paths.len() == 0 -> return Ok([String]{})
    args := [String]{"select"}
    args.extend(paths.copy()) // copy: the caller keeps its paths
    compiler_packages_run(tree, args)
}

// The relative `path` from the repo-relative `directory`, normalized; ""
// when it leaves the repository.
repo_join: fn(directory: String, path: String) -> String Never! {
    parts := [String]{}
    loop part in "{directory}/{path}".split("/") {
        if part == "" || part == "." -> next
        if part == ".." {
            if parts.len() == 0 -> return ""
            _ := parts.pop()
            next
        }
        parts.push(part.copy())
    }
    parts.join("/")
}

// Does a commit touching `path` need the census beyond the compiler inputs:
// a runtime, backend, Core or Jetpack source or a sources.list?
census_source: fn(path: String) -> Bool Never! {
    if path.starts_with("Compiler/JetRuntime/Source/") || path.starts_with("Compiler/JetBackend/Source/") || path.starts_with("Core/") -> return true
    if path == "Compiler/JetRuntime/sources.list" || path.ends_with("/sources.list") -> return true
    path.starts_with("Jetpack/") && path.removeprefix("Jetpack/").contains("/Source/")
}

// --- heavy passes -----------------------------------------------------------

Setting: struct {
    name: String
    value: String
}

// `argv` as a heavy pass, killed after `seconds` (0: no limit), run as
// run_logged runs it.
run_heavy: fn(dir: String, seconds: Int, argv: [String], env: [Setting], log: String) -[Exec, FS, Time.Wait]> Int Never! {
    out := [String]{"systemd-run", "--user", "--scope", "-q", "--expand-environment=no", "-p", "MemoryMax={HEAVY_MEMORY}", "-p", "MemorySwapMax=0", "nice", "-n", "19", "ionice", "-c3", "taskset", "-c", HEAVY_CPUS, "prlimit", HEAVY_STACK, "--"}
    out.extend(argv.copy())
    spec := process.cmd(out)
    if seconds > 0 -> spec = spec.timeout(time.duration_seconds(seconds))
    run_spec(spec, out[0], dir, env, log)
}

// `argv` run in `dir` with `env` added, its output in LOG.out and LOG.err;
// the exit code, 128 + the signal on a signal, 124 on a timeout, 125 at a
// memory cap, 127 when it cannot start.
run_logged: fn(dir: String, argv: [String], env: [Setting], log: String) -[Exec, FS, Time.Wait]> Int Never! {
    run_spec(process.cmd(argv), argv[0], dir, env, log)
}

run_spec: fn(base: ProcessSpec, program: String, dir: String, env: [Setting], log: String) -[Exec, FS, Time.Wait]> Int Never! {
    spec := base.cwd(dir).output_limit(1073741824)
    loop setting in env -> spec = spec.env(setting.name, setting.value)
    results: process.run_all([ProcessSpec]{spec}, 1) ?? {
        files.write("{log}.out", "") ?? ()
        files.write("{log}.err", "{program} cannot start: {err}\n") ?? ()
        return 127
    }
    if results[0] == {
        .Ok(receipt) -> {
            files.write("{log}.out", receipt.output) ?? ()
            files.write("{log}.err", receipt.errors) ?? ()
            if receipt.timed_out -> return 124
            if receipt.signal == .Val(number) -> return 128 + number
            receipt.code
        }
        .Err(error) -> {
            files.write("{log}.out", "") ?? ()
            stopped: if error == {
                .ResourceLimit(_) -> 125
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .AlreadyExists(_) | .Unsupported(_) -> 127
            }
            what: if stopped == 125 -> "stopped at its memory cap" else -> "cannot start"
            files.write("{log}.err", "{program} {what}: {error}\n") ?? ()
            stopped
        }
    }
}

// The environment of a compile of `tree` by a compiler of `identity`, its
// keep-going report in `report` ("" for none).
compile_env: fn(identity: String, tree: String, report: String) -> [Setting] Never! {
    env := [Setting]{Setting{name: "JET_COMPILER_IDENTITY", value: identity.copy()}, Setting{name: "JET_TOOLCHAIN_ROOT", value: tree.copy()}, Setting{name: "JET_KEEP_GOING", value: "1"}}
    if report != "" -> env.push(Setting{name: "JET_KEEP_GOING_REPORT", value: report.copy()})
    env
}

// COMMIT of the checkout `repo` (only `paths` when there are any) unpacked into `dir`.
export_tree: fn(repo: String, commit: String, dir: String, paths: [String]) LandError! -[Exec, FS, Time.Wait]> {
    files.create_dir_all(dir) ?? return Err(LandError{message: "`{dir}` cannot be created: {err}"})
    archive: "{dir}.tar"
    argv := [String]{"archive", "--format=tar", "-o", archive, commit}
    if paths.len() > 0 {
        argv.push("--")
        argv.extend(paths.copy())
    }
    made: git(repo, argv)
    if made.code != 0 {
        files.remove(archive) ?? ()
        return Err(LandError{message: "git archive {commit} failed: {first_line(made)}"})
    }
    unpacked: run_in(dir, [String]{"tar", "-x", "-f", archive, "-C", dir}, "")
    files.remove(archive) ?? ()
    if unpacked.code != 0 -> return Err(LandError{message: "unpacking {commit} failed: {first_line(unpacked)}"})
    Ok()
}

dev_worktree: fn() -[Exec, Env, FS, Time.Wait]> String Never! { root("JET_DEV_WORKTREE", checkout_top()) }

// The seed compiler's directory: $JET_SEED, else the current seed.
seed_dir: fn() -[Env, FS]> String Never! {
    named: root("JET_SEED", "{seeds_root()}/current")
    files.canonicalize(named) ?? named.copy()
}

read_identity: fn(dir: String) -[FS]> String Never! { (files.read("{dir}/IDENTITY") ?? "").trim() }

// At most `limit` characters of `text`.
clip: fn(text: String, limit: Int) -> String Never! {
    if text.count_bytes() <= limit -> return text.copy()
    out := ""
    taken := 0
    loop scalar in text.chars() {
        if taken >= limit -> break
        out = "{out}{scalar}"
        taken += 1
    }
    out
}

show: fn(lines: [String], limit: Int) -[IO]> {
    loop at in 0..<lines.len() {
        if at >= limit -> break
        print(clip(lines[at], 200))
    }
}

// --- census -----------------------------------------------------------------

// The passes after the check (the check always runs).
Passes: struct {
    build: Bool
    selfcheck: Bool
}

census_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    census(args, Passes{build: env_or("CENSUS_BUILD", "1") != "0", selfcheck: env_or("CENSUS_SELFCHECK", "1") != "0"})
}

census: fn(named: [String], passes: Passes) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    worktree: dev_worktree()
    if worktree == "" {
        print("census: no dev worktree (set JET_DEV_WORKTREE or run in the checkout)")
        return 2
    }
    r14: "{scratch_root()}/discovery/r14"
    files.create_dir_all(r14) ?? {
        print("census: `{r14}` cannot be created: {err}")
        return 2
    }
    // One census at a time owns the snapshot; `publish latest` and
    // `Tools/agent/Chain.jet seed-published` read the census output beside it.
    _held: files.lock("{r14}/census-snap.lock") ?? {
        print("census: the snapshot lock cannot be taken: {err}")
        return 2
    }
    snap: "{r14}/snap"
    out: "{r14}/census"
    files.remove_all(snap) ?? ()
    files.remove_all(out) ?? ()
    files.create_dir_all(out) ?? {
        print("census: `{out}` cannot be created: {err}")
        return 2
    }
    compiler_dir: env_or("CENSUS_JET_DIR", seed_dir())
    identity: env_or("CENSUS_JET_IDENTITY", read_identity(compiler_dir))
    if identity == "" {
        print("census: {compiler_dir} has no IDENTITY")
        return 2
    }
    parsed: git(worktree, [String]{"rev-parse", "--verify", "{env_or("CENSUS_COMMIT", "HEAD")}^{{commit}}"})
    if parsed.code != 0 {
        print("EXPORT FAILED: {first_line(parsed)}")
        return 2
    }
    head: parsed.output.trim()
    export_tree(worktree, head, snap, [String]{}) ?? {
        print("EXPORT FAILED: {err.message}")
        return 2
    }
    loop path in named {
        source: files.join(worktree, path)
        target: files.join(snap, path)
        if !files.exists(source) {
            files.remove(target) ?? ()
            next
        }
        files.create_dir_all(files.dirname(target)) ?? ()
        files.copy(source, target) ?? {
            print("EXPORT FAILED: {path}: {err}")
            return 2
        }
    }
    // The receipt's key: the snapshot's source identity before any pass writes into it.
    source_identity: compiler_source_identity(snap) ?? {
        print("SOURCE IDENTITY FAILED: {err.message}")
        return 2
    }
    package_dirs: compiler_package_dirs(snap) ?? [String]{}
    seed_jet: "{compiler_dir}/jet"
    check_report: "{out}/check-keep-going.tsv"
    checked: run_heavy(snap, 0, [String]{seed_jet, "check", "--threads", "12", "Compiler/JetCli"}, compile_env(identity, snap, check_report), "{out}/check")
    check_rows: report_rows(check_report)
    print("check rc={checked} rows={check_rows}")
    show(census_rows(check_report, snap, package_dirs), 21)
    if checked != 0 || check_rows != 0 -> return 1
    if !passes.build -> return 0

    // `jet build Compiler` makes jet and, beside it, the runtime pack that jet
    // lowers, behind the dev shell (Tools/agent/JetEnv.jet). It builds at
    // `basic`, as the chain stages do (Chain.jet build_stage).
    files.remove_all("{snap}/Compiler/JetCli/.jet/build") ?? ()
    build_report: "{out}/build-keep-going.tsv"
    built: run_heavy(snap, 1800, [String]{seed_jet, "{snap}/Tools/agent/JetEnv.jet", seed_jet, "build", "--optimize=basic", "--threads", "12", "Compiler"}, compile_env(identity, snap, build_report), "{out}/build")
    build_rows: report_rows(build_report)
    print("build rc={built} rows={build_rows}")
    show(census_rows(build_report, snap, package_dirs), 21)
    if built != 0 || build_rows != 0 {
        print(clip(files.read("{out}/build.err") ?? "", 600))
        return 1
    }
    // The sources the build regenerates and git keeps (`kept: true`) must be
    // committed as it wrote them.
    stale: stale_kept(worktree, head, snap, named)
    if stale.len() > 0 {
        print("STALE: {stale.join(", ")} differ from what `jet build Compiler` generates; build it and commit them")
        return 1
    }
    self_jet: "{snap}/Compiler/JetCli/.jet/build/jet"
    native_key: (files.read("{snap}/Compiler/JetCli/.jet/build/jet-runtime/native.key") ?? "").trim()
    if native_key == "" {
        print("runtime rc=1 (the build made no runtime pack beside {self_jet})")
        return 1
    }
    print("runtime rc=0 native.key {native_key}")
    if !passes.selfcheck -> return 0

    self_report: "{out}/selfcheck-keep-going.tsv"
    selfchecked: run_heavy(snap, 1200, [String]{self_jet, "check", "--threads", "12", "Compiler/JetCli"}, compile_env(identity, snap, self_report), "{out}/selfcheck")
    self_rows: report_rows(self_report)
    print("selfcheck rc={selfchecked} rows={self_rows}")
    show(census_rows(self_report, snap, package_dirs), 11)
    // Every Core body, called or not, whatever the self-check above found.
    core_report: "{out}/selfcheck-core-keep-going.tsv"
    core_checked: run_heavy(snap, 1200, [String]{self_jet, "check", "--threads", "12", "Core"}, compile_env(identity, snap, core_report), "{out}/selfcheck-core")
    core_rows: report_rows(core_report)
    print("selfcheck-core rc={core_checked} rows={core_rows}")
    show(census_rows(core_report, snap, package_dirs), 11)
    if selfchecked != 0 || self_rows != 0 || core_checked != 0 || core_rows != 0 -> return 1

    written: write_receipt(source_identity, read_identity(compiler_dir), head, named, receipt_dir()) ?? {
        print("census: the preflight receipt cannot be written: {err.message}")
        return 2
    }
    print("preflight receipt {written}")
    0
}

// The kept outputs of the build in `snap` (its receipt's `kept` rows) whose
// bytes differ from the commit `head` had them, or the worktree for a `named`
// path: each a checkout path.
stale_kept: fn(worktree: String, head: String, snap: String, named: [String]) -[Exec, FS, Time.Wait]> [String] Never! {
    receipt: json.parse(files.read("{snap}/Compiler/.jet/build/receipt.json") ?? "") ?? return [String]{"Compiler/.jet/build/receipt.json"}
    stale := [String]{}
    loop row in array_field(receipt, "kept") {
        path: "Compiler/{text_field(row, "path")}"
        committed: if named.contains(path) -> files.read(files.join(worktree, path)) ?? "" else -> git(worktree, [String]{"show", "{head}:{path}"}).output
        if "sha256:{crypto.sha256(committed.bytes()).hex()}" != text_field(row, "digest") -> stale.push(path)
    }
    stale
}

// The rows of a keep-going report: its nonblank lines after the header.
report_rows: fn(report: String) -[FS]> Int Never! {
    text: files.read(report) ?? return 0
    rows := 0
    first := true
    loop line in text.lines() {
        if first {
            first = false
            next
        }
        if line.trim() != "" -> rows += 1
    }
    rows
}

// A keep-going report (columns named by its header: span, code, phase,
// message, item) of a compile of `tree`: a `<n> rows {"code": count}` line,
// then `code<TAB>file:line<TAB>phase: message` for each row, its span
// mapped to the file of `tree` it names (else the span, else the item).
census_rows: fn(report: String, tree: String, package_dirs: [String]) -[FS]> [String] Never! {
    text: files.read(report) ?? return [String]{"no keep-going report at {report}: the compile wrote no census"}
    header := [String]{}
    rows := [String]{}
    codes := [String]{}
    counts := [Int]{}
    cached_file := ""
    cached := [U8]{}
    loop line in text.lines() {
        if header.len() == 0 {
            loop name in line.split("\t") -> header.push(name.copy())
            next
        }
        if line.trim() == "" -> next
        fields := [String]{}
        loop value in line.split("\t") -> fields.push(value.copy())
        code: column(fields, header, "code")
        span: column(fields, header, "span")
        place: span_place(tree, package_dirs, span)
        where := if span != "-" -> span.copy() else -> column(fields, header, "item")
        if place.file != "" {
            if place.file != cached_file {
                cached = files.read_bytes(files.join(tree, place.file)) ?? [U8]{}
                cached_file = place.file.copy()
            }
            where = "{place.file}:{line_at(cached, place.offset)}"
        }
        phase: column(fields, header, "phase")
        detail: clip("{phase}: {column(fields, header, "message")}", 200)
        rows.push("{code}\t{where}\t{detail}")
        found := false
        loop at in 0..<codes.len() {
            if codes[at] == code {
                counts[at] = counts[at] + 1
                found = true
            }
        }
        if !found {
            codes.push(code.copy())
            counts.push(1)
        }
    }
    tally := [String]{}
    loop at in 0..<codes.len() -> tally.push("\"{codes[at]}\":{counts[at]}")
    out := [String]{"{rows.len()} rows {{{tally.join(",")}}}"}
    out.extend(rows)
    out
}

// The field of `fields` under the header column `name`, "-" when absent.
column: fn(fields: [String], header: [String], name: String) -> String Never! {
    loop at in 0..<header.len() {
        if header[at] == name && at < fields.len() -> return fields[at].copy()
    }
    "-"
}

// The 1-based line of the byte `offset` of `bytes`.
line_at: fn(bytes: [U8], offset: Int) -> Int Never! {
    line := 1
    loop at in 0..<bytes.len() {
        if at >= offset -> break
        if Int.from_u8(bytes[at]) == 10 -> line += 1
    }
    line
}

Place: struct {
    // Relative to the tree; "" when the span names no file of it.
    file: String
    offset: Int
}

// A `path:start..end` span's file of `tree` and start offset. An absolute
// path maps to its longest suffix that is a file of `tree`; a relative one
// to the one file it names from the root, Compiler or a package directory.
span_place: fn(tree: String, package_dirs: [String], span: String) -[FS]> Place Never! {
    at: span.rpartition(":")
    if at.sep == "" -> return Place{file: "", offset: 0}
    range: at.tail.partition("..")
    if range.sep == "" || !is_digits(range.head) || !is_digits(range.tail) -> return Place{file: "", offset: 0}
    offset: Int.parse(range.head) ?? return Place{file: "", offset: 0}
    Place{file: source_file(tree, package_dirs, at.head), offset: offset}
}

is_digits: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return false
    }
    true
}

source_file: fn(tree: String, package_dirs: [String], path: String) -[FS]> String Never! {
    if path.starts_with("/") {
        parts := [String]{}
        loop part in path.split("/") {
            if part != "" && part != "." -> parts.push(part.copy())
        }
        loop start in 0..<parts.len() {
            candidate := parts[start].copy()
            loop at in (start + 1)..<parts.len() -> candidate = "{candidate}/{parts[at]}"
            if files.is_file(files.join(tree, candidate)) -> return candidate
        }
        return ""
    }
    bases := [String]{"", "Compiler"}
    bases.extend(package_dirs.copy())
    found := [String]{}
    loop base in bases {
        candidate: repo_join(base, path)
        if candidate == "" || found.contains(candidate) -> next
        if files.is_file(files.join(tree, candidate)) -> found.push(candidate)
    }
    if found.len() == 1 -> return found[0].copy()
    ""
}

// --- precommit and prescreen ------------------------------------------------

precommit_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    worktree: dev_worktree()
    inputs: compiler_input_paths(worktree, args) ?? {
        print("PRECOMMIT: the compiler packages cannot be read: {err.message}")
        print("PRECOMMIT FAILED")
        return 1
    }
    needed := inputs.len() > 0
    loop path in args {
        if census_source(path) -> needed = true
    }
    census_failed: needed && census(args, Passes{build: true, selfcheck: true}) != 0
    ratchets_failed: ratchets(worktree) != 0
    if census_failed || ratchets_failed {
        print("PRECOMMIT FAILED")
        return 1
    }
    print("PRECOMMIT OK")
    0
}

// `ratchets`: RATCHETS, one per line.
ratchets_main: fn(args: [String]) -[Exec, IO]> Int Never! {
    if args.len() != 0 -> usage()
    loop tool in RATCHETS -> print(tool)
    0
}

// Each of RATCHETS `--check`ed in `worktree` with the seed, RATCHET_JOBS at
// once; the number that failed. A failure prints the tool's output.
ratchets: fn(worktree: String) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    compiler_dir: seed_dir()
    identity: read_identity(compiler_dir)
    specs := [ProcessSpec]{}
    loop tool in RATCHETS {
        spec := process.cmd([String]{"{compiler_dir}/jet", tool, "--check"}).cwd(worktree).env("JET_TOOLCHAIN_ROOT", worktree).output_limit(268435456)
        if identity != "" -> spec = spec.env("JET_COMPILER_IDENTITY", identity)
        specs.push(spec)
    }
    results: process.run_all(specs, RATCHET_JOBS) ?? {
        print("PRECOMMIT: the ratchets cannot start: {err}")
        return RATCHETS.len()
    }
    failed := 0
    loop index in 0..<RATCHETS.len() {
        tool: RATCHETS[index]
        receipt: results[index] ?? {
            print("PRECOMMIT: {tool} cannot start: {err}")
            failed += 1
            next
        }
        if receipt.code == 0 && receipt.signal == None {
            print("ratchet {tool} ok")
            next
        }
        failed += 1
        output := [String]{}
        loop line in process.combined_output(receipt).trim_end().split("\n") -> output.push(line.copy())
        // The verdict is at the end (CoreCoverage prints its module table first).
        tail: if output.len() > 40 -> output.len() - 40 else -> 0
        lines := [String]{}
        loop at in tail..<output.len() -> lines.push(output[at].copy())
        show(lines, 40)
        print("PRECOMMIT: {tool} --check failed (exit {receipt.code})")
    }
    failed
}

prescreen_main: fn(args: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    if args.len() == 0 -> usage()
    patch: absolute(args[0])
    earlier := [String]{}
    loop path in args[1..<args.len()] -> earlier.push(absolute(path))
    worktree: dev_worktree()
    if worktree == "" {
        print("prescreen: no dev worktree (set JET_DEV_WORKTREE or run in the checkout)")
        return 2
    }
    tree: "{scratch_root()}/discovery/prescreen.{sys.pid()}"
    files.remove_all(tree) ?? ()
    code: prescreen(worktree, tree, patch, earlier)
    files.remove_all(tree) ?? ()
    code
}

prescreen: fn(worktree: String, tree: String, patch: String, earlier: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    export_tree(worktree, "HEAD", tree, [String]{}) ?? {
        print("prescreen: HEAD cannot be exported: {err.message}")
        return 2
    }
    // An earlier job that no longer applies is the lander's to report.
    loop path in earlier -> apply_around_views(tree, path)
    if !apply_around_views(tree, patch) {
        print("prescreen: does not apply to HEAD {git(worktree, [String]{"rev-parse", "--short", "HEAD"}).output.trim()}")
        return 3
    }
    touched := [String]{}
    patches := earlier.copy()
    patches.push(patch.copy())
    loop path in patches {
        loop name in touched_paths(tree, path) {
            if !touched.contains(name) -> touched.push(name)
        }
    }
    // Unreadable packages count every path as an input.
    needed := true
    if compiler_input_paths(worktree, touched) == .Ok(inputs) -> needed = inputs.len() > 0
    if !needed {
        print("prescreen: clean (no compiler inputs; apply check only)")
        return 0
    }
    seed: seed_dir()
    code: run_heavy(tree, 1200, [String]{"{seed}/jet", "check", "--threads", "10", "Compiler/JetCli"}, compile_env(read_identity(seed), tree, ""), "{tree}/check")
    rows: error_rows(files.read("{tree}/check.err") ?? "")
    if code == 0 && rows.len() == 0 {
        print("prescreen: clean")
        return 0
    }
    print("prescreen: check rc={code} errors={rows.len()}")
    show(counted(rows), 20)
    1
}

// Apply `patch` in `tree`; when it does not apply whole, apply it around the
// generated views.
apply_around_views: fn(tree: String, patch: String) -[Exec, Time.Wait]> Bool Never! {
    if git(tree, [String]{"apply", patch}).code == 0 -> return true
    git(tree, around_views([String]{}, patch)).code == 0
}

// Each `Error...` line of a check's output with the location on the line after it.
error_rows: fn(text: String) -> [String] Never! {
    lines := [String]{}
    loop line in text.lines() -> lines.push(line.copy())
    rows := [String]{}
    loop at in 0..<lines.len() {
        if !lines[at].starts_with("Error") -> next
        words := [String]{}
        if at + 1 < lines.len() {
            loop word in lines[at + 1].split(" ") {
                if word != "" -> words.push(word.copy())
            }
        }
        place: if words.len() > 1 -> words[1].copy() else -> ""
        rows.push("{lines[at]} {place}")
    }
    rows
}

// Equal rows once each, sorted, after their count.
counted: fn(rows: [String]) -> [String] Never! {
    sorted := rows.copy()
    sorted.sort()
    out := [String]{}
    at := 0
    loop at < sorted.len() {
        count := 1
        loop at + count < sorted.len() && sorted[at + count] == sorted[at] -> count += 1
        out.push("{count} {sorted[at]}")
        at += count
    }
    out
}

// --- the landing service ----------------------------------------------------

// A land job: a lane's patch and its commit message, and its queue name (""
// outside the service).
Job: struct {
    lane: String
    message: String
    patch: String
    name: String
}

// A job that applied, with the paths its patch touches.
Applied: struct {
    job: Job
    paths: [String]
}

// A path and its modification time, for newest-first listings.
Dated: struct {
    path: String
    time: Int
}

// What a publish step did: its summary line, and whether it succeeded.
Step: struct {
    ok: Bool
    line: String
}

// The jobs of a list, one `LANE<TAB>MSG<TAB>PATCH[<TAB>NAME]` per line
// (absolute paths); blank lines and `#` comments are skipped.
read_jobs: fn(text: String) -> [Job] Never! {
    jobs := [Job]{}
    loop line in text.lines() {
        if line.trim() == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() < 3 -> next
        name: if fields.len() > 3 -> fields[3].copy() else -> ""
        jobs.push(Job{lane: fields[0].copy(), message: fields[1].copy(), patch: fields[2].copy(), name: name})
    }
    jobs
}

job_line: fn(job: Job) -> String Never! { "{job.lane}\t{job.message}\t{job.patch}\t{job.name}" }

// `line` on stdout and appended to `log`.
say: fn(log: String, line: String) -[FS, IO]> {
    print(line)
    files.append_all(log, "{line}\n") ?? ()
}

// The UTC wall clock, `YYYY-MM-DD HH:MM:SS`.
stamp: fn() -[Time]> String Never! {
    dt: time.gmtime(time.unix_ns() /% 1000000000)
    "{time.isoformat_date(dt.date())} {time.isoformat_time(dt.time())}"
}

epoch: fn() -[Time]> Int Never! { time.unix_ns() /% 1000000000 }

// The last `count` of `lines`.
last_of: fn(lines: [String], count: Int) -> [String] Never! {
    start: if lines.len() > count -> lines.len() - count else -> 0
    out := [String]{}
    loop at in start..<lines.len() -> out.push(lines[at].copy())
    out
}

// A command's output, then its error output.
both: fn(ran: Ran) -> String Never! { "{ran.output}{ran.errors}" }

// The paths of a `-z` git listing.
nul_paths: fn(ran: Ran) -> [String] Never! {
    paths := [String]{}
    if ran.code != 0 -> return paths
    loop field in nul_fields(ran.output) {
        if field != "" -> paths.push(field.copy())
    }
    paths
}

// The paths with tracked changes in the worktree `dir`.
dirty_paths: fn(dir: String) -[Exec, Time.Wait]> [String] Never! {
    paths := [String]{}
    loop field in nul_paths(git(dir, [String]{"status", "--porcelain", "-z", "--untracked-files=no"})) {
        raw: field.bytes()
        // `XY PATH`: two status letters and a space.
        if raw.len() > 3 -> paths.push(String.from_bytes_lossy(raw.slice(3, raw.len())))
    }
    paths
}

// Is `path` in the worktree `dir` (a dangling symlink counts)?
on_disk: fn(dir: String, path: String) -[FS]> Bool Never! {
    full: files.join(dir, path)
    files.exists(full) || files.is_symlink(full)
}

// `git --literal-pathspecs ARGS... -- PATHS...` in `dir` with the index `index` ("" for the checkout's).
git_paths: fn(dir: String, index: String, args: [String], paths: [String]) -[Exec, Time.Wait]> Ran Never! {
    argv := [String]{"--literal-pathspecs"}
    argv.extend(args.copy())
    argv.push("--")
    argv.extend(paths.copy())
    git_index(dir, index, argv)
}

// `jet ARGS...` by the seed in `dir`, with `dir` as its toolchain root, killed
// after `seconds` (0: no limit); 124 on a timeout.
seed_run: fn(dir: String, args: [String], seconds: Int) -[Exec, Env, FS, Time.Wait]> Ran Never! {
    seed: seed_dir()
    argv := [String]{"{seed}/jet"}
    argv.extend(args.copy())
    spec := process.cmd(argv).cwd(dir).env("JET_COMPILER_IDENTITY", read_identity(seed)).env("JET_TOOLCHAIN_ROOT", dir).output_limit(268435456)
    if seconds > 0 -> spec = spec.timeout(time.duration_seconds(seconds))
    receipt: spec.run() ?? return Ran{code: 127, output: "", errors: "{argv[0]}: {err}"}
    code: if {
        receipt.timed_out -> 124
        receipt.signal == .Val(_) -> 128
        else -> receipt.code
    }
    Ran{code: code, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

// The checkout this tool runs from: its later runs (the golden worker, the
// release train, the build slot) start from there.
tools_checkout: fn() -[Exec, Env, FS, Time.Wait]> String Never! {
    top: checkout_top()
    if top != "" -> return top
    dev_worktree()
}

seeds_root: fn() -[Env, FS]> String Never! { root("JET_SEEDS", "{env_or("XDG_DATA_HOME", "{env_or("HOME", "")}/.local/share")}/jet-seeds") }

base_root: fn() -[Env, FS]> String Never! { root("JET_BASE_ROOT", "{scratch_root()}/discovery/base") }

// The environment a detached run of this tool starts with: PATH, the roots,
// and the seed's identity with `tools` as its toolchain root.
unit_env: fn(tools: String) -[Exec, Env, FS, Time.Wait]> [Setting] Never! {
    seed: seed_dir()
    env := [Setting]{
        Setting{name: "PATH", value: env_or("PATH", "")},
        Setting{name: "JET_STATE_ROOT", value: state_root()},
        Setting{name: "JET_SCRATCH_ROOT", value: scratch_root()},
        Setting{name: "JET_RUN_ROOT", value: run_root()},
        Setting{name: "JET_BASE_ROOT", value: base_root()},
        Setting{name: "JET_SEEDS", value: seeds_root()},
        Setting{name: "JET_SEED", value: root("JET_SEED", "{seeds_root()}/current")},
        Setting{name: "JET_DEV_WORKTREE", value: dev_worktree()},
        Setting{name: "JET_COMPILER_IDENTITY", value: read_identity(seed)},
        Setting{name: "JET_TOOLCHAIN_ROOT", value: tools.copy()},
    }
    env
}

// Start `jet Tools/agent/Land.jet ARGS...` by the seed as the user unit
// `unit` (systemd-run), detached from the caller, in `tools`, with the
// unit `properties` and its output appended to `log`.
start_unit: fn(tools: String, unit: String, properties: [String], args: [String], log: String) -[Exec, Env, FS, Time.Wait]> Ran Never! {
    argv := [String]{"systemd-run", "--user", "--unit={unit}", "--collect", "-q", "--expand-environment=no", "--working-directory={tools}"}
    props := properties.copy()
    props.push("StandardOutput=append:{log}")
    props.push("StandardError=append:{log}")
    loop property in props {
        argv.push("-p")
        argv.push(property.copy())
    }
    loop setting in unit_env(tools) -> argv.push("--setenv={setting.name}={setting.value}")
    argv.push("{seed_dir()}/jet")
    argv.push("Tools/agent/Land.jet")
    argv.extend(args.copy())
    run_in(tools, argv, "")
}

// Can `path` be locked now? The probe's lock is released on return.
lock_free: fn(path: String) -[FS, Env]> Bool Never! {
    _held: files.try_lock(path) ?? return false
    true
}

// `items` newest first.
newest_first: fn(items: [Dated]) -> [Dated] Never! {
    sorted := items.copy()
    sorted.sort_by((left: Dated, right: Dated) -> {
        if left.time > right.time -> return Ordering.Less
        if left.time < right.time -> return Ordering.Greater
        Ordering.Equal
    })
    sorted
}

mtime: fn(path: String) -[FS]> Int Never! { files.getmtime(path) ?? 0 }

// The entries of the directory `dir`, none when it cannot be listed.
entries: fn(dir: String) -[FS]> [files.DirEntry] Never! { files.list_dir(dir) ?? [files.DirEntry]{} }

// The first line of the file at `path`, "" when it cannot be read.
first_line_of: fn(path: String) -[FS]> String Never! { (files.read(path) ?? "").partition("\n").head.trim() }

// `text` with `git stripspace`'s cleanup: trailing whitespace removed, runs
// of blank lines collapsed, no blank lines at either end, one final newline.
stripspace: fn(text: String) -> String Never! {
    out := [String]{}
    blank := false
    loop raw in text.lines() {
        line: raw.trim_end()
        if line == "" {
            blank = out.len() > 0
            next
        }
        if blank -> out.push("")
        blank = false
        out.push(line.copy())
    }
    if out.len() == 0 -> return ""
    "{out.join("\n")}\n"
}

// The root of `at`'s group.
group_root: fn(group: [Int], at: Int) -> Int Never! {
    current := at
    loop group[current] != current -> current = group[current]
    current
}

// The groups of patches that share a file (transitively), as the root index
// of each patch's group: a group lands as one commit, since staging a whole
// file would take another patch's hunks too.
share_groups: fn(paths: [[String]]) -> [Int] Never! {
    group := [Int]{}
    loop at in 0..<paths.len() -> group.push(at)
    owner := [String:Int]{}
    loop at in 0..<paths.len() {
        loop path in paths[at] {
            if owner.get(path) == .Val(first) {
                a: group_root(group, first)
                b: group_root(group, at)
                if a != b -> group[b] = a
                next
            }
            owner[path] = at
        }
    }
    roots := [Int]{}
    loop at in 0..<paths.len() -> roots.push(group_root(group, at))
    roots
}

// `batch LIST`.
batch_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    if args.len() != 1 -> usage()
    text: files.read(args[0]) ?? {
        term.eprint("batch: {args[0]} cannot be read: {err}")
        return 2
    }
    worktree: dev_worktree()
    if worktree == "" {
        term.eprint("batch: no dev worktree (set JET_DEV_WORKTREE or run in the checkout)")
        return 2
    }
    batch(tools_checkout(), worktree, read_jobs(text))
}

// Land `jobs` on the worktree `dir` with one verification; the report is
// $JET_RUN_ROOT/batch-land.log. Exit: 0 landed (or nothing applied); 2 setup
// failure; 3 the worktree has tracked changes; 5 the precommit failed; 6 the
// commits could not be made. 5 and 6 leave HEAD and the worktree as they were.
batch: fn(tools: String, dir: String, jobs: [Job]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    run: run_root()
    files.create_dir_all(run) ?? ()
    log: "{run}/batch-land.log"
    files.write(log, "") ?? ()
    _held: files.lock("{run}/commit.lock") ?? {
        say(log, "the commit lock cannot be taken: {err}")
        return 2
    }
    dirty: git(dir, [String]{"status", "--porcelain", "--untracked-files=no"})
    if dirty.code != 0 || dirty.output.trim() != "" {
        say(log, "worktree has tracked changes; refusing")
        loop line in dirty.output.trim_end().first_lines(10) -> say(log, line)
        return 3
    }
    parsed: git(dir, [String]{"rev-parse", "--verify", "HEAD"})
    if parsed.code != 0 {
        say(log, "HEAD of {dir} cannot be read: {first_line(parsed)}")
        return 2
    }
    pre: parsed.output.trim()
    applied := [Applied]{}
    all := [String]{}
    broken := [String:String]{}
    regenerate := false
    loop job in jobs {
        name: files.basename(job.patch)
        if broken.get(job.lane) == .Val(base) {
            say(log, "DOES NOT APPLY {job.lane} {name} - an earlier patch of its stack did not apply ({base}); left for its lane")
            next
        }
        if git(dir, [String]{"apply", "-R", "--check", job.patch}).code == 0 {
            say(log, "SKIP (already on dev) {job.lane} {name}")
            next
        }
        whole: git(dir, [String]{"apply", "--check", job.patch}).code == 0 && git(dir, [String]{"apply", job.patch}).code == 0
        // A patch whose only conflict is in the generated CoreSourceRows views
        // applies around them; the views are regenerated from the batch's sources.
        around := false
        if !whole {
            around = git(dir, around_views([String]{"--check"}, job.patch)).code == 0 && git(dir, around_views([String]{}, job.patch)).code == 0
            if around {
                regenerate = true
                say(log, "applied around the CoreSourceRows views: {name}")
            }
        }
        if !whole && !around {
            say(log, "DOES NOT APPLY {job.lane} {name} - left for its lane")
            broken[job.lane] = name
            next
        }
        paths: touched_paths(dir, job.patch)
        loop path in paths {
            if !all.contains(path) -> all.push(path.copy())
        }
        say(log, "APPLIED {job.lane} {name} ({paths.len()} files)")
        applied.push(Applied{job: job.copy(), paths: paths})
    }
    if applied.len() == 0 {
        say(log, "nothing applied")
        return 0
    }
    if regenerate {
        rows: seed_run(dir, [String]{"Tools/agent/CoreSourceRows.jet"}, 900)
        say(log, "CoreSourceRows regeneration rc={rows.code} {both(rows).trim_end().last_lines(1).join(" ")}")
        if rows.code != 0 {
            say(log, "CoreSourceRows regeneration FAILED; reverting")
            revert_batch(dir, applied, all, log)
            return 5
        }
    }
    // The runtime generators' outputs (stop exports, lifecycle) for the batch's runtime sources.
    generated: seed_run(dir, [String]{"Tools/agent/RuntimeGenerators.jet"}, 900)
    say(log, "RuntimeGenerators rc={generated.code} {both(generated).trim_end().last_lines(2).join(" ")}")
    regenerated := [String]{}
    loop path in dirty_paths(dir) {
        if !all.contains(path) -> regenerated.push(path)
    }
    shown_regenerated: if regenerated.len() > 0 -> regenerated.join(" ") else -> "none"
    say(log, "regenerated: {shown_regenerated}")
    precommit_args := [String]{"Tools/agent/Land.jet", "precommit"}
    precommit_args.extend(all.copy())
    precommit_args.extend(regenerated.copy())
    checked: seed_run(dir, precommit_args, 0)
    rows := [String]{}
    loop line in both(checked).lines() {
        if line.starts_with("nm: ") || line.starts_with("skip ") -> next
        rows.push(line.copy())
    }
    loop line in last_of(rows, 25) -> say(log, line)
    if checked.code != 0 {
        say(log, "PRECOMMIT FAILED for the batch; reverting")
        revert_batch(dir, applied, all, log)
        return 5
    }

    // Every commit is built in a private index, chained on the pre-batch HEAD;
    // nothing visible changes until the one compare-and-swap of HEAD.
    groups_of := [[String]]{}
    loop item in applied -> groups_of.push(item.paths.copy())
    roots: share_groups(groups_of)
    index: "{run}/batch-land.index.{sys.pid()}"
    files.remove(index) ?? ()
    tip := pre.copy()
    failure := ""
    landed := [String]{}
    if git_index(dir, index, [String]{"read-tree", pre}).code != 0 -> failure = "read-tree of the pre-batch HEAD failed"
    loop group in 0..<applied.len() {
        if failure != "" -> break
        if roots[group] != group -> next
        members := [Int]{}
        loop at in 0..<applied.len() {
            if roots[at] == group -> members.push(at)
        }
        message := ""
        names := [String]{}
        paths := [String]{}
        loop at in members {
            job: applied[at].job
            name: files.basename(job.patch)
            text: files.read(job.message) ?? {
                failure = "the message {job.message} cannot be read: {err}"
                break
            }
            if members.len() > 1 && message == "" -> message = "{text.partition("\n").head} (with {members.len() - 1} more landed together: shared files)\n\n"
            message = if members.len() == 1 -> text.copy() else -> "{message}== {job.lane} ({name})\n{text}\n"
            names.push("{job.lane} {name}")
            paths.extend(applied[at].paths.copy())
        }
        if failure != "" -> break
        made: chain_commit(dir, index, tip, "group [{names.join(" ")}]", paths, message) ?? {
            failure = err.message.copy()
            break
        }
        tip = made.copy()
        loop name in names -> landed.push("{made} {name}")
    }
    if failure == "" && regenerated.len() > 0 {
        made: chain_commit(dir, index, tip, "regenerated files", regenerated, "runtime: regenerated stop exports and lifecycle for the landed runtime routes (runtime generators)\n") ?? {
            failure = err.message.copy()
            ""
        }
        if made != "" {
            tip = made.copy()
            landed.push("{made} regenerated")
        }
    }
    // The chain must carry exactly the verified worktree: every path the batch
    // changed, nothing else. The verified tree starts from the pre-batch HEAD,
    // so a path the batch deleted counts when HEAD tracked it.
    if failure == "" {
        candidates := all.copy()
        extra := regenerated.copy()
        extra.extend(nul_paths(git(dir, [String]{"diff", "--name-only", "-z", pre})))
        loop path in extra {
            if !candidates.contains(path) -> candidates.push(path.copy())
        }
        tracked: nul_paths(git_paths(dir, "", [String]{"ls-tree", "-r", "-z", "--name-only", pre}, candidates))
        verified := [String]{}
        loop path in candidates {
            if on_disk(dir, path) || tracked.contains(path) -> verified.push(path.copy())
        }
        full: "{index}.full"
        files.remove(full) ?? ()
        want := ""
        if git_index(dir, full, [String]{"read-tree", pre}).code == 0 && git_paths(dir, full, [String]{"add", "-A"}, verified).code == 0 {
            written: git_index(dir, full, [String]{"write-tree"})
            if written.code == 0 -> want = written.output.trim()
        }
        files.remove(full) ?? ()
        chained: git(dir, [String]{"rev-parse", "{tip}^{{tree}}"}).output.trim()
        if want == "" || want != chained {
            shown_want: if want == "" -> "none" else -> want.copy()
            failure = "the commit chain's tree {short_sha(tip)} is not the verified worktree ({shown_want}): some changed path is in no commit"
            if want != "" -> say(log, "tree diff (chain vs verified): {git(dir, [String]{"diff-tree", "-r", "--name-status", chained, want}).output.trim_end().first_lines(20).join(" ")}")
        }
    }
    // Publish every commit at once: HEAD moves only if it is still the pre-batch HEAD.
    if failure == "" {
        moved: git(dir, [String]{"update-ref", "-m", "batch-land: {landed.len()} commit(s) on {short_sha(pre)}", "HEAD", tip, pre})
        if moved.code != 0 -> failure = "update-ref of HEAD {short_sha(pre)} -> {short_sha(tip)} failed (HEAD moved?): {first_line(moved)}"
    }
    files.remove(index) ?? ()
    if failure != "" {
        say(log, "!!!!!!!! BATCH COMMIT FAILED: {failure}")
        say(log, "!!!!!!!! nothing landed: this batch moved no ref (HEAD {git(dir, [String]{"rev-parse", "--short", "HEAD"}).output.trim()}, pre-batch {short_sha(pre)}); reverting the batch's worktree changes")
        loop item in applied -> say(log, "COMMIT FAILED {item.job.lane} {item.job.patch}")
        revert_batch(dir, applied, all, log)
        return 6
    }
    // The worktree already is the new HEAD; bring the index along.
    synced: git(dir, [String]{"read-tree", "--reset", "HEAD"}).code == 0 && git(dir, [String]{"update-index", "-q", "--refresh"}).code == 0
    if !synced -> say(log, "!!!!!!!! index sync after landing failed: run git read-tree --reset HEAD in {dir}")
    git(dir, [String]{"hook", "run", "--ignore-missing", "post-commit"})
    loop line in landed {
        parts: line.partition(" ")
        say(log, "COMMITTED {git(dir, [String]{"rev-parse", "--short", parts.head}).output.trim()} {parts.tail}")
    }
    say(log, "cleanup: {unstick(dir)}")
    head: git(dir, [String]{"rev-parse", "HEAD"}).output.trim()
    latest: publish_latest(dir)
    say(log, latest.line)
    // The published compiler is kept as base/<sha> for lanes (with its golden
    // census and jetpack, and seeded into the chain store).
    if latest.ok -> say(log, publish_base(tools, dir, head).line)
    say(log, "DONE HEAD {git(dir, [String]{"rev-parse", "--short", "HEAD"}).output.trim()}")
    say(log, release_train(tools, head))
    0
}

// `git apply` arguments that apply `patch` around the generated views, after
// `options` (`--check`, or none).
around_views: fn(options: [String], patch: String) -> [String] Never! {
    argv := [String]{"apply"}
    argv.extend(options.copy())
    loop view in GENERATED_VIEWS -> argv.push("--exclude={view}")
    argv.push(patch.copy())
    argv
}

// Stage `paths` in the private index and commit it on `tip` with `message`:
// the new commit. `what` names the commit in a failure.
chain_commit: fn(dir: String, index: String, tip: String, what: String, paths: [String], message: String) -[Exec, FS, Time.Wait]> String LandError! {
    // A path one member creates and a later one removes (a move within the
    // group) is neither on disk nor tracked; staging it would fail the group.
    tracked: nul_paths(git_paths(dir, index, [String]{"ls-files", "-z"}, paths))
    live := [String]{}
    loop path in paths {
        if path == "" || live.contains(path) -> next
        if on_disk(dir, path) || tracked.contains(path) -> live.push(path.copy())
    }
    if live.len() == 0 -> return Err(LandError{message: "{what}: none of its paths is on disk or tracked"})
    added: git_paths(dir, index, [String]{"add", "-A"}, live)
    if added.code != 0 -> return Err(LandError{message: "{what}: git add failed: {first_line(added)}"})
    tree: git_index(dir, index, [String]{"write-tree"})
    if tree.code != 0 -> return Err(LandError{message: "{what}: write-tree failed: {first_line(tree)}"})
    if tree.output.trim() == git(dir, [String]{"rev-parse", "{tip}^{{tree}}"}).output.trim() -> return Err(LandError{message: "{what}: would be an empty commit (its net change is nothing, or an earlier commit of this batch took it: a grouping bug)"})
    file: "{index}.msg"
    files.write(file, stripspace(message)) ?? return Err(LandError{message: "{what}: the message cannot be written to {file}: {err}"})
    made: git(dir, [String]{"commit-tree", tree.output.trim(), "-p", tip, "-F", file})
    files.remove(file) ?? ()
    if made.code != 0 -> return Err(LandError{message: "{what}: commit-tree failed: {first_line(made)}"})
    made.output.trim()
}

// Undo a batch: reverse-apply its patches (newest first), restore every path
// still dirty to HEAD and remove the untracked paths the batch created. A
// worktree still dirty after that stops the landing service.
revert_batch: fn(dir: String, applied: [Applied], all: [String], log: String) -[Exec, Env, FS, IO, Time.Wait]> {
    loop step in 0..<applied.len() {
        patch: applied[applied.len() - 1 - step].job.patch
        if git(dir, [String]{"apply", "-R", patch}).code != 0 -> say(log, "reverse-apply failed (restoring paths instead): {files.basename(patch)}")
    }
    loop path in dirty_paths(dir) {
        if git_paths(dir, "", [String]{"checkout", "HEAD"}, [String]{path}).code != 0 -> git_paths(dir, "", [String]{"rm", "-q", "--cached"}, [String]{path})
    }
    tracked: nul_paths(git_paths(dir, "", [String]{"ls-files", "-z"}, all))
    loop path in all {
        if !on_disk(dir, path) || tracked.contains(path) -> next
        full: files.join(dir, path)
        if files.is_dir(full) -> files.remove_all(full) ?? () else -> files.remove(full) ?? ()
    }
    left: git(dir, [String]{"status", "--porcelain", "--untracked-files=no"}).output
    if left.trim() == "" -> return
    say(log, "REVERT LEFT THE WORKTREE DIRTY")
    loop line in left.trim_end().first_lines(20) -> say(log, line)
    files.write("{run_root()}/lander.stop", "") ?? ()
}

// Revert what failed landings left uncommitted in the worktree `dir`: every
// path that differs from HEAD goes back to HEAD, and the files they added are
// removed. Returns a summary.
unstick: fn(dir: String) -[Exec, FS, Time.Wait]> String Never! {
    paths: nul_paths(git(dir, [String]{"diff", "--name-only", "-z", "HEAD"}))
    added: nul_paths(git(dir, [String]{"diff", "--name-only", "-z", "--diff-filter=A", "HEAD"}))
    summary: "changed {paths.len()} added {added.len()}"
    if paths.len() == 0 -> return summary
    git_paths(dir, "", [String]{"reset", "-q"}, paths)
    loop path in added -> files.remove(files.join(dir, path)) ?? ()
    tracked: nul_paths(git(dir, [String]{"diff", "--name-only", "-z", "--diff-filter=MD", "HEAD"}))
    if tracked.len() > 0 -> git_paths(dir, "", [String]{"checkout", "-q"}, tracked)
    left: git(dir, [String]{"status", "--porcelain", "--untracked-files=no"}).output.trim_end().lines().len()
    "{summary} left: {left}"
}

// `serve`: the landing service. Every cycle it admits each queued job
// (`prescreen`), lands the admitted ones as one batch and, when the batch
// fails, bisects it, lands every clean half and returns each failing job to
// its lane with the rows.
serve_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    if args.len() != 0 -> usage()
    tools: tools_checkout()
    worktree: dev_worktree()
    if tools == "" || worktree == "" {
        term.eprint("serve: no dev worktree (set JET_DEV_WORKTREE or run in the checkout)")
        return 2
    }
    run: run_root()
    queue: "{run}/land-queue"
    results: "{run}/land-results"
    log: "{run}/lander.log"
    made: [String]{"{queue}/taken", results}
    loop dir in made {
        files.create_dir_all(dir) ?? {
            term.eprint("serve: {dir} cannot be created: {err}")
            return 2
        }
    }
    note(log, "lander up")
    loop {
        if files.exists("{run}/lander.stop") {
            note(log, "lander stopping")
            return 0
        }
        // A dirty shared worktree (someone mid-commit) is never the patches' fault: wait.
        if git(worktree, [String]{"status", "--porcelain", "--untracked-files=no"}).output.trim() != "" {
            time.sleep(30s)
            next
        }
        queued := [Job]{}
        names := [String]{}
        loop entry in entries(queue) {
            if !entry.is_dir && entry.name.ends_with(".job") -> names.push(entry.name.copy())
        }
        names.sort()
        loop name in names {
            text: files.read("{queue}/{name}") ?? next
            found: read_jobs(text.partition("\n").head)
            if found.len() == 0 {
                files.rename("{queue}/{name}", "{queue}/taken/{name}") ?? ()
                files.write("{results}/{name.removesuffix(".job")}.result", "REJECTED the job file is not LANE<TAB>MSG<TAB>PATCH\n") ?? ()
                next
            }
            job := found[0].copy()
            job.name = name.removesuffix(".job")
            queued.push(job)
        }
        if queued.len() > 0 {
            admitted: admit(tools, queue, results, log, queued)
            if admitted.len() == 0 {
                time.sleep(30s)
                next
            }
            list: "{queue}/taken/batch-{epoch()}.list"
            lines := [String]{}
            loop job in admitted -> lines.push(job_line(job))
            files.write(list, "{lines.join("\n")}\n") ?? ()
            note(log, "batch: {admitted.len()} job(s)")
            land_bisecting(tools, worktree, results, log, list, admitted)
            note(log, "batch done; HEAD {git(worktree, [String]{"rev-parse", "--short", "HEAD"}).output.trim()}")
        }
        time.sleep(60s)
    }
}

// `line` appended to the service log, after the time.
note: fn(log: String, line: String) -[FS, Time]> {
    files.append_all(log, "{stamp()} {line}\n") ?? ()
}

// The queued jobs admitted to a batch. All at once when HEAD with every
// queued patch checks clean (one seed check); else one by one, each after the
// jobs admitted before it. A refused job gets its result; every job leaves the
// queue.
admit: fn(tools: String, queue: String, results: String, log: String, queued: [Job]) -[Exec, Env, FS, IO, Time, Time.Wait]> [Job] Never! {
    if queued.len() > 1 {
        stacked := [String]{"Tools/agent/Land.jet", "prescreen", queued[queued.len() - 1].patch.copy()}
        loop at in 0..<(queued.len() - 1) -> stacked.push(queued[at].patch.copy())
        if seed_run(tools, stacked, 0).code == 0 {
            loop job in queued -> files.rename("{queue}/{job.name}.job", "{queue}/taken/{job.name}.job") ?? ()
            note(log, "prescreen clean (stacked) {queued.len()} job(s)")
            return queued.copy()
        }
        note(log, "stacked prescreen failed; admitting one by one")
    }
    admitted := [Job]{}
    loop job in queued {
        args := [String]{"Tools/agent/Land.jet", "prescreen", job.patch.copy()}
        loop earlier in admitted -> args.push(earlier.patch.copy())
        screened: seed_run(tools, args, 0)
        files.rename("{queue}/{job.name}.job", "{queue}/taken/{job.name}.job") ?? ()
        if screened.code != 0 {
            verdict: if screened.code == 3 -> "STALE does not apply to HEAD; rebase" else -> "REJECTED at prescreen (seed check of HEAD + this patch alone)"
            files.write("{results}/{job.name}.result", "{verdict}\n{both(screened).trim_end()}\n") ?? ()
            note(log, "prescreen rejected {job.name}")
            next
        }
        note(log, "prescreen clean {job.name}")
        admitted.push(job.copy())
    }
    admitted
}

// Land `jobs` as one batch; when it fails, land each half the same way. A
// lane's jobs are a stack: once one did not land, its later ones in the
// second half are left for the lane.
land_bisecting: fn(tools: String, worktree: String, results: String, log: String, list: String, jobs: [Job]) -[Exec, Env, FS, IO, Time, Time.Wait]> {
    code: batch(tools, worktree, jobs)
    report: files.read("{run_root()}/batch-land.log") ?? ""
    files.write("{list}.out", report) ?? ()
    files.append_all(log, report) ?? ()
    if code == 0 {
        write_results(results, jobs, report, "ok")
        return
    }
    if jobs.len() <= 1 {
        why: if code == 6 -> "the batch could not be committed (nothing landed; see BATCH COMMIT FAILED)" else -> "precommit failed for this patch"
        write_results(results, jobs, report, why)
        return
    }
    half: (jobs.len() + 1) /% 2
    first := [Job]{}
    second := [Job]{}
    loop at in 0..<jobs.len() {
        if at < half -> first.push(jobs[at].copy()) else -> second.push(jobs[at].copy())
    }
    note(log, "batch of {jobs.len()} failed (rc {code}); bisecting {half} + {jobs.len() - half}")
    land_bisecting(tools, worktree, results, log, "{list}.a", first)
    // A lane whose job in the first half did not land keeps its later jobs.
    failed := [String:String]{}
    loop job in first {
        result: files.read("{results}/{job.name}.result") ?? ""
        if !result.starts_with("LANDED") -> failed[job.lane] = job.name.copy()
    }
    rest := [Job]{}
    loop job in second {
        if failed.get(job.lane) == .Val(base) {
            files.write("{results}/{job.name}.result", "STALE an earlier patch of its stack did not land ({base}); rebase the stack onto HEAD\n") ?? ()
            note(log, "stack: {job.name} left for its lane ({base} did not land)")
            next
        }
        rest.push(job.copy())
    }
    if rest.len() > 0 -> land_bisecting(tools, worktree, results, log, "{list}.b", rest)
}

// Each job's result file from a batch report: LANDED <sha>, STALE (does not
// apply), LANDED already-on-dev, or REJECTED `why` with the report's tail.
write_results: fn(results: String, jobs: [Job], report: String, why: String) -[FS]> {
    loop job in jobs -> files.write("{results}/{job.name}.result", job_result(job, report, why)) ?? ()
}

job_result: fn(job: Job, report: String, why: String) -> String Never! {
    name: files.basename(job.patch)
    landed := ""
    stale_stack := false
    stale := false
    skipped := false
    loop line in report.lines() {
        if line.starts_with("COMMITTED ") && line.ends_with(" {job.lane} {name}") {
            landed = line.remove_prefix("COMMITTED ").partition(" ").head.copy()
            next
        }
        if line.starts_with("DOES NOT APPLY {job.lane} {name} - an earlier patch of its stack did not apply") -> stale_stack = true
        if line.starts_with("DOES NOT APPLY {job.lane} {name} ") -> stale = true
        if line == "SKIP (already on dev) {job.lane} {name}" -> skipped = true
    }
    if landed != "" -> return "LANDED {landed}\n"
    if stale_stack -> return "STALE an earlier patch of its stack did not apply; rebase the stack onto HEAD\n"
    if stale -> return "STALE does not apply to HEAD; rebase\n"
    if skipped -> return "LANDED already-on-dev\n"
    tail := [String]{}
    loop line in report.lines() {
        if !line.starts_with("nm: ") -> tail.push(line.copy())
    }
    "REJECTED {why}\n{last_of(tail, 25).join("\n")}\n"
}

// --- publishing -------------------------------------------------------------

// The published compilers kept, newest first by publish time (plus the newest
// one with a finished golden census).
BASE_KEEP: 6
// The paths a hosted jetpack is built from (with the compiler they make): a
// published jetpack is reused for a commit that changes none of them.
JETPACK_INPUTS: [String]{"Jetpack", "Core", "Compiler"}
GOLD_EXCLUDE: "Systems/Process/OSProcessControl"

publish_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    if args.len() == 0 -> usage()
    tools: tools_checkout()
    step: if {
        args.len() == 1 && args[0] == "latest" -> publish_latest(dev_worktree())
        args.len() == 2 && args[0] == "base" -> publish_base(tools, dev_worktree(), args[1])
        args.len() == 1 && args[0] == "golden-worker" -> return golden_worker_main(tools)
        args.len() == 1 && args[0] == "golden-run" -> return golden_run(dev_worktree())
        args.len() == 2 && args[0] == "jetpack" -> return jetpack_run(dev_worktree(), args[1])
        else -> usage()
    }
    print(step.line)
    if step.ok -> 0 else -> 1
}

// `publish latest`: the batch-verified compiler (the census s1, built from
// HEAD and the batch) with the runtime pack its build made becomes
// $JET_SCRATCH_ROOT/discovery/b2/install-latest (an atomic swap), with COMMIT
// (HEAD of the worktree `dir`) and IDENTITY (the seed's).
publish_latest: fn(dir: String) -[Exec, Env, FS, Time.Wait]> Step Never! {
    scratch: scratch_root()
    b2: "{scratch}/discovery/b2"
    s1: "{scratch}/discovery/r14/snap/Compiler/JetCli/.jet/build/jet"
    pack: "{scratch}/discovery/r14/snap/Compiler/JetCli/.jet/build/jet-runtime"
    if !files.is_file(s1) -> return Step{ok: false, line: "publish-latest: no census compiler"}
    if !files.exists("{pack}/native.key") -> return Step{ok: false, line: "publish-latest: the census build made no runtime pack"}
    staged: "{b2}/install-latest.new.{sys.pid()}"
    files.remove_all(staged) ?? ()
    files.create_dir_all(staged) ?? return Step{ok: false, line: "publish-latest: {staged} cannot be created: {err}"}
    files.copy(s1, "{staged}/jet") ?? return Step{ok: false, line: "publish-latest: {s1} cannot be copied: {err}"}
    files.set_mode("{staged}/jet", 0o755) ?? return Step{ok: false, line: "publish-latest: {staged}/jet cannot be made executable: {err}"}
    files.copy_dir(pack, "{staged}/jet-runtime") ?? return Step{ok: false, line: "publish-latest: the runtime pack {pack} cannot be copied: {err}"}
    commit: git(dir, [String]{"rev-parse", "HEAD"}).output.trim()
    files.write("{staged}/COMMIT", "{commit}\n") ?? return Step{ok: false, line: "publish-latest: COMMIT cannot be written: {err}"}
    files.copy("{seed_dir()}/IDENTITY", "{staged}/IDENTITY") ?? return Step{ok: false, line: "publish-latest: the seed's IDENTITY cannot be copied: {err}"}
    current: "{b2}/install-latest"
    files.remove_all("{current}.old") ?? ()
    if files.is_dir(current) -> files.rename(current, "{current}.old") ?? ()
    files.rename(staged, current) ?? return Step{ok: false, line: "publish-latest: {staged} cannot become {current}: {err}"}
    files.remove_all("{current}.old") ?? ()
    Step{ok: true, line: "published install-latest at {first_line_of("{current}/COMMIT")}"}
}

// `publish base COMMIT`: keep install-latest, which must say COMMIT, as
// $JET_BASE_ROOT/<sha>/{jet,jet-runtime/,IDENTITY,COMMIT,GENERATION} for
// lanes (base/latest names the newest; the BASE_KEEP newest stay), seed it
// into the chain stage store (`Tools/agent/Chain.jet seed-published`), copy a jetpack an
// input-identical published commit has, and want its golden census.
publish_base: fn(tools: String, repo: String, commit: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Step Never! {
    latest: "{scratch_root()}/discovery/b2/install-latest"
    base: base_root()
    files.create_dir_all(base) ?? return Step{ok: false, line: "publish-base: {base} cannot be created: {err}"}
    parsed: git(repo, [String]{"rev-parse", "--verify", "{commit}^{{commit}}"})
    if parsed.code != 0 -> return Step{ok: false, line: "publish-base: unknown commit {commit}"}
    sha: parsed.output.trim()
    published: first_line_of("{latest}/COMMIT")
    if published != sha -> return Step{ok: false, line: "publish-base: install-latest is {short_sha(published)}, not {short_sha(sha)}; nothing published"}
    dir: "{base}/{sha}"
    state := "already published"
    if !files.is_dir(dir) {
        staged: "{base}/.new.{sys.pid()}"
        files.remove_all(staged) ?? ()
        copied: copy_install(latest, staged)
        if copied != "" {
            files.remove_all(staged) ?? ()
            return Step{ok: false, line: "publish-base: copy failed: {copied}"}
        }
        same: first_line_of("{staged}/COMMIT") == sha && (files.read_bytes("{staged}/jet") ?? [U8]{}) == (files.read_bytes("{latest}/jet") ?? [U8]{0})
        if !same {
            files.remove_all(staged) ?? ()
            return Step{ok: false, line: "publish-base: install-latest changed while copying; nothing published"}
        }
        files.write("{staged}/.published", "{stamp()}\n") ?? ()
        // The published compiler is stage s1 (built by the seed); a lane A/B must compare s2 with s2.
        seed_name: files.read_link(root("JET_SEED", "{seeds_root()}/current")) ?? seed_dir()
        files.write("{staged}/GENERATION", "generation=s1\nbuilt_by_seed={seed_name}\nnote=an A/B of a lane s2 against this compiler compares two code generations; build a base s2 for same-generation A/Bs\n") ?? ()
        files.rename(staged, dir) ?? files.remove_all(staged) ?? ()
        state = "published"
    }
    link: "{base}/.latest.{sys.pid()}"
    files.remove(link) ?? ()
    files.symlink(sha, link) ?? ()
    files.rename(link, "{base}/latest") ?? ()
    prune_bases(base)
    seeding := process.cmd([String]{"{seed_dir()}/jet", "Tools/agent/Chain.jet", "seed-published", dir}).cwd(tools).output_limit(268435456)
    loop setting in unit_env(tools) -> seeding = seeding.env(setting.name, setting.value)
    seeded: if seeding.run() == .Ok(receipt) -> "{receipt.output}{receipt.errors}".trim_end().last_lines(1).join("") else -> "seed-published: Tools/agent/Chain.jet could not start"
    // A jetpack whose inputs did not change is copied now; otherwise the golden run builds one after its census.
    jetpack: if jetpack_reuse(repo, base, sha) -> "jetpack ready" else -> "jetpack build follows the golden census"
    Step{ok: true, line: "publish-base: {state} {dir}; {seeded}; {jetpack}; {want_goldens(tools, base, sha)}"}
}

// Copy the compiler of the install `from` into the new directory `to`; "" or
// what failed.
copy_install: fn(from: String, to: String) -[FS]> String Never! {
    files.create_dir_all(to) ?? return "{to}: {err}"
    names: [String]{"jet", "IDENTITY", "COMMIT"}
    loop name in names {
        files.copy("{from}/{name}", "{to}/{name}") ?? return "{from}/{name}: {err}"
    }
    files.set_mode("{to}/jet", 0o755) ?? return "{to}/jet: {err}"
    files.copy_dir("{from}/jet-runtime", "{to}/jet-runtime") ?? return "{from}/jet-runtime: {err}"
    ""
}

// Keep the BASE_KEEP newest published bases, plus the newest one with a
// finished goldens.json, so lanes always have a golden baseline.
prune_bases: fn(base: String) -[FS]> {
    published := [Dated]{}
    golden := ""
    golden_time := -1
    loop entry in entries(base) {
        if entry.name.starts_with(".") || entry.name == "latest" -> next
        dir: "{base}/{entry.name}"
        if files.exists("{dir}/.published") -> published.push(Dated{path: dir, time: mtime("{dir}/.published")})
        if files.exists("{dir}/goldens.json") && mtime("{dir}/goldens.json") > golden_time {
            golden = dir
            golden_time = mtime("{dir}/goldens.json")
        }
    }
    sorted: newest_first(published)
    loop at in 0..<sorted.len() {
        if at < BASE_KEEP || sorted[at].path == golden -> next
        files.remove_all(sorted[at].path) ?? ()
    }
}

// Want one golden census of `sha`, and start the golden worker unless one is
// alive (a live worker re-reads the want, under the same lock, before it exits).
want_goldens: fn(tools: String, base: String, sha: String) -[Exec, Env, FS, Time, Time.Wait]> String Never! {
    _want: files.lock("{base}/.golden-want.lock") ?? return "golden run not wanted: the want lock cannot be taken: {err}"
    files.write("{base}/.golden-want.new", "{sha}\n") ?? return "golden run not wanted: {err}"
    files.rename("{base}/.golden-want.new", "{base}/.golden-want") ?? return "golden run not wanted: {err}"
    if !lock_free("{base}/.golden-worker.lock") -> return "golden run wanted (worker busy; it takes the newest)"
    started: start_unit(tools, "base-goldens-{sha.slice(0..<9)}-{epoch()}", [String]{"MemoryMax=4G", "MemorySwapMax=0", "LimitCORE=0"}, [String]{"publish", "golden-worker"}, "{base}/goldens-worker.log")
    if started.code == 0 -> "golden run queued" else -> "golden worker failed to start: {first_line(started)}"
}

// The wanted commit whose golden census has not run, "" when there is none.
golden_wanted: fn(base: String) -[FS]> String Never! {
    sha: first_line_of("{base}/.golden-want")
    dir: "{base}/{sha}"
    if sha == "" || !files.is_dir(dir) || files.exists("{dir}/goldens.json") || files.exists("{dir}/goldens.failed") -> return ""
    sha
}

// `publish golden-worker` (a user unit): run golden censuses in build slots
// while one is wanted. A run takes the newest wanted commit when its slot
// starts, so older wanted ones are skipped.
golden_worker_main: fn(tools: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    base: base_root()
    worker: files.try_lock("{base}/.golden-worker.lock") ?? return 0
    loop {
        want: files.lock("{base}/.golden-want.lock") ?? {
            print("{stamp()} worker: the want lock cannot be taken: {err}")
            return 1
        }
        if golden_wanted(base) == "" {
            // The worker lock goes first, under the want lock: a publish that
            // then finds no worker starts a new one.
            close(worker)
            close(want)
            return 0
        }
        close(want)
        print("{stamp()} worker: queueing a golden run (want {short_sha(first_line_of("{base}/.golden-want"))})")
        argv := [String]{"{seed_dir()}/jet", "Tools/agent/Chain.jet", "slot", "--", "{seed_dir()}/jet", "Tools/agent/Land.jet", "publish", "golden-run"}
        spec := process.cmd(argv).cwd(tools).env("SLOT_SMALL", "0").output_limit(268435456)
        loop setting in unit_env(tools) -> spec = spec.env(setting.name, setting.value)
        receipt: spec.run() ?? {
            print("{stamp()} worker: the build slot cannot start: {err}")
            return 1
        }
        if receipt.output.trim() != "" -> print(receipt.output.trim_end())
        if receipt.errors.trim() != "" -> print(receipt.errors.trim_end())
    }
}

// `publish golden-run` (inside a build slot): the golden census of the newest
// wanted commit with its published compiler and pack, from an export of it:
// the Examples rows of `jet test Compiler --profile golden` at the none level
// minus the GOLD_EXCLUDE example stems (each must drop a row). Writes
// goldens.json (the --results document) and goldens.meta, or goldens.failed
// when the census produced no counts; then the commit's jetpack.
golden_run: fn(repo: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    base: base_root()
    sha: golden_wanted(base)
    if sha == "" -> return 0
    dir: "{base}/{sha}"
    work: "{base}/.work/{sha.slice(0..<9)}"
    files.remove_all(work) ?? ()
    code: golden_census(repo, base, sha, dir, work)
    files.remove_all(work) ?? ()
    code
}

golden_census: fn(repo: String, base: String, sha: String, dir: String, work: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    tree: "{work}/tree"
    dirs: [String]{tree, "{work}/state", "{work}/tmp"}
    loop path in dirs -> files.create_dir_all(path) ?? ()
    print("{stamp()} goldens {short_sha(sha)}: export")
    export_tree(repo, sha, tree, [String]{}) ?? {
        files.write("{dir}/goldens.failed", "export failed: {err.message}\n") ?? ()
        return 1
    }
    identity: read_identity(dir)
    exclude := [String]{}
    loop stem in (process.env_get("GOLD_EXCLUDE") ?? GOLD_EXCLUDE).split(" ") {
        if stem != "" -> exclude.push(stem.copy())
    }
    listed: run_in_env(tree, [String]{"{dir}/jet", "test", "Compiler", "--profile", "golden", "--optimize=none", "--list"}, compile_env(identity, tree, ""))
    rows: golden_rows(listed.output, exclude) ?? {
        files.write("{dir}/goldens.failed", "golden selection failed\n{err.message}\n{listed.errors.trim_end().last_lines(20).join("\n")}\n") ?? ()
        return 1
    }
    if rows.len() == 0 {
        files.write("{dir}/goldens.failed", "golden selection failed: no rows\n{listed.errors.trim_end().last_lines(20).join("\n")}\n") ?? ()
        return 1
    }
    selection: "{work}/select.txt"
    files.write(selection, "{rows.join("\n")}\n") ?? ()
    results: "{work}/goldens.json"
    start: epoch()
    print("{stamp()} goldens {short_sha(sha)}: {rows.len()} examples with {dir}/jet")
    // Golden examples run host tools (C compilers, interpreters) that only the
    // dev shell (Tools/agent/JetEnv.jet) supplies until jet does.
    cpus: env_or("SLOT_CPUS", "")
    argv := [String]{"systemd-run", "--user", "--scope", "-q", "--expand-environment=no", "-p", "MemoryMax=24G", "-p", "MemorySwapMax=0", "timeout", "7200", "prlimit", "--core=0", HEAVY_STACK, "--"}
    if cpus != "" -> argv.extend([String]{"taskset", "-c", cpus})
    argv.extend([String]{"{dir}/jet", "{tree}/Tools/agent/JetEnv.jet", "{dir}/jet", "test", "Compiler", "--profile", "golden", "--optimize=none", "--cases={selection}", "--jobs=6", "--time-limit=120s", "--results={results}"})
    env := compile_env(identity, tree, "")
    env.push(Setting{name: "JET_TEST_STATE_DIR", value: "{work}/state"})
    env.push(Setting{name: "TMPDIR", value: "{work}/tmp"})
    code: run_logged(tree, argv, env, "{work}/goldens")
    if !files.is_dir(dir) -> return 0
    secs: epoch() - start
    counts: results_counts(files.read(results) ?? "")
    if {
        counts != "" -> {
            files.rename(results, "{dir}/goldens.json.tmp") ?? ()
            files.rename("{dir}/goldens.json.tmp", "{dir}/goldens.json") ?? ()
            meta: [String]{"commit={sha}", "compiler={dir}/jet", "identity={identity}", "examples={rows.len()}", "exclude={exclude.join(" ")}", "args=--profile golden --optimize=none --cases --jobs=6 --time-limit=120s", "rc={code}", "secs={secs}", "cpus={cpus}", "counts={counts}", "finished={stamp()}"}
            files.write("{dir}/goldens.meta", "{meta.join("\n")}\n") ?? ()
            print("{stamp()} goldens {short_sha(sha)}: {counts} in {secs}s")
        }
        else -> {
            errors: files.read("{work}/goldens.err") ?? ""
            output: files.read("{work}/goldens.out") ?? ""
            clipped := [String]{}
            loop line in output.trim_end().last_lines(20) -> clipped.push(clip(line, 400))
            size: (files.read_bytes(results) ?? [U8]{}).len()
            files.write("{dir}/goldens.failed", "rc={code}: no counts after {secs}s; results bytes {size}\n-- stderr tail\n{errors.trim_end().last_lines(60).join("\n")}\n-- stdout tail\n{clipped.join("\n")}\n") ?? ()
            files.write("{dir}/goldens.err", errors) ?? ()
            files.write("{dir}/goldens.stdout", output) ?? ()
            print("{stamp()} goldens {short_sha(sha)}: FAILED rc={code}")
        }
    }
    jetpack_build(repo, base, sha, tree, "{work}/tmp")
    0
}

// `argv` in `dir` with `env` added.
run_in_env: fn(dir: String, argv: [String], env: [Setting]) -[Exec, Time.Wait]> Ran Never! {
    spec := process.cmd(argv).cwd(dir).output_limit(268435456)
    loop setting in env -> spec = spec.env(setting.name, setting.value)
    receipt: spec.run() ?? return Ran{code: 127, output: "", errors: "{argv[0]}: {err}"}
    code: if receipt.signal == .Val(_) -> 128 else -> receipt.code
    Ran{code: code, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

// The golden census rows of a `jet test --list` (`suite<TAB>path`): the
// golden Examples rows minus the `exclude` example stems. Each stem must drop
// a row, or the exclusion could not hold.
golden_rows: fn(listed: String, exclude: [String]) -> [String] LandError! {
    hit := [Bool]{}
    loop _ in exclude -> hit.push(false)
    rows := [String]{}
    loop line in listed.lines() {
        fields: line.partition("\t")
        path: fields.tail.partition("\t").head
        if fields.head != "golden" || !path.starts_with("Examples/") -> next
        dropped := false
        loop at in 0..<exclude.len() {
            file: "Examples/{exclude[at]}.jet"
            stem: "Examples/{exclude[at]}"
            under: "{stem}/"
            if path == file || path == stem || path.starts_with(under) {
                hit[at] = true
                dropped = true
            }
        }
        if !dropped -> rows.push(path.copy())
    }
    loop at in 0..<exclude.len() {
        if !hit[at] -> return Err(LandError{message: "exclusion {exclude[at]} matched no example"})
    }
    rows
}

// The `"counts":{...}` object a results document opens with, "" when it has none.
results_counts: fn(text: String) -> String Never! {
    parts: text.partition("\"counts\":{{")
    if parts.sep == "" -> return ""
    body: parts.tail.partition("}}")
    if body.sep == "" -> return ""
    "{{{body.head}}}"
}

// Is base/SHA's jetpack there, or copied now from a published commit with
// the same JETPACK_INPUTS?
jetpack_reuse: fn(repo: String, base: String, sha: String) -[Exec, FS, Time.Wait]> Bool Never! {
    dir: "{base}/{sha}"
    if files.is_file("{dir}/jetpack") -> return true
    if !files.is_dir(dir) -> return false
    built := [Dated]{}
    loop entry in entries(base) {
        if entry.name.starts_with(".") || entry.name == "latest" || entry.name == sha -> next
        jetpack: "{base}/{entry.name}/jetpack"
        if files.is_file(jetpack) && files.is_file("{base}/{entry.name}/jetpack.receipt") -> built.push(Dated{path: entry.name.copy(), time: mtime(jetpack)})
    }
    loop prev in newest_first(built) {
        args := [String]{"diff", "--quiet", prev.path, sha, "--"}
        args.extend(JETPACK_INPUTS.copy())
        if git(repo, args).code != 0 -> next
        // The receipt first: Tools/agent/Suite.jet keys on the jetpack file, so it never sees a jetpack without its receipt.
        receipt: (files.read("{base}/{prev.path}/jetpack.receipt") ?? "").trim_end()
        files.write("{dir}/.jetpack.receipt.tmp", "{receipt}\nreused-for: {sha}\nreused-from: {prev.path} (no change under {JETPACK_INPUTS.join(" ")} between them)\n") ?? return false
        files.rename("{dir}/.jetpack.receipt.tmp", "{dir}/jetpack.receipt") ?? return false
        files.copy("{base}/{prev.path}/jetpack", "{dir}/.jetpack.tmp") ?? return false
        files.set_mode("{dir}/.jetpack.tmp", 0o755) ?? return false
        files.rename("{dir}/.jetpack.tmp", "{dir}/jetpack") ?? return false
        return true
    }
    false
}

// The hosted jetpack engine of base/SHA (inside a build slot; `tree` is an
// export of SHA): reused when it can be, else built by its published compiler.
jetpack_build: fn(repo: String, base: String, sha: String, tree: String, tmp: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Bool Never! {
    dir: "{base}/{sha}"
    if !files.is_dir(dir) -> return true
    if jetpack_reuse(repo, base, sha) {
        from: (files.read("{dir}/jetpack.receipt") ?? "").partition("reused-from: ").tail.partition(" ").head
        shown: if from == "" -> "present" else -> "reused from {short_sha(from)}"
        print("{stamp()} jetpack {short_sha(sha)}: {shown}")
        return true
    }
    worker: "base-{sha.slice(0..<9)}"
    start: epoch()
    print("{stamp()} jetpack {short_sha(sha)}: hosted build with {dir}/jet")
    files.create_dir_all(tmp) ?? ()
    argv := [String]{"systemd-run", "--user", "--scope", "-q", "--expand-environment=no", "-p", "MemoryMax=16G", "-p", "MemorySwapMax=0", "timeout", "6000", "prlimit", "--core=0", "--"}
    cpus: env_or("SLOT_CPUS", "")
    if cpus != "" -> argv.extend([String]{"taskset", "-c", cpus})
    argv.extend([String]{"{dir}/jet", "Jetpack/Bootstrap/Check.jet", "--hosted"})
    env := compile_env(read_identity(dir), tree, "")
    env.push(Setting{name: "JETPACK_WORKER", value: worker.copy()})
    env.push(Setting{name: "JET", value: "{dir}/jet"})
    env.push(Setting{name: "TMPDIR", value: tmp.copy()})
    built: run_in_env(tree, argv, env)
    files.write("{dir}/jetpack.log", both(built)) ?? ()
    bootstrap: "{state_root()}/jetpack-bootstrap"
    runs := [Dated]{}
    loop entry in entries(bootstrap) {
        if !entry.name.starts_with("{worker}-") -> next
        bin: "{bootstrap}/{entry.name}/hosted/project/.jet/build/jetpack"
        if files.is_file(bin) -> runs.push(Dated{path: "{bootstrap}/{entry.name}", time: mtime(bin)})
    }
    newest: newest_first(runs)
    if built.code != 0 || newest.len() == 0 {
        shown: if newest.len() == 0 -> "none" else -> "{newest[0].path}/hosted/project/.jet/build/jetpack"
        files.write("{dir}/jetpack.failed", "rc={built.code} bin={shown}; see jetpack.log\n") ?? ()
        print("{stamp()} jetpack {short_sha(sha)}: FAILED rc={built.code}")
        return false
    }
    run: newest[0].path
    files.copy("{run}/hosted/project/.jet/build/jetpack", "{dir}/.jetpack.tmp") ?? return false
    files.set_mode("{dir}/.jetpack.tmp", 0o755) ?? return false
    files.rename("{dir}/.jetpack.tmp", "{dir}/jetpack") ?? return false
    receipt: (files.read("{run}/hosted.receipt") ?? "").trim_end()
    lead: if receipt == "" -> "" else -> "{receipt}\n"
    files.write("{dir}/.jetpack.receipt.tmp", "{lead}commit: {sha}\nsecs: {epoch() - start}\n") ?? ()
    files.rename("{dir}/.jetpack.receipt.tmp", "{dir}/jetpack.receipt") ?? ()
    files.remove("{dir}/jetpack.failed") ?? ()
    loop entry in entries(bootstrap) {
        if entry.name.starts_with("{worker}-") -> files.remove_all("{bootstrap}/{entry.name}") ?? ()
    }
    digest: crypto.sha256(files.read_bytes("{dir}/jetpack") ?? [U8]{}).hex().slice(0..<12)
    print("{stamp()} jetpack {short_sha(sha)}: built in {epoch() - start}s sha256={digest}")
    true
}

// `publish jetpack COMMIT` (inside a build slot): give an already-published
// base its jetpack (reused, else built from an export of COMMIT).
jetpack_run: fn(repo: String, commit: String) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    parsed: git(repo, [String]{"rev-parse", "--verify", "{commit}^{{commit}}"})
    if parsed.code != 0 {
        print("unknown commit {commit}")
        return 1
    }
    sha: parsed.output.trim()
    base: base_root()
    if !files.is_dir("{base}/{sha}") {
        print("not published: {base}/{sha}")
        return 1
    }
    if jetpack_reuse(repo, base, sha) {
        print("{stamp()} jetpack {short_sha(sha)}: present or reused")
        return 0
    }
    work: "{base}/.work/jp-{sha.slice(0..<9)}"
    files.remove_all(work) ?? ()
    built: export_tree(repo, sha, "{work}/tree", [String]{}) == .Ok(_) && jetpack_build(repo, base, sha, "{work}/tree", "{work}/tmp")
    files.remove_all(work) ?? ()
    if built -> 0 else -> 1
}

// --- the release train ------------------------------------------------------

release_root: fn() -[Env, FS]> String Never! { env_or("JET_RELEASE_WORK", "{state_root()}/release") }

release_train_main: fn(args: [String]) -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    if args.len() != 1 -> usage()
    if args[0] == "--run" -> return release_train_run()
    line: release_train(tools_checkout(), args[0])
    if line != "" -> print(line)
    0
}

// `release-train SHA`: record SHA as the newest pending dev HEAD and start the
// train unless Main paused it; returns at once.
release_train: fn(tools: String, sha: String) -[Exec, Env, FS, Time, Time.Wait]> String Never! {
    work: release_root()
    files.create_dir_all(work) ?? return "release train: {work} cannot be created: {err}"
    files.write("{work}/pending.new", "{sha}\n") ?? return "release train: {err}"
    files.rename("{work}/pending.new", "{work}/pending") ?? return "release train: {err}"
    // Main pauses the train while a known blocker fails every gate; the pending HEAD stays recorded.
    if files.exists("{work}/paused") -> return "release train paused; pending {short_sha(sha)}"
    started: start_unit(tools, "release-train-{epoch()}", [String]{"LimitCORE=0"}, [String]{"release-train", "--run"}, "{work}/train.log")
    if started.code != 0 -> return "release train failed to start: {first_line(started)}"
    ""
}

// `release-train --run`: one train at a time gates the newest pending HEAD
// with `Tools/release/Main.jet -- admit` (run by the seed), then the newest
// that arrived meanwhile; intermediate HEADs are skipped. The gate releases
// only with at least RELEASE_MIN_GAINS gained rows; a "gains FAIL" just means
// wait for more landings. A pass writes the next a0.0.N and the commands, and
// says RELEASE READY on the batch log for Main; nothing is merged, tagged,
// pushed or made current here.
release_train_run: fn() -[Exec, Env, FS, IO, Time, Time.Wait]> Int Never! {
    work: release_root()
    dev: env_or("RELEASE_DEV", dev_worktree())
    log: env_or("RELEASE_LOG", "{run_root()}/batch-land.log")
    // Another train holds the lock: it takes the newest pending HEAD.
    _train: files.try_lock("{work}/train.flock") ?? return 0
    loop {
        head: first_line_of("{work}/pending")
        if head == "" -> break
        files.remove("{work}/pending") ?? ()
        out: "{work}/train-{head.slice(0..<12)}.log"
        gated: seed_run(dev, [String]{"run", "Tools/release/Main.jet", "--", "admit", head, "--min-gains", env_or("RELEASE_MIN_GAINS", "10")}, 43200)
        files.write(out, both(gated)) ?? ()
        files.append_all(log, "{train_verdict(gated.code, both(gated), head, out)}\n") ?? ()
    }
    0
}

// The batch-log line of a release gate run of `head`.
train_verdict: fn(code: Int, output: String, head: String, out: String) -> String Never! {
    if code == 0 {
        version := ""
        loop line in output.lines() {
            if line.starts_with("PASS:") -> version = line.remove_prefix("PASS:").trim().partition(" ").head.copy()
        }
        return "RELEASE READY {version} from {short_sha(head)}; run the commands in {out}"
    }
    if code == 1 {
        reasons := [String]{}
        loop line in output.lines() {
            if line.starts_with("FAIL: ") -> reasons.push(clip(line.remove_prefix("FAIL: "), 200))
        }
        return "release gate {short_sha(head)}: not released ({reasons.join("; ")})"
    }
    "release gate {short_sha(head)}: could not start rc={code} ({clip(output.trim_end().last_lines(1).join(""), 200)})"
}

// --- preflight receipts -----------------------------------------------------

receipt_dir: fn() -[Env, FS]> String Never! { "{state_root()}/preflight" }

receipt_path: fn(source_identity: String, dir: String) -> String Never! {
    "{dir}/{crypto.sha256(source_identity.bytes()).hex()}.json"
}

// The receipt of a clean census of every pass of the snapshot whose source
// identity is `source_identity`: COMMIT plus the `named` worktree files, by
// the seed of `seed_identity`. Written whole (a temporary file renamed).
write_receipt: fn(source_identity: String, seed_identity: String, commit: String, named: [String], dir: String) -[Env, FS, Time]> String LandError! {
    files.create_dir_all(dir) ?? return Err(LandError{message: "`{dir}` cannot be created: {err}"})
    path: receipt_path(source_identity, dir)
    receipt: Dyn.Object([String: Dyn]{
        "schema": Dyn.Text(RECEIPT_SCHEMA.copy()),
        "sourceIdentity": Dyn.Text(source_identity.copy()),
        "seedIdentity": Dyn.Text(seed_identity.copy()),
        "commit": Dyn.Text(commit.copy()),
        "files": Dyn.Array(named.map(name -> Dyn.Text(name.copy()))),
        "passes": Dyn.Array(RECEIPT_PASSES.map(pass -> Dyn.Text(pass.copy()))),
        "finished": Dyn.Text("{time.isoformat(time.now_utc())}Z"),
    })
    text: json.to_string_pretty(receipt) ?? return Err(LandError{message: "the receipt cannot be encoded: {err}"})
    temp: "{path}.{sys.pid()}.tmp"
    files.write(temp, "{text}\n") ?? return Err(LandError{message: "`{temp}` cannot be written: {err}"})
    files.rename(temp, path) ?? return Err(LandError{message: "`{path}` cannot be written: {err}"})
    path
}

Admission: struct {
    admitted: Bool
    reason: String
}

// Is a launch of the compiler of `source_identity` by the seed of
// `seed_identity` vouched for by a receipt in `dir`?
gate: fn(source_identity: String, seed_identity: String, dir: String) -[FS]> Admission Never! {
    path: receipt_path(source_identity, dir)
    if !files.exists(path) -> return Admission{admitted: false, reason: "no preflight receipt for source identity {source_identity}"}
    text: files.read(path) ?? return Admission{admitted: false, reason: "receipt {path} cannot be read ({err})"}
    tree: json.parse(text) ?? return Admission{admitted: false, reason: "receipt {path} is not JSON ({err})"}
    if text_field(tree, "schema") != RECEIPT_SCHEMA || text_field(tree, "sourceIdentity") != source_identity {
        return Admission{admitted: false, reason: "receipt {path} is not a {RECEIPT_SCHEMA} receipt for {source_identity}"}
    }
    census_seed: text_field(tree, "seedIdentity")
    if census_seed != seed_identity {
        return Admission{admitted: false, reason: "the preflight receipt for source identity {source_identity} is from a census by seed {census_seed}, not {seed_identity}"}
    }
    count: array_field(tree, "files").len()
    named: if count > 0 -> " + {count} worktree file(s)" else -> ""
    Admission{admitted: true, reason: "preflight receipt {path}: census of {short_sha(text_field(tree, "commit"))}{named} by seed {seed_identity}, finished {text_field(tree, "finished")}"}
}

short_sha: fn(text: String) -> String Never! {
    if text.count_bytes() <= 10 -> return text.copy()
    text.slice(0..<10)
}

// A refused launch: the reason, then the census that would admit it.
refusal: fn(launcher: String, reason: String, seed_dir: String, commit: String) -> String Never! {
    at: if commit != "" -> " at {short_sha(commit)}" else -> ""
    "{launcher}: refused: {reason}.\nRun the collect-all preflight in the dev worktree{at} (name each uncommitted file the launch tree carries after it), then launch again:\n  CENSUS_JET_DIR={seed_dir} jet Tools/agent/Land.jet census"
}

// The source identity of COMMIT of the checkout `repo`, from an export of its
// compiler trees.
commit_source_identity: fn(repo: String, commit: String) -[Exec, Env, FS, Time.Wait]> String LandError! {
    dir: "{receipt_dir()}/gate-{sys.pid()}"
    files.remove_all(dir) ?? ()
    export_tree(repo, commit, dir, IDENTITY_TREES.copy()) ?? {
        files.remove_all(dir) ?? ()
        return Err(err)
    }
    identity: compiler_source_identity(dir) ?? {
        files.remove_all(dir) ?? ()
        return Err(err)
    }
    files.remove_all(dir) ?? ()
    identity
}

receipt_main: fn(args: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    if args.len() == 2 && args[0] == "identity" {
        identity: compiler_source_identity(absolute(args[1])) ?? {
            term.eprint("receipt: {err.message}")
            return 2
        }
        print(identity)
        return 0
    }
    if !((args.len() == 4 && args[0] == "check") || (args.len() == 5 && args[0] == "commit")) -> usage()
    launcher: args[1]
    seed: absolute(args[args.len() - 1])
    seed_identity: read_identity(seed)
    if seed_identity == "" {
        term.eprint("{launcher}: seed {seed} has no IDENTITY")
        return 2
    }
    commit := ""
    source_identity := ""
    if {
        args[0] == "check" -> {
            tree: absolute(args[2])
            commit = (files.read("{tree}/.chain-base") ?? "").partition("\n").head.trim()
            source_identity = compiler_source_identity(tree) ?? {
                term.eprint("{launcher}: {err.message}")
                return 2
            }
        }
        else -> {
            commit = args[3].copy()
            source_identity = commit_source_identity(absolute(args[2]), commit) ?? {
                term.eprint("{launcher}: {err.message}")
                return 2
            }
        }
    }
    verdict: gate(source_identity, seed_identity, receipt_dir())
    if !verdict.admitted {
        term.eprint(refusal(launcher, verdict.reason, seed, commit))
        return 1
    }
    print("{launcher}: admitted by {verdict.reason}")
    0
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

array_field: fn(tree: Dyn, name: String) -> [Dyn] Never! {
    if field(tree, name) == .Array(items) -> return items.copy()
    [Dyn]{}
}

#Test("numstat -z rows give each path, and both sides of a rename") {
    nul: String.from_bytes([U8]{U8{0}}) ?? ""
    fields: nul_fields("1\t2\ta.jet{nul}0\t0\t{nul}old.md{nul}new.md{nul}")
    assert_eq(fields, [String]{"1\t2\ta.jet", "0\t0\t", "old.md", "new.md"})
}

#Test("compiler inputs are Compiler, Core, Jetpack and sources lists") {
    assert(compiler_input("Core/Text/String.jet"))
    assert(compiler_input("Jetpack/Bootstrap/sources.list"))
    assert(!compiler_input("Tools/agent/Land.jet"))
    assert(!compiler_input("Docs/spec/contributing/bootstrap.md"))
}

#Test("Pareto seconds follow the tag and end in an s word") {
    assert_eq(tagged_seconds("x\nPARETO: 0.7 s\n", "PARETO:"), Val(0.7))
    assert_eq(tagged_seconds("PARETO: -1.5s", "PARETO:"), Val(1.5))
    assert_eq(tagged_seconds("PARETO: 2 seconds", "PARETO:"), None)
    assert_eq(tagged_seconds(" PARETO: 2 s", "PARETO:"), None)
    assert_eq(tagged_seconds("SMALL-WIN: 0.1 s", "PARETO:"), None)
}

#Test("a source path joins a package directory inside the repository") {
    assert_eq(repo_join("Compiler/JetCli", "../../Jetpack/EnvModel"), "Jetpack/EnvModel")
    assert_eq(repo_join("Compiler", "./JetCli/."), "Compiler/JetCli")
    assert_eq(repo_join("Compiler", "../../x"), "")
}

#Test("runtime, backend, Core and Jetpack sources and sources.list need the census") {
    assert(census_source("Jetpack/Bootstrap/Source/Main.jet"))
    assert(census_source("Compiler/JetRuntime/Source/Trap.jet"))
    assert(census_source("Compiler/JetBackend/Source/X64/Emit.jet"))
    assert(census_source("Core/Text/Text.jet"))
    assert(census_source("Compiler/JetRuntime/sources.list"))
    assert(!census_source("Jetpack/README.md"))
    assert(!census_source("Tools/agent/Land.jet"))
}

#Test("a receipt admits only the source identity and the seed its census ran") {
    dir: files.mkdtemp("land-receipt") ?? panic("a temporary directory cannot be made: {err}")
    source: "jet@a0.0.43#aaaa"
    seed: "jet@a0.0.43#bbbb"
    assert_eq(gate(source, seed, dir).reason, "no preflight receipt for source identity jet@a0.0.43#aaaa")
    written: write_receipt(source, seed, "0123456789abcdef", [String]{"Compiler/JetCli/Source/Main.jet"}, dir) ?? panic(err.message)
    assert_eq(written, receipt_path(source, dir))
    admitted: gate(source, seed, dir)
    assert(admitted.admitted)
    assert(admitted.reason.contains(": census of 0123456789 + 1 worktree file(s) by seed jet@a0.0.43#bbbb, finished "))
    other: gate(source, "jet@a0.0.43#cccc", dir)
    assert(!other.admitted)
    assert_eq(other.reason, "the preflight receipt for source identity jet@a0.0.43#aaaa is from a census by seed jet@a0.0.43#bbbb, not jet@a0.0.43#cccc")
    assert(!gate("jet@a0.0.43#dddd", seed, dir).admitted)
    files.write(written, "{{") ?? panic("{written}: {err}")
    assert(gate(source, seed, dir).reason.starts_with("receipt {written} is not JSON ("))
    files.remove_all(dir) ?? ()
}

#Test("a refusal names the census that would admit the launch") {
    assert_eq(refusal("Chain.jet", "no preflight receipt for source identity x", "/seeds/a0.0.32", "0123456789abcdef"), "Chain.jet: refused: no preflight receipt for source identity x.\nRun the collect-all preflight in the dev worktree at 0123456789 (name each uncommitted file the launch tree carries after it), then launch again:\n  CENSUS_JET_DIR=/seeds/a0.0.32 jet Tools/agent/Land.jet census")
    assert(refusal("release", "r", "/s", "").contains("in the dev worktree (name each"))
}

#Test("census rows name the file and line of each span") {
    tree: files.mkdtemp("land-census") ?? panic("a temporary directory cannot be made: {err}")
    files.create_dir_all("{tree}/Compiler/JetCli/Source") ?? panic("{tree}: {err}")
    files.write("{tree}/Compiler/JetCli/Source/Main.jet", "a\nb\nc\n") ?? panic("{tree}: {err}")
    files.write("{tree}/report.tsv", "span\tcode\tphase\tmessage\titem\n/elsewhere/Compiler/JetCli/Source/Main.jet:4..5\tE0109\tsema\tmismatch\tmain\nSource/Main.jet:2..3\tE0109\tsema\tagain\tmain\n-\tE0505\tborrow\tmoved\tf\n") ?? panic("{tree}: {err}")
    assert_eq(census_rows("{tree}/report.tsv", tree, [String]{"Compiler/JetCli"}), [String]{
        "3 rows {{\"E0109\":2,\"E0505\":1}}",
        "E0109\tCompiler/JetCli/Source/Main.jet:3\tsema: mismatch",
        "E0109\tCompiler/JetCli/Source/Main.jet:2\tsema: again",
        "E0505\tf\tborrow: moved",
    })
    assert_eq(report_rows("{tree}/report.tsv"), 3)
    files.remove_all(tree) ?? ()
}

#Test("check errors are counted with the place on the line after them") {
    rows: error_rows("Error[E0109]: mismatch\n  --> a.jet:3:1\nnote\nError[E0109]: mismatch\n  --> a.jet:3:1\nError[E0505]: moved\n")
    assert_eq(counted(rows), [String]{"2 Error[E0109]: mismatch a.jet:3:1", "1 Error[E0505]: moved "})
}

#Test("a commit message is cleaned as git stripspace cleans it") {
    assert_eq(stripspace("\n\nsubject  \n\n\n\nbody\t\nmore\n\n"), "subject\n\nbody\nmore\n")
    assert_eq(stripspace(" \n\n"), "")
}

#Test("patches that share a file, even through another, form one group") {
    roots: share_groups([[String]]{[String]{"a", "b"}, [String]{"c"}, [String]{"d", "b"}, [String]{"e", "c"}, [String]{"f"}})
    assert_eq(roots, [Int]{0, 1, 0, 1, 4})
}

#Test("list lines are jobs; comments, blanks and short lines are not") {
    jobs: read_jobs("# x\n\nL\t/m\t/p\nM\t/m2\t/p2\tname\nbad\tline\n")
    assert_eq(jobs.len(), 2)
    assert_eq(job_line(jobs[0]), "L\t/m\t/p\t")
    assert_eq(jobs[1].name, "name")
}

#Test("a job's result is read from its lines in the batch report") {
    job: Job{lane: "L", message: "/q/a.msg", patch: "/q/a.patch", name: "1-L"}
    assert_eq(job_result(job, "APPLIED L a.patch (2 files)\nCOMMITTED 0123abcd L a.patch\n", "ok"), "LANDED 0123abcd\n")
    assert_eq(job_result(job, "SKIP (already on dev) L a.patch\n", "ok"), "LANDED already-on-dev\n")
    assert_eq(job_result(job, "DOES NOT APPLY L a.patch - left for its lane\n", "ok"), "STALE does not apply to HEAD; rebase\n")
    assert_eq(job_result(job, "DOES NOT APPLY L a.patch - an earlier patch of its stack did not apply (z.patch); left for its lane\n", "ok"), "STALE an earlier patch of its stack did not apply; rebase the stack onto HEAD\n")
    assert_eq(job_result(job, "nm: x\nPRECOMMIT FAILED\n", "precommit failed for this patch"), "REJECTED precommit failed for this patch\nPRECOMMIT FAILED\n")
    assert_eq(job_result(job, "COMMITTED 0123abcd L xa.patch\n", "ok"), "REJECTED ok\nCOMMITTED 0123abcd L xa.patch\n")
}

#Test("the golden rows are the Examples rows minus the excluded stems") {
    listed: "golden\tExamples/A/One.jet\ngolden\tExamples/Systems/Process/OSProcessControl.jet\ngolden\tCompiler/X.jet\nrun\tExamples/A/Two.jet\ngolden\tExamples/B/Dir/main.jet\n"
    assert_eq(golden_rows(listed, [String]{"Systems/Process/OSProcessControl"}) ?? panic("selection"), [String]{"Examples/A/One.jet", "Examples/B/Dir/main.jet"})
    assert_eq(golden_rows(listed, [String]{"B/Dir"}) ?? panic("selection"), [String]{"Examples/A/One.jet", "Examples/Systems/Process/OSProcessControl.jet"})
    assert(golden_rows(listed, [String]{"Gone"}) == .Err(_))
}

#Test("the counts object is cut from a results document") {
    assert_eq(results_counts("{{\"schema\":1,\"counts\":{{\"pass\":3,\"fail\":1}},\"rows\":[]}}"), "{{\"pass\":3,\"fail\":1}}")
    assert_eq(results_counts("{{\"rows\":[]}}"), "")
}

#Test("a release gate run becomes one batch-log line") {
    assert_eq(train_verdict(0, "x\nPASS: a0.0.34 ready\n", "0123456789abcdef", "/w/t.log"), "RELEASE READY a0.0.34 from 0123456789; run the commands in /w/t.log")
    assert_eq(train_verdict(1, "FAIL: gains 3 < 10\nFAIL: rows\n", "0123456789abcdef", "/w/t.log"), "release gate 0123456789: not released (gains 3 < 10; rows)")
    assert_eq(train_verdict(2, "boom\n", "0123456789abcdef", "/w/t.log"), "release gate 0123456789: could not start rc=2 (boom)")
}
