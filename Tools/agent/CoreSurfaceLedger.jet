    (container: "core.net.url", card: 1472),
    (container: "core.crypto", card: 1725),
    (container: "core.log", card: 1474),
    (container: "Queue", card: 1475),
    (container: "String", card: 1581),
    (container: "List", card: 1477),
    (container: "Map", card: 1477),
    (container: "Set", card: 1584),
    (container: "Rank", card: 1584),
