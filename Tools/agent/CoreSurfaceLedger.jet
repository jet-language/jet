// Every row D-STR-DECLINE1, D-SET-DECLINE1, and D-CORESURF-SMALL1 decline,
// keyed by the row `id` the rows mint today, mapped to the ratified decision
// plus the existing Jet route named in that decision's technical text. The
// ledger applies this after rows are built, flipping a matched row's verdict
// from `jet_loses`/`single_witness` to `declined` — the ledger's only source of
// a "declined" verdict, so a refresh reproduces the same declines
// deterministically instead of losing them the moment someone hand-edits the
// generated JSON (which `--check` rejects).
//
// D-ITER-DECLINE1 needs no entry here: every name it declines already
// normalizes onto a Jet-shipped Iter member through SYNONYM_GROUPS, so no gap
// row is minted for them in the first place.
RATIFIED_DECLINES: [(id: String, decision: String, spelling: String)]{
    (id: "gap.text.clear", decision: "D-STR-DECLINE1", spelling: "String is immutable — rebuild with + or .replace()/.slice()"),
    (id: "gap.text.push", decision: "D-STR-DECLINE1", spelling: "String is immutable — rebuild with + or .replace()/.slice()"),
    (id: "gap.text.pop", decision: "D-STR-DECLINE1", spelling: "String is immutable — rebuild with + or .replace()/.slice()"),
    (id: "gap.text.remove", decision: "D-STR-DECLINE1", spelling: "String is immutable — rebuild with + or .replace()/.slice()"),
