// ---- Text helpers ---------------------------------------------------------

// The text of bytes `start..<end` of `text` (indexes from text.bytes()).
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

is_letter_byte: fn(code: Int) -> Bool Never! { (code >= 97 && code <= 122) || (code >= 65 && code <= 90) }

is_digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// `[A-Za-z0-9_]`, a regex word character.
is_word_code: fn(code: Int) -> Bool Never! { is_letter_byte(code) || is_digit_byte(code) || code == 95 }

// `^[A-Za-z_][A-Za-z0-9_]*$`.
is_identifier: fn(name: String) -> Bool Never! {
    bytes: name.bytes()
    if bytes.len() == 0 -> return false
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if is_letter_byte(code) || code == 95 -> next
        if index == 0 || !is_digit_byte(code) -> return false
    }
    true
}

// The lines of `source` as a split on /\r?\n/ reads them.
split_lines: fn(source: String) -> [String] Never! {
    out := [String]{}
    loop line in source.split("\n") {
        out.push(if line.ends_with("\r") -> line.removesuffix("\r") else -> line.copy())
    }
    out
}

sha_hex: fn(text: String) -> String Never! { crypto.sha256(text).hex() }

compare_bytes: fn(left: [U8], right: [U8]) -> Ordering Never! {
    common: if left.len() < right.len() -> left.len() else -> right.len()
    loop at in 0..<common {
        a: Int.from_u8(left[at])
        b: Int.from_u8(right[at])
        if a < b -> return Ordering.Less
        if a > b -> return Ordering.Greater
    }
    if left.len() < right.len() -> return Ordering.Less
    if left.len() > right.len() -> return Ordering.Greater
    Ordering.Equal
}

// Larger counts first, then collation-key order.
count_then_key: fn(left_count: Int, left_key: [U8], right_count: Int, right_key: [U8]) -> Ordering Never! {
    if left_count > right_count -> return Ordering.Less
    if left_count < right_count -> return Ordering.Greater
    compare_bytes(left_key, right_key)
}

// `values` in Unicode's default collation order (a localeCompare sort).
collated: fn(values: [String]) -> [String] Never! {
    keyed := loop value in values -> (key: text.collation_key(value), value: value.copy())
    keyed.sort_by((left: (key: [U8], value: String), right: (key: [U8], value: String)) -> compare_bytes(left.key, right.key))
    loop item in keyed -> item.value.copy()
}

// `values` in byte order with repeats dropped (a sorted Set).
sorted_unique: fn(values: [String]) -> [String] Never! {
    out := values.copy()
    out.sort()
    unique := [String]{}
    loop value in out {
        if unique.len() > 0 && unique[unique.len() - 1] == value -> next
        unique.push(value.copy())
    }
    unique
}

// `values` with later repeats dropped, first-seen order kept.
first_seen: fn(values: [String]) -> [String] Never! {
    seen := [String: Bool]{}
    out := [String]{}
    loop value in values {
        if seen.get(value) != None -> next
        seen[value] = true
        out.push(value.copy())
    }
    out
}

read_source: fn(root: String, path: String) -[FS]> String LedgerError! {
    full: "{root}/{path}"
    if !files.exists(full) -> return Err(fail("missing source: {path}"))
    files.read(full) ?? return Err(fail("missing source: {path}"))
}

// ---- Dyn helpers ------------------------------------------------------------

jtext: fn(value: String) -> Dyn Never! { Dyn.Text(value.copy()) }

texts: fn(values: [String]) -> Dyn Never! { Dyn.Array(loop value in values -> Dyn.Text(value.copy())) }

// Field `key` of object `value`; Null when absent or when `value` is no object.
field: fn(value: Dyn, key: String) -> Dyn Never! { value.get(key) ?? Dyn.Null }

has_field: fn(value: Dyn, key: String) -> Bool Never! {
    if value == .Object(entries) {
        loop entry in entries {
            if entry.key == key -> return true
        }
    }
    false
}

// Whether field `key` is undefined or null.
missing: fn(value: Dyn, key: String) -> Bool Never! { field(value, key) == .Null }

text_of: fn(value: Dyn) -> String Never! {
    if value == .Text(content) -> return content.copy()
    ""
}

text_field: fn(value: Dyn, key: String) -> String Never! { text_of(field(value, key)) }

// Whether field `key` is the text `want`.
text_is: fn(value: Dyn, key: String, want: String) -> Bool Never! {
    if field(value, key) == .Text(content) -> return content == want
    false
}

// An integral JSON number, whether built as an Int or parsed as a lexeme.
int_of: fn(value: Dyn) -> Int? Never! {
    if value == .Int(number) -> return Val(number)
    if value == .Number(lexeme) {
        number: Int.parse(lexeme) ?? return None
        return Val(number)
    }
    None
}

int_is: fn(value: Dyn, key: String, want: Int) -> Bool Never! {
    if int_of(field(value, key)) == .Val(number) -> return number == want
    false
}

bool_is: fn(value: Dyn, key: String, want: Bool) -> Bool Never! {
    if field(value, key) == .Bool(flag) -> return flag == want
    false
}

non_empty: fn(value: Dyn) -> Bool Never! {
    if value == .Text(content) -> return content.trim() != ""
    false
}

non_negative_int: fn(value: Dyn) -> Bool Never! {
    if int_of(value) == .Val(number) -> return number >= 0
    false
}

// JavaScript truthiness.
truthy: fn(value: Dyn) -> Bool Never! {
    if value == {
        .Null -> false
        .Bool(flag) -> flag
        .Int(number) -> number != 0
        .Number(lexeme) -> (Float.parse(lexeme) ?? 1.0) != 0.0
        .Float(number) -> number != 0.0
        .Text(content) -> content != ""
        else -> true
    }
}

is_array: fn(value: Dyn) -> Bool Never! {
    if value == .Array(_) -> return true
    false
}

is_object: fn(value: Dyn) -> Bool Never! {
    if value == .Object(_) -> return true
    false
}

items: fn(value: Dyn) -> [Dyn] Never! {
    if value == .Array(list) -> return list.copy()
    [Dyn]{}
}

entries: fn(value: Dyn) -> [(key: String, value: Dyn)] Never! {
    if value == .Object(list) -> return list.copy()
    [(key: String, value: Dyn)]{}
}

keys_of: fn(value: Dyn) -> [String] Never! { loop entry in entries(value) -> entry.key.copy() }

// The text items of an array, non-text items skipped.
text_items: fn(value: Dyn) -> [String] Never! {
    out := [String]{}
    loop item in items(value) {
        if item == .Text(content) -> out.push(content.copy())
    }
    out
}

// The stable comparison of two values: key order never matters.
same: fn(left: Dyn, right: Dyn) -> Bool Never! {
    (json.canonical(left) ?? "left") == (json.canonical(right) ?? "right")
}

same_texts: fn(value: Dyn, want: [String]) -> Bool Never! { same(value, texts(want)) }

// ---- Synonyms ---------------------------------------------------------------

// Each normalized name's interchangeable names (its own included) and the
// first name of its first group, once over every group and once over the
// groups that also apply in a module namespace.
Synonyms: struct {
    index: [String: [String]]
    index_module: [String: [String]]
    canonical: [String: String]
    canonical_module: [String: String]
}

normalize: fn(name: String) -> String Never! {
    lowered: name.to_lower()
    out := [U8]{}
    loop byte in lowered.bytes() {
        code: Int.from_u8(byte)
        if code == 95 || code == 33 || code == 63 || code == 46 || code == 45 -> next
        out.push(byte)
    }
    String.from_bytes_lossy(out)
}

add_keys: fn(index: &[String: [String]], key: String, keys: [String]) {
    known := index.get(key) ?? [String]{}
    loop other in keys {
        if !known.contains(other) -> known.push(other.copy())
    }
    index[key] = known
}

synonyms: fn() -> Synonyms Never! {
    index := [String: [String]]{}
    index_module := [String: [String]]{}
    canonical := [String: String]{}
    canonical_module := [String: String]{}
    loop group in SYNONYM_GROUPS {
        keys: loop name in group -> normalize(name)
        type_only: TYPE_ONLY_GROUP_HEADS.contains(keys[0])
        loop key in keys {
            add_keys(index, key, keys)
            if canonical.get(key) == None -> canonical[key] = keys[0].copy()
            if type_only -> next
            add_keys(index_module, key, keys)
            if canonical_module.get(key) == None -> canonical_module[key] = keys[0].copy()
        }
    }
    Synonyms{index: index, index_module: index_module, canonical: canonical, canonical_module: canonical_module}
}

// A container is a type when it is one of Jet's things you hold, not a module
// namespace. Both witness pooling and the collection-verb synonym groups read
// this: a module gains no clear because a List has one.
is_type_container: fn(container: String) -> Bool Never! { !container.starts_with("core.") && container != "app" }

// The canonical key of an operation is the first name of its synonym group, so
// is_subset, is_subset_of and issubset are one gap rather than three.
canonical_key: fn(names: Synonyms, name: String, container: String) -> String Never! {
    base: normalize(name)
    table: if container != "" && !is_type_container(container) -> names.canonical_module.get(base) else -> names.canonical.get(base)
    table ?? base
}

synonyms_for: fn(names: Synonyms, member: String, container: String) -> [String] Never! {
    base: normalize(member)
    keys := [String]{base.copy()}
    aliases: if container != "" && !is_type_container(container) -> names.index_module.get(base) ?? [String]{} else -> names.index.get(base) ?? [String]{}
    loop alias in aliases {
        if !keys.contains(alias) -> keys.push(alias.copy())
    }
    keys
}

// An operator is syntax, not a named operation. Ruby alone exposes %, *, +, +@,
// <<, =~, [] and []= as String members; scoring them as missing calls compared
// Jet's method surface against another language's punctuation.
is_named_operation: fn(name: String) -> Bool Never! {
    if name == "" -> return false
    last: Int.from_u8(name.bytes()[byte_len(name) - 1])
    if last == 33 || last == 63 || last == 61 -> return is_identifier(byte_slice(name, 0, byte_len(name) - 1))
    is_identifier(name)
}

// Jet spells operations in snake_case and types in PascalCase, so module items
// export both: DataError, Digest256 and CryptoError sit beside describe and
// blake3. A type is not an operation, and scoring one as a win inflated the
// least audited number in the ledger. The rule is Jet-side only: Go exports
// every function in PascalCase, so it cannot apply to a competitor surface.
is_type_item: fn(member: String) -> Bool Never! {
    if member == "" -> return false
    first: Int.from_u8(member.bytes()[0])
    first >= 65 && first <= 90
}

container_for: fn(name: String) -> String Never! {
    loop alias in CONTAINER_ALIASES {
        if alias.name == name -> return alias.container.copy()
    }
    name.copy()
}

domain_for: fn(container: String) -> String Never! {
    loop entry in MATCH_DOMAIN {
        if entry.container == container -> return entry.domain.copy()
    }
    container.copy()
}

// ---- Declines and conformance fixtures ----------------------------------------

// tests/conformance/fixture-bindings.tsv: one `row<TAB>path` line per witness,
// the path relative to the conformance corpus root.
Binding: struct {
    row: String
    paths: [String]
}

fixture_bindings: fn(source: String) -> [Binding] LedgerError! {
    bindings := [Binding]{}
    loop (index, raw) in source.split("\n").to_list() {
        if raw.trim() == "" || raw.starts_with("#") -> next
        where: "{CORE_CONFORMANCE_PATH}:{index + 1}: "
        fields: raw.split("\t").to_list()
        if fields.len() != 2 || fields[0] == "" || fields[1] == "" {
            return Err(fail("{where}expected a row id and a fixture path separated by a tab"))
        }
        row: fields[0]
        path: fields[1]
        bad := path.starts_with("/") || path.contains("\\")
        loop part in path.split("/") {
            if part == "" || part == "." || part == ".." -> bad = true
        }
        if bad -> return Err(fail("{where}invalid conformance fixture binding path: {path}"))
        at := -1
        loop (position, binding) in bindings {
            if binding.row == row -> at = position
        }
        if at < 0 {
            bindings.push(Binding{row: row.copy(), paths: [String]{}})
            at = bindings.len() - 1
        }
        if bindings[at].paths.contains(path) -> return Err(fail("{where}duplicate fixture binding path: {row} -> {path}"))
        bindings[at].paths.push(path.copy())
    }
    Ok(bindings)
}

// Whether a line of `source` reads `//`, `name:` and then one word (with
// `rest` true: a non-space character and at least one more character).
has_header_line: fn(source: String, name: String, rest: Bool) -> Bool Never! {
    loop raw in source.split("\n") {
        line: if raw.ends_with("\r") -> raw.removesuffix("\r") else -> raw.copy()
        if !line.starts_with("//") -> next
        after: byte_tail(line, 2).trim_start()
        if !after.starts_with("{name}:") -> next
        value: byte_tail(after, byte_len(name) + 1).trim_start()
        if rest {
            if value.chars().len() >= 2 -> return true
            next
        }
        word: value.trim_end()
        if word != "" && !word.contains(" ") && !word.contains("\t") -> return true
    }
    false
}

// The fixture sources bound to `row_id`, each checked for its row marker,
// coverage header and web applicability declaration.
conformance_fixture_sources: fn(root: String, bindings: [Binding], row_id: String) -[FS]> [String] LedgerError! {
    paths := [String]{}
    loop binding in bindings {
        if binding.row != row_id -> next
        loop path in binding.paths -> paths.push("{CORE_CONFORMANCE_FIXTURE_ROOT}/{path}")
    }
    loop path in paths {
        source: read_source(root, path) ?? return Err(err)
        if !has_header_line(source, "core-conformance", false) {
            return Err(fail("conformance fixture is missing its row marker: {path}"))
        }
        if !has_header_line(source, "coverage", true) {
            return Err(fail("conformance fixture is missing its coverage header: {path}"))
        }
        if !source.contains("// web: not-applicable (the web target has no browser scheduler)") {
            return Err(fail("conformance fixture is missing the web applicability declaration: {path}"))
        }
    }
    Ok(paths)
}

// ---- Core surface inventory ----------------------------------------------------

Collection: struct {
    function: String
    type_name: String
    methods: [String]
    source_line: Int
}

Inventory: struct {
    fixed_pairs: [String]
    collections: [Collection]
}

// One Core module fact from CoreSourceRows.jet --facts.
ModuleFact: struct {
    name: String
    members: [String]
    source_line: Int
}

// The Jet tables a receivers row reads. Each is the compiler's own row set:
// sema checks receiver methods against these rows, so reading them here keeps
// the inventory receiver-aware with no second copy.
ReceiverTables: struct {
    builtin: [String: [String]]
    collection: [String: [String]]
    statics: [String: [String]]
    numeric: [String]
    module_paths: [String: [String]]
    sema_names: [String: Bool]
}

record_name: fn(table: &[String: [String]], key: String, name: String) {
    known := table.get(key) ?? [String]{}
    if !known.contains(name) -> known.push(name.copy())
    table[key] = known
}

BUILTIN_ROW: Regex{"receiver: BuiltinMethodReceiver\.([A-Za-z]+), name: \x22([^\x22]+)\x22"}
COLLECTION_ROW: Regex{"receivers: CollectionReceivers\.([A-Za-z]+), name: \x22([^\x22]+)\x22.*status: CollectionStatus\.([A-Za-z]+)"}
STATIC_ROW: Regex{"\{{module_name: \x22([^\x22]*)\x22, owner: \x22([^\x22]+)\x22, method: \x22([^\x22]+)\x22"}
CONVERSION_ROW: Regex{"\{{method: \x22([^\x22]+)\x22, source: \x22[^\x22]+\x22\}}"}
SOURCE_MODULE_ROW: Regex{"^source_module\s+(\S+)\s+path\s+(\S+)\s"}
SEMA_LITERAL: Regex{"\x22([A-Za-z_][A-Za-z0-9_]*)\x22"}
INVENTORY_ROW: Regex{"^(fixed_sig|receivers|methods)\s+(\S+)\s+\{{\s*([^{{}}]*?)\s*\}}$"}
RECEIVER_SOURCE: Regex{"^(builtin|collection|static|numeric|type):([A-Za-z_][A-Za-z0-9_.]*)$"}
IMPL_HEADER: Regex{"^(?:impl\s+([A-Za-z_][A-Za-z0-9_]*)(?:<[^>]*>)?(?:\.[A-Za-z_.]+)?|([A-Za-z_][A-Za-z0-9_]*):\s*struct(?:<[^>]*>)?)\s*\{{"}
METHOD_HEADER: Regex{"^\s+([A-Za-z_][A-Za-z0-9_]*):\s*fn\b.*\{{"}

walk_sema: fn(root: String, directory: String, spelled: &[String: Bool]) -[FS]> Int LedgerError! {
    listed: files.list_dir("{root}/{directory}") ?? return Err(fail("cannot list {directory}: {err}"))
    names := loop entry in listed -> entry.name.copy()
    names.sort()
    loop name in names {
        path: "{directory}/{name}"
        if files.is_dir("{root}/{path}") {
            walk_sema(root, path, spelled) ?? return Err(err)
            next
        }
        if !name.ends_with(".jet") -> next
        source: read_source(root, path) ?? return Err(err)
        loop found in SEMA_LITERAL.matches(source) -> spelled[found.group(1) ?? ""] = true
    }
    Ok(0)
}

jet_receiver_tables: fn(root: String) -[FS]> ReceiverTables LedgerError! {
    builtin := [String: [String]]{}
    collection := [String: [String]]{}
    statics := [String: [String]]{}
    numeric := [String]{}
    module_paths := [String: [String]]{}
    loop line in split_lines(read_source(root, BUILTIN_METHODS_PATH) ?? return Err(err)) {
        if BUILTIN_ROW.match(line) == .Val(row) -> record_name(builtin, row.group(1) ?? "", row.group(2) ?? "")
    }
    // `collection_receivers_accept`: a Sequence row serves List and Iter; a
    // Proposed row is not checked by sema.
    loop line in split_lines(read_source(root, COLLECTIONS_PATH) ?? return Err(err)) {
        row: COLLECTION_ROW.match(line) ?? next
        if (row.group(3) ?? "") == "Proposed" -> next
        name: row.group(2) ?? ""
        if (row.group(1) ?? "") == "Sequence" {
            record_name(collection, "List", name)
            record_name(collection, "Iter", name)
        } else {
            record_name(collection, row.group(1) ?? "", name)
        }
    }
    loop line in split_lines(read_source(root, BUILTIN_STATICS_PATH) ?? return Err(err)) {
        if STATIC_ROW.match(line) == .Val(row) {
            owner_module: row.group(1) ?? ""
            key: if owner_module != "" -> "{owner_module}.{row.group(2) ?? ""}" else -> row.group(2) ?? ""
            record_name(statics, key, row.group(3) ?? "")
        }
        if CONVERSION_ROW.match(line) == .Val(conversion) {
            method: conversion.group(1) ?? ""
            if !numeric.contains(method) -> numeric.push(method)
        }
    }
    loop line in split_lines(read_source(root, CORE_SOURCE_PATH) ?? return Err(err)) {
        if SOURCE_MODULE_ROW.match(line) == .Val(row) -> record_name(module_paths, row.group(1) ?? "", row.group(2) ?? "")
    }
    loop line in split_lines(read_source(root, CORE_SOURCE_PARTS_PATH) ?? return Err(err)) {
        if line.starts_with("#") -> next
        cells: line.split("\t").to_list()
        if cells.len() > 2 -> record_name(module_paths, cells[1], cells[2])
    }
    sema_names := [String: Bool]{}
    walk_sema(root, SEMA_SOURCE_DIR, sema_names) ?? return Err(err)
    Ok(ReceiverTables{builtin: builtin, collection: collection, statics: statics, numeric: numeric, module_paths: module_paths, sema_names: sema_names})
}

// One receivers source: `builtin:<BuiltinMethodReceiver>`,
// `collection:<CollectionReceivers>`, `static:[<module>.]<owner>`,
// `numeric:conversions` (BUILTIN_NUMERIC_SOURCES), or
// `type:<core module>.<Type>` (the type's methods declared in its Core source).
receiver_source_methods: fn(root: String, tables: ReceiverTables, item: String, context: String) -[FS]> [String] LedgerError! {
    source: RECEIVER_SOURCE.match(item) ?? return Err(fail("{context} has an invalid receivers source: {item}"))
    kind: source.group(1) ?? ""
    key: source.group(2) ?? ""
    methods := [String]{}
    if kind == "builtin" -> methods = tables.builtin.get(key) ?? [String]{}
    if kind == "collection" -> methods = tables.collection.get(key) ?? [String]{}
    if kind == "static" -> methods = tables.statics.get(key) ?? [String]{}
    if kind == "numeric" && key == "conversions" -> methods = tables.numeric.copy()
    if kind == "type" {
        dot: key.rfind(".")
        if dot < 0 -> return Err(fail("{context} names a type outside any Core source module: {item}"))
        paths: tables.module_paths.get(byte_slice(key, 0, dot)) ?? return Err(fail("{context} names a type outside any Core source module: {item}"))
        methods = core_type_methods(root, paths, byte_tail(key, dot + 1)) ?? return Err(err)
    }
    if methods.len() == 0 -> return Err(fail("{context} names a receivers source with no methods: {item}"))
    Ok(methods)
}

// The braces of `line` outside `"…"` strings and before a `//` comment.
brace_delta: fn(line: String) -> Int Never! {
    bytes: line.bytes()
    delta := 0
    index := 0
    loop index < bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 34 {
            // A closed string is skipped whole; an unclosed quote is a plain character.
            close := -1
            scan := index + 1
            loop scan < bytes.len() {
                inner: Int.from_u8(bytes[scan])
                if inner == 92 {
                    if scan + 1 < bytes.len() && Int.from_u8(bytes[scan + 1]) != 10 {
                        scan += 2
                        next
                    }
                    break
                }
                if inner == 34 {
                    close = scan
                    break
                }
                scan += 1
            }
            if close >= 0 {
                index = close + 1
                next
            }
        }
        if code == 47 && index + 1 < bytes.len() && Int.from_u8(bytes[index + 1]) == 47 -> break
        if code == 123 -> delta += 1
        if code == 125 -> delta -= 1
        index += 1
    }
    delta
}

// The public methods a Core source declares on a type: `name: fn(…) {`
// members of its struct body and of its `impl` blocks, trait implementations
// included. A member without a body is a field of function type.
core_type_methods: fn(root: String, paths: [String], type_name: String) -[FS]> [String] LedgerError! {
    methods := [String]{}
    loop path in paths {
        owner := false
        depth := 0
        loop line in split_lines(read_source(root, path) ?? return Err(err)) {
            if depth == 0 {
                owner = false
                if IMPL_HEADER.match(line) == .Val(header) {
                    owner = (header.group(1) ?? header.group(2) ?? "") == type_name
                }
            } else {
                if depth == 1 && owner {
                    if METHOD_HEADER.match(line) == .Val(method) {
                        name: method.group(1) ?? ""
                        if !name.starts_with("__") && !methods.contains(name) -> methods.push(name)
                    }
                }
            }
            depth += brace_delta(line)
            if depth < 0 -> depth = 0
        }
    }
    Ok(methods)
}

// The Core surface beyond Core.jet's module exports, from its one authored
// home: `fixed_sig <module> { … }`, `receivers <Container> { … }` and
// `methods <Container> { … }` lines. A receivers row names the Jet tables a
// container's receiver methods come from; the method names are read from those
// tables, so the inventory follows the compiler. A methods row names only the
// methods sema checks in code with no table to read; each must be spelled in
// sema and must not already come from the container's receivers.
core_surface_inventory: fn(root: String, modules: [ModuleFact]) -[FS]> Inventory LedgerError! {
    source: read_source(root, CORE_SURFACE_INVENTORY_PATH) ?? return Err(err)
    known: loop entry in modules -> entry.name.copy()
    tables: jet_receiver_tables(root) ?? return Err(err)
    pairs := [String]{}
    fixed_modules := [String]{}
    derived := [Collection]{}
    declared := [Collection]{}
    loop (index, raw) in split_lines(source) {
        line: raw.trim()
        if line == "" || line.starts_with("//") -> next
        context: "{CORE_SURFACE_INVENTORY_PATH} line {index + 1}"
        row: INVENTORY_ROW.match(line) ?? return Err(fail("{context} is not a fixed_sig, receivers or methods row"))
        kind: row.group(1) ?? ""
        name: row.group(2) ?? ""
        listed: loop item in (row.group(3) ?? "").split(",") -> item.trim()
        if listed.contains("") || sorted_unique(listed).len() != listed.len() {
            return Err(fail("{context} has an empty or repeated name"))
        }
        if kind == "fixed_sig" {
            if !known.contains(name) -> return Err(fail("{context} names an unknown Core module: {name}"))
            if fixed_modules.contains(name) -> return Err(fail("{context} repeats module {name}"))
            fixed_modules.push(name.copy())
            loop member in listed {
                if !is_identifier(member) -> return Err(fail("{context} has an invalid member: {member}"))
                pair: "{name}.{member}"
                if !pairs.contains(pair) -> pairs.push(pair)
            }
            next
        }
        into: if kind == "receivers" -> derived else -> declared
        loop entry in into {
            if entry.type_name == name -> return Err(fail("{context} repeats {kind} container {name}"))
        }
        if kind == "receivers" {
            methods := [String]{}
            loop item in listed {
                loop method in receiver_source_methods(root, tables, item, context) ?? return Err(err) {
                    if !methods.contains(method) -> methods.push(method.copy())
                }
            }
            derived.push(Collection{function: CORE_SURFACE_INVENTORY_PATH, type_name: name.copy(), methods: methods, source_line: index + 1})
            next
        }
        loop method in listed {
            if !is_identifier(method) -> return Err(fail("{context} has an invalid method: {method}"))
            if tables.sema_names.get(method) == None {
                return Err(fail("{context} declares `{name}.{method}`, but no sema source spells that method; delete the stale name"))
            }
        }
        declared.push(Collection{function: CORE_SURFACE_INVENTORY_PATH, type_name: name.copy(), methods: listed, source_line: index + 1})
    }
    collections := derived
    loop entry in declared {
        at := -1
        loop (position, owner) in collections {
            if owner.type_name == entry.type_name -> at = position
        }
        if at >= 0 {
            repeated := [String]{}
            loop method in entry.methods {
                if collections[at].methods.contains(method) -> repeated.push(method.copy())
            }
            repeated.sort()
            if repeated.len() > 0 {
                return Err(fail("{CORE_SURFACE_INVENTORY_PATH} line {entry.source_line} declares {entry.type_name} methods its receivers row already reads from the Jet tables: {repeated.join(", ")}"))
            }
            loop method in entry.methods {
                if !collections[at].methods.contains(method) -> collections[at].methods.push(method.copy())
            }
            next
        }
        collections.push(entry.copy())
    }
    if pairs.len() == 0 || collections.len() == 0 -> return Err(fail("{CORE_SURFACE_INVENTORY_PATH} has an empty table"))
    sorted_pairs := pairs
    sorted_pairs.sort()
    loop at in 0..<collections.len() -> collections[at].methods.sort()
    order: collated(loop entry in collections -> entry.type_name)
    ordered := [Collection]{}
    loop type_name in order {
        loop entry in collections {
            if entry.type_name == type_name -> ordered.push(entry.copy())
        }
    }
    Ok(Inventory{fixed_pairs: sorted_pairs, collections: ordered})
}

// ---- Competitor surfaces ------------------------------------------------------

SurfaceEntry: struct {
    language: String
    path: String
    surface: Dyn
}

parse_json: fn(source: String, path: String) -> Dyn LedgerError! {
    json.parse_allow_duplicates(source) ?? return Err(fail("{path}: {err}"))
}

// Python's snapshot projected onto the shared containers.
python_surface: fn(root: String) -[FS]> Dyn LedgerError! {
    snapshot: parse_json(read_source(root, PYTHON_SURFACE_PATH) ?? return Err(err), PYTHON_SURFACE_PATH) ?? return Err(err)
    names := [String]{}
    sources := [[String]]{}
    operations := [[String]]{}
    loop entry in PYTHON_SOURCE_CONTAINER {
        key: entry.source
        name: byte_tail(key, key.find(":") + 1)
        members := [String]{}
        if key.starts_with("type:") {
            found: field(field(snapshot, "builtinTypes"), name)
            if !truthy(found) -> return Err(fail("Python builtin type absent from the snapshot: {name}"))
            members = text_items(field(found, "members"))
        } else {
            found: field(field(snapshot, "stdlibModules"), name)
            if !truthy(found) -> return Err(fail("Python module absent from the snapshot: {name}"))
            members = text_items(field(found, "operations"))
            loop typed in entries(field(found, "types")) {
                loop member in text_items(typed.value) -> members.push(member)
            }
        }
        at := names.index_of(entry.container) ?? -1
        if at < 0 {
            names.push(entry.container.copy())
            sources.push([String]{})
            operations.push([String]{})
            at = names.len() - 1
        }
        sources[at].push(key.copy())
        loop member in members -> operations[at].push(member)
    }
    containers := [(key: String, value: Dyn)]{}
    loop (at, name) in names {
        record := Dyn.object()
        record["present"] = Dyn.Bool(true)
        record["pythonSources"] = texts(sorted_unique(sources[at]))
        record["operations"] = texts(sorted_unique(operations[at]))
        containers.push((key: name.copy(), value: record))
    }
    loop absent in PYTHON_ABSENT {
        record := Dyn.object()
        record["present"] = Dyn.Bool(false)
        record["reason"] = jtext(absent.reason)
        record["operations"] = Dyn.Array([Dyn]{})
        at := -1
        loop (position, entry) in containers {
            if entry.key == absent.container -> at = position
        }
        if at >= 0 {
            containers[at] = (key: absent.container.copy(), value: record)
        } else {
            containers.push((key: absent.container.copy(), value: record))
        }
    }
    present := 0
    operation_count := 0
    loop entry in containers {
        if truthy(field(entry.value, "present")) -> present += 1
        operation_count += items(field(entry.value, "operations")).len()
    }
    unassigned := Dyn.object()
    loop entry in PYTHON_UNASSIGNED -> unassigned[entry.source] = jtext(entry.reason)
    surface := Dyn.object()
    surface["language"] = jtext("Python")
    surface["sourceKind"] = jtext("runtime introspection")
    surface["runtime"] = jtext("python {text_of(field(snapshot, "pythonVersion"))}")
    if has_field(snapshot, "scopeRule") -> surface["scopeRule"] = field(snapshot, "scopeRule")
    surface["unassignedSources"] = unassigned
    surface["officialReferences"] = texts([String]{
        "https://docs.python.org/3/library/functions.html",
        "https://docs.python.org/3/library/stdtypes.html",
        "https://docs.python.org/3/library/index.html",
    })
    count: containers.len()
    surface["containers"] = Dyn.Object(containers)
    totals := Dyn.object()
    totals["containers"] = Dyn.Int(count)
    totals["presentContainers"] = Dyn.Int(present)
    totals["operations"] = Dyn.Int(operation_count)
    surface["totals"] = totals
    Ok(surface)
}

load_surfaces: fn(root: String) -[FS]> [SurfaceEntry] LedgerError! {
    surfaces := [SurfaceEntry]{}
    loop entry in SURFACE_FILES {
        surface: parse_json(read_source(root, entry.path) ?? return Err(err), entry.path) ?? return Err(err)
        if !truthy(field(surface, "containers")) -> return Err(fail("surface has no containers: {entry.path}"))
        surfaces.push(SurfaceEntry{language: entry.language.copy(), path: entry.path.copy(), surface: surface})
    }
    surfaces.push(SurfaceEntry{language: "Python", path: PYTHON_SURFACE_PATH, surface: python_surface(root) ?? return Err(err)})
    Ok(surfaces)
}

// The canonical container set is the union of every recorded surface. A
// language missing one of them is a hidden exclusion, not a silent absence.
canonical_containers: fn(surfaces: [SurfaceEntry]) -> [String] Never! {
    names := [String]{}
    loop entry in surfaces {
        loop name in keys_of(field(entry.surface, "containers")) -> names.push(name)
    }
    sorted_unique(names)
}

// One recorded container of one language, indexed for matching: `first` maps
// each normalized operation to the position of its first spelling.
SurfaceRecord: struct {
    present: Bool
    reason: Dyn
    has_reason: Bool
    attribution: String
    operations: [String]
    first: [String: Int]
}

LanguageSurface: struct {
    language: String
    path: String
    names: [String]
    records: [SurfaceRecord]
    position: [String: Int]
}

index_surfaces: fn(surfaces: [SurfaceEntry]) -> [LanguageSurface] Never! {
    out := [LanguageSurface]{}
    loop entry in surfaces {
        names := [String]{}
        records := [SurfaceRecord]{}
        position := [String: Int]{}
        loop container in entries(field(entry.surface, "containers")) {
            if !is_object(container.value) -> next
            operations: text_items(field(container.value, "operations"))
            first := [String: Int]{}
            loop (at, operation) in operations {
                key: normalize(operation)
                if first.get(key) == None -> first[key] = at
            }
            position[container.key] = records.len()
            names.push(container.key.copy())
            records.push(SurfaceRecord{
                present: truthy(field(container.value, "present")),
                reason: field(container.value, "reason"),
                has_reason: has_field(container.value, "reason"),
                attribution: text_field(container.value, "attribution"),
                operations: operations,
                first: first,
            })
        }
        out.push(LanguageSurface{language: entry.language.copy(), path: entry.path.copy(), names: names, records: records, position: position})
    }
    out
}

// ---- Matching -------------------------------------------------------------------

// Jet names free functions <protocol>_<verb>: tcp_connect, udp_send_to,
// tls_close. Comparing the whole name meant connect, listen, accept and bind
// all read as missing while Jet's own spellings read as wins. A qualifier is
// stripped only when at least two members in the container share it and the
// qualifier is not itself a member there, so zip_pad keeps its zip.
container_prefixes: fn(members: [String]) -> [String] Never! {
    heads := [String]{}
    counts := [String: Int]{}
    loop member in members {
        cut: member.find("_")
        if cut <= 0 -> next
        head: byte_slice(member, 0, cut)
        if counts.get(head) == None -> heads.push(head.copy())
        counts[head] = (counts.get(head) ?? 0) + 1
    }
    prefixes := [String]{}
    loop head in heads {
        if (counts.get(head) ?? 0) >= 2 && !members.contains(head) -> prefixes.push(head.copy())
    }
    prefixes
}

keys_for_member: fn(names: Synonyms, member: String, prefixes: [String], container: String) -> [String] Never! {
    keys := synonyms_for(names, member, container)
    cut: member.find("_")
    if cut > 0 && prefixes.contains(byte_slice(member, 0, cut)) {
        loop key in synonyms_for(names, byte_tail(member, cut + 1), container) {
            if !keys.contains(key) -> keys.push(key.copy())
        }
    }
    keys
}

// A Jet member that only qualifies another member of the same container is the
// same workflow spelled longer: a separate text/bytes hash helper beside a
// typed digest, tcp_read_bytes beside tcp_read, dns_srv_port beside dns_srv,
// now_utc beside now. Scoring the qualified form separately produced a win for
// every suffix of a member that already matched. It reports the verdict of the
// member it qualifies; "" when it qualifies none.
qualifier_base: fn(member: String, siblings: [String]) -> String Never! {
    best := ""
    loop other in siblings {
        if other == member || !member.starts_with("{other}_") -> next
        suffix: byte_tail(member, byte_len(other) + 1)
        if !RESTATING_SUFFIXES.contains(suffix) -> next
        if best == "" || byte_len(other) > byte_len(best) -> best = other.copy()
    }
    best
}

// Every key Jet covers, indexed by matching domain. Built once from the Jet
// side so both the row verdicts and the gap walk read the same answer.
JetSide: struct {
    containers: [String]
    members: [[String]]
    position: [String: Int]
    prefixes: [[String]]
    domains: [String: Int]
    domain_keys: [[String: Bool]]
}

add_member: fn(side: &JetSide, container: String, member: String) {
    at := side.position.get(container) ?? -1
    if at < 0 {
        at = side.containers.len()
        side.position[container] = at
        side.containers.push(container.copy())
        side.members.push([String]{})
    }
    side.members[at].push(member.copy())
}

cover_keys: fn(names: Synonyms, side: &JetSide) {
    loop at in 0..<side.containers.len() -> side.prefixes.push(container_prefixes(side.members[at]))
    loop at in 0..<side.containers.len() {
        container: side.containers[at]
        domain: domain_for(container)
        slot := side.domains.get(domain) ?? -1
        if slot < 0 {
            slot = side.domain_keys.len()
            side.domains[domain] = slot
            side.domain_keys.push([String: Bool]{})
        }
        loop member in side.members[at] {
            // A type name must not cover a competitor's operation.
            if is_type_item(member) -> next
            loop key in keys_for_member(names, member, side.prefixes[at], container) -> side.domain_keys[slot][key] = true
        }
    }
}

side_members: fn(side: JetSide, container: String) -> [String] Never! {
    at: side.position.get(container) ?? return [String]{}
    side.members[at].copy()
}

side_prefixes: fn(side: JetSide, container: String) -> [String] Never! {
    at: side.position.get(container) ?? return [String]{}
    side.prefixes[at].copy()
}

// ---- Rows -----------------------------------------------------------------------

// One competitor cell. `operation` and `found_in` are "" when the cell has none.
CompetitorCell: struct {
    language: String
    status: String
    operation: String
    found_in: String
    reason: Dyn
    has_reason: Bool
}

plain_cell: fn(language: String, status: String) -> CompetitorCell Never! {
    CompetitorCell{language: language.copy(), status: status.copy(), operation: "", found_in: "", reason: Dyn.Null, has_reason: false}
}

// The first spelling `record` has for `exact`, else for any of `keys`, or -1.
record_hit: fn(record: SurfaceRecord, exact: String, keys: [String]) -> Int Never! {
    if record.first.get(exact) == .Val(at) -> return at
    best := -1
    loop key in keys {
        if record.first.get(key) == .Val(at) {
            if best < 0 || at < best -> best = at
        }
    }
    best
}

competitor_cells: fn(surfaces: [LanguageSurface], container: String, member: String, keys: [String]) -> [CompetitorCell] Never! {
    domain: domain_for(container)
    look_in := [String]{}
    loop entry in MATCH_DOMAIN {
        if entry.domain == domain -> look_in.push(entry.container.copy())
    }
    if look_in.len() == 0 -> look_in.push(container.copy())
    exact: normalize(member)
    cells := [CompetitorCell]{}
    loop surface in surfaces {
        at: surface.position.get(container) ?? -1
        if at < 0 {
            cells.push(plain_cell(surface.language, "no_container_recorded"))
            next
        }
        if !surface.records[at].present {
            cells.push(CompetitorCell{language: surface.language.copy(), status: "container_absent", operation: "", found_in: "", reason: surface.records[at].reason.copy(), has_reason: surface.records[at].has_reason})
            next
        }
        // Look across the domain: Jet's core.files.remove is answered by Python's
        // os.unlink, which the snapshot records under core.sys.
        hit_operation := ""
        hit_container := ""
        loop name in look_in {
            sibling: surface.position.get(name) ?? -1
            if sibling < 0 || !surface.records[sibling].present -> next
            found: record_hit(surface.records[sibling], exact, keys)
            if found >= 0 {
                hit_operation = surface.records[sibling].operations[found].copy()
                hit_container = name.copy()
                if name == container -> break
            }
        }
        if hit_container != "" {
            cells.push(CompetitorCell{language: surface.language.copy(), status: "has", operation: hit_operation, found_in: hit_container, reason: Dyn.Null, has_reason: false})
        } else {
            cells.push(plain_cell(surface.language, "lacks"))
        }
    }
    cells
}

// One verdict per row. A row no recorded competitor answers is a Jet win; a row
// at least one answers is equal. A container no surface records cannot be
// scored either way, and says so.
verdict_for: fn(cells: [CompetitorCell]) -> String Never! {
    recorded := false
    loop cell in cells {
        if cell.status == "has" -> return "equal"
        if cell.status != "no_container_recorded" -> recorded = true
    }
    if recorded -> "jet_wins" else -> "not_compared"
}

// One ledger row. `source_line` is -1 for a gap row, `qualifies` and
// `declined_by` are "" when absent, and `pooled_witness_count` is -1 unless it
// differs from the row's own witness count.
Row: struct {
    id: String
    kind: String
    module_name: String
    type_name: String
    function: String
    member: String
    source_line: Int
    containers: [String]
    languages: [String]
    qualifies: String
    container: String
    jet_spelling: String?
    workflow: String
    verdict: String
    witness_count: Int
    pooled_witness_count: Int
    competitors: [CompetitorCell]
    evidence: [String]
    declined_by: String
}

row_for_module: fn(module_fact: ModuleFact, member: String, fixed_only: Bool, surfaces: [LanguageSurface], keys: [String], qualified_by: String) -> Row Never! {
    container: container_for(module_fact.name)
    cells: competitor_cells(surfaces, container, member, keys)
    type_item: is_type_item(member)
    Row{
        id: "module.{module_fact.name}.{member}",
        kind: if fixed_only -> "fixed_sig" else -> "module_item",
        module_name: module_fact.name.copy(),
        type_name: "",
        function: "",
        member: member.copy(),
        source_line: module_fact.source_line,
        containers: [String]{},
        languages: [String]{},
        qualifies: qualified_by.copy(),
        container: container.copy(),
        jet_spelling: Val("{module_fact.name}.{member}"),
        workflow: if type_item -> "Core type exported by {container}" else -> "Core module workflow for {container}",
        verdict: if type_item -> "type_item" else -> verdict_for(cells),
        witness_count: -1,
        pooled_witness_count: -1,
        competitors: cells,
        evidence: [String]{"source:{CORE_SOURCE_PATH}", "source:{CORE_SURFACE_INVENTORY_PATH}"},
        declined_by: "",
    }
}

row_for_collection: fn(entry: Collection, method: String, surfaces: [LanguageSurface], keys: [String], qualified_by: String, fixtures: [String]) -> Row Never! {
    container: container_for(entry.type_name)
    cells: competitor_cells(surfaces, container, method, keys)
    type_item: is_type_item(method)
    evidence := [String]{"source:{CORE_SURFACE_INVENTORY_PATH}"}
    loop path in fixtures -> evidence.push("fixture:{path}")
    Row{
        id: "collection.{entry.type_name}.{method}",
        kind: "collection_method_return",
        module_name: "",
        type_name: entry.type_name.copy(),
        function: entry.function.copy(),
        member: method.copy(),
        source_line: entry.source_line,
        containers: [String]{},
        languages: [String]{},
        qualifies: qualified_by.copy(),
        container: container.copy(),
        jet_spelling: Val("{entry.type_name}.{method}"),
        workflow: if type_item -> "Core type exported by {container}" else -> "Core type workflow for {container}",
        verdict: if type_item -> "type_item" else -> verdict_for(cells),
        witness_count: -1,
        pooled_witness_count: -1,
        competitors: cells,
        evidence: evidence,
        declined_by: "",
    }
}

// The keys a member covers: its own, and those of the member it qualifies.
member_keys: fn(names: Synonyms, side: JetSide, container: String, member: String) -> [String] Never! {
    prefixes: side_prefixes(side, container)
    keys := keys_for_member(names, member, prefixes, container)
    base: qualifier_base(member, side_members(side, container))
    if base != "" {
        loop key in keys_for_member(names, base, prefixes, container) {
            if !keys.contains(key) -> keys.push(key.copy())
        }
    }
    keys
}

JetRows: struct {
    rows: [Row]
    side: JetSide
}

module_fact_named: fn(modules: [ModuleFact], name: String) -> ModuleFact? Never! {
    loop entry in modules {
        if entry.name == name -> return Val(entry.copy())
    }
    None
}

build_rows: fn(root: String, names: Synonyms, modules: [ModuleFact], inventory: Inventory, surfaces: [LanguageSurface], bindings: [Binding]) -[FS]> JetRows LedgerError! {
    // Two passes: the Jet side decides which keys are covered before any verdict
    // is taken, so a container's own naming pattern is known up front.
    side := JetSide{containers: [String]{}, members: [[String]]{}, position: [String: Int]{}, prefixes: [[String]]{}, domains: [String: Int]{}, domain_keys: [[String: Bool]]{}}
    module_keys := [String: Bool]{}
    loop entry in modules {
        loop member in entry.members {
            module_keys["{entry.name}.{member}"] = true
            add_member(side, container_for(entry.name), member)
        }
    }
    loop pair in inventory.fixed_pairs {
        if module_keys.get(pair) != None -> next
        split: pair.rfind(".")
        add_member(side, container_for(byte_slice(pair, 0, split)), byte_tail(pair, split + 1))
    }
    loop entry in inventory.collections {
        loop method in entry.methods -> add_member(side, container_for(entry.type_name), method)
    }
    cover_keys(names, side)

    rows := [Row]{}
    loop entry in modules {
        container: container_for(entry.name)
        loop member in entry.members {
            rows.push(row_for_module(entry, member, false, surfaces, member_keys(names, side, container, member), qualifier_base(member, side_members(side, container))))
        }
    }
    loop pair in inventory.fixed_pairs {
        if module_keys.get(pair) != None -> next
        split: pair.rfind(".")
        owner_name: byte_slice(pair, 0, split)
        member: byte_tail(pair, split + 1)
        entry: module_fact_named(modules, owner_name) ?? return Err(fail("fixed signature module missing from inventory: {owner_name}"))
        container: container_for(owner_name)
        rows.push(row_for_module(entry, member, true, surfaces, member_keys(names, side, container, member), qualifier_base(member, side_members(side, container))))
    }
    loop entry in inventory.collections {
        container: container_for(entry.type_name)
        loop method in entry.methods {
            fixtures: conformance_fixture_sources(root, bindings, "collection.{entry.type_name}.{method}") ?? return Err(err)
            rows.push(row_for_collection(entry, method, surfaces, member_keys(names, side, container, method), qualifier_base(method, side_members(side, container)), fixtures))
        }
    }
    order: collated(loop row in rows -> row.id)
    position := [String: Int]{}
    loop (at, row) in rows -> position[row.id] = at
    sorted := loop id in order -> rows[position.get(id) ?? 0].copy()
    Ok(JetRows{rows: sorted, side: side})
}

// One workflow Jet lacks, merged over its domain.
Gap: struct {
    id: String
    container: String
    key: String
    containers: [String]
    languages: [String]
    operations: [String]
    found_in: [String]
    evidence: [String]
}

// Walking only Jet's own tables can never surface a feature Jet is missing, so
// every recorded competitor operation that no Jet row matched becomes its own
// visible row.
competitor_rows: fn(names: Synonyms, surfaces: [LanguageSurface], jet: JetRows) -> [Row] Never! {
    // Matching is set to set, not one to one. Recording only the single operation
    // each Jet member happened to match left every other spelling of the same
    // workflow scored as a gap: List.push matched Rust append, and Rust push,
    // Ruby push and Python append all still counted as separate losses.
    jet_containers := [String: Bool]{}
    loop row in jet.rows -> jet_containers[row.container] = true

    // A gap is one workflow Jet lacks, not one row per language. Ten languages
    // shipping sqrt is one missing operation with ten witnesses, and minting a
    // row each multiplied the backlog by the size of the comparison set.
    gaps := [Gap]{}
    gap_at := [String: Int]{}
    loop surface in surfaces {
        loop (at, container) in surface.names {
            if !surface.records[at].present -> next
            // Jet must ship the container before an operation in it can be a loss. A
            // container Jet has no table for is reported as an uncompared domain
            // instead, so the shortfall is named without being invented.
            if jet_containers.get(container) == None -> next
            // A package-level index can confirm that the language documents a name,
            // but cannot place that name in this container. Minting a gap row from
            // it would score Jet against operations the index never attributed here.
            // The skip is listed in packageAttributedContainers, never silent.
            if surface.records[at].attribution == "package" -> next
            domain: domain_for(container)
            slot: jet.side.domains.get(domain) ?? -1
            loop operation in surface.records[at].operations {
                // An operator is syntax, not a named operation. Ruby alone exposes %,
                // *, +, +@, <<, =~, [] and []= as String members.
                if !is_named_operation(operation) -> next
                if slot >= 0 && jet.side.domain_keys[slot].get(normalize(operation)) != None -> next
                // One capability, one gap: is_subset, is_subset_of and issubset are
                // three spellings of the operation Jet would ship once.
                key: canonical_key(names, operation, container)
                if slot >= 0 && jet.side.domain_keys[slot].get(key) != None -> next
                // Merge on the matching domain, not the container. Python records
                // unlink under core.sys and Ruby under core.path; they are one missing
                // capability with two witnesses, not two single-witness rows.
                id: "gap.{domain}.{key}"
                index := gap_at.get(id) ?? -1
                if index < 0 {
                    index = gaps.len()
                    gap_at[id] = index
                    gaps.push(Gap{id: id, container: container.copy(), key: key, containers: [String]{}, languages: [String]{}, operations: [String]{}, found_in: [String]{}, evidence: [String]{}})
                }
                if !gaps[index].containers.contains(container) -> gaps[index].containers.push(container.copy())
                // One row per distinct operation per language: Ruby ships chop and
                // chop!, which are one workflow spelled twice. Record where the
                // witness was seen: a merged gap spans containers, so the spelling
                // may come from a sibling of the one the row is filed in.
                if !gaps[index].languages.contains(surface.language) {
                    gaps[index].languages.push(surface.language.copy())
                    gaps[index].operations.push(operation.copy())
                    gaps[index].found_in.push(container.copy())
                }
                evidence: "surface:{surface.path}"
                if !gaps[index].evidence.contains(evidence) -> gaps[index].evidence.push(evidence)
            }
        }
    }

    // Pool the witnesses of a classified capability across domains, so a name two
    // languages ship is scored once as a gap rather than held at one witness in
    // each domain that asks for it separately.
    // Pooling only carries between containers that are *types*. A value or
    // container protocol transfers from a List to a Map because both are things
    // you hold; it does not transfer into a module namespace. `core.math` gains
    // no `clear` because a List has one, and reading it that way invented gaps
    // like `core.sys.hash` and `core.time.push`.
    pooled_names := [String: Bool]{}
    loop name in CROSS_DOMAIN_POOLED -> pooled_names[name] = true
    pooled := [String: [String]]{}
    loop gap in gaps {
        if pooled_names.get(gap.key) == None || gap.containers.len() == 0 -> next
        all_types := true
        loop container in gap.containers {
            if !is_type_container(container) -> all_types = false
        }
        if !all_types -> next
        known := pooled.get(gap.key) ?? [String]{}
        loop language in gap.languages {
            if !known.contains(language) -> known.push(language.copy())
        }
        pooled[gap.key] = known
    }

    rows := [Row]{}
    loop gap in gaps {
        languages: sorted_unique(gap.languages)
        pooled_languages: pooled.get(gap.key)
        scored: if pooled_languages == .Val(list) -> list.len() else -> languages.len()
        containers: sorted_unique(gap.containers)
        cells := [CompetitorCell]{}
        loop language in languages {
            at: gap.languages.index_of(language) ?? 0
            cells.push(CompetitorCell{language: language.copy(), status: "has", operation: gap.operations[at].copy(), found_in: gap.found_in[at].copy(), reason: Dyn.Null, has_reason: false})
        }
        rows.push(Row{
            id: gap.id.copy(),
            kind: "competitor_operation",
            module_name: "",
            type_name: "",
            function: "",
            member: gap.key.copy(),
            source_line: -1,
            containers: containers.copy(),
            languages: languages.copy(),
            qualifies: "",
            container: containers[0].copy(),
            jet_spelling: None,
            workflow: "operation {languages.len()} of {surfaces.len()} compared languages ship in {gap.container}, with no matching Jet spelling",
            // One language shipping a name is not evidence that Jet is missing a
            // workflow: 8446 of 9117 gaps had a single witness, and they are that
            // language's own internals, such as Rust's align_to and as_mut_ptr,
            // which a memory-safe language cannot and should not expose. A gap two
            // compared languages agree on is a real one. Single-witness rows stay in
            // the ledger and stay counted; they are recorded, not scored.
            verdict: if scored >= 2 -> "jet_loses" else -> "single_witness",
            witness_count: languages.len(),
            // Present only where the two differ, so a reader can see at a glance that
            // this row was scored on pooled evidence rather than its own.
            pooled_witness_count: if scored != languages.len() -> scored else -> -1,
            competitors: cells,
            evidence: sorted_unique(gap.evidence),
            declined_by: "",
        })
    }
    rows
}

apply_ratified_declines: fn(rows: &[Row]) -> Int LedgerError! {
    seen := [String: Bool]{}
    loop at in 0..<rows.len() {
        loop entry in RATIFIED_DECLINES {
            if entry.id != rows[at].id -> next
            if rows[at].verdict != "jet_loses" && rows[at].verdict != "single_witness" {
                return Err(fail("RATIFIED_DECLINES names {rows[at].id}, but its verdict is already {rows[at].verdict} — remove the stale entry"))
            }
            rows[at].verdict = "declined"
            rows[at].declined_by = entry.decision.copy()
            rows[at].jet_spelling = Val(entry.spelling.copy())
            seen[entry.id] = true
        }
    }
    missing := [String]{}
    loop entry in RATIFIED_DECLINES {
        if seen.get(entry.id) == None -> missing.push(entry.id.copy())
    }
    if missing.len() > 0 -> return Err(fail("RATIFIED_DECLINES names a row the ledger no longer mints: {missing.join(", ")}"))
    Ok(0)
}

cell_dyn: fn(cell: CompetitorCell) -> Dyn Never! {
    out := Dyn.object()
    out["status"] = jtext(cell.status)
    out["operation"] = if cell.operation == "" -> Dyn.Null else -> jtext(cell.operation)
    if cell.status == "container_absent" && cell.has_reason -> out["reason"] = cell.reason.copy()
    if cell.status == "has" -> out["foundIn"] = jtext(cell.found_in)
    out
}

cells_dyn: fn(cells: [CompetitorCell]) -> Dyn Never! {
    out := Dyn.object()
    loop cell in cells -> out[cell.language] = cell_dyn(cell)
    out
}

row_dyn: fn(row: Row) -> Dyn Never! {
    out := Dyn.object()
    out["id"] = jtext(row.id)
    source := Dyn.object()
    source["kind"] = jtext(row.kind)
    if row.kind == "competitor_operation" {
        source["container"] = jtext(row.containers[0])
        source["containers"] = texts(row.containers)
        source["member"] = jtext(row.member)
        source["languages"] = texts(row.languages)
        source["sourceLine"] = Dyn.Null
    } else {
        if row.kind == "collection_method_return" {
            source["type"] = jtext(row.type_name)
            source["function"] = jtext(row.function)
        } else {
            source["module"] = jtext(row.module_name)
        }
        source["member"] = jtext(row.member)
        source["sourceLine"] = Dyn.Int(row.source_line)
    }
    out["source"] = source
    if row.qualifies != "" -> out["qualifies"] = jtext(row.qualifies)
    out["container"] = jtext(row.container)
    out["jetSpelling"] = if row.jet_spelling == .Val(spelling) -> jtext(spelling) else -> Dyn.Null
    out["workflow"] = jtext(row.workflow)
    out["verdict"] = jtext(row.verdict)
    if row.kind == "competitor_operation" {
        out["witnessCount"] = Dyn.Int(row.witness_count)
        if row.pooled_witness_count >= 0 -> out["pooledWitnessCount"] = Dyn.Int(row.pooled_witness_count)
    }
    out["competitors"] = cells_dyn(row.competitors)
    out["evidence"] = texts(row.evidence)
    if row.declined_by != "" -> out["declinedBy"] = jtext(row.declined_by)
    out
}

// ---- Owners ---------------------------------------------------------------------

BoardCard: struct {
    num: Int
    phase: String
}

BoardDecision: struct {
    id: String
    status: String
}

// The cards and decisions this ledger names, as the tree's Tower CLI shows
// them. `readable` is false when the tree carries no board.
Board: struct {
    readable: Bool
    cards: [BoardCard]
    decisions: [BoardDecision]
}

tower_command: fn(root: String, args: [String]) -> ProcessSpec Never! {
    argv := [String]{"node", TOWER_CLI_PATH}
    loop arg in args -> argv.push(arg.copy())
    argv.push("--json")
    argv.push("--data")
    argv.push(TOWER_DATA_DIR)
    process.cmd(argv).cwd(root).stdout(.Capture).stderr(.Capture).output_limit(OUTPUT_LIMIT)
}

// One `show --json` answer: the record, Null when Tower has no such record.
tower_record: fn(result: ProcessReceipt IOError!, what: String) -> Dyn LedgerError! {
    if result == {
        .Ok(receipt) -> {
            answer: json.parse(receipt.output) ?? return Err(fail("tower {what} answered no JSON (exit {receipt.code}): {receipt.errors.trim()}"))
            if receipt.code == 0 && !receipt.timed_out -> return Ok(answer)
            if text_is(answer, "error", "E_NOT_FOUND") -> return Ok(Dyn.Null)
            Err(fail("tower {what} failed (exit {receipt.code}): {text_field(answer, "message")}"))
        }
        .Err(failure) -> Err(fail("tower {what} could not start: {failure}"))
    }
}

tower_board: fn(root: String) -[Env, Exec, FS, Time.Wait]> Board LedgerError! {
    if !files.exists("{root}/{TOWER_BOARD_PATH}") -> return Ok(Board{readable: false, cards: [BoardCard]{}, decisions: [BoardDecision]{}})
    nums := [Int]{}
    loop entry in CLUSTER_OWNER {
        if !nums.contains(entry.card) -> nums.push(entry.card)
    }
    ids := [String]{}
    loop entry in RATIFIED_DECLINES {
        if !ids.contains(entry.decision) -> ids.push(entry.decision.copy())
    }
    specs := [ProcessSpec]{}
    loop num in nums -> specs.push(tower_command(root, [String]{"card", "show", "#{num}"}))
    loop id in ids -> specs.push(tower_command(root, [String]{"decision", "show", id}))
    ran: process.run_all(specs, 8) ?? return Err(fail("tower cannot run: {err}"))
    cards := [BoardCard]{}
    loop (at, num) in nums {
        card: tower_record(ran[at], "card #{num}") ?? return Err(err)
        if card == .Null -> next
        cards.push(BoardCard{num: num, phase: text_field(card, "phase")})
    }
    decisions := [BoardDecision]{}
    loop (at, id) in ids {
        decision: tower_record(ran[nums.len() + at], "decision {id}") ?? return Err(err)
        if decision == .Null -> next
        decisions.push(BoardDecision{id: id.copy(), status: text_field(decision, "status")})
    }
    Ok(Board{readable: true, cards: cards, decisions: decisions})
}

board_card: fn(board: Board, num: Int) -> BoardCard? Never! {
    loop card in board.cards {
        if card.num == num -> return Val(card.copy())
    }
    None
}

owner_card: fn(container: String) -> Int Never! {
    loop entry in CLUSTER_OWNER {
        if entry.container == container -> return entry.card
    }
    -1
}

// A cluster is one container's losses. Owning a gap per container is what the
// existing cards already do, so the ledger folds into them rather than opening
// a second owner for the same surface.
loss_clusters: fn(rows: [Row], board: Board) -> Dyn Never! {
    containers := [String]{}
    counts := [Int]{}
    pooled := [Int]{}
    languages := [[String]]{}
    loop row in rows {
        if row.verdict != "jet_loses" -> next
        at := containers.index_of(row.container) ?? -1
        if at < 0 {
            containers.push(row.container.copy())
            counts.push(0)
            pooled.push(0)
            languages.push([String]{})
            at = containers.len() - 1
        }
        counts[at] = counts[at] + 1
        // A pooled row is scored on evidence gathered in another domain, so a
        // reader sizing this cluster can see how much of it rests on that.
        if row.pooled_witness_count > 0 -> pooled[at] = pooled[at] + 1
        loop language in row.languages -> languages[at].push(language.copy())
    }
    keyed := loop (at, container) in containers -> (count: counts[at], key: text.collation_key(container), at: at)
    keyed.sort_by((left: (count: Int, key: [U8], at: Int), right: (count: Int, key: [U8], at: Int)) -> count_then_key(left.count, left.key, right.count, right.key))
    out := [Dyn]{}
    loop item in keyed {
        at: item.at
        container: containers[at]
        card: owner_card(container)
        record: if card >= 0 && board.readable -> board_card(board, card) else -> None
        state := "needs_card"
        if card >= 0 && !board.readable {
            state = "unverified"
        } else {
            if record == .Val(found) {
                state = if found.phase != "done" -> "live" else -> "closed"
            } else {
                if card >= 0 -> state = "missing"
            }
        }
        cluster := Dyn.object()
        cluster["container"] = jtext(container)
        cluster["lossCount"] = Dyn.Int(counts[at])
        cluster["pooledLossCount"] = Dyn.Int(pooled[at])
        cluster["languages"] = texts(sorted_unique(languages[at]))
        cluster["ownerCard"] = if card >= 0 -> Dyn.Int(card) else -> Dyn.Null
        cluster["ownerCardPhase"] = if record == .Val(found) -> jtext(found.phase) else -> Dyn.Null
        cluster["ownerState"] = jtext(state)
        out.push(cluster)
    }
    Dyn.Array(out)
}

// A container whose surface is indexed per package rather than per container.
// It can confirm a Jet match but cannot mint a gap row, so it is listed here
// and the skip stays countable.
package_attributed_containers: fn(surfaces: [LanguageSurface]) -> Dyn Never! {
    found := [(language: [U8], container: [U8], value: Dyn)]{}
    loop surface in surfaces {
        loop (at, container) in surface.names {
            if !surface.records[at].present || surface.records[at].attribution != "package" -> next
            entry := Dyn.object()
            entry["language"] = jtext(surface.language)
            entry["container"] = jtext(container)
            entry["recordedOperations"] = Dyn.Int(surface.records[at].operations.len())
            entry["reason"] = jtext("the recorded index is per package, so it cannot attribute an operation to this container")
            found.push((language: text.collation_key(surface.language), container: text.collation_key(container), value: entry))
        }
    }
    found.sort_by((left: (language: [U8], container: [U8], value: Dyn), right: (language: [U8], container: [U8], value: Dyn)) -> if compare_bytes(left.language, right.language) != Ordering.Equal -> compare_bytes(left.language, right.language) else -> compare_bytes(left.container, right.container))
    Dyn.Array(loop item in found -> item.value.copy())
}

// One capability can still be missing from several unrelated containers: every
// competitor ships Map.new, Set.new and a double-ended queue constructor, and
// Jet constructs differently. That is one design question, not one backlog
// item per container, so it is reported as a repeat instead of hiding inside
// the row count.
Repeat: struct {
    operation: String
    containers: [String]
}

repeated_operations: fn(rows: [Row]) -> [Repeat] Never! {
    repeats := [Repeat]{}
    at_key := [String: Int]{}
    loop row in rows {
        if row.verdict != "jet_loses" -> next
        at := at_key.get(row.member) ?? -1
        if at < 0 {
            at = repeats.len()
            at_key[row.member] = at
            repeats.push(Repeat{operation: row.member.copy(), containers: [String]{}})
        }
        repeats[at].containers.push(row.container.copy())
    }
    kept := [(count: Int, key: [U8], at: Int)]{}
    loop (at, item) in repeats {
        if item.containers.len() >= 3 -> kept.push((count: item.containers.len(), key: text.collation_key(item.operation), at: at))
    }
    kept.sort_by((left: (count: Int, key: [U8], at: Int), right: (count: Int, key: [U8], at: Int)) -> count_then_key(left.count, left.key, right.count, right.key))
    out := [Repeat]{}
    loop item in kept {
        sorted := repeats[item.at].containers.copy()
        sorted.sort()
        out.push(Repeat{operation: repeats[item.at].operation.copy(), containers: sorted})
    }
    out
}

repeats_dyn: fn(repeats: [Repeat]) -> Dyn Never! {
    out := [Dyn]{}
    loop item in repeats {
        entry := Dyn.object()
        entry["operation"] = jtext(item.operation)
        entry["containers"] = texts(item.containers)
        entry["rowCount"] = Dyn.Int(item.containers.len())
        out.push(entry)
    }
    Dyn.Array(out)
}

uncompared_domains: fn(modules: [ModuleFact], containers: [String]) -> [String] Never! {
    recorded := [String: Bool]{}
    loop name in containers -> recorded[name] = true
    out := [String]{}
    loop entry in modules {
        if recorded.get(container_for(entry.name)) == None -> out.push(entry.name.copy())
    }
    out.sort()
    out
}

// Every conformance fixture path the bindings name, each once, first seen first.
conformance_fixture_paths: fn(bindings: [Binding]) -> [String] Never! {
    paths := [String]{}
    loop binding in bindings {
        loop path in binding.paths -> paths.push("{CORE_CONFORMANCE_FIXTURE_ROOT}/{path}")
    }
    first_seen(paths)
}

source_files: fn(root: String, bindings: [Binding]) -[FS]> Dyn LedgerError! {
    paths := [String]{
        CORE_SOURCE_PATH,
        CORE_SURFACE_INVENTORY_PATH,
        BUILTIN_METHODS_PATH,
        BUILTIN_STATICS_PATH,
        COLLECTIONS_PATH,
        CORE_SOURCE_PARTS_PATH,
        CORE_CALL_EXTENSIONS_PATH,
    }
    listed: files.list_dir("{root}/{SYNTAX_DIR}") ?? return Err(fail("cannot list {SYNTAX_DIR}: {err}"))
    syntax := [String]{}
    loop entry in listed {
        if entry.name.ends_with(".jet") -> syntax.push(entry.name.copy())
    }
    syntax.sort()
    loop name in syntax -> paths.push("{SYNTAX_DIR}/{name}")
    loop path in ([String]{
        PYTHON_SURFACE_PATH,
        CORE_API_LAWS_PATH,
        SYNTAX_REFERENCE_PATH,
        AGENT_MANIFEST_PATH,
        AGENT_RECEIPT_PATH,
        AGENT_REVIEW_PATH,
        AGENT_DOMAIN_CONTRACT_PATH,
        AGENT_WORKLOAD_POLICY_PATH,
        AGENT_CHECKSUMS_PATH,
    }) -> paths.push(path)
    loop path in AGENT_RUNNER_SOURCE_PATHS -> paths.push(path)
    paths.push(CORE_API_REVIEW_TEST_PATH)
    paths.push(CORE_CONFORMANCE_PATH)
    loop path in conformance_fixture_paths(bindings) -> paths.push(path)
    loop path in EDITOR_COVERAGE_PATHS -> paths.push(path)
    loop path in ([String]{
        "tests/lsp/02_hover.json",
        "tests/ui/variadic_not_last.stderr",
        "tests/ui/spread_bad_call.stderr",
        "tests/ui/yield_type_mismatch.stderr",
        "tests/ui/user_policy_bad_args.stderr",
    }) -> paths.push(path)
    loop entry in SURFACE_FILES -> paths.push(entry.path)
    out := [Dyn]{}
    loop path in paths {
        source: read_source(root, path) ?? return Err(err)
        entry := Dyn.object()
        entry["path"] = jtext(path)
        entry["sha256"] = jtext(sha_hex(source))
        entry["lineCount"] = Dyn.Int(split_lines(source).len())
        out.push(entry)
    }
    Ok(Dyn.Array(out))
}

// ---- Core API gate: frozen fixtures -----------------------------------------

// One frozen TSV manifest: each row by its header's column names.
tsv_records: fn(root: String, path: String) -[FS]> [[String: String]] LedgerError! {
    source: read_source(root, path) ?? return Err(err)
    lines := [String]{}
    loop line in split_lines(source) {
        if line != "" -> lines.push(line)
    }
    if lines.len() < 2 -> return Err(fail("empty frozen TSV manifest: {path}"))
    header: lines[0].split("\t").to_list()
    records := [[String: String]]{}
    loop index in 1..<lines.len() {
        cells: lines[index].split("\t").to_list()
        if cells.len() != header.len() -> return Err(fail("malformed frozen TSV row {path}:{index + 1}"))
        record := [String: String]{}
        loop (at, name) in header -> record[name] = cells[at].copy()
        records.push(record)
    }
    Ok(records)
}

// Column `name` of a frozen TSV row; "" when the manifest has no such column.
cell: fn(record: [String: String], name: String) -> String Never! {
    if record.get(name) == .Val(value) -> return value.copy()
    ""
}

// Keep fixture source lookup aligned with the existing agent corpus runner's
// adapter_stem mapping. This is only a path lookup; scoring stays in the
// runner named by the frozen contract below.
agent_adapter_stem: fn(task_id: String) -> String LedgerError! {
    if task_id == "repository-marker-scan" || task_id == "repository-marker-scan-empty" -> return Ok("repository_marker_scan")
    if task_id == "repository-semantic-inspection" -> return Ok("repository_semantic_inspection")
    if task_id == "repository-semantic-edit" -> return Ok("repository_semantic_edit")
    if task_id == "git-diff-review" || task_id == "git-diff-empty" -> return Ok("git_diff_review")
    if task_id == "build-test-failure-recovery" -> return Ok("build_test_recovery")
    if task_id.starts_with("incident-report-") -> return Ok("incident_report")
    if task_id.starts_with("structured-data-") -> return Ok("structured_data")
    if task_id.starts_with("database-") -> return Ok("database_access")
    if task_id.starts_with("http-") -> return Ok("http_api")
    if task_id.starts_with("process-batch-") -> return Ok("process_batch")
    if task_id.starts_with("mcp-environment-") -> return Ok("mcp_resource")
    if task_id.starts_with("interactive-terminal-") -> return Ok("interactive_terminal")
    if task_id.starts_with("service-lifecycle-") -> return Ok("service_lifecycle")
    if task_id == "browser-automation-preflight" -> return Ok("browser_automation_preflight")
    if task_id == "desktop-interaction-focus" -> return Ok("desktop_interaction_focus")
    if task_id == "document-markdown-inspection" -> return Ok("document_markdown_inspection")
    if task_id == "media-asset-inventory" -> return Ok("media_asset_inventory")
    Err(fail("frozen Core API fixture has no adapter stem: {task_id}"))
}

// The adapter file suffix the corpus runner gives each adapter; "" for none.
adapter_suffix: fn(adapter: String) -> String Never! {
    if adapter == "jet" -> return "jet"
    if adapter == "bash" -> return "bash"
    if adapter == "python" -> return "py"
    if adapter == "node" -> return "mjs"
    ""
}

nul: fn() -> String Never! { String.from_bytes_lossy([U8]{U8{0}}) }

fixture_source_digest: fn(root: String, paths: [String]) -[FS]> String LedgerError! {
    parts := [String]{}
    loop path in paths {
        source: read_source(root, path) ?? return Err(err)
        parts.push("{path}{nul()}{source}")
    }
    Ok(sha_hex(parts.join(nul())))
}

safe_fixture_relative_path: fn(path: String) -> Bool Never! {
    if path == "" || path.starts_with("/") || path.contains("\\") || path.contains(":") -> return false
    loop part in path.split("/") {
        if part == "" || part == "." || part == ".." -> return false
    }
    true
}

fixture_absolute_path: fn(root: String, relative_path: String) -[FS]> String LedgerError! {
    if !safe_fixture_relative_path(relative_path) -> return Err(fail("invalid Core API fixture path: {relative_path}"))
    absolute: "{root}/{relative_path}"
    if !files.exists(absolute) -> return Err(fail("missing Core API fixture path: {relative_path}"))
    Ok(absolute)
}

file_digest: fn(path: String) -[FS]> String LedgerError! {
    bytes: files.read_bytes(path) ?? return Err(fail("cannot read {path}: {err}"))
    Ok(crypto.sha256(bytes).hex())
}

walk_fixture_input: fn(root: String, current: String, found: &[String]) -[FS]> Int LedgerError! {
    listed: files.list_dir(current) ?? return Err(fail("cannot list {current}: {err}"))
    keyed := loop entry in listed -> (name: entry.name.copy(), is_dir: entry.is_dir)
    keyed.sort_by((left: (name: String, is_dir: Bool), right: (name: String, is_dir: Bool)) -> compare_bytes(left.name.bytes(), right.name.bytes()))
    loop entry in keyed {
        child: "{current}/{entry.name}"
        if entry.is_dir {
            walk_fixture_input(root, child, found) ?? return Err(err)
            next
        }
        if !files.is_file(child) -> return Err(fail("unsupported Core API fixture input entry: {child}"))
        digest: file_digest(child) ?? return Err(err)
        found.push("{byte_tail(child, byte_len(root) + 1)}\t{digest}\n")
    }
    Ok(found.len())
}

fixture_input_digest: fn(root: String, relative_path: String) -[FS]> String LedgerError! {
    path: fixture_absolute_path(root, "{AGENT_CORPUS_ROOT}/{relative_path}") ?? return Err(err)
    found := [String]{}
    if files.is_dir(path) {
        walk_fixture_input(path, path, found) ?? return Err(err)
    } else {
        if !files.is_file(path) -> return Err(fail("unsupported Core API fixture input: {relative_path}"))
        digest: file_digest(path) ?? return Err(err)
        found.push("{byte_tail(relative_path, relative_path.rfind("/") + 1)}\t{digest}\n")
    }
    Ok(sha_hex(found.join("")))
}

fixture_artifact_digest: fn(root: String, relative_path: String) -[FS]> String LedgerError! {
    path: fixture_absolute_path(root, "{AGENT_CORPUS_ROOT}/baselines/{relative_path}") ?? return Err(err)
    file_digest(path)
}

// The words of `path`: its text split on JavaScript's `\s+`.
fixture_source_token_count: fn(root: String, path: String) -[FS]> Int LedgerError! {
    source: read_source(root, path) ?? return Err(err)
    bytes: source.bytes()
    count := 0
    at := 0
    in_word := false
    loop {
        if at >= bytes.len() -> return Ok(count)
        space: space_len(bytes, at)
        if space > 0 {
            in_word = false
            at += space
            next
        }
        if !in_word -> count += 1
        in_word = true
        at += 1
    }
}

review_boolean: fn(value: String, name: String, task_id: String) -> Bool LedgerError! {
    if value != "true" && value != "false" -> return Err(fail("Core API fixture review has invalid {name}: {task_id}"))
    Ok(value == "true")
}

accepted_fixture_review: fn(review: Dyn, task_id: String, source_digest: Dyn, input_digest: Dyn, expected_digest: Dyn, has_python: Bool) -> Bool Never! {
    if !is_object(review) -> return false
    guarantees: if has_python -> "not-emulated" else -> "not-applicable"
    text_is(review, "status", "accepted") && non_empty(field(review, "reviewer")) &&
        non_empty(field(review, "method")) && text_is(review, "fixtureTask", task_id) &&
        bool_is(review, "sameTaskInputOutcome", true) && bool_is(review, "idiomatic", true) &&
        bool_is(review, "minimal", true) && bool_is(review, "normalLanguageContract", true) &&
        text_is(review, "pythonGuarantees", guarantees) &&
        field(review, "sourceDigest") == source_digest && field(review, "inputDigest") == input_digest &&
        field(review, "expectedDigest") == expected_digest && non_empty(field(review, "evidence"))
}

// `Number(text)` for a frozen receipt count.
number_dyn: fn(value: String) -> Dyn Never! {
    trimmed: value.trim()
    if trimmed == "" -> return Dyn.Int(0)
    number: Int.parse(trimmed) ?? return Dyn.Null
    Dyn.Int(number)
}

// `text` with its trailing newlines cut, as /\n+$/ replaced by "" does.
without_trailing_newlines: fn(value: String) -> String Never! {
    out := value.copy()
    loop {
        if !out.ends_with("\n") -> return out
        out = out.removesuffix("\n")
    }
    Dyn.Null
}

core_api_fixture_contract: fn(root: String) -[FS]> Dyn LedgerError! {
    manifest: tsv_records(root, AGENT_MANIFEST_PATH) ?? return Err(err)
    receipts: tsv_records(root, AGENT_RECEIPT_PATH) ?? return Err(err)
    reviews: tsv_records(root, AGENT_REVIEW_PATH) ?? return Err(err)
    task_ids := [String: Bool]{}
    loop row in manifest -> task_ids[cell(row, "task_id")] = true
    review_at := [String: Int]{}
    loop (at, review) in reviews {
        task: cell(review, "task_id")
        if review_at.get(task) != None -> return Err(fail("duplicate Core API fixture review: {task}"))
        if task_ids.get(task) == None -> return Err(fail("Core API fixture review names an unknown task: {task}"))
        review_at[task] = at
    }
    receipts_at := [String: [Int]]{}
    pinned := Dyn.object()
    run_ids := [String]{}
    machines := [String]{}
    loop (at, receipt) in receipts {
        task: cell(receipt, "task_id")
        if task_ids.get(task) == None -> return Err(fail("Core API fixture receipt names an unknown task: {task}"))
        adapter: cell(receipt, "adapter")
        if !AGENT_BASELINE_ADAPTERS.contains(adapter) || !non_empty(jtext(cell(receipt, "tool_version"))) ||
            !non_empty(jtext(cell(receipt, "run_id"))) || !non_empty(jtext(cell(receipt, "machine"))) {
            return Err(fail("Core API fixture receipt has invalid identity: {task}"))
        }
        run_ids.push(cell(receipt, "run_id"))
        machines.push(cell(receipt, "machine"))
        if field(pinned, adapter) != .Null && !text_is(pinned, adapter, cell(receipt, "tool_version")) {
            return Err(fail("Core API fixture tool version drifted: {adapter}"))
        }
        pinned[adapter] = jtext(cell(receipt, "tool_version"))
        known := receipts_at.get(task) ?? [Int]{}
        known.push(at)
        receipts_at[task] = known
    }
    if first_seen(run_ids).len() != 1 || first_seen(machines).len() != 1 -> return Err(fail("Core API fixture receipt mixes run identities"))
    tasks := [Dyn]{}
    loop row in manifest {
        task_id: cell(row, "task_id")
        adapters := [String]{}
        loop adapter in cell(row, "adapters").split(",") {
            if adapter != "" -> adapters.push(adapter.copy())
        }
        task_receipts := [[String: String]]{}
        task_receipt_at: receipts_at.get(task_id) ?? [Int]{}
        loop at in task_receipt_at -> task_receipts.push(receipts[at].copy())
        at_review: review_at.get(task_id) ?? return Err(fail("missing Core API fixture review: {task_id}"))
        review: reviews[at_review]
        tool_versions := Dyn.object()
        loop receipt in task_receipts -> tool_versions[cell(receipt, "adapter")] = jtext(cell(receipt, "tool_version"))
        stem: agent_adapter_stem(task_id) ?? return Err(err)
        source_paths := [String]{}
        loop adapter in adapters {
            path: "tests/agent_workloads/adapters/{stem}.{adapter_suffix(adapter)}"
            if adapter_suffix(adapter) == "" || !files.exists("{root}/{path}") -> return Err(fail("frozen Core API fixture source is missing: {path}"))
            source_paths.push(path)
        }
        inputs: first_seen(loop receipt in task_receipts -> cell(receipt, "input_sha256"))
        expecteds: first_seen(loop receipt in task_receipts -> cell(receipt, "expected_sha256"))
        if inputs.len() != 1 || expecteds.len() != 1 -> return Err(fail("Core API fixture receipts disagree on task identity: {task_id}"))
        source_digest: fixture_source_digest(root, source_paths) ?? return Err(err)
        independent := Dyn.object()
        independent["status"] = jtext(cell(review, "status"))
        independent["reviewer"] = jtext(cell(review, "reviewer"))
        independent["method"] = jtext(cell(review, "review_method"))
        independent["fixtureTask"] = jtext(cell(review, "task_id"))
        independent["sameTaskInputOutcome"] = Dyn.Bool(review_boolean(cell(review, "same_task_input_outcome"), "same_task_input_outcome", task_id) ?? return Err(err))
        independent["idiomatic"] = Dyn.Bool(review_boolean(cell(review, "idiomatic"), "idiomatic", task_id) ?? return Err(err))
        independent["minimal"] = Dyn.Bool(review_boolean(cell(review, "minimal"), "minimal", task_id) ?? return Err(err))
        independent["normalLanguageContract"] = Dyn.Bool(review_boolean(cell(review, "normal_language_contract"), "normal_language_contract", task_id) ?? return Err(err))
        independent["pythonGuarantees"] = jtext(cell(review, "python_guarantees"))
        independent["sourceDigest"] = jtext(cell(review, "source_digest"))
        independent["inputDigest"] = jtext(cell(review, "input_sha256"))
        independent["expectedDigest"] = jtext(cell(review, "expected_sha256"))
        independent["evidence"] = jtext(cell(review, "evidence"))
        if !accepted_fixture_review(independent, task_id, jtext(source_digest), jtext(inputs[0]), jtext(expecteds[0]), adapters.contains("python")) {
            return Err(fail("Core API fixture review is not accepted: {task_id}"))
        }
        boundary := Dyn.object()
        boundary["userAuthored"] = texts(source_paths)
        boundary["generatedAndReferenceExcluded"] = texts([String]{"tests/agent_workloads/baselines", "tests/agent_workloads/expected"})
        receipt_rows := loop receipt in task_receipts -> receipt_dyn(receipt)
        task := Dyn.object()
        task["task"] = jtext(task_id)
        task["domain"] = jtext(cell(row, "domain"))
        task["case"] = jtext(cell(row, "case"))
        task["input"] = jtext(cell(row, "input"))
        task["expected"] = jtext(cell(row, "expected"))
        task["outcome"] = jtext(cell(row, "declared_outcome"))
        task["allowedDependency"] = jtext(cell(row, "authority"))
        task["toolVersions"] = tool_versions
        task["sourceBoundary"] = boundary
        task["sourceDigest"] = jtext(source_digest)
        task["inputDigest"] = jtext(inputs[0])
        task["expectedDigest"] = jtext(expecteds[0])
        task["adapters"] = texts(adapters)
        task["scoring"] = jtext(AGENT_RUNNER)
        task["runner"] = jtext(AGENT_RUNNER)
        task["receipts"] = Dyn.Array(receipt_rows)
        task["independentFixtureReview"] = independent
        tasks.push(task)
    }
    runner_digest: fixture_source_digest(root, AGENT_RUNNER_SOURCE_PATHS) ?? return Err(err)
    checksums: read_source(root, AGENT_CHECKSUMS_PATH) ?? return Err(err)
    domain_contract: read_source(root, AGENT_DOMAIN_CONTRACT_PATH) ?? return Err(err)
    policy: read_source(root, AGENT_WORKLOAD_POLICY_PATH) ?? return Err(err)
    execution := Dyn.object()
    execution["source"] = texts(AGENT_RUNNER_SOURCE_PATHS)
    execution["test"] = jtext(AGENT_RUNNER)
    execution["checksumManifest"] = jtext(AGENT_CHECKSUMS_PATH)
    execution["runnerDigest"] = jtext(runner_digest)
    execution["checksumDigest"] = jtext(sha_hex(checksums))
    execution["domainContract"] = jtext(AGENT_DOMAIN_CONTRACT_PATH)
    execution["domainContractDigest"] = jtext(sha_hex(domain_contract))
    execution["policyDigest"] = jtext(sha_hex(without_trailing_newlines(policy)))
    execution["checks"] = texts(EXECUTION_CHECKS)
    execution["runnerMarkers"] = texts(AGENT_RUNNER_MARKERS)
    selection := Dyn.object()
    selection["source"] = jtext(AGENT_REVIEW_PATH)
    selection["field"] = jtext("task_id")
    selection["oneReviewPerTask"] = Dyn.Bool(true)
    selection["sameTaskInputOutcome"] = Dyn.Bool(true)
    pinned_run := Dyn.object()
    pinned_run["runId"] = jtext(run_ids[0])
    pinned_run["machine"] = jtext(machines[0])
    pinned_run["toolVersions"] = pinned
    boundary := Dyn.object()
    boundary["rule"] = jtext("Only user-authored adapter source under tests/agent_workloads/adapters is compared.")
    boundary["excluded"] = texts([String]{"tests/agent_workloads/baselines", "tests/agent_workloads/expected"})
    contract := Dyn.object()
    contract["manifest"] = jtext(AGENT_MANIFEST_PATH)
    contract["receipt"] = jtext(AGENT_RECEIPT_PATH)
    contract["review"] = jtext(AGENT_REVIEW_PATH)
    contract["runner"] = jtext(AGENT_RUNNER)
    contract["scoring"] = jtext(AGENT_SCORING)
    contract["execution"] = execution
    contract["selection"] = selection
    contract["pinnedRun"] = pinned_run
    contract["sourceBoundary"] = boundary
    contract["tasks"] = Dyn.Array(tasks)
    Ok(contract)
}

// ---- Core API gate: the workflow manifest ------------------------------------

// Whether `text` holds any of `words`, as an unanchored regex alternation.
holds_any: fn(text: String, words: [String]) -> Bool Never! {
    loop word in words {
        if text.contains(word) -> return true
    }
    false
}

core_api_case_kinds: fn(row: Row) -> [String] Never! {
    words: "{row.container} {row.member.to_lower()} {row.workflow}".to_lower()
    cases := [String]{"beginner"}
    expert: [String]{"policy", "limit", "precision", "bound", "timeout", "schedule", "capacity", "canonical", "tls", "auth", "unsafe", "raw", "expert"}
    failure: [String]{"parse", "decode", "encode", "read", "write", "open", "load", "save", "query", "find", "get", "try", "error", "invalid", "validate", "check"}
    lifecycle: [String]{"close", "cancel", "join", "wait", "start", "stop", "resume", "pause", "stream", "task", "watch", "socket", "reader", "writer", "transaction"}
    if holds_any(words, expert) -> cases.push("expert-policy")
    if holds_any(words, failure) -> cases.push("failure")
    if holds_any(words, lifecycle) -> cases.push("lifecycle")
    cases
}

// Criterion 7 is independent of fixture completion. The ledger already has a
// machine-checkable win for every row: operation coverage when Jet is the sole
// surface, a typed declaration when the operation is shared, and an explicit
// fail-closed diagnosis when the row records a competitor-only operation. Keep
// the three claims distinct so a loss is never rewritten as parity.
core_api_jet_win: fn(row: Row) -> Dyn LedgerError! {
    evidence := [String]{}
    loop item in row.evidence {
        if item.trim() != "" -> evidence.push(item.copy())
    }
    if evidence.len() == 0 -> return Err(fail("Core API workflow has no Jet-win evidence: {row.id}"))
    property := ""
    metric := ""
    method := ""
    comparison := ""
    if row.verdict == "jet_wins" {
        matched := 0
        loop cell in row.competitors {
            if cell.status == "has" -> matched += 1
        }
        property = "Core operation availability"
        metric = "source-derived matching-coverage"
        method = "count the Jet declaration and matching competitor cells in this ledger row"
        comparison = "Jet declaration=1; matching competitor cells={matched}"
    } else {
        if row.kind != "competitor_operation" {
            property = "typed Core contract"
            metric = "source-derived typed-declaration"
            method = "count the compiler-owned Jet declaration against Python's runtime-only surface record"
            comparison = "Jet compiler declaration=1; Python typed contract=0"
        } else {
            property = "fail-closed Core diagnosis"
            metric = "source-derived explicit-verdict"
            method = "count the visible competitor operation, Jet verdict, and retained source evidence"
            comparison = "Jet keeps unsupported or declined work explicit; hidden-loss count=0"
        }
    }
    measurement := Dyn.object()
    measurement["metric"] = jtext(metric)
    measurement["method"] = jtext(method)
    measurement["comparison"] = jtext(comparison)
    measurement["rowVerdict"] = jtext(row.verdict)
    measurement["jet"] = Dyn.Int(1)
    measurement["competitor"] = Dyn.Int(0)
    win := Dyn.object()
    win["status"] = jtext("accepted")
    win["property"] = jtext(property)
    win["evidenceRef"] = jtext("ledger-row:{row.id}; {evidence.join(", ")}")
    win["kind"] = jtext("machine")
    win["compensates"] = Dyn.Bool(false)
    win["measurement"] = measurement
    Ok(win)
}

// ---- Source metrics -----------------------------------------------------------

// Criterion 4 is inventory evidence, not a fixture verdict. Count the frozen
// source boundary that names each arm now; a later accepted fixture can replace
// these counts without changing the workflow inventory. This keeps pending work
// visible instead of presenting nulls as if no source existed.
//
// The counts are a lexical scan: tokens are quoted strings, identifiers,
// numbers, the two-character operators, `..`/`...`, and any other
// non-whitespace UTF-16 unit; statements are semicolons plus lines that open
// with a statement keyword; calls are identifiers followed by `(`; named
// temporaries follow let, const, var or comptime; imports are lines that open
// with use, import, from, require or include. Whitespace is JavaScript's `\s`.
Metrics: struct {
    tokens: Int
    statements: Int
    calls: Int
    named_temporaries: Int
    imports: Int
}

// The byte length of the JavaScript `\s` character at `at`, or 0.
space_len: fn(bytes: [U8], at: Int) -> Int Never! {
    lead: Int.from_u8(bytes[at])
    if lead == 32 || (lead >= 9 && lead <= 13) -> return 1
    if lead < 128 -> return 0
    second: if at + 1 < bytes.len() -> Int.from_u8(bytes[at + 1]) else -> -1
    third: if at + 2 < bytes.len() -> Int.from_u8(bytes[at + 2]) else -> -1
    if lead == 194 && second == 160 -> return 2
    if lead == 225 && second == 154 && third == 128 -> return 3
    if lead == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) -> return 3
    if lead == 226 && second == 129 && third == 159 -> return 3
    if lead == 227 && second == 128 && third == 128 -> return 3
    if lead == 239 && second == 187 && third == 191 -> return 3
    0
}

// Whether the character at `at` ends a line for `^` and `.`.
is_line_break: fn(bytes: [U8], at: Int) -> Bool Never! {
    lead: Int.from_u8(bytes[at])
    if lead == 10 || lead == 13 -> return true
    if lead != 226 || at + 2 >= bytes.len() -> return false
    Int.from_u8(bytes[at + 1]) == 128 && (Int.from_u8(bytes[at + 2]) == 168 || Int.from_u8(bytes[at + 2]) == 169)
}

char_len: fn(lead: Int) -> Int Never! {
    if lead < 192 -> return 1
    if lead < 224 -> return 2
    if lead < 240 -> return 3
    4
}

// The end of a quoted string opening at `at`, or -1 when it never closes.
quoted_end: fn(bytes: [U8], at: Int, quote: Int) -> Int Never! {
    probe := at + 1
    loop {
        if probe >= bytes.len() -> return -1
        code: Int.from_u8(bytes[probe])
        if code == quote -> return probe + 1
        if code == 92 {
            if probe + 1 >= bytes.len() || is_line_break(bytes, probe + 1) -> return -1
            probe += 1 + char_len(Int.from_u8(bytes[probe + 1]))
        } else {
            probe += char_len(code)
        }
    }
}

word_end: fn(bytes: [U8], at: Int) -> Int Never! {
    probe := at
    loop {
        if probe >= bytes.len() || !is_word_code(Int.from_u8(bytes[probe])) -> return probe
        probe += 1
    }
}

// The end of `[A-Za-z0-9_$]*` from `at`.
dollar_word_end: fn(bytes: [U8], at: Int) -> Int Never! {
    probe := at
    loop {
        if probe >= bytes.len() -> return probe
        code: Int.from_u8(bytes[probe])
        if !is_word_code(code) && code != 36 -> return probe
        probe += 1
    }
}

digits_end: fn(bytes: [U8], at: Int) -> Int Never! {
    probe := at
    loop {
        if probe >= bytes.len() || !is_digit_byte(Int.from_u8(bytes[probe])) -> return probe
        probe += 1
    }
}

spaces_end: fn(bytes: [U8], at: Int) -> Int Never! {
    probe := at
    loop {
        if probe >= bytes.len() -> return probe
        width: space_len(bytes, probe)
        if width == 0 -> return probe
        probe += width
    }
}

// The width of a two-character operator at `at`: 3 for `...`, 2 for `..` and
// the others, 0 for none.
operator_len: fn(bytes: [U8], at: Int) -> Int Never! {
    if at + 1 >= bytes.len() -> return 0
    first: Int.from_u8(bytes[at])
    second: Int.from_u8(bytes[at + 1])
    if first == 46 && second == 46 {
        if at + 2 < bytes.len() && Int.from_u8(bytes[at + 2]) == 46 -> return 3
        return 2
    }
    if (first == 61 || first == 45) && second == 62 -> return 2
    if first == 58 && second == 58 -> return 2
    if (first == 61 || first == 33 || first == 60 || first == 62) && second == 61 -> return 2
    if (first == 38 && second == 38) || (first == 124 && second == 124) -> return 2
    0
}

source_tokens: fn(bytes: [U8]) -> Int Never! {
    count := 0
    at := 0
    loop {
        if at >= bytes.len() -> return count
        code: Int.from_u8(bytes[at])
        space: space_len(bytes, at)
        if space > 0 {
            at += space
            next
        }
        count += 1
        if code == 34 || code == 39 || code == 96 {
            end: quoted_end(bytes, at, code)
            at = if end > 0 -> end else -> at + 1
            next
        }
        if is_letter_byte(code) || code == 95 {
            at = word_end(bytes, at + 1)
            next
        }
        if is_digit_byte(code) {
            at = digits_end(bytes, at)
            if at + 1 < bytes.len() && Int.from_u8(bytes[at]) == 46 && is_digit_byte(Int.from_u8(bytes[at + 1])) -> at = digits_end(bytes, at + 1)
            next
        }
        operator: operator_len(bytes, at)
        if operator > 0 {
            at += operator
            next
        }
        // A character outside the Basic Multilingual Plane is two UTF-16 units.
        width: char_len(code)
        if width == 4 -> count += 1
        at += width
    }
}

// Whether `word` sits at `at` with no word character after it.
keyword_at: fn(bytes: [U8], at: Int, word: String) -> Bool Never! {
    spelled: word.bytes()
    if at + spelled.len() > bytes.len() -> return false
    loop index in 0..<spelled.len() {
        if bytes[at + index] != spelled[index] -> return false
    }
    end: at + spelled.len()
    end >= bytes.len() || !is_word_code(Int.from_u8(bytes[end]))
}

keyword_prefix_at: fn(bytes: [U8], at: Int, word: String) -> Bool Never! {
    spelled: word.bytes()
    if at + spelled.len() > bytes.len() -> return false
    loop index in 0..<spelled.len() {
        if bytes[at + index] != spelled[index] -> return false
    }
    true
}

opens_with_any: fn(bytes: [U8], at: Int, words: [String]) -> Bool Never! {
    loop word in words {
        if keyword_at(bytes, at, word) -> return true
    }
    false
}

source_metrics: fn(source: String) -> Metrics Never! {
    bytes: source.bytes()
    statement_words: [String]{"fn", "def", "func", "function", "export", "return", "if", "for", "while", "loop"}
    import_words: [String]{"use", "import", "from", "require", "include"}
    temporary_words: [String]{"let", "const", "var", "comptime"}
    semicolons := 0
    statement_lines := 0
    imports := 0
    calls := 0
    temporaries := 0
    line_open := true
    at := 0
    loop {
        if at >= bytes.len() -> break
        code: Int.from_u8(bytes[at])
        space: space_len(bytes, at)
        if space > 0 {
            if is_line_break(bytes, at) -> line_open = true
            at += space
            next
        }
        if line_open {
            if opens_with_any(bytes, at, statement_words) -> statement_lines += 1
            if opens_with_any(bytes, at, import_words) -> imports += 1
        }
        line_open = false
        if code == 59 -> semicolons += 1
        at += 1
    }
    // `\b[A-Za-z_$][A-Za-z0-9_$]*\s*\(` and
    // `\b(?:let|const|var|comptime)\s+[A-Za-z_$][A-Za-z0-9_$]*`, each scanned
    // left to right without overlap.
    at = 0
    loop {
        if at >= bytes.len() -> break
        code: Int.from_u8(bytes[at])
        before: at > 0 && is_word_code(Int.from_u8(bytes[at - 1]))
        if before != is_word_code(code) && (is_letter_byte(code) || code == 95 || code == 36) {
            after: spaces_end(bytes, dollar_word_end(bytes, at + 1))
            if after < bytes.len() && Int.from_u8(bytes[after]) == 40 {
                calls += 1
                at = after + 1
                next
            }
        }
        at += 1
    }
    at = 0
    loop {
        if at >= bytes.len() -> break
        code: Int.from_u8(bytes[at])
        before: at > 0 && is_word_code(Int.from_u8(bytes[at - 1]))
        matched := false
        if !before && is_letter_byte(code) {
            loop word in temporary_words {
                if matched || !keyword_prefix_at(bytes, at, word) -> next
                gap: at + word.bytes().len()
                name: spaces_end(bytes, gap)
                if name == gap || name >= bytes.len() -> next
                first: Int.from_u8(bytes[name])
                if !is_letter_byte(first) && first != 95 && first != 36 -> next
                temporaries += 1
                at = dollar_word_end(bytes, name + 1)
                matched = true
            }
        }
        if !matched -> at += 1
    }
    Metrics{tokens: source_tokens(bytes), statements: semicolons + statement_lines, calls: calls, named_temporaries: temporaries, imports: imports}
}

// The metrics of every path the gate counts, each read once.
MetricsCache: struct {
    paths: [String]
    metrics: [Metrics]
}

cached_metrics: fn(root: String, cache: &MetricsCache, path: String) -[FS]> Metrics LedgerError! {
    if cache.paths.index_of(path) == .Val(at) -> return Ok(cache.metrics[at].copy())
    source: read_source(root, path) ?? return Err(err)
    metrics: source_metrics(source)
    cache.paths.push(path.copy())
    cache.metrics.push(metrics.copy())
    Ok(metrics)
}

source_boundary_counts: fn(root: String, cache: &MetricsCache, paths: [String], cases: [String]) -[FS]> Dyn LedgerError! {
    source_paths: sorted_unique(paths)
    tokens := 0
    statements := 0
    calls := 0
    temporaries := 0
    imports := 0
    loop path in source_paths {
        metrics: cached_metrics(root, cache, path) ?? return Err(err)
        tokens += metrics.tokens
        statements += metrics.statements
        calls += metrics.calls
        temporaries += metrics.named_temporaries
        imports += metrics.imports
    }
    counts := Dyn.object()
    counts["tokens"] = Dyn.Int(tokens)
    counts["statements"] = Dyn.Int(statements)
    counts["calls"] = Dyn.Int(calls)
    counts["namedTemporaries"] = Dyn.Int(temporaries)
    counts["imports"] = Dyn.Int(imports)
    counts["sourceFiles"] = texts(source_paths)
    counts["requiredPolicy"] = Dyn.Int(if cases.contains("expert-policy") -> 1 else -> 0)
    counts["requiredErrorHandling"] = Dyn.Int(if cases.contains("failure") -> 1 else -> 0)
    Ok(counts)
}

surface_path: fn(surfaces: [LanguageSurface], language: String) -> String Never! {
    loop surface in surfaces {
        if surface.language == language -> return surface.path.copy()
    }
    ""
}

// The `source:` evidence of a row, without the prefix.
jet_sources: fn(row: Row) -> [String] Never! {
    out := [String]{}
    loop item in row.evidence {
        if item.starts_with("source:") -> out.push(item.remove_prefix("source:"))
    }
    out
}

core_api_inventory_evidence: fn(root: String, cache: &MetricsCache, row: Row, surfaces: [LanguageSurface], cases: [String]) -[FS]> Dyn LedgerError! {
    sources: jet_sources(row)
    arms := Dyn.object()
    if sources.len() > 0 -> arms["jet"] = source_boundary_counts(root, cache, sources, cases) ?? return Err(err)
    lookups := row.evidence.copy()
    loop cell in row.competitors {
        if cell.status != "has" -> next
        path: surface_path(surfaces, cell.language)
        if path == "" -> return Err(fail("Core API workflow has no surface for {cell.language}: {row.id}"))
        arms[cell.language] = source_boundary_counts(root, cache, [String]{path}, cases) ?? return Err(err)
        lookups.push("surface:{path}")
    }
    if entries(arms).len() == 0 -> return Err(fail("Core API workflow has no source arm: {row.id}"))
    concepts := [String]{"workflow:{row.id}", "container:{row.container}"}
    if row.member != "" -> concepts.push("operation:{normalize(row.member)}")
    if row.module_name != "" -> concepts.push("module:{row.module_name}")
    if row.type_name != "" -> concepts.push("type:{row.type_name}")
    hidden := [String]{"verdict:{row.verdict}"}
    if row.jet_spelling == None -> hidden.push("jet-spelling:absent")
    if row.kind == "competitor_operation" -> hidden.push("source-line:unrecorded")
    loop cell in row.competitors {
        if cell.status != "has" -> hidden.push("competitor:{cell.language}:{cell.status}")
    }
    hidden.sort()
    counts := Dyn.object()
    counts["unit"] = jtext("lexical-token")
    counts["includes"] = texts(EVIDENCE_INCLUDES)
    counts["basis"] = jtext("frozen source boundary; fixture status remains pending-fixture")
    counts["arms"] = arms
    out := Dyn.object()
    out["rawSourceCounts"] = counts
    out["mandatoryConceptIds"] = texts(sorted_unique(concepts))
    out["hiddenFacts"] = texts(hidden)
    out["nonlocalLookups"] = texts(sorted_unique(lookups))
    Ok(out)
}

core_api_workflow_manifest: fn(root: String, rows: [Row], entries_in: [SurfaceEntry], surfaces: [LanguageSurface]) -[FS]> [Dyn] LedgerError! {
    versions := Dyn.object()
    loop entry in entries_in {
        if has_field(entry.surface, "runtime") -> versions[entry.language] = field(entry.surface, "runtime")
    }
    cache := MetricsCache{paths: [String]{}, metrics: [Metrics]{}}
    workflows := [Dyn]{}
    loop row in rows {
        competitor_sources := [String]{}
        loop cell in row.competitors {
            if cell.status == "has" -> competitor_sources.push(surface_path(surfaces, cell.language))
        }
        competitor_sources.sort()
        sources := jet_sources(row)
        sources.sort()
        cases: core_api_case_kinds(row)
        evidence: core_api_inventory_evidence(root, cache, row, surfaces, cases) ?? return Err(err)
        input := Dyn.object()
        input["kind"] = jtext("frozen-ledger-workflow")
        input["row"] = jtext(row.id)
        input["sameInputsAcrossArms"] = Dyn.Bool(true)
        input["fixtureStatus"] = jtext("not-bound")
        outcome := Dyn.object()
        outcome["workflow"] = jtext(row.workflow)
        outcome["ledgerVerdict"] = jtext(row.verdict)
        outcome["competingOperation"] = jtext(row.member)
        allowed := Dyn.object()
        allowed["jet"] = jtext("shipped Core API only")
        allowed["competitors"] = jtext("the recorded standard-library surface only")
        boundary := Dyn.object()
        boundary["jet"] = texts(sources)
        boundary["competitors"] = texts(competitor_sources)
        boundary["fixtureManifest"] = jtext(AGENT_MANIFEST_PATH)
        boundary["userAuthoredRoot"] = jtext("tests/agent_workloads/adapters")
        boundary["generatedSourceExcluded"] = Dyn.Bool(true)
        decline := Dyn.Null
        if row.declined_by != "" {
            declined := Dyn.object()
            declined["decision"] = jtext(row.declined_by)
            declined["scored"] = Dyn.Bool(true)
            declined["reason"] = jtext("A design decline remains a scored comparison result.")
            decline = declined
        }
        scope := Dyn.object()
        scope["excluded"] = Dyn.Bool(false)
        scope["decline"] = decline
        measured := Dyn.object()
        measured["status"] = jtext("pending-fixture")
        measured["rawSourceCounts"] = field(evidence, "rawSourceCounts")
        measured["mandatoryConceptIds"] = field(evidence, "mandatoryConceptIds")
        measured["hiddenFacts"] = field(evidence, "hiddenFacts")
        measured["nonlocalLookups"] = field(evidence, "nonlocalLookups")
        measured["extraConstructs"] = Dyn.Null
        measured["reasoningBurden"] = Dyn.Null
        measured["independentFixtureReview"] = Dyn.Null
        measured["jetWin"] = core_api_jet_win(row) ?? return Err(err)
        workflow := Dyn.object()
        workflow["id"] = jtext(row.id)
        workflow["task"] = jtext("core-api/{row.id}")
        workflow["input"] = input
        workflow["outcome"] = outcome
        workflow["allowedDependency"] = allowed
        workflow["toolVersions"] = versions.copy()
        workflow["sourceBoundary"] = boundary
        workflow["competingCoreWorkflow"] = jtext(row.workflow)
        workflow["cases"] = texts(cases)
        workflow["scope"] = scope
        workflow["evidence"] = measured
        workflows.push(workflow)
    }
    Ok(workflows)
}

core_api_gate: fn(root: String, rows: [Row], entries_in: [SurfaceEntry], surfaces: [LanguageSurface]) -[FS]> Dyn LedgerError! {
    workflows: core_api_workflow_manifest(root, rows, entries_in, surfaces) ?? return Err(err)
    contract: core_api_fixture_contract(root) ?? return Err(err)
    case_counts := Dyn.object()
    pending := 0
    accepted := 0
    loop workflow in workflows {
        loop kind in text_items(field(workflow, "cases")) {
            case_counts[kind] = Dyn.Int(if field(case_counts, kind) == .Int(count) -> count + 1 else -> 1)
        }
        evidence: field(workflow, "evidence")
        if !text_is(evidence, "status", "measured") -> pending += 1
        if text_is(field(evidence, "jetWin"), "status", "accepted") -> accepted += 1
    }
    languages := loop surface in surfaces -> surface.language.copy()
    languages.sort()
    review_source: read_source(root, CORE_API_REVIEW_TEST_PATH) ?? return Err(err)
    inventory := Dyn.object()
    inventory["source"] = jtext("rows")
    inventory["rowIdField"] = jtext("id")
    inventory["workflowField"] = jtext("workflow")
    inventory["manualWorkflowInventory"] = Dyn.Bool(false)
    inventory["rule"] = jtext("Every ledger row has one manifest entry; no workflow may be hidden by a fixture filter.")
    review := Dyn.object()
    review["method"] = jtext("fresh-context-release-check")
    review["command"] = jtext(CORE_API_REVIEW_COMMAND)
    review["source"] = jtext(CORE_API_REVIEW_TEST)
    review["sourceDigest"] = jtext(sha_hex(review_source))
    review["checks"] = texts(CORE_API_REVIEW_CHECKS)
    summary := Dyn.object()
    summary["workflowCount"] = Dyn.Int(workflows.len())
    summary["caseCounts"] = case_counts
    summary["pendingEvidenceCount"] = Dyn.Int(pending)
    summary["measuredEvidenceCount"] = Dyn.Int(workflows.len() - pending)
    summary["acceptedJetWinCount"] = Dyn.Int(accepted)
    summary["releaseStatus"] = jtext(if pending == 0 -> "ready" else -> "blocked-until-evidence-complete")
    summary["releaseOwner"] = jtext("#1398")
    gate := Dyn.object()
    gate["schemaVersion"] = Dyn.Int(1)
    gate["ownerCard"] = Dyn.Int(1398)
    gate["policyDocument"] = jtext(CORE_API_LAWS_PATH)
    gate["policyAnchor"] = jtext("## Competitive Core API gate")
    gate["calibrationLanguage"] = jtext("Python")
    gate["competingLanguages"] = texts(languages)
    gate["inventory"] = inventory
    gate["fixtureContract"] = contract
    gate["freshReview"] = review
    gate["workflowManifest"] = Dyn.Array(workflows)
    gate["summary"] = summary
    Ok(gate)
}

// ---- Ledger -------------------------------------------------------------------

// The Core rows generator, run by $JET, else `jet` on PATH: its stdout when
// `capture`, else inherited.
core_rows: fn(root: String, flag: String, capture: Bool) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    jet: process.env_get_or("JET", process.which("jet") ?? "jet")
    argv := [String]{jet, CORE_ROWS_GENERATOR_PATH}
    if flag != "" -> argv.push(flag.copy())
    spec := process.cmd(argv).cwd(root).stdin(.Inherit).stderr(.Inherit).output_limit(OUTPUT_LIMIT)
    spec = if capture -> spec.stdout(.Capture) else -> spec.stdout(.Inherit)
    ran: process.run_all([ProcessSpec]{spec}, 1) ?? return Err(fail("{argv.join(" ")} could not start: {err}"))
    receipt: ran[0] ?? return Err(fail("{argv.join(" ")} could not start: {err}"))
    if receipt.code != 0 || receipt.signal != None || receipt.timed_out -> return Err(fail("Command failed: {argv.join(" ")}"))
    Ok(receipt.output)
}

module_facts: fn(facts: Dyn) -> [ModuleFact] Never! {
    out := [ModuleFact]{}
    loop entry in items(facts) {
        line: int_of(field(entry, "sourceLine")) ?? -1
        out.push(ModuleFact{name: text_field(entry, "module"), members: text_items(field(entry, "members")), source_line: line})
    }
    out
}

// Field `key` of `from` onto `into`, unless `from` has no such field.
copy_field: fn(into: &Dyn, from: Dyn, key: String, as_key: String) {
    if has_field(from, key) -> into[as_key] = field(from, key)
}

// A totals count, null when the surface records no totals.
totals_count: fn(into: &Dyn, surface: Dyn, key: String, as_key: String) {
    if !has_field(surface, "totals") || field(surface, "totals") == .Null {
        into[as_key] = Dyn.Null
        return
    }
    copy_field(into, field(surface, "totals"), key, as_key)
}

// The ledger, and the board and surfaces it was built from.
Built: struct {
    ledger: Dyn
    board: Board
    surfaces: [SurfaceEntry]
    modules: [ModuleFact]
}

build_ledger: fn(root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Built LedgerError! {
    entries_in: load_surfaces(root) ?? return Err(err)
    containers: canonical_containers(entries_in)
    facts_text: core_rows(root, "--facts", true) ?? return Err(err)
    facts: json.parse(facts_text) ?? return Err(fail("{CORE_ROWS_GENERATOR_PATH} --facts printed no JSON: {err}"))
    core_rows(root, "--check", false) ?? return Err(err)
    modules: module_facts(facts)
    inventory: core_surface_inventory(root, modules) ?? return Err(err)
    bindings_source: read_source(root, CORE_CONFORMANCE_PATH) ?? return Err(err)
    bindings: fixture_bindings(bindings_source) ?? return Err(err)
    surfaces: index_surfaces(entries_in)
    names: synonyms()
    jet: build_rows(root, names, modules, inventory, surfaces, bindings) ?? return Err(err)
    rows := jet.rows.copy()
    loop row in competitor_rows(names, surfaces, jet) -> rows.push(row)
    apply_ratified_declines(rows) ?? return Err(err)
    board: tower_board(root) ?? return Err(err)
    clusters: loss_clusters(rows, board)
    uncompared: uncompared_domains(modules, containers)

    by_verdict := Dyn.object()
    loop row in rows {
        by_verdict[row.verdict] = Dyn.Int(if field(by_verdict, row.verdict) == .Int(count) -> count + 1 else -> 1)
    }

    per_language := Dyn.object()
    loop entry in entries_in {
        matched := 0
        loop row in jet.rows {
            loop cell in row.competitors {
                if cell.language == entry.language && cell.status == "has" -> matched += 1
            }
        }
        losses := 0
        loop row in rows {
            if row.verdict == "jet_loses" && row.kind == "competitor_operation" && row.languages.contains(entry.language) -> losses += 1
        }
        language := Dyn.object()
        copy_field(language, entry.surface, "sourceKind", "sourceKind")
        copy_field(language, entry.surface, "runtime", "runtime")
        language["surface"] = jtext(entry.path)
        language["recordedContainers"] = Dyn.Int(entries(field(entry.surface, "containers")).len())
        totals_count(language, entry.surface, "presentContainers", "presentContainers")
        totals_count(language, entry.surface, "operations", "recordedOperations")
        language["jetRowsMatched"] = Dyn.Int(matched)
        language["lossRows"] = Dyn.Int(losses)
        copy_field(language, entry.surface, "officialReferences", "officialReferences")
        per_language[entry.language] = language
    }

    gate: core_api_gate(root, rows, entries_in, surfaces) ?? return Err(err)
    sources: source_files(root, bindings) ?? return Err(err)
    repeats: repeated_operations(rows)
    attributed: package_attributed_containers(surfaces)

    aliases := Dyn.object()
    loop alias in CONTAINER_ALIASES -> aliases[alias.name] = jtext(alias.container)
    groups := Dyn.Array(loop group in SYNONYM_GROUPS -> texts(group))

    collections := [Dyn]{}
    method_count := 0
    loop entry in inventory.collections {
        collection := Dyn.object()
        collection["function"] = jtext(entry.function)
        collection["type"] = jtext(entry.type_name)
        collection["methods"] = texts(entry.methods)
        collection["sourceLine"] = Dyn.Int(entry.source_line)
        collections.push(collection)
        method_count += entry.methods.len()
    }
    inventory_out := Dyn.object()
    inventory_out["modules"] = facts
    inventory_out["fixedSignaturePairs"] = texts(inventory.fixed_pairs)
    inventory_out["collections"] = Dyn.Array(collections)
    inventory_out["unregisteredDispatcherRows"] = Dyn.Array([Dyn]{})

    member_count := 0
    loop entry in modules -> member_count += entry.members.len()
    fixed_only := 0
    qualified_wins := 0
    loop row in rows {
        if row.kind == "fixed_sig" -> fixed_only += 1
        if row.verdict == "jet_wins" && row.qualifies != "" -> qualified_wins += 1
    }
    needing_card := 0
    loop cluster in items(clusters) {
        if !text_is(cluster, "ownerState", "live") -> needing_card += 1
    }
    repeat_rows := 0
    loop item in repeats -> repeat_rows += item.containers.len()

    summary := Dyn.object()
    summary["languageCount"] = Dyn.Int(entries_in.len())
    summary["containerCount"] = Dyn.Int(containers.len())
    summary["moduleCount"] = Dyn.Int(modules.len())
    summary["moduleMemberCount"] = Dyn.Int(member_count)
    summary["fixedSignatureOnlyCount"] = Dyn.Int(fixed_only)
    summary["collectionFunctionCount"] = Dyn.Int(inventory.collections.len())
    summary["collectionMethodCount"] = Dyn.Int(method_count)
    summary["rowCount"] = Dyn.Int(rows.len())
    summary["jetRowCount"] = Dyn.Int(jet.rows.len())
    summary["verdicts"] = by_verdict
    summary["lossClusterCount"] = Dyn.Int(items(clusters).len())
    summary["clustersNeedingCard"] = Dyn.Int(needing_card)
    summary["uncomparedDomainCount"] = Dyn.Int(uncompared.len())
    // A win on a qualified spelling is the same capability as the member it
    // qualifies: dns_srv_port beside dns_srv. Counted so wins can be read
    // either way.
    summary["qualifiedWinCount"] = Dyn.Int(qualified_wins)
    summary["repeatedOperationCount"] = Dyn.Int(repeats.len())
    summary["repeatedOperationRowCount"] = Dyn.Int(repeat_rows)
    summary["packageAttributedContainerCount"] = Dyn.Int(items(attributed).len())

    ledger := Dyn.object()
    ledger["schemaVersion"] = Dyn.Int(2)
    ledger["title"] = jtext("Jet Core surface ledger")
    ledger["generatedOn"] = jtext(time.isoformat_date(time.today()))
    ledger["ruling"] = jtext("Owner ruling 2026-08-03: the bar is not Python; it is every language Jet competes with.")
    ledger["sourceFiles"] = sources
    ledger["canonicalContainers"] = texts(containers)
    ledger["containerAliases"] = aliases
    ledger["synonymGroups"] = groups
    ledger["competitors"] = per_language
    ledger["coreApiGate"] = gate
    ledger["inventory"] = inventory_out
    ledger["repeatedOperations"] = repeats_dyn(repeats)
    ledger["packageAttributedContainers"] = attributed
    ledger["lossClusters"] = clusters
    ledger["uncomparedDomains"] = texts(uncompared)
    ledger["rows"] = Dyn.Array(loop row in rows -> row_dyn(row))
    ledger["summary"] = summary
    Ok(Built{ledger: ledger, board: board, surfaces: entries_in, modules: modules})
}

// ---- Validation. Truthfulness is gated; coverage is printed. ---------------------

// Whether an array item is null or the empty string.
blank_item: fn(item: Dyn) -> Bool Never! {
    if item == .Null -> return true
    if item == .Text(content) -> return content == ""
    false
}

any_blank: fn(value: Dyn) -> Bool Never! {
    loop item in items(value) {
        if blank_item(item) -> return true
    }
    false
}

// A value as JavaScript string concatenation spells it.
spelled: fn(value: Dyn) -> String Never! {
    if value == {
        .Null -> "null"
        .Text(content) -> content.copy()
        .Int(number) -> "{number}"
        .Number(lexeme) -> lexeme.copy()
        .Bool(flag) -> if flag -> "true" else -> "false"
        else -> json.to_string(value) ?? ""
    }
}

is_hex64: fn(value: String) -> Bool Never! {
    bytes: value.bytes()
    if bytes.len() != 64 -> return false
    loop byte in bytes {
        code: Int.from_u8(byte)
        if !is_digit_byte(code) && (code < 97 || code > 102) -> return false
    }
    true
}

// Whether no listed field of `value` is a non-empty string.
no_benefit: fn(value: Dyn) -> Bool Never! {
    loop name in CONSTRUCT_BENEFITS {
        if non_empty(field(value, name)) -> return false
    }
    true
}

has_text: fn(value: Dyn, want: String) -> Bool Never! { text_items(value).contains(want) }

sorted_texts: fn(value: Dyn) -> [String] Never! {
    out := text_items(value)
    out.sort()
    out
}

validate_inventory_evidence: fn(workflow: Dyn) -> Int LedgerError! {
    id: text_field(workflow, "id")
    evidence: field(workflow, "evidence")
    counts: field(evidence, "rawSourceCounts")
    arms: field(counts, "arms")
    includes: field(counts, "includes")
    lacks_include := false
    loop item in EVIDENCE_INCLUDES {
        if !has_text(includes, item) -> lacks_include = true
    }
    if !is_object(counts) || !text_is(counts, "unit", "lexical-token") || !is_array(includes) || lacks_include ||
        !non_empty(field(counts, "basis")) || !is_object(arms) || entries(arms).len() == 0 {
        return Err(fail("Core API workflow evidence is missing rawSourceCounts: {id}"))
    }
    loop arm in entries(arms) {
        incomplete := !is_object(arm.value)
        loop name in EVIDENCE_REQUIRED_COUNT_FIELDS {
            if !non_negative_int(field(arm.value, name)) -> incomplete = true
        }
        if incomplete || !is_array(field(arm.value, "sourceFiles")) || items(field(arm.value, "sourceFiles")).len() == 0 {
            return Err(fail("Core API workflow has incomplete raw source counts: {id} arm {arm.key}"))
        }
    }
    loop name in ([String]{"mandatoryConceptIds", "hiddenFacts", "nonlocalLookups"}) {
        if !is_array(field(evidence, name)) || any_blank(field(evidence, name)) -> return Err(fail("Core API workflow evidence has invalid {name}: {id}"))
    }
    loop item in items(field(evidence, "mandatoryConceptIds")) {
        if !non_empty(item) -> return Err(fail("Core API workflow evidence has an empty mandatory concept id: {id}"))
    }
    Ok(0)
}

validate_jet_win: fn(workflow: Dyn) -> Int LedgerError! {
    id: text_field(workflow, "id")
    win: field(field(workflow, "evidence"), "jetWin")
    compensates: field(win, "compensates")
    boolean: if compensates == .Bool(_) -> true else -> false
    if !is_object(win) || !text_is(win, "status", "accepted") || !non_empty(field(win, "property")) ||
        !non_empty(field(win, "evidenceRef")) || !text_is(win, "kind", "machine") || !boolean {
        return Err(fail("Core API workflow lacks an accepted Jet win: {id}"))
    }
    measurement: field(win, "measurement")
    if !is_object(measurement) || !non_empty(field(measurement, "metric")) ||
        !non_empty(field(measurement, "method")) || !non_empty(field(measurement, "comparison")) ||
        field(measurement, "rowVerdict") != field(field(workflow, "outcome"), "ledgerVerdict") ||
        !int_is(measurement, "jet", 1) || !int_is(measurement, "competitor", 0) {
        return Err(fail("Core API workflow has incomplete Jet-win measurement: {id}"))
    }
    Ok(0)
}

// An extra construct with a known classification, every cost field, and a
// claimed product benefit.
complete_construct: fn(construct: Dyn) -> Bool Never! {
    if !is_object(construct) || !EVIDENCE_CLASSIFICATIONS.contains(text_field(construct, "classification")) -> return false
    loop name in ([String]{"span", "cost", "rejectedShorterForm", "lostValue", "reviewerVerdict"}) {
        if !non_empty(field(construct, name)) -> return false
    }
    !no_benefit(construct)
}

validate_measured_evidence: fn(workflow: Dyn) -> Int LedgerError! {
    id: text_field(workflow, "id")
    evidence: field(workflow, "evidence")
    if !text_is(evidence, "status", "measured") -> return Ok(0)
    counts: field(evidence, "rawSourceCounts")
    arms: field(counts, "arms")
    includes: field(counts, "includes")
    lacks_include := false
    loop item in EVIDENCE_INCLUDES {
        if !has_text(includes, item) -> lacks_include = true
    }
    if !is_object(counts) || !text_is(counts, "unit", "lexical-token") || !is_array(includes) || lacks_include ||
        !is_object(arms) || entries(arms).len() == 0 {
        return Err(fail("measured evidence has incomplete raw source counts: {id}"))
    }
    loop arm in entries(arms) {
        incomplete := !is_object(arm.value)
        loop name in EVIDENCE_REQUIRED_COUNT_FIELDS {
            if !non_negative_int(field(arm.value, name)) -> incomplete = true
        }
        if incomplete -> return Err(fail("measured evidence has incomplete raw source counts for {id} arm {arm.key}"))
    }
    loop name in ([String]{"mandatoryConceptIds", "hiddenFacts", "nonlocalLookups", "extraConstructs"}) {
        if !is_array(field(evidence, name)) || any_blank(field(evidence, name)) -> return Err(fail("measured evidence has invalid {name}: {id}"))
    }
    loop item in items(field(evidence, "mandatoryConceptIds")) {
        if !non_empty(item) -> return Err(fail("measured evidence has an empty mandatory concept id: {id}"))
    }
    burden: field(evidence, "reasoningBurden")
    status: text_field(burden, "status")
    if !truthy(burden) || (status != "better" && status != "equal" && status != "worse") || !non_empty(field(burden, "evidence")) {
        return Err(fail("measured evidence has no structured reasoning-burden record: {id}"))
    }
    review: field(evidence, "independentFixtureReview")
    has_python: has_text(field(field(workflow, "sourceBoundary"), "competitors"), PYTHON_SURFACE_PATH)
    guarantees: if has_python -> "not-emulated" else -> "not-applicable"
    if !truthy(review) || !text_is(review, "status", "accepted") || !non_empty(field(review, "reviewer")) ||
        !non_empty(field(review, "fixtureTask")) || !bool_is(review, "sameTaskInputOutcome", true) ||
        !bool_is(review, "idiomatic", true) || !bool_is(review, "minimal", true) ||
        !bool_is(review, "normalLanguageContract", true) || !text_is(review, "pythonGuarantees", guarantees) {
        return Err(fail("measured evidence lacks independent fixture acceptance: {id}"))
    }
    validate_jet_win(workflow) ?? return Err(err)
    loop construct in items(field(evidence, "extraConstructs")) {
        if !complete_construct(construct) -> return Err(fail("measured evidence has an incomplete extra-construct record: {id}"))
        if text_is(construct, "classification", "incidental-ceremony") -> return Err(fail("incidental ceremony is unexplained: {id}"))
    }
    Ok(0)
}

// One frozen receipt row as the fixture contract records it.
receipt_dyn: fn(receipt: [String: String]) -> Dyn Never! {
    entry := Dyn.object()
    entry["adapter"] = jtext(cell(receipt, "adapter"))
    entry["sourceTokens"] = number_dyn(cell(receipt, "source_tokens"))
    entry["exitCode"] = number_dyn(cell(receipt, "exit_code"))
    entry["outputStable"] = Dyn.Bool(cell(receipt, "output_stable") == "true")
    entry["scoring"] = jtext(cell(receipt, "scoring"))
    entry["toolVersion"] = jtext(cell(receipt, "tool_version"))
    entry["policyDigest"] = jtext(cell(receipt, "policy_digest"))
    entry["inputSha256"] = jtext(cell(receipt, "input_sha256"))
    entry["expectedSha256"] = jtext(cell(receipt, "expected_sha256"))
    entry["runId"] = jtext(cell(receipt, "run_id"))
    entry["machine"] = jtext(cell(receipt, "machine"))
    entry["expressibility"] = jtext(cell(receipt, "expressibility"))
    entry["finding"] = jtext(cell(receipt, "finding"))
    entry["stdoutFile"] = jtext(cell(receipt, "stdout_file"))
    entry["stdoutSha256"] = jtext(cell(receipt, "stdout_sha256"))
    entry["stderrFile"] = jtext(cell(receipt, "stderr_file"))
    entry["stderrSha256"] = jtext(cell(receipt, "stderr_sha256"))
    entry["warmStdoutSha256"] = jtext(cell(receipt, "warm_stdout_sha256"))
    entry["warmStderrSha256"] = jtext(cell(receipt, "warm_stderr_sha256"))
    entry
}

validate_core_api_fixture_execution: fn(root: String, fixture: Dyn) -[FS]> Int LedgerError! {
    execution: field(fixture, "execution")
    runner_digest: fixture_source_digest(root, AGENT_RUNNER_SOURCE_PATHS) ?? return Err(err)
    checksums: read_source(root, AGENT_CHECKSUMS_PATH) ?? return Err(err)
    domain_contract: read_source(root, AGENT_DOMAIN_CONTRACT_PATH) ?? return Err(err)
    policy: read_source(root, AGENT_WORKLOAD_POLICY_PATH) ?? return Err(err)
    if !truthy(execution) || !same_texts(field(execution, "source"), AGENT_RUNNER_SOURCE_PATHS) ||
        !text_is(execution, "test", AGENT_RUNNER) || !text_is(execution, "checksumManifest", AGENT_CHECKSUMS_PATH) ||
        !text_is(execution, "runnerDigest", runner_digest) ||
        !text_is(execution, "checksumDigest", sha_hex(checksums)) ||
        !text_is(execution, "domainContract", AGENT_DOMAIN_CONTRACT_PATH) ||
        !text_is(execution, "domainContractDigest", sha_hex(domain_contract)) ||
        !text_is(execution, "policyDigest", sha_hex(without_trailing_newlines(policy))) ||
        !same_texts(field(execution, "checks"), EXECUTION_CHECKS) ||
        !same_texts(field(execution, "runnerMarkers"), AGENT_RUNNER_MARKERS) {
        return Err(fail("Core API fixture execution contract drifted"))
    }
    runner_parts := [String]{}
    loop path in AGENT_RUNNER_SOURCE_PATHS -> runner_parts.push(read_source(root, path) ?? return Err(err))
    runner: runner_parts.join("\n")
    loop marker in AGENT_RUNNER_MARKERS {
        if !runner.contains(marker) -> return Err(fail("Core API fixture runner lost deterministic check: {marker}"))
    }

    selection: field(fixture, "selection")
    if !truthy(selection) || !text_is(selection, "source", AGENT_REVIEW_PATH) || !text_is(selection, "field", "task_id") ||
        !bool_is(selection, "oneReviewPerTask", true) || !bool_is(selection, "sameTaskInputOutcome", true) {
        return Err(fail("Core API fixture selection contract drifted"))
    }

    manifest: tsv_records(root, AGENT_MANIFEST_PATH) ?? return Err(err)
    manifest_at := [String: Int]{}
    loop (at, row) in manifest -> manifest_at[cell(row, "task_id")] = at
    tasks: items(field(fixture, "tasks"))
    task_at := [String: Int]{}
    task_names := [String]{}
    loop (at, task) in tasks {
        name: spelled(field(task, "task"))
        if task_at.get(name) != None -> return Err(fail("duplicate Core API fixture task: {name}"))
        task_at[name] = at
        task_names.push(name)
    }
    manifest_names := sorted_unique(loop row in manifest -> cell(row, "task_id"))
    task_names.sort()
    if task_names != manifest_names -> return Err(fail("Core API fixture selection does not cover the frozen manifest"))

    pinned: field(fixture, "pinnedRun")
    adapters_sorted := AGENT_BASELINE_ADAPTERS.copy()
    adapters_sorted.sort()
    pinned_tools := keys_of(field(pinned, "toolVersions"))
    pinned_tools.sort()
    if !truthy(pinned) || !non_empty(field(pinned, "runId")) || !non_empty(field(pinned, "machine")) || pinned_tools != adapters_sorted {
        return Err(fail("Core API fixture tool pin is incomplete"))
    }
    receipts: tsv_records(root, AGENT_RECEIPT_PATH) ?? return Err(err)
    seen := [String]{}
    projected := [String]{}
    current := [String: String]{}
    loop receipt in receipts {
        task_id: cell(receipt, "task_id")
        at_row: manifest_at.get(task_id) ?? return Err(fail("Core API fixture receipt names an unknown task: {task_id}"))
        row: manifest[at_row]
        adapter: cell(receipt, "adapter")
        if !AGENT_BASELINE_ADAPTERS.contains(adapter) -> return Err(fail("Core API fixture receipt names an unpinned adapter: {adapter}"))
        key: "{adapter}{nul()}{task_id}"
        if seen.contains(key) -> return Err(fail("duplicate Core API fixture receipt: {key}"))
        seen.push(key.copy())
        stored := Dyn.Null
        if task_at.get(task_id) == .Val(at_task) {
            loop candidate in items(field(tasks[at_task], "receipts")) {
                if stored == .Null && text_is(candidate, "adapter", adapter) -> stored = candidate
            }
        }
        if stored == .Null || !same(stored, receipt_dyn(receipt)) -> return Err(fail("Core API fixture receipt projection drifted: {key}"))
        projected.push(key.copy())
        if !text_is(pinned, "runId", cell(receipt, "run_id")) || !text_is(pinned, "machine", cell(receipt, "machine")) {
            return Err(fail("Core API fixture receipt run identity drifted: {key}"))
        }
        version: cell(receipt, "tool_version")
        if version.trim() == "" -> return Err(fail("Core API fixture receipt has no tool version: {key}"))
        if current.get(adapter) == .Val(known) {
            if known != version -> return Err(fail("Core API fixture tool version is not pinned: {adapter}"))
        }
        current[adapter] = version
        if !text_is(field(pinned, "toolVersions"), adapter, version) -> return Err(fail("Core API fixture receipt disagrees with pinned tool: {key}"))
        if !text_is(execution, "policyDigest", cell(receipt, "policy_digest")) || cell(receipt, "scoring") != AGENT_SCORING ||
            cell(receipt, "exit_code") != "0" || cell(receipt, "expressibility") != "supported" || cell(receipt, "finding") != "none" ||
            cell(receipt, "output_stable") != "true" {
            return Err(fail("Core API fixture receipt is not a deterministic pass: {key}"))
        }
        stem: agent_adapter_stem(task_id) ?? return Err(err)
        source: "tests/agent_workloads/adapters/{stem}.{adapter_suffix(adapter)}"
        words: fixture_source_token_count(root, source) ?? return Err(err)
        if number_dyn(cell(receipt, "source_tokens")) != Dyn.Int(words) -> return Err(fail("Core API fixture source count drifted: {key}"))
        input_digest: fixture_input_digest(root, cell(row, "input")) ?? return Err(err)
        expected_path: "{AGENT_CORPUS_ROOT}/{cell(row, "expected")}"
        expected_file: fixture_absolute_path(root, expected_path) ?? return Err(err)
        expected_digest: file_digest(expected_file) ?? return Err(err)
        if cell(receipt, "input_sha256") != input_digest || cell(receipt, "expected_sha256") != expected_digest {
            return Err(fail("Core API fixture input or outcome digest drifted: {key}"))
        }
        loop name in ([String]{"stdout_sha256", "stderr_sha256", "warm_stdout_sha256", "warm_stderr_sha256"}) {
            if !is_hex64(cell(receipt, name)) -> return Err(fail("Core API fixture receipt has invalid {name}: {key}"))
        }
        if !safe_fixture_relative_path(cell(receipt, "stdout_file")) || !safe_fixture_relative_path(cell(receipt, "stderr_file")) {
            return Err(fail("Core API fixture receipt artifact path escaped its root: {key}"))
        }
        stdout_path: fixture_absolute_path(root, "{AGENT_CORPUS_ROOT}/baselines/{cell(receipt, "stdout_file")}") ?? return Err(err)
        stdout: files.read_bytes(stdout_path) ?? return Err(fail("cannot read {stdout_path}: {err}"))
        expected: files.read_bytes(expected_file) ?? return Err(fail("cannot read {expected_file}: {err}"))
        stdout_digest: crypto.sha256(stdout).hex()
        stderr_digest: fixture_artifact_digest(root, cell(receipt, "stderr_file")) ?? return Err(err)
        if stdout_digest != cell(receipt, "stdout_sha256") || cell(receipt, "warm_stdout_sha256") != cell(receipt, "stdout_sha256") ||
            stdout_digest != cell(receipt, "expected_sha256") || stdout != expected || stderr_digest != cell(receipt, "stderr_sha256") {
            return Err(fail("Core API fixture output artifact drifted: {key}"))
        }
    }
    current_tools := [String]{}
    loop name in AGENT_BASELINE_ADAPTERS {
        if current.get(name) != None -> current_tools.push(name.copy())
    }
    current_tools.sort()
    seen_sorted := seen.copy()
    seen_sorted.sort()
    projected.sort()
    if seen.len() != manifest.len() * AGENT_BASELINE_ADAPTERS.len() || current_tools != adapters_sorted || projected != seen_sorted {
        return Err(fail("Core API fixture receipt coverage drifted"))
    }

    loop row in manifest {
        task_id: cell(row, "task_id")
        stem: agent_adapter_stem(task_id) ?? return Err(err)
        expected_sources := [String]{}
        loop adapter in cell(row, "adapters").split(",") {
            if adapter != "" -> expected_sources.push("tests/agent_workloads/adapters/{stem}.{adapter_suffix(adapter)}")
        }
        input_digest: fixture_input_digest(root, cell(row, "input")) ?? return Err(err)
        expected_file: fixture_absolute_path(root, "{AGENT_CORPUS_ROOT}/{cell(row, "expected")}") ?? return Err(err)
        expected_digest: file_digest(expected_file) ?? return Err(err)
        at_task: task_at.get(task_id) ?? return Err(fail("Core API fixture selection is stale: {task_id}"))
        task: tasks[at_task]
        source_digest: fixture_source_digest(root, expected_sources) ?? return Err(err)
        if !text_is(task, "domain", cell(row, "domain")) || !text_is(task, "case", cell(row, "case")) ||
            !text_is(task, "input", cell(row, "input")) || !text_is(task, "expected", cell(row, "expected")) ||
            !text_is(task, "outcome", cell(row, "declared_outcome")) ||
            !text_is(task, "inputDigest", input_digest) || !text_is(task, "expectedDigest", expected_digest) ||
            !same_texts(field(field(task, "sourceBoundary"), "userAuthored"), expected_sources) ||
            !text_is(task, "sourceDigest", source_digest) {
            return Err(fail("Core API fixture selection is stale: {task_id}"))
        }
    }
    Ok(0)
}

// Whether a line, after leading whitespace, reads `label` then a non-space
// character and at least one more: /^\s*label \S.+/m.
labelled_line: fn(line: String, label: String) -> Bool Never! {
    rest: line.trim_start().removesuffix("\r")
    if !rest.starts_with(label) -> return false
    after: byte_tail(rest, byte_len(label))
    after.chars().len() >= 2 && after.trim_start() == after
}

// /^Error \[jet\.[A-Z]\w+\]: \S.+/m on one line.
error_line: fn(line: String) -> Bool Never! {
    if !line.starts_with("Error [jet.") -> return false
    bytes: line.removesuffix("\r").bytes()
    at := 11
    if at >= bytes.len() -> return false
    first: Int.from_u8(bytes[at])
    if first < 65 || first > 90 -> return false
    at += 1
    end: word_end(bytes, at)
    if end == at -> return false
    labelled_line(byte_tail(String.from_bytes_lossy(bytes), end), "]: ")
}

// The blank-line-separated entries of a diagnostics stream.
diagnostic_entries: fn(source: String) -> [[String]] Never! {
    out := [[String]]{}
    current := [String]{}
    loop line in source.split("\n") {
        if line.trim() == "" {
            if current.len() > 0 -> out.push(current.copy())
            current = [String]{}
            next
        }
        current.push(line.copy())
    }
    if current.len() > 0 -> out.push(current)
    out
}

validate_core_api_syntax_coverage: fn(root: String) -[FS]> Int LedgerError! {
    syntax: read_source(root, SYNTAX_REFERENCE_PATH) ?? return Err(err)
    loop marker in CORE_API_SYNTAX_MARKERS {
        if !syntax.contains(marker) -> return Err(fail("syntax reference does not teach Core gate form: {marker}"))
    }
    editor_parts := [String]{}
    loop path in EDITOR_COVERAGE_PATHS -> editor_parts.push(read_source(root, path) ?? return Err(err))
    editor: editor_parts.join("\n")
    loop marker in ([String]{
        "lsp_completion_returns_items",
        "lsp_signature_help_returns_active_parameter",
        "rest: ...String",
        "lsp_hover_returns_signature",
        "connect: fn(host: String, /",
    }) {
        if !editor.contains(marker) -> return Err(fail("editor coverage does not teach Core gate form: {marker}"))
    }
    hover: read_source(root, "tests/lsp/02_hover.json") ?? return Err(err)
    if hover.contains("=>") || !hover.contains("-[IO]>") -> return Err(fail("hover fixture teaches a retired arrow or misses `-[IO]>`"))
    loop pair in ([(path: String, name: String)]{
        (path: "tests/ui/variadic_not_last.stderr", name: "jet.MisplacedVariadicParameter"),
        (path: "tests/ui/spread_bad_call.stderr", name: "jet.SpreadWithoutVariadic"),
        (path: "tests/ui/yield_type_mismatch.stderr", name: "jet.YieldTypeMismatch"),
        (path: "tests/ui/user_policy_bad_args.stderr", name: "jet.MissingArgument"),
    }) {
        diagnostics: read_source(root, pair.path) ?? return Err(err)
        complete := false
        found := false
        loop entry in diagnostic_entries(diagnostics) {
            if found || !entry[0].starts_with("Error [{pair.name}]: ") -> next
            found = true
            has_error := false
            has_why := false
            has_fix := false
            loop line in entry {
                if error_line(line) -> has_error = true
                if labelled_line(line, "Why: ") -> has_why = true
                if labelled_line(line, "Fix: ") -> has_fix = true
            }
            complete = has_error && has_why && has_fix
        }
        if !complete -> return Err(fail("diagnostic coverage lacks a complete registered report: {pair.path} {pair.name}"))
    }
    Ok(0)
}

validate_fresh_review: fn(root: String, ledger: Dyn, workflows: [Dyn]) -[FS]> Int LedgerError! {
    gate: field(ledger, "coreApiGate")
    review: field(gate, "freshReview")
    loop name in text_items(field(review, "checks")) {
        if name == "workflow-closure" {
            row_ids := [String: Bool]{}
            loop row in items(field(ledger, "rows")) -> row_ids[text_field(row, "id")] = true
            workflow_ids := [String: Bool]{}
            loop workflow in workflows {
                id: text_field(workflow, "id")
                if !is_object(workflow) || !non_empty(field(workflow, "id")) || workflow_ids.get(id) != None ||
                    row_ids.get(id) == None || !text_is(workflow, "task", "core-api/{id}") ||
                    !truthy(field(workflow, "input")) || !text_is(field(workflow, "input"), "row", id) {
                    return Err(fail("fresh Core API review found workflow-closure drift"))
                }
                workflow_ids[id] = true
            }
            if workflow_ids.len() != row_ids.len() -> return Err(fail("fresh Core API review found workflow-closure drift"))
            next
        }
        if name == "construct-classifications" {
            loop workflow in workflows {
                evidence: field(workflow, "evidence")
                if !text_is(evidence, "status", "measured") -> next
                loop construct in items(field(evidence, "extraConstructs")) {
                    if !is_object(construct) || !EVIDENCE_CLASSIFICATIONS.contains(text_field(construct, "classification")) ||
                        text_is(construct, "classification", "incidental-ceremony") || no_benefit(construct) {
                        return Err(fail("fresh Core API review found construct-classification drift: {text_field(workflow, "id")}"))
                    }
                }
            }
            next
        }
        if name == "reasoning-evidence" {
            loop workflow in workflows {
                evidence: field(workflow, "evidence")
                if !text_is(evidence, "status", "measured") -> next
                burden: field(evidence, "reasoningBurden")
                status: text_field(burden, "status")
                if !truthy(burden) || (status != "better" && status != "equal" && status != "worse") ||
                    !non_empty(field(burden, "evidence")) ||
                    (status == "worse" && !bool_is(field(evidence, "jetWin"), "compensates", true)) {
                    return Err(fail("fresh Core API review found reasoning-evidence drift: {text_field(workflow, "id")}"))
                }
            }
            next
        }
        if name == "syntax-coverage" {
            validate_core_api_syntax_coverage(root) ?? return Err(err)
            next
        }
        if name == "fixture-selection" {
            validate_core_api_fixture_execution(root, field(gate, "fixtureContract")) ?? return Err(err)
            next
        }
        return Err(fail("fresh Core API review names an unknown check: {name}"))
    }
    Ok(0)
}

// Whether a policy line opens with `heading` and a word boundary.
heading_count: fn(policy: String, heading: String) -> Int Never! {
    count := 0
    loop line in policy.split("\n") {
        if !line.starts_with(heading) -> next
        rest: byte_tail(line, byte_len(heading))
        if rest == "" || !is_word_code(Int.from_u8(rest.bytes()[0])) -> count += 1
    }
    count
}

validate_core_api_gate: fn(root: String, ledger: Dyn) -[FS]> Int LedgerError! {
    gate: field(ledger, "coreApiGate")
    if !truthy(gate) || !int_is(gate, "schemaVersion", 1) -> return Err(fail("missing Core API gate schema"))
    if !int_is(gate, "ownerCard", 1398) || !text_is(gate, "policyDocument", CORE_API_LAWS_PATH) ||
        !text_is(gate, "policyAnchor", "## Competitive Core API gate") {
        return Err(fail("Core API gate is not attached to the existing Core API rubric"))
    }
    if !text_is(field(gate, "inventory"), "source", "rows") || !bool_is(field(gate, "inventory"), "manualWorkflowInventory", false) {
        return Err(fail("Core API gate must consume ledger rows as its only workflow inventory"))
    }
    policy: read_source(root, CORE_API_LAWS_PATH) ?? return Err(err)
    if heading_count(policy, "## Competitive Core API gate") != 1 ||
        !policy.contains("Python is the calibration arm") ||
        !policy.contains("Raw counts are evidence, not a universal ratio") ||
        !policy.contains("Incidental ceremony fails") ||
        !policy.contains("coreApiGate.workflowManifest") {
        return Err(fail("Core API rubric is missing its single Python superiority gate"))
    }
    validate_core_api_syntax_coverage(root) ?? return Err(err)
    rows: items(field(ledger, "rows"))
    row_at := [String: Int]{}
    loop (at, row) in rows -> row_at[text_field(row, "id")] = at
    workflows: items(field(gate, "workflowManifest"))
    if !is_array(field(gate, "workflowManifest")) || workflows.len() != row_at.len() {
        return Err(fail("Core API gate workflow manifest does not cover every ledger row"))
    }
    workflow_ids := [String: Bool]{}
    case_counts := Dyn.object()
    loop workflow in workflows {
        id: text_field(workflow, "id")
        if workflow_ids.get(id) != None -> return Err(fail("duplicate Core API workflow task: {id}"))
        workflow_ids[id] = true
        at_row: row_at.get(id) ?? return Err(fail("Core API workflow task names a row outside the ledger: {id}"))
        loop name in ([String]{"task", "input", "outcome", "allowedDependency", "toolVersions", "sourceBoundary", "competingCoreWorkflow", "cases", "scope", "evidence"}) {
            if missing(workflow, name) -> return Err(fail("Core API workflow is missing {name}: {id}"))
        }
        input: field(workflow, "input")
        status: text_field(input, "fixtureStatus")
        if !truthy(field(input, "sameInputsAcrossArms")) || (status != "not-bound" && status != "fresh" && status != "stale" && status != "accepted") {
            return Err(fail("Core API workflow input is not frozen before comparison: {id}"))
        }
        boundary: field(workflow, "sourceBoundary")
        if !truthy(field(workflow, "competingCoreWorkflow")) || !truthy(field(boundary, "fixtureManifest")) ||
            !truthy(field(boundary, "userAuthoredRoot")) || !is_array(field(boundary, "jet")) ||
            !is_array(field(boundary, "competitors")) || !bool_is(boundary, "generatedSourceExcluded", true) {
            return Err(fail("Core API workflow lacks a source boundary: {id}"))
        }
        row: rows[at_row]
        allowed: entries(field(workflow, "allowedDependency"))
        versions: entries(field(workflow, "toolVersions"))
        blank_dependency := false
        loop entry in allowed {
            if !non_empty(entry.value) -> blank_dependency = true
        }
        blank_version := false
        loop entry in versions {
            if !non_empty(entry.value) -> blank_version = true
        }
        if !text_is(workflow, "task", "core-api/{id}") || !text_is(input, "row", id) ||
            field(workflow, "competingCoreWorkflow") != field(row, "workflow") ||
            !truthy(field(workflow, "allowedDependency")) || allowed.len() == 0 || blank_dependency ||
            versions.len() == 0 || blank_version {
            return Err(fail("Core API workflow frozen task record drifted: {id}"))
        }
        cases: field(workflow, "cases")
        kinds: text_items(cases)
        unknown_case := kinds.len() != items(cases).len()
        loop kind in kinds {
            if !CASE_KINDS.contains(kind) -> unknown_case = true
        }
        if !is_array(cases) || kinds.len() == 0 || unknown_case || first_seen(kinds).len() != kinds.len() {
            return Err(fail("Core API workflow has invalid case coverage: {id}"))
        }
        scope: field(workflow, "scope")
        excluded: truthy(field(scope, "excluded"))
        decline: field(scope, "decline")
        if excluded && !truthy(decline) -> return Err(fail("Core API workflow is hidden without a ratified scope decision: {id}"))
        if excluded && (!text_is(row, "verdict", "declined") || field(decline, "decision") != field(row, "declinedBy")) {
            return Err(fail("Core API workflow is hidden without a matching ratified scope decision: {id}"))
        }
        if !excluded && truthy(decline) && !truthy(field(decline, "scored")) -> return Err(fail("Core API design decline is not scored: {id}"))
        loop kind in kinds {
            case_counts[kind] = Dyn.Int(if field(case_counts, kind) == .Int(count) -> count + 1 else -> 1)
        }
        evidence: field(workflow, "evidence")
        loop name in ([String]{"rawSourceCounts", "mandatoryConceptIds", "hiddenFacts", "nonlocalLookups", "extraConstructs", "reasoningBurden", "independentFixtureReview", "jetWin"}) {
            if !has_field(evidence, name) -> return Err(fail("Core API workflow evidence is missing {name}: {id}"))
        }
        evidence_status: text_field(evidence, "status")
        if evidence_status != "pending-fixture" && evidence_status != "measured" -> return Err(fail("invalid Core API workflow evidence status: {id}"))
        if evidence_status == "pending-fixture" {
            validate_inventory_evidence(workflow) ?? return Err(err)
            validate_jet_win(workflow) ?? return Err(err)
        } else {
            validate_measured_evidence(workflow) ?? return Err(err)
        }
    }
    if workflow_ids.len() != row_at.len() -> return Err(fail("Core API workflow manifest row coverage drifted"))
    loop kind in CASE_KINDS {
        if field(case_counts, kind) == .Null -> return Err(fail("Core API workflow inventory has no {kind} cases"))
    }
    summary: field(gate, "summary")
    if !same(field(summary, "caseCounts"), case_counts) -> return Err(fail("Core API workflow case counts drifted"))
    pending := 0
    wins := 0
    loop workflow in workflows {
        evidence: field(workflow, "evidence")
        if !text_is(evidence, "status", "measured") -> pending += 1
        if text_is(field(evidence, "jetWin"), "status", "accepted") -> wins += 1
    }
    if !int_is(summary, "pendingEvidenceCount", pending) || !int_is(summary, "measuredEvidenceCount", workflows.len() - pending) {
        return Err(fail("Core API workflow evidence summary drifted"))
    }
    if !int_is(summary, "acceptedJetWinCount", wins) || wins != workflows.len() {
        return Err(fail("Core API workflow evidence is missing an accepted Jet win"))
    }
    fixture: field(gate, "fixtureContract")
    fresh: field(gate, "freshReview")
    review_source: read_source(root, CORE_API_REVIEW_TEST_PATH) ?? return Err(err)
    if !truthy(fresh) || !text_is(fresh, "method", "fresh-context-release-check") ||
        !text_is(fresh, "command", CORE_API_REVIEW_COMMAND) ||
        !text_is(fresh, "source", CORE_API_REVIEW_TEST) ||
        !text_is(fresh, "sourceDigest", sha_hex(review_source)) ||
        !same_texts(field(fresh, "checks"), CORE_API_REVIEW_CHECKS) {
        return Err(fail("Core API gate is missing its fresh-review contract"))
    }
    if !truthy(fixture) || !text_is(fixture, "manifest", AGENT_MANIFEST_PATH) || !text_is(fixture, "receipt", AGENT_RECEIPT_PATH) ||
        !text_is(fixture, "review", AGENT_REVIEW_PATH) ||
        !text_is(fixture, "runner", AGENT_RUNNER) || !text_is(fixture, "scoring", AGENT_SCORING) {
        return Err(fail("Core API gate does not reuse the frozen agent corpus contract"))
    }
    tasks: items(field(fixture, "tasks"))
    if !is_array(field(fixture, "tasks")) || tasks.len() == 0 -> return Err(fail("Core API gate has no frozen fixture tasks"))
    task_ids := [String: Bool]{}
    loop task in tasks {
        name: spelled(field(task, "task"))
        if task_ids.get(name) != None -> return Err(fail("duplicate Core API fixture task: {name}"))
        task_ids[name] = true
        loop key in ([String]{"input", "outcome", "allowedDependency", "toolVersions", "sourceBoundary", "sourceDigest", "inputDigest", "expectedDigest", "adapters", "scoring", "runner", "receipts", "independentFixtureReview"}) {
            if missing(task, key) -> return Err(fail("Core API fixture is missing {key}: {name}"))
        }
        boundary: field(task, "sourceBoundary")
        if items(field(boundary, "userAuthored")).len() == 0 || items(field(boundary, "generatedAndReferenceExcluded")).len() == 0 {
            return Err(fail("Core API fixture source boundary is incomplete: {name}"))
        }
        adapters: text_items(field(task, "adapters"))
        competitor_adapters := [String]{}
        loop adapter in adapters {
            if adapter != "jet" -> competitor_adapters.push(adapter.copy())
        }
        competitor_adapters.sort()
        receipts: items(field(task, "receipts"))
        receipt_adapters := loop receipt in receipts -> text_field(receipt, "adapter")
        receipt_adapters.sort()
        source_digest: fixture_source_digest(root, text_items(field(boundary, "userAuthored"))) ?? return Err(err)
        bad_receipt := false
        loop receipt in receipts {
            if !adapters.contains(text_field(receipt, "adapter")) || !non_empty(field(receipt, "toolVersion")) ||
                !non_negative_int(field(receipt, "sourceTokens")) || !int_is(receipt, "exitCode", 0) ||
                !bool_is(receipt, "outputStable", true) || field(receipt, "scoring") != field(fixture, "scoring") ||
                !non_empty(field(receipt, "policyDigest")) || field(receipt, "inputSha256") != field(task, "inputDigest") ||
                field(receipt, "expectedSha256") != field(task, "expectedDigest") {
                bad_receipt = true
            }
        }
        review: field(task, "independentFixtureReview")
        if field(task, "scoring") != field(fixture, "runner") || field(task, "runner") != field(fixture, "runner") ||
            receipt_adapters != competitor_adapters || !text_is(task, "sourceDigest", source_digest) ||
            !non_empty(field(task, "inputDigest")) || !non_empty(field(task, "expectedDigest")) || bad_receipt ||
            !accepted_fixture_review(review, name, field(task, "sourceDigest"), field(task, "inputDigest"), field(task, "expectedDigest"), adapters.contains("python")) {
            if truthy(review) && !text_is(review, "status", "accepted") -> return Err(fail("Core API fixture review is not accepted: {name}"))
            return Err(fail("Core API fixture lacks accepted independent review: {name}"))
        }
        loop receipt in receipts {
            adapter: text_field(receipt, "adapter")
            if !adapters.contains(adapter) || adapter == "jet" -> return Err(fail("Core API fixture does not name its existing runner: {name}"))
        }
    }
    validate_core_api_fixture_execution(root, fixture) ?? return Err(err)
    validate_fresh_review(root, ledger, workflows) ?? return Err(err)
    Ok(0)
}

validate_surfaces: fn(ledger: Dyn, surfaces: [SurfaceEntry]) -> Int LedgerError! {
    containers: canonical_containers(surfaces)
    if surfaces.len() < 11 -> return Err(fail("the owner named eleven languages; only {surfaces.len()} surfaces are recorded"))
    loop entry in surfaces {
        records: entries(field(entry.surface, "containers"))
        recorded := [String: Bool]{}
        loop record in records -> recorded[record.key] = true
        missing_names := [String]{}
        loop name in containers {
            if recorded.get(name) == None -> missing_names.push(name.copy())
        }
        if missing_names.len() > 0 -> return Err(fail("hidden exclusion: {entry.language} records no verdict for {missing_names.join(", ")}"))
        loop record in records {
            present: truthy(field(record.value, "present"))
            if !present && !truthy(field(record.value, "reason")) -> return Err(fail("hidden exclusion: {entry.language} marks {record.key} absent with no reason"))
            if present && items(field(record.value, "operations")).len() == 0 -> return Err(fail("empty recorded container: {entry.language} {record.key}"))
        }
        if !truthy(field(entry.surface, "sourceKind")) || !truthy(field(entry.surface, "scopeRule")) ||
            items(field(entry.surface, "officialReferences")).len() == 0 {
            return Err(fail("surface without recorded provenance: {entry.language}"))
        }
        // One source feeds one container. This was asserted in prose and never
        // enforced, and R's base package really did feed core.math and
        // core.math.random, so one function minted two gaps.
        owner := [String: String]{}
        loop record in records {
            if !truthy(field(record.value, "present")) -> next
            loop key in ([String]{"packages", "files", "types", "manualPages", "modules", "pythonSources"}) {
                loop source in items(field(record.value, key)) {
                    name: spelled(source)
                    if owner.get(name) == .Val(seen) {
                        if seen != record.key -> return Err(fail("one source feeds two containers in {entry.language}: {name} is claimed by {seen} and {record.key}"))
                    }
                    owner[name] = record.key.copy()
                }
            }
        }
    }
    if !same_texts(field(ledger, "canonicalContainers"), containers) -> return Err(fail("ledger container set drifted from the recorded surfaces"))
    Ok(0)
}

// A capability name that recurs across domains must be classified, because the
// two answers score differently and neither is a safe default. This fails on a
// recurring name that is in neither table, so a ledger refresh cannot introduce
// an unreviewed repeat and have it quietly keep per-domain scoring.
validate_repeated_names: fn(rows: [Dyn], pooled: [String], distinct: [String]) -> Int LedgerError! {
    keys := [String]{}
    at_key := [String: Int]{}
    witnesses := [[String]]{}
    domains := [[String]]{}
    loop row in rows {
        source: field(row, "source")
        if !text_is(source, "kind", "competitor_operation") -> next
        key: spelled(field(source, "member"))
        at := at_key.get(key) ?? -1
        if at < 0 {
            at = keys.len()
            at_key[key] = at
            keys.push(key.copy())
            witnesses.push([String]{})
            domains.push([String]{})
        }
        parts: text_field(row, "id").split(".").to_list()
        domain: if parts.len() > 1 -> parts[1].copy() else -> "undefined"
        if !domains[at].contains(domain) -> domains[at].push(domain)
        loop entry in entries(field(row, "competitors")) {
            if text_is(entry.value, "status", "has") && !witnesses[at].contains(entry.key) -> witnesses[at].push(entry.key.copy())
        }
    }
    unclassified := [String]{}
    loop (at, key) in keys {
        // Recurring means it appears in more than one domain. A name confined to
        // one domain is already scored on all the evidence there is.
        if domains[at].len() < 2 || witnesses[at].len() < 2 -> next
        if pooled.contains(key) || distinct.contains(key) -> next
        unclassified.push(key.copy())
    }
    unclassified.sort()
    if unclassified.len() > 0 -> return Err(fail("unclassified repeated operation name: {unclassified.join(", ")} — add each to CROSS_DOMAIN_POOLED or CROSS_DOMAIN_DISTINCT"))
    Ok(0)
}

// Every operation each recorded present container holds, keyed
// language, container and operation.
surface_operations: fn(surfaces: [SurfaceEntry]) -> [String: Bool] Never! {
    known := [String: Bool]{}
    loop entry in surfaces {
        loop record in entries(field(entry.surface, "containers")) {
            if !truthy(field(record.value, "present")) -> next
            loop operation in text_items(field(record.value, "operations")) -> known["{entry.language}\t{record.key}\t{operation}"] = true
        }
    }
    known
}

first_truthy_text: fn(source: Dyn, names: [String]) -> String Never! {
    loop name in names {
        if truthy(field(source, name)) -> return spelled(field(source, name))
    }
    "undefined"
}

validate_rows: fn(ledger: Dyn, surfaces: [SurfaceEntry]) -> Int LedgerError! {
    rows: items(field(ledger, "rows"))
    validate_repeated_names(rows, CROSS_DOMAIN_POOLED, CROSS_DOMAIN_DISTINCT) ?? return Err(err)
    known: surface_operations(surfaces)
    languages := loop entry in surfaces -> entry.language.copy()
    ids := [String: Bool]{}
    source_keys := [String: Bool]{}
    verdicts: [String]{"equal", "jet_wins", "jet_loses", "single_witness", "not_compared", "declined", "type_item"}
    loop row in rows {
        id: text_field(row, "id")
        if ids.get(id) != None -> return Err(fail("duplicate row id: {id}"))
        ids[id] = true
        source: field(row, "source")
        source_key: "{text_field(source, "kind")}:{first_truthy_text(source, [String]{"module", "type", "container"})}:{spelled(field(source, "member"))}"
        if source_keys.get(source_key) != None -> return Err(fail("duplicate source row: {source_key}"))
        source_keys[source_key] = true
        if !truthy(field(row, "workflow")) || !truthy(field(row, "verdict")) || !truthy(field(row, "container")) -> return Err(fail("incomplete row: {id}"))
        verdict: text_field(row, "verdict")
        if !verdicts.contains(verdict) -> return Err(fail("invalid verdict in {id}: {spelled(field(row, "verdict"))}"))
        if verdict != "jet_loses" && verdict != "single_witness" && !truthy(field(row, "jetSpelling")) -> return Err(fail("row without a Jet spelling: {id}"))
        container: text_field(row, "container")
        any_has := false
        // A row may not assert an operation the recorded surface does not have.
        loop entry in entries(field(row, "competitors")) {
            if !text_is(entry.value, "status", "has") -> next
            any_has = true
            // A cell may cite a sibling container in the same matching domain,
            // but it must name which one, and the operation must really be there.
            where: if truthy(field(entry.value, "foundIn")) -> text_field(entry.value, "foundIn") else -> container.copy()
            operation: spelled(field(entry.value, "operation"))
            if where != container && domain_for(where) != domain_for(container) {
                return Err(fail("competitor claim reaches outside its domain in {id}: {entry.key} {operation} from {where}"))
            }
            if !languages.contains(entry.key) || known.get("{entry.key}\t{where}\t{operation}") == None {
                return Err(fail("unverified competitor claim in {id}: {entry.key} {operation}"))
            }
        }
        if verdict == "type_item" && !is_type_item(text_field(source, "member")) -> return Err(fail("row scored as a type but named like an operation: {id}"))
        if verdict == "equal" && !any_has -> return Err(fail("equal verdict with no matching competitor operation: {id}"))
    }
    Ok(0)
}

// A cluster may say it has no card. It may not name one that is closed or
// absent, which is how a gap silently reads as owned after its card is done.
validate_owners: fn(ledger: Dyn, board: Board) -> Int LedgerError! {
    loop cluster in items(field(ledger, "lossClusters")) {
        container: spelled(field(cluster, "container"))
        owner: if has_field(cluster, "ownerCard") -> spelled(field(cluster, "ownerCard")) else -> "undefined"
        number: int_of(field(cluster, "ownerCard")) ?? -1
        card: if board.readable && number >= 0 -> board_card(board, number) else -> None
        state: text_field(cluster, "ownerState")
        if state == "live" {
            if !board.readable -> return Err(fail("cluster claims a live owner but no board is readable: {container}"))
            if card == .Val(found) {
                if found.phase == "done" -> return Err(fail("stale owner: {container} names closed card #{owner}"))
            } else {
                return Err(fail("stale owner: {container} names missing card #{owner}"))
            }
        }
        // A closed cluster is a dead owner holding real losses. It was reported
        // and never checked, so the card could be reopened, renumbered or deleted
        // and the ledger would keep pointing at it.
        if state == "closed" {
            if !board.readable -> return Err(fail("cluster names a closed owner but no board is readable: {container}"))
            if card == .Val(found) {
                if found.phase != "done" -> return Err(fail("stale owner: {container} reports card #{owner} as closed, but the board has it in {found.phase}"))
            } else {
                return Err(fail("stale owner: {container} reports closed card #{owner}, which is not on the board"))
            }
            if int_is(cluster, "lossCount", 0) -> return Err(fail("cluster {container} reports a closed owner with no losses"))
        }
        if state == "needs_card" && (!has_field(cluster, "ownerCard") || field(cluster, "ownerCard") != .Null) -> return Err(fail("cluster {container} both names card #{owner} and claims to need one"))
    }
    loop row in items(field(ledger, "rows")) {
        if !text_is(row, "verdict", "declined") -> next
        id: text_field(row, "id")
        if !truthy(field(row, "declinedBy")) -> return Err(fail("declined row without a decision id: {id}"))
        declined_by: spelled(field(row, "declinedBy"))
        status := ""
        known := false
        if board.readable {
            loop decision in board.decisions {
                if !known && decision.id == declined_by {
                    known = true
                    status = decision.status.copy()
                }
            }
        }
        if !known -> return Err(fail("declined row names an unknown decision: {declined_by}"))
        if status != "ratified" -> return Err(fail("unratified scope exclusion in {id}: {declined_by}"))
    }
    Ok(0)
}

validate_coverage: fn(ledger: Dyn, modules: [ModuleFact]) -> Int LedgerError! {
    expected: uncompared_domains(modules, text_items(field(ledger, "canonicalContainers")))
    listed: field(ledger, "uncomparedDomains")
    if !same_texts(listed, expected) {
        present: text_items(listed)
        hidden := [String]{}
        loop name in expected {
            if !present.contains(name) -> hidden.push(name.copy())
        }
        shown: if hidden.len() > 0 -> hidden.join(", ") else -> "nothing, but the list has drifted"
        return Err(fail("uncompared Core domains are not fully listed; the ledger hides {shown}"))
    }
    Ok(0)
}

// Every gate --check runs, in its order.
validate_ledger: fn(root: String, built: Built) -[FS]> Int LedgerError! {
    validate_surfaces(built.ledger, built.surfaces) ?? return Err(err)
    validate_rows(built.ledger, built.surfaces) ?? return Err(err)
    validate_owners(built.ledger, built.board) ?? return Err(err)
    validate_coverage(built.ledger, built.modules) ?? return Err(err)
    validate_core_api_gate(root, built.ledger) ?? return Err(err)
    Ok(0)
}

without_generated_on: fn(ledger: Dyn) -> Dyn Never! {
    kept := [(key: String, value: Dyn)]{}
    loop entry in entries(ledger) {
        if entry.key != "generatedOn" -> kept.push((key: entry.key.copy(), value: entry.value.copy()))
    }
    Dyn.Object(kept)
}

compare_ledger: fn(stored: Dyn, expected: Dyn) -> Int LedgerError! {
    if !same(without_generated_on(stored), without_generated_on(expected)) {
        return Err(fail("core surface ledger drifted; run --write only after reviewing source and policy"))
    }
    Ok(0)
}

// ---- Modes ----------------------------------------------------------------------

verdict_count: fn(verdicts: Dyn, name: String) -> Int Never! {
    if field(verdicts, name) == .Int(number) -> return number
    0
}

check_mode: fn(root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    built: build_ledger(root) ?? return Err(err)
    validate_ledger(root, built) ?? return Err(err)
    ledger: built.ledger
    summary: field(ledger, "summary")
    verdicts: field(summary, "verdicts")
    gate: field(ledger, "coreApiGate")
    gate_summary: field(gate, "summary")
    review: field(gate, "freshReview")
    wins: verdict_count(verdicts, "jet_wins")
    equal: verdict_count(verdicts, "equal")
    loses: verdict_count(verdicts, "jet_loses")
    single: verdict_count(verdicts, "single_witness")
    types: verdict_count(verdicts, "type_item")
    uncompared: verdict_count(verdicts, "not_compared")
    lines := [String]{}
    lines.push("core surface ledger: source-derived, verified against {spelled(field(summary, "languageCount"))} recorded competitor surfaces, and unique")
    lines.push("rows={spelled(field(summary, "rowCount"))} wins={wins} equal={equal} loses={loses} single-witness={single} types={types} not-compared={uncompared} clusters-needing-a-card={spelled(field(summary, "clustersNeedingCard"))}")
    lines.push("core API gate: {spelled(field(gate_summary, "releaseStatus"))} workflows={spelled(field(gate_summary, "workflowCount"))} pending-evidence={spelled(field(gate_summary, "pendingEvidenceCount"))} accepted-jet-wins={spelled(field(gate_summary, "acceptedJetWinCount"))}")
    lines.push("core API fixtures: independent acceptance verified tasks={items(field(field(gate, "fixtureContract"), "tasks")).len()}")
    lines.push("core API fixture execution: deterministic; pinned-tools; cold-warm; exact-stdout; input-unchanged; scratch-closed")
    lines.push("core API fresh review: {spelled(field(review, "method"))}; checks={text_items(field(review, "checks")).join(",")}")
    Ok(lines.join("\n"))
}

write_mode: fn(root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    core_rows(root, "", false) ?? return Err(err)
    built: build_ledger(root) ?? return Err(err)
    path: "{root}/{RUNTIME_LEDGER_PATH}"
    files.create_dir_all(files.dirname(path)) ?? return Err(fail("cannot create {files.dirname(path)}: {err}"))
    rendered: json.to_string_pretty(built.ledger) ?? return Err(fail("the ledger cannot be encoded: {err}"))
    files.write(path, "{rendered}\n") ?? return Err(fail("cannot write {RUNTIME_LEDGER_PATH}: {err}"))
    verdicts: json.to_string(field(field(built.ledger, "summary"), "verdicts")) ?? return Err(fail("the verdicts cannot be encoded: {err}"))
    Ok("wrote {RUNTIME_LEDGER_PATH}\nrows={spelled(field(field(built.ledger, "summary"), "rowCount"))} verdicts={verdicts}")
}

ReleaseFailure: struct {
    task: String
    reason: String
}

release_mode: fn(root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    built: build_ledger(root) ?? return Err(err)
    validate_ledger(root, built) ?? return Err(fail("{err.message} (owner #1398)"))
    workflows: items(field(field(built.ledger, "coreApiGate"), "workflowManifest"))
    failures := [ReleaseFailure]{}
    loop workflow in workflows {
        task: spelled(field(workflow, "task"))
        evidence: field(workflow, "evidence")
        status: text_field(field(workflow, "input"), "fixtureStatus")
        if status == "stale" {
            failures.push(ReleaseFailure{task: task, reason: "fixture is stale"})
        } else {
            if status != "fresh" && status != "accepted" -> failures.push(ReleaseFailure{task: task, reason: "fixture is not bound to an accepted frozen source"})
        }
        if !text_is(evidence, "status", "measured") {
            failures.push(ReleaseFailure{task: task, reason: "missing measured source-cost, concept, hidden-fact, lookup, ceremony, review, and Jet-win evidence"})
            next
        }
        if !truthy(field(evidence, "rawSourceCounts")) || !is_array(field(evidence, "mandatoryConceptIds")) ||
            !is_array(field(evidence, "hiddenFacts")) || !is_array(field(evidence, "nonlocalLookups")) ||
            !is_array(field(evidence, "extraConstructs")) || !truthy(field(evidence, "reasoningBurden")) ||
            !truthy(field(evidence, "independentFixtureReview")) || !truthy(field(evidence, "jetWin")) {
            failures.push(ReleaseFailure{task: task, reason: "measured evidence record is incomplete"})
        }
        loop construct in items(field(evidence, "extraConstructs")) {
            if !EVIDENCE_CLASSIFICATIONS.contains(text_field(construct, "classification")) {
                failures.push(ReleaseFailure{task: task, reason: "extra construct has no valid classification"})
            }
            loop name in ([String]{"span", "cost", "rejectedShorterForm", "lostValue", "reviewerVerdict"}) {
                if field(construct, name) == .Null || text_is(construct, name, "") -> failures.push(ReleaseFailure{task: task, reason: "extra construct is missing {name}"})
            }
            claimed := false
            loop name in CONSTRUCT_BENEFITS {
                if field(construct, name) != .Null && !text_is(construct, name, "") -> claimed = true
            }
            if !claimed -> failures.push(ReleaseFailure{task: task, reason: "extra construct has no claimed product benefit"})
            if text_is(construct, "classification", "incidental-ceremony") -> failures.push(ReleaseFailure{task: task, reason: "incidental ceremony is unexplained"})
        }
        win: field(evidence, "jetWin")
        if text_is(field(evidence, "reasoningBurden"), "status", "worse") && !bool_is(win, "compensates", true) {
            failures.push(ReleaseFailure{task: task, reason: "worse reasoning burden has no compensating product win"})
        }
        if !text_is(field(evidence, "independentFixtureReview"), "status", "accepted") {
            failures.push(ReleaseFailure{task: task, reason: "fixture lacks independent idiomatic/minimal acceptance"})
        }
        if !text_is(win, "status", "accepted") -> failures.push(ReleaseFailure{task: task, reason: "missing evidence-backed Jet win"})
    }
    if failures.len() > 0 {
        shown := [String]{}
        loop at in 0..<failures.len() {
            if at < 4 -> shown.push("{failures[at].task}: {failures[at].reason} (owner #1398)")
        }
        more: if failures.len() > shown.len() -> "\n- ..." else -> ""
        return Err(fail("core API release gate blocked; failures={failures.len()}\n- {shown.join("\n- ")}{more}"))
    }
    Ok("core API release gate: ready; workflows={spelled(field(field(field(built.ledger, "coreApiGate"), "summary"), "workflowCount"))}")
}

// ---- Hostile fixtures ---------------------------------------------------------------
//
// A checker that only ever sees a correct ledger proves nothing: it would pass
// just as happily with every gate deleted. Each fixture below takes the real
// ledger, breaks exactly one thing, and requires the matching gate to reject
// it. A gate that stops firing fails here rather than going quiet in CI. The
// Core.jet parser fixtures live with the parser, in CoreSourceRows.jet's tests.

// `value` with the item at `path` changed: "set" replaces it with `new_value`
// (adding a missing key), "remove" drops it, "pop" drops an array's last item,
// "push" appends `new_value` to an array. A numeric step indexes an array.
edited: fn(value: Dyn, path: [String], kind: String, new_value: Dyn) -> Dyn Never! {
    if path.len() == 0 {
        if kind == "set" -> return new_value.copy()
        list := items(value)
        if kind == "pop" -> _: list.pop()
        if kind == "push" -> list.push(new_value.copy())
        return Dyn.Array(list)
    }
    step: path[0]
    rest := [String]{}
    loop at in 1..<path.len() -> rest.push(path[at].copy())
    if value == .Array(list) {
        at: Int.parse(step) ?? 0
        out := list.copy()
        out[at] = edited(out[at], rest, kind, new_value)
        return Dyn.Array(out)
    }
    kept := [(key: String, value: Dyn)]{}
    found := false
    loop entry in entries(value) {
        if entry.key != step {
            kept.push((key: entry.key.copy(), value: entry.value.copy()))
            next
        }
        found = true
        if rest.len() == 0 && kind == "remove" -> next
        kept.push((key: entry.key.copy(), value: edited(entry.value, rest, kind, new_value)))
    }
    if !found && rest.len() == 0 && kind == "set" -> kept.push((key: step.copy(), value: new_value.copy()))
    Dyn.Object(kept)
}

// The fixture must fail for its own reason. Accepting any failure let a broken
// fixture pass on its own setup error. `expected` is the gate's own wording,
// so a setup error fails loudly instead of forging a green.
rejects: fn(name: String, expected: String, outcome: Int LedgerError!) -> String LedgerError! {
    if outcome == {
        .Ok(_) -> Err(fail("fixture was accepted but must be rejected: {name}"))
        .Err(failure) -> {
            first: failure.message.split("\n").to_list()[0].copy()
            if !failure.message.contains(expected) {
                return Err(fail("fixture '{name}' failed for the wrong reason.\n  expected the gate to say: {expected}\n  actually failed with:     {first}"))
            }
            Ok("rejected: {name} -> {first}")
        }
    }
}

// Some properties are positive: the parser must find every arm. A rejection
// fixture cannot express that.
holds: fn(name: String, outcome: Int LedgerError!) -> String LedgerError! {
    if outcome == {
        .Ok(_) -> Ok("held: {name}")
        .Err(failure) -> Err(failure)
    }
}

// Math.Truncate is rounding toward zero, not emptying a container, and
// DateTime.Add is date arithmetic, not appending. Both were scored as real
// gaps until the collection groups stopped applying outside container types.
collection_verbs_stay_in_containers: fn() -> Int LedgerError! {
    names: synonyms()
    loop pair in ([(operation: String, container: String)]{
        (operation: "truncate", container: "core.math"),
        (operation: "add", container: "core.time"),
        (operation: "reset", container: "core.time"),
    }) {
        key: canonical_key(names, pair.operation, pair.container)
        if key != normalize(pair.operation) -> return Err(fail("a collection verb matched in a module namespace: {pair.operation} in {pair.container} became {key}"))
    }
    // The same verbs must still fold inside a container type.
    if canonical_key(names, "truncate", "List") != "clear" -> return Err(fail("truncate stopped folding into clear inside a container type"))
    Ok(0)
}

without_name: fn(values: [String], name: String) -> [String] Never! {
    out := [String]{}
    loop value in values {
        if value != name -> out.push(value.copy())
    }
    out
}

// A fixture that cannot be built is a broken fixture, not a passing one.
must_index: fn(at: Int, what: String) -> Int LedgerError! {
    if at < 0 -> return Err(fail("cannot build the fixture: {what}"))
    Ok(at)
}

row_index: fn(rows: [Dyn], verdict: String) -> Int Never! {
    loop (at, row) in rows {
        if text_is(row, "verdict", verdict) -> return at
    }
    -1
}

surface_index: fn(surfaces: [SurfaceEntry], language: String) -> Int Never! {
    loop (at, entry) in surfaces {
        if entry.language == language -> return at
    }
    -1
}

fixture_cluster: fn(container: String, card: Int, state: String) -> Dyn Never! {
    cluster := Dyn.object()
    cluster["container"] = jtext(container)
    cluster["lossCount"] = Dyn.Int(1)
    cluster["languages"] = texts([String]{"Rust"})
    if card >= 0 {
        cluster["ownerCard"] = Dyn.Int(card)
        cluster["ownerCardPhase"] = jtext("done")
    } else {
        cluster["priorCard"] = Dyn.Int(1404)
        cluster["priorCardPhase"] = jtext("done")
    }
    cluster["ownerState"] = jtext(state)
    cluster
}

hostile_fixtures: fn(root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    built: build_ledger(root) ?? return Err(err)
    ledger: built.ledger
    surfaces: built.surfaces
    board: built.board
    zeros: "0".repeat(64)
    results := [String]{}

    results.push(rejects("Core API workflow manifest drops a ledger row", "Core API gate workflow manifest does not cover every ledger row",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "workflowManifest"}, "pop", Dyn.Null))) ?? return Err(err))
    results.push(rejects("Core API workflow omits evidence fields", "Core API workflow evidence is missing rawSourceCounts",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "workflowManifest", "0", "evidence", "rawSourceCounts"}, "remove", Dyn.Null))) ?? return Err(err))
    results.push(rejects("Core API workflow omits its Jet win", "Core API workflow lacks an accepted Jet win",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "workflowManifest", "0", "evidence", "jetWin"}, "set", Dyn.Null))) ?? return Err(err))

    arms := Dyn.object()
    jet_arm := Dyn.object()
    jet_arm["tokens"] = Dyn.Int(1)
    arms["jet"] = jet_arm
    counts := Dyn.object()
    counts["unit"] = jtext("lexical-token")
    counts["includes"] = texts(EVIDENCE_INCLUDES)
    counts["arms"] = arms
    burden := Dyn.object()
    burden["status"] = jtext("equal")
    burden["evidence"] = jtext("fixture review")
    workflow_path: [String]{"coreApiGate", "workflowManifest", "0"}
    measured := edited(ledger, [String]{"coreApiGate", "workflowManifest", "0", "input", "fixtureStatus"}, "set", jtext("accepted"))
    loop change in ([(name: String, value: Dyn)]{
        (name: "status", value: jtext("measured")),
        (name: "rawSourceCounts", value: counts),
        (name: "mandatoryConceptIds", value: Dyn.Array([Dyn]{})),
        (name: "hiddenFacts", value: Dyn.Array([Dyn]{})),
        (name: "nonlocalLookups", value: Dyn.Array([Dyn]{})),
        (name: "extraConstructs", value: Dyn.Array([Dyn]{})),
        (name: "reasoningBurden", value: burden),
        (name: "independentFixtureReview", value: Dyn.object()),
        (name: "jetWin", value: Dyn.object()),
    }) {
        path := workflow_path.copy()
        path.push("evidence")
        path.push(change.name.copy())
        measured = edited(measured, path, "set", change.value)
    }
    results.push(rejects("measured evidence omits raw source dimensions", "measured evidence has incomplete raw source counts",
        validate_core_api_gate(root, measured)) ?? return Err(err))

    results.push(rejects("Core API fixture loses independent acceptance", "Core API fixture lacks accepted independent review",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "fixtureContract", "tasks", "0", "independentFixtureReview", "minimal"}, "set", Dyn.Bool(false)))) ?? return Err(err))
    results.push(rejects("Core API fixture loses deterministic runner binding", "Core API fixture execution contract drifted",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "fixtureContract", "execution", "runnerDigest"}, "set", jtext(zeros)))) ?? return Err(err))
    results.push(rejects("Core API fixture output artifact drifts", "Core API fixture receipt projection drifted",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "fixtureContract", "tasks", "0", "receipts", "0", "stdoutSha256"}, "set", jtext(zeros)))) ?? return Err(err))
    results.push(rejects("Core API fixture selection drifts", "Core API fixture selection contract drifted",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "fixtureContract", "selection", "field"}, "set", jtext("domain")))) ?? return Err(err))
    results.push(rejects("Core API fresh review loses a check", "Core API gate is missing its fresh-review contract",
        validate_core_api_gate(root, edited(ledger, [String]{"coreApiGate", "freshReview", "checks"}, "pop", Dyn.Null))) ?? return Err(err))
    hidden := edited(ledger, [String]{"coreApiGate", "workflowManifest", "0", "scope", "excluded"}, "set", Dyn.Bool(true))
    hidden = edited(hidden, [String]{"coreApiGate", "workflowManifest", "0", "scope", "decline"}, "set", Dyn.Null)
    results.push(rejects("Core API workflow hides an unratified decline", "hidden without a ratified scope decision",
        validate_core_api_gate(root, hidden)) ?? return Err(err))

    // A recurring name that nobody classified must stop the run. Without this,
    // a refresh that introduces one would silently keep per-domain scoring, and
    // per-domain scoring is exactly what can hold a real gap at one witness
    // forever.
    results.push(holds("a collection verb does not match in a module namespace", collection_verbs_stay_in_containers()) ?? return Err(err))
    // A POOLED name that still has competitor_operation rows in 2+ domains
    // after synonym folds. `clone` collapsed to a single domain.
    rows: items(field(ledger, "rows"))
    results.push(rejects("a recurring operation name nobody classified", "unclassified repeated operation name",
        validate_repeated_names(rows, without_name(CROSS_DOMAIN_POOLED, "hash"), without_name(CROSS_DOMAIN_DISTINCT, "hash"))) ?? return Err(err))

    jet_at: must_index(row_index(rows, "equal"), "the ledger has no equal row") ?? return Err(err)
    loss_at: must_index(row_index(rows, "jet_loses"), "the ledger has no loss row") ?? return Err(err)

    results.push(rejects("duplicate row id", "duplicate row id:",
        validate_rows(edited(ledger, [String]{"rows"}, "push", rows[0]), surfaces)) ?? return Err(err))
    matched := -1
    loop (at, entry) in entries(field(rows[jet_at], "competitors")) {
        if matched < 0 && text_is(entry.value, "status", "has") -> matched = at
    }
    matched_at: must_index(matched, "the sample equal row has no matched competitor") ?? return Err(err)
    language: entries(field(rows[jet_at], "competitors"))[matched_at].key.copy()
    fabricated := Dyn.object()
    fabricated["status"] = jtext("has")
    fabricated["operation"] = jtext("jet_ledger_operation_that_does_not_exist")
    results.push(rejects("fabricated competitor member", "unverified competitor claim in",
        validate_rows(edited(ledger, [String]{"rows", "{jet_at}", "competitors", language}, "set", fabricated), surfaces)) ?? return Err(err))
    lacking := Dyn.object()
    lacking["status"] = jtext("lacks")
    lacking["operation"] = Dyn.Null
    emptied := Dyn.object()
    loop entry in entries(field(rows[jet_at], "competitors")) -> emptied[entry.key] = lacking.copy()
    results.push(rejects("equal verdict with no competitor operation", "equal verdict with no matching competitor operation:",
        validate_rows(edited(ledger, [String]{"rows", "{jet_at}", "competitors"}, "set", emptied), surfaces)) ?? return Err(err))
    results.push(rejects("unmapped shipped method", "row without a Jet spelling:",
        validate_rows(edited(ledger, [String]{"rows", "{jet_at}", "jetSpelling"}, "set", Dyn.Null), surfaces)) ?? return Err(err))
    results.push(rejects("invalid verdict", "invalid verdict in",
        validate_rows(edited(ledger, [String]{"rows", "{jet_at}", "verdict"}, "set", jtext("probably_fine")), surfaces)) ?? return Err(err))

    rust_at: must_index(surface_index(surfaces, "Rust"), "no Rust surface is recorded") ?? return Err(err)
    skipped := surfaces.copy()
    skipped[rust_at].surface = edited(skipped[rust_at].surface, [String]{"containers", text_items(field(ledger, "canonicalContainers"))[0]}, "remove", Dyn.Null)
    results.push(rejects("hidden exclusion: a language skips a container", "records no verdict for",
        validate_surfaces(ledger, skipped)) ?? return Err(err))
    absent := -1
    loop (at, entry) in entries(field(surfaces[rust_at].surface, "containers")) {
        if absent < 0 && !truthy(field(entry.value, "present")) -> absent = at
    }
    absent_at: must_index(absent, "Rust records no absent container") ?? return Err(err)
    absent_name: entries(field(surfaces[rust_at].surface, "containers"))[absent_at].key.copy()
    unreasoned := surfaces.copy()
    unreasoned[rust_at].surface = edited(unreasoned[rust_at].surface, [String]{"containers", absent_name, "reason"}, "remove", Dyn.Null)
    results.push(rejects("hidden exclusion: absent container with no reason", "absent with no reason",
        validate_surfaces(ledger, unreasoned)) ?? return Err(err))
    dropped := [SurfaceEntry]{}
    loop entry in surfaces {
        if entry.language != "Julia" -> dropped.push(entry.copy())
    }
    results.push(rejects("a language is dropped from the comparison", "the owner named eleven languages",
        validate_surfaces(ledger, dropped)) ?? return Err(err))
    go_at: must_index(surface_index(surfaces, "Go"), "no Go surface is recorded") ?? return Err(err)
    unscoped := surfaces.copy()
    unscoped[go_at].surface = edited(unscoped[go_at].surface, [String]{"scopeRule"}, "remove", Dyn.Null)
    results.push(rejects("surface without recorded provenance", "surface without recorded provenance:",
        validate_surfaces(ledger, unscoped)) ?? return Err(err))

    // The cluster is synthesised, not found. Once every cluster has a live card
    // there is no closed one to break, and searching for one made the fixture
    // fail on its own setup instead of proving the gate.
    // The card is one no real cluster names, so reopening it on a copy of the
    // board can only trip the synthesised cluster.
    owned := [Int]{}
    loop cluster in items(field(ledger, "lossClusters")) -> owned.push(int_of(field(cluster, "ownerCard")) ?? -1)
    done := -1
    loop card in board.cards {
        if done < 0 && card.phase == "done" && !owned.contains(card.num) -> done = card.num
    }
    done_card: must_index(done, "the board has no done card to build the fixture from") ?? return Err(err)
    results.push(rejects("stale owner: cluster claims a closed card", "names closed card #",
        validate_owners(edited(ledger, [String]{"lossClusters"}, "push", fixture_cluster("LedgerFixtureClosed", done_card, "live")), board)) ?? return Err(err))
    must_index(items(field(ledger, "lossClusters")).len() - 1, "the ledger has no loss cluster") ?? return Err(err)
    missing_card := edited(ledger, [String]{"lossClusters", "0", "ownerState"}, "set", jtext("live"))
    missing_card = edited(missing_card, [String]{"lossClusters", "0", "ownerCard"}, "set", Dyn.Int(999999))
    results.push(rejects("stale owner: cluster claims a card that is not on the board", "names missing card #",
        validate_owners(missing_card, board)) ?? return Err(err))
    reopened := board.copy()
    loop at in 0..<reopened.cards.len() {
        if reopened.cards[at].num == done_card -> reopened.cards[at].phase = "building"
    }
    results.push(rejects("closed owner that the board has reopened", "but the board has it in",
        validate_owners(edited(ledger, [String]{"lossClusters"}, "push", fixture_cluster("LedgerFixtureReopened", done_card, "closed")), reopened)) ?? return Err(err))
    // A cluster is synthesised rather than found: once every cluster has a
    // card, searching the live ledger would fail on setup instead of proving
    // the gate.
    results.push(rejects("cluster both names a card and claims to need one", "claims to need one",
        validate_owners(edited(ledger, [String]{"lossClusters"}, "push", fixture_cluster("LedgerFixtureContainer", -1, "needs_card")), board)) ?? return Err(err))

    // The board holds no unratified decision today, so the fixture injects one.
    // Reading the live board would let the fixture pass by finding nothing.
    open_board := board.copy()
    open_board.decisions.push(BoardDecision{id: "D-LEDGER-FIXTURE-1", status: "open"})
    unratified := edited(ledger, [String]{"rows", "{loss_at}", "verdict"}, "set", jtext("declined"))
    unratified = edited(unratified, [String]{"rows", "{loss_at}", "declinedBy"}, "set", jtext("D-LEDGER-FIXTURE-1"))
    results.push(rejects("unratified scope exclusion", "unratified scope exclusion in",
        validate_owners(unratified, open_board)) ?? return Err(err))
    unknown := edited(ledger, [String]{"rows", "{loss_at}", "verdict"}, "set", jtext("declined"))
    unknown = edited(unknown, [String]{"rows", "{loss_at}", "declinedBy"}, "set", jtext("D-LEDGER-NO-SUCH-DECISION"))
    results.push(rejects("decline naming a decision the board does not have", "declined row names an unknown decision:",
        validate_owners(unknown, board)) ?? return Err(err))
    results.push(rejects("decline with no decision id", "declined row without a decision id:",
        validate_owners(edited(ledger, [String]{"rows", "{loss_at}", "verdict"}, "set", jtext("declined")), board)) ?? return Err(err))

    uncompared: text_items(field(ledger, "uncomparedDomains"))
    must_index(uncompared.len() - 1, "the ledger lists no uncompared domain") ?? return Err(err)
    rest := [String]{}
    loop at in 1..<uncompared.len() -> rest.push(uncompared[at].copy())
    results.push(rejects("hidden uncompared Core domain", "uncompared Core domains are not fully listed",
        validate_coverage(edited(ledger, [String]{"uncomparedDomains"}, "set", texts(rest)), built.modules)) ?? return Err(err))

    // Each drift is compared against a fresh rebuild of the same tree.
    rebuilt: build_ledger(root) ?? return Err(err)
    results.push(rejects("source-surface drift", "core surface ledger drifted",
        compare_ledger(edited(ledger, [String]{"sourceFiles", "0", "sha256"}, "set", jtext(zeros)), rebuilt.ledger)) ?? return Err(err))
    jet_id: text_field(rows[jet_at], "id")
    loss_id: text_field(rows[loss_at], "id")
    without_jet := [Dyn]{}
    without_loss := [Dyn]{}
    loop row in rows {
        id: text_field(row, "id")
        if id != jet_id -> without_jet.push(row.copy())
        if id != loss_id -> without_loss.push(row.copy())
    }
    results.push(rejects("a shipped method is dropped from the ledger", "core surface ledger drifted",
        compare_ledger(edited(ledger, [String]{"rows"}, "set", Dyn.Array(without_jet)), rebuilt.ledger)) ?? return Err(err))
    results.push(rejects("a competitor member is dropped from the ledger", "core surface ledger drifted",
        compare_ledger(edited(ledger, [String]{"rows"}, "set", Dyn.Array(without_loss)), rebuilt.ledger)) ?? return Err(err))

    results.push("core surface ledger: {results.len()} fixtures all held")
    Ok(results.join("\n"))
}

ledger_main: fn(args: [String]) -[Env, Exec, FS, IO, Time, Time.Wait]> String LedgerError! {
    root: repo_root()
    if root == "" -> return Err(fail("{TOOL} must run inside a Jet checkout"))
    if args.contains("--write") -> return write_mode(root)
    if args.contains("--check") -> return check_mode(root)
    if args.contains("--core-api-release-check") -> return release_mode(root)
    if args.contains("--hostile-fixtures") -> return hostile_fixtures(root)
    Err(fail("usage: jet Tools/agent/CoreSurfaceLedger.jet --write|--check|--core-api-release-check|--hostile-fixtures"))
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? return ""
    loop {
        if files.exists("{dir}{TOOL}") -> return dir
        if dir == "/" || dir == "" -> return ""
        dir = files.dirname(dir)
    }
}

run: fn() {
    if ledger_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

#Test("edited sets, adds, removes, pops and pushes the item at a path") {
    doc: parse_json("{{\"a\": {{\"b\": [1, 2]}}, \"c\": \"x\"}}", "doc") ?? panic("the fixture document did not parse: {err.message}")
    three: parse_json("3", "three") ?? panic("the fixture number did not parse: {err.message}")
    loop step in ([(path: [String], kind: String, value: Dyn, want: String)]{
        (path: [String]{"c"}, kind: "set", value: jtext("y"), want: "{{\"a\": {{\"b\": [1, 2]}}, \"c\": \"y\"}}"),
        (path: [String]{"d"}, kind: "set", value: jtext("z"), want: "{{\"a\": {{\"b\": [1, 2]}}, \"c\": \"x\", \"d\": \"z\"}}"),
        (path: [String]{"c"}, kind: "remove", value: Dyn.Null, want: "{{\"a\": {{\"b\": [1, 2]}}}}"),
        (path: [String]{"a", "b"}, kind: "pop", value: Dyn.Null, want: "{{\"a\": {{\"b\": [1]}}, \"c\": \"x\"}}"),
        (path: [String]{"a", "b"}, kind: "push", value: three.copy(), want: "{{\"a\": {{\"b\": [1, 2, 3]}}, \"c\": \"x\"}}"),
        (path: [String]{"a", "b", "0"}, kind: "set", value: three.copy(), want: "{{\"a\": {{\"b\": [3, 2]}}, \"c\": \"x\"}}"),
        (path: [String]{}, kind: "set", value: three.copy(), want: "3"),
    }) {
        expected: parse_json(step.want, "want") ?? panic("the expected document did not parse: {err.message}")
        assert(same(edited(doc, step.path, step.kind, step.value), expected))
    }
    original: parse_json("{{\"a\": {{\"b\": [1, 2]}}, \"c\": \"x\"}}", "original") ?? panic("the original document did not parse: {err.message}")
    assert(same(doc, original))
}

#Test("integers read from built and parsed numbers, and truthiness follows JavaScript") {
    parsed: parse_json("{{\"n\": 7, \"zero\": 0, \"half\": 0.5, \"empty\": \"\"}}", "doc") ?? panic("the fixture document did not parse: {err.message}")
    assert_eq(int_of(Dyn.Int(4)), Val(4))
    assert_eq(int_of(field(parsed, "n")), Val(7))
    assert_eq(int_of(field(parsed, "half")), None)
    assert(int_is(parsed, "n", 7) && !int_is(parsed, "n", 8) && !int_is(parsed, "missing", 0))
    assert(non_negative_int(field(parsed, "zero")) && !non_negative_int(jtext("1")))
    assert(truthy(field(parsed, "n")) && truthy(field(parsed, "half")))
    assert(!truthy(field(parsed, "zero")) && !truthy(field(parsed, "empty")) && !truthy(field(parsed, "missing")))
}

#Test("collection verbs fold only inside container types and operators are not operations") {
    assert_eq(collection_verbs_stay_in_containers() ?? panic("a collection verb folded outside a container type: {err.message}"), 0)
    names: synonyms()
    assert_eq(canonical_key(names, "is_subset_of", "Set"), canonical_key(names, "issubset", "Set"))
    assert(is_named_operation("push") && is_named_operation("empty?") && is_named_operation("value="))
    assert(!is_named_operation("+") && !is_named_operation("[]=") && !is_named_operation(""))
}

#Test("a fixture outcome must fail with the gate's own wording") {
    assert((rejects("accepted", "anything", Ok(0)) ?? err.message) == "fixture was accepted but must be rejected: accepted")
    assert((rejects("wrong", "stale owner", Err(fail("setup broke\nmore"))) ?? err.message).contains("failed for the wrong reason"))
    assert_eq(rejects("right", "stale owner", Err(fail("stale owner: X\nmore"))) ?? err.message, "rejected: right -> stale owner: X")
    assert_eq(holds("held", Ok(0)) ?? err.message, "held: held")
}
