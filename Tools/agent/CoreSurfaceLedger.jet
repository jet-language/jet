#!/usr/bin/env jet
// One source-derived Core inventory, compared against every language Jet
// competes with. Read by the #1398 release gate.
//
// The compiler tables are authoritative for what Jet ships. Each recorded
// competitor surface is authoritative for what that language ships. This file
// holds only the comparison policy and the reader of those tables; Core.jet's
// declarations are read and gated by Tools/agent/CoreSourceRows.jet, whose
// `--facts` this tool reads. The runtime JSON report is generated from those
// inputs; --check rebuilds it and never reads the report.
//
// The ledger is a report. It records what is true today. It does not track
// work, and coverage is a number it prints rather than a gate.
//
// Usage (from the repository root): jet Tools/agent/CoreSurfaceLedger.jet
// --write|--check|--core-api-release-check|--hostile-fixtures
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    text: core.text
    time: core.time
}

TOOL: "/Tools/agent/CoreSurfaceLedger.jet"
RUNTIME_LEDGER_PATH: ".jet/reports/core-surface-ledger.json"
PYTHON_SURFACE_PATH: "Docs/spec/reference/python-surface.json"
// Decisions and card owners come only from the board of the tree under check,
// never from another checkout's live board, so the same tree checks the same
// way in a git worktree and in a plain export. Read-only, through that tree's
// Tower CLI, whose `show` reads the live board and then its archive: a ratified
// decision or a done card retires to history.json, and a declined row or a
// closed owner must still resolve once it has.
TOWER_DATA_DIR: "Tools/tower/.tower"
TOWER_BOARD_PATH: "Tools/tower/.tower/tower.json"
TOWER_CLI_PATH: "Tools/tower/tower.mjs"
CORE_SOURCE_PATH: "Compiler/Prelude/Core.jet"
// The Core rows with no Core.jet declaration: typed fixed-signature members,
// built-in receiver methods, and the lowering-owned extension calls.
CORE_SURFACE_INVENTORY_PATH: "Compiler/Prelude/CoreSurfaceInventory.jet"
CORE_CALL_EXTENSIONS_PATH: "Compiler/Prelude/CoreCallExtensions.jet"
// The Jet tables an inventory `receivers` row reads receiver methods from, and
// the sema sources a `methods` row's names must be spelled in.
BUILTIN_METHODS_PATH: "Compiler/JetFoundation/Source/Registry/BuiltinMethods.jet"
BUILTIN_STATICS_PATH: "Compiler/JetFoundation/Source/Registry/BuiltinStatics.jet"
COLLECTIONS_PATH: "Compiler/JetFoundation/Source/Collections.jet"
CORE_SOURCE_PARTS_PATH: "Compiler/Prelude/CoreSourceParts.tsv"
SEMA_SOURCE_DIR: "Compiler/JetSema/Source"
// The generator of every Core view and the gate of Core.jet's declarations,
// run by $JET, else `jet` on PATH: its `--check` refuses a stale view and its
// `--facts` prints the Core module inventory this ledger compares.
CORE_ROWS_GENERATOR_PATH: "Tools/agent/CoreSourceRows.jet"
// The owner-controlled syntax registry: every Syntax string constant a Core.jet
// dispatcher row or the core.mem tier map names.
SYNTAX_DIR: "Compiler/JetFoundation/Data/Syntax"
CORE_API_LAWS_PATH: "Docs/spec/stdlib-api-laws.md"
SYNTAX_REFERENCE_PATH: "Docs/spec/reference/syntax-surface.jet"
AGENT_MANIFEST_PATH: "tests/agent_workloads/manifest.tsv"
AGENT_RECEIPT_PATH: "tests/agent_workloads/baselines/receipt.tsv"
AGENT_REVIEW_PATH: "tests/agent_workloads/core_api_fixture_reviews.tsv"
AGENT_CORPUS_ROOT: "tests/agent_workloads"
AGENT_DOMAIN_CONTRACT_PATH: "tests/agent_workloads/domain_contract.tsv"
AGENT_WORKLOAD_POLICY_PATH: "tests/agent_workloads/policy.tsv"
AGENT_CHECKSUMS_PATH: "tests/agent_workloads/SHA256SUMS"
// The Jet ports of the corpus runner: the equivalent-adapter case and the
// reviewed manifest and baseline guards.
AGENT_RUNNER_SOURCE_PATHS: [String]{
    "tests/cases/agent_workloads/equivalent_adapters_complete_declared_tasks.case",
    "tests/guards/agent_workloads_reviewed.jet",
}
CORE_API_REVIEW_TEST_PATH: "tests/guards/core_surface_ledger_reviewed.jet"
CORE_API_REVIEW_TEST: "tests/guards/core_surface_ledger_reviewed.jet::Core surface ledger teaches the same ratified API layering"
CORE_API_REVIEW_COMMAND: "jet Tools/agent/CoreSurfaceLedger.jet --check"
// The Jet ports of the editor tests that teach the Core gate forms.
EDITOR_COVERAGE_PATHS: [String]{
    "tests/cases/lsp/lsp_completion_returns_items.case",
    "tests/cases/lsp/lsp_signature_help_returns_active_parameter.case",
    "tests/cases/lsp/lsp_hover_returns_signature.case",
}
CORE_CONFORMANCE_PATH: "tests/conformance/fixture-bindings.tsv"
CORE_CONFORMANCE_FIXTURE_ROOT: "tests/conformance/corpus"
AGENT_BASELINE_ADAPTERS: [String]{"bash", "python", "node"}
AGENT_RUNNER_MARKERS: [String]{
    "#Test(\"manifest_is_complete_frozen_and_non_vacuous\")",
    "#Test(\"recorded_baselines_cover_frozen_tasks\")",
    "fixture: equivalent_adapters_complete_declared_tasks.fixture",
    "step jet_cold: jet run --release",
    "step jet_warm: jet run --release",
    "stdout: = \"{{cap:expected}}\"",
    "stdout: == jet_cold",
    "cap:after: = \"{{cap:before}}\"",
    "entries: run_jet name != \".jet\" = 0",
    "copy: {{root}}/tests/agent_workloads/baselines/receipt.tsv pins.tsv",
    "cap:pin_version: = \"{{cap:version_bash}}\"",
}
CORE_API_REVIEW_CHECKS: [String]{
    "workflow-closure",
    "construct-classifications",
    "reasoning-evidence",
    "syntax-coverage",
    "fixture-selection",
}
CORE_API_SYNTAX_MARKERS: [String]{
    "values: ...String",
    "[...tags",
    "Stream<Int>",
    "yield i",
    "delay: Int",
    "policy audit",
    "wrap(call)",
    "#Policy(",
}
// The frozen corpus manifest's evidence label for the equivalent-adapter run.
// It stays data; its Jet port is AGENT_RUNNER_SOURCE_PATHS.
AGENT_RUNNER: "tests/agent_workloads.rs::equivalent_adapters_complete_declared_tasks"
AGENT_SCORING: "#769:v1;exit=0;stdout=exact;cold=recorded;warm=equal;input=unchanged;scratch=closed"
EXECUTION_CHECKS: [String]{"pinned-tool-version", "cold-and-warm-run", "exact-stdout", "unchanged-input", "clean-scratch"}
EVIDENCE_COUNT_FIELDS: [String]{"tokens", "statements", "calls", "namedTemporaries"}
EVIDENCE_REQUIRED_COUNT_FIELDS: [String]{"tokens", "statements", "calls", "namedTemporaries", "imports", "requiredPolicy", "requiredErrorHandling"}
EVIDENCE_INCLUDES: [String]{"imports", "required-policy", "required-error-handling"}
EVIDENCE_CLASSIFICATIONS: [String]{"task-essential", "clarity-bearing", "guarantee-bearing", "expert-control", "incidental-ceremony"}
CONSTRUCT_BENEFITS: [String]{"claimedClarity", "reasoningBenefit", "localFactBenefit", "guaranteeBenefit", "expertControlBenefit"}
CASE_KINDS: [String]{"beginner", "expert-policy", "failure", "lifecycle"}
// A suffix that only restates the same workflow in another representation.
// Anything else is a distinct capability: zip_pad is not zip, count_by is not
// len, and crediting them to the base manufactured equals.
RESTATING_SUFFIXES: [String]{"bytes", "utc", "hex", "text", "str", "string", "at", "all"}
// A surface JSON file is one item far above the default 16 MiB item limit.
SURFACE_ITEM_LIMIT: 268435456
OUTPUT_LIMIT: 268435456

#Error
LedgerError: struct {
    message: String
}

fail: fn(message: String) -> LedgerError Never! {
    LedgerError{message: message.copy()}
}

// Every language the owner named on 2026-08-03, each with a recorded surface
// read from that language's own primary source. Python keeps its interpreter
// snapshot; the other ten are read from a runtime, from standard-library
// source, or from official machine-readable documentation.
SURFACE_FILES: [(language: String, path: String)]{
    (language: "Rust", path: "Docs/spec/reference/surfaces/rust-surface.json"),
    (language: "Go", path: "Docs/spec/reference/surfaces/go-surface.json"),
    (language: "Swift", path: "Docs/spec/reference/surfaces/swift-surface.json"),
    (language: "Kotlin", path: "Docs/spec/reference/surfaces/kotlin-surface.json"),
    (language: "C#", path: "Docs/spec/reference/surfaces/csharp-surface.json"),
    (language: "TypeScript", path: "Docs/spec/reference/surfaces/js-surface.json"),
    (language: "Ruby", path: "Docs/spec/reference/surfaces/ruby-surface.json"),
    (language: "Elixir", path: "Docs/spec/reference/surfaces/elixir-surface.json"),
    (language: "Julia", path: "Docs/spec/reference/surfaces/julia-surface.json"),
    (language: "R", path: "Docs/spec/reference/surfaces/r-surface.json"),
}

// Python's snapshot predates the container shape, so it is projected onto the
// shared containers rather than re-read. The map runs source to container, not
// container to source: the earlier shape let one module feed three containers,
// so every os function minted three separate gap rows.
PYTHON_SOURCE_CONTAINER: [(source: String, container: String)]{
    (source: "type:list", container: "List"),
    (source: "type:tuple", container: "List"),
    (source: "type:range", container: "Iter"),
    (source: "type:dict", container: "Map"),
    (source: "type:set", container: "Set"),
    (source: "type:str", container: "String"),
    (source: "type:bytes", container: "Bytes"),
    (source: "type:int", container: "core.math"),
    (source: "type:float", container: "core.math"),
    (source: "mod:builtins", container: "core.term"),
    (source: "mod:itertools", container: "Iter"),
    (source: "mod:collections", container: "Queue"),
    (source: "mod:heapq", container: "PriorityQueue"),
    (source: "mod:functools", container: "Cache"),
    (source: "mod:io", container: "Bytes"),
    (source: "mod:string", container: "String"),
    (source: "mod:textwrap", container: "String"),
    (source: "mod:math", container: "core.math"),
    (source: "mod:decimal", container: "core.math"),
    (source: "mod:fractions", container: "core.math"),
    (source: "mod:random", container: "core.math.random"),
    (source: "mod:secrets", container: "core.crypto.random"),
    (source: "mod:hashlib", container: "core.crypto"),
    (source: "mod:hmac", container: "core.crypto"),
    (source: "mod:datetime", container: "core.time"),
    (source: "mod:time", container: "core.time"),
    (source: "mod:json", container: "core.encoding.json"),
    (source: "mod:csv", container: "core.encoding.csv"),
    (source: "mod:tomllib", container: "core.encoding.toml"),
    (source: "mod:base64", container: "core.encoding.base64"),
    (source: "mod:binascii", container: "core.encoding.hex"),
    (source: "mod:re", container: "core.regex"),
    (source: "mod:pathlib", container: "core.files"),
    (source: "mod:os", container: "core.sys"),
    (source: "mod:sys", container: "core.sys"),
    (source: "mod:shutil", container: "core.files"),
    (source: "mod:glob", container: "core.files"),
    (source: "mod:tempfile", container: "core.files"),
    (source: "mod:subprocess", container: "core.process"),
    (source: "mod:socket", container: "core.net"),
    (source: "mod:ssl", container: "core.net.tls"),
    (source: "mod:http", container: "core.http"),
    (source: "mod:http.server", container: "core.http"),
    (source: "mod:urllib.parse", container: "core.net.url"),
    (source: "mod:uuid", container: "core.crypto.uuid"),
    (source: "mod:sqlite3", container: "core.db"),
    (source: "mod:asyncio", container: "core.tasks"),
    (source: "mod:threading", container: "core.sync"),
    (source: "mod:queue", container: "core.sync"),
    (source: "mod:argparse", container: "core.args"),
    (source: "mod:inspect", container: "core.reflect"),
    (source: "mod:mimetypes", container: "core.net.mime"),
    (source: "mod:xml.etree.ElementTree", container: "core.encoding.xml"),
    (source: "mod:copy", container: "core.mem"),
    (source: "mod:unittest", container: "core.testing"),
    (source: "mod:logging", container: "core.log"),
    (source: "mod:struct", container: "core.encoding"),
    (source: "mod:zipfile", container: "core.archive"),
    (source: "mod:tarfile", container: "core.archive"),
    (source: "mod:gzip", container: "core.archive"),
    (source: "mod:zlib", container: "core.archive"),
    (source: "mod:statistics", container: "core.data"),
    (source: "mod:unicodedata", container: "core.text"),
}

// A recorded Python module with no container yet. Listing it keeps the gap
// countable; dropping it silently would hide a whole workflow.
PYTHON_UNASSIGNED: [(source: String, reason: String)]{
    (source: "type:bool", reason: "bool mirrors int, which is recorded under core.math"),
    (source: "mod:email", reason: "Jet ships no email support"),
}

PYTHON_ABSENT: [(container: String, reason: String)]{
    (container: "Rank", reason: "no Python standard-library ordered set"),
    (container: "Bits", reason: "no Python standard-library bit set; int carries bit operations"),
    (container: "core.sys", reason: "environment and system facts share the sys module"),
    (container: "core.path", reason: "path operations live on pathlib, recorded under core.files"),
    (container: "core.encoding.base32", reason: "base32 lives in the base64 module, recorded under core.encoding.base64"),
    (container: "core.text.fmt", reason: "formatting lives on str.format, recorded under String"),
    (container: "core.text", reason: "text handling lives on str, recorded under String"),
    (container: "core.encoding.yaml", reason: "no Python standard-library YAML codec"),
    (container: "core.term", reason: "curses is platform-conditional, so it is not recorded here"),
    (container: "core.web", reason: "http.server answers core.http; Python ships no web framework"),
}

// A Jet module whose workflow is the one an existing container already
// records. Aliasing keeps one comparison per workflow instead of splitting the
// same competitor surface across two names. Task, TaskList and Duration are
// Jet types, but their workflow is the Core module a competitor answers with:
// without them a correctly read Task.cancel could never defend core.tasks.
// Civil-time types live in net_text_time.rs; their workflows are core.time.
CONTAINER_ALIASES: [(name: String, container: String)]{
    (name: "core.http.client", container: "core.http"),
    (name: "core.files.path", container: "core.files"),
    (name: "core.http.server", container: "core.http"),
    (name: "core.time.expiring", container: "core.time"),
    (name: "core.archive.gzip", container: "core.archive"),
    (name: "core.archive.zstd", container: "core.archive"),
    (name: "core.encoding", container: "core.encoding.json"),
    (name: "core.crypto.expert", container: "core.crypto"),
    (name: "Task", container: "core.tasks"),
    (name: "TaskList", container: "core.tasks"),
    (name: "Sender", container: "core.tasks"),
    (name: "Receiver", container: "core.tasks"),
    (name: "Duration", container: "core.time"),
    (name: "Path", container: "core.files"),
    (name: "Date", container: "core.time"),
    (name: "LocalDate", container: "core.time"),
    (name: "LocalTime", container: "core.time"),
    (name: "DateTime", container: "core.time"),
    (name: "Instant", container: "core.time"),
    (name: "Period", container: "core.time"),
    (name: "Zone", container: "core.time"),
    (name: "ZonedDateTime", container: "core.time"),
}

// Interchangeable spellings of one operation live in SYNONYM_GROUPS below. A
// gap merges by domain, so `unlink` under core.sys and under core.path is one
// row. A name that recurs across *different* domains is a separate question,
// and it has two different answers.
//
// `clone` on a List and `clone` on a Map are one capability asked twice: if two
// languages ship it anywhere, Jet lacking it is a real gap, and scoring each
// domain alone can hold every occurrence at one witness forever. Those names
// pool their witnesses across domains before the two-witness threshold: value
// protocols (duplication, comparison, hashing, conversion), container
// protocols (emptiness, membership, iteration) and storage control.
//
// `close` on a byte builder and `close` on a database handle are different
// operations that share a spelling. Pooling them would invent evidence, so they
// keep the per-domain count.
//
// There is no mechanical separator — the difference is what the operation means,
// not how it is spelled. Every recurring name is therefore listed here by hand,
// and `--check` rejects a name that recurs without an entry, so a refresh cannot
// quietly introduce an unreviewed one.
CROSS_DOMAIN_POOLED: [String]{
    "clone", "copy", "deepcopy", "copyinto", "copyto", "equal", "isequal", "deepequal",
    "cmp", "compare", "hash", "tostring", "tostr", "isempty", "clear", "contains",
    "iter", "iterator", "capacity", "reserve", "resize", "setlen", "sizehint", "drain",
    "sizeof", "bytesize",
}

// Every other recurring name: the spelling repeats but the operation does not.
// A `read` on a socket, a file and a byte buffer are three different operations;
// a `next` on an iterator and on a sequence generator are two. These keep the
// per-domain witness count, which is the conservative reading — it can only
// under-score, never invent a gap. Listing them is the record that each was
// looked at rather than defaulted.
CROSS_DOMAIN_DISTINCT: [String]{
    "append", "delete", "in", "length", "size", "truncate", "unlink", "abort",
    "abs", "absolutepath", "addcleanup", "addelement", "all", "and", "any", "appendtext",
    "args", "available", "average", "base", "big", "binarysearch", "binarysearchby", "breakpoint",
    "broadcast", "buffered", "bufferedreader", "bufferedwriter", "byteoffset", "bytes", "capitalize", "casefold",
    "charset", "chdir", "chmod", "chown", "chr", "chunk", "classify", "cleanup",
    "clockgetres", "clockgettime", "close", "closeread", "collect", "command", "compact", "compareto",
    "complex", "components", "concat", "connect", "containsvalue", "context", "copyfile", "create",
    "createconnection", "createserver", "ctime", "data", "datetimeformat", "decode", "deconstruct", "dedup",
    "default", "deleteat", "detach", "difference", "dir", "display", "div", "divide",
    "divmod", "droplast", "dump", "each", "enable", "encode", "endswith", "entry",
    "eof", "equals", "error", "escape", "escapestring", "eval", "evalfile", "exception",
    "exec", "exists", "exit", "exitcode", "exited", "expand", "fd", "fdatasync",
    "fdopen", "feed", "filename", "fileno", "filetype", "fill", "filter", "finalize",
    "find", "findlast", "first", "firstindex", "flags", "flatmap", "flatten", "flush",
    "fold", "fork", "formatstring", "formatter", "from", "fromhex", "fromkeys", "fullname",
    "get", "getattribute", "getbuffer", "getbytes", "getfield", "gethostname", "getint32", "getopts",
    "getpid", "group", "groupby", "groups", "handle", "help", "hex", "id",
    "include", "indent", "indexed", "indexof", "init", "insertrange", "intern", "intersection",
    "isascii", "isatty", "iscontrol", "isdefined", "isdigit", "iselement", "isexecutable", "isexported",
    "isalphabetic", "isnumeric", "iswhitespace", "chars", "isfifo", "ishexdigit", "isidentifier", "isless",
    "isletter", "isloopback", "islower", "isnormalized", "isnullorempty", "isnumber", "isprint", "ispunct",
    "isreadable", "isreadonly", "isset", "issigned", "issorted", "issortedby", "isspace", "issymbol",
    "issymlink", "istitle", "isupper", "isvalid", "iswritable", "join", "joinpath", "keepalive",
    "key", "keys", "kill", "kind", "last", "lastindexof", "len", "lines",
    "link", "list", "ljust", "map", "mapkeys", "mapof", "mapreduce", "match",
    "matches", "max", "merge", "metadata", "methods", "min", "minmax", "minus",
    "mkdir", "mod", "move", "new", "next", "normalize", "not", "now",
    "oct", "one", "only", "open", "options", "or", "ord", "out",
    "parse", "parseaddress", "partition", "path", "pathconf", "peercert", "perm", "permute",
    "pid", "pipe", "plus", "poll", "pop", "popat", "popen", "popfirst",
    "posixpath", "pread", "prefix", "prepend", "println", "processexited", "product", "push",
    "pwrite", "quote", "random", "range", "raw", "read", "readbyte", "readbytes",
    "reader", "readexactly", "readline", "readuntil", "recv", "reduceright", "register", "relative",
    "relativeto", "release", "remove", "removefirst", "removeprefix", "removerange", "removesuffix", "repeat",
    "replace", "repr", "resolve", "reverse", "rewind", "rjust", "rotate", "rotateleft",
    "round", "rpartition", "rsplit", "run", "scan", "seek", "send", "sendfile",
    "server", "set", "setdefault", "setenv", "setfloat64", "setlimit", "shift", "shuffle",
    "shutdown", "signal", "skip", "slice", "socket", "sockettype", "sort", "span",
    "splice", "split", "splitonce", "stack", "start", "startswith", "starttimer", "stats",
    "step", "sticky", "stop", "stoptimer", "string", "stripprefix", "struct", "success",
    "sum", "swap", "swapcase", "sync", "tail", "take", "tell", "throw",
    "time", "timens", "timeout", "timer", "title", "totitle", "toboolean", "tobyte",
    "tobytearray", "tochararray", "todouble", "tofloat", "tohexstring", "tolist", "tolower", "topath",
    "toset", "toupper", "transcode", "trim", "trimend", "trimstart", "trylock", "type",
    "typeassert", "typeof", "union", "unlock", "unquote", "unwrap", "unzip", "update",
    "urandom", "use", "userinfo", "utime", "valid", "validate", "value", "valueof",
    "values", "var", "verifyhostname", "verifymode", "version", "wait", "waitall", "with",
    "wrap", "write", "writebyte", "writelines", "writer", "writeto", "xor", "zero",
    "zip",
}

// Interchangeable spellings of one operation: any name in a group matches any
// other. Groups stay tight on purpose. Merging a name Jet lacks into a group
// Jet has would hide a real gap, so is_subset is not a kind of contains. Groups
// are authored with the plainest spelling first, which is what a gap should be
// called. "log" only means logarithm in a maths container, so it is in no group.
SYNONYM_GROUPS: [[String]]{
    [String]{"push", "append", "add", "add_last", "push_back", "conj", "add_range", "insert", "unshift", "prepend", "set", "put", "store", "set_value", "update"},
    [String]{"pop", "remove_last", "pop_last", "pop_back"},
    [String]{"len", "size", "count", "length", "size_hint", "sizehint", "capacity", "reserve", "resize", "setlen"},
    [String]{"get", "at", "try_get", "item", "nth", "fetch", "get_value"},
    [String]{"remove", "delete", "del", "discard", "erase", "unlink", "remove_at", "removefirst", "remove_first", "shift", "deleteat", "delete_at"},
    [String]{"clear", "truncate", "remove_all", "reset", "empty_out"},
    [String]{"contains", "includes", "has", "member", "has_key", "contains_key", "is_member", "in"},
    [String]{"contains_value", "has_value", "containsvalue"},
    [String]{"index_of", "index", "find_index", "position", "find_first", "search", "find"},
    [String]{"sort", "sorted", "sort_by", "order_by", "sort_with", "order", "sort_with_comparator"},
    [String]{"reverse", "reversed", "rev"},
    [String]{"map", "select", "convert", "map_values"},
    [String]{"filter", "where", "find_all", "reject", "compact"},
    [String]{"fold", "reduce", "inject", "aggregate", "foldl", "foldr", "accumulate", "reduceright", "reduce_right"},
    [String]{"each", "for_each", "iterate", "apply_each"},
    [String]{"first", "head", "front", "peek", "first_or_null", "peek_front", "next", "firstindex", "first_index"},
    [String]{"last", "back", "peek_last", "peek_back"},
    [String]{"indexed", "enumerate", "enumerated", "with_index", "each_index", "eachindex"},
    [String]{"skip", "drop"},
    [String]{"skip_while", "drop_while"},
    [String]{"take", "limit"},
    [String]{"take_while", "take_until"},
    [String]{"dedup", "unique", "uniq", "distinct", "nub"},
    [String]{"to_lower", "lower", "lowercase", "to_lowercase", "downcase"},
    [String]{"to_upper", "upper", "uppercase", "to_uppercase", "upcase"},
    [String]{"trim", "strip"},
    [String]{"trim_start", "trim_left", "lstrip", "trim_leading"},
    [String]{"trim_end", "trim_right", "rstrip", "chomp", "trim_trailing"},
