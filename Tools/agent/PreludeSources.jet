#!/usr/bin/env jet
// The compiler's embedded Prelude sources (#6670 c3). Each Compiler/Prelude
// file below is the one source of the Jet text the compiler parses for it; the
// raw-string constant that carries the text into the compiler is generated from
// it byte for byte. Compiler/Prelude/Effects.jet's copy (JET_CLI_EFFECT_SOURCE)
// is generated by Tools/agent/CoreSourceRows.jet.
// Usage: jet Tools/agent/PreludeSources.jet [--check|--write]
// --check fails when a copy differs from its Prelude file; --write rewrites
// the copies.
use {
    files: core.files
    process: core.process
    term: core.term
}

// A Prelude source and the constant whose raw text is its copy.
PreludeCopy: struct {
    source: String
    target: String
    constant: String
}

COPIES: [PreludeCopy]{
    PreludeCopy{source: "Compiler/Prelude/Markers.jet", target: "Compiler/JetFoundation/Source/Policy/PreludeMarkers.jet", constant: "MARKER_SOURCE"},
    PreludeCopy{source: "Compiler/Prelude/Derives.jet", target: "Compiler/JetSema/Source/Sema/Registration/PreludeDerives.jet", constant: "SEMA_PRELUDE_DERIVE_SOURCE"},
    PreludeCopy{source: "Compiler/Prelude/Errors.jet", target: "Compiler/JetSema/Source/Sema/Registration/PreludeDerives.jet", constant: "SEMA_PRELUDE_ERROR_SOURCE"},
    PreludeCopy{source: "Compiler/Prelude/Units.jet", target: "Compiler/JetSema/Source/Sema/Registration/PreludeUnits.jet", constant: "SEMA_PRELUDE_UNITS_SOURCE"},
}

FENCE: "```"
CLOSE: "``` }}"

#Error
PreludeSourcesError: struct {
    message: String
}

sources_fail: fn(message: String) -> PreludeSourcesError Never! {
    PreludeSourcesError{message: "prelude sources: {message}"}
}

// `text` with the raw string of `constant` holding `source` instead: the
// bytes between `CONSTANT: comptime { ``` ` and the next ``` }`.
splice: fn(text: String, constant: String, source: String, context: String) -> String PreludeSourcesError! {
    if source.contains(FENCE) -> return Err(sources_fail("{context} holds ``` and cannot be a raw string"))
    open: "{constant}: comptime {{ {FENCE}"
    head: "\n{text}".partition("\n{open}")
    if head.sep == "" -> return Err(sources_fail("{context}: no `{open}` line"))
    rest: head.tail.partition(CLOSE)
    if rest.sep == "" -> return Err(sources_fail("{context}: `{constant}` has no closing `{CLOSE}`"))
    Ok("{head.head}{head.sep}{source}{CLOSE}{rest.tail}".removeprefix("\n"))
}

read_text: fn(path: String) -[FS]> String PreludeSourcesError! {
    files.read(path) ?? return Err(sources_fail("cannot read {path}: {err}"))
}

TextFile: struct {
    path: String
    text: String
}

// Every target with each of its constants holding its Prelude source.
generated_files: fn() -[FS]> [TextFile] PreludeSourcesError! {
    out := [TextFile]{}
    loop row in COPIES {
        source: read_text(row.source) ?? return Err(err)
        found := -1
        loop (index, file) in out {
            if file.path == row.target -> found = index
        }
        if found < 0 {
            out.push(TextFile{path: row.target.copy(), text: read_text(row.target) ?? return Err(err)})
            found = out.len() - 1
        }
        out[found].text = splice(out[found].text, row.constant, source, "{row.target} from {row.source}") ?? return Err(err)
    }
    Ok(out)
}

prelude_sources_main: fn(args: [String]) -[FS]> String PreludeSourcesError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(sources_fail("usage: PreludeSources.jet [--check|--write]"))
    generated: generated_files() ?? return Err(err)
    differing := [String]{}
    loop file in generated {
        if (read_text(file.path) ?? return Err(err)) == file.text -> next
        differing.push(file.path.copy())
        if mode == "--write" -> files.write(file.path, file.text) ?? return Err(sources_fail("cannot write {file.path}: {err}"))
    }
    if mode == "--write" -> return Ok("prelude source copies written: {differing.len()} rewritten of {generated.len()}")
    if differing.len() == 0 -> return Ok("prelude sources check passed: {COPIES.len()} copies in {generated.len()} files match")
    Err(sources_fail("{differing.join(", ")} differ from Compiler/Prelude; run jet Tools/agent/PreludeSources.jet --write"))
}

run: fn() {
    if prelude_sources_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

#Test("every embedded copy matches its Prelude source") {
    if prelude_sources_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("a splice replaces only the named raw string") {
    text: "// head\nA: comptime {{ ```old a``` }}\n\nB: comptime {{ ```old b\n``` }}\n"
    spliced: splice(text, "B", "new b\n", "t") ?? panic(err.message)
    assert_eq(spliced, "// head\nA: comptime {{ ```old a``` }}\n\nB: comptime {{ ```new b\n``` }}\n")
    first: splice("A: comptime {{ ```x``` }}", "A", "y", "t") ?? panic(err.message)
    assert_eq(first, "A: comptime {{ ```y``` }}")
    if splice(text, "C", "c", "t") == .Ok(_) -> panic("a missing constant must fail")
    if splice(text, "A", "has ``` inside", "t") == .Ok(_) -> panic("a fence in the source must fail")
}
