#!/usr/bin/env jet
// Packages a pinned rustc 1.97.1 capture of the retired Rust PluginWire's real
// derives into Compiler/JetRuntime/Tests/PluginErrorGoldens.h, the offline
// goldens PluginErrorWitness.c checks. rustc is the oracle subject; this tool
// only formats its capture. Expected values are not native execution receipts.
// Input TSV rows: tag, limit, frame_count, debug UTF-8 hex, display UTF-8 hex.
// Usage (from the repository root):
//   jet Tools/agent/PluginDebugGoldens.jet <pinned-oracle.tsv>
use {
    files: core.files
    process: core.process
    term: core.term
}

OUTPUT: "Compiler/JetRuntime/Tests/PluginErrorGoldens.h"
HEADER: "// GENERATED by Tools/agent/PluginDebugGoldens.jet.\n// rustc 1.97.1 (8bab26f4f68e0e26f0bb7960be334d5b520ea452), the retired Rust PluginWire's real derives.\n// Expected outputs, not native execution receipts.\nstatic const struct {{ int64_t tag, limit, frames; const char *debug, *display; int64_t debug_length, display_length; }} plugin_goldens[] = {{\n"

#Error
GoldenError: struct {
    message: String
}

// Lowercase hex pairs only.
hex_pairs: fn(text: String) -> Bool {
    if text.len() % 2 != 0 -> return false
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

c_literal: fn(hex: String) -> String {
    out := [String]{"\""}
    at := 0
    loop at < hex.len() {
        out.push("\\x{hex[at..<at + 2]}")
        at += 2
    }
    out.push("\"")
    out.join("")
}

render: fn(tsv: String) -> String GoldenError! {
    rows := [String]{}
    index := 0
    loop line in tsv.trim_end().split("\n") {
        parts: line.split("\t").to_list()
        valid: parts.len() == 5 && (["0", "1", "2", "3"]).contains(parts[0]) && (["0", "1", "2", "3", "4"]).contains(parts[1]) && (parts[2] == "0" || parts[2] == "2") && hex_pairs(parts[3]) && hex_pairs(parts[4])
        if !valid -> return Err(GoldenError{message: "invalid oracle row {index}"})
        rows.push("    {{ {parts[0]}, {parts[1]}, {parts[2]}, {c_literal(parts[3])}, {c_literal(parts[4])}, {parts[3].len() / 2}, {parts[4].len() / 2} }},\n")
        index += 1
    }
    Ok("{HEADER}{rows.join("")}}};\n")
}

goldens_main: fn(args: [String]) -[FS]> String GoldenError! {
    if args.len() != 1 -> return Err(GoldenError{message: "usage: jet Tools/agent/PluginDebugGoldens.jet <pinned-oracle.tsv>"})
    tsv: files.read(args[0]) ?? return Err(GoldenError{message: "cannot read {args[0]}: {err}"})
    text: render(tsv)
    files.write(OUTPUT, text) ?? return Err(GoldenError{message: "cannot write {OUTPUT}: {err}"})
    Ok("plugin-error golden vectors: {tsv.trim_end().split("\n").to_list().len()}; pinned rustc 1.97.1")
}

run: fn() {
    if goldens_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

#Test("an oracle row renders as one C golden with byte lengths") {
    assert_eq(render("1\t0\t2\t4100\t0a\n") ?? err.message, "{HEADER}    {{ 1, 0, 2, \"\\x41\\x00\", \"\\x0a\", 2, 1 }},\n}};\n")
}

#Test("a malformed oracle row is refused") {
    assert_eq(render("4\t0\t0\t41\t41\n") ?? err.message, "invalid oracle row 0")
    assert_eq(render("0\t0\t0\t4G\t41\n") ?? err.message, "invalid oracle row 0")
}
