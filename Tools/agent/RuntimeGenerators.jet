#!/usr/bin/env jet
// The runtime's generated tables, from their one source each.
// Usage: jet Tools/agent/RuntimeGenerators.jet [--check] [--defects-only]
//        jet Tools/agent/RuntimeGenerators.jet lifecycle FILE...
//        jet Tools/agent/RuntimeGenerators.jet exports
//   (default)        rewrite every stale output
//   --check          write nothing; report every stale output
//   --defects-only   regenerate only the private trap defect rows, refusing
//                    when the frozen ordinary trap projection differs
//   lifecycle        print the lifecycle.list of a library object built from
//                    exactly the runtime sources FILE... (`-`: stdin; a
//                    fixture's unit)
//   exports          print `SYMBOL<TAB>FILE` for each #Export(c) function of
//                    the runtime sources sources.list names, in its order
// Run it from the repository root; every path is relative to it.
use {
    crypto: core.crypto
    json: core.encoding.json
    files: core.files
    process: core.process
    term: core.term
}

GeneratedFile: struct {
    path: String
    text: String
}

// The file's text, or None when it does not exist.
read_output: fn(path: String) -[FS]> String? GeneratorError! {
    if !files.exists(path) -> return Ok(None)
    text: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
    Ok(Val(text))
}

output_current: fn(path: String, expected: String) -[FS]> Bool GeneratorError! {
    if read_output(path) == {
        .Ok(found) -> if found == {
            .Val(text) -> return Ok(text == expected)
            .None -> return Ok(false)
        }
        .Err(error) -> return Err(error)
    }
}

write_output: fn(path: String, text: String) GeneratorError! {
    files.write(path, text) ?? return Err(generator_fail("cannot write {path}: {err}"))
}

USAGE: "usage: jet Tools/agent/RuntimeGenerators.jet [--check] [--defects-only] | lifecycle FILE... | exports"

runtime_generators_main: fn(args: [String]) -[FS, IO]> String GeneratorError! {
    if args.len() > 0 && args[0] == "lifecycle" -> return unit_lifecycle_list(args)
    if args.len() == 1 && args[0] == "exports" -> return runtime_export_files()
    check := false
    defects_only := false
    loop arg in args {
        if {
            arg == "--check" -> check = true
            arg == "--defects-only" -> defects_only = true
            else -> return Err(generator_fail(USAGE))
        }
    }
    registry: files.read(REGISTRY_PATH) ?? return Err(generator_fail("cannot read {REGISTRY_PATH}: {err}"))
    routes: files.read(ROUTES_PATH) ?? return Err(generator_fail("cannot read {ROUTES_PATH}: {err}"))
    debug: files.read(DEBUG_PATH) ?? return Err(generator_fail("cannot read {DEBUG_PATH}: {err}"))
    problems := [String]{}
    if render_trap_messages(registry, routes, debug) == {
        .Ok(trap) -> {
            source_current: output_current(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
            defects_current: output_current(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
            if trap_messages_plan(check, defects_only, source_current, defects_current) == {
                .Ok(plan) -> {
                    if plan.write_source -> write_output(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
                    if plan.write_defects -> write_output(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
                }
                .Err(error) -> problems.push(error.message)
            }
        }
        .Err(error) -> problems.push(error.message)
    }
    if defects_only {
        if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
        return Ok("")
    }
    outputs := [GeneratedFile]{}
    if render_scheduler_messages(registry) == {
        .Ok(text) -> outputs.push(GeneratedFile{path: SCHEDULER_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if render_test_messages() == {
        .Ok(text) -> outputs.push(GeneratedFile{path: TEST_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if render_observe_messages(registry) == {
        .Ok(text) -> outputs.push(GeneratedFile{path: OBSERVE_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if render_services_messages(registry) == {
        .Ok(text) -> outputs.push(GeneratedFile{path: SERVICES_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if render_lifecycle_list() == {
        .Ok(text) -> outputs.push(GeneratedFile{path: LIFECYCLE_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if read_needed_text() == {
        .Ok(needed) -> {
            loop file in needed -> outputs.push(file)
        }
        .Err(error) -> problems.push(error.message)
    }
    if read_stop_registry() == {
        .Ok(text) -> outputs.push(GeneratedFile{path: STOP_EXPORTS_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    if read_host_errors() == {
        .Ok(text) -> outputs.push(GeneratedFile{path: HOST_ERRORS_TARGET_PATH, text: text})
        .Err(error) -> problems.push(error.message)
    }
    loop output in outputs {
        current: output_current(output.path, output.text) ?? return Err(err)
        if current -> next
        if check {
            problems.push("{output.path} is stale; run jet Tools/agent/RuntimeGenerators.jet")
        } else {
            write_output(output.path, output.text) ?? return Err(err)
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    if check -> return Ok("runtime generated tables are current")
    Ok("")
}

// `lifecycle FILE...` (`args` with its mode word): the lifecycle.list of
// exactly those runtime sources, without its final newline. A FILE `-` is
// the source text on stdin.
unit_lifecycle_list: fn(args: [String]) -[FS, IO]> String GeneratorError! {
    if args.len() < 2 -> return Err(generator_fail(USAGE))
    problems := [String]{}
    sources := [RuntimeSource]{}
    loop at in 1..<args.len() {
        path: args[at]
        if path == "-" {
            if term.read_all_input() == {
                .Ok(text) -> sources.push(RuntimeSource{path: "stdin", text: text})
                .Err(error) -> problems.push("cannot read stdin: {error}")
            }
            next
        }
        if files.read(path) == {
            .Ok(text) -> sources.push(RuntimeSource{path: path.copy(), text: text}) // copy: `args` keeps its rows
            .Err(error) -> problems.push("cannot read {path}: {error}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    list: lifecycle_list(sources) ?? return Err(err)
    list.removesuffix("\n")
}

// `exports`: `SYMBOL<TAB>FILE` for each runtime #Export(c) function, in
// sources.list order.
runtime_export_files: fn() -[FS]> String GeneratorError! {
    sources: read_runtime_sources() ?? return Err(err)
    rows := [String]{}
    loop export in placed_exports(sources) ?? return Err(err) -> rows.push("{export.name}\t{export.path}")
    rows.join("\n")
}

run: fn() {
    if runtime_generators_main(process.args()) == {
        .Ok(message) -> {
            if message != "" -> print(message)
        }
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// Heap-free runtime literals are process-static texts or little-endian 64-bit
// words, so the runtime never builds a String or an exact Int to print them.
// Every output's first line names this file as its one generator.

#Error
GeneratorError: struct {
    message: String
}

generator_fail: fn(message: String) -> GeneratorError Never! {
    GeneratorError{message: message}
}

// One named literal of a generated table.
MessageLiteral: struct {
    name: String
    text: String
}

// A word of a literal: its byte offset, signed value, and byte count (1-8).
TextWord: struct {
    offset: Int
    value: Int
    count: Int
}

// Bytes `start..<end` of `text`. String.find reports UTF-8 byte offsets, so
// every offset it returns is sliced here, never with String.slice.
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

// The little-endian signed machine word of bytes `start..<end` (at most 8). A
// signed literal preserves all eight bytes: only the eighth byte carries the
// sign, with weight 2^56.
packed_word: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    word := 0
    scale := 1
    loop index in start..<end {
        byte: Int.from_u8(bytes[index])
        if index - start == 7 && byte >= 128 {
            word += (byte - 256) * scale
        } else {
            word += byte * scale
        }
        if index - start < 7 -> scale *= 256
    }
    word
}

text_words: fn(text: String) -> [TextWord] Never! {
    bytes: text.bytes()
    words := [TextWord]{}
    at := 0
    loop at < bytes.len() {
        end: if at + 8 < bytes.len() -> at + 8 else -> bytes.len()
        words.push(TextWord{offset: at, value: packed_word(bytes, at, end), count: end - at})
        at += 8
    }
    words
}

#Test("words are little-endian and keep the eighth byte's sign") {
    words: text_words("abcdefghé")
    assert_eq(words.len(), 2)
    assert_eq(words[0].value, 7523094288207667809)
    assert_eq(words[0].count, 8)
    assert_eq(words[1].offset, 8)
    assert_eq(words[1].value, 43459)
    assert_eq(words[1].count, 2)
    high: text_words("éééé")
    assert_eq(high[0].count, 8)
    assert(high[0].value < 0)
}

// Diagnostic registry prose, read from Registry/DiagnosticRows.jet: the
// registry stays the one source of a runtime row's words.

REGISTRY_PATH: "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet"

// The value of the quoted literal that starts at `text`'s first byte (a `"`),
// and the byte length of its source spelling.
QuotedLiteral: struct {
    value: String
    spelling_len: Int
}

quoted_literal: fn(text: String) -> QuotedLiteral? Never! {
    bytes: text.bytes()
    if bytes.len() == 0 || Int.from_u8(bytes[0]) != 34 -> return None
    out := [U8]{}
    index := 1
    loop index < bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 34 -> return Val(QuotedLiteral{value: String.from_bytes_lossy(out), spelling_len: index + 1})
        if code == 92 {
            if index + 1 >= bytes.len() -> return None
            escaped: Int.from_u8(bytes[index + 1])
            if {
                escaped == 34 || escaped == 92 -> out.push(bytes[index + 1])
                escaped == 110 -> out.push(U8.from_int(10) ?? return None)
                escaped == 116 -> out.push(U8.from_int(9) ?? return None)
                escaped == 114 -> out.push(U8.from_int(13) ?? return None)
                else -> return None
            }
            index += 2
            next
        }
        out.push(bytes[index])
        index += 1
    }
    None
}

// The `name` field of the registry row for `code`, as written (`{{` kept).
registry_field_raw: fn(registry: String, code: String, name: String) -> String GeneratorError! {
    marker: "\n        code: \"{code}\","
    start: registry.find(marker)
    if start < 0 -> return Err(generator_fail("missing runtime row {code}"))
    before: byte_slice(registry, 0, start)
    if !before.ends_with("DiagnosticRegistryRow{{") && !before.ends_with("\n    {{") -> return Err(generator_fail("missing runtime row {code}"))
    rest: byte_tail(registry, start + byte_len(marker))
    end := byte_len(rest)
    next_named: rest.find("DiagnosticRegistryRow{{")
    if next_named >= 0 && next_named < end -> end = next_named
    next_plain: rest.find("\n    {{\n        code:")
    if next_plain >= 0 && next_plain < end -> end = next_plain
    row: byte_slice(rest, 0, end)
    field_marker: "\n        {name}: "
    at: row.find(field_marker)
    if at < 0 -> return Err(generator_fail("missing {code}.{name}"))
    after: byte_tail(row, at + byte_len(field_marker))
    literal: quoted_literal(after) ?? return Err(generator_fail("missing {code}.{name}"))
    if !byte_tail(after, literal.spelling_len).starts_with(",") -> return Err(generator_fail("missing {code}.{name}"))
    Ok(literal.value)
}

// The field's text: a template's `{{`/`}}` read as single braces.
registry_field: fn(registry: String, code: String, name: String) -> String GeneratorError! {
    raw: registry_field_raw(registry, code, name) ?? return Err(err)
    Ok(raw.replace("{{{{", "{{").replace("}}}}", "}}"))
}

// Text before / after the first `{msg}` hole of an unescaped template.
before_hole: fn(text: String) -> String Never! {
    at: text.find("{{msg}}")
    if at < 0 -> text else -> byte_slice(text, 0, at)
}

after_hole: fn(text: String) -> String Never! {
    at: text.find("{{msg}}")
    if at < 0 -> "" else -> byte_tail(text, at + byte_len("{{msg}}"))
}

// The runtime's fixed message tables: scheduler, observe, test-reporter and
// services literals, each written as words so the runtime unit never needs an
// implicit String or Int carrier to produce them.

SCHEDULER_TARGET_PATH: "Compiler/JetRuntime/Source/SchedulerMessages.jet"
OBSERVE_TARGET_PATH: "Compiler/JetRuntime/Source/ObserveMessages.jet"
TEST_TARGET_PATH: "Compiler/JetRuntime/Source/TestMessages.jet"
SERVICES_TARGET_PATH: "Compiler/JetRuntime/Source/ServicesMessages.jet"
TEST_ORDINARY_FAILURE: "__jet_test_ordinary_failure__"

// Literals longer than two words are one process-static text, which costs
// less than the words that would store or push them.
static_text_worthy: fn(text: String) -> Bool Never! { byte_len(text) > 16 }

// `text` as an `rt_static_text("…")` literal of the runtime source.
static_text: fn(text: String) -> String GeneratorError! {
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code <= 9 || (code >= 11 && code <= 31) || code == 127 -> return Err(generator_fail("control byte in runtime static text {text}"))
    }
    body: text.replace("\\", "\\\\").replace("\"", "\\\"").replace("{{", "{{{{").replace("}}", "}}}}").replace("\n", "\\n")
    Ok("rt_static_text(\"{body}\")")
}

// Owned E4 text: a sized text object whose data is copied from one static
// text, or whose data words are stored in place.
owned_text_function: fn(name: String, text: String) -> String GeneratorError! {
    out := "\n{name}: fn() -> I64 {{\n    text: scheduler_text_new(I64{{{byte_len(text)}}})\n    data: sync_load(text)\n"
    if static_text_worthy(text) {
        literal: static_text(text) ?? return Err(err)
        out = "{out}    coll_copy(rt_text_data({literal}), data, I64{{{byte_len(text)}}})\n"
    } else {
        loop word in text_words(text) -> out = "{out}    sync_store(wrapping(data + I64{{{word.offset}}}), I64{{{word.value}}})\n"
    }
    Ok("{out}    text\n}}\n")
}

// Words appended to a text builder or written to a descriptor by `sink`.
word_writes: fn(target: String, sink: String, text: String) -> String Never! {
    out := ""
    loop word in text_words(text) -> out = "{out}    {sink}({target}, I64{{{word.value}}}, I64{{{word.count}}})\n"
    out
}

// The body of a builder appender: one static-text push, or word pushes.
builder_writes: fn(target: String, text: String) -> String GeneratorError! {
    if !static_text_worthy(text) -> return Ok(word_writes(target, "rt_text_push_word", text))
    literal: static_text(text) ?? return Err(err)
    Ok("    jet_rt_string_builder_push({target}, {literal})\n")
}

// Scheduler literals have no implicit String/Int carrier in the runtime unit.
// The E3003 deadline report is its registry row: `head` and `tail` are its
// What around the wait kind, and the tail carries its Why and Fix.
scheduler_literals: fn(deadline_head: String, deadline_tail: String) -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "threads", text: "JET_SCHEDULER_THREADS"},
        MessageLiteral{name: "replay", text: "JET_PROVE_REPLAY_TIME_MS"},
        MessageLiteral{name: "epoch", text: "LEX_TEST_EPOCH"},
        MessageLiteral{name: "pause", text: "task pause"},
        MessageLiteral{name: "join", text: "task join"},
        MessageLiteral{name: "sleep", text: "time sleep"},
        MessageLiteral{name: "yield", text: "task yield"},
        MessageLiteral{name: "shield", text: "shield exit"},
        MessageLiteral{name: "admission", text: "task admission"},
        MessageLiteral{name: "selection", text: "task selection"},
        MessageLiteral{name: "deadline_head", text: deadline_head},
        MessageLiteral{name: "deadline_tail", text: deadline_tail},
        MessageLiteral{name: "cancelled", text: "task cancelled at a cooperative wait point"},
        MessageLiteral{name: "trace_head", text: "paused="},
        MessageLiteral{name: "trace_mid", text: ",cancel="},
        MessageLiteral{name: "yes", text: "true"},
        MessageLiteral{name: "no", text: "false"},
        MessageLiteral{name: "separator", text: ": "},
        MessageLiteral{name: "start_failed", text: "could not start scheduler worker"},
        MessageLiteral{name: "completion_exhausted", text: "task completion order exhausted"},
        MessageLiteral{name: "rt_rate", text: "real-time callback rate must be positive"},
        MessageLiteral{name: "rt_frames", text: "real-time callback frame count must be positive"},
        MessageLiteral{name: "rt_native_range", text: "native Int argument exceeds host range"},
        MessageLiteral{name: "rt_capacity", text: "capacity overflow"},
        MessageLiteral{name: "rt_ring_frames", text: "real-time sample ring needs a positive frame count"},
        MessageLiteral{name: "rt_self_join", text: "failed to join real-time worker: Resource deadlock avoided"},
        MessageLiteral{name: "rt_join_failed", text: "failed to join real-time worker"},
        MessageLiteral{name: "rt_start_failed", text: "failed to spawn real-time worker"},
    }
}

render_scheduler_messages: fn(registry: String) -> String GeneratorError! {
    what: registry_field(registry, "E3003", "what") ?? return Err(err)
    why: registry_field_raw(registry, "E3003", "why") ?? return Err(err)
    fix: registry_field_raw(registry, "E3003", "fix") ?? return Err(err)
    hole: "{{wait_kind}}"
    at: what.find(hole)
    if at < 0 -> return Err(generator_fail("E3003's What has no {hole} hole"))
    head: "Error [E3003]: {byte_slice(what, 0, at)}"
    tail: "{byte_tail(what, at + byte_len(hole))}\n Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/E3003"
    source := "// Generated by Tools/agent/RuntimeGenerators.jet; UTF-8 E4 literals.\n"
    loop literal in scheduler_literals(head, tail) {
        function: owned_text_function("scheduler_msg_{literal.name}", literal.text) ?? return Err(err)
        source = "{source}{function}"
    }
    Ok(source)
}

// Observe fragments append directly to the canonical E4 builder, without
// allocating an intermediate String for each fixed diagnostic/path fragment.
observe_literals: fn(what: String, why: String, fix: String) -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "task_label", text: "task@"},
        MessageLiteral{name: "task_fallback", text: "task #"},
        MessageLiteral{name: "site", text: " (spawn site "},
        MessageLiteral{name: "close_site", text: ")"},
        MessageLiteral{name: "blocked", text: "blocked"},
        MessageLiteral{name: "entry", text: "\n  "},
        MessageLiteral{name: "report_site", text: " (spawn site "},
        MessageLiteral{name: "report_state", text: ")\n    state: "},
        MessageLiteral{name: "report_wait", text: "\n    wait target: "},
        MessageLiteral{name: "unknown", text: "unknown"},
        MessageLiteral{name: "omitted_head", text: "\n  ... "},
        MessageLiteral{name: "omitted_tail", text: " more parked task(s) omitted by the report limit ..."},
        MessageLiteral{name: "report_head", text: "Stop [E3013]: {before_hole(what)}"},
        MessageLiteral{name: "report_tail", text: "{after_hole(what)}\n Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/E3013\n"},
        MessageLiteral{name: "path_head", text: "jet-observe-"},
        MessageLiteral{name: "path_tail", text: ".json"},
        MessageLiteral{name: "stage_head", text: ".jet-observe-"},
        MessageLiteral{name: "stage_tail", text: ".tmp"},
        MessageLiteral{name: "root_label", text: "root"},
        MessageLiteral{name: "env_observe", text: "JET_OBSERVE"},
        MessageLiteral{name: "env_session", text: "JET_DEVTOOLS_RELAY_SESSION_ID"},
        MessageLiteral{name: "env_source", text: "JET_DEVTOOLS_RELAY_SOURCE_ID"},
        MessageLiteral{name: "env_build", text: "JET_DEVTOOLS_RELAY_BUILD_ID"},
        MessageLiteral{name: "env_revision", text: "JET_DEVTOOLS_RELAY_REVISION"},
        MessageLiteral{name: "env_world", text: "JET_DEVTOOLS_RELAY_WORLD_ID"},
        MessageLiteral{name: "env_tmpdir", text: "TMPDIR"},
        MessageLiteral{name: "default_tmpdir", text: "/tmp"},
    }
}

render_observe_messages: fn(registry: String) -> String GeneratorError! {
    what: registry_field(registry, "E3013", "what") ?? return Err(err)
    why: registry_field_raw(registry, "E3013", "why") ?? return Err(err)
    fix: registry_field_raw(registry, "E3013", "fix") ?? return Err(err)
    source := "// Generated by Tools/agent/RuntimeGenerators.jet; direct E4 builder fragments.\n"
    loop literal in observe_literals(what, why, fix) {
        body: builder_writes("target", literal.text) ?? return Err(err)
        source = "{source}\nobserve_msg_{literal.name}: fn(target: I64) {{\n{body}}}\n"
    }
    Ok(source)
}

// Fixed-width, heap-free literals for the native unit-test reporter.
test_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "invalid", text: "internal error: native test record is invalid\n"},
        MessageLiteral{name: "pass", text: "pass"},
        MessageLiteral{name: "fail", text: "FAIL"},
        MessageLiteral{name: "skip", text: "skip"},
        MessageLiteral{name: "expected", text: "expected-fail"},
        MessageLiteral{name: "unexpected", text: "UNEXPECTED-PASS (remove expected_fail: true)"},
        MessageLiteral{name: "passed", text: " passed, "},
        MessageLiteral{name: "failed", text: " failed, "},
        MessageLiteral{name: "skipped", text: " skipped"},
        MessageLiteral{name: "expected_count", text: " expected-fail"},
        MessageLiteral{name: "unexpected_count", text: " unexpected-pass"},
        MessageLiteral{name: "shuffle", text: "shuffle: seed="},
        MessageLiteral{name: "json_schema", text: "{{\"schema\":\"jet.test.v1\",\"ok\":"},
        MessageLiteral{name: "json_passed", text: ",\"passed\":"},
        MessageLiteral{name: "json_failed", text: ",\"failed\":"},
        MessageLiteral{name: "json_skipped", text: ",\"skipped\":"},
        MessageLiteral{name: "json_expected", text: ",\"expectedFailures\":"},
        MessageLiteral{name: "json_unexpected", text: ",\"unexpectedPasses\":"},
        MessageLiteral{name: "json_tests", text: ",\"tests\":["},
        MessageLiteral{name: "json_name", text: "{{\"name\":"},
        MessageLiteral{name: "json_ok", text: ",\"ok\":"},
        MessageLiteral{name: "json_expectation", text: ",\"expectedFailure\":"},
        MessageLiteral{name: "json_skip", text: ",\"skipped\":"},
        MessageLiteral{name: "json_stdout", text: ",\"stdout\":"},
        MessageLiteral{name: "json_stderr", text: ",\"stderr\":"},
        MessageLiteral{name: "true", text: "true"},
        MessageLiteral{name: "false", text: "false"},
    }
}

// Environment keys are owned E4 text, borrowed only for the existing host leaf.
test_key_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "json", text: "JET_TEST_JSON"},
        MessageLiteral{name: "capture", text: "JET_TEST_CAPTURE"},
        MessageLiteral{name: "shuffle", text: "JET_TEST_SHUFFLE_SEED"},
    }
}

// Test-scope diagnostics use owned E4 builders, sharing these fixed-width
// literal appenders with the reporter.
test_scope_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "expected", text: "expected "},
        MessageLiteral{name: "region_stop", text: "this region to stop with "},
        MessageLiteral{name: "region_fail", text: "this region to fail"},
        MessageLiteral{name: "stop_code", text: "a stop with "},
        MessageLiteral{name: "stop_message", text: "a stop whose message contains "},
        MessageLiteral{name: "code_message", text: " whose message contains "},
        MessageLiteral{name: "passed", text: ", but it passed"},
        MessageLiteral{name: "got", text: ", got "},
        MessageLiteral{name: "colon", text: ": "},
        MessageLiteral{name: "timeout", text: "timeout: region took "},
        MessageLiteral{name: "timeout_limit", text: "ns, limit was "},
        MessageLiteral{name: "ns", text: "ns"},
    }
}

render_test_messages: fn() -> String GeneratorError! {
    source := "// Generated by Tools/agent/RuntimeGenerators.jet; do not hand-edit.\n// Little-endian UTF-8 stack writes never construct a Rust String or exact Int.\n\n"
    loop literal in test_literals() {
        if static_text_worthy(literal.text) {
            text: static_text(literal.text) ?? return Err(err)
            source = "{source}test_msg_{literal.name}: fn(fd: I64) {{\n    text: {text}\n    test_write(fd, rt_text_data(text), rt_text_len(text))\n}}\n\n"
        } else {
            source = "{source}test_msg_{literal.name}: fn(fd: I64) {{\n{word_writes("fd", "test_write_word", literal.text)}}}\n\n"
        }
    }
    loop literal in test_key_literals() {
        bytes: literal.text.bytes()
        source = "{source}test_key_{literal.name}: fn() -> I64 {{\n    text: test_text_new(I64{{{bytes.len()}}})\n    data: trap_word(text)\n"
        loop index in 0..<bytes.len() -> source = "{source}    trap_put(wrapping(data + I64{{{index}}}), I64{{{Int.from_u8(bytes[index])}}})\n"
        source = "{source}    text\n}}\n\n"
    }
    loop literal in test_scope_literals() {
        body: builder_writes("builder", literal.text) ?? return Err(err)
        source = "{source}test_scope_msg_{literal.name}: fn(builder: I64) {{\n{body}}}\n\n"
    }
    ordinary: TEST_ORDINARY_FAILURE.bytes()
    source = "{source}test_scope_ordinary: fn(text: I64) -> Bool {{\n    if (text == I64{{0}}) {{ return false }}\n    if (trap_word(wrapping(text + I64{{8}})) != I64{{{ordinary.len()}}}) {{ return false }}\n    data: trap_word(text)\n"
    loop index in 0..<ordinary.len() -> source = "{source}    if (trap_byte(wrapping(data + I64{{{index}}})) != I64{{{Int.from_u8(ordinary[index])}}}) {{ return false }}\n"
    Ok("{source}    true\n}}\n\n")
}

// Controlled-world and sentry literals use the runtime's existing E4 ABI.
services_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "world_backwards", text: "deterministic world cannot move time backwards; advance requires a non-negative duration"},
        MessageLiteral{name: "world_exhausted", text: "deterministic world clock exhausted its supported range"},
        MessageLiteral{name: "world_budget", text: "deterministic world execution budget exhausted while waiting for idle"},
        MessageLiteral{name: "world_live", text: "deterministic world scope exited with live descendants; cancel and join every task"},
        MessageLiteral{name: "world_overflow", text: "deterministic world timer overflowed"},
        MessageLiteral{name: "world_nested", text: "deterministic world nesting is ambiguous; use the parent world explicitly"},
        MessageLiteral{name: "world_sleep", text: "deterministic world sleep requires a controlled scheduler task"},
        MessageLiteral{name: "world_network", text: "deterministic world has no controlled network provider"},
        MessageLiteral{name: "world_foreign", text: "deterministic world has no controlled foreign provider"},
        MessageLiteral{name: "world_entropy", text: "deterministic world has no controlled entropy provider"},
        MessageLiteral{name: "world_clock", text: "deterministic world has no controlled clock provider"},
        MessageLiteral{name: "world_external", text: "deterministic world has no controlled external-effect provider"},
        MessageLiteral{name: "spawn", text: "task:spawn"},
        MessageLiteral{name: "finish", text: "task:finish"},
        MessageLiteral{name: "advance", text: "advance:"},
        MessageLiteral{name: "timer", text: "timer:"},
        MessageLiteral{name: "register", text: "timer:register:"},
        MessageLiteral{name: "rng", text: "rng:"},
        MessageLiteral{name: "seed", text: "rng:seed:"},
        MessageLiteral{name: "colon", text: ":"},
        MessageLiteral{name: "lf", text: "\n"},
        MessageLiteral{name: "sentry_location", text: "  --> "},
        MessageLiteral{name: "sentry_gate", text: ", in #Unsafe gate "},
        MessageLiteral{name: "sentry_read", text: "read"},
        MessageLiteral{name: "sentry_valid_ptr", text: "valid_ptr"},
        MessageLiteral{name: "sentry_why", text: " Why: "},
        MessageLiteral{name: "sentry_fix", text: "\n Fix: "},
        MessageLiteral{name: "sentry_obligation", text: "\nobligation: valid_ptr = false\n"},
        MessageLiteral{name: "sentry_foreign", text: "foreign: "},
        MessageLiteral{name: "sentry_fenced", text: " = fenced\n"},
        MessageLiteral{name: "sentry_unfenced", text: " = unfenced\n"},
        MessageLiteral{name: "sentry_exit", text: "exit: "},
        MessageLiteral{name: "sentry_footer1", text: "More: jet-lang.dev/e/R0801\n"},
        MessageLiteral{name: "sentry_footer2", text: "More: jet-lang.dev/e/R0802\n"},
        MessageLiteral{name: "sentry_footer3", text: "More: jet-lang.dev/e/R0803\n"},
        MessageLiteral{name: "sentry_provenance", text: "no live allocation contains this address"},
        MessageLiteral{name: "sentry_bounds", text: "the foreign access extends beyond a live allocation"},
        MessageLiteral{name: "sentry_heap", text: "the address belongs to quarantined storage"},
        MessageLiteral{name: "sentry_stack", text: "the owning Jet frame has expired"},
        MessageLiteral{name: "sentry_address", text: "address 0x"},
        MessageLiteral{name: "sentry_alignment", text: " is not aligned to "},
        MessageLiteral{name: "sentry_bytes", text: " bytes"},
        MessageLiteral{name: "ledger_key", text: "JET_MEMORY_LEDGER"},
        MessageLiteral{name: "ledger_default", text: ".jet/memory/ledger-v1.jsonl"},
        MessageLiteral{name: "ledger_head", text: "{{\"schema\":\"jet.memory.ledger\",\"version\":1,\"kind\":\"sentry\",\"code\":\"R080"},
        MessageLiteral{name: "ledger_source", text: "\",\"source\":"},
        MessageLiteral{name: "ledger_start", text: ",\"span_start\":"},
        MessageLiteral{name: "ledger_end", text: ",\"span_end\":"},
        MessageLiteral{name: "ledger_scope", text: ",\"byte_spans\":false,\"scope\":"},
        MessageLiteral{name: "ledger_provenance", text: ",\"provenance\":\"source #Unsafe gate\",\"detail\":"},
        MessageLiteral{name: "ledger_repairs", text: ",\"expected\":null,\"repairs\":"},
        MessageLiteral{name: "ledger_repairs1", text: "[\"derive the pointer from live storage inside this gate\",\"remove the raw access\"]}}\n"},
        MessageLiteral{name: "ledger_repairs2", text: "[\"move the raw access before the storage is released\",\"replace the raw pointer with an owned value\"]}}\n"},
        MessageLiteral{name: "ledger_repairs3", text: "[\"derive an aligned pointer from the live allocation\",\"use the typed memory operation instead of raw address arithmetic\"]}}\n"},
    }
}

render_services_messages: fn(registry: String) -> String GeneratorError! {
    literals := services_literals()
    loop code in ["R0801", "R0802", "R0803"] {
        loop field in ["what", "why", "fix"] {
            text: registry_field(registry, code, field) ?? return Err(err)
            literals.push(MessageLiteral{name: "sentry_{code.lower()}_{field}", text: text})
        }
    }
    source := "// Generated by Tools/agent/RuntimeGenerators.jet; owned E4 literals.\n"
    loop literal in literals {
        function: owned_text_function("services_msg_{literal.name}", literal.text) ?? return Err(err)
        source = "{source}{function}"
    }
    Ok(source)
}

// Heap-free runtime stop literals. Keep the active diagnostic registry as the
// source of row prose; emitted words use the audited stack-write OS leaf.

TRAP_TARGET_PATH: "Compiler/JetRuntime/Source/TrapMessages.jet"
TRAP_DEFECT_TARGET_PATH: "Compiler/JetRuntime/Source/TrapDefectMessages.jet"
ROUTES_PATH: "Compiler/JetIR/Source/RouteCarriers.jet"
DEBUG_PATH: "Compiler/JetFoundation/Source/Text/RustDebug.jet"

// The native TLS refusal is defined once, in the IR route table that reports it at
// compile time; the runtime's stop and String-error leaves use this projection.
native_tls_refusal: fn(routes: String) -> String GeneratorError! {
    marker: "\nir_tls_transport_message: fn() -> String Never! {{\n    "
    at: routes.find(marker)
    if at < 0 -> return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    rest: byte_slice(routes, at + byte_len(marker), byte_len(routes))
    literal: quoted_literal(rest) ?? return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    if !String.from_bytes_lossy(rest.bytes()[literal.spelling_len..<rest.bytes().len()]).starts_with("\n}}") -> return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    if literal.value == "" -> return Err(generator_fail("native TLS refusal must be printable ASCII for word projection"))
    loop byte in literal.value.bytes() {
        code: Int.from_u8(byte)
        if code < 32 || code > 126 -> return Err(generator_fail("native TLS refusal must be printable ASCII for word projection"))
    }
    Ok(literal.value)
}

// One writing function for `text`; ordinary stack-word rows also get the
// matching `trap_build_*` appender into an owned text builder. An ordinary
// literal longer than two words is one static text (`<name>_text`, which
// hand-written reports reuse) written in one call; host-defect rows are
// always stack words.
emit: fn(name: String, text: String, sink: String) -> String GeneratorError! {
    if sink == "trap_write_word" && static_text_worthy(text) {
        literal: static_text(text) ?? return Err(err)
        return Ok("{name}_text: fn() -> I64 {{ {literal} }}\n\n{name}: fn() {{ trap_write_static({name}_text()) }}\n\ntrap_build_{byte_tail(name, 5)}: fn(builder: I64) {{ jet_rt_string_builder_push(builder, {name}_text()) }}\n")
    }
    out := "{name}: fn() {{\n"
    owned := "trap_build_{byte_tail(name, 5)}: fn(builder: I64) {{\n"
    loop word in text_words(text) {
        out = "{out}    {sink}(I64{{{word.value}}}, I64{{{word.count}}})\n"
        if sink == "trap_write_word" -> owned = "{owned}    rt_text_push_word(builder, I64{{{word.value}}}, I64{{{word.count}}})\n"
    }
    if sink == "trap_write_word" -> return Ok("{out}}}\n\n{owned}}}\n")
    Ok("{out}}}\n")
}

// The canonical Rust Debug escaped-interval table, as numbers.
debug_intervals: fn(debug: String) -> [Int] GeneratorError! {
    open: debug.find("[Int]{{")
    if open < 0 -> return Err(generator_fail("missing Rust Debug scalar interval table"))
    rest: byte_slice(debug, open + byte_len("[Int]{{"), byte_len(debug))
    // The body runs to the first `}` followed by optional space and `}`.
    body_end := -1
    search := 0
    loop {
        close: byte_slice(rest, search, byte_len(rest)).find("}}")
        if close < 0 -> break
        at: search + close
        after: byte_slice(rest, at + 1, byte_len(rest)).trim_start()
        if after.starts_with("}}") {
            body_end = at
            break
        }
        search = at + 1
    }
    if body_end < 0 -> return Err(generator_fail("missing Rust Debug scalar interval table"))
    values := [Int]{}
    current := -1
    loop byte in byte_slice(rest, 0, body_end).bytes() {
        code: Int.from_u8(byte)
        if code >= 48 && code <= 57 {
            current = if current < 0 -> code - 48 else -> current * 10 + code - 48
        } else if current >= 0 {
            values.push(current)
            current = -1
        }
    }
    if current >= 0 -> values.push(current)
    if values.len() % 2 != 0 -> return Err(generator_fail("invalid Rust Debug intervals"))
    loop index in 1..<values.len() {
        if values[index] < values[index - 1] -> return Err(generator_fail("invalid Rust Debug intervals"))
    }
    Ok(values)
}

TrapOutputs: struct {
    source: String
    defects: String
}

render_trap_messages: fn(registry: String, routes: String, debug: String) -> TrapOutputs GeneratorError! {
    source := "// Generated by Tools/agent/RuntimeGenerators.jet; do not hand-edit.\n// Process-static texts and little-endian UTF-8 word constants. No heap String,\n// allocation, mutable global, or numeric runtime is reached while writing these rows.\n\n"
    loop code in ["E3001", "E3010", "E3011", "E0128"] {
        why: registry_field(registry, code, "why") ?? return Err(err)
        fix: registry_field(registry, code, "fix") ?? return Err(err)
        source = "{source}// {code} Why: {why}\n// Fix: {fix}\n"
        footer: emit("trap_footer_{code.lower()}", " Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{code}\n", "trap_write_word") ?? return Err(err)
        source = "{source}{footer}\n"
    }
    // A failed `#Pre`/`#Post` clause (Trap.jet trap_contract_stop): the row's
    // Why quotes the stop's own message at `{msg}`, so it is written in two
    // pieces around that message.
    contract_why: registry_field(registry, "E3005", "why") ?? return Err(err)
    contract_fix: registry_field(registry, "E3005", "fix") ?? return Err(err)
    hole: contract_why.find("{{msg}}")
    if hole < 0 || after_hole(contract_why).find("{{msg}}") >= 0 -> return Err(generator_fail("E3005.why must quote {{msg}} exactly once"))
    source = "{source}// E3005 Why: {contract_why}\n// Fix: {contract_fix}\n"
    contract_head: emit("trap_footer_e3005_head", " Why: {before_hole(contract_why)}", "trap_write_word") ?? return Err(err)
    contract_tail: emit("trap_footer_e3005_tail", "{after_hole(contract_why)}\n Fix: {contract_fix}\nMore: jet-lang.dev/e/E3005\n", "trap_write_word") ?? return Err(err)
    source = "{source}{contract_head}\n{contract_tail}\n"
    e3001_what: registry_field(registry, "E3001", "what") ?? return Err(err)
    e3010_what: registry_field(registry, "E3010", "what") ?? return Err(err)
    e0128_what: registry_field(registry, "E0128", "what") ?? return Err(err)
    layout_what: if e3001_what.find("{{msg}}") < 0 -> e3001_what else -> "{before_hole(e3001_what)}invalid box layout{after_hole(e3001_what)}"
    layout: emit("trap_invalid_layout_head", "Stop [E3001]: {layout_what}\n  --> <core.prelude>:0\n", "trap_write_word") ?? return Err(err)
    source = "{source}{layout}"
    tls: native_tls_refusal(routes) ?? return Err(err)
    // A host stop whose code has no active runtime row is a Jet defect, not a
    // diagnostic: no row speaks for it, so it prints one `internal error:`
    // line with no Why, Fix or More. The code word sits between these two literals.
    loop code in ["E2805"] {
        stage: registry_field(registry, code, "stage") ?? return Err(err)
        if stage.contains("runtime") -> return Err(generator_fail("{code} is an active runtime row; its stop renders the row, not the host form"))
    }
    // Core library stops that carry a registered code (core.rt.__coded_stop,
    // Trap.jet jet_rt_coded_stop): the caller renders the row's `what`; the
    // footer is the same row's Why/Fix. Codes are five-byte little-endian words.
    coded_stops: ["E2804", "E2805"]
    registered := [String]{}
    branches := ""
    loop code in coded_stops {
        if byte_len(code) != 5 || !code.starts_with("E") -> return Err(generator_fail("{code} is not a five-byte diagnostic code"))
        why: registry_field(registry, code, "why") ?? return Err(err)
        fix: registry_field(registry, code, "fix") ?? return Err(err)
        source = "{source}\n// {code} Why: {why}\n// Fix: {fix}\n"
        footer: emit("trap_footer_{code.lower()}", " Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{code}\n", "trap_write_word") ?? return Err(err)
        source = "{source}{footer}"
        word := 0
        scale := 1
        loop byte in code.bytes() {
            word += Int.from_u8(byte) * scale
            scale *= 256
        }
        registered.push("code == I64{{{word}}}")
        if code != coded_stops[coded_stops.len() - 1] -> branches = "{branches}        (code == I64{{{word}}}) -> trap_footer_{code.lower()}()\n"
    }
    last_coded: coded_stops[coded_stops.len() - 1].lower()
    source = "{source}\ntrap_coded_registered: fn(code: I64) -> Bool {{\n    {registered.join(" || ")}\n}}\n"
    source = "{source}\ntrap_coded_footer: fn(code: I64) {{\n    if {{\n{branches}        else -> trap_footer_{last_coded}()\n    }}\n}}\n"
    literals: [MessageLiteral]{
        MessageLiteral{name: "header_panic", text: "Stop [E3001]: {before_hole(e3001_what)}"},
        MessageLiteral{name: "header_numeric", text: "Stop [E3010]: {before_hole(e3010_what)}"},
        MessageLiteral{name: "header_todo", text: "Stop [E3011]: `"},
        MessageLiteral{name: "header_contract", text: "Stop [E3005]: "},
        MessageLiteral{name: "header_zip", text: "Stop [E0128]: {before_hole(e0128_what)}"},
        MessageLiteral{name: "zip_end", text: "{after_hole(e0128_what)}\n"},
        MessageLiteral{name: "collections_end", text: "`\n  --> <core.collections>:0\n"},
        MessageLiteral{name: "sequence_count", text: "sequence count must be nonnegative"},
        MessageLiteral{name: "sequence_step", text: "step_by requires a positive step"},
        MessageLiteral{name: "sequence_chunks", text: "chunks requires a positive size"},
        MessageLiteral{name: "sequence_windows", text: "windows requires a positive size"},
        MessageLiteral{name: "cursor_step", text: "iterator loop stride must be positive"},
        MessageLiteral{name: "cursor_exhausted", text: "iterator loop value requested after exhaustion"},
        MessageLiteral{name: "location", text: "  --> "},
        MessageLiteral{name: "colon", text: ":"},
        MessageLiteral{name: "in_function", text: " in "},
        MessageLiteral{name: "newline", text: "\n"},
        MessageLiteral{name: "space", text: " "},
        MessageLiteral{name: "gutter_line", text: "|\n"},
        MessageLiteral{name: "gutter_source", text: " | "},
        MessageLiteral{name: "gutter_caret", text: "| "},
        MessageLiteral{name: "caret", text: "^"},
        MessageLiteral{name: "message_end", text: "`\n"},
        MessageLiteral{name: "prelude_end", text: "`\n  --> <core.prelude>:0\n"},
        MessageLiteral{name: "overflow", text: "This arithmetic overflows the value's type (the result is outside its range)"},
        MessageLiteral{name: "divide_zero", text: "divided by zero"},
        MessageLiteral{name: "native_index_range", text: "native Int argument exceeds host range"},
        MessageLiteral{name: "list_head", text: "the list has "},
        MessageLiteral{name: "list_item", text: " item"},
        MessageLiteral{name: "list_plural", text: "s"},
        MessageLiteral{name: "list_position", text: ", so position "},
        MessageLiteral{name: "list_end", text: " doesn't exist`\n  --> <core.prelude>:0\n"},
        // `bounds: report` (JetRuntime jet_rt_report_list_bounds): the failed
        // check's line, then its file and line; the program goes on.
        MessageLiteral{name: "report_list_head", text: "bounds report: the list has "},
        MessageLiteral{name: "report_list_at", text: " doesn't exist ("},
        MessageLiteral{name: "report_list_end", text: ")\n"},
        MessageLiteral{name: "unreachable", text: "internal error: entered unreachable code: "},
        MessageLiteral{name: "locals", text: "locals: "},
        MessageLiteral{name: "todo", text: "#Todo at "},
        MessageLiteral{name: "todo_expected", text: " — expected "},
        MessageLiteral{name: "expected", text: "expected: "},
        MessageLiteral{name: "got", text: ", got: "},
        MessageLiteral{name: "range_head", text: "can't "},
        MessageLiteral{name: "range_slice", text: "slice"},
        MessageLiteral{name: "range_view", text: "view"},
        MessageLiteral{name: "range_items", text: " items from "},
        MessageLiteral{name: "range_to", text: " to "},
        MessageLiteral{name: "range_open", text: " ("},
        MessageLiteral{name: "exclusive", text: "exclusive"},
        MessageLiteral{name: "inclusive", text: "inclusive"},
        MessageLiteral{name: "range_end", text: ")`\n"},
        MessageLiteral{name: "native_tls", text: tls},
        MessageLiteral{name: "inactive_row_head", text: "internal error: runtime stop `"},
        MessageLiteral{name: "inactive_row_tail", text: "` has no active runtime row, so Jet cannot report it; please report this as a Jet defect"},
        MessageLiteral{name: "coded_head", text: "Stop ["},
        MessageLiteral{name: "coded_mid", text: "]: "},
    }
    loop literal in literals {
        function: emit("trap_msg_{literal.name}", literal.text, "trap_write_word") ?? return Err(err)
        source = "{source}\n{function}"
    }
    // Retype the canonical Debug interval table at generation time. Runtime
    // arithmetic stays fixed-width; only list indices cross the exact-Int seam.
    values: debug_intervals(debug) ?? return Err(err)
    source = "{source}\n// Canonical Text/RustDebug.jet intervals, retyped to machine words.\n"
    source = "{source}TRAP_DEBUG_RANGE_COUNT: comptime {{ I64{{{values.len() /% 2}}} }}\n"
    source = "{source}TRAP_DEBUG_RANGES: comptime {{ [I64]{{\n"
    row_start := 0
    loop row_start < values.len() {
        row_end: if row_start + 12 < values.len() -> row_start + 12 else -> values.len()
        words := [String]{}
        loop index in row_start..<row_end -> words.push("I64{{{values[index]}}}")
        source = "{source}    {words.join(", ")},\n"
        row_start += 12
    }
    source = "{source}}} }}\n"
    // Both projections use the same canonical facts. Scoped private generation
    // validates the frozen ordinary bytes first; default generation remains the
    // canonical producer for both projections after the frozen gate is lifted.
    defects := "// Generated by Tools/agent/RuntimeGenerators.jet; do not hand-edit.\n// NO-TLS host-defect rows: raw stack-word writes only; no capture,\n// String carrier, allocation, callback, mutable global, or numeric runtime.\n\n"
    defect_head: emit("trap_defect_unreachable_head", "internal error: entered unreachable code: ", "trap_write_word_raw") ?? return Err(err)
    defect_newline: emit("trap_defect_newline", "\n", "trap_write_word_raw") ?? return Err(err)
    defects = "{defects}{defect_head}\n{defect_newline}"
    Ok(TrapOutputs{source: source, defects: defects})
}

TrapWritePlan: struct {
    write_source: Bool
    write_defects: Bool
    message: String
}

// What one run writes. The ordinary projection is frozen under
// --defects-only: any mismatch there fails before even the private rows are
// written. --check never writes. The default run is the canonical producer of
// both projections.
trap_messages_plan: fn(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> TrapWritePlan GeneratorError! {
    if defects_only && !source_current -> return Err(generator_fail("TrapMessages.jet differs from canonical facts; frozen output was not written"))
    if check {
        if !source_current -> return Err(generator_fail("TrapMessages.jet is stale; run jet Tools/agent/RuntimeGenerators.jet"))
        if !defects_current -> return Err(generator_fail("TrapDefectMessages.jet is stale; run jet Tools/agent/RuntimeGenerators.jet"))
        return Ok(TrapWritePlan{write_source: false, write_defects: false, message: "runtime trap messages and private host-defect rows are current"})
    }
    Ok(TrapWritePlan{write_source: !defects_only && !source_current, write_defects: !defects_current, message: ""})
}

// The (word, count) lines of generated function `name` written through `sink`.
emitted_words: fn(source: String, name: String, sink: String) -> [String] Never! {
    words := [String]{}
    inside := false
    header: "{name}: fn() {{"
    loop line in source.split("\n") {
        if line == header {
            inside = true
            next
        }
        if !inside -> next
        if line == "}}" -> break
        trimmed: line.trim()
        if !trimmed.starts_with("{sink}(I64{{") -> return [String]{}
        words.push(byte_tail(trimmed, byte_len(sink)))
    }
    words
}

plan_error: fn(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> String Never! {
    if trap_messages_plan(check, defects_only, source_current, defects_current) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the private defect rows are the ordinary unreachable prefix and newline words") {
    registry: files.read(REGISTRY_PATH) ?? panic("the registry did not read")
    routes: files.read(ROUTES_PATH) ?? panic("the lowering routes did not read")
    debug: files.read(DEBUG_PATH) ?? panic("the Debug table did not read")
    outputs: render_trap_messages(registry, routes, debug) ?? panic("the trap messages did not render: {err.message}")
    prefix: emitted_words(outputs.defects, "trap_defect_unreachable_head", "trap_write_word_raw")
    newline: emitted_words(outputs.defects, "trap_defect_newline", "trap_write_word_raw")
    // The ordinary unreachable prefix is one static text; its defect row is
    // the same bytes as stack words.
    expected_prefix: loop word in text_words("internal error: entered unreachable code: ") -> "(I64{{{word.value}}}, I64{{{word.count}}})"
    assert_eq(prefix, expected_prefix)
    assert(outputs.source.contains("trap_msg_unreachable: fn() {{ trap_write_static(trap_msg_unreachable_text()) }}"))
    assert_eq(newline, emitted_words(outputs.source, "trap_msg_newline", "trap_write_word"))
    // 42 bytes: five full words and a two-byte tail; the newline is one byte.
    counts: loop word in prefix -> word.split("I64{{").to_list()[2]
    assert_eq(counts, ["8}})", "8}})", "8}})", "8}})", "8}})", "2}})"])
    assert_eq(newline.len(), 1)
    assert(newline[0].ends_with(", I64{{1}})"))
    assert_eq(outputs.defects.split(": fn(").to_list().len() - 1, 2)
}

#Test("check never writes; the frozen gate fails before any write; the default produces both") {
    current: trap_messages_plan(true, false, true, true) ?? panic("current outputs fail the check")
    assert(!current.write_source && !current.write_defects)
    assert(plan_error(true, false, false, true).contains("TrapMessages.jet is stale"))
    assert(plan_error(true, true, true, false).contains("TrapDefectMessages.jet is stale"))
    assert(plan_error(false, true, false, false).contains("frozen output was not written"))
    assert(plan_error(true, true, false, true).contains("frozen output was not written"))
    scoped: trap_messages_plan(false, true, true, false) ?? panic("scoped generation refused")
    assert(!scoped.write_source && scoped.write_defects)
    canonical: trap_messages_plan(false, false, false, false) ?? panic("default generation refused")
    assert(canonical.write_source && canonical.write_defects)
    unchanged: trap_messages_plan(false, false, true, true) ?? panic("default generation refused")
    assert(!unchanged.write_source && !unchanged.write_defects)
}

// Compiler/JetRuntime/lifecycle.list orders the constructor/destructor hooks
// the runtime sources mark with a `// runtime-init: N [when guard,...]` or
// `// runtime-fini: N [when guard,...]` line directly above an `#Export(c)`
// function. The export set itself is exactly the sources' #Export(c)
// functions; these rows only order hooks and name their guards.

LIFECYCLE_TARGET_PATH: "Compiler/JetRuntime/lifecycle.list"
RUNTIME_SOURCES_PATH: "Compiler/JetRuntime/sources.list"
EXPORT_MARK: "#Export(c)"
MAX_LIFECYCLE_PRIORITY: 65535

RuntimeSource: struct {
    path: String
    text: String
}

// One #Export(c) function; `lifecycle` is `init N`, `fini N` or empty.
RuntimeExport: struct {
    name: String
    lifecycle: String
}

ParsedExports: struct {
    exports: [RuntimeExport]
    problems: [String]
}

is_space_byte: fn(code: Int) -> Bool Never! { code == 32 || (code >= 9 && code <= 13) }

is_name_start_byte: fn(code: Int) -> Bool Never! {
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

is_name_byte: fn(code: Int) -> Bool Never! { is_name_start_byte(code) || (code >= 48 && code <= 57) }

is_digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// Whether `word`'s bytes start at byte `at` of `bytes`.
bytes_at: fn(bytes: [U8], at: Int, word: String) -> Bool Never! {
    expected: word.bytes()
    if at + expected.len() > bytes.len() -> return false
    loop index in 0..<expected.len() {
        if Int.from_u8(bytes[at + index]) != Int.from_u8(expected[index]) -> return false
    }
    true
}

skip_spaces: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at
    loop end < bytes.len() && is_space_byte(Int.from_u8(bytes[end])) -> end += 1
    end
}

// The name, the text up to the body's `{` and the offset after that `{` of the
// `#Export(c) name: fn` declaration starting at byte `start`, or None when
// the line is not one (a `}` before the body's `{` also means it is not a
// declaration head).
ExportHead: struct {
    name: String
    signature: String
    body: Int
}

export_head: fn(source: String, bytes: [U8], start: Int) -> ExportHead? Never! {
    at := start + byte_len(EXPORT_MARK)
    spaced := skip_spaces(bytes, at)
    if spaced == at -> return None
    at = spaced
    if bytes_at(bytes, at, "pub") && is_space_byte(code_at(bytes, at + 3)) -> at = skip_spaces(bytes, at + 3)
    if at >= bytes.len() || !is_name_start_byte(Int.from_u8(bytes[at])) -> return None
    name_start: at
    loop at < bytes.len() && is_name_byte(Int.from_u8(bytes[at])) -> at += 1
    name: byte_slice(source, name_start, at)
    if code_at(bytes, at) != 58 -> return None
    at = skip_spaces(bytes, at + 1)
    if !bytes_at(bytes, at, "fn") -> return None
    at = skip_spaces(bytes, at + 2)
    signature_start: at
    loop at < bytes.len() {
        code: Int.from_u8(bytes[at])
        if code == 123 -> return Val(ExportHead{name: name, signature: byte_slice(source, signature_start, at), body: at + 1})
        if code == 125 -> return None
        at += 1
    }
    None
}

// The hook a `// runtime-init: N [when guard,...]` / `// runtime-fini: N
// [when guard,...]` line names; None for any other line. `guards` is the
// comma-separated module storage list, or empty.
LifecycleHook: struct {
    kind: String
    priority: Int
    guards: String
}

lifecycle_hook: fn(line: String) -> LifecycleHook? Never! {
    kind := ""
    if line.starts_with("// runtime-init: ") {
        kind = "init"
    } else if line.starts_with("// runtime-fini: ") {
        kind = "fini"
    } else {
        return None
    }
    fields: byte_tail(line, byte_len("// runtime-init: ")).split(" ").to_list()
    if fields.len() != 1 && (fields.len() != 3 || fields[1] != "when") -> return None
    digits: fields[0]
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if !is_digit_byte(Int.from_u8(byte)) -> return None
    }
    guards: if fields.len() == 3 -> fields[2] else -> ""
    if fields.len() == 3 {
        loop guard in guards.split(",").to_list() {
            if guard == "" -> return None
            bytes: guard.bytes()
            loop at in 0..<bytes.len() {
                code: Int.from_u8(bytes[at])
                word: code == 95 || (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
                if !word && (at == 0 || !is_digit_byte(code)) -> return None
            }
        }
    }
    if Int.parse(digits) == {
        .Ok(priority) -> return Val(LifecycleHook{kind: kind, priority: priority, guards: guards})
        .Err(_) -> { return None }
    }
}

// Reviewed parameter-only widening: these exports take a narrower C integer
// parameter as an I64 word and must mask it to its low bits in their own body.
MaskedParameter: struct {
    symbol: String
    index: Int
    bits: Int
    mask: Int
}

masked_word_parameters: fn() -> [MaskedParameter] Never! {
    [MaskedParameter]{
        MaskedParameter{symbol: "jet_rt_record_new_jet_resolve_error", index: 1, bits: 8, mask: 255},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 1, bits: 16, mask: 65535},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 2, bits: 32, mask: 4294967295},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 3, bits: 32, mask: 4294967295},
        MaskedParameter{symbol: "jet_net_raw_resolve_ordered", index: 1, bits: 16, mask: 65535},
    }
}

// The trimmed, non-empty comma-separated items between a signature's `(` and
// its last `)`.
signature_parameters: fn(signature: String) -> [String] Never! {
    bytes: signature.bytes()
    close := bytes.len() - 1
    loop close > 0 && Int.from_u8(bytes[close]) != 41 -> close -= 1
    items := [String]{}
    if close <= 0 -> return items
    loop item in byte_slice(signature, 1, close).split(",") {
        trimmed: item.trim()
        if trimmed != "" -> items.push(trimmed)
    }
    items
}

// The name of an `name: I64` parameter item, or "" for any other item.
i64_parameter_name: fn(item: String) -> String Never! {
    bytes: item.bytes()
    if bytes.len() == 0 || !is_name_start_byte(Int.from_u8(bytes[0])) -> return ""
    at := 0
    loop at < bytes.len() && is_name_byte(Int.from_u8(bytes[at])) -> at += 1
    name: byte_slice(item, 0, at)
    at = skip_spaces(bytes, at)
    if code_at(bytes, at) != 58 -> return ""
    at = skip_spaces(bytes, at + 1)
    if byte_tail(item, at) != "I64" -> return ""
    name
}

// Whether `code[from..<to]` holds `name.bit_and(I64{mask})` (any spacing) with
// `name` starting a word.
has_mask: fn(code: [U8], from: Int, to: Int, name: String, mask: Int) -> Bool Never! {
    words: [String]{".", "bit_and", "(", "I64", "{{", "{mask}", "}}", ")"}
    loop start in from..<to {
        if start > from && is_name_byte(Int.from_u8(code[start - 1])) -> next
        if !bytes_at(code, start, name) -> next
        at := start + byte_len(name)
        matched := true
        loop word in words {
            at = skip_spaces(code, at)
            if at + byte_len(word) > to || !bytes_at(code, at, word) {
                matched = false
                break
            }
            at += byte_len(word)
        }
        if matched -> return true
    }
    false
}

// The reviewed-mask problems of export `head` in `source`: each listed I64
// parameter must be masked in the export's body (comments and literals are not
// evidence).
masked_parameter_problems: fn(source: String, head: ExportHead, path: String) -> [String] Never! {
    problems := [String]{}
    rows := [MaskedParameter]{}
    loop row in masked_word_parameters() {
        if row.symbol == head.name -> rows.push(row)
    }
    if rows.len() == 0 -> return problems
    code: if code_only(source) == {
        .Ok(text) -> text.bytes()
        .Err(error) -> {
            problems.push("{path}: {error.message}")
            return problems
        }
    }
    body_end: group_end(code, head.body, code.len(), 123, 125)
    if body_end < 0 {
        problems.push("{path}: unterminated masked export {head.name}")
        return problems
    }
    parameters: signature_parameters(head.signature.trim())
    loop row in rows {
        if row.index >= parameters.len() -> next
        name: i64_parameter_name(parameters[row.index])
        if name == "" -> next
        if !has_mask(code, head.body, body_end, name, row.mask) -> problems.push("{path}: {head.name} parameter {row.index} requires the reviewed low-{row.bits}-bit mask")
    }
    problems
}

// Every `#Export(c)` function that starts a line of `source`, with the hook
// marked on the line above it.
runtime_exports: fn(source: String, path: String) -> ParsedExports Never! {
    bytes: source.bytes()
    exports := [RuntimeExport]{}
    problems := [String]{}
    previous_line := -1
    line_start := 0
    loop line_start <= bytes.len() {
        line_end := line_start
        loop line_end < bytes.len() && Int.from_u8(bytes[line_end]) != 10 -> line_end += 1
        if bytes_at(bytes, line_start, EXPORT_MARK) {
            if export_head(source, bytes, line_start) == {
                .Val(head) -> {
                    lifecycle := ""
                    if previous_line >= 0 {
                        if lifecycle_hook(byte_slice(source, previous_line, line_start - 1)) == {
                            .Val(hook) -> {
                                if hook.priority > MAX_LIFECYCLE_PRIORITY -> problems.push("{path}: lifecycle priority exceeds {MAX_LIFECYCLE_PRIORITY}")
                                lifecycle = if hook.guards == "" -> "{hook.kind} {hook.priority}" else -> "{hook.kind} {hook.priority} {hook.guards}"
                            }
                            .None -> {}
                        }
                    }
                    signature: head.signature.trim()
                    if !signature.starts_with("(") || !signature.contains(")") -> problems.push("unparsed runtime #Export(c) {head.name} signature in {path}")
                    loop problem in masked_parameter_problems(source, head, path) -> problems.push(problem)
                    exports.push(RuntimeExport{name: head.name, lifecycle: lifecycle})
                }
                .None -> {}
            }
        }
        previous_line = line_start
        line_start = line_end + 1
    }
    ParsedExports{exports: exports, problems: problems}
}

// One #Export(c) function of a runtime source set and the file declaring it.
PlacedExport: struct {
    name: String
    path: String
    lifecycle: String
}

// Every #Export(c) function of `sources`, in source order; a duplicate, a bad
// declaration and an empty set are refused, every one at once.
placed_exports: fn(sources: [RuntimeSource]) -> [PlacedExport] GeneratorError! {
    problems := [String]{}
    names := [String]{}
    placed := [PlacedExport]{}
    loop source in sources {
        parsed: runtime_exports(source.text, source.path)
        loop problem in parsed.problems -> problems.push(problem)
        loop export in parsed.exports {
            if names.contains(export.name) {
                problems.push("duplicate runtime #Export(c) {export.name}")
                next
            }
            names.push(export.name.copy()) // copy: the row keeps the name too
            placed.push(PlacedExport{name: export.name, path: source.path.copy(), lifecycle: export.lifecycle}) // copy: one row per export of the source
        }
    }
    if names.len() == 0 -> problems.push("empty runtime #Export(c) declarations")
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    placed
}

// lifecycle.list for the given runtime sources: one `symbol init|fini N
// [guards]` row per hook, in symbol order.
lifecycle_list: fn(sources: [RuntimeSource]) -> String GeneratorError! {
    placed: placed_exports(sources) ?? return Err(err)
    rows := [String]{}
    loop export in placed {
        if export.lifecycle != "" -> rows.push("{export.name} {export.lifecycle}")
    }
    rows.sort()
    lines := [String]{
        "# Runtime object lifecycle hooks: <#Export(c) symbol> init|fini <priority 0..65535> [<guard storage>,...].",
        "# Lower init priorities run first (.init_array); fini rows run at exit (.fini_array).",
        "# A guarded hook runs exactly when the program links one of its guard module storages.",
        "# Rows only order hooks; the export set is exactly the sources' #Export(c) functions.",
        "# Generated by Tools/agent/RuntimeGenerators.jet from `// runtime-init|fini: N [when guard,...]` comments.",
    }
    loop row in rows -> lines.push(row)
    Ok("{lines.join("\n")}\n")
}

// The runtime sources sources.list names, in its order. The manifest and the
// source directory must agree: a Source/*.jet the manifest omits never reaches
// the runtime object, so its exports, witnesses and route rows rot unseen.
read_runtime_sources: fn() -[FS]> [RuntimeSource] GeneratorError! {
    listing: files.read(RUNTIME_SOURCES_PATH) ?? return Err(generator_fail("cannot read {RUNTIME_SOURCES_PATH}: {err}"))
    listed: files.list_dir(RUNTIME_SOURCE_DIRECTORY) ?? return Err(generator_fail("cannot list {RUNTIME_SOURCE_DIRECTORY}: {err}"))
    names := [String]{}
    loop entry in listed {
        if entry.name.ends_with(".jet") -> names.push(entry.name)
    }
    sources := [RuntimeSource]{}
    problems := unlisted_runtime_sources(listing, names)
    loop raw in listing.split("\n") {
        path: raw.trim()
        if path == "" || path.starts_with("#") -> next
        if files.read(path) == {
            .Ok(text) -> sources.push(RuntimeSource{path: path, text: text})
            .Err(error) -> problems.push("{RUNTIME_SOURCES_PATH} names {path}, which cannot be read: {error}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    Ok(sources)
}

// The runtime source files (Source/*.jet names) no sources.list line names, as
// one problem each in name order.
unlisted_runtime_sources: fn(listing: String, names: [String]) -> [String] Never! {
    lines := [String]{}
    loop raw in listing.split("\n") -> lines.push(raw.trim())
    sorted := names.copy()
    sorted.sort()
    problems := [String]{}
    loop name in sorted {
        path: "{RUNTIME_SOURCE_DIRECTORY}/{name}"
        if !lines.contains(path) -> problems.push("{path} is not in {RUNTIME_SOURCES_PATH}; list it or delete it")
    }
    problems
}

render_lifecycle_list: fn() -[FS]> String GeneratorError! {
    sources: read_runtime_sources() ?? return Err(err)
    lifecycle_list(sources)
}

#Test("lifecycle rows come from the hook line directly above an export") {
    source: "// runtime-init: 04\n#Export(c) b_start: fn() {{\n}}\n// runtime-fini: 2 when a_root,a_key\n#Export(c)\na_stop: fn(handle: I64) -> Unit {{\n}}\n#Export(c) plain: fn(x: I64) -> I64 {{ x }}\n// runtime-init: 1\n\n#Export(c) spaced: fn() {{}}\n#Export(c) closed: fn }} {{\n"
    parsed: runtime_exports(source, "Fixture.jet")
    assert_eq(parsed.problems.len(), 0)
    assert_eq(parsed.exports.len(), 4)
    assert_eq(parsed.exports[0].lifecycle, "init 4")
    assert_eq(parsed.exports[1].name, "a_stop")
    assert_eq(parsed.exports[1].lifecycle, "fini 2 a_root,a_key")
    assert_eq(parsed.exports[3].lifecycle, "")
    assert(lifecycle_hook("// runtime-init: 3 when 9bad") == None)
    assert(lifecycle_hook("// runtime-init: 3 when a,,b") == None)
    assert(lifecycle_hook("// runtime-init: 3 a_root") == None)
    if lifecycle_list([RuntimeSource]{RuntimeSource{path: "Fixture.jet", text: source}}) == {
        .Ok(text) -> {
            expected: "# Runtime object lifecycle hooks: <#Export(c) symbol> init|fini <priority 0..65535> [<guard storage>,...].\n# Lower init priorities run first (.init_array); fini rows run at exit (.fini_array).\n# A guarded hook runs exactly when the program links one of its guard module storages.\n# Rows only order hooks; the export set is exactly the sources' #Export(c) functions.\n# Generated by Tools/agent/RuntimeGenerators.jet from `// runtime-init|fini: N [when guard,...]` comments.\na_stop fini 2 a_root,a_key\nb_start init 4\n"
            assert_eq(text, expected)
        }
        .Err(error) -> assert_eq(error.message, "")
    }
}

#Test("a reviewed masked parameter needs its low-bit mask in the export body") {
    masked: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    port . bit_and( I64{{ 65535 }} )\n}}\n"
    assert_eq(runtime_exports(masked, "M.jet").problems.len(), 0)
    commented: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    // port.bit_and(I64{{65535}})\n    sport.bit_and(I64{{65535}})\n}}\n"
    assert_eq(runtime_exports(commented, "M.jet").problems.join("|"), "M.jet: jet_net_raw_resolve_ordered parameter 1 requires the reviewed low-16-bit mask")
    narrow: "#Export(c) jet_rt_record_new_jet_resolve_error: fn(kind: I64, flag: U8) -> I64 {{ kind }}\n"
    assert_eq(runtime_exports(narrow, "M.jet").problems.len(), 0)
    unmasked: "#Export(c) jet_rt_record_new_jet_resolve_error: fn(kind: I64, flag: I64) -> I64 {{\n    // flag.bit_and(I64{{255}})\n    flag\n}}\n"
    assert_eq(runtime_exports(unmasked, "M.jet").problems.join("|"), "M.jet: jet_rt_record_new_jet_resolve_error parameter 1 requires the reviewed low-8-bit mask")
    open: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    port.bit_and(I64{{65535}})\n"
    assert_eq(runtime_exports(open, "M.jet").problems.join("|"), "M.jet: unterminated masked export jet_net_raw_resolve_ordered")
}

// The quoted names after each `marker` in `text`.
quoted_after: fn(text: String, marker: String) -> [String] Never! {
    pieces: text.split(marker).to_list()
    names := [String]{}
    loop at in 1..<pieces.len() -> names.push(pieces[at].partition("\"").head.copy())
    names
}

// Record Lists cross every route as handle buffers (the IR's route calls),
// whatever the provider's ownership. The census freezes the routes whose
// carriers hold a List of a schema record, so a new Jet provider returning or
// reading one is reviewed against that contract (a provider handing back
// inline rows surfaces as a pointer-sized allocation in the first
// `entry.field` read), and keeps the native witness that reads a field of
// `files.list_dir`'s result.
#Test("a route carrying a List of schema records is a reviewed handle-buffer route") {
    path: "Compiler/JetIR/Source/RuntimeRoutes.jet"
    routes: files.read(path) ?? panic("{path} did not read: {err}")
    schemas: quoted_after(routes, "IRRecordSchema{{jet_name: \"")
    found := [String]{}
    loop line in routes.lines() {
        symbols: quoted_after(line, "IRRoute{{symbol: \"")
        if symbols.len() != 1 -> next
        loop name in quoted_after(line, "List{{elem: IRRouteCarrier.Handle{{name: \"") {
            if schemas.contains(name) && !found.contains(symbols[0]) -> found.push(symbols[0].copy()) // copy: `symbols` keeps its row
        }
    }
    found.sort()
    // Seed adapters always exchanged handle buffers; the Jet-owned rows
    // (jet_dyn_field, jet_rt_codec_*, jet_std_fs_list_dir_raw) build or read
    // the same shape.
    reviewed: [String]{
        "jet_binary_pattern_match", "jet_dyn_at", "jet_dyn_bool", "jet_dyn_field", "jet_dyn_float", "jet_dyn_int", "jet_dyn_text",
        "jet_log_record_emit_raw",
        "jet_net_dns_srv", "jet_net_dns_srv_at_lookup", "jet_net_dns_srv_lookup",
        "jet_ring_log_debug_fields", "jet_ring_log_error_fields", "jet_ring_log_info_fields", "jet_ring_log_warn_fields",
        "jet_rt_codec_decode_bool", "jet_rt_codec_decode_char", "jet_rt_codec_decode_float", "jet_rt_codec_decode_i16", "jet_rt_codec_decode_i32",
        "jet_rt_codec_decode_i64", "jet_rt_codec_decode_i8", "jet_rt_codec_decode_int", "jet_rt_codec_decode_string", "jet_rt_codec_decode_u16",
        "jet_rt_codec_decode_u32", "jet_rt_codec_decode_u64", "jet_rt_codec_decode_u8", "jet_rt_codec_parse_json", "jet_rt_codec_parse_toml",
        "jet_rt_codec_parse_yaml", "jet_rt_codec_under", "jet_std_fs_list_dir_raw", "jet_text_pattern_match",
    }
    expected := [String]{}
    loop symbol in reviewed {
        if routes.contains("IRRoute{{symbol: \"{symbol}\"") -> expected.push(symbol.copy()) // copy: `reviewed` keeps its rows
    }
    expected.sort()
    assert_eq(found, expected)
}

#Test("every runtime source file is in the manifest") {
    listing: "# comment\nCompiler/JetRuntime/Source/A.jet\n  Compiler/JetRuntime/Source/B.jet  \nCompiler/JetBackend/Source/Shared.jet\n"
    assert_eq(unlisted_runtime_sources(listing, [String]{"B.jet", "A.jet"}).len(), 0)
    found: unlisted_runtime_sources(listing, [String]{"Z.jet", "A.jet", "Orphan.jet", "B.jet"})
    assert_eq(found.join("|"), "Compiler/JetRuntime/Source/Orphan.jet is not in Compiler/JetRuntime/sources.list; list it or delete it|Compiler/JetRuntime/Source/Z.jet is not in Compiler/JetRuntime/sources.list; list it or delete it")
}

#Test("lifecycle rows report every bad export at once") {
    source: "// runtime-init: 70000\n#Export(c) big: fn() {{}}\n#Export(c) bare: fn {{}}\n#Export(c) big: fn() {{}}\n"
    if lifecycle_list([RuntimeSource]{RuntimeSource{path: "F.jet", text: source}}) == {
        .Ok(_) -> assert(false)
        .Err(error) -> {
            expected: "F.jet: lifecycle priority exceeds 65535\nunparsed runtime #Export(c) bare signature in F.jet\nduplicate runtime #Export(c) big"
            assert_eq(error.message, expected)
        }
    }
}

// The compiler's allocation-free Unicode 17 Alphabetic / Numeric decisions,
// reproduced from checksum-pinned UCD inputs. Frozen range hashes keep the
// exact parity oracle of the former table. Each output is a balanced decision
// tree over merged ranges; Alphabetic is split into units of 96 ranges because
// a large flat unit costs the frozen parser quadratic time.

UCD_DIRECTORY: "tests/data/unicode/ucd"
NEEDED_TEXT_DIRECTORY: "Compiler/JetRuntime/Source"
UNICODE_DATA_SHA256: "2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"
DERIVED_CORE_SHA256: "24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"
ALPHABETIC_RANGES_SHA256: "7de9ffd68b766619ca4c145a53801b407db2cdc618802232f5ceaf9871df8d73"
NUMERIC_RANGES_SHA256: "7cf73db1c4a4a841517b6020051330dbedd6031a76bcd42a7096e0716838b8d4"
ALPHABETIC_UNIT_RANGES: 96
MAX_SCALAR: 1114111

// An inclusive scalar range and the expression its leaf returns.
TextRange: struct {
    lo: Int
    hi: Int
    result: String
}

hex_digit_value: fn(code: Int) -> Int Never! {
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 65 && code <= 70 -> code - 55
        code >= 97 && code <= 102 -> code - 87
        else -> 0 - 1
    }
}

// The value of a hexadecimal scalar spelling, or None.
parse_hex: fn(text: String) -> Int? Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return None
    value := 0
    loop byte in bytes {
        digit: hex_digit_value(Int.from_u8(byte))
        if digit < 0 -> return None
        value = value * 16 + digit
    }
    Val(value)
}

upper_hex: fn(value: Int) -> String Never! {
    digits: "0123456789ABCDEF"
    if value == 0 -> return "0"
    out := ""
    rest := value
    loop rest > 0 {
        digit: rest % 16
        out = "{byte_slice(digits, digit, digit + 1)}{out}"
        rest = rest /% 16
    }
    out
}

pinned_ucd: fn(name: String, sha256: String) -[FS]> String GeneratorError! {
    path: "{UCD_DIRECTORY}/{name}"
    text: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
    if crypto.sha256(text.bytes()).hex() != sha256 -> return Err(generator_fail("UCD checksum mismatch: {name}"))
    Ok(text)
}

// The text before the first `separator` of `text` (all of it when absent).
field_before: fn(text: String, separator: String) -> String Never! {
    if text.split_once(separator) == {
        .Val(parts) -> parts.before
        .None -> text
    }
}

// The text after the first `separator` of `text`, or None when absent.
field_after: fn(text: String, separator: String) -> String? Never! {
    if text.split_once(separator) == {
        .Val(parts) -> Val(parts.after)
        .None -> None
    }
}

// `lo..hi ; Alphabetic # …` rows of DerivedCoreProperties.txt.
alphabetic_ranges: fn(derived: String) -> [TextRange] GeneratorError! {
    rows := [TextRange]{}
    loop raw in derived.split("\n") {
        data: field_before(raw, "#")
        rest: field_after(data, ";") ?? next
        if field_before(rest, ";").trim() != "Alphabetic" -> next
        extent: field_before(data, ";").trim()
        lo: parse_hex(field_before(extent, "..")) ?? return Err(generator_fail("malformed Alphabetic row: {raw}"))
        hi_text: field_after(extent, "..") ?? field_before(extent, "..")
        hi: parse_hex(hi_text) ?? return Err(generator_fail("malformed Alphabetic row: {raw}"))
        rows.push(TextRange{lo: lo, hi: hi, result: "true"})
    }
    Ok(rows)
}

is_numeric_category: fn(category: String) -> Bool Never! { category == "Nd" || category == "Nl" || category == "No" }

// Nd/Nl/No scalars of UnicodeData.txt, with `<…, First>`/`<…, Last>` pairs as ranges.
numeric_ranges: fn(data: String) -> [TextRange] GeneratorError! {
    rows := [TextRange]{}
    pending_lo := -1
    pending_category := ""
    loop raw in data.split("\n") {
        if raw == "" -> next
        after_code: field_after(raw, ";") ?? return Err(generator_fail("malformed UCD row: {raw}"))
        after_name: field_after(after_code, ";") ?? return Err(generator_fail("malformed UCD row: {raw}"))
        cp: parse_hex(field_before(raw, ";")) ?? return Err(generator_fail("malformed UCD row: {raw}"))
        name: field_before(after_code, ";")
        category: field_before(after_name, ";")
        if name.ends_with(", First>") {
            pending_lo = cp
            pending_category = category
            next
        }
        if name.ends_with(", Last>") {
            if pending_lo < 0 || pending_category != category -> return Err(generator_fail("malformed UCD range: {raw}"))
            if is_numeric_category(category) -> rows.push(TextRange{lo: pending_lo, hi: cp, result: "true"})
            pending_lo = -1
            next
        }
        if is_numeric_category(category) -> rows.push(TextRange{lo: cp, hi: cp, result: "true"})
    }
    if pending_lo >= 0 -> return Err(generator_fail("unterminated UCD range"))
    Ok(rows)
}

// Sorted by start (stable), overlapping or adjacent ranges merged, and the
// serialization checked against the frozen hash.
merged_ranges: fn(name: String, input: [TextRange], frozen: String) -> [TextRange] GeneratorError! {
    sorted := input
    sorted.sort_by((left: TextRange, right: TextRange) -> left.lo <=> right.lo)
    rows := [TextRange]{}
    loop range in sorted {
        if range.lo > range.hi || range.hi > MAX_SCALAR -> return Err(generator_fail("invalid UCD range {name}"))
        last: rows.len() - 1
        if last >= 0 && range.lo <= rows[last].hi + 1 {
            if range.hi > rows[last].hi -> rows[last] = TextRange{lo: rows[last].lo, hi: range.hi, result: "true"}
        } else {
            rows.push(range)
        }
    }
    serialized := [String]{}
    loop range in rows -> serialized.push("(0x{upper_hex(range.lo)},0x{upper_hex(range.hi)})")
    digest: crypto.sha256(serialized.join(",").bytes()).hex()
    if digest != frozen -> return Err(generator_fail("frozen range parity mismatch: {name}"))
    Ok(rows)
}

tree_arm: fn(guard: String, children: [TextRange], indent: String) -> String Never! {
    if children.len() == 0 -> return "{indent}    {guard} -> return false\n"
    inner: decision_tree(children, "{indent}        ")
    "{indent}    {guard} -> {{\n{inner}{indent}    }}\n"
}

// A balanced `if` over the sorted ranges: below the middle range, above it, or
// inside it (its result).
decision_tree: fn(rows: [TextRange], indent: String) -> String Never! {
    if rows.len() == 0 -> return "{indent}return false\n"
    mid: rows.len() /% 2
    row: rows[mid]
    below: tree_arm("(cp < I64{{{row.lo}}})", rows[0..<mid], indent)
    above: tree_arm("(cp > I64{{{row.hi}}})", rows[mid + 1..<rows.len()], indent)
    "{indent}if {{\n{below}{above}{indent}    else -> return {row.result}\n{indent}}}\n"
}

needed_text_header: fn(digest_name: String, frozen: String) -> String Never! {
    "// Generated by Tools/agent/RuntimeGenerators.jet; Unicode 17.0.0.\n// Frozen UNICODE_{digest_name} ranges SHA256 {frozen}; reproducible from pinned UCD.\n// Static decisions: no allocation, Core calls, or locale dependency.\n"
}

decision_function: fn(symbol: String, body: String) -> String Never! {
    "{symbol}: fn(cp: I64) -> Bool Never! {{\n{body}}}\n"
}

// Every CompilerNeededText*.jet output for the two properties.
render_needed_text: fn(alphabetic_input: [TextRange], numeric_input: [TextRange]) -> [GeneratedFile] GeneratorError! {
    outputs := [GeneratedFile]{}
    alphabetic: merged_ranges("ALPHABETIC", alphabetic_input, ALPHABETIC_RANGES_SHA256) ?? return Err(err)
    header: needed_text_header("ALPHABETIC", ALPHABETIC_RANGES_SHA256)
    chunks := [TextRange]{}
    at := 0
    loop at < alphabetic.len() {
        end: if at + ALPHABETIC_UNIT_RANGES < alphabetic.len() -> at + ALPHABETIC_UNIT_RANGES else -> alphabetic.len()
        part: alphabetic[at..<end]
        index: chunks.len()
        helper: "compiler_text_alphabetic_{index}"
        chunks.push(TextRange{lo: part[0].lo, hi: part[part.len() - 1].hi, result: "{helper}(cp)"})
        outputs.push(GeneratedFile{path: "{NEEDED_TEXT_DIRECTORY}/CompilerNeededTextAlphabetic{index}.jet", text: "{header}{decision_function(helper, decision_tree(part, "    "))}"})
        at = end
    }
    outputs.push(GeneratedFile{path: "{NEEDED_TEXT_DIRECTORY}/CompilerNeededTextAlphabetic.jet", text: "{header}{decision_function("compiler_text_alphabetic", decision_tree(chunks, "    "))}"})
    numeric: merged_ranges("NUMERIC", numeric_input, NUMERIC_RANGES_SHA256) ?? return Err(err)
    outputs.push(GeneratedFile{path: "{NEEDED_TEXT_DIRECTORY}/CompilerNeededTextNumeric.jet", text: "{needed_text_header("NUMERIC", NUMERIC_RANGES_SHA256)}{decision_function("compiler_text_numeric", decision_tree(numeric, "    "))}"})
    Ok(outputs)
}

read_needed_text: fn() -[FS]> [GeneratedFile] GeneratorError! {
    derived: pinned_ucd("DerivedCoreProperties.txt", DERIVED_CORE_SHA256) ?? return Err(err)
    data: pinned_ucd("UnicodeData.txt", UNICODE_DATA_SHA256) ?? return Err(err)
    alphabetic: alphabetic_ranges(derived) ?? return Err(err)
    numeric: numeric_ranges(data) ?? return Err(err)
    render_needed_text(alphabetic, numeric)
}

#Test("decision trees split at the middle range and return its result") {
    rows: [TextRange]{TextRange{lo: 48, hi: 57, result: "true"}, TextRange{lo: 65, hi: 70, result: "true"}}
    expected: "    if {{\n        (cp < I64{{65}}) -> {{\n            if {{\n                (cp < I64{{48}}) -> return false\n                (cp > I64{{57}}) -> return false\n                else -> return true\n            }}\n        }}\n        (cp > I64{{70}}) -> return false\n        else -> return true\n    }}\n"
    assert_eq(decision_tree(rows, "    "), expected)
    assert_eq(decision_tree([TextRange]{}, "  "), "  return false\n")
}

#Test("UCD rows parse into ranges and First/Last pairs") {
    data: "0030;DIGIT ZERO;Nd;0;EN;;0;0;0;N;;;;;\n0041;LATIN CAPITAL LETTER A;Lu;0;L;;;;;N;;;;0061;\n3400;<CJK Ideograph Extension A, First>;Lo;0;L;;;;;N;;;;;\n4DBF;<CJK Ideograph Extension A, Last>;Lo;0;L;;;;;N;;;;;\n2160;ROMAN NUMERAL ONE;Nl;0;L;<compat> 0049;;;1;N;;;;2170;\n"
    numeric: numeric_ranges(data) ?? panic("numeric rows did not parse: {err.message}")
    assert_eq(numeric.len(), 2)
    assert_eq(numeric[1].lo, 8544)
    derived: "0041..005A    ; Alphabetic # L&  [26] LATIN CAPITAL LETTER A..Z\n00AA          ; Alphabetic # Lo       FEMININE ORDINAL INDICATOR\n0030..0039    ; ID_Continue # Nd [10]\n"
    alphabetic: alphabetic_ranges(derived) ?? panic("alphabetic rows did not parse: {err.message}")
    assert_eq(alphabetic.len(), 2)
    assert_eq(alphabetic[0].hi, 90)
    assert_eq(alphabetic[1].lo, 170)
    assert_eq(upper_hex(1114111), "10FFFF")
}

// The compiler's runtime stop facts: every #Export(c) function of
// Compiler/JetRuntime/Source/*.jet whose direct named calls reach the panic
// publication root, private helpers included. Rows are projected from the
// sources, never authored. Foreign/member calls and address-call transports
// are not edges here; their stop facts belong to the compiler's callback
// analysis, and any call this projection cannot read is reported.

STOP_EXPORTS_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/RuntimeStopExports.jet"
RUNTIME_SOURCE_DIRECTORY: "Compiler/JetRuntime/Source"
PANIC_PUBLICATION_ROOT: "scheduler_panic_publish_record"
BUILD_LIBRARY_PATH: "Compiler/JetIR/Source/BuildLibrary.jet"

code_at: fn(code: [U8], at: Int) -> Int Never! {
    if at >= 0 && at < code.len() -> Int.from_u8(code[at]) else -> 0 - 1
}

// Spaces over bytes `start..<end` of `code`, keeping line breaks.
blank_range: fn(source: [U8], code: &[U8], start: Int, end: Int) {
    loop at in start..<end {
        byte: Int.from_u8(source[at])
        if byte != 10 && byte != 13 -> code[at] = U8{32}
    }
}

// Masks the comments and literal text of `source` into `code` from `start`.
// Ordinary code keeps its line breaks (statement boundaries); interpolation
// code is read in the lexer's raw-token mode, so its line breaks become
// spaces. Inside an interpolation the scan stops after its closing brace and
// returns that offset.
mask_scan: fn(source: [U8], code: &[U8], start: Int, interpolation: Bool) -> Int GeneratorError! {
    at := start
    braces := 0
    length: source.len()
    loop at < length {
        byte: Int.from_u8(source[at])
        if byte == 47 && code_at(source, at + 1) == 47 {
            end := at
            loop end < length && Int.from_u8(source[end]) != 10 -> end += 1
            blank_range(source, code, at, end)
            at = end
        } else if byte == 47 && code_at(source, at + 1) == 42 {
            begin: at
            at += 2
            depth := 1
            loop at < length && depth > 0 {
                if code_at(source, at) == 47 && code_at(source, at + 1) == 42 {
                    depth += 1
                    at += 2
                } else if code_at(source, at) == 42 && code_at(source, at + 1) == 47 {
                    depth -= 1
                    at += 2
                } else {
                    at += 1
                }
            }
            if depth > 0 -> return Err(generator_fail("unclosed runtime source comment"))
            blank_range(source, code, begin, at)
        } else if byte == 34 || byte == 39 {
            triple: byte == 34 && code_at(source, at + 1) == 34 && code_at(source, at + 2) == 34
            delimiter_len: if triple -> 3 else -> 1
            literal := at
            at += delimiter_len
            loop at < length && !(code_at(source, at) == byte && (!triple || (code_at(source, at + 1) == 34 && code_at(source, at + 2) == 34))) {
                current: Int.from_u8(source[at])
                if current == 92 {
                    at += 2
                } else if byte == 34 && current == 123 && code_at(source, at + 1) == 123 {
                    at += 2
                } else if byte == 34 && current == 123 {
                    blank_range(source, code, literal, at + 1)
                    expression: at + 1
                    at = mask_scan(source, code, expression, true) ?? return Err(err)
                    loop cursor in expression..<at {
                        if Int.from_u8(code[cursor]) == 10 -> code[cursor] = U8{32}
                    }
                    literal = at - 1
                } else {
                    at += 1
                }
            }
            if at >= length -> return Err(generator_fail("unclosed runtime source literal"))
            at += delimiter_len
            blank_range(source, code, literal, at)
        } else if byte == 123 {
            braces += 1
            at += 1
        } else if byte == 125 {
            if interpolation && braces == 0 -> return Ok(at + 1)
            braces -= 1
            at += 1
        } else {
            at += 1
        }
    }
    if interpolation -> return Err(generator_fail("unclosed runtime source interpolation"))
    Ok(at)
}

// `source` with every comment and literal text replaced by spaces, offsets kept.
code_only: fn(source: String) -> String GeneratorError! {
    bytes: source.bytes()
    code := source.bytes()
    mask_scan(bytes, code, 0, false) ?? return Err(err)
    Ok(String.from_bytes_lossy(code))
}

// The start of the identifier that ends just before byte `end`, or -1 when
// the word there does not start with a letter or `_`.
identifier_start: fn(code: [U8], floor: Int, end: Int) -> Int Never! {
    start := end
    loop start > floor && is_name_byte(Int.from_u8(code[start - 1])) -> start -= 1
    if start == end || !is_name_start_byte(Int.from_u8(code[start])) -> return 0 - 1
    start
}

// Calls this projection cannot read: a generic call head `name<…>(` whose
// `<` and `>` touch (spaced `a < b > (c)` is a comparison), and a computed
// call `(…)(` / `[…](` on one line (a line break there ends the statement).
unsupported_calls: fn(code: [U8], path: String) -> [String] Never! {
    problems := [String]{}
    loop at in 0..<code.len() {
        if Int.from_u8(code[at]) != 60 -> next
        start: identifier_start(code, 0, at)
        if start < 0 -> next
        after: code_at(code, at + 1)
        if after == 60 || after == 61 -> next
        cursor := at + 1
        depth := 1
        loop cursor < code.len() && depth > 0 {
            current: Int.from_u8(code[cursor])
            if current == 123 || current == 125 || current == 59 -> break
            if current == 60 -> depth += 1
            else if current == 62 -> depth -= 1
            cursor += 1
        }
        if depth == 0 && code_at(code, cursor) == 40 -> problems.push("{path}: unsupported generic call {byte_slice(String.from_bytes_lossy(code), start, at)}")
    }
    loop at in 0..<code.len() {
        closer: Int.from_u8(code[at])
        if closer != 41 && closer != 93 -> next
        cursor := at + 1
        loop cursor < code.len() && Int.from_u8(code[cursor]) != 10 && is_space_byte(Int.from_u8(code[cursor])) -> cursor += 1
        if code_at(code, cursor) == 40 {
            problems.push("{path}: unsupported computed call")
            break
        }
    }
    problems
}

// One function head: where it starts, its name and the offset after `fn`
// (`name: fn`) or after the name (a nested `fn name`) and the spaces that
// follow it.
FunctionHead: struct {
    start: Int
    name: String
    end: Int
}

// The `name: fn` head of a declaration starting the line at `line`: optional
// `pub`/`priv` and markers, then `name: fn`; None for any other line.
colon_function_head: fn(text: String, code: [U8], line: Int) -> FunctionHead? Never! {
    at := line
    loop code_at(code, at) == 32 || code_at(code, at) == 9 -> at += 1
    modifiers: [String]{"pub", "priv"}
    loop word in modifiers {
        if !bytes_at(code, at, word) || !is_space_byte(code_at(code, at + byte_len(word))) -> next
        at = skip_spaces(code, at + byte_len(word))
        break
    }
    loop code_at(code, at) == 35 {
        marker := at + 1
        if !is_name_start_byte(code_at(code, marker)) -> return None
        loop marker < code.len() && is_name_byte(Int.from_u8(code[marker])) -> marker += 1
        if code_at(code, marker) == 40 {
            loop marker < code.len() && code_at(code, marker) != 41 && code_at(code, marker) != 10 -> marker += 1
            if code_at(code, marker) != 41 -> return None
            marker += 1
        }
        spaced: skip_spaces(code, marker)
        if spaced == marker -> return None
        at = spaced
    }
    if !is_name_start_byte(code_at(code, at)) -> return None
    name_start: at
    loop at < code.len() && is_name_byte(Int.from_u8(code[at])) -> at += 1
    name_end: at
    if code_at(code, at) != 58 -> return None
    at = skip_spaces(code, at + 1)
    if !bytes_at(code, at, "fn") -> return None
    Val(FunctionHead{start: line, name: byte_slice(text, name_start, name_end), end: skip_spaces(code, at + 2)})
}

// Every declaration `name: fn` that starts a line and every nested local
// `fn name`, in source order.
function_heads: fn(text: String, code: [U8]) -> [FunctionHead] Never! {
    heads := [FunctionHead]{}
    at := 0
    loop at + 1 < code.len() {
        if at == 0 || Int.from_u8(code[at - 1]) == 10 {
            if colon_function_head(text, code, at) == {
                .Val(head) -> {
                    heads.push(head.copy())
                    at = head.end
                    next
                }
                .None -> {}
            }
        }
        if Int.from_u8(code[at]) != 102 || Int.from_u8(code[at + 1]) != 110 || (at > 0 && is_name_byte(Int.from_u8(code[at - 1]))) {
            at += 1
            next
        }
        spaced: skip_spaces(code, at + 2)
        if spaced == at + 2 || spaced >= code.len() || !is_name_start_byte(Int.from_u8(code[spaced])) {
            at += 1
            next
        }
        name_end := spaced
        loop name_end < code.len() && is_name_byte(Int.from_u8(code[name_end])) -> name_end += 1
        end: skip_spaces(code, name_end)
        heads.push(FunctionHead{start: at, name: byte_slice(text, spaced, name_end), end: end})
        at = end
    }
    heads
}

// The identifiers of `code[from..<to]` that start a word and are followed,
// after optional spaces, by `:` (`assign` false), or that start a line and
// are followed, after optional spaces or tabs, by `:` (true).
bound_names: fn(text: String, code: [U8], from: Int, to: Int, assign: Bool) -> [String] Never! {
    names := [String]{}
    at := from
    loop at < to {
        if !is_name_byte(Int.from_u8(code[at])) {
            at += 1
            next
        }
        start: at
        loop at < to && is_name_byte(Int.from_u8(code[at])) -> at += 1
        if !is_name_start_byte(Int.from_u8(code[start])) -> next
        cursor := at
        if assign {
            before := start
            loop before > from && (code_at(code, before - 1) == 32 || code_at(code, before - 1) == 9) -> before -= 1
            if before > from && code_at(code, before - 1) != 10 -> next
            loop cursor < to && (code_at(code, cursor) == 32 || code_at(code, cursor) == 9) -> cursor += 1
        } else {
            loop cursor < to && is_space_byte(Int.from_u8(code[cursor])) -> cursor += 1
        }
        if cursor >= to || Int.from_u8(code[cursor]) != 58 -> next
        names.push(byte_slice(text, start, at))
    }
    names
}

// The direct named calls of `code[from..<to]`: identifiers followed on the same
// line by `(`, except member calls (`.name(`). `open` is the offset after `(`.
NamedCall: struct {
    name: String
    open: Int
}

named_calls: fn(text: String, code: [U8], from: Int, to: Int) -> [NamedCall] Never! {
    calls := [NamedCall]{}
    at := from
    loop at < to {
        if !is_name_byte(Int.from_u8(code[at])) {
            at += 1
            next
        }
        start: at
        loop at < to && is_name_byte(Int.from_u8(code[at])) -> at += 1
        if !is_name_start_byte(Int.from_u8(code[start])) -> next
        cursor := at
        loop cursor < to && Int.from_u8(code[cursor]) != 10 && is_space_byte(Int.from_u8(code[cursor])) -> cursor += 1
        if cursor >= to || Int.from_u8(code[cursor]) != 40 -> next
        before := start
        loop before > from && is_space_byte(Int.from_u8(code[before - 1])) -> before -= 1
        if before > from && Int.from_u8(code[before - 1]) == 46 -> next
        calls.push(NamedCall{name: byte_slice(text, start, at), open: cursor + 1})
    }
    calls
}

// The identifier starting at the first non-space byte from `at`, below `to`;
// "" when none does.
word_after: fn(text: String, code: [U8], at: Int, to: Int) -> String Never! {
    start: skip_spaces(code, at)
    if start >= to || !is_name_start_byte(Int.from_u8(code[start])) -> return ""
    end := start
    loop end < to && is_name_byte(Int.from_u8(code[end])) -> end += 1
    byte_slice(text, start, end)
}

// A stop rail behind a hook: a code word named `<name>_rail_code` that
// holds a checked function address (JetIR BuildLibrary.jet's FunctionAddress
// rows). `<word> = rt_x_address()` installs it, and a function that calls
// through the word (`coll_callN(word, ...)` or `os_callN`, directly or
// through a local bound to it) calls every export installed there: those
// calls are named edges too, so a rail behind a hook keeps its callers'
// stop facts. Other code words stay callback effects, outside the graph.
RailInstall: struct {
    word: String
    address: String
}

rail_installs: fn(text: String, code: [U8]) -> [RailInstall] Never! {
    installs := [RailInstall]{}
    at := 0
    loop at < code.len() {
        if !is_name_byte(Int.from_u8(code[at])) {
            at += 1
            next
        }
        start: at
        loop at < code.len() && is_name_byte(Int.from_u8(code[at])) -> at += 1
        if !is_name_start_byte(Int.from_u8(code[start])) -> next
        word: byte_slice(text, start, at)
        if !word.ends_with("_rail_code") -> next
        equals: skip_spaces(code, at)
        if code_at(code, equals) != 61 || code_at(code, equals + 1) == 61 -> next
        address_at: skip_spaces(code, equals + 1)
        address: word_after(text, code, address_at, code.len())
        if !address.starts_with("rt_") || !address.ends_with("_address") -> next
        open: skip_spaces(code, address_at + byte_len(address))
        if code_at(code, open) != 40 || code_at(code, skip_spaces(code, open + 1)) != 41 -> next
        installs.push(RailInstall{word: word, address: address})
    }
    installs
}

// The `_rail_code` word the local `name` is bound to (`name: word` or
// `name := word`) in `code[from..<to]`, or "".
rail_binding: fn(text: String, code: [U8], from: Int, to: Int, name: String) -> String Never! {
    at := from
    loop at < to {
        if !is_name_byte(Int.from_u8(code[at])) {
            at += 1
            next
        }
        start: at
        loop at < to && is_name_byte(Int.from_u8(code[at])) -> at += 1
        if !is_name_start_byte(Int.from_u8(code[start])) || byte_slice(text, start, at) != name -> next
        colon: skip_spaces(code, at)
        if colon + 1 >= to || code_at(code, colon) != 58 -> next
        value_at: if code_at(code, colon + 1) == 61 -> colon + 2 else -> colon + 1
        bound: word_after(text, code, value_at, to)
        if bound.ends_with("_rail_code") -> return bound
    }
    ""
}

// JetIR BuildLibrary.jet's checked function addresses: `rt_x_address` -> the
// export it resolves to.
runtime_function_addresses: fn(source: String) -> [String:String] Never! {
    addresses := [String:String]{}
    name_marker: "{{name: \""
    symbol_marker: ".FunctionAddress{{symbol: \""
    loop line in source.split("\n") {
        trimmed: line.trim()
        if !trimmed.starts_with("{name_marker}rt_") -> next
        rest: byte_tail(trimmed, byte_len(name_marker))
        name_end: rest.find("\"")
        symbol_at: rest.find(symbol_marker)
        if name_end < 0 || symbol_at < 0 -> next
        symbol: byte_tail(rest, symbol_at + byte_len(symbol_marker))
        symbol_end: symbol.find("\"")
        if symbol_end < 0 -> next
        addresses[byte_slice(rest, 0, name_end)] = byte_slice(symbol, 0, symbol_end)
    }
    addresses
}

// The index of the byte that closes the group opened just before `from`
// (`open`/`close` nesting), searching below `limit`; -1 when unclosed.
group_end: fn(code: [U8], from: Int, limit: Int, open: Int, close: Int) -> Int Never! {
    at := from
    depth := 1
    loop at < limit && depth > 0 {
        current: Int.from_u8(code[at])
        if current == open -> depth += 1
        else if current == close -> depth -= 1
        at += 1
    }
    if depth > 0 -> return 0 - 1
    at
}

// The sorted #Export(c) symbols whose named-call closure reaches the panic
// publication root; every unreadable source is reported at once. Calls
// through a stop rail's hook (RailInstall) are named calls of every export
// installed there; `addresses` resolves the installs.
runtime_stop_exports: fn(sources: [RuntimeSource], addresses: [String:String]) -> [String] GeneratorError! {
    problems := [String]{}
    exports := [String]{}
    order := [String]{}
    functions := [String: [String]]{}
    installed := [String: [String]]{}
    rail_calls := [String: [String]]{}
    loop source in sources {
        path: source.path
        text: if code_only(source.text) == {
            .Ok(masked) -> masked
            .Err(error) -> {
                problems.push("{path}: {error.message}")
                next
            }
        }
        code: text.bytes()
        loop problem in unsupported_calls(code, path) -> problems.push(problem)
        loop install in rail_installs(text, code) {
            symbol: addresses.get(install.address) ?? ""
            if symbol == "" {
                problems.push("unknown runtime function address {install.address} installed in {install.word}")
                next
            }
            symbols := installed.get(install.word) ?? [String]{}
            if !symbols.contains(symbol) -> symbols.push(symbol)
            installed[install.word] = symbols
        }
        parsed: runtime_exports(text, path)
        loop problem in parsed.problems -> problems.push(problem)
        loop export in parsed.exports {
            if exports.contains(export.name) {
                problems.push("duplicate runtime #Export(c) {export.name}")
                next
            }
            exports.push(export.name)
        }
        heads: function_heads(text, code)
        loop index in 0..<heads.len() {
            head: heads[index]
            limit: if index + 1 < heads.len() -> heads[index + 1].start else -> code.len()
            if code_at(code, head.end) != 40 {
                problems.push("{path}: unsupported function declaration {head.name}")
                next
            }
            parameters_end: group_end(code, head.end + 1, limit, 40, 41)
            if parameters_end < 0 {
                problems.push("{path}: unclosed {head.name} parameters")
                next
            }
            at := parameters_end
            loop at < limit && Int.from_u8(code[at]) != 123 && Int.from_u8(code[at]) != 61 -> at += 1
            if code_at(code, at) == 61 && at < limit -> next
            if at >= limit {
                problems.push("{path}: missing {head.name} body")
                next
            }
            body_start: at + 1
            body_end: group_end(code, body_start, limit, 123, 125)
            if body_end < 0 {
                problems.push("{path}: unclosed {head.name} body")
                next
            }
            if functions.has_key(head.name) {
                problems.push("duplicate runtime function {head.name}")
                next
            }
            bound := bound_names(text, code, head.end + 1, parameters_end - 1, false)
            loop name in bound_names(text, code, body_start, body_end - 1, true) -> bound.push(name)
            calls := [String]{}
            words := [String]{}
            loop call in named_calls(text, code, body_start, body_end - 1) {
                if bound.contains(call.name) {
                    problems.push("{path}: unsupported bound-value call {call.name} in {head.name}")
                    next
                }
                calls.push(call.name)
                if !call.name.starts_with("coll_call") && !call.name.starts_with("os_call") -> next
                argument: word_after(text, code, call.open, body_end - 1)
                word: if argument.ends_with("_rail_code") -> argument else -> rail_binding(text, code, body_start, body_end - 1, argument)
                if word != "" && !words.contains(word) -> words.push(word)
            }
            if words.len() > 0 -> rail_calls[head.name] = words
            order.push(head.name)
            functions[head.name] = calls
        }
    }
    if !functions.has_key(PANIC_PUBLICATION_ROOT) -> problems.push("missing runtime panic publication root")
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    loop name in order {
        words: rail_calls.get(name) ?? [String]{}
        if words.len() == 0 -> next
        calls := functions.get(name) ?? [String]{}
        loop word in words {
            symbols: installed.get(word) ?? [String]{}
            loop symbol in symbols -> calls.push(symbol)
        }
        functions[name] = calls
    }
    callers := [String: [String]]{}
    loop name in order {
        seen := [String]{}
        calls: functions.get(name) ?? [String]{}
        loop callee in calls {
            if seen.contains(callee) || !functions.has_key(callee) -> next
            seen.push(callee.copy())
            list := callers.get(callee) ?? [String]{}
            list.push(name.copy())
            callers[callee] = list
        }
    }
    reached := [String]{PANIC_PUBLICATION_ROOT}
    cursor := 0
    loop cursor < reached.len() {
        callee: reached[cursor]
        cursor += 1
        reaching: callers.get(callee) ?? [String]{}
        loop caller in reaching {
            if !reached.contains(caller) -> reached.push(caller)
        }
    }
    symbols := [String]{}
    loop name in exports {
        if reached.contains(name) -> symbols.push(name)
    }
    symbols.sort()
    Ok(symbols)
}

render_stop_registry: fn(symbols: [String]) -> String Never! {
    lines := [String]{
        "// Generated by Tools/agent/RuntimeGenerators.jet; do not edit.",
        "// Named-call closure from scheduler_panic_publish_record in JetRuntime/Source/*.jet.",
        "// Direct named calls and stop-rail hooks (_rail_code words) only; other foreign/dynamic callback effects are separate.",
        "// Both compiler halves consume these Panic stop facts, not returned Results.",
        "// The symbols land as literal data: no compile-time execution host is needed.",
        "RUNTIME_STOP_EXPORTS: comptime {{ [String]{{",
    }
    loop symbol in symbols -> lines.push("    \"{symbol}\",")
    tail: [String]{"}} }}", "", "runtime_export_can_stop: fn(symbol: String) -> Bool Never! {{", "    loop candidate in RUNTIME_STOP_EXPORTS {{", "        if candidate == symbol -> return true", "    }}", "    false", "}}"}
    loop line in tail -> lines.push(line)
    "{lines.join("\n")}\n"
}

read_stop_registry: fn() -[FS]> String GeneratorError! {
    names := [String]{}
    listed: files.list_dir(RUNTIME_SOURCE_DIRECTORY) ?? return Err(generator_fail("cannot list {RUNTIME_SOURCE_DIRECTORY}: {err}"))
    loop entry in listed {
        if entry.name.ends_with(".jet") -> names.push(entry.name)
    }
    names.sort()
    sources := [RuntimeSource]{}
    loop name in names {
        text: files.read("{RUNTIME_SOURCE_DIRECTORY}/{name}") ?? return Err(generator_fail("cannot read {RUNTIME_SOURCE_DIRECTORY}/{name}: {err}"))
        sources.push(RuntimeSource{path: name, text: text})
    }
    library: files.read(BUILD_LIBRARY_PATH) ?? return Err(generator_fail("cannot read {BUILD_LIBRARY_PATH}: {err}"))
    symbols: runtime_stop_exports(sources, runtime_function_addresses(library)) ?? return Err(err)
    Ok(render_stop_registry(symbols))
}

STOP_FIXTURE_ROOT: "scheduler_panic_publish_record: fn(record: I64) -> Bool {{ false }}\nrt_task_panic_publish: fn(message: I64, length: I64, form: I64) -> Bool {{ scheduler_panic_publish_record(message) }}\n"

stop_closure: fn(source: String) -> [String] GeneratorError! {
    runtime_stop_exports([RuntimeSource]{RuntimeSource{path: "Fixture.jet", text: "{STOP_FIXTURE_ROOT}{source}"}}, [String:String]{})
}

closure_text: fn(source: String) -> String Never! {
    if stop_closure(source) == {
        .Ok(symbols) -> symbols.join(",")
        .Err(error) -> "error: {error.message}"
    }
}

#Test("private named-call closure includes same-line and separate-line exports, sorted") {
    source: "\nprivate_stop: fn() {{ rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}}) }}\nmiddle: fn() {{ private_stop() }}\n#Export(c) z_export: fn() {{ middle() }}\n#Export(c)\na_export: fn() {{ private_stop() }}\n#Export(c) ordinary: fn() -> I64 {{ I64{{0}} }}\n"
    assert_eq(closure_text(source), "a_export,z_export")
}

#Test("connected recursion converges and disconnected recursion is not a stop") {
    source: "\nleft: fn() {{ right() }}\nright: fn() {{\n    left()\n    rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}})\n}}\nunrelated_a: fn() {{ unrelated_b() }}\nunrelated_b: fn() {{ unrelated_a() }}\n#Export(c) stopped: fn() {{ left() }}\n#Export(c) ordinary: fn() {{ unrelated_a() }}\n"
    assert_eq(closure_text(source), "stopped")
}

#Test("nested comments, multibyte text and literal prose cannot add declarations or calls") {
    source: "\n// λ and 𐐀 do not shift the following source offsets.\n/* outer /* #Export(c) fake: fn() {{ rt_task_panic_publish(0, 0, 0) }} */ comment */\n#Export(c) ordinary: fn() {{\n    // rt_task_panic_publish(0, 0, 0)\n    message: \"rt_task_panic_publish(0, 0, 0), \\\"quoted\\\"\"\n    escaped: \"{{{{rt_task_panic_publish(0, 0, 0)}}}}\"\n    triple: \"\"\"\n#Export(c) fake_text: fn() {{{{ rt_task_panic_publish(0, 0, 0) }}}}\n\"\"\"\n    char: '{{'\n}}\n"
    assert_eq(closure_text(source), "")
}

#Test("actual string interpolation expressions are calls, not prose") {
    helper: "\nhelper: fn() {{ rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}}) }}\n#Export(c) interpolated: fn() {{ message: \"value {{helper()}}\" }}\n"
    assert_eq(closure_text(helper), "interpolated")
    cr: String.from_bytes_lossy([U8]{U8{13}})
    raw_mode: "#Export(c) interpolated: fn() {{ message: \"\"\"value {{rt_task_panic_publish // comment{cr}\n (I64{{0}}, I64{{0}}, I64{{0}})}}\"\"\" }}"
    assert_eq(closure_text(raw_mode), "interpolated")
    ordinary: "#Export(c) ordinary: fn() {{ rt_task_panic_publish /* comment */{cr}\n (I64{{0}}, I64{{0}}, I64{{0}}) }}"
    assert_eq(closure_text(ordinary), "")
}

#Test("an imported declaration cannot adopt the following global initializer as its body") {
    source: "\n#Import(c) imported: fn(value: I64) = \"imported\"\nGLOBAL: comptime {{ I64{{0}} }}\n#Export(c) ordinary: fn() {{ imported(I64{{0}}) }}\n"
    assert_eq(closure_text(source), "")
}

#Test("cross-file private calls and typed literals retain balanced function boundaries") {
    sources: [RuntimeSource]{
        RuntimeSource{path: "Root.jet", text: "{STOP_FIXTURE_ROOT}helper: fn() {{\n    value: I64{{0}}\n    rt_task_panic_publish(value, value, value)\n}}"},
        RuntimeSource{path: "Caller.jet", text: "#Export(c) caller: fn() {{ if true {{ helper() }} }}"},
    }
    symbols: runtime_stop_exports(sources, [String:String]{}) ?? panic("the closure failed: {err.message}")
    assert_eq(symbols.join(","), "caller")
}

#Test("one actual sink includes Task, Root, Sentry, Parallel and public record callers, not stop snapshots") {
    source: "\n#Export(c) task: fn() {{ rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}}) }}\nroot_owned: fn() {{ scheduler_panic_publish_record(I64{{0}}) }}\n#Export(c) root: fn() {{ root_owned() }}\n#Export(c) sentry: fn() {{ scheduler_panic_publish_record(I64{{0}}) }}\n#Export(c) parallel: fn() {{ if true {{ scheduler_panic_publish_record(I64{{0}}) }} }}\n#Export(c) control_publish: fn() {{ if true {{ scheduler_panic_publish_record(I64{{0}}) }} }}\n#Export(c) status: fn() {{ I64{{0}} }}\n#Export(c) cleanup_enter: fn() {{ status() }}\n#Export(c) cleanup_leave: fn() {{}}\n"
    assert_eq(closure_text(source), "control_publish,parallel,root,sentry,task")
}

#Test("generated registry is the exact literal symbol list") {
    symbols: stop_closure("#Export(c) stopped: fn() {{ rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}}) }}") ?? panic("the closure failed: {err.message}")
    expected: "// Generated by Tools/agent/RuntimeGenerators.jet; do not edit.\n// Named-call closure from scheduler_panic_publish_record in JetRuntime/Source/*.jet.\n// Direct named calls and stop-rail hooks (_rail_code words) only; other foreign/dynamic callback effects are separate.\n// Both compiler halves consume these Panic stop facts, not returned Results.\n// The symbols land as literal data: no compile-time execution host is needed.\nRUNTIME_STOP_EXPORTS: comptime {{ [String]{{\n    \"stopped\",\n}} }}\n\nruntime_export_can_stop: fn(symbol: String) -> Bool Never! {{\n    loop candidate in RUNTIME_STOP_EXPORTS {{\n        if candidate == symbol -> return true\n    }}\n    false\n}}\n"
    assert_eq(render_stop_registry(symbols), expected)
}

#Test("shift and less-or-equal operators cannot open generic call arguments") {
    source: "\nrotate: fn(word: I64, shift: I64) -> I64 {{\n    (word << shift).bit_or(word >> (I64{{32}} - shift)).bit_and(I64{{0xffffffff}})\n}}\n#Export(c) ordinary: fn(word: I64) -> I64 {{ rotate(word, I64{{7}}) }}\n#Export(c) checked: fn(word: I64, limit: I64) {{\n    if word <= (limit) -> rt_task_panic_publish(word, word, word)\n}}\n"
    assert_eq(closure_text(source), "checked")
}

#Test("spaced comparisons followed by a later '> (' are not generic call heads") {
    source: "\nadvance: fn(at: I64, length: I64, data: I64) -> I64 {{\n    loop at < length && data > (I64{{32}}) -> at += I64{{1}}\n    at\n}}\n#Export(c) ordinary: fn(at: I64, length: I64) -> I64 {{ advance(at, length, I64{{0}}) }}\n#Export(c) checked: fn(value: I64) {{ rt_task_panic_publish(value, value, value) }}\n"
    assert_eq(closure_text(source), "checked")
    assert(closure_text("#Export(c) generic_caller: fn() {{ external<T>(I64{{0}}) }}").contains("unsupported generic call external"))
}

#Test("missing publication root or malformed source fails instead of emitting incomplete facts") {
    if runtime_stop_exports([RuntimeSource]{RuntimeSource{path: "Missing.jet", text: "#Export(c) ordinary: fn() {{}}"}}, [String:String]{}) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert(error.message.contains("missing runtime panic publication root"))
    }
    assert(closure_text("broken: fn() {{").contains("unclosed broken body"))
    assert(closure_text("/* unclosed").contains("unclosed runtime source comment"))
    generic: closure_text("generic: fn<T>(value: T) {{ value }}")
    assert(generic.contains("unsupported generic call") || generic.contains("unsupported function declaration"))
    assert(closure_text("#Export(c) generic_caller: fn() {{ external<T<U>>() }}").contains("unsupported generic call"))
    assert(closure_text("indirect: fn(callback: I64) {{ callback() }}").contains("unsupported bound-value call callback"))
    assert(closure_text("indirect: fn() {{ callback: helper\n callback() }}").contains("unsupported bound-value call callback"))
    assert(closure_text("indirect: fn() {{ (callback)() }}").contains("unsupported computed call"))
    cr: String.from_bytes_lossy([U8]{U8{13}})
    assert(closure_text("indirect: fn() {{ text: \"\"\"{{(callback) /* comment{cr}\n */ ()}}\"\"\" }}").contains("unsupported computed call"))
    assert(closure_text("indirect: fn() {{ callbacks[I64{{0}}]() }}").contains("unsupported computed call"))
    assert_eq(closure_text("#Export(c) foreign_member: fn() {{ foreign.rt_task_panic_publish() }}"), "")
    assert_eq(closure_text("#Export(c) arms: fn() {{ if {{\n true -> rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}})\n (true) -> rt_task_panic_publish(I64{{0}}, I64{{0}}, I64{{0}})\n }} }}"), "arms")
    assert_eq(closure_text("ordinary: fn(left: I64, right: I64) -> Bool {{\n if left != right -> return (left ^ I64{{1}}) < (right ^ I64{{1}}){cr}\n (left ^ I64{{0}}) < (right ^ I64{{0}})\n }}"), "")
}

#Test("a stop-rail hook is a named edge to every export installed in it; other code words are not") {
    source: "\ntrap_root_rail_code := I64{{0}}\nprint_code := I64{{0}}\ncoll_call3: fn(code: I64, a: I64, b: I64, c: I64) -> I64 {{ I64{{0}} }}\ninstall: fn() {{\n    trap_root_rail_code = rt_root_address()\n    print_code = rt_other_address()\n}}\n#Export(c) root_half: fn(op: I64) -> I64 {{\n    rt_task_panic_publish(op, op, op)\n    I64{{1}}\n}}\n#Export(c) other_half: fn(op: I64) -> I64 {{\n    rt_task_panic_publish(op, op, op)\n    I64{{1}}\n}}\n#Export(c) direct: fn() {{ _ := coll_call3(trap_root_rail_code, I64{{0}}, I64{{0}}, I64{{0}}) }}\n#Export(c) bound: fn() {{\n    rail: trap_root_rail_code\n    _ := coll_call3(rail, I64{{0}}, I64{{0}}, I64{{0}})\n}}\n#Export(c) callback: fn() {{ _ := coll_call3(print_code, I64{{0}}, I64{{0}}, I64{{0}}) }}\n"
    addresses := [String:String]{}
    addresses["rt_root_address"] = "root_half"
    addresses["rt_other_address"] = "other_half"
    sources: [RuntimeSource]{RuntimeSource{path: "Fixture.jet", text: "{STOP_FIXTURE_ROOT}{source}"}}
    symbols: runtime_stop_exports(sources, addresses) ?? panic("the closure failed: {err.message}")
    assert_eq(symbols.join(","), "bound,direct,other_half,root_half")
    assert(closure_text(source).contains("unknown runtime function address rt_root_address installed in trap_root_rail_code"))
    library: "        {{name: \"rt_root_address\", shape: .FunctionAddress{{symbol: \"root_half\", arity: 1}}}},\n"
    assert_eq(runtime_function_addresses(library).get("rt_root_address") ?? "", "root_half")
}

// The runtime pack's strerror text, from pinned musl 1.2.5 assets (never a
// libc runtime dependency). The assets and their manifest are committed;
// generation is offline and every asset must match its manifest hash.

HOST_ERRORS_TARGET_PATH: "Compiler/JetRuntime/Source/HostErrors.jet"
MUSL_ASSETS_DIRECTORY: "Compiler/JetRuntime/Assets/MuslErrno1_2_5"

// errno.h `#define ENAME VALUE` rows; VALUE is a number or another name.
ErrnoDefinition: struct {
    name: String
    value: String
}

ErrnoMessage: struct {
    number: Int
    text: String
}

is_word: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        if !is_name_byte(Int.from_u8(byte)) -> return false
    }
    true
}

is_decimal: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        if !is_digit_byte(Int.from_u8(byte)) -> return false
    }
    true
}

// The whitespace-separated words of `line`.
line_words: fn(line: String) -> [String] Never! {
    words := [String]{}
    bytes: line.bytes()
    at := 0
    loop at < bytes.len() {
        at = skip_spaces(bytes, at)
        if at >= bytes.len() -> break
        start: at
        loop at < bytes.len() && !is_space_byte(Int.from_u8(bytes[at])) -> at += 1
        words.push(byte_slice(line, start, at))
    }
    words
}

errno_definitions: fn(header: String) -> [ErrnoDefinition] Never! {
    rows := [ErrnoDefinition]{}
    loop line in header.split("\n") {
        words: line_words(line)
        if words.len() != 3 || words[0] != "#define" || !words[1].starts_with("E") || !is_word(words[1]) || !is_word(words[2]) -> next
        if !line.starts_with("#define") -> next
        rows.push(ErrnoDefinition{name: words[1], value: words[2]})
    }
    rows
}

// The number an errno name resolves to through its #define chain.
errno_number: fn(definitions: [ErrnoDefinition], name: String) -> Int GeneratorError! {
    current := name
    chain := [String]{}
    loop {
        if is_decimal(current) {
            if Int.parse(current) == {
                .Ok(value) -> return Ok(value)
                .Err(_) -> { return Err(generator_fail("unresolved errno {name}")) }
            }
        }
        if chain.contains(current) -> return Err(generator_fail("unresolved errno {name}"))
        chain.push(current.copy())
        found := ""
        loop definition in definitions {
            if definition.name == current {
                found = definition.value
                break
            }
        }
        if found == "" -> return Err(generator_fail("unresolved errno {name}"))
        current = found
    }
}

// strerror.h `E(NAME, "text")` rows, in order.
errno_messages: fn(table: String, definitions: [ErrnoDefinition]) -> [ErrnoMessage] GeneratorError! {
    messages := [ErrnoMessage]{}
    problems := [String]{}
    loop line in table.split("\n") {
        if !line.starts_with("E(") -> next
        rest: byte_tail(line, 2)
        name: leading_name(rest)
        if name == "" -> next
        after_name: byte_tail(rest, byte_len(name))
        if !after_name.starts_with(",") -> next
        literal_text: byte_tail(after_name, 1).trim_start()
        if !literal_text.starts_with("\"") -> next
        literal: quoted_literal(literal_text) ?? return Err(generator_fail("unsupported strerror literal: {line}"))
        if !byte_tail(literal_text, literal.spelling_len).starts_with(")") -> next
        if errno_number(definitions, name) == {
            .Ok(number) -> messages.push(ErrnoMessage{number: number, text: literal.value})
            .Err(error) -> problems.push(error.message)
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    numbers := [Int]{}
    loop message in messages {
        if numbers.contains(message.number) -> return Err(generator_fail("invalid strerror source entries"))
        numbers.push(message.number)
    }
    if messages.len() == 0 || messages[0].number != 0 -> return Err(generator_fail("invalid strerror source entries"))
    Ok(messages)
}

// The leading run of word characters of `text`.
leading_name: fn(text: String) -> String Never! {
    bytes: text.bytes()
    end := 0
    loop end < bytes.len() && is_name_byte(Int.from_u8(bytes[end])) -> end += 1
    byte_slice(text, 0, end)
}

errno_word_rows: fn(text: String, indent: String, rows: &[String]) {
    loop word in text_words(text) -> rows.push("{indent}rt_text_push_word(text, I64{{{word.value}}}, I64{{{word.count}}})")
}

// One static text holds the messages, a line per errno 0..highest in errno
// order, so a lookup costs a short scan instead of a branch and a push per
// message.
render_host_errors: fn(messages: [ErrnoMessage]) -> String GeneratorError! {
    highest := 0
    loop message in messages {
        if message.number > highest -> highest = message.number
    }
    lines := [String]{}
    loop lines.len() <= highest -> lines.push("")
    loop message in messages {
        loop byte in message.text.bytes() {
            code: Int.from_u8(byte)
            if code < 32 || code > 126 || code == 34 || code == 92 || code == 123 || code == 125 -> return Err(generator_fail("errno {message.number}: message is not plain printable ASCII"))
        }
        lines[message.number] = message.text
    }
    table := ""
    loop line in lines -> table = "{table}{line}\\n"
    rows := [String]{
        "// Generated by Tools/agent/RuntimeGenerators.jet from pinned musl 1.2.5 assets.",
        "// Source hashes and MIT attribution: Assets/MuslErrno1_2_5/manifest.json + COPYRIGHT.",
        "// Native-pack wording is musl, not GNU Rust-tier strerror wording.",
        "",
        "// The messages as one static text, a line per errno 0..{highest}, each ended",
        "// by LF. An errno whose line is empty, or past the last, has line 0's.",
        "host_errno_append: fn(text: I64, errno: I64) {{",
        "    table: rt_text_data(rt_static_text(\"{table}\"))",
        "    index := if (errno > I64{{0}} && errno <= I64{{{highest}}}) -> errno else -> I64{{0}}",
        "    loop {{",
        "        start := I64{{0}}",
        "        line := I64{{0}}",
        "        loop line < index {{",
        "            if (rt_text_byte(wrapping(table + start)) == I64{{10}}) -> line += I64{{1}}",
        "            start += I64{{1}}",
        "        }}",
        "        end := start",
        "        loop rt_text_byte(wrapping(table + end)) != (I64{{10}}) -> end += I64{{1}}",
        "        if (end > start || index == I64{{0}}) {{",
        "            rt_text_append(text, wrapping(table + start), end - start)",
        "            return",
        "        }}",
        "        index = I64{{0}}",
        "    }}",
        "}}",
    }
    middle: [String]{"", "host_errno_cause_append: fn(text: I64, errno: I64) {{", "    host_errno_append(text, errno)"}
    loop row in middle -> rows.push(row)
    errno_word_rows(" (os error ", "    ", rows)
    rows.push("    rt_text_push_number(text, errno)")
    errno_word_rows(")", "    ", rows)
    tail: [String]{"}}", "", "host_errno_text: fn(errno: I64) -> I64 {{", "    text: jet_rt_string_builder_new()", "    host_errno_append(text, errno)", "    jet_rt_string_builder_finish(text)", "}}", "", "host_errno_cause: fn(errno: I64) -> I64 {{", "    text: jet_rt_string_builder_new()", "    host_errno_cause_append(text, errno)", "    jet_rt_string_builder_finish(text)", "}}"}
    loop row in tail -> rows.push(row)
    Ok("{rows.join("\n")}\n")
}

// The text a Dyn Text holds; "" for any other value.
dyn_text: fn(value: Dyn) -> String Never! {
    if value == {
        .Text(text) -> text
        else -> ""
    }
}

// The manifest's pinned sha256 for asset `name`, or "" when it names none.
manifest_sha256: fn(manifest: Dyn, name: String) -> String Never! {
    rows: manifest.field("files") ?? return ""
    if rows == {
        .Array(items) -> {
            loop row in items {
                row_name: row.field("name") ?? next
                if dyn_text(row_name) != name -> next
                sha: row.field("sha256") ?? return ""
                return dyn_text(sha)
            }
            ""
        }
        else -> ""
    }
}

read_host_errors: fn() -[FS]> String GeneratorError! {
    manifest_path: "{MUSL_ASSETS_DIRECTORY}/manifest.json"
    manifest_text: files.read(manifest_path) ?? return Err(generator_fail("cannot read {manifest_path}: {err}"))
    manifest: json.parse(manifest_text) ?? return Err(generator_fail("invalid errno source manifest"))
    version: manifest.field("version") ?? return Err(generator_fail("invalid errno source manifest"))
    license: manifest.field("license") ?? return Err(generator_fail("invalid errno source manifest"))
    if dyn_text(version) != "musl-1.2.5" || dyn_text(license) != "MIT" -> return Err(generator_fail("invalid errno source manifest"))
    problems := [String]{}
    assets: [String]{"strerror.h", "errno.h", "COPYRIGHT"}
    loop name in assets {
        path: "{MUSL_ASSETS_DIRECTORY}/{name}"
        if files.read_bytes(path) == {
            .Ok(bytes) -> {
                if crypto.sha256(bytes).hex() != manifest_sha256(manifest, name) -> problems.push("{name}: pinned errno asset changed")
            }
            .Err(error) -> problems.push("cannot read {path}: {error}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    header: files.read("{MUSL_ASSETS_DIRECTORY}/errno.h") ?? return Err(generator_fail("cannot read errno.h: {err}"))
    table: files.read("{MUSL_ASSETS_DIRECTORY}/strerror.h") ?? return Err(generator_fail("cannot read strerror.h: {err}"))
    messages: errno_messages(table, errno_definitions(header)) ?? return Err(err)
    render_host_errors(messages)
}

#Test("errno names resolve through their define chain and strerror rows keep their order") {
    header: "#define EPERM 1\n#define ENOENT 2\n#define EWOULDBLOCK EAGAIN\n#define EAGAIN 11\n#define ELOOPA ELOOPB\n#define ELOOPB ELOOPA\n"
    definitions: errno_definitions(header)
    assert_eq(errno_number(definitions, "EWOULDBLOCK") ?? 0 - 1, 11)
    if errno_number(definitions, "ELOOPA") == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message, "unresolved errno ELOOPA")
    }
    table: "/* comment */\nE(0,            \"No error information\")\n\nE(EPERM,        \"Operation not permitted\")\nE(EWOULDBLOCK,  \"Resource \\\"temporarily\\\" unavailable\")\n"
    messages: errno_messages(table, definitions) ?? panic("rows did not parse: {err.message}")
    assert_eq(messages.len(), 3)
    assert_eq(messages[2].number, 11)
    assert_eq(messages[2].text, "Resource \"temporarily\" unavailable")
    if render_host_errors(messages) == {
        .Ok(_) -> assert(false)
        .Err(error) -> assert_eq(error.message, "errno 11: message is not plain printable ASCII")
    }
    // A line per errno up to the highest; a missing errno's line is empty.
    plain: [ErrnoMessage]{ErrnoMessage{number: 0, text: "No error information"}, ErrnoMessage{number: 2, text: "No such file"}}
    text: render_host_errors(plain) ?? panic("rows did not render: {err.message}")
    assert(text.contains("rt_static_text(\"No error information\\n\\nNo such file\\n\")"))
    assert(text.contains("errno <= I64{{2}}"))
}
