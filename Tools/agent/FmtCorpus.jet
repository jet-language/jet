#!/usr/bin/env jet
// Format corpus: every tracked Jet source under Compiler/, Core/, Examples/,
// Jetpack/, Tools/ and tests/ is in the canonical form `jet fmt` writes, and
// this tool keeps it so. `--check` names each source the formatter would
// change; `--write` formats those sources in place (the one deliberate corpus
// cutover), checks that a second pass changes nothing, and moves every line
// pin that names a formatted source. The formatter is the one of the compiler
// `$JET` names (default `jet`).
//
// A format keeps meaning: `jet fmt` itself refuses a source whose formatted
// text would parse to a different program (an internal compiler error naming
// the first node that differs), so the source stays as written. This tool
// reports each such source and exits 1, so a formatter defect can't change
// what the corpus means.
//
// A line pin is `<file>.jet:<line>` or `<file>.jet:<line>:<column>` in a
// tracked `.case` or expectation file (`.out`, `.stdout`, `.stderr`, `.err`,
// `.warn`, `.expected`, `.fixture`, `.log`, `.txt`, `.json`, `.tsv`, `.list`).
// `jet fmt` keeps the tokens and changes blank space, besides a few canonical
// spellings (`Unit` to `()`, a trailing comma), so a pin moves to where the
// non-blank byte it pointed at (or the next one both texts keep) now sits.
// A relative name means the sources of a case's fixtures and folder, or of an
// expectation's stem folder and its nearest folder that holds sources; a name
// the checkout root resolves means that source. Snapshots of the UI, golden
// and case suites move too, and `jet test Compiler -u` then rewrites their
// source excerpts.
//
// The corpus leaves out, by rule:
// - generated: a `//` line among a source's first five says a tool generates
//   it, or it is an FFI adaptation's `after.jet` facade; its generator
//   writes it;
// - formatter input: tests/cases/fmt*/, and the fixtures and named sources of
//   any case that runs `jet fmt`, whose unformatted bytes are the test;
// - Compiler/JetDevserver (#5931), which doesn't compile;
// - evidence: a source a recorded run under Tools/agent-eval/ pins by line;
//   its receipts stay as run, so their pins don't move;
// - does not parse: a negative fixture `jet fmt` refuses, found while it runs.
//
// One bad source never stalls a run: each formatter run has a time limit
// (FMT_LIMIT_BASE_MS, plus FMT_LIMIT_PER_SOURCE_MS per source), and a run
// that passes it, dies on a signal or fails without naming a refused source
// is split in halves until the source it hangs or crashes on runs alone.
// That source is set aside, the run goes on, and every such source is
// reported at the end with what happened; the run then exits 1.
//
// Usage (from anywhere in the checkout):
//   jet Tools/agent/FmtCorpus.jet --list [PREFIX...]
//   jet Tools/agent/FmtCorpus.jet --excluded [PREFIX...]
//   jet Tools/agent/FmtCorpus.jet --check [--simplify] [PREFIX...]
//   jet Tools/agent/FmtCorpus.jet --write [--simplify] [PREFIX...]
//   jet Tools/agent/FmtCorpus.jet --frame-diff REV
// `--excluded` prints each left-out source after its rule, then the count of
// each rule. A PREFIX keeps only the sources under that repository path.
// `--simplify` runs `jet fmt --simplify`, the rewriter's canonical spelling.
// `--frame-diff` is the cutover's dry-run report: after `--write` is committed
// as REV and `jet test Compiler -u` re-blesses the snapshots, it prints each
// file other than a Jet source that changed since REV beyond its code frames
// (the `  4 | source` excerpt and caret lines a diagnostic shows), and each new
// file. Those are the rows whose outcome the format changed, not just their
// excerpts.
use {
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

TOOL: "/Tools/agent/FmtCorpus.jet"

USAGE: "usage: jet Tools/agent/FmtCorpus.jet --list|--excluded|--check|--write [--simplify] [PREFIX...] | --frame-diff REV"

// A code-frame line: an optional line number, then the `|` gutter.
FRAME_LINE: Regex{"^\s*\d*\s*\|"}

ROOTS: [String]{"Compiler", "Core", "Examples", "Jetpack", "Tools", "tests"}

RULE_GENERATED: "generated"

RULE_FORMATTER_INPUT: "formatter input"

RULE_DEVSERVER: "Compiler/JetDevserver (#5931)"

RULE_EVIDENCE: "evidence"

RULE_UNPARSED: "does not parse"

// Trees the corpus leaves out whole, with their rule.
EXCLUDED_TREES: [String]{"tests/cases/fmt", "Compiler/JetDevserver/"}

EXCLUDED_TREE_RULES: [String]{RULE_FORMATTER_INPUT, RULE_DEVSERVER}

ADAPTATION_FILE: "after.jet"

PIN_SUFFIXES: [String]{".case", ".out", ".stdout", ".stderr", ".err", ".warn", ".expected", ".fixture", ".log", ".txt", ".json", ".tsv", ".list"}

// The board's records are not expectations.
UNSCANNED: [String]{"Tools/tower/"}

// Recorded runs, whose receipts are not rewritten.
EVIDENCE_TREE: "Tools/agent-eval/"

GENERATED_HEAD_LINES: 5

// Sources per formatter run.
BATCH: 400

// A formatter run may take FMT_LIMIT_BASE_MS plus FMT_LIMIT_PER_SOURCE_MS for
// each source it formats; past that, it hangs.
FMT_LIMIT_BASE_MS: 10000

FMT_LIMIT_PER_SOURCE_MS: 100

// Where `jet fmt` respelled a few bytes, the non-blank bytes either side may
// skip (ALIGN_REACH) before ALIGN_WINDOW of them agree again.
ALIGN_REACH: 64

ALIGN_WINDOW: 8

ROOTED_SOURCE: Regex{"(?:Compiler|Core|Examples|Jetpack|Tools|tests)/[A-Za-z0-9_./-]*\.jet"}

// git grep -E patterns (POSIX ERE) for the files worth reading.
PIN_GREP: "\\.jet:[0-9]"

FMT_STEP_GREP: "^step:.*jet fmt"

GENERATED_GREP: "^//.*(generated file|generated by|is generated)"

#Error
CorpusError: struct {
    message: String
}

// The sources kept out of the corpus, each with its rule: exact paths and
// folders whose whole tree is out.
Exclusions: struct {
    exact: [String:String]
    trees: [String:String]
}

// A tracked file whose text may pin source lines, and the folders its
// relative source names are read against.
PinSite: struct {
    path: String
    scopes: [String]
}

// The corpus sources of a run, the tracked Jet sources in the corpus roots it
// leaves out (each with its rule), every tracked source it saw, and the files
// that may pin their lines.
Corpus: struct {
    sources: [String]
    left_out: [String]
    rules: [String]
    known: [String:Bool]
    sites: [PinSite]
}

// What the formatter said about a corpus: the sources it would change, the
// sources it could not parse, the sources it hung or crashed on, and why it
// refused each source whose meaning its format would change.
FmtOutcome: struct {
    dirty: [String]
    unparsed: [String]
    failed: [FmtFailure]
    changed: [FmtFailure]
}

// A source the formatter hung or crashed on, and what happened.
FmtFailure: struct {
    path: String
    what: String
}

// A source position: a line from 1 and a character column from 1, or 0 for a
// pin that names only the line.
Position: struct {
    line: Int
    column: Int
}

// A `<name>.jet:<line>[:<column>]` pin in a text: the name as written, its
// position, and the byte spans of its line and column numbers (an empty
// column span when it has none).
PinSpot: struct {
    name: String
    at: Position
    line_start: Int
    line_end: Int
    column_start: Int
    column_end: Int
}

// What moving the pins did: files rewritten, pins moved, and why any pin
// that names a formatted source stayed as written.
PinReport: struct {
    files: Int
    pins: Int
    problems: [String]
}

no_exclusions: fn() -> Exclusions Never! {
    Exclusions{exact: [String:String]{}, trees: [String:String]{}}
}

// Records `rule` for `key` unless an earlier rule holds it.
note: fn(rules: &[String:String], key: String, rule: String) {
    if !rules.has_key(key) -> rules[key.copy()] = rule.copy()
}

// The stdout lines of a git command run at `root`, which must exit with one
// of `exits` (git grep exits 1 when nothing matches).
git_lines: fn(root: String, argv: [String], exits: [Int]) -[Exec, Time.Wait]> [String] CorpusError! {
    receipt: process.cmd(argv).cwd(root).stdout(.Capture).stderr(.Capture).run() ?? return Err(CorpusError{message: "cannot run {argv.join(" ")}: {err}"})
    if !exits.contains(receipt.code) {
        return Err(CorpusError{message: "{argv.join(" ")} failed ({receipt.code}): {receipt.errors}"})
    }
    lines := [String]{}
    loop line in receipt.output.lines() {
        if line != "" -> lines.push(line.copy())
    }
    Ok(lines)
}

// `git grep -l` of `pattern` over the corpus roots.
grep_roots: fn(root: String, flags: [String], pattern: String) -[Exec, Time.Wait]> [String] CorpusError! {
    argv := [String]{"git", "grep", "-l", "-I", "-E"}
    loop flag in flags -> argv.push(flag.copy())
    argv.push("-e")
    argv.push(pattern.copy())
    argv.push("--")
    loop corpus_root in ROOTS -> argv.push(corpus_root.copy())
    git_lines(root, argv, [Int]{0, 1})
}

base_name: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    if split.sep == "" -> return path.copy()
    split.tail.copy()
}

// The folder holding `path`; "" at the top.
parent: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    split.head.copy()
}

// The folders above `path`, outermost first: `a/b/c.jet` has `a` and `a/b`.
ancestors: fn(path: String) -> [String] Never! {
    found := [String]{}
    dir := parent(path)
    loop dir != "" {
        found.insert(0, dir.copy())
        dir = parent(dir)
    }
    found
}

// `relative` beneath the folder `dir`, with `./` steps dropped.
join: fn(dir: String, relative: String) -> String Never! {
    parts := [String]{}
    loop part in relative.split("/") {
        if part != "" && part != "." -> parts.push(part.copy())
    }
    if dir == "" -> return parts.join("/")
    "{dir}/{parts.join("/")}"
}

// The rule of the excluded tree holding `path`, else "".
tree_rule: fn(path: String) -> String Never! {
    loop (at, tree) in EXCLUDED_TREES {
        if path.starts_with(tree) -> return EXCLUDED_TREE_RULES[at].copy()
    }
    if base_name(path) == ADAPTATION_FILE -> return RULE_GENERATED
    ""
}

// Whether `path` is a tracked file whose line pins move with the sources.
is_pin_site: fn(path: String) -> Bool Never! {
    loop skipped in UNSCANNED {
        if path.starts_with(skipped) -> return false
    }
    loop suffix in PIN_SUFFIXES {
        if path.ends_with(suffix) -> return true
    }
    false
}

// Whether a `//` line among the first lines of `text` says a tool generates it.
is_generated_head: fn(text: String) -> Bool Never! {
    loop (at, line) in text.lines() {
        if at >= GENERATED_HEAD_LINES -> return false
        lower: line.lower()
        if lower.starts_with("//") && (lower.contains("generated file") || lower.contains("generated by") || lower.contains("is generated")) {
            return true
        }
    }
    false
}

// The fixture folders a case at `path` names (`fixture: fixtures/x`, relative
// to the case's folder, or `{root}/...`).
case_fixtures: fn(path: String, text: String) -> [String] Never! {
    found := [String]{}
    loop line in text.lines() {
        if !line.starts_with("fixture:") -> next
        value: line.remove_prefix("fixture:").trim()
        if value == "" -> next
        if value.starts_with("{{root}}/") {
            found.push(join("", value.remove_prefix("{{root}}/")))
            next
        }
        found.push(join(parent(path), value))
    }
    found
}

// Whether a case's text runs `jet fmt` in one of its steps.
runs_fmt: fn(text: String) -> Bool Never! {
    loop line in text.lines() {
        if line.starts_with("step:") && line.contains("jet fmt") -> return true
    }
    false
}

// Keeps out the fixtures of a case at `path` that runs `jet fmt`, and every
// source it names by repository path.
add_fmt_case_inputs: fn(path: String, text: String, out: &Exclusions) {
    if !runs_fmt(text) {
        return
    }
    loop fixture in case_fixtures(path, text) -> note(out.trees, fixture, RULE_FORMATTER_INPUT)
    loop found in ROOTED_SOURCE.find_all(text) -> note(out.exact, found, RULE_FORMATTER_INPUT)
}

// The folders a case's relative source names mean: its fixtures, then its own folder.
case_scopes: fn(path: String, text: String) -> [String] Never! {
    scopes := case_fixtures(path, text)
    scopes.push(parent(path))
    scopes
}

// The folders an expectation's relative source names mean: the folder named
// for its stem, then the nearest folder at or above its own that holds
// sources (`dirs`).
expectation_scopes: fn(path: String, dirs: [String:Bool]) -> [String] Never! {
    scopes := [String]{}
    dir: parent(path)
    folder: join(dir, base_name(path).partition(".").head)
    if dirs.has_key(folder) -> scopes.push(folder)
    up := dir
    loop up != "" && !dirs.has_key(up) -> up = parent(up)
    if up != "" -> scopes.push(up)
    scopes
}

// The rule that keeps `path` out, else "".
exclusion_rule: fn(path: String, exclusions: Exclusions) -> String Never! {
    tree: tree_rule(path)
    if tree != "" -> return tree
    if exclusions.exact.get(path) == .Val(rule) -> return rule.copy()
    loop dir in ancestors(path) {
        if exclusions.trees.get(dir) == .Val(rule) -> return rule.copy()
    }
    ""
}

// Whether `path` lies under one of `prefixes`; no prefix keeps every path.
selected: fn(path: String, prefixes: [String]) -> Bool Never! {
    if prefixes.len() == 0 -> return true
    loop prefix in prefixes {
        trimmed: prefix.removesuffix("/")
        if path == trimmed || path.starts_with("{trimmed}/") -> return true
    }
    false
}

read_tracked: fn(root: String, path: String) -[FS.Read]> String CorpusError! {
    files.read("{root}/{path}") ?? return Err(CorpusError{message: "cannot read {path}: {err}"})
}

// Everything kept out of the corpus by reading the tracked tree at `root`.
exclusions: fn(root: String) -[Exec, FS.Read, Time.Wait]> Exclusions CorpusError! {
    out := no_exclusions()
    loop path in grep_roots(root, [String]{"-i"}, GENERATED_GREP) ?? return Err(err) {
        if path.ends_with(".jet") && is_generated_head(read_tracked(root, path) ?? return Err(err)) {
            note(out.exact, path, RULE_GENERATED)
        }
    }
    loop path in grep_roots(root, [String]{}, FMT_STEP_GREP) ?? return Err(err) {
        if path.ends_with(".case") {
            add_fmt_case_inputs(path, read_tracked(root, path) ?? return Err(err), out)
        }
    }
    Ok(out)
}

// Every tracked file at `root` that may pin source lines, outside the
// evidence; `dirs` are the folders above a tracked source. The sources an
// evidence file pins (by `known`) are kept out in `out`.
pin_sites: fn(root: String, dirs: [String:Bool], known: [String:Bool], out: &Exclusions) -[Exec, FS.Read, Time.Wait]> [PinSite] CorpusError! {
    sites := [PinSite]{}
    loop path in grep_roots(root, [String]{}, PIN_GREP) ?? return Err(err) {
        if !is_pin_site(path) -> next
        text: if path.ends_with(".case") || path.starts_with(EVIDENCE_TREE) -> read_tracked(root, path) ?? return Err(err) else -> ""
        scopes: if path.ends_with(".case") -> case_scopes(path, text) else -> expectation_scopes(path, dirs)
        if path.starts_with(EVIDENCE_TREE) {
            loop spot in pin_spots(text) {
                loop target in pin_targets(spot.name, scopes, known) {
                    note(out.exact, target, RULE_EVIDENCE)
                }
            }
            next
        }
        sites.push(PinSite{path: path.copy(), scopes: scopes})
    }
    Ok(sites)
}

// The corpus sources under `prefixes`.
corpus: fn(root: String, prefixes: [String]) -[Exec, FS.Read, Time.Wait]> Corpus CorpusError! {
    argv := [String]{"git", "ls-files", "--"}
    loop corpus_root in ROOTS -> argv.push(corpus_root.copy())
    tracked := [String]{}
    known := [String:Bool]{}
    dirs := [String:Bool]{}
    loop path in git_lines(root, argv, [Int]{0}) ?? return Err(err) {
        if !path.ends_with(".jet") || !selected(path, prefixes) -> next
        tracked.push(path.copy())
        known[path.copy()] = true
        loop dir in ancestors(path) -> dirs[dir.copy()] = true
    }
    out := exclusions(root) ?? return Err(err)
    sites: pin_sites(root, dirs, known, out) ?? return Err(err)
    found := Corpus{sources: [String]{}, left_out: [String]{}, rules: [String]{}, known: known, sites: sites}
    loop path in tracked {
        rule: exclusion_rule(path, out)
        if {
            rule == "" -> found.sources.push(path.copy())
            else -> {
                found.left_out.push(path.copy())
                found.rules.push(rule)
            }
        }
    }
    Ok(found)
}

is_digit: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// A byte a pinned name can hold: a letter, digit, `_`, `.`, `/` or `-`.
is_name_byte: fn(code: Int) -> Bool Never! {
    (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || is_digit(code) || code == 95 || code == 46 || code == 47 || code == 45
}

// Blank space: space, tab, newline or carriage return.
is_blank: fn(code: Int) -> Bool Never! { code == 32 || code == 9 || code == 10 || code == 13 }

// Where the run of digits in `bytes` from `start` ends.
digits_end: fn(bytes: [U8], start: Int) -> Int Never! {
    end := start
    loop end < bytes.len() && is_digit(Int{bytes[end]}) -> end += 1
    end
}

// The number the digits of `bytes` from `start` to `end` spell.
number_at: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    value := 0
    loop at in start..<end -> value = value * 10 + (Int{bytes[at]}) - 48
    value
}

// Whether `bytes` holds `marker` at `at`.
holds_at: fn(bytes: [U8], at: Int, marker: [U8]) -> Bool Never! {
    if at + marker.len() > bytes.len() -> return false
    loop (index, byte) in marker {
        if bytes[at + index] != byte -> return false
    }
    true
}

// Every `<name>.jet:<line>[:<column>]` pin in `text`, in order.
pin_spots: fn(text: String) -> [PinSpot] Never! {
    bytes: text.bytes()
    marker: ".jet:".bytes()
    spots := [PinSpot]{}
    at := 0
    loop at < bytes.len() {
        line_start: at + marker.len()
        if !holds_at(bytes, at, marker) || line_start >= bytes.len() || !is_digit(Int{bytes[line_start]}) {
            at += 1
            next
        }
        start := at
        loop start > 0 && is_name_byte(Int{bytes[start - 1]}) -> start -= 1
        line_end: digits_end(bytes, line_start)
        column_start := line_end
        column_end := line_end
        if line_end + 1 < bytes.len() && (Int{bytes[line_end]}) == 58 && is_digit(Int{bytes[line_end + 1]}) {
            column_start = line_end + 1
            column_end = digits_end(bytes, column_start)
        }
        line: number_at(bytes, line_start, line_end)
        if start < at && line > 0 {
            name := [U8]{}
            loop index in start..<at + 4 -> name.push(bytes[index])
            column: number_at(bytes, column_start, column_end)
            spots.push(
                PinSpot{
                    name: String.from_bytes(name) ?? "",
                    at: Position{line: line, column: column},
                    line_start: line_start,
                    line_end: line_end,
                    column_start: column_start,
                    column_end: column_end,
                },
            )
        }
        at = column_end
    }
    spots
}

// The tracked sources (`known`) a pinned `name` can mean: a folder of
// `scopes`, or the checkout root, joined with a trailing part of `name` cut
// at a `/`.
pin_targets: fn(name: String, scopes: [String], known: [String:Bool]) -> [String] Never! {
    found := [String]{}
    parts: name.split("/").to_list()
    tails := [String]{}
    tail := ""
    loop index in 0..<parts.len() {
        part: parts[parts.len() - 1 - index]
        if part == "" || part == "." || part == ".." -> break
        tail = if tail == "" -> part.copy() else -> "{part}/{tail}"
        tails.push(tail.copy())
    }
    loop scope in scopes {
        loop relative in tails {
            candidate: join(scope, relative)
            if known.has_key(candidate) && !found.contains(candidate) -> found.push(candidate)
        }
    }
    loop relative in tails {
        if known.has_key(relative) && !found.contains(relative) -> found.push(relative.copy())
    }
    found
}

// The non-blank bytes of `bytes`, in order.
ink: fn(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop byte in bytes {
        if !is_blank(Int{byte}) -> out.push(byte)
    }
    out
}

// Whether `old` from `i` and `new` from `j` agree for ALIGN_WINDOW bytes, or
// to both their ends.
agrees: fn(old: [U8], i: Int, new: [U8], j: Int) -> Bool Never! {
    old_left: old.len() - i
    new_left: new.len() - j
    if (old_left < ALIGN_WINDOW || new_left < ALIGN_WINDOW) && old_left != new_left -> return false
    limit: if old_left < ALIGN_WINDOW -> old_left else -> ALIGN_WINDOW
    loop at in 0..<limit {
        if old[i + at] != new[j + at] -> return false
    }
    true
}

// For each non-blank byte of `before`, and one past its last, the index of
// the non-blank byte of `after` it lines up with. `jet fmt` keeps the tokens
// and changes blank space, besides a few canonical spellings (`Unit` to `()`,
// a trailing comma): where the two streams differ, the bytes either side skips
// are found by the nearest point, within ALIGN_REACH bytes on each side, where
// they agree again; a byte `before` drops lines up with the next byte they
// share. The two ends agree only after at most ALIGN_WINDOW skipped bytes on
// each side. None when no such point is near.
ink_map: fn(before: [U8], after: [U8]) -> [Int]? Never! {
    old: ink(before)
    new: ink(after)
    map := [Int]{}
    i := 0
    j := 0
    loop i < old.len() {
        if j < new.len() && old[i] == new[j] {
            map.push(j)
            i += 1
            j += 1
            next
        }
        skip_old := -1
        skip_new := -1
        loop reach in 1..<2 * ALIGN_REACH + 1 {
            loop dropped in 0..<reach + 1 {
                added: reach - dropped
                if dropped > ALIGN_REACH || added > ALIGN_REACH || i + dropped > old.len() || j + added > new.len() {
                    next
                }
                at_end: i + dropped == old.len() && j + added == new.len()
                if at_end && (dropped > ALIGN_WINDOW || added > ALIGN_WINDOW) -> next
                if agrees(old, i + dropped, new, j + added) {
                    skip_old = dropped
                    skip_new = added
                    break
                }
            }
            if skip_old >= 0 -> break
        }
        if skip_old < 0 -> return None
        loop _ in 0..<skip_old -> map.push(j + skip_new)
        i += skip_old
        j += skip_new
    }
    map.push(new.len())
    Val(map)
}

// How many non-blank bytes of `bytes` come before position `at` (column 0 is
// the line's start).
ink_before: fn(bytes: [U8], at: Position) -> Int Never! {
    line := 1
    column := 1
    count := 0
    loop byte in bytes {
        code: Int{byte}
        lead: code < 128 || code >= 192
        if lead && (line > at.line || (line == at.line && column >= at.column)) -> return count
        if code == 10 {
            line += 1
            column = 1
            next
        }
        if !is_blank(code) -> count += 1
        if lead -> column += 1
    }
    count
}

// The position of the non-blank byte numbered `index` (from 0) in `bytes`.
ink_position: fn(bytes: [U8], index: Int) -> Position? Never! {
    line := 1
    column := 1
    count := 0
    loop byte in bytes {
        code: Int{byte}
        if code == 10 {
            line += 1
            column = 1
            next
        }
        if !is_blank(code) {
            if count == index -> return Val(Position{line: line, column: column})
            count += 1
        }
        if code < 128 || code >= 192 -> column += 1
    }
    None
}

// Where `at` in `before` sits in `after`, given the `ink_map` of the two: the
// position of the byte the non-blank byte at or after `at` lines up with. A
// line-only pin stays line-only.
remap: fn(before: [U8], after: [U8], map: [Int], at: Position) -> Position? Never! {
    index: ink_before(before, at)
    if index >= map.len() -> return None
    moved: ink_position(after, map[index]) ?? return None
    if at.column == 0 -> return Val(Position{line: moved.line, column: 0})
    Val(moved)
}

// `text` with each pin of `spots` set to the matching position of `moved`.
rewrite_pins: fn(text: String, spots: [PinSpot], moved: [Position]) -> String Never! {
    bytes: text.bytes()
    out := [U8]{}
    at := 0
    loop (index, spot) in spots {
        to: moved[index]
        if to.line == spot.at.line && to.column == spot.at.column -> next
        loop copied in at..<spot.line_start -> out.push(bytes[copied])
        loop byte in "{to.line}".bytes() -> out.push(byte)
        at = spot.line_end
        if spot.column_end > spot.column_start {
            loop copied in at..<spot.column_start -> out.push(bytes[copied])
            loop byte in "{to.column}".bytes() -> out.push(byte)
            at = spot.column_end
        }
    }
    loop copied in at..<bytes.len() -> out.push(bytes[copied])
    String.from_bytes(out) ?? text.copy()
}

// The sources among `dirty` that a pin of `sites` names, each with its text
// before formatting.
pinned_sources: fn(root: String, found: Corpus, dirty: [String]) -[FS.Read]> [String:String] CorpusError! {
    formatting := [String:Bool]{}
    loop path in dirty -> formatting[path.copy()] = true
    before := [String:String]{}
    loop site in found.sites {
        loop spot in pin_spots(read_tracked(root, site.path) ?? return Err(err)) {
            loop target in pin_targets(spot.name, site.scopes, found.known) {
                if formatting.has_key(target) && !before.has_key(target) {
                    before[target.copy()] = read_tracked(root, target) ?? return Err(err)
                }
            }
        }
    }
    Ok(before)
}

// Moves every pin of `sites` that names a source of `before` (its text before
// formatting) to the same token in its formatted text.
move_pins: fn(root: String, found: Corpus, before: [String:String]) -[FS]> PinReport CorpusError! {
    report := PinReport{files: 0, pins: 0, problems: [String]{}}
    after := [String:String]{}
    maps := [String:[Int]]{}
    loop site in found.sites {
        text: read_tracked(root, site.path) ?? return Err(err)
        spots: pin_spots(text)
        moved := [Position]{}
        changed := 0
        loop spot in spots {
            targets: pin_targets(spot.name, site.scopes, found.known)
            formatted := false
            loop target in targets {
                if before.has_key(target) -> formatted = true
            }
            if !formatted {
                moved.push(spot.at)
                next
            }
            places := [Position]{}
            problem := ""
            loop target in targets {
                old: before.get(target) ?? ""
                if !before.has_key(target) {
                    places.push(spot.at)
                    next
                }
                if !after.has_key(target) {
                    new_text: read_tracked(root, target) ?? return Err(err)
                    maps[target.copy()] = ink_map(old.bytes(), new_text.bytes()) ?? [Int]{}
                    after[target.copy()] = new_text
                }
                map: maps.get(target) ?? [Int]{}
                if map.len() == 0 {
                    problem = "`jet fmt` changed {target} beyond blank space and canonical spellings"
                    break
                }
                // A pin past the last token names no token, and stays.
                places.push(remap(old.bytes(), (after.get(target) ?? "").bytes(), map, spot.at) ?? spot.at)
            }
            if problem == "" {
                loop place in places {
                    if place.line != places[0].line || place.column != places[0].column {
                        problem = "`{spot.name}` can mean {targets.join(", ")}, which move it differently"
                    }
                }
            }
            if problem != "" {
                report.problems.push("{site.path}: pin `{spot.name}:{spot.at.line}` stays: {problem}")
                moved.push(spot.at)
                next
            }
            moved.push(places[0])
            if places[0].line != spot.at.line || places[0].column != spot.at.column -> changed += 1
        }
        if changed > 0 {
            files.write("{root}/{site.path}", rewrite_pins(text, spots, moved)) ?? return Err(CorpusError{message: "cannot write {site.path}: {err}"})
            report.files += 1
            report.pins += changed
        }
    }
    Ok(report)
}

// The source a formatter diagnostic on `errors` points at (`--> path:line:col`).
fmt_refused_source: fn(errors: String) -> String? Never! {
    loop line in errors.lines() {
        rest: line.trim_start()
        if !rest.starts_with("--> ") -> next
        location: rest.remove_prefix("--> ").trim()
        column: location.rpartition(":")
        row: column.head.rpartition(":")
        if row.sep == "" -> return Val(location.copy())
        return Val(row.head.copy())
    }
    None
}

// One way to run the formatter: the checkout it runs in, the compiler, and
// its `jet fmt` flags (with `--check` it checks instead of writing).
Formatter: struct {
    root: String
    jet: String
    flags: [String]
}

// The words of the internal error `jet fmt` reports for a source whose format
// would change its syntax tree.
MEANING_CHANGE: "`jet fmt` would change the syntax tree of "

// `jet fmt`'s reason for refusing a source whose meaning its format would
// change, from the internal error on `errors`; None for any other refusal.
fmt_meaning_change: fn(errors: String) -> String? Never! {
    loop line in errors.lines() {
        at: line.find(MEANING_CHANGE)
        if at >= 0 -> return Val(line.slice(at..<line.len()).copy())
    }
    None
}

// `jet fmt` over `sources`. The formatter stops at the first source it
// refuses and names it; that source is set aside, as unparsed or as one whose
// meaning the format would change, and the sources before and after it run
// again. A refusal that names no source (a malformed `package.jet`) stops the
// whole run with nothing formatted or listed, so that run is split in halves
// until the refused source runs alone, and it is set aside as unparsed. A run
// that hangs or crashes is split the same way; the source it fails on is set
// aside as failed. Returns the number of formatter runs.
run_fmt: fn(formatter: Formatter, sources: [String], outcome: &FmtOutcome) -[Exec, Time.Wait]> Int CorpusError! {
    if sources.len() == 0 -> return Ok(0)
    checking: formatter.flags.contains("--check")
    argv := [String]{formatter.jet.copy(), "fmt"}
    loop flag in formatter.flags -> argv.push(flag.copy())
    loop source in sources -> argv.push(source.copy())
    limit_ms: FMT_LIMIT_BASE_MS + FMT_LIMIT_PER_SOURCE_MS * sources.len()
    receipt: process.cmd(argv).cwd(formatter.root).env("NO_COLOR", "1").stdout(.Capture).stderr(.Capture).timeout(time.duration_ms(limit_ms)).run() ?? return Err(CorpusError{message: "cannot run {formatter.jet} fmt: {err}"})
    // Under `--check`, exit 1 means a source would change.
    finished: if checking -> [Int]{0, 1} else -> [Int]{0}
    failure: if receipt.timed_out -> "hang: `jet fmt` ran past {limit_ms} ms" else -> fmt_crash(receipt.signal, receipt.code, finished, receipt.errors)
    unlocated: failure == "" && fmt_unlocated_refusal(receipt.errors)
    if failure != "" || unlocated {
        if sources.len() == 1 {
            if unlocated -> outcome.unparsed.push(sources[0].copy()) else -> outcome.failed.push(FmtFailure{path: sources[0].copy(), what: failure})
            return Ok(1)
        }
        half: sources.len() /% 2
        first: run_fmt(formatter, sources[0..<half], outcome) ?? return Err(err)
        second: run_fmt(formatter, sources[half..<sources.len()], outcome) ?? return Err(err)
        return Ok(1 + first + second)
    }
    if fmt_refused_source(receipt.errors) == .Val(refused) {
        at: sources.index_of(refused) ?? return Err(CorpusError{message: "`{formatter.jet} fmt` refused `{refused}`, which this run did not pass it:\n{receipt.errors}"})
        if fmt_meaning_change(receipt.errors) == .Val(change) -> outcome.changed.push(FmtFailure{path: refused.copy(), what: change}) else -> outcome.unparsed.push(refused.copy())
        before: run_fmt(formatter, sources[0..<at], outcome) ?? return Err(err)
        after: run_fmt(formatter, sources[at + 1..<sources.len()], outcome) ?? return Err(err)
        return Ok(1 + before + after)
    }
    if checking {
        loop line in receipt.output.lines() {
            path: line.trim()
            if path != "" -> outcome.dirty.push(path)
        }
    }
    Ok(1)
}

// Why a formatter run crashed, or "" when it didn't: a signal stopped it, or
// it exited with a code outside `finished` without naming the source it
// refused.
fmt_crash: fn(signal: Int?, code: Int, finished: [Int], errors: String) -> String Never! {
    if signal == .Val(number) -> return "crash: `jet fmt` stopped on signal {number}"
    if finished.contains(code) || fmt_refused_source(errors) != None || fmt_unlocated_refusal(errors) -> return ""
    "crash: `jet fmt` exited {code}: {first_line(errors)}"
}

// Whether `jet fmt` refused a run with a diagnostic that names no source (a
// malformed `package.jet`); it then formats and lists nothing, whatever its
// exit code.
fmt_unlocated_refusal: fn(errors: String) -> Bool Never! {
    if fmt_refused_source(errors) != None -> return false
    loop line in errors.lines() {
        if line.starts_with("Error [") -> return true
    }
    false
}

// The first line of `text` that holds more than blank space, trimmed.
first_line: fn(text: String) -> String Never! {
    loop line in text.lines() {
        if line.trim() != "" -> return line.trim()
    }
    "(no message)"
}

// `run_fmt` over `sources` in batches of BATCH.
fmt_corpus: fn(formatter: Formatter, sources: [String]) -[Exec, Time.Wait]> FmtOutcome CorpusError! {
    outcome := FmtOutcome{dirty: [String]{}, unparsed: [String]{}, failed: [FmtFailure]{}, changed: [FmtFailure]{}}
    batch := [String]{}
    loop source in sources {
        batch.push(source.copy())
        if batch.len() == BATCH {
            _: run_fmt(formatter, batch, outcome) ?? return Err(err)
            batch = [String]{}
        }
    }
    _: run_fmt(formatter, batch, outcome) ?? return Err(err)
    Ok(outcome)
}

// Reports each source the formatter hung or crashed on, after `stage`.
report_failures: fn(failed: [FmtFailure], stage: String) -[IO]> {
    loop failure in failed -> term.eprint("{failure.path}: {stage}: {failure.what}")
}

// One line per rule: its count of left-out sources, in first-seen order.
rule_counts: fn(rules: [String]) -> [String] Never! {
    names := [String]{}
    counts := [String:Int]{}
    loop rule in rules {
        if !counts.has_key(rule) {
            names.push(rule.copy())
            counts[rule.copy()] = 0
        }
        counts[rule.copy()] = (counts.get(rule) ?? 0) + 1
    }
    loop name in names -> "{counts.get(name) ?? 0}\t{name}"
}

corpus_main: fn(args: [String]) -[Env, Exec, FS, IO, Time.Wait]> Int CorpusError! {
    mode := ""
    simplify := [String]{}
    prefixes := [String]{}
    loop arg in args {
        if {
            arg == "--list" || arg == "--excluded" || arg == "--check" || arg == "--write" || arg == "--frame-diff" -> {
                if mode != "" -> return Err(CorpusError{message: USAGE})
                mode = arg.copy()
            }
            arg == "--simplify" -> simplify = [String]{"--simplify"}
            arg.starts_with("-") -> {
                return Err(CorpusError{message: "unknown option `{arg}`; {USAGE}"})
            }
            else -> prefixes.push(arg.copy())
        }
    }
    if mode == "" -> return Err(CorpusError{message: USAGE})
    if mode == "--frame-diff" {
        if prefixes.len() != 1 || simplify.len() > 0 -> return Err(CorpusError{message: USAGE})
        return frame_diff(repo_root(), prefixes[0])
    }
    root: repo_root()
    if root == "" -> return Err(CorpusError{message: "no checkout holds {TOOL}"})
    found: corpus(root, prefixes) ?? return Err(err)
    left_out: found.left_out.len()
    if mode == "--list" {
        loop source in found.sources -> print(source)
        print("fmt-corpus: {found.sources.len()} sources, {left_out} left out")
        return Ok(0)
    }
    if mode == "--excluded" {
        loop (at, path) in found.left_out -> print("{found.rules[at]}\t{path}")
        loop line in rule_counts(found.rules) -> print(line)
        print("fmt-corpus: {found.sources.len()} sources, {left_out} left out")
        return Ok(0)
    }
    jet: process.env_get_or("JET", "jet")
    check_flags := [String]{"--check"}
    loop flag in simplify -> check_flags.push(flag.copy())
    checker: Formatter{root: root.copy(), jet: jet.copy(), flags: check_flags}
    form: if simplify.len() > 0 -> "jet fmt --simplify" else -> "jet fmt"
    checked: fmt_corpus(checker, found.sources) ?? return Err(err)
    failed: checked.failed.len()
    meaning: checked.changed.len()
    parsed: found.sources.len() - checked.unparsed.len() - failed - meaning
    unparsed: checked.unparsed.len()
    loop change in checked.changed -> term.eprint(change.what)
    if mode == "--check" {
        loop path in checked.dirty -> print(path)
        report_failures(checked.failed, "`{form} --check`")
        if checked.dirty.len() > 0 || failed > 0 || meaning > 0 {
            term.eprint("fmt-corpus: {checked.dirty.len()} of {parsed} sources are not in `{form}` form and {meaning} would change meaning ({unparsed} don't parse, {failed} hang or crash the formatter, {left_out} left out); run `jet Tools/agent/FmtCorpus.jet --write{form.remove_prefix("jet fmt")}`")
            return Ok(1)
        }
        print("fmt-corpus: ok ({parsed} sources in `{form}` form, {unparsed} don't parse, {left_out} left out)")
        return Ok(0)
    }
    before := pinned_sources(root, found, checked.dirty) ?? return Err(err)
    wrote: fmt_corpus(Formatter{root: root.copy(), jet: jet.copy(), flags: simplify}, checked.dirty) ?? return Err(err)
    kept := [String:Bool]{}
    loop failure in wrote.failed {
        kept[failure.path.copy()] = true
        _: before.remove(failure.path)
    }
    // A source the write pass refused stays as written.
    loop path in wrote.unparsed {
        kept[path.copy()] = true
        _: before.remove(path)
    }
    loop change in wrote.changed {
        kept[change.path.copy()] = true
        _: before.remove(change.path)
    }
    formatted := [String]{}
    loop path in checked.dirty {
        if !kept.has_key(path) -> formatted.push(path.copy())
    }
    again: fmt_corpus(checker, formatted) ?? return Err(err)
    pins: move_pins(root, found, before) ?? return Err(err)
    loop path in formatted -> print(path)
    loop change in wrote.changed -> term.eprint(change.what)
    loop problem in pins.problems -> term.eprint(problem)
    loop path in again.dirty -> term.eprint("{path}: a second `jet fmt` pass changes it again")
    loop path in again.unparsed -> term.eprint("{path}: `jet fmt` wrote a source it can't parse")
    loop change in again.changed -> term.eprint("a second `jet fmt` pass: {change.what}")
    report_failures(checked.failed, "`{form} --check`")
    report_failures(wrote.failed, "`{form}`, so it stays as written")
    report_failures(again.failed, "a second `{form} --check`")
    unstable: again.dirty.len() + again.unparsed.len() + again.changed.len()
    hung: failed + wrote.failed.len() + again.failed.len()
    changed: meaning + wrote.changed.len()
    summary: "formatted {formatted.len()} of {parsed} sources ({unparsed} don't parse, {left_out} left out); moved {pins.pins} line pins in {pins.files} files"
    if unstable > 0 || pins.problems.len() > 0 || changed > 0 || hung > 0 {
        term.eprint("fmt-corpus: {summary}, but {changed} sources would change meaning, {unstable} sources are not stable, {hung} sources hang or crash the formatter and {pins.problems.len()} pins stay as written")
        return Ok(1)
    }
    print("fmt-corpus: {summary}")
    Ok(0)
}

// `text` without its code-frame lines.
without_frames: fn(text: String) -> String Never! {
    kept := [String]{}
    loop line in text.lines() {
        if !FRAME_LINE.is_match(line) -> kept.push(line.copy())
    }
    kept.join("\n")
}

// The text of `path` at `rev`, or None when `rev` has no such file.
git_show: fn(root: String, rev: String, path: String) -[Exec, Time.Wait]> String? Never! {
    receipt: process.cmd([String]{"git", "show", "{rev}:{path}"}).cwd(root).stdout(.Capture).stderr(.Capture).run() ?? return None
    if receipt.code != 0 -> return None
    Val(receipt.output.copy())
}

// Prints each file at `root` that changed since `rev` beyond its code frames,
// and each new file; Jet sources are the format's own change.
frame_diff: fn(root: String, rev: String) -[Exec, FS.Read, IO, Time.Wait]> Int CorpusError! {
    if root == "" -> return Err(CorpusError{message: "no checkout holds {TOOL}"})
    changed: git_lines(root, [String]{"git", "diff", "--name-only", rev, "--"}, [Int]{0}) ?? return Err(err)
    added: git_lines(root, [String]{"git", "ls-files", "--others", "--exclude-standard"}, [Int]{0}) ?? return Err(err)
    beyond := 0
    checked := 0
    loop path in changed {
        if path.ends_with(".jet") -> next
        checked += 1
        old: git_show(root, rev, path)
        exists: files.exists("{root}/{path}")
        new: if exists -> read_tracked(root, path) ?? return Err(err) else -> ""
        same: exists && old != None && without_frames(old ?? "") == without_frames(new)
        if !same {
            print(path)
            beyond += 1
        }
    }
    loop path in added {
        if path.ends_with(".jet") -> next
        print("{path} (new)")
        checked += 1
        beyond += 1
    }
    summary: "fmt-corpus: {beyond} of {checked} changed files differ beyond their code frames since {rev}"
    if beyond > 0 {
        term.eprint(summary)
        return Ok(1)
    }
    print(summary)
    Ok(0)
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? return ""
    loop {
        if files.exists("{dir}{TOOL}") -> return dir
        if dir == "/" || dir == "" -> return ""
        dir = files.dirname(dir)
    }
}

run: fn() {
    code: corpus_main(process.args()) ?? process.fail(2, err.message)
    if code != 0 -> process.exit(code)
}

#Test("whole trees and adaptation facades are left out by their rule") {
    assert_eq(tree_rule("Compiler/JetSema/Source/Sema/Scopes.jet"), "")
    assert_eq(tree_rule("tests/ui/bare_error_mark_is_not_a_contract.jet"), "")
    assert_eq(tree_rule("tests/cases/fmt_project/fixtures/x/main.jet"), RULE_FORMATTER_INPUT)
    assert_eq(tree_rule("Compiler/JetDevserver/Source/Session.jet"), RULE_DEVSERVER)
    assert_eq(tree_rule("Tools/agent-eval/runs/a/main.jet"), "")
    assert_eq(tree_rule("tests/fixtures/ffi_adaptations/BorrowedView/after.jet"), RULE_GENERATED)
    assert_eq(tree_rule("tests/conformance/corpus/core/web/store/subscribe_selector.jet"), "")
}

#Test("a generated head is a // line among the first five that says a tool generates it") {
    assert(is_generated_head("// GENERATED FILE — do not hand-edit.\nx: 1\n"))
    assert(is_generated_head("#!/usr/bin/env jet\n// This file is generated by Tools/agent/DiagnosticRows.jet; do not edit.\n"))
    assert(!is_generated_head("// Generated-name policy for binders\nx: 1\n"))
    assert(!is_generated_head("a: 1\nb: 2\nc: 3\nd: 4\ne: 5\n// Generated by a tool\n"))
}

#Test("a case's fixtures are relative to its folder or rooted") {
    text: "fixture: fixtures/one\nstep: jet build\nfixture: ./fixtures/two/\nfixture: {{root}}/Examples/Basics\n"
    assert_eq(case_fixtures("tests/cases/build_entry/x.case", text).join("|"), "tests/cases/build_entry/fixtures/one|tests/cases/build_entry/fixtures/two|Examples/Basics")
    assert_eq(case_scopes("tests/cases/a/x.case", "fixture: fixtures/x\n").join("|"), "tests/cases/a/fixtures/x|tests/cases/a")
    assert(runs_fmt("step: jet fmt --check main.jet\n"))
    assert(!runs_fmt("# jet fmt is not run here\nstep: jet check\n"))
}

#Test("pin sites are cases and expectations outside the board") {
    assert(is_pin_site("tests/ui/effects/x.stderr"))
    assert(is_pin_site("tests/cases/cli/help.case"))
    assert(is_pin_site("tests/known-failing.tsv"))
    assert(!is_pin_site("Tools/tower/.tower/tower.json"))
    assert(is_pin_site("Tools/agent-eval/runs/a/receipt.json"))
    assert(!is_pin_site("Core/Text/Fmt.jet"))
    dirs := [String:Bool]{}
    dirs["tests/fixtures"] = true
    dirs["tests/fixtures/Prep"] = true
    dirs["tests/fixtures/Prep/Cross"] = true
    assert_eq(expectation_scopes("tests/fixtures/Prep/Cross.stderr", dirs).join("|"), "tests/fixtures/Prep/Cross|tests/fixtures/Prep")
    assert_eq(expectation_scopes("tests/fixtures/Prep/out/run.expected", dirs).join("|"), "tests/fixtures/Prep")
}

#Test("a pin is a name, a line and an optional column") {
    spots: pin_spots("at {{work}}/src/main.jet:12:5 and Core/Text/Fmt.jet:7, not .jet:3 or x.jet:0 or a.jet:b\n")
    assert_eq(spots.len(), 2)
    assert_eq(spots[0].name, "/src/main.jet")
    assert_eq(spots[0].at.line, 12)
    assert_eq(spots[0].at.column, 5)
    assert_eq(spots[1].name, "Core/Text/Fmt.jet")
    assert_eq(spots[1].at.line, 7)
    assert_eq(spots[1].at.column, 0)
}

#Test("a pinned name means a scope's source or a rooted one") {
    known := [String:Bool]{}
    known["tests/cases/a/fixtures/x/main.jet"] = true
    known["tests/cases/a/fixtures/x/src/run.jet"] = true
    known["Core/Text/Fmt.jet"] = true
    scopes: [String]{"tests/cases/a/fixtures/x", "tests/cases/a"}
    assert_eq(pin_targets("main.jet", scopes, known).join("|"), "tests/cases/a/fixtures/x/main.jet")
    assert_eq(pin_targets("/tmp/work/src/run.jet", scopes, known).join("|"), "tests/cases/a/fixtures/x/src/run.jet")
    assert_eq(pin_targets("run.jet", scopes, known).join("|"), "")
    assert_eq(pin_targets("../../Core/Text/Fmt.jet", scopes, known).join("|"), "Core/Text/Fmt.jet")
}

#Test("a pin moves with its token when only blank space changes") {
    before: "f: fn(a:Int)->Int {{\n  a+1\n}}\n\n\nmain: fn() {{\n    x: f(1)\n}}\n".bytes()
    after: "f: fn(a: Int) -> Int {{\n    a + 1\n}}\n\nmain: fn() {{\n    x: f(1)\n}}\n".bytes()
    map: ink_map(before, after) ?? [Int]{}
    assert_eq(map.len(), ink(before).len() + 1)
    assert_eq(ink_map(before, "g: 1\n".bytes()) ?? [Int]{}, [Int]{})
    moved: remap(before, after, map, Position{line: 7, column: 8}) ?? Position{line: 0, column: 0}
    assert_eq(moved.line, 6)
    assert_eq(moved.column, 8)
    sum: remap(before, after, map, Position{line: 2, column: 4}) ?? Position{line: 0, column: 0}
    assert_eq(sum.line, 2)
    assert_eq(sum.column, 7)
    line_only: remap(before, after, map, Position{line: 6, column: 0}) ?? Position{line: 0, column: 0}
    assert_eq(line_only.line, 5)
    assert_eq(line_only.column, 0)
    assert((remap(before, after, map, Position{line: 99, column: 1}) ?? Position{line: 0, column: 0}).line == 0)
}

#Test("a pin moves past the formatter's canonical spellings") {
    before: "show: fn() -[FS, IO]> Unit {{\n    a: apply(2, fn(m: Int) {{\n        m\n    }})\n    b: 1\n}}\n".bytes()
    after: "show: fn() -[FS, IO]> () {{\n    a: apply(\n        2,\n        fn(m: Int) {{\n            m\n        }},\n    )\n    b: 1\n}}\n".bytes()
    map: ink_map(before, after) ?? [Int]{}
    assert(map.len() > 0)
    later: remap(before, after, map, Position{line: 5, column: 5}) ?? Position{line: 0, column: 0}
    assert_eq(later.line, 8)
    assert_eq(later.column, 5)
    inner: remap(before, after, map, Position{line: 3, column: 9}) ?? Position{line: 0, column: 0}
    assert_eq(inner.line, 5)
    assert_eq(inner.column, 13)
    respelled: remap(before, after, map, Position{line: 1, column: 23}) ?? Position{line: 0, column: 0}
    assert_eq(respelled.line, 1)
    assert_eq(respelled.column, 26)
}

#Test("rewriting moves only the pins that changed") {
    text: "main.jet:7:8 then main.jet:2 then main.jet:3:1\n"
    spots: pin_spots(text)
    moved: [Position]{Position{line: 6, column: 8}, Position{line: 2, column: 0}, Position{line: 10, column: 12}}
    assert_eq(rewrite_pins(text, spots, moved), "main.jet:6:8 then main.jet:2 then main.jet:10:12\n")
}

#Test("a fmt case keeps out its fixtures and the sources it names, and the first rule holds") {
    out := no_exclusions()
    add_fmt_case_inputs("tests/cases/cli/f.case", "fixture: fixtures/f\nstep: jet fmt --check {{root}}/Examples/Basics/Hello.jet\n", out)
    add_fmt_case_inputs("tests/cases/cli/g.case", "fixture: fixtures/g\nstep: jet check\n", out)
    note(out.exact, "Examples/Basics/Hello.jet", RULE_GENERATED)
    assert_eq(exclusion_rule("tests/cases/cli/fixtures/f/main.jet", out), RULE_FORMATTER_INPUT)
    assert_eq(exclusion_rule("Examples/Basics/Hello.jet", out), RULE_FORMATTER_INPUT)
    assert_eq(exclusion_rule("tests/cases/cli/fixtures/g/main.jet", out), "")
    assert_eq(rule_counts([String]{"b", "a", "b"}).join("|"), "2\tb|1\ta")
}

#Test("a meaning change is the internal error that names the source") {
    errors: "internal compiler error: `jet fmt` would change the syntax tree of `tests/a.jet`, so the file stays as written; the first difference is in `If`: `x` became `y`\n  --> tests/a.jet\nThis is a bug in jet, NOT in your program. Please report it,\n"
    assert_eq(fmt_refused_source(errors) ?? "", "tests/a.jet")
    assert_eq(fmt_meaning_change(errors) ?? "", "`jet fmt` would change the syntax tree of `tests/a.jet`, so the file stays as written; the first difference is in `If`: `x` became `y`")
    assert_eq(fmt_meaning_change("Error [jet.X]: no\n  --> tests/b.jet:4:27\n") ?? "none", "none")
}

#Test("code frames are the gutter lines a diagnostic shows") {
    shown: "Error [jet.X]: no\n  --> main.jet:4:27\n    |\n  4 | bare: fn() -> Int {{\n    |                   ^\n Why: because\n"
    assert_eq(without_frames(shown), "Error [jet.X]: no\n  --> main.jet:4:27\n Why: because")
}

#Test("the refused source is the path of the first diagnostic location") {
    errors: "Error [jet.InvalidStatement]: A unit-fallible signature has no `->`\n  --> tests/ui/bare.jet:4:27\n    |\n"
    assert_eq(fmt_refused_source(errors) ?? "", "tests/ui/bare.jet")
    assert_eq(fmt_refused_source("") ?? "none", "none")
}

#Test("a formatter run crashes on a signal or an exit no refusal explains") {
    refusal: "Error [jet.InvalidStatement]: no\n  --> tests/ui/bare.jet:4:27\n"
    checking: [Int]{0, 1}
    writing: [Int]{0}
    assert_eq(fmt_crash(Val(11), 0, writing, ""), "crash: `jet fmt` stopped on signal 11")
    assert_eq(fmt_crash(None, 101, writing, "\n  thread panicked: overflow\nmore\n"), "crash: `jet fmt` exited 101: thread panicked: overflow")
    assert_eq(fmt_crash(None, 2, writing, refusal), "")
    assert_eq(fmt_crash(None, 1, checking, ""), "")
    assert_eq(fmt_crash(None, 1, writing, ""), "crash: `jet fmt` exited 1: (no message)")
    assert_eq(fmt_crash(None, 0, writing, ""), "")
}

#Test("a diagnostic that names no source refuses the run, and is no crash") {
    manifest: "Error [jet.InvalidPackageManifest]: `package.jet` has a shape error\n Why: Package metadata policy is malformed\n"
    assert(fmt_unlocated_refusal(manifest))
    assert(!fmt_unlocated_refusal("Error [jet.InvalidStatement]: no\n  --> tests/ui/bare.jet:4:27\n"))
    assert(!fmt_unlocated_refusal(""))
    assert_eq(fmt_crash(None, 2, [Int]{0}, manifest), "")
}

#Test("prefixes select whole path segments") {
    assert(selected("Core/Text/Fmt.jet", [String]{}))
    assert(selected("Core/Text/Fmt.jet", [String]{"Core/Text/"}))
    assert(selected("Core/Text/Fmt.jet", [String]{"Core/Text/Fmt.jet"}))
    assert(!selected("Core/TextBox/A.jet", [String]{"Core/Text"}))
    assert_eq(ancestors("a/b/c.jet").join("|"), "a|a/b")
    assert_eq(join("a/b", "./c/../d/"), "a/b/c/../d")
}
