#!/usr/bin/env jet
// Respells the compiler's requests from the retired `comptime` word to `#run`,
// `#if` and `#loop`, and checks that no code still holds the word.
//
// Each rule matches the word followed by one space:
//   comptime use, comptime if, comptime loop  ->  #run use, #if, #loop
//   comptime fn, comptime NAME: fn            ->  #run fn, #run NAME: fn
//   NAME: comptime { X }                      ->  NAME: #run X, when X is one
//                                                 postfix operand on that line
//   comptime {                                ->  #run {
//   <comptime N: T>, `, comptime N: T`        ->  <N: T>, `, N: T`
//   `comptime` (the word alone in backticks)  ->  `#run`, except where it
//                                                 names the trace phase or the
//                                                 `jet explain effects` rung
// `{{ X }}`, a Jet string's literal braces, counts as `{ X }`. The rules
// match these shapes anywhere in a text file (code, strings, comments and
// docs), so prose that names the word unquoted, as a concept, stays. Dated
// records, generated output and the files that test the retired word are
// skipped (SKIPPED). After the rewrite a `.jet` file whose code, outside
// comments and strings, still holds the word is reported: no rule covers that
// use.
//
// Usage (from the repository root):
//   jet Tools/agent/PrepSpelling.jet [--check] [path...]
//   --check  write nothing; exit 1 when a file would change or code holds the word
// With no path, every tracked file that names the word is read. Running it
// twice changes nothing the second time.
use {
    files: core.files
    process: core.process
    term: core.term
}

WORD: "comptime"
USAGE: "usage: jet Tools/agent/PrepSpelling.jet [--check] [path...]"

// Dated records, generated output, the editor grammars (regenerated by `jet
// self devtools grammars`), this tool and the case that tests the retired word.
SKIPPED: [String]{
    "Docs/audits/",
    "Docs/proposals/",
    "Docs/research/",
    "Docs/site/dist/",
    "Docs/spec/syntax-decisions.md",
    "Tools/editors/",
    "Tools/tower/",
    "Tools/agent/PrepSpelling.jet",
    "tests/cases/ratified_p12/d_meta_spell1_forms.fixture/retired/",
}

#Error
SpellError: struct {
    message: String
}

// One file's rewritten text and how many uses it respelled.
Respelled: struct {
    text: String
    changes: Int
}

byte: fn(bytes: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= bytes.len() -> return -1
    Int.from_u8(bytes[at])
}

is_name_byte: fn(code: Int) -> Bool Never! {
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || (code >= 48 && code <= 57)
}

is_digit: fn(code: Int) -> Bool Never! {
    code >= 48 && code <= 57
}

// Whether `word` starts at `at` and ends at a word boundary.
word_at: fn(bytes: [U8], at: Int, word: String) -> Bool Never! {
    want: word.bytes()
    loop (offset, code) in want {
        if byte(bytes, at + offset) != Int.from_u8(code) -> return false
    }
    !is_name_byte(byte(bytes, at + want.len()))
}

// The end of the identifier starting at `at`, or `at` when none starts there.
name_end: fn(bytes: [U8], at: Int) -> Int Never! {
    first: byte(bytes, at)
    if first < 0 || !is_name_byte(first) || is_digit(first) -> return at
    end := at
    loop is_name_byte(byte(bytes, end)) -> end += 1
    end
}

// Whether the retired word starts at `at`: a whole word, not part of a path,
// a name or a site value, followed by one space.
word_use_at: fn(bytes: [U8], at: Int) -> Bool Never! {
    before: byte(bytes, at - 1)
    if is_name_byte(before) || before == 36 || before == 35 || before == 46 || before == 47 || before == 45 -> return false
    word_at(bytes, at, WORD) && byte(bytes, at + 8) == 32
}

// The end of the quoted text opening at `at`, on its line, or -1. An
// interpolation `{…}` may hold quotes of its own; `{{` is a brace.
quote_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at + 1
    loop end < bytes.len() {
        code: byte(bytes, end)
        if code == 10 -> return -1
        if code == 92 || (code == 123 && byte(bytes, end + 1) == 123) {
            end += 2
            next
        }
        if code == 123 {
            end = group_end(bytes, end)
            if end < 0 -> return -1
            next
        }
        if code == 34 -> return end + 1
        end += 1
    }
    -1
}

// The end of the raw text opening at `at` with one backtick, on its line, or -1.
raw_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at + 1
    loop end < bytes.len() {
        code: byte(bytes, end)
        if code == 10 -> return -1
        if code == 96 -> return end + 1
        end += 1
    }
    -1
}

// The end of the bracketed group opening at `at`, on its line, or -1.
group_end: fn(bytes: [U8], at: Int) -> Int Never! {
    depth := 0
    end := at
    loop end < bytes.len() {
        code: byte(bytes, end)
        if code == 10 -> return -1
        if code == 34 {
            end = quote_end(bytes, end)
            if end < 0 -> return -1
            next
        }
        if code == 40 || code == 91 || code == 123 -> depth += 1
        if code == 41 || code == 93 || code == 125 {
            depth -= 1
            if depth == 0 -> return end + 1
        }
        end += 1
    }
    -1
}

// The site and compiler values a `#` names as one word.
SITE_VALUES: [String]{"build", "phase", "program", "package", "here", "caller"}

// The end of the one postfix operand starting at `at`: a name, a site value
// (`#phase`), a number, a quoted or raw literal, or a parenthesized group
// with a postfix after it (`(2).pow(10)`), then any run of `.name`, `(…)`
// and `[…]`. -1 when none.
operand_end: fn(bytes: [U8], at: Int) -> Int Never! {
    first: byte(bytes, at)
    end := at
    if {
        first == 34 -> end = quote_end(bytes, at)
        first == 96 && byte(bytes, at + 1) != 96 -> end = raw_end(bytes, at)
        first == 40 -> {
            end = group_end(bytes, at)
            if end < 0 -> return -1
            following: byte(bytes, end)
            if following != 46 && following != 40 && following != 91 -> return -1
        }
        first == 35 -> {
            word: name_end(bytes, at + 1)
            if !SITE_VALUES.contains(slice(bytes, at + 1, word)) -> return -1
            end = word
        }
        is_digit(first) -> {
            loop is_name_byte(byte(bytes, end)) || (byte(bytes, end) == 46 && is_digit(byte(bytes, end + 1))) -> end += 1
        }
        else -> end = name_end(bytes, at)
    }
    if end <= at -> return -1
    loop {
        code: byte(bytes, end)
        if code == 46 && name_end(bytes, end + 1) > end + 1 {
            end = name_end(bytes, end + 1)
            next
        }
        if code == 40 || code == 91 {
            end = group_end(bytes, end)
            if end < 0 -> return -1
            next
        }
        break
    }
    end
}

// For `NAME: comptime { X }` at `at`, the operand `X` and the index after the
// closing brace, when `X` is one postfix operand; else None.
OperandValue: struct {
    start: Int
    end: Int
    after: Int
}

operand_value: fn(bytes: [U8], at: Int) -> OperandValue? Never! {
    if byte(bytes, at - 1) != 32 || byte(bytes, at - 2) != 58 || !is_name_byte(byte(bytes, at - 3)) -> return None
    open: at + 9
    braces: if byte(bytes, open + 1) == 123 -> 2 else -> 1
    start: open + braces + 1
    if byte(bytes, start - 1) != 32 -> return None
    end: operand_end(bytes, start)
    if end < 0 || byte(bytes, end) != 32 -> return None
    loop index in 0..<braces {
        if byte(bytes, end + 1 + index) != 125 -> return None
    }
    if braces == 2 && byte(bytes, end + 3) == 125 -> return None
    Val(OperandValue{start: start, end: end, after: end + 1 + braces})
}

// The previous byte before `at` that is not a space.
previous_visible: fn(bytes: [U8], at: Int) -> Int Never! {
    index := at - 1
    loop index >= 0 && byte(bytes, index) == 32 -> index -= 1
    byte(bytes, index)
}

// Whether the lone `comptime` at `at` (inside backticks) names an output label
// the compiler still prints: the trace phase listed after `sema.check`, or the
// `jet explain effects` rung.
label_at: fn(bytes: [U8], at: Int) -> Bool Never! {
    start: if at >= 15 -> at - 15 else -> 0
    end: if at + 14 <= bytes.len() -> at + 14 else -> bytes.len()
    slice(bytes, start, at - 1).ends_with("`sema.check`, ") || slice(bytes, at + 9, end) == " rung"
}

slice: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(bytes[start..<end])
}

// `text` with every rule applied.
respell: fn(text: String) -> Respelled Never! {
    bytes: text.bytes()
    parts := [String]{}
    last := 0
    changes := 0
    at := 0
    loop at < bytes.len() {
        if byte(bytes, at) == 99 && byte(bytes, at - 1) == 96 && word_at(bytes, at, WORD) && byte(bytes, at + 8) == 96 && !label_at(bytes, at) {
            parts.push(slice(bytes, last, at))
            parts.push("#run")
            last = at + 8
            changes += 1
            at += 8
            next
        }
        if byte(bytes, at) != 99 || !word_use_at(bytes, at) {
            at += 1
            next
        }
        after: at + 9
        replacement := String?{None}
        resume := at + 9
        if {
            word_at(bytes, after, "use") || word_at(bytes, after, "fn") -> replacement = Val("#run ")
            word_at(bytes, after, "if") || word_at(bytes, after, "loop") -> replacement = Val("#")
            byte(bytes, after) == 123 -> {
                if operand_value(bytes, at) == .Val(value) {
                    replacement = Val("#run {slice(bytes, value.start, value.end)}")
                    resume = value.after
                } else {
                    replacement = Val("#run ")
                }
            }
            name_end(bytes, after) > after && byte(bytes, name_end(bytes, after)) == 58 && byte(bytes, name_end(bytes, after) + 1) == 32 -> {
                head: name_end(bytes, after) + 2
                previous: previous_visible(bytes, at)
                if {
                    word_at(bytes, head, "fn") -> replacement = Val("#run ")
                    previous == 60 || previous == 44 || previous == 96 -> replacement = Val("")
                    else -> {}
                }
            }
            else -> {}
        }
        if replacement == .Val(spelled) {
            parts.push(slice(bytes, last, at))
            parts.push(spelled)
            last = resume
            changes += 1
            at = resume
            next
        }
        at += 1
    }
    if changes == 0 -> return Respelled{text: text.copy(), changes: 0}
    parts.push(slice(bytes, last, bytes.len()))
    Respelled{text: parts.join(""), changes: changes}
}

// The 1-based lines of `text`, Jet source, whose code (outside comments,
// strings, character literals and raw fences) still holds the word.
code_uses: fn(text: String) -> [Int] Never! {
    bytes: text.bytes()
    lines := [Int]{}
    line := 1
    // 0 code, 1 plain string, 2 triple string. `returns` holds the string
    // mode an interpolation returns to and `depths` its brace depth.
    mode := 0
    returns := [Int]{}
    depths := [Int]{}
    depth := 0
    at := 0
    loop at < bytes.len() {
        code: byte(bytes, at)
        if code == 10 {
            line += 1
            if mode == 1 {
                mode = 0
                returns = [Int]{}
                depths = [Int]{}
                depth = 0
            }
            at += 1
            next
        }
        if mode == 0 {
            if code == 47 && byte(bytes, at + 1) == 47 {
                loop at < bytes.len() && byte(bytes, at) != 10 -> at += 1
                next
            }
            if code == 47 && byte(bytes, at + 1) == 42 {
                nesting := 1
                at += 2
                loop at < bytes.len() && nesting > 0 {
                    if byte(bytes, at) == 10 -> line += 1
                    if byte(bytes, at) == 47 && byte(bytes, at + 1) == 42 {
                        nesting += 1
                        at += 2
                    } else if byte(bytes, at) == 42 && byte(bytes, at + 1) == 47 {
                        nesting -= 1
                        at += 2
                    } else {
                        at += 1
                    }
                }
                next
            }
            if code == 34 {
                mode = if byte(bytes, at + 1) == 34 && byte(bytes, at + 2) == 34 -> 2 else -> 1
                at += if mode == 2 -> 3 else -> 1
                next
            }
            if code == 96 {
                fence := 0
                loop byte(bytes, at + fence) == 96 -> fence += 1
                at += fence
                loop at < bytes.len() {
                    if byte(bytes, at) == 10 -> line += 1
                    if byte(bytes, at) != 96 {
                        at += 1
                        next
                    }
                    run := 0
                    loop byte(bytes, at + run) == 96 -> run += 1
                    at += run
                    if run == fence -> break
                }
                next
            }
            if code == 39 && byte(bytes, at + 2) == 39 {
                at += 3
                next
            }
            if code == 123 -> depth += 1
            if code == 125 {
                if returns.len() > 0 && depth == depths[depths.len() - 1] {
                    mode = returns.pop() ?? 0
                    depth = depths.pop() ?? 0
                    at += 1
                    next
                }
                depth -= 1
            }
            if code == 99 && word_at(bytes, at, WORD) && !is_name_byte(byte(bytes, at - 1)) && byte(bytes, at - 1) != 46 {
                if lines.len() == 0 || lines[lines.len() - 1] != line -> lines.push(line)
            }
            if is_name_byte(code) {
                loop is_name_byte(byte(bytes, at)) -> at += 1
                next
            }
            at += 1
            next
        }
        if code == 92 {
            at += 2
            next
        }
        if code == 123 && byte(bytes, at + 1) == 123 {
            at += 2
            next
        }
        if code == 123 {
            returns.push(mode)
            depths.push(depth)
            mode = 0
            at += 1
            next
        }
        if code == 34 && (mode == 1 || (byte(bytes, at + 1) == 34 && byte(bytes, at + 2) == 34)) {
            at += if mode == 2 -> 3 else -> 1
            mode = 0
            next
        }
        at += 1
    }
    lines
}

skipped: fn(path: String) -> Bool Never! {
    loop prefix in SKIPPED {
        if path == prefix || (prefix.ends_with("/") && path.starts_with(prefix)) -> return true
    }
    false
}

// The tracked text files under `paths` (or the whole tree) that name the word.
candidates: fn(paths: [String]) -[Exec, IO, Time.Wait]> [String] SpellError! {
    argv := [String]{"git", "grep", "-l", "-I", "-w", "-F", "-e", WORD, "--"}
    if paths.len() == 0 -> argv.push(".")
    loop path in paths -> argv.push(path.copy())
    receipt: process.cmd(argv).stdout(.Capture).stderr(.Capture).run() ?? return Err(SpellError{message: "cannot run git grep: {err}"})
    if receipt.code == 1 && receipt.errors == "" -> return Ok([String]{})
    if receipt.code != 0 -> return Err(SpellError{message: "git grep failed ({receipt.code}): {receipt.errors}"})
    found := [String]{}
    loop line in receipt.output.split("\n") {
        if line != "" && !skipped(line) -> found.push(line.copy())
    }
    Ok(found)
}

prep_spelling_main: fn(args: [String]) -[Exec, FS, IO, Time.Wait]> Int SpellError! {
    check := false
    paths := [String]{}
    loop arg in args {
        if {
            arg == "--check" -> check = true
            arg.starts_with("-") -> return Err(SpellError{message: "unknown option {arg}\n{USAGE}"})
            else -> paths.push(arg.copy())
        }
    }
    changed := 0
    uses := 0
    leftovers := 0
    loop path in candidates(paths) ?? return Err(err) {
        text: files.read(path) ?? next
        respelled: respell(text)
        if respelled.changes > 0 {
            changed += 1
            uses += respelled.changes
            if check {
                term.eprint("{path}: {respelled.changes} use(s) of `{WORD}` to respell")
            } else {
                files.write(path, respelled.text) ?? return Err(SpellError{message: "cannot write {path}: {err}"})
            }
        }
        if !path.ends_with(".jet") -> next
        loop line in code_uses(respelled.text) {
            term.eprint("{path}:{line}: code still uses `{WORD}`; no rule respells this form")
            leftovers += 1
        }
    }
    verb: if check -> "to respell" else -> "respelled"
    print("prep-spelling: {uses} use(s) in {changed} file(s) {verb}, {leftovers} code use(s) left")
    if leftovers > 0 || (check && changed > 0) -> return Ok(1)
    Ok(0)
}

run: fn() {
    if prep_spelling_main(process.args()) == {
        .Ok(code) -> {
            if code != 0 -> process.exit(code)
        }
        .Err(error) -> {
            term.eprint("prep-spelling: {error.message}")
            process.exit(1)
        }
    }
}

#Test("requests respell to #run, #if and #loop") {
    assert_eq(respell("comptime use {{\n    \"tables\"\n}}").text, "#run use {{\n    \"tables\"\n}}")
    assert_eq(respell("comptime if DEBUG {{ a }} else comptime if B {{ b }}").text, "#if DEBUG {{ a }} else #if B {{ b }}")
    assert_eq(respell("comptime loop T in [A, B] {{").text, "#loop T in [A, B] {{")
    assert_eq(respell("    comptime from_literal: fn(value: Int) -> R {{").text, "    #run from_literal: fn(value: Int) -> R {{")
    assert_eq(respell("a `comptime fn` body").text, "a `#run fn` body")
    assert_eq(respell("comptime {{\n    check()\n}}").text, "#run {{\n    check()\n}}")
}

#Test("a value that is one postfix operand loses its braces") {
    assert_eq(respell("TABLE: comptime {{ build_squares(5) }}").text, "TABLE: #run build_squares(5)")
    assert_eq(respell("DEBUG: comptime {{ false }}").text, "DEBUG: #run false")
    assert_eq(respell("n: comptime {{ tables.build(4).len() }}").text, "n: #run tables.build(4).len()")
    assert_eq(respell("N: comptime {{ 40 }}").text, "N: #run 40")
    assert_eq(respell("S: comptime {{ \"text\" }}").text, "S: #run \"text\"")
    assert_eq(respell("write `NAME: comptime {{{{ value }}}}`").text, "write `NAME: #run value`")
    assert_eq(respell("SUM: comptime {{ a + b }}").text, "SUM: #run {{ a + b }}")
    assert_eq(respell("P: comptime {{ Point{{x: 1}} }}").text, "P: #run {{ Point{{x: 1}} }}")
    assert_eq(respell("L: comptime {{ [Int]{{1}} }}").text, "L: #run {{ [Int]{{1}} }}")
    assert_eq(respell("K: comptime {{ -1 }}").text, "K: #run {{ -1 }}")
    assert_eq(respell("`NAME: comptime {{{{ … }}}}`").text, "`NAME: #run {{{{ … }}}}`")
    assert_eq(respell("f(comptime {{ x }})").text, "f(#run {{ x }})")
    assert_eq(respell("NAME: comptime {{ #package.name }}").text, "NAME: #run #package.name")
    assert_eq(respell("NOTE: comptime {{ #note }}").text, "NOTE: #run {{ #note }}")
    assert_eq(respell("F: comptime {{ (2).pow(10) }}").text, "F: #run (2).pow(10)")
    assert_eq(respell("G: comptime {{ (a + b) }}").text, "G: #run {{ (a + b) }}")
    assert_eq(respell("Q: comptime {{ \"[{{embed_file(\"d\")}}]\" }}").text, "Q: #run \"[{{embed_file(\"d\")}}]\"")
    assert_eq(respell("R: comptime {{ `{{\"a\":1}}` }}").text, "R: #run `{{\"a\":1}}`")
}

#Test("number parameters drop the word; prose and names stay") {
    assert_eq(respell("Ring: struct<comptime N: Int, comptime M: Int> {{").text, "Ring: struct<N: Int, M: Int> {{")
    assert_eq(respell("Declare it `comptime N: Int`").text, "Declare it `N: Int`")
    assert_eq(respell("the comptime child: one process").changes, 0)
    assert_eq(respell("is_comptime, tests/cases/comptime/a, jet-comptime x, .comptime z").changes, 0)
    assert_eq(respell("at comptime\n").changes, 0)
    assert_eq(respell("a `comptime` block").text, "a `#run` block")
    assert_eq(respell("`comptime_inputs`, `comptime.apply`, `comptime ` prefix").changes, 0)
    assert_eq(respell("`sema.check`, `comptime`, `lower`; a `comptime` rung").changes, 0)
    twice: respell(respell("X: comptime {{ f() }}\ncomptime if a {{\n}}").text)
    assert_eq(twice.changes, 0)
}

#Test("only code uses of the word are left over") {
    assert_eq(code_uses("// comptime here\nx: \"comptime {{y}}\"\n").len(), 0)
    assert_eq(code_uses("a: \"{{{{comptime}}}}\"\nb: comptime\n"), [Int]{2})
    assert_eq(code_uses("s: \"value {{comptime}}\"\n"), [Int]{1})
    assert_eq(code_uses("t: \"\"\"\ncomptime\n\"\"\"\n/* comptime */ is_comptime\n").len(), 0)
}
