#!/usr/bin/env jet
// Foundation's Core source-ownership rows, Foundation's effect vocabulary,
// the CLI's effect text and Core's embedded-sources part, projected from the
// Core declaration sources: every public Core source module (`source_module`
// rows of Compiler/Prelude/Core.jet), then the compiler-private parts (the
// rows of Compiler/Prelude/CoreSourceParts.tsv), then the runtime units
// (Core/*/Runtime/**/*.jet), and the canonical effect source
// (Compiler/Prelude/Effects.jet). The rows carry no body text: a checkout's
// CLI reads `<toolchain root>/<path>` at run time, and the embedded-sources
// part (Core/EmbeddedSources.jet) names each row's file, which the compiler
// embeds when jet is built. A Core edit needs no regeneration unless the row
// set changes. An Effects.jet edit always needs it.
// The effect roots of Effects.jet are also the one list behind every other
// effect-root view: Foundation's `Effect` enum (in the vocabulary file), the
// `Effect` enum of Core/Compiler/Lang.jet and the `Effect:plain(…)` type of
// the `core.compiler.lang` declaration in Core.jet are rewritten from them,
// so `--check` fails when any of them drifts.
// Usage (from the repository root): jet Tools/agent/CoreSourceRows.jet [--check]
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    term: core.term
}

CORE_PATH: "Compiler/Prelude/Core.jet"
PARTS_PATH: "Compiler/Prelude/CoreSourceParts.tsv"
RUNTIME_PATTERN: "Core/*/Runtime/**/*.jet"
EFFECTS_PATH: "Compiler/Prelude/Effects.jet"
CLI_TARGET_PATH: "Compiler/JetCli/Source/Cli/CoreSources.jet"
OWNERSHIP_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/CoreSourceOwned.jet"
VOCABULARY_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/EffectVocabulary.jet"
EMBEDDED_TARGET_PATH: "Core/EmbeddedSources.jet"
LANG_PATH: "Core/Compiler/Lang.jet"
LANG_EFFECT_OPENER: "Effect: enum {{"
CORE_LANG_MODULE: "module core.compiler.lang "
CORE_EFFECT_TYPE: "Effect:plain("
GENERATED_BY: "// This file is generated by Tools/agent/CoreSourceRows.jet; do not edit."

#Error
CoreRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> CoreRowsError Never! {
    CoreRowsError{message: "core-source-rows: {message}"}
}

// One CORE_SOURCE_OWNED_ROWS row before its type exports are looked up.
CoreSourceRow: struct {
    module_name: String
    alias: String
    path: String
    owner: String
    members: [String]
    impl_types: [String]
    runtime: Bool
}

// What Core.jet declares that the rows need: the `source_module` rows in
// order, and each module's exported type names.
CoreDeclarations: struct {
    source_rows: [CoreSourceRow]
    module_types: [String: [String]]
}

EffectRow: struct {
    name: String
    irreversible: Bool
}

GeneratedFile: struct {
    path: String
    text: String
}

// The text of bytes `start..<end` of `text` (indexes from text.bytes()).
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

is_space_byte: fn(code: Int) -> Bool Never! {
    code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

is_lower_byte: fn(code: Int) -> Bool Never! { code >= 97 && code <= 122 }

is_upper_byte: fn(code: Int) -> Bool Never! { code >= 65 && code <= 90 }

is_digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// The whitespace-separated words of `text`.
words: fn(text: String) -> [String] Never! {
    bytes: text.bytes()
    out := [String]{}
    start := -1
    loop index in 0..<bytes.len() {
        if {
            is_space_byte(Int.from_u8(bytes[index])) -> {
                if start >= 0 -> out.push(byte_slice(text, start, index))
                start = -1
            }
            start < 0 -> start = index
        }
    }
    if start >= 0 -> out.push(byte_tail(text, start))
    out
}

// The comma-separated names of a list body, trimmed, empty ones dropped.
names: fn(list: String) -> [String] Never! {
    out := [String]{}
    loop name in list.split(",") {
        trimmed: name.trim()
        if trimmed != "" -> out.push(trimmed)
    }
    out
}

// `[A-Za-z_]` then any of `[A-Za-z0-9_]` and the bytes of `extra`.
is_name: fn(text: String, extra: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    allowed: loop byte in extra.bytes() -> Int.from_u8(byte)
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        letter: is_lower_byte(code) || is_upper_byte(code) || code == 95
        if letter -> next
        if index == 0 || !(is_digit_byte(code) || allowed.contains(code)) -> return false
    }
    true
}

// A Core.jet list body as declaration names (`[A-Za-z_][A-Za-z0-9_!?]*`).
core_names: fn(list: String, line: Int) -> [String] CoreRowsError! {
    values: names(list)
    loop value in values {
        if !is_name(value, "!?") -> return Err(rows_fail("invalid Core declaration name `{value}` in {CORE_PATH} line {line}"))
    }
    Ok(values)
}

// A Core.jet line without its `//` comment (outside a quoted string), trimmed.
core_line: fn(raw: String) -> String Never! {
    bytes: raw.bytes()
    quoted := false
    escaped := false
    loop index in 0..<bytes.len() - 1 {
        code: Int.from_u8(bytes[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
            }
            next
        }
        if code == 34 {
            quoted = true
            next
        }
        if code == 47 && Int.from_u8(bytes[index + 1]) == 47 -> return byte_slice(raw, 0, index).trim()
    }
    raw.trim()
}

// A `{ … }` list at the start of `rest`: its body and the text after it.
BracedList: struct {
    body: String
    rest: String
}

braced_list: fn(rest: String) -> BracedList? Never! {
    if !rest.starts_with("{{") -> return None
    close: rest.find("}}")
    if close < 0 -> return None
    Val(BracedList{body: byte_slice(rest, 1, close), rest: byte_tail(rest, close + 1)})
}

// The leading word of `rest` (up to whitespace) and the trimmed text after it.
Word: struct {
    word: String
    rest: String
}

leading_word: fn(rest: String) -> Word Never! {
    bytes: rest.bytes()
    end := 0
    loop end < bytes.len() && !is_space_byte(Int.from_u8(bytes[end])) -> end += 1
    Word{word: byte_slice(rest, 0, end), rest: byte_tail(rest, end).trim_start()}
}

// `keyword { … }` at the start of `rest`, when `rest` starts with the keyword.
keyword_list: fn(rest: String, keyword: String) -> BracedList? Never! {
    head: leading_word(rest)
    if head.word != keyword -> return None
    braced_list(head.rest)
}

// `source_module <module> path <path> alias <alias> owns { … } [types { … }] [impls { … }]`
source_module_row: fn(line: String, number: Int) -> CoreSourceRow CoreRowsError! {
    invalid: rows_fail("unrecognized Core declaration at line {number}: {line}")
    rest := leading_word(line).rest
    module_word: leading_word(rest)
    path_key: leading_word(module_word.rest)
    path_word: leading_word(path_key.rest)
    alias_key: leading_word(path_word.rest)
    alias_word: leading_word(alias_key.rest)
    if path_key.word != "path" || alias_key.word != "alias" || !is_name(module_word.word, ".") || !is_name(alias_word.word, "") -> return Err(invalid)
    owns: keyword_list(alias_word.rest, "owns") ?? return Err(invalid)
    rest = owns.rest.trim_start()
    types_body := ""
    if keyword_list(rest, "types") == .Val(types) {
        types_body = types.body
        rest = types.rest.trim_start()
    }
    impls_body := ""
    if keyword_list(rest, "impls") == .Val(impls) {
        impls_body = impls.body
        rest = impls.rest.trim_start()
    }
    if rest != "" -> return Err(invalid)
    members: core_names(owns.body, number) ?? return Err(err)
    core_names(types_body, number) ?? return Err(err)
    impl_types: core_names(impls_body, number) ?? return Err(err)
    if !files.exists(path_word.word) -> return Err(rows_fail("Core source module path does not exist at line {number}: {path_word.word}"))
    Ok(CoreSourceRow{module_name: module_word.word, alias: alias_word.word, path: path_word.word, owner: "", members: members, impl_types: impl_types, runtime: false})
}

// `module <name> exports { … } [types { … }] [depends_on [ … ]]`: the module
// name and its exported type names (`Name` or `Name: kind`).
ModuleTypes: struct {
    module_name: String
    types: [String]
}

module_types: fn(line: String, number: Int) -> ModuleTypes CoreRowsError! {
    invalid: rows_fail("unrecognized Core declaration at line {number}: {line}")
    name: leading_word(leading_word(line).rest)
    exports: keyword_list(name.rest, "exports") ?? return Err(invalid)
    if !is_name(name.word, ".") -> return Err(invalid)
    types := [String]{}
    if keyword_list(exports.rest.trim_start(), "types") == .Val(listed) {
        loop raw in names(listed.body) {
            type_name: if raw.split_once(":") == {
                .Val(parts) -> parts.before.trim()
                .None -> raw
            }
            if !is_name(type_name, "") -> return Err(rows_fail("invalid Core type export `{raw}` in {CORE_PATH} line {number}"))
            types.push(type_name)
        }
    }
    Ok(ModuleTypes{module_name: name.word, types: types})
}

core_declarations: fn(source: String) -[FS]> CoreDeclarations CoreRowsError! {
    rows := [CoreSourceRow]{}
    types_by_module := [String: [String]]{}
    lines: source.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: core_line(lines[index])
        number: index + 1
        head: leading_word(line).word
        if head == "module" {
            declared: module_types(line, number) ?? return Err(err)
            if types_by_module.get(declared.module_name) != None -> return Err(rows_fail("duplicate Core module `{declared.module_name}` at line {number}"))
            types_by_module[declared.module_name] = declared.types
            next
        }
        if head != "source_module" -> next
        row: source_module_row(line, number) ?? return Err(err)
        loop seen in rows {
            if seen.module_name == row.module_name -> return Err(rows_fail("duplicate Core source module `{row.module_name}` at line {number}"))
            if seen.alias == row.alias -> return Err(rows_fail("duplicate Core source alias `{row.alias}` at line {number}"))
        }
        rows.push(row)
    }
    if rows.len() == 0 -> return Err(rows_fail("{CORE_PATH} declares no source modules"))
    Ok(CoreDeclarations{source_rows: rows, module_types: types_by_module})
}

// The compiler-private parts, in CoreSourceParts.tsv order.
source_parts: fn(source: String) -> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    lines: source.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 6 || fields[0] == "" || fields[1] == "" || fields[2] == "" || fields[3] == "" -> return Err(rows_fail("{PARTS_PATH}:{index + 1}: expected module, owner, path, alias, owns, impls"))
        loop seen in rows {
            if seen.module_name == fields[0] -> return Err(rows_fail("{PARTS_PATH}:{index + 1}: duplicate source part {fields[0]}"))
        }
        rows.push(CoreSourceRow{module_name: fields[0], alias: fields[3], path: fields[2], owner: fields[1], members: names(fields[4]), impl_types: names(fields[5]), runtime: false})
    }
    if rows.len() == 0 -> return Err(rows_fail("{PARTS_PATH} declares no source parts"))
    Ok(rows)
}

// The snake_case module segment of a PascalCase Core path segment
// (`UnicodeCcc` is `unicode_ccc`, `HTTPServer` is `http_server`).
snake_segment: fn(segment: String) -> String Never! {
    bytes: segment.bytes()
    parts := [String]{}
    start := 0
    loop index in 1..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if !is_upper_byte(code) -> next
        previous: Int.from_u8(bytes[index - 1])
        acronym_end: is_upper_byte(previous) && index + 1 < bytes.len() && is_lower_byte(Int.from_u8(bytes[index + 1]))
        if acronym_end || is_lower_byte(previous) || is_digit_byte(previous) {
            parts.push(byte_slice(segment, start, index))
            start = index
        }
    }
    parts.push(byte_tail(segment, start))
    parts.join("_").lower()
}

is_unit_segment: fn(segment: String) -> Bool Never! {
    bytes: segment.bytes()
    if bytes.len() == 0 || !is_lower_byte(Int.from_u8(bytes[0])) -> return false
    loop byte in bytes {
        code: Int.from_u8(byte)
        if !(is_lower_byte(code) || is_digit_byte(code) || code == 95) -> return false
    }
    true
}

// A `// PORT-PENDING` packet: its body is still the code it replaces.
port_pending: fn(source: String) -> Bool Never! {
    marker: "// PORT-PENDING"
    loop line in source.split("\n") {
        if !line.starts_with(marker) -> next
        if byte_len(line) == byte_len(marker) -> return true
        code: Int.from_u8(line.bytes()[byte_len(marker)])
        if !(is_lower_byte(code) || is_upper_byte(code) || is_digit_byte(code) || code == 95) -> return true
    }
    false
}

sorted_entries: fn(directory: String) -[FS]> [String] CoreRowsError! {
    listed: files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    out := loop entry in listed -> entry.name
    out.sort()
    Ok(out)
}

// Every runtime unit below `directory`, in directory order. A nested
// directory is one more module segment (`Core/Text/Runtime/Assets/x.jet` is
// `core.text.runtime.assets.x`).
walk_runtime: fn(directory: String, segments: [String]) -[FS]> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    entries: sorted_entries(directory) ?? return Err(err)
    loop entry in entries {
        full: "{directory}/{entry}"
        if files.is_dir(full) {
            nested := segments
            nested.push(entry)
            nested_rows: walk_runtime(full, nested) ?? return Err(err)
            loop row in nested_rows -> rows.push(row)
            next
        }
        if !entry.ends_with(".jet") || !files.is_file(full) -> next
        path: "Core/{segments.join("/")}/{entry}"
        if port_pending(read_source(path) ?? return Err(err)) -> next
        unit := segments
        unit.push(byte_slice(entry, 0, byte_len(entry) - byte_len(".jet")))
        module_segments: loop segment in unit -> snake_segment(segment)
        loop segment in module_segments {
            if !is_unit_segment(segment) -> return Err(rows_fail("runtime unit path segment `{segment}` is not a lowercase identifier: {path}"))
        }
        rows.push(CoreSourceRow{module_name: "core.{module_segments.join(".")}", alias: "__core_{module_segments.join("_")}", path: path, owner: "", members: [String]{}, impl_types: [String]{}, runtime: true})
    }
    Ok(rows)
}

// The runtime units: every `Core/<area>/Runtime/**/<Unit>.jet` except a
// `// PORT-PENDING` packet.
runtime_units: fn() -[FS]> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    areas: sorted_entries("Core") ?? return Err(err)
    loop area in areas {
        directory: "Core/{area}/Runtime"
        if !files.is_dir(directory) -> next
        units: walk_runtime(directory, [String]{area, "Runtime"}) ?? return Err(err)
        loop row in units {
            loop seen in rows {
                if seen.alias == row.alias -> return Err(rows_fail("runtime unit alias `{row.alias}` is claimed twice; rename {row.path}"))
            }
            rows.push(row)
        }
    }
    Ok(rows)
}

hex_digit: fn(value: Int) -> String Never! {
    byte_slice("0123456789abcdef", value, value + 1)
}

// `value` as a Jet string literal. Control characters other than newline and
// tab are refused.
jet_string_literal: fn(value: String, context: String) -> String CoreRowsError! {
    bytes: value.bytes()
    parts := [String]{"\""}
    start := 0
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        escape: if code == {
            92 -> "\\\\"
            34 -> "\\\""
            10 -> "\\n"
            9 -> "\\t"
            123 -> "{{{{"
            125 -> "}}}}"
            else -> ""
        }
        if escape == "" {
            if code < 32 {
                digits: if code < 16 -> hex_digit(code) else -> "1{hex_digit(code - 16)}"
                return Err(rows_fail("control character U+{digits} in {context}"))
            }
            next
        }
        parts.push(byte_slice(value, start, index))
        parts.push(escape)
        start = index + 1
    }
    parts.push(byte_tail(value, start))
    parts.push("\"")
    Ok(parts.join(""))
}

string_list: fn(values: [String], context: String) -> String CoreRowsError! {
    literals := [String]{}
    loop value in values -> literals.push(jet_string_literal(value, context) ?? return Err(err))
    Ok("[String]{{{literals.join(", ")}}}")
}

bool_text: fn(value: Bool) -> String Never! { if value -> "true" else -> "false" }

// One row per effect name the types of Effects.jet declare, in source order:
// a type's own name, then each case of an enum family. The text is read in
// its constrained form: `Name: struct {` or `Name: enum {`, case lines, and an
// `impl Effect {}` block or one holding the one-line
// `irreversible: fn(self) -> Bool { … }` whose body is `true`, `false`,
// `self == .Case` or an `||` of those. A family is irreversible when any of
// its cases is.
effect_rows: fn(source: String) -> [EffectRow] CoreRowsError! {
    rows := [EffectRow]{}
    lines: source.split("\n").to_list()
    type_name := ""
    family := false
    cases := [String]{}
    body := String?{None}
    impl_seen := false
    in_impl := false
    loop index in 0..<lines.len() {
        raw: lines[index]
        comment: raw.find("//")
        line: (if comment < 0 -> raw else -> byte_slice(raw, 0, comment)).trim()
        if line == "" -> next
        fields: words(line)
        place: "{EFFECTS_PATH}:{index + 1}"
        if type_name == "" {
            if fields.len() != 3 || !fields[0].ends_with(":") || (fields[1] != "struct" && fields[1] != "enum") || fields[2] != "{{" -> return Err(rows_fail("{place}: expected `Name: struct {{` or `Name: enum {{`"))
            name: byte_slice(fields[0], 0, fields[0].len() - 1)
            loop seen in rows {
                if seen.name == name -> return Err(rows_fail("{place}: duplicate effect {name}"))
            }
            type_name = name
            family = fields[1] == "enum"
            cases = [String]{}
            body = None
            impl_seen = false
            next
        }
        if in_impl {
            if line == "}}" {
                in_impl = false
                next
            }
            if body != None || !line.starts_with("irreversible: fn(self) -> Bool {{ ") || !line.ends_with(" }}") -> return Err(rows_fail("{place}: expected one `irreversible: fn(self) -> Bool {{ … }}` line in `impl Effect`"))
            body = Val(byte_slice(line, "irreversible: fn(self) -> Bool {{ ".len(), line.len() - 2).trim())
            next
        }
        if line == "impl Effect {{}}" || line == "impl Effect {{" {
            if impl_seen -> return Err(rows_fail("{place}: `{type_name}` has a second `impl Effect` block"))
            impl_seen = true
            in_impl = line == "impl Effect {{"
            next
        }
        if line == "}}" {
            if !impl_seen -> return Err(rows_fail("{place}: `{type_name}` has no `impl Effect` block"))
            if family && cases.len() == 0 -> return Err(rows_fail("{place}: the effect family `{type_name}` has no cases"))
            case_rows := [EffectRow]{}
            any := false
            loop member in cases {
                irreversible: effect_fact(body, cases, Val(member)) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true`, `false`, `self == .Case` or an `||` of those"))
                if irreversible -> any = true
                case_rows.push(EffectRow{name: "{type_name}.{member}", irreversible: irreversible})
            }
            root := any
            if !family {
                root = effect_fact(body, cases, None) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true` or `false`"))
            }
            rows.push(EffectRow{name: type_name, irreversible: root})
            loop row in case_rows -> rows.push(row)
            type_name = ""
            next
        }
        if !family || fields.len() != 1 || impl_seen -> return Err(rows_fail("{place}: expected an effect family case name, `impl Effect` or `}}`"))
        if cases.contains(line) -> return Err(rows_fail("{place}: duplicate effect {type_name}.{line}"))
        cases.push(line)
    }
    if type_name != "" -> return Err(rows_fail("{EFFECTS_PATH}: `{type_name}` is not closed"))
    if rows.len() == 0 -> return Err(rows_fail("{EFFECTS_PATH} declares no effects"))
    Ok(rows)
}

// An `irreversible` body's value for one case (None for a struct), or None
// when the body is not the effect fact form. No body is `false`.
effect_fact: fn(body: String?, cases: [String], member: String?) -> Bool? Never! {
    written: body ?? return Val(false)
    holds := false
    loop part in written.split("||") {
        term: part.trim()
        if {
            term == "true" -> holds = true
            term == "false" -> {}
            term.starts_with("self == .") -> {
                named: byte_slice(term, "self == .".len(), term.len())
                if member == None || !cases.contains(named) -> return None
                if member == .Val(case_name) && case_name == named -> holds = true
            }
            else -> return None
        }
    }
    Val(holds)
}

// The effect names that are leaves (`Root.Member`) or, with `leaf` false, roots.
effect_names: fn(rows: [EffectRow], leaf: Bool) -> [String] Never! {
    out := [String]{}
    loop row in rows {
        if row.name.contains(".") == leaf -> out.push(row.name)
    }
    out
}

// Core/Compiler/Lang.jet with its `Effect: enum { … }` cases rewritten to the
// declared roots, one per line, in source order.
lang_effect_text: fn(lang: String, roots: [String]) -> String CoreRowsError! {
    out := [String]{}
    // 0 before the enum, 1 inside it, 2 after it.
    state := 0
    loop line in lang.split("\n") {
        if state == 1 {
            if line == "}}" {
                loop root in roots -> out.push("    {root}")
                out.push(line)
                state = 2
            }
            next
        }
        out.push(line)
        if state == 0 && line == LANG_EFFECT_OPENER -> state = 1
    }
    if state != 2 -> return Err(rows_fail("{LANG_PATH} has no closed `{LANG_EFFECT_OPENER}` block"))
    Ok(out.join("\n"))
}

// Core.jet with the `Effect:plain(…)` type of its `core.compiler.lang`
// declaration rewritten to the declared roots.
core_effect_text: fn(core: String, roots: [String]) -> String CoreRowsError! {
    out := [String]{}
    found := false
    loop line in core.split("\n") {
        if !line.starts_with(CORE_LANG_MODULE) {
            out.push(line)
            next
        }
        start: line.find(CORE_EFFECT_TYPE)
        if start < 0 -> return Err(rows_fail("{CORE_PATH}: the `core.compiler.lang` declaration has no `{CORE_EFFECT_TYPE}…)` type"))
        open: start + CORE_EFFECT_TYPE.len()
        rest: byte_slice(line, open, line.len())
        close: rest.find(")")
        if close < 0 -> return Err(rows_fail("{CORE_PATH}: the `core.compiler.lang` `{CORE_EFFECT_TYPE}` type is not closed"))
        out.push("{byte_slice(line, 0, open)}{roots.join("|")}{byte_slice(rest, close, rest.len())}")
        found = true
    }
    if !found -> return Err(rows_fail("{CORE_PATH} declares no `core.compiler.lang` module"))
    Ok(out.join("\n"))
}

CoreSourceViews: struct {
    files: [GeneratedFile]
    rows: Int
    effects: Int
    source_hash: String
}

render_owned_row: fn(row: CoreSourceRow, type_exports: [String]) -> String CoreRowsError! {
    module_name: jet_string_literal(row.module_name, CORE_PATH) ?? return Err(err)
    alias: jet_string_literal(row.alias, CORE_PATH) ?? return Err(err)
    path: jet_string_literal(row.path, CORE_PATH) ?? return Err(err)
    owner: jet_string_literal(row.owner, PARTS_PATH) ?? return Err(err)
    members: string_list(row.members, CORE_PATH) ?? return Err(err)
    types: string_list(type_exports, CORE_PATH) ?? return Err(err)
    impls: string_list(row.impl_types, CORE_PATH) ?? return Err(err)
    Ok("    CoreSourceOwnedRow{{module_name: {module_name}, alias: {alias}, path: {path}, owner: {owner}, owned_members: {members}, type_exports: {types}, impl_types: {impls}, runtime: {bool_text(row.runtime)}}},")
}

// Core/EmbeddedSources.jet, the compiler-private part `__core_embedded_sources`
// of core.devtools: one comptime constant per row that embeds the row's file
// (this one included) from beside it, and the lookup of a row's text by its
// repository path.
render_embedded_sources: fn(header: String, rows: [CoreSourceRow]) -> String CoreRowsError! {
    constants := [String]{}
    lookups := [String]{}
    loop (index, row) in rows {
        if !row.path.starts_with("Core/") -> return Err(rows_fail("Core source row {row.module_name} is outside Core/: {row.path}"))
        path: jet_string_literal(row.path, CORE_PATH) ?? return Err(err)
        relative: jet_string_literal(byte_tail(row.path, byte_len("Core/")), CORE_PATH) ?? return Err(err)
        constants.push("CORE_SOURCE_{index}: comptime {{ embed_file({relative}) }}")
        lookups.push("    if path == {path} -> return Val(CORE_SOURCE_{index})")
    }
    Ok("{header}// The compiler-private part `__core_embedded_sources` of core.devtools: the\n// text of every CORE_SOURCE_OWNED_ROWS row, this file included, embedded from\n// beside it when jet is built, so a jet with no checkout reads Core from itself\n// (core.devtools.toolchain_core_source, which only the jet_cli package may name).\n\n{constants.join("\n")}\n\n// The embedded text of the row at repository path `path`, or None when no row\n// has that path.\nsource_text: fn(path: String) -> String? Never! {{\n{lookups.join("\n")}\n    None\n}}\n")
}

render_core_source_views: fn(raw_core: String, parts: String, effects: String, lang: String, runtime: [CoreSourceRow], declarations: CoreDeclarations) -> CoreSourceViews CoreRowsError! {
    declared: effect_rows(effects) ?? return Err(err)
    root_names: effect_names(declared, false)
    core: core_effect_text(raw_core, root_names) ?? return Err(err)
    rows := declarations.source_rows
    loop row in source_parts(parts) ?? return Err(err) -> rows.push(row)
    loop row in runtime -> rows.push(row)
    runtime_paths: loop row in runtime -> row.path
    source_hash: crypto.sha256("{core}{parts}{runtime_paths.join("\n")}{effects}").hex()
    header: "// Sources: {CORE_PATH} (source_module rows), {PARTS_PATH} (private parts), {RUNTIME_PATTERN} (runtime units), {EFFECTS_PATH} (effect source)\n// Source SHA-256: {source_hash}\n{GENERATED_BY}\n"
    rendered := [String]{}
    loop row in rows {
        type_exports: declarations.module_types.get(row.module_name) ?? [String]{}
        rendered.push(render_owned_row(row, type_exports) ?? return Err(err))
    }
    ownership: "{header}CoreSourceOwnedRow: struct {{\n    module_name: String\n    alias: String\n    path: String\n    owner: String\n    owned_members: [String]\n    type_exports: [String]\n    impl_types: [String]\n    runtime: Bool\n}}\n\n// A nominal is source-owned only when this registration row and a loaded\n// source declaration agree. Opaque impl ownership uses the module's row.\nCORE_SOURCE_OWNED_ROWS: comptime {{ [CoreSourceOwnedRow]{{\n{rendered.join("\n")}\n}} }}\n"
    effect_source: jet_string_literal(effects, EFFECTS_PATH) ?? return Err(err)
    cli: "{header}\n// The canonical effect source, {EFFECTS_PATH}.\nJET_CLI_EFFECT_SOURCE: {effect_source}\n\n"
    vocabulary_rows := [String]{}
    loop row in declared {
        name: jet_string_literal(row.name, EFFECTS_PATH) ?? return Err(err)
        vocabulary_rows.push("    EffectVocabularyRow{{name: {name}, irreversible: {bool_text(row.irreversible)}}},")
    }
    roots: string_list(root_names, CORE_PATH) ?? return Err(err)
    leaves: string_list(effect_names(declared, true), CORE_PATH) ?? return Err(err)
    vocabulary: "// Source: {EFFECTS_PATH}\n// Source SHA-256: {crypto.sha256(effects).hex()}\n{GENERATED_BY}\nEffectVocabularyRow: struct {{\n    name: String\n    irreversible: Bool\n}}\n\n// Every declared root and leaf, in source order.\nEFFECT_VOCABULARY_ROWS: comptime {{ [EffectVocabularyRow]{{\n{vocabulary_rows.join("\n")}\n}} }}\n\n// The declared roots, in source order.\nEFFECT_VOCABULARY_ROOTS: comptime {{ {roots} }}\n\n// The declared leaves (`Root.Member`), in source order.\nEFFECT_VOCABULARY_LEAVES: comptime {{ {leaves} }}\n\n// The declared roots as the compiler's closed effect type.\nEffect: enum {{ {root_names.join(" ")} }}\n"
    lang_text: lang_effect_text(lang, root_names) ?? return Err(err)
    embedded: render_embedded_sources(header, rows) ?? return Err(err)
    outputs: [GeneratedFile]{
        GeneratedFile{path: CLI_TARGET_PATH, text: cli},
        GeneratedFile{path: OWNERSHIP_TARGET_PATH, text: ownership},
        GeneratedFile{path: VOCABULARY_TARGET_PATH, text: vocabulary},
        GeneratedFile{path: EMBEDDED_TARGET_PATH, text: embedded},
        GeneratedFile{path: LANG_PATH, text: lang_text},
        GeneratedFile{path: CORE_PATH, text: core},
    }
    Ok(CoreSourceViews{files: outputs, rows: rows.len(), effects: declared.len(), source_hash: source_hash})
}

read_source: fn(path: String) -[FS]> String CoreRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

read_core_source_views: fn() -[FS]> CoreSourceViews CoreRowsError! {
    core: read_source(CORE_PATH) ?? return Err(err)
    parts: read_source(PARTS_PATH) ?? return Err(err)
    effects: read_source(EFFECTS_PATH) ?? return Err(err)
    lang: read_source(LANG_PATH) ?? return Err(err)
    declarations: core_declarations(core) ?? return Err(err)
    runtime: runtime_units() ?? return Err(err)
    render_core_source_views(core, parts, effects, lang, runtime, declarations)
}

// The file's text, or "" when it does not exist.
current_text: fn(path: String) -[FS]> String CoreRowsError! {
    if !files.exists(path) -> return Ok("")
    read_source(path)
}

core_source_rows_main: fn(args: [String]) -[FS]> String CoreRowsError! {
    check: args.len() == 1 && args[0] == "--check"
    if args.len() > 1 || (args.len() == 1 && !check) -> return Err(rows_fail("usage: jet Tools/agent/CoreSourceRows.jet [--check]"))
    views: read_core_source_views() ?? return Err(err)
    summary: "{views.rows} rows, {views.effects} effects, source {views.source_hash}"
    if check {
        loop output in views.files {
            if (current_text(output.path) ?? return Err(err)) != output.text -> return Err(rows_fail("{output.path} is stale; run jet Tools/agent/CoreSourceRows.jet"))
        }
        return Ok("core source rows are current ({summary})")
    }
    loop output in views.files {
        files.write(output.path, output.text) ?? return Err(rows_fail("cannot write {output.path}: {err}"))
    }
    written: loop output in views.files -> output.path
    Ok("generated {written.join(", ")} ({summary})")
}

run: fn() {
    if core_source_rows_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The error text effect_rows reports for `source`, or "" when it accepts it.
effect_rows_error: fn(source: String) -> String Never! {
    if effect_rows(source) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the Core source rows are current and the effect grammar refuses malformed lines") {
    views: read_core_source_views() ?? panic("the Core source views did not render: {err.message}")
    loop output in views.files {
        assert_eq(files.read(output.path) ?? panic("{output.path} did not read"), output.text)
    }
    assert_eq(snake_segment("UnicodeCcc"), "unicode_ccc")
    assert_eq(snake_segment("HTTPServer"), "http_server")
    assert_eq(snake_segment("Utf8Bytes"), "utf8_bytes")
    assert_eq(jet_string_literal("a{{b}}\t\"\\", "test") ?? panic("literal refused"), "\"a{{{{b}}}}\\t\\\"\\\\\"")
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ true }}\n    }}\n}}\nFS: enum {{\n    Read\n    Write\n\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\n") == "")
    rows: effect_rows("FS: enum {{\n    Read\n    Write\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\nIO: struct {{\n    impl Effect {{}}\n}}\n") ?? panic("the family was refused: {err.message}")
    assert_eq(rows.len(), 4)
    assert(rows[0].name == "FS" && rows[0].irreversible)
    assert(rows[1].name == "FS.Read" && !rows[1].irreversible)
    assert(rows[2].name == "FS.Write" && rows[2].irreversible)
    assert(rows[3].name == "IO" && !rows[3].irreversible)
    assert(effect_rows_error("FS: enum {{\n    Read\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Gone }}\n    }}\n}}\n").contains("is not `true`, `false`"))
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{}}\n}}\nNet: struct {{\n    impl Effect {{}}\n}}\n").contains("duplicate effect Net"))
    assert(effect_rows_error("Net: effect\n").contains("expected `Name: struct {{`"))
    assert(effect_rows_error("Net: struct {{\n}}\n").contains("has no `impl Effect` block"))
    assert(effect_rows_error("// only a comment\n").contains("declares no effects"))
    roots: [String]{"Net", "Rand"}
    assert_eq(lang_effect_text("A: enum {{\n    X\n}}\nEffect: enum {{\n    Crypto\n    Random\n}}\n", roots) ?? panic("the Lang enum was refused: {err.message}"), "A: enum {{\n    X\n}}\nEffect: enum {{\n    Net\n    Rand\n}}\n")
    assert(lang_effect_text("Effect: enum {{\n    Net\n", roots) == .Err(_))
    assert_eq(core_effect_text("module core.x exports {{ A }}\nmodule core.compiler.lang exports {{ Effect }} types {{ Effect:plain(FS|Proc), ABI:plain(C) }}\n", roots) ?? panic("the Core declaration was refused: {err.message}"), "module core.x exports {{ A }}\nmodule core.compiler.lang exports {{ Effect }} types {{ Effect:plain(Net|Rand), ABI:plain(C) }}\n")
    assert(core_effect_text("module core.compiler.lang exports {{ Effect }} types {{ ABI:plain(C) }}\n", roots) == .Err(_))
}
