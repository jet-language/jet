#!/usr/bin/env jet
// Foundation's Core source-ownership rows and Core's embedded-sources part,
// with the Core views below, projected from the
// Core declaration sources: every public Core source module (`source_module`
// rows of Compiler/Prelude/Core.jet), then the compiler-private parts (the
// rows of Compiler/Prelude/CoreSourceParts.tsv), then the runtime units
// (Core/*/Runtime/**/*.jet), and the canonical effect source
// (Compiler/Prelude/Effects.jet). The rows carry no body text: a checkout's
// CLI reads `<toolchain root>/<path>` at run time, and the embedded-sources
// part (Core/EmbeddedSources.jet) names each row's file, and each Core asset
// (a file a Core source names with `embed_bytes`/`embed_file`), which the
// compiler embeds when jet is built. A Core edit needs no regeneration unless
// the row set or the asset set changes. An Effects.jet edit always needs it.
// The effect roots of Effects.jet are also the one list behind the other
// effect-root views it writes: Foundation's `Effect` enum (the machine roots
// alone, in Registry/EffectRoots.jet), the `Effect` enum of
// Core/Compiler/Lang.jet and the `Effect:plain(…)` type of the
// `core.compiler.lang` declaration in Core.jet are rewritten from them, so
// `--check` fails when any of them drifts. The cases of its `FFI` family are
// the one foreign-language list the same way: the `FFILanguage` enum of
// Lang.jet and the `FFILanguage:plain(…)` type in Core.jet are written from
// them. The effect vocabulary, the canonical effect source and the check of
// Jetpack's ForeignLanguage are computed while the compiler builds
// (Registry/EffectVocabulary.jet, Foreign/Bridge/ForeignLanguages.jet).
// Core.jet's declarations (with that rewrite) are also the one source of the
// Core views the compiler reads: Foundation's CORE_CALLS table (each
// `dispatcher_row`'s Rust CoreCallRecord builder chain evaluated into a
// literal, then the rows of Compiler/Prelude/CoreCallExtensions.jet) and its
// CORE_MODULE_EXPORTS, its CORE_ENUM_ROWS and CORE_SOURCE_OWNED_TYPES, the
// CLI's `jet inspect structure core` rows, and the
// JET_CORE_OWNER_ANNOTATION_SUFFIXES tail of CoreEnumPayloadRows.jet, whose
// rows above it are authored.
// The same checks gate Core.jet's source modules (every owned member and
// type is defined by its source, no owned wrapper leaves its dispatcher row
// dead), its public dispatcher rows, its encoding format rows, its core.mem
// exports and the effect roots the build and policy tables name, and the
// collection-operation tables of Docs/spec/reference/core-library.md are
// projected from Compiler/JetFoundation/Source/Collections.jet.
// Usage (from the repository root): jet Tools/agent/CoreSourceRows.jet
// [--check|--facts]; `--facts` prints the Core module facts JSON the
// surface ledger (Tools/agent/CoreSurfaceLedger.jet) reads.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    regex: core.regex
    term: core.term
}

CORE_PATH: "Compiler/Prelude/Core.jet"
PARTS_PATH: "Compiler/Prelude/CoreSourceParts.tsv"
RUNTIME_PATTERN: "Core/*/Runtime/**/*.jet"
EFFECTS_PATH: "Compiler/Prelude/Effects.jet"
// Core's service effects: each type, in the form of EFFECTS_PATH, has a
// `#FX(…)` line above it naming the machine effects of EFFECTS_PATH that a
// row naming it may use. The Prelude exports them with the machine effects,
// so the canonical effect source is the texts joined. META_EFFECTS_PATH, in
// Core's compiler package, holds the metaprogramming effects in the same form.
CORE_EFFECTS_PATH: "Core/Effects/Effects.jet"
META_EFFECTS_PATH: "Core/Compiler/Meta.jet"
OWNERSHIP_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/CoreSourceOwned.jet"
EFFECT_ROOTS_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/EffectRoots.jet"
EMBEDDED_TARGET_PATH: "Core/EmbeddedSources.jet"
LANG_PATH: "Core/Compiler/Lang.jet"
CORE_LANG_MODULE: "module core.compiler.lang "
FFI_ROOT: "FFI"
// The `#FFI(<lang>)` language menu in Lang.jet and Core.jet.
LANG_FFI_TYPE: "FFILanguage"
GENERATED_BY: "// This file is generated by Tools/agent/CoreSourceRows.jet; do not edit."
CALL_EXTENSIONS_PATH: "Compiler/Prelude/CoreCallExtensions.jet"
CALL_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CoreCallRows.jet"
ENUM_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CoreEnumRows.jet"
STRUCTURE_ROWS_PATH: "Compiler/JetCli/Source/Cli/CoreStructureRows.jet"
ENUM_PAYLOAD_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CoreEnumPayloadRows.jet"

#Error
CoreRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> CoreRowsError Never! {
    CoreRowsError{message: "core-source-rows: {message}"}
}

// One CORE_SOURCE_OWNED_ROWS row before its type exports are looked up.
// `owned_types` are a Core.jet row's source-owned nominals; `line` is its
// Core.jet line (0 for a part or a runtime unit).
CoreSourceRow: struct {
    module_name: String
    alias: String
    path: String
    owner: String
    members: [String]
    owned_types: [String]
    impl_types: [String]
    runtime: Bool
    line: Int
}

// One effect name: a root or a family case. `kernel` is empty for a machine
// effect of Effects.jet; for a Core service effect it is the `#FX(…)` list
// above its declaration, the machine effects a row naming it may use.
EffectRow: struct {
    name: String
    irreversible: Bool
    kernel: [String]{[String]{}}
}

GeneratedFile: struct {
    path: String
    text: String
}

// The text of bytes `start..<end` of `text` (indexes from text.bytes()).
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

is_space_byte: fn(code: Int) -> Bool Never! {
    code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

is_lower_byte: fn(code: Int) -> Bool Never! { code >= 97 && code <= 122 }

is_upper_byte: fn(code: Int) -> Bool Never! { code >= 65 && code <= 90 }

is_digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// The comma-separated names of a list body, trimmed, empty ones dropped.
names: fn(list: String) -> [String] Never! {
    out := [String]{}
    loop name in list.split(",") {
        trimmed: name.trim()
        if trimmed != "" -> out.push(trimmed)
    }
    out
}

// `[A-Za-z_]` then any of `[A-Za-z0-9_]` and the bytes of `extra`.
is_name: fn(text: String, extra: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    allowed: loop byte in extra.bytes() -> Int.from_u8(byte)
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        letter: is_lower_byte(code) || is_upper_byte(code) || code == 95
        if letter -> next
        if index == 0 || !(is_digit_byte(code) || allowed.contains(code)) -> return false
    }
    true
}

// A Core.jet list body as declaration names (`[A-Za-z_][A-Za-z0-9_!?]*`).
core_names: fn(list: String, context: String) -> [String] CoreRowsError! {
    values: names(list)
    loop value in values {
        if !is_name(value, "!?") -> return Err(rows_fail("invalid Core declaration name `{value}` in {context}"))
    }
    Ok(values)
}

// A Core.jet list body as module paths (`[A-Za-z_][A-Za-z0-9_.]*`).
core_paths: fn(list: String, context: String) -> [String] CoreRowsError! {
    values: names(list)
    loop value in values {
        if !is_name(value, ".") -> return Err(rows_fail("invalid Core declaration name `{value}` in {context}"))
    }
    Ok(values)
}

// A Core.jet line without its `//` comment (outside a quoted string), trimmed.
core_line: fn(raw: String) -> String Never! {
    bytes: raw.bytes()
    quoted := false
    escaped := false
    loop index in 0..<bytes.len() - 1 {
        code: Int.from_u8(bytes[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
            }
            next
        }
        if code == 34 {
            quoted = true
            next
        }
        if code == 47 && Int.from_u8(bytes[index + 1]) == 47 -> return byte_slice(raw, 0, index).trim()
    }
    raw.trim()
}

// ---- Rust row expressions ----------------------------------------------
// A `dispatcher_row`'s expression is a Rust `CoreCallRecord` builder chain;
// these read it into the record CORE_CALLS lands as a literal.

RUST_CALL_HEAD: Regex{"^([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)\s*\("}
RUST_STRING: Regex{"^\x22((?:\\.|[^\x22\\])*)\x22$"}
RUST_CONSTANT: Regex{"^(?:(?:crate::)?Syntax::|super::)?([A-Z][A-Z0-9_]*)$"}
CONSTANT_NAME: Regex{"^[A-Z][A-Z0-9_]*$"}
RUST_SLICE: Regex{"^&\s*\[(.*)\]$"}
RUST_INTEGER: Regex{"^([0-9]+)(?:usize)?$"}
PURE_ROUTE: Regex{"^CoreCallPureRoute::([A-Za-z][A-Za-z0-9_]*)$"}
COVERAGE_CONSTANT: Regex{"^CoreCallCoverage::([A-Z_]+)$"}
// The CoreCallPureRoute variants a row may name, spelled as Jet spells them.
PURE_ROUTES: [String]{"Time", "Math", "Date", "DateTime", "SketchTDigest", "SketchReservoir", "Net", "Crypto"}

// One call `name(args)` in an expression: its path, its top-level arguments
// and the byte offset after its `)`.
RustCall: struct {
    name: String
    args: [String]
    end: Int
}

// The byte offset of the `)` that closes the `(` at byte `open`.
rust_call_end: fn(source: String, open: Int, context: String) -> Int CoreRowsError! {
    bytes: source.bytes()
    depth := 0
    quoted := false
    escaped := false
    loop index in open..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
            }
            next
        }
        if code == {
            34 -> quoted = true
            40 -> depth += 1
            41 -> {
                depth -= 1
                if depth == 0 -> return Ok(index)
            }
            else -> {}
        }
    }
    Err(rows_fail("unterminated Rust call in {context}"))
}

// The top-level comma-separated parts of `source`, trimmed, empty ones
// dropped; strings and comments are skipped.
split_top_level: fn(source: String, context: String) -> [String] CoreRowsError! {
    bytes: source.bytes()
    parts := [String]{}
    start := 0
    paren := 0
    bracket := 0
    brace := 0
    quoted := false
    escaped := false
    line_comment := false
    block_depth := 0
    skip := false
    loop index in 0..<bytes.len() {
        if skip {
            skip = false
            next
        }
        code: Int.from_u8(bytes[index])
        following: if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> -1
        if line_comment {
            if code == 10 -> line_comment = false
            next
        }
        if block_depth > 0 {
            if {
                code == 47 && following == 42 -> {
                    block_depth += 1
                    skip = true
                }
                code == 42 && following == 47 -> {
                    block_depth -= 1
                    skip = true
                }
            }
            next
        }
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
            }
            next
        }
        if code == 47 && (following == 47 || following == 42) {
            if following == 47 -> line_comment = true else -> block_depth = 1
            skip = true
            next
        }
        if code == {
            34 -> quoted = true
            40 -> paren += 1
            41 -> paren -= 1
            91 -> bracket += 1
            93 -> bracket -= 1
            123 -> brace += 1
            125 -> brace -= 1
            44 -> if paren == 0 && bracket == 0 && brace == 0 {
                part: byte_slice(source, start, index).trim()
                if part != "" -> parts.push(part)
                start = index + 1
            }
            else -> {}
        }
        if paren < 0 || bracket < 0 || brace < 0 -> return Err(rows_fail("unbalanced Rust row expression in {context}"))
    }
    if quoted || block_depth > 0 || paren != 0 || bracket != 0 || brace != 0 -> return Err(rows_fail("unterminated Rust row expression in {context}"))
    last: byte_tail(source, start).trim()
    if last != "" -> parts.push(last)
    Ok(parts)
}

read_rust_call: fn(source: String, start: Int, context: String) -> RustCall CoreRowsError! {
    found: RUST_CALL_HEAD.match(byte_tail(source, start)) ?? return Err(rows_fail("unsupported Rust call in {context}: {source.trim()}"))
    open: start + byte_len(found.text) - 1
    close: rust_call_end(source, open, context) ?? return Err(err)
    args: split_top_level(byte_slice(source, open + 1, close), context) ?? return Err(err)
    Ok(RustCall{name: found.group(1) ?? "", args: args, end: close + 1})
}

// A call that is the whole of `expression`.
whole_rust_call: fn(expression: String, context: String, what: String) -> RustCall CoreRowsError! {
    value: expression.trim()
    call: read_rust_call(value, 0, context) ?? return Err(err)
    if call.end != byte_len(value) -> return Err(rows_fail("unsupported {what} in {context}: {value}"))
    Ok(call)
}

expect_args: fn(call: RustCall, count: Int, context: String) -> Int CoreRowsError! {
    if call.args.len() != count -> return Err(rows_fail("{call.name} expected {count} arguments in {context}"))
    Ok(count)
}

hex_value: fn(code: Int) -> Int Never! {
    if {
        is_digit_byte(code) -> return code - 48
        code >= 97 && code <= 102 -> return code - 87
        code >= 65 && code <= 70 -> return code - 55
    }
    -1
}

// The value of hex digits `text`, or -1 when one is not a hex digit.
hex_number: fn(text: String) -> Int Never! {
    if text == "" -> return -1
    value := 0
    loop byte in text.bytes() {
        digit: hex_value(Int.from_u8(byte))
        if digit < 0 || value > 1114111 -> return -1
        value = value * 16 + digit
    }
    value
}

// The UTF-8 bytes of scalar `value`.
utf8_bytes: fn(value: Int) -> [U8] Never! {
    if value < 128 -> return [U8]{U8{value}}
    if value < 2048 -> return [U8]{U8{192 + (value >> 6)}, U8{128 + value.bit_and(63)}}
    if value < 65536 -> return [U8]{U8{224 + (value >> 12)}, U8{128 + (value >> 6).bit_and(63)}, U8{128 + value.bit_and(63)}}
    [U8]{U8{240 + (value >> 18)}, U8{128 + (value >> 12).bit_and(63)}, U8{128 + (value >> 6).bit_and(63)}, U8{128 + value.bit_and(63)}}
}

// The text of a Rust string literal's content.
decode_rust_string: fn(content: String, context: String) -> String CoreRowsError! {
    bytes: content.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        code: Int.from_u8(bytes[index])
        index += 1
        if code != 92 {
            out.push(bytes[index - 1])
            next
        }
        if index >= bytes.len() -> return Err(rows_fail("unterminated Rust string escape in {context}"))
        escape: Int.from_u8(bytes[index])
        index += 1
        simple: if escape == {
            110 -> 10
            114 -> 13
            116 -> 9
            48 -> 0
            92 -> 92
            34 -> 34
            39 -> 39
            else -> -1
        }
        if simple >= 0 {
            out.push(U8{simple})
            next
        }
        if escape == 120 {
            digits: byte_slice(content, index, if index + 2 < bytes.len() -> index + 2 else -> bytes.len())
            value: hex_number(digits)
            if byte_len(digits) != 2 || value < 0 || value > 127 -> return Err(rows_fail("invalid Rust byte escape in {context}"))
            out.push(U8{value})
            index += 2
            next
        }
        if escape != 117 || index >= bytes.len() || Int.from_u8(bytes[index]) != 123 -> return Err(rows_fail("unsupported Rust string escape `\\{byte_slice(content, index - 1, index)}` in {context}"))
        close: byte_tail(content, index + 1).find("}}")
        if close < 0 -> return Err(rows_fail("unterminated Rust Unicode escape in {context}"))
        value: hex_number(byte_slice(content, index + 1, index + 1 + close).replace("_", ""))
        if value < 0 -> return Err(rows_fail("invalid Rust Unicode escape in {context}"))
        if value > 1114111 || (value >= 55296 && value <= 57343) -> return Err(rows_fail("invalid Rust Unicode scalar in {context}"))
        loop byte in utf8_bytes(value) -> out.push(byte)
        index += close + 2
    }
    Ok(String.from_bytes(out) ?? return Err(rows_fail("Rust string in {context} is not UTF-8")))
}

// A Rust string literal or a Syntax string constant's name.
rust_string: fn(expression: String, context: String, constants: [String: String]) -> String CoreRowsError! {
    value: expression.trim()
    if RUST_STRING.match(value) == .Val(literal) -> return decode_rust_string(literal.group(1) ?? "", context)
    symbolic: RUST_CONSTANT.match(value) ?? return Err(rows_fail("unsupported Rust string value in {context}: {value}"))
    if constants.get(symbolic.group(1) ?? "") == .Val(text) -> return Ok(text.copy())
    Err(rows_fail("unknown Rust string constant `{value}` in {context}"))
}

rust_slice: fn(expression: String, context: String) -> [String] CoreRowsError! {
    value: expression.trim()
    found: RUST_SLICE.match(value) ?? return Err(rows_fail("unsupported Rust slice in {context}: {value}"))
    split_top_level(found.group(1) ?? "", context)
}

rust_bool: fn(expression: String, context: String) -> Bool CoreRowsError! {
    value: expression.trim()
    if value != "true" && value != "false" -> return Err(rows_fail("unsupported Rust boolean in {context}: {value}"))
    Ok(value == "true")
}

rust_int: fn(expression: String, context: String) -> Int CoreRowsError! {
    value: expression.trim().replace("_", "")
    found: RUST_INTEGER.match(value) ?? return Err(rows_fail("unsupported Rust integer in {context}: {value}"))
    Ok(Int.parse(found.group(1) ?? "") ?? return Err(rows_fail("unsupported Rust integer in {context}: {value}")))
}

rust_bools: fn(expression: String, context: String) -> [Bool] CoreRowsError! {
    out := [Bool]{}
    loop item in rust_slice(expression, context) ?? return Err(err) -> out.push(rust_bool(item, context) ?? return Err(err))
    Ok(out)
}

rust_strings: fn(expression: String, context: String, constants: [String: String]) -> [String] CoreRowsError! {
    out := [String]{}
    loop item in rust_slice(expression, context) ?? return Err(err) -> out.push(rust_string(item, context, constants) ?? return Err(err))
    Ok(out)
}

// `Some(<string>)`'s string.
rust_some_string: fn(expression: String, context: String, constants: [String: String]) -> String CoreRowsError! {
    call: whole_rust_call(expression, context, "optional Rust string") ?? return Err(err)
    if call.name != "Some" || call.args.len() != 1 -> return Err(rows_fail("unsupported optional Rust string in {context}: {expression.trim()}"))
    rust_string(call.args[0], context, constants)
}

// The Jet spelling of a CoreCallPureRoute variant: acronyms in caps
// (D-ACRO-LEX1); the retired Rust enum kept its Rust variant names.
pure_route: fn(expression: String, context: String) -> String CoreRowsError! {
    value: expression.trim()
    found: PURE_ROUTE.match(value) ?? return Err(rows_fail("unsupported CoreCallPureRoute in {context}: {value}"))
    name: found.group(1) ?? ""
    spelled: if name == {
        "None" -> "NoPureRoute"
        "Mime" -> "MIME"
        "EncodingXml" -> "EncodingXML"
        "SketchHll" -> "SketchHLL"
        "SketchCms" -> "SketchCMS"
        "Ui" -> "UI"
        "Io" -> "IO"
        else -> if PURE_ROUTES.contains(name) -> name.copy() else -> ""
    }
    if spelled == "" -> return Err(rows_fail("unsupported CoreCallPureRoute in {context}: {value}"))
    Ok(spelled)
}

// CoreCalls.jet's CORE_CALL_COVERAGE_* bit of a CoreCallCoverage constant, or
// -1 when it has none.
coverage_bit: fn(name: String) -> Int Never! {
    if name == {
        "SEMA" -> 1
        "TIR_SUBSET" -> 2
        "TIR_EVAL" -> 4
        "AOT" -> 8
        "COMPTIME" -> 32
        "KNOWN" -> 47
        else -> -1
    }
}

call_coverage: fn(expression: String, context: String) -> Int CoreRowsError! {
    call: whole_rust_call(expression, context, "CoreCallCoverage") ?? return Err(err)
    if call.name != "CoreCallCoverage::from_bits" || call.args.len() != 1 -> return Err(rows_fail("unsupported CoreCallCoverage in {context}: {expression.trim()}"))
    bits := 0
    loop raw in call.args[0].split("|") {
        part: raw.trim()
        if COVERAGE_CONSTANT.match(part) == .Val(constant) {
            name: constant.group(1) ?? ""
            bit: coverage_bit(name)
            if bit < 0 -> return Err(rows_fail("CoreCallCoverage::{name} has no Jet coverage bit in {context}"))
            bits = bits.bit_or(bit)
            next
        }
        bits = bits.bit_or(rust_int(part, context) ?? return Err(err))
    }
    Ok(bits)
}

CallAccess: struct {
    argument: Int
    mode: String
}

CallCompletion: struct {
    kind: String
    token: String?
    provider: String
}

CallCapability: struct {
    kind: String
    provider: String?
    fallback: String?
    failure: String?
}

CallMarker: struct {
    member: String
    since: String
    replacement: String
    removed_in: String?
}

// One evaluated CoreCallRecord: `constructor` is the Rust constructor the
// row called, `symbol` the Prelude symbol (None for a source-owned call).
CallRecord: struct {
    constructor: String
    module_name: String
    member: String
    receiver_types: [String]
    arity: Int
    max_arity: Int
    borrow_mask: [Bool]
    frame_accesses: [CallAccess]
    frame_completion: CallCompletion?
    effect_kind: String?
    capability: CallCapability
    effect_leaf: String?
    sink_class: String?
    pure_route: String
    symbol: String?
    source_target: String?
    coverage: Int
    aot_direct: Bool
    native_int_result: Bool
    ui_capabilities: [String]
    marker: CallMarker?
}

resource_access: fn(expression: String, context: String) -> CallAccess CoreRowsError! {
    call: whole_rust_call(expression, context, "CoreCallResourceAccess") ?? return Err(err)
    if call.args.len() != 1 -> return Err(rows_fail("unsupported CoreCallResourceAccess in {context}"))
    mode: if call.name == {
        "CoreCallResourceAccess::read" -> "Read"
        "CoreCallResourceAccess::write" -> "Write"
        "CoreCallResourceAccess::move_" -> "Move"
        else -> { return Err(rows_fail("unsupported CoreCallResourceAccess in {context}: {call.name}")) }
    }
    Ok(CallAccess{argument: rust_int(call.args[0], context) ?? return Err(err), mode: mode})
}

call_completion: fn(expression: String, context: String, constants: [String: String]) -> CallCompletion CoreRowsError! {
    call: whole_rust_call(expression, context, "CoreCallCompletion") ?? return Err(err)
    kind: if call.name == {
        "CoreCallCompletion::synchronous" -> if call.args.len() == 1 -> "Synchronous" else -> ""
        "CoreCallCompletion::pending" -> if call.args.len() == 2 -> "Pending" else -> ""
        "CoreCallCompletion::event" -> if call.args.len() == 2 -> "Event" else -> ""
        else -> ""
    }
    if kind == "" -> return Err(rows_fail("unsupported CoreCallCompletion in {context}: {call.name}"))
    provider: rust_string(call.args[call.args.len() - 1], context, constants) ?? return Err(err)
    if kind == "Synchronous" -> return Ok(CallCompletion{kind: kind, token: None, provider: provider})
    Ok(CallCompletion{kind: kind, token: Val(rust_string(call.args[0], context, constants) ?? return Err(err)), provider: provider})
}

pure_capability: fn() -> CallCapability Never! {
    CallCapability{kind: "Pure", provider: None, fallback: None, failure: None}
}

call_capability: fn(expression: String, context: String, constants: [String: String]) -> CallCapability CoreRowsError! {
    call: whole_rust_call(expression, context, "CoreCapabilityContract") ?? return Err(err)
    strings := [String]{}
    loop arg in call.args -> strings.push(rust_string(arg, context, constants) ?? return Err(err))
    count: strings.len()
    if {
        call.name == "CoreCapabilityContract::pure" && count == 0 -> return Ok(pure_capability())
        call.name == "CoreCapabilityContract::native_required" && count == 2 -> return Ok(CallCapability{kind: "NativeRequired", provider: Val(strings[0].copy()), fallback: None, failure: Val(strings[1].copy())})
        call.name == "CoreCapabilityContract::portable_fallback" && count == 3 -> return Ok(CallCapability{kind: "PortableFallback", provider: Val(strings[0].copy()), fallback: Val(strings[1].copy()), failure: Val(strings[2].copy())})
        call.name == "CoreCapabilityContract::explicit_simulation" && count == 2 -> return Ok(CallCapability{kind: "ExplicitSimulation", provider: Val(strings[0].copy()), fallback: None, failure: Val(strings[1].copy())})
    }
    Err(rows_fail("unsupported CoreCapabilityContract in {context}: {call.name}"))
}

call_marker: fn(expression: String, context: String, constants: [String: String]) -> CallMarker CoreRowsError! {
    call: whole_rust_call(expression, context, "CoreMarkerApplication") ?? return Err(err)
    if call.name != "CoreMarkerApplication::deprecated" || call.args.len() != 4 -> return Err(rows_fail("unsupported CoreMarkerApplication in {context}"))
    Ok(CallMarker{
        member: rust_string(call.args[0], context, constants) ?? return Err(err),
        since: rust_string(call.args[1], context, constants) ?? return Err(err),
        replacement: rust_string(call.args[2], context, constants) ?? return Err(err),
        removed_in: if call.args[3].trim() == "None" -> None else -> Val(rust_some_string(call.args[3], context, constants) ?? return Err(err)),
    })
}

// ---- Core call facts ----------------------------------------------------
// The effect, effect-leaf and sink facts of a plain Core call, keyed by
// module and then member. The lists below are the members a module's rule
// names.

FILES_PURE: [String]{"__host_path_is_absolute", "__host_path_join", "__fault_should_fail", "__os_family", "__path_windows", "__atomic_pid", "__reader_path"}
// core.web's OpenAPI helpers and its live-binding registry: in-process state
// (Core/Web/Web.jet), not a browser API; a publish only writes to connections
// a server already upgraded under Net.
WEB_PURE: [String]{"__openapi_inputs", "__openapi_render", "__contract_stop", "__live_load", "__live_replace", "__live_publish", "live_stats"}
MOD_PURE: [String]{"__supported", "__os", "__parse_context", "__check_context", "__context_name", "__context_digest", "__exports_count", "__export_info", "__finish_context"}
TIME_PURE: [String]{
    "clock", "time", "local_time", "parse_time", "new", "parse", "from_timestamp",
    "period", "period_days", "period_months", "period_years", "parse_rfc3339",
    "from_unix_ms", "from_unix_seconds", "from_unix_microseconds", "from_unix_nanoseconds",
    "parse_iso_week_date", "from_iso_week", "datetime", "utc",
    "zoned", "zoned_local", "days_in_month", "is_leap_year",
    "__embedded_zone_bytes", "__clock_mono_ns",
}
TERM_PURE: [String]{"style_force", "__stdio_fault", "__stdout_terminal", "__stderr_terminal"}
NET_PURE: [String]{
    "ip_addr", "ip_to_string", "ip_is_ipv4", "ip", "ipv4", "ipv6", "parse_ip", "is_ipv4",
    "__ip_from_bytes", "__ip_bytes", "__ip_is_v4", "__socket_from_parts",
    "__socket_ip", "__socket_port", "__socket_scope", "__udp_packet_addr",
    "is_ipv6", "socket_addr_parse", "socket_host", "socket_port", "socket_to_string",
    "ready_readable", "ready_writable", "error_operation", "error_address", "error_name",
    "error_message", "error_os_code", "dns_srv_target", "dns_srv_port", "dns_srv_priority",
    "dns_srv_weight", "udp_packet_data", "udp_packet_addr", "udp_packet_bytes",
    "udp_packet_original_len", "udp_packet_truncated",
}
BROWSER_PURE: [String]{"profile", "timeout", "__path_join", "__html_path", "__report_options", "__report_json", "__report_html", "__report_text", "__write_report_bytes", "__server_stop"}
BROWSER_FS: [String]{"locked", "__read_text", "__is_file", "__file_size", "__modified_ms"}
ENCODING_IO: [String]{"__read_byte", "__read_into", "__write_bytes", "__write_text", "__flush"}
// The encoding readers and writers.
STREAM_MEMBERS: [String]{"reader", "writer"}
CSV_STREAM_MEMBERS: [String]{"reader", "writer", "query"}
// D-SERVICE-EFFECTS1=A: a service file leaf names the one leaf it needs, as
// core.files does: lstat, stat and reads take FS.Read; appends, lock files,
// atomic replace steps, removes, fsyncs and modes take FS.Write. The lock and
// workflow sleeps name Time.
SERVICE_READS: [String]{"__host_path_kind", "__host_stat", "__host_read_bytes"}
SERVICE_WRITES: [String]{
    "__host_append_bytes", "__host_create_dirs", "__host_reserve", "__host_finish", "__host_rename",
    "__host_sync_parent", "__host_close", "__host_remove", "__host_fsync", "__host_set_mode",
}
SERVICE_SLEEPS: [String]{"__host_sleep_ns", "__host_sleep_wait_ns"}
SERVICE_WAITS: [String]{"send", "send_durable", "receive", "endpoint_send", "endpoint_receive", "workflow_sleep", "workflow_activity_wait", "workflow_all"}
PERF_ENV: [String]{"__read_bits", "__write_bits", "fidelity", "override_fidelity", "reset_fidelity"}
AUTH_DB: [String]{
    "register_user", "password_login", "session_validate", "magic_link_issue", "magic_link_consume",
    "oauth_begin", "oauth_finish", "__store_load", "__store_replace",
}
VAULT_SECRET: [String]{
    "get", "current", "versions", "load", "status", "prepare_generate", "prepare_store",
    "prepare_rotate", "prepare_retire", "prepare_revoke", "authorize_write", "commit_generate",
    "commit_store", "commit_rotate", "commit_retire", "commit_revoke", "export_to_recipients",
    "export_to_passphrase", "prepare_import_wrapped", "authorize_wrapped_import", "commit_import_wrapped",
    "prepare_import_signing", "prepare_import_x25519", "commit_import_signing", "commit_import_x25519",
}
// A file operation names the one leaf it needs, so `--allow=FS.Read` covers
// a read and never a write. `copy` and `copy_dir` both read and write, so
// they keep the bare `FS` root.
FILES_READS: [String]{
    "scope", "read", "read_bytes", "read_at", "read_link", "map", "open", "exists", "is_dir", "is_fifo", "is_socket", "space",
    "can_read", "can_write", "can_execute",
    "stat", "lstat", "list_dir", "walk", "walk_files", "glob", "canonicalize", "absolute",
    "__read_bytes_os", "__read_at_os", "__read_link_os", "__reader_line_bytes",
    // #3593 provider leaves behind Core/Files/files.jet.
    "__open_reader", "__open_reader_raw", "__open_directory", "__close_directory", "__list_directory", "__stat_at", "__path_kind", "__read_link_at",
    "__space", "__access_raw", "__reader_advise", "__map_advise",
    "__xattr_names", "__xattr_get", "__reader_stat", "__writer_stat", "__metadata_directory", "__directory_fd", "__reader_fd", "__writer_fd", "__lock_fd",
    "__map_raw", "__list_dir_raw", "__stat_mode_raw", "__canonicalize_raw", "__walk_parallel_raw",
    "__entries_context", "__entries_close", "__entries_release", "__entries_read_dir",
    "__entries_next", "__entries_file_type", "__entries_before", "__entries_shown",
    // The compiler-private non-blocking open only reads (RawHostKeys.jet).
    "jet_std_files_open_reader_nonblocking",
}
FILES_WRITES: [String]{
    "write", "write_bytes", "write_at", "write_atomic", "append_all", "create", "append", "fsync", "remove",
    "remove_dir", "remove_all", "create_dir_all", "rename", "symlink", "hard_link", "chown",
    "__write_bytes_os", "__append_bytes_os", "__create_dirs_os", "__write_at_os", "__writer_refusal",
    "__atomic_reserve", "__atomic_finish", "__atomic_remove", "__atomic_rename", "__atomic_sync_parent", "__atomic_close",
    "jet_files_link_reader_at_raw",
    "set_mode", "mkdtemp", "mktemp", "temp_dir", "temp_file", "lock", "__open_writer", "__create_directory",
    "__fsync_directory", "__rename_at", "__remove_at", "__xattr_set", "__writer_set_mode", "__writer_allocate", "__flock",
    "__open_writer_raw", "__remove_at_raw",
    "__remove_raw", "__remove_dir_raw", "__remove_all_raw", "__hard_link_raw", "__fsync_raw", "__syncfs_raw", "__chown_raw",
    "__set_mode_raw", "__symlink_directory_raw", "__symlink_raw", "__mkdtemp_raw", "__temp_dir_raw", "__temp_file_raw",
    "try_lock", "__lock_open", "__lock_try", "__lock_wait", "__lock_close", "__lock_fd_identity", "__lock_path_identity", "__lock_owner",
    "__entries_mkdir", "__entries_copy",
}
TERM_WAITS: [String]{
    "confirm", "choose", "input_secret", "read_all_input", "readline", "read_until", "take", "binread",
    "binwrite", "progress", "read_key", "__terminal8_line", "__terminal8_write_stdout", "__terminal8_write_stderr", "__terminal8_mode_enter", "__terminal8_mode_leave", "__terminal8_read_all", "__terminal8_read_until", "__terminal8_key_bytes",
}
NET_WAITS: [String]{
    "__resolve_ordered", "socket_addr", "socket_addrs",
    "__tcp_accept", "__tcp_connect", "__tcp_connect_addr", "__tcp_connect_timeout", "__tcp_connect_happy",
    "__tcp_reply",
    "__udp_send_to", "__udp_recv_from", "__udp_send_bytes_to", "__udp_receive",
    "__unix_accept", "__unix_read", "__unix_write_all_bytes", "__unix_send_fds_raw", "__unix_receive_fds_raw", "__unix_wait_raw",
    "__unix_connect_host", "__unix_connect_deadline_host",
    "tcp_accept", "tcp_connect", "tcp_connect_addr", "tcp_connect_timeout", "tcp_connect_happy", "tcp_read",
    "tcp_write", "tcp_read_bytes", "tcp_read_text", "tcp_write_bytes", "tcp_write_all_bytes", "tcp_write_text",
    "tcp_ready", "sendfile", "tcp_reply", "udp_send_to", "udp_recv_from", "udp_send_bytes_to", "udp_receive",
    "unix_accept", "unix_connect", "unix_read", "unix_write", "unix_read_bytes", "unix_write_all_bytes",
    "unix_send", "unix_receive", "unix_wait",
    "dns_a", "dns_aaaa", "dns_a_at", "dns_aaaa_at", "dns_txt", "dns_txt_at", "dns_ptr", "dns_srv",
    "dns_srv_at", "getservbyname", "getservbyport", "tls_connect", "tls_read", "tls_write", "tls_close",
    "__dns_a_lookup", "__dns_aaaa_lookup", "__dns_a_at_lookup", "__dns_aaaa_at_lookup",
    "__dns_txt_lookup", "__dns_txt_at_lookup", "__dns_ptr_lookup", "__dns_srv_lookup", "__dns_srv_at_lookup",
}
TLS_WAITS: [String]{"client", "read", "read_text", "write", "write_all", "write_text", "close"}
HTTP_CLIENT_WAITS: [String]{"get", "post", "request", "__get", "__post", "__request", "jet_http_build_resolve", "jet_http_build_get"}
HTTP_SERVER_WAITS: [String]{"serve", "serve_once", "serve_once_listener"}
DB_WAITS: [String]{"transaction", "__transaction", "migrate", "__migrate"}
// The encoding serializers.
SERIALIZERS: [String]{"to_string", "to_string_pretty", "to_bytes", "to_bytes_canonical"}

// `fact` when `member` is one of `listed`.
when_listed: fn(member: String, listed: [String], fact: String) -> String? Never! {
    if listed.contains(member) -> return Val(fact.copy())
    None
}

// `fact` unless `member` is one of `listed`.
unless_listed: fn(member: String, listed: [String], fact: String) -> String? Never! {
    if listed.contains(member) -> return None
    Val(fact.copy())
}

// The effect root a plain Core call needs, or None when it is pure.
call_effect: fn(module_name: String, member: String) -> String? Never! {
    if module_name == {
        "core.files" -> if member == {
            "__temp_path_sample" -> Val("Time")
            "__temp_directory" -> Val("Env")
            else -> unless_listed(member, FILES_PURE, "FS")
        }
        "core.log" -> Val("Log")
        "core.web" -> unless_listed(member, WEB_PURE, "Browser")
        "core.mod" -> if member == "__read_context" || member == "__stage_context" -> Val("FS") else -> unless_listed(member, MOD_PURE, "Exec")
        "core.process" -> if member == {
            "__keep_open_raw" -> Val("FS")
            "status_ok" -> None
            else -> Val("Exec")
        }
        "core.time" -> if member == {
            "__zone_env" -> Val("Env")
            "zone" | "parse_zoned" | "__zone_file_bytes" -> Val("FS")
            else -> unless_listed(member, TIME_PURE, "Time")
        }
        "core.rt" -> if member == "callback" -> Val("Time") else -> None
        "core.math" -> if member == "random" -> Val("Rand") else -> None
        "core.math.random" -> if member == "rng" -> None else -> Val("Rand")
        "core.crypto.random" -> Val("Rand")
        "core.term" -> unless_listed(member, TERM_PURE, "IO")
        "core.net" -> if member == "gethostname" -> Val("Env") else -> unless_listed(member, NET_PURE, "Net")
        "core.watcher" -> if member == {
            "files" | "__files" -> Val("FS")
            "process_pid" | "__process_pid" -> Val("Exec")
            "port" | "__port" -> Val("Net")
            else -> None
        }
        "core.web.browser" -> if BROWSER_PURE.contains(member) -> None else -> if BROWSER_FS.contains(member) -> Val("FS") else -> Val(if member == "config_from_env" -> "Env" else -> "Net")
        "core.encoding" -> when_listed(member, ENCODING_IO, "IO")
        "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.xml" | "core.encoding.cbor" -> when_listed(member, STREAM_MEMBERS, "FS")
        "core.encoding.csv" -> when_listed(member, CSV_STREAM_MEMBERS, "FS")
        // The host's f32 SIMD dispatch is a fixed CPU fact read without a
        // system call; comptime refuses it (BuildRoutes.jet
        // ir_comptime_ambient_refusal).
        "core.compute" -> if member == "__simd_lanes" || member == "device_cpu" -> None else -> Val("GPU")
        "core.data" -> if member == "__host_path_is_file" -> Val("FS") else -> None
        "core.service" -> if member == "state_store" || SERVICE_READS.contains(member) || SERVICE_WRITES.contains(member) -> Val("FS") else -> when_listed(member, SERVICE_SLEEPS, "Time")
        "core.net.tls" | "core.net.ws" | "core.http.client" | "core.http.server" | "core.http.middleware" -> Val("Net")
        "core.http" -> if member == "serve" || member == "get" -> Val("Net") else -> None
        // Key generation draws from the OS generator, like crypto.random.bytes.
        "core.crypto" -> if member == "__x25519_generate" || member == "__signing_generate" -> Val("Rand") else -> None
        "core.perf" -> when_listed(member, PERF_ENV, "Env")
        // fork and setsid change the process tree, like every other child launch.
        "core.sys" -> if member == {
            "success" -> None
            "__fork" | "__setsid" -> Val("Exec")
            else -> Val("Env")
        }
        // Joining the scheduler's threads readies the process for a raw exec
        // or fork, so it needs the same root as a child launch.
        "core.tasks" -> if member == "__quiesce" -> Val("Exec") else -> None
        "core.db" | "core.jobs" -> Val("DB")
        "core.auth" -> when_listed(member, AUTH_DB, "DB")
        "core.plugin" -> Val("Exec")
        "core.ui" | "core.web.storage.local" | "core.web.storage.session" -> Val("Browser")
        "core.crypto.vault" -> when_listed(member, VAULT_SECRET, "Secret")
        else -> None
    }
}

// The effect leaf a plain Core call needs, or None when its root suffices.
// D-AUTH-AMBIENT1=A: reading the program's own arguments is a leaf of `Exec`
// (Syntax EFFECT_LEAF_EXEC_ARGS), and so is ending the program's own process
// (`Exec.Exit`); spawning a process keeps the ungranted `Exec` root.
call_effect_leaf: fn(module_name: String, member: String) -> String? Never! {
    if module_name == {
        "core.net" -> if member == "gethostname" -> Val("FS.Read") else -> when_listed(member, NET_WAITS, "Time.Wait")
        "core.sys" -> if member == {
            "hostname" -> Val("FS.Read")
            "wait" | "waitpid" -> Val("Time.Wait")
            else -> None
        }
        "core.process" -> if member == {
            "__keep_open_raw" -> Val("FS.Read")
            "exit" -> Val("Exec.Exit")
            "run" | "pipeline" -> Val("Time.Wait")
            else -> None
        }
        "core.service" -> if {
            member == "state_store" || SERVICE_READS.contains(member) -> Val("FS.Read")
            SERVICE_WRITES.contains(member) -> Val("FS.Write")
            else -> if SERVICE_SLEEPS.contains(member) -> Val("Time.Wait") else -> when_listed(member, SERVICE_WAITS, "Time.Wait")
        }
        "core.time" -> if member == {
            "zone" | "parse_zoned" | "__zone_file_bytes" -> Val("FS.Read")
            "sleep" | "sleep_until" | "__sleep_ns" -> Val("Time.Wait")
            else -> None
        }
        "core.tasks" -> if member == "yield_now" || member == "__yield_now" -> Val("Time.Wait") else -> None
        "core.files" -> if FILES_READS.contains(member) -> Val("FS.Read") else -> when_listed(member, FILES_WRITES, "FS.Write")
        "core.term" -> when_listed(member, TERM_WAITS, "Time.Wait")
        "core.net.tls" -> when_listed(member, TLS_WAITS, "Time.Wait")
        // A WebSocket connect and upgrade both wait on the handshake.
        "core.net.ws" -> Val("Time.Wait")
        "core.http.client" -> when_listed(member, HTTP_CLIENT_WAITS, "Time.Wait")
        "core.http" -> if member == "get" -> Val("Time.Wait") else -> None
        "core.http.server" -> when_listed(member, HTTP_SERVER_WAITS, "Time.Wait")
        "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.xml" | "core.encoding.cbor" -> when_listed(member, STREAM_MEMBERS, "Time.Wait")
        "core.encoding.csv" -> when_listed(member, CSV_STREAM_MEMBERS, "Time.Wait")
        "core.db" -> when_listed(member, DB_WAITS, "Time.Wait")
        "core.jobs" -> if member == "wait" || member == "poll" -> Val("Time.Wait") else -> None
        else -> None
    }
}

// The sink class a plain Core call's arguments reach, or None.
call_sink: fn(module_name: String, member: String) -> String? Never! {
    if module_name == {
        "core.log" -> Val("Credential")
        "core.term" -> if member == "print" || member == "eprint" -> Val("Credential") else -> None
        "core.encoding.json" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml" | "core.encoding.cbor" | "core.encoding.xml" -> when_listed(member, SERIALIZERS, "Credential")
        "core.encoding.jsonl" -> if member == "to_string" -> Val("Credential") else -> None
        else -> None
    }
}

// `CoreCallRecord::new`'s record: the call's facts, Prelude symbol `symbol`.
plain_record: fn(constructor: String, module_name: String, member: String, symbol: String, mask: [Bool], constants: [String: String]) -> CallRecord CoreRowsError! {
    root: call_effect(module_name, member)
    capability: if root == None -> pure_capability() else -> CallCapability{kind: "NativeRequired", provider: Val(module_name.copy()), fallback: None, failure: Val("core.capability.unavailable")}
    leaf: if module_name == "core.process" && (member == "argv" || member == "args") -> Val(rust_string("EFFECT_LEAF_EXEC_ARGS", "core.process effect leaf", constants) ?? return Err(err)) else -> call_effect_leaf(module_name, member)
    Ok(CallRecord{constructor: constructor, module_name: module_name, member: member, receiver_types: [String]{}, arity: mask.len(), max_arity: mask.len(), borrow_mask: mask, frame_accesses: [CallAccess]{}, frame_completion: None, effect_kind: root, capability: capability, effect_leaf: leaf, sink_class: call_sink(module_name, member), pure_route: "NoPureRoute", symbol: Val(symbol), source_target: None, coverage: 47, aot_direct: true, native_int_result: false, ui_capabilities: [String]{}, marker: None})
}

// A record the Jet source of its module defines: no Prelude symbol, Sema
// coverage only, no direct AOT call.
source_owned: fn(record: CallRecord) -> CallRecord Never! {
    owned := record
    owned.symbol = None
    owned.coverage = 1
    owned.aot_direct = false
    owned
}

// Every executable Core row routes to its Jet runtime symbol
// (CoreCallSymbol.Prelude); the Rust-route form (`false`) was retired with the
// Rust runtime.
require_jet_route: fn(argument: String, context: String) -> Bool CoreRowsError! {
    if !(rust_bool(argument, context) ?? return Err(err)) -> return Err(rows_fail("CoreCallRecord in {context} names a retired Rust route; route it to its Jet runtime symbol (`true`)"))
    Ok(true)
}

// `CoreCallRecord::new(module, member, symbol, true, mask)`, with a sixth
// CoreCallCoverage argument for `new_with_coverage`.
new_record: fn(call: RustCall, count: Int, context: String, constants: [String: String]) -> CallRecord CoreRowsError! {
    expect_args(call, count, context) ?? return Err(err)
    require_jet_route(call.args[3], context) ?? return Err(err)
    module_name: rust_string(call.args[0], context, constants) ?? return Err(err)
    member: rust_string(call.args[1], context, constants) ?? return Err(err)
    symbol: rust_string(call.args[2], context, constants) ?? return Err(err)
    record := plain_record(call.name, module_name, member, symbol, rust_bools(call.args[4], context) ?? return Err(err), constants) ?? return Err(err)
    if count == 6 -> record.coverage = call_coverage(call.args[5], context) ?? return Err(err)
    Ok(record)
}

constructor_record: fn(call: RustCall, context: String, constants: [String: String]) -> CallRecord CoreRowsError! {
    if call.name == {
        "CoreCallRecord::source_owned" -> {
            expect_args(call, 3, context) ?? return Err(err)
            member: rust_string(call.args[1], context, constants) ?? return Err(err)
            record: plain_record(call.name, rust_string(call.args[0], context, constants) ?? return Err(err), member, member, rust_bools(call.args[2], context) ?? return Err(err), constants) ?? return Err(err)
            Ok(source_owned(record))
        }
        "sema_web_call" -> {
            expect_args(call, 4, context) ?? return Err(err)
            plain_record(call.name, rust_string(call.args[0], context, constants) ?? return Err(err), rust_string(call.args[1], context, constants) ?? return Err(err), rust_string(call.args[2], context, constants) ?? return Err(err), rust_bools(call.args[3], context) ?? return Err(err), constants)
        }
        "CoreCallRecord::new" -> new_record(call, 5, context, constants)
        "CoreCallRecord::new_with_coverage" -> new_record(call, 6, context, constants)
        "CoreCallRecord::receiver_with_symbol" -> {
            expect_args(call, 5, context) ?? return Err(err)
            require_jet_route(call.args[3], context) ?? return Err(err)
            mask: rust_bools(call.args[4], context) ?? return Err(err)
            Ok(CallRecord{constructor: call.name.copy(), module_name: "", member: rust_string(call.args[1], context, constants) ?? return Err(err), receiver_types: rust_strings(call.args[0], context, constants) ?? return Err(err), arity: mask.len(), max_arity: mask.len(), borrow_mask: mask, frame_accesses: [CallAccess]{}, frame_completion: None, effect_kind: None, capability: pure_capability(), effect_leaf: None, sink_class: None, pure_route: "NoPureRoute", symbol: Val(rust_string(call.args[2], context, constants) ?? return Err(err)), source_target: None, coverage: 47, aot_direct: false, native_int_result: false, ui_capabilities: [String]{}, marker: None})
        }
        else -> Err(rows_fail("unsupported CoreCallRecord constructor in {context}: {call.name}"))
    }
}

// `record` with the builder `.name(args)` applied.
apply_builder: fn(record: CallRecord, call: RustCall, context: String, constants: [String: String]) -> CallRecord CoreRowsError! {
    built := record
    if call.name == "without_direct_aot" || call.name == "with_native_int_result" || call.name == "with_source_owned" {
        expect_args(call, 0, context) ?? return Err(err)
        if call.name == {
            "without_direct_aot" -> built.aot_direct = false
            "with_native_int_result" -> built.native_int_result = true
            else -> built = source_owned(built)
        }
        return Ok(built)
    }
    expect_args(call, 1, context) ?? return Err(err)
    argument: call.args[0]
    if call.name == {
        "with_max_arity" -> built.max_arity = rust_int(argument, context) ?? return Err(err)
        "with_pure_route" -> built.pure_route = pure_route(argument, context) ?? return Err(err)
        "with_frame_accesses" -> {
            accesses := [CallAccess]{}
            loop item in rust_slice(argument, context) ?? return Err(err) -> accesses.push(resource_access(item, context) ?? return Err(err))
            built.frame_accesses = accesses
        }
        "with_frame_completion" -> built.frame_completion = Val(call_completion(argument, context, constants) ?? return Err(err))
        "with_capability" -> built.capability = call_capability(argument, context, constants) ?? return Err(err)
        "with_ui_capabilities" -> built.ui_capabilities = rust_strings(argument, context, constants) ?? return Err(err)
        "with_source_target" -> built.source_target = Val(rust_string(argument, context, constants) ?? return Err(err))
        "with_marker" -> built.marker = Val(call_marker(argument, context, constants) ?? return Err(err))
        else -> return Err(rows_fail("unsupported CoreCallRecord builder in {context}: {call.name}"))
    }
    Ok(built)
}

// One Rust CoreCallRecord builder chain evaluated into its record.
call_record: fn(expression: String, context: String, constants: [String: String]) -> CallRecord CoreRowsError! {
    value: expression.trim()
    root: read_rust_call(value, 0, context) ?? return Err(err)
    record := constructor_record(root, context, constants) ?? return Err(err)
    bytes: value.bytes()
    position := root.end
    loop position < bytes.len() {
        loop position < bytes.len() && is_space_byte(Int.from_u8(bytes[position])) -> position += 1
        if position >= bytes.len() -> break
        if Int.from_u8(bytes[position]) != 46 -> return Err(rows_fail("unsupported CoreCallRecord expression in {context}: {value}"))
        builder: read_rust_call(value, position + 1, context) ?? return Err(err)
        record = apply_builder(record, builder, context, constants) ?? return Err(err)
        position = builder.end
    }
    Ok(record)
}

optional_text: fn(value: String?) -> String Never! {
    if value == .Val(text) -> return "Val({jet_string(text)})"
    "None"
}

// `Val(<prefix><name>)`, or None.
optional_variant: fn(value: String?, prefix: String) -> String Never! {
    if value == .Val(name) -> return "Val({prefix}{name})"
    "None"
}

// The CoreCallRecord literal, fields in CoreCalls.jet declaration order.
record_literal: fn(record: CallRecord) -> String Never! {
    masks: loop flag in record.borrow_mask -> bool_text(flag)
    accesses: loop access in record.frame_accesses -> "CoreCallResourceAccess{{argument: {access.argument}, mode: CoreCallResourceAccessMode.{access.mode}}}"
    completion: if record.frame_completion == {
        .Val(done) -> "Val(CoreCallCompletion{{kind: CoreCallCompletionKind.{done.kind}, token: {optional_text(done.token)}, provider: {jet_string(done.provider)}}})"
        .None -> "None"
    }
    symbol: if record.symbol == {
        .Val(name) -> "CoreCallSymbol.Prelude{{name: {jet_string(name)}}}"
        .None -> "CoreCallSymbol.SourceOwned"
    }
    marker: if record.marker == {
        .Val(mark) -> "Val(CoreMarkerApplication{{member: {jet_string(mark.member)}, since: {jet_string(mark.since)}, replacement: {jet_string(mark.replacement)}, removed_in: {optional_text(mark.removed_in)}}})"
        .None -> "None"
    }
    capability: record.capability
    fields: [String]{
        "module_name: {jet_string(record.module_name)}",
        "member: {jet_string(record.member)}",
        "receiver_types: {string_list(record.receiver_types)}",
        "signature: CoreCallSignature{{arity: {record.arity}, max_arity: {record.max_arity}, borrow_mask: [Bool]{{{masks.join(", ")}}}}}",
        "frame_accesses: [CoreCallResourceAccess]{{{accesses.join(", ")}}}",
        "frame_completion: {completion}",
        "fallibility: CoreCallFallibility.Sema",
        "effect_kind: {optional_text(record.effect_kind)}",
        "capability: CoreCapabilityContract{{kind: CoreCapabilityKind.{capability.kind}, provider: {optional_text(capability.provider)}, fallback: {optional_text(capability.fallback)}, failure: {optional_text(capability.failure)}}}",
        "effect_leaf: {optional_text(record.effect_leaf)}",
        "sink_class: {optional_variant(record.sink_class, "SinkClass.")}",
        "pure_route: CoreCallPureRoute.{record.pure_route}",
        "symbol: {symbol}",
        "source_target: {optional_text(record.source_target)}",
        "coverage: CoreCallCoverage{{bits: {record.coverage}}}",
        "aot_direct: {bool_text(record.aot_direct)}",
        "native_int_result: {bool_text(record.native_int_result)}",
        "ui_capabilities: {string_list(record.ui_capabilities)}",
        "marker: {marker}",
        "authority: None",
    }
    "CoreCallRecord{{{fields.join(", ")}}}"
}

// ---- Syntax constants ---------------------------------------------------

SYNTAX_DIR: "Compiler/JetFoundation/Data/Syntax"
SYNTAX_STRING: Regex{"^([A-Z][A-Z0-9_]*): \x22((?:\\.|[^\x22\\])*)\x22"}
SYNTAX_BYTES: Regex{"^([A-Z][A-Z0-9_]*): String\.from_bytes\(\[U8\]\{{([0-9, ]*)\}}\)$"}

// The text of a Jet string literal's content: braces doubled, escapes
// `\n \r \t \\ \"`, the escapes the Jet lexer knows.
decode_jet_string: fn(content: String, context: String) -> String CoreRowsError! {
    bytes: content.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        code: Int.from_u8(bytes[index])
        index += 1
        if code == 123 || code == 125 {
            if index >= bytes.len() || Int.from_u8(bytes[index]) != code -> return Err(rows_fail("interpolating Jet string in {context}"))
            out.push(bytes[index])
            index += 1
            next
        }
        if code != 92 {
            out.push(bytes[index - 1])
            next
        }
        escape: if index < bytes.len() -> Int.from_u8(bytes[index]) else -> -1
        index += 1
        simple: if escape == {
            110 -> 10
            114 -> 13
            116 -> 9
            92 -> 92
            34 -> 34
            else -> -1
        }
        if simple < 0 -> return Err(rows_fail("unsupported Jet string escape in {context}"))
        out.push(U8{simple})
    }
    Ok(String.from_bytes(out) ?? return Err(rows_fail("Jet string in {context} is not UTF-8")))
}

// The string constants of the Syntax registry, the names a dispatcher row
// may spell instead of a literal: `NAME: "text"` and
// `NAME: String.from_bytes([U8]{…})` lines of every SYNTAX_DIR file.
syntax_constants: fn() -[FS]> [String: String] CoreRowsError! {
    constants := [String: String]{}
    entries: sorted_entries(SYNTAX_DIR) ?? return Err(err)
    loop entry in entries {
        if !entry.ends_with(".jet") -> next
        path: "{SYNTAX_DIR}/{entry}"
        loop line in (read_source(path) ?? return Err(err)).split("\n") {
            if SYNTAX_STRING.match(line) == .Val(found) {
                name: found.group(1) ?? ""
                constants[name] = decode_jet_string(found.group(2) ?? "", "{path} {name}") ?? return Err(err)
                next
            }
            if SYNTAX_BYTES.match(line) == .Val(found) {
                text_bytes := [U8]{}
                loop item in (found.group(2) ?? "").split(",") -> text_bytes.push(U8{Int.parse(item.trim()) ?? 0})
                constants[found.group(1) ?? ""] = String.from_bytes(text_bytes) ?? return Err(rows_fail("{path}: a String.from_bytes constant is not UTF-8"))
            }
        }
    }
    Ok(constants)
}

// ---- Core.jet declarations ----------------------------------------------
// Core.jet's closed line grammar: `bootstrap`, `root_types`,
// `namespace_only`, `format_row`, `dispatcher_row`, `source_module` and
// `module` lines.

BOOTSTRAP_ROW: Regex{"^bootstrap\s+([A-Za-z_][A-Za-z0-9_.-]*)\s+depends_on\s+\[([^\]]*)\]$"}
ROOT_TYPES_ROW: Regex{"^root_types\s+\{{([^}}]*)\}}$"}
NAMESPACE_ONLY_ROW: Regex{"^namespace_only\s+\{{([^}}]*)\}}$"}
FORMAT_ROW: Regex{"^format_row\s+([A-Z][A-Z0-9_]*)\s+([A-Za-z_][A-Za-z0-9_.]*)\s+([A-Z][A-Z0-9_]*)$"}
DISPATCHER_ROW: Regex{"^dispatcher_row\s+(plain|adapter|receiver)\s+([^\s]+)\s+([^\s]+)\s+\|\s+(.+)$"}
SOURCE_MODULE_ROW: Regex{"^source_module\s+([A-Za-z_][A-Za-z0-9_.]*)\s+path\s+([^\s]+)\s+alias\s+([A-Za-z_][A-Za-z0-9_]*)\s+owns\s+\{{([^}}]*)\}}(?:\s+types\s+\{{([^}}]*)\}})?(?:\s+impls\s+\{{([^}}]*)\}})?$"}
MODULE_ROW: Regex{"^module\s+([A-Za-z_][A-Za-z0-9_.]*)\s+exports\s+\{{([^}}]*)\}}(?:\s+types\s+\{{([^}}]*)\}})?(?:\s+depends_on\s+\[([^\]]*)\])?$"}
GENERIC_KIND: Regex{"^generic\(([1-9][0-9]*)\)$"}
ENUM_KIND: Regex{"^plain\(([^()]*)\)$"}
FROM_KIND: Regex{"^from\((core\.[A-Za-z_][A-Za-z0-9_.]*)\)$"}

// One exported Core type: its kind (`plain` or `crypto_nominal`), its enum
// variants, its generic arity (0 when it takes none) and, until it is
// resolved, the module a `from(core.x)` re-export names.
CoreType: struct {
    name: String
    kind: String
    variants: [String]
    generic_arity: Int
    from_module: String
}

// One `module` line; `line` is its Core.jet line.
CoreModule: struct {
    name: String
    members: [String]
    types: [CoreType]
    dependencies: [String]
    line: Int
}

CoreBootstrap: struct {
    name: String
    dependencies: [String]
}

// One `dispatcher_row`: its kind, its DSL module ("" for `-`) and member,
// its expression (without a trailing comma), its Core.jet line and its
// evaluated record.
DispatcherRow: struct {
    kind: String
    module_name: String
    member: String
    expression: String
    line: Int
    record: CallRecord
}

// One `format_row <Variant> <module> <Label>` line.
FormatRow: struct {
    variant: String
    module_name: String
    label: String
    line: Int
}

// Everything Core.jet declares, in declaration order, with every `from()`
// type resolved to its canonical definition.
CoreDeclarations: struct {
    source_rows: [CoreSourceRow]
    modules: [CoreModule]
    bootstraps: [CoreBootstrap]
    root_types: [String]
    namespace_only: [String]
    dispatcher_rows: [DispatcherRow]
    format_rows: [FormatRow]
}

// `Name`, `Name: plain`, `Name: crypto_nominal`, `Name: plain(A|B)`,
// `Name: generic(N)` or `Name: from(core.x)`.
core_type: fn(raw: String, context: String) -> CoreType CoreRowsError! {
    parts: loop part in raw.split(":") -> part.trim()
    name: parts[0]
    if parts.len() > 2 || !is_name(name, "") -> return Err(rows_fail("invalid Core type export `{raw}` in {context}"))
    descriptor: if parts.len() == 2 && parts[1] != "" -> parts[1].copy() else -> "plain"
    kind := descriptor.copy()
    arity := 0
    variants := [String]{}
    from_module := ""
    if GENERIC_KIND.match(descriptor) == .Val(generic) {
        arity = Int.parse(generic.group(1) ?? "") ?? 0
        kind = "plain"
    }
    if ENUM_KIND.match(descriptor) == .Val(listed) {
        variants = core_names((listed.group(1) ?? "").replace("|", ","), "Core enum `{name}` at {context}") ?? return Err(err)
        if variants.len() == 0 -> return Err(rows_fail("Core enum export has no variants `{raw}` in {context}"))
        kind = "plain"
    }
    if FROM_KIND.match(descriptor) == .Val(reference) {
        from_module = reference.group(1) ?? ""
        kind = "plain"
    }
    if kind != "plain" && kind != "crypto_nominal" -> return Err(rows_fail("invalid Core type kind `{kind}` in {context}"))
    seen := [String]{}
    loop variant in variants {
        if !is_name(variant, "") -> return Err(rows_fail("invalid Core enum variant `{variant}` in {context}"))
        if seen.contains(variant) -> return Err(rows_fail("duplicate Core enum variant `{name}` in {context}"))
        seen.push(variant)
    }
    Ok(CoreType{name: name.copy(), kind: kind, variants: variants, generic_arity: arity, from_module: from_module})
}

core_module: fn(name: String, exports: String, types_body: String, dependencies: String, number: Int, context: String) -> CoreModule CoreRowsError! {
    members: core_names(exports, context) ?? return Err(err)
    seen := [String]{}
    loop member in members {
        if seen.contains(member) -> return Err(rows_fail("duplicate Core member `{name}.{member}` in {context}"))
        seen.push(member)
    }
    types := [CoreType]{}
    seen_types := [String]{}
    loop raw in names(types_body) {
        leaf: core_type(raw, context) ?? return Err(err)
        if seen_types.contains(leaf.name) -> return Err(rows_fail("duplicate Core type export `{name}.{leaf.name}` in {context}"))
        seen_types.push(leaf.name.copy())
        types.push(leaf)
    }
    Ok(CoreModule{name: name, members: members, types: types, dependencies: core_paths(dependencies, context) ?? return Err(err), line: number})
}

// `leaf` of module `module_name` with a `from(core.x)` reference replaced by
// the kind, variants and arity of the type it names. Re-exports share one
// definition instead of copying variant lists.
resolve_type: fn(modules: [CoreModule], module_name: String, leaf: CoreType, visiting: [String]) -> CoreType CoreRowsError! {
    if leaf.from_module == "" -> return Ok(leaf.copy())
    key: "{module_name}.{leaf.name}"
    if visiting.contains(key) -> return Err(rows_fail("cyclic Core type reference `{key}`"))
    loop owner in modules {
        if owner.name != leaf.from_module -> next
        if !owner.members.contains(leaf.name) -> break
        loop target in owner.types {
            if target.name != leaf.name -> next
            nested := visiting.copy()
            nested.push(key)
            canonical: resolve_type(modules, owner.name, target, nested) ?? return Err(err)
            return Ok(CoreType{name: leaf.name.copy(), kind: canonical.kind.copy(), variants: canonical.variants.copy(), generic_arity: canonical.generic_arity, from_module: ""})
        }
        break
    }
    Err(rows_fail("unknown Core type reference `{leaf.from_module}.{leaf.name}`"))
}

// A `dispatcher_row`'s module or member may name a Syntax constant.
dispatcher_member: fn(member: String, constants: [String: String]) -> String Never! {
    if CONSTANT_NAME.match(member) == None -> return member.copy()
    if constants.get(member) == .Val(value) && value != "" -> return value.copy()
    member.copy()
}

// `dispatcher_row <kind> <module|-> <member> | <expression>`, evaluated. The
// record must carry the identity the row's labels name; a receiver row's
// label is its method or one of its receiver types.
dispatcher_row: fn(kind: String, written_module: String, member: String, written: String, number: Int, constants: [String: String]) -> DispatcherRow CoreRowsError! {
    module_name: if written_module == "-" -> "" else -> written_module.copy()
    if kind == "receiver" && written_module != "-" -> return Err(rows_fail("receiver dispatcher row must use `-` for its module at line {number}"))
    if kind != "receiver" && !is_name(module_name, ".") -> return Err(rows_fail("invalid dispatcher module `{module_name}` at line {number}"))
    if !is_name(member, "!?") -> return Err(rows_fail("invalid dispatcher member `{member}` at line {number}"))
    expression := written.trim()
    if expression.ends_with(",") -> expression = byte_slice(expression, 0, byte_len(expression) - 1)
    record: call_record(expression, "Core.jet line {number}", constants) ?? return Err(err)
    expected: dispatcher_member(member, constants)
    matches: if module_name != "" -> record.module_name == module_name && record.member == expected else -> record.module_name == "" && (record.member == expected || record.receiver_types.contains(member) || record.receiver_types.contains(expected))
    if !matches {
        shown: if module_name == "" -> "-" else -> module_name.copy()
        emitted: if record.module_name == "" -> "-" else -> record.module_name.copy()
        return Err(rows_fail("dispatcher row identity disagrees with emitted adapter at line {number}: DSL {shown}.{member} vs {record.constructor} {emitted}.{record.member}"))
    }
    Ok(DispatcherRow{kind: kind.copy(), module_name: module_name, member: member.copy(), expression: expression, line: number, record: record})
}

module_named: fn(modules: [CoreModule], name: String) -> CoreModule? Never! {
    loop entry in modules {
        if entry.name == name -> return Val(entry.copy())
    }
    None
}

position_of: fn(values: [String], value: String) -> Int Never! {
    loop (index, item) in values {
        if item == value -> return index
    }
    -1
}

// What is wrong with the declarations as a whole, or "".
declarations_problem: fn(declared: CoreDeclarations) -> String Never! {
    if declared.bootstraps.len() == 0 -> return "{CORE_PATH} has no bootstrap declarations"
    steps: loop step in declared.bootstraps -> step.name
    loop (position, step) in declared.bootstraps {
        loop dependency in step.dependencies {
            at: position_of(steps, dependency)
            if at < 0 -> return "Core bootstrap step `{step.name}` depends on missing step `{dependency}`"
            if at >= position -> return "Core bootstrap order is not deterministic: `{step.name}` precedes dependency `{dependency}`"
        }
    }
    if steps.join(" ") != "Syntax Effects Core Derives" -> return "Core bootstrap order must be Syntax -> Effects -> Core -> Derives"
    module_names: loop entry in declared.modules -> entry.name
    loop row in declared.source_rows {
        owner: module_named(declared.modules, row.module_name) ?? return "Core source module names missing Core module `{row.module_name}`"
        loop member in row.members {
            if !owner.members.contains(member) -> return "Core source module owns undeclared member `{row.module_name}.{member}`"
        }
    }
    loop entry in declared.modules {
        loop dependency in entry.dependencies {
            if !module_names.contains(dependency) -> return "Core module `{entry.name}` depends on missing module `{dependency}`"
        }
    }
    loop format in declared.format_rows {
        if !module_names.contains(format.module_name) -> return "encoding format row names missing Core module `{format.module_name}`"
    }
    loop row in declared.dispatcher_rows {
        if row.kind == "receiver" -> next
        if row.record.constructor == "CoreCallRecord::source_owned" {
            owned := false
            loop source in declared.source_rows {
                if source.module_name == row.module_name && source.members.contains(row.record.member) -> owned = true
            }
            if !owned -> return "source-owned dispatcher row has no owning source_module: {row.module_name}.{row.member}"
        }
        if row.kind == "adapter" -> next
        owner: module_named(declared.modules, row.module_name) ?? return "dispatcher row names missing Core module `{row.module_name}`"
        if row.kind == "plain" && !owner.members.contains(row.member) -> return "dispatcher row is not declared by Core.jet exports: {row.module_name}.{row.member}"
    }
    seen := [String]{}
    loop namespace in declared.namespace_only {
        if seen.contains(namespace) -> return "Core namespace_only declarations contain a duplicate"
        seen.push(namespace.copy())
        if !module_names.contains(namespace) -> return "Core namespace_only module is not declared: {namespace}"
    }
    ""
}

// `runtime` is the runtime-unit rows, the units an owned wrapper may call.
core_declarations: fn(source: String, constants: [String: String], runtime: [CoreSourceRow]) -[FS]> CoreDeclarations CoreRowsError! {
    rows := [CoreSourceRow]{}
    modules := [CoreModule]{}
    bootstraps := [CoreBootstrap]{}
    root_types := [String]{}
    namespace_only := [String]{}
    dispatchers := [DispatcherRow]{}
    dispatcher_keys := [String: Int]{}
    formats := [FormatRow]{}
    lines: source.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: core_line(lines[index])
        if line == "" -> next
        number: index + 1
        context: "Core.jet line {number}"
        if BOOTSTRAP_ROW.match(line) == .Val(found) {
            name: found.group(1) ?? ""
            loop step in bootstraps {
                if step.name == name -> return Err(rows_fail("duplicate Core bootstrap step `{name}` at line {number}"))
            }
            bootstraps.push(CoreBootstrap{name: name, dependencies: core_paths(found.group(2) ?? "", context) ?? return Err(err)})
            next
        }
        if ROOT_TYPES_ROW.match(line) == .Val(found) {
            root_types = core_names(found.group(1) ?? "", context) ?? return Err(err)
            next
        }
        if NAMESPACE_ONLY_ROW.match(line) == .Val(found) {
            namespace_only = core_paths(found.group(1) ?? "", context) ?? return Err(err)
            next
        }
        if FORMAT_ROW.match(line) == .Val(found) {
            format: FormatRow{variant: found.group(1) ?? "", module_name: found.group(2) ?? "", label: found.group(3) ?? "", line: number}
            loop seen in formats {
                if seen.variant == format.variant -> return Err(rows_fail("duplicate Core encoding format variant `{format.variant}` at line {number}"))
                if seen.label == format.label -> return Err(rows_fail("duplicate Core encoding format label `{format.label}` at line {number}"))
                if seen.module_name == format.module_name -> return Err(rows_fail("duplicate Core encoding format module `{format.module_name}` at line {number}"))
            }
            formats.push(format)
            next
        }
        if DISPATCHER_ROW.match(line) == .Val(found) {
            row: dispatcher_row(found.group(1) ?? "", found.group(2) ?? "", found.group(3) ?? "", found.group(4) ?? "", number, constants) ?? return Err(err)
            key: if row.kind == "receiver" -> "receiver@{number}" else -> "{row.module_name}.{row.member}"
            if dispatcher_keys.get(key) != None -> return Err(rows_fail("duplicate Core dispatcher row `{key}` at line {number}"))
            dispatcher_keys[key] = number
            dispatchers.push(row)
            next
        }
        if SOURCE_MODULE_ROW.match(line) == .Val(found) {
            row: CoreSourceRow{
                module_name: found.group(1) ?? "",
                alias: found.group(3) ?? "",
                path: found.group(2) ?? "",
                owner: "",
                members: core_names(found.group(4) ?? "", context) ?? return Err(err),
                // `types { … }` names the module's source-owned nominals:
                // every tier uses the Jet declaration.
                owned_types: core_names(found.group(5) ?? "", context) ?? return Err(err),
                // Owner-only impl admission never exports a type.
                impl_types: core_names(found.group(6) ?? "", context) ?? return Err(err),
                runtime: false,
                line: number,
            }
            loop seen in rows {
                if seen.module_name == row.module_name -> return Err(rows_fail("duplicate Core source module `{row.module_name}` at line {number}"))
                if seen.alias == row.alias -> return Err(rows_fail("duplicate Core source alias `{row.alias}` at line {number}"))
            }
            if !files.exists(row.path) -> return Err(rows_fail("Core source module path does not exist at line {number}: {row.path}"))
            rows.push(row)
            next
        }
        if MODULE_ROW.match(line) == .Val(found) {
            declared: core_module(found.group(1) ?? "", found.group(2) ?? "", found.group(3) ?? "", found.group(4) ?? "", number, context) ?? return Err(err)
            if module_named(modules, declared.name) != None -> return Err(rows_fail("duplicate Core module `{declared.name}` at line {number}"))
            modules.push(declared)
            next
        }
        return Err(rows_fail("unrecognized Core declaration at line {number}: {line}"))
    }
    if rows.len() == 0 -> return Err(rows_fail("{CORE_PATH} declares no source modules"))
    resolved := [CoreModule]{}
    loop entry in modules {
        types := [CoreType]{}
        loop leaf in entry.types -> types.push(resolve_type(modules, entry.name, leaf, [String]{}) ?? return Err(err))
        resolved.push(CoreModule{name: entry.name.copy(), members: entry.members.copy(), types: types, dependencies: entry.dependencies.copy(), line: entry.line})
    }
    declarations: CoreDeclarations{source_rows: rows, modules: resolved, bootstraps: bootstraps, root_types: root_types, namespace_only: namespace_only, dispatcher_rows: dispatchers, format_rows: formats}
    problem: declarations_problem(declarations)
    if problem != "" -> return Err(rows_fail(problem))
    source_problem: owned_source_problem(declarations, runtime) ?? return Err(err)
    if source_problem != "" -> return Err(rows_fail(source_problem))
    public_problem: public_dispatcher_problem(declarations, constants) ?? return Err(err)
    if public_problem != "" -> return Err(rows_fail(public_problem))
    Ok(declarations)
}

// ---- Core source checks ---------------------------------------------------
// Every owned member's target is a function its source defines and every
// owned type a column-0 declaration there; the format rows repeat the
// EncodingFormat enum; and an owned wrapper that calls a runtime unit
// instead of its provider leaves its dispatcher row dead.

ENCODING_PATH: "Core/Encoding/Encoding.jet"
OWNED_FN: Regex{"^\s*(?:#[A-Za-z_][A-Za-z0-9_]*(?:\(\x22(?:[^\x22\\]|\\.)*\x22\))?\s+)*(?:pub\s+)?([A-Za-z_][A-Za-z0-9_]*): fn(?:[^A-Za-z0-9_]|$)"}
// A wrapper's declaration line; a retired `pub` spelling is not one.
WRAPPER_FN: Regex{"^\s*(?:#[A-Za-z_][A-Za-z0-9_]*(?:\(\x22(?:[^\x22\\]|\\.)*\x22\))?\s+)*([A-Za-z_][A-Za-z0-9_]*): fn(?:[^A-Za-z0-9_]|$)"}
// A type is `Name: struct …`, an alias `Name: Type` or `Name<T>: Type<T>`;
// any other column-0 declaration matches too, which only widens this
// existence check.
OWNED_TYPE: Regex{"^(?:pub\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:<[^>]*>)?:(?:[^=]|$)"}
TOP_DECLARATION: Regex{"^(?:(?:pub\s+|priv\s+)?[A-Za-z_][A-Za-z0-9_.]*(?:<[^>]*>)?:(?:[^=]|$)|impl(?:[^A-Za-z0-9_]|$)|#)"}
USE_LINE: Regex{"^use\s+(?:([A-Za-z_][A-Za-z0-9_]*):\s*)?([A-Za-z_][A-Za-z0-9_.]*)(?:\.\[([^\]]*)\])?\s*$"}
USE_ENTRY: Regex{"^\s*(?:([A-Za-z_][A-Za-z0-9_]*):\s*)?([A-Za-z_][A-Za-z0-9_.]*)(?:\.\[([^\]]*)\])?\s*$"}

// One name an owned wrapper may call a runtime unit through: `alias.` for a
// unit import, `name(` for an imported unit member.
RuntimeLocal: struct {
    local: String
    unit: String
}

// The lines of `text`, a `\r\n` ending read as `\n`.
source_lines: fn(text: String) -> [String] Never! {
    loop line in text.split("\n") -> if line.ends_with("\r") -> byte_slice(line, 0, byte_len(line) - 1) else -> line.copy()
}

// `local` occurs in `body` after a byte that does not continue a name.
calls_local: fn(body: String, local: String) -> Bool Never! {
    bytes: body.bytes()
    start := 0
    loop {
        found: byte_tail(body, start).find(local)
        if found < 0 -> return false
        at: start + found
        if at == 0 -> return true
        before: Int.from_u8(bytes[at - 1])
        if !is_word_byte(before) && before != 46 -> return true
        start = at + 1
    }
}

// The locals one `use` target binds when it names a runtime unit.
runtime_locals: fn(alias: String, target: String, items: String?, units: [String]) -> [RuntimeLocal] Never! {
    out := [RuntimeLocal]{}
    if items == .Val(list) {
        if !units.contains(target) -> return out
        loop item in names(list) {
            parts: loop part in item.split(" as ") -> part.trim()
            name: if parts.len() > 1 -> parts[1] else -> parts[0]
            out.push(RuntimeLocal{local: "{name}(", unit: target.copy()})
        }
        return out
    }
    if units.contains(target) {
        segments: target.split(".").to_list()
        name: if alias != "" -> alias.copy() else -> segments[segments.len() - 1]
        out.push(RuntimeLocal{local: "{name}.", unit: target.copy()})
        return out
    }
    segments: target.split(".").to_list()
    if segments.len() < 2 -> return out
    unit: segments[0..<segments.len() - 1].join(".")
    if !units.contains(unit) -> return out
    name: if alias != "" -> alias.copy() else -> segments[segments.len() - 1]
    out.push(RuntimeLocal{local: "{name}(", unit: unit})
    out
}

// The runtime unit the owned wrapper `member: fn` of `source` calls instead
// of its `module_name.member` provider, or "" when it calls none.
owned_wrapper_unit: fn(source: String, module_name: String, member: String, units: [String]) -> String Never! {
    lines: source_lines(source)
    start := -1
    loop (index, line) in lines {
        if WRAPPER_FN.match(line) == .Val(found) && (found.group(1) ?? "") == member {
            start = index
            break
        }
    }
    if start < 0 -> return ""
    end := start + 1
    loop end < lines.len() && TOP_DECLARATION.match(lines[end]) == None -> end += 1
    body: lines[start..<end].join("\n")
    if body.contains("{module_name}.{member}(") -> return ""
    locals := [RuntimeLocal]{}
    in_block := false
    loop line in lines {
        if in_block {
            if line.trim() == "}}" {
                in_block = false
                next
            }
            if USE_ENTRY.match(core_line(line)) == .Val(found) {
                loop entry in runtime_locals(found.group(1) ?? "", found.group(2) ?? "", found.group(3), units) -> locals.push(entry)
            }
            next
        }
        if line.trim() == "use {{" {
            in_block = true
            next
        }
        if USE_LINE.match(core_line(line)) == .Val(found) {
            loop entry in runtime_locals(found.group(1) ?? "", found.group(2) ?? "", found.group(3), units) -> locals.push(entry)
        }
    }
    loop entry in locals {
        if calls_local(body, entry.local) -> return entry.unit.copy()
    }
    ""
}

// The first group of every line of `text` that `pattern` matches.
line_names: fn(text: String, pattern: Regex) -> [String] Never! {
    out := [String]{}
    loop line in source_lines(text) {
        if pattern.match(line) == .Val(found) -> out.push(found.group(1) ?? "")
    }
    out
}

// What is wrong with the sources the declarations name, or "".
owned_source_problem: fn(declared: CoreDeclarations, runtime: [CoreSourceRow]) -[FS]> String CoreRowsError! {
    targets := [String: String]{}
    loop row in declared.dispatcher_rows {
        if row.kind == "receiver" || row.record.constructor != "CoreCallRecord::source_owned" -> next
        targets["{row.module_name}.{row.record.member}"] = row.record.source_target ?? row.record.member
    }
    sources := [String: String]{}
    loop row in declared.source_rows {
        text: read_source(row.path) ?? return Err(err)
        functions: line_names(text, OWNED_FN)
        loop member in row.members {
            target: targets.get("{row.module_name}.{member}") ?? member
            if !functions.contains(target) -> return Ok("Core source module does not define owned member `{row.module_name}.{member}` target `{target}` at line {row.line}")
        }
        types: line_names(text, OWNED_TYPE)
        loop leaf in row.owned_types {
            if !types.contains(leaf) -> return Ok("Core source module does not declare owned type `{row.module_name}.{leaf}` at line {row.line}")
        }
        sources[row.module_name] = text
    }
    if declared.format_rows.len() > 0 {
        encoding: read_source(ENCODING_PATH) ?? return Err(err)
        head: "EncodingFormat: enum {{\n"
        open: if encoding.starts_with(head) -> 0 else -> encoding.find("\n{head}")
        if open < 0 -> return Ok("{ENCODING_PATH} declares no EncodingFormat enum")
        body_start: if open == 0 -> byte_len(head) else -> open + 1 + byte_len(head)
        close: byte_tail(encoding, body_start).find("\n}}")
        if close < 0 -> return Ok("{ENCODING_PATH} declares no EncodingFormat enum")
        // The cases are the body's first lines; a blank line ends them, and the
        // enum's own methods and impls follow it.
        cases := [String]{}
        loop line in byte_slice(encoding, body_start, body_start + close).split("\n") {
            trimmed: line.trim()
            if trimmed == "" && cases.len() > 0 -> break
            if trimmed != "" -> cases.push(trimmed)
        }
        variants: loop format in declared.format_rows -> format.variant
        if cases.join(" ") != variants.join(" ") -> return Ok("EncodingFormat cases ({cases.join(" ")}) differ from the format_row lines in {CORE_PATH} ({variants.join(" ")}); edit the rows, then make the enum repeat them in order")
        loop format in declared.format_rows {
            if !encoding.contains(".{format.variant} -> \"{format.label}\"") -> return Ok("EncodingFormat.as_str does not label .{format.variant} as \"{format.label}\" like its format_row at {CORE_PATH} line {format.line}")
        }
    }
    // Cutover end state: once an owned wrapper calls a runtime unit instead
    // of its `core.<module>.<member>` provider, the dispatcher row (and the
    // Rust symbol it names) is dead and must go in the same change.
    units: loop row in runtime -> row.module_name
    loop row in declared.dispatcher_rows {
        if row.kind == "receiver" -> next
        loop owner in declared.source_rows {
            if owner.module_name != row.module_name || !owner.members.contains(row.member) -> next
            unit: owned_wrapper_unit(sources.get(owner.module_name) ?? "", owner.module_name, row.member, units)
            if unit != "" -> return Ok("dispatcher row `{row.module_name}.{row.member}` (Core.jet line {row.line}) is dead: its owned wrapper `{row.member}: fn` in {owner.path} (owns at Core.jet line {owner.line}) calls runtime unit `{unit}` instead of the provider; delete the row and the Rust symbol it names")
            break
        }
    }
    Ok("")
}

// ---- Public dispatcher rows -----------------------------------------------
// Every CoreCallRecord constructor and web-call adapter of a dispatcher row
// is accountable to the module inventory that feeds the surface ledger;
// otherwise a stale adapter spelling can become user-visible without a
// source declaration.

CONSTRUCTOR_HEAD: "CoreCallRecord::new"
WEB_CALL: Regex{"(?:^|[^A-Za-z0-9_])sema_web_call\s*\(\s*\x22([^\x22\\]*)\x22\s*,\s*\x22([^\x22\\]*)\x22"}

PublicRow: struct {
    module_name: String
    member: String
    line: Int
}

// The byte offsets of `CoreCallRecord::new(` and
// `CoreCallRecord::new_with_coverage(` in `expression`.
constructor_offsets: fn(expression: String) -> [Int] Never! {
    bytes: expression.bytes()
    out := [Int]{}
    start := 0
    loop {
        found: byte_tail(expression, start).find(CONSTRUCTOR_HEAD)
        if found < 0 -> return out
        at: start + found
        start = at + 1
        if at > 0 && is_word_byte(Int.from_u8(bytes[at - 1])) -> next
        rest := byte_tail(expression, at + byte_len(CONSTRUCTOR_HEAD))
        if rest.starts_with("_with_coverage") -> rest = byte_tail(rest, byte_len("_with_coverage"))
        if rest.trim().starts_with("(") -> out.push(at)
    }
}

// A public member: a Core name, or a `\0`-prefixed compiler-private path.
is_public_member: fn(member: String) -> Bool Never! {
    if is_name(member, "!?") -> return true
    bytes: member.bytes()
    if bytes.len() > 0 && Int.from_u8(bytes[0]) == 0 -> return is_name(byte_tail(member, 1), ".")
    member.starts_with("\\0") && is_name(byte_tail(member, 2), ".")
}

register_public: fn(rows: [PublicRow], module_name: String, member: String, line: Int) -> String Never! {
    if !is_name(module_name, ".") || !is_public_member(member) -> return "malformed CoreCall dispatcher row at Core.jet line {line}: invalid module/member"
    loop seen in rows {
        if seen.module_name == module_name && seen.member == member -> return "duplicate public dispatcher row `{module_name}.{member}` at Core.jet lines {seen.line} and {line}"
    }
    ""
}

// What is wrong with the public dispatcher rows, or "".
public_dispatcher_problem: fn(declared: CoreDeclarations, constants: [String: String]) -> String CoreRowsError! {
    rows := [PublicRow]{}
    loop row in declared.dispatcher_rows {
        context: "Core.jet line {row.line}"
        loop offset in constructor_offsets(row.expression) {
            call: read_rust_call(row.expression, offset, context) ?? return Err(err)
            if call.args.len() < 2 -> return Ok("malformed CoreCall dispatcher row at Core.jet line {row.line}: invalid module/member")
            module_name: rust_string(call.args[0], context, constants) ?? return Err(err)
            member: rust_string(call.args[1], context, constants) ?? return Err(err)
            problem: register_public(rows, module_name, member, row.line)
            if problem != "" -> return Ok(problem)
            rows.push(PublicRow{module_name: module_name, member: member, line: row.line})
        }
    }
    loop row in declared.dispatcher_rows {
        loop found in WEB_CALL.matches(row.expression) {
            module_name: found.group(1) ?? ""
            member: found.group(2) ?? ""
            problem: register_public(rows, module_name, member, row.line)
            if problem != "" -> return Ok(problem)
            rows.push(PublicRow{module_name: module_name, member: member, line: row.line})
        }
    }
    if rows.len() == 0 -> return Ok("CoreCall dispatcher table has no public rows")
    adapter_keys := [String]{}
    loop row in declared.dispatcher_rows {
        if row.kind == "adapter" -> adapter_keys.push("{row.module_name}.{dispatcher_member(row.member, constants)}")
    }
    unknown_modules := [String]{}
    undeclared := [String]{}
    loop row in rows {
        key: "{row.module_name}.{row.member}"
        if adapter_keys.contains(key) -> next
        if module_named(declared.modules, row.module_name) == .Val(owner) {
            if !owner.members.contains(row.member) -> undeclared.push(key)
        } else {
            unknown_modules.push(key)
        }
    }
    if unknown_modules.len() > 0 -> return Ok("public dispatcher row names a non-ledger module: {unknown_modules.join(", ")}")
    if undeclared.len() > 0 -> return Ok("public dispatcher row is not declared by Core.jet: {undeclared.join(", ")}")
    Ok("")
}

// ---- Effect, task and core.mem checks -------------------------------------

CORE_SURFACE_PATH: "Compiler/JetFoundation/Data/Syntax/CoreSurface.jet"
CORE_MEM_ANCHOR: "CORE_MEM_GATE_TIERS: "
QUOTED_ITEM: Regex{"\x22([^\x22\\]*(?:\\.[^\x22\\]*)*)\x22"}
// Build authority intentionally remains the existing ten-effect projection.
// FFI, Browser, and Secret are runtime authority roots, not build grants.
BUILD_EFFECTS: [String]{"Net", "FS", "IO", "DB", "Time", "Rand", "Env", "Exec", "Log", "GPU"}
// The deny-only roots: declared with the rest of the vocabulary, refused by
// a policy but never granted.
DENY_ONLY_ROOTS: [String]{"Mem", "Panic"}
IRREVERSIBLE_ROOTS: [String]{"Net", "FS", "Exec", "FFI"}

// What is wrong with the effect roots the build and policy tables name, or "".
effect_roots_problem: fn(rows: [EffectRow]) -> String Never! {
    roots := [String]{}
    irreversible := [String]{}
    loop row in rows {
        if row.name.contains(".") -> next
        roots.push(row.name)
        if row.irreversible -> irreversible.push(row.name)
    }
    loop root in DENY_ONLY_ROOTS {
        if !roots.contains(root) -> return "{EFFECTS_PATH}: deny-only root {root} is not declared"
    }
    loop root in BUILD_EFFECTS {
        if !roots.contains(root) -> return "{EFFECTS_PATH}: build effect {root} has no declared root"
    }
    if irreversible.len() != IRREVERSIBLE_ROOTS.len() -> return "{EFFECTS_PATH}: the irreversible effect types must be Net, FS, Exec, and FFI"
    loop root in irreversible {
        if !IRREVERSIBLE_ROOTS.contains(root) -> return "{EFFECTS_PATH}: the irreversible effect types must be Net, FS, Exec, and FFI"
    }
    ""
}

// What is wrong with the Core module names other tables rely on, or "".
core_names_problem: fn(declared: CoreDeclarations) -> String Never! {
    if module_named(declared.modules, "core.tasks") == None -> return "{CORE_PATH}: missing canonical core.tasks module"
    if module_named(declared.modules, "core.task") != None -> return "{CORE_PATH}: retired core.task alias is still declared"
    ""
}

// The `{ … }` body of the Jet list literal declared at `anchor`.
jet_list_body: fn(source: String, anchor: String, path: String) -> String CoreRowsError! {
    start: source.find(anchor)
    if start < 0 -> return Err(rows_fail("{path} has no `{anchor}`"))
    found: byte_tail(source, start).find("{{")
    if found < 0 -> return Err(rows_fail("{path}: `{anchor}` has no list body"))
    open: start + found
    bytes: source.bytes()
    depth := 0
    quoted := false
    escaped := false
    loop index in open..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            next
        }
        if code == 34 {
            quoted = true
            next
        }
        if code == 123 -> depth += 1
        if code == 125 {
            depth -= 1
            if depth == 0 -> return Ok(byte_slice(source, open + 1, index))
        }
    }
    Err(rows_fail("{path}: unterminated `{anchor}` list"))
}

// `[A-Z][A-Z0-9_]*`: a Syntax constant's spelling.
is_constant_name: fn(name: String) -> Bool Never! {
    bytes: name.bytes()
    if bytes.len() == 0 || !is_upper_byte(Int.from_u8(bytes[0])) -> return false
    loop byte in bytes {
        code: Int.from_u8(byte)
        if !is_upper_byte(code) && !is_digit_byte(code) && code != 95 -> return false
    }
    true
}

// A list body's quoted strings and the values of the Syntax constants it
// names, each once, sorted.
resolve_items: fn(body: String, constants: [String: String]) -> [String] Never! {
    out := [String]{}
    loop found in QUOTED_ITEM.matches(body) {
        value: (found.group(1) ?? "").replace("\\\"", "\"")
        if !out.contains(value) -> out.push(value)
    }
    bytes: body.bytes()
    start := -1
    loop index in 0..<bytes.len() + 1 {
        word: index < bytes.len() && is_word_byte(Int.from_u8(bytes[index]))
        if word {
            if start < 0 -> start = index
            next
        }
        if start < 0 -> next
        name: byte_slice(body, start, index)
        start = -1
        if !is_constant_name(name) -> next
        if constants.get(name) == .Val(value) && !out.contains(value) -> out.push(value.copy())
    }
    out.sort()
    out
}

// What is wrong with core.mem's exports, or "": they are exactly the named
// items of the syntax registry's core.mem gate-tier map.
core_mem_problem: fn(declared: CoreDeclarations, constants: [String: String]) -[FS]> String CoreRowsError! {
    source: read_source(CORE_SURFACE_PATH) ?? return Err(err)
    tiers: resolve_items(jet_list_body(source, CORE_MEM_ANCHOR, CORE_SURFACE_PATH) ?? return Err(err), constants)
    owner: module_named(declared.modules, "core.mem") ?? return Ok("Core.jet declares no core.mem module")
    members := owner.members.copy()
    members.sort()
    if members.join("\n") == tiers.join("\n") -> return Ok("")
    missing := [String]{}
    loop name in tiers {
        if !members.contains(name) -> missing.push(name)
    }
    extra := [String]{}
    loop name in members {
        if !tiers.contains(name) -> extra.push(name)
    }
    Ok("Core.jet core.mem exports drift from CORE_MEM_GATE_TIERS: missing={missing.join(",")} extra={extra.join(",")}")
}

// ---- Collection operations ------------------------------------------------
// D-ONE-OPERATIONS1=A: the collection operation rows are authored once in
// Jet (one law or operation literal per line inside the marked tables of
// Collections.jet); the Core reference tables are their projection. The Jet
// compiler type-checks the rows; this projection checks only table-level
// laws (unique receiver/method keys and known laws).

OPERATIONS_SOURCE_PATH: "Compiler/JetFoundation/Source/Collections.jet"
OPERATIONS_DOC_PATH: "Docs/spec/reference/core-library.md"
OPERATIONS_BEGIN: "<!-- BEGIN GENERATED COLLECTION OPERATIONS -->"
OPERATIONS_END: "<!-- END GENERATED COLLECTION OPERATIONS -->"
LAW_ROW: Regex{"^(?:CollectionLawFacts)?\{{law: CollectionLaw\.([A-Za-z0-9_]+), timing: \x22([^\x22]*)\x22, result: \x22([^\x22]*)\x22, callbacks: \x22([^\x22]*)\x22, stop: \x22([^\x22]*)\x22, failure: \x22([^\x22]*)\x22, buffering: \x22([^\x22]*)\x22\}},?$"}
OPERATION_ROW: Regex{"^(?:CollectionOperationRow)?\{{receivers: CollectionReceivers\.([A-Za-z0-9_]+), name: \x22([A-Za-z0-9_]+)\x22, minimum_arity: ([0-9]+), maximum_arity: ([0-9]+), access: CollectionAccess\.([A-Za-z0-9_]+), args: \[CollectionArg\]\{{([^}}]*)\}}, result: CollectionResult\.([A-Za-z0-9_]+), op: (.+), law: CollectionLaw\.([A-Za-z0-9_]+), empty: \x22([^\x22]*)\x22, status: CollectionStatus\.([A-Za-z0-9_]+)(?:, stores: true)?\}},?$"}

CollectionLawRow: struct {
    law: String
    cells: [String]
}

CollectionOperation: struct {
    receivers: String
    name: String
    minimum: Int
    args: [String]
    access: String
    law: String
    empty: String
    status: String
}

receiver_text: fn(name: String) -> String Never! {
    if name == {
        "List" -> "`[T]`"
        "Iter" -> "`Iter<T>`"
        "View" -> "`View<T>`"
        "Sequence" -> "`[T]`, `Iter<T>`"
        "Map" -> "`[K:V]`"
        "Set" -> "`Set<T>`"
        "Rank" -> "`Rank<T>`"
        "Bits" -> "`Bits`"
        "Tally" -> "`Tally<T>`"
        "Cache" -> "`Cache<K,V>`"
        "Queue" -> "`Queue<T>`"
        "PriorityQueue" -> "`PriorityQueue<T>`"
        else -> ""
    }
}

access_text: fn(name: String) -> String Never! {
    if name == {
        "Read" -> "borrows"
        "Write" -> "exclusive, in place"
        "Move" -> "consumes"
        "Sequence" -> "borrows a list; consumes an iterator"
        else -> ""
    }
}

arg_text: fn(name: String) -> String Never! {
    if name == {
        "Element" -> "item"
        "Key" -> "key"
        "Value" -> "value"
        "Integer" -> "Int"
        "Text" -> "String"
        "IntegerList" -> "[Int]"
        "Range" -> "Range"
        "DisjointFn" -> "(ViewMut<item>, ViewMut<item>) -> T"
        "RemoveBy" -> "RemoveBy"
        "ElementList" -> "[item]"
        "KeyList" -> "[key]"
        "SameKind" -> "same kind"
        "Entries" -> "map"
        "Seed" -> "seed"
        "ItemFn" -> "(item) -> T"
        "ItemPredicate" -> "(item) -> Bool"
        "PairPredicate" -> "(item, item) -> Bool"
        "Accumulator" -> "(acc, item) -> acc"
        "Comparator" -> "(item) -> key or (a, b) -> Ordering"
        "SortKey" -> "(item) -> key"
        "EntryFn" -> "(key, value) -> T"
        "EntryPredicate" -> "(key, value) -> Bool"
        "EntryAccumulator" -> "(acc, key, value) -> acc"
        "EntryFlatMap" -> "(key, value) -> map"
        "EntryMerge" -> "(key, old, new) -> value"
        else -> ""
    }
}

status_text: fn(name: String) -> String Never! {
    if name == {
        "Current" -> "current"
        "SourceOnly" -> "source-only"
        "Proposed" -> "proposed"
        else -> ""
    }
}

// The row lines between the `// BEGIN <table>` and `// END <table>` markers.
marked_lines: fn(source: String, table: String) -> [String] CoreRowsError! {
    begin: "// BEGIN {table}"
    end: "// END {table}"
    start: source.find(begin)
    finish: if start < 0 -> -1 else -> byte_tail(source, start).find(end)
    if start < 0 || finish < 0 -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: generated section markers are missing or out of order"))
    out := [String]{}
    loop line in byte_slice(source, start, start + finish).split("\n") {
        row: line.trim()
        if row.starts_with("{{") || row.starts_with("Collection") -> out.push(row)
    }
    if out.len() == 0 -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: `{table}` has no rows"))
    Ok(out)
}

// The collection-operation reference tables of core-library.md.
render_operation_tables: fn(source: String) -> String CoreRowsError! {
    laws := [CollectionLawRow]{}
    loop line in marked_lines(source, "COLLECTION LAWS") ?? return Err(err) {
        found: LAW_ROW.match(line) ?? return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unreadable law row: {line}"))
        law: found.group(1) ?? ""
        loop seen in laws {
            if seen.law == law -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: duplicate law {law}"))
        }
        cells: loop group in 2..<8 -> found.group(group) ?? ""
        laws.push(CollectionLawRow{law: law, cells: cells})
    }
    operations := [CollectionOperation]{}
    keys := [String]{}
    loop line in marked_lines(source, "COLLECTION OPERATIONS") ?? return Err(err) {
        found: OPERATION_ROW.match(line) ?? return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unreadable operation row: {line}"))
        receivers: found.group(1) ?? ""
        name: found.group(2) ?? ""
        law: found.group(9) ?? ""
        status: found.group(11) ?? ""
        if status_text(status) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown status {status}"))
        if receiver_text(receivers) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown receivers {receivers}"))
        access: found.group(5) ?? ""
        if access_text(access) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown access {access}"))
        known := false
        loop seen in laws {
            if seen.law == law -> known = true
        }
        if !known -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} names unknown law {law}"))
        families: if receivers == "Sequence" -> [String]{"List", "Iter"} else -> [String]{receivers}
        loop family in families {
            key: "{family}.{name}"
            if keys.contains(key) -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {key} has more than one operation row"))
            keys.push(key)
        }
        args := [String]{}
        loop arg in names(found.group(6) ?? "") {
            shape: if arg.starts_with("CollectionArg.") -> byte_tail(arg, byte_len("CollectionArg.")) else -> arg.copy()
            if arg_text(shape) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unknown argument shape {shape}"))
            args.push(shape)
        }
        minimum: Int.parse(found.group(3) ?? "") ?? 0
        operations.push(CollectionOperation{receivers: receivers, name: name, minimum: minimum, args: args, access: access, law: law, empty: found.group(10) ?? "", status: status})
    }
    loop facts in laws {
        used := false
        loop row in operations {
            if row.law == facts.law -> used = true
        }
        if !used -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: law {facts.law} has no operation row"))
    }
    lines := [String]{
        OPERATIONS_BEGIN,
        "<!-- Source: {OPERATIONS_SOURCE_PATH}; regenerate with jet Tools/agent/CoreSourceRows.jet -->",
        "",
        "| Law | Timing | Result | Callbacks | Stop item | Failure channel | Buffering |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    }
    loop facts in laws -> lines.push("| {facts.law} | {facts.cells.join(" | ")} |")
    lines.push("")
    lines.push("| Receiver | Operation | Receiver ownership | Law | Empty result | Status |")
    lines.push("| --- | --- | --- | --- | --- | --- |")
    loop row in operations {
        // Reserved embedded-Core seams are not public operations.
        if row.name.starts_with("__") -> next
        shown: loop (index, arg) in row.args -> if index < row.minimum -> arg_text(arg) else -> "[{arg_text(arg)}]"
        lines.push("| {receiver_text(row.receivers)} | `{row.name}({shown.join(", ")})` | {access_text(row.access)} | {row.law} | {row.empty} | {status_text(row.status)} |")
    }
    lines.push("")
    lines.push(OPERATIONS_END)
    Ok(lines.join("\n"))
}

// core-library.md with its one generated section replaced by `section`.
replace_operation_section: fn(doc: String, section: String) -> String CoreRowsError! {
    if doc.split(OPERATIONS_BEGIN).to_list().len() != 2 || doc.split(OPERATIONS_END).to_list().len() != 2 -> return Err(rows_fail("{OPERATIONS_DOC_PATH}: expected exactly one generated section ({OPERATIONS_BEGIN}, {OPERATIONS_END})"))
    start: doc.find(OPERATIONS_BEGIN)
    finish: doc.find(OPERATIONS_END)
    if finish < start -> return Err(rows_fail("{OPERATIONS_DOC_PATH}: generated section markers are out of order"))
    Ok("{byte_slice(doc, 0, start)}{section}{byte_tail(doc, finish + byte_len(OPERATIONS_END))}")
}

// The compiler-private parts, in CoreSourceParts.tsv order.
source_parts: fn(source: String) -> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    lines: source.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 6 || fields[0] == "" || fields[1] == "" || fields[2] == "" || fields[3] == "" -> return Err(rows_fail("{PARTS_PATH}:{index + 1}: expected module, owner, path, alias, owns, impls"))
        loop seen in rows {
            if seen.module_name == fields[0] -> return Err(rows_fail("{PARTS_PATH}:{index + 1}: duplicate source part {fields[0]}"))
        }
        rows.push(CoreSourceRow{module_name: fields[0], alias: fields[3], path: fields[2], owner: fields[1], members: names(fields[4]), owned_types: [String]{}, impl_types: names(fields[5]), runtime: false, line: 0})
    }
    if rows.len() == 0 -> return Err(rows_fail("{PARTS_PATH} declares no source parts"))
    Ok(rows)
}

// The snake_case module segment of a PascalCase Core path segment
// (`UnicodeCcc` is `unicode_ccc`, `HTTPServer` is `http_server`).
snake_segment: fn(segment: String) -> String Never! {
    bytes: segment.bytes()
    parts := [String]{}
    start := 0
    loop index in 1..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if !is_upper_byte(code) -> next
        previous: Int.from_u8(bytes[index - 1])
        acronym_end: is_upper_byte(previous) && index + 1 < bytes.len() && is_lower_byte(Int.from_u8(bytes[index + 1]))
        if acronym_end || is_lower_byte(previous) || is_digit_byte(previous) {
            parts.push(byte_slice(segment, start, index))
            start = index
        }
    }
    parts.push(byte_tail(segment, start))
    parts.join("_").lower()
}

is_unit_segment: fn(segment: String) -> Bool Never! {
    bytes: segment.bytes()
    if bytes.len() == 0 || !is_lower_byte(Int.from_u8(bytes[0])) -> return false
    loop byte in bytes {
        code: Int.from_u8(byte)
        if !(is_lower_byte(code) || is_digit_byte(code) || code == 95) -> return false
    }
    true
}

// A `// PORT-PENDING` packet: its body is still the code it replaces.
port_pending: fn(source: String) -> Bool Never! {
    marker: "// PORT-PENDING"
    loop line in source.split("\n") {
        if !line.starts_with(marker) -> next
        if byte_len(line) == byte_len(marker) -> return true
        code: Int.from_u8(line.bytes()[byte_len(marker)])
        if !(is_lower_byte(code) || is_upper_byte(code) || is_digit_byte(code) || code == 95) -> return true
    }
    false
}

sorted_entries: fn(directory: String) -[FS]> [String] CoreRowsError! {
    listed: files.list_dir(directory) ?? return Err(rows_fail("cannot list {directory}: {err}"))
    out := loop entry in listed -> entry.name
    out.sort()
    Ok(out)
}

// Every runtime unit below `directory`, in directory order. A nested
// directory is one more module segment (`Core/Text/Runtime/Assets/x.jet` is
// `core.text.runtime.assets.x`).
walk_runtime: fn(directory: String, segments: [String]) -[FS]> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    entries: sorted_entries(directory) ?? return Err(err)
    loop entry in entries {
        full: "{directory}/{entry}"
        if files.is_dir(full) {
            nested := segments
            nested.push(entry)
            nested_rows: walk_runtime(full, nested) ?? return Err(err)
            loop row in nested_rows -> rows.push(row)
            next
        }
        if !entry.ends_with(".jet") || !files.is_file(full) -> next
        path: "Core/{segments.join("/")}/{entry}"
        if port_pending(read_source(path) ?? return Err(err)) -> next
        unit := segments
        unit.push(byte_slice(entry, 0, byte_len(entry) - byte_len(".jet")))
        module_segments: loop segment in unit -> snake_segment(segment)
        loop segment in module_segments {
            if !is_unit_segment(segment) -> return Err(rows_fail("runtime unit path segment `{segment}` is not a lowercase identifier: {path}"))
        }
        rows.push(CoreSourceRow{module_name: "core.{module_segments.join(".")}", alias: "__core_{module_segments.join("_")}", path: path, owner: "", members: [String]{}, owned_types: [String]{}, impl_types: [String]{}, runtime: true, line: 0})
    }
    Ok(rows)
}

// The runtime units: every `Core/<area>/Runtime/**/<Unit>.jet` except a
// `// PORT-PENDING` packet.
runtime_units: fn() -[FS]> [CoreSourceRow] CoreRowsError! {
    rows := [CoreSourceRow]{}
    areas: sorted_entries("Core") ?? return Err(err)
    loop area in areas {
        directory: "Core/{area}/Runtime"
        if !files.is_dir(directory) -> next
        units: walk_runtime(directory, [String]{area, "Runtime"}) ?? return Err(err)
        loop row in units {
            loop seen in rows {
                if seen.alias == row.alias -> return Err(rows_fail("runtime unit alias `{row.alias}` is claimed twice; rename {row.path}"))
            }
            rows.push(row)
        }
    }
    Ok(rows)
}

// A text the Jet lexer cannot spell as an ordinary literal: a control
// character other than newline and tab (U+0000-U+001F, U+007F-U+009F).
needs_byte_spelling: fn(bytes: [U8]) -> Bool Never! {
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if (code < 32 && code != 9 && code != 10) || code == 127 -> return true
        if code == 194 && index + 1 < bytes.len() && Int.from_u8(bytes[index + 1]) < 160 && Int.from_u8(bytes[index + 1]) >= 128 -> return true
    }
    false
}

// `value` as a Jet string expression: a literal with `\\ \" \n \t` escaped
// and braces doubled, or `String.from_bytes([U8]{…}) ?? ""` for a text
// holding another control character.
jet_string: fn(value: String) -> String Never! {
    bytes: value.bytes()
    if needs_byte_spelling(bytes) {
        items: loop byte in bytes -> "U8{{{Int.from_u8(byte)}}}"
        return "String.from_bytes([U8]{{{items.join(", ")}}}) ?? \"\""
    }
    parts := [String]{"\""}
    start := 0
    loop index in 0..<bytes.len() {
        escape: if Int.from_u8(bytes[index]) == {
            92 -> "\\\\"
            34 -> "\\\""
            10 -> "\\n"
            9 -> "\\t"
            123 -> "{{{{"
            125 -> "}}}}"
            else -> ""
        }
        if escape == "" -> next
        parts.push(byte_slice(value, start, index))
        parts.push(escape)
        start = index + 1
    }
    parts.push(byte_tail(value, start))
    parts.push("\"")
    parts.join("")
}

string_list: fn(values: [String]) -> String Never! {
    literals: loop value in values -> jet_string(value)
    "[String]{{{literals.join(", ")}}}"
}

bool_text: fn(value: Bool) -> String Never! { if value -> "true" else -> "false" }

// One row per effect name the types of `source` declare, in source order:
// a type's own name, then each case of an enum family. The text is read in
// its constrained form: `Name: struct {` or `Name: enum {`, case lines, and an
// `impl Effect {}` block or one holding the one-line
// `irreversible: fn(self) -> Bool { … }` whose body is `true`, `false`,
// `self == .Case` or an `||` of those. A family is irreversible when any of
// its cases is. With `machine` (the rows of EFFECTS_PATH), `source` is
// CORE_EFFECTS_PATH or META_EFFECTS_PATH: each type has a `#FX(…)` line right
// above it, its entries machine effects, which become the `kernel` of its
// rows; a bare `#FX` lists none, so a row naming the type admits no machine
// effect.
effect_rows: fn(source: String, path: String, machine: [EffectRow]?) -> [EffectRow] CoreRowsError! {
    rows := [EffectRow]{}
    lines: source.split("\n").to_list()
    type_name := ""
    family := false
    cases := [String]{}
    body := String?{None}
    impl_seen := false
    in_impl := false
    kernel := [String]{}
    listed := false
    loop index in 0..<lines.len() {
        raw: lines[index]
        comment: raw.find("//")
        line: (if comment < 0 -> raw else -> byte_slice(raw, 0, comment)).trim()
        if line == "" -> next
        fields: line.words()
        place: "{path}:{index + 1}"
        if type_name == "" {
            if machine == .Val(known) {
                if line == "#FX" && !listed {
                    kernel = [String]{}
                    listed = true
                    next
                }
                if line.starts_with("#FX(") && line.ends_with(")") && !listed {
                    kernel = effect_kernel_list(line, known, place) ?? return Err(err)
                    listed = true
                    next
                }
                if !listed -> return Err(rows_fail("{place}: expected the `#FX` or `#FX(…)` line above a Core effect"))
            }
            if fields.len() != 3 || !fields[0].ends_with(":") || (fields[1] != "struct" && fields[1] != "enum") || fields[2] != "{{" -> return Err(rows_fail("{place}: expected `Name: struct {{` or `Name: enum {{`"))
            name: byte_slice(fields[0], 0, fields[0].len() - 1)
            loop seen in rows {
                if seen.name == name -> return Err(rows_fail("{place}: duplicate effect {name}"))
            }
            if machine == .Val(known) {
                loop seen in known {
                    if seen.name == name -> return Err(rows_fail("{place}: `{name}` is already a machine effect of {EFFECTS_PATH}"))
                }
            }
            type_name = name
            family = fields[1] == "enum"
            cases = [String]{}
            body = None
            impl_seen = false
            next
        }
        if in_impl {
            if line == "}}" {
                in_impl = false
                next
            }
            if body != None || !line.starts_with("irreversible: fn(self) -> Bool {{ ") || !line.ends_with(" }}") -> return Err(rows_fail("{place}: expected one `irreversible: fn(self) -> Bool {{ … }}` line in `impl Effect`"))
            body = Val(byte_slice(line, "irreversible: fn(self) -> Bool {{ ".len(), line.len() - 2).trim())
            next
        }
        if line == "impl Effect {{}}" || line == "impl Effect {{" {
            if impl_seen -> return Err(rows_fail("{place}: `{type_name}` has a second `impl Effect` block"))
            impl_seen = true
            in_impl = line == "impl Effect {{"
            next
        }
        if line == "}}" {
            if !impl_seen -> return Err(rows_fail("{place}: `{type_name}` has no `impl Effect` block"))
            if family && cases.len() == 0 -> return Err(rows_fail("{place}: the effect family `{type_name}` has no cases"))
            case_rows := [EffectRow]{}
            any := false
            loop member in cases {
                irreversible: effect_fact(body, cases, Val(member)) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true`, `false`, `self == .Case` or an `||` of those"))
                if irreversible -> any = true
                case_rows.push(EffectRow{name: "{type_name}.{member}", irreversible: irreversible})
            }
            root := any
            if !family {
                root = effect_fact(body, cases, None) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true` or `false`"))
            }
            rows.push(EffectRow{name: type_name, irreversible: root, kernel: kernel.copy()})
            loop row in case_rows {
                rows.push(EffectRow{name: row.name, irreversible: row.irreversible, kernel: kernel.copy()})
            }
            type_name = ""
            kernel = [String]{}
            listed = false
            next
        }
        if !family || fields.len() != 1 || impl_seen -> return Err(rows_fail("{place}: expected an effect family case name, `impl Effect` or `}}`"))
        if cases.contains(line) -> return Err(rows_fail("{place}: duplicate effect {type_name}.{line}"))
        cases.push(line)
    }
    if type_name != "" -> return Err(rows_fail("{path}: `{type_name}` is not closed"))
    if rows.len() == 0 -> return Err(rows_fail("{path} declares no effects"))
    Ok(rows)
}

// The machine effects of a `#FX(…)` line above a Core effect: each entry a
// root or leaf of `machine`, listed once, none denied.
effect_kernel_list: fn(line: String, machine: [EffectRow], place: String) -> [String] CoreRowsError! {
    kernel := [String]{}
    loop part in byte_slice(line, "#FX(".len(), line.len() - 1).split(",") {
        entry: part.trim()
        known: loop row in machine {
            if row.name == entry -> break true
        } ?? false
        if !known -> return Err(rows_fail("{place}: `{entry}` is no machine effect of {EFFECTS_PATH}"))
        if kernel.contains(entry) -> return Err(rows_fail("{place}: `{entry}` is listed twice"))
        kernel.push(entry)
    }
    if kernel.len() == 0 -> return Err(rows_fail("{place}: the `#FX(…)` line lists no machine effect"))
    Ok(kernel)
}

// An `irreversible` body's value for one case (None for a struct), or None
// when the body is not the effect fact form. No body is `false`.
effect_fact: fn(body: String?, cases: [String], member: String?) -> Bool? Never! {
    written: body ?? return Val(false)
    holds := false
    loop part in written.split("||") {
        term: part.trim()
        if {
            term == "true" -> holds = true
            term == "false" -> {}
            term.starts_with("self == .") -> {
                named: byte_slice(term, "self == .".len(), term.len())
                if member == None || !cases.contains(named) -> return None
                if member == .Val(case_name) && case_name == named -> holds = true
            }
            else -> return None
        }
    }
    Val(holds)
}

// The effect names that are leaves (`Root.Member`) or, with `leaf` false, roots.
effect_names: fn(rows: [EffectRow], leaf: Bool) -> [String] Never! {
    out := [String]{}
    loop row in rows {
        if row.name.contains(".") == leaf -> out.push(row.name)
    }
    out
}

// `text` (the file at `path`) with the cases of its `<type_name>: enum { … }`
// block rewritten to `cases`, one per line, in order.
enum_cases_text: fn(text: String, path: String, type_name: String, cases: [String]) -> String CoreRowsError! {
    opener: "{type_name}: enum {{"
    out := [String]{}
    // 0 before the enum, 1 inside it, 2 after it.
    state := 0
    loop line in text.split("\n") {
        if state == 1 {
            if line == "}}" {
                loop name in cases -> out.push("    {name}")
                out.push(line)
                state = 2
            }
            next
        }
        out.push(line.copy())
        if state == 0 && line == opener -> state = 1
    }
    if state != 2 -> return Err(rows_fail("{path} has no closed `{opener}` block"))
    Ok(out.join("\n"))
}

// Core.jet with the `<type_name>:plain(…)` type of its `core.compiler.lang`
// declaration rewritten to `cases`.
core_lang_type_text: fn(core: String, type_name: String, cases: [String]) -> String CoreRowsError! {
    marker: " {type_name}:plain("
    out := [String]{}
    found := false
    loop line in core.split("\n") {
        if !line.starts_with(CORE_LANG_MODULE) {
            out.push(line)
            next
        }
        start: line.find(marker)
        if start < 0 -> return Err(rows_fail("{CORE_PATH}: the `core.compiler.lang` declaration has no `{type_name}:plain(…)` type"))
        open: start + marker.len()
        rest: byte_slice(line, open, line.len())
        close: rest.find(")")
        if close < 0 -> return Err(rows_fail("{CORE_PATH}: the `core.compiler.lang` `{type_name}:plain(` type is not closed"))
        out.push("{byte_slice(line, 0, open)}{cases.join("|")}{byte_slice(rest, close, rest.len())}")
        found = true
    }
    if !found -> return Err(rows_fail("{CORE_PATH} declares no `core.compiler.lang` module"))
    Ok(out.join("\n"))
}

// Foundation's closed `Effect` type: the machine roots of Effects.jet.
render_effect_roots: fn(effects: String, roots: [String]) -> String Never! {
    "// Source: {EFFECTS_PATH}\n// Source SHA-256: {crypto.sha256(effects).hex()}\n{GENERATED_BY}\n// The machine roots of {EFFECTS_PATH} as the compiler's closed effect type.\nEffect: enum {{ {roots.join(" ")} }}\n"
}

// The foreign languages: the cases of the `FFI` effect family, in source order.
ffi_languages: fn(rows: [EffectRow]) -> [String] Never! {
    prefix: "{FFI_ROOT}."
    out := [String]{}
    loop row in rows {
        if row.name.starts_with(prefix) -> out.push(byte_tail(row.name, byte_len(prefix)))
    }
    out
}


CoreSourceViews: struct {
    files: [GeneratedFile]
    rows: Int
    effects: Int
    source_hash: String
    declarations: CoreDeclarations
}

render_owned_row: fn(row: CoreSourceRow, type_exports: [String]) -> String Never! {
    "    CoreSourceOwnedRow{{module_name: {jet_string(row.module_name)}, alias: {jet_string(row.alias)}, path: {jet_string(row.path)}, owner: {jet_string(row.owner)}, owned_members: {string_list(row.members)}, type_exports: {string_list(type_exports)}, impl_types: {string_list(row.impl_types)}, runtime: {bool_text(row.runtime)}}},"
}

// Core/EmbeddedSources.jet, the compiler-private part `__core_embedded_sources`
// of core.devtools: one comptime constant per row that embeds the row's file
// (this one included) from beside it, one per Core asset (core_assets) that
// embeds its bytes, and the lookups of a row's text and an asset's bytes by
// repository path.
render_embedded_sources: fn(header: String, rows: [CoreSourceRow], assets: [String]) -> String CoreRowsError! {
    constants := [String]{}
    lookups := [String]{}
    loop (index, row) in rows {
        if !row.path.starts_with("Core/") -> return Err(rows_fail("Core source row {row.module_name} is outside Core/: {row.path}"))
        constants.push("CORE_SOURCE_{index}: comptime {{ embed_file({jet_string(byte_tail(row.path, byte_len("Core/")))}) }}")
        lookups.push("    if path == {jet_string(row.path)} -> return Val(CORE_SOURCE_{index})")
    }
    asset_constants := [String]{}
    asset_lookups := [String]{}
    loop (index, asset) in assets {
        asset_constants.push("CORE_ASSET_{index}: comptime {{ embed_bytes({jet_string(byte_tail(asset, byte_len("Core/")))}) }}\n")
        asset_lookups.push("    if path == {jet_string(asset)} -> return Val(CORE_ASSET_{index})\n")
    }
    Ok("{header}// The compiler-private part `__core_embedded_sources` of core.devtools: the\n// text of every CORE_SOURCE_OWNED_ROWS row, this file included, and the bytes\n// of every file a Core source embeds, embedded from beside it when jet is\n// built, so a jet with no checkout reads Core and its assets from itself\n// (core.devtools.toolchain_core_source and toolchain_core_asset, which only the\n// jet_cli package may name).\n\n{constants.join("\n")}\n{asset_constants.join("")}\n// The embedded text of the row at repository path `path`, or None when no row\n// has that path.\nsource_text: fn(path: String) -> String? Never! {{\n{lookups.join("\n")}\n    None\n}}\n\n// The embedded bytes of the Core asset at repository path `path`, or None\n// when no Core source embeds that path.\nasset_bytes: fn(path: String) -> [U8]? Never! {{\n{asset_lookups.join("")}    None\n}}\n")
}

// The files `text` names with `embed_bytes("…")` or `embed_file("…")` outside
// comments, each once in source order, as written (relative to the file's
// own directory).
embedded_names: fn(text: String) -> [String] Never! {
    names := [String]{}
    loop line in text.split("\n") {
        if line.trim_start().starts_with("//") -> next
        loop call in ([String]{"embed_bytes(\"", "embed_file(\""}) {
            rest := line.copy()
            loop rest.contains(call) {
                after: rest.partition(call).tail
                name: after.partition("\"").head
                if name != "" && !names.contains(name) -> names.push(name.copy())
                rest = after.copy()
            }
        }
    }
    names
}

// The repository directory of the Core file at `path` (`Core/Ui` for
// `Core/Ui/Xkb.jet`).
core_directory: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    kept := [String]{}
    loop (index, part) in parts {
        if index + 1 < parts.len() -> kept.push(part.copy())
    }
    kept.join("/")
}

// Every Core asset: each file a row's source embeds, as a repository path
// beside that source, once, in row order. The embedded-sources part embeds
// the rows themselves, and a row file another source embeds is already
// built in as text, so neither is an asset. A named file that is missing
// refuses the rows.
core_assets: fn(rows: [CoreSourceRow]) -[FS]> [String] CoreRowsError! {
    row_paths: loop row in rows -> row.path
    assets := [String]{}
    loop row in rows {
        if row.path == EMBEDDED_TARGET_PATH -> next
        text: read_source(row.path) ?? return Err(err)
        directory: core_directory(row.path)
        loop name in embedded_names(text) {
            asset: "{directory}/{name}"
            if row_paths.contains(asset) || assets.contains(asset) -> next
            if !files.exists(asset) -> return Err(rows_fail("{row.path} embeds {name}, but {asset} does not exist"))
            assets.push(asset)
        }
    }
    Ok(assets)
}

// One CORE_CALL_EXTENSIONS row: a CoreCallRecord literal per line, already in
// the CoreCallRows.jet spelling.
EXTENSIONS_HEAD: "CORE_CALL_EXTENSIONS: [CoreCallRecord]{{"
EXTENSION_ROW: Regex{"^    (CoreCallRecord\{{.*\}}),$"}
ROW_KEY: Regex{"module_name: (.+?), member: (.+?), receiver_types: \[String\]\{{(.*?)\}}, signature:"}
ROW_STRING: Regex{"\x22[^\x22]*\x22|String\.from_bytes\(\[U8\]\{{[^\]]*?\}}\)"}
ROW_QUOTED: Regex{"^\x22([^\x22]*)\x22$"}
ROW_BYTE: Regex{"U8\{{([0-9]+)\}}"}

call_extension_rows: fn(source: String) -> [String] CoreRowsError! {
    rows := [String]{}
    // 0 before the list, 1 inside it, 2 after it.
    state := 0
    lines: source.split("\n").to_list()
    loop index in 0..<lines.len() {
        raw: lines[index]
        place: "{CALL_EXTENSIONS_PATH} line {index + 1}"
        if state == 0 {
            if raw == EXTENSIONS_HEAD {
                state = 1
                next
            }
            if raw != "" && !raw.starts_with("//") -> return Err(rows_fail("{place} precedes `{EXTENSIONS_HEAD}`"))
            next
        }
        if state == 2 {
            if raw != "" -> return Err(rows_fail("{place} follows the CORE_CALL_EXTENSIONS list"))
            next
        }
        if raw == "}}" {
            state = 2
            next
        }
        found: EXTENSION_ROW.match(raw) ?? return Err(rows_fail("{place} is not one CoreCallRecord literal row"))
        rows.push(found.group(1) ?? "")
    }
    if state != 2 -> return Err(rows_fail("{CALL_EXTENSIONS_PATH} has no closed CORE_CALL_EXTENSIONS list"))
    if rows.len() == 0 -> return Err(rows_fail("{CALL_EXTENSIONS_PATH} has no rows"))
    Ok(rows)
}

// The text of a row's string: `"text"` or `String.from_bytes([U8]{U8{n}, …})`.
row_text: fn(expression: String) -> String CoreRowsError! {
    if ROW_QUOTED.match(expression) == .Val(found) -> return Ok(found.group(1) ?? "")
    if !expression.starts_with("String.from_bytes(") -> return Err(rows_fail("CoreCallRecord row string is neither quoted nor from_bytes: {expression}"))
    bytes := [U8]{}
    loop found in ROW_BYTE.matches(expression) -> bytes.push(U8{Int.parse(found.group(1) ?? "") ?? 0})
    Ok(String.from_bytes(bytes) ?? return Err(rows_fail("CoreCallRecord row string is not UTF-8: {expression}")))
}

// CoreCalls.jet's core_call_key of one CoreCallRecord literal row.
row_key: fn(row: String) -> String CoreRowsError! {
    found: ROW_KEY.match(row) ?? return Err(rows_fail("CoreCallRecord row has no module_name/member/receiver_types prefix: {row}"))
    receivers := [String]{}
    loop item in ROW_STRING.matches(found.group(3) ?? "") -> receivers.push(row_text(item.text) ?? return Err(err))
    member: row_text(found.group(2) ?? "") ?? return Err(err)
    if receivers.len() > 0 -> return Ok("receiver({receivers.join("|")}).{member}")
    Ok("{row_text(found.group(1) ?? "") ?? return Err(err)}.{member}")
}

// CoreCallRows.jet: Core.jet's dispatcher rows in order, then the extension
// rows, then CORE_MODULE_EXPORTS. Lookups take the first row per
// core_call_key and IR canonicalization refuses a duplicate, so an extension
// row may not repeat a dispatcher key.
render_call_rows: fn(core_hash: String, extensions: String, declarations: CoreDeclarations) -> String CoreRowsError! {
    lines := [String]{
        "// BEGIN GENERATED CORE CALL ROWS",
        "// Source: {CORE_PATH}",
        "// Source SHA-256: {core_hash}",
        "// Source: {CALL_EXTENSIONS_PATH} (appended in declaration order)",
        "// Source SHA-256: {crypto.sha256(extensions).hex()}",
        "// Core ABI rows keep Core.jet order followed by the CoreCallExtensions.jet order.",
        "// Each row is an evaluated CoreCallRecord literal, so the table lands without",
        "// a compile-time execution host.",
        "// CoreModuleExportNames is the separate module/export-name projection.",
        "CORE_CALLS: comptime {{ [CoreCallRecord]{{",
    }
    keys := [String: String]{}
    loop row in declarations.dispatcher_rows {
        literal: record_literal(row.record)
        keys[row_key(literal) ?? return Err(err)] = "Core.jet"
        lines.push("    {literal},")
    }
    loop row in call_extension_rows(extensions) ?? return Err(err) {
        key: row_key(row) ?? return Err(err)
        if keys.get(key) == .Val(owner) -> return Err(rows_fail("{CALL_EXTENSIONS_PATH} row `{key}` repeats a {owner} row; drop the extension row"))
        keys[key] = CALL_EXTENSIONS_PATH
        lines.push("    {row},")
    }
    lines.push("}} }}")
    lines.push("")
    lines.push("// Module/member/type names follow Core.jet module declaration order.")
    lines.push("CORE_MODULE_EXPORTS: [CoreModuleExportNames]{{")
    loop entry in declarations.modules {
        type_names: loop leaf in entry.types -> leaf.name
        lines.push("    CoreModuleExportNames{{module_name: {jet_string(entry.name)}, members: {string_list(entry.members)}, type_exports: {string_list(type_names)}}},")
    }
    lines.push("}}")
    lines.push("// END GENERATED CORE CALL ROWS")
    lines.push("")
    Ok(lines.join("\n"))
}

// The byte offset just inside `<name>: enum {` in one Core source text, or
// -1 when the text does not declare it (a compiler-owned family).
enum_body_start: fn(text: String, name: String) -> Int CoreRowsError! {
    header: regex.compile("(?:^|\n)[ \t]*(?:pub\\s+)?{name}:\\s*enum\\s*\\{{") ?? return Err(rows_fail("enum header pattern for {name}: {err}"))
    found: header.match(text) ?? return Ok(-1)
    Ok(text.find(found.text) + byte_len(found.text))
}

// The variant names of the enum body at byte `open`: the upper-case names at
// its top level; payloads, discriminants and methods are skipped.
source_enum_variants: fn(text: String, open: Int) -> [String] Never! {
    bytes: text.bytes()
    end := open
    depth := 1
    loop depth > 0 && end < bytes.len() {
        if Int.from_u8(bytes[end]) == {
            123 -> depth += 1
            125 -> depth -= 1
            else -> {}
        }
        end += 1
    }
    kept: loop line in byte_slice(text, open, end - 1).split("\n") -> if line.find("//") < 0 -> line.copy() else -> byte_slice(line, 0, line.find("//"))
    body: kept.join("\n")
    code_bytes: body.bytes()
    variants := [String]{}
    nesting := 0
    index := 0
    loop index < code_bytes.len() {
        code: Int.from_u8(code_bytes[index])
        if code == 40 || code == 91 || code == 123 {
            nesting += 1
            index += 1
            next
        }
        if code == 41 || code == 93 || code == 125 {
            nesting -= 1
            index += 1
            next
        }
        if nesting != 0 || !(is_lower_byte(code) || is_upper_byte(code) || code == 95) {
            index += 1
            next
        }
        word_end := index + 1
        loop word_end < code_bytes.len() && is_word_byte(Int.from_u8(code_bytes[word_end])) -> word_end += 1
        word: byte_slice(body, index, word_end)
        if word == "fn" || word == "impl" -> break
        if is_upper_byte(code) -> variants.push(word)
        index = word_end
    }
    variants
}

is_word_byte: fn(code: Int) -> Bool Never! { is_lower_byte(code) || is_upper_byte(code) || is_digit_byte(code) || code == 95 }

enum_kind: fn(variants: [String]) -> String Never! { "CoreLeafKind.Enum{{variants: {string_list(variants)}}}" }

type_export: fn(name: String, kind: String) -> String Never! { "CoreModuleTypeExport{{name: {jet_string(name)}, kind: {kind}}}" }

// CoreEnumRows.jet: the Core enum leaves for `core_enum_variants`, in Core.jet
// module declaration order, then the source-owned nominals. Every module that
// exports one enum leaf must declare the same variants, and so must the Core
// source that defines it, read from `rewritten` when this run rewrites it.
render_enum_rows: fn(core_hash: String, declarations: CoreDeclarations, rewritten: [String: String]) -[FS]> String CoreRowsError! {
    lines := [String]{
        "// BEGIN GENERATED CORE ENUM ROWS",
        "// Source: {CORE_PATH}",
        "// Source SHA-256: {core_hash}",
        "// Core enum leaves in Core.jet module declaration order; the first row",
        "// naming a type is its canonical variant list.",
        "CORE_ENUM_ROWS: [CoreModuleTypeExport]{{",
    }
    seen := [String: String]{}
    loop entry in declarations.modules {
        loop leaf in entry.types {
            if leaf.generic_arity > 0 || leaf.variants.len() == 0 -> next
            variants: leaf.variants.join("|")
            if seen.get(leaf.name) == .Val(earlier) && earlier != variants -> return Err(rows_fail("{CORE_PATH}: Core enum leaf {leaf.name} has different variants in {entry.name}"))
            seen[leaf.name] = variants
            loop source in declarations.source_rows {
                if source.module_name != entry.name -> next
                text: if rewritten.get(source.path) == .Val(view) -> view.copy() else -> read_source(source.path) ?? return Err(err)
                open: enum_body_start(text, leaf.name) ?? return Err(err)
                if open < 0 -> next
                listed: source_enum_variants(text, open).join("|")
                if listed != variants -> return Err(rows_fail("{CORE_PATH}: Core enum leaf {leaf.name} of {entry.name} lists {variants} but {source.path} declares {listed}"))
            }
            lines.push("    {type_export(leaf.name, enum_kind(leaf.variants))},")
        }
    }
    lines.push("}}")
    lines.push("")
    lines.push("// Source-owned Core nominals (`source_module … types {{ … }}`) in Core.jet")
    lines.push("// order; the Rust mirror is CoreModuleExports::CORE_SOURCE_OWNED_TYPES.")
    lines.push("CORE_SOURCE_OWNED_TYPES: [CoreSourceOwnedType]{{")
    loop source in declarations.source_rows {
        loop owned in source.owned_types -> lines.push("    CoreSourceOwnedType{{path: {jet_string(source.path)}, name: {jet_string(owned)}}},")
    }
    lines.push("}}")
    lines.push("// END GENERATED CORE ENUM ROWS")
    lines.push("")
    Ok(lines.join("\n"))
}

structure_export: fn(leaf: CoreType) -> String Never! {
    kind: if {
        leaf.generic_arity > 0 -> "CoreLeafKind.Generic{{arity: {leaf.generic_arity}}}"
        leaf.variants.len() > 0 -> enum_kind(leaf.variants)
        leaf.kind == "crypto_nominal" -> "CoreLeafKind.CryptoNominal"
        else -> "CoreLeafKind.Plain"
    }
    type_export(leaf.name, kind)
}

// CoreStructureRows.jet: the bootstrap steps, root types and module
// declarations of Core.jet, in declaration order, for
// `jet inspect structure core`.
render_structure_rows: fn(core_hash: String, declarations: CoreDeclarations) -> String Never! {
    lines := [String]{"// Source: {CORE_PATH}", "// Source SHA-256: {core_hash}", GENERATED_BY, "use jet_foundation.[CoreLeafKind, CoreModuleTypeExport, CoreModuleDeclaration]", "", "JET_CLI_CORE_BOOTSTRAP: [JetCLICoreBootstrap]{{"}
    loop step in declarations.bootstraps -> lines.push("    {{name: {jet_string(step.name)}, dependencies: {string_list(step.dependencies)}}},")
    lines.push("}}")
    lines.push("JET_CLI_CORE_ROOT_TYPES: {string_list(declarations.root_types)}")
    lines.push("JET_CLI_CORE_DECLARATIONS: [CoreModuleDeclaration]{{")
    loop entry in declarations.modules {
        exports: loop leaf in entry.types -> structure_export(leaf)
        lines.push("    {{module_name: {jet_string(entry.name)}, members: {string_list(entry.members)}, type_exports: [CoreModuleTypeExport]{{{exports.join(", ")}}}, dependencies: {string_list(entry.dependencies)}}},")
    }
    lines.push("}}")
    lines.push("")
    lines.join("\n")
}

PAYLOAD_HEAD: "CORE_ENUM_PAYLOAD_ROWS: [CoreEnumPayloadRow]{{\n"
PAYLOAD_ROW: Regex{"^    CoreEnumPayloadRow\{{enum_name: \x22([A-Za-z_][A-Za-z0-9_]*)\x22, variant: \x22[A-Za-z_][A-Za-z0-9_]*\x22, payload: \[Type\]\{{.*\}}\}},$"}

// CoreEnumPayloadRows.jet: its authored CORE_ENUM_PAYLOAD_ROWS, then the
// derived JET_CORE_OWNER_ANNOTATION_SUFFIXES. Owning an opaque impl or a
// compiler enum menu does not create an export, so the qualified-annotation
// gate's suffixes are the CORE_SOURCE_OWNED_ROWS impl types, then the payload
// rows' enum names, each once in first-occurrence order.
render_enum_payload_rows: fn(current: String, rows: [CoreSourceRow]) -> String CoreRowsError! {
    start: current.find(PAYLOAD_HEAD)
    close: if start < 0 -> -1 else -> byte_tail(current, start).find("\n}}\n")
    if close < 0 -> return Err(rows_fail("{ENUM_PAYLOAD_ROWS_PATH} has no CORE_ENUM_PAYLOAD_ROWS table"))
    end: start + close
    suffixes := [String]{}
    loop row in rows {
        loop name in row.impl_types {
            if !is_name(name, "") -> return Err(rows_fail("{OWNERSHIP_TARGET_PATH}: unreadable impl type {name}"))
            if !suffixes.contains(".{name}") -> suffixes.push(".{name}")
        }
    }
    loop raw in byte_slice(current, start + byte_len(PAYLOAD_HEAD), end).split("\n") {
        found: PAYLOAD_ROW.match(raw) ?? return Err(rows_fail("{ENUM_PAYLOAD_ROWS_PATH}: unreadable CoreEnumPayloadRow line: {raw}"))
        suffix: ".{found.group(1) ?? ""}"
        if !suffixes.contains(suffix) -> suffixes.push(suffix)
    }
    lines := [String]{
        byte_slice(current, 0, end + byte_len("\n}}\n")),
        "// Owning an opaque impl or a compiler enum menu does not create an export.",
        "// Qualified-annotation suffixes: {OWNERSHIP_TARGET_PATH} impl types,",
        "// then the enum names above, each once in first-occurrence order.",
        "JET_CORE_OWNER_ANNOTATION_SUFFIXES: [String]{{",
    }
    loop suffix in suffixes -> lines.push("    {jet_string(suffix)},")
    lines.push("}}")
    lines.push("")
    Ok(lines.join("\n"))
}

read_source: fn(path: String) -[FS]> String CoreRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

// Every view, rendered from the sources as they are on disk; Core.jet's
// declarations are read after its effect-root and foreign-language rewrites.
read_core_source_views: fn() -[FS]> CoreSourceViews CoreRowsError! {
    raw_core: read_source(CORE_PATH) ?? return Err(err)
    parts: read_source(PARTS_PATH) ?? return Err(err)
    effects: read_source(EFFECTS_PATH) ?? return Err(err)
    core_effects: read_source(CORE_EFFECTS_PATH) ?? return Err(err)
    meta_effects: read_source(META_EFFECTS_PATH) ?? return Err(err)
    lang: read_source(LANG_PATH) ?? return Err(err)
    extensions: read_source(CALL_EXTENSIONS_PATH) ?? return Err(err)
    payload: read_source(ENUM_PAYLOAD_ROWS_PATH) ?? return Err(err)
    machine: effect_rows(effects, EFFECTS_PATH, None) ?? return Err(err)
    declared := machine.copy()
    loop row in effect_rows(core_effects, CORE_EFFECTS_PATH, Val(machine)) ?? return Err(err) -> declared.push(row)
    loop row in effect_rows(meta_effects, META_EFFECTS_PATH, Val(machine)) ?? return Err(err) {
        loop seen in declared {
            if seen.name == row.name -> return Err(rows_fail("{META_EFFECTS_PATH}: duplicate effect {row.name}"))
        }
        declared.push(row)
    }
    root_names: effect_names(declared, false)
    canonical: "{effects.trim_end()}\n\n{core_effects.trim_end()}\n\n{meta_effects.trim_end()}\n"
    languages: ffi_languages(declared)
    if languages.len() == 0 -> return Err(rows_fail("{EFFECTS_PATH} declares no `{FFI_ROOT}` languages"))
    core: core_lang_type_text(core_lang_type_text(raw_core, "Effect", root_names) ?? return Err(err), LANG_FFI_TYPE, languages) ?? return Err(err)
    constants: syntax_constants() ?? return Err(err)
    runtime: runtime_units() ?? return Err(err)
    declarations: core_declarations(core, constants, runtime) ?? return Err(err)
    effect_problem: effect_roots_problem(declared)
    if effect_problem != "" -> return Err(rows_fail(effect_problem))
    names_problem: core_names_problem(declarations)
    if names_problem != "" -> return Err(rows_fail(names_problem))
    mem_problem: core_mem_problem(declarations, constants) ?? return Err(err)
    if mem_problem != "" -> return Err(rows_fail(mem_problem))
    operations_doc: replace_operation_section(read_source(OPERATIONS_DOC_PATH) ?? return Err(err), render_operation_tables(read_source(OPERATIONS_SOURCE_PATH) ?? return Err(err)) ?? return Err(err)) ?? return Err(err)
    rows := declarations.source_rows.copy()
    loop row in source_parts(parts) ?? return Err(err) -> rows.push(row)
    loop row in runtime -> rows.push(row.copy())
    runtime_paths: loop row in runtime -> row.path
    source_hash: crypto.sha256("{core}{parts}{runtime_paths.join("\n")}{canonical}").hex()
    header: "// Sources: {CORE_PATH} (source_module rows), {PARTS_PATH} (private parts), {RUNTIME_PATTERN} (runtime units), {EFFECTS_PATH}, {CORE_EFFECTS_PATH} and {META_EFFECTS_PATH} (effect source)\n// Source SHA-256: {source_hash}\n{GENERATED_BY}\n"
    type_names := [String: [String]]{}
    loop entry in declarations.modules {
        type_names[entry.name] = loop leaf in entry.types -> leaf.name
    }
    rendered := [String]{}
    loop row in rows -> rendered.push(render_owned_row(row, type_names.get(row.module_name) ?? [String]{}))
    ownership: "{header}CoreSourceOwnedRow: struct {{\n    module_name: String\n    alias: String\n    path: String\n    owner: String\n    owned_members: [String]\n    type_exports: [String]\n    impl_types: [String]\n    runtime: Bool\n}}\n\n// A nominal is source-owned only when this registration row and a loaded\n// source declaration agree. Opaque impl ownership uses the module's row.\nCORE_SOURCE_OWNED_ROWS: comptime {{ [CoreSourceOwnedRow]{{\n{rendered.join("\n")}\n}} }}\n"
    lang_text: enum_cases_text(enum_cases_text(lang, LANG_PATH, "Effect", root_names) ?? return Err(err), LANG_PATH, LANG_FFI_TYPE, languages) ?? return Err(err)
    rewritten := [String: String]{}
    rewritten[LANG_PATH] = lang_text.copy()
    assets: core_assets(rows) ?? return Err(err)
    embedded: render_embedded_sources(header, rows, assets) ?? return Err(err)
    core_hash: crypto.sha256(core).hex()
    outputs: [GeneratedFile]{
        GeneratedFile{path: OWNERSHIP_TARGET_PATH, text: ownership},
        GeneratedFile{path: EFFECT_ROOTS_TARGET_PATH, text: render_effect_roots(effects, effect_names(machine, false))},
        GeneratedFile{path: EMBEDDED_TARGET_PATH, text: embedded},
        GeneratedFile{path: LANG_PATH, text: lang_text},
        GeneratedFile{path: CORE_PATH, text: core},
        GeneratedFile{path: CALL_ROWS_PATH, text: render_call_rows(core_hash, extensions, declarations) ?? return Err(err)},
        GeneratedFile{path: ENUM_ROWS_PATH, text: render_enum_rows(core_hash, declarations, rewritten) ?? return Err(err)},
        GeneratedFile{path: STRUCTURE_ROWS_PATH, text: render_structure_rows(core_hash, declarations)},
        GeneratedFile{path: ENUM_PAYLOAD_ROWS_PATH, text: render_enum_payload_rows(payload, rows) ?? return Err(err)},
        GeneratedFile{path: OPERATIONS_DOC_PATH, text: operations_doc},
    }
    Ok(CoreSourceViews{files: outputs, rows: rows.len(), effects: declared.len(), source_hash: source_hash, declarations: declarations})
}

// The file's text, or "" when it does not exist.
current_text: fn(path: String) -[FS]> String CoreRowsError! {
    if !files.exists(path) -> return Ok("")
    read_source(path)
}

// The Core module facts the surface ledger reads, one object per `module`
// line in Core.jet order, every `from()` type resolved.
core_facts: fn(declarations: CoreDeclarations) -> String CoreRowsError! {
    modules := [Dyn]{}
    loop entry in declarations.modules {
        types := [Dyn]{}
        loop leaf in entry.types {
            item := Dyn.object()
            item["name"] = Dyn.Text(leaf.name.copy())
            item["kind"] = Dyn.Text(leaf.kind.copy())
            item["variants"] = Dyn.Array(loop variant in leaf.variants -> Dyn.Text(variant.copy()))
            item["genericArity"] = if leaf.generic_arity > 0 -> Dyn.Int(leaf.generic_arity) else -> Dyn.Null
            types.push(item)
        }
        fact := Dyn.object()
        fact["module"] = Dyn.Text(entry.name.copy())
        fact["rawModules"] = Dyn.Array([Dyn]{Dyn.Text("{entry.name} (Prelude/Core.jet)")})
        fact["members"] = Dyn.Array(loop member in entry.members -> Dyn.Text(member.copy()))
        fact["sourceLine"] = Dyn.Int(entry.line)
        fact["types"] = Dyn.Array(types)
        fact["dependencies"] = Dyn.Array(loop dependency in entry.dependencies -> Dyn.Text(dependency.copy()))
        modules.push(fact)
    }
    json.to_string(Dyn.Array(modules)) ?? return Err(rows_fail("the Core module facts cannot be encoded: {err}"))
}

// No flag writes every view; `--check` refuses a stale one; `--facts` prints
// the Core module facts after the same checks.
core_source_rows_main: fn(args: [String]) -[FS]> String CoreRowsError! {
    mode: if args.len() == 1 -> args[0] else -> ""
    if args.len() > 1 || (args.len() == 1 && mode != "--check" && mode != "--facts") -> return Err(rows_fail("usage: jet Tools/agent/CoreSourceRows.jet [--check|--facts]"))
    views: read_core_source_views() ?? return Err(err)
    if mode == "--facts" -> return core_facts(views.declarations)
    summary: "{views.rows} rows, {views.effects} effects, source {views.source_hash}"
    if mode == "--check" {
        loop output in views.files {
            if (current_text(output.path) ?? return Err(err)) != output.text -> return Err(rows_fail("{output.path} is stale; run jet Tools/agent/CoreSourceRows.jet"))
        }
        return Ok("core source rows are current ({summary})")
    }
    loop output in views.files {
        files.write(output.path, output.text) ?? return Err(rows_fail("cannot write {output.path}: {err}"))
    }
    written: loop output in views.files -> output.path
    Ok("generated {written.join(", ")} ({summary})")
}

run: fn() {
    if core_source_rows_main(process.args()) == {
        .Ok(message) -> print(message)
        .Err(error) -> {
            term.eprint(error.message)
            process.exit(1)
        }
    }
}

// The error text effect_rows reports for `source`, or "" when it accepts it.
effect_rows_error: fn(source: String, machine: [EffectRow]?) -> String Never! {
    if effect_rows(source, "Effects.jet", machine) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the Core source rows are current and the effect grammar refuses malformed lines") {
    views: read_core_source_views() ?? panic("the Core source views did not render: {err.message}")
    loop output in views.files {
        assert_eq(files.read(output.path) ?? panic("{output.path} did not read"), output.text)
    }
    assert_eq(snake_segment("UnicodeCcc"), "unicode_ccc")
    assert_eq(snake_segment("HTTPServer"), "http_server")
    assert_eq(snake_segment("Utf8Bytes"), "utf8_bytes")
    assert_eq(jet_string("a{{b}}\t\"\\"), "\"a{{{{b}}}}\\t\\\"\\\\\"")
    assert_eq(jet_string(String.from_bytes([U8]{U8{0}, U8{106}}) ?? ""), "String.from_bytes([U8]{{U8{{0}}, U8{{106}}}}) ?? \"\"")
    assert_eq(embedded_names("// embed_bytes(\"note.bin\")\nA: comptime {{ embed_bytes(\"A/a.bin\") }}\nB: comptime {{ embed_file(\"b.txt\") }} // embed_bytes(\"A/a.bin\")\n"), [String]{"A/a.bin", "b.txt"})
    assert_eq(core_directory("Core/Ui/Xkb.jet"), "Core/Ui")
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ true }}\n    }}\n}}\nFS: enum {{\n    Read\n    Write\n\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\n", None) == "")
    rows: effect_rows("FS: enum {{\n    Read\n    Write\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\nIO: struct {{\n    impl Effect {{}}\n}}\n", "Effects.jet", None) ?? panic("the family was refused: {err.message}")
    assert_eq(rows.len(), 4)
    assert(rows[0].name == "FS" && rows[0].irreversible)
    assert(rows[1].name == "FS.Read" && !rows[1].irreversible)
    assert(rows[2].name == "FS.Write" && rows[2].irreversible)
    assert(rows[3].name == "IO" && !rows[3].irreversible && rows[3].kernel.len() == 0)
    assert(effect_rows_error("FS: enum {{\n    Read\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Gone }}\n    }}\n}}\n", None).contains("is not `true`, `false`"))
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{}}\n}}\nNet: struct {{\n    impl Effect {{}}\n}}\n", None).contains("duplicate effect Net"))
    assert(effect_rows_error("Net: effect\n", None).contains("expected `Name: struct {{`"))
    assert(effect_rows_error("Net: struct {{\n}}\n", None).contains("has no `impl Effect` block"))
    assert(effect_rows_error("// only a comment\n", None).contains("declares no effects"))
    assert(effect_rows_error("#FX(Net)\nNet: struct {{\n    impl Effect {{}}\n}}\n", None).contains("expected `Name: struct {{`"))
    service: effect_rows("#FX(IO, FS.Write)\nDB: enum {{\n    Read\n    Write\n    impl Effect {{}}\n}}\n", "Effects.jet", Val(rows)) ?? panic("the service effect was refused: {err.message}")
    assert_eq(service.len(), 3)
    assert(service[0].name == "DB" && service[0].kernel == [String]{"IO", "FS.Write"})
    assert(service[2].name == "DB.Write" && service[2].kernel == [String]{"IO", "FS.Write"})
    assert(effect_rows_error("DB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("expected the `#FX` or `#FX(…)` line"))
    assert(effect_rows_error("#FX(Exec)\nDB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`Exec` is no machine effect"))
    assert(effect_rows_error("#FX(IO, IO)\nDB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`IO` is listed twice"))
    assert(effect_rows_error("#FX(IO)\nFS: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`FS` is already a machine effect"))
    roots: [String]{"Net", "Rand"}
    assert_eq(enum_cases_text("A: enum {{\n    X\n}}\nEffect: enum {{\n    Crypto\n    Random\n}}\n", "Lang.jet", "Effect", roots) ?? panic("the Lang enum was refused: {err.message}"), "A: enum {{\n    X\n}}\nEffect: enum {{\n    Net\n    Rand\n}}\n")
    assert(enum_cases_text("Effect: enum {{\n    Net\n", "Lang.jet", "Effect", roots) == .Err(_))
    assert_eq(core_lang_type_text("module core.x exports {{ A }}\nmodule core.compiler.lang exports {{ Effect }} types {{ Effect:plain(FS|Proc), ABI:plain(C) }}\n", "Effect", roots) ?? panic("the Core declaration was refused: {err.message}"), "module core.x exports {{ A }}\nmodule core.compiler.lang exports {{ Effect }} types {{ Effect:plain(Net|Rand), ABI:plain(C) }}\n")
    assert(core_lang_type_text("module core.compiler.lang exports {{ Effect }} types {{ ABI:plain(C) }}\n", "Effect", roots) == .Err(_))
    assert(core_lang_type_text("module core.compiler.lang exports {{ SideEffect }} types {{ SideEffect:plain(C) }}\n", "Effect", roots) == .Err(_))
    ffi: effect_rows("Net: struct {{\n    impl Effect {{}}\n}}\nFFI: enum {{\n    C\n    Rust\n\n    impl Effect {{}}\n}}\n", "Effects.jet", None) ?? panic("the FFI family was refused: {err.message}")
    assert_eq(ffi_languages(ffi), [String]{"C", "Rust"})
    assert(render_effect_roots("", effect_names(ffi, false)).ends_with("\nEffect: enum {{ Net FFI }}\n"))
}

// The error text call_record reports for `expression`, or "".
call_record_error: fn(expression: String) -> String Never! {
    if call_record(expression, "fixture", [String: String]{}) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

// The error text dispatcher_row reports for one row, or "".
dispatcher_row_error: fn(kind: String, written_module: String, member: String, expression: String, constants: [String: String]) -> String Never! {
    if dispatcher_row(kind, written_module, member, expression, 7, constants) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("dispatcher row expressions evaluate to their CoreCallRecord facts") {
    none: [String: String]{}
    shortcut: call_record("CoreCallRecord::source_owned(\"core.ui.host\", \"shortcut\", &[false, false]).with_ui_capabilities(&[\"UI.Shortcuts\"])", "source-owned constructor fixture", none) ?? panic("the source-owned constructor was refused: {err.message}")
    assert_eq(record_literal(shortcut), "CoreCallRecord{{module_name: \"core.ui.host\", member: \"shortcut\", receiver_types: [String]{{}}, signature: CoreCallSignature{{arity: 2, max_arity: 2, borrow_mask: [Bool]{{false, false}}}}, frame_accesses: [CoreCallResourceAccess]{{}}, frame_completion: None, fallibility: CoreCallFallibility.Sema, effect_kind: None, capability: CoreCapabilityContract{{kind: CoreCapabilityKind.Pure, provider: None, fallback: None, failure: None}}, effect_leaf: None, sink_class: None, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.SourceOwned, source_target: None, coverage: CoreCallCoverage{{bits: 1}}, aot_direct: false, native_int_result: false, ui_capabilities: [String]{{\"UI.Shortcuts\"}}, marker: None, authority: None}}")
    connect: call_record("CoreCallRecord::new(\"core.net\", \"unix_connect\", \"jet_net_unix_connect\", true, &[true]).with_max_arity(2).with_source_owned().with_source_target(\"__unix_connect_entry\")", "source-owned builder fixture", none) ?? panic("the source-owned builder was refused: {err.message}")
    assert(connect.symbol == None && (connect.source_target ?? "") == "__unix_connect_entry")
    assert(connect.arity == 1 && connect.max_arity == 2 && connect.coverage == 1 && !connect.aot_direct)
    assert((connect.effect_kind ?? "") == "Net" && (connect.effect_leaf ?? "") == "Time.Wait")
    assert(connect.capability.kind == "NativeRequired" && (connect.capability.provider ?? "") == "core.net")
    assert(call_record_error("CoreCallRecord::new(\"core.mem\", \"volatile_read\", \"std::ptr::read_volatile\", false, &[false])").contains("names a retired Rust route"))
    assert(call_record_error("CoreCallRecord::new(\"core.net\", \"ip\", \"jet_net_ip\", true)").contains("expected 5 arguments"))
    assert(call_record_error("CoreCallRecord::new(\"core.net\", \"ip\", \"jet_net_ip\", true, &[true]).with_pure_route(CoreCallPureRoute::Gone)").contains("unsupported CoreCallPureRoute"))
    assert(dispatcher_row_error("plain", "core.net", "ipv6", "CoreCallRecord::new(\"core.net\", \"ipv6\", \"jet_net_ipv6\", true, &[true]),", none) == "")
    assert(dispatcher_row_error("plain", "core.net", "ipv4", "CoreCallRecord::new(\"core.net\", \"ipv6\", \"jet_net_ipv6\", true, &[true]),", none).contains("identity disagrees with emitted adapter at line 7: DSL core.net.ipv4 vs CoreCallRecord::new core.net.ipv6"))
    assert_eq(decode_rust_string("a\\u{{e9}}\\x41\\n", "fixture") ?? panic("the Rust escapes were refused"), "aéA\n")
}

#Test("an owned wrapper that calls a runtime unit instead of its provider is found") {
    units: [String]{"core.text.runtime.copy"}
    import_unit: "use kernel: core.text.runtime.copy\n"
    assert_eq(owned_wrapper_unit("{import_unit}copy: fn() -> Int {{ kernel.copy() }}\n", "core.text", "copy", units), "core.text.runtime.copy")
    // A declaration attribute does not hide the wrapper.
    assert_eq(owned_wrapper_unit("{import_unit}#Unsafe(\"validated carrier\") copy: fn() -> Int {{ kernel.copy() }}\n", "core.text", "copy", units), "core.text.runtime.copy")
    // A unit member alias names the same unit, in a `use` line or block.
    assert_eq(owned_wrapper_unit("use raw_copy: core.text.runtime.copy.copy\ncopy: fn() -> Int {{ raw_copy() }}\n", "core.text", "copy", units), "core.text.runtime.copy")
    assert_eq(owned_wrapper_unit("use {{\n    raw_copy: core.text.runtime.copy.copy\n    unicode: core.text\n}}\ncopy: fn() -> Int {{ raw_copy() }}\n", "core.text", "copy", units), "core.text.runtime.copy")
    // A compiler-owned provider call is not a runtime cutover.
    assert_eq(owned_wrapper_unit("{import_unit}copy: fn() -> Int {{ core.text.copy() }}\n", "core.text", "copy", units), "")
    // The next declaration is outside the wrapper body.
    assert_eq(owned_wrapper_unit("{import_unit}copy: fn() -> Int {{ 0 }}\ninternal: module {{\n    helper: fn() -> Int {{ kernel.copy() }}\n}}\n", "core.text", "copy", units), "")
    // The retired `pub` spelling does not declare the wrapper.
    assert_eq(owned_wrapper_unit("{import_unit}pub copy: fn() -> Int {{ kernel.copy() }}\n", "core.text", "copy", units), "")
    // A longer name ending in the local is not a call through it.
    assert_eq(owned_wrapper_unit("{import_unit}copy: fn() -> Int {{ my_kernel.copy() }}\n", "core.text", "copy", units), "")
}

// Core.jet `source`'s declarations against the sources on disk.
fixture_declarations: fn(source: String) -[FS]> CoreDeclarations CoreRowsError! {
    constants: syntax_constants() ?? return Err(err)
    runtime: runtime_units() ?? return Err(err)
    core_declarations(source, constants, runtime)
}

// The error text core_declarations reports for `source`, or "".
declarations_error: fn(source: String) -[FS]> String Never! {
    if fixture_declarations(source) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

type_in: fn(declared: CoreDeclarations, module_name: String, name: String) -> CoreType Never! {
    owner: module_named(declared.modules, module_name) ?? panic("Core.jet declares no {module_name}")
    loop leaf in owner.types {
        if leaf.name == name -> return leaf.copy()
    }
    panic("{module_name} exports no type {name}")
}

#Test("Core type references resolve to their defining type and refuse a missing or cyclic target") {
    source: files.read(CORE_PATH) ?? panic("{CORE_PATH} did not read")
    declared: fixture_declarations(source) ?? panic("Core.jet was refused: {err.message}")
    plot_types: [String]{"Aggregate", "Backend", "Channel", "FacetKind", "FilterOp", "Interaction", "LegendPosition", "Mark", "ScaleKind", "Support"}
    loop name in plot_types {
        owner: type_in(declared, "core.data.plot", "JetDataPlot{name}")
        reexport: type_in(declared, "core.data", "JetDataPlot{name}")
        assert_eq(reexport.variants, owner.variants)
        assert(reexport.generic_arity == owner.generic_arity && reexport.kind == owner.kind)
    }
    defining: "JetDataPlotAggregate:plain(Sum|Mean|Count|Min|Max)"
    changed: source.replace(defining, "JetDataPlotAggregate:plain(None|Count|Sum|Mean|Min|Max)")
    assert(changed != source)
    reordered: fixture_declarations(changed) ?? panic("the reordered variants were refused: {err.message}")
    assert_eq(type_in(reordered, "core.data", "JetDataPlotAggregate").variants, [String]{"None", "Count", "Sum", "Mean", "Min", "Max"})
    assert(declarations_error(source.replace("JetDataPlotAggregate:from(core.data.plot)", "JetDataPlotAggregate:from(core.missing)")).contains("unknown Core type reference `core.missing.JetDataPlotAggregate`"))
    assert(declarations_error(source.replace(defining, "JetDataPlotAggregate:from(core.data)")).contains("cyclic Core type reference"))
    // A private nominal is owned by its source module without joining the
    // module's public types, and still needs its exact source declaration.
    loop row in declared.source_rows {
        if row.module_name == "core.time" -> assert(row.owned_types.contains("ExpiringValue"))
    }
    assert(!(module_named(declared.modules, "core.time") ?? panic("no core.time")).types.any(leaf -> leaf.name == "ExpiringValue"))
    hidden: source.replace("TimeError, ExpiringValue }}", "TimeError, MissingPrivateType }}")
    assert(hidden != source)
    assert(declarations_error(hidden).contains("does not declare owned type `core.time.MissingPrivateType`"))
    assert(declarations_error(source.replace("format_row ETF core.encoding.eetf ETF\n", "")).contains("differ from the format_row lines"))
}

#Test("public dispatcher rows, effect roots, core.mem items and operation tables are checked") {
    declared := fixture_declarations(files.read(CORE_PATH) ?? panic("{CORE_PATH} did not read")) ?? panic("Core.jet was refused: {err.message}")
    syntax: syntax_constants() ?? panic("the Syntax constants did not read: {err.message}")
    assert_eq(public_dispatcher_problem(declared, syntax) ?? panic("the dispatcher rows were refused: {err.message}"), "")
    stray := declared.dispatcher_rows[0].copy()
    stray.kind = "receiver"
    stray.expression = "CoreCallRecord::new(\"core.nowhere\", \"probe\", \"jet_nowhere_probe\", true, &[true])"
    stray.line = 9001
    declared.dispatcher_rows.push(stray.copy())
    assert_eq(public_dispatcher_problem(declared, syntax) ?? panic("the stray row was refused: {err.message}"), "public dispatcher row names a non-ledger module: core.nowhere.probe")
    declared.dispatcher_rows.push(stray)
    duplicate: public_dispatcher_problem(declared, syntax) ?? panic("the duplicate row was refused: {err.message}")
    assert_eq(duplicate, "duplicate public dispatcher row `core.nowhere.probe` at Core.jet lines 9001 and 9001")
    assert_eq(constructor_offsets("CoreCallRecord::new_with_coverage (a), MyCoreCallRecord::new(b), CoreCallRecord::newer(c)"), [Int]{0})
    roots := [EffectRow]{}
    root_names: [String]{"Mem", "Panic", "Net", "FS", "IO", "DB", "Time", "Rand", "Env", "Exec", "Log", "GPU", "FFI"}
    loop name in root_names {
        roots.push(EffectRow{name: name, irreversible: name == "Net" || name == "FS" || name == "Exec" || name == "FFI"})
    }
    assert_eq(effect_roots_problem(roots), "")
    roots.push(EffectRow{name: "Secret", irreversible: true})
    assert(effect_roots_problem(roots).contains("must be Net, FS, Exec, and FFI"))
    assert(effect_roots_problem(roots[1..<roots.len()]).contains("deny-only root Mem is not declared"))
    constants: [String: String]{"TYPE_PTR": "Ptr", "MEM_COPY": "copy"}
    body: jet_list_body("X: 1\nTIERS: [Row]{{\n    (name: TYPE_PTR, note: \"a {{ brace\"),\n    (name: Syntax::MEM_COPY),\n    (name: \"zero\"),\n}}\n", "TIERS: ", "fixture") ?? panic("the list body was refused: {err.message}")
    assert_eq(resolve_items(body, constants), [String]{"Ptr", "a {{ brace", "copy", "zero"})
    assert(jet_list_body("TIERS: [Row]{{\n", "TIERS: ", "fixture") == .Err(_))
    law: "    {{law: CollectionLaw.Visit, timing: \"eager\", result: \"r\", callbacks: \"c\", stop: \"s\", failure: \"f\", buffering: \"b\"}},"
    operation: "    {{receivers: CollectionReceivers.List, name: \"map\", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{{CollectionArg.ItemFn}}, result: CollectionResult.Mapped, op: CollectionOp.SeqMap, law: CollectionLaw.Visit, empty: \"empty list\", status: CollectionStatus.Current}},"
    tables: render_operation_tables("// BEGIN COLLECTION LAWS\nLAWS: {{\n{law}\n}}\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\nOPS: {{\n{operation}\n}}\n// END COLLECTION OPERATIONS\n") ?? panic("the operation tables were refused: {err.message}")
    assert(tables.contains("| Visit | eager | r | c | s | f | b |\n") && tables.contains("| `[T]` | `map((item) -> T)` | borrows | Visit | empty list | current |\n"))
    assert(render_operation_tables("// BEGIN COLLECTION LAWS\n{law}\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\n{operation.replace("Visit", "Gone")}\n// END COLLECTION OPERATIONS\n") == .Err(_))
    assert(render_operation_tables("// BEGIN COLLECTION LAWS\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\n{operation}\n// END COLLECTION OPERATIONS\n") == .Err(_))
}

#Test("dispatcher rows refuse an unowned source-owned row or a mismatched adapter and accept every constructor form") {
    declared := fixture_declarations(files.read(CORE_PATH) ?? panic("{CORE_PATH} did not read")) ?? panic("Core.jet was refused: {err.message}")
    syntax: syntax_constants() ?? panic("the Syntax constants did not read: {err.message}")
    unowned: dispatcher_row("plain", "core.fake", "call", "CoreCallRecord::source_owned(\"core.fake\", \"call\", &[])", 9001, syntax) ?? panic("the source-owned row was refused: {err.message}")
    declared.dispatcher_rows.push(unowned)
    assert_eq(declarations_problem(declared), "source-owned dispatcher row has no owning source_module: core.fake.call")
    assert(dispatcher_row_error("adapter", "core.web", "form", "sema_web_call(\"core.db\", \"form\", \"jet_web_forms_typed\", &[])", syntax).contains("dispatcher row identity disagrees with emitted adapter at line 7"))
    assert(dispatcher_row_error("plain", "core.jobs", "queue", "CoreCallRecord::new(\"core.db\", \"queue\", \"jet_job_queue_default\", true, &[])", syntax).contains("dispatcher row identity disagrees with emitted adapter at line 7"))
    accepted: [(kind: String, module_name: String, member: String, expression: String)]{
        (kind: "plain", module_name: "core.jobs", member: "queue", expression: "CoreCallRecord::new(\"core.jobs\", \"queue\", \"jet_job_queue_default\", true, &[])"),
        (kind: "plain", module_name: "core.jobs", member: "covered", expression: "CoreCallRecord::new_with_coverage(\"core.jobs\", \"covered\", \"jet_job_queue_default\", true, &[], CoreCallCoverage::from_bits(CoreCallCoverage::SEMA))"),
        (kind: "adapter", module_name: "core.web", member: "form", expression: "sema_web_call(\"core.web\", \"form\", \"jet_web_forms_typed\", &[])"),
        (kind: "receiver", module_name: "-", member: "METHOD_RECEIPT_ATTACH", expression: "CoreCallRecord::receiver_with_symbol(&[INTERNAL_RECEIPT_HANDLE], METHOD_RECEIPT_ATTACH, \"jet_receipt_attach\", true, &[])"),
        (kind: "receiver", module_name: "-", member: "collect", expression: "CoreCallRecord::receiver_with_symbol(&[\"Query\"], \"collect\", \"\", true, &[true]).with_source_owned().with_source_target(\"core.data.__query_collect\")"),
    }
    loop row in accepted -> assert_eq(dispatcher_row_error(row.kind, row.module_name, row.member, row.expression, syntax), "")
    targeted: call_record("CoreCallRecord::source_owned(\"core.fake\", \"call\", &[false]).with_source_target(\"__checked_call\")", "target fixture", syntax) ?? panic("the targeted row was refused: {err.message}")
    assert(targeted.module_name == "core.fake" && targeted.member == "call" && (targeted.source_target ?? "") == "__checked_call")
    ordinary: call_record("CoreCallRecord::source_owned(\"core.fake\", \"call\", &[false])", "ordinary fixture", syntax) ?? panic("the ordinary row was refused: {err.message}")
    assert(ordinary.member == "call" && ordinary.source_target == None)
}
