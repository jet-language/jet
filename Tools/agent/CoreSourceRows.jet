#!/usr/bin/env jet
// The effect-root views of the canonical effect source and the
// collection-operation tables of the Core library reference. The effect
// roots of Compiler/Prelude/Effects.jet are the one list behind the `Effect`
// enum of Core/Compiler/Lang.jet; the cases of its `FFI` family are the one
// foreign-language list behind the `FFILanguage` enum of Lang.jet. Lang.jet's
// two enums are the one generated block of a hand-written file
// (LANG_BLOCK_BEGIN through LANG_BLOCK_END): the whole block is rewritten, so
// a hand-edited byte inside it fails `--check`, and
// tests/guards/closed_lists.jet registers this tool as the block's generator.
// Core.rows's `core.compiler.lang` types name the same lists; the compiler
// build checks them (Compiler/JetFoundation/Source/CoreDeclarations), as it
// computes every Core-declaration table from Core.rows. The effect vocabulary,
// the canonical effect source and the check of Foundation's authored
// `Effect` (the machine roots alone, Registry/EffectRoots.jet) are computed
// while the compiler builds (Registry/EffectVocabulary.jet). The
// collection-operation tables of Docs/spec/reference/core-library.md are
// projected from Compiler/JetFoundation/Source/Collections.jet.
// Usage (from the repository root): jet Tools/agent/CoreSourceRows.jet
// [--check]; `--check` refuses a stale view and writes nothing.
use {
    files: core.files
    process: core.process
}

EFFECTS_PATH: "Compiler/Prelude/Effects.jet"
// Core's service effects: each type, in the form of EFFECTS_PATH, has a
// `#FX(…)` line above it naming the machine effects of EFFECTS_PATH that a
// row naming it may use. The Prelude exports them with the machine effects,
// so the canonical effect source is the texts joined. META_EFFECTS_PATH, in
// Core's compiler package, holds the metaprogramming effects in the same form.
CORE_EFFECTS_PATH: "Core/Effects/Effects.jet"
META_EFFECTS_PATH: "Core/Compiler/Meta.jet"
LANG_BLOCK_BEGIN: "// BEGIN GENERATED by Tools/agent/CoreSourceRows.jet from the effect sources; do not edit."
LANG_BLOCK_END: "// END GENERATED"
LANG_PATH: "Core/Compiler/Lang.jet"
FFI_ROOT: "FFI"
// The `#FFI(<lang>)` language menu in Lang.jet and Core.rows.
LANG_FFI_TYPE: "FFILanguage"

#Error
CoreRowsError: struct {
    message: String
}

rows_fail: fn(message: String) -> CoreRowsError Never! {
    CoreRowsError{message: "core-source-rows: {message}"}
}

// One effect name: a root or a family case. `kernel` is empty for a machine
// effect of Effects.jet; for a Core service effect it is the `#FX(…)` list
// above its declaration, the machine effects a row naming it may use.
EffectRow: struct {
    name: String
    irreversible: Bool
    kernel: [String]{[String]{}}
}

GeneratedFile: struct {
    path: String
    text: String
}

// The text of bytes `start..<end` of `text` (indexes from text.bytes()).
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

// The comma-separated names of a list body, trimmed, empty ones dropped.
names: fn(list: String) -> [String] Never! {
    out := [String]{}
    loop name in list.split(",") {
        trimmed: name.trim()
        if trimmed != "" -> out.push(trimmed)
    }
    out
}

OPERATIONS_SOURCE_PATH: "Compiler/JetFoundation/Source/Collections.jet"
OPERATIONS_DOC_PATH: "Docs/spec/reference/core-library.md"
OPERATIONS_BEGIN: "<!-- BEGIN GENERATED COLLECTION OPERATIONS -->"
OPERATIONS_END: "<!-- END GENERATED COLLECTION OPERATIONS -->"
LAW_ROW: Regex{"^(?:CollectionLawFacts)?\{{law: CollectionLaw\.([A-Za-z0-9_]+), timing: \x22([^\x22]*)\x22, result: \x22([^\x22]*)\x22, callbacks: \x22([^\x22]*)\x22, stop: \x22([^\x22]*)\x22, failure: \x22([^\x22]*)\x22, buffering: \x22([^\x22]*)\x22\}},?$"}
OPERATION_ROW: Regex{"^(?:CollectionOperationRow)?\{{receivers: CollectionReceivers\.([A-Za-z0-9_]+), name: \x22([A-Za-z0-9_]+)\x22, minimum_arity: ([0-9]+), maximum_arity: ([0-9]+), access: CollectionAccess\.([A-Za-z0-9_]+), args: \[CollectionArg\]\{{([^}}]*)\}}, result: CollectionResult\.([A-Za-z0-9_]+), op: (.+), law: CollectionLaw\.([A-Za-z0-9_]+), empty: \x22([^\x22]*)\x22, status: CollectionStatus\.([A-Za-z0-9_]+)(?:, stores: true)?\}},?$"}

CollectionLawRow: struct {
    law: String
    cells: [String]
}

CollectionOperation: struct {
    receivers: String
    name: String
    minimum: Int
    args: [String]
    access: String
    law: String
    empty: String
    status: String
}

receiver_text: fn(name: String) -> String Never! {
    if name == {
        "List" -> "`[T]`"
        "Iter" -> "`Iter<T>`"
        "View" -> "`View<T>`"
        "Sequence" -> "`[T]`, `Iter<T>`"
        "Map" -> "`[K:V]`"
        "Set" -> "`Set<T>`"
        "Rank" -> "`Rank<T>`"
        "Bits" -> "`Bits`"
        "Tally" -> "`Tally<T>`"
        "Cache" -> "`Cache<K,V>`"
        "Queue" -> "`Queue<T>`"
        "PriorityQueue" -> "`PriorityQueue<T>`"
        else -> ""
    }
}

access_text: fn(name: String) -> String Never! {
    if name == {
        "Read" -> "borrows"
        "Write" -> "exclusive, in place"
        "Move" -> "consumes"
        "Sequence" -> "borrows a list; consumes an iterator"
        else -> ""
    }
}

arg_text: fn(name: String) -> String Never! {
    if name == {
        "Element" -> "item"
        "Key" -> "key"
        "Value" -> "value"
        "Integer" -> "Int"
        "Text" -> "String"
        "IntegerList" -> "[Int]"
        "Range" -> "Range"
        "DisjointFn" -> "(ViewMut<item>, ViewMut<item>) -> T"
        "RemoveBy" -> "RemoveBy"
        "ElementList" -> "[item]"
        "KeyList" -> "[key]"
        "SameKind" -> "same kind"
        "Entries" -> "map"
        "Seed" -> "seed"
        "ItemFn" -> "(item) -> T"
        "ItemPredicate" -> "(item) -> Bool"
        "PairPredicate" -> "(item, item) -> Bool"
        "Accumulator" -> "(acc, item) -> acc"
        "Comparator" -> "(item) -> key or (a, b) -> Ordering"
        "SortKey" -> "(item) -> key"
        "EntryFn" -> "(key, value) -> T"
        "EntryPredicate" -> "(key, value) -> Bool"
        "EntryAccumulator" -> "(acc, key, value) -> acc"
        "EntryFlatMap" -> "(key, value) -> map"
        "EntryMerge" -> "(key, old, new) -> value"
        else -> ""
    }
}

status_text: fn(name: String) -> String Never! {
    if name == {
        "Current" -> "current"
        "SourceOnly" -> "source-only"
        "Proposed" -> "proposed"
        else -> ""
    }
}

// The row lines between the `// BEGIN <table>` and `// END <table>` markers.
marked_lines: fn(source: String, table: String) -> [String] CoreRowsError! {
    begin: "// BEGIN {table}"
    end: "// END {table}"
    start: source.find(begin)
    finish: if start < 0 -> -1 else -> byte_tail(source, start).find(end)
    if start < 0 || finish < 0 -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: generated section markers are missing or out of order"))
    out := [String]{}
    loop line in byte_slice(source, start, start + finish).split("\n") {
        row: line.trim()
        if row.starts_with("{{") || row.starts_with("Collection") -> out.push(row)
    }
    if out.len() == 0 -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: `{table}` has no rows"))
    Ok(out)
}

// The collection-operation reference tables of core-library.md.
render_operation_tables: fn(source: String) -> String CoreRowsError! {
    laws := [CollectionLawRow]{}
    loop line in marked_lines(source, "COLLECTION LAWS") ?? return Err(err) {
        found: LAW_ROW.match(line) ?? return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unreadable law row: {line}"))
        law: found.group(1) ?? ""
        loop seen in laws {
            if seen.law == law -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: duplicate law {law}"))
        }
        cells: loop group in 2..<8 -> found.group(group) ?? ""
        laws.push(CollectionLawRow{law: law, cells: cells})
    }
    operations := [CollectionOperation]{}
    keys := [String]{}
    loop line in marked_lines(source, "COLLECTION OPERATIONS") ?? return Err(err) {
        found: OPERATION_ROW.match(line) ?? return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unreadable operation row: {line}"))
        receivers: found.group(1) ?? ""
        name: found.group(2) ?? ""
        law: found.group(9) ?? ""
        status: found.group(11) ?? ""
        if status_text(status) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown status {status}"))
        if receiver_text(receivers) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown receivers {receivers}"))
        access: found.group(5) ?? ""
        if access_text(access) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} has unknown access {access}"))
        known := false
        loop seen in laws {
            if seen.law == law -> known = true
        }
        if !known -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {receivers}.{name} names unknown law {law}"))
        families: if receivers == "Sequence" -> [String]{"List", "Iter"} else -> [String]{receivers}
        loop family in families {
            key: "{family}.{name}"
            if keys.contains(key) -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: {key} has more than one operation row"))
            keys.push(key)
        }
        args := [String]{}
        loop arg in names(found.group(6) ?? "") {
            shape: if arg.starts_with("CollectionArg.") -> byte_tail(arg, byte_len("CollectionArg.")) else -> arg.copy()
            if arg_text(shape) == "" -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: unknown argument shape {shape}"))
            args.push(shape)
        }
        minimum: Int.parse(found.group(3) ?? "") ?? 0
        operations.push(CollectionOperation{receivers: receivers, name: name, minimum: minimum, args: args, access: access, law: law, empty: found.group(10) ?? "", status: status})
    }
    loop facts in laws {
        used := false
        loop row in operations {
            if row.law == facts.law -> used = true
        }
        if !used -> return Err(rows_fail("{OPERATIONS_SOURCE_PATH}: law {facts.law} has no operation row"))
    }
    lines := [String]{
        OPERATIONS_BEGIN,
        "<!-- Source: {OPERATIONS_SOURCE_PATH}; regenerate with jet Tools/agent/CoreSourceRows.jet -->",
        "",
        "| Law | Timing | Result | Callbacks | Stop item | Failure channel | Buffering |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    }
    loop facts in laws -> lines.push("| {facts.law} | {facts.cells.join(" | ")} |")
    lines.push("")
    lines.push("| Receiver | Operation | Receiver ownership | Law | Empty result | Status |")
    lines.push("| --- | --- | --- | --- | --- | --- |")
    loop row in operations {
        // Reserved embedded-Core seams are not public operations.
        if row.name.starts_with("__") -> next
        shown: loop (index, arg) in row.args -> if index < row.minimum -> arg_text(arg) else -> "[{arg_text(arg)}]"
        lines.push("| {receiver_text(row.receivers)} | `{row.name}({shown.join(", ")})` | {access_text(row.access)} | {row.law} | {row.empty} | {status_text(row.status)} |")
    }
    lines.push("")
    lines.push(OPERATIONS_END)
    Ok(lines.join("\n"))
}

// core-library.md with its one generated section replaced by `section`.
replace_operation_section: fn(doc: String, section: String) -> String CoreRowsError! {
    if doc.split(OPERATIONS_BEGIN).to_list().len() != 2 || doc.split(OPERATIONS_END).to_list().len() != 2 -> return Err(rows_fail("{OPERATIONS_DOC_PATH}: expected exactly one generated section ({OPERATIONS_BEGIN}, {OPERATIONS_END})"))
    start: doc.find(OPERATIONS_BEGIN)
    finish: doc.find(OPERATIONS_END)
    if finish < start -> return Err(rows_fail("{OPERATIONS_DOC_PATH}: generated section markers are out of order"))
    Ok("{byte_slice(doc, 0, start)}{section}{byte_tail(doc, finish + byte_len(OPERATIONS_END))}")
}

// One row per effect name the types of `source` declare, in source order:
// a type's own name, then each case of an enum family. The text is read in
// its constrained form: `Name: struct {` or `Name: enum {`, case lines, and an
// `impl Effect {}` block or one holding the one-line
// `irreversible: fn(self) -> Bool { … }` whose body is `true`, `false`,
// `self == .Case` or an `||` of those. A family is irreversible when any of
// its cases is. With `machine` (the rows of EFFECTS_PATH), `source` is
// CORE_EFFECTS_PATH or META_EFFECTS_PATH: each type has a `#FX(…)` line right
// above it, its entries machine effects, which become the `kernel` of its
// rows; a bare `#FX` lists none, so a row naming the type admits no machine
// effect.
effect_rows: fn(source: String, path: String, machine: [EffectRow]?) -> [EffectRow] CoreRowsError! {
    rows := [EffectRow]{}
    lines: source.split("\n").to_list()
    type_name := ""
    family := false
    cases := [String]{}
    body := String?{None}
    impl_seen := false
    in_impl := false
    kernel := [String]{}
    listed := false
    loop index in 0..<lines.len() {
        raw: lines[index]
        comment: raw.find("//")
        line: (if comment < 0 -> raw else -> byte_slice(raw, 0, comment)).trim()
        if line == "" -> next
        fields: line.words()
        place: "{path}:{index + 1}"
        if type_name == "" {
            if machine == .Val(known) {
                if line == "#FX" && !listed {
                    kernel = [String]{}
                    listed = true
                    next
                }
                if line.starts_with("#FX(") && line.ends_with(")") && !listed {
                    kernel = effect_kernel_list(line, known, place) ?? return Err(err)
                    listed = true
                    next
                }
                if !listed -> return Err(rows_fail("{place}: expected the `#FX` or `#FX(…)` line above a Core effect"))
            }
            if fields.len() != 3 || !fields[0].ends_with(":") || (fields[1] != "struct" && fields[1] != "enum") || fields[2] != "{{" -> return Err(rows_fail("{place}: expected `Name: struct {{` or `Name: enum {{`"))
            name: byte_slice(fields[0], 0, fields[0].len() - 1)
            loop seen in rows {
                if seen.name == name -> return Err(rows_fail("{place}: duplicate effect {name}"))
            }
            if machine == .Val(known) {
                loop seen in known {
                    if seen.name == name -> return Err(rows_fail("{place}: `{name}` is already a machine effect of {EFFECTS_PATH}"))
                }
            }
            type_name = name
            family = fields[1] == "enum"
            cases = [String]{}
            body = None
            impl_seen = false
            next
        }
        if in_impl {
            if line == "}}" {
                in_impl = false
                next
            }
            if body != None || !line.starts_with("irreversible: fn(self) -> Bool {{ ") || !line.ends_with(" }}") -> return Err(rows_fail("{place}: expected one `irreversible: fn(self) -> Bool {{ … }}` line in `impl Effect`"))
            body = Val(byte_slice(line, "irreversible: fn(self) -> Bool {{ ".len(), line.len() - 2).trim())
            next
        }
        if line == "impl Effect {{}}" || line == "impl Effect {{" {
            if impl_seen -> return Err(rows_fail("{place}: `{type_name}` has a second `impl Effect` block"))
            impl_seen = true
            in_impl = line == "impl Effect {{"
            next
        }
        if line == "}}" {
            if !impl_seen -> return Err(rows_fail("{place}: `{type_name}` has no `impl Effect` block"))
            if family && cases.len() == 0 -> return Err(rows_fail("{place}: the effect family `{type_name}` has no cases"))
            case_rows := [EffectRow]{}
            any := false
            loop member in cases {
                irreversible: effect_fact(body, cases, Val(member)) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true`, `false`, `self == .Case` or an `||` of those"))
                if irreversible -> any = true
                case_rows.push(EffectRow{name: "{type_name}.{member}", irreversible: irreversible})
            }
            root := any
            if !family {
                root = effect_fact(body, cases, None) ?? return Err(rows_fail("{place}: `{type_name}`'s `irreversible` body is not `true` or `false`"))
            }
            rows.push(EffectRow{name: type_name, irreversible: root, kernel: kernel.copy()})
            loop row in case_rows {
                rows.push(EffectRow{name: row.name, irreversible: row.irreversible, kernel: kernel.copy()})
            }
            type_name = ""
            kernel = [String]{}
            listed = false
            next
        }
        if !family || fields.len() != 1 || impl_seen -> return Err(rows_fail("{place}: expected an effect family case name, `impl Effect` or `}}`"))
        if cases.contains(line) -> return Err(rows_fail("{place}: duplicate effect {type_name}.{line}"))
        cases.push(line)
    }
    if type_name != "" -> return Err(rows_fail("{path}: `{type_name}` is not closed"))
    if rows.len() == 0 -> return Err(rows_fail("{path} declares no effects"))
    Ok(rows)
}

// The machine effects of a `#FX(…)` line above a Core effect: each entry a
// root or leaf of `machine`, listed once, none denied.
effect_kernel_list: fn(line: String, machine: [EffectRow], place: String) -> [String] CoreRowsError! {
    kernel := [String]{}
    loop part in byte_slice(line, "#FX(".len(), line.len() - 1).split(",") {
        entry: part.trim()
        known: loop row in machine {
            if row.name == entry -> break true
        } ?? false
        if !known -> return Err(rows_fail("{place}: `{entry}` is no machine effect of {EFFECTS_PATH}"))
        if kernel.contains(entry) -> return Err(rows_fail("{place}: `{entry}` is listed twice"))
        kernel.push(entry)
    }
    if kernel.len() == 0 -> return Err(rows_fail("{place}: the `#FX(…)` line lists no machine effect"))
    Ok(kernel)
}

// An `irreversible` body's value for one case (None for a struct), or None
// when the body is not the effect fact form. No body is `false`.
effect_fact: fn(body: String?, cases: [String], member: String?) -> Bool? Never! {
    written: body ?? return Val(false)
    holds := false
    loop part in written.split("||") {
        term: part.trim()
        if {
            term == "true" -> holds = true
            term == "false" -> {}
            term.starts_with("self == .") -> {
                named: byte_slice(term, "self == .".len(), term.len())
                if member == None || !cases.contains(named) -> return None
                if member == .Val(case_name) && case_name == named -> holds = true
            }
            else -> return None
        }
    }
    Val(holds)
}

// The effect names that are leaves (`Root.Member`) or, with `leaf` false, roots.
effect_names: fn(rows: [EffectRow], leaf: Bool) -> [String] Never! {
    out := [String]{}
    loop row in rows {
        if row.name.contains(".") == leaf -> out.push(row.name)
    }
    out
}

// Lang.jet's generated block: the `Effect` enum of `roots` and the
// `FFILanguage` enum of `languages`, from LANG_BLOCK_BEGIN through
// LANG_BLOCK_END.
render_lang_block: fn(roots: [String], languages: [String]) -> String Never! {
    lines := [String]{
        LANG_BLOCK_BEGIN,
        "/// Effect roots that may appear in an `effect_name` row: the machine roots",
        "/// of {EFFECTS_PATH}, then Core's service effects of",
        "/// {CORE_EFFECTS_PATH}, then the metaprogramming effects of",
        "/// {META_EFFECTS_PATH}.",
        "Effect: enum {{",
    }
    loop name in roots -> lines.push("    {name}")
    lines.push("}}")
    lines.push("")
    lines.push("/// Foreign language named by `#FFI(<lang>)`: the languages of the `{FFI_ROOT}`")
    lines.push("/// effect in {EFFECTS_PATH}; an inline body needs a language with an")
    lines.push("/// inline binder.")
    lines.push("{LANG_FFI_TYPE}: enum {{")
    loop name in languages -> lines.push("    {name}")
    lines.push("}}")
    lines.push(LANG_BLOCK_END)
    lines.join("\n")
}

// `text` (the file at `path`) with its generated block, LANG_BLOCK_BEGIN
// through LANG_BLOCK_END, replaced whole by `block`, so any byte edited
// inside it is rewritten and `--check` reports the drift.
generated_block_text: fn(text: String, path: String, block: String) -> String CoreRowsError! {
    start: text.find(LANG_BLOCK_BEGIN)
    if start < 0 -> return Err(rows_fail("{path} has no `{LANG_BLOCK_BEGIN}` line"))
    rest: byte_tail(text, start)
    end: rest.find(LANG_BLOCK_END)
    if end < 0 -> return Err(rows_fail("{path}: the generated block has no `{LANG_BLOCK_END}` line"))
    Ok("{byte_slice(text, 0, start)}{block}{byte_tail(rest, end + byte_len(LANG_BLOCK_END))}")
}

// The foreign languages: the cases of the `FFI` effect family, in source order.
ffi_languages: fn(rows: [EffectRow]) -> [String] Never! {
    prefix: "{FFI_ROOT}."
    out := [String]{}
    loop row in rows {
        if row.name.starts_with(prefix) -> out.push(byte_tail(row.name, byte_len(prefix)))
    }
    out
}

read_source: fn(path: String) -[FS]> String CoreRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

// Every view, rendered from the sources as they are on disk.
read_core_source_views: fn() -[FS]> CoreSourceViews CoreRowsError! {
    effects: read_source(EFFECTS_PATH) ?? return Err(err)
    core_effects: read_source(CORE_EFFECTS_PATH) ?? return Err(err)
    meta_effects: read_source(META_EFFECTS_PATH) ?? return Err(err)
    lang: read_source(LANG_PATH) ?? return Err(err)
    machine: effect_rows(effects, EFFECTS_PATH, None) ?? return Err(err)
    declared := machine.copy()
    loop row in effect_rows(core_effects, CORE_EFFECTS_PATH, Val(machine)) ?? return Err(err) -> declared.push(row)
    loop row in effect_rows(meta_effects, META_EFFECTS_PATH, Val(machine)) ?? return Err(err) {
        loop seen in declared {
            if seen.name == row.name -> return Err(rows_fail("{META_EFFECTS_PATH}: duplicate effect {row.name}"))
        }
        declared.push(row)
    }
    languages: ffi_languages(declared)
    if languages.len() == 0 -> return Err(rows_fail("{EFFECTS_PATH} declares no `{FFI_ROOT}` languages"))
    lang_text: generated_block_text(lang, LANG_PATH, render_lang_block(effect_names(declared, false), languages)) ?? return Err(err)
    operations_doc: replace_operation_section(read_source(OPERATIONS_DOC_PATH) ?? return Err(err), render_operation_tables(read_source(OPERATIONS_SOURCE_PATH) ?? return Err(err)) ?? return Err(err)) ?? return Err(err)
    outputs: [GeneratedFile]{
        GeneratedFile{path: LANG_PATH, text: lang_text},
        GeneratedFile{path: OPERATIONS_DOC_PATH, text: operations_doc},
    }
    Ok(CoreSourceViews{files: outputs, effects: declared.len()})
}

CoreSourceViews: struct {
    files: [GeneratedFile]
    effects: Int
}

// The file's text, or "" when it does not exist.
current_text: fn(path: String) -[FS]> String CoreRowsError! {
    if !files.exists(path) -> return Ok("")
    read_source(path)
}

// No flag writes every view; `--check` refuses a stale one.
core_source_rows_main: fn(args: [String]) -[FS]> String CoreRowsError! {
    mode: if args.len() == 1 -> args[0] else -> ""
    if args.len() > 1 || (args.len() == 1 && mode != "--check") -> return Err(rows_fail("usage: jet Tools/agent/CoreSourceRows.jet [--check]"))
    views: read_core_source_views() ?? return Err(err)
    summary: "{views.effects} effects"
    if mode == "--check" {
        loop output in views.files {
            if (current_text(output.path) ?? return Err(err)) != output.text -> return Err(rows_fail("{output.path} is stale; run jet Tools/agent/CoreSourceRows.jet"))
        }
        return Ok("core source rows are current ({summary})")
    }
    loop output in views.files {
        files.write(output.path, output.text) ?? return Err(rows_fail("cannot write {output.path}: {err}"))
    }
    written: loop output in views.files -> output.path
    Ok("generated {written.join(", ")} ({summary})")
}

run: fn() { print(core_source_rows_main(process.args()) ?? process.fail(1, err.message)) }

// The error text effect_rows reports for `source`, or "" when it accepts it.
effect_rows_error: fn(source: String, machine: [EffectRow]?) -> String Never! {
    if effect_rows(source, "Effects.jet", machine) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the effect-root views are current and the effect grammar refuses malformed lines") {
    views: read_core_source_views() ?? panic("the Core source views did not render: {err.message}")
    loop output in views.files {
        assert_eq(files.read(output.path) ?? panic("{output.path} did not read"), output.text)
    }
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ true }}\n    }}\n}}\nFS: enum {{\n    Read\n    Write\n\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\n", None) == "")
    rows: effect_rows("FS: enum {{\n    Read\n    Write\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Write }}\n    }}\n}}\nIO: struct {{\n    impl Effect {{}}\n}}\n", "Effects.jet", None) ?? panic("the family was refused: {err.message}")
    assert_eq(rows.len(), 4)
    assert(rows[0].name == "FS" && rows[0].irreversible)
    assert(rows[1].name == "FS.Read" && !rows[1].irreversible)
    assert(rows[2].name == "FS.Write" && rows[2].irreversible)
    assert(rows[3].name == "IO" && !rows[3].irreversible && rows[3].kernel.len() == 0)
    assert(effect_rows_error("FS: enum {{\n    Read\n    impl Effect {{\n        irreversible: fn(self) -> Bool {{ self == .Gone }}\n    }}\n}}\n", None).contains("is not `true`, `false`"))
    assert(effect_rows_error("Net: struct {{\n    impl Effect {{}}\n}}\nNet: struct {{\n    impl Effect {{}}\n}}\n", None).contains("duplicate effect Net"))
    assert(effect_rows_error("Net: effect\n", None).contains("expected `Name: struct {{`"))
    assert(effect_rows_error("Net: struct {{\n}}\n", None).contains("has no `impl Effect` block"))
    assert(effect_rows_error("// only a comment\n", None).contains("declares no effects"))
    assert(effect_rows_error("#FX(Net)\nNet: struct {{\n    impl Effect {{}}\n}}\n", None).contains("expected `Name: struct {{`"))
    service: effect_rows("#FX(IO, FS.Write)\nDB: enum {{\n    Read\n    Write\n    impl Effect {{}}\n}}\n", "Effects.jet", Val(rows)) ?? panic("the service effect was refused: {err.message}")
    assert_eq(service.len(), 3)
    assert(service[0].name == "DB" && service[0].kernel == [String]{"IO", "FS.Write"})
    assert(service[2].name == "DB.Write" && service[2].kernel == [String]{"IO", "FS.Write"})
    assert(effect_rows_error("DB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("expected the `#FX` or `#FX(…)` line"))
    assert(effect_rows_error("#FX(Exec)\nDB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`Exec` is no machine effect"))
    assert(effect_rows_error("#FX(IO, IO)\nDB: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`IO` is listed twice"))
    assert(effect_rows_error("#FX(IO)\nFS: struct {{\n    impl Effect {{}}\n}}\n", Val(rows)).contains("`FS` is already a machine effect"))
    roots: [String]{"Net", "Rand"}
    block: render_lang_block(roots, [String]{"C"})
    fresh: "A: enum {{\n    X\n}}\n\n{block}\n\nB: enum {{\n    Y\n}}\n"
    assert_eq(generated_block_text(fresh, "Lang.jet", block) ?? panic("the Lang block was refused: {err.message}"), fresh)
    // A hand-edited byte inside the block is rewritten, so `--check` fails on it.
    edited: fresh.replace("    Rand\n", "    Rend\n")
    assert(edited != fresh)
    assert_eq(generated_block_text(edited, "Lang.jet", block) ?? panic("the edited Lang block was refused: {err.message}"), fresh)
    assert(generated_block_text("Effect: enum {{\n    Net\n}}\n", "Lang.jet", block) == .Err(_))
    assert(generated_block_text("{LANG_BLOCK_BEGIN}\nEffect: enum {{\n", "Lang.jet", block) == .Err(_))
    ffi: effect_rows("Net: struct {{\n    impl Effect {{}}\n}}\nFFI: enum {{\n    C\n    Rust\n\n    impl Effect {{}}\n}}\n", "Effects.jet", None) ?? panic("the FFI family was refused: {err.message}")
    assert_eq(ffi_languages(ffi), [String]{"C", "Rust"})
}

#Test("the collection-operation tables refuse an unknown law and a law with no operation") {
    law: "    {{law: CollectionLaw.Visit, timing: \"eager\", result: \"r\", callbacks: \"c\", stop: \"s\", failure: \"f\", buffering: \"b\"}},"
    operation: "    {{receivers: CollectionReceivers.List, name: \"map\", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{{CollectionArg.ItemFn}}, result: CollectionResult.Mapped, op: CollectionOp.SeqMap, law: CollectionLaw.Visit, empty: \"empty list\", status: CollectionStatus.Current}},"
    tables: render_operation_tables("// BEGIN COLLECTION LAWS\nLAWS: {{\n{law}\n}}\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\nOPS: {{\n{operation}\n}}\n// END COLLECTION OPERATIONS\n") ?? panic("the operation tables were refused: {err.message}")
    assert(tables.contains("| Visit | eager | r | c | s | f | b |\n") && tables.contains("| `[T]` | `map(fn(item) {{ T }})` | borrows | Visit | empty list | current |\n"))
    assert(render_operation_tables("// BEGIN COLLECTION LAWS\n{law}\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\n{operation.replace("Visit", "Gone")}\n// END COLLECTION OPERATIONS\n") == .Err(_))
    assert(render_operation_tables("// BEGIN COLLECTION LAWS\n// END COLLECTION LAWS\n// BEGIN COLLECTION OPERATIONS\n{operation}\n// END COLLECTION OPERATIONS\n") == .Err(_))
}
