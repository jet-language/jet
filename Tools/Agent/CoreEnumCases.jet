#!/usr/bin/env jet
// Write the case lists of the Core enum leaves in Compiler/Prelude/Core.rows
// from the enums the Core sources declare. A `module` line lists each type
// its module exports (`types { … }`); an enum leaf is `Name:plain(A|B(T))`,
// its cases in declaration order. The compiler reads those lists
// (Registry/CoreEnumRows.jet CORE_ENUM_CASE_ROWS, and the payload rows of
// Registry/CoreEnumPayloadRows.jet CORE_ENUM_PAYLOAD_ROWS) for the cases of a
// Core enum whose module a program has not loaded, so no program loads a Core
// module for them. When a source of the line's module (its `source_module`
// rows and the parts Compiler/Prelude/CoreSourceParts.tsv attaches to it)
// declares `Name: enum { … }`, this tool writes the list from that
// declaration. The cases are the upper-case names at the body's top level
// before its first method, read the way the compiler build reads them
// (Compiler/JetFoundation/Source/CoreDeclarations/Sources.jet). A case carries
// its payload, `B(T)`, when every payload the enum declares is one unlabeled
// slot whose type is a name, a list or an option of them (the Core.rows
// grammar core_decl_payload_text reads); otherwise the list names the cases
// alone. A list whose enum no Core source declares is the compiler-owned
// residue (Registry/CoreEnumPayloadRows.jet) and is left as it is written.
// It also writes Compiler/JetBackend/Source/CoreEnumABI.jet: for each enum of
// ORDINAL_ENUMS, one constant per case, `<prefix>_<CASE>`, its ordinal in the
// declaration (the tag the runtime reads and writes for it).
// Usage (from the repository root): jet Tools/Agent/CoreEnumCases.jet
// [--check|--write]; --check fails when a list or CoreEnumABI.jet differs
// from its declaration, and --write rewrites them.
use {
    files: core.files
    process: core.process
}

ROWS_PATH: "Compiler/Prelude/Core.rows"

PARTS_PATH: "Compiler/Prelude/CoreSourceParts.tsv"

TYPES_OPEN: " types {{ "

LIST_OPEN: ":plain("

ORDINALS_PATH: "Compiler/JetBackend/Source/CoreEnumABI.jet"

ORDINALS_HEADER: "// Generated by Tools/Agent/CoreEnumCases.jet from the Core declarations;\n// do not edit. It stays committed: the seed builds the compiler from the\n// checkout, and `jet check` reads it before any build step runs. Each\n// constant is a case's ordinal in its enum's declaration, the tag the runtime\n// reads and writes for that case."

// An enum whose case tags the runtime names: the enum and its constants'
// prefix.
OrdinalEnum: struct {
    core: String,
    prefix: String,
}

// The enums CoreEnumABI.jet numbers from their declarations.
ORDINAL_ENUMS: #run { [OrdinalEnum]{
    {core: "NetDNSError", prefix: "NET_DNS"},
    {core: "PluginError", prefix: "PLUGIN_ERROR"},
    {core: "ProcessResourceLimit", prefix: "PROCESS_RESOURCE"},
    {core: "ServiceDelivery", prefix: "SERVICE_DELIVERY"},
    {core: "ServiceError", prefix: "SERVICE_ERROR"},
    {core: "ServiceRestart", prefix: "SERVICE_RESTART"},
    {core: "TaskFailure", prefix: "TASK_FAILURE"},
    {core: "TaskStatus", prefix: "TASK_STATUS"},
    {core: "UIAccessibilityState", prefix: "UI_STATE"},
} }

#Error
CoreEnumCasesError: struct {
    message: String,
}

cases_fail: fn(message: String) -> CoreEnumCasesError Never! {
    CoreEnumCasesError{message: "core enum cases: {message}"}
}

// One enum leaf whose written list differs from its declaration.
StaleList: struct {
    module_name: String,
    name: String,
    written: String,
    declared: String,
    path: String,
}

// The rewritten Core.rows text and the lists it changed.
CaseLists: struct {
    text: String,
    stale: [StaleList],
    written: Int,
    residue: Int,
}

space_byte: fn(code: Int) -> Bool Never! {
    code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

upper_byte: fn(code: Int) -> Bool Never! { code >= 65 && code <= 90 }

lower_byte: fn(code: Int) -> Bool Never! { code >= 97 && code <= 122 }

word_byte: fn(code: Int) -> Bool Never! {
    lower_byte(code) || upper_byte(code) || (code >= 48 && code <= 57) || code == 95
}

byte_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

code_at: fn(bytes: [U8], at: Int) -> Int Never! { Int{bytes[at]} }

skip_space: fn(bytes: [U8], start: Int) -> Int Never! {
    at := start
    loop at < bytes.len() && space_byte(code_at(bytes, at)) -> at += 1
    at
}

// Each Core module's source paths: its `source_module` rows in Core.rows
// (`source_module <module> path <path> …`), then each part CoreSourceParts.tsv
// attaches to it (columns: module, owner, path, …).
module_sources: fn(rows: String, parts: String) -> [String:[String]] Never! {
    sources := [String:[String]]{}
    loop line in rows.lines() {
        if !line.starts_with("source_module ") -> next
        words: line.split(" ").to_list()
        if words.len() < 4 || words[2] != "path" -> next
        if !sources.has_key(words[1]) -> sources[words[1]] = [String]{}
        sources[words[1]].push(words[3])
    }
    loop line in parts.lines() {
        if line == "" || line.starts_with("#") -> next
        columns: line.split("\t").to_list()
        if columns.len() < 3 -> next
        if !sources.has_key(columns[1]) -> sources[columns[1]] = [String]{}
        sources[columns[1]].push(columns[2])
    }
    sources
}

// Whether `name:` at byte `at` starts a declaration: only spaces, tabs and an
// optional `pub` stand before it on its line.
declaration_start: fn(bytes: [U8], at: Int) -> Bool Never! {
    back := at
    loop back > 0 && (code_at(bytes, back - 1) == 32 || code_at(bytes, back - 1) == 9) -> back -= 1
    if back == 0 || code_at(bytes, back - 1) == 10 -> return true
    if back == at || back < 3 || byte_text(bytes, back - 3, back) != "pub" -> return false
    start := back - 3
    loop start > 0 && (code_at(bytes, start - 1) == 32 || code_at(bytes, start - 1) == 9) {
        start -= 1
    }
    start == 0 || code_at(bytes, start - 1) == 10
}

// The list entries of the enum `name` that `text` declares (`name: enum { … }`
// at a line start), or None when it declares no such enum.
declared_cases: fn(text: String, name: String) -> [String]? {
    bytes: text.bytes()
    needle: "{name}:"
    start := 0
    loop {
        found: byte_text(bytes, start, bytes.len()).find(needle)
        if found < 0 -> return None
        at: start + found
        start = at + 1
        if !declaration_start(bytes, at) -> next
        keyword: skip_space(bytes, at + needle.bytes().len())
        if keyword + 4 > bytes.len() || byte_text(bytes, keyword, keyword + 4) != "enum" -> next
        brace: skip_space(bytes, keyword + 4)
        if brace >= bytes.len() || code_at(bytes, brace) != 123 -> next
        return Val(body_cases(bytes, brace + 1))
    }
}

// The list entries of the enum body that opens at byte `open`: the
// upper-case names at its top level, comments dropped, until its first `fn`
// or `impl`, each with its payload when the list can carry every payload.
body_cases: fn(bytes: [U8], open: Int) -> [String] Never! {
    end := open
    depth := 1
    loop depth > 0 && end < bytes.len() {
        code: code_at(bytes, end)
        if code == 123 -> depth += 1
        if code == 125 -> depth -= 1
        end += 1
    }
    body_end: end - 1
    cases := [String]{}
    payloads := [String]{}
    carried := true
    nesting := 0
    index := open
    loop index < body_end {
        code: code_at(bytes, index)
        if code == 47 && index + 1 < body_end && code_at(bytes, index + 1) == 47 {
            loop index < body_end && code_at(bytes, index) != 10 -> index += 1
            next
        }
        if code == 40 || code == 91 || code == 123 {
            nesting += 1
            index += 1
            next
        }
        if code == 41 || code == 93 || code == 125 {
            nesting -= 1
            index += 1
            next
        }
        if nesting != 0 || !(lower_byte(code) || upper_byte(code) || code == 95) {
            index += 1
            next
        }
        word_end := index + 1
        loop word_end < body_end && word_byte(code_at(bytes, word_end)) -> word_end += 1
        word: byte_text(bytes, index, word_end)
        if word == "fn" || word == "impl" -> break
        if upper_byte(code) {
            after: skip_space(bytes, word_end)
            opener: if after < body_end -> code_at(bytes, after) else -> 0
            payload: if opener == 40 -> payload_slot(bytes, after, body_end) else -> ""
            if opener == 123 || (opener == 40 && !carried_payload(payload)) -> carried = false
            cases.push(word)
            payloads.push(payload)
        }
        index = word_end
    }
    if !carried -> return cases
    loop (at, case_name) in cases -> if payloads[at] == "" -> case_name else -> "{case_name}({payloads[at]})"
}

// The text inside the parentheses that open at byte `open`, white space
// dropped.
payload_slot: fn(bytes: [U8], open: Int, body_end: Int) -> String Never! {
    depth := 0
    close := open
    loop close < body_end {
        code: code_at(bytes, close)
        if code == 40 || code == 91 || code == 123 -> depth += 1
        if code == 41 || code == 93 || code == 125 -> depth -= 1
        if depth == 0 -> break
        close += 1
    }
    kept := [U8]{}
    loop byte in bytes.slice(open + 1, close) {
        if !space_byte(Int{byte}) -> kept.push(byte)
    }
    String.from_bytes(kept) ?? ""
}

// Whether a Core.rows list can carry `payload`: one unlabeled slot whose type
// is a name, a list or an option of them (`String`, `[U8]`, `Int?`).
carried_payload: fn(payload: String) -> Bool Never! {
    if payload == "" -> return false
    loop byte in payload.bytes() {
        code: Int{byte}
        if !(word_byte(code) || code == 91 || code == 93 || code == 63) -> return false
    }
    true
}

// The cases the sources of `module_name` declare for `name`, and the path of
// the source that declares them; None when no source of the module does.
module_cases: fn(texts: [String:String], sources: [String:[String]], module_name: String, name: String) -> {cases: [String], path: String}? {
    paths: sources.get(module_name) ?? [String]{}
    loop path in paths {
        text: texts.get(path) ?? next
        cases: declared_cases(text, name) ?? next
        return Val({cases: cases, path: path})
    }
    None
}

// One `module` line with each enum leaf's list written from its declaration.
module_line: fn(line: String, texts: [String:String], sources: [String:[String]], lists: ^CaseLists) -> String CoreEnumCasesError! {
    words: line.split(" ").to_list()
    module_name: if words.len() > 1 -> words[1] else -> ""
    opened: line.partition(TYPES_OPEN)
    if opened.sep == "" -> return Ok(line)
    closed: opened.tail.partition(" }}")
    if closed.sep == "" {
        return Err(cases_fail("{ROWS_PATH}: the types of module {module_name} are not closed with ` }}`"))
    }
    entries := [String]{}
    loop entry in closed.head.split(", ").to_list() {
        listed: entry.partition(LIST_OPEN)
        if listed.sep == "" || !listed.tail.ends_with(")") {
            entries.push(entry)
            next
        }
        name: listed.head
        written: listed.tail.removesuffix(")")
        found: module_cases(texts, sources, module_name, name) ?? {
            lists.residue += 1
            entries.push(entry)
            next
        }
        if found.cases.len() == 0 {
            return Err(cases_fail("{found.path} declares the enum {name} of {module_name} with no cases"))
        }
        declared: found.cases.join("|")
        lists.written += 1
        if declared != written {
            lists.stale.push(StaleList{module_name: module_name.copy(), name: name, written: written, declared: declared, path: found.path})
        }
        entries.push("{name}{LIST_OPEN}{declared})")
    }
    Ok("{opened.head}{TYPES_OPEN}{entries.join(", ")} }}{closed.tail}")
}

// Core.rows (`rows`) with every list a Core source declares written from it.
case_lists: fn(rows: String, texts: [String:String], sources: [String:[String]]) -> CaseLists CoreEnumCasesError! {
    lists := CaseLists{text: "", stale: [StaleList]{}, written: 0, residue: 0}
    out := [String]{}
    loop line in rows.split("\n") {
        if !line.starts_with("module ") {
            out.push(line)
            next
        }
        out.push(module_line(line, texts, sources, lists) ?? return Err(err))
    }
    lists.text = out.join("\n")
    Ok(lists)
}

// `name` in upper snake case, a word starting at each upper-case letter after
// a lower-case one or a digit, and at the last capital of an acronym
// (`CPUTime` is CPU_TIME, `InvalidURL` INVALID_URL).
upper_snake: fn(name: String) -> String Never! {
    bytes: name.bytes()
    out := [U8]{}
    loop (at, byte) in bytes {
        code: Int{byte}
        if at > 0 && upper_byte(code) {
            before: code_at(bytes, at - 1)
            acronym_end: upper_byte(before) && at + 1 < bytes.len() && lower_byte(code_at(bytes, at + 1))
            if lower_byte(before) || (before >= 48 && before <= 57) || acronym_end {
                out.push(U8{95})
            }
        }
        out.push(byte)
    }
    (String.from_bytes(out) ?? "").to_upper()
}

// CoreEnumABI.jet as the declarations of `enums` (ORDINAL_ENUMS) number their
// cases, and each listed enum they cannot number, with why.
ordinal_text: fn(enums: [OrdinalEnum], texts: [String:String]) -> {text: String, problems: [String]} Never! {
    blocks := [String]{ORDINALS_HEADER}
    problems := [String]{}
    loop listed in enums {
        declared := [{cases: [String], path: String}]{}
        loop path in texts.keys().to_list() {
            cases: declared_cases(texts.get(path) ?? "", listed.core) ?? next
            declared.push({cases: cases, path: path})
        }
        if declared.len() != 1 || declared[0].cases.len() == 0 {
            problems.push("{listed.core}: {declared.len()} Core sources declare it with cases, not one")
            next
        }
        constants: loop (ordinal, entry) in declared[0].cases -> "{listed.prefix}_{upper_snake(entry.partition("(").head)}: I64{{{ordinal}}}"
        blocks.push("// {listed.core} ({declared[0].path})\n{constants.join("\n\n")}")
    }
    {text: "{blocks.join("\n\n")}\n", problems: problems}
}

core_enum_cases_main: fn(args: [String]) -[FS]> String CoreEnumCasesError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") {
        return Err(cases_fail("usage: jet Tools/Agent/CoreEnumCases.jet [--check|--write]"))
    }
    rows: files.read(ROWS_PATH) ?? return Err(cases_fail("cannot read {ROWS_PATH}: {err}"))
    parts: files.read(PARTS_PATH) ?? return Err(cases_fail("cannot read {PARTS_PATH}: {err}"))
    sources: module_sources(rows, parts)
    texts := [String:String]{}
    loop module_name in sources.keys().to_list() {
        paths: sources.get(module_name) ?? [String]{}
        loop path in paths {
            if texts.get(path) != None -> next
            texts[path] = files.read(path) ?? return Err(cases_fail("cannot read {path}, a source of {module_name}: {err}"))
        }
    }
    lists: case_lists(rows, texts, sources) ?? return Err(err)
    ordinals: ordinal_text(ORDINAL_ENUMS, texts)
    if ordinals.problems.len() > 0 {
        return Err(cases_fail("{ORDINALS_PATH}: ORDINAL_ENUMS lists enums no declaration numbers:\n{ordinals.problems.join("\n")}"))
    }
    ordinals_stale: (files.read(ORDINALS_PATH) ?? "") != ordinals.text
    if (lists.stale.len() > 0 || ordinals_stale) && mode == "--check" {
        problems := loop stale in lists.stale -> "{ROWS_PATH}: {stale.module_name} lists {stale.name}:plain({stale.written}) but {stale.path} declares {stale.declared}"
        if ordinals_stale {
            problems.push("{ORDINALS_PATH}: an enum's ordinals differ from its declaration")
        }
        return Err(cases_fail("{problems.join("\n")}\nrun jet Tools/Agent/CoreEnumCases.jet --write"))
    }
    if lists.stale.len() > 0 {
        files.write(ROWS_PATH, lists.text) ?? return Err(cases_fail("cannot write {ROWS_PATH}: {err}"))
    }
    if ordinals_stale {
        files.write(ORDINALS_PATH, ordinals.text) ?? return Err(cases_fail("cannot write {ORDINALS_PATH}: {err}"))
    }
    if lists.stale.len() > 0 || ordinals_stale {
        return Ok("core enum cases written ({lists.stale.len()} of {lists.written} lists changed, {lists.residue} compiler-owned, enum ordinals {if ordinals_stale -> "rewritten" else -> "unchanged"})")
    }
    Ok("core enum cases check passed ({lists.written} lists from the Core sources, {lists.residue} compiler-owned, {ORDINAL_ENUMS.len()} enum ordinal sets)")
}

run: fn() { print(core_enum_cases_main(process.args()) ?? process.fail(1, err.message)) }

#Test("an enum's cases are its top-level upper-case names before its first method") {
    text: "// Mode: enum {{ Wrong }}\npub Mode: enum {{\n    Fast, // the default\n    Slow(after: Int),\n    Named {{ inner: Kind }},\n\n    impl Show {{ Hidden }}\n}}\nOther: struct {{}}\n"
    assert_eq((declared_cases(text, "Mode") ?? [String]{}).join("|"), "Fast|Slow|Named")
    assert(declared_cases(text, "Other") == None)
    assert(declared_cases(text, "Absent") == None)
}

#Test("a list carries the payloads only when it can carry every payload of the enum") {
    text: "Event: enum {{\n    Null,\n    Bytes( [U8] ),\n    Text(String),\n    Last(Int?), // the final one\n}}\nMixed: enum {{\n    Plain(String),\n    Labeled(limit: Int),\n}}\nPair: enum {{\n    Two(Int, Int),\n}}\n"
    assert_eq((declared_cases(text, "Event") ?? [String]{}).join("|"), "Null|Bytes([U8])|Text(String)|Last(Int?)")
    assert_eq((declared_cases(text, "Mixed") ?? [String]{}).join("|"), "Plain|Labeled")
    assert_eq((declared_cases(text, "Pair") ?? [String]{}).join("|"), "Two")
}

#Test("a module line's lists follow the declarations of the module's sources") {
    sources: module_sources("source_module core.demo path Core/Demo/Demo.jet alias demo owns {{ }}\n", "# module\towner\tpath\n__core_demo_part\tcore.demo\tCore/Demo/Part.jet\t__core_demo_part\t\t\n")
    texts := [String:String]{}
    texts["Core/Demo/Demo.jet"] = "Mode: enum {{\n    Fast,\n    Slow,\n}}\n"
    texts["Core/Demo/Part.jet"] = "Kind: enum {{\n    One,\n}}\n"
    rows: "// head\nmodule core.demo exports {{ Mode, Kind, Gone }} types {{ Mode:plain(Fast), Kind:plain(One), Gone:plain(A|B), Box:plain }} depends_on []\n"
    lists: case_lists(rows, texts, sources) ?? panic(err.message)
    assert(lists.text.contains("types {{ Mode:plain(Fast|Slow), Kind:plain(One), Gone:plain(A|B), Box:plain }} depends_on []"))
    assert_eq(lists.stale.len(), 1)
    assert_eq(lists.stale[0].name, "Mode")
    assert_eq(lists.written, 2)
    assert_eq(lists.residue, 1)
}

#Test("an enum's ordinals are its cases' places in its declaration") {
    assert_eq(upper_snake("CPUTime"), "CPU_TIME")
    assert_eq(upper_snake("InvalidURL"), "INVALID_URL")
    assert_eq(upper_snake("Utf8Error"), "UTF8_ERROR")
    texts := [String:String]{}
    texts["Core/Demo/Demo.jet"] = "Limit: enum {{\n    WallTime,\n    Budget(limit: Int, fault: String),\n    TLS(String),\n}}\n"
    texts["Core/Demo/Twice.jet"] = "Twice: enum {{\n    One,\n}}\n"
    texts["Core/Demo/Again.jet"] = "Twice: enum {{\n    One,\n}}\n"
    numbered: ordinal_text([OrdinalEnum]{{core: "Limit", prefix: "DEMO_LIMIT"}}, texts)
    assert_eq(numbered.problems.len(), 0)
    assert_eq(numbered.text, "{ORDINALS_HEADER}\n\n// Limit (Core/Demo/Demo.jet)\nDEMO_LIMIT_WALL_TIME: I64{{0}}\n\nDEMO_LIMIT_BUDGET: I64{{1}}\n\nDEMO_LIMIT_TLS: I64{{2}}\n")
    refused: ordinal_text([OrdinalEnum]{{core: "Twice", prefix: "TWICE"}, {core: "Absent", prefix: "ABSENT"}}, texts)
    assert_eq(refused.problems.join("\n"), "Twice: 2 Core sources declare it with cases, not one\nAbsent: 0 Core sources declare it with cases, not one")
}

#Test("every Core.rows enum list matches its declaration") {
    passed: core_enum_cases_main([String]{"--check"}) ?? panic(err.message)
    assert(passed.starts_with("core enum cases check passed"))
}
