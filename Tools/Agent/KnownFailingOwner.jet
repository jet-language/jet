#!/usr/bin/env jet
// The known-failing owner check: the one implementation that
// Tests/Guards/known_failing_owner.jet and Tools/Agent/LaneCheck.jet
// (`--check known-failing-owner`) both run.
//
// Every row of the accepted-failing ledger (Tests/known-failing.tsv), and
// every `# KNOWN-FAILING` header in a case or golden source under Tests,
// names exactly one owning card. That card is open on the live Tower board:
// listed, not archived and not done. A row's card is in its card column; a
// header's card is its first word. The reason never names a card. So closing
// a card that a row still names is refused at the next lane check, and the
// row moves to the card that owns the remaining work first.
//
// The live board is the main checkout's. Merges into master keep master's
// board, so a branch's own copy is stale. The board read is the first of:
// TOWER_DATA (a data directory or a tower.json); the board of the checkout
// that owns the git common directory (`git rev-parse --git-common-dir`, whose
// parent is the main checkout for every worktree and the tree itself in a
// plain clone); this tree's own board.
//
// Usage, from the tree to check (the repository root):
//   jet Tools/Agent/KnownFailingOwner.jet --check
// It exits 0 when every row and header names an open card, 65 with one line
// per problem when one does not, and 64 when it cannot run.
use {
    files: core.files
    json: core.encoding.json
    process: core.process
}

LEDGER: "Tests/known-failing.tsv"

BOARD: "Tools/Tower/.tower/tower.json"

// The header a case or golden source carries instead of a ledger row.
ANNOTATION: "# KNOWN-FAILING "

run: fn() {
    args: process.args()
    if args.len() != 1 || args[0] != "--check" {
        process.fail(64, "usage: jet Tools/Agent/KnownFailingOwner.jet --check")
    }
    board_path: board_path()
    if !files.is_file(board_path) {
        process.fail(64, "known-failing-owner: the Tower board {board_path} is missing")
    }
    open: open_cards(board_path)
    if open.len() == 0 {
        process.fail(64, "known-failing-owner: the Tower board {board_path} lists no open card")
    }
    ledger: files.read(LEDGER) ?? process.fail(64, "known-failing-owner: read {LEDGER}: {err}")
    ^problems: ledger_problems(ledger, open)
    problems.extend(annotation_problems(annotations(), open))
    if problems.len() > 0 {
        process.fail(65, problems.map(fn(line) { "known-failing-owner: {line}" }).join("\n"))
    }
    print("known-failing owner: ok ({open.len()} open cards)")
}

field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

// The board path from TOWER_DATA, the git common directory and whether the
// common directory's checkout holds a board, in the order the header names.
board_choice: fn(data: String?, common_dir: String?, common_has_board: Bool) -> String {
    if data == .Val(dir) {
        if dir.ends_with(".json") -> return dir.copy()
        return "{dir}/tower.json"
    }
    if common_has_board && common_dir == .Val(common) -> return common_board(common)
    BOARD
}

// The board of the checkout that owns the git common directory `common`.
common_board: fn(common: String) -> String { "{files.dirname(common)}/{BOARD}" }

// The absolute git common directory of this tree, or None outside git.
common_dir: fn() -> String? {
    ran: process.cmd([String]{"git", "rev-parse", "--path-format=absolute", "--git-common-dir"}).stdout(.Capture).stderr(.Capture).run() ?? return None
    if ran.code != 0 -> return None
    lines: process.stdout_lines(ran)
    if lines.len() == 0 || lines[0].trim() == "" -> return None
    Val(lines[0].trim())
}

board_path: fn() -> String {
    common: common_dir()
    present: if common == .Val(dir) -> files.is_file(common_board(dir)) else -> false
    board_choice(process.env_nonempty("TOWER_DATA"), common, present)
}

// The number of every card on the board that is neither archived nor done.
open_cards: fn(path: String) -> [Int] {
    text: files.read(path) ?? process.fail(64, "known-failing-owner: read the Tower board {path}: {err}")
    board: json.parse(text) ?? process.fail(64, "known-failing-owner: the Tower board {path} is not JSON: {err}")
    ^open: [Int]{}
    if field(board, "cards") == .Array(cards) {
        loop card in cards {
            if field(card, "archived") == .Bool(true) || field(card, "phase") == .Text("done") {
                next
            }
            if field(card, "num") == .Int(num) -> open.push(num)
            if field(card, "num") == .Number(lexeme) {
                number: Int.parse(lexeme) ?? next
                open.push(number)
            }
        }
    }
    open
}

// The card a card cell names: `#` and three to five digits, nothing else.
card: fn(cell: String) -> Int? {
    if !cell.starts_with("#") -> return None
    digits: cell.slice(1, cell.len())
    if digits.len() < 3 || digits.len() > 5 -> return None
    loop scalar in digits.chars() {
        ch: "{scalar}"
        if ch < "0" || ch > "9" -> return None
    }
    number: Int.parse(digits) ?? return None
    Val(number)
}

// Whether a card number starts at `start`: `#` and three to five digits, after
// the text start, a space, a tab, `(`, `/` or `,` (`U8#128` is a type, not a
// card).
cite_at: fn(bytes: [U8], start: Int) -> Bool {
    if (Int{bytes[start]}) != 35 -> return false
    if start > 0 {
        before: Int{bytes[start - 1]}
        if before != 32 && before != 9 && before != 40 && before != 47 && before != 44 {
            return false
        }
    }
    ^end: start + 1
    loop end < bytes.len() && (Int{bytes[end]}) >= 48 && (Int{bytes[end]}) <= 57 -> end += 1
    digits: end - start - 1
    digits >= 3 && digits <= 5
}

// Whether a reason names a card, the way a comment cites one.
reason_cites: fn(reason: String) -> Bool {
    if !reason.contains("#") -> return false
    bytes: reason.bytes()
    loop index in 0..<bytes.len() {
        if cite_at(bytes, index) -> return true
    }
    false
}

// The problems of one owner (`id`) naming `cell` as its card for `reason`.
owner_problems: fn(where: String, id: String, cell: String, reason: String, open: [Int]) -> [String] {
    ^problems: [String]{}
    if card(cell) == .Val(num) {
        if !open.contains(num) {
            problems.push("{where}: {id} names #{num}, which is not open on the board; move it to the open card that owns the remaining work")
        }
    } else { problems.push("{where}: {id} names `{cell}` where one card, `#N`, belongs") }
    if reason.trim() == "" -> problems.push("{where}: {id} gives no reason")
    if reason_cites(reason) {
        problems.push("{where}: {id}'s reason names a card; only the card does")
    }
    problems
}

// The problems of one ledger line, `where` naming it.
row_problems: fn(line: String, where: String, open: [Int]) -> [String] {
    cells: line.split("\t").to_list()
    if cells.len() != 3 {
        return [String]{"{where}: a row has three tab-separated cells (id, card, reason); this one has {cells.len()}"}
    }
    owner_problems(where, cells[0], cells[1], cells[2], open)
}

ledger_problems: fn(ledger: String, open: [Int]) -> [String] {
    ^problems: [String]{}
    loop (index, line) in ledger.lines() {
        if line == "" || line.starts_with("#") -> next
        problems.extend(row_problems(line, "{LEDGER}:{index + 1}", open))
    }
    problems
}

// One `# KNOWN-FAILING` header: where it is and the text after the prefix.
Annotation: struct {
    where: String,
    text: String,
}

// Every `# KNOWN-FAILING` header line of a tracked case or golden source
// under Tests, as the case and golden runners read it (Compiler/JetTestKit
// kit_cases_known_failure: the trimmed line starts with the prefix).
annotations: fn() -> [Annotation] {
    ran: process.cmd([String]{"git", "grep", "-n", "-I", "-E", "^[[:space:]]*# KNOWN-FAILING ", "--", "Tests/*.case", "Tests/*.jet"}).stdout(.Capture).stderr(.Capture).run() ?? process.fail(64, "known-failing-owner: run git grep: {err}")
    // git grep exits 1 when nothing matches.
    if ran.code > 1 {
        process.fail(64, "known-failing-owner: git grep: {process.combined_output(ran).trim()}")
    }
    ^found: [Annotation]{}
    loop line in process.stdout_lines(ran) {
        parts: line.split(":").to_list()
        if parts.len() < 3 -> next
        where: "{parts[0]}:{parts[1]}"
        header: line.slice(where.len() + 1, line.len()).trim()
        found.push(Annotation{where: where, text: header.slice(ANNOTATION.len(), header.len()).trim()})
    }
    found
}

annotation_problems: fn(found: [Annotation], open: [Int]) -> [String] {
    ^problems: [String]{}
    loop annotation in found {
        words: annotation.text.split(" ").to_list()
        reason: annotation.text.slice(words[0].len(), annotation.text.len())
        problems.extend(owner_problems(annotation.where, "its KNOWN-FAILING header", words[0], reason, open))
    }
    problems
}

#Test("a row and a header name one open card, and only the card names one") {
    assert((card("#6843") ?? 0) == 6843)
    assert(card("#68") == None, "two digits are no card")
    assert(card("6843") == None, "a card cell starts with `#`")
    assert(card("#6843 #6844") == None, "a row names one card")
    assert(row_problems("a.case\t#6843\twhy", "t:1", [Int]{6843}).len() == 0)
    assert(row_problems("a.case\t#6843\twhy", "t:1", [Int]{6844}).len() == 1, "a closed card is refused")
    assert(row_problems("a.case\t#6843\twhy (#5554)", "t:1", [Int]{6843}).len() == 1, "the reason names no card")
    assert(row_problems("a.case\t#6843", "t:1", [Int]{6843}).len() == 1, "a row has a reason")
    assert(!reason_cites("`#Persist` keeps U8#128 and color #0a0b0c"))
    assert_eq(ledger_problems("# comment\n\na.case\t#6843\twhy\n", [Int]{6843}), [String]{})
    assert_eq(ledger_problems("a.case\t#6843\twhy\n", [Int]{6844}), [String]{"Tests/known-failing.tsv:1: a.case names #6843, which is not open on the board; move it to the open card that owns the remaining work"})
    header: Annotation{where: "Tests/Cases/a.case:3", text: "#6843 the parser drops it"}
    assert_eq(annotation_problems([Annotation]{header}, [Int]{6843}), [String]{})
    assert_eq(annotation_problems([Annotation]{Annotation{where: "Tests/Cases/a.case:3", text: "#6843 the parser drops it"}}, [Int]{6844}).len(), 1)
    assert_eq(annotation_problems([Annotation]{Annotation{where: "Tests/Cases/a.case:3", text: "#6843 see #6844"}}, [Int]{6843}).len(), 1)
    assert_eq(annotation_problems([Annotation]{Annotation{where: "Tests/Cases/a.case:3", text: "the parser drops it"}}, [Int]{6843}).len(), 1)
}

#Test("the live board is TOWER_DATA, else the main checkout's, else this tree's") {
    worktree_common: "/srv/jet/.git"
    assert_eq(board_choice(None, Val(worktree_common), true), "/srv/jet/Tools/Tower/.tower/tower.json")
    assert_eq(board_choice(Val("/data"), Val(worktree_common), true), "/data/tower.json")
    assert_eq(board_choice(Val("/data/board.json"), Val(worktree_common), true), "/data/board.json")
    assert_eq(board_choice(None, Val(worktree_common), false), BOARD)
    assert_eq(board_choice(None, None, false), BOARD)
}
