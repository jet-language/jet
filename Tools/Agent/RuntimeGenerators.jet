#!/usr/bin/env jet
// The runtime's generated tables from their one source each.
// Usage: jet Tools/Agent/RuntimeGenerators.jet [--check] [--defects-only]
//        jet Tools/Agent/RuntimeGenerators.jet lifecycle FILE...
//        jet Tools/Agent/RuntimeGenerators.jet exports
//        jet Tools/Agent/RuntimeGenerators.jet fault-report [--check]
//   (default)        rewrite every stale output
//   --check          write nothing; report every stale output
//   Both also fail on a bare exit status 70 or 101 in an exit position
//   outside the exit-code table's generated copies (exit_guard).
//   --defects-only   regenerate only the private trap defect rows, refusing
//                    when the frozen ordinary trap projection differs
//   lifecycle        print the lifecycle.list of a library object built from
//                    exactly the runtime sources FILE... (`-`: stdin; a
//                    fixture's unit)
//   exports          print `SYMBOL<TAB>FILE` for each #Export(c) function of
//                    the runtime sources sources.list names, in its order
//   fault-report     assemble the native fault reports (GNU as, which the
//                    dev shell provides: run it as `jet Tools/Agent/JetEnv.jet
//                    jet Tools/Agent/RuntimeGenerators.jet fault-report`)
//                    into X64/FaultReport.jet; --check writes nothing
// Run it from the repository root; every path is relative to it.
use {
    crypto: core.crypto
    json: core.encoding.json
    files: core.files
    process: core.process
    term: core.term
}

GeneratedFile: struct {
    path: String,
    text: String,
}

// The file's text, or None when it does not exist.
read_output: fn(path: String) -[FS]> String? GeneratorError! {
    if !files.exists(path) -> return Ok(None)
    text: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
    Ok(Val(text))
}

output_current: fn(path: String, expected: String) -[FS]> Bool GeneratorError! {
    if read_output(path) == {
        .Ok(found) -> {
            if found == {
                .Val(text) -> return Ok(text == expected)
                .None -> return Ok(false)
            }
        }
        .Err(error) -> return Err(error)
    }
}

write_output: fn(path: String, text: String) GeneratorError! {
    files.write(path, text) ?? return Err(generator_fail("cannot write {path}: {err}"))
}

USAGE: "usage: jet Tools/Agent/RuntimeGenerators.jet [--check] [--defects-only] | lifecycle FILE... | exports | fault-report [--check]"

runtime_generators_main: fn(args: [String]) -[Exec, FS, IO]> String GeneratorError! {
    if args.len() > 0 && args[0] == "lifecycle" -> return unit_lifecycle_list(args)
    if args.len() == 1 && args[0] == "exports" -> return runtime_export_files()
    if args.len() > 0 && args[0] == "fault-report" -> return fault_report_main(args)
    check := false
    defects_only := false
    loop arg in args {
        if {
            arg == "--check" -> check = true
            arg == "--defects-only" -> defects_only = true
            else -> return Err(generator_fail(USAGE))
        }
    }
    registry: files.read(REGISTRY_PATH) ?? return Err(generator_fail("cannot read {REGISTRY_PATH}: {err}"))
    routes: files.read(ROUTES_PATH) ?? return Err(generator_fail("cannot read {ROUTES_PATH}: {err}"))
    debug: files.read(DEBUG_PATH) ?? return Err(generator_fail("cannot read {DEBUG_PATH}: {err}"))
    problems := [String]{}
    if render_trap_messages(registry, routes, debug) == {
        .Ok(trap) -> {
            source_current: output_current(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
            defects_current: output_current(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
            if trap_messages_plan(check, defects_only, source_current, defects_current) == {
                .Ok(plan) -> {
                    if plan.write_source {
                        write_output(TRAP_TARGET_PATH, trap.source) ?? return Err(err)
                    }
                    if plan.write_defects {
                        write_output(TRAP_DEFECT_TARGET_PATH, trap.defects) ?? return Err(err)
                    }
                }
                .Err(error) -> problems.push(error.message)
            }
        }
        .Err(error) -> problems.push(error.message)
    }
    if defects_only {
        if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
        return Ok("")
    }
    outputs := [GeneratedFile]{}
    if render_scheduler_messages(registry) == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: SCHEDULER_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if render_test_messages(registry) == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: TEST_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if render_observe_messages() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: OBSERVE_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if render_services_messages(registry) == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: SERVICES_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if render_lifecycle_list() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: LIFECYCLE_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if read_needed_text() == {
        .Ok(needed) -> {
            loop file in needed -> outputs.push(file)
        }
        .Err(error) -> problems.push(error.message)
    }
    if read_c_exports() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: C_EXPORTS_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if read_host_errors() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: HOST_ERRORS_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if read_host_carriers() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: HOST_CARRIERS_TARGET_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    if read_dyn_kinds() == {
        .Ok(generated) -> {
            loop file in generated -> outputs.push(file)
        }
        .Err(error) -> problems.push(error.message)
    }
    if read_exit_codes() == {
        .Ok(generated) -> {
            loop file in generated -> outputs.push(file)
        }
        .Err(error) -> problems.push(error.message)
    }
    if read_process_grants() == {
        .Ok(text) -> { outputs.push(GeneratedFile{path: PROCESS_GRANTS_RUNTIME_PATH, text: text}) }
        .Err(error) -> problems.push(error.message)
    }
    loop output in outputs {
        current: output_current(output.path, output.text) ?? return Err(err)
        if current -> next
        if check {
            problems.push("{output.path} is stale; run jet Tools/Agent/RuntimeGenerators.jet")
        } else { write_output(output.path, output.text) ?? return Err(err) }
    }
    if exit_guard() == {
        .Ok(found) -> {
            loop problem in found -> problems.push(problem)
        }
        .Err(error) -> problems.push(error.message)
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    if check -> return Ok("runtime generated tables are current")
    Ok("")
}

// `lifecycle FILE...` (`args` with its mode word): the lifecycle.list of
// exactly those runtime sources, without its final newline. A FILE `-` is
// the source text on stdin.
unit_lifecycle_list: fn(args: [String]) -[FS, IO]> String GeneratorError! {
    if args.len() < 2 -> return Err(generator_fail(USAGE))
    problems := [String]{}
    sources := [RuntimeSource]{}
    loop at in 1..<args.len() {
        path: args[at]
        if path == "-" {
            if term.read_all_input() == {
                .Ok(text) -> { sources.push(RuntimeSource{path: "stdin", text: text}) }
                .Err(error) -> problems.push("cannot read stdin: {error}")
            }
            next
        }
        if files.read(path) == {
            .Ok(text) -> { sources.push(RuntimeSource{path: path.copy(), text: text}) }  // copy: `args` keeps its rows
            .Err(error) -> problems.push("cannot read {path}: {error}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    list: lifecycle_list(sources) ?? return Err(err)
    list.removesuffix("\n")
}

// `exports`: `SYMBOL<TAB>FILE` for each runtime #Export(c) function, in
// sources.list order.
runtime_export_files: fn() -[FS]> String GeneratorError! {
    sources: read_runtime_sources() ?? return Err(err)
    rows := [String]{}
    loop export in placed_exports(sources) ?? return Err(err) {
        rows.push("{export.name}\t{export.path}")
    }
    rows.join("\n")
}

run: fn() {
    message: runtime_generators_main(process.args()) ?? process.fail(1, err.message)
    if message != "" -> print(message)
}

// Heap-free runtime literals are process-static texts or little-endian 64-bit
// words, so the runtime never builds a String or an exact Int to print them.
// Every output's first line names this file as its one generator.

#Error
GeneratorError: struct {
    message: String,
}

generator_fail: fn(message: String) -> GeneratorError Never! { GeneratorError{message: message} }

// One named literal of a generated table.
MessageLiteral: struct {
    name: String,
    text: String,
}

// A Core library stop that carries a registered code (core.rt.__coded_stop),
// and the exit status it ends the program with: a constant generated from
// Compiler/JetFoundation/Source/Registry/ExitCodes.jet.
CodedStop: struct {
    code: String,
    exit: String,
}

// A word of a literal: its byte offset, signed value, and byte count (1-8).
TextWord: struct {
    offset: Int,
    value: Int,
    count: Int,
}

// Bytes `start..<end` of `text`. String.find reports UTF-8 byte offsets, so
// every offset it returns is sliced here, never with String.slice.
byte_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

byte_len: fn(text: String) -> Int Never! { text.bytes().len() }

byte_tail: fn(text: String, start: Int) -> String Never! { byte_slice(text, start, byte_len(text)) }

// The little-endian signed machine word of bytes `start..<end` (at most 8). A
// signed literal preserves all eight bytes: only the eighth byte carries the
// sign, with weight 2^56.
packed_word: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    word := 0
    loop index in start..<end {
        byte: Int{bytes[index]}
        weight: 1 << (8 * (index - start))
        if index - start == 7 && byte >= 128 -> word += (byte - 256) * weight else {
            word += byte * weight
        }
    }
    word
}

text_words: fn(text: String) -> [TextWord] Never! {
    bytes: text.bytes()
    words := [TextWord]{}
    at := 0
    loop at < bytes.len() {
        end: if at + 8 < bytes.len() -> at + 8 else -> bytes.len()
        words.push(TextWord{offset: at, value: packed_word(bytes, at, end), count: end - at})
        at += 8
    }
    words
}

#Test("words are little-endian and keep the eighth byte's sign") {
    words: text_words("abcdefghé")
    assert_eq(words.len(), 2)
    assert_eq(words[0].value, 7523094288207667809)
    assert_eq(words[0].count, 8)
    assert_eq(words[1].offset, 8)
    assert_eq(words[1].value, 43459)
    assert_eq(words[1].count, 2)
    high: text_words("éééé")
    assert_eq(high[0].count, 8)
    assert(high[0].value < 0)
}

// Diagnostic registry prose, read from Registry/DiagnosticRows.jet: the
// registry stays the one source of a runtime row's words.

REGISTRY_PATH: "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet"

// The value of the quoted literal that starts at `text`'s first byte (a `"`),
// and the byte length of its source spelling.
QuotedLiteral: struct {
    value: String,
    spelling_len: Int,
}

quoted_literal: fn(text: String) -> QuotedLiteral? Never! {
    bytes: text.bytes()
    if bytes.len() == 0 || (Int{bytes[0]}) != 34 -> return None
    out := [U8]{}
    index := 1
    loop index < bytes.len() {
        code: Int{bytes[index]}
        if code == 34 {
            return Val(QuotedLiteral{value: String.from_bytes_lossy(out), spelling_len: index + 1})
        }
        if code == 92 {
            if index + 1 >= bytes.len() -> return None
            escaped: Int{bytes[index + 1]}
            if {
                escaped == 34 || escaped == 92 -> out.push(bytes[index + 1])
                escaped == 110 -> out.push(U8{10})
                escaped == 116 -> out.push(U8{9})
                escaped == 114 -> out.push(U8{13})
                else -> return None
            }
            index += 2
            next
        }
        out.push(bytes[index])
        index += 1
    }
    None
}

// The text of the registry row for `code`, from its first field to its end.
registry_row: fn(registry: String, code: String) -> String GeneratorError! {
    marker: "\n        code: \"{code}\","
    start: registry.find(marker)
    if start < 0 -> return Err(generator_fail("missing runtime row {code}"))
    before: byte_slice(registry, 0, start)
    if !before.ends_with("DiagnosticRegistryRow{{") && !before.ends_with("\n    {{") {
        return Err(generator_fail("missing runtime row {code}"))
    }
    rest: byte_tail(registry, start + byte_len(marker))
    end := byte_len(rest)
    next_named: rest.find("DiagnosticRegistryRow{{")
    if next_named >= 0 && next_named < end -> end = next_named
    next_plain: rest.find("\n    {{\n        code:")
    if next_plain >= 0 && next_plain < end -> end = next_plain
    Ok(byte_slice(rest, 0, end))
}

// The `name` field of the registry row for `code`, as written (`{{` kept).
registry_field_raw: fn(registry: String, code: String, name: String) -> String GeneratorError! {
    row: registry_row(registry, code) ?? return Err(err)
    field_marker: "\n        {name}: "
    at: row.find(field_marker)
    if at < 0 -> return Err(generator_fail("missing {code}.{name}"))
    after: byte_tail(row, at + byte_len(field_marker))
    literal: quoted_literal(after) ?? return Err(generator_fail("missing {code}.{name}"))
    if !byte_tail(after, literal.spelling_len).starts_with(",") {
        return Err(generator_fail("missing {code}.{name}"))
    }
    Ok(literal.value)
}

// The report label of the runtime row for `code`: the case of its `tier`
// field. A runtime fault stops the program, so its row must be an error.
registry_label: fn(registry: String, code: String) -> String GeneratorError! {
    row: registry_row(registry, code) ?? return Err(err)
    marker: "\n        tier: DiagnosticTier."
    at: row.find(marker)
    if at < 0 -> return Err(generator_fail("missing {code}.tier"))
    after: byte_tail(row, at + byte_len(marker))
    end: after.find(",")
    if end < 0 -> return Err(generator_fail("missing {code}.tier"))
    label: byte_slice(after, 0, end)
    if label != "Error" {
        return Err(generator_fail("runtime row {code} is a {label} row; a runtime fault reports an error"))
    }
    Ok(label)
}

// The field's text: a template's `{{`/`}}` read as single braces.
registry_field: fn(registry: String, code: String, name: String) -> String GeneratorError! {
    raw: registry_field_raw(registry, code, name) ?? return Err(err)
    Ok(raw.replace("{{{{", "{{").replace("}}}}", "}}"))
}

// Text before / after the first `{msg}` hole of an unescaped template.
before_hole: fn(text: String) -> String Never! {
    at: text.find("{{msg}}")
    if at < 0 -> text else -> byte_slice(text, 0, at)
}

after_hole: fn(text: String) -> String Never! {
    at: text.find("{{msg}}")
    if at < 0 -> "" else -> byte_tail(text, at + byte_len("{{msg}}"))
}

// The runtime's fixed message tables: scheduler, observe, test-reporter and
// services literals, each written as words so the runtime unit never needs an
// implicit String or Int carrier to produce them.

SCHEDULER_TARGET_PATH: "Compiler/JetRuntime/Source/SchedulerMessages.jet"

OBSERVE_TARGET_PATH: "Compiler/JetRuntime/Source/ObserveMessages.jet"

TEST_TARGET_PATH: "Compiler/JetRuntime/Source/TestMessages.jet"

SERVICES_TARGET_PATH: "Compiler/JetRuntime/Source/ServicesMessages.jet"

TEST_ORDINARY_FAILURE: "__jet_test_ordinary_failure__"

// Literals longer than two words are one process-static text, which costs
// less than the words that would store or push them.
static_text_worthy: fn(text: String) -> Bool Never! { byte_len(text) > 16 }

// The width `jet fmt` keeps a line within.
FMT_WIDTH: 100

// The block `head { … }` at `indent`, whose `body` lines are each indented
// four spaces past it and ended by a newline, as `jet fmt` writes it: a body
// of one line stays on the head's line when that line fits FMT_WIDTH.
fmt_block: fn(indent: String, head: String, body: String) -[]> String {
    if byte_len(body) > 0 && body.find("\n") == byte_len(body) - 1 {
        line: "{indent}{head} {{ {body.trim()} }}"
        if line.chars().len() <= FMT_WIDTH -> return "{line}\n"
    }
    "{indent}{head} {{\n{body}{indent}}}\n"
}

// `text` as an `rt_static_text("…")` literal of the runtime source.
static_text: fn(text: String) -> String GeneratorError! {
    loop byte in text.bytes() {
        code: Int{byte}
        if code <= 9 || (code >= 11 && code <= 31) || code == 127 {
            return Err(generator_fail("control byte in runtime static text {text}"))
        }
    }
    body: text.replace("\\", "\\\\").replace("\"", "\\\"").replace("{{", "{{{{").replace("}}", "}}}}").replace("\n", "\\n")
    Ok("rt_static_text(\"{body}\")")
}

// Owned E4 text: a sized text object whose data is copied from one static
// text, or whose data words are stored in place.
owned_text_function: fn(name: String, text: String) -> String GeneratorError! {
    out := "\n{name}: fn() -> I64 {{\n    text: scheduler_text_new(I64{{{byte_len(text)}}})\n    data: sync_load(text)\n"
    if static_text_worthy(text) {
        literal: static_text(text) ?? return Err(err)
        out = "{out}    coll_copy(rt_text_data({literal}), data, I64{{{byte_len(text)}}})\n"
    } else {
        loop word in text_words(text) {
            out = "{out}    sync_store(wrapping(data + I64{{{word.offset}}}), I64{{{word.value}}})\n"
        }
    }
    Ok("{out}    text\n}}\n")
}

// Words appended to a text builder or written to a descriptor by `sink`.
word_writes: fn(target: String, sink: String, text: String) -> String Never! {
    out := ""
    loop word in text_words(text) {
        out = "{out}    {sink}({target}, I64{{{word.value}}}, I64{{{word.count}}})\n"
    }
    out
}

// The body of a builder appender: one static-text push, or word pushes.
builder_writes: fn(target: String, text: String) -> String GeneratorError! {
    if !static_text_worthy(text) -> return Ok(word_writes(target, "rt_text_push_word", text))
    literal: static_text(text) ?? return Err(err)
    Ok("    jet_rt_string_builder_push({target}, {literal})\n")
}

// Scheduler literals have no implicit String/Int carrier in the runtime unit.
// The E3003 deadline report is its registry row: `head` and `tail` are its
// What around the wait kind, and the tail carries its Why and Fix.
scheduler_literals: fn(deadline_head: String, deadline_tail: String) -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "threads", text: "JET_SCHEDULER_THREADS"},
        MessageLiteral{name: "replay", text: "JET_PROVE_REPLAY_TIME_MS"},
        MessageLiteral{name: "epoch", text: "LEX_TEST_EPOCH"},
        MessageLiteral{name: "pause", text: "task pause"},
        MessageLiteral{name: "join", text: "task join"},
        MessageLiteral{name: "sleep", text: "time sleep"},
        MessageLiteral{name: "yield", text: "task yield"},
        MessageLiteral{name: "shield", text: "shield exit"},
        MessageLiteral{name: "admission", text: "task admission"},
        MessageLiteral{name: "selection", text: "task selection"},
        MessageLiteral{name: "deadline_head", text: deadline_head},
        MessageLiteral{name: "deadline_tail", text: deadline_tail},
        MessageLiteral{name: "canceled", text: "task canceled at a cooperative wait point"},
        MessageLiteral{name: "separator", text: ": "},
        MessageLiteral{name: "start_failed", text: "could not start scheduler worker"},
        MessageLiteral{name: "completion_exhausted", text: "task completion order exhausted"},
        MessageLiteral{name: "rt_rate", text: "real-time callback rate must be positive"},
        MessageLiteral{name: "rt_frames", text: "real-time callback frame count must be positive"},
        MessageLiteral{name: "rt_native_range", text: "native Int argument exceeds host range"},
        MessageLiteral{name: "rt_capacity", text: "capacity overflow"},
        MessageLiteral{name: "rt_ring_frames", text: "real-time sample ring needs a positive frame count"},
        MessageLiteral{name: "rt_self_join", text: "failed to join real-time worker: Resource deadlock avoided"},
        MessageLiteral{name: "rt_join_failed", text: "failed to join real-time worker"},
        MessageLiteral{name: "rt_start_failed", text: "failed to spawn real-time worker"},
    }
}

render_scheduler_messages: fn(registry: String) -> String GeneratorError! {
    what: registry_field(registry, "E3003", "what") ?? return Err(err)
    why: registry_field_raw(registry, "E3003", "why") ?? return Err(err)
    fix: registry_field_raw(registry, "E3003", "fix") ?? return Err(err)
    hole: "{{wait_kind}}"
    at: what.find(hole)
    if at < 0 -> return Err(generator_fail("E3003's What has no {hole} hole"))
    name: registry_field(registry, "E3003", "name") ?? return Err(err)
    head: "Error: {name}: {byte_slice(what, 0, at)}"
    tail: "{byte_tail(what, at + byte_len(hole))}\n Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{name}"
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet; UTF-8 E4 literals.\n"
    loop literal in scheduler_literals(head, tail) {
        function: owned_text_function("scheduler_msg_{literal.name}", literal.text) ?? return Err(err)
        source = "{source}{function}"
    }
    Ok(source)
}

// Observe fragments append directly to the canonical E4 builder, without
// allocating an intermediate String for each fixed diagnostic/path fragment.
observe_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "task_label", text: "task@"},
        MessageLiteral{name: "task_fallback", text: "task #"},
        MessageLiteral{name: "site", text: " (spawn site "},
        MessageLiteral{name: "close_site", text: ")"},
        MessageLiteral{name: "path_head", text: "jet-observe-"},
        MessageLiteral{name: "path_tail", text: ".json"},
        MessageLiteral{name: "stage_head", text: ".jet-observe-"},
        MessageLiteral{name: "stage_tail", text: ".tmp"},
        MessageLiteral{name: "root_label", text: "root"},
        MessageLiteral{name: "env_observe", text: "JET_OBSERVE"},
        MessageLiteral{name: "env_session", text: "JET_DEVTOOLS_RELAY_SESSION_ID"},
        MessageLiteral{name: "env_source", text: "JET_DEVTOOLS_RELAY_SOURCE_ID"},
        MessageLiteral{name: "env_build", text: "JET_DEVTOOLS_RELAY_BUILD_ID"},
        MessageLiteral{name: "env_revision", text: "JET_DEVTOOLS_RELAY_REVISION"},
        MessageLiteral{name: "env_world", text: "JET_DEVTOOLS_RELAY_WORLD_ID"},
        MessageLiteral{name: "env_tmpdir", text: "TMPDIR"},
        MessageLiteral{name: "default_tmpdir", text: "/tmp"},
    }
}

render_observe_messages: fn() -> String GeneratorError! {
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet; direct E4 builder fragments.\n"
    loop literal in observe_literals() {
        body: builder_writes("target", literal.text) ?? return Err(err)
        source = "{source}\n{fmt_block("", "observe_msg_{literal.name}: fn(target: I64)", body)}"
    }
    Ok(source)
}

// Fixed-width, heap-free literals for the native unit-test reporter.
test_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "invalid", text: "internal error: native test record is invalid\n"},
        MessageLiteral{name: "pass", text: "pass"},
        MessageLiteral{name: "fail", text: "FAIL"},
        MessageLiteral{name: "skip", text: "skip"},
        MessageLiteral{name: "expected", text: "expected-fail"},
        MessageLiteral{name: "unexpected", text: "UNEXPECTED-PASS (remove expected_fail: true)"},
        MessageLiteral{name: "passed", text: " passed, "},
        MessageLiteral{name: "failed", text: " failed, "},
        MessageLiteral{name: "skipped", text: " skipped"},
        MessageLiteral{name: "expected_count", text: " expected-fail"},
        MessageLiteral{name: "unexpected_count", text: " unexpected-pass"},
        MessageLiteral{name: "shuffle", text: "shuffle: seed="},
        MessageLiteral{name: "json_schema", text: "{{\"schema\":\"jet.test.v1\",\"ok\":"},
        MessageLiteral{name: "json_passed", text: ",\"passed\":"},
        MessageLiteral{name: "json_failed", text: ",\"failed\":"},
        MessageLiteral{name: "json_skipped", text: ",\"skipped\":"},
        MessageLiteral{name: "json_expected", text: ",\"expectedFailures\":"},
        MessageLiteral{name: "json_unexpected", text: ",\"unexpectedPasses\":"},
        MessageLiteral{name: "json_tests", text: ",\"tests\":["},
        MessageLiteral{name: "json_name", text: "{{\"name\":"},
        MessageLiteral{name: "json_ok", text: ",\"ok\":"},
        MessageLiteral{name: "json_expectation", text: ",\"expectedFailure\":"},
        MessageLiteral{name: "json_skip", text: ",\"skipped\":"},
        MessageLiteral{name: "json_stdout", text: ",\"stdout\":"},
        MessageLiteral{name: "json_stderr", text: ",\"stderr\":"},
        MessageLiteral{name: "true", text: "true"},
        MessageLiteral{name: "false", text: "false"},
    }
}

// Environment keys are owned E4 text, borrowed only for the existing host leaf.
test_key_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "json", text: "JET_TEST_JSON"},
        MessageLiteral{name: "capture", text: "JET_TEST_CAPTURE"},
        MessageLiteral{name: "shuffle", text: "JET_TEST_SHUFFLE_SEED"},
    }
}

// Test-scope diagnostics use owned E4 builders, sharing these fixed-width
// literal appenders with the reporter.
test_scope_literals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "expected", text: "expected "},
        MessageLiteral{name: "region_stop", text: "this region to stop with "},
        MessageLiteral{name: "region_fail", text: "this region to fail"},
        MessageLiteral{name: "stop_code", text: "a stop with "},
        MessageLiteral{name: "stop_message", text: "a stop whose message contains "},
        MessageLiteral{name: "code_message", text: " whose message contains "},
        MessageLiteral{name: "passed", text: ", but it passed"},
        MessageLiteral{name: "got", text: ", got "},
        MessageLiteral{name: "colon", text: ": "},
        MessageLiteral{name: "timeout", text: "timeout: region took "},
        MessageLiteral{name: "timeout_limit", text: "ns, limit was "},
        MessageLiteral{name: "ns", text: "ns"},
    }
}

// A stop code's bytes as one little-endian word.
code_word: fn(code: String) -> Int Never! {
    word := 0
    code_bytes: code.bytes()
    loop at in 0..<code_bytes.len() -> word += Int{code_bytes[at]} << (8 * at)
    word
}

// `test_scope_push_name` (TestScope.jet): a recorded stop's code as its row's
// name, for every runtime row and every coded stop. Any other code is pushed
// as it was recorded.
test_scope_name_appender: fn(registry: String) -> String GeneratorError! {
    coded: loop stop in coded_stop_rows() -> stop.code
    source := ""
    branches := ""
    seen := [String]{}
    loop (index, segment) in registry.split("\n        code: \"").to_list() {
        if index == 0 -> next
        code: byte_slice(segment, 0, segment.find("\""))
        if seen.contains(code) || (!segment.contains("\n        stage: \"runtime\",") && !coded.contains(code)) {
            next
        }
        if byte_len(code) != 5 {
            return Err(generator_fail("{code} is not a five-byte diagnostic code"))
        }
        name: registry_field(registry, code, "name") ?? return Err(err)
        body: builder_writes("builder", name) ?? return Err(err)
        source = "{source}{fmt_block("", "test_scope_name_{code.lower()}: fn(builder: I64)", body)}\n"
        branches = "{branches}        (word == I64{{{code_word(code)}}}) -> test_scope_name_{code.lower()}(builder)\n"
        seen.push(code)
    }
    Ok("{source}test_scope_push_name: fn(builder: I64, code: I64) {{\n    word: test_scope_code_word(code)\n    if {{\n{branches}        else -> jet_rt_string_builder_push(builder, code)\n    }}\n}}\n\n")
}

render_test_messages: fn(registry: String) -> String GeneratorError! {
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet; do not hand-edit.\n// Little-endian UTF-8 stack writes never construct a Rust String or exact Int.\n\n"
    loop literal in test_literals() {
        if static_text_worthy(literal.text) {
            text: static_text(literal.text) ?? return Err(err)
            source = "{source}test_msg_{literal.name}: fn(fd: I64) {{\n    text: {text}\n    test_write(fd, rt_text_data(text), rt_text_len(text))\n}}\n\n"
        } else {
            source = "{source}{fmt_block("", "test_msg_{literal.name}: fn(fd: I64)", word_writes("fd", "test_write_word", literal.text))}\n"
        }
    }
    loop literal in test_key_literals() {
        bytes: literal.text.bytes()
        source = "{source}test_key_{literal.name}: fn() -> I64 {{\n    text: test_text_new(I64{{{bytes.len()}}})\n    data: trap_word(text)\n"
        loop index in 0..<bytes.len() {
            source = "{source}    trap_put(wrapping(data + I64{{{index}}}), I64{{{Int{bytes[index]}}}})\n"
        }
        source = "{source}    text\n}}\n\n"
    }
    loop literal in test_scope_literals() {
        body: builder_writes("builder", literal.text) ?? return Err(err)
        source = "{source}{fmt_block("", "test_scope_msg_{literal.name}: fn(builder: I64)", body)}\n"
    }
    names: test_scope_name_appender(registry) ?? return Err(err)
    source = "{source}{names}"
    ordinary: TEST_ORDINARY_FAILURE.bytes()
    source = "{source}test_scope_ordinary: fn(text: I64) -> Bool {{\n    if (text == I64{{0}}) {{ return false }}\n    if (trap_word(wrapping(text + I64{{8}})) != I64{{{ordinary.len()}}}) {{ return false }}\n    data: trap_word(text)\n"
    loop index in 0..<ordinary.len() {
        source = "{source}    if (trap_byte(wrapping(data + I64{{{index}}})) != I64{{{Int{ordinary[index]}}}}) {{ return false }}\n"
    }
    Ok("{source}    true\n}}\n")
}

// Controlled-world and sentry literals use the runtime's existing E4 ABI.
// `names` are the R0801, R0802 and R0803 rows' names, which their links carry.
services_literals: fn(names: [String]) -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "world_backwards", text: "deterministic world cannot move time backwards; advance requires a non-negative duration"},
        MessageLiteral{name: "world_exhausted", text: "deterministic world clock exhausted its supported range"},
        MessageLiteral{name: "world_budget", text: "deterministic world execution budget exhausted while waiting for idle"},
        MessageLiteral{name: "world_live", text: "deterministic world scope exited with live descendants; cancel and join every task"},
        MessageLiteral{name: "world_overflow", text: "deterministic world timer overflowed"},
        MessageLiteral{name: "world_nested", text: "deterministic world nesting is ambiguous; use the parent world explicitly"},
        MessageLiteral{name: "world_sleep", text: "deterministic world sleep requires a controlled scheduler task"},
        MessageLiteral{name: "world_network", text: "deterministic world has no controlled network provider"},
        MessageLiteral{name: "world_foreign", text: "deterministic world has no controlled foreign provider"},
        MessageLiteral{name: "world_entropy", text: "deterministic world has no controlled entropy provider"},
        MessageLiteral{name: "world_clock", text: "deterministic world has no controlled clock provider"},
        MessageLiteral{name: "world_external", text: "deterministic world has no controlled external-effect provider"},
        MessageLiteral{name: "spawn", text: "task:spawn"},
        MessageLiteral{name: "finish", text: "task:finish"},
        MessageLiteral{name: "advance", text: "advance:"},
        MessageLiteral{name: "timer", text: "timer:"},
        MessageLiteral{name: "register", text: "timer:register:"},
        MessageLiteral{name: "rng", text: "rng:"},
        MessageLiteral{name: "seed", text: "rng:seed:"},
        MessageLiteral{name: "colon", text: ":"},
        MessageLiteral{name: "lf", text: "\n"},
        MessageLiteral{name: "sentry_location", text: "  --> "},
        MessageLiteral{name: "sentry_gate", text: ", in #Unsafe gate "},
        MessageLiteral{name: "sentry_read", text: "read"},
        MessageLiteral{name: "sentry_valid_ptr", text: "valid_ptr"},
        MessageLiteral{name: "sentry_why", text: " Why: "},
        MessageLiteral{name: "sentry_fix", text: "\n Fix: "},
        MessageLiteral{name: "sentry_obligation", text: "\nobligation: valid_ptr = false\n"},
        MessageLiteral{name: "sentry_foreign", text: "foreign: "},
        MessageLiteral{name: "sentry_fenced", text: " = fenced\n"},
        MessageLiteral{name: "sentry_unfenced", text: " = unfenced\n"},
        MessageLiteral{name: "sentry_exit", text: "exit: "},
        MessageLiteral{name: "sentry_footer1", text: "More: jet-lang.dev/e/{names[0]}\n"},
        MessageLiteral{name: "sentry_footer2", text: "More: jet-lang.dev/e/{names[1]}\n"},
        MessageLiteral{name: "sentry_footer3", text: "More: jet-lang.dev/e/{names[2]}\n"},
        MessageLiteral{name: "sentry_provenance", text: "no live allocation contains this address"},
        MessageLiteral{name: "sentry_heap", text: "the address belongs to quarantined storage"},
        MessageLiteral{name: "sentry_stack", text: "the owning Jet frame has expired"},
        MessageLiteral{name: "sentry_address", text: "the address is a multiple of "},
        MessageLiteral{name: "sentry_plus", text: " plus "},
        MessageLiteral{name: "sentry_alignment", text: ", so it is not aligned to "},
        MessageLiteral{name: "sentry_bytes", text: " bytes"},
        MessageLiteral{name: "sentry_offset", text: "the access starts at offset "},
        MessageLiteral{name: "sentry_within", text: " of the live range 0x"},
        MessageLiteral{name: "sentry_nearest", text: " of the nearest live range below it, 0x"},
        MessageLiteral{name: "sentry_upto", text: "..<0x"},
        MessageLiteral{name: "sentry_size", text: " ("},
        MessageLiteral{name: "sentry_past", text: " bytes) and runs past its end"},
        MessageLiteral{name: "ledger_key", text: "JET_MEMORY_LEDGER"},
        MessageLiteral{name: "ledger_default", text: ".jet/memory/ledger-v1.jsonl"},
        MessageLiteral{name: "ledger_head", text: "{{\"schema\":\"jet.memory.ledger\",\"version\":1,\"kind\":\"sentry\",\"code\":\"R080"},
        MessageLiteral{name: "ledger_source", text: "\",\"source\":"},
        MessageLiteral{name: "ledger_start", text: ",\"span_start\":"},
        MessageLiteral{name: "ledger_end", text: ",\"span_end\":"},
        MessageLiteral{name: "ledger_scope", text: ",\"byte_spans\":false,\"scope\":"},
        MessageLiteral{name: "ledger_provenance", text: ",\"provenance\":\"source #Unsafe gate\",\"detail\":"},
        MessageLiteral{name: "ledger_repairs", text: ",\"expected\":null,\"repairs\":"},
        MessageLiteral{name: "ledger_repairs1", text: "[\"derive the pointer from live storage inside this gate\",\"remove the raw access\"]}}\n"},
        MessageLiteral{name: "ledger_repairs2", text: "[\"move the raw access before the storage is released\",\"replace the raw pointer with an owned value\"]}}\n"},
        MessageLiteral{name: "ledger_repairs3", text: "[\"derive an aligned pointer from the live allocation\",\"use the typed memory operation instead of raw address arithmetic\"]}}\n"},
    }
}

render_services_messages: fn(registry: String) -> String GeneratorError! {
    sentries: ["R0801", "R0802", "R0803"]
    names := [String]{}
    loop code in sentries -> names.push(registry_field(registry, code, "name") ?? return Err(err))
    literals := services_literals(names)
    loop (index, code) in sentries {
        // A fault's first line is its heading: the row's label and name, then
        // its What.
        label: registry_label(registry, code) ?? return Err(err)
        loop field in ["what", "why", "fix"] {
            text: registry_field(registry, code, field) ?? return Err(err)
            shown: if field == "what" -> "{label}: {names[index]}: {text}" else -> text
            literals.push(MessageLiteral{name: "sentry_{code.lower()}_{field}", text: shown})
        }
    }
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet; owned E4 literals.\n"
    loop literal in literals {
        function: owned_text_function("services_msg_{literal.name}", literal.text) ?? return Err(err)
        source = "{source}{function}"
    }
    Ok(source)
}

// Heap-free runtime stop literals. Keep the active diagnostic registry as the
// source of row prose; emitted words use the audited stack-write OS leaf.

TRAP_TARGET_PATH: "Compiler/JetRuntime/Source/TrapMessages.jet"

TRAP_DEFECT_TARGET_PATH: "Compiler/JetRuntime/Source/TrapDefectMessages.jet"

ROUTES_PATH: "Compiler/JetIR/Source/RouteCarriers.jet"

DEBUG_PATH: "Compiler/JetFoundation/Source/Text/RustDebug.jet"

// The native TLS refusal is defined once, in the IR route table that reports it at
// compile time; the runtime's stop and String-error leaves use this projection.
native_tls_refusal: fn(routes: String) -> String GeneratorError! {
    marker: "\nir_tls_transport_message: fn() -> String Never! {{\n    "
    at: routes.find(marker)
    if at < 0 {
        return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    }
    rest: byte_slice(routes, at + byte_len(marker), byte_len(routes))
    literal: quoted_literal(rest) ?? return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    if !String.from_bytes_lossy(rest.bytes()[literal.spelling_len..<rest.bytes().len()]).starts_with("\n}}") {
        return Err(generator_fail("missing RouteCarriers.jet ir_tls_transport_message literal"))
    }
    if literal.value == "" {
        return Err(generator_fail("native TLS refusal must be printable ASCII for word projection"))
    }
    loop byte in literal.value.bytes() {
        code: Int{byte}
        if code < 32 || code > 126 {
            return Err(generator_fail("native TLS refusal must be printable ASCII for word projection"))
        }
    }
    Ok(literal.value)
}

// One writing function for `text`; ordinary stack-word rows also get the
// matching `trap_build_*` appender into an owned text builder. An ordinary
// literal longer than two words is one static text (`<name>_text`, which
// hand-written reports reuse) written in one call; host-defect rows are
// always stack words.
emit: fn(name: String, text: String, sink: String) -> String GeneratorError! {
    owned_name: "trap_build_{byte_tail(name, 5)}: fn(builder: I64)"
    if sink == "trap_write_word" && static_text_worthy(text) {
        literal: static_text(text) ?? return Err(err)
        text_function: fmt_block("", "{name}_text: fn() -> I64", "    {literal}\n")
        write_function: fmt_block("", "{name}: fn()", "    trap_write_static({name}_text())\n")
        build_function: fmt_block("", owned_name, "    jet_rt_string_builder_push(builder, {name}_text())\n")
        return Ok("{text_function}\n{write_function}\n{build_function}")
    }
    out := ""
    owned := ""
    loop word in text_words(text) {
        out = "{out}    {sink}(I64{{{word.value}}}, I64{{{word.count}}})\n"
        if sink == "trap_write_word" {
            owned = "{owned}    rt_text_push_word(builder, I64{{{word.value}}}, I64{{{word.count}}})\n"
        }
    }
    write_function: fmt_block("", "{name}: fn()", out)
    if sink == "trap_write_word" {
        return Ok("{write_function}\n{fmt_block("", owned_name, owned)}")
    }
    Ok(write_function)
}

// The canonical Rust Debug escaped-interval table, as numbers.
debug_intervals: fn(debug: String) -> [Int] GeneratorError! {
    open: debug.find("[Int]{{")
    if open < 0 -> return Err(generator_fail("missing Rust Debug scalar interval table"))
    rest: byte_slice(debug, open + byte_len("[Int]{{"), byte_len(debug))
    // The body runs to the first `}` followed by optional space and `}`.
    body_end := -1
    search := 0
    loop {
        close: byte_slice(rest, search, byte_len(rest)).find("}}")
        if close < 0 -> break
        at: search + close
        after: byte_slice(rest, at + 1, byte_len(rest)).trim_start()
        if after.starts_with("}}") {
            body_end = at
            break
        }
        search = at + 1
    }
    if body_end < 0 -> return Err(generator_fail("missing Rust Debug scalar interval table"))
    values := [Int]{}
    current := -1
    loop byte in byte_slice(rest, 0, body_end).bytes() {
        code: Int{byte}
        if code >= 48 && code <= 57 {
            current = if current < 0 -> code - 48 else -> current * 10 + code - 48
        } else if current >= 0 {
            values.push(current)
            current = -1
        }
    }
    if current >= 0 -> values.push(current)
    if values.len() % 2 != 0 -> return Err(generator_fail("invalid Rust Debug intervals"))
    loop index in 1..<values.len() {
        if values[index] < values[index - 1] {
            return Err(generator_fail("invalid Rust Debug intervals"))
        }
    }
    Ok(values)
}

TrapOutputs: struct {
    source: String,
    defects: String,
}

// Core library stops that carry a registered code (core.rt.__coded_stop,
// Trap.jet jet_rt_coded_stop): the caller renders the row's `what` after
// the row's `Stop: Name: ` head; the footer is the same row's Why/Fix,
// and the stop ends the program with its exit status. Codes are
// five-byte little-endian words.
// E2416 is the stop of an app's settings that did not decode (Core/Web);
// E3006 is the stop of a wait cycle that holds the main task (WaitCycle.jet);
// E3012 is the stop of a `#MaxDepth(n)` call past n (Depth.jet).
coded_stop_rows: fn() -> [CodedStop] Never! {
    [CodedStop]{
        CodedStop{code: "E2416", exit: "EXIT_CONFIG"},
        CodedStop{code: "E2804", exit: "EXIT_RUNTIME_PANIC"},
        CodedStop{code: "E2805", exit: "EXIT_RUNTIME_PANIC"},
        CodedStop{code: "E2808", exit: "EXIT_RUNTIME_PANIC"},
        CodedStop{code: "E2809", exit: "EXIT_RUNTIME_PANIC"},
        CodedStop{code: "E3006", exit: "EXIT_RUNTIME_PANIC"},
        CodedStop{code: "E3012", exit: "EXIT_RUNTIME_PANIC"},
    }
}

render_trap_messages: fn(registry: String, routes: String, debug: String) -> TrapOutputs GeneratorError! {
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet; do not hand-edit.\n// Process-static texts and little-endian UTF-8 word constants. No heap String,\n// allocation, mutable global, or numeric runtime is reached while writing these rows.\n\n"
    loop code in ["E3001", "E3010", "E3011", "E0128"] {
        name: registry_field(registry, code, "name") ?? return Err(err)
        why: registry_field(registry, code, "why") ?? return Err(err)
        fix: registry_field(registry, code, "fix") ?? return Err(err)
        source = "{source}// {code} Why: {why}\n// Fix: {fix}\n"
        footer: emit("trap_footer_{code.lower()}", " Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{name}\n", "trap_write_word") ?? return Err(err)
        source = "{source}{footer}\n"
    }
    // A failed `#Pre`/`#Post` clause (Trap.jet trap_contract_stop): the row's
    // Why quotes the stop's own message at `{msg}`, so it is written in two
    // pieces around that message.
    contract_name: registry_field(registry, "E3005", "name") ?? return Err(err)
    contract_why: registry_field(registry, "E3005", "why") ?? return Err(err)
    contract_fix: registry_field(registry, "E3005", "fix") ?? return Err(err)
    hole: contract_why.find("{{msg}}")
    if hole < 0 || after_hole(contract_why).find("{{msg}}") >= 0 {
        return Err(generator_fail("E3005.why must quote {{msg}} exactly once"))
    }
    source = "{source}// E3005 Why: {contract_why}\n// Fix: {contract_fix}\n"
    contract_head: emit("trap_footer_e3005_head", " Why: {before_hole(contract_why)}", "trap_write_word") ?? return Err(err)
    contract_tail: emit("trap_footer_e3005_tail", "{after_hole(contract_why)}\n Fix: {contract_fix}\nMore: jet-lang.dev/e/{contract_name}\n", "trap_write_word") ?? return Err(err)
    source = "{source}{contract_head}\n{contract_tail}\n"
    e3001_name: registry_field(registry, "E3001", "name") ?? return Err(err)
    e3010_name: registry_field(registry, "E3010", "name") ?? return Err(err)
    e3011_name: registry_field(registry, "E3011", "name") ?? return Err(err)
    e0128_name: registry_field(registry, "E0128", "name") ?? return Err(err)
    e3001_what: registry_field(registry, "E3001", "what") ?? return Err(err)
    e3010_what: registry_field(registry, "E3010", "what") ?? return Err(err)
    e0128_what: registry_field(registry, "E0128", "what") ?? return Err(err)
    layout_what: if e3001_what.find("{{msg}}") < 0 -> e3001_what else -> "{before_hole(e3001_what)}invalid box layout{after_hole(e3001_what)}"
    layout: emit("trap_invalid_layout_head", "Stop: {e3001_name}: {layout_what}\n  --> <core.prelude>:0\n", "trap_write_word") ?? return Err(err)
    source = "{source}{layout}"
    tls: native_tls_refusal(routes) ?? return Err(err)
    // A host stop whose code has no active runtime row is a Jet defect, not a
    // diagnostic: no row speaks for it, so it prints one `internal error:`
    // line with no Why, Fix or More. The code word sits between these two literals.
    loop code in ["E2805"] {
        stage: registry_field(registry, code, "stage") ?? return Err(err)
        if stage.contains("runtime") {
            return Err(generator_fail("{code} is an active runtime row; its stop renders the row, not the host form"))
        }
    }
    coded_stops: coded_stop_rows()
    registered := [String]{}
    branches := ""
    heads := ""
    exits := ""
    loop (index, stop) in coded_stops {
        code: stop.code
        if byte_len(code) != 5 || !code.starts_with("E") {
            return Err(generator_fail("{code} is not a five-byte diagnostic code"))
        }
        name: registry_field(registry, code, "name") ?? return Err(err)
        why: registry_field(registry, code, "why") ?? return Err(err)
        fix: registry_field(registry, code, "fix") ?? return Err(err)
        source = "{source}\n// {code} Why: {why}\n// Fix: {fix}\n"
        head: emit("trap_head_{code.lower()}", "Stop: {name}: ", "trap_write_word") ?? return Err(err)
        footer: emit("trap_footer_{code.lower()}", " Why: {why}\n Fix: {fix}\nMore: jet-lang.dev/e/{name}\n", "trap_write_word") ?? return Err(err)
        source = "{source}{head}\n{footer}"
        word: code_word(code)
        registered.push("code == I64{{{word}}}")
        if index != coded_stops.len() - 1 {
            branches = "{branches}        (code == I64{{{word}}}) -> trap_footer_{code.lower()}()\n"
            heads = "{heads}        (code == I64{{{word}}}) -> trap_head_{code.lower()}()\n"
        }
        if stop.exit != "EXIT_RUNTIME_PANIC" {
            exit: fmt_block("    ", "if (code == I64{{{word}}})", "        return {stop.exit}\n")
            exits = "{exits}{exit}"
        }
    }
    last_coded: coded_stops[coded_stops.len() - 1].code.lower()
    source = "{source}\ntrap_coded_registered: fn(code: I64) -> Bool {{\n    {registered.join(" || ")}\n}}\n"
    source = "{source}\ntrap_coded_head: fn(code: I64) {{\n    if {{\n{heads}        else -> trap_head_{last_coded}()\n    }}\n}}\n"
    source = "{source}\ntrap_coded_footer: fn(code: I64) {{\n    if {{\n{branches}        else -> trap_footer_{last_coded}()\n    }}\n}}\n"
    source = "{source}\ntrap_coded_exit: fn(code: I64) -> I64 {{\n{exits}    EXIT_RUNTIME_PANIC\n}}\n"
    literals: [MessageLiteral]{
        MessageLiteral{name: "header_panic", text: "Stop: {e3001_name}: {before_hole(e3001_what)}"},
        MessageLiteral{name: "header_numeric", text: "Stop: {e3010_name}: {before_hole(e3010_what)}"},
        MessageLiteral{name: "header_todo", text: "Stop: {e3011_name}: `"},
        MessageLiteral{name: "header_contract", text: "Stop: {contract_name}: "},
        MessageLiteral{name: "header_zip", text: "Stop: {e0128_name}: {before_hole(e0128_what)}"},
        MessageLiteral{name: "zip_end", text: "{after_hole(e0128_what)}\n"},
        MessageLiteral{name: "collections_end", text: "`\n  --> <core.collections>:0\n"},
        MessageLiteral{name: "sequence_count", text: "sequence count must be nonnegative"},
        MessageLiteral{name: "sequence_step", text: "step_by requires a positive step"},
        MessageLiteral{name: "sequence_chunks", text: "chunks requires a positive size"},
        MessageLiteral{name: "sequence_windows", text: "windows requires a positive size"},
        MessageLiteral{name: "cursor_step", text: "iterator loop stride must be positive"},
        MessageLiteral{name: "cursor_exhausted", text: "iterator loop value requested after exhaustion"},
        MessageLiteral{name: "location", text: "  --> "},
        MessageLiteral{name: "colon", text: ":"},
        MessageLiteral{name: "in_function", text: " in "},
        MessageLiteral{name: "newline", text: "\n"},
        MessageLiteral{name: "space", text: " "},
        MessageLiteral{name: "gutter_line", text: "|\n"},
        MessageLiteral{name: "gutter_source", text: " | "},
        MessageLiteral{name: "gutter_caret", text: "| "},
        MessageLiteral{name: "caret", text: "^"},
        MessageLiteral{name: "message_end", text: "`\n"},
        MessageLiteral{name: "prelude_end", text: "`\n  --> <core.prelude>:0\n"},
        MessageLiteral{name: "overflow", text: "This arithmetic overflows the value's type (the result is outside its range)"},
        MessageLiteral{name: "divide_zero", text: "divided by zero"},
        MessageLiteral{name: "native_index_range", text: "native Int argument exceeds host range"},
        MessageLiteral{name: "list_head", text: "the list has "},
        MessageLiteral{name: "list_item", text: " item"},
        MessageLiteral{name: "list_plural", text: "s"},
        MessageLiteral{name: "list_position", text: ", so position "},
        MessageLiteral{name: "list_end", text: " doesn't exist`\n  --> <core.prelude>:0\n"},
        // The reason's tail for a list position at the item count or below 0
        // (JetRuntime trap_list_bounds_reason); the E3010 row keeps its Why/Fix.
        MessageLiteral{name: "list_count_hint", text: "; positions stop one below the count, and xs.last() reads the last item"},
        MessageLiteral{name: "list_negative_hint", text: "; positions count up from 0, and xs.get(i) gives None outside the list"},
        // `bounds: report` (JetRuntime jet_rt_report_list_bounds): the failed
        // check's line, then its file and line; the program goes on.
        MessageLiteral{name: "report_list_head", text: "bounds report: the list has "},
        MessageLiteral{name: "report_list_at", text: " doesn't exist ("},
        MessageLiteral{name: "report_list_end", text: ")\n"},
        MessageLiteral{name: "unreachable", text: "internal error: entered unreachable code: "},
        MessageLiteral{name: "locals", text: "locals: "},
        MessageLiteral{name: "todo", text: "#Todo at "},
        MessageLiteral{name: "todo_expected", text: " — expected "},
        MessageLiteral{name: "expected", text: "expected: "},
        MessageLiteral{name: "got", text: ", got: "},
        MessageLiteral{name: "range_head", text: "can't "},
        MessageLiteral{name: "range_slice", text: "slice"},
        MessageLiteral{name: "range_view", text: "view"},
        MessageLiteral{name: "range_items", text: " items from "},
        MessageLiteral{name: "range_to", text: " to "},
        MessageLiteral{name: "range_open", text: " ("},
        MessageLiteral{name: "exclusive", text: "exclusive"},
        MessageLiteral{name: "inclusive", text: "inclusive"},
        MessageLiteral{name: "range_end", text: ")`\n"},
        MessageLiteral{name: "native_tls", text: tls},
        MessageLiteral{name: "inactive_row_head", text: "internal error: runtime stop `"},
        MessageLiteral{name: "inactive_row_tail", text: "` has no active runtime row, so Jet cannot report it; please report this as a Jet defect"},
    }
    loop literal in literals {
        function: emit("trap_msg_{literal.name}", literal.text, "trap_write_word") ?? return Err(err)
        source = "{source}\n{function}"
    }
    // Retype the canonical Debug interval table at generation time. Runtime
    // arithmetic stays fixed-width; only list indices cross the exact-Int seam.
    values: debug_intervals(debug) ?? return Err(err)
    source = "{source}\n// Canonical Text/RustDebug.jet intervals, retyped to machine words.\n"
    source = "{source}TRAP_DEBUG_RANGE_COUNT: #run {{ I64{{{values.len() /% 2}}} }}\n\n"
    words := [String]{}
    loop value in values -> words.push("    I64{{{value}}},\n")
    source = "{source}TRAP_DEBUG_RANGES: #run {{ [I64]{{\n{words.join("")}}} }}\n"
    // Both projections use the same canonical facts. Scoped private generation
    // validates the frozen ordinary bytes first; default generation remains the
    // canonical producer for both projections after the frozen gate is lifted.
    defects := "// Generated by Tools/Agent/RuntimeGenerators.jet; do not hand-edit.\n// NO-TLS host-defect rows: raw stack-word writes only; no capture,\n// String carrier, allocation, callback, mutable global, or numeric runtime.\n\n"
    defect_head: emit("trap_defect_unreachable_head", "internal error: entered unreachable code: ", "trap_write_word_raw") ?? return Err(err)
    defect_newline: emit("trap_defect_newline", "\n", "trap_write_word_raw") ?? return Err(err)
    defects = "{defects}{defect_head}\n{defect_newline}"
    Ok(TrapOutputs{source: source, defects: defects})
}

TrapWritePlan: struct {
    write_source: Bool,
    write_defects: Bool,
}

// What one run writes. The ordinary projection is frozen under
// --defects-only: any mismatch there fails before even the private rows are
// written. --check never writes. The default run is the canonical producer of
// both projections.
trap_messages_plan: fn(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> TrapWritePlan GeneratorError! {
    if defects_only && !source_current {
        return Err(generator_fail("TrapMessages.jet differs from canonical facts; frozen output was not written"))
    }
    if check {
        if !source_current {
            return Err(generator_fail("TrapMessages.jet is stale; run jet Tools/Agent/RuntimeGenerators.jet"))
        }
        if !defects_current {
            return Err(generator_fail("TrapDefectMessages.jet is stale; run jet Tools/Agent/RuntimeGenerators.jet"))
        }
        return Ok(TrapWritePlan{write_source: false, write_defects: false})
    }
    Ok(TrapWritePlan{write_source: !defects_only && !source_current, write_defects: !defects_current})
}

// The (word, count) lines of generated function `name` written through `sink`.
emitted_words: fn(source: String, name: String, sink: String) -> [String] Never! {
    words := [String]{}
    inside := false
    header: "{name}: fn() {{"
    loop line in source.split("\n") {
        // A body of one statement stays on the head's line.
        one_line: !inside && line.starts_with("{header} ") && line.ends_with(" }}")
        if !inside && line == header {
            inside = true
            next
        }
        if !inside && !one_line -> next
        if line == "}}" -> break
        trimmed: if one_line -> byte_slice(line, byte_len(header), byte_len(line) - 1).trim() else -> line.trim()
        if !trimmed.starts_with("{sink}(I64{{") -> return [String]{}
        words.push(byte_tail(trimmed, byte_len(sink)))
        if one_line -> break
    }
    words
}

plan_error: fn(check: Bool, defects_only: Bool, source_current: Bool, defects_current: Bool) -> String Never! {
    if trap_messages_plan(check, defects_only, source_current, defects_current) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the private defect rows are the ordinary unreachable prefix and newline words") {
    registry: files.read(REGISTRY_PATH) ?? panic("the registry did not read")
    routes: files.read(ROUTES_PATH) ?? panic("the lowering routes did not read")
    debug: files.read(DEBUG_PATH) ?? panic("the Debug table did not read")
    outputs: render_trap_messages(registry, routes, debug) ?? panic("the trap messages did not render: {err.message}")
    prefix: emitted_words(outputs.defects, "trap_defect_unreachable_head", "trap_write_word_raw")
    newline: emitted_words(outputs.defects, "trap_defect_newline", "trap_write_word_raw")
    // The ordinary unreachable prefix is one static text; its defect row is
    // the same bytes as stack words.
    expected_prefix: loop word in text_words("internal error: entered unreachable code: ") -> "(I64{{{word.value}}}, I64{{{word.count}}})"
    assert_eq(prefix, expected_prefix)
    assert(outputs.source.contains("trap_msg_unreachable: fn() {{ trap_write_static(trap_msg_unreachable_text()) }}"))
    assert_eq(newline, emitted_words(outputs.source, "trap_msg_newline", "trap_write_word"))
    // 42 bytes: five full words and a two-byte tail; the newline is one byte.
    counts: loop word in prefix -> word.split("I64{{").to_list()[2]
    assert_eq(counts, ["8}})", "8}})", "8}})", "8}})", "8}})", "2}})"])
    assert_eq(newline.len(), 1)
    assert(newline[0].ends_with(", I64{{1}})"))
    assert_eq(outputs.defects.split(": fn(").to_list().len() - 1, 2)
}

#Test("check never writes; the frozen gate fails before any write; the default produces both") {
    current: trap_messages_plan(true, false, true, true) ?? panic("current outputs fail the check")
    assert(!current.write_source && !current.write_defects)
    assert(plan_error(true, false, false, true).contains("TrapMessages.jet is stale"))
    assert(plan_error(true, true, true, false).contains("TrapDefectMessages.jet is stale"))
    assert(plan_error(false, true, false, false).contains("frozen output was not written"))
    assert(plan_error(true, true, false, true).contains("frozen output was not written"))
    scoped: trap_messages_plan(false, true, true, false) ?? panic("scoped generation refused")
    assert(!scoped.write_source && scoped.write_defects)
    canonical: trap_messages_plan(false, false, false, false) ?? panic("default generation refused")
    assert(canonical.write_source && canonical.write_defects)
    unchanged: trap_messages_plan(false, false, true, true) ?? panic("default generation refused")
    assert(!unchanged.write_source && !unchanged.write_defects)
}

// Compiler/JetRuntime/lifecycle.list orders the constructor/destructor hooks
// the runtime sources mark with a `// runtime-init: N [when guard,...]` or
// `// runtime-fini: N [when guard,...]` line directly above an `#Export(c)`
// function. The export set itself is exactly the sources' #Export(c)
// functions; these rows only order hooks and name their guards.

LIFECYCLE_TARGET_PATH: "Compiler/JetRuntime/lifecycle.list"

RUNTIME_SOURCES_PATH: "Compiler/JetRuntime/sources.list"

EXPORT_MARK: "#Export(c)"

MAX_LIFECYCLE_PRIORITY: 65535

RuntimeSource: struct {
    path: String,
    text: String,
}

// One #Export(c) function; `lifecycle` is `init N`, `fini N` or empty.
RuntimeExport: struct {
    name: String,
    lifecycle: String,
}

ParsedExports: struct {
    exports: [RuntimeExport],
    problems: [String],
}

is_space_byte: fn(code: Int) -> Bool Never! { code == 32 || (code >= 9 && code <= 13) }

is_name_start_byte: fn(code: Int) -> Bool Never! {
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

is_name_byte: fn(code: Int) -> Bool Never! {
    is_name_start_byte(code) || (code >= 48 && code <= 57)
}

is_digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// Whether `word`'s bytes start at byte `at` of `bytes`.
bytes_at: fn(bytes: [U8], at: Int, word: String) -> Bool Never! {
    expected: word.bytes()
    if at + expected.len() > bytes.len() -> return false
    loop index in 0..<expected.len() {
        if (Int{bytes[at + index]}) != (Int{expected[index]}) -> return false
    }
    true
}

skip_spaces: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at
    loop end < bytes.len() && is_space_byte(Int{bytes[end]}) -> end += 1
    end
}

// The name, the text up to the body's `{` and the offset after that `{` of the
// `#Export(c) name: fn` declaration starting at byte `start`, or None when
// the line is not one (a `}` before the body's `{` also means it is not a
// declaration head).
ExportHead: struct {
    name: String,
    signature: String,
    body: Int,
}

export_head: fn(source: String, bytes: [U8], start: Int) -> ExportHead? Never! {
    at := start + byte_len(EXPORT_MARK)
    spaced := skip_spaces(bytes, at)
    if spaced == at -> return None
    at = spaced
    if bytes_at(bytes, at, "pub") && is_space_byte(code_at(bytes, at + 3)) {
        at = skip_spaces(bytes, at + 3)
    }
    if at >= bytes.len() || !is_name_start_byte(Int{bytes[at]}) -> return None
    name_start: at
    loop at < bytes.len() && is_name_byte(Int{bytes[at]}) -> at += 1
    name: byte_slice(source, name_start, at)
    if code_at(bytes, at) != 58 -> return None
    at = skip_spaces(bytes, at + 1)
    if !bytes_at(bytes, at, "fn") -> return None
    at = skip_spaces(bytes, at + 2)
    signature_start: at
    loop at < bytes.len() {
        code: Int{bytes[at]}
        if code == 123 {
            return Val(ExportHead{name: name, signature: byte_slice(source, signature_start, at), body: at + 1})
        }
        if code == 125 -> return None
        at += 1
    }
    None
}

// The hook a `// runtime-init: N [when guard,...]` / `// runtime-fini: N
// [when guard,...]` line names; None for any other line. `guards` is the
// comma-separated module storage list, or empty.
LifecycleHook: struct {
    kind: String,
    priority: Int,
    guards: String,
}

lifecycle_hook: fn(line: String) -> LifecycleHook? Never! {
    kind := ""
    if line.starts_with("// runtime-init: ") -> kind = "init" else if line.starts_with("// runtime-fini: ") {
        kind = "fini"
    } else { return None }
    fields: byte_tail(line, byte_len("// runtime-init: ")).split(" ").to_list()
    if fields.len() != 1 && (fields.len() != 3 || fields[1] != "when") -> return None
    digits: fields[0]
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if !is_digit_byte(Int{byte}) -> return None
    }
    guards: if fields.len() == 3 -> fields[2] else -> ""
    if fields.len() == 3 {
        loop guard in guards.split(",").to_list() {
            if guard == "" -> return None
            bytes: guard.bytes()
            loop at in 0..<bytes.len() {
                code: Int{bytes[at]}
                word: code == 95 || (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
                if !word && (at == 0 || !is_digit_byte(code)) -> return None
            }
        }
    }
    if Int.parse(digits) == {
        .Ok(priority) -> return Val(LifecycleHook{kind: kind, priority: priority, guards: guards})
        .Err(_) -> { return None }
    }
}

// Reviewed parameter-only widening: these exports take a narrower C integer
// parameter as an I64 word and must mask it to its low bits in their own body.
MaskedParameter: struct {
    symbol: String,
    index: Int,
    bits: Int,
    mask: Int,
}

masked_word_parameters: fn() -> [MaskedParameter] Never! {
    [MaskedParameter]{
        MaskedParameter{symbol: "jet_rt_record_new_jet_resolve_error", index: 1, bits: 8, mask: 255},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 1, bits: 16, mask: 65535},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 2, bits: 32, mask: 4294967295},
        MaskedParameter{symbol: "jet_net_raw_socket_from_parts", index: 3, bits: 32, mask: 4294967295},
        MaskedParameter{symbol: "jet_net_raw_resolve_ordered", index: 1, bits: 16, mask: 65535},
    }
}

// The trimmed, non-empty comma-separated items between a signature's `(` and
// its last `)`.
signature_parameters: fn(signature: String) -> [String] Never! {
    bytes: signature.bytes()
    close := bytes.len() - 1
    loop close > 0 && (Int{bytes[close]}) != 41 -> close -= 1
    items := [String]{}
    if close <= 0 -> return items
    loop item in byte_slice(signature, 1, close).split(",") {
        trimmed: item.trim()
        if trimmed != "" -> items.push(trimmed.copy())
    }
    items
}

// The name of an `name: I64` parameter item, or "" for any other item.
i64_parameter_name: fn(item: String) -> String Never! {
    bytes: item.bytes()
    if bytes.len() == 0 || !is_name_start_byte(Int{bytes[0]}) -> return ""
    at := 0
    loop at < bytes.len() && is_name_byte(Int{bytes[at]}) -> at += 1
    name: byte_slice(item, 0, at)
    at = skip_spaces(bytes, at)
    if code_at(bytes, at) != 58 -> return ""
    at = skip_spaces(bytes, at + 1)
    if byte_tail(item, at) != "I64" -> return ""
    name
}

// Whether `code[from..<to]` holds `name & I64{mask}` (any spacing) with
// `name` starting a word.
has_mask: fn(code: [U8], from: Int, to: Int, name: String, mask: Int) -> Bool Never! {
    words: [String]{"&", "I64", "{{", "{mask}", "}}"}
    loop start in from..<to {
        if start > from && is_name_byte(Int{code[start - 1]}) -> next
        if !bytes_at(code, start, name) -> next
        at := start + byte_len(name)
        matched := true
        loop word in words {
            at = skip_spaces(code, at)
            if at + byte_len(word) > to || !bytes_at(code, at, word) {
                matched = false
                break
            }
            at += byte_len(word)
        }
        if matched -> return true
    }
    false
}

// The reviewed-mask problems of export `head` in `source`: each listed I64
// parameter must be masked in the export's body (comments and literals are not
// evidence).
masked_parameter_problems: fn(source: String, head: ExportHead, path: String) -> [String] Never! {
    problems := [String]{}
    rows := [MaskedParameter]{}
    loop row in masked_word_parameters() {
        if row.symbol == head.name -> rows.push(row)
    }
    if rows.len() == 0 -> return problems
    code: if code_only(source) == {
        .Ok(text) -> text.bytes()
        .Err(error) -> {
            problems.push("{path}: {error.message}")
            return problems
        }
    }
    body_end: group_end(code, head.body, code.len(), 123, 125)
    if body_end < 0 {
        problems.push("{path}: unterminated masked export {head.name}")
        return problems
    }
    parameters: signature_parameters(head.signature.trim())
    loop row in rows {
        if row.index >= parameters.len() -> next
        name: i64_parameter_name(parameters[row.index])
        if name == "" -> next
        if !has_mask(code, head.body, body_end, name, row.mask) {
            problems.push("{path}: {head.name} parameter {row.index} requires the reviewed low-{row.bits}-bit mask")
        }
    }
    problems
}

// Every `#Export(c)` function that starts a line of `source`, with the hook
// marked on the line above it.
runtime_exports: fn(source: String, path: String) -> ParsedExports Never! {
    bytes: source.bytes()
    exports := [RuntimeExport]{}
    problems := [String]{}
    previous_line := -1
    line_start := 0
    loop line_start <= bytes.len() {
        line_end := line_start
        loop line_end < bytes.len() && (Int{bytes[line_end]}) != 10 -> line_end += 1
        if bytes_at(bytes, line_start, EXPORT_MARK) {
            if export_head(source, bytes, line_start) == {
                .Val(head) -> {
                    lifecycle := ""
                    if previous_line >= 0 {
                        if lifecycle_hook(byte_slice(source, previous_line, line_start - 1)) == {
                            .Val(hook) -> {
                                if hook.priority > MAX_LIFECYCLE_PRIORITY {
                                    problems.push("{path}: lifecycle priority exceeds {MAX_LIFECYCLE_PRIORITY}")
                                }
                                lifecycle = if hook.guards == "" -> "{hook.kind} {hook.priority}" else -> "{hook.kind} {hook.priority} {hook.guards}"
                            }
                            .None -> {}
                        }
                    }
                    signature: head.signature.trim()
                    if !signature.starts_with("(") || !signature.contains(")") {
                        problems.push("unparsed runtime #Export(c) {head.name} signature in {path}")
                    }
                    loop problem in masked_parameter_problems(source, head, path) {
                        problems.push(problem)
                    }
                    exports.push(RuntimeExport{name: head.name, lifecycle: lifecycle})
                }
                .None -> {}
            }
        }
        previous_line = line_start
        line_start = line_end + 1
    }
    ParsedExports{exports: exports, problems: problems}
}

// One #Export(c) function of a runtime source set and the file declaring it.
PlacedExport: struct {
    name: String,
    path: String,
    lifecycle: String,
}

// Every #Export(c) function of `sources`, in source order; a duplicate, a bad
// declaration and an empty set are refused, every one at once.
placed_exports: fn(sources: [RuntimeSource]) -> [PlacedExport] GeneratorError! {
    problems := [String]{}
    names := [String]{}
    placed := [PlacedExport]{}
    loop source in sources {
        parsed: runtime_exports(source.text, source.path)
        loop problem in parsed.problems -> problems.push(problem)
        loop export in parsed.exports {
            if names.contains(export.name) {
                problems.push("duplicate runtime #Export(c) {export.name}")
                next
            }
            names.push(export.name.copy())  // copy: the row keeps the name too
            placed.push(PlacedExport{name: export.name, path: source.path.copy(), lifecycle: export.lifecycle})  // copy: one row per export of the source
        }
    }
    if names.len() == 0 -> problems.push("empty runtime #Export(c) declarations")
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    placed
}

// lifecycle.list for the given runtime sources: one `symbol init|fini N
// [guards]` row per hook, in symbol order.
lifecycle_list: fn(sources: [RuntimeSource]) -> String GeneratorError! {
    placed: placed_exports(sources) ?? return Err(err)
    rows := [String]{}
    loop export in placed {
        if export.lifecycle != "" -> rows.push("{export.name} {export.lifecycle}")
    }
    rows.sort()
    lines := [String]{
        "# Runtime object lifecycle hooks: <#Export(c) symbol> init|fini <priority 0..65535> [<guard storage>,...].",
        "# Lower init priorities run first (.init_array); fini rows run at exit (.fini_array).",
        "# A guarded hook runs exactly when the program links one of its guard module storages.",
        "# Rows only order hooks; the export set is exactly the sources' #Export(c) functions.",
        "# Generated by Tools/Agent/RuntimeGenerators.jet from `// runtime-init|fini: N [when guard,...]` comments.",
    }
    loop row in rows -> lines.push(row)
    Ok("{lines.join("\n")}\n")
}

// The runtime sources sources.list names, in its order. The manifest and the
// source directory must agree: a Source/*.jet the manifest omits never reaches
// the runtime object, so its exports, witnesses and route rows rot unseen.
read_runtime_sources: fn() -[FS]> [RuntimeSource] GeneratorError! {
    listing: files.read(RUNTIME_SOURCES_PATH) ?? return Err(generator_fail("cannot read {RUNTIME_SOURCES_PATH}: {err}"))
    listed: files.list_dir(RUNTIME_SOURCE_DIRECTORY) ?? return Err(generator_fail("cannot list {RUNTIME_SOURCE_DIRECTORY}: {err}"))
    names := [String]{}
    loop entry in listed {
        if entry.name.ends_with(".jet") -> names.push(entry.name)
    }
    sources := [RuntimeSource]{}
    problems := unlisted_runtime_sources(listing, names)
    loop raw in listing.split("\n") {
        path: raw.trim()
        if path == "" || path.starts_with("#") -> next
        if files.read(path) == {
            .Ok(text) -> { sources.push(RuntimeSource{path: path.copy(), text: text}) }
            .Err(error) -> {
                problems.push("{RUNTIME_SOURCES_PATH} names {path}, which cannot be read: {error}")
            }
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    Ok(sources)
}

// The runtime source files (Source/*.jet names) no sources.list line names, as
// one problem each in name order.
unlisted_runtime_sources: fn(listing: String, names: [String]) -> [String] Never! {
    lines := [String]{}
    loop raw in listing.split("\n") -> lines.push(raw.trim())
    sorted := names.copy()
    sorted.sort()
    problems := [String]{}
    loop name in sorted {
        path: "{RUNTIME_SOURCE_DIRECTORY}/{name}"
        if !lines.contains(path) {
            problems.push("{path} is not in {RUNTIME_SOURCES_PATH}; list it or delete it")
        }
    }
    problems
}

render_lifecycle_list: fn() -[FS]> String GeneratorError! {
    sources: read_runtime_sources() ?? return Err(err)
    lifecycle_list(sources)
}

#Test("lifecycle rows come from the hook line directly above an export") {
    source: "// runtime-init: 04\n#Export(c) b_start: fn() {{\n}}\n// runtime-fini: 2 when a_root,a_key\n#Export(c)\na_stop: fn(handle: I64) -> Unit {{\n}}\n#Export(c) plain: fn(x: I64) -> I64 {{ x }}\n// runtime-init: 1\n\n#Export(c) spaced: fn() {{}}\n#Export(c) closed: fn }} {{\n"
    parsed: runtime_exports(source, "Fixture.jet")
    assert_eq(parsed.problems.len(), 0)
    assert_eq(parsed.exports.len(), 4)
    assert_eq(parsed.exports[0].lifecycle, "init 4")
    assert_eq(parsed.exports[1].name, "a_stop")
    assert_eq(parsed.exports[1].lifecycle, "fini 2 a_root,a_key")
    assert_eq(parsed.exports[3].lifecycle, "")
    assert(lifecycle_hook("// runtime-init: 3 when 9bad") == None)
    assert(lifecycle_hook("// runtime-init: 3 when a,,b") == None)
    assert(lifecycle_hook("// runtime-init: 3 a_root") == None)
    if lifecycle_list([RuntimeSource]{RuntimeSource{path: "Fixture.jet", text: source}}) == {
        .Ok(text) -> {
            expected: "# Runtime object lifecycle hooks: <#Export(c) symbol> init|fini <priority 0..65535> [<guard storage>,...].\n# Lower init priorities run first (.init_array); fini rows run at exit (.fini_array).\n# A guarded hook runs exactly when the program links one of its guard module storages.\n# Rows only order hooks; the export set is exactly the sources' #Export(c) functions.\n# Generated by Tools/Agent/RuntimeGenerators.jet from `// runtime-init|fini: N [when guard,...]` comments.\na_stop fini 2 a_root,a_key\nb_start init 4\n"
            assert_eq(text, expected)
        }
        .Err(error) -> assert_eq(error.message, "")
    }
}

#Test("a reviewed masked parameter needs its low-bit mask in the export body") {
    masked: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    port &  I64{{ 65535 }}\n}}\n"
    assert_eq(runtime_exports(masked, "M.jet").problems.len(), 0)
    commented: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    // port & I64{{65535}}\n    sport & I64{{65535}}\n}}\n"
    assert_eq(runtime_exports(commented, "M.jet").problems.join("|"), "M.jet: jet_net_raw_resolve_ordered parameter 1 requires the reviewed low-16-bit mask")
    narrow: "#Export(c) jet_rt_record_new_jet_resolve_error: fn(kind: I64, flag: U8) -> I64 {{ kind }}\n"
    assert_eq(runtime_exports(narrow, "M.jet").problems.len(), 0)
    unmasked: "#Export(c) jet_rt_record_new_jet_resolve_error: fn(kind: I64, flag: I64) -> I64 {{\n    // flag & I64{{255}}\n    flag\n}}\n"
    assert_eq(runtime_exports(unmasked, "M.jet").problems.join("|"), "M.jet: jet_rt_record_new_jet_resolve_error parameter 1 requires the reviewed low-8-bit mask")
    open: "#Export(c) jet_net_raw_resolve_ordered: fn(host: I64, port: I64) -> I64 {{\n    port & I64{{65535}}\n"
    assert_eq(runtime_exports(open, "M.jet").problems.join("|"), "M.jet: unterminated masked export jet_net_raw_resolve_ordered")
}

// The quoted names after each `marker` in `text`.
quoted_after: fn(text: String, marker: String) -> [String] Never! {
    pieces: text.split(marker).to_list()
    names := [String]{}
    loop at in 1..<pieces.len() -> names.push(pieces[at].partition("\"").head.copy())
    names
}

// Record Lists cross every route as handle buffers (the IR's route calls),
// whatever the provider's ownership. The census freezes the routes whose
// carriers hold a List of a schema record, so a new Jet provider returning or
// reading one is reviewed against that contract (a provider handing back
// inline rows surfaces as a pointer-sized allocation in the first
// `entry.field` read), and keeps the native witness that reads a field of
// `files.list_dir`'s result.
#Test("a route carrying a List of schema records is a reviewed handle-buffer route") {
    path: "Compiler/JetIR/Source/RuntimeRoutes.jet"
    routes: files.read(path) ?? panic("{path} did not read: {err}")
    schemas: quoted_after(routes, "IRRecordSchema{{jet_name: \"")
    found := [String]{}
    loop line in routes.lines() {
        symbols: quoted_after(line, "IRRoute{{symbol: \"")
        if symbols.len() != 1 -> next
        loop name in quoted_after(line, "List{{elem: IRRouteCarrier.Handle{{name: \"") {
            if schemas.contains(name) && !found.contains(symbols[0]) {
                found.push(symbols[0].copy())  // copy: `symbols` keeps its row
            }
        }
    }
    found.sort()
    // Seed adapters always exchanged handle buffers; the Jet-owned rows
    // (jet_dyn_field, jet_rt_codec_*, jet_std_fs_list_dir_raw) build or read
    // the same shape.
    reviewed: [String]{
        "jet_binary_pattern_match",
        "jet_dyn_at",
        "jet_dyn_bool",
        "jet_dyn_field",
        "jet_dyn_float",
        "jet_dyn_int",
        "jet_dyn_text",
        "jet_net_dns_srv",
        "jet_net_dns_srv_at_lookup",
        "jet_net_dns_srv_lookup",
        "jet_ring_log_debug_fields",
        "jet_ring_log_error_fields",
        "jet_ring_log_info_fields",
        "jet_ring_log_warn_fields",
        "jet_rt_codec_decode_bool",
        "jet_rt_codec_decode_char",
        "jet_rt_codec_decode_float",
        "jet_rt_codec_decode_i16",
        "jet_rt_codec_decode_i32",
        "jet_rt_codec_decode_i64",
        "jet_rt_codec_decode_i8",
        "jet_rt_codec_decode_int",
        "jet_rt_codec_decode_string",
        "jet_rt_codec_decode_u16",
        "jet_rt_codec_decode_u32",
        "jet_rt_codec_decode_u64",
        "jet_rt_codec_decode_u8",
        "jet_rt_codec_parse_json",
        "jet_rt_codec_parse_toml",
        "jet_rt_codec_parse_yaml",
        "jet_rt_codec_under",
        "jet_std_fs_list_dir_raw",
        "jet_text_pattern_match",
    }
    expected := [String]{}
    loop symbol in reviewed {
        if routes.contains("IRRoute{{symbol: \"{symbol}\"") -> expected.push(symbol.copy())  // copy: `reviewed` keeps its rows
    }
    expected.sort()
    assert_eq(found, expected)
}

#Test("every runtime source file is in the manifest") {
    listing: "# comment\nCompiler/JetRuntime/Source/A.jet\n  Compiler/JetRuntime/Source/B.jet  \nCompiler/JetBackend/Source/Shared.jet\n"
    assert_eq(unlisted_runtime_sources(listing, [String]{"B.jet", "A.jet"}).len(), 0)
    found: unlisted_runtime_sources(listing, [String]{"Z.jet", "A.jet", "Orphan.jet", "B.jet"})
    assert_eq(found.join("|"), "Compiler/JetRuntime/Source/Orphan.jet is not in Compiler/JetRuntime/sources.list; list it or delete it|Compiler/JetRuntime/Source/Z.jet is not in Compiler/JetRuntime/sources.list; list it or delete it")
}

#Test("lifecycle rows report every bad export at once") {
    source: "// runtime-init: 70000\n#Export(c) big: fn() {{}}\n#Export(c) bare: fn {{}}\n#Export(c) big: fn() {{}}\n"
    if lifecycle_list([RuntimeSource]{RuntimeSource{path: "F.jet", text: source}}) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> {
            expected: "F.jet: lifecycle priority exceeds 65535\nunparsed runtime #Export(c) bare signature in F.jet\nduplicate runtime #Export(c) big"
            assert_eq(error.message, expected)
        }
    }
}

// The compiler's allocation-free Unicode 17 Alphabetic / Numeric decisions,
// reproduced from checksum-pinned UCD inputs. Frozen range hashes keep the
// exact parity oracle of the former table. Each output is a static range
// table over the merged ranges, searched by JetRuntime Unicode.jet
// unicode_table_find.

UCD_DIRECTORY: "Tests/Data/Unicode/Ucd"

NEEDED_TEXT_DIRECTORY: "Compiler/JetRuntime/Source"

UNICODE_DATA_SHA256: "2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"

DERIVED_CORE_SHA256: "24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"

ALPHABETIC_RANGES_SHA256: "7de9ffd68b766619ca4c145a53801b407db2cdc618802232f5ceaf9871df8d73"

NUMERIC_RANGES_SHA256: "7cf73db1c4a4a841517b6020051330dbedd6031a76bcd42a7096e0716838b8d4"

MAX_SCALAR: 1114111

// An inclusive scalar range.
TextRange: struct {
    lo: Int,
    hi: Int,
}

hex_digit_value: fn(code: Int) -> Int Never! {
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 65 && code <= 70 -> code - 55
        code >= 97 && code <= 102 -> code - 87
        else -> 0 - 1
    }
}

// The value of a hexadecimal scalar spelling, or None.
parse_hex: fn(text: String) -> Int? Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return None
    value := 0
    loop byte in bytes {
        digit: hex_digit_value(Int{byte})
        if digit < 0 -> return None
        value = value * 16 + digit
    }
    Val(value)
}

upper_hex: fn(value: Int) -> String Never! {
    digits: "0123456789ABCDEF"
    if value == 0 -> return "0"
    out := ""
    rest := value
    loop rest > 0 {
        digit: rest % 16
        out = "{byte_slice(digits, digit, digit + 1)}{out}"
        rest = rest /% 16
    }
    out
}

pinned_ucd: fn(name: String, sha256: String) -[FS]> String GeneratorError! {
    path: "{UCD_DIRECTORY}/{name}"
    text: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
    if crypto.sha256(text.bytes()).hex() != sha256 {
        return Err(generator_fail("UCD checksum mismatch: {name}"))
    }
    Ok(text)
}

// The text before the first `separator` of `text` (all of it when absent).
field_before: fn(text: String, separator: String) -> String Never! {
    if text.split_once(separator) == {
        .Val(parts) -> parts.before
        .None -> text
    }
}

// The text after the first `separator` of `text`, or None when absent.
field_after: fn(text: String, separator: String) -> String? Never! {
    if text.split_once(separator) == {
        .Val(parts) -> Val(parts.after)
        .None -> None
    }
}

// `lo..hi ; Alphabetic # …` rows of DerivedCoreProperties.txt.
alphabetic_ranges: fn(derived: String) -> [TextRange] GeneratorError! {
    rows := [TextRange]{}
    loop raw in derived.split("\n") {
        data: field_before(raw, "#")
        rest: field_after(data, ";") ?? next
        if field_before(rest, ";").trim() != "Alphabetic" -> next
        extent: field_before(data, ";").trim()
        lo: parse_hex(field_before(extent, "..")) ?? return Err(generator_fail("malformed Alphabetic row: {raw}"))
        hi_text: field_after(extent, "..") ?? field_before(extent, "..")
        hi: parse_hex(hi_text) ?? return Err(generator_fail("malformed Alphabetic row: {raw}"))
        rows.push(TextRange{lo: lo, hi: hi})
    }
    Ok(rows)
}

is_numeric_category: fn(category: String) -> Bool Never! {
    category == "Nd" || category == "Nl" || category == "No"
}

// Nd/Nl/No scalars of UnicodeData.txt, with `<…, First>`/`<…, Last>` pairs as ranges.
numeric_ranges: fn(data: String) -> [TextRange] GeneratorError! {
    rows := [TextRange]{}
    pending_lo := -1
    pending_category := ""
    loop raw in data.split("\n") {
        if raw == "" -> next
        after_code: field_after(raw, ";") ?? return Err(generator_fail("malformed UCD row: {raw}"))
        after_name: field_after(after_code, ";") ?? return Err(generator_fail("malformed UCD row: {raw}"))
        cp: parse_hex(field_before(raw, ";")) ?? return Err(generator_fail("malformed UCD row: {raw}"))
        name: field_before(after_code, ";")
        category: field_before(after_name, ";")
        if name.ends_with(", First>") {
            pending_lo = cp
            pending_category = category
            next
        }
        if name.ends_with(", Last>") {
            if pending_lo < 0 || pending_category != category {
                return Err(generator_fail("malformed UCD range: {raw}"))
            }
            if is_numeric_category(category) -> rows.push(TextRange{lo: pending_lo, hi: cp})
            pending_lo = -1
            next
        }
        if is_numeric_category(category) -> rows.push(TextRange{lo: cp, hi: cp})
    }
    if pending_lo >= 0 -> return Err(generator_fail("unterminated UCD range"))
    Ok(rows)
}

// Sorted by start (stable), overlapping or adjacent ranges merged, and the
// serialization checked against the frozen hash.
merged_ranges: fn(name: String, input: [TextRange], frozen: String) -> [TextRange] GeneratorError! {
    sorted := input
    sorted.sort_by(fn(left: TextRange, right: TextRange) { left.lo <=> right.lo })
    rows := [TextRange]{}
    loop range in sorted {
        if range.lo > range.hi || range.hi > MAX_SCALAR {
            return Err(generator_fail("invalid UCD range {name}"))
        }
        last: rows.len() - 1
        if last >= 0 && range.lo <= rows[last].hi + 1 {
            if range.hi > rows[last].hi -> rows[last] = TextRange{lo: rows[last].lo, hi: range.hi}
        } else { rows.push(range) }
    }
    serialized := [String]{}
    loop range in rows -> serialized.push("(0x{upper_hex(range.lo)},0x{upper_hex(range.hi)})")
    digest: crypto.sha256(serialized.join(",").bytes()).hex()
    if digest != frozen -> return Err(generator_fail("frozen range parity mismatch: {name}"))
    Ok(rows)
}

// The digit byte of six-bit digit `digit`: 35 + d below 57 and 36 + d from
// 57, so a table holds no quote, backslash or brace (UnicodeTables.jet
// table_digits writes the same digits).
range_digit: fn(digit: Int) -> U8 Never! { U8{if digit < 57 -> 35 + digit else -> 36 + digit} }

// The ranges as unicode_table_find records: lo and hi as four six-bit digits
// each, low digit first.
range_records: fn(rows: [TextRange]) -> String Never! {
    out := [U8]{}
    loop row in rows {
        loop value in ([Int]{row.lo, row.hi}) {
            loop at in 0..<4 -> out.push(range_digit((value >> (6 * at)) & 63))
        }
    }
    String.from_bytes_lossy(out)
}

// The dense ASCII block: one digit per scalar below 128, 1 inside a range.
range_ascii: fn(rows: [TextRange]) -> String Never! {
    out := [U8]{}
    loop cp in 0..<128 {
        inside := 0
        loop row in rows {
            if row.lo <= cp && cp <= row.hi -> inside = 1
        }
        out.push(range_digit(inside))
    }
    String.from_bytes_lossy(out)
}

needed_text: fn(digest_name: String, frozen: String, symbol: String, rows: [TextRange]) -> String Never! {
    ascii: fmt_block("    ", "if (cp < I64{{128}})", "        return unicode_table_dense(rt_static_text(\"{range_ascii(rows)}\"), cp, I64{{1}}) != I64{{0}}\n")
    "// Generated by Tools/Agent/RuntimeGenerators.jet; Unicode 17.0.0.\n// Frozen UNICODE_{digest_name} ranges SHA256 {frozen}; reproducible from pinned UCD.\n// Static range table: no allocation, Core calls, or locale dependency.\n{symbol}: fn(cp: I64) -> Bool Never! {{\n{ascii}    unicode_table_find(rt_static_text(\"{range_records(rows)}\"), I64{{{rows.len()}}}, I64{{4}}, I64{{0}}, cp) >= I64{{0}}\n}}\n"
}

// Every CompilerNeededText*.jet output for the two properties.
render_needed_text: fn(alphabetic_input: [TextRange], numeric_input: [TextRange]) -> [GeneratedFile] GeneratorError! {
    alphabetic: merged_ranges("ALPHABETIC", alphabetic_input, ALPHABETIC_RANGES_SHA256) ?? return Err(err)
    numeric: merged_ranges("NUMERIC", numeric_input, NUMERIC_RANGES_SHA256) ?? return Err(err)
    Ok(
        [GeneratedFile]{
            GeneratedFile{path: "{NEEDED_TEXT_DIRECTORY}/CompilerNeededTextAlphabetic.jet", text: needed_text("ALPHABETIC", ALPHABETIC_RANGES_SHA256, "compiler_text_alphabetic", alphabetic)},
            GeneratedFile{path: "{NEEDED_TEXT_DIRECTORY}/CompilerNeededTextNumeric.jet", text: needed_text("NUMERIC", NUMERIC_RANGES_SHA256, "compiler_text_numeric", numeric)},
        },
    )
}

read_needed_text: fn() -[FS]> [GeneratedFile] GeneratorError! {
    derived: pinned_ucd("DerivedCoreProperties.txt", DERIVED_CORE_SHA256) ?? return Err(err)
    data: pinned_ucd("UnicodeData.txt", UNICODE_DATA_SHA256) ?? return Err(err)
    alphabetic: alphabetic_ranges(derived) ?? return Err(err)
    numeric: numeric_ranges(data) ?? return Err(err)
    render_needed_text(alphabetic, numeric)
}

#Test("range records write lo and hi as four six-bit digits, low digit first, that avoid quotes, backslashes and braces") {
    rows: [TextRange]{TextRange{lo: 48, hi: 57}, TextRange{lo: 65, hi: 4095}}
    assert_eq(range_records(rows), "S###]###$$##cc##")
    assert_eq(range_records([TextRange]{}), "")
}

#Test("UCD rows parse into ranges and First/Last pairs") {
    data: "0030;DIGIT ZERO;Nd;0;EN;;0;0;0;N;;;;;\n0041;LATIN CAPITAL LETTER A;Lu;0;L;;;;;N;;;;0061;\n3400;<CJK Ideograph Extension A, First>;Lo;0;L;;;;;N;;;;;\n4DBF;<CJK Ideograph Extension A, Last>;Lo;0;L;;;;;N;;;;;\n2160;ROMAN NUMERAL ONE;Nl;0;L;<compat> 0049;;;1;N;;;;2170;\n"
    numeric: numeric_ranges(data) ?? panic("numeric rows did not parse: {err.message}")
    assert_eq(numeric.len(), 2)
    assert_eq(numeric[1].lo, 8544)
    derived: "0041..005A    ; Alphabetic # L&  [26] LATIN CAPITAL LETTER A..Z\n00AA          ; Alphabetic # Lo       FEMININE ORDINAL INDICATOR\n0030..0039    ; ID_Continue # Nd [10]\n"
    alphabetic: alphabetic_ranges(derived) ?? panic("alphabetic rows did not parse: {err.message}")
    assert_eq(alphabetic.len(), 2)
    assert_eq(alphabetic[0].hi, 90)
    assert_eq(alphabetic[1].lo, 170)
    assert_eq(upper_hex(1114111), "10FFFF")
}

// The runtime's C export table: every #Export(c) function of
// Compiler/JetRuntime/Source/*.jet, projected from the sources, never
// authored. Which of them can publish a stop is read from the runtime IR
// at library build (JetIR BuildLibrary.jet ir_stop_exports), not here.

C_EXPORTS_TARGET_PATH: "Compiler/JetFoundation/Source/Registry/RuntimeCExports.jet"

RUNTIME_SOURCE_DIRECTORY: "Compiler/JetRuntime/Source"

code_at: fn(code: [U8], at: Int) -> Int Never! {
    if at >= 0 && at < code.len() -> (Int{code[at]}) else -> 0 - 1
}

// Spaces over bytes `start..<end` of `code`, keeping line breaks.
blank_range: fn(source: [U8], code: &[U8], start: Int, end: Int) {
    loop at in start..<end {
        byte: Int{source[at]}
        if byte != 10 && byte != 13 -> code[at] = U8{32}
    }
}

// Masks the comments and literal text of `source` into `code` from `start`.
// Ordinary code keeps its line breaks (statement boundaries); interpolation
// code is read in the lexer's raw-token mode, so its line breaks become
// spaces. Inside an interpolation the scan stops after its closing brace and
// returns that offset.
mask_scan: fn(source: [U8], code: &[U8], start: Int, interpolation: Bool) -> Int GeneratorError! {
    at := start
    braces := 0
    length: source.len()
    loop at < length {
        byte: Int{source[at]}
        if byte == 47 && code_at(source, at + 1) == 47 {
            end := at
            loop end < length && (Int{source[end]}) != 10 -> end += 1
            blank_range(source, code, at, end)
            at = end
        } else if byte == 47 && code_at(source, at + 1) == 42 {
            begin: at
            at += 2
            depth := 1
            loop at < length && depth > 0 {
                if code_at(source, at) == 47 && code_at(source, at + 1) == 42 {
                    depth += 1
                    at += 2
                } else if code_at(source, at) == 42 && code_at(source, at + 1) == 47 {
                    depth -= 1
                    at += 2
                } else { at += 1 }
            }
            if depth > 0 -> return Err(generator_fail("unclosed runtime source comment"))
            blank_range(source, code, begin, at)
        } else if byte == 96 {
            // A run of N backticks opens raw text; the next run of exactly N
            // closes it.
            begin: at
            loop at < length && (Int{source[at]}) == 96 -> at += 1
            opening: at - begin
            closed := false
            loop at < length && !closed {
                if (Int{source[at]}) != 96 -> at += 1 else {
                    run: at
                    loop at < length && (Int{source[at]}) == 96 -> at += 1
                    closed = at - run == opening
                }
            }
            if !closed -> return Err(generator_fail("unclosed runtime source raw literal"))
            blank_range(source, code, begin, at)
        } else if byte == 34 || byte == 39 {
            triple: byte == 34 && code_at(source, at + 1) == 34 && code_at(source, at + 2) == 34
            delimiter_len: if triple -> 3 else -> 1
            literal := at
            at += delimiter_len
            loop at < length && !(code_at(source, at) == byte && (!triple || (code_at(source, at + 1) == 34 && code_at(source, at + 2) == 34))) {
                current: Int{source[at]}
                if current == 92 -> at += 2 else if byte == 34 && current == 123 && code_at(source, at + 1) == 123 {
                    at += 2
                } else if byte == 34 && current == 123 {
                    blank_range(source, code, literal, at + 1)
                    expression: at + 1
                    at = mask_scan(source, code, expression, true) ?? return Err(err)
                    loop cursor in expression..<at {
                        if (Int{code[cursor]}) == 10 -> code[cursor] = (U8{32})
                    }
                    literal = at - 1
                } else { at += 1 }
            }
            if at >= length -> return Err(generator_fail("unclosed runtime source literal"))
            at += delimiter_len
            blank_range(source, code, literal, at)
        } else if byte == 123 {
            braces += 1
            at += 1
        } else if byte == 125 {
            if interpolation && braces == 0 -> return Ok(at + 1)
            braces -= 1
            at += 1
        } else { at += 1 }
    }
    if interpolation -> return Err(generator_fail("unclosed runtime source interpolation"))
    Ok(at)
}

// `source` with every comment and literal text replaced by spaces, offsets kept.
code_only: fn(source: String) -> String GeneratorError! {
    bytes: source.bytes()
    code := source.bytes()
    mask_scan(bytes, code, 0, false) ?? return Err(err)
    Ok(String.from_bytes_lossy(code))
}

// The index of the byte that closes the group opened just before `from`
// (`open`/`close` nesting), searching below `limit`; -1 when unclosed.
group_end: fn(code: [U8], from: Int, limit: Int, open: Int, close: Int) -> Int Never! {
    at := from
    depth := 1
    loop at < limit && depth > 0 {
        current: Int{code[at]}
        if current == open -> depth += 1 else if current == close -> depth -= 1
        at += 1
    }
    if depth > 0 -> return 0 - 1
    at
}

// Every #Export(c) symbol of `sources`, sorted: the runtime's C export
// table. Every unreadable source and repeated export is reported at once.
runtime_c_export_names: fn(sources: [RuntimeSource]) -> [String] GeneratorError! {
    problems := [String]{}
    names := [String]{}
    loop source in sources {
        if code_only(source.text) == {
            .Ok(text) -> {
                parsed: runtime_exports(text, source.path)
                loop problem in parsed.problems -> problems.push(problem)
                loop export in parsed.exports {
                    if names.contains(export.name) {
                        problems.push("duplicate runtime #Export(c) {export.name}")
                    } else { names.push(export.name) }
                }
            }
            .Err(error) -> problems.push("{source.path}: {error.message}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    names.sort()
    Ok(names)
}

render_c_exports: fn(exports: [String]) -> String Never! {
    lines := [String]{
        "// Generated by Tools/Agent/RuntimeGenerators.jet; do not edit.",
        "// Every #Export(c) function of JetRuntime/Source/*.jet: the runtime's C export table.",
        "// The symbols land as literal data: no compile-time execution host is needed.",
        "RUNTIME_C_EXPORTS: #run {{ [String]{{",
    }
    loop symbol in exports -> lines.push("    \"{symbol}\",")
    tail: [String]{"}} }}", "", "runtime_c_export: fn(symbol: String) -> Bool Never! {{", "    loop candidate in RUNTIME_C_EXPORTS {{", "        if candidate == symbol -> return true", "    }}", "    false", "}}"}
    loop line in tail -> lines.push(line)
    "{lines.join("\n")}\n"
}

read_c_exports: fn() -[FS]> String GeneratorError! {
    names := [String]{}
    listed: files.list_dir(RUNTIME_SOURCE_DIRECTORY) ?? return Err(generator_fail("cannot list {RUNTIME_SOURCE_DIRECTORY}: {err}"))
    loop entry in listed {
        if entry.name.ends_with(".jet") -> names.push(entry.name)
    }
    names.sort()
    sources := [RuntimeSource]{}
    loop name in names {
        text: files.read("{RUNTIME_SOURCE_DIRECTORY}/{name}") ?? return Err(generator_fail("cannot read {RUNTIME_SOURCE_DIRECTORY}/{name}: {err}"))
        sources.push(RuntimeSource{path: name, text: text})
    }
    exports: runtime_c_export_names(sources) ?? return Err(err)
    Ok(render_c_exports(exports))
}

#Test("the C export table is every #Export(c) symbol, sorted, as literal data") {
    source: "#Export(c) stopped: fn() {{ helper() }}\n// #Export(c) commented: fn() {{}}\nnote: \"#Export(c) quoted: fn() {{}}\"\n#Export(c)\nplain: fn() {{}}"
    exports: runtime_c_export_names([RuntimeSource]{RuntimeSource{path: "Fixture.jet", text: source}}) ?? panic("the export table failed: {err.message}")
    expected: "// Generated by Tools/Agent/RuntimeGenerators.jet; do not edit.\n// Every #Export(c) function of JetRuntime/Source/*.jet: the runtime's C export table.\n// The symbols land as literal data: no compile-time execution host is needed.\nRUNTIME_C_EXPORTS: #run {{ [String]{{\n    \"plain\",\n    \"stopped\",\n}} }}\n\nruntime_c_export: fn(symbol: String) -> Bool Never! {{\n    loop candidate in RUNTIME_C_EXPORTS {{\n        if candidate == symbol -> return true\n    }}\n    false\n}}\n"
    assert_eq(render_c_exports(exports), expected)
}

#Test("an unreadable runtime source or a repeated export fails the whole table") {
    sources: [RuntimeSource]{
        RuntimeSource{path: "Broken.jet", text: "/* unclosed"},
        RuntimeSource{path: "One.jet", text: "#Export(c) twice: fn() {{}}"},
        RuntimeSource{path: "Two.jet", text: "#Export(c) twice: fn() {{}}"},
    }
    if runtime_c_export_names(sources) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> {
            assert(error.message.contains("Broken.jet: unclosed runtime source comment"))
            assert(error.message.contains("duplicate runtime #Export(c) twice"))
        }
    }
}

// The runtime pack's strerror text, from pinned musl 1.2.5 assets (never a
// libc runtime dependency). The assets and their manifest are committed;
// generation is offline and every asset must match its manifest hash.

HOST_ERRORS_TARGET_PATH: "Compiler/JetRuntime/Source/HostErrors.jet"

MUSL_ASSETS_DIRECTORY: "Compiler/JetRuntime/Assets/MuslErrno1_2_5"

// errno.h `#define ENAME VALUE` rows; VALUE is a number or another name.
ErrnoDefinition: struct {
    name: String,
    value: String,
}

ErrnoMessage: struct {
    number: Int,
    text: String,
}

is_word: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        if !is_name_byte(Int{byte}) -> return false
    }
    true
}

is_decimal: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        if !is_digit_byte(Int{byte}) -> return false
    }
    true
}

// The whitespace-separated words of `line`.
line_words: fn(line: String) -> [String] Never! {
    words := [String]{}
    bytes: line.bytes()
    at := 0
    loop at < bytes.len() {
        at = skip_spaces(bytes, at)
        if at >= bytes.len() -> break
        start: at
        loop at < bytes.len() && !is_space_byte(Int{bytes[at]}) -> at += 1
        words.push(byte_slice(line, start, at))
    }
    words
}

errno_definitions: fn(header: String) -> [ErrnoDefinition] Never! {
    rows := [ErrnoDefinition]{}
    loop line in header.split("\n") {
        words: line_words(line)
        if words.len() != 3 || words[0] != "#define" || !words[1].starts_with("E") || !is_word(words[1]) || !is_word(words[2]) {
            next
        }
        if !line.starts_with("#define") -> next
        rows.push(ErrnoDefinition{name: words[1], value: words[2]})
    }
    rows
}

// The number an errno name resolves to through its #define chain.
errno_number: fn(definitions: [ErrnoDefinition], name: String) -> Int GeneratorError! {
    current := name
    chain := [String]{}
    loop {
        if is_decimal(current) {
            if Int.parse(current) == {
                .Ok(value) -> return Ok(value)
                .Err(_) -> { return Err(generator_fail("unresolved errno {name}")) }
            }
        }
        if chain.contains(current) -> return Err(generator_fail("unresolved errno {name}"))
        chain.push(current.copy())
        found := ""
        loop definition in definitions {
            if definition.name == current {
                found = definition.value
                break
            }
        }
        if found == "" -> return Err(generator_fail("unresolved errno {name}"))
        current = found
    }
}

// strerror.h `E(NAME, "text")` rows, in order.
errno_messages: fn(table: String, definitions: [ErrnoDefinition]) -> [ErrnoMessage] GeneratorError! {
    messages := [ErrnoMessage]{}
    problems := [String]{}
    loop line in table.split("\n") {
        if !line.starts_with("E(") -> next
        rest: byte_tail(line, 2)
        name: leading_name(rest)
        if name == "" -> next
        after_name: byte_tail(rest, byte_len(name))
        if !after_name.starts_with(",") -> next
        literal_text: byte_tail(after_name, 1).trim_start()
        if !literal_text.starts_with("\"") -> next
        literal: quoted_literal(literal_text) ?? return Err(generator_fail("unsupported strerror literal: {line}"))
        if !byte_tail(literal_text, literal.spelling_len).starts_with(")") -> next
        if errno_number(definitions, name) == {
            .Ok(number) -> { messages.push(ErrnoMessage{number: number, text: literal.value}) }
            .Err(error) -> problems.push(error.message)
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    numbers := [Int]{}
    loop message in messages {
        if numbers.contains(message.number) {
            return Err(generator_fail("invalid strerror source entries"))
        }
        numbers.push(message.number)
    }
    if messages.len() == 0 || messages[0].number != 0 {
        return Err(generator_fail("invalid strerror source entries"))
    }
    Ok(messages)
}

// The leading run of word characters of `text`.
leading_name: fn(text: String) -> String Never! {
    bytes: text.bytes()
    end := 0
    loop end < bytes.len() && is_name_byte(Int{bytes[end]}) -> end += 1
    byte_slice(text, 0, end)
}

errno_word_rows: fn(text: String, indent: String, rows: &[String]) {
    loop word in text_words(text) {
        rows.push("{indent}rt_text_push_word(text, I64{{{word.value}}}, I64{{{word.count}}})")
    }
}

// One static text holds the messages, a line per errno 0..highest in errno
// order, so a lookup costs a short scan instead of a branch and a push per
// message.
render_host_errors: fn(messages: [ErrnoMessage]) -> String GeneratorError! {
    highest := 0
    loop message in messages {
        if message.number > highest -> highest = message.number
    }
    lines := [String]{}
    loop lines.len() <= highest -> lines.push("")
    loop message in messages {
        loop byte in message.text.bytes() {
            code: Int{byte}
            if code < 32 || code > 126 || code == 34 || code == 92 || code == 123 || code == 125 {
                return Err(generator_fail("errno {message.number}: message is not plain printable ASCII"))
            }
        }
        lines[message.number] = message.text
    }
    table := ""
    loop line in lines -> table = "{table}{line}\\n"
    rows := [String]{
        "// Generated by Tools/Agent/RuntimeGenerators.jet from pinned musl 1.2.5 assets.",
        "// Source hashes and MIT attribution: Assets/MuslErrno1_2_5/manifest.json + COPYRIGHT.",
        "// Native-pack wording is musl, not GNU Rust-tier strerror wording.",
        "",
        "// The messages as one static text, a line per errno 0..{highest}, each ended",
        "// by LF. An errno whose line is empty, or past the last, has line 0's.",
        "host_errno_append: fn(text: I64, errno: I64) {{",
        "    table: rt_text_data(rt_static_text(\"{table}\"))",
        "    index := if (errno > I64{{0}} && errno <= I64{{{highest}}}) -> errno else -> I64{{0}}",
        "    loop {{",
        "        start := I64{{0}}",
        "        line := I64{{0}}",
        "        loop line < index {{",
        "            if (rt_text_byte(wrapping(table + start)) == I64{{10}}) {{ line += I64{{1}} }}",
        "            start += I64{{1}}",
        "        }}",
        "        end := start",
        "        loop rt_text_byte(wrapping(table + end)) != (I64{{10}}) -> end += I64{{1}}",
        "        if (end > start || index == I64{{0}}) {{",
        "            rt_text_append(text, wrapping(table + start), end - start)",
        "            return",
        "        }}",
        "        index = I64{{0}}",
        "    }}",
        "}}",
    }
    middle: [String]{"", "host_errno_cause_append: fn(text: I64, errno: I64) {{", "    host_errno_append(text, errno)"}
    loop row in middle -> rows.push(row)
    errno_word_rows(" (os error ", "    ", rows)
    rows.push("    rt_text_push_number(text, errno)")
    errno_word_rows(")", "    ", rows)
    tail: [String]{"}}", "", "host_errno_text: fn(errno: I64) -> I64 {{", "    text: jet_rt_string_builder_new()", "    host_errno_append(text, errno)", "    jet_rt_string_builder_finish(text)", "}}", "", "host_errno_cause: fn(errno: I64) -> I64 {{", "    text: jet_rt_string_builder_new()", "    host_errno_cause_append(text, errno)", "    jet_rt_string_builder_finish(text)", "}}"}
    loop row in tail -> rows.push(row)
    Ok("{rows.join("\n")}\n")
}

// The text a Dyn Text holds; "" for any other value.
dyn_text: fn(value: Dyn) -> String Never! {
    if value == {
        .Text(text) -> text
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> ""
    }
}

// The manifest's pinned sha256 for asset `name`, or "" when it names none.
manifest_sha256: fn(manifest: Dyn, name: String) -> String Never! {
    rows: manifest.field("files") ?? return ""
    if rows == {
        .Array(items) -> {
            loop row in items {
                row_name: row.field("name") ?? next
                if dyn_text(row_name) != name -> next
                sha: row.field("sha256") ?? return ""
                return dyn_text(sha)
            }
            ""
        }
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> ""
    }
}

read_host_errors: fn() -[FS]> String GeneratorError! {
    manifest_path: "{MUSL_ASSETS_DIRECTORY}/manifest.json"
    manifest_text: files.read(manifest_path) ?? return Err(generator_fail("cannot read {manifest_path}: {err}"))
    manifest: json.parse(manifest_text) ?? return Err(generator_fail("invalid errno source manifest"))
    version: manifest.field("version") ?? return Err(generator_fail("invalid errno source manifest"))
    license: manifest.field("license") ?? return Err(generator_fail("invalid errno source manifest"))
    if dyn_text(version) != "musl-1.2.5" || dyn_text(license) != "MIT" {
        return Err(generator_fail("invalid errno source manifest"))
    }
    problems := [String]{}
    assets: [String]{"strerror.h", "errno.h", "COPYRIGHT"}
    loop name in assets {
        path: "{MUSL_ASSETS_DIRECTORY}/{name}"
        if files.read_bytes(path) == {
            .Ok(bytes) -> {
                if crypto.sha256(bytes).hex() != manifest_sha256(manifest, name) {
                    problems.push("{name}: pinned errno asset changed")
                }
            }
            .Err(error) -> problems.push("cannot read {path}: {error}")
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    header: files.read("{MUSL_ASSETS_DIRECTORY}/errno.h") ?? return Err(generator_fail("cannot read errno.h: {err}"))
    table: files.read("{MUSL_ASSETS_DIRECTORY}/strerror.h") ?? return Err(generator_fail("cannot read strerror.h: {err}"))
    messages: errno_messages(table, errno_definitions(header)) ?? return Err(err)
    render_host_errors(messages)
}

#Test("errno names resolve through their define chain and strerror rows keep their order") {
    header: "#define EPERM 1\n#define ENOENT 2\n#define EWOULDBLOCK EAGAIN\n#define EAGAIN 11\n#define ELOOPA ELOOPB\n#define ELOOPB ELOOPA\n"
    definitions: errno_definitions(header)
    assert_eq(errno_number(definitions, "EWOULDBLOCK") ?? 0 - 1, 11)
    if errno_number(definitions, "ELOOPA") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "unresolved errno ELOOPA")
    }
    table: "/* comment */\nE(0,            \"No error information\")\n\nE(EPERM,        \"Operation not permitted\")\nE(EWOULDBLOCK,  \"Resource \\\"temporarily\\\" unavailable\")\n"
    messages: errno_messages(table, definitions) ?? panic("rows did not parse: {err.message}")
    assert_eq(messages.len(), 3)
    assert_eq(messages[2].number, 11)
    assert_eq(messages[2].text, "Resource \"temporarily\" unavailable")
    if render_host_errors(messages) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "errno 11: message is not plain printable ASCII")
    }
    // A line per errno up to the highest; a missing errno's line is empty.
    plain: [ErrnoMessage]{ErrnoMessage{number: 0, text: "No error information"}, ErrnoMessage{number: 2, text: "No such file"}}
    text: render_host_errors(plain) ?? panic("rows did not render: {err.message}")
    assert(text.contains("rt_static_text(\"No error information\\n\\nNo such file\\n\")"))
    assert(text.contains("errno <= I64{{2}}"))
}

// The host C carriers: their tags are the checked Core registry's
// declaration-order ordinals, not an independent runtime enum, and the host
// refusals and names are heap-free literals. A family still in the payload
// rows reads its variants there; a family declared in Core source reads its
// generated `Name:plain(A|B)` case list in Core.rows.

HOST_CARRIER_ROWS_PATH: "Compiler/JetFoundation/Source/Registry/CoreEnumPayloadRows.jet"

HOST_CARRIER_CASES_PATH: "Compiler/Prelude/Core.rows"

HOST_CARRIERS_TARGET_PATH: "Compiler/JetRuntime/Source/HostEnums.jet"

// One carrier table: the constant prefix and its Core enum's variants.
HostCarrierTable: struct {
    prefix: String,
    values: [String],
}

// The variants of Core enum `name` in declaration order, from exactly one of
// the payload `rows` and the Core.rows `cases`. A missing or repeated variant,
// or a family listed in both, is a broken registry.
enum_variants: fn(rows: String, cases: String, name: String) -> [String] GeneratorError! {
    values := quoted_after(rows, "CoreEnumPayloadRow{{enum_name: \"{name}\", variant: \"")
    listed: cases.split(" {name}:plain(").to_list()
    if listed.len() > 2 || (listed.len() == 2 && values.len() > 0) {
        return Err(generator_fail("missing/duplicate {name} enum rows"))
    }
    if listed.len() == 2 -> values = listed[1].partition(")").head.split("|").to_list()
    if values.len() == 0 -> return Err(generator_fail("missing/duplicate {name} enum rows"))
    loop at in 1..<values.len() {
        loop before in 0..<at {
            if values[before] == values[at] {
                return Err(generator_fail("missing/duplicate {name} enum rows"))
            }
        }
    }
    Ok(values)
}

// `InvalidInput` as `INVALID_INPUT` and `CPUTime` as `CPU_TIME`: the runtime
// ABI atom, every letter uppercase.
constant_case: fn(name: String) -> String Never! { runtime_abi_atom(name).to_upper() }

// The runtime ABI atom of `name`, as Compiler/JetIR/Source/RuntimeRoutes.jet
// runtime_abi_atom projects it for Lower: `HTTPClient` is `http_client`.
runtime_abi_atom: fn(name: String) -> String Never! {
    bytes: name.bytes()
    out := [U8]{}
    loop index in 0..<bytes.len() {
        code: Int{bytes[index]}
        if code == 46 || code == 95 {
            if out.len() > 0 && out[out.len() - 1] != (U8{95}) -> out.push(U8{95})
            next
        }
        upper: code >= 65 && code <= 90
        if upper && index > 0 && out.len() > 0 && out[out.len() - 1] != (U8{95}) {
            previous: Int{bytes[index - 1]}
            next_code: if index + 1 < bytes.len() -> (Int{bytes[index + 1]}) else -> 0
            previous_upper: previous >= 65 && previous <= 90
            next_lower: next_code >= 97 && next_code <= 122
            if !previous_upper || next_lower -> out.push(U8{95})
        }
        out.push(U8{if upper -> code + 32 else -> code})
    }
    if out.len() > 0 && out[out.len() - 1] == (U8{95}) {
        _: out.pop() ?? panic("a nonempty runtime ABI atom failed to pop")
    }
    String.from_bytes(out) ?? panic("runtime ABI atom {name} is not ASCII")
}

// Registered E3001 stops: the writes are heap-free, and Root owns the
// captured full report through the trap_header / trap_footer boundary. Each
// goes through host_refused, which serves comptime code first (trap_stop).
host_refusals: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "host_arguments_refused", text: "host arguments unavailable; call jet_rt_host_arguments before env or argv access"},
        MessageLiteral{name: "host_environment_index_refused", text: "startup environment index out of range"},
        MessageLiteral{name: "host_argument_index_refused", text: "startup argument index out of range"},
        MessageLiteral{name: "host_record_index_refused", text: "record variant index out of range"},
        MessageLiteral{name: "host_sigpipe_refused", text: "failed to initialize SIGPIPE handling"},
    }
}

// Host names and texts, each built as one runtime String.
host_texts: fn() -> [MessageLiteral] Never! {
    [MessageLiteral]{
        MessageLiteral{name: "host_stdout_name", text: "stdout"},
        MessageLiteral{name: "host_stderr_name", text: "stderr"},
        MessageLiteral{name: "host_write_zero_text", text: "failed to write whole buffer"},
        MessageLiteral{name: "host_resolver_prefix", text: "failed to lookup address information: "},
        MessageLiteral{name: "host_resolver_nul", text: "file name contained an unexpected NUL byte"},
        MessageLiteral{name: "host_net_wait_kind", text: "network wait"},
    }
}

render_host_carriers: fn(rows: String, cases: String) -> String GeneratorError! {
    kinds: enum_variants(rows, cases, "IOError") ?? return Err(err)
    tables := [HostCarrierTable]{HostCarrierTable{prefix: "HOST_IO_KIND", values: kinds}}
    problems := [String]{}
    names: [String]{"IOOperation", "ProcessResourceLimit", "ProcessStreamMode", "TerminalMode"}
    prefixes: [String]{"HOST_IO_OP", "HOST_PROCESS_LIMIT", "HOST_PROCESS_STREAM", "HOST_TERMINAL_MODE"}
    loop at in 0..<names.len() {
        if enum_variants(rows, cases, names[at]) == {
            .Ok(values) -> { tables.push(HostCarrierTable{prefix: prefixes[at], values: values}) }
            .Err(error) -> problems.push(error.message)
        }
    }
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    lines := [String]{
        "// Generated by Tools/Agent/RuntimeGenerators.jet from {HOST_CARRIER_ROWS_PATH} and {HOST_CARRIER_CASES_PATH}.",
        "// C carrier tags are Core ordinals, not an independent runtime enum.",
        "// Refusals use the shared trap boundary: Root captures the full registered report.",
    }
    constants := [String]{}
    loop table in tables {
        loop index in 0..<table.values.len() {
            constants.push("{table.prefix}_{constant_case(table.values[index])}: I64{{{index}}}")
        }
        constants.push("{table.prefix}_COUNT: I64{{{table.values.len()}}}")
    }
    lines.push(constants.join("\n\n"))
    loop refusal in host_refusals() {
        literal: static_text(refusal.text) ?? return Err(err)
        lines.push("")
        lines.push(fmt_block("", "{refusal.name}: fn()", "    host_refused({literal})\n").trim_end())
    }
    lines.push("")
    lines.push("// A host table's E3001 stop with the static `reason`.")
    lines.push("host_refused: fn(reason: I64) {{")
    lines.push("    trap_stop(I64{{1}}, rt_text_data(reason), rt_text_len(reason), I64{{0}}, I64{{0}})")
    lines.push("    jet_rt_stdout_flush()")
    lines.push("    trap_header(I64{{0}})")
    lines.push("    trap_write_static(reason)")
    lines.push("    trap_msg_prelude_end()")
    lines.push("    trap_footer(I64{{0}})")
    lines.push("}}")
    loop text in host_texts() {
        lines.push("")
        lines.push("{text.name}: fn() -> I64 {{")
        lines.push("    text: jet_rt_string_builder_new()")
        if static_text_worthy(text.text) {
            literal: static_text(text.text) ?? return Err(err)
            lines.push("    jet_rt_string_builder_push(text, {literal})")
        } else {
            loop word in text_words(text.text) {
                lines.push("    rt_text_push_word(text, I64{{{word.value}}}, I64{{{word.count}}})")
            }
        }
        lines.push("    jet_rt_string_builder_finish(text)")
        lines.push("}}")
    }
    loop kind in kinds {
        if kind == "ResourceLimit" -> next
        constant: "HOST_IO_KIND_{constant_case(kind)}"
        atom: runtime_abi_atom(kind)
        lines.push("")
        lines.push(fmt_block("", "#Export(c) jet_rt_record_get_io_error_{atom}: fn(error: I64) -> I64", "    host_error_context(error, {constant})\n").trim_end())
        lines.push("")
        lines.push(fmt_block("", "#Export(c) jet_rt_record_new_io_error_{atom}: fn(context: I64) -> I64", "    host_error_with_context(context, {constant})\n").trim_end())
    }
    Ok("{lines.join("\n")}\n")
}

read_host_carriers: fn() -[FS]> String GeneratorError! {
    rows: files.read(HOST_CARRIER_ROWS_PATH) ?? return Err(generator_fail("cannot read {HOST_CARRIER_ROWS_PATH}: {err}"))
    cases: files.read(HOST_CARRIER_CASES_PATH) ?? return Err(generator_fail("cannot read {HOST_CARRIER_CASES_PATH}: {err}"))
    render_host_carriers(rows, cases)
}

HOST_CARRIER_FIXTURE: "CoreEnumPayloadRow{{enum_name: \"IOError\", variant: \"InvalidInput\"\nCoreEnumPayloadRow{{enum_name: \"IOError\", variant: \"ResourceLimit\"\nCoreEnumPayloadRow{{enum_name: \"IOOperation\", variant: \"Read\"\n"

HOST_CARRIER_CASES_FIXTURE: "module jet_builtins exports {{ ProcessResourceLimit }} types {{ ProcessResourceLimit:plain(CPUTime) }}\nmodule core.process exports {{ ProcessStreamMode, TerminalMode }} types {{ ProcessStreamMode:plain(Inherit|Piped), TerminalMode:plain(Raw), TerminalModeX:plain(Cooked) }}\n"

#Test("host carrier tags are the registry's declaration order, one declaration per helper") {
    text: render_host_carriers(HOST_CARRIER_FIXTURE, HOST_CARRIER_CASES_FIXTURE) ?? panic("carriers did not render: {err.message}")
    assert(text.starts_with("// Generated by Tools/Agent/RuntimeGenerators.jet from {HOST_CARRIER_ROWS_PATH} and {HOST_CARRIER_CASES_PATH}.\n"))
    assert(text.contains("\nHOST_IO_KIND_INVALID_INPUT: I64{{0}}\n\nHOST_IO_KIND_RESOURCE_LIMIT: I64{{1}}\n\nHOST_IO_KIND_COUNT: I64{{2}}\n"))
    assert(text.contains("\nHOST_PROCESS_LIMIT_CPU_TIME: I64{{0}}\n\nHOST_PROCESS_LIMIT_COUNT: I64{{1}}\n"))
    assert(text.contains("\nHOST_PROCESS_STREAM_INHERIT: I64{{0}}\n\nHOST_PROCESS_STREAM_PIPED: I64{{1}}\n\nHOST_PROCESS_STREAM_COUNT: I64{{2}}\n"))
    assert(text.contains("\nHOST_TERMINAL_MODE_RAW: I64{{0}}\n\nHOST_TERMINAL_MODE_COUNT: I64{{1}}\n"))
    assert(text.contains("#Export(c) jet_rt_record_get_io_error_invalid_input: fn(error: I64) -> I64 {{\n    host_error_context(error, HOST_IO_KIND_INVALID_INPUT)\n}}\n"))
    assert(!text.contains("io_error_resource_limit"))
    assert(text.contains("\nhost_record_index_refused: fn() {{\n    host_refused(rt_static_text(\"record variant index out of range\"))\n}}\n"))
    assert(text.contains("host_stdout_name: fn() -> I64 {{\n    text: jet_rt_string_builder_new()\n    rt_text_push_word(text, I64{{128047728850035}}, I64{{6}})\n"))
    seen := [String]{}
    loop line in text.split("\n") {
        if !line.contains(": fn(") || line.starts_with("#") || line.starts_with(" ") -> next
        name: line.partition(":").head.copy()
        loop earlier in seen -> assert(earlier != name)
        seen.push(name)
    }
    // The 5 refusals, host_refused and the 6 host texts.
    assert_eq(seen.len(), 12)
}

#Test("a missing or repeated host carrier variant fails the whole table") {
    missing: HOST_CARRIER_CASES_FIXTURE.replace(" TerminalMode:plain(", " Other:plain(")
    if render_host_carriers(HOST_CARRIER_FIXTURE, missing) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "missing/duplicate TerminalMode enum rows")
    }
    repeated: HOST_CARRIER_FIXTURE.replace("variant: \"ResourceLimit\"", "variant: \"InvalidInput\"")
    if render_host_carriers(repeated, HOST_CARRIER_CASES_FIXTURE) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "missing/duplicate IOError enum rows")
    }
    repeated_case: HOST_CARRIER_CASES_FIXTURE.replace("(Inherit|Piped)", "(Inherit|Inherit)")
    if render_host_carriers(HOST_CARRIER_FIXTURE, repeated_case) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "missing/duplicate ProcessStreamMode enum rows")
    }
    both: "{HOST_CARRIER_FIXTURE}CoreEnumPayloadRow{{enum_name: \"TerminalMode\", variant: \"Raw\"\n"
    if render_host_carriers(both, HOST_CARRIER_CASES_FIXTURE) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "missing/duplicate TerminalMode enum rows")
    }
    assert_eq(constant_case("PermissionDenied"), "PERMISSION_DENIED")
    assert_eq(constant_case("CPUTime"), "CPU_TIME")
    assert_eq(runtime_abi_atom("HTTPClient"), "http_client")
    assert_eq(runtime_abi_atom("TimedOut"), "timed_out")
}

#Test("the checked-in host carriers are the registry's projection") {
    expected: read_host_carriers() ?? panic("carriers did not render: {err.message}")
    found: files.read(HOST_CARRIERS_TARGET_PATH) ?? panic("{HOST_CARRIERS_TARGET_PATH} did not read: {err}")
    assert_eq(found, expected)
}

// The decode diagnostic's name for each Dyn variant. The arms of Core's
// core.encoding.__dyn_kind are the one source; the runtime's dyn_kind_name
// is a generated region of Dyn.jet, which only maps a variant to the
// runtime's tree tag.

DYN_KIND_SOURCE_PATH: "Core/Encoding/Encoding.jet"

DYN_KIND_RUNTIME_PATH: "Compiler/JetRuntime/Source/Dyn.jet"

DYN_KIND_BEGIN: "// Generated by Tools/Agent/RuntimeGenerators.jet from core.encoding.__dyn_kind; do not edit."

DYN_KIND_END: "// End of the generated dyn_kind rows."

DynKind: struct {
    variant: String,
    word: String,
}

// The `.Variant -> "word"` arms of __dyn_kind in `source`, in order.
dyn_kind_rows: fn(source: String) -> [DynKind] GeneratorError! {
    marker: "\n__dyn_kind: fn(tree: Dyn) -> String Never! {{\n    if tree == {{\n"
    open: source.find(marker)
    if open < 0 -> return Err(generator_fail("{DYN_KIND_SOURCE_PATH} has no __dyn_kind table"))
    body: byte_tail(source, open + byte_len(marker))
    close: body.find("\n    }}\n}}")
    if close < 0 {
        return Err(generator_fail("{DYN_KIND_SOURCE_PATH}: the __dyn_kind table is not closed"))
    }
    rows := [DynKind]{}
    loop line in byte_slice(body, 0, close).split("\n") {
        arm: line.trim().copy()
        arrow: arm.find(" -> ")
        if !arm.starts_with(".") || arrow < 0 {
            return Err(generator_fail("unsupported __dyn_kind arm: {arm}"))
        }
        pattern: byte_slice(arm, 1, arrow)
        variant: if pattern.ends_with("(_)") -> byte_slice(pattern, 0, byte_len(pattern) - 3) else -> pattern
        spelling: byte_tail(arm, arrow + byte_len(" -> "))
        literal: quoted_literal(spelling) ?? return Err(generator_fail("unsupported __dyn_kind arm: {arm}"))
        if variant == "" || leading_name(variant) != variant || literal.spelling_len != byte_len(spelling) {
            return Err(generator_fail("unsupported __dyn_kind arm: {arm}"))
        }
        // The word lands in a Jet and a JS string literal as written.
        loop byte in literal.value.bytes() {
            code: Int{byte}
            if code < 32 || code > 126 || code == 34 || code == 92 || code == 123 || code == 125 {
                return Err(generator_fail("__dyn_kind word for {variant} is not plain printable ASCII"))
            }
        }
        rows.push(DynKind{variant: variant, word: literal.value})
    }
    if rows.len() == 0 {
        return Err(generator_fail("{DYN_KIND_SOURCE_PATH}: the __dyn_kind table has no arms"))
    }
    Ok(rows)
}

// The runtime tree tag constant of Dyn variant `variant`.
dyn_kind_runtime_tag: fn(variant: String) -> String? Never! {
    if {
        variant == "Null" -> Val("DYN_NULL")
        variant == "Bool" -> Val("DYN_BOOL")
        variant == "Int" -> Val("DYN_INT")
        variant == "Float" -> Val("DYN_FLOAT")
        variant == "Number" -> Val("DYN_NUMBER")
        variant == "Text" -> Val("DYN_TEXT")
        variant == "Bytes" -> Val("DYN_BYTE_LIST")
        variant == "DateTime" -> Val("DYN_DATETIME")
        variant == "Array" -> Val("DYN_ARRAY")
        variant == "Object" -> Val("DYN_OBJECT")
        else -> None
    }
}

// dyn_kind_name: a tag test per arm; the last arm's word answers every
// other tag.
render_dyn_kind_runtime: fn(rows: [DynKind]) -> String GeneratorError! {
    lines := [String]{DYN_KIND_BEGIN, "// dyn_kind: the diagnostic name of a runtime tree's kind.", "dyn_kind_name: fn(kind: I64) -> I64 {{"}
    loop at in 0..<rows.len() {
        row: rows[at]
        constant: dyn_kind_runtime_tag(row.variant) ?? return Err(generator_fail("Dyn variant {row.variant} has no runtime tree tag"))
        if at + 1 < rows.len() {
            lines.push("    if kind == {constant} -> return rt_static_text(\"{row.word}\")")
        } else { lines.push("    rt_static_text(\"{row.word}\")") }
    }
    lines.push("}}")
    // `jet fmt` parts the end line, a comment, from the function above it.
    lines.push("")
    lines.push(DYN_KIND_END)
    Ok(lines.join("\n"))
}

// `text` (the file at `path`) with its one generated `name` region, the
// `begin_line` line through the `end_line` line, replaced by `region`.
splice_region: fn(path: String, text: String, begin_line: String, end_line: String, name: String, region: String) -> String GeneratorError! {
    begin: text.find("{begin_line}\n")
    if begin < 0 -> return Err(generator_fail("{path} has no generated {name} region"))
    rest: byte_tail(text, begin)
    end: rest.find("{end_line}\n")
    if end < 0 -> return Err(generator_fail("{path}: the generated {name} region is not closed"))
    after: byte_tail(rest, end + byte_len(end_line) + 1)
    if after.find("{begin_line}\n") >= 0 {
        return Err(generator_fail("{path} has more than one generated {name} region"))
    }
    Ok("{byte_slice(text, 0, begin)}{region}\n{after}")
}

read_dyn_kinds: fn() -[FS]> [GeneratedFile] GeneratorError! {
    source: files.read(DYN_KIND_SOURCE_PATH) ?? return Err(generator_fail("cannot read {DYN_KIND_SOURCE_PATH}: {err}"))
    rows: dyn_kind_rows(source) ?? return Err(err)
    runtime: files.read(DYN_KIND_RUNTIME_PATH) ?? return Err(generator_fail("cannot read {DYN_KIND_RUNTIME_PATH}: {err}"))
    runtime_region: render_dyn_kind_runtime(rows) ?? return Err(err)
    runtime_text: splice_region(DYN_KIND_RUNTIME_PATH, runtime, DYN_KIND_BEGIN, DYN_KIND_END, "dyn_kind", runtime_region) ?? return Err(err)
    Ok([GeneratedFile]{GeneratedFile{path: DYN_KIND_RUNTIME_PATH, text: runtime_text}})
}

#Test("the dyn_kind table is __dyn_kind's arms, spliced into the runtime's one region") {
    source: "x\n__dyn_kind: fn(tree: Dyn) -> String Never! {{\n    if tree == {{\n        .Null -> \"Null\"\n        .Bytes(_) -> \"Bytes\"\n        .Object(_) -> \"an object\"\n    }}\n}}\n"
    rows: dyn_kind_rows(source) ?? panic("rows did not parse: {err.message}")
    assert_eq(rows.len(), 3)
    assert_eq(rows[1].variant, "Bytes")
    assert_eq(rows[2].word, "an object")
    runtime: render_dyn_kind_runtime(rows) ?? panic("rows did not render: {err.message}")
    assert(runtime.contains("    if kind == DYN_BYTE_LIST -> return rt_static_text(\"Bytes\")\n    rt_static_text(\"an object\")\n}}\n\n{DYN_KIND_END}"))
    host: "a\n{DYN_KIND_BEGIN}\nstale\n{DYN_KIND_END}\nb\n"
    assert_eq(splice_region("h", host, DYN_KIND_BEGIN, DYN_KIND_END, "dyn_kind", "R") ?? "", "a\nR\nb\n")
    if splice_region("h", "{host}{host}", DYN_KIND_BEGIN, DYN_KIND_END, "dyn_kind", "R") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "h has more than one generated dyn_kind region")
    }
    unknown: dyn_kind_rows(source.replace(".Bytes(_)", ".Blob(_)")) ?? panic("rows did not parse: {err.message}")
    if render_dyn_kind_runtime(unknown) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "Dyn variant Blob has no runtime tree tag")
    }
    if dyn_kind_rows(source.replace("\"Bytes\"", "Bytes")) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "unsupported __dyn_kind arm: .Bytes(_) -> Bytes")
    }
}

// The native fault reports' machine code: report.S and addresses.S, assembled
// with GNU as, become X64/FaultReport.jet's byte tables. The bytes must need
// no relocation, and a report is code and texts only.

FAULT_REPORT_TARGET_PATH: "Compiler/JetBackend/Source/X64/FaultReport.jet"

FaultReportSource: struct {
    path: String,
    name: String,
    doc: String,
}

fault_report_sources: fn() -> [FaultReportSource] Never! {
    [FaultReportSource]{
        FaultReportSource{path: "Compiler/JetRuntime/Assets/FaultReport/report.S", name: "X64_FAULT_REPORT", doc: "// The full report, naming Jet frames from the image's location table."},
        FaultReportSource{path: "Compiler/JetRuntime/Assets/FaultReport/addresses.S", name: "X64_FAULT_REPORT_ADDRESSES", doc: "// A split image's report: addresses under the build id, for `jet crash`."},
    }
}

// The little-endian unsigned field of `count` bytes (at most 8) at `at`.
le_field: fn(bytes: [U8], at: Int, count: Int) -> Int Never! {
    value := 0
    loop index in at..<at + count -> value += Int{bytes[index]} << (8 * (index - at))
    value
}

// The .text bytes of the ELF64 relocatable object assembled from `path`.
fault_report_text: fn(path: String, object: [U8]) -> [U8] GeneratorError! {
    if object.len() < 64 {
        return Err(generator_fail("{path}: the assembler wrote no ELF64 object"))
    }
    shoff: le_field(object, 40, 8)
    shentsize: le_field(object, 58, 2)
    shnum: le_field(object, 60, 2)
    if shentsize < 40 || shoff + shnum * shentsize > object.len() {
        return Err(generator_fail("{path}: the object's section headers are truncated"))
    }
    names_at: le_field(object, shoff + le_field(object, 62, 2) * shentsize + 24, 8)
    text := [U8]{}
    found := false
    loop index in 0..<shnum {
        header: shoff + index * shentsize
        name_at: names_at + le_field(object, header, 4)
        name_end := name_at
        loop name_end < object.len() && (Int{object[name_end]}) != 0 -> name_end += 1
        name: String.from_bytes_lossy(object[name_at..<name_end])
        offset: le_field(object, header + 24, 8)
        size: le_field(object, header + 32, 8)
        if name.starts_with(".rela") || name.starts_with(".rel.") {
            return Err(generator_fail("{path}: {name}: the report's bytes must need no relocation"))
        }
        data_section: name == ".data" || name == ".bss"
        if data_section && size != 0 {
            return Err(generator_fail("{path}: {name}: the report is code and texts only"))
        }
        if name == ".text" {
            if offset + size > object.len() {
                return Err(generator_fail("{path}: .text is truncated"))
            }
            loop at in offset..<offset + size -> text.push(object[at])
            found = true
        }
    }
    if !found || text.len() == 0 -> return Err(generator_fail("{path}: no .text"))
    Ok(text)
}

// The table `name` of `bytes`, one per line as `jet fmt` writes a list too
// long for one line.
render_fault_report_table: fn(report: FaultReportSource, bytes: [U8]) -> String Never! {
    rows := [String]{}
    loop byte in bytes -> rows.push("    {Int{byte}},\n")
    "\n{report.doc}\n{report.name}: [U8]{{\n{rows.join("")}}}\n"
}

// `fault-report [--check]` (`args` with its mode word): FaultReport.jet is
// current, or (without --check) rewritten.
fault_report_main: fn(args: [String]) -[Exec, FS]> String GeneratorError! {
    check: args.len() == 2 && args[1] == "--check"
    if args.len() > 2 || (args.len() == 2 && !check) -> return Err(generator_fail(USAGE))
    text: render_fault_reports() ?? return Err(err)
    current: output_current(FAULT_REPORT_TARGET_PATH, text) ?? return Err(err)
    if current -> return Ok("runtime fault reports are current")
    if check {
        return Err(generator_fail("{FAULT_REPORT_TARGET_PATH} is stale; run jet Tools/Agent/JetEnv.jet jet Tools/Agent/RuntimeGenerators.jet fault-report"))
    }
    write_output(FAULT_REPORT_TARGET_PATH, text) ?? return Err(err)
    Ok("wrote {FAULT_REPORT_TARGET_PATH}")
}

render_fault_reports: fn() -[Exec, FS]> String GeneratorError! {
    scratch: files.mkdtemp("fault-report") ?? return Err(generator_fail("a scratch directory cannot be made: {err}"))
    source := "// Generated by Tools/Agent/RuntimeGenerators.jet from\n// Compiler/JetRuntime/Assets/FaultReport/; do not hand-edit.\n// The native fault reports' x86-64 code and texts: each a whole C\n// function, which the static linker writes as the runtime's\n// jet_rt_fault_report (Image/StaticLink.jet link_fault_report). Its\n// source documents how the bytes run.\n"
    problems := [String]{}
    loop report in fault_report_sources() {
        object: files.join(scratch, "report.o")
        assembled: process.cmd([String]{"as", "--64", "-o", object.copy(), report.path}).run() ?? {
            problems.push("{report.path}: `as` cannot start: {err}")
            next
        }
        if !assembled.success {
            problems.push("{report.path}: `as` exited {assembled.code}: {assembled.output.trim()}")
            next
        }
        bytes: files.read_bytes(object) ?? {
            problems.push("{report.path}: cannot read the object: {err}")
            next
        }
        if fault_report_text(report.path, bytes) == {
            .Ok(text) -> { source = "{source}{render_fault_report_table(report, text)}" }
            .Err(error) -> problems.push(error.message)
        }
    }
    files.remove_all(scratch) ?? ()
    if problems.len() > 0 -> return Err(generator_fail(problems.join("\n")))
    Ok(source)
}

#Test("a fault report table holds one byte per row") {
    report: FaultReportSource{path: "r.S", name: "R", doc: "// Doc."}
    assert_eq(render_fault_report_table(report, [U8]{U8{0}, U8{17}}), "\n// Doc.\nR: [U8]{{\n    0,\n    17,\n}}\n")
    assert_eq(le_field([U8]{U8{1}, U8{2}, U8{0}}, 0, 3), 513)
    if fault_report_text("r.S", [U8]{U8{0}}) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert_eq(error.message, "r.S: the assembler wrote no ELF64 object")
    }
}

// The process exit codes. Their one home is JetFoundation's exit-code table,
// which the compiler's driver and CLI and Jetpack name directly. The runtime
// (the native and web targets alike) and the test kit, which import no
// package, each get a generated copy, Core's process module, which cannot
// import JetFoundation, a generated region, and the release policy its table.
// A bare 70 or 101 in an exit position anywhere else is a copy.

EXIT_CODES_SOURCE_PATH: "Compiler/JetFoundation/Source/Registry/ExitCodes.jet"

EXIT_CODES_RUNTIME_PATH: "Compiler/JetRuntime/Source/ExitCodes.jet"

EXIT_CODES_KIT_PATH: "Compiler/JetTestKit/Source/ExitCodes.jet"

EXIT_CODES_CORE_PATH: "Core/Process/Process.jet"

EXIT_CODES_BEGIN: "// Generated by Tools/Agent/RuntimeGenerators.jet from Compiler/JetFoundation/Source/Registry/ExitCodes.jet; do not edit."

EXIT_CODES_END: "// End of the generated exit codes."

// The release policy's table: one row per code, its name without `EXIT_`
// and its comment as the meaning.
EXIT_CODES_DOC_PATH: "Docs/Spec/release-policy.md"

EXIT_CODES_DOC_BEGIN: "<!-- BEGIN GENERATED EXIT CODES (Tools/Agent/RuntimeGenerators.jet; edit Compiler/JetFoundation/Source/Registry/ExitCodes.jet) -->"

EXIT_CODES_DOC_END: "<!-- END GENERATED EXIT CODES -->"

// The trees whose sources the exit-position guard reads, and the directories
// it skips: tests may spell the statuses they expect. Compiler/JetDevServer
// is no package that compiles yet, so its sources aren't Jet the scan reads.
EXIT_GUARD_ROOTS: [String]{"Compiler", "Core", "Jetpack"}

EXIT_GUARD_SKIPPED: [String]{"Tests", "tests", "Fixtures", "fixtures"}

EXIT_GUARD_UNBUILT: [String]{"Compiler/JetDevServer"}

// The statuses only a named constant may spell in an exit position.
EXIT_GUARDED: [String]{"70", "101"}

ExitCode: struct {
    name: String,
    value: String,
    doc: [String],
}

// The `EXIT_NAME: N` rows of the exit-code table, each with the comment
// lines directly above it.
exit_code_rows: fn(source: String) -> [ExitCode] GeneratorError! {
    rows := [ExitCode]{}
    doc := [String]{}
    loop line in source.split("\n") {
        if line.starts_with("// ") {
            doc.push(byte_tail(line, 3))
            next
        }
        if line.trim() == "" {
            doc = [String]{}
            next
        }
        colon: line.find(": ")
        name: if colon > 0 -> byte_slice(line, 0, colon) else -> ""
        value: if colon > 0 -> byte_tail(line, colon + 2) else -> ""
        if !name.starts_with("EXIT_") || leading_name(name) != name || value == "" || !value.bytes().all(fn(byte) { is_digit_byte(Int{byte}) }) {
            return Err(generator_fail("{EXIT_CODES_SOURCE_PATH}: unsupported line `{line}`"))
        }
        rows.push(ExitCode{name: name, value: value, doc: doc.copy()})
        doc = [String]{}
    }
    if rows.len() == 0 -> return Err(generator_fail("{EXIT_CODES_SOURCE_PATH} has no exit codes"))
    Ok(rows)
}

// The rows as constants named `prefix` and the row's name, each a runtime
// word when `word`, between the generated region's two lines, a blank line
// apart as `jet fmt` writes them; with `parted`, a blank line parts the last
// row from the end line too, which `jet fmt` writes when more follows it.
render_exit_codes: fn(rows: [ExitCode], prefix: String, word: Bool, parted: Bool) -> String Never! {
    lines := [String]{EXIT_CODES_BEGIN}
    first := true
    loop row in rows {
        if !first -> lines.push("")
        first = false
        loop line in row.doc -> lines.push("// {line}")
        value: if word -> "I64{{{row.value}}}" else -> row.value.copy()
        lines.push("{prefix}{row.name}: {value}")
    }
    if parted -> lines.push("")
    lines.push(EXIT_CODES_END)
    lines.join("\n")
}

// The release policy's table of the rows, between its generated region's
// two lines: the code, the name without `EXIT_`, and the comment as one line.
render_exit_code_table: fn(rows: [ExitCode]) -> String Never! {
    lines := [String]{EXIT_CODES_DOC_BEGIN, "| Code | Name | Meaning |", "|---:|---|---|"}
    loop row in rows {
        lines.push("| {row.value} | `{byte_tail(row.name, 5)}` | {row.doc.join(" ")} |")
    }
    lines.push(EXIT_CODES_DOC_END)
    lines.join("\n")
}

// The runtime's copy as runtime words, the test kit's as KIT_ constants,
// Core's as file-private constants in its generated region, and the release
// policy's table in its generated region.
read_exit_codes: fn() -[FS]> [GeneratedFile] GeneratorError! {
    source: files.read(EXIT_CODES_SOURCE_PATH) ?? return Err(generator_fail("cannot read {EXIT_CODES_SOURCE_PATH}: {err}"))
    rows: exit_code_rows(source) ?? return Err(err)
    core: files.read(EXIT_CODES_CORE_PATH) ?? return Err(generator_fail("cannot read {EXIT_CODES_CORE_PATH}: {err}"))
    core_text: splice_region(EXIT_CODES_CORE_PATH, core, EXIT_CODES_BEGIN, EXIT_CODES_END, "exit-code", render_exit_codes(rows, "priv ", false, true)) ?? return Err(err)
    doc: files.read(EXIT_CODES_DOC_PATH) ?? return Err(generator_fail("cannot read {EXIT_CODES_DOC_PATH}: {err}"))
    doc_text: splice_region(EXIT_CODES_DOC_PATH, doc, EXIT_CODES_DOC_BEGIN, EXIT_CODES_DOC_END, "exit-code", render_exit_code_table(rows)) ?? return Err(err)
    Ok(
        [GeneratedFile]{
            GeneratedFile{path: EXIT_CODES_RUNTIME_PATH, text: "{render_exit_codes(rows, "", true, false)}\n"},
            GeneratedFile{path: EXIT_CODES_KIT_PATH, text: "{render_exit_codes(rows, "KIT_", false, false)}\n"},
            GeneratedFile{path: EXIT_CODES_CORE_PATH, text: core_text},
            GeneratedFile{path: EXIT_CODES_DOC_PATH, text: doc_text},
        },
    )
}

// Whether `text` names an exit; with `code`, an exit code too. A name counts
// by its words, the runs of letters and digits, so `trap_exit`, `rt.exit` and
// `exit_code` name one while `decode_error` and `unicode` name none.
names_exit: fn(text: String, code: Bool) -> Bool Never! {
    lower: text.lower()
    bytes: lower.bytes()
    start := 0
    loop at in 0..<(bytes.len() + 1) {
        if at < bytes.len() && is_name_byte(Int{bytes[at]}) && (Int{bytes[at]}) != 95 -> next
        word: byte_slice(lower, start, at)
        if word.starts_with("exit") || (code && (word == "code" || word == "codes")) -> return true
        start = at + 1
    }
    false
}

// The offset of the innermost `(` still open at the end of `text`, or -1.
open_paren: fn(text: String) -> Int Never! {
    bytes: text.bytes()
    depth := 0
    at := bytes.len()
    loop at > 0 {
        at -= 1
        byte: Int{bytes[at]}
        if byte == 41 -> depth += 1 else if byte == 40 {
            if depth == 0 -> return at
            depth -= 1
        }
    }
    0 - 1
}

// The text after the last `(`, `,`, `{`, `&&` or `||` of `text`: the left
// operand of a comparison that ends it.
left_operand: fn(text: String) -> String Never! {
    bytes: text.bytes()
    at := bytes.len()
    loop at > 0 {
        byte: Int{bytes[at - 1]}
        if byte == 40 || byte == 44 || byte == 123 -> return byte_tail(text, at)
        if at >= 2 && (byte == 38 || byte == 124) && (Int{bytes[at - 2]}) == byte {
            return byte_tail(text, at)
        }
        at -= 1
    }
    text.copy()
}

// The name a line binds when it ends with `name:` or `name :=`, else "".
bound_name: fn(head: String) -> String Never! {
    name: if {
        head.ends_with(":=") -> byte_slice(head, 0, byte_len(head) - 2).trim()
        head.ends_with(":") -> byte_slice(head, 0, byte_len(head) - 1).trim()
        else -> ""
    }
    if leading_name(name) == name -> name else -> ""
}

// Whether the guarded status at bytes `start..<end` of `line` fills an exit
// position: an argument of a call whose callee names an exit or a code, or
// whose earlier argument names an exit; the right side of a comparison whose
// left side names an exit or is a `.code` field; or the whole value of a
// binding whose name names an exit or a code. A bare `code` compared to a
// number is left alone: errno tables and byte classes spell it so.
exit_position: fn(line: String, start: Int, end: Int) -> Bool Never! {
    before: byte_slice(line, 0, start)
    head: before.trim()
    if head.ends_with("==") || head.ends_with("!=") {
        left: left_operand(byte_slice(head, 0, byte_len(head) - 2)).trim()
        if names_exit(left, false) || left.ends_with(".code") -> return true
    }
    if byte_tail(line, end).trim() == "" && names_exit(bound_name(head), true) -> return true
    open: open_paren(before)
    if open < 0 -> return false
    bytes: before.bytes()
    callee := open
    loop callee > 0 && (is_name_byte(Int{bytes[callee - 1]}) || Int{bytes[callee - 1]} == 46) {
        callee -= 1
    }
    if callee == open -> return false
    names_exit(byte_slice(before, callee, open), true) || names_exit(byte_tail(before, open + 1), false)
}

// `path:line: ...` for each guarded status in an exit position of `source`,
// outside comments, literal text and generated exit-code regions.
exit_literal_problems: fn(path: String, source: String) -> [String] GeneratorError! {
    code: code_only(source) ?? return Err(generator_fail("{path}: {err.message}"))
    originals: source.split("\n").to_list()
    problems := [String]{}
    generated := false
    loop (index, line) in code.split("\n").to_list() {
        original: if index < originals.len() -> originals[index] else -> ""
        if original == EXIT_CODES_BEGIN -> generated = true
        if original == EXIT_CODES_END -> generated = false
        if generated -> next
        bytes: line.bytes()
        at := 0
        loop at < bytes.len() {
            if !is_digit_byte(Int{bytes[at]}) || (at > 0 && (is_name_byte(Int{bytes[at - 1]}) || Int{bytes[at - 1]} == 46)) {
                at += 1
                next
            }
            end := at
            loop end < bytes.len() && is_digit_byte(Int{bytes[end]}) -> end += 1
            number: byte_slice(line, at, end)
            following: code_at(bytes, end)
            if EXIT_GUARDED.contains(number) && following != 46 && !is_name_byte(following) {
                wrapped: at >= 4 && byte_slice(line, at - 4, at) == "I64{{" && following == 125
                start: if wrapped -> at - 4 else -> at
                stop: if wrapped -> end + 1 else -> end
                if exit_position(line, start, stop) {
                    problems.push("{path}:{index + 1}: a bare {number} fills an exit position; name it with the constant generated from {EXIT_CODES_SOURCE_PATH}")
                }
            }
            at = end
        }
    }
    Ok(problems)
}

exit_guard_files: fn(directory: String, found: &[String]) -[FS]> GeneratorError! {
    entries: files.list_dir(directory) ?? return Err(generator_fail("cannot list {directory}: {err}"))
    loop entry in entries {
        path: "{directory}/{entry.name}"
        if entry.is_dir {
            if !EXIT_GUARD_SKIPPED.contains(entry.name) && !EXIT_GUARD_UNBUILT.contains(path) && !entry.name.starts_with(".") && !entry.name.ends_with(".fixture") {
                exit_guard_files(path, found) ?? return Err(err)
            }
        } else if entry.name.ends_with(".jet") && path != EXIT_CODES_SOURCE_PATH {
            found.push(path)
        }
    }
    Ok()
}

// Every bare 70 or 101 in an exit position of the guarded trees.
exit_guard: fn() -[FS]> [String] GeneratorError! {
    paths := [String]{}
    loop root in EXIT_GUARD_ROOTS -> exit_guard_files(root, paths) ?? return Err(err)
    problems := [String]{}
    loop path in paths {
        source: files.read(path) ?? return Err(generator_fail("cannot read {path}: {err}"))
        loop problem in exit_literal_problems(path, source) ?? return Err(err) {
            problems.push(problem)
        }
    }
    Ok(problems)
}

#Test("the exit codes are the table's rows, as runtime words, kit constants and a Core region") {
    rows: exit_code_rows("// Header.\n\n// Fine.\nEXIT_OK: 0\n// A stop.\nEXIT_RUNTIME_PANIC: 70\n") ?? panic("rows did not parse: {err.message}")
    assert_eq(rows.len(), 2)
    assert_eq(render_exit_codes(rows, "KIT_", false, false), "{EXIT_CODES_BEGIN}\n// Fine.\nKIT_EXIT_OK: 0\n\n// A stop.\nKIT_EXIT_RUNTIME_PANIC: 70\n{EXIT_CODES_END}")
    assert(render_exit_codes(rows, "", true, false).contains("\nEXIT_RUNTIME_PANIC: I64{{70}}\n"))
    assert_eq(render_exit_codes(rows, "priv ", false, true), "{EXIT_CODES_BEGIN}\n// Fine.\npriv EXIT_OK: 0\n\n// A stop.\npriv EXIT_RUNTIME_PANIC: 70\n\n{EXIT_CODES_END}")
    assert_eq(render_exit_code_table(rows), "{EXIT_CODES_DOC_BEGIN}\n| Code | Name | Meaning |\n|---:|---|---|\n| 0 | `OK` | Fine. |\n| 70 | `RUNTIME_PANIC` | A stop. |\n{EXIT_CODES_DOC_END}")
    if exit_code_rows("EXIT_ICE: 1o1\n") == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> {
            assert_eq(error.message, "{EXIT_CODES_SOURCE_PATH}: unsupported line `EXIT_ICE: 1o1`")
        }
    }
}

#Test("a bare 70 or 101 in an exit position is a copy; bytes, errnos, HTTP statuses and named codes are not") {
    copies: "a: fn() {{\n    trap_exit(I64{{70}})\n    if run.code == 101 -> x()\n    rt.exit(if code == 101 -> 1 else -> code)\n    sync_store(exit_code_out, I64{{70}})\n    code := I64{{70}}\n}}\nJET_CLI_EXIT_ICE: 101\n"
    found: exit_literal_problems("p", copies) ?? panic(err.message)
    assert_eq(found.len(), 6)
    assert(found[0].starts_with("p:2: a bare 70 fills an exit position"))
    assert(found[5].starts_with("p:8: a bare 101 fills an exit position"))
    fine: "a: fn() {{\n    rt_text_push_word(target, I64{{101}}, I64{{1}})\n    if (rt_text_byte(base) == I64{{70}}) -> x()\n    scheduler_text_new(I64{{70}})\n    trap_exit(EXIT_RUNTIME_PANIC)\n    // exit 101\n    say(\"exit 70\")\n    say(``exit(101) ` and exit(70)``)\n    trap_exit(I64{{1701}})\n    (code == I64{{101}}) -> rt_static_text(\"NetworkUnreachable\")\n    out.push(if code == 69 -> U8{{101}} else -> byte)\n    hex: (code >= 65 && code <= 70) || (code >= 97 && code <= 102)\n    if reply.status == 101 -> x()\n    assert(__decode_error([U8]{{71, 73, 70, 56}}, limits) == .Unsupported)\n    glyph: unicode_name(101)\n}}\n{EXIT_CODES_BEGIN}\nEXIT_ICE: 101\n{EXIT_CODES_END}\n"
    assert_eq(exit_literal_problems("p", fine) ?? panic(err.message), [String]{})
}

// The process grants the native boundary can enforce. Their one home is
// AUTHORITY_PROCESS_GRANTS in JetFoundation's authority policy; the runtime,
// which imports no package, gets a generated copy: one accessor per grant,
// the enforceable-grant check, the program scope's spelling, and the rights
// `Authority.workspace()` holds.

PROCESS_GRANTS_SOURCE_PATH: "Compiler/JetFoundation/Source/Policy/Authority.jet"

PROCESS_GRANTS_RUNTIME_PATH: "Compiler/JetRuntime/Source/ProcessGrants.jet"

PROCESS_GRANTS_OPEN: "AUTHORITY_PROCESS_GRANTS: [AuthorityProcessGrant]{{"

PROCESS_GRANT_ROW: "AuthorityProcessGrant{{"

// One AUTHORITY_PROCESS_GRANTS row; `right` keeps its source escapes.
ProcessGrant: struct {
    name: String,
    right: String,
    workspace: Bool,
    program: Bool,
}

// The text of `row`'s `key: "..."` field with its escapes kept, if any.
grant_text_field: fn(row: String, key: String) -> String? Never! {
    at: row.find("{key}: \"")
    if at < 0 -> return None
    bytes: row.bytes()
    start: at + byte_len(key) + 3
    end := start
    loop end < bytes.len() && (Int{bytes[end]}) != 34 {
        if (Int{bytes[end]}) == 92 -> end += 2 else -> end += 1
    }
    if end >= bytes.len() -> return None
    Val(byte_slice(row, start, end))
}

// `row`'s `key: true` or `key: false` field, if any.
grant_bool_field: fn(row: String, key: String) -> Bool? Never! {
    if row.contains("{key}: true") -> return Val(true)
    if row.contains("{key}: false") -> return Val(false)
    None
}

unsupported_grant_row: fn(row: String) -> GeneratorError Never! {
    generator_fail("{PROCESS_GRANTS_SOURCE_PATH}: unsupported grant row `{row}`")
}

// The AUTHORITY_PROCESS_GRANTS rows of `source`, one per line. Exactly one
// row grants a program, a bare root, and at least one is a workspace right.
process_grant_rows: fn(source: String) -> [ProcessGrant] GeneratorError! {
    rows := [ProcessGrant]{}
    inside := false
    closed := false
    loop line in source.split("\n") {
        trimmed: line.trim()
        if !inside {
            inside = trimmed == PROCESS_GRANTS_OPEN
            next
        }
        if trimmed == "}}" {
            closed = true
            break
        }
        grant: trimmed.copy()
        if !grant.starts_with(PROCESS_GRANT_ROW) -> return Err(unsupported_grant_row(grant))
        name: grant_text_field(grant, "name") ?? return Err(unsupported_grant_row(grant))
        right: grant_text_field(grant, "right") ?? return Err(unsupported_grant_row(grant))
        workspace: grant_bool_field(grant, "workspace") ?? return Err(unsupported_grant_row(grant))
        program: grant_bool_field(grant, "program") ?? return Err(unsupported_grant_row(grant))
        if name == "" || leading_name(name) != name || right == "" {
            return Err(unsupported_grant_row(grant))
        }
        if program && leading_name(right) != right {
            return Err(generator_fail("{PROCESS_GRANTS_SOURCE_PATH}: the program grant `{right}` must be a bare root"))
        }
        rows.push(ProcessGrant{name: name, right: right, workspace: workspace, program: program})
    }
    if !closed || rows.len() == 0 {
        return Err(generator_fail("{PROCESS_GRANTS_SOURCE_PATH} has no AUTHORITY_PROCESS_GRANTS rows"))
    }
    programs := 0
    loop row in rows {
        if row.program -> programs += 1
    }
    if programs != 1 {
        return Err(generator_fail("{PROCESS_GRANTS_SOURCE_PATH}: exactly one AUTHORITY_PROCESS_GRANTS row grants a program"))
    }
    if !rows.any(fn(row) { row.workspace }) {
        return Err(generator_fail("{PROCESS_GRANTS_SOURCE_PATH}: no AUTHORITY_PROCESS_GRANTS row is a workspace right"))
    }
    Ok(rows)
}

// The runtime's generated grant source for `rows`: its items, each with its
// comment, a blank line apart.
render_process_grants: fn(rows: [ProcessGrant]) -> String Never! {
    head: "// Generated by Tools/Agent/RuntimeGenerators.jet from {PROCESS_GRANTS_SOURCE_PATH}; do not edit.\n// The grants the native process boundary can enforce (AUTHORITY_PROCESS_GRANTS)."
    items := [String]{}
    checks := [String]{}
    workspace := [String]{}
    program := ""
    loop row in rows {
        shown: row.right.replace("\\\"", "\"")
        items.push("// `{shown}`\n{fmt_block("", "process_grant_{row.name}: fn() -> I64", "    rt_static_text(\"{row.right}\")\n").trim_end()}")
        checks.push("jet_rt_string_eq(right, process_grant_{row.name}())")
        if row.workspace -> workspace.push("process_grant_{row.name}()")
        if row.program -> program = row.right.copy()
    }
    root: byte_len(program)
    items.push("// Where the program's path starts in an `{program}(\"...\")` grant, and the\n// grant's length beyond the path.\nPROCESS_GRANT_PROGRAM_START: I64{{{root + 2}}}")
    items.push("PROCESS_GRANT_PROGRAM_FRAME: I64{{{root + 4}}}")
    names_program: fmt_block("", "process_grant_names_program: fn(right: I64) -> Bool", "    authority_scope_open(right) == I64{{{root}}} && jet_string_starts_with(right, rt_static_text(\"{program}(\\\"\"))\n")
    items.push("// Whether `right` grants one program, `{program}(\"...\")`.\n{names_program.trim_end()}")
    checks.push("(process_grant_names_program(right) && rt_text_len(right) > PROCESS_GRANT_PROGRAM_FRAME)")
    items.push("// Whether the native process boundary can enforce `right`.\nprocess_grant_enforceable: fn(right: I64) -> Bool {{\n    {checks.join(" || ")}\n}}")
    items.push("// How many rights `Authority.workspace()` holds, and the one at `index`, in\n// row order.\nPROCESS_GRANT_WORKSPACE_COUNT: I64{{{workspace.len()}}}")
    choose := ""
    loop (index, accessor) in workspace {
        if index + 1 < workspace.len() {
            choose = "{choose}{fmt_block("    ", "if (index == I64{{{index}}})", "        return {accessor}\n")}"
        }
    }
    items.push("process_grant_workspace: fn(index: I64) -> I64 {{\n{choose}    {workspace[workspace.len() - 1]}\n}}")
    "{head}\n{items.join("\n\n")}\n"
}

read_process_grants: fn() -[FS]> String GeneratorError! {
    source: files.read(PROCESS_GRANTS_SOURCE_PATH) ?? return Err(generator_fail("cannot read {PROCESS_GRANTS_SOURCE_PATH}: {err}"))
    rows: process_grant_rows(source) ?? return Err(err)
    Ok(render_process_grants(rows))
}

#Test("process grant rows render the runtime's accessors, check, program scope and workspace rights") {
    source: "x\n{PROCESS_GRANTS_OPEN}\n    AuthorityProcessGrant{{name: \"read\", right: \"FS.Read(\\\"repo\\\")\", workspace: true, program: false}},\n    AuthorityProcessGrant{{name: \"exec\", right: \"Exec\", workspace: false, program: true}},\n}}\n"
    rows: process_grant_rows(source) ?? panic(err.message)
    assert_eq(rows.len(), 2)
    assert_eq(rows[0].right, "FS.Read(\\\"repo\\\")")
    text: render_process_grants(rows)
    assert(text.contains("process_grant_read: fn() -> I64 {{ rt_static_text(\"FS.Read(\\\"repo\\\")\") }}\n"))
    assert(text.contains("PROCESS_GRANT_PROGRAM_START: I64{{6}}\n\nPROCESS_GRANT_PROGRAM_FRAME: I64{{8}}\n"))
    assert(text.contains("authority_scope_open(right) == I64{{4}} && jet_string_starts_with(right, rt_static_text(\"Exec(\\\"\"))"))
    assert(text.contains("    jet_rt_string_eq(right, process_grant_read()) || jet_rt_string_eq(right, process_grant_exec()) || (process_grant_names_program(right) && rt_text_len(right) > PROCESS_GRANT_PROGRAM_FRAME)\n"))
    assert(text.contains("PROCESS_GRANT_WORKSPACE_COUNT: I64{{1}}\n\nprocess_grant_workspace: fn(index: I64) -> I64 {{\n    process_grant_read()\n}}\n"))
}

#Test("a process grant row the generator can't read, or a second program row, is refused") {
    odd: "{PROCESS_GRANTS_OPEN}\n    AuthorityProcessGrant{{name: \"read\", right: SOME_RIGHT, workspace: true, program: false}},\n}}\n"
    if process_grant_rows(odd) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert(error.message.contains("unsupported grant row"))
    }
    two: "{PROCESS_GRANTS_OPEN}\n    AuthorityProcessGrant{{name: \"a\", right: \"Exec\", workspace: true, program: true}},\n    AuthorityProcessGrant{{name: \"b\", right: \"Net\", workspace: false, program: true}},\n}}\n"
    if process_grant_rows(two) == {
        .Ok(_) -> { assert(false) }
        .Err(error) -> assert(error.message.contains("exactly one"))
    }
}
