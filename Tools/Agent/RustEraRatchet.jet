#!/usr/bin/env jet
// Rust-era ratchet: the deleted Rust tree leaves no data or citations behind.
//
// 1. Every harness data table directly under tests/ (`*.tsv`, `*.txt`) and
//    under Tools/CI/ has a reader: some tracked source file other than the
//    table itself names it. Docs and Markdown describe tables; they do not
//    read them.
// 2. No comment in a tracked Jet or C source under Compiler/, Core/ or
//    Jetpack/ cites deleted Rust code: it names no `.rs` file and says no
//    "Rust code", "Rust crate", "Rust prelude" or "Rust checker". The Rust
//    sources are gone, so such a citation points nowhere. A path into the
//    pinned upstream Rust library (`library/std/`, `library/core/`,
//    `library/alloc/`) stays: it is a real external input. Code and strings
//    are not comments: the foreign bindings write and read real Rust files.
// 3. No comment in those sources names Rust at all, unless Rust is a foreign
//    language Jet talks to or measures itself against there: a file with a
//    `Rust…` or `…Foreign…` path segment (RustForeign, RustBridge, RustSource,
//    the Foreign/ binders), a Gauntlet or Perf folder, or a comment about
//    `extern rust`, cargo, rustc, crates.io, an rlib, the Rust toolchain, the
//    Rust ABI or FFI, or the Rust-mangled symbols the runtime pack rejects.
//    Any other comment states the contract itself: Jet is the original, so
//    "as the Rust host did" points nowhere. Until every package is
//    rewritten, NAMING_BASELINE holds each file's count, which may only fall.
//
// Usage (from the repository root): jet Tools/Agent/RustEraRatchet.jet
// checks; `--write` lowers the NAMING_BASELINE rows to the live counts (and
// seeds the table when it is missing), and refuses while a file is over its
// row.
use {
    files: core.files
    process: core.process
    term: core.term
}

DATA_ROOTS: [String]{"Tests", "Tools/CI"}

DATA_SUFFIXES: [String]{".tsv", ".txt"}

CITATION_ROOTS: [String]{"Compiler", "Core", "Jetpack"}

SOURCE_SUFFIXES: [String]{".jet", ".c", ".h"}

// git grep -i -E prefilter (POSIX ERE): a line naming `<word>.rs`, line
// numbers glued on (`Layout.rs61-85`) included, or naming a Rust code body.
CITATION_GREP: "[A-Za-z0-9_]\\.rs([^A-Za-z_]|$)"

PHRASE_GREP: "rust (code|crate|prelude|checker)"

UPSTREAM_LIBRARY: Regex{"library/(?:std|core|alloc)/"}

CITATION: Regex{"\w\.rs(?:[^A-Za-z_]|$)"}

// Matched against the lowercased comment.
PHRASE: Regex{"\brust (?:code\b|crates?\b|prelude|checker)"}

// Each file's count of comments that name Rust (rule 3), one `path<TAB>count`
// row per file; a file with no row has none.
NAMING_BASELINE: "Tests/Guards/rust_era_names.tsv"

NAMES_RUST: Regex{"\brust\b"}

// Matched against the lowercased comment: Rust as the foreign language.
FOREIGN_PHRASE: Regex{"extern rust|externrust|\bcargo\b|\brustc\b|crates\.io|\brlib\b|rust toolchain|foreign rust|rust ffi|rust[- ]abi|rust-mangled|\brust symbols?\b|\b(?:bridge|helper) crates?\b"}

#Error
RatchetError: struct {
    message: String,
}

// The stdout lines of a git command; `allow_empty` accepts git grep's exit 1
// (no match) as no lines.
git_lines: fn(argv: [String], allow_empty: Bool) -[Exec, IO, Time.Wait]> [String] RatchetError! {
    receipt: process.cmd(argv).stdout(.Capture).stderr(.Capture).run() ?? return Err(RatchetError{message: "cannot run {argv.join(" ")}: {err}"})
    if allow_empty && receipt.code == 1 && receipt.errors == "" -> return Ok([String]{})
    if receipt.code != 0 {
        return Err(RatchetError{message: "{argv.join(" ")} failed ({receipt.code}): {receipt.errors}"})
    }
    ^lines: [String]{}
    loop line in receipt.output.split("\n") {
        if line != "" -> lines.push(line.copy())
    }
    Ok(lines)
}

base_name: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    if split.sep == "" -> return path.copy()
    split.tail.copy()
}

// A harness table: a `.tsv` or `.txt` directly in tests/, or anywhere under
// Tools/CI/.
is_harness_table: fn(path: String) -> Bool Never! {
    ^suffixed: false
    loop suffix in DATA_SUFFIXES {
        if path.ends_with(suffix) -> suffixed = true
    }
    if !suffixed -> return false
    if path.starts_with("Tools/CI/") -> return true
    path.starts_with("Tests/") && !path.remove_prefix("Tests/").contains("/")
}

// Whether `path`, a tracked file that names `table`, reads it.
is_reader: fn(table: String, path: String) -> Bool Never! {
    path != table && !path.starts_with("Docs/") && !path.ends_with(".md")
}

unread_tables: fn() -[Exec, IO, Time.Wait]> [String] RatchetError! {
    ^argv: [String]{"git", "ls-files", "--"}
    loop root in DATA_ROOTS -> argv.push(root)
    ^unread: [String]{}
    loop table in git_lines(argv, false) ?? return Err(err) {
        if !is_harness_table(table) -> next
        naming: git_lines([String]{"git", "grep", "-l", "-I", "-F", "-e", base_name(table), "--", "."}, true) ?? return Err(err)
        ^read: false
        loop path in naming {
            if is_reader(table, path) -> read = true
        }
        if !read -> unread.push(table.copy())
    }
    Ok(unread)
}

is_source: fn(path: String) -> Bool Never! {
    loop suffix in SOURCE_SUFFIXES {
        if path.ends_with(suffix) -> return true
    }
    false
}

// Whether `prefix`, the code before a `//`, leaves no string literal open.
closes_strings: fn(prefix: String) -> Bool Never! {
    plain: prefix.replace("\\\\", "").replace("\\\"", "")
    (plain.split("\"").len() - 1) % 2 == 0
}

// The comment of a source line: from the first `//` that starts the line or
// follows whitespace outside a string literal, else "".
comment_text: fn(line: String) -> String Never! {
    ^prefix: ""
    ^comment: ""
    ^first: true
    loop part in line.split("//") {
        if comment != "" {
            comment = "{comment}//{part}"
            next
        }
        starts: prefix.trim() == "" || prefix.ends_with(" ") || prefix.ends_with("\t")
        if !first && starts && closes_strings(prefix) {
            comment = "//{part}"
            next
        }
        prefix = if first -> part.copy() else -> "{prefix}//{part}"
        first = false
    }
    comment
}

// Whether a comment cites deleted Rust code.
cites_rust: fn(comment: String) -> Bool Never! {
    if CITATION.is_match(comment) && !UPSTREAM_LIBRARY.is_match(comment) -> return true
    PHRASE.is_match(comment.lower())
}

// `path:line:text` rows of git grep -n whose comment cites deleted Rust code.
stale_citations: fn(rows: [String]) -> [String] Never! {
    ^stale: [String]{}
    loop row in rows {
        location: row.partition(":")
        rest: location.tail.partition(":")
        if !is_source(location.head) || !cites_rust(comment_text(rest.tail)) -> next
        stale.push(row.copy())
    }
    stale
}

citation_rows: fn() -[Exec, IO, Time.Wait]> [String] RatchetError! {
    ^argv: [String]{"git", "grep", "-n", "-I", "-i", "-E", "-e", CITATION_GREP, "-e", PHRASE_GREP, "--"}
    loop root in CITATION_ROOTS -> argv.push(root)
    git_lines(argv, true)
}

// Whether `path` is a file where Rust is a foreign language: a `Rust…` or
// `…Foreign…` segment, a Gauntlet or Perf folder, or a runtime pack, which
// rejects Rust symbols.
foreign_path: fn(path: String) -> Bool Never! {
    loop segment in path.split("/") {
        if segment.starts_with("Rust") || segment.contains("Foreign") -> return true
        if segment == "Gauntlet" || segment == "Perf" || segment == "RuntimePack.jet" -> return true
    }
    false
}

// Whether a comment of `path` names Rust where Rust is not the foreign
// language (rule 3).
names_rust: fn(path: String, comment: String) -> Bool Never! {
    lowered: comment.lower()
    NAMES_RUST.is_match(lowered) && !FOREIGN_PHRASE.is_match(lowered) && !foreign_path(path)
}

// Each source file's count of comments that name Rust, from `path:line:text`
// rows of git grep -n.
naming_counts: fn(rows: [String]) -> [String:Int] Never! {
    ^counts: [String:Int]{}
    loop row in rows {
        location: row.partition(":")
        rest: location.tail.partition(":")
        if !is_source(location.head) || !names_rust(location.head, comment_text(rest.tail)) -> next
        counts[location.head] = (counts.get(location.head) ?? 0) + 1
    }
    counts
}

naming_rows: fn() -[Exec, IO, Time.Wait]> [String] RatchetError! {
    ^argv: [String]{"git", "grep", "-n", "-I", "-i", "-w", "-e", "rust", "--"}
    loop root in CITATION_ROOTS -> argv.push(root)
    git_lines(argv, true)
}

// The NAMING_BASELINE rows of `text`; a line is `path<TAB>count`.
parse_baseline: fn(text: String) -> [String:Int] RatchetError! {
    ^rows: [String:Int]{}
    loop line in text.split("\n") {
        if line.trim() == "" -> next
        cells: line.partition("\t")
        count: Int.parse(cells.tail) ?? return Err(RatchetError{message: "{NAMING_BASELINE}: unparsed line `{line}`"})
        rows[cells.head] = count
    }
    Ok(rows)
}

render_baseline: fn(counts: [String:Int]) -> String Never! {
    ^paths: counts.keys().to_list()
    paths.sort()
    ^lines: loop path in paths -> "{path}\t{counts.get(path) ?? 0}"
    if lines.len() == 0 -> return ""
    "{lines.join("\n")}\n"
}

// A line per file over its baseline row (rule 3).
naming_over: fn(counts: [String:Int], baseline: [String:Int]) -> [String] Never! {
    ^paths: counts.keys().to_list()
    paths.sort()
    ^over: [String]{}
    loop path in paths {
        count: counts.get(path) ?? 0
        limit: baseline.get(path) ?? 0
        if count > limit {
            over.push("{path}: {count} comment(s) name Rust, over its baseline of {limit}; state the contract itself, not the Rust original")
        }
    }
    over
}

// A line per baseline row above its file's live count.
naming_under: fn(counts: [String:Int], baseline: [String:Int]) -> [String] Never! {
    ^paths: baseline.keys().to_list()
    paths.sort()
    ^under: [String]{}
    loop path in paths {
        count: counts.get(path) ?? 0
        limit: baseline.get(path) ?? 0
        if count < limit {
            under.push("{path}: {count} comment(s) name Rust, under its baseline of {limit}; lower the row (jet Tools/Agent/RustEraRatchet.jet --write)")
        }
    }
    under
}

rust_era_main: fn(write: Bool) -[Exec, FS, IO, Time.Wait]> Int RatchetError! {
    unread: unread_tables() ?? return Err(err)
    stale: stale_citations(citation_rows() ?? return Err(err))
    counts: naming_counts(naming_rows() ?? return Err(err))
    seeded: files.is_file(NAMING_BASELINE)
    ^baseline: [String:Int]{}
    if seeded {
        text: files.read(NAMING_BASELINE) ?? return Err(RatchetError{message: "cannot read {NAMING_BASELINE}: {err}"})
        baseline = parse_baseline(text) ?? return Err(err)
    }
    over: if seeded || !write -> naming_over(counts, baseline) else -> [String]{}
    ^under: [String]{}
    if write && over.len() == 0 {
        files.write(NAMING_BASELINE, render_baseline(counts)) ?? return Err(RatchetError{message: "cannot write {NAMING_BASELINE}: {err}"})
    } else { under = naming_under(counts, baseline) }
    if unread.len() == 0 && stale.len() == 0 && over.len() == 0 && under.len() == 0 {
        ^total: 0
        loop path in counts.keys() -> total += counts.get(path) ?? 0
        print("rust-era-ratchet: ok (every harness table has a reader; no comment in Compiler, Core or Jetpack cites deleted Rust code; {total} comment(s) naming Rust remain in {NAMING_BASELINE})")
        return Ok(0)
    }
    loop table in unread {
        term.eprint("{table}: no tracked source reads this table; delete it or add its reader")
    }
    loop row in stale {
        term.eprint("{row}: cites deleted Rust code; name the live Jet owner or drop it")
    }
    loop line in over -> term.eprint(line)
    loop line in under -> term.eprint(line)
    term.eprint("rust-era-ratchet: {unread.len()} unread table(s), {stale.len()} stale citation(s), {over.len()} file(s) over and {under.len()} under their Rust-naming baseline")
    Ok(1)
}

run: fn() {
    args: process.args()
    write: args.len() == 1 && args[0] == "--write"
    if args.len() > 0 && !write {
        process.fail(64, "usage: jet Tools/Agent/RustEraRatchet.jet [--write]")
    }
    code: rust_era_main(write) ?? process.fail(1, err.message)
    if code != 0 -> process.exit(code)
}

#Test("harness tables are top-level tests/ tables and Tools/CI tables") {
    assert(is_harness_table("Tests/corpus_policy.tsv"))
    assert(is_harness_table("Tests/diagnostics_coverage_baseline.txt"))
    assert(is_harness_table("Tools/CI/test-weights.tsv"))
    assert(!is_harness_table("Tests/Cases/x/expected.txt"))
    assert(!is_harness_table("Tests/Guards/corpus_policy.jet"))
}

#Test("documents do not count as readers") {
    assert(is_reader("Tests/a.tsv", "Tests/Guards/a.jet"))
    assert(!is_reader("Tests/a.tsv", "Tests/a.tsv"))
    assert(!is_reader("Tests/a.tsv", "Docs/Audits/a.md"))
    assert(!is_reader("Tests/a.tsv", "README.md"))
}

#Test("a comment starts at a // outside string literals") {
    assert_eq(comment_text("// whole line"), "// whole line")
    assert_eq(comment_text("    x: 1 // trailing // twice"), "// trailing // twice")
    assert_eq(comment_text("    url: \"https://a.rs/x\""), "")
    assert_eq(comment_text("    url: \"https://a\" // note"), "// note")
    assert_eq(comment_text("    q: \"say \\\"// no\\\"\" // yes"), "// yes")
    assert_eq(comment_text("    path: a//b"), "")
}

#Test("comments citing deleted Rust code are stale; code, strings and the upstream library are not") {
    rows: [String]{
        "Compiler/A.jet:3:// Rust: crates/jet-cli/src/Lock.rs:12",
        "Compiler/B.jet:9:    /// See CmdFlash.rs `identity`.",
        "Core/C.jet:4:// Rust 1.90.0 library/std/src/sys/env/unix.rs, env()::parse:",
        "Compiler/D.jet:7:    seed: \"crates/x/src/Layout.rs\"",
        "Compiler/E.jet:2:// The term rs.trust is unrelated.",
        "Compiler/F.jet:1:// Layout.rs61-85: native fields.",
        "Jetpack/G.jet:5:    write(src, \"lib.rs\") // the generated crate root",
        "Jetpack/H.jet:2:// Ported from the Rust code of the old store.",
        "Jetpack/I.jet:8:    x: 1 // as the rust crate did",
        "Core/J.c:3:// Matches the Rust prelude's rounding.",
        "Compiler/K.jet:4:// Rust CheckerMarkers order.",
        "Compiler/L.jet:6:// An `extern rust` crate builds with cargo.",
        "Jetpack/M.jet:3:// Rust codegen is a foreign binding.",
        "Jetpack/N.md:1:// Layout.rs",
    }
    assert_eq(stale_citations(rows).join("|"), "Compiler/A.jet:3:// Rust: crates/jet-cli/src/Lock.rs:12|Compiler/B.jet:9:    /// See CmdFlash.rs `identity`.|Compiler/F.jet:1:// Layout.rs61-85: native fields.|Jetpack/H.jet:2:// Ported from the Rust code of the old store.|Jetpack/I.jet:8:    x: 1 // as the rust crate did|Core/J.c:3:// Matches the Rust prelude's rounding.|Compiler/K.jet:4:// Rust CheckerMarkers order.")
}

#Test("a comment naming Rust counts unless Rust is the foreign language there") {
    rows: [String]{
        "Compiler/A.jet:3:// Rust `named_leaf`: the last `.` segment.",
        "Compiler/A.jet:9:    x: 1 // as the Rust reference does",
        "Compiler/B.jet:4:    note: \"the Rust host\"",
        "Compiler/B.jet:5:// Trusted and rusty are other words.",
        "Compiler/C.jet:6:// An `extern rust` function calls through its slot.",
        "Compiler/C.jet:7:// cargo builds the bridge crate.",
        "Compiler/C.jet:8:// Not a Rust-mangled name (`_R...`).",
        "Compiler/JetCLI/Source/CLI/RustForeign.jet:1:// The Rust helper plan.",
        "Jetpack/Integrations/Source/Foreign/RustBridge/Externs.jet:4:// Rust ABI rows.",
        "Compiler/Toolchain/RuntimePack.jet:28:// No Rust runtime runs.",
        "Core/D.c:2:// RUST parity.",
        "Core/E.md:1:// Rust parity.",
    }
    counts: naming_counts(rows)
    assert_eq(render_baseline(counts), "Compiler/A.jet\t2\nCore/D.c\t1\n")
}

#Test("the Rust-naming baseline only falls") {
    baseline: parse_baseline("Compiler/A.jet\t2\nCore/D.c\t1\n") ?? panic("parse: {err.message}")
    assert_eq(render_baseline(baseline), "Compiler/A.jet\t2\nCore/D.c\t1\n")
    ^live: [String:Int]{}
    live["Compiler/A.jet"] = 3
    live["Compiler/New.jet"] = 1
    assert_eq(naming_over(live, baseline).len(), 2)
    assert_eq(naming_under(live, baseline).len(), 1)
    unparsed: parse_baseline("Compiler/A.jet\tmany\n") ?? [String:Int]{}
    assert_eq(unparsed.len(), 0)
    assert_eq(render_baseline([String:Int]{}), "")
}
