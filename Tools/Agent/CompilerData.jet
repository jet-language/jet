#!/usr/bin/env jet
// The compiler-data ratchet (#6793; the contract is Docs/Spec/compiler-data.md).
// The compile pipeline's packages move their data to id-keyed columns, so
// each of their source files may hold no more text-keyed lookups, `Shared<`
// cells and payload enums than its ledger row names, and a file with no row
// holds none. A text-keyed lookup is a map, set or tally keyed by `String`.
// A payload enum is an enum declaration with a variant that carries a
// payload: each of its values is a counted heap box. Counts are of the
// source text, comments included, so a count falls only when the code
// changes. A count never rises: `--check` refuses a file above its row, and
// a file below its row until the row is lowered; `--write` lowers the rows
// to the counts and refuses a rise.
//
// Usage (from the repository root):
//   jet Tools/Agent/CompilerData.jet [--check]   compare the tree with the ledger
//   jet Tools/Agent/CompilerData.jet --write     lower the ledger to the tree
use {
    files: core.files
    process: core.process
    term: core.term
}

// The pipeline packages whose `Source` holds compiler data.
COMPILER_DATA_PACKAGES: [String]{"JetLexer", "JetParser", "JetFoundation", "JetSema", "JetIR", "JetBackend", "JetDriver", "JetEval", "JetWasm"}

COMPILER_DATA_LEDGER: "Tests/compiler_data.tsv"

COMPILER_DATA_TEXT_KEYS: [String]{"[String:", "Set<String", "Tally<String"}

COMPILER_DATA_SHARED: "Shared<"

COMPILER_DATA_HEADER: "# The compiler-data ledger (Tools/Agent/CompilerData.jet): each compiler-data\n# source file and the most text-keyed lookups, Shared cells and payload enums\n# it may hold. A file with no row holds none. Rows only go down.\n# path\ttext_keys\tshared\tpayload_enums"

#Error
CompilerDataError: struct {
    message: String,
}

// One file's counts.
CompilerDataCounts: struct {
    text_keys: Int,
    shared: Int,
    payload_enums: Int,
}

compiler_data_occurrences: fn(text: String, needle: String) -> Int {
    text.split(needle).to_list().len() - 1
}

// The census reads a source's enums as tokens, never as lines, so an enum
// counts the same however its source is laid out: one line or many, any
// indentation, several variants to a line.
COMPILER_DATA_WORD: 1

COMPILER_DATA_PUNCT: 2

COMPILER_DATA_OTHER: 3

COMPILER_DATA_END: 0

// One token: its kind and its bytes `start..<end`. Strings, character
// literals and comments are OTHER, so their braces never count.
CompilerDataToken: struct {
    kind: Int,
    start: Int,
    end: Int,
}

compiler_data_at: fn(bytes: [U8], index: Int) -> Int {
    if index < 0 || index >= bytes.len() -> return 0
    Int{bytes[index]}
}

compiler_data_word_byte: fn(value: Int) -> Bool {
    value >= 128 || value == 95 || (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

// The index after the raw string whose backtick fence starts at `start`.
compiler_data_raw_end: fn(bytes: [U8], start: Int) -> Int {
    fence := 0
    loop compiler_data_at(bytes, start + fence) == 96 -> fence += 1
    cursor := start + fence
    loop cursor < bytes.len() {
        if compiler_data_at(bytes, cursor) != 96 {
            cursor += 1
            next
        }
        run: cursor
        loop compiler_data_at(bytes, cursor) == 96 -> cursor += 1
        if cursor - run == fence -> return cursor
    }
    bytes.len()
}

// The index after the `{…}` interpolation that opens at `open` inside a
// plain string; one left open at its line end ends there.
compiler_data_interpolation_end: fn(bytes: [U8], open: Int) -> Int {
    cursor := open + 1
    depth := 1
    loop cursor < bytes.len() {
        value: compiler_data_at(bytes, cursor)
        if value == 34 {
            cursor = compiler_data_string_end(bytes, cursor)
            next
        }
        if value == 96 {
            cursor = compiler_data_raw_end(bytes, cursor)
            next
        }
        if value == 10 -> return cursor
        if value == 123 -> depth += 1
        if value == 125 {
            depth -= 1
            if depth == 0 -> return cursor + 1
        }
        cursor += 1
    }
    bytes.len()
}

// The index after the string whose quote is at `start`: a `"""` string runs
// to its closing `"""`; a plain one skips `\` escapes, `{{` and `{…}`
// interpolations, and ends at its closing quote or its line end.
compiler_data_string_end: fn(bytes: [U8], start: Int) -> Int {
    triple: compiler_data_at(bytes, start + 1) == 34 && compiler_data_at(bytes, start + 2) == 34
    cursor := if triple -> start + 3 else -> start + 1
    loop cursor < bytes.len() {
        value: compiler_data_at(bytes, cursor)
        if value == 92 {
            cursor += 2
            next
        }
        if triple {
            if value == 34 && compiler_data_at(bytes, cursor + 1) == 34 && compiler_data_at(bytes, cursor + 2) == 34 {
                return cursor + 3
            }
            cursor += 1
            next
        }
        if value == 123 && compiler_data_at(bytes, cursor + 1) == 123 {
            cursor += 2
            next
        }
        if value == 123 {
            cursor = compiler_data_interpolation_end(bytes, cursor)
            next
        }
        if value == 34 -> return cursor + 1
        if value == 10 -> return cursor
        cursor += 1
    }
    bytes.len()
}

// The index after the character literal whose quote is at `start`, or just
// past the quote when none closes on its line within a scalar's width.
compiler_data_char_end: fn(bytes: [U8], start: Int) -> Int {
    cursor := start + 1
    loop cursor < bytes.len() && cursor <= start + 12 {
        value: compiler_data_at(bytes, cursor)
        if value == 10 -> break
        if value == 92 {
            cursor += 2
            next
        }
        if value == 39 -> return cursor + 1
        cursor += 1
    }
    start + 1
}

// The next token at or after `from` that is not a comment; blank space is
// skipped.
compiler_data_token: fn(bytes: [U8], from: Int) -> CompilerDataToken {
    cursor := from
    loop cursor < bytes.len() {
        value: compiler_data_at(bytes, cursor)
        if value == 32 || value == 9 || value == 10 || value == 13 {
            cursor += 1
            next
        }
        if value == 47 && compiler_data_at(bytes, cursor + 1) == 47 {
            loop cursor < bytes.len() && compiler_data_at(bytes, cursor) != 10 -> cursor += 1
            next
        }
        if value == 47 && compiler_data_at(bytes, cursor + 1) == 42 {
            cursor += 2
            depth := 1
            loop cursor < bytes.len() && depth > 0 {
                if compiler_data_at(bytes, cursor) == 47 && compiler_data_at(bytes, cursor + 1) == 42 {
                    depth += 1
                    cursor += 2
                } else if compiler_data_at(bytes, cursor) == 42 && compiler_data_at(bytes, cursor + 1) == 47 {
                    depth -= 1
                    cursor += 2
                } else { cursor += 1 }
            }
            next
        }
        if value == 34 {
            return CompilerDataToken{kind: COMPILER_DATA_OTHER, start: cursor, end: compiler_data_string_end(bytes, cursor)}
        }
        if value == 96 {
            return CompilerDataToken{kind: COMPILER_DATA_OTHER, start: cursor, end: compiler_data_raw_end(bytes, cursor)}
        }
        if value == 39 {
            return CompilerDataToken{kind: COMPILER_DATA_OTHER, start: cursor, end: compiler_data_char_end(bytes, cursor)}
        }
        if compiler_data_word_byte(value) {
            end := cursor + 1
            loop end < bytes.len() && compiler_data_word_byte(compiler_data_at(bytes, end)) {
                end += 1
            }
            return CompilerDataToken{kind: COMPILER_DATA_WORD, start: cursor, end: end}
        }
        return CompilerDataToken{kind: COMPILER_DATA_PUNCT, start: cursor, end: cursor + 1}
    }
    CompilerDataToken{kind: COMPILER_DATA_END, start: bytes.len(), end: bytes.len()}
}

compiler_data_is_punct: fn(bytes: [U8], token: CompilerDataToken, value: Int) -> Bool {
    token.kind == COMPILER_DATA_PUNCT && compiler_data_at(bytes, token.start) == value
}

compiler_data_is_upper_word: fn(bytes: [U8], token: CompilerDataToken) -> Bool {
    first: compiler_data_at(bytes, token.start)
    token.kind == COMPILER_DATA_WORD && first >= 65 && first <= 90
}

compiler_data_is_word: fn(bytes: [U8], token: CompilerDataToken, word: String) -> Bool {
    spelled: word.bytes()
    if token.kind != COMPILER_DATA_WORD || token.end - token.start != spelled.len() -> return false
    loop index in 0..<spelled.len() {
        if bytes[token.start + index] != spelled[index] -> return false
    }
    true
}

// The index just past the `>` closing the type parameters that open at
// `open`, or -1 when they do not close.
compiler_data_params_end: fn(bytes: [U8], open: CompilerDataToken) -> Int {
    depth := 0
    cursor := open.start
    loop {
        token: compiler_data_token(bytes, cursor)
        if token.kind == COMPILER_DATA_END -> return -1
        cursor = token.end
        if compiler_data_is_punct(bytes, token, 60) -> depth += 1
        if compiler_data_is_punct(bytes, token, 62) {
            depth -= 1
            if depth == 0 -> return cursor
        }
        if compiler_data_is_punct(bytes, token, 123) || compiler_data_is_punct(bytes, token, 125) {
            return -1
        }
    }
}

// Whether the enum body that starts just past its `{` at `from` has a
// variant with a `(` payload, and the index just past the body's `}`. A
// variant stands where a member may: at the body's start, after a `,`, a
// marker, or another variant and its payload; never after a method, an
// `impl` or a discriminant.
compiler_data_enum_body: fn(bytes: [U8], from: Int) -> {payload: Bool, end: Int} {
    cursor := from
    depth := 1
    member := true
    resume := false
    hash := false
    payload := false
    loop {
        token: compiler_data_token(bytes, cursor)
        if token.kind == COMPILER_DATA_END -> return {payload: payload, end: cursor}
        cursor = token.end
        value: if token.kind == COMPILER_DATA_PUNCT -> compiler_data_at(bytes, token.start) else -> 0
        if value == 123 || value == 40 || value == 91 {
            if depth == 1 {
                resume = member
                hash = false
            }
            depth += 1
            next
        }
        if value == 125 || value == 41 || value == 93 {
            depth -= 1
            if depth == 0 -> return {payload: payload, end: cursor}
            if depth == 1 -> member = resume
            next
        }
        if depth > 1 -> next
        if token.kind == COMPILER_DATA_WORD {
            if hash {
                hash = false
                next
            }
            if member && compiler_data_is_upper_word(bytes, token) {
                after: compiler_data_token(bytes, token.end)
                if compiler_data_is_punct(bytes, after, 58) {
                    member = false
                    next
                }
                if compiler_data_is_punct(bytes, after, 40) && after.start == token.end {
                    payload = true
                }
                next
            }
            member = false
            next
        }
        if value == 44 {
            member = true
            next
        }
        if value == 35 && member {
            hash = true
            next
        }
        member = false
    }
}

// The top-level enum declarations in `text` with a variant that carries a
// `(` payload: `Name: enum {…}` or `Name<T>: enum {…}`.
compiler_data_payload_enums: fn(text: String) -> Int {
    bytes: text.bytes()
    count := 0
    depth := 0
    // Whether the depth-0 token before keeps the next word from naming a
    // declaration: `priv`, `pub` or a `.`.
    held := false
    cursor := 0
    loop {
        token: compiler_data_token(bytes, cursor)
        if token.kind == COMPILER_DATA_END -> break
        cursor = token.end
        if token.kind == COMPILER_DATA_PUNCT {
            value: compiler_data_at(bytes, token.start)
            if value == 123 || value == 40 || value == 91 -> depth += 1
            if (value == 125 || value == 41 || value == 93) && depth > 0 -> depth -= 1
            held = value == 46
            next
        }
        if depth > 0 -> next
        word: token.kind == COMPILER_DATA_WORD
        if word && !held && compiler_data_is_upper_word(bytes, token) {
            colon := compiler_data_token(bytes, token.end)
            if compiler_data_is_punct(bytes, colon, 60) && colon.start == token.end {
                params_end: compiler_data_params_end(bytes, colon)
                if params_end >= 0 -> colon = compiler_data_token(bytes, params_end)
            }
            head: compiler_data_token(bytes, colon.end)
            open: compiler_data_token(bytes, head.end)
            if compiler_data_is_punct(bytes, colon, 58) && compiler_data_is_word(bytes, head, "enum") && compiler_data_is_punct(bytes, open, 123) {
                body: compiler_data_enum_body(bytes, open.end)
                if body.payload -> count += 1
                cursor = body.end
                next
            }
        }
        held = compiler_data_is_word(bytes, token, "priv") || compiler_data_is_word(bytes, token, "pub")
    }
    count
}

compiler_data_counts: fn(text: String) -> CompilerDataCounts {
    text_keys := 0
    loop needle in COMPILER_DATA_TEXT_KEYS -> text_keys += compiler_data_occurrences(text, needle)
    CompilerDataCounts{text_keys: text_keys, shared: compiler_data_occurrences(text, COMPILER_DATA_SHARED), payload_enums: compiler_data_payload_enums(text)}
}

compiler_data_empty: fn(counts: CompilerDataCounts) -> Bool {
    counts.text_keys == 0 && counts.shared == 0 && counts.payload_enums == 0
}

// Every `.jet` file under `path` with a nonzero count.
compiler_data_scan: fn(path: String, found: ^[String:CompilerDataCounts]) -[FS]> CompilerDataError! {
    kind: files.stat(path) ?? return Err(CompilerDataError{message: "cannot stat {path}: {err}"})
    if kind.is_symlink -> return Ok()
    if kind.is_dir {
        loop child in files.list_dir(path) ?? return Err(CompilerDataError{message: "cannot list {path}: {err}"}) {
            if child.name.starts_with(".") -> next
            compiler_data_scan("{path}/{child.name}", found) ?? return Err(err)
        }
        return Ok()
    }
    if !path.ends_with(".jet") -> return Ok()
    text: files.read(path) ?? return Err(CompilerDataError{message: "cannot read {path}: {err}"})
    counts: compiler_data_counts(text)
    if !compiler_data_empty(counts) -> found[path] = counts
    Ok()
}

// The ledger's rows; a malformed, repeated or zero row is a problem.
compiler_data_rows: fn(ledger: String, problems: ^[String]) -> [String:CompilerDataCounts] {
    rows := [String:CompilerDataCounts]{}
    loop line in ledger.lines() {
        if line == "" || line.starts_with("#") -> next
        cells: line.split("\t").to_list()
        if cells.len() != 4 {
            problems.push("malformed ledger row `{line}`: write the path and three counts, tab-separated")
            next
        }
        row: CompilerDataCounts{text_keys: Int.parse(cells[1]) ?? -1, shared: Int.parse(cells[2]) ?? -1, payload_enums: Int.parse(cells[3]) ?? -1}
        if row.text_keys < 0 || row.shared < 0 || row.payload_enums < 0 {
            problems.push("malformed ledger row `{line}`: write the path and three counts, tab-separated")
            next
        }
        if rows.get(cells[0]) != None {
            problems.push("{cells[0]}: the ledger names it twice")
            next
        }
        if compiler_data_empty(row) {
            problems.push("{cells[0]}: an all-zero row is no row; delete it")
            next
        }
        rows[cells[0]] = row
    }
    rows
}

// One count's comparison with its row: a rise is in `rises`, a drop in `drops`.
compiler_data_compare_one: fn(path: String, what: String, found: Int, row: Int, rises: ^[String], drops: ^[String]) {
    if found > row {
        rises.push("{path}: {found} {what}, over its row's {row}; key the data by an id (Docs/Spec/compiler-data.md)")
    }
    if found < row {
        drops.push("{path}: {found} {what}, under its row's {row}; lower the row with jet Tools/Agent/CompilerData.jet --write")
    }
}

CompilerDataDiff: struct {
    rises: [String],
    drops: [String],
}

compiler_data_diff: fn(found: [String:CompilerDataCounts], ledger: String) -> CompilerDataDiff {
    rises := [String]{}
    drops := [String]{}
    rows: compiler_data_rows(ledger, rises)
    none: CompilerDataCounts{text_keys: 0, shared: 0, payload_enums: 0}
    loop (path, counts) in found {
        row: rows.get(path) ?? none
        compiler_data_compare_one(path, "text-keyed lookups", counts.text_keys, row.text_keys, rises, drops)
        compiler_data_compare_one(path, "Shared cells", counts.shared, row.shared, rises, drops)
        compiler_data_compare_one(path, "payload enums", counts.payload_enums, row.payload_enums, rises, drops)
    }
    loop (path, _) in rows {
        if found.get(path) == None {
            drops.push("{path}: holds none; delete its row with jet Tools/Agent/CompilerData.jet --write")
        }
    }
    rises.sort()
    drops.sort()
    CompilerDataDiff{rises: rises, drops: drops}
}

// The ledger text for `found`, its rows in path order.
compiler_data_ledger: fn(found: [String:CompilerDataCounts]) -> String {
    paths := [String]{}
    loop (path, _) in found -> paths.push(path.copy())
    paths.sort()
    lines := [String]{COMPILER_DATA_HEADER}
    loop path in paths {
        counts: found.get(path) ?? next
        lines.push("{path}\t{counts.text_keys}\t{counts.shared}\t{counts.payload_enums}")
    }
    "{lines.join("\n")}\n"
}

compiler_data_summary: fn(found: [String:CompilerDataCounts]) -> String {
    text_keys := 0
    shared := 0
    payload_enums := 0
    loop (_, counts) in found {
        text_keys += counts.text_keys
        shared += counts.shared
        payload_enums += counts.payload_enums
    }
    "{found.len()} files: {text_keys} text-keyed lookups, {shared} Shared cells, {payload_enums} payload enums"
}

compiler_data_main: fn(args: [String]) -[FS, IO]> Int CompilerDataError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") {
        return Err(CompilerDataError{message: "usage: jet Tools/Agent/CompilerData.jet [--check|--write]"})
    }
    found := [String:CompilerDataCounts]{}
    loop package in COMPILER_DATA_PACKAGES {
        compiler_data_scan("Compiler/{package}/Source", found) ?? return Err(err)
    }
    ledger: files.read(COMPILER_DATA_LEDGER) ?? return Err(CompilerDataError{message: "cannot read {COMPILER_DATA_LEDGER}: {err}"})
    diff: compiler_data_diff(found, ledger)
    loop line in diff.rises -> term.eprint(line)
    if mode == "--check" {
        loop line in diff.drops -> term.eprint(line)
        if diff.rises.len() > 0 || diff.drops.len() > 0 {
            term.eprint("compiler-data ratchet: {diff.rises.len()} rise(s), {diff.drops.len()} stale row(s)")
            return Ok(1)
        }
        print("compiler-data ratchet: ok ({compiler_data_summary(found)})")
        return Ok(0)
    }
    if diff.rises.len() > 0 {
        term.eprint("compiler-data ratchet: {diff.rises.len()} rise(s); the ledger only goes down")
        return Ok(1)
    }
    files.write(COMPILER_DATA_LEDGER, compiler_data_ledger(found)) ?? return Err(CompilerDataError{message: "cannot write {COMPILER_DATA_LEDGER}: {err}"})
    print("compiler-data ratchet: wrote {COMPILER_DATA_LEDGER} ({compiler_data_summary(found)})")
    Ok(0)
}

run: fn() {
    code: compiler_data_main(process.args()) ?? process.fail(1, err.message)
    if code != 0 -> process.exit(code)
}

#Test("the census counts text-keyed lookups, Shared cells and payload enums") {
    text: "A: struct {{\n    by_name: [String:Int],\n    rows: [Int],\n    seen: Set<String>,\n    cell: Shared<X>,\n}}\nKind: enum {{\n    Plain,\n    // Boxed(note)\n}}\nNode<T>: enum {{\n    Leaf,\n    Pair(left: T, right: T),\n}}\nm: module {{\n    Inner: enum {{\n        Boxed(x: Int),\n    }}\n}}\npriv Hidden: enum {{\n    Boxed(x: Int),\n}}\nNOTE: \"Fake: enum {{ Boxed(x: Int) }}\"\n"
    counts: compiler_data_counts(text)
    assert_eq(counts.text_keys, 2)
    assert_eq(counts.shared, 1)
    assert_eq(counts.payload_enums, 1)
}

// An enum counts the same however it is laid out.
#Test("the payload enum census reads the same enum in any layout") {
    layouts: [String]{
        "Wire: enum {{\n    Plain,\n    Boxed(x: Int),\n    Other,\n}}\n",
        "Wire: enum {{ Plain, Boxed(x: Int), Other }}\n",
        "Wire: enum {{\n    Plain Boxed(x: Int) Other\n\n    show: fn(self) -> String {{ \"}}\" }}\n}}\n",
        " Wire: enum {{\n        Plain,\n        #Rename(\"b\") Boxed(x: Int),\n}}\n",
        "#[Codable]\nWire: enum {{\n    Plain,\n    Boxed(\n        x: Int,\n    ),\n}}\n",
    }
    loop source in layouts -> assert_eq(compiler_data_payload_enums(source), 1)
    plain: [String]{
        "Wire: enum {{ Plain, Other }}\n",
        "Wire: enum {{\n    Plain,\n\n    make: fn(x: Int) -> Wire {{ Wire.Plain }}\n}}\n",
        "Wire: enum {{\n    Plain\n    impl Show {{\n        Boxed(x: Int)\n    }}\n}}\n",
    }
    loop source in plain -> assert_eq(compiler_data_payload_enums(source), 0)
}

#Test("the ratchet refuses a rise, reports a drop and a stale row, and rejects bad rows") {
    found: [String:CompilerDataCounts]{"A.jet": CompilerDataCounts{text_keys: 3, shared: 0, payload_enums: 1}, "B.jet": CompilerDataCounts{text_keys: 1, shared: 1, payload_enums: 0}}
    ledger: "# header\nA.jet\t2\t0\t1\nB.jet\t1\t2\t0\nC.jet\t1\t0\t0\nD.jet\tx\t0\t0\nE.jet\t0\t0\t0\n"
    diff: compiler_data_diff(found, ledger)
    assert_eq(
        diff.rises,
        [String]{
            "A.jet: 3 text-keyed lookups, over its row's 2; key the data by an id (Docs/Spec/compiler-data.md)",
            "E.jet: an all-zero row is no row; delete it",
            "malformed ledger row `D.jet\tx\t0\t0`: write the path and three counts, tab-separated",
        },
    )
    assert_eq(
        diff.drops,
        [String]{
            "B.jet: 1 Shared cells, under its row's 2; lower the row with jet Tools/Agent/CompilerData.jet --write",
            "C.jet: holds none; delete its row with jet Tools/Agent/CompilerData.jet --write",
        },
    )
    assert_eq(compiler_data_ledger(found), "{COMPILER_DATA_HEADER}\nA.jet\t3\t0\t1\nB.jet\t1\t1\t0\n")
}
