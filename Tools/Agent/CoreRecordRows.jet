#!/usr/bin/env jet
// Write the rows of Registry/CoreRecordRows.jet whose record a Core source
// declares from that declaration. A field row
// (`CoreRecordFieldRow{owner: "X", field: "f", ty: …}`) types `X.f` for a
// program that has not loaded X's module; a literal row
// (`CoreRecordLiteralRow{owner: "X", fields: …}`) lists the fields a struct
// literal of X builds. When a source of a Core module (its `source_module`
// rows in Compiler/Prelude/Core.rows and the parts
// Compiler/Prelude/CoreSourceParts.tsv attaches to it) declares
// `X: struct { … }`, X's field rows are its declared fields other than its
// `priv` storage, in declaration order, and its literal row, when it has
// one, lists the same fields. Each field's type is written the way the rows spell
// it: `Int` `Float` `Bool` `String` `Char` `F32`, `U8`/`I32`… (IntN),
// `[T]`, `[K:V]`, `T?`, `(name: T, …)`, `Name<T, …>` and any other name by
// its last segment. A record no Core source declares, one declared twice
// with different fields, a generic one or one with a field of another type
// (a function) is the compiler-owned residue, left as it is written.
// Usage (from the repository root): jet Tools/Agent/CoreRecordRows.jet
// [--check|--write|--residue]; --check fails when a declared record's rows
// differ from its declaration, --write rewrites them and --residue lists
// the records left as written, each with why.
use {
    files: core.files
    process: core.process
}

RECORDS_PATH: "Compiler/JetFoundation/Source/Registry/CoreRecordRows.jet"

ROWS_PATH: "Compiler/Prelude/Core.rows"

PARTS_PATH: "Compiler/Prelude/CoreSourceParts.tsv"

FIELD_OPEN: "    CoreRecordFieldRow{{owner: \""

LITERAL_OPEN: "    CoreRecordLiteralRow{{owner: \""

#Error
CoreRecordRowsError: struct {
    message: String,
}

records_fail: fn(message: String) -> CoreRecordRowsError Never! {
    CoreRecordRowsError{message: "core record rows: {message}"}
}

// One declared field: its name and its type as the rows spell it.
DeclaredField: struct {
    name: String,
    ty: String,
}

// A struct's declared fields, or why the rows cannot carry them
// (`unsupported` is "" when they can).
DeclaredStruct: struct {
    fields: [DeclaredField],
    unsupported: String,
}

// One `X: struct` declaration: its source and the byte its body opens at
// (-1 for a generic struct).
StructSite: struct {
    path: String,
    open: Int,
}

// A type as the rows spell it and the byte after it.
ParsedType: struct {
    text: String,
    next: Int,
}

// One record whose rows differ from its declaration.
StaleRecord: struct {
    owner: String,
    path: String,
}

// One record left as written, and why.
ResidueRecord: struct {
    owner: String,
    reason: String,
}

// The rewritten CoreRecordRows.jet text, the records it wrote and the ones it
// left as written.
RecordRows: struct {
    text: String,
    written: Int,
    stale: [StaleRecord],
    residue: [ResidueRecord],
}

space_byte: fn(code: Int) -> Bool Never! {
    code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

upper_byte: fn(code: Int) -> Bool Never! { code >= 65 && code <= 90 }

lower_byte: fn(code: Int) -> Bool Never! { code >= 97 && code <= 122 }

digit_byte: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

word_byte: fn(code: Int) -> Bool Never! {
    lower_byte(code) || upper_byte(code) || digit_byte(code) || code == 95
}

byte_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

code_at: fn(bytes: [U8], at: Int) -> Int Never! { Int{bytes[at]} }

skip_space: fn(bytes: [U8], start: Int) -> Int Never! {
    at := start
    loop at < bytes.len() && space_byte(code_at(bytes, at)) -> at += 1
    at
}

// The byte after white space and `//` comments from `start`.
skip_trivia: fn(bytes: [U8], start: Int) -> Int Never! {
    at := skip_space(bytes, start)
    loop at + 1 < bytes.len() && code_at(bytes, at) == 47 && code_at(bytes, at + 1) == 47 {
        loop at < bytes.len() && code_at(bytes, at) != 10 -> at += 1
        at = skip_space(bytes, at)
    }
    at
}

// The byte after the bracket that closes the one at `open` (`{`, `(` or
// `[`), string literals passed over.
balanced_end: fn(bytes: [U8], open: Int) -> Int Never! {
    depth := 0
    at := open
    loop at < bytes.len() {
        code: code_at(bytes, at)
        if code == {
            34 -> {
                at += 1
                loop at < bytes.len() && code_at(bytes, at) != 34 {
                    if code_at(bytes, at) == 92 -> at += 1
                    at += 1
                }
            }
            123 | 40 | 91 -> depth += 1
            125 | 41 | 93 -> {
                depth -= 1
                if depth == 0 -> return at + 1
            }
            else -> {}
        }
        at += 1
    }
    at
}

// Each Core module's source paths: its `source_module` rows in Core.rows
// (`source_module <module> path <path> …`), then each part CoreSourceParts.tsv
// attaches to it (columns: module, owner, path, …).
module_sources: fn(rows: String, parts: String) -> [String:[String]] Never! {
    sources := [String:[String]]{}
    loop line in rows.lines() {
        if !line.starts_with("source_module ") -> next
        words: line.split(" ").to_list()
        if words.len() < 4 || words[2] != "path" -> next
        if !sources.has_key(words[1]) -> sources[words[1]] = [String]{}
        sources[words[1]].push(words[3])
    }
    loop line in parts.lines() {
        if line == "" || line.starts_with("#") -> next
        columns: line.split("\t").to_list()
        if columns.len() < 3 -> next
        if !sources.has_key(columns[1]) -> sources[columns[1]] = [String]{}
        sources[columns[1]].push(columns[2])
    }
    sources
}

// The row spelling of a type named `leaf` with no arguments: a size alias of
// Core/Prelude/Prelude.jet is the type it names (foundation_named_type).
named_type: fn(leaf: String) -> String Never! {
    if leaf == {
        "Int" -> "Type.Int"
        "Float" | "F64" -> "Type.Float"
        "Bool" -> "Type.Bool"
        "String" -> "Type.String"
        "Char" -> "Type.Char"
        "F32" -> "Type.Float32"
        "I8" | "I16" | "I32" | "I64" | "U8" | "U16" | "U32" | "U64" -> "Type.IntN{{signed: {leaf.starts_with("I")}, bits: {leaf.slice(1, leaf.len())}}}"
        else -> "Type.Named{{name: \"{leaf}\"}}"
    }
}

// The row spelling of `leaf<args>`, as the parser reads it
// (parser_apply_named_type).
applied_type: fn(leaf: String, args: [String]) -> String Never! {
    if leaf == "Shared" && args.len() == 1 -> return "Type.Shared{{inner: {args[0]}}}"
    if leaf == "Option" && args.len() == 1 -> return "Type.Option{{inner: {args[0]}}}"
    if leaf == "Result" && args.len() == 2 -> return "Type.Result{{ok: {args[0]}, err: {args[1]}}}"
    "Type.Apply{{name: \"{leaf}\", args: [Type]{{{args.join(", ")}}}}}"
}

// The type at `start` (`T`, `[T]`, `[K:V]`, `(name: T, …)`, `Name<T, …>`,
// each optionally followed by `?`s), or None when the rows cannot spell it.
parse_type: fn(bytes: [U8], start: Int) -> ParsedType? {
    atom: parse_atom(bytes, skip_space(bytes, start)) ?? return None
    text := atom.text
    at := atom.next
    loop at < bytes.len() && code_at(bytes, at) == 63 {
        text = "Type.Option{{inner: {text}}}"
        at += 1
    }
    Val(ParsedType{text: text, next: at})
}

parse_atom: fn(bytes: [U8], at: Int) -> ParsedType? {
    if at >= bytes.len() -> return None
    code: code_at(bytes, at)
    if code == 91 {
        first: parse_type(bytes, at + 1) ?? return None
        after: skip_space(bytes, first.next)
        if after < bytes.len() && code_at(bytes, after) == 58 {
            value: parse_type(bytes, after + 1) ?? return None
            close: skip_space(bytes, value.next)
            if close >= bytes.len() || code_at(bytes, close) != 93 -> return None
            return Val(ParsedType{text: "Type.Map{{key: {first.text}, key_span: None, value: {value.text}}}", next: close + 1})
        }
        if after >= bytes.len() || code_at(bytes, after) != 93 -> return None
        return Val(ParsedType{text: "Type.List{{element: {first.text}}}", next: after + 1})
    }
    if code == 40 -> return parse_tuple(bytes, at + 1)
    if !upper_byte(code) && !lower_byte(code) -> return None
    end := at
    loop end < bytes.len() && (word_byte(code_at(bytes, end)) || code_at(bytes, end) == 46) {
        end += 1
    }
    segments: byte_text(bytes, at, end).split(".").to_list()
    leaf: segments[segments.len() - 1]
    if leaf == "" || !upper_byte(code_at(leaf.bytes(), 0)) -> return None
    if end >= bytes.len() || code_at(bytes, end) != 60 {
        return Val(ParsedType{text: named_type(leaf), next: end})
    }
    args := [String]{}
    next_arg := end + 1
    loop {
        arg: parse_type(bytes, next_arg) ?? return None
        args.push(arg.text)
        separator: skip_space(bytes, arg.next)
        if separator >= bytes.len() -> return None
        if code_at(bytes, separator) == 62 {
            return Val(ParsedType{text: applied_type(leaf, args), next: separator + 1})
        }
        if code_at(bytes, separator) != 44 -> return None
        next_arg = separator + 1
    }
}

// The labeled tuple whose fields start at `start`, after its `(`.
parse_tuple: fn(bytes: [U8], start: Int) -> ParsedType? {
    fields := [String]{}
    at := skip_space(bytes, start)
    loop at >= bytes.len() || code_at(bytes, at) != 41 {
        name_end := at
        loop name_end < bytes.len() && word_byte(code_at(bytes, name_end)) -> name_end += 1
        if name_end == at -> return None
        colon: skip_space(bytes, name_end)
        if colon >= bytes.len() || code_at(bytes, colon) != 58 -> return None
        ty: parse_type(bytes, colon + 1) ?? return None
        fields.push("TypeTupleField{{name: \"{byte_text(bytes, at, name_end)}\", ty: {ty.text}}}")
        at = skip_space(bytes, ty.next)
        if at < bytes.len() && code_at(bytes, at) == 44 -> at = skip_space(bytes, at + 1)
    }
    if fields.len() == 0 -> return None
    Val(ParsedType{text: "Type.Tuple{{fields: [TypeTupleField]{{{fields.join(", ")}}}}}", next: at + 1})
}

unsupported: fn(reason: String) -> DeclaredStruct Never! {
    DeclaredStruct{fields: [DeclaredField]{}, unsupported: reason}
}

// The fields of the struct body that opens at byte `open`, in declaration
// order: its `name: Type` members, markers, comments, defaults, methods and
// impl blocks passed over.
struct_fields: fn(bytes: [U8], open: Int) -> DeclaredStruct Never! {
    fields := [DeclaredField]{}
    private := false
    at := open + 1
    loop {
        at = skip_trivia(bytes, at)
        if at >= bytes.len() -> return unsupported("its body is not closed")
        code: code_at(bytes, at)
        if code == {
            125 -> return DeclaredStruct{fields: fields, unsupported: ""}
            44 -> {
                at += 1
                next
            }
            35 -> {
                at += 1
                loop at < bytes.len() && (word_byte(code_at(bytes, at)) || code_at(bytes, at) == 46) {
                    at += 1
                }
                if at < bytes.len() && code_at(bytes, at) == 40 -> at = balanced_end(bytes, at)
                next
            }
            else -> {}
        }
        if !word_byte(code) {
            return unsupported("its body holds `{byte_text(bytes, at, at + 1)}` where a member starts")
        }
        word_end := at
        loop word_end < bytes.len() && word_byte(code_at(bytes, word_end)) -> word_end += 1
        word: byte_text(bytes, at, word_end)
        if word == "pub" || word == "priv" {
            private = word == "priv"
            at = word_end
            next
        }
        if word == "impl" {
            brace := word_end
            loop brace < bytes.len() && code_at(bytes, brace) != 123 -> brace += 1
            at = balanced_end(bytes, brace)
            private = false
            next
        }
        colon: skip_space(bytes, word_end)
        if colon >= bytes.len() || code_at(bytes, colon) != 58 {
            return unsupported("its member {word} has no `:`")
        }
        value: skip_space(bytes, colon + 1)
        if value + 2 <= bytes.len() && byte_text(bytes, value, value + 2) == "fn" && (value + 2 == bytes.len() || !word_byte(code_at(bytes, value + 2))) {
            at = member_end(bytes, value)
            private = false
            next
        }
        if upper_byte(code) -> return unsupported("its member {word} is not a field")
        ty: parse_type(bytes, value) ?? return unsupported("the rows cannot spell the type of its field {word}")
        if !private -> fields.push(DeclaredField{name: word, ty: ty.text})
        private = false
        at = skip_space(bytes, ty.next)
        if at + 1 < bytes.len() && code_at(bytes, at) == 45 && code_at(bytes, at + 1) == 62 {
            at = skip_space(bytes, at + 2)
            loop at < bytes.len() && word_byte(code_at(bytes, at)) -> at += 1
            at = skip_space(bytes, at)
        }
        if at < bytes.len() && code_at(bytes, at) == 123 -> at = balanced_end(bytes, at)
    }
}

// The byte after the method member whose value starts at `start` (`fn(…) …
// { … }`): the end of its line once a brace group closes there.
member_end: fn(bytes: [U8], start: Int) -> Int Never! {
    at := start
    loop at < bytes.len() {
        code: code_at(bytes, at)
        if code != 123 && code != 40 && code != 91 {
            at += 1
            next
        }
        at = balanced_end(bytes, at)
        if code != 123 -> next
        after := at
        loop after < bytes.len() && (code_at(bytes, after) == 32 || code_at(bytes, after) == 9) {
            after += 1
        }
        if after >= bytes.len() -> return after
        closer: code_at(bytes, after)
        if closer == 10 || closer == 44 || closer == 125 || (closer == 47 && after + 1 < bytes.len() && code_at(bytes, after + 1) == 47) {
            return after
        }
    }
    at
}

// Each struct the Core sources declare at a line start (`X: struct`, after
// indentation and an optional `pub` or `priv`), by name, in source order.
struct_sites: fn(paths: [String], texts: [String:String]) -> [String:[StructSite]] Never! {
    sites := [String:[StructSite]]{}
    loop path in paths {
        bytes: (texts.get(path) ?? "").bytes()
        line := 0
        loop line < bytes.len() {
            at := line
            loop at < bytes.len() && (code_at(bytes, at) == 32 || code_at(bytes, at) == 9) {
                at += 1
            }
            if at + 4 <= bytes.len() && byte_text(bytes, at, at + 4) == "pub " -> at += 4
            if at + 5 <= bytes.len() && byte_text(bytes, at, at + 5) == "priv " -> at += 5
            end := at
            loop end < bytes.len() && word_byte(code_at(bytes, end)) -> end += 1
            if end > at && upper_byte(code_at(bytes, at)) && end + 8 <= bytes.len() && byte_text(bytes, end, end + 8) == ": struct" {
                brace: skip_space(bytes, end + 8)
                open: if brace < bytes.len() && code_at(bytes, brace) == 123 -> brace else -> -1
                name: byte_text(bytes, at, end)
                if !sites.has_key(name) -> sites[name] = [StructSite]{}
                sites[name].push(StructSite{path: "{path}", open: open})
            }
            loop line < bytes.len() && code_at(bytes, line) != 10 -> line += 1
            line += 1
        }
    }
    sites
}

// The declared fields of record `owner` and the source that declares them,
// or why its rows stay as written.
owner_declaration: fn(owner: String, sites: [String:[StructSite]], texts: [String:String]) -> {fields: [DeclaredField], path: String, reason: String} {
    found: sites.get(owner) ?? return {fields: [DeclaredField]{}, path: "", reason: "no Core source declares it"}
    chosen := [DeclaredField]{}
    path := ""
    loop site in found {
        if site.open < 0 {
            return {fields: [DeclaredField]{}, path: "", reason: "{site.path} declares it generic"}
        }
        declared: struct_fields((texts.get(site.path) ?? "").bytes(), site.open)
        if declared.unsupported != "" {
            return {fields: [DeclaredField]{}, path: "", reason: "{site.path}: {declared.unsupported}"}
        }
        if {
            path == "" -> {
                chosen = declared.fields
                path = site.path
            }
            field_rows(owner, declared.fields) != field_rows(owner, chosen) -> {
                return {fields: [DeclaredField]{}, path: "", reason: "{path} and {site.path} declare it with different fields"}
            }
            else -> {}
        }
    }
    {fields: chosen, path: path, reason: ""}
}

// The field rows of record `owner` with `fields`.
field_rows: fn(owner: String, fields: [DeclaredField]) -> [String] Never! {
    loop field in fields -> "{FIELD_OPEN}{owner}\", field: \"{field.name}\", ty: {field.ty}}},"
}

// The literal row of record `owner` with `fields`.
literal_row: fn(owner: String, fields: [DeclaredField]) -> String Never! {
    listed: loop field in fields -> "TypeTupleField{{name: \"{field.name}\", ty: {field.ty}}}"
    "{LITERAL_OPEN}{owner}\", fields: [TypeTupleField]{{{listed.join(", ")}}}}},"
}

// The owner a row line names: the text after `open` up to its quote.
row_owner: fn(line: String, open: String) -> String Never! {
    line.slice(open.len(), line.len()).partition("\"").head
}

// CoreRecordRows.jet (`records`) with the rows of each record a Core source
// declares written from it: its field rows where its first one stood, its
// literal row in place.
record_rows: fn(records: String, sites: [String:[StructSite]], texts: [String:String]) -> RecordRows {
    lines: records.split("\n").to_list()
    left := [String:Bool]{}
    declared := [String:{fields: [DeclaredField], path: String}]{}
    order := [String]{}
    residue := [ResidueRecord]{}
    loop line in lines {
        owner: if {
            line.starts_with(FIELD_OPEN) -> row_owner(line, FIELD_OPEN)
            line.starts_with(LITERAL_OPEN) -> row_owner(line, LITERAL_OPEN)
            else -> next
        }
        if declared.has_key(owner) || left.has_key(owner) -> next
        found: owner_declaration(owner, sites, texts)
        if found.reason != "" {
            residue.push(ResidueRecord{owner: owner, reason: found.reason})
            left[owner] = true
            next
        }
        declared[owner] = {fields: found.fields, path: found.path}
        order.push(owner)
    }
    old := [String:[String]]{}
    out := [String]{}
    emitted := [String:Bool]{}
    loop line in lines {
        is_field: line.starts_with(FIELD_OPEN)
        is_literal: line.starts_with(LITERAL_OPEN)
        if !is_field && !is_literal {
            out.push(line)
            next
        }
        owner: row_owner(line, if is_field -> FIELD_OPEN else -> LITERAL_OPEN)
        record: declared.get(owner) ?? {
            out.push(line)
            next
        }
        if !old.has_key(owner) -> old[owner] = [String]{}
        old[owner].push(line)
        if is_literal {
            out.push(literal_row(owner, record.fields))
            next
        }
        if emitted.has_key(owner) -> next
        emitted[owner] = true
        loop row in field_rows(owner, record.fields) -> out.push(row)
    }
    stale := [StaleRecord]{}
    loop owner in order {
        record: declared.get(owner) ?? next
        written_rows: old.get(owner) ?? [String]{}
        fresh := field_rows(owner, record.fields)
        loop line in written_rows {
            if line.starts_with(LITERAL_OPEN) -> fresh.push(literal_row(owner, record.fields))
        }
        if written_rows != fresh -> stale.push(StaleRecord{owner: owner, path: record.path})
    }
    RecordRows{text: out.join("\n"), written: declared.len(), stale: stale, residue: residue}
}

core_record_rows_main: fn(args: [String]) -[FS]> String CoreRecordRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write" && mode != "--residue") {
        return Err(records_fail("usage: jet Tools/Agent/CoreRecordRows.jet [--check|--write|--residue]"))
    }
    records: files.read(RECORDS_PATH) ?? return Err(records_fail("cannot read {RECORDS_PATH}: {err}"))
    rows: files.read(ROWS_PATH) ?? return Err(records_fail("cannot read {ROWS_PATH}: {err}"))
    parts: files.read(PARTS_PATH) ?? return Err(records_fail("cannot read {PARTS_PATH}: {err}"))
    sources: module_sources(rows, parts)
    paths := [String]{}
    texts := [String:String]{}
    module_names := sources.keys().to_list()
    module_names.sort()
    loop module_name in module_names {
        module_paths: sources.get(module_name) ?? [String]{}
        loop path in module_paths {
            if texts.has_key(path) -> next
            texts[path] = files.read(path) ?? return Err(records_fail("cannot read {path}, a source of {module_name}: {err}"))
            paths.push(path)
        }
    }
    result: record_rows(records, struct_sites(paths, texts), texts)
    if mode == "--residue" {
        listed: loop record in result.residue -> "{record.owner}: {record.reason}"
        return Ok("{listed.join("\n")}\n{result.residue.len()} records left as written")
    }
    if result.stale.len() > 0 && mode == "--check" {
        problems: loop stale in result.stale -> "{RECORDS_PATH}: the rows of {stale.owner} differ from its declaration in {stale.path}"
        return Err(records_fail("{problems.join("\n")}\nrun jet Tools/Agent/CoreRecordRows.jet --write"))
    }
    if result.stale.len() > 0 {
        files.write(RECORDS_PATH, result.text) ?? return Err(records_fail("cannot write {RECORDS_PATH}: {err}"))
        return Ok("core record rows written ({result.stale.len()} of {result.written} records changed, {result.residue.len()} compiler-owned)")
    }
    Ok("core record rows check passed ({result.written} records from the Core sources, {result.residue.len()} compiler-owned)")
}

run: fn() { print(core_record_rows_main(process.args()) ?? process.fail(1, err.message)) }

#Test("a struct's fields are its typed members in declaration order") {
    text: "// Box: struct {{ wrong: Int }}\npub Box: struct {{\n    /// the count\n    count: Int{{0}},\n    #Skip\n    name: core.text.Name?,\n    priv cache: [String:[U8]],\n    label: String -> cache,\n    pair: (index: Int, size: I32),\n    span: fn(self) -> {{start: Int}} Never! {{ {{start: 0}} }}\n    items: List<Item>,\n\n    impl Show {{ show: fn(self) -> String {{ \"}}\" }} }}\n    width: fn(self) -> Int {{ self.count }}\n}}\n"
    texts := [String:String]{}
    texts["a.jet"] = text
    sites: struct_sites([String]{"a.jet"}, texts)
    site: (sites.get("Box") ?? panic("no Box"))[0]
    declared: struct_fields(text.bytes(), site.open)
    assert_eq(declared.unsupported, "")
    assert_eq((loop field in declared.fields -> field.name).join(","), "count,name,label,pair,items")
    assert_eq(declared.fields[1].ty, "Type.Option{{inner: Type.Named{{name: \"Name\"}}}}")
    assert_eq(declared.fields[3].ty, "Type.Tuple{{fields: [TypeTupleField]{{TypeTupleField{{name: \"index\", ty: Type.Int}}, TypeTupleField{{name: \"size\", ty: Type.IntN{{signed: true, bits: 32}}}}}}}}")
    assert_eq(declared.fields[4].ty, "Type.Apply{{name: \"List\", args: [Type]{{Type.Named{{name: \"Item\"}}}}}}")
    other: "Bag: struct {{\n    data: [String:[U8]],\n    ops: Shared<Ops>,\n    ratio: F64,\n}}\n"
    bag: struct_fields(other.bytes(), "Bag: struct ".len())
    assert_eq(bag.fields[0].ty, "Type.Map{{key: Type.String, key_span: None, value: Type.List{{element: Type.IntN{{signed: false, bits: 8}}}}}}")
    assert_eq(bag.fields[1].ty, "Type.Shared{{inner: Type.Named{{name: \"Ops\"}}}}")
    assert_eq(bag.fields[2].ty, "Type.Float")
}

#Test("a record's rows follow its declaration; an undeclared or generic one stays as written") {
    texts := [String:String]{}
    texts["Core/Demo/Demo.jet"] = "Pair: struct {{\n    left: Int,\n    right: String,\n}}\nBox: struct<T> {{\n    value: T,\n}}\n"
    sites: struct_sites([String]{"Core/Demo/Demo.jet"}, texts)
    records: "ROWS: [CoreRecordFieldRow]{{\n{FIELD_OPEN}Pair\", field: \"right\", ty: Type.Int}},\n{FIELD_OPEN}Gone\", field: \"x\", ty: Type.Int}},\n{FIELD_OPEN}Box\", field: \"value\", ty: Type.Int}},\n}}\nLITERALS: [CoreRecordLiteralRow]{{\n{LITERAL_OPEN}Pair\", fields: [TypeTupleField]{{}}}},\n}}"
    result: record_rows(records, sites, texts)
    assert_eq(result.written, 1)
    assert_eq(result.stale.len(), 1)
    assert_eq((loop record in result.residue -> record.owner).join(","), "Gone,Box")
    assert(result.text.contains("{FIELD_OPEN}Pair\", field: \"left\", ty: Type.Int}},\n{FIELD_OPEN}Pair\", field: \"right\", ty: Type.String}},\n{FIELD_OPEN}Gone\""))
    assert(result.text.contains("{LITERAL_OPEN}Pair\", fields: [TypeTupleField]{{TypeTupleField{{name: \"left\", ty: Type.Int}}, TypeTupleField{{name: \"right\", ty: Type.String}}}}}},"))
    again: record_rows(result.text, sites, texts)
    assert_eq(again.stale.len(), 0)
}

#Test("every declared Core record's rows match its declaration") {
    passed: core_record_rows_main([String]{"--check"}) ?? panic(err.message)
    assert(passed.starts_with("core record rows check passed"))
}
