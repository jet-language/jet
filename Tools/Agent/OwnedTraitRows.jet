#!/usr/bin/env jet
// Render the protocol traits of Compiler/Prelude/Traits.jet, the one
// declaration of each trait the compiler owns, into every copy built from it:
// OWNED_TRAITS (Compiler/JetFoundation/Source/Registry/OwnedTraitRows.jet),
// which the parser, sema and the CLI read, and the trait-marker rows of the
// syntax dictionary (the generated block of
// Compiler/JetCLI/Source/CLI/SyntaxDictionaryData.jet). The source is read as
// text in one strict shape: `Name: trait {` blocks, with `Literal: module {`
// around the literal capabilities, whose members are `column: Bool{true}` or
// `column: String{"…"}` facts, `Name: type` associated types and
// `name: fn(…)` requirements ending `Never!` or `Error!`. A requirement ending
// `Error! {` is a default: its body runs to the `}` at its own indent, and
// its row carries the whole method as written. A trait with a
// `declared_in: String{"core.encoding"}` fact is declared by that Core
// module: the stub here holds its facts, and its members are read from the
// module's `Name: trait {` block (its source per Compiler/Prelude/Core.rows),
// in the same shape. A `#Builtin.Role(.Add)` line right above a trait gives
// it a role: what `+` or `[ ]` calls is the trait that fills the role. A role
// fills at most one trait. The roles are the generated RoleKind block of
// jet_builtins (Core/Builtins/Builtins.jet): one case per `#Builtin.Role(.X)`
// marker, first those that start a Core function's declaration line or the
// `#[Builtin.Role(.X), …]` marker list right above it (by path, then line),
// then the traits' here. A role two markers give is refused.
// Usage: jet Tools/Agent/OwnedTraitRows.jet [--check|--write]
// --check fails when a copy differs from what the declarations give it;
// --write rewrites the copies.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
}

SOURCE_PATH: "Compiler/Prelude/Traits.jet"

// Core.rows, whose `source_module` rows give each Core module's source.
CORE_ROWS_PATH: "Compiler/Prelude/Core.rows"

// The prelude that declares `CheckedText: trait` for readers.
PRELUDE_PATH: "Compiler/Prelude/Core/prelude.jet"

CHECKED_TEXT_DECLARATION: "CheckedText: trait {{"

// The jet_builtins source whose RoleKind block the role markers give, and
// the Core tree whose functions carry them.
BUILTINS_PATH: "Core/Builtins/Builtins.jet"

CORE_TREE: "Core"

ROLE_KIND_OPEN: "// BEGIN GENERATED by Tools/Agent/OwnedTraitRows.jet from the `#Builtin.Role(.X)` markers; do not edit."

ROLE_KIND_CLOSE: "// END GENERATED"

// A Core function's marker, at the start of its declaration line or first in
// the marker list above it.
FUNCTION_ROLE_MARKER: Regex{"^#\[?Builtin\.Role\(\.([A-Z][A-Za-z0-9]*)\)[ ,]"}

FUNCTION_ROLE_PREFIX: "Builtin.Role(."

ROLE_MARKER: Regex{"^#Builtin\.Role\(\.([A-Z][A-Za-z0-9]*)\)$"}

ROWS_PATH: "Compiler/JetFoundation/Source/Registry/OwnedTraitRows.jet"

DICTIONARY_PATH: "Compiler/JetCLI/Source/CLI/SyntaxDictionaryData.jet"

GENERATED_BY: "// This file is generated by Tools/Agent/OwnedTraitRows.jet; do not edit."

DICTIONARY_OPEN: "    // The trait markers of Compiler/Prelude/Traits.jet, generated by Tools/Agent/OwnedTraitRows.jet; do not edit."

DICTIONARY_CLOSE: "    // End of the generated trait markers."

// The registry the dictionary's trait-marker rows name.
REGISTRY_NAME: "OWNED_TRAITS"

MODULE_OPEN: Regex{"^([A-Z][A-Za-z]*): module \x7B$"}

TRAIT_OPEN: Regex{"^([A-Z][A-Za-z]*): trait \x7B$"}

FLAG: Regex{"^([a-z_]+): Bool\{{true\}}$"}

TEXT: Regex{"^([a-z_]+): String\{{\x22([^\x22\\{{}}]*)\x22\}}$"}

ASSOCIATED: Regex{"^([A-Z][A-Za-z]*): type$"}

METHOD_OPEN: Regex{"^[a-z][a-z0-9_]*: fn\("}

NAME: Regex{"^[A-Z][A-Za-z0-9]*$"}

METHOD_NAME: Regex{"^[a-z][a-z0-9_]*$"}

FLAG_COLUMNS: [String]{"local", "bare_bound", "raw_return", "any_receiver", "commutative", "codec", "conversion", "derived", "checked_text", "auto_derive", "bundle", "through_elements"}

TEXT_COLUMNS: [String]{"auto_derive_family", "requires", "shares", "declared_in"}

// The column that names the Core module declaring the trait.
DECLARED_IN_COLUMN: "declared_in"

// The column that names a family marker.
FAMILY_COLUMN: "auto_derive_family"

#Error
OwnedTraitRowsError: struct {
    message: String,
}

rows_fail: fn(message: String) -> OwnedTraitRowsError Never! {
    OwnedTraitRowsError{message: "owned trait rows: {message}"}
}

// One `column: Bool{true}` or `column: String{"…"}` fact; a flag's value is "true".
TraitFact: struct {
    name: String,
    value: String,
}

// A parameter as written: `ty` keeps its access sigil (`^[U8]`).
TraitParam: struct {
    name: String,
    ty: String,
}

// One `name: fn(…)` requirement as written.
TraitMethod: struct {
    name: String,
    // "" for a static method, else `self`, `^self` or `^^self`.
    receiver: String,
    params: [TraitParam],
    // The written return type, "" when the method writes no `->`.
    returns: String,
    // `Never` or the written error type.
    error: String,
    // A default: the method, header and body, at no indent; "" for none.
    default_source: String{""},
}

// One `#Test name: fn(…) {` law as written, header and body, at no indent.
TraitLaw: struct {
    name: String,
    source: String,
}

// One `Name: trait` block as written.
TraitSource: struct {
    name: String,
    line: Int,
    // Declared inside `Literal: module`.
    literal: Bool,
    // The RoleKind case its `#Builtin.Role(.X)` names; "" for none.
    role: String,
    facts: [TraitFact],
    associated: [String],
    methods: [TraitMethod],
    laws: [TraitLaw],
}

TextFile: struct {
    path: String,
    text: String,
}

fact: fn(source: TraitSource, name: String) -> String? Never! {
    loop row in source.facts {
        if row.name == name -> return Val(row.value.copy())
    }
    None
}

flag: fn(source: TraitSource, name: String) -> Bool Never! { fact(source, name) != None }

// The space-separated words of a text fact, empty when the trait omits it.
words: fn(source: TraitSource, name: String) -> [String] Never! {
    value: fact(source, name) ?? return [String]{}
    out := [String]{}
    loop word in value.split(" ").to_list() {
        if word != "" -> out.push(word.copy())
    }
    out
}

parse_method: fn(text: String, context: String) -> TraitMethod OwnedTraitRowsError! {
    if !text.ends_with("!") {
        return Err(rows_fail("{context}: a requirement ends `Never!` or `Error!`, found `{text}`"))
    }
    head: text.remove_suffix("!").partition(": fn(")
    if head.sep == "" || METHOD_NAME.match(head.head) == None {
        return Err(rows_fail("{context}: expected `name: fn(…)`, found `{text}`"))
    }
    signature: head.tail.rpartition(") ")
    if signature.sep == "" {
        return Err(rows_fail("{context}: expected `) -> Type Error!` or `) Error!`, found `{text}`"))
    }
    returns := ""
    error := signature.tail.copy()
    if signature.tail.starts_with("-> ") {
        result: signature.tail.remove_prefix("-> ").rpartition(" ")
        if result.sep == "" {
            return Err(rows_fail("{context}: `-> Type` takes its error after it (`-> Type Never!`), found `{text}`"))
        }
        returns = result.head.copy()
        error = result.tail.copy()
    }
    if error.contains(" ") || error == "" {
        return Err(rows_fail("{context}: expected one error type before `!`, found `{text}`"))
    }
    receiver := ""
    params := [TraitParam]{}
    loop written in signature.head.split(", ").to_list() {
        if written == "" -> next
        if params.len() == 0 && receiver == "" && (written == "self" || written == "^self" || written == "^^self") {
            receiver = written.copy()
            next
        }
        param: written.partition(": ")
        if param.sep == "" || METHOD_NAME.match(param.head) == None {
            return Err(rows_fail("{context}: expected `name: Type`, found `{written}`"))
        }
        params.push(TraitParam{name: param.head.copy(), ty: param.tail.copy()})
    }
    Ok(TraitMethod{name: head.head.copy(), receiver: receiver, params: params, returns: returns, error: error})
}

read_traits: fn(source_text: String) -> [TraitSource] OwnedTraitRowsError! {
    lines: source_text.split("\n").to_list()
    traits := [TraitSource]{}
    group := ""
    // The role a `#Builtin.Role(.X)` line gives the trait it stands above.
    role := ""
    role_line := 0
    index := 0
    loop index < lines.len() {
        line: lines[index]
        index += 1
        if role != "" && TRAIT_OPEN.match(line.trim()) == None {
            return Err(rows_fail("line {role_line}: `#Builtin.Role(.{role})` stands above no trait"))
        }
        if line.trim() == "" || line.trim().starts_with("//") -> next
        if group == "" && MODULE_OPEN.match(line) == .Val(opened) {
            if opened.groups[0] != "Literal" {
                return Err(rows_fail("line {index}: only `Literal: module` groups traits, found `{line}`"))
            }
            group = opened.groups[0].copy()
            next
        }
        if group != "" && line == "}}" {
            group = ""
            next
        }
        indent: if group == "" -> "" else -> "    "
        if line.starts_with(indent) && ROLE_MARKER.match(line.remove_prefix(indent)) == .Val(marked) {
            role = marked.groups[0].copy()
            role_line = index
            next
        }
        opened: (if line.starts_with(indent) -> TRAIT_OPEN.match(line.remove_prefix(indent)) else -> None) ?? return Err(rows_fail("line {index}: expected `{indent}Name: trait {{`, found `{line}`"))
        name: if group == "" -> opened.groups[0].copy() else -> "{group}.{opened.groups[0]}"
        context: "trait {name}"
        start: index
        facts := [TraitFact]{}
        associated := [String]{}
        methods := [TraitMethod]{}
        laws := [TraitLaw]{}
        member_indent: "{indent}    "
        loop index < lines.len() && lines[index] != "{indent}}}" {
            member: lines[index]
            index += 1
            if member.trim() == "" || member.trim().starts_with("//") -> next
            if !member.starts_with(member_indent) || member.remove_prefix(member_indent).starts_with(" ") {
                return Err(rows_fail("line {index}: {context}: members sit one level in, found `{member}`"))
            }
            body: member.remove_prefix(member_indent).remove_suffix(",")
            if {
                FLAG.match(body) == .Val(column) -> {
                    if !FLAG_COLUMNS.contains(column.groups[0]) {
                        return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is not a flag column ({FLAG_COLUMNS.join(", ")})"))
                    }
                    if fact_named(facts, column.groups[0]) {
                        return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is given twice"))
                    }
                    facts.push(TraitFact{name: column.groups[0].copy(), value: "true"})
                }
                TEXT.match(body) == .Val(column) -> {
                    if !TEXT_COLUMNS.contains(column.groups[0]) {
                        return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is not a text column ({TEXT_COLUMNS.join(", ")})"))
                    }
                    if fact_named(facts, column.groups[0]) {
                        return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is given twice"))
                    }
                    if column.groups[1].trim() == "" {
                        return Err(rows_fail("line {index}: {context}: `{column.groups[0]}` is empty; omit it"))
                    }
                    facts.push(TraitFact{name: column.groups[0].copy(), value: column.groups[1].copy()})
                }
                ASSOCIATED.match(body) == .Val(declared) -> {
                    if associated.contains(declared.groups[0]) {
                        return Err(rows_fail("line {index}: {context}: `{declared.groups[0]}: type` is declared twice"))
                    }
                    associated.push(declared.groups[0].copy())
                }
                body.starts_with("#Test ") && body.ends_with(" {{") -> {
                    head: body.remove_prefix("#Test ").partition(": fn(")
                    if head.sep == "" || METHOD_NAME.match(head.head) == None {
                        return Err(rows_fail("line {index}: {context}: a law is `#Test name: fn(a: Self) {{`, found `{body}`"))
                    }
                    loop law in laws {
                        if law.name == head.head {
                            return Err(rows_fail("line {index}: {context}: the law `{head.head}` is declared twice"))
                        }
                    }
                    written := [String]{body.copy()}
                    close: "{member_indent}}}"
                    loop index < lines.len() && lines[index] != close {
                        inner: lines[index]
                        index += 1
                        if inner.trim() != "" && !inner.starts_with("{member_indent}    ") {
                            return Err(rows_fail("line {index}: {context}: a law's body sits one level in from its `#Test`, found `{inner}`"))
                        }
                        written.push(inner.remove_prefix(member_indent))
                    }
                    if index >= lines.len() {
                        return Err(rows_fail("line {index}: {context}: the law `{head.head}` is not closed"))
                    }
                    index += 1
                    written.push("}}")
                    laws.push(TraitLaw{name: head.head.copy(), source: written.join("\n")})
                }
                METHOD_OPEN.match(body) != None && !body.ends_with(" {{") -> methods.push(parse_method(body, "line {index}: {context}") ?? return Err(err))
                METHOD_OPEN.match(body) != None -> {
                    method := parse_method(body.remove_suffix(" {{"), "line {index}: {context}") ?? return Err(err)
                    written := [String]{body.copy()}
                    close: "{member_indent}}}"
                    loop index < lines.len() && lines[index] != close {
                        inner: lines[index]
                        index += 1
                        if inner.trim() != "" && !inner.starts_with("{member_indent}    ") {
                            return Err(rows_fail("line {index}: {context}: a default body sits one level in from its method, found `{inner}`"))
                        }
                        written.push(inner.remove_prefix(member_indent))
                    }
                    if index >= lines.len() {
                        return Err(rows_fail("line {index}: {context}: the default `{method.name}` is not closed"))
                    }
                    index += 1
                    written.push("}}")
                    method.default_source = written.join("\n")
                    methods.push(method)
                }
                true -> return Err(rows_fail("line {index}: {context}: expected a fact column, `Name: type`, `name: fn(…)` or `#Test name: fn(…) {{`, found `{body}`"))
            }
        }
        if index >= lines.len() -> return Err(rows_fail("line {start}: {context} is not closed"))
        index += 1
        loop existing in traits {
            if existing.name == name {
                return Err(rows_fail("line {start}: {context} is declared twice"))
            }
        }
        traits.push(TraitSource{name: name, line: start, literal: group != "", role: role, facts: facts, associated: associated, methods: methods, laws: laws})
        role = ""
    }
    if role != "" -> return Err(rows_fail("line {role_line}: `#Builtin.Role(.{role})` stands above no trait"))
    if group != "" -> return Err(rows_fail("`module {group}` is not closed"))
    if traits.len() == 0 -> return Err(rows_fail("{SOURCE_PATH} declares no trait"))
    Ok(traits)
}

fact_named: fn(facts: [TraitFact], name: String) -> Bool Never! {
    loop row in facts {
        if row.name == name -> return true
    }
    false
}

// The `Type` constructor of a written type.
render_type: fn(text: String, context: String) -> String OwnedTraitRowsError! {
    if text.ends_with("?") {
        inner: render_type(text.remove_suffix("?"), context) ?? return Err(err)
        return Ok("Type.Option{{inner: {inner}}}")
    }
    if text.starts_with("[") && text.ends_with("]") {
        body: text.remove_prefix("[").remove_suffix("]")
        // `jet fmt` writes a map type `[K:V]`, with no space after the colon.
        pair: body.partition(":")
        if pair.sep != "" && pair.head.split("[").to_list().len() == pair.head.split("]").to_list().len() {
            key: render_type(pair.head.trim(), context) ?? return Err(err)
            value: render_type(pair.tail.trim(), context) ?? return Err(err)
            return Ok("Type.Map{{key: {key}, key_span: None, value: {value}}}")
        }
        element: render_type(body, context) ?? return Err(err)
        return Ok("Type.List{{element: {element}}}")
    }
    if text == {
        "Int" -> return Ok("Type.Int")
        "Float" -> return Ok("Type.Float")
        "Bool" -> return Ok("Type.Bool")
        "String" -> return Ok("Type.String")
        "U8" -> return Ok("Type.IntN{{signed: false, bits: 8}}")
        else -> {}
    }
    if NAME.match(text) == None -> return Err(rows_fail("{context}: cannot read the type `{text}`"))
    Ok("Type.Named{{name: \"{text}\"}}")
}

// What an `OwnedMethod` returns: None for no value, else the value or the
// `Result` of value and error.
render_returns: fn(method: TraitMethod, context: String) -> String OwnedTraitRowsError! {
    if method.returns == "" {
        if method.error == "Never" -> return Ok("None")
        err_type: render_type(method.error, context) ?? return Err(err)
        return Ok("Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: {err_type}}})")
    }
    ok: render_type(method.returns, context) ?? return Err(err)
    if method.error == "Never" -> return Ok("Val({ok})")
    err_type: render_type(method.error, context) ?? return Err(err)
    Ok("Val(Type.Result{{ok: {ok}, err: {err_type}}})")
}

render_method: fn(method: TraitMethod, any_receiver: Bool, context: String) -> String OwnedTraitRowsError! {
    where: "{context}.{method.name}"
    receiver: if method.receiver == {
        "" -> "OwnedReceiver.Static"
        "self" -> if any_receiver -> "OwnedReceiver.Any" else -> "OwnedReceiver.Fixed{{access: AccessConvention.Read}}"
        "^self" -> "OwnedReceiver.Fixed{{access: AccessConvention.Write}}"
        else -> "OwnedReceiver.Fixed{{access: AccessConvention.Move}}"
    }
    if any_receiver && method.receiver != "self" {
        return Err(rows_fail("{where}: `any_receiver` takes a plain `self`"))
    }
    params := [String]{}
    loop param in method.params {
        access: if {
            param.ty.starts_with("^^") -> "Move"
            param.ty.starts_with("^") -> "Write"
            else -> "Read"
        }
        ty: render_type(param.ty.remove_prefix("^").remove_prefix("^"), where) ?? return Err(err)
        params.push("OwnedParam{{name: \"{param.name}\", access: AccessConvention.{access}, ty: {ty}}}")
    }
    returns: render_returns(method, where) ?? return Err(err)
    written: if method.default_source == "" -> "" else -> ", default_source: Val(\"{jet_text(method.default_source)}\")"
    Ok("OwnedMethod{{name: \"{method.name}\", receiver: {receiver}, params: [OwnedParam]{{{params.join(", ")}}}, returns: {returns}{written}}}")
}

// `text` as the inside of a Jet string literal.
jet_text: fn(text: String) -> String Never! {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("{{", "{{{{").replace("}}", "}}}}").replace("\n", "\\n")
}

// A default calls no method that has a default, its own included, so no
// default can reach itself.
check_defaults: fn(source: TraitSource, context: String) OwnedTraitRowsError! {
    loop method in source.methods {
        if method.default_source == "" -> next
        loop other in source.methods {
            if other.default_source != "" && method.default_source.contains("self.{other.name}(") {
                return Err(rows_fail("{context}: the default `{method.name}` calls `{other.name}`, which has a default; a default calls only methods every impl writes"))
            }
        }
    }
}

quoted: fn(names: [String]) -> String Never! {
    parts := [String]{}
    loop name in names -> parts.push("\"{name}\"")
    "[String]{{{parts.join(", ")}}}"
}

optional_text: fn(source: TraitSource, name: String) -> String Never! {
    value: fact(source, name) ?? return "None"
    "Val(\"{value}\")"
}

// The contract kinds a trait's facts and placement select; a valid trait selects at most one.
contract_kinds: fn(source: TraitSource) -> [String] Never! {
    kinds := [String]{}
    if flag(source, "codec") -> kinds.push("codec")
    if flag(source, "conversion") -> kinds.push("conversion")
    if flag(source, "derived") -> kinds.push("derived")
    if flag(source, "checked_text") -> kinds.push("checked_text")
    // A role whose trait takes a right-hand operand is an operator's: its
    // one method is the hook the role's operators call.
    if source.role != "" && source.associated.contains("Rhs") -> kinds.push("operator role")
    if source.literal -> kinds.push("module Literal")
    kinds
}

sole_method: fn(source: TraitSource, context: String, kind: String) -> TraitMethod OwnedTraitRowsError! {
    if source.methods.len() != 1 {
        return Err(rows_fail("{context}: a `{kind}` trait declares exactly one `fn`"))
    }
    Ok(source.methods[0])
}

// One OWNED_TRAITS row.
render_row: fn(source: TraitSource, traits: [TraitSource], checked_text_declared: Bool) -> String OwnedTraitRowsError! {
    context: "line {source.line}: trait {source.name}"
    kinds: contract_kinds(source)
    if kinds.len() > 1 {
        return Err(rows_fail("{context}: {kinds.join(" and ")} select different contracts"))
    }
    kind: if kinds.len() == 1 -> kinds[0].copy() else -> "methods"
    if kind != "methods" && (fact(source, "shares") != None || flag(source, "any_receiver")) {
        return Err(rows_fail("{context}: `shares` and `any_receiver` belong to a methods trait"))
    }
    if kind != "operator role" && flag(source, "commutative") {
        return Err(rows_fail("{context}: `commutative` belongs to an operator trait"))
    }
    loop method in source.methods {
        if kind != "methods" && method.default_source != "" {
            return Err(rows_fail("{context}: only a methods trait gives a default"))
        }
    }
    check_defaults(source, context) ?? return Err(err)
    loop name in words(source, "requires") {
        if name == source.name || !declared(traits, name) {
            return Err(rows_fail("{context}: `requires` names `{name}`, which is not another trait here"))
        }
    }
    loop name in words(source, "shares") {
        if name == source.name || !declared(traits, name) {
            return Err(rows_fail("{context}: `shares` names `{name}`, which is not another trait here"))
        }
    }
    contract := ""
    if kind == {
        "operator role" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            if method.receiver != "self" || method.params.len() != 1 || method.params[0].ty != "Rhs" || !source.associated.contains("Rhs") || method.error != "Never" || method.returns == "" {
                return Err(rows_fail("{context}: an operator hook is `Rhs: type` and `hook: fn(self, rhs: Rhs) -> Result Never!`"))
            }
            result := "None"
            if !source.associated.contains(method.returns) {
                fixed: render_type(method.returns, context) ?? return Err(err)
                result = "Val({fixed})"
            }
            contract = "OwnedContract.Operator{{hook: \"{method.name}\", result: {result}}}"
        }
        "codec" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            contract = "OwnedContract.Codec{{verb: \"{method.name}\"}}"
        }
        "conversion" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            if method.receiver != "" || method.params.len() != 1 || method.params[0].ty != "Source" || !source.associated.contains("Source") || method.returns != "Self" {
                return Err(rows_fail("{context}: a conversion is `Source: type` and `hook: fn(value: Source) -> Self Error!`"))
            }
            contract = "OwnedContract.Conversion{{hook: \"{method.name}\"}}"
        }
        "module Literal" -> {
            method: sole_method(source, context, kind) ?? return Err(err)
            if method.name != "from_literal" || method.receiver != "" || method.params.len() != 1 {
                return Err(rows_fail("{context}: a literal capability is `from_literal: fn(value: Source) -> Self Never!`"))
            }
            literal_source: render_type(method.params[0].ty, context) ?? return Err(err)
            contract = "OwnedContract.Literal{{source: {literal_source}}}"
        }
        "checked_text" -> {
            if source.methods.len() > 0 || source.associated.len() > 0 {
                return Err(rows_fail("{context}: `checked_text` takes its methods from {PRELUDE_PATH}"))
            }
            if !checked_text_declared {
                return Err(rows_fail("{context}: {PRELUDE_PATH} no longer declares `CheckedText: trait`"))
            }
            contract = "OwnedContract.CheckedText"
        }
        "derived" -> {
            if source.methods.len() > 0 || source.associated.len() > 0 {
                return Err(rows_fail("{context}: a derived trait declares no member the compiler reads"))
            }
            contract = "OwnedContract.Derived"
        }
        else -> {
            if source.methods.len() == 0 {
                return Err(rows_fail("{context}: a methods trait declares at least one `fn`"))
            }
            lines := [String]{}
            loop method in source.methods {
                rendered: render_method(method, flag(source, "any_receiver"), "trait {source.name}") ?? return Err(err)
                lines.push("                {rendered},\n")
            }
            shares: optional_text(source, "shares")
            contract = "OwnedContract.Methods{{\n            methods: [OwnedMethod]{{\n{lines.join("")}            }},\n            associated: {quoted(source.associated)},\n            shares: {shares},\n        }}"
        }
    }
    fields := [String]{
        "name: \"{source.name}\"",
        "local: {flag(source, "local")}",
        "bare_bound: {flag(source, "bare_bound")}",
        "raw_return: {flag(source, "raw_return")}",
        "contract: {contract}",
        "commutative: {flag(source, "commutative")}",
        "requires: {quoted(words(source, "requires"))}",
        "auto_derive: {flag(source, "auto_derive")}",
        "auto_derive_family: {optional_text(source, "auto_derive_family")}",
        "bundle: {flag(source, "bundle")}",
        "through_elements: {flag(source, "through_elements")}",
    }
    if source.laws.len() > 0 {
        rendered: loop law in source.laws -> "OwnedLaw{{name: \"{law.name}\", source: \"{jet_text(law.source)}\"}}"
        fields.push("laws: [OwnedLaw]{{{rendered.join(", ")}}}")
    }
    if fact(source, DECLARED_IN_COLUMN) == .Val(module_name) {
        fields.push("declared_in: \"{module_name}\"")
    }
    if source.role != "" -> fields.push("role: \"{source.role}\"")
    // A row stays on one line unless its contract spans lines; then, as
    // `jet fmt` writes it, each field has a line of its own.
    if !contract.contains("\n") -> return Ok("    OwnedTrait{{{fields.join(", ")}}},")
    expanded: loop field in fields -> "        {field},\n"
    Ok("    OwnedTrait{{\n{expanded.join("")}    }},")
}

declared: fn(traits: [TraitSource], name: String) -> Bool Never! {
    loop source in traits {
        if source.name == name -> return true
    }
    false
}

// The facts no single trait can check: each role fills one trait, and family
// markers that name no trait.
check_table: fn(traits: [TraitSource]) OwnedTraitRowsError! {
    roles := [String]{}
    loop source in traits {
        if source.role != "" {
            if roles.contains(source.role) {
                return Err(rows_fail("trait {source.name}: the role `{source.role}` already belongs to another trait"))
            }
            roles.push(source.role.copy())
        }
        family: fact(source, FAMILY_COLUMN) ?? next
        if declared(traits, family) {
            return Err(rows_fail("trait {source.name}: the family marker `{family}` is also a trait name"))
        }
    }
}

// `source` with the members its Core module's declaration gives it
// (`declared_in`), as read into `homes`; any other trait as it is.
homed: fn(source: TraitSource, homes: [TraitSource]) -> TraitSource OwnedTraitRowsError! {
    module_name: fact(source, DECLARED_IN_COLUMN) ?? return Ok(source)
    context: "line {source.line}: trait {source.name}"
    if source.methods.len() > 0 || source.associated.len() > 0 || source.laws.len() > 0 {
        return Err(rows_fail("{context}: `declared_in` takes its members from the declaration in {module_name}"))
    }
    loop home in homes {
        if home.name != source.name -> next
        if home.facts.len() > 0 {
            return Err(rows_fail("{context}: the declaration in {module_name} writes a fact column; facts stay in {SOURCE_PATH}"))
        }
        return Ok(TraitSource{name: source.name, line: source.line, literal: source.literal, role: source.role, facts: source.facts, associated: home.associated, methods: home.methods, laws: home.laws})
    }
    Err(rows_fail("{context}: {module_name} declares no `{source.name}: trait`"))
}

// `homes` holds the declaration of each trait with a `declared_in`
// (home_traits).
render_rows: fn(source_text: String, checked_text_declared: Bool, homes: [TraitSource]) -> String OwnedTraitRowsError! {
    traits: read_traits(source_text) ?? return Err(err)
    check_table(traits) ?? return Err(err)
    rows := [String]{}
    loop source in traits {
        written: homed(source, homes) ?? return Err(err)
        rows.push(render_row(written, traits, checked_text_declared) ?? return Err(err))
    }
    Ok("// Source: {SOURCE_PATH}\n// Source SHA-256: {crypto.sha256(source_text).hex()}\n{GENERATED_BY}\n// Every trait the compiler owns, in declaration order; OwnedTraits.jet\n// holds the row shape and the questions its readers ask.\nOWNED_TRAITS: [OwnedTrait]{{\n{rows.join("\n")}\n}}\n")
}

// The traits a marker covers, written for a reader: `Encode` and `Decode`.
spelled: fn(names: [String]) -> String Never! {
    parts := [String]{}
    loop name in names -> parts.push("`{name}`")
    if parts.len() == 2 -> return "{parts[0]} and {parts[1]}"
    parts.join(", ")
}

// What `#{marker}` means, read from the table.
marker_text: fn(marker: String, traits: [TraitSource]) -> String Never! {
    derives := [String]{}
    bundles := [String]{}
    loop source in traits {
        if (source.name == marker && flag(source, "auto_derive")) || fact(source, "auto_derive_family") == Val((marker)) {
            derives.push(source.name.copy())
        }
        if source.name == marker && flag(source, "bundle") -> bundles.push(source.name.copy())
    }
    parts := [String]{}
    if derives.len() > 0 {
        parts.push("On a struct or enum, derives {spelled(derives)} from its fields; `#!{marker}` refuses it.")
    }
    if bundles.len() > 0 {
        parts.push("On a distinct type, keeps the base type's {spelled(bundles)}.")
    }
    parts.join(" ")
}

// The dictionary rows of every derive and bundle marker, sorted by token.
render_dictionary_rows: fn(source_text: String) -> String OwnedTraitRowsError! {
    traits: read_traits(source_text) ?? return Err(err)
    markers := [String]{}
    loop source in traits {
        if (flag(source, "auto_derive") || flag(source, "bundle")) && !markers.contains(source.name) {
            markers.push(source.name.copy())
        }
        family: fact(source, FAMILY_COLUMN) ?? next
        if !markers.contains(family) -> markers.push(family.copy())
    }
    markers.sort()
    rows := [String]{}
    loop marker in markers {
        rows.push("    {{token: \"{marker}\", query: \"{marker.lower()}\", registry_name: \"{REGISTRY_NAME}\", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{{JetCLISyntaxMeaning{{position: \"\", text: \"{marker_text(marker, traits)}\", example: \"#{marker} …\", afterwards: \"\", related_codes: [String]{{}}}}}}}},\n")
    }
    Ok("{DICTIONARY_OPEN}\n{rows.join("")}{DICTIONARY_CLOSE}\n")
}

// `text`, the file at `path`, with its block from the `open` line through the
// `close` line replaced by `block`.
replace_block: fn(text: String, open: String, close: String, path: String, block: String) -> String OwnedTraitRowsError! {
    before: text.partition("{open}\n")
    if before.sep == "" {
        return Err(rows_fail("{path} has no `{open.trim()}` line"))
    }
    after: before.tail.partition("{close}\n")
    if after.sep == "" {
        return Err(rows_fail("{path} has no `{close.trim()}` line"))
    }
    if after.tail.contains(open) {
        return Err(rows_fail("{path} has two `{open.trim()}` blocks"))
    }
    Ok("{before.head}{block}{after.tail}")
}

read_text: fn(path: String) -[FS]> String OwnedTraitRowsError! {
    files.read(path) ?? return Err(rows_fail("cannot read {path}: {err}"))
}

// The `Name: trait {` block of `source_text`, from its opening line through
// the `}` that closes it, or "" when the source declares no such trait.
trait_block: fn(source_text: String, name: String) -> String Never! {
    opening: "{name}: trait {{"
    block := [String]{}
    loop line in source_text.split("\n").to_list() {
        if block.len() == 0 {
            if line == opening -> block.push(line.copy())
            next
        }
        block.push(line.copy())
        if line == "}}" -> return "{block.join("\n")}\n"
    }
    ""
}

// The trait `stub` as its Core module declares it in `block`, read from
// `path`. A `raw_return` trait's declaration writes a requirement as its
// impls do (`encode: fn(self) -> Dyn`), with no failure carrier, which a row
// spells `Never!`.
home_trait: fn(stub: TraitSource, block: String, path: String) -> TraitSource OwnedTraitRowsError! {
    raw: flag(stub, "raw_return")
    lines := [String]{}
    loop line in block.split("\n").to_list() {
        bare: raw && METHOD_OPEN.match(line.trim()) != None && line.ends_with(",") && !line.ends_with("!,")
        lines.push(if bare -> "{line.remove_suffix(",")} Never!," else -> line.copy())
    }
    declared_traits: read_traits(lines.join("\n")) ?? return Err(rows_fail("{path}: {err.message.remove_prefix("owned trait rows: ")}"))
    Ok(declared_traits[0])
}

// The source path Core.rows gives the Core module `module_name`.
core_source_path: fn(core_rows: String, module_name: String) -> String OwnedTraitRowsError! {
    head: "source_module {module_name} path "
    loop line in core_rows.split("\n").to_list() {
        if line.starts_with(head) -> return Ok(line.remove_prefix(head).partition(" ").head.copy())
    }
    Err(rows_fail("{CORE_ROWS_PATH} has no `source_module {module_name}` row"))
}

// The declaration of each trait of `source_text` with a `declared_in`, read
// from that Core module's source.
home_traits: fn(source_text: String) -[FS]> [TraitSource] OwnedTraitRowsError! {
    traits: read_traits(source_text) ?? return Err(err)
    homes := [TraitSource]{}
    core_rows := ""
    loop source in traits {
        module_name: fact(source, DECLARED_IN_COLUMN) ?? next
        if core_rows == "" -> core_rows = read_text(CORE_ROWS_PATH) ?? return Err(err)
        path: core_source_path(core_rows, module_name) ?? return Err(err)
        module_text: read_text(path) ?? return Err(err)
        block: trait_block(module_text, source.name)
        if block == "" {
            return Err(rows_fail("trait {source.name}: {path} declares no `{source.name}: trait`"))
        }
        homes.push(home_trait(source, block, path) ?? return Err(err))
    }
    Ok(homes)
}

// A role a Core function's marker gives, and the file that marks it.
RoleMark: struct {
    role: String,
    path: String,
}

// The roles the function markers of `text`, the Core source at `path`, give,
// in line order.
function_roles: fn(path: String, text: String, marks: ^[RoleMark]) {
    if !text.contains(FUNCTION_ROLE_PREFIX) -> return
    loop line in text.split("\n").to_list() {
        if !line.starts_with("#{FUNCTION_ROLE_PREFIX}") && !line.starts_with("#[{FUNCTION_ROLE_PREFIX}") -> next
        found: FUNCTION_ROLE_MARKER.match(line) ?? next
        marks.push(RoleMark{role: found.groups[0].copy(), path: path.copy()})
    }
}

// The roles the functions of every Core source under `folder` give, by path.
core_roles: fn(folder: String, marks: ^[RoleMark]) -[FS]> OwnedTraitRowsError! {
    names := [String]{}
    loop entry in (files.list_dir(folder) ?? return Err(rows_fail("cannot list {folder}: {err}"))) -> names.push(entry.name.copy())
    names.sort()
    loop name in names {
        path: "{folder}/{name}"
        if files.is_dir(path) {
            core_roles(path, marks) ?? return Err(err)
            next
        }
        if !path.ends_with(".jet") -> next
        function_roles(path, read_text(path) ?? return Err(err), marks)
    }
}

// The roles the traits of `traits` give, after the Core functions' in `marks`.
trait_roles: fn(traits: [TraitSource], marks: ^[RoleMark]) {
    loop source in traits {
        if source.role != "" -> marks.push(RoleMark{role: source.role.copy(), path: "{SOURCE_PATH} trait {source.name}"})
    }
}

// The RoleKind block: a case for each role in `marks`, in order. A role two
// markers give is refused.
render_role_kind: fn(marks: [RoleMark]) -> String OwnedTraitRowsError! {
    loop index in 0..<marks.len() {
        loop earlier in 0..<index {
            if marks[earlier].role == marks[index].role {
                return Err(rows_fail("`#Builtin.Role(.{marks[index].role})` marks two declarations: in {marks[earlier].path} and in {marks[index].path}"))
            }
        }
    }
    cases: loop mark in marks -> "    {mark.role},\n"
    Ok("{ROLE_KIND_OPEN}\nRoleKind: enum {{\n{cases.join("")}}}\n{ROLE_KIND_CLOSE}\n")
}

generated_files: fn() -[FS]> [TextFile] OwnedTraitRowsError! {
    source_text: read_text(SOURCE_PATH) ?? return Err(err)
    prelude: read_text(PRELUDE_PATH) ?? return Err(err)
    homes: home_traits(source_text) ?? return Err(err)
    rows: render_rows(source_text, prelude.contains(CHECKED_TEXT_DECLARATION), homes) ?? return Err(err)
    dictionary: read_text(DICTIONARY_PATH) ?? return Err(err)
    block: render_dictionary_rows(source_text) ?? return Err(err)
    next_dictionary: replace_block(dictionary, DICTIONARY_OPEN, DICTIONARY_CLOSE, DICTIONARY_PATH, block) ?? return Err(err)
    marks := [RoleMark]{}
    core_roles(CORE_TREE, marks) ?? return Err(err)
    trait_roles(read_traits(source_text) ?? return Err(err), marks)
    role_kind: render_role_kind(marks) ?? return Err(err)
    next_builtins: replace_block(read_text(BUILTINS_PATH) ?? return Err(err), ROLE_KIND_OPEN, ROLE_KIND_CLOSE, BUILTINS_PATH, role_kind) ?? return Err(err)
    Ok([TextFile]{TextFile{path: ROWS_PATH, text: rows}, TextFile{path: DICTIONARY_PATH, text: next_dictionary}, TextFile{path: BUILTINS_PATH, text: next_builtins}})
}

owned_trait_rows_main: fn(args: [String]) -[FS]> String OwnedTraitRowsError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") {
        return Err(rows_fail("usage: OwnedTraitRows.jet [--check|--write]"))
    }
    generated: generated_files() ?? return Err(err)
    differing := [String]{}
    loop file in generated {
        current: if files.exists(file.path) -> read_text(file.path) ?? return Err(err) else -> ""
        if current == file.text -> next
        differing.push(file.path.copy())
        if mode == "--write" {
            files.write(file.path, file.text) ?? return Err(rows_fail("cannot write {file.path}: {err}"))
        }
    }
    if mode == "--write" {
        return Ok("owned trait copies written: {differing.len()} rewritten of {generated.len()}")
    }
    if differing.len() == 0 {
        return Ok("owned trait rows check passed: {generated.len()} copies match")
    }
    Err(rows_fail("{differing.join(", ")} differ from their declarations; run jet Tools/Agent/OwnedTraitRows.jet --write"))
}

run: fn() { print(owned_trait_rows_main(process.args()) ?? process.fail(1, err.message)) }

// The error text render_rows reports for `source`, or "" when it accepts it.
rows_error: fn(source: String, homes: [TraitSource]{[TraitSource]{}}) -> String Never! {
    if render_rows(source, true, homes) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

MINIMAL_TRAITS: "// Two traits.\n#Builtin.Role(.Add)\nAdd: trait {{\n    local: Bool{{true}},\n    Rhs: type,\n    Output: type,\n    add: fn(self, rhs: Rhs) -> Output Never!,\n}}\n\nDriver: trait {{\n    auto_derive: Bool{{true}},\n    auto_derive_family: String{{\"Bundle\"}},\n    query: fn(^self, sql: SQL) -> [[String: DBValue]] DBError!,\n    fill: fn(^self, buffer: ^[U8], limit: Int) -> Int IOError!,\n    close: fn(^^self) IOError!,\n}}\n\nLiteral: module {{\n    Int: trait {{\n        from_literal: fn(value: Int) -> Self Never!,\n    }}\n}}\n"

#Test("every generated copy matches its Prelude declaration") {
    if owned_trait_rows_main([String]{"--check"}) == .Err(error) -> panic(error.message)
}

#Test("a declaration renders its contract, types and facts") {
    rendered: render_rows(MINIMAL_TRAITS, true, [TraitSource]{}) ?? panic("the minimal traits did not render: {err.message}")
    assert(rendered.contains("OwnedTrait{{name: \"Add\", local: true, bare_bound: false, raw_return: false, contract: OwnedContract.Operator{{hook: \"add\", result: None}}, commutative: false, requires: [String]{{}},"))
    assert(rendered.contains("through_elements: false, role: \"Add\"}},"))
    assert(rendered.contains("OwnedMethod{{name: \"query\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Write}}, params: [OwnedParam]{{OwnedParam{{name: \"sql\", access: AccessConvention.Read, ty: Type.Named{{name: \"SQL\"}}}}}}, returns: Val(Type.Result{{ok: Type.List{{element: Type.Map{{key: Type.String, key_span: None, value: Type.Named{{name: \"DBValue\"}}}}}}, err: Type.Named{{name: \"DBError\"}}}})}}"))
    assert(rendered.contains("OwnedMethod{{name: \"fill\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Write}}, params: [OwnedParam]{{OwnedParam{{name: \"buffer\", access: AccessConvention.Write, ty: Type.List{{element: Type.IntN{{signed: false, bits: 8}}}}}}, OwnedParam{{name: \"limit\", access: AccessConvention.Read, ty: Type.Int}}}}, returns: Val(Type.Result{{ok: Type.Int, err: Type.Named{{name: \"IOError\"}}}})}}"))
    assert(rendered.contains("OwnedMethod{{name: \"close\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Move}}, params: [OwnedParam]{{}}, returns: Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: Type.Named{{name: \"IOError\"}}}})}}"))
    assert(rendered.contains("        auto_derive: true,\n        auto_derive_family: Val(\"Bundle\"),\n"))
    assert(rendered.contains("OwnedTrait{{name: \"Literal.Int\", local: false, bare_bound: false, raw_return: false, contract: OwnedContract.Literal{{source: Type.Int}},"))
    block: render_dictionary_rows(MINIMAL_TRAITS) ?? panic(err.message)
    assert(block.contains("{{token: \"Bundle\", query: \"bundle\", registry_name: \"OWNED_TRAITS\","))
    assert(block.contains("text: \"On a struct or enum, derives `Driver` from its fields; `#!Bundle` refuses it.\""))
}

SINK_TRAIT: "Sink: trait {{\n    put: fn(^self, bytes: [U8]) IOError!,\n    say: fn(^self, text: String) IOError! {{\n        self.put(\"{{text}}\".bytes())\n    }}\n}}\n"

#Test("a default carries its method as written, and calls no default") {
    rendered: render_rows(SINK_TRAIT, true, [TraitSource]{}) ?? panic("the sink trait did not render: {err.message}")
    assert(rendered.contains("OwnedMethod{{name: \"put\", receiver: OwnedReceiver.Fixed{{access: AccessConvention.Write}}, params: [OwnedParam]{{OwnedParam{{name: \"bytes\", access: AccessConvention.Read, ty: Type.List{{element: Type.IntN{{signed: false, bits: 8}}}}}}}}, returns: Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: Type.Named{{name: \"IOError\"}}}})}},"))
    assert(rendered.contains("returns: Val(Type.Result{{ok: Type.Named{{name: \"Unit\"}}, err: Type.Named{{name: \"IOError\"}}}}), default_source: Val(\"say: fn(^self, text: String) IOError! {{{{\\n    self.put(\\\"{{{{text}}}}\\\".bytes())\\n}}}}\")}},"))
    assert(rows_error(SINK_TRAIT.replace("self.put(", "self.say(")).contains("the default `say` calls `say`, which has a default"))
    assert(rows_error(SINK_TRAIT.replace("        self.put", "    self.put")).contains("a default body sits one level in"))
    assert(rows_error(SINK_TRAIT.replace("    }}\n}}\n", "")).contains("the default `say` is not closed"))
}

HOMED_TRAIT: "Decode: trait {{\n    codec: Bool{{true}},\n    declared_in: String{{\"core.encoding\"}},\n}}\n"

HOME_SOURCE: "// A value read back.\nDecode: trait {{\n    decode: fn(tree: Dyn) -> Self [FieldError]!,\n}}\n\nOther: trait {{\n}}\n"

#Test("a trait a Core module declares takes its members from that declaration") {
    block: trait_block(HOME_SOURCE, "Decode")
    assert_eq(block, "Decode: trait {{\n    decode: fn(tree: Dyn) -> Self [FieldError]!,\n}}\n")
    homes: read_traits(block) ?? panic(err.message)
    rendered: render_rows(HOMED_TRAIT, true, homes) ?? panic("the homed trait did not render: {err.message}")
    assert(rendered.contains("contract: OwnedContract.Codec{{verb: \"decode\"}},"))
    assert(rendered.contains("through_elements: false, declared_in: \"core.encoding\"}},"))
    assert(rows_error(HOMED_TRAIT).contains("core.encoding declares no `Decode: trait`"))
    assert(rows_error(HOMED_TRAIT.replace("}}\n", "    decode: fn(tree: Dyn) -> Self [FieldError]!,\n}}\n"), homes).contains("takes its members from the declaration in core.encoding"))
    assert(rows_error(HOMED_TRAIT, read_traits(block.replace("    decode", "    codec: Bool{{true}},\n    decode")) ?? panic(err.message)).contains("facts stay in"))
    assert_eq(trait_block(HOME_SOURCE, "Encode"), "")
    assert_eq(core_source_path("module core.encoding exports {{ Dyn }}\nsource_module core.encoding path Core/Encoding/Encoding.jet alias core_encoding\n", "core.encoding") ?? panic(err.message), "Core/Encoding/Encoding.jet")
    stub: read_traits("Encode: trait {{\n    raw_return: Bool{{true}},\n    declared_in: String{{\"core.encoding\"}},\n}}\n") ?? panic(err.message)
    encode_block: "Encode: trait {{\n    encode: fn(self) -> Dyn,\n}}\n"
    encode: home_trait(stub[0], encode_block, "Encoding.jet") ?? panic(err.message)
    assert_eq(encode.methods[0].returns, "Dyn")
    assert_eq(encode.methods[0].error, "Never")
    refused: read_traits(HOMED_TRAIT) ?? panic(err.message)
    assert(home_trait(refused[0], encode_block, "Encoding.jet") == .Err(_))
}

#Test("a declaration that breaks the source rules is refused") {
    traits: MINIMAL_TRAITS
    assert(rows_error(traits.replace("    local: Bool{{true}},\n", "    local: Bool{{false}},\n")).contains("expected a fact column"))
    assert(rows_error(traits.replace("    local: Bool{{true}},\n", "    lokal: Bool{{true}},\n")).contains("not a flag column"))
    assert(rows_error(traits.replace("    local", "    codec: Bool{{true}},\n    local")).contains("select different contracts"))
    assert(rows_error(traits.replace("Driver: trait", "#Builtin.Role(.Add)\nDriver: trait")).contains("the role `Add` already belongs to another trait"))
    assert(rows_error(traits.replace("Add: trait", "// The sum.\nAdd: trait")).contains("stands above no trait"))
    assert(rows_error(traits.replace("Driver: trait", "Add: trait")).contains("declared twice"))
    assert(rows_error(traits.replace("(self, rhs: Rhs)", "(self, other: Int)")).contains("an operator hook is"))
    assert(rows_error(traits.replace(" -> Output Never!", " -> Output")).contains("ends `Never!`"))
    assert(rows_error(traits.replace("String{{\"Bundle\"}}", "String{{\"Add\"}}")).contains("also a trait name"))
    assert(rows_error(traits.replace("    auto_derive: Bool{{true}},\n", "    requires: String{{\"Missing\"}},\n")).contains("not another trait here"))
    assert(rows_error(traits.replace("    auto_derive: Bool{{true}},\n", "    commutative: Bool{{true}},\n    auto_derive: Bool{{true}},\n")).contains("belongs to an operator trait"))
    assert(rows_error(traits.replace("Literal: module", "Other: module")).contains("only `Literal: module`"))
    assert(rows_error(traits.replace("value: Int)", "value: (Int))")).contains("cannot read the type"))
}

#Test("a generated block is replaced in place") {
    dictionary: "a\n{DICTIONARY_OPEN}\nold\n{DICTIONARY_CLOSE}\nb\n"
    assert_eq(replace_block(dictionary, DICTIONARY_OPEN, DICTIONARY_CLOSE, DICTIONARY_PATH, "{DICTIONARY_OPEN}\nnew\n{DICTIONARY_CLOSE}\n") ?? panic(err.message), "a\n{DICTIONARY_OPEN}\nnew\n{DICTIONARY_CLOSE}\nb\n")
    assert(replace_block("a\n", DICTIONARY_OPEN, DICTIONARY_CLOSE, DICTIONARY_PATH, "") == .Err(_))
}

#Test("the role markers give RoleKind one case each, Core functions first") {
    marks := [RoleMark]{}
    function_roles("Core/Math/Math.jet", "// #Builtin.Role(.Note)\n#Builtin.Role(.AbsFloat) abs_float: fn(x: Float) -> Float {{ x }}\n#Builtin.Role(.Bare)\n#[Builtin.Role(.Copy), Unsafe(\"why\")]\ncopy: fn() {{}}\n", marks)
    trait_roles(read_traits(MINIMAL_TRAITS) ?? panic(err.message), marks)
    block: render_role_kind(marks) ?? panic(err.message)
    assert_eq(block, "{ROLE_KIND_OPEN}\nRoleKind: enum {{\n    AbsFloat,\n    Copy,\n    Add,\n}}\n{ROLE_KIND_CLOSE}\n")
    builtins: "x\n{ROLE_KIND_OPEN}\nRoleKind: enum {{\n    Old,\n}}\n{ROLE_KIND_CLOSE}\ny\n"
    assert_eq(replace_block(builtins, ROLE_KIND_OPEN, ROLE_KIND_CLOSE, BUILTINS_PATH, block) ?? panic(err.message), "x\n{block}y\n")
    function_roles("Core/Event/Event.jet", "#Builtin.Role(.Add) plus: fn(a: Int, b: Int) -> Int {{ a + b }}\n", marks)
    if render_role_kind(marks) == {
        .Ok(_) -> panic("a role two markers give was accepted")
        .Err(error) -> assert(error.message.contains("marks two declarations: in Compiler/Prelude/Traits.jet trait Add and in Core/Event/Event.jet"))
    }
}
