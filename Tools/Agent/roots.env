# The dev tool roots: the one table every repository tool reads. roots.sh
# sources it, roots.mjs asks roots.sh, and the Jet tools read it through
# Tools/Agent/Roots.jet (core.sys.env_text). Each line's default takes an unset
# or empty root's place, and a later line sees an earlier one. A machine sets
# its own values in the environment or in ${XDG_CONFIG_HOME:-~/.config}/jet/env,
# which every reader applies first; without them the defaults derive from
# $HOME and the XDG directories, so a fresh clone needs no setup. The file
# holds assignments only, in the format roots.sh's header documents.
#
#   JET_STATE_ROOT    per-user dev state and caches
#   JET_SCRATCH_ROOT  large shared scratch
#   JET_RUN_ROOT      land queue, locks, slot ledger
#   JET_BASE_ROOT     published compilers
#   JET_TARGET_ROOT   build target dirs
#   JET_SEEDS         seed store
#   JET_SEED          the admitted seed dir
#   JET_BIN           the jet under test, which `jet test` passes its children
#
# JET_DEV_WORKTREE, the checkout the lander commits to, is not in the table:
# each reader defaults it to the checkout holding the reader.
JET_STATE_ROOT=${JET_STATE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/jet-dev}
JET_SCRATCH_ROOT=${JET_SCRATCH_ROOT:-$JET_STATE_ROOT}
JET_RUN_ROOT=${JET_RUN_ROOT:-$JET_SCRATCH_ROOT/run}
JET_BASE_ROOT=${JET_BASE_ROOT:-$JET_SCRATCH_ROOT/discovery/base}
JET_TARGET_ROOT=${JET_TARGET_ROOT:-$JET_SCRATCH_ROOT/targets}
JET_SEEDS=${JET_SEEDS:-${XDG_DATA_HOME:-$HOME/.local/share}/jet-seeds}
JET_SEED=${JET_SEED:-$JET_SEEDS/current}
JET_BIN=${JET_BIN:-$JET_SEED/jet}
