#!/usr/bin/env jet
// Format corpus: every tracked Jet source under Compiler/, Core/, Examples/,
// Jetpack/, Tools/ and tests/ is in the canonical form `jet fmt` writes, and
// this tool keeps it so. `--check` names each source the formatter would
// change; `--write` formats those sources in place (the one deliberate corpus
// cutover), checks that a second pass changes nothing, and moves every pin
// that means a formatted source. The formatter is the one of the compiler
// `$JET` names (default `jet`).
//
// A format keeps meaning: `jet fmt` itself refuses a source whose formatted
// text would parse to a different program (an internal compiler error naming
// the first node that differs), so the source stays as written. This tool
// reports each such source and exits 1, so a formatter defect can't change
// what the corpus means.
//
// A pin means a place or the bytes of a source, in a tracked `.case` or
// expectation file (`.out`, `.stdout`, `.stderr`, `.err`, `.warn`,
// `.expected`, `.fixture`, `.log`, `.txt`, `.json`, `.tsv`, `.list`):
// - a line and an optional column: `<file>.jet:<line>[:<column>]`,
//   `<source>:<line>[:<column>]`, a JSON object (or the one around it) that
//   names its `path`, `file` or `source` and holds a `line` and an optional
//   `column`, or a JSON path's `.line = <n>` with the `.column = <n>` of the
//   same path;
// - byte offsets: `<file>.jet:<start>..<end>`, a `span=<start>..<end>` after
//   a named place on its line, or the `start` and `end` of a JSON `span`
//   object or of an object that names its source;
// - a digest: the lowercase hex SHA-256 of a source's bytes.
// `jet fmt` keeps the tokens and changes blank space, besides a few canonical
// spellings (`Unit` to `()`, a trailing comma), so a place or an offset moves
// to where the non-blank byte it pointed at (or the next one both texts keep)
// now sits, and the digest of a formatted source becomes the digest of its
// new bytes.
//
// A name means the run's sources whose path in a case's fixtures (or in an
// expectation's stem folder) ends with it, narrowed to the ones the case's
// last step before the pin names; after a case's `copy:` or `write:` put a
// file under that name, it means the source that line copied, or none. Else
// it is joined to the case's folder (or the expectation's nearest folder that
// holds sources), else to the checkout root. A pin that names no source means
// the case's fixture sources, or the expectation's same-named source (else its
// stem folder's), narrowed alike. A pin whose sources move it differently
// stays as written and is reported, as is a digest in a case whose fixture
// sources were formatted that is no source's digest (it may hash one with
// more, as a build key does). Snapshots of the UI, golden and case suites
// move too, and `jet test Compiler -u` then rewrites their source excerpts.
//
// The corpus leaves out, by rule:
// - generated: a `//` line among a source's first five says a tool generates
//   it, it is an FFI adaptation's `after.jet` facade, or `jet build Compiler`
//   copies a Prelude text into it (a `target:` of PRELUDE_COPIES); its
//   generator writes it;
// - formatter input: Tests/Cases/Fmt*/, the machine-door corpus
//   Tests/Fixtures/MachineDoors/ (its guard runs `jet fmt --check` on a
//   source that is unformatted on purpose), and the fixtures and named
//   sources of any case that runs `jet fmt`, `jet fix`, a codemod or a
//   migration (MIGRATION_RUNNER), whose unformatted bytes are the test (the
//   rewritten file it pins echoes them);
// - Compiler/JetDevServer (#5931), which doesn't compile;
// - evidence: a source a recorded run under Tools/AgentEval/ pins by line;
//   its receipts stay as run, so their pins don't move; and the agent
//   workload corpus (Tests/AgentWorkloads/ and the copies its cases run),
//   whose recorded baselines and SHA256SUMS pin its bytes by digest;
// - parse lesson: a Tests/UI fixture whose snapshot shows an error the
//   parser reports (a Compiler/Prelude/Diagnostics.jet row whose `stage:`
//   names `.Parse`), such as a function with no body, or a checker error
//   `jet fmt` repairs (FMT_REPAIRED_ERRORS); `jet fmt` repairs some of those
//   on purpose, and the fixture's bytes are the lesson;
// - does not parse: a negative fixture `jet fmt` refuses, found while it runs.
//
// The formatter runs over the corpus in batches of BATCH sources, FMT_JOBS
// batches at once.
//
// One bad source never stalls a run: each formatter run has a time limit
// (FMT_LIMIT_BASE_MS, plus FMT_LIMIT_PER_SOURCE_MS per source), and a run
// that passes it, dies on a signal or fails without naming a refused source
// is split in halves until the source it hangs or crashes on runs alone.
// That source is set aside, the run goes on, and every such source is
// reported at the end with what happened; the run then exits 1.
//
// Usage (from anywhere in the checkout):
//   jet Tools/Agent/FmtCorpus.jet --list [PREFIX...]
//   jet Tools/Agent/FmtCorpus.jet --excluded [PREFIX...]
//   jet Tools/Agent/FmtCorpus.jet --check [--simplify] [PREFIX...]
//   jet Tools/Agent/FmtCorpus.jet --write [--simplify] [PREFIX...]
//   jet Tools/Agent/FmtCorpus.jet --frame-diff REV
// `--excluded` prints each left-out source after its rule, then the count of
// each rule. A PREFIX keeps only the sources under that repository path.
// `--simplify` runs `jet fmt --simplify`, the rewriter's canonical spelling.
// `--frame-diff` is the cutover's dry-run report: after `--write` is committed
// as REV and `jet test Compiler -u` re-blesses the snapshots, it prints each
// file other than a Jet source that changed since REV beyond its code frames
// (the `  4 | source` excerpt and caret lines a diagnostic shows), and each new
// file. Those are the rows whose outcome the format changed, not just their
// excerpts.
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

TOOL: "/Tools/Agent/FmtCorpus.jet"

USAGE: "usage: jet Tools/Agent/FmtCorpus.jet --list|--excluded|--check|--write [--simplify] [PREFIX...] | --frame-diff REV"

// A code-frame line: an optional line number, then the `|` gutter.
FRAME_LINE: Regex{"^\s*\d*\s*\|"}

ROOTS: [String]{"Compiler", "Core", "Examples", "Jetpack", "Tools", "Tests"}

RULE_GENERATED: "generated"

RULE_FORMATTER_INPUT: "formatter input"

RULE_DEVSERVER: "Compiler/JetDevServer (#5931)"

RULE_EVIDENCE: "evidence"

RULE_UNPARSED: "does not parse"

RULE_PARSE_LESSON: "parse lesson"

// The diagnostic rows, whose `stage:` says which ones the parser reports.
DIAGNOSTIC_ROWS: "Compiler/Prelude/Diagnostics.jet"

// The checker errors whose source `jet fmt` rewrites into the repaired
// program: an arm head that repeats the `if`'s comparison loses it, and an
// unbraced control body gains its braces.
FMT_REPAIRED_ERRORS: [String]{"RedundantArmComparison", "EffectBodyWithoutBraces"}

// The Prelude texts `jet build Compiler` copies into compiler sources: each
// `target:` names a source under Compiler/ that the build writes.
PRELUDE_COPIES: "Compiler/Toolchain/PreludeSources.jet"

PRELUDE_COPY_TARGET: Regex{"target: \"[^\"]+\""}

PRELUDE_COPY_OPEN: "target: \""

UI_TREE: "Tests/UI"

// A ui fixture's snapshot: `x.stderr` beside `x.jet`, or `stderr` in a
// fixture folder.
UI_SNAPSHOT_SUFFIX: ".stderr"

UI_FOLDER_SNAPSHOT: "stderr"

// Trees the corpus leaves out whole, with their rule.
EXCLUDED_TREES: [String]{"Tests/Cases/Fmt", "Tests/Fixtures/MachineDoors/", "Compiler/JetDevServer/", "Tests/AgentWorkloads/", "Tests/Cases/AgentWorkloads/"}

EXCLUDED_TREE_RULES: [String]{RULE_FORMATTER_INPUT, RULE_FORMATTER_INPUT, RULE_DEVSERVER, RULE_EVIDENCE, RULE_EVIDENCE}

ADAPTATION_FILE: "after.jet"

PIN_SUFFIXES: [String]{".case", ".out", ".stdout", ".stderr", ".err", ".warn", ".expected", ".fixture", ".log", ".txt", ".json", ".tsv", ".list"}

// The board's records are not expectations.
UNSCANNED: [String]{"Tools/Tower/"}

// Recorded runs, whose receipts are not rewritten.
EVIDENCE_TREE: "Tools/AgentEval/"

GENERATED_HEAD_LINES: 5

// Sources per formatter run.
BATCH: 400

// Formatter runs at once, at most one per processor; few enough that a case
// beside others in a suite leaves them room.
FMT_JOBS: 4

// A formatter run may take FMT_LIMIT_BASE_MS plus FMT_LIMIT_PER_SOURCE_MS for
// each source it formats; past that, it hangs. The limit is wall time, so it
// leaves room for a machine busy with other runs: a run that passes it is
// split and run again, which only adds to the load.
FMT_LIMIT_BASE_MS: 30000

FMT_LIMIT_PER_SOURCE_MS: 1000

// Where `jet fmt` respelled a few bytes, the non-blank bytes either side may
// skip (ALIGN_REACH) before ALIGN_WINDOW of them agree again.
ALIGN_REACH: 64

ALIGN_WINDOW: 8

ROOTED_SOURCE: Regex{"(?:Compiler|Core|Examples|Jetpack|Tools|tests)/[A-Za-z0-9_./-]*\.jet"}

// How far either side of a JSON key its object's braces are looked for.
OBJECT_REACH: 4096

// The JSON keys whose string value names the source of an object's place or span.
SOURCE_KEYS: [String]{"path", "file", "source"}

// git grep -E patterns (POSIX ERE) for the files worth reading: every pin form.
PIN_GREP: "\\.jet:[0-9]|<source>:[0-9]|\\.(line|column) = [0-9]|\"(line|start)\\\\?\" ?: ?[0-9]|span\\\\?\"? ?[:=] ?[{{0-9]|[0-9a-f]{{64}}"

// The migration runner a case runs to rewrite its sources to a new spelling.
MIGRATION_RUNNER: "Compiler/Migrations/Migrate.jet"

// A step that rewrites its sources (rewrites_sources).
FMT_STEP_GREP: "^step:.*(jet (fmt|fix|inspect codemod)|Compiler/Migrations/Migrate\\.jet)"

GENERATED_GREP: "^//.*(generated file|generated by|is generated)"

#Error
CorpusError: struct {
    message: String,
}

// The sources kept out of the corpus, each with its rule: exact paths and
// folders whose whole tree is out.
Exclusions: struct {
    exact: [String:String],
    trees: [String:String],
}

// A tracked file whose text may pin sources: the folders whose sources its
// names mean by their tail (a case's fixtures, an expectation's stem folder),
// the folders its names are joined to (the case's own, the expectation's
// nearest that holds sources), the sources a pin that names none means, and
// the lines of a case that change what a later name means.
PinSite: struct {
    path: String,
    run: [String],
    near: [String],
    own: [String],
    steps: [CaseStep],
}

// A case line that changes what a later pin's name means: a step and the
// sources it names (`to` empty), or a `copy:` or `write:` that puts a file at
// `to` in the run's folder, copied from `from` ("" for a `write:`); `at` is the
// line's byte offset in the case.
CaseStep: struct {
    at: Int,
    runs: [String],
    from: String,
    to: String,
}

// The tracked sources: each by path, and the ones beneath each folder above
// one (`beneath[folder_at[folder]]`).
Sources: struct {
    known: [String:Bool],
    folder_at: [String:Int],
    beneath: [[String]],
}

// The corpus sources of a run, the tracked Jet sources in the corpus roots it
// leaves out (each with its rule), every tracked source it saw, and the files
// that may pin them.
Corpus: struct {
    sources: [String],
    left_out: [String],
    rules: [String],
    tracked: Sources,
    sites: [PinSite],
}

// What the formatter said about a corpus: the sources it would change, the
// sources it could not parse, the sources it hung or crashed on, and why it
// refused each source whose meaning its format would change.
FmtOutcome: struct {
    dirty: [String],
    unparsed: [String],
    failed: [FmtFailure],
    changed: [FmtFailure],
}

// A source the formatter hung or crashed on, and what happened.
FmtFailure: struct {
    path: String,
    what: String,
}

// A source position: a line from 1 and a character column from 1, or 0 for a
// pin that names only the line.
Position: struct {
    line: Int,
    column: Int,
}

// A pin in a text: the name of the source it means as written ("" when it
// names none), whether its numbers are byte offsets (one, or a span's start
// and end) rather than a line and a column (0 when it names only the line),
// and the byte span each number is written at (empty for a column it leaves
// out).
PinSpot: struct {
    name: String,
    offsets: Bool,
    numbers: [Int],
    starts: [Int],
    ends: [Int],
}

// A number written in a text, and the byte span it is written at.
Written: struct {
    value: Int,
    start: Int,
    end: Int,
}

// The bytes of a text from `start` to `end` (exclusive).
ByteSpan: struct {
    start: Int,
    end: Int,
}

// A text's bytes from `start` to `end` written as `text`.
TextEdit: struct {
    start: Int,
    end: Int,
    text: String,
}

// What moving the pins did: files rewritten, pins moved, and why any pin
// that names a formatted source stayed as written.
PinReport: struct {
    files: Int,
    pins: Int,
    problems: [String],
}

no_exclusions: fn() -> Exclusions Never! {
    Exclusions{exact: [String:String]{}, trees: [String:String]{}}
}

// Records `rule` for `key` unless an earlier rule holds it.
note: fn(rules: &[String:String], key: String, rule: String) {
    if !rules.has_key(key) -> rules[key.copy()] = rule.copy()
}

// The stdout lines of a git command run at `root`, which must exit with one
// of `exits` (git grep exits 1 when nothing matches).
git_lines: fn(root: String, argv: [String], exits: [Int]) -[Exec, Time.Wait]> [String] CorpusError! {
    receipt: process.cmd(argv).cwd(root).stdout(.Capture).stderr(.Capture).run() ?? return Err(CorpusError{message: "cannot run {argv.join(" ")}: {err}"})
    if !exits.contains(receipt.code) {
        return Err(CorpusError{message: "{argv.join(" ")} failed ({receipt.code}): {receipt.errors}"})
    }
    lines := [String]{}
    loop line in receipt.output.lines() {
        if line != "" -> lines.push(line.copy())
    }
    Ok(lines)
}

// `git grep -l` of `pattern` over the corpus roots.
grep_roots: fn(root: String, flags: [String], pattern: String) -[Exec, Time.Wait]> [String] CorpusError! {
    argv := [String]{"git", "grep", "-l", "-I", "-E"}
    loop flag in flags -> argv.push(flag.copy())
    argv.push("-e")
    argv.push(pattern.copy())
    argv.push("--")
    loop corpus_root in ROOTS -> argv.push(corpus_root.copy())
    git_lines(root, argv, [Int]{0, 1})
}

base_name: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    if split.sep == "" -> return path.copy()
    split.tail.copy()
}

// The folder holding `path`; "" at the top.
parent: fn(path: String) -> String Never! {
    split: path.rpartition("/")
    split.head.copy()
}

// The folders above `path`, outermost first: `a/b/c.jet` has `a` and `a/b`.
ancestors: fn(path: String) -> [String] Never! {
    found := [String]{}
    dir := parent(path)
    loop dir != "" {
        found.insert(0, dir.copy())
        dir = parent(dir)
    }
    found
}

// `relative` beneath the folder `dir`, with `./` steps dropped.
join: fn(dir: String, relative: String) -> String Never! {
    parts := [String]{}
    loop part in relative.split("/") {
        if part != "" && part != "." -> parts.push(part.copy())
    }
    if dir == "" -> return parts.join("/")
    "{dir}/{parts.join("/")}"
}

// The rule of the excluded tree holding `path`, else "".
tree_rule: fn(path: String) -> String Never! {
    loop (at, tree) in EXCLUDED_TREES {
        if path.starts_with(tree) -> return EXCLUDED_TREE_RULES[at].copy()
    }
    if base_name(path) == ADAPTATION_FILE -> return RULE_GENERATED
    ""
}

// Whether `path` is a tracked file whose pins move with the sources.
is_pin_site: fn(path: String) -> Bool Never! {
    loop skipped in UNSCANNED {
        if path.starts_with(skipped) -> return false
    }
    loop suffix in PIN_SUFFIXES {
        if path.ends_with(suffix) -> return true
    }
    false
}

// Whether a `//` line among the first lines of `text` says a tool generates it.
is_generated_head: fn(text: String) -> Bool Never! {
    loop (at, line) in text.lines() {
        if at >= GENERATED_HEAD_LINES -> return false
        lower: line.lower()
        if lower.starts_with("//") && (lower.contains("generated file") || lower.contains("generated by") || lower.contains("is generated")) {
            return true
        }
    }
    false
}

// The fixture folders a case at `path` names (`fixture: fixtures/x`, relative
// to the case's folder, or `{root}/...`).
case_fixtures: fn(path: String, text: String) -> [String] Never! {
    found := [String]{}
    loop line in text.lines() {
        if !line.starts_with("fixture:") -> next
        value: line.remove_prefix("fixture:").trim()
        if value == "" -> next
        if value.starts_with("{{root}}/") {
            found.push(join("", value.remove_prefix("{{root}}/")))
            next
        }
        found.push(join(parent(path), value))
    }
    found
}

// Whether a case's text rewrites its sources in one of its steps: `jet fmt`,
// `jet fix`, `jet inspect codemod` or a migration (MIGRATION_RUNNER).
rewrites_sources: fn(text: String) -> Bool Never! {
    loop line in text.lines() {
        if !line.starts_with("step:") -> next
        if line.contains("jet fmt") || line.contains("jet fix") || line.contains("jet inspect codemod") || line.contains(MIGRATION_RUNNER) {
            return true
        }
    }
    false
}

// Keeps out the fixtures of a case at `path` that rewrites its sources, and
// every source it names by repository path but the migration runner, which
// the case runs and does not rewrite.
add_fmt_case_inputs: fn(path: String, text: String, out: &Exclusions) {
    if !rewrites_sources(text) {
        return
    }
    loop fixture in case_fixtures(path, text) -> note(out.trees, fixture, RULE_FORMATTER_INPUT)
    loop found in ROOTED_SOURCE.find_all(text) {
        if found != MIGRATION_RUNNER -> note(out.exact, found, RULE_FORMATTER_INPUT)
    }
}

// The diagnostic types `rows` (DIAGNOSTIC_ROWS) says the parser reports: each
// `Name: struct {` whose `stage:` names `.Parse`.
parse_diagnostic_types: fn(rows: String) -> [String] Never! {
    found := [String]{}
    name := ""
    loop line in rows.lines() {
        if !line.starts_with(" ") && line.ends_with(": struct {{") {
            name = line.removesuffix(": struct {{")
            next
        }
        if name != "" && line.trim().starts_with("stage: [") && line.contains(".Parse") {
            found.push(name.copy())
            name = ""
        }
    }
    found
}

// Keeps out the ui fixture whose snapshot at `path` shows a parse error: the
// `.jet` beside an `x.stderr`, or the whole folder of a folder's `stderr`.
note_parse_lesson: fn(path: String, out: &Exclusions) {
    if base_name(path) == UI_FOLDER_SNAPSHOT {
        note(out.trees, parent(path), RULE_PARSE_LESSON)
        return
    }
    if path.ends_with(UI_SNAPSHOT_SUFFIX) {
        note(out.exact, "{path.removesuffix(UI_SNAPSHOT_SUFFIX)}.jet", RULE_PARSE_LESSON)
    }
}

// Adds to `into` each tracked source beneath `folder` it doesn't hold yet.
add_beneath: fn(tracked: Sources, folder: String, into: &[String]) {
    slot: tracked.folder_at.get(folder) ?? -1
    if slot < 0 {
        return
    }
    loop source in tracked.beneath[slot] {
        if !into.contains(source) -> into.push(source.copy())
    }
}

// The words of `text` between spaces.
words: fn(text: String) -> [String] Never! {
    found := [String]{}
    loop word in text.split(" ") {
        trimmed: word.trim()
        if trimmed != "" -> found.push(trimmed.copy())
    }
    found
}

// The lines of a case's `text` that change what a later pin's name means: each
// step with the `.jet` paths it names, and each `copy: FROM TO` and
// `write: TO TEMPLATE`.
case_steps: fn(text: String) -> [CaseStep] Never! {
    steps := [CaseStep]{}
    at := 0
    loop line in text.split("\n") {
        start: at
        at += line.bytes().len() + 1
        rest: line.partition(":").tail
        if line.starts_with("step:") || line.starts_with("step ") {
            runs := [String]{}
            loop word in words(rest) {
                if word.ends_with(".jet") -> runs.push(clean_name(word))
            }
            steps.push(CaseStep{at: start, runs: runs, from: "", to: ""})
            next
        }
        parts: words(rest)
        if {
            line.starts_with("copy:") && parts.len() >= 2 -> {
                steps.push(CaseStep{at: start, runs: [String]{}, from: clean_name(parts[0]), to: clean_name(parts[1])})
            }
            line.starts_with("write:") && parts.len() >= 1 -> {
                steps.push(CaseStep{at: start, runs: [String]{}, from: "", to: clean_name(parts[0])})
            }
        }
    }
    steps
}

// The pins of a case at `path`: its names mean its fixtures' sources by their
// tail, then its folder's; a pin that names none means its fixture sources.
case_site: fn(path: String, text: String, tracked: Sources) -> PinSite Never! {
    run: case_fixtures(path, text)
    own := [String]{}
    loop folder in run -> add_beneath(tracked, folder, own)
    PinSite{path: path.copy(), run: run, near: [String]{parent(path)}, own: own, steps: case_steps(text)}
}

// The folder named for the stem of an expectation at `path`, else "".
stem_folder: fn(path: String, folders: [String:Int]) -> String Never! {
    folder: join(parent(path), base_name(path).partition(".").head)
    if folders.has_key(folder) -> return folder
    ""
}

// The nearest folder at or above the one of `path` that holds sources, else "".
nearest_folder: fn(path: String, folders: [String:Int]) -> String Never! {
    up := parent(path)
    loop up != "" && !folders.has_key(up) -> up = parent(up)
    up
}

// The pins of an expectation at `path`: its names mean the sources of the
// folder named for its stem by their tail, then its nearest folder's; a pin
// that names none means the source named for its stem beside it, else the
// stem folder's sources.
expectation_site: fn(path: String, tracked: Sources) -> PinSite Never! {
    stem: stem_folder(path, tracked.folder_at)
    run := [String]{}
    own := [String]{}
    beside: join(parent(path), "{base_name(path).partition(".").head}.jet")
    if {
        tracked.known.has_key(beside) -> own.push(beside)
        stem != "" -> add_beneath(tracked, stem, own)
    }
    if stem != "" -> run.push(stem)
    near := [String]{}
    nearest: nearest_folder(path, tracked.folder_at)
    if nearest != "" -> near.push(nearest)
    PinSite{path: path.copy(), run: run, near: near, own: own, steps: [CaseStep]{}}
}

// The rule that keeps `path` out, else "".
exclusion_rule: fn(path: String, exclusions: Exclusions) -> String Never! {
    tree: tree_rule(path)
    if tree != "" -> return tree
    if exclusions.exact.get(path) == .Val(rule) -> return rule.copy()
    loop dir in ancestors(path) {
        if exclusions.trees.get(dir) == .Val(rule) -> return rule.copy()
    }
    ""
}

// Whether `path` lies under one of `prefixes`; no prefix keeps every path.
selected: fn(path: String, prefixes: [String]) -> Bool Never! {
    if prefixes.len() == 0 -> return true
    loop prefix in prefixes {
        trimmed: prefix.removesuffix("/")
        if path == trimmed || path.starts_with("{trimmed}/") -> return true
    }
    false
}

read_tracked: fn(root: String, path: String) -[FS.Read]> String CorpusError! {
    files.read("{root}/{path}") ?? return Err(CorpusError{message: "cannot read {path}: {err}"})
}

// Everything kept out of the corpus by reading the tracked tree at `root`.
exclusions: fn(root: String) -[Exec, FS.Read, Time.Wait]> Exclusions CorpusError! {
    out := no_exclusions()
    loop path in grep_roots(root, [String]{"-i"}, GENERATED_GREP) ?? return Err(err) {
        if path.ends_with(".jet") && is_generated_head(read_tracked(root, path) ?? return Err(err)) {
            note(out.exact, path, RULE_GENERATED)
        }
    }
    loop found in PRELUDE_COPY_TARGET.find_all(read_tracked(root, PRELUDE_COPIES) ?? return Err(err)) {
        target: found.removeprefix(PRELUDE_COPY_OPEN).removesuffix("\"")
        note(out.exact, "Compiler/{target}", RULE_GENERATED)
    }
    loop path in grep_roots(root, [String]{}, FMT_STEP_GREP) ?? return Err(err) {
        if path.ends_with(".case") {
            add_fmt_case_inputs(path, read_tracked(root, path) ?? return Err(err), out)
        }
    }
    types := parse_diagnostic_types(read_tracked(root, DIAGNOSTIC_ROWS) ?? return Err(err))
    loop name in FMT_REPAIRED_ERRORS -> types.push(name.copy())
    if types.len() > 0 {
        lesson_grep: "^Error: Jet\\.({types.join("|")}): "
        argv: [String]{"git", "grep", "-l", "-I", "-E", "-e", lesson_grep, "--", UI_TREE}
        loop path in git_lines(root, argv, [Int]{0, 1}) ?? return Err(err) {
            note_parse_lesson(path, out)
        }
    }
    Ok(out)
}

// Every tracked file at `root` that may pin sources, outside the evidence.
// The sources an evidence file pins by name are kept out in `out`.
pin_sites: fn(root: String, tracked: Sources, out: &Exclusions) -[Exec, FS.Read, Time.Wait]> [PinSite] CorpusError! {
    sites := [PinSite]{}
    loop path in grep_roots(root, [String]{}, PIN_GREP) ?? return Err(err) {
        if !is_pin_site(path) -> next
        text: if path.ends_with(".case") || path.starts_with(EVIDENCE_TREE) -> read_tracked(root, path) ?? return Err(err) else -> ""
        site: if path.ends_with(".case") -> case_site(path, text, tracked) else -> expectation_site(path, tracked)
        if path.starts_with(EVIDENCE_TREE) {
            loop spot in pin_spots(text) {
                if spot.name == "" -> next
                loop target in pin_targets(site, spot, tracked) {
                    note(out.exact, target, RULE_EVIDENCE)
                }
            }
            next
        }
        sites.push(site)
    }
    Ok(sites)
}

// Records the tracked source `path` in `tracked`.
add_source: fn(tracked: &Sources, path: String) {
    tracked.known[path.copy()] = true
    loop dir in ancestors(path) {
        slot := tracked.folder_at.get(dir) ?? -1
        if slot < 0 {
            slot = tracked.beneath.len()
            tracked.folder_at[dir.copy()] = slot
            tracked.beneath.push([String]{})
        }
        tracked.beneath[slot].push(path.copy())
    }
}

// The corpus sources under `prefixes`.
corpus: fn(root: String, prefixes: [String]) -[Exec, FS.Read, Time.Wait]> Corpus CorpusError! {
    argv := [String]{"git", "ls-files", "--"}
    loop corpus_root in ROOTS -> argv.push(corpus_root.copy())
    paths := [String]{}
    tracked := Sources{known: [String:Bool]{}, folder_at: [String:Int]{}, beneath: [[String]]{}}
    loop path in git_lines(root, argv, [Int]{0}) ?? return Err(err) {
        if !path.ends_with(".jet") || !selected(path, prefixes) -> next
        paths.push(path.copy())
        add_source(tracked, path)
    }
    out := exclusions(root) ?? return Err(err)
    sites: pin_sites(root, tracked, out) ?? return Err(err)
    found := Corpus{sources: [String]{}, left_out: [String]{}, rules: [String]{}, tracked: tracked, sites: sites}
    loop path in paths {
        rule: exclusion_rule(path, out)
        if {
            rule == "" -> found.sources.push(path.copy())
            else -> {
                found.left_out.push(path.copy())
                found.rules.push(rule)
            }
        }
    }
    Ok(found)
}

is_digit: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

// A byte a pinned name can hold: a letter, digit, `_`, `.`, `/` or `-`.
is_name_byte: fn(code: Int) -> Bool Never! {
    (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || is_digit(code) || code == 95 || code == 46 || code == 47 || code == 45
}

// Blank space: space, tab, newline or carriage return.
is_blank: fn(code: Int) -> Bool Never! { code == 32 || code == 9 || code == 10 || code == 13 }

// Where the run of digits in `bytes` from `start` ends.
digits_end: fn(bytes: [U8], start: Int) -> Int Never! {
    end := start
    loop end < bytes.len() && is_digit(Int{bytes[end]}) -> end += 1
    end
}

// The number the digits of `bytes` from `start` to `end` spell.
number_at: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    value := 0
    loop at in start..<end -> value = value * 10 + (Int{bytes[at]}) - 48
    value
}

// Whether `bytes` holds `marker` at `at`.
holds_at: fn(bytes: [U8], at: Int, marker: [U8]) -> Bool Never! {
    if at + marker.len() > bytes.len() -> return false
    loop (index, byte) in marker {
        if bytes[at + index] != byte -> return false
    }
    true
}

// The byte at `at` of `bytes`, or -1 outside them.
byte_at: fn(bytes: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= bytes.len() -> return -1
    Int{bytes[at]}
}

// The number written in `bytes` from `start`, a digit.
written: fn(bytes: [U8], start: Int) -> Written Never! {
    end: digits_end(bytes, start)
    Written{value: number_at(bytes, start, end), start: start, end: end}
}

// The text of `bytes` from `start` to `end`.
text_between: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    loop at in start..<end -> out.push(bytes[at])
    String.from_bytes(out) ?? ""
}

// Whether `bytes` holds `marker` at `at`, then a digit.
number_follows: fn(bytes: [U8], at: Int, marker: [U8]) -> Bool Never! {
    holds_at(bytes, at, marker) && is_digit(byte_at(bytes, at + marker.len()))
}

// Whether `bytes` holds `:` and a digit at `at`.
colon_follows: fn(bytes: [U8], at: Int) -> Bool Never! {
    byte_at(bytes, at) == 58 && is_digit(byte_at(bytes, at + 1))
}

// Whether `bytes` holds `..` and a digit at `at`.
range_follows: fn(bytes: [U8], at: Int) -> Bool Never! {
    byte_at(bytes, at) == 46 && byte_at(bytes, at + 1) == 46 && is_digit(byte_at(bytes, at + 2))
}

// A pin of a line and an optional column.
place_spot: fn(name: String, line: Written, column: Written?) -> PinSpot Never! {
    if column == .Val(found) {
        return PinSpot{name: name.copy(), offsets: false, numbers: [Int]{line.value, found.value}, starts: [Int]{line.start, found.start}, ends: [Int]{line.end, found.end}}
    }
    PinSpot{name: name.copy(), offsets: false, numbers: [Int]{line.value, 0}, starts: [Int]{line.start, line.end}, ends: [Int]{line.end, line.end}}
}

// A pin of a byte offset, or of a span's start and end.
offset_spot: fn(name: String, start: Written, end: Written?) -> PinSpot Never! {
    if end == .Val(found) {
        return PinSpot{name: name.copy(), offsets: true, numbers: [Int]{start.value, found.value}, starts: [Int]{start.start, found.start}, ends: [Int]{start.end, found.end}}
    }
    PinSpot{name: name.copy(), offsets: true, numbers: [Int]{start.value}, starts: [Int]{start.start}, ends: [Int]{start.end}}
}

// Every pin in `text`, named or not.
pin_spots: fn(text: String) -> [PinSpot] Never! {
    bytes: text.bytes()
    spots := [PinSpot]{}
    named_spots(bytes, spots)
    span_spots(bytes, spots)
    source_spots(bytes, spots)
    json_spots(bytes, spots)
    json_path_spots(bytes, spots)
    spots
}

// Each `<name>.jet:<line>[:<column>]` and `<name>.jet:<start>..<end>` in `bytes`.
named_spots: fn(bytes: [U8], spots: &[PinSpot]) {
    marker: ".jet:".bytes()
    at := 0
    loop at < bytes.len() {
        if !number_follows(bytes, at, marker) {
            at += 1
            next
        }
        start := at
        loop start > 0 && is_name_byte(Int{bytes[start - 1]}) -> start -= 1
        named: start < at
        name: text_between(bytes, start, at + 4)
        first: written(bytes, at + marker.len())
        if range_follows(bytes, first.end) {
            last: written(bytes, first.end + 2)
            if named -> spots.push(offset_spot(name, first, Val(last)))
            at = last.end
            next
        }
        column: if colon_follows(bytes, first.end) -> Val(written(bytes, first.end + 1)) else -> None
        at = if column == .Val(found) -> found.end else -> first.end
        if named && first.value > 0 -> spots.push(place_spot(name, first, column))
    }
}

// Whether `bytes` from `start` to `end` hold a line break.
breaks_line: fn(bytes: [U8], start: Int, end: Int) -> Bool Never! {
    loop at in start..<end {
        if byte_at(bytes, at) == 10 -> return true
    }
    false
}

// Each `span=<start>..<end>`, of the source the last named place before it
// on its line names.
span_spots: fn(bytes: [U8], spots: &[PinSpot]) {
    marker: "span=".bytes()
    named: spots.len()
    loop at in 0..<bytes.len() {
        if !number_follows(bytes, at, marker) -> next
        first: written(bytes, at + marker.len())
        if !range_follows(bytes, first.end) -> next
        last: written(bytes, first.end + 2)
        name := ""
        loop index in 0..<named {
            spot: spots[index]
            if !spot.offsets && spot.starts[0] < at && !breaks_line(bytes, spot.starts[0], at) {
                name = spot.name.copy()
            }
        }
        spots.push(offset_spot(name, first, Val(last)))
    }
}

// Each `<source>:<line>[:<column>]`, which names no source.
source_spots: fn(bytes: [U8], spots: &[PinSpot]) {
    marker: "<source>:".bytes()
    loop at in 0..<bytes.len() {
        if !number_follows(bytes, at, marker) -> next
        line: written(bytes, at + marker.len())
        column: if colon_follows(bytes, line.end) -> Val(written(bytes, line.end + 1)) else -> None
        if line.value > 0 -> spots.push(place_spot("", line, column))
    }
}

// Where the value of the quoted key `key` at `at` of `bytes` starts (`"key": `,
// its quotes escaped or not), else -1.
key_end: fn(bytes: [U8], at: Int, key: [U8]) -> Int Never! {
    if byte_at(bytes, at) != 34 || !holds_at(bytes, at + 1, key) -> return -1
    i := at + 1 + key.len()
    if byte_at(bytes, i) == 92 -> i += 1
    if byte_at(bytes, i) != 34 -> return -1
    i += 1
    loop byte_at(bytes, i) == 32 -> i += 1
    if byte_at(bytes, i) != 58 -> return -1
    i += 1
    loop byte_at(bytes, i) == 32 -> i += 1
    i
}

// The number the quoted key `key` at `at` of `bytes` holds, else None.
keyed_number: fn(bytes: [U8], at: Int, key: [U8]) -> Written? Never! {
    value: key_end(bytes, at, key)
    if value < 0 || !is_digit(byte_at(bytes, value)) -> return None
    Val(written(bytes, value))
}

// The JSON object around byte `at` of `bytes`, from its `{` to past its `}`,
// each within OBJECT_REACH bytes; None outside one.
object_around: fn(bytes: [U8], at: Int) -> ByteSpan? Never! {
    depth := 0
    open := -1
    i := at - 1
    loop i >= 0 && at - i <= OBJECT_REACH {
        code: byte_at(bytes, i)
        if {
            code == 125 || code == 93 -> depth += 1
            code == 123 || code == 91 -> {
                if depth == 0 {
                    if code == 123 -> open = i
                    break
                }
                depth -= 1
            }
        }
        i -= 1
    }
    if open < 0 -> return None
    i = at
    loop i < bytes.len() && i - at <= OBJECT_REACH {
        code: byte_at(bytes, i)
        if {
            code == 123 || code == 91 -> depth += 1
            code == 125 || code == 93 -> {
                if depth == 0 {
                    if code == 125 -> return Val(ByteSpan{start: open, end: i + 1})
                    return None
                }
                depth -= 1
            }
        }
        i += 1
    }
    None
}

// Where the value of the member `key` of `object` starts (not a nested
// object's member), else -1.
member_value: fn(bytes: [U8], object: ByteSpan, key: [U8]) -> Int Never! {
    depth := 0
    first: object.start + 1
    last: object.end - 1
    loop at in first..<last {
        code: byte_at(bytes, at)
        if {
            code == 123 || code == 91 -> depth += 1
            code == 125 || code == 93 -> depth -= 1
            depth == 0 && code == 34 -> {
                value: key_end(bytes, at, key)
                if value >= 0 -> return value
            }
        }
    }
    -1
}

// The number the member `key` of `object` holds, else None.
member_number: fn(bytes: [U8], object: ByteSpan, key: [U8]) -> Written? Never! {
    value: member_value(bytes, object, key)
    if value < 0 || !is_digit(byte_at(bytes, value)) -> return None
    Val(written(bytes, value))
}

// The source a member of `object` names (SOURCE_KEYS), else "".
member_name: fn(bytes: [U8], object: ByteSpan) -> String Never! {
    loop key in SOURCE_KEYS {
        value := member_value(bytes, object, key.bytes())
        if value < 0 -> next
        if byte_at(bytes, value) == 92 -> value += 1
        if byte_at(bytes, value) != 34 -> next
        end := value + 1
        loop is_name_byte(byte_at(bytes, end)) -> end += 1
        name: text_between(bytes, value + 1, end)
        if name.ends_with(".jet") -> return name
    }
    ""
}

// The source `object`, or the object around it, names; else "".
object_name: fn(bytes: [U8], object: ByteSpan) -> String Never! {
    name: member_name(bytes, object)
    if name != "" -> return name
    if object_around(bytes, object.start) == .Val(outer) -> return member_name(bytes, outer)
    ""
}

// Whether the object that opens at `open` is the value of a `span` key
// (`"span": {`, its quotes escaped or not, or a JSON path's `.span = {`).
follows_span_key: fn(bytes: [U8], open: Int) -> Bool Never! {
    i := open - 1
    loop is_blank(byte_at(bytes, i)) -> i -= 1
    if byte_at(bytes, i) != 58 && byte_at(bytes, i) != 61 -> return false
    i -= 1
    loop is_blank(byte_at(bytes, i)) -> i -= 1
    if byte_at(bytes, i) == 34 -> i -= 1
    if byte_at(bytes, i) == 92 -> i -= 1
    i >= 3 && holds_at(bytes, i - 3, "span".bytes())
}

// The places and spans of JSON objects in `bytes`: the `line` (and `column`)
// of an object that it or the object around it names the source of, unless it
// counts a `character`; and the `start` (and `end`) of a `span` object or of
// an object that names its source.
json_spots: fn(bytes: [U8], spots: &[PinSpot]) {
    line_key: "line".bytes()
    column_key: "column".bytes()
    character_key: "character".bytes()
    start_key: "start".bytes()
    end_key: "end".bytes()
    loop at in 0..<bytes.len() {
        if byte_at(bytes, at) != 34 -> next
        if keyed_number(bytes, at, line_key) == .Val(line) {
            if object_around(bytes, at) == .Val(object) {
                name: object_name(bytes, object)
                if name != "" && member_value(bytes, object, character_key) < 0 {
                    spots.push(place_spot(name, line, member_number(bytes, object, column_key)))
                }
            }
            next
        }
        if keyed_number(bytes, at, start_key) == .Val(start) {
            if object_around(bytes, at) == .Val(object) {
                sourced: member_name(bytes, object)
                if sourced != "" || follows_span_key(bytes, object.start) {
                    name: if sourced != "" -> sourced else -> object_name(bytes, object)
                    spots.push(offset_spot(name, start, member_number(bytes, object, end_key)))
                }
            }
        }
    }
}

// The JSON path that ends at `at` of `bytes`: from the last `$` before it on
// its line; "" when there is none.
json_path_before: fn(bytes: [U8], at: Int) -> String Never! {
    start := at
    loop start > 0 && byte_at(bytes, start - 1) != 10 && byte_at(bytes, start - 1) != 36 {
        start -= 1
    }
    if byte_at(bytes, start - 1) != 36 -> return ""
    text_between(bytes, start - 1, at)
}

// Each JSON path's `.line = <n>`, which names no source, with the
// `.column = <n>` of the same path.
json_path_spots: fn(bytes: [U8], spots: &[PinSpot]) {
    marker: ".line = ".bytes()
    loop at in 0..<bytes.len() {
        if !number_follows(bytes, at, marker) -> next
        line: written(bytes, at + marker.len())
        if line.value == 0 -> next
        path: json_path_before(bytes, at)
        column := Written?{None}
        if path != "" {
            column_marker: "{path}.column = ".bytes()
            loop from in 0..<bytes.len() {
                if number_follows(bytes, from, column_marker) {
                    column = Val(written(bytes, from + column_marker.len()))
                    break
                }
            }
        }
        spots.push(place_spot("", line, column))
    }
}

// `name` from its last part that is empty, `.`, `..` or a `{placeholder}` on:
// the path it names inside the run's folder, or from the checkout root.
clean_name: fn(name: String) -> String Never! {
    kept := [String]{}
    loop part in name.split("/") {
        if part == "" || part == "." || part == ".." || part.contains("{{") || part.contains("}}") {
            kept = [String]{}
            next
        }
        kept.push(part.copy())
    }
    kept.join("/")
}

// The trailing parts of `name` cut at a `/`, longest first.
name_tails: fn(name: String) -> [String] Never! {
    parts: name.split("/").to_list()
    tails := [String]{}
    tail := ""
    loop index in 0..<parts.len() {
        part: parts[parts.len() - 1 - index]
        tail = if tail == "" -> part.copy() else -> "{part}/{tail}"
        tails.insert(0, tail.copy())
    }
    tails
}

// Whether a path in a run's folder and a name mean the same file: either ends
// with the other, cut at a `/`.
tail_matches: fn(path: String, name: String) -> Bool Never! {
    path == name || path.ends_with("/{name}") || name.ends_with("/{path}")
}

// `source` inside the run folder of `site` that holds it.
run_relative: fn(site: PinSite, source: String) -> String Never! {
    loop folder in site.run {
        prefix: "{folder}/"
        if source.starts_with(prefix) -> return source.removeprefix(prefix)
    }
    source.copy()
}

// The sources in the run folders of `site` whose path there ends with `name`
// (or that `name` ends with).
run_sources: fn(site: PinSite, name: String, tracked: Sources) -> [String] Never! {
    found := [String]{}
    loop folder in site.run {
        slot: tracked.folder_at.get(folder) ?? -1
        if slot < 0 -> next
        prefix: "{folder}/"
        loop source in tracked.beneath[slot] {
            if tail_matches(source.removeprefix(prefix), name) && !found.contains(source) {
                found.push(source.copy())
            }
        }
    }
    found
}

// Those of `found` the last step of `site` before byte `at` runs (by their
// path in the run's folder, or its tail); empty when it runs none of them.
narrowed: fn(site: PinSite, at: Int, found: [String]) -> [String] Never! {
    kept := [String]{}
    loop index in 0..<site.steps.len() {
        step: site.steps[site.steps.len() - 1 - index]
        if step.at >= at || step.to != "" -> next
        loop source in found {
            relative: run_relative(site, source)
            loop ran in step.runs {
                if relative == ran || relative.ends_with("/{ran}") {
                    kept.push(source.copy())
                    break
                }
            }
        }
        return kept
    }
    kept
}

// The last `copy:` or `write:` of `site` before byte `at` that puts a file at
// `relative` in the run's folder, else -1.
copy_before: fn(site: PinSite, at: Int, relative: String) -> Int Never! {
    found := -1
    loop (index, step) in site.steps {
        if step.at < at && step.to != "" && step.to == relative -> found = index
    }
    found
}

// The last `copy:` or `write:` of `site` before byte `at` that puts a file at
// a path that ends with `name` or that `name` ends with, else -1.
copy_by_tail: fn(site: PinSite, at: Int, name: String) -> Int Never! {
    found := -1
    loop (index, step) in site.steps {
        if step.at < at && step.to != "" && tail_matches(step.to, name) -> found = index
    }
    found
}

// The sources `found` mean at byte `at` of `site`: a source a `copy:` before
// it replaced means the sources it copied (`copied`).
through_copies: fn(site: PinSite, at: Int, found: [String], tracked: Sources) -> [String] Never! {
    out := [String]{}
    loop source in found {
        replacing: copy_before(site, at, run_relative(site, source))
        if replacing < 0 {
            if !out.contains(source) -> out.push(source.copy())
            next
        }
        loop from in copied(site, replacing, tracked) {
            if !out.contains(from) -> out.push(from)
        }
    }
    out
}

// The tracked sources the `copy:` numbered `step` among the lines of `site`
// copied from; none for a `write:` or a copy of a file other than a source.
copied: fn(site: PinSite, step: Int, tracked: Sources) -> [String] Never! {
    from: site.steps[step].from
    if !from.ends_with(".jet") -> return [String]{}
    run_sources(site, from, tracked)
}

// The tracked sources a pin of `site` can mean (see the head of this file).
pin_targets: fn(site: PinSite, spot: PinSpot, tracked: Sources) -> [String] Never! {
    at: spot.starts[0]
    name: clean_name(spot.name)
    found := [String]{}
    if {
        spot.name == "" -> {
            loop source in site.own -> found.push(source.copy())
        }
        name == "" -> return found
        else -> {
            exact: copy_before(site, at, name)
            if exact >= 0 -> return copied(site, exact, tracked)
            found = run_sources(site, name, tracked)
        }
    }
    if found.len() > 0 {
        kept: narrowed(site, at, found)
        chosen: if kept.len() > 0 -> kept else -> found
        return through_copies(site, at, chosen, tracked)
    }
    if spot.name == "" -> return found
    replacing: copy_by_tail(site, at, name)
    if replacing >= 0 -> return copied(site, replacing, tracked)
    tails: name_tails(name)
    loop folder in site.near {
        loop tail in tails {
            candidate: join(folder, tail)
            if tracked.known.has_key(candidate) -> return [String]{candidate}
        }
    }
    loop tail in tails {
        if tracked.known.has_key(tail) -> return [String]{tail.copy()}
    }
    [String]{}
}

// The non-blank bytes of `bytes`, in order.
ink: fn(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop byte in bytes {
        if !is_blank(Int{byte}) -> out.push(byte)
    }
    out
}

// Whether `old` from `i` and `new` from `j` agree for ALIGN_WINDOW bytes, or
// to both their ends.
agrees: fn(old: [U8], i: Int, new: [U8], j: Int) -> Bool Never! {
    old_left: old.len() - i
    new_left: new.len() - j
    if (old_left < ALIGN_WINDOW || new_left < ALIGN_WINDOW) && old_left != new_left -> return false
    limit: if old_left < ALIGN_WINDOW -> old_left else -> ALIGN_WINDOW
    loop at in 0..<limit {
        if old[i + at] != new[j + at] -> return false
    }
    true
}

// For each non-blank byte of `before`, and one past its last, the index of
// the non-blank byte of `after` it lines up with. `jet fmt` keeps the tokens
// and changes blank space, besides a few canonical spellings (`Unit` to `()`,
// a trailing comma): where the two streams differ, the bytes either side skips
// are found by the nearest point, within ALIGN_REACH bytes on each side, where
// they agree again; a byte `before` drops lines up with the next byte they
// share. The two ends agree only after at most ALIGN_WINDOW skipped bytes on
// each side. None when no such point is near.
ink_map: fn(before: [U8], after: [U8]) -> [Int]? Never! {
    old: ink(before)
    new: ink(after)
    map := [Int]{}
    i := 0
    j := 0
    loop i < old.len() {
        if j < new.len() && old[i] == new[j] {
            map.push(j)
            i += 1
            j += 1
            next
        }
        skip_old := -1
        skip_new := -1
        loop reach in 1..<2 * ALIGN_REACH + 1 {
            loop dropped in 0..<reach + 1 {
                added: reach - dropped
                if dropped > ALIGN_REACH || added > ALIGN_REACH || i + dropped > old.len() || j + added > new.len() {
                    next
                }
                at_end: i + dropped == old.len() && j + added == new.len()
                if at_end && (dropped > ALIGN_WINDOW || added > ALIGN_WINDOW) -> next
                if agrees(old, i + dropped, new, j + added) {
                    skip_old = dropped
                    skip_new = added
                    break
                }
            }
            if skip_old >= 0 -> break
        }
        if skip_old < 0 -> return None
        loop _ in 0..<skip_old -> map.push(j + skip_new)
        i += skip_old
        j += skip_new
    }
    map.push(new.len())
    Val(map)
}

// How many non-blank bytes of `bytes` come before position `at` (column 0 is
// the line's start).
ink_before: fn(bytes: [U8], at: Position) -> Int Never! {
    line := 1
    column := 1
    count := 0
    loop byte in bytes {
        code: Int{byte}
        lead: code < 128 || code >= 192
        if lead && (line > at.line || (line == at.line && column >= at.column)) -> return count
        if code == 10 {
            line += 1
            column = 1
            next
        }
        if !is_blank(code) -> count += 1
        if lead -> column += 1
    }
    count
}

// The position of the non-blank byte numbered `index` (from 0) in `bytes`.
ink_position: fn(bytes: [U8], index: Int) -> Position? Never! {
    line := 1
    column := 1
    count := 0
    loop byte in bytes {
        code: Int{byte}
        if code == 10 {
            line += 1
            column = 1
            next
        }
        if !is_blank(code) {
            if count == index -> return Val(Position{line: line, column: column})
            count += 1
        }
        if code < 128 || code >= 192 -> column += 1
    }
    None
}

// Where `at` in `before` sits in `after`, given the `ink_map` of the two: the
// position of the byte the non-blank byte at or after `at` lines up with. A
// line-only pin stays line-only.
remap: fn(before: [U8], after: [U8], map: [Int], at: Position) -> Position? Never! {
    index: ink_before(before, at)
    if index >= map.len() -> return None
    moved: ink_position(after, map[index]) ?? return None
    if at.column == 0 -> return Val(Position{line: moved.line, column: 0})
    Val(moved)
}

// How many non-blank bytes of `bytes` come before byte `offset`.
ink_before_offset: fn(bytes: [U8], offset: Int) -> Int Never! {
    count := 0
    loop at in 0..<offset {
        if !is_blank(Int{bytes[at]}) -> count += 1
    }
    count
}

// Where byte `offset` of `before` sits in `after`, given the `ink_map` of the
// two: it moves with the non-blank byte at or after it.
remap_start: fn(before: [U8], after: [U8], map: [Int], offset: Int) -> Int? Never! {
    if offset > before.len() -> return None
    count: ink_before_offset(before, offset)
    if count >= map.len() -> return None
    ink_offset(after, map[count])
}

// Where the end `offset` (one past the last byte) of a span of `before` sits
// in `after`, given the `ink_map` of the two: one past where its last
// non-blank byte went.
remap_end: fn(before: [U8], after: [U8], map: [Int], offset: Int) -> Int? Never! {
    if offset > before.len() -> return None
    count: ink_before_offset(before, offset)
    if count == 0 -> return Val(0)
    Val((ink_offset(after, map[count - 1]) ?? return None) + 1)
}

// The byte offset of the non-blank byte numbered `index` (from 0) in `bytes`,
// or their length for the one past the last.
ink_offset: fn(bytes: [U8], index: Int) -> Int? Never! {
    count := 0
    loop (at, byte) in bytes {
        if is_blank(Int{byte}) -> next
        if count == index -> return Val(at)
        count += 1
    }
    if count == index -> return Val(bytes.len())
    None
}

// The numbers of `spot` moved from `before` to `after`, given the `ink_map`
// of the two. A pin past the last token names no token, and stays.
moved_numbers: fn(spot: PinSpot, before: [U8], after: [U8], map: [Int]) -> [Int] Never! {
    if !spot.offsets {
        place: remap(before, after, map, Position{line: spot.numbers[0], column: spot.numbers[1]}) ?? return spot.numbers.copy()
        return [Int]{place.line, place.column}
    }
    moved := [Int]{}
    loop (index, offset) in spot.numbers {
        at: if index == 1 -> remap_end(before, after, map, offset) else -> remap_start(before, after, map, offset)
        moved.push(at ?? return spot.numbers.copy())
    }
    moved
}

// Whether two lists of numbers are the same.
same_numbers: fn(left: [Int], right: [Int]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (index, number) in left {
        if number != right[index] -> return false
    }
    true
}

// How a report names `spot`.
pin_label: fn(spot: PinSpot) -> String Never! {
    name: if spot.name == "" -> "<unnamed>" else -> spot.name.copy()
    if spot.offsets && spot.numbers.len() == 2 {
        return "{name}:{spot.numbers[0]}..{spot.numbers[1]}"
    }
    if spot.offsets -> return "{name} byte {spot.numbers[0]}"
    if spot.numbers[1] > 0 -> return "{name}:{spot.numbers[0]}:{spot.numbers[1]}"
    "{name}:{spot.numbers[0]}"
}

// A letter or a digit.
is_word_byte: fn(code: Int) -> Bool Never! {
    is_digit(code) || (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
}

// Each lowercase hex SHA-256 digest in `bytes`: a run of 64 hex digits no
// other letter or digit touches.
digest_spans: fn(bytes: [U8]) -> [ByteSpan] Never! {
    found := [ByteSpan]{}
    at := 0
    loop at < bytes.len() {
        if !is_word_byte(byte_at(bytes, at)) {
            at += 1
            next
        }
        end := at
        hex := true
        loop is_word_byte(byte_at(bytes, end)) {
            code: byte_at(bytes, end)
            if !is_digit(code) && (code < 97 || code > 102) -> hex = false
            end += 1
        }
        if hex && end - at == 64 -> found.push(ByteSpan{start: at, end: end})
        at = end
    }
    found
}

// `text` with each of `edits` (which don't overlap) written in.
apply_edits: fn(text: String, edits: [TextEdit]) -> String Never! {
    bytes: text.bytes()
    by_start := [Int:Int]{}
    loop (index, edit) in edits -> by_start[edit.start] = index
    out := [U8]{}
    at := 0
    loop at < bytes.len() {
        if by_start.get(at) == .Val(index) {
            loop byte in edits[index].text.bytes() -> out.push(byte)
            at = edits[index].end
            next
        }
        out.push(bytes[at])
        at += 1
    }
    String.from_bytes(out) ?? text.copy()
}

// The sources among `dirty` that a pin of `sites` can mean (and, for a site
// that holds a digest, the sources its unnamed pins mean), each with its text
// before formatting.
pinned_sources: fn(root: String, found: Corpus, dirty: [String]) -[FS.Read]> [String:String] CorpusError! {
    formatting := [String:Bool]{}
    loop path in dirty -> formatting[path.copy()] = true
    before := [String:String]{}
    loop site in found.sites {
        text: read_tracked(root, site.path) ?? return Err(err)
        pinned := [String]{}
        loop spot in pin_spots(text) {
            loop target in pin_targets(site, spot, found.tracked) -> pinned.push(target)
        }
        if digest_spans(text.bytes()).len() > 0 {
            loop source in site.own -> pinned.push(source.copy())
        }
        loop target in pinned {
            if formatting.has_key(target) && !before.has_key(target) {
                before[target.copy()] = read_tracked(root, target) ?? return Err(err)
            }
        }
    }
    Ok(before)
}

// Reads the formatted text of `target`, a source of `before`, into `after`,
// and the `ink_map` from its old text into `maps`, once; whether `jet fmt`
// changed it only in blank space and canonical spellings, so its pins move.
formatted_map: fn(root: String, target: String, before: [String:String], after: &[String:String], maps: &[String:[Int]]) -[FS.Read]> Bool CorpusError! {
    if !after.has_key(target) {
        new_text: read_tracked(root, target) ?? return Err(err)
        maps[target.copy()] = ink_map((before.get(target) ?? "").bytes(), new_text.bytes()) ?? [Int]{}
        after[target.copy()] = new_text
    }
    Ok((maps.get(target) ?? [Int]{}).len() > 0)
}

// Adds to `edits` the new digest of each formatted source a digest of a
// site's `bytes` is the old digest of, among the sources its unnamed pins
// mean; in a case, a digest that is no such source's stays and goes to
// `problems`. How many digests move.
move_digests: fn(root: String, site: PinSite, bytes: [U8], before: [String:String], after: &[String:String], maps: &[String:[Int]], edits: &[TextEdit], problems: &[String]) -[FS.Read]> Int CorpusError! {
    spans: digest_spans(bytes)
    if spans.len() == 0 -> return Ok(0)
    digests := [String:String]{}
    formatted := [String]{}
    loop source in site.own {
        if !before.has_key(source) -> next
        _: formatted_map(root, source, before, after, maps) ?? return Err(err)
        old: crypto.sha256(before.get(source) ?? "").hex()
        digests[old] = crypto.sha256(after.get(source) ?? "").hex()
        formatted.push(source.copy())
    }
    if formatted.len() == 0 -> return Ok(0)
    moved := 0
    loop span in spans {
        digest: text_between(bytes, span.start, span.end)
        if digests.get(digest) == .Val(new) {
            if new != digest {
                edits.push(TextEdit{start: span.start, end: span.end, text: new.copy()})
                moved += 1
            }
            next
        }
        if site.path.ends_with(".case") {
            problems.push("{site.path}: digest `{digest}` stays: it is no source's digest, while {formatted.join(", ")} changed (it may hash one with more)")
        }
    }
    Ok(moved)
}

// Moves every pin of `sites` that means a source of `before` (its text before
// formatting) to the same token in its formatted text, and every digest of
// one to the digest of its formatted text.
move_pins: fn(root: String, found: Corpus, before: [String:String]) -[FS]> PinReport CorpusError! {
    report := PinReport{files: 0, pins: 0, problems: [String]{}}
    after := [String:String]{}
    maps := [String:[Int]]{}
    loop site in found.sites {
        text: read_tracked(root, site.path) ?? return Err(err)
        edits := [TextEdit]{}
        changed := 0
        loop spot in pin_spots(text) {
            targets: pin_targets(site, spot, found.tracked)
            formatted := false
            loop target in targets {
                if before.has_key(target) -> formatted = true
            }
            if !formatted -> next
            moves := [[Int]]{}
            problem := ""
            loop target in targets {
                if !before.has_key(target) {
                    moves.push(spot.numbers.copy())
                    next
                }
                if !(formatted_map(root, target, before, after, maps) ?? return Err(err)) {
                    problem = "`jet fmt` changed {target} beyond blank space and canonical spellings"
                    break
                }
                moves.push(moved_numbers(spot, (before.get(target) ?? "").bytes(), (after.get(target) ?? "").bytes(), maps.get(target) ?? [Int]{}))
            }
            if problem == "" {
                loop numbers in moves {
                    if !same_numbers(numbers, moves[0]) {
                        problem = "it can mean {targets.join(", ")}, which move it differently"
                    }
                }
            }
            if problem != "" {
                report.problems.push("{site.path}: pin `{pin_label(spot)}` stays: {problem}")
                next
            }
            moved := false
            loop (index, number) in moves[0] {
                if number == spot.numbers[index] || spot.ends[index] == spot.starts[index] -> next
                edits.push(TextEdit{start: spot.starts[index], end: spot.ends[index], text: "{number}"})
                moved = true
            }
            if moved -> changed += 1
        }
        changed += move_digests(root, site, text.bytes(), before, after, maps, edits, report.problems) ?? return Err(err)
        if changed > 0 {
            files.write("{root}/{site.path}", apply_edits(text, edits)) ?? return Err(CorpusError{message: "cannot write {site.path}: {err}"})
            report.files += 1
            report.pins += changed
        }
    }
    Ok(report)
}

// The source a formatter diagnostic on `errors` points at (`--> path:line:col`).
fmt_refused_source: fn(errors: String) -> String? Never! {
    loop line in errors.lines() {
        rest: line.trim_start()
        if !rest.starts_with("--> ") -> next
        location: rest.remove_prefix("--> ").trim()
        column: location.rpartition(":")
        row: column.head.rpartition(":")
        if row.sep == "" -> return Val(location.copy())
        return Val(row.head.copy())
    }
    None
}

// One way to run the formatter: the checkout it runs in, the compiler, and
// its `jet fmt` flags (with `--check` it checks instead of writing).
Formatter: struct {
    root: String,
    jet: String,
    flags: [String],
}

// The words of the internal error `jet fmt` reports for a source whose format
// would change its syntax tree.
MEANING_CHANGE: "`jet fmt` would change the syntax tree of "

// `jet fmt`'s reason for refusing a source whose meaning its format would
// change, from the internal error on `errors`; None for any other refusal.
fmt_meaning_change: fn(errors: String) -> String? Never! {
    loop line in errors.lines() {
        at: line.find(MEANING_CHANGE)
        if at >= 0 -> return Val(line.slice(at..<line.len()).copy())
    }
    None
}

// `jet fmt` over `sources`. The formatter stops at the first source it
// refuses and names it; that source is set aside, as unparsed or as one whose
// meaning the format would change, and the sources before and after it run
// again. A refusal that names no source (a malformed `package.jet`) stops the
// whole run with nothing formatted or listed, so that run is split in halves
// until the refused source runs alone, and it is set aside as unparsed. A run
// that hangs or crashes is split the same way; the source it fails on is set
// aside as failed. Returns the number of formatter runs.
run_fmt: fn(formatter: Formatter, sources: [String], outcome: &FmtOutcome) -[Exec, Time.Wait]> Int CorpusError! {
    if sources.len() == 0 -> return Ok(0)
    receipt: fmt_spec(formatter, sources).run() ?? return Err(CorpusError{message: "cannot run {formatter.jet} fmt: {err}"})
    fmt_receipt(formatter, sources, receipt, outcome)
}

// The formatter run of `sources`, with its time limit.
fmt_spec: fn(formatter: Formatter, sources: [String]) -> ProcessSpec Never! {
    argv := [String]{formatter.jet.copy(), "fmt"}
    loop flag in formatter.flags -> argv.push(flag.copy())
    loop source in sources -> argv.push(source.copy())
    process.cmd(argv).cwd(formatter.root).env("NO_COLOR", "1").stdout(.Capture).stderr(.Capture).timeout(time.duration_ms(fmt_limit_ms(sources)))
}

fmt_limit_ms: fn(sources: [String]) -> Int Never! {
    FMT_LIMIT_BASE_MS + FMT_LIMIT_PER_SOURCE_MS * sources.len()
}

// What the formatter run of `sources` that gave `receipt` said, into
// `outcome`, as run_fmt describes; a run that failed runs again in parts.
fmt_receipt: fn(formatter: Formatter, sources: [String], receipt: ProcessReceipt, outcome: &FmtOutcome) -[Exec, Time.Wait]> Int CorpusError! {
    checking: formatter.flags.contains("--check")
    limit_ms: fmt_limit_ms(sources)
    // Under `--check`, exit 1 means a source would change.
    finished: if checking -> [Int]{0, 1} else -> [Int]{0}
    failure: if receipt.timed_out -> "hang: `jet fmt` ran past {limit_ms} ms" else -> fmt_crash(receipt.signal, receipt.code, finished, receipt.errors)
    unlocated: failure == "" && fmt_unlocated_refusal(receipt.errors)
    if failure != "" || unlocated {
        if sources.len() == 1 {
            if unlocated -> outcome.unparsed.push(sources[0].copy()) else {
                outcome.failed.push(FmtFailure{path: sources[0].copy(), what: failure})
            }
            return Ok(1)
        }
        half: sources.len() /% 2
        first: run_fmt(formatter, sources[0..<half], outcome) ?? return Err(err)
        second: run_fmt(formatter, sources[half..<sources.len()], outcome) ?? return Err(err)
        return Ok(1 + first + second)
    }
    if fmt_refused_source(receipt.errors) == .Val(refused) {
        at: sources.index_of(refused) ?? return Err(CorpusError{message: "`{formatter.jet} fmt` refused `{refused}`, which this run did not pass it:\n{receipt.errors}"})
        if fmt_meaning_change(receipt.errors) == .Val(change) {
            outcome.changed.push(FmtFailure{path: refused.copy(), what: change})
        } else { outcome.unparsed.push(refused.copy()) }
        before: run_fmt(formatter, sources[0..<at], outcome) ?? return Err(err)
        after: run_fmt(formatter, sources[at + 1..<sources.len()], outcome) ?? return Err(err)
        return Ok(1 + before + after)
    }
    if checking {
        loop line in receipt.output.lines() {
            path: line.trim()
            if path != "" -> outcome.dirty.push(path.copy())
        }
    }
    Ok(1)
}

// Why a formatter run crashed, or "" when it didn't: a signal stopped it, or
// it exited with a code outside `finished` without naming the source it
// refused.
fmt_crash: fn(signal: Int?, code: Int, finished: [Int], errors: String) -> String Never! {
    if signal == .Val(number) -> return "crash: `jet fmt` stopped on signal {number}"
    if finished.contains(code) || fmt_refused_source(errors) != None || fmt_unlocated_refusal(errors) {
        return ""
    }
    "crash: `jet fmt` exited {code}: {first_line(errors)}"
}

// Whether `jet fmt` refused a run with a diagnostic that names no source (a
// malformed `package.jet`); it then formats and lists nothing, whatever its
// exit code.
fmt_unlocated_refusal: fn(errors: String) -> Bool Never! {
    if fmt_refused_source(errors) != None -> return false
    loop line in errors.lines() {
        if line.starts_with("Error: ") -> return true
    }
    false
}

// The first line of `text` that holds more than blank space, trimmed.
first_line: fn(text: String) -> String Never! {
    loop line in text.lines() {
        if line.trim() != "" -> return line.trim()
    }
    "(no message)"
}

// `run_fmt` over `sources` in batches of BATCH, up to FMT_JOBS (no more than
// the processors) at once. Each batch's outcome joins in batch order, so the
// report is the one a run of one batch after another gives.
fmt_corpus: fn(formatter: Formatter, sources: [String]) -[Env, Exec, Time.Wait]> FmtOutcome CorpusError! {
    outcome := FmtOutcome{dirty: [String]{}, unparsed: [String]{}, failed: [FmtFailure]{}, changed: [FmtFailure]{}}
    batches := [[String]]{}
    batch := [String]{}
    loop source in sources {
        batch.push(source.copy())
        if batch.len() == BATCH {
            batches.push(batch)
            batch = [String]{}
        }
    }
    if batch.len() > 0 -> batches.push(batch)
    specs: loop part in batches -> fmt_spec(formatter, part)
    jobs: if sys.cpu_count() < FMT_JOBS -> sys.cpu_count() else -> FMT_JOBS
    ran: process.run_all(specs, jobs) ?? return Err(CorpusError{message: "cannot run {formatter.jet} fmt: {err}"})
    loop (at, part) in batches {
        receipt: ran[at] ?? return Err(CorpusError{message: "cannot run {formatter.jet} fmt: {err}"})
        _: fmt_receipt(formatter, part, receipt, outcome) ?? return Err(err)
    }
    Ok(outcome)
}

// Reports each source the formatter hung or crashed on, after `stage`.
report_failures: fn(failed: [FmtFailure], stage: String) -[IO]> {
    loop failure in failed -> term.eprint("{failure.path}: {stage}: {failure.what}")
}

// One line per rule: its count of left-out sources, in first-seen order.
rule_counts: fn(rules: [String]) -> [String] Never! {
    names := [String]{}
    counts := [String:Int]{}
    loop rule in rules {
        if !counts.has_key(rule) {
            names.push(rule.copy())
            counts[rule.copy()] = 0
        }
        counts[rule.copy()] = (counts.get(rule) ?? 0) + 1
    }
    loop name in names -> "{counts.get(name) ?? 0}\t{name}"
}

corpus_main: fn(args: [String]) -[Env, Exec, FS, IO, Time.Wait]> Int CorpusError! {
    mode := ""
    simplify := [String]{}
    prefixes := [String]{}
    loop arg in args {
        if {
            arg == "--list" || arg == "--excluded" || arg == "--check" || arg == "--write" || arg == "--frame-diff" -> {
                if mode != "" -> return Err(CorpusError{message: USAGE})
                mode = arg.copy()
            }
            arg == "--simplify" -> simplify = [String]{"--simplify"}
            arg.starts_with("-") -> {
                return Err(CorpusError{message: "unknown option `{arg}`; {USAGE}"})
            }
            else -> prefixes.push(arg.copy())
        }
    }
    if mode == "" -> return Err(CorpusError{message: USAGE})
    if mode == "--frame-diff" {
        if prefixes.len() != 1 || simplify.len() > 0 -> return Err(CorpusError{message: USAGE})
        return frame_diff(repo_root(), prefixes[0])
    }
    root: repo_root()
    if root == "" -> return Err(CorpusError{message: "no checkout holds {TOOL}"})
    found: corpus(root, prefixes) ?? return Err(err)
    left_out: found.left_out.len()
    if mode == "--list" {
        loop source in found.sources -> print(source)
        print("fmt-corpus: {found.sources.len()} sources, {left_out} left out")
        return Ok(0)
    }
    if mode == "--excluded" {
        loop (at, path) in found.left_out -> print("{found.rules[at]}\t{path}")
        loop line in rule_counts(found.rules) -> print(line)
        print("fmt-corpus: {found.sources.len()} sources, {left_out} left out")
        return Ok(0)
    }
    jet: process.env_get_or("JET", "jet")
    check_flags := [String]{"--check"}
    loop flag in simplify -> check_flags.push(flag.copy())
    checker: Formatter{root: root.copy(), jet: jet.copy(), flags: check_flags}
    form: if simplify.len() > 0 -> "jet fmt --simplify" else -> "jet fmt"
    checked: fmt_corpus(checker, found.sources) ?? return Err(err)
    failed: checked.failed.len()
    meaning: checked.changed.len()
    parsed: found.sources.len() - checked.unparsed.len() - failed - meaning
    unparsed: checked.unparsed.len()
    loop change in checked.changed -> term.eprint(change.what)
    if mode == "--check" {
        loop path in checked.dirty -> print(path)
        report_failures(checked.failed, "`{form} --check`")
        if checked.dirty.len() > 0 || failed > 0 || meaning > 0 {
            term.eprint("fmt-corpus: {checked.dirty.len()} of {parsed} sources are not in `{form}` form and {meaning} would change meaning ({unparsed} don't parse, {failed} hang or crash the formatter, {left_out} left out); run `jet Tools/Agent/FmtCorpus.jet --write{form.remove_prefix("jet fmt")}`")
            return Ok(1)
        }
        print("fmt-corpus: ok ({parsed} sources in `{form}` form, {unparsed} don't parse, {left_out} left out)")
        return Ok(0)
    }
    before := pinned_sources(root, found, checked.dirty) ?? return Err(err)
    wrote: fmt_corpus(Formatter{root: root.copy(), jet: jet.copy(), flags: simplify}, checked.dirty) ?? return Err(err)
    kept := [String:Bool]{}
    loop failure in wrote.failed {
        kept[failure.path.copy()] = true
        _: before.remove(failure.path)
    }
    // A source the write pass refused stays as written.
    loop path in wrote.unparsed {
        kept[path.copy()] = true
        _: before.remove(path)
    }
    loop change in wrote.changed {
        kept[change.path.copy()] = true
        _: before.remove(change.path)
    }
    formatted := [String]{}
    loop path in checked.dirty {
        if !kept.has_key(path) -> formatted.push(path.copy())
    }
    again: fmt_corpus(checker, formatted) ?? return Err(err)
    pins: move_pins(root, found, before) ?? return Err(err)
    loop path in formatted -> print(path)
    loop change in wrote.changed -> term.eprint(change.what)
    loop problem in pins.problems -> term.eprint(problem)
    loop path in again.dirty -> term.eprint("{path}: a second `jet fmt` pass changes it again")
    loop path in again.unparsed -> term.eprint("{path}: `jet fmt` wrote a source it can't parse")
    loop change in again.changed -> term.eprint("a second `jet fmt` pass: {change.what}")
    report_failures(checked.failed, "`{form} --check`")
    report_failures(wrote.failed, "`{form}`, so it stays as written")
    report_failures(again.failed, "a second `{form} --check`")
    unstable: again.dirty.len() + again.unparsed.len() + again.changed.len()
    hung: failed + wrote.failed.len() + again.failed.len()
    changed: meaning + wrote.changed.len()
    summary: "formatted {formatted.len()} of {parsed} sources ({unparsed} don't parse, {left_out} left out); moved {pins.pins} pins in {pins.files} files"
    if unstable > 0 || pins.problems.len() > 0 || changed > 0 || hung > 0 {
        term.eprint("fmt-corpus: {summary}, but {changed} sources would change meaning, {unstable} sources are not stable, {hung} sources hang or crash the formatter and {pins.problems.len()} pins stay as written")
        return Ok(1)
    }
    print("fmt-corpus: {summary}")
    Ok(0)
}

// `text` without its code-frame lines.
without_frames: fn(text: String) -> String Never! {
    kept := [String]{}
    loop line in text.lines() {
        if !FRAME_LINE.is_match(line) -> kept.push(line.copy())
    }
    kept.join("\n")
}

// The text of `path` at `rev`, or None when `rev` has no such file.
git_show: fn(root: String, rev: String, path: String) -[Exec, Time.Wait]> String? Never! {
    receipt: process.cmd([String]{"git", "show", "{rev}:{path}"}).cwd(root).stdout(.Capture).stderr(.Capture).run() ?? return None
    if receipt.code != 0 -> return None
    Val(receipt.output.copy())
}

// Prints each file at `root` that changed since `rev` beyond its code frames,
// and each new file; Jet sources are the format's own change.
frame_diff: fn(root: String, rev: String) -[Exec, FS.Read, IO, Time.Wait]> Int CorpusError! {
    if root == "" -> return Err(CorpusError{message: "no checkout holds {TOOL}"})
    changed: git_lines(root, [String]{"git", "diff", "--name-only", rev, "--"}, [Int]{0}) ?? return Err(err)
    added: git_lines(root, [String]{"git", "ls-files", "--others", "--exclude-standard"}, [Int]{0}) ?? return Err(err)
    beyond := 0
    checked := 0
    loop path in changed {
        if path.ends_with(".jet") -> next
        checked += 1
        old: git_show(root, rev, path)
        exists: files.exists("{root}/{path}")
        new: if exists -> read_tracked(root, path) ?? return Err(err) else -> ""
        same: exists && old != None && without_frames(old ?? "") == without_frames(new)
        if !same {
            print(path)
            beyond += 1
        }
    }
    loop path in added {
        if path.ends_with(".jet") -> next
        print("{path} (new)")
        checked += 1
        beyond += 1
    }
    summary: "fmt-corpus: {beyond} of {checked} changed files differ beyond their code frames since {rev}"
    if beyond > 0 {
        term.eprint(summary)
        return Ok(1)
    }
    print(summary)
    Ok(0)
}

// The checkout holding this script, or else the one around the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    dir := files.cwd() ?? return ""
    loop {
        if files.exists("{dir}{TOOL}") -> return dir
        if dir == "/" || dir == "" -> return ""
        dir = files.dirname(dir)
    }
}

run: fn() {
    code: corpus_main(process.args()) ?? process.fail(2, err.message)
    if code != 0 -> process.exit(code)
}

#Test("whole trees and adaptation facades are left out by their rule") {
    assert_eq(tree_rule("Compiler/JetSema/Source/Sema/Scopes.jet"), "")
    assert_eq(tree_rule("Tests/UI/bare_error_mark_is_not_a_contract.jet"), "")
    assert_eq(tree_rule("Tests/Cases/Fmt/Project/x/main.jet"), RULE_FORMATTER_INPUT)
    assert_eq(tree_rule("Tests/Fixtures/MachineDoors/unformatted.jet"), RULE_FORMATTER_INPUT)
    assert_eq(tree_rule("Compiler/JetDevServer/Source/Session.jet"), RULE_DEVSERVER)
    assert_eq(tree_rule("Tools/AgentEval/runs/a/main.jet"), "")
    assert_eq(tree_rule("Tests/Fixtures/FFIAdaptations/BorrowedView/after.jet"), RULE_GENERATED)
    assert_eq(tree_rule("Tests/Conformance/Corpus/Core/Web/Store/listen_selector.jet"), "")
}

#Test("a generated head is a // line among the first five that says a tool generates it") {
    assert(is_generated_head("// GENERATED FILE — do not hand-edit.\nx: 1\n"))
    assert(is_generated_head("#!/usr/bin/env jet\n// This file is generated by Tools/Agent/DiagnosticRows.jet; do not edit.\n"))
    assert(!is_generated_head("// Generated-name policy for binders\nx: 1\n"))
    assert(!is_generated_head("a: 1\nb: 2\nc: 3\nd: 4\ne: 5\n// Generated by a tool\n"))
}

#Test("a case's fixtures are relative to its folder or rooted") {
    text: "fixture: fixtures/one\nstep: jet build\nfixture: ./fixtures/two/\nfixture: {{root}}/Examples/Basics\n"
    assert_eq(case_fixtures("Tests/Cases/BuildEntry/x.case", text).join("|"), "Tests/Cases/BuildEntry/fixtures/one|Tests/Cases/BuildEntry/fixtures/two|Examples/Basics")
    assert_eq(case_steps("fixture: F\nstep walrus: jet check {{work}}/walrus/main.jet\ncopy: a.txt b.jet\nwrite: c.jet t\n").len(), 3)
    assert(rewrites_sources("step: jet fmt --check main.jet\n"))
    assert(rewrites_sources("step: jet fix --dry-run main.jet\n"))
    assert(rewrites_sources("step: jet inspect codemod apply rename.codemod.json --yes\n"))
    assert(!rewrites_sources("# jet fmt is not run here\nstep: jet check\n"))
}

#Test("pin sites are cases and expectations outside the board") {
    assert(is_pin_site("Tests/UI/Effects/x.stderr"))
    assert(is_pin_site("Tests/Cases/CLI/help.case"))
    assert(is_pin_site("Tests/known-failing.tsv"))
    assert(!is_pin_site("Tools/Tower/.tower/tower.json"))
    assert(is_pin_site("Tools/AgentEval/runs/a/receipt.json"))
    assert(!is_pin_site("Core/Text/Fmt.jet"))
    tracked := Sources{known: [String:Bool]{}, folder_at: [String:Int]{}, beneath: [[String]]{}}
    paths: [String]{"Tests/Fixtures/Prep/x.jet", "Tests/Fixtures/Prep/Cross/main.jet", "Tests/Fixtures/Prep/Cross/b.jet"}
    loop path in paths -> add_source(tracked, path)
    beside: expectation_site("Tests/Fixtures/Prep/x.stderr", tracked)
    assert_eq(beside.own.join("|"), "Tests/Fixtures/Prep/x.jet")
    assert_eq(beside.run.join("|"), "")
    assert_eq(beside.near.join("|"), "Tests/Fixtures/Prep")
    stem: expectation_site("Tests/Fixtures/Prep/Cross.stderr", tracked)
    assert_eq(stem.own.join("|"), "Tests/Fixtures/Prep/Cross/main.jet|Tests/Fixtures/Prep/Cross/b.jet")
    assert_eq(stem.run.join("|"), "Tests/Fixtures/Prep/Cross")
    assert_eq(expectation_site("Tests/Fixtures/Prep/out/run.expected", tracked).near.join("|"), "Tests/Fixtures/Prep")
}

#Test("a pin is a name, a line and an optional column") {
    spots: pin_spots("at {{work}}/src/main.jet:12:5 and Core/Text/Fmt.jet:7, not .jet:3 or x.jet:0 or a.jet:b\n")
    assert_eq(spots.len(), 2)
    assert_eq(spots[0].name, "/src/main.jet")
    assert_eq(spots[0].numbers, [Int]{12, 5})
    assert_eq(spots[1].name, "Core/Text/Fmt.jet")
    assert_eq(spots[1].numbers, [Int]{7, 0})
    assert(!spots[1].offsets)
}

#Test("pins are byte spans, JSON places and spans, and places of no named source") {
    text: "  liveness  run.jet:166..180  x\nmain.jet:9:10  span=202..204  mark=&\n<source>:7\n$.reports[?code=\"E1\"][0].line = 6 and $.reports[?code=\"E1\"][0].column = 3\n{{\"source\":{{\"column\":5,\"line\":12,\"path\":\"calls.jet\"}}}}\n{{\\\"source\\\":\\\"s.jet\\\",\\\"span\\\":{{\\\"start\\\":20,\\\"end\\\":28}}}}\n$.span = {{\"start\":16,\"end\":24}}\n{{\"line\":3,\"character\":4,\"path\":\"lsp.jet\"}} {{\"start\":5,\"end\":9}}\n"
    spots: pin_spots(text)
    labels := [String]{}
    loop spot in spots -> labels.push(pin_label(spot))
    assert_eq(labels.join(" | "), "run.jet:166..180 | main.jet:9:10 | main.jet:202..204 | <unnamed>:7 | calls.jet:12:5 | s.jet:20..28 | <unnamed>:16..24 | <unnamed>:6:3")
    assert(spots[0].offsets && spots[2].offsets && !spots[4].offsets)
}

#Test("a pinned name means the run's source by its tail, the step's, the copied one, or a rooted one") {
    tracked := Sources{known: [String:Bool]{}, folder_at: [String:Int]{}, beneath: [[String]]{}}
    paths: [String]{"Tests/Cases/a/F/main.jet", "Tests/Cases/a/F/walrus/main.jet", "Tests/Cases/a/F/src/run.jet", "Tests/Cases/a/F/test.jet", "Tests/Cases/a/F/after.jet", "Tests/Cases/a/other.jet", "Core/Text/Fmt.jet"}
    loop path in paths -> add_source(tracked, path)
    text: "fixture: F\nstderr: ~ \"main.jet:1:2\"\nstep walrus: jet check walrus/main.jet\nstderr: ~ \"main.jet:3:10\"\ncopy: test-broken.txt test.jet\nstderr: ~ \"test.jet:4:5\"\ncopy: after.jet run.jet\nstderr: ~ \"/tmp/work/src/run.jet:1\" run.jet:2 other.jet:1 ../../Core/Text/Fmt.jet:7 <source>:3\n"
    site: case_site("Tests/Cases/a/x.case", text, tracked)
    found := [String]{}
    loop spot in pin_spots(text) {
        found.push(pin_targets(site, spot, tracked).join("+").replace("Tests/Cases/a/", ""))
    }
    assert_eq(found.join(" | "), "F/main.jet+F/walrus/main.jet | F/walrus/main.jet |  | F/src/run.jet | F/after.jet | other.jet | Core/Text/Fmt.jet | F/walrus/main.jet")
}

#Test("a pin moves with its token when only blank space changes") {
    before: "f: fn(a:Int)->Int {{\n  a+1\n}}\n\n\nmain: fn() {{\n    x: f(1)\n}}\n".bytes()
    after: "f: fn(a: Int) -> Int {{\n    a + 1\n}}\n\nmain: fn() {{\n    x: f(1)\n}}\n".bytes()
    map: ink_map(before, after) ?? [Int]{}
    assert_eq(map.len(), ink(before).len() + 1)
    assert_eq(ink_map(before, "g: 1\n".bytes()) ?? [Int]{}, [Int]{})
    moved: remap(before, after, map, Position{line: 7, column: 8}) ?? Position{line: 0, column: 0}
    assert_eq(moved.line, 6)
    assert_eq(moved.column, 8)
    sum: remap(before, after, map, Position{line: 2, column: 4}) ?? Position{line: 0, column: 0}
    assert_eq(sum.line, 2)
    assert_eq(sum.column, 7)
    line_only: remap(before, after, map, Position{line: 6, column: 0}) ?? Position{line: 0, column: 0}
    assert_eq(line_only.line, 5)
    assert_eq(line_only.column, 0)
    assert((remap(before, after, map, Position{line: 99, column: 1}) ?? Position{line: 0, column: 0}).line == 0)
}

#Test("a pin moves past the formatter's canonical spellings") {
    before: "show: fn() -[FS, IO]> Unit {{\n    a: apply(2, fn(m: Int) {{\n        m\n    }})\n    b: 1\n}}\n".bytes()
    after: "show: fn() -[FS, IO]> () {{\n    a: apply(\n        2,\n        fn(m: Int) {{\n            m\n        }},\n    )\n    b: 1\n}}\n".bytes()
    map: ink_map(before, after) ?? [Int]{}
    assert(map.len() > 0)
    later: remap(before, after, map, Position{line: 5, column: 5}) ?? Position{line: 0, column: 0}
    assert_eq(later.line, 8)
    assert_eq(later.column, 5)
    inner: remap(before, after, map, Position{line: 3, column: 9}) ?? Position{line: 0, column: 0}
    assert_eq(inner.line, 5)
    assert_eq(inner.column, 13)
    respelled: remap(before, after, map, Position{line: 1, column: 23}) ?? Position{line: 0, column: 0}
    assert_eq(respelled.line, 1)
    assert_eq(respelled.column, 26)
}

#Test("an offset moves with its byte, and a span's end with its last byte") {
    before: "f: fn(a:Int)->Int {{ a+1 }}\n".bytes()
    after: "f: fn(a: Int) -> Int {{\n    a + 1\n}}\n".bytes()
    map: ink_map(before, after) ?? [Int]{}
    spots: pin_spots("x.jet:20..23")
    assert_eq(moved_numbers(spots[0], before, after, map), [Int]{27, 32})
    assert_eq(remap_start(before, after, map, 8) ?? -1, 9)
    assert_eq(remap_end(before, after, map, 17) ?? -1, 20)
}

#Test("a digest is 64 hex digits no other letter or digit touches") {
    digest: crypto.sha256("x").hex()
    spans: digest_spans("a {digest} b x{digest} {digest}0\n".bytes())
    assert_eq(spans.len(), 1)
    assert_eq(spans[0].start, 2)
}

#Test("rewriting writes only the numbers that changed, in any order") {
    text: "main.jet:7:8 and {{\"column\":6,\"line\":2,\"path\":\"a.jet\"}}\n"
    spots: pin_spots(text)
    assert_eq(spots.len(), 2)
    edits := [TextEdit]{}
    edits.push(TextEdit{start: spots[0].starts[0], end: spots[0].ends[0], text: "10"})
    edits.push(TextEdit{start: spots[1].starts[1], end: spots[1].ends[1], text: "12"})
    edits.push(TextEdit{start: spots[1].starts[0], end: spots[1].ends[0], text: "3"})
    assert_eq(apply_edits(text, edits), "main.jet:10:8 and {{\"column\":12,\"line\":3,\"path\":\"a.jet\"}}\n")
}

#Test("a fmt case keeps out its fixtures and the sources it names, and the first rule holds") {
    out := no_exclusions()
    add_fmt_case_inputs("Tests/Cases/CLI/f.case", "fixture: fixtures/f\nstep: jet fmt --check {{root}}/Examples/Basics/Hello.jet\n", out)
    add_fmt_case_inputs("Tests/Cases/CLI/g.case", "fixture: fixtures/g\nstep: jet check\n", out)
    add_fmt_case_inputs("Tests/Cases/Migrations/m.case", "fixture: M/Input\nstep: jet run {{root}}/Compiler/Migrations/Migrate.jet -- bit-sigils1 --write before.jet\n", out)
    note(out.exact, "Examples/Basics/Hello.jet", RULE_GENERATED)
    assert_eq(exclusion_rule("Tests/Cases/CLI/fixtures/f/main.jet", out), RULE_FORMATTER_INPUT)
    assert_eq(exclusion_rule("Examples/Basics/Hello.jet", out), RULE_FORMATTER_INPUT)
    assert_eq(exclusion_rule("Tests/Cases/CLI/fixtures/g/main.jet", out), "")
    assert_eq(exclusion_rule("Tests/Cases/Migrations/M/Input/before.jet", out), RULE_FORMATTER_INPUT)
    assert_eq(exclusion_rule(MIGRATION_RUNNER, out), "")
    assert_eq(rule_counts([String]{"b", "a", "b"}).join("|"), "2\tb|1\ta")
}

#Test("a ui fixture whose snapshot shows a parse error is a parse lesson") {
    rows: "MissingFunctionBody: struct {{\n    name: String,\n\n    impl Diagnostic {{\n        code: \"E0081\",\n        stage: [.Parse],\n    }}\n}}\n\nTypeMismatch: struct {{\n    impl Diagnostic {{\n        stage: [.Sema],\n    }}\n}}\n\nBareCasePattern: struct {{\n    impl Diagnostic {{\n        stage: [.Parse, .Sema],\n    }}\n}}\n"
    assert_eq(parse_diagnostic_types(rows).join("|"), "MissingFunctionBody|BareCasePattern")
    out := no_exclusions()
    note_parse_lesson("Tests/UI/e0081_fn_without_body.stderr", out)
    note_parse_lesson("Tests/UI/E0367_bare_case/stderr", out)
    note_parse_lesson("Tests/UI/e0081_fn_without_body.jet", out)
    assert_eq(exclusion_rule("Tests/UI/e0081_fn_without_body.jet", out), RULE_PARSE_LESSON)
    assert_eq(exclusion_rule("Tests/UI/E0367_bare_case/main.jet", out), RULE_PARSE_LESSON)
    assert_eq(exclusion_rule("Tests/UI/bare_error_mark_is_not_a_contract.jet", out), "")
}

#Test("a meaning change is the internal error that names the source") {
    errors: "internal compiler error: `jet fmt` would change the syntax tree of `Tests/a.jet`, so the file stays as written; the first difference is in `If`: `x` became `y`\n  --> Tests/a.jet\nThis is a bug in jet, NOT in your program. Please report it,\n"
    assert_eq(fmt_refused_source(errors) ?? "", "Tests/a.jet")
    assert_eq(fmt_meaning_change(errors) ?? "", "`jet fmt` would change the syntax tree of `Tests/a.jet`, so the file stays as written; the first difference is in `If`: `x` became `y`")
    assert_eq(fmt_meaning_change("Error: Jet.X: no\n  --> Tests/b.jet:4:27\n") ?? "none", "none")
}

#Test("code frames are the gutter lines a diagnostic shows") {
    shown: "Error: Jet.X: no\n  --> main.jet:4:27\n    |\n  4 | bare: fn() -> Int {{\n    |                   ^\n Why: because\n"
    assert_eq(without_frames(shown), "Error: Jet.X: no\n  --> main.jet:4:27\n Why: because")
}

#Test("the refused source is the path of the first diagnostic location") {
    errors: "Error: Jet.InvalidStatement: A unit-fallible signature has no `->`\n  --> Tests/UI/bare.jet:4:27\n    |\n"
    assert_eq(fmt_refused_source(errors) ?? "", "Tests/UI/bare.jet")
    assert_eq(fmt_refused_source("") ?? "none", "none")
}

#Test("a formatter run crashes on a signal or an exit no refusal explains") {
    refusal: "Error: Jet.InvalidStatement: no\n  --> Tests/UI/bare.jet:4:27\n"
    checking: [Int]{0, 1}
    writing: [Int]{0}
    assert_eq(fmt_crash(Val(11), 0, writing, ""), "crash: `jet fmt` stopped on signal 11")
    assert_eq(fmt_crash(None, 101, writing, "\n  thread panicked: overflow\nmore\n"), "crash: `jet fmt` exited 101: thread panicked: overflow")
    assert_eq(fmt_crash(None, 2, writing, refusal), "")
    assert_eq(fmt_crash(None, 1, checking, ""), "")
    assert_eq(fmt_crash(None, 1, writing, ""), "crash: `jet fmt` exited 1: (no message)")
    assert_eq(fmt_crash(None, 0, writing, ""), "")
}

#Test("a diagnostic that names no source refuses the run, and is no crash") {
    manifest: "Error: Jet.InvalidPackageManifest: `package.jet` has a shape error\n Why: Package metadata policy is malformed\n"
    assert(fmt_unlocated_refusal(manifest))
    assert(!fmt_unlocated_refusal("Error: Jet.InvalidStatement: no\n  --> Tests/UI/bare.jet:4:27\n"))
    assert(!fmt_unlocated_refusal(""))
    assert_eq(fmt_crash(None, 2, [Int]{0}, manifest), "")
}

#Test("prefixes select whole path segments") {
    assert(selected("Core/Text/Fmt.jet", [String]{}))
    assert(selected("Core/Text/Fmt.jet", [String]{"Core/Text/"}))
    assert(selected("Core/Text/Fmt.jet", [String]{"Core/Text/Fmt.jet"}))
    assert(!selected("Core/TextBox/A.jet", [String]{"Core/Text"}))
    assert_eq(ancestors("a/b/c.jet").join("|"), "a|a/b")
    assert_eq(join("a/b", "./c/../d/"), "a/b/c/../d")
}
