#!/usr/bin/env jet
// Tower's board reads in Jet (#6676): the read-only `show` and `list` verbs
// that gates use, answering with the JSON the Tower CLI prints for them, and
// the Docs/spec reference lint (`lint --docs`, #457), whose one home this is.
// Usage (from the repository root):
//   jet Tools/tower/Board.jet card show REF [--json] [--data DIR|FILE]
//   jet Tools/tower/Board.jet card list --json [--data DIR|FILE]
//   jet Tools/tower/Board.jet decision show ID [--json] [--data DIR|FILE]
//   jet Tools/tower/Board.jet decision list --json [--open] [--drafts] [--card REF] [--data DIR|FILE]
//   jet Tools/tower/Board.jet milestone list --json [--archived] [--epoch ID] [--data DIR|FILE]
//   jet Tools/tower/Board.jet lint --docs [--docs-root DIR] [--json] [--data DIR|FILE]
// The board is --data, else TOWER_DATA (a data directory or a tower.json),
// else the nearest `.tower/tower.json` above the working directory, else this
// checkout's Tools/tower/.tower. A board inside a linked git worktree is a
// stale tracked copy, so those two defaults read the main checkout's board.
// A show reads the live board, then the archive (history.json, single file or
// shards), and marks an archived record `"archived": true`. Records come out
// as Tower normalizes and projects them: a card carries its clearance, linked
// decisions and questions, open question count and lane; a milestone its
// progress. Lists need --json; a refusal prints `tower: <message>` on stderr,
// `{"error":CODE,"message":...}` on stdout under --json, and exits 1. The lint
// prints its findings (a `{rule, ref, msg}` array under --json) and exits 1
// when there are any. Tower writes and the board lint rules stay in
// Tools/tower/tower.mjs.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    unicode: core.text
}

TOOL: "/Tools/tower/Board.jet"
MAX_JSON_BYTES: 268435456
MANIFEST_BYTES: 1048576
HISTORY_LAYOUT: "tower.history-shards/v1"
HISTORY_KINDS: [String]{"decisions", "cards", "events"}
BOOLEAN_FLAGS: [String]{"json", "archived", "open", "drafts", "docs"}
VALUE_FLAGS: [String]{"data", "card", "epoch", "docs-root"}
DOCS_DIR: "Docs"
SPEC_EXTENSIONS: [String]{".md", ".json", ".txt"}
CARD_WORDS: [String]{"card", "cards", "issue", "issues"}

#Error
Failure: struct {
    code: String
    message: String
}

Request: struct {
    words: [String]
    flags: [String: String]
}

// Where the board lives: its data directory and its live store file.
Place: struct {
    dir: String
    file: String
    note: String
}

// The live board as Tower normalizes it, one row per record: the fields the
// projections read, and the record itself as compact JSON that an answer
// parses back only for a record it prints. A row is decoded from one record
// at a time, so no tree of the whole board is ever built.
Live: struct {
    cards: [CardRow]
    decisions: [DecisionRow]
    questions: [QuestionRow]
    milestones: [Dyn]
    events: [EventRow]
    // Whether the ballot that supersedes the pre-field verdict is on the board.
    tier1: Bool
}

Archive: struct {
    cards: [CardRow]
    decisions: [DecisionRow]
}

// A store, history file or history shard; any other member is skipped unread.
#Decode
BoardFile: struct {
    cards: [CardRow]?
    decisions: [DecisionRow]?
    questions: [QuestionRow]?
    milestones: [Dyn]?
    events: [EventRow]?
}

CardRow: struct {
    id: String
    num: Int?
    // `num` as JSON, for a blocker's label.
    num_text: String
    phase: String
    milestone: String
    // Why the record fails Tower's normalization, "" when it does not.
    invalid: String
    record: String
}

DecisionRow: struct {
    id: String
    card_id: String
    status: String
    group: String
    draft: Bool
    invalid: String
    record: String
}

QuestionRow: struct {
    card_id: String
    decision_id: String
    kind: String
    status: String
    record: String
}

EventRow: struct {
    draft: Bool
    // The text of a present `ref`.
    ref: String?
}

impl CardRow.Decode {
    decode: fn(tree: Dyn) -> CardRow [FieldError]! {
        invalid := ""
        if normalize_card(tree) == {
            .Ok(_) -> {}
            .Err(failure) -> invalid = failure.message.copy()
        }
        record: compact(tree) ?? return Err(err)
        Ok(CardRow{id: text(field(tree, "id")), num: integer(field(tree, "num")), num_text: json.dumps(field(tree, "num")) ?? "", phase: text(field(tree, "phase")), milestone: text(field(tree, "milestoneId")), invalid: invalid, record: record})
    }
}

impl DecisionRow.Decode {
    decode: fn(tree: Dyn) -> DecisionRow [FieldError]! {
        invalid := ""
        if normalize_decision(tree) == {
            .Ok(_) -> {}
            .Err(failure) -> invalid = failure.message.copy()
        }
        record: compact(tree) ?? return Err(err)
        Ok(DecisionRow{id: text(field(tree, "id")), card_id: text(field(tree, "cardId")), status: text(field(tree, "status")), group: text(field(tree, "group")), draft: truthy(field(tree, "draft")), invalid: invalid, record: record})
    }
}

impl QuestionRow.Decode {
    decode: fn(tree: Dyn) -> QuestionRow [FieldError]! {
        record: compact(tree) ?? return Err(err)
        Ok(QuestionRow{card_id: text(field(tree, "cardId")), decision_id: text(field(tree, "decisionId")), kind: text(field(tree, "kind")), status: text(field(tree, "status")), record: record})
    }
}

impl EventRow.Decode {
    decode: fn(tree: Dyn) -> EventRow [FieldError]! {
        ref: field(tree, "ref")
        Ok(EventRow{draft: truthy(field(tree, "draft")), ref: if truthy(ref) -> Val(text(ref)) else -> None})
    }
}

// The record's compact JSON (`dumps` renders the tree itself, uncopied).
compact: fn(tree: Dyn) -> String [FieldError]! {
    record: json.dumps(tree) ?? return Err([FieldError]{FieldError{path: "", reason: "the record cannot be encoded: {err}"}})
    Ok(record)
}

run: fn() {
    args: process.args()
    request := parse_request(args) ?? return refuse(err, args.contains("--json"))
    json_out: request.flags.has_key("json")
    cwd: files.cwd() ?? "/"
    if request.flags.has_key("docs-root") {
        rooted: resolve(cwd, request.flags.get("docs-root") ?? ".")
        request.flags["docs-root"] = rooted
    }
    place: locate(request, process.env_get("TOWER_DATA") ?? "", cwd, repo_root()) ?? return refuse(err, json_out)
    if place.note != "" -> term.eprint(place.note)
    if request.words.len() == 1 && request.words[0] == "lint" {
        linted: lint_request(request, place) ?? return refuse(err, json_out)
        print(linted.shown)
        if linted.findings > 0 -> process.exit(1)
        return
    }
    answer: answer_request(request, place) ?? return refuse(err, json_out)
    print(answer)
}

refuse: fn(failure: Failure, json_out: Bool) -[Exec, IO]> Never {
    term.eprint("tower: {failure.message}")
    if json_out {
        error: Dyn.Object([(key: String, value: Dyn)]{(key: "error", value: Dyn.Text(failure.code.copy())), (key: "message", value: Dyn.Text(failure.message.copy()))})
        print(json.to_string(error) ?? "")
    }
    process.exit(1)
}

fail: fn(code: String, message: String) -> Failure Never! {
    Failure{code: code.copy(), message: message.copy()}
}

// The checkout holding this tool, else the working directory.
repo_root: fn() -[Env, FS]> String Never! {
    script: sys.executable()
    if script.ends_with(TOOL) -> return script.removesuffix(TOOL)
    files.cwd() ?? "/"
}

parse_request: fn(args: [String]) -> Request Failure! {
    words := [String]{}
    flags := [String: String]{}
    at := 0
    loop at < args.len() {
        arg: args[at]
        at += 1
        if !arg.starts_with("--") {
            words.push(arg.copy())
            next
        }
        name := arg.removeprefix("--")
        value := ""
        has_value := false
        if name.contains("=") {
            parts: name.split("=").to_list()
            value = name.removeprefix("{parts[0]}=")
            name = parts[0].copy()
            has_value = true
        }
        if BOOLEAN_FLAGS.contains(name) {
            flags[name.copy()] = "true"
            next
        }
        if !VALUE_FLAGS.contains(name) || words.len() == 0 {
            shown: if words.len() == 0 -> "tower" else -> "tower {words.join(" ")}"
            return Err(fail("E_USAGE", "unknown flag for `{shown}`: --{name}"))
        }
        if !has_value {
            if at >= args.len() -> return Err(fail("E_USAGE", "--{name} needs a value"))
            value = args[at].copy()
            at += 1
        }
        flags[name.copy()] = value.copy()
    }
    Ok(Request{words: words, flags: flags})
}

// `path.resolve`: absolute against `cwd`, with `.` and `..` folded.
resolve: fn(cwd: String, path: String) -> String Never! {
    joined: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    kept := [String]{}
    loop part in joined.split("/") {
        if part == "" || part == "." -> next
        if part == ".." {
            if kept.len() > 0 -> _ := kept.pop()
            next
        }
        kept.push(part.copy())
    }
    "/{kept.join("/")}"
}

parent_of: fn(path: String) -> String Never! {
    if path == "/" -> return "/"
    dir: files.dirname(path)
    if dir == "" -> "/" else -> dir
}

// A linked worktree's root and its main checkout, found from the nearest
// `.git` above `path`: in a linked worktree it is a file naming
// `<main>/.git/worktrees/<name>`.
linked_worktree: fn(path: String) -[FS]> (root: String, main: String)? {
    dir := path.copy()
    loop {
        git: "{dir}/.git"
        if files.exists(git) {
            if !files.is_file(git) -> return None
            text: files.read(git) ?? return None
            loop line in text.split("\n") {
                if !line.starts_with("gitdir:") -> next
                link: resolve(dir, line.removeprefix("gitdir:").trim())
                parts: link.split("/").to_list()
                if parts.len() < 4 || parts[parts.len() - 3] != ".git" || parts[parts.len() - 2] != "worktrees" -> return None
                main := ""
                loop at in 0..<parts.len() - 3 {
                    if parts[at] != "" -> main = "{main}/{parts[at]}"
                }
                return Val((root: dir.copy(), main: main))
            }
            return None
        }
        if dir == "/" -> return None
        dir = parent_of(dir)
    }
}

// The canonical home of a data directory: itself, or its main-checkout
// counterpart when it sits inside a linked worktree (None when that
// counterpart has no board).
canonical_dir: fn(dir: String) -[FS]> (dir: String, note: String)? {
    wt: linked_worktree(dir) ?? return Val((dir: dir.copy(), note: ""))
    main: "{wt.main}{dir.removeprefix(wt.root)}"
    if !files.exists("{main}/tower.json") -> return None
    Val((dir: main.copy(), note: "tower: worktree checkout detected — using canonical board at {main}"))
}

inside: fn(root: String, path: String) -> Bool Never! {
    path == root || path.starts_with("{root}/") || root == "/"
}

// dataFile: a TOWER_DATA naming a .json file is the live store whatever
// directory the board is read from.
place_at: fn(dir: String, cwd: String, tower_data: String, note: String) -> Place Never! {
    file: if tower_data.ends_with(".json") -> resolve(cwd, tower_data) else -> "{dir}/tower.json"
    Place{dir: dir.copy(), file: file, note: note.copy()}
}

locate: fn(request: Request, tower_data: String, cwd: String, repo: String) -[FS]> Place Failure! {
    if request.flags.get("data") == .Val(data) {
        dir: if data.ends_with(".json") -> parent_of(resolve(cwd, data)) else -> resolve(cwd, data)
        return Ok(place_at(dir, cwd, tower_data, ""))
    }
    if tower_data != "" {
        dir: if tower_data.ends_with(".json") -> parent_of(resolve(cwd, tower_data)) else -> resolve(cwd, tower_data)
        return Ok(place_at(dir, cwd, tower_data, ""))
    }
    dir := resolve(cwd, ".")
    loop {
        if files.exists("{dir}/.tower/tower.json") {
            if canonical_dir("{dir}/.tower") == .Val(found) -> return Ok(place_at(found.dir, cwd, tower_data, found.note))
        }
        if dir == "/" -> break
        dir = parent_of(dir)
    }
    if inside(repo, resolve(cwd, ".")) {
        if canonical_dir("{repo}/Tools/tower/.tower") == .Val(found) {
            if files.exists("{found.dir}/tower.json") -> return Ok(place_at(found.dir, cwd, tower_data, found.note))
        }
    }
    Err(fail("E_NO_DATA", "no Tower data found — run `tower init` in your project root (or set TOWER_DATA)"))
}

// --- Dyn helpers -------------------------------------------------------------

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

has: fn(tree: Dyn, name: String) -> Bool Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return true
        }
    }
    false
}

// The object with `name` set: in place when present, else last.
with: fn(tree: Dyn, name: String, value: Dyn) -> Dyn Never! {
    kept := [(key: String, value: Dyn)]{}
    found := false
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name {
                found = true
                kept.push((key: entry.key.copy(), value: value.copy()))
            } else {
                kept.push((key: entry.key.copy(), value: entry.value.copy()))
            }
        }
    }
    if !found -> kept.push((key: name.copy(), value: value.copy()))
    Dyn.Object(kept)
}

without: fn(tree: Dyn, name: String) -> Dyn Never! {
    kept := [(key: String, value: Dyn)]{}
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key != name -> kept.push((key: entry.key.copy(), value: entry.value.copy()))
        }
    }
    Dyn.Object(kept)
}

object: fn(pairs: [(key: String, value: Dyn)]) -> Dyn Never! {
    owned := pairs.copy()
    Dyn.Object(owned)
}

items: fn(tree: Dyn) -> [Dyn] Never! {
    if tree == .Array(list) -> return list.copy()
    [Dyn]{}
}

text: fn(tree: Dyn) -> String Never! {
    if tree == .Text(value) -> return value.copy()
    ""
}

is_text: fn(tree: Dyn, value: String) -> Bool Never! {
    if tree == .Text(found) -> return found == value
    false
}

whole: fn(lexeme: String) -> Int? Never! {
    value: Int.parse(lexeme) ?? return None
    Val(value)
}

integer: fn(tree: Dyn) -> Int? Never! {
    if tree == {
        .Int(value) -> Val(value)
        .Number(lexeme) -> whole(lexeme)
        else -> None
    }
}

// JavaScript truthiness.
truthy: fn(tree: Dyn) -> Bool Never! {
    if tree == {
        .Null -> false
        .Bool(value) -> value
        .Int(value) -> value != 0
        .Float(value) -> value != 0.0
        .Number(lexeme) -> !((whole(lexeme) ?? 1) == 0 || lexeme == "-0" || lexeme == "0.0" || lexeme == "-0.0")
        .Text(value) -> value != ""
        else -> true
    }
}

is_null: fn(tree: Dyn) -> Bool Never! {
    tree == .Null
}

// `Number(ref.replace(/^#/, ''))` when it is a whole number.
ref_number: fn(ref: String) -> Int? Never! {
    whole(ref.removeprefix("#"))
}

// --- Loading -----------------------------------------------------------------

limits: fn() -> EncodingLimits Never! {
    {
        buffer_bytes: 65536,
        max_depth: 256,
        max_item_bytes: MAX_JSON_BYTES,
        max_total_bytes: None,
        max_expansion_depth: 32,
        max_expansion_bytes: 8388608,
    }
}

read_source: fn(path: String, label: String) -[FS]> String Failure! {
    bytes: files.read_bytes(path) ?? return Err(fail("E_IO", "cannot read {label}: {path}: {err}"))
    if bytes.len() > MAX_JSON_BYTES -> return Err(fail("E_INVALID", "{label} is larger than Tower reads: {path}"))
    source: String.from_bytes(bytes) ?? return Err(fail("E_INVALID", "{label} is not UTF-8: {path}"))
    Ok(source)
}

// The parsed file, Null when it does not exist (the small archive manifest).
parse_file: fn(path: String, label: String) -[FS]> Dyn Failure! {
    if !files.exists(path) -> return Ok(Dyn.Null)
    source: read_source(path, label) ?? return Err(err)
    tree: json.parse_with_limits(source, limits()) ?? return Err(fail("E_INVALID", "{label} is not JSON: {path}: {err}"))
    Ok(tree)
}

// The file's rows, none when it does not exist or holds `null`.
read_board: fn(path: String, label: String) -[FS]> BoardFile Failure! {
    empty: BoardFile{cards: None, decisions: None, questions: None, milestones: None, events: None}
    if !files.exists(path) -> return Ok(empty)
    source: read_source(path, label) ?? return Err(err)
    if json.decode<BoardFile>(source) == .Ok(board) -> return Ok(board)
    // Only a file the typed read refuses is parsed whole, to say why.
    tree: json.parse_with_limits(source, limits()) ?? return Err(fail("E_INVALID", "{label} is not JSON: {path}: {err}"))
    if tree == .Null -> return Ok(empty)
    if !(tree == .Object(_)) -> return Err(fail("E_INVALID", "{label} must be an object"))
    reasons := [String]{}
    if json.decode<BoardFile>(source) == .Err(refused) -> reasons = refused.map(error -> "{error.path}: {error.reason}")
    Err(fail("E_INVALID", "{label} is not in Tower's format: {path}: {reasons.join("; ")}"))
}

load_live: fn(place: Place) -[FS]> Live Failure! {
    board: read_board(place.file, "live store") ?? return Err(err)
    cards: board.cards ?? [CardRow]{}
    loop card in cards {
        if card.invalid != "" -> return Err(fail("E_INVALID", card.invalid))
    }
    decisions: board.decisions ?? [DecisionRow]{}
    loop decision in decisions {
        if decision.invalid != "" -> return Err(fail("E_INVALID", decision.invalid))
    }
    milestones := [Dyn]{}
    listed: board.milestones ?? [Dyn]{}
    loop milestone in listed -> milestones.push(normalize_milestone(milestone) ?? return Err(err))
    tier1: decisions.any(decision -> decision.id == "D-ONCE-TIER1")
    Ok(Live{cards: cards, decisions: decisions, questions: board.questions ?? [QuestionRow]{}, milestones: milestones, events: board.events ?? [EventRow]{}, tier1: tier1})
}

shard_failure: fn(file: String) -> Failure Never! {
    fail("E_INVALID", "history shard history/{file} is missing or does not match history.json; check out history.json and history/ from one board commit")
}

// What an archive load keeps of each record's JSON text: the index verbs read
// only row fields, and a show verb only the record it asks for.
ArchiveKeep: enum {
    Index
    Card(String)
    Decision(String)
}

load_archive: fn(place: Place, keep: ArchiveKeep) -[FS]> Archive Failure! {
    path: "{place.dir}/history.json"
    if !files.exists(path) -> return Ok(Archive{cards: [CardRow]{}, decisions: [DecisionRow]{}})
    size: files.stat(path) ?? return Err(fail("E_IO", "cannot read history store: {path}: {err}"))
    if size.size <= MANIFEST_BYTES {
        manifest: parse_file(path, "history store") ?? return Err(err)
        if has(manifest, "layout") -> return load_shards(place, manifest, keep)
    }
    history: read_board(path, "history store") ?? return Err(err)
    cards := history.cards ?? [CardRow]{}
    decisions := history.decisions ?? [DecisionRow]{}
    kept_cards(cards, keep)
    kept_decisions(decisions, keep)
    Ok(Archive{cards: cards, decisions: decisions})
}

// Every row `find_by_ref` could pick for the asked ref keeps its text.
kept_cards: fn(rows: &[CardRow], keep: ArchiveKeep) Never! {
    ref := ""
    if keep == .Card(asked) -> ref = asked.copy()
    wanted: if ref == "" -> None else -> ref_number(ref)
    loop at in 0..<rows.len() {
        if ref != "" && (rows[at].id == ref || (wanted != None && rows[at].num == wanted)) -> next
        rows[at].record = ""
    }
}

kept_decisions: fn(rows: &[DecisionRow], keep: ArchiveKeep) Never! {
    ref := ""
    if keep == .Decision(asked) -> ref = asked.copy()
    loop at in 0..<rows.len() {
        if ref != "" && rows[at].id == ref -> next
        rows[at].record = ""
    }
}

load_shards: fn(place: Place, manifest: Dyn, keep: ArchiveKeep) -[FS]> Archive Failure! {
    if !is_text(field(manifest, "layout"), HISTORY_LAYOUT) -> return Err(fail("E_INVALID", "history.json (sharded archive manifest): unknown layout {json.to_string(field(manifest, "layout")) ?? ""}"))
    if !files.is_dir("{place.dir}/history") -> return Err(shard_failure(""))
    cards := [CardRow]{}
    decisions := [DecisionRow]{}
    loop kind in HISTORY_KINDS {
        loop shard in items(field(field(manifest, kind), "shards")) {
            file: text(field(shard, "file"))
            path: "{place.dir}/history/{file}"
            if !files.exists(path) -> return Err(shard_failure(file))
            bytes: files.read_bytes(path) ?? return Err(fail("E_IO", "cannot read unsafe history shard {place.dir}/history/{file}: {err}"))
            if (integer(field(shard, "bytes")) ?? -1) != bytes.len() || !is_text(field(shard, "sha256"), crypto.sha256(bytes).hex()) -> return Err(shard_failure(file))
            source: String.from_bytes(bytes) ?? return Err(shard_failure(file))
            rows: json.decode<BoardFile>(source) ?? return Err(fail("E_INVALID", "history shard history/{file} is not in Tower's shard format"))
            count := 0
            if kind == {
                "cards" -> {
                    listed := rows.cards ?? [CardRow]{}
                    count = listed.len()
                    kept_cards(listed, keep)
                    loop row in listed -> cards.push(row)
                }
                "decisions" -> {
                    listed := rows.decisions ?? [DecisionRow]{}
                    count = listed.len()
                    kept_decisions(listed, keep)
                    loop row in listed -> decisions.push(row)
                }
                else -> count = (rows.events ?? [EventRow]{}).len()
            }
            if (integer(field(shard, "items")) ?? -1) != count -> return Err(shard_failure(file))
        }
    }
    Ok(Archive{cards: cards, decisions: decisions})
}

// A printed record parsed back from its row.
record_tree: fn(record: String) -> Dyn Failure! {
    tree: json.parse_with_limits(record, limits()) ?? return Err(fail("E_INVALID", "a board record does not read back: {err}"))
    Ok(tree)
}

// A live card as Tower projects it: normalized, its draft-hidden links removed.
live_card: fn(row: CardRow, hidden: [String]) -> Dyn Failure! {
    card: normalize_card(record_tree(row.record) ?? return Err(err)) ?? return Err(err)
    if hidden.len() == 0 -> return Ok(card)
    blocked := [Dyn]{}
    loop id in items(field(card, "blockedBy")) {
        if !hidden.contains(text(id)) -> blocked.push(id.copy())
    }
    out := with(card, "blockedBy", Dyn.Array(blocked))
    if truthy(field(card, "questions")) {
        shown := [Dyn]{}
        loop question in items(field(card, "questions")) {
            if !hidden.contains(text(field(question, "decisionId"))) -> shown.push(question.copy())
        }
        out = with(out, "questions", Dyn.Array(shown))
    }
    Ok(out)
}

// A live decision as Tower normalizes it, with the one supersession edge
// that predates the `supersededBy` field.
live_decision: fn(row: DecisionRow, live: Live) -> Dyn Failure! {
    decision: normalize_decision(record_tree(row.record) ?? return Err(err)) ?? return Err(err)
    if row.id == "D-VERDICT-1254-1" && !truthy(field(decision, "supersededBy")) && live.tier1 -> return Ok(with(decision, "supersededBy", Dyn.Text("D-ONCE-TIER1")))
    Ok(decision)
}

// An archived record as Tower shows it.
archived_card: fn(row: CardRow) -> Dyn Failure! {
    Ok(with(record_tree(row.record) ?? return Err(err), "archived", Dyn.Bool(true)))
}

archived_decision: fn(row: DecisionRow) -> Dyn Failure! {
    Ok(with(migrate_losses(record_tree(row.record) ?? return Err(err)), "archived", Dyn.Bool(true)))
}

// --- Normalize (store.mjs normalize) -----------------------------------------

CARD_LISTS: [String]{"blockedBy", "log", "criteria", "refs", "tags", "goals"}

HARDENING_LISTS: [String]{"hardeningDedupAliases", "hardeningEvidence"}

normalize_card: fn(card: Dyn) -> Dyn Failure! {
    out := card.copy()
    loop name in CARD_LISTS {
        if !truthy(field(out, name)) -> out = with(out, name, Dyn.Array([Dyn]{}))
    }
    loop name in HARDENING_LISTS {
        value: field(out, name)
        if !is_null(value) && !(value == .Array(_)) -> out = with(out, name, Dyn.Array([Dyn]{}))
    }
    if !has(out, "parentId") -> out = with(out, "parentId", Dyn.Null)
    if !has(out, "probe") -> out = with(out, "probe", Dyn.Null)
    media: visual_media(field(out, "visualMedia")) ?? return Err(err)
    out = with(out, "visualMedia", media)
    out = with(out, "needsAcceptance", Dyn.Bool(truthy(field(out, "needsAcceptance"))))
    Ok(out)
}

visual_media: fn(value: Dyn) -> Dyn Failure! {
    if is_null(value) -> return Ok(Dyn.Array([Dyn]{}))
    if !(value == .Array(_)) -> return Err(fail("E_INVALID", "visualMedia must be an array"))
    shaped := [Dyn]{}
    loop item in items(value) {
        pairs := [(key: String, value: Dyn)]{
            (key: "kind", value: field(item, "kind")),
            (key: "path", value: field(item, "path")),
            (key: "alt", value: Dyn.Text(text(field(item, "alt")).trim())),
            (key: "caption", value: Dyn.Text(text(field(item, "caption")).trim())),
        }
        if !is_null(field(item, "state")) -> pairs.push((key: "state", value: Dyn.Text(text(field(item, "state")).trim())))
        if !is_null(field(item, "poster")) -> pairs.push((key: "poster", value: field(item, "poster")))
        shaped.push(Dyn.Object(pairs))
    }
    Ok(Dyn.Array(shaped))
}

// migrate.mjs migrateRecommendationLosses: a loss explains its mitigation.
migrate_losses: fn(decision: Dyn) -> Dyn Never! {
    out := decision.copy()
    recommendation: field(out, "recommendation")
    if has(recommendation, "losses") -> out = with(out, "recommendation", with(recommendation, "losses", migrated_losses(field(recommendation, "losses"))))
    surface: field(out, "surface")
    inner: field(surface, "recommendation")
    if has(inner, "losses") -> out = with(out, "surface", with(surface, "recommendation", with(inner, "losses", migrated_losses(field(inner, "losses")))))
    out
}

migrated_losses: fn(losses: Dyn) -> Dyn Never! {
    if !(losses == .Array(_)) -> return losses.copy()
    shaped := [Dyn]{}
    loop item in items(losses) {
        if !(item == .Object(_)) {
            shaped.push(item)
            next
        }
        out := item.copy()
        if has(out, "whyUnavoidable") {
            if !has(out, "mitigation") -> out = with(out, "mitigation", field(out, "whyUnavoidable"))
            out = without(out, "whyUnavoidable")
        }
        mitigation: text(field(out, "mitigation"))
        if mitigation.count_bytes() >= 11 && String.from_bytes_lossy(mitigation.bytes()[0..<11]).lower() == "mitigation:" {
            out = with(out, "mitigation", Dyn.Text(String.from_bytes_lossy(mitigation.bytes()[11..<mitigation.count_bytes()]).trim_start()))
        }
        shaped.push(out)
    }
    Dyn.Array(shaped)
}

normalize_decision: fn(decision: Dyn) -> Dyn Failure! {
    out := migrate_losses(decision)
    // migrate.mjs migrateReviewPasses: an open process-4 ballot moves to 5.
    if !is_text(field(out, "status"), "ratified") && !is_text(field(out, "group"), "acceptance") && integer(field(out, "ballotProcessVersion")) == Val(4) {
        out = with(out, "ballotProcessVersion", Dyn.Int(5))
        passes: field(out, "reviewPasses")
        if passes == .Object(_) -> out = with(out, "reviewPasses", without(passes, "beginner"))
    }
    out = with(out, "draft", Dyn.Bool(truthy(field(out, "draft"))))
    if has(out, "visualMedia") {
        media: visual_media(field(out, "visualMedia")) ?? return Err(err)
        out = with(out, "visualMedia", media)
    }
    Ok(out)
}

CRITERION_STATUSES: [String]{"open", "met", "verified"}

milestone_criterion: fn(item: Dyn, at: Int) -> Dyn Failure! {
    source: if item == .Text(value) -> object([(key: String, value: Dyn)]{(key: "text", value: Dyn.Text(value.copy()))}) else -> item.copy()
    n: if is_null(field(source, "n")) -> Dyn.Int(at + 1) else -> field(source, "n")
    status: if is_null(field(source, "status")) -> Dyn.Text("open") else -> field(source, "status")
    if !CRITERION_STATUSES.contains(text(status)) -> return Err(fail("E_INVALID", "milestone criterion {at + 1}.status must be open, met, or verified"))
    evidence: if truthy(field(source, "evidence")) -> field(source, "evidence") else -> Dyn.Text("")
    Ok(object([(key: String, value: Dyn)]{
        (key: "n", value: n),
        (key: "text", value: Dyn.Text(text(field(source, "text")).trim())),
        (key: "status", value: status),
        (key: "metBy", value: field(source, "metBy")),
        (key: "verifiedBy", value: field(source, "verifiedBy")),
        (key: "evidence", value: evidence),
        (key: "at", value: field(source, "at")),
    }))
}

milestone_criteria: fn(raw: Dyn) -> Dyn Failure! {
    list := [Dyn]{}
    if raw == .Array(_) {
        list = items(raw)
    } else if has(raw, "items") && field(raw, "items") == .Array(_) {
        list = items(field(raw, "items"))
    } else if is_null(raw) || is_text(raw, "") {
        return Ok(Dyn.Array([Dyn]{}))
    } else {
        list.push(raw.copy())
    }
    shaped := [Dyn]{}
    loop (at, item) in list -> shaped.push(milestone_criterion(item, at) ?? return Err(err))
    Ok(Dyn.Array(shaped))
}

hex_commit: fn(value: String) -> Bool Never! {
    if value.count_bytes() != 40 && value.count_bytes() != 64 -> return false
    loop b in value.bytes() {
        if !((b >= U8{48} && b <= U8{57}) || (b >= U8{97} && b <= U8{102})) -> return false
    }
    true
}

normalize_milestone: fn(milestone: Dyn) -> Dyn Failure! {
    criteria: milestone_criteria(field(milestone, "criteria")) ?? return Err(err)
    out := with(milestone, "criteria", criteria)
    closeout: field(out, "closeout")
    if !is_null(closeout) {
        if !(closeout == .Object(_)) || !hex_commit(text(field(closeout, "sourceCommit"))) || !truthy(field(closeout, "by")) || !truthy(field(closeout, "at")) -> out = without(out, "closeout")
    }
    status: text(field(out, "status"))
    if !(status == "open" || status == "review-ready" || status == "met") -> out = with(out, "status", Dyn.Text("open"))
    if is_text(field(out, "status"), "met") && !truthy(field(out, "verification")) {
        out = with(out, "status", Dyn.Text("review-ready"))
        out = without(out, "metAt")
    }
    Ok(out)
}

// A card linked to a milestone: all its progress reads.
Linked: struct {
    id: String
    phase: String
}

// The cards linked to each milestone: archived first, a live card replacing
// its archived copy in place (store.mjs cardsByMilestone).
cards_by_milestone: fn(cards: [CardRow], archived: [CardRow]) -> [String: [Linked]] Never! {
    index := [String: [Linked]]{}
    link_cards(index, archived)
    link_cards(index, cards)
    index
}

link_cards: fn(index: &[String: [Linked]], cards: [CardRow]) Never! {
    loop card in cards {
        if card.milestone == "" -> next
        linked := index.get(card.milestone) ?? [Linked]{}
        at := 0
        loop at < linked.len() && linked[at].id != card.id -> at += 1
        entry: Linked{id: card.id.copy(), phase: card.phase.copy()}
        if at < linked.len() -> linked[at] = entry else -> linked.push(entry)
        index[card.milestone.copy()] = linked
    }
}

// store.mjs syncMilestone: linked cards all done open the review.
sync_milestone: fn(milestone: Dyn, linked: [Linked]) -> Dyn Never! {
    if linked.len() == 0 || !linked.all(card -> card.phase == "done") {
        cleared: without(without(without(milestone, "verification"), "metAt"), "closeout")
        return with(cleared, "status", Dyn.Text("open"))
    }
    if is_text(field(milestone, "status"), "met") && truthy(field(milestone, "verification")) -> return milestone.copy()
    with(without(without(milestone, "verification"), "metAt"), "status", Dyn.Text("review-ready"))
}

milestone_progress: fn(milestone: Dyn, linked: [Linked]) -> Dyn Never! {
    done: linked.filter(card -> card.phase == "done").len()
    ready: linked.len() > 0 && done == linked.len()
    met: ready && is_text(field(milestone, "status"), "met") && truthy(field(milestone, "verification"))
    object([(key: String, value: Dyn)]{
        (key: "total", value: Dyn.Int(linked.len())),
        (key: "done", value: Dyn.Int(done)),
        (key: "reviewReady", value: Dyn.Bool(ready)),
        (key: "met", value: Dyn.Bool(met)),
    })
}

// --- Projection (store.mjs project) ------------------------------------------

// Draft ballots and their event refs: hidden from projections.
hidden_ids: fn(live: Live) -> [String] Never! {
    hidden := [String]{}
    loop decision in live.decisions {
        if decision.draft -> hidden.push(decision.id.copy())
    }
    loop event in live.events {
        if event.draft && event.ref == .Val(ref) -> hidden.push(ref.copy())
    }
    hidden
}

// Where `ref` names a card: its id, else its number.
find_by_ref: fn(cards: [CardRow], ref: String) -> Int? Never! {
    loop (at, card) in cards {
        if card.id == ref -> return Val(at)
    }
    wanted: ref_number(ref) ?? return None
    loop (at, card) in cards {
        if (card.num ?? -1) == wanted -> return Val(at)
    }
    None
}

lane: fn(name: String, who: Dyn, label: String) -> [(key: String, value: Dyn)] Never! {
    [(key: String, value: Dyn)]{(key: "lane", value: Dyn.Text(name.copy())), (key: "who", value: who.copy()), (key: "label", value: Dyn.Text(label.copy()))}
}

// store.mjs laneOf over the draft-free board: draft ballots are skipped.
lane_of: fn(card: Dyn, live: Live) -> Dyn Never! {
    phase: text(field(card, "phase"))
    id: text(field(card, "id"))
    if phase == "done" -> return object(lane("done", Dyn.Null, "Done"))
    if phase == "frozen" -> return object(lane("frozen", Dyn.Text("owner"), "Frozen — owner reactivates it"))
    open := [Dyn]{}
    loop decision in live.decisions {
        if !decision.draft && decision.card_id == id && decision.status != "ratified" && decision.group != "acceptance" -> open.push(Dyn.Text(decision.id.copy()))
    }
    if open.len() > 0 {
        plural: if open.len() > 1 -> "s" else -> ""
        pairs := lane("decide", Dyn.Text("owner"), "{open.len()} decision{plural} to make")
        pairs.push((key: "decisions", value: Dyn.Array(open)))
        return object(pairs)
    }
    blockers := [Dyn]{}
    labels := [String]{}
    loop blocker in items(field(card, "blockedBy")) {
        ref: if blocker == .Text(value) -> value.copy() else -> (json.to_string(blocker) ?? "")
        if find_by_ref(live.cards, ref) == .Val(at) {
            if live.cards[at].phase == "done" -> next
            blockers.push(blocker.copy())
            labels.push("#{live.cards[at].num_text}")
            next
        }
        loop decision in live.decisions {
            if decision.draft || decision.id != ref -> next
            if decision.status != "ratified" {
                blockers.push(blocker.copy())
                labels.push(ref.copy())
            }
            break
        }
    }
    if blockers.len() > 0 {
        pairs := lane("blocked", Dyn.Null, "Blocked by {labels.join(", ")}")
        pairs.push((key: "blockers", value: Dyn.Array(blockers)))
        return object(pairs)
    }
    planned: truthy(field(card, "plan"))
    if phase == "deciding" {
        if planned -> return object(lane("implement", Dyn.Text("agent"), "Ready to implement"))
        return object(lane("plan", Dyn.Text("agent"), "Build a plan + raise decisions"))
    }
    if phase == "planning" || phase == "triage" {
        label: if planned -> "Vet the plan + raise decisions" else -> "Build a plan + raise decisions"
        return object(lane("plan", Dyn.Text("agent"), label))
    }
    if phase == "ready" -> return object(lane("implement", Dyn.Text("agent"), "Ready to implement"))
    if phase == "building" -> return object(lane("building", Dyn.Text("agent"), "Continue building"))
    if phase == "verify" {
        if truthy(field(card, "needsAcceptance")) {
            ballot: "D-ACCEPT-{json.to_string(field(card, "num")) ?? ""}"
            accept_open := false
            loop decision in live.decisions {
                if !decision.draft && decision.id == ballot && decision.status != "ratified" -> accept_open = true
            }
            if accept_open -> return object(lane("verify", Dyn.Text("owner"), "Owner visual/UX acceptance"))
            return object(lane("verify", Dyn.Text("agent"), "Finish criteria before owner visual review"))
        }
        return object(lane("verify", Dyn.Text("agent"), "Close when exit criteria are met"))
    }
    object(lane("blocked", Dyn.Null, ""))
}

// store.mjs projectCardRecord over the draft-free board, for the live card
// at `at`.
project_card: fn(live: Live, at: Int, hidden: [String]) -> Dyn Failure! {
    card: live_card(live.cards[at], hidden) ?? return Err(err)
    id: text(field(card, "id"))
    linked := [Dyn]{}
    open := [Dyn]{}
    loop decision in live.decisions {
        if decision.draft || decision.card_id != id -> next
        linked.push(live_decision(decision, live) ?? return Err(err))
        if decision.status != "ratified" -> open.push(Dyn.Text(decision.id.copy()))
    }
    questions := [Dyn]{}
    open_questions := 0
    loop question in live.questions {
        if hidden.contains(question.decision_id) || question.card_id != id -> next
        questions.push(record_tree(question.record) ?? return Err(err))
        if question.kind != "message" && question.status == "open" -> open_questions += 1
    }
    state: if linked.len() == 0 -> "none" else if open.len() > 0 -> "pending" else -> "cleared"
    ratified: linked.len() - open.len()
    total: linked.len()
    clearance: object([(key: String, value: Dyn)]{
        (key: "state", value: Dyn.Text(state)),
        (key: "open", value: Dyn.Array(open)),
        (key: "total", value: Dyn.Int(total)),
        (key: "ratified", value: Dyn.Int(ratified)),
    })
    out := with(card, "clearance", clearance)
    out = with(out, "decisions", Dyn.Array(linked))
    out = with(out, "questions", Dyn.Array(questions))
    out = with(out, "openQ", Dyn.Int(open_questions))
    Ok(with(out, "lane", lane_of(card, live)))
}

// --- Verbs -------------------------------------------------------------------

pretty: fn(value: Dyn) -> String Failure! {
    text: json.to_string_pretty(value) ?? return Err(fail("E_INVALID", "the answer cannot be encoded: {err}"))
    Ok(text)
}

// What `pretty` prints for an array of the already pretty `items`: a list
// answer is printed one record at a time, never as one tree of them all.
pretty_list: fn(items: [String]) -> String Never! {
    if items.len() == 0 -> return "[]"
    nested := loop item in items -> "  {item.replace("\n", "\n  ")}"
    "[\n{nested.join(",\n")}\n]"
}

answer_request: fn(request: Request, place: Place) -[FS]> String Failure! {
    words: request.words
    verb: if words.len() >= 2 -> "{words[0]} {words[1]}" else -> words.join(" ")
    ref: if words.len() >= 3 -> words[2].copy() else -> "undefined"
    json_out: request.flags.has_key("json")
    if (verb == "card list" || verb == "decision list" || verb == "milestone list") && !json_out {
        return Err(fail("E_USAGE", "`{verb}` answers only with --json here; Tools/tower/tower.mjs prints the human list"))
    }
    if verb == "card show" {
        live: load_live(place) ?? return Err(err)
        if find_by_ref(live.cards, ref) == .Val(at) -> return pretty(project_card(live, at, hidden_ids(live)) ?? return Err(err))
        archive: load_archive(place, ArchiveKeep.Card(ref.copy())) ?? return Err(err)
        if find_by_ref(archive.cards, ref) == .Val(at) -> return pretty(archived_card(archive.cards[at]) ?? return Err(err))
        return Err(fail("E_NOT_FOUND", "no card {ref}"))
    }
    if verb == "card list" {
        live: load_live(place) ?? return Err(err)
        hidden: hidden_ids(live)
        shown := [String]{}
        loop at in 0..<live.cards.len() -> shown.push(pretty(project_card(live, at, hidden) ?? return Err(err)) ?? return Err(err))
        return Ok(pretty_list(shown))
    }
    if verb == "decision show" {
        live: load_live(place) ?? return Err(err)
        loop decision in live.decisions {
            if decision.id == ref -> return pretty(live_decision(decision, live) ?? return Err(err))
        }
        archive: load_archive(place, ArchiveKeep.Decision(ref.copy())) ?? return Err(err)
        loop decision in archive.decisions {
            if decision.id == ref -> return pretty(archived_decision(decision) ?? return Err(err))
        }
        return Err(fail("E_NOT_FOUND", "no decision {ref}"))
    }
    if verb == "decision list" {
        live: load_live(place) ?? return Err(err)
        drafts: request.flags.has_key("drafts")
        open_only: request.flags.has_key("open")
        card_id := ""
        by_card := false
        if request.flags.get("card") == .Val(card_ref) {
            by_card = true
            if find_by_ref(live.cards, card_ref) == .Val(at) -> card_id = live.cards[at].id.copy()
        }
        shown := [String]{}
        loop decision in live.decisions {
            if !drafts && decision.draft -> next
            if open_only && decision.status == "ratified" -> next
            if by_card && (card_id == "" || decision.card_id != card_id) -> next
            shown.push(pretty(live_decision(decision, live) ?? return Err(err)) ?? return Err(err))
        }
        return Ok(pretty_list(shown))
    }
    if verb == "milestone list" {
        live: load_live(place) ?? return Err(err)
        archive: load_archive(place, ArchiveKeep.Index) ?? return Err(err)
        index: cards_by_milestone(live.cards, archive.cards)
        list := [Dyn]{}
        loop milestone in live.milestones {
            linked: index.get(text(field(milestone, "id"))) ?? [Linked]{}
            synced: sync_milestone(milestone, linked)
            if !request.flags.has_key("archived") && truthy(field(synced, "archived")) -> next
            if request.flags.get("epoch") == .Val(epoch) {
                if !is_text(field(synced, "epochId"), epoch) -> next
            }
            list.push(with(synced, "progress", milestone_progress(synced, linked)))
        }
        return pretty(Dyn.Array(list))
    }
    Err(fail("E_USAGE", "Tools/tower/Board.jet reads `card show|list`, `decision show|list` and `milestone list`, and lints `--docs`; other Tower commands stay in Tools/tower/tower.mjs"))
}

// --- Docs lint (ported from lint.mjs ruleSpecReferenceGaps, D-ONCE-LEDGER1=A)

// The docs root: --docs-root (resolved against the working directory by
// `run`), else the project's Docs: this checkout's for its own
// Tools/tower/.tower, else the one beside the board directory.
docs_default: fn(place: Place) -> String Never! {
    tower_home: "/Tools/tower/.tower"
    project: if place.dir.ends_with(tower_home) -> place.dir.removesuffix(tower_home) else -> parent_of(place.dir)
    "{project}/{DOCS_DIR}"
}

// `lint --docs`: the findings as Tower prints them, and how many there are.
lint_request: fn(request: Request, place: Place) -[FS]> (shown: String, findings: Int) Failure! {
    if request.words.len() != 1 || !request.flags.has_key("docs") {
        return Err(fail("E_USAGE", "Tools/tower/Board.jet lints only `lint --docs` (the Docs/spec reference scan); `tower lint` runs the board rules"))
    }
    docs: request.flags.get("docs-root") ?? docs_default(place)
    found: docs_findings(place, docs) ?? return Err(err)
    if request.flags.has_key("json") {
        shown: pretty(Dyn.Array(found)) ?? return Err(err)
        return Ok((shown: shown, findings: found.len()))
    }
    if found.len() == 0 -> return Ok((shown: "(clean)", findings: 0))
    lines := loop item in found -> "{text(field(item, "rule"))}  {text(field(item, "ref"))}  {text(field(item, "msg"))}"
    Ok((shown: lines.join("\n"), findings: found.len()))
}

// Card and decision IDs cited under `docs`/spec that have no live or archived
// Tower record, one finding per ID listing every `Docs/spec/...:LINE` citing it.
docs_findings: fn(place: Place, docs: String) -[FS]> [Dyn] Failure! {
    live: load_live(place) ?? return Err(err)
    archive: load_archive(place, ArchiveKeep.Index) ?? return Err(err)
    known_cards := [String: Bool]{}
    loop card in live.cards {
        if card.num == .Val(num) -> known_cards["{num}"] = true
    }
    loop card in archive.cards {
        if card.num == .Val(num) -> known_cards["{num}"] = true
    }
    known_decisions := [String: Bool]{}
    loop decision in live.decisions -> known_decisions[decision.id.copy()] = true
    loop decision in archive.decisions -> known_decisions[decision.id.copy()] = true
    spec: "{docs}/spec"
    paths := [String]{}
    if files.is_dir(spec) -> spec_files(spec, paths) ?? return Err(err)
    cards := Citations{order: [String]{}, slots: [String: Int]{}, locations: [[String]]{}}
    decisions := Citations{order: [String]{}, slots: [String: Int]{}, locations: [[String]]{}}
    loop path in paths {
        source: files.read(path) ?? return Err(fail("E_IO", "cannot read {path}: {err}"))
        shown: "{DOCS_DIR}/{path.removeprefix("{docs}/")}"
        loop (index, line) in source.split("\n").to_list() {
            bytes: line.bytes()
            at: "{shown}:{index + 1}"
            if card_context(bytes) {
                loop ref in card_refs(bytes) {
                    if !known_cards.has_key(card_key(ref)) -> cite(cards, ref, at)
                }
            }
            loop id in decision_ids(bytes) {
                if !placeholder_decision(id) && !known_decisions.has_key(id) -> cite(decisions, id, at)
            }
        }
    }
    found := [Dyn]{}
    card_order := cards.order.copy()
    card_order.sort_by((left: String, right: String) -> numeric_order(left, right))
    loop ref in card_order {
        slot: cards.slots.get(ref) ?? next
        found.push(finding("spec-card-ref-missing", ref, "{cards.locations[slot].join(", ")} cites {ref}, but Tower has no card record"))
    }
    decision_order := decisions.order.copy()
    decision_order.sort_by((left: String, right: String) -> unicode.collate(left, right))
    loop id in decision_order {
        slot: decisions.slots.get(id) ?? next
        found.push(finding("spec-decision-ref-missing", id, "{decisions.locations[slot].join(", ")} cites {id}, but Tower has no decision record"))
    }
    Ok(found)
}

// Every place each missing ID is cited, in first-citation order.
Citations: struct {
    order: [String]
    slots: [String: Int]
    locations: [[String]]
}

cite: fn(citations: &Citations, id: String, at: String) Never! {
    if citations.slots.get(id) == .Val(slot) {
        citations.locations[slot].push(at.copy())
        return
    }
    citations.slots[id.copy()] = citations.order.len()
    citations.order.push(id.copy())
    citations.locations.push([String]{at.copy()})
}

finding: fn(rule: String, ref: String, msg: String) -> Dyn Never! {
    object([(key: String, value: Dyn)]{(key: "rule", value: Dyn.Text(rule.copy())), (key: "ref", value: Dyn.Text(ref.copy())), (key: "msg", value: Dyn.Text(msg.copy()))})
}

// The text spec files under `dir` as lint.mjs walks them: entries in
// localeCompare order, dot names skipped, symlinked directories not entered.
spec_files: fn(dir: String, out: &[String]) Failure! -[FS]> {
    listed := files.list_dir(dir) ?? return Err(fail("E_IO", "cannot list {dir}: {err}"))
    listed.sort_by((left: DirEntry, right: DirEntry) -> unicode.collate(left.name, right.name))
    loop entry in listed {
        if entry.name.starts_with(".") -> next
        path: "{dir}/{entry.name}"
        if entry.is_dir && !files.is_symlink(path) {
            spec_files(path, out) ?? return Err(err)
        } else {
            folded: entry.name.lower()
            if SPEC_EXTENSIONS.any(extension -> folded.ends_with(extension)) -> out.push(path)
        }
    }
    Ok(())
}

// `\w` in a JavaScript regular expression without the u flag.
ascii_word: fn(byte: U8) -> Bool Never! {
    (byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) || byte == (U8{95})
}

upper_or_digit: fn(byte: U8) -> Bool Never! {
    (byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90}))
}

// The matches of `/\bD-[A-Z0-9]+(?:-[A-Z0-9]+)*\b/g` in one line: the
// longest run of `-SEGMENT`s that a word boundary ends.
decision_ids: fn(bytes: [U8]) -> [String] Never! {
    found := [String]{}
    at := 0
    loop at + 2 < bytes.len() {
        if bytes[at] != (U8{68}) || bytes[at + 1] != (U8{45}) || (at > 0 && ascii_word(bytes[at - 1])) {
            at += 1
            next
        }
        end := -1
        cursor := at + 1
        loop cursor + 1 < bytes.len() && bytes[cursor] == (U8{45}) && upper_or_digit(bytes[cursor + 1]) {
            cursor += 1
            loop cursor < bytes.len() && upper_or_digit(bytes[cursor]) {
                cursor += 1
            }
            if cursor == bytes.len() || !ascii_word(bytes[cursor]) -> end = cursor
        }
        if end < 0 {
            at += 1
            next
        }
        found.push(String.from_bytes_lossy(bytes[at..<end]))
        at = end
    }
    found
}

// The matches of `/#(\d+)\b/g` in one line outside inline code (an even
// count of backticks before them).
card_refs: fn(bytes: [U8]) -> [String] Never! {
    found := [String]{}
    ticks := 0
    at := 0
    loop at < bytes.len() {
        if bytes[at] == (U8{96}) -> ticks += 1
        if bytes[at] != (U8{35}) {
            at += 1
            next
        }
        end := at + 1
        loop end < bytes.len() && bytes[end] >= (U8{48}) && bytes[end] <= (U8{57}) {
            end += 1
        }
        if end == at + 1 || (end < bytes.len() && ascii_word(bytes[end])) {
            at += 1
            next
        }
        if ticks % 2 == 0 -> found.push(String.from_bytes_lossy(bytes[at..<end]))
        at = end
    }
    found
}

// A line cites cards only when its prose names cards or issues, or a
// decision ID carries its owning card list; `[U8#4096]` is no card.
card_context: fn(bytes: [U8]) -> Bool Never! {
    at := 0
    loop at < bytes.len() {
        if !ascii_word(bytes[at]) {
            at += 1
            next
        }
        start: at
        loop at < bytes.len() && ascii_word(bytes[at]) {
            at += 1
        }
        if CARD_WORDS.contains(String.from_bytes_lossy(bytes[start..<at]).lower()) -> return true
    }
    decision_ids(bytes).len() > 0
}

// `/^D-(?:X+|Y+|EXAMPLE|TODO)$/i`.
placeholder_decision: fn(id: String) -> Bool Never! {
    rest: id.upper().removeprefix("D-")
    if rest == "EXAMPLE" || rest == "TODO" -> return true
    rest != "" && (rest == "X".repeat(rest.len()) || rest == "Y".repeat(rest.len()))
}

// `Number(ref.slice(1))` spelled as a card number key.
card_key: fn(ref: String) -> String Never! {
    digits := ref.removeprefix("#")
    loop digits.len() > 1 && digits.starts_with("0") {
        digits = digits.removeprefix("0")
    }
    digits
}

// `localeCompare(.., { numeric: true })` over `#N` refs.
numeric_order: fn(left: String, right: String) -> Ordering Never! {
    a: card_key(left)
    b: card_key(right)
    if a.len() != b.len() -> return a.len() <=> b.len()
    if a != b -> return a <=> b
    left <=> right
}

// --- Tests -------------------------------------------------------------------

fixture_live: fn() -> String Never! {
    [String]{
        "{{\"meta\":{{\"rev\":3}},\"cards\":[",
        "{{\"id\":\"c_a\",\"num\":7,\"title\":\"seven\",\"phase\":\"ready\",\"blockedBy\":[\"#8\",\"D-OPEN\"],\"milestoneId\":\"m1\",\"score\":{{\"weight\":1.50,\"at\":\"2026-01-02T03:04:05.120Z\"}}}},",
        "{{\"id\":\"c_b\",\"num\":8,\"title\":\"eight\",\"phase\":\"done\",\"milestoneId\":\"m1\",\"needsAcceptance\":1}}],",
        "\"decisions\":[",
        "{{\"id\":\"D-OPEN\",\"cardId\":\"c_b\",\"status\":\"open\"}},",
        "{{\"id\":\"D-SCRATCH\",\"cardId\":\"c_a\",\"status\":\"open\",\"draft\":true}},",
        "{{\"id\":\"D-DONE\",\"cardId\":\"c_a\",\"status\":\"ratified\",\"outcome\":\"A\"}}],",
        "\"questions\":[{{\"id\":\"q1\",\"cardId\":\"c_a\",\"kind\":\"question\",\"status\":\"open\"}}],",
        "\"milestones\":[",
        "{{\"id\":\"m1\",\"epochId\":\"e1\",\"title\":\"one\",\"status\":\"met\",\"criteria\":[\"ship\"],\"closeout\":{{\"sourceCommit\":\"nothex\",\"by\":\"x\",\"at\":\"t\"}}}},",
        "{{\"id\":\"m2\",\"epochId\":\"e1\",\"title\":\"two\",\"status\":\"open\",\"archived\":true,\"closeout\":{{\"sourceCommit\":\"0123456789abcdef0123456789abcdef01234567\",\"by\":\"x\",\"at\":\"t\"}}}}]}}",
    }.join("")
}

fixture_history: fn() -> String Never! {
    [String]{
        "{{\"version\":1,\"cards\":[{{\"id\":\"c_old\",\"num\":3,\"phase\":\"done\",\"milestoneId\":\"m2\"}}],",
        "\"decisions\":[{{\"id\":\"D-OLD\",\"status\":\"ratified\",\"recommendation\":{{\"losses\":[{{\"whyUnavoidable\":\"Mitigation: cache it\"}}]}}}}],\"events\":[]}}",
    }.join("")
}

// A fresh board directory per test under the test scratch.
fixture_place: fn(name: String, history: String) -[Env, FS]> Place Never! {
    dir: "{process.env_get_or("JET_TEST_SCRATCH_DIR", sys.temp_dir())}/tower-board-{name}"
    files.remove_all(dir) ?? ()
    files.create_dir_all(dir) ?? panic("fixture: {err}")
    files.write("{dir}/tower.json", fixture_live()) ?? panic("fixture: {err}")
    if history != "" -> files.write("{dir}/history.json", history) ?? panic("fixture: {err}")
    Place{dir: dir.copy(), file: "{dir}/tower.json", note: ""}
}

ask: fn(place: Place, args: [String]) -[FS]> Dyn Never! {
    request: parse_request(args) ?? panic("request: {err.message}")
    answer: answer_request(request, place) ?? panic("answer: {err.message}")
    json.parse(answer) ?? panic("answer is not JSON: {err}")
}

refusal: fn(place: Place, args: [String]) -[FS]> String Never! {
    request: parse_request(args) ?? return err.code
    answer_request(request, place) ?? return "{err.code}: {err.message}"
    "answered"
}

#Test("board shows projected cards, archived cards and refuses unknown ones") {
    place: fixture_place("cards", fixture_history())
    seven: ask(place, [String]{"card", "show", "#7", "--json"})
    assert_eq(integer(field(seven, "num")) ?? 0, 7)
    lane: field(seven, "lane")
    assert_eq(text(field(lane, "lane")), "blocked")
    assert_eq(text(field(lane, "label")), "Blocked by D-OPEN")
    assert_eq(items(field(seven, "decisions")).len(), 1)
    assert_eq(text(field(field(seven, "clearance"), "state")), "cleared")
    assert_eq(integer(field(seven, "openQ")) ?? 0, 1)
    assert_eq(field(seven, "parentId") == .Null, true)
    eight: ask(place, [String]{"card", "show", "c_b", "--json"})
    assert_eq(field(eight, "needsAcceptance") == .Bool(true), true)
    assert_eq(text(field(field(eight, "lane"), "lane")), "done")
    old: ask(place, [String]{"card", "show", "3", "--json"})
    assert_eq(field(old, "archived") == .Bool(true), true)
    assert_eq(refusal(place, [String]{"card", "show", "#99", "--json"}), "E_NOT_FOUND: no card #99")
    listed: items(ask(place, [String]{"card", "list", "--json"}))
    assert_eq(listed.map(card -> integer(field(card, "num")) ?? 0), [Int]{7, 8})
    assert_eq(refusal(place, [String]{"card", "list"}).starts_with("E_USAGE"), true)
    assert_eq(refusal(place, [String]{"card", "show", "7", "--bogus"}), "E_USAGE")
    files.remove_all(place.dir) ?? ()
}

#Test("board prints each record as the store holds it, one list item at a time") {
    place: fixture_place("records", fixture_history())
    shown: answer_request(parse_request([String]{"card", "show", "#7", "--json"}) ?? panic("request"), place) ?? panic("answer: {err.message}")
    assert_eq(shown.contains("\"score\": {{\n    \"weight\": 1.50,\n    \"at\": \"2026-01-02T03:04:05.120Z\"\n  }}"), true)
    lists: [[String]]{[String]{"card", "list", "--json"}, [String]{"decision", "list", "--json", "--drafts"}}
    loop args in lists {
        listed: answer_request(parse_request(args) ?? panic("request"), place) ?? panic("answer: {err.message}")
        whole: json.parse_with_limits(listed, limits()) ?? panic("answer is not JSON: {err}")
        assert_eq(listed, pretty(whole) ?? panic("pretty"))
    }
    files.remove_all(place.dir) ?? ()
}

#Test("board refuses a store that is not in Tower's format") {
    place: fixture_place("shape", "")
    files.write(place.file, "{{\"cards\":{{}}}}") ?? panic("fixture: {err}")
    assert_eq(refusal(place, [String]{"card", "show", "#7", "--json"}).starts_with("E_INVALID: live store is not in Tower's format: {place.file}: "), true)
    files.write(place.file, "[1]") ?? panic("fixture: {err}")
    assert_eq(refusal(place, [String]{"card", "show", "#7", "--json"}), "E_INVALID: live store must be an object")
    files.write(place.file, "{{\"cards\":[") ?? panic("fixture: {err}")
    assert_eq(refusal(place, [String]{"card", "show", "#7", "--json"}).starts_with("E_INVALID: live store is not JSON: {place.file}: "), true)
    files.remove_all(place.dir) ?? ()
}

#Test("board lists decisions and milestones as Tower normalizes them") {
    place: fixture_place("decisions", fixture_history())
    plain: items(ask(place, [String]{"decision", "list", "--json"}))
    assert_eq(plain.map(decision -> text(field(decision, "id"))), [String]{"D-OPEN", "D-DONE"})
    assert_eq(field(plain[0], "draft") == .Bool(false), true)
    drafts: items(ask(place, [String]{"decision", "list", "--json", "--drafts", "--open"}))
    assert_eq(drafts.map(decision -> text(field(decision, "id"))), [String]{"D-OPEN", "D-SCRATCH"})
    by_card: items(ask(place, [String]{"decision", "list", "--json", "--card=#7"}))
    assert_eq(by_card.map(decision -> text(field(decision, "id"))), [String]{"D-DONE"})
    old: ask(place, [String]{"decision", "show", "D-OLD", "--json"})
    loss: items(field(field(old, "recommendation"), "losses"))[0]
    assert_eq(json.to_string(loss) ?? "", "{{\"mitigation\":\"cache it\"}}")
    assert_eq(field(old, "archived") == .Bool(true), true)
    assert_eq(refusal(place, [String]{"decision", "show", "D-NONE"}), "E_NOT_FOUND: no decision D-NONE")
    open: items(ask(place, [String]{"milestone", "list", "--json"}))
    assert_eq(open.len(), 1)
    one: open[0]
    assert_eq(text(field(one, "status")), "open")
    assert_eq(has(one, "closeout"), false)
    assert_eq(json.to_string(field(one, "progress")) ?? "", "{{\"total\":2,\"done\":1,\"reviewReady\":false,\"met\":false}}")
    assert_eq(json.to_string(items(field(one, "criteria"))[0]) ?? "", "{{\"n\":1,\"text\":\"ship\",\"status\":\"open\",\"metBy\":null,\"verifiedBy\":null,\"evidence\":\"\",\"at\":null}}")
    every: items(ask(place, [String]{"milestone", "list", "--archived", "--json"}))
    two: every[1]
    assert_eq(text(field(two, "status")), "review-ready")
    assert_eq(field(field(two, "progress"), "reviewReady") == .Bool(true), true)
    assert_eq(text(field(field(two, "closeout"), "sourceCommit")), "0123456789abcdef0123456789abcdef01234567")
    files.remove_all(place.dir) ?? ()
}

#Test("board reads a sharded archive and refuses a torn one") {
    shard: "{{\n  \"cards\": [\n    {{\"id\": \"c_old\", \"num\": 3, \"phase\": \"done\"}}\n  ]\n}}\n"
    empty_decisions: "{{\n  \"decisions\": []\n}}\n"
    sum: crypto.sha256(shard.bytes()).hex()
    manifest: [String]{
        "{{\"version\":1,\"layout\":\"tower.history-shards/v1\",\"shardBytes\":8388608,",
        "\"decisions\":{{\"shards\":[{{\"file\":\"decisions-001.json\",\"items\":0,\"bytes\":{empty_decisions.count_bytes()},\"sha256\":\"{crypto.sha256(empty_decisions.bytes()).hex()}\"}}]}},",
        "\"cards\":{{\"shards\":[{{\"file\":\"cards-001.json\",\"items\":1,\"bytes\":{shard.count_bytes()},\"sha256\":\"{sum}\"}}]}},",
        "\"events\":{{\"shards\":[]}}}}",
    }.join("")
    place: fixture_place("shards", manifest)
    files.create_dir_all("{place.dir}/history") ?? panic("fixture: {err}")
    files.write("{place.dir}/history/decisions-001.json", empty_decisions) ?? panic("fixture: {err}")
    files.write("{place.dir}/history/cards-001.json", shard) ?? panic("fixture: {err}")
    old: ask(place, [String]{"card", "show", "#3", "--json"})
    assert_eq(field(old, "archived") == .Bool(true), true)
    files.write("{place.dir}/history/cards-001.json", shard.replace("done", "open")) ?? panic("fixture: {err}")
    assert_eq(refusal(place, [String]{"card", "show", "#3"}).starts_with("E_INVALID: history shard history/cards-001.json is missing or does not match"), true)
    files.remove_all(place.dir) ?? ()
}

#Test("board finds its data the way Tower does") {
    request: parse_request([String]{"card", "show", "1", "--data", "x/tower.json"}) ?? panic("request: {err.message}")
    flagged: locate(request, "", "/work", "/repo") ?? panic("locate: {err.message}")
    assert_eq(flagged.dir, "/work/x")
    assert_eq(flagged.file, "/work/x/tower.json")
    plain: parse_request([String]{"card", "show", "1"}) ?? panic("request: {err.message}")
    env_dir: locate(plain, "board/", "/work", "/repo") ?? panic("locate: {err.message}")
    assert_eq(env_dir.file, "/work/board/tower.json")
    env_file: locate(plain, "/b/../store.json", "/work", "/repo") ?? panic("locate: {err.message}")
    assert_eq(env_file.dir, "/")
    assert_eq(env_file.file, "/store.json")
    assert_eq(resolve("/a/b", "../c/./d"), "/a/c/d")
    assert_eq(hex_commit("0123456789abcdef0123456789abcdef01234567"), true)
    assert_eq(hex_commit("0123456789ABCDEF0123456789abcdef01234567"), false)
}

#Test("board lints Docs/spec references the way tower lint --docs did") {
    place: fixture_place("lint", fixture_history())
    docs: "{place.dir}/project/Docs"
    files.create_dir_all("{docs}/spec/nested") ?? panic("fixture: {err}")
    files.write("{docs}/spec/law.md", "Card #7 and #99 cite D-OPEN, D-MISSING1 and D-XXX.\nNo context here: #95.\nIssue `#98` stays code; D-Lower, xD-NOPE and D-AB_C are no IDs; D-OLD is archived.\n") ?? panic("fixture: {err}")
    files.write("{docs}/spec/nested/more.md", "cards #99 and #0100 and D-MISSING1\n") ?? panic("fixture: {err}")
    files.write("{docs}/spec/.hidden.md", "card #55 D-HIDDEN\n") ?? panic("fixture: {err}")
    files.write("{docs}/spec/skip.rs", "card #53 D-SKIPPED\n") ?? panic("fixture: {err}")
    request: parse_request([String]{"lint", "--docs", "--docs-root", docs, "--json"}) ?? panic("request: {err.message}")
    linted: lint_request(request, place) ?? panic("lint: {err.message}")
    assert_eq(linted.findings, 3)
    shown := [String]{}
    loop item in items(json.parse(linted.shown) ?? panic("lint is not JSON: {err}")) {
        shown.push("{text(field(item, "rule"))}|{text(field(item, "ref"))}|{text(field(item, "msg"))}")
    }
    assert_eq(shown, [String]{
        "spec-card-ref-missing|#99|Docs/spec/law.md:1, Docs/spec/nested/more.md:1 cites #99, but Tower has no card record",
        "spec-card-ref-missing|#0100|Docs/spec/nested/more.md:1 cites #0100, but Tower has no card record",
        "spec-decision-ref-missing|D-MISSING1|Docs/spec/law.md:1, Docs/spec/nested/more.md:1 cites D-MISSING1, but Tower has no decision record",
    })
    bare: parse_request([String]{"lint", "--docs", "--docs-root", "{place.dir}/none"}) ?? panic("request: {err.message}")
    clean: lint_request(bare, place) ?? panic("lint: {err.message}")
    assert_eq(clean.shown, "(clean)")
    assert_eq(clean.findings, 0)
    board_only: parse_request([String]{"lint", "--json"}) ?? panic("request: {err.message}")
    assert_eq(lint_code(board_only, place), "E_USAGE")
    assert_eq(docs_default(Place{dir: "/repo/Tools/tower/.tower", file: "", note: ""}), "/repo/Docs")
    assert_eq(docs_default(Place{dir: "/work/.tower", file: "", note: ""}), "/work/Docs")
    files.remove_all(place.dir) ?? ()
}

lint_code: fn(request: Request, place: Place) -[FS]> String Never! {
    lint_request(request, place) ?? return err.code
    "answered"
}
