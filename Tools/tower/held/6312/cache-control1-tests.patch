diff --git a/Examples/features/memory/cache_line_padding.jet b/Examples/features/memory/cache_line_padding.jet
new file mode 100644
index 0000000000..f6b32145a3
--- /dev/null
+++ b/Examples/features/memory/cache_line_padding.jet
@@ -0,0 +1,22 @@
+// D-CACHE-CONTROL1=A: `$build.cpu.cache_line` is the cache-line size of the
+// selected CPU in bytes. Jet does not select CPUs yet, so it is 64 on every
+// target. Aligning a hot struct to the line keeps two of them from sharing
+// one line, so threads that write neighbouring counters stop slowing each
+// other down (false sharing).
+#Layout(c, align($build.cpu.cache_line))
+struct PaddedCounter {
+    hits: Int
+}
+
+struct Counter {
+    hits: Int
+}
+
+fn run() {
+    print($build.cpu.cache_line)
+    print("padded: align {PaddedCounter.$layout.alignment} size {PaddedCounter.$layout.size}")
+    print("plain: align {Counter.$layout.alignment} size {Counter.$layout.size}")
+    counters := [PaddedCounter]{PaddedCounter{hits: 0}, PaddedCounter{hits: 0}}
+    counters[1].hits += 3
+    print(counters[1].hits)
+}
diff --git a/Examples/features/memory/stream_store.jet b/Examples/features/memory/stream_store.jet
new file mode 100644
index 0000000000..3a0f0617b5
--- /dev/null
+++ b/Examples/features/memory/stream_store.jet
@@ -0,0 +1,41 @@
+// D-CACHE-CONTROL1=A: `mem.stream_store(&dst, value)` is `dst = value`
+// written without filling the cache. Use it for a large output that is
+// written once and not read again soon. On x86-64 a four- or eight-byte value
+// is stored with `movnti`; narrower values and structs use an ordinary store.
+// Either way the program sees exactly the values it stored.
+use core.mem as mem
+
+struct Pair {
+    a: Int
+    b: Float
+}
+
+fn squares(out: &[Float]) {
+    loop index in 0..<out.len() -> mem.stream_store(&out[index], out[index] * out[index])
+}
+
+fn run() {
+    floats := [Float]{1.5, 2.5, 3.5}
+    squares(&floats)
+    print(floats)
+
+    ints := [Int]{0, 0, 0, 0}
+    loop index in 0..<ints.len() -> mem.stream_store(&ints[index], index * 1000003)
+    print(ints)
+
+    total := 0
+    mem.stream_store(&total, 42)
+    print(total)
+
+    name := "draft"
+    mem.stream_store(&name, "final")
+    print(name)
+
+    pairs := [Pair]{Pair{a: 1, b: 1.0}}
+    mem.stream_store(&pairs[0], Pair{a: 2, b: 2.5})
+    print("{pairs[0].a} {pairs[0].b}")
+
+    bytes := [U8]{1, 2}
+    mem.stream_store(&bytes[0], 9)
+    print(bytes)
+}
