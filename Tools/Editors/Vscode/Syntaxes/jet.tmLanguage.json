{
  "name": "Jet",
  "scopeName": "source.jet",
  "patterns": [
    { "include": "#comments" },
    { "include": "#doc-comments" },
    { "include": "#grammar-literals" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#effect-arrows" },
    { "include": "#brackets" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "effect-arrows": {
      "comment": "D-EFF2: `-[Net]>` is one token, not minus plus a list.",
      "patterns": [
        {
          "name": "meta.effect-arrow.jet",
          "begin": "-\\[",
          "end": "\\]>",
          "beginCaptures": { "0": { "name": "keyword.operator.jet" } },
          "endCaptures": { "0": { "name": "keyword.operator.jet" } },
          "patterns": [
            { "match": "\\bvia\\b", "name": "keyword.declaration.jet" },
            { "match": "[A-Za-z_][A-Za-z0-9_.]*", "name": "entity.name.type.jet" }
          ]
        }
      ]
    },
    "brackets": {
      "comment": "Balanced `[...]` so nested list types and indexes keep scopes.",
      "patterns": [
        {
          "name": "meta.brackets.jet",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#strings" },
            { "include": "#comments" },
            { "include": "#effect-arrows" },
            { "include": "#brackets" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#numbers" },
            { "include": "#functions" }
          ]
        }
      ]
    },
    "contextual-keywords": {
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])next(?=\\s*(?:\\(\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\))?\\s*(?:[;}\\n]|$))"
        },
        {
          "comment": "D-ECO-INLINEPACKAGE1=A: package is contextual and only highlighted before its record carrier.",
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])package(?=\\s*(?:(?://[^\\n]*(?:\\n|$)|/\\*(?:[^*]|\\*(?!/))*\\*/)\\s*)*\\{)"
        }
      ]
    },
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jet",
          "match": "///.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        { "include": "#block-comments" },
        {
          "name": "comment.line.double-slash.jet",
          "match": "//.*$"
        }
      ]
    },
    "block-comments": {
      "comment": "S5: block comments nest, so the rule includes itself and each `/*` needs its own `*/`.",
      "patterns": [
        {
          "name": "comment.block.jet",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#block-comments" }]
        }
      ]
    },
    "grammar-literals": {
      "comment": "A `Grammar{\"\"\"…\"\"\"}` body is rule notation (core.grammar), so it is colored as rules, tokens, literals and classes, not as one string. It must come before #strings.",
      "patterns": [
        {
          "begin": "\\b(Grammar)(\\{)(\"\"\")",
          "end": "(\"\"\")(\\})",
          "beginCaptures": {
            "1": { "name": "entity.name.type.jet" },
            "3": { "name": "string.quoted.triple.jet" }
          },
          "endCaptures": {
            "1": { "name": "string.quoted.triple.jet" }
          },
          "contentName": "meta.embedded.block.grammar.jet",
          "patterns": [{ "include": "#grammar-notation" }]
        }
      ]
    },
    "grammar-notation": {
      "comment": "Rule notation in the ANTLR 4 style. A grammar literal has no holes: `{{` and `}}` are literal braces and a lone brace is invalid.",
      "patterns": [
        { "include": "#comments" },
        {
          "name": "string.quoted.single.grammar.jet",
          "match": "'(?:[^'\\\\\\n]|\\\\.)*'i?"
        },
        {
          "name": "string.quoted.double.grammar.jet",
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"i?"
        },
        {
          "name": "constant.other.character-class.grammar.jet",
          "match": "\\[(?:[^\\]\\\\\\n]|\\\\.)*\\]|\\\\[pP]\\{[A-Za-z_]+\\}|\\\\[pP][A-Za-z]"
        },
        {
          "name": "string.quoted.double.jet",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "invalid.illegal.grammar.jet",
          "match": "[{}]"
        },
        {
          "comment": "Element options: `<assoc=right>`, `HOLE<slot=Name>`.",
          "match": "(<)\\s*([a-z]+)\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(>)",
          "captures": {
            "2": { "name": "variable.parameter.grammar.jet" },
            "3": { "name": "keyword.operator.grammar.jet" },
            "4": { "name": "entity.name.type.jet" }
          }
        },
        {
          "match": "(->)\\s*(skip)\\b",
          "captures": {
            "1": { "name": "keyword.operator.grammar.jet" },
            "2": { "name": "keyword.control.grammar.jet" }
          }
        },
        {
          "comment": "An alternative's name, `# Name`, which becomes an enum case.",
          "match": "(#)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.grammar.jet" },
            "2": { "name": "entity.name.type.jet" }
          }
        },
        {
          "comment": "A token rule's definition: `NAME :` or `fragment NAME :`.",
          "match": "\\b(?:(fragment)\\s+)?([A-Z][A-Z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "keyword.declaration.grammar.jet" },
            "2": { "name": "entity.name.constant.grammar.jet" }
          }
        },
        {
          "comment": "A parser rule's definition: `name :`.",
          "name": "entity.name.function.grammar.jet",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*:)"
        },
        {
          "comment": "A field label: `name=` or `name+=`.",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(\\+?=)",
          "captures": {
            "1": { "name": "variable.other.member.grammar.jet" },
            "2": { "name": "keyword.operator.grammar.jet" }
          }
        },
        {
          "name": "keyword.declaration.grammar.jet",
          "match": "\\b(?:fragment|import)\\b"
        },
        {
          "name": "constant.language.grammar.jet",
          "match": "\\b(?:EOF|HOLE)\\b"
        },
        {
          "name": "constant.other.token.grammar.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.rule.grammar.jet",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.grammar.jet",
          "match": "\\*\\?|\\+\\?|[:;|?*+.~()]"
        }
      ]
    },
    "strings": {
      "comment": "Quoted text is one color. Escapes and {interpolation} stay in this scope; never include $self, #functions, or #keywords.",
      "patterns": [
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "name": "string.quoted.double.jet",
      "match": "\\\\[\"\\\\nrt0]|\\\\u\\{[0-9a-fA-F]+\\}|\\{\\{|\\}\\}"
    },
    "string-interpolation": {
      "name": "string.quoted.double.jet",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#string-interpolation" },
        {
          "name": "string.quoted.double.jet",
          "begin": "\"",
          "end": "\"",
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.jet",
          "match": "'[^'\\\\]'|'\\\\.'",
          "captures": { "0": { "name": "constant.character.jet" } }
        }
      ]
    },
    "keywords": {
      "comment": "BEGIN GENERATED JET SYNTAX HIGHLIGHTS",
      "patterns": [
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])(break|else|if|in|loop|return|yield)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.control.jet",
          "match": "(?<![.A-Za-z0-9_])(after|defer|next|task)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.control.jet",
          "match": "(task\\.group|task\\.race|task\\.all|task\\.any)"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])(enum|extern|fn|impl|module|priv|struct|trait|use)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])(as)(?=\\s+[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "keyword.declaration.jet",
          "match": "(?<![.A-Za-z0-9_])(Context|Impure|Reactive|Scrub|State|Test|Todo|Transact|Unsafe|add|change|client|distinct|migration|policy|protocol|remove|rename|rust|server|state|validate|via|wrap)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.other.ownership.jet",
          "match": "(?<![.A-Za-z0-9_])(uninit)(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*:))"
        },
        {
          "name": "keyword.other.jet",
          "match": "(?<![.A-Za-z0-9_])(it|self)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.other.jet",
          "match": "(#package|#program|#caller|@SOURCE|#build|#phase|@TYPES|#code|#here|#loop|#run|#if)"
        },
        {
          "name": "constant.language.jet",
          "match": "\\b(Canceled|DeadlineBlown|None|Panicked|Val|false|true)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(BTreeMap|Bits|Bool|Budget|BudgetApplies|Bytes|CSV|Cache|Char|Complex|Complex32|Computed|Condition|DBValue|Decimal|Derived|Duration|Dyn|Effect|EncodingError|Err|Event|EventPolicy|EventScope|EventTrace|F32|F64|Float|HashMap|Hook|I16|I32|I64|I8|IOError|Instant|Int|Iter|JSON|Key|Measurement|MemoStats|PriorityQueue|Ptr|Queue|Rank|Receiver|Sender|Set|Shared|SharedGuard|SharedRevisionError|SharedSnapshot|Signal|Stream|String|Subscription|TOML|Task|TaskFailure|U16|U32|U64|U8|UTF8Error|ViewIter|WatchEvent|WatchHandle|WatchSet|YAML)\\b"
        },
        {
          "name": "storage.type.builtin.jet",
          "match": "(Shared\\.Weak|\\(\\))"
        },
        {
          "name": "support.function.builtin.jet",
          "match": "(?<![.A-Za-z0-9_])(assert|assert_eq|channel|check|freeze|input|join|print)(?=\\s*\\()"
        },
        {
          "name": "entity.name.tag.rule.jet",
          "match": "#\\[?(ABI|Allow|Arg|As|Bindgen|CLI|Close|Codable|Commutative|Comparable|Context|ContextKey|Credential|Deadline|Debug|Deprecated|DevPanel|Doc|Equatable|Error|FFI|FX|HTML|Impure|Inline|Input|Interrupt|Job|Kernel|Layout|Live|Local|MaxDepth|Memo|Meta|MoveOnly|MustUse|NoPrelude|Nondeterministic|Numeric|Off|On|Open|Overflow|PII|Patchable|Persist|Policy|Post|Pre|Printable|Reactive|Receipt|Recorded|Redact|Region|Rename|Replayable|Root|Runtime|SQL|Scalar|Scrub|Secret|Shared|Shield|SingleUse|Specified|State|Static|StepLimit|Target|Test|Through|Todo|Track|Transact|Undo|UnitFamily|Unsafe|Waive)\\b"
        },
        {
          "name": "keyword.other.ownership.take.jet",
          "match": "(?:(?<=[(,:])|(?<=[(,:]\\s)|(?<=\\btask\\s))(\\^\\^)"
        },
        {
          "name": "keyword.operator.sigil.jet",
          "match": "(\\.\\.\\.|:>|<:|#|\\$|:|\\^)"
        },
        {
          "name": "keyword.operator.jet",
          "match": "(%%=|&~=|\\.\\.<|\\/%=|<<=|<=>|>>=|!=|%%|%=|&&|&=|&~|\\*=|\\+=|\\-=|\\->|\\.\\.|\\.\\[|\\/%|\\/=|<<|<=|<>|==|>=|>>|\\?\\.|\\?\\?|\\|=|\\|>|\\|\\||~=|!|%|&|\\*|\\+|\\-|\\/|<|>|\\?|\\||~)"
        }
      ],
      "endComment": "END GENERATED JET SYNTAX HIGHLIGHTS"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.jet",
          "match": "\\b(Int|Float|Bool|String|Char|Err|Shared|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64)\\b"
        },
        {
          "name": "storage.type.collection.jet",
          "match": "\\b(List|Map)\\b(?=\\s*<)"
        },
        {
          "name": "storage.type.result.jet",
          "match": "\\?"
        },
        {
          "comment": "User-defined types: PascalCase identifiers",
          "name": "entity.name.type.jet",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jet",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jet",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.jet",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition name: `name: fn(…)` (D-DECL-COLON1)",
          "name": "entity.name.function.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*:\\s*fn\\b)"
        },
        {
          "comment": "Method call: ident followed by (",
          "name": "entity.name.function.call.jet",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Changeable binding: the mark and the name of `^name: value`, so a changeable name stands apart from a fixed one",
          "match": "(\\^)([a-z_][A-Za-z0-9_]*)(?=\\s*:(?!:))",
          "captures": {
            "1": { "name": "keyword.operator.binding.jet" },
            "2": { "name": "variable.other.changeable.jet" }
          }
        },
        {
          "name": "keyword.operator.jet",
          "match": "\\?|->|&&|\\|\\||==|!=|<=|>=|[-+*/%]=|\\.{2}|[+\\-*/%<>&|^!]"
        }
      ]
    }
  }
}
