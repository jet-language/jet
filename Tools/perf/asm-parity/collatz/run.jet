#CLI
Args: struct {
    n: Int
}

run: fn(args: Args) {
    total := 0
    loop start := 1, start < args.n {
        x := start
        loop x != 1 {
            x = if x /% 2 * 2 == x -> x /% 2 else -> 3 * x + 1
            total += 1
        }
        start += 1
    }
    print("steps {total}")
}
