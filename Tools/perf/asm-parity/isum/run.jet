#CLI
Args: struct {
    n: Int
}

// Fill a list by index, then sum it by index 20 times: bounds-checked reads.
run: fn(args: Args) {
    n: args.n
    xs := [Int]{0}.cycle(n).to_list()
    loop i := 0, i < n {
        xs[i] = i /% 3
        i += 1
    }
    total := 0
    loop pass := 0, pass < 20 {
        loop i := 0, i < n {
            total += xs[i]
            i += 1
        }
        pass += 1
    }
    print("sum {total}")
}
