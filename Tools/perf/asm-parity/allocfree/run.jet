// The memory kernel's heap (mem.alloc_raw and mem.free_raw): 4096 operations
// over 256 slots. Each one releases the block its slot holds and takes a
// fresh block of a drawn size, from 1 byte to 1 KiB and weighted to the small
// ones. `n` passes over them; the sum adds every size taken.
use {
    mem: core.mem
}

#CLI
Args: struct {
    n: Int
}

// One operation: the slot it uses and the size it takes.
Op: struct {
    slot: Int
    size: Int
}

OPS: 4096
SLOTS: 256

// The next state of a 31-bit linear congruential generator.
next: fn(state: Int) -> Int {
    (state * 1103515245 + 12345).bit_and(2147483647)
}

// The operations: per operation one draw picks the size (its top three bits
// a size class of up to 8, 16, 32, 64, 128, 256, 512 or 1024 bytes, the size
// from bits 12 up) and a second the slot (bits 16 to 23). The generator's
// low bits repeat too soon to pick a class.
operations: fn() -> [Op] {
    ops := [Op]{}
    state := 12345
    loop _ in 0..<OPS {
        state = next(state)
        class: (state >> 28).bit_and(7)
        size: 1 + (state >> 12).bit_and((8 << class) - 1)
        state = next(state)
        ops.push(Op{slot: (state >> 16).bit_and(SLOTS - 1), size})
    }
    ops
}

run: fn(args: Args) {
    passes: if args.n > 0 -> args.n else -> 1
    ops: operations()
    live := [Int]{}
    loop _ in 0..<SLOTS -> live.push(0)
    total := 0
    #Unsafe("each slot holds the address of one block alloc_raw gave and nothing else does; the block is released once, before its slot takes the next one or after the passes") {
        loop _ in 0..<passes {
            loop op in ops {
                held: live[op.slot]
                if held != 0 {
                    old: mem.Ptr<U8>.from_addr(held)
                    mem.free_raw(old) // the heap
                }
                block: mem.alloc_raw(op.size, 8) ?? panic("no memory") // the heap
                live[op.slot] = mem.address_of(block.*)
                total += op.size
            }
        }
        loop held in live {
            if held != 0 {
                old: mem.Ptr<U8>.from_addr(held)
                mem.free_raw(old)
            }
        }
    }
    print("sum {total}")
}
