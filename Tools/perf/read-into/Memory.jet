#!/usr/bin/env jet
// The memory half of the net_read_into_vs_read pair (#5976 c112), the Jet
// twin of memory.mjs (the gauntlet entry read-into-memory pairs them). Wall
// time is the shared harness's (`performance-surface.mjs --pair
// net_read_into_vs_read`, into the row's evidence_file). This measures the
// row's metrics the harness does not: allocations per read and peak live heap
// bytes, from the runtime counting policy's own facts in a counted build of
// each arm, plus peak RSS (getrusage through the gauntlet timer) of the
// uncounted build. Both arms build from the row's surface_source and
// plain_source at --optimize=full. Each metric gets its own verdict under the
// harness's rule that only strictly below plain wins. --write replaces the
// row's memory_evidence_file; without it the result is printed.
//
//   jet Tools/perf/read-into/Memory.jet --artifact <jet> --gdb <gdb> [--write] [--scratch <dir>]
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    math: core.math
    process: core.process
    sys: core.sys
}

TOOL: "/Tools/perf/read-into/Memory.jet"
MANIFEST: "Tools/gauntlet/measurement-manifest.json"
TIMER: "Tools/gauntlet/harness/timer.py"
PAIR: "net_read_into_vs_read"
COUNTED_RUNS: 3
COUNTING: "    allocator: mem.Counting.over(mem.Heap, cap: 2.gb)"
// The shared harness's paired trials and bootstrap
// (Tools/gauntlet/harness/performance-surface.mjs).
TRIALS: 100
BOOTSTRAP_RESAMPLES: 10000
BOOTSTRAP_SEED: 2977
BOOTSTRAP_LOWER_RANK: 250
BOOTSTRAP_UPPER_RANK: 9750

Row: struct { surface_source: String, plain_source: String, expected_output: String, memory_evidence_file: String }
Ran: struct { code: Int, output: String, errors: String }
Counted: struct { allocations: Int, reads: Int, allocations_per_read: Float, peak_live_heap_bytes: Int }
Interval: struct { lower: Float, upper: Float }

fail: fn(message: String) -[Exec, IO]> Never { process.fail(1, "memory: {message}") }

argument: fn(argv: [String], name: String, fallback: String) -> String {
    loop at in 0..<argv.len() {
        if argv[at] == name -> return if at + 1 < argv.len() -> argv[at + 1].copy() else -> fallback.copy()
    }
    fallback.copy()
}

run_program: fn(argv: [String], cwd: String) -> Ran {
    timeout: Duration.seconds(300) ?? fail("no 300 s duration")
    spec := process.cmd(argv).stdout(.Capture).stderr(.Capture).timeout(timeout)
    if cwd != "" -> spec = spec.cwd(cwd)
    receipt: spec.run() ?? fail("{argv.join(" ")}: {err}")
    Ran{code: if receipt.success -> 0 else -> if receipt.code == 0 -> -1 else -> receipt.code, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String {
    if field(tree, name) == .Text(value) -> return value.copy()
    fail("the {PAIR} row has no text `{name}`")
}

pair_row: fn(repo: String) -> Row {
    text: files.read(files.join(repo, MANIFEST)) ?? fail("{MANIFEST}: {err}")
    tree: json.parse(text) ?? fail("{MANIFEST}: {err}")
    if field(field(tree, "performance_surface_pairs"), "pairs") == .Array(rows) {
        loop row in rows {
            if field(row, "id") == .Text(id) && id == PAIR {
                return Row{
                    surface_source: text_field(row, "surface_source"),
                    plain_source: text_field(row, "plain_source"),
                    expected_output: text_field(row, "expected_output"),
                    memory_evidence_file: text_field(row, "memory_evidence_file"),
                }
            }
        }
    }
    fail("{PAIR} has no row in {MANIFEST}")
}

// One arm's source as main.jet in a fresh directory. A counted build adds
// `allocator`, the counting allocator line, to the source's own package
// block; a plain build passes "".
build: fn(jet: String, source: String, dir: String, allocator: String) -> String {
    files.create_dir_all(dir) ?? fail("{dir}: {err}")
    lines := [String]{}
    placed := allocator == ""
    loop line in source.split("\n").to_list() {
        lines.push(line.copy())
        if !placed && line == "package: {{" {
            lines.push(allocator.copy())
            placed = true
        }
    }
    if !placed -> fail("the pair source has no `package: {{` line to take the counting allocator")
    files.write(files.join(dir, "main.jet"), lines.join("\n")) ?? fail("{dir}/main.jet: {err}")
    out: files.join(dir, "out")
    built: run_program([String]{jet, "build", "--optimize=full", "--quiet", "--output-dir={out}", "main.jet"}, dir)
    binary: files.join(out, "main")
    if built.code != 0 || !files.exists(binary) -> fail("build {dir} failed:\n{built.output}{built.errors}")
    binary
}

// The digits `text` starts with and what follows them, None without any.
leading_number: fn(text: String) -> (value: Int, rest: String)? {
    bytes: text.bytes()
    digits := 0
    loop digits < bytes.len() && bytes[digits] >= (U8{48}) && bytes[digits] <= (U8{57}) -> digits += 1
    if digits == 0 -> return None
    value: Int.parse(text.slice(0, digits)) ?? return None
    Val((value: value, rest: text.slice(digits, text.len())))
}

// The number right after the first `name` that has one.
number_after: fn(text: String, name: String) -> Int? {
    parts: text.split(name).to_list()
    loop part in parts.slice(1, parts.len()) {
        if leading_number(part) == .Val(found) -> return Val(found.value)
    }
    None
}

// The first `ALLOCATOR-FACTS mode=M allocations=A high_water=H` line's
// numbers.
allocator_facts: fn(text: String) -> [Int]? {
    parts: text.split("ALLOCATOR-FACTS mode=").to_list()
    loop part in parts.slice(1, parts.len()) {
        mode: leading_number(part) ?? next
        if !mode.rest.starts_with(" allocations=") -> next
        allocations: leading_number(mode.rest.slice(13, mode.rest.len())) ?? next
        if !allocations.rest.starts_with(" high_water=") -> next
        high_water: leading_number(allocations.rest.slice(12, allocations.rest.len())) ?? next
        return Val([Int]{mode.value, allocations.value, high_water.value})
    }
    None
}

// The counting policy's own facts, read by gdb at exit_group: the program's
// image keeps no fact export, so the script finds the allocator root through
// jet_rt_alloc_init's first instruction (`lea <root>(%rip)`) and reads the
// words Alloc.jet lays out there: mode144, allocations160, high-water184.
facts_script: fn() -> String {
    [String]{
        "import gdb, re",
        "line = gdb.execute(\"x/1i jet_rt_alloc_init\", to_string=True)",
        "found = re.search(r\"lea\\s+0x[0-9a-f]+\\(%rip\\),%\\w+\\s+# (0x[0-9a-f]+)\", line)",
        "if not found:",
        "    raise gdb.GdbError(\"jet_rt_alloc_init does not start with the root lea: \" + line)",
        "memory = gdb.selected_inferior()",
        "word = lambda at: int.from_bytes(bytes(memory.read_memory(at, 8)), \"little\", signed=True)",
        "root = word(int(found.group(1), 16))",
        "print(\"ALLOCATOR-FACTS mode=%d allocations=%d high_water=%d\" % (word(root + 144), word(root + 160), word(root + 184)))",
        "",
    }.join("\n")
}

counted_run: fn(gdb: String, binary: String, scratch: String, label: String) -> Counted {
    err_file: files.join(scratch, "{label}.err")
    script: files.join(scratch, "facts.py")
    files.write(script, facts_script()) ?? fail("{script}: {err}")
    result: run_program([String]{
        gdb, "-q", "-batch",
        "-ex", "set pagination off",
        "-ex", "catch syscall exit_group",
        "-ex", "run 2>{err_file}",
        "-x", script,
        binary,
    }, "")
    facts: allocator_facts(result.output) ?? [Int]{}
    if facts.len() != 3 || facts[0] != 1 -> fail("no counting-policy facts from gdb:\n{result.output}{result.errors}")
    errors: files.read(err_file) ?? fail("{err_file}: {err}")
    reads: number_after(errors, "reads=") ?? fail("no reads= line in stderr: {errors}")
    Counted{allocations: facts[1], reads, allocations_per_read: Float.from_int(facts[1]) / Float.from_int(reads), peak_live_heap_bytes: facts[2]}
}

peak_rss: fn(repo: String, binary: String, expected: String) -> Int {
    result: run_program([String]{"python3", files.join(repo, TIMER), "--", binary}, "")
    lines: result.output.trim().split("\n").to_list()
    sample: json.parse(lines[lines.len() - 1]) ?? fail("{binary}: the timer printed no sample: {err}")
    if int_field(sample, "exit_code") != Val(0) -> fail("{binary} exited {json.dumps(field(sample, "exit_code")) ?? "?"}")
    direct: run_program([String]{binary}, "")
    if direct.output != expected -> fail("{binary} printed {json.dumps(Dyn.Text(direct.output.copy())) ?? "?"}")
    int_field(sample, "peak_rss_kb") ?? fail("{binary}: the timer sample has no peak_rss_kb")
}

// The upper middle value, as the shared harness takes it.
median: fn(values: [Float]) -> Float {
    ordered := values.copy()
    ordered.sort()
    ordered[ordered.len() /% 2]
}

// The shared harness's paired index bootstrap of median(surface) /
// median(plain): a 32-bit linear congruential draw seeded with
// BOOTSTRAP_SEED picks each resample's indices; the bounds are nearest ranks.
paired_bootstrap: fn(surface: [Float], plain: [Float]) -> Interval {
    state := BOOTSTRAP_SEED
    ratios := [Float]{}
    picked_surface := [Float]{}
    picked_plain := [Float]{}
    loop _ in 0..<BOOTSTRAP_RESAMPLES {
        picked_surface.clear()
        picked_plain.clear()
        loop _ in 0..<surface.len() {
            state = (state * 1664525 + 1013904223) %% 4294967296
            selected: Int.from_float(math.floor(Float.from_int(state) / 4294967296.0 * Float.from_int(surface.len()))) ?? 0
            picked_surface.push(surface[selected])
            picked_plain.push(plain[selected])
        }
        ratios.push(median(picked_surface) / median(picked_plain))
    }
    ratios.sort()
    Interval{lower: ratios[BOOTSTRAP_LOWER_RANK - 1], upper: ratios[BOOTSTRAP_UPPER_RANK - 1]}
}

classify_verdict: fn(ratio: Float, interval: Interval) -> String {
    if !math.is_finite(ratio) || !math.is_finite(interval.lower) || !math.is_finite(interval.upper) -> return "unavailable"
    if ratio < 1.0 && interval.upper < 1.0 -> return "win"
    if ratio >= 1.0 || interval.lower >= 1.0 -> return "loss"
    "inconclusive"
}

// A Float as JSON writes it: whole values without a fraction, non-finite
// ones as null.
number: fn(value: Float) -> Dyn {
    if !math.is_finite(value) -> return Dyn.Null
    if math.abs(math.fract(value)) > 0.0 || math.abs(value) >= 9007199254740992.0 -> return Dyn.Float(value)
    Dyn.Int(Int.from_float(value) ?? 0)
}

// A JSON integer: parsed JSON holds numbers as their lexemes.
int_field: fn(tree: Dyn, name: String) -> Int? {
    if field(tree, name) == {
        .Int(value) -> Val(value)
        .Number(lexeme) -> Val(Int.parse(lexeme) ?? return None)
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> None
    }
}

ints: fn(values: [Int]) -> Dyn { Dyn.Array(values.map(value -> Dyn.Int(value))) }

counted_dyn: fn(samples: [Counted]) -> Dyn {
    Dyn.Array(samples.map(sample -> Dyn.Object([String: Dyn]{
        "allocations": Dyn.Int(sample.allocations),
        "reads": Dyn.Int(sample.reads),
        "allocations_per_read": number(sample.allocations_per_read),
        "peak_live_heap_bytes": Dyn.Int(sample.peak_live_heap_bytes),
    })))
}

sha256: fn(text: String) -> String { crypto.sha256(text.bytes()).hex() }

cpu_model: fn() -> Dyn {
    info: files.read("/proc/cpuinfo") ?? return Dyn.Null
    loop line in info.split("\n").to_list() {
        parts: line.partition(":")
        if parts.head.trim() == "model name" -> return Dyn.Text(parts.tail.trim())
    }
    Dyn.Null
}

measure: fn(repo: String, argv: [String]) -> Dyn {
    jet: files.absolute(argument(argv, "--artifact", process.env_get_or("JET", "jet"))) ?? fail("--artifact: {err}")
    gdb: argument(argv, "--gdb", "gdb")
    row: pair_row(repo)
    root: argument(argv, "--scratch", sys.temp_dir())
    scratch: files.join(root, "read-into-memory-{process.current_pid()}")
    files.create_dir_all(scratch) ?? fail("{scratch}: {err}")
    surface_plain: build(jet, row.surface_source, files.join(scratch, "surface"), "")
    plain_plain: build(jet, row.plain_source, files.join(scratch, "plain"), "")
    surface_counted: build(jet, row.surface_source, files.join(scratch, "surface-counted"), COUNTING)
    plain_counted: build(jet, row.plain_source, files.join(scratch, "plain-counted"), COUNTING)
    surface_facts := [Counted]{}
    plain_facts := [Counted]{}
    loop index in 0..<COUNTED_RUNS -> surface_facts.push(counted_run(gdb, surface_counted, scratch, "surface-{index}"))
    loop index in 0..<COUNTED_RUNS -> plain_facts.push(counted_run(gdb, plain_counted, scratch, "plain-{index}"))
    surface_rss := [Int]{}
    plain_rss := [Int]{}
    // Alternate which arm runs first, surface first on even trials.
    loop index in 0..<TRIALS {
        loop arm in if index %% 2 == 0 -> [Int]{0, 1} else -> [Int]{1, 0} {
            if arm == 0 -> surface_rss.push(peak_rss(repo, surface_plain, row.expected_output)) else -> plain_rss.push(peak_rss(repo, plain_plain, row.expected_output))
        }
    }
    files.remove_all(scratch) ?? ()
    per_read_surface: median(surface_facts.map(sample -> sample.allocations_per_read))
    per_read_plain: median(plain_facts.map(sample -> sample.allocations_per_read))
    heap_surface: median(surface_facts.map(sample -> Float.from_int(sample.peak_live_heap_bytes)))
    heap_plain: median(plain_facts.map(sample -> Float.from_int(sample.peak_live_heap_bytes)))
    rss_surface: surface_rss.map(kb -> Float.from_int(kb))
    rss_plain: plain_rss.map(kb -> Float.from_int(kb))
    peak_surface: median(rss_surface)
    peak_plain: median(rss_plain)
    // The harness's rule: only strictly below plain is a win. The counts are
    // exact, so they compare directly; RSS is sampled at page resolution, so
    // it is judged like wall time, on its paired runs' bootstrap interval.
    strict: (surface: Float, plain: Float) -> if surface < plain -> "win" else -> "loss"
    ratio: peak_surface / peak_plain
    interval: paired_bootstrap(rss_surface, rss_plain)
    artifact: files.read_bytes(jet) ?? fail("{jet}: {err}")
    Dyn.Object([String: Dyn]{
        "schema": Dyn.Text("jet.gauntlet.performance-surface-memory.v1"),
        "id": Dyn.Text(PAIR),
        "surface_source_sha256": Dyn.Text(sha256(row.surface_source)),
        "plain_source_sha256": Dyn.Text(sha256(row.plain_source)),
        "expected_output": Dyn.Text(row.expected_output.copy()),
        "target": Dyn.Text("jet build --optimize=full"),
        "artifact_sha256": Dyn.Text(crypto.sha256(artifact).hex()),
        "host": Dyn.Object([String: Dyn]{
            "platform": Dyn.Text(sys.name()),
            "release": Dyn.Text(sys.release()),
            "arch": Dyn.Text(sys.arch()),
            "cpu_model": cpu_model(),
            "cpu_count": Dyn.Int(sys.cpu_count()),
        }),
        "generated_command": Dyn.Text("jet Tools/perf/read-into/Memory.jet --artifact <jet> --gdb <gdb> --write"),
        "counting_policy": Dyn.Text("mem.Counting.over(mem.Heap, cap: 2.gb) in each arm's package block; facts read at exit_group"),
        "counted_runs": Dyn.Object([String: Dyn]{"surface": counted_dyn(surface_facts), "plain": counted_dyn(plain_facts)}),
        "rss_runs": Dyn.Int(TRIALS),
        "surface_allocations_per_read": number(per_read_surface),
        "plain_allocations_per_read": number(per_read_plain),
        "surface_peak_live_heap_bytes": number(heap_surface),
        "plain_peak_live_heap_bytes": number(heap_plain),
        "surface_peak_rss_kb": number(peak_surface),
        "plain_peak_rss_kb": number(peak_plain),
        "peak_rss_ratio": number(ratio),
        "peak_rss_ratio_lower95": number(interval.lower),
        "peak_rss_ratio_upper95": number(interval.upper),
        "surface_rss_kb": ints(surface_rss),
        "plain_rss_kb": ints(plain_rss),
        "metric_verdicts": Dyn.Object([String: Dyn]{
            "allocations_per_read": Dyn.Text(strict(per_read_surface, per_read_plain)),
            "peak_live_heap_bytes": Dyn.Text(strict(heap_surface, heap_plain)),
            "peak_rss_kb": Dyn.Text(classify_verdict(ratio, interval)),
        }),
    })
}

run: fn() {
    script: sys.executable()
    if !script.ends_with(TOOL) -> fail("run this file from its place in the checkout ({TOOL})")
    repo: script.removesuffix(TOOL)
    argv: process.args()
    result: measure(repo, argv)
    if argv.contains("--write") {
        path: files.join(repo, pair_row(repo).memory_evidence_file)
        files.write(path, "{json.to_string_pretty(result) ?? fail("the evidence: {err}")}\n") ?? fail("{path}: {err}")
    }
    // The summary leaves out the per-run vectors the evidence file keeps; it
    // is laid out as the evidence is, each kept member indented one level.
    members := [String]{}
    if result == .Object(entries) {
        loop entry in entries {
            if entry.key == "counted_runs" || entry.key == "surface_rss_kb" || entry.key == "plain_rss_kb" -> next
            value: json.to_string_pretty(entry.value) ?? fail("the summary: {err}")
            members.push("  {json.dumps(Dyn.Text(entry.key.copy())) ?? fail("the summary: {err}")}: {value.replace("\n", "\n  ")}")
        }
    }
    print("{{\n{members.join(",\n")}\n}}")
}
