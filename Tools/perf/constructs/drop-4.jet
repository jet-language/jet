use _scope: core.mem.scope

#Error
Fail: enum {
    Bad
}

with_guards: fn(succeed: Bool) -> Int Fail! {
    _g1: _scope.guard(() -> print("guard 1 runs"))
    _g2: _scope.guard(() -> print("guard 2 runs"))
    _g3: _scope.guard(() -> print("guard 3 runs"))
    _g4: _scope.guard(() -> print("guard 4 runs"))
    _g5: _scope.guard(() -> print("guard 5 runs"))
    _g6: _scope.guard(() -> print("guard 6 runs"))
    _g7: _scope.guard(() -> print("guard 7 runs"))
    _g8: _scope.guard(() -> print("guard 8 runs"))
    if succeed -> return Ok(42)
    return Err(Fail.Bad)
}

question_path: fn() -> Int Fail! {
    _cleanup: _scope.guard(() -> print("cleanup before ?"))
    n: with_guards(false)
    return Ok(n)
}

run: fn() {
    r1: with_guards(true) ?? 0
    print(r1)
    r2: question_path() ?? -1
    print(r2)
}
