join: fn(prefix: String, parts: ...String) -> String { [prefix, ...parts].join(" ") }

forward: fn(prefix: String, parts: ...String) -> String { join(prefix, ...parts) }
forward_twice: fn(prefix: String, parts: ...String) -> String { forward(prefix, ...parts) }
forward_thrice: fn(prefix: String, parts: ...String) -> String { forward_twice(prefix, ...parts) }

run: fn() {
    print(forward_thrice("v", "a", "b", "c", "d"))
}
