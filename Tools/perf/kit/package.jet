// The Tools/perf twins' shared library. Number.jet holds JavaScript number
// text and parsing, Dyn.jet reads JSON values the way JavaScript reads them,
// and Json.jet writes JSON.stringify's text. A twin that uses it is a
// `<name>/run.jet` whose leading `package: { … }` block declares
// `jet_perf_kit: <path to Tools/perf/kit>` and imports the names it needs with
// `use jet_perf_kit.[…]`. The CLI reads an inline block's dependencies only
// from `run.jet`, so a twin that needs the kit is a directory.
name: "jet_perf_kit"
version: "0.0.1"
edition: "2026"
