// The name Node gives a child's terminating signal (`result.signal`), by
// its Linux number.
SIGNAL_NAMES: [String]{
    "SIGHUP", "SIGINT", "SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE",
    "SIGKILL", "SIGUSR1", "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM", "SIGTERM", "SIGSTKFLT",
    "SIGCHLD", "SIGCONT", "SIGSTOP", "SIGTSTP", "SIGTTIN", "SIGTTOU", "SIGURG", "SIGXCPU",
    "SIGXFSZ", "SIGVTALRM", "SIGPROF", "SIGWINCH", "SIGIO", "SIGPWR", "SIGSYS",
}

signal_name: fn(number: Int) -> String Never! {
    if number >= 1 && number <= SIGNAL_NAMES.len() -> return SIGNAL_NAMES[number - 1].copy()  // copy: the table keeps its names
    "SIG{number}"
}

#Test("signal names follow Linux numbering") {
    assert_eq(signal_name(9), "SIGKILL")
    assert_eq(signal_name(15), "SIGTERM")
    assert_eq(signal_name(31), "SIGSYS")
}
