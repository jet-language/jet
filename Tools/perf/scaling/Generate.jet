// Writes one package of the compiler scaling family (Corpora.jet) or the
// `mixed` profile (Mixed.jet) into a new directory and prints one JSON line
// describing it; the twin of generate.mjs.
//
// Usage: jet Tools/perf/scaling/Generate.jet SHAPE N [--seed S] NEW_DIRECTORY
//        jet Tools/perf/scaling/Generate.jet mixed --code-lines N --seed S NEW_DIRECTORY
//        jet Tools/perf/scaling/Generate.jet --list
// A problem goes to stderr with exit 2.
use {
    corpora: "Corpora"
    files: core.files
    mixed: "Mixed"
    process: core.process
    term: core.term
}

QUOTE: U8{34}
BACKSLASH: U8{92}
SPACE: U8{32}
HEX: "0123456789abcdef"

usage: fn() -> String {
    lines: [String]{
        "Usage: jet Tools/perf/scaling/Generate.jet SHAPE N [--seed S] NEW_DIRECTORY",
        "       jet Tools/perf/scaling/Generate.jet mixed --code-lines N --seed S NEW_DIRECTORY",
        "       jet Tools/perf/scaling/Generate.jet --list",
        "N is the stress dimension for stress shapes and code lines for domain shapes.",
        "Shapes: {corpora.shape_names()}",
        "Both forms print one JSON line describing the written package.",
    }
    lines.join("\n")
}

fail: fn(message: String) -[Exec, IO]> Never {
    term.eprint(message)
    process.exit(2)
}

is_count: fn(text: String) -> Bool { text != "" && text.bytes().all(byte -> byte >= U8{48} && byte <= U8{57}) }

count_of: fn(text: String) -[Exec, IO]> Int { Int.parse(text) ?? fail("{text} is too large\n{usage()}") }

// The value after each flag of `names` (the last one wins) and the other
// arguments, in order.
Flags: struct {
    values: [String:Int]
    rest: [String]
}

numeric_flags: fn(args: [String], names: [String]) -[Exec, IO]> Flags {
    values := [String:Int]{}
    rest := [String]{}
    i := 0
    loop i < args.len() {
        arg: args[i]
        if !names.contains(arg) {
            // copy: the rest outlives the arguments' borrow
            rest.push(arg.copy())
            i += 1
            next
        }
        if i + 1 >= args.len() || !is_count(args[i + 1]) -> fail("{arg} needs a nonnegative integer\n{usage()}")
        values[arg] = count_of(args[i + 1])
        i += 2
    }
    Flags{values: values, rest: rest}
}

// `text` as a JSON string, escaped the way JSON.stringify escapes it.
quoted: fn(text: String) -> String {
    hex: HEX.bytes()
    out := [U8]{QUOTE}
    loop byte in text.bytes() {
        code: Int{byte}
        control: if code == {
            8 -> "\\b"
            9 -> "\\t"
            10 -> "\\n"
            12 -> "\\f"
            13 -> "\\r"
            else -> "\\u00{String.from_bytes_lossy([hex[code /% 16], hex[code % 16]])}"
        }
        escape: if byte == QUOTE || byte == BACKSLASH -> "\\{String.from_bytes_lossy([byte])}" else -> if byte >= SPACE -> "" else -> control
        if escape == "" -> out.push(byte) else -> out.extend(escape.bytes())
    }
    out.push(QUOTE)
    String.from_bytes_lossy(out)
}

// Writes the package into a new directory and returns its entry.
write_files: fn(package: [String:String], directory: String) -[Exec, FS, IO, Env]> String {
    files.create_dir_all(directory) ?? fail("{err}")
    // Refuse to leave stale module files when regenerating a smaller workload.
    loop (name, _) in package {
        path: files.join(directory, name)
        if files.exists(path) -> fail("Output already exists: {path}")
    }
    loop (name, text) in package {
        path: files.join(directory, name)
        files.create_dir_all(files.dirname(path)) ?? fail("{err}")
        files.write(path, text) ?? fail("{err}")
    }
    files.absolute(files.join(directory, "main.jet")) ?? fail("{err}")
}

list: fn() {
    loop shape in corpora.shapes() {
        kind: if shape.kind == .Stress -> "stress" else -> "domain"
        unit: if shape.kind == .Stress -> "n" else -> "lines"
        print("{shape.name.pad_end(14, " ")} {kind.pad_end(7, " ")} base {"{shape.base}".pad_start(7, " ")} {unit}: {shape.dimension}")
    }
}

// One corpus of the scaling family: entry, digest, expected diagnostics and
// code lines.
generate: fn(args: [String], name: String) -[Exec, FS, IO, Env]> {
    flags: numeric_flags(args, ["--seed"])
    if flags.rest.len() != 2 || !is_count(flags.rest[0]) -> fail(usage())
    n: count_of(flags.rest[0])
    seed: flags.values.get("--seed") ?? 1
    shape: corpora.shape_of(name, n) ?? fail(err.message)
    built: corpora.corpus(shape, n, seed)
    entry: write_files(built.files, flags.rest[1])
    kind: if built.kind == .Stress -> "stress" else -> "domain"
    print("{{\"entry\":{quoted(entry)},\"shape\":{quoted(name)},\"n\":{n},\"seed\":{seed},\"kind\":\"{kind}\",\"code_lines\":{built.code_lines},\"files\":{built.files.len()},\"expect\":{{\"diagnostics\":{built.diagnostics}}},\"source_sha256\":\"{built.source_sha256}\"}}")
}

// The `mixed` profile: the entry, the package digest, the expected stdout
// and the shape statistics.
generate_mixed: fn(args: [String]) -[Exec, FS, IO, Env]> {
    flags: numeric_flags(args, ["--code-lines", "--seed"])
    code_lines: flags.values.get("--code-lines") ?? fail(usage())
    seed: flags.values.get("--seed") ?? fail(usage())
    if flags.rest.len() != 1 -> fail(usage())
    mixed.check_inputs(code_lines, seed) ?? fail(err.message)
    built: mixed.mixed_sources(code_lines, seed)
    entry: write_files(built.files, flags.rest[0])
    stats: built.stats
    shape: "\"physical_lines\":{built.physical_lines},\"code_lines\":{built.code_lines},\"bytes\":{built.bytes},\"functions\":{stats.functions},\"types\":{stats.types},\"comptime_items\":{stats.comptime_items},\"sections\":{stats.sections}"
    print("{{\"entry\":{quoted(entry)},\"source_sha256\":\"{built.source_sha256}\",\"expected\":{quoted(built.expected)},\"stats\":{{{shape}}}}}")
}

run: fn() {
    argv: process.args()
    first: if argv.len() > 0 -> argv[0] else -> ""
    rest: if argv.len() > 0 -> argv.slice(1, argv.len()) else -> [String]{}
    if first == "--list" -> return list()
    if first == "mixed" -> return generate_mixed(rest)
    // With no arguments the shape is missing, and so are N and the directory.
    if argv.len() == 0 -> fail(usage())
    generate(rest, first)
}
