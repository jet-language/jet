// The compiler scaling gate's Markdown report (Tower #4601), the twin of
// report.mjs's `report`, shared by the report command
// (Tools/perf/scaling/report) and the run-gate twin: Report.jet. Its own
// package, apart from jet_scaling_gate, so the report command takes only the
// report; the twins import it with `use jet_scaling_reports.[report]`.
name: "jet_scaling_reports"
version: "0.0.1"
edition: "2026"
