// Corpus family of the compiler scaling gate (Tower #4601); the twin of
// corpora.mjs.
//
// Every shape writes one plain, idiomatic Jet package that neither compiler
// was tuned for. A *stress* shape grows exactly one dimension with N (files,
// functions, statements per function, nesting depth, enum width, impls,
// instantiations, comptime items, table rows, imports, call depth, fallible
// functions, diagnostics, string holes, call sites); everything else stays
// fixed or grows only as the consumer code that keeps the new items live.
// A *domain* shape (Domains.jet) is a realistic program of one kind (web
// service, game, CLI, data analysis, GUI, embedded, compiler, scientific,
// generic library, generated code) sized by code lines.
//
// Adding a shape: write its builder `(n, r) -> files` (or a domain in
// Domains.jet) and register it in `shapes` with its dimension, default base
// and builder. `files` maps package-relative paths to
// text; the package's `run: fn()` must reach every generated function, so no
// phase can skip work as dead code. The diagnostics shape alone expects
// errors: n, the number a correct compiler reports.
//
// Both compilers build these packages: one package, one flat namespace across
// its files (E0624 forbids the same top-level name in two files), no path
// dependencies (the bootstrap runner authorizes one source root), no bounded
// trait method calls through a type parameter and no mutation inside `comptime`
// (both unsupported by the generated compiler today).

use {
    combinatorics: core.math.combinatorics
}

// ---------------------------------------------------------------- stress

modules: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    entries := [String]{}
    loop i in 0..<n {
        a: r.int(3, 97)
        b: r.int(2, 31)
        files["modules/part_{i}.jet"] = """
            Record{i}: struct {{
                id: Int
                weight: Int
            }}

            record_{i}_make: fn(seed: Int) -> Record{i} {{ Record{i}{{id: seed % 97, weight: (seed * {a}) % 89}} }}

            record_{i}_score: fn(seed: Int) -> Int {{
                record: record_{i}_make(seed)
                (record.id * {b} + record.weight) % {M}
            }}

            """
        entries.push("record_{i}_score")
    }
    roots: consumer_tree(files, entries, "modules")
    finish("modules", files, roots)
    files
}

small_body: fn(i: Int, a: Int, b: Int) -> String {
    bodies: [String]{
        "helper_{i}: fn(x: Int) -> Int {{ (x * {a} + {b}) % {M} }}",
        """
            helper_{i}: fn(x: Int) -> Int {{
                if x % {a} == 0 -> return x /% {a}
                x + {b}
            }}
            """,
        """
            helper_{i}: fn(x: Int) -> Int {{
                label: "h{i}-{{x % {a}}}"
                label.len() + {b}
            }}
            """,
        """
            helper_{i}: fn(x: Int) -> Int {{
                total := 0
                loop k in 0..<{a % 4 + 1} -> total += x + k * {b}
                total % {M}
            }}
            """,
    }
    bodies[i % 4]
}

small_fns: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    per_file: (n + 15) /% 16
    items := [String]{}
    entries := [String]{}
    loop i in 0..<n {
        a: r.int(2, 97)
        items.push(small_body(i, a, r.int(1, 63)))
        entries.push("helper_{i}")
    }
    loop k in 0..<16 -> files["fns/fns_{k}.jet"] = items.slice(min(n, k * per_file), min(n, (k + 1) * per_file)).join("\n\n")
    roots: consumer_tree(files, entries, "small")
    finish("small_fns", files, roots)
    files
}

// Four functions of n/4 statements each: straight-line updates, branches and
// a growing set of locals that later statements read.
huge_fns: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    entries := [String]{}
    loop f in 0..<4 {
        body := [String]{"huge_{f}: fn(seed: Int) -> Int {{", "    acc := seed % {M}"}
        locals := [String]{}
        loop s in 0..<(n + 3) /% 4 {
            c: r.int(1, 997)
            body.push(if s % 5 == {
                0 -> "    acc = (acc * 31 + {c}) % {M}"
                1 -> "    if acc % {r.int(2, 13)} == 0 -> acc = (acc + {c}) % {M}"
                2 -> {
                    locals.push("t{s}")
                    "    t{s}: (acc + {c}) % 1009"
                }
                3 -> {
                    held: if locals.len() > 0 -> r.pick(locals) else -> "{c}"
                    "    acc = (acc + {held} * {r.int(2, 9)}) % {M}"
                }
                else -> "    acc = if acc > {c * 1000} -> acc - {c} else -> acc + {c}"
            })
        }
        body.extend(["    acc", "}}", ""])
        files["huge/huge_{f}.jet"] = body.join("\n")
        entries.push("huge_{f}")
    }
    finish("huge_fns", files, entries)
    files
}

// Nesting depth n: statement blocks (if / loop / value-if) and one
// parenthesized expression, each n deep, in four functions.
deep_nesting: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    body := [String]{}
    loop f in 0..<3 {
        body.extend(["nested_{f}: fn(seed: Int) -> Int {{", "    acc := seed % {M}"])
        indent := "    "
        loop d in 0..<n {
            kind: (d + f) % 3
            body.push(if kind == {
                0 -> "{indent}if acc % {r.int(2, 7)} != {r.int(7, 9)} {{"
                1 -> "{indent}loop k{d} in 0..<1 {{"
                else -> "{indent}if acc >= 0 {{"
            })
            indent = "{indent}    "
            counter: if kind == 1 -> "k{d} + " else -> ""
            body.push("{indent}acc = (acc * 3 + {counter}{r.int(1, 99)}) % {M}")
        }
        loop _ in 0..<n {
            indent = indent.removesuffix("    ")
            body.push("{indent}}}")
        }
        body.extend(["    acc", "}}", ""])
    }
    body.extend(["nested_expr: fn(seed: Int) -> Int {{ {"(1 + ".repeat(n)}seed{")".repeat(n)} % {M} }}", ""])
    files["nested.jet"] = body.join("\n")
    finish("deep_nesting", files, ["nested_0", "nested_1", "nested_2", "nested_expr"])
    files
}

// One enum of n variants and four n-arm tables over it.
wide_enums: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    kinds: ["Plain", "Count", "Span", "Named"]
    decl := [String]{"Opcode: enum {{"}
    loop i in 0..<n {
        v: "{kinds[i % 4]}{i}"
        decl.push(["    {v}", "    {v}(Int)", "    {v}(start: Int, width: Int)", "    {v}(String)"][i % 4])
    }
    decl.extend(["}}", ""])
    cost := [String]{"opcode_cost: fn(op: Opcode) -> Int {{", "    if op == {{"}
    name := [String]{"opcode_name: fn(op: Opcode) -> String {{", "    if op == {{"}
    from := [String]{"opcode_from_code: fn(code: Int) -> Opcode {{", "    if code == {{"}
    keyword := [String]{"keyword_code: fn(text: String) -> Int {{", "    if text == {{"}
    loop i in 0..<n {
        v: "{kinds[i % 4]}{i}"
        lower: "{kinds[i % 4].to_lower()}{i}"
        c: r.int(1, 97)
        // The cost, name and from-code arms of the variant.
        arms: [[String]]{
            ["        .{v} -> {c}", "        .{v} -> \"{lower}\"", "        {i} -> Opcode.{v}"],
            ["        .{v}(k) -> k * {c}", "        .{v}(_) -> \"{lower}\"", "        {i} -> Opcode.{v}({c})"],
            ["        .{v}(start, width) -> start + width * {c}", "        .{v}(_, _) -> \"{lower}\"", "        {i} -> Opcode.{v}{{start: {c}, width: {i % 7 + 1}}}"],
            ["        .{v}(text) -> text.len() + {c}", "        .{v}(_) -> \"{lower}\"", "        {i} -> Opcode.{v}(\"op{i}\")"],
        }
        arm: arms[i % 4]
        // copy: the tables own their lines
        cost.push(arm[0].copy())
        name.push(arm[1].copy())
        from.push(arm[2].copy())
        keyword.push("        \"{lower}\" -> {i}")
    }
    cost.extend(["    }}", "}}", ""])
    name.extend(["    }}", "}}", ""])
    from.extend(["        else -> Opcode.Plain0", "    }}", "}}", ""])
    keyword.extend(["        else -> 0", "    }}", "}}", ""])
    consumer: """
        opcode_total: fn(seed: Int) -> Int {{
            acc := seed % {M}
            loop code in 0..<{n} {{
                op: opcode_from_code(code)
                acc = (acc * 7 + opcode_cost(op) + keyword_code(opcode_name(op))) % {M}
            }}
            acc
        }}

        """
    files["opcodes.jet"] = "{decl.join("\n")}\n{cost.join("\n")}\n{name.join("\n")}\n{from.join("\n")}\n{keyword.join("\n")}\n{consumer}"
    finish("wide_enums", files, ["opcode_total"])
    files
}

// The traits' name, joined so that tests/guards/retirement_ratchet.jet does
// not read the retired authority word in this source; the generated text is
// corpora.mjs's.
trait_word: fn() -> String { "{"Capabil"}ity" }

// n types, n/8 traits (at least 4), four trait impls and one inherent impl
// per type, trait values consumed per trait.
impls_traits: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    trait_count: max(4, n /% 8)
    named: trait_word()
    traits := [[String]]{}
    loop k in 0..<trait_count {
        traits.push(lines("""
            {named}{k}: trait {{
                measure_{k}: fn(self) -> Int
                label_{k}: fn(self) -> String
            }}

            capability_{k}_total: fn(items: [{named}{k}]) -> Int {{
                total := 0
                loop item in items -> total = (total + item.measure_{k}() + item.label_{k}().len()) % {M}
                total
            }}
            """))
    }
    pack(files, "traits/traits", traits)
    types := [[String]]{}
    entries := [String]{}
    loop i in 0..<n {
        body := [String]{"Entity{i}: struct {{", "    id: Int", "    name: String", "}}", ""}
        chosen := [Int]{}
        loop j in 0..<4 {
            k: (i * 4 + j) % trait_count
            if chosen.contains(k) -> next
            chosen.push(k)
            measure: "    measure_{k}: fn(self) -> Int {{ (self.id * {r.int(2, 97)} + {r.int(1, 99)}) % {M} }}"
            body.extend([
                "impl Entity{i}.{named}{k} {{", measure, "    label_{k}: fn(self) -> String {{ \"e{i}-c{k}-{{self.name}}\" }}", "}}", "",
            ])
        }
        body.extend(lines("""
            impl Entity{i} {{
                bump: fn(&self) {{ self.id += {r.int(1, 9)} }}
                weight: fn(self) -> Int {{ self.id + self.name.len() }}
            }}

            entity_{i}_use: fn(seed: Int) -> Int {{
                entity := Entity{i}{{id: seed % 101, name: "n{{seed % 13}}"}}
                &entity.bump()
                total := entity.weight()
            """))
        loop k in chosen -> body.push("    total = (total + capability_{k}_total([{named}{k}]{{entity}})) % {M}")
        body.extend(["    total", "}}"])
        types.push(body)
        entries.push("entity_{i}_use")
    }
    pack(files, "types/entities", types)
    roots: consumer_tree(files, entries, "impls")
    finish("impls_traits", files, roots)
    files
}

// A fixed generic library instantiated with n distinct record types, all in
// the entry file: generic code outside the entry file does not compile today
// (Domains.jet explains the two compilers' errors).
generics: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    entries := [String]{}
    text := """
        Slot: struct<T> {{
            value: T
            mark: Int
        }}

        wrap: fn<T>(value: T, mark: Int) -> Slot<T> {{ Slot<T>{{value: value, mark: mark}} }}

        first_or: fn<T>(items: [T], fallback: T) -> T {{
            if items.len() > 0 -> return items[0]
            fallback
        }}

        count_where: fn<T>(items: [T], keep: fn(T) -> Bool) -> Int {{
            total := 0
            loop item in items {{
                if keep(item) -> total += 1
            }}
            total
        }}

        marks_of: fn<T>(slots: [Slot<T>]) -> Int {{
            total := 0
            loop slot in slots -> total += slot.mark
            total
        }}

        """
    loop i in 0..<n {
        a: r.int(2, 97)
        text = """
            {text}
            Thing{i}: struct {{
                id: Int
                weight: Int
            }}

            thing_{i}_use: fn(seed: Int) -> Int {{
                things: [Thing{i}]{{Thing{i}{{id: seed % 31, weight: {a}}}, Thing{i}{{id: seed % 17, weight: {a + 1}}}}}
                chosen: first_or(things, Thing{i}{{id: 0, weight: 0}})
                heavy: count_where(things, (thing) -> thing.weight > {a})
                slots: [Slot<Thing{i}>]{{wrap(chosen, {i % 64}), wrap(things[1], heavy)}}
                (chosen.id + heavy + marks_of(slots)) % {M}
            }}

            """
        entries.push("thing_{i}_use")
    }
    files["main.jet"] = text
    roots: consumer_tree(files, entries, "generics")
    finish("generics", files, roots)
    files
}

// n comptime constants (a third chained on the previous one) with n/2
// record types whose methods read them.
comptime_items: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    items := [[String]]{}
    entries := [String]{}
    loop i in 0..<n {
        a: r.int(3, 40)
        b: r.int(5, 90)
        limit: if i % 3 == 2 -> "LIMIT_{i}: comptime {{ LIMIT_{i - 1} * 2 + {b} }}" else -> "LIMIT_{i}: comptime {{ {a} * 7 + {b} }}"
        user: if i % 2 == {
            0 -> """
                Gauge{i}: struct {{
                    level: Int
                }}

                impl Gauge{i} {{
                    clamp: fn(self) -> Int {{ if self.level > LIMIT_{i} -> LIMIT_{i} else -> self.level }}
                }}

                gauge_{i}_use: fn(seed: Int) -> Int {{ Gauge{i}{{level: seed % 300}}.clamp() + LIMIT_{i} }}
                """
            else -> "limit_{i}_use: fn(seed: Int) -> Int {{ (seed + LIMIT_{i}) % {M} }}"
        }
        items.push(lines("{limit}\n\n{user}"))
        entries.push(if i % 2 == 0 -> "gauge_{i}_use" else -> "limit_{i}_use")
    }
    pack(files, "consts/consts", items)
    roots: consumer_tree(files, entries, "comptime")
    finish("comptime", files, roots)
    files
}

// n table elements: four Int tables, a record table and a string-keyed map,
// as functions returning literal tables, plus one long string literal.
data_tables: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    body := [String]{}
    quarter: max(16, n /% 4)
    loop k in 0..<4 {
        body.extend(["table_{k}: fn() -> [Int] {{", "    [Int]{{"])
        loop row in 0..<(quarter + 15) /% 16 {
            values := [String]{}
            loop _ in row * 16..<min(quarter, row * 16 + 16) -> values.push("{r.int(0, 99999)}")
            body.push("        {values.join(", ")},")
        }
        body.extend(["    }}", "}}", ""])
    }
    rows: max(8, n /% 8)
    body.extend(lines("""
        Row: struct {{
            id: Int
            weight: Int
            name: String
        }}

        row_table: fn() -> [Row] {{
            [Row]{{
        """))
    loop i in 0..<rows -> body.push("        Row{{id: {i}, weight: {r.int(0, 999)}, name: \"row-{i}\"}},")
    body.extend(["    }}", "}}", "", "name_table: fn() -> [String:Int] {{", "    [String:Int]{{"])
    loop i in 0..<rows -> body.push("        \"key-{i}\": {r.int(0, 999)},")
    body.extend(lines("""
            }}
        }}

        banner: fn() -> String {{ "{"abcdefgh".repeat(n)}" }}

        tables_total: fn(seed: Int) -> Int {{
            acc := seed % {M}
            loop k in 0..<4 {{
                table: if k == {{
                    0 -> table_0()
                    1 -> table_1()
                    2 -> table_2()
                    else -> table_3()
                }}
                loop value in table -> acc = (acc * 3 + value) % {M}
            }}
            loop row in row_table() -> acc = (acc + row.weight + row.name.len()) % {M}
            loop (key, value) in name_table() -> acc = (acc + key.len() * value) % {M}
            (acc + banner().len()) % {M}
        }}

        """))
    files["tables.jet"] = body.join("\n")
    finish("data_tables", files, ["tables_total"])
    files
}

// n files, each importing four Core modules. core.time is left out: the
// generated compiler rejects Core/Time today (E0312/E0109 on LocalDate
// comparisons).
imports: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    entries := [String]{}
    loop i in 0..<n {
        files["services/service_{i}.jet"] = """
            use math: core.math
            use text: core.text
            use collections: core.collections
            use term: core.term

            service_{i}_value: fn(seed: Int) -> Int {{ max(seed % 13, {r.int(1, 12)}) + math.abs_diff(seed, {r.int(1, 99)}) }}

            """
        entries.push("service_{i}_value")
    }
    roots: consumer_tree(files, entries, "imports")
    finish("imports", files, roots)
    files
}

// One call chain n deep across eight files.
call_chains: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    per_file: (n + 7) /% 8
    loop f in 0..<8 {
        body := [String]{}
        loop i in min(n, f * per_file)..<min(n, (f + 1) * per_file) {
            body.push(if i == n - 1 -> "chain_{i}: fn(x: Int) -> Int {{ x % {M} }}" else -> "chain_{i}: fn(x: Int) -> Int {{ (chain_{i + 1}((x * {r.int(2, 9)} + {r.int(1, 99)}) % {M}) + 1) % {M} }}")
            body.push("")
        }
        files["chain/chain_{f}.jet"] = body.join("\n")
    }
    finish("call_chains", files, ["chain_0"])
    files
}

// n fallible functions: typed error families (one per 16 functions),
// propagation, recovery by `??` and by result tables, inferred text errors.
errors: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    items := [[String]]{}
    entries := [String]{}
    loop i in 0..<n {
        k: i /% 16
        family: if i % 16 == 0 -> """
            #Error
            Fault{k}: enum {{
                Missing
                Invalid(Int)
                Overflow(limit: Int, seen: Int)
            }}

            fault_{k}_code: fn(fault: Fault{k}) -> Int {{
                if fault == {{
                    .Missing -> 1
                    .Invalid(value) -> value % 97
                    .Overflow(limit, seen) -> limit + seen
                }}
            }}


            """ else -> ""
        limit: r.int(50, 500)
        items.push(lines("""
            {family}parse_{i}: fn(x: Int) -> Int Fault{k}! {{
                if x == 0 -> return Err(Fault{k}.Missing)
                if x % {r.int(5, 17)} == 0 -> return Err(Fault{k}.Invalid(x))
                if x > {limit * 100} -> return Err(Fault{k}.Overflow{{limit: {limit}, seen: x}})
                Ok(x * 2)
            }}

            step_{i}: fn(x: Int) -> Int Fault{k}! {{
                first: parse_{i}(x)
                second: parse_{i}(first + 1)
                Ok(first + second)
            }}

            checked_{i}: fn(x: Int) -> Int {{
                if x < 0 -> return Err("negative input {i}")
                x % {M}
            }}

            recover_{i}: fn(seed: Int) -> Int {{
                quick: step_{i}(seed % 1000) ?? 0
                detailed: if step_{i}(seed % 77) == {{
                    .Ok(value) -> value
                    .Err(fault) -> fault_{k}_code(fault)
                }}
                (quick + detailed + (checked_{i}(seed) ?? 0)) % {M}
            }}
            """))
        entries.push("recover_{i}")
    }
    pack(files, "errors/errors", items)
    roots: consumer_tree(files, entries, "errors")
    finish("errors", files, roots)
    files
}

// n functions with one undefined name each: n diagnostics expected.
diagnostics: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    items := [[String]]{}
    entries := [String]{}
    loop i in 0..<n {
        items.push(["broken_{i}: fn(seed: Int) -> Int {{", "    base: seed * {r.int(2, 9)}", "    base + missing_value_{i}", "}}"])
        entries.push("broken_{i}")
    }
    pack(files, "broken/broken", items)
    roots: consumer_tree(files, entries, "diagnostics")
    finish("diagnostics", files, roots)
    files
}

// n interpolation holes and 64n literal bytes, in n/16 functions.
strings: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    items := [[String]]{}
    entries := [String]{}
    holes := ""
    loop h in 0..<16 -> holes = "{holes}part{h}={{x + {h}}} "
    literal: "lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do ".repeat(16)
    loop i in 0..<max(1, n /% 16) {
        items.push(lines("""
            text_{i}: fn(x: Int) -> Int {{
                line: "{holes}"
                literal: "{literal}"
                (line.len() + literal.len() + {r.int(1, 9)}) % {M}
            }}
            """))
        entries.push("text_{i}")
    }
    pack(files, "texts/texts", items)
    roots: consumer_tree(files, entries, "strings")
    finish("strings", files, roots)
    files
}

// n call sites into two shared helpers.
fan_in: fn(n: Int, r: &Seeded) -> [String:String] {
    files := [String:String]{}
    files["shared.jet"] = """
        shared_scale: fn(x: Int) -> Int {{ (x * 3 + 1) % 1000003 }}

        shared_label: fn(x: Int) -> Int {{ "v{{x % 100}}".len() }}

        """
    items := [[String]]{}
    entries := [String]{}
    loop g in 0..<(n + 31) /% 32 {
        body := [String]{"callers_{g}: fn(seed: Int) -> Int {{", "    acc := seed % {M}"}
        loop c in 0..<min(32, n - g * 32) {
            body.push(if c % 2 == 0 -> "    acc = (acc + shared_scale(acc + {r.int(1, 99)})) % {M}" else -> "    acc = (acc + shared_label(acc)) % {M}")
        }
        body.extend(["    acc", "}}"])
        items.push(body)
        entries.push("callers_{g}")
    }
    pack(files, "callers/callers", items)
    roots: consumer_tree(files, entries, "fan_in")
    finish("fan_in", files, roots)
    files
}

// ---------------------------------------------------------------- registry

ShapeKind: enum { Stress Domain }

// A registered shape; `make(n, seed)` writes its files at size `n`.
Shape: struct {
    name: String
    kind: ShapeKind
    dimension: String
    base: Int
    make: fn(Int, Int) -> [String:String] Err!
}

stress: fn(name: String, dimension: String, base: Int, make: &&fn(Int, Int) -> [String:String] Err!) -> Shape { Shape{name: name, kind: .Stress, dimension: dimension, base: base, make: make} }

shapes: fn() -> [Shape] {
    found := [Shape]{
        stress("modules", "files in one package", 128, (n, seed) -> modules(n, seeded(seed, .Scaled))),
        stress("small-fns", "small functions", 1024, (n, seed) -> small_fns(n, seeded(seed, .Scaled))),
        stress("huge-fns", "statements in four functions", 2048, (n, seed) -> huge_fns(n, seeded(seed, .Scaled))),
        stress("deep-nesting", "block and expression nesting depth", 16, (n, seed) -> deep_nesting(n, seeded(seed, .Scaled))),
        stress("wide-enums", "enum variants and arms per match table", 64, (n, seed) -> wide_enums(n, seeded(seed, .Scaled))),
        stress("impls-traits", "types with four trait impls each (traits = n/8)", 128, (n, seed) -> impls_traits(n, seeded(seed, .Scaled))),
        stress("generics", "distinct generic instantiations", 128, (n, seed) -> generics(n, seeded(seed, .Scaled))),
        stress("comptime", "comptime (prep) items with record types", 128, (n, seed) -> comptime_items(n, seeded(seed, .Scaled))),
        stress("data-tables", "literal table elements", 2048, (n, seed) -> data_tables(n, seeded(seed, .Scaled))),
        stress("imports", "files importing five Core modules", 128, (n, seed) -> imports(n, seeded(seed, .Scaled))),
        stress("call-chains", "call depth", 256, (n, seed) -> call_chains(n, seeded(seed, .Scaled))),
        stress("errors", "fallible functions with propagation and recovery", 128, (n, seed) -> errors(n, seeded(seed, .Scaled))),
        stress("diagnostics", "reported errors", 128, (n, seed) -> diagnostics(n, seeded(seed, .Scaled))),
        stress("strings", "interpolation holes (64 literal bytes each)", 1024, (n, seed) -> strings(n, seeded(seed, .Scaled))),
        stress("fan-in", "call sites into shared helpers", 1024, (n, seed) -> fan_in(n, seeded(seed, .Scaled))),
    }
    loop domain in all() {
        // copy: each shape owns the domain's name and dimension
        name: domain.name.copy()
        found.push(Shape{name: domain.name.copy(), kind: .Domain, dimension: domain.dimension.copy(), base: 125000, make: (n, seed) -> domain_files(name, n, seeded(seed, .Scaled))})
    }
    found
}

// copy: the joined names are built from owned strings
shape_names: fn() -> String { shapes().map(shape -> shape.name.copy()).join(", ") }

Corpus: struct {
    kind: ShapeKind
    files: [String:String]
    diagnostics: Int
    code_lines: Int
    source_sha256: String
}

// The registered shape `name`, when `n` is a valid size for it.
shape_of: fn(name: String, n: Int) -> Shape Err! {
    shape: shapes().find(shape -> shape.name == name) ?? return Err("Unknown shape: {name} (shapes: {shape_names()})")
    if n < 1 -> return Err("N must be a positive safe integer")
    Ok(shape)
}

// How a corpus lays out its package: `files` (as generated: many files, the
// realistic layout) or `single` (every file concatenated into main.jet, `use`
// lines hoisted and deduplicated). Both are gated: a compiler that only
// handles one file must fail the `files` series, not be excused from it.
layouts: fn() -> [String] { ["files", "single"] }

// The package of `shape` at size `n` (N for stress shapes, code lines for
// domain shapes) in `layout`: files, expected diagnostics, code lines and
// digest.
corpus: fn(shape: Shape, n: Int, seed: Int, layout: String) -> Corpus {
    generated: shape.make(n, seed)
    files: if layout == "single" -> single_file(generated) else -> generated
    diagnostics: if shape.name == "diagnostics" -> n else -> 0
    Corpus{kind: shape.kind, files: files, diagnostics: diagnostics, code_lines: code_lines(files), source_sha256: source_digest(files)}
}

// One package file: the other files in path order, then main.jet.
single_file: fn(files: [String:String]) -> [String:String] {
    // copy: the names are sorted apart from the map
    names := files.keys().filter(name -> !["package.jet", "main.jet"].contains(name)).map(name -> name.copy()).to_list()
    names.sort()
    names.push("main.jet")
    lines := [String]{}
    loop name in names -> lines.extend("// ---- {name}\n{files[name]}".split("\n").to_list())
    uses := combinatorics.unique(lines.filter(line -> line.starts_with("use ")))
    uses.push("")
    uses.extend(lines.filter(line -> !line.starts_with("use ")))
    single := [String:String]{}
    single["package.jet"] = files["package.jet"].copy()
    single["main.jet"] = "{uses.join("\n")}\n"
    single
}
