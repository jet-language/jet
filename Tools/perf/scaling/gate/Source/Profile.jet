// The responsible-code profile of one compile (Tower #4601), the twin of
// Tools/perf/scaling/profile.mjs's profileRun: BUILD_DIR/perf.data (recorded
// with a realtime clock and frame-pointer call graphs, `wrap`) through `perf
// script`, each sample assigned to the JET_TRACE_FILE phase span it falls in,
// and per phase the top self symbols and the top inclusive compiler functions,
// each resolved to its source: a Jet compiler function (generated compiler,
// `jetc0`) to its `Compiler/**.jet` line, a Rust symbol (`jet`) to its crate
// module file. Tools/perf/scaling/profile/run.jet prints it; Gate.jet stores it
// in a receipt.
use {
    files: core.files
    json: core.encoding.json
    math: core.math
    process: core.process
}

PERF_PINNED: "/nix/store/v5fs9a5z17j8pfd2kfxs44hv5p3yq6ap-perf-linux-7.0.11/bin/perf"
TOP: 12
// JSON never reads as Bytes, so this stands for JavaScript's `undefined`.
UNDEFINED: Dyn.Bytes([U8]{})

// `perf script` lines: a sample header `  <time>:` unless it is a frame line
// `  <address> <symbol>`. (A `Regex{…}` literal reads its backslashes as written.)
SAMPLE_LINE: Regex{"^\s*(\d+\.\d+):"}
FRAME_ADDRESS: Regex{"^\s+[0-9a-f]+\s"}
FRAME_LINE: Regex{"^\s+[0-9a-f]+\s+(.+)$"}
// Demangling drops the `+0x..` offset, the ` (dso)` suffix and the Rust `::h<hash>`.
FRAME_OFFSET: Regex{"\+0x[0-9a-f]+$"}
FRAME_DSO: Regex{" \(.*\)$"}
RUST_HASH: Regex{"::h[0-9a-f]{{16}}$"}
// The compiler's own code: a `jetc_*`/`jet_*` path, or a Jet compiler function name.
OWNED_PATH: Regex{"^<?(jetc_\w+|jet_\w+)::"}
OWNED_NAME: Regex{"^(sema|jet|mir|tir|parser|lexer|lower|codegen|emit|optimize|ast|type|symbol|registration)_\w+$"}
JETC_PREFIX: Regex{"^<?jetc_\w+::"}
SOURCE_PREFIX: Regex{"^__jet_src_\w*?_c_c"}
GENERIC_TAIL: Regex{"[<>].*$"}
RUST_PATH: Regex{"^jet_\w+::"}
RUST_SYMBOL: Regex{"^<?(jet_[a-z_]+)::(.*)$"}
RUST_SEGMENT: Regex{"^[A-Za-z_]\w*$"}
FN_DECL: Regex{"^\s*(?:pub\s+)?(\w+):\s*fn\b"}

// A top-level phase span (label == kind) in unix seconds.
Interval: struct {
    phase: String
    start: Float
    end: Float
}

// Symbol counts in first-seen order; `at` is each symbol's row.
Counts: struct {
    at: [String: Int]
    rows: [(symbol: String, count: Int)]
}

PhaseCounts: struct {
    phase: String
    samples: Int
    own: Counts
    inclusive: Counts
}

PhaseProfile: struct {
    phase: String
    samples: Int
    own: [Row]
    inclusive: [Row]
}

// A field as a JavaScript template literal prints it.
shown: fn(value: Dyn, key: String) -> String Never! {
    if value.get(key) == .Val(field) -> field.to_text() ?? "" else -> "undefined"
}

// A numeric field, NaN when absent or not a number.
number: fn(value: Dyn, key: String) -> Float Never! { (value.get(key) ?? Dyn.Null).float() ?? math.NAN }

// Trace time 0 is the `trace.start` event's `args.unix_ms`. Spans pair per
// thread and kind (`${tid}\0${cat}`, kept unambiguous by the length prefix);
// an end without a begin is ignored, and unclosed spans come last, in
// first-opened order, running to infinity.
phase_intervals: fn(events: [Dyn]) -> [Interval] Never! {
    origin: if events.find(event -> shown(event, "name") == "trace.start") == .Val(start) -> number(start.get("args") ?? Dyn.Null, "unix_ms") / Float{1000.0} else -> Float{0.0}
    slots := [String: Int]{}
    open := [(phase: String, starts: [Float])]{}
    intervals := [Interval]{}
    loop event in events {
        ph: shown(event, "ph")
        if (ph != "B" && ph != "E") || (event.get("name") ?? UNDEFINED) != (event.get("cat") ?? UNDEFINED) -> next
        phase: shown(event, "cat")
        tid: shown(event, "tid")
        key: "{tid.len()}:{tid}{phase}"
        t: origin + number(event, "ts") / 1000000.0
        if ph == "B" {
            if !slots.has_key(key) {
                slots[key] = open.len()
                open.push((phase: phase, starts: [Float]{}))
            }
            open[slots[key]].starts.push(t)
            next
        }
        slot: slots.get(key) ?? next
        begun: open[slot].starts.pop() ?? next
        intervals.push(Interval{phase: phase, start: begun, end: t})
    }
    loop span in open {
        loop begun in span.starts -> intervals.push(Interval{phase: span.phase.copy(), start: begun, end: math.INFINITY})
    }
    intervals
}

demangle: fn(symbol: String) -> String Never! { RUST_HASH.replace_first(FRAME_DSO.replace_first(FRAME_OFFSET.replace_first(symbol, ""), ""), "") }

owned: fn(symbol: String) -> Bool Never! { OWNED_PATH.is_match(symbol) || OWNED_NAME.is_match(symbol) }

// Every `name: fn` in the `.jet` files under `dir` to its
// `Compiler/<file>:<line>`; the first declaration in the sorted walk wins.
index_functions: fn(repo: String, dir: String, index: &[String: String]) {
    loop walked in files.walk_files(dir) {
        entry: walked ?? next
        if !entry.relative.ends_with(".jet") -> next
        full: files.join(dir, entry.relative)
        text: files.read(full) ?? next
        loop (at, line) in text.split("\n").to_list() {
            if !line.contains("fn") -> next
            found: FN_DECL.match(line) ?? next
            name: found.group(1) ?? next
            if !index.has_key(name) -> index[name] = "{full.removeprefix("{repo}/")}:{at + 1}"
        }
    }
}

// A symbol's source, `<file> <name>`: a Jet compiler function from `index`,
// else a Rust `jet_*` symbol's deepest existing crate module file, else the
// crate's lib.rs; None when neither applies.
resolve: fn(symbol: String, repo: String, index: [String: String]) -> String? Never! {
    parts: SOURCE_PREFIX.replace_first(JETC_PREFIX.replace_first(symbol, ""), "").split("::").to_list()
    name: GENERIC_TAIL.replace_first(parts[parts.len() - 1], "")
    if index.get(name) == .Val(jet) {
        if !RUST_PATH.is_match(symbol) -> return Val("{jet} {name}")
    }
    rust: RUST_SYMBOL.match(symbol) ?? return None
    crate: "crates/{(rust.group(1) ?? "").replace("_", "-")}/src"
    if !files.exists(files.join(repo, crate)) -> return None
    segments: (rust.group(2) ?? "").split("::").to_list().filter(segment -> RUST_SEGMENT.is_match(segment))
    // The module paths deepest first: crate/a/b, crate/a.
    deepest := [String]{}
    prefix := crate.copy()
    loop segment in segments {
        prefix = "{prefix}/{segment}"
        deepest.insert(0, prefix.copy())
    }
    loop base in deepest {
        loop candidate in ["{base}.rs", "{base}/mod.rs"] {
            if files.exists(files.join(repo, candidate)) -> return Val("{candidate} {segments[segments.len() - 1]}")
        }
    }
    Val("{crate}/lib.rs {name}")
}

// The phase at unix second `t`: the latest-starting interval holding it, a
// later one winning a tie.
phase_at: fn(intervals: [Interval], t: Float) -> String? Never! {
    best := -1
    loop i in 0..<intervals.len() {
        if t < intervals[i].start || t >= intervals[i].end -> next
        if best < 0 || intervals[i].start >= intervals[best].start -> best = i
    }
    if best < 0 -> None else -> Val(intervals[best].phase.copy())
}

count: fn(counts: &Counts, symbol: String) {
    row: counts.at.get(symbol) ?? counts.rows.len()
    if row == counts.rows.len() {
        counts.at[symbol.copy()] = row
        counts.rows.push((symbol: symbol.copy(), count: 0))
    }
    counts.rows[row].count += 1
}

// The TOP most counted symbols under `below`, by count (a tie keeps the
// first seen first), with their share of `total` and their source.
ranked: fn(counts: Counts, total: Int, below: Float, repo: String, index: [String: String]) -> [Row] Never! {
    rows := counts.rows.filter(row -> Float{row.count} < below)
    rows.sort_by((a, b) -> b.count <=> a.count)
    out := [Row]{}
    loop row in rows.take(TOP) -> out.push(Row{share: Float{row.count} / Float{max(1, total)}, symbol: row.symbol.copy(), source: resolve(row.symbol, repo, index)})
    out
}

// JavaScript object key order: array-index names ascending, then the rest,
// which a stable sort keeps in insertion order.
key_rank: fn(name: String) -> Int Never! {
    value: Int.parse(name) ?? return 4294967295
    if value >= 0 && value < 4294967295 && "{value}" == name -> value else -> 4294967295
}

// $PERF, else the pinned perf.
perf_binary: fn() -[Env]> String Never! { process.env_get("PERF") ?? PERF_PINNED }

// The argv prefix that records a compile into `dir`/perf.data with realtime
// timestamps and frame-pointer call graphs.
wrap: fn(dir: String) -[Env]> [String] Never! { [perf_binary(), "record", "-q", "-F", "199", "-k", "CLOCK_REALTIME", "--call-graph", "fp", "-m", "16", "-o", files.join(dir, "perf.data"), "--"] }

// `dir/perf.data` through `perf script`, attributed to the `wanted` phases of
// `trace_file` (its object rows; a partial or unparsable row is skipped).
// Inclusive rows leave out functions on 95% or more of a phase's samples, the
// phase driver itself.
profile: fn(dir: String, trace_file: String, wanted: [String], repo: String) -> [PhaseProfile] Err! {
    events := [Dyn]{}
    loop raw in files.read(trace_file).split("\n") {
        line: raw.trim().removesuffix(",")
        if !line.starts_with("{{") -> next
        event: json.parse(line) ?? next
        events.push(event)
    }
    slots := [String: Int]{}
    tallies := [PhaseCounts]{}
    loop phase in wanted {
        if slots.has_key(phase) -> next
        slots[phase.copy()] = tallies.len()
        tallies.push(PhaseCounts{phase: phase.copy(), samples: 0, own: Counts{at: [String: Int]{}, rows: []}, inclusive: Counts{at: [String: Int]{}, rows: []}})
    }
    intervals := [Interval]{}
    loop interval in phase_intervals(events) {
        if slots.has_key(interval.phase) -> intervals.push(interval)
    }
    child: process.cmd([perf_binary(), "script", "-i", files.join(dir, "perf.data"), "-F", "time,ip,sym", "--ns"]).stdout(.Stream).stderr(.Capture).spawn()
    samples := [(t: Float, frames: [String])]{}
    loop line in child.stdout.lines() {
        header: if FRAME_ADDRESS.is_match(line) -> None else -> SAMPLE_LINE.match(line)
        if header == .Val(found) {
            samples.push((t: Float.parse(found.group(1) ?? "") ?? math.NAN, frames: [String]{}))
            next
        }
        frame: FRAME_LINE.match(line) ?? next
        if samples.len() > 0 -> samples[samples.len() - 1].frames.push(demangle(frame.group(1) ?? ""))
    }
    _: child.wait()
    loop sample in samples {
        at: slots[phase_at(intervals, sample.t) ?? next]
        tallies[at].samples += 1
        count(tallies[at].own, if sample.frames.len() > 0 -> sample.frames[0] else -> "?")
        seen := [String]{}
        loop frame in sample.frames {
            if seen.contains(frame) || !owned(frame) -> next
            seen.push(frame.copy())
            count(tallies[at].inclusive, frame)
        }
    }
    index := [String: String]{}
    if samples.len() > 0 -> index_functions(repo, files.join(repo, "Compiler"), index)
    tallies.sort_by((a, b) -> key_rank(a.phase) <=> key_rank(b.phase))
    phases := [PhaseProfile]{}
    loop tally in tallies -> phases.push(PhaseProfile{phase: tally.phase.copy(), samples: tally.samples, own: ranked(tally.own, tally.samples, math.INFINITY, repo, index), inclusive: ranked(tally.inclusive, tally.samples, Float{0.95} * Float{tally.samples}, repo, index)})
    Ok(phases)
}
