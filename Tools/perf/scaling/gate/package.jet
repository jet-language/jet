// The compiler scaling gate (Tower #4319, #4601), the twin of
// Tools/perf/scaling/harness.mjs and profile.mjs, shared by the harness,
// profile, run-gate, enqueue and module-lookups-proof twins: Gate.jet (the
// options, the measured compiles, the growth fit and verdicts, the lines/s
// floors, the 1M-line projection and the resumable receipt) and Profile.jet
// (the perf profile of one compile per phase). A twin that uses it declares
// `jet_scaling_gate: <path to Tools/perf/scaling/gate>` beside the corpora (a
// root package must declare each directory its dependencies reach) and
// imports the names it needs with `use jet_scaling_gate.[…]`.
name: "jet_scaling_gate"
version: "0.0.1"
edition: "2026"
deps: {
    jet_scaling_corpora: ../corpora,
}
