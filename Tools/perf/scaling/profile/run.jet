// The responsible-code profile of one compile (Tower #4601), the twin of
// Tools/perf/scaling/profile.mjs's command line: the profile of BUILD_DIR's
// perf.data against TRACE_FILE's phases (jet_scaling_gate's Profile.jet),
// per phase its samples, top self symbols and top inclusive compiler
// functions with their sources.
//
//   jet Tools/perf/scaling/profile BUILD_DIR TRACE_FILE PHASE...   (BUILD_DIR holds perf.data)
package: {
    name: "scaling_profile"
    version: "0.0.1"
    deps: {
        // A root package declares each directory its dependencies reach.
        jet_scaling_corpora: ../corpora,
        jet_scaling_gate: ../gate,
    }
}

use {
    jet_scaling_gate.[Row, profile]
    fmt: core.text.fmt
    process: core.process
    sys: core.sys
}

TOOL: "/Tools/perf/scaling/profile/run.jet"

print_rows: fn(rows: [Row]) {
    loop row in rows -> print("{fmt.decimal(row.share * Float{100.0}, 1).pad_start(5, " ")}%  {row.symbol.slice(0..<min(120, row.symbol.len()))}  {row.source ?? ""}")
}

run: fn() {
    args: process.args()
    if args.len() < 3 || args[0] == "" || args[1] == "" -> process.fail(2, "Usage: jet Tools/perf/scaling/profile BUILD_DIR TRACE_FILE PHASE...   (BUILD_DIR holds perf.data)")
    // An unreadable trace or a perf that cannot start ends the run with exit 1,
    // as an uncaught error ends profile.mjs.
    phases: profile(args[0], args[1], args[2..<args.len()], sys.executable().removesuffix(TOOL)) ?? process.fail(1, err.message)
    loop phase in phases {
        print("== {phase.phase}: {phase.samples} samples")
        print("-- self")
        print_rows(phase.own)
        print("-- inclusive compiler functions")
        print_rows(phase.inclusive)
    }
}
