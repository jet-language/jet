#!/usr/bin/env jet
// Frame-time cases (#6701): runs the cases that hold wall time to a fixed
// limit, such as ui_backend/wayland_windows_hold_a_one_millisecond_frame,
// on quiet CPUs. Those cases require JET_TIMING_QUIET=1
// (Docs/spec/reference/environment.md) and skip everywhere else. This runner
// sets it and pins the whole run to the kernel's isolated CPUs
// (/sys/devices/system/cpu/isolated) or, when the kernel isolates none, to
// the CPUs `--cpu LIST` names (as `2-5,8`); with neither it refuses and
// exits 2.
// Usage (from the repository root):
//   jet Tools/perf/frame-time/Main.jet [--jet PATH] [--filter FILTER] [--cpu LIST]
// Defaults: the `jet` on PATH, and the filter
// ui_backend/wayland_windows_hold_a_one_millisecond_frame.
use {
    files: core.files
    process: core.process
    term: core.term
}

ISOLATED: "/sys/devices/system/cpu/isolated"
DEFAULT_FILTER: "ui_backend/wayland_windows_hold_a_one_millisecond_frame"

// `2-5,8` as the CPUs it names.
parse_cpus: fn(text: String) -> [Int] Never! {
    cpus := [Int]{}
    loop part in text.split(",") {
        span: part.trim().partition("-")
        first: Int.parse(span.head) ?? next
        last: if span.sep == "" -> first else -> Int.parse(span.tail) ?? first
        loop cpu in first..<(last + 1) -> cpus.push(cpu)
    }
    cpus
}

usage: fn() -[IO]> Int Never! {
    term.eprint("usage: jet Tools/perf/frame-time/Main.jet [--jet PATH] [--filter FILTER] [--cpu LIST]")
    64
}

frame_time: fn() -[Env, Exec, FS, IO, Time.Wait]> Int Never! {
    args: process.args()
    jet := process.which("jet") ?? "jet"
    filter := DEFAULT_FILTER.copy()
    chosen := [Int]{}
    at := 0
    loop at < args.len() {
        if at + 1 >= args.len() -> return usage()
        if args[at] == "--jet" {
            jet = args[at + 1].copy()
        } else if args[at] == "--filter" {
            filter = args[at + 1].copy()
        } else if args[at] == "--cpu" {
            chosen = parse_cpus(args[at + 1])
            if chosen.len() == 0 -> return usage()
        } else {
            return usage()
        }
        at += 2
    }
    isolated: files.read(ISOLATED) ?? ""
    cpus := parse_cpus(isolated.trim())
    if cpus.len() == 0 -> cpus = chosen
    if cpus.len() == 0 {
        term.eprint("no isolated CPUs ({ISOLATED} is empty) and no --cpu LIST: boot with isolcpus= or name idle CPUs to time frames")
        return 2
    }
    ran: process.cmd([String]{jet, "test", "Compiler", "--profile", "cases", "--filter={filter}"}).env("JET_TIMING_QUIET", "1").cpu_affinity(cpus).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? {
        term.eprint("frame time: {jet} could not start: {err}")
        return 127
    }
    if ran.signal != None -> 1 else -> ran.code
}

run: fn() {
    code: frame_time()
    if code != 0 -> process.exit(code)
}

#Test("isolated CPU lists name each CPU once") {
    assert_eq(parse_cpus("2-5,8"), [Int]{2, 3, 4, 5, 8})
    assert_eq(parse_cpus(""), [Int]{})
    assert_eq(parse_cpus("16-31").len(), 16)
}
