#!/usr/bin/env jet
// Fails CI when a checked web workload grows beyond its baseline: each row of
// Tools/perf/web-bundle-baseline.tsv names a workload source and its frozen
// sizes; the source is built with `jet build --target=web` and every size may
// grow at most the row's percent. A web build ships the files its
// web.manifest.json names: its partitions' wasm (the app's and the runtime's,
// rt.wasm), the glue (the entry script) and the DOM runtime (the host
// script). `wasm` is every partition together and `rt_wasm` the runtime
// partition alone; the bundle is wasm + glue + DOM runtime. A manifest naming
// any other file fails the gate, so no shipped byte goes unmeasured.
// Usage (from the repository root): jet Tools/perf/WebBundleCheck.jet
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    term: core.term
}

BASELINE: "Tools/perf/web-bundle-baseline.tsv"
JET_ENV: "Tools/agent/JetEnv.jet"
EXPECTED_HEADER: "version\tworkload\tsource\tsource_sha256\twasm_bytes\trt_wasm_bytes\tglue_bytes\truntime_bytes\tbundle_bytes\tregression_pct"
BUILD_DIR: ".jet/build"
MANIFEST: "web.manifest.json"
// The manifest fields that name a script; each partition names its wasm `module`.
MANIFEST_SCRIPTS: [String]{"entry", "host"}
APP_WASM: "app.wasm"
RT_WASM: "rt.wasm"
GLUE: "app.js"
DOM_RUNTIME: "jet_dom_runtime.js"
// Every file a web build ships.
ARTIFACTS: [String]{APP_WASM, RT_WASM, GLUE, DOM_RUNTIME}

Row: struct {
    version: String
    workload: String
    source: String
    source_hash: String
    wasm: String
    rt_wasm: String
    glue: String
    runtime: String
    bundle: String
    regression: String
}

fail: fn(message: String) -[IO]> Int Never! {
    term.eprint("web bundle gate: {message}")
    1
}

byte_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! { String.from_bytes_lossy(bytes[start..<end]) }

is_digit: fn(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

all_digits: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    loop byte in bytes {
        if !is_digit(Int{byte}) -> return false
    }
    true
}

number: fn(text: String) -> Int Never! {
    if Int.parse(text) == {
        .Ok(value) -> value
        .Err(_) -> 0
    }
}

// &&[a-z][a-z0-9-]*$
valid_workload: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    first: Int{bytes[0]}
    if first < 97 || first > 122 -> return false
    loop byte in bytes {
        code: Int{byte}
        if !((code >= 97 && code <= 122) || is_digit(code) || code == 45) -> return false
    }
    true
}

// &&[0-9a-f]{64}$
valid_hash: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() != 64 -> return false
    loop byte in bytes {
        code: Int{byte}
        if !(is_digit(code) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// The lines a shell `while read` loop sees: every newline-terminated line;
// a final line without a newline is not read.
read_lines: fn(text: String) -> [String] Never! {
    bytes: text.bytes()
    lines := [String]{}
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            lines.push(byte_text(bytes, start, index))
            start = index + 1
        }
    }
    lines
}

// The bytes `sed -n '1,COUNTp'` prints: through the COUNTth newline.
first_lines: fn(bytes: [U8], count: Int) -> [U8] Never! {
    seen := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            seen += 1
            if seen == count -> return bytes[0..<index + 1]
        }
    }
    bytes.copy()
}

// Line `number` (1-based) as `sed -n 'NUMBERp'` prints it, without its newline.
line_at: fn(text: String, number: Int) -> String Never! {
    bytes: text.bytes()
    line := 1
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            if line == number -> return byte_text(bytes, start, index)
            line += 1
            start = index + 1
        }
    }
    if line == number -> return byte_text(bytes, start, bytes.len())
    ""
}

// Tab-separated fields as `IFS=$'\t' read -r` assigns ten names: runs of tabs
// separate, edge tabs are dropped, and the tenth name takes the rest of the line.
row_fields: fn(line: String) -> Row Never! {
    bytes: line.bytes()
    fields := [String]{}
    at := 0
    loop at < bytes.len() && bytes[at] == (U8{9}) -> at += 1
    loop at < bytes.len() && fields.len() < 9 {
        start: at
        loop at < bytes.len() && bytes[at] != (U8{9}) -> at += 1
        fields.push(byte_text(bytes, start, at))
        loop at < bytes.len() && bytes[at] == (U8{9}) -> at += 1
    }
    end := bytes.len()
    loop end > at && bytes[end - 1] == (U8{9}) -> end -= 1
    if at < end -> fields.push(byte_text(bytes, at, end))
    loop fields.len() < 10 -> fields.push("")
    Row{version: fields[0], workload: fields[1], source: fields[2], source_hash: fields[3], wasm: fields[4], rt_wasm: fields[5], glue: fields[6], runtime: fields[7], bundle: fields[8], regression: fields[9]}
}

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

// The files a web.manifest.json names: its entry, its host and every
// partition's module.
manifest_files: fn(text: String) -> [String] Err! {
    tree: json.parse(text) ?? return Err("not JSON: {err}")
    named := [String]{}
    loop key in MANIFEST_SCRIPTS {
        if field(tree, key) == {
            .Text(name) -> named.push(name.copy())
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err("no `{key}` file")
        }
    }
    if field(tree, "partitions") == .Array(partitions) {
        loop partition in partitions {
            if field(partition, "module") == {
                .Text(name) -> named.push(name.copy())
                .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> return Err("a partition without a `module` file")
            }
        }
        return Ok(named)
    }
    Err("no `partitions` array")
}

passthrough: fn(receipt: ProcessReceipt) Never! -[IO]> {
    out := term.stdout()
    out.write(receipt.output).drop("web bundle stdout")
    errors := term.stderr()
    errors.write(receipt.errors).drop("web bundle stderr")
}

executable: fn(path: String) -[Exec, Time.Wait]> Bool Never! {
    receipt: process.cmd([String]{"test", "-x", path.copy()}).run() ?? return false
    receipt.code == 0
}

// `test -f`: a regular file, through symbolic links.
regular_file: fn(path: String) -[FS]> Bool Never! {
    files.is_file(path) || (files.is_symlink(path) && files.exists(path) && !files.is_dir(path))
}

file_bytes: fn(path: String) -[FS]> Int Never! {
    if files.read_bytes(path) == {
        .Ok(bytes) -> bytes.len()
        .Err(_) -> 0
    }
}

check_size: fn(workload: String, metric: String, baseline: Int, current: Int, percent: Int) -[IO]> Bool Never! {
    limit: baseline + (baseline * percent + 99) /% 100
    if current > limit {
        term.eprint("REGRESSION {workload} {metric}: {baseline} -> {current} (limit {limit}, +{percent}%)")
        return false
    }
    true
}

check_rows: fn(root: String, text: String, scratch: String, run_dir: String) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    failures := 0
    rows := 0
    seen := [String]{}
    loop line in read_lines(text) {
        row: row_fields(line)
        if row.version == "" || row.version.starts_with("#") -> next
        if row.version == "version" -> next
        if row.version != "2" {
            shown: if row.version == "" -> "missing" else -> row.version
            return fail("unsupported baseline row version: {shown}")
        }
        if !valid_workload(row.workload) -> return fail("invalid workload: {row.workload}")
        if seen.contains(row.workload) -> return fail("duplicate workload: {row.workload}")
        seen.push(row.workload.copy())
        if row.source.starts_with("/") || row.source.contains("..") -> return fail("unsafe workload source: {row.source}")
        source_path: "{root}/{row.source}"
        if !regular_file(source_path) -> return fail("missing workload source: {row.source}")
        if !valid_hash(row.source_hash) -> return fail("invalid source hash: {row.source}")
        source_bytes: files.read_bytes(source_path) ?? [U8]{}
        if row.source_hash != crypto.sha256(source_bytes).hex() -> return fail("source changed: {row.source}")
        values: [String]{row.wasm, row.rt_wasm, row.glue, row.runtime, row.bundle, row.regression}
        loop value in values {
            if !all_digits(value) -> return fail("invalid baseline value for {row.workload}")
        }
        wasm_base: number(row.wasm)
        rt_wasm_base: number(row.rt_wasm)
        glue_base: number(row.glue)
        runtime_base: number(row.runtime)
        bundle_base: number(row.bundle)
        regression: number(row.regression)
        if !(wasm_base > 0 && rt_wasm_base > 0 && rt_wasm_base <= wasm_base && glue_base > 0 && runtime_base > 0 && bundle_base == wasm_base + glue_base + runtime_base) -> return fail("invalid bundle totals: {row.workload}")
        if regression > 100 -> return fail("regression limit exceeds 100%: {row.workload}")

        case_dir: "{run_dir}/{row.workload}"
        if files.create_dir_all(case_dir) == {
            .Ok(_) -> {}
            .Err(error) -> return fail("cannot create {case_dir}: {error}")
        }
        if files.write_bytes("{case_dir}/main.jet", source_bytes) == {
            .Ok(_) -> {}
            .Err(error) -> return fail("cannot copy {row.source}: {error}")
        }
        // The build's output, then its errors, are kept in build.log.
        build: process.cmd([String]{"{root}/{JET_ENV}", "jet", "build", "--target=web", "main.jet"})
            .cwd(case_dir)
            .env("JET_ROOT", root)
            .env("TMPDIR", scratch)
            .output_limit(16777216)
        built := false
        log := [U8]{}
        if build.run() == {
            .Ok(receipt) -> {
                built = receipt.code == 0 && receipt.signal == None
                log = "{receipt.output}{receipt.errors}".bytes()
            }
            .Err(error) -> log = "{JET_ENV} could not start: {error}\n".bytes()
        }
        files.write_bytes("{case_dir}/build.log", log).drop("build.log is only a record of the build")
        if !built {
            errors := term.stderr()
            errors.write(String.from_bytes_lossy(first_lines(log, 120))).drop("web bundle stderr")
            return fail("build failed: {row.workload}")
        }
        out: "{case_dir}/{BUILD_DIR}"
        manifest: files.read("{out}/{MANIFEST}") ?? return fail("missing {MANIFEST}: {row.workload}: {err}")
        named: manifest_files(manifest) ?? return fail("unreadable {MANIFEST}: {row.workload}: {err.message}")
        loop name in named {
            if !ARTIFACTS.contains(name) -> return fail("{row.workload}: {MANIFEST} names {name}, which the gate does not count")
        }
        loop artifact in ARTIFACTS {
            if !named.contains(artifact) -> return fail("{row.workload}: {MANIFEST} no longer names {artifact}")
            if !files.is_file("{out}/{artifact}") -> return fail("missing regular artifact: {row.workload}/{artifact}")
        }
        rt_wasm_current: file_bytes("{out}/{RT_WASM}")
        wasm_current: file_bytes("{out}/{APP_WASM}") + rt_wasm_current
        glue_current: file_bytes("{out}/{GLUE}")
        runtime_current: file_bytes("{out}/{DOM_RUNTIME}")
        bundle_current: wasm_current + glue_current + runtime_current
        print("{row.workload}\twasm={wasm_current}\trt_wasm={rt_wasm_current}\tglue={glue_current}\truntime={runtime_current}\tbundle={bundle_current}")
        if !check_size(row.workload, "wasm", wasm_base, wasm_current, regression) -> failures += 1
        if !check_size(row.workload, "rt_wasm", rt_wasm_base, rt_wasm_current, regression) -> failures += 1
        if !check_size(row.workload, "glue", glue_base, glue_current, regression) -> failures += 1
        if !check_size(row.workload, "runtime", runtime_base, runtime_current, regression) -> failures += 1
        if !check_size(row.workload, "bundle", bundle_base, bundle_current, regression) -> failures += 1
        rows += 1
    }
    if rows != 3 -> return fail("expected 3 web workloads, got {rows}")
    if failures != 0 -> return fail("{failures} size regression(s)")
    print("web bundle gate: pass workloads={rows}")
    0
}

web_bundle_check: fn() -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    root: files.cwd() ?? return fail("cannot read the working directory: {err}")
    baseline_path: "{root}/{BASELINE}"
    text: if files.read(baseline_path) == {
        .Ok(value) -> value
        .Err(_) -> ""
    }
    if text == "" -> return fail("missing baseline: {BASELINE}")
    if !executable("{root}/{JET_ENV}") -> return fail("missing Jet environment: {JET_ENV}")
    if line_at(text, 2) != EXPECTED_HEADER -> return fail("baseline schema drifted")
    home: process.env_get_or("HOME", "")
    scratch: process.env_get_or("TMPDIR", "")
    cache: process.env_get_or("XDG_CACHE_HOME", "{home}/.cache")
    state: process.env_get_or("JET_STATE_ROOT", "{cache}/jet-dev")
    scratch_root: if scratch == "" -> process.env_get_or("JET_SCRATCH_ROOT", state) else -> scratch
    created: process.cmd([String]{"mkdir", "-p", scratch_root.copy()}).run() ?? return fail("cannot create {scratch_root}")
    if created.code != 0 {
        passthrough(created)
        return 1
    }
    made: process.cmd([String]{"mktemp", "-d", "{scratch_root}/web-bundle.XXXXXX"}).run() ?? return fail("cannot create a run directory under {scratch_root}")
    if made.code != 0 {
        passthrough(made)
        return 1
    }
    run_dir: made.output.trim()
    code: check_rows(root, text, scratch_root, run_dir)
    files.rmtree(run_dir).drop("web bundle run directory")
    code
}

run: fn() {
    code: web_bundle_check()
    if code != 0 -> process.exit(code)
}

#Test("baseline rows split like a tab-separated shell read") {
    row: row_fields("\t2\tcounter\t\tsrc/main.jet\tabc\t4\t1\t2\t3\t9\t5\t9\t")
    assert_eq(row.source, "src/main.jet")
    assert_eq(row.rt_wasm, "1")
    assert_eq(row.bundle, "9")
    assert_eq(row.regression, "5\t9")
    assert_eq(read_lines("a\nb\nc").join(","), "a,b")
}

#Test("the manifest names its entry, its host and every partition's module") {
    named: manifest_files("{{\"target\": \"web\", \"entry\": \"app.js\", \"host\": \"jet_dom_runtime.js\", \"partitions\": [{{\"name\": \"runtime\", \"module\": \"rt.wasm\"}}, {{\"name\": \"app\", \"module\": \"app.wasm\"}}]}}") ?? panic(err.message)
    assert_eq(named.join(","), "app.js,jet_dom_runtime.js,rt.wasm,app.wasm")
    assert(manifest_files("{{\"entry\": \"app.js\", \"host\": \"h.js\"}}") == .Err(_))
    assert(manifest_files("{{\"entry\": \"app.js\", \"host\": \"h.js\", \"partitions\": [{{\"name\": \"app\"}}]}}") == .Err(_))
}
