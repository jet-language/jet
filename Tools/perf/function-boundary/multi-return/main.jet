// Function-boundary cell multi-return: two named results come back as one
// small struct (D-OUTPUT-RETURNS1=A) on every call of a hot loop.
#CLI Args: struct { n: Int }

Parts: struct {
    quotient: Int
    remainder: Int
}

split: fn(n: Int, d: Int) -> Parts {
    Parts{quotient: n /% d, remainder: n % d}
}

run: fn(args: Args) {
    acc := 0
    loop i in 0..<args.n {
        p: split(i, i % 13 + 3)
        acc += p.quotient + p.remainder
    }
    print(acc)
}
