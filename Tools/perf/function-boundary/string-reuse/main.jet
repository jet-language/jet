// Function-boundary cell string-reuse: the caller owns one String buffer and
// the callee refills it in place (`&` capacity reuse; pair: string-fresh).
// `out = ""` empties the caller's String and keeps its buffer.
#CLI
struct Args {
    n: Int
}

fn render_into(out: &String, seed: Int) {
    out = ""
    loop i in 0..<(32 + seed % 32) {
        if (seed + i) % 2 == 0 -> out += "ab" else -> out += "xyz"
    }
}

fn run(args: Args) {
    acc := 0
    text := ""
    loop i in 0..<args.n {
        render_into(&text, i)
        acc += text.len()
    }
    print(acc)
}
