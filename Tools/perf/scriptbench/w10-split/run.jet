// w10: build a 20,000-line text, split it into lines and words, and count the
// words, the words longer than four bytes and the word bytes.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc] }
}

run: fn() {
    lines := [String]{}
    loop i in 0..<20000 -> lines.push("alpha beta gamma delta epsilon {i}")
    text: lines.join("\n")
    count := 0
    long := 0
    bytes := 0
    loop line in text.split("\n") {
        loop word in line.split(" ") {
            size: word.count_bytes()
            count += 1
            bytes += size
            if size > 4 -> long += 1
        }
    }
    print("words={count} long={long} bytes={bytes}")
}
