// w02: walk the w02/ tree (20,000 files), stat every file and total the sizes.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc, FS] }
}

use {
    fs: core.files
}

run: fn() {
    files := 0
    bytes := 0
    loop item in fs.walk("w02") {
        entry: item ?? panic("walk failed")
        if entry.is_dir -> next
        info: fs.stat(entry.path) ?? panic("stat failed")
        files += 1
        bytes += info.size
    }
    print("files={files} bytes={bytes}")
}
