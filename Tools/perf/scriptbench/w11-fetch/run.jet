// w11: fetch 100 URLs, at most 32 at a time, from the local fixture server
// (port 18411) that answers each request after 20 ms.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use {
    http: core.http
}

status: fn(i: Int) -> Int {
    resp: http.get("http://127.0.0.1:18411/item/{i}") ?? panic("request failed")
    body: resp.text() ?? panic("body failed")
    if body.count_bytes() == 0 -> return 0
    resp.status
}

run: fn() {
    ids := [Int]{}
    loop i in 0..<100 -> ids.push(i)
    codes: ids.para_map((i: Int) -> status(i), limit: 32)
    ok := 0
    loop code in codes {
        if code == 200 -> ok += 1
    }
    print("ok={ok}")
}
