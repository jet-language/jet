// w06: decode w06.json (400,000 records, about 44 MB) into typed records and
// total the salaries of the active ones.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc, FS.Read] }
}

use {
    json: core.encoding.json
    fs: core.files
}

#Codable
Person: struct {
    id: Int
    name: String
    dept: String
    salary: Int
    active: Bool
    tags: [String]
}

run: fn() {
    raw: fs.read("w06.json") ?? panic("read failed")
    people: json.decode<[Person]>(raw) ?? panic("decode failed")
    count := 0
    active := 0
    salary := 0
    loop person in people {
        count += 1
        if !person.active -> next
        active += 1
        salary += person.salary
    }
    print("records={count} active={active} salary={salary}")
}
