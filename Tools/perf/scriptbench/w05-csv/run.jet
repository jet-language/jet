// w05: read w05.csv (1,000,000 rows) one record at a time, total qty and qty * price_cents.
package: {
    name: "run"
    authority: { allow: [IO, Mem.Alloc, FS.Read] }
}

use {
    csv: core.encoding.csv
    fs: core.files
}

run: fn() {
    input: fs.open("w05.csv") ?? panic("open failed")
    reader := csv.reader(input, header: true) ?? panic("csv reader failed")
    count := 0
    qty := 0
    value := 0
    loop {
        row: if reader.next() == {
            .Ok(next) -> next ?? break
            .Err(error) -> panic("csv parse failed: {error.reason}")
        }
        q: Int.parse(row.fields[3]) ?? panic("bad qty")
        price: Int.parse(row.fields[4]) ?? panic("bad price")
        count += 1
        qty += q
        value += q * price
    }
    print("rows={count} qty={qty} value={value}")
}
