// Gen.jet DATA_DIR: writes the ScriptBench inputs, the same bytes on every run.
//   w02/              10 x 10 x 10 directories holding 20,000 files of 0..4,095 bytes
//   data/log100m.txt  about 100 MB of log lines (w03)
//   data/words.txt    about 25 MB of prose over a Zipf vocabulary of 5,000 words (w04)
//   w05.csv           1,000,000 rows under a header: id,name,dept,qty,price_cents
//   w06.json          400,000 records in one JSON array (about 44 MB)
//   w13.txt           2,000,000 lines with 1,000,003 distinct values
// An input that already exists is kept; each file is written through a .part
// name, so a killed run leaves no half file.
package: {
    name: "scriptbench-gen"
    authority: { allow: [IO, Mem.Alloc, FS, Exec, Exec.Args] }
}

use {
    fs: core.files
    process: core.process
}

// A 31-bit linear congruential generator: every product stays below 2^62.
// Only the high 15 bits of a step are used; the low bits of an LCG modulo a
// power of two repeat with short periods.
RNG: struct {
    state: Int

    step: fn(&self) -> Int {
        self.state = (self.state * 1103515245 + 12345) %% 2147483648
        self.state /% 65536
    }

    // The next value in 0..<n.
    below: fn(&self, n: Int) -> Int {
        if n <= 32768 -> return self.step() %% n
        high: self.step()
        (high * 32768 + self.step()) %% n
    }
}

pad2: fn(n: Int) -> String {
    if n < 10 -> return "0{n}"
    "{n}"
}

// Writes the parts to path through path.part.
emit: fn(path: String, parts: [String]) {
    part: "{path}.part"
    fs.write(part, parts.join("")) ?? panic("write {part} failed")
    fs.rename(part, path) ?? panic("rename {part} failed")
    print("wrote {path}")
}

tree: fn(dir: String) {
    root: "{dir}/w02"
    done: "{dir}/w02.done"
    if fs.exists(done) -> return
    n := 0
    loop a in 0..<10 {
        loop b in 0..<10 {
            loop c in 0..<10 {
                leaf: "{root}/d{a}/s{b}/t{c}"
                fs.create_dir_all(leaf) ?? panic("mkdir {leaf} failed")
                loop f in 0..<20 {
                    fs.write("{leaf}/f{f}.dat", "x".repeat((n * 37) %% 4096)) ?? panic("write failed")
                    n += 1
                }
            }
        }
    }
    fs.write(done, "") ?? panic("write {done} failed")
    print("wrote {root} ({n} files)")
}

log: fn(dir: String) {
    path: "{dir}/data/log100m.txt"
    if fs.exists(path) -> return
    rng := RNG{state: 2}
    levels: ["INFO", "INFO", "INFO", "DEBUG", "WARN", "ERROR"]
    svcs: ["api", "auth", "billing", "search", "web"]
    res: ["items", "users", "orders", "carts"]
    parts := [String]{}
    bytes := 0
    i := 0
    loop bytes < 100000000 {
        x: rng.below(100)
        status: if x < 90 -> 200 else if x < 97 -> 404 else -> 500 + rng.below(4)
        ms: if rng.below(10) < 8 -> 1 + rng.below(99) else -> 100 + rng.below(2400)
        level: levels[rng.below(6)]
        svc: svcs[rng.below(5)]
        user: rng.below(100000)
        kind: res[rng.below(4)]
        item: rng.below(1000000)
        line: "2026-10-28T{pad2(10 + i %% 14)}:{pad2(i %% 60)}:{pad2((i * 7) %% 60)}Z level={level} svc={svc} user=u{user} path=/v1/{kind}/{item} status={status} ms={ms}\n"
        bytes += line.count_bytes()
        i += 1
        parts.push(line)
    }
    emit(path, parts)
}

capital: fn(word: String) -> String {
    "{word.slice(0, 1).to_upper()}{word.slice(1, word.count_bytes())}"
}

words: fn(dir: String) {
    path: "{dir}/data/words.txt"
    if fs.exists(path) -> return
    rng := RNG{state: 3}
    syl: ["ka", "lo", "mi", "ne", "ru", "sa", "ti", "vo", "ze", "qua", "ber", "don", "fel", "gri", "hap", "jun"]
    vocab := [String]{}
    seen := Set.from([String]{})
    loop vocab.len() < 5000 {
        k: 1 + rng.below(4)
        w := ""
        loop _ in 0..<k -> w = "{w}{syl[rng.below(16)]}"
        if !seen.has(w) {
            seen.add(w.copy())
            vocab.push(w)
        }
    }
    // Zipf weights 1/(i+1), scaled to integers.
    cum := [Int]{}
    total := 0
    loop i in 0..<5000 {
        total += 1000000 /% (i + 1)
        cum.push(total)
    }
    punct: [" ", " ", " ", " ", " ", ", ", "; ", " - "]
    parts := [String]{}
    bytes := 0
    loop bytes < 25000000 {
        n: 6 + rng.below(10)
        line := ""
        loop j in 0..<n {
            x: rng.below(total)
            lo := 0
            hi := 4999
            loop lo < hi {
                m: (lo + hi) /% 2
                if cum[m] <= x -> lo = m + 1 else -> hi = m
            }
            w := vocab[lo].copy()
            if j == 0 || rng.below(100) < 5 -> w = capital(w)
            if rng.below(100) < 1 -> w = w.to_upper()
            tail: if j == n - 1 -> (if rng.below(2) == 0 -> "." else -> "!") else -> punct[rng.below(8)]
            line = "{line}{w}{tail}"
        }
        text: "{line}\n"
        bytes += text.count_bytes()
        parts.push(text)
    }
    emit(path, parts)
}

sales: fn(dir: String) {
    path: "{dir}/w05.csv"
    if fs.exists(path) -> return
    parts := ["id,name,dept,qty,price_cents\n"]
    loop i in 1..<1000001 -> parts.push("{i},name{i %% 1000},dept{i %% 17},{i %% 100},{(i * 31) %% 10000}\n")
    emit(path, parts)
}

people: fn(dir: String) {
    path: "{dir}/w06.json"
    if fs.exists(path) -> return
    parts := ["["]
    loop i in 0..<400000 {
        comma: if i == 0 -> "" else -> ","
        active: if i %% 3 != 0 -> "true" else -> "false"
        parts.push("{comma}{{\"id\":{i},\"name\":\"user{i}\",\"dept\":\"dept{i %% 17}\",\"salary\":{(i * 7919) %% 100000},\"active\":{active},\"tags\":[\"t{i %% 5}\",\"t{i %% 7}\"]}}")
    }
    parts.push("]\n")
    emit(path, parts)
}

lines: fn(dir: String) {
    path: "{dir}/w13.txt"
    if fs.exists(path) -> return
    parts := [String]{}
    loop i in 0..<2000000 -> parts.push("k{(i * 7919) %% 1000003}\n")
    emit(path, parts)
}

run: fn() {
    argv: process.args()
    if argv.len() != 1 {
        print("usage: jet Tools/perf/scriptbench/Gen.jet DATA_DIR")
        process.exit(2)
    }
    dir: argv[0]
    fs.create_dir_all("{dir}/data") ?? panic("mkdir {dir}/data failed")
    tree(dir)
    log(dir)
    words(dir)
    sales(dir)
    people(dir)
    lines(dir)
}
