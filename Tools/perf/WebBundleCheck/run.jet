// Fails CI when a checked web workload grows beyond its baseline: each row of
// Tools/perf/web-bundle-baseline.tsv names a workload source and its frozen
// wasm, glue, runtime and bundle sizes; the source is built with
// `jet build --target=web` and every size may grow at most the row's percent.
// Usage (from the repository root): jet run Tools/perf/WebBundleCheck
use core.crypto as crypto
use core.files as files
use core.process as process
use core.term as term

BASELINE :: "Tools/perf/web-bundle-baseline.tsv"
JET_ENV :: "Tools/agent/jet-env"
EXPECTED_HEADER :: "version\tworkload\tsource\tsource_sha256\twasm_bytes\tglue_bytes\truntime_bytes\tbundle_bytes\tregression_pct"
ARTIFACTS :: [String]{"app.wasm", "app.js", "jet_dom_runtime.js"}

struct Row {
    version: String
    workload: String
    source: String
    source_hash: String
    wasm: String
    glue: String
    runtime: String
    bundle: String
    regression: String
}

fn fail(message: String) -[IO]> Int Never! {
    term.eprint("web bundle gate: {message}")
    1
}

fn byte_text(bytes: [U8], start: Int, end: Int) -> String Never! { String.from_bytes_lossy(bytes[start..<end]) }

fn is_digit(code: Int) -> Bool Never! { code >= 48 && code <= 57 }

fn all_digits(text: String) -> Bool Never! {
    bytes :: text.bytes()
    if bytes.len() == 0 -> return false
    loop byte in bytes {
        if !is_digit(Int.from_u8(byte)) -> return false
    }
    true
}

fn number(text: String) -> Int Never! {
    if Int.parse(text) == {
        .Ok(value) -> value
        .Err(_) -> 0
    }
}

// ^[a-z][a-z0-9-]*$
fn valid_workload(text: String) -> Bool Never! {
    bytes :: text.bytes()
    if bytes.len() == 0 -> return false
    first :: Int.from_u8(bytes[0])
    if first < 97 || first > 122 -> return false
    loop byte in bytes {
        code :: Int.from_u8(byte)
        if !((code >= 97 && code <= 122) || is_digit(code) || code == 45) -> return false
    }
    true
}

// ^[0-9a-f]{64}$
fn valid_hash(text: String) -> Bool Never! {
    bytes :: text.bytes()
    if bytes.len() != 64 -> return false
    loop byte in bytes {
        code :: Int.from_u8(byte)
        if !(is_digit(code) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// The lines a shell `while read` loop sees: every newline-terminated line;
// a final line without a newline is not read.
fn read_lines(text: String) -> [String] Never! {
    bytes :: text.bytes()
    lines := [String]{}
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            &lines.push(byte_text(bytes, start, index))
            start = index + 1
        }
    }
    lines
}

// The bytes `sed -n '1,COUNTp'` prints: through the COUNTth newline.
fn first_lines(bytes: [U8], count: Int) -> [U8] Never! {
    seen := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            seen += 1
            if seen == count -> return bytes[0..<index + 1]
        }
    }
    bytes.copy()
}

// Line `number` (1-based) as `sed -n 'NUMBERp'` prints it, without its newline.
fn line_at(text: String, number: Int) -> String Never! {
    bytes :: text.bytes()
    line := 1
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            if line == number -> return byte_text(bytes, start, index)
            line += 1
            start = index + 1
        }
    }
    if line == number -> return byte_text(bytes, start, bytes.len())
    ""
}

// Tab-separated fields as `IFS=$'\t' read -r` assigns nine names: runs of tabs
// separate, edge tabs are dropped, and the ninth name takes the rest of the line.
fn row_fields(line: String) -> Row Never! {
    bytes :: line.bytes()
    fields := [String]{}
    at := 0
    loop at < bytes.len() && bytes[at] == (U8{9}) -> at += 1
    loop at < bytes.len() && fields.len() < 8 {
        start :: at
        loop at < bytes.len() && bytes[at] != (U8{9}) -> at += 1
        &fields.push(byte_text(bytes, start, at))
        loop at < bytes.len() && bytes[at] == (U8{9}) -> at += 1
    }
    end := bytes.len()
    loop end > at && bytes[end - 1] == (U8{9}) -> end -= 1
    if at < end -> &fields.push(byte_text(bytes, at, end))
    loop fields.len() < 9 -> &fields.push("")
    Row{version: fields[0], workload: fields[1], source: fields[2], source_hash: fields[3], wasm: fields[4], glue: fields[5], runtime: fields[6], bundle: fields[7], regression: fields[8]}
}

fn passthrough(receipt: ProcessReceipt) Never! -[IO]> {
    out := term.stdout()
    &out.write(receipt.output).drop("web bundle stdout")
    errors := term.stderr()
    &errors.write(receipt.errors).drop("web bundle stderr")
}

fn executable(path: String) -[Exec, Time.Wait]> Bool Never! {
    receipt :: process.cmd([String]{"test", "-x", path.copy()}).run() ?? return false
    receipt.code == 0
}

// `test -f`: a regular file, through symbolic links.
fn regular_file(path: String) -[FS]> Bool Never! {
    files.is_file(path) || (files.is_symlink(path) && files.exists(path) && !files.is_dir(path))
}

fn file_bytes(path: String) -[FS]> Int Never! {
    if files.read_bytes(path) == {
        .Ok(bytes) -> bytes.len()
        .Err(_) -> 0
    }
}

fn check_size(workload: String, metric: String, baseline: Int, current: Int, percent: Int) -[IO]> Bool Never! {
    limit :: baseline + (baseline * percent + 99) /% 100
    if current > limit {
        term.eprint("REGRESSION {workload} {metric}: {baseline} -> {current} (limit {limit}, +{percent}%)")
        return false
    }
    true
}

fn check_rows(root: String, text: String, scratch: String, run_dir: String) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    failures := 0
    rows := 0
    seen := [String]{}
    loop line in read_lines(text) {
        row :: row_fields(line)
        if row.version == "" || row.version.starts_with("#") -> next
        if row.version == "version" -> next
        if row.version != "1" {
            shown :: if row.version == "" -> "missing" else -> row.version
            return fail("unsupported baseline row version: {shown}")
        }
        if !valid_workload(row.workload) -> return fail("invalid workload: {row.workload}")
        if seen.contains(row.workload) -> return fail("duplicate workload: {row.workload}")
        &seen.push(row.workload.copy())
        if row.source.starts_with("/") || row.source.contains("..") -> return fail("unsafe workload source: {row.source}")
        source_path :: "{root}/{row.source}"
        if !regular_file(source_path) -> return fail("missing workload source: {row.source}")
        if !valid_hash(row.source_hash) -> return fail("invalid source hash: {row.source}")
        source_bytes :: files.read_bytes(source_path) ?? [U8]{}
        if row.source_hash != crypto.sha256(source_bytes).hex() -> return fail("source changed: {row.source}")
        values :: [String]{row.wasm, row.glue, row.runtime, row.bundle, row.regression}
        loop value in values {
            if !all_digits(value) -> return fail("invalid baseline value for {row.workload}")
        }
        wasm_base :: number(row.wasm)
        glue_base :: number(row.glue)
        runtime_base :: number(row.runtime)
        bundle_base :: number(row.bundle)
        regression :: number(row.regression)
        if !(wasm_base > 0 && glue_base > 0 && runtime_base > 0 && bundle_base == wasm_base + glue_base + runtime_base) -> return fail("invalid bundle totals: {row.workload}")
        if regression > 100 -> return fail("regression limit exceeds 100%: {row.workload}")

        case_dir :: "{run_dir}/{row.workload}"
        if files.create_dir_all(case_dir) == {
            .Ok(_) -> {}
            .Err(error) -> return fail("cannot create {case_dir}: {error}")
        }
        if files.write_bytes("{case_dir}/main.jet", source_bytes) == {
            .Ok(_) -> {}
            .Err(error) -> return fail("cannot copy {row.source}: {error}")
        }
        build :: process.cmd([String]{"sh", "-c", "exec \"$0\" jet build --target=web main.jet >build.log 2>&1", "{root}/{JET_ENV}"})
            .cwd(case_dir)
            .env("JET_ROOT", root)
            .env("TMPDIR", scratch)
        built :: if build.run() == {
            .Ok(receipt) -> receipt.code == 0
            .Err(_) -> false
        }
        if !built {
            log :: files.read_bytes("{case_dir}/build.log") ?? [U8]{}
            errors := term.stderr()
            &errors.write(String.from_bytes_lossy(first_lines(log, 120))).drop("web bundle stderr")
            return fail("build failed: {row.workload}")
        }
        loop artifact in ARTIFACTS {
            artifact_path :: "{case_dir}/build/{artifact}"
            if !files.is_file(artifact_path) -> return fail("missing regular artifact: {row.workload}/{artifact}")
        }
        wasm_current :: file_bytes("{case_dir}/build/app.wasm")
        glue_current :: file_bytes("{case_dir}/build/app.js")
        runtime_current :: file_bytes("{case_dir}/build/jet_dom_runtime.js")
        bundle_current :: wasm_current + glue_current + runtime_current
        print("{row.workload}\twasm={wasm_current}\tglue={glue_current}\truntime={runtime_current}\tbundle={bundle_current}")
        if !check_size(row.workload, "wasm", wasm_base, wasm_current, regression) -> failures += 1
        if !check_size(row.workload, "glue", glue_base, glue_current, regression) -> failures += 1
        if !check_size(row.workload, "runtime", runtime_base, runtime_current, regression) -> failures += 1
        if !check_size(row.workload, "bundle", bundle_base, bundle_current, regression) -> failures += 1
        rows += 1
    }
    if rows != 3 -> return fail("expected 3 web workloads, got {rows}")
    if failures != 0 -> return fail("{failures} size regression(s)")
    print("web bundle gate: pass workloads={rows}")
    0
}

fn web_bundle_check() -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    root :: files.cwd() ?? return fail("cannot read the working directory: {err}")
    baseline_path :: "{root}/{BASELINE}"
    text :: if files.read(baseline_path) == {
        .Ok(value) -> value
        .Err(_) -> ""
    }
    if text == "" -> return fail("missing baseline: {BASELINE}")
    if !executable("{root}/{JET_ENV}") -> return fail("missing Jet environment: {JET_ENV}")
    if line_at(text, 2) != EXPECTED_HEADER -> return fail("baseline schema drifted")
    home :: process.env_get_or("HOME", "")
    scratch :: process.env_get_or("TMPDIR", "")
    scratch_root :: if scratch == "" -> "{home}/.cache/jet-dev/scratch" else -> scratch
    created :: process.cmd([String]{"mkdir", "-p", scratch_root.copy()}).run() ?? return fail("cannot create {scratch_root}")
    if created.code != 0 {
        passthrough(created)
        return 1
    }
    made :: process.cmd([String]{"mktemp", "-d", "{scratch_root}/web-bundle.XXXXXX"}).run() ?? return fail("cannot create a run directory under {scratch_root}")
    if made.code != 0 {
        passthrough(made)
        return 1
    }
    run_dir :: made.output.trim()
    code :: check_rows(root, text, scratch_root, run_dir)
    files.rmtree(run_dir).drop("web bundle run directory")
    code
}

fn run() {
    code :: web_bundle_check()
    if code != 0 -> process.exit(code)
}

#Test("baseline rows split like a tab-separated shell read") {
    row :: row_fields("\t1\tcounter\t\tsrc/main.jet\tabc\t1\t2\t3\t6\t5\t9\t")
    assert_eq(row.source, "src/main.jet")
    assert_eq(row.bundle, "6")
    assert_eq(row.regression, "5\t9")
    assert_eq(read_lines("a\nb\nc").join(","), "a,b")
}
