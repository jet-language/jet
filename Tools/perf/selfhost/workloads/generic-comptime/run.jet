Pair: struct<T> {
    left: T
    right: T
}

identity: fn<T>(value: T) -> T { value.copy() }

sum_pair: fn(pair: Pair<Int>) -> Int { pair.left + pair.right }

make_table: fn() -> [Int] {
    values := [Int]{}
    loop i in 0..7 -> &values.push(i * i % 7)
    return values
}

@table: make_table()

run: fn() {
    pair: Pair<Int>{left: 17, right: 25}
    first: identity(pair.left)
    print("generic_sum={sum_pair(pair)} first={first}")
    print("comptime_value={@table[3]} fuel={@table.len()}")
}
