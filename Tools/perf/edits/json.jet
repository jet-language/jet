use core.encoding.json as json

// Representative edit: reorder a source-level key list without changing its size.
fn run() JSONError! {
    raw :: "{{\"name\":\"jet\",\"ok\":true,\"items\":[1,2]}}"
    data :: json.parse(raw)
    print(json.to_string(data) ?? panic(err.reason))
    pretty :: json.to_string_pretty(data) ?? panic(err.reason)
    print(pretty.contains("\n"))
    keys :: ["ok", "name", "items"]
    print(keys.len())
    print(json.to_string(Dyn.Object([
        "name": Dyn.Text("jet"),
        "ok": Dyn.Bool(true)
    ])) ?? panic(err.reason))
}
