// The kernel spelling of the zero-cost pair (Tools/perf/CodegenCeiling.jet):
// each memory step goes through kernel.jet's owners and the Views they lend.
// direct/main.jet is this file with each step written in place. Each
// function below runs its loops in its own body and is called through a
// function value, so it keeps its own symbol; `run` also loops in its own
// body.
#CLI
Args: struct {
    n: Int
}

WORDS: 1024

ROUNDS: 64

PAGE_BYTES: 65536

// Allocate, write, read and free: one block of 1 to 64 words per turn.
churn: fn(n: Int) -> Int {
    total := I64{0}
    loop i in 0..<n {
        count: 1 + i.bit_and(63)
        words := Words.claim(count) ?? panic("no memory")
        words.set(0, I64{i})
        words.set(count - 1, I64{count})
        total = wrapping(total + words.get(0) + words.get(count - 1))
        close(words)
    }
    Int{total}
}

// Resize: one word appended per turn, the block doubling when full.
grow: fn(n: Int) -> Int {
    words := Words.claim(4) ?? panic("no memory")
    used := 0
    loop i in 0..<n {
        if used == words.len() && !words.grow() -> panic("no memory")
        words.set(used, I64{i})
        used += 1
    }
    total := I64{0}
    loop at in 0..<used -> total = wrapping(total + words.get(at))
    close(words)
    Int{total}
}

// Fill, compare, copy and read whole blocks.
scan: fn(n: Int) -> Int {
    a := Words.claim(WORDS) ?? panic("no memory")
    b := Words.claim(WORDS) ?? panic("no memory")
    b.set_all(I64{0})
    total := I64{0}
    loop pass in 0..<n {
        a.set_all(I64{pass})
        a.set(pass.bit_and(WORDS - 1), I64{-1})
        if a.same(b) -> total = wrapping(total + 1)
        b.copy_from(a)
        if a.same(b) -> total = wrapping(total + 1)
        values: b.view()
        loop at in 0..<values.len() -> total = wrapping(total + values[at])
    }
    close(a)
    close(b)
    Int{total}
}

// The atomic word: add, load, compare-exchange and store.
tally: fn(n: Int) -> Int {
    word: Ticks.start()
    total := I64{0}
    loop _ in 0..<n {
        loop round in 0..<ROUNDS {
            total = wrapping(total + word.bump(I64{round.bit_and(31)}))
            seen: word.seen()
            if word.trade(seen, wrapping(seen + 1)) -> total = wrapping(total + 1)
        }
        word.reset()
    }
    Int{total}
}

// Map, write, read and unmap fresh pages.
pages: fn(n: Int) -> Int {
    total := I64{0}
    loop i in 0..<n {
        mapping := Pages.map(PAGE_BYTES) ?? panic("no mapping")
        last: mapping.len() - 1
        mapping.set(i.bit_and(last), I64{i})
        mapping.set(last, I64{last})
        total = wrapping(total + mapping.get(i.bit_and(last)) + mapping.get(last))
        close(mapping)
    }
    Int{total}
}

NAMES: [String]{"churn", "grow", "scan", "tally", "pages"}

run: fn(args: Args) {
    work: [fn(Int) -> Int]{churn, grow, scan, tally, pages}
    loop index in 0..<work.len() -> print("{NAMES[index]} {work[index](args.n)}")
    count: if args.n > 0 -> args.n else -> 1
    words := Words.claim(count) ?? panic("no memory")
    words.set_all(I64{3})
    total := I64{0}
    values: words.view()
    loop at in 0..<values.len() -> total = wrapping(total + values[at])
    print("run {total}")
    close(words)
}
