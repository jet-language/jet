// Native O1 cell apply_calls (closures, indirect calls): a function value and
// a capturing lambda called through `fn(Int) -> Int` parameters in a hot loop.
fn apply(f: fn(Int) -> Int, x: Int) -> Int { f(x) }

fn step(x: Int) -> Int { (x * 5 + 3) % 1000003 }

fn run() {
    offset :: 7
    acc := 0
    x := 1
    loop _ in 0..<10000000 {
        x = apply(step, x)
        acc += apply(y -> y + offset, x) % 11
    }
    print("{x} {acc}")
}
