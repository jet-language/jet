// Native O1 cell list_reuse (collections; Tools/perf/function-boundary
// list-reuse with n fixed): the caller owns one [Int] buffer and the callee
// refills it in place.
build_into: fn(out: &[Int], seed: Int, count: Int) {
    &out.clear()
    loop i in 0..<count -> &out.push(seed + i)
}

run: fn() {
    acc := 0
    xs := [Int]{}
    loop i in 0..<200000 {
        build_into(&xs, i, 256)
        loop x in xs -> acc += x
    }
    print(acc)
}
