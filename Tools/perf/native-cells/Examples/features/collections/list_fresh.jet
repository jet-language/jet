// Native O1 cell list_fresh (collections; Tools/perf/function-boundary
// list-fresh with n fixed): a fresh 256-element [Int] per call, dropped each
// iteration.
fn build(seed: Int, count: Int) -> [Int] {
    out := [Int]{}
    loop i in 0..<count -> &out.push(seed + i)
    out
}

fn run() {
    acc := 0
    loop i in 0..<200000 {
        xs :: build(i, 256)
        loop x in xs -> acc += x
    }
    print(acc)
}
