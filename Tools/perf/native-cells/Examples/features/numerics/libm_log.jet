// Native O1 cell libm_log (numerics.libm): math.ln over 4,000,000 arguments
// in (0, 1e6]; prints the bits of their sum, musl 1.2.5's on every tier.
use {
    math: core.math
}

run: fn() {
    sum := Float{0.0}
    loop i in 0..<4000000 -> sum = sum + math.ln(Float.from_int(i + 1) * 0.25)
    print(math.to_bits(sum))
}
