// Native O1 cell libm_cos (numerics.libm): math.cos over 4,000,000 arguments
// in [-100, 100); prints the bits of their sum, musl 1.2.5's on every tier.
use {
    math: core.math
}

run: fn() {
    sum := Float{0.0}
    loop i in 0..<4000000 -> sum = sum + math.cos(Float.from_int(i) * 0.00005 - 100.0)
    print(math.to_bits(sum))
}
