// Native O1 cell libm_exp (numerics.libm): math.exp over 4,000,000 arguments
// in [-700, 700); prints the bits of their sum, musl 1.2.5's on every tier.
use {
    math: core.math
}

run: fn() {
    sum := Float{0.0}
    loop i in 0..<4000000 -> sum = sum + math.exp(Float.from_int(i) * 0.00035 - 700.0)
    print(math.to_bits(sum))
}
