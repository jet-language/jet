// Native O1 cell libm_pow (numerics.libm): Float pow over 4,000,000 argument
// pairs, bases in (0, 100] and exponents in [-10, 10); prints the bits of
// their sum, musl 1.2.5's on every tier.
use {
    math: core.math
}

run: fn() {
    sum := Float{0.0}
    loop i in 0..<4000000 {
        base: Float.from_int(i %% 4000 + 1) * 0.025
        exponent: Float.from_int(i /% 4000) * 0.02 - 10.0
        sum = sum + base.pow(exponent)
    }
    print(math.to_bits(sum))
}
