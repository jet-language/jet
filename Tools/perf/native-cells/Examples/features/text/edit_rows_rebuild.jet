// Native O1 cell edit_rows_rebuild (text; paired with edit_rows): the same
// rows, each built as a new String and prefixed by building another.
run: fn() {
    total := 0
    loop i in 0..<200000 {
        line := ""
        line += "{i % 97},{i % 89},{i % 83}"
        line = "> {line}"
        total += line.count_bytes()
    }
    print("bytes {total}")
}
