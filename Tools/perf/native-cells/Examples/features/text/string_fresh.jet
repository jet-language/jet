// Native O1 cell string_fresh (text; Tools/perf/function-boundary
// string-fresh with n fixed): a String of 32-63 appends built per call and
// dropped each iteration.
fn render(seed: Int) -> String {
    out := ""
    loop i in 0..<(32 + seed % 32) {
        if (seed + i) % 2 == 0 -> out += "ab" else -> out += "xyz"
    }
    out
}

fn run() {
    acc := 0
    loop i in 0..<300000 {
        text :: render(i)
        acc += text.len()
    }
    print(acc)
}
