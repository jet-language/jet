use core.files as files
use core.time as time
use core.sys as sys

fn kit_steps_loop_words(text: String) -> [String]? {
    tokens :: kit_steps_tokens(kit_steps_body(text)) ?? return None
    if tokens.len() < 5 -> return None
    if tokens[1].text != "line" -> return kit_steps_words(kit_steps_body(text))
    binding :: tokens.len() - 2
    if tokens[binding].text != "as" -> return None
    end := binding
    label := ""
    if binding >= 4 && tokens[binding - 2].text == "of" {
        end = binding - 2
        label = tokens[binding - 1].text
    }
    if end <= 2 -> return None
    selector :: kit_steps_byte_slice(text, tokens[2].start, tokens[end - 1].end).trim().copy()
    if label == "" -> return Val(["for", "line", selector, "as", tokens[binding + 1].text])
    Val(["for", "line", selector, "of", label, "as", tokens[binding + 1].text])
}
fn kit_steps_block_end(steps: [KitStep], start: Int) -> Int {
    kind :: steps[start].action
    depth := 1
    cursor := start + 1
    loop cursor < steps.len() {
        if steps[cursor].action == kind -> depth += 1
        if steps[cursor].action == ("end {kind}") -> depth -= 1
        if depth == 0 -> return cursor
        cursor += 1
    }
    steps.len()
}

fn kit_steps_loop_valid(words: [String]) -> Bool {
    if words.len() < 5 || words[0] != "for" -> return false
    if words[words.len() - 2] != "as" || !kit_steps_env_name(words[words.len() - 1]) -> return false
    if words[1] == "file" {
        end :: if words[words.len() - 3] == "sorted" -> words.len() - 3 else -> words.len() - 2
        return end >= 3 && kit_steps_entries_valid(words.slice(2, end))
    }
    if words[1] != "line" || !kit_steps_loop_subject_valid(words[2], words.len() == 7) -> return false
    words.len() == 5 || (words.len() == 7 && words[3] == "of" && words[4] != "" && !words[4].contains(" ") && !words[4].contains("\t"))
}

fn kit_steps_loop_subject_valid(text: String, named: Bool) -> Bool {
    words :: kit_steps_words(text) ?? return false
    if words.len() == 0 || !kit_steps_subject_valid(words[0]) -> return false
    subject :: kit_steps_subject(words[0])
    if subject == "file" -> return !named && words.len() == 2 && kit_steps_relative_path(words[1])
    words.len() == 1 && subject != "file?" && subject != "files"
}

fn kit_steps_repeat_valid(words: [String], text: String) -> Bool {
    if words.len() != 11 || words[0] != "repeat" || words[1] != "while" -> return false
    if words[5] != "timeout" || words[7] != "every" || words[9] != "fail" -> return false
    if kit_steps_duration_ns(words[6]) == None || kit_steps_duration_ns(words[8]) == None -> return false
    tokens :: kit_steps_tokens(kit_steps_body(text)) ?? return false
    if tokens.len() != 11 || text.bytes()[tokens[10].start] != (U8{34}) -> return false
    if words[2] == "file:" -> return kit_steps_relative_path(words[3]) && kit_expect_named(["exists", "absent"], words[4])
    words[2] == "process" && (words[4] == "alive" || kit_steps_process_nonzombie_mode(words[4]))
}

fn kit_steps_loop_values(step: KitStep, context: KitStepCtx, state: KitStepState) -> [String] Err! {
    words :: step.argv
    if words[1] == "file" {
        directory :: kit_steps_work_path(words[2], context.env, context.work, context.scratch, state.built) ?? return Err("loop directory escapes work")
        sorted :: words[words.len() - 3] == "sorted"
        end :: if sorted -> words.len() - 3 else -> words.len() - 2
        paths := kit_steps_entries(directory, words.slice(2, end)) ?? return Err("{err}")
        if sorted -> &paths.sort_by(path -> files.basename(path))
        return Ok(paths)
    }
    selector_words :: kit_steps_words(words[2]) ?? return Err("invalid loop subject")
    selector :: selector_words[0]
    source := state.last.stdout
    subject :: kit_steps_subject(selector)
    if subject == "file" {
        path :: kit_steps_runtime_expand(selector_words[1], context, state) ?? return Err("loop file token unavailable")
        location :: kit_steps_work_path(path, context.env, context.work, context.scratch, state.built) ?? return Err("loop file escapes work")
        source = files.read(location) ?? return Err("loop file read: {err}")
    } else if subject.starts_with("cap:") -> source = kit_steps_captured_subject(kit_steps_byte_slice(subject, 4, subject.count_bytes()), state.captures) ?? return Err("loop capture unavailable")
    else if words.len() == 7 -> source = kit_steps_history_stream(words[4], subject, state.history, true) ?? return Err("loop step label unavailable")
    else -> source = kit_steps_select_stream(state.last.stdout, state.last.stderr, subject)
    transformed :: kit_steps_transform(source, kit_steps_subject_transform(selector)) ?? return Err("loop subject transform failed")
    Ok(kit_steps_rust_lines(transformed))
}

fn kit_steps_loop_bind(frame: KitLoopFrame, state: KitStepState) -> KitStepState {
    result := state
    result.bindings = frame.bindings
    value :: frame.values[frame.position]
    &result.bindings.push(KitCapture{name: frame.name, value: KitCapturedValue.Text(value)})
    if frame.kind == "file" {
        &result.bindings.push(KitCapture{name: "{frame.name}.path", value: KitCapturedValue.Text(value)})
        &result.bindings.push(KitCapture{name: "{frame.name}.name", value: KitCapturedValue.Text(files.basename(value))})
        &result.bindings.push(KitCapture{name: "{frame.name}.stem", value: KitCapturedValue.Text(files.stem(value))})
    }
    result
}

fn kit_steps_loop_restore(frame: KitLoopFrame, state: KitStepState) -> KitStepState {
    result := state
    restored := frame.captures
    loop capture in state.captures {
        if !capture.aggregate -> next
        found := false
        loop index in 0..<restored.len() {
            if restored[index].name == capture.name {
                restored[index] = capture
                found = true
            }
        }
        if !found -> &restored.push(capture)
    }
    result.captures = restored
    result.bindings = frame.bindings
    result
}

fn kit_steps_repeat_check(step: KitStep, context: KitStepCtx, state: KitStepState) -> KitVerdict {
    path :: kit_steps_runtime_expand(step.argv[3], context, state) ?? return kit_expect_verdict("ERROR", "repeat token unavailable")
    if step.argv[2] == "file:" {
        location :: kit_steps_work_path(path, context.env, context.work, context.scratch, state.built) ?? return kit_expect_verdict("ERROR", "repeat file escapes work")
        return if files.exists(location) == (step.argv[4] == "exists") -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "")
    }
    pid :: Int.parse(path) ?? return kit_expect_verdict("ERROR", "repeat pid is not an integer")
    active :: if step.argv[4] == "alive" -> kit_steps_process_alive(pid) else -> kit_steps_process_nonzombie(pid, step.argv[4])
    if active -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "")
}

fn kit_steps_process_alive(pid: Int) -> Bool {
    if pid <= 0 -> return false
    #Unsafe("kill(pid, 0) observes the case-owned child without sending a signal") {
        sys.kill(pid, 0) ?? return false
    }
    true
}

fn kit_steps_process_nonzombie_mode(mode: String) -> Bool {
    mode == "alive-nonzombie" || mode == "proc-readable-nonzombie"
}

// Exact services law: last ')' state Z is dead; every other result defers to
// kill0. Exact agent law: unreadable is dead, last ") " state Z is dead,
// and every other readable result is live without consulting kill0.
// None means deferred services kill0, not a false or malformed predicate.
fn kit_steps_process_nonzombie_probe(stat: String?, mode: String) -> Bool? {
    readable :: mode == "proc-readable-nonzombie"
    text :: stat ?? return if readable -> Val(false) else -> None
    bytes :: text.bytes()
    end := -1
    loop (index, byte) in bytes {
        if byte == (U8{41}) && (!readable || (index + 1 < bytes.len() && bytes[index + 1] == (U8{32}))) -> end = index
    }
    if end < 0 -> return if readable -> Val(true) else -> None
    cursor := end + 1
    if readable -> cursor += 1
    loop cursor < bytes.len() {
        scalar :: kit_steps_scalar(bytes, cursor)
        if !kit_steps_unicode_space(scalar.value) -> break
        cursor = scalar.next
    }
    if cursor < bytes.len() {
        scalar :: kit_steps_scalar(bytes, cursor)
        if scalar.value == 90 && (scalar.next == bytes.len() || kit_steps_unicode_space(kit_steps_scalar(bytes, scalar.next).value)) -> return Val(false)
    }
    if readable -> Val(true) else -> None
}

// Callers guard nonZ modes on Linux before expanding the PID or observing it.
fn kit_steps_process_nonzombie(pid: Int, mode: String) -> Bool {
    stat :: files.read("/proc/{pid}/stat") ?? { return kit_steps_process_nonzombie_probe(None, mode) ?? kit_steps_process_alive(pid) }
    kit_steps_process_nonzombie_probe(Val(stat), mode) ?? kit_steps_process_alive(pid)
}

fn kit_steps_loop_initialize(step: KitStep, previous: KitStepState) -> KitStepState {
    state := previous
    loop name in step.aggregate_names {
        if kit_steps_capture_named(name, state.captures) == None -> &state.captures.push(KitCapture{name: name, value: KitCapturedValue.Text(""), aggregate: true})
    }
    state
}
