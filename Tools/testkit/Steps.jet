use "Exec" as exec
use "Expect" as expect
use core.files as files

struct Assertion {
    stream: String
    path: String
    mode: String
    value: String
}

struct Step {
    argv: [String]
    stdin: String
    exit: String
    assertions: [Assertion]
    label: String{""}
}

struct Plan {
    requires: [String]
    fixture: String
    environment: [String]
    normalize: [String]
    compile_only: Bool
    ref_audit: String
    refused: String
    steps: [Step]
    error: String
}

// Quotes preserve whitespace and empty argv. Backslash escapes inside and
// outside quotes; the kit never delegates argument parsing to a shell.
fn words(text: String) -> [String]? {
    result := [String]{}
    word := ""
    quote := ""
    escape := false
    active := false
    loop character in text.chars() {
        c :: "{character}"
        if escape {
            word = "{word}{c}"
            escape = false
            active = true
            next
        }
        if c == "\\" {
            escape = true
            active = true
            next
        }
        if quote != "" {
            if c == quote -> quote = ""
            else -> word = "{word}{c}"
            next
        }
        if c == "\"" || c == "'" {
            quote = c
            active = true
            next
        }
        if c == " " || c == "\t" {
            if active {
                &result.push(word)
                word = ""
                active = false
            }
            next
        }
        word = "{word}{c}"
        active = true
    }
    if quote != "" || escape -> return None
    if active -> &result.push(word)
    Val(result)
}

fn parse(source: String) -> Plan {
    plan := Plan{requires: [], fixture: "", environment: [], normalize: ["paths"], compile_only: false, ref_audit: "", refused: "", steps: [], error: ""}
    line_number := 0
    loop raw in source.split("\n") {
        line_number += 1
        line :: raw.trim()
        if line == "" || line.starts_with("#") -> next
        colon :: line.index(":") ?? -1
        if colon < 0 {
            plan.error = "line {line_number}: missing ':'"
            return plan
        }
        key :: line.slice(0, colon).trim()
        value :: line.slice(colon + 1, line.len()).trim()
        if key == "requires" {
            &plan.requires.push(value)
            next
        }
        if key == "fixture" {
            plan.fixture = value
            next
        }
        if key == "env" {
            &plan.environment.push(value)
            next
        }
        if key == "refused" {
            plan.refused = value
            next
        }
        if key == "ref-audit" {
            if value.slice(0, value.index(" #") ?? value.len()).trim() != "bridge" {
                plan.error = "line {line_number}: unknown ref-audit"
                return plan
            }
            plan.ref_audit = "bridge"
            next
        }
        if key == "normalize" {
            if value != "paths" && value != "argv0" {
                plan.error = "line {line_number}: unknown normalizer"
                return plan
            }
            &plan.normalize.push(value)
            next
        }
        if key == "run" {
            if value != "none" {
                plan.error = "line {line_number}: run must be none"
                return plan
            }
            plan.compile_only = true
            next
        }
        if key == "copy" {
            paths :: words(value) ?? {
                plan.error = "line {line_number}: invalid copy paths"
                return plan
            }
            if paths.len() != 2 {
                plan.error = "line {line_number}: copy needs source and destination"
                return plan
            }
            &plan.steps.push(Step{argv: ["copy", paths[0], paths[1]], stdin: "", exit: "0", assertions: []})
            next
        }
        if key == "step" || key.starts_with("step ") {
            label :: if key == "step" -> "" else -> key.slice(5, key.len()).trim()
            if key != "step" && (label == "" || label.contains(" ") || label.contains("\t")) {
                plan.error = "line {line_number}: step label must be one word"
                return plan
            }
            loop previous in plan.steps {
                if label != "" && previous.label == label {
                    plan.error = "line {line_number}: duplicate step label {label}"
                    return plan
                }
            }
            argv :: words(value) ?? {
                plan.error = "line {line_number}: unclosed argv quoting"
                return plan
            }
            if argv.len() == 0 {
                plan.error = "line {line_number}: empty step"
                return plan
            }
            &plan.steps.push(Step{argv: argv, stdin: "", exit: "0", assertions: [], label: label})
            next
        }
        if plan.steps.len() == 0 {
            plan.error = "line {line_number}: assertion without step"
            return plan
        }
        i :: plan.steps.len() - 1
        if key == "stdin" {
            plan.steps[i].stdin = value
            next
        }
        if key == "exit" {
            if value != "nonzero" && (Int.parse(value) ?? -999999) == -999999 {
                plan.error = "line {line_number}: invalid exit"
                return plan
            }
            plan.steps[i].exit = value
            next
        }
        if key != "stdout" && key != "stderr" && key != "file" {
            plan.error = "line {line_number}: unknown key {key}"
            return plan
        }
        parts :: words(value) ?? {
            plan.error = "line {line_number}: invalid assertion quoting"
            return plan
        }
        offset :: if key == "file" -> 1 else -> 0
        if parts.len() <= offset {
            plan.error = "line {line_number}: missing assertion"
            return plan
        }
        mode :: parts[offset]
        if mode != "=" && mode != "==" && mode != "!=" && mode != "one-of" && mode != "~" && mode != "!~" && mode != "empty" && mode != "exists" && mode != "absent" {
            plan.error = "line {line_number}: unknown assertion {mode}"
            return plan
        }
        data := ""
        if mode == "=" || mode == "==" || mode == "!=" || mode == "one-of" || mode == "~" || mode == "!~" {
            if parts.len() <= offset + 1 {
                plan.error = "line {line_number}: missing assertion value"
                return plan
            }
            if mode == "~" || mode == "one-of" {
                reason_start :: value.index(" #") ?? value.len()
                if reason_start == value.len() || value.slice(reason_start + 2, value.len()).trim() == "" {
                    plan.error = "line {line_number}: nondeterministic assertion requires a reason comment"
                    return plan
                }
            }
            start :: (value.index(mode) ?? panic("parsed assertion mode missing")) + mode.len()
            data = value.slice(start, value.len()).trim()
            // Inline comments document nondeterministic substring assertions.
            if mode == "~" || mode == "!~" || mode == "one-of" -> data = data.slice(0, data.index(" #") ?? data.len()).trim()
            if mode != "one-of" && (data.starts_with("\"") || data.starts_with("'")) -> data = (words(data) ?? [data])[0]
        }
        if mode == "==" || mode == "!=" {
            if mode == "!=" && key != "file" {
                plan.error = "line {line_number}: != is file-only"
                return plan
            }
            if parts.len() != offset + 2 {
                plan.error = "line {line_number}: relation needs one reference"
                return plan
            }
            data = parts[offset + 1]
            if key != "file" {
                known := false
                loop (index, previous) in plan.steps {
                    if index < i && previous.label == data -> known = true
                }
                if !known {
                    plan.error = "line {line_number}: unknown prior step label {data}"
                    return plan
                }
            }
        }
        path :: if key == "file" -> parts[0] else -> ""
        &plan.steps[i].assertions.push(Assertion{stream: key, path: path, mode: mode, value: data})
    }
    plan
}

// Golden sidecars allow implicit builds. Standalone cases must name the
// public build command before consuming its reported executable artifact.
fn parse_case(source: String) -> Plan {
    plan := parse(source)
    if plan.error != "" -> return plan
    built_available := false
    loop step in plan.steps {
        if step.argv[0] == "jet" && step.argv.len() > 1 && step.argv[1] == "build" -> built_available = true
        if step.argv[0] == "built" && !built_available {
            plan.error = "built step requires an earlier jet build"
            return plan
        }
    }
    plan
}

struct CapturedStep {
    label: String
    stdout: String
    stderr: String
}

fn normalized_stream(actual: String, normalize: [String], env: exec.Env, work: String, scratch: String, built: String, source_name: String) -> String {
    text := actual
    if expect.named(normalize, "argv0") && built != "" -> text = expect.argv0(text, files.basename(built), source_name)
    if expect.named(normalize, "paths") -> text = expect.paths(text, work, env.root, scratch)
    text
}

fn case_file(path: String, env: exec.Env, work: String, scratch: String, built: String) -> String? {
    resolved :: files.collapse(files.join(work, expand(path, env, work, scratch, built)))
    if resolved != work && !resolved.starts_with("{work}/") -> return None
    Val(resolved)
}

fn copy_case_file(source: String, destination: String, env: exec.Env, work: String, scratch: String, built: String) -> exec.Run {
    from :: case_file(source, env, work, scratch, built) ?? return exec.failed("copy source escapes work directory")
    to :: case_file(destination, env, work, scratch, built) ?? return exec.failed("copy destination escapes work directory")
    bytes :: files.read_bytes(from) ?? return exec.failed("copy read: {err}")
    files.create_dir_all(files.dirname(to)) ?? return exec.failed("copy mkdir: {err}")
    files.write_bytes(to, bytes) ?? return exec.failed("copy write: {err}")
    exec.Run{stdout: "", stderr: "", code: 0, signal: None, timed_out: false, error: ""}
}

fn expand(value: String, env: exec.Env, work: String, scratch: String, built: String) -> String {
    value.replace("{{work}}", work).replace("{{root}}", env.root).replace("{{scratch}}", scratch)
        .replace("{{jetpack}}", env.jetpack).replace("{{jet}}", env.jet).replace("{{built}}", built)
}

fn required(plan: Plan, env: exec.Env, work: String, scratch: String) -> expect.Verdict? {
    loop requirement in plan.requires {
        missing :: exec.requires(requirement, env, work, scratch)
        if missing != None -> return missing
    }
    None
}

fn bless_plan(plan: Plan, id: String, bless: expect.Bless) -> expect.Verdict? {
    if !bless.all && !expect.named(bless.ids, id) -> return None
    loop step in plan.steps {
        loop assertion in step.assertions {
            if assertion.mode == "one-of" -> return Val(expect.verdict("REFUSED", "one-of snapshots: edit by hand"))
        }
    }
    None
}

struct Outcome {
    verdict: expect.Verdict
    run: exec.Run
    tier: String{"-"}
}

fn environment(plan: Plan, env: exec.Env, work: String, scratch: String, built: String) -> [exec.EnvVar] {
    overlay := [exec.EnvVar]{}
    loop assignment in plan.environment {
        equals :: assignment.index("=") ?? -1
        if equals <= 0 -> panic("env requires NAME=VALUE")
        name :: assignment.slice(0, equals)
        value :: expand(assignment.slice(equals + 1, assignment.len()), env, work, scratch, built)
        &overlay.push(exec.EnvVar{name: name, value: Val(value)})
    }
    overlay
}

fn invoke_step(step: Step, env: exec.Env, work: String, scratch: String, snapshots: String, built: String, overlay: [exec.EnvVar]) -> exec.Run {
    argv := [String]{}
    loop argument in step.argv -> &argv.push(expand(argument, env, work, scratch, built))
    if argv[0] == "jet" -> argv[0] = env.jet
    if argv[0] == "jetpack" {
        if env.jetpack == "" -> return exec.failed("jetpack binary required")
        argv[0] = env.jetpack
    }
    if argv[0] == "built" {
        if built == "" -> return exec.failed("built step has no artifact")
        argv[0] = built
    }
    stdin :: if step.stdin == "" -> "" else -> files.read(files.join(snapshots, step.stdin)) ?? return exec.failed("stdin snapshot: {err}")
    exec.invoke_with_env(env, argv, work, scratch, stdin, overlay)
}

fn one_of(id: String, directory: String, snapshots: String, actual: String, bless: expect.Bless) -> expect.Verdict {
    if bless.all || expect.named(bless.ids, id) -> return expect.verdict("REFUSED", "one-of snapshots: edit by hand")
    alternatives :: words(snapshots) ?? return expect.verdict("REFUSED", "invalid one-of snapshots")
    if alternatives.len() < 2 -> return expect.verdict("REFUSED", "one-of needs at least two snapshots")
    loop file in alternatives {
        expected :: exec.optional(files.join(directory, file)) ?? return expect.verdict("FAIL", "missing one-of snapshot: {file}")
        if actual == expected -> return expect.verdict("PASS", "")
    }
    expect.verdict("FAIL", "stdout matches none of the exact alternatives")
}

fn check_assertion(assertion: Assertion, id: String, result: exec.Run, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless, normalize: [String], built: String, source_name: String, captured: [CapturedStep]) -> expect.Verdict {
    actual := if assertion.stream == "stderr" -> result.stderr else -> result.stdout
    if assertion.stream == "file" {
        relative :: expand(assertion.path, env, work, scratch, built)
        path :: case_file(assertion.path, env, work, scratch, built) ?? return expect.verdict("REFUSED", "file assertion escapes work directory")
        exists :: files.exists(path)
        if assertion.mode == "exists" -> return if exists -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "missing file: {relative}")
        if assertion.mode == "absent" -> return if !exists -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "unexpected file: {relative}")
        if !exists -> return expect.verdict("FAIL", "missing file: {relative}")
        if assertion.mode == "==" || assertion.mode == "!=" {
            other :: case_file(assertion.value, env, work, scratch, built) ?? return expect.verdict("REFUSED", "file reference escapes work directory")
            if !files.exists(other) -> return expect.verdict("FAIL", "missing file reference: {assertion.value}")
            left :: files.read_bytes(path) ?? return expect.verdict("ERROR", "read assertion file: {err}")
            right :: files.read_bytes(other) ?? return expect.verdict("ERROR", "read reference file: {err}")
            equal :: left == right
            satisfied :: if assertion.mode == "==" -> equal else -> !equal
            return if satisfied -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "file relation failed: {assertion.path} {assertion.mode} {assertion.value}")
        }
        actual = files.read(path) ?? return expect.verdict("ERROR", "read assertion file: {err}")
    }
    actual = normalized_stream(actual, normalize, env, work, scratch, built, source_name)
    if assertion.mode == "==" {
        loop previous in captured {
            if previous.label != assertion.value -> next
            expected :: if assertion.stream == "stderr" -> previous.stderr else -> previous.stdout
            if actual == expected -> return expect.verdict("PASS", "")
            return expect.Verdict{status: "FAIL", detail: "{assertion.stream} differs from step {assertion.value}", diff: expect.unified("step {assertion.value}/{assertion.stream}", expected, actual)}
        }
        return expect.verdict("REFUSED", "unknown prior step label: {assertion.value}")
    }
    if assertion.mode == "=" -> return expect.exact(id, files.join(snapshots, assertion.value), exec.optional(files.join(snapshots, assertion.value)), actual, bless, false)
    if assertion.mode == "one-of" -> return one_of(id, snapshots, assertion.value, actual, bless)
    if assertion.mode == "empty" -> return if actual == "" -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} is not empty")
    if assertion.mode == "~" -> return if actual.contains(assertion.value) -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} missing substring: {assertion.value}")
    if assertion.mode == "!~" -> return if !actual.contains(assertion.value) -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} contains forbidden substring: {assertion.value}")
    expect.verdict("REFUSED", "unsupported assertion: {assertion.mode}")
}

fn check(step: Step, id: String, result: exec.Run, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless, normalize: [String], built: String, source_name: String, captured: [CapturedStep]) -> expect.Verdict {
    failure :: exec.process_failure(result)
    if failure == {
        .Val(value) -> return value
        .None -> {}
    }
    if step.exit == "nonzero" {
        if result.code == 0 -> return expect.verdict("FAIL", "exit 0; expected nonzero")
    } else if result.code != (Int.parse(step.exit) ?? 0) -> return expect.verdict("FAIL", "exit {result.code}; expected {step.exit}")
    loop assertion in step.assertions {
        verdict :: check_assertion(assertion, id, result, env, work, scratch, snapshots, bless, normalize, built, source_name, captured)
        if verdict.status != "PASS" -> return verdict
    }
    expect.verdict("PASS", "")
}

fn execute(plan: Plan, id: String, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless) -> Outcome {
    last := exec.failed("no steps")
    if plan.error != "" -> return Outcome{verdict: expect.verdict("REFUSED", plan.error), run: last}
    requirement :: required(plan, env, work, scratch)
    if requirement == {
        .Val(value) -> return Outcome{verdict: value, run: last}
        .None -> {}
    }
    if plan.compile_only -> return Outcome{verdict: expect.verdict("REFUSED", "run: none is golden-only"), run: last}
    if plan.refused != "" -> return Outcome{verdict: expect.verdict("REFUSED", plan.refused), run: last}
    if plan.steps.len() == 0 -> return Outcome{verdict: expect.verdict("REFUSED", "case has no steps"), run: last}
    blessing :: bless_plan(plan, id, bless)
    if blessing == {
        .Val(value) -> return Outcome{verdict: value, run: last}
        .None -> {}
    }
    if plan.fixture != "" -> exec.copy_tree(files.join(snapshots, plan.fixture), work, true)
    built := ""
    captured := [CapturedStep]{}
    loop step in plan.steps {
        command :: step.argv[0]
        if command == "build" -> return Outcome{verdict: expect.verdict("REFUSED", "build step requires golden entry; write jet build <entry>"), run: last}
        overlay :: environment(plan, env, work, scratch, built)
        if command == "copy" -> last = copy_case_file(step.argv[1], step.argv[2], env, work, scratch, built)
        else -> last = invoke_step(step, env, work, scratch, snapshots, built, overlay)
        // A failed build must not leave a stale artifact for a later built step.
        is_build :: command == "jet" && step.argv.len() > 1 && step.argv[1] == "build"
        if is_build {
            built = ""
            if last.code == 0 {
                loop line in last.stdout.split("\n") {
                    if line.starts_with("built: ") -> built = files.collapse(files.join(work, line.slice(7, line.len()).trim()))
                }
                if built == "" -> return Outcome{verdict: expect.verdict("ERROR", "jet build did not report its executable artifact"), run: last}
            }
        }
        verdict :: check(step, id, last, env, work, scratch, snapshots, bless, plan.normalize, built, "", captured)
        if verdict.status != "PASS" -> return Outcome{verdict: verdict, run: last}
        if step.label != "" {
            &captured.push(CapturedStep{label: step.label,
                stdout: normalized_stream(last.stdout, plan.normalize, env, work, scratch, built, ""),
                stderr: normalized_stream(last.stderr, plan.normalize, env, work, scratch, built, "")})
        }
    }
    Outcome{verdict: expect.verdict("PASS", ""), run: last}
}
