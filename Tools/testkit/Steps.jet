use "Exec" as exec
use "Expect" as expect
use core.files as files

struct Assertion {
    stream: String
    path: String
    mode: String
    value: String
}

struct Step {
    argv: [String]
    stdin: String
    exit: String
    assertions: [Assertion]
}

struct Plan {
    requires: [String]
    fixture: String
    environment: [String]
    normalize: [String]
    compile_only: Bool
    ref_audit: String
    refused: String
    steps: [Step]
    error: String
}

// Quotes preserve whitespace and empty argv. Backslash escapes inside and
// outside quotes; the kit never delegates argument parsing to a shell.
fn words(text: String) -> [String]? {
    result := [String]{}
    word := ""
    quote := ""
    escape := false
    active := false
    loop character in text.chars() {
        c :: "{character}"
        if escape {
            word = "{word}{c}"
            escape = false
            active = true
            next
        }
        if c == "\\" {
            escape = true
            active = true
            next
        }
        if quote != "" {
            if c == quote -> quote = ""
            else -> word = "{word}{c}"
            next
        }
        if c == "\"" || c == "'" {
            quote = c
            active = true
            next
        }
        if c == " " || c == "\t" {
            if active {
                &result.push(word)
                word = ""
                active = false
            }
            next
        }
        word = "{word}{c}"
        active = true
    }
    if quote != "" || escape -> return None
    if active -> &result.push(word)
    Val(result)
}

fn parse(source: String) -> Plan {
    plan := Plan{requires: [], fixture: "", environment: [], normalize: ["paths"], compile_only: false, ref_audit: "", refused: "", steps: [], error: ""}
    line_number := 0
    loop raw in source.split("\n") {
        line_number += 1
        line :: raw.trim()
        if line == "" || line.starts_with("#") -> next
        colon :: line.index(":") ?? -1
        if colon < 0 {
            plan.error = "line {line_number}: missing ':'"
            return plan
        }
        key :: line.slice(0, colon).trim()
        value :: line.slice(colon + 1, line.len()).trim()
        if key == "requires" {
            &plan.requires.push(value)
            next
        }
        if key == "fixture" {
            plan.fixture = value
            next
        }
        if key == "env" {
            &plan.environment.push(value)
            next
        }
        if key == "refused" {
            plan.refused = value
            next
        }
        if key == "ref-audit" {
            if value.slice(0, value.index(" #") ?? value.len()).trim() != "bridge" {
                plan.error = "line {line_number}: unknown ref-audit"
                return plan
            }
            plan.ref_audit = "bridge"
            next
        }
        if key == "normalize" {
            if value != "paths" && value != "argv0" {
                plan.error = "line {line_number}: unknown normalizer"
                return plan
            }
            &plan.normalize.push(value)
            next
        }
        if key == "run" {
            if value != "none" {
                plan.error = "line {line_number}: run must be none"
                return plan
            }
            plan.compile_only = true
            next
        }
        if key == "step" {
            argv :: words(value) ?? {
                plan.error = "line {line_number}: unclosed argv quoting"
                return plan
            }
            if argv.len() == 0 {
                plan.error = "line {line_number}: empty step"
                return plan
            }
            &plan.steps.push(Step{argv: argv, stdin: "", exit: "0", assertions: []})
            next
        }
        if plan.steps.len() == 0 {
            plan.error = "line {line_number}: assertion without step"
            return plan
        }
        i :: plan.steps.len() - 1
        if key == "stdin" {
            plan.steps[i].stdin = value
            next
        }
        if key == "exit" {
            if value != "nonzero" && (Int.parse(value) ?? -999999) == -999999 {
                plan.error = "line {line_number}: invalid exit"
                return plan
            }
            plan.steps[i].exit = value
            next
        }
        if key != "stdout" && key != "stderr" && key != "file" {
            plan.error = "line {line_number}: unknown key {key}"
            return plan
        }
        parts :: words(value) ?? {
            plan.error = "line {line_number}: invalid assertion quoting"
            return plan
        }
        offset :: if key == "file" -> 1 else -> 0
        if parts.len() <= offset {
            plan.error = "line {line_number}: missing assertion"
            return plan
        }
        mode :: parts[offset]
        if mode != "=" && mode != "one-of" && mode != "~" && mode != "!~" && mode != "empty" && mode != "exists" && mode != "absent" {
            plan.error = "line {line_number}: unknown assertion {mode}"
            return plan
        }
        data := ""
        if mode == "=" || mode == "one-of" || mode == "~" || mode == "!~" {
            if parts.len() <= offset + 1 {
                plan.error = "line {line_number}: missing assertion value"
                return plan
            }
            if mode == "~" || mode == "one-of" {
                reason_start :: value.index(" #") ?? value.len()
                if reason_start == value.len() || value.slice(reason_start + 2, value.len()).trim() == "" {
                    plan.error = "line {line_number}: nondeterministic assertion requires a reason comment"
                    return plan
                }
            }
            start :: (value.index(mode) ?? panic("parsed assertion mode missing")) + mode.len()
            data = value.slice(start, value.len()).trim()
            // Inline comments document nondeterministic substring assertions.
            if mode == "~" || mode == "!~" || mode == "one-of" -> data = data.slice(0, data.index(" #") ?? data.len()).trim()
            if mode != "one-of" && (data.starts_with("\"") || data.starts_with("'")) -> data = (words(data) ?? [data])[0]
        }
        path :: if key == "file" -> parts[0] else -> ""
        &plan.steps[i].assertions.push(Assertion{stream: key, path: path, mode: mode, value: data})
    }
    plan
}

fn expand(value: String, env: exec.Env, work: String, scratch: String, built: String) -> String {
    value.replace("{{work}}", work).replace("{{root}}", env.root).replace("{{scratch}}", scratch)
        .replace("{{jetpack}}", env.jetpack).replace("{{jet}}", env.jet).replace("{{built}}", built)
}

fn required(plan: Plan, env: exec.Env, work: String, scratch: String) -> expect.Verdict? {
    loop requirement in plan.requires {
        missing :: exec.requires(requirement, env, work, scratch)
        if missing != None -> return missing
    }
    None
}

fn bless_plan(plan: Plan, id: String, bless: expect.Bless) -> expect.Verdict? {
    if !bless.all && !expect.named(bless.ids, id) -> return None
    loop step in plan.steps {
        loop assertion in step.assertions {
            if assertion.mode == "one-of" -> return Val(expect.verdict("REFUSED", "one-of snapshots: edit by hand"))
        }
    }
    None
}

struct Outcome {
    verdict: expect.Verdict
    run: exec.Run
    tier: String{"-"}
}

fn environment(plan: Plan, env: exec.Env, work: String, scratch: String, built: String) -> [exec.EnvVar] {
    overlay := [exec.EnvVar]{}
    loop assignment in plan.environment {
        equals :: assignment.index("=") ?? -1
        if equals <= 0 -> panic("env requires NAME=VALUE")
        name :: assignment.slice(0, equals)
        value :: expand(assignment.slice(equals + 1, assignment.len()), env, work, scratch, built)
        &overlay.push(exec.EnvVar{name: name, value: Val(value)})
    }
    overlay
}

fn invoke_step(step: Step, env: exec.Env, work: String, scratch: String, snapshots: String, built: String, overlay: [exec.EnvVar]) -> exec.Run {
    argv := [String]{}
    loop argument in step.argv -> &argv.push(expand(argument, env, work, scratch, built))
    if argv[0] == "jet" -> argv[0] = env.jet
    if argv[0] == "jetpack" {
        if env.jetpack == "" -> return exec.failed("jetpack binary required")
        argv[0] = env.jetpack
    }
    if argv[0] == "built" {
        if built == "" -> return exec.failed("built step has no artifact")
        argv[0] = built
    }
    stdin :: if step.stdin == "" -> "" else -> files.read(files.join(snapshots, step.stdin)) ?? return exec.failed("stdin snapshot: {err}")
    exec.invoke_with_env(env, argv, work, scratch, stdin, overlay)
}

fn one_of(id: String, directory: String, snapshots: String, actual: String, bless: expect.Bless) -> expect.Verdict {
    if bless.all || expect.named(bless.ids, id) -> return expect.verdict("REFUSED", "one-of snapshots: edit by hand")
    alternatives :: words(snapshots) ?? return expect.verdict("REFUSED", "invalid one-of snapshots")
    if alternatives.len() < 2 -> return expect.verdict("REFUSED", "one-of needs at least two snapshots")
    loop file in alternatives {
        expected :: exec.optional(files.join(directory, file)) ?? return expect.verdict("FAIL", "missing one-of snapshot: {file}")
        if actual == expected -> return expect.verdict("PASS", "")
    }
    expect.verdict("FAIL", "stdout matches none of the exact alternatives")
}

fn check_assertion(assertion: Assertion, id: String, result: exec.Run, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless, normalize: [String], built: String, source_name: String) -> expect.Verdict {
    actual := if assertion.stream == "stderr" -> result.stderr else -> result.stdout
    if assertion.stream == "file" {
        relative :: expand(assertion.path, env, work, scratch, built)
        path :: files.collapse(files.join(work, relative))
        if path != work && !path.starts_with("{work}/") -> return expect.verdict("REFUSED", "file assertion escapes work directory")
        exists :: files.exists(path)
        if assertion.mode == "exists" -> return if exists -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "missing file: {relative}")
        if assertion.mode == "absent" -> return if !exists -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "unexpected file: {relative}")
        if !exists -> return expect.verdict("FAIL", "missing file: {relative}")
        actual = files.read(path) ?? return expect.verdict("ERROR", "read assertion file: {err}")
    }
    if expect.named(normalize, "argv0") && built != "" {
        name :: files.basename(built)
        actual = expect.argv0(actual, name, source_name)
    }
    if expect.named(normalize, "paths") -> actual = expect.paths(actual, work, env.root, scratch)
    if assertion.mode == "=" -> return expect.exact(id, files.join(snapshots, assertion.value), exec.optional(files.join(snapshots, assertion.value)), actual, bless, false)
    if assertion.mode == "one-of" -> return one_of(id, snapshots, assertion.value, actual, bless)
    if assertion.mode == "empty" -> return if actual == "" -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} is not empty")
    if assertion.mode == "~" -> return if actual.contains(assertion.value) -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} missing substring: {assertion.value}")
    if assertion.mode == "!~" -> return if !actual.contains(assertion.value) -> expect.verdict("PASS", "") else -> expect.verdict("FAIL", "{assertion.stream} contains forbidden substring: {assertion.value}")
    expect.verdict("REFUSED", "unsupported assertion: {assertion.mode}")
}

fn check(step: Step, id: String, result: exec.Run, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless, normalize: [String], built: String, source_name: String) -> expect.Verdict {
    failure :: exec.process_failure(result)
    if failure == {
        .Val(value) -> return value
        .None -> {}
    }
    if step.exit == "nonzero" {
        if result.code == 0 -> return expect.verdict("FAIL", "exit 0; expected nonzero")
    } else if result.code != (Int.parse(step.exit) ?? 0) -> return expect.verdict("FAIL", "exit {result.code}; expected {step.exit}")
    loop assertion in step.assertions {
        verdict :: check_assertion(assertion, id, result, env, work, scratch, snapshots, bless, normalize, built, source_name)
        if verdict.status != "PASS" -> return verdict
    }
    expect.verdict("PASS", "")
}

fn execute(plan: Plan, id: String, env: exec.Env, work: String, scratch: String, snapshots: String, bless: expect.Bless) -> Outcome {
    last := exec.failed("no steps")
    if plan.error != "" -> return Outcome{verdict: expect.verdict("REFUSED", plan.error), run: last}
    requirement :: required(plan, env, work, scratch)
    if requirement == {
        .Val(value) -> return Outcome{verdict: value, run: last}
        .None -> {}
    }
    if plan.compile_only -> return Outcome{verdict: expect.verdict("REFUSED", "run: none is golden-only"), run: last}
    if plan.refused != "" -> return Outcome{verdict: expect.verdict("REFUSED", plan.refused), run: last}
    if plan.steps.len() == 0 -> return Outcome{verdict: expect.verdict("REFUSED", "case has no steps"), run: last}
    blessing :: bless_plan(plan, id, bless)
    if blessing == {
        .Val(value) -> return Outcome{verdict: value, run: last}
        .None -> {}
    }
    if plan.fixture != "" -> exec.copy_tree(files.join(snapshots, plan.fixture), work, true)
    overlay :: environment(plan, env, work, scratch, "")
    loop step in plan.steps {
        if step.argv[0] == "build" || step.argv[0] == "built" -> return Outcome{verdict: expect.verdict("REFUSED", "build/built steps require golden entry"), run: last}
        last = invoke_step(step, env, work, scratch, snapshots, "", overlay)
        verdict :: check(step, id, last, env, work, scratch, snapshots, bless, plan.normalize, "", "")
        if verdict.status != "PASS" -> return Outcome{verdict: verdict, run: last}
    }
    Outcome{verdict: expect.verdict("PASS", ""), run: last}
}
