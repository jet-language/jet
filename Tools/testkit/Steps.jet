use core.files as files


// Quotes preserve whitespace and empty argv. Backslash escapes inside and
// outside quotes; the kit never delegates argument parsing to a shell.
fn kit_steps_words(text: String) -> [String]? {
    result := [String]{}
    word := ""
    quote := ""
    escape := false
    active := false
    loop character in text.chars() {
        c :: "{character}"
        if escape {
            word = "{word}{c}"
            escape = false
            active = true
            next
        }
        if c == "\\" {
            escape = true
            active = true
            next
        }
        if quote != "" {
            if c == quote -> quote = ""
            else -> word = "{word}{c}"
            next
        }
        if c == "\"" || c == "'" {
            quote = c
            active = true
            next
        }
        if c == " " || c == "\t" {
            if active {
                &result.push(word)
                word = ""
                active = false
            }
            next
        }
        word = "{word}{c}"
        active = true
    }
    if quote != "" || escape -> return None
    if active -> &result.push(word)
    Val(result)
}

fn kit_steps_parse(source: String) -> KitPlan {
    plan := KitPlan{requires: [], fixture: "", environment: [], normalize: ["paths"], compile_only: false, ref_audit: "", artifact: "", refused: "", steps: [], error: ""}
    line_number := 0
    loop raw in source.split("\n") {
        line_number += 1
        line :: ~raw.trim()
        if line == "" || line.starts_with("#") -> next
        colon :: line.index(":") ?? -1
        if colon < 0 {
            plan.error = "line {line_number}: missing ':'"
            return plan
        }
        key :: ~line.slice(0, colon).trim()
        value :: ~line.slice(colon + 1, line.len()).trim()
        if key == "requires" {
            &plan.requires.push(value)
            next
        }
        if key == "fixture" {
            plan.fixture = value
            next
        }
        if key == "env" {
            &plan.environment.push(value)
            next
        }
        if key == "refused" {
            plan.refused = value
            next
        }
        if key == "artifact" {
            plan.artifact = value
            next
        }
        if key == "ref-audit" {
            if value.slice(0, value.index(" #") ?? value.len()).trim() != "bridge" {
                plan.error = "line {line_number}: unknown ref-audit"
                return plan
            }
            plan.ref_audit = "bridge"
            next
        }
        if key == "normalize" {
            if value != "paths" && value != "argv0" {
                plan.error = "line {line_number}: unknown normalizer"
                return plan
            }
            &plan.normalize.push(value)
            next
        }
        if key == "run" {
            if value != "none" {
                plan.error = "line {line_number}: run must be none"
                return plan
            }
            plan.compile_only = true
            next
        }
        if key == "step" {
            argv :: kit_steps_words(value) ?? {
                plan.error = "line {line_number}: unclosed argv quoting"
                return plan
            }
            if argv.len() == 0 {
                plan.error = "line {line_number}: empty step"
                return plan
            }
            &plan.steps.push(KitStep{argv: argv, stdin: "", exit: "0", assertions: []})
            next
        }
        if plan.steps.len() == 0 {
            plan.error = "line {line_number}: assertion without step"
            return plan
        }
        i :: plan.steps.len() - 1
        if key == "stdin" {
            plan.steps[i].stdin = value
            next
        }
        if key == "exit" {
            if value != "nonzero" && (Int.parse(value) ?? -999999) == -999999 {
                plan.error = "line {line_number}: invalid exit"
                return plan
            }
            plan.steps[i].exit = value
            next
        }
        if key != "stdout" && key != "stderr" && key != "file" {
            plan.error = "line {line_number}: unknown key {key}"
            return plan
        }
        parts :: kit_steps_words(value) ?? {
            plan.error = "line {line_number}: invalid assertion quoting"
            return plan
        }
        offset :: if key == "file" -> 1 else -> 0
        if parts.len() <= offset {
            plan.error = "line {line_number}: missing assertion"
            return plan
        }
        mode :: parts[offset]
        if mode != "=" && mode != "one-of" && mode != "~" && mode != "!~" && mode != "empty" && mode != "exists" && mode != "absent" {
            plan.error = "line {line_number}: unknown assertion {mode}"
            return plan
        }
        data := ""
        if mode == "=" || mode == "one-of" || mode == "~" || mode == "!~" {
            if parts.len() <= offset + 1 {
                plan.error = "line {line_number}: missing assertion value"
                return plan
            }
            if mode == "~" || mode == "one-of" {
                reason_start :: value.index(" #") ?? value.len()
                if reason_start == value.len() || value.slice(reason_start + 2, value.len()).trim() == "" {
                    plan.error = "line {line_number}: nondeterministic assertion requires a reason comment"
                    return plan
                }
            }
            start :: (value.index(mode) ?? panic("parsed assertion mode missing")) + mode.len()
            data = value.slice(start, value.len()).trim()
            // Inline comments document nondeterministic substring assertions.
            if mode == "~" || mode == "!~" || mode == "one-of" -> data = data.slice(0, data.index(" #") ?? data.len()).trim()
            if mode != "one-of" && (data.starts_with("\"") || data.starts_with("'")) -> data = (kit_steps_words(data) ?? [data])[0]
        }
        path :: if key == "file" -> parts[0] else -> ""
        &plan.steps[i].assertions.push(KitAssertion{stream: key, path: path, mode: mode, value: data})
    }
    plan
}

fn kit_steps_expand(value: String, env: KitEnv, work: String, scratch: String, built: String) -> String {
    value.replace("{{work}}", work).replace("{{root}}", env.root).replace("{{scratch}}", scratch)
        .replace("{{jetpack}}", env.jetpack).replace("{{jet}}", env.jet).replace("{{built}}", built)
}

fn kit_steps_required(plan: KitPlan, env: KitEnv, work: String, scratch: String) -> KitVerdict? {
    loop requirement in plan.requires {
        missing :: kit_exec_requires(requirement, env, work, scratch)
        if missing != None -> return missing
    }
    None
}

fn kit_steps_bless_plan(plan: KitPlan, id: String, bless: KitBless) -> KitVerdict? {
    if !bless.all && !kit_expect_named(bless.ids, id) -> return None
    loop step in plan.steps {
        loop assertion in step.assertions {
            if assertion.mode == "one-of" -> return Val(kit_expect_verdict("REFUSED", "one-of snapshots: edit by hand"))
        }
    }
    None
}


fn kit_steps_environment(plan: KitPlan, env: KitEnv, work: String, scratch: String, built: String) -> [KitEnvVar] {
    overlay := [KitEnvVar]{}
    loop assignment in plan.environment {
        equals :: assignment.index("=") ?? -1
        if equals <= 0 -> panic("env requires NAME=VALUE")
        name :: assignment.slice(0, equals)
        value :: kit_steps_expand(assignment.slice(equals + 1, assignment.len()), env, work, scratch, built)
        &overlay.push(KitEnvVar{name: name, value: Val(value)})
    }
    overlay
}

fn kit_steps_step_environment(step: KitStep, env: KitEnv, work: String, scratch: String, built: String, overlay: [KitEnvVar]) -> [KitEnvVar] {
    result := overlay
    loop variable in step.environment {
        value :: if variable.value == {
            .Val(text) -> Val(kit_steps_expand(text, env, work, scratch, built))
            .None -> None
        }
        &result.push(KitEnvVar{name: variable.name, value: value})
    }
    loop name in step.unset -> &result.push(KitEnvVar{name: name, value: None})
    result
}

fn kit_steps_invoke_step(step: KitStep, env: KitEnv, work: String, scratch: String, snapshots: String, built: String, overlay: [KitEnvVar]) -> KitRun {
    argv := [String]{}
    loop argument in step.argv -> &argv.push(kit_steps_expand(argument, env, work, scratch, built))
    if argv[0] == "jet" -> argv[0] = env.jet
    if argv[0] == "jetpack" {
        if env.jetpack == "" -> return kit_exec_failed("jetpack binary required")
        argv[0] = env.jetpack
    }
    if argv[0] == "built" {
        if built == "" -> return kit_exec_failed("built step has no artifact")
        argv[0] = built
    }
    stdin :: if step.stdin == "" -> "" else -> files.read(files.join(snapshots, step.stdin)) ?? return kit_exec_failed("stdin snapshot: {err}")
    environment :: kit_steps_step_environment(step, env, work, scratch, built, overlay)
    cwd :: if step.cwd == "" -> work else -> files.join(work, step.cwd)
    kit_exec_invoke_with_env(env, argv, cwd, scratch, stdin, environment)
}

fn kit_steps_one_of(id: String, directory: String, snapshots: String, actual: String, bless: KitBless) -> KitVerdict {
    if bless.all || kit_expect_named(bless.ids, id) -> return kit_expect_verdict("REFUSED", "one-of snapshots: edit by hand")
    alternatives :: kit_steps_words(snapshots) ?? return kit_expect_verdict("REFUSED", "invalid one-of snapshots")
    if alternatives.len() < 2 -> return kit_expect_verdict("REFUSED", "one-of needs at least two snapshots")
    loop file in alternatives {
        expected :: kit_exec_optional(files.join(directory, file)) ?? return kit_expect_verdict("FAIL", "missing one-of snapshot: {file}")
        if actual == expected -> return kit_expect_verdict("PASS", "")
    }
    kit_expect_verdict("FAIL", "stdout matches none of the exact alternatives")
}

fn kit_steps_check_assertion(assertion: KitAssertion, id: String, result: KitRun, env: KitEnv, work: String, scratch: String, snapshots: String, bless: KitBless, normalize: [String], built: String, source_name: String) -> KitVerdict {
    actual := if assertion.stream == "stderr" -> result.stderr else -> result.stdout
    if assertion.stream == "file" {
        relative :: kit_steps_expand(assertion.path, env, work, scratch, built)
        path :: files.collapse(files.join(work, relative))
        if path != work && !path.starts_with("{work}/") -> return kit_expect_verdict("REFUSED", "file assertion escapes work directory")
        exists :: files.exists(path)
        if assertion.mode == "exists" -> return if exists -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "missing file: {relative}")
        if assertion.mode == "absent" -> return if !exists -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "unexpected file: {relative}")
        if !exists -> return kit_expect_verdict("FAIL", "missing file: {relative}")
        actual = files.read(path) ?? return kit_expect_verdict("ERROR", "read assertion file: {err}")
    }
    if kit_expect_named(normalize, "argv0") && built != "" {
        name :: files.basename(built)
        actual = kit_expect_argv0(actual, name, source_name)
    }
    if kit_expect_named(normalize, "paths") -> actual = kit_expect_paths(actual, work, env.root, scratch)
    if assertion.mode == "=" -> return kit_expect_exact(id, files.join(snapshots, assertion.value), kit_exec_optional(files.join(snapshots, assertion.value)), actual, bless, false)
    if assertion.mode == "one-of" -> return kit_steps_one_of(id, snapshots, assertion.value, actual, bless)
    if assertion.mode == "empty" -> return if actual == "" -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "{assertion.stream} is not empty")
    if assertion.mode == "~" -> return if actual.contains(assertion.value) -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "{assertion.stream} missing substring: {assertion.value}")
    if assertion.mode == "!~" -> return if !actual.contains(assertion.value) -> kit_expect_verdict("PASS", "") else -> kit_expect_verdict("FAIL", "{assertion.stream} contains forbidden substring: {assertion.value}")
    kit_expect_verdict("REFUSED", "unsupported assertion: {assertion.mode}")
}

fn kit_steps_check(step: KitStep, id: String, result: KitRun, env: KitEnv, work: String, scratch: String, snapshots: String, bless: KitBless, normalize: [String], built: String, source_name: String) -> KitVerdict {
    failure :: kit_exec_process_failure(result)
    if failure == {
        .Val(value) -> return value
        .None -> {}
    }
    if step.exit == "nonzero" {
        if result.code == 0 -> return kit_expect_verdict("FAIL", "exit 0; expected nonzero")
    } else if result.code != (Int.parse(step.exit) ?? 0) -> return kit_expect_verdict("FAIL", "exit {result.code}; expected {step.exit}")
    loop assertion in step.assertions {
        verdict :: kit_steps_check_assertion(assertion, id, result, env, work, scratch, snapshots, bless, normalize, built, source_name)
        if verdict.status != "PASS" -> return verdict
    }
    kit_expect_verdict("PASS", "")
}

// The public build contract places executable artifacts beside the staged
// project root; progress output is not a machine-readable artifact receipt.
fn kit_steps_artifact(entry: String, source: String, artifact: String) -> String {
    directory :: files.dirname(files.join(source, entry))
    root := directory
    ancestor := directory
    loop {
        if files.exists(files.join(ancestor, "package.jet")) {
            root = ancestor
            break
        }
        if ancestor == source -> break
        parent :: files.dirname(ancestor)
        if parent == ancestor -> break
        ancestor = parent
    }
    name :: files.basename(entry)
    stem :: if name.ends_with(".jet") -> name.slice(0, name.len() - 4) else -> name
    files.join(files.join(root, ".jet/build"), if artifact == "" -> stem.replace(".", "_") else -> artifact)
}

fn kit_steps_context(plan: KitPlan, id: String, env: KitEnv, work: String, scratch: String, snapshots: String, bless: KitBless) -> KitStepCtx {
    KitStepCtx{plan: plan, id: id, env: env, work: work, scratch: scratch, snapshots: snapshots, bless: bless, golden: None}
}

fn kit_steps_build_entry(step: KitStep) -> String {
    i := 2
    loop i < step.argv.len() {
        argument :: step.argv[i]
        if !argument.starts_with("-") -> return argument
        if kit_expect_named(["--profile", "--target", "--output", "--allow", "--deny", "--gate", "--set", "--threads", "--builder", "-p"], argument) -> i += 2
        else -> i += 1
    }
    "run.jet"
}

fn kit_steps_invoke(step: KitStep, index: Int, context: KitStepCtx, previous: KitStepState) -> KitStepResult {
    state := previous
    if step.argv[0] == "build" -> return KitStepResult{state: state, verdict: kit_expect_verdict("REFUSED", "build step requires golden entry; cases use jet build")}
    if step.argv[0] == "built" && !state.built_once -> return KitStepResult{state: state, verdict: kit_expect_verdict("REFUSED", "built step has no preceding successful build")}
    overlay :: kit_steps_environment(context.plan, context.env, context.work, context.scratch, state.built)
    state.last = kit_steps_invoke_step(step, context.env, context.work, context.scratch, context.snapshots, state.built, overlay)
    if step.argv.len() > 1 && step.argv[0] == "jet" && step.argv[1] == "build" && state.last.code == 0 && kit_exec_process_failure(state.last) == None {
        cwd :: if step.cwd == "" -> context.work else -> files.join(context.work, step.cwd)
        entry := kit_steps_build_entry(step)
        if files.exists(files.join(files.join(cwd, entry), "run.jet")) -> entry = files.join(entry, "run.jet")
        state.built = kit_steps_artifact(entry, cwd, context.plan.artifact)
        state.built_once = true
        if !files.exists(state.built) -> return KitStepResult{state: state, verdict: kit_expect_verdict("ERROR", "CLI build artifact missing: {state.built}")}
    }
    KitStepResult{state: state, verdict: kit_expect_verdict("PASS", "")}
}

fn kit_steps_check_state(step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitVerdict {
    kit_steps_check(step, context.id, state.last, context.env, context.work, context.scratch, context.snapshots, context.bless, context.plan.normalize, state.built, "")
}

