// Exact second map of failure_tier_parity.rs:140-150 after checked_text's map.
fn kit_steps_failure_paths(text: String) -> String? {
    first :: kit_steps_transform_one(text, "normalize_journey_paths") ?? return None
    lines := [String]{}
    loop line in kit_steps_rust_lines(first) {
        start := -1
        cursor := 0
        loop cursor < line.len() {
            offset :: line.slice(cursor, line.len()).index("jet_") ?? break
            found :: cursor + offset
            if found == 0 || line.bytes()[found - 1] == (U8{47}) {
                start = found
                break
            }
            cursor = found + 4
        }
        if start >= 0 {
            suffix :: line.slice(start, line.len())
            end :: suffix.index(".jet")
            if end == {
                .Val(offset) -> {
                    &lines.push("{line.slice(0, start)}<source>{line.slice(start + offset + 4, line.len())}")
                    next
                }
                .None -> {}
            }
        }
        &lines.push(line)
    }
    Val("{lines.join("\n")}{if text.ends_with("\n") -> "\n" else -> ""}")
}

// Exact tir_language_features.rs:596-613; Rust .lines() strips CR in CRLF.
fn kit_steps_contract_arrow(text: String) -> String {
    lines := [String]{}
    loop line in kit_steps_rust_lines(text) {
        index :: line.index("  --> ")
        if index == {
            .Val(start) -> {
                location :: line.slice(start + 6, line.len())
                colon := -1
                loop (offset, byte) in location.bytes() {
                    if byte == (U8{58}) -> colon = offset
                }
                number :: if colon < 0 -> "?" else -> location.slice(colon + 1, location.len())
                &lines.push("{line.slice(0, start)}  --> <source>:{number}")
            }
            .None -> &lines.push(line)
        }
    }
    "{lines.join("\n")}{if text.ends_with("\n") -> "\n" else -> ""}"
}

fn kit_steps_mask(text: String) -> Int? {
    if !text.starts_with("0o") -> return Val(Int.parse(text) ?? return None)
    if text.len() == 2 -> return None
    value := 0
    loop byte in text.slice(2, text.len()).bytes() {
        digit :: Int.from_u8(byte) - 48
        if digit < 0 || digit > 7 || value > (9223372036854775807 - digit) /% 8 -> return None
        value = value * 8 + digit
    }
    Val(value)
}

fn kit_steps_bit_and(value: Int, mask: Int) -> Int {
    number := value
    remaining := mask
    bit := 1
    result := 0
    loop index in 0..<64 {
        if remaining == 0 -> break
        odd :: number % 2 != 0
        mask_odd :: remaining % 2 != 0
        if odd && mask_odd -> result += bit
        negative :: number < 0
        number = number /% 2
        if negative && odd -> number -= 1
        mask_negative :: remaining < 0
        remaining = remaining /% 2
        if mask_negative && mask_odd -> remaining -= 1
        if index == 62 -> bit = -9223372036854775807 - 1
        else if index < 62 -> bit *= 2
    }
    result
}
