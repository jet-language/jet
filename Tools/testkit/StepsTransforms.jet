use core.text as strtext

fn kit_steps_ascii_scalar(code: Int) -> String {
    String.from_bytes([U8{code}]) ?? panic("ASCII scalar")
}

// Split only outside quoted arguments and balanced parentheses.
fn kit_steps_transform_parts(text: String) -> [String]? {
    parts := [String]{}
    start := 0
    depth := 0
    quote := 0
    escaped := false
    loop (index, byte) in text.bytes() {
        c :: Int.from_u8(byte)
        if quote != 0 {
            if escaped -> escaped = false
            else if c == 92 -> escaped = true
            else if c == quote -> quote = 0
        } else if c == 34 || c == 39 -> quote = c
        else if c == 40 -> depth += 1
        else if c == 41 -> depth -= 1
        else if c == 46 && depth == 0 {
            if index == start -> return None
            &parts.push(text.slice(start, index))
            start = index + 1
        }
        if depth < 0 -> return None
    }
    if depth != 0 || quote != 0 -> return None
    if text != "" {
        if start == text.len() -> return None
        &parts.push(text.slice(start, text.len()))
    }
    Val(parts)
}

fn kit_steps_transform_args(text: String) -> [String]? {
    kit_steps_words(kit_steps_surround_punctuation(text, true))
}

fn kit_steps_transform_valid(transform: String) -> Bool {
    parts :: kit_steps_transform_parts(transform) ?? return false
    loop part in parts {
        open :: part.index("(") ?? -1
        if open < 0 {
            if !kit_expect_named(["trim", "trim_start", "trim_end", "trim_lines", "strip_ansi", "strip_sgr", "strip_whitespace", "strip_ascii_whitespace", "until_blank", "first_words", "final_frame", "cursor_up_counts", "visible_cols", "normalize_journey_paths"], part) -> return false
            next
        }
        if !part.ends_with(")") -> return false
        name :: part.slice(0, open)
        body :: part.slice(open + 1, part.len() - 1)
        if name == "filter" && body.starts_with("where ") {
            if kit_steps_expression(body.slice(6, body.len()), "") == None -> return false
            next
        }
        args :: kit_steps_transform_args(body) ?? return false
        if name == "filter" {
            if args.len() < 2 || !kit_expect_named(["=", "!=", "^=", "!^=", "~", "!~", "$="], args[0]) -> return false
        } else if kit_expect_named(["cut", "strip_prefix", "strip_prefix_lines", "prepend", "append", "after_first", "after_last", "from_or_all"], name) {
            if args.len() != 1 -> return false
        } else if name == "split" || name == "slice" || name == "replace" || name == "replace_first" {
            if args.len() != 2 -> return false
            if name == "split" && (Int.parse(args[1]) ?? -1) < 0 -> return false
            if name == "slice" && ((Int.parse(args[0]) ?? -1) < 0 || (Int.parse(args[1]) ?? -1) < 0) -> return false
        } else if name == "line" {
            if args.len() != 1 || (Int.parse(args[0]) ?? -1) < 0 -> return false
        } else if name == "find_block" {
            if args.len() != 3 || args[1] != "~" -> return false
        } else -> return false
    }
    true
}

fn kit_steps_strip_sgr(text: String) -> String {
    result := [U8]{}
    escaped := false
    loop byte in text.bytes() {
        if escaped {
            if byte == (U8{109}) -> escaped = false
        } else if byte == (U8{27}) -> escaped = true
        else -> &result.push(byte)
    }
    String.from_bytes(result) ?? panic("SGR strip changed UTF-8")
}

fn kit_steps_strip_ansi(text: String) -> String {
    bytes :: text.bytes()
    result := [U8]{}
    cursor := 0
    loop cursor < bytes.len() {
        if bytes[cursor] == (U8{27}) {
            cursor += 1
            if cursor < bytes.len() && bytes[cursor] == (U8{91}) {
                cursor += 1
                loop cursor < bytes.len() {
                    c :: Int.from_u8(bytes[cursor])
                    cursor += 1
                    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) -> break
                }
            }
        } else {
            &result.push(bytes[cursor])
            cursor += 1
        }
    }
    String.from_bytes(result) ?? panic("strip ANSI changed UTF-8")
}

// Line-for-line help_pty.rs:71-130 helper semantics, not a terminal emulator.
fn kit_steps_terminal_transform(text: String, name: String) -> String? {
    if name == "visible_cols" {
        result := [String]{}
        loop line in kit_steps_rust_lines(text) -> &result.push("{kit_steps_scalar_count(kit_steps_strip_sgr(line))}")
        return Val(result.join("\n"))
    }
    if name == "cursor_up_counts" {
        bytes :: text.bytes()
        result := [String]{}
        i := 0
        loop i + 3 < bytes.len() {
            if bytes[i] == (U8{27}) && bytes[i + 1] == (U8{91}) && bytes[i + 2] >= (U8{48}) && bytes[i + 2] <= (U8{57}) {
                end := i + 2
                loop end < bytes.len() && bytes[end] >= (U8{48}) && bytes[end] <= (U8{57}) -> end += 1
                if end < bytes.len() && bytes[end] == (U8{65}) {
                    &result.push("{Int.parse(text.slice(i + 2, end)) ?? return None}")
                    i = end
                }
            }
            i += 1
        }
        return Val(result.join("\n"))
    }
    esc :: kit_steps_ascii_scalar(27)
    normalized :: text.replace(kit_steps_ascii_scalar(13), "")
    parts :: normalized.split("{esc}[J").to_list()
    if parts.len() < 3 -> return None
    frame := parts[parts.len() - 2]
    frame = frame.slice(0, frame.index("{esc}[?1049l") ?? frame.len())
    last := -1
    at := 0
    loop {
        found :: frame.slice(at, frame.len()).index("{esc}[") ?? break
        last = at + found
        at = last + 2
    }
    if last >= 0 -> frame = frame.slice(0, last)
    Val(frame)
}

fn kit_steps_transform_one(text: String, part: String) -> String? {
    if part == "trim" -> return Val(~text.trim())
    if part == "trim_start" -> return Val(strtext.trim_start(text))
    if part == "trim_end" -> return Val(strtext.trim_end(text))
    if part == "strip_sgr" -> return Val(kit_steps_strip_sgr(text))
    if part == "strip_ansi" -> return Val(kit_steps_strip_ansi(text))
    if part == "normalize_journey_paths" {
        lines := [String]{}
        loop line in kit_steps_rust_lines(text) {
            open :: line.index(" (")
            colon := Int?{None}
            loop (index, byte) in line.bytes() {
                if byte == (U8{58}) -> colon = Val(index)
            }
            if open == {
                .Val(start) -> {
                    if colon == {
                        .Val(end) -> {
                            if end < start + 2 -> return None
                            if line.slice(start + 2, end).contains(".jet") {
                                &lines.push("{line.slice(0, start + 2)}<source>:{line.slice(end + 1, line.len())}")
                                next
                            }
                        }
                        .None -> {}
                    }
                }
                .None -> {}
            }
            &lines.push(line)
        }
        return Val("{lines.join("\n")}{if text.ends_with("\n") -> "\n" else -> ""}")
    }
    if kit_expect_named(["final_frame", "cursor_up_counts", "visible_cols"], part) -> return kit_steps_terminal_transform(text, part)
    if part == "strip_whitespace" || part == "strip_ascii_whitespace" {
        bytes :: text.bytes()
        result := [U8]{}
        index := 0
        loop index < bytes.len() {
            scalar :: kit_steps_scalar(bytes, index)
            whitespace :: if part == "strip_whitespace" -> kit_steps_unicode_space(scalar.value) else -> scalar.value == 32 || (scalar.value >= 9 && scalar.value <= 13)
            if !whitespace {
                loop at in index..<scalar.next -> &result.push(bytes[at])
            }
            index = scalar.next
        }
        return Val(String.from_bytes(result) ?? panic("whitespace strip changed UTF-8"))
    }
    if part == "trim_lines" || part == "first_words" || part == "until_blank" {
        lines := [String]{}
        loop line in kit_steps_rust_lines(text) {
            if part == "until_blank" && line == "" -> break
            if part == "trim_lines" -> &lines.push(~line.trim())
            else if part == "first_words" {
                words :: kit_steps_whitespace_words(line)
                if words.len() > 0 -> &lines.push(words[0])
            } else -> &lines.push(line)
        }
        return Val(lines.join("\n"))
    }
    open :: part.index("(") ?? return None
    name :: part.slice(0, open)
    body :: part.slice(open + 1, part.len() - 1)
    if name == "filter" && body.starts_with("where ") {
        lines := [String]{}
        loop line in kit_steps_rust_lines(text) {
            if kit_steps_expression(body.slice(6, body.len()), line) ?? return None -> &lines.push(line)
        }
        return Val(lines.join("\n"))
    }
    args :: kit_steps_transform_args(body) ?? return None
    if name == "filter" {
        lines := [String]{}
        negative :: args[0] == "!~" || args[0] == "!^=" || args[0] == "!="
        loop line in kit_steps_rust_lines(text) {
            matched := negative
            loop value in args.slice(1, args.len()) {
                one :: kit_steps_line_atom(line, args[0], value)
                if negative -> matched = matched && one
                else -> matched = matched || one
            }
            if matched -> &lines.push(line)
        }
        return Val(lines.join("\n"))
    }
    if name == "prepend" -> return Val("{args[0]}{text}")
    if name == "append" -> return Val("{text}{args[0]}")
    if name == "replace" -> return Val(text.replace(args[0], args[1]))
    if name == "replace_first" {
        at :: text.index(args[0]) ?? return Val(text)
        return Val("{text.slice(0, at)}{args[1]}{text.slice(at + args[0].len(), text.len())}")
    }
    if name == "strip_prefix" {
        if !text.starts_with(args[0]) -> return None
        return Val(text.slice(args[0].len(), text.len()))
    }
    if name == "strip_prefix_lines" {
        lines := [String]{}
        loop line in kit_steps_rust_lines(text) {
            if line.starts_with(args[0]) -> &lines.push(line.slice(args[0].len(), line.len()))
        }
        return Val(lines.join("\n"))
    }
    if name == "after_first" || name == "from_or_all" || name == "cut" {
        at :: text.index(args[0]) ?? return if name == "after_first" -> None else -> Val(text)
        if name == "after_first" -> return Val(text.slice(at + args[0].len(), text.len()))
        if name == "from_or_all" -> return Val(text.slice(at, text.len()))
        result := text.slice(0, at)
        loop result.ends_with("\n\n") -> result = result.slice(0, result.len() - 1)
        if !result.ends_with("\n") -> result = "{result}\n"
        return Val(result)
    }
    if name == "after_last" {
        at := -1
        cursor := 0
        loop cursor <= text.len() {
            found :: text.slice(cursor, text.len()).index(args[0]) ?? break
            at = cursor + found
            cursor = at + if args[0] == "" -> 1 else -> args[0].len()
        }
        return Val(if at < 0 -> text else -> text.slice(at + args[0].len(), text.len()))
    }
    if name == "slice" {
        start :: Int.parse(args[0]) ?? return None
        end :: Int.parse(args[1]) ?? return None
        bytes :: text.bytes()
        if start < 0 || start > end || end > bytes.len() -> return None
        return Val(String.from_bytes(bytes.slice(start, end)) ?? return None)
    }
    if name == "line" {
        lines :: kit_steps_rust_lines(text)
        index :: Int.parse(args[0]) ?? return None
        if index < 0 || index >= lines.len() -> return None
        return Val(lines[index])
    }
    if name == "split" {
        parts :: text.split(args[0]).to_list()
        index :: Int.parse(args[1]) ?? return None
        if index < 0 || index >= parts.len() -> return None
        return Val(parts[index])
    }
    if name == "find_block" {
        loop block in text.split(args[0]) {
            if block.contains(args[2]) -> return Val(block)
        }
    }
    None
}

fn kit_steps_transform(text: String, transform: String) -> String? {
    parts :: kit_steps_transform_parts(transform) ?? return None
    result := text
    loop part in parts -> result = kit_steps_transform_one(result, part) ?? return None
    Val(result)
}
