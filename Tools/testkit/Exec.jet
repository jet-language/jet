use core.process as process
use core.files as files
use core.sys as sys
use core.time as time


fn kit_exec_defaults() -> KitOptions {
    KitOptions{suite: "golden", jet: sys.get("JET") ?? "", jetpack: "", tiers: ["o0", "o1", "o2"], filter: "", cases: "", shard_index: 1, shard_count: 1, sharded: false, timeout: 600, scratch: "", results: "", list: false, coverage: false, bless: KitBless{ids: [], all: false, reason: "", allow_shrink: [], first_tier: true}, error: ""}
}


fn kit_exec_select_ids(all_ids: [String], options: KitOptions) -> KitSelection {
    requested := [String]{}
    if options.cases != "" {
        text :: files.read(options.cases) ?? return KitSelection{ids: [], error: "read cases file: {err}"}
        loop raw in text.split("\n") {
            id :: raw.trim().copy()
            if id == "" || id.starts_with("#") -> next
            if kit_expect_named(requested, id) -> return KitSelection{ids: [], error: "duplicate case ID: {id}"}
            if !kit_expect_named(all_ids, id) -> return KitSelection{ids: [], error: "unknown case ID: {id}"}
            &requested.push(id)
        }
    }
    seen := [String]{}
    loop id in options.bless.ids {
        if kit_expect_named(seen, id) -> return KitSelection{ids: [], error: "duplicate bless ID: {id}"}
        if !kit_expect_named(all_ids, id) -> return KitSelection{ids: [], error: "unknown bless ID: {id}"}
        &seen.push(id)
    }
    selected := [String]{}
    loop (index, id) in all_ids {
        if requested.len() > 0 && !kit_expect_named(requested, id) -> next
        if options.bless.ids.len() > 0 && !kit_expect_named(options.bless.ids, id) -> next
        if options.filter != "" && !id.contains(options.filter) -> next
        if index % options.shard_count != options.shard_index - 1 -> next
        &selected.push(id)
    }
    KitSelection{ids: selected, error: ""}
}

fn kit_exec_failed(message: String) -> KitRun {
    KitRun{stdout: "", stderr: "", code: -1, signal: None, timed_out: false, error: message}
}

fn kit_exec_base_value(name: String, env: KitEnv, scratch: String) -> String? {
    if env.env_clear -> return None
    if {
        name == "JET_COMPILER_EXTENSION" -> None
        // Every build under test runs IR Lint after each optimizer pass.
        name == "NO_COLOR" || name == "JET_RECEIPT_BYPASS" || name == "JET_OPT_VERIFY" -> Val("1")
        name == "CLICOLOR" -> Val("0")
        name == "TERM" -> Val("dumb")
        name == "JET_REPL_HISTORY" -> Val("off")
        name == "JET_STORE_DIR" -> Val(files.join(env.scratch, "store"))
        name == "JET_FFI_CACHE_DIR" -> if env.trace_node != "" -> sys.get(name) else -> Val(files.join(env.scratch, "ffi"))
        name == "TMPDIR" || name == "TMP" || name == "TEMP" -> Val(files.join(scratch, "tmp"))
        name == "JETPACK_ROOT" -> Val(files.join(scratch, "jetpack"))
        name == "JET_SCHEMA_CACHE_DIR" -> Val(files.join(scratch, "schema"))
        else -> sys.get(name)
    }
}

// Inherit the caller's environment, removing only the compiler-extension hook.
// Cache roots are run-wide; temporary, schema and jetpack roots are case-local.
fn kit_exec_spec(env: KitEnv, argv: [String], cwd: String, scratch: String, overlay: [KitEnvVar]) -> ProcessSpec {
    commands :: if env.trace_node != "" && env.trace_case != "" -> {
        cache_override := kit_exec_base_value("JET_FFI_CACHE_DIR", env, scratch) ?? ""
        loop variable in overlay {
            if variable.name == "JET_FFI_CACHE_DIR" -> cache_override = variable.value ?? ""
        }
        marked := [String]{env.trace_node, files.join(env.root, "Tools/testkit/native-command.mjs"), "--case", env.trace_case, "--root", env.root, "--cwd", cwd, "--jet", env.jet, "--cache-root", env.trace_cache, "--ffi-cache", cache_override, "--"}
        loop argument in argv -> &marked.push(argument)
        marked
    } else -> { argv }
    spec := process.cmd(commands).cwd(cwd).stdout(.Capture).stderr(.Capture).stdin(.Stream).timeout(env.timeout)
    if env.env_clear -> spec = spec.env_clear()
    else {
        spec = spec.env_remove("JET_COMPILER_EXTENSION")
            .env("NO_COLOR", kit_exec_base_value("NO_COLOR", env, scratch) ?? "")
            .env("CLICOLOR", kit_exec_base_value("CLICOLOR", env, scratch) ?? "")
            .env("TERM", kit_exec_base_value("TERM", env, scratch) ?? "")
            .env("JET_RECEIPT_BYPASS", kit_exec_base_value("JET_RECEIPT_BYPASS", env, scratch) ?? "")
            .env("JET_OPT_VERIFY", kit_exec_base_value("JET_OPT_VERIFY", env, scratch) ?? "")
            .env("JET_REPL_HISTORY", kit_exec_base_value("JET_REPL_HISTORY", env, scratch) ?? "")
            .env("JET_STORE_DIR", kit_exec_base_value("JET_STORE_DIR", env, scratch) ?? "")
            .env("JET_FFI_CACHE_DIR", kit_exec_base_value("JET_FFI_CACHE_DIR", env, scratch) ?? "")
            .env("TMPDIR", kit_exec_base_value("TMPDIR", env, scratch) ?? "")
            .env("TMP", kit_exec_base_value("TMP", env, scratch) ?? "")
            .env("TEMP", kit_exec_base_value("TEMP", env, scratch) ?? "")
            .env("JETPACK_ROOT", kit_exec_base_value("JETPACK_ROOT", env, scratch) ?? "")
            .env("JET_SCHEMA_CACHE_DIR", kit_exec_base_value("JET_SCHEMA_CACHE_DIR", env, scratch) ?? "")
    }
    if env.memory_limit > 0 -> spec = spec.memory_limit(env.memory_limit)
    loop variable in overlay {
        if variable.value == {
            .Val(value) -> spec = spec.env(variable.name, value)
            .None -> spec = spec.env_remove(variable.name)
        }
    }
    spec
}

fn kit_exec_receipt(receipt: ProcessReceipt, elapsed_ns: Int, input_error: String) -> KitRun {
    limit_hit :: if receipt.limit_hit == {
        .Val(limit) -> if limit == {
            .WallTime -> "time"
            .CpuTime -> "cpu"
            .Memory -> "memory"
            .OpenFiles -> "open-files"
            .Output -> "output"
        }
        .None -> ""
    }
    KitRun{stdout: receipt.output, stderr: receipt.errors, code: receipt.code,
        signal: receipt.signal, timed_out: receipt.timed_out, error: input_error,
        elapsed_ns: elapsed_ns, limit_hit: limit_hit}
}

// A child that exits before reading its input breaks the pipe; name its exit
// and first stderr line so the row shows why it stopped reading.
fn kit_exec_input_detail(error: String, code: Int, errors: String) -> String {
    first := ""
    loop line in errors.lines() {
        if line.trim() == "" -> next
        first = line.trim().copy()
        break
    }
    if first.count_bytes() > 160 -> first = kit_steps_byte_slice(first, 0, 160)
    if first == "" -> return "{error}; child exited {code} without reading it"
    "{error}; child exited {code} without reading it: {first}"
}

fn kit_exec_invoke_with_env(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: String, overlay: [KitEnvVar]) -> KitRun {
    kit_exec_run(env, argv, cwd, scratch, stdin, overlay, None)
}

// Runs the child on a terminal: its stdin and stdout share the terminal and
// stdout is the terminal transcript. `stdin` is typed at spawn and each event
// at its time from spawn. Input never closes the terminal, which would hang
// up the child; a close event types the end-of-file character instead.
fn kit_exec_invoke_terminal(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: String, overlay: [KitEnvVar], terminal: KitTerminal) -> KitRun {
    kit_exec_run(env, argv, cwd, scratch, stdin, overlay, Val(terminal))
}

// Events by time; events at the same time keep their line order.
fn kit_exec_terminal_order(events: [KitTerminalEvent]) -> [KitTerminalEvent] {
    ordered := [KitTerminalEvent]{}
    loop event in events {
        &ordered.push(event)
        position := ordered.len() - 1
        loop position > 0 && ordered[position - 1].at > ordered[position].at {
            earlier :: ordered[position - 1]
            ordered[position - 1] = ordered[position]
            ordered[position] = earlier
            position -= 1
        }
    }
    ordered
}

fn kit_exec_run(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: String, overlay: [KitEnvVar], terminal: KitTerminal?) -> KitRun {
    files.create_dir_all(files.join(scratch, "tmp")) ?? return kit_exec_failed("create child temp directory: {err}")
    started :: time.instant()
    spec := kit_exec_spec(env, argv, cwd, scratch, overlay)
    if terminal == .Val(shape) {
        spec = spec.terminal(TerminalPolicy{size: TerminalSize{cols: shape.cols, rows: shape.rows}, mode: .Cooked})
    }
    child := spec.spawn() ?? return kit_exec_failed("spawn: {err}")
    { sender: done, receiver: watching } :: channel<Int>()
    watcher :: task kit_exec_watch_resident(if env.resident_limit > 0 -> child.id() else -> 0, env.resident_limit, env.resident_tree, watching)
    // Empty input writes nothing: a child that exits before the kit reaches its
    // stdin closed the pipe, which is no error when there was nothing to send.
    input_error := ""
    if stdin != "" {
        child.stdin.write_text(stdin) ?? {
            input_error = "stdin: {err}"
            ()
        }
    }
    if terminal == {
        .Val(shape) -> {
            eof :: String.from_bytes([U8{4}]) ?? panic("EOF character")
            loop event in kit_exec_terminal_order(shape.events) {
                remaining :: event.at - started.elapsed().ns
                if remaining > 0 -> time.sleep(time.duration_ns(remaining))
                if event.kind == "resize" {
                    session :: child.terminal ?? {
                        if input_error == "" -> input_error = "terminal resize: no terminal session"
                        next
                    }
                    session.resize(TerminalSize{cols: event.cols, rows: event.rows}) ?? {
                        if input_error == "" -> input_error = "terminal resize: {err}"
                        ()
                    }
                } else if event.kind == "close" {
                    // Like closing a pipe, ending input after the child has
                    // exited is no error.
                    child.stdin.write_text(eof).drop("the child may have exited before its input ended")
                } else {
                    child.stdin.write_text(event.text) ?? {
                        if input_error == "" -> input_error = "terminal input: {err}"
                        ()
                    }
                }
            }
        }
        .None -> child.stdin.close()
    }
    receipt :: child.wait() ?? {
        done.send(0)
        _ :: ^watcher.join() ?? false
        return kit_exec_failed("wait: {err}")
    }
    done.send(0)
    killed :: ^watcher.join() ?? false
    run := kit_exec_receipt(receipt, started.elapsed().ns, if input_error == "" -> "" else -> kit_exec_input_detail(input_error, receipt.code, receipt.errors))
    if killed -> run.limit_hit = "memory"
    run
}

// The run-wide memory guard counts resident memory, not address space: a
// RLIMIT_AS limit fails thread-stack reservations long before the child uses
// that memory. Polls VmRSS every 100 ms and kills the child above `limit`
// bytes; true when it did. Under `tree` (a case's `limit: resident=`) it sums
// the child and its live descendants and kills them all. A case's
// `limit: memory=` keeps Core memory_limit.
fn kit_exec_watch_resident(pid: Int, limit: Int, tree: Bool, done: Receiver<Int>) -> Bool Never! {
    if pid <= 0 -> return false
    tick := 0
    loop {
        if done.is_ready() -> return false
        if tick % 10 == 0 {
            pids := [Int]{}
            used :: kit_exec_tree_resident(pid, tree, &pids)
            if pids.len() == 0 -> return false
            if used > limit {
                #Unsafe("the testkit stops its own step child at the resident-memory guard") {
                    sys.kill(pid, 9) ?? return false
                    loop descendant in pids {
                        if descendant != pid -> sys.kill(descendant, 9).drop("a descendant may exit before its signal")
                    }
                }
                return true
            }
        }
        tick += 1
        time.sleep(10ms)
    }
    false
}

// The resident bytes of `pid`, plus under `tree` those of its live descendants
// (`/proc/<pid>/task/<tid>/children`); `pids` lists every process counted,
// none when `pid` itself is gone.
fn kit_exec_tree_resident(pid: Int, tree: Bool, pids: &[Int]) -> Int Never! {
    used := 0
    queue := [Int]{pid}
    at := 0
    loop at < queue.len() {
        current :: queue[at]
        at += 1
        status :: files.read("/proc/{current}/status") ?? next
        used += kit_exec_resident_bytes(status)
        &pids.push(current)
        if !tree -> next
        threads :: files.list_dir("/proc/{current}/task") ?? next
        loop thread in threads {
            children :: files.read(files.join(thread.path, "children")) ?? next
            loop word in children.split(" ") {
                child :: Int.parse(word.trim().copy()) ?? next
                &queue.push(child)
            }
        }
    }
    used
}

fn kit_exec_resident_bytes(status: String) -> Int { kit_exec_kib_field(status, "VmRSS:") }

// The byte value of a `/proc` "<field> <n> kB" row, or 0 when the row is absent.
fn kit_exec_kib_field(text: String, field: String) -> Int {
    loop line in text.split("\n") {
        if !line.starts_with(field) -> next
        loop value in line.slice(field.len(), line.len()).trim().split(" ") {
            if value.len() > 0 -> return (Int.parse(value.copy()) ?? 0) * 1024
        }
    }
    0
}

// Memory this process may still claim, in bytes; 0 when unknown. That is the host's
// MemAvailable, lowered to the room left under every memory.high and memory.max on the
// cgroup path this process runs in: a build-slot scope caps its suites far below the host,
// and a pool sized from the host alone overruns the cap and drives the machine into swap.
fn kit_exec_available_memory() -> Int {
    meminfo :: files.read("/proc/meminfo") ?? return 0
    available := kit_exec_kib_field(meminfo, "MemAvailable:")
    membership :: files.read("/proc/self/cgroup") ?? return available
    prefix := ""
    loop part in kit_exec_cgroup_path(membership).split("/") {
        if part == "" -> next
        prefix = "{prefix}/{part}"
        dir :: "/sys/fs/cgroup{prefix}"
        current :: kit_exec_cgroup_value(files.read("{dir}/memory.current") ?? "")
        available = kit_exec_room(available, kit_exec_cgroup_value(files.read("{dir}/memory.high") ?? ""), current)
        available = kit_exec_room(available, kit_exec_cgroup_value(files.read("{dir}/memory.max") ?? ""), current)
    }
    available
}

// The unified-hierarchy path in a /proc/self/cgroup listing (its `0::` row), or "".
fn kit_exec_cgroup_path(membership: String) -> String {
    loop line in membership.split("\n") {
        if line.starts_with("0::") -> return line.slice(3, line.len()).trim().copy()
    }
    ""
}

// A cgroup memory file's byte count; 0 for `max`, an empty read or anything unreadable.
fn kit_exec_cgroup_value(text: String) -> Int { Int.parse(text.trim().copy()) ?? 0 }

// `available` lowered to the room under `limit` once `current` is in use. A 0 limit is no
// limit and a 0 `available` is unknown; a full cgroup leaves one byte, so the pool runs one.
fn kit_exec_room(available: Int, limit: Int, current: Int) -> Int {
    if limit <= 0 -> return available
    room := limit - current
    if room < 1 -> room = 1
    if available <= 0 || room < available -> return room
    available
}

fn kit_exec_invoke(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: String) -> KitRun {
    kit_exec_invoke_with_env(env, argv, cwd, scratch, stdin, [KitEnvVar]{})
}

fn kit_exec_process_failure(run: KitRun) -> KitVerdict? {
    if run.error != "" -> return Val(kit_expect_verdict("ERROR", run.error))
    if run.timed_out -> return Val(kit_expect_verdict("TIMEOUT", "wall-clock limit"))
    if run.limit_hit == "memory" -> return Val(kit_expect_verdict("ERROR", "memory limit hit"))
    if run.signal != None -> return Val(kit_expect_verdict("ERROR", "child terminated by signal"))
    if run.code == 101 -> return Val(kit_expect_verdict("ERROR", "internal compiler error (exit 101)"))
    None
}

fn kit_exec_write(path: String, contents: String) {
    files.create_dir_all(files.dirname(path)) ?? panic("mkdir {path}: {err}")
    files.write(path, contents) ?? panic("write {path}: {err}")
}

fn kit_exec_copy_file(source: String, destination: String) {
    bytes :: files.read_bytes(source) ?? panic("read {source}: {err}")
    files.create_dir_all(files.dirname(destination)) ?? panic("mkdir {destination}: {err}")
    files.write_bytes(destination, bytes) ?? panic("copy {source}: {err}")
    info :: files.stat(source) ?? panic("stat {source}: {err}")
    files.chmod(destination, info.mode % 512) ?? panic("copy mode {source}: {err}")
}

// Case scratch may hold trees a tool made read-only on purpose (Hangar objects
// and seals). Removal restores owner access on directories, never following a
// link, then retries.
fn kit_exec_remove_tree(path: String) -> Bool Err! {
    if files.remove_all(path) == .Ok(_) -> return Ok(true)
    kit_exec_make_writable(path)
    files.remove_all(path) ?? return Err("{err}")
    Ok(true)
}

// A case's descendants that moved to a process group of their own outlive the
// step that started them. Before its scratch goes, stop every process still
// running an executable from that scratch or working inside it.
fn kit_exec_stop_strays(scratch: String) {
    if sys.name() != "linux" -> return
    root :: files.canonicalize(scratch) ?? return
    inside :: "{root}/"
    own :: process.current_pid()
    entries :: files.list_dir("/proc") ?? return
    loop entry in entries {
        pid :: Int.parse(files.basename(entry.path)) ?? next
        if pid == own -> next
        executable :: files.read_link("/proc/{pid}/exe") ?? ""
        directory :: files.read_link("/proc/{pid}/cwd") ?? ""
        if !executable.starts_with(inside) && !directory.starts_with(inside) && directory != root -> next
        #Unsafe("the testkit stops a process its own case left running in the case scratch") {
            sys.kill(pid, 9).drop("a stray may exit before its signal")
        }
    }
}

fn kit_exec_make_writable(path: String) {
    info :: files.stat(path) ?? return
    if info.is_symlink || !info.is_dir -> return
    files.chmod(path, info.mode % 64 + 448) ?? return
    entries :: files.list_dir(path) ?? return
    loop entry in entries -> kit_exec_make_writable(entry.path)
}


fn kit_exec_optional(path: String) -> String? {
    if !files.exists(path) -> return None
    Val(files.read(path) ?? panic("read {path}: {err}"))
}

// Never copy compiler caches. Fixture state is authored, not build output.
fn kit_exec_copy_tree(source: String, destination: String, fixture_state: Bool) {
    files.create_dir_all(destination) ?? panic("mkdir {destination}: {err}")
    entries :: files.list_dir(source) ?? panic("list {source}: {err}")
    loop entry in entries {
        if entry.name == ".jet" || entry.name == ".git" -> next
        name :: if fixture_state && (entry.name == "state" || entry.name == "fixture-state") -> ".jet" else -> entry.name
        target :: files.join(destination, name)
        if entry.is_dir -> kit_exec_copy_tree(entry.path, target, fixture_state)
        else -> kit_exec_copy_file(entry.path, target)
    }
}

fn kit_exec_requires(requirement: String, env: KitEnv, work: String, scratch: String) -> KitVerdict? {
    if requirement.starts_with("first-existing ") -> return None
    if requirement.starts_with("path-exists:") {
        path :: kit_steps_expand(requirement.slice(12, requirement.len()), env, work, scratch, "")
        if !files.exists(files.join(work, path)) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
        return None
    }
    if requirement.starts_with("env:") {
        assignment :: requirement.slice(4, requirement.len())
        equals :: assignment.index("=") ?? -1
        if equals <= 0 -> return Val(kit_expect_verdict("REFUSED", "invalid requires: {requirement}"))
        name :: assignment.slice(0, equals)
        value :: assignment.slice(equals + 1, assignment.len())
        if (sys.get(name) ?? "") != value -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("os:") {
        if !kit_steps_host_matches(sys.family(), requirement.slice(3, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("os-name:") {
        if !kit_steps_host_matches(kit_steps_host_name(), requirement.slice(8, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("arch:") {
        if !kit_steps_host_matches(kit_steps_host_arch(), requirement.slice(5, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("probe ") {
        matched :: kit_steps_probe(requirement.slice(6, requirement.len()), env, work, scratch)
        if !matched -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("tools-any ") || requirement.starts_with("probes-any ") {
        probes :: requirement.starts_with("probes-any ")
        body :: requirement.slice(if probes -> 11 else -> 10, requirement.len())
        matched :: kit_steps_capability_any(body, probes, env, work, scratch)
        if !matched -> return Val(kit_expect_verdict("FAIL", requirement))
    } else {
        argv := [String]{}
        if {
            requirement == "gtk4" -> argv = ["pkg-config", "--exists", "gtk4"]
            requirement.starts_with("tool:") -> {
                name :: requirement.slice(5, requirement.len())
                if kit_steps_tool(name) == None -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
                return None
            }
            else -> return Val(kit_expect_verdict("REFUSED", "unknown host requirement: {requirement}"))
        }
        run :: kit_exec_invoke(env, argv, work, scratch, "")
        if run.code != 0 || run.error != "" -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    }
    None
}
