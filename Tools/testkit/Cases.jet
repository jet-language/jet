use core.files as files

// A case is a public-CLI scenario, not a program entry. Descend through
// groups and fixture directories alike; only .case files are entries.
fn kit_cases_collect(root: String, directory: String) -> [KitEntry] {
    entries := [KitEntry]{}
    if !files.exists(files.join(root, directory)) -> return entries
    children :: files.list_dir(files.join(root, directory)) ?? panic("discover cases {directory}: {err}")
    loop child in children {
        if child.name.starts_with(".") -> next
        shown :: files.join(directory, child.name)
        if child.is_dir {
            loop entry in kit_cases_collect(root, shown) -> &entries.push(entry)
        } else if child.name.ends_with(".case") {
            &entries.push(KitEntry{path: shown, expected: shown, project: directory, suite: "cases", mode: ""})
        }
    }
    entries
}

fn kit_cases_discover(context: KitCtx) -> [KitEntry] {
    entries := kit_cases_collect(context.root, "tests/cases")
    &entries.sort_by(entry -> entry.path)
    entries
}

fn kit_cases_run(entry: KitEntry, context: KitCtx) -> [KitOutcome] {
    source :: files.read(files.join(context.root, entry.path)) ?? return [KitOutcome{verdict: kit_expect_verdict("ERROR", "read case: {err}"), run: kit_exec_failed("{err}")}]
    plan :: kit_steps_parse_case(source)
    exact_id :: context.options.cases != "" || context.options.filter == entry.path || kit_expect_named(context.options.bless.ids, entry.path)
    if plan.error == "" && plan.opt_in != "" && !context.options.opt_in && !exact_id -> return [KitOutcome{verdict: kit_expect_verdict("OPT-IN", plan.opt_in), run: kit_steps_action_run()}]
    work :: files.join(context.scratch, "work")
    files.create_dir_all(work) ?? return [KitOutcome{verdict: kit_expect_verdict("ERROR", "case work: {err}"), run: kit_exec_failed("{err}")}]
    // Steps owns the single grammar, host requirements, fixture state staging,
    // token expansion, process policy, assertions and snapshot blessing.
    // CLI scenarios run once, independent of the golden tier selection.
    steps :: kit_steps_context(plan, entry.path, context.env, work, context.scratch,
        files.join(context.root, entry.project), context.bless)
    [kit_steps_execute(steps, kit_steps_hooks())]
}
