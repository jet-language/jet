// #4780: shared nominal types and suite table stay together; callbacks use forwarding lambdas.
use core.process as process
use core.files as files
use core.sys as sys


fn kit_parse_options(args: [String]) -> KitOptions {
    options := kit_exec_defaults()
    if args.len() == 0 -> return options
    options.suite = args[0]
    if options.suite != "golden" && options.suite != "ui" && options.suite != "cases" && options.suite != "all" {
        options.error = "invalid suite: {args[0]}"
        return options
    }
    i := 1
    loop i < args.len() {
        flag :: args[i]
        if flag == "--list" {
            options.list = true
            i += 1
            next
        }
        if flag == "--coverage" {
            options.coverage = true
            i += 1
            next
        }
        if flag == "--bless-all" {
            options.bless.all = true
            i += 1
            next
        }
        if i + 1 >= args.len() {
            options.error = "missing value for {flag}"
            return options
        }
        value :: args[i + 1]
        if flag == {
            "--jet" -> options.jet = value
            "--jetpack" -> options.jetpack = value
            "--tier" -> options.tiers = value.split(",").to_list()
            "--filter" -> options.filter = value
            "--cases" -> options.cases = value
            "--scratch" -> options.scratch = value
            "--results" -> options.results = value
            "--timeout" -> options.timeout = Int.parse(value) ?? 0
            "--bless" -> &options.bless.ids.push(value)
            "--reason" -> options.bless.reason = value
            "--allow-shrink" -> &options.bless.allow_shrink.push(value)
            "--shard" -> {
                parts :: value.split("/").to_list()
                if parts.len() != 2 {
                    options.error = "--shard must be I/N"
                    return options
                }
                options.shard_index = Int.parse(parts[0]) ?? 0
                options.shard_count = Int.parse(parts[1]) ?? 0
                options.sharded = true
            }
            else -> {
                options.error = "unknown option: {flag}"
                return options
            }
        }
        i += 2
    }
    options.error = kit_expect_bless_error(options.bless, options.sharded)
    if options.error != "" -> return options
    if options.bless.ids.len() > 0 && options.bless.all {
        options.error = "--bless and --bless-all are mutually exclusive"
        return options
    }
    if options.shard_count <= 0 || options.shard_index <= 0 || options.shard_index > options.shard_count -> options.error = "invalid shard I/N"
    if options.timeout <= 0 -> options.error = "timeout must be positive seconds"
    if options.coverage && options.suite != "ui" -> options.error = "option not valid for suite: --coverage"
    seen := [String]{}
    loop tier in options.tiers {
        if tier != "ref" && tier != "o0" && tier != "o1" && tier != "o2" {
            options.error = "unknown tier: {tier}"
            return options
        }
        if kit_expect_named(seen, tier) {
            options.error = "duplicate tier: {tier}"
            return options
        }
        &seen.push(tier)
    }
    options
}

struct KitEnv {
    root: String
    scratch: String
    jet: String
    jetpack: String
    timeout: Duration
    memory_limit: Int
}

struct KitEnvVar {
    name: String
    value: String?
}

struct KitEntry {
    path: String
    expected: String
    project: String
    suite: String
    mode: String
}

struct KitRun {
    stdout: String
    stderr: String
    code: Int
    signal: Int?
    timed_out: Bool
    error: String
}
struct KitOptions {
    suite: String
    jet: String
    jetpack: String
    tiers: [String]
    filter: String
    cases: String
    shard_index: Int
    shard_count: Int
    sharded: Bool
    timeout: Int
    scratch: String
    results: String
    list: Bool
    coverage: Bool
    bless: KitBless
    error: String
}

struct KitCtx {
    options: KitOptions
    env: KitEnv
    root: String
    scratch: String
    bless: KitBless
}

struct KitSelection {
    ids: [String]
    error: String
}

struct KitVerdict {
    status: String
    detail: String
    diff: String
}

struct KitBless {
    ids: [String]
    all: Bool
    reason: String
    allow_shrink: [String]
    first_tier: Bool
}

struct KitAssertion {
    stream: String
    path: String
    mode: String
    value: String
}

struct KitStep {
    argv: [String]
    stdin: String
    exit: String
    assertions: [KitAssertion]
    cwd: String{""}
    unset: [String]{[String]{}}
    environment: [KitEnvVar]{[KitEnvVar]{}}
}

struct KitPlan {
    requires: [String]
    fixture: String
    environment: [String]
    normalize: [String]
    compile_only: Bool
    ref_audit: String
    artifact: String
    refused: String
    steps: [KitStep]
    error: String
}

struct KitOutcome {
    verdict: KitVerdict
    run: KitRun
    tier: String{"-"}
}

struct KitTier {
    name: String
    flags: [String]
    direct: Bool
    audit: Bool
}

struct KitGoldenStepCtx {
    entry: KitEntry
    tier: KitTier
    source: String
    expected: String
    last_explicit: Bool
}

struct KitStepCtx {
    plan: KitPlan
    id: String
    env: KitEnv
    work: String
    scratch: String
    snapshots: String
    bless: KitBless
    golden: KitGoldenStepCtx?
}

struct KitStepState {
    last: KitRun
    built: String
    built_once: Bool
}

struct KitStepResult {
    state: KitStepState
    verdict: KitVerdict
}

struct KitStepHooks {
    invoke: fn(KitStep, Int, KitStepCtx, KitStepState) -[Env, Exec, FS, IO, Mem.Alloc, Panic, Time, Time.Wait]> KitStepResult
    check: fn(KitStep, Int, KitStepCtx, KitStepState) -[Env, Exec, FS, IO, Mem.Alloc, Panic, Time, Time.Wait]> KitVerdict
}

// Keep callback factories beside their nominal types until #4780 is resolved.
fn kit_golden_step_hooks() -> KitStepHooks {
    KitStepHooks{
        invoke: (step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> kit_golden_step_invoke(step, index, context, state),
        check: (step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> kit_golden_step_check(step, index, context, state)
    }
}

fn kit_steps_hooks() -> KitStepHooks {
    KitStepHooks{
        invoke: (step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> kit_steps_invoke(step, index, context, state),
        check: (step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> kit_steps_check_state(step, index, context, state)
    }
}

struct KitCaseResult {
    suite: String
    case: String
    tier: String
    status: String
    detail: String
    exit: Int
}

struct KitSuite {
    name: String
    discover: fn(KitCtx) -[FS, Mem.Alloc, Panic]> [KitEntry]
    run: fn(KitEntry, KitCtx) -[Env, Exec, FS, IO, Mem.Alloc, Panic, Time, Time.Wait]> [KitOutcome]
}

struct KitSelected {
    entry: KitEntry
    suite: String
    run: fn(KitEntry, KitCtx) -[Env, Exec, FS, IO, Mem.Alloc, Panic, Time, Time.Wait]> [KitOutcome]
}

fn kit_suites() -> [KitSuite] {
    [KitSuite{name: "golden", discover: (context: KitCtx) -> kit_golden_discover_suite(context), run: (entry: KitEntry, context: KitCtx) -> kit_golden_run_suite(entry, context)}]
}

fn kit_execute_suites(options: KitOptions, root: String) -> Int {
    selected_suites := [KitSuite]{}
    loop suite in kit_suites() {
        if options.suite == "all" || options.suite == suite.name -> &selected_suites.push(suite)
    }
    if selected_suites.len() == 0 {
        print("REFUSED\tselection\t\tsuite not installed: {options.suite}")
        return 2
    }
    discovery_env :: KitEnv{root: root, scratch: "", jet: options.jet, jetpack: options.jetpack, timeout: Duration.seconds(options.timeout), memory_limit: 0}
    discovery_ctx :: KitCtx{options: options, env: discovery_env, root: root, scratch: "", bless: options.bless}
    corpus := [KitSelected]{}
    loop suite in selected_suites {
        loop entry in suite.discover(discovery_ctx) -> &corpus.push(KitSelected{entry: entry, suite: suite.name, run: suite.run})
    }
    &corpus.sort_by(item -> item.entry.path)
    selection :: kit_exec_select_ids(corpus.map(item -> item.entry.path), options)
    if selection.error != "" {
        print("REFUSED\tselection\t\t{selection.error}")
        return 2
    }
    entries :: corpus.filter(item -> kit_expect_named(selection.ids, item.entry.path))
    if entries.len() == 0 {
        print("ERROR\tselection\t\tno matching corpus entries")
        return 2
    }
    if options.list {
        loop item in entries -> print("{item.entry.suite}\t{item.entry.path}")
        return 0
    }
    if options.jet == "" {
        print("ERROR\tselection\t\t--jet must name the admitted compiler binary")
        return 2
    }
    jet :: files.canonicalize(options.jet) ?? {
        print("ERROR\tselection\t\tcompiler: {err}")
        return 2
    }
    jetpack :: if options.jetpack == "" -> "" else -> files.canonicalize(options.jetpack) ?? {
        print("ERROR\tselection\t\tjetpack: {err}")
        return 2
    }
    home :: sys.get("HOME") ?? ""
    base :: if options.scratch != "" -> options.scratch else -> sys.get("JET_TEST_SCRATCH_DIR") ?? files.join(home, ".cache/jet-dev/scratch")
    files.create_dir_all(base) ?? {
        print("ERROR\tselection\t\tscratch: {err}")
        return 2
    }
    canonical :: files.canonicalize(base) ?? {
        print("ERROR\tselection\t\tscratch: {err}")
        return 2
    }
    if canonical == root || canonical.starts_with("{root}/") || canonical == "/tmp" || canonical.starts_with("/tmp/") {
        print("ERROR\tselection\t\tscratch must be disk-backed and outside the checkout")
        return 2
    }
    run_scratch :: files.join(canonical, "testkit-{process.current_pid()}")
    if files.exists(run_scratch) {
        print("ERROR\tselection\t\tscratch already exists: {run_scratch}")
        return 2
    }
    files.create_dir_all(run_scratch) ?? {
        print("ERROR\tselection\t\tscratch: {err}")
        return 2
    }
    env :: KitEnv{root: root, scratch: run_scratch, jet: jet, jetpack: jetpack, timeout: Duration.seconds(options.timeout), memory_limit: 0}
    results := [KitCaseResult]{}
    ran_suites := [String]{}
    loop (index, item) in entries {
        entry :: item.entry
        scratch :: files.join(run_scratch, "{index}")
        files.create_dir_all(scratch) ?? {
            &results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "case scratch: {err}", exit: -1})
            next
        }
        context :: KitCtx{options: options, env: env, root: root, scratch: scratch, bless: options.bless}
        if !kit_expect_named(ran_suites, item.suite) -> &ran_suites.push(item.suite)
        loop outcome in item.run(entry, context) {
            &results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: outcome.tier, status: outcome.verdict.status, detail: outcome.verdict.detail, exit: outcome.run.code})
            if outcome.verdict.diff != "" -> print(outcome.verdict.diff)
        }
        files.remove_all(scratch) ?? {
            &results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "remove case scratch: {err}", exit: -1})
        }
    }
    kit_golden_mark_tier_splits(&results)
    loop result in results -> kit_report_row(result)
    if options.bless.ids.len() > 0 || options.bless.all -> print("bless: ids={options.bless.ids} all={options.bless.all} reason={options.bless.reason}")
    files.remove_all(run_scratch) ?? {
        &results.push(KitCaseResult{suite: "kit", case: "cleanup", tier: "-", status: "ERROR", detail: "{err}", exit: -1})
        kit_report_row(results[results.len() - 1])
    }
    kit_report_finish(jet, results, options.results, ran_suites)
}

fn run() {
    args :: process.args()
    if args.len() == 0 || args[0] == "--help" {
        print("testkit <golden|ui|cases|all> --jet BIN [--jetpack BIN] [--tier T[,T…]] [--filter SUBSTR] [--cases FILE] [--shard I/N] [--timeout SEC] [--scratch DIR] [--results FILE] [--list] [--bless ID] [--bless-all --reason TEXT] [--allow-shrink ID]")
        return
    }
    options :: kit_parse_options(args)
    if options.error != "" {
        print("REFUSED\tselection\t\t{options.error}")
        process.exit(2)
    }
    root :: files.canonicalize(sys.current_dir()) ?? panic("checkout root: {err}")
    code :: kit_execute_suites(options, root)
    if code != 0 -> process.exit(code)
}
