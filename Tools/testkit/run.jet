    raw_stderr: String{""}
}

struct KitStepState {
    last: KitRun
    built: String
    built_once: Bool
    history: [KitCapturedStep]{[KitCapturedStep]{}}
    json_stdout: String?{None}
    json_stderr: String?{None}
    children: [KitPendingChild]{[KitPendingChild]{}}
    captures: [KitCapture]{[KitCapture]{}}
    bindings: [KitCapture]{[KitCapture]{}}
    inventories: [KitInventory]{[KitInventory]{}}
    replacements: [KitReplacement]{[KitReplacement]{}}
    free_ports: [KitFreePort]{[KitFreePort]{}}
}

struct KitStepResult {
    state: KitStepState
    verdict: KitVerdict
}

// Which suite's step invocation and expectations the shared sequencing loop uses.
enum KitStepHooks {
    Golden
    Steps
}

fn kit_golden_step_hooks() -> KitStepHooks { KitStepHooks.Golden }

fn kit_steps_hooks() -> KitStepHooks { KitStepHooks.Steps }

fn kit_steps_hook_invoke(hooks: KitStepHooks, step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitStepResult {
    if hooks == {
        .Golden -> kit_golden_step_invoke(step, index, context, state)
        .Steps -> kit_steps_invoke(step, index, context, state)
    }
}

fn kit_steps_hook_check(hooks: KitStepHooks, step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitVerdict {
    if hooks == {
        .Golden -> kit_golden_step_check(step, index, context, state)
        .Steps -> kit_steps_check_state(step, index, context, state)
    }
}

// All suites share this sequencing loop. Hooks supply only suite-specific
// invocation and expectations, never an alternative parser or executor.
fn kit_steps_execute(original_context: KitStepCtx, hooks: KitStepHooks) -> KitOutcome {
    context := original_context
    state := KitStepState{last: kit_exec_failed("no steps"), built: "", built_once: false}
    plan :: context.plan
    if plan.error != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", plan.error), run: state.last}
    loop requirement in plan.requires {
        if kit_steps_build_target_text(requirement) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if !requirement.starts_with("first-existing ") -> next
        words :: kit_steps_words(requirement) ?? return kit_steps_finish(state, kit_expect_verdict("REFUSED", "invalid first-existing requirement"))
        found := false
        loop index in 3..<words.len() {
            if index % 2 == 0 -> next
            expanded :: kit_steps_runtime_expand(words[index], context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "requirement token unavailable"))
            path :: files.join(context.work, expanded)
            if files.exists(path) {
                &state.captures.push(KitCapture{name: words[1], value: KitCapturedValue.Text(path)})
                found = true
                break
            }
        }
        if !found -> return kit_steps_finish(state, kit_expect_verdict("SKIP-HOST", requirement))
    }
    requirement :: kit_steps_required(plan, context.env, context.work, context.scratch)
    if requirement == {
        .Val(value) -> return KitOutcome{verdict: value, run: state.last}
        .None -> {}
    }
    if kit_expect_named(plan.normalize, "version") && (context.env.version == "" || context.env.version_error != "") -> return KitOutcome{verdict: kit_expect_verdict("ERROR", "jet version: {context.env.version_error}"), run: state.last}
    if plan.compile_only && context.golden == None -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", "run: none is golden-only"), run: state.last}
    if plan.refused != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", plan.refused), run: state.last}
    if plan.steps.len() == 0 -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", "case has no steps"), run: state.last}
    blessing :: kit_steps_bless_plan(plan, context.id, context.bless)
    if blessing == {
        .Val(value) -> return KitOutcome{verdict: value, run: state.last}
        .None -> {}
    }
    files.create_dir_all(files.join(context.scratch, "tmp")) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "create case temp directory: {err}"))
    if plan.fixture != "" -> kit_exec_copy_tree(files.join(context.snapshots, plan.fixture), context.work, true)
    if plan.free_ports.len() > 0 {
        ports :: kit_steps_free_ports(context, plan.free_ports.len()) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "{err}"))
        loop index in 0..<plan.free_ports.len() -> &state.free_ports.push(KitFreePort{name: plan.free_ports[index], port: ports[index]})
    }
    loop index in 0..<context.plan.environment.len() {
        context.plan.environment[index] = kit_steps_runtime_expand(context.plan.environment[index], context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "case environment token unavailable"))
    }
    cursor := 0
    loops := [KitLoopFrame]{}
    loop cursor < plan.steps.len() {
        if loops.len() > 0 {
            slot :: loops.len() - 1
            if loops[slot].kind == "repeat" && cursor == loops[slot].start + 1 {
                opening :: plan.steps[loops[slot].start]
                activity :: kit_steps_repeat_check(opening, context, state)
                if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
                if activity.status == "FAIL" {
                    state = kit_steps_loop_restore(loops[slot], state)
                    cursor = loops[slot].end + 1
                    loops = loops.slice(0, slot)
                    next
                }
                if loops[slot].started.elapsed().ns >= (kit_steps_duration_ns(opening.argv[6]) ?? 0) -> return kit_steps_finish(state, kit_expect_verdict("FAIL", opening.argv[10]))
            }
        }
        index :: cursor
        original :: plan.steps[index]
        cursor += 1
        if kit_steps_build_target_conditions(original.conditions) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if !kit_steps_conditions(original.conditions, context, state) -> next
        if kit_steps_build_target_used(original, plan) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if original.action == "when" {
            if !kit_steps_condition(original.argv[0], context, state) {
                depth := 1
                loop cursor < plan.steps.len() && depth > 0 {
                    if plan.steps[cursor].action == "when" -> depth += 1
                    if plan.steps[cursor].action == "end when" -> depth -= 1
                    cursor += 1
                }
            }
            next
        }
        if original.action == "end when" -> next
        // Selected nonZ loops/awaits refuse before loop state or PID expansion.
        // Attached assertions select their own conditions after the command.
        if ((original.action == "repeat" && kit_steps_process_nonzombie_mode(original.argv[4])) || (original.action == "await" && original.argv[0] == "process" && kit_steps_process_nonzombie_mode(original.argv[2]))) && sys.name() != "linux" -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "process-state"))
        if original.action == "for" || original.action == "repeat" -> state = kit_steps_loop_initialize(original, state)
        if original.action == "for" {
            values :: kit_steps_loop_values(kit_steps_resolve_step(original, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "loop token unavailable")), context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "{err}"))
            end :: kit_steps_block_end(plan.steps, index)
            if values.len() == 0 {
                cursor = end + 1
                next
            }
            frame :: KitLoopFrame{start: index, end: end, kind: original.argv[1], name: original.argv[original.argv.len() - 1], values: values, captures: state.captures, bindings: state.bindings, started: time.instant()}
            &loops.push(frame)
            state = kit_steps_loop_bind(frame, state)
            next
        }
        if original.action == "repeat" {
            activity :: kit_steps_repeat_check(original, context, state)
            if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
            end :: kit_steps_block_end(plan.steps, index)
            if activity.status == "FAIL" {
                cursor = end + 1
                next
            }
            &loops.push(KitLoopFrame{start: index, end: end, kind: "repeat", captures: state.captures, bindings: state.bindings, started: time.instant()})
            next
        }
        if original.action == "end for" || original.action == "end repeat" {
            slot :: loops.len() - 1
            frame := loops[slot]
            state = kit_steps_loop_restore(frame, state)
            if frame.kind == "repeat" {
                opening :: plan.steps[frame.start]
                activity :: kit_steps_repeat_check(opening, context, state)
                if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
                if activity.status == "PASS" {
                    if frame.started.elapsed().ns >= (kit_steps_duration_ns(opening.argv[6]) ?? 0) -> return kit_steps_finish(state, kit_expect_verdict("FAIL", opening.argv[10]))
                    remaining :: (kit_steps_duration_ns(opening.argv[6]) ?? 0) - frame.started.elapsed().ns
                    interval :: kit_steps_duration_ns(opening.argv[8]) ?? 0
                    time.sleep(time.duration_ns(if interval < remaining -> interval else -> remaining))
                    cursor = frame.start + 1
                    next
                }
            } else {
                frame.position += 1
                if frame.position < frame.values.len() {
                    loops[slot] = frame
                    state = kit_steps_loop_bind(frame, state)
                    cursor = frame.start + 1
                    next
                }
            }
            loops = loops.slice(0, slot)
            next
        }
        if original.action == "parallel" {
            end :: kit_steps_block_end(plan.steps, index)
            invoked :: kit_steps_parallel(plan.steps.slice(cursor, end), context, state)
            state = invoked.state
            if invoked.verdict.status != "PASS" -> return kit_steps_finish(state, invoked.verdict)
            cursor = end + 1
            next
        }
        step := kit_steps_resolve_step(original, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "undefined capture or unavailable tool token"))
        if step.refused_capability != "" -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", step.refused_capability))
        if step.argv.len() > 0 && step.argv[0] == "fail" {
            if step.argv.len() != 2 -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "fail needs one message"))
            return kit_steps_finish(state, kit_expect_verdict("FAIL", step.argv[1]))
        }
        invoked :: if step.action == "poll" -> kit_steps_poll(step, index, context, state, hooks) else if kit_steps_setup_kind(step.action) || kit_expect_named(["assert", "apply-edits", "await", "session", "send", "recv", "signal", "close", "spawn", "wait", "capture", "write", "inventory"], step.action) ->
            kit_steps_action(step, context, state) else -> kit_steps_hook_invoke(hooks, step, index, context, state)
        state = invoked.state
        if invoked.verdict.status != "PASS" -> return kit_steps_finish(state, invoked.verdict)
        if kit_expect_named(["spawn", "session", "send", "signal"], step.action) -> next
        if kit_expect_named(["", "wait", "close", "poll"], step.action) {
            wired :: kit_steps_wiring_finish(step, context, state)
            state = wired.state
            if wired.verdict.status != "PASS" -> return kit_steps_finish(state, wired.verdict)
        }
        if step.action == "capture" || step.action == "assert" {
            if step.assertions.len() > 0 || step.action == "assert" {
                verdict :: kit_steps_hook_check(hooks, step, index, context, state)
                if verdict.status != "PASS" -> return kit_steps_finish(state, verdict)
            }
            next
        }
        step.replacements = kit_steps_replacements(step.replacements, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "replacement token unavailable"))
        state.replacements = step.replacements
        state.json_stdout = None
        state.json_stderr = None
        if kit_expect_named(["", "wait", "close", "poll"], step.action) && (plan.json_normalize.len() > 0 || step.json_normalize.len() > 0) && kit_steps_failure(step, state.last) == None {
            rules := plan.json_normalize
            loop rule in step.json_normalize -> &rules.push(rule)
            output :: kit_steps_json_normalize(state.last.stdout, "stdout", rules)
            errors :: kit_steps_json_normalize(state.last.stderr, "stderr", rules)
            if output.error != "" -> return kit_steps_finish(state, kit_expect_verdict("FAIL", output.error))
            if errors.error != "" -> return kit_steps_finish(state, kit_expect_verdict("FAIL", errors.error))
            state.json_stdout = Val(output.text)
            state.json_stderr = Val(errors.text)
        }
        if step.label != "" && kit_expect_named(["", "wait", "close", "poll"], step.action) {
            source_name :: if context.golden == {
                .Val(golden) -> kit_golden_source_name(golden.entry)
                .None -> ""
            }
            &state.history.push(KitCapturedStep{label: step.label,
                stdout: kit_steps_replace(kit_steps_normalize(state.json_stdout ?? state.last.stdout, context.env, context.work, context.scratch, plan.normalize, state.built, source_name), step.replacements, context, state, true, source_name),
                stderr: kit_steps_replace(kit_steps_normalize(state.json_stderr ?? state.last.stderr, context.env, context.work, context.scratch, plan.normalize, state.built, source_name), step.replacements, context, state, true, source_name),
                elapsed_ns: state.last.elapsed_ns,
                code: if state.last.signal == None -> Val(state.last.code) else -> None,
                raw_stdout: kit_steps_replace(state.last.stdout, step.replacements, context, state, false, source_name),
                raw_stderr: kit_steps_replace(state.last.stderr, step.replacements, context, state, false, source_name)})
        }
        verdict :: kit_steps_hook_check(hooks, step, index, context, state)
        if verdict.status != "PASS" -> return kit_steps_finish(state, verdict)
        if plan.compile_only -> break
    }
    kit_steps_finish(state, kit_expect_verdict("PASS", ""))
}

struct KitCaseResult {
    suite: String
    case: String
    tier: String
    status: String
    detail: String
    exit: Int
    diff: String{""}
}

struct KitSelected {
    entry: KitEntry
    suite: String
}

struct KitUIDirective {
    name: String
    argv: [String]
    parent: Bool
    exit: String
    streams: String
    capability: String
}

struct KitUICall {
    argv: [String]
    parent: Bool
    exit: String
    streams: String
    stdin: String
    extension: String
    refused: String
    unlocked_toolchain: Bool{false}
}

struct KitUIRegistryRow {
    code: String
    plane: String
    active: Bool
    edit: Bool
    reason: Bool
}

struct KitUIPlane {
    name: String
    edits: Int
    reasons: Int
    total: Int
}

struct KitUIAllowance {
    code: String
    side: String
    card: String
}

fn kit_suites() -> [String] { ["golden", "ui", "cases"] }

fn kit_suite_discover(suite: String, context: KitCtx) -> [KitEntry] {
    if suite == {
        "golden" -> kit_golden_discover_suite(context)
        "ui" -> kit_ui_discover(context)
        else -> kit_cases_discover(context)
    }
}

fn kit_suite_run(suite: String, entry: KitEntry, context: KitCtx) -> [KitOutcome] {
    if suite == {
        "golden" -> kit_golden_run_suite(entry, context)
        "ui" -> kit_ui_run(entry, context)
        else -> kit_cases_run(entry, context)
    }
}

// A suite run's exit code (kit_report_exit_code) and the report row of every case or
// selection problem that makes it nonzero, so a caller can name every failure at once.
struct KitExecution {
    code: Int
    failures: [String]
}

fn kit_execution_refused(row: String) -> KitExecution {
    print(row)
    KitExecution{code: 2, failures: [row]}
}

fn kit_case_blocks(status: String) -> Bool {
    kit_expect_named(["FAIL", "UNEXPECTED-PASS", "REFUSED", "ERROR", "TIMEOUT"], status)
}

fn kit_execute_suites(options: KitOptions, root: String) -> KitExecution {
    selected_suites := [String]{}
    loop suite in kit_suites() {
        if options.suite == "all" || options.suite == suite -> &selected_suites.push(suite)
    }
    if selected_suites.len() == 0 -> return kit_execution_refused("REFUSED\tselection\t\tsuite not installed: {options.suite}")
    timeout :: Duration.seconds(options.timeout) ?? return kit_execution_refused("REFUSED\tselection\t\ttimeout: {err}")
    discovery_env :: KitEnv{root: root, scratch: "", jet: options.jet, jetpack: options.jetpack, timeout: timeout, memory_limit: 0}
    discovery_ctx :: KitCtx{options: options, env: discovery_env, root: root, scratch: "", bless: options.bless}
    corpus := [KitSelected]{}
    loop suite in selected_suites {
        loop entry in kit_suite_discover(suite, discovery_ctx) -> &corpus.push(KitSelected{entry: entry, suite: suite})
    }
    &corpus.sort_by(item -> item.entry.path)
    selection :: kit_exec_select_ids(corpus.map(item -> item.entry.path), options)
    if selection.error != "" -> return kit_execution_refused("REFUSED\tselection\t\t{selection.error}")
    entries :: corpus.filter(item -> kit_expect_named(selection.ids, item.entry.path))
    if entries.len() == 0 -> return kit_execution_refused("ERROR\tselection\t\tno matching corpus entries")
    if options.list {
        loop item in entries -> print("{item.entry.suite}\t{item.entry.path}")
        return KitExecution{code: 0, failures: []}
    }
    if options.jet == "" -> return kit_execution_refused("ERROR\tselection\t\tJET must name the compiler under test")
    jet :: files.canonicalize(options.jet) ?? return kit_execution_refused("ERROR\tselection\t\tcompiler: {err}")
    jetpack :: if options.jetpack == "" -> "" else -> files.canonicalize(options.jetpack) ?? return kit_execution_refused("ERROR\tselection\t\tjetpack: {err}")
    home :: sys.get("HOME") ?? ""
    base :: if options.scratch != "" -> options.scratch else -> sys.get("JET_TEST_SCRATCH_DIR") ?? files.join(home, ".cache/jet-dev/scratch")
    files.create_dir_all(base) ?? return kit_execution_refused("ERROR\tselection\t\tscratch: {err}")
    canonical :: files.canonicalize(base) ?? return kit_execution_refused("ERROR\tselection\t\tscratch: {err}")
    if canonical == root || canonical.starts_with("{root}/") || canonical == "/tmp" || canonical.starts_with("/tmp/") {
        return kit_execution_refused("ERROR\tselection\t\tscratch must be disk-backed and outside the checkout")
    }
    run_scratch :: files.join(canonical, "testkit-{process.current_pid()}-{options.suite}")
    if files.exists(run_scratch) -> return kit_execution_refused("ERROR\tselection\t\tscratch already exists: {run_scratch}")
    files.create_dir_all(run_scratch) ?? return kit_execution_refused("ERROR\tselection\t\tscratch: {err}")
    env := KitEnv{root: root, scratch: run_scratch, jet: jet, jetpack: jetpack, timeout: timeout, memory_limit: 0, resident_limit: 8589934592}
    if sys.get("JET_NATIVE_TRACE_LOG") != None {
        env.trace_node = sys.get("JET_NATIVE_TRACE_NODE") ?? ""
        env.trace_cache = sys.get("JET_NATIVE_TRACE_CACHE_ROOT") ?? ""
        if env.trace_node == "" || env.trace_cache == "" {
            return kit_execution_refused("ERROR\tselection\t\tnative trace requires JET_NATIVE_TRACE_NODE and JET_NATIVE_TRACE_CACHE_ROOT")
        }
    }
    if entries.any(item -> item.suite == "ui" && item.entry.mode != "coverage") -> kit_ui_stage(root, files.join(run_scratch, "ui-source"))
    version_run :: kit_exec_invoke(env, [jet, "--version"], root, run_scratch, "")
    if version_run.code == 0 && kit_exec_process_failure(version_run) == None {
        env.version = kit_steps_version(version_run.stdout) ?? ""
        if env.version == "" -> env.version_error = "unparseable jet --version banner"
    } else {
        env.version_error = "jet --version failed: {version_run.error} {version_run.stderr}"
    }
    jobs :: kit_execute_jobs(options.jobs, entries.len(), sys.cpu_count(), kit_exec_available_memory())
    results := [KitCaseResult]{}
    ran_suites := [String]{}
    loop run in kit_execute_entries(entries, jobs, options, env, root, run_scratch) {
        if run.ran && !kit_expect_named(ran_suites, run.suite) -> &ran_suites.push(run.suite)
        loop result in run.results -> &results.push(result)
    }
    kit_golden_mark_tier_splits(&results)
    loop result in results -> kit_report_row(result)
    if options.bless.ids.len() > 0 || options.bless.all -> print("bless: ids={options.bless.ids} all={options.bless.all} reason={options.bless.reason}")
    if env.trace_node == "" {
        files.remove_all(run_scratch) ?? {
            &results.push(KitCaseResult{suite: "kit", case: "cleanup", tier: "-", status: "ERROR", detail: "{err}", exit: -1})
            kit_report_row(results[results.len() - 1])
            ()
        }
    }
    failures := [String]{}
    loop result in results {
        if kit_case_blocks(result.status) -> &failures.push("{result.status}\t{result.case}\t{result.tier}\t{result.detail}")
    }
    code :: kit_report_finish(jet, results, options.results, ran_suites)
    if code != 0 && failures.len() == 0 -> &failures.push("ERROR\tresults\t\tthe {options.suite} report could not be written to {options.results}")
    KitExecution{code: code, failures: failures}
}

// Host memory each concurrently running entry may claim when the pool sizes itself.
fn kit_job_memory() -> Int { 2147483648 }

// The pool size: an explicit --jobs, else one task per core capped so every running entry
// keeps kit_job_memory() of the host's available memory (0 is unknown); never more tasks
// than entries and never fewer than one.
fn kit_execute_jobs(requested: Int, entries: Int, cores: Int, available: Int) -> Int {
    jobs := requested
    if jobs <= 0 {
        jobs = cores
        if available > 0 && available /% kit_job_memory() < jobs -> jobs = available /% kit_job_memory()
    }
    if jobs > entries -> jobs = entries
    if jobs < 1 -> jobs = 1
    jobs
}

// One corpus entry's rows; `ran` once its private scratch exists, `done` once it reported.
struct KitEntryRun {
    index: Int
    suite: String
    ran: Bool
    done: Bool
    results: [KitCaseResult]
}

// Runs every entry in a task group admitting `jobs` children at once and returns one run
// per entry in corpus order. Each child reports its entry on a channel; verdict diffs print
// in corpus order once the group joins, so the output and the report match a serial
// (`--jobs 1`) run byte for byte.
fn kit_execute_entries(entries: [KitSelected], jobs: Int, options: KitOptions, env: KitEnv, root: String, run_scratch: String) -> [KitEntryRun] {
    { sender: done, receiver: finished } :: channel<KitEntryRun>()
    task.group pool(limit: jobs) {
        loop (index, item) in entries {
            task kit_execute_report(index, item, options, env, root, run_scratch, done.copy())
        }
    }
    runs := [KitEntryRun]{}
    loop (index, item) in entries -> &runs.push(KitEntryRun{index: index, suite: item.suite, ran: false, done: false, results: [KitCaseResult]{}})
    loop _ in 0..<entries.len() {
        run :: finished.try_receive() ?? break
        runs[run.index] = run
    }
    loop index in 0..<runs.len() {
        // A child that stopped (a panic in its entry) leaves that entry unreported.
        if !runs[index].done {
            entry :: entries[index].entry
            runs[index].results = [KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "testkit task stopped before reporting this entry", exit: -1}]
            runs[index].done = true
        }
        loop result in runs[index].results {
            if result.diff != "" -> print(result.diff)
        }
    }
    runs
}

fn kit_execute_report(index: Int, item: KitSelected, options: KitOptions, env: KitEnv, root: String, run_scratch: String, done: Sender<KitEntryRun>) {
    done.send(kit_execute_entry(index, item, options, env, root, run_scratch))
}

// One entry in its private scratch `<run>/<index>`, removed afterwards unless tracing.
fn kit_execute_entry(index: Int, item: KitSelected, options: KitOptions, env: KitEnv, root: String, run_scratch: String) -> KitEntryRun {
    entry :: item.entry
    run := KitEntryRun{index: index, suite: item.suite, ran: false, done: true, results: [KitCaseResult]{}}
    scratch :: files.join(run_scratch, "{index}")
    files.create_dir_all(scratch) ?? {
        &run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "case scratch: {err}", exit: -1})
        return run
    }
    run.ran = true
    context := KitCtx{options: options, env: env, root: root, scratch: scratch, bless: options.bless}
    context.env.trace_case = entry.path
    loop outcome in kit_suite_run(item.suite, entry, context) {
        &run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: outcome.tier, status: outcome.verdict.status, detail: outcome.verdict.detail, exit: outcome.run.code, diff: outcome.verdict.diff})
    }
    if env.trace_node == "" {
        files.remove_all(scratch) ?? {
            &run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "remove case scratch: {err}", exit: -1})
            ()
        }
    }
    run
}

// The checkout this testkit package belongs to: `jet test` runs the harness with
// JET_PROJECT_ROOT naming the package (Tools/testkit).
fn kit_gate_root() -> String Err! {
    package :: sys.get("JET_PROJECT_ROOT") ?? return Err("JET_PROJECT_ROOT is unset; run the gate with `jet test Tools/testkit`")
    root :: files.canonicalize(files.join(package, "../..")) ?? return Err("checkout root: {err}")
    Ok(root)
}

// One suite through the testkit engine: every blocking case row, one per line, or "".
// TESTKIT_ARGS adds testkit flags, split as `.case` step words (quote a value with spaces);
// JET_CI_EVIDENCE_DIR receives <suite>.json case verdicts.
fn kit_gate_suite(suite: String) -> String {
    args := [String]{suite}
    words :: kit_steps_words(sys.get("TESTKIT_ARGS") ?? "") ?? return "REFUSED\tselection\t\tTESTKIT_ARGS has an unterminated quote"
    loop word in words -> &args.push(word)
    options := kit_parse_options(args)
    if options.error != "" -> return "REFUSED\tselection\t\t{options.error}"
    options.opt_in = true
    evidence :: sys.get("JET_CI_EVIDENCE_DIR") ?? ""
    if options.results == "" && evidence != "" -> options.results = files.join(evidence, "{suite}.json")
    root :: kit_gate_root() ?? return "ERROR\tselection\t\t{err}"
    kit_execute_suites(options, root).failures.join("\n")
}

// `jet test Tools/testkit [<filter>]`: the repository's fixture gate. Each suite is one test;
// a failing test lists every failing case.
//   JET                  the compiler under test (required)
//   TESTKIT_ARGS         testkit flags for every suite, as `.case` step words: --filter SUBSTR,
//                        --cases FILE, --tier o0,o1,o2, --timeout SEC, --jobs N, --shard I/N,
//                        --scratch DIR, --jetpack BIN, --list, --coverage (ui), --bless ID,
//                        --bless-all --reason "TEXT", --allow-shrink ID
//   JET_TEST_SCRATCH_DIR disk-backed scratch outside the checkout (default ~/.cache/jet-dev/scratch)
//   JET_CI_EVIDENCE_DIR  each suite writes its case verdicts to <dir>/<suite>.json
fn test(t: Test) {
    // The harness reports every test's verdict; the failure count adds nothing to it.
    _ :: t.run()
}

#Test("suite golden") {
    assert_eq(kit_gate_suite("golden"), "")
}

#Test("suite ui") {
    assert_eq(kit_gate_suite("ui"), "")
}

#Test("suite cases") {
    assert_eq(kit_gate_suite("cases"), "")
}

// The testkit binary (`jet build Tools/testkit/run.jet`) for census and registry tooling that
// shards or lists the corpus across processes; the fixture gate itself is `jet test Tools/testkit`.
fn run() {
    args :: process.args()
    if args.len() == 0 || args[0] == "--help" {
        print("testkit <golden|ui|cases|all> --jet BIN [--jetpack BIN] [--tier T[,T…]] [--filter SUBSTR] [--cases FILE] [--shard I/N] [--timeout SEC] [--jobs N] [--scratch DIR] [--results FILE] [--list] [--opt-in] [--bless ID] [--bless-all --reason TEXT] [--allow-shrink ID]")
        return
    }
    options :: kit_parse_options(args)
    if options.error != "" {
        print("REFUSED\tselection\t\t{options.error}")
        process.exit(2)
    }
    cwd :: sys.current_dir() ?? {
        result :: KitCaseResult{suite: "kit", case: "startup", tier: "-", status: "ERROR", detail: "checkout directory: {err}", exit: -1}
        kit_report_row(result)
        code :: kit_report_finish(options.jet, [result], options.results, [String]{})
        process.exit(code)
        return
    }
    root :: files.canonicalize(cwd) ?? panic("checkout root: {err}")
    code :: kit_execute_suites(options, root).code
    if code != 0 -> process.exit(code)
}
