// The testkit binary (`jet build Tools/testkit`): the corpus pool of Compiler/JetTestKit
// for census and release tooling that shards, lists or reports the corpus across
// processes. A plain run is `jet test Compiler --profile golden|ui|cases|corpus`,
// whose profiles name the same corpora and ledger as kit_cli_layout.
use {
    process :: core.process
    files :: core.files
    sys :: core.sys
    jet_testkit.[KitCaseResult, KitOptions, kit_exec_defaults, kit_execute_suites, kit_expect_bless_error, kit_expect_named, kit_report_finish, kit_report_row, kit_suites]
}

// The checkout's corpora and accepted-failing ledger, as Compiler/package.jet's
// test profiles name them.
fn kit_cli_layout(options: &KitOptions, root: String) {
    options.golden_corpora = ["Examples/features", "tests/run"]
    options.ui_corpora = ["tests/ui", "tests/ui_lint"]
    options.cases_corpora = ["tests/cases"]
    options.ledger = files.join(root, "Tools/testkit/known-failing.tsv")
}

fn kit_parse_options(args: [String]) -> KitOptions {
    options := kit_exec_defaults()
    if args.len() == 0 -> return options
    options.suite = args[0]
    if options.suite != "golden" && options.suite != "ui" && options.suite != "cases" && options.suite != "all" {
        options.error = "invalid suite: {args[0]}"
        return options
    }
    i := 1
    loop i < args.len() {
        flag :: args[i]
        if flag == "--list" {
            options.list = true
            i += 1
            next
        }
        if flag == "--coverage" {
            options.coverage = true
            i += 1
            next
        }
        if flag == "--opt-in" {
            options.opt_in = true
            i += 1
            next
        }
        if flag == "--bless-all" {
            options.bless.all = true
            i += 1
            next
        }
        if i + 1 >= args.len() {
            options.error = "missing value for {flag}"
            return options
        }
        value :: args[i + 1]
        if flag == {
            "--jet" -> options.jet = value
            "--jetpack" -> options.jetpack = value
            "--tier" -> options.tiers = value.split(",").to_list()
            "--filter" -> options.filter = value
            "--cases" -> options.cases = value
            "--scratch" -> options.scratch = value
            "--results" -> options.results = value
            "--timeout" -> options.timeout = Int.parse(value) ?? 0
            "--jobs" -> {
                options.jobs = Int.parse(value) ?? 0
                if options.jobs <= 0 {
                    options.error = "--jobs must be a positive count"
                    return options
                }
            }
            "--memory" -> {
                options.memory = kit_parse_size(value)
                if options.memory <= 0 {
                    options.error = "--memory must be a positive size: bytes, or a count with a K, M or G suffix"
                    return options
                }
            }
            "--bless" -> &options.bless.ids.push(value)
            "--reason" -> options.bless.reason = value
            "--allow-shrink" -> &options.bless.allow_shrink.push(value)
            "--shard" -> {
                parts :: value.split("/").to_list()
                if parts.len() != 2 {
                    options.error = "--shard must be I/N"
                    return options
                }
                options.shard_index = Int.parse(parts[0]) ?? 0
                options.shard_count = Int.parse(parts[1]) ?? 0
                options.sharded = true
            }
            else -> {
                options.error = "unknown option: {flag}"
                return options
            }
        }
        i += 2
    }
    options.error = kit_expect_bless_error(options.bless, options.sharded)
    if options.error != "" -> return options
    if options.bless.ids.len() > 0 && options.bless.all {
        options.error = "--bless and --bless-all are mutually exclusive"
        return options
    }
    if options.shard_count <= 0 || options.shard_index <= 0 || options.shard_index > options.shard_count -> options.error = "invalid shard I/N"
    if options.timeout <= 0 -> options.error = "timeout must be positive seconds"
    if options.coverage && options.suite != "ui" -> options.error = "option not valid for suite: --coverage"
    seen := [String]{}
    loop tier in options.tiers {
        if tier != "o0" && tier != "o1" && tier != "o2" {
            options.error = "unknown tier: {tier}"
            return options
        }
        if kit_expect_named(seen, tier) {
            options.error = "duplicate tier: {tier}"
            return options
        }
        &seen.push(tier)
    }
    options
}

// A --memory size in bytes: a count with an optional binary K, M or G suffix; 0 when
// malformed or not positive.
fn kit_parse_size(text: String) -> Int {
    scale :: if {
        text.ends_with("K") -> 1024
        text.ends_with("M") -> 1048576
        text.ends_with("G") -> 1073741824
        else -> 1
    }
    digits :: if scale > 1 -> text.slice(0, text.len() - 1).copy() else -> text.copy()
    count :: Int.parse(digits) ?? return 0
    if count <= 0 -> return 0
    count * scale
}

// The suites a `<suite>` argument names: that one, or every suite for `all`.
fn kit_named_suites(suite: String) -> [String] {
    named := [String]{}
    loop name in kit_suites() {
        if suite == "all" || suite == name -> &named.push(name)
    }
    named
}

fn run() {
    args :: process.args()
    if args.len() == 0 || args[0] == "--help" {
        print("testkit <golden|ui|cases|all> --jet BIN [--jetpack BIN] [--tier T[,T…]] [--filter SUBSTR] [--cases FILE] [--shard I/N] [--timeout SEC] [--jobs N] [--memory SIZE] [--scratch DIR] [--results FILE] [--list] [--opt-in] [--bless ID] [--bless-all --reason TEXT] [--allow-shrink ID]")
        return
    }
    options := kit_parse_options(args)
    if options.error != "" {
        print("REFUSED\tselection\t\t{options.error}")
        process.exit(2)
    }
    cwd :: sys.current_dir() ?? {
        result :: KitCaseResult{suite: "kit", case: "startup", tier: "-", status: "ERROR", detail: "checkout directory: {err}", exit: -1}
        kit_report_row(result)
        code :: kit_report_finish(options.jet, [result], options.results, [String]{})
        process.exit(code)
        return
    }
    root :: files.canonicalize(cwd) ?? panic("checkout root: {err}")
    kit_cli_layout(&options, root)
    code :: kit_execute_suites(options, root, kit_named_suites(options.suite), None).code
    if code != 0 -> process.exit(code)
}

#Test("options refuse invalid timeouts, jobs and memory sizes before discovery") {
    assert_eq(kit_parse_options(["golden"]).timeout, 60)
    assert(kit_parse_options(["golden", "--timeout", "0"]).error != "")
    assert(kit_parse_options(["golden", "--timeout", "invalid"]).error != "")
    assert(kit_parse_options(["golden", "--jobs", "0"]).error != "")
    assert_eq(kit_parse_options(["golden", "--jobs", "3"]).jobs, 3)
    assert(kit_parse_options(["golden", "--memory", "-2G"]).error != "")
    assert_eq(kit_parse_options(["golden", "--memory", "12G"]).memory, 12 * 1073741824)
    assert_eq(kit_parse_options(["golden", "--memory", "64K"]).memory, 65536)
    assert(kit_parse_options(["cases", "--opt-in"]).opt_in)
    assert_eq(kit_named_suites("all"), ["golden", "ui", "cases"])
    assert_eq(kit_named_suites("ui"), ["ui"])
}
