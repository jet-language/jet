    replacements: [KitReplacement]{[KitReplacement]{}}
    free_ports: [String]{[String]{}}
}

struct KitOutcome {
    verdict: KitVerdict
    run: KitRun
    tier: String{"-"}
}

struct KitTier {
    name: String
    flags: [String]
    direct: Bool
}

struct KitGoldenStepCtx {
