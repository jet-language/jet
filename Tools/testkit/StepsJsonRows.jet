use core.encoding.[DataTree]
use core.encoding.json as json

fn kit_steps_json_row_expand(text: String, name: String, row: DataTree?, preview: Bool) -> String? {
    prefix :: "{{{name}."
    rest := text
    result := ""
    loop {
        start :: rest.index(prefix) ?? break
        end :: rest.slice(start, rest.len()).index("}}") ?? return None
        path :: "$.{rest.slice(start + prefix.len(), start + end)}"
        replacement := "0"
        if !preview {
            source :: row ?? return None
            selected :: kit_steps_json_select(source, kit_steps_json_path(path) ?? return None, 0) ?? return None
            if selected.len() != 1 -> return None
            replacement = json.to_string(selected[0])
        }
        result = "{result}{rest.slice(0, start)}{replacement}"
        rest = rest.slice(start + end + 1, rest.len())
    }
    Val("{result}{rest}")
}

fn kit_steps_json_rows(text: String, assertion: KitAssertion) -> String? {
    selected :: kit_steps_json_values(text, assertion.json_mode, assertion.json_path) ?? return Val("JSON each selection failed")
    rows := [DataTree]{}
    loop value in selected {
        if value == { .Array(items) -> { loop item in items -> &rows.push(item) } else -> &rows.push(value) }
    }
    loop row in rows {
        body := assertion.value
        root :: "{{{assertion.extra}}}"
        source := text
        if body.starts_with(root) {
            body = "${body.slice(root.len(), body.len())}"
            source = json.to_string(row)
        }
        expanded :: kit_steps_json_row_expand(body, assertion.extra, Val(row), false) ?? return Val("JSON bound row path missing")
        inner :: kit_steps_json_assertion("stdout {assertion.json_mode} {expanded}") ?? return Val("JSON bound row predicate invalid")
        failure :: kit_steps_json_test(source, inner.json_mode, inner.json_path, inner.json_op, inner.value)
        if failure != None -> return failure
    }
    None
}
