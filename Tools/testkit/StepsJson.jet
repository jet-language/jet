use core.encoding.json as json

// Keys, indices, universal selection, filters, and explicit object projection.
// Filter values and quoted strings are validated by the standard JSON codec.
fn kit_steps_json_path(path: String) -> [String]? {
    if !path.starts_with("$") -> return None
    parts := [String]{}
    bytes :: path.bytes()
    i := 1
    loop i < bytes.len() {
        if bytes[i] == (U8{46}) {
            start :: i
            i += 1
            if i < bytes.len() && bytes[i] == (U8{123}) {
                projection_start :: i
                loop i < bytes.len() && bytes[i] != (U8{125}) -> i += 1
                if i == bytes.len() -> return None
                part :: String.from_bytes(bytes.slice(projection_start, i + 1)) ?? return None
                if !kit_steps_json_projection_valid(part) -> return None
                &parts.push(part)
                i += 1
                next
            }
            key_start :: i
            loop i < bytes.len() {
                if bytes[i] == (U8{46}) || bytes[i] == (U8{91}) -> break
                if bytes[i] <= (U8{32}) || bytes[i] == (U8{93}) || bytes[i] == (U8{123}) || bytes[i] == (U8{125}) -> return None
                i += 1
            }
            if i == key_start -> return None
            &parts.push(String.from_bytes(bytes.slice(start, i)) ?? return None)
        } else if bytes[i] == (U8{91}) {
            i += 1
            start :: i
            depth := 1
            quoted := false
            escape := false
            loop i < bytes.len() {
                byte :: Int.from_u8(bytes[i])
                if quoted {
                    if escape -> escape = false
                    else if byte == 92 -> escape = true
                    else if byte == 34 -> quoted = false
                } else if byte == 34 -> quoted = true
                else if byte == 91 -> depth += 1
                else if byte == 93 {
                    depth -= 1
                    if depth == 0 -> break
                }
                i += 1
            }
            if i == bytes.len() || quoted -> return None
            token :: String.from_bytes(bytes.slice(start, i)) ?? return None
            if token.starts_with("?") {
                if kit_steps_json_filter(kit_steps_json_preview(token)) == None -> return None
            } else if token != "*" {
                if token.starts_with("\"") {
                    key :: json.parse(token) ?? return None
                    if kit_steps_json_type(key) != "string" -> return None
                } else {
                    number :: Int.parse(token) ?? return None
                    if token != "{number}" -> return None
                }
            }
            &parts.push(token)
            i += 1
        } else {
            return None
        }
    }
    Val(parts)
}

fn kit_steps_json_integer(text: String) -> Int? {
    value :: Int.parse(text) ?? { return None }
    Val(value)
}

// Like the standard JSON patch test operation, object key order is immaterial.
// Do not serialize/canonicalize: canonical numbers have a narrower domain than
// exact JSON integers, and comparing trees avoids an extra rendered copy.
fn kit_steps_json_equal(left: Dyn, right: Dyn) -> Bool Never! {
    if left == {
        .Object(a) -> {
            if right == {
                .Object(b) -> {
                    if a.len() != b.len() -> return false
                    loop pair in a {
                        other :: right.get(pair.key) ?? return false
                        if !kit_steps_json_equal(pair.value, other) -> return false
                    }
                    return true
                }
                else -> return false
            }
        }
        .Array(a) -> {
            if right == {
                .Array(b) -> {
                    if a.len() != b.len() -> return false
                    loop i in 0..<a.len() {
                        if !kit_steps_json_equal(a[i], b[i]) -> return false
                    }
                    return true
                }
                else -> return false
            }
        }
        .Int(a) -> {
            if right == {
                .Int(b) -> return a == b
                .Float(b) -> return Float{a} == b
                .Number(_) -> return kit_steps_json_equal(right, left)
                else -> return false
            }
        }
        .Float(a) -> {
            if right == {
                .Int(b) -> return a == Float{b}
                .Float(b) -> return a == b
                .Number(text) -> return a == (Float.parse(text) ?? return false)
                else -> return false
            }
        }
        .Number(a) -> {
            if right == {
                .Number(b) -> {
                    if a == b -> return true
                    left_int :: kit_steps_json_integer(a)
                    right_int :: kit_steps_json_integer(b)
                    if left_int == .Val(integer) {
                        if right_int == .Val(other) -> return integer == other
                    }
                    // Distinct integer tokens must not collapse above binary64's
                    // exact range, including tokens outside the Int range.
                    if !a.contains(".") && !a.contains("e") && !a.contains("E") && !b.contains(".") && !b.contains("e") && !b.contains("E") -> return false
                    return (Float.parse(a) ?? return false) == (Float.parse(b) ?? return false)
                }
                .Int(b) -> {
                    if kit_steps_json_integer(a) == .Val(integer) -> return integer == b
                    if !a.contains(".") && !a.contains("e") && !a.contains("E") -> return false
                    return (Float.parse(a) ?? return false) == Float{b}
                }
                .Float(b) -> return (Float.parse(a) ?? return false) == b
                else -> return false
            }
        }
        .Null -> {
            if right == {
                .Null -> return true
                else -> return false
            }
        }
        .Bool(a) -> {
            if right == {
                .Bool(b) -> return a == b
                else -> return false
            }
        }
        .Text(a) -> {
            if right == {
                .Text(b) -> return a == b
                else -> return false
            }
        }
        else -> return false
    }
}

fn kit_steps_json_type(value: Dyn) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(_) -> "bool"
        .Int(_) -> "int"
        .Float(_) -> "number"
        .Number(text) -> if kit_steps_json_integer(text) != None -> "int" else -> "number"
        .Text(_) -> "string"
        .Array(_) -> "array"
        .Object(_) -> "object"
        else -> "non-JSON value"
    }
}

fn kit_steps_json_has(value: Dyn, expected: Dyn) -> String? {
    if value == {
        .Array(items) -> {
            if kit_steps_json_type(expected) != "object" {
                loop item in items {
                    if kit_steps_json_equal(item, expected) -> return None
                }
                return Val("JSON array does not contain expected scalar")
            }
        }
        else -> {}
    }
    if expected == {
        .Text(key) -> {
            if value == {
                .Object(_) -> { if value.get(key) == None -> return Val("JSON object key missing: {key}") }
                else -> return Val("JSON key presence needs an object")
            }
            return None
        }
        .Object(wanted) -> {
            if wanted.len() == 0 -> return Val("JSON has needs a nonempty object")
            if value == {
                .Array(items) -> {
                    loop item in items {
                        if item == {
                            .Object(fields) -> {
                                matches := true
                                loop pair in wanted {
                                    actual :: item.get(pair.key)
                                    if actual == {
                                        .Val(child) -> {
                                            if !kit_steps_json_equal(child, pair.value) -> matches = false
                                        }
                                        .None -> matches = false
                                    }
                                    if !matches -> break
                                }
                                if matches -> return None
                            }
                            else -> {}
                        }
                    }
                    shown :: json.to_string(expected) ?? { return Val("JSON expected value could not be encoded: {err}") }
                    return Val("JSON array has no object matching {shown}")
                }
                else -> return Val("JSON has needs an array")
            }
        }
        else -> return Val("JSON has needs a nonempty object")
    }
}

fn kit_steps_json_leaf(value: Dyn, op: String, expected: Dyn, expected_type: String, count: Int) -> String? {
    if op == "has" -> return kit_steps_json_has(value, expected)
    if op == "any~" -> return kit_steps_json_any_contains(value, expected_type)
    if op == "!has" {
        if expected == {
            .Text(key) -> {
                if value == {
                    .Object(fields) -> {
                        if value.get(key) == {
                            .Val(_) -> return Val("JSON object contains forbidden key: {key}")
                            .None -> {}
                        }
                    }
                    else -> return Val("JSON key absence needs an object")
                }
                return None
            }
            else -> {}
        }
        if kit_steps_json_type(value) != "array" -> return Val("JSON !has needs an array")
        if kit_steps_json_has(value, expected) == None -> return Val("JSON array contains the forbidden object")
        return None
    }
    if op == "!=" -> return if !kit_steps_json_equal(value, expected) -> None else -> Val("JSON value equals forbidden value")
    if op == "in" {
        if expected == {
            .Array(choices) -> {
                loop choice in choices {
                    if kit_steps_json_equal(value, choice) -> return None
                }
            }
            else -> return Val("JSON in needs an array")
        }
        return Val("JSON value is not in the expected alternatives")
    }
    if op == "keys" {
        if value == {
            .Object(fields) -> {
                keys := [String]{}
                loop pair in fields -> &keys.push(pair.key)
                &keys.sort()
                wanted :: if expected == { .Array(items) -> items else -> { return Val("JSON keys needs an array") } }
                names := [String]{}
                loop item in wanted {
                    name :: if item == { .Text(text) -> text else -> { return Val("JSON keys needs strings") } }
                    &names.push(name)
                }
                &names.sort()
                return if keys == names -> None else -> Val("JSON key sets differ")
            }
            else -> return Val("JSON keys needs an object")
        }
    }
    if kit_expect_named([">", ">=", "<", "<="], op) {
        left :: kit_steps_json_number(value) ?? return Val("JSON comparison needs numbers")
        right :: kit_steps_json_number(expected) ?? return Val("JSON comparison needs numbers")
        matches :: if op == ">" -> left > right else if op == ">=" -> left >= right else if op == "<" -> left < right else -> left <= right
        return if matches -> None else -> Val("JSON numeric comparison failed")
    }
    if op == "=" {
        if kit_steps_json_equal(value, expected) -> return None
        wanted :: json.to_string(expected) ?? { return Val("JSON expected value could not be encoded: {err}") }
        actual :: json.to_string(value) ?? { return Val("JSON actual value could not be encoded: {err}") }
        return Val("JSON value differs: expected {wanted}, got {actual}")
    }
    if op == ":" {
        actual :: kit_steps_json_type(value)
        if actual == expected_type || (expected_type == "number" && actual == "int") -> return None
        return Val("JSON type differs: expected {expected_type}, got {actual}")
    }
    if op == "~" || op == "!~" || op == "^=" || op == "$=" {
        if value == {
            .Text(text) -> {
                matches :: if op == "~" -> text.contains(expected_type) else if op == "!~" -> !text.contains(expected_type) else if op == "^=" -> text.starts_with(expected_type) else -> text.ends_with(expected_type)
                if matches -> return None
            }
            else -> return Val("JSON string predicate needs a string")
        }
    }
    size :: kit_steps_json_size(value) ?? return Val("JSON count needs an array or object")
    if (op == "#=" && size != count) || (op == "#>=" && size < count) -> return Val("JSON count differs: expected {op} {count}, got {size}")
    None
}

fn kit_steps_json_test(text: String, mode: String, path: String, op: String, literal: String) -> String? {
    if op == "canonical" -> return kit_steps_json_canonical(text)
    if kit_expect_named(["==", "!=", "#=="], op) && literal.starts_with("$") -> return kit_steps_json_same_document(text, mode, path, op, literal)
    selected :: kit_steps_json_values(text, mode, path) ?? {
        if op == "!=" -> return kit_steps_json_leaf(Dyn.Null, op, json.parse(literal) ?? return Val("invalid expected JSON"), "", 0)
        return Val("JSON parse or path failed: {path}")
    }
    if selected.len() == 0 {
        if op == "#=" && literal == "0" -> return None
        return Val("JSON filter selected no values")
    }
    if op == "valid" -> return None
    expected := Dyn.Null
    expected_type := ""
    count := 0
    if kit_expect_named(["=", "!=", "has", "!has", "in", "keys", ">", ">=", "<", "<="], op) {
        expected = json.parse(literal) ?? return Val("expected JSON literal: {err}")
        if op == "=" && path.contains("[*]") && kit_steps_json_type(expected) == "array" -> return if kit_steps_json_equal(Dyn.Array(selected), expected) -> None else -> Val("JSON ordered projection differs")
    } else if op == ":" {
        expected_type = literal
        if literal != "string" && literal != "number" && literal != "int" && literal != "bool" && literal != "null" && literal != "array" && literal != "object" -> return Val("unknown JSON type: {literal}")
    } else if kit_expect_named(["~", "!~", "^=", "$=", "any~"], op) {
        expected_type = literal
    } else if op.starts_with("#") {
        count = Int.parse(literal) ?? return Val("JSON count must be a nonnegative integer")
        if count < 0 -> return Val("JSON count must be a nonnegative integer")
    } else {
        return Val("unknown JSON operator: {op}")
    }
    if op == "#distinct=" {
        values := [Dyn]{}
        loop value in selected {
            if value == { .Array(items) -> { loop item in items -> &values.push(item) } else -> &values.push(value) }
        }
        return if kit_steps_json_distinct(values) == count -> None else -> Val("JSON distinct count differs")
    }
    loop value in selected {
        failure :: kit_steps_json_leaf(value, op, expected, expected_type, count)
        if op.starts_with("#") && op != "#==" && op != "#distinct=" {
            size :: kit_steps_json_size(value) ?? return Val("JSON count needs an array or object")
            if !kit_steps_compare(size, kit_steps_byte_slice(op, 1, op.count_bytes()), count) -> return Val("JSON count comparison failed")
            next
        }
        if failure != None -> return failure
    }
    None
}

fn kit_steps_json_assertion(value: String) -> KitAssertion? {
    body :: kit_steps_body(value)
    tokens :: kit_steps_tokens(body) ?? return None
    if tokens.len() >= 2 && tokens[tokens.len() - 1].text == "canonical" {
        subject :: kit_steps_subject(tokens[0].text)
        offset :: if subject == "file" || subject == "files" -> 1 else -> 0
        if tokens.len() != 2 + offset || (!kit_steps_subject_valid(tokens[0].text) && subject != "files") -> return None
        return Val(KitAssertion{stream: subject, path: if offset == 1 -> tokens[1].text else -> "", mode: "json", value: "", json_mode: "doc", json_path: "$", json_op: "canonical"})
    }
    if tokens.len() < 4 -> return None
    subject :: kit_steps_subject(tokens[0].text)
    if !kit_steps_subject_valid(tokens[0].text) -> return None
    offset :: if subject == "file" || subject == "file?" || subject == "files" -> 1 else -> 0
    needed :: 4 + offset
    if tokens.len() < needed -> return None
    stream :: if subject == "files" -> "files" else if offset == 1 -> "file" else -> subject
    transform :: kit_steps_subject_transform(tokens[0].text)
    if transform != "" && !kit_steps_reason(value) -> return None
    mode :: tokens[1 + offset].text
    path :: tokens[2 + offset].text
    op :: tokens[3 + offset].text
    if mode != "doc" && mode != "ndjson" && mode != "toml" && !(mode.starts_with("doc[zero ") && mode.ends_with("]")) -> return None
    if path == "each" {
        if tokens.len() < 9 + offset || tokens[4 + offset].text != "as" -> return None
        rows :: tokens[3 + offset].text
        bound :: tokens[5 + offset].text
        if !bound.ends_with(":") || kit_steps_json_path(kit_steps_json_preview(rows)) == None -> return None
        name :: kit_steps_byte_slice(bound, 0, bound.count_bytes() - 1)
        if !kit_steps_env_name(name) -> return None
        inner :: kit_steps_byte_slice(value, tokens[6 + offset].start, value.count_bytes()).trim().copy()
        preview :: kit_steps_json_row_expand(inner.replace("{{{name}}}", "$"), name, None, true) ?? return None
        _ :: kit_steps_json_assertion("stdout {mode} {preview}") ?? return None
        return Val(KitAssertion{stream: stream, path: if offset == 1 -> tokens[1].text else -> "", mode: "json", value: inner, json_mode: mode, json_path: rows, json_op: "each", extra: name, transform: transform})
    }
    if kit_steps_json_path(kit_steps_json_preview(path)) == None -> return None
    source :: if offset == 1 -> tokens[1].text else -> ""
    if stream == "file" && !kit_steps_relative_path(source) -> return None
    if op == "valid" {
        if mode != "doc" || path != "$" || tokens.len() != needed || !kit_steps_reason(value) -> return None
        return Val(KitAssertion{stream: stream, path: source, mode: "json", value: "", json_mode: mode, json_path: path, json_op: op, optional_file: subject == "file?", transform: transform})
    }
    if tokens.len() == needed -> return None
    literal := kit_steps_byte_slice(body, tokens[needed].start, body.count_bytes()).trim().copy()
    if op == "any" {
        if tokens.len() != needed + 2 || tokens[needed].text != "~" || !kit_steps_reason(value) -> return None
        return Val(KitAssertion{stream: stream, path: source, mode: "json", value: tokens[needed + 1].text, json_mode: mode, json_path: path, json_op: "any~", optional_file: subject == "file?", transform: transform})
    }
    if kit_expect_named(["==", "!=", "#=="], op) && literal.starts_with("$") {
        if tokens.len() != needed + 1 || kit_steps_json_path(literal) == None -> return None
        return Val(KitAssertion{stream: stream, path: source, mode: "json", value: literal, json_mode: mode, json_path: path, json_op: op, optional_file: subject == "file?", transform: transform})
    }
    if kit_expect_named(["=", "!=", "has", "!has", "in", ">", ">=", "<", "<="], op) {
        _ :: json.parse(kit_steps_json_preview(literal)) ?? return None
    } else if op == "keys" {
        if !literal.starts_with("= ") -> return None
        literal = kit_steps_byte_slice(literal, 2, literal.count_bytes()).trim().copy()
        if kit_steps_string_array(literal) == None -> return None
    } else {
        if tokens.len() != needed + 1 -> return None
        literal = tokens[needed].text
        if op == ":" {
            if !kit_steps_reason(value) || !kit_expect_named(["string", "number", "int", "bool", "null", "array", "object"], literal) -> return None
        } else if kit_expect_named(["~", "!~", "^=", "$="], op) {
            if !kit_steps_reason(value) -> return None
        } else if kit_expect_named(["#=", "#>=", "#<=", "#>", "#<", "#distinct="], op) {
            if !kit_steps_count_target_valid(literal) -> return None
            if op == "#=" && kit_steps_count_label(literal) != "" -> return None
        } else if op == "#==" {
            if literal.contains("*") && !kit_steps_count_target_valid(literal) -> return None
        } else if op != "==" -> return None
    }
    // #4814: jet fmt adds a trailing comma inside Val(...) here; keep this layout
    Val(KitAssertion{stream: stream, path: source, mode: "json", value: literal,
        json_mode: mode, json_path: path, json_op: op, optional_file: subject == "file?", transform: transform})
}
