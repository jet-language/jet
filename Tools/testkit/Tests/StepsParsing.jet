use core.files as files
use core.sys as sys

fn kit_test_steps_bless() -> KitBless {
    KitBless{ids: [], all: false, reason: "", allow_shrink: [], first_tier: true}
}

fn kit_test_steps_env() -> KitEnv {
    root :: sys.current_dir()
    KitEnv{root: root, scratch: files.join(sys.get("HOME") ?? panic("HOME required"), ".cache/jet-dev/scratch"), jet: "", jetpack: "", timeout: 5s, memory_limit: 0}
}

#Test("step argv quoting preserves whitespace, escapes and empty arguments") {
    argv :: kit_steps_words("printf '%s' \"two words\" '' escaped\\ space") ?? panic("words")
    assert_eq(argv, ["printf", "%s", "two words", "", "escaped space"])
    assert_eq(kit_steps_words("printf 'unclosed"), None)
}

#Test("step parser covers fixture env streams files input exit normalizers") {
    plan :: kit_steps_parse("requires: tool:printf\nfixture: tree\nenv: NAME={{work}}\nnormalize: argv0\nstep: jet check \"two words.jet\"\nstdin: answers.stdin\nexit: nonzero\nstdout: = result.out\nstderr: !~ forbidden\nfile: result.txt exists\nfile: state.txt ~ ready # asynchronous state text\n")
    assert_eq(plan.error, "")
    assert_eq(plan.fixture, "tree")
    assert_eq(plan.environment, ["NAME={{work}}"])
    assert_eq(plan.steps.len(), 1)
    assert_eq(plan.steps[0].argv, ["jet", "check", "two words.jet"])
    assert_eq(plan.steps[0].cwd, "")
    assert_eq(plan.steps[0].unset.len(), 0)
    assert_eq(plan.steps[0].environment.len(), 0)
    assert_eq(plan.steps[0].stdin, "answers.stdin")
    assert_eq(plan.steps[0].exit, "nonzero")
    assert_eq(plan.steps[0].assertions.len(), 4)
    assert(kit_expect_named(plan.normalize, "argv0"))
    assert(kit_steps_parse("stdout: = result.out\n").error != "")
    assert(kit_steps_parse("step: jet check x.jet\nstdout: ~ timing\n").error != "")
    assert_eq(kit_steps_parse("run: none\nref-audit: bridge # vetted bridge\n").ref_audit, "bridge")
    assert_eq(kit_steps_parse("artifact: custom-executable\n").artifact, "custom-executable")
}

#Test("one-of compares exact alternatives and refuses blessing before writes") {
    directory :: files.join(sys.current_dir(), "Tools/testkit/Fixtures/steps")
    accepted :: "vulkan:accepted\nwebgpu:rejected\n"
    rejected :: "vulkan:rejected\nwebgpu:rejected\n"
    alternatives :: "accepted.out rejected.out"
    assert_eq(kit_steps_one_of("case", directory, alternatives, accepted, kit_test_steps_bless()).status, "PASS")
    assert_eq(kit_steps_one_of("case", directory, alternatives, rejected, kit_test_steps_bless()).status, "PASS")
    assert_eq(kit_steps_one_of("case", directory, alternatives, "vulkan:other\nwebgpu:rejected\n", kit_test_steps_bless()).status, "FAIL")
    bless :: KitBless{ids: ["case"], all: false, reason: "", allow_shrink: [], first_tier: true}
    assert_eq(kit_steps_one_of("case", directory, alternatives, accepted, bless).status, "REFUSED")
    plan :: kit_steps_parse("step: built\nstdout: one-of accepted.out rejected.out # host-dependent device\n")
    assert_eq(plan.error, "")
    refusal :: kit_steps_bless_plan(plan, "case", bless) ?? panic("one-of bless must refuse")
    assert(refusal.detail.contains("edit by hand"))
}

#Test("missing host skips before a declarative capability refusal") {
    env :: kit_test_steps_env()
    missing :: kit_steps_parse("requires: os:not-{sys.family()}\nrefused: missing Windows COM host\n")
    skipped :: kit_steps_execute(kit_steps_context(missing, "case", env, env.root, env.scratch, env.root, kit_test_steps_bless()), kit_steps_hooks())
    assert_eq(skipped.verdict.status, "SKIP-HOST")
    present :: kit_steps_parse("requires: os:{sys.family()}\nrefused: missing Windows COM host\n")
    refused :: kit_steps_execute(kit_steps_context(present, "case", env, env.root, env.scratch, env.root, kit_test_steps_bless()), kit_steps_hooks())
    assert_eq(refused.verdict.status, "REFUSED")
    assert(refused.verdict.detail.contains("COM"))
}

#Test("step stream assertions enforce exit and exact bytes") {
    env :: kit_test_steps_env()
    run :: KitRun{stdout: "two words", stderr: "", code: 0, signal: None, timed_out: false, error: ""}
    plan :: kit_steps_parse("step: printf '%s' 'two words'\nstdout: = message.out\nstderr: empty\n")
    directory :: files.join(env.root, "Tools/testkit/Fixtures/steps")
    assert_eq(kit_steps_check(plan.steps[0], "case", run, env, env.root, env.scratch, directory, kit_test_steps_bless(), plan.normalize, "", "").status, "PASS")
    bad :: KitRun{stdout: "two words", stderr: "", code: 3, signal: None, timed_out: false, error: ""}
    assert_eq(kit_steps_check(plan.steps[0], "case", bad, env, env.root, env.scratch, directory, kit_test_steps_bless(), plan.normalize, "", "").status, "FAIL")
}

#Test("build artifacts use the nearest package root or standalone entry directory") {
    root :: kit_test_core_scratch("artifacts")
    kit_exec_write(files.join(root, "pkg/package.jet"), "name: \"artifact-fixture\"\n")
    kit_exec_write(files.join(root, "pkg/nested/deep/package.jet"), "name: \"nested-fixture\"\n")
    assert_eq(kit_steps_artifact("plain/hello.jet", root, ""), files.join(root, "plain/.jet/build/hello"))
    assert_eq(kit_steps_artifact("plain/a.b.jet", root, ""), files.join(root, "plain/.jet/build/a_b"))
    assert_eq(kit_steps_artifact("pkg/nested/hello.jet", root, ""), files.join(root, "pkg/.jet/build/hello"))
    assert_eq(kit_steps_artifact("pkg/nested/deep/run.jet", root, ""), files.join(root, "pkg/nested/deep/.jet/build/run"))
    assert_eq(kit_steps_artifact("pkg/nested/hello.jet", root, "custom"), files.join(root, "pkg/.jet/build/custom"))
    files.remove_all(root) ?? panic("remove artifact scratch")
}

#Test("default step hooks resolve built after an explicit successful CLI build") {
    root :: kit_test_core_scratch("steps-built")
    kit_exec_write(files.join(root, "hello.jet"), "fn run() {{ print(\"hello\") }}\n")
    kit_exec_write(files.join(root, "expected.out"), "hello\n")
    env :: kit_test_golden_env(root)
    plan :: kit_steps_parse("step: jet build hello.jet\nstep: built\nstdout: = expected.out\n")
    outcome :: kit_steps_execute(kit_steps_context(plan, "case", env, root, root, root, kit_test_steps_bless()), kit_steps_hooks())
    assert_eq(outcome.verdict.status, "PASS")
    assert_eq(outcome.run.stdout, "hello\n")
    missing :: kit_steps_parse("step: built\n")
    refused :: kit_steps_execute(kit_steps_context(missing, "case", env, root, root, root, kit_test_steps_bless()), kit_steps_hooks())
    assert_eq(refused.verdict.status, "REFUSED")
    files.remove_all(root) ?? panic("remove steps-built scratch")
}

#Test("step cwd and environment overlay apply after case values and unset last") {
    root :: kit_test_core_scratch("step-env")
    kit_exec_write(files.join(root, "nested/marker"), "")
    kit_exec_write(files.join(root, "expected.out"), "{root}/nested|step|unset")
    env :: kit_test_golden_env(root)
    plan := kit_steps_parse("env: TESTKIT_ORDER=case\nstep: sh -c 'printf \"%s|%s|%s\" \"$PWD\" \"$TESTKIT_ORDER\" \"${{JET_RECEIPT_BYPASS-unset}}\"'\nstdout: = expected.out\n")
    plan.steps[0].cwd = "nested"
    plan.steps[0].environment = [KitEnvVar{name: "TESTKIT_ORDER", value: Val("step")}]
    plan.steps[0].unset = ["JET_RECEIPT_BYPASS"]
    outcome :: kit_steps_execute(kit_steps_context(plan, "case", env, root, root, root, kit_test_steps_bless()), kit_steps_hooks())
    assert_eq(outcome.verdict.status, "PASS")
    assert_eq(outcome.run.stdout, "{root}/nested|step|unset")
    files.remove_all(root) ?? panic("remove step-env scratch")
}
