#Test("JSON assertions use typed equality independent of object key order") {
    assert_eq(kit_steps_json_test("{{\"a\":1,\"b\":true}}", "doc", "$", "=", "{{\"b\":true,\"a\":1}}"), None)
    assert_eq(kit_steps_json_test("[1,2]", "doc", "$", "=", "[1,2]"), None)
    assert(kit_steps_json_test("[1,2]", "doc", "$", "=", "[2,1]") != None)
    assert_eq(kit_steps_json_test("{{\"a\":\"quoted text\"}}", "doc", "$.a", "=", "\"quoted text\""), None)
    assert(kit_steps_json_test("{{\"a\":null}}", "doc", "$.a", "=", "false") != None)
    assert_eq(kit_steps_json_test("1", "doc", "$", "=", "1.0"), None)
    assert_eq(kit_steps_json_test("1e0", "doc", "$", "=", "1"), None)
    assert_eq(kit_steps_json_test("9007199254740993", "doc", "$", "=", "9007199254740993"), None)
    assert(kit_steps_json_test("9007199254740992", "doc", "$", "=", "9007199254740993") != None)
    assert(kit_steps_json_test("18446744073709551614", "doc", "$", "=", "18446744073709551615") != None)
    assert_eq(kit_steps_json_scalar("{{\"count\":9007199254740993}}", "doc", "$.count"), Ok("9007199254740993"))
    assert_eq(kit_steps_json_number(json.parse("1.25e2") ?? panic("numeric token")), Val(125.0))
    edit :: kit_steps_edit(json.parse("{{\"file\":\"main.jet\",\"span\":{{\"start\":1,\"end\":3}},\"new_text\":\"fixed\"}}") ?? panic("edit numeric tokens")) ?? panic("Number offsets must decode as Int")
    assert_eq(edit.start, 1)
    assert_eq(edit.end, 3)
}

#Test("JSON assertions pin types and array or object cardinality") {
    assert_eq(kit_steps_json_test("{{\"a\":[null,true,3,1.5,\"s\",{{}}]}}", "doc", "$", "#=", "1"), None)
    assert_eq(kit_steps_json_test("{{\"a\":[null,true,3,1.5,\"s\",{{}}]}}", "doc", "$.a", "#=", "6"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[0]", ":", "null"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[1]", ":", "bool"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[2]", ":", "int"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[2]", ":", "number"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[3]", ":", "number"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[4]", ":", "string"), None)
    assert_eq(kit_steps_json_test("[null,true,3,1.5,\"s\",{{}}]", "doc", "$[5]", ":", "object"), None)
    assert_eq(kit_steps_json_test("[]", "doc", "$", ":", "array"), None)
    assert(kit_steps_json_test("1.5", "doc", "$", ":", "int") != None)
    assert(kit_steps_json_test("[1]", "doc", "$", "#=", "2") != None)
    assert(kit_steps_json_test("1", "doc", "$", "#=", "0") != None)
}

#Test("JSON wildcard requires every nonempty selected record to match") {
    rows :: "{{\"name\":\"needle\",\"mean_ns\":1}}\n\n{{\"mean_ns\":1.5,\"name\":\"needle\"}}\n"
    assert_eq(kit_steps_json_test(rows, "ndjson", "$", "#=", "2"), None)
    assert_eq(kit_steps_json_test(rows, "ndjson", "$[*].name", "=", "\"needle\""), None)
    assert_eq(kit_steps_json_test(rows, "ndjson", "$[*].mean_ns", ":", "number"), None)
    assert(kit_steps_json_test("[]", "doc", "$[*]", ":", "number") != None)
    assert(kit_steps_json_test("[1,\"bad\"]", "doc", "$[*]", ":", "number") != None)
    assert(kit_steps_json_test("{{\"name\":\"needle\"}}\n{{}}", "ndjson", "$[*].name", "=", "\"needle\"") != None)
}

#Test("JSON failures identify malformed documents missing paths and invalid grammar") {
    assert(kit_steps_json_test("not JSON", "doc", "$", "=", "null") != None)
    assert(kit_steps_json_test("{{}}", "doc", "$.missing", "=", "null") != None)
    assert(kit_steps_json_test("[]", "doc", "$[0]", "=", "null") != None)
    assert(kit_steps_json_test("true", "doc", "$.missing", "=", "null") != None)
    assert(kit_steps_json_test("{{}}", "doc", "$[0]", "=", "null") != None)
    assert(kit_steps_json_test("{{}}\nnot JSON", "ndjson", "$", "#=", "2") != None)
    assert(kit_steps_json_test("[1]", "ndjson", "$", "#=", "1") != None)
    assert(kit_steps_json_test("null", "doc", "$", "=", "invalid") != None)
    assert(kit_steps_json_test("[]", "doc", "$", "#=", "-1") != None)
    assert_eq(kit_steps_json_path("$.items[*].value[0]"), Val([".items", "*", ".value", "0"]))
    loop path in ["", ".a", "$.", "$[", "$[]", "$[-1]", "$[01]", "$[no]", "$..a", "$[0]trailing"] {
        assert_eq(kit_steps_json_path(path), None)
    }
}

#Test("JSON has selects all pinned keys in one record without imposing array order") {
    records :: "[{{\"claim\":\"needle\",\"kind\":\"unit\",\"outcome\":\"failed\",\"expectation\":\"expected_failure\",\"extra\":9}},{{\"claim\":\"other\",\"kind\":\"unit\"}}]"
    wanted :: "{{\"kind\":\"unit\",\"claim\":\"needle\",\"expectation\":\"expected_failure\",\"outcome\":\"failed\"}}"
    assert_eq(kit_steps_json_test(records, "doc", "$", "has", wanted), None)
    assert(kit_steps_json_test(records, "doc", "$", "has", "{{\"claim\":\"needle\",\"outcome\":\"passed\"}}") != None)
    assert(kit_steps_json_test(records, "doc", "$", "has", "{{\"claim\":\"missing\"}}") != None)
    assert(kit_steps_json_test("{{\"claim\":\"needle\"}}", "doc", "$", "has", "{{\"claim\":\"needle\"}}") != None)
    assert(kit_steps_json_test(records, "doc", "$", "has", "{{}}") != None)
    assert(kit_steps_json_test(records, "doc", "$", "has", "[]") != None)
}

#Test("typed JSON normalizer replaces exact spans without changing surrounding bytes") {
    rule :: KitJSONNormalization{stream: "stdout", path: "$.time", kind: "number"}
    source :: " \n{{ \"tim\\u0065\" : 1.25e2 , \"note\" : \"é }} [ \\\"quote\\\"\", \"other\" : [1, 2] }}\t\n"
    normalized :: kit_steps_json_normalize(source, "stdout", [rule])
    assert_eq(normalized.error, "")
    assert_eq(normalized.text, " \n{{ \"tim\\u0065\" : \"<<number>>\" , \"note\" : \"é }} [ \\\"quote\\\"\", \"other\" : [1, 2] }}\t\n")
    assert_eq(kit_steps_json_normalize("human text", "stderr", [rule]).text, "human text")
    wildcard :: KitJSONNormalization{stream: "stdout", path: "$.items[*].time", kind: "number"}
    values :: kit_steps_json_normalize("{{\"items\":[{{\"time\":1}}, {{ \"time\" : 2.5 }}]}}", "stdout", [wildcard])
    assert_eq(values.error, "")
    assert_eq(values.text, "{{\"items\":[{{\"time\":\"<<number>>\"}}, {{ \"time\" : \"<<number>>\" }}]}}")
}

#Test("typed JSON normalizer fails wrong types missing paths and empty wildcards") {
    rule :: KitJSONNormalization{stream: "stdout", path: "$.time", kind: "number"}
    assert(kit_steps_json_normalize("{{\"time\":\"not a number\"}}", "stdout", [rule]).error.contains("type differs"))
    assert(kit_steps_json_normalize("{{\"other\":1}}", "stdout", [rule]).error.contains("missing"))
    assert(kit_steps_json_normalize("not JSON", "stdout", [rule]).error.contains("parse"))
    wildcard :: KitJSONNormalization{stream: "stdout", path: "$.items[*].time", kind: "number"}
    assert(kit_steps_json_normalize("{{\"items\":[]}}", "stdout", [wildcard]).error.contains("empty"))
    assert(kit_steps_json_normalize("{{\"items\":[{{\"time\":1}},{{}}]}}", "stdout", [wildcard]).error.contains("missing"))
}
