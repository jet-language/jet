use core.files as files

#Test("is-f64 validates captured text including IEEE specials through real cases") {
    root :: cases_test_root("numeric-f64-parse")
    loop value in ["1.25", "+1e3", "-0.0", "NaN", "inf", "-inf"] {
        source :: "step: printf '%s' '{value}'\ncapture: number = text stdout\ncap:number: is-f64 # original predicate\n"
        assert_eq(cases_test_advanced(root, "valid", source).verdict.status, "PASS")
    }
    loop value in ["", "word", "1.2.3", " 1", "1 "] {
        source :: "step: printf '%s' '{value}'\ncapture: number = text stdout\ncap:number: is-f64 # original predicate\n"
        assert_eq(cases_test_advanced(root, "invalid", source).verdict.status, "FAIL")
    }
    assert_eq(cases_test_advanced(root, "reason", "step: printf 1\ncapture: n = text stdout\ncap:n: is-f64\n").verdict.status, "REFUSED")
    files.remove_all(root) ?? panic("remove float parse scratch")
}

#Test("f64 captured comparisons use IEEE equality ordering and parse failures") {
    root :: cases_test_root("numeric-f64-comparison")
    rows :: [
        ["1.5", "2", "<", "PASS"], ["2", "2", "<=", "PASS"],
        ["2", "1.5", ">", "PASS"], ["2", "2", ">=", "PASS"],
        ["-0.0", "0.0", "==", "PASS"], ["1", "2", "!=", "PASS"],
        ["1", "2", ">", "FAIL"], ["2", "1", "<", "FAIL"],
        ["1", "2", "==", "FAIL"], ["2", "2", "!=", "FAIL"],
        ["NaN", "NaN", "==", "FAIL"], ["NaN", "NaN", "!=", "PASS"],
        ["NaN", "1", "<", "FAIL"], ["NaN", "1", ">=", "FAIL"],
        ["word", "1", "==", "FAIL"], ["1", "word", "==", "FAIL"]
    ]
    loop (index, row) in rows {
        source :: "step: printf '%s' '{row[0]}'\ncapture: a = text stdout\nstep: printf '%s' '{row[1]}'\ncapture: b = text stdout\ncap:a: f64 {row[2]} {{cap:b}} # original predicate\n"
        assert_eq(cases_test_advanced(root, "compare-{index}", source).verdict.status, row[3])
    }
    assert_eq(cases_test_advanced(root, "invalid-op", "step: printf 1\ncapture: a = text stdout\ncap:a: f64 = {{cap:a}} # original predicate\n").verdict.status, "REFUSED")
    files.remove_all(root) ?? panic("remove float comparison scratch")
}

#Test("size capture counts bytes and delta compares absolute integer differences") {
    root :: cases_test_root("numeric-size-delta")
    prefix :: "write: data = \"é\\n\"\ncapture: size = size file data\nstep: printf 3\ncapture: exact = text stdout\n"
    good :: "{prefix}cap:size: = \"3\"\ncap:size: delta {{cap:exact}} <= 0 # original predicate\nfile: data size = {{cap:size}}\n"
    assert_eq(cases_test_advanced(root, "bytes", good).verdict.status, "PASS")
    assert_eq(cases_test_advanced(root, "different", "{prefix}cap:size: = \"2\"\n").verdict.status, "FAIL")
    loop row in [["-3", "2", "5", "PASS"], ["2", "-3", "4", "FAIL"], ["-4", "-2", "2", "PASS"], ["word", "2", "1", "FAIL"], ["1", "word", "1", "FAIL"]] {
        source :: "step: printf '%s' '{row[0]}'\ncapture: a = text stdout\nstep: printf '%s' '{row[1]}'\ncapture: b = text stdout\ncap:a: delta {{cap:b}} <= {row[2]} # original predicate\n"
        assert_eq(cases_test_advanced(root, "delta", source).verdict.status, row[3])
    }
    assert_eq(cases_test_advanced(root, "escape", "capture: n = size file ../escape\n").verdict.status, "REFUSED")
    files.remove_all(root) ?? panic("remove size delta scratch")
}

#Test("elapsed median uses real receipts with self equality strict inequality and positive time") {
    root :: cases_test_root("numeric-median")
    prefix :: "step a: printf a\nstep b: printf b\nstep c: printf c\n"
    good :: "{prefix}elapsed: median [a,b,c] <= 1 * median [c,a,b]\nelapsed: median [c,b,a] > 0ns\nelapsed: median [a,b,c] < 2 * median [a,b,c]\n"
    assert_eq(cases_test_advanced(root, "median", good).verdict.status, "PASS")
    assert_eq(cases_test_advanced(root, "strict", "{prefix}elapsed: median [a,b,c] < 1 * median [a,b,c]\n").verdict.status, "FAIL")
    assert_eq(cases_test_advanced(root, "zero-factor", "{prefix}elapsed: median [a,b,c] <= 0 * median [a,b,c]\n").verdict.status, "FAIL")
    assert_eq(cases_test_advanced(root, "saturating", "{prefix}elapsed: median [a,b,c] <= 9223372036854775807 * median [a,b,c]\n").verdict.status, "PASS")
    loop predicate in ["median [a,b] > 0ns", "median [a,b,missing] > 0ns", "median [a,b,c] <= -1 * median [a,b,c]", "median [a,b,c] > 1ns"] {
        assert_eq(cases_test_advanced(root, "invalid", "{prefix}elapsed: {predicate}\n").verdict.status, "REFUSED")
    }
    files.remove_all(root) ?? panic("remove median scratch")
}
