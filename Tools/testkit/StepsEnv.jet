
// Resolve environment tokens against the effective environment before this line.
fn kit_steps_env_token_end(argument: String, start: Int) -> Int? {
    bytes :: argument.bytes()
    i := start + 5
    depth := 1
    loop i < bytes.len() {
        byte :: Int.from_u8(bytes[i])
        if byte == 123 -> depth += 1
        if byte == 125 {
            depth -= 1
            if depth == 0 -> return Val(i + 1)
        }
        i += 1
    }
    None
}

fn kit_steps_env_name(name: String) -> Bool {
    if name == "" -> return false
    loop (index, byte) in name.bytes() {
        code :: Int.from_u8(byte)
        if code == 95 || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) -> next
        if index > 0 && code >= 48 && code <= 57 -> next
        return false
    }
    true
}

fn kit_steps_argv_env_valid(argument: String) -> Bool {
    rest := argument
    loop {
        start :: kit_steps_byte_index(rest, "{{env:") ?? return true
        end :: kit_steps_env_token_end(rest, start) ?? return false
        body :: kit_steps_byte_slice(rest, start + 5, end - 1)
        if body == "" || body.starts_with("|") -> return false
        choices :: body.split("|").to_list()
        if !kit_steps_env_name(choices[0]) -> return false
        loop choice in choices.slice(1, choices.len()) {
            if choice.starts_with("env:") && !kit_steps_env_name(kit_steps_byte_slice(choice, 4, choice.count_bytes())) -> return false
        }
        rest = kit_steps_byte_slice(rest, end, rest.count_bytes())
    }
}

fn kit_steps_env_value(name: String, env: KitEnv, scratch: String, overlay: [KitEnvVar]) -> String? {
    value := kit_exec_base_value(name, env, scratch)
    loop variable in overlay {
        if variable.name == name -> value = variable.value
    }
    value
}

fn kit_steps_env_fallback(body: String, env: KitEnv, scratch: String, overlay: [KitEnvVar]) -> String {
    choices :: body.split("|").to_list()
    loop (index, choice) in choices {
        if index > 0 && !choice.starts_with("env:") -> return choice.copy()
        name :: if index == 0 -> choice else -> kit_steps_byte_slice(choice, 4, choice.count_bytes())
        value :: kit_steps_env_value(name, env, scratch, overlay) ?? ""
        if value != "" -> return value
    }
    ""
}

fn kit_steps_argv_env(argument: String, env: KitEnv, scratch: String, overlay: [KitEnvVar]) -> String {
    rest := argument
    result := ""
    loop {
        start :: kit_steps_byte_index(rest, "{{env:") ?? break
        end :: kit_steps_env_token_end(rest, start) ?? panic("validated environment token")
        body :: kit_steps_byte_slice(rest, start + 5, end - 1)
        expanded :: kit_steps_env_fallback(body, env, scratch, overlay)
        result = "{result}{kit_steps_byte_slice(rest, 0, start)}{expanded}"
        rest = kit_steps_byte_slice(rest, end, rest.count_bytes())
    }
    "{result}{rest}"
}

fn kit_steps_whitespace_words(text: String) -> [String] {
    words := [String]{}
    bytes :: text.bytes()
    start := 0
    index := 0
    loop index < bytes.len() {
        scalar :: kit_steps_scalar(bytes, index)
        if kit_steps_unicode_space(scalar.value) {
            if index > start -> &words.push(String.from_bytes(bytes.slice(start, index)) ?? panic("word span is not UTF-8"))
            start = scalar.next
        }
        index = scalar.next
    }
    if index > start -> &words.push(String.from_bytes(bytes.slice(start, index)) ?? panic("word span is not UTF-8"))
    words
}

fn kit_steps_env_words(argument: String, env: KitEnv, scratch: String, overlay: [KitEnvVar]) -> [String]? {
    if !argument.starts_with("{{env-words:") || !argument.ends_with("}}") -> return None
    value :: kit_steps_env_fallback(kit_steps_byte_slice(argument, 11, argument.count_bytes() - 1), env, scratch, overlay)
    Val(kit_steps_whitespace_words(value))
}
