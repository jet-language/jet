#!/usr/bin/env jet
// The notebook browser journey against the production loopback server:
//
//   jet run --allow=Env,Exec,FS,IO,Net,Time Tools/notebook-test/Acceptance.jet -- \
//     --browser chromium|firefox --port <port> --token <token> --save-path <path> --merge-path <path>
//
// core.web.browser launches the engine pinned in the working directory's
// `.jet/lock` (headless, throwaway profile) and drives the notebook page over
// WebDriver BiDi: a Jet cell runs through the first-party, canvas and Jupyter
// clients with queued input, then completion, inspect, debug, profile and
// interrupt, a Markdown cell, save/open/reopen, a stable-ID merge, and both
// exports. It prints `PASS notebook browser matrix (<browser>)` and exits 0,
// or names the step that timed out and exits 1.
use {
    browser: core.web.browser
    core.web.browser.[Browser, BrowserProtocol]
    json: core.encoding.json
    process: core.process
    time: core.time
    url: core.net.url
}

C_WAIT_MS: 20000
C_POLL_MS: 80

#Error
Failure: struct {
    message: String

    impl Display {
        display: fn(self) -> String { self.message }
    }
}

// The launched session and the BiDi context id of the notebook tab.
Driver: struct {
    session: Browser
    bidi: BrowserProtocol
    context: String
}

C_SOURCE: "#FX(authority: IO, FS) {{\n    eprint(\"ambient-eprint\")\n    name: input.first() ?? \"fallback\"\n    assert(name == \"Ada\")\n    write_file(\"browser-notebook.txt\", name) ?? panic(\"write failed\")\n    assert(file_exists(\"browser-notebook.txt\"))\n    assert_eq(file_exists(\"browser-notebook.txt\"), true)\n    print(read_file(Path.from(\"browser-notebook.txt\")) ?? panic(\"read failed\"))\n}}"

run: fn() {
    args: process.args()
    engine: option(args, "--browser") ?? "chromium"
    port: option(args, "--port") ?? ""
    token: option(args, "--token") ?? ""
    save_path: option(args, "--save-path") ?? ""
    merge_path: option(args, "--merge-path") ?? ""
    if port == "" || token == "" || save_path == "" || merge_path == "" {
        process.fail(2, "usage: Acceptance.jet --browser BROWSER --port PORT --token TOKEN --save-path PATH --merge-path PATH")
    }
    driver: open(engine, "http://127.0.0.1:{port}/#token={url.percent_encode(token)}", "http://127.0.0.1:{port}/") ?? fail(err.message)
    journey(driver, save_path, merge_path) ?? {
        driver.session.close().drop("the engine also stops with the session's last owner")
        fail(err.message)
    }
    driver.session.close().drop("the engine also stops with the session's last owner")
    print("PASS notebook browser matrix ({engine})")
}

journey: fn(d: Driver, save_path: String, merge_path: String) Failure! {
    wait_for(d, "document.title === 'Jet notebook'", "notebook page")
    wait_status(d, "0 cells", "initial notebook state")

    click(d, "#new-jet")
    wait_for(d, "document.querySelectorAll('#cells .cell').length === 1", "Jet cell")
    set_cell_source(d, 0, C_SOURCE)
    run_client(d, "first-party")
    wait_for(d, "document.querySelectorAll('#cells a').length > 0", "source link")
    run_client(d, "canvas")
    run_client(d, "jupyter")

    set_value(d, "#complete", "")
    click(d, "#complete-button")
    wait_for(d, "(document.querySelector('#completion')?.textContent || '').startsWith('completions=')", "completion action")
    click_cell_action(d, "Inspect")
    wait_status(d, "inspected=", "inspect action")
    click_cell_action(d, "Debug")
    wait_status(d, "debug_attached", "debug action")
    queue_input(d, "Ada")
    click_cell_action(d, "Profile")
    wait_status(d, "profiled=", "profile action")
    click(d, "#interrupt")
    wait_status(d, "interrupt requested", "interrupt action")

    click(d, "#new-md")
    wait_for(d, "document.querySelectorAll('#cells .cell').length === 2", "Markdown cell")
    set_cell_source(d, 1, "# First-hour result\nThe shared session ran this source.")

    set_value(d, "#path", save_path)
    click(d, "#save")
    wait_status(d, "saved=", "save")
    click(d, "#open")
    wait_status(d, "opened", "open")
    click(d, "#reopen")
    wait_status(d, "reopened", "reopen")
    wait_for(d, "document.querySelectorAll('#cells .cell').length === 2", "reopened cells")
    wait_for(d, "(document.querySelectorAll('#cells textarea')[0]?.value || '') === {js(C_SOURCE)}", "reopened source")

    set_value(d, "#path", merge_path)
    click(d, "#merge")
    wait_status(d, "merged by stable cell ID", "merge")
    wait_for(d, "document.body.textContent.includes('merged from another document')", "merged Markdown")

    click(d, "#export-ipynb")
    wait_status(d, "loss", "ipynb export")
    click(d, "#export-jet")
    wait_status(d, "loss", "Jet export")
    Ok()
}

run_client: fn(d: Driver, client: String) Failure! {
    set_value(d, "#client", client)
    queue_input(d, "Ada")
    click_cell_action(d, "Run")
    wait_status(d, "ran=", "{client} run")
    output: "Array.from(document.querySelectorAll('.output pre')).map(node => node.textContent).join('\\n')"
    wait_for(d, "(() => {{ const text = {output}; return text.includes('ambient-eprint') && text.includes('Ada'); }})()", "{client} output")
    Ok()
}

queue_input: fn(d: Driver, value: String) Failure! {
    set_value(d, "#stdin", value)
    click(d, "#send-stdin")
    wait_status(d, "input queued", "queued input")
    Ok()
}

click: fn(d: Driver, selector: String) Failure! {
    missing: js("missing {selector}")
    perform(d, "(() => {{ const node = document.querySelector({js(selector)}); if (!node) throw new Error({missing}); node.click(); return true; }})()")
}

set_value: fn(d: Driver, selector: String, value: String) Failure! {
    missing: js("missing {selector}")
    perform(d, "(() => {{ const node = document.querySelector({js(selector)}); if (!node) throw new Error({missing}); node.value = {js(value)}; node.dispatchEvent(new Event('input', {{bubbles:true}})); node.dispatchEvent(new Event('change', {{bubbles:true}})); node.blur(); return true; }})()")
}

set_cell_source: fn(d: Driver, index: Int, source: String) Failure! {
    perform(d, "(() => {{ const area = document.querySelectorAll('#cells .cell textarea')[{index}]; if (!area) throw new Error('missing cell source'); area.value = {js(source)}; area.dispatchEvent(new Event('input', {{bubbles:true}})); area.blur(); return true; }})()")
}

click_cell_action: fn(d: Driver, label: String) Failure! {
    missing: js("missing cell action {label}")
    perform(d, "(() => {{ const button = Array.from(document.querySelectorAll('#cells .cell:first-child button')).find(node => node.textContent === {js(label)}); if (!button) throw new Error({missing}); button.click(); return true; }})()")
}

wait_status: fn(d: Driver, fragment: String, label: String) Failure! {
    wait_for(d, "(document.querySelector('#status')?.textContent || '').includes({js(fragment)})", label)
}

// Poll until `expression` is `true`; a thrown page error or a failed
// evaluation counts as not yet, as the page may still be rendering.
wait_for: fn(d: Driver, expression: String, label: String) Failure! {
    started: time.instant()
    loop started.elapsed_millis() < C_WAIT_MS {
        if evaluate(d, expression) == .Val(value) && value == "true" -> return Ok()
        time.sleep(time.duration_ms(C_POLL_MS))
    }
    Err(Failure{message: "timed out waiting for {label}"})
}

// Run a page action once; a thrown page error fails the journey.
perform: fn(d: Driver, expression: String) Failure! {
    if evaluate(d, expression) == {
        .Val(_) -> Ok()
        None -> Err(Failure{message: "page action threw: {expression}"})
        .Err(error) -> Err(error)
    }
}

// The page value of `expression` as `String(value)` after awaiting it, or
// None when the page threw.
evaluate: fn(d: Driver, expression: String) -> String? Failure! {
    params: Dyn.Object([(key: String, value: Dyn)]{
        (key: "expression", value: Dyn.Text("(async () => String(await ({expression})))()")),
        (key: "target", value: Dyn.Object([(key: String, value: Dyn)]{(key: "context", value: Dyn.Text(d.context.copy()))})),
        (key: "awaitPromise", value: Dyn.Bool(true)),
        (key: "resultOwnership", value: Dyn.Text("none")),
    })
    wire: json.to_string(params) ?? return Err(Failure{message: "script.evaluate parameters cannot be encoded: {err}"})
    reply: d.bidi.send("script.evaluate", wire) ?? return Err(Failure{message: "script.evaluate failed: {err}"})
    tree: json.parse(reply) ?? return Err(Failure{message: "script.evaluate reply is not JSON: {err}"})
    if text(field(tree, "type")) != "success" -> return Ok(None)
    Ok(Val(text(field(field(tree, "result"), "value"))))
}

// Launch the locked engine, open `address` in an isolated context, and find
// the tab's BiDi context id by the page origin it navigated to.
open: fn(engine: String, address: String, origin: String) -> Driver Failure! {
    session: browser.launch(engine) ?? return Err(Failure{message: "{engine} launch failed: {err}"})
    context: session.context() ?? return Err(Failure{message: "browser context failed: {err}"})
    page: context.page() ?? return Err(Failure{message: "browser page failed: {err}"})
    page.goto(address) ?? return Err(Failure{message: "navigation to {address} failed: {err}"})
    bidi: session.protocol("bidi") ?? return Err(Failure{message: "BiDi protocol unavailable: {err}"})
    reply: bidi.send("browsingContext.getTree", "{{}}") ?? return Err(Failure{message: "browsingContext.getTree failed: {err}"})
    tree: json.parse(reply) ?? return Err(Failure{message: "browsingContext.getTree reply is not JSON: {err}"})
    loop entry in items(field(tree, "contexts")) {
        if text(field(entry, "url")).starts_with(origin) -> return Ok(Driver{session: session, bidi: bidi, context: text(field(entry, "context"))})
    }
    Err(Failure{message: "no browsing context shows {origin}"})
}

// A JavaScript string literal for `value`.
js: fn(value: String) -> String { json.to_string(Dyn.Text(value.copy())) ?? "\"\"" }

field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

items: fn(tree: Dyn) -> [Dyn] {
    if tree == .Array(list) -> return list.copy()
    [Dyn]{}
}

text: fn(tree: Dyn) -> String {
    if tree == .Text(value) -> return value.copy()
    ""
}

option: fn(args: [String], name: String) -> String? {
    loop index in 0..<args.len() {
        if args[index] == name && index + 1 < args.len() -> return Val(args[index + 1].copy())
    }
    None
}

fail: fn(message: String) -> Never { process.fail(1, message) }
