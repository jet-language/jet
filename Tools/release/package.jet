// The release route: bind a compiler build to one signed candidate record,
// then publish exactly that record as an a0.0.N GitHub release.
name: "jet_release"
version: "0.0.1"
edition: "2026"
authority: { allow: [Env, Exec, FS, Time, Time.Wait] }
deps: {
    // jetpack_publication signs; it reaches Compiler/ through jet_foundation,
    // and a root package must declare each directory its dependencies reach.
    jet_foundation: ../../Compiler/JetFoundation,
    jetpack_publication: ../../Jetpack/Publication,
}
