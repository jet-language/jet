// Contract tests for the release route. Run from the repository root:
// `jet test Tools/release`. Each fixture is a small release directory with a
// fixed signing seed and a fake `gh` that writes to the fixture, so nothing
// is ever published. Every blocked case also checks that its audit entry is
// kept.

use {
    crypto: core.crypto
    files: core.files
    hex: core.encoding.hex
    json: core.encoding.json
}

COMMIT: "1111111111111111111111111111111111111111"
TREE: "2222222222222222222222222222222222222222"
OTHER_COMMIT: "4444444444444444444444444444444444444444"
SEED_IDENTITY: "jet@0.0.1#3333333333333333333333333333333333333333333333333333333333333333"
TARGET: "linux-x64"

// The fake publisher: it logs each call, and `release create` records the
// named files as uploaded assets (all, the first only, or none, by mode).
GH_SCRIPT: [String]{
    "#!/bin/sh",
    "state=$(dirname \"$0\")",
    "echo \"$*\" >> \"$state/gh.log\"",
    "mode=$(cat \"$state/mode\")",
    "if [ \"$1 $2\" = \"release view\" ]; then",
    "  [ -f \"$state/assets.json\" ] || {{ echo \"release not found\" >&2; exit 1; }}",
    "  cat \"$state/assets.json\"",
    "  exit 0",
    "fi",
    "[ \"$1 $2\" = \"release create\" ] || exit 2",
    "# publish must have its audit entry on disk before it creates anything.",
    "ls ../audit/*-publishing.json > /dev/null 2>&1 || {{ echo \"no publishing audit entry\" >&2; exit 3; }}",
    "shift 3",
    "if [ \"$mode\" = fail ]; then echo \"HTTP 502\" >&2; exit 1; fi",
    "out=\"\"",
    "while [ $# -gt 0 ]; do",
    "  case \"$1\" in",
    "    -R|--target|--title|--notes-file) shift 2; continue;;",
    "    --*) shift; continue;;",
    "  esac",
    "  out=\"$out${{out:+,}}$(printf '{{\"name\":\"%s\",\"size\":%s}}' \"$1\" \"$(wc -c < \"$1\")\")\"",
    "  shift",
    "  [ \"$mode\" = partial ] && break",
    "done",
    "printf '{{\"assets\":[%s]}}\\n' \"$out\" > \"$state/assets.json\"",
    "if [ \"$mode\" = partial ]; then echo \"upload interrupted\" >&2; exit 1; fi",
    "exit 0",
    "",
}

// The fixture's `jet`: it answers `Tools/agent/LaneCheck.jet --patterns`
// with one path rule and one word rule of its own, so the personal-information
// search runs neither the `jet` on PATH nor this machine's rules.
JET_SCRIPT: [String]{
    "#!/bin/sh",
    "if [ \"$2\" = --patterns ]; then",
    "  printf 'path\\t/fixture-home/[a-z]+\\nword\\tfixture-secret-host\\n'",
    "  exit 0",
    "fi",
    "echo \"the fixture jet only answers --patterns, not: $*\" >&2",
    "exit 2",
    "",
}

Fixture: struct {
    scratch: String
    dir: String
    evidence: [String]
    signer: Signer
    remote: Remote
    programs: Programs
}

repo_root: fn() -[FS, Env]> String Never! {
    files.absolute(".") ?? panic("the checkout root did not resolve: {err}")
}

put: fn(path: String, text: String) Never! -[FS]> {
    files.create_dir_all(files.dirname(path)) ?? panic("create {files.dirname(path)}: {err}")
    files.write(path, text) ?? panic("write {path}: {err}")
}

put_json: fn(path: String, tree: Dyn) Never! -[FS]> {
    put(path, "{json.canonical(tree) ?? panic("json: {err}")}\n")
}

read_tree: fn(path: String) -[FS]> Dyn Never! {
    json.parse(files.read(path) ?? panic("read {path}: {err}")) ?? panic("{path} is not JSON: {err}")
}

object: fn(entries: [String: Dyn]) -> Dyn Never! { Dyn.Object(entries.copy()) }

seed_bytes: fn(byte: Int) -> [U8] Never! {
    seed := [U8]{}
    loop _ in 0..<32 -> seed.push(U8{byte})
    seed
}

public_of: fn(seed: [U8]) -> String Never! {
    key: crypto.SigningKey.from_bytes(seed) ?? panic("fixture seed")
    public: hex.encode(key.public_key().bytes)
    close(key)
    public
}

scope_row: fn(scope: String, status: String) -> Dyn Never! {
    object([String: Dyn]{"scope": Dyn.Text(scope.copy()), "status": Dyn.Text(status.copy())})
}

counted: fn(scope: String, total: Int, passed: Int) -> Dyn Never! {
    object([String: Dyn]{"scope": Dyn.Text(scope.copy()), "status": Dyn.Text("PASS"), "total": Dyn.Int(total), "passed": Dyn.Int(passed)})
}

passing_rows: fn() -> [Dyn] Never! {
    [Dyn]{scope_row("gates", "PASS"), counted("tests/golden", 3, 3)}
}

jet_sha: fn(dir: String) -[FS]> String Never! {
    sha256_hex(files.read_bytes(files.join(dir, "jet")) ?? panic("read jet: {err}"))
}

// One runner's verify-full.json in `scratch/<name>/`.
runner: fn(scratch: String, name: String, dir: String, shard: Int, count: Int, status: String, rows: [Dyn]) -[FS]> String Never! {
    evidence: files.join(scratch, name)
    put_json(files.join(evidence, "verify-full.json"), object([String: Dyn]{
        "head": Dyn.Text(COMMIT),
        "jet_sha256": Dyn.Text(jet_sha(dir)),
        "rows": Dyn.Array(rows.copy()),
        "shard": object([String: Dyn]{"count": Dyn.Int(count), "index": Dyn.Int(shard)}),
        "status": Dyn.Text(status.copy()),
        "target": Dyn.Text(TARGET),
    }))
    evidence
}

write_sums: fn(dir: String) Never! -[FS]> {
    put(files.join(dir, "SHA256SUMS"), sums_text(shipped_artifacts(dir)))
}

write_build: fn(dir: String, s2: String, s3: String) Never! -[FS]> {
    put_json(files.join(dir, "BUILD.json"), object([String: Dyn]{
        "chain": object([String: Dyn]{"s1": Dyn.Text(SEED_IDENTITY), "s2": Dyn.Text(s2.copy()), "s3": Dyn.Text(s3.copy())}),
        "target": Dyn.Text(TARGET),
    }))
}

// A `build` release directory of `jet`, as the build step leaves it.
make_build: fn(dir: String, jet: String) Never! -[FS]> {
    put(files.join(dir, "jet"), jet)
    files.set_mode(files.join(dir, "jet"), 493) ?? panic("chmod jet: {err}")
    sha: jet_sha(dir)
    identity: "jet@0.0.1#{sha}"
    put(files.join(dir, "jet-runtime/native.key"), "runtime-key-1\n")
    put_json(files.join(dir, "jet-runtime/provenance.json"), object([String: Dyn]{"compilerSha256": Dyn.Text(sha)}))
    put(files.join(dir, "IDENTITY"), "{identity}\n")
    write_sums(dir)
    put(files.join(dir, "COMMIT"), "{COMMIT}\n")
    put(files.join(dir, "SEED"), "{SEED_IDENTITY}\n")
    write_build(dir, identity, identity)
}

new_fixture: fn(label: String) -[FS, Env]> Fixture Never! {
    scratch: files.mkdtemp("jet-release-{label}-") ?? panic("scratch: {err}")
    dir: files.join(scratch, "out")
    make_build(dir, "#!/bin/sh\necho jet {label}\n")
    seed_path: files.join(scratch, "keys/jet-release.ed25519")
    files.create_dir_all(files.dirname(seed_path)) ?? panic("keys: {err}")
    files.write_bytes(seed_path, seed_bytes(7)) ?? panic("seed: {err}")
    files.set_mode(seed_path, 384) ?? panic("chmod seed: {err}")
    gh: files.join(scratch, "gh/gh")
    put(gh, GH_SCRIPT.join("\n"))
    files.set_mode(gh, 493) ?? panic("chmod gh: {err}")
    put(files.join(scratch, "gh/mode"), "complete\n")
    jet: files.join(scratch, "bin/jet")
    put(jet, JET_SCRIPT.join("\n"))
    files.set_mode(jet, 493) ?? panic("chmod jet: {err}")
    Fixture{
        scratch: scratch,
        dir: dir,
        evidence: [String]{runner(scratch, "ev1", dir, 0, 1, "PASS", passing_rows())},
        signer: Signer{seed_path: seed_path, public_key: public_of(seed_bytes(7))},
        remote: Remote{slug: "example/jet", origin_tags: [Tag]{Tag{name: "a0_025", commit: OTHER_COMMIT}}, local_tags: [String]{"a0_025"}, released: [String]{"a0_025"}, on_origin_dev: true, tree: TREE, problems: [Problem]{}},
        programs: Programs{gh: [String]{gh}, jet: [String]{jet}},
    }
}

candidate: fn(fixture: Fixture) -[FS, Env, Exec, Time, Time.Wait]> Outcome Never! {
    candidate_step(fixture.dir, repo_root(), fixture.evidence, fixture.signer, fixture.remote, fixture.programs)
}

publish: fn(fixture: Fixture, dry_run: Bool{false}) -[FS, Env, Exec, Time, Time.Wait]> Outcome Never! {
    publish_step(fixture.dir, repo_root(), fixture.signer.public_key, fixture.remote, fixture.programs, dry_run: dry_run)
}

problem_lines: fn(problems: [Problem]) -> String Never! {
    lines := [String]{}
    loop found in problems -> lines.push("[{found.class}] {found.text}")
    lines.join("\n")
}

has_problem: fn(problems: [Problem], class: String, part: String) -> Bool Never! {
    loop found in problems {
        if found.class == class && found.text.contains(part) -> return true
    }
    false
}

// `outcome` has `verdict`, names a `class` problem containing `part`, and
// its audit entry is on disk with the same verdict and problem.
expect: fn(outcome: Outcome, verdict: String, class: String, part: String) Never! -[FS]> {
    if outcome.verdict != verdict || !has_problem(outcome.problems, class, part) -> panic("want {verdict} with [{class}] `{part}`, got {outcome.verdict}:\n{problem_lines(outcome.problems)}")
    audit: read_tree(outcome.audit)
    assert_eq(text_field(audit, "verdict"), verdict)
    kept := [Problem]{}
    loop item in array_field(audit, "problems") -> kept.push(problem(text_field(item, "class"), text_field(item, "text")))
    assert(has_problem(kept, class, part))
}

expect_clean: fn(outcome: Outcome, verdict: String) Never! -[FS]> {
    if outcome.verdict != verdict || outcome.problems.len() > 0 -> panic("want a clean {verdict}, got {outcome.verdict}:\n{problem_lines(outcome.problems)}")
    assert_eq(text_field(read_tree(outcome.audit), "verdict"), verdict)
}

gh_log: fn(fixture: Fixture) -[FS]> [String] Never! {
    text: files.read(files.join(fixture.scratch, "gh/gh.log")) ?? return [String]{}
    lines := [String]{}
    loop line in text.split("\n").to_list() {
        if line != "" -> lines.push(line.copy())
    }
    lines
}

released: fn(fixture: Fixture, name: String) -> Fixture Never! {
    out := fixture.copy()
    out.remote.released.push(name.copy())
    out
}

shipped_sha: fn(record: Dyn, path: String) -> String Never! {
    loop item in array_field(field(record, "artifacts"), "shipped") {
        if text_field(item, "path") == path -> return text_field(item, "sha256")
    }
    ""
}

texts: fn(items: [Dyn]) -> [String] Never! {
    out := [String]{}
    loop item in items {
        if item == .Text(value) -> out.push(value.copy())
    }
    out
}

// c19: one record binds every part of the candidate.

#Test("the candidate record binds source, toolchain, artifacts, signature, tests, support matrix, provenance and metadata") {
    fixture: new_fixture("bind")
    expect_clean(candidate(fixture), "CANDIDATE")
    dir: fixture.dir
    record: read_tree(files.join(dir, CANDIDATE_FILE))
    sha: jet_sha(dir)
    identity: "jet@0.0.1#{sha}"
    asset: "jet-a0_026-{TARGET}.tar.gz"
    assert_eq(text_field(record, "schema"), CANDIDATE_SCHEMA)
    assert_eq(text_field(record, "name"), "a0_026")
    assert_eq(text_field(field(record, "source"), "commit"), COMMIT)
    assert_eq(text_field(field(record, "source"), "tree"), TREE)
    assert_eq(text_field(field(record, "source"), "repository"), "example/jet")
    toolchain: field(record, "toolchain")
    assert_eq(text_field(toolchain, "identity"), identity)
    assert_eq(text_field(toolchain, "seed"), SEED_IDENTITY)
    assert_eq(text_field(field(toolchain, "fixed_point"), "s2"), identity)
    assert_eq(text_field(field(toolchain, "fixed_point"), "s3"), identity)
    assert_eq(shipped_sha(record, "jet"), sha)
    assert_eq(shipped_sha(record, "jet-runtime/native.key"), sha256_hex("runtime-key-1\n".bytes()))
    staged := [String]{}
    loop item in array_field(field(record, "artifacts"), "release") {
        staged.push(text_field(item, "path"))
        assert_eq(text_field(item, "sha256"), sha256_hex(files.read_bytes(files.join(files.join(dir, STAGE_DIR), text_field(item, "path"))) ?? panic("staged {err}")))
    }
    assert_eq(staged, [String]{asset, "{asset}.sha256", "jet", "IDENTITY", "SHA256SUMS"})
    assert_eq(text_field(field(record, "signatures"), "signer"), fixture.signer.public_key)
    tests: array_field(record, "tests")
    assert_eq(tests.len(), 1)
    assert_eq(text_field(tests[0], "file"), "receipts/001-verify-full.json")
    receipt_bytes: files.read_bytes(files.join(fixture.evidence[0], "verify-full.json")) ?? panic("receipt {err}")
    assert_eq(files.read_bytes(files.join(dir, "receipts/001-verify-full.json")) ?? panic("copy {err}"), receipt_bytes)
    assert_eq(text_field(tests[0], "sha256"), sha256_hex(receipt_bytes))
    assert_eq(text_field(tests[0], "jet_sha256"), sha)
    matrix: array_field(record, "support_matrix")
    assert_eq(matrix.len(), 1)
    assert_eq(text_field(matrix[0], "target"), TARGET)
    assert_eq(text_field(matrix[0], "asset"), asset)
    assert_eq(texts(array_field(matrix[0], "receipts")), [String]{"receipts/001-verify-full.json"})
    provenance: field(record, "provenance")
    assert_eq(text_field(provenance, "runtime_packed_by"), sha)
    assert_eq(text_field(provenance, "runtime_key"), "runtime-key-1")
    assert_eq(text_field(provenance, "gate"), "verify-full")
    metadata: field(record, "metadata")
    assert_eq(texts(array_field(metadata, "assets")), [String]{asset, "{asset}.sha256", "jet", "IDENTITY", "SHA256SUMS", CANDIDATE_FILE, SIGNATURE_FILE})
    assert_eq(text_field(metadata, "tag"), "target")
    notes: files.read(files.join(files.join(dir, STAGE_DIR), NOTES_FILE)) ?? panic("notes {err}")
    assert_eq(text_field(metadata, "notes_sha256"), sha256_hex(notes.bytes()))
    assert(notes.contains(fixture.signer.public_key))
    assert(notes.contains("- Identity: `{identity}`"))
    assert(notes.contains("- Commit: {COMMIT}"))
    assert(notes.contains("- Seed: `{SEED_IDENTITY}`"))
    assert(notes.contains("- Gate: `Tools/agent/VerifyFull.jet` passed on this commit with this binary (2 checks from 1 runner)."))
    assert(notes.contains("gh release download -R example/jet -p 'jet-a0_*-{TARGET}.tar.gz*'"))
    digest: text_field(record, "content_digest")
    assert_eq(content_digest(record) ?? panic("digest {err.text}"), digest)
    signature: (files.read(files.join(dir, SIGNATURE_FILE)) ?? panic("sig {err}")).trim().copy()
    assert(verify_digest(fixture.signer.public_key, digest, signature))
    assert(!verify_digest(public_of(seed_bytes(8)), digest, signature))
    assert_eq(files.read(files.join(files.join(dir, STAGE_DIR), CANDIDATE_FILE)) ?? panic("staged record {err}"), files.read(files.join(dir, CANDIDATE_FILE)) ?? panic("record {err}"))
    dry: publish(fixture, dry_run: true)
    expect_clean(dry, "DRY-RUN")
    assert(dry.report.join("\n").contains("gh release create a0_026 -R example/jet --target {COMMIT} --title a0_026 --notes-file NOTES.md --latest {asset}"))
    assert_eq(gh_log(fixture), [String]{})
}

#Test("publish refuses a release directory that no longer matches its signed record") {
    // The commit, a receipt, a staged asset and the toolchain each change
    // after the record was signed.
    edits: [String]{"commit", "receipt", "asset", "toolchain"}
    loop edit in edits {
        fixture: new_fixture("mismatch-{edit}")
        expect_clean(candidate(fixture), "CANDIDATE")
        dir: fixture.dir
        section := ""
        if {
            edit == "commit" -> {
                put(files.join(dir, "COMMIT"), "{OTHER_COMMIT}\n")
                section = "`source.commit`"
            }
            edit == "receipt" -> {
                rows := passing_rows()
                rows.push(scope_row("tests/ui", "PASS"))
                put(files.join(dir, "receipts/001-verify-full.json"), files.read(files.join(runner(fixture.scratch, "ev-edit", dir, 0, 1, "PASS", rows), "verify-full.json")) ?? panic("edited receipt {err}"))
                section = "`tests`"
            }
            edit == "asset" -> {
                put(files.join(files.join(dir, STAGE_DIR), "IDENTITY"), "jet@0.0.1#{"0".repeat(64)}\n")
                section = "`artifacts.release`"
            }
            else -> {
                put(files.join(dir, "SEED"), "jet@0.0.1#{"5".repeat(64)}\n")
                section = "`toolchain.seed`"
            }
        }
        outcome: publish(fixture, dry_run: true)
        expect(outcome, "BLOCKED", MISMATCH, section)
        assert_eq(gh_log(fixture), [String]{})
    }
}

#Test("publish refuses an edited record, whether or not its digest was recomputed") {
    fixture: new_fixture("edited")
    expect_clean(candidate(fixture), "CANDIDATE")
    path: files.join(fixture.dir, CANDIDATE_FILE)
    original: files.read(path) ?? panic("record {err}")
    put(path, original.replace("\"latest\":true", "\"latest\":false"))
    expect(publish(fixture, dry_run: true), "BLOCKED", MISMATCH, "changed after it was sealed")
    // Resealed by someone without the key: the digest is consistent, so the
    // signature is what fails.
    resealed: sealed_record(read_tree(path)) ?? panic("reseal {err.text}")
    put(path, resealed)
    expect(publish(fixture, dry_run: true), "BLOCKED", SIGNING, "is not a valid signature")
    assert_eq(gh_log(fixture), [String]{})
}

// c20: each failure blocks the release and keeps its evidence.

#Test("a missing runner blocks the candidate: an unreported shard or a runner that never wrote its receipt") {
    fixture := new_fixture("runner")
    fixture.evidence = [String]{runner(fixture.scratch, "ev-half", fixture.dir, 0, 2, "PASS", passing_rows())}
    outcome: candidate(fixture)
    expect(outcome, "BLOCKED", MISSING_RUNNER, "shard 2 of 2 for {TARGET}")
    assert(!files.exists(files.join(fixture.dir, CANDIDATE_FILE)))
    absent := new_fixture("runner-absent")
    absent.evidence.push(files.join(absent.scratch, "never-ran"))
    expect(candidate(absent), "BLOCKED", MISSING_RUNNER, "never reported")
    none := new_fixture("runner-none")
    none.evidence = [String]{}
    expect(candidate(none), "BLOCKED", MISSING_RUNNER, "--evidence")
}

#Test("a check that passed in one run and failed in another blocks as flaky") {
    fixture := new_fixture("flaky")
    fixture.evidence.push(runner(fixture.scratch, "ev-rerun", fixture.dir, 0, 1, "FAIL", [Dyn]{scope_row("gates", "PASS"), scope_row("tests/golden", "FAIL")}))
    outcome: candidate(fixture)
    expect(outcome, "BLOCKED", FLAKY, "tests/golden on {TARGET} was PASS in one run and FAIL")
    expect(outcome, "BLOCKED", FLAKY, "a flaky gate")
    assert(!files.exists(files.join(fixture.dir, CANDIDATE_FILE)))
}

#Test("a skipped check blocks: a blocked row, a partial case count, or a gate that ran nothing") {
    cases: [(label: String, rows: [Dyn], part: String)]{
        (label: "blocked", rows: [Dyn]{scope_row("gates", "PASS"), scope_row("tests/cases", "BLOCKED")}, part: "tests/cases is BLOCKED"),
        (label: "count", rows: [Dyn]{scope_row("gates", "PASS"), counted("tests/golden", 3, 2)}, part: "passed 2 of 3 cases"),
        (label: "empty", rows: [Dyn]{}, part: "the gate ran nothing"),
    }
    loop item in cases {
        fixture := new_fixture("skip-{item.label}")
        fixture.evidence = [String]{runner(fixture.scratch, "ev-skip", fixture.dir, 0, 1, "PASS", item.rows)}
        outcome: candidate(fixture)
        expect(outcome, "BLOCKED", SKIPPED, item.part)
        assert(!files.exists(files.join(fixture.dir, CANDIDATE_FILE)))
    }
}

#Test("a shipped file that names personal information blocks: a path rule, and a word rule in any case") {
    leaks: [(label: String, jet: String)]{
        (label: "path", jet: "#!/bin/sh\necho /fixture-home/ada\n"),
        (label: "word", jet: "#!/bin/sh\necho built on Fixture-Secret-Host\n"),
    }
    loop leak in leaks {
        fixture := new_fixture("leak-{leak.label}")
        make_build(fixture.dir, leak.jet)
        fixture.evidence = [String]{runner(fixture.scratch, "ev-leak", fixture.dir, 0, 1, "PASS", passing_rows())}
        outcome: candidate(fixture)
        expect(outcome, "BLOCKED", PERSONAL, "jet names personal information")
        assert(!files.exists(files.join(fixture.dir, CANDIDATE_FILE)))
    }
}

#Test("a stale artifact blocks: a runtime packed by another jet, a receipt of another commit, a jet rebuilt after signing") {
    runtime: new_fixture("stale-runtime")
    put_json(files.join(runtime.dir, "jet-runtime/provenance.json"), object([String: Dyn]{"compilerSha256": Dyn.Text("6".repeat(64))}))
    write_sums(runtime.dir)
    expect(candidate(runtime), "BLOCKED", STALE, "packed by jet {"6".repeat(64)}")
    receipt := new_fixture("stale-receipt")
    path: files.join(receipt.evidence[0], "verify-full.json")
    put(path, (files.read(path) ?? panic("receipt {err}")).replace(COMMIT, OTHER_COMMIT))
    expect(candidate(receipt), "BLOCKED", STALE, "is pinned to {OTHER_COMMIT}")
    sums := new_fixture("stale-sums")
    put(files.join(sums.dir, "jet-runtime/native.key"), "runtime-key-2\n")
    expect(candidate(sums), "BLOCKED", STALE, "SHA256SUMS does not match")
    rebuilt: new_fixture("stale-jet")
    expect_clean(candidate(rebuilt), "CANDIDATE")
    put(files.join(rebuilt.dir, "jet"), "#!/bin/sh\necho rebuilt\n")
    outcome: publish(rebuilt, dry_run: true)
    expect(outcome, "BLOCKED", STALE, "does not name jet")
    expect(outcome, "BLOCKED", MISMATCH, "`artifacts.shipped`")
    assert_eq(gh_log(rebuilt), [String]{})
}

#Test("a signing failure blocks: no key, a key pair that does not match, a record signed by another key") {
    missing := new_fixture("sign-missing")
    missing.signer.seed_path = files.join(missing.scratch, "keys/absent.ed25519")
    expect(candidate(missing), "BLOCKED", SIGNING, "signing with")
    assert(!files.exists(files.join(missing.dir, CANDIDATE_FILE)))
    assert(!files.exists(files.join(missing.dir, SIGNATURE_FILE)))
    pair := new_fixture("sign-pair")
    pair.signer.public_key = public_of(seed_bytes(8))
    expect(candidate(pair), "BLOCKED", SIGNING, "the key pair does not match")
    unkeyed := new_fixture("sign-unkeyed")
    unkeyed.signer.public_key = ""
    expect(candidate(unkeyed), "BLOCKED", SIGNING, "jet registry keygen")
    other := new_fixture("sign-other")
    expect_clean(candidate(other), "CANDIDATE")
    other.signer.public_key = public_of(seed_bytes(8))
    expect(publish(other, dry_run: true), "BLOCKED", SIGNING, "not the trusted key")
}

#Test("nondeterminism blocks: a chain without a fixed point, an archive that packs differently") {
    chain: new_fixture("chain")
    identity: "jet@0.0.1#{jet_sha(chain.dir)}"
    write_build(chain.dir, identity, "jet@0.0.1#{"7".repeat(64)}")
    expect(candidate(chain), "BLOCKED", NONDETERMINISM, "no fixed point")
    unrecorded: new_fixture("chain-missing")
    write_build(unrecorded.dir, "", "")
    expect(candidate(unrecorded), "BLOCKED", NONDETERMINISM, "no record of the chain's fixed point")
    archive: new_fixture("pack")
    expect_clean(candidate(archive), "CANDIDATE")
    staged: files.join(files.join(archive.dir, STAGE_DIR), "jet-a0_026-{TARGET}.tar.gz")
    first: files.read_bytes(staged) ?? panic("archive {err}")
    assert_eq(repack_problems(archive.dir, staged, 90).len(), 0)
    assert_eq(files.read_bytes(files.join(archive.dir, "audit/090-repack/jet-a0_026-{TARGET}.tar.gz")) ?? panic("repack {err}"), first)
    changed := first.copy()
    changed.push(U8{0})
    files.write_bytes(staged, changed) ?? panic("rewrite {err}")
    repacked: repack_problems(archive.dir, staged, 91)
    assert(has_problem(repacked, NONDETERMINISM, "packing jet-a0_026-{TARGET}.tar.gz twice gave different bytes"))
    assert(files.exists(files.join(archive.dir, "audit/091-repack/jet-a0_026-{TARGET}.tar.gz")))
}

#Test("a partial publication blocks, keeps the stage and the audit, and a rerun refuses to create again") {
    fixture: new_fixture("partial")
    expect_clean(candidate(fixture), "CANDIDATE")
    put(files.join(fixture.scratch, "gh/mode"), "partial\n")
    outcome: publish(fixture)
    expect(outcome, "PARTIAL", PARTIAL, "GitHub lacks jet-a0_026-{TARGET}.tar.gz.sha256")
    expect(outcome, "PARTIAL", PARTIAL, "gh release create exited 1")
    assert(files.exists(files.join(files.join(fixture.dir, STAGE_DIR), "jet")))
    calls: gh_log(fixture)
    assert_eq(calls.len(), 2)
    assert(calls[0].starts_with("release create a0_026 -R example/jet --target {COMMIT}"))
    assert(calls[1].starts_with("release view a0_026"))
    rerun: publish(released(fixture, "a0_026"))
    expect(rerun, "PARTIAL", PARTIAL, "GitHub lacks")
    assert(rerun.report.join("\n").contains("gh release upload a0_026"))
    again: gh_log(fixture)
    assert_eq(again.len(), 3)
    assert(again[2].starts_with("release view a0_026"))
    assert(files.exists(files.join(fixture.dir, "audit/002-publish.json")))
    assert(files.exists(files.join(fixture.dir, "audit/003-publish.json")))
}

#Test("a failed create blocks; a complete upload publishes once and a rerun only confirms it") {
    failed: new_fixture("create-failed")
    expect_clean(candidate(failed), "CANDIDATE")
    put(files.join(failed.scratch, "gh/mode"), "fail\n")
    expect(publish(failed), "FAILED", PARTIAL, "gh release create exited 1: HTTP 502")
    complete: new_fixture("complete")
    expect_clean(candidate(complete), "CANDIDATE")
    expect_clean(publish(complete), "PUBLISHED")
    expect_clean(publish(released(complete, "a0_026")), "PUBLISHED")
    calls: gh_log(complete)
    creates := 0
    loop call in calls {
        if call.starts_with("release create") -> creates += 1
    }
    assert_eq(creates, 1)
}

#Test("rerunning candidate keeps every earlier stage, record and audit entry") {
    fixture: new_fixture("rerun")
    expect_clean(candidate(fixture), "CANDIDATE")
    first: files.read(files.join(fixture.dir, CANDIDATE_FILE)) ?? panic("record {err}")
    expect_clean(candidate(fixture), "CANDIDATE")
    audit: files.join(fixture.dir, AUDIT_DIR)
    assert(files.exists(files.join(audit, "001-candidate.json")))
    assert(files.exists(files.join(audit, "002-candidate.json")))
    assert(files.exists(files.join(audit, "002-release/jet")))
    assert(files.exists(files.join(audit, "002-receipts/001-verify-full.json")))
    assert_eq(files.read(files.join(audit, "002-CANDIDATE.json")) ?? panic("kept record {err}"), first)
    assert(files.exists(files.join(audit, "002-CANDIDATE.json.sig")))
}

#Test("publish needs the candidate's audit entry, and its own entry on disk before gh runs") {
    unaudited: new_fixture("unaudited")
    expect_clean(candidate(unaudited), "CANDIDATE")
    entry: files.join(unaudited.dir, "{AUDIT_DIR}/001-candidate.json")
    files.rename(entry, "{entry}.moved") ?? panic("move {err}")
    expect(publish(unaudited, dry_run: true), "BLOCKED", MISMATCH, "holds no candidate entry")
    assert_eq(gh_log(unaudited), [String]{})
    // The fake gh refuses to create unless audit/NNN-publishing.json exists.
    ordered: new_fixture("ordered")
    expect_clean(candidate(ordered), "CANDIDATE")
    expect_clean(publish(ordered), "PUBLISHED")
    assert_eq(text_field(read_tree(files.join(ordered.dir, "{AUDIT_DIR}/002-publishing.json")), "verdict"), "PUBLISHING")
    sealed: new_fixture("sealed")
    expect_clean(candidate(sealed), "CANDIDATE")
    audit: files.join(sealed.dir, AUDIT_DIR)
    files.set_mode(audit, 365) ?? panic("chmod audit: {err}")
    outcome: publish(sealed)
    files.set_mode(audit, 493) ?? panic("chmod audit: {err}")
    if outcome.verdict != "BLOCKED" || !has_problem(outcome.problems, INPUT, "cannot create") -> panic("want BLOCKED on an unwritable audit, got {outcome.verdict}:\n{problem_lines(outcome.problems)}")
    assert_eq(gh_log(sealed), [String]{})
    kept: write_audit(sealed.dir, 1, "candidate", "CANDIDATE", [Problem]{}, [String: Dyn]{}) ?? "refused: {err.text}"
    assert(kept.contains("already exists"))
}

#Test("an admitted release needs a full passing RELEASE.json of its own identity, and its tag on origin") {
    identity: "jet@0.0.1#{"a".repeat(64)}"
    good: object([String: Dyn]{"schema": Dyn.Text("jet-release/v1"), "name": Dyn.Text("a0_026"), "commit": Dyn.Text("c".repeat(40)), "verdict": Dyn.Text("PASS"), "scope": Dyn.Text("full"), "identity": Dyn.Text(identity)})
    assert_eq(admission_problems(good, identity).len(), 0)
    bad: object([String: Dyn]{"schema": Dyn.Text("jet-release/v1"), "name": Dyn.Text(""), "commit": Dyn.Text("c".repeat(40)), "verdict": Dyn.Text("FAIL"), "scope": Dyn.Text("filtered: io"), "identity": Dyn.Text("jet@0.0.1#b")})
    found: admission_problems(bad, identity)
    assert(has_problem(found, ADMISSION, "verdict is FAIL, not PASS"))
    assert(has_problem(found, ADMISSION, "scope is filtered: io, not full"))
    assert(has_problem(found, ADMISSION, "admitted jet@0.0.1#b, not {identity}"))
    assert(has_problem(found, ADMISSION, "name or commit is missing"))
    release := read_release("/nonexistent")
    release.kind = "admitted"
    release.commit = "c".repeat(40)
    remote: Remote{slug: "example/jet", origin_tags: [Tag]{Tag{name: "a0_026", commit: "d".repeat(40)}}, local_tags: [String]{}, released: [String]{}, on_origin_dev: false, tree: TREE, problems: [Problem]{}}
    assert(has_problem(remote_problems(release, remote, "a0_026"), REMOTE, "names {"d".repeat(40)}"))
    assert(has_problem(remote_problems(release, remote, "a0_027"), REMOTE, "is missing"))
}

#Test("the GitHub slug, origin tags and next release name come from git's own output") {
    assert_eq(github_slug("git@github.com:jet-language/jet"), "jet-language/jet")
    assert_eq(github_slug("https://github.com/jet-language/jet.git\n"), "jet-language/jet")
    assert_eq(github_slug("https://gitlab.com/jet-language/jet.git"), "")
    tags: remote_tags("aaa\trefs/tags/a0_021\nbbb\trefs/tags/a0_021^{{}}\nccc\trefs/tags/a0_025\n")
    assert_eq(tags.len(), 2)
    assert_eq(tag_commit(tags, "a0_021"), Val("bbb"))
    assert_eq(tag_commit(tags, "a0_025"), Val("ccc"))
    assert_eq(next_release_name([String]{"a0_005", "a0_025", "v1", "a0_02x"}), "a0_026")
    assert_eq(next_release_name([String]{}), "a0_001")
    assert_eq(next_release_name([String]{"a0_099"}), "a0_100")
}

kit_row: fn(id: String, tier: String, status: String) -> SuiteRow Never! {
    suite_row(object([String: Dyn]{"suite": Dyn.Text("ui"), "case": Dyn.Text(id.copy()), "tier": Dyn.Text(tier.copy()), "status": Dyn.Text(status.copy()), "detail": Dyn.Text("")}))
}

lost_ids: fn(compared: Compared) -> [String] Never! {
    out := [String]{}
    loop found in compared.lost -> out.push("{found.id} {found.now}")
    out
}

row_ids: fn(rows: [SuiteRow]) -> [String] Never! {
    out := [String]{}
    loop found in rows -> out.push(found.id.copy())
    out
}

#Test("the C toolchain pack hash the release checks is the one jet embeds") {
    rows: cc_pack_assets(files.read(files.join(repo_root(), CC_PACK_SOURCE)) ?? panic("read {CC_PACK_SOURCE}: {err}"))
    host := CcPack?{None}
    loop found in rows {
        if found.platform == "linux-x64" -> host = Val(found.copy())
    }
    pack: host ?? panic("CC_PACK_ASSETS embeds no linux-x64 pack")
    assert(pack.file.starts_with("jet-cc-pack-") && pack.file.ends_with(".tar.zst"))
    assert(is_hex(pack.sha256, 64))
    assert(pack.size > 0)
    assert_eq(cc_pack_problem(pack, pack.sha256, pack.size), "")
    problem_text: cc_pack_problem(pack, "0".repeat(64), pack.size)
    assert(problem_text.contains("jet embeds {pack.sha256}"))
    assert(problem_text.contains("update CC_PACK_ASSETS"))
}

#Test("the release ships jet-cc, jet-cxx and jet-c++ as hard links of jet") {
    dir: files.mkdtemp("jet-release-aliases-") ?? panic("scratch: {err}")
    put(files.join(dir, "jet"), "binary")
    link_compiler_aliases(dir) ?? panic("link: {err}")
    assert_eq(COMPILER_ALIASES, [String]{"jet-cc", "jet-cxx", "jet-c++"})
    jet: files.stat(files.join(dir, "jet")) ?? panic("stat jet: {err}")
    loop alias in COMPILER_ALIASES {
        linked: files.stat(files.join(dir, alias)) ?? panic("stat {alias}: {err}")
        assert_eq(linked.id.inode, jet.id.inode)
    }
    assert_eq(jet.links, 4)
    files.remove_all(dir) ?? ()
}

#Test("a commit exports with its modes and links, leaves the worktree and index alone, and a bad commit is named") {
    dir: files.mkdtemp("jet-release-export-") ?? panic("scratch: {err}")
    repo: files.join(dir, "repo")
    put(files.join(repo, "sub/a.txt"), "one\n")
    put(files.join(repo, "run"), "#!/bin/sh\n")
    files.set_mode(files.join(repo, "run"), 493) ?? panic("chmod: {err}")
    files.symlink("sub/a.txt", files.join(repo, "link")) ?? panic("symlink: {err}")
    git_args := [String]{"-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null"}
    assert_eq(git_in(repo, [String]{"init", "--quiet"}).rc, 0)
    assert_eq(git_in(repo, [String]{"add", "--all"}).rc, 0)
    git_args.extend([String]{"commit", "--quiet", "-m", "fixture"})
    committed: git_in(repo, git_args)
    assert_eq(committed.rc, 0)
    sha: git_in(repo, [String]{"rev-parse", "HEAD"}).out
    put(files.join(repo, "sub/a.txt"), "edited\n")
    out: files.join(dir, "out")
    put(files.join(out, "stale.txt"), "left over\n")
    assert_eq(export_commit(repo, sha, out), None)
    assert_eq(files.read(files.join(out, "sub/a.txt")) ?? panic("read: {err}"), "one\n")
    assert(!files.exists(files.join(out, "stale.txt")))
    assert(!files.exists("{out}.index"))
    run: files.stat(files.join(out, "run")) ?? panic("stat run: {err}")
    text: files.stat(files.join(out, "sub/a.txt")) ?? panic("stat a.txt: {err}")
    assert_eq((run.mode /% 64) % 2, 1)
    assert_eq((text.mode /% 64) % 2, 0)
    assert_eq(files.read_link(files.join(out, "link")) ?? panic("readlink: {err}"), "sub/a.txt")
    assert_eq(git_in(repo, [String]{"status", "--porcelain"}).out, "M sub/a.txt")
    zeros: "0".repeat(40)
    bad: export_commit(repo, zeros, files.join(dir, "bad")) ?? panic("a missing commit exported")
    assert(bad.starts_with("git read-tree failed: "))
    assert(bad.ends_with(" ({zeros})"))
    files.remove_all(dir) ?? ()
}

#Test("a logged run copies its output and errors into the log, appends when asked, times out, and a batch keeps job order") {
    dir: files.mkdtemp("jet-release-logged-") ?? panic("scratch: {err}")
    log: files.join(dir, "run.log")
    put(log, "stale\n")
    version: run_logged([String]{"git", "--version"}, dir, [Var]{}, log, 60)
    assert_eq("{version.rc} {version.timed_out}", "0 false")
    first: files.read(log) ?? panic("read: {err}")
    assert(first.starts_with("git version "))
    probe: [Var]{set_var("GIT_CONFIG_COUNT", "1"), set_var("GIT_CONFIG_KEY_0", "release.probe"), set_var("GIT_CONFIG_VALUE_0", "seen")}
    assert_eq(run_logged([String]{"git", "config", "--get", "release.probe"}, dir, probe, log, 0, append: true).rc, 0)
    missing: run_logged([String]{"jet-release-no-such-tool"}, dir, [Var]{}, log, 0, append: true)
    assert_eq(missing.rc, 127)
    after: files.read(log) ?? panic("read: {err}")
    assert(after.starts_with("{first}seen\n"))
    assert(after.contains("jet-release-no-such-tool"))
    slow: run_logged([String]{"sleep", "30"}, dir, [Var]{}, files.join(dir, "slow.log"), 1)
    assert_eq("{slow.rc} {slow.timed_out}", "124 true")
    jobs: [Job]{
        Job{argv: [String]{"git", "rev-parse", "--verify", "no-such-ref"}, cwd: dir.copy(), vars: [Var]{}, log: files.join(dir, "a.log"), seconds: 60},
        Job{argv: [String]{"git", "--version"}, cwd: dir.copy(), vars: [Var]{}, log: files.join(dir, "b.log"), seconds: 60},
    }
    results: run_batch(jobs)
    assert_eq("{results[0].rc} {results[1].rc}", "128 0")
    assert((files.read(files.join(dir, "a.log")) ?? "").contains("fatal: "))
    assert((files.read(files.join(dir, "b.log")) ?? "").starts_with("git version "))
    files.remove_all(dir) ?? ()
}

#Test("admit options collect every problem at once") {
    assert_eq(parse_admit_args([String]{"--shards", "x", "--bogus"}).errors, [String]{"--shards needs a whole number, not x", "unknown option --bogus", "COMMIT is required"})
    assert_eq(parse_admit_args([String]{"abc", "--min-gains", "0"}).min_gains, 0)
    gate: parse_admit_args([String]{"abc", "--check-gate"})
    assert(gate.check_gate)
    assert_eq(gate.errors.len(), 0)
    assert_eq(parse_admit_args([String]{"a", "b", "--summary"}).errors, [String]{"one commit, not a and b", "--summary needs a value"})
}

#Test("the shards of the sides at once split the slot memory cap and the threads instead of each claiming the whole room") {
    plain: parse_admit_args([String]{"abc"})
    assert_eq(shard_pool(plain, 4, 1, "16G", ""), [String]{"--memory=4G"})
    assert_eq(shard_pool(plain, 4, 1, "", ""), [String]{"--memory=4G"})
    assert_eq(shard_pool(plain, 1, 1, "24G", ""), [String]{"--memory=24G"})
    assert_eq(shard_pool(plain, 16, 1, "8G", ""), [String]{"--memory=1G"})
    assert_eq(shard_pool(plain, 4, 2, "24G", "8-31"), [String]{"--memory=3G", "--jobs=3"})
    assert_eq(shard_pool(plain, 4, 1, "16G", "4-9,20-25"), [String]{"--memory=4G", "--jobs=3"})
    assert_eq(shard_pool(plain, 16, 2, "16G", "4-9"), [String]{"--memory=1G", "--jobs=1"})
    three: parse_admit_args([String]{"abc", "--jobs", "3"})
    assert_eq(shard_pool(three, 4, 1, "64G", "8-31"), [String]{"--memory=16G", "--jobs=3"})
    assert_eq(shard_pool(three, 4, 2, "64G", ""), [String]{"--memory=8G", "--jobs=1"})
}

#Test("a CPU list counts its CPUs") {
    assert_eq(cpu_count("8-31"), 24)
    assert_eq(cpu_count("4-9,20-25"), 12)
    assert_eq(cpu_count("3"), 1)
    assert_eq(cpu_count(""), 0)
    assert_eq(cpu_count("9-4"), 0)
}

#Test("a suite's runner reads the candidate's tree and its rows read their side's tree") {
    vars: suite_vars([Var]{set_var("TMPDIR", "/tmp/x")}, "/work/tree", "/work/release-tree", "jet@0.0.1#aa", "/release/jet")
    assert_eq((loop found in vars -> "{found.name}={found.value}"), [String]{"TMPDIR=/tmp/x", "JET_COMPILER_IDENTITY=jet@0.0.1#aa", "JET_TOOLCHAIN_ROOT=/work/tree", "JET_TEST_TOOLCHAIN_ROOT=/work/release-tree", "JET=/release/jet"})
}

#Test("a lost row is one the release passes and the candidate fails on both runs") {
    before: [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "FAIL"), kit_row("d.jet", "o1", "UNEXPECTED-PASS")}
    after: [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "FAIL"), kit_row("c.jet", "o0", "PASS"), kit_row("e.jet", "o0", "PASS")}
    result: compare_suites(before, after, [SuiteRow]{}, [Disposition]{})
    assert_eq(result.rows, 4)
    assert_eq(lost_ids(result), [String]{"b.jet FAIL", "d.jet MISSING"})
    assert_eq(result.gained.len(), 1)
    assert_eq("{result.gained[0].id} {result.gained[0].was}", "c.jet FAIL")
    assert_eq(row_ids(result.added), [String]{"e.jet"})
    retried: compare_suites(before, after, [SuiteRow]{kit_row("b.jet", "o0", "PASS")}, [Disposition]{})
    assert_eq(lost_ids(retried), [String]{"d.jet MISSING"})
    assert_eq(row_ids(retried.flaky), [String]{"b.jet"})
}

#Test("an untracked row is a failure no known-failing line accounts for, a refusal no ledger line owns included") {
    before: [SuiteRow]{kit_row("a.jet", "o0", "FAIL"), kit_row("b.jet", "o0", "KNOWN-FAILING")}
    after: [SuiteRow]{kit_row("a.jet", "o0", "FAIL"), kit_row("b.jet", "o0", "KNOWN-FAILING"), kit_row("c.jet", "o0", "ERROR"), kit_row("d.jet", "o0", "REFUSED"), kit_row("e.jet", "o0", "TIMEOUT"), kit_row("f.jet", "o0", "SKIP-HOST"), kit_row("g.jet", "o0", "OPT-IN")}
    result: compare_suites(before, after, [SuiteRow]{}, [Disposition]{})
    assert_eq(row_ids(result.untracked), [String]{"a.jet", "c.jet", "d.jet", "e.jet"})
    assert_eq(result.release_untracked, 1)
}

#Test("a kit with one untracked failing row is refused and one with none is admitted, whatever the release had") {
    release: [SuiteRow]{kit_row("a.jet", "o0", "FAIL"), kit_row("b.jet", "o0", "FAIL"), kit_row("c.jet", "o0", "PASS")}
    one: untracked_row("ui", compare_suites(release, [SuiteRow]{kit_row("a.jet", "o0", "FAIL"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "PASS")}, [SuiteRow]{}, [Disposition]{}))
    assert_eq("{one.check} {one.status}", "untracked:ui FAIL")
    assert_eq(one.detail, "1 failing row(s) with no known-failing line (release 2); full list in REPORT.md")
    none: untracked_row("ui", compare_suites(release, [SuiteRow]{kit_row("a.jet", "o0", "KNOWN-FAILING"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "PASS")}, [SuiteRow]{}, [Disposition]{}))
    assert_eq("{none.check} {none.status}", "untracked:ui PASS")
    refused: untracked_row("ui", compare_suites(release, [SuiteRow]{kit_row("a.jet", "o0", "REFUSED"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "PASS")}, [SuiteRow]{}, [Disposition]{}))
    assert_eq(refused.status, "FAIL")
}

#Test("a row the candidate passes on its retry is flaky, not untracked") {
    before: [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "FAIL")}
    after: [SuiteRow]{kit_row("a.jet", "o0", "TIMEOUT"), kit_row("b.jet", "o0", "TIMEOUT"), kit_row("c.jet", "o0", "TIMEOUT")}
    result: compare_suites(before, after, [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "TIMEOUT")}, [Disposition]{})
    assert_eq(row_ids(result.flaky), [String]{"a.jet"})
    assert_eq(row_ids(result.untracked), [String]{"b.jet", "c.jet"})
}

#Test("an untracked timeout the candidate passes on its retry is flaky whatever the release did; a retried failure stays untracked") {
    before: [SuiteRow]{kit_row("a.jet", "o0", "TIMEOUT"), kit_row("b.jet", "o0", "FAIL"), kit_row("c.jet", "o0", "TIMEOUT"), kit_row("d.jet", "o0", "TIMEOUT")}
    after: [SuiteRow]{kit_row("a.jet", "o0", "TIMEOUT"), kit_row("b.jet", "o0", "TIMEOUT"), kit_row("c.jet", "o0", "FAIL"), kit_row("d.jet", "o0", "TIMEOUT")}
    retry: [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "PASS"), kit_row("c.jet", "o0", "PASS"), kit_row("d.jet", "o0", "TIMEOUT")}
    result: compare_suites(before, after, retry, [Disposition]{})
    assert_eq(row_ids(result.flaky), [String]{"a.jet", "b.jet"})
    assert_eq(row_ids(result.untracked), [String]{"c.jet", "d.jet"})
}

#Test("a reused run reruns every row a changed file reaches, and only those") {
    rows: [SuiteRow]{kit_row("tests/cases/a/x.case", "-", "PASS"), kit_row("tests/cases/a/y.case", "-", "PASS"), kit_row("tests/cases/b/z.case", "-", "FAIL")}
    assert_eq(rerun_ids(rows, [String]{"tests/cases/a/fixtures/clock/main.jet"}), [String]{"tests/cases/a/x.case", "tests/cases/a/y.case"})
    assert_eq(rerun_ids(rows, [String]{"tests/cases/b/z.case"}), [String]{"tests/cases/b/z.case"})
    assert_eq(rerun_ids(rows, [String]{"tests/fixtures/shared.jet"}).len(), 0)
    merged: merged_rows(rows, [SuiteRow]{kit_row("tests/cases/b/z.case", "-", "PASS")}, [String]{"tests/cases/b/z.case"})
    assert_eq(row_ids(merged), [String]{"tests/cases/a/x.case", "tests/cases/a/y.case", "tests/cases/b/z.case"})
    assert_eq(merged[2].status, "PASS")
}

#Test("a dispositioned lost row is tracked by its card, not untracked") {
    before: [SuiteRow]{kit_row("a.jet", "o0", "PASS"), kit_row("b.jet", "o0", "PASS")}
    after: [SuiteRow]{kit_row("a.jet", "o0", "FAIL"), kit_row("b.jet", "o0", "FAIL")}
    dispositions: [Disposition]{Disposition{suite: "ui", id: "a.jet", tier: "*", card: "#6001", reason: "cutover"}}
    assert_eq(row_ids(compare_suites(before, after, [SuiteRow]{}, dispositions).untracked), [String]{"b.jet"})
}

#Test("a disposition names a card and matches a tier or every tier") {
    parsed: parse_dispositions("# comment\nui\tb.jet\t*\t#6001\tthe fixture tests a removed form\ncases\tx\to0\t6002\tno hash\n")
    assert_eq(parsed.rows.len(), 1)
    assert_eq(parsed.errors.len(), 1)
    assert(parsed.errors[0].starts_with("dispositions line 3: "))
    result: compare_suites([SuiteRow]{kit_row("b.jet", "o2", "PASS")}, [SuiteRow]{kit_row("b.jet", "o2", "FAIL")}, [SuiteRow]{}, parsed.rows)
    assert_eq(result.lost[0].disposition.card, "#6001")
}

#Test("Jetpack census keys drop line numbers and stop at the per-file summary") {
    text: "Jetpack/A.jet:10:2: error[E1]: bad\nJetpack/A.jet:99:1: error[E1]: bad\nJetpack/B.jet:3:4: error[E2]: worse\nerrors per file:\nJetpack/C.jet:1:1: x: y\n"
    assert_eq(jetpack_keys(text), [String]{"Jetpack/A.jet\terror[E1]", "Jetpack/B.jet\terror[E2]"})
    assert_eq(jetpack_keys("total errors: 0\n").len(), 0)
}

#Test("chain RESULT rows and merge-tree conflicts parse") {
    rows: parse_chain_result("stage\tstatus\trc\tnote\ns2\tBUILT\t0\tstored\nverdict\tFIXED_POINT\t0\tlevel=full\n")
    verdict: chain_row(rows, "verdict") ?? panic("no verdict row")
    assert_eq(verdict.status, "FIXED_POINT")
    assert_eq(verdict.note, "level=full")
    assert_eq(merge_tree_conflicts("9dca0ae\nDocs/a.md\n\nAuto-merging Docs/a.md\nCONFLICT (add/add): Docs/a.md\n"), [String]{"Docs/a.md"})
}

#Test("build takes its own options and collects every problem at once") {
    built: parse_build_args([String]{"abc123", "--seed", "seed", "--out", "out", "--threads", "4"})
    assert_eq("{built.commit} {built.seed} {built.out} {built.threads}", "abc123 seed out 4")
    assert_eq(built.errors.len(), 0)
    assert_eq(parse_build_args([String]{"abc123"}).errors, [String]{"--seed is required", "--out is required"})
    assert_eq(parse_build_args([String]{"a", "b", "--seed", "s", "--out", "o"}).errors, [String]{"one commit, not a and b"})
    assert_eq(parse_build_args([String]{"a", "--seed", "s", "--out", "o", "--threads", "0"}).errors, [String]{"--threads needs a positive whole number, not 0"})
    assert_eq(parse_build_args([String]{"a", "--seed", "s", "--out", "o", "--dry-run"}).errors, [String]{"unknown option --dry-run"})
    gate: parse_build_args([String]{"a", "--seed", "s", "--check-gate"})
    assert(gate.check_gate)
    assert_eq(gate.errors.len(), 0)
}
