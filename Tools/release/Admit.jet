// `admit COMMIT`: the release gate of the a0.0.N compiler train.
//
//   jet run Tools/release/Main.jet -- admit COMMIT [--summary TEXT] [--dispositions FILE] [--min-gains N]
//        [--shards N] [--jobs N] [--timeout SEC] [--filter SUBSTR] [--reuse ROWS] [--seeds DIR] [--work DIR] [--check-gate]
//   jet run Tools/release/Main.jet -- rows COMMIT --source IDENTITY --compiler IDENTITY --out FILE RESULTS...
//
// COMMIT is a commit on dev whose JET_VERSION (Jetpack/PackageModel Manifest.jet)
// is the next release, a0.0.N. The current release is `SEEDS/current` (default
// $JET_SEEDS, Tools/agent/roots.sh); it is the chain's seed. The release column, the
// compiler the suites and the Jetpack census compare against, is the current release when
// its jet is the one it was released as (SHA256SUMS lists its sha256, and RELEASE.json records
// its IDENTITY and the commit SOURCE names), else SEEDS/<its RELEASE.json name>, which must be;
// with neither the run does not start. That column's rows read an export of its SOURCE commit.
// The run starts only with COMMIT's
// collect-all preflight receipt for the current release (`Tools/agent/Land.jet
// receipt`, written by `Land.jet census`); --check-gate says whether it would
// start, names both seeds, and stops. Before any check, the release column's preflight
// (`preflight:release`): its jet must check and run a one-line program against the Core of its
// exported tree; when it can't, the run is refused with exit 2 and a REPORT.md naming that
// compiler, so no column that can't read its Core is compared. The gate then runs every check
// and reports all of them; it does not stop at the first failure:
//   chain     Tools/agent/Chain.jet builds s1, s2 and s3 of COMMIT from the current release, every stage
//             without Rust on PATH, and must reach the fixed point (s2 == s3).
//   preflight:candidate  s2 checks and runs the same program against COMMIT's Core; when it
//             can't, no suite launches.
//   pack      the runtime pack, rebuilt by s2 without Rust (`jet build Compiler`), must
//             equal the chain's pack2 byte for byte.
//   cc-pack   Tools/agent/cc-pack.nix builds this host's C toolchain pack from pinned sources
//             (the only place Nix runs); its SHA-256 and size must equal CC_PACK_ASSETS in
//             Jetpack/Provider/Source/Toolchain/CcToolchainPack.jet, the hash jet embeds.
//   bwrap     Tools/agent/bwrap.nix builds the sandbox's pinned bubblewrap from the same pin;
//             its SHA-256 and size must equal NATIVE_SANDBOX_BWRAP_ASSETS in
//             Jetpack/Foundation/Source/NativeSandbox.jet, the hash jet embeds.
//   jetpack   Jetpack/Bootstrap/Check.jet (keep-going) with s2 on COMMIT must show no failure
//             row the release column showed (recorded when it was cut, else rerun on its own
//             tree), and must finish if the release's census did; `Check.jet --hosted` builds
//             the jetpack engine that ships beside jet.
//   suites    every native suite of COMMIT's Tools/ci/TestShards.jet (SUITES, the one list a
//             full run covers). The registries suite: Tools/agent/CompilerRegistries.jet pins
//             COMMIT's registry manifest and runs every entry with s2, and every entry must
//             pass, as in a full run (Tools/agent/VerifyFull.jet). Every other suite is a test profile
//             (golden, ui, cases) that each side runs in one kit pool,
//             `jet test Compiler --profile corpora`, run by s2 with `--compiler` naming s2,
//             then the release column's jet, on COMMIT's fixtures, compared per (suite, case,
//             tier). Every candidate row runs. The release column runs the rows that can
//             differ from s2's (release_picks): those s2 fails, those a known-failing line
//             owns (s2's or the release's ledger), and those whose files changed since the
//             release's commit; any other row passes on s2 with the files and ledger the
//             release had, and counts as passing on the release. A release row an earlier
//             run of this gate ran against the same release column carries over to this
//             run (release_cache) unless a change since that run's commit reaches it
//             (carried_stale). A row the release passes
//             and s2 fails twice is lost; a lost row needs a
//             disposition line `suite<TAB>case<TAB>tier|*<TAB>#card<TAB>reason` in
//             --dispositions. No failing row may be untracked: each one needs a known-failing
//             line, a host skip, an opt-in, or a disposition (a lost row, or a row that fails
//             with the same status on both columns); a REFUSED row no ledger line owns counts
//             as untracked. A row s2 fails and then passes on its retry is flaky: REPORT.md
//             lists it with both outcomes, and it fails the gate (`flaky:SUITE`) unless a
//             disposition names its owning card. A disposition that tracks no row is a WARN row.
//   speed     the train speed gate (#5479 c5): Tools/perf/compile-throughput/Throughput.jet
//             --against the chain's seed, s2 and the seed each compiling COMMIT's compiler
//             corpus 3 rounds at the default level under `perf stat` (the dev shell's
//             pkgs.perf). A rise over 10% in CPU, instructions:u or a top-level phase's process
//             CPU fails, and so does an INCONCLUSIVE verdict.
//   throughput  s2 compiles the corpus once at check, O0 and release (#5479 c1); a
//             compile that fails fails the row. Every compile of both is a row of
//             evidence/throughput.tsv, the throughput ledger each release ships.
//   gains     rows s2 passes that the release fails, plus Jetpack rows s2 no longer shows;
//             at least --min-gains (default 10) of them.
// The candidate's kit suite rows need the jetpack engine that serves them, so they start once
// the chain, cc-pack and jetpack-engine checks pass, and run beside pack and jetpack; a
// check that fails then waits for them to end and blocks the suites. The release column's
// rows follow, picked from the candidate's, then the registries suite, then speed and
// throughput, each with the slot to itself. A --reuse run takes only kit rows; the
// registries suite, speed and throughput run in full on every unfiltered run.
//
// Pass: assembles SEEDS/a0.0.N (the next number) with jet (its Core sources built in),
// jet-runtime/, jetpack, IDENTITY (`jet@a0.0.N#<digest>`, Release.jet identity_digest), RELEASE, VERSION
// (`a0.0.N COMMIT <date>`, which `jet --version` prints), the C toolchain pack, the pinned
// bubblewrap (`jet-bwrap-<arch>-linux`),
// SOURCE, SHA256SUMS, RELEASE.json, RELEASE.md, MERGE_MSG, TAG_MSG and evidence/, then
// publishes it, each step only after the one before succeeds: COMMIT must be on
// origin/dev; `git tag -a a0.0.N -F TAG_MSG COMMIT`; `git push origin a0.0.N`; then the
// new jet runs `jet run Tools/release/Main.jet -- candidate SEEDS/a0.0.N` and `-- publish
// SEEDS/a0.0.N` from this
// checkout, signing with the jet-release key (`jet registry keygen --registry jet-release`
// writes it to $JET_KEYS_DIR, default ~/.jet/keys; the run does not start without it). Only
// then does it write SEEDS/a0.0.N/current.env and print PASS with the commands left for
// Main: make it current (jet-use) and merge it to master as `Merge dev: a0.0.N <summary>`.
// Fail: no current.env and no PASS. A failed check, or a publication step that fails before
// the tag reaches origin, leaves no SEEDS/a0.0.N (the assembled directory moves to
// SEEDS/.a0.0.N.unpublished-PID and the local tag is deleted); once the tag is on origin,
// SEEDS/a0.0.N stays without current.env and the gate prints the steps left. The evidence
// stays in the work directory. The gate never repoints `current`, merges or pushes master.
// One release run at a time (a lock in the work root); the run takes the release slot of
// Tools/agent/Chain.jet (`slot --release`: CPUs 8-31, no other slot job meanwhile), and
// every suite process runs inside that slot's memory cap. Each side's rows run in --shards
// (default 8) `jet test` processes at once, one side at a time; each gets `--memory` (the
// slot's SLOT_MEMORY_MAX, 16G when unset, split across them), because a pool left to size
// itself reads the host's MemAvailable and every process would claim all of it, and
// `--jobs` (the slot's threads, SLOT_CPUS, split the same way); --jobs N caps each pool at
// N entries at once.
// --filter narrows the suites for dry runs of the gate itself: such a run is never a
// release (RELEASE.json scope `filtered`, which jet-use refuses) and is never tagged or
// published.
// --reuse ROWS takes the candidate's suite rows from a row file (ROWS_SCHEMA): an earlier
// run's evidence/rows-candidate.json, a directory that holds one there, or a train's rows
// (`rows`), instead of running every candidate row again. It applies only when the rows
// name the compiler source identity of COMMIT (`Tools/agent/CompilerPackages.jet identity`
// of its export, the identity a train's census receipt records) and an ancestor of COMMIT
// whose diff to COMMIT modifies files only under tests/ or Examples/ (or under paths no
// suite reads: Docs/, .agents/, AGENTS.md, Tools/release/). Each changed file must sit at
// or under a directory that holds a row. Every such row runs again on the candidate, as
// does every untracked failure among the rows (the one failure a reuse verifies instead
// of rerunning everything); the release column follows as in a full run. Otherwise the
// gate stops, and nothing is reused. ROWS must not lie in COMMIT's own work directory,
// which the gate clears first.
// `rows` writes the row file of a corpora run by another compiler than s2 (a train's,
// built from the source IDENTITY its census receipt records, whose binary identity is
// --compiler): RESULTS are the `jet test --results` files of that run on COMMIT's export.
//
// Environment: the roots of Tools/agent/roots.sh, JET_RELEASE_WORK (default
// $JET_STATE_ROOT/release), JET_RELEASE_SLOT (empty runs without a build slot),
// JET_KEYS_DIR (where the jet-release signing key lives).
// Exit: 0 released and published, 1 a check or a publication step failed (not admitted),
// 2 the run could not start.

use {
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
    jetpack_publication.[publication_key_paths]
}

// The native suites a full run covers have one home, SUITES of
// NATIVE_SUITES_SOURCE; the gate reads COMMIT's (native_suites).
// REGISTRY_SUITE runs through Tools/agent/CompilerRegistries.jet
// (registries_stage); every other is a Compiler test profile whose rows the
// CORPORA_PROFILE kit pool runs, which `Tools/ci/TestShards.jet --check`
// holds.
NATIVE_SUITES_SOURCE: "Tools/ci/TestShards.jet"
NATIVE_SUITES_DECL: "SUITES: [String]{{"
REGISTRY_SUITE: "registries"
ADMIT_USAGE: "usage: jet run Tools/release/Main.jet -- admit COMMIT [--summary TEXT] [--dispositions FILE] [--min-gains N] [--shards N] [--jobs N] [--timeout SEC] [--filter SUBSTR] [--reuse ROWS] [--seeds DIR] [--work DIR] [--check-gate]\n       jet run Tools/release/Main.jet -- rows COMMIT --source IDENTITY --compiler IDENTITY --out FILE RESULTS..."
// The jet sources that embed each pinned release asset (file, SHA-256, size):
// the C toolchain pack of each host in CC_PACK_ASSETS, the sandbox's
// bubblewrap of each Linux architecture in NATIVE_SANDBOX_BWRAP_ASSETS.
CC_PACK_SOURCE: "Jetpack/Provider/Source/Toolchain/CcToolchainPack.jet"
CC_PACK_TABLE: "CC_PACK_ASSETS"
BWRAP_SOURCE: "Jetpack/Foundation/Source/NativeSandbox.jet"
BWRAP_TABLE: "NATIVE_SANDBOX_BWRAP_ASSETS"
// Testkit statuses a failing row may carry and still be tracked: a
// known-failing line, a host skip or an opt-in row. The testkit turns a
// refusal a known-failing line owns into KNOWN-FAILING, so a REFUSED row that
// remains has no owning line and is untracked.
TRACKED_FAILURES: [String]{"KNOWN-FAILING", "SKIP-HOST", "OPT-IN"}

AdmitOptions: struct {
    commit: String
    summary: String
    dispositions: String
    min_gains: Int
    shards: Int
    jobs: Int
    timeout: Int
    filter: String
    reuse: String
    seeds: String
    work: String
    check_gate: Bool
    errors: [String]
}

is_count: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        code: Int{byte}
        if code < 48 || code > 57 -> return false
    }
    true
}

// The options of `admit`; every problem is collected at once.
parse_admit_args: fn(args: [String]) -> AdmitOptions Never! {
    options := AdmitOptions{commit: "", summary: "", dispositions: "", min_gains: 10, shards: 8, jobs: 0, timeout: 0, filter: "", reuse: "", seeds: "", work: "", check_gate: false, errors: [String]{}}
    values: [String]{"--summary", "--dispositions", "--filter", "--reuse", "--seeds", "--work"}
    counts: [String]{"--min-gains", "--shards", "--jobs", "--timeout"}
    index := 0
    loop index < args.len() {
        flag: args[index]
        if values.contains(flag) || counts.contains(flag) {
            index += 1
            if index >= args.len() {
                options.errors.push("{flag} needs a value")
                next
            }
            value: args[index]
            if {
                flag == "--summary" -> options.summary = value.copy()
                flag == "--dispositions" -> options.dispositions = value.copy()
                flag == "--filter" -> options.filter = value.copy()
                flag == "--reuse" -> options.reuse = value.copy()
                flag == "--seeds" -> options.seeds = value.copy()
                flag == "--work" -> options.work = value.copy()
                !is_count(value) -> options.errors.push("{flag} needs a whole number, not {value}")
                else -> {
                    number: Int.parse(value) ?? 0
                    if {
                        flag == "--min-gains" -> options.min_gains = number
                        flag == "--shards" -> options.shards = number
                        flag == "--jobs" -> options.jobs = number
                        else -> options.timeout = number
                    }
                }
            }
        } else if flag == "--check-gate" {
            options.check_gate = true
        } else if flag.starts_with("-") {
            options.errors.push("unknown option {flag}")
        } else if options.commit != "" {
            options.errors.push("one commit, not {options.commit} and {flag}")
        } else {
            options.commit = flag.copy()
        }
        index += 1
    }
    if options.commit == "" -> options.errors.push("COMMIT is required")
    if options.shards < 1 -> options.errors.push("--shards must be at least 1")
    if options.reuse != "" && options.filter != "" -> options.errors.push("--reuse and --filter do not combine: a reused run is a release")
    // The summary goes into the tag and the master merge, which carry no machine paths.
    if options.summary.starts_with("/") || options.summary.starts_with("~") -> options.errors.push("--summary is the text of the release, not a path: {options.summary}")
    options
}

// How many CPUs a CPU list (`8-31`, `4-9,20-25`) names; 0 for an empty or
// malformed one.
cpu_count: fn(list: String) -> Int Never! {
    total := 0
    loop part in list.split(",") {
        span: part.trim().partition("-")
        low: Int.parse(span.head) ?? return 0
        high: if span.tail == "" -> low else -> Int.parse(span.tail) ?? return 0
        if high < low -> return 0
        total += high - low + 1
    }
    total
}

// The pool settings of each of `processes` `jet test` runs sharing one slot
// at once: the slot's memory cap (`slot_memory`, 16G when unset) split across
// all of them, since each pool alone would size its budget from the whole
// cgroup room, and the slot's threads (`slot_cpus`) split the same way, at
// least 1 each, or a given --jobs N.
shard_pool: fn(options: AdmitOptions, processes: Int, slot_memory: String, slot_cpus: String) -> [String] Never! {
    digits := ""
    loop byte in slot_memory.bytes() {
        code: Int{byte}
        if code < 48 || code > 57 -> break
        digits = "{digits}{code - 48}"
    }
    parsed: Int.parse(digits) ?? 0
    gib: if parsed > 0 -> parsed else -> 16
    share: gib /% processes
    pool := [String]{"--memory={if share < 1 -> 1 else -> share}G"}
    threads: cpu_count(slot_cpus)
    jobs: if options.jobs > 0 -> options.jobs else -> threads /% processes
    if options.jobs > 0 || threads > 0 -> pool.push("--jobs={if jobs < 1 -> 1 else -> jobs}")
    pool
}

// --- pure helpers -----------------------------------------------------------

Disposition: struct {
    suite: String
    id: String
    tier: String
    card: String
    reason: String
}

Dispositions: struct {
    rows: [Disposition]
    errors: [String]
}

is_card: fn(text: String) -> Bool Never! {
    text.starts_with("#") && is_count(text.slice(1..<text.len()))
}

// Disposition lines: suite TAB case TAB tier|* TAB #card TAB reason, the
// suite one of `suites`. A line starting with `#` is a comment.
parse_dispositions: fn(text: String, suites: [String]) -> Dispositions Never! {
    out := Dispositions{rows: [Disposition]{}, errors: [String]{}}
    lines: text.split("\n").to_list()
    loop (index, line) in lines {
        if line.trim() == "" || line.starts_with("#") -> next
        cells: line.split("\t").to_list()
        why: if cells.len() > 4 -> cells[4..<cells.len()].join("\t").trim().copy() else -> ""
        if cells.len() < 5 || !suites.contains(cells[0]) || cells[1] == "" || cells[2] == "" || !is_card(cells[3]) || why == "" {
            shown: json.dumps(Dyn.Text(line.copy())) ?? line.copy()
            out.errors.push("dispositions line {index + 1}: want suite<TAB>case<TAB>tier|*<TAB>#card<TAB>reason, got {shown}")
            next
        }
        out.rows.push(Disposition{suite: cells[0].copy(), id: cells[1].copy(), tier: cells[2].copy(), card: cells[3].copy(), reason: why})
    }
    out
}

// The suites of NATIVE_SUITES_SOURCE's text: its one-line SUITES
// declaration, each quoted name in order; none when it has no such line or
// a name is not a plain quoted one.
native_suites_of: fn(text: String) -> [String] Never! {
    loop line in text.split("\n").to_list() {
        decl: line.trim()
        if !line.starts_with(NATIVE_SUITES_DECL) || !decl.ends_with("}}") -> next
        out := [String]{}
        loop part in decl.slice(NATIVE_SUITES_DECL.len()..<decl.len() - 1).split(",").to_list() {
            quoted: part.trim()
            if quoted.len() < 3 || !quoted.starts_with("\"") || !quoted.ends_with("\"") -> return [String]{}
            name: quoted.slice(1..<quoted.len() - 1)
            if name.contains("\"") || name.contains(" ") -> return [String]{}
            out.push(name.copy())
        }
        return out
    }
    [String]{}
}

// COMMIT `sha`'s native suites (native_suites_of its NATIVE_SUITES_SOURCE in
// `repo`), or why there are none.
native_suites: fn(repo: String, sha: String) -[Exec, Time.Wait]> (suites: [String], error: String) Never! {
    shown: git_in(repo, [String]{"show", "{sha}:{NATIVE_SUITES_SOURCE}"})
    if shown.rc != 0 -> return (suites: [String]{}, error: "git show {short(sha, 10)}:{NATIVE_SUITES_SOURCE} failed: {shown.err}")
    suites: native_suites_of(shown.out)
    if suites.len() == 0 -> return (suites: suites, error: "{short(sha, 10)}:{NATIVE_SUITES_SOURCE} declares no one-line `{NATIVE_SUITES_DECL}...}}` of quoted suite names")
    (suites: suites, error: "")
}

// The native suites the kit pool runs: every one but REGISTRY_SUITE.
kit_suites: fn(native: [String]) -> [String] Never! {
    out := [String]{}
    loop suite in native {
        if suite != REGISTRY_SUITE -> out.push(suite.copy())
    }
    out
}

same_disposition: fn(left: Disposition, right: Disposition) -> Bool Never! {
    left.suite == right.suite && left.id == right.id && left.tier == right.tier && left.card == right.card
}

// One testkit result row, with the JSON it was read from.
SuiteRow: struct {
    suite: String
    id: String
    tier: String
    status: String
    detail: String
    raw: Dyn
}

suite_row: fn(raw: Dyn) -> SuiteRow Never! {
    SuiteRow{suite: text_field(raw, "suite"), id: text_field(raw, "case"), tier: text_field(raw, "tier"), status: text_field(raw, "status"), detail: text_field(raw, "detail"), raw: raw.copy()}
}

LostRow: struct {
    suite: String
    id: String
    tier: String
    was: String
    now: String
    detail: String
    disposed: Bool
    disposition: Disposition
}

GainedRow: struct {
    id: String
    tier: String
    status: String
    was: String
}

Compared: struct {
    rows: Int
    lost: [LostRow]
    gained: [GainedRow]
    added: [SuiteRow]
    // Rows the candidate failed and then retried: `was` its first outcome,
    // `now` its retry's, `detail` the first run's; `disposed` when a
    // disposition names the card that owns the flake.
    flaky: [LostRow]
    untracked: [SuiteRow]
    // Failing rows a disposition tracks: each fails with the same status on
    // both columns (`was` the release's, `now` the candidate's).
    carded: [LostRow]
    release_untracked: Int
}

passes: fn(status: String) -> Bool Never! { status == "PASS" || status == "UNEXPECTED-PASS" }

// A failing row no known-failing line or release disposition accounts for:
// nothing tracks it.
is_untracked: fn(status: String) -> Bool Never! { !passes(status) && !TRACKED_FAILURES.contains(status) }

// The untracked gate row of one suite: any untracked failing row fails the
// release, however many the current release had (shown for comparison).
untracked_row: fn(suite: String, compared: Compared) -> GateRow Never! {
    count: compared.untracked.len()
    GateRow{check: "untracked:{suite}", status: if count > 0 -> "FAIL" else -> "PASS", detail: "{count} failing row(s) with no known-failing line or disposition (release {compared.release_untracked}; {compared.carded.len()} failing alike on both columns, tracked by a disposition); full list in REPORT.md"}
}

// The flaky gate row of one suite: a row that passed only on its retry fails
// the release unless a disposition names the card that owns it. A retry
// that ends in a tracked failure (a known-failing line, a host skip) is
// owned by that line.
flaky_row: fn(suite: String, compared: Compared) -> GateRow Never! {
    open := [String]{}
    loop found in compared.flaky {
        if passes(found.now) && !found.disposed -> open.push("{found.id} {found.tier} ({found.was} then {found.now})")
    }
    shown: if open.len() > 6 -> "{open[0..<6].join(", ")}, …" else -> open.join(", ")
    if open.len() > 0 -> return GateRow{check: "flaky:{suite}", status: "FAIL", detail: "{open.len()} of {compared.flaky.len()} row(s) passed only on retry with no disposition naming an owning card: {shown}; full list in REPORT.md"}
    GateRow{check: "flaky:{suite}", status: "PASS", detail: "{compared.flaky.len()} row(s) passed only on retry, each owned by a card or a tracked line; full list in REPORT.md"}
}

// A flaky row: the candidate's first outcome and its retry's, with the
// disposition naming it, if any.
flaky_of: fn(first: SuiteRow, retried: SuiteRow, dispositions: [Disposition]) -> LostRow Never! {
    out := LostRow{suite: first.suite.copy(), id: first.id.copy(), tier: first.tier.copy(), was: first.status.copy(), now: retried.status.copy(), detail: first.detail.copy(), disposed: false, disposition: Disposition{suite: "", id: "", tier: "", card: "", reason: ""}}
    if disposition_for(dispositions, first.suite, first.id, first.tier) == .Val(entry) {
        out.disposed = true
        out.disposition = entry
    }
    out
}

row_key: fn(suite: String, id: String, tier: String) -> String Never! { "{suite}\t{id}\t{tier}" }

// The first disposition naming row (suite, id, tier): its tier or `*`.
disposition_for: fn(dispositions: [Disposition], suite: String, id: String, tier: String) -> Disposition? Never! {
    loop entry in dispositions {
        if entry.suite == suite && entry.id == id && (entry.tier == "*" || entry.tier == tier) -> return Val(entry.copy())
    }
    None
}

// Each key's last row, and the keys in first-seen order.
Indexed: struct {
    order: [String]
    at: [String: Int]
}

index_rows: fn(rows: [SuiteRow]) -> Indexed Never! {
    out := Indexed{order: [String]{}, at: [String: Int]{}}
    loop (index, item) in rows {
        key: row_key(item.suite, item.id, item.tier)
        if !out.at.has_key(key) -> out.order.push(key.copy())
        out.at[key.copy()] = index
    }
    out
}

// Per-row comparison of two testkit result lists over the same fixtures.
// `retry` holds the candidate's second run of the rows it lost the first
// time. Lost rows carry their disposition. A failing row the release fails
// with the same status is not lost; a disposition naming it tracks it
// (`carded`), else it is untracked.
compare_suites: fn(before_rows: [SuiteRow], after_rows: [SuiteRow], retry: [SuiteRow], dispositions: [Disposition]) -> Compared Never! {
    out := Compared{rows: 0, lost: [LostRow]{}, gained: [GainedRow]{}, added: [SuiteRow]{}, flaky: [LostRow]{}, untracked: [SuiteRow]{}, carded: [LostRow]{}, release_untracked: 0}
    loop item in before_rows {
        if is_untracked(item.status) -> out.release_untracked += 1
    }
    before: index_rows(before_rows)
    after: index_rows(after_rows)
    again: index_rows(retry)
    loop key in before.order {
        was: before_rows[before.at.get(key) ?? 0]
        out.rows += 1
        found: after.at.get(key)
        now_status: if found == .Val(at) -> after_rows[at].status.copy() else -> "MISSING"
        if !passes(was.status) || passes(now_status) {
            if found == .Val(at) && !passes(was.status) && passes(now_status) -> out.gained.push(GainedRow{id: after_rows[at].id.copy(), tier: after_rows[at].tier.copy(), status: now_status.copy(), was: was.status.copy()})
            next
        }
        if again.at.get(key) == .Val(at) && passes(retry[at].status) {
            // copy: the release's row stands for the candidate's first run, which may be missing.
            first := was.copy()
            first.status = now_status.copy()
            first.detail = if found == .Val(index) -> after_rows[index].detail.copy() else -> ""
            out.flaky.push(flaky_of(first, retry[at], dispositions))
            next
        }
        lost := LostRow{suite: was.suite.copy(), id: was.id.copy(), tier: was.tier.copy(), was: was.status.copy(), now: now_status.copy(), detail: if found == .Val(at) -> after_rows[at].detail.copy() else -> "", disposed: false, disposition: Disposition{suite: "", id: "", tier: "", card: "", reason: ""}}
        if disposition_for(dispositions, was.suite, was.id, was.tier) == .Val(entry) {
            lost.disposed = true
            lost.disposition = entry
        }
        out.lost.push(lost)
    }
    loop key in after.order {
        now: after_rows[after.at.get(key) ?? 0]
        if !before.at.has_key(key) && passes(now.status) -> out.added.push(now.copy())
    }
    // A dispositioned lost row is tracked by its card, and a flaky row (one
    // the release passes and the candidate passes on its retry) is reported
    // as flaky, so neither counts as untracked; flaky_row gates the flaky
    // rows. A row the candidate timed out on is retried whatever the release
    // did: it missed a wall-clock limit under the kit's load. When its retry
    // passes it is flaky; when its retry ends in a tracked status (a
    // known-failing line, a host skip) that line owns it. The report lists
    // it either way.
    tracked := [String: Bool]{}
    loop lost in out.lost {
        if lost.disposed -> tracked[row_key(lost.suite, lost.id, lost.tier)] = true
    }
    loop row in out.flaky -> tracked[row_key(row.suite, row.id, row.tier)] = true
    loop item in after_rows {
        if !is_untracked(item.status) -> next
        key: row_key(item.suite, item.id, item.tier)
        if tracked.has_key(key) -> next
        if item.status == "TIMEOUT" && again.at.get(key) == .Val(at) && !is_untracked(retry[at].status) {
            out.flaky.push(flaky_of(item, retry[at], dispositions))
            tracked[key.copy()] = true
            next
        }
        if before.at.get(key) == .Val(at) && before_rows[at].status == item.status {
            if disposition_for(dispositions, item.suite, item.id, item.tier) == .Val(entry) {
                out.carded.push(LostRow{suite: item.suite.copy(), id: item.id.copy(), tier: item.tier.copy(), was: before_rows[at].status.copy(), now: item.status.copy(), detail: item.detail.copy(), disposed: true, disposition: entry})
                tracked[key.copy()] = true
                next
            }
        }
        out.untracked.push(item.copy())
    }
    out
}

// Jetpack/Bootstrap check-errors.txt rows as census keys: source file TAB
// message, line-insensitive.
jetpack_keys: fn(text: String) -> [String] Never! {
    seen := [String: Bool]{}
    keys := [String]{}
    loop line in text.split("\n").to_list() {
        // The summary starts at `errors per file:`; a clean check prints only
        // `total errors: 0`.
        if line.starts_with("errors per file:") || line.starts_with("total errors:") -> break
        fields: line.split(": ").to_list()
        if fields.len() < 2 -> next
        key: "{fields[0].partition(":").head}\t{fields[1]}"
        if seen.has_key(key) -> next
        seen[key.copy()] = true
        keys.push(key)
    }
    keys.sort_by(fn(left: String, right: String) { left <=> right })
    keys
}

ChainRow: struct {
    stage: String
    status: String
    note: String
}

// Tools/agent/Chain.jet RESULT (TSV with a header) as rows by stage.
parse_chain_result: fn(text: String) -> [ChainRow] Never! {
    lines := [String]{}
    loop line in text.split("\n").to_list() {
        if line != "" -> lines.push(line.copy())
    }
    rows := [ChainRow]{}
    if lines.len() == 0 -> return rows
    head: lines[0].split("\t").to_list()
    loop line in lines[1..<lines.len()] {
        cells: line.split("\t").to_list()
        row := ChainRow{stage: "", status: "", note: ""}
        loop (index, name) in head {
            value: if index < cells.len() -> cells[index].copy() else -> ""
            if {
                name == "stage" -> row.stage = value
                name == "status" -> row.status = value
                name == "note" -> row.note = value
            }
        }
        rows.push(row)
    }
    rows
}

chain_row: fn(rows: [ChainRow], stage: String) -> ChainRow? Never! {
    found := ChainRow?{None}
    loop row in rows {
        if row.stage == stage -> found = Val(row.copy())
    }
    found
}

// Paths `git merge-tree --write-tree --name-only` reports as conflicted
// (after the tree id, up to the blank line).
merge_tree_conflicts: fn(text: String) -> [String] Never! {
    lines: text.split("\n").to_list()
    paths := [String]{}
    index := 1
    loop index < lines.len() && lines[index] != "" {
        paths.push(lines[index].copy())
        index += 1
    }
    paths
}

// One row of a pinned-asset table: a C toolchain pack names its `platform`,
// a bubblewrap its `arch`; the other field is "".
PinnedAsset: struct {
    platform: String
    arch: String
    file: String
    sha256: String
    size: Int
}

// The value of `name: "..."` or `name: N` among the comma- or line-separated
// fields of one pinned-asset row.
pack_field: fn(body: String, name: String) -> String Never! {
    loop line in body.split("\n").to_list() {
        loop item in line.split(",").to_list() {
            entry: item.trim()
            if !entry.starts_with("{name}:") -> next
            value: entry.slice(name.len() + 1..<entry.len()).trim()
            return value.removeprefix("\"").removesuffix("\"").copy()
        }
    }
    ""
}

// The rows of pinned-asset table `table` in `text` (a source's text).
pinned_assets: fn(text: String, table: String) -> [PinnedAsset] Never! {
    rows := [PinnedAsset]{}
    if !text.contains("{table}:") -> return rows
    body_text: text.partition("{table}:").tail.partition("}} }}").head
    loop piece in body_text.split("{{").to_list() {
        if !piece.contains("}}") -> next
        body: piece.partition("}}").head
        row: PinnedAsset{platform: pack_field(body, "platform"), arch: pack_field(body, "arch"), file: pack_field(body, "file"), sha256: pack_field(body, "sha256"), size: Int.parse(pack_field(body, "size")) ?? 0}
        if row.file != "" -> rows.push(row)
    }
    rows
}

// Why the asset built from pinned sources cannot ship with this jet, or ""
// when it can: its SHA-256 and size must be the ones jet embeds in `table`
// of `source`, because jet refuses any other bytes.
pinned_asset_problem: fn(expected: PinnedAsset, sha256: String, size: Int, table: String, source: String) -> String Never! {
    if sha256 == expected.sha256 && size == expected.size -> return ""
    "{expected.file} built from pinned sources is sha256 {sha256} ({size} bytes), but jet embeds {expected.sha256} ({expected.size} bytes): update {table} in {source}"
}

// The first 16 hex digits of the sha256 of `parts` joined by NUL bytes.
cache_key: fn(parts: [String]) -> String Never! {
    bytes := [U8]{}
    loop (index, part) in parts {
        if index > 0 -> bytes.push(U8{0})
        bytes.extend(part.bytes())
    }
    short(sha256_hex(bytes), 16)
}

// --- the release -------------------------------------------------------------

// A seed directory. `genuine` is "" when its jet is the one it was released
// as, else every way it differs (seed_info); `release_name` is the name its
// RELEASE.json records.
SeedRelease: struct {
    dir: String
    name: String
    identity: String
    jet: String
    jet_sha: String
    jetpack: String
    source: String
    commit: String
    release_name: String
    genuine: String
    error: String
}

no_seed: fn(error: String) -> SeedRelease Never! {
    SeedRelease{dir: "", name: "", identity: "", jet: "", jet_sha: "", jetpack: "", source: "", commit: "", release_name: "", genuine: "", error: error.copy()}
}

// The seed in `dir`. Its jet is genuine when SHA256SUMS lists its sha256 for
// `jet`, IDENTITY ends in its identity digest (Release.jet identity_digest),
// and RELEASE.json records that
// identity and the commit SOURCE names: only then is the export of that
// commit the tree this jet reads its Core from.
seed_info: fn(dir: String) -[FS]> SeedRelease Never! {
    info := no_seed("")
    missing := [String]{}
    loop name in STAGE_FILES {
        if !files.exists(files.join(dir, name)) -> missing.push(name.copy())
    }
    if missing.len() > 0 {
        info.error = "release {dir} lacks {missing.join(", ")}"
        return info
    }
    info.dir = dir.copy()
    info.name = files.basename(dir).copy()
    info.identity = (read_text(files.join(dir, "IDENTITY")) ?? "").trim().copy()
    info.jet = files.join(dir, "jet")
    info.jet_sha = sha256_file(info.jet)
    if files.exists(files.join(dir, "jetpack")) -> info.jetpack = files.join(dir, "jetpack")
    info.source = (read_text(files.join(dir, "SOURCE")) ?? "").trim().copy()
    // The release's own tree, for the release-side suites, is an export of
    // the commit SOURCE names.
    first: info.source.partition(" ").head.partition("\n").head
    if is_hex(first, 40) -> info.commit = first.copy()
    if info.commit == "" -> info.error = "release {dir} names no commit in SOURCE"
    recorded: json.parse(read_text(files.join(dir, "RELEASE.json")) ?? "") ?? Dyn.Null
    info.release_name = text_field(recorded, "name")
    identity: text_field(recorded, "identity")
    commit: text_field(recorded, "commit")
    problems := [String]{}
    if !has_line(read_text(files.join(dir, "SHA256SUMS")) ?? "", "{info.jet_sha}  jet") -> problems.push("SHA256SUMS does not list its jet ({short(info.jet_sha, 16)})")
    if identity_sha(info.identity) != identity_digest_file(info.jet) -> problems.push("IDENTITY {info.identity} does not name its jet")
    if identity != info.identity -> problems.push("RELEASE.json records identity {if identity == "" -> "none" else -> identity}")
    if commit != info.commit -> problems.push("RELEASE.json records commit {if commit == "" -> "none" else -> short(commit, 10)}, SOURCE {short(info.commit, 10)}")
    info.genuine = problems.join("; ")
    info
}

// The current release, `SEEDS/current`: the chain's seed, which builds s1.
release_info: fn(seeds: String) -[Env, FS]> SeedRelease Never! {
    link: files.join(seeds, "current")
    if !files.exists(link) -> return no_seed("{link} does not exist")
    dir: files.realpath(link) ?? return no_seed("{link} does not resolve: {err}")
    seed_info(dir)
}

// The release the suites and the Jetpack census compare against: `current`
// when its jet is genuine, else (a boot seed, whose jet was built from a
// later tree than the one its files name) SEEDS/<its RELEASE.json name>,
// which must be. The baseline's rows read its exported SOURCE commit, so
// a jet that is not that commit's cannot be one.
baseline_info: fn(seeds: String, current: SeedRelease) -[Env, FS]> SeedRelease Never! {
    if current.error != "" || current.genuine == "" -> return current.copy()
    why: "no baseline: the jet of {current.name} is not the release its files name ({current.genuine})"
    if current.release_name == "" || current.release_name == current.name -> return no_seed("{why}, and it names no other seed")
    named: files.join(seeds, current.release_name)
    if !files.exists(named) -> return no_seed("{why}, and {named} does not exist")
    dir: files.realpath(named) ?? return no_seed("{why}, and {named} does not resolve: {err}")
    found := seed_info(dir)
    if found.error == "" && found.genuine != "" -> found.error = "{why}, nor is {named}'s: {found.genuine}"
    found
}

Pre: struct {
    errors: [String]
    root: String
    seeds: String
    work_root: String
    sha: String
    release: SeedRelease
    baseline: SeedRelease
    // COMMIT's native suites (native_suites).
    native: [String]
    dispositions: [Disposition]
    admission: Admission
}

absolute_or: fn(path: String) -[Env, FS]> String Never! {
    files.absolute(path) ?? path.copy()
}

preconditions: fn(options: AdmitOptions, root: String) -[Env, Exec, FS, Time.Wait]> Pre Never! {
    errors := options.errors.copy()
    seeds: absolute_or(if options.seeds != "" -> options.seeds else -> seeds_root())
    work_root: absolute_or(if options.work != "" -> options.work else -> process.env_nonempty("JET_RELEASE_WORK") ?? files.join(state_root(), "release"))
    sha := ""
    native := [String]{}
    if options.commit != "" {
        parsed: git_in(root, [String]{"rev-parse", "--verify", "{options.commit}^{{commit}}"})
        if parsed.rc != 0 {
            errors.push("{options.commit} is not a commit of {root}")
        } else {
            sha = parsed.out.copy()
            if git_in(root, [String]{"merge-base", "--is-ancestor", sha, "refs/heads/dev"}).rc != 0 -> errors.push("{short(sha, 10)} is not on dev")
            listed: native_suites(root, sha)
            if listed.error != "" -> errors.push(listed.error.copy())
            native = listed.suites.copy()
        }
    }
    release: release_info(seeds)
    if release.error != "" -> errors.push(release.error.copy())
    baseline: if release.error == "" -> baseline_info(seeds, release) else -> release.copy()
    if release.error == "" && baseline.error != "" -> errors.push(baseline.error.copy())
    key: publication_key_paths(RELEASE_KEY).seed_path
    if options.filter == "" && !files.exists(key) -> errors.push("no release signing key at {key}: create it with `jet registry keygen --registry {RELEASE_KEY}`")
    dispositions := [Disposition]{}
    if options.dispositions != "" {
        if files.read(options.dispositions) == {
            .Ok(text) -> {
                parsed: parse_dispositions(text, kit_suites(native))
                errors.extend(parsed.errors.copy())
                dispositions = parsed.rows.copy()
            }
            .Err(_) -> errors.push("dispositions file {options.dispositions} does not exist")
        }
    }
    if inside(seeds, work_root) -> errors.push("the work root must be outside the seeds directory")
    // The preflight gate, once the run could otherwise start: COMMIT's
    // receipt from a census by the current release.
    admission: if errors.len() > 0 -> Admission{admitted: false, text: ""} else -> preflight_gate("release-compiler", root, release.dir, sha)
    Pre{errors: errors, root: root.copy(), seeds: seeds, work_root: work_root, sha: sha, release: release, baseline: baseline, native: native, dispositions: dispositions, admission: admission}
}

GateRow: struct {
    check: String
    status: String
    detail: String
}

// s2 of the chain, and the jetpack engine it built.
Built: struct {
    jet: String
    runtime: String
    sha: String
    identity: String
    jetpack: String
    s2: String
    s3: String
}

SuiteResult: struct {
    suite: String
    compared: Compared
}

Ctx: struct {
    options: AdmitOptions
    root: String
    seeds: String
    work_root: String
    work: String
    sha: String
    // COMMIT's compiler source identity (source_identity of the export), "" when unknown.
    source: String
    // The chain's seed (`current`), which builds s1.
    release: SeedRelease
    // The release column: the suites and the Jetpack census compare the
    // candidate against this seed's jet on its own tree (baseline_info).
    baseline: SeedRelease
    vars: [Var]
    // COMMIT's native suites (native_suites): the kit suites and REGISTRY_SUITE.
    native: [String]
    dispositions: [Disposition]
    next: String
    tree: String
    release_tree: String
    log: String
    built: Bool
    candidate: Built
    // The pinned assets admit built and checked (the C toolchain pack, the
    // bubblewrap), each named as its release asset; assemble ships them.
    pinned: [String]
    jetpack_fixed: [String]
    jetpack_summary: String
    suites: [SuiteResult]
    rows: [GateRow]
    // A reused run's untracked failures as the prior run recorded them: each
    // was run again, and one that passes now passed only on its retry.
    reused_failures: [SuiteRow]{[SuiteRow]{}}
}

row: fn(ctx: &Ctx, check: String, status: String, detail: String) Never! -[FS, IO, Time]> {
    ctx.rows.push(GateRow{check: check.copy(), status: status.copy(), detail: detail.copy()})
    say("release", ctx.log, "{check}: {status} {detail}")
}

failed_rows: fn(ctx: Ctx) -> [GateRow] Never! {
    out := [GateRow]{}
    loop found in ctx.rows {
        if found.status == "FAIL" || found.status == "BLOCKED" -> out.push(found.copy())
    }
    out
}

with_vars: fn(base: [Var], extra: [Var]) -> [Var] Never! {
    out := base.copy()
    out.extend(extra.copy())
    out
}

joined: fn(prefix: [String], rest: [String]) -> [String] Never! {
    out := prefix.copy()
    out.extend(rest.copy())
    out
}

has_line: fn(text: String, wanted: String) -> Bool Never! {
    loop line in text.split("\n").to_list() {
        if line == wanted -> return true
    }
    false
}

// Whether `text` has an `exit: N` line.
has_exit_line: fn(text: String) -> Bool Never! {
    loop line in text.split("\n").to_list() {
        if line.starts_with("exit: ") && is_count(line.slice(6..<line.len())) -> return true
    }
    false
}

line_value: fn(text: String, prefix: String) -> String Never! {
    loop line in text.split("\n").to_list() {
        if line.starts_with(prefix) -> return line.slice(prefix.len()..<line.len()).copy()
    }
    ""
}

// The program a column's preflight runs: compiling it loads Core, which the
// column's jet reads from that column's tree.
PREFLIGHT_PROBE: "run: fn() {{\n    print(\"preflight probe\")\n}}\n"

// REPORT.md's name for a column's compiler: seed, identity, the compiler's
// path and sha256, and the tree it reads Core from.
column_text: fn(name: String, identity: String, jet: String, jet_sha: String, commit: String) -> String Never! {
    "{name} ({identity}), compiler {jet} (sha256 {jet_sha}), tree {commit}"
}

// The preflight of the `side` column: its compiler `jet` checks and runs a
// one-line program against `tree` (the export of `commit`), the Core its
// suite rows read, with a JET_HOME of its own under `work` so no build of an
// earlier run answers it. None when the program prints its line; else the
// refusal. A compiler that can't read its tree's Core fails every row of its
// column, so a row that asserts only a failure passes there, and the
// comparison counts it as a gain or a loss that tests nothing.
column_preflight: fn(side: String, jet: String, identity: String, tree: String, commit: String, work: String, vars: [Var]) -[Env, Exec, FS, Time, Time.Wait]> String? Never! {
    dir: files.join(work, "preflight-{side}")
    source: files.join(dir, "probe")
    probe: files.join(source, "probe.jet")
    home: files.join(dir, "home")
    log: files.join(work, "logs/preflight-{side}.log")
    files.create_dir_all(source) ?? ()
    files.create_dir_all(home) ?? ()
    files.create_dir_all(files.dirname(log)) ?? ()
    files.write(probe, PREFLIGHT_PROBE) ?? ()
    probe_vars: with_vars(vars, [Var]{set_var("JET_COMPILER_IDENTITY", identity), set_var("JET_TOOLCHAIN_ROOT", tree), set_var("JET_HOME", home), set_var("XDG_CACHE_HOME", files.join(home, "cache"))})
    result: run_logged([String]{jet.copy(), "run", probe}, source, probe_vars, log, 600)
    said: has_line(read_text(log) ?? "", "preflight probe")
    remove_tree(dir)
    if result.rc == 0 && said -> return None
    Val("the {side} column's compiler {jet} ({identity}) cannot check a one-line program against the Core of its tree {short(commit, 10)} (rc={result.rc}): {tail_of(log, 4)}")
}

// The release column's preflight, before any stage runs: its gate row, and
// the refusal when its compiler can't read its tree's Core.
release_preflight: fn(ctx: &Ctx) -[Env, Exec, FS, IO, Time, Time.Wait]> String? Never! {
    if column_preflight("release", ctx.baseline.jet, ctx.baseline.identity, ctx.release_tree, ctx.baseline.commit, ctx.work, ctx.vars) == .Val(refused) {
        row(ctx, "preflight:release", "FAIL", refused)
        return Val(refused.copy())
    }
    other: if ctx.baseline.dir != ctx.release.dir -> " (chain seed {ctx.release.name} is not that release's jet)" else -> ""
    passed: "{ctx.baseline.name}'s compiler {ctx.baseline.jet} ({short(ctx.baseline.jet_sha, 16)}) runs on its tree {short(ctx.baseline.commit, 10)}{other}"
    row(ctx, "preflight:release", "PASS", passed)
    None
}

// The candidate column's preflight, once the chain built s2: a failing row
// keeps every suite from launching, so neither column is compared.
candidate_preflight: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    if !ctx.built -> return
    if column_preflight("candidate", ctx.candidate.jet, ctx.candidate.identity, ctx.tree, ctx.sha, ctx.work, ctx.vars) == .Val(refused) {
        row(ctx, "preflight:candidate", "FAIL", refused)
        return
    }
    passed: "s2 {ctx.candidate.jet} ({short(ctx.candidate.sha, 16)}) runs on its tree {short(ctx.sha, 10)}"
    row(ctx, "preflight:candidate", "PASS", passed)
}

// REPORT.md of a run its release column's preflight refused: the columns
// and the refusal, with no comparison.
refused_report: fn(ctx: Ctx, refused: String) -> String Never! {
    lines := [String]{"# {ctx.next}: release gate of dev {short(ctx.sha, 10)}", "", "Verdict: REFUSED at preflight", "Seed: {ctx.release.name} ({ctx.release.identity})"}
    lines.push("Release column: {column_text(ctx.baseline.name, ctx.baseline.identity, ctx.baseline.jet, ctx.baseline.jet_sha, ctx.baseline.commit)}")
    lines.extend([String]{"", "| check | status | detail |", "|---|---|---|"})
    loop found in ctx.rows -> lines.push("| {found.check} | {found.status} | {found.detail.replace("|", "\\|")} |")
    lines.extend([String]{"", "No suite ran on either column, so the run has no gains and no losses: {refused}"})
    "{lines.join("\n")}\n"
}

// The gate's first step: refuses the run, writing REPORT.md, when the
// release column's compiler can't read its tree's Core.
gate_preflight: fn(ctx: &Ctx) -[Env, Exec, FS, IO, Time, Time.Wait]> String? Never! {
    refused: release_preflight(ctx) ?? return None
    files.write(files.join(ctx.work, "REPORT.md"), refused_report(ctx, refused)) ?? ()
    Val(refused.copy())
}

chain_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    out: files.join(ctx.work, "chain")
    log: files.join(ctx.work, "logs/chain.log")
    result: run_logged([String]{ctx.release.jet.copy(), files.join(ctx.root, "Tools/agent/Chain.jet"), ctx.tree.copy(), "full", "--out", out}, ctx.work, [Var]{set_var("CHAIN_SEED", ctx.release.dir), set_var("JET_COMPILER_IDENTITY", ctx.release.identity), set_var("JET_TOOLCHAIN_ROOT", ctx.root)}, log, 4 * 3600)
    text: read_text(files.join(out, "RESULT")) ?? {
        row(ctx, "chain", "FAIL", "Tools/agent/Chain.jet rc={result.rc} wrote no RESULT: {tail_of(log, 8)}")
        return
    }
    rows: parse_chain_result(text)
    verdict: chain_row(rows, "verdict")
    problems := [String]{}
    verdict_status: if verdict == .Val(found) -> found.status.copy() else -> "missing"
    verdict_note: if verdict == .Val(found) -> found.note.copy() else -> ""
    if verdict_status != "FIXED_POINT" -> problems.push("verdict {verdict_status}")
    builder: line_value(read_text(files.join(out, "keys/s1.txt")) ?? "", "builder=").trim()
    if builder != ctx.release.jet_sha -> problems.push("s1 was built by {if builder == "" -> "unknown" else -> builder}, not {ctx.release.name} ({short(ctx.release.jet_sha, 16)})")
    s2: files.join(out, "s2/jet")
    s3: files.join(out, "s3/jet")
    if !files.exists(s2) || !files.exists(s3) {
        problems.push("s2/jet or s3/jet is missing")
    } else if sha256_file(s2) != sha256_file(s3) {
        problems.push("s2/jet and s3/jet differ")
    }
    if !files.exists(files.join(out, "s2/jet-runtime")) -> problems.push("s2/jet-runtime (pack2) is missing")
    stages := [String]{}
    loop found in rows {
        if found.stage != "verdict" -> stages.push("{found.stage} {found.status}")
    }
    if problems.len() > 0 {
        row(ctx, "chain", "FAIL", "{problems.join("; ")} ({stages.join(", ")})")
        return
    }
    sha: sha256_file(s2)
    // RELEASE.json records both chain stages so Tools/release can check the
    // fixed point from the seed alone. The tree's JET_VERSION is the next
    // release (run_gate), so each names `jet@<next>`.
    ctx.candidate = Built{jet: s2, runtime: files.join(out, "s2/jet-runtime"), sha: sha, identity: "jet@{ctx.next}#{sha}", jetpack: "", s2: "jet@{ctx.next}#{sha}", s3: "jet@{ctx.next}#{sha256_file(s3)}"}
    ctx.built = true
    row(ctx, "chain", "PASS", "fixed point s2 == s3 (jet {short(sha, 16)}) from {ctx.release.name}, no Rust ({stages.join(", ")}; {verdict_note})")
}

// The regular files of the tree `root` that differ from `other`, and how
// many `root` holds.
tree_differences: fn(root: String, other: String) -[FS]> (differ: [String], files: Int) Never! {
    left := [Artifact]{}
    right := [Artifact]{}
    tree_artifacts(root, "", left)
    tree_artifacts(other, "", right)
    theirs := [String: String]{}
    loop artifact in right -> theirs[artifact.path.copy()] = artifact.sha256.copy()
    ours := [String: Bool]{}
    differ := [String]{}
    loop artifact in left {
        ours[artifact.path.copy()] = true
        if (theirs.get(artifact.path) ?? "") != artifact.sha256 -> differ.push(artifact.path.removeprefix("/").copy())
    }
    loop artifact in right {
        if !ours.has_key(artifact.path) -> differ.push(artifact.path.removeprefix("/").copy())
    }
    (differ: differ, files: left.len())
}

pack_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    log: files.join(ctx.work, "logs/pack.log")
    built: files.join(ctx.tree, "Compiler/JetCli/.jet/build")
    remove_tree(built)
    vars: with_vars(ctx.vars, [Var]{set_var("JET_COMPILER_IDENTITY", ctx.candidate.identity), set_var("JET_TOOLCHAIN_ROOT", ctx.tree)})
    // s2 builds the toolchain at `basic`, as every chain stage does: the jet
    // it builds is s2's bytes at the fixed point, and the runtime pack beside
    // it is that jet's lowering. It runs behind the dev shell with no Rust
    // tool on PATH.
    argv: in_dev_shell(ctx.candidate.jet, ctx.tree, true, [String]{ctx.candidate.jet.copy(), "build", "-O1", "Compiler"})
    result: run_logged(argv, ctx.tree, vars, log, 3600)
    pack: files.join(built, "jet-runtime")
    if result.rc != 0 || !files.exists(files.join(pack, "native.key")) {
        row(ctx, "pack", "FAIL", "the pack rebuild by s2 failed rc={result.rc}: {tail_of(log, 8)}")
        return
    }
    compared: tree_differences(pack, ctx.candidate.runtime)
    if compared.differ.len() > 0 {
        shown: compared.differ[0..<if compared.differ.len() > 8 -> 8 else -> compared.differ.len()].join(", ")
        row(ctx, "pack", "FAIL", "the rebuilt pack differs from pack2 in {compared.differ.len()} file(s): {shown}")
        return
    }
    row(ctx, "pack", "PASS", "rebuilt by s2 without Rust, byte-identical to pack2 ({compared.files} files, {result.wall}s)")
}

// Builds this host's C toolchain pack with Tools/agent/cc-pack.nix (Nix runs
// only on the release machine) and checks it against the hash jet embeds;
// assemble ships it beside jet.
cc_pack_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    pinned_asset_stage(ctx, "cc-pack", "Tools/agent/cc-pack.nix", CC_PACK_SOURCE, CC_PACK_TABLE, host_target())
}

// Builds the sandbox's pinned bubblewrap for this host's architecture with
// Tools/agent/bwrap.nix and checks it against the hash jet embeds; assemble
// ships it beside jet, where jet looks before fetching it from the release.
bwrap_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    pinned_asset_stage(ctx, "bwrap", "Tools/agent/bwrap.nix", BWRAP_SOURCE, BWRAP_TABLE, sys.arch())
}

// One pinned-asset check: the row of `table` in `source` whose platform or
// arch is `key`, built by `nix` and held to the row's SHA-256 and size.
pinned_asset_stage: fn(ctx: &Ctx, check: String, nix: String, source: String, table: String, key: String) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    expected := PinnedAsset?{None}
    loop found in pinned_assets(read_text(files.join(ctx.tree, source)) ?? "", table) {
        if (found.platform == key || found.arch == key) && expected == None -> expected = Val(found.copy())
    }
    asset: expected ?? {
        row(ctx, check, "FAIL", "{table} in {source} embeds no asset for {key}")
        return
    }
    link: files.join(ctx.work, "{check}-result")
    log: files.join(ctx.work, "logs/{check}.log")
    result: run_logged([String]{"nix-build", files.join(ctx.tree, nix), "--out-link", link.copy()}, ctx.tree, ctx.vars, log, 12 * 3600)
    path: files.join(link, asset.file)
    if result.rc != 0 || !files.exists(path) {
        row(ctx, check, "FAIL", "nix-build {nix} failed rc={result.rc}: {tail_of(log, 8)}")
        return
    }
    problem_text: pinned_asset_problem(asset, sha256_file(path), files.getsize(path) ?? -1, table, source)
    if problem_text != "" {
        row(ctx, check, "FAIL", problem_text)
        return
    }
    ctx.pinned.push(path.copy())
    row(ctx, check, "PASS", "{asset.file} rebuilt from pinned sources matches the hash jet embeds ({short(asset.sha256, 16)}, {asset.size} bytes, {result.wall}s)")
}

bootstrap_scratch: fn(worker: String) -[Env, FS]> [String] Never! {
    root: files.join(state_root(), "jetpack-bootstrap")
    out := [String]{}
    entries: files.list_dir(root) ?? return out
    loop entry in entries {
        if entry.name.starts_with("{worker}-") -> out.push(files.join(root, entry.name))
    }
    out
}

first_existing: fn(dirs: [String], name: String) -[FS]> String Never! {
    loop dir in dirs {
        path: files.join(dir, name)
        if files.exists(path) -> return path
    }
    ""
}

clear_scratch: fn(worker: String) Never! -[Env, Exec, FS, Time.Wait]> {
    loop dir in bootstrap_scratch(worker) -> remove_tree(dir)
}

Census: struct {
    finished: Bool
    keys: [String]
    detail: String
}

// One keep-going Jetpack/Bootstrap check with `jet` on the tree `root`.
jetpack_census: fn(ctx: &Ctx, side: String, jet: String, identity: String, root: String) -[Env, Exec, FS, Time, Time.Wait]> Census Never! {
    worker: "release-{side}-{sys.pid()}"
    clear_scratch(worker)
    vars: with_vars(ctx.vars, [Var]{set_var("JET_KEEP_GOING", "1"), set_var("JET_COMPILER_IDENTITY", identity), set_var("JET_TOOLCHAIN_ROOT", root), set_var("JETPACK_WORKER", worker), set_var("JET", jet)})
    log: files.join(ctx.work, "logs/jetpack-{side}.log")
    result: run_logged(joined(STACK, [String]{jet.copy(), "Jetpack/Bootstrap/Check.jet"}), root, vars, log, 3600)
    scratch: bootstrap_scratch(worker)
    errors: first_existing(scratch, "check-errors.txt")
    receipt: first_existing(scratch, "check.receipt")
    // Check.jet writes the receipt's `exit:` line last: without it the census
    // is partial.
    finished: !result.timed_out && receipt != "" && has_exit_line(read_text(receipt) ?? "")
    keys: if finished && errors != "" -> jetpack_keys(read_text(errors) ?? "") else -> [String]{}
    clear_scratch(worker)
    if !finished -> return Census{finished: false, keys: [String]{}, detail: "Check.jet did not finish (rc={result.rc}{if result.timed_out -> ", timed out" else -> ""}): {tail_of(log, 8)}"}
    Census{finished: true, keys: keys, detail: "rc={result.rc}, {keys.len()} rows, {result.wall}s"}
}

read_keys: fn(path: String) -[FS]> [String] Never! {
    out := [String]{}
    loop line in (read_text(path) ?? "").split("\n").to_list() {
        if line != "" -> out.push(line.copy())
    }
    out
}

keys_text: fn(keys: [String]) -> String Never! {
    if keys.len() == 0 -> return ""
    "{keys.join("\n")}\n"
}

shown_keys: fn(keys: [String], count: Int) -> String Never! {
    out := [String]{}
    loop key in keys {
        if out.len() >= count -> break
        out.push(key.replace("\t", ": "))
    }
    out.join(" | ")
}

// The release's census: the rows it recorded when it was cut
// (evidence/jetpack-candidate.keys), else a census of the release on its own
// tree. The candidate must add no row; a census that finishes for the
// release must finish for the candidate.
jetpack_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    recorded: files.join(ctx.baseline.dir, "evidence/jetpack-candidate.keys")
    cache: files.join(files.join(ctx.work_root, "cache"), "jetpack-{cache_key([String]{ctx.baseline.jet_sha, ctx.baseline.commit})}.keys")
    before := Census{finished: false, keys: [String]{}, detail: ""}
    if {
        files.exists(recorded) -> before = Census{finished: true, keys: read_keys(recorded), detail: "recorded in {ctx.baseline.name}/evidence"}
        files.exists(cache) -> before = Census{finished: true, keys: read_keys(cache), detail: "cached {files.basename(cache)}"}
        else -> {
            before = jetpack_census(ctx, "release", ctx.baseline.jet.copy(), ctx.baseline.identity.copy(), ctx.release_tree.copy())
            if before.finished {
                files.create_dir_all(files.dirname(cache)) ?? ()
                files.write(cache, keys_text(before.keys)) ?? ()
            }
        }
    }
    after: jetpack_census(ctx, "candidate", ctx.candidate.jet.copy(), ctx.candidate.identity.copy(), ctx.tree.copy())
    if before.finished -> files.write(files.join(ctx.work, "evidence/jetpack-release.keys"), keys_text(before.keys)) ?? ()
    if after.finished -> files.write(files.join(ctx.work, "evidence/jetpack-candidate.keys"), keys_text(after.keys)) ?? ()
    if !before.finished && !after.finished {
        ctx.jetpack_summary = "Jetpack census finishes on neither {ctx.baseline.name} nor s2"
        row(ctx, "jetpack", "NOTE", "the census finishes on neither side, so nothing regressed (release: {before.detail}; candidate: {after.detail})")
        return
    }
    if !after.finished {
        row(ctx, "jetpack", "FAIL", "the census finishes for {ctx.baseline.name} ({before.detail}) but not for the candidate: {after.detail}")
        return
    }
    if !before.finished {
        ctx.jetpack_summary = "Jetpack census restored ({after.keys.len()} rows; {ctx.baseline.name} could not finish it)"
        row(ctx, "jetpack", "NOTE", "census restored: {ctx.baseline.name} could not finish it ({before.detail}); candidate {after.detail}")
        return
    }
    old := [String: Bool]{}
    loop key in before.keys -> old[key.copy()] = true
    now := [String: Bool]{}
    loop key in after.keys -> now[key.copy()] = true
    added := [String]{}
    loop key in after.keys {
        if !old.has_key(key) -> added.push(key.copy())
    }
    fixed := [String]{}
    loop key in before.keys {
        if !now.has_key(key) -> fixed.push(key.copy())
    }
    ctx.jetpack_fixed = fixed.copy()
    if added.len() > 0 {
        row(ctx, "jetpack", "FAIL", "{added.len()} new census row(s): {shown_keys(added, 6)}")
        return
    }
    ctx.jetpack_summary = "Jetpack census 0 new rows, {fixed.len()} fixed"
    row(ctx, "jetpack", "PASS", "no new census rows ({after.keys.len()} rows, {fixed.len()} fixed; release {before.detail}; candidate {after.detail})")
}

hosted_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    worker: "release-hosted-{sys.pid()}"
    clear_scratch(worker)
    vars: with_vars(ctx.vars, [Var]{set_var("JET_COMPILER_IDENTITY", ctx.candidate.identity), set_var("JET_TOOLCHAIN_ROOT", ctx.tree), set_var("JETPACK_WORKER", worker), set_var("JET", ctx.candidate.jet), norust_var()})
    log: files.join(ctx.work, "logs/jetpack-hosted.log")
    result: run_logged(joined(STACK, [String]{ctx.candidate.jet.copy(), "Jetpack/Bootstrap/Check.jet", "--hosted"}), ctx.tree, vars, log, 3 * 3600)
    receipt: first_existing(bootstrap_scratch(worker), "hosted.receipt")
    text: if receipt != "" -> read_text(receipt) ?? "" else -> ""
    binary: line_value(text, "hosted-binary: ")
    ok := has_line(text, "exit: 0") && binary != "" && files.exists(binary)
    if ok {
        engine: files.join(ctx.work, "jetpack/jetpack")
        files.create_dir_all(files.dirname(engine)) ?? ()
        // The seed ships jetpack beside jet, and jet looks for its engine
        // beside itself first; give s2 the same layout so the suites test
        // what ships rather than whatever `jetpack` PATH resolves first.
        beside: files.join(files.dirname(ctx.candidate.jet), "jetpack")
        if copy_file(binary, engine, true) == .Err(_) || copy_file(binary, beside, true) == .Err(_) {
            ok = false
        } else {
            ctx.candidate.jetpack = engine.copy()
        }
    }
    clear_scratch(worker)
    if ok {
        engine_sha: sha256_file(ctx.candidate.jetpack.copy())
        row(ctx, "jetpack-engine", "PASS", "Check.jet --hosted built jetpack with s2 without Rust ({short(engine_sha, 16)}, {result.wall}s)")
        return
    }
    why: "Check.jet --hosted rc={result.rc}{if result.timed_out -> " (timed out)" else -> ""}: {tail_of(log, 8)}"
    // Losing the engine the current release ships is a regression; a release
    // that never had one only notes it.
    if ctx.baseline.jetpack != "" {
        row(ctx, "jetpack-engine", "FAIL", "{ctx.baseline.name} ships jetpack and s2 cannot build it: {why}")
    } else {
        row(ctx, "jetpack-engine", "NOTE", "no jetpack engine ({ctx.baseline.name} ships none either): {why}")
    }
}

SuiteRun: struct {
    rows: [SuiteRow]
    error: String
}

rows_of: fn(items: [Dyn]) -> [SuiteRow] Never! {
    out := [SuiteRow]{}
    loop item in items -> out.push(suite_row(item))
    out
}

rows_json: fn(rows: [SuiteRow]) -> String Never! {
    items := [Dyn]{}
    loop found in rows -> items.push(found.raw.copy())
    json.dumps(Dyn.Array(items)) ?? "[]"
}

// The environment of a side's suite run. Its runner (Tools/agent/JetEnv.jet,
// then `jet test`) is the candidate, built from `tree`, and reads that tree's
// Core (JET_TOOLCHAIN_ROOT). The rows are `jet`, the side's jet, and read the
// side's own tree, `rows_tree` (JET_TEST_TOOLCHAIN_ROOT, which the testkit
// hands them as their JET_TOOLCHAIN_ROOT). An older release tree that lacks a
// Core file the candidate names still runs.
suite_vars: fn(base: [Var], tree: String, rows_tree: String, identity: String, jet: String) -> [Var] Never! {
    with_vars(base, [Var]{set_var("JET_COMPILER_IDENTITY", identity), set_var("JET_TOOLCHAIN_ROOT", tree), set_var("JET_TEST_TOOLCHAIN_ROOT", rows_tree), set_var("JET", jet)})
}

// Every kit suite (kit_suites) in one kit pool: Compiler/package.jet's `corpora`
// profile holds the corpora of the golden (golden, run), ui (ui, ui_lint)
// and cases profiles, and each row names its suite.
CORPORA_PROFILE: "corpora"

// One side's kit processes for test profile `profile`: `shards` `jet test
// Compiler --profile <profile>` processes, which the slot runs at once with
// nothing else (shard_pool). s2 runs every one, and `--compiler` names the
// side's jet that builds and runs the rows; the jetpack beside that jet
// serves them. A `label_tag` run (a `--cases` list in `extra`) takes no
// --filter: its list comes from a run that did.
SuiteBatch: struct {
    labels: [String]
    jobs: [Job]
}

suite_batch: fn(ctx: &Ctx, side: String, profile: String, label_tag: String, extra: [String], shards: Int) -[Env]> SuiteBatch Never! {
    release: side == "release"
    jet: if release -> ctx.baseline.jet.copy() else -> ctx.candidate.jet.copy()
    identity: if release -> ctx.baseline.identity.copy() else -> ctx.candidate.identity.copy()
    root: if release -> ctx.release_tree.copy() else -> ctx.tree.copy()
    listed: label_tag != ""
    count: if shards < 1 -> 1 else -> shards
    kit: files.join(ctx.work, "kit")
    out := SuiteBatch{labels: [String]{}, jobs: [Job]{}}
    loop index in 1..<count + 1 {
        label: "{side}-{profile}{if listed -> "-{label_tag}" else -> ""}-{index}"
        vars: suite_vars(ctx.vars, ctx.tree, root, identity, jet)
        // Suite rows run host tools (C compilers, interpreters) that only
        // the dev shell supplies until jet does.
        argv := in_dev_shell(ctx.candidate.jet, ctx.tree, false, [String]{ctx.candidate.jet.copy(), "test", files.join(ctx.tree, "Compiler"), "--profile", profile.copy(), "--compiler={jet}", "--results={files.join(kit, "{label}.json")}"})
        if count > 1 -> argv.push("--shard={index}/{count}")
        argv.extend(shard_pool(ctx.options, count, sys.get("SLOT_MEMORY_MAX") ?? "", sys.get("SLOT_CPUS") ?? ""))
        if ctx.options.filter != "" && !listed -> argv.push("--filter={ctx.options.filter}")
        if ctx.options.timeout > 0 -> argv.push("--time-limit={ctx.options.timeout}s")
        argv.extend(extra.copy())
        out.labels.push(label.copy())
        out.jobs.push(Job{argv: argv, cwd: ctx.tree.copy(), vars: vars, log: files.join(kit, "{label}.log"), seconds: 12 * 3600})
    }
    out
}

// The rows `batch`'s processes wrote, merged; `results` are their exits in order.
suite_rows: fn(ctx: &Ctx, batch: SuiteBatch, results: [Finished]) -[FS]> SuiteRun Never! {
    kit: files.join(ctx.work, "kit")
    rows := [SuiteRow]{}
    errors := [String]{}
    loop (index, label) in batch.labels {
        result: if index < results.len() -> results[index].copy() else -> Finished{rc: 127, timed_out: false, wall: 0}
        file: files.join(kit, "{label}.json")
        log: files.join(kit, "{label}.log")
        // The kit refuses an empty selection (a --filter or a shard that
        // matches nothing): zero rows.
        if !files.exists(file) && result.rc == 2 && (read_text(log) ?? "").contains("no matching corpus entries") -> next
        text: read_text(file) ?? {
            errors.push("{label} rc={result.rc}{if result.timed_out -> " (timed out)" else -> ""} wrote no results: {tail_of(log, 3)}")
            next
        }
        tree: json.parse(text) ?? {
            errors.push("{label}: {file} is not JSON: {err}")
            next
        }
        rows.extend(rows_of(array_field(tree, "results")))
    }
    SuiteRun{rows: rows, error: errors.join("; ")}
}

// One side's run of test profile `profile` in one kit process, alone in the
// slot: a retry or a rerun of a `--cases` list.
suite_run: fn(ctx: &Ctx, side: String, profile: String, label_tag: String, extra: [String]) -[Env, Exec, FS, Time, Time.Wait]> SuiteRun Never! {
    batch: suite_batch(ctx, side, profile, label_tag, extra, 1)
    suite_rows(ctx, batch, run_batch(batch.jobs.copy()))
}

// The rows of `run` in `suite`, with its error.
suite_part: fn(run: SuiteRun, suite: String) -> SuiteRun Never! {
    rows := [SuiteRow]{}
    loop item in run.rows {
        if item.suite == suite -> rows.push(item.copy())
    }
    SuiteRun{rows: rows, error: run.error.copy()}
}

lost_shown: fn(lost: [LostRow], count: Int) -> String Never! {
    out := [String]{}
    loop found in lost {
        if out.len() >= count -> break
        out.push("{found.id} {found.tier} {found.was}->{found.now}")
    }
    out.join(" | ")
}

// The suite rows one compiler gave on one commit, in one file: this gate's
// candidate column (evidence/rows-candidate.json, written by every unfiltered
// run whose candidate rows are complete), a train's run with its own compiler
// (`rows`), or the release column's carried rows (release_cache). `source` is
// the compiler's source identity (`Tools/agent/CompilerPackages.jet identity`;
// empty for a release's jet), `compiler` its binary identity, and `rows` the
// testkit's result rows, each naming its suite.
ROWS_SCHEMA: "jet.suite-rows.v1"

RowFile: struct {
    commit: String
    source: String
    compiler: String
    rows: [SuiteRow]
}

row_file_text: fn(file: RowFile) -> String Never! {
    items := [Dyn]{}
    loop found in file.rows -> items.push(found.raw.copy())
    record: Dyn.Object([String: Dyn]{"schema": text_dyn(ROWS_SCHEMA), "commit": text_dyn(file.commit), "sourceIdentity": text_dyn(file.source), "compiler": text_dyn(file.compiler), "rows": Dyn.Array(items)})
    "{json.dumps(record) ?? "{{}}"}\n"
}

parse_row_file: fn(text: String) -> RowFile Problem! {
    tree: json.parse(text) ?? return Err(problem(INPUT, "not JSON: {err}"))
    if text_field(tree, "schema") != ROWS_SCHEMA -> return Err(problem(INPUT, "not a {ROWS_SCHEMA} row file"))
    commit: text_field(tree, "commit")
    if commit == "" -> return Err(problem(INPUT, "a row file that names no commit"))
    Ok(RowFile{commit: commit, source: text_field(tree, "sourceIdentity"), compiler: text_field(tree, "compiler"), rows: rows_of(array_field(tree, "rows"))})
}

// The row file --reuse ROWS names: ROWS, or the evidence/rows-candidate.json
// of a directory (a copy of an earlier run's work directory).
reuse_file: fn(given: String) -[Env, FS]> String Never! {
    path: files.absolute(given) ?? given.copy()
    if files.is_dir(path) -> return files.join(path, "evidence/rows-candidate.json")
    path
}

// The candidate rows --reuse supplies: the commit `prior` they ran on, its
// rows, and the changed files each rerun row must cover. `error` stops every
// suite.
ReusePlan: struct {
    active: Bool
    prior: String
    rows: [SuiteRow]
    paths: [String]
    error: String
}

// Paths no suite reads; a change under them leaves every row as it was.
REUSE_QUIET: [String]{"Docs/", ".agents/", "AGENTS.md", "Tools/release/"}
// Paths the suites read as rows and fixtures.
REUSE_ROWS: [String]{"tests/", "Examples/"}

has_prefix: fn(path: String, prefixes: [String]) -> Bool Never! {
    loop prefix in prefixes {
        if path.starts_with(prefix) -> return true
    }
    false
}

// The ids of `rows` a changed path can reach: a row whose own file changed,
// or whose directory holds a changed file at any depth.
rerun_ids: fn(rows: [SuiteRow], paths: [String]) -> [String] Never! {
    out := [String]{}
    loop item in rows {
        if out.contains(item.id) -> next
        dir: files.dirname(item.id)
        loop path in paths {
            if path == item.id || path.starts_with("{dir}/") {
                out.push(item.id.copy())
                break
            }
        }
    }
    out
}

// Why a row file cannot stand for COMMIT's candidate rows, each problem
// once: rows of another compiler source than COMMIT's (`source`, "" when
// COMMIT's is unknown), and a kit suite of `suites` with no rows.
row_file_problems: fn(file: RowFile, path: String, source: String, suites: [String]) -> [String] Never! {
    problems := [String]{}
    if source == "" {
        problems.push("this run could not read the compiler source identity of COMMIT, so no rows can match it")
    } else if file.source != source {
        problems.push("{path} holds the rows of compiler source {if file.source == "" -> "(none named)" else -> file.source}, not {source}")
    }
    loop suite in suites {
        held := false
        loop item in file.rows {
            if item.suite == suite {
                held = true
                break
            }
        }
        if !held -> problems.push("{path} holds no {suite} rows")
    }
    problems
}

reuse_plan: fn(ctx: &Ctx) -[Env, Exec, FS, Time.Wait]> ReusePlan Never! {
    plan := ReusePlan{active: false, prior: "", rows: [SuiteRow]{}, paths: [String]{}, error: ""}
    if ctx.options.reuse == "" -> return plan
    plan.active = true
    path: reuse_file(ctx.options.reuse)
    if inside(ctx.work, path) {
        plan.error = "{path} lies in this run's own work directory, which the gate clears first; copy the row file elsewhere"
        return plan
    }
    text: files.read(path) ?? {
        plan.error = "{path} cannot be read: {err}"
        return plan
    }
    file: parse_row_file(text) ?? {
        plan.error = "{path}: {err.text}"
        return plan
    }
    problems := row_file_problems(file, path, ctx.source, kit_suites(ctx.native))
    parsed: git_in(ctx.root, [String]{"rev-parse", "--verify", "{file.commit}^{{commit}}"})
    if parsed.rc != 0 {
        problems.push("{path} names {file.commit}, no commit of this repository")
    } else {
        plan.prior = parsed.out.copy()
        if git_in(ctx.root, [String]{"merge-base", "--is-ancestor", plan.prior, ctx.sha}).rc != 0 -> problems.push("{short(plan.prior, 10)} is not an ancestor of {short(ctx.sha, 10)}")
    }
    if problems.len() > 0 {
        plan.error = problems.join("; ")
        return plan
    }
    changed: git_in(ctx.root, [String]{"diff", "--name-status", "--no-renames", plan.prior, ctx.sha})
    if changed.rc != 0 -> problems.push("git diff {short(plan.prior, 10)} {short(ctx.sha, 10)} failed: {changed.err}")
    loop line in changed.out.split("\n").to_list() {
        cells: line.split("\t").to_list()
        if cells.len() != 2 -> next
        status: cells[0]
        changed_path: cells[1]
        if {
            has_prefix(changed_path, REUSE_QUIET) -> {}
            !has_prefix(changed_path, REUSE_ROWS) -> problems.push("{changed_path} changed outside tests/ and Examples/")
            status != "M" -> problems.push("{changed_path} is added or deleted ({status}), so no earlier row covers it")
            rerun_ids(file.rows, [String]{changed_path.copy()}).len() == 0 -> problems.push("{changed_path} sits under no row's directory")
            else -> plan.paths.push(changed_path.copy())
        }
    }
    plan.rows = file.rows.copy()
    plan.error = problems.join("; ")
    plan
}

// `prior` without the rows of `ids`, then `fresh`, the rows that ran again.
merged_rows: fn(prior: [SuiteRow], fresh: [SuiteRow], ids: [String]) -> [SuiteRow] Never! {
    out := [SuiteRow]{}
    loop item in prior {
        if !ids.contains(item.id) -> out.push(item.copy())
    }
    out.extend(fresh.copy())
    out
}

// Where the release column's rows carry over from one run of this gate to
// the next, whatever commit each gates: one row file per release column (its
// name, jet, identity and tree, its jetpack engine, the filter and the time
// limit), holding every release row the last run against that column ran or
// carried, as of the commit it gated.
release_cache: fn(ctx: &Ctx) -[FS]> String Never! {
    engine: if ctx.baseline.jetpack != "" -> sha256_file(ctx.baseline.jetpack) else -> ""
    key: cache_key([String]{ctx.baseline.name, ctx.baseline.jet_sha, ctx.baseline.identity, ctx.baseline.commit, engine, ctx.options.filter, if ctx.options.timeout > 0 -> "{ctx.options.timeout}" else -> "0"})
    files.join(files.join(ctx.work_root, "cache"), "release-rows-{key}.json")
}

// The row IDs whose known-failing lines one ledger text has and the other
// lacks.
ledger_changes: fn(before: String, after: String) -> [String: Bool] Never! {
    old: ledger_ids(before)
    new: ledger_ids(after)
    out := [String: Bool]{}
    loop raw in "{before}\n{after}".split("\n").to_list() {
        line: raw.trim()
        fields: line.split("\t").to_list()
        if line.starts_with("#") || fields.len() != 3 -> next
        if old.has_key(fields[0]) != new.has_key(fields[0]) -> out[fields[0].copy()] = true
    }
    out
}

// The IDs of release `rows` that the files `paths`, changed since the commit
// they ran on, may have changed (change_reason: the row's file or a file under
// its directory, a changed tests/ or Examples/ file under no row's directory
// whose name the row's `sources` hold, any change when its sources read the
// checkout), and the IDs a known-failing line `ledger` added or removed owns.
// No changed file leaves every row as it ran.
carried_stale: fn(rows: [SuiteRow], paths: [String], sources: [String: String], ledger: [String: Bool]) -> [String: Bool] Never! {
    stale := [String: Bool]{}
    if paths.len() == 0 -> return stale
    index: change_index(rows, paths)
    loop item in rows {
        if stale.has_key(item.id) -> next
        if ledger_owns(ledger, item.id) || change_reason(item.id, sources.get(item.id) ?? "", index) != "" -> stale[item.id.copy()] = true
    }
    stale
}

// The release rows release_cache carries to this run: the rows it holds that
// no change between their commit `from` ("" with no usable cache) and COMMIT
// reaches (carried_stale), and how many it `dropped` as stale.
Carried: struct {
    rows: [SuiteRow]
    from: String
    dropped: Int
}

no_carry: fn() -> Carried Never! { Carried{rows: [SuiteRow]{}, from: "", dropped: 0} }

carried_rows: fn(ctx: &Ctx, sources: [String: String]) -[Exec, FS, Time.Wait]> Carried Never! {
    text: read_text(release_cache(ctx)) ?? return no_carry()
    file: parse_row_file(text) ?? return no_carry()
    if file.compiler != ctx.baseline.identity -> return no_carry()
    if file.commit == ctx.sha -> return Carried{rows: file.rows.copy(), from: file.commit.copy(), dropped: 0}
    diff: git_in(ctx.root, [String]{"diff", "--name-only", "--no-renames", file.commit, ctx.sha})
    if diff.rc != 0 -> return no_carry()
    paths := [String]{}
    loop line in diff.out.split("\n").to_list() {
        if line.trim() != "" -> paths.push(line.trim().copy())
    }
    ledger: if paths.contains(KNOWN_LEDGER) -> ledger_changes(git_in(ctx.root, [String]{"show", "{file.commit}:{KNOWN_LEDGER}"}).out, read_text(files.join(ctx.tree, KNOWN_LEDGER)) ?? "") else -> [String: Bool]{}
    stale: carried_stale(file.rows, paths, sources, ledger)
    out := Carried{rows: [SuiteRow]{}, from: file.commit.copy(), dropped: 0}
    loop item in file.rows {
        if stale.has_key(item.id) -> out.dropped += 1 else -> out.rows.push(item.copy())
    }
    out
}

// The accepted-failing ledger of Compiler/package.jet's corpus profiles
// (their `baseline`), relative to a tree.
KNOWN_LEDGER: "tests/known-failing.tsv"

// The row IDs a ledger names (JetTestKit kit_known_load): a line of three
// tab-separated fields; blank lines and `#` comments name none.
ledger_ids: fn(text: String) -> [String: Bool] Never! {
    out := [String: Bool]{}
    loop raw in text.split("\n").to_list() {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() == 3 -> out[fields[0].copy()] = true
    }
    out
}

// Whether a ledger owns row `id` (JetTestKit kit_known_ledger): a ledger ID
// names the row's path, a project entry's directory, or a file entry without
// `.jet`.
ledger_owns: fn(known: [String: Bool], id: String) -> Bool Never! {
    if known.has_key(id) -> return true
    if !id.ends_with(".jet") -> return false
    if id.ends_with("/run.jet") && known.has_key(id.removesuffix("/run.jet")) -> return true
    known.has_key(id.removesuffix(".jet"))
}

// What picks the release column's rows (release_picks).
ReleaseRule: struct {
    // Run every row: the files COMMIT changed are unknown.
    every: Bool
    // The files COMMIT changed since the release's commit.
    paths: [String]
    // The row IDs the release's own ledger (KNOWN_LEDGER in its tree) names.
    known: [String: Bool]
    // Each row ID's sources (row_sources).
    sources: [String: String]
}

// A row ID the release column runs, and why.
ReleasePick: struct {
    id: String
    reason: String
}

// Whether `text` holds any of `names`.
names_any: fn(text: String, names: [String]) -> Bool Never! {
    loop name in names {
        if text.contains(name) -> return true
    }
    false
}

// What a set of changed paths reaches: the paths, every directory above
// one, and the names of the changed tests/ or Examples/ files under no
// directory of `rows`.
ChangeIndex: struct {
    changed: [String: Bool]
    touched: [String: Bool]
    names: [String]
}

change_index: fn(rows: [SuiteRow], paths: [String]) -> ChangeIndex Never! {
    ids := [String: Bool]{}
    dirs := [String: Bool]{}
    loop item in rows {
        ids[item.id.copy()] = true
        dirs[files.dirname(item.id)] = true
    }
    changed := [String: Bool]{}
    touched := [String: Bool]{}
    names := [String]{}
    loop path in paths {
        changed[path.copy()] = true
        held := false
        dir := files.dirname(path)
        loop dir != "" && dir != "/" {
            touched[dir.copy()] = true
            if dirs.has_key(dir) -> held = true
            dir = files.dirname(dir)
        }
        if held || ids.has_key(path) || !has_prefix(path, REUSE_ROWS) -> next
        name: files.basename(path)
        if !names.contains(name) -> names.push(name.copy())
    }
    ChangeIndex{changed: changed, touched: touched, names: names}
}

// Why the changes `index` holds reach row `id`, whose sources are `source`:
// its file or a file under its directory changed, its sources name the
// checkout (`{root}`), or they name a changed file; "" when none do.
change_reason: fn(id: String, source: String, index: ChangeIndex) -> String Never! {
    if {
        index.changed.has_key(id) || index.touched.has_key(files.dirname(id)) -> "changed"
        source.contains("{{root}}") -> "reading the checkout"
        names_any(source, index.names) -> "naming a changed file"
        else -> ""
    }
}

// The row IDs of the candidate's `rows` the release column runs: every ID
// with a row s2 fails (a host skip aside) or passes against a known-failing
// line, every ID the release's ledger owns, and every ID whose files changed
// since the release's commit (change_reason). Any other row has the
// files and ledger lines the release had and passes on s2, so it counts as
// passing on the release (judged_release). An opt-in ID never runs: a
// `--cases` list runs the opt-in rows that the full kit run leaves opt-in on
// both sides.
release_picks: fn(rows: [SuiteRow], rule: ReleaseRule) -> [ReleasePick] Never! {
    opt_in := [String: Bool]{}
    loop item in rows {
        if item.status == "OPT-IN" -> opt_in[item.id.copy()] = true
    }
    index: change_index(rows, rule.paths)
    out := [ReleasePick]{}
    picked := [String: Bool]{}
    loop item in rows {
        if picked.has_key(item.id) || opt_in.has_key(item.id) -> next
        reason: if {
            rule.every -> "every row"
            !passes(item.status) && item.status != "SKIP-HOST" -> "failing on s2"
            item.status == "UNEXPECTED-PASS" || ledger_owns(rule.known, item.id) -> "known-failing"
            else -> change_reason(item.id, rule.sources.get(item.id) ?? "", index)
        }
        if reason == "" -> next
        picked[item.id.copy()] = true
        out.push(ReleasePick{id: item.id.copy(), reason: reason})
    }
    out
}

// Each row ID's sources under `tree`: its file, then the `.case` sidecar
// that holds a `.jet` entry's steps (a project's beside its directory).
row_sources: fn(tree: String, rows: [SuiteRow]) -[FS]> [String: String] Never! {
    out := [String: String]{}
    loop item in rows {
        if out.has_key(item.id) -> next
        sidecar: if {
            item.id.ends_with("/run.jet") -> "{item.id.removesuffix("/run.jet")}.case"
            item.id.ends_with(".jet") -> "{item.id.removesuffix(".jet")}.case"
            else -> ""
        }
        text := read_text(files.join(tree, item.id)) ?? ""
        if sidecar != "" -> text = "{text}\n{read_text(files.join(tree, sidecar)) ?? ""}"
        out[item.id.copy()] = text
    }
    out
}

// The release column judge_suites compares: the rows the release ran, then
// the rows of each ID it did not run that s2 passes, skips on this host or
// leaves opt-in. release_picks runs every other ID, so such a row has the
// files and ledger lines the release had and passes on s2: it passes on the
// release too (a host skip and an opt-in are the kit's, the same on both
// sides).
judged_release: fn(ran: [SuiteRow], candidate: [SuiteRow]) -> [SuiteRow] Never! {
    seen := [String: Bool]{}
    loop item in ran -> seen[item.id.copy()] = true
    out := ran.copy()
    loop item in candidate {
        if !seen.has_key(item.id) && (item.status == "PASS" || item.status == "SKIP-HOST" || item.status == "OPT-IN") -> out.push(item.copy())
    }
    out
}

// The release column's rows for the candidate's: the IDs release_picks
// names, carried from release_cache where an earlier run of this gate ran
// them and nothing since reached them (carried_rows), the rest run now as a
// `--cases` list in --shards kit processes. When every process wrote its
// rows, release_cache keeps every row still valid at COMMIT, the fresh ones
// in place of the carried rows of their IDs.
release_rows: fn(ctx: &Ctx, candidate: SuiteRun) -[Env, Exec, FS, IO, Time, Time.Wait]> SuiteRun Never! {
    diff: git_in(ctx.root, [String]{"diff", "--name-only", "--no-renames", ctx.baseline.commit, ctx.sha})
    paths := [String]{}
    if diff.rc == 0 {
        loop line in diff.out.split("\n").to_list() {
            if line.trim() != "" -> paths.push(line.trim().copy())
        }
    }
    rule: ReleaseRule{every: diff.rc != 0, paths: paths.copy(), known: ledger_ids(read_text(files.join(ctx.release_tree, KNOWN_LEDGER)) ?? ""), sources: row_sources(ctx.tree, candidate.rows)}
    picks: release_picks(candidate.rows, rule)
    carried: carried_rows(ctx, rule.sources)
    have := [String: Bool]{}
    loop item in carried.rows -> have[item.id.copy()] = true
    all_ids := [String: Bool]{}
    loop item in candidate.rows -> all_ids[item.id.copy()] = true
    wanted := [String]{}
    picked := [String: Bool]{}
    counts := [String: Int]{}
    loop pick in picks {
        counts[pick.reason.copy()] = (counts.get(pick.reason) ?? 0) + 1
        picked[pick.id.copy()] = true
        if !have.has_key(pick.id) -> wanted.push(pick.id.copy())
    }
    out := SuiteRun{rows: [SuiteRow]{}, error: ""}
    loop item in carried.rows {
        if picked.has_key(item.id) -> out.rows.push(item.copy())
    }
    fresh := SuiteRun{rows: [SuiteRow]{}, error: ""}
    if wanted.len() > 0 {
        list: files.join(ctx.work, "kit/release-picks.txt")
        files.write(list, keys_text(wanted)) ?? ()
        batch: suite_batch(ctx, "release", CORPORA_PROFILE, "picked", [String]{"--cases={list}"}, if wanted.len() < ctx.options.shards -> wanted.len() else -> ctx.options.shards)
        fresh = suite_rows(ctx, batch, run_batch(batch.jobs.copy()))
        out.rows.extend(fresh.rows.copy())
        out.error = fresh.error.copy()
    }
    if fresh.error == "" {
        cache: release_cache(ctx)
        files.create_dir_all(files.dirname(cache)) ?? ()
        files.write(cache, row_file_text(RowFile{commit: ctx.sha.copy(), source: "", compiler: ctx.baseline.identity.copy(), rows: merged_rows(carried.rows, fresh.rows, wanted)})) ?? ()
    }
    reasons := [String]{}
    order: [String]{"every row", "failing on s2", "known-failing", "changed", "reading the checkout", "naming a changed file"}
    loop reason in order {
        count: counts.get(reason) ?? 0
        if count > 0 -> reasons.push("{count} {reason}")
    }
    carry: if carried.from == "" -> "none carried from the release cache" else -> "{picks.len() - wanted.len()} carried from the release cache of the run at {short(carried.from, 10)}, which dropped {carried.dropped} of its rows as stale"
    why: if diff.rc != 0 -> "; git diff {short(ctx.baseline.commit, 10)} {short(ctx.sha, 10)} failed, so every row runs: {diff.err}" else -> ""
    row(ctx, "release-column", "NOTE", "{picks.len()} of {all_ids.len()} row IDs run on {ctx.baseline.name} ({if reasons.len() > 0 -> reasons.join(", ") else -> "none"}; {carry}); the rest pass on s2 with the files and ledger lines the release had, so they count as passing there{why}")
    out
}

// Both columns judged from the candidate's rows: the candidate's row file
// (evidence/rows-candidate.json, what a later --reuse takes) when they are
// complete and unfiltered, then the release column release_rows picks from
// them, then judge_suites.
judge_columns: fn(ctx: &Ctx, candidate: SuiteRun) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    if candidate.error == "" && ctx.options.filter == "" {
        files.write(files.join(ctx.work, "evidence/rows-candidate.json"), row_file_text(RowFile{commit: ctx.sha.copy(), source: ctx.source.copy(), compiler: ctx.candidate.identity.copy(), rows: candidate.rows.copy()})) ?? ()
    }
    release: if candidate.error == "" -> release_rows(ctx, candidate) else -> SuiteRun{rows: [SuiteRow]{}, error: "not run: the candidate's rows are incomplete"}
    kit: kit_suites(ctx.native)
    judge_suites(ctx, kit, (loop suite in kit -> suite_part(release, suite)), (loop suite in kit -> suite_part(candidate, suite)))
}

// The candidate column from a row file (--reuse): its rows stand, except
// those a changed file reaches and its untracked failures (the failures a
// reuse exists to verify), which run again on the candidate. The release
// column follows as in a full run (judge_columns).
reused_suites: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    plan: reuse_plan(ctx)
    if plan.error != "" {
        loop suite in kit_suites(ctx.native) -> row(ctx, "suite:{suite}", "BLOCKED", "--reuse {ctx.options.reuse}: {plan.error}")
        return
    }
    reran := [String]{}
    verified := [String]{}
    errors := [String]{}
    candidate := SuiteRun{rows: [SuiteRow]{}, error: ""}
    loop suite in kit_suites(ctx.native) {
        after: suite_part(SuiteRun{rows: plan.rows.copy(), error: ""}, suite).rows
        changed: rerun_ids(after, plan.paths)
        // copy: the rows a change reaches stay apart from the failures run again.
        ids := changed.copy()
        loop item in after {
            if !is_untracked(item.status) || changed.contains(item.id) -> next
            // A failure no change reaches is run again: a pass now is a retry's.
            ctx.reused_failures.push(item.copy())
            if !ids.contains(item.id) {
                ids.push(item.id.copy())
                verified.push(item.id.copy())
            }
        }
        rows := after.copy()
        if ids.len() > 0 {
            list: files.join(ctx.work, "kit/rerun-{suite}.txt")
            files.write(list, keys_text(ids)) ?? ()
            fresh: suite_run(ctx, "candidate", suite, "rerun", [String]{"--cases={list}"})
            rows = merged_rows(after, fresh.rows, ids)
            if fresh.error != "" -> errors.push("{suite}: {fresh.error}")
        }
        reran.push("{suite} {ids.len()}")
        candidate.rows.extend(rows.copy())
    }
    candidate.error = errors.join("; ")
    judge_columns(ctx, candidate)
    note: "candidate rows of {short(plan.prior, 10)} (compiler source {ctx.source}) reused from {reuse_file(ctx.options.reuse)}; {plan.paths.len()} changed file(s); rows run again: {reran.join(", ")}; untracked failures verified again: {if verified.len() == 0 -> "none" else -> verified.join(" | ")}"
    row(ctx, "reuse", "NOTE", note)
    disposition_note(ctx)
}

// Each kit suite's verdict from both sides' rows: `release[i]` and
// `candidate[i]` are `kit[i]`'s, the release's the rows it ran, judged as
// judged_release completes them. The retry runs every lost row and every
// untracked timeout of every suite again on their own, in one candidate kit
// run: a row that passes by itself has not failed outright, but it is flaky,
// listed with both outcomes, and fails the gate unless a disposition names
// the card that owns it (flaky_row).
judge_suites: fn(ctx: &Ctx, kit: [String], release: [SuiteRun], candidate: [SuiteRun]) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    firsts := [Compared]{}
    judged := [[SuiteRow]]{}
    seen := [String: Bool]{}
    lines := [String]{}
    loop (index, suite) in kit {
        files.write(files.join(ctx.work, "evidence/kit-release-{suite}.json"), rows_json(release[index].rows)) ?? ()
        files.write(files.join(ctx.work, "evidence/kit-candidate-{suite}.json"), rows_json(candidate[index].rows)) ?? ()
        column: judged_release(release[index].rows, candidate[index].rows)
        compared: compare_suites(column, candidate[index].rows, [SuiteRow]{}, ctx.dispositions)
        judged.push(column.copy())
        firsts.push(compared.copy())
        if release[index].error != "" || candidate[index].error != "" -> next
        loop lost in compared.lost {
            if seen.has_key(lost.id) -> next
            seen[lost.id.copy()] = true
            lines.push(lost.id.copy())
        }
        loop item in compared.untracked {
            if item.status != "TIMEOUT" || seen.has_key(item.id) -> next
            seen[item.id.copy()] = true
            lines.push(item.id.copy())
        }
    }
    again := SuiteRun{rows: [SuiteRow]{}, error: ""}
    if lines.len() > 0 {
        ids: files.join(ctx.work, "kit/retry.txt")
        files.write(ids, keys_text(lines)) ?? ()
        again = suite_run(ctx, "candidate", CORPORA_PROFILE, "retry", [String]{"--cases={ids}"})
    }
    loop (index, suite) in kit {
        if release[index].error != "" || candidate[index].error != "" {
            parts := [String]{}
            if release[index].error != "" -> parts.push("release: {release[index].error}")
            if candidate[index].error != "" -> parts.push("candidate: {candidate[index].error}")
            row(ctx, "suite:{suite}", "BLOCKED", parts.join("; "))
            next
        }
        compared := firsts[index].copy()
        retried: suite_part(again, suite)
        if retried.rows.len() > 0 -> compared = compare_suites(judged[index], candidate[index].rows, retried.rows, ctx.dispositions)
        compared.flaky.extend(reused_flaky(ctx.reused_failures, candidate[index].rows, suite, ctx.dispositions))
        ctx.suites.push(SuiteResult{suite: suite.copy(), compared: compared.copy()})
        open := [LostRow]{}
        loop lost in compared.lost {
            if !lost.disposed -> open.push(lost.copy())
        }
        taken: judged[index].len() - release[index].rows.len()
        summary: "{compared.rows} rows ({taken} not run on the release: release-column): {compared.gained.len()} gained, {compared.lost.len()} lost ({compared.lost.len() - open.len()} dispositioned), {compared.added.len()} new passing, {compared.flaky.len()} passed on retry"
        if open.len() > 0 {
            row(ctx, "suite:{suite}", "FAIL", "{summary}; lost without a disposition: {lost_shown(open, 6)}")
        } else {
            row(ctx, "suite:{suite}", "PASS", summary)
        }
        // Every untracked failure is listed in REPORT.md; any one fails.
        untracked: untracked_row(suite, compared)
        row(ctx, untracked.check, untracked.status, untracked.detail)
        flaked: flaky_row(suite, compared)
        row(ctx, flaked.check, flaked.status, flaked.detail)
    }
}

// The registries suite of COMMIT: Tools/agent/CompilerRegistries.jet, run by
// s2 in the dev shell from this checkout (it exports COMMIT and runs the
// export's copy), pins the manifest of every registry under Compiler/*/Tests
// and the kit's cases entry, then runs every entry with s2. Every entry must
// pass (registries_verdict), as in Tools/agent/VerifyFull.jet. A --filter run
// narrows the kit suites and runs none of it.
registries_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    check: "suite:{REGISTRY_SUITE}"
    if ctx.options.filter != "" {
        why: "not run: --filter {ctx.options.filter} narrows the kit suites, and a filtered run is never a release"
        row(ctx, check, "NOTE", why)
        return
    }
    dir: files.join(ctx.work, "registries")
    manifest: files.join(dir, "manifest.json")
    receipt: files.join(dir, "receipt.json")
    script: files.join(ctx.root, "Tools/agent/CompilerRegistries.jet")
    log: files.join(ctx.work, "logs/registries.log")
    vars: with_vars(ctx.vars, [Var]{set_var("JET_COMPILER_IDENTITY", ctx.candidate.identity), set_var("JET_TOOLCHAIN_ROOT", ctx.tree)})
    pinned: run_logged(in_dev_shell(ctx.candidate.jet, ctx.tree, false, [String]{ctx.candidate.jet.copy(), script, "manifest", ctx.sha.copy(), "--out", dir}), ctx.root, vars, log, 3600)
    if pinned.rc != 0 {
        why: "CompilerRegistries.jet manifest {short(ctx.sha, 10)} rc={pinned.rc}{if pinned.timed_out -> " (timed out)" else -> ""}: {tail_of(log, 3)}"
        row(ctx, check, "FAIL", why)
        return
    }
    ran: run_logged(in_dev_shell(ctx.candidate.jet, ctx.tree, false, [String]{ctx.candidate.jet.copy(), script, "run", "--jet", ctx.candidate.jet.copy(), "--manifest", manifest, "--receipt", receipt}), ctx.root, vars, log, 12 * 3600, true)
    verdict: registries_verdict(read_text(receipt) ?? "", ctx.sha)
    row(ctx, check, verdict.status, "{verdict.detail}{if ran.timed_out -> " (timed out)" else -> ""}; log {log}")
}

// The registries row of a CompilerRegistries.jet receipt `text` for COMMIT
// `sha`: PASS only when it pins `sha` and every one of its entries passed.
registries_verdict: fn(text: String, sha: String) -> (status: String, detail: String) Never! {
    receipt: json.parse(text) ?? return (status: "FAIL", detail: "no registry receipt: {err}")
    head: text_field(receipt, "head")
    if head != sha -> return (status: "FAIL", detail: "the registry receipt pins {if head == "" -> "no commit" else -> head}, not {sha}")
    entries: array_field(receipt, "entries")
    failing := [String]{}
    loop entry in entries {
        status: text_field(entry, "status")
        if status != "PASS" -> failing.push("{text_field(entry, "id")} {status}")
    }
    total: int_field(receipt, "total") ?? -1
    passed: int_field(receipt, "passed") ?? -1
    if text_field(receipt, "status") == "PASS" && entries.len() > 0 && total == entries.len() && passed == total && failing.len() == 0 {
        return (status: "PASS", detail: "{total} registry entries pass")
    }
    shown: if failing.len() > 6 -> "{failing[0..<6].join(" | ")} | ..." else -> failing.join(" | ")
    (status: "FAIL", detail: "{passed} of {total} registry entries pass ({entries.len()} listed, status {text_field(receipt, "status")}){if failing.len() > 0 -> "; not passing: {shown}" else -> ""}")
}

// The train speed gate (#5479 c5) and the compile-throughput record (#5479
// c1) of every release, on COMMIT's compiler corpus with
// Tools/perf/compile-throughput/Throughput.jet, run by s2 in the dev shell.
// `--against` compiles the corpus SPEED_RUNS rounds at the default level with
// the chain's seed and with s2, alternating which goes first, and fails a rise
// over 10% in CPU, user-mode instructions or a top-level phase's process CPU;
// an INCONCLUSIVE verdict is never a pass. Then s2 compiles the corpus once
// in each SPEED_CELL_MODES mode. Every compile is a row of
// evidence/throughput.tsv, the ledger the release ships. A --filter run
// measures nothing.
SPEED_TOOL: "Tools/perf/compile-throughput/Throughput.jet"
SPEED_GATE_MODES: "default"
SPEED_RUNS: 3
SPEED_CELL_MODES: "check,O0,release"

speed_stage: fn(ctx: &Ctx) Never! -[Env, Exec, FS, IO, Time, Time.Wait]> {
    if ctx.options.filter != "" {
        row(ctx, "speed", "NOTE", "not measured: --filter {ctx.options.filter} narrows the gate, and a filtered run is never a release")
        return
    }
    work: files.join(ctx.work, "speed")
    log: files.join(ctx.work, "logs/speed.log")
    tool: files.join(ctx.tree, SPEED_TOOL)
    vars: with_vars(ctx.vars, [Var]{set_var("JET", ctx.candidate.jet), set_var("JET_COMPILER_IDENTITY", ctx.candidate.identity), set_var("JET_TOOLCHAIN_ROOT", ctx.tree)})
    shared := [String]{"--tree", ctx.tree.copy(), "--out", files.join(ctx.work, "evidence/throughput.tsv")}
    if sys.get("SLOT_CPUS") == .Val(cpus) && cpus != "" -> shared.extend([String]{"--cpus", cpus.copy()})
    gate_args := [String]{ctx.candidate.jet.copy(), tool.copy(), "--against", ctx.release.jet.copy(), "--modes", SPEED_GATE_MODES, "--runs", "{SPEED_RUNS}", "--work", files.join(work, "gate")}
    gate_args.extend(shared.copy())
    gate: run_logged(in_dev_shell(ctx.candidate.jet, ctx.tree, true, gate_args), ctx.tree, vars, log, 4 * 3600)
    text: read_text(log) ?? ""
    said: speed_detail(text)
    status: if gate.rc == 0 && said.verdict == "PASS" -> "PASS" else -> "FAIL"
    timed: if gate.timed_out -> " (timed out)" else -> ""
    if said.verdict == "" && text.contains("cannot run --perf") {
        row(ctx, "speed", "FAIL", "no `perf` in the dev shell: the gate counts each compile's instructions:u with `perf stat`, and runs in COMMIT's dev shell (Tools/agent/JetEnv.jet), whose flake.nix default shell must list pkgs.perf; enter it (`nix develop`) and check `perf --version`, then rerun admit; log {log}")
        remove_tree(work)
        return
    }
    row(ctx, "speed", status, "s2 against {ctx.release.name}, {SPEED_GATE_MODES} level, {SPEED_RUNS} rounds: {if said.verdict == "" -> "no verdict, rc={gate.rc}{timed}: {tail_of(log, 3)}" else -> said.detail}; log {log}")
    cell_args := [String]{ctx.candidate.jet.copy(), tool.copy(), "--modes", SPEED_CELL_MODES, "--runs", "1", "--work", files.join(work, "cell")}
    cell_args.extend(shared.copy())
    cell: run_logged(in_dev_shell(ctx.candidate.jet, ctx.tree, true, cell_args), ctx.tree, vars, log, 2 * 3600, true)
    passed: if cell.rc == 0 -> "PASS" else -> "FAIL"
    said_cell: if cell.rc == 0 -> "s2 compiled the compiler corpus once at each of {SPEED_CELL_MODES}; every compile is a row of evidence/throughput.tsv" else -> "a {SPEED_CELL_MODES} compile of the compiler corpus by s2 failed, rc={cell.rc}{if cell.timed_out -> " (timed out)" else -> ""}: {tail_of(log, 3)}"
    row(ctx, "throughput", passed, said_cell)
    remove_tree(work)
}

// The verdict of a Throughput.jet --against log `text` (its last `speed
// gate:` line, "" when there is none) and the row's detail, from the gate
// table (the rows under its `mode quantity` header, up to a blank line): the
// CPU change of each mode, then every quantity that failed or could not be
// judged.
speed_detail: fn(text: String) -> (verdict: String, detail: String) Never! {
    verdict := ""
    in_gate := false
    cpu := [String]{}
    flagged := [String]{}
    loop line in text.split("\n").to_list() {
        if line.starts_with("speed gate: ") {
            verdict = line.slice(12..<line.len()).trim().copy()
            next
        }
        words := [String]{}
        loop word in line.split(" ") {
            if word != "" -> words.push(word.copy())
        }
        if words.len() >= 2 && words[0] == "mode" && words[1] == "quantity" {
            in_gate = true
            next
        }
        if words.len() == 0 -> in_gate = false
        if !in_gate || words.len() < 7 -> next
        if words[1] == "cpu" -> cpu.push("{words[0]} CPU {words[2]} -> {words[3]} s ({words[4]})")
        // A phase's quantity is two words (`phase KIND`), so its verdict is one further.
        status_at: if words[1] == "phase" -> 7 else -> 6
        if words.len() > status_at && (words[status_at] == "FAIL" || words[status_at] == "INCONCLUSIVE") -> flagged.push(words.join(" "))
    }
    shown: if flagged.len() > 6 -> "{flagged[0..<6].join(" | ")} | ..." else -> flagged.join(" | ")
    detail := "speed gate {if verdict == "" -> "missing" else -> verdict}"
    if cpu.len() > 0 -> detail = "{detail}, {cpu.join(", ")}"
    if flagged.len() > 0 -> detail = "{detail}; {shown}"
    (verdict: verdict, detail: detail)
}

// Who owns a flaky row: its disposition; with none, a row whose retry
// passed fails the gate, and a row still failing is owned by that line.
flaky_owner: fn(found: LostRow) -> String Never! {
    if found.disposed -> return "{found.disposition.card}: {found.disposition.reason}"
    if passes(found.now) -> return "no disposition: fails the gate"
    "owned by its {found.now} line"
}

// The reused run's failures of `suite` the run again passed: flaky, its
// first outcome the prior run's.
reused_flaky: fn(failures: [SuiteRow], rows: [SuiteRow], suite: String, dispositions: [Disposition]) -> [LostRow] Never! {
    now: index_rows(rows)
    out := [LostRow]{}
    loop first in failures {
        if first.suite != suite -> next
        if now.at.get(row_key(first.suite, first.id, first.tier)) == .Val(at) && passes(rows[at].status) -> out.push(flaky_of(first, rows[at], dispositions))
    }
    out
}

// The dispositions that track no row, lost, carded or flaky: a typo in a
// case ID or tier must not pass unseen.
unused_dispositions: fn(dispositions: [Disposition], suites: [SuiteResult]) -> [String] Never! {
    unused := [String]{}
    loop entry in dispositions {
        used := false
        loop result in suites {
            loop lost in result.compared.lost {
                if lost.disposed && same_disposition(lost.disposition, entry) -> used = true
            }
            loop carded in result.compared.carded {
                if same_disposition(carded.disposition, entry) -> used = true
            }
            loop flaked in result.compared.flaky {
                if flaked.disposed && same_disposition(flaked.disposition, entry) -> used = true
            }
        }
        if !used -> unused.push("{entry.suite} {entry.id} {entry.tier} {entry.card}")
    }
    unused
}

// A WARN row naming every disposition that tracks no row.
disposition_note: fn(ctx: &Ctx) Never! -[FS, IO, Time]> {
    unused: unused_dispositions(ctx.dispositions, ctx.suites)
    if unused.len() > 0 -> row(ctx, "dispositions", "WARN", "{unused.len()} disposition(s) match no lost row, no row failing alike on both columns and no flaky row: {unused.join(" | ")}")
}

Resolution: struct {
    path: String
    pick: String
}

MergePlan: struct {
    checkout: String
    conflicts: [String]
    resolutions: [Resolution]
    fast_forward: Bool
    origin: String
    error: String
}

merge_plan: fn(ctx: Ctx) -[Exec, Time.Wait]> MergePlan Never! {
    plan := MergePlan{checkout: "", conflicts: [String]{}, resolutions: [Resolution]{}, fast_forward: false, origin: "", error: ""}
    loop block in git_in(ctx.root, [String]{"worktree", "list", "--porcelain"}).out.split("\n\n").to_list() {
        if plan.checkout == "" && line_value(block, "branch ") == "refs/heads/master" -> plan.checkout = line_value(block, "worktree ")
    }
    merged: git_in(ctx.root, [String]{"merge-tree", "--write-tree", "--name-only", "refs/heads/master", ctx.sha})
    if {
        merged.rc == 1 -> plan.conflicts = merge_tree_conflicts(merged.out)
        merged.rc != 0 -> plan.error = "git merge-tree failed: {merged.err}"
    }
    loop path in plan.conflicts {
        // Dev already carries master's version when that blob appears in
        // dev's history of the path: the dev side is the newer edit of the
        // same text.
        ours: git_in(ctx.root, [String]{"rev-parse", "--verify", "-q", "refs/heads/master:{path}"}).out
        carried := false
        if ours != "" {
            loop commit in git_in(ctx.root, [String]{"log", "--format=%H", ctx.sha, "--", path}).out.split("\n").to_list() {
                if commit != "" && git_in(ctx.root, [String]{"rev-parse", "--verify", "-q", "{commit}:{path}"}).out == ours {
                    carried = true
                    break
                }
            }
        }
        plan.resolutions.push(Resolution{path: path.copy(), pick: if carried -> "dev" else -> "by hand"})
    }
    plan.origin = git_in(ctx.root, [String]{"rev-parse", "--verify", "-q", "refs/remotes/origin/master"}).out
    // The release merges dev into master (--no-ff): master carries board commits
    // dev lacks, so dev never fast-forwards it. The merge's first parent is local
    // master, so pushing it fast-forwards origin/master when local master holds it.
    plan.fast_forward = plan.origin == "" || git_in(ctx.root, [String]{"merge-base", "--is-ancestor", plan.origin, "refs/heads/master"}).rc == 0
    plan
}

Gains: struct {
    suites: Int
    jetpack: Int
    total: Int
}

gains_of: fn(ctx: Ctx) -> Gains Never! {
    gained := 0
    loop result in ctx.suites -> gained += result.compared.gained.len()
    Gains{suites: gained, jetpack: ctx.jetpack_fixed.len(), total: gained + ctx.jetpack_fixed.len()}
}

all_lost: fn(ctx: Ctx) -> [LostRow] Never! {
    out := [LostRow]{}
    loop result in ctx.suites -> out.extend(result.compared.lost.copy())
    out
}

report: fn(ctx: Ctx, verdict: String, plan: MergePlan) -> String Never! {
    gains: gains_of(ctx)
    filtered: if ctx.options.filter != "" -> " (filtered by \"{ctx.options.filter}\": not a release)" else -> ""
    lines := [String]{"# {ctx.next}: release gate of dev {short(ctx.sha, 10)}", "", "Verdict: {verdict}{filtered}", "Seed: {ctx.release.name} ({ctx.release.identity})"}
    lines.push("Release column: {column_text(ctx.baseline.name, ctx.baseline.identity, ctx.baseline.jet, ctx.baseline.jet_sha, ctx.baseline.commit)}")
    if ctx.built {
        lines.push("Candidate: {ctx.candidate.identity}")
        lines.push("Candidate source: {if ctx.source == "" -> "unknown" else -> ctx.source}")
        lines.push("Candidate column: {column_text("s2", ctx.candidate.identity, ctx.candidate.jet, ctx.candidate.sha, ctx.sha)}")
    }
    lines.extend([String]{"", "| check | status | detail |", "|---|---|---|"})
    loop found in ctx.rows -> lines.push("| {found.check} | {found.status} | {found.detail.replace("|", "\\|")} |")
    lines.extend([String]{"", "Gains: {gains.total} ({gains.suites} suite rows, {gains.jetpack} Jetpack census rows)"})
    loop result in ctx.suites {
        compared: result.compared
        if compared.gained.len() > 0 {
            lines.extend([String]{"", "## {result.suite}: gained"})
            loop (index, found) in compared.gained {
                if index < 200 -> lines.push("- {found.id} {found.tier}: {found.was} -> {found.status}")
            }
        }
        if compared.lost.len() > 0 {
            lines.extend([String]{"", "## {result.suite}: lost"})
            loop found in compared.lost {
                why: if found.disposed -> " ({found.disposition.card}: {found.disposition.reason})" else -> " (no disposition)"
                lines.push("- {found.id} {found.tier}: {found.was} -> {found.now}{why}")
            }
        }
        if compared.untracked.len() > 0 {
            lines.extend([String]{"", "## {result.suite}: untracked failures"})
            loop found in compared.untracked -> lines.push("- {found.id} {found.tier}: {found.status} {short(found.detail.partition("\n").head, 160)}")
        }
        if compared.carded.len() > 0 {
            lines.extend([String]{"", "## {result.suite}: failing on both columns, tracked by a disposition"})
            loop found in compared.carded -> lines.push("- {found.id} {found.tier}: {found.now} on both ({found.disposition.card}: {found.disposition.reason}) {short(found.detail.partition("\n").head, 160)}")
        }
        if compared.flaky.len() > 0 {
            lines.extend([String]{"", "## {result.suite}: flaky, failed and then retried"})
            loop found in compared.flaky {
                owner: flaky_owner(found)
                lines.push("- {found.id} {found.tier}: {found.was} then {found.now} on retry ({owner}) {short(found.detail.partition("\n").head, 160)}")
            }
        }
    }
    if ctx.jetpack_fixed.len() > 0 {
        lines.extend([String]{"", "## Jetpack census: fixed"})
        loop (index, key) in ctx.jetpack_fixed {
            if index < 200 -> lines.push("- {key.replace("\t", ": ")}")
        }
    }
    resolutions := [String]{}
    loop found in plan.resolutions -> resolutions.push("{found.path} (take {found.pick})")
    lines.extend([String]{"", "## Master merge", "- predicted conflicts: {if plan.conflicts.len() > 0 -> resolutions.join(", ") else -> "none"}"})
    lines.push(if plan.fast_forward -> "- push: the merge of {short(ctx.sha, 10)} into master fast-forwards origin/master" else -> "- push: origin/master {short(plan.origin, 10)} is not an ancestor of local master; update master from origin before the merge")
    "{lines.join("\n")}\n"
}

text_dyn: fn(value: String) -> Dyn Never! { Dyn.Text(value.copy()) }

strings_dyn: fn(values: [String]) -> Dyn Never! {
    out := [Dyn]{}
    loop value in values -> out.push(text_dyn(value))
    Dyn.Array(out)
}

plan_dyn: fn(plan: MergePlan) -> Dyn Never! {
    resolutions := [Dyn]{}
    loop found in plan.resolutions -> resolutions.push(Dyn.Object([String: Dyn]{"path": text_dyn(found.path), "take": text_dyn(found.pick)}))
    entry := [String: Dyn]{"checkout": text_dyn(plan.checkout), "conflicts": strings_dyn(plan.conflicts), "resolutions": Dyn.Array(resolutions), "fastForward": Dyn.Bool(plan.fast_forward), "origin": text_dyn(plan.origin)}
    if plan.error != "" -> entry["error"] = text_dyn(plan.error)
    Dyn.Object(entry)
}

// RELEASE.json: the admission record Tools/release reads back
// (Receipts.jet parse_admission_receipt, Gate.jet admission_problems).
release_record: fn(ctx: Ctx, plan: MergePlan, summary: String, scope: String, created: String) -> Dyn Never! {
    gains: gains_of(ctx)
    checks := [Dyn]{}
    loop found in ctx.rows -> checks.push(Dyn.Object([String: Dyn]{"check": text_dyn(found.check), "status": text_dyn(found.status), "detail": text_dyn(found.detail)}))
    lost := [Dyn]{}
    loop found in all_lost(ctx) -> lost.push(Dyn.Object([String: Dyn]{"suite": text_dyn(found.suite), "case": text_dyn(found.id), "tier": text_dyn(found.tier), "was": text_dyn(found.was), "now": text_dyn(found.now), "card": text_dyn(found.disposition.card), "reason": text_dyn(found.disposition.reason)}))
    Dyn.Object([String: Dyn]{
        "schema": text_dyn("jet-release/v1"),
        "name": text_dyn(ctx.next),
        "commit": text_dyn(ctx.sha),
        "verdict": text_dyn("PASS"),
        "scope": text_dyn(scope),
        "created": text_dyn(created),
        "identity": text_dyn(ctx.candidate.identity),
        "target": text_dyn(host_target()),
        "chain": Dyn.Object([String: Dyn]{"s2": text_dyn(ctx.candidate.s2), "s3": text_dyn(ctx.candidate.s3)}),
        "seed": Dyn.Object([String: Dyn]{"name": text_dyn(ctx.release.name), "identity": text_dyn(ctx.release.identity)}),
        "summary": text_dyn(summary),
        "gains": Dyn.Object([String: Dyn]{"suites": Dyn.Int(gains.suites), "jetpack": Dyn.Int(gains.jetpack), "total": Dyn.Int(gains.total)}),
        "checks": Dyn.Array(checks),
        "lost": Dyn.Array(lost),
        "merge": plan_dyn(plan),
    })
}

Assembled: struct {
    dest: String
    summary: String
    scope: String
}

write_all: fn(writes: [(path: String, text: String)]) -[FS]> String? Never! {
    loop entry in writes {
        files.write(entry.path, entry.text) ?? return Val("cannot write {entry.path}: {err}")
    }
    None
}

assembly: fn(text: String) -> Problem Never! { problem(INPUT, text) }

assemble: fn(ctx: Ctx, plan: MergePlan) -[Env, Exec, FS, Time, Time.Wait]> Assembled Problem! {
    gains: gains_of(ctx)
    lost: all_lost(ctx)
    created: "{time.isoformat(time.now_utc())}Z"
    date: short(created, 10)
    scope: if ctx.options.filter != "" -> "filtered: {ctx.options.filter}" else -> "full"
    summary: if ctx.options.summary != "" -> ctx.options.summary.copy() else -> "{gains.total} gains over {ctx.baseline.name}"
    dest: files.join(ctx.seeds, ctx.next)
    temp: files.join(ctx.seeds, ".{ctx.next}.assembling-{sys.pid()}")
    remove_tree(temp)
    files.create_dir_all(temp) ?? return Err(assembly("cannot create {temp}: {err}"))
    copy_file(ctx.candidate.jet, files.join(temp, "jet"), true) ?? return Err(assembly("cannot copy jet into {temp}: {err}"))
    link_compiler_aliases(temp) ?? return Err(assembly("cannot link the compiler aliases in {temp}: {err}"))
    if !copy_tree(ctx.candidate.runtime, files.join(temp, "jet-runtime")) -> return Err(assembly("cannot copy {ctx.candidate.runtime} into {temp}"))
    if ctx.candidate.jetpack != "" -> copy_file(ctx.candidate.jetpack, files.join(temp, "jetpack"), true) ?? return Err(assembly("cannot copy jetpack into {temp}: {err}"))
    cards := [String]{}
    loop found in lost {
        if !cards.contains(found.disposition.card) -> cards.push(found.disposition.card.copy())
    }
    lost_cards: if lost.len() > 0 -> " ({cards.join(", ")})" else -> ""
    engine: if ctx.candidate.jetpack != "" -> "; jetpack engine built by s2" else -> ""
    verified: "self-host chain from {ctx.release.name} without Rust reaches the fixed point s2 == s3 (jet {short(ctx.candidate.sha, 16)}); runtime pack rebuilt by s2 is byte-identical; golden/ui/cases {gains.suites} rows gained, {lost.len()} lost{lost_cards}; {ctx.jetpack_summary}{engine}"
    // The pinned assets (the C toolchain pack, the bubblewrap) sit beside jet,
    // where jet looks first; they stay out of SHA256SUMS because jet checks
    // each against the hash it embeds.
    loop path in ctx.pinned {
        // The pack is data; the bubblewrap is a program jet runs.
        copy_file(path, files.join(temp, files.basename(path)), !path.ends_with(".tar.zst")) ?? return Err(assembly("cannot copy {path} into {temp}: {err}"))
    }
    body: "Verified {short(ctx.sha, 10)}: {verified}.\n\nIdentity {ctx.candidate.identity}.\n\nEvidence: RELEASE.md and RELEASE.json in the {ctx.next} seed directory."
    // jet-use installs a release from its current.env, so it waits in the
    // work directory and reaches dest only once the release is published.
    env_text: "# Newest verified self-hosted compiler (written by Tools/release admit; jet-use installs it).\nLABEL=\"{ctx.next} (dev {short(ctx.sha, 9)}, {date}, verified: s2 == s3 {short(ctx.candidate.sha, 16)}, no Rust; {gains.total} gains, {lost.len()} lost over {ctx.baseline.name})\"\nJET={dest}/jet\nJET_IDENTITY={ctx.candidate.identity}\n"
    failed: write_all([(path: String, text: String)]{
        (path: files.join(temp, "IDENTITY"), text: "{ctx.candidate.identity}\n"),
        (path: files.join(temp, "RELEASE"), text: "{ctx.next}\n"),
        (path: files.join(temp, "VERSION"), text: "{ctx.next} {ctx.sha} {date}\n"),
        (path: files.join(temp, "SOURCE"), text: "{ctx.sha} (dev, {ctx.next}: self-hosted s2 of {short(ctx.sha, 9)} from seed {ctx.release.name}; {verified}; Tools/release admit {date})\n"),
        (path: files.join(ctx.work, "current.env"), text: env_text),
        (path: files.join(temp, "MERGE_MSG"), text: "Merge dev: {ctx.next} {summary}\n\n{body}\n"),
        (path: files.join(temp, "TAG_MSG"), text: "{ctx.next}: {summary}\n\n{body}\n"),
    })
    if failed == .Val(why) -> return Err(assembly(why))
    if !copy_tree(files.join(ctx.work, "evidence"), files.join(temp, "evidence")) -> return Err(assembly("cannot copy the evidence into {temp}"))
    chain_files: [String]{"RESULT", "REPORT.md"}
    loop name in chain_files {
        path: files.join(files.join(ctx.work, "chain"), name)
        if files.exists(path) -> copy_file(path, files.join(temp, "evidence/chain-{name}"), false) ?? return Err(assembly("cannot copy {path}: {err}"))
    }
    record: json.to_string_pretty(release_record(ctx, plan, summary, scope, created)) ?? return Err(assembly("RELEASE.json cannot be encoded: {err}"))
    again: write_all([(path: String, text: String)]{
        (path: files.join(temp, "RELEASE.json"), text: "{record}\n"),
        (path: files.join(temp, "RELEASE.md"), text: report(ctx, "PASS", plan)),
        (path: files.join(temp, "SHA256SUMS"), text: sums_text(shipped_artifacts(temp))),
    })
    if again == .Val(why) -> return Err(assembly(why))
    if files.exists(dest) -> return Err(assembly("{dest} appeared while assembling; {temp} is left for inspection"))
    files.rename(temp, dest) ?? return Err(assembly("cannot move {temp} to {dest}: {err}"))
    Ok(Assembled{dest: dest, summary: summary, scope: scope})
}

Published: struct {
    ok: Bool
    tagged: Bool
    pushed: Bool
    step: String
    detail: String
    log: String
    left: [String]
}

// The publication of an assembled release (the header's Pass): each step
// runs only after the one before succeeds, its output in logs/publish.log.
// The new jet runs Tools/release/Main.jet from this checkout, and is the
// `jet` that tool finds on PATH.
publish_release: fn(ctx: Ctx, dest: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Published Never! {
    log: files.join(ctx.work, "logs/publish.log")
    vars: [Var]{set_var("PATH", "{dest}:{process.env_nonempty("PATH") ?? ""}"), set_var("JET_COMPILER_IDENTITY", ctx.candidate.identity), drop_var("JET"), drop_var("JET_TOOLCHAIN_ROOT")}
    release: [String]{files.join(dest, "jet"), "run", "Tools/release/Main.jet", "--"}
    steps: [(name: String, argv: [String])]{
        (name: "fetch origin dev", argv: [String]{"git", "-C", ctx.root.copy(), "fetch", "--quiet", "origin", "+refs/heads/dev:refs/remotes/origin/dev"}),
        (name: "on origin/dev", argv: [String]{"git", "-C", ctx.root.copy(), "merge-base", "--is-ancestor", ctx.sha.copy(), "refs/remotes/origin/dev"}),
        (name: "tag", argv: [String]{"git", "-C", ctx.root.copy(), "tag", "-a", ctx.next.copy(), "-F", files.join(dest, "TAG_MSG"), ctx.sha.copy()}),
        (name: "push tag", argv: [String]{"git", "-C", ctx.root.copy(), "push", "origin", ctx.next.copy()}),
        (name: "candidate", argv: joined(release, [String]{"candidate", dest.copy()})),
        (name: "publish", argv: joined(release, [String]{"publish", dest.copy()})),
    }
    state := Published{ok: false, tagged: false, pushed: false, step: "", detail: "", log: log.copy(), left: [String]{}}
    loop (index, step) in steps {
        shown: step.argv.join(" ")
        say("release", ctx.log, "publish: {shown}")
        files.append_all(log, "$ {shown}\n") ?? ()
        code: run_logged(step.argv, ctx.root, vars, log, 0, append: true).rc
        if code != 0 {
            state.step = step.name.copy()
            state.detail = if step.name == "on origin/dev" -> "{short(ctx.sha, 10)} is not on origin/dev; push dev first" else -> "exit {code}: {tail_of(log, 3)}"
            loop later in steps[index..<steps.len()] -> state.left.push(later.argv.join(" "))
            return state
        }
        if step.name == "tag" -> state.tagged = true
        if step.name == "push tag" -> state.pushed = true
    }
    state.ok = true
    state
}

print_commands: fn(ctx: Ctx, dest: String, plan: MergePlan) Never! -[IO]> {
    lines := [String]{}
    if ctx.options.filter != "" {
        lines.extend([String]{"FILTERED RUN (--filter {ctx.options.filter}): {ctx.next} is not a release and was neither tagged nor published. Do not run these commands; jet-use refuses it.", ""})
    } else {
        lines.extend([String]{"PASS: {dest} is admitted: tag {ctx.next} is on origin and published as its GitHub release; current still points at {ctx.release.name}. Commands for Main:", ""})
    }
    lines.push("  jet-use {ctx.next}")
    lines.push("  # without jet-use: ln -sfn {ctx.next} {ctx.seeds}/current.new && mv -T {ctx.seeds}/current.new {ctx.seeds}/current && cp {dest}/current.env {ctx.seeds}/current.env")
    lines.push("  cd {if plan.checkout != "" -> plan.checkout else -> "<the checkout of master>"}")
    lines.push("  git merge --no-ff -F {dest}/MERGE_MSG {ctx.sha}")
    if plan.conflicts.len() > 0 {
        loop found in plan.resolutions {
            lines.push(if found.pick == "dev" -> "  git checkout --theirs -- '{found.path}' && git add -- '{found.path}'   # dev already carries master's version and edits it later" else -> "  # resolve '{found.path}' by hand, then git add it")
        }
        lines.push("  git commit --no-edit")
    }
    lines.push(if plan.fast_forward -> "  git push origin master" else -> "  # local master lacks origin/master {short(plan.origin, 10)}: run git merge --ff-only origin/master before the merge above, then git push origin master; never force-push master.")
    print(lines.join("\n"))
}

release_names: fn(seeds: String) -[FS]> [String] Never! {
    names := [String]{}
    entries: files.list_dir(seeds) ?? return names
    loop entry in entries -> names.push(entry.name.copy())
    names
}

// The run's context in its work directory `work`, before any stage.
new_ctx: fn(options: AdmitOptions, pre: Pre, work: String) -[FS]> Ctx Never! {
    Ctx{
        options: options.copy(), root: pre.root.copy(), seeds: pre.seeds.copy(), work_root: pre.work_root.copy(), work: work.copy(),
        sha: pre.sha.copy(), source: "", release: pre.release.copy(), baseline: pre.baseline.copy(),
        vars: [Var]{set_var("TMPDIR", files.join(work, "tmp")), drop_var("JET")}, native: pre.native.copy(),
        dispositions: pre.dispositions.copy(), next: next_release_name(release_names(pre.seeds)),
        tree: files.join(work, "tree"), release_tree: files.join(work, "release-tree"), log: files.join(work, "release.log"),
        built: false, candidate: Built{jet: "", runtime: "", sha: "", identity: "", jetpack: "", s2: "", s3: ""},
        pinned: [String]{}, jetpack_fixed: [String]{}, jetpack_summary: "", suites: [SuiteResult]{}, rows: [GateRow]{},
    }
}

run_gate: fn(options: AdmitOptions, pre: Pre) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    work: files.join(pre.work_root, short(pre.sha, 12))
    remove_tree(work)
    work_dirs: [String]{"logs", "evidence", "kit", "tmp"}
    loop dir in work_dirs -> files.create_dir_all(files.join(work, dir)) ?? ()
    ctx := new_ctx(options, pre, work)
    say("release", ctx.log, "release gate of {short(ctx.sha, 10)}: chain seed {ctx.release.name}; release column {column_text(ctx.baseline.name, ctx.baseline.identity, ctx.baseline.jet, ctx.baseline.jet_sha, ctx.baseline.commit)}; next name {ctx.next}; work {work}")
    if export_commit(ctx.root, ctx.sha, ctx.tree) == .Val(why) {
        term.eprint("admit: {why}")
        return 2
    }
    // The release prints the version its tree declares, so that version must be the release's name.
    declared: tree_jet_version(ctx.tree)
    if declared != ctx.next {
        term.eprint("admit: {short(ctx.sha, 10)} declares JET_VERSION `{declared}` in {JET_VERSION_SOURCE}, but the next release is {ctx.next}; set it to \"{ctx.next}\" on dev first")
        return 2
    }
    // The compiler source identity a train's census receipt records for the same sources, which --reuse matches.
    ctx.source = source_identity(ctx.root, ctx.release.dir, ctx.tree)
    say("release", ctx.log, "compiler source of {short(ctx.sha, 10)}: {if ctx.source == "" -> "unknown (Tools/agent/CompilerPackages.jet identity failed)" else -> ctx.source}")
    files.write(files.join(ctx.tree, ".chain-base"), "{ctx.sha}\n") ?? ()
    if export_commit(ctx.root, ctx.baseline.commit, ctx.release_tree) == .Val(why) {
        term.eprint("admit: {why}")
        return 2
    }
    if gate_preflight(ctx) == .Val(refused) {
        remove_tree(ctx.tree)
        remove_tree(ctx.release_tree)
        term.eprint("admit: preflight refused: {refused}. Report: {files.join(work, "REPORT.md")}")
        return 2
    }
    chain_stage(ctx)
    candidate_preflight(ctx)
    cc_pack_stage(ctx)
    bwrap_stage(ctx)
    // A fresh gate starts the candidate's rows as soon as the chain, cc-pack, bwrap
    // and the jetpack engine that serves them pass, so they run beside pack
    // and jetpack, in --shards kit processes with the slot to themselves
    // that each run every suite in one pool, so no suite waits for another's
    // slowest shard. When pack or jetpack fails, the gate waits for those
    // rows and judges none. The release column runs after them, on the rows
    // release_picks names from theirs.
    early: ctx.built && options.reuse == ""
    if ctx.built {
        hosted_stage(ctx)
    } else {
        blocked: [String]{"pack", "jetpack", "jetpack-engine"}
        loop check in blocked -> row(ctx, check, "BLOCKED", "no s2: the chain failed")
    }
    launch: early && failed_rows(ctx).len() == 0
    batch: if launch -> suite_batch(ctx, "candidate", CORPORA_PROFILE, "", [String]{}, options.shards) else -> SuiteBatch{labels: [String]{}, jobs: [Job]{}}
    finished := [Finished]{}
    task.group candidate_rows(limit: 1) {
        started: task run_batch(batch.jobs.copy())
        if ctx.built {
            pack_stage(ctx)
            jetpack_stage(ctx)
        }
        finished = started.join() ?? [Finished]{}
    }
    preflight := [Dyn]{}
    loop found in ctx.rows -> preflight.push(Dyn.Object([String: Dyn]{"check": text_dyn(found.check), "status": text_dyn(found.status), "detail": text_dyn(found.detail)}))
    files.write(files.join(work, "preflight.json"), "{json.to_string_pretty(Dyn.Object([String: Dyn]{"commit": text_dyn(ctx.sha), "rows": Dyn.Array(preflight)})) ?? "{{}}"}\n") ?? ()
    if failed_rows(ctx).len() > 0 {
        loop suite in ctx.native -> row(ctx, "suite:{suite}", "BLOCKED", "{if launch -> "not judged" else -> "not launched"}: the cheap checks above are not clean (preflight.json)")
        row(ctx, "speed", "BLOCKED", "not measured: the cheap checks above are not clean (preflight.json)")
    } else {
        if early {
            candidate: suite_rows(ctx, batch, finished)
            judge_columns(ctx, candidate)
            disposition_note(ctx)
        } else {
            reused_suites(ctx)
        }
        // Then the registries, and then the speed gate, each with the slot to
        // itself.
        registries_stage(ctx)
        speed_stage(ctx)
    }
    gains: gains_of(ctx)
    if failed_rows(ctx).len() == 0 -> row(ctx, "gains", if gains.total >= options.min_gains -> "PASS" else -> "FAIL", "{gains.total} gains ({gains.suites} suite rows, {gains.jetpack} Jetpack rows); --min-gains {options.min_gains}")
    plan: merge_plan(ctx)
    failed: failed_rows(ctx)
    verdict: if failed.len() == 0 -> "PASS" else -> "FAIL"
    files.write(files.join(work, "REPORT.md"), report(ctx, verdict, plan)) ?? ()
    scratch: [String]{ctx.tree, ctx.release_tree, files.join(work, "pack")}
    loop dir in scratch -> remove_tree(dir)
    if verdict != "PASS" {
        names := [String]{}
        loop found in failed -> names.push("{found.check} {found.status}")
        print("FAIL: {ctx.next} not released; {ctx.seeds} is unchanged. {names.join(", ")}. Report: {files.join(work, "REPORT.md")}")
        return 1
    }
    released: assemble(ctx, plan) ?? {
        print("FAIL: {ctx.next} not released: {err.text}")
        return 1
    }
    say("release", ctx.log, "assembled {released.dest}")
    if options.filter == "" {
        published: publish_release(ctx, released.dest)
        if !published.ok {
            why: "{ctx.next} not admitted: publication step \"{published.step}\" failed ({published.detail}); log {published.log}"
            if !published.pushed {
                if published.tagged {
                    _: git_in(ctx.root, [String]{"tag", "-d", ctx.next})
                }
                aside: files.join(ctx.seeds, ".{ctx.next}.unpublished-{sys.pid()}")
                files.rename(released.dest, aside) ?? ()
                print("FAIL: {why}. {ctx.seeds} has no {ctx.next}: the assembled release moved to {aside}.")
            } else {
                lines := [String]{"FAIL: {why}. Tag {ctx.next} is on origin, but {released.dest} is not admitted (no current.env): do not jet-use it.", "Once the cause is fixed, finish the publication from {ctx.root}, then admit it:"}
                loop command in published.left -> lines.push("  {command}")
                lines.push("  cp {files.join(work, "current.env")} {released.dest}/current.env")
                print(lines.join("\n"))
            }
            return 1
        }
    }
    copy_file(files.join(work, "current.env"), files.join(released.dest, "current.env"), false) ?? {
        print("FAIL: {ctx.next} is published but {released.dest}/current.env was not written: {err}")
        return 1
    }
    print_commands(ctx, released.dest, plan)
    0
}

admit_main: fn(args: [String], root: String) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    options: parse_admit_args(args)
    pre: preconditions(options, root)
    if pre.errors.len() > 0 {
        term.eprint(ADMIT_USAGE)
        loop error in pre.errors -> term.eprint("admit: {error}")
        return 2
    }
    columns: "chain seed: {pre.release.name} ({pre.release.identity})\nrelease column: {column_text(pre.baseline.name, pre.baseline.identity, pre.baseline.jet, pre.baseline.jet_sha, pre.baseline.commit)}"
    if !pre.admission.admitted {
        term.eprint("{columns}\n{pre.admission.text}")
        return 2
    }
    if options.check_gate {
        print("{columns}\n{pre.admission.text}")
        return 0
    }
    files.create_dir_all(pre.work_root) ?? ()
    // One release run at a time: the slot run below inherits the lock.
    held := false
    if sys.get("JET_RELEASE_LOCK_HELD") == None {
        lock_path: files.join(pre.work_root, "release.lock")
        _lock: files.lock(lock_path, Val(time.duration_ms(1))) ?? {
            term.eprint("admit: another release run holds {lock_path}")
            return 2
        }
        held = true
        return admit_in_slot(args, root, options, pre)
    }
    if held -> return 2
    admit_in_slot(args, root, options, pre)
}

// Runs the gate inside the release slot: unless JET_RELEASE_SLOT is set
// empty or a slot is held already, the current release runs this command
// again under `Tools/agent/Chain.jet slot --release`.
admit_in_slot: fn(args: [String], root: String, options: AdmitOptions, pre: Pre) -[Env, Exec, FS, IO, Time, Time.Wait]> Int Never! {
    if sys.get("JET_RELEASE_SLOT") != .Val("") && sys.get("SLOT_CPUS") == None {
        argv := [String]{pre.release.jet.copy(), files.join(root, "Tools/agent/Chain.jet"), "slot", "--release", "--", pre.release.jet.copy(), "run", files.join(root, "Tools/release/Main.jet"), "--", "admit"}
        argv.extend(args.copy())
        inner: process.cmd(argv).cwd(root).env("JET_RELEASE_LOCK_HELD", "1").env("JET_COMPILER_IDENTITY", pre.release.identity).env("JET_TOOLCHAIN_ROOT", root).env_remove("JET").stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? {
            term.eprint("admit: {pre.release.jet} Tools/agent/Chain.jet slot could not start: {err}")
            return 2
        }
        return if inner.signal != None -> 1 else -> inner.code
    }
    run_gate(options, pre)
}

// `rows COMMIT --source IDENTITY --compiler IDENTITY --out FILE RESULTS...`:
// writes the row file (ROWS_SCHEMA) of RESULTS, the `jet test --results` files
// of one corpora run on COMMIT's export by the compiler --compiler names, built
// from the sources --source names. It reports every problem, and writes no file
// when there is any.
rows_main: fn(args: [String], root: String) -[Exec, FS, IO, Time.Wait]> Int Never! {
    flags := [String: String]{}
    commit := ""
    results := [String]{}
    problems := [String]{}
    index := 0
    loop index < args.len() {
        arg: args[index]
        if arg == "--source" || arg == "--compiler" || arg == "--out" {
            if index + 1 >= args.len() {
                problems.push("{arg} needs a value")
                break
            }
            flags[arg.copy()] = args[index + 1].copy()
            index += 2
            next
        }
        if {
            arg.starts_with("-") -> problems.push("unknown option {arg}")
            commit == "" -> commit = arg.copy()
            else -> results.push(arg.copy())
        }
        index += 1
    }
    source: flags.get("--source") ?? ""
    compiler: flags.get("--compiler") ?? ""
    out: flags.get("--out") ?? ""
    if commit == "" -> problems.push("COMMIT is required")
    if source == "" -> problems.push("--source IDENTITY is required")
    if compiler == "" -> problems.push("--compiler IDENTITY is required")
    if out == "" -> problems.push("--out FILE is required")
    if results.len() == 0 -> problems.push("no RESULTS file")
    full := ""
    kit := [String]{}
    if commit != "" {
        parsed: git_in(root, [String]{"rev-parse", "--verify", "{commit}^{{commit}}"})
        if parsed.rc != 0 -> problems.push("{commit} is no commit of {root}") else -> full = parsed.out.copy()
    }
    if full != "" {
        listed: native_suites(root, full)
        if listed.error != "" -> problems.push(listed.error.copy())
        kit = kit_suites(listed.suites)
    }
    rows := [SuiteRow]{}
    loop path in results {
        text: read_text(path) ?? ""
        found: rows_of(array_field(json.parse(text) ?? Dyn.Null, "results"))
        if found.len() == 0 {
            problems.push("{path} holds no testkit result rows")
            next
        }
        rows.extend(found)
    }
    counts := [String]{}
    loop suite in kit {
        count := 0
        loop item in rows {
            if item.suite == suite -> count += 1
        }
        if count == 0 && results.len() > 0 -> problems.push("RESULTS hold no {suite} rows")
        counts.push("{suite} {count}")
    }
    if problems.len() > 0 {
        term.eprint(ADMIT_USAGE)
        loop found in problems -> term.eprint("rows: {found}")
        return 2
    }
    files.write(out, row_file_text(RowFile{commit: full.copy(), source: source.copy(), compiler: compiler.copy(), rows: rows.copy()})) ?? {
        term.eprint("rows: cannot write {out}: {err}")
        return 1
    }
    print("ROWS {out}: {rows.len()} rows ({counts.join(", ")}) of {short(full, 10)} by {compiler}, compiler source {source}")
    0
}
