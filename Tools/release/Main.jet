// The one route to an a0_NNN GitHub release. Run from the checkout root:
//
//   jet run Tools/release/Main.jet -- candidate DIR [--evidence EVDIR]... [--key REGISTRY]
//   jet run Tools/release/Main.jet -- publish DIR [--key REGISTRY] [--dry-run]
//
// DIR is a build of Tools/agent/publish-release.mjs, gated by one
// Tools/agent/verify-full.sh run per runner (--evidence EVDIR, once per
// shard and target), or a release Tools/agent/release-compiler.mjs admitted,
// gated by its own RELEASE.json. `candidate` stages DIR/release/, checks
// every gate and, when nothing blocks, writes DIR/CANDIDATE.json: the record
// that binds the source, toolchain, artifacts, signer, test receipts, support
// matrix (Tools/release/support-matrix.tsv), provenance and release
// metadata, with its Ed25519 signature in DIR/CANDIDATE.json.sig. The key is
// `jet registry keygen --registry jet-release` (or --key REGISTRY).
// `publish` derives the record again, refuses any difference or blocker,
// runs `gh release create` with exactly the recorded assets, and checks that
// GitHub holds all of them. --dry-run prints that command instead.
//
// Blockers: a supported target or shard with no runner, a check that did not
// pass, was skipped or passed in one run and failed in another, a stale
// artifact or receipt, a signing failure, a chain without a fixed point or an
// archive that packs differently twice, and a partial publication. Every run
// writes DIR/audit/NNN-<step>.json, and a restaged directory moves into
// DIR/audit/ instead of being deleted.
//
// Exit: 0 done, 1 blocked, 2 the run could not start.

use {
    files :: core.files
    process :: core.process
    term :: core.term
    jetpack_publication.[publication_key_paths, publication_read_public_key]
}

RELEASE_KEY :: "jet-release"

struct Options {
    command: String
    dir: String
    evidence: [String]
    key: String
    dry_run: Bool
}

fn usage() -> String Never! {
    "usage: jet run Tools/release/Main.jet -- candidate DIR [--evidence EVDIR]... [--key REGISTRY]\n       jet run Tools/release/Main.jet -- publish DIR [--key REGISTRY] [--dry-run]"
}

fn parse_args(args: [String]) -> Options Problem! {
    options := Options{command: "", dir: "", evidence: [String]{}, key: RELEASE_KEY, dry_run: false}
    if args.len() == 0 -> return Err(problem(INPUT, usage()))
    options.command = args[0].copy()
    if options.command != "candidate" && options.command != "publish" -> return Err(problem(INPUT, "unknown command {options.command}: want candidate or publish\n{usage()}"))
    index := 1
    loop index < args.len() {
        arg :: args[index]
        if {
            arg == "--evidence" || arg == "--key" -> {
                if index + 1 >= args.len() -> return Err(problem(INPUT, "{arg} needs a value"))
                if arg == "--evidence" -> &options.evidence.push(args[index + 1].copy()) else -> options.key = args[index + 1].copy()
                index += 2
                next
            }
            arg == "--dry-run" -> options.dry_run = true
            arg.starts_with("-") -> return Err(problem(INPUT, "unknown option {arg}\n{usage()}"))
            options.dir != "" -> return Err(problem(INPUT, "one release directory, not {options.dir} and {arg}"))
            else -> options.dir = arg.copy()
        }
        index += 1
    }
    if options.dir == "" -> return Err(problem(INPUT, "DIR is required\n{usage()}"))
    if options.command == "candidate" && options.dry_run -> return Err(problem(INPUT, "--dry-run belongs to publish"))
    if options.command == "publish" && options.evidence.len() > 0 -> return Err(problem(INPUT, "--evidence belongs to candidate"))
    Ok(options)
}

// What origin and GitHub say, asked with git and gh.
fn gather_remote(root: String, commit: String, programs: Programs) -[Exec, Time.Wait]> Remote Never! {
    remote := Remote{slug: "", origin_tags: [Tag]{}, local_tags: [String]{}, released: [String]{}, on_origin_dev: false, tree: "", problems: [Problem]{}}
    remote.slug = github_slug(run_argv([String]{"git", "-C", root, "remote", "get-url", "origin"}, root).output)
    listed :: run_argv([String]{"git", "-C", root, "ls-remote", "--tags", "origin", "a0_*"}, root)
    if listed.code != 0 -> &remote.problems.push(problem(REMOTE, "git ls-remote origin failed: {listed.errors.trim()}"))
    remote.origin_tags = remote_tags(listed.output)
    loop line in run_argv([String]{"git", "-C", root, "tag", "-l", "a0_*"}, root).output.split("\n").to_list() {
        if line.trim() != "" -> &remote.local_tags.push(line.trim().copy())
    }
    if remote.slug != "" {
        released :: run_argv(with_args(programs.gh, [String]{"release", "list", "-R", remote.slug, "--limit", "1000", "--json", "tagName", "--jq", ".[].tagName"}), root)
        if released.code != 0 -> &remote.problems.push(problem(REMOTE, "gh release list failed: {released.errors.trim()}"))
        loop line in released.output.split("\n").to_list() {
            if line.trim() != "" -> &remote.released.push(line.trim().copy())
        }
    }
    if is_hex(commit, 40) {
        remote.on_origin_dev = run_argv([String]{"git", "-C", root, "merge-base", "--is-ancestor", commit, "refs/remotes/origin/dev"}, root).code == 0
        remote.tree = run_argv([String]{"git", "-C", root, "rev-parse", "--verify", "-q", "{commit}^{{tree}}"}, root).output.trim().copy()
    }
    remote
}

fn release_main(args: [String]) -[FS, Env, Exec, IO, Time, Time.Wait]> Int Never! {
    options :: parse_args(args) ?? {
        term.eprint("release: {err.text}")
        return 2
    }
    root :: files.absolute(".") ?? {
        term.eprint("release: cannot resolve the checkout: {err}")
        return 2
    }
    if !files.exists(files.join(root, SUPPORT_MATRIX_PATH)) {
        term.eprint("release: run from the checkout root: {SUPPORT_MATRIX_PATH} is not here")
        return 2
    }
    dir :: files.absolute(options.dir) ?? {
        term.eprint("release: cannot resolve {options.dir}: {err}")
        return 2
    }
    if !files.is_dir(dir) {
        term.eprint("release: {dir} is not a directory")
        return 2
    }
    programs :: Programs{gh: [String]{"gh"}, jet: [String]{"jet"}}
    remote :: gather_remote(root, read_release(dir).commit, programs)
    trusted :: publication_read_public_key(options.key) ?? ""
    outcome :: if options.command == "candidate" -> candidate_step(dir, root, options.evidence, Signer{seed_path: publication_key_paths(options.key).seed_path, public_key: trusted}, remote, programs) else -> publish_step(dir, root, trusted, remote, programs, dry_run: options.dry_run)
    loop line in outcome.report {
        if outcome.problems.len() == 0 -> print(line) else -> term.eprint(line)
    }
    if outcome.problems.len() == 0 -> 0 else -> 1
}

fn run() {
    process.exit(release_main(process.args()))
}
