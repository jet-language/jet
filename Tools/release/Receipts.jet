// Test receipts and the support matrix. A receipt is one runner's report: a
// verify-full.json written by Tools/agent/VerifyFull.jet, or the RELEASE.json
// Tools/agent/release-compiler.mjs admits a release with. Each names the
// target it ran on and its shard of the suite inventory, so a runner that
// never reported shows up as a gap in the matrix.

use {
    files: core.files
    json: core.encoding.json
}

SUPPORT_MATRIX_PATH: "Tools/release/support-matrix.tsv"

Row: struct {
    scope: String
    status: String
    total: Int?
    passed: Int?
}

Receipt: struct {
    // "verify-full" or "release-compiler".
    kind: String
    // Where the copy lives, relative to the release directory.
    file: String
    sha256: String
    target: String
    shard: Int
    shards: Int
    head: String
    jet_sha256: String
    status: String
    rows: [Row]
    problems: [Problem]
}

MatrixRow: struct {
    target: String
    name: String
}

receipt_rows: fn(items: [Dyn], scope_key: String) -> [Row] Never! {
    rows := [Row]{}
    loop item in items -> &rows.push(Row{scope: text_field(item, scope_key), status: text_field(item, "status"), total: int_field(item, "total"), passed: int_field(item, "passed")})
    rows
}

empty_receipt: fn(kind: String, file: String, bytes: [U8]) -> Receipt Never! {
    Receipt{kind: kind.copy(), file: file.copy(), sha256: sha256_hex(bytes), target: "", shard: 0, shards: 0, head: "", jet_sha256: "", status: "", rows: [Row]{}, problems: [Problem]{}}
}

// A verify-full.json: its pin, the sha256 of the compiler it ran, its target,
// its shard and its rows.
parse_verify_full: fn(file: String, bytes: [U8]) -> Receipt Never! {
    receipt := empty_receipt("verify-full", file, bytes)
    tree: json.parse(String.from_bytes_lossy(bytes)) ?? {
        &receipt.problems.push(problem(INPUT, "{file} is not JSON: {err}"))
        return receipt
    }
    receipt.head = text_field(tree, "head")
    receipt.jet_sha256 = text_field(tree, "jet_sha256")
    receipt.target = text_field(tree, "target")
    receipt.status = text_field(tree, "status")
    receipt.rows = receipt_rows(array_field(tree, "rows"), "scope")
    shard: field(tree, "shard")
    receipt.shard = int_field(shard, "index") ?? -1
    receipt.shards = int_field(shard, "count") ?? 0
    if receipt.target == "" -> &receipt.problems.push(problem(MISSING_RUNNER, "{file} names no target: it predates runner targets, so rerun Tools/agent/VerifyFull.jet"))
    if receipt.shards < 1 || receipt.shard < 0 || receipt.shard >= receipt.shards -> &receipt.problems.push(problem(MISSING_RUNNER, "{file} names no valid shard: rerun Tools/agent/VerifyFull.jet"))
    if !is_hex(receipt.jet_sha256, 64) -> &receipt.problems.push(problem(STALE, "{file} does not record the sha256 of the jet it ran, so it cannot be tied to this release: rerun Tools/agent/VerifyFull.jet"))
    receipt
}

// The RELEASE.json of an admitted release, read as the one receipt of its
// runner: release-compiler.mjs runs every suite itself, so it is shard 0 of 1.
parse_admission_receipt: fn(file: String, bytes: [U8]) -> Receipt Never! {
    receipt := empty_receipt("release-compiler", file, bytes)
    tree: json.parse(String.from_bytes_lossy(bytes)) ?? {
        &receipt.problems.push(problem(INPUT, "{file} is not JSON: {err}"))
        return receipt
    }
    receipt.head = text_field(tree, "commit")
    receipt.jet_sha256 = identity_sha(text_field(tree, "identity"))
    receipt.target = text_field(tree, "target")
    receipt.status = text_field(tree, "verdict")
    receipt.rows = receipt_rows(array_field(tree, "checks"), "check")
    receipt.shard = 0
    receipt.shards = 1
    if receipt.target == "" -> &receipt.problems.push(problem(MISSING_RUNNER, "{file} names no target: it predates runner targets, so admit the release again with Tools/agent/release-compiler.mjs"))
    receipt
}

read_receipt: fn(dir: String, file: String, kind: String) -[FS]> Receipt Never! {
    bytes: files.read_bytes(files.join(dir, file)) ?? {
        receipt := empty_receipt(kind, file, [U8]{})
        &receipt.problems.push(problem(MISSING_RUNNER, "the receipt {file} is missing: {err}"))
        return receipt
    }
    if kind == "release-compiler" -> return parse_admission_receipt(file, bytes)
    parse_verify_full(file, bytes)
}

// support-matrix.tsv: one `target<TAB>name` row per supported target.
parse_matrix: fn(text: String) -> [MatrixRow] Problem! {
    rows := [MatrixRow]{}
    loop (index, raw) in text.split("\n").to_list() {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        cells: raw.trim_end().split("\t").to_list()
        if cells.len() != 2 || cells[0].trim() == "" || cells[1].trim() == "" -> return Err(problem(MATRIX, "{SUPPORT_MATRIX_PATH}:{index + 1}: a row needs a target and a name separated by a tab"))
        &rows.push(MatrixRow{target: cells[0].trim().copy(), name: cells[1].trim().copy()})
    }
    if rows.len() == 0 -> return Err(problem(MATRIX, "{SUPPORT_MATRIX_PATH} names no target"))
    Ok(rows)
}
