// What `admit` and `build` share: the seed layout a release ships, the
// no-Rust stage environment, the preflight gate and the logged runs of the
// stages.

use {
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
    time: core.time
}

// Every stage runs under this stack: no core files and a 1 GiB stack.
STACK: [String]{"prlimit", "--core=0", "--stack=1073741824:1073741824", "--"}
// A stage with no Rust on PATH: behind Tools/agent/JetEnv.jet `--norust`
// (`in_dev_shell`) when it needs the dev shell's tools, else `norust_var()`.
RUST_TOOLS: [String]{"cargo", "rustc", "rustup"}

// `args` under the stack, behind Tools/agent/JetEnv.jet of `tree` run by
// `jet`: with the dev shell's host tools (the pack's C toolchain, a suite
// row's compilers), and with no Rust tool on PATH when `norust`.
in_dev_shell: fn(jet: String, tree: String, norust: Bool, args: [String]) -> [String] Never! {
    argv := STACK.copy()
    argv.extend([String]{jet.copy(), files.join(tree, "Tools/agent/JetEnv.jet")})
    if norust -> argv.push("--norust")
    argv.extend(args.copy())
    argv
}

// This process's PATH without every directory that holds cargo, rustc or
// rustup, as the child's PATH: no Rust tool stays reachable through it.
norust_var: fn() -[Env, FS]> Var Never! {
    kept := [String]{}
    loop dir in (sys.get("PATH") ?? "").split(":") {
        holds := false
        loop tool in RUST_TOOLS {
            if files.is_file(files.join(dir, tool)) -> holds = true
        }
        if !holds -> kept.push(dir.copy())
    }
    set_var("PATH", kept.join(":"))
}

// Docs/spec/reference/cc-driver.md: `jet-cc` runs `jet cc`, `jet-cxx` and
// `jet-c++` run `jet c++`. They are hard links of `jet` (a real binary, not a
// wrapper); the CLI reads argv[0] (JetCli Host.jet `jet_cli_alias_args`).
COMPILER_ALIASES: [String]{"jet-cc", "jet-cxx", "jet-c++"}

// What a seed directory needs to build or be released from.
STAGE_FILES: [String]{"jet", "IDENTITY", "jet-runtime"}

// One environment change of a child: set `name` to `value`, or remove it.
Var: struct {
    name: String
    value: String
    drop: Bool
}

set_var: fn(name: String, value: String) -> Var Never! { Var{name: name.copy(), value: value.copy(), drop: false} }

drop_var: fn(name: String) -> Var Never! { Var{name: name.copy(), value: "", drop: true} }

// A finished run: its exit status (124 or 137 when the time limit killed
// it), whether it timed out, and its wall time in seconds.
Finished: struct {
    rc: Int
    timed_out: Bool
    wall: Int
}

// Whether the preflight gate admits the launch, and its line.
Admission: struct {
    admitted: Bool
    text: String
}

// The dev tool roots (Tools/agent/roots.sh).
home_dir: fn() -[Env]> String Never! { process.env_nonempty("HOME") ?? "" }

state_root: fn() -[Env]> String Never! {
    process.env_nonempty("JET_STATE_ROOT") ?? files.join(process.env_nonempty("XDG_CACHE_HOME") ?? files.join(home_dir(), ".cache"), "jet-dev")
}

seeds_root: fn() -[Env]> String Never! {
    process.env_nonempty("JET_SEEDS") ?? files.join(process.env_nonempty("XDG_DATA_HOME") ?? files.join(home_dir(), ".local/share"), "jet-seeds")
}

// The runner target Tools/release/support-matrix.tsv names, in node's
// `<platform>-<arch>` spelling (Tools/agent/VerifyFull.jet runner_target).
host_target: fn() -[Env]> String Never! {
    name: sys.name()
    arch: sys.arch()
    platform: if name == "macos" -> "darwin" else -> if name == "windows" -> "win32" else -> name
    machine: if arch == "x86_64" -> "x64" else -> if arch == "aarch64" -> "arm64" else -> arch
    "{platform}-{machine}"
}

clock: fn() -[Time]> String Never! {
    stamp: time.isoformat(time.now_utc())
    if stamp.len() >= 19 -> return stamp.slice(11..<19).copy()
    stamp
}

// `[TOOL HH:MM:SS] message` on stderr, and in `log` when there is one.
say: fn(tool: String, log: String, message: String) Never! -[FS, IO, Time]> {
    line: "[{tool} {clock()}] {message}"
    term.eprint(line)
    if log != "" -> files.append_all(log, "{line}\n") ?? ()
}

short: fn(text: String, length: Int) -> String Never! {
    if text.len() <= length -> return text.copy()
    text.slice(0..<length).copy()
}

// The last `count` non-empty lines of `path`, joined, at most 600 bytes.
tail_of: fn(path: String, count: Int) -[FS]> String Never! {
    text: files.read(path) ?? return ""
    lines := [String]{}
    loop line in text.split("\n").to_list() {
        if line != "" -> lines.push(line.copy())
    }
    start: if lines.len() > count -> lines.len() - count else -> 0
    short(lines[start..<lines.len()].join(" | "), 600)
}

sha256_file: fn(path: String) -[FS]> String Never! {
    bytes: files.read_bytes(path) ?? return ""
    sha256_hex(bytes)
}

// Copies the file `from` to `to` and marks it executable (0755) or not (0644).
copy_file: fn(from: String, to: String, executable: Bool) IOError! -[FS]> {
    files.copy(from, to) ?? return Err(err)
    files.set_mode(to, if executable -> 493 else -> 420) ?? return Err(err)
    Ok()
}

link_compiler_aliases: fn(dir: String) IOError! -[FS]> {
    loop alias in COMPILER_ALIASES {
        files.hard_link(files.join(dir, "jet"), files.join(dir, alias)) ?? return Err(err)
    }
    Ok()
}

// A plain command to completion, its output discarded; the exit status.
quiet: fn(argv: [String], cwd: String) -[Exec, Time.Wait]> Int Never! {
    receipt: process.cmd(argv).cwd(cwd).output_limit(268435456).run() ?? return 127
    if receipt.signal == .Val(_) -> 128 else -> receipt.code
}

// Copies the tree `from` to `to`, symbolic links as links.
copy_tree: fn(from: String, to: String) -[Exec, Time.Wait]> Bool Never! {
    quiet([String]{"cp", "-a", from.copy(), to.copy()}, ".") == 0
}

// Removes `dir`; test fixtures leave read-only directories behind, so the
// tree is made writable first.
remove_tree: fn(dir: String) Never! -[FS, Exec, Time.Wait]> {
    if !files.exists(dir) -> return
    _: quiet([String]{"chmod", "-R", "u+w", dir.copy()}, ".")
    files.remove_all(dir) ?? ()
}

// COMMIT of the checkout `repo` written into `dir`, which is emptied first:
// git reads the commit into a private index beside `dir` and checks every
// entry of it out under `dir`.
export_commit: fn(repo: String, commit: String, dir: String) -[FS, Exec, Time.Wait]> String? Never! {
    remove_tree(dir)
    files.create_dir_all(dir) ?? return Val("cannot create {dir}: {err}")
    index: "{dir.removesuffix("/")}.index"
    files.remove(index) ?? ()
    failed := git_indexed(repo, index, [String]{"read-tree", commit.copy()})
    if failed == "" -> failed = git_indexed(repo, index, [String]{"--work-tree={dir}", "checkout-index", "--all", "--force"})
    files.remove(index) ?? ()
    if failed == "" -> None else -> Val("{failed} ({commit})")
}

// The variables that point git at a repository other than its `-C` one.
GIT_REPOSITORY_VARS: [String]{"GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"}

// `git -C repo ARGS` with `repo` alone naming the repository: an inherited
// GIT_REPOSITORY_VARS variable would point git at another one (a test
// fixture's commit would land there).
git_spec: fn(repo: String, args: [String]) -> ProcessSpec Never! {
    argv := [String]{"git", "-C", repo.copy()}
    argv.extend(args.copy())
    spec := process.cmd(argv).cwd(repo).output_limit(268435456)
    loop name in GIT_REPOSITORY_VARS -> spec = spec.env_remove(name)
    spec
}

// `git -C repo ARGS` on the index file `index`: "" when it succeeds, else
// why it failed.
git_indexed: fn(repo: String, index: String, args: [String]) -[Exec, Time.Wait]> String Never! {
    step: if args[0].starts_with("--") -> args[1] else -> args[0]
    receipt: git_spec(repo, args).env("GIT_INDEX_FILE", index).run() ?? return "git {step} failed: {err}"
    if receipt.code != 0 || receipt.signal != None -> return "git {step} failed: {receipt.errors.trim()}"
    ""
}

// `git -C repo ARGS` (git_spec): exit status and trimmed output.
git_in: fn(repo: String, args: [String]) -[Exec, Time.Wait]> (rc: Int, out: String, err: String) Never! {
    receipt: git_spec(repo, args).run() ?? return (rc: 127, out: "", err: "git: {err}")
    (rc: if receipt.signal == .Val(_) -> 128 else -> receipt.code, out: receipt.output.trim().copy(), err: receipt.errors.trim().copy())
}

// The command a logged run starts: killed when this process dies, pinned to
// the build slot's CPUs when there is one, and killed with its whole process
// group after `seconds` (then SIGKILL 30 s later).
logged_argv: fn(argv: [String], seconds: Int) -[Env]> [String] Never! {
    out := [String]{"setpriv", "--pdeathsig", "KILL", "--"}
    if seconds > 0 -> out.extend([String]{"timeout", "-k", "30", "{seconds}"})
    if sys.get("SLOT_CPUS") == .Val(cpus) && cpus != "" -> out.extend([String]{"taskset", "-c", cpus.copy()})
    out.extend(argv.copy())
    out
}

finished_of: fn(code: Int, signalled: Bool, seconds: Int, wall: Int) -> Finished Never! {
    rc: if signalled -> 128 else -> code
    Finished{rc: rc, timed_out: seconds > 0 && (rc == 124 || rc == 137) && wall >= seconds, wall: wall}
}

// Runs `argv` in `cwd` with `vars` to completion. Its output and errors go
// into `log` as they arrive (appended to it when `append`).
run_logged: fn(argv: [String], cwd: String, vars: [Var], log: String, seconds: Int, append: Bool{false}) -[Env, Exec, FS, Time, Time.Wait]> Finished Never! {
    watch: time.start()
    if !append -> files.write(log, "") ?? return Finished{rc: 127, timed_out: false, wall: 0}
    spec := process.cmd(logged_argv(argv, seconds)).cwd(cwd).stdout(.Stream).stderr(.Stream)
    loop change in vars {
        spec = if change.drop -> spec.env_remove(change.name) else -> spec.env(change.name, change.value)
    }
    child: spec.spawn() ?? {
        files.append_all(log, "\n{argv[0]}: {err}\n") ?? ()
        return Finished{rc: 127, timed_out: false, wall: 0}
    }
    // Both pipes drain at once, so a child that fills one never stalls.
    task.group pumps(limit: 2) {
        errors: task pump_stderr(child.stderr, log)
        pump_stdout(child.stdout, log)
        errors.join() ?? ()
    }
    receipt: child.wait() ?? {
        files.append_all(log, "\n{argv[0]}: {err}\n") ?? ()
        return Finished{rc: 127, timed_out: false, wall: time.elapsed(watch).ns /% 1000000000}
    }
    finished_of(receipt.code, receipt.signal != None, seconds, time.elapsed(watch).ns /% 1000000000)
}

// Copies each piece of a child's output into `log` as it arrives; a failed
// write still drains the pipe.
pump_stdout: fn(stream: ProcessStdoutStream, log: String) Never! -[Exec, FS, Time.Wait]> {
    writer: files.append(log) ?? {
        loop _ in stream.chunks(65536) {}
        return
    }
    loop chunk in stream.chunks(65536) {
        writer.write_all(chunk) ?? ()
        writer.flush() ?? ()
    }
}

pump_stderr: fn(stream: ProcessStderrStream, log: String) Never! -[Exec, FS, Time.Wait]> {
    writer: files.append(log) ?? {
        loop _ in stream.chunks(65536) {}
        return
    }
    loop chunk in stream.chunks(65536) {
        writer.write_all(chunk) ?? ()
        writer.flush() ?? ()
    }
}

// One run of a parallel batch.
Job: struct {
    argv: [String]
    cwd: String
    vars: [Var]
    log: String
    seconds: Int
}

// Runs every job at once and returns their results in order.
run_batch: fn(jobs: [Job]) -[Env, Exec, FS, Time, Time.Wait]> [Finished] Never! {
    out := [Finished]{}
    task.group batch(limit: if jobs.len() > 0 -> jobs.len() else -> 1) {
        handles: loop job in jobs -> task run_logged(job.argv.copy(), job.cwd.copy(), job.vars.copy(), job.log.copy(), job.seconds)
        loop handle in handles -> out.push(handle.join() ?? Finished{rc: 127, timed_out: false, wall: 0})
    }
    out
}

// The preflight gate (`Tools/agent/Land.jet receipt commit`, run by the seed
// in `seed_dir` from the checkout `repo`): is a launch of COMMIT `sha` by
// that seed admitted by a receipt? `text` is the admission line, or the
// refusal that names the census to run.
preflight_gate: fn(launcher: String, repo: String, seed_dir: String, sha: String) -[Exec, FS, Time.Wait]> Admission Never! {
    identity: read_text(files.join(seed_dir, "IDENTITY")) ?? return Admission{admitted: false, text: "{launcher}: seed {seed_dir} has no IDENTITY"}
    argv: [String]{files.join(seed_dir, "jet"), "Tools/agent/Land.jet", "receipt", "commit", launcher.copy(), repo.copy(), sha.copy(), seed_dir.copy()}
    receipt: process.cmd(argv).cwd(repo).env("JET_COMPILER_IDENTITY", identity.trim()).env("JET_TOOLCHAIN_ROOT", repo).output_limit(16777216).run() ?? return Admission{admitted: false, text: "{launcher}: the preflight gate did not run ({err})"}
    text := "{receipt.output}{receipt.errors}".trim().copy()
    if text == "" -> text = "{launcher}: the preflight gate did not run (exit {receipt.code})"
    Admission{admitted: receipt.code == 0 && receipt.signal == None, text: text}
}

// The compiler source identity of `tree` (`Tools/agent/CompilerPackages.jet
// identity`, the identity Tools/agent/Land.jet's census receipts record), run
// by the seed in `seed_dir` with the checkout `repo`'s package model; "" when
// it does not run.
source_identity: fn(repo: String, seed_dir: String, tree: String) -[Exec, FS, Time.Wait]> String Never! {
    identity: read_text(files.join(seed_dir, "IDENTITY")) ?? return ""
    argv: [String]{files.join(seed_dir, "jet"), files.join(repo, "Tools/agent/CompilerPackages.jet"), "--root", tree.copy(), "identity"}
    ran: process.cmd(argv).cwd(tree).env("JET_COMPILER_IDENTITY", identity.trim()).env("JET_TOOLCHAIN_ROOT", repo).output_limit(16777216).run() ?? return ""
    lines := [String]{}
    loop line in ran.output.split("\n").to_list() {
        if line.trim() != "" -> lines.push(line.trim().copy())
    }
    if ran.code != 0 || ran.signal != None || lines.len() != 1 -> return ""
    lines[0].copy()
}

// Whether `path` is `root` or lies under it.
inside: fn(root: String, path: String) -> Bool Never! {
    path == root || path.starts_with("{root.removesuffix("/")}/")
}
