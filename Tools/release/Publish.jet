// The two steps of a release. `candidate` stages the assets, checks every
// gate and, only when nothing blocks, writes the signed candidate record.
// `publish` derives the record again from disk, refuses any difference, and
// hands exactly the recorded assets to `gh release create`; it then checks
// that GitHub holds every asset. Each run of either step writes an audit
// entry under DIR/audit/, and nothing a run leaves behind is deleted: a
// restaged directory moves into the audit trail first.

use {
    files :: core.files
    json :: core.encoding.json
    process :: core.process
    time :: core.time
}

AUDIT_DIR :: "audit"
STAGE_DIR :: "release"
RECEIPTS_DIR :: "receipts"

// The key that signs a candidate and the public key publish trusts.
struct Signer {
    seed_path: String
    public_key: String
}

// The external programs a run uses, as argv prefixes.
struct Programs {
    gh: [String]
    jet: [String]
}

struct Outcome {
    verdict: String
    problems: [Problem]
    audit: String
    report: [String]
}

struct Ran {
    code: Int
    output: String
    errors: String
}

fn run_argv(argv: [String], cwd: String) -[Exec, Time.Wait]> Ran Never! {
    receipt :: process.cmd(argv).cwd(cwd).output_limit(268435456).run() ?? return Ran{code: 127, output: "", errors: "{argv[0]}: {err}"}
    code :: if receipt.signal == .Val(_) -> 128 else -> receipt.code
    Ran{code: code, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

fn with_args(prefix: [String], args: [String]) -> [String] Never! {
    argv := prefix.copy()
    &argv.extend(args)
    argv
}

fn audit_number(dir: String) -[FS]> Int Never! {
    highest := 0
    entries :: files.list_dir(files.join(dir, AUDIT_DIR)) ?? return 1
    loop entry in entries {
        name :: entry.name
        if name.len() < 4 || name.slice(3..<4) != "-" -> next
        value := 0
        digits := true
        loop byte in name.slice(0..<3).bytes() {
            code :: Int.from_u8(byte)
            if code < 48 || code > 57 -> digits = false
            value = value * 10 + code - 48
        }
        if digits && value > highest -> highest = value
    }
    highest + 1
}

fn padded(number: Int) -> String Never! {
    if {
        number < 10 -> "00{number}"
        number < 100 -> "0{number}"
        else -> "{number}"
    }
}

// Moves DIR/name into the audit trail as NNN-name, so a rerun never
// overwrites what an earlier run left.
fn retire(dir: String, name: String, number: Int) Problem! -[FS]> {
    path :: files.join(dir, name)
    if !files.exists(path) -> return Ok(())
    kept :: files.join(files.join(dir, AUDIT_DIR), "{padded(number)}-{name}")
    files.rename(path, kept) ?? return Err(problem(INPUT, "cannot keep {path} as {kept}: {err}"))
    Ok(())
}

fn problems_dyn(problems: [Problem]) -> Dyn Never! {
    out := [Dyn]{}
    loop found in problems -> &out.push(Dyn.Object([String: Dyn]{"class": Dyn.Text(found.class.copy()), "text": Dyn.Text(found.text.copy())}))
    Dyn.Array(out)
}

// Writes DIR/audit/NNN-<step>.json and returns its path; an existing entry
// is never replaced. Evidence comes first: a step that cannot write its
// entry does not go on.
fn write_audit(dir: String, number: Int, step: String, verdict: String, problems: [Problem], details: [String: Dyn]) -[FS, Time]> String Problem! {
    audit :: files.join(dir, AUDIT_DIR)
    path :: files.join(audit, "{padded(number)}-{step}.json")
    files.create_dir_all(audit) ?? return Err(problem(INPUT, "the audit entry {path} was not written: {err}"))
    if files.exists(path) -> return Err(problem(INPUT, "the audit entry {path} already exists, so this run's entry was not written"))
    entry := details.copy()
    entry["step"] = Dyn.Text(step.copy())
    entry["verdict"] = Dyn.Text(verdict.copy())
    entry["at"] = Dyn.Text(time.isoformat(time.now()))
    entry["problems"] = problems_dyn(problems)
    text :: json.canonical(Dyn.Object(entry)) ?? return Err(problem(INPUT, "the audit entry {path} was not written: {err}"))
    files.write(path, "{text}\n") ?? return Err(problem(INPUT, "the audit entry {path} was not written: {err}"))
    Ok(path)
}

// Whether DIR/audit holds the `candidate` entry that sealed `digest`.
fn candidate_audited(dir: String, digest: String) -[FS]> Bool Never! {
    entries :: files.list_dir(files.join(dir, AUDIT_DIR)) ?? return false
    loop entry in entries {
        if !entry.name.ends_with("-candidate.json") -> next
        tree :: read_json(files.join(files.join(dir, AUDIT_DIR), entry.name)) ?? next
        if text_field(tree, "verdict") == "CANDIDATE" && text_field(tree, "content_digest") == digest -> return true
    }
    false
}

// The seed archive of `dir` at `out`: the seed files and SHA256SUMS, with
// names, owners and times fixed so the same inputs give the same bytes.
fn pack_archive(dir: String, out: String) -[FS, Exec, Time.Wait]> Problem? Never! {
    argv := [String]{"tar", "--sort=name", "--owner=0", "--group=0", "--numeric-owner", "--mtime=@0", "--use-compress-program=gzip -n", "-cf", out.copy()}
    loop name in SEED_FILES {
        if files.exists(files.join(dir, name)) -> &argv.push(name.copy())
    }
    &argv.push("SHA256SUMS")
    ran :: run_argv(argv, dir)
    if ran.code != 0 -> return Val(problem(INPUT, "packing {files.basename(out)} failed (exit {ran.code}): {ran.errors.trim()}"))
    None
}

// Packs the archive again and compares the bytes with `staged`.
fn repack_problems(dir: String, staged: String, number: Int) -[FS, Exec, Time.Wait]> [Problem] Never! {
    again :: files.join(files.join(dir, AUDIT_DIR), "{padded(number)}-repack")
    files.create_dir_all(again) ?? return [Problem]{problem(INPUT, "cannot create {again}: {err}")}
    second :: files.join(again, files.basename(staged))
    if pack_archive(dir, second) == .Val(failed) -> return [Problem]{failed}
    first :: files.read_bytes(staged) ?? return [Problem]{problem(STALE, "the staged archive {files.basename(staged)} is missing: {err}")}
    bytes :: files.read_bytes(second) ?? return [Problem]{problem(NONDETERMINISM, "the second pack is unreadable: {err}")}
    archive_problems(first, bytes, files.basename(staged))
}

fn archive_problems(first: [U8], second: [U8], name: String) -> [Problem] Never! {
    if first == second -> return [Problem]{}
    [Problem]{problem(NONDETERMINISM, "packing {name} twice gave different bytes ({sha256_hex(first)} then {sha256_hex(second)}): the archive is not reproducible")}
}

// Every listed path under `dir` that names this machine's home, user, host,
// email or mounts (the rules of Tools/agent/LaneCheck.jet's personal-information
// guard, `--patterns`) or one of `literals`. Binary files are searched too: a
// path baked into jet is a leak.
fn personal_problems(root: String, dir: String, paths: [String], literals: [String], programs: Programs) -[FS, Exec, Time.Wait]> [Problem] Never! {
    rules :: run_argv(with_args(programs.jet, [String]{files.join(root, "Tools/agent/LaneCheck.jet"), "--patterns"}), dir)
    if rules.code != 0 -> return [Problem]{problem(PERSONAL, "cannot read the personal-information rules: {rules.errors.trim()}")}
    path_args := [String]{}
    word_args := [String]{}
    loop line in rules.output.split("\n").to_list() {
        cells :: line.split("\t").to_list()
        if cells.len() != 2 || cells[1] == "" -> next
        if {
            cells[0] == "path" -> &path_args.extend([String]{"-e", cells[1].copy()})
            cells[0] == "word" -> &word_args.extend([String]{"-e", cells[1].copy()})
        }
    }
    literal_args := [String]{}
    loop literal in literals {
        if literal.len() > 1 -> &literal_args.extend([String]{"-e", literal.copy()})
    }
    problems := [Problem]{}
    passes :: [(flags: [String], args: [String])]{(flags: [String]{"-P"}, args: path_args), (flags: [String]{"-i", "-P"}, args: word_args), (flags: [String]{"-F"}, args: literal_args)}
    loop pass in passes {
        if pass.args.len() == 0 -> next
        argv := [String]{"git", "grep", "--no-index", "-a", "-l"}
        &argv.extend(pass.flags)
        &argv.extend(pass.args)
        &argv.push("--")
        &argv.extend(paths)
        found :: run_argv(argv, dir)
        if found.code > 1 {
            &problems.push(problem(PERSONAL, "git grep failed (exit {found.code}): {found.errors.trim()}"))
            next
        }
        loop name in found.output.split("\n").to_list() {
            if name.trim() != "" -> &problems.push(problem(PERSONAL, "{name.trim()} names personal information or a build path"))
        }
    }
    problems
}

fn shipped_names(dir: String) -[FS]> [String] Never! {
    names := [String]{}
    loop name in SEED_FILES {
        if files.exists(files.join(dir, name)) -> &names.push(name.copy())
    }
    names
}

// The staged assets in upload order, as they are on disk now.
fn staged_artifacts(stage: String, asset: String) -[FS]> [Artifact] Problem! {
    out := [Artifact]{}
    names :: [String]{asset, "{asset}.sha256", "jet", "IDENTITY", "SHA256SUMS"}
    loop name in names {
        found :: file_artifact(files.join(stage, name), name) ?? return Err(problem(STALE, "the staged asset {name} is missing: {err.text}"))
        &out.push(found)
    }
    Ok(out)
}

// Stages DIR/release/: the seed archive and its .sha256, jet, IDENTITY,
// SHA256SUMS of those, and NOTES.md.
fn stage_assets(dir: String, asset: String) -[FS, Exec, Time.Wait]> Problem? Never! {
    stage :: files.join(dir, STAGE_DIR)
    files.create_dir_all(stage) ?? return Val(problem(INPUT, "cannot create {stage}: {err}"))
    archive :: files.join(stage, asset)
    if pack_archive(dir, archive) == .Val(failed) -> return Val(failed)
    bytes :: files.read_bytes(archive) ?? return Val(problem(INPUT, "cannot read {archive}: {err}"))
    files.write(files.join(stage, "{asset}.sha256"), "{sha256_hex(bytes)}  {asset}\n") ?? return Val(problem(INPUT, "cannot write {asset}.sha256: {err}"))
    files.copy(files.join(dir, "jet"), files.join(stage, "jet")) ?? return Val(problem(INPUT, "cannot copy jet: {err}"))
    files.set_mode(files.join(stage, "jet"), 493) ?? return Val(problem(INPUT, "cannot make the staged jet executable: {err}"))
    files.copy(files.join(dir, "IDENTITY"), files.join(stage, "IDENTITY")) ?? return Val(problem(INPUT, "cannot copy IDENTITY: {err}"))
    sums := [Artifact]{}
    summed :: [String]{asset, "jet", "IDENTITY"}
    loop name in summed {
        found :: file_artifact(files.join(stage, name), name) ?? return Val(err)
        &sums.push(found)
    }
    files.write(files.join(stage, "SHA256SUMS"), sums_text(sums)) ?? return Val(problem(INPUT, "cannot write the staged SHA256SUMS: {err}"))
    None
}

// The receipts of a build: each EVDIR/verify-full.json, copied into
// DIR/receipts/ so the record can name them relative to DIR.
fn copy_receipts(dir: String, evidence: [String]) -[FS]> [Receipt] Never! {
    receipts := [Receipt]{}
    target :: files.join(dir, RECEIPTS_DIR)
    if files.create_dir_all(target) == .Err(failed) {
        receipt := empty_receipt("verify-full", RECEIPTS_DIR, [U8]{})
        &receipt.problems.push(problem(INPUT, "cannot create {target}: {failed}"))
        return [Receipt]{receipt}
    }
    loop (index, source) in evidence {
        file :: "{RECEIPTS_DIR}/{padded(index + 1)}-verify-full.json"
        bytes :: files.read_bytes(files.join(source, "verify-full.json")) ?? {
            receipt := empty_receipt("verify-full", file, [U8]{})
            &receipt.problems.push(problem(MISSING_RUNNER, "{source}/verify-full.json does not exist: that runner never reported"))
            &receipts.push(receipt)
            next
        }
        receipt := parse_verify_full(file, bytes)
        files.write_bytes(files.join(dir, file), bytes) ?? &receipt.problems.push(problem(INPUT, "cannot keep {source}/verify-full.json as {file}: {err}"))
        &receipts.push(receipt)
    }
    receipts
}

// The receipts the record names, read back from DIR.
fn stored_receipts(dir: String, release: Release) -[FS]> [Receipt] Never! {
    if release.kind == "admitted" -> return [Receipt]{read_receipt(dir, "RELEASE.json", "release-compiler")}
    names := [String]{}
    entries :: files.list_dir(files.join(dir, RECEIPTS_DIR)) ?? return [Receipt]{}
    loop entry in entries -> &names.push(entry.name.copy())
    &names.sort_by((left: String, right: String) -> left <=> right)
    receipts := [Receipt]{}
    loop name in names -> &receipts.push(read_receipt(dir, "{RECEIPTS_DIR}/{name}", "verify-full"))
    receipts
}

fn read_matrix(root: String) -[FS]> [MatrixRow] Problem! {
    text :: files.read(files.join(root, SUPPORT_MATRIX_PATH)) ?? return Err(problem(MATRIX, "cannot read {SUPPORT_MATRIX_PATH}: {err}"))
    rows :: parse_matrix(text) ?? return Err(err)
    Ok(rows)
}

fn blocked_report(command: String, problems: [Problem]) -> [String] Never! {
    lines := [String]{"BLOCKED: {command} found {problems.len()} problem(s):"}
    loop found in problems -> &lines.push("  [{found.class}] {found.text}")
    lines
}

// `candidate DIR`: stage, gate, and on a clean gate sign the record.
fn candidate_step(dir: String, root: String, evidence: [String], signer: Signer, remote: Remote, programs: Programs) -[FS, Env, Exec, Time, Time.Wait]> Outcome Never! {
    number :: audit_number(dir)
    problems := [Problem]{}
    if files.create_dir_all(files.join(dir, AUDIT_DIR)) == .Err(failed) -> &problems.push(problem(INPUT, "cannot create {dir}/{AUDIT_DIR}: {failed}"))
    retired :: [String]{STAGE_DIR, RECEIPTS_DIR, CANDIDATE_FILE, SIGNATURE_FILE}
    loop name in retired {
        if retire(dir, name, number) == .Err(failed) -> &problems.push(failed)
    }
    release :: read_release(dir)
    &problems.extend(release.problems)
    matrix := [MatrixRow]{}
    if read_matrix(root) == {
        .Ok(rows) -> matrix = rows
        .Err(failed) -> &problems.push(failed)
    }
    receipts := [Receipt]{}
    if {
        release.kind == "admitted" && evidence.len() > 0 -> &problems.push(problem(INPUT, "{dir} is admitted by its RELEASE.json; drop --evidence"))
        release.kind == "admitted" -> receipts = stored_receipts(dir, release)
        evidence.len() == 0 -> &problems.push(problem(MISSING_RUNNER, "a build needs --evidence EVDIR for each verify-full.sh runner"))
        else -> receipts = copy_receipts(dir, evidence)
    }
    names := remote.local_tags.copy()
    loop known in remote.origin_tags -> &names.push(known.name.copy())
    &names.extend(remote.released)
    name :: if release.kind == "admitted" -> release.name.copy() else -> next_release_name(names)
    if contains_text(remote.released, name) -> &problems.push(problem(REMOTE, "{name} is already a GitHub release"))
    asset :: seed_asset_name(name, release.target)
    stage :: files.join(dir, STAGE_DIR)
    staged := [Artifact]{}
    if release.problems.len() == 0 {
        if stage_assets(dir, asset) == {
            .Val(failed) -> &problems.push(failed)
            None -> {
                if staged_artifacts(stage, asset) == {
                    .Ok(found) -> staged = found
                    .Err(failed) -> &problems.push(failed)
                }
                &problems.extend(repack_problems(dir, files.join(stage, asset), number))
            }
        }
    }
    candidate := Candidate{name: name, release: release.copy(), receipts: receipts, matrix: matrix, remote: remote.copy(), staged: staged, notes_sha256: "", signer: signer.public_key.copy()}
    notes :: release_notes(candidate, gate_text(release, receipts))
    candidate.notes_sha256 = sha256_hex(notes.bytes())
    if files.exists(stage) {
        files.write(files.join(stage, NOTES_FILE), notes) ?? &problems.push(problem(INPUT, "cannot write {NOTES_FILE}: {err}"))
    }
    &problems.extend(release_problems(release))
    &problems.extend(receipt_problems(release, receipts, matrix))
    &problems.extend(remote_problems(release, remote, name))
    if release.problems.len() == 0 {
        &problems.extend(personal_problems(root, dir, shipped_names(dir), [String]{root, dir}, programs))
        if files.exists(stage) -> &problems.extend(personal_problems(root, stage, [String]{"."}, [String]{root, dir}, programs))
    }
    record :: record_of(candidate)
    if signer.public_key == "" -> &problems.push(problem(SIGNING, "no public key for the signer: create one with `jet registry keygen --registry jet-release`"))
    digest :: content_digest(record) ?? ""
    if problems.len() == 0 {
        if sign_digest(signer.seed_path, signer.public_key, digest) == {
            .Ok(signature) -> {
                sealed :: sealed_record(record) ?? ""
                writes :: [(path: String, text: String)]{
                    (path: files.join(dir, CANDIDATE_FILE), text: sealed),
                    (path: files.join(stage, CANDIDATE_FILE), text: sealed),
                    (path: files.join(dir, SIGNATURE_FILE), text: "{signature}\n"),
                    (path: files.join(stage, SIGNATURE_FILE), text: "{signature}\n"),
                }
                loop write in writes {
                    files.write(write.path, write.text) ?? &problems.push(problem(INPUT, "cannot write {write.path}: {err}"))
                }
            }
            .Err(failed) -> &problems.push(failed)
        }
    }
    // publish requires this entry (candidate_audited), so a record whose
    // audit entry could not be written can never be published.
    sealed :: problems.len() == 0
    audit := ""
    if write_audit(dir, number, "candidate", if sealed -> "CANDIDATE" else -> "BLOCKED", problems, [String: Dyn]{"name": Dyn.Text(name.copy()), "content_digest": Dyn.Text(digest.copy()), "record": record.copy()}) == {
        .Ok(path) -> audit = path.copy()
        .Err(failed) -> {
            audit = failed.text.copy()
            &problems.push(failed)
        }
    }
    verdict :: if problems.len() == 0 -> "CANDIDATE" else -> "BLOCKED"
    report := [String]{}
    if {
        problems.len() == 0 -> &report.extend([String]{"CANDIDATE {name}: {dir}/{CANDIDATE_FILE} ({digest}), signed by {signer.public_key}.", "Audit: {audit}", "Next: jet run Tools/release/Main.jet -- publish {dir} --dry-run"})
        else -> {
            &report.extend(blocked_report("candidate", problems))
            &report.push("Audit: {audit}")
        }
    }
    Outcome{verdict: verdict, problems: problems, audit: audit, report: report}
}

// What GitHub holds of release `name`: asset name and size, or None when
// there is no such release.
fn uploaded_assets(name: String, slug: String, programs: Programs, cwd: String) -[Exec, Time.Wait]> [Artifact]? Never! {
    ran :: run_argv(with_args(programs.gh, [String]{"release", "view", name, "-R", slug, "--json", "assets"}), cwd)
    if ran.code != 0 -> return None
    tree :: json.parse(ran.output) ?? return None
    out := [Artifact]{}
    loop item in array_field(tree, "assets") -> &out.push(Artifact{path: text_field(item, "name"), sha256: "", size: int_field(item, "size") ?? -1})
    Val(out)
}

// The assets GitHub lacks or holds with another size.
fn partial_problems(name: String, expected: [Artifact], uploaded: [Artifact]) -> [Problem] Never! {
    problems := [Problem]{}
    missing := [String]{}
    loop artifact in expected {
        size := -1
        loop held in uploaded {
            if held.path == artifact.path -> size = held.size
        }
        if {
            size < 0 -> &missing.push(artifact.path.copy())
            size != artifact.size -> &problems.push(problem(PARTIAL, "GitHub holds {artifact.path} of release {name} with {size} bytes, not {artifact.size}"))
        }
    }
    if missing.len() > 0 -> &problems.push(problem(PARTIAL, "release {name} is partial: GitHub lacks {missing.join(", ")}"))
    problems
}

fn record_assets(dir: String, record: Dyn) -[FS]> [Artifact] Never! {
    out := [Artifact]{}
    stage :: files.join(dir, STAGE_DIR)
    loop item in array_field(field(record, "metadata"), "assets") {
        name :: if item == .Text(value) -> value.copy() else -> ""
        if file_artifact(files.join(stage, name), name) == .Ok(found) -> &out.push(found)
    }
    out
}

fn quoted(word: String) -> String Never! {
    plain := true
    loop byte in word.bytes() {
        code :: Int.from_u8(byte)
        if !((code >= 48 && code <= 58) || (code >= 64 && code <= 90) || (code >= 97 && code <= 122) || code == 37 || code == 43 || code == 44 || code == 45 || code == 46 || code == 47 || code == 61 || code == 95) -> plain = false
    }
    if plain && word != "" -> return word.copy()
    "'{word.replace("'", "'\\''")}'"
}

// `publish DIR`: check the stored record against a fresh derivation and
// every gate; then run `gh release create` (or print it, with dry_run) and
// confirm GitHub holds every asset.
fn publish_step(dir: String, root: String, trusted: String, remote: Remote, programs: Programs, dry_run: Bool{false}) -[FS, Env, Exec, Time, Time.Wait]> Outcome Never! {
    number :: audit_number(dir)
    problems := [Problem]{}
    stored := Dyn.Null
    if files.read(files.join(dir, CANDIDATE_FILE)) == {
        .Ok(found) -> {
            stored = json.parse(found) ?? Dyn.Null
            if !is_object(stored) -> &problems.push(problem(MISMATCH, "{CANDIDATE_FILE} is not a JSON object"))
        }
        .Err(_) -> &problems.push(problem(INPUT, "{dir} has no {CANDIDATE_FILE}: run `candidate` first"))
    }
    signature :: (read_text(files.join(dir, SIGNATURE_FILE)) ?? "").trim().copy()
    name :: text_field(stored, "name")
    recorded :: text_field(stored, "content_digest")
    digest :: content_digest(stored) ?? ""
    if is_object(stored) {
        if text_field(stored, "schema") != CANDIDATE_SCHEMA -> &problems.push(problem(MISMATCH, "{CANDIDATE_FILE} schema is {text_field(stored, "schema")}, not {CANDIDATE_SCHEMA}"))
        if recorded != digest -> &problems.push(problem(MISMATCH, "{CANDIDATE_FILE} was changed after it was sealed: its content digest is {digest}, not the recorded {recorded}"))
        if {
            trusted == "" -> &problems.push(problem(SIGNING, "no trusted public key: create one with `jet registry keygen --registry jet-release`"))
            signature == "" -> &problems.push(problem(SIGNING, "{SIGNATURE_FILE} is missing: the candidate was never signed"))
            text_field(field(stored, "signatures"), "signer") != trusted -> &problems.push(problem(SIGNING, "the record names signer {text_field(field(stored, "signatures"), "signer")}, not the trusted key {trusted}"))
            !verify_digest(trusted, recorded, signature) -> &problems.push(problem(SIGNING, "{SIGNATURE_FILE} is not a valid signature of the record by {trusted}"))
        }
        if recorded == digest && !candidate_audited(dir, recorded) -> &problems.push(problem(MISMATCH, "{dir}/{AUDIT_DIR} holds no candidate entry that sealed {recorded}: run candidate again"))
    }
    release :: read_release(dir)
    &problems.extend(release.problems)
    matrix := [MatrixRow]{}
    if read_matrix(root) == {
        .Ok(rows) -> matrix = rows
        .Err(failed) -> &problems.push(failed)
    }
    receipts :: stored_receipts(dir, release)
    asset :: seed_asset_name(name, release.target)
    stage :: files.join(dir, STAGE_DIR)
    staged := [Artifact]{}
    if staged_artifacts(stage, asset) == {
        .Ok(found) -> staged = found
        .Err(failed) -> &problems.push(failed)
    }
    notes :: files.read(files.join(stage, NOTES_FILE)) ?? ""
    candidate := Candidate{name: name.copy(), release: release.copy(), receipts: receipts, matrix: matrix, remote: remote.copy(), staged: staged, notes_sha256: sha256_hex(notes.bytes()), signer: trusted.copy()}
    if notes != release_notes(candidate, gate_text(release, receipts)) -> &problems.push(problem(STALE, "the staged {NOTES_FILE} is not the notes of this release"))
    sealed_files :: [String]{CANDIDATE_FILE, SIGNATURE_FILE}
    loop sealed in sealed_files {
        if (read_text(files.join(stage, sealed)) ?? "") != (read_text(files.join(dir, sealed)) ?? "") -> &problems.push(problem(STALE, "the staged {sealed} is not {dir}/{sealed}"))
    }
    if is_object(stored) -> &problems.extend(record_mismatches(stored, record_of(candidate)))
    &problems.extend(release_problems(release))
    &problems.extend(receipt_problems(release, receipts, matrix))
    &problems.extend(remote_problems(release, remote, name))
    if release.problems.len() == 0 && staged.len() > 0 {
        &problems.extend(repack_problems(dir, files.join(stage, asset), number))
        &problems.extend(personal_problems(root, stage, [String]{"."}, [String]{root, dir}, programs))
    }
    expected :: record_assets(dir, stored)
    already :: contains_text(remote.released, name)
    if already && problems.len() == 0 {
        // A rerun after GitHub took the release: complete is done, partial blocks.
        held :: uploaded_assets(name, remote.slug, programs, stage) ?? [Artifact]{}
        gaps :: partial_problems(name, expected, held)
        verdict :: if gaps.len() == 0 -> "PUBLISHED" else -> "PARTIAL"
        audit :: write_audit(dir, number, "publish", verdict, gaps, [String: Dyn]{"name": Dyn.Text(name.copy()), "content_digest": Dyn.Text(recorded.copy()), "uploaded": artifacts_dyn(held)}) ?? err.text.copy()
        if gaps.len() == 0 -> return Outcome{verdict: verdict, problems: gaps, audit: audit, report: [String]{"PUBLISHED {name} was already on {remote.slug} with every recorded asset.", "Audit: {audit}"}}
        report := blocked_report("publish", gaps)
        &report.push("Upload the missing assets from {stage} with `gh release upload {name} -R {remote.slug} <asset>...`, then run publish again.")
        &report.push("Audit: {audit}")
        return Outcome{verdict: verdict, problems: gaps, audit: audit, report: report}
    }
    if already -> &problems.push(problem(REMOTE, "{name} is already a GitHub release"))
    args := [String]{"release", "create", name.copy(), "-R", remote.slug.copy()}
    if release.kind == "admitted" -> &args.push("--verify-tag") else -> &args.extend([String]{"--target", release.commit.copy()})
    &args.extend([String]{"--title", name.copy(), "--notes-file", NOTES_FILE, "--latest"})
    loop artifact in expected -> &args.push(artifact.path.copy())
    shown := [String]{"gh"}
    loop word in args -> &shown.push(quoted(word))
    details :: [String: Dyn]{"name": Dyn.Text(name.copy()), "content_digest": Dyn.Text(recorded.copy()), "command": Dyn.Text(shown.join(" "))}
    if problems.len() > 0 {
        audit :: write_audit(dir, number, "publish", "BLOCKED", problems, details) ?? err.text.copy()
        report := blocked_report("publish", problems)
        &report.push("Audit: {audit}")
        return Outcome{verdict: "BLOCKED", problems: problems, audit: audit, report: report}
    }
    if dry_run {
        audit :: write_audit(dir, number, "publish", "DRY-RUN", problems, details) ?? err.text.copy()
        return Outcome{verdict: "DRY-RUN", problems: problems, audit: audit, report: [String]{"DRY RUN: {name} matches its signed record ({recorded}). To publish, run from {stage}:", "  {shown.join(" ")}", "or rerun without --dry-run.", "Audit: {audit}"}}
    }
    // The attempt is on disk before the one step that cannot be undone.
    if write_audit(dir, number, "publishing", "PUBLISHING", problems, details) == {
        .Ok(_) -> {}
        .Err(failed) -> return Outcome{verdict: "BLOCKED", problems: [Problem]{failed.copy()}, audit: failed.text.copy(), report: blocked_report("publish", [Problem]{failed.copy()})}
    }
    created :: run_argv(with_args(programs.gh, args), stage)
    outcome := [Problem]{}
    if created.code != 0 -> &outcome.push(problem(PARTIAL, "gh release create exited {created.code}: {created.errors.trim()}"))
    held :: uploaded_assets(name, remote.slug, programs, stage)
    if {
        held == .Val(found) -> &outcome.extend(partial_problems(name, expected, found))
        created.code == 0 -> &outcome.push(problem(PARTIAL, "gh release create succeeded, but GitHub shows no release {name}"))
    }
    verdict :: if {
        outcome.len() == 0 -> "PUBLISHED"
        held == None -> "FAILED"
        else -> "PARTIAL"
    }
    audit :: write_audit(dir, number, "publish", verdict, outcome, details) ?? err.text.copy()
    if outcome.len() == 0 -> return Outcome{verdict: verdict, problems: outcome, audit: audit, report: [String]{"PUBLISHED {name} on {remote.slug} at {release.commit}. Fetch the tag with: git fetch origin tag {name}", "Audit: {audit}"}}
    report := blocked_report("publish", outcome)
    &report.push("{stage} and the audit are kept.")
    &report.push("Audit: {audit}")
    Outcome{verdict: verdict, problems: outcome, audit: audit, report: report}
}
