// jet.release.candidate.v1: one release candidate, bound. The record names
// the source (commit and tree), the toolchain (identity, seed and the chain's
// fixed point), every shipped file and release asset by sha256, the signer,
// every test receipt, the support matrix, the runtime pack's provenance and
// the release metadata. Its content digest covers all of it, and
// CANDIDATE.json.sig is the signer's Ed25519 signature of that digest.
// Publish derives the record again from disk and refuses any difference.

use {
    json :: core.encoding.json
    jetpack_publication.[publication_sign, publication_verify]
}

CANDIDATE_SCHEMA :: "jet.release.candidate.v1"
CANDIDATE_FILE :: "CANDIDATE.json"
SIGNATURE_FILE :: "CANDIDATE.json.sig"
NOTES_FILE :: "NOTES.md"

// Everything a record is derived from.
struct Candidate {
    name: String
    release: Release
    receipts: [Receipt]
    matrix: [MatrixRow]
    remote: Remote
    // The staged release assets in upload order, without the record itself.
    staged: [Artifact]
    notes_sha256: String
    signer: String
}

fn seed_asset_name(name: String, target: String) -> String Never! {
    "jet-{name}-{target}.tar.gz"
}

fn text(value: String) -> Dyn Never! { Dyn.Text(value.copy()) }

fn artifacts_dyn(artifacts: [Artifact]) -> Dyn Never! {
    out := [Dyn]{}
    loop artifact in artifacts {
        &out.push(Dyn.Object([String: Dyn]{"path": text(artifact.path), "sha256": text(artifact.sha256), "size": Dyn.Int(artifact.size)}))
    }
    Dyn.Array(out)
}

fn receipt_dyn(receipt: Receipt) -> Dyn Never! {
    rows := [Dyn]{}
    loop row in receipt.rows {
        entry := [String: Dyn]{"scope": text(row.scope), "status": text(row.status)}
        if row.total == .Val(total) -> entry["total"] = Dyn.Int(total)
        if row.passed == .Val(passed) -> entry["passed"] = Dyn.Int(passed)
        &rows.push(Dyn.Object(entry))
    }
    Dyn.Object([String: Dyn]{
        "file": text(receipt.file),
        "head": text(receipt.head),
        "jet_sha256": text(receipt.jet_sha256),
        "kind": text(receipt.kind),
        "rows": Dyn.Array(rows),
        "sha256": text(receipt.sha256),
        "shard": Dyn.Int(receipt.shard),
        "shards": Dyn.Int(receipt.shards),
        "status": text(receipt.status),
        "target": text(receipt.target),
    })
}

fn upload_names(candidate: Candidate) -> [String] Never! {
    names := [String]{}
    loop artifact in candidate.staged -> &names.push(artifact.path.copy())
    &names.extend([String]{CANDIDATE_FILE, SIGNATURE_FILE})
    names
}

// The record of `candidate`, without its content digest.
fn record_of(candidate: Candidate) -> Dyn Never! {
    release :: candidate.release
    receipts := [Dyn]{}
    loop receipt in candidate.receipts -> &receipts.push(receipt_dyn(receipt))
    matrix := [Dyn]{}
    loop row in candidate.matrix {
        files := [Dyn]{}
        loop receipt in candidate.receipts {
            if receipt.target == row.target -> &files.push(text(receipt.file))
        }
        &matrix.push(Dyn.Object([String: Dyn]{"asset": text(seed_asset_name(candidate.name, row.target)), "name": text(row.name), "receipts": Dyn.Array(files), "target": text(row.target)}))
    }
    assets := [Dyn]{}
    loop name in upload_names(candidate) -> &assets.push(text(name))
    Dyn.Object([String: Dyn]{
        "schema": text(CANDIDATE_SCHEMA),
        "name": text(candidate.name),
        "source": Dyn.Object([String: Dyn]{"commit": text(release.commit), "repository": text(candidate.remote.slug), "tree": text(candidate.remote.tree)}),
        "toolchain": Dyn.Object([String: Dyn]{
            "fixed_point": Dyn.Object([String: Dyn]{"s2": text(release.s2), "s3": text(release.s3)}),
            "identity": text(release.identity),
            "jet_sha256": text(release.jet_sha256),
            "seed": text(release.seed),
            "target": text(release.target),
        }),
        "artifacts": Dyn.Object([String: Dyn]{
            "release": artifacts_dyn(candidate.staged),
            "shipped": artifacts_dyn(release.shipped),
            "shipped_sums_sha256": text(sha256_hex(release.sums.bytes())),
        }),
        "signatures": Dyn.Object([String: Dyn]{"file": text(SIGNATURE_FILE), "scheme": text("ed25519"), "signed": text("content_digest"), "signer": text(candidate.signer)}),
        "tests": Dyn.Array(receipts),
        "support_matrix": Dyn.Array(matrix),
        "provenance": Dyn.Object([String: Dyn]{
            "gate": text(if release.kind == "admitted" -> "release-compiler" else -> "verify-full"),
            "kind": text(release.kind),
            "runtime_key": text(release.runtime_key),
            "runtime_packed_by": text(release.runtime_compiler_sha256),
            "runtime_provenance_sha256": text(release.runtime_provenance_sha256),
        }),
        "metadata": Dyn.Object([String: Dyn]{
            "assets": Dyn.Array(assets),
            "latest": Dyn.Bool(true),
            "notes_sha256": text(candidate.notes_sha256),
            "tag": text(if release.kind == "admitted" -> "verify-tag" else -> "target"),
            "title": text(candidate.name),
        }),
    })
}

fn without_digest(tree: Dyn) -> Dyn Never! {
    kept := [String: Dyn]{}
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key != "content_digest" -> kept[entry.key.copy()] = entry.value.copy()
        }
    }
    Dyn.Object(kept)
}

// sha256 of the canonical JSON of `tree` without its content_digest.
fn content_digest(tree: Dyn) -> String Problem! {
    canonical :: json.canonical(without_digest(tree)) ?? return Err(problem(MISMATCH, "the record has no canonical form: {err}"))
    Ok("sha256:{sha256_hex(canonical.bytes())}")
}

// The record with its content digest, as stored.
fn sealed_record(record: Dyn) -> String Problem! {
    digest :: content_digest(record) ?? return Err(err)
    kept := [String: Dyn]{}
    if record == .Object(entries) {
        loop entry in entries -> kept[entry.key.copy()] = entry.value.copy()
    }
    kept["content_digest"] = text(digest)
    sealed :: json.canonical(Dyn.Object(kept)) ?? return Err(problem(MISMATCH, "the record has no canonical form: {err}"))
    Ok("{sealed}\n")
}

fn canonical_or_empty(tree: Dyn) -> String Never! {
    json.canonical(tree) ?? ""
}

fn keys_of(tree: Dyn) -> [String] Never! {
    keys := [String]{}
    if tree == .Object(entries) {
        loop entry in entries -> &keys.push(entry.key.copy())
    }
    &keys.sort_by((left: String, right: String) -> left <=> right)
    keys
}

// Every section, and every field of an object section, where the stored
// record and the record derived from disk differ.
fn record_mismatches(stored: Dyn, fresh: Dyn) -> [Problem] Never! {
    problems := [Problem]{}
    names := keys_of(without_digest(stored))
    loop name in keys_of(fresh) {
        if !contains_text(names, name) -> &names.push(name.copy())
    }
    loop name in names {
        left :: field(stored, name)
        right :: field(fresh, name)
        if canonical_or_empty(left) == canonical_or_empty(right) -> next
        if !is_object(left) || !is_object(right) {
            &problems.push(problem(MISMATCH, "the record's `{name}` does not match the release directory"))
            next
        }
        keys := keys_of(left)
        loop key in keys_of(right) {
            if !contains_text(keys, key) -> &keys.push(key.copy())
        }
        loop key in keys {
            if canonical_or_empty(field(left, key)) != canonical_or_empty(field(right, key)) -> &problems.push(problem(MISMATCH, "the record's `{name}.{key}` does not match the release directory"))
        }
    }
    problems
}

// Signs `digest` with the Ed25519 seed at `seed_path` and checks the result
// against `public_key` at once, so a key pair that does not match never
// leaves a signature behind.
fn sign_digest(seed_path: String, public_key: String, digest: String) -[FS, Env]> String Problem! {
    signature :: publication_sign(seed_path, digest) ?? return Err(problem(SIGNING, "signing with {seed_path} failed: {err.diagnostic.what} {err.diagnostic.why}"))
    if !verify_digest(public_key, digest, signature) -> return Err(problem(SIGNING, "the signature does not verify with the signer's public key {public_key}: the key pair does not match"))
    Ok(signature)
}

fn verify_digest(public_key: String, digest: String, signature: String) -> Bool Never! {
    publication_verify(public_key, digest, signature) ?? false
}

fn release_notes(candidate: Candidate, gate: String) -> String Never! {
    release :: candidate.release
    asset :: seed_asset_name(candidate.name, release.target)
    short :: if release.commit.len() >= 10 -> release.commit.slice(0..<10) else -> release.commit
    lines :: [String]{
        "{candidate.name}: the jet compiler of dev {short}.",
        "",
        "- Identity: `{release.identity}`",
        "- Commit: {release.commit}",
        "- Seed: `{release.seed}`; the chain from it reaches s2 == s3 with no Rust on PATH, and this release is s2.",
        "- Gate: {gate}.",
        "- Candidate: `{CANDIDATE_FILE}` binds the source, toolchain, every asset, the test receipts, the support matrix and the provenance; `{SIGNATURE_FILE}` is its Ed25519 signature by `{candidate.signer}`.",
        "",
        "`{asset}` is a seed directory (Docs/spec/contributing/bootstrap.md). Fetch the latest release with:",
        "",
        "```sh",
        "gh release download -R {candidate.remote.slug} -p 'jet-a0_*-{release.target}.tar.gz*' && sha256sum -c jet-a0_*-{release.target}.tar.gz.sha256 && mkdir seed && tar -xzf jet-a0_*-{release.target}.tar.gz -C seed && (cd seed && sha256sum -c SHA256SUMS)",
        "```",
        "",
    }
    lines.join("\n")
}

// The gate line of the notes.
fn gate_text(release: Release, receipts: [Receipt]) -> String Never! {
    checks := 0
    loop receipt in receipts -> checks += receipt.rows.len()
    if release.kind == "admitted" {
        seed_name :: text_field(field(release.admission, "seed"), "name")
        gains :: int_field(field(release.admission, "gains"), "total") ?? 0
        return "`Tools/agent/release-compiler.mjs` admitted it from seed {seed_name} ({checks} checks, {gains} rows gained)"
    }
    runners :: if receipts.len() == 1 -> "1 runner" else -> "{receipts.len()} runners"
    "`Tools/agent/VerifyFull.jet` passed on this commit with this binary ({checks} checks from {runners})"
}
