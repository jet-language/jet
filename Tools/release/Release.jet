// What a release directory holds, read from disk. A directory is either a
// directory `build` made (COMMIT, SEED and BUILD.json) or a release `admit`
// admitted (RELEASE.json). Both ship
// the seed files SHA256SUMS lists. Nothing here judges the facts; Gate.jet does.

use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
}

// What a seed directory ships; jetpack is
// absent from some, and a missing name is skipped as there. RELEASE names the
// release, so jet can download its own C toolchain pack. VERSION (`a0.0.N
// <commit> <YYYY-MM-DD>`) is the stamp `jet --version` prints the release from
// (Jetpack/PackageModel Manifest.jet pkg_jet_build).
SEED_FILES: [String]{"jet", "jet-cc", "jet-cxx", "jet-c++", "jetpack", "jet-runtime", "IDENTITY", "RELEASE", "VERSION"}

// Where a tree declares its Jet version, and the declaration's prefix.
JET_VERSION_SOURCE: "Jetpack/PackageModel/Source/Manifest/Manifest.jet"
JET_VERSION_PREFIX: "JET_VERSION: \""

// The JET_VERSION the tree at `root` declares, "" when it declares none.
tree_jet_version: fn(root: String) -[FS]> String Never! {
    text: read_text(files.join(root, JET_VERSION_SOURCE)) ?? return ""
    loop line in text.split("\n").to_list() {
        if !line.starts_with(JET_VERSION_PREFIX) || !line.ends_with("\"") || line.len() <= JET_VERSION_PREFIX.len() + 1 -> next
        return line.slice(JET_VERSION_PREFIX.len()..<line.len() - 1).copy()
    }
    ""
}

// The kinds of problem that block a release. Each blocked run records its
// problems under these names in the audit trail.
MISSING_RUNNER: "missing-runner"
FLAKY: "flaky"
SKIPPED: "skipped"
FAILED: "failed"
STALE: "stale"
SIGNING: "signing"
NONDETERMINISM: "nondeterminism"
PARTIAL: "partial-publication"
MISMATCH: "record-mismatch"
MATRIX: "support-matrix"
ADMISSION: "admission"
REMOTE: "remote"
PERSONAL: "personal-information"
INPUT: "input"

#Error
Problem: struct {
    class: String
    text: String
}

Artifact: struct {
    path: String
    sha256: String
    size: Int
}

Release: struct {
    dir: String
    // "build" or "admitted".
    kind: String
    identity: String
    // The sha256 of jet's file, and the digest its identity names
    // (identity_digest).
    jet_sha256: String
    identity_sha256: String
    commit: String
    seed: String
    // An admitted release keeps the name `admit` gave it.
    name: String
    target: String
    // The VERSION stamp's line (`a0.0.N <commit> <YYYY-MM-DD>`), "" without one.
    version_stamp: String
    s2: String
    s3: String
    shipped: [Artifact]
    sums: String
    runtime_key: String
    runtime_provenance_sha256: String
    runtime_compiler_sha256: String
    // The identity of the jet that lowered the runtime, as jet's
    // RUNTIME_PACKER_PART records it; "" for a jet without that part, whose
    // runtime it lowered itself.
    runtime_packer: String
    admission: Dyn
    problems: [Problem]
}

problem: fn(class: String, text: String) -> Problem Never! {
    Problem{class: class.copy(), text: text.copy()}
}

sha256_hex: fn(bytes: [U8]) -> String Never! { crypto.sha256(bytes).hex() }

field: fn(tree: Dyn, name: String) -> Dyn Never! {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

text_field: fn(tree: Dyn, name: String) -> String Never! {
    if field(tree, name) == .Text(value) -> return value.copy()
    ""
}

// Strict JSON keeps each number as its lexeme (`Dyn.Number`), so a whole
// number is read back from either form.
int_field: fn(tree: Dyn, name: String) -> Int? Never! {
    if field(tree, name) == {
        .Int(value) -> Val(value)
        .Number(lexeme) -> Val(Int.parse(lexeme) ?? return None)
        .Null | .Bool(_) | .Float(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> None
    }
}

array_field: fn(tree: Dyn, name: String) -> [Dyn] Never! {
    if field(tree, name) == .Array(items) -> return items.copy()
    [Dyn]{}
}

is_object: fn(tree: Dyn) -> Bool Never! {
    if tree == .Object(_) -> return true
    false
}

is_hex: fn(text: String, length: Int) -> Bool Never! {
    if text.len() != length -> return false
    loop byte in text.bytes() {
        code: Int{byte}
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// The part of `identity` (`jet@VERSION#SHA256`) after the `#`.
identity_sha: fn(identity: String) -> String Never! {
    identity.partition("#").tail.copy()
}

// The executable part that holds a jet's identity, and the one that holds
// the identity of the jet that lowered its runtime (Compiler/JetCli
// CoreRecordCheck.jet `--embed`).
IDENTITY_PART: "jet.identity"
RUNTIME_PACKER_PART: "jet.runtime/IDENTITY"
// The note type of an executable part (Compiler/JetBackend ELF.jet
// ELF64_JET_PART_NOTE), and its owner, "Jet", as a little-endian word.
PART_NOTE: 1246056449
PART_OWNER: 0x0074654a

// The little-endian number of `count` bytes at `at` of `bytes`.
le_number: fn(bytes: [U8], at: Int, count: Int) -> Int Never! {
    value := 0
    loop k in 0..<count -> value = value + Int{bytes[at + k]} * (1 << (8 * k))
    value
}

// Where the bytes of the part `name` of the executable `image` start and how
// many there are; None without that part. A part is a PT_NOTE whose one note
// has owner "Jet" and type PART_NOTE and whose descriptor is the part's name,
// NUL-padded to eight bytes, then its bytes (Compiler/JetBackend ELF.jet
// x64_executable_add_parts).
image_part: fn(image: [U8], name: String) -> (at: Int, size: Int)? Never! {
    if image.len() < 64 -> return None
    phoff: le_number(image, 32, 8)
    phnum: le_number(image, 56, 2)
    if phoff < 0 || phoff + phnum * 56 > image.len() -> return None
    label: name.bytes()
    descriptor: (label.len() + 8) /% 8 * 8
    loop k in 0..<phnum {
        row: phoff + k * 56
        if le_number(image, row, 4) != 4 -> next
        from: le_number(image, row + 8, 8)
        size: le_number(image, row + 32, 8)
        if from < 0 || size < 16 + descriptor || from + size > image.len() -> next
        if le_number(image, from, 4) != 4 || le_number(image, from + 8, 4) != PART_NOTE || le_number(image, from + 12, 4) != PART_OWNER -> next
        length: le_number(image, from + 4, 4)
        if length < descriptor || 16 + length > size || image[from + 16 + label.len()] != 0 -> next
        named := true
        loop index in 0..<label.len() {
            if image[from + 16 + index] != label[index] -> named = false
        }
        if named -> return Val((at: from + 16 + descriptor, size: length - descriptor))
    }
    None
}

// The text of the part `name` of `image`, "" without one.
image_part_text: fn(image: [U8], name: String) -> String Never! {
    found: image_part(image, name) ?? return ""
    String.from_bytes_lossy(image[found.at..<found.at + found.size])
}

// The digest a jet's identity names (`jet@VERSION#<digest>`): the sha256 of
// its bytes with the bytes of its IDENTITY_PART zeroed, so the jet can carry
// its own identity, which is the sha256 of the file for a jet without that
// part (Compiler/JetCli CoreRecordCheck.jet `--embed` takes it the same way).
identity_digest: fn(image: [U8]) -> String Never! {
    found: image_part(image, IDENTITY_PART) ?? return sha256_hex(image)
    zeros := [U8]{}
    loop _ in 0..<found.size -> zeros.push(U8{0})
    hasher := crypto.Hasher.new()
    hasher.update(image[0..<found.at])
    hasher.update(zeros)
    hasher.update(image[found.at + found.size..<image.len()])
    hasher.digest()
}

// identity_digest of the jet at `path`, "" when it can't be read.
identity_digest_file: fn(path: String) -[FS]> String Never! {
    bytes: files.read_bytes(path) ?? return ""
    identity_digest(bytes)
}

read_text: fn(path: String) -[FS]> String? Never! {
    text: files.read(path) ?? return None
    Val(text)
}

read_json: fn(path: String) -[FS]> Dyn Problem! {
    text: files.read(path) ?? return Err(problem(INPUT, "cannot read {path}: {err}"))
    parsed: json.parse(text) ?? return Err(problem(INPUT, "{path} is not JSON: {err}"))
    Ok(parsed)
}

file_artifact: fn(path: String, shown: String) -[FS]> Artifact Problem! {
    bytes: files.read_bytes(path) ?? return Err(problem(STALE, "cannot read {shown}: {err}"))
    Ok(Artifact{path: shown.copy(), sha256: sha256_hex(bytes), size: bytes.len()})
}

// Every regular file under `root`, by relative path, each level sorted by
// name; symbolic links are skipped.
tree_artifacts: fn(root: String, prefix: String, out: &[Artifact]) Never! -[FS]> {
    entries: files.list_dir(root) ?? return
    names := [String]{}
    loop entry in entries -> names.push(entry.name.copy())
    names.sort_by(fn(left: String, right: String) { left <=> right })
    loop name in names {
        path: files.join(root, name)
        shown: "{prefix}/{name}"
        if files.is_symlink(path) -> next
        if {
            files.is_dir(path) -> tree_artifacts(path, shown, out)
            files.is_file(path) -> {
                if file_artifact(path, shown) == .Ok(found) -> out.push(found)
            }
        }
    }
}

// The shipped files of `dir` in SHA256SUMS order.
shipped_artifacts: fn(dir: String) -[FS]> [Artifact] Never! {
    out := [Artifact]{}
    loop name in SEED_FILES {
        path: files.join(dir, name)
        if !files.exists(path) -> next
        if {
            files.is_dir(path) -> tree_artifacts(path, name, out)
            else -> {
                if file_artifact(path, name) == .Ok(found) -> out.push(found)
            }
        }
    }
    out
}

// SHA256SUMS text of `artifacts`: `<sha256>  <path>` lines.
sums_text: fn(artifacts: [Artifact]) -> String Never! {
    lines := [String]{}
    loop artifact in artifacts -> lines.push("{artifact.sha256}  {artifact.path}")
    "{lines.join("\n")}\n"
}

first_line: fn(text: String) -> String Never! {
    text.partition("\n").head.trim().copy()
}

// Reads `dir`. Missing or malformed inputs become problems, so one run
// reports all of them.
read_release: fn(dir: String) -[FS]> Release Never! {
    release := Release{dir: dir.copy(), kind: "build", identity: "", jet_sha256: "", identity_sha256: "", commit: "", seed: "", name: "", target: "", version_stamp: "", s2: "", s3: "", shipped: [Artifact]{}, sums: "", runtime_key: "", runtime_provenance_sha256: "", runtime_compiler_sha256: "", runtime_packer: "", admission: Dyn.Null, problems: [Problem]{}}
    admitted: files.exists(files.join(dir, "RELEASE.json"))
    release.kind = if admitted -> "admitted" else -> "build"
    required := [String]{"jet", "jet-runtime", "IDENTITY", "SHA256SUMS"}
    if !admitted -> required.extend([String]{"COMMIT", "SEED", "BUILD.json"})
    loop name in required {
        if !files.exists(files.join(dir, name)) -> release.problems.push(problem(INPUT, "{dir} lacks {name}: not a release directory `build` made or a release `admit` admitted"))
    }
    if release.problems.len() > 0 -> return release
    release.identity = first_line(read_text(files.join(dir, "IDENTITY")) ?? "")
    release.version_stamp = first_line(read_text(files.join(dir, "VERSION")) ?? "")
    jet: files.read_bytes(files.join(dir, "jet")) ?? [U8]{}
    release.jet_sha256 = sha256_hex(jet)
    release.identity_sha256 = identity_digest(jet)
    release.runtime_packer = image_part_text(jet, RUNTIME_PACKER_PART).trim().copy()
    release.shipped = shipped_artifacts(dir)
    release.sums = read_text(files.join(dir, "SHA256SUMS")) ?? ""
    release.runtime_key = first_line(read_text(files.join(dir, "jet-runtime/native.key")) ?? "")
    provenance_path: files.join(dir, "jet-runtime/provenance.json")
    if files.read_bytes(provenance_path) == .Ok(bytes) {
        release.runtime_provenance_sha256 = sha256_hex(bytes)
        if read_json(provenance_path) == .Ok(provenance) -> release.runtime_compiler_sha256 = text_field(provenance, "compilerSha256")
    }
    if admitted {
        record: read_json(files.join(dir, "RELEASE.json")) ?? {
            release.problems.push(problem(ADMISSION, err.text))
            return release
        }
        release.commit = text_field(record, "commit")
        release.name = text_field(record, "name")
        release.seed = text_field(field(record, "seed"), "identity")
        release.target = text_field(record, "target")
        chain: field(record, "chain")
        release.s2 = text_field(chain, "s2")
        release.s3 = text_field(chain, "s3")
        release.admission = record
        return release
    }
    release.commit = first_line(read_text(files.join(dir, "COMMIT")) ?? "")
    release.seed = first_line(read_text(files.join(dir, "SEED")) ?? "")
    built: read_json(files.join(dir, "BUILD.json")) ?? {
        release.problems.push(err)
        return release
    }
    release.target = text_field(built, "target")
    chain: field(built, "chain")
    release.s2 = text_field(chain, "s2")
    release.s3 = text_field(chain, "s3")
    release
}
