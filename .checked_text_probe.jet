enum TextError {
    Bad
}

Pattern :: distinct String

impl Pattern.CheckedText {
    type Error = TextError

    fn check(text: String) () TextError! -[]> {
        if text == "" -> return Err(TextError.Bad)
        return Ok(())
    }

    fn encode_hole<T: Printable>(value: T) String -[]> {
        return "{value}"
    }
}

fn take(value: Pattern) String -[]> { return "ok" }

fn run() {
    value :: Pattern{"hello {1}"}
    print(take(value))
    dynamic :: Pattern.from("world") ?? Pattern.raw("fallback")
    print(take(dynamic))
}
