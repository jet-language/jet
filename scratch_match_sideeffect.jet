enum D { Null Array([D]) }
enum E { Null Begin End Item(D) }
fn append(out: &[E], value: D) {
    if value == {
        .Null -> out.push(E.Null)
        .Array(items) -> {
            out.push(E.Begin)
            loop item in items -> {
                out.push(E.Item(item))
            }
            out.push(E.End)
        }
    }
}
