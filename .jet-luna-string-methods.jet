fn run() {
    s := "  a,b\tc\n"
    print(s.find("b"))
    print(s.rfind("c"))
    print("abcb".rindex("b"))
    p := s.partition(",")
    print("{p.head}|{p.sep}|{p.tail}")
    q := s.rpartition(",")
    print("{q.head}|{q.sep}|{q.tail}")
    print("  hi  ".strip())
    print("  hi  ".lstrip())
    print("  hi  ".rstrip())
    print("a\tb".expandtabs(4))
}
