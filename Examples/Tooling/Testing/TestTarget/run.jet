// Measurement is a mode of `#Test`, not a second claim
// family. `jet test --measure` selects this claim; `jet run` keeps the program
// output below as the executable golden.
test_perf: module

run: fn() { print("sum_to(1000) = {test_perf.sum_to(1000)}") }

#Test("sum_to(1000)") {
    .measure {
        assert_eq(keep(test_perf.sum_to(1000)), 500500)
    }
}
