// Corpus, fixture, and golden helpers all read explicit paths,
// here relative to the example's own folder (the directory it runs from).
package: {
    name: "testing_projection"
    authority: { allow: [Env, FS.Read, FS.Write, IO] }
}

use testing: core.testing

run: fn() {
    corpus: testing.corpus("ProjectionData")
    fixture: testing.fixture("ProjectionData/notes.txt")
    // The corpus reads files in path order, so its first entry is the manifest.
    golden: testing.golden("ProjectionData/manifest.txt", corpus[0])
    print("corpus:{corpus.len()}")
    print("fixture:{fixture.len()}")
    print("golden:{golden}")
}
