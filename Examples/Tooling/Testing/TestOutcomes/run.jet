// Only a matched comparison passes. An empty corpus, a relation the
// callbacks can't observe, and a mismatch all fail, and a model or candidate
// whose answer changes on replay is reported as contamination, not a result.
use {
    testing: core.testing
    random: core.math.random
}

Push: enum {
    Add(value: Int)
}

same: fn(value: Dyn) -> Dyn { value.copy() }
off_by_one: fn(value: Dyn) -> Dyn {
    if value == .Int(number) -> return Dyn.Int(number + 1)
    value.copy()
}

total: fn(commands: [Push]) -> Dyn {
    sum := 0
    loop command in commands {
        if command == .Add(value) -> sum += value
    }
    Dyn.Int(sum)
}

observe: fn(value: Dyn) -> Dyn { value.copy() }

show: fn(label: String, comparison: testing.TestComparison) {
    print("{label}: {testing.status(comparison)} {testing.assert_equal(comparison)}")
}

run: fn() {
    show("equal samples", testing.compare([Dyn]{Dyn.Int(1), Dyn.Int(2)}, same, same, "typed_equality"))
    show("empty corpus", testing.compare([Dyn]{}, same, same, "typed_equality"))
    show("different answer", testing.compare([Dyn]{Dyn.Int(1)}, same, off_by_one, "typed_equality"))
    show("ordered effects", testing.compare([Dyn]{Dyn.Int(1)}, same, same, "ordered_effects"))
    show("typed failure", testing.compare([Dyn]{Dyn.Int(1)}, same, same, "typed_failure"))

    // The drifting callback reads a random stream, so a replay of the same case gives a new answer.
    stream := random.rng(7)
    drifting_model: fn(commands: [Push]) { Dyn.Int(stream.int(0, 1000000)) }
    if testing.histories<Push>(seed: 1, cases: 3, model: drifting_model, actual: total, observe: observe) == {
        .Ok(comparison) -> show("drifting model", comparison)
        .Err(error) -> print("drifting model: {error.message}")
    }
    other := random.rng(7)
    drifting_candidate: fn(commands: [Push]) { Dyn.Int(other.int(0, 1000000)) }
    if testing.histories<Push>(seed: 1, cases: 3, model: total, actual: drifting_candidate, observe: observe) == {
        .Ok(comparison) -> show("drifting candidate", comparison)
        .Err(error) -> print("drifting candidate: {error.message}")
    }
}
