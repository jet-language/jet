// Live bindings: `app.live` binds a database query to one argument list,
// `app.state` reads the binding's current Loadable snapshot, `app.invalidate`
// re-runs bindings, and `app.push` publishes a value without running the source.
use {
    app
    core.reactive.loadable.[Loadable]
}

#Error
OrderError: enum {
    EmptyStatus
}

order_count: fn(status: String) -[DB.Read]> Int OrderError! {
    if status == "" -> return Err(OrderError.EmptyStatus)
    status.len()
}

shown: fn(state: Loadable<Int, OrderError>) -> String {
    if state == {
        .Loaded(value) -> "loaded {value}"
        .Failed(reason) -> if reason == {
            .EmptyStatus -> "failed: empty status"
        }
        .Idle | .Loading -> "pending"
    }
}

run: fn() {
    pending: app.live(order_count, "pending")
    shipped: app.live(order_count, "shipped")
    print("pending {shown(app.state(pending))}")
    print("shipped {shown(app.state(shipped))}")
    // Only the "pending" binding re-runs; its value is unchanged.
    app.invalidate(order_count, "pending")
    print("pending {shown(app.state(pending))}")
    app.push(order_count, "shipped", value: 12)
    print("shipped {shown(app.state(shipped))}")
    // Every binding of the source re-runs.
    app.invalidate(order_count)
    print("shipped {shown(app.state(shipped))}")
    broken: app.live(order_count, "")
    print("broken {shown(app.state(broken))}")
    print(app.live_stats())
}
