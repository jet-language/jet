/// `#Todo` typed goal.
/// Compiles anywhere; panics at runtime with file, line, and expected type.
/// Use it to sketch code structure before filling in the implementation.
/// Fully implemented function.
double: fn(n: Int) -> Int { n * 2 }

not_yet: fn(n: Int) -> Int { return #Todo }
effect_goal: fn() -[IO]> Int {
    print("checking")
    return #Todo
}

run: fn() {
    /// Call only the implemented function; `not_yet` exists but isn't called.
    result: double(21)
    print(result)
}
