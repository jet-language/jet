// Perf fidelity signal — explicit app-read quality/perf knob.
package: {
    name: "fidelity"
    authority: { allow: [Env, IO] }
}

use perf: core.perf

// A setting outside 0.0 to 1.0 fails with `PerfError.OutOfRange`, which
// carries the rejected number; the setting stays unchanged.
try_set: fn(value: Float) {
    if perf.override_fidelity(value) == {
        .Ok(_) -> print("set {value}: fidelity is now {perf.fidelity()}")
        .Err(.OutOfRange(rejected)) -> print("{rejected} is outside 0.0 to 1.0; fidelity stays {perf.fidelity()}")
    }
}

run: fn() {
    print(perf.default_fidelity())
    print(perf.fidelity())
    perf.override_fidelity(0.5)
    print(perf.fidelity())
    perf.override_fidelity(0.1)
    if perf.fidelity() < 0.5 -> print("low quality mode")
    perf.reset_fidelity()
    print(perf.fidelity())
    // Ambient Perf uses the same source-owned static methods as the import.
    print(Perf.default_fidelity())
    Perf.override_fidelity(0.25)
    print(Perf.fidelity())
    Perf.reset_fidelity()
    print(Perf.fidelity())
    try_set(0.5)
    try_set(1.5)
    try_set(-0.25)
    perf.reset_fidelity()
    print("after reset: {perf.fidelity()}")
}
