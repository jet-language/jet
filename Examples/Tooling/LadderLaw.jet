// Config precedence ladder: Policy Tighten, BuildOptions pins, and FactLaw
// share one rung order from outer defaults to inner overrides.
#Policy(sentries: .On)

checked_step: fn(x: Int) -> Int { x + 1 }

run: fn() {
    rungs: [String]{"declaration", "package", "profile", "host-or-fleet-pin", "command-line"}
    print("rungs={rungs.join(" -> ")}")
    print("step={checked_step(41)}")
}
