// Canvas onboarding: read the graph, edit the value in Inspector, Check, Run,
// then Undo. Canvas writes and restores this Jet source; it owns no graph file.
helper: fn() -> Int { 1 }

/// Squares an integer input for this Canvas example.
square: fn(n: Int) -> Int { n * n }

/// Summarizes a checked value for the onboarding tour.
summarize: fn(limit: Int) -> Int {
    if {
        true -> { print("branch") }
        else -> { print("else") }
    }
    total: square(limit)
    return if total > 10 -> total else -> total + 1
}

run: fn() { print(summarize(4)) }
