// `jet emit` prints one compiler tier of a file, the same tree as text or,
// with `--json`, as the `emit` status; `--fn NAME` keeps one function:
//   jet emit --ast Examples/Tooling/Build/EmitTiers.jet   parsed syntax
//   jet emit --ir Examples/Tooling/Build/EmitTiers.jet    checked IR
//   jet emit --ir Examples/Tooling/Build/EmitTiers.jet --fn double
double: fn(value: Int) -> Int {
    value * 2
}

run: fn() {
    print("{double(21)}")
}
