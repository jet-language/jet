// Build options never change what a program prints, only how hard it is optimized:
//   jet run --profile=fast run.jet                  optimize: O2, from the profile
//   jet run --profile=fast -O0 run.jet  the flag replaces it, with a note
//   jet build -O1                      replaces b.optimize(.O2) from fn build
run: fn() { print("build options: ok") }
