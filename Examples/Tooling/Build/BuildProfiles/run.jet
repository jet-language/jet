// Named build profiles — an example package that declares
// custom profiles in its `build {}` block. Build this with:
//   jet build --release Examples/Tooling/Build/BuildProfiles/run.jet
//   jet build --profile=fast Examples/Tooling/Build/BuildProfiles/run.jet
//   jet build --profile=ci Examples/Tooling/Build/BuildProfiles/run.jet
// The active profile changes the rustc optimization flags but not program output.
run: fn() { print("build profiles: ok") }
