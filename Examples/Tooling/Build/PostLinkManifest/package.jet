// A post-link step: `jet build --profile=shipped --allow=Exec,FS` links
// run.jet, then runs `tools.embed_manifest` on the linked executable, which
// writes the executable it ships with Manifest.txt embedded in a section of
// its own.
name: "post_link_manifest_example"
version: "0.1.0"
edition: "2026"

build: {
    shipped: Build{
        post_link: [tools.embed_manifest]
    },
}
