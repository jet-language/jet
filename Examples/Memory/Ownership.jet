// Ownership: unmarked is read by default, `&` to write/change,
// `^` to move, `x.copy()` to copy. Functions below use read borrows by
// default, explicit write borrows, or explicit takes. Return borrowed windows
// with `-> View<T> from source`, keeping the named source alive.
show: fn(msg: String) { print(msg) }

bump: fn(n: &Int) { n += 1 }

archive: fn(name: &&String) -> String { name }

headline: fn(text: String) -> String { "== {text} ==" }

length: fn(text: String) -> Int { text.len() }

apply: fn(reader: fn(String) -> Int, text: String) -> Int { reader(text) }

// A struct field owns its value; there is no stored-reference field. Fill it
// from an explicit `x.copy()` or a move when the struct is built.
Span: struct {
    text: String
    meta: String
}

describe: fn(source: String, kind: String) {
    s: Span{text: source.copy(), meta: kind.copy()}
    print(s.text, s.meta)
}

run: fn() {
    score := 41
    bump(score)
    print(score)
    greeting: "hello"
    show(greeting)
    print(greeting)
    print(apply(length, greeting))
    print(apply((text: String) -> text.len(), greeting))
    saved: archive("vault")
    print(saved)
    print(headline("Jet"))
    describe("hello", "greeting")
}
