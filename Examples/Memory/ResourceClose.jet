//! Explicit deferred close transfers ownership beside
//! acquisition and runs once in reverse order when the scope exits.
Resource: struct {
    name: String

    impl Close {
        close: fn(&&self) { print("closed {self.name}") }
    }
}

run: fn() {
    first := Resource{name: "first"}
    defer close(first)
    second := Resource{name: "second"}
    defer close(second)
    print("body")
}
