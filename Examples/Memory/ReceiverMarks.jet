// Mark the value, not the call. `&` or `^` sits on the
// named place a call writes or takes, receiver or argument alike.
Buffer: struct {
    text: String

    append: fn(&self, chunk: String) {
        self.text = "{self.text}{chunk}"
    }
    grow: fn(&self) -> Buffer {
        self.text = "{self.text}!"
        return Buffer{text: self.text.copy()}
    }
    clear: fn(&self) {
        self = Buffer{text: "cleared"}
    }
    len: fn(self) -> Int {
        return self.text.len()
    }
    seal: fn(&&self) {
        print(self.text)
    }
}

make_buffer: fn() -> Buffer {
    return Buffer{text: "fresh"}
}

inspect: fn(buffer: Buffer) {
    print("inspect {buffer.text}")
}

edit: fn(buffer: &Buffer) {
    buffer.append(" edited")
}

run: fn() {
    buf := Buffer{text: "hello"}
    buf.append(" world")
    print(buf.len())
    // The mark binds `buf` for `grow`; the fresh result passes unmarked.
    inspect(buf.grow())
    edit(buf)
    items := [Buffer{text: "a"}, Buffer{text: "b"}]
    items[1].append("!")
    print(items[1].text)
    // A marked element receiver may replace the whole element.
    items[0].clear()
    print(items[0].text)
    // A fresh receiver takes no mark.
    print(make_buffer().len())
    total := 6
    mask := total.bit_and(3)
    print(mask)
    values := [3, 1, 2]
    values.push(values.len())
    print(values)
    buf.seal()
}
