// Pools: a parent-pointer tree over a `Pool<T>` —
// the "many owners, one value" shape Ownership.jet points at. `?Id<Node>` is
// an ordinary optional field —
// no new syntax, just the existing `Val`/`None` option type.
Node: struct {
    name: String
    parent: ID<Node>?
    children: [ID<Node>]
}

run: fn() {
    tree := Pool<Node>.new()
    root: tree.add(Node{name: "root", parent: None, children: []})
    child: tree.add(Node{name: "child", parent: Val(root), children: []})
    grandchild: tree.add(Node{name: "grandchild", parent: Val(child), children: []})
    tree[root].children.push(child.copy())
    tree[child].children.push(grandchild.copy())
    id := grandchild
    depth := 0
    loop {
        node: tree[id].parent
        if {
            node == .Val(p) -> {
                depth += 1
                id = p
            }
            else -> { break }
        }
    }
    print("grandchild depth={depth}")
    print("root has {tree[root].children.len()} child")
    print("child has {tree[child].children.len()} child")
}
