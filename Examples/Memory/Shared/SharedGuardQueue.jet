package: {
    name: "memory_shared_guard_queue"
    version: "0.1.0"
    authority: { allow: [Exec, IO, Mem.Alloc, Mem.Rc, Time.Wait] }
}

// Expert guards keep manual control after
// Ordinary shared access is plain field reads and writes. A
// guard can span helpers and wait without missing a wake; plain access cannot.
WorkQueue: struct {
    jobs: [Int]
    capacity: Int
}

produce: fn(queue: Shared<WorkQueue>, changed: Condition) {
    guard: queue.guard_edit()
    guard.wait(changed, value -> value.jobs.len() < value.capacity) ?? panic("wait failed")
    guard.value.jobs.push(7)
    changed.notify_all()
}

consume: fn(queue: Shared<WorkQueue>, changed: Condition) {
    guard: queue.guard_edit()
    _: guard.value.jobs.pop()
    changed.notify_one()
}

run: fn() {
    queue := Shared{WorkQueue{jobs: [1], capacity: 1}}
    changed := Condition.new()
    task.group workers {
        producer: task produce(queue, changed)
        consume(queue, changed)
        producer.join() ?? panic("producer failed")
    }
    print(queue.jobs.first() ?? 0)
}
