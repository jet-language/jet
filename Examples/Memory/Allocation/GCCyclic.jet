// Scoped promotion traces nested ownership and cyclic mutations
// while the source keeps ordinary bare-value syntax.
#Policy(gc)

#!Equatable
Link: enum {
    End(Int)
    Next(Link)
}

promoted_cycle: fn() -> Link {
    // The payloads remain finite value snapshots. Their promoted identities
    // form the cycle: second -> first at construction, then first -> second.
    first := Link.End(1)
    second: Link.Next(first.copy())
    first = Link.Next(second.copy())
    return first
}

promoted_replacement: fn() -> Link {
    stale: Link.End(2)
    current := Link.Next(stale.copy())
    fresh: Link.End(3)
    // Whole-value replacement removes current -> stale before adding
    // current -> fresh; the trace must not retain the stale identity.
    current = Link.Next(fresh.copy())
    return current
}

run: fn() {
    cycle: promoted_cycle()
    print(cycle)
    replacement: promoted_replacement()
    print(replacement)
}
