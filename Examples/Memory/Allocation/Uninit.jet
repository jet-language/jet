// `name := Type{ uninit }` opts out of automatic zero-fill
// for a binding, skipping the default initialisation for raw performance.
// Gated by `use core.mem`; sema proves every read happens after a write on all
// paths (E0420).
//
// The canonical use case is large fixed buffers filled by I/O calls — a real
// syscall-style fill avoids zero-initializing memory that is immediately overwritten.
// Here we use plain scalars to keep the example self-contained and deterministic.
use core.mem

run: fn() {
    #Unsafe("uninitialized plain-data storage is filled before every read") {
        // A scalar left uninit: the compiler proves `n` is written before `print(n)`.
        n := Int{ uninit }
        n = 99
        print(n)
        // Both branches write `m`, so every read path is provably post-write.
        m := Int{ uninit }
        if {
            1 > 0 -> { m = 10 }
            else -> { m = 20 }
        }
        print(m)
    }
    uninit_buffer_lesson()
}

// Fixed plain-data scratch without payload zero-fill.
// Sema tracks each fixed index and permits reads only after every slot has
// been written.

uninit_buffer_lesson: fn() {
    bytes := [U8#4]{ uninit }
    bytes[0] = 65
    bytes[1] = 66
    bytes[2] = 67
    bytes[3] = 68
    print("{bytes[0]} {bytes[1]} {bytes[2]} {bytes[3]}")
}
