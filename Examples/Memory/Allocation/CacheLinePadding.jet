// `#build.cpu.cache_line` is the cache-line size of the
// selected CPU in bytes. Jet does not select CPUs yet, so it is 64 on every
// target. Aligning a hot struct to the line keeps two of them from sharing
// one line, so threads that write neighbouring counters stop slowing each
// other down (false sharing).
#Layout(c, align(#build.cpu.cache_line)) PaddedCounter: struct {
    hits: Int
}

Counter: struct {
    hits: Int
}

PADDED_ALIGN: #run { PaddedCounter.reflect().layout.alignment ?? -1 }

PADDED_SIZE: #run { PaddedCounter.reflect().layout.size ?? -1 }

PLAIN_ALIGN: #run { Counter.reflect().layout.alignment ?? -1 }

PLAIN_SIZE: #run { Counter.reflect().layout.size ?? -1 }

run: fn() {
    print(#build.cpu.cache_line)
    print("padded: align {PADDED_ALIGN} size {PADDED_SIZE}")
    print("plain: align {PLAIN_ALIGN} size {PLAIN_SIZE}")
    counters := [PaddedCounter]{PaddedCounter{hits: 0}, PaddedCounter{hits: 0}}
    counters[1].hits += 3
    print(counters[1].hits)
}
