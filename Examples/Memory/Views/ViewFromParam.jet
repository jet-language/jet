// Parameter `from` requires the argument view to borrow
// from a named sibling parameter (Rust's 'b: 'a, spelled with names).
use_window: fn(window: View<Int> from packet, packet: [Int]) { print(window[0]) }

run: fn() {
    packet := [9, 8, 7]
    window: packet[0..1]
    use_window(window, packet)
    view_from_callback_lesson()
    view_from_slots_lesson()
    view_from_trait_lesson()
}

// function-type `from` names which callback args a returned
// view may borrow. Inference stays the default; this spelling is opt-in.
// Function types do not keep surface parameter names through fmt, so the
// owner spelling is the parser's synthetic `_N` index (same as an unnamed param).
first_field: fn(line: String, _noise: String) -> View<str> {
    text: line.before(":")
    return text
}

scan: fn(input: String, noise: String, pick: fn(String, String) -> View<str> from _0) -> View<str> from input {
    return pick(input, noise)
}

view_from_callback_lesson: fn() {
    packet: "alpha:beta"
    filler := "ignored"
    chosen: scan(packet, filler, first_field)
    // `from _0` keeps filler free while chosen is live.
    filler = "still ok"
    print(chosen)
    print(filler)
}

// per-slot `from (field: sources)` on an aggregate result.
Token: struct {
    text: View<str>
}

from_primary: fn(primary: String, _fallback: String) -> Token from (text: primary | _fallback) {
    text: primary.before(":")
    return Token{text: text}
}

from_fallback: fn(_primary: String, fallback: String) -> Token from (text: _primary | fallback) {
    text: fallback.before(":")
    return Token{text: text}
}

view_from_slots_lesson: fn() {
    main: "alpha:1"
    spare: "beta:2"
    a: from_primary(main, spare)
    b: from_fallback(main, spare)
    print(a.text)
    print(b.text)
}

// A trait method may declare `from self` so the owner
// contract is explicit. Static dispatch through the impl is proven here;
// open (dyn) dispatch is the same declaration and is covered by check tests.
Slice: trait {
    head: fn(self) -> View<Int> from self
}

Packet: struct {
    data: [Int]

    impl Slice {
        head: fn(self) -> View<Int> from self { self.data[0..1] }
    }
}

view_from_trait_lesson: fn() {
    p: Packet{data: [9, 8, 7]}
    print(p.head()[0])
}
