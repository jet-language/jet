// The compiler chooses when a name is unmarked, and a
// mark gives exact control. `ys: xs` reads `xs` through a view, `xs.copy()` is an
// independent copy, and `xs.move()` moves `xs` exactly: after it, `xs` is gone.
// A last use moves with no mark at all.
Box: struct {
    items: [Int]
}

Ticket: struct {
    code: String

    redeem: fn(&&self) -> String { return "redeemed {self.code}" }
}

keep: fn(values: &&[Int]) -> [Int] { values.move() }

run: fn() {
    xs := [1, 2, 3]
    view: xs
    print("view sees {view.len()} items")

    dup := xs.copy()
    dup.push(4)
    print("copy has {dup.len()}, xs still has {xs.len()}")

    moved := xs.move()
    print("moved has {moved.len()}")

    parts := [7, 8]
    boxed: Box{items: parts.move()}
    print("box holds {boxed.items.len()}")

    rows := [9]
    grid: [[Int]]{rows.move()}
    print("grid has {grid.len()} row")

    first := [5]
    target := [0, 0]
    target = first.move()
    print("target is {target}")

    kept: keep(moved)
    print("kept {kept}")

    // A last use takes its receiver with no mark; `ticket.redeem()` is the
    // same call with the exact mark written.
    ticket := Ticket{code: "A1"}
    print(ticket.redeem())
    spare := Ticket{code: "B2"}
    print(spare.redeem())
}
