// Scope-exit cleanup with `core.mem.scope.guard`.
// `scope.guard(callback)` registers a zero-parameter callback and returns a
// must-use `ScopeGuard`. Binding it (`_g1:`) keeps it until the owning scope
// exits; registration itself does not run the callback. Every exit of that
// scope runs each guard once, newest first: a normal `return Ok(...)`, a final
// `Err(...)`, and a failure that a plain fallible call carries out of the
// function. A guard left as a bare statement is rejected
// (tests/ui/scope_guard_discarded.jet records the rejection and its repair).
// `print` gives the sample an inferred IO effect; a runtime marker is an
// observation, not a substitute for that checked effect fact.
use scope: core.mem.scope

#Error
Fail: enum {
    Bad
}

with_guards: fn(succeed: Bool) -> Int Fail! {
    _g1: scope.guard(() -> print("guard 1 runs"))
    _g2: scope.guard(() -> print("guard 2 runs"))
    print("body")
    if succeed -> return Ok(42)  // normal early success still cleans up
    Err(Fail.Bad)  // final failure result also cleans up
}

propagation_path: fn() -> Int Fail! {
    _cleanup: scope.guard(() -> print("cleanup before fallback"))
    // A plain fallible call propagates Fail.Bad from with_guards. The final
    // Ok below is reached only on success, so this function's failure exit still
    // runs its own guard.
    parsed_value: with_guards(false)
    Ok(parsed_value)
}

run: fn() {
    // `??` is fallback recovery at this boundary. By the time it supplies -1,
    // the guards of `with_guards` and `propagation_path` have already run on
    // their failure exits; recovery does not skip or repeat them.
    normal_result: with_guards(true) ?? 0
    print(normal_result)
    propagated_result: propagation_path() ?? -1
    print(propagated_result)
}
