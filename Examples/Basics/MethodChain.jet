// A broken dot-chain keeps one step per line, each freely commented.
User: struct {
    active: Bool
    name: String
}

run: fn() {
    raw: "  hello world  "
    shout: raw
        .trim()  // drop the padding
        .to_upper()  // raise your voice
        .replace("O", "0")  // leetspeak the vowels
    print("{shout}")
    // A short chain stays on one line.
    n: "Jet".to_lower().len()
    print("{n}")

    // A one-parameter callable can use its subject directly.
    lengths: ["a", "bb"].map(.len())
    print(lengths)
    users: [User]{
        {active: true, name: "Ada"},
        {active: false, name: "Grace"},
    }
    names: users.filter(.active).map(.name)
    print(names)
    shouting: users.map(.name.to_upper())
    print(shouting)
}
