// A file with `run: fn` runs that body (ScriptStatements.jet is the
// top-level-statement form). Module declarations remain available to every
// function in the file; module state a function changes lives in a `shared`
// holder.
Count: struct { value: Int }

LIMIT: 2
COUNTER: shared Count{value: 0}

run: fn() {
    print("script entry")
    print(LIMIT)
    COUNTER.value += LIMIT
    print(COUNTER.value)
    print(even(LIMIT + 2))
    print(helper())
}

helper: fn() -> String { "declaration" }

even: fn(n: Int) -> Bool { if n == 0 -> true else -> odd(n - 1) }

odd: fn(n: Int) -> Bool { if n == 0 -> false else -> even(n - 1) }
