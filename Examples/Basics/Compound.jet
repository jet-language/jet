// Compound assignment (S17): `n += 1` means `n = n + 1`.
// `+=` `-=` `*=` work on Int and Float; `/=` answers a Float, so a whole
// number divides in place with `/%=`. `%=` `%%=` are Int-only;
// `<<=` `>>=` are Int-only; bit methods update through explicit assignment.
// The left side must be a mutable `:=` binding — compound-assigning an
// immutable `:` binding is an error.
// Multi-argument calls (M1): arguments separated by commas.
show: fn(label: String, num: Int) { print("{label} = {num}") }

run: fn() {
    n := 100
    n += 20
    show("after += 20", n)
    n -= 45
    show("after -= 45", n)
    n *= 2
    show("after *= 2", n)
    n /%= 4
    show("after /%= 4", n)  // `/%` divides and rounds down; `/` would give a Float
    n %= 10
    show("after %= 10", n)
    n = (n).bit_and(6)
    show("after bit_and(6)", n)
    n = (n).bit_or(9)
    show("after bit_or(9)", n)
    n = (n).bit_xor(5)
    show("after bit_xor(5)", n)
    n <<= 2
    show("after <<= 2", n)
    n >>= 3
    show("after >>= 3", n)
    price := Float{9.5}
    price *= 2.0
    print("price = {price}")
    increment_lesson()
}

// Counting up and down uses compound assignment (S17): `x += 1` and
// `x -= 1` are the one spelling. Jet has no `++`/`--`;
// an update is its own statement, so every read sees one settled value.
// Overflow traps like any `+= 1`.
increment_lesson: fn() {
    lives := 3
    tick := 0
    lives -= 1
    loop lives > 0 {
        tick += 1
        print("tick {tick} lives {lives}")
        lives -= 1
    }
    n := 5
    print(n)
    n += 1
    print(n)
    n += 1
    print(n)
    print(n)
}
