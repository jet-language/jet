// A file of top-level statements just runs: every top-level line is the
// program's entry, in order. `total := 0` is a local of that entry, which a
// later loop updates and a lambda captures; a function declared in the file
// gets it as a parameter. `LIMIT` stays a module constant every function reads.
LIMIT: 3

print("start")

total := 0

loop n in 0..<LIMIT -> total += n + 1
print("total {total}")

scaled := fn(x: Int) { x * total }

print(scaled(2))
print(describe(total))

describe: fn(value: Int) -> String { "{value} of {LIMIT * LIMIT}" }
