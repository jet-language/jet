// Builtin `print` is variadic; each argument writes its
// own line. Interpolation keeps one argument on one line. The Core term
// function takes one line at a time.
use io: core.term

run: fn() {
    count: 3
    print("first", "second", count)
    print("one line: {count} items")
    io.print("io first")
    io.print("io second")
    printable_lesson()
}

Greeting: struct {
    text: String
}

printable_lesson: fn() {
    g: Greeting{text: "hello, jet"}
    print("{g:Debug}")
}
