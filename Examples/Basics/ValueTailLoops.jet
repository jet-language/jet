// The final line of a value-expected function is in value
// position, so a finite source loop with `->` there is a collecting loop
// too, exactly as in `names: loop … -> …`. A unit
// function keeps a final `->` loop as an effect loop, and so does a
// braceless arm of a dispatch statement that is not the final line.
// Source after an all-return dispatch is unreachable; it is checked for its
// own mistakes but never as the function's value, so a dead `None` still
// takes its type from the declared result.
Param: struct {
    name: String
}

Parsed: enum {
    Row(value: Int)
    Error(text: String)
}

Batch: enum {
    One(value: Int)
    Many(values: [Int])
}

params: fn(names: [String]) -> [Param] {
    loop name in names -> Param{name: name}
}

kept_params: fn(names: [String]) -> [Param] Never! {
    loop name in names if name != "skip" -> Param{name: name}
}

above: fn(values: [Int], limit: Int) -> [Int] {
    floor: limit
    loop value in values if value > floor -> value
}

log_all: fn(log: &[String], names: [String]) {
    loop name in names -> log.push(name)
}

flatten: fn(batch: Batch) -> [Int] {
    out := [Int]{}
    if batch == {
        .One(value) -> out.push(value)
        .Many(values) -> loop value in values -> out.push(value)
    }
    out
}

parse: fn(n: Int) -> Parsed {
    if n > 0 -> Parsed.Row{value: n} else -> Parsed.Error{text: "negative"}
}

row_value: fn(n: Int) -> Int? {
    parsed: parse(n)
    if parsed == {
        .Row(value) -> return Val(value)
        .Error(_) -> return None
    }
    None
}

sign: fn(n: Int) -> Int? {
    if n > 0 -> return Val(1)
    return None
    None
}

run: fn() {
    names: [String]{"a", "skip", "b"}
    print(params(names).len())
    print(kept_params(names).len())
    print(above([Int]{1, 2, 3}, 1))
    log := [String]{}
    log_all(log, names)
    print(log)
    print(flatten(Batch.Many{values: [Int]{7, 8}}))
    print(row_value(4) ?? 0)
    print(row_value(-4) ?? 0)
    print(sign(3) ?? 0)
    print(sign(-3) ?? 0)
    unit_tail_dispatch_loops_lesson()
}

// Only a value-expected callable gives its final `if` a
// value type. In a unit function the trailing dispatch is a statement, so a
// loop ending an arm is an effect loop, exactly as it is mid-body.
Shape: enum {
    Many(items: [Int])
    Pairs(items: [Int])
    One(item: Int)
}

Writer: struct { bytes: [Int] }

put: fn(writer: &Writer, value: Int) {
    writer.bytes.push(value)
}

write_shape: fn(writer: &Writer, value: Shape) {
    if value == {
        .Many(items) -> {
            put(writer, 1)
            loop item in items -> put(writer, item)
        }
        .Pairs(items) -> {
            put(writer, 2)
            loop item in items {
                put(writer, item)
                put(writer, item)
            }
        }
        .One(item) -> put(writer, item)
    }
}

write_checked: fn(writer: &Writer, value: Shape) Never! {
    if value == {
        .Many(items) -> {
            loop item in items -> put(writer, item)
        }
        else -> put(writer, 0)
    }
}

unit_tail_dispatch_loops_lesson: fn() {
    writer := Writer{bytes: [Int]{}}
    write_shape(writer, Shape.Many{items: [Int]{2, 3}})
    write_shape(writer, Shape.Pairs{items: [Int]{4}})
    write_shape(writer, Shape.One{item: 5})
    write_checked(writer, Shape.Many{items: [Int]{6}})
    write_checked(writer, Shape.One{item: 9})
    print(writer.bytes)
}
