// A `<>` in an `if` header is its hole. Each arm head is a candidate that
// fills the hole, so the test is written once and every arm reads as a value.
// Each table here sits beside the plain code it stands for, its reference
// form, and `run` prints both.
label: fn(n: Int) -> String {
    return if n % <> == 0 {
        15 -> "FizzBuzz"
        3 -> "Fizz"
        5 -> "Buzz"
        else -> "{n}"
    }
}

label_by_hand: fn(n: Int) -> String {
    return if {
        n % 15 == 0 -> "FizzBuzz"
        n % 3 == 0 -> "Fizz"
        n % 5 == 0 -> "Buzz"
        else -> "{n}"
    }
}

// The header runs once for each arm tried, in arm order, with that arm's
// candidate in the hole. A candidate runs where the hole stands, so a traced
// candidate shows each try: an arm after the first match never runs, and a
// group `(2 | 3)` stops at its first match.
trace: fn(n: Int) -> Int {
    print("  try {n}")
    n
}

pick: fn(n: Int) {
    if n % <> == 0 {
        trace(4) -> print("four")
        (trace(2) | trace(3)) -> print("two or three")
        else -> print("other")
    }
}

pick_by_hand: fn(n: Int) {
    if {
        n % trace(4) == 0 -> print("four")
        n % trace(2) == 0 || n % trace(3) == 0 -> print("two or three")
        else -> print("other")
    }
}

// After a candidate, `&&` and `||` are ordinary operators:
// `2 && ready || emergency` reads `(n % 2 == 0 && ready) || emergency`.
gate: fn(n: Int, ready: Bool, emergency: Bool) -> String {
    return if n % <> == 0 {
        2 && ready || emergency -> "open"
        else -> "shut"
    }
}

gate_by_hand: fn(n: Int, ready: Bool, emergency: Bool) -> String {
    return if {
        (n % 2 == 0 && ready) || emergency -> "open"
        else -> "shut"
    }
}

// A Bool candidate is written in parentheses.
both: fn(a: Bool, b: Bool) -> Bool { a && b }

sign: fn(n: Int) -> String {
    return if both(<>, n > 0) {
        (n % 2 == 0) -> "positive and even"
        (n < 10) -> "positive, odd and small"
        else -> "something else"
    }
}

sign_by_hand: fn(n: Int) -> String {
    return if {
        both(n % 2 == 0, n > 0) -> "positive and even"
        both(n < 10, n > 0) -> "positive, odd and small"
        else -> "something else"
    }
}

// A case candidate fills the hole as a value.
Light: enum {
    Red,
    Amber,
    Green,
}

wait_secs: fn(light: Light) -> Int {
    if light == {
        .Red -> 30
        .Amber -> 5
        .Green -> 0
    }
}

first_longer: fn(limit: Int) -> String {
    return if wait_secs(<>) > limit {
        .Green -> "green"
        .Amber -> "amber"
        .Red -> "red"
        else -> "none"
    }
}

first_longer_by_hand: fn(limit: Int) -> String {
    return if {
        wait_secs(Light.Green) > limit -> "green"
        wait_secs(Light.Amber) > limit -> "amber"
        wait_secs(Light.Red) > limit -> "red"
        else -> "none"
    }
}

// A pattern slot belongs to the plain `subject == {` table, which matches
// each arm against its subject: pattern arms bind payloads and cover every
// case, so the table needs no `else`.
Shape: enum {
    Circle(Int),
    Square(Int),
}

area: fn(shape: Shape) -> Int {
    return if shape == {
        .Circle(r) -> 3 * r * r
        .Square(side) -> side * side
    }
}

area_by_hand: fn(shape: Shape) -> Int {
    if shape == .Circle(r) -> return 3 * r * r
    if shape == .Square(side) -> return side * side
    0
}

// An error raised while the header runs leaves the table and the function,
// as any other call's error would. A table at the end of a body is its value.
#Error
ReadError: enum {
    Empty,
}

width: fn(text: String) -> Int ReadError! {
    if text == "" -> return Err(ReadError.Empty)
    text.count_bytes()
}

parity: fn(text: String) -> String ReadError! {
    if width(text) % <> == 0 {
        2 -> "even"
        else -> "odd"
    }
}

parity_by_hand: fn(text: String) -> String ReadError! {
    if {
        width(text) % 2 == 0 -> "even"
        else -> "odd"
    }
}

run: fn() {
    loop n in [9, 10, 15, 7] { print("{label(n)} {label_by_hand(n)}") }
    loop n in [8, 6, 7] {
        pick(n)
        pick_by_hand(n)
    }
    print("{gate(4, true, false)} {gate_by_hand(4, true, false)}")
    print("{gate(4, false, false)} {gate_by_hand(4, false, false)}")
    print("{gate(5, false, true)} {gate_by_hand(5, false, true)}")
    loop n in [4, 3, -2] { print("{sign(n)} / {sign_by_hand(n)}") }
    loop limit in [10, 2, 60] { print("{first_longer(limit)} {first_longer_by_hand(limit)}") }
    print("{area(Shape.Circle(2))} {area_by_hand(Shape.Circle(2))}")
    print("{area(Shape.Square(3))} {area_by_hand(Shape.Square(3))}")
    print(parity("ab") ?? "failed")
    print(parity_by_hand("ab") ?? "failed")
    print(parity("abc") ?? "failed")
    print(parity_by_hand("abc") ?? "failed")
    if parity("") == {
        .Ok(word) -> { print(word) }
        .Err(_) -> print("the header's error reached the caller")
    }
    if parity_by_hand("") == {
        .Ok(word) -> { print(word) }
        .Err(_) -> print("the reference form's error reached the caller")
    }
}
// --- expected output --------------------------------------------------
// Fizz Fizz
// Buzz Buzz
// FizzBuzz FizzBuzz
// 7 7
//   try 4
// four
//   try 4
// four
//   try 4
//   try 2
// two or three
//   try 4
//   try 2
// two or three
//   try 4
//   try 2
//   try 3
// other
//   try 4
//   try 2
//   try 3
// other
// open open
// shut shut
// open open
// positive and even / positive and even
// positive, odd and small / positive, odd and small
// something else / something else
// red red
// amber amber
// none none
// 12 12
// 9 9
// even
// even
// odd
// odd
// the header's error reached the caller
// the reference form's error reached the caller
