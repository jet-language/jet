// loop_forms — the shapes of the single `loop` keyword.
// `loop { }` is infinite (leave with `break`); `loop cond { }` is conditional
// (there is no `while` keyword); `loop x in iter { }` is source iteration
// (there is no `for` keyword).
// `loop (key, value) in map { }` binds map pairs;
// `loop (i, item) in list { }` binds index then item; `loop i in list.indexes()`
// binds an index only. `in` joins a source binding to its source, and commas
// separate later clauses such as a stride.
// A source and its optional stride are evaluated once, left to right. A
// statement-position loop runs immediately and discards the body value. A
// finite value-position loop (`loop item in items -> value`) is also eager and
// returns a List; use `.lazy()` on a collection pipeline when evaluation must
// be deferred.
// `:` below keeps the source binding immutable; iteration reads the source and
// does not mutate it. A `:=` binding such as `sum` is the state the body
// changes; a statement-position loop returns nothing, so that binding carries
// its result out.
// `break` leaves the loop at once and `next` skips to the next source value;
// neither returns a value from a statement-position loop. The explicit-state
// form (`loop i := 0, i < n { ... }`) owns its mutable header state in the
// body.
run: fn() {
    // 1. Infinite loop, left with `break`.
    n := 0
    loop {
        n += 1
        if n == 3 -> break
    }
    print("infinite stopped at {n}")
    // 2. Conditional loop.
    c := 0
    loop c < 3 -> c += 1
    print("conditional ran to {c}")
    // 3. Iterator loop over a list (item only).
    sum := 0
    loop x in [10, 20, 30] -> sum += x
    print("iterator sum {sum}")
    // 4. Two-binding over a list — index comes free, no bounds math. The
    // immutable `items` binding and its list storage are only read here.
    items: [String]{"a", "b"}
    loop (i, item) in items -> print("pair {i}:{item}")
    // 5. Index-only, always in bounds for this source.
    loop i in items.indexes() -> print("idx {i}")
    // 6. Two-name iteration over a map (sorted by key).
    scores := [String:Int]{}
    scores["ana"] = 1
    scores["bo"] = 2
    loop (name, score) in scores -> print("{name} = {score}")
    // 7. Inclusive `..` beside exclusive `..<`.
    loop i in 0..2 -> print("incl {i}")
    loop i in 0..<3 -> print("excl {i}")
    // 8. Source-range iteration. `next` advances the source and skips the rest
    // of this body; it does not introduce an afterthought or mutate `items`.
    loop i in 0..<3 {
        if i == 1 -> next
        print("counted {i}")
    }
    counted_loop_lesson()
    loop_bindingless_lesson()
    range_step_lesson()
    range_countdown_lesson()
}

counted_loop_lesson: fn() {
    sum := 0
    loop i in 0..<5 -> sum += i
    print(sum)
}

User: struct {
    active: Bool
    name: String
}

Order: struct {
    paid: Bool
    total: Int
}

loop_bindingless_lesson: fn() {
    users: [User]{
        {active: true, name: "Ada"},
        {active: false, name: "Grace"},
    }
    orders: [Order]{
        {paid: true, total: 12},
        {paid: false, total: 20},
    }
    words: [String]{"jet", "loop"}

    names: loop users if .active -> .name
    totals: loop orders if .paid -> .total
    upper: loop words -> .to_upper()
    doubled: loop n in [1, 2] -> n * 2

    print(names)
    print(totals)
    print(upper)
    print(doubled)
}

// Counting with a source stride.
range_step_lesson: fn() {
    // `a..b` is inclusive; the third clause selects every nth value.
    print("evens 0 to 10:")
    loop n in 0..10, 2 -> print("  {n}")
    // The default stride is 1 when you omit the third clause.
    print("down the row:")
    loop n in 1..3 -> print("  {n}")
    // `step` is an ordinary name; `in` marks the source and the optional
    // stride is the later comma clause.
    step: 5
    print("a value named step: {step}")
}

// A minus step counts down from the start and includes
// the end when it lands on it. Computed ends that are backward stay empty,
// so `0..n - 1` runs zero times for an empty list.
count_items: fn(n: Int) -> Int {
    turns := 0
    loop i in 0..n - 1 -> turns += 1
    turns
}

range_countdown_lesson: fn() {
    loop i in 10..1, -1 { print(i) }
    loop j in 10..0, -3 { print(j) }
    print(count_items(0))
    print(count_items(3))
    start: 4
    stop: 1
    empty := 0
    loop k in start..stop -> empty += 1
    print(empty)
}
