// A pipe runs one step per line; inside a `|>` step, `<>` is the value of the line above.
// Each step may carry its own `?? return`, and a step may read `<>` more than once.
app_port: fn(raw: [U8], fallback: Int) -> Int {
    raw
        |> String.from_bytes(<>) ?? return fallback
        |> Int.parse(<>.trim()) ?? return fallback
        |> if <> < 1 || <> > 65535 -> fallback else -> <>
}

// A pipe inside a lambda has its own steps, so there `<>` is that pipe's value.
total: fn(lines: [String]) -> Int { lines.map(fn(line) { line |> Int.parse(<>.trim()) ?? 0 }).sum() }

// A lambda inside a step captures that step's `<>`, as it captures any local.
scaled: fn(values: [Int], factor_text: String) -> [Int] {
    factor_text
        |> Int.parse(<>.trim()) ?? return values
        |> values.map(fn(v) { v * <> })
}

clamp: fn(n: Int, low: Int, high: Int) -> Int {
    if n < low -> low else if n > high -> high else -> n
}

label: fn(name: String, size: Int) -> String { "{name}#{size}" }

// A nested pipe: its first line reads the outer `<>`, and its step sees its own.
badge: fn(raw: [U8]) -> String {
    raw
        |> String.from_bytes(<>) ?? return "?"
        |> label(<>.trim(), <>.len() |> clamp(<>, 0, 9))
}

run: fn() {
    print(app_port([U8]{" 8080 "}, 80))
    print(app_port([U8]{"http"}, 80))
    print(total([" 1", "2 ", "x"]))
    print(scaled([1, 2, 3], " 10"))
    print(scaled([1, 2, 3], "ten"))
    print(badge([U8]{" hi "}))
}
