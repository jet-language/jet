// S34: digit separators, base prefixes, and float exponents.
run: fn() {
    population: 8_100_000_000
    red: 0xFF
    perms: 0o755
    flags: 0b1010
    avogadro: 6.022e23
    print("population: {population}")
    print("red channel: {red}")
    print("perms: {perms}")
    print("flags: {flags}")
    print("avogadro: {avogadro}")
    digits_lesson()
}

//! S67 (ratified): `_` digit separators in numeric literals.
//! Separators are stripped before parsing — they only aid reading, never the
//! value, and the formatter neither inserts nor removes them.
digits_lesson: fn() {
    population: 1_000_000
    balance: 1000000
    deadbeef: 3_735_928_559
    nibbles: 165
    print("population: {population}")
    print("balance: {balance}")
    print("deadbeef: {deadbeef}")
    print("nibbles: {nibbles}")
}
