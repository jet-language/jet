// Every kind of callable answers the same call the same way when its contract
// matches the function type: a named function, a lambda with no captures, a
// lambda that captures, a generic function behind a lambda or a generic
// caller, and a struct that hands out its own function. Each one goes through
// the same `fn(Int) -> Int` parameter and gives the same results.
double: fn(n: Int) -> Int { n * 2 }

sum_twice: fn<T: Numeric>(n: T) -> T { n + n }

Scale: struct {
    factor: Int

    as_fn: fn(self) -> fn(Int) -> Int {
        factor: self.factor
        (n: Int) -> n * factor
    }
}

show: fn(kind: String, f: fn(Int) -> Int) {
    print("{kind}: {f(1)} {f(5)} {f(-3)}")
}

// A generic caller runs its callback at the type it was given.
apply_each: fn<T>(values: [T], f: fn(T) -> T) -> [T] {
    values.map((value: T) -> f(value))
}

run: fn() {
    factor: 2
    show("named", double)
    show("no captures", (n: Int) -> n * 2)
    show("captures", (n: Int) -> n * factor)
    show("generic", (n: Int) -> sum_twice(n))
    show("struct", Scale{factor: 2}.as_fn())
    print("generic caller: {apply_each([1, 5, -3], double)}")
}
