// Lambdas write parameters and an optional effect row only.
#Error
LambdaError: enum {
    Invalid
}

LambdaPoint: struct {
    x: Int
}

finish: fn(n: Int) -[]> Int LambdaError! {
    Ok(n)
}

apply: fn(f: fn(Int) -[]> Int LambdaError!, n: Int) -> Int LambdaError! {
    f(n)
}

run: fn() {
    points: [41].map(x -> LambdaPoint{x})
    print(apply((n: Int) -[]> finish(n + 1), points[0].x) ?? 0)
}
