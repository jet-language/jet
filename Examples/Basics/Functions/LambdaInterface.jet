// Lambdas write parameters and an optional effect row only.
#Error
LambdaError: enum {
    Invalid,
}

LambdaPoint: struct {
    x: Int,
}

finish: fn(n: Int) -[]> Int LambdaError! {
    if n < 0 -> return Err(LambdaError.Invalid)
    Ok(n)
}

apply: fn(f: fn(Int) -[]> Int LambdaError!, n: Int) -> Int LambdaError! { f(n) }

run: fn() {
    points: [41].map(fn(x) { LambdaPoint{x: x} })
    print(apply(fn(n: Int) -[]> { finish(n + 1) }, points[0].x) ?? 0)
}
