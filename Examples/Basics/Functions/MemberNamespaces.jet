// Fields and methods have separate namespaces.
// Parentheses select an existing method; `.field.call` selects a callable field.
Counter: struct {
    value: Int
    step: fn(Int) -> Int
    call: fn(Int) -> Int

    value: fn(self) -> Int Never! { self.value + 1 }

    step: fn(self, amount: Int) -> Int Never! { self.value + amount }

    call: fn(self, amount: Int) -> Int Never! { self.value + amount + 100 }
}

Callback: struct {
    step: fn(Int) -> Int
}

make_callback: fn() -> Callback {
    print("receiver")
    Callback{step: fn(n) { n + 1 }}
}

run: fn() {
    counter: Counter{value: 10, step: fn(n) { n * 2 }, call: fn(n) { n * 3 }}
    print(counter.value)
    print(counter.value())
    print(counter.step(4))
    print(counter.step.call(4))
    print(counter.call(4))
    print(counter.call.call(4))
    callback: Callback{step: fn(n) { n + 1 }}
    print(callback.step(4))
    print(callback.step.call(4))
    print(make_callback().step(4))
}
