// What a lambda reads and changes in the locals it captures.
// A lambda that writes a captured `:=` local and is only called directly in
// its scope borrows that local: each call changes the owner's binding. An
// escaping lambda (one stored in a list here) owns its captures: a copy taken
// when it is created, so a later write to the source does not reach it. A
// lambda's body runs only when it is called, never when it is built.
twice: fn(f: fn(Int)) {
    f(2)
    f(3)
}

run: fn() {
    count := 0
    bump: fn(n: Int) {
        count += n
    }
    bump(2)
    bump(3)
    print("bound {count}")

    total := 0
    twice(
        fn(n: Int) {
            total += n
        },
    )
    print("argument {total}")

    base := 10
    snapshot: fn() { base }
    kept: [snapshot]
    base = 20
    print("escaping copy {kept[0]()}, source {base}")
    closure_capture_snapshot_lesson()
}

Box: struct {
    value: Int
}

// `next` writes `count`, so it borrows it and every call changes it. `read`
// was built while `boxed.value` was 11 and still answers 11 after the owner
// writes 22 through its own `:=` binding.
closure_capture_snapshot_lesson: fn() {
    count := 10
    next: fn() {
        count += 1
        count
    }
    print(next())
    print(next())
    print(count)

    boxed := Box{value: 11}
    read: fn() { boxed.value }
    boxed.value = 22
    print(read())
    print(boxed.value)

    x := 2
    outer: fn(y: Int) {
        inner: fn(z: Int) { x + y + z }
        inner(4)
    }
    print(outer(3))
}
