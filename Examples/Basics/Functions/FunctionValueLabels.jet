// A function read as a value keeps its labels and defaults.
//
// `f: greet` holds the declaration's own signature, so `f` answers to the
// same labels as `greet` and fills the same defaults. A written function type
// such as `fn(String) -> String` names no labels: a value passed through one
// binds by position only.
greet: fn(name: String, greeting: String{"Hello"}, punct: String{"!"}) -> String {
    "{greeting}, {name}{punct}"
}

twice: fn(action: fn(String) -> String, name: String) -> String { "{action(name)} {action(name)}" }

run: fn() {
    f: greet
    print(f("Cy", punct: "~"))
    print(f("Ada"))
    print(f(greeting: "Hi", name: "Bo"))
    print(twice((name: String) -> greet(name, punct: "."), "Di"))
}
