// Functions are defined with `fn` and called by name.
greet: fn() { print("hi there") }

run: fn() {
    greet()
    print(42)
    greet()
    recursive_functions_arithmetic_lesson()
    recursive_return_arithmetic_lesson()
}

rec: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return rec(n - 1) + 1
}

second: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return second(n - 1) + 1
}

even: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return odd(n - 1) + 1
}

odd: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return even(n - 1) + 1
}

recursive_functions_arithmetic_lesson: fn() {
    print(rec(10))
    print(second(10))
    print(even(1000))
    print(odd(1000))
}

recurse: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return recurse(n - 1) + 1
}

recursive_return_arithmetic_lesson: fn() {
    print(recurse(10))
    print(recurse(1000))
}
