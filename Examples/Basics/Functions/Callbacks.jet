// Function-typed parameters and a stored callback.
// `apply_twice` reads `f` and `x`, changes neither, and returns the result of
// the second call. A lambda argument is built at the call site but runs only
// when `apply_twice` calls it. `w` is an immutable binding whose `step` field
// stores a callback; `w.step(4)` calls it and returns its value.
apply_twice: fn(f: fn(Int) -> Int, x: Int) -> Int { f(f(x)) }

double: fn(x: Int) -> Int { x * 2 }

Worker: struct {
    step: fn(Int) -> Int
}

run: fn() {
    double_fn: double
    print(apply_twice(double_fn, 3))
    print(apply_twice((x: Int) -> x + 1, 5))
    w: Worker{step: (n: Int) -> n * n}
    print(w.step(4))
}
