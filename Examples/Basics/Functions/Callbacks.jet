// M8: function-typed parameters and a stored callback.
apply_twice: fn(f: fn(Int) -> Int, x: Int) -> Int { f(f(x)) }

double: fn(x: Int) -> Int { x * 2 }

Worker: struct {
    step: fn(Int) -> Int
}

run: fn() {
    double_fn: double
    print(apply_twice(double_fn, 3))
    print(apply_twice((x: Int) -> x + 1, 5))
    w: Worker{step: (n: Int) -> n * n}
    print(w.step(4))
}
