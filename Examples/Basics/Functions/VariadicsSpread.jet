// Variadic parameters, call spread, and list spread.
join: fn(prefix: String, msgs: ...String) -> String { [prefix, ...msgs].join(" ") }

run: fn() {
    // variadic call — trailing args pack into `msgs`
    a: join("log:", "hello", "world")
    print(a)
    // call spread — expand an existing list
    parts: [String]{"one", "two"}
    b: join("tags:", ...parts)
    print(b)
    // list spread — flatten lists into one new list
    left: [String]{"a", "b"}
    right: [String]{"c"}
    merged: [...left, "mid", ...right]
    print(merged.join(","))
    variadic_empty_tail_lesson()
    variadic_method_lesson()
}

// The tail's element type is declared, so a call that
// omits every tail argument passes an empty `[Int]`; it needs no annotation.
largest: fn(first: Int, rest: ...Int) -> Int {
    best := first
    loop value in rest {
        if value > best -> best = value
    }
    best
}

count: fn(rest: ...String) -> Int { rest.len() }

variadic_empty_tail_lesson: fn() {
    print(largest(5))
    print(largest(5, 9, 2))
    print(count())
    print(count("a", "b"))
}

// Variadic method: rest parameter packs like a free-function variadic (I8/I9).
Logger: struct {
    id: Int
}

impl Logger {
    write: fn(self, level: String, parts: ...String) -> String { [level, ...parts].join(" ") }
}

variadic_method_lesson: fn() {
    log: Logger{id: 0}
    print(log.write("1"))
    print(log.write("2", "one"))
    print(log.write("3", "a", "b", "c"))
}
