// Parentheses call functions and lambdas only. A struct that
// should act as a function hands out a lambda through a method it writes.
Scale: struct {
    factor: Int

    apply: fn(self, n: Int) -> Int { n * self.factor }

    as_fn: fn(self) -> fn(Int) -> Int {
        factor: self.factor
        fn(n: Int) { n * factor }
    }
}

make_adder: fn(n: Int) -> fn(Int) -> Int { fn(x: Int) { x + n } }

run: fn() {
    triple: Scale{factor: 3}
    print(triple.apply(4))
    times3: triple.as_fn()
    print(times3(4))
    add40: make_adder(40)
    print(add40(2))
}
