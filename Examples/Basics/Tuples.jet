// S73: named-only tuples — literals, types, access, equality, destructure.
bounds: fn() -> (max: Int, min: Int) { (min: 0, max: 10) }

// Public APIs return new answers; no dummy & outputs.
split: fn(n: Int, d: Int) -> (quotient: Int, remainder: Int) {
    (quotient: n /% d, remainder: n % d)
}

run: fn() {
    p: (x: 1, y: 2)
    q: (y: 3, x: 4)
    same_shape: (p == q)
    { x: a, y: b }: p.copy()
    print("{p.x} {p.y} {a} {b} {same_shape}")
    pair: bounds()
    print("{pair.min} {pair.max}")
    (quotient, remainder): split(17, 5)
    print("{quotient} {remainder}")
    // Names bind the members they name, in any written order.
    (min, max): bounds()
    print("{min} {max}")
}
