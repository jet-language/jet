// Typed no-OS target example. Hosted ceremony stays off: target machines
// live beside the build (`board.sensor_v1`, `board.virt_aarch64`) and reject
// OS APIs at compile time.
// Build with:
//   jet build --target=board.sensor_v1 Examples/LowLevel/Freestanding.jet
//
// Only core-level APIs are used: no file I/O, no network, no threads.
// The named target profile admits only APIs supported by its typed providers.
use math: core.math

clamp: fn(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo -> return lo
    if x > hi -> return hi
    return x
}

run: fn() {
    a: clamp(15, 0, 10)
    b: clamp((-3), 0, 10)
    root: math.sqrt(Float{16.0})
    print("freestanding: clamp(15,0,10)={a}, clamp(-3,0,10)={b}, sqrt(16)={root}")
}
