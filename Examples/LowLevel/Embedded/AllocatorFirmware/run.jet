// Typed firmware witness for `board.sensor_v1`.
// Required machine facts: a typed `Fixed` allocator in `ram`, generated
// startup (`Reset_Handler`, `vectors`, C/1, `.vectors`), abort panic, and the
// UART byte-sink providers `board.sensor_v1.uart_rx`, `board.sensor_v1.uart_tx`,
// and `board.sensor_v1.report_uart`. If the allocator fact is absent, target
// admission must report the typed `HeapRequiresAllocator` error.
// The allocation result is observed by the assertion; hosted `core.term` is
// intentionally not imported into this Alloc-layer firmware witness.
use mem: core.mem

run: fn() {
    // One Int payload plus its 32-byte reverse-drop record.
    fixed: mem.Fixed.new(size: 40)
    if fixed.try_alloc(7) == {
        .Ok(value) -> {
            assert(value == 7, "firmware allocation")
        }
        .Err(_error) -> {
            panic("firmware allocator unavailable")
        }
    }
}
