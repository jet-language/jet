// `targets:` selects the canonical typed browser machine; provider identities
// remain owned by that machine instead of being fabricated in this package.
name: "embedded_browser_wasm"
version: "0.1.0"
edition: "2026"
targets: {
    machine: {
        profile: "web.browser"
    }
}
runtime: "hosted"
authority: {
    allow: [IO, Mem.Alloc]
}
build: {
    release: Build{
        optimize: O2
    },
    debug: Build{
        optimize: O0,
        debug_info: true
    },
}
