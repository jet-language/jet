// Hosted defaults stay hidden in the canonical machine. No target-specific
// provider or alternate Prelude is declared here.
name: "embedded_hosted_default"
version: "0.1.0"
edition: "2026"
targets: {
    machine: {
        profile: "hosted"
    }
}
runtime: "hosted"
authority: {
    allow: [IO, Mem.Alloc]
}
build: {
    release: Build{
        optimize: O2
    },
    debug: Build{
        optimize: O0,
        debug_info: true
    },
}
