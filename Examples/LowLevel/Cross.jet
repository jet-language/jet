// E2-M15: cross-compilation example.
// Build for a non-host target:
//   jet build --target=aarch64-unknown-linux-gnu Cross.jet
//
// The binary runs on aarch64-linux (or under QEMU — see Docs/spec/reference/embedded.md).
add: fn(a: Int, b: Int) -> Int { (a + b) }

run: fn() {
    result: add(3, 4)
    print("cross: 3 + 4 = {result}")
}
