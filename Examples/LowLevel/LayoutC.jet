// `#Layout(c, align(64))` — C-compatible
// struct layout with an explicit portable alignment. Field order is preserved
// as written and the trailing size/stride is padded to the effective
// alignment. Fixed-size arrays `[T#N]` are allowed; growable `[T]` / Map /
// String are rejected (E1104).
#Layout(c, align(64)) Vec3: struct {
    x: Float
    y: Float
    z: Float
}

dot: fn(a: Vec3, b: Vec3) -> Float { a.x * b.x + a.y * b.y + a.z * b.z }

run: fn() {
    a: Vec3{x: 1.0, y: 0.0, z: 0.0}
    b: Vec3{x: 0.0, y: 1.0, z: 0.0}
    print(dot(a, b))
}
