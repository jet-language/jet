// A fixed array of numbers `[T#N]` takes the arithmetic and bit operators slot
// by slot: with another `[T#N]` of the same length and element type, or with
// one value of the element type on either side. Each slot is that operator on
// one pair of elements, so it keeps the element's own rules: fixed widths
// wrap or stop as their scalars do, and `Int / Int` is an exact Fraction.
// `==` still compares whole arrays.
run: fn() {
    a: [Int#4]{1, 2, 3, 4}
    b: [Int#4]{10, 20, 30, 40}
    print(a + b)
    print(b - a)
    print(a * b)
    print(b % [Int#4]{3, 3, 3, 3})
    print(a * 10)
    print(100 - a)
    print(-a)
    print(a + b * 2)
    print(a == [Int#4]{1, 2, 3, 4})
    print(a + a == a * 2)

    halves: [Int#2]{1, 3} / [Int#2]{2, 4}
    print(halves)

    p: [Float#3]{1.5, -2.0, 0.25}
    q: [Float#3]{0.5, 4.0, 2.0}
    print(p + q)
    print(p * q)
    print(p / q)
    print(p * 2)
    print(0.5 * q)
    print(-p)

    bits: [U8#4]{0b1100, 0b1010, 0x70, 1}
    mask: [U8#4]{0b1010, 0b1010, 0x0F, 3}
    print(bits & mask)
    print(bits | mask)
    print(bits ~ mask)
    print(~bits)
    print(bits << 1)
    print(bits >> 2)

    lanes: [I32#3]{-7, 0, 7}
    print(lanes * lanes - 1)
}
