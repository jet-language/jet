// Hosted execution is the replay tier. Override the target at build time for
// board.sensor_v1 once the toolchain and target-provider gates are available.
name: "embedded_battery"
version: "0.1.0"
edition: "2026"
deps: {
    embedded: "0.1.0",
}
targets: { machine: { profile: "hosted" } }
runtime: "hosted"
authority: {
    allow: [IO, Mem.Alloc],
}
build: {
    release: Build{ optimize: full },
    debug: Build{ optimize: none, debug_info: true },
}
