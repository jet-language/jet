// 11 — Enums and exhaustive when.
Light: enum {
    Red
    Yellow
    Green
}

next: fn(light: Light) -> Light {
    return if light == {
        .Red -> .Yellow
        .Yellow -> .Green
        .Green -> .Red
    }
}

label: fn(light: Light) -> String {
    return if light == {
        .Red -> "stop"
        .Yellow -> "caution"
        .Green -> "go"
    }
}

run: fn() {
    start: Light.Red
    print(label(start))
    print(label(next(start)))
}
