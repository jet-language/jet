// Ordered enum-shaped heads fold into one table.
Shape: enum {
    Circle(Float)
    Rect(w: Float, h: Float)
}

area: fn(Circle(r: Float)) -> Float { r * r }

area: fn(Rect(w: Float, h: Float)) -> Float { w * h }

run: fn() {
    print(area(Shape.Circle(3.0)))
    print(area(.Rect{w: 2.0, h: 4.0}))
}
