// A qualified payload case read without a call is its constructor as a
// function value; a unit case stays a value.
use core.files.[FileWriter]

Message: enum {
    Text(String)
    Pair(left: Int, right: Int)
    Quit
}

Holder: enum<T> {
    Full(T)
    Empty
}

Sink: enum {
    Out(FileWriter)
    Closed
}

describe: fn(message: Message) -> String {
    if message == {
        .Text(body) -> "text {body}"
        .Pair(left, right) -> "pair {left},{right}"
        .Quit -> "quit"
    }
}

build: fn(make: fn(String) -> Message, body: String) -> Message {
    make(body)
}

pair_with: fn(make: fn(*, left: Int, right: Int) -> Message) -> Message {
    make(right: 2, left: 1)
}

fill: fn(make: fn(Int) -> Holder<Int>, value: Int) -> Int {
    if make(value) == {
        .Full(held) -> held
        .Empty -> 0
    }
}

// A payload that can't be copied out of a read parameter is taken, so the
// constructor fits a function type that marks the take.
takes: fn(make: fn(&&FileWriter) -> Sink) -> String {
    "takes its writer"
}

run: fn() {
    // A single payload stays positional.
    print(describe(build(Message.Text, "hello")))
    texts: ["a", "b"].map(Message.Text)
    loop text in texts -> print(describe(text))
    // A named payload keeps its labels label-only.
    print(describe(pair_with(Message.Pair)))
    pair: Message.Pair
    print(describe(pair(left: 3, right: 4)))
    // The enum's type arguments come from the expected function type, or
    // are written on the case.
    print(fill(Holder.Full, 7))
    print(fill(Holder<Int>.Full, 8))
    print(takes(Sink.Out))
    // A unit case is a value, not a function.
    quit: Message.Quit
    print(describe(quit))
}
