// Value copies form finite snapshots. Memory/EntityTree.jet uses Pool for shared back-links.
Node: struct {
    value: Int
    prev: Node?
    next: Node?
}

run: fn() {
    first := Node{value: 1, prev: None, next: None}
    second: Node{value: 2, prev: Val(first.copy()), next: None}
    first.next = Val(second.copy())
    forward: first.next ?? panic("missing forward link")
    backward: forward.prev ?? panic("missing backward link")
    print(backward.value)
    print(forward.value)
}
