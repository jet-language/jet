// A variant test whose payload binds nothing is a Bool value in expression
// position, including a field-path subject and an or-pattern.
Shape: enum {
    Scalar(bits: Int)
    Pair(left: Int, right: Int)
    Empty
}

Layout: struct {
    shape: Shape
}

is_scalar: fn(layout: Layout) -> Bool { layout.shape == .Scalar(_) }

has_payload: fn(shape: Shape) -> Bool {
    found: shape == .Scalar(_) | .Pair(_, _)
    found
}

run: fn() {
    print(is_scalar(Layout{shape: Shape.Scalar{bits: 8}}))
    print(is_scalar(Layout{shape: Shape.Empty}))
    print(has_payload(Shape.Pair{left: 1, right: 2}))
    print(has_payload(Shape.Empty))
}
