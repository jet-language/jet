// Test the subject first; the route leaves on a miss.
good: fn() -> Int Err! { return .Ok(7) }

bad: fn() -> Int Err! { return .Err("invalid") }

take_good: fn() -> Int {
    good() == .Ok(value) ?? return 0
    return value
}

take_error: fn() -> String {
    bad() == .Ok(value) ?? return err.message
    return "value:{value}"
}

// The same statement runs while these constants are folded and at runtime.
COMPILED_GOOD: #run take_good()

COMPILED_ERROR: #run take_error()

run: fn() {
    print(COMPILED_GOOD)
    print(take_good())
    print(COMPILED_ERROR)
    print(take_error())
}
