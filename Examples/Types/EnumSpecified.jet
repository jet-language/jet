// `#Specified` makes every case of a numbered enum state its number, so a
// case added or moved later renumbers no other: these are on-disk values.
#[Specified, Layout(U8)]
Op: enum {
    Add = 1
    Sub = 2
    Mul = 10
    Halt = 255
}

#[Specified, Layout(I16)]
Offset: enum {
    Back = -1
    Here = 0
    Ahead = 1
}

decode: fn(byte: Int) -> String {
    op: Op.from_int(byte) ?? return "bad byte {byte}: {err}"
    "op {op.to_int()}"
}

run: fn() {
    loop op in [Op.Add, Op.Sub, Op.Mul, Op.Halt] -> print(op.to_int())
    print(decode(10))
    print(decode(3))
    print(Offset.Back.to_int() + Offset.Ahead.to_int())
    print((Offset.from_int(0) ?? Offset.Back) == Offset.Here)
}
