// A number parameter, `<comptime N: Int>`, makes one instance per number: a
// `Packet<4>` and a `Packet<2>` are two types with their own lengths, and a
// body reads `N` as that instance's Int.
Packet: struct<comptime N: Int> {
    data: [Int#N]
}

// A constant is a number argument too: `Packet<WIDE>` is `Packet<8>`.
WIDE: 8

// Nested use: a `Frame<N>` holds a `Packet<N>` of the same number.
Frame: struct<comptime N: Int> {
    head: Packet<N>
    tag: Int
}

size_of: fn<comptime N: Int>(packet: Packet<N>) -> Int { N }

frame_size: fn<comptime N: Int>(frame: Frame<N>) -> Int { size_of(frame.head) + N }

total: fn<comptime N: Int>(packet: Packet<N>) -> Int {
    sum := 0
    loop value in packet.data -> sum += value
    sum
}

run: fn() {
    four: Packet<4>{data: [Int#4]{1, 2, 3, 4}}
    two: Packet<2>{data: [Int#2]{5, 6}}
    wide: Packet<WIDE>{data: [Int#8]{1, 1, 1, 1, 1, 1, 1, 1}}
    frame: Frame<2>{head: Packet<2>{data: [Int#2]{7, 8}}, tag: 9}
    print("four: size {size_of(four)}, total {total(four)}")
    print("two: size {size_of(two)}, total {total(two)}")
    print("wide: size {size_of(wide)}, total {total(wide)}")
    print("frame: size {frame_size(frame)}, tag {frame.tag}, total {total(frame.head)}")
}
