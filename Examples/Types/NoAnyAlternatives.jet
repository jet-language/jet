// Jet has no top type like Any.
// Pick the precise mechanism: enum for known variants, generics for abstraction,
// ?T for absence, and Dyn for parsed dynamic input.
use json: core.encoding.json

Payload: enum {
    Name(String)
    Count(Int)
}

echo: fn<T>(value: T) -> T { value.copy() }

label: fn(payload: Payload) -> String {
    return if payload == {
        .Name(s) -> s.copy()
        .Count(n) -> "{n}"
    }
}

run: fn() {
    p: Payload.Count(3)
    print(label(p))
    print(echo("typed"))
    maybe: Val("present")
    if maybe == .Val(s) -> print(s)
    data: Dyn{json.parse("{{\"name\":\"jet\"}}") ?? return}
    if data == .Object(_) {
        if (data.field("name") ?? Dyn.Null) == .Text(name) -> print(name)
    }
}
