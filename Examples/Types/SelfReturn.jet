// `Self` in a method signature names the impl's type: a static `-> Self`
// method returns that type, so methods chain on its result. A trait method
// written `-> Self` is implemented with either `-> Self` or the type's name.
UsageOf: enum {
    Program Children

    label: fn(self) -> String {
        if self == {
            .Program -> "this program"
            .Children -> "children"
        }
    }
    mine: fn() -> Self { UsageOf.Program }
    same: fn(self) -> Self { self.copy() }
}

Point: struct {
    x: Int

    origin: fn() -> Self { Point{x: 0} }
    moved: fn(self, by: Int) -> Self { Point{x: self.x + by} }
    shown: fn(self) -> String { "p{self.x}" }
}
Grow: trait {
    grown: fn(self) -> Self
    fresh: fn() -> Self
}

Counter: struct {
    n: Int

    impl Grow {
        grown: fn(self) -> Self { Counter{n: self.n + 1} }
        fresh: fn() -> Self { Counter{n: 0} }
    }
}
Doubler: struct {
    n: Int

    impl Grow {
        grown: fn(self) -> Doubler { Doubler{n: self.n * 2} }
        fresh: fn() -> Doubler { Doubler{n: 1} }
    }
}
run: fn() {
    m: UsageOf.mine()
    print(m.label())
    print(UsageOf.Children.same().label())
    print(Point.origin().shown())
    print(Point.origin().moved(3).moved(4).x)
    print(Counter{n: 1}.grown().grown().n)
    print(Counter.fresh().n)
    print(Doubler.fresh().grown().grown().n)
}
