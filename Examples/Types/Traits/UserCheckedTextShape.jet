// A user trait with the shape of the Prelude's `CheckedText`: an associated
// error type, a pure checker that reads a literal's parts and fails with it
// or returns the Prelude's `Checked` record, and a pure generic encoder that
// is told the slot a hole sits in. Nothing in the Prelude's declaration is a
// form a package cannot write.
Vetted: trait {
    Error: type,
    vet: fn(parts: [String]) -[]> Checked<[String], TextSlot> Error!,
    render: fn<T: Printable>(value: T, slot: TextSlot) -[]> String,
}

#Error
CodeError: enum {
    Empty,
}

Code: distinct String

impl Code.Vetted {
    Error: CodeError,

    vet: fn(parts: [String]) -[]> Checked<[String], TextSlot> CodeError! {
        if parts.join("") == "" -> return Err(CodeError.Empty)
        Ok(Checked{shape: parts.copy(), slots: loop _ in 1..<parts.len() -> TextSlot.Text})
    }

    render: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "<{value}>" }
}

passes: fn(text: String) -> Bool {
    _: Code.vet([String]{text}) ?? return false
    true
}

run: fn() {
    print(Code.render(7, .Text))
    print(Code.render("x", .Text))
    print(passes("abc"))
    print(passes(""))
}
