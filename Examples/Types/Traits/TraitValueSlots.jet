// S48: a trait name in a field, an optional, or a declared result is an owning
// trait-value slot. A concrete implementation fills it through an owned box.
// A nonowning Read trait formal instead borrows the original concrete value;
// passing that loan does not allocate a box or clone the concrete owner.
Adapter: trait {
    go: fn(self) -> Int
}

Cloner: trait {
    go2: fn(self) -> Int
    again: fn(self) -> Cloner
}

Real: struct {
    n: Int

    impl Adapter {
        go: fn(self) -> Int { self.n }
    }

    impl Cloner {
        go2: fn(self) -> Int { self.n }
        // A declared trait result takes the concrete value.
        again: fn(self) -> Cloner { Real{n: self.n + 1} }
    }
}

Plain: struct {
    adapter: Adapter
}

Config: struct {
    adapter: Adapter?
    cloner: Cloner?
}

direct: fn(plain: Plain) -> Int {
    plain.adapter.go()
}

via_match: fn(config: Config) -> Int {
    if config.adapter == {
        None -> 0
        Val(adapter) -> adapter.go()
    }
}

via_view: fn(config: Config) -> Int {
    configured: config.cloner
    cloner: configured ?? return 0
    cloner.again().go2()
}

optional_param: fn(adapter: Adapter?) -> Int {
    found: adapter ?? return -1
    found.go()
}

make: fn(n: Int) -> Adapter {
    Real{n: n}
}

maybe: fn(n: Int) -> Adapter? {
    if n < 0 -> return None
    Val(Real{n: n})
}

maybe_go: fn(n: Int) -> Int {
    if maybe(n) == {
        None -> 0
        Val(adapter) -> adapter.go()
    }
}

run: fn() {
    print(direct(Plain{adapter: Real{n: 2}}))
    config := Config{adapter: Val(Real{n: 1}), cloner: Val(Real{n: 5})}
    print(via_match(config))
    print(via_view(config))
    print(optional_param(Val(Real{n: 7})))
    print(optional_param(None))
    print(make(3).go())
    print(maybe_go(4))
    print(maybe_go(-1))
}
