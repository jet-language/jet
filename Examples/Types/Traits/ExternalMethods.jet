Point: struct {
    x: Int
    y: Int

    label: fn(self) -> String { "point" }

    dist2: fn(self, other: Point) -> Int {
        dx: self.x - other.x
        dy: self.y - other.y
        return dx * dx + dy * dy
    }

    origin: fn() -> Point { {x: 0, y: 0} }
}

run: fn() {
    p: Point{x: 3, y: 4}
    o: Point.origin()
    print(p.label())
    print(p.dist2(o))
}
