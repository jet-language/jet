Book: struct {
    pages: Int

    impl Display {
        display: fn(self) -> String { "display:{self.pages}" }
    }

    impl Debug {
        debug: fn(self) -> String { "debug:{self.pages}" }
    }
}

run: fn() {
    book: Book{
        pages: 42,
    }
    print("{book}")
    print("{book:Debug}")
}
