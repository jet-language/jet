// Byte and budget suffixes (DataSize and Percent) are ordinary Core unit
// families in Prelude/Units.jet, and a package unit family (`hop`) works
// through the exact same `#UnitFamily` mechanism.
#UnitFamily(NetworkHops, dimension, base: hop) {
    hop
    khop(scale: 1000)
}

run: fn() {
    header: 512B
    page: 4KiB
    block: 1MiB
    print(header)
    print(page)
    print(block)
    print(page + header)
    print(block == 1024KiB)
    print(2KiB > 1500B)
    margin: 5pct
    print(margin)
    print(margin * 2)
    route: 3hop
    backbone: 1khop
    print(route)
    print(backbone + route)
    print(backbone == 1000hop)
}
