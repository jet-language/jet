// Standard units come from ordinary Prelude/Units.jet declarations.
// A custom axis uses the same open dimension algebra.
#UnitFamily(Pixel, dimension, base: px) { px }

run: fn() {
    distance: 12meter
    elapsed: 3s
    week: 1week
    speed: distance / elapsed
    _area: distance * distance
    recovered: speed * elapsed
    scaled: distance * 2
    mirrored: 2 * distance
    halved: distance / 2
    fractional: distance * 1.5
    pixels: 766px
    // Values remain ordinary zero-overhead numeric data after checking.
    print(distance)
    print(speed)
    print(recovered)
    print(scaled)
    print(mirrored)
    print(halved)
    print(fractional)
    print(pixels)
    print(week == 7d)
    print(2week + 12h)
    print(1week > 6d)
    print("{1week}")
    print("{distance:Unit(name)}")
    print("{distance:Unit(bare)}")
    print(distance.raw())
    dimensional_quantities_mass_lesson()
}

// Generic dimension algebra derives force and pressure from Mass.
dimensional_quantities_mass_lesson: fn() {
    mass: 2kilogram
    acceleration: 3meter_per_second_squared
    area: 1square_meter
    force: mass * acceleration
    pressure: force / area
    print(force)
    print(pressure)
}
