// A numeric literal may carry a unit suffix resolving to a
// Time literals are members of the canonical Prelude Time family. They
// elaborate to Duration's checked i64-nanosecond carrier.

run: fn() {
    a: 500ms
    b: 200ms
    total: a + b
    print(total)

    z: 3 + 4i
    print(z * z)
    // Complex has no order, so it is not Numeric; its
    // magnitude is its own `abs` method, a Float.
    print(z.abs())

    i: 9
    print(i)
}
