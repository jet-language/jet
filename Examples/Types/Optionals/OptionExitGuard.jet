// After an `x == None` guard that always leaves, the rest of
// the block reads `x` as its payload.
same: fn(left: [Int]?, right: [Int]?) -> Bool {
    if left == None -> return right == None
    if right == None -> return false
    if left.len() != right.len() -> return false
    loop (i, item) in left {
        if item != right[i] -> return false
    }
    true
}

plus_one: fn(x: Int?) -> Int {
    if x == None {
        print("no value")
        return 0
    }
    x + 1
}

total: fn(values: [Int?]) -> Int {
    sum := 0
    loop value in values {
        if value == None -> next
        sum += value
    }
    sum
}

run: fn() {
    print("{same(Val([1, 2]), Val([1, 2]))} {same(Val([1]), None)} {same(None, None)}")
    print(plus_one(Val(4)))
    print(plus_one(None))
    print(total([Val(1), Int?{None}, Val(5)]))
    option_else_complement_lesson()
    option_refine_scope_lesson()
}

// The `else` of a guard table holds the payload of every
// stable Optional an `x == None` arm tests. Arms after the `x == None` arm
// still read the whole Optional; only `else` is proven present.
pick: fn(v: Int) -> Int? {
    if v > 0 -> return Val(v)
    None
}

classify: fn(seed: Int) -> String {
    x: pick(seed)
    if {
        x == None -> return "none"
        (x ?? 0) > 100 -> return "big"
        else -> return "small {x + 1}"
    }
}

// A one-arm `x == None` test with `else`: the `else` branch holds the payload,
// in statement and value position alike.
statement_form: fn(seed: Int) -> Int {
    x: pick(seed)
    out := 0
    if x == None -> out = -1 else -> out = x * 2
    out
}

value_form: fn(seed: Int) -> Int {
    x: pick(seed)
    if x == None -> 0 else -> x * 3
}

option_else_complement_lesson: fn() {
    print(classify(0))
    print(classify(500))
    print(classify(4))
    print(statement_form(0))
    print(statement_form(5))
    print(value_form(0))
    print(value_form(5))
}

// A proven test refines an Optional name only inside the
// branch or block it proves. After that branch or block ends, the name is
// the whole Optional again.
after_branch: fn(head: Int?) -> String {
    if head != None {
        print("inside {head + 1}")
    }
    "after {head == None}"
}

after_value_table: fn(head: Int?) -> String {
    big: if head == {
        None -> false
        Val(n) -> n > 3
    }
    if head == None -> return "none {big}"
    "some {head} {big}"
}

after_inner_guard: fn(head: Int?, flag: Bool) -> String {
    if flag {
        if head == None -> return "flag none"
        print("flag {head * 2}")
    }
    "after {head == None}"
}

Shape: enum {
    Named(String)
    Other
}

// A non-Copy subject that is read again after the table.
owned_table: fn(head: Shape?) -> String {
    record: if head == {
        None -> true
        Val(shape) -> if shape == {
            .Named(name) -> name != "Layout"
            else -> false
        }
    }
    if head == None -> return "none {record}"
    "some {record}"
}

option_refine_scope_lesson: fn() {
    print(after_branch(Val(5)))
    print(after_branch(None))
    print(after_value_table(Val(5)))
    print(after_value_table(Val(1)))
    print(after_value_table(None))
    print(after_inner_guard(Val(4), true))
    print(after_inner_guard(Val(4), false))
    print(after_inner_guard(None, false))
    print(owned_table(None))
    print(owned_table(Val(Shape.Named("Point"))))
    print(owned_table(Val(Shape.Named("Layout"))))
    print(owned_table(Val(Shape.Other)))
}
