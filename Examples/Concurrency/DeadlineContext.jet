package: {
    name: "deadline_context"
    authority: { allow: [IO, Time, Time.Wait] }
}

use time: core.time

run: fn() {
    // The fast task needs 10ms of a 1s budget, a margin far beyond any
    // scheduling delay; the slow one asks for 40ms of a 20ms budget, so its
    // sleep always ends at the deadline.
    #Deadline(1s) {
        fast: task {
            time.sleep(10ms)
            print("finished fast")
        }
        fast.join() ?? panic("fast task failed")
    }
    #Deadline(20ms) {
        slow: task {
            time.sleep(40ms)
            print("finished slow")
        }
        slow.join() ?? panic("slow task failed")
    }
}
