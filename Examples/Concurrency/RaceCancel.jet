// Race returns first success; losers cancel at runtime. Race and any follow
// task completion order, not the order of the task list.
package: {
    name: "race_cancel"
    authority: { allow: [IO, Mem.Alloc, Time] }
}

use time: core.time

slow_one: fn() -> Int {
    time.sleep(200ms)
    return 1
}

fast_seven: fn() -> Int { 7 }

run: fn() {
    winner: task.race {slow_one(), fast_seven()} ?? panic("race failed")
    print(winner)
    print(task.any {slow_one(), fast_seven()} ?? panic("any failed"))
}
