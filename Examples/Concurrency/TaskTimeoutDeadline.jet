package: {
    name: "task_timeout_deadline"
    authority: { allow: [IO, Time] }
}

// `task.timeout(delay)` installs a task deadline: the next wait point or loop
// iteration past it stops with E3003 instead of sleeping on (the retired
// core.tasks.timeout only slept).
use core.time.[sleep]

run: fn() {
    #FX(authority: Time, IO) {
        task.timeout(10ms)
        print("deadline installed")
        sleep(2s)
        print("unreachable: the sleep outlived the deadline")
    }
}
