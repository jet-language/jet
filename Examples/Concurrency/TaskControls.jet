// Coroutine-grade control via task handles (internal substrate).
// Task failure uses the canonical `TaskFailure` rail.
package: {
    name: "task_controls"
    authority: { allow: [IO, Mem.Alloc, Time.Wait] }
}

use {
    tasks: core.tasks
    time: core.time
}

slow_two: fn() -> Int {
    time.sleep(50ms)
    return 2
}

run: fn() {
    me: tasks.current_task()
    tasks.yield_now()
    print(me == tasks.current_task())

    t: task 7
    t.pause()
    t.resume()
    t.cancel()
    print(t.join() ?? panic("cancelled task"))

    print(task.any {slow_two(), 1} ?? panic("any failed"))

    { sender: tx, receiver: rx }: channel<Int>()
    tx.send(9)
    tx.close()
    rx.close()
    print(9)
}
