// Coroutine-grade control via task handles (internal substrate).
// Task failure uses the canonical `TaskFailure` rail.
package: {
    name: "task_controls"
    authority: { allow: [IO, Mem.Alloc, Time.Wait] }
}

use {
    tasks: core.tasks
    time: core.time
}

slow_two: fn() -> Int {
    time.sleep(50ms)
    return 2
}

run: fn() {
    me: tasks.current_task()
    tasks.yield_now()
    print(me == tasks.current_task())

    // A task that has not started yet is cancelled before it runs.
    t: task 7
    t.pause()
    t.resume()
    t.cancel()
    if t.join() == {
        .Ok(value) -> print(value)
        .Err(_) -> print("cancelled before it ran")
    }

    // A loop that never waits keeps running under `pause()`. The strong
    // pause holds it at the check each iteration starts with, and a cancel
    // stops the loop there, paused or not.
    spinner: task {
        n := 0
        loop {
            n += 1
        }
    }
    spinner.pause(mode: .CheckLoops)
    spinner.resume()
    spinner.cancel()
    if spinner.join() == {
        .Ok(_) -> print("spinner finished")
        .Err(_) -> print("spinner stopped")
    }

    print(task.any {slow_two(), 1} ?? panic("any failed"))

    { sender: tx, receiver: rx }: channel<Int>()
    tx.send(9)
    tx.close()
    rx.close()
    print(9)
}
