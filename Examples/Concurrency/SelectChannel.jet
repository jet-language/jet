// A readiness table waits on plain endpoints.
package: {
    name: "select_channel"
    authority: { allow: [IO, Mem.Alloc, Time, Time.Wait] }
}

#Target(JS)
wait_for_work: fn(ch1: Receiver<Int>, ch2: Receiver<Int>) {
    if {
        job, ch1 -> { print(job) }
        msg, ch2 -> { print(msg) }
    }
    if {
        after 100ms -> { print("timed") }
    }
    if {
        after 100ms -> { print("else") }
    }
}

failure_label: fn(error: TaskFailure) -> String {
    if error == {
        .Panicked(reason) -> {
            return "panic:{reason}"

        }
        .DeadlineBlown -> {
            return "deadline"

        }
        .Cancelled -> {
            return "cancelled"

        }
    }
}

// Generic channel endpoints are nameable in signatures.
send_generic: fn(tx: Sender<String>) { tx.send("generic") }

receive_generic: fn(rx: &&Receiver<String>) -> Receiver<String> { return rx }

generic_endpoints: fn() {
    (sender, receiver): channel<String>()
    send_generic(sender)
    if {
        value, receive_generic(receiver) -> { print(value) }
    }
}

run: fn() {
    { sender: s1, receiver: ch1 }: channel<Int>()
    { sender: _s2, receiver: ch2 }: channel<Int>()
    s1.send(11)
    waiter: task wait_for_work(ch1, ch2)
    waiter.join() ?? panic(failure_label(err))
    print("ok")
    generic_endpoints()
}
