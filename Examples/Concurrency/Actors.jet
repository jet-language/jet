// A counter actor and a supervised worker, written with core.actor: an actor
// is a detached task that owns its state and reads messages from a channel,
// so nothing here is new syntax and every tier runs it the same way.
use actor: core.actor

Count: enum {
    Add(Int),
    Total(actor.Reply<Int>),
}

// Answers a `Total` ask with the running total, which stays the state.
answered: fn(reply: actor.Reply<Int>, total: Int) -> Int {
    reply.answer(total)
    total
}

// The counter's state is its running total; `Total` answers an ask.
count: fn(total: Int, message: Count) -> Int {
    if message == {
        .Add(amount) -> total + amount
        .Total(reply) -> answered(reply, total)
    }
}

// The worker refuses a negative amount by failing and panics on a huge one;
// its supervisor decides what happens next either way.
checked: fn(total: Int, message: Count) -> Int {
    if message == {
        .Add(amount) -> {
            if amount < 0 -> return Err("negative amount {amount}")
            if amount > 1000 -> panic("amount {amount} is too large")
            total + amount
        }
        .Total(reply) -> answered(reply, total)
    }
}

fresh: fn() -> Int { 100 }

run: fn() {
    // Sends are queued in order; an ask waits for its typed answer.
    counter: actor.spawn(0, count)
    counter.send(.Add(2)) ?? panic("counter stopped")
    counter.send(.Add(5)) ?? panic("counter stopped")
    print("counter: {counter.ask(Count.Total) ?? -1}")
    counter.stop()
    counter.send(.Add(1)) ?? print("counter refuses sends after stop")

    // The supervisor restarts the worker from `fresh()` twice, then stops it.
    // Each message runs in a group child, so a panic fails only its turn.
    worker: actor.supervise(fresh, checked, .Restart{limit: 2})
    worker.send(.Add(1)) ?? panic("worker stopped")
    print("worker: {worker.ask(Count.Total) ?? -1}")
    worker.send(.Add(-1)) ?? panic("worker stopped")
    print("after a failed turn: {worker.ask(Count.Total) ?? -1}")
    worker.send(.Add(5000)) ?? panic("worker stopped")
    print("after a panicked turn: {worker.ask(Count.Total) ?? -1}")
    worker.send(.Add(-2)) ?? panic("worker stopped")
    // A stopped actor answers no ask.
    if worker.ask(Count.Total) == None -> print("worker stopped after its restart limit")
    worker.send(.Add(3)) ?? print("worker refuses sends after stop")
}
