// All fail-fast cancels siblings when one task panics.
// Expected: process exits non-zero; stderr mentions panic (golden uses .err.out).
package: {
    name: "all_failfast"
    authority: { allow: [IO, Mem.Alloc, Time] }
}

use time: core.time

slow_one: fn() -> Int {
    time.sleep(200ms)
    return 1
}

// This example is about cancelling siblings, so it panics outright rather than
// through arithmetic. `1 / zero` no longer type-checks in an `Int`-returning function
// (the quotient is a Float), and `/%` is not a drop-in either,
// because the comptime evaluator folds a divisor it can see and stops the
// build before the task ever runs.
boom: fn() -> Int {
    panic("task failed")
    return 0
}

run: fn() {
    task.group g {
        if (task.all {slow_one(), boom()}) == {
            .Err(error) -> {
                if error == {
                    .Panicked(reason) -> { panic(reason) }
                    .DeadlineBlown -> { panic("deadline") }
                    .Cancelled -> { panic("cancelled") }
                }
            }
            .Ok(_) -> { print("unexpected success") }
        }
    }
}
