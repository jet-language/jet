// Synchronous Event registration order, priority, once,
// unsubscribe, scope cancellation and scope teardown, on every tier.
package: {
    name: "event_lifecycle"
    authority: { allow: [IO, Mem.Alloc] }
}

use event: core.event

teardown: fn(clicks: Event<Int>) {
    inner: event.scope()
    clicks.on(inner, fn(n: Int) { print("inner saw {n}") })
    print("inner active {inner.active_count()} listeners {clicks.listener_count()}")
}

run: fn() {
    app: event.scope()
    clicks: event.new<Int>()
    first: clicks.on(app, fn(n: Int) { print("first {n}") })
    clicks.once(app, fn(n: Int) { print("once {n}") })
    clicks.on_priority(app, 10, fn(n: Int) { print("urgent {n}") })
    clicks.on(app, fn(n: Int) { print("last {n}") })
    print("listeners {clicks.listener_count()} trace {clicks.trace()}")

    one: clicks.emit(1)
    print("{one.summary()} delivered={one.delivered()} queued={one.queued()} dropped={one.dropped()}")
    two: clicks.emit(2)
    print(two.summary())
    print("active {app.active_count()} first active {first.is_active()}")

    first.unsubscribe()
    first.unsubscribe()
    print("first active {first.is_active()} listeners {clicks.listener_count()}")
    print(clicks.emit(3).summary())

    teardown(clicks)
    print("after teardown listeners {clicks.listener_count()}")
    print(clicks.emit(4).summary())

    names: event.new<String>()
    names.on(app, fn(name: String) { print("hello {name}") })
    print(names.emit("jet").summary())

    app.cancel()
    app.cancel()
    print("after cancel active {app.active_count()} listeners {clicks.listener_count()}")
    print(clicks.emit(5).summary())

    late: clicks.on(app, fn(n: Int) { print("late {n}") })
    print("late active {late.is_active()} listeners {clicks.listener_count()}")
    print(clicks.emit(6).summary())
    event_policy_lesson()
}

// Synchronous event policies keep listener dispatch deterministic.

event_policy_lesson: fn() {
    policy: event.policy_sync()
    events: event.with_policy<Int>(policy)
    print("listeners:{events.listener_count()}")
}
