// #1465: POSIX process/session control under `#Unsafe`, gated by build OS
// target. Beginner `os_facts.jet` stays fact-only.
package: {
    name: "os_process_control"
    authority: { allow: [Env, FS.Write, IO, Mem.Alloc] }
}

use {
    os: core.sys
    files: core.files
}

run: fn() {
    comptime if #build.target.os == {
        .Linux -> { posix_control() }
        .MacOS -> { posix_control() }
        else -> {
            print(true)
            print(true)
            print(true)
            print(true)
            print(true)
            print(true)
            print(true)
            print(true)
        }
    }
}

posix_control: fn() {
    #Unsafe("POSIX process and pipe control for the core.sys surface") {
        pg: os.getpgid(0) ?? -1
        print(pg >= 0)

        sid: os.getsid(0) ?? -1
        pid: os.pid()
        if {
            sid == pid -> {
                print(true)
                print(true)
            }
            else -> {
                print(os.setpgid(0, 0) ? _ok -> true ! _error -> false)
                print(os.setpgrp() ? _ok -> true ! _error -> false)
            }
        }

        old: os.umask(18)
        _: os.umask(old)
        print(old >= 0)

        prio: os.getpriority(0) ?? 0
        print(os.setpriority(0, prio) ? _ok -> true ! _error -> false)

        print(os.kill(os.pid(), 0) ? _ok -> true ! _error -> false)

        os.pipe() ? fds -> {
            print(fds.len() == 2)
            os.close_fd(fds[0])
            os.close_fd(fds[1])
        } ! _error -> {
            print(false)
        }

        // Prefer `os.temp_dir` so default `jet run` stays I9-parity without
        // needing `files.temp_dir` host coverage.
        path: "{os.temp_dir()}/jet-os-fifo-{os.pid()}"
        print(os.mkfifo(path, 420) ? _ok -> true ! _error -> false)
        files.remove(path).drop("remove temporary FIFO")
    }
}
