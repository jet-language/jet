// `process.exit(101)` ends a program with the user-error status 1, since 101
// is the status of a Jet defect (S36). A tool that reports a defect, such as
// a compiler that panicked, ends with 101 through the audited
// `process.exit_unmapped`, which passes its status through unchanged.
package: {
    name: "process_exit_unmapped"
    authority: { allow: [Env, Exec, Exec.Args, IO, Mem.Alloc] }
}

use {
    process: core.process
    os: core.sys
}

run: fn() {
    exe: os.executable()
    role: process.args().get(0) ?? ""
    if role == {
        "user" -> process.exit(101)
        "defect" -> {
            #Unsafe("this child reports a Jet defect status on purpose") {
                process.exit_unmapped(101)
            }
        }
        else -> {}
    }
    loop mode in ["user", "defect"] {
        receipt: process.run_spec(process.cmd([exe, mode])) ?? panic("relaunching {exe} failed")
        print("{mode}: exit {receipt.code}")
    }
}
