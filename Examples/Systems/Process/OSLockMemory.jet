// `core.sys.lock_memory` keeps this program's pages in RAM, out of swap, from
// each page's first touch (mlockall with MCL_ONFAULT); `future: true` also
// locks memory mapped later. Without privilege the locked-memory limit
// bounds it, so a run may be refused with an IOError, and a host without
// page locking (the web) refuses it too. The lock lasts until the program
// ends; there is no unlock, since that would unlock a Secret's pages too.
package: {
    name: "os_lock_memory"
    authority: { allow: [Env, IO, Mem.Alloc] }
}

use os: core.sys

run: fn() {
    // Whether this run may lock depends on its limit and privilege, so both
    // outcomes print the same line.
    os.lock_memory().drop("a refused lock leaves the pages unlocked")
    print("lock_memory: locked or refused")
    os.lock_memory(future: true).drop("a refused lock leaves the pages unlocked")
    print("lock_memory(future: true): locked or refused")
}
