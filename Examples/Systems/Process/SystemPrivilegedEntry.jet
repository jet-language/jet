// Audited identity/session controls for a disposable user namespace only.
package: {
    name: "system_privileged_entry"
    authority: { allow: [Env, Exec] }
}

use sys: core.sys

run: fn() {
    #Unsafe("run only inside a disposable user namespace with a dedicated test identity") {
        sys.setuid(0) ?? return
        sys.setgid(0) ?? return
        sys.initgroups("jet", 0) ?? return
        sys.setsid() ?? return
    }
}
