// Stopping a child that has already finished succeeds: `kill`, `terminate` and
// `interrupt` have nothing left to signal, so they return without an error,
// and `wait` still hands back the finished child's receipt.
package: {
    name: "process_kill_after_exit"
    authority: { allow: [Exec, IO, Mem.Alloc, Time.Wait] }
}

use {
    process: core.process
    time: core.time
}

run: fn() -[Exec, IO, Time.Wait]> {
    child: process.cmd(["true"]).spawn() ?? panic("spawn failed")
    // `exited` polls without blocking; once it says yes, the child is gone.
    loop !(child.exited() ?? panic("exited failed")) -> time.sleep(5ms)
    print("exited: true")
    child.kill() ?? panic("kill after exit: {err}")
    print("kill after exit: ok")
    child.terminate() ?? panic("terminate after exit: {err}")
    print("terminate after exit: ok")
    child.interrupt() ?? panic("interrupt after exit: {err}")
    print("interrupt after exit: ok")
    receipt: child.wait() ?? panic("wait failed")
    print("success: {receipt.success}")
}
