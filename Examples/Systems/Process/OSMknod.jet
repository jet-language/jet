// `core.sys.mknod` makes a character or block device file under `#Unsafe`.
// Only a privileged process may make one; an ordinary run, or a host without
// device files (the web), gets an IOError. A device number out of range is
// refused before any system call.
package: {
    name: "os_mknod"
    authority: { allow: [Env, FS, FS.Write, IO, Mem.Alloc] }
}

use {
    os: core.sys
    files: core.files
}

run: fn() {
    comptime if $build.os == {
        .Linux -> { device_files() }
        .MacOS -> { device_files() }
        .Windows -> {
            print("major 4096: refused")
            print("minor -1: refused")
            print("null device: made or refused")
        }
    }
}

device_files: fn() {
    path: "{os.temp_dir()}/jet-os-mknod-{os.pid()}"
    #Unsafe("make a device file in the temporary directory and remove it") {
        print(os.mknod(path, 0o600, .Character, 4096, 0) ? _ok -> "major 4096: made" ! _error -> "major 4096: refused")
        print(os.mknod(path, 0o600, .Block, 0, -1) ? _ok -> "minor -1: made" ! _error -> "minor -1: refused")
        // 1:3 is /dev/null's device number. Whether this run may make it
        // depends on its privilege, so both outcomes print the same line.
        made: os.mknod(path, 0o600, .Character, 1, 3) ? _ok -> true ! _error -> false
        print("null device: made or refused")
        if made -> files.remove(path).drop("remove the device file")
    }
}
