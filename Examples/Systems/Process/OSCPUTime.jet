// `core.sys.cpu_time(pid)` reads the CPU time any process has used (this
// program when 0), and `set_wall_clock` sets the machine's wall clock under
// `#Unsafe`. Setting the clock needs CAP_SYS_TIME, so this example only
// shows the refusal that comes before any system call: a time before 1970.
// A host with no process clocks (the web) reports `cpu_time` as an error,
// so each line prints the same on every host.
package: {
    name: "os_cpu_time"
    authority: { allow: [Env, IO] }
}

use {
    os: core.sys
    time: core.time
}

kind: fn(error: IOError) -> String {
    if error == {
        .InvalidInput(_) -> "InvalidInput"
        .NotFound(_) -> "NotFound"
        .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> "another error"
    }
}

run: fn() {
    // Starting the program already used CPU time.
    own: if os.cpu_time() == {
        .Ok(spent) -> (spent.in(.Nanoseconds) ?? 0) > 0
        .Err(error) -> true
    }
    print("this program's CPU time is positive, or unreadable here: {own}")
    parent: if os.cpu_time(os.getppid()) == {
        .Ok(spent) -> (spent.in(.Nanoseconds) ?? -1) >= 0
        .Err(error) -> true
    }
    print("the parent's CPU time reads, or is unreadable here: {parent}")
    print("cpu_time(-1): {if os.cpu_time(-1) == { .Ok(spent) -> "accepted", .Err(error) -> kind(error) }}")
    // No Linux pid is above 4194304, so no system call is made.
    print("cpu_time(4194305): {if os.cpu_time(4194305) == { .Ok(spent) -> "accepted", .Err(error) -> kind(error) }}")
    #Unsafe("posix set_wall_clock: a time before 1970 is refused before it reaches the kernel") {
        refused: if os.set_wall_clock(time.datetime(1969, 7, 20, 20, 17, 40)) == {
            .Ok(ok) -> "accepted"
            .Err(error) -> kind(error)
        }
        print("set_wall_clock(1969-07-20T20:17:40Z): {refused}")
    }
}
