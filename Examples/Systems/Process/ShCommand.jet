// `Sh{"…"}` is a whole command line as checked text: its literal words are
// argv items and each `{hole}` is exactly one more, never split or
// expanded. It runs in one call: `status()` as a shell runs a plain line
// (the terminal's stdio; 128 + n after signal n), `ok()` for its verdict
// (stdout discarded, stderr passed through), `text()` for its stdout
// without the trailing newlines (`$(…)`),
// `lines()` for its stdout lines, `run()` for the whole receipt, and
// `spec()` for a run that sets a directory, environment or limit first.
// `extend(list)` appends a list's items as argv items (`"$@"`).
// `process.exit_status(receipt)` is a receipt's status as `$?` gives it:
// 124 when its timeout stopped the child, as `timeout(1)` reports one.
package: {
    name: "sh_command"
    authority: { allow: [Env, Exec, Exec.Args, IO, Mem.Alloc, Time.Wait] }
}

use {
    process: core.process
    os: core.sys
    time: core.time
}

// The child: `argv` prints each argument in brackets, `lines` prints two
// lines and two blank ones, `env` prints $GREETING, `sleep` sleeps ten
// seconds, and `fail` exits 3.
child: fn(args: [String]) {
    if args[0] == {
        "argv" -> loop arg in args.slice(1, args.len()) -> print("<{arg}>")
        "lines" -> print("one\ntwo\n\n")
        "env" -> print(os.get("GREETING") ?? "unset")
        "sleep" -> time.sleep(10s)
        else -> process.exit(3)
    }
}

run: fn() {
    args: process.args()
    if args.len() > 0 -> return child(args)
    exe: os.executable()
    word: "two words; rm -rf /"
    print(Sh{"{exe} argv {word} plain"}.text())
    print(Sh{"{exe} lines"}.lines())
    print(Sh{"{exe} lines"}.text().len())
    print(Sh{"{exe} argv"}.extend(["a b", "c"]).text())
    print("ok: {Sh{"{exe} argv"}.ok()} {Sh{"{exe} fail"}.ok()}")
    print("status: {Sh{"{exe} fail"}.status()}")
    failed: Sh{"{exe} fail"}.run()
    print("receipt: {failed.code} {failed.success}")
    print(Sh{"{exe} env"}.spec().env("GREETING", "hello").run().output.trim())
    stopped: Sh{"{exe} sleep"}.spec().timeout(1s).run()
    print("exit_status: {process.exit_status(failed)} {process.exit_status(stopped)}")
}
