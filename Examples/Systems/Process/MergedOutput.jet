// `.stderr(.Stdout)` merges a child's error output into its standard output:
// the child gets one descriptor for both, so the lines arrive in the order it
// wrote them. With `.stdout(.Capture)` both land in `receipt.output` and
// `receipt.errors` stays empty; with `.stdout(.Stream)` both arrive on
// `child.stdout`. `.Stdout` names the child's stdout, so only stderr takes it.
package: {
    name: "merged_output"
    authority: { allow: [Env, Exec, Exec.Args, FS.Read, IO, Mem.Alloc, Time.Wait] }
}

use {
    process: core.process
    os: core.sys
    term: core.term
}

// The child alternates its two streams, flushing every write.
speak: fn() {
    out := term.stdout()
    errors := term.stderr()
    loop i in 1..<4 {
        out.write_line("out {i}") ?? panic("stdout write failed")
        out.flush() ?? panic("stdout flush failed")
        errors.write_line("err {i}") ?? panic("stderr write failed")
        errors.flush() ?? panic("stderr flush failed")
    }
}

kind: fn(error: IOError) -> String {
    if error == {
        .InvalidInput(_) -> "InvalidInput"
        .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> "another error"
    }
}

run: fn() {
    exe: os.executable()
    if (process.args().get(0) ?? "") == "child" {
        speak()
        return
    }
    receipt: process.run_spec(process.cmd([exe, "child"]).stdout(.Capture).stderr(.Stdout)) ?? panic("merged run failed")
    print("captured:")
    loop line in process.stdout_lines(receipt) -> print("  {line}")
    print("errors empty: {receipt.errors == ""}")

    child: process.cmd([exe, "child"]).stdout(.Stream).stderr(.Stdout).spawn() ?? panic("merged spawn failed")
    print("streamed:")
    loop line in child.stdout.lines() -> print("  {line.trim()}")
    waited: child.wait() ?? panic("wait failed")
    stray := 0
    loop _ in child.stderr.lines() -> stray += 1
    print("stderr lines: {stray}")
    print("exit: {waited.code}")

    loop spec in [process.cmd([exe, "child"]).stdout(.Stdout), process.cmd([exe, "child"]).stdin(.Stdout)] {
        if process.run_spec(spec) == {
            .Ok(_) -> print("refused: no")
            .Err(error) -> print("refused: {kind(error)}")
        }
    }
}
