// This program's resource
// limits and usage live in core.sys. None is unlimited, sizes are bytes, and
// the children a program starts inherit the limits it set.
package: {
    name: "resource_limits"
    authority: { allow: [Env, Exec, IO, Mem.Alloc, Time.Wait] }
}

use {
    process: core.process
    sys: core.sys
}

run: fn() IOError! {
    // No core dumps from here on, for this program and its children.
    core: sys.core_file_limit()
    sys.set_core_file_limit(0, core.hard)
    after: sys.core_file_limit()
    print("core files: {after.soft ?? -1}")
    child: process.run_spec(process.cmd(["sh", "-c", "ulimit -c"]).stdout(.Capture)) ?? panic("sh did not start")
    print("child core files: {child.output.trim()}")

    // Lower the open-file soft limit, read it back, then restore it.
    files: sys.open_file_limit()
    sys.set_open_file_limit(64, files.hard)
    lowered: sys.open_file_limit()
    print("open files lowered: {lowered.soft ?? -1}")
    sys.set_open_file_limit(files.soft, files.hard)
    restored: sys.open_file_limit()
    print("open files restored: {restored.soft == files.soft}")

    // The kernel counts CPU time in whole seconds: 3600.5 s rounds up.
    cpu: sys.cpu_time_limit()
    sys.set_cpu_time_limit(3600500ms, cpu.hard)
    rounded: sys.cpu_time_limit()
    span: rounded.soft ?? panic("the CPU limit read back as unlimited")
    print("cpu limit: {span.in(.Seconds)} s")
    sys.set_cpu_time_limit(cpu.soft, cpu.hard)

    // A negative limit is refused before the kernel sees it.
    print("negative limit refused: {sys.set_open_file_limit(-1, files.hard) == .Err(.InvalidInput(_))}")

    mine: sys.usage()
    print("program peak memory recorded: {mine.peak_memory > 0}")
    print("program CPU time not negative: {mine.user.in(.Nanoseconds) >= 0 && mine.system.in(.Nanoseconds) >= 0}")
    children: sys.usage(of: .Children)
    print("children peak memory recorded: {children.peak_memory > 0}")
}
