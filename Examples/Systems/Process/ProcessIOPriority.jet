// `.io_priority(level)` puts the child in the best-effort I/O scheduling
// class at level 0 (first) through 7 (last), and `.io_idle()` in the idle
// class, which gets the disk only when no other process wants it. The child
// sets the class on itself before it starts the program, so every read and
// write of the program runs in it. The receipt's limits name the class
// (`io-priority=idle`, `io-priority=best-effort:4`). A level outside 0..7 is
// `IOError.InvalidInput` before anything starts.
package: {
    name: "process_io_priority"
    authority: { allow: [Env, Exec, Exec.Args, IO, Mem.Alloc, Time.Wait] }
}

use {
    process: core.process
    os: core.sys
}

why: fn(error: IOError) -> String {
    if error == {
        .InvalidInput(context) -> "InvalidInput: {context.cause ?? ""}"
        else -> "another error"
    }
}

limit: fn(receipt: process.ProcessReceipt) -> String {
    loop row in receipt.limits {
        if row.starts_with("io-priority=") -> return row
    }
    "no io-priority row"
}

refuse: fn(exe: String, level: Int) {
    if process.run_spec(process.cmd([exe, "child"]).io_priority(level)) == {
        .Ok(_) -> print("refused: no")
        .Err(error) -> print("refused: {why(error)}")
    }
}

run: fn() IOError! {
    exe: os.executable()
    if (process.args().get(0) ?? "") == "child" -> process.exit(0)
    idle: process.run_spec(process.cmd([exe, "child"]).io_idle())
    print("idle child: {idle.success}, {limit(idle)}")
    shared: process.run_spec(process.cmd([exe, "child"]).io_priority(4))
    print("best-effort child: {shared.success}, {limit(shared)}")
    plain: process.run_spec(process.cmd([exe, "child"]))
    print("default child: {limit(plain)}")
    refuse(exe, 8)
    refuse(exe, -1)
}
