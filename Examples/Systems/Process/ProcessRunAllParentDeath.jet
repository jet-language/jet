// process.run_all marks each job it starts to die with the program that runs
// the pool (Linux PR_SET_PDEATHSIG), so a program killed while its pool runs
// leaves no job behind. This program relaunches itself as a pool's owner,
// waits until the pool's one job has started, kills the owner, and sees the
// job stop.
package: {
    name: "process_run_all_parent_death"
    authority: { allow: [Env, Exec, Exec.Args, FS, FS.Read, FS.Write, IO, Mem.Alloc, Time, Time.Wait] }
}

use {
    files: core.files
    process: core.process
    sys: core.sys
    time: core.time
}

// Whether process `pid` still runs: a zombie waiting to be reaped has stopped.
running: fn(pid: String) -> Bool {
    stat: files.read("/proc/{pid}/stat") ?? return false
    fields: stat.split(") ").to_list()
    fields.len() < 2 || !fields[1].starts_with("Z")
}

run: fn() {
    args: process.args()
    if args.len() == 2 && args[0] == "--pool-owner" {
        // The job writes its pid, then becomes a sleep that outlives the owner
        // unless the pool's parent-death mark stops it.
        job: process.cmd([String]{"sh", "-c", "echo $$ > {args[1]}.tmp && mv {args[1]}.tmp {args[1]} && exec sleep 60"})
        _: process.run_all([ProcessSpec]{job}, 1) ?? return
        return
    }
    directory: "/tmp/jet_run_all_parent_death_{sys.pid()}"
    files.create_dir_all(directory) ?? panic("mkdir failed: {err}")
    pid_file: "{directory}/job.pid"
    owner: process.cmd([String]{sys.executable(), "--pool-owner", pid_file}).spawn() ?? panic("owner spawn failed: {err}")
    waits := 0
    loop !files.exists(pid_file) {
        if waits >= 6000 -> panic("the pool's job never started")
        waits += 1
        time.sleep(10ms)
    }
    pid: (files.read(pid_file) ?? panic("read {pid_file} failed: {err}")).trim().copy()
    print("job running while its owner runs: {running(pid)}")
    owner.kill() ?? panic("owner kill failed: {err}")
    receipt: owner.wait() ?? panic("owner wait failed: {err}")
    print("owner killed by signal 9: {(receipt.signal ?? 0) == 9}")
    waits = 0
    loop running(pid) && waits < 500 {
        waits += 1
        time.sleep(10ms)
    }
    print("job running after its owner died: {running(pid)}")
    files.remove_all(directory) ?? panic("cleanup failed: {err}")
}
