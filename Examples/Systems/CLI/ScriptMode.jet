#!/usr/bin/env jet
// A file whose first line is a `#!/...` launch line is a script. It runs with
// the invoking user's authority, as a shell script does, so it writes and
// reads a file without any package or authority block, and it is still fully
// checked.
//
// Run:  chmod +x Examples/Systems/CLI/ScriptMode.jet
//       Examples/Systems/CLI/ScriptMode.jet alpha beta
use {
    files: core.files
    process: core.process
    sys: core.sys
}

run: fn() {
    print("args: {process.args().join(" ")}")
    path: files.join(sys.temp_dir(), "jet-script-mode-{sys.pid()}.txt")
    files.write(path, "written and read back\n") ?? panic("can't write {path}")
    text: files.read(path) ?? panic("can't read {path}")
    files.remove(path) ?? panic("can't remove {path}")
    print("file: {text.trim()}")
}
