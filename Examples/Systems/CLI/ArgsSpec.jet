// Declarative CLI arg parsing.
// Builder spec: args.spec().flag(…).option(…).positional(…)
// Parsed against process.args() → typed values + auto --help + teaching errors.
//
// Run with extra args:  jet run Examples/Systems/CLI/ArgsSpec.jet -- --verbose hello
// Golden test (no extra args) uses a spec with no required positionals so parse
// always succeeds and exercises each query method.
package: {
    name: "args_spec"
    authority: { allow: [Env, Exec.Args, IO] }
}

use {
    args: core.args
    process: core.process
}

run: fn() {
    spec: args.spec()
        .flag("verbose", "print extra detail")
        .option("output", "write result to FILE", "FILE")
    parsed: spec.parse_or_exit(process.args())
    verbose: parsed.flag("verbose")
    out: parsed.option("output")
    print(verbose)
    print(out ?? "none")
}
