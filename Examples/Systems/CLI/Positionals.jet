// Required command values fill from bare argv in declaration
// order. Optional / defaulted values stay flag-only. Every value still
// accepts its named `--field` form; named wins when both forms appear.
//
// Run:  jet run Examples/Systems/CLI/Positionals.jet -- add buy-milk --due fri
//       jet run Examples/Systems/CLI/Positionals.jet -- login secret
//       jet run Examples/Systems/CLI/Positionals.jet -- --help
#CLI
Commands: struct {
    #Doc("add a todo") add: fn(self, text: String, due: String{""}) {
        print("add")
        print(text)
        print(due)
    }

    #Doc("log in") login: fn(self, token: String) {
        print("login")
        print(token)
    }
}

run: fn(args: Commands) {

}
