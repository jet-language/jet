// Canonical gzip stream codec.
use gz: core.archive.gzip
use zs: core.archive.zstd

run: fn() {
    compress_gzip_lesson()
    compress_zstd_lesson()
}

compress_gzip_lesson: fn() {
    original: [U8]{72, 101, 108, 108, 111}  // ASCII "Hello"
    compressed: gz.compress(original) ?? panic("compress")
    // A gzip stream is always longer than 5 bytes (header alone is 10).
    print(compressed.len() > 5)
    // Round-trip: decompress must recover the original bytes exactly.
    restored: gz.decompress(compressed) ?? panic("bad gzip")
    print(restored.len() == original.len())
    print(restored == original)
    // Decompress failure path: corrupt input returns err.
    bad: [U8]{1, 2, 3, 4, 5}
    _: gz.decompress(bad) ?? {
        print(true)
        return
    }
    print(false)
}

// Canonical zstd stream codec.
compress_zstd_lesson: fn() {
    original: [U8]{72, 101, 108, 108, 111}  // ASCII "Hello"
    compressed: zs.compress(original) ?? panic("compress")
    // A zstd frame carries a magic number + header; expect at least a few bytes.
    print(compressed.len() > 0)
    // Round-trip: decompress must recover the original bytes exactly.
    restored: zs.decompress(compressed) ?? panic("bad zstd")
    print(restored.len() == original.len())
    print(restored == original)
    // Decompress failure path: corrupt input returns err.
    bad: [U8]{1, 2, 3, 4, 5}
    _: zs.decompress(bad) ?? {
        print(true)
        return
    }
    print(false)
}
