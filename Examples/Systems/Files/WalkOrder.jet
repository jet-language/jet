// `walk` yields the entries in path order, depth first: a directory's
// entries follow it where its path and `/` sort, so `a/b` comes after `a-c`
// and `a.txt`, whose `-` and `.` sort before `/`.
package: {
    name: "walk_order"
    authority: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] }
}

use {
    fs: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("walk-order-example")
    directories: [String]{"a/b", "ab", "b/c/d"}
    loop directory in directories {
        fs.create_dir_all(Path.from(root).join(directory).to_string()) ?? panic("mkdir {directory}")
    }
    files: [String]{"a-c", "a.txt", "a/b/z", "a/y", "ab/x", "b/c/d/e", "b/c.txt", "c"}
    loop file in files {
        fs.write(Path.from(root).join(file), file) ?? panic("write {file}")
    }
    entries: fs.walk(root, None) ?? panic("walk")
    paths := [String]{}
    loop entry in entries {
        kind: if entry.is_dir -> " dir" else -> ""
        print("{entry.relative} {entry.depth}{kind}")
        paths.push(entry.path)
    }
    sorted := paths.copy()
    sorted.sort()
    print("in path order: {paths == sorted}")
}
