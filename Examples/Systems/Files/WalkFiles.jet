// File-only traversal keeps the walk policy and drops directories.
package: {
    name: "walk_files"
    authority: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] }
}

use {
    fs: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("walk-files-example")
    nested: Path.from(root).join("nested")
    fs.create_dir_all(nested.to_string()) ?? panic("mkdir")
    fs.write(Path.from(root).join("root.txt"), "root") ?? panic("root")
    fs.write(nested.join("child.txt"), "child") ?? panic("child")

    entries: fs.walk_files(root, None).list() ?? panic("walk")
    print("file count: {entries.len()}")
    loop entry in entries -> print(entry.relative)
}
