package: {
    name: "files_access"
    authority: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] }
}

// files.can_read, can_write and can_execute ask whether this program may use
// a path now, judged with its effective user and groups as `open` judges
// them (`test -r`, `-w`, `-x`). A missing path is false, never an error.
// The answer can change before the next call, so code that must open a file
// handles the open's error rather than asking first.

use files: core.files

run: fn() {
    scratch: files.temp_dir("access")
    notes: files.join(scratch.path, "notes.txt")
    files.write(notes, "kept\n")
    files.set_mode(notes, 0o644)
    print("notes: read={files.can_read(notes)} write={files.can_write(notes)} run={files.can_execute(notes)}")

    tool: files.join(scratch.path, "tool.sh")
    files.write(tool, "#!/bin/sh\n")
    files.set_mode(tool, 0o755)
    print("tool: run={files.can_execute(tool)}")

    // For a directory, execute means search: opening the names inside it.
    print("directory: search={files.can_execute(scratch.path)}")

    missing: files.join(scratch.path, "missing")
    print("missing: read={files.can_read(missing)} write={files.can_write(missing)} run={files.can_execute(missing)}")
}
