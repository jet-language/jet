// core.log — structured logging with levels, fields, spans and sinks.
package: {
    name: "log"
    authority: { allow: [FS, FS.Write, IO, Log, Mem.Alloc] }
}

use {
    files: core.files
    log: core.log
    testing: core.testing
}

run: fn() {
    log.set_level("info")
    print(log.enabled("debug"))
    print(log.enabled("info"))
    print(log.enabled("critical"))
    log.info("server started on port 8080")
    log.warn("connection pool below 10%")
    log.debug("this won't print at info level")
    log.critical("disk almost full")
    log.info("processed 42 requests")
    log.flush()
    log.disable()
    log.info("suppressed after disable")
    print("log demo done")
    structured()
    projection()
}

// JSON output with a trace id, a span and typed fields.
structured: fn() {
    log.setup("json")
    log.set_trace_id("trace-1")
    span: log.span("request")
    log.enter(span)
    log.info_fields("served", [log.field("route", "/health"), log.int("status", 200), log.bool("cache", true), log.counter("requests", 1)])
    log.close(span)
    print("structured log demo done")
}

// Levels, typed and redacted fields, sampling and an OTLP file sink are all
// configured without ambient output.
projection: fn() {
    log.disable()
    log.debug_fields("debug", [])
    log.error("error")
    log.error_fields("error-fields", [])
    log.warn_fields("warn-fields", [])
    ratio: log.float("ratio", 1.25)
    redacted: log.redact("secret")
    log.sample_every(2)
    root := testing.temp_dir("log-projection")
    path := Path.from(root).join("events.jsonl").to_string()
    log.otlp_file(path)
    print("fields:{ratio.kind}:{redacted.redacted}")
    files.remove_all(root)
}
