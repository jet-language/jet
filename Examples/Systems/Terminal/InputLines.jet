// The ambient `input` is every line of the files the program's arguments
// name, in order, else of standard input: `jet run InputLines.jet a.txt b.txt`
// reads a.txt and then b.txt, and `cmd | jet run InputLines.jet` reads the
// pipe. Lines arrive lazily, one at a time, without their line endings.
run: fn() {
    count := 0
    loop line in input {
        count += 1
        print("{count}: {line}")
    }
    print("{count} lines")
}
