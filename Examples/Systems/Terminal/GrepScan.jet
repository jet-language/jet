// Directory walk + regex file scan. The walk yields the Core
// `WalkEntry` fields `path`, `relative`, `is_dir` and `depth`.
package: {
    name: "grep_scan"
    // Walking declares FS; reads need FS.Read and fixture creation FS.Write.
    authority: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] }
}

use {
    fs: core.files
    testing: core.testing
}

run: fn() {
    root: testing.temp_dir("grep-scan")
    src: Path.from(root).join("src")
    fs.create_dir_all(src.to_string())
    fs.write(Path.from(root).join("notes.txt"), "needle in notes\n")
    fs.write(src.join("alpha.txt"), "needle in alpha\n")
    fs.write(src.join("beta.txt"), "no match\n")
    ignored: Path.from(root).join("ignored")
    fs.create_dir_all(ignored.to_string())
    fs.write(ignored.join("hidden.txt"), "needle must stay ignored\n")
    fs.write(Path.from(root).join(".gitignore"), "ignored/\n")

    // The walk opts into the ignore file; omission means no ignore rules.
    entries: fs.walk(root, ignore: ".gitignore")
    listing := [String]{}
    loop entry in entries -> listing.push("{entry.relative}:{entry.is_dir}:{entry.depth}")
    listing.sort()

    matches := [String]{}
    needle: Regex{"needle"}
    loop entry in entries {
        if !entry.is_dir {
            text: fs.read(entry.path)
            if needle.is_match(text) -> matches.push("{entry.relative}: needle")
        }
    }
    matches.sort()
    print("matches: {matches.len()}")
    loop line in matches -> print(line)
    loop line in listing -> print(line)
}
