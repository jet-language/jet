use c.jet_lua_ops as abi
use core.encoding.json as json

#Import module c.jet_lua_ops {
    fn open() -> Int = "jet_lua_ops_open"
    fn take_error() -> Int = "jet_lua_ops_take_error"
    fn cancel(handle: Int) = "jet_lua_ops_cancel"
    fn close(handle: Int) = "jet_lua_ops_close"
    fn view_get_int(handle: Int, table: Int, key: String) -> Int = "jet_lua_ops_view_get_int"
    fn view_set_int(handle: Int, table: Int, key: String, value: Int) = "jet_lua_ops_view_set_int"
    fn view_release(handle: Int, table: Int) = "jet_lua_ops_view_release"
    fn counters(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_counters"
    fn counters_view(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_counters"
    fn transform(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_transform"
    fn transform_view(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_transform"
    fn echo(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_echo"
    fn echo_view(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_echo"
    fn fail_call(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_fail_call"
    fn fail_call_view(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_fail_call"
    fn spin(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_spin"
    fn spin_view(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_spin"
}

struct Session {
    priv value: Int
}

struct TableView {
    priv session: Int
    priv table: Int
}

#Error
enum LuaError {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

fn decode_status(code: Int) -> Bool LuaError! {
    if code == 1 -> return Err(LuaError.NotRunning)
    if code == 2 -> return Err(LuaError.Timeout)
    if code == 3 -> return Err(LuaError.Cancelled)
    if code == 5 -> return Err(LuaError.Limit)
    if code == 4 -> return Err(LuaError.CommandFailed)
    if code == 6 -> return Err(LuaError.Protocol)
    if code != 0 -> return Err(LuaError.Protocol)
    return Ok(true)
}

fn decode_response(raw: String, code: Int) -> Dyn LuaError! {
    decode_status(code)
    value := json.parse(raw) ?? return Err(LuaError.Protocol)
    return Ok(value)
}

impl Session.Close {
    fn close(^self) { abi.close(self.value) }
}

impl TableView.Close {
    fn close(^self) { abi.view_release(self.session, self.table) }
}

fn open() -> Session LuaError! {
    handle :: abi.open()
    decode_status(abi.take_error())
    return Ok(Session{value: handle})
}

fn cancel(session: Session) { abi.cancel(session.value) }

fn view_get_int(view: TableView, key: String) -> Int LuaError! {
    value :: abi.view_get_int(view.session, view.table, key)
    decode_status(abi.take_error())
    return Ok(value)
}

fn view_set_int(view: TableView, key: String, value: Int) -> Bool LuaError! {
    abi.view_set_int(view.session, view.table, key, value)
    decode_status(abi.take_error())
    return Ok(true)
}

fn counters(session: Session, input: Dyn, deadline_ms: Int) -> Dyn LuaError! {
    raw :: abi.counters(session.value, json.to_string(input) ?? return Err(LuaError.Protocol), deadline_ms)
    code :: abi.take_error()
    return decode_response(raw, code)
}

fn counters_typed<T: [Encode, Decode]>(session: Session, input: T, deadline_ms: Int) -> T LuaError! {
    tree := json.parse(json.to_string(input) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    value := counters(session, tree, deadline_ms)
    decoded := json.decode<T>(json.to_string(value) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    return Ok(decoded)
}

fn counters_view(session: Session, deadline_ms: Int) -> TableView LuaError! {
    table :: abi.counters_view(session.value, deadline_ms)
    decode_status(abi.take_error())
    return Ok(TableView{session: session.value, table: table})
}

fn transform(session: Session, input: Dyn, deadline_ms: Int) -> Dyn LuaError! {
    raw :: abi.transform(session.value, json.to_string(input) ?? return Err(LuaError.Protocol), deadline_ms)
    code :: abi.take_error()
    return decode_response(raw, code)
}

fn transform_typed<T: [Encode, Decode]>(session: Session, input: T, deadline_ms: Int) -> T LuaError! {
    tree := json.parse(json.to_string(input) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    value := transform(session, tree, deadline_ms)
    decoded := json.decode<T>(json.to_string(value) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    return Ok(decoded)
}

fn transform_view(session: Session, deadline_ms: Int) -> TableView LuaError! {
    table :: abi.transform_view(session.value, deadline_ms)
    decode_status(abi.take_error())
    return Ok(TableView{session: session.value, table: table})
}

