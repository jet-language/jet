#Import(c) fn host_reenter(value: Int) -> Int = "host_reenter"
#Export(c) fn on_tick(dt: Int) -> Int { dt + 1 }
#Export(c) fn is_enabled(flag: Bool) -> Bool { flag }
#Export(c) fn greet(name: String) -> String { "hello, {name}!" }
#Export(c) fn reenter(value: Int) -> Int { host_reenter(value) }
#Export(c) fn panic_now(value: Int) -> Int { panic("guest panic {value}")
return 0 }
