use {
    abi: c.jet_ruby_ops
    json: core.encoding.json
}

#Import c.jet_ruby_ops: module {
    open: fn() -> Int = "jet_ruby_ops_open"
    take_error: fn() -> Int = "jet_ruby_ops_take_error"
    cancel: fn(handle: Int) = "jet_ruby_ops_cancel"
    close: fn(handle: Int) = "jet_ruby_ops_close"
    transform: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_ruby_ops_invoke_transform"
    fail_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_ruby_ops_invoke_fail_call"
    sleep_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_ruby_ops_invoke_sleep_call"
}

Session: struct {
    priv value: Int
}

#Error
RubyError: enum {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

impl Session.Close {
    close: fn(&&self) { abi.close(self.value) }
}

close: fn(session: &&Session) { abi.close(session.value) }

open: fn() -> Session RubyError! {
    handle: abi.open()
    if abi.take_error() != 0 -> return Err(RubyError.NotRunning)
    return Ok(Session{value: handle})
}

cancel: fn(session: Session) { abi.cancel(session.value) }

decode_response: fn(raw: String, code: Int) -> Dyn RubyError! {
    if code == 1 -> return Err(RubyError.NotRunning)
    if code == 2 -> return Err(RubyError.Timeout)
    if code == 3 -> return Err(RubyError.Cancelled)
    if code == 5 -> return Err(RubyError.Limit)
    if code != 0 -> return Err(RubyError.Protocol)
    response := json.parse(raw) ?? return Err(RubyError.Protocol)
    succeeded := (response.field("ok") ?? Dyn.Bool(false)).bool() ?? false
    if !succeeded -> return Err(RubyError.CommandFailed)
    return Ok(response.field("value") ?? Dyn.Null)
}

transform: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn RubyError! {
    raw: abi.transform(session.value, json.to_string(input) ?? return Err(RubyError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

fail_call: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn RubyError! {
    raw: abi.fail_call(session.value, json.to_string(input) ?? return Err(RubyError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

sleep_call: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn RubyError! {
    raw: abi.sleep_call(session.value, json.to_string(input) ?? return Err(RubyError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}
