use {
    abi: c.jet_r_ops
    core.encoding.json
}

#Import c.jet_r_ops: module {
    open: fn() -> Int = "jet_r_ops_open"
    take_error: fn() -> Int = "jet_r_ops_take_error"
    cancel: fn(handle: Int) = "jet_r_ops_cancel"
    close: fn(handle: Int) = "jet_r_ops_close"
    transform: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_transform"
    transform_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_transform_table"
    transform_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_transform_plot"
    double_values: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_double_values"
    double_values_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_double_values_table"
    double_values_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_double_values_plot"
    scale_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_scale_table"
    scale_table_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_scale_table_table"
    scale_table_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_scale_table_plot"
    plot_scores: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_plot_scores"
    plot_scores_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_plot_scores_table"
    plot_scores_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_plot_scores_plot"
    fail_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_fail_call"
    fail_call_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_fail_call_table"
    fail_call_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_fail_call_plot"
    sleep_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_sleep_call"
    sleep_call_table: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_sleep_call_table"
    sleep_call_plot: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_r_ops_invoke_sleep_call_plot"
}

Session: struct {
    priv value: Int

    impl Close {
        close: fn(&&self) { abi.close(self.value) }
    }
}

#Error
RError: enum {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

close: fn(session: &&Session) { abi.close(session.value) }

open: fn() -> Session RError! {
    handle: abi.open()
    if abi.take_error() != 0 -> return Err(RError.NotRunning)
    return Ok(Session{value: handle})
}

cancel: fn(session: Session) { abi.cancel(session.value) }

decode_response: fn(raw: String, code: Int) -> Dyn RError! {
    if code == 1 -> return Err(RError.NotRunning)
    if code == 2 -> return Err(RError.Timeout)
    if code == 3 -> return Err(RError.Cancelled)
    if code == 5 -> return Err(RError.Limit)
    if code != 0 -> return Err(RError.Protocol)
    response := json.parse(raw) ?? return Err(RError.Protocol)
    succeeded := (response.field("ok") ?? Dyn.Bool(false)).bool() ?? false
    if !succeeded -> return Err(RError.CommandFailed)
    return Ok(response.field("value") ?? Dyn.Null)
}

transform: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn RError! {
    raw: abi.transform(session.value, json.to_string(input) ?? return Err(RError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

transform_table: fn<T: [Encode, Decode]>(session: Session, rows: [T], deadline_ms: Int) -> [T] RError! {
    raw: abi.transform_table(session.value, json.to_string(rows.copy()) ?? return Err(RError.Protocol), deadline_ms)
    code: abi.take_error()
    value := decode_response(raw, code)
    return Ok(json.decode<[T]>(json.to_string(value) ?? return Err(RError.Protocol)) ?? return Err(RError.Protocol))
}

transform_plot: fn(session: Session, input: Dyn, deadline_ms: Int) -> String RError! {
    raw: abi.transform_plot(session.value, json.to_string(input) ?? return Err(RError.Protocol), deadline_ms)
    code: abi.take_error()
    value := decode_response(raw, code)
    return Ok(value.text() ?? return Err(RError.Protocol))
}

