use {
    abi: c.jet_perl_ops
    core.encoding.json
}

#Import c.jet_perl_ops: module {
    open: fn() -> Int = "jet_perl_ops_open"
    take_error: fn() -> Int = "jet_perl_ops_take_error"
    cancel: fn(handle: Int) = "jet_perl_ops_cancel"
    close: fn(handle: Int) = "jet_perl_ops_close"
    fail: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_perl_ops_invoke_fail"
    sleep: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_perl_ops_invoke_sleep"
    transform: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_perl_ops_invoke_transform"
}

Session: struct {
    priv value: Int

    impl Close {
        close: fn(&&self) { abi.close(self.value) }
    }
}

#Error
PerlError: enum {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

close: fn(session: &&Session) { abi.close(session.value) }

open: fn() -> Session PerlError! {
    handle: abi.open()
    if abi.take_error() != 0 -> return Err(PerlError.NotRunning)
    return Ok(Session{value: handle})
}

cancel: fn(session: Session) { abi.cancel(session.value) }

decode_response: fn(raw: String, code: Int) -> Dyn PerlError! {
    if code == 1 -> return Err(PerlError.NotRunning)
    if code == 2 -> return Err(PerlError.Timeout)
    if code == 3 -> return Err(PerlError.Cancelled)
    if code == 5 -> return Err(PerlError.Limit)
    if code != 0 -> return Err(PerlError.Protocol)
    response := json.parse(raw) ?? return Err(PerlError.Protocol)
    succeeded := (response.field("ok") ?? Dyn.Bool(false)).bool() ?? false
    if !succeeded -> return Err(PerlError.CommandFailed)
    return Ok(response.field("value") ?? Dyn.Null)
}

fail: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn PerlError! {
    raw: abi.fail(session.value, json.to_string(input) ?? return Err(PerlError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

sleep: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn PerlError! {
    raw: abi.sleep(session.value, json.to_string(input) ?? return Err(PerlError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

transform: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn PerlError! {
    raw: abi.transform(session.value, json.to_string(input) ?? return Err(PerlError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}
