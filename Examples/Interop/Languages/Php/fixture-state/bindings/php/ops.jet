use {
    abi: c.jet_php_ops
    json: core.encoding.json
}

#Import c.jet_php_ops: module {
    open: fn() -> Int = "jet_php_ops_open"
    take_error: fn() -> Int = "jet_php_ops_take_error"
    cancel: fn(handle: Int) = "jet_php_ops_cancel"
    close: fn(handle: Int) = "jet_php_ops_close"
    transform: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_php_ops_invoke_transform"
    fail_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_php_ops_invoke_fail_call"
    sleep_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_php_ops_invoke_sleep_call"
    pooled_sleep: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_php_ops_invoke_pooled_sleep"
}

PhpPool: struct {
    priv value: Int
}

#Error
PhpError: enum {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

impl PhpPool.Close {
    close: fn(&&self) { abi.close(self.value) }
}

close: fn(pool: &&PhpPool) { abi.close(pool.value) }

open: fn() -> PhpPool PhpError! {
    handle: abi.open()
    if abi.take_error() != 0 -> return Err(PhpError.NotRunning)
    return Ok(PhpPool{value: handle})
}

cancel: fn(pool: PhpPool) { abi.cancel(pool.value) }

decode_response: fn(raw: String, code: Int) -> Dyn PhpError! {
    if code == 1 -> return Err(PhpError.NotRunning)
    if code == 2 -> return Err(PhpError.Timeout)
    if code == 3 -> return Err(PhpError.Cancelled)
    if code == 5 -> return Err(PhpError.Limit)
    if code != 0 -> return Err(PhpError.Protocol)
    response := json.parse(raw) ?? return Err(PhpError.Protocol)
    succeeded := (response.field("ok") ?? Dyn.Bool(false)).bool() ?? false
    if !succeeded -> return Err(PhpError.CommandFailed)
    return Ok(response.field("value") ?? Dyn.Null)
}

transform: fn(pool: PhpPool, input: Dyn, deadline_ms: Int) -> Dyn PhpError! {
    raw: abi.transform(pool.value, json.to_string(input) ?? return Err(PhpError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

fail_call: fn(pool: PhpPool, input: Dyn, deadline_ms: Int) -> Dyn PhpError! {
    raw: abi.fail_call(pool.value, json.to_string(input) ?? return Err(PhpError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

sleep_call: fn(pool: PhpPool, input: Dyn, deadline_ms: Int) -> Dyn PhpError! {
    raw: abi.sleep_call(pool.value, json.to_string(input) ?? return Err(PhpError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

pooled_sleep: fn(pool: PhpPool, input: Dyn, deadline_ms: Int) -> Dyn PhpError! {
    raw: abi.pooled_sleep(pool.value, json.to_string(input) ?? return Err(PhpError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}
