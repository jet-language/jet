use {
    abi: c.jet_lua_ops
    json: core.encoding.json
}

#Import c.jet_lua_ops: module {
    open: fn() -> Int = "jet_lua_ops_open"
    take_error: fn() -> Int = "jet_lua_ops_take_error"
    cancel: fn(handle: Int) = "jet_lua_ops_cancel"
    close: fn(handle: Int) = "jet_lua_ops_close"
    view_get_int: fn(handle: Int, table: Int, key: String) -> Int = "jet_lua_ops_view_get_int"
    view_set_int: fn(handle: Int, table: Int, key: String, value: Int) = "jet_lua_ops_view_set_int"
    view_release: fn(handle: Int, table: Int) = "jet_lua_ops_view_release"
    counters: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_counters"
    counters_view: fn(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_counters"
    transform: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_transform"
    transform_view: fn(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_transform"
    echo: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_echo"
    echo_view: fn(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_echo"
    fail_call: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_fail_call"
    fail_call_view: fn(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_fail_call"
    spin: fn(handle: Int, input: String, deadline_ms: Int) -> String = "jet_lua_ops_invoke_spin"
    spin_view: fn(handle: Int, deadline_ms: Int) -> Int = "jet_lua_ops_view_spin"
}

Session: struct {
    priv value: Int

    impl Close {
        close: fn(&&self) { abi.close(self.value) }
    }
}

TableView: struct {
    priv session: Int
    priv table: Int

    impl Close {
        close: fn(&&self) { abi.view_release(self.session, self.table) }
    }
}

#Error
LuaError: enum {
    NotRunning
    Timeout
    Cancelled
    Protocol
    CommandFailed
    Limit
}

decode_status: fn(code: Int) -> Bool LuaError! {
    if code == 1 -> return Err(LuaError.NotRunning)
    if code == 2 -> return Err(LuaError.Timeout)
    if code == 3 -> return Err(LuaError.Cancelled)
    if code == 5 -> return Err(LuaError.Limit)
    if code == 4 -> return Err(LuaError.CommandFailed)
    if code == 6 -> return Err(LuaError.Protocol)
    if code != 0 -> return Err(LuaError.Protocol)
    return Ok(true)
}

decode_response: fn(raw: String, code: Int) -> Dyn LuaError! {
    decode_status(code)
    value := json.parse(raw) ?? return Err(LuaError.Protocol)
    return Ok(value)
}

open: fn() -> Session LuaError! {
    handle: abi.open()
    decode_status(abi.take_error())
    return Ok(Session{value: handle})
}

cancel: fn(session: Session) { abi.cancel(session.value) }

view_get_int: fn(view: TableView, key: String) -> Int LuaError! {
    value: abi.view_get_int(view.session, view.table, key)
    decode_status(abi.take_error())
    return Ok(value)
}

view_set_int: fn(view: TableView, key: String, value: Int) -> Bool LuaError! {
    abi.view_set_int(view.session, view.table, key, value)
    decode_status(abi.take_error())
    return Ok(true)
}

counters: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn LuaError! {
    raw: abi.counters(session.value, json.to_string(input) ?? return Err(LuaError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

counters_typed: fn<T: [Encode, Decode]>(session: Session, input: T, deadline_ms: Int) -> T LuaError! {
    tree := json.parse(json.to_string(input) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    value := counters(session, tree, deadline_ms)
    decoded := json.decode<T>(json.to_string(value) ?? return Err(LuaError.Protocol)) ?? return Err(LuaError.Protocol)
    return Ok(decoded)
}

counters_view: fn(session: Session, deadline_ms: Int) -> TableView LuaError! {
    table: abi.counters_view(session.value, deadline_ms)
    decode_status(abi.take_error())
    return Ok(TableView{session: session.value, table: table})
}

transform: fn(session: Session, input: Dyn, deadline_ms: Int) -> Dyn LuaError! {
    raw: abi.transform(session.value, json.to_string(input) ?? return Err(LuaError.Protocol), deadline_ms)
    code: abi.take_error()
    return decode_response(raw, code)
}

