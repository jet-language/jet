#Import(c) host_reenter: fn(value: Int) -> Int = "host_reenter"
#Export(c) on_tick: fn(dt: Int) -> Int { dt + 1 }
#Export(c) is_enabled: fn(flag: Bool) -> Bool { flag }
#Export(c) greet: fn(name: String) -> String { "hello, {name}!" }
#Export(c) reenter: fn(value: Int) -> Int { host_reenter(value) }
#Export(c) panic_now: fn(value: Int) -> Int { panic("guest panic {value}")
return 0 }
