use abi: c.jet_go_handles

#Import c.jet_go_handles: module {
    new_handle: fn(value: Int) -> Int = "new_handle"
    consume_handle: fn(handle: Int) -> Int = "consume_handle"
}

Handle: struct {
    priv value: Int
}

new_handle: fn(value: Int) -> Handle { return Handle{value: abi.new_handle(value)} }

consume_handle: fn(handle: Handle) -> Int { return abi.consume_handle(handle.value) }
