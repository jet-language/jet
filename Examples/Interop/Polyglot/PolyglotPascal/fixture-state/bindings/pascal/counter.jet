use abi: c.jet_pascal_counter

#Import c.jet_pascal_counter: module {
    take_error: fn() -> Int = "jet_pascal_counter_take_error"
    add_scalar: fn(a: Int, b: Int) -> Int = "jet_pascal_counter_add_scalar"
    add_float: fn(a: Float, b: Float) -> Float = "jet_pascal_counter_add_float"
    counter_new: fn(value: Int) -> Int = "jet_pascal_counter_counter_new"
    counter_add: fn(handle: Int, delta: Int) -> Int = "jet_pascal_counter_counter_add"
    counter_close: fn(handle: Int) = "jet_pascal_counter_counter_close"
}

PascalError: enum {
    InvalidHandle
    Foreign
    ResourceLimit
}

Counter: struct {
    priv value: Int

    impl Close {
        close: fn(&&self) {
            abi.counter_close(self.value)
            if abi.take_error() != 0 -> panic("invalid Pascal handle")
        }
    }
}

error: fn(code: Int) -> PascalError {
    if code == 1 -> return PascalError.InvalidHandle
    if code == 2 -> return PascalError.ResourceLimit
    return PascalError.Foreign
}

add_scalar: fn(a: Int, b: Int) -> Int {
    return abi.add_scalar(a, b)
}

add_float: fn(a: Float, b: Float) -> Float {
    return abi.add_float(a, b)
}

counter_new: fn(value: Int) -> Counter PascalError! {
    raw_handle: abi.counter_new(value)
    code: abi.take_error()
    if code != 0 -> return Err(error(code))
    return Ok(Counter{value: raw_handle})
}

counter_add: fn(handle: Counter, delta: Int) -> Int PascalError! {
    result_value: abi.counter_add(handle.value, delta)
    code: abi.take_error()
    if code != 0 -> return Err(error(code))
    return Ok(result_value)
}

close: fn(&&handle: Counter) {}
