// Run `jet inspect bind dart callbacks.dart --jet run.jet --pkg callbacks`,
// then `dart run Host.dart` from the generated project.
use callbacks: dart.callbacks

compute: fn(value: Int) -[FFI.Dart]> Int { return callbacks.dart_double(value) ?? -1 }

compute_float: fn(value: Float) -[FFI.Dart]> Float { return callbacks.dart_half(value) ?? -1.0 }
