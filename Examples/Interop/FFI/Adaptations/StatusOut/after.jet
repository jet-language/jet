#Import c.status: module {
    __jet_ffi_native_decode_status: fn(input: &[U8], input_len: U32, output: &[U8], output_cap: U32, written: &U32) Int = "decode_status"
}

// Unrun expectation: status and the written count become one checked result;
// negative status is not remapped to success and caller storage is retained.
decode_status: fn(input: &[U8], output: &[U8]) -> Result<U32, Int> {
    written := 0
    status := __jet_ffi_native_decode_status(input, input.len(), output, output.len(), written)
    if status < 0 -> return Err(status)
    return Ok(written)
}

run: fn() -> Result<U32, Int> {
    input := [1, 2, 3]
    output := [0, 0, 0]
    return decode_status(input, output)
}
