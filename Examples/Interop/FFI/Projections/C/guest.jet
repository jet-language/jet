#Codable
ProjectionRecord: struct {
    priv count: Int
    priv label: String
}
#Codable
ProjectionError: enum {
    Closed
    Empty
    Bounds
}

#Export(c) add: fn(value: Int) -> Int { value + 1 }
#Export(c) label: fn(value: String) -> String { value }
#Export(c) project: fn(value: ProjectionRecord) -> ProjectionRecord { value }
#Codable
ProjectionDocument: struct {
    priv bytes: [Int]
    priv generation: Int
    priv closed: Bool
}

#Export(c) document_open: fn(input: [Int]) -> ProjectionDocument? ProjectionError! {
    return Ok(ProjectionDocument{bytes: input, generation: 1, closed: false})
}

#Export(c) document_bytes: fn(owner: ProjectionDocument) -> View<Int>? ProjectionError! {
    if owner.closed -> return Err(ProjectionError.Closed)
    if owner.bytes.len() == 0 -> return Err(ProjectionError.Empty)
    return Ok(owner.bytes[0..owner.bytes.len() - 1])
}

#Export(c) view_at: fn(owner: ProjectionDocument, view: View<Int>, index: Int) -> Int? ProjectionError! {
    if owner.closed -> return Err(ProjectionError.Closed)
    if index < 0 || index >= view.len() -> return Err(ProjectionError.Bounds)
    return Ok(view[index])
}

#Export(c) document_replace: fn(owner: &&ProjectionDocument, input: [Int]) -> ProjectionDocument? ProjectionError! {
    if owner.closed -> return Err(ProjectionError.Closed)
    if owner.generation == 9223372036854775807 -> return Err(ProjectionError.Bounds)
    return Ok(ProjectionDocument{bytes: input, generation: owner.generation + 1, closed: false})
}

#Export(c) document_close: fn(owner: &&ProjectionDocument) -> Unit? ProjectionError! {
    return Ok()
}
