package: {
    name: "crypto_password_auth"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Rand] }
}

// Password login on Argon2id: the right password issues a session token, a
// wrong one (or an unknown user) gets one fixed rejection that names no
// password, stored hash, key or token. Key and nonce ownership: the server
// generates and keeps its X25519 key; `seal` draws a fresh ephemeral key and
// nonce on every call, so this example holds no sample nonce.
use {
    crypto: core.crypto
    core.crypto.random
}

Account: struct {
    user: String
    stored: crypto.PasswordHash
}

Login: enum {
    Granted(String)
    Rejected(String)
}

REJECTED: "invalid user name or password"

login: fn(accounts: [Account], user: String, password: crypto.Secret) -[Rand]> Login {
    loop account in accounts {
        if account.user != user -> next
        if crypto.password_verify(password, account.stored) ?? false {
            token: random.token_urlsafe(32) ?? return Login.Rejected(REJECTED)
            return Login.Granted(token)
        }
    }
    Login.Rejected(REJECTED)
}

run: fn() {
    stored: crypto.password_hash(crypto.Secret.from_text("correct horse battery staple")) ?? return
    // The PHC string names its algorithm and cost; its salt and hash stay unprinted.
    phc: stored.text.split("$").to_list()
    print("password hash: {phc[1]} {phc[2]} {phc[3]}")
    accounts: [Account]{Account{user: "alice", stored: stored}}

    granted: login(accounts, "alice", crypto.Secret.from_text("correct horse battery staple"))
    token := ""
    if granted == {
        .Granted(issued) -> {
            token = issued
            print("alice, right password: granted, token of {issued.len()} characters")
        }
        .Rejected(message) -> print("alice, right password: {message}")
    }

    loop attempt in
        [(user: "alice", password: "Correct horse battery staple"), (user: "mallory", password: "correct horse battery staple")] {
        if login(accounts, attempt.user, crypto.Secret.from_text(attempt.password)) == {
            .Granted(_) -> { print("{attempt.user}, wrong login: granted") }
            .Rejected(message) -> {
                print("{attempt.user}, wrong login: {message}")
                leaks: message.contains(attempt.password) || message.contains(stored.text) || message.contains(phc[4]) || message.contains(phc[5]) || (token != "" && message.contains(token))
                print("{attempt.user}, rejection leaks a secret: {leaks}")
            }
        }
    }

    // The server owns this key; each seal picks its own nonce.
    server: crypto.generatekey() ?? return
    public: crypto.x25519_public(server) ?? return
    first: crypto.seal([public], token.bytes(), "session".bytes()) ?? return
    second: crypto.seal([public], token.bytes(), "session".bytes()) ?? return
    print("two seals of one token differ: {crypto.sealed_bytes(first) != crypto.sealed_bytes(second)}")
    opened: crypto.open(server, first, "session".bytes()) ?? return
    print("server opens its sealed token: {opened == token.bytes()}")
}
