// `CryptoError` and `FileCryptoError` belong to the Core
// error family, so a plain `run: fn()` passes a crypto failure up without any
// local handling. The program stops with a report naming the case and exits 1.
use {
    crypto: core.crypto
    core.crypto.[FileCryptoError]
}

// A typed step that names its failure, as `crypto.file_open` does.
publish: fn(ready: Bool) FileCryptoError! {
    if !ready -> return Err(FileCryptoError.DestinationIO)
    Ok()
}

// Both crypto errors reach the default `Err` here with no declaration:
// `from_bytes` can fail with `CryptoError`, `publish` with `FileCryptoError`.
store: fn(seed: [U8]) Err! {
    key: crypto.SigningKey.from_bytes(seed)
    print(key.public_key().bytes.len())
    publish(false)
}

run: fn() {
    key: crypto.pbkdf2_hmac("password".bytes(), "salt".bytes(), 1, 32)
    print(key.len())
    if store(key) == {
        .Ok(_) -> { print("stored") }
        .Err(e) -> print("store: {e.message}")
    }
    // Zero iterations is `CryptoError.Length`; it passes up out of `run`.
    short: crypto.pbkdf2_hmac("password".bytes(), "salt".bytes(), rounds(0), 32)
    print(short.len())
}

// A written `0` is a bound the compiler sees (E2702); the count reaches
// `pbkdf2_hmac` at run time here, as one read from a config would.
rounds: fn(count: Int) -> Int { count }
