# The tree's deep checks at each optimize level (none, basic, and full through
# `--release`): off under a plain run, all kept under a bare `--deep-checks`
# or the package's scope, only `run`'s under `tree::run`, a scope that names
# nothing refused before the run (E2120), and the dotted `tree.run`, which is
# no scope, refused before the compile (E2119).
env: NO_COLOR=1
step off_o0: jet run --optimize=none run.jet
exit: 0
stdout: = DeepChecksTree.out
stderr: empty
step all_o0: jet run --optimize=none --deep-checks run.jet
exit: 70
stdout: empty # the load stops the program before it serves
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step package_o0: jet run --optimize=none --deep-checks=tree run.jet
exit: 70
stdout: empty # the package scope keeps the load's deep check
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step function_o0: jet run --optimize=none --deep-checks=tree::run run.jet
exit: 70
stdout: = "loaded 5 keys\n" # `load`'s deep check is off, so the load passes
stderr: ~ "Stop [E3001]: `panic: a lookup of 6 disagrees with the stored keys`"
stderr: ~ "--> run.jet:89 in run"
step unknown_o0: jet run --optimize=none --deep-checks=tree::nowhere run.jet
exit: 1
stdout: empty # refused before the run
stderr: ~ "`--deep-checks=tree::nowhere` names no package, module, type or function of this program"
stderr: ~ "jet-lang.dev/e/E2120"
step off_o1: jet run --optimize=basic run.jet
exit: 0
stdout: = DeepChecksTree.out
stderr: empty
step all_o1: jet run --optimize=basic --deep-checks run.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step package_o1: jet run --optimize=basic --deep-checks=tree run.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step function_o1: jet run --optimize=basic --deep-checks=tree::run run.jet
exit: 70
stdout: = "loaded 5 keys\n"
stderr: ~ "Stop [E3001]: `panic: a lookup of 6 disagrees with the stored keys`"
stderr: ~ "--> run.jet:89 in run"
step unknown_o1: jet run --optimize=basic --deep-checks=tree::nowhere run.jet
exit: 1
stdout: empty
stderr: ~ "`--deep-checks=tree::nowhere` names no package, module, type or function of this program"
stderr: ~ "jet-lang.dev/e/E2120"
step off_o2: jet run --release run.jet
exit: 0
stdout: = DeepChecksTree.out
stderr: empty
step all_o2: jet run --release --deep-checks run.jet
exit: 70
stdout: empty # a release build keeps a selected deep check
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step package_o2: jet run --release --deep-checks=tree run.jet
exit: 70
stdout: empty
stderr: ~ "Stop [E3001]: `panic: the snapshot's tree is out of order`"
stderr: ~ "--> run.jet:68 in load"
step function_o2: jet run --release --deep-checks=tree::run run.jet
exit: 70
stdout: = "loaded 5 keys\n"
stderr: ~ "Stop [E3001]: `panic: a lookup of 6 disagrees with the stored keys`"
stderr: ~ "--> run.jet:89 in run"
step unknown_o2: jet run --release --deep-checks=tree::nowhere run.jet
exit: 1
stdout: empty
stderr: ~ "`--deep-checks=tree::nowhere` names no package, module, type or function of this program"
stderr: ~ "jet-lang.dev/e/E2120"
step dotted: jet run --deep-checks=tree.run run.jet
exit: 2
stdout: empty # refused before anything is compiled
stderr: ~ "`--deep-checks=tree.run` isn't a deep-check scope"
stderr: ~ "jet-lang.dev/e/E2119"
