// A broken `#Pre` stops the program with E3005 at the call that passed the
// bad argument, on every tier: `jet run`, a debug build and a release build
// all print the same stop. The first call keeps the contract and prints; the
// second passes 0 and stops before `add_fee` runs.
#Pre(cents > 0, "cents must be positive") add_fee: fn(cents: Int) -> Int { return cents + 5 }

run: fn() {
    print("first: {add_fee(100)}")
    print("second: {add_fee(0)}")
}
// --- expected output --------------------------------------------------
// first: 105
// (then the E3005 stop at the second call, on stderr)
