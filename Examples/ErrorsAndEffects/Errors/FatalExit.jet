// A `-> Never` helper is a complete non-returning contract. It can
// report and stop in one call, `process.fail(1, message)`, and it serves as
// the `??` fallback of a fallible parse.
package: {
    name: "fatal_exit"
    authority: { allow: [Exec, IO, Mem.Alloc] }
}

use process: core.process

RGB: struct {
    r: U8
    g: U8
    b: U8
}

fatal: fn(message: String) -> Never { process.fail(1, "[fatal] {message}") }

// "#9bbc0f" -> Rgb{r: 155, g: 188, b: 15}
hex2rgb: fn(text: String) -> RGB {
    hex: if text.starts_with("#") -> text.slice(1, text.len()) else -> text
    r: Int.from_radix(hex.slice(0, 2), 16) ?? fatal("bad color: {text}")
    g: Int.from_radix(hex.slice(2, 4), 16) ?? fatal("bad color: {text}")
    b: Int.from_radix(hex.slice(4, 6), 16) ?? fatal("bad color: {text}")
    RGB{r: U8{r}, g: U8{g}, b: U8{b}}
}

run: fn() {
    good: hex2rgb("#9bbc0f")
    print("{good.r} {good.g} {good.b}")
    bad: hex2rgb("#9bzz0f")
    print("unreachable {bad.r}")
}
