// A decision table is the value of a fallible function. Each arm builds
// `Ok(...)` or `Err(...)` directly, or gives a plain success value that lifts
// into the declared carrier; no arm needs `return`.
#Error
LookupError: enum {
    Bad
    Wrapped(String)
}

lookup: fn(code: Int) -> Int LookupError! {
    if code == {
        1 -> Ok(10)
        2 -> Ok(20)
        3 -> 30
        else -> Err(LookupError.Bad)
    }
}

// A result subject maps its `Ok`/`Err` arms into this function's carrier.
relabel: fn(code: Int) -> Int LookupError! {
    if lookup(code) == {
        .Ok(value) -> Ok(value + 1)
        .Err(_) -> Err(LookupError.Wrapped("mapped"))
    }
}

Step: enum {
    First
    Second
}

impl Step {
    // A non-generic enum's `self` has the same type as a named variant.
    normalized: fn(self) -> Step Never! {
        if self == {
            .First -> Step.Second
            .Second -> self
        }
    }
}

// The map's value type is inferred from the argument.
keys: fn<V>(map: [String: V]) -> [String] {
    out := [String]{}
    loop key in map.keys() {
        out.push(key)
    }
    out
}

run: fn() {
    loop code in [1, 2, 3, 4] {
        print(lookup(code) ?? -1)
    }
    print(relabel(1) ?? -1)
    if relabel(9) == {
        .Ok(value) -> print(value)
        .Err(_) -> print("relabel failed")
    }
    first: Step.First
    print(first.normalized() == Step.Second)
    counts: ["a": 1, "b": 2]
    print(keys(counts).len())
}
