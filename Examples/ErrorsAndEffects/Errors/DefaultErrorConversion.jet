// One declared conversion rail can target the default Err.
User: struct {
    name: String
}

#Error
StoreErr: enum {
    Missing
}

impl Err.From(StoreErr) {
    from: fn(error: StoreErr) -> Err { return Err("store unavailable: missing user") }
}

read_store: fn() -> User StoreErr! { Err(StoreErr.Missing) }

get_user: fn() -> User { Ok(read_store()) }

run: fn() { _: get_user() }
