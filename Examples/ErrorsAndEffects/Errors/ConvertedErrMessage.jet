// After a declared `impl Err.From(T)`, the
// `??` fallback's ambient `err` is the converted default Err. Its fields read
// what the conversion built, including through a `?("note")` context frame.
// Rule 7: the conversion applies only against a written
// contract, so `load_user` writes `Err!`; unwritten, it would pass `StoreErr` up.
#Error
StoreErr: enum {
    Missing
}

impl Err.From(StoreErr) {
    from: fn(error: StoreErr) -> Err {
        return Err("store unavailable: missing user", code: "E_STORE", cause: Err("disk offline"))
    }
}

User: struct {
    name: String
}

read_store: fn() -> User StoreErr! { Err(StoreErr.Missing) }

load_user: fn() -> User Err! { read_store() }

load_profile: fn() -> User {
    user: load_user()?("loading the profile")
    return Ok(user)
}

run: fn() {
    user: load_user() ?? {
        print("load failed: {err.message}")
        print("code: {err.code ?? "none"}")
        User{name: "guest"}
    }
    print(user.name)

    profile: load_profile() ?? {
        print("profile failed: {err.message}")
        return
    }
    print(profile.name)
}
