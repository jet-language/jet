#Error
AmbientError: struct {
    message: String
    code: String
    cause: String
    partial: [String]
    notes: [String]
}

fail: fn() -> String AmbientError! {
    return Err(
        AmbientError{
            message: "row 3 is invalid",
            code: "ROW003",
            cause: "parser stopped after row 2",
            partial: ["row 1", "row 2"],
            notes: ["2 rows kept"],
        },
    )
}

run: fn() {
    message: fail() ?? err.message
    print(message)

    recovered: fail() ?? {
        print(err.code)
        print(err.cause)
        print(err.partial.join(", "))
        print(err.notes.join(" / "))
        "recovered"
    }
    print(recovered)
}
