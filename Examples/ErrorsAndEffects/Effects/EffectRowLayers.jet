// Every layer that bounds effects, in one program. A module cap bounds every
// function in `ledger`, a type cap every method of `Entry`, a trait cap every
// implementation of `Render`, and a target row every artifact built for a
// machine: `core.target` declares each machine's facts, and each service a
// machine lacks denies the effect that needs it. The rows nest: a function
// gets the narrowest of its module's, its type's, its trait's and its
// target's. Code that reached past one would stop the check (E0749 for a cap,
// E0754 for a trait cap, E1123 for the target).
use core.target.[GPU, LinuxX64, MachineFacts, Web]

#FX(IO, !FS, !Net) ledger: module {
    total: fn(entries: [Entry]) -> Int {
        sum := 0
        loop entry in entries -> sum += entry.amount
        sum
    }

    report: fn(entries: [Entry]) {
        loop entry in entries -> print(entry.line())
        print("total: {total(entries)}")
    }
}

#FX(!FS, !Net, !Exec)
Entry: struct {
    label: String
    amount: Int

    line: fn(self) -> String { "{self.label}: {self.amount}" }

    impl Render {
        render: fn(self) { print("[{self.line()}]") }
    }
}

#FX(IO, !Exec)
Render: trait {
    render: fn(self)
}

// What a machine's row lets an artifact do: the effects it denies.
allows: fn(name: String, facts: MachineFacts) {
    denied: facts.row()
    print("{name} denies {denied.len()}: {denied}")
}

run: fn() {
    entries: [Entry]{Entry{label: "rent", amount: 900}, Entry{label: "food", amount: 250}}
    ledger.report(entries)
    loop entry in entries -> entry.render()
    allows("linux", LinuxX64.facts)
    allows("web", Web.facts)
    allows("gpu", GPU.facts)
    print("built for {#build.target.layout.pointer_bits}-bit pointers")
}
