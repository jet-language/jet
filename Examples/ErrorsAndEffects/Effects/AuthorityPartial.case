# `jet run` runs the program and names only the effect the `allow` row leaves
# out; a built binary carries no notice, so the oracle is the one `jet run`.
step: jet run AuthorityPartial.jet
exit: 0
stdout: = "HOME set: true\nclock runs: true\n"
stderr: = "note: AuthorityPartial.jet reads the clock (-A hides this)\n"
