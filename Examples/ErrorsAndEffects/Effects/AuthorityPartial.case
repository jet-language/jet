# The `allow` row is a ceiling: reading the clock, which it leaves out, stops
# the check with E0749 before the program starts, on every tier.
step: jet run AuthorityPartial.jet
exit: 1
stdout: empty
stderr: ~ "E0749" # the ceiling's registered code
stderr: ~ "Time" # the effect the row leaves out
stderr: ~ "authority.allow" # the fix names the row to widen
