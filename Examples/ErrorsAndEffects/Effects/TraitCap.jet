// A trait cap and a method bound together: `#FX(…)` above a trait bounds
// every implementation of its methods, and a row on one method narrows that
// method further. `Shape`'s implementations may print but never touch files,
// and `area` must be pure. A call through a `Shape` value gets the trait's cap
// as its row, so `show_all` may declare just `IO`. An implementation that
// reached past either rung would stop the check: E0754 for the trait cap,
// E0742 for the method bound.
#FX(IO, !FS)
Shape: trait {
    area: fn(self) -[]> Int
    describe: fn(self)
}

Square: struct {
    side: Int
}

impl Square.Shape {
    area: fn(self) -> Int { self.side * self.side }
    describe: fn(self) { print("square {self.side}: {self.area()}") }
}

Rect: struct {
    width: Int
    height: Int
}

impl Rect.Shape {
    area: fn(self) -> Int { self.width * self.height }
    describe: fn(self) { print("rect {self.width}x{self.height}: {self.area()}") }
}

show_all: fn(shapes: [Shape]) -[IO]> {
    loop shape in shapes -> shape.describe()
}

run: fn() {
    shapes: [Shape]{Square{side: 3}, Rect{width: 2, height: 5}}
    show_all(shapes)
    total := 0
    loop shape in shapes -> total += shape.area()
    print("total area: {total}")
}
