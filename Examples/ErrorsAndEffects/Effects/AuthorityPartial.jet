// Application authority, partial declaration: the written row lists Env, but the program also reads the clock.
// A written row is a ceiling, so the check stops with E0749 naming the clock
// read and the call chain that reaches it, before the program starts.
package: {
    name: "authority_partial"
    authority: { allow: [Env] }
}

use {
    sys: core.sys
    time: core.time
}

run: fn() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
