// Application authority, partial declaration: the written row acknowledges Env, but the program also reads the clock.
// The program still runs; the run's one-line notice names exactly the effect the
// row leaves out, reading the clock, and nothing it acknowledges.
package: {
    name: "authority_partial"
    authority: { allow: [Env] }
}

use {
    sys: core.sys
    time: core.time
}

run: fn() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
