// Single-use (must-consume) values.
//
// A type marked `#SingleUse` carries a job that has to be done exactly once:
// the canonical case is a lock that must be released, or a task handle that
// must be joined. The compiler proves — at compile time, with the value erased
// from the generated code (I3) — that every `#SingleUse` value is consumed on
// every path through its scope:
//
//   - dropping it without using it      → E0140
//   - using it on only one `if` branch  → E0141
//   - lending it (`&`/read) instead of  → E0142
//     moving it
//   - using it twice                    → E0121 (reuses the move tracker)
//
// `#SingleUse` values are move-only: the value can only be moved (`^`), never
// copied. The only legal exits are moving it to a `^` parameter or returning it.
#SingleUse Lock: struct {
    resource: String
}

// Acquiring the lock hands back an owned `Lock`. The caller now owns the duty
// to release it exactly once.
acquire: fn(resource: String) -> Lock {
    print("locked {resource}")
    return Lock{resource: resource.copy()}
}

// `release` takes the lock by move (`^`) — this is the terminal consumption.
// After this call the lock is gone, and the duty is discharged.
release: fn(lock: &&Lock) { print("unlocked {lock.resource}") }

run: fn() {
    db: acquire("db")
    // ... use the locked resource ...
    release(db)
    // The duty travels with the value: handing it to another function that
    // returns it just moves the duty along.
    cache: acquire("cache")
    held: hold(cache)
    release(held)
    single_use_discard_lesson()
}

// A pass-through: takes the lock and returns it, leaving the consume duty with
// the caller.
hold: fn(lock: &&Lock) -> Lock {
    print("using {lock.resource}")
    return lock
}

// The deliberate-discard hatch for a
// `#SingleUse` value.
//
// A `#SingleUse` value carries a job that has to be done exactly once — the
// compiler proves it is consumed on every path (E0140/E0141/E0142). Almost
// always you want to *do* the job: release the lock, join the task. But once in
// a while you genuinely need to throw the value away without doing it — say the
// resource it guards is already gone. That is a real decision with consequences,
// so it has to be written down.
//
// The hatch is `consume(x)` inside an `#Unsafe("reason")` region or fn. The
// `#Unsafe` reason IS the audit note — there is no second audit channel. Outside
// an `#Unsafe` context, `drop` of a `#SingleUse` value is E0143, pointing you at
// the audited form.
//
// `drop` erases to a plain move-to-nowhere: the value's cleanup runs, no
// `unsafe` machine code is emitted. The `#Unsafe` gate is a compile-time audit,
// not a runtime cost.
#SingleUse Ticket: struct {
    id: String
}

issue: fn(id: String) -> Ticket { return Ticket{id: id.copy()} }

redeem: fn(ticket: &&Ticket) { print("redeemed {ticket.id}") }

single_use_discard_lesson: fn() {
    // The ordinary path: the ticket is consumed by being redeemed.
    a: issue("A")
    redeem(a)
    // The audited discard: this ticket is being voided on purpose — the event
    // it admitted to was cancelled, so there is nothing left to redeem. We say
    // so in the `#Unsafe` reason, and `drop` discharges the consume duty.
    b: issue("B")
    #Unsafe("event cancelled; the ticket admits to nothing, so voiding it is correct") {
        consume(b)
    }
    print("ticket B voided")
}
