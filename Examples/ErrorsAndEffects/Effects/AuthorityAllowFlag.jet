// Application authority, command-line acknowledgement: this file has no package block, so a plain run names the environment and clock reads it makes.
// Its golden runs it as `jet run --allow=Env,Time AuthorityAllowFlag.jet`; the
// flag acknowledges exactly the two named effects for that one run, so the run
// names nothing.
use {
    sys: core.sys
    time: core.time
}

run: fn() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
