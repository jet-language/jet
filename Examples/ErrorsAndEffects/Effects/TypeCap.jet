// A type cap: `#FX(…)` on a struct or enum bounds every method of the type,
// in its body or in an `impl` block apart from it. `Receipt` may only print
// and never touch files; `Coin`'s methods may not print. Every method keeps
// inside its cap, so the program runs; a method that reached past one would
// stop the check with E0749 (outside the ceiling, or denied).
#FX(IO, !FS)
Receipt: struct {
    total: Int

    show: fn(self) { print("total: {self.total}") }

    doubled: fn(self) -> Int { self.total * 2 }
}

#FX(!IO)
Coin: enum {
    Heads
    Tails

    label: fn(self) -> String {
        if self == {
            .Heads -> "heads"
            .Tails -> "tails"
        }
    }
}

run: fn() {
    receipt: Receipt{total: 12}
    receipt.show()
    print("doubled: {receipt.doubled()}")
    print("coin: {Coin.Tails.label()}")
}
