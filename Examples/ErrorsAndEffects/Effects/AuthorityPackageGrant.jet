// Application authority, written grant: a leading package block adds rights
// under `authority`. The row adds to the beginner floor (IO, Mem.Alloc,
// Exec.Args), so it names only Env and Time, and the run's notice names
// nothing. It also allows Net, which nothing here touches: a row is an upper
// bound, not a claim of use, so the program still runs. Without the row the
// program runs too, and the run names what it did; see AuthorityUndeclared.jet.
package: {
    name: "authority_package_grant"
    authority: { allow: [Env, Net, Time] }
}

use {
    sys: core.sys
    time: core.time
}

run: fn() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
