// Access sigils: the access marker rides the type — `&T` write,
// `&&T` move/take — and the call site mirrors it. Receivers carry the sigil on
// `self`. Plain `T` / `self` is read (the default, no sigil).
Player: struct {
    hp: Int
    name: String

    show: fn(self) -> Int { self.hp }

    heal: fn(&self, amount: Int) { self.hp += amount }
}

Item: struct {
    bonus: Int
    label: String
}

// `&Player` = the callee may edit the player; `amount: Int` is plain read.
damage: fn(p: &Player, amount: Int) { p.hp -= amount }

// Plain `Player` = shared/read access at a call boundary — no sigil needed.
report: fn(p: Player) { print("{p.name}: {p.hp}") }

// One call may mix them: edit the player in place and take the item. After
// the call the item is gone, so the caller can't use it again.
equip: fn(p: &Player, item: &&Item) {
    p.hp += item.bonus
    print("equipped {item.label}, hp now {p.hp}")
}

run: fn() {
    p := Player{hp: 100, name: "Aria"}
    damage(p, 30)  // call site mirrors the `&` write access
    report(p)  // plain read, no sigil
    p.heal(10)  // receiver `&self`, clean method-call syntax
    print(p.show())
    sword: Item{bonus: 20, label: "iron sword"}
    equip(p, sword)  // `&` mirrors write; `&&` mirrors take
    report(p)  // the caller still owns the player
}
