// All audited escapes use the same policy ladder.
// The organization policy may refuse any of these markers before an engine
// is selected. An invocation may name a permitted escape with
// `--gate <name>=allow`; the program itself stays engine-independent.
run: fn() {
    #Unsafe("the audited block has no low-level operation") {
        print("unsafe gate")
    }
    #Impure("the runtime block has no ambient comptime effect") {
        print("impure gate")
    }
    #Nondeterministic("the runtime block is deliberately audited") {
        print("nondeterministic gate")
    }
    lint_gate_reason_lesson()
}

// The reviewed explanation belongs to the written gate.
lint_gate_reason_lesson: fn() {
    #Allow(jet.UnitScalarRewrap, "this example demonstrates the source-owned lint gate")
    print("lint gate reason recorded")
}
