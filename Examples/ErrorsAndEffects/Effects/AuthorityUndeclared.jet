// Application authority, no declaration: a file with no package block may use every effect nothing denies.
// Reading an environment variable needs no grant, so the program runs; outside
// a terminal `jet run` names what it did in one stderr line, and `-A` (or an
// `allow` row naming Env) hides it.
use sys: core.sys

run: fn() {
    print("HOME set: {sys.get("HOME") != None}")
}
