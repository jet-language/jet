// S60 (E2-M16): `fn … -[]>` checked modifier.
// A `fn … -[]>` may only call other `fn … -[]>`s; impure calls are E3401.
// Use `jet eval --pure Pure.jet` to evaluate this deterministically.
double: fn(n: Int) -[]> Int { return (n * 2) }

greeting: fn(name: String) -[]> String { return "hello, {name}!" }

run: fn() {
    x: double(21)
    print("{x}")
    g: greeting("world")
    print(g)
}
