// A module cap: `#FX(…)` on a module bounds every function inside it, the
// function-row rule applied to a whole module. `pricing` may only print, and
// `audit` inside it also denies files and the network. `offline` is
// deterministic: it may not reach the network, files, other processes, the
// clock or random numbers, so the same prices always give the same checksum.
// Every function keeps inside its caps, so the program runs; a call that broke
// one would stop the check with E0749 (outside the ceiling, or denied).
#FX(IO)
pricing: module {
    total: fn(prices: [Int]) -> Int {
        sum := 0
        loop price in prices -> sum += price
        sum
    }

    report: fn(prices: [Int]) { print("total: {total(prices)}") }

    #FX(!FS, !Net)
    audit: module {
        check: fn(total: Int) -> Bool { total > 0 }
    }
}

#FX(!Net, !FS, !Exec, !Time, !Rand)
offline: module {
    checksum: fn(prices: [Int]) -> Int {
        hash := 17
        loop price in prices -> hash = hash * 31 + price
        hash
    }
}

run: fn() {
    prices: [Int]{3, 4, 5}
    pricing.report(prices)
    print("audited: {pricing.audit.check(pricing.total(prices))}")
    print("checksum: {offline.checksum(prices)}")
}
