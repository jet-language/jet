use {
    mime: core.net.mime
    url: core.net.url
}

// URL components use typed methods; host, explicit port, and fragment are optional.
run: fn() {
    base: url.parse("https://Bücher.example:443/a/./b/../c?x=1#frag")
    print(base.to_string())
    print(base.host() ?? "")
    print(base.path())
    print(base.query_pairs()[0][0])
    print(base.query_pairs()[0][1])
    rel: base.join("../notify?user=ada lovelace&user=grace#done")
    print(rel.to_string())
    print(rel.path_segments().join("|"))
    print(rel.fragment() ?? "")
    query: url.query([["user", "ada lovelace"], ["user", "grace"], ["empty", ""]])
    print(query)
    print(url.percent_encode("a b/c"))
    print(url.percent_decode("a%20b%2Fc") ?? "bad")
    html: mime.parse("Text/HTML; charset=UTF-8")
    print(html.essence())
    print(html.param("charset") ?? "none")
    print(mime.from_extension("png") ?? "none")
    print(mime.extension("image/png") ?? "none")
    png: mime.parse("image/png")
    print(url.data(png, "<h1>Hi</h1>").to_string())
    print(url.file("/tmp/a b.txt").to_string())

    auth: url.parse("https://ada:s3cret@example.com:8443/inbox")
    print(auth.username())
    print(auth.password())
    print(auth.userinfo())
    print(auth.authority())
    print(auth.default_port() ?? -1)
    receivers()
}

// Every URL and MIME component has its own typed reader.
receivers: fn() {
    base: url.parse("https://ada:s3cret@example.test:8443/a/./b/../c?old=1#frag")
    assembled: url.from_parts("https", "example.test", "/parts", [["q", "1"]], "frag")
    print("parts:{assembled.to_string()}")
    print("scheme:{base.scheme()}")
    print("authority:{base.authority()}")
    print("host:{base.host() ?? ""}")
    port: base.default_port() ?? -1
    print("port:{base.port() ?? -1}:{port}")
    print("path:{base.path()}")
    segments: base.path_segments().join("|")
    print("segments:{segments}")
    print("query:{base.query()}")
    print("pairs:{base.query_pairs().len()}")
    print("fragment:{base.fragment() ?? ""}")
    print("userinfo:{base.userinfo()}:{base.username()}:{base.password()}")
    normalized: base.normalize()
    joined: base.join("../next")
    print("normalized:{normalized.to_string()}")
    print("joined:{joined.to_string()}")
    media: mime.parse("application/json; charset=utf-8")
    print("mime:{media.media_type()}/{media.subtype()}")
    print("essence:{media.essence()}")
    charset: media.param("charset") ?? "none"
    print("params:{media.params().len()}:{charset}")
}
