// The wire contract the service and its client share. Both build from this
// one source, so the request and response shapes cannot drift apart.
contract: module {
}

#Codable
Health: struct {
    status: String
    api: String
}

#Codable
LoginRequest: struct {
    user: String
    password: String
}

#Codable
LoginResponse: struct {
    session: String
}

#Codable
OrderRequest: struct {
    item: String
    quantity: Int
}

#Codable
OrderResponse: struct {
    order_id: Int
    item: String
    quantity: Int
    api: String
}
