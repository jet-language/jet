// `read_into(buffer, limit)` appends up to `limit` bytes to a [U8] the
// caller keeps and returns the count, 0 at the end of the stream. TCP, Unix
// and TLS streams and file readers have it; one buffer serves every read.
package: {
    name: "read_into"
    authority: { allow: [Env, FS.Read, FS.Write, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use {
    files: core.files
    server: core.http.server
    net: core.net
    tls: core.net.tls
    os: core.sys
}

C_PAYLOAD: "read_into appends to the caller's buffer"

run: fn() (Closed | IOError | NetError | RangeError | TaskFailure)! {
    // TCP: eight bytes a read until the peer closes.
    typed: net.socket_addr("127.0.0.1", 0) ?? panic("address")
    listener: net.tcp_listen_addr(typed) ?? panic("listen")
    local: net.listener_local_socket_addr(listener) ?? panic("local address")
    { sender: ready_tx, receiver: ready_rx }: channel<String>()
    addr_text: net.socket_to_string(local)
    tcp_task: task {
        server_side := listener.move()
        ready_tx.send(addr_text)
        stream: server_side.accept() ?? panic("accept")
        stream.write_all(C_PAYLOAD.bytes()) ?? panic("tcp write")
        stream.close() ?? panic("tcp close")
    }
    addr: ready_rx.receive() ?? panic("ready")
    client: net.tcp_connect(addr) ?? panic("connect")
    tcp_buffer := [U8]{}
    loop {
        count: client.read_into(tcp_buffer, 8, deadline: 5s) ?? panic("tcp read_into")
        if count == 0 -> break
        if count > 8 -> panic("tcp read past its limit")
    }
    print("tcp: {tcp_buffer.len()} bytes: {String.from_bytes(tcp_buffer) ?? "?"}")
    if client.read_into(tcp_buffer, 0) == {
        .Ok(_) -> print("tcp limit 0: accepted")
        .Err(err) -> print("tcp limit 0: {err}")
    }
    print("tcp at end: {client.read_into(tcp_buffer, 8) ?? panic("tcp read at end")}")
    client.close() ?? panic("close")
    tcp_task.join() ?? panic("tcp server")

    // Unix: the deadline form, appending after what the buffer holds.
    path: "{os.temp_dir()}/jri-{os.pid()}.sock"
    unix_listener: net.unix_listen(path) ?? panic("unix listen")
    { sender: unix_tx, receiver: unix_rx }: channel<String>()
    unix_task: task {
        unix_tx.send("ready")
        peer := net.unix_accept(unix_listener) ?? panic("unix accept")
        net.unix_write_all_bytes(peer, C_PAYLOAD.bytes()) ?? panic("unix write")
        net.unix_close(peer) ?? panic("unix close")
    }
    _ready: unix_rx.receive() ?? panic("unix ready")
    unix_client := net.unix_connect(path) ?? panic("unix connect")
    unix_buffer := "unix> ".bytes()
    loop {
        count: unix_client.read_into(unix_buffer, 16, deadline: 5s) ?? panic("unix read_into")
        if count == 0 -> break
    }
    print(String.from_bytes(unix_buffer) ?? "?")
    net.unix_close(unix_client) ?? panic("unix close")
    unix_task.join() ?? panic("unix server")
    files.remove(path) ?? panic("remove socket")

    // TLS: an HTTPS response read into one buffer.
    ca: files.read("Fixtures/TLS/CustomRootCA.cert.pem") ?? panic("CA fixture")
    cert: files.read("Fixtures/TLS/CustomRootServer.cert.pem") ?? panic("server certificate fixture")
    key: files.read("Fixtures/TLS/CustomRootServer.key.pem") ?? panic("server key fixture")
    roots: tls.RootCertificates.from_pem(ca.bytes()) ?? panic("validate CA")
    config: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("trust policy")
    mux: server.mux()
    mux.get("/", (_request: HTTPRequest) -> Ok(server.response(200, "served by read_into")))
    https: server.bind("127.0.0.1:0", mux, tls: server.tls(cert, key)) ?? panic("bind TLS server")
    https_addr: https.local_addr() ?? panic("server address")
    serving: task { https.serve() ?? panic("serve TLS") }
    secure: tls.client(net.tcp_connect(https_addr) ?? panic("connect loopback"), server_name: "localhost", config: config, deadline: 5s) ?? panic("TLS handshake")
    crlf: String.from_bytes([U8]{13, 10}) ?? panic("CRLF")
    secure.write_all("GET / HTTP/1.1{crlf}Host: localhost{crlf}Connection: close{crlf}{crlf}".bytes(), deadline: 5s) ?? panic("request")
    tls_buffer := [U8]{}
    loop {
        count: secure.read_into(tls_buffer, 64, deadline: 5s) ?? panic("tls read_into")
        if count == 0 -> break
    }
    response: String.from_bytes(tls_buffer) ?? "?"
    print("tls: status 200: {response.starts_with("HTTP/1.1 200")}, body ends the buffer: {response.ends_with("served by read_into")}")
    if secure.read_into(tls_buffer, 0, deadline: 5s) == {
        .Ok(_) -> print("tls limit 0: accepted")
        .Err(err) -> print("tls limit 0: {err}")
    }
    secure.close() ?? panic("close TLS")
    _: https.shutdown(100ms) ?? panic("shutdown TLS server")
    _: serving.join() ?? panic("join TLS server")

    // A file reader: the buffer is cleared and reused for each chunk.
    file_path: "{os.temp_dir()}/jri-{os.pid()}.txt"
    files.write(file_path, C_PAYLOAD) ?? panic("write file")
    reader: files.open(file_path) ?? panic("open file")
    chunk := [U8]{}
    chunks := [String]{}
    loop {
        chunk.clear()
        count: reader.read_into(chunk, 16) ?? panic("file read_into")
        if count == 0 -> break
        chunks.push(String.from_bytes(chunk) ?? "?")
    }
    print("file: {chunks.join("|")}")
    if reader.read_into(chunk, -1) == {
        .Ok(_) -> print("file limit -1: accepted")
        .Err(err) -> print("file limit -1: rejected: {"{err}".ends_with("read_into needs a positive byte count, got -1")}")
    }
    files.remove(file_path) ?? panic("remove file")
}
