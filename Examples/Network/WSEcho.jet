// core.net.ws client/server echo over cleartext WebSocket.
package: {
    name: "ws_echo"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Net, Time] }
}

use {
    http_server: core.http.server
    time: core.time
    ws: core.net.ws
}

handle_ws: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    sock: ws.upgrade(req) ?? return Ok(http_server.response(400, "upgrade failed"))
    message: sock.recv() ?? return Ok(http_server.response(400, "recv failed"))
    if message.is_text() {
        text: message.text() ?? "bad"
        sock.send_text("echo:{text}") ?? return Ok(http_server.response(500, "send failed"))
    }
    sock.close(1000, "") ?? return Ok(http_server.response(500, "close failed"))
    return Ok(http_server.response(500, "unused"))
}

run: fn() (HTTPError | RangeError | TaskFailure | WsError)! {
    mux: http_server.mux()
    mux.get("/live", fn(req: HTTPRequest) { handle_ws(req) })
    server: http_server.bind("127.0.0.1:0", mux) ?? panic("bind")
    addr: server.local_addr() ?? panic("address")
    serving: task {
        server.serve() ?? panic("serve")
    }
    time.sleep(20ms)
    client: ws.connect("ws://{addr}/live") ?? panic("connect")
    client.send_text("ping") ?? panic("send")
    reply: client.recv() ?? panic("receive")
    print(reply.text() ?? "missing")
    grace: 100ms
    server.shutdown(grace) ?? panic("shutdown")
    serving.join() ?? panic("server")
}
