// DNS PTR + well-known service port table (core.net).
package: {
    name: "dns_lookup"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use net: core.net

run: fn() NetError! {
    http_port: net.getservbyname("http")
    print("getservbyname:http:{http_port}")
    https_name: net.getservbyport(443)
    print("getservbyport:443:{https_name}")
    // Live PTR is network-dependent; prove the call returns a Result without
    // baking answers into the golden.
    #Deadline(2s) {
        _: net.dns_ptr("1.1.1.1.in-addr.arpa")
    }
    print("dns_ptr:attempted")
}
