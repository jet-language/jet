// Project-locked browser provisioning.
// Lock a browser with Jetpack first:
//   jetpack browser lock chromium --binary /path/to/chromium
// Then read the pin with `browser.locked("chromium")` (needs FS+IO). Focused
// coverage lives in tests/browser_lock.rs; this example documents the surface
// offline.
use browser: core.web.browser

run: fn() { print("locked:jetpack_browser_lock+browser.locked+engine+protocol+verify") }
