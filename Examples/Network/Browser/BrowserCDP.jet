// Checked expert CDP supplement.
// `protocol("cdp")` opens the Chrome DevTools Protocol only when the session's
// abilities report it. The BiDi protocol refuses to smuggle a `goog:cdp.*`
// command, and the CDP protocol refuses a method that is not
// `Domain.command`, so each request goes through exactly one checked door.
//
// Run against a WebDriver BiDi endpoint the host supplies:
//   jet run Examples/Network/Browser/BrowserCDP.jet -- ws://127.0.0.1:9222/session
// The golden runs it against tests/fixtures/BrowserBidiMock.jet, which answers
// from BrowserCDP.bidi.json.
package: {
    name: "browser_cdp"
    authority: { allow: [Env, Net, Time] }
}

use browser: core.web.browser

#CLI
Endpoint: struct {
    #Doc("the WebDriver BiDi session URL") url: String
}

run: fn(args: Endpoint) {
    profile: browser.profile("bidi-2025.5")
    timeout: browser.timeout(500)
    session: browser.connect_profile(args.url, profile, timeout)
    abilities: session.abilities()
    print("abilities: BiDi {abilities.bidi()}, CDP {abilities.cdp()}")

    bidi: session.protocol("bidi")
    smuggled: bidi.send("goog:cdp.sendCommand", "{{\"method\":\"Network.enable\",\"params\":{{}}}}") ?? "refused"
    print("BiDi goog:cdp.sendCommand: {smuggled}")

    cdp: session.protocol("cdp")
    misplaced: cdp.send("session.status", "{{}}") ?? "refused"
    print("CDP session.status: {misplaced}")
    reply: cdp.send("Network.setCacheDisabled", "{{\"cacheDisabled\":true}}")
    print("CDP Network.setCacheDisabled: {reply}")

    trace: session.trace()
    print("trace redacted: {trace.redacted()}, names the CDP method: {trace.summary().contains("Network")}")
    session.close()
}
