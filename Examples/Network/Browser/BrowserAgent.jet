// Agent-facing browser automation cookbook.
// Replace Node/Playwright scripts with this shape. Provision first:
//   jetpack browser lock chromium --binary /path/to/chromium
// Then connect to a BiDi endpoint the host supplies (never hard-code secrets).
use browser: core.web.browser

timeout_ok: fn(milliseconds: Int) -> String {
    browser.timeout(milliseconds) ?? return "false"
    return "true"
}

run: fn() {
    // Offline agent checklist — the production path is profile → connect →
    // isolated context → semantic locators → explicit cleanup + receipt.
    print("agent:lock=jetpack_browser_lock")
    print("agent:connect=browser.connect_profile(endpoint,profile,timeout)")
    print("agent:beginner=get_by_role|text|label+wait+click|fill")
    print("agent:network=subscribe+add_intercept+continue|fail|fulfill")
    print("agent:artifacts=cookie+storage+set_files+screenshot+pdf")
    print("agent:expert=protocol(cdp)_after_abilities.cdp")
    print("agent:privacy=receipt.redacted+isolated_profiles+explicit_close")
    print("agent:no_node_playwright_runtime")
    print("agent:timeout_ok:{timeout_ok(5_000)}")
    browser_bidi_profiles_lesson()
}

// Browser profiles are pinned client command contracts.

profile_outcome: fn(name: String) -> String {
    profile: browser.profile(name) ?? return "rejected"
    return "accepted"
}

timeout_outcome: fn(milliseconds: Int) -> String {
    timeout: browser.timeout(milliseconds) ?? return "rejected"
    return "accepted"
}

browser_bidi_profiles_lesson: fn() {
    print("2024.11:{profile_outcome("bidi-2024.11")}")
    print("2025.5:{profile_outcome("bidi-2025.5")}")
    print("rolling:{profile_outcome("rolling")}")
    print("timeout:{timeout_outcome(500)}")
}
