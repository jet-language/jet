# The example drives the scripted WebDriver BiDi mock, which answers each
# command from BrowserArtifacts.bidi.json, sends the download event, and
# prints each method it received.
session bidi raw: {jet} run --allow=Exec,FS.Read,FS.Write,Net,Time {root}/tests/fixtures/BrowserBidiMock.jet -- script {free-port:bidi} BrowserArtifacts.bidi.json
await: file BrowserArtifacts.bidi.ready timeout 30s
step: built ws://127.0.0.1:{free-port:bidi}/session
exit: 0
stdout: = BrowserArtifacts.out
stdout: !~ "QUARTERLY_REPORT" # a download's file name reaches the program only as a hash
close bidi
exit: 0
stdout: has-line "browser.setDownloadBehavior" # downloads were allowed first
stdout: has-line "input.setFiles" # the file input took the path
stdout: $= "session.end\n" # the example ended its session last
