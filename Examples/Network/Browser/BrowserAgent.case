# The example drives the scripted WebDriver BiDi mock, which answers each
# command from BrowserAgent.bidi.json and prints each method it received.
session bidi raw: {jet} run --allow=Exec,FS.Read,FS.Write,Net,Time {root}/tests/fixtures/BrowserBidiMock.jet -- script {free-port:bidi} BrowserAgent.bidi.json
await: file BrowserAgent.bidi.ready timeout 30s
step: built ws://127.0.0.1:{free-port:bidi}/session
exit: 0
stdout: = BrowserAgent.out
close bidi
exit: 0
stdout: has-line "input.performActions" # the click reached the browser
stdout: has-line "goog:cdp.sendCommand" # the CDP command went through the checked protocol
stdout: $= "session.end\n" # the example ended its session last
