// Cleanup, profile isolation, privacy, and redaction.
// Each context is its own BiDi user context, so a cookie set in one is absent
// from another. The session's privacy defaults keep profiles isolated and
// receipts redacted: a receipt names what was opened and closed without the
// endpoint, its token, or any page value.
//
// Run against a WebDriver BiDi endpoint the host supplies:
//   jet run Examples/Network/Browser/BrowserPrivacy.jet -- ws://127.0.0.1:9222/session
// The golden runs it against tests/fixtures/BrowserBidiMock.jet, which answers
// from BrowserPrivacy.bidi.json.
package: {
    name: "browser_privacy"
    authority: { allow: [Env, Net, Time] }
}

use browser: core.web.browser

#CLI
Endpoint: struct {
    #Doc("the WebDriver BiDi session URL") url: String
}

run: fn(args: Endpoint) {
    profile: browser.profile("bidi-2025.5")
    timeout: browser.timeout(500)
    session: browser.connect_profile(args.url, profile, timeout)
    privacy: session.privacy()
    print("isolated profiles: {privacy.isolated_profiles()}, shared profiles: {privacy.shared_profiles()}, redacted receipts: {privacy.redact_receipts()}")

    left: session.context()
    right: session.context()
    print("contexts isolated: {left.isolated() && right.isolated()}, distinct user hashes: {left.user_hash() != right.user_hash()}")

    left_page: left.page()
    right_page: right.page()
    left_page.set_cookie("session", "signed-in", "example.test")
    print("left cookie: {left_page.cookie("session") ?? "(none)"}")
    print("right cookie: {right_page.cookie("session") ?? "(none)"}")

    left_page.close()
    right_page.close()
    left.close()
    right.close()
    session.close()

    receipt: session.receipt()
    print("receipt cleaned: {receipt.cleaned()}, isolated: {receipt.isolated()}, redacted: {receipt.redacted()}")
    print("receipt names the endpoint: {receipt.summary().contains("ws://")}, the cookie: {receipt.summary().contains("signed-in")}")
}
