// core.net.dtls client/server echo over loopback UDP with DTLS 1.2 cookie
// exchange, custom CA verification, ALPN negotiation, and close_notify.
package: {
    name: "dtls_echo"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use {
    dtls: core.net.dtls
    tls: core.net.tls
}

DTLS_ECHO_CA: #run embed_bytes("Fixtures/TLS/CustomRootCA.cert.pem")

DTLS_ECHO_CERT: #run embed_bytes("Fixtures/TLS/CustomRootServer.cert.pem")

DTLS_ECHO_KEY: #run embed_bytes("Fixtures/TLS/CustomRootServer.key.pem")

run: fn() {
    roots: tls.RootCertificates.from_pem(DTLS_ECHO_CA) ?? panic("CA roots")
    cli_cfg0: dtls.DTLSClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("client trust")
    cli_cfg: cli_cfg0.with_alpn([String]{"dtls-echo"}) ?? panic("client ALPN")
    srv_cfg0: dtls.DTLSServerConfig.from_pem(DTLS_ECHO_CERT, DTLS_ECHO_KEY) ?? panic("server identity")
    srv_cfg: srv_cfg0.with_alpn([String]{"dtls-echo"}) ?? panic("server ALPN")
    listener: dtls.listen("127.0.0.1:0", srv_cfg) ?? panic("listen DTLS")
    addr: listener.local_addr() ?? panic("local address")
    budget: 5s
    serving: task {
        server_session: listener.accept(deadline: budget) ?? panic("accept DTLS")
        msg: server_session.read(4096, deadline: budget) ?? panic("server read")
        server_session.write("echo:{msg}", deadline: budget) ?? panic("server write")
        eof: server_session.read_bytes(4096, deadline: budget) ?? panic("server close_notify")
        if eof.len() != 0 -> panic("expected close_notify EOF")
        server_session.finish() ?? panic("server close")
        listener.finish() ?? panic("listener close")
    }
    client_session: dtls.connect(addr, server_name: "localhost", config: cli_cfg, deadline: budget) ?? panic("connect DTLS")
    peer: client_session.peer_identity()
    print(client_session.protocol_version())
    print(peer.verified_server_name)
    print(client_session.alpn_protocol() ?? "none")
    client_session.write("ping", deadline: budget) ?? panic("client write")
    reply: client_session.read(4096, deadline: budget) ?? panic("client read")
    print(reply)
    client_session.finish() ?? panic("client close")
    serving.join() ?? panic("join server")
}
