// The same HTTP server Prelude runs as a WASI Preview 2
// Component. The external wasmtime probe owns the request and shutdown.
// `Output.Service` declares that `run` serves until it is stopped.
package: {
    name: "http_server_wasip2"
    authority: { allow: [FS.Read, IO, Net, Time] }
}

use web: core.web
use http_server: core.http.server

SERVER: Output.Service{ name: "http_server_wasip2", entry: run }

run: fn() HTTPError! {
    mux: web.app()
    mux.get("/", fn(_req: HTTPRequest) { Ok(http_server.response(200, "hello from wasip2")) })
    server: mux.bind("127.0.0.1:18080") ?? panic("bind")
    addr: server.local_addr() ?? panic("address")
    print(addr.starts_with("127.0.0.1:"))
    server.serve() ?? panic("serve")
}
