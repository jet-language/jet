// Tags expose only this explicitly mounted value.
package: {
    name: "http_route_markers"
    authority: { allow: [FS.Read, Net, Time] }
}

use {
    core.http.client
    core.http.server
    net: core.net
    web: core.web
}

#Codable
NewJoke: struct {
    text: String,
}

JokeState: struct {
    added: Int,
}

Jokes: struct {
    prefix: String,
    state: Shared<JokeState>,

    #Server.Get("/jokes/:id") joke: fn(self, id: Int) -> HTTPResponse HTTPError! {
        count: self.state.guard_read().value.added
        Ok(server.response(200, "{self.prefix} {id} added={count}"))
    }

    #Server.Post("/jokes") add: fn(self, request: HTTPRequest) -> HTTPResponse HTTPError! {
        input: request.json<NewJoke>()
        self.state.guard_edit().value.added += 1
        Ok(server.response(201, "{self.prefix}: {input.text}"))
    }

    #Server.Get("/order/:name") first: fn(self, name: String) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "first:{name}"))
    }

    #Server.Get("/order/fixed") second: fn(self) -> HTTPResponse HTTPError! {
        Ok(server.response(200, "second"))
    }
}

run: fn() (HTTPError | NetError | TaskFailure)! {
    mux: web.app()
    state: Shared{JokeState{added: 0}}
    mux.get("/before/:name", fn(name: String) { Ok(server.response(200, "before:{name}")) })
    mux.mount(Jokes{prefix: "joke", state: state})
    mux.get("/order/after", fn() { Ok(server.response(200, "after")) })
    mux.get("/before/fixed", fn() { Ok(server.response(200, "late")) })
    schema: web.openapi(mux) ?? panic("openapi: {err}")
    print("openapi-get:{schema.contains("/jokes/") && schema.contains("\"get\"") && schema.contains("\"id\"")}")
    print("openapi-post:{schema.contains("\"/jokes\"") && schema.contains("\"post\"") && schema.contains("\"201\"") && schema.contains("\"text\"")}")
    listener: net.tcp_listen("127.0.0.1:0")
    addr: listener.local_addr()
    serving: task {
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
        mux.serve_once(listener)
    }
    got: client.get("http://{addr}/jokes/7")
    got_text: got.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("get:{got.status()}:{got_text}")
    added: client.request("POST", "http://{addr}/jokes").json(NewJoke{text: "hello"}).send()
    added_text: added.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("post:{added.status()}:{added_text}")
    again: client.get("http://{addr}/jokes/7")
    again_text: again.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("shared:{again_text}:{state.guard_read().value.added}")
    before: client.get("http://{addr}/before/fixed")
    before_text: before.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("value-before:{before_text}")
    ordered: client.get("http://{addr}/order/fixed")
    ordered_text: ordered.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("mounted-order:{ordered_text}")
    after: client.get("http://{addr}/order/after")
    after_text: after.body().text(1024) ?? {
        serving.detach()
        return
    }
    print("value-after:{after_text}")
    serving.join()
}
