// Middleware composes on the same Handler server engine.
package: {
    name: "http_server_middleware"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use {
    web: core.web
    http_client: core.http.client
    http_server: core.http.server
    time: core.time
}

outer: fn(next: HTTPHandler) -> HTTPHandler {
    owned: next.copy()
    return fn(req: HTTPRequest) {
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "outer>{response.text() ?? "invalid body"}<outer"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

inner: fn(next: HTTPHandler) -> HTTPHandler {
    owned: next.copy()
    return fn(req: HTTPRequest) {
        if req.path() == "/blocked" -> return Ok(http_server.response(403, "blocked"))
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "inner>{response.text() ?? "invalid body"}<inner"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

run: fn() (HTTPError | RangeError | TaskFailure)! {
    mux: web.app()
    mux.request_id()
    mux.middleware(outer)
    mux.middleware(inner)
    mux.get("/ok", fn() { Ok(http_server.response(200, "handler")) })
    mux.get("/blocked", fn() { Ok(http_server.response(200, "must not run")) })
    server: mux.bind("127.0.0.1:0") ?? panic("bind")
    addr: server.local_addr() ?? panic("address")
    serving: task { server.serve() ?? panic("serve") }
    time.sleep(20ms)
    success: http_client.get("http://{addr}/ok") ?? panic("ok request")
    print(success.status())
    print(success.text() ?? "invalid body")
    blocked: http_client.get("http://{addr}/blocked") ?? panic("blocked request")
    print(blocked.status())
    print(blocked.text() ?? "invalid body")
    grace: 100ms
    server.shutdown(grace) ?? panic("shutdown")
    serving.join() ?? panic("server")
}
