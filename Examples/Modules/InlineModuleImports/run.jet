// An inline module imports a sibling module under its own alias, which
// shadows the file's alias of the same name. `recipe` imports the sibling
// file `units.jet` as `fmt`; that alias binds inside `recipe` only. The file's
// own `fmt` (the sibling `labels.jet`) stays in force everywhere else, and the
// lookup inside `recipe` never falls through to it.
use fmt: labels

recipe: module {
    use fmt: units

    line: fn(name: String, grams: Int) -> String { "{name}: {fmt.kilos(grams)}" }
}

run: fn() {
    print(recipe.line("flour", 2500))
    print(recipe.line("sugar", 750))
    print(fmt.shout("done"))
}
