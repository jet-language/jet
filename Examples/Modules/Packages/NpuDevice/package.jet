// A compute device that a package adds. The `acme_npu` dependency
// implements `compute.Accelerator` for its NPU; no compiler or Core change
// names that device. `compute.accelerator` admits the device only after the
// CPU reference suite passes on it, and `compute.launch` checks each answer
// the device gives against the CPU result.
name: "npu_device_demo"
version: "0.1.0"
deps: {
    acme_npu: ./AcmeNpu,
}
authority: {
    allow: [GPU, IO, Mem.Alloc],
}
