// Declared typed settings fold before code generation.
name: "typed_settings_demo"
version: "0.1.0"
settings: {
    tls: Bool = true,
    api_base: String = "https://api.example.com",
}
build: {
    release: Build{
        optimize: O2,
        settings: { tls: false },
    },
}
authority: {
    allow: [IO]
}
