// c81: the sandbox's own source, committed as `../mathkit.wasm`
// rather than run directly — no `run: fn()`,
// this package is loaded, not executed. v1 sandbox exports use one homogeneous
// Component Model scalar shape: Int, Float, Bool, or Text
// only, and may not use any effect — the plugin
// host that loads this registers zero host imports (safe by
// default, no `#Unsafe` gate anywhere in this story).
use math: core.math

scale: fn(a: Float, b: Float) -> Float { a * b }

hypot: fn(a: Float, b: Float) -> Float { math.sqrt(a * a + b * b) }

gcd: fn(a: Int, b: Int) -> Int {
    x := a
    y := b
    loop y != 0 {
        t: y.copy()
        y = x % y
        x = t
    }
    return x
}

is_enabled: fn(flag: Bool) -> Bool { flag }

greet: fn(name: String) -> String { "hello, {name}!" }
