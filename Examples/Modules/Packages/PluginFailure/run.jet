// A plugin runs under the narrow Authority the host hands it. Every guest
// failure (a trap, a denied read, a spent fuel budget, a malformed module)
// comes back as a typed error, and the host keeps running.
// The host accepts this Component text fixture directly.
// Copy fixture-state/cache/api to .jet/cache/api before the first host build.
// Run this host unchanged with jet run and jet build, from this directory:
// the artifact paths name files in the package root.
use plugin: core.plugin

run: fn() {
    policy: Authority.from_rights(["FS.Read:."])
    guest: plugin.load("failure_guest.wat", policy)
    if guest.trap() == {
        .Err(.Guest(fault)) -> {
            assert(fault.export == "trap")
            assert(fault.frames.len() > 0 && fault.frames.len() <= 32)
            frame: fault.frames[0]
            assert(frame.function == "trap")
            assert(frame.component == "failure_guest")
            assert(frame.offset > 0)
            print("trap:Guest export={fault.export} function={frame.function} component={frame.component} located={frame.offset > 0}")
        }
        .Ok(_) | .Err(.Denied(_)) | .Err(.Budget(_, _)) | .Err(.Defect(_)) -> assert(false)
    }
    reader: plugin.load("failure_guest.wat", policy)
    if reader.read() == {
        .Err(.Denied(fault)) -> {
            assert(fault.export == "read")
            assert(fault.frames.len() == 0)
            print("read:Denied export={fault.export} frames={fault.frames.len()}")
        }
        .Ok(_) | .Err(.Guest(_)) | .Err(.Budget(_, _)) | .Err(.Defect(_)) -> assert(false)
    }
    spinner: plugin.load("failure_guest.wat", policy)
    if spinner.spin() == {
        .Err(.Budget(.Fuel, fault)) -> {
            assert(fault.export == "spin")
            assert(fault.frames.len() > 0 && fault.frames.len() <= 32)
            print("spin:Budget Fuel export={fault.export}")
        }
        .Ok(_) | .Err(.Guest(_)) | .Err(.Denied(_)) | .Err(.Budget(.Memory, _)) | .Err(.Budget(.Table, _)) | .Err(.Budget(.Time, _)) | .Err(.Budget(.Wire, _)) | .Err(.Defect(_)) -> assert(false)
    }
    normal: plugin.load("failure_guest.wat", policy)
    value: normal.normal()
    assert(value == 42)
    print("normal:Ok {value}")
    malformed: plugin.load("malformed_guest.wasm", policy)
    if malformed.normal() == {
        .Err(.Guest(fault)) -> {
            assert(fault.export == "load")
            assert(fault.frames.len() == 0)
            print("malformed:Guest export={fault.export} frames={fault.frames.len()}")
        }
        .Ok(_) | .Err(.Denied(_)) | .Err(.Budget(_, _)) | .Err(.Defect(_)) -> assert(false)
    }
    print("host:still-running")
}
