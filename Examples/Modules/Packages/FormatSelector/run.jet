// `{sky:Color}` is palette's ColorFormat, imported like any trait: the
// selector `:Color` calls `sky.color()`. `:Shade(half, "dusk")` passes its
// arguments after the value, the number computed at run time.
use palette.[ColorFormat, RGB, ShadeFormat]

run: fn() {
    sky: RGB{red: 135, green: 206, blue: 235}
    half: 50
    print("sky is {sky:Color}")
    print("{sky:Shade(half, "dusk")}")
    print("{sky:Shade(100, "noon")}")
}
