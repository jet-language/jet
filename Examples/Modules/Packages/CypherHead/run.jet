// `Cypher{"… {age} …"}` is the cypher package's head: each hole is bound as
// a value, never spliced into the query text, exactly like Core's SQL.
use cypher.[Cypher]

run: fn() {
    ^age: 42
    ^name: "Ada') DETACH DELETE p //"
    ^query: Cypher{"MATCH (p:Person) WHERE p.age > {age} AND p.name = {name} RETURN p"}
    print(query.text)
    loop param in query.params -> print(cypher.show(param))
    print(query.params.len())
}
