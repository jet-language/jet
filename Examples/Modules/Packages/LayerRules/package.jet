// Package `layers:` orders modules lowest first so imports may only point to
// the same layer or a lower one. Upward imports fail `jet check` with E0646;
// callbacks from lower layers invert cleanly through a trait in the lower layer.
name: "layer_rules_demo"
version: "0.1.0"
edition: "2026"
layers: {
    storage: ["storage"]
    domain: ["domain"]
    ui: ["ui"]
}
