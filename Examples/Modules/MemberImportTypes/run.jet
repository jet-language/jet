// A member import names any public declaration of a file module,
// and qualified or contextual enum spellings follow the imported enum.
use {
    "types"
    types.[Span, Kind, Named, make_span]
}

Holder: struct {
    kind: types.Kind
}

Local: struct { n: Int }

impl Local.Named {
    label: fn(self) -> String { "local {self.n}" }
}

width: fn(span: Span) -> Int { span.end - span.start }

value: fn(kind: types.Kind) -> Int {
    if kind == {
        .Alpha -> 0
        .Beta(v) -> v
    }
}

held: fn(h: Holder) -> Int {
    if h.kind == {
        .Alpha -> 0
        .Beta(v) -> v
    }
}

run: fn() {
    print(width(make_span(2, 7)))
    beta: types.Kind.Beta(3)
    print(value(beta))
    print(value(.Beta(4)))
    print(held(Holder{kind: .Alpha}))
    print(beta == types.Kind.Alpha)
    first: Kind.Beta(9)
    print(value(first))
    print(Local{n: 1}.label())
}
