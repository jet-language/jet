// Declarations another file selects by name: a struct, an enum, a trait and a
// function all travel through one member import.
Span: struct {
    start: Int
    end: Int
}

Kind: enum { Alpha Beta(Int) }

Named: trait {
    label: fn(self) -> String
}

make_span: fn(start: Int, end: Int) -> Span { Span{start: start, end: end} }
