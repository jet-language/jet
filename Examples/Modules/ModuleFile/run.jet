// File-based module declaration: `math: module` loads `math.jet`. Callers
// may qualify its items, or `use alias.Item` brings them into unqualified
// scope.
use {
    math.clamp
    math.[lo, hi]
}

math: module

run: fn() {
    print(math.clamp(15, 0, 10))
    print(math.clamp(-5, 0, 10))
    print(clamp(200, lo(), hi()))
}
