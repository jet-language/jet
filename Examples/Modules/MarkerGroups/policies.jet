Label: struct {
    text: String

    impl Marker {
        sites: [.Function]
    }
}
Fast: struct {
    impl Marker {
        group: #[Label("fixed in this module"), Inline(.Always), Scalar]
    }
}

inner: module {
    Trace: struct {
        impl Marker {
            sites: [.Function]
        }
    }
    Traced: struct {
        impl Marker {
            group: #[Trace, Inline]
        }
    }
}
