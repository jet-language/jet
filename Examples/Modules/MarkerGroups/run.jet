// Fixed groups keep the original rules; imported applications name their alias.
use policy: policies

Checked: struct {
    impl Marker {
        group: #[Inline(.Always), Scalar]
    }
}

#Checked
local: fn(value: Int) -> Int { return value + 1 }

#Policy.Fast
imported: fn(value: Int) -> Int { return value * 2 }

#Policy.Inner.Traced
nested: fn(value: Int) -> Int { return value + 3 }

run: fn() {
    print("local:{local(6)}")
    print("imported:{imported(6)}")
    print("nested:{nested(6)}")
}
