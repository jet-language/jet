// A typed build setting is a legal generic-module value.
package: {
    name: "fact_value_arguments"
    settings: {
        cache_slots: Int = 3,
    }
    build: {
        compact: Build{ optimize: full, settings: { cache_slots: 2 } },
        spacious: Build{ optimize: full, settings: { cache_slots: 5 } },
    }
}

cache: module<K>(capacity: Int) {
    Buffer: struct {
        priv items: [K#capacity]
    }

    slots: fn() -> Int { capacity }
}

tuned: cache<Int>($build.settings.cache_slots)

run: fn() { print(tuned.slots()) }
