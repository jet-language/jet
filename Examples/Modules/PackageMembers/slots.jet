// Generic types, inherent methods and free functions keep their declaring file.
Slot: struct<T> { value: T }
impl Slot {
    get: fn(self) -> T { self.value }
}

// This source-defined Pool is not the Core allocator with the same leaf name.
Pool: struct<T> { items: [T] }
pool_copy: fn<T>(pool: Pool<T>) -> Pool<T> { pool.copy() }
pool_len: fn<T>(pool: Pool<T>) -> Int { pool.items.len() }

identity: fn<T>(value: T) -> T { value }
wrap: fn<T>(value: T) -> Slot<T> { Slot<T>{value: value} }
