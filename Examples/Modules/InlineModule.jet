// Inline code modules — group functions AND types under a named
// namespace. A member type is visible to its own module by its bare name and
// to the rest of the file by its qualified `module.Type` spelling. A `priv`
// field belongs to the inline module, so the rest of the file reads it
// through the module's functions.
arith: module {
    Tally: struct {
        priv total: Int
    }

    double: fn(n: Int) -> Int { n * 2 }

    add: fn(a: Int, b: Int) -> Int { a + b }

    tally: fn(a: Int, b: Int) -> Tally { return Tally{total: add(a, b)} }

    total: fn(t: Tally) -> Int { t.total }
}

describe: fn(t: arith.Tally) -> String { "total {arith.total(t)}" }

run: fn() {
    print(arith.double(5))
    print(arith.add(3, 4))
    print(arith.total(arith.tally(3, 4)))
    print(describe(arith.tally(1, 2)))
}
