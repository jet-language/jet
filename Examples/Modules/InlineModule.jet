// Inline code modules — group functions AND types under a named
// namespace. A member type is visible to its own module by its bare name and
// to the rest of the file by its qualified `module.Type` spelling.
arith: module {
    Tally: struct {
        priv total: Int
    }

    double: fn(n: Int) -> Int { n * 2 }

    add: fn(a: Int, b: Int) -> Int { a + b }

    tally: fn(a: Int, b: Int) -> Tally { return Tally{total: add(a, b)} }
}

describe: fn(t: arith.Tally) -> String { "total {t.total}" }

run: fn() {
    print(arith.double(5))
    print(arith.add(3, 4))
    print(arith.tally(3, 4).total)
    print(describe(arith.tally(1, 2)))
}
