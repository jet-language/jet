// A library's markers. `Get` marks a handler method with its path, and
// `#Router` on a type writes `routes`, which lists each `Get` handler of the
// type. An importer names both through its import: `use web: routes` writes
// `#Web.Get` and `#Web.Router`.
Get: struct {
    path: String,

    impl Marker {
        sites: [.Method],
    }
}

Router: struct {
    impl Marker {
        sites: [.Type],

        expand: fn(self, target: Target) -[Meta.Generate]> {
            tname: target.name
            impl #{tname} {
                // One line per handler: its path and the method it calls.
                routes: fn(self) -> String {
                    ^lines: [String]{}
                    #loop m in target.methods {
                        #if m.marker(Get) != None {
                            lines.push("GET {m.marker(Get)?.path ?? ""} -> {m.name}")
                        }
                    }
                    lines.join("\n")
                }
            }
        }
    }
}
