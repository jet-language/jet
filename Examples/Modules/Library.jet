// E2-M6: library authoring ergonomics
// Demonstrates S61 (labels/defaults), S62 (delegation), S77 (field punning),
// default method bodies, and declared `!` conversion.
// --- S61: argument labels and trailing defaults ---
greet: fn(name: String, loud: Bool{false}) -> String {
    if loud -> return "HELLO {name}!"
    return "hello {name}."
}

// ---: trait with a default method body ---
Greetable: trait {
    greeting: fn(self) -> String
    announce: fn(self) -> String {
        g: self.greeting()
        return "[ {g} ]"
    }
}

Person: struct {
    name: String

    impl Greetable {
        greeting: fn(self) -> String {
            n: self.name
            return "hi, I'm {n}"
        }
    }
}

// `announce` uses the default from the trait
// --- S77: field punning ---
Point: struct {
    x: Int
    y: Int
}

make_point: fn(x: Int, y: Int) -> Point {
    return Point{x: x, y: y}  // S77 puns: x:x, y:y
}

// --- S62: trait delegation ---
Logger: trait {
    log: fn(self, msg: String)
}

ConsoleLogger: struct {
    prefix: String

    impl Logger {
        log: fn(self, msg: String) {
            p: self.prefix
            print("{p}: {msg}")
        }
    }
}

App: struct {
    logger: ConsoleLogger

    // S62: forwards Logger methods to `logger`
    impl Logger using logger
}

run: fn() {
    // S61 labels + defaults
    print(greet("world"))
    print(greet("world", true))
    // default method body
    p: Person{name: "Ada"}
    print(p.greeting())
    print(p.announce())
    // S77 field punning
    pt: make_point(3, 4)
    print(pt.x)
    print(pt.y)
    // S62 delegation
    app: App{logger: ConsoleLogger{prefix: "INFO"}}
    app.log("delegation works")
}
