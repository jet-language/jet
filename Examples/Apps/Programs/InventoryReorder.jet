// User story: a stock clerk wants a quick reorder list.
Stock: struct {
    name: String
    on_hand: Int
    reorder_at: Int
}

status: fn(item: Stock) -> String {
    if item.on_hand <= item.reorder_at -> return "reorder"
    return "ready"
}

run: fn() {
    stock: [Stock]{
        {name: "notebooks", on_hand: 8, reorder_at: 10},
        {name: "pens", on_hand: 30, reorder_at: 12},
        {name: "folders", on_hand: 4, reorder_at: 4},
    }
    shown := 0
    loop item in stock {
        print("{item.name}: {status(item)}")
        shown += 1
    }
    print("items checked: {shown}")
}
