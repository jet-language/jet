// User story: a build job exposes legal states and legal transitions.
//
// Anti-pattern from the dogfood port: `state := "running"` plus parallel
// `seen_started := true` / `seen_finished := false` values allowed impossible
// combinations. Rule: model finite values with an enum and a
// nested variant group, group equivalent arms with `|`, and use typestate
// transitions for order that must be checked at compile time.
ParsedManifest: tag { deny: [Net] }

Phase: enum {
    Draft
    Active
    Terminal {
        Done
        Failed
    }
}

// A tag records parser provenance without another state boolean.
parse_manifest: fn(name: String) -> #ParsedManifest String { name.copy() }

phase_kind: fn(phase: Phase) -> String {
    label := "unknown"
    if phase == {
        .Draft -> { label = "pending" }
        .Active -> { label = "working" }
        // The group arm covers both terminal leaves.
        .Terminal -> { label = "terminal" }
    }
    return label
}

Build: struct {
    state { Queued, Running, Finished }

    name: String
}

impl Build {
    #Transition(_, Queued) queue: fn(name: String) -> Build { {name: name.copy()} }

    #Transition(Queued, Running) start: fn(self: &&Build) -> Build { self }

    #Transition(Running, Finished) finish: fn(self: &&Build) -> Build { self }

    #State(Finished) report: fn(self) -> String { "finished:{self.name}" }
}

run: fn() {
    print(phase_kind(Phase.Draft))
    print(phase_kind(Phase.Terminal.Failed))

    parsed: parse_manifest("manifest")
    print("tagged:{parsed}")

    build := Build.queue("compile")
    build = build.start()
    build = build.finish()
    print(build.report())
}
