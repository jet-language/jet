// User story: a support lead wants the open tickets that need attention.
Ticket: struct {
    id: Int
    customer: String
    priority: Int
    open: Bool
}

run: fn() {
    tickets: [Ticket]{
        {id: 101, customer: "Ada", priority: 1, open: true},
        {id: 102, customer: "Lin", priority: 3, open: false},
        {id: 103, customer: "Mina", priority: 2, open: true},
    }
    loop ticket in tickets {
        if ticket.open -> print("{ticket.id} {ticket.customer} p{ticket.priority}")
    }
}
