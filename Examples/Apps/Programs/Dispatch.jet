// User story: a parser routes string keys without a chain of guard branches.
//
// Anti-pattern from the dogfood port: adjacent guards made one categorical
// table look like unrelated validation:
// `if key == "revision" -> return "revision"`
// `if key == "path" -> return "path"`
// Rule: use one ordered subject table and group aliases
// with `|`.
field_kind: fn(key: String) -> String {
    if key == {
        "revision" | "rev" -> "revision"
        "path" | "root" -> "path"
        "profile" | "flavor" -> "profile"
        else -> "unknown"
    }
}

command_kind: fn(verb: String) -> String {
    if verb == {
        "list" | "ls" -> "list"
        "show" | "get" -> "show"
        else -> "unknown"
    }
}

run: fn() {
    print(field_kind("rev"))
    print(field_kind("root"))
    print(command_kind("get"))
    print(field_kind("other"))
}
