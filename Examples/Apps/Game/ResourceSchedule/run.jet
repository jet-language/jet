use game: core.game

Position: struct {
    x: Int
}

simulate: fn(positions: &Position) { positions.x += 1 }

draw_scene: fn(positions: Position) { print("draw={positions.x}") }

run: fn() {
    scene := game.Scene.new("resource-schedule")
    scene.on_frame(
    frame -> {
        positions := Position{x: frame.index}
        simulate(positions) ?? panic("simulate")
        draw_scene(positions)
    },
    )
    transcript: game.run(scene)
    print(transcript)
}
