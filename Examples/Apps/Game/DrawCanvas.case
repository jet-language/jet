# The program saves its headless window's first frame as Frame.pam; every
# tier must rasterize the same bytes. The SHA-256 is that of the clear and
# three rectangles under straight-alpha src-over, (s * a + d * (255 - a) +
# 127) / 255 on each channel, computed apart from Jet.
step: built
stdout: = DrawCanvas.out
file: Frame.pam sha256 = "63446d5308256561da2b378369c5b29636d573dd5f14c5f8dfc10fa7b04b5817"
