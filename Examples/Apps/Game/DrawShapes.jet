package: {
    name: "draw_shapes"
    authority: {
    allow: [Env, FS, IO, Net, Time]
    }
}
use {
    files: core.files
    ui: core.ui
}

// One frame of 2D shapes drawn by Jet's software rasterizer on a headless
// window: float rectangles, outlines, gradients, rounded rectangles, circle
// and ellipse outlines, rings and sectors, and regular polygons, some
// translucent and some clipped by the window. The program saves the screen as
// a PAM image; the golden pins its SHA-256 on every tier.
run: fn() {
    window: ui.headless(width: 96, height: 72, script: [[ui.UIEvent]]{[ui.UIEvent]{}}) ?? panic("a 96x72 window")
    loop frame in window.frames() {
        if frame.index > 0 -> break
        shapes(frame)
    }
    save_pam(window.load_image_from_screen(), "Frame.pam")
    print("shapes=96x72 frame=presented")
    collisions()
    centered_titles()
}

shapes: fn(frame: ui.Frame) {
    frame.clear_background(ui.color(12, 14, 24, 255))
    frame.draw_rectangle_gradient_v(0, 0, 96, 24, ui.color(30, 60, 140, 255), ui.color(10, 20, 40, 255))
    frame.draw_rectangle_gradient_h(-6, 60, 50, 16, ui.color(255, 80, 40, 255), ui.color(40, 200, 120, 96))
    frame.draw_rectangle_gradient_ex(ui.rect(52.25, 40.5, 30.0, 20.0), ui.color(255, 0, 0, 255), ui.color(0, 255, 0, 255), ui.color(0, 0, 255, 255), ui.color(255, 255, 0, 255))
    frame.draw_rectangle_rec(ui.rect(3.4, 3.6, 10.5, 6.25), ui.color(240, 240, 240, 255))
    frame.draw_rectangle_lines(16, 2, 12, 9, ui.color(255, 200, 0, 255))
    frame.draw_rectangle_lines_ex(ui.rect(30.0, 2.0, 14.0, 10.0), 3.0, ui.color(120, 220, 255, 160))
    frame.draw_rectangle_rounded(ui.rect(48.0, 3.0, 22.0, 12.0), 0.6, 0, ui.color(200, 90, 220, 255))
    frame.draw_rectangle_rounded(ui.rect(89.9, 40.0, 0.75, 6.0), 0.5, 4, ui.color(255, 255, 255, 255))
    frame.draw_rectangle_rounded_lines(ui.rect(73.5, 3.5, 18.0, 14.0), 0.5, 6, ui.color(255, 255, 255, 200))
    frame.draw_rectangle_rounded_lines(ui.rect(4.0, 14.0, 8.0, 5.0), 0.0, 0, ui.color(90, 255, 120, 255))
    frame.draw_circle_lines(24, 34, 9, ui.color(255, 120, 120, 255))
    frame.draw_ellipse(48, 30, 11.5, 6.25, ui.color(60, 180, 255, 140))
    frame.draw_ellipse_lines(48, 30, 13.0, 8.0, ui.color(255, 255, 255, 255))
    frame.draw_ring(ui.point(76.5, 30.0), 10.0, 5.0, -30.0, 210.0, 0, ui.color(255, 170, 40, 220))
    frame.draw_ring_lines(ui.point(76.5, 30.0), 11.0, 13.5, 0.0, 360.0, 24, ui.color(180, 180, 255, 255))
    frame.draw_ring(ui.point(10.0, 50.0), 0.0, 9.0, 200.0, 20.0, 5, ui.color(250, 60, 120, 200))
    frame.draw_poly(ui.point(30.0, 54.0), 6, 8.0, 15.0, ui.color(120, 255, 200, 255))
    frame.draw_poly_lines(ui.point(30.0, 54.0), 5, 10.5, 0.0, ui.color(255, 255, 0, 255))
    frame.draw_poly(ui.point(92.0, 66.0), 2, 9.0, 90.0, ui.color(255, 255, 255, 100))
    frame.draw_pixel(95, 71, ui.color(255, 0, 255, 255))
    frame.draw_pixel(-1, 5, ui.color(255, 0, 255, 255))
}

// The collision checks are plain functions over core.ui's Point and Rect: no
// window and no effect. A paddle sweeps right one step at a time; each line
// reports what it touches at that step.
collisions: fn() {
    wall: ui.rect(40.0, 0.0, 8.0, 30.0)
    ball: ui.point(30.0, 20.0)
    slope_from: ui.point(0.0, 30.0)
    slope_to: ui.point(60.0, 0.0)
    loop step in 0..<4 {
        paddle: ui.rect(Float{step * 12}, 16.0, 10.0, 4.0)
        hits_wall: ui.check_collision_recs(paddle, wall)
        hits_ball: ui.check_collision_circle_rec(ball, 3.0, paddle)
        overlap: ui.get_collision_rec(paddle, wall)
        print("step={step} wall={hits_wall} ball={hits_ball} overlap_width={Int.from_float(overlap.width) ?? -1}")
    }
    corner: ui.point(48.0, 30.0)
    print("corner_inside={ui.check_collision_point_rec(corner, wall)}")
    print("near_corner={ui.check_collision_point_circle(ui.point(51.0, 34.0), corner, 5.0)}")
    print("ball_on_slope={ui.check_collision_circle_line(ball, 3.0, slope_from, slope_to)}")
    print("point_on_slope={ui.check_collision_point_line(ui.point(20.0, 20.0), slope_from, slope_to, 1)}")
    triangle: ui.check_collision_point_triangle(ball, ui.point(20.0, 10.0), ui.point(40.0, 30.0), ui.point(20.0, 30.0))
    print("ball_in_triangle={triangle}")
    star: [ui.Point]{ui.point(10.0, 0.0), ui.point(13.0, 7.0), ui.point(20.0, 7.0), ui.point(14.0, 12.0), ui.point(16.0, 20.0), ui.point(10.0, 15.0), ui.point(4.0, 20.0), ui.point(6.0, 12.0), ui.point(0.0, 7.0), ui.point(7.0, 7.0)}
    print("star_center={ui.check_collision_point_poly(ui.point(10.0, 10.0), star)} star_notch={ui.check_collision_point_poly(ui.point(10.0, 18.0), star)}")
    crossing: ui.check_collision_lines(slope_from, slope_to, ui.point(0.0, 0.0), ui.point(60.0, 30.0)) ?? ui.point(-1.0, -1.0)
    print("slopes_cross_at={Int.from_float(crossing.x) ?? -1},{Int.from_float(crossing.y) ?? -1}")
    print("circles={ui.check_collision_circles(ball, 3.0, ui.point(36.0, 28.0), 7.0)}")
}

// measure_text reports the width draw_text covers, with no window and no
// effect, so a title can be centered on a 320-pixel screen before drawing.
// The width is the line's kerned advance in Atkinson Hyperlegible Next
// (1000 units to the em) at `size` pixels to the em, rounded: "Hi" advances
// 694 + 252 = 946 units, 9.46 pixels at size 10.
centered: fn(name: String, text: String, size: Int) {
    width: ui.measure_text(text, size)
    print("{name} size={size} width={width} x={(320 - width) /% 2}")
}

centered_titles: fn() {
    centered("Hi", "Hi", 10)
    centered("Hi", "Hi", 4)
    centered("Hi", "Hi", 15)
    centered("Hi", "Hi", 25)
    centered("PAUSED", "PAUSED", 20)
    centered("Score: 1200", "Score: 1200", 10)
    centered("Game\\nOver!", "Game\nOver!", 30)
    centered("naïve", "naïve", 10)
    centered("(empty)", "", 20)
}

// An image as a PAM file (P7, RGB_ALPHA).
save_pam: fn(image: ui.Image, path: String) {
    bytes := "P7\nWIDTH {image.width()}\nHEIGHT {image.height()}\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n".bytes()
    bytes.extend(image.pixels())
    files.write_bytes(path, bytes) ?? panic("write {path}: {err}")
}
