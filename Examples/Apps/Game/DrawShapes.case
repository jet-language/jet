# The program saves its headless window's screen as Frame.pam; every tier
# must rasterize the same bytes. The SHA-256 is that of each shape's pixels,
# taken from opaque-only draws, composited apart from Jet under core.ui's
# one blend rule: premultiply on entry, (c * a + 127) / 255, then each byte
# becomes s + (d * (255 - a) + 127) / 255.
step: built
stdout: = DrawShapes.out
file: Frame.pam sha256 = "f01efb66ca0c90cd76520a2edde35bb6cd1a80e88c85a8e0eed8fb7b264567ba"
