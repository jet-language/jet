# The program saves its headless window's screen as Frame.pam; every tier
# must decode the PNG textures and rasterize the same bytes. The SHA-256 is
# that of the shapes' pixels, taken from opaque-only draws, and the sprites'
# texels, decoded from the PNGs apart from Jet, composited under core.ui's
# one blend rule: premultiply on entry, (c * a + 127) / 255, then each byte
# becomes s + (d * (255 - a) + 127) / 255.
step: built
stdout: = DrawSprites.out
file: Frame.pam sha256 = "1d68b40ed31a5712df27d6f68b7dc4b5dd7a90327cc94fed93c788e4a1c3da03"
