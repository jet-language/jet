package: {
    name: "raylib_canvas"
    authority: {
    allow: [IO, GPU]
    }
}
use rl: core.game.raylib

// One frame drawn by Jet's software rasterizer: a clear, an opaque rectangle
// clipped at the top-left corner, two translucent rectangles blended src-over
// and two lines of bitmap-font text. With JET_RAYLIB_CAPTURE set, end_drawing
// writes the canvas as a PAM image; the golden pins its SHA-256 on every tier.
run: fn() {
    window: rl.window_open(64, 48, "Jet canvas")
    rl.begin_drawing(window)
    rl.clear_background(rl.color(10, 20, 30, 255))
    rl.draw_rectangle(-4, -4, 24, 20, rl.color(200, 40, 40, 255))
    rl.draw_rectangle(12, 8, 30, 24, rl.color(40, 200, 90, 128))
    rl.draw_rectangle(30, 20, 40, 40, rl.color(255, 255, 255, 64))
    rl.draw_text("Hi!\nJet", 4, 28, 10, rl.color(255, 220, 120, 255))
    rl.end_drawing()
    rl.close_window(window)
    print("canvas=64x48 frame=presented")
}
