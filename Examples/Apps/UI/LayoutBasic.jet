// Constraint layout — a Cassowary-style solver.
// `name: Layout{ … }`
// is a typed literal whose body is comma-separated `Constraint`
// elements (GATE 1 blesses `>=`/`<=`/`==` to return a `Constraint` instead
// of `Bool`, closed to this type family only, like SIMD lane comparisons).
// `box.anchor` reads (`left`/`right`/`width`/`top`/`bottom`/`height`)
// auto-vivify a box scoped to the layout; `self.anchor` is the container
// box named after the binding. `left`/`right`/`width` are horizontal
// (`HVar`), `top`/`bottom`/`height` are vertical (`VVar`) — mixing axes is
// a compile error (E2932).
//
// A two-column form: the label column has a minimum width, the input column
// fills the rest of the row, and a fixed gap separates them. All three
// constraints are REQUIRED (the default); the layout is solved once, then
// read back with `.value()`.
run: fn() {
    form: Layout{
    label.width >= Float{80.0},
    label.right + Float{16.0} == input.left,
    label.width + Float{16.0} + input.width == self.width,
    }
    // `self.width` inside the literal vivifies the container box
    // (`form.h("form", "width")`) — set it via a soft suggestion (an edit
    // variable): required constraints always win over a suggestion, but with
    // nothing else pinning label.width, the solver settles at its tightest
    // required bound (80.0) and gives the rest of the row to input.width.
    form.suggest(form.h("form", "width"), Float{300.0})
    label_w: form.value(form.h("label", "width"))
    input_w: form.value(form.h("input", "width"))
    print("label width: {label_w}", "input width: {input_w}", "feasible: {(form.is_feasible())}")
}
