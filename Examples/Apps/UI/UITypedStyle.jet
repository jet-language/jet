package: {
    name: "ui_ui_typed_style"
    version: "0.1.0"
    authority: { allow: [Browser, Exec, IO, Mem.Alloc] }
}

// One flat typed Style feeds the canonical UiNode paint pipeline directly.
// Lengths use Jet's existing unit-family mechanism; there is no parallel View.
use {
    ui: core.ui
    core.color.[Color]
}

#UnitFamily(Length) { px }

Style: struct {
    color: Color
    width: Px
    height: Px
}

styled_text: fn(text: String, style: Style) -> UINode {
    ui.node_color(text, style.width.raw(), style.height.raw(), style.color)
}

run: fn() {
    red: Style{color: Color{r: 220, g: 20, b: 60, a: 255}, width: 10px, height: 4px}
    blue: Style{color: Color{r: 30, g: 60, b: 200, a: 255}, width: 20px, height: 4px}
    tree: ui.box([styled_text("a", red), styled_text("b", blue)])
    backend := ui.null_backend()
    size: backend.measure(tree, ui.constraint(0.0, 0.0, 80.0, 24.0))
    backend.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
    backend.paint(tree)
    print("a color={red.color.to_hex()} w={red.width.raw()} h={red.height.raw()}")
    print("b color={blue.color.to_hex()} w={blue.width.raw()} h={blue.height.raw()}")
    print("total width {red.width.raw() + blue.width.raw()}")
}
