package: {
    name: "ui_window"
    version: "0.1.0"
    authority: { allow: [Env, IO, Net, Time] }
}

// A native window drawn by Jet alone: a square bounces at 240 and 160 pixels
// per second, a click or key press changes its colour, Escape closes it.
// `core.ui` speaks the display server's protocol itself, so this needs no C
// library and no `#Unsafe`:
//
//     jet run Examples/Apps/UI/Window.jet
//
// opens the window on a Wayland desktop and, after 15 seconds or on close,
// prints how evenly the frames reached the screen. With no display server
// (the golden test clears $WAYLAND_DISPLAY) the same loop runs headless over
// a scripted click and prints each frame's checksum.
use ui: core.ui

SIDE: 48

run: fn() {
    window := ui.headless(width: 96, height: 64, script: [[ui.UIEvent]{}, [ui.UIEvent]{.PointerDown(.Left)}, [ui.UIEvent]{}]) ?? return
    native := false
    if ui.open(width: 640, height: 400, title: "Jet") == {
        .Ok(opened) -> {
            window = opened
            native = true
        }
        .Err(error) -> {
            if error != .NoDisplay {
                print("ui.open failed: {error}")
                return
            }
            print("no display: running headless")
        }
    }
    width := window.width()
    height := window.height()
    pixels := background(width, height)
    full := true
    lit := true
    drawn_x := 0
    drawn_y := 0
    frames := 0
    seconds: Float{15.0}
    loop frame in window.frames() {
        quit := false
        loop event in frame.events() {
            if event == {
                .KeyDown(.Escape) -> { quit = true }
                .Close -> { quit = true }
                .PointerDown(_) -> { lit = !lit }
                .KeyDown(_) -> lit = !lit
                .KeyUp(_) | .Text(_) | .PointerMove(_, _) | .PointerUp(_) | .Scroll(_, _) | .Resize(_, _) | .Focus(_) | .Compose(_) -> {}
            }
        }
        if quit -> break
        if frame.width != width || frame.height != height {
            width = frame.width
            height = frame.height
            pixels = background(width, height)
            full = true
        }
        // The square's place is a function of when the frame is seen.
        x: bounce(frame.time, Float{240.0}, width - SIDE)
        y: bounce(frame.time, Float{160.0}, height - SIDE)
        old: ui.UIRect{x: drawn_x, y: drawn_y, width: SIDE, height: SIDE}
        square(pixels, width, height, drawn_x, drawn_y, .Erase)
        drawn_x = x
        drawn_y = y
        square(pixels, width, height, x, y, if lit -> .Lit else -> .Dim)
        damage: if full -> [ui.UIRect]{ui.UIRect{x: 0, y: 0, width: width, height: height}} else -> [ui.UIRect]{old, ui.UIRect{x: x, y: y, width: SIDE, height: SIDE}}
        full = false
        frame.present_damage(pixels, damage) ?? {
            print("present failed: {err}")
            break
        }
        frames += 1
        if frame.time >= seconds -> break
    }
    if !native {
        print("{frames} frames: {window.checksums()}")
        return
    }
    stats: window.frame_stats()
    print("{frames} frames at {width}x{height}: presented {stats.presented}, missed {stats.missed}, refresh {stats.refresh_ns /% 1000} us")
    print("present to present: p50 {stats.median_ns /% 1000} us, p99 {stats.p99_ns /% 1000} us; refreshes spanned 1: {stats.spans[0]}, 2: {stats.spans[1]}, 3: {stats.spans[2]}, 4+: {stats.spans[3]}")
    print("input to photon over {stats.input_samples} frames: p50 {stats.input_median_ns /% 1000} us, p99 {stats.input_p99_ns /% 1000} us")
    if window.failure() == .Val(failure) -> print("display failure: {failure}")
}

// A position bouncing between 0 and `span` at `speed` pixels per second.
bounce: fn(t: Float, speed: Float, span: Int) -> Int {
    if span <= 0 -> return 0
    travelled: saturating(Int{t * speed})
    period: 2 * span
    at: travelled %% period
    if at > span -> period - at else -> at
}

Paint: enum {
    Erase
    Lit
    Dim
}

shade: fn(x: Int, y: Int, width: Int, height: Int) -> (r: Int, g: Int, b: Int) {
    (r: 20 + x * 60 /% width, g: 30 + y * 90 /% height, b: 110 + y * 100 /% height)
}

background: fn(width: Int, height: Int) -> [U8] {
    pixels := [U8]{}
    loop y in 0..<height {
        loop x in 0..<width {
            c: shade(x, y, width, height)
            pixels.push(U8{c.r})
            pixels.push(U8{c.g})
            pixels.push(U8{c.b})
            pixels.push(U8{255})
        }
    }
    pixels
}

// Paints or erases the square at `left`, `top`.
square: fn(pixels: &[U8], width: Int, height: Int, left: Int, top: Int, paint: Paint) {
    loop y in top..<top + SIDE {
        if y >= 0 && y < height {
            loop x in left..<left + SIDE {
                if x >= 0 && x < width {
                    at: (y * width + x) * 4
                    c: shade(x, y, width, height)
                    if paint == {
                        .Lit -> {
                            pixels[at] = U8{255}
                            pixels[at + 1] = U8{200}
                            pixels[at + 2] = U8{60}
                        }
                        .Dim -> {
                            pixels[at] = U8{90}
                            pixels[at + 1] = U8{230}
                            pixels[at + 2] = U8{255}
                        }
                        .Erase -> {
                            pixels[at] = U8{c.r}
                            pixels[at + 1] = U8{c.g}
                            pixels[at + 2] = U8{c.b}
                        }
                    }
                }
            }
        }
    }
}
