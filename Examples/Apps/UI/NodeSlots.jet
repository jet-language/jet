package: {
    name: "ui_node_slots"
    version: "0.1.0"
    authority: {
        allow: [IO, Mem.Alloc, Browser]
        needs: [UI.IME, UI.Shortcuts, UI.Accessibility]
    }
}

// A UINode's host slots: `.accessibility`, `.shortcut` and `.ime` read back
// the metadata `ui.node_accessibility`, `ui.node_shortcut` and
// `ui.text_input` attached, with one meaning on every tier. A plain node has
// none of them; a text input's width counts Unicode scalars.
use {
    ui: core.ui
    core.ui.host
}

run: fn() {
    plain: ui.button("Plain")
    if plain.accessibility == None && plain.shortcut == None && plain.ime == None {
        print("plain: no slots")
    }
    meta: UIAccessibility{name: Val("Save"), description: None, states: [UIAccessibilityState]{.Disabled, .Expanded(true), .Value("draft")}}
    labelled: ui.node_accessibility(ui.button("Save"), meta)
    if labelled.accessibility == .Val(read) {
        print("name {read.name ?? "?"} states {read.states.len()}")
        loop state in read.states {
            if state == .Expanded(flag) -> print("expanded {flag}")
            if state == .Value(text) -> print("value {text}")
            if state == .Disabled -> print("disabled")
        }
        print("same {read == meta}")
    }
    keyed: ui.node_shortcut(ui.button("Go"), UIShortcut.cmd(" S "))
    if keyed.shortcut == .Val(cut) -> print("shortcut {cut.key} {cut.modifiers.bits}")
    input: ui.text_input("héllo", .Disabled)
    print("input {input.width} {input.height} {input.label}")
    if input.ime == .Val(mode) -> print("ime disabled {mode == .Disabled}")
    native: ui.text_input("", .Native)
    if native.ime == .Val(mode) -> print("ime native {mode == .Native}")
}
