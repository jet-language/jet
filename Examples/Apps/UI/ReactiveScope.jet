// `#Reactive { … }` is an explicit reactive effect
// scope; `reactive.computed` is the canonical name for a derived value.
use reactive: core.reactive

run: fn() {
    n := reactive.signal(1)
    doubled: reactive.computed(() -> n.get() * 2)
    print(doubled.get())
    #Reactive { print("Reactive Scope: {doubled.get()}") }
    n.set(5)
    print(doubled.get())
}
