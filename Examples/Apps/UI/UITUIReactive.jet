package: {
    name: "ui_ui_tui_reactive"
    version: "0.1.0"
    authority: { allow: [Browser, Env, Exec, IO, Mem.Alloc] }
}

// TUI backend + reactive render loop.
// one-call mount over measure/layout/paint.
use {
    ui: core.ui
    reactive: core.reactive
}

run: fn() {
    backend: ui.tui_backend()
    label: reactive.signal("hi")
    ui.reactive_render(
    () -> {
        node: ui.node(label.get(), 2.0, 1.0)
        ui.mount(backend, node)
    },
    )
    print(backend.render_count())
    loop line in backend.frame_lines() -> print(line)
    label.set("yo")
    print(backend.render_count())
    loop line in backend.frame_lines() -> print(line)
}
