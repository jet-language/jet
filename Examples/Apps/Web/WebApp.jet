// One statically known full-stack application graph.
// `run: fn` returns the canonical builder; CSR/SSR/SSG/streaming/islands share one IR.
package: {
    name: "web_app"
    authority: { allow: [Browser, Env, Net, FS.Read, Time] }
}
use web: core.web
#Target(Web)

home: fn() -> WebPage { web.page("Home", "hello from csr") }

save: fn() -> String { "saved" }

api_mount: fn(prefix: String) { print(prefix) }

run: fn() {
    web.app()
        .csr()
        .route("/", home)
        .action("save", save)
        .mount("/api", api_mount, "Net", "csrf")
        .island()
        .route("/widget", home)
        .security("csp-default")
        .assets("Examples/Apps/Web/public")
        .split("widget")
        .cache("revalidate")
        .a11y("wcag-aa")
        .adapter("node")
        .hydration_dev()
        .serve()
}
