// Local and session storage outside a browser: each keeps one process-wide
// store, so set, get, has, remove and clear behave as the browser API does.
use {
    core.browser.storage.local
    core.browser.storage.session
}

show: fn(label: String, value: String?) {
    if value == {
        .Val(text) -> { print("{label}: \"{text}\"") }
        .None -> print("{label}: none")
    }
}

run: fn() {
    show("local get before set", local.get("draft"))
    print("local has before set: {local.has("draft")}")
    local.set("draft", "first")
    local.set("draft", "second")
    show("local get after two sets", local.get("draft"))
    print("local has after set: {local.has("draft")}")

    session.set("draft", "tab only")
    show("session get", session.get("draft"))
    show("local get beside session", local.get("draft"))

    local.remove("draft")
    show("local get after remove", local.get("draft"))
    print("local has after remove: {local.has("draft")}")
    print("local get_or after remove: {local.get_or("draft", "fallback")}")
    show("session get after local remove", session.get("draft"))

    local.set("", "")
    show("local empty key", local.get(""))

    session.set("theme", "dark")
    session.clear()
    print("session has after clear: {session.has("draft")} {session.has("theme")}")
    show("local empty key after session clear", local.get(""))
    local.clear()
    print("local has after clear: {local.has("")}")
}
