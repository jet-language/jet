// Minimal full-stack application builder smoke example.
package: {
    name: "app_hello"
    authority: { allow: [Browser, Env, Net, FS.Read, Time] }
}

#Target(Web)

use web: core.web

home: fn() -> WebPage { web.page("Hello", "world") }

save: fn() { print("saved") }

run: fn() {
    web.app()
        .route("/", home)
        .action("save", save)
        .security("csp")
        .assets("Public")
        .a11y("wcag")
        .adapter("node")
        .csr()
        .serve()
}
