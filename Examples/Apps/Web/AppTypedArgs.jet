// The checked CLI schema reaches the entry; the app serves on the parsed port.
// Try `jet run Examples/Apps/Web/AppTypedArgs.jet -- --help` or
// `jet run Examples/Apps/Web/AppTypedArgs.jet -- --port=9000`.
package: {
    name: "app_typed_args"
    authority: { allow: [Env, Net, FS.Read, Time] }
}
use web: core.web

#CLI
ServeArgs: struct {
    #Doc("port to listen on") port: Int{8080}
}

run: fn(args: ServeArgs) {
    print(args.port)
    web.app().serve(args.port)
}
