mounted: DIV "count: 0" top=0px height=32px background=#3366ff | BUTTON "increment" top=32px height=1px | BUTTON "reset" top=33px height=1px
after 3 increments: DIV "count: 3" top=0px height=32px background=#3366ff | BUTTON "increment" top=32px height=1px | BUTTON "reset" top=33px height=1px
after reset: DIV "count: 0" top=0px height=32px background=#3366ff | BUTTON "increment" top=32px height=1px | BUTTON "reset" top=33px height=1px
