use c.source as source

pub fn run() {
    prefix :: "byte"
    sub :: source.on_data(event -> {
        print("{prefix}: {event.value}")
        event.stop()
    })
    emitted :: source.emit_async(7)
    _emission :: (emitted.join() ?? panic("task failed")) ?? panic("emission failed")
    stopped :: source.unsubscribe(^sub)
    _stopped :: (stopped.join() ?? panic("task failed")) ?? panic("unsubscribe failed")
    print("stopped")
}
