// `a.compare_version(b)` is the order of GNU `sort -V`: digit runs compare
// as numbers, `~` sorts before everything (a pre-release comes before its
// release), a file suffix such as `.tar.gz` counts only to break a tie, and
// names that start with a dot come first. Versions that tie (`a01`, `a1`)
// fall back to byte order.
run: fn() {
    rows := [String]{"6067c10", "file.tar.gz", "a1", "1.10", "B", "1.0", "6067c9", "a01", "1.9", ".hidden", "file.tar", "1.0~rc1", "a", "1.2"}
    rows.sort_by(fn(a, b) { a.compare_version(b) })
    loop row in rows -> print(row)
    print("v2 before v010: {"v2".compare_version("v010") == Ordering.Less}")
}
