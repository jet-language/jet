// A checked text type whose `Error` is `Never` accepts every body: its
// `check` cannot fail. It still runs once, before the program, to hand
// `build` the literal's parts as its shape, and `build` alone gives the
// literal its value.

Words: struct {
    text: String,

    impl CheckedText {
        Error: Never,
        Hole: String,

        check: fn(parts: [String]) -[]> Checked<[String], TextSlot> Never! {
            Ok(Checked{shape: parts.copy(), slots: loop _ in 1..<parts.len() -> TextSlot.Text})
        }

        encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { "<{value}>" }

        build: fn(shape: [String], holes: [String]) -[]> Words {
            Words{text: "{shape.join("|")} [{holes.join(",")}]"}
        }
    }
}

run: fn() {
    ^count: 3
    print(Words{"a {count} b {count + 1}"}.text)
    print(Words{"plain"}.text)
}
