// A run-time hole whose complete text fails the type check stops the program
// at the literal, so no unchecked Token value can exist.
#Error
TokenError: enum {
    Empty,
    TooLong,
}

Token: distinct String

impl Token.CheckedText {
    Error: TokenError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TokenError! {
        text: parts.join("")
        if text == "" -> return Err(TokenError.Empty)
        if text.len() > 10 -> return Err(TokenError.TooLong)
        Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "[{value}]" }
}

show: fn(value: Token) {
    #Unsafe("checked text example output") { print(value.raw()) }
}

run: fn() {
    name: "Ada Lovelace"
    print("before")
    token: Token{"hi {name}"}
    show(token)
    print("unreachable")
}
