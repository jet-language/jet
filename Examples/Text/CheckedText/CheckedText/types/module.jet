#Error
TextError: enum {
    Empty,
    QueryShape,
    SelectorShape,
    IdentityShape,
}

explain: fn(error: TextError) -> String {
    if error == .Empty -> return "rejected: empty"
    if error == .QueryShape -> return "rejected: query shape"
    if error == .SelectorShape -> return "rejected: selector shape"
    if error == .IdentityShape -> return "rejected: identity shape"
    return "rejected: unknown"
}

Pattern: distinct String

impl Pattern.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! {
        if parts.join("") == "" -> return Err(TextError.Empty)
        Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "[{value}]" }
}

Query: distinct String

impl Query.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! {
        text: parts.join("")
        if text == "" -> return Err(TextError.Empty)
        if !text.contains("select") -> return Err(TextError.QueryShape)
        Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "?" }
}

Selector: distinct String

impl Selector.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! {
        text: parts.join("")
        if text == "" -> return Err(TextError.Empty)
        if !text.contains(".") -> return Err(TextError.SelectorShape)
        Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "[{value}]" }
}

Identity: distinct String

impl Identity.CheckedText {
    Error: TextError,

    check: fn(parts: [String]) -[]> Checked<[String], TextSlot> TextError! {
        text: parts.join("")
        if text == "" -> return Err(TextError.Empty)
        if !text.contains("@") -> return Err(TextError.IdentityShape)
        Ok(Checked{shape: parts.copy(), slots: [TextSlot]{}})
    }

    encode_hole: fn<T: Printable>(value: T, _slot: TextSlot) -[]> String { return "{value}" }
}
