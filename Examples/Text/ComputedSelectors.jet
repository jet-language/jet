// A format selector's number may be any Int expression computed at run
// time, not only a literal. A negative number acts as zero, and the number
// runs after the value.

note: fn(log: &[String], label: String, n: Int) -> Int {
    log.push(label)
    n
}

run: fn() {
    names: ["a", "jet", "compiler"]
    width := 0
    loop name in names {
        if name.len() > width -> width = name.len()
    }
    loop name in names -> print("[{name:Pad(width)}] [{name:PadLeft(width + 2, ".")}]")
    loop digits in 0..<4 -> print("{3.14159:Fixed(digits)} {1234.567:Grouped(digits)}")
    half: width / 2
    print("{255:Hex(half)} {0.125:Percent(half - 3)} {12345.678:Sci(half - 2)} {7:Fixed(half - 3)}")
    shift: -2
    print("[{"x":Pad(shift)}] [{2.75:Fixed(shift)}] [{255:Hex(shift)}]")
    log := [String]{}
    text: "[{note(log, "value", 42):PadLeft(note(log, "width", 5))}]"
    print("{text} {log.join(", ")}")
    print("{3.14159:Fixed(2)}")
}
