// `words()` gives the fields between runs of whitespace, as perl's `split ' '`
// and awk's `$1 $2 …` do: spaces, tabs and other Unicode White_Space separate
// them, a run counts as one separator, and no field is empty, so leading and
// trailing whitespace adds none and blank text has no fields. `split(sep)`
// splits on any other separator and keeps the empty pieces.
show: fn(text: String) {
    fields: text.words()
    print("{fields.len()}: [{fields.join("|")}]")
}

run: fn() {
    show("alpha beta gamma")
    show("  two   spaces\tand a tab  ")
    show("line one\nline two")
    show("no-space")
    show("")
    show(" \t ")
    show("héllo　wörld")
    line: "GET /index.html 200 512"
    print(line.words()[1])
    print(line.split(" ").to_list().len())
}
