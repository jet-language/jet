// Byte text uses the existing `[U8]{"…"}` typed literal.
byte_len: fn(bytes: [U8]) -> Int { bytes.len() }

run: fn() {
    magic: [U8]{"JGB1\x00\xFF"}
    fixed: [U8#4]{"JGB1"}
    print(byte_len([U8]{"\xFF\xFF"}))
    print(magic[0])
    print(magic[4])
    print(magic[5])
    print(fixed[3])
    byte_constants_lesson()
}

// A `[U8]{"…"}` byte value checks as one byte constant (the
// generated Unicode assets spell megabytes this way) and behaves as any [U8]:
// a top-level table, a slice, equality with an element list, decoding, a
// local loop, and the empty body.
HEADER: [U8]{"JUCD\x01\x00\x11\x00"}

byte_constants_lesson: fn() {
    print(HEADER.len())
    print(HEADER[0])
    print(HEADER[6])
    window: HEADER[4..<8]
    print(window.len())
    print(HEADER == [U8]{74, 85, 67, 68, 1, 0, 17, 0})
    local: [U8]{"ab"}
    total := 0
    loop byte in local -> total = total + (Int{byte})
    print(total)
    greeting: String.from_bytes([U8]{"hi\x0Athere"}) ?? ""
    print(greeting.len())
    empty: [U8]{""}
    print(empty.len())
}
