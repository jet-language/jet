package: {
    name: "text_stream_lines"
    version: "0.1.0"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] }
}
// file-scale text opens with a streaming reader.
// For tiny in-memory snippets, see StringParse.jet (String.lines()).
use {
    fs: core.files
    files: core.files
}

run: fn() {
    src: Path.from("/tmp").join("jet_stream_lines.txt").to_string()
    _: fs.write(src, "alpha\nbeta\ngamma\n")
    handle: files.open(src.copy())
    n := 0
    loop line in handle.lines() {
        print(line)
        n += 1
    }
    print("lines {n}")
}
