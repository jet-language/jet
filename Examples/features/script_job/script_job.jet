// Short path first (D-EXAMPLES-SHORTPATH1=A): this is a direct script entry.
//
// First run:
//   jet run Examples/features/script_job/script_job.jet
// After one edit, run the same command again. There is no project scaffold or
// hand-written dispatcher to maintain; the small `fn run()` below is the
// checked entry that the host invokes.
//
// The edit is intentionally small: change the text assigned to `edited` and
// rerun. A real error is handled below rather than hidden behind a shell status.
// `InputError` is a checked failure type, and `??` makes recovery local.
//
// Resource ownership is also ordinary Jet ownership. `Lease` represents a
// cleanup duty; the value's owner must move it to `release` exactly once. The
// script does not start a second scheduler or event loop: `jet run` owns the
// process and entry loop, while this body owns only its values and duties.
//
// "Interpreted" means the checked program is evaluated by the development
// engine; "compiled" means that same checked program is lowered to an artifact
// by `jet build`. They are execution lenses, not two languages or two meanings.
// An isolated invocation gets its own run/session boundary. Isolation is not a
// security sandbox: it does not by itself deny filesystem/network access,
// cancel a blocking child, or make wall-clock work reproducible. Add explicit
// package authority and runtime controls when those promises are required.
#Error
struct InputError {
    message: String
}

#SingleUse struct Lease {
    name: String
}

fn acquire(name: String) -> Lease { Lease{name: ~name} }

fn release(lease: ^Lease) { print("cleanup: released {lease.name}") }

fn checked_input(value: String) -> String InputError! {
    if value == "bad" -> return Err(InputError{message: "input is not valid"})
    Ok(value)
}

fn run() {
    print("first run: hello from a script job")
    edited :: "hello after one edit"
    print("one edit: {edited}")

    lease :: acquire("workspace")
    print("job owns: {lease.name}")

    message :: checked_input("bad") ?? {
        print("real error: {err.message}")
        "recovered"
    }
    print("result: {message}")

    release(^lease)
    print("main loop: jet run owns it")
}
