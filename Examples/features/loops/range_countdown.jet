// D-RANGE-BACKWARD1=A: a minus step counts down from the start and includes
// the end when it lands on it. Computed ends that are backward stay empty,
// so `0..n - 1` runs zero times for an empty list.
fn count_items(n: Int) -> Int {
    turns := 0
    loop i in 0..n - 1 -> turns += 1
    turns
}

fn run() {
    loop i in 10..1, -1 { print(i) }
    loop j in 10..0, -3 { print(j) }
    print(count_items(0))
    print(count_items(3))
    start :: 4
    stop :: 1
    empty := 0
    loop k in start..stop -> empty += 1
    print(empty)
}
