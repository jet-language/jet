// D-RAWSTR1=A: backtick fences are ordinary Strings: escapes and holes stay
// literal, line endings stay in the value, and a longer fence carries backticks.
fn run() {
    raw :: `literal \ slash, {not interpolation}, "quote"
next line`
    fenced :: ``embedded ` backtick``
    print(raw)
    print(fenced)
}
