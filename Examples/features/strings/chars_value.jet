// `text.chars()` used as a value is a `[Char]` of the string's characters,
// one per Unicode scalar value, not per byte.
Literal: enum {
    Text(String)
    Number(Int)
}

char_count: fn(text: String) -> Int {
    text.chars().len()
}

literal_width: fn(literal: Literal) -> Int? {
    if literal == {
        .Text(value) -> Val(value.chars().len())
        else -> Int?{None}
    }
}

run: fn() {
    word := "héllo"
    letters := word.chars()
    print("count={char_count(word)} bytes={word.count_bytes()}")
    print("first={letters[0]} second={letters[1]} last={letters[letters.len() - 1]}")
    print("text-width={literal_width(Literal.Text("añb")) ?? -1}")
    print("number-width={literal_width(Literal.Number(7)) ?? -1}")
    print("empty={char_count("")}")
}
