// Run `jet inspect bind dart callbacks.dart --jet run.jet --pkg callbacks`,
// then `dart run host.dart` from the generated project.
use dart.callbacks as callbacks

fn compute(value: Int) -[FFI.Dart]> Int { return callbacks.dart_double(value) ?? -1 }

fn compute_float(value: Float) -[FFI.Dart]> Float { return callbacks.dart_half(value) ?? -1.0 }
