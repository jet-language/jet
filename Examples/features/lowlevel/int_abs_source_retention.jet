// Bare Int.abs must autoload and retain the existing source math.abs policy.
// Golden is UNOBSERVED until the composed integration cycle.
magnitude: fn(value: Int) -> Int { value.abs() }
run: fn() {
    print(magnitude(-7))
    print(magnitude(0))
    print(magnitude(9007199254740993))
    print(magnitude(-9223372036854775809))
}
