// Planted retention case: multiply needs __fraction_mul and its transitive
// constructor/gcd calls, not another precise family's operations. Rust's
// temporary AST bridge keeps the Fraction helper family; Jet keeps the op key.
// Runtime expectations are UNOBSERVED until the composed integration cycle.
use core.math as math

fn multiply(left: Fraction, right: Fraction) -> Fraction Never! { left * right }
fn run() {
    left :: math.fraction(1, 3) ?? panic("fraction")
    right :: math.fraction(3, 2) ?? panic("fraction")
    product :: multiply(left, right)
    assert_eq(product.numerator(), 1)
    assert_eq(product.denominator(), 2)
}
