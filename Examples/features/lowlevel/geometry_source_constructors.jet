// Associated MIR dispatch for all fourteen source coordinate/transform constructors.
// Golden is UNOBSERVED until the composed integration cycle.
use core.math as math
fn run() {
    print(ScreenPoint.new(1.0, 2.0).x)
    print(math.ScreenDelta.new(2.0, 3.0).x)
    print(math.WorldPoint.new(3.0, 4.0).x)
    print(WorldDelta.new(4.0, 5.0).x)
    print(ViewPoint.new(5.0, 6.0).x)
    print(ViewDelta.new(6.0, 7.0).x)
    print(CameraPoint.new(7.0, 8.0).x)
    print(CameraDelta.new(8.0, 9.0).x)
    print(DevicePoint.new(9.0, 10.0).x)
    print(DeviceDelta.new(10.0, 11.0).x)
    point :: Point2<F32, Screen>.new(11.0, 12.0, 41)
    delta :: Delta2<Float, World>.new(12.0, 13.0, 42)
    print(point.x)
    print(delta.x)
    print(point.frame_id)
    print(delta.frame_id)
    transform :: Transform<Screen, World>.affine(1.0, 0.0, 0.0, 1.0, 13.0, 14.0, 41, 42)
    narrow :: Transform2<F32, World, Device>.affine(F32{1.0}, F32{0.0}, F32{0.0}, F32{1.0}, F32{14.0}, F32{15.0}, 42, 43)
    print(transform.tx)
    print(narrow.tx)
    print(transform.from_frame)
    print(narrow.to_frame)
}
