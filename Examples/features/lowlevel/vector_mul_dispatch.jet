// `*` on the math vectors: vector * vector multiplies lane by lane, and
// vector * Float scales every lane, for Vec2, Vec3 and Vec4 alike.
fn run() {
    p :: Vec2(1.0, 2.0)
    q :: Vec2(3.0, 5.0)
    print(Vec2{p * q}.to_array())
    print(Vec2{p * 3.0}.to_array())
    a :: Vec3(1.0, 2.0, 3.0)
    b :: Vec3(4.0, 5.0, 6.0)
    print(Vec3{a * b}.to_array())
    print(Vec3{a * 2.0}.to_array())
    u :: Vec4(1.0, 2.0, 3.0, 4.0)
    v :: Vec4(0.5, 0.5, 0.5, 0.5)
    print(Vec4{u * v}.to_array())
    print(Vec4{u * 0.5}.to_array())
}
