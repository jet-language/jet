// The audited region states its reason and tracks the obligations that the
// safe checker cannot infer from an opaque pointer alone. `cell` remains live,
// the pointer stays local, and the assertions make validity, alignment, and
// alias freedom explicit before each access.
use core.mem

fn run() {
    cell :: 1337
    #Unsafe("cell stays live and the pointer remains local", obligations: .Track) {
        pointer :: *cell
        assert no_alias
        print(pointer.*)
        assert valid_ptr, aligned
        observed :: mem.volatile_read(pointer)
        assert valid_ptr, aligned
        print(observed)
    }
}
