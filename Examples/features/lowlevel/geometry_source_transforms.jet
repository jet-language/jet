// Checked P/Next substitutions and source methods in both compiler halves.
// Golden is UNOBSERVED until the composed integration cycle.
fn run() {
    first :: Transform<Screen, World>.affine(2.0, 0.0, 0.0, 3.0, 5.0, 7.0, 11, 12)
    next :: Transform<World, View>.affine(1.0, 0.0, 0.0, 1.0, 10.0, 20.0, 12, 13)
    combined :: first.then(next) ?? panic("composition")
    print(combined.tx)
    print(combined.to_frame)
    inverse :: first.inverse() ?? panic("inverse")
    print(inverse.tx)
    print(inverse.to_frame)
    point :: first.point(ScreenPoint.new(1.0, 2.0)) ?? panic("stock P")
    print(point.x)
    print(point.y)
    print(point.frame_id)
    dynamic :: first.point(Point2<Float, Screen>.new(1.0, 2.0, 11)) ?? panic("dynamic P")
    print(dynamic.x)
    depth :: first.point_at_depth(ScreenPoint.new(1.0, 2.0), 4.0) ?? panic("depth")
    print(depth.x)
    ray :: first.ray(ScreenPoint.new(1.0, 2.0)) ?? panic("ray")
    print(ray.direction.x)
    narrow :: Transform2<F32, Screen, World>.affine(F32{1.0}, F32{0.0}, F32{0.0}, F32{1.0}, F32{2.0}, F32{3.0}, 11, 12)
    narrow_next :: Transform2<F32, World, View>.affine(F32{1.0}, F32{0.0}, F32{0.0}, F32{1.0}, F32{10.0}, F32{20.0}, 12, 13)
    print((narrow.then(narrow_next) ?? panic("F32 Next")).tx)
    print((narrow.inverse() ?? panic("F32 inverse")).tx)
    print((narrow.point(ScreenPoint.new(1.0, 2.0)) ?? panic("F32 P")).y)
    print((narrow.point_at_depth(ScreenPoint.new(1.0, 2.0), 4.0) ?? panic("F32 depth")).x)
    print((narrow.ray(ScreenPoint.new(1.0, 2.0)) ?? panic("F32 ray")).direction.x)
}
