code: fn() -> String? { Val("E1231") }

missing: fn() -> String? { None }

count: fn() -> Int? { Val(7) }

run: fn() {
    assert_eq(code(), Val("E1231"))
    assert_eq(count(), Val(7))
    assert_eq(missing(), missing())
    assert(code() != missing())
    found: code()
    absent: missing()
    print("{found:Debug}")
    print("{absent:Debug}")
    print("ok")
}
