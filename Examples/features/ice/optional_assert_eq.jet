fn code() -> String? { Val("E1231") }

fn missing() -> String? { None }

fn count() -> Int? { Val(7) }

fn run() {
    assert_eq(code(), Val("E1231"))
    assert_eq(count(), Val(7))
    assert_eq(missing(), missing())
    assert(code() != missing())
    found :: code()
    absent :: missing()
    print("{found:Debug}")
    print("{absent:Debug}")
    print("ok")
}
