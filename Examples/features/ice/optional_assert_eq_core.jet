// A program that needs no allocation selects the Core runtime layer; a hosted
// AOT build still links the std Prelude, so `assert`/`assert_eq` must use its
// helper shape (Tower #3675).
fn code() -> String? { Val("E1231") }

fn count() -> Int? { Val(7) }

fn run() {
    assert(1 + 1 == 2)
    assert_eq(3, 3)
    assert_eq(code(), Val("E1231"))
    assert_eq(count(), Val(7))
    print("ok")
}
