package {
    name: "files_handle_io"
    authority: { holds: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] } }
}

// Byte I/O and identity on open file handles (#3593): an exclusive create
// written with write_all, made durable with fsync, its mode set through the
// handle, then read back in bounded chunks while the reader's fstat identity
// is compared with the path's.

use core.files as files

fn run() {
    scratch :: files.temp_dir("handle-io")
    path :: files.join(scratch.path, "blob.bin")

    writer :: files.create(path, if_exists: .Refuse)
    writer.write_all("hello ".bytes())
    writer.write_all("world, bytes".bytes())
    writer.fsync()
    writer.set_mode(0o640)
    written :: writer.stat()
    print("written size {written.size} mode {written.mode} file {written.is_file}")
    close(^writer)
    held_dir :: files.open_directory(scratch.path)
    loop entry in held_dir.list() -> print("entry {entry.name} unicode={entry.name_is_unicode} raw bytes={entry.raw_name.len()} dir={entry.is_dir}")

    reader :: files.open(path, links: .Refuse)
    held :: reader.stat()
    now :: files.stat(path)
    print("same file as the path: {held.id.device == now.id.device && held.id.inode == now.id.inode}")
    total := 0
    chunks := 0
    loop {
        chunk :: reader.read(5)
        if chunk.len() == 0 -> break
        total += chunk.len()
        chunks += 1
    }
    print("read {total} bytes in {chunks} chunks")
    print("eof read is empty: {reader.read(5).len() == 0}")
    if reader.read(0) == {
        .Ok(_) -> print("read(0): accepted")
        .Err(_) -> print("read(0): InvalidInput")
    }
}
