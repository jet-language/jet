// core.process argv, pipe bounds and child lifecycle (CORE-F031, SCRIPT-F06).
// Arguments reach the child exactly, with no shell in between; `run` returns a
// nonzero receipt while `run_checked` takes the typed error path with bounded
// stderr; output limits and wall timeouts are recorded; a wall timeout stops
// the whole child tree; breaking out of a streamed stdout loop leaves no
// running child.
package {
    name: "process_argv_limits"
    authority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }
}

use core.process as process

fn checked(label: String, spec: ProcessSpec) -[Exec, IO, Time.Wait]> {
    receipt :: process.check_call(spec) ?? {
        print("{label}: {err}".trim())
        return
    }
    print("{label}: accepted code={receipt.code}")
}

fn report(label: String, spec: ProcessSpec) -[Exec, IO, Time.Wait]> {
    receipt :: process.run_spec(spec) ?? {
        print("{label}: {err}")
        return
    }
    hit :: if receipt.limit_hit == {
        .None -> "none"
        .Val(_) -> "hit"
    }
    print("{label}: success={receipt.success} code={receipt.code} timed_out={receipt.timed_out} limit={hit}")
}

// The bytes of child stderr carried in the checked error's cause.
fn checked_stderr_len(spec: ProcessSpec) -[Exec, Time.Wait]> Int {
    _ :: process.check_call(spec) ?? {
        tail := ""
        loop part in "{err}".split("stderr=") -> tail = part
        return tail.trim().len()
    }
    return -1
}

// `pgrep -f` exits 1 when no process matches the pattern.
fn alive(pattern: String) -[Exec, Time.Wait]> Bool {
    probe :: process.cmd(["pgrep", "-f", pattern]).stdout(.Capture).stderr(.Capture)
    receipt :: process.run_spec(probe) ?? return false
    receipt.success
}

fn run() -[Exec, IO, Time.Wait]> {
    tricky :: ["two words", "é ünïcødé ☕", "$HOME", "; echo pwned", "`id`", "a|b > c", "*", "it's", "quote\"s", ""]
    echo :: process.cmd(["printf", "[%s]\n"]).args_extend(tricky).stdout(.Capture)
    receipt :: process.run_spec(echo) ?? panic("printf failed")
    loop line in process.stdout_lines(receipt) -> print("argv {line}")

    report("run false", process.cmd(["false"]))
    checked("run_checked false", process.cmd(["false"]))

    failing :: process.cmd(["sh", "-c", "echo out; echo err >&2; exit 3"]).stdout(.Capture).stderr(.Capture)
    plain :: process.run_spec(failing) ?? panic("run failed")
    print("run: success={plain.success} code={plain.code} out={plain.output.trim()} err={plain.errors.trim()}")
    checked("run_checked", failing)

    loud :: process.cmd(["sh", "-c", "i=0; while [ $i -lt 5000 ]; do printf e >&2; i=$((i+1)); done; exit 1"]).stderr(.Capture)
    print("run_checked stderr bytes kept of 5000: {checked_stderr_len(loud)}")

    noisy :: process.cmd(["sh", "-c", "i=0; while [ $i -lt 200 ]; do printf e >&2; i=$((i+1)); done; exit 1"]).stderr(.Capture).output_limit(16)
    report("bounded run", noisy)
    checked("bounded checked", noisy)

    signalled :: process.cmd(["sh", "-c", "kill -TERM $$"])
    killed :: process.run_spec(signalled) ?? panic("signal run failed")
    print("signalled: success={killed.success} code={killed.code} signal={killed.signal ?? 0} exited={process.exited(killed)}")

    slow :: process.cmd(["sleep", "5"]).timeout(200ms)
    report("timeout run", slow)
    checked("timeout checked", slow)

    tree :: process.cmd(["sh", "-c", "sleep 31.4159 & sleep 31.4159; wait"]).timeout(200ms)
    report("tree timeout", tree)
    print("tree descendants alive after timeout: {alive("sleep 31.4159")}")

    child :: process.cmd(["seq", "1", "1000000"]).stdout(.Stream).timeout(10s).spawn() ?? panic("spawn failed")
    pid :: child.id()
    seen := 0
    loop line in child.stdout.lines() {
        seen += 1
        if seen == 3 -> break
    }
    print("streamed lines before break: {seen}")
    done :: child.wait() ?? panic("wait failed")
    print("child after break: timed_out={done.timed_out} alive={alive("^seq 1 1000000$")} pid_positive={pid > 0}")
}
