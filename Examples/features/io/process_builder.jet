package {
    name: "process_builder"
    authority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }
}

use core.process as process

fn run() -[Exec, IO, Time.Wait]> {
    timeout :: 1s
    spec :: process.cmd(["echo", "process-api"]).stdout(.Capture).stderr(.Capture).timeout(timeout).output_limit(1024)
    result :: process.run_spec(spec) ?? panic("process failed")
    print(result.success)
    print(result.timed_out)
    print(result.output.len() <= 1024)
    print(result.output.trim())
    checked_spec :: process.cmd(["echo", "checked-api"]).stdout(.Capture).stderr(.Capture)
    checked :: process.check_call(checked_spec) ?? panic("checked process failed")
    print(checked.output.trim())
    spec1 :: process.cmd(["echo", "pipeline-api"])
    spec2 :: process.cmd(["cat"])
    piped :: process.pipeline([spec1, spec2]) ?? panic("pipeline failed")
    print(piped.output.trim())
    child :: process.cmd(["echo", "spawn-api"]).stdout(.Stream).spawn() ?? panic("spawn failed")
    loop line in child.stdout.lines() -> print(line.trim())
    waited :: child.wait() ?? panic("wait failed")
    print(waited.success)
    // #1481 core.process: a non-blocking poll alongside the blocking `wait()`.
    print(child.exited() ?? panic("exited failed"))
    terminal_spec :: process.cmd(["echo", "terminal-api"]).terminal(TerminalPolicy{
        size: TerminalSize{cols: 100, rows: 30},
        mode: .Cooked
    })
    print(terminal_spec.abilities().has("preview_example"))
}
