// D-DBPOOL1: a pool handed to a function is spelled `DBPool` in its signature.
package {
    name: "db_pool_type"
    authority: { holds: { allow: [DB, IO, Mem.Alloc, Time.Wait] } }
}

use core.db as db

fn describe(pool: DBPool) -> String {
    ready :: pool.ready() ?? false
    "pool ready: {ready}"
}

fn run() {
    pool :: db.pool(":memory:", max: 1) ?? return
    print(describe(pool))
    _receipt :: pool.drain() ?? return
    print("drained")
}
