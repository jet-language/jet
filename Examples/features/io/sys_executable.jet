// `os.executable()` names the file of the running process on every tier: the
// `jet` host under `jet run`, the built binary after `jet build`.
package {
    name: "sys_executable"
    authority: { holds: { allow: [Env, FS.Read, IO, Mem.Alloc] } }
}

use core.files as files
use core.sys as os

fn run() {
    exe :: os.executable()
    print("named: {exe.len() > 0}")
    print("exists: {files.exists(exe)}")
    print("stable: {os.executable() == exe}")
}
