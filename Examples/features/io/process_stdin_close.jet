// D-PROCESS-STDIN1: a spawned child owns an explicit closeable stdin pipe.
package {
    name: "process_stdin_close"
    authority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }
}

use core.process as process

fn run() {
    child :: process.cmd(["cat"]).stdin(.Stream).stdout(.Capture).spawn() ?? return
    child.stdin.close()
    result :: child.wait() ?? return
    print("stdin-closed:{result.success}")
}
