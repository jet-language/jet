package {
    name: "cli"
    authority: { allow: [Env, Exec, Exec.Args, IO] }
}

use {
    io :: core.term
    env :: core.sys
    process :: core.process
}

fn run() {
    args :: process.argv()
    mode :: env.get("JET_M10_MODE") ?? "default"
    // `jet run tool.jet alice` forwards words after the file as argv (index 0 stays the program name).
    if {
        args.len() >= 2 -> { print(args.get(1) ?? "") }
        else -> { print(args.len()) }
    }
    print(mode)
    process.exit(0)
}
