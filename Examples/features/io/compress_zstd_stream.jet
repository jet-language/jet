package {
    name: "compress_zstd_stream"
    authority: { holds: { allow: [FS, FS.Read, FS.Write, IO, Mem.Alloc] } }
}

// Zstandard compressed blocks (Huffman literals, FSE sequences, repeat
// offsets), skippable and concatenated frames, and incremental decoding:
// `zstd.decoder()` takes chunks of any size and hands decoded bytes back in
// bounded reads; `zstd.reader(file)` pulls a FileReader through one.

use core.archive.zstd as zstd
use core.encoding.base64 as base64
use core.files as files

// `zstd -19` of `expected_bytes()` from a pipe: a windowed frame with no content
// size, several compressed blocks, and a content checksum.
C_BIG :: ""
// Two single-segment frames around a skippable frame.
C_MULTI :: "KLUv/SRxVQIABARUaGUgcXVpY2sgYnJvd24gZm94IGp1bXBzIG92ZXIgdGhlIGxhenkgZG9nLiAgYWdhaW4sIGFuZDogenN0ZCEKAgAugy/QVGWtw4gSUypNGAUAAABza2lwISi1L/0kcVUCAAQEVGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4gIGFnYWluLCBhbmQ6IHpzdGQhCgIALoMv0FRlrcOIEg=="
C_SMALL :: "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog again, and again: zstd!\n"

fn expected_bytes() -> [U8] {
    words :: [String]{"alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel", "india", "juliet", "kilo", "lima", "mike"}
    out := [U8]{}
    loop i in 0..<6000 {
        first :: words[(i * 7) % 13]
        second :: words[(i * 3) % 13]
        square :: (i * i) % 1000
        line :: "line {i}: {first} {second} {square}\n"
        loop byte in line.bytes() -> &out.push(byte)
    }
    out
}

fn run() {
    expected :: expected_bytes()
    big :: base64.decode(C_BIG) ?? panic("base64")
    whole :: zstd.decompress(big) ?? panic("decompress")
    print("whole: {whole.len()} bytes, equal {whole == expected}")

    multi :: zstd.decompress_text(base64.decode(C_MULTI) ?? panic("base64")) ?? panic("multi")
    small :: C_SMALL
    doubled :: "{small}{small}"
    print("frames: {multi == doubled}")

    decoder := zstd.decoder()
    streamed := [U8]{}
    largest := 0
    at := 0
    loop at < big.len() {
        stop :: if at + 1000 < big.len() -> at + 1000 else -> big.len()
        &decoder.feed(big[at..<stop])
        at = stop
        loop {
            piece :: &decoder.read(4096) ?? panic("stream")
            if piece.len() == 0 -> break
            if piece.len() > largest -> largest = piece.len()
            loop byte in piece -> &streamed.push(byte)
        }
    }
    decoder.finish() ?? panic("finish")
    print("streamed: {streamed.len()} bytes in reads of at most {largest}, equal {streamed == expected}")

    scratch :: files.temp_dir("zstd-stream")
    path :: files.join(scratch.path, "big.zst")
    files.write_bytes(path, big)
    file :: files.open(path)
    reader := zstd.reader(^file)
    from_file := [U8]{}
    loop {
        piece :: &reader.read(65536) ?? panic("reader")
        if piece.len() == 0 -> break
        loop byte in piece -> &from_file.push(byte)
    }
    print("reader: equal {from_file == expected}")

    corrupt := big.copy()
    corrupt[corrupt.len() - 2] = U8{(Int.from_u8(corrupt[corrupt.len() - 2]) + 1) % 256}
    if zstd.decompress(corrupt) == {
        .Ok(_) -> print("corrupt checksum: accepted")
        .Err(error) -> print("corrupt checksum: {error == .Checksum}")
    }
    truncated := zstd.decoder()
    &truncated.feed(big[0..<big.len() - 100])
    loop {
        piece :: &truncated.read(65536) ?? panic("truncated read")
        if piece.len() == 0 -> break
    }
    if truncated.finish() == {
        .Ok(_) -> print("truncated: accepted")
        .Err(error) -> print("truncated: {error == .Malformed}")
    }
}
