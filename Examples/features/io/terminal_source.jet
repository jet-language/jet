// Core source composition: binary files, UTF-8 stderr, CRLF lines and EOF.
package {
    name: "terminal_source"
    authority: { holds: { allow: [FS, Env, IO, Mem.Alloc, Time.Wait] } }
}

use core.files as files
use core.term as term

fn run() {
    scratch :: files.temp_dir("term-source")
    path :: files.join(scratch.path, "bytes.bin")
    bytes :: [U8]{0, 255, 10, 195, 169}
    term.binwrite(path, bytes) ?? panic("write bytes")
    actual :: term.binread(path) ?? panic("read bytes")
    print(actual == bytes)
    term.eprint("héllo")
    term.eprint("")
    reader := term.buffered()
    first :: &reader.read_line()
    second :: &reader.read_line()
    end :: &reader.read_line()
    print(first ?? "missing")
    print(second ?? "missing")
    print(end == None)
}
