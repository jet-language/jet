package {
    name: "io_db_migration_proof"
    version: "0.1.0"
    authority: { holds: { allow: [DB, Exec, FS, FS.Read, FS.Write, IO, Mem.Alloc, Time] } }
}
// #3094: migration and transaction ownership on the real core.db path.
// A failed migration leaves no applied record and no partial schema, a
// failed transaction leaves rows unchanged, a second connection can write
// after commit and after a failed batch (nothing stays locked or leased),
// and a nested `begin` is printed exactly. SQLite file, no ORM.
use core.db as db
use core.files as fs

fn count(scope: DBScope, sql: SQL) -[DB]> Int {
    row :: scope.query_one(sql) ?? return -1
    db.row_int(row, "n") ?? -1
}

fn run() {
    path :: "/tmp/jet_db_migration_proof.sqlite"
    if fs.exists(path) -> fs.remove(path)
    conn :: db.open(path)
    policy :: db.policy("item", "true") ?? panic("policy")
    scope :: conn.with_policy(policy, "owner")

    v1 :: db.migrate(scope, "v1", [SQL{"CREATE TABLE item (id INTEGER PRIMARY KEY, name TEXT NOT NULL)"}]) ?? -1
    print("migrate v1 steps: {v1}")
    if db.migrate(scope, "v2", [SQL{"CREATE TABLE audit (id INTEGER PRIMARY KEY)"}, SQL{"ALTER TABLE missing_table ADD COLUMN x INTEGER"}]) == {
        .Ok(steps) -> print("migrate v2: applied {steps}")
        .Err(_) -> print("migrate v2: failed")
    }
    print("applied v1 rows: {count(scope, SQL{"SELECT COUNT(*) AS n FROM __jet_migrations WHERE migration_key = 'v1' AND status = 'applied'"})}")
    print("applied v2 rows: {count(scope, SQL{"SELECT COUNT(*) AS n FROM __jet_migrations WHERE migration_key = 'v2' AND status = 'applied'"})}")
    print("v2 first-step table present: {count(scope, SQL{"SELECT COUNT(*) AS n FROM sqlite_master WHERE type = 'table' AND name = 'audit'"})}")

    committed :: db.transaction(scope, "good batch", [SQL{"INSERT INTO item (id, name) VALUES (1, 'one')"}, SQL{"INSERT INTO item (id, name) VALUES (2, 'two')"}]) ?? -1
    print("commit steps: {committed}")
    print("rows after commit: {count(scope, SQL{"SELECT COUNT(*) AS n FROM item"})}")
    if db.transaction(scope, "bad batch", [SQL{"INSERT INTO item (id, name) VALUES (3, 'three')"}, SQL{"INSERT INTO item (id, name) VALUES (1, 'duplicate')"}]) == {
        .Ok(steps) -> print("bad batch: committed {steps}")
        .Err(_) -> print("bad batch: rolled back")
    }
    print("rows after failed batch: {count(scope, SQL{"SELECT COUNT(*) AS n FROM item"})}")

    // A second connection proves the first holds no open transaction or lock.
    other :: db.open(path)
    other_scope :: other.with_policy(policy, "owner")
    if other_scope.execute(SQL{"INSERT INTO item (id, name) VALUES (4, 'four')"}) == {
        .Ok(_) -> print("second connection write: ok")
        .Err(_) -> print("second connection write: blocked")
    }
    print("rows seen by first connection: {count(scope, SQL{"SELECT COUNT(*) AS n FROM item"})}")
    _other_closed :: other_scope.close()

    // Nested begin: record the exact behavior.
    print("outer begin: {scope.begin()}")
    print("nested begin: {scope.begin()}")
    _rolled :: &scope.rollback()
    print("rows after nested rollback: {count(scope, SQL{"SELECT COUNT(*) AS n FROM item"})}")

    _closed :: scope.close()
    if scope.query(SQL{"SELECT id FROM item"}) == {
        .Ok(_) -> print("query after close: accepted")
        .Err(_) -> print("query after close: rejected")
    }
    fs.remove(path)
}
