// D-FSOPS1: parallel directory queue + regex file scan. Both walks yield the
// Core `WalkEntry` fields `path`, `relative`, `is_dir` and `depth`.
package {
    name: "grep_scan"
    // Walks and reads need FS.Read; fixture creation needs FS.Write.
    authority: { holds: { allow: [FS.Read, FS.Write, IO, Mem.Alloc] } }
}

use core.files as fs
use core.testing as testing

fn run() {
    root :: testing.temp_dir("grep-scan")
    src :: Path.from(root).join("src")
    fs.create_dir_all(src)
    fs.write(Path.from(root).join("notes.txt"), "needle in notes\n")
    fs.write(src.join("alpha.txt"), "needle in alpha\n")
    fs.write(src.join("beta.txt"), "no match\n")
    ignored :: Path.from(root).join("ignored")
    fs.create_dir_all(ignored)
    fs.write(ignored.join("hidden.txt"), "needle must stay ignored\n")
    fs.write(Path.from(root).join(".gitignore"), "ignored/\n")

    // Both walks opt into the same ignore file; omission means no ignore rules.
    parallel :: fs.walk_parallel(root, ignore: ".gitignore")
    sequential :: fs.walk(root, ignore: ".gitignore")
    parallel_set := [String]{}
    sequential_set := [String]{}
    loop entry in parallel -> &parallel_set.push("{entry.relative}:{entry.is_dir}:{entry.depth}")
    loop entry in sequential -> &sequential_set.push("{entry.relative}:{entry.is_dir}:{entry.depth}")
    &parallel_set.sort()
    &sequential_set.sort()

    matches := [String]{}
    needle :: Regex{"needle"}
    loop entry in parallel {
        if !entry.is_dir {
            text :: fs.read(entry.path)
            if needle.is_match(text) -> &matches.push("{entry.relative}: needle")
        }
    }
    &matches.sort()
    print("matches: {matches.len()}")
    loop line in matches -> print(line)
    print("walks agree: {parallel_set == sequential_set}")
    loop line in sequential_set -> print(line)
}
