// `jet run file.jet -- arg1 arg2` forwards everything after `--` to the
// program verbatim. The program reads those words through `process.args()`:
// the user's words in order, with no program name in front.
//
// Run with:  jet run Examples/features/io/cli_args.jet -- hello world
// Expect:    2, then hello and world on their own lines
//
// The golden test runs this program with no extra words, so it prints 0.
use process :: core.process

fn run() {
    args :: process.args()
    print(args.len())
    loop word in args -> print(word)
}
