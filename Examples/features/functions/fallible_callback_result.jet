// A callback whose expected result is already fallible checks each
// `return Ok(..)` and `return Err(..)` against that expected result (no
// written lambda result type), and the enclosing `run` stays infallible.
#Error
enum Reject {
    Odd
}

fn each(values: [Int], handler: fn(Int) -> Int Reject!) -> Int {
    total := 0
    loop value in values {
        total += handler(value) ?? 1
    }
    total
}

fn run() {
    print(each([2, 3, 4], (value: Int) -> {
        if value % 2 == 1 { return Err(Reject.Odd) }
        return Ok(value * 10)
    }))
}
