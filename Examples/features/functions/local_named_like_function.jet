// A call `describe(value)` names the declared function even when a local
// value of the same name is in scope; the local is still read as a value.
fn describe(value: Int) -> String {
    "v{value}"
}

fn label(value: Int) -> String {
    describe :: "local"
    "{describe}:{describe(value)}"
}

fn run() {
    print(label(4))
}
