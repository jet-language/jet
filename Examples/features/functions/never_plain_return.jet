// D-FAILURE-FOUNDATION1 (#3740): a function whose failure set is empty
// (`T Never!`) returns its success value directly on every tier. Its callers,
// optional returns, early returns, and function values all see plain values.
fn double(x: Int) -> Int Never! {
    x * 2
}

fn first_even(xs: [Int]) -> Int? Never! {
    loop x in xs {
        if x % 2 == 0 -> return Val(x)
    }
    None
}

fn clamp(x: Int, hi: Int) -> Int Never! {
    if x > hi -> return hi
    x
}

fn note(total: &Int, x: Int) Never! {
    total += x
}

fn apply(f: fn(Int) -> Int Never!, x: Int) -> Int Never! {
    f(x)
}

fn run() {
    print(double(21))
    print(first_even([Int]{1, 3, 4, 5}) ?? -1)
    print(first_even([Int]{1, 3}) ?? -1)
    if first_even([Int]{7, 8}) == {
        Val(found) -> print("found {found}")
        None -> print("none")
    }
    print(clamp(12, 10))
    print(clamp(3, 10))
    total := 0
    note(&total, 5)
    note(&total, 6)
    print(total)
    print(apply(double, 5))
    twice := double
    print(twice(8))
}
