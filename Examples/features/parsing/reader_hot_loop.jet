// Non-corpus witness for the bounded fixed-width Reader region path.
// The default stays small so every hosted tier can prove the same golden;
// pass 1000000 for the AOT benchmark.
use core.process as process

fn run() !Err {
    n :: Int.parse(process.argv().get(1) ?? "1000") ?? 1000
    data :: "A".repeat(n).bytes()
    reader :: Reader.over(data)
    total := U64{0}
    loop _ in 0..<n {
        byte :: reader.read_u8() ?? return
        total = total.wrapping_add(U64.from_u8(byte))
    }
    total = keep(total)
    print(total)
}
