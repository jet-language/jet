// `#Pre` conditions may join tests with `&&` and `||`, and a function's
// precondition is checked at each call, including two calls to the same
// function in one expression (#6274). A failing call stops with the caret
// under the called name (#6300).
#Pre(n == 4 || n == 8, "need 4 or 8")
lanes: fn(n: Int) -> Int { n }

#Pre(n >= 1 && n <= 9, "need 1 to 9")
digit: fn(n: Int) -> Int { n }

#Pre(n != 3, "not three")
pick: fn(n: Int) -> Int { n }

run: fn() {
    print(lanes(4))
    print(lanes(8))
    print(digit(1) + digit(9))
    print(pick(4) + pick(5))
    print(lanes(6))
}
