// Contract carrier binding across explicit and implicit return forms.
// The executable entry below prints deterministic success/failure assertions.
// Direct-mode posts inspect the returned carrier; ResultPayload posts skip Err.

#Error
CarrierFixtureError: enum {
    Rejected
}

// Explicit Option: result is the declared Option carrier (Direct mode).
// Post checks the returned carrier for both Val and None.
#Post(result == .Val(_) || result == None, "explicit option carrier")
explicit_option: fn(value: Int) -> Int? {
    if value < 0 -> return None
    return Val(value)
}

// Explicit Result: result is the declared Result carrier (Direct mode).
// Post checks the returned carrier for both Ok and Err.
#Post(result == .Ok(_) || result == .Err(.Rejected), "explicit result carrier")
explicit_result: fn(value: Int) -> Int CarrierFixtureError! {
    if value < 0 -> return Err(CarrierFixtureError.Rejected)
    return Ok(value)
}

// Implicit carrier: the declared Int is wrapped in Result(Int, Err), so Post
// binds the successful Int payload (ResultPayload mode) and skips Err.
#Post(result > value, "implicit payload success")
implicit_result: fn(value: Int) -> Int {
    if value < 0 -> return Err("negative")
    return value + 1
}

// A read precondition borrows the caller's collection once; the owner remains
// usable after the call.
#Pre(values.len() > 0, "borrowed owner remains live")
borrowed_precondition: fn(values: [Int]) -> Int {
    return values[0]
}

carrier_binding_fixture: fn() {
    values := [1]
    implicit_success: implicit_result(1)
    if implicit_success != 2 -> panic("implicit payload assertion failed")
    if explicit_result(1) == {
        .Ok(value) -> if value != 1 -> panic("explicit result success assertion failed")
        .Err(_) -> panic("explicit result success route failed")
    }
    if explicit_result(-1) == {
        .Ok(_) -> panic("explicit result failure route missing")
        .Err(error) -> if error != CarrierFixtureError.Rejected -> panic("explicit result failure value failed")
    }
    if explicit_option(1) == {
        .Val(value) -> if value != 1 -> panic("explicit option success assertion failed")
        .None -> panic("explicit option success route failed")
    }
    if explicit_option(-1) == {
        .Val(_) -> panic("explicit option failure route missing")
        .None -> {}
    }
    if implicit_result(-1) == {
        .Ok(_) -> panic("implicit result failure route missing")
        .Err(_) -> {}
    }
    borrowed_value: borrowed_precondition(values)
    owner_len: values.len()
    if borrowed_value != 1 || owner_len != 1 -> panic("borrowed owner assertion failed")
    print("carrier-binding: implicit=2 option=Val option_failure=None result=Ok result_failure=Err implicit_failure=Err borrowed=1 owner_len=1")
}

run: fn() {
    carrier_binding_fixture()
}
