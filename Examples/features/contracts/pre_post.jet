// D-PREPOST1 — `#Pre`/`#Post` function contracts.
// `#Pre(cond, "msg")` claims something about the arguments, checked at
// function entry; `#Post(cond, "msg")` claims something about `result` (the
// return value), checked before the function returns. Both are checked in
// every build by default — not a debug/release split. Conditions are pure
// (no effects), same as `fn … -[]>`.
#[Pre(cents > 0, "cents must be positive"), Post(result > cents, "result must exceed the original amount")]
add_fee: fn(cents: Int) -> Int { return cents + 5 }

run: fn() {
    total: add_fee(100)
    print("total: {total}")
}
// --- expected output --------------------------------------------------
// total: 105
