// D-OP-CALL1=A: parentheses call functions and lambdas only. A struct that
// should act as a function hands out a lambda through a method it writes.
struct Scale {
    factor: Int

    fn apply(self, n: Int) -> Int { n * self.factor }

    fn as_fn(self) -> fn(Int) -> Int {
        factor :: self.factor
        (n: Int) -> n * factor
    }
}

fn make_adder(n: Int) -> fn(Int) -> Int { (x: Int) -> x + n }

fn run() {
    triple :: Scale{factor: 3}
    print(triple.apply(4))
    times3 :: triple.as_fn()
    print(times3(4))
    add40 :: make_adder(40)
    print(add40(2))
}
