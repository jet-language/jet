package {
    name: "ui_preview_viewport"
    version: "0.1.0"
    authority: { allow: [Browser, IO, Mem.Alloc] }
}
// A named preview takes its viewport as an optional label-only argument.
// `ui.preview(name, body, viewport: v)` is the Core preview constructor
// itself: the callback is a lambda the preview registry retains and renders
// on demand, and omitting `viewport:` keeps the default desktop viewport.
use core.ui as ui

fn card() -> UINode Never! {
    ui.box([ui.text("Card title"), ui.node("Card body", 160.0, 48.0)])
}

fn describe(entry: UIPreview) -> String Never! {
    kind :: if entry.kind == .Playground -> "playground" else -> "preview"
    device :: if entry.viewport.device == {
        .Phone -> "phone"
        .Tablet -> "tablet"
        .Desktop -> "desktop"
    }
    "{kind} {entry.name}: {device} {entry.viewport.width}x{entry.viewport.height} @{entry.viewport.scale}x"
}

fn run() {
    phone :: ui.preview("card-phone", () -> card(), viewport: ui.phone())
    fallback :: ui.preview("card-default", () -> card())
    lab :: ui.playground("card-lab", () -> card(), viewport: ui.tablet())
    print(describe(phone))
    print(describe(fallback))
    print(describe(lab))
    if ui.previews([phone, fallback]) == {
        .Ok(registry) -> {
            if registry.render("card-phone") == {
                .Ok(_) -> print("registry renders card-phone")
                .Err(error) -> print("registry render failed: {error}")
            }
            if registry.render("card-missing") == {
                .Ok(_) -> print("registry rendered an unregistered name")
                .Err(error) -> print("registry rejects card-missing: {error}")
            }
        }
        .Err(error) -> print("registry failed: {error}")
    }
    if ui.playgrounds([lab, ui.playground("card-lab", () -> card())]) == {
        .Ok(_) -> print("registry accepted a duplicate name")
        .Err(error) -> print("registry rejects duplicates: {error}")
    }
}
