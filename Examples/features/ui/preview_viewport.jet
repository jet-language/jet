// A named preview takes its viewport as an optional label-only argument.
// `ui.preview(name, body, viewport: v)` is the Core preview constructor
// itself: the callback is a lambda the preview host retains and renders on
// demand, and omitting `viewport:` keeps the default desktop viewport.
use core.ui as ui

fn card() -> UiNode {
    ui.box([ui.text("Card title"), ui.node("Card body", 160.0, 48.0)])
}

fn run() {
    _phone :: ui.preview("card-phone", () -> card(), viewport: ui.phone())
    _fallback :: ui.preview("card-default", () -> card())
    _lab :: ui.playground("card-lab", () -> card(), viewport: ui.desktop())
    print("preview card-phone: phone viewport")
    print("preview card-default: default viewport")
    print("playground card-lab: desktop viewport")
}
