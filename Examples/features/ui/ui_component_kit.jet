package: {
    name: "ui_ui_component_kit"
    version: "0.1.0"
    authority: { allow: [Browser, Exec, IO, Mem.Alloc] }
}

// The ownable component kit composes the same canonical UiNode tree consumed
// by null, TUI, DOM, and GTK backends.
use ui: core.ui

Label: struct {
    text: String
}

label: fn(text: String) -> Label { {text: text.copy()} }

label_view: fn(value: Label) -> UINode { ui.text(value.text) }

Input: struct {
    value: String
    placeholder: String
}

input: fn(placeholder: String) -> Input { {value: "", placeholder: placeholder.copy()} }

type_char: fn(value: Input, ch: String) -> Input { {value: "{value.value}{ch}", placeholder: value.placeholder.copy()} }

input_view: fn(value: Input) -> UINode {
    shown := value.value.copy()
    if value.value == "" -> shown = value.placeholder.copy()
    return ui.node_role("[{shown}]", 20.0, 1.0, ui.aria_role_text_input())
}

Button: struct {
    label: String
    clicks: Int
}

button: fn(label: String) -> Button { {label: label.copy(), clicks: 0} }

press: fn(value: Button) -> Button { {label: value.label.copy(), clicks: value.clicks + 1} }

button_view: fn(value: Button) -> UINode { ui.button("[{value.label}] clicks={value.clicks}") }

container: fn(children: [UINode]) -> UINode { ui.box(children) }

paint_form: fn(name: Label, input_value: Input, save: Button) {
    tree: container([label_view(name), input_view(input_value), button_view(save)])
    backend := ui.null_backend()
    size: backend.measure(tree, ui.constraint(0.0, 0.0, 80.0, 24.0))
    backend.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
    backend.paint(tree)
}

run: fn() {
    name: label("Name:")
    name_input := input("type here…")
    save := button("Save")
    paint_form(name, name_input, save)
    print("Name:")
    print("[type here…]")
    print("[Save] clicks=0")
    name_input = type_char(type_char(type_char(name_input, "A"), "d"), "a")
    save = press(save)
    paint_form(name, name_input, save)
    print("Name:")
    print("[{name_input.value}]")
    print("[Save] clicks={save.clicks}")
}
