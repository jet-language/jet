// D-ANY-JAI1/D-VARARGBOUND1: `parts: ...Renderable` — a trait-bounded
// heterogeneous variadic. Each call-site argument is checked against
// `Renderable` and monomorphized to its own concrete type — zero boxing, no
// dynamic dispatch. `Renderable` is satisfied by anything already
// interpolatable (`{value}`): every primitive, and any struct/enum that's
// auto-printable or has an explicit `Display` impl.
log_all: fn(parts: ...Renderable) {
    loop p in parts -> print("{p}")
}

Point: struct {
    x: Int
    y: Int

    impl Display {
        display: fn(self) -> String { "({self.x}, {self.y})" }
    }
}

run: fn() {
    p: Point{x: 3, y: 4}
    log_all(1, "two", true, p)
    log_all(3.5, false)
}
