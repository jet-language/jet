// 151 — leading-dot enum variant `.Variant` in value position (D-ENUMDOT2=A).
// When the enum type is known from context, `.Variant` is a shorthand for `Type.Variant`.
Direction: enum {
    North
    South
    East
    West
}

Shape: enum {
    Circle(Float)
    Square(Float)
}

area: fn(s: Shape) -> Float {
    return if s == {
        .Circle(r) -> 3.14159 * r * r
        .Square(w) -> w * w
        else -> 0.0
    }
}

label: fn(d: Direction) -> String {
    return if d == {
        .North -> "north"
        .South -> "south"
        .East -> "east"
        .West -> "west"
    }
}

run: fn() {
    d: Direction.North
    print(label(d))
    print(label(.South))
    s: Shape.Circle(3.0)
    print(area(s))
    print(area(.Square(4.0)))
}
