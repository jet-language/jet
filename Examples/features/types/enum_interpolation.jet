// A plain enum (every case a unit case) interpolates as its case name on every
// tier: AOT, the default `jet run`, and `jet run --interpret` print the same text.
enum Light {
    Red
    Green
}

fn run() {
    print("light: {Light.Red}")
    green :: Light.Green
    print("light: {green}")
    lights :: [Light.Red, Light.Green, Light.Red]
    print("lights: {lights}")
    print(Light.Green)
}
