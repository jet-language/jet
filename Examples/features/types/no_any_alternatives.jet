// D-DYNAMIC-TYPE1=A: Jet has no top type like Any.
// Pick the precise mechanism: enum for known variants, generics for abstraction,
// ?T for absence, and Dyn for parsed dynamic input.
use core.encoding.json as json

enum Payload {
    Name(String)
    Count(Int)
}

fn echo<T>(value: T) -> T { value.copy() }

fn label(payload: Payload) -> String {
    return if payload == {
        .Name(s) -> s.copy()
        .Count(n) -> "{n}"
    }
}

fn run() {
    p :: Payload.Count(3)
    print(label(p))
    print(echo("typed"))
    maybe :: Val("present")
    if maybe == .Val(s) -> print(s)
    data :: Dyn{json.parse("{{\"name\":\"jet\"}}") ?? return}
    if data == .Object(_) {
        if (&data.field("name") ?? Dyn.Null) == .Text(name) -> print(name)
    }
}
