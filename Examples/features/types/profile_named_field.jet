// `profile` is a build fact only on the `@build` subject. On any other
// receiver it is an ordinary field, including inside a derived codec.
use core.encoding.json as json

#Codable
struct Identity {
    source: String
    profile: String
    target: String
}

fn main() {
    identity :: Identity{source: "a", profile: "release", target: "x86_64"}
    print(identity.profile)
    print(json.to_string(identity))
}
