// An Int? is one word: the Int itself when present, the niche 2^62 when
// absent (JetIR Build.jet IR_OPTION_INT_NONE), which no Int ever is: a big
// Int is a tagged node address. The Ints at and around 2^62 (inline and
// big), arithmetic and bit operations crossing it, collections, lazy
// iterators, map results, records, ordering, comptime values and write
// windows must all keep Some(2^62) apart from None, on every tier.

fn big() -> Int { 4611686018427387904 }

fn wrap(x: Int) -> Int? { Val(x) }

fn none() -> Int? { None }

fn show(o: Int?) -> String {
    if o == .Val(v) -> return "Some({v})"
    "None"
}

struct Rec {
    name: String
    count: Int?
}

K_SOME :: comptime { wrap(4611686018427387904) }
K_NONE :: comptime { none() }
K_SMALL :: comptime { wrap(-3) }

// Write windows into an inline Int?: a write parameter, a field, a variable.
fn grow(o: &Int?, by: Int) {
    if &o == {
        .Val(n) -> n = n + by
        None -> {}
    }
}

fn windows() {
    local := wrap(4611686018427387903)
    if &local == {
        .Val(n) -> n = n + 1
        None -> {}
    }
    print("window local {show(local)}")
    grow(&local, 1)
    print("window param {show(local)}")
    rec := Rec{name: "w", count: wrap(-4611686018427387904)}
    if &rec.count == {
        .Val(n) -> n = n - 1
        None -> {}
    }
    print("window field {show(rec.count)}")
    empty := none()
    grow(&empty, 5)
    print("window none {show(empty)}")
    loop i in 0..<3 {
        if &local == {
            .Val(n) -> n = n - 4611686018427387904
            None -> {}
        }
    }
    print("window loop {show(local)}")
}

fn run() {
    edges :: [Int]{4611686018427387903, 4611686018427387904, -4611686018427387904, -4611686018427387905, 0, -1}
    loop e in edges {
        o :: wrap(e)
        print("{e} {show(o)} {o ?? 7} {(o ?? 0) + 1} {(o ?? 0) << 1} {(o ?? 0).bit_and(4611686018427387904)}")
    }
    // Arithmetic that crosses the inline/node boundary.
    b :: big()
    print("{show(wrap(b - 1 + 1))} {show(wrap(b * 1))} {show(wrap((b - 1) + 1))} {show(wrap(1 << 62))}")
    print("{show(none())} {none() ?? 5} {none() == None} {wrap(b) == None} {wrap(b) == wrap(4611686018427387904)}")
    // Collections.
    list :: [Int?]{wrap(b), None, wrap(3), wrap(-b)}
    loop item in list -> print(show(item))
    copied :: list.copy()
    print("{copied.len()} {show(copied[0])} {show(copied[1])}")
    xs :: [Int]{5, 4611686018427387904, 9}
    print("{show(xs.first())} {show(xs.last())} {show(xs.get(1))} {show(xs.get(9))}")
    print("{show(xs.index_of(4611686018427387904))} {show(xs.lazy().position((x) -> x > 6))}")
    print("{show(xs.find((x) -> x > 6))} {show(xs.lazy().skip(2).first())}")
    mutable := [Int]{1, 4611686018427387904}
    print("{show(&mutable.pop())} {show(&mutable.pop())} {show(&mutable.pop())}")
    sorted :: [Int]{1, 3, 4611686018427387904}
    print("{show(sorted.binary_search(4611686018427387904))}")
    m := [String: Int]{}
    m["a"] = 4611686018427387904
    print("{show(m.get("a"))} {show(m.get("b"))}")
    print("{show(&m.remove("a"))} {show(&m.remove("a"))}")
    // Lazy iteration.
    lazy :: xs.lazy().filter_map((x) -> if x > 6 -> Val(x) else -> None).collect()
    print("{lazy.len()} {lazy[0]} {lazy[1]}")
    print("{show(xs.lazy().first())} {show(xs.lazy().skip(1).first())} {show(xs.lazy().skip(3).first())}")
    tried :: xs.lazy().map((x) -> if x > 6 -> Val(x) else -> None).collect()
    loop t in tried -> print(show(t))
    // Records and equality/ordering.
    r :: Rec{name: "r", count: wrap(b)}
    s :: Rec{name: "s", count: None}
    print("{show(r.count)} {show(s.count)} {r.count == s.count} {r.count == wrap(b)}")
    print("{wrap(3) < wrap(4)} {none() < wrap(0)} {wrap(b) > wrap(b - 1)}")
    print("{r}")
    print("{show(K_SOME)} {show(K_NONE)} {show(K_SMALL)} {K_SOME == wrap(b)}")
    windows()
}
