// A bounded generic function specialized from inside another bounded generic
// keeps both functions' bounds: the inner and the outer `>` each resolve to
// the `Comparable` compare of the concrete type.
max_of: fn<T: Comparable>(left: T, right: T) -> T { if left > right -> left.copy() else -> right.copy() }

max3: fn<T: Comparable>(first: T, second: T, third: T) -> T {
    best: max_of(first, second)
    if best > third -> best.copy() else -> third.copy()
}

run: fn() {
    print(max3(4, 9, 7))
    print(max3(-3, -8, -5))
    print(max3(0.5, 1.5, 2.5))
}
