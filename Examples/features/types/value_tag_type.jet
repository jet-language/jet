// D-QUAL4=A: `#TagName T` is a value-tag qualifier in type position.
// The tag documents intent (e.g., "this string is untrusted") without
// changing the runtime type — the underlying value is still a plain T.
Raw: tag { deny: [DB] }

Locale: tag { deny: [Net] }

Sanitized: tag { deny: [Log] }

tag_score: fn(rating: #Raw Int) -> Int { rating * 2 }

show_pair: fn(label: #Locale String, value: #Sanitized String) -> String { "{label}: {value}" }

run: fn() {
    score: tag_score(21)
    line: show_pair("Name", "Alice")
    print("{score}")
    print(line)
}
