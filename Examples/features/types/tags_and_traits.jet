// D-QUAL2: methods → trait; no methods → tag.
//
// Tags mark intent on values (`#Reviewed String`) and erase at runtime —
// the value is still a plain String. Traits add methods you actually call.
Reviewed: tag { deny: [Net] }

Internal: tag { deny: [DB] }

Greeter: trait {
    greet: fn(self) -> String
}

Doc: struct {
    title: String
}

impl Doc.Greeter {
    greet: fn(self) -> String { "reviewing: {self.title}" }
}

// Tag on a return: callers see this string is marked reviewed / internal.
stamp_reviewed: fn(title: String) -> #Reviewed String { title.copy() }

stash_internal: fn(note: String) -> #Internal String { note.copy() }

// Tag on a parameter: the API documents what kind of string it expects.
announce: fn(title: #Reviewed String) -> String { "ship it: {title}" }

peek_internal: fn(note: #Internal String) -> String { "private: {note}" }

run: fn() {
    d: Doc{title: "spec"}
    print(d.greet())

    reviewed: stamp_reviewed(d.title)
    print(announce(reviewed))

    secret: stash_internal("editor notes")
    print(peek_internal(secret))
}
