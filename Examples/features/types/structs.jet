// 10 — Structs with methods (M3, S27/S29).
Point: struct {
    x: Float
    y: Float

    dist_sq: fn(self) -> Float { self.x * self.x + self.y * self.y }

    unit: fn() -> Point { {x: 1.0, y: 0.0} }
}

run: fn() {
    p: Point{x: 3.0, y: 4.0}
    print(p.dist_sq())
    u: Point.unit()
    print(u.x)
}
