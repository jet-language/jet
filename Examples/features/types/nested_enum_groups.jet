enum Damage {
    Physical {
        Blunt
        Pierce
    }
    Fire {
        Burn
        Scald
    }
    Cold
}

fn run() {
    d :: Damage.Fire.Burn
    if d == {
        .Physical -> { print("physical") }
        .Fire -> { print("fire") }
        .Cold -> { print("cold") }
    }

    if d == .Fire -> print("ancestor: fire")
    active := Tally<Damage>.new()
    &active.add(Damage.Fire.Burn)
    &active.add(Damage.Fire.Burn)
    &active.remove(Damage.Fire.Burn)
    print("burn count: {active.count(Damage.Fire.Burn)}")
    print("has burn: {active.has(Damage.Fire.Burn)}")
    &active.remove(Damage.Cold)
    print("cold count after absent remove: {active.count(Damage.Cold)}")
    print("has cold: {active.has(Damage.Cold)}")
    print("any fire: {active.any((d) -> d == .Fire)}")
    print("any physical: {active.any((d) -> d == .Physical)}")
    &active.remove(Damage.Fire.Burn)
    print("burn count after last remove: {active.count(Damage.Fire.Burn)}")
    print("any fire after last remove: {active.any((d) -> d == .Fire)}")
}
