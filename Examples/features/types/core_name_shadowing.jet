// A program's own declarations keep their identity when a loaded Core module
// declares types with the same names. `core.font` declares `enum FontStyle
// { Body Title Monospace }` and `struct FontFace { family size style }`; the
// declarations below reuse both names with a different variant order and a
// different field order. Folded `prep` constants, field reads and matches must
// all resolve to these declarations, never to Core's (#4003).
use core.font

enum FontStyle {
    Monospace
    Title
    Body
}

struct FontFace {
    size: Int
    style: FontStyle?
    family: String
}

FACES :: prep {
    [FontFace]{
        FontFace{family: "Serif", size: 12, style: Val(FontStyle.Body)},
        FontFace{family: "Code", size: 10, style: Val(FontStyle.Monospace)},
        FontFace{family: "Plain", size: 9, style: None},
    }
}

ORDER :: prep { [FontStyle]{FontStyle.Title, FontStyle.Body} }

fn describe(style: FontStyle) -> String {
    if style == {
        .Monospace -> "fixed-width"
        .Title -> "heading"
        .Body -> "running text"
    }
}

fn run() {
    loop face in FACES {
        if face.style == {
            .Val(style) -> print("{face.family} {face.size}pt {style} ({describe(style)})")
            .None -> print("{face.family} {face.size}pt unstyled")
        }
    }
    loop style in ORDER {
        print("{style}: {describe(style)}")
    }
}
