// Automatic equality holds across mutually recursive declarations: `Shape`
// reaches `Part` and `Part` reaches `Shape`, and both derive together.
Shape: enum {
    Leaf
    Node(parts: [Part])
}

Part: struct {
    name: String
    shape: Shape
}

Tree: enum {
    Tip
    Branch(children: [Tree])
}

Holder: struct {
    shape: Shape?
}

run: fn() {
    leaf: Shape.Leaf
    node: Shape.Node{parts: [Part]{Part{name: "x", shape: Shape.Leaf}}}
    same: Shape.Node{parts: [Part]{Part{name: "x", shape: Shape.Leaf}}}
    print(leaf == node)
    print(node == same)
    tip: Tree.Tip
    branch: Tree.Branch{children: [Tree]{Tree.Tip}}
    print(tip == branch)
    holder: Holder{shape: Val(node)}
    print(holder.shape != None)
}
