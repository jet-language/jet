// D-AUTHORITY-WORD2=E: Authority is the one rights value that crosses
// process, plugin, and session boundaries. It only narrows.
use core.process as process

struct Holder {
    grant: Authority
}

fn run() -[Exec, IO, Time.Wait]> {
    #FX(grant: Exec, IO, Time.Wait) {
        // Delegate the scoped grant for this call; do not store it in a
        // command builder that could retain it after the #FX region.
        result :: process.run(["echo", "authority"], grant) ?? panic("authority process")
        print(result.success)
    }
}
