// A unit that is Comparable by registration compares with `==` and `<`
// directly, and a record holding it gets a derived equality that compares
// that field.
struct Lap {
    split: Duration
    lane: Int
}

fn run() {
    print(500ms < 700ms)
    print(2s == 2000ms)
    fast :: Lap{split: 61s, lane: 4}
    again :: Lap{split: 61000ms, lane: 4}
    slow :: Lap{split: 64s, lane: 4}
    print(fast == again)
    print(fast == slow)
    print(fast.split < slow.split)
}
