use core.math as math

fn run() {
    g :: measurement(9.8, uncertainty: 0.1)
    t :: measurement(2.0, uncertainty: 0.05)
    t2 :: t * t
    h :: measurement(0.5, uncertainty: 0.0) * g * t2
    print(g)
    print(t)
    print(t2)
    print(h)
    // accessor methods
    print(h.value())
    print(h.uncertainty())
    print(math.sqrt(g))
    mass :: Kilogram.from_dalton_rounded(6.022140762e26dalton, .NearestEven, digits: 0) ?? panic("measured conversion")
    print(mass)
}
