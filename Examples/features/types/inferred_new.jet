// D-SHAPE3a=A: fresh hidden-state construction may omit its receiver when the
// surrounding expected type selects exactly one type. The explicit form remains.
Counter: struct {
    value: Int

    new: fn(value: Int) -> Counter { {value: value} }
}

Holder: struct {
    counter: Counter
}

fresh: fn(value: Int) -> Counter {
    (.new(value))
}

read: fn(counter: Counter) -> Int { counter.value }

run: fn() {
    counter: Counter.new(1)
    holder: Holder{counter: .new(2)}
    print(read(.new(3)))
    print("{counter.value}{holder.counter.value}{Counter.new(4).value}")
    print(fresh(5).value)
}
