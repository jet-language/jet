// Decimal is Comparable: a generic `T: Comparable` bound accepts exact
// decimal literals, and every relational operator compares by value.
fn less<T: Comparable>(left: T, right: T) -> Bool { left < right }

fn at_most<T: Comparable>(left: T, right: T) -> Bool { left <= right }

fn order<T: Comparable>(left: T, right: T) -> Ordering { left.compare(right) }

fn run() {
    print(less(1.0, 2.0))
    print(less(2.5, 2.50))
    print(at_most(2.5, 2.50))
    print(at_most(3.1, 3.05))
    print(order(0.1 + 0.2, 0.3) == Ordering.Equal)
    print(order(-1.5, 1.5) == Ordering.Less)
    print(1.5 < 2.0)
    print(10.01 > 10.1)
    print(19.99.compare(20.0) == Ordering.Less)
}
