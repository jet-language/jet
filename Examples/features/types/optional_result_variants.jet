// D-SHAPE3b: Optional and Result use one PascalCase variant law.
optional: fn(flag: Bool) -> Int? { if flag -> .Val(7) else -> .None }

result: fn(flag: Bool) -> Int { if flag -> .Ok(9) else -> .Err("no") }

run: fn() {
    if optional(true) == {
        .Val(value) -> { print(value) }
        .None -> { print(0) }
    }

    if result(false) == {
        .Ok(value) -> print(value)
        .Err(error) -> print(error.message)
    }
}
