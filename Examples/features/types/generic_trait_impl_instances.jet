// A trait impl on a generic struct applies to every instance: `Slot<Int>`,
// `Slot<String>` and `Slot<Slot<Int>>` each get their own `size` method.
struct Slot<T> { value: T }

impl Slot {
    fn get(self) -> T { self.value }
}

trait Counted { fn size(self) -> Int }

impl Slot.Counted {
    fn size(self) -> Int { 1 }
}

fn run() {
    number :: Slot<Int>{value: 41}
    word :: Slot<String>{value: "jet"}
    nested :: Slot<Slot<Int>>{value: Slot<Int>{value: 7}}
    print(number.get() + 1)
    print(word.get().len())
    print(nested.get().get())
    print(number.size() + word.size() + nested.size())
}
