// A type argument the struct never stores (a coordinate-space tag such as
// `Screen`) does not decide how its values copy: `.copy()` of a
// `Tagged<Screen, World>` copies the stored fields, and a stored argument
// still counts (`Holder<String>` clones its String).
struct Tagged<From, To> {
    scale: Float
    id: Int
}

struct Holder<T, Frame> {
    value: T
}

fn run() {
    a :: Tagged<Screen, World>{scale: 1.5, id: 7}
    b :: a.copy()
    print(b.scale)
    print(a == b)
    h :: Holder<String, World>{value: "kept"}
    g :: h.copy()
    print(g.value)
    print(h.value)
}
