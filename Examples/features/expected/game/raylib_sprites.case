# end_drawing writes the frame to JET_RAYLIB_CAPTURE as a PAM image; every
# tier must decode the PNG textures and rasterize the same bytes.
env: JET_RAYLIB_CAPTURE={work}/frame.pam
step: built
stdout: = raylib_sprites.out
file: frame.pam sha256 = "a43e35e587968916a3aadee779f911d0eb08ac7824550c374e508bc78e4c3aeb"
