// D-JOB-SUBCMD1=C — one job word, typed visibility, one callable function.
// `#Job` defaults to `.Dev`; `.Internal` stays callable from code, not argv.
// An environment may name these typed jobs in `on_enter`/`checks`; Git hooks
// use the same environment graph through `git_hooks_path` and native Git.
module env.dev {
    // D-ECO12=A: one typed package backs `jet fmt --lang nix`.
    formatter: pkgs.nixfmt
}

#Job(.Ship) fn ship_job() { print("ship") }

#Job(.Dev) fn dev_job() { print("dev") }

#Job fn default_job() { print("default-dev") }

#Job(.Internal) fn internal_job() { print("internal") }

fn run() {
    ship_job()
    dev_job()
    default_job()
    internal_job()
}
// --- expected output --------------------------------------------------
// ship
// dev
// default-dev
// internal
