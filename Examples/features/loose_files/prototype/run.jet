// Loose files: this folder has no package.jet, so it is an early multi-file
// prototype. Quoted imports resolve relative to the importing file, and a
// loose file may reach a sibling folder with `..` (see app/report.jet).
// Inside a package the package rules hold instead and `..` is E0602.
use "./app/report" as report

fn run() {
    print(report.headline("loose files"))
    print(report.total([2, 3, 5]))
}
