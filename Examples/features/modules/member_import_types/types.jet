// Declarations another file selects by name: a struct, an enum, a trait and a
// function all travel through one member import (D-MOD2).
struct Span {
    start: Int
    end: Int
}

enum Kind { Alpha Beta(Int) }

trait Named {
    fn label(self) -> String
}

fn make_span(start: Int, end: Int) -> Span { Span{start: start, end: end} }
