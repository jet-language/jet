// Declarations another file selects by name: a struct, an enum, a trait and a
// function all travel through one member import (D-MOD2).
pub struct Span {
    pub start: Int
    pub end: Int
}

pub enum Kind { Alpha Beta(Int) }

pub trait Named {
    fn label(self) -> String
}

pub fn make_span(start: Int, end: Int) -> Span { Span{start: start, end: end} }
