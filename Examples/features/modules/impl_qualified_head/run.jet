// D-IMPLDOT1: in an `impl` head, a package or module alias binds to the
// segment after it, so `Local.labels.Named` implements `labels.Named`.
use labels

struct Local { n: Int }

impl Local.labels.Named {
    fn label(self) -> String { "local {self.n}" }
}

fn run() {
    print(Local{n: 1}.label())
}
