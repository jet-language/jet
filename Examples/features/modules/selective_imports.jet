// D-CORE-USELIST1=A: `use mod.[a, b]` is the one member-list form after
// `use`, and `use alias :: mod.item` names a single item (#6542).
// Items are brought into scope directly; aliases resolve name conflicts.
// Grouped: `abs` imported under the local name `absolute`.
use {
    numeric.[clamp]
    absolute :: numeric.abs
    // The prefix may be a dotted path: `core.encoding.[json]` walks the same
    // members as `core.[encoding.json]`.
    core.encoding.[json]
}

module numeric {
    fn clamp(x: Int, lo: Int, hi: Int) -> Int {
        if x < lo -> return lo
        if x > hi -> return hi
        return x
    }

    fn abs(x: Int) -> Int {
        if x < 0 -> return -x
        return x
    }
}

fn run() {
    print(clamp(15, 0, 10))
    print(absolute(-7))
    print(json.to_string(Dyn.Text("jet")) ?? panic("JSON encode"))
}
