// 3A: a public constant is read qualified (`limits.MAX_ITEMS`) or brought
// into scope by name with a member import (`use limits.[GREETING]`). A `use`
// inside an inline module imports constants and types the same way.
use {
    limits
    limits.[GREETING]
}

// A bare path to a constant declares a constant (#6176): `MAX` reads
// `limits.MAX_ITEMS`.
MAX: limits.MAX_ITEMS

banner: module {
    use limits.[MAX_ITEMS]

    line: fn() -> String { "max {MAX_ITEMS}" }
}

run: fn() {
    print(limits.MAX_ITEMS)
    print(GREETING)
    print(limits.MAX_ITEMS * limits.doubled_step())
    print(banner.line())
    print(MAX + 1)
}
