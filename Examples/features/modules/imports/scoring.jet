// Hidden representation and nominal roles stay inside this module.
// Representation decision: Score and Offset are public nominal records with
// private Int fields. Their storage can change here without changing callers;
// no caller may read or construct `value` directly.
// Public contract: score(Int) -> Score, offset(Int) -> Offset, and
// letter(Score, Offset) -> String. The grade depends on score + offset:
// 90 or more is "A", 80 or more is "B", and lower is "C".
struct Score {
    priv value: Int
}

struct Offset {
    priv value: Int
}

fn score(raw: Int) -> Score {
    return Score{value: raw}
}

fn offset(raw: Int) -> Offset {
    return Offset{value: raw}
}

fn letter(score: Score, offset: Offset) -> String {
    adjusted :: score.value + offset.value
    return if {
        adjusted >= 90 -> "A"
        adjusted >= 80 -> "B"
        else -> "C"
    }
}
