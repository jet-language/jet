// Exposed-representation counterpart for the BIG-F12 contrast.
// Public contract: callers pass two undifferentiated Int values, so parameter
// names carry the score/offset meaning and swapping them remains type-correct.
exposed_letter: fn(score: Int, offset: Int) -> String {
    adjusted: score + offset
    return if {
        adjusted >= 90 -> "A"
        adjusted >= 80 -> "B"
        else -> "C"
    }
}

shout: fn(msg: String) -> String { "{msg}!" }
