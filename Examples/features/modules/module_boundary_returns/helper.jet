use core.time as time
use core.math as math

struct Secret { value: String }

#Error
enum FormError {
    Empty
}

fn double(value: Int) -> Int { value * 2 }

fn parse_count(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

fn checked_len(text: String) -> Int FormError! {
    if text == "" -> return Err(FormError.Empty)
    Ok(text.len())
}

fn reveal(secret: Secret) -> String { secret.value }

fn first<T>(items: [T]) -> T { items[0] }

struct Crate<T> { item: T }

fn unpack<T>(boxed: Crate<T>) -> T { boxed.item }

// A generic function specialized for its caller still reaches the Core
// functions its own module imports.
fn at_least_one<T>(items: [T]) -> Int { math.max(items.len(), 1) }

fn pause() -> time.Duration { 250ms }
