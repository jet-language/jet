use {
    time: core.time
    math: core.math
}

Secret: struct { value: String }

#Error
FormError: enum {
    Empty
}

double: fn(value: Int) -> Int { value * 2 }

parse_count: fn(text: String) -> Int Err! {
    if text == "" -> return Err("empty")
    Ok(text.len())
}

checked_len: fn(text: String) -> Int FormError! {
    if text == "" -> return Err(FormError.Empty)
    Ok(text.len())
}

reveal: fn(secret: Secret) -> String { secret.value }

first: fn<T>(items: [T]) -> T { items[0] }

Crate: struct<T> { item: T }

unpack: fn<T>(boxed: Crate<T>) -> T { boxed.item }

// A generic function specialized for its caller still reaches the Core
// functions its own module imports.
at_least_one: fn<T>(items: [T]) -> Int { items.len() + 1 - math.sign(items.len()) }

pause: fn() -> time.Duration { 250ms }
