TOKEN :: 7

fn plus(value: Int) -> Int { value + TOKEN }
fn identity<T>(value: T) -> T { value }
fn make() -> Record { Record{value: TOKEN} }
fn fold_record() -> Record { Record{value: 11} }
fn wrap(value: Int) -> Box<Int> { Box<Int>{value: value} }
fn unbox<T>(boxed: Box<T>) -> T { boxed.value }

// The file's own functions are local items of the package unit.
fn twice(value: Int) -> Int { value * 2 }
fn doubled_token() -> Int { twice(TOKEN) + twice(plus(0)) }
