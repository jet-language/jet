TOKEN: 7

plus: fn(value: Int) -> Int { value + TOKEN }
identity: fn<T>(value: T) -> T { value }
make: fn() -> Record { Record{value: TOKEN} }
fold_record: fn() -> Record { Record{value: 11} }
wrap: fn(value: Int) -> Box<Int> { Box<Int>{value: value} }
unbox: fn<T>(boxed: Box<T>) -> T { boxed.value }

// The file's own functions are local items of the package unit.
twice: fn(value: Int) -> Int { value * 2 }
doubled_token: fn() -> Int { twice(TOKEN) + twice(plus(0)) }
