// A package is one namespace, even when declarations live in sibling files.
struct Item { weight: Int }

fn first_or<T>(items: [T], fallback: T) -> T {
    if items.len() > 0 -> return items[0]
    fallback
}

fn count_where<T>(items: [T], keep: fn(T) -> Bool) -> Int {
    total := 0
    loop item in items {
        if keep(item) -> total += 1
    }
    total
}

fn run() {
    print("package members")
    print(inventory_total())
    print(qualified_total())
}
