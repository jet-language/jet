struct Label {
    text: String

    impl Marker {
        sites :: [.Function]
    }
}
struct Fast {
    impl Marker {
        group :: #[Label("fixed in this module"), Inline(.Always), Scalar]
    }
}

module inner {
    struct Trace {
        impl Marker {
            sites :: [.Function]
        }
    }
    struct Traced {
        impl Marker {
            group :: #[Trace, Inline]
        }
    }
}
