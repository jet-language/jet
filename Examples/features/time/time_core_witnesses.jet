use core.testing as testing
use core.time as time

// Deterministic source witnesses for the civil-time Core surface. Controlled
// wall time uses `testing.world`; stopwatch proof remains runtime-deferred.
fn run() {
    from_seconds :: time.from_unix_seconds(1710502245)
    from_microseconds :: time.from_unix_microseconds(1710502245123456)
    from_nanoseconds :: time.from_unix_nanoseconds(1710502245123456789)
    iso_week :: time.from_iso_week(2024, 9, 4)
    parsed_date :: time.parse("2024-02-29")
    parsed_iso_week :: time.parse_iso_week_date("2024-W09-4")
    parsed_time :: time.parse_time("12:34:56")
    parsed_zoned :: time.parse_zoned("2024-03-01T12:00:00+00:00[UTC]")
    period_value :: time.period(1, 2, 3)
    period_years_value :: time.period_years(2)
    local_value :: time.local_time(12, 34, 56)

    date_value :: time.new(2024, 2, 29)
    date_compare_rhs :: time.new(2024, 3, 1)
    date_equal_rhs :: time.new(2024, 2, 29)
    date_compare :: date_value.compare(date_compare_rhs)
    date_equal :: date_value.equal(date_equal_rhs)
    date_iso_week_year :: date_value.iso_week_year()
    date_format :: date_value.format("yyyy-MM-dd")
    date_format_checked :: date_value.format_checked("yyyy-MM-dd")
    date_subtract_period :: date_value.subtract_period(time.period(0, 1, 0))
    date_until :: date_value.until(time.new(2024, 3, 2), "day", "day", "trunc", 1)
    date_since :: date_value.since(time.new(2024, 2, 1), "day", "day", "trunc", 1)
    date_with :: date_value.with(2024, 2, 29, "reject")
    period_abs :: period_value.abs()
    period_add :: period_value.add(time.period(0, 1, 0))
    period_days :: period_value.days()
    period_is_zero :: period_value.is_zero()
    period_months :: period_value.months()
    period_negated :: period_value.negated()
    period_sign :: period_value.sign()
    period_sub :: period_value.sub(time.period(0, 1, 0))
    period_to_string :: period_value.to_string()
    period_total_in :: period_value.total_in("days", date_value)
    period_years :: period_value.years()

    local_millisecond :: local_value.millisecond()
    local_microsecond :: local_value.microsecond()
    local_nanosecond :: local_value.nanosecond()
    local_add_duration :: local_value.add_duration(90s)
    local_subtract_duration :: local_value.subtract_duration(90s)
    local_round :: local_value.round("minute", 1, "half_expand")
    local_truncate :: local_value.truncate("minute", 1)
    local_floor :: local_value.floor("minute", 1)
    local_ceil :: local_value.ceil("minute", 1)
    local_until :: local_value.until(time.local_time(13, 34, 56), "hour", "second", "trunc", 1)
    local_since :: local_value.since(time.local_time(11, 34, 56), "hour", "second", "trunc", 1)
    local_format :: local_value.format("HH:mm:ss")
    local_format_checked :: local_value.format_checked("HH:mm:ss")
    local_equal :: local_value.equal(time.local_time(12, 34, 56))
    local_compare :: local_value.compare(time.local_time(13, 34, 56))

    datetime_value :: time.datetime(2024, 2, 29, 12, 34, 56)
    datetime_add_nanoseconds :: datetime_value.add_nanoseconds(123456789)
    datetime_add_period :: datetime_value.add_period(time.period(0, 1, 0))
    datetime_compare :: datetime_value.compare(time.datetime(2024, 3, 1, 12, 34, 56))
    datetime_difference :: datetime_value.difference(time.datetime(2024, 3, 1, 12, 34, 56))
    datetime_equal :: datetime_value.equal(time.datetime(2024, 2, 29, 12, 34, 56))
    datetime_format :: datetime_value.format("yyyy-MM-dd HH:mm:ss")
    datetime_format_checked :: datetime_value.format_checked("yyyy-MM-dd HH:mm:ss")
    datetime_in_zone :: datetime_value.in_zone(time.zone("America/New_York") ?? panic("zone"))
    datetime_microsecond :: datetime_value.microsecond()
    datetime_millisecond :: datetime_value.millisecond()
    datetime_minute :: datetime_value.minute()
    datetime_second :: datetime_value.second()
    datetime_round :: datetime_value.round("minute", 1, "half_expand")
    datetime_since :: datetime_value.since(time.datetime(2024, 2, 28, 12, 34, 56), "day", "second", "trunc", 1)
    datetime_subtract_duration :: datetime_value.subtract_duration(90s)
    datetime_subtract_period :: datetime_value.subtract_period(time.period(0, 1, 0))
    datetime_to_unix_us :: datetime_value.to_unix_us()
    datetime_to_unix_ns :: datetime_value.to_unix_ns()
    datetime_truncate :: datetime_value.truncate("minute", 1)
    datetime_until :: datetime_value.until(time.datetime(2024, 3, 1, 12, 34, 56), "day", "second", "trunc", 1)
    datetime_with :: datetime_value.with(2024, 2, 29, 12, 34, 56, "reject")

    instant_value :: time.instant()
    instant_equal :: instant_value.equal(time.instant())
    instant_compare :: instant_value.compare(time.instant())

    zone_value :: time.zone("America/New_York") ?? panic("zone")
    zone_name :: zone_value.name()
    zone_next_transition :: zone_value.next_transition(datetime_value.to_unix_s())
    zone_previous_transition :: zone_value.previous_transition(datetime_value.to_unix_s())
    zone_start_of_day :: zone_value.start_of_day(time.new(2024, 2, 29))
    zone_hours_in_day :: zone_value.hours_in_day(time.new(2024, 2, 29))

    zoned_value :: time.zoned(datetime_value, zone_value)
    zoned_compare :: zoned_value.compare(time.zoned(time.datetime(2024, 3, 1, 12, 34, 56), zone_value))
    zoned_equal :: zoned_value.equal(time.zoned(time.datetime(2024, 2, 29, 12, 34, 56), zone_value))
    zoned_format_checked :: zoned_value.format_checked("yyyy-MM-dd HH:mm:ss VV XXX")
    zoned_format_rfc9557 :: zoned_value.format_rfc9557()
    zoned_next_transition :: zoned_value.next_transition()
    zoned_previous_transition :: zoned_value.previous_transition()
    zoned_since :: zoned_value.since(time.zoned(time.datetime(2024, 2, 28, 12, 34, 56), zone_value), "day", "second", "trunc", 1)
    zoned_subtract_duration :: zoned_value.subtract_duration(90s)
    zoned_subtract_period :: zoned_value.subtract_period(time.period(0, 1, 0))
    zoned_start_of_day :: zoned_value.start_of_day()
    zoned_until :: zoned_value.until(time.zoned(time.datetime(2024, 3, 1, 12, 34, 56), zone_value), "day", "second", "trunc", 1)
    zoned_with_time :: zoned_value.with_time(time.local_time(13, 34, 56), "compatible")
    zoned_with_zone :: zoned_value.with_zone(time.utc())
    zoned_hours_in_day :: zoned_value.hours_in_day()
    testing.world(world -> {
        controlled_before :: time.now_utc()
        world.advance(2s)
        controlled_after :: time.now_utc()
    })
    // `start` has no deterministic-world provider; keep its real stopwatch
    // lifecycle outside `testing.world`. Runtime proof remains deferred.
    stopwatch :: time.start()

    print("time_core_witnesses")
}