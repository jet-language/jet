// Duration `+` and `-` (#5824): the exact sum or difference of the two
// nanosecond counts; compound `+=` and `-=` mean the same.
fn run() {
    a :: 1500ms
    b :: 250ms
    print((a + b).in(.Milliseconds))
    print((a - b).in(.Milliseconds))
    print((b - a).in(.Milliseconds))
    total := 5ms
    total += a
    total += b
    print(total.in(.Milliseconds))
    total -= 1s
    print(total.in(.Milliseconds))
}
