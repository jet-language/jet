// A DateTime answers its calendar parts directly; `weekday()` counts from
// Sunday = 0, the same as `LocalDate.weekday()`.
use core.time as time

fn run() {
    moment :: time.from_unix_ms(1700000000000)
    print(moment)
    print("{moment.year()}-{moment.month()}-{moment.day()} weekday {moment.weekday()}")
    leap :: time.datetime(2024, 2, 29, 23, 59, 59)
    print("{leap.year()}-{leap.month()}-{leap.day()} weekday {leap.weekday()}")
    print(leap.weekday() == leap.date().weekday())
    epoch :: time.from_unix_ms(0)
    print("{epoch.year()}-{epoch.month()}-{epoch.day()} weekday {epoch.weekday()}")
    before :: time.from_unix_ms(-1)
    print("{before.year()}-{before.month()}-{before.day()} weekday {before.weekday()}")
}
