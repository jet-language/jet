// A borrowed list and a parameter index take the checked Int-to-index route.
// Projecting the argument out of another list must use that same route.
fn remove_at(xs: &[Int], position: Int) Never! {
    slot :: &xs.remove(position, .Slot) ?? -1
    print(slot)
}

fn run() {
    xs := [Int]{10, 20, 30, 40}
    positions :: [Int]{1}
    remove_at(&xs, positions[0])
    print(xs)
}
