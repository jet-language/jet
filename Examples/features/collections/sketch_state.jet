// core.data.sketch empty and merge are Core source: versioned, length-delimited
// shard frames. Merge keeps shard order, flattens framed input, and carries
// unframed input as one opaque shard.
use sketch :: core.data.sketch

fn run() {
    empty :: sketch.empty()
    print(empty)
    print(sketch.merge(empty, empty))
    one :: sketch.merge(empty, "a;b")
    print(one)
    two :: sketch.merge(one, "héllo:1")
    print(two)
    print(sketch.merge(two, one))
    print(sketch.merge("", ""))
}
