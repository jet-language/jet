// A named function passed by name as a callback value: a `sort_by`
// comparator, a `map` transform and a `filter` test, each building a list
// inside its body. The comparator returns `Ordering Never!`; the sort takes
// each Ordering it hands back, so sorting again and again leaves every list
// intact.

by_letters: fn(left: String, right: String) -> Ordering Never! {
    left_letters: left.split("").to_list()
    right_letters: right.split("").to_list()
    left_letters.join("") <=> right_letters.join("")
}

shout: fn(word: String) -> String Never! {
    pieces: [String]{word, "!"}
    pieces.join("")
}

has_vowel: fn(word: String) -> Bool Never! {
    letters: word.split("").to_list()
    letters.contains("a") || letters.contains("e") || letters.contains("o")
}

run: fn() {
    letters := [String]{"c", "a", "b"}
    &letters.sort_by(by_letters)
    print(letters.join(","))
    loop round in 0..<32 {
        words := [String]{"note", "cab", "sky", "bee"}
        &words.sort_by(by_letters)
        loud: words.map(shout)
        kept: words.filter(has_vowel)
        if round == 31 -> print("{words.join(",")}|{loud.join(",")}|{kept.join(",")}")
    }
}
