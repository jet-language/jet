// D-COLLBREADTH1=A: Queue<T> — ring-buffer double-ended queue.
// Construct with Queue.new() / Queue.init([...]); push/pop both ends.
fn run() {
    d := Queue.new()
    &d.push_back(<: 1..3 :>)
    &d.push_front(0)
    print("len: {d.len()}")
    print("is_empty: {d.is_empty()}")
    print("cap_ok: {d.capacity() >= d.len()}")
    if d.peek_front() == .Val(n) -> print("front: {n}")
    if d.peek_back() == .Val(n) -> print("back: {n}")
    if &d.pop_front() == .Val(n) -> print("popped front: {n}")
    print("len after pop: {d.len()}")
    if &d.pop_back() == .Val(n) -> print("popped back: {n}")
    print("len after two pops: {d.len()}")

    e := Queue.init([10, 20, 30, 40])
    print("init len: {e.len()}")
    print("contains 20: {e.contains(20)}")
    print("contains 99: {e.contains(99)}")
    if e.get(1) == .Val(n) -> print("get1: {n}")
    print("join: {e.join(",")}")
    &e.delete(20)
    print("after delete: {e.to_list()}")
    &e.reverse()
    print("after reverse: {e.to_list()}")
    rest := &e.split(1)
    print("after split left: {e.to_list()}")
    print("after split right: {rest.to_list()}")

    // Borrowed constructors snapshot owning elements; membership must compare
    // their contents rather than the native String-handle addresses.
    source := ["alpha", "beta"]
    words := Queue.init(source)
    &source.push("gamma")
    assert(words.to_list() == ["alpha", "beta"])
    assert(words.contains("alpha"))
    &words.delete("alpha")
    assert(words.to_list() == ["beta"])
    popped :: &words.pop_front()
    if popped == {
        .Val(value) -> assert(value == "beta")
        .None -> assert(false)
    }
    assert(words.is_empty())

    // Split clamps exact Int bounds, including values beyond machine words.
    bounded := Queue.init([1, 2])
    beyond := &bounded.split(100000000000000000000000000000000)
    assert(bounded.len() == 2)
    assert(beyond.is_empty())
    whole := &bounded.split(-1)
    assert(bounded.is_empty())
    assert(whole.to_list() == [1, 2])
}
