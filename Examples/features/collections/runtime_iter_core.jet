// Native slot-ABI cutover: scalar, owning, nested, failure and cursor paths.
fn optional_number(n: Int) -> Int? {
    if n % 2 == 0 -> Val(n * 10) else -> None
}

fn run() {
    xs :: [1, 2, 3, 4, 5]
    assert_eq(xs.lazy().take(0).to_list(), [Int]{})
    assert_eq(xs.lazy().take(3).to_list(), [1, 2, 3])
    assert_eq(xs.lazy().skip(2).to_list(), [3, 4, 5])
    assert_eq(xs.lazy().step_by(2).to_list(), [1, 3, 5])
    assert_eq(xs.lazy().filter(n -> n % 2 == 0).map(n -> n * 10).to_list(), [20, 40])
    assert_eq(xs.lazy().take_while(n -> n < 3).to_list(), [1, 2])
    assert_eq(xs.lazy().skip_while(n -> n < 3).to_list(), [3, 4, 5])
    assert_eq([1, 1, 2, 1].lazy().dedup().to_list(), [1, 2, 1])
    assert_eq([2, 4, 1, 3, 8].lazy().dedup_by(n -> n % 2).to_list(), [2, 1, 8])
    assert_eq([1, 2].lazy().repeat(2).to_list(), [1, 2, 1, 2])
    assert_eq([1, 2].lazy().cycle(3).to_list(), [1, 2, 1])
    assert_eq(xs.lazy().drop_last(2).to_list(), [1, 2, 3])
    assert_eq(xs.lazy().drop_last(99).to_list(), [Int]{})
    assert(xs.lazy().is_sorted())
    assert(![2, 1].lazy().is_sorted())
    assert([3, 2, 1].lazy().is_sorted_by(n -> -n))
    assert_eq(xs.lazy().last_index_of(3), Val(2))
    assert_eq(xs.lazy().last_index_of(9), None)
    assert_eq(xs.lazy().compare([1, 2, 3, 4]), 1)
    assert_eq(xs.lazy().compare([1, 2, 3, 4, 5]), 0)
    assert_eq(xs.lazy().compare([1, 2, 3, 4, 6]), -1)
    assert_eq(xs.lazy().len(), 5)
    assert(!xs.lazy().is_empty())
    assert([Int]{}.lazy().is_empty())
    assert_eq(xs.lazy().first(), Val(1))
    held := xs.lazy()
    assert_eq(&held.next(), Val(1))
    assert_eq(&held.next(), Val(2))
    assert_eq(^held.to_list(), [3, 4, 5])
    assert_eq([[1, 2], [Int]{}, [3]].lazy().flatten().to_list(), [1, 2, 3])
    assert_eq([1, 2].lazy().flat_map(n -> [n, n + 10]).to_list(), [1, 11, 2, 12])
    assert_eq(xs.lazy().filter_map(n -> optional_number(n)).to_list(), [20, 40])
    assert_eq([Int?]{Val(1), Val(2)}.lazy().try_collect(), Val([1, 2]))
    assert_eq([Int?]{Val(1), None, Val(3)}.lazy().try_collect(), None)
    words :: ["ant", "ant", "bee", "ant"]
    assert_eq(words.lazy().dedup().to_list(), ["ant", "bee", "ant"])
    assert_eq(words.lazy().join("|"), "ant|ant|bee|ant")
    assert_eq(words.lazy().repeat(2).take(5).to_list(), ["ant", "ant", "bee", "ant", "ant"])
    assert_eq("a,,b,".split(",").to_list(), ["a", "", "b", ""])
    assert_eq("a,,b,".rsplit(",").to_list(), ["a", "", "b", ""])
    assert_eq([I64]{9223372036854775807, 1, -9223372036854775807, -1}.lazy().average(), 0.0)
    assert_eq([U64]{18446744073709551615, 18446744073709551615}.lazy().average(), 18446744073709551616.0)
    assert_eq([Float]{1.0, 2.0, 6.0}.lazy().average(), 3.0)
    assert_eq([Float]{}.lazy().average(), 0.0)
    // Borrowed loop bindings keep an owning element live until advance.
    loop word in ["alpha", "beta"].lazy() -> assert(word.len() > 0)
    loop value in xs.lazy() -> assert(value > 0)
    print("collections runtime")
}
