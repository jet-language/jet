// Card #3372 / CORE-F060: each collection family keeps only the order,
// size and reverse facts it really has.
// - Set is hash-backed: iteration order is unspecified and not repeatable
//   across programs, so it is printed only after `sort()`.
// - Map ([K:V]) is an ordered map: keys() and values() follow key order,
//   not insertion order ("pear" is inserted first but listed last).
// - Rank iterates in comparator (ascending) order; first/last follow it.
// - PriorityQueue exposes peek/pop (highest first) and to_sorted_list; it
//   offers no raw iteration, so nothing promises a sorted raw order.
// - Queue reads both ends; reverse is a Queue operation, not an iterator fact.
// - keys()/values() are plain iterators: after a filter the result size is
//   known only by counting.
// - A Set operation returns a fresh Set; it inherits no order from its inputs.
// Keys and set elements are never writable through iteration
// (tests/ui/iter_family_mutable_key.jet).
fn run() {
    s := Set.from([30, 10, 20])
    set_items := s.to_list()
    &set_items.sort()
    print("set sorted: {set_items}")
    print("set len: {s.len()}")

    m := [String:Int]{"pear": 3, "apple": 1, "fig": 2}
    print("map keys in key order: {m.keys().to_list()}")
    print("map values in key order: {m.values().to_list()}")

    r := Rank.from([30, 10, 20])
    &r.add(15)
    print("rank order: {r.to_list()}")
    print("rank first/last: {r.first() ?? -1} {r.last() ?? -1}")

    pq := PriorityQueue.from([4, 9, 1, 7])
    print("pq peek: {pq.peek() ?? -1}")
    print("pq sorted list: {pq.to_sorted_list()}")
    print("pq pop: {&pq.pop() ?? -1} then {&pq.pop() ?? -1}")
    print("pq len after pops: {pq.len()}")

    q := Queue.init([1, 2, 3])
    print("queue front/back: {q.peek_front() ?? -1} {q.peek_back() ?? -1}")
    &q.reverse()
    print("queue reversed: {q.to_list()}")

    print("keys len: {m.keys().to_list().len()}")
    long_keys :: m.keys().filter((k: String) -> k.len() > 3).to_list()
    print("filtered keys len: {long_keys.len()}")

    t :: Set.from([20, 40])
    joined :: s.union(t)
    union_items := joined.to_list()
    &union_items.sort()
    print("union sorted: {union_items}")
    print("union len: {joined.len()}")
}
