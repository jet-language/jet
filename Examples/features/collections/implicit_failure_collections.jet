// Implicit failure rows propagate through collection callbacks.
parse_default: fn(s: String) -> Int { return Int.parse(s) ?? panic("bad integer") }

keep_default: fn(s: String) -> Bool { return parse_default(s) > 1 }

run: fn() {
    nums: ["1", "2", "3"].map(s -> parse_default(s))
    selected: ["1", "2", "3"].filter(s -> keep_default(s))
    print(nums)
    print(selected)
}
