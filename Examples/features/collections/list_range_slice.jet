// D-RANGE-VALUE1: list range slices copy the selected items. `a..b` includes
// `b`, `a..<b` stops before it, and a stored Range works the same way.
fn fill_window(xs: &[U8], n: Int) Never! {
    window :: &xs[0..<n]
    window[0] = U8{9}
}

fn run() {
    xs :: [Int]{10, 20, 30, 40, 50}
    r :: 1..<4
    print("{xs[1..3]}")
    print("{xs[1..<3]}")
    print("{xs[r]}")
    print("{xs[2..<2]}")
    buffer :: [U8#1]{7}
    selected :: buffer[0..<1]
    print(selected.len())
    fixed := [U8#3]{1, 2, 3}
    empty :: fixed[2..<2]
    print(empty.len())
    fill_window(&fixed, 1)
    print(fixed[0])
    name :: "report.toml"
    print("{name.ends_with(".toml")} {name.starts_with("rep")} {name.ends_with(".json")}")
}
