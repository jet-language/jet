// 181 — D-INDEX-HOOK: expert `mytype[k]` via Index + IndexMut
Tile: struct {
    value: Int
}

Grid: struct {
    cells: [Tile]
}

impl Grid.Index {
    Key: Int
    Value: Int

    get: fn(self, k: Int) -> Int? {
        if k < 0 || k >= self.cells.len() -> return None
        return Val(self.cells[k].value)
    }
}

impl Grid.IndexMut {
    set: fn(&self, k: Int, v: Int) {
        if k >= 0 && k < self.cells.len() -> self.cells[k].value = v
    }
}

run: fn() {
    g := Grid{cells: [Tile]{{value: 1}, {value: 2}}}
    g[1] = 99
    print("g[1]: {g[1]}")
}
