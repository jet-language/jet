// core.math.combinatorics generates over any element type; list methods
// cover the sequence work (take_while, windows, chunks, scan, ...).
use {
    combo: core.math.combinatorics
    math: core.math
}

run: fn() {
    letters: [String]{"a", "b", "c"}
    print(combo.permutations(letters, 2))
    print(combo.combinations([Int]{1, 2, 3}, 2))
    print(combo.combinations_with_replacement([String]{"x", "y"}, 2))
    print(combo.product([Bool]{true, false}, 2))
    print(combo.cartesian([String]{"a", "b"}, [String]{"x", "y"}))
    print(combo.powerset([String]{"a", "b"}))
    print(combo.chain([String]{"a"}, [String]{"b", "c"}))
    print(combo.compress(letters, [Bool]{true, false, true}))
    print(combo.unique([String]{"b", "a", "b", "c", "a"}))
    print(combo.tee([String]{"a", "b"}, 2))
    print(combo.zip_longest(letters, [String]{"x"}, "-"))
    print(combo.count_from(1, 2, 3))
    print(combo.multinomial([Int]{2, 1}) ?? -1)
    print(combo.rising_factorial(3, 2) ?? -1)
    print(math.binomial(5, 2) ?? -1)
    print([Int]{1, 2, 3, 4}.windows(2).to_list())
}
