use core.data.arrow as arrow

// D-COLUMNAR-BOUNDARY1=A: a foreign adapter supplies this already-checked
// typed owner. The ordinary query path remains the only aggregation path.
fn consume(batch: arrow.DataArrowBatch<()>) {
    imported :: arrow.import(^batch)
    query :: arrow.query(^imported) ?? panic("Arrow query")
    rows :: query.collect() ?? panic("collect Arrow rows")
    print("arrow rows={rows.len()}")
}

fn run() {
    // A host adapter calls consume with a ColumnBatch<Row>. Jet code does not
    // manufacture C pointers, release children, or parse Arrow IPC files.
    print("arrow owner: checked shared lifetime")
    print("arrow owner: explicit copy and no-copy refusal")
}
