// D-INDEXOF1=A: `index_of(item)` on a list or a view returns the position of
// the first item equal to `item`, or None. Position lookup is `get(i)`.
fn run() {
    if ["a"].index_of("a") == .Val(at) {
        print("Val({at})")
    }
    names :: ["ada", "bo", "ada"]
    print(names.index_of("ada"))
    print(names.index_of("bo") ?? -1)
    print(names.index_of("cy") ?? -1)
    if names.index_of("cy") == .None {
        print("cy: None")
    }
    numbers :: [8, 15, 23, 15]
    print(numbers.index_of(15))
    print(numbers.index_of(42) ?? -1)
    if numbers.index_of(42) == .None {
        print("42: None")
    }
    print(numbers.get(1) ?? -1)
    window :: numbers[1..3]
    print(window.index_of(23) ?? -1)
    print(window.index_of(8) ?? -1)
    tags :: names[1..2]
    print(tags.index_of("ada") ?? -1)
    print(tags.index_of("cy") ?? -1)
}
