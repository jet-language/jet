package: {
    name: "deterministic_world"
    authority: { allow: [IO, Time] }
}

use {
    testing: core.testing
    time: core.time
}

work: fn() { time.sleep(40ms) ?? return }

run: fn() {
    testing.world(
    world -> {
        slow: task work() ?? return
        world.advance(40ms)
        ^slow.join() ?? return
    },
    )
    print("done")
}
