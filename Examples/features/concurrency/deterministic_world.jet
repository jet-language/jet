package {
    name: "deterministic_world"
    authority: { allow: [IO, Time] }
}

use {
    testing :: core.testing
    time :: core.time
}

fn work() { time.sleep(40ms) ?? return }

fn run() {
    testing.world(
    world -> {
        slow :: task work() ?? return
        world.advance(40ms)
        ^slow.join() ?? return
    },
    )
    print("done")
}
