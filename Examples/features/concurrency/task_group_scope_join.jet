// A task started inside `task.group` and never joined still runs to
// completion: the group's scope end joins it before control leaves the
// block, so the child's output lands between the owner's last line and
// the line after the group.
package {
    name: "task_group_scope_join"
    authority: { holds: { allow: [IO, Mem.Alloc, Time.Wait] } }
}

use core.time as time

fn slow(value: Int) -> Int {
    time.sleep(50ms)
    print("slow {value} committed")
    value
}

fn run() {
    task.group owner {
        pending :: task slow(9)
        print("owner closing")
    }
    print("owner joined")
}
