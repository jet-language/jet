package {
    name: "pipeline"
    authority: { allow: [IO, Mem.Alloc, Time.Wait] }
}

fn run() {
    { sender: s1, receiver: ch } :: channel<Int>()
    s2 :: s1.copy()
    s3 :: s1.copy()
    _ :: task.all {s1.send(30), s2.send(10), s3.send(20)} ?? panic("task sends failed")
    s1.close()
    s2.close()
    s3.close()
    results := [Int]{}
    loop value in ch -> &results.push(value)
    &results.sort()
    loop x in results -> print(x)
}
