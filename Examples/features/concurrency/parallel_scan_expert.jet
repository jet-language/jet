// Expert variant of parallel_scan.jet (D-EXAMPLES-SHORTPATH1=A).
// Manual channels + spawn + join. Prefer `para_map` in the flagship.
package: {
    name: "parallel_scan_expert"
    authority: { allow: [Exec.Args, FS.Read, FS.Write, IO, Mem.Alloc, Time.Wait] }
}

use {
    fs: core.files
    process: core.process
}

count_lines: fn(text: String) -> Int { text.lines().len() }

scan_one: fn(file_path: String) -> String {
    text: fs.read(file_path) ?? return "{file_path}: unreadable"
    lines: count_lines(text)
    return "{file_path}: {lines} lines, {text.len()} chars"
}

default_paths: fn() -> [String] {
    a: Path.from("/tmp").join("jet_parallel_scan_a.txt").to_string()
    b: Path.from("/tmp").join("jet_parallel_scan_b.txt").to_string()
    _: fs.write(a, "one\ntwo\n")
    _: fs.write(b, "alpha\nbeta\ngamma\n")
    return [a, b]
}

paths_from_args: fn() -> [String] { return process.args() }

gather_paths: fn() -> [String] {
    from_args: paths_from_args()
    if from_args.len() > 0 -> return from_args
    return default_paths()
}

scan_parallel: fn(paths: [String]) -> [String] {
    { sender, receiver: ch }: channel<String>()
    workers := [Task<()>]{}
    loop file_path in paths {
        tx: sender.copy()
        file: file_path.copy()
        workers.push(
        task {
            tx.send(scan_one(file))
        },
        )
    }
    loop workers.len() > 0 {
        worker: workers.pop() ?? panic("missing worker")
        worker.join() ?? panic("worker failed")
    }
    sender.close()
    results := [String]{}
    loop value in ch -> results.push(value)
    results.sort()
    return results
}

run: fn() {
    paths: gather_paths()
    if paths.len() == 0 {
        print("no files to scan")
        return
    }
    print("scanning {paths.len()} files...")
    print("")
    parallel: scan_parallel(paths)
    loop line in parallel -> print(line)
    print("")
    print("done — {paths.len()} files scanned in parallel")
}
