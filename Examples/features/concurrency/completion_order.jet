// D-CONCCOMB1/A: race/any use task completion order, not task-list order.
package: {
    name: "completion_order"
    authority: { allow: [IO, Mem.Alloc, Time] }
}

use time: core.time

slow_one: fn() -> Int {
    time.sleep(100ms)
    return 1
}

fast_seven: fn() -> Int { 7 }

run: fn() {
    time.sleep(200ms)
    print(task.race {slow_one(), fast_seven()} ?? panic("race failed"))
    time.sleep(200ms)
    print(task.any {slow_one(), fast_seven()} ?? panic("any failed"))
}
