// 167 — D-CONC-SPAWN1=D: race returns first success; losers cancel at runtime.
package: {
    name: "race_cancel"
    authority: { allow: [IO, Mem.Alloc, Time] }
}

use time: core.time

slow_one: fn() -> Int {
    time.sleep(200ms)
    return 1
}

fast_seven: fn() -> Int { 7 }

run: fn() {
    winner: task.race {slow_one(), fast_seven()} ?? panic("race failed")
    print(winner)
}
