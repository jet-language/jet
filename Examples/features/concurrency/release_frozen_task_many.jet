package: {
    name: "release_frozen_task_many"
    authority: { allow: [IO, Mem.Alloc, Time.Wait] }
}

Snapshot: struct {
    left: Int
    right: String
}

left: fn(s: Snapshot) -> Int { s.left }

text_len: fn(s: Snapshot) -> Int { s.right.len() }

combined: fn(s: Snapshot) -> Int { s.left + s.right.len() }

run: fn() {
    source := Snapshot{left: 41, right: "stable"}
    frozen: freeze(source)
    task.group g {
        results: task.all {left(frozen), left(frozen), text_len(frozen), combined(frozen)} ?? panic("task.all failed")
        print(results[0], results[1], results[2], results[3])
    }
}
