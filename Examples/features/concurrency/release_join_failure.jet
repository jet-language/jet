package: {
    name: "release_join_failure"
    authority: { allow: [IO, Time.Wait] }
}

value: fn(n: Int) -> Int { n }

boom: fn() -> Int {
    panic("boom")
    return 0
}

run: fn() {
    task.group joined {
        one: task value(1)
        two: task value(2)
        three: task value(3)
        four: task value(4)
        five: task value(5)
        six: task value(6)
        seven: task boom()
        eight: task value(8)

        print(^one.join() ?? 0)
        print(^two.join() ?? 0)
        print(^three.join() ?? 0)
        print(^four.join() ?? 0)
        print(^five.join() ?? 0)
        print(^six.join() ?? 0)
        print(^seven.join() ?? 99)
        print(^eight.join() ?? 0)
    }
}
