package: {
    name: "context_task_inherit"
    authority: { allow: [IO, Time, Time.Wait] }
}

use time: core.time

// A task carries the context it was spawned under, even after the spawning
// `#Context` block ends; tasks spawned before or after the block do not.

nap: fn(value: Int) -> Int {
    time.sleep(1ms)
    value
}

spawn_expired: fn() -> Task<Int> {
    #Context(deadline: 0) {
        return task nap(0)
    }
    task nap(-1)
}

report: fn(name: String, ^handle: Task<Int>) {
    if ^handle.join() == {
        .Ok(value) -> { print("{name}: finished {value}") }
        .Err(error) -> {
            if error == {
                .DeadlineBlown -> { print("{name}: deadline") }
                .Cancelled -> { print("{name}: cancelled") }
                .Panicked(reason) -> { print("{name}: panic {reason}") }
            }
        }
    }
}

run: fn() {
    before: task nap(1)
    inside: spawn_expired()
    after: task nap(2)
    report("inside", ^inside)
    report("before", ^before)
    report("after", ^after)
}
