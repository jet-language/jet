// #3787: a task spawned inside `task.group` runs its body (its output appears
// between the owner's lines) and the owner continues after the group closes.
package {
    name: "task_group_worker_output"
    authority: { holds: { allow: [IO, Time.Wait] } }
}

fn run() {
    print("owner before")
    task.group g {
        worker :: task {
            print("worker ran")
        }
        worker.join() ?? panic("worker failed")
    }
    print("owner after")
}
