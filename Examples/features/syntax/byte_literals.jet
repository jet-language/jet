// D-BYTELIT1=B: byte text uses the existing `[U8]{"…"}` typed literal.
byte_len: fn(bytes: [U8]) -> Int { bytes.len() }

run: fn() {
    magic: [U8]{"JGB1\x00\xFF"}
    fixed: [U8#4]{"JGB1"}
    print(byte_len([U8]{"\xFF\xFF"}))
    print(magic[0])
    print(magic[4])
    print(magic[5])
    print(fixed[3])
}
