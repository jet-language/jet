// D-MEM1: both access markers (plus plain read) in one program.
// plain T = read; &T = write; ^T = take/move.
Account: struct {
    owner: String
    balance: Int
}

// plain read — no sigil
check: fn(a: Account) -> Bool { a.balance > 0 }

print_balance: fn(a: Account) { print("{a.owner}: {a.balance}") }

// &Account = edit in place
deposit: fn(a: &Account, amount: Int) { a.balance += amount }

// ^Account = consume; return a log string
finish_account: fn(a: ^Account) -> String { "closed {a.owner} (final balance: {a.balance})" }

run: fn() {
    acc := Account{owner: "Alice", balance: 100}
    print(check(acc))  // plain read
    print_balance(acc)  // plain read
    deposit(&acc, 50)  // & write
    print_balance(acc)  // plain read again
    log: finish_account(^acc)  // ^ take; acc consumed
    print(log)
}
