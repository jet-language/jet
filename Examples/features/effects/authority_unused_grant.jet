// Application authority, a grant the program never uses: the written row
// allows Net, which nothing here touches. A grant is an upper bound, not a
// claim of use, so the program runs.
package {
    name: "authority_unused_grant"
    authority: { holds: { allow: [Env, IO, Net] } }
}

use core.sys as sys

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
}
