// A module cap: `#FX(…)` on a module bounds every function inside it, the
// function-row rule applied to a whole module. `pricing` may only print, and
// `audit` inside it also denies files and the network. Every function keeps
// inside both caps, so the program runs; a call that broke one would stop the
// check with E0712 (outside the ceiling) or E0749 (denied).
#FX(IO)
module pricing {
    fn total(prices: [Int]) -> Int {
        sum := 0
        loop price in prices -> sum += price
        sum
    }

    fn report(prices: [Int]) { print("total: {total(prices)}") }

    #FX(!FS, !Net)
    module audit {
        fn check(total: Int) -> Bool { total > 0 }
    }
}

fn run() {
    prices :: [Int]{3, 4, 5}
    pricing.report(prices)
    print("audited: {pricing.audit.check(pricing.total(prices))}")
}
