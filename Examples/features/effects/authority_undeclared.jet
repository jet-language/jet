// Application authority, no declaration: without a package block a file holds
// only the beginner default (IO, Mem.Alloc, Exec.Args). Reading an environment
// variable needs Env, so the run stops with E1803 before the program starts;
// with no terminal to ask, the Fix names the `--allow` flag and the complete
// row for a leading package block.
use core.sys as sys

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
}
