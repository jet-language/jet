// Application authority, command-line denial: its golden runs it as
// `jet run -A --deny=Env authority_deny_flag.jet`
// (expected/effects/authority_deny_flag.case). `-A` grants every right for
// the run, but a deny wins over every grant, so the run stops with E1803
// before the program reads the environment.
use core.sys as sys

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
}
