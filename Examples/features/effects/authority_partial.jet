// Application authority, partial declaration: the written row adds Env to the
// beginner floor, but the program also reads the clock. E1803 names exactly
// the missing effect, Time, and the Fix gives the row to add.
package {
    name: "authority_partial"
    authority: { allow: [Env] }
}

use {
    sys :: core.sys
    time :: core.time
}

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
