// Application authority, partial declaration: the written row grants Env and
// IO, but the program also reads the clock. E1803 names exactly the missing
// effect, Time, and the Fix gives the complete row to write.
package {
    name: "authority_partial"
    authority: { holds: { allow: [Env, IO] } }
}

use core.sys as sys
use core.time as time

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
    print("clock runs: {time.instant().elapsed_millis() >= 0}")
}
