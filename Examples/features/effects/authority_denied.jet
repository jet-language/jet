// Application authority, a written deny: a deny wins over every grant,
// including `-A`. This program reads an environment variable, which its own
// package block denies, so the run stops with E1803 naming the denied effect
// before the program starts.
package {
    name: "authority_denied"
    authority: { holds: { allow: [Env, IO], deny: [Env] } }
}

use core.sys as sys

fn run() {
    print("HOME set: {sys.get("HOME") != None}")
}
