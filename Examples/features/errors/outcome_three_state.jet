// D-OUTCOME-SHAPE1=A: a `User? DBError!` value has three states, matched as
// `.Val(user)`, `.None` and `.Err(e)`. Only the failure passes up by itself;
// a missing user is ordinary data that never skips code.
struct User {
    name: String
}

#Error
enum DBError {
    Down
}

fn read_user(id: Int) -> User? DBError! {
    if id == 0 -> return Err(DBError.Down)
    if id == 7 -> return Ok(Val(User{name: "priya"}))
    Ok(None)
}

// Value form: each of the three states answers.
fn describe(id: Int) -> String {
    if read_user(id) == {
        .Val(user) -> "user {user.name}"
        .None -> "no such user"
        .Err(_) -> "database down"
    }
}

// Statement form.
fn report(id: Int) {
    if read_user(id) == {
        .Val(user) -> print("found {user.name}")
        .None -> print("nobody with id {id}")
        .Err(_) -> print("lookup {id} failed")
    }
}

// No `.Err` arm here: the failure passes up to the caller by itself. A
// missing user stays a value, so the line after the lookup still runs.
fn greet(id: Int) -> String? DBError! {
    user :: read_user(id)
    print("looked up {id}")
    Ok(user?.name)
}

fn run() {
    loop id in [7, 3, 0] -> print(describe(id))
    loop id in [7, 3, 0] -> report(id)
    loop id in [7, 3, 0] {
        if greet(id) == {
            .Val(name) -> print("hello {name}")
            .None -> print("hello stranger")
            .Err(_) -> print("greeting failed")
        }
    }
    // `??` resolves either the missing or the failed state where it is written.
    print(greet(0) ?? "resolved failure")
    print(greet(3) ?? "resolved absence")
}
