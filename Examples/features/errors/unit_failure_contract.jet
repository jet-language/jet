#Error enum MyError { X }
fn f(bad: Bool) MyError! {
    if bad -> return Err(MyError.X)
    Ok(())
}

fn run() {
    if f(false) == {
        .Ok(_) -> print("ok")
        .Err(error) -> print(error)
    }
    if f(true) == {
        .Ok(_) -> print("unexpected")
        .Err(error) -> print(error)
    }
}
