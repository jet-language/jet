#Error MyError: enum { X }
f: fn(bad: Bool) MyError! {
    if bad -> return Err(MyError.X)
    Ok(())
}

run: fn() {
    if f(false) == {
        .Ok(_) -> print("ok")
        .Err(error) -> print(error)
    }
    if f(true) == {
        .Ok(_) -> print("unexpected")
        .Err(error) -> print(error)
    }
}
