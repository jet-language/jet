// Fallible Unit checks run directly as statements: failure still propagates.
#Error
ValidationError: enum {
    Invalid
}

validate: fn(value: Int) ValidationError! {
    if value < 0 -> return Err(ValidationError.Invalid)
}

checked_next: fn(value: Int) -> Int ValidationError! {
    validate(value)
    Ok(value + 1)
}

run: fn() {
    if checked_next(2) == {
        .Ok(value) -> { print(value) }
        .Err(error) -> print(error)
    }
    if checked_next(-1) == {
        .Ok(value) -> print(value)
        .Err(error) -> print(error)
    }
}
