// #5005: the `inline` build option says which callees the optimizer inlines
// at `optimize: basic` and `full`: `auto` (the stock) picks them by size,
// `always_marked` takes only the `#Inline(Always)` ones, whatever their size,
// and `off` inlines nothing. The same row is the flag `--inline=off` and the
// `fn build` call `b.inline(.Off)`.
name: "build_inline_example"
version: "0.1.0"
edition: "2026"

build: {
    plain: Build{ inline: off },
}
