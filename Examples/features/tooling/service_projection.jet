// D-SERVICE-PROJECTION1: runtime retention and delivery policy are explicit values.
use service: core.service

run: fn() {
    retention: 1000ms
    runtime: service.runtime("teaching-runtime", retention: retention)
    delivery: service.delivery_at_most_once()
    durable: service.delivery_durable()
    print("runtime:{runtime}")
    print("delivery:{delivery}:{durable}")
}
