// #709 / #237 C4: flagship typed-data analysis on one core.data path.
use core.data as data

#Codable
struct Ticket {
    team: String
    minutes: Float
}

#Codable
struct Owner {
    team: String
    owner: String
}

fn run() {
    tickets_csv :: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nDocs,3.0\nTools,7.0"
    owners_csv :: "team,owner\nCore,Ada\nTools,Grace\nDocs,Lin"
    tickets :: data.csv<Ticket>(tickets_csv) ?? panic("tickets")
    owners :: data.csv<Owner>(owners_csv) ?? panic("owners")

    ticket_query :: data.query(tickets).filter(t -> t.minutes >= 4.0)
    focused :: ticket_query.collect() ?? panic("filter")
    sorted_query :: data.query(focused).sort_by(t -> t.team)
    sorted :: sorted_query.collect() ?? panic("sort")
    joined :: data.inner_join(sorted, owners, t -> t.team, o -> o.team) ?? panic("join")
    groups :: data.query(sorted)
        .group_by(t -> t.team)
        .mean(t -> t.minutes)
        .collect() ?? panic("group")
    counts :: data.query(sorted)
        .group_by(t -> t.team)
        .count()
        .collect() ?? panic("count")
    values :: [Float]{4.0, 5.0, 8.0, 3.0, 7.0}
    summary :: data.describe(values) ?? panic("describe")
    chart :: data.bar_text(counts) ?? panic("bar")
    svg :: data.bar_svg(counts) ?? panic("svg")
    status :: data.status()

    print("tickets: {tickets.len()}")
    print("focused: {focused.len()}")
    loop pair in joined -> print("owned: {pair.left.team} {pair.left.minutes} -> {pair.right.owner}")
    loop g in groups -> print("mean: {g.key} value={g.value}")
    print("describe: count={summary.count} mean={summary.mean} median={summary.median}")
    print(chart)
    print("svg bytes: {svg.len()}")
    print("status: {status[0].step} {status[0].path}")
}
