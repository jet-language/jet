use core.testing as testing

fn print_fake(fake: &Fake, label: String) {
    print(label)
    print(fake.name())
    print(fake.email())
    print(fake.host())
    print(fake.address())
}

fn run() {
    print_fake(testing.fake_data(42), "en")
    print_fake(testing.fake_data(42).locale("de"), "de")
}
