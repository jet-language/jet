use testing: core.testing

print_fake: fn(fake: &Fake, label: String) {
    print(label)
    print(&fake.name())
    print(&fake.email())
    print(&fake.host())
    print(&fake.address())
}

run: fn() {
    print_fake(testing.fake_data(42), "en")
    print_fake(testing.fake_data(42).locale("de"), "de")
}
