// The same program under each `bounds` value; every index here is in range:
//   jet run run.jet                       bounds: fatal, the stock
//   jet run --profile=unchecked run.jet   bounds: off, from the profile, with a note
//   jet run --bounds=report run.jet       bounds: report, from the flag, with a note
// In `fn build`, `b.bounds(.Off)` sets it. There is no `null` or `casts`
// option: Jet has no null check or unchecked conversion to switch.
fn run() {
    scores :: [Int]{3, 1, 4, 1, 5}
    total := 0
    loop i in 0..<scores.len() -> total += scores[i]
    print("total: {total}")
}
