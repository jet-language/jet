// `jet build` in this folder runs this function. `b.optimize(.Full)` sets the
// option over the profile; `b.pin(.optimize, .Full)` would also refuse a flag
// with another value (E2113).
fn build(b: Build) {
    b.optimize(.Full)
    app :: b.add_executable("app", ["run.jet"], [])
    b.default(app)
}
