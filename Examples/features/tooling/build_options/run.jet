// Build options never change what a program prints, only how hard it is optimized:
//   jet run --profile=fast run.jet                  optimize: full, from the profile
//   jet run --profile=fast --optimize=none run.jet  the flag replaces it, with a note
//   jet build --optimize=basic                      replaces b.optimize(.Full) from fn build
fn run() { print("build options: ok") }
