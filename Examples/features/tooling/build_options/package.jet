// #5005 (D-SETTING-ORDER1): build options come from one table. A profile
// field here, a call in `fn build` (@build.jet) and a flag set the same option;
// each later layer replaces the earlier one.
name: "build_options_example"
version: "0.1.0"
edition: "2026"

build: {
    fast: Build{ optimize: full },
}
