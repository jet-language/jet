// The same program with and without debug info, and with inlining kept small:
//   jet run run.jet                     debug_info: true, small: false (the stock)
//   jet run --profile=lean run.jet      debug_info: false, small: true, from the profile
//   jet build --debug-info=false run.jet   an image with no .debug_* section
//   jet build --small run.jet           inlining kept to the O1 limits
fn run() {
    words :: [String]{"lean", "image", "same", "output"}
    letters := 0
    loop word in words -> letters += word.len()
    print("letters: {letters}")
}
