// #5005: two Bool build options. `debug_info` (stock true) says whether the
// image carries DWARF debug info: with `false` it has no `.debug_*` section,
// `.eh_frame` stays, and a crash report prints addresses instead of function
// names and lines. `small` (stock false) favors a smaller binary: inlining
// keeps to the O1 limits at any `optimize` level. The same rows are the flags
// `--debug-info=false` and `--small` (a bare Bool flag is `true`) and the
// `fn build` calls `b.debug_info(false)` and `b.small(true)`.
name: "build_debug_info_example"
version: "0.1.0"
edition: "2026"

build: {
    lean: Build{ optimize: full, debug_info: false, small: true },
}
