use data: core.data

#Codable
Ticket: struct {
    team: String
    minutes: Float
}

run: fn() {
    raw: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nTools,7.0"
    rows: data.csv<Ticket>(raw) ?? panic("bad csv")
    print("rows: {rows.len()}")
    means: data.query(rows).group_by(t -> t.team).mean(t -> t.minutes).collect() ?? panic("mean")
    print("means: {means.len()}")
    loop g in means -> print("{g.key}: {g.value}")
}
