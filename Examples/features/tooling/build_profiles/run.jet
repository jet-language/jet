// D-BUILDPROFILE1: named build profiles — an example package that declares
// custom profiles in its `build {}` block. Build this with:
//   jet build --release Examples/features/tooling/build_profiles/run.jet
//   jet build --profile=fast Examples/features/tooling/build_profiles/run.jet
//   jet build --profile=ci Examples/features/tooling/build_profiles/run.jet
// The active profile changes the rustc optimization flags but not program output.
fn run() { print("build profiles: ok") }
