// D-FIDELITY-API1=A: Perf fidelity signal — explicit app-read quality/perf knob.
package {
    name: "fidelity"
    authority: { allow: [Env, IO] }
}

use core.perf as perf

fn run() {
    print(perf.default_fidelity())
    print(perf.fidelity())
    perf.override_fidelity(0.5)
    print(perf.fidelity())
    perf.override_fidelity(0.1)
    if perf.fidelity() < 0.5 -> print("low quality mode")
    perf.reset_fidelity()
    print(perf.fidelity())
    // Ambient Perf uses the same source-owned static methods as the import.
    print(Perf.default_fidelity())
    Perf.override_fidelity(0.25)
    print(Perf.fidelity())
    Perf.reset_fidelity()
    print(Perf.fidelity())
}
