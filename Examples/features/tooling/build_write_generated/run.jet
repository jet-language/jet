// `write_generated` (stock off) writes the sources `build: fn` generates to
// `.jet/generated/<package>/` for inspection:
//   jet build                           writes none
//   jet build --write-generated=on      writes .jet/generated/build_write_generated_example/table.jet
//   jet run --profile=inspect run.jet   the same row from the profile; a run
//                                       evaluates no fn build, so it prints the same
squares: fn(limit: Int) -> [Int] {
    out := [Int]{}
    loop n in 1..<limit + 1 -> out.push(n * n)
    out
}

run: fn() {
    print("squares: {squares(5)}")
}
