// `jet emit` prints one compiler tier of a file, the same tree as text or,
// with `--json`, as the `emit` status; `--fn NAME` keeps one function:
//   jet emit --ast Examples/features/tooling/emit_tiers.jet   parsed syntax
//   jet emit --mir Examples/features/tooling/emit_tiers.jet   checked MIR
//   jet emit --lir Examples/features/tooling/emit_tiers.jet --fn double
fn double(value: Int) -> Int {
    value * 2
}

fn run() {
    print("{double(21)}")
}
