package {
    name: "tooling_debug_native"
    version: "0.1.0"
    authority: { holds: { allow: [FS, FS.Read, IO, Mem.Alloc, Panic] } }
}

// D-DBG3 / D-EXEC2 — `jet debug` steps the real compiled program through
// its LLDB-backed native backend, including native-only Core modules.
//
// Run it normally:              jet run Examples/features/tooling/debug_native.jet
// Step through it (native):     jet debug Examples/features/tooling/debug_native.jet
//
// `use core.files` touches the host file system; `jet debug` builds the
// program with source line markers and opens the `(jet)` prompt
// (step/next/finish/continue/break/print/locals/backtrace/quit) over the
// compiled binary via lldb. `--raw-frames` (D-DBG2) is the expert opt-in that
// shows the raw Rust file:line instead of the Jet source; `--dap` speaks the
// Debug Adapter Protocol for editor wiring.
use core.files as fs

fn word_count(text: String) -> Int {
    total := 0
    loop word in text.split(" ") -> total += 1
    return total
}

fn run() {
    path :: "/tmp/jet_189_debug_native_notes.txt"
    fs.write(path, "jet debug steps the full feature set") ?? panic("write failed")
    text :: fs.read(path) ?? ""
    n :: word_count(text)
    print("that note has {n} words")
    fs.remove(path) ?? panic("remove failed")
}
