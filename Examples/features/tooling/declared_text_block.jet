// D-META-DSL1=A: the library rule owns checking; Jet owns the braces.
struct Checked {
    impl Marker {
        sites :: [.Block]

        fn expand(self, target: Target) {
            if !target.contains("inside checked text") {
                reject(
                    code: "E0927",
                    what: "checked text does not contain the required phrase",
                    why: "this block language requires its greeting",
                    fix: "add `inside checked text` to the block"
                )
            }
            fn checked_value() -> String { "checked block" }
        }
    }
}

fn run() {
    #Checked {
        print("inside checked text")
    }
    print("outside block")
    print(checked_value())
}
