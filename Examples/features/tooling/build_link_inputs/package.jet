// #5828: the link and target build options. `output_dir` and `min_os` hold a
// string, `libs` and `link_args` a list of strings (one flag per item:
// `--libs=z --libs=bz2`), and `os` one of linux, macos, windows, web or
// freestanding (only linux builds).
name: "build_link_inputs_example"
version: "0.1.0"
edition: "2026"

build: {
    vendored: Build{ optimize: none, link_args: ["-Lvendor"], os: linux },
}
