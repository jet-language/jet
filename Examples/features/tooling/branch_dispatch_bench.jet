// D-BRANCH-CODEGEN1: representative classifier workloads use the existing
// measured-test mechanism. Run with `jet test --measure`.
Mode: enum {
    Read
    Write
    Admin
}

dense: fn(n: Int) -> Int {
    if n == {
        0 -> 10
        1 -> 11
        2 -> 12
        else -> 0
    }
}

sparse: fn(n: Int) -> Int {
    if n == {
        1 -> 10
        1000 -> 20
        100000 -> 30
        else -> 0
    }
}

enum_dispatch: fn(mode: Mode) -> Int {
    if mode == {
        .Read -> 1
        .Write -> 2
        .Admin -> 3
    }
}

ordered: fn(n: Int) -> Int {
    if n == {
        0..9 -> 1
        10..99 -> 2
        else -> 3
    }
}

biased: fn(n: Int) -> Int {
    if n == {
        0 -> 1
        1..100 -> 2
        else -> 3
    }
}

#Test("branch dense") {
    .measure {
        assert_eq(dense(2), 12)
    }
}

#Test("branch sparse") {
    .measure {
        assert_eq(sparse(1000), 20)
    }
}

#Test("branch enum") {
    .measure {
        assert_eq(enum_dispatch(Mode.Write), 2)
    }
}

#Test("branch ordered") {
    .measure {
        assert_eq(ordered(40), 2)
    }
}

#Test("branch biased") {
    .measure {
        assert_eq(biased(0), 1)
    }
}

run: fn() {
    assert_eq(dense(2), 12)
    assert_eq(sparse(1000), 20)
    assert_eq(enum_dispatch(Mode.Write), 2)
    assert_eq(ordered(40), 2)
    assert_eq(biased(0), 1)
    print("branch dispatch benchmarks")
}
