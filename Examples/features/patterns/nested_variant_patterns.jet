// S31: patterns nest to any depth inside a variant payload — `.Err(.Low)`,
// `.Val(.Rect(w, h))`, `.Holds(.Val(.Circle(r)))`. An else-less table is
// exhaustive when its nested arms jointly cover every payload, and a table
// evaluates a call subject once, whether it produces a value or not.
#Error
enum Fault {
    Low
    High
}

enum Shape {
    Circle(r: Int)
    Rect(w: Int, h: Int)
}

enum Slot {
    Holds(shape: Shape?)
    Empty
}

fn pick(n: Int) -> Int Fault! {
    print("pick {n}")
    if n < 0 -> return Err(.Low)
    if n > 9 -> return Err(.High)
    Ok(n)
}

fn make(n: Int) -> Shape Fault! {
    if n < 0 -> return Err(.Low)
    if n == 0 -> return Ok(Shape.Circle{r: 1})
    Ok(Shape.Rect{w: n, h: n + 1})
}

// Result of enum: the two nested `.Err` arms cover `Fault` together.
fn classify(n: Int) -> String {
    if pick(n) == {
        .Ok(v) -> "ok {v}"
        .Err(.Low) -> "low"
        .Err(.High) -> "high"
    }
}

// Result whose success payload is an enum with bindings.
fn shape_name(n: Int) -> String {
    if make(n) == {
        .Ok(.Circle(r)) -> "circle {r}"
        .Ok(.Rect(w, h)) -> "rect {w}x{h}"
        .Err(_) -> "fault"
    }
}

// Option of enum.
fn area(s: Shape?) -> Int {
    if s == {
        .Val(.Circle(r)) -> 3 * r * r
        .Val(.Rect(w, h)) -> w * h
        .None -> 0
    }
}

// Two levels: enum payload → Option → enum.
fn describe(slot: Slot) -> String {
    if slot == {
        .Holds(.Val(.Circle(r))) -> "holds circle {r}"
        .Holds(.Val(.Rect(w, h))) -> "holds rect {w}x{h}"
        .Holds(.None) -> "holds nothing"
        .Empty -> "empty"
    }
}

fn run() {
    loop n in [-1, 5, 12] -> print(classify(n))
    loop n in [-1, 7] {
        if pick(n) == {
            .Err(.Low) -> print("statement low")
            .Err(.High) -> print("statement high")
            .Ok(v) -> print("statement ok {v}")
        }
    }
    print(pick(12) == .Err(.High))
    print(pick(-3) == .Err(.High))
    loop n in [-2, 0, 3] -> print(shape_name(n))
    if make(4) == .Ok(.Rect(w, h)) && w < h {
        print("guarded rect {w} {h}")
    }
    print(area(Val(Shape.Circle{r: 2})))
    print(area(Val(Shape.Rect{w: 3, h: 4})))
    print(area(None))
    print(describe(Slot.Holds{shape: Val(Shape.Circle{r: 5})}))
    print(describe(Slot.Holds{shape: Val(Shape.Rect{w: 2, h: 3})}))
    print(describe(Slot.Holds{shape: None}))
    print(describe(Slot.Empty))
}
