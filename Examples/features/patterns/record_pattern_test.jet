// A record pattern right after `==` is one pattern test, as a statement and
// as a value `if`; it is not a dispatch body.
Row: struct {
    kind: String
    size: Int
}

label: fn(row: Row) -> String {
    if row == {kind: "box", size: 3} -> "small box" else -> "other"
}

run: fn() {
    row: Row{kind: "box", size: 3}
    if row == {kind: "box", size: 3} -> print("matched box")
    if row == {kind: "bag", size: 3} -> print("matched bag")
    print(label(row))
    print(label(Row{kind: "bag", size: 1}))
    print("done")
}
