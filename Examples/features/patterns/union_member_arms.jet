// A union arm may name a member type without binding its value
// (D-TYPESWITCH1): `.Int -> …` tests the member exactly as `.Int(_)` does.
// The match stays exhaustive, so no `else` is needed.

struct Point {
    x: Int
    y: Int
}

fn kind(value: Int | Float | String | Point) -> String {
    if value == {
        .Int -> "a whole number"
        .Float(f) -> "a float, {f}"
        .String -> "some text"
        .Point -> "a point"
    }
}

fn count_numbers(values: [Int | String]) -> Int {
    numbers := 0
    loop value in values {
        if value == {
            .Int -> numbers += 1
            .String -> {}
        }
    }
    numbers
}

fn run() {
    print(kind(3))
    print(kind(2.5))
    print(kind("s"))
    print(kind(Point{x: 1, y: 2}))
    print(count_numbers([Int | String]{1, "two", 3, "four", 5}))
}
