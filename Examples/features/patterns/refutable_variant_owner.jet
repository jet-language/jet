// #4772: a checked enum owner survives a refutable guard and its miss route.
enum Choice {
    Value(Int)
    Empty
}

struct Owner { items: [Choice] }

fn take(choice: Choice) -> Int {
    choice == .Value(value) ?? return 0
    return value
}

fn run() {
    owner :: Owner{items: [Choice]{Choice.Value(7)}}
    owner.items[0] == .Value(value) ?? panic("variant")
    print(value)
    print(take(Choice.Empty))
}
