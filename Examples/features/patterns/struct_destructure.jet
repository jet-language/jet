// D-DESTRUCT1: the dot-construction shape runs backwards to destructure. A
// pattern that doesn't name every field must end with `..` — the skipped
// fields are visible at a glance instead of silently dropped. `field: name`
// renames the local binding.
Incident: struct {
    id: Int
    severity: Int
    title: String
    kind: String
}

owned_pair: fn(seed: Int) -> (left: [Int], right: [Int]) {
    (left: [seed, seed + 1], right: [seed + 2])
}

owned_incident: fn() -> Incident {
    Incident{id: 3, severity: 2, title: "owned result", kind: "page"}
}

run: fn() {
    incident: Incident{id: 1, severity: 5, title: "database down", kind: "page"}
    Incident{id, severity: sev, ..}: incident
    print("#{id} sev {sev}")
    routed: Incident{id: 2, severity: 1, title: "database down", kind: "page"}
    if routed == {
        {kind: "page", title, ..} -> print("page {title}")
        else -> print("other")
    }
    loop i in 0..<3 {
        (left, right): owned_pair(i)
        print(left[1] + right[0])
    }
    Incident{id: owned_id, title: owned_title, ..}: owned_incident()
    print("#{owned_id} {owned_title}")
}
