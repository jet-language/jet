// D-SIGIL-ALGEBRA1=B: one numeric meaning on AOT, run, and compile time.
FOLDED :: prep { (2).pow(10) }
fn run() {
    a :: 12
    b :: 10
    print("{a.bit_and(b)},{a.bit_or(b)},{a.bit_xor(b)},{a.bit_not()}")
    i8a :: I8{12}
    i8b :: I8{10}
    print("{i8a.bit_and(i8b)},{i8a.bit_or(i8b)},{i8a.bit_xor(i8b)},{i8a.bit_not()}")
    i16a :: I16{12}
    i16b :: I16{10}
    print("{i16a.bit_and(i16b)},{i16a.bit_or(i16b)},{i16a.bit_xor(i16b)},{i16a.bit_not()}")
    i32a :: I32{12}
    i32b :: I32{10}
    print("{i32a.bit_and(i32b)},{i32a.bit_or(i32b)},{i32a.bit_xor(i32b)},{i32a.bit_not()}")
    i64a :: I64{12}
    i64b :: I64{10}
    print("{i64a.bit_and(i64b)},{i64a.bit_or(i64b)},{i64a.bit_xor(i64b)},{i64a.bit_not()}")
    u8a :: U8{12}
    u8b :: U8{10}
    print("{u8a.bit_and(u8b)},{u8a.bit_or(u8b)},{u8a.bit_xor(u8b)},{u8a.bit_not()}")
    u16a :: U16{12}
    u16b :: U16{10}
    print("{u16a.bit_and(u16b)},{u16a.bit_or(u16b)},{u16a.bit_xor(u16b)},{u16a.bit_not()}")
    u32a :: U32{12}
    u32b :: U32{10}
    print("{u32a.bit_and(u32b)},{u32a.bit_or(u32b)},{u32a.bit_xor(u32b)},{u32a.bit_not()}")
    u64a :: U64{12}
    u64b :: U64{10}
    print("{u64a.bit_and(u64b)},{u64a.bit_or(u64b)},{u64a.bit_xor(u64b)},{u64a.bit_not()}")
    print(u64a.bit_not().bit_not())
    print(U64.MAX.bit_not())
    print((a + 2).bit_and(b * 3).bit_or((2).pow(2)))
    print(a.bit_not().bit_and(255))
    print(a.bit_and(b.bit_not()))
    print(FOLDED)
    print((2).pow(-1).numerator())
    print((2).pow(-1).denominator())
    print(Float{1.5}.pow(Float{2.0}))
    print(!true)
}
