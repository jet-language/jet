package {
    name: "math_random_audit"
    version: "0.1.0"
    authority: { holds: { allow: [IO, Mem.Alloc, Rand] } }
}
// D-RANDOMDIST1: core.math.random owns deterministic PRNG distributions and samples.
use core.math.random as random

fn run() -[Rand, IO]> {
    random.seed(7)
    print(random.bool())
    print(random.float_range(Float{10.0}, Float{20.0}) >= Float{10.0})
    random.seed(11)
    a :: random.normal(Float{0.0}, Float{1.0})
    random.seed(11)
    b :: random.normal(Float{0.0}, Float{1.0})
    print(a == b)
    print(random.exponential(Float{2.0}) >= Float{0.0})
    items :: ["red", "green", "blue"]
    weights :: [Float]{0.0, 1.0, 0.0}
    print(random.weighted_pick(items, weights) ?? "none")
    sample_items :: [Int]{1, 2, 3}
    print(random.sample(sample_items, 2).len())
    print(random.bytes(4).len())
    rng := random.rng(99)
    print((&rng.float_range(Float{1.0}, Float{2.0})) >= Float{1.0})
    print(&rng.bool())
    print(rng.weighted_pick(items, weights) ?? "none")
    print(rng.sample(sample_items, 2).len())
    print(&rng.bytes(3).len())
    child := &rng.split()
    print(&child.int(1, 1))
}
