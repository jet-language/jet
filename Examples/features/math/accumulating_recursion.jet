// Recursion that ends by combining its own call with a value through an
// associative operation. O1 and O2 run each as a loop carrying the value so
// far (Compiler/JetIR/Source/OptAccumulate.jet); every tier prints the same.

// Two calls of itself: this one stays recursive.
fib: fn(n: Int) -> Int {
    if n < 2 -> return n
    fib(n - 1) + fib(n - 2)
}

triangle: fn(n: Int) -> Int {
    if n < 1 -> return 0
    n + triangle(n - 1)
}

// 30! leaves the inline Int range: the loop carries the big product.
factorial: fn(n: Int) -> Int {
    if n < 2 -> return 1
    factorial(n - 1) * n
}

// The value combined is computed after the call.
scramble: fn(n: Int) -> Int {
    if n < 1 -> return 7
    scramble(n - 1).bit_xor(n * 3)
}

spread: fn(n: Int) -> Int {
    if n < 1 -> return 0
    spread(n - 1).bit_or(n * n)
}

common: fn(n: Int) -> Int {
    if n < 1 -> return -1
    common(n - 1).bit_and(n.bit_or(1024))
}

// I64 products and sums that wrap.
spin: fn(n: I64) -> I64 {
    if n < 1 -> return 1
    wrapping(spin(n - 1) * 31)
}

wide_sum: fn(n: I64) -> I64 {
    if n < 1 -> return 0
    step: n * 400000000000000000
    wrapping(step + wide_sum(n - 1))
}

// `base` passes through unchanged; the loop clones it for each pass.
steps: fn(base: Int, n: Int) -> Int {
    if n < 1 -> return base
    base + steps(base, n - 1)
}

// Raising n toward the test that ends it makes a loop too.
climb: fn(n: Int) -> Int {
    if n > 100 -> return 0
    n + climb(n + 1)
}

// A difference is not associative: this stays a call.
alternate: fn(n: Int) -> Int {
    if n < 1 -> return 0
    n - alternate(n - 1)
}

run: fn() {
    print(fib(25))
    print(triangle(5000))
    print(factorial(30))
    print(scramble(100))
    print(spread(20))
    print(common(2000))
    print(spin(40))
    print(wide_sum(10))
    print(steps(12345678901234567890, 3))
    print(climb(1))
    print(alternate(101))
}
