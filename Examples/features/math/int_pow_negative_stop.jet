// D-EXPNEG1=A: math.int_pow stays an exact whole number, and a negative
// exponent read at run time stops with E3010 on every tier, the same stop as
// `base ^ exponent`. It never returns a silent 0.
use core.math as math

fn run() {
    loop step in [Int]{3, 0, -1} {
        print("2 ^ {step} = {math.int_pow(2, step)}")
    }
    print("unreachable")
}
