// Bitwise exclusive-or (D-XORSPELL1=A): infix `~|` keeps a bit where exactly
// one side has it — the exclusive variant of `|`. The compound `~|=` updates
// in place. The caret now means power (D-EXPOP1=A), so it is no longer xor.
// Prefix `.copy()` is still the copy sigil, and position tells the two apart.
fn run() {
    flags :: 12
    mask :: 10
    print(flags.bit_xor(mask))
    print(flags.bit_or(mask))
    left :: U8{0b1100_0011}
    right :: U8{0b0101_0101}
    print(left.bit_xor(right))
    checksum := 0
    loop byte in [17, 42, 99, 8] -> checksum = checksum.bit_xor(byte)
    print(checksum)
    source :: 5
    print(flags.bit_xor(source.copy()))
}
