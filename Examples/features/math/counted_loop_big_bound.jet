// A counted loop runs the same for a bound or a start inside the one-word
// range, at its ends and past them (a big integer, positive or negative):
// the index and what is computed from it stay exact, including results that
// leave the word range and floored divisions of negative indexes near the
// range's low end by a divisor that varies.
sum_until: fn(n: Int, stop: Int) -> Int {
    total := 0
    loop i in 0..<n {
        if i == stop -> break
        total += i % 7 + i /% 3
    }
    total
}

window: fn(n: Int) -> Int {
    total := 0
    loop i in (n - 3)..<n {
        total += i % 1000
    }
    total
}

last_double: fn(n: Int) -> Int {
    last := 0
    loop i in (n - 2)..<n {
        last = i * 2
    }
    last
}

neg_parts: fn(n: Int) -> Int {
    total := 0
    loop i in (0 - n)..<(3 - n) {
        d: i % 7 + 2
        total += i /% d + i % d
    }
    total
}

span: fn(start: Int, stop: Int) -> Int {
    total := 0
    loop i in start..<stop {
        total += i * 3 + i % 5
    }
    total
}

run: fn() {
    stops: [Int]{10, 4611686018427387909, -4611686018427387913}
    loop n in stops {
        print(sum_until(n, 20))
    }
    ends: [Int]{4611686018427387901, 4611686018427387902, 4611686018427387906, 1003}
    loop n in ends {
        print([Int]{window(n), last_double(n)})
    }
    negs: [Int]{10, 4611686018427387904, 4611686018427387909}
    print([Int]{neg_parts(negs[0]), neg_parts(negs[1]), neg_parts(negs[2])})
    spans: [Int]{10, 14, -4611686018427387906, -4611686018427387902}
    print([Int]{span(spans[0], spans[1]), span(spans[2], spans[3])})
}
