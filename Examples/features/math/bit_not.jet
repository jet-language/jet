// D-SIGIL-ALGEBRA1=B: integer bit_not flips bits; ! only negates Bool.
// Exact Int complement is -x - 1; fixed-width complement keeps its width.
fn bits(n: Int) -> Int { n }
fn run() {
    print(bits(0).bit_not())
    print(bits(5).bit_not())
    flags :: bits(15)
    mask :: bits(4)
    print(flags.bit_and(mask.bit_not()))
    print(!true)
    small :: U8{5}
    print(small.bit_not())
}
