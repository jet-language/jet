// Converting a fixed-width integer to a narrower fixed width keeps the value
// when it fits, in every sign class, and stops when it does not, exactly as a
// conversion from Int does. Only `wrapping`, `saturating` or `checked` written
// around the conversion choose another outcome.
fn run() {
    print("signed to signed: {I32{I64{-7}}}")
    print("unsigned to unsigned: {U8{U16{255}}}")
    print("signed to unsigned: {U32{I64{4294967295}}}")
    print("unsigned to signed: {I64{U64{9223372036854775807}}}")
    big :: I64{5000000000}
    print("I32 of {big}: {I32{big}}")
    print("unreachable")
}
