// Card #2298: nearest-integer ties go away from zero.
use core.math as math

fn run() {
    neg_two_half :: math.round(-2.5)
    neg_one_half :: math.round(-1.5)
    neg_zero_half :: math.round(-0.5)
    pos_zero_half :: math.round(0.5)
    pos_one_half :: math.round(1.5)
    pos_two_half :: math.round(2.5)
    print("neg-2.5={neg_two_half}")
    print("neg-1.5={neg_one_half}")
    print("neg-0.5={neg_zero_half}")
    print("pos-0.5={pos_zero_half}")
    print("pos-1.5={pos_one_half}")
    print("pos-2.5={pos_two_half}")
}
