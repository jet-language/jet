// Numeric floor flagship for Examples/features/math/ (D-EXAMPLES-SHORTPATH1=A).
// Broader libm + integer-safety families: math_audit.jet.
use core.math as math

fn run() {
    print(math.abs_float(Float{-7.0}))
    print(math.max_float(Float{3.0}, Float{9.0}))
    print(math.min_float(Float{3.0}, Float{9.0}))
    print(math.clamp_float(Float{15.0}, Float{0.0}, Float{10.0}))
    print(math.sqrt(Float{9.0}))
    print(math.hypot(Float{3.0}, Float{4.0}))
}
