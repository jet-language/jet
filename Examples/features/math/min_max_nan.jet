// Card #2298: one NaN yields the other operand; two stay NaN.
use core.math as math

fn run() {
    min_left_nan :: math.min(Float.NAN, 2.0)
    min_right_nan :: math.min(2.0, Float.NAN)
    max_left_nan :: math.max(Float.NAN, 2.0)
    max_right_nan :: math.max(2.0, Float.NAN)
    min_both_nan :: math.min(Float.NAN, Float.NAN)
    max_both_nan :: math.max(Float.NAN, Float.NAN)
    print("min-left={min_left_nan}")
    print("min-right={min_right_nan}")
    print("max-left={max_left_nan}")
    print("max-right={max_right_nan}")
    print("min-both-nan={min_both_nan.is_nan()}")
    print("max-both-nan={max_both_nan.is_nan()}")
}
