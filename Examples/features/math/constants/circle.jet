use math: core.math

// core.math's constants are comptime values, so another module can fold
// them into its own constants.
FULL_TURN: math.TAU
QUARTER_TURN: comptime { math.PI / Float{2.0} }

area: fn(radius: Float) -> Float { math.PI * radius * radius }

circumference: fn(radius: Float) -> Float { math.TAU * radius }
