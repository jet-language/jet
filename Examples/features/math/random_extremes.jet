// Card #2302: seeded Rng.int must preserve near-i64-width ranges.
use core.math.random as random

fn run() {
    rng := random.rng(7)
    print(rng.int(-3000000000000000000, 6000000000000000000))
    print(rng.int(-3000000000000000000, 6000000000000000000))
    print(rng.int(-3000000000000000000, 6000000000000000000))
}
