// D-SIGIL-ALGEBRA1=B: explicit method nesting preserves power grouping.
// Whole-number powers stay exact; a written negative exponent is Fraction.
FOLDED :: comptime { (2).pow((3).pow(2)) }
LARGE_EXACT :: comptime { (2).pow(200) }
fn show_exact(value: Int) { print(value) }
fn raise(base: Int, exponent: Int) -> Int { return base.pow(exponent) }
fn run() {
    print((2).pow((3).pow(2)))
    print(-(3).pow(2))
    print((2).pow(10))
    print((2).pow(-1))
    print(FOLDED)
    show_exact(raise(2, 200))
    show_exact(LARGE_EXACT)
    print((2).pow(3).pow(2))
    print((-3).pow(2))
    print(Float.from_int(2).pow(Float.from_int(10)))
}
