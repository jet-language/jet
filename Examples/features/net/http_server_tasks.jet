// E2-M10: HTTP server with tasks — one serve_once per connection.
// The handler receives an HTTPRequest and returns an HTTPResponse; the server
// task accepts one connection (for golden-test determinism).
package: {
    name: "http_server_tasks"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use {
    http: core.http.client
    server: core.http.server
    net: core.net
}

handle: fn(req: HTTPRequest) -> HTTPResponse HTTPError! {
    greeting: "hello from Jet! method={req.method()} path={req.path()}"
    return Ok(server.response(200, greeting))
}

run: fn() (HTTPError | NetError | TaskFailure)! {
    listener: net.tcp_listen("127.0.0.1:0") ?? panic("bind")
    addr: listener.local_addr() ?? panic("address")
    mux: server.mux()
    mux.get("/", (req: HTTPRequest) -> handle(req))
    t: task {
        server.serve_once_listener(listener, mux) ?? panic("serve")
    }
    resp: http.get("http://{addr}/") ?? panic("http get")
    print(resp.body().text(8388608) ?? panic("body"))
    t.join() ?? panic("server")
}
