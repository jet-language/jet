// E2-M10: HTTP client over blocking sockets.
// Starts a loopback server in a background task, then uses core.http.get
// to send a request and print the response body.
use core.http as http
use core.net as net

fn run() (Closed | HTTPError | NetError | TaskFailure)! {
    (sender, ch) :: channel<String>()
    // Mini one-shot server: bind, send address back, handle one request.
    t :: task {
        listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
        sender.send(listener.local_addr() ?? panic("address"))
        stream :: &listener.accept() ?? panic("accept")
        _req :: stream.read_text(8192) ?? panic("request")
        net.tcp_reply(^stream, "200 OK", "hello, world!") ?? panic("reply")
    }
    addr :: ch.receive() ?? panic("address")
    resp :: http.get("http://{addr}/") ?? panic("request")
    print(resp.body().text(8 * 1024 * 1024) ?? panic("body"))
    ^t.join() ?? panic("server")
}
