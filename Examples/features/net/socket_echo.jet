// D-NETSOCKET1=A: typed addresses, TCP echo, UDP datagrams, Unix sockets.
package {
    name: "socket_echo"
    authority: { holds: { allow: [Env, FS.Write, IO, Mem.Alloc, Net, Time, Time.Wait] } }
}

use core.files as fs
use core.net as net
use core.time as time
use core.sys as os

fn run() (Closed | IOError | NetError | RangeError | TaskFailure)! {
    typed :: net.socket_addr("127.0.0.1", 0) ?? panic("address")
    listener :: net.tcp_listen_addr(typed) ?? panic("listen")
    local :: net.listener_local_socket_addr(listener) ?? panic("local address")
    print("tcp-listen:{net.socket_host(local)}")
    (ready_tx, ready_rx) :: channel<String>()
    tcp_task :: task {
        ready_tx.send(net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("local address")))
        stream :: &listener.accept() ?? panic("accept")
        msg :: stream.read_text(8192) ?? panic("read")
        stream.write_all("tcp:{msg}".bytes()) ?? panic("write")
    }
    addr :: ready_rx.receive() ?? panic("ready")
    client := net.tcp_connect(addr) ?? panic("connect")
    net.set_timeout(&client, 1000) ?? panic("timeout")
    net.set_nodelay(&client, true) ?? panic("nodelay")
    nd :: net.nodelay(client) ?? panic("nodelay")
    print("nodelay:{nd}")
    net.set_ttl(&client, 64) ?? panic("ttl")
    hops :: net.ttl(client) ?? panic("ttl")
    print("ttl:{hops}")
    print("socket_type:{net.socket_type(client)}")
    client.write_all("ping".bytes()) ?? panic("write")
    print(client.read_text(8192) ?? panic("read"))
    sf_path :: "{os.temp_dir()}/jet-socket-echo-sf-{time.now()}.txt"
    fs.write(sf_path, "sf") ?? panic("write file")
    sent :: net.sendfile(&client, sf_path) ?? panic("sendfile")
    print("sendfile:{sent}")
    fs.remove(sf_path) ?? panic("remove file")
    client.close() ?? panic("close")
    client.close() ?? panic("second close")
    ^tcp_task.join() ?? panic("tcp server")
    udp_server :: net.udp_bind("127.0.0.1:0") ?? panic("udp bind")
    udp_addr :: net.udp_local_addr(udp_server) ?? panic("udp address")
    udp_client :: net.udp_bind("127.0.0.1:0") ?? panic("udp client")
    net.udp_set_timeout(udp_client, 1000) ?? panic("udp timeout")
    _sent :: net.udp_send_bytes_to(udp_client, "pong".bytes(), udp_addr) ?? panic("udp send")
    packet :: net.udp_receive(udp_server, 128) ?? panic("udp receive")
    print("udp:{net.udp_packet_bytes(packet)}:{net.udp_packet_original_len(packet)}:{net.udp_packet_truncated(packet)}")
    path :: "{os.temp_dir()}/jet-socket-echo-{time.now()}.sock"
    unix_listener :: net.unix_listen(path) ?? panic("unix listen")
    (unix_tx, unix_rx) :: channel<String>()
    unix_task :: task {
        unix_tx.send("ready")
        s := net.unix_accept(unix_listener) ?? panic("unix accept")
        msg :: net.unix_read(&s) ?? panic("unix read")
        net.unix_write_all_bytes(&s, "unix:{msg}".bytes()) ?? panic("unix write")
    }
    _ready :: unix_rx.receive() ?? panic("unix ready")
    unix_client := net.unix_connect(path) ?? panic("unix connect")
    net.unix_write_all_bytes(&unix_client, "ok".bytes()) ?? panic("unix write")
    print(net.unix_read(&unix_client) ?? panic("unix read"))
    net.unix_close(&unix_client) ?? panic("unix close")
    net.unix_close(&unix_client) ?? panic("second unix close")
    ^unix_task.join() ?? panic("unix server")
    fs.remove(path) ?? panic("remove socket")
}
