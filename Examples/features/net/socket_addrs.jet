// `socket_addrs` returns every address a host names, in the resolver's order;
// a numeric host is its one address. `socket_addr` is the first of them.
package {
    name: "socket_addrs"
    authority: { allow: [IO, Mem.Alloc, Net, Time.Wait] }
}

use core.net as net

fn run() {
    v4 :: net.socket_addrs("127.0.0.1", 8080) ?? return
    print("v4:{v4.len()}:{net.socket_to_string(v4[0])}")
    v6 :: net.socket_addrs("::1", 443) ?? return
    print("v6:{v6.len()}:{net.socket_to_string(v6[0])}")
    first :: net.socket_addr("::1", 443) ?? return
    print("first:{net.socket_to_string(first) == net.socket_to_string(v6[0])}")
    if net.socket_addrs("127.0.0.1", 70000) == {
        .Ok(_) -> print("port:accepted")
        .Err(error) -> print("port:{net.error_operation(error)}:{net.error_message(error)}")
    }
}
