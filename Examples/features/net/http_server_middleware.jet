// D-HTTP-SERVER2=A: middleware composes on the same Handler server engine.
use core.http.client as http_client
use core.http.server as http_server
use core.time as time

fn outer(next: HTTPHandler) -> HTTPHandler {
    owned :: ~next
    return (req: HTTPRequest) HTTPResponse HTTPError! -> {
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "outer>{response.text() ?? "invalid body"}<outer"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

fn inner(next: HTTPHandler) -> HTTPHandler {
    owned :: ~next
    return (req: HTTPRequest) HTTPResponse HTTPError! -> {
        if req.path() == "/blocked" -> return Ok(http_server.response(403, "blocked"))
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "inner>{response.text() ?? "invalid body"}<inner"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

fn run() (HTTPError | RangeError | TaskFailure)! {
    mux :: http_server.mux()
    http_server.request_id(mux)
    mux.middleware(outer)
    mux.middleware(inner)
    mux.get("/ok", () -> Ok(http_server.response(200, "handler")))
    mux.get("/blocked", () -> Ok(http_server.response(200, "must not run")))
    server :: http_server.bind("127.0.0.1:0", mux) ?? panic("bind")
    addr :: server.local_addr() ?? panic("address")
    serving :: task { server.serve() ?? panic("serve") }
    time.sleep(20ms)
    success :: http_client.get("http://{addr}/ok") ?? panic("ok request")
    print(success.status())
    print(success.text() ?? "invalid body")
    blocked :: http_client.get("http://{addr}/blocked") ?? panic("blocked request")
    print(blocked.status())
    print(blocked.text() ?? "invalid body")
    grace :: 100ms
    server.shutdown(grace) ?? panic("shutdown")
    ^serving.join() ?? panic("server")
}
