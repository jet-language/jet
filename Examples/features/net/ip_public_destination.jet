// Reachable versus safe to fetch. `is_global` follows the IANA special-purpose
// registries (updated 2025-10-09); `is_public_destination` also refuses
// carrier-grade NAT, all of 192.0.0.0/24, benchmarking, documentation,
// NAT64, 6to4 and Teredo, and judges an IPv4-mapped address by IPv4 rules.
use ip :: core.net.ip

fn v4(text: String) -> String {
    addr :: ip.parse_ipv4(text) ?? panic("IPv4 {text}")
    "{text} global:{ip.is_global(addr)} public:{ip.is_public_destination(addr)}"
}

fn v6(text: String) -> String {
    addr :: ip.parse_ipv6(text) ?? panic("IPv6 {text}")
    "{text} global:{ip.ipv6_is_global(addr)} public:{ip.ipv6_is_public_destination(addr)}"
}

fn run() {
    loop text in ([String]{"8.8.8.8", "100.64.0.1", "192.0.0.9", "192.88.99.2", "198.18.0.1", "127.0.0.1", "240.0.0.1"}) {
        print(v4(text))
    }
    loop text in ([String]{"2606:4700::1", "2001:1::1", "2002:c0a8:101::1", "2001::1", "2001:db8::1", "3fff::1", "64:ff9b::a00:1", "::ffff:808:808", "::ffff:a00:1", "fd00::1", "ff02::1"}) {
        print(v6(text))
    }
}
