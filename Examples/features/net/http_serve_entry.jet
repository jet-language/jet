// D-FOUND-LIFECYCLE1=A: `http.serve(mux, deadline:)` binds a loopback server
// whose route deadline is a per-request #Context; `shutdown` drains it and
// returns the shutdown report.
package {
    name: "http_serve_entry"
    authority: { allow: [IO, Net, Time.Wait] }
}

use core.http as http
use core.http.server as server

fn run() {
    mux :: server.mux()
    running :: http.serve(mux, deadline: 5s)
    _report :: running.shutdown() ?? return
    print("serve:shutdown")
}
