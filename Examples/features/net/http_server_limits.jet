// D-HTTP-SERVER2=A: reject ambiguous framing and oversized bodies before handlers run.
use core.http.server as http_server
use core.net as net

fn run() (HTTPError | NetError | TaskFailure)! {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("listen")
    addr :: listener.local_addr() ?? panic("address")
    mux :: http_server.mux()
    mux.post("/", (_req: HTTPRequest) -> Ok(http_server.response(200, "handler ran")))
    server :: task {
        http_server.serve_once_listener(listener, mux) ?? panic("serve")
        http_server.serve_once_listener(listener, mux) ?? panic("serve")
    }
    smuggling :: net.tcp_connect(addr) ?? panic("smuggling connect")
    smuggling_request := "".bytes()
    loop line in
        ["POST / HTTP/1.1", "Host: local", "Content-Length: 4", "Transfer-Encoding: chunked", "", "0", ""] {
        loop byte in line.bytes() -> &smuggling_request.push(byte)
        &smuggling_request.push(13)
        &smuggling_request.push(10)
    }
    smuggling.write_all(smuggling_request) ?? panic("smuggling write")
    smuggling_response :: smuggling.read_text(8192) ?? panic("smuggling read")
    print(smuggling_response.starts_with("HTTP/1.1 400 Bad Request"))
    print(smuggling_response.contains("handler ran"))
    oversized :: net.tcp_connect(addr) ?? panic("oversized connect")
    oversized_request := "".bytes()
    loop line in ["POST / HTTP/1.1", "Host: local", "Content-Length: 1048577", ""] {
        loop byte in line.bytes() -> &oversized_request.push(byte)
        &oversized_request.push(13)
        &oversized_request.push(10)
    }
    oversized.write_all(oversized_request) ?? panic("oversized write")
    oversized_response :: oversized.read_text(8192) ?? panic("oversized read")
    print(oversized_response.starts_with("HTTP/1.1 413 Payload Too Large"))
    print(oversized_response.contains("handler ran"))
    ^server.join() ?? panic("server")
}
