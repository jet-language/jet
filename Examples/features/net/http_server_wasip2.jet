// D-WASISRV1=A: the same HTTP server Prelude runs as a WASI Preview 2
// Component. The external wasmtime probe owns the request and shutdown.
package {
    name: "http_server_wasip2"
    authority: { holds: { allow: [IO, Net] } }
}

use core.http.server as http_server

fn run() HTTPError! {
    mux :: http_server.mux()
    mux.get("/", (_req: HTTPRequest) -> Ok(http_server.response(200, "hello from wasip2")))
    server :: http_server.bind("127.0.0.1:18080", mux) ?? panic("bind")
    addr :: server.local_addr() ?? panic("address")
    print(addr.starts_with("127.0.0.1:"))
    server.serve() ?? panic("serve")
}
