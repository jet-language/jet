// core.http.server: function-first mux with path params, served on a
// loopback listener and answered for a client in the same program.
// serve_once_listener drives one connection at a time so the golden output
// order stays fixed.
package {
    name: "http_server"
    authority: { allow: [FS.Read, IO, Mem.Alloc, Net, Time, Time.Wait] }
}

use core.http.client as http_client
use core.http.server as http_server
use core.net as net

fn run() (HTTPError | NetError | TaskFailure)! {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind")
    addr :: listener.local_addr() ?? panic("address")
    mux :: http_server.mux()
    mux.get("/", () -> Ok(http_server.response(200, "hello from mux")))
    mux.get("/ping", () -> Ok(http_server.response(200, "pong")))
    mux.post("/echo", (req: HTTPRequest) -> Ok(http_server.response(200, req.text() ?? "invalid body")))
    print("mux ready")
    serving :: task {
        http_server.serve_once_listener(listener, mux) ?? panic("serve")
        http_server.serve_once_listener(listener, mux) ?? panic("serve")
        http_server.serve_once_listener(listener, mux) ?? panic("serve")
    }
    root :: http_client.get("http://{addr}/") ?? panic("GET /")
    print("GET / -> {root.status()} {root.text() ?? "invalid body"}")
    ping :: http_client.get("http://{addr}/ping") ?? panic("GET /ping")
    print("GET /ping -> {ping.status()} {ping.text() ?? "invalid body"}")
    echo :: http_client.request("POST", "http://{addr}/echo").form("say", "hi").send() ?? panic("POST /echo")
    print("POST /echo -> {echo.status()} {echo.text() ?? "invalid body"}")
    ^serving.join() ?? panic("server")
}
