// D-WEBAPP1=D: minimal full-stack application builder smoke example.
package {
    name: "app_hello"
    authority: { allow: [Browser, Env, Net, FS.Read, Time] }
}
use core.web as web
#Target(Web)

fn home() -> WebPage { web.page("Hello", "world") }

fn save() { print("saved") }

fn run() {
    web.app()
        .route("/", home)
        .action("save", save)
        .security("csp")
        .assets("public")
        .a11y("wcag")
        .adapter("node")
        .csr()
        .serve()
}
