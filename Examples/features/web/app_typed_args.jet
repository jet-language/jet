// The checked CLI schema reaches the entry; the app serves on the parsed port.
// Try `jet run Examples/features/web/app_typed_args.jet -- --help` or
// `jet run Examples/features/web/app_typed_args.jet -- --port=9000`.
use core.web as web

#CLI
struct ServeArgs {
    #Doc("port to listen on") port: Int{8080}
}

fn run(args: ServeArgs) {
    print(args.port)
    web.app().serve(args.port)
}
