// c81 / D-PLUGIN1=B: the sandbox's own source, committed as `../mathkit.wasm`
// rather than run directly — no `fn run()`,
// this package is loaded, not executed. v1 sandbox exports use one homogeneous
// Component Model scalar shape: Int, Float, Bool, or Text
// (D-PLUGIN-EXPORT1=A) and may not use any effect — the wasmtime
// host that loads this registers zero host imports (D-PLUGIN1=B: safe by
// default, no `#Unsafe` gate anywhere in this story).
use core.math as math

fn scale(a: Float, b: Float) -> Float { a * b }

fn hypot(a: Float, b: Float) -> Float { math.sqrt(a * a + b * b) }

fn gcd(a: Int, b: Int) -> Int {
    x := a
    y := b
    loop y != 0 {
        t :: y.copy()
        y = x % y
        x = t
    }
    return x
}

fn is_enabled(flag: Bool) -> Bool { flag }

fn greet(name: String) -> String { "hello, {name}!" }
