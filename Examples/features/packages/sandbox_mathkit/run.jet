// c81 / D-PLUGIN1=A / D-PLUGIN-EXPORT1=A / D-EMBED2=C: `target: sandbox`
// hosts an isolated WASM Component and exposes its frozen named exports.
// `sandbox_src/` builds `mathkit.wasm` (see its package.jet for the rebuild
// command); this file is the HOST, an ordinary native Jet program. Loading
// and calling the sandbox never needs `#Unsafe` (I1). This particular guest
// declares no host imports; a Component that does declare one is preflighted
// against the guest's `authority.needs` and this host's narrowed Authority
// before linker registration or guest execution.
use core.plugin as plugin

fn run() {
    policy :: Authority.from_rights(["FS.Read:repo"])
    mathkit :: plugin.load("Examples/features/packages/sandbox_mathkit/mathkit.wasm", policy)
    area :: mathkit.scale(6.0, 7.0) ?? panic("scale failed")
    print("scale(6, 7) = {area}")
    diag :: mathkit.hypot(3.0, 4.0) ?? panic("hypot failed")
    print("hypot(3, 4) = {diag}")
    divisor :: mathkit.gcd(48, 18) ?? panic("gcd failed")
    print("gcd(48, 18) = {divisor}")
    enabled :: mathkit.is_enabled(true) ?? panic("is_enabled failed")
    print("is-enabled(true) = {enabled}")
    greeting :: mathkit.greet("Ada") ?? panic("greet failed")
    print("greet(Ada) = {greeting}")
}
