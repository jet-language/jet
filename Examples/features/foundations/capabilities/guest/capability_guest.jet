use fs: core.files

#Codable
Row: struct {
    label: String
    score: Int
}

greet: fn(name: String) -> String { "hello, {name}!" }

scale: fn(value: Float, factor: Float) -> Float { value * factor }

index: fn(rows: [Row]) -> Int {
    total := 0
    loop row in rows -> total += row.score
    return total
}

read: fn(path: String) -> String String! {
    text: fs.read(path) ?? return Err("{err}")
    return Ok(text)
}
