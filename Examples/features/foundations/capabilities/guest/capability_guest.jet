use core.files as fs

#Codable
struct Row {
    label: String
    score: Int
}

fn greet(name: String) -> String { "hello, {name}!" }

fn scale(value: Float, factor: Float) -> Float { value * factor }

fn index(rows: [Row]) -> Int {
    total := 0
    loop row in rows -> total += row.score
    return total
}

fn read(path: String) -> String String! {
    text :: fs.read(path) ?? return Err("{err}")
    return Ok(text)
}
