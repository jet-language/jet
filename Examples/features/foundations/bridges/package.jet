// D-FOUND-BRIDGE1: the example links one local C adapter and the system
// zlib dependency, then uses a Rust crate bridge in the same executable.
// `jet build` compiles the adapter in native/ from source. From the
// repository root, build and run the executable with:
//   jet build Examples/features/foundations/bridges/run.jet
//   ./build/run
// Refresh the checked binding when zreader.h changes:
//   jet inspect bind Examples/features/foundations/bridges/native/zreader.h --pkg zreader
name: "foundation_bridges"
version: "0.1.0"
edition: "2026"
authority: {
    allow: [Exec, FFI, IO, Mem.Alloc],
}
deps: {
    zreader: c@"native",
    z: c@nixpkgs:pkgsStatic.zlib,
}
