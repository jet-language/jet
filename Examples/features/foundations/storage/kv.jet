
pub fn kv_put(path: Path, key: String, value: String) -> Bool {
    return append_record(path, "put|{key}|{value}")
}

pub fn kv_delete(path: Path, key: String) -> Bool { return append_record(path, "del|{key}") }

pub fn kv_replay(path: Path) -> [String:String] {
    state := [String:String]{}
    records :: read_records(path)
    loop record in records {
        parts :: record.split("|").to_list()
        if parts.len() >= 2 {
            op :: parts[0]
            key :: parts[1]
            if op == "put" && parts.len() >= 3 -> state[key] = parts[2]
            if op == "del" -> &state.remove(key).drop("delete tombstone")
        }
    }
    return state
}

pub fn kv_get(path: Path, key: String) -> String? {
    state :: kv_replay(path)
    return state.get(key)
}

pub fn kv_compact(path: Path) -> Bool {
    state :: kv_replay(path)
    compacted := [String]{}
    loop (key, value) in state -> &compacted.push("put|{key}|{value}")
    return compact_records(path, compacted)
}
