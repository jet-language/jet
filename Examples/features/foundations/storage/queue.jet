
queue_publish: fn(path: Path, id: String, payload: String) -> Bool {
    return append_record(path, "msg|{id}|{payload}")
}

queue_ack: fn(ack_path: Path, group: String, id: String) -> Bool {
    return append_record(ack_path, "ack|{group}|{id}")
}

queue_acked: fn(ack_path: Path, group: String) -> [String:Bool] {
    seen := [String:Bool]{}
    records: read_records(ack_path)
    loop record in records {
        parts: record.split("|").to_list()
        if parts.len() >= 3 && parts[0] == "ack" && parts[1] == group -> seen[parts[2]] = true
    }
    return seen
}

queue_pending: fn(path: Path, ack_path: Path, group: String) -> [String] {
    pending := [String]{}
    seen: queue_acked(ack_path, group)
    records: read_records(path)
    loop record in records {
        parts: record.split("|").to_list()
        if parts.len() >= 3 && parts[0] == "msg" {
            id: parts[1]
            if !(seen.get(id) ?? false) -> &pending.push(id)
        }
    }
    return pending
}
