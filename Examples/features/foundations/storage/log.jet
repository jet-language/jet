use core.files as fs

// The package keeps the imported fallible log boundary intact; native AOT
// remains gated by #2763 while the executable path is exercised by `jet run`.
struct Recovery {
    priv records: [String]
    priv discarded_tail: Bool
}

fn empty_recovery() -> Recovery { Recovery{records: [String]{}, discarded_tail: false} }

fn append_record(path: Path, record: String) -> Bool {
    fs.append_all(path, "{record}\n") ?? return false
    fs.fsync(path) ?? return false
    return true
}

fn recover(path: Path) -> Recovery {
    if !fs.exists(path) -> return empty_recovery()
    mapped :: fs.map(path) ?? return empty_recovery()
    if mapped.is_empty() -> return empty_recovery()

    length :: mapped.len()
    final_byte :: mapped.window_len(length - 1, 1) ?? return empty_recovery()
    complete_tail :: Int.from_u8(final_byte[0]) == 10
    records := [String]{}
    loop line in mapped.lines() {
        &records.push(String.from_bytes(line.copy()) ?? panic("storage log is not UTF-8"))
    }

    discarded_tail := false
    if !complete_tail && records.len() > 0 {
        _tail :: &records.pop()
        discarded_tail = true
    }
    return Recovery{records: records, discarded_tail: discarded_tail}
}

fn read_records(path: Path) -> [String] {
    recovered :: recover(path)
    return recovered.records
}

fn compact_records(path: Path, records: [String]) -> Bool {
    temp :: Path.from("{path.to_string()}.compact")
    writer :: fs.create(temp) ?? return false
    loop record in records -> &writer.write_line(record) ?? return false
    &writer.flush() ?? return false
    fs.fsync(temp) ?? return false
    fs.rename(temp, path) ?? return false
    return true
}
