use core.build as build
use core.compiler as compiler

SOURCE :: comptime { "fn old_name(value: Int) -> Int {{ 41 }}\nfn run() -> Int {{ 2 }}\n" }

LEXED :: comptime { compiler.lex(SOURCE) ?? panic("compiler lex failed") }

PARSED :: comptime { compiler.parse(SOURCE) ?? panic("compiler parse failed") }

CHECKED :: comptime { compiler.check(PARSED) ?? panic("compiler check failed") }

TOKENS :: comptime { LEXED.tokens().len() }

ITEMS :: comptime { PARSED.items().len() }

FUNCTIONS :: comptime { CHECKED.functions().len() }

fn build(b: Build) {
    b.generate("facts") {
        fn tooling_facts() -> String { "tokens={TOKENS}; items={ITEMS}; functions={FUNCTIONS}" }
    }

    before :: b.add_executable(
    "tooling_before",
    ["run.jet", ".jet/generated/tooling_foundation/facts.jet"],
    [],
    )
    before_plan :: b.plan(before)
    before_graph :: build.graph(before_plan)

    after :: b.add_executable(
    "tooling_after",
    ["run.jet", "input.jet", ".jet/generated/tooling_foundation/facts.jet"],
    [],
    )
    after_plan :: b.plan(after)
    after_graph :: build.graph(after_plan)
    diff :: build.receipt_diff(before_graph, after_graph)

    if before_graph.targets.len() == 0 -> panic("build graph query returned no target")
    if after_graph.files.len() <= before_graph.files.len() {
        panic("build graph query lost source files")
    }
    if diff.file_deltas.len() == 0 && diff.key_deltas.len() == 0 {
        panic("build graph diff was empty")
    }

    b.default(after)
}

fn run() {
    print("compiler facts: tokens={TOKENS}; items={ITEMS}; functions={FUNCTIONS}")
    print("build graph: graph=checked; diff=checked")
}
