// Foundation real-time example: a canonical callback fake plus a 1 kHz
// control loop. Receipt values are host observations, not hard WCET claims.
use {
    rt: core.rt
    time: core.time
}

ControlStats: struct {
    ticks: Int
    missed: Int
    min_jitter_us: Int
    max_jitter_us: Int
    sum_jitter_us: Int
}

control_loop: fn() -> ControlStats {
    started: time.instant()
    next_due := started + 1ms
    ticks := 0
    missed := 0
    min_jitter := 0
    max_jitter := 0
    sum_jitter := 0

    // Absolute deadlines avoid accumulating sleep drift. A miss is a host
    // observation (the loop began after its due time), not a hard deadline.
    loop ticks < 10000 {
        time.sleep_until(next_due)
        due_us: (ticks + 1) * 1000
        observed_us: started.elapsed().in(.Microseconds)
        jitter: observed_us - due_us
        if ticks == 0 {
            min_jitter = jitter
            max_jitter = jitter
        } else {
            if jitter < min_jitter -> min_jitter = jitter
            if jitter > max_jitter -> max_jitter = jitter
        }
        sum_jitter += jitter
        if jitter > 0 -> missed += 1
        ticks += 1
        next_due = next_due + 1ms
    }

    return ControlStats{
        ticks: ticks,
        missed: missed,
        min_jitter_us: min_jitter,
        max_jitter_us: max_jitter,
        sum_jitter_us: sum_jitter,
    }
}

run: fn() {
    // `core.rt` owns scheduling, the reusable 256-sample block, and stream
    // cancellation. The callback does bounded work only: one pass over its
    // fixed-size input, with no allocation, wait, or I/O.
    stream := rt.callback(
    48000,
    256,
    samples -> {
        total := Float{0.0}
        loop sample in samples -> total += sample
    },
    )
    stream.next_deadline().drop("the stream is armed; this run does not schedule against its first deadline")

    control: control_loop()
    &stream.cancel()
    receipt: stream.receipt()

    // These are measured host facts from the callback receipt. They do not
    // certify hardware scheduling, audio-device delivery, or a hard WCET.
    // Counts and latencies vary per host, so the example checks how they
    // relate and prints the relations, not the measurements.
    whole_blocks: receipt.completed_frames == receipt.completed_callbacks * receipt.requested_frames
    lateness_measured: receipt.max_lateness_ns >= 0
    jitter_ordered: control.min_jitter_us <= control.max_jitter_us
    misses_bounded: control.missed >= 0 && control.missed <= control.ticks
    print("audio_callback=cancelled rate:{receipt.requested_rate_hz} frames:{receipt.requested_frames} whole_blocks:{whole_blocks} lateness_measured:{lateness_measured}")
    print("control_loop=1kHz ticks:{control.ticks} jitter_ordered:{jitter_ordered} misses_bounded:{misses_bounded}")
    print("receipt cancelled:{stream.is_cancelled()} joined:{receipt.end_identity > 0}")
}
