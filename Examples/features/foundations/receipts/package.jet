// Consumer recipe (run from this directory):
//   jet run replay.jet --record=clock2 -- foo
//   jet debug replay.jet --replay=clock2
//   jet prove evidence.jet --json
//   jet inspect claims evidence.jet --json
//   jet perf run run.jet --out .jet/perf/baseline.jettrace
//   jet perf run shifted.jet --out .jet/perf/shifted.jettrace
//   jet perf compare .jet/perf/baseline.jettrace .jet/perf/shifted.jettrace

name: "receipts-foundation"
version: "0.1.0"
edition: "2027"
authority: {
    holds: {
        allow: [Exec, IO, Mem.Alloc, Panic, Time],
    },
}
