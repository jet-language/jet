use core.text.parse as text_parse

enum Step {
    Identity
    Field(String)
    Each
    AtLeast(field: String, limit: Int)
}

fn parse_stage(source: String) -> [Step]? {
    stage :: source.trim()
    if stage == "." -> return Val([Step]{Step.Identity})

    if stage.starts_with("select(") && stage.ends_with(")") {
        body :: text_parse.strip_suffix(text_parse.strip_prefix(stage, "select("), ")").trim()
        words :: body.split(" ").to_list()
        if words.len() != 3 -> return None
        path :: words[0].trim()
        if !path.starts_with(".") || path.len() < 2 -> return None
        if words[1].trim() != ">=" -> return None
        limit :: Int.parse(words[2].trim()) ?? return None
        field :: text_parse.strip_prefix(path, ".")
        return Val([Step]{Step.AtLeast{field: field, limit: limit}})
    }

    if stage.ends_with("[]") {
        path :: text_parse.strip_suffix(stage, "[]").trim()
        if !path.starts_with(".") || path.len() < 2 -> return None
        field :: text_parse.strip_prefix(path, ".")
        return Val([Step]{Step.Field(field), Step.Each})
    }

    if stage.starts_with(".") && stage.len() > 1 {
        return Val([Step]{Step.Field(text_parse.strip_prefix(stage, "."))})
    }
    return None
}

fn parse(source: String) -> [Step]? {
    steps := [Step]{}
    stages :: source.split("|").to_list()
    if stages.len() == 0 -> return None
    loop stage in stages {
        parsed :: parse_stage(stage) ?? return None
        &steps.extend(parsed)
    }
    if steps.len() == 0 -> return None
    return Val(steps)
}

fn field(value: Dyn, name: String) -> Dyn? {
    if value == .Object(entries) {
        loop pair in entries {
            if pair.key == name -> return Val(pair.value)
        }
    }
    return None
}

fn apply_step(values: [Dyn], step: Step) -> [Dyn] {
    output := [Dyn]{}
    loop value in values {
        if step == {
            .Identity -> { &output.push(value) }
            .Field(name) -> {
                if field(value.copy(), name.copy()) == .Val(found) -> &output.push(found)
            }
            .Each -> {
                if value == .Array(items) {
                    loop item in items -> &output.push(item)
                }
            }
            .AtLeast(name, limit) -> {
                if field(value.copy(), name.copy()) == .Val(found) {
                    score :: found.int() ?? Int.MIN
                    if score >= limit -> &output.push(value)
                }
            }
        }
    }
    return output
}

fn run(data: Dyn, query: String) -> [Dyn]? {
    steps :: parse(query) ?? return None
    values := [Dyn]{data}
    loop step in steps -> values = apply_step(values, step)
    return Val(values)
}
