Formula: struct {
    priv kind: Int
    priv value: Int
    priv left: String
    priv right: String
}

Book: struct {
    priv cells: [String:Formula]
    priv order: [String]
}

Recalc: struct {
    values: [String:Int]
    touched: [String]
}

parse_formula: fn(source: String) -> Formula? {
    words: source.trim().split(" ").to_list()
    if words.len() == 0 -> return None
    if words.len() == 1 {
        token: words[0].trim()
        if token == "" -> return None
        if Int.parse(token) == .Ok(value) {
            return Val(Formula{kind: 0, value: value, left: "", right: ""})
        }
        return Val(Formula{kind: 3, value: 0, left: token, right: ""})
    }
    if words.len() != 3 -> return None

    left: words[0].trim()
    binary_operator: words[1].trim()
    right: words[2].trim()
    if left == "" || right == "" -> return None
    kind: if binary_operator == {
        "+" -> 1
        "-" -> 2
        "*" -> 4
        else -> 9
    }
    if kind == 9 -> return None
    Val(Formula{kind: kind, value: 0, left: left, right: right})
}

parse: fn(source: String) -> Book? {
    cells := [String:Formula]{}
    order := [String]{}
    loop raw_line in source.lines() {
        line: raw_line.trim()
        if line != "" {
            assignment: line.split_once("=") ?? return None
            name: assignment.before.trim()
            if name == "" -> return None
            if cells.get(name.copy()) != None -> return None
            formula: parse_formula(assignment.after.trim()) ?? return None
            cells.add(name.copy(), formula).drop("formula names are unique")
            order.push(name)
        }
    }
    if order.len() == 0 -> return None
    Val(Book{cells: cells, order: order})
}

valid_operand: fn(operand: String, book: Book, visiting: &[String]) -> Bool {
    if Int.parse(operand) == .Ok(_) -> return true
    return valid_cell(operand, book.copy(), visiting)
}

valid_formula: fn(formula: Formula, book: Book, visiting: &[String]) -> Bool {
    if formula.kind == 0 -> return true
    if formula.kind == 3 -> return valid_operand(formula.left, book.copy(), visiting)
    return valid_operand(formula.left, book.copy(), visiting) && valid_operand(formula.right, book.copy(), visiting)
}

valid_cell: fn(name: String, book: Book, visiting: &[String]) -> Bool {
    if visiting.contains(name.copy()) -> return false
    formula: book.cells.get(name.copy()) ?? return false
    visiting.push(name)
    result: valid_formula(formula.copy(), book.copy(), visiting)
    _: visiting.pop()
    return result
}

valid_book: fn(book: Book) -> Bool {
    loop name in book.order {
        visiting := [String]{}
        if !valid_cell(name.copy(), book.copy(), visiting) -> return false
    }
    return true
}

depends_on_operand: fn(
operand: String,
target: String,
book: Book,
seen: &[String],
) -> Bool {
    if Int.parse(operand) == .Ok(_) -> return false
    if operand == target -> return true
    return depends_on_cell(operand, target, book.copy(), seen)
}

depends_on_formula: fn(
formula: Formula,
target: String,
book: Book,
seen: &[String],
) -> Bool {
    if formula.kind == 0 -> return false
    if formula.kind == 3 -> return depends_on_operand(formula.left, target, book.copy(), seen)
    return depends_on_operand(formula.left, target, book.copy(), seen) || depends_on_operand(formula.right, target, book.copy(), seen)
}

depends_on_cell: fn(
name: String,
target: String,
book: Book,
seen: &[String],
) -> Bool {
    if seen.contains(name.copy()) -> return false
    formula: book.cells.get(name.copy()) ?? return false
    seen.push(name)
    result: depends_on_formula(formula.copy(), target, book.copy(), seen)
    _: seen.pop()
    return result
}

resolve_operand: fn(
operand: String,
book: Book,
values: &[String:Int],
visiting: &[String],
) -> Int? {
    if Int.parse(operand) == .Ok(value) -> return Val(value)
    return eval_cell(operand, book.copy(), values, visiting)
}

eval_cell: fn(
name: String,
book: Book,
values: &[String:Int],
visiting: &[String],
) -> Int? {
    if values.get(name.copy()) == .Val(cached) -> return Val(cached)
    if visiting.contains(name.copy()) -> return None
    formula: book.cells.get(name.copy()) ?? return None
    visiting.push(name)
    value: if formula.kind == {
        0 -> Val(formula.value)
        3 -> resolve_operand(formula.left, book.copy(), values, visiting)
        else -> {
            left: resolve_operand(formula.left, book.copy(), values, visiting) ?? {
                _: visiting.pop()
                return None
            }
            right: resolve_operand(formula.right, book.copy(), values, visiting) ?? {
                _: visiting.pop()
                return None
            }
            if formula.kind == {
                1 -> Val(left + right)
                2 -> Val(left - right)
                else -> Val(left * right)
            }
        }
    }
    _: visiting.pop()
    if value == .Val(result) -> values.add(name, result).drop("formula cache")
    return value
}

recalculate: fn(
book: Book,
previous: [String:Int],
changed: String,
new_value: Int,
) -> Recalc? {
    if book.cells.get(changed.copy()) == .None -> return None
    if !valid_book(book.copy()) -> return None

    dirty := [String:Bool]{}
    loop name in book.order {
        formula: book.cells.get(name.copy()) ?? return None
        seen := [String]{}
        affected: name == changed || depends_on_formula(formula.copy(), changed, book.copy(), seen)
        dirty.add(name, affected).drop("dirty cell set")
    }

    values := [String:Int]{}
    loop name in book.order {
        is_dirty: dirty.get(name.copy()) ?? false
        if !is_dirty {
            if previous.get(name.copy()) == .Val(old) {
                values.add(name, old).drop("previous formula value")
            }
        }
    }
    values.add(changed, new_value).drop("changed formula value")

    touched := [String]{}
    loop name in book.order {
        is_dirty: dirty.get(name.copy()) ?? false
        if is_dirty {
            visiting := [String]{}
            if eval_cell(name.copy(), book.copy(), values, visiting) == .None -> return None
            touched.push(name)
        }
    }
    Val(Recalc{values: values, touched: touched})
}
