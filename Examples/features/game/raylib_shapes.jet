package: {
    name: "raylib_shapes"
    authority: {
    allow: [IO, GPU]
    }
}
use rl: core.game.raylib

// One frame of raylib's 2D shapes drawn by Jet's software rasterizer: float
// rectangles, outlines, gradients, rounded rectangles, circle and ellipse
// outlines, rings and sectors, and regular polygons, some translucent and some
// clipped by the canvas. With JET_RAYLIB_CAPTURE set, end_drawing writes the
// canvas as a PAM image; the golden pins its SHA-256 on every tier.
run: fn() {
    window: rl.window_open(96, 72, "Jet shapes")
    rl.begin_drawing(window)
    rl.clear_background(rl.color(12, 14, 24, 255))
    rl.draw_rectangle_gradient_v(0, 0, 96, 24, rl.color(30, 60, 140, 255), rl.color(10, 20, 40, 255))
    rl.draw_rectangle_gradient_h(-6, 60, 50, 16, rl.color(255, 80, 40, 255), rl.color(40, 200, 120, 96))
    rl.draw_rectangle_gradient_ex(rl.rectangle(52.25, 40.5, 30.0, 20.0), rl.color(255, 0, 0, 255), rl.color(0, 255, 0, 255), rl.color(0, 0, 255, 255), rl.color(255, 255, 0, 255))
    rl.draw_rectangle_rec(rl.rectangle(3.4, 3.6, 10.5, 6.25), rl.color(240, 240, 240, 255))
    rl.draw_rectangle_lines(16, 2, 12, 9, rl.color(255, 200, 0, 255))
    rl.draw_rectangle_lines_ex(rl.rectangle(30.0, 2.0, 14.0, 10.0), 3.0, rl.color(120, 220, 255, 160))
    rl.draw_rectangle_rounded(rl.rectangle(48.0, 3.0, 22.0, 12.0), 0.6, 0, rl.color(200, 90, 220, 255))
    rl.draw_rectangle_rounded(rl.rectangle(89.9, 40.0, 0.75, 6.0), 0.5, 4, rl.color(255, 255, 255, 255))
    rl.draw_rectangle_rounded_lines(rl.rectangle(73.5, 3.5, 18.0, 14.0), 0.5, 6, rl.color(255, 255, 255, 200))
    rl.draw_rectangle_rounded_lines(rl.rectangle(4.0, 14.0, 8.0, 5.0), 0.0, 0, rl.color(90, 255, 120, 255))
    rl.draw_circle_lines(24, 34, 9, rl.color(255, 120, 120, 255))
    rl.draw_ellipse(48, 30, 11.5, 6.25, rl.color(60, 180, 255, 140))
    rl.draw_ellipse_lines(48, 30, 13.0, 8.0, rl.color(255, 255, 255, 255))
    rl.draw_ring(rl.vector2(76.5, 30.0), 10.0, 5.0, -30.0, 210.0, 0, rl.color(255, 170, 40, 220))
    rl.draw_ring_lines(rl.vector2(76.5, 30.0), 11.0, 13.5, 0.0, 360.0, 24, rl.color(180, 180, 255, 255))
    rl.draw_ring(rl.vector2(10.0, 50.0), 0.0, 9.0, 200.0, 20.0, 5, rl.color(250, 60, 120, 200))
    rl.draw_poly(rl.vector2(30.0, 54.0), 6, 8.0, 15.0, rl.color(120, 255, 200, 255))
    rl.draw_poly_lines(rl.vector2(30.0, 54.0), 5, 10.5, 0.0, rl.color(255, 255, 0, 255))
    rl.draw_poly(rl.vector2(92.0, 66.0), 2, 9.0, 90.0, rl.color(255, 255, 255, 100))
    rl.draw_pixel(95, 71, rl.color(255, 0, 255, 255))
    rl.draw_pixel(-1, 5, rl.color(255, 0, 255, 255))
    rl.end_drawing()
    rl.close_window(window)
    print("shapes=96x72 frame=presented")
}
