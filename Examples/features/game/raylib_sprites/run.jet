package: {
    name: "raylib_sprites"
    authority: {
    allow: [FS, GPU, IO]
    }
}
use {
    files: core.files
    rl: core.game.raylib
}

// Lines, circles and triangles beside sprites blitted from two PNG textures:
// a 4-bit palette image with transparency, stored Adam7-interlaced, and an
// RGBA image whose alpha falls off radially. Core decodes both PNGs; drawing
// clips to the canvas and to each texture and blends src-over. With
// JET_RAYLIB_CAPTURE set, end_drawing writes the frame as a PAM image and the
// golden pins its SHA-256 on every tier.
sprites_root: fn() -> String {
    candidates: [String]{"Examples/features/game/raylib_sprites", "."}
    loop candidate in candidates {
        if files.exists("{candidate}/assets/sprites.atlas") -> return candidate
    }
    "."
}

run: fn() {
    root: sprites_root()
    window: rl.window_open(96, 64, "Jet sprites")
    sprites: rl.load_texture_atlas("{root}/assets/sprites.atlas")
    glow: rl.load_texture_atlas("{root}/assets/glow.atlas")
    rl.begin_drawing(window)
    rl.clear_background(rl.color(16, 18, 28, 255))
    rl.draw_triangle(4, 60, 48, 4, 92, 60, rl.color(40, 90, 160, 255))
    // The other winding fills the same way; this one is half transparent.
    rl.draw_triangle(92, 4, 4, 4, 48, 40, rl.color(220, 120, 40, 128))
    rl.draw_circle(70, 40, 14, rl.color(250, 220, 90, 200))
    rl.draw_circle(-2, 30, 9, rl.color(120, 230, 140, 255))
    rl.draw_line(0, 0, 95, 63, rl.color(255, 255, 255, 255))
    rl.draw_line(95, 2, 10, 50, rl.color(255, 60, 90, 160))
    rl.draw_line(30, -5, 34, 70, rl.color(90, 255, 255, 255))
    rl.draw_sprite(sprites, "ship", 8, 8)
    rl.draw_sprite(sprites, "ship", 90, 58)
    rl.draw_sprite(sprites, "gem", -3, 20)
    // "wide" reaches past the texture's edge; only the texture's part draws.
    rl.draw_sprite(sprites, "wide", 40, 30)
    rl.draw_sprite(glow, "halo", 50, 10)
    rl.draw_sprite(glow, "halo", 60, 16)
    rl.draw_sprite(sprites, "missing", 0, 0)
    rl.end_drawing()
    rl.close_window(window)
    print("sprites=96x64 frame=presented atlases={sprites:Debug},{glow:Debug}")
}
