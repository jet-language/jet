package {
    name: "raylib_images"
    authority: {
    allow: [IO]
    }
}
use core.game.raylib as rl

// raylib's CPU image functions edit a RaylibImage in memory: no window and
// no effect. After each step the image is printed one letter per pixel:
// R red, B blue, W white, K black, G green, . nothing, ? any other color.
fn letter(color: rl.RaylibColor) -> String {
    if color.a == 0 -> return "."
    if color.r == 200 && color.g == 40 && color.b == 40 -> return "R"
    if color.r == 40 && color.g == 40 && color.b == 200 -> return "B"
    if color.r == 255 && color.g == 255 && color.b == 255 -> return "W"
    if color.r == 0 && color.g == 0 && color.b == 0 -> return "K"
    if color.r == 40 && color.g == 200 && color.b == 40 -> return "G"
    "?"
}

fn show(step: String, image: rl.RaylibImage) {
    print("{step} {image.width}x{image.height}")
    loop y in 0..<image.height {
        row := ""
        loop x in 0..<image.width -> row = "{row}{letter(rl.get_image_color(image, x, y))}"
        print("  {row}")
    }
}

fn channels(color: rl.RaylibColor) -> String {
    "{color.r},{color.g},{color.b},{color.a}"
}

fn run() {
    red :: rl.color(200, 40, 40, 255)
    blue :: rl.color(40, 40, 200, 255)
    white :: rl.color(255, 255, 255, 255)
    black :: rl.color(0, 0, 0, 255)
    green :: rl.color(40, 200, 40, 255)
    image := rl.gen_image_checked(6, 4, 2, 2, red, blue)
    show("checked", image)
    rl.image_draw_rectangle(&image, 1, 1, 3, 2, white)
    show("rectangle", image)
    rl.image_flip_horizontal(&image)
    show("flip_horizontal", image)
    rl.image_rotate_cw(&image)
    show("rotate_cw", image)
    rl.image_crop(&image, rl.rectangle(1.0, 1.0, 3.0, 4.0))
    show("crop", image)
    rl.image_resize_nn(&image, 5, 6)
    show("resize_nn", image)
    // Less than one column still sets the rectangle's first pixel, as in raylib.
    rl.image_draw_rectangle_rec(&image, rl.rectangle(0.0, 1.0, 0.5, 4.0), black)
    rl.image_draw_pixel(&image, 4, 5, black)
    rl.image_draw_pixel(&image, 5, 5, black)
    rl.image_color_replace(&image, white, green)
    show("pixels_replace", image)
    rl.image_flip_vertical(&image)
    rl.image_rotate_ccw(&image)
    show("flip_vertical_rotate_ccw", image)
    print("outside={channels(rl.get_image_color(image, 6, 0))}")
    tone := rl.gen_image_color(2, 1, rl.color(200, 100, 50, 255))
    rl.image_draw_pixel(&tone, 1, 0, rl.color(10, 20, 30, 128))
    rl.image_color_tint(&tone, rl.color(128, 255, 0, 200))
    print("tint={channels(rl.get_image_color(tone, 0, 0))} {channels(rl.get_image_color(tone, 1, 0))}")
    rl.image_color_invert(&tone)
    print("invert={channels(rl.get_image_color(tone, 0, 0))} {channels(rl.get_image_color(tone, 1, 0))}")
    rl.image_color_brightness(&tone, -240)
    print("brightness={channels(rl.get_image_color(tone, 0, 0))} {channels(rl.get_image_color(tone, 1, 0))}")
    rl.image_clear_background(&tone, rl.color(1, 2, 3, 4))
    print("clear={channels(rl.get_image_color(tone, 1, 0))}")
    // A crop with no whole column leaves no pixels; its height stays, as in raylib.
    rl.image_crop(&image, rl.rectangle(0.0, 0.0, 0.5, 2.0))
    print("crop_without_columns {image.width}x{image.height} bytes={image.pixels.len()}")
}
