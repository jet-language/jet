package: {
    name: "raylib_indexed"
    authority: {
    allow: [FS, GPU, IO]
    }
}
use {
    files: core.files
    rl: core.game.raylib
}

// A 320x200 indexed-colour screen at 35 Hz: one entry per pixel names one of
// 256 palette colours, and entries 16-255 cycle one step a frame. A key log
// replays held keys frame by frame; they steer a cursor that stamps its
// colour into the indexed buffer, and Space pauses the cycling. Live keys add
// to the log. Each frame is presented by drawing every run of one colour.
// With JET_RAYLIB_CAPTURE set, end_drawing writes each frame as a PAM image,
// so the file holds the last one; the golden pins its SHA-256.
C_WIDTH: 320

C_HEIGHT: 200

C_FPS: 35

C_FRAMES: 35

C_CURSOR: 8

C_STEP: 3

// Palette entries below this index never cycle.
C_FIXED: 16

C_CYCLE: 240

indexed_root: fn() -> String {
    candidates: [String]{"Examples/features/game/raylib_indexed", "."}
    loop candidate in candidates {
        if files.exists("{candidate}/runs/keys.log") -> return candidate
    }
    "."
}

// Sixteen fixed colours, then a 240-entry ramp; each entry is 0xRRGGBB.
palette: fn() -> [Int] {
    fixed: [Int]{0x000000, 0x0000AA, 0x00AA00, 0x00AAAA, 0xAA0000, 0xAA00AA, 0xAA5500, 0xAAAAAA, 0x555555, 0x5555FF, 0x55FF55, 0x55FFFF, 0xFF5555, 0xFF55FF, 0xFFFF55, 0xFFFFFF}
    entries := [Int]{}
    loop rgb in fixed -> entries.push(rgb)
    loop step in 0..<C_CYCLE {
        red: (step * 37) % 256
        green: (step * 91 + 40) % 256
        entries.push((red << 16) + (green << 8) + 255 - step)
    }
    entries
}

// The key log: a header line, then "frame<TAB>key,key" for each frame that
// holds keys. Frames the log does not name hold none.
key_log: fn(path: String) -> [String] {
    held := [String]{}
    loop _ in 0..<C_FRAMES -> held.push("")
    text: files.read(path) ?? panic("key log {path}: {err}")
    loop line in text.lines() {
        fields: line.split("\t").to_list()
        if fields.len() != 2 -> next
        frame: Int.parse(fields[0]) ?? next
        if frame >= 0 && frame < C_FRAMES -> held[frame] = fields[1].copy()
    }
    held
}

pressed: fn(held: String, key: String) -> Bool {
    names: held.split(",").to_list()
    loop name in names {
        if name == key -> return true
    }
    rl.key_down(key)
}

clamp_int: fn(value: Int, low: Int, high: Int) -> Int {
    if value < low -> return low
    if value > high -> return high
    value
}

// The palette entry an index shows after `shift` cycling steps.
shown: fn(index: Int, shift: Int) -> Int {
    if index < C_FIXED -> return index
    C_FIXED + (index - C_FIXED + shift) % C_CYCLE
}

present: fn(pixels: [Int], colors: [Int], shift: Int) {
    loop y in 0..<C_HEIGHT {
        row: y * C_WIDTH
        x := 0
        loop x < C_WIDTH {
            rgb: colors[shown(pixels[row + x], shift)]
            start: x
            x += 1
            loop x < C_WIDTH && colors[shown(pixels[row + x], shift)] == rgb -> x += 1
            rl.draw_rectangle(start, y, x - start, 1, rl.color(rgb >> 16, (rgb >> 8).bit_and(255), rgb.bit_and(255), 255))
        }
    }
}

run: fn() {
    root: indexed_root()
    held: key_log("{root}/runs/keys.log")
    colors: palette()
    pixels := [Int]{}
    loop y in 0..<C_HEIGHT {
        loop x in 0..<C_WIDTH -> pixels.push(C_FIXED + ((x + 2 * y) /% 8) % C_CYCLE)
    }
    window: rl.window_open(C_WIDTH, C_HEIGHT, "Jet indexed")
    rl.set_target_fps(C_FPS)
    cursor_x := 156
    cursor_y := 96
    shift := 0
    cycling := true
    presented := 0
    loop frame in 0..<C_FRAMES {
        keys: held[frame]
        if pressed(keys, "Left") -> cursor_x -= C_STEP
        if pressed(keys, "Right") -> cursor_x += C_STEP
        if pressed(keys, "Up") -> cursor_y -= C_STEP
        if pressed(keys, "Down") -> cursor_y += C_STEP
        if pressed(keys, "Space") -> cycling = !cycling
        cursor_x = clamp_int(cursor_x, 0, C_WIDTH - C_CURSOR)
        cursor_y = clamp_int(cursor_y, 0, C_HEIGHT - C_CURSOR)
        stamp: 1 + frame % 15
        loop dy in 0..<C_CURSOR {
            loop dx in 0..<C_CURSOR -> pixels[(cursor_y + dy) * C_WIDTH + cursor_x + dx] = stamp
        }
        if cycling -> shift += 1
        rl.begin_drawing(window)
        present(pixels, colors, shift)
        rl.end_drawing()
        presented += 1
    }
    rl.close_window(window)
    print("screen={C_WIDTH}x{C_HEIGHT} indexed palette={colors.len()} fps={C_FPS}")
    print("frames={presented} cursor={cursor_x},{cursor_y} shift={shift}")
}
