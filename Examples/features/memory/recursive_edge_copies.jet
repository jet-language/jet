// A copy is its own value, also through a recursive field. `Node.meta` leads
// back to `Node` (a Meta holds child Nodes), so Jet keeps it out of line; so
// is `Meta.detail` (a Detail holds Nodes too). A write through such a field
// into one copy never shows in another copy. Each case edits a copy and
// prints the original, then the copy.

Node: struct {
    name: String
    meta: Meta
}

Meta: struct {
    note: String
    count: Int
    tags: [String]
    children: [Node]
    detail: Detail
}

Detail: struct {
    label: String
    seen: [Node]
}

Slot: enum {
    Empty
    Held(node: Node)
}

leaf: fn(name: String) -> Node {
    Node{name: name, meta: Meta{note: name, count: 0, tags: [String]{}, children: [Node]{}, detail: Detail{label: name, seen: [Node]{}}}}
}

renamed: fn(node: Node, note: String) -> Node {
    value := node
    value.meta.note = note
    value
}

add_tag: fn(node: &Node, text: String) {
    node.meta.tags.push(text)
}

set_note: fn(node: &Node, note: String) {
    node.meta.note = note
}

held_note: fn(slot: Slot) -> String {
    if slot == {
        .Held(node) -> node.meta.note
        .Empty -> "empty"
    }
}

run: fn() {
    original := Node{name: "root", meta: Meta{note: "first", count: 1, tags: [String]{"a"}, children: [Node]{}, detail: Detail{label: "plain", seen: [Node]{}}}}

    second := original
    second.meta.note = "second"
    print("assign: {original.meta.note} / {second.meta.note}")

    other := renamed(original, "third")
    print("returned: {original.meta.note} / {other.meta.note}")

    tagged := original
    add_tag(tagged, "b")
    print("write param: {original.meta.tags.len()} / {tagged.meta.tags.len()}")

    grown := original
    grown.meta.children.push(leaf("leaf"))
    grown.meta.children[0].meta.note = "leaf edited"
    print("nested: {original.meta.children.len()} / {grown.meta.children.len()} {grown.meta.children[0].meta.note}")

    counted := original
    counted.meta.count += 5
    print("compound: {original.meta.count} / {counted.meta.count}")

    // A field of a field, both out of line.
    deep := original
    deep.meta.detail.label = "deep"
    print("field of field: {original.meta.detail.label} / {deep.meta.detail.label}")

    // A field written inside a function through its write parameter.
    noted := original
    set_note(noted, "param field")
    print("param field: {original.meta.note} / {noted.meta.note}")

    // A Map value's field.
    book: [String:Node]{"k": original}
    entry := book
    entry["k"].meta.note = "mapped"
    print("map value: {book["k"].meta.note} / {entry["k"].meta.note}")

    // An enum payload's field, through a write window.
    slot: Slot.Held{node: original}
    edited := slot
    if &edited == {
        .Held(node) -> node.meta.note = "held"
        .Empty -> {}
    }
    print("payload: {held_note(slot)} / {held_note(edited)}")

    // A tuple element's field.
    pair: (node: original, rank: 1)
    moved := pair
    moved.node.meta.note = "tupled"
    print("tuple: {pair.node.meta.note} / {moved.node.meta.note}")
}
