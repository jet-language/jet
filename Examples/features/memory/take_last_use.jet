// D-CALLSITE-MARK1=A (amends D-COPY-DEFAULT1=A at call arguments): an
// unmarked argument to a take (`^T`) parameter moves when the call is the
// name's last use, exactly as `^name` would. A use that is not the last needs
// the explicit copy `name.copy()` (E0209 teaches it). An edit keeps its `&`.
struct Order {
    id: Int
    items: [String]
}

fn archive(order: ^Order) -> String {
    "order {order.id} with {order.items.len()} items"
}

fn total(values: ^[Int]) -> Int {
    sum := 0
    loop value in values {
        sum += value
    }
    sum
}

fn label(name: ^String, suffix: ^String) -> String {
    "{name}-{suffix}"
}

fn bump(n: &Int) { n += 1 }

fn run() {
    order :: Order{id: 7, items: ["book", "pen"]}
    print(archive(order))

    kept :: Order{id: 8, items: ["lamp"]}
    print(archive(kept.copy()))
    print("kept still holds {kept.items.len()} item")

    loop round in 0..<3 {
        values :: [round, round + 1, round + 2]
        print("round {round} total {total(values)}")
    }

    // One name in two slots of one call has no last use there: the take
    // slot writes `^` next to the copy.
    name :: "crate"
    print(label(name.copy(), ^name))

    score := 41
    bump(&score)
    print("score {score}")

    // `^` on a captured name moves it into the lambda, which then runs once.
    note :: "draft"
    finish :: () -> print(label(^note, "final"))
    finish()
}
