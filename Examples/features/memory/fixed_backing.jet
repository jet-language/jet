// Card #3449 / D-FIXED-BACKING1: `mem.Fixed.over(bytes)` allocates typed
// values inside a caller-owned buffer. The buffer stays exclusively borrowed
// while the allocator is live, `reset` reuses the storage once every view is
// dead, exhaustion is a typed `AllocError` value (D-ALLOCFAIL1), and there is
// no heap fallback: the number of Int allocations that fit is bounded by the
// 128-byte buffer and is the same after a reset. Each allocation takes its
// payload from the buffer's start and its 32-byte reverse-drop header from
// the buffer's end, and an allocation fails before the two meet.
use core.mem

Point: struct {
    x: Int
    y: Int
}

run: fn() {
    bytes := [U8#128]{ uninit }
    fixed: mem.Fixed.over(bytes)

    // Typed allocation: the control witness is payload 9.
    value: fixed.alloc(9)
    point: fixed.alloc(Point{x: 3, y: 4})
    print("value {value}")
    print("point {point.x},{point.y}")

    // Last use of both views is above, so reset is accepted.
    fixed.reset()
    again: fixed.alloc(10)
    print("after reset {again}")
    fixed.reset()

    // Exhaustion is a typed failure. One Int allocation uses 8 payload bytes
    // plus a 32-byte header: 3 of them use 3 * (8 + 32) = 120 of the 128
    // bytes, and a fourth would need 160, so exactly 3 fit.
    fills := [Int]{}
    round := 0
    loop round < 2 {
        count := 0
        loop {
            if fixed.try_alloc(count) == {
                .Ok(_) -> count += 1
                .Err(error) -> {
                    print("exhausted after {count}: requested {error.requested_bytes} from {error.allocator}")
                    break
                }
            }
        }
        fills.push(count)
        fixed.reset()
        round += 1
    }
    print("same capacity after reset: {fills[0] == fills[1]}")

    close(fixed)
    print("closed")
}
