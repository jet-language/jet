package: {
    name: "memory_shared_field_chain"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc, Mem.Rc, Time.Wait] }
}
// A field read through a `Shared<T>` handle that is itself a struct field
// (`graph.hooks.name`) is one locked read, the same as through a local handle.
Hooks: struct {
    name: String
}

Graph: struct {
    hooks: Shared<Hooks>
}

via_local: fn(graph: Graph) -> String {
    hooks: graph.hooks
    hooks.name
}

via_field: fn(graph: Graph) -> String {
    graph.hooks.name
}

via_binding: fn(graph: Graph) -> String {
    name: graph.hooks.name
    "{name}!"
}

run: fn() {
    graph: Graph{hooks: shared Hooks{name: "hooks"}}
    print(via_local(graph))
    print(via_field(graph))
    print(via_binding(graph))
}
