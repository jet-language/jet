Resource: struct {
    name: String
}

impl Resource.Close {
    close: fn(&&self) { print("close {self.name}") }
}

fail: fn() {
    first := Resource{name: "first"}
    defer close(first)
    second := Resource{name: "second"}
    defer close(second)
    print("body")
    panic("stop")
}

run: fn() { fail() }
