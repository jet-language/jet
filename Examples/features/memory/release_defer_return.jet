Resource: struct {
    name: String
}

impl Resource.Close {
    close: fn(^self) { print("close {self.name}") }
}

make: fn() -> Int {
    first := Resource{name: "first"}
    defer close(^first)
    second := Resource{name: "second"}
    defer close(^second)
    print("body")
    return 7
}

run: fn() { print(make()) }
