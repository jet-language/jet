// D-MEMPROVENANCE3=A: per-slot `from (field: sources)` on an aggregate result.
Token: struct {
    text: View<str>
}

from_primary: fn(primary: String, _fallback: String) -> Token from (text: primary | _fallback) {
    text: primary.before(":")
    return Token{text: text}
}

from_fallback: fn(_primary: String, fallback: String) -> Token from (text: _primary | fallback) {
    text: fallback.before(":")
    return Token{text: text}
}

run: fn() {
    main: "alpha:1"
    spare: "beta:2"
    a: from_primary(main, spare)
    b: from_fallback(main, spare)
    print(a.text)
    print(b.text)
}
