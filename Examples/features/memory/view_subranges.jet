// D-MEMPROVENANCE2: a subrange of a declared view reborrows that view's
// owner. `view[a..<b]` narrows the window over the same storage; it never
// copies, so writes through a `ViewMut<T>` subrange land in the owner.
struct Reader {
    bytes: View<U8>
    at: Int

    // The grabbed window borrows the reader's bytes, so `from self.bytes`
    // names its owner even through the `Ok(..)` carrier.
    fn grab(&self, count: Int) -> View<U8> Err! from self.bytes {
        if self.bytes.len() - self.at < count -> return Err("short read")
        start :: self.at
        self.at += count
        Ok(self.bytes[start..<self.at])
    }
}

struct Packet {
    header: View<U8>
    body: View<U8>
}

fn total(view: View<U8>) -> Int {
    sum := 0
    loop byte in view -> sum += Int.from_u8(byte)
    sum
}

// A subrange of a view parameter is still owned by that parameter.
fn middle(view: View<U8>, start: Int, end: Int) -> View<U8> from view {
    view[start..<end]
}

fn split(bytes: View<U8>) -> Packet Err! from bytes {
    if bytes.len() < 2 -> return Err("too short")
    header :: bytes[0..<2]
    body :: bytes[2..<bytes.len()]
    Ok(Packet{header: header, body: body})
}

fn run() {
    asset :: [U8{1}, U8{2}, U8{3}, U8{4}, U8{5}, U8{6}]
    all :: asset[0..<6]
    inner :: middle(all, 1, 5)
    print(total(inner))
    print(total(inner[1..<3]))
    print(inner[0..<2].len())
    deeper :: inner[1..<4]
    print(total(deeper[0..<2]))
    reader := Reader{bytes: all, at: 0}
    first :: &reader.grab(2) ?? return
    print(total(first))
    second :: &reader.grab(3) ?? return
    print(total(second))
    print(reader.at)
    tail :: &reader.grab(4) ?? all[0..<1]
    print(total(tail))
    packet :: split(all) ?? return
    print(total(packet.header))
    print(total(packet.body))
    // A write subrange of a write view takes over that view's exclusive loan,
    // and writes through it land in `data`.
    data := [U8{0}, U8{0}, U8{0}, U8{0}, U8{0}]
    edit :: &data[0..<data.len()]
    window :: &edit[1..<4]
    window[0] = U8{7}
    window[2] = U8{9}
    center :: &window[1..<2]
    center[0] = U8{5}
    loop byte in data -> print(Int.from_u8(byte))
}
