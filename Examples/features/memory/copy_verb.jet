// D-SHAPE-COPY1=A (supersedes D-CAP2/D-MEM1/S4): `x.copy()` — the one copy sigil.
// Produces a fresh, independent value from a named binding; a temporary, so
// it never needs `^` and never trips E0209 (unlike passing `x` itself to a
// move param when `x` is used again). `.clone()` is not user-typable Jet syntax — `x.copy()` is the only
// spelling.
Ticket: struct {
    id: Int
    label: String
}

// D-MEM-COPYSEM1=A: a read-only view entering an owned return slot is copied
// automatically through the same semantic path as `.copy()`. `.copy()` remains the one
// explicit spelling when the boundary is intentional in source.
implicit_domain: fn() -> String {
    email := "user@jet-lang.dev"
    domain: email.after("@")
    return domain
}

implicit_window: fn() -> [Int] {
    values := [1, 2, 3]
    window: values[0..1]
    return window
}

archive: fn(t: &&Ticket) -> String { t.label }

run: fn() {
    name: "vault"
    saved: name.copy()
    print(name)
    print(saved)
    n: 5
    m: n.copy()
    print(n)
    print(m)
    print(implicit_domain())
    print(implicit_window()[1])
    t: Ticket{id: 1, label: "root"}
    print(archive(t.copy()))
    print(t.label)
}
