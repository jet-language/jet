// #2311 / D-MEM: a view is a value at the surface; `.copy()` materializes it for Display.
show_read: fn(values: &[Int]) {
    read: values[0..1]
    print("read-before={read.copy()}")
}

show_write_before: fn(values: &[Int]) {
    write: values[0..2]
    print("write-before={write.copy()}")
}

mutate: fn(values: &[Int]) {
    write: &values[0..2]
    write[0] = 9
}

show_write_after: fn(values: &[Int]) {
    write: values[0..2]
    print("write-after={write.copy()}")
}

show_read_after: fn(values: &[Int]) {
    read: values[0..1]
    print("read-after={read.copy()}")
}

show_singleton_before: fn(values: &[Int]) {
    singleton: values[1..1]
    print("singleton-before={singleton.copy()}")
}

show_singleton_after: fn(values: &[Int]) {
    singleton: values[1..1]
    print("singleton-after={singleton.copy()}")
}

run: fn() {
    values := [1, 2, 3]
    show_read(values)
    show_write_before(values)
    show_singleton_before(values)
    mutate(values)
    show_read_after(values)
    show_write_after(values)
    show_singleton_after(values)
    print("owner={values}")
}
