// Values that nothing reads afterwards move instead of copying: a list built
// in a loop that can stop early and then returned or stored in a record, an
// owned field handed off with `^` and refilled before anything reads it, a
// field of an owner nothing reads again (the owner's cleanup releases only
// the fields still in place), and an optional unwrapped with `^x ?? ...`.
// Value semantics stay exact: a value still read later is copied, and an
// owner a view still reads keeps its value.

struct Graph {
    names: [String]
}

struct Env {
    graph: Graph?
    count: Int
}

enum Host {
    Leaf(n: Int)
    Group(name: String, items: [Host])
}

struct SourceUnit {
    name: String
    path: String
}

struct Entry {
    name: String
    path: String
}

struct Pair {
    left: [String]
    right: [String]
}

// Two fields of a loop's element copy feed a record and nothing reads the
// copy again: both fields move out, and the copy's cleanup releases the rest.
fn entries(units: [SourceUnit]) -> [Entry] {
    out := [Entry]{}
    loop index in 0..<units.len() {
        unit := units[index]
        &out.push(Entry{name: unit.name, path: unit.path})
    }
    out
}

fn make_pair(seed: String) -> Pair {
    Pair{left: [String]{seed, "l"}, right: [String]{"r"}}
}

// One field moves into a record; the other is released with the owner.
fn pick_left(seed: String) -> Graph {
    pair :: make_pair(seed)
    Graph{names: pair.left}
}

// A moved field leaves its sibling readable: `right` moves into the list,
// `left` is still read, then moves too.
fn split(seed: String) -> [[String]] {
    pair :: make_pair(seed)
    out := [[String]]{}
    &out.push(pair.right)
    print("split left {pair.left.len()}")
    &out.push(pair.left)
    out
}

// A field of an owned parameter is returned by move.
fn take_right(pair: ^Pair) -> [String] {
    pair.right
}

// A read parameter still owns its field: storing it is a copy.
fn keep_left(pair: Pair) -> Graph {
    Graph{names: pair.left}
}

// Moved on one path only: the cleanup after the early return releases
// `right`, the fall-through path still reads both fields.
fn maybe_left(pair_seed: String, moving: Bool) -> Int {
    pair :: make_pair(pair_seed)
    if moving {
        kept :: Graph{names: pair.left}
        return kept.names.len() * 10
    }
    pair.left.len() + pair.right.len()
}

// Read again by the next iteration: every iteration stores a copy.
fn repeated(rounds: Int) -> Int {
    pair :: make_pair("x")
    sum := 0
    loop round in 0..<rounds {
        graph :: Graph{names: pair.left}
        sum += graph.names.len() + round
    }
    sum + pair.left.len()
}

fn project(n: Int) -> Host? {
    if n < 0 -> return None
    Val(Host.Leaf{n: n})
}

fn gather(values: [Int]) -> [Host]? {
    output := [Host]{}
    loop value in values -> &output.push(project(value) ?? return None)
    Val(output)
}

fn group(name: String, values: [Int]) -> Host? {
    output := [Host]{}
    loop value in values -> &output.push(project(value) ?? return None)
    Val(Host.Group{name: name, items: output})
}

fn add_name(graph: &Graph, name: String) {
    &graph.names.push(name)
}

fn stage(start: Graph, names: [String]) -> Int {
    env := Env{graph: Val(start), count: 0}
    loop name in names {
        staged := ^env.graph
        env.graph = None
        resolved := ^staged ?? {
            return -1
        }
        add_name(&resolved, name)
        env.graph = Val(^resolved)
        env.count += 1
    }
    graph :: env.graph ?? Graph{names: [String]{}}
    env.count * 10 + graph.names.len()
}

fn total(values: View<Int>) -> Int {
    sum := 0
    loop value in values -> sum += value
    sum
}

fn run() {
    hosts := gather([Int]{1, 2, 3}) ?? [Host]{}
    missing := gather([Int]{1, -2}) ?? [Host]{}
    print("gather {hosts.len()} missing {missing.len()}")

    grouped := group("g", [Int]{4, 5}) ?? Host.Leaf{n: 0}
    if grouped == {
        .Group(name, items) -> print("group {name} {items.len()}")
        .Leaf(n) -> print("leaf {n}")
    }

    print("stage {stage(Graph{names: [String]{"a"}}, [String]{"b", "c"})}")

    env := Env{graph: Val(Graph{names: [String]{"x"}}), count: 0}
    copied := env.graph ?? Graph{names: [String]{}}
    &copied.names.push("y")
    kept := env.graph ?? Graph{names: [String]{}}
    print("copied {copied.names.len()} kept {kept.names.len()}")

    records :: [Int]{1, 2, 3}
    window :: records[0..<records.len()]
    print("total {total(window)} records {records.len()}")

    listed := entries([SourceUnit]{SourceUnit{name: "a", path: "a.jet"}, SourceUnit{name: "b", path: "b.jet"}})
    print("entries {listed.len()} {listed[1].name} {listed[1].path}")

    picked :: pick_left("p")
    print("pick {picked.names[0]} {picked.names.len()}")
    parts :: split("s")
    print("split {parts[0][0]} {parts[1][0]}")
    whole :: make_pair("o")
    taken :: take_right(whole)
    print("take {taken[0]}")
    lent :: make_pair("k")
    copy_graph :: keep_left(lent)
    print("keep {copy_graph.names[0]} still {lent.left[0]}")
    print("maybe {maybe_left("m", true)} {maybe_left("m", false)}")
    print("repeated {repeated(3)}")
}
