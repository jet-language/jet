// D-ALLOC-PROGRAM1=A: package.jet wraps the hidden system heap once for the
// whole hosted program. This small request stays within its declared 2 GB cap;
// the fallible Core collection API returns the allocation without aborting.
fn run() {
    if List.try_with_capacity<Int>(1_000_000) == {
        .Ok(_values) -> print("unexpected allocation success")
        .Err(_error) -> print("program allocator cap reached")
    }
}
