// Owned String boundary methods use the same operation in comptime and at runtime.
AFTER :: comptime { "owner::member".after("::") }
BEFORE :: comptime { "owner::member".before("::") }
ABSENT_AFTER :: comptime { "owner".after("::") }
ABSENT_BEFORE :: comptime { "owner".before("::") }
EMPTY_AFTER :: comptime { "owner".after("") }
EMPTY_BEFORE :: comptime { "owner".before("") }

fn run() {
    print("after: {AFTER}; runtime: {"owner::member".after("::")}")
    print("before: {BEFORE}; runtime: {"owner::member".before("::")}")
    print("absent: [{ABSENT_AFTER}] [{ABSENT_BEFORE}]")
    print("empty: [{EMPTY_AFTER}] [{EMPTY_BEFORE}]")
}
