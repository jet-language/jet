// Tables prepared by run.jet while building. Each builder calls the third
// file `powers`, once through a member import and once by qualified name.
use {
    "powers"
    powers.[square]
}

build_squares: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> &table.push(square(i))
    table
}

build_cubes: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> &table.push(powers.cube(i))
    table
}
