// Declarations whose values run.jet prepares while building.
pub struct Grid {
    pub width: Int
    pub height: Int
}

pub enum Corner {
    Origin
    Far(Int)
}

pub fn square_grid(side: Int) -> Grid { Grid{width: side, height: side} }

pub fn corner_at(distance: Int) -> Corner {
    if distance == 0 -> return Corner.Origin
    Corner.Far(distance)
}
