// Declarations whose values run.jet prepares while building.
struct Grid {
    width: Int
    height: Int
}

enum Corner {
    Origin
    Far(Int)
}

fn square_grid(side: Int) -> Grid { Grid{width: side, height: side} }

fn corner_at(distance: Int) -> Corner {
    if distance == 0 -> return Corner.Origin
    Corner.Far(distance)
}
