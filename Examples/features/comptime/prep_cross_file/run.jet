// D-PREP-SURFACE2=A: a `comptime` value may call a function declared in another
// file, through a member import or a qualified name. The callee's body runs
// while building with its own file's names in scope, so it can call a third
// file and build that file's structs and enums. At runtime the constants
// are finished literals.
use "tables"
use "shapes"
use tables.[build_squares]
use shapes.[Grid, Corner]

// A member-imported function.
SQUARES :: comptime { build_squares(5) }

// A qualified call; the callee calls a third file.
CUBES :: comptime { tables.build_cubes(4) }

// A struct and an enum declared in another file.
GRID :: comptime { shapes.square_grid(3) }
CORNER :: comptime { shapes.corner_at(7) }

fn area(grid: Grid) -> Int { grid.width * grid.height }

fn describe(corner: Corner) -> String {
    if corner == {
        .Origin -> "origin"
        .Far(distance) -> "far {distance}"
    }
}

fn run() {
    print(SQUARES)
    print(CUBES)
    print(area(GRID))
    print(describe(CORNER))
}
