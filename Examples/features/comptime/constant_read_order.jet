// A compile-time constant may call a function that reads another
// compile-time constant declared later in the file. The compiler computes
// ROWS first, then checks `total` and `first_name` against its value; the
// order the constants are written in does not matter.
Row: struct {
    name: String
    size: Int
}

small: fn(n: Int) -> Bool {
    n < 10
}

total: fn() -> Int Never! {
    sum := 0
    loop row in ROWS {
        if row.size > 0 && small(row.size) -> sum += row.size
    }
    sum
}

first_name: fn() -> String Never! {
    picked: ROWS.get(0)
    if picked == .Val(row) -> return row.name
    ""
}

TOTAL: comptime { total() }
FIRST: comptime { first_name() }

build_rows: fn() -> [Row] Never! {
    rows := [Row]{}
    loop index in 0..<4 {
        if small(index) -> &rows.push(Row{name: "r{index}", size: index + 1})
    }
    rows
}

ROWS: comptime { build_rows() }

run: fn() {
    print("total at build {TOTAL}, at run {total()}")
    print("first at build {FIRST}, rows {ROWS.len()}")
}
