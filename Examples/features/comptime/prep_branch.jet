// D-PREP-BRANCH1=A: `comptime if` chooses a branch while building. Only the
// chosen arm is fully checked and emitted; the other arms get name checks
// only (D-WHEN2). `prep` is no longer a keyword: a value named `prep` is an
// ordinary name.
MODE :: comptime { "fast" }

LEVEL :: comptime { 2 }

fn add(a: Int, b: Int) -> Int { a + b }

fn describe() -> String {
    label := "unknown mode"
    comptime if MODE == "safe" {
        label = "safe mode"
    } else comptime if MODE == "fast" {
        label = "fast mode"
    } else {
        label = "other mode"
    }
    label
}

fn run() {
    print(describe())
    comptime if LEVEL > 1 {
        print("level above one")
    }
    comptime if LEVEL > 5 {
        print("level above five")
    }
    // The unchosen arm is not type-checked: this call would not type-check.
    comptime if false {
        broken :: add("text", 0)
        print("{broken}")
    } else {
        print("dropped arm skipped")
    }
    // Nested branches.
    comptime if LEVEL == 2 {
        comptime if MODE == "fast" {
            print("level two, fast")
        } else {
            print("level two, other")
        }
    }
    prep := 3
    prep += 4
    print("prep is an ordinary name: {prep}")
}
