LIMIT :: comptime { 1000 }

BASE :: comptime { 10 }

fn run() {
    // D-PREP-SURFACE2=A: `comptime { … }` runs in the comptime interpreter and
    // emits no runtime Rust (I3). A value that outlives it is prepared
    // explicitly with `name :: comptime { value }`.
    ratio :: comptime { LIMIT /% BASE }
    // Build-time assertion: verify constants are valid before compiling.
    comptime {
        if ratio < 1 -> panic("limit must be >= base")
    }
    // The check ran at build time and produced no runtime code; `ratio` is a
    // runtime literal.
    print("limit: {LIMIT}")
    print("base: {BASE}")
    print("ratio: {ratio}")
}
