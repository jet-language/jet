// D-METAREFLECT1 / D-REFLECT1 / D-FACT-READ1: aggregate reflection and the
// typed `@` reader consume the same registered fact carriers.
#Numeric
Severity :: distinct Int(0..10)

#UnitFamily(Length, dimension) { meter }

struct Order {
    state { Draft, Published }

    value: Int
}

fn send_report() -[IO]> {}

RANGE :: prep { Severity.$range }

DIMENSION :: prep { Meter.$dimension }

STATES :: prep { Order.$states }

EFFECTS :: prep { send_report.$effects }

SENDABILITY :: prep { Severity.$sendability }

MOVEDNESS :: prep { Severity.$movedness }

ATTRIBUTION :: prep { report.$attribution }

ORIGIN :: prep { Severity.$origin }

VIEW_PROVENANCE :: prep { send_report.$view_provenance }

UNIT_SCALE :: prep { Meter.$unit_scale_provenance }

MATURITY :: prep { send_report.$maturity }

derive T.Summarize {
    info :: T.reflect()
    method :: info.methods[0].name
    method_marker :: info.methods[0].markers[0].name
    method_effects :: info.methods[0].$effects.values.len()
    method_sendability :: info.methods[0].$sendability.known
    method_movedness :: info.methods[0].$movedness.known
    method_origin :: info.methods[0].$origin.tracked
    method_view_mutable :: info.methods[0].$view_provenance.mutable
    method_maturity :: info.methods[0].$maturity.level
    pub_field :: info.fields[0].name
    hidden_pub :: info.fields[1].is_pub
    has_debug :: info.has_marker("Debug")
    fn summary(self) -> String { "{T.$name}/{$method}[{$method_marker}]/{$pub_field} debug={$has_debug} hidden_pub={$hidden_pub} effects={$method_effects} send={$method_sendability} moved={$method_movedness} track={$method_origin} view={$method_view_mutable}" }
}

// D-MARK-DEBUG1=A: `Debug` no longer has an explicit derive spelling — it
// auto-derives whenever every field qualifies (S55). `has_marker("Debug")`
// below reads the type's WRITTEN markers, so it now honestly reports
// `false` for a type that only qualifies for auto-derive.
#Summarize
struct Widget {
    pub label: String
    secret: Int
    level: Int(0..10)

    #Inline fn show(self) -> String { ~self.label }
}

fn run() {
    w :: Widget{label: "gear", secret: 1, level: 2}
    print(w.summary())
    print("planes:{RANGE.start}-{RANGE.end}/{DIMENSION.axes.len()}/{STATES[0].name}/{EFFECTS.values.len()}")
    print("homed:{SENDABILITY.known}/{MOVEDNESS.known}/{ATTRIBUTION.source}/{ORIGIN.tracked}/{VIEW_PROVENANCE.mutable}")
}
