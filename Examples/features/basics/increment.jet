// Counting up and down uses compound assignment (S17): `x += 1` and
// `x -= 1` are the one spelling. Jet has no `++`/`--` (D-INCR1 retired);
// an update is its own statement, so every read sees one settled value.
// Overflow traps like any `+= 1` (D-NUMOPS2).
fn run() {
    lives := 3
    tick := 0
    lives -= 1
    loop lives > 0 {
        tick += 1
        print("tick {tick} lives {lives}")
        lives -= 1
    }
    n := 5
    print(n)
    n += 1
    print(n)
    n += 1
    print(n)
    print(n)
}
