// An element pattern subject on the right of an if-condition `&&` binds
// copies, as one on the right of the `&&`/`||` expression does
// (element_pattern_short_circuit): the condition's rhs block reaches the arm
// only through the condition's join, which the false edge also enters, so a
// window place carrying the index operand could not be read in the arm (MIR
// legality: place use not dominated by its definition). The if statement, the
// if expression, and a decision-table row all lower the condition this way,
// over a read parameter, a stored-field chain below one, and a stable root.
enum Arg {
    Text(value: String)
    Flag(name: String, on: Bool)
}

enum Shape {
    Dot
    List(items: [Int], kind: String)
}

struct Slot {
    shape: Shape
}

struct Row {
    cells: [Slot]
}

struct Marker {
    labels: [Arg?]
}

// a read parameter's element, if statement
fn text(args: [Arg], index: Int) -> String? {
    if index < args.len() && args[index] == .Text(value) -> return Val(value.copy())
    None
}

// a stored-field chain below a read parameter
fn label(marker: Marker, index: Int) -> String {
    if index < marker.labels.len() && marker.labels[index] == .Val(.Text(value)) {
        return value.copy()
    }
    "-"
}

// a stable root (the loop's row), and a binding read by the next conjunct
fn list_limit(rows: [Row]) -> Int {
    limit := 0
    loop row in rows {
        if row.cells.len() > 0 && row.cells[0].shape == .List(items, kind) && kind == "l" {
            if items.len() > limit -> limit = items.len()
        }
    }
    limit
}

// the if expression and a decision-table row
fn first_flag(args: [Arg]) -> String {
    picked :: if args.len() > 0 && args[0] == .Flag(name, on) && on -> name.copy() else -> "off"
    if {
        args.len() > 1 && args[1] == .Text(value) -> "{picked} {value}"
        else -> picked
    }
}

fn run() {
    args :: [Arg]{Arg.Flag{name: "f", on: true}, Arg.Text{value: "t"}}
    marker :: Marker{labels: [Arg?]{Val(Arg.Text{value: "m"}), None}}
    rows :: [Row]{Row{cells: [Slot]{Slot{shape: Shape.List{items: [Int]{1, 2, 3}, kind: "l"}}}}, Row{cells: [Slot]{Slot{shape: Shape.Dot}}}}
    print("{text(args, 1) ?? "-"} {text(args, 5) ?? "-"} {label(marker, 0)} {label(marker, 1)}")
    print("{list_limit(rows)} {first_flag(args)} {first_flag([Arg]{})}")
}
