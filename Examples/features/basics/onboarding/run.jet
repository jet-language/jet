// First-hour lesson 3: the `run.jet` that `jet new` creates, edited to read a
// typed `#CLI` argument. Check, test, fix, and explain operate on this source.
fn greet(name: String) -> String { "hello, {name}" }

#CLI
struct GreetingArgs {
    #Doc("name to greet") name: String{"Jet"}
}

#Test("greet says hello") {
    assert_eq(greet("Jet"), "hello, Jet")
}

fn run(args: GreetingArgs) { print(greet(args.name)) }
