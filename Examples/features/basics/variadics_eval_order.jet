// #4894: raw expressions run in written order before the rest slot is grouped.
tap: fn(label: String, value: ^String) -> String {
    print("eval {label}")
    value
}
collect: fn(head: String{tap("default", "D")}, rest: ...String) -> String {
    "{head}:{rest.join(",")}"
}
Logger: struct {
    collect: fn(self, head: String, rest: ...String) -> String {
        "{head}:{rest.join(",")}"
    }
}
logger: fn() -> Logger {
    print("eval receiver")
    Logger{}
}
select_action: fn() -> Bool {
    print("eval callee")
    true
}
run: fn() {
    print(collect(rest: tap("tail", "R"), head: tap("head", "H")))
    print(collect(rest: tap("tail-default", "R")))
    print(logger().collect(rest: tap("method-tail", "R"), head: tap("method-head", "H")))
    print((if select_action() -> collect else -> collect)(rest: tap("value-tail", "R"), head: tap("value-head", "H")))
}
