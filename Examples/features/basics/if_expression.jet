// `if` as a value, and optional condition parens (S68, D-SG2, D-IFDIST1).
classify: fn(n: Int) -> String {
    // An ordered arm table produces one value; `else` makes it exhaustive.
    if {
        n > 0 -> "positive"
        n < 0 -> "negative"
        else -> "zero"
    }
}

// D-IFDIST1: distributed comparison marker — bare atoms become `n < atom`.
hi_band: fn(n: Int) -> Int {
    if n < {
        16 -> 0
        32 -> 1
        else -> 2
    }
}

// D-IFDIST1 / D-ARMHEAD-PAREN1: group distributed atoms before `&&`.
hex_nibble: fn(n: Int) -> String {
    if n == {
        0 -> "0"
        (10 | 11) && true -> "a"
        else -> "f"
    }
}

is_nonzero: fn(n: Int) -> String {
    // Distributed `!=`: a bare atom becomes `n != atom`.
    if n != {
        0 -> "nonzero"
        else -> "zero"
    }
}

run: fn() {
    // The whole `if` is the value bound to `m` — no ternary needed.
    a: 10
    b: 3
    m: if a > b -> a else -> b
    print("max is {m}")
    // A branch may run statements before its trailing value.
    note: if {
        a > b -> {
            diff: (a - b)
            "a leads by {diff}"
        }
        else -> "b leads"
    }
    print(note)
    print(classify(7))
    print(classify((-4)))
    print(classify(0))
    // Optional parens around a condition are accepted (jet fmt removes them).
    if a > b -> print("a is bigger")
    print("{hi_band(20)}")
    print(hex_nibble(10))
    print(is_nonzero(3))
    band: if n_val() < {
        5 -> "tiny"
        else -> "big"
    }
    print(band)
    // A parenthesized branch value is the same value as the bare one.
    span: if a > b -> (a - b) else -> (b - a)
    print("span is {span}")
}

n_val: fn() -> Int { 3 }
