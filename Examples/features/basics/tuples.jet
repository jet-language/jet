// S73 (D-SG7): named-only tuples — literals, types, access, equality, destructure.
fn bounds() -> (max: Int, min: Int) { (min: 0, max: 10) }

// D-OUTPUT-RETURNS1=A: public APIs return new answers; no dummy & outputs.
pub fn split(n: Int, d: Int) -> (quotient: Int, remainder: Int) {
    (quotient: n /% d, remainder: n % d)
}

fn run() {
    p :: (x: 1, y: 2)
    q :: (y: 3, x: 4)
    same_shape :: (p == q)
    { x: a, y: b } :: ~p
    print("{p.x} {p.y} {a} {b} {same_shape}")
    pair :: bounds()
    print("{pair.min} {pair.max}")
    (quotient, remainder) :: split(17, 5)
    print("{quotient} {remainder}")
}
