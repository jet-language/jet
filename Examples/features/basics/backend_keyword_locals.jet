// Locals may use names that are reserved words of the generated backend
// language; each still resolves to its own value, also when bound by a
// pattern, a loop or a closure capture.
enum Shape {
    Square(Int)
    Line(Int)
}

fn area(shape: Shape) -> Int {
    if shape == {
        .Square(ref) -> { return ref * ref }
        .Line(crate) -> { return crate }
    }
    return 0
}

fn run() {
    move :: 3
    where := 4
    where += move
    print(where)
    dyn :: [1, 2, 3]
    total := 0
    loop box in dyn -> total += box
    print(total)
    print(area(.Square(5)))
    print(area(.Line(6)))
    unsafe :: 10
    scaled :: dyn.map(x -> x * unsafe)
    print(scaled)
}
