// Values and types.
// `name :: value` names an immutable binding; `name := value` names one that
// may be reassigned (D-BIND1). Binding immutability is not deep object
// immutability: an object/alias still needs the collection's write contract.
// Type annotations are optional — Jet infers locals (S4).
fn run() {
    name :: "Jet"  // immutable inferred String
    year :: 2026  // immutable inferred Int
    version :: Float{0.1}  // explicit approximate Float
    ready :: true  // immutable Bool
    // arithmetic, with the usual precedence
    sum :: (7 + (3 * 4))  // 19, not 40
    half :: (Float{19.0} / Float{2.0})  // Float division keeps the fraction
    leftover :: (19 % 4)  // remainder
    depth :: (-12)
    // Interpolation evaluates the expression and inserts its value into this
    // line. Source wrapping is not an output newline; `\n` below is explicit.
    print("{name} {version} (ready: {ready})")
    print("sum {sum}, half {half}, leftover {leftover}")
    print("next year is {(year + 1)}, depth {depth}")
    // escapes: \n newline, \t tab, \" quote, \\ backslash (S20)
    print("line one\nline two")
    print("col a\tcol b")
    print("she said \"hi\"")
    print("a real backslash: \\")
    // literal braces are doubled, since { } means interpolation (S20)
    print("braces print {{like this}}")
}
// --- expected output --------------------------------------------------
// Jet 0.1 (ready: true)
// sum 19, half 9.5, leftover 3
// next year is 2027, depth -12
// line one
// line two
// col a	col b
// she said "hi"
// a real backslash: \
// braces print {like this}
