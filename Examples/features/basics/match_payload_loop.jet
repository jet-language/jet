// A match over a plain local inside a loop reads the payload on every
// iteration: a payload binding never takes the payload out of a carrier the
// back edge tests again (the local stays whole after each arm).
Slot: enum {
    Full(text: String)
    Empty
}

lookup: fn(seed: Int) -> String? Never! {
    if seed > 0 -> return Val("name-{seed}")
    None
}

slot_of: fn(seed: Int) -> Slot Never! {
    if seed > 0 -> return Slot.Full{text: "slot-{seed}"}
    Slot.Empty
}

run: fn() {
    name: lookup(7)
    out := [String]{}
    loop i in 0..<3 {
        if name == {
            .Val(n) -> out.push(n)
            else -> {}
        }
    }
    print(out.join(","))
    slot: slot_of(4)
    slots := [String]{}
    loop i in 0..<3 {
        if slot == {
            .Full(text) -> slots.push(text)
            else -> {}
        }
    }
    print(slots.join(","))
}
