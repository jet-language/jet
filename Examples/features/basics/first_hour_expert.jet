// Expert variant of first_hour.jet (D-EXAMPLES-SHORTPATH1=A).
// Hand-walks raw `process.args()` instead of the `#CLI` typed entry the flagship teaches.
use process :: core.process

fn run() {
    args :: process.args()
    project :: if args.len() > 0 -> args.get(0) ?? "first-hour" else -> "first-hour"
    steps :: ["check source", "build binary", "run smoke test"]
    print("Shipping {project}")
    loop step in steps -> print("[ok] {step}")
}
