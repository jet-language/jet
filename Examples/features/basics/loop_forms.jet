// loop_forms — the shapes of the single `loop` keyword (S19 / D-RANGE-EXCL1=C).
// `loop { }` is infinite (leave with `break`); `loop cond { }` is conditional
// (there is no `while` keyword); `loop x in iter { }` is source iteration
// (there is no `for` keyword).
// `loop (key, value) in map { }` binds map pairs;
// `loop (i, item) in list { }` binds index then item; `loop i in list.indexes()`
// binds an index only. `in` joins a source binding to its source, and commas
// separate later clauses such as a stride.
// A source and its optional stride are evaluated once, left to right. A
// statement-position loop runs immediately and discards the body value. A
// finite value-position loop (`loop item in items -> value`) is also eager and
// returns a List; use `.lazy()` on a collection pipeline when evaluation must
// be deferred.
// `::` below keeps the source binding immutable; iteration reads the source and
// does not mutate it. The explicit-state form (`loop i := 0, i < n { ... }`)
// owns its mutable header state in the body.
fn run() {
    // 1. Infinite loop, left with `break` (S23).
    n := 0
    loop {
        n += 1
        if n == 3 -> break
    }
    print("infinite stopped at {n}")
    // 2. Conditional loop.
    c := 0
    loop c < 3 -> c += 1
    print("conditional ran to {c}")
    // 3. Iterator loop over a list (item only).
    sum := 0
    loop x in [10, 20, 30] -> sum += x
    print("iterator sum {sum}")
    // 4. Two-binding over a list — index comes free, no bounds math. The
    // immutable `items` binding and its list storage are only read here.
    items :: [String]{"a", "b"}
    loop (i, item) in items -> print("pair {i}:{item}")
    // 5. Index-only, always in bounds for this source.
    loop i in items.indexes() -> print("idx {i}")
    // 6. Two-name iteration over a map (sorted by key).
    scores := [String:Int]{}
    scores["ana"] = 1
    scores["bo"] = 2
    loop (name, score) in scores -> print("{name} = {score}")
    // 7. Inclusive `..` (S22) beside exclusive `..<` (D-RANGE-EXCL1=C).
    loop i in 0..2 -> print("incl {i}")
    loop i in 0..<3 -> print("excl {i}")
    // 8. Source-range iteration. `next` advances the source and skips the rest
    // of this body; it does not introduce an afterthought or mutate `items`.
    loop i in 0..<3 {
        if i == 1 -> next
        print("counted {i}")
    }
}
