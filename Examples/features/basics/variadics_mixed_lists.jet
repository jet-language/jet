// #4894: mixed packs preserve borrowed sources while owning their new storage.
join: fn(parts: ...String) -> String { parts.join(",") }
inspect: fn(left: [String], right: [String], item: String) {
    print(join("start", ...left, item, ...right, "end"))
    print(join(...left, ...right))
    print(left.join(","))
    print(right.join(","))
    print(item)
}

run: fn() {
    left: [String]{"a", "b"}
    right: [String]{"c"}
    inspect(left, right, "mid")
    merged: [...left, "mid", ...right]
    print(merged.join(","))
}
