// The tuple annotation supplies String to the bare empty list, by field name.
fn empty_report() -> (lines: [String], at: Int, message: String) {
    (message: "ready", lines: [], at: 3)
}

fn line_count(report: (lines: [String], at: Int, message: String)) -> Int {
    report.lines.len()
}

fn run() {
    report :: empty_report()
    print("{report.message}:{report.at}:{report.lines.len()}")
    print(line_count((at: 0, message: "empty", lines: [])))
}
