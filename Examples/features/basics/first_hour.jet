// First-hour tour: one small command-line tool that also builds as a native binary.
// Teach `#CLI` first (raw `process.args()` → first_hour_expert.jet).
#CLI
TourArgs: struct {
    #[Doc("print extra detail"), Short("v")] verbose: Bool
}

run: fn(args: TourArgs) {
    steps: ["check source", "build binary", "run smoke test"]
    print("Shipping first-hour")
    loop step in steps -> print("[ok] {step}")
    if args.verbose -> print("verbose")
}
