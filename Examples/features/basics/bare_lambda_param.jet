// c142: a bare lambda (no parameter type annotation) passed directly to a
// user-defined function whose parameter is a function type. The parameter's
// type is taken from the fn-typed slot it flows into (expected-type
// elaboration), so `x -> …` needs no annotation. This used to ICE in codegen
// because the closure parameter type was never emitted.
run_each: fn(xs: [Int], f: fn(Int)) {
    loop x in xs -> f(x)
}

map_sum: fn(xs: [Int], f: fn(Int) -> Int) -> Int {
    total := 0
    loop x in xs -> total += f(x)
    total
}

run: fn() {
    run_each([1, 2, 3], x -> print(x))
    // a bare lambda with an expression body and a return type slot
    print(map_sum([1, 2, 3], n -> n * 10))
}
