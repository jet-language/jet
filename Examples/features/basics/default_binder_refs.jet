// A parameter default may read earlier parameters. Each call that omits the
// argument binds the default with those parameters' declared types.
span: fn(start: Int, end: Int{start + 10}) -> Int { end - start }

window: fn(start: Int, size: Int{4}, end: Int{start + size * 2}) -> Int { end }

run: fn() {
    print(span(5))
    print(span(5, 7))
    print(window(1))
    print(window(1, 2))
    print(window(1, 2, 3))
}
