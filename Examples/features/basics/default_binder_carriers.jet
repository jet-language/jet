// A parameter default may read an earlier parameter of any carrier: a String
// interpolation and a list's length, as well as an Int. A call that omits the
// argument binds the default from the earlier argument.
fn label(name: String, title: String{"{name}!"}) -> String { "{title}" }
fn counted(values: [Int], count: Int{values.len()}) -> Int { count }

fn run() {
    print(label("jet"))
    print(label("jet", "plain"))
    print(counted([1, 2, 3]))
    print(counted([1, 2, 3], 9))
}
