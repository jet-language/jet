// Splitting a text and joining the pieces again replaces every separator with
// the joiner, keeping empty pieces at the start, between two separators and at
// the end. An empty separator splits between characters and also yields an
// empty first and last piece.
fn swap(text: String, sep: String, joiner: String) -> String {
    text.split(sep).join(joiner)
}

fn run() {
    print(swap("a,b,c", ",", ";"))
    print(swap(",a,,b,", ",", ";"))
    print(swap("a,b,c", ",", " | "))
    print(swap("a,b,c", ",", ""))
    print(swap("héllo,wörld,日本", ",", "-"))
    print(swap("é,ü", ",", "→"))
    print(swap("a::b::::c", "::", "/"))
    print(swap("abc", "", "."))
    print(swap("", ",", ";"))
    print(swap("no separator", ",", ";"))
}
