rec: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return rec(n - 1) + 1
}

second: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return second(n - 1) + 1
}

even: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return odd(n - 1) + 1
}

odd: fn(n: Int) -> Int {
    if n == 0 -> return 0
    return even(n - 1) + 1
}

run: fn() {
    print(rec(10))
    print(second(10))
    print(even(1000))
    print(odd(1000))
}
