// Ordinary files run only their explicit `fn run` body. Module declarations
// remain available to every function in the file; module state a function
// changes lives in a `shared` holder.
struct Count { value: Int }

LIMIT :: 2
COUNTER :: shared Count{value: 0}

fn run() {
    print("script entry")
    print(LIMIT)
    COUNTER.value += LIMIT
    print(COUNTER.value)
    print(even(LIMIT + 2))
    print(helper())
}

fn helper() -> String { "declaration" }

fn even(n: Int) -> Bool { if n == 0 -> true else -> odd(n - 1) }

fn odd(n: Int) -> Bool { if n == 0 -> false else -> even(n - 1) }
