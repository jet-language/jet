// Ordinary files run only their explicit `fn run` body. Module declarations
// remain available to every function in the file.
LIMIT :: 2
counter := 0

fn run() {
    print("script entry")
    print(LIMIT)
    counter += LIMIT
    print(counter)
    print(even(LIMIT + 2))
    print(helper())
}

fn helper() -> String { "declaration" }

fn even(n: Int) -> Bool { if n == 0 -> true else -> odd(n - 1) }

fn odd(n: Int) -> Bool { if n == 0 -> false else -> even(n - 1) }
