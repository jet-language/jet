// S74: tuple bindings use member names, never positions.
fn transition() -> (before: Int, after: String) {
    (before: 10, after: "ready")
}

fn run() {
    // The written binding order need not match the tuple's member order.
    (before, after) :: transition()
    print("by name: {before} -> {after}")

    // Dotless record patterns rename members explicitly.
    { before: name, after: value } :: transition()
    print("renamed: {name} -> {value}")

    // A partial record pattern marks omitted members with `..`.
    { after: latest, .. } :: transition()
    print("partial: {latest}")

    // Mutable tuple bindings follow the same member-name rule.
    { after: end, before: start } := transition()
    start += 1
    end += "!"
    print("mutable: {start} -> {end}")

    // Two-binding loops still bind the index/key and item/value.
    loop (index, item) in [7] {
        print("list loop: {index} {item}")
    }
    loop (key, item) in ["only": 9] {
        print("map loop: {key} {item}")
    }
}
