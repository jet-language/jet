// D-BYTESDECODE1=A: hex decoding is strict and does not trim or repair input.
use core.encoding.hex as hex

fn run() {
    valid :: hex.decode("4869") ?? return Err("valid hex failed")
    print("valid-len={valid.len()}")

    // An ordinary binding would propagate failure; this policy probe handles
    // the decoder's carrier locally and retains its typed error.
    if hex.decode(" 4869 ") == {
        .Ok(_) -> { print("whitespace=accepted") }
        .Err(error) -> { print("whitespace={error}") }
    }

    if hex.decode("abc") == {
        .Ok(_) -> { print("odd=accepted") }
        .Err(error) -> { print("odd={error}") }
    }

    if hex.decode("zz") == {
        .Ok(_) -> print("non-hex=accepted")
        .Err(error) -> print("non-hex={error}")
    }
}
