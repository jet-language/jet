// S41: `String.len()` counts Unicode scalars, the same with `core.text` in
// scope as without it. UTF-8 byte length has its own names.
use core.text as text

fn run() {
    word :: "héllo"
    print(word.len())
    print(word.chars().len())
    print(text.scalar_count(word))
    print(word.count_bytes())
    print(text.byte_count(word))
}
