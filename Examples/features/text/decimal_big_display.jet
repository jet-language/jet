// A Decimal whose coefficient spans several machine words prints every digit
// with its decimal point in the right place, wherever the point falls among
// the words: inside the top word, at a word boundary, inside a lower word, and
// before every digit.
fn run() {
    print(Decimal("123456789012345678901234567890.5").to_string())
    print(Decimal("1.234567890123456789012345678901").to_string())
    print(Decimal("123456789.123456789123456789").to_string())
    print(Decimal("-98765432109876543210.000000001").to_string())
    print(Decimal("0.000000000123456789012345678901").to_string())
    big :: Decimal("99999999999999999999.99") + Decimal("0.01")
    print(big.to_string())
}
