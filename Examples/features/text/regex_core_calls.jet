// D-REGEX-CORE-CALLS1: direct core.regex find, match, and split-limit calls.
use core.regex as re

fn run() {
    result :: re.find(Regex{"[0-9]+"}, "id=42")
    print(result ?? "missing")
    matches :: re.matches(Regex{"([0-9]+)"}, "id=42 zip=90210")
    print(matches.len())
    parts :: re.split_limit(Regex{","}, "a,b,c", 2)
    print(parts)
}
