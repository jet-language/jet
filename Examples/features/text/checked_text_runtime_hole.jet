// A checked text literal whose hole is a run-time value is built when it
// runs: each hole goes through encode_hole, and check sees the complete text.
// A literal whose holes are constants is still checked before the program runs.
#Error
enum TokenError { Empty TooLong }

Token :: distinct String

impl Token.CheckedText {
    type Error = TokenError

    fn check(text: String) TokenError! -[]> {
        if text == "" -> return Err(TokenError.Empty)
        if text.len() > 20 -> return Err(TokenError.TooLong)
        return Ok(())
    }

    fn encode_hole<T: Printable>(value: T) -[]> String {
        return "[{value}]"
    }
}

fn show(value: Token) {
    #Unsafe("checked text example output") {
        print(value.raw())
    }
}

fn greet(name: String) -> Token {
    Token{"hello {name}"}
}

fn run() {
    name :: "Ada"
    show(Token{"hi {name}"})
    count := 2
    count += 1
    show(Token{"n={count}"})
    show(greet("Lin"))
    show(Token{"fixed {7}"})
}
