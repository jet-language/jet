// `remove_prefix`/`remove_suffix` drop one exact edge (else the text is
// unchanged); `pad_start`/`pad_end` pad to a width with whole fill units.
fn run() {
    print("KW_FN".remove_prefix("KW_"))
    print("main.jet".remove_suffix(".jet"))
    print("main.jet".remove_prefix("KW_"))
    print("7".pad_start(3, "0"))
    print("ab".pad_end(4, "."))
    print("long".pad_start(2, "0"))
}
