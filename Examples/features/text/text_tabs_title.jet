use core.text.parse as parse

// Tab stops count decoded scalars, not UTF-8 bytes or display columns.
// Uncased text is not titlecase; cased words start upper/title and continue lower.
fn run() {
    print("|{parse.expandtabs("é\tx", 4)}|")
    print("|{parse.expandtabs("界\tx", 4)}|")
    print("|{parse.expandtabs("ab\tc\nd\te", 4)}|")
    print("|{parse.expandtabs("é\t界\nx\té", 4)}|")
    cr :: String.from_bytes([U8]{13}) ?? ""
    print(parse.expandtabs("é\tx{cr}界\tx", 4) == ("é   x{cr}界   x"))
    print(parse.expandtabs("é\tx{cr}\n界\tx", 4) == ("é   x{cr}\n界   x"))
    print("|{parse.expandtabs("é\t界", 0)}|")
    print("|{parse.expandtabs("é\t界", -4)}|")
    print("|{parse.expandtabs("\t", 4)}|")
    print("|{parse.expandtabs("abcd\tx", 4)}|")
    print("|{parse.expandtabs("", 4)}|")
    print(parse.is_title("456"))
    print(parse.is_title("Title 456"))
    print(parse.is_title(""))
    print(parse.is_title("Hello World"))
    print(parse.is_title("Hello world"))
    print(parse.is_title("HeLLo"))
    print(parse.is_title("Élan Vital"))
    print(parse.is_title("123 Abc"))
    print(parse.is_title("A1B"))
    print(parse.is_title("Abc-def"))
    print(parse.is_title("Abc-Def"))
    print(parse.istitle("456"))
    print(parse.istitle("Title 456"))
}
