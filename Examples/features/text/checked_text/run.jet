// D-TEXTHEAD-TYPE1=A: checked text is ordinary nominal data plus one ordinary
// CheckedText implementation. This example keeps the library types in a
// module, then imports them through the normal type namespace.
use types.[Pattern, Query, Selector, Identity]

module types

fn keep<T>(value: T) -> T { value.copy() }

fn run() {
    pattern :: keep(Pattern{"literal {7}"})
    print(pattern.raw())
    pattern_source :: "dynamic pattern"
    // The `.Ok`/`.Err` match consumes the Result; a bound call would
    // propagate its failure.
    if Pattern.from(pattern_source) == {
        .Ok(value) -> { print(value.raw()) }
        .Err(error) -> print(types.explain(error))
    }

    query :: keep(Query{"select id where id = {7}"})
    print(query.raw())
    query_source :: "not a query"
    if Query.from(query_source) == {
        .Ok(value) -> { print(value.raw()) }
        .Err(error) -> print(types.explain(error))
    }

    selector :: keep(Selector{".item[data-id={7}]"})
    print(selector.raw())
    selector_source :: "missing selector"
    if Selector.from(selector_source) == {
        .Ok(value) -> { print(value.raw()) }
        .Err(error) -> print(types.explain(error))
    }

    identity :: keep(Identity{"user+{7}@example.test"})
    print(identity.raw())
    identity_source :: "missing-at-sign"
    if Identity.from(identity_source) == {
        .Ok(value) -> print(value.raw())
        .Err(error) -> print(types.explain(error))
    }
}
