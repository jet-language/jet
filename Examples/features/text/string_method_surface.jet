// The built-in String, Bytes and number method surface: one call per method
// that the other text examples do not already exercise.
fn run() {
    word :: "Jet Lang"
    print(word.len())
    print("héllo".len())
    print("héllo".count_bytes())
    print("".is_empty())
    print(word.to_upper())
    print(word.to_lower())
    print(word.upper())
    print(word.lower())
    print("jet lang".title())
    print("Straße".casefold())
    print(word.contains("Lang"))
    print(word.starts_with("Jet"))
    print(word.ends_with("Lang"))
    print(word.startswith("J"))
    print(word.endswith("x"))
    print(word.replace("Lang", "Language"))
    print("ab".repeat(3))
    print(word.slice(0, 4))
    print(word.index("Lang"))
    print(word.find("Lang"))
    print(word.rfind("a"))
    print(word.rindex("a"))
    print("  pad  ".strip())
    print("  pad  ".lstrip())
    print("  pad  ".rstrip())
    print("7".zfill(3))
    print("ab".center(6, "*"))
    print("ab".ljust(4, "-"))
    print("ab".rjust(4, "-"))
    print("2024".isdigit())
    print("ab1".isalnum())
    print("snake_case".isidentifier())
    parts :: "key=value".partition("=")
    print(parts.head)
    print(parts.sep)
    print(parts.tail)
    print("one\ntwo\nthree".lines().len())
    print("abc".chars().len())
    print("abc".bytes().len())
    number :: "42".parse() ?? 0
    print(number + 1)
    print("17".to_int() ?? 0)
    print("2.5".to_float() ?? 0.0)
    print(42.to_string())
    print(255.to_radix(16))
    print(-7.div_euclid(2))
    print(-7.rem_euclid(2))
    print(12.count_ones())
    print(8.trailing_zeros())
    small :: U8.from_int(250) ?? panic("U8")
    print(small.checked_add(10) == None)
    print(small.wrapping_add(10))
    print(small.saturating_add(10))
    ratio :: "2.5".to_float() ?? 0.0
    print(ratio.is_finite())
    print(ratio.is_nan())
    print("ab".to_string())
    print(false.to_string())
}
