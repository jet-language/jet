// D-TEXTUNICODE1: core.text owns Unicode algorithms; String stays small.
use core.text as text
use core.text.[caseless_eq]
use core.text.wrap as text_wrap

fn run() {
    assert(text.inspect("A")[0] == "U+0041 LATIN CAPITAL LETTER A")
    assert(text.inspect("\n")[0] == "U+000A LINE FEED (LF)")
    assert(text.inspect("α")[0] == "U+03B1 GREEK SMALL LETTER ALPHA")
    sample :: "é👍"
    print("bytes: {text.byte_count(sample)}")
    print("scalars: {text.scalar_count(sample)}")
    print("graphemes: {text.graphemes(sample).len()}")
    print("columns: {text.display_width(sample)}")
    family :: "👨‍👩‍👦"
    print(text.inspect(family)[1])
    print(caseless_eq("Straße", "STRASSE"))
    print(text.nfc("é") == "é")
    print(text.nfkc("ﬃ"))
    print(text.lower("ΟΣ"))
    print(text.upper("ßև"))
    print(text.words("Hi, κόσμε 123.").len())
    print(text.sentences("One. Two!").len())
    print(text.display_width("表a"))
    print(text.display_width("1️⃣"))
    print(text.display_width("©️"))
    print(text.display_width("́‍"))
    // D-TEXTWIDTH1=B uses portable width, including narrow ambiguous scalars.
    print(text.display_width("·"))
    print(text.is_alphabetic("Ж"))
    print(text.is_numeric("٣"))
    print(text.pad_start("7", 3, "0"))
    print(text.center("x", 3, "."))
    print(text.starts_any("jetpack", ["jet", "go"]))
    print(text.char_indices("éa")[1])
    print(text_wrap.wrap("界 x", 4)[0])
}
