package {
    name: "text_uuid"
    version: "0.1.0"
    authority: { holds: { allow: [IO, Mem.Alloc, Rand, Time] } }
}
// D-UUIDENC1=A: UUID v4 and v7. #1481: parse (validate/normalize) and v5
// (deterministic namespace+name, RFC 4122 SHA-1).
use core.crypto.uuid as uuid
use core.time as time

fn run() {
    // v4 is non-deterministic — check shape only
    id :: uuid.v4()
    print(id.len() == 36)
    print(id.contains("-"))
    // v7 with an injected clock — deterministic
    clk := Clock.new(1_700_000_000_000)
    id7 :: uuid.v7(&clk)
    print(id7.len() == 36)
    print(id7.contains("-"))
    // version nibble is '7' (`.slice` excludes the end: one character)
    print(id7.slice(14, 15) == "7")
    // the first 48 bits are the big-endian Unix milliseconds (RFC 9562 5.7)
    print(id7.slice(0, 13) == "018bcfe5-6800")
    // parse validates and lowercases; a malformed string is an error.
    normalized :: uuid.parse("6BA7B810-9DAD-11D1-80B4-00C04FD430C8") ?? panic("parse failed")
    print(normalized)
    if uuid.parse("not-a-uuid") == {
        .Ok(_) -> { print(false) }
        .Err(_) -> { print(true) }
    }
    // v5 is deterministic: same namespace + name always yields the same UUID
    // (RFC 4122 Appendix B test vector: DNS namespace + "python.org").
    dns_namespace :: "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
    v5a :: uuid.v5(dns_namespace, "python.org") ?? panic("v5 failed")
    v5b :: uuid.v5(dns_namespace, "python.org") ?? panic("v5 failed")
    print(v5a == v5b)
    print(v5a)
}
