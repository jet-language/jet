// #4745 / I2: bytes reads owned text and trim's borrowed window equally.
fn run() {
    input :: "  café  "
    trimmed :: input.trim()
    print(trimmed.bytes() == [U8]{99, 97, 102, 195, 169})
    print(input.trim().bytes() == trimmed.bytes())
    print(input.bytes().len())
    blank :: "   "
    print(blank.trim().bytes().len())
}
