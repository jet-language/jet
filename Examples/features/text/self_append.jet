// Self-append through interpolation: `s = "{s}…"` keeps the meaning of
// building a new text, while a String the variable owns grows in place.
label: fn(n: Int) -> String {
    return "#{n}"
}

run: fn() {
    // The common loop: each step appends to the text it already owns.
    csv := ""
    loop i in 0..<5 -> csv = "{csv}{i * i},"
    print(csv)

    // A copy taken before the append keeps its own text.
    first: csv.copy()
    csv = "{csv}done"
    print(first)
    print(csv)

    // Literal-only and call parts append the same way.
    path := "root"
    path = "{path}/"
    path = "{path}{label(7)}/{label(8)}"
    print(path)

    // A rest that reads the text itself sees the text before this step.
    echo := "ab"
    echo = "{echo}-{echo.count_bytes()}-{echo}"
    print(echo)

    // Many steps: linear growth, the same text a builder would join.
    big := ""
    loop i in 0..<20000 -> big = "{big}{i % 10}"
    print("bytes {big.count_bytes()} tail {big.slice(19990, 20000)}")
}
