// `{c:Debug}` on a Char is quoted and escaped, like a Char literal; `{c}`
// is the raw character.
fn run() {
    chars :: [Char]{'a', '\'', '"', '\\', '\n', '\t', '\r', 'é', '中', '😀'}
    loop c in chars {
        print("{c:Debug}")
    }
    print("{chars:Debug}")
    accent :: 'é'
    quote :: '"'
    slash :: '\\'
    print("{accent} {quote} {slash}")
}
