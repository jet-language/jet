package {
    name: "safety_sh_checked_text"
    version: "0.1.0"
    authority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }
}

// D-FFI-SH1: process.cmd keeps each argument separate, so spaces and shell
// metacharacters stay data rather than becoming shell syntax.
use core.process as process

fn run() -[Exec, Time.Wait]> {
    value :: "two words;*.jet"
    spec :: process.cmd(["printf", "<%s>", value])
    result :: process.run_spec(spec) ?? panic("process")
    print(result.output)
}
