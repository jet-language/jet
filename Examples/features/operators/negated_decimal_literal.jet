// #4646: unary minus on a parenthesized fractional literal. Parentheses are
// transparent (D-FMTPARENS1), so `-(2.5)` is the exact Decimal `-2.5`, the
// same value as the unparenthesized literal.
fn run() {
    a :: -(2.5)
    b :: -((0.125))
    print("{a} {b}")
    print("{a == -2.5} {b == -0.125}")
}
