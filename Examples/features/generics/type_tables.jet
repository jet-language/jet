// A generic function branches on its type parameter with an ordinary `if`
// table (D-TYPESWITCH1). Each arm reads `T` as the type it names; `else`
// sees only `T`'s bounds. Every instance keeps just its own arm.

#Printable
Point: struct {
    x: Int
    y: Int
}

// Value position: the table is the function's result.
describe: fn<T: Printable>(value: T) -> String {
    if T == {
        Int -> "whole number {value + 1} after {value}"
        String -> "text of {value.len()} bytes"
        Point -> "point at {value.x},{value.y}"
        else -> "something else: {value}"
    }
}

// Matching is exact type identity: a bare `2.5` is a Decimal, so only a
// value typed `Float` takes the `Float` arm.
scale: fn<T>(value: T) -> String {
    if T == {
        Float -> "float {value * 2.0} doubled"
        else -> "not a Float"
    }
}

as_float: fn(value: Float) -> Float {
    value
}

// Statement position: arms run statements.
weigh: fn<T>(value: T) -> Int {
    weight := 0
    if T == {
        Int -> weight = value * 10
        Bool -> {
            weight = 1
            if value -> weight = 2
        }
        else -> weight = -1
    }
    weight
}

// Inside an arm the return type reads `T` as the arm's type too.
bump: fn<T>(value: T) -> T {
    if T == {
        Int -> value + 100
        String -> "{value}!"
        else -> value
    }
}

// The one-arm test: `if T == Int { … }`, as `if x == .A { … }` is for enums.
double_ints: fn<T>(value: T) -> Int {
    result := 0
    if T == Int {
        result = value * 2
    }
    result
}

// `comptime` changes nothing: every type table already folds per instance.
text_size: fn<T>(value: T) -> Int {
    comptime if T == String {
        return value.len()
    }
    -1
}

run: fn() {
    print(describe(41))
    print(describe("hello"))
    print(describe(Point{x: 3, y: 4}))
    print(describe(true))
    print(scale(as_float(1.25)))
    print(scale(2.5))
    print(scale(7))
    print(weigh(7))
    print(weigh(false))
    print(weigh(true))
    print(weigh("x"))
    print(bump(1))
    print(bump("hey"))
    print(bump(true))
    print(double_ints(21))
    print(double_ints("no"))
    print(text_size("four"))
    print(text_size(4))
}
