// `T.$fields` is the compile-time list of a struct's fields, so
// `P.$fields.len()` inside `comptime` folds to the field count while the
// program compiles. The count follows the declaration: adding a field to
// `Point` changes the printed number with no other edit.
struct Point {
    x: Int
    y: Int
    label: String
}

fn run() {
    count :: comptime { Point.$fields.len() }
    print("Point has {count} fields")
}
