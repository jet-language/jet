// D-COMPILER-NS1=A / D-META-ROOT3=A / D-BUILD-FACT3=A / D-DECL-META1=A:
// compiler facts carry `$`. A fact is a `$` member of the thing it describes,
// build and package facts hang off the `$build` and `$package` roots, and a
// marker declaration marks its compiler metadata with `$`.
#Numeric
Severity: distinct Int(0..10)

Audited: struct {
    impl Marker {
        sites: [.Type]
    }
}

#Audited
Order: struct {
    state { Draft, Confirmed }

    id: Int
}

RANGE: comptime { Severity.$range }

STATES: comptime { Order.$states }

PACKAGE_NAME: comptime { $package.name }

PACKAGE_VERSION: comptime { $package.version }

PROFILE: comptime { $build.profile }

run: fn() {
    comptime if $build.os == {
        .Linux -> { print("linux") }
        .MacOS -> { print("macos") }
        .Windows -> { print("windows") }
    }
    print(RANGE.start)
    print(STATES[0].name)
    print(PACKAGE_NAME)
    print(PACKAGE_VERSION)
    print(PROFILE)
}
