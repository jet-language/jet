// Trait constants: a trait declares `name: Type` (with a default as
// `name: Type{value}`), each implementation gives `name :: value`, and code
// reads `Type.name` on a type or `T.name` through a bound.
enum Tone {
    Plain
    Loud
}

trait Shape {
    sides: Int
    label: String{"shape"}
    tone: Tone{.Plain}
    angles: [Int]
    fn area(self) -> Float
}

struct Square {
    side: Float
}

impl Square.Shape {
    sides :: 4
    label :: "square"
    angles :: [90, 90, 90, 90]

    fn area(self) -> Float { self.side * self.side }
}

struct Triangle {
    base: Float
    height: Float
}

impl Triangle.Shape {
    sides :: 3
    tone :: Tone.Loud
    angles :: [60, 60, 60]

    fn area(self) -> Float { self.base * self.height / 2.0 }
}

fn tone_name(tone: Tone) -> String {
    if tone == {
        .Plain -> "plain"
        .Loud -> "loud"
    }
}

fn describe<T: Shape>(shape: T) -> String {
    "{T.label}: {T.sides} sides, {T.angles.len()} angles, {tone_name(T.tone)}, area {shape.area()}"
}

fn run() {
    print("Square.sides = {Square.sides}")
    print("Triangle.label = {Triangle.label}")
    print("Square.tone = {tone_name(Square.tone)}")
    print("Triangle.tone = {tone_name(Triangle.tone)}")
    print("Square.angles = {Square.angles}")
    print(describe(Square{side: 2.0}))
    print(describe(Triangle{base: 3.0, height: 4.0}))
}
