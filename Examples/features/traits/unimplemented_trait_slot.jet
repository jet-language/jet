// A trait that no type in the program implements is still a valid slot type.
// Such a slot can only hold None, so a call through it is unreachable; every
// tier (interpreter, JIT, dev and release builds) compiles the call site and
// takes the None path.
trait HostAdapter {
    fn handle_call(self, operation: String, raw: Int) -> Int?
}

fn release(adapter: HostAdapter?, raw: Int) -> Int {
    found :: adapter ?? return -1
    found.handle_call("release", raw) ?? 0
}

fn run() {
    print(release(None, 7))
}
