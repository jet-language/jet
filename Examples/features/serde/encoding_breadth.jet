// D-ENCSTREAM1: format breadth over one value tree.
use {
    encoding :: core.encoding
    json :: core.encoding.json
    jsonl :: core.encoding.jsonl
    xml :: core.encoding.xml
    cbor :: core.encoding.cbor
    base64 :: core.encoding.base64
    base32 :: core.encoding.base32
}

fn run() {
    data :: json.parse("{{\"b\":2,\"a\":1}}")
    print(json.canonical(data))
    print(json.events(data).contains(encoding.DataEvent.ObjectStart))
    rows :: jsonl.parse("{{\"a\":1}}\n{{\"a\":2}}\n")
    print(rows.len())
    print((jsonl.to_string(rows) ?? panic("JSONL encode")).contains("\"a\":1"))
    doc :: xml.parse("<r xmlns:h=\"urn:h\"><h:c id=\"7\">ok</h:c></r>") ?? panic("xml parse")
    print(xml.to_string(doc) ?? panic("xml render"))
    encoded :: cbor.to_bytes(data)
    print(encoded.len() > 0)
    decoded :: cbor.parse(encoded)
    print(json.canonical(decoded))
    bytes :: [U8]{104, 105}
    u :: base64.encode_url(bytes)
    print(u)
    print(bytes.len())
    b32 :: base32.encode(bytes)
    print(b32)
    print(bytes.len())
}
