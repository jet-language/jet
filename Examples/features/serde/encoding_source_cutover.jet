use core.encoding.base32 as base32
use core.encoding.base64 as base64
use core.encoding.hex as hex
use core.encoding.json as json
use core.encoding.cbor as cbor
use core.encoding.[DataEvent, EncodingCause, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits]

#Test("alphabet source routes preserve established decoder vectors") {
    assert_eq(base32.b32decode("MZXW6===") ?? panic("base32"), "foo".bytes())
    assert_eq(base32.b32hexdecode("CPNMU===") ?? panic("base32hex"), "foo".bytes())
    assert_eq(base64.decode("Zm9v") ?? panic("base64"), "foo".bytes())
    assert_eq(base64.decode_url("-_8=") ?? panic("base64url"), [U8]{251, 255})
    assert_eq(base64.decodebytes("Zm9v\n") ?? panic("base64 lines"), "foo".bytes())
    assert_eq(hex.a2b_base64("Zm9v\n") ?? panic("hex base64"), "foo".bytes())
}

struct Row { value: Int }
#Test("typed JSON source cutover retains exact numbers and render parity") {
    row :: json.decode<Row>("{{\"value\":9007199254740993}}") ?? panic("typed JSON")
    assert_eq(row.value, 9007199254740993)
    assert_eq(json.to_string(Row{value: 7}) ?? panic("JSON encode"), "{{\"value\":7}}")
    assert_eq(json.to_string_pretty(Row{value: 7}) ?? panic("JSON encode"), "{{\n  \"value\": 7\n}}")
    if json.decode<Row>("{{") == {
        .Err(errors) -> assert_eq(errors[0].path, "")
        .Ok(_) -> panic("malformed JSON accepted")
    }
}

#Test("source encoding error rendering retains the optional location ladder") {
    error :: EncodingError.new(.JSON, .Syntax, 4, Val(2), Val(3), "$[0]", "bad token")
    assert_eq("{error}", "JSON Syntax at byte 4, line 2, column 3, path $[0]: bad token")
    caused :: error.with_cause(EncodingCause{kind: "Interrupted", os_code: Val(4), message: "interrupted"})
    assert_eq("{caused:Debug}", "JSON Syntax at byte 4, line 2, column 3, path $[0]: bad token")
    assert_eq(caused.cause(), Val(EncodingCause{kind: "Interrupted", os_code: Val(4), message: "interrupted"}))
    event :: DataEvent.Number("abc")
    if event == .Number(text) -> assert_eq(text, "abc") else -> panic("Number is not matchable")
    assert_eq(EncodingLimits.safe().buffer_bytes, 65536)
}

fn main() Never! {}
