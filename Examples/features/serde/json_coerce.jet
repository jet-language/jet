// D-JSON3: lenient JSON decode (core.encoding.json.decode) surfaces coercions via log lines.
// Each string value that is coerced to a number or boolean emits one structured
// log line to stderr naming the field and the from→to types.
// The decoded value comes back plain — usable directly (no wrapper).
use core.encoding.json as json

// D-FAIL-CONV1: retain the codec's error type instead of converting to default Err.
fn run() EncodingError! {
    // "port" is a string in the JSON source but coerces to a number.
    // "enabled" is a string "true" that coerces to a boolean.
    raw :: "{{\"port\":\"8080\",\"enabled\":\"true\",\"name\":\"api\"}}"
    data :: json.decode(raw)
    if data == .Object(entries) {
        port :: entries["port"]
        name :: entries["name"]
        enabled :: entries["enabled"]
        if port == .Float(n) {
            // Lenient JSON's canonical numeric coercion uses Float; project
            // this integral test value back to Int before adding one.
            print((Int.from_float(n) ?? 0) + 1)
        }
        if name == .Text(s) -> print(s)
        if enabled == .Bool(b) -> print(b)
    }
}
