use core.encoding.json as json

// D-FAIL-CONV1: retain the codec's error type instead of converting to default Err.
fn run() EncodingError! {
    raw :: "{{\"name\":\"jet\",\"ok\":true,\"items\":[1,2]}}"
    data :: json.parse(raw)
    print(json.to_string(data) ?? return Err(err))
    print((json.to_string_pretty(data) ?? return Err(err)).contains("\n"))
    // Key count without `if data == .Object(entries)` — that shape still deopts
    // resident JIT on the Map payload Let (kept in serde/json_coerce).
    keys :: ["items", "name", "ok"]
    print(keys.len())
    print(
    json.to_string(
    Dyn.Object(
    [
        "name": Dyn.Text("jet"),
        "ok": Dyn.Bool(true),
    ],
    ),
    ) ?? return Err(err),
    )
}
