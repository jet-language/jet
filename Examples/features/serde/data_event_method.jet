// A method builds `DataEvent` payload variants through a grouped
// `use core.encoding.[DataEvent]` import, as the `core.encoding.json` reader does.
use core.encoding.[DataEvent]

Recorder: struct {
    events: [DataEvent]
}

impl Recorder {
    key: fn(&self, name: String) Never! {
        &self.events.push(DataEvent.Key(name))
    }
}

run: fn() {
    recorder := Recorder{events: [DataEvent]{}}
    &recorder.key("name")
    print(recorder.events.len())
    if recorder.events[0] == .Key(name) -> print(name)
}
