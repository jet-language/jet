// core.encoding.xml profile: well-formed XML 1.0 data parsing (D-ENCXML1).
// Each case is one cell of the supported/unsupported table. The node tree is
// lossless: a doctype and entity references round-trip as written, and the
// parser never fetches external resources, expands undeclared entities, or
// executes markup; it is a data parser, not an HTML parser and not a renderer.
// Rejections report the closed `XMLReason`.
use xml: core.encoding.xml

reason_name: fn(kind: xml.XMLReason) -> String {
    if kind == {
        .InvalidEncoding -> "InvalidEncoding"
        .Malformed -> "Malformed"
        .MismatchedTag -> "MismatchedTag"
        .InvalidName -> "InvalidName"
        .Namespace -> "Namespace"
        .DuplicateAttribute -> "DuplicateAttribute"
        .Entity -> "Entity"
        .EntityCycle -> "EntityCycle"
        .Limit -> "Limit"
        .Canonicalization -> "Canonicalization"
        .Shape -> "Shape"
        .Unsupported -> "Unsupported"
    }
}

show: fn(label: String, text: String) {
    tree: xml.parse(text) ?? {
        kind: reason_name(err.kind)
        print("{label}: rejected {kind}: {err.reason}")
        return
    }
    rendered: xml.to_string(tree) ?? panic(err.reason)
    print("{label}: accepted {rendered}")
}

nested: fn(depth: Int) -> String {
    open: "<a>".repeat(depth)
    close: "</a>".repeat(depth)
    "{open}{close}"
}

run: fn() {
    show("doctype", "<!DOCTYPE note SYSTEM \"http://example.com/note.dtd\"><note/>")
    show("internal entity decl", "<!DOCTYPE r [<!ENTITY x \"boom\">]><r>&x;</r>")
    show("unknown entity", "<r>&unknown;</r>")
    show("predefined entities", "<r>&lt;&gt;&amp;&quot;&apos;</r>")
    show("numeric entities", "<r>&#65;&#x42;&#x1F600;</r>")
    show("prefixed namespace", "<x:r xmlns:x=\"urn:example\"><x:item x:id=\"1\">v</x:item></x:r>")
    show("xinclude element", "<r xmlns:xi=\"http://www.w3.org/2001/XInclude\"><xi:include href=\"/etc/passwd\"/></r>")
    show("script element", "<r><script>alert(1)</script></r>")
    show("xml declaration", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><r>ok</r>")
    show("html void tag", "<p>line<br>next</p>")
    loop depth in [256, 257, 10000] {
        tree: xml.parse(nested(depth)) ?? {
            kind: reason_name(err.kind)
            print("depth {depth}: rejected {kind}: {err.reason}")
            next
        }
        rendered: xml.to_string(tree) ?? panic(err.reason)
        print("depth {depth}: accepted {rendered.len()} bytes")
    }
}
