package {
    name: "serde_encoding_jsonl_stream"
    version: "0.1.0"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}

// D-ENCSTREAM-SURFACE1=A: bounded JSONL reader/writer lifecycle.
// - A record is one line, so two values on one line are an error, never two
//   records (multi-root JSON is not JSONL).
// - Each failure names its record (`$[n]`), stream line and byte offset, and
//   stays sticky: the next read reports the same error.
// - The reader holds one bounded buffer: `max_item_bytes` and
//   `max_total_bytes` stop it with a Limit error. An unfinished final record
//   is Truncated.
// - Splitting is disclosed: `jsonl.parse` is eager and returns every record
//   or one error, while the reader yields the records before a bad one.
// - Cancelling the consuming task stops the read at its next wait point.
use {
    encoding :: core.encoding
    json :: core.encoding.json
    jsonl :: core.encoding.jsonl
    files :: core.files
}

fn write_catalog(path: Path) -> Bool (EncodingError | IOError)! {
    output :: files.create(path) ?? return Err(err)
    writer := jsonl.writer(^output, encoding.EncodingLimits.safe()) ?? return Err(err)
    &writer.write(Dyn.Object(["ok": Dyn.Bool(true)])) ?? return Err(err)
    &writer.write(Dyn.Object(["n": Dyn.Int(2)])) ?? return Err(err)
    &writer.flush() ?? return Err(err)
    &writer.finish() ?? return Err(err)
    return Ok(true)
}

// Read every record, then show that a failure stays sticky.
fn drain(label: String, path: Path, limits: encoding.EncodingLimits) IOError! {
    input :: files.open(path) ?? return Err(err)
    reader := jsonl.reader(^input, limits) ?? {
        print("{label}: refused {err}")
        return Ok(())
    }
    loop {
        if &reader.next() == {
            .Ok(next) -> {
                row :: next ?? {
                    print("{label}: eof")
                    return Ok(())
                }
                print("{label}: record {json.canonical(row) ?? "?"}")
            }
            .Err(error) -> {
                print("{label}: {error}")
                if &reader.next() == {
                    .Ok(_) -> print("{label}: read again succeeded")
                    .Err(again) -> print("{label}: read again {again.kind == error.kind && again.byte_offset == error.byte_offset}")
                }
                return Ok(())
            }
        }
    }
}

fn read_until_cancel(path: Path, started: Sender<Int>, gate: Receiver<Int>) -> Int (EncodingError | IOError)! {
    input :: files.open(path) ?? return Err(err)
    reader := jsonl.reader(^input) ?? return Err(err)
    count := 0
    loop {
        _row :: &reader.next() ?? break
        count += 1
        started.send(count)
        _ :: gate.receive() ?? 0
    }
    Ok(count)
}

fn failure_label(error: TaskFailure) -> String {
    if error == {
        .Panicked(reason) -> { return "panicked: {reason}" }
        .DeadlineBlown -> { return "deadline" }
        .Cancelled -> { return "cancelled" }
    }
}

fn run() (EncodingError | IOError)! {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-jsonl") ?? return
    path :: Path.from(scratch.path).join("catalog.jsonl")
    write_catalog(path) ?? return
    drain("catalog", path, encoding.EncodingLimits.safe()) ?? return

    files.write(path.to_string(), "{{\"a\":1}}\n{{\"b\":2}} {{\"c\":3}}\n") ?? return
    drain("two values on one line", path, encoding.EncodingLimits.safe()) ?? return

    files.write(path.to_string(), "{{\"a\":1}}\n{{\"c\":") ?? return
    drain("unfinished final record", path, encoding.EncodingLimits.safe()) ?? return

    files.write(path.to_string(), "{{\"a\":1}}\n\n{{\"b\":\"a long text value\"}}\n") ?? return
    item := encoding.EncodingLimits.safe()
    item.max_item_bytes = 16
    drain("max_item_bytes 16", path, item) ?? return
    total := encoding.EncodingLimits.safe()
    total.max_total_bytes = Val(12)
    drain("max_total_bytes 12", path, total) ?? return
    buffer := encoding.EncodingLimits.safe()
    buffer.buffer_bytes = 4
    drain("buffer_bytes 4", path, buffer) ?? return

    // Eager splitting: `parse` holds the whole text and returns no records
    // when one fails; the reader above yielded the records before it.
    if jsonl.parse("{{\"a\":1}}\n{{\"b\":2}} {{\"c\":3}}\n") == {
        .Ok(rows) -> print("eager parse: {rows.len()} records")
        .Err(error) -> print("eager parse: no records, {error}")
    }

    lines := [String]{}
    loop index in 0..<5 -> &lines.push("{{\"n\":{index}}}")
    files.write(path.to_string(), lines.join("\n")) ?? return
    { sender: started_tx, receiver: started_rx } :: channel<Int>(capacity: 1)
    { sender: gate_tx, receiver: gate_rx } :: channel<Int>(capacity: 1)
    worker :: task read_until_cancel(path, started_tx, gate_rx)
    print("cancel: read {started_rx.receive() ?? -1} record before cancel")
    worker.cancel()
    if ^worker.join() == {
        .Ok(count) -> print("cancel: finished after {count} records")
        .Err(error) -> print("cancel: {failure_label(error)}")
    }
    gate_tx.close()
}
