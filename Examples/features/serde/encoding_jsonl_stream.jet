package {
    name: "serde_encoding_jsonl_stream"
    version: "0.1.0"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}

// D-ENCSTREAM-SURFACE1=A: bounded JSONL reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.jsonl as jsonl
use core.files as files

fn write_catalog(path: Path) -> Bool (EncodingError | IOError)! {
    output :: files.create(path) ?? return Err(err)
    writer := jsonl.writer(^output, encoding.EncodingLimits.safe()) ?? return Err(err)
    &writer.write(Dyn.Object(["ok": Dyn.Bool(true)])) ?? return Err(err)
    &writer.flush() ?? return Err(err)
    &writer.finish() ?? return Err(err)
    return Ok(true)
}

fn run() (EncodingError | IOError)! {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-jsonl") ?? return
    path :: Path.from(scratch.path).join("catalog.jsonl")
    write_catalog(path) ?? return
    input :: files.open(path) ?? return
    reader := jsonl.reader(^input) ?? return
    loop {
        item :: &reader.next() ?? return Err(err)
        _value :: item ?? break
        print("record")
    }
    print("eof")
}
