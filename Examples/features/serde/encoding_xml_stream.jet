package {
    name: "serde_encoding_xml_stream"
    version: "0.1.0"
    authority: { holds: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] } }
}

// D-ENCSTREAM-SURFACE1=A: bounded XML reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.xml as xml
use core.files as files

fn xml_name(local: String) -> Dyn {
    return Dyn.Object(
    [
        "raw": Dyn.Text(local.copy()),
        "prefix": Dyn.Null,
        "local": Dyn.Text(local.copy()),
        "namespace_uri": Dyn.Null,
    ],
    )
}

fn write_catalog(path: Path) -> Bool (EncodingError | IOError)! {
    output :: files.create(path) ?? return Err(err)
    writer :: xml.writer(^output, encoding.EncodingLimits.safe()) ?? return Err(err)
    writer.write(Dyn.Object(["$xml_event": Dyn.Text("document_start"), "encoding": Dyn.Null, "bom": Dyn.Array([])])) ?? return Err(err)
    semantic :: Dyn.Object(
    [
        "name": xml_name("r"),
        "namespaces": Dyn.Array([]),
        "attributes": Dyn.Array([]),
        "empty_style": Dyn.Text("empty"),
    ],
    )
    open_lexical :: Dyn.Object(
    [
        "raw_text": Dyn.Null,
        "raw_bytes": Dyn.Null,
        "semantic": semantic,
    ],
    )
    root_event :: Dyn.Object(
    [
        "$xml_event": Dyn.Text("element_start"),
        "name": xml_name("r"),
        "namespaces": Dyn.Array([]),
        "attributes": Dyn.Array([]),
        "empty_style": Dyn.Text("empty"),
        "open_lexical": open_lexical,
    ],
    )
    writer.write(root_event) ?? return Err(err)
    writer.write(Dyn.Object(["$xml_event": Dyn.Text("document_end")])) ?? return Err(err)
    &writer.flush() ?? return Err(err)
    writer.finish() ?? return Err(err)
    return Ok(true)
}

fn run() (EncodingError | IOError)! {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-xml") ?? return
    path :: Path.from(scratch.path).join("catalog.xml")
    write_catalog(path) ?? return
    input :: files.open(path) ?? return
    reader :: xml.reader(^input) ?? return
    loop event in reader -> print("event")
    print("eof")
}
