// E2-M9: jet.csv — parse a delimited table with physical row metadata.
use core.encoding.csv as csv

fn run() {
    raw :: "name,score,grade\nAlice,95,A\nBob,\"82\",B\nCarol,71,C"
    rows :: csv.rows(raw, header: true, skip_blank: true) ?? panic("csv parse failed")
    loop row in rows {
        fields :: row.fields
        print("{row.line}: {fields[0]}: {fields[1]}")
    }
}
