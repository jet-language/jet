// D-ENCBASE-STRICT1: base64/base32 decoding is strict RFC 4648 by default;
// transport-shaped input is admitted only through a named allowance.
use core.encoding.base64 as base64
use core.encoding.base32 as base32

fn run() {
    // MIME line breaks: `decodebytes` allows ASCII whitespace, `decode` rejects it.
    mime :: base64.decodebytes("Zg==\n")
    print(mime.len())
    // No lowercase allowance exists for base32: the canonical alphabet decodes.
    canonical :: base32.decode("MY======")
    print(canonical.len())
}
