package {
    name: "serde_encoding_cbor_stream"
    version: "0.1.0"
    authority: { holds: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc] } }
}

// D-ENCSTREAM-SURFACE1=A: bounded CBOR reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.cbor as cbor
use core.files as files

fn write_catalog(path: Path) -> Bool (EncodingError | IOError)! {
    output :: files.create(path) ?? return Err(err)
    writer :: cbor.writer(^output, encoding.EncodingLimits.safe()) ?? return Err(err)
    &writer.write(encoding.DataEvent.ObjectStart) ?? return Err(err)
    &writer.write(encoding.DataEvent.Key("ok")) ?? return Err(err)
    &writer.write(encoding.DataEvent.Bool(true)) ?? return Err(err)
    &writer.write(encoding.DataEvent.ObjectEnd) ?? return Err(err)
    &writer.flush() ?? return Err(err)
    writer.finish() ?? return Err(err)
    return Ok(true)
}

fn run() (EncodingError | IOError)! {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-cbor") ?? return
    path :: Path.from(scratch.path).join("catalog.cbor")
    write_catalog(path) ?? return
    input :: files.open(path) ?? return
    reader :: cbor.reader(^input) ?? return
    loop event in reader -> print("event")
    print("eof")
}
