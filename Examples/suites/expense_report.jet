// User story: a shop owner wants a small daily expense report.
LineItem: struct {
    label: String
    cents: Int
}

total: fn(items: [LineItem]) -> Int {
    sum := 0
    loop item in items -> sum += item.cents
    return sum
}

run: fn() {
    items: [LineItem]{
        {label: "coffee", cents: 450},
        {label: "sandwich", cents: 875},
        {label: "tea", cents: 325}
    }
    print("items: {items.len()}")
    print("total cents: {total(items)}")
}
