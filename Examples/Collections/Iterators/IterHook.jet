// 180 — D-ITER-HOOK: zero-copy `loop x in mytype` via Iterable + Iterator
Crate: struct {
    data: [Int]
}

BagIter: struct {
    bag: Crate
    idx: Int
}

impl BagIter.Iterator {
    Item: Int

    next: fn(&self) -> Int? {
        if self.idx >= self.bag.data.len() -> return None
        v: self.bag.data[self.idx]
        self.idx += 1
        return Val(v)
    }
}

impl Crate.Iterable {
    Iter: BagIter

    iter: fn(&&self) -> BagIter { return BagIter{bag: self, idx: 0} }
}

run: fn() {
    b: Crate{data: [10, 20, 30]}
    sum := 0
    loop n in b -> sum += n
    print("sum: {sum}")
}
