// `next` pulls one item from the same source and leaves the
// exact remainder. Built-in and user iterators share one exclusive receiver.
Crate: struct {
    data: [Int]
}

BagIter: struct {
    bag: Crate
    idx: Int

    impl Iterator {
        Item: Int

        next: fn(&self) -> Int? {
            if self.idx >= self.bag.data.len() -> return None
            v: self.bag.data[self.idx]
            self.idx += 1
            return Val(v)
        }
    }
}

// Stops at the first item above `limit`; everything after it stays unread.
first_over: fn(items: &Iter<Int>, limit: Int) -> Int? {
    loop {
        item: items.next() ?? return None
        if item > limit -> return Val(item)
    }
}

run: fn() {
    items := [1, 2, 3].lazy()
    print(items.next())
    print(items.next())
    print(items.to_list())

    bag := BagIter{bag: Crate{data: [7]}, idx: 0}
    print(bag.next())
    print(bag.next())
    print(bag.next())

    numbers := [1, 5, 2, 8, 3].lazy()
    print(first_over(numbers, 4))
    print(numbers.to_list())
}
