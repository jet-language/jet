// Named tuples order member by member in written order. So a (key, index)
// pair sorts by `key` first, then `index`. Member order is part of the type:
// (index, key) is another type, and it sorts by `index` first. sort_by names
// any other order. The same order holds for <, sort_desc, Map and Set keys,
// at run time and at compile time.
written_order: fn(pairs: [(key: String, index: Int)]) -> [(key: String, index: Int)] {
    sorted := pairs.copy()
    sorted.sort()
    sorted
}

show: fn(title: String, pairs: [(key: String, index: Int)]) {
    out := "{title}:"
    loop pair in pairs -> out = "{out} {pair.key}{pair.index}"
    print(out)
}

PAIRS: #run written_order([(key: "c", index: 0), (key: "a", index: 2), (key: "b", index: 1), (key: "a", index: 1)])

run: fn() {
    pairs := [(key: "c", index: 0), (key: "a", index: 2), (key: "b", index: 1), (key: "a", index: 1)]
    pairs.sort()
    show("sort", pairs)
    pairs.sort_desc()
    show("sort_desc", pairs)
    pairs.sort_by(fn(left, right) { (left.index <=> right.index).then(left.key <=> right.key) })
    show("by index", pairs)
    show("comptime", PAIRS)

    // `key` decides first; `index` only breaks a tie.
    print((key: "z", index: 0) < (key: "a", index: 1))
    print((key: "a", index: 1) < (key: "a", index: 2))
    // The same members written index first compare by `index` first.
    print((index: 0, key: "z") < (index: 1, key: "a"))

    // A Map iterates its keys in this order: `y` before `x`, as written. A
    // Set keeps no order, and its sort() gives the same order.
    cells := [(y: Int, x: Int):String]{}
    cells[(y: 0, x: 2)] = "east"
    cells[(y: 5, x: 1)] = "north"
    cells[(y: 1, x: 1)] = "center"
    loop (cell, name) in cells -> print("x{cell.x} y{cell.y} {name}")
    seen := Set.from([(y: 9, x: 0), (y: 0, x: 9), (y: 3, x: 0), (y: 9, x: 0)])
    out := "set sorted:"
    loop cell in seen.sort() -> out = "{out} ({cell.x},{cell.y})"
    print(out)
}
