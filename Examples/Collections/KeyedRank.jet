// `Rank.by(key)` keeps its items with the smallest key first and
// `by_desc(key)` with the largest; items with equal keys stay in the order
// they went in, and an item already held is not added again.
// `from_by(xs, key)` and `from_by_desc(xs, key)` start from the items of a
// List. Set operations keep the receiver's order. `new()` and `from(xs)`
// keep the item's own order.
run: fn() {
    words := Rank.by((w: String) -> w.len())
    print(words.add("pear"))
    words.add("fig")
    words.add("kiwi")
    words.add("apple")
    print(words.add("fig"))
    print(words.to_list())
    print(words.first() ?? "")
    print(words.last() ?? "")
    print(words.has("kiwi"))
    print(words.has("plum"))
    words.remove("pear")
    out := "walk:"
    loop word in words.to_list() -> out = "{out} {word}"
    print(out)
    kept := words
    kept.add("ab")
    print(kept.to_list())
    print(words.len())

    longest := Rank.from_by_desc(["bb", "a", "ccc", "dd", "a"], (w: String) -> w.len())
    print(longest.to_list())

    digits := Rank.by_desc((n: Int) -> n)
    digits.add(3)
    digits.add(9)
    digits.add(1)
    plain := Rank.from([4, 9, 2])
    print(digits.union(plain).to_list())
    print(plain.union(digits).to_list())
    print(digits.intersection(plain).to_list())
    print(digits.difference(plain).to_list())
    print(digits.symmetric_difference(plain).to_list())
    print(digits.is_subset(Rank.from([1, 3, 9, 10])))
    print(digits.is_disjoint(Rank.from([2, 4])))

    cells := Rank.from_by([(y: 9, x: 0), (y: 0, x: 9), (y: 3, x: 1), (y: 9, x: 0)], (c: (x: Int, y: Int)) -> c.x)
    line := "cells:"
    loop cell in cells.to_list() -> line = "{line} ({cell.x},{cell.y})"
    print(line)
    print(cells.has((y: 3, x: 1)))
    cells.remove((y: 9, x: 0))
    print(cells.len())
    cells.clear()
    cells.add((y: 1, x: 5))
    cells.add((y: 2, x: 4))
    if cells.first() == .Val(first) -> print("first: ({first.x},{first.y})")
}
