// Beginner whole-value base encodings.
use {
    core.encoding.base64
    core.encoding.base32
}

run: fn() {
    hello: [U8]{104, 101, 108, 108, 111}
    padded: base64.encode(hello)
    print(padded)
    print(hello.len())
    url: base64.encode_url(hello)
    print(url)
    print(hello.len())
    coded: base32.encode(hello)
    print(coded)
    print(hello.len())
}
