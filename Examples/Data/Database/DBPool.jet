// The bounded DB pool exposes acquire, readiness, receipt, and drain.
package: {
    name: "db_pool"
    authority: { allow: [DB, IO, Mem.Alloc, Time.Wait] }
}

use db: core.db

run: fn() {
    pool: db.pool(":memory:", max: 1) ?? return
    print("ready:{pool.ready() ?? false}")
    print("receipt:{pool.receipt()}")
    lease: pool.acquire(deadline: 100ms) ?? return
    print("lease:{lease}")
    lease.close() ?? return
    print("drain:{pool.drain() ?? return}")
    handoff()
}

// A pool handed to a function is spelled `DBPool` in its signature.
describe: fn(pool: DBPool) -> String {
    ready: pool.ready() ?? false
    "pool ready: {ready}"
}

handoff: fn() {
    pool: db.pool(":memory:", max: 1) ?? return
    print(describe(pool))
    _receipt: pool.drain() ?? return
    print("drained")
}
