// Accumulated validation: a `validate { }` section
// declares rules beside the fields it checks — the struct stays the one
// schema (I8). Every failing `check` accumulates into `[FieldError]` instead
// of stopping at the first one, so a form can show every problem at once.
// The generated decode runs the same rules on the value it decodes.
use core.encoding.json

Signup: struct {
    email: String
    password: String

    validate {
        check(email.len() > 0, at: email, "email required")
        check(password.len() >= 12, at: password, "needs at least 12 characters")
        check(password != email, at: password, "password can't be the email")
    }
}

report: fn(label: String, signup: Signup) {
    if Signup.validate(signup) == {
        .Ok(v) -> { print("{label}: ok ({v.email})") }
        .Err(errs) -> {
            print("{label}: {errs.len()} problem(s)")
            loop e in errs -> print("  {e.path}: {e.reason}")
            return
        }
    }
}

report_over: fn(label: String, signup: Signup, allow_short: Bool) {
    if Validate.over(signup).check(signup.email.len() > 0, at: email, "email required").check(allow_short || signup.password.len() >= 12, at: password, "needs at least 12 characters").finish() == {
        .Ok(v) -> { print("{label}: ok ({v.email})") }
        .Err(errs) -> {
            print("{label}: {errs.len()} problem(s)")
            loop e in errs -> print("  {e.path}: {e.reason}")
            return
        }
    }
}

decode: fn(label: String, text: String) {
    signup: json.decode<Signup>(text) ?? {
        print("{label}: {err.len()} problem(s)")
        loop e in err -> print("  {e.path}: {e.reason}")
        return
    }
    print("{label}: ok ({signup.email})")
}

run: fn() {
    report("bad", Signup{email: "", password: "short"})
    report("same", Signup{email: "a@b.com", password: "a@b.com"})
    report("good", Signup{email: "a@b.com", password: "supersecretpw"})
    report_over("over", Signup{email: "", password: "short"}, false)
    report_over("over-context", Signup{email: "a@b.com", password: "short"}, true)
    decode("decode-same", "{{\"email\":\"a@b.com\",\"password\":\"a@b.com\"}}")
    decode("decode-good", "{{\"email\":\"a@b.com\",\"password\":\"supersecretpw\"}}")
}
