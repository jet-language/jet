// #PublishedSchema structs + migration blocks.
//
// A published record's field layout is locked at release — readers of
// old serialised data must still work. When a field changes, a
// `migration` block tells the compiler how old data maps to the new shape.
// Without it the compiler refuses to build.
//
// The canonical fixtures are `fixture-state/cache/schema/*.snapshot`.
// The golden harness stages them as `.jet/cache/schema` in an external scratch
// project, keeping measured/source state out of the checkout.
//
// The simple case: `UserRecord` renames `name` -> `display_name`.
#PublishedSchema UserRecord: struct {
    display_name: String
    age: Int
}

migration UserRecord {
    rename name -> display_name
}

// Every op on one record. The `Profile` snapshot records the 1.0.0 shape:
// legacy_id: Int, id: Int, name: String, score: Int. This release reshapes it:
//
//   remove legacy_id          — a field is gone
//   rename name -> title      — a field changed name
//   change score: Int -> MemberRank — a field changed type, with an inline
//                                     `via` converter
//   add active: Bool = true   — a new field, with a default for records
//                               written before it existed
//
// Reordering fields (title before id) is not a tracked change and needs no op.
MemberRank: struct {
    value: Int
}

#PublishedSchema Profile: struct {
    title: String
    id: Int
    score: MemberRank
    active: Bool
}

migration Profile {
    remove legacy_id
    rename name -> title
    change score: Int -> MemberRank via { n -> MemberRank{ value: n } }
    add active: Bool = true
}

run: fn() {
    u: UserRecord{display_name: "Alice", age: 30}
    print("user: {u.display_name}, age: {u.age}")
    p: Profile{title: "Ada", id: 7, score: MemberRank{value: 95}, active: true}
    print("profile: {p.title} #{p.id}, rank {p.score.value}, active {p.active}")
}
