// An uncaught `[FieldError]` from a typed decode ends the program with exit 1.
// The report's message is the same text `print(errors)` shows: one
// `at `path`: reason` entry per failed field, on every tier.
use core.encoding.json

Service: struct {
    name: String
    port: Int
}

run: fn() [FieldError]! {
    service: json.decode<Service>("{{\"name\":7,\"port\":\"http\"}}")
    print(service.name)
}
