// A typed table stores a `#Secret` field through the storage codec, and the wire codec leaves it off.
// The `jet_row` column keeps the whole row, the secret included, and a row
// read back from the table still holds it. The same row's wire form
// (`json.to_string`, through `.encode()`) has no `token` key.
package: {
    name: "table_secret_field"
    authority: { allow: [DB, IO] }
}

use {
    db: core.db
    json: core.encoding.json
}

#Codable
Account: struct {
    id: Int,
    name: String,
    token: #Secret String,
}

// The text the table stored for every row, in key order.
stored: fn(store: db.Store) -[DB]> String {
    policy: db.policy("accounts", "true") ?? panic("policy")
    rows: store.with_policy(policy, "system").query(SQL{"SELECT jet_row FROM accounts ORDER BY key"}) ?? panic("raw read")
    out := [String]{}
    loop row in rows {
        cell: row.get("jet_row") ?? panic("no jet_row column")
        out.push(cell.text() ?? panic("jet_row is not text"))
    }
    out.join(" ")
}

run: fn() {
    store: db.open_memory()
    accounts: store.table("accounts", key: fn(account: Account) { account.id })
    _: accounts.add(Account{id: 1, name: "ann", token: "s3cr3t"}) ?? panic("add")
    print("stored: {stored(store)}")
    account: accounts.get(1) ?? panic("get 1")
    wire: json.to_string(account) ?? panic("JSON encode")
    print("wire: {wire}")
    // The row read back is put again: its secret survived the read.
    _: accounts.put(account) ?? panic("put")
    print("stored after a read and a put: {stored(store)}")
}
