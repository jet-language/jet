// 120 — generic #Codable. The derive auto-adds `T: Encode`/
// `T: Decode` bounds for the type params that reach the wire — the user never
// spells them. `Wrap<T>` round-trips for any codable `T`; `Tagged<K>`'s `K`
// is phantom (its only field is `#Skip`), so `Tagged` serializes regardless
// of `K` — the derive injects no Encode/Decode bound on `K`.
// (This demo struct was originally named `Id<K>` — renamed to
// `Tagged<K>` once `Id<T>` became the reserved `Pool<T>` handle type.)
use json: core.encoding.json

#Codable
Wrap: struct<T> {
    value: T
}

#Codable
Tagged: struct<K> {
    raw: Int
    #Skip marker: K?
}

run: fn() [FieldError]! {
    wi: Wrap<Int>{value: 7}
    print(json.to_string(wi) ?? panic("JSON encode"))
    back: json.decode<Wrap<Int>>("{{\"value\":42}}")
    print(back.value)
    ws: Wrap<String>{value: "hi"}
    print(json.to_string(ws) ?? panic("JSON encode"))
    // Phantom param: K never reaches the wire, so Tagged<Wrap<Int>> encodes with
    // no Encode bound on K. The #Skip field is omitted from the wire entirely.
    id: Tagged<Wrap<Int>>{raw: 9, marker: None}
    print(json.to_string(id) ?? panic("JSON encode"))
    rid: json.decode<Tagged<Wrap<Int>>>("{{\"raw\":3}}")
    print(rid.raw)
}
