// A typed table's row with a `#Secret` field upgrades through the migration block and keeps the secret.
// The storage codec has its own walk over the older stored shapes, which hold
// the secret, so the old `{id, name, token}` row reads as the current
// `{id, title, done, token}` one, and `upgrade` stores it with the token.
package: {
    name: "table_secret_migration"
    authority: { allow: [DB, IO] }
}

use {
    db: core.db
    json: core.encoding.json
}

#Codable
OldAccount: struct {
    id: Int
    name: String
    token: #Secret String
}

#Codable(published) Account: struct {
    id: Int
    title: String
    active: Bool
    token: #Secret String
}

migration Account {
    rename name -> title
    add active: Bool = true
}

// The text the table stored for every row, in key order.
stored: fn(store: db.Store) -[DB]> String {
    policy: db.policy("accounts", "true") ?? panic("policy")
    rows: store.with_policy(policy, "system").query(SQL{"SELECT jet_row FROM accounts ORDER BY key"}) ?? panic("raw read")
    out := [String]{}
    loop row in rows {
        cell: row.get("jet_row") ?? panic("no jet_row column")
        out.push(cell.text() ?? panic("jet_row is not text"))
    }
    out.join(" ")
}

run: fn() {
    store: db.open_memory()
    previous: store.table("accounts", key: fn(account: OldAccount) { account.id })
    _: previous.add(OldAccount{id: 1, name: "ann", token: "s3cr3t"}) ?? panic("add")
    print("stored before: {stored(store)}")

    accounts: store.table("accounts", key: fn(account: Account) { account.id })
    account: accounts.get(1) ?? panic("get 1")
    wire: json.to_string(account) ?? panic("JSON encode")
    print("wire: {wire}")
    upgraded: accounts.upgrade() ?? panic("upgrade")
    print("upgraded: {upgraded}")
    print("stored after the upgrade: {stored(store)}")
}
