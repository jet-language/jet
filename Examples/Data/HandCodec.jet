// Hand-written and derived codecs share one public protocol.
// Email owns a bare-string wire form; Signup's generated codec composes it.
use json: core.encoding.json

Email: struct {
    address: String
}

impl Email.Encode {
    encode: fn(self) -> Dyn { Dyn.Text(self.address.copy()) }
}

impl Email.Decode {
    decode: fn(tree: Dyn) -> Email [FieldError]! {
        address: tree.text()
        if !address.contains("@") {
            return Err([FieldError{path: "", reason: "not a valid email: {address}"}])
        }
        return Ok(Email{address: address})
    }
}

Signup: struct {
    name: String
    email: Email
}

run: fn() [FieldError]! {
    signup: Signup{name: "Ada", email: Email{address: "ada@lovelace.org"}}
    wire: json.to_string(signup) ?? panic("JSON encode")
    print(wire)
    decoded: json.decode<Signup>(wire)
    print(decoded.email.address)
}
