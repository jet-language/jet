package: {
    name: "tooling_data_pipeline"
    version: "0.1.0"
    authority: { allow: [IO, Mem.Alloc] }
}

use data: core.data

Ticket: struct {
    team: String
    minutes: Float
}

Budget: struct {
    team: String
    owner: String
}

must_stay_deferred: fn(ticket: Ticket) -> Bool Never! {
    panic("lazy filter ran before collect")
    return false
}

no_minutes: fn() -> Float? { None }

run: fn() {
    raw: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nDocs,3.0"
    rows: data.csv<Ticket>(raw) ?? panic("bad csv")
    budget_raw: "team,owner\nCore,Ada\nCore,Lin\nTools,Grace"
    budgets: data.csv<Budget>(budget_raw) ?? panic("bad budget")

    deferred: data.query(rows).filter(fn(t) { must_stay_deferred(t) })
    print("deferred: {deferred.plan()[1]}")
    planned: data.query(rows)
        .filter(fn(t) { t.minutes >= 4.0 })
        .sort_by(fn(t) { t.team })
    planned_rows: planned.collect() ?? panic("collect")
    focused: data.query(rows).filter(fn(t) { t.minutes >= 4.0 }).collect() ?? panic("filter")
    sorted: data.query(focused).sort_by(fn(t) { t.team }).collect() ?? panic("sort")
    groups: data.query(sorted)
        .group_by(fn(t) { t.team })
        .sum(fn(t) { t.minutes })
        .collect() ?? panic("group_sum")
    counts: data.query(sorted)
        .group_by(fn(t) { t.team })
        .count()
        .collect() ?? panic("count")
    joined: data.inner_join(sorted, budgets, fn(t) { t.team }, fn(b) { b.team }) ?? panic("join")
    left: data.left_join(rows, budgets, fn(t) { t.team }, fn(b) { b.team }) ?? panic("left")
    pivot: data.pivot_sum(rows, fn(t) { t.team }, fn(t) { if t.minutes >= 5.0 -> "long" else -> "short" }, fn(t) { t.minutes }) ?? panic("pivot")
    values: [Float]{4.0, 5.0, 8.0, 3.0}
    summary: data.describe(values) ?? panic("describe")
    rolling: data.rolling_mean(values, 2) ?? panic("rolling")
    maybe_minutes: [Val(Float{4.0}), no_minutes(), Val(Float{8.0}), no_minutes()]
    series: maybe_minutes
    print(sorted.len())
    print(rows.len())
    print(planned_rows.len())
    print(planned.plan()[2])
    loop ticket in planned_rows -> print("planned: {ticket.team} {ticket.minutes}")
    print("series rows: {series.len()}")
    print(data.bar_text(counts) ?? panic("bar"))
    loop pair in joined -> print("join: {pair.left.team} -> {pair.right.owner}")
    loop pair in left {
        if pair.right == {
            .Val(budget) -> { print("left: {pair.left.team} -> {budget.owner}") }
            .None -> { print("left: {pair.left.team} -> none") }
        }
    }
    loop cell in pivot {
        print("{cell.row_key}|{cell.column_key} count={cell.count} sum={cell.sum}")
    }
    print(summary.count)
    print(summary.median)
    print(rolling[2])
}
