package: {
    name: "serde_encoding_json_stream"
    version: "0.1.0"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}

// Bounded JSON reader/writer lifecycle. CBOR and CSV streams share the same
// writer/reader shape.
use {
    encoding: core.encoding
    core.encoding.cbor
    core.encoding.csv
    core.encoding.json
    files: core.files
    testing: core.testing
}

write_catalog: fn(path: Path) -> Bool (EncodingError | IOError)! {
    out: files.create(path) ?? return Err(err)
    // Skip the `limits` default and name only the policy that changes.
    writer := json.writer(out, canonical: true) ?? return Err(err)
    writer.write(encoding.DataEvent.ObjectStart) ?? return Err(err)
    writer.write(encoding.DataEvent.Key("b")) ?? return Err(err)
    writer.write(encoding.DataEvent.Int(2)) ?? return Err(err)
    writer.write(encoding.DataEvent.Key("a")) ?? return Err(err)
    writer.write(encoding.DataEvent.Int(1)) ?? return Err(err)
    writer.write(encoding.DataEvent.ObjectEnd) ?? return Err(err)
    writer.flush() ?? return Err(err)
    writer.finish() ?? return Err(err)
    return Ok(true)
}

run: fn() (EncodingError | IOError)! {
    // `testing.temp_dir` is the shared-Prelude scratch mechanism on every tier.
    path: Path.from(testing.temp_dir("encoding-json-stream")).join("catalog.json")
    write_catalog(path) ?? return
    input: files.open(path) ?? return
    reader := json.reader(input) ?? return
    read_count := 0
    loop {
        // A failed read propagates; `??` handles the end of the stream.
        event: reader.next() ?? break
        if event == {
            .ObjectStart -> { print("event:ObjectStart") }
            .Key(key) && key == "b" -> { print("event:Key:b") }
            .Int(value) && value == 2 -> { print("event:Int:2") }
            .Key(key) && key == "a" -> { print("event:Key:a") }
            .Int(value) && value == 1 -> { print("event:Int:1") }
            .ObjectEnd -> { print("event:ObjectEnd") }
            // The writer above emits only the five events handled here. Keep
            // the reader total if the event contract gains another variant.
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .ArrayStart | .ArrayEnd | .Key(_) -> {
                print("event:unexpected")
            }
        }
        read_count += 1
    }
    print("read-count:{read_count}")
    print("eof")
    text: files.read(path.to_string()) ?? return
    print(text)
    files.remove(path) ?? return
    other_formats() ?? return
}

// The same lifecycle for binary CBOR events and CSV records.
other_formats: fn() (EncodingError | IOError)! {
    dir: Path.from(testing.temp_dir("encoding-other-streams"))
    cbor_path: dir.join("catalog.cbor")
    cbor_out: files.create(cbor_path) ?? return Err(err)
    cbor_writer := cbor.writer(cbor_out, encoding.EncodingLimits.safe()) ?? return Err(err)
    cbor_writer.write(encoding.DataEvent.ObjectStart) ?? return Err(err)
    cbor_writer.write(encoding.DataEvent.Key("ok")) ?? return Err(err)
    cbor_writer.write(encoding.DataEvent.Bool(true)) ?? return Err(err)
    cbor_writer.write(encoding.DataEvent.ObjectEnd) ?? return Err(err)
    cbor_writer.flush() ?? return Err(err)
    cbor_writer.finish() ?? return Err(err)
    cbor_reader := cbor.reader(files.open(cbor_path) ?? return Err(err)) ?? return Err(err)
    cbor_events := 0
    loop {
        _event: cbor_reader.next() ?? break
        cbor_events += 1
    }
    print("cbor events:{cbor_events}")

    csv_path: dir.join("catalog.csv")
    csv_out: files.create(csv_path) ?? return Err(err)
    csv_writer := csv.writer(csv_out, encoding.EncodingLimits.safe()) ?? return Err(err)
    csv_writer.write(["ok", "true"]) ?? return Err(err)
    csv_writer.flush() ?? return Err(err)
    csv_writer.finish() ?? return Err(err)
    csv_reader := csv.reader(files.open(csv_path) ?? return Err(err)) ?? return Err(err)
    csv_records := 0
    loop {
        _record: csv_reader.next() ?? break
        csv_records += 1
    }
    print("csv records:{csv_records}")
    return Ok()
}
