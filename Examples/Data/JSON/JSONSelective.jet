package: {
    name: "serde_json_selective"
    version: "0.1.0"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}
// #3280: full versus selective JSON decoding, side by side, on one document
// with 20 fields. Three paths read it:
// - `json.parse`: validates and materializes the whole value.
// - `json.decode<Small>`: projects 1 of the 20 fields. It still validates and
//   materializes the whole document before projecting, so a fault in a
//   skipped field or after the root rejects it on the same line the full
//   parse names.
// - `json.reader`: the explicit incremental path. It validates only what it
//   has read. A consumer that stops after the first key never sees a later
//   fault; a consumer that drains it fails at the bad bytes, after the events
//   before them.
// There is no demanded-prefix or lazy extraction in ordinary decode: the
// projection never weakens validation. Nothing a decode returns borrows the
// input text, so the text can end before the value does.
use {
    encoding: core.encoding
    json: core.encoding.json
    files: core.files
    testing: core.testing
}

Small: struct {
    a: Int
}

Labeled: struct {
    a: Int
    label: String
}

// The decoded text is owned: the source string ends with this call.
owned_projection: fn() -> Labeled {
    source: "{{\"a\":7,\"label\":\"kept\",\"skipped\":[1,2,3]}}"
    json.decode<Labeled>(source) ?? panic("decode labeled")
}

kind_name: fn(kind: encoding.EncodingErrorKind) -> String {
    if kind == {
        .Syntax -> "Syntax"
        .Truncated -> "Truncated"
        .Unsupported -> "Unsupported"
        .Limit -> "Limit"
        .IO -> "IO"
        .State -> "State"
    }
}

// The document: field `a`, then 19 skipped fields; `tail` replaces the last.
document: fn(tail: String, after: String) -> String {
    fields := [String]{"\"a\":1"}
    loop index in 1..<19 -> fields.push("\"f{index}\":[{index},{{\"k\":\"v{index}\"}}]")
    fields.push(tail.copy())
    "{{{fields.join(",")}}}{after}"
}

full: fn(label: String, text: String) -> Int? {
    tree: json.parse(text) ?? {
        line: err.line ?? 0
        print("{label} full: {kind_name(err.kind)} at line {line} byte {err.byte_offset}: {err.reason}")
        return Val(line)
    }
    print("{label} full: ok, {tree.len()} fields materialized")
    None
}

projected: fn(label: String, text: String, full_line: Int?) {
    value: json.decode<Small>(text) ?? {
        same: if full_line == .Val(line) -> err.len() == 1 && err[0].reason.starts_with("invalid JSON (line {line}):") else -> false
        print("{label} projected: rejected {err}; same line as full: {same}")
        return
    }
    print("{label} projected: ok a={value.a}; full rejected it: {full_line != None}")
}

first_key: fn(label: String, path: Path) (EncodingError | IOError)! {
    input: files.open(path) ?? return Err(err)
    events := json.reader(input) ?? return Err(err)
    _start: events.next() ?? return Ok()
    key: events.next() ?? return Ok()
    if key == {
        .Key(name) -> print("{label} reader: stopped after first key `{name}`; the rest is unread")
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .ArrayStart | .ArrayEnd | .ObjectStart | .ObjectEnd -> print("{label} reader: the first event after the root is not a key")
    }
    Ok()
}

drained: fn(label: String, path: Path) (EncodingError | IOError)! {
    input: files.open(path) ?? return Err(err)
    events := json.reader(input) ?? return Err(err)
    count := 0
    loop {
        if events.next() == {
            .Ok(next) -> {
                _: next ?? break
                count += 1
            }
            .Err(error) -> {
                line: error.line ?? 0
                print("{label} reader: {kind_name(error.kind)} after {count} events at line {line} byte {error.byte_offset}: {error.reason}")
                return Ok()
            }
        }
    }
    print("{label} reader: ok, {count} events")
}

run: fn() (EncodingError | IOError)! {
    cases: [
        (label: "valid", text: document("\"f19\":null", "")),
        (label: "malformed skipped field", text: document("\"f19\":[1,]", "")),
        (label: "trailing garbage", text: document("\"f19\":null", " x")),
        (label: "second root", text: document("\"f19\":null", "\n{{}}")),
        (label: "duplicate key in skipped field", text: document("\"f19\":{{\"k\":1,\"k\":2}}", "")),
        (label: "bad escape in skipped string", text: document("\"f19\":\"\\q\"", "")),
        (label: "truncated", text: document("\"f19\":[1,2", "").removesuffix("}}")),
    ]
    path: Path.from(testing.temp_dir("json-selective")).join("doc.json")
    loop case in cases {
        full_line: full(case.label, case.text)
        projected(case.label, case.text, full_line)
        files.write(path.to_string(), case.text) ?? return
        first_key(case.label, path) ?? return
        drained(case.label, path) ?? return
    }
    files.remove(path) ?? return
    kept: owned_projection()
    print("owned projection after its source ended: a={kept.a} label={kept.label}")
}
