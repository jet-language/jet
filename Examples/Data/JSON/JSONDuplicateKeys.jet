package: {
    name: "serde_json_duplicate_keys"
    version: "0.1.0"
    authority: { allow: [Exec, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}
// Duplicate JSON object names. `parse`, typed `decode`,
// and the file-backed `reader` reject a repeated name with the key and its
// position; the reader yields the events before the repeat, then fails.
// `parse_allow_duplicates` is the named opt-in that keeps the later value, and
// `reader_allow_duplicates` reports every occurrence as its own events.
// Tracking the names already seen is charged to the reader's bounded heap:
// a strict reader stops with a Limit error on an object too wide for its
// limits, where the allow reader, which tracks nothing, reads it whole.
use {
    encoding: core.encoding
    json: core.encoding.json
    files: core.files
    testing: core.testing
}

CountRecord: struct {
    count: Int
}

kind_name: fn(kind: encoding.EncodingErrorKind) -> String {
    if kind == encoding.EncodingErrorKind.Syntax -> return "Syntax"
    "other"
}

event_name: fn(event: DataEvent) -> String {
    if event == {
        .ObjectStart -> return "object start"
        .ObjectEnd -> return "object end"
        .Key(name) -> return "key {name}"
        .Int(n) -> return "int {n}"
        else -> return "other"
    }
    "other"
}

strict_parse: fn(text: String) {
    tree: json.parse(text) ?? {
        line: err.line ?? 0
        column: err.column ?? 0
        print("parse: {kind_name(err.kind)} at `{err.path}` line {line} column {column}: {err.reason}")
        return
    }
    print("parse: unexpectedly accepted {json.canonical(tree) ?? panic("canonical")}")
}

strict_decode: fn(text: String) {
    record: json.decode<CountRecord>(text) ?? {
        print("decode<CountRecord>: rejected {err}")
        return
    }
    print("decode<CountRecord>: unexpectedly accepted {record.count}")
}

strict_reader: fn(path: Path) (EncodingError | IOError)! {
    input: files.open(path) ?? return Err(err)
    events := json.reader(input) ?? return Err(err)
    loop {
        if events.next() == {
            .Ok(next) -> {
                event: next ?? {
                    print("reader: unexpectedly reached the end")
                    return Ok(())
                }
                print("reader: {event_name(event)}")
            }
            .Err(err) -> {
                line: err.line ?? 0
                column: err.column ?? 0
                print("reader: {kind_name(err.kind)} at `{err.path}` line {line} column {column}: {err.reason}")
                return Ok(())
            }
        }
    }
}

allow_reader: fn(path: Path) (EncodingError | IOError)! {
    input: files.open(path) ?? return Err(err)
    events := json.reader_allow_duplicates(input) ?? return Err(err)
    loop {
        // A failed read propagates; `??` handles the end of the stream.
        event: events.next() ?? break
        print("allow reader: {event_name(event)}")
    }
}

// Count events until the end or the first error.
wide_reader: fn(label: String, path: Path, allow: Bool, limits: encoding.EncodingLimits) (EncodingError | IOError)! {
    input: files.open(path) ?? return Err(err)
    events := if allow -> json.reader_allow_duplicates(input, limits) ?? return Err(err) else -> json.reader(input, limits) ?? return Err(err)
    count := 0
    loop {
        if events.next() == {
            .Ok(next) -> {
                _: next ?? break
                count += 1
            }
            .Err(err) -> {
                print("{label}: {encoding_kind(err.kind)} after {count} events: {err.reason}")
                return Ok(())
            }
        }
    }
    print("{label}: {count} events")
}

encoding_kind: fn(kind: encoding.EncodingErrorKind) -> String {
    if kind == encoding.EncodingErrorKind.Limit -> return "Limit"
    kind_name(kind)
}

run: fn() (EncodingError | IOError)! {
    text: "{{\"count\":2,\"count\":3}}"
    strict_parse(text)
    strict_decode(text)
    // `testing.temp_dir` is the shared-Prelude scratch mechanism on every tier.
    path: Path.from(testing.temp_dir("json-duplicate-keys")).join("count.json")
    files.write(path.to_string(), text) ?? return
    strict_reader(path) ?? return
    later: json.parse_allow_duplicates(text) ?? panic("allowed parse")
    print("allow parse: {json.canonical(later) ?? panic("canonical")}")
    allow_reader(path) ?? return
    files.remove(path) ?? return
    // 2,000 distinct names under limits sized for the values, not the names.
    names := [String]{}
    loop index in 0..<2000 -> names.push("\"key-{index}-padded-to-a-longer-object-name\":0")
    wide: Path.from(testing.temp_dir("json-duplicate-keys")).join("wide.json")
    files.write(wide.to_string(), "{{{names.join(",")}}}") ?? return
    limits := encoding.EncodingLimits.safe()
    limits.buffer_bytes = 4096
    limits.max_item_bytes = 4096
    limits.max_expansion_bytes = 0
    limits.max_depth = 8
    wide_reader("wide strict reader", wide, false, limits) ?? return
    wide_reader("wide allow reader", wide, true, limits) ?? return
    files.remove(wide) ?? return
}
