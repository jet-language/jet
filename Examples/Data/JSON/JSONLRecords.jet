// JSONL record boundaries over text you already hold (`jsonl.parse`,
// `jsonl.first`): one complete JSON value per line, `\r\n` accepted,
// blank lines skipped. Two values on one line are a syntax error, not two
// records, and an unfinished final record is truncated. Errors carry the
// record index in `path` plus the stream line and byte offset.
use {
    encoding: core.encoding
    core.encoding.json
    core.encoding.jsonl
}

kind_name: fn(kind: encoding.EncodingErrorKind) -> String {
    if kind == encoding.EncodingErrorKind.Syntax -> return "Syntax"
    if kind == encoding.EncodingErrorKind.Truncated -> return "Truncated"
    "other"
}

whole: fn(label: String, text: String) {
    rows: jsonl.parse(text) ?? {
        line: err.line ?? 0
        column: err.column ?? 0
        print("{label}: {kind_name(err.kind)} at `{err.path}` line {line} column {column} byte {err.byte_offset}: {err.reason}")
        return
    }
    print("{label}: {rows.len()} records")
}

// Stopping after the first record parses nothing past it.
first_only: fn(text: String) {
    row: jsonl.first(text) ?? panic("first record")
    print("early exit after {json.canonical(row) ?? panic("canonical")}")
}

run: fn() {
    cr: "\r"
    stream: "{{\"a\":1}}{cr}\n\n  \n{{\"b\":[1,2]}}\n{{}} {{}}\n{{\"c\":\n"
    whole("parse", stream)
    whole("partial final record", "{{\"a\":1}}\n{{\"c\":")
    whole("clean", "{{\"a\":1}}{cr}\n\n{{\"b\":2}}")
    print("count: {jsonl.count_rows(stream)}")
    first_only(stream)
}
