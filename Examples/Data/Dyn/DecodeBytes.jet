// A Bytes payload decodes into `[U8]`, built in code or read from CBOR, and a
// decode the compiler runs at build time reports the same words as the
// running program. A decode that wants another shape names the payload
// `Bytes`.
package: {
    name: "decode_bytes"
    authority: { allow: [Env, FS.Read, IO] }
}

use cbor: core.encoding.cbor

// The reason a decode of `tree` gives, or "ok" when it succeeds.
reasons: fn(tree: Dyn) -> String {
    list: if tree.decode<[Int]>() == { .Err(errors) -> errors[0].reason else -> "ok" }
    flag: if tree.decode<Bool>() == { .Err(errors) -> errors[0].reason else -> "ok" }
    payload: if tree.decode<[U8]>() == {
        .Ok(bytes) -> "{bytes.len()} bytes: {bytes[0]} {bytes[1]}"
        .Err(errors) -> errors[0].reason
    }
    "{list}; {flag}; {payload}"
}

// A CBOR byte string of two bytes: major type 2, length 2, then "hi".
WIRE: #run { [U8]{66, 104, 105} }
AT_BUILD: #run reasons(Dyn.Bytes([U8]{104, 105}))
AT_BUILD_WIRE: #run reasons(cbor.parse(WIRE) ?? panic("a CBOR byte string: {err}"))

run: fn() {
    built: reasons(Dyn.Bytes([U8]{104, 105}))
    tree: cbor.parse(WIRE) ?? panic("a CBOR byte string: {err}")
    read: reasons(tree)
    print("built: {built}")
    print("read:  {read}")
    print("at build: {AT_BUILD}")
    print("at build, read: {AT_BUILD_WIRE}")
    print(built == AT_BUILD && read == AT_BUILD_WIRE)
    payload: tree.decode<[U8]>() ?? panic("a Bytes payload: {err}")
    again: cbor.encode(Dyn.Bytes(payload), true) ?? panic("a CBOR byte string: {err}")
    print(again == WIRE)
}
