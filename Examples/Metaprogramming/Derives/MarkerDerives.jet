// Rust `attach_type_markers`: a struct's or enum's `#…` markers request its
// derives. `#Codable` is Encode + Decode; `#Comparable` orders by fields, and
// an enum by declaration order. The parser fills `derives` from the markers,
// so an explicit marker never reads as "not Encode" (E0905).
use json: core.encoding.json

#Codable
Point: struct {
    first_x: Int
    y: Int
}

#Comparable
Version: struct {
    major: Int
    minor: Int
}

#Comparable
Level: enum {
    Low
    High
}

run: fn() {
    print(json.to_string(Point{first_x: 1, y: 2}) ?? panic("JSON encode"))
    back: json.decode<Point>("{{\"first_x\":3,\"y\":4}}") ?? panic("JSON decode")
    print(back.first_x + back.y)
    print(Version{major: 1, minor: 2} < Version{major: 1, minor: 10})
    print(Level.Low < Level.High)
}
