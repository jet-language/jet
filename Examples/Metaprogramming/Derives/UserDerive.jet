// 128 — a user-authored provider written as a marker template, plus `target.reflect()`
// Demonstrates: marker template bodies are checked Jet items with typed holes.
// `Debug` itself is retired as an explicit-derive spelling
// (built-in Debug auto-derives, E0922 if written) — a package marker
// can't reuse that name either, so this demo names its own
// `DebugText`.
DebugText: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            debug_string: fn(self) -> String { target.reflect().name }
        }
    }
}

#DebugText
Point: struct {
    x: Int
    y: Int
}

run: fn() {
    p: Point{x: 3, y: 4}
    print(p.debug_string())
}
