// A reflected record names its type `type`. A derive reads `field.type` for
// each field of the marked type, and `T.reflect()` gives the same records at
// compile time. `field.ty` is E0302, whose fix writes `.type`.
FieldTypes: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            #loop field in target.reflect().fields {
                method: "type_of_{field.reflect().name}"
                #{method}: fn(self) -> String { field.type }
            }
        }
    }
}

#FieldTypes
Rock: struct {
    size: Float
    name: String
}

run: fn() {
    rock: Rock{size: 1.0, name: "rock"}
    print("size: {rock.type_of_size()}")
    print("name: {rock.type_of_name()}")
    info: #run Rock.reflect()
    loop field in info.fields -> print("{field.name}: {field.type}")
}
