run: fn() {
    print("start")
    #Off print("off")
    #Off(.Release) print("debug")
    #Off if true { print("off block") }
    #Off(.Release) if true { print("debug block") }
    print("end")
    debugonly_block_temp_lesson()
}

debugonly_block_temp_lesson: fn() {
    print("start")
    #Off(.Release) if true { print("debug block") }
    print("end")
}
