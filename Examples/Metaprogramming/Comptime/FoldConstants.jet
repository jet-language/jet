// `:` asks for build-time evaluation as an optimization; `#run` forces
// it. `CELLS`, `lanes` and `wide` fold while building on every tier, so the
// program stores their values instead of computing them. `width` is forced:
// had `grid_width` failed, the build would have stopped. Inside a function, a
// `:` value that cannot fold is computed at run time instead; a module-level
// one is always computed while building (ModuleValues.jet).
CELLS: 6 * 7 + 1

grid_width: fn() -> Int { 12 }

run: fn() {
    lanes: 8 * 4 + 2
    wide: lanes * 2 - 1
    width: #run { grid_width() * 2 }
    print("cells {CELLS}")
    print("lanes {lanes}, wide {wide}")
    print("width {width}")
}
