// Tables run.jet builds while building. run.jet imports this file with
// `#run use`, so the shipped program holds only the finished lists.
build_squares: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> table.push(i * i)
    table
}

build_cubes: fn(count: Int) -> [Int] {
    table := [Int]{}
    loop i in 0..<count -> table.push(i * i * i)
    table
}
