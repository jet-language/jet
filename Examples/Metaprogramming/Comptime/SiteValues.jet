// `#here` is the `SourceLocation` where it is written (`#here.line`,
// `#here.file`). `#build` and `#phase` are compiler values, so a local named
// `build` or `phase` is an ordinary binding beside them.
Settings: struct {
    profile: String
}

Box: struct {
    settings: Settings
}

where: fn() -> Int { #here.line }

run: fn() {
    print(where())
    print(#here.line)
    print(#here.file.ends_with("SiteValues.jet"))
    #if #build.target.os == {
        .Linux -> { print("built for Linux") }
        .MacOS | .Windows | .Web | .Wasm | .Freestanding -> { print("built for another OS") }
    }
    build: Box{settings: Settings{profile: "a local named build"}}
    print(build.settings.profile)
    phase: "a local named phase"
    print(phase)
    print(#phase)
}
