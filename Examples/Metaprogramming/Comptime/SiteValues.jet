// `#line` and `#file` are the line and file where they are written. `#build`
// and `#phase` are compiler values, so a local named `build` or `phase` is an
// ordinary binding beside them.
Settings: struct {
    profile: String
}

Box: struct {
    settings: Settings
}

where: fn() -> Int { #line }

run: fn() {
    print(where())
    print(#line)
    print(#file.ends_with("SiteValues.jet"))
    comptime if #build.target.os == {
        .Linux -> { print("built for Linux") }
        else -> { print("built for another OS") }
    }
    build: Box{settings: Settings{profile: "a local named build"}}
    print(build.settings.profile)
    phase: "a local named phase"
    print(phase)
    print(#phase)
}
