package: {
    name: "rung_spellings"
    authority: { allow: [FS.Read, IO] }
}

// The current spellings of the compile-time and effect rungs the ratified
// prose names (ladder audit L-24, card #6059): a compiler fact is a `$`
// member (`T.$layout`, `$build.os`), the effect row sits
// between the inputs and the result, and `FS.Read` is the
// Prelude's effect type, named without a declaration. The retired
// `T.@layout` is E0302 and `@build.os` teaches `$build.os`
// (E-OSTARGET-BUILD-CONTEXT).
use files: core.files

#Layout(c)
Point: struct {
    x: Int
    y: Int
}

POINT_LAYOUT: comptime { Point.$layout }

bounded: fn(path: String) -[FS.Read]> String { files.read(path) ?? "" }

hash: fn(text: String) -[]> Int { text.len() }

run: fn() {
    comptime if $build.os == {
        .Linux -> print("os: linux")
        .MacOS -> print("os: macos")
        .Windows -> print("os: windows")
        .Web -> print("os: web")
        .Wasm -> print("os: wasm")
        .Freestanding -> print("os: freestanding")
    }
    print("point size: {POINT_LAYOUT.size}")
    print("hash: {hash("abc")}")
    print("bounded: {bounded("/nonexistent/rung_spellings").len()}")
}
