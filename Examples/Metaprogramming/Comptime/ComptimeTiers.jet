// Comptime effect tiers.
//
// Tier 0 — pure (always safe): Core calls with an empty effect set.
//           No gate required.
//
// Tier 1 — reproducible: embed_file / embed_bytes / fetch() hash their inputs
//           into .jet/lock so the build is content-addressable. No gate required.
//
// Tier 2 — ambient: reads the host filesystem, environment, etc.
//           Requires BOTH a `#Impure("reason") { … }` gate AND
//           `--gate impure=allow` on the build command.
use math: core.math

// Tier 0: pure math — always evaluates at compile time.
DIGITS_OF_PI: comptime { math.floor(Float{31415.9}) }

GREETING: comptime { "hello" }

// Tier 1a: embed_file reads the file once at compile time; its path and
// content hash are recorded in .jet/lock. (Shown as comment — no file
// to embed in this self-contained example.)
//
//   NOTICE: embed_file("notice.txt")
// Tier 1b: fetch downloads a URL once at compile time; HTTPS works by default,
// and the URL plus sha256 pin are recorded in .jet/lock so every machine's build is byte-identical.
// The sha256: argument is the content hash — change the URL contents and
// the build fails with E3413 until you update the hash (hermetic by design).
//
//   use net: core.net
//   SCHEMA: net.fetch(
//       "https://example.com/schema.json",
//       sha256: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
//   )
run: fn() {
    print("{GREETING}, world")
    print("pi × 10^4 ≈ {DIGITS_OF_PI}")
    // Tier 2 gate: the block itself is fine without --gate impure=allow as
    // long as no `comptime` binding is attempted inside it. With
    // --gate impure=allow you can add: CFG :: fs.read("config.txt")
    #Impure("demonstrating the gate syntax") {
        print("inside #Impure gate (runtime block, Tier-2 comptime disabled here)")
    }
    comptime_core_lesson()
}

// The comptime interpreter reads the shared Core effect fact.
// `core.math` calls have an empty effect set; ambient modules remain gated.
// The results are constant-folded into the binary — no runtime math involved.

SQRT4: comptime { math.sqrt(Float{4.0}) }

POW2: comptime { Float{2.0}.pow(Float{8.0}) }

FLOORED: comptime { math.floor(Float{3.7}) }

CEILED: comptime { math.ceil(Float{2.1}) }

MAXI: comptime { max(10, 20) }

COMPLEX_SQUARE: comptime { (3 + 4i) * (3 + 4i) }

// The magnitude of 3 + 4i: `math.abs` is the Int form, so the Float
// magnitude comes from `math.hypot` over the two parts.
COMPLEX_ABS: comptime { math.hypot(Float{3.0}, Float{4.0}) }

comptime_core_lesson: fn() {
    print(SQRT4)
    print(POW2)
    print(FLOORED)
    print(CEILED)
    print(MAXI)
    print(COMPLEX_SQUARE)
    print(COMPLEX_ABS)
}
