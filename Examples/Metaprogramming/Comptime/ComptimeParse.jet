// 86 — Comptime Result/Option evaluation.
// `Ok(v)` / `Err(e)` / `?` / `??` work at compile time for pure parse paths.
A: #run { Int.parse("10") ?? -1 }

B: #run { Int.parse("bad") ?? -1 }

C: #run { Int.parse("99") ?? 0 }

run: fn() {
    // a, b, c are baked at compile time.
    print(A)
    print(B)
    print(C)
    // Runtime use of comptime constants.
    print(A + C)
    // .lines() + Int.parse at runtime (sanity check alongside Text/StringParse.jet).
    total := 0
    loop row in "5\n10\n15".lines() -> total += Int.parse(row) ?? 0
    print(total)
}
