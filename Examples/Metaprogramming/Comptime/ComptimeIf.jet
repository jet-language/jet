// `#if` selects a branch at
// compile time. Only the selected arm is type-checked and emitted; the
// dropped arm gets name-resolution only (typos still caught).
DEBUG: #run false

PLATFORM: #run "unix"

run: fn() {
    #if DEBUG {
        print("debug mode")
    } else {
        print("release mode")
    }
    #if PLATFORM == "windows" {
        print("windows path")
    } else {
        print("unix path")
    }
    // Nested #if (comptime else-if chain)
    #if DEBUG {
        print("debug")
    } else {
        #if PLATFORM == "unix" {
            print("unix, non-debug")
        } else {
            print("other")
        }
    }
    prep_branch_lesson()
}

// `#if` chooses a branch while building. Only the
// chosen arm is fully checked and emitted; the other arms get name checks
// only. `prep` is no longer a keyword: a value named `prep` is an
// ordinary name.
MODE: #run "fast"

LEVEL: #run 2

add: fn(a: Int, b: Int) -> Int { a + b }

describe: fn() -> String {
    label := "unknown mode"
    #if MODE == "safe" {
        label = "safe mode"
    } else #if MODE == "fast" {
        label = "fast mode"
    } else {
        label = "other mode"
    }
    label
}

prep_branch_lesson: fn() {
    print(describe())
    #if LEVEL > 1 {
        print("level above one")
    }
    #if LEVEL > 5 {
        print("level above five")
    }
    // The unchosen arm is not type-checked: this call would not type-check.
    #if false {
        broken: add("text", 0)
        print("{broken}")
    } else {
        print("dropped arm skipped")
    }
    // Nested branches.
    #if LEVEL == 2 {
        #if MODE == "fast" {
            print("level two, fast")
        } else {
            print("level two, other")
        }
    }
    prep := 3
    prep += 4
    print("prep is an ordinary name: {prep}")
}
