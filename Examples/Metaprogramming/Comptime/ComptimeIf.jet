// `comptime if` selects a branch at
// compile time. Only the selected arm is type-checked and emitted; the
// dropped arm gets name-resolution only (typos still caught).
DEBUG: comptime { false }

PLATFORM: comptime { "unix" }

run: fn() {
    comptime if DEBUG {
        print("debug mode")
    } else {
        print("release mode")
    }
    comptime if PLATFORM == "windows" {
        print("windows path")
    } else {
        print("unix path")
    }
    // Nested comptime if (comptime else-if chain)
    comptime if DEBUG {
        print("debug")
    } else {
        comptime if PLATFORM == "unix" {
            print("unix, non-debug")
        } else {
            print("other")
        }
    }
    prep_branch_lesson()
}

// `comptime if` chooses a branch while building. Only the
// chosen arm is fully checked and emitted; the other arms get name checks
// only. `prep` is no longer a keyword: a value named `prep` is an
// ordinary name.
MODE: comptime { "fast" }

LEVEL: comptime { 2 }

add: fn(a: Int, b: Int) -> Int { a + b }

describe: fn() -> String {
    label := "unknown mode"
    comptime if MODE == "safe" {
        label = "safe mode"
    } else comptime if MODE == "fast" {
        label = "fast mode"
    } else {
        label = "other mode"
    }
    label
}

prep_branch_lesson: fn() {
    print(describe())
    comptime if LEVEL > 1 {
        print("level above one")
    }
    comptime if LEVEL > 5 {
        print("level above five")
    }
    // The unchosen arm is not type-checked: this call would not type-check.
    comptime if false {
        broken: add("text", 0)
        print("{broken}")
    } else {
        print("dropped arm skipped")
    }
    // Nested branches.
    comptime if LEVEL == 2 {
        comptime if MODE == "fast" {
            print("level two, fast")
        } else {
            print("level two, other")
        }
    }
    prep := 3
    prep += 4
    print("prep is an ordinary name: {prep}")
}
