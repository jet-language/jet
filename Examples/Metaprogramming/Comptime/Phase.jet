// `phase` is the `Phase` of where it is evaluated: `.Preparation` inside
// `comptime` code, `.Build` in `build: fn`, and `.Runtime` in the running
// program. The site decides it, not the tier, so every tier prints the same.
PREPARED: comptime { phase }

describe: fn(phase: Phase) -> String {
    if phase == {
        .Preparation -> "while building"
        .Build -> "in the build entry"
        .Runtime -> "while running"
    }
}

run: fn() {
    print(phase)
    print(PREPARED)
    local: comptime { phase }
    print(describe(local))
    print(describe(phase))
    if phase == .Runtime -> print("this line runs in the program")
}
