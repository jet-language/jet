// `#phase` is the `Phase` of the compiled copy that runs it: `.Preparation`
// inside `comptime` code, `.Build` in the build entry's copy, and `.Runtime`
// in the running program. Each copy folds its own phase, not the tier, so
// every tier prints the same.
PREPARED: comptime { #phase }

describe: fn(phase: Phase) -> String {
    if phase == {
        .Preparation -> "while building"
        .Build -> "in the build entry"
        .Runtime -> "while running"
    }
}

run: fn() {
    print(#phase)
    print(PREPARED)
    local: comptime { #phase }
    print(describe(local))
    print(describe(#phase))
    if #phase == .Runtime -> print("this line runs in the program")
}
