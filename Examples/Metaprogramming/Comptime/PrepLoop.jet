// `comptime loop` repeats
// declarations while building. One typed loop reaches derive bodies, marker
// bodies, root impl items, and test declarations over closed lists.
derive T.FieldNames {
    comptime loop field in T.$fields {
        method: "field_{field.$name}"
        $method: fn(self) -> String { field.$name }
    }
}

AddMarkerFields: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            type_name: target.reflect().name
            comptime loop field in target.reflect().fields {
                method: "marked_{field.reflect().name}"
                impl $type_name {
                    $method: fn(self) -> String { field.reflect().name }
                }
            }
        }
    }
}

#[FieldNames, AddMarkerFields]
Point: struct {
    x: Int
    y: Int
}

Size: struct {
    width: Int
}

Case: struct {
    n: Int
}

CASES: comptime { [Case]{Case{n: 1}, Case{n: 2}} }

// One loop over a closed type list generates a method on each type.
comptime loop T in [Point, Size] {
    impl T {
        kind: fn(self) -> String { "generated" }
    }
}

// Generated tests may hold a `.measure` body, so each closed case is a
// named measurement too.
comptime loop case in CASES {
    #Test("case {case.n}") {
        .measure {
            assert(case.n > 0)
        }
    }
}

run: fn() {
    point := Point{x: 1, y: 2}
    size := Size{width: 3}
    print(point.field_x())
    print(point.field_y())
    print(point.marked_x())
    print(point.marked_y())
    print(point.kind())
    print(size.kind())
}
