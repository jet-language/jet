// `embed_file` bakes a file's contents into the binary at compile
// time — the file is never opened at runtime. A `comptime require` then
// validates the embedded text while compiling (the sanctioned proc-macro
// use case): if it fails, you get a compile error, not a runtime surprise.
MOTD: comptime { embed_file("MOTD.txt") }

OK: comptime { check_nonempty(MOTD) }

// `embed_bytes` is the binary-safe sibling: it bakes raw bytes in as a `[U8]`,
// with no UTF-8 requirement, so it works for images, fonts, or any blob.
LOGO: comptime { embed_bytes("Logo.bin") }

SIZE: comptime { byte_count(LOGO) }

FIFTH: comptime { LOGO[5] }

LOGO_OK: comptime { nonempty(LOGO) }

check_nonempty: fn(s: String) -> Bool {
    assert(s.len() > 0, "MOTD.txt must not be empty")
    return true
}

byte_count: fn(bytes: [U8]) -> Int { bytes.len() }

nonempty: fn(bytes: [U8]) -> Bool {
    assert(bytes.len() > 0, "Logo.bin must not be empty")
    return true
}

run: fn() {
    print("message of the day:")
    print("{MOTD}")
    print("logo is {SIZE} bytes")
    print("byte 5 is {FIFTH}")
}
