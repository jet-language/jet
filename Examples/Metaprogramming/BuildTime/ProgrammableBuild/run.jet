build: fn(b: Build) {
    b.generate("build_message_generated") {
        generated_build_message: fn() -> String { "generated source checked" }
    }
    app: b.add_executable("programmable_build", ["run.jet", ".jet/generated/programmable_build/build_message_generated.jet"], [])
    b.default(app)
}

run: fn() { print("generated source checked") }
