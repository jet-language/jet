// One `build: fn` builds this source twice: `two_targets` for the machine
// running the build and `two_targets_page` for the web, through a toolchain
// for the web's triple. Each artifact is checked against its own machine's
// row: the web host starts no processes, so the page's copy of this code may
// not reach `Exec`, while the native copy may.
use process: core.process

build: fn(b: Build) {
    web: b.toolchain("web", "wasm32-unknown-unknown")
    _: b.add_executable("two_targets", ["run.jet"], [])
    _: b.add_executable("two_targets_page", ["run.jet"], [], [], [], web)
}

// Only the native artifact prepares a process; the page's copy keeps just
// the `.Web` arm, so the call never reaches the web machine's check.
launcher: fn() -> String {
    #if #build.target.os == {
        .Web -> return "this build starts no processes"
        .Linux | .MacOS | .Windows | .Wasm | .Freestanding -> {
            _: process.cmd(["echo", "hello"])
            return "this build may start processes"
        }
    }
}

run: fn() {
    print("pointer bits: {#build.target.layout.pointer_bits}")
    print(launcher())
}
