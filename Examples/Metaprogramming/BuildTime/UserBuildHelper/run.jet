// The root build hands its `Build` to a helper from a user package, which
// builds this executable the way core.build's own methods would.
use app_kit

build: fn(b: Build) { _: app_kit.app(b, "user_build_helper", ["run.jet"], 4) }

run: fn() {
    print("built by: {#build.settings.built_by}")
    print("cache slots: {#build.settings.cache_slots}")
}
