// One folded program reads the registered build fact plane.
run: fn() {
    comptime if $build.os == {
        .Linux -> { print("linux") }
        .MacOS -> { print("macos") }
        .Windows -> { print("windows") }
    }
    print($package.name)
    print($package.version)
    print($build.os)
    print($build.profile)
}
