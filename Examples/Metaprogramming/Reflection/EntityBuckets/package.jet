name: "entity_buckets"
version: "0.1.0"
deps: {
    engine: ./Engine,
}
// `engine.add_world` writes `World` as source text, which uses the expert
// effects `Meta.Code.Types` and `Meta.Code.Raw`; only this package can lend
// them.
authority: {
    grants: {
        engine: [Meta.Code.Types, Meta.Code.Raw],
    },
}
