// A marker's `expand` body runs at every site its `sites` names. Its
// `target` is the record a derive reads for that site: a TypeInfo for a
// struct or an enum, a FieldInfo for a field or a variant, a MethodInfo, a
// FunctionInfo, and a ModuleInfo for a module.
Stamp: struct {
    label: String

    impl Marker {
        sites: [.Type, .Variant, .Function, .Method, .Field, .Module]

        expand: fn(self, target: Target) {
            made: "stamp_{self.label}"
            seen: "{self.label} saw {target.name}"
            impl Stamps {
                #{made}: fn() -> String { #{seen} }
            }
        }
    }
}

Stamps: struct {

}

#Stamp("struct")
Point: struct {
    #Stamp("field") x: Int

    #Stamp("method") norm: fn(self) -> Int { self.x }
}

#Stamp("enum")
Shape: enum {
    #Stamp("variant") Dot
    Line
}

#Stamp("function") helper: fn() -> Int { 1 }

#Stamp("module") inner: module {
    value: fn() -> Int { 2 }
}

run: fn() {
    print(Stamps.stamp_struct())
    print(Stamps.stamp_field())
    print(Stamps.stamp_method())
    print(Stamps.stamp_enum())
    print(Stamps.stamp_variant())
    print(Stamps.stamp_function())
    print(Stamps.stamp_module())
    print(Point{x: 3}.norm() + helper())
}
