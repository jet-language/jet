// Every compiler-held plane uses one typed `@` read.
#Numeric
Severity: distinct Int(0..10)

#UnitFamily(Length, dimension) { meter }

Audited: tag { deny: [Net] }

PlaneFacts: struct {
    approximate: F32
    shape: [Int#4]
    classified: #Audited Int
    callable: fn(value: Int, *, label: Bool) -> Int
}

Order: struct {
    state { Draft, Confirmed }

    id: Int
}

send_report: fn() {}

sendability_for: fn(cell: Cell<Int>) -> Bool {
    known: comptime { cell.reflect().sendability.known }
    return known
}

RANGE: comptime { Severity.reflect().range }

EFFECTS: comptime { send_report.reflect().effects }

STATES: comptime { Order.reflect().states }

DIMENSION: comptime { Meter.reflect().dimension }

MEASURE: comptime { PlaneFacts.reflect().measure }

EXACTNESS: comptime { PlaneFacts.reflect().exactness }

CLASSIFICATION: comptime { PlaneFacts.reflect().classification }

OBLIGATION: comptime { PlaneFacts.reflect().obligation }

PACKAGE_NAME: comptime { #package.name }

PACKAGE_VERSION: comptime { #package.version }

OS: comptime { #build.target.os }

PROFILE: comptime { #build.profile }

SENDABILITY: comptime { Severity.reflect().sendability }

MOVEDNESS: comptime { Severity.reflect().movedness }

ATTRIBUTION: comptime { report.reflect().attribution }

ORIGIN: comptime { Severity.reflect().origin }

VIEW_PROVENANCE: comptime { send_report.reflect().view_provenance }

UNIT_SCALE: comptime { Meter.reflect().unit_scale_provenance }

MATURITY: comptime { send_report.reflect().maturity }

run: fn() {
    print(RANGE.start)
    print(EFFECTS.values.len())
    print(STATES[0].name)
    print(DIMENSION.axes.len())
    print(MEASURE.kind == "length")
    print(EXACTNESS.kind == .Approximate)
    print(CLASSIFICATION.name)
    print(OBLIGATION.param_contract[0].zone == .Either)
    print(PACKAGE_NAME)
    print(PACKAGE_VERSION)
    print(PROFILE == "dev" || PROFILE == "release")
    print(SENDABILITY.known)
    print(MOVEDNESS.known)
    print(ATTRIBUTION.source)
    print(ORIGIN.tracked)
    print(VIEW_PROVENANCE.mutable)
    cell: Cell.new(1)
    print(sendability_for(cell))
}
