# `World`, its buckets and its spawn functions are the module `build: fn`
# adds, so the oracle is the built program: `jet build` runs the build and
# compiles the target with that module, and the image prints the tables. The
# flow is the same on every tier, so this is the one tier-independent run.
artifact: entity_buckets
env: NO_COLOR=1
step: jet build run.jet
exit: 0
step: {built}
exit: 0
stdout: = EntityBuckets.out
