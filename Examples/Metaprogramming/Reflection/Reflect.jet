// Aggregate reflection and the
// typed `$` fact reads consume the same registered fact carriers.
use reflect: core.reflect

// A distinct derive is one written marker and one lowered derive row in the
// program reflection view; the build function below checks it is still there.
#Comparable
CustomerID: distinct Int

build: fn(b: Build) {
    loop info in b.program.types() {
        if {
            info.name == "CustomerID" -> {
                if {
                    info.has_marker("Comparable") -> { next }
                    else -> {
                        b.error(info.span, "REFLECT", "missing marker", "#Comparable was lost", "keep the marker in reflection")
                    }
                }
            }
            else -> { next }
        }
    }
    app: b.add_executable("reflect", ["Reflect.jet"], [])
    b.default(app)
}

// Runtime `reflect.of` uses the same ledger as `T.reflect()`, so a value
// reports its type name and its module path.
Point: struct {
    value: Int

    impl Display {
        display: fn(self) -> String { "Point({self.value})" }
    }
}

show_reflected_path: fn() {
    point: Point{value: 7}
    reflected: reflect.of(point)
    print(reflected.type_name())
    print(reflected.path())
}

#Numeric
Severity: distinct Int(0..10)

#UnitFamily(Length, dimension) { meter }

Order: struct {
    state { Draft, Published }

    value: Int
}

send_report: fn() -[IO]> {}

RANGE: comptime { Severity.$range }

DIMENSION: comptime { Meter.$dimension }

STATES: comptime { Order.$states }

EFFECTS: comptime { send_report.$effects }

SENDABILITY: comptime { Severity.$sendability }

MOVEDNESS: comptime { Severity.$movedness }

ATTRIBUTION: comptime { report.$attribution }

ORIGIN: comptime { Severity.$origin }

VIEW_PROVENANCE: comptime { send_report.$view_provenance }

UNIT_SCALE: comptime { Meter.$unit_scale_provenance }

MATURITY: comptime { send_report.$maturity }

derive T.Summarize {
    info: T.reflect()
    method: info.methods[0].name
    method_marker: info.methods[0].markers[0].name
    method_effects: info.methods[0].$effects.values.len()
    method_sendability: info.methods[0].$sendability.known
    method_movedness: info.methods[0].$movedness.known
    method_origin: info.methods[0].$origin.tracked
    method_view_mutable: info.methods[0].$view_provenance.mutable
    method_maturity: info.methods[0].$maturity.level
    pub_field: info.fields[0].name
    hidden_pub: info.fields[1].is_pub
    has_debug: info.has_marker("Debug")
    summary: fn(self) -> String { "{T.$name}/{$method}[{$method_marker}]/{$pub_field} debug={$has_debug} hidden_pub={$hidden_pub} effects={$method_effects} send={$method_sendability} moved={$method_movedness} track={$method_origin} view={$method_view_mutable}" }
}

// `Debug` no longer has an explicit derive spelling — it
// auto-derives whenever every field qualifies (S55). `has_marker("Debug")`
// below reads the type's WRITTEN markers, so it now honestly reports
// `false` for a type that only qualifies for auto-derive.
#Summarize
Widget: struct {
    label: String
    priv secret: Int
    level: Int(0..10)

    #Inline show: fn(self) -> String { self.label.copy() }
}

run: fn() {
    w: Widget{label: "gear", secret: 1, level: 2}
    print(w.summary())
    print("planes:{RANGE.start}-{RANGE.end}/{DIMENSION.axes.len()}/{STATES[0].name}/{EFFECTS.values.len()}")
    print("homed:{SENDABILITY.known}/{MOVEDNESS.known}/{ATTRIBUTION.source}/{ORIGIN.tracked}/{VIEW_PROVENANCE.mutable}")
    print("distinct marker reflected")
    show_reflected_path()
}
