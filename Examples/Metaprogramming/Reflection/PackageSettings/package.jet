// Fn build reads this package's settings, each with every writer of its
// value: the declared default, and the selected `build:` profile's value.
name: "package_settings"
version: "0.1.0"
settings: {
    mode: String = "plain",
    level: Int = 1,
    report: String = "",
}
build: {
    release: Build{
        optimize: O2,
        settings: { level: 3 },
    },
}
