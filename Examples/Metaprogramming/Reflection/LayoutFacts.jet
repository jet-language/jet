// Focused layout facts and full reflection share one typed model; a struct
// or enum without `#Layout` reports the bytes the compiler chose for it on
// this target, with guarantee `none`: `jet inspect shapes` prints the same
// numbers, and a later compiler may place the type otherwise. A layout
// field's `type` is a TypeId, printed here by its `name`.
LayoutFacts: struct {
    impl Marker {
        sites: [.Type],

        expand: fn(self, target: Target) {
            info: target.reflect().layout
            reflected: target.reflect().layout
            selected: info[.count]
            kind: info.kind
            target: info.target
            size: info.size
            reflected_size: reflected.size
            selected_offset: selected.offset
            reflected_offset: reflected.fields[0].offset
            reflected_kind: reflected.kind
            field_name: selected.name
            field_type: selected.type.name
            layout_facts: fn(self) -> String {
                "{kind}:{target}:{size}:{reflected_size}:{selected_offset}:{reflected_offset}:{reflected_kind}:{field_name}:{field_type}"
            }
        }
    }
}

#LayoutFacts
Packet: struct {
    count: Int,
    label: String,
}

#[Layout(c), LayoutFacts]
CPacket: struct {
    count: U32,
    flag: U8,
}

#[Layout(columnar), LayoutFacts]
ColumnPacket: struct {
    count: Int,
    label: String,
}

// An enum value with payloads is one pointer to a box: the 8-byte tag, then
// the case's fields from byte 8.
Command: enum {
    Stop,
    Move(dx: Int, dy: Int),
    Draw(x: Int, y: Int, width: Int, height: Int, color: U32),
}

PACKET_LAYOUT: #run Packet.reflect().layout

COMMAND_LAYOUT: #run Command.reflect().layout

show_layout: fn(name: String, layout: LayoutInfo) {
    print("{name}: {layout.size} bytes, alignment {layout.alignment}, stride {layout.stride}, guarantee {layout.guarantee}")
    loop member in layout.fields {
        print("  {member.name} at {member.offset} ({member.size} bytes)")
    }
}

run: fn() {
    packet: Packet{count: 2, label: "ok"}
    c_packet: CPacket{count: 2, flag: 1}
    column_packet: ColumnPacket{count: 2, label: "ok"}
    print(packet.layout_facts())
    print(c_packet.layout_facts())
    print(column_packet.layout_facts())
    show_layout("Packet", PACKET_LAYOUT)
    show_layout("Command", COMMAND_LAYOUT)
}
