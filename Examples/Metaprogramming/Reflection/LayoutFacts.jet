// Focused layout facts and full reflection share one typed model; a struct
// without `#Layout` reports the bytes the compiler chose for it.
derive T.LayoutFacts {
    info: T.reflect().layout
    reflected: T.reflect().layout
    selected: info[.count]
    kind: info.kind
    target: info.target
    size: info.size
    reflected_size: reflected.size
    selected_offset: selected.offset
    reflected_offset: reflected.fields[0].offset
    reflected_kind: reflected.kind
    field_name: selected.name
    layout_facts: fn(self) -> String { "{kind}:{target}:{size}:{reflected_size}:{selected_offset}:{reflected_offset}:{reflected_kind}:{field_name}" }
}

#LayoutFacts
Packet: struct {
    count: Int
    label: String
}

#[Layout(c), LayoutFacts]
CPacket: struct {
    count: U32
    flag: U8
}

#[Layout(columnar), LayoutFacts]
ColumnPacket: struct {
    count: Int
    label: String
}

run: fn() {
    packet: Packet{count: 2, label: "ok"}
    c_packet: CPacket{count: 2, flag: 1}
    column_packet: ColumnPacket{count: 2, label: "ok"}
    print(packet.layout_facts())
    print(c_packet.layout_facts())
    print(column_packet.layout_facts())
}
