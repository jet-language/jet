// The fact sigil:
// compiler facts carry `$`. A fact is a `$` member of the thing it describes,
// build and package facts hang off the `#build` and `#package` roots, and a
// marker declaration marks its compiler metadata with `$`.
#Numeric
Severity: distinct Int(0..10)

Audited: struct {
    impl Marker {
        sites: [.Type]
    }
}

#Audited
Order: struct {
    state { Draft, Confirmed }

    id: Int
}

RANGE: #run Severity.reflect().range

STATES: #run Order.reflect().states

PACKAGE_NAME: #run #package.name

PACKAGE_VERSION: #run #package.version

PROFILE: #run #build.profile

run: fn() {
    #if #build.target.os == {
        .Linux -> { print("linux") }
        .MacOS -> { print("macos") }
        .Windows -> { print("windows") }
        else -> { print("no native OS") }
    }
    print(RANGE.start)
    print(STATES[0].name)
    print(PACKAGE_NAME)
    print(PACKAGE_VERSION)
    print(PROFILE)
    fields_count_lesson()
}

// `T.reflect().fields` is the compile-time list of a struct's fields, so
// `P.reflect().fields.len()` inside `#run` folds to the field count while the
// program compiles. The count follows the declaration: adding a field to
// `Point` changes the printed number with no other edit.
Point: struct {
    x: Int
    y: Int
    label: String
}

fields_count_lesson: fn() {
    count: #run Point.reflect().fields.len()
    print("Point has {count} fields")
}
