// Functions and methods reflect one typed CallableSignature. Its parameter
// list holds a ParamInfo per parameter: the parameter's name, the label a
// call writes, its zone, its type, how it takes the argument, where its
// default is written (read, never run) and whether it is variadic, so nothing
// here parses a signature string. Effects read the same way: `declared` is the
// row a signature writes (None when it writes none), and `inferred` is the row
// the checker solves from the body, read after the check
// (`b.program.functions()`); a reflected constant is folded inside the check,
// so it reads None. The `effects` fact read is the signature's own `effects`.
// A name bound to a lambda reflects as a ClosureInfo: the same signature, plus
// a CaptureInfo per captured binding with the mode the checker chose: `Read`
// in place, `Write` to the owner's binding, `Copy` into an escaping closure,
// `Materialize` for an owned copy of a view, `Move` when it takes the value.
// A generic type named with its arguments (`Shelf<Int>.reflect()`) reflects
// that specialization: its identity names the arguments, its fields and
// method signatures read them in place of `T`, and each signature's
// `generic_bindings` pairs `T` with its argument. A generic function names
// its specialization with `types:`: `pick.reflect(types: [String])`.
connect: fn(host: String, /, *, timeout seconds: Int{30}, tls: Bool{true}) -> String {
    "{host}:{seconds}:{tls}"
}

Log: struct {
    lines: [String]

    note: fn(self, text: String, tags: ...String) -> Int { self.lines.len() + tags.len() }

    drain: fn(self, sink: &[String], batch: &&[String]) -> Int { sink.len() + batch.len() }
}

Shelf: struct<T> {
    items: [T]

    size_with: fn(self, extra: [T]) -> Int { self.items.len() + extra.len() }
}

send: fn(text: String) -[Net]> Int { text.len() }

pick: fn<T>(first: T, second: T) -> T { first }

capture_mode: fn(mode: CaptureMode) -> String {
    if mode == {
        .Read -> "reads"
        .Write -> "writes"
        .Copy -> "copies"
        .Materialize -> "materializes"
        .Move -> "takes"
    }
}

show_closure: fn(info: ClosureInfo) {
    params: (loop param in info.signature.params -> "{param.name}: {param.type}").join(", ")
    line: if info.location == .Val(at) -> at.line else -> 0
    print("{info.name}({params}) -> {info.signature.return_type ?? "nothing"}, bound on line {line}")
    loop capture in info.captures -> print("  {info.name} {capture_mode(capture.mode)} {capture.name} ({capture.type})")
}

run: fn() {
    loop param in connect.reflect().signature.params {
        zone: if param.zone == {
            .PositionalOnly -> "positional"
            .Either -> "either"
            .LabelOnly -> "label-only"
        }
        default: if param.default == None -> "required" else -> "has a default"
        print("connect {param.name}: label {param.label}, {zone}, {param.type}, {default}")
    }
    loop method in Log.reflect().methods {
        loop param in method.signature.params {
            if param.name == "self" -> next
            access: if param.access == {
                .Read -> "reads"
                .Write -> "writes"
                .Move -> "takes"
            }
            shape: if param.variadic -> "variadic" else -> "single"
            print("Log.{method.name} {access} {param.name} ({shape})")
        }
    }
    effects: send.reflect().effects
    declared: if effects.declared == .Val(row) -> row.join(", ") else -> "nothing"
    solved: if effects.inferred == None -> "not solved yet" else -> "solved"
    print("send declares {declared}; its body row is {solved}")
    signature: connect.reflect().signature
    convention: if signature.calling_convention == {
        .Jet -> "Jet"
        .Kernel -> "kernel"
        .Foreign -> "foreign"
    }
    print("connect returns {signature.return_type ?? "nothing"} by the {convention} calling convention")
    print(connect("db"))
    limit: 3
    factor: 2
    count := 0
    keep: (name: String) -> {
        count += 1
        name.len() <= limit
    }
    budget: () -> limit * factor
    show_closure(keep.reflect())
    show_closure(budget.reflect())
    kept: [budget]
    first: keep("ada")
    second: keep("grace")
    print("keep ada {first}, grace {second}; {count} calls; budget {kept[0].call()}")
    shelf: Shelf<Int>.reflect()
    bound: (loop binding in shelf.generic_bindings -> "{binding.name} = {binding.type}").join(", ")
    print("{shelf.name} with {bound}")
    loop field in shelf.fields -> print("  field {field.name}: {field.type.name}")
    loop method in shelf.methods {
        params: (loop param in method.signature.params if param.name != "self" -> "{param.name}: {param.type}").join(", ")
        binds: (loop binding in method.signature.generic_bindings -> "{binding.name} = {binding.type}").join(", ")
        print("  {method.name}({params}) -> {method.signature.return_type ?? "nothing"}, binding {binds}")
    }
    words: Shelf<String>.reflect()
    print("Shelf<Int> and Shelf<String> are distinct instances: {shelf.identity != words.identity}")
    numbers: Shelf<Int>{items: [Int]{1, 2}}
    print("a Shelf<Int> of 2 with 1 more holds {numbers.size_with([Int]{3})}")
    picked: pick.reflect(types: [String])
    picks: (loop param in picked.signature.params -> "{param.name}: {param.type}").join(", ")
    chose: (loop binding in picked.signature.generic_bindings -> "{binding.name} = {binding.type}").join(", ")
    print("pick({picks}) -> {picked.signature.return_type ?? "nothing"}, binding {chose}")
    print("pick for String and for Int are distinct instances: {picked.identity != pick.reflect(types: [Int]).identity}")
    print("pick of a and b is {pick("a", "b")}")
}
