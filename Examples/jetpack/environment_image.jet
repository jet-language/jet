// A runnable shell OCI image uses the existing image record. Package outputs
// come from the environment's verified Hangar entries; secrets stay runtime
// mounts or references and never become image-layer bytes.
module env.dev {
    packages: ["bash@nixpkgs"]
    // Add `services: { api: { enable: true, run: ["api"] } }` here and
    // `services: ["api"]` to the image when the environment owns a service.
    // The image then uses one generated `/jet/supervise` entrypoint.
}

module image.shell {
    from: env.dev
    entrypoint: "/bin/sh"
    user: 10001
    expose: [8080]
    files: ["config/app.toml"]
}
