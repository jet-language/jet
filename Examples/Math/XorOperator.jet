// Bitwise exclusive-or: infix `~` keeps a bit where exactly one side has it —
// the exclusive variant of `|`. The compound `~=` updates in place.
run: fn() {
    flags: 12
    mask: 10
    print(flags ~ mask)
    print(flags | mask)
    left: U8{0b1100_0011}
    right: U8{0b0101_0101}
    print(left ~ right)
    ^checksum: 0
    loop byte in [17, 42, 99, 8] -> checksum ~= byte
    print(checksum)
    source: 5
    print(flags ~ source.copy())
}
