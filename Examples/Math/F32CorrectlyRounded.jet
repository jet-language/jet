// An all-F32 call of a correctly rounded function returns the correctly
// rounded F32, never the Float result rounded a second time.
use math: core.math

run: fn() {
    x: F32{1.591674566268921}
    once: math.pow_n(x, -101)
    // The Float x^-101 lies on a midpoint of two F32 values, so rounding it
    // to F32 ties to the even one; the exact power lies above it.
    twice: F32{math.pow_n(Float.from_f32(x), -101)}
    print(math.to_bits(once))
    print(math.to_bits(twice))
    print(math.to_bits(math.atan2_pi(F32{1054548.75}, F32{-6951173.0})))
    print(math.root_n(F32{-8.0}, 3) == F32{-2.0})
    print(math.pow_r(F32{4.0}, F32{0.5}) == F32{2.0})
}
