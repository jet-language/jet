package: {
    name: "tooling_compute_kernel"
    version: "0.1.0"
    authority: { allow: [GPU, IO, Mem.Alloc] }
}

// The safe
// marker carries a sema proof. Raw contracts are issued only by accelerator
// providers; the Epoch 3 CPU surface exposes no forgeable constructor.
use compute: core.compute

#Kernel(.parallel) lane_add: fn(left: Int, right: Int) -> Int { left + right }

run: fn() {
    print("kernel:{lane_add(20, 22)}")
    ok: compute.kernel_bounds_ok([2, 3], [1, 2]) ?? return
    print("bounds:{ok}")
}
