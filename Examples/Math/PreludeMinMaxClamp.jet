// `min`, `max` and `clamp` are prelude names over one ordered type, with no
// import. `min`/`max` take two or more arguments; `clamp` accepts reversed
// bounds. All three order by `compare`, so a Float follows IEEE 754
// totalOrder: NaN sorts above +inf. `math.min_float`/`max_float` are the
// NaN-skipping Float pair (see tests/run/CoreMathNumeric/MinMaxNan.jet).

#Comparable
Version: struct {
    major: Int
    minor: Int
}

CORES: 8
LIMIT: max(4, CORES)

run: fn() {
    print(min(3, 9))
    print(max(3, 9, 12, 1))
    print(min(7, 3, 9, 12, 5))
    extra: [Int]{4, 1}
    print(min(9, 6, ...extra))
    print(min(I8{3}, I8{-2}))
    print(max(U8{3}, U8{7}))
    print(min(F32{1.5}, F32{0.5}))
    print(max(Float{1.5}, Float{2.5}, Float{0.5}))
    print(min(Decimal{2.5}, Decimal{1.5}))
    print(max("apple", "pear", "fig"))
    print(min(Version{major: 1, minor: 2}, Version{major: 1, minor: 1}).minor)
    print(min(3s, 2s) == 2s)
    print(max(3s, 2s) == 3s)
    waits := [Duration]{3s, 1s, 2s}
    waits.sort()
    print(waits[0] == 1s)
    print(LIMIT)
    print(clamp(15, 0, 10))
    print(clamp(-5, 0, 10))
    print(clamp(5, 10, 0))
    print(clamp(Float{0.25}, Float{0.0}, Float{1.0}))
    print(min(Float{1.0}, Float.NAN, Float{0.5}))
    print(max(Float.NAN, Float{1.0}).is_nan())
    print(clamp(Float.NAN, Float{0.0}, Float{1.0}) == Float{1.0})
    print(clamp(Float{0.5}, Float.NAN, Float{1.0}) == Float{1.0})
}
