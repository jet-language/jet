// sin, cos and tan of pi * x, correctly rounded. They give the same bits on
// every tier, and exact answers stay exact.
use math: core.math

run: fn() {
    // sin_pi(x) never rounds pi * x first, so whole turns give exact zeros.
    print(math.sin_pi(Float{1.0}))
    print(math.sin(math.PI))
    print(math.sin_pi(Float{-2.0}))
    print(math.sin_pi(Float{0.5}))
    print(math.sin_pi(Float{0.25}))
    print(math.sin_pi(Float{1.0e300}))

    print(math.cos_pi(Float{0.5}))
    print(math.cos_pi(Float{1.0}))
    print(math.cos_pi(Float{1.0} / Float{3.0}))

    // tan_pi has its poles at odd multiples of 1/2.
    print(math.tan_pi(Float{0.25}))
    print(math.tan_pi(Float{0.5}))
    print(math.tan_pi(Float{-0.5}))
    print(math.tan_pi(Float{1.0}))
    print(math.is_nan(math.tan_pi(math.INFINITY)))
}
