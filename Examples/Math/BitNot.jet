// Integer `~` flips bits; `!` only negates Bool.
// Exact Int complement is -x - 1; fixed-width complement keeps its width.
bits: fn(n: Int) -> Int { n }

run: fn() {
    print(~bits(0))
    print(~bits(5))
    flags: bits(15)
    mask: bits(4)
    print(flags &~ mask)
    print(!true)
    small: U8{5}
    print(~small)
}
