use math: core.math

// Exact division and decimal arithmetic stay exact by
// default; Float is an explicit machine-arithmetic opt-in.
run: fn() {
    third: 1 / 3
    print(third)
    print(third * 3 == 1)
    print(0.1 + 0.2 == 0.3)
    fast: Float{19.99}
    print(fast)

    fraction_third: math.fraction(1, 3) ?? panic("a third is a ratio")
    print(fraction_third.to_string())

    whole: fraction_third.add(fraction_third)
    all: whole.add(fraction_third)
    print(all.to_string())
    one: math.fraction(1, 1) ?? panic("one")
    print(all.equal(one))

    // Reduced on construction, with the sign carried on top.
    ratio: math.fraction(6, -8) ?? panic("ratio")
    print(ratio.to_string())

    rate: math.fraction(44100, 48000) ?? panic("rate")
    print(rate.to_string())
    print(rate.numerator())
    print(rate.denominator())
    print(rate.to_float())
    print(rate.is_zero())

    // A ratio over nothing has no value, so the fallback is taken.
    fallback: math.fraction(0, 1) ?? panic("zero is a ratio")
    refused: math.fraction(1, 0) ?? fallback
    print(refused.to_string())
    exact_rational_math_lesson()
    fraction_display_lesson()
    fraction_exact_lesson()
}

// Math functions that leave the rationals return Float.

exact_rational_math_lesson: fn() {
    print(math.sqrt(1 / 3))
    print(math.sin(1 / 2))
}

// Finite exact quotients print as decimals; repeating
// quotients keep their exact fraction spelling.
fraction_display_lesson: fn() {
    print(7 / 2)
    print(1 / 4)
    print(-1 / 8)
    print(1 / 3)
}

// Exact division stays rational by default.
fraction_exact_lesson: fn() {
    third: 1 / 3
    print(third)
    print(third * 3 == 1)
}
