// log2(1 + x) and log10(1 + x), correctly rounded: the same bits on every
// tier, and full precision for small x, where 1 + x rounds x away.
use math: core.math

run: fn() {
    print(math.log2_1p(Float{1.0}))
    print(math.log2_1p(Float{-0.5}))
    print(math.log2_1p(Float{1023.0}))
    print(math.log2_1p(Float{-1.0}))
    print(math.log10_1p(Float{999.0}))
    print(math.log10_1p(Float{-0.99}))
    print(math.log10_1p(Float{0.5}))

    // log2(1 + x) loses what log2_1p(x) keeps.
    print(math.log2_1p(Float{1e-20}))
    print(math.log2(Float{1.0} + Float{1e-20}))
    print(math.log10_1p(Float{1e-10}))
    print(math.log10(Float{1.0} + Float{1e-10}))
}
