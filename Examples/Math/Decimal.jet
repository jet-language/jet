// Decimal literals use exact base-10 arithmetic.
run: fn() {
    price: 19.99
    print((price * 3).to_string())
    third: 1 / 3
    print(third)
    print(third * 3 == 1)
    print(0.1 + 0.2 == 0.3)
    fast: Float{19.99}
    print(fast)

    // Explicit construction remains the named exact Decimal path.
    tax: Decimal("0.08")
    print((price + tax).to_string())
}
