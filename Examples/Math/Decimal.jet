// Decimal literals use exact base-10 arithmetic.
use math: core.math

run: fn() {
    price: 19.99
    print((price * 3).to_string())
    third: 1 / 3
    print(third)
    print(third * 3 == 1)
    print(0.1 + 0.2 == 0.3)
    fast: Float{19.99}
    print(fast)

    // Explicit construction remains the named exact Decimal path.
    tax: Decimal("0.08")
    print((price + tax).to_string())

    // Rounding works on the exact base-10 digits, so 1.005 is never the
    // binary 1.00499... a Float holds. math.round takes ties away from zero,
    // math.round_even takes them to the even neighbour, and floor and ceil
    // keep the result a Decimal.
    print(math.round(Decimal("1.005")).to_string())
    print(math.round(Decimal("-2.5")).to_string())
    print(math.round_even(Decimal("2.5")).to_string())
    print(math.floor(price).to_string())
    print(math.ceil(price).to_string())
}
