F32_WORDS: [Int]{
    0x0000_0000_0000_0000, 0x0000_0000_8000_0000, 0x0000_0000_7F80_0000, 0x0000_0000_FF80_0000,
    0x0000_0000_7FC0_0000, 0x0000_0000_FFC0_0001, 0x0000_0000_7F80_0001, 0x0000_0000_7FA0_0000,
    0x0000_0000_0000_0001, 0x0000_0000_8000_0001, 0x0000_0000_007F_FFFF, 0x0000_0000_0080_0000,
    0x0000_0000_3F80_0000, 0x0000_0000_BFC0_0000, 0x0000_0000_3DCC_CCCD, 0x0000_0000_4049_0FDB,
    0x0000_0000_4B80_0000, 0x0000_0000_7F7F_FFFF, 0x0000_0000_FF7F_FFFF
}

F32_WIDE_WANT: [Int]{
    0x0000_0000_0000_0000, 0x8000_0000_0000_0000, 0x7FF0_0000_0000_0000, 0xFFF0_0000_0000_0000,
    0x7FF8_0000_0000_0000, 0x7FF8_0000_0000_0000, 0x7FF8_0000_0000_0000, 0x7FF8_0000_0000_0000,
    0x36A0_0000_0000_0000, 0xB6A0_0000_0000_0000, 0x380F_FFFF_C000_0000, 0x3810_0000_0000_0000,
    0x3FF0_0000_0000_0000, 0xBFF8_0000_0000_0000, 0x3FB9_9999_A000_0000, 0x4009_21FB_6000_0000,
    0x4170_0000_0000_0000, 0x47EF_FFFF_E000_0000, 0xC7EF_FFFF_E000_0000
}

// An unsigned binary64 word as the signed Int that from_bits takes.
signed: fn(word: Int) -> Int {
    if word > 0x7FFF_FFFF_FFFF_FFFF -> return word - 0x1_0000_0000_0000_0000
    word
}

value: fn(word: Int) -> Float { math.from_bits(signed(word)) }

// A binary64's place in the order of the values: neighbors differ by one,
// and -0 sits one below +0.
place: fn(bits: Int) -> Int { if bits >= 0 -> bits else -> -1 - (bits & 0x7FFF_FFFF_FFFF_FFFF) }

// The units in the last place between `got` and the wanted word; a NaN on
// one side only is no distance at all.
ulps: fn(got: Float, want: Int) -> Int? {
    wanted: value(want)
    if math.is_nan(wanted) || math.is_nan(got) {
        if math.is_nan(wanted) && math.is_nan(got) -> return Val(0)
        return None
    }
    Val(math.abs(place(math.to_bits(got)) - place(signed(want))))
}

check: fn(name: String, got: [Float], want: [Int]) {
    ^worst: 0
    loop (at, result) in got {
        distance: ulps(result, want[at]) ?? panic("{name} #{at}: got {math.to_bits(result)}, want {signed(want[at])}")
        if distance > 1 -> panic("{name} #{at}: {distance} ulp from {signed(want[at])}")
        if distance > worst -> worst = distance
    }
    print("{name}: {got.len()} results, at most {worst} ulp")
}

check_exact: fn(name: String, got: [Int], want: [Int]) {
    loop (at, result) in got {
        if result != want[at] -> panic("{name} #{at}: got {result}, want {want[at]}")
    }
    print("{name}: {got.len()} results, all exact")
}

class_of: fn(x: Float) -> Int {
    if math.is_nan(x) -> return 2
    if math.is_inf(x) -> return 1
    0
}

run: fn() {
    check("sqrt", loop word in VALUES -> math.sqrt(value(word)), SQRT_WANT)
    check("floor", loop word in VALUES -> math.floor(value(word)), FLOOR_WANT)
    check("ceil", loop word in VALUES -> math.ceil(value(word)), CEIL_WANT)
    check("trunc", loop word in VALUES -> math.trunc(value(word)), TRUNC_WANT)
    check("truncate", loop word in VALUES -> math.truncate(value(word)), TRUNC_WANT)
    check("fabs", loop word in VALUES -> math.fabs(value(word)), FABS_WANT)
    check("sin", loop word in VALUES -> math.sin(value(word)), SIN_WANT)
    check("cos", loop word in VALUES -> math.cos(value(word)), COS_WANT)
    pairs: OPERANDS.len()
    check("fmod", loop at in 0..<pairs * pairs -> math.fmod(value(OPERANDS[at /% pairs]), value(OPERANDS[at % pairs])), FMOD_WANT)
    check_exact("cmp", loop at in 0..<pairs * pairs -> math.cmp(value(OPERANDS[at /% pairs]), value(OPERANDS[at % pairs])), CMP_WANT)
    triples: FMA_OPERANDS.len()
    check("fma", loop at in 0..<triples * triples * triples -> math.fma(value(FMA_OPERANDS[at /% (triples * triples)]), value(FMA_OPERANDS[at /% triples % triples]), value(FMA_OPERANDS[at % triples])), FMA_WANT)
    check("muladd", loop at in 0..<triples * triples * triples -> math.muladd(value(FMA_OPERANDS[at /% (triples * triples)]), value(FMA_OPERANDS[at /% triples % triples]), value(FMA_OPERANDS[at % triples])), FMA_WANT)
    check_exact("class", loop word in VALUES -> class_of(value(word)), CLASS_WANT)
    check_exact("is_finite", loop word in VALUES -> if math.is_finite(value(word)) -> 0 else -> 1, loop class in CLASS_WANT -> if class == 0 -> 0 else -> 1)
    check_exact("to_bits(from_bits)", loop word in VALUES -> math.to_bits(value(word)), loop word in VALUES -> signed(word))
    check("f32_from_bits", loop word in F32_WORDS -> Float.from_f32(math.f32_from_bits(U32{word})), F32_WIDE_WANT)
    check_exact("f32_to_bits(f32_from_bits)", loop word in F32_WORDS -> Int{math.f32_to_bits(math.f32_from_bits(U32{word}))}, F32_WORDS)
}
