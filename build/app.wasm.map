// 179 — D-DISPLAYDBG1/2: Display vs Debug interpolation + #Redact
struct User {
    id: Int
    email: String
    #Redact password_hash: String
}

impl User.Display {
    fn display(self) String -> "{self.email} (#{self.id})"
}

fn run() {
    u :: User{id: 42, email: "w@example.com", password_hash: "$2b$12$secret"}
    print("user: {u}")
    print("debug: {u:Debug}")
}
