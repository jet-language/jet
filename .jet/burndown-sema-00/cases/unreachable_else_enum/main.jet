enum Color {
    Red
    Green
    Blue
}

fn name(c: Color) -> String {
    if c == {
        .Red -> "red"
        .Green -> "green"
        .Blue -> "blue"
        else -> "unknown"
    }
}

fn run() {
    c :: Color.Green
    print(name(c))
    if c == {
        .Red -> print("stop")
        .Green | .Blue -> print("go")
        else -> {
            print("never")
        }
    }
}
