#Bindgen c.jet_fortran_matrix.__bindgen__: module {
    // fortran-layout probe.a: column-major 2x3
    probe: fn(a_0: Float, a_1: Float, a_2: Float, a_3: Float, a_4: Float, a_5: Float) :> Float = "jet_fortran_matrix_probe"
}
use abi: c.jet_fortran_matrix

probe: fn(a: [Float]) :[FFI.Fortran]> Float {
    if a.len() != 6 { panic("a must contain exactly 6 column-major values") }
    return abi.probe(a[0], a[1], a[2], a[3], a[4], a[5])
}

