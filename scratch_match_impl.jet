enum D { A([D]) B(Int) }
impl D { pub fn equal(self, other: D) -> Bool { tree_equal(self, other) } }
fn tree_equal(left: D, right: D) -> Bool {
    if left == {
        .A(xs) -> {
            if right == {
                .A(ys) -> {
                    if xs.len() != ys.len() -> return false
                    same_array := true
                    loop i in 0..<xs.len() {
                        same_array = false
                    }
                    return same_array
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}
