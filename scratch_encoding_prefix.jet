package {
    name: "core.encoding"
    version: "0.1.0"
    edition: "2026"
    description: "Codecs and the shared DataTree interchange model."
    license: "MIT"
    outputs: {
        encoding: .Library{ entry: encoding }
    }
}
// core.encoding — interchange codecs and the one dynamic value tree.
//
// Every format in this package speaks the same two verbs: `parse` (text or
// bytes → `DataTree`) and `to_string` / `to_bytes` (value → wire). JSON, JSONL
// CSV, TOML, YAML, XML, and CBOR are nested modules so a program pays only for
// the format it imports. Hex, Base32, and Base64 are byte alphabets, not
// DataTree adapters; they live beside the formats because they are the usual
// way to carry those bytes through text.
//
// This tree is compiler-owned Core source. It is not loaded yet; `Core.jet`
// remains the live export table. Host-backed format kernels (full YAML 1.2
// hostile XML entity expansion, streaming handle IO) stay in the Rust CoreLib
// until cutover. Portable codecs below are written in Jet.
//
// Invariants:
// - `DataTree` is the only user-facing dynamic tree. There is no `Data` alias.
// - Objects keep insertion order. Integers and floats stay distinct variants.
// - Nothing in this package panics on malformed input. Syntax problems are
//   `EncodingError` or, for the alphabets, a `String` reason.
// - Codecs are pure (`->`). They do not read files; callers pass bytes.
module hex

module base32

module base64

module json

module jsonl

module csv

module toml

module yaml

module xml

module cbor

module binary

module ini

/// Wire format named by the shared error and event carriers.
pub enum EncodingFormat {
    JSON
    JSONL
    CSV
    TOML
    YAML
    XML
    CBOR
}

/// Why a codec stopped. `IO` is reserved for streaming handles that wrap a
/// reader; whole-value `parse` uses `Syntax`, `Truncated`, `Limit`, or
/// `Unsupported`.
pub enum EncodingErrorKind {
    Syntax
    Truncated
    Unsupported
    Limit
    IO
    State
}

/// Optional OS/handle cause attached to an `IO` kind. Whole-value codecs leave
/// this absent.
pub struct EncodingCause {
    pub kind: String
    pub os_code: ?Int
    pub message: String
}

/// One codec failure. Offsets are byte offsets into the original input; line
/// and column are 1-based when known. `path` is a JSON-pointer-style location
/// inside the value (`/users/0/name`), empty at the root.
#Error
pub struct EncodingError {
    pub format: EncodingFormat
    pub kind: EncodingErrorKind
    pub byte_offset: Int
    pub line: ?Int
    pub column: ?Int
    pub path: String
    pub reason: String
    pub cause: ?EncodingCause
}

/// Safety limits for streaming and hostile-input codecs.
pub struct EncodingLimits {
    pub buffer_bytes: Int
    pub max_depth: Int
    pub max_item_bytes: Int
    pub max_total_bytes: ?Int
    pub max_expansion_depth: Int
    pub max_expansion_bytes: Int
}

impl EncodingLimits {
    /// Limits for ordinary documents: 64 KiB buffers, 256 nesting depth
    /// 16 MiB per item. Streaming codecs should treat these as hard caps, not
    /// hints.
    pub fn safe() -> EncodingLimits {
        {
            buffer_bytes: 65536,
            max_depth: 256,
            max_item_bytes: 16777216,
            max_total_bytes: None,
            max_expansion_depth: 32,
            max_expansion_bytes: 8388608,
        }
    }
}

/// Pull event for streaming codecs. `End` is the terminal event; it is not an
/// error.
pub enum DataEvent {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Text(String)
    BeginArray
    EndArray
    BeginObject
    EndObject
    Field(String)
    End
}

/// Pull cursor over a pre-materialized event list. Format readers that
/// stream (`json.reader`) own their own type; this is the shared carrier
/// when a caller already has events.
pub struct Reader {
    pub events: [DataEvent]
    pub index: Int
}

impl Reader {
    pub fn next(&self) -> ?DataEvent {
        if self.index >= self.events.len() -> return None
        ev :: self.events[self.index]
        self.index += 1
        Val(ev)
    }
}

/// The one dynamic value. Adapters must not invent a second tree type.
///
/// `.text()` is strict: only `Text` leaves succeed. `.to_text()` also projects
/// integers, floats, and booleans, and returns `None` for `Null` and containers.
pub enum DataTree {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Text(String)
    Array([DataTree])
    Object([String:DataTree])
}

impl DataTree {
    pub fn field(self, name: String) -> ?DataTree {
        if self == {
            .Object(entries) -> return entries.get(name)
            else -> return None
        }
    }

    pub fn at(self, index: Int) -> ?DataTree {
        if self == {
            .Array(items) -> {
                if index < 0 || index >= items.len() -> return None
                return Val(items[index])
            }
            else -> return None
        }
    }

    pub fn int(self) -> ?Int {
        if self == {
            .Int(n) -> return Val(n)
            else -> return None
        }
    }

    pub fn float(self) -> ?Float {
        if self == {
            .Float(n) -> return Val(n)
            .Int(n) -> return Val(Float{n})
            else -> return None
        }
    }

    pub fn text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            else -> return None
        }
    }

    pub fn bool(self) -> ?Bool {
        if self == {
            .Bool(v) -> return Val(v)
            else -> return None
        }
    }

    /// Project a leaf as text. Containers and `Null` are absent — they have
    /// no single lossless spelling.
    pub fn to_text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            .Int(n) -> return Val("{n}")
            .Float(n) -> return Val("{n}")
            .Bool(v) -> {
                if v -> return Val("true")
                return Val("false")
            }
            else -> return None
        }
    }

    /// Structural equality that ignores object insertion order, keeps array
    /// order, and never equates `NaN` with itself or with a number.
    pub fn equal_unordered(self, other: DataTree) -> Bool { tree_equal(self, other) }
}

fn tree_equal(left: DataTree, right: DataTree) -> Bool {
    if left == {
        .Array(xs) -> {
            if right == {
                .Array(ys) -> {
                    if xs.len() != ys.len() -> return false
                    same_array := true
                    loop i in 0..<xs.len() {
                        same_array = false
                    }
                    return same_array
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}
