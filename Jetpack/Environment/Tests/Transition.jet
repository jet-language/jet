// Claims ported from crates/jetpack/src/Transition.rs #[cfg(test)].

use files: core.files

TRANSITION_TEST_ENV_PACKAGE: comptime { "name: \"demo\"\nenvironments: {{ development: Environment{{ tools: [\"git\"] }} }}\n" }

env_transition_test_root: fn(label: String) -> String {
    files.tmpdir("jet-transition-{label}-") ?? panic("claim transition root")
}

env_transition_test_write: fn(root: String, name: String, text: String) {
    files.write(files.join(root, name), text) ?? panic("write {name}")
}

env_transition_test_read: fn(root: String, name: String) -> String {
    files.read(files.join(root, name)) ?? panic("read {name}")
}

env_transition_test_error: fn(result: TransitionResult EnvironmentError!, what: String) -> String {
    if result == {
        .Ok(_) -> panic("{what} must be refused")
        .Err(error) -> error.message()
    }
}

#Test("hosts split binds the checked System name and fold restores exact root") {
    root: env_transition_test_root("hosts")
    original: "name: \"demo\"\noutputs: {{ server: System{{ name: \"devhost\", target: linux.x64 }} }}\n"
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, original)
    preview: env_transition_split(root, SplitTarget.Hosts("server"), true) ?? panic("preview hosts")
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), original)
    assert(!files.exists(files.join(root, "package/fleet.jet")))
    result: env_transition_split(root, SplitTarget.Hosts("server"), false) ?? panic("split hosts")
    assert_eq(result.summary.before_fingerprint, result.summary.after_fingerprint)
    assert_eq(result.summary.before_fingerprint, preview.summary.before_fingerprint)
    expected: "home: Config{{\n    outputs: {{\n        home: Fleet{{\n            name: \"home\"\n            hosts: {{ server: system.devhost }}\n        }}\n    }}\n}}\n"
    assert_eq(env_transition_test_read(root, "package/fleet.jet"), expected)
    env_transition_fold(root, "package/fleet.jet", false) ?? panic("fold hosts")
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), original)
    assert(!files.exists(files.join(root, "package/fleet.jet")))
    files.remove_all(root) ?? panic("remove root")
}

#Test("hosts split refuses invalid names and non-System Outputs before writes") {
    root: env_transition_test_root("hosts-invalid")
    original: "name: \"demo\"\noutputs: {{ server: Executable{{ name: \"server\", entry: run }} }}\n"
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, original)
    invalid: env_transition_test_error(env_transition_split(root, SplitTarget.Hosts("server/name"), false), "invalid host")
    assert(invalid.contains("invalid host name"))
    wrong_kind: env_transition_test_error(env_transition_split(root, SplitTarget.Hosts("server"), false), "non-System host")
    assert_eq(wrong_kind, "outputs.server is Executable, but host extraction needs a System Output")
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), original)
    assert(!files.exists(files.join(root, "package/fleet.jet")))
    files.remove_all(root) ?? panic("remove root")
}

#Test("transition journal preserves every byte and distinguishes absent from empty") {
    bytes := [U8]{}
    loop value in 0..<256 -> bytes.push(U8{value})
    encoded: env_transition_encode_state(Val(bytes))
    assert(encoded.starts_with("f00010203"))
    assert(encoded.ends_with("fcfdfeff"))
    assert_eq(encoded.bytes().len(), 513)
    decoded: if env_transition_decode_state(Val(encoded), "fixture.journal") == {
        .Ok(state) -> state
        .Err(error) -> panic("decode every byte")
    }
    assert_eq(decoded, Val(bytes))
    assert_eq(env_transition_encode_state(None), "-")
    assert_eq(env_transition_encode_state(Val([U8]{})), "f")
    assert_eq(if env_transition_decode_state(Val("-"), "fixture.journal") == {
        .Ok(state) -> state
        .Err(error) -> panic("decode absent")
    }, [U8]?{None})
    assert_eq(if env_transition_decode_state(Val("f"), "fixture.journal") == {
        .Ok(state) -> state
        .Err(error) -> panic("decode empty")
    }, Val([U8]{}))
    binary: [U8]{0, 10, 13, 34, 124, 128, 255}
    assert_eq(env_transition_encode_state(Val(binary)), "f000a0d227c80ff")
    assert_eq(if env_transition_decode_state(Val("f000a0d227c80ff"), "fixture.journal") == {
        .Ok(state) -> state
        .Err(error) -> panic("decode binary")
    }, Val(binary))
    if env_transition_decode_state(Val("f0"), "fixture.journal") == .Ok(_) -> panic("odd hex must be refused")
    if env_transition_decode_state(Val("fgg"), "fixture.journal") == .Ok(_) -> panic("nonhex must be refused")
}

#Test("environment split and fold restore exact root") {
    root: env_transition_test_root("env")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, TRANSITION_TEST_ENV_PACKAGE)
    result: env_transition_split(root, SplitTarget.Environment, false) ?? panic("split env")
    assert_eq(result.summary.before_fingerprint, result.summary.after_fingerprint)
    assert(files.is_file(files.join(root, "package/env.jet")))
    env_transition_fold(root, "package/env.jet", false) ?? panic("fold env")
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), TRANSITION_TEST_ENV_PACKAGE)
    assert(!files.exists(files.join(root, "package/env.jet")))
    files.remove_all(root) ?? panic("remove root")
}

#Test("stale split refuses without mutation") {
    root: env_transition_test_root("stale")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, "name: \"demo\"\nenvironments: {{ dev: Environment{{ }} }}\n")
    plan: env_transition_split_plan(root, SplitTarget.Environment) ?? panic("plan split")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, "name: \"changed\"\n")
    message: env_transition_test_error(plan.apply(), "a stale split")
    assert(message.contains("stale transition"), message)
    assert(!files.exists(files.join(root, "package/env.jet")))
    files.remove_all(root) ?? panic("remove root")
}

#Test("package split moves named config and records member") {
    root: env_transition_test_root("member")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, "name: \"workspace\"\napp: Config{{ version: \"1\" }}\n")
    env_transition_split(root, SplitTarget.Package("app"), false) ?? panic("split package")
    member: env_transition_test_read(root, "packages/app/package.jet")
    assert(member.contains("name: \"app\""))
    assert(env_transition_test_read(root, TRANSITION_PACKAGE_FILE).contains("members:"))
    env_transition_fold(root, "packages/app/package.jet", false) ?? panic("fold package")
    assert(env_transition_test_read(root, TRANSITION_PACKAGE_FILE).contains("app: Config"))
    files.remove_all(root) ?? panic("remove root")
}

#Test("package split rejects duplicate member name before writes") {
    root: env_transition_test_root("member-duplicate")
    files.create_dir_all(files.join(root, "packages/existing")) ?? panic("create member dir")
    env_transition_test_write(root, "packages/existing/package.jet", "name: \"app\"\n")
    original: "name: \"workspace\"\nmembers: [\"packages/existing\"]\napp: Config{{ version: \"1\" }}\n"
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, original)
    message: env_transition_test_error(env_transition_split(root, SplitTarget.Package("app"), false), "a duplicate member")
    assert(message.contains("member Package name `app` is declared more than once"), message)
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), original)
    assert(!files.exists(files.join(root, "packages/app/package.jet")))
    files.remove_all(root) ?? panic("remove root")
}

#Test("fold recovers a journaled partial split without touching live bytes") {
    root: env_transition_test_root("partial")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, TRANSITION_TEST_ENV_PACKAGE)
    plan: env_transition_split_plan(root, SplitTarget.Environment) ?? panic("plan split")
    env_transition_create_real_dirs(plan.root, files.dirname(plan.journal_path)) ?? panic("create journal dir")
    env_transition_write_atomic(plan.journal_path, plan.journal) ?? panic("write journal")
    generated: files.join(plan.root, "package/env.jet")
    generated_after := [U8]?{None}
    loop change in plan.changes {
        if change.relative == "package/env.jet" -> generated_after = change.after
    }
    env_transition_apply_state(plan.root, generated, generated_after) ?? panic("apply generated state")

    env_transition_fold(root, "package/env.jet", false) ?? panic("fold partial split")

    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), TRANSITION_TEST_ENV_PACKAGE)
    assert(!files.exists(generated))
    assert(!files.exists(plan.journal_path))
    files.remove_all(root) ?? panic("remove root")
}

#Test("corrupt transition journal refuses fold without mutation") {
    root: env_transition_test_root("corrupt-journal")
    env_transition_test_write(root, TRANSITION_PACKAGE_FILE, TRANSITION_TEST_ENV_PACKAGE)
    env_transition_split(root, SplitTarget.Environment, false) ?? panic("split env")
    live_package: env_transition_test_read(root, TRANSITION_PACKAGE_FILE)
    journal_dir: files.join(root, TRANSITION_JOURNAL_DIR)
    journals: files.list_dir(journal_dir) ?? panic("list journals")
    journal: files.join(journal_dir, journals[0].name)
    files.write(journal, "corrupt\n") ?? panic("corrupt journal")
    message: env_transition_test_error(env_transition_fold(root, "package/env.jet", false), "a corrupt journal")
    assert(message.contains("unknown format"), message)
    // The split state stays live.
    assert_eq(env_transition_test_read(root, TRANSITION_PACKAGE_FILE), live_package)
    assert(files.is_file(files.join(root, "package/env.jet")))
    files.remove_all(root) ?? panic("remove root")
}
