// jetpack BrowserLock.rs unit tests.

fn env_browser_test_root(label: String) -[FS]> String {
    root :: files.tmpdir("jet-browser-lock-{label}-") ?? panic("browser lock scratch")
    files.create_dir_all(files.join(root, @SOURCE_ROOT_DIR)) ?? panic("managed dir")
    root
}

fn env_browser_test_fake(root: String, body: String) -[FS]> String {
    bin :: files.join(root, "fake-chromium")
    files.write(bin, body) ?? panic("fake browser")
    files.set_mode(bin, 0o755) ?? panic("fake browser mode")
    bin
}

fn env_browser_test_drifted(result: LockedBrowser BrowserLockError!) -> Bool {
    if result == {
        .Ok(_) -> false
        .Err(error) -> {
            if error == {
                .HashMismatch(engine, expected, actual) -> true
                .SizeMismatch(engine, expected, actual) -> true
                else -> false
            }
        }
    }
}

#Test("browser lock resolve and hash drift") {
    root :: env_browser_test_root("ok")
    bin :: env_browser_test_fake(root, "#!/bin/sh\necho Chromium 131.0\n")
    locked :: env_browser_lock_binary(root, "chromium", bin, "131.0", @BROWSER_DEFAULT_PROTOCOL, "test fixture") ?? panic("lock the fake browser")
    assert_eq(locked.engine, "chromium")
    resolved :: env_browser_resolve(root, "chromium") ?? panic("resolve the locked browser")
    assert_eq(resolved.binary, locked.binary)
    assert_eq(resolved.envelope.output_hash, locked.envelope.output_hash)
    files.write(bin, "#!/bin/sh\necho Chromium 999\n") ?? panic("drift the binary")
    assert(env_browser_test_drifted(env_browser_resolve(root, "chromium")))
    files.remove_all(root).drop("test cleanup")
}

#Test("browser lock rejects unknown engine and missing lock") {
    if env_browser_normalize_engine("edge") == {
        .Err(error) -> {
            if error == {
                .UnknownEngine(name) -> assert_eq(name, "edge")
                else -> panic("expected UnknownEngine")
            }
        }
        .Ok(_) -> panic("edge is not a supported engine")
    }
    root :: env_browser_test_root("missing")
    if env_browser_resolve(root, "firefox") == {
        .Err(error) -> {
            if error == {
                .MissingLock(engine) -> assert_eq(engine, "firefox")
                else -> panic("expected MissingLock")
            }
        }
        .Ok(_) -> panic("no browser is locked")
    }
    files.remove_all(root).drop("test cleanup")
}

#Test("browser lock find engine binary prefers bin dir") {
    root :: env_browser_test_root("find")
    bin_dir :: files.join(files.join(root, "out"), "bin")
    files.create_dir_all(bin_dir) ?? panic("bin dir")
    chromium :: files.join(bin_dir, "chromium")
    files.write(chromium, "x") ?? panic("chromium")
    found :: env_browser_find_engine_binary(files.join(root, "out"), "chromium") ?? panic("find chromium")
    assert_eq(found, chromium)
    files.remove_all(root).drop("test cleanup")
}
