// Rust: crates/jetpack/src/Transition.rs:2509
#Test("legacy_role_fold_restores_every_source_byte_identically") {
    root :: temp_root("legacy-round-trip")
    originals :: [(String, String)]{
        ("pkg.jet", "payload: { name: \"demo\", version: \"0.1.0\" }\n"),
        ("env.jet", "module env.dev {\n    tools: [\"git@nixpkgs\"]\n}\n\nmodule env.ci {\n    tools: [\"cargo@nixpkgs\"]\n}\n"),
        ("workspace.jet", "module workspace { members: [] }\n"),
        ("config.jet", "Config{ }\n")
    }
    loop (name, source) in originals {
        std.fs.write(files.join(root, name), source) ?? panic("write: {err}")
    }
    preview :: env_transition_init(root, true) ?? panic("preview: {err}")
    assert(preview.summary.changes.iter().any(change -> change.path == TRANSITION_PACKAGE_FILE))
    assert(preview.summary.before_fingerprint != preview.summary.after_fingerprint)
    env_transition_init(root, false) ?? panic("init: {err}")
    assert(std.fs.is_file(files.join(root, TRANSITION_PACKAGE_FILE)))
    assert(std.fs.is_file(files.join(root, "package/env-dev.jet")))
    assert(std.fs.is_file(files.join(root, "package/env-ci.jet")))
    migrated :: (PackageFacts.load(root) ?? panic("load: {err}")) ?? panic("missing facts")
    assert(migrated.name == "demo")
    assert(migrated.environments.has_key("dev"))
    assert(migrated.environments.has_key("ci"))
    assert(!std.fs.exists(files.join(root, "pkg.jet")))
    assert(!std.fs.exists(files.join(root, "env.jet")))
    assert(!std.fs.exists(files.join(root, "workspace.jet")))
    assert(!std.fs.exists(files.join(root, "config.jet")))
    assert(std.fs.is_file(preview.summary.journal))
    env_transition_restore_role_files(root, true) ?? panic("preview restore: {err}")
    env_transition_restore_role_files(root, false) ?? panic("restore: {err}")
    loop (name, source) in originals {
        assert((std.fs.read(files.join(root, name)) ?? panic("read: {err}")) == source.bytes())
    }
    assert(!std.fs.exists(files.join(root, TRANSITION_PACKAGE_FILE)))
    assert(!std.fs.exists(files.join(root, "package/env-dev.jet")))
    assert(!std.fs.exists(files.join(root, "package/env-ci.jet")))
    assert(!std.fs.exists(preview.summary.journal))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

