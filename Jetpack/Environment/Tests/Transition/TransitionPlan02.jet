// Rust: crates/jetpack/src/Transition.rs:2602
#Test("legacy_ambiguous_identity_is_rejected_before_writes") {
    cases :: [(String, String, String)]{
        ("legacy-mixed-identity", "payload: { name: \"demo\", version: \"0.1.0\" }\nname: \"other\"\n", "mixes top-level identity fields with an identity block"),
        ("legacy-duplicate-identity", "payload: { name: \"demo\", name: \"other\", version: \"0.1.0\" }\n", "identity declares field `name` more than once")
    }
    loop (label, source, expected) in cases {
        root :: temp_root(label)
        std.fs.write(files.join(root, "pkg.jet"), source) ?? panic("write: {err}")
        error :: env_transition_init(root, false).unwrap_err()
        assert(error.message().contains(expected))
        assert(!std.fs.exists(files.join(root, TRANSITION_PACKAGE_FILE)))
        assert(!std.fs.exists(files.join(root, ".jet/package-transition")))
        std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
    }
}

// Rust: crates/jetpack/src/Transition.rs:2626
#Test("legacy_restore_refuses_stale_root_without_mutation") {
    root :: temp_root("legacy-stale-restore")
    std.fs.write(files.join(root, "pkg.jet"), "payload: { name: \"demo\", version: \"0.1.0\" }\n") ?? panic("write: {err}")
    result :: env_transition_init(root, false) ?? panic("init: {err}")
    journal :: result.summary.journal
    package :: files.join(root, TRANSITION_PACKAGE_FILE)
    std.fs.write(package, "name: \"tampered\"\nversion: \"0.1.0\"\n") ?? panic("write: {err}")
    error :: env_transition_restore_role_files(root, false).unwrap_err()
    assert(error.message().contains("stale transition"))
    assert((std.fs.read_to_string(package) ?? panic("read: {err}")) == "name: \"tampered\"\nversion: \"0.1.0\"\n")
    assert(std.fs.is_file(journal))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

