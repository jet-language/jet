// Rust: crates/jetpack/src/Transition.rs:2365
#Test("hosts_split_binds_the_checked_system_name_not_the_output_key") {
    root :: temp_root("hosts-system-name")
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), "name: \"demo\"\noutputs: { server: System{ name: \"halcyon\", target: linux.x64 } }\n") ?? panic("write: {err}")
    env_transition_split(root, SplitTarget.Hosts("server"), false) ?? panic("split: {err}")
    fleet :: std.fs.read_to_string(files.join(root, "package/fleet.jet")) ?? panic("read: {err}")
    assert(fleet.contains("hosts: { server: system.halcyon }"))
    facts :: (PackageFacts.load(root) ?? panic("load: {err}")) ?? panic("missing facts")
    projection :: jet_env_model.ModuleEval.project_package_outputs(facts) ?? panic("project: {err}")
    assert(projection.systems[0].name == "halcyon")
    assert(projection.fleets[0].hosts[0].system == "halcyon")
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2393
#Test("fold_recovers_a_journaled_partial_split_without_touching_live_bytes") {
    root :: temp_root("hosts-partial")
    original :: "name: \"demo\"\noutputs: { server: System{ name: \"server\", target: linux.x64 } }\n".bytes()
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), original) ?? panic("write: {err}")
    plan :: env_transition_split_plan(root, SplitTarget.Hosts("server")) ?? panic("plan: {err}")
    env_transition_create_real_dirs(root, files.dirname(plan.journal_path)) ?? panic("mkdir: {err}")
    env_transition_write_atomic(plan.journal_path, plan.journal) ?? panic("journal: {err}")
    generated :: files.join(root, "package/fleet.jet")
    generated_change :: plan.changes.iter().find(change -> change.relative == "package/fleet.jet") ?? panic("missing change")
    env_transition_apply_state(root, generated, generated_change.after) ?? panic("apply state: {err}")
    env_transition_fold(root, "package/fleet.jet", false) ?? panic("fold: {err}")
    assert((std.fs.read(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")) == original)
    assert(!std.fs.exists(generated))
    assert(!std.fs.exists(plan.journal_path))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2425
#Test("corrupt_transition_journal_refuses_fold_without_mutation") {
    root :: temp_root("hosts-corrupt-journal")
    original :: "name: \"demo\"\noutputs: { server: System{ name: \"server\", target: linux.x64 } }\n".bytes()
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), original) ?? panic("write: {err}")
    env_transition_split(root, SplitTarget.Hosts("server"), false) ?? panic("split: {err}")
    live_package :: std.fs.read(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")
    journal :: (std.fs.read_dir(files.join(root, TRANSITION_JOURNAL_DIR)) ?? panic("read dir: {err}")).next().unwrap().unwrap().path()
    std.fs.write(journal, "corrupt\n".bytes()) ?? panic("write: {err}")
    error :: env_transition_fold(root, "package/fleet.jet", false).unwrap_err()
    assert(error.message().contains("unknown format"))
    assert((std.fs.read(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")) == live_package)
    assert(std.fs.is_file(files.join(root, "package/fleet.jet")))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2454
#Test("hosts_split_rejects_invalid_and_ambiguous_targets_before_writes") {
    invalid_root :: temp_root("hosts-invalid")
    std.fs.write(files.join(invalid_root, TRANSITION_PACKAGE_FILE), "name: \"demo\"\noutputs: { server: System{ name: \"server\" } }\n") ?? panic("write: {err}")
    invalid :: env_transition_split(invalid_root, SplitTarget.Hosts("server/name"), false).unwrap_err()
    assert(invalid.message().contains("invalid host name"))
    assert(!std.fs.exists(files.join(invalid_root, "package/fleet.jet")))
    std.fs.remove_dir_all(invalid_root) ?? panic("cleanup: {err}")
    ambiguous_root :: temp_root("hosts-ambiguous")
    std.fs.write(files.join(ambiguous_root, TRANSITION_PACKAGE_FILE), "name: \"demo\"\noutputs: { server: Executable{ name: \"server\", entry: run } }\n") ?? panic("write: {err}")
    ambiguous :: env_transition_split(ambiguous_root, SplitTarget.Hosts("server"), false).unwrap_err()
    assert(ambiguous.message().contains("host extraction needs a System Output"))
    assert(!std.fs.exists(files.join(ambiguous_root, "package/fleet.jet")))
    std.fs.remove_dir_all(ambiguous_root) ?? panic("cleanup: {err}")
}

