// Native filesystem fixtures. GATE #4494: std fs/env and atomic counter primitives.
use std.sync.atomic.[AtomicUsize, Ordering]
transition_test_counter :: AtomicUsize.new(1)

// Rust: crates/jetpack/src/Transition.rs:2235
fn temp_root(label: String) -[FS, Env]> String {
    sequence :: transition_test_counter.fetch_add(1, Ordering.Relaxed) // GATE #4494
    root :: files.join(std.env.temp_dir().to_string_lossy().to_string(), "jet-transition-{label}-{sequence}")
    std.fs.create_dir_all(root) ?? panic("temp root: {err}")
    root
}

// Rust: crates/jetpack/src/Transition.rs:2245
#Test("environment_split_and_fold_restore_exact_root") {
    root :: temp_root("env")
    original :: "name: \"demo\"\nenvironments: { development: Environment{ tools: [\"git\"] } }\n".bytes()
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), original) ?? panic("write: {err}")
    result :: env_transition_split(root, SplitTarget.Environment, false) ?? panic("split: {err}")
    assert(result.summary.before_fingerprint == result.summary.after_fingerprint)
    assert(std.fs.is_file(files.join(root, "package/env.jet")))
    env_transition_fold(root, "package/env.jet", false) ?? panic("fold: {err}")
    assert((std.fs.read(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")) == original)
    assert(!std.fs.exists(files.join(root, "package/env.jet")))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2263
#Test("stale_split_refuses_without_mutation") {
    root :: temp_root("stale")
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), "name: \"demo\"\nenvironments: { dev: Environment{ } }\n") ?? panic("write: {err}")
    plan :: env_transition_split_plan(root, SplitTarget.Environment) ?? panic("plan: {err}")
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), "name: \"changed\"\n") ?? panic("write: {err}")
    error :: plan.apply().unwrap_err()
    assert(error.message().contains("stale transition"))
    assert(!std.fs.exists(files.join(root, "package/env.jet")))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2279
#Test("package_split_moves_named_config_and_records_member") {
    root :: temp_root("member")
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), "name: \"workspace\"\napp :: Config{ version: \"1\" }\n") ?? panic("write: {err}")
    env_transition_split(root, SplitTarget.Package("app"), false) ?? panic("split: {err}")
    member :: std.fs.read_to_string(files.join(root, "packages/app/package.jet")) ?? panic("read: {err}")
    assert(member.contains("name: \"app\""))
    assert((std.fs.read_to_string(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")).contains("members:"))
    env_transition_fold(root, "packages/app/package.jet", false) ?? panic("fold: {err}")
    assert((std.fs.read_to_string(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")).contains("app :: Config"))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

// Rust: crates/jetpack/src/Transition.rs:2307
#Test("package_split_rejects_duplicate_member_name_before_writes") {
    root :: temp_root("member-duplicate")
    std.fs.create_dir_all(files.join(root, "packages/existing")) ?? panic("mkdir: {err}")
    std.fs.write(files.join(root, "packages/existing/package.jet"), "name: \"app\"\n") ?? panic("write: {err}")
    original :: "name: \"workspace\"\nmembers: [\"packages/existing\"]\napp :: Config{ version: \"1\" }\n"
    std.fs.write(files.join(root, TRANSITION_PACKAGE_FILE), original) ?? panic("write: {err}")
    error :: env_transition_split(root, SplitTarget.Package("app"), false).unwrap_err()
    assert(error.message().contains("member Package name `app` is declared more than once"))
    assert((std.fs.read_to_string(files.join(root, TRANSITION_PACKAGE_FILE)) ?? panic("read: {err}")) == original)
    assert(!std.fs.exists(files.join(root, "packages/app/package.jet")))
    std.fs.remove_dir_all(root) ?? panic("cleanup: {err}")
}

