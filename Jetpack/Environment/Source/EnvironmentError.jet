// The Environment area's one error carrier. Rust `io::Error` values keep
// their kind: file-system failures travel as `Io`, and the protocol-level
// `ErrorKind::InvalidData` / `InvalidInput` / `Unsupported` refusals carry
// their final text. Overlay failures keep the jet-pkg-model `OverlayError`
// payload so `jet overlay` diagnostics render the same bytes.

use {
    jet_env_model.[ManagedFile]
    jet_pkg_model.[OverlayError, PackageGateError]
}

#Error
EnvironmentError: enum {
    IO(IOError)
    InvalidData(String)
    InvalidInput(String)
    NotFound(String)
    Unsupported(String)
    Conflict(String)
    Other(String)
    Overlay(OverlayError)
    Transition(String)
    ManagedFile(String)
    Activation(String)
    Gate(PackageGateError)

    message: fn(self) -> String Never! {
        if self == {
            .IO(error) -> "{error}"
            .InvalidData(text) -> text
            .InvalidInput(text) -> text
            .NotFound(text) -> text
            .Unsupported(text) -> text
            .Conflict(text) -> text
            .Other(text) -> text
            .Overlay(error) -> error.message()
            .Transition(text) -> text
            .ManagedFile(text) -> text
            .Activation(text) -> text
            .Gate(error) -> error.message()
        }
    }

    // Rust `error.kind() == ErrorKind::NotFound` across both carriers.
    is_not_found: fn(self) -> Bool Never! {
        if self == {
            .IO(error) -> {
                if error == {
                    .NotFound(context) -> true
                    .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
                }
            }
            .NotFound(text) -> true
            .InvalidData(_) | .InvalidInput(_) | .Unsupported(_) | .Conflict(_) | .Other(_) | .Overlay(_) | .Transition(_) | .ManagedFile(_) | .Activation(_) | .Gate(_) -> false
        }
    }
}

impl IOError -> EnvironmentError { EnvironmentError.IO(self) }

impl OverlayError -> EnvironmentError { EnvironmentError.Overlay(self) }
