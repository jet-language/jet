// Rust: crates/jetpack/src/Transition.rs:2002
fn env_transition_render_fleet_config(host: String, system: String) -> String Never! {
    "pub home :: Config{{\n    outputs: {{\n        home: Fleet{{\n            name: \"home\"\n            hosts: {{ {host}: system.{system} }}\n        }}\n    }}\n}}\n"
}

