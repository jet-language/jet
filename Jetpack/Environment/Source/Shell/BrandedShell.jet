// Branded interactive shells (D-JPK14): the generated bash rc, zsh rc, and
// fish init that give a temporary Jetpack shell its prompt, receipts, status
// glance, and help-app prefill widgets. The prompt label never enters shell
// source: every generated prompt reads `$JETPACK_PROMPT_LABEL` through a fixed
// quoted print, so label contents stay data.

ENV_SHELL_PROMPT_LABEL_ENV :: prep { "JETPACK_PROMPT_LABEL" }

// One ASCII control byte as text. Plain Jet strings have no byte escapes, so
// the readline invisible markers (0x01/0x02) and ESC are built here.
fn env_shell_control(code: Int) -> String Never! {
    String.from_bytes([U8]{U8{code}}) ?? ""
}

// The shells Jetpack can decorate. Anything else falls back to `bash`.
pub enum ShellKind {
    Bash
    Zsh
    Fish

    fn binary(self) -> String Never! {
        if self == {
            .Bash -> "bash"
            .Zsh -> "zsh"
            .Fish -> "fish"
        }
    }

    // Detect the user's shell from `$SHELL`, defaulting to bash.
    fn detect() -[Env]> ShellKind Never! {
        shell :: sys.get("SHELL") ?? ""
        base :: shell.cut_last("/")?.after ?? shell
        if base == {
            "zsh" -> ShellKind.Zsh
            "fish" -> ShellKind.Fish
            else -> ShellKind.Bash
        }
    }

    // The shell argument of `jet env hook <shell>` / `jet env export <shell>`.
    // `None` detects from `$SHELL`; an unknown name is `None`.
    fn parse(arg: String?) -[Env]> ShellKind? Never! {
        name :: arg ?? return Val(ShellKind.detect())
        if name == {
            "bash" -> Val(ShellKind.Bash)
            "zsh" -> Val(ShellKind.Zsh)
            "fish" -> Val(ShellKind.Fish)
            else -> None
        }
    }

    // Help-app prefill widgets for an already-running user shell (`jet env
    // hook`) and for Jet subshells. Idempotent when sourced twice.
    fn help_prefill_widgets(self) -> String Never! {
        lines :: if self == {
            .Bash -> [String]{
                "if ! type __jet_help_prefill >/dev/null 2>&1; then",
                "  __jet_help_prefill() {{ local picked; picked=$(JET_HELP_SHELL_PREFILL=1 command jet '?' </dev/tty) || return; [ -n \"$picked\" ] || return; READLINE_LINE=$picked; READLINE_POINT=$(printf %s \"$READLINE_LINE\" | wc -c); }}",
                "  bind -x '\"\\e?\":__jet_help_prefill' 2>/dev/null || true",
                "  jet() {{ if [ \"$#\" -eq 1 ] && [ \"$1\" = '?' ]; then local picked code line; picked=$(JET_HELP_SHELL_PREFILL=1 command jet '?' </dev/tty); code=$?; [ -n \"$picked\" ] || return $code; if IFS= read -r -e -i \"$picked\" -p \"${{PS1@P}}\" line; then [ -n \"$line\" ] || return 0; history -s -- \"$line\"; eval -- \"$line\"; return $?; fi; return 0; fi; command jet \"$@\"; }}",
                "fi"
            }
            .Zsh -> [String]{
                "if ! typeset -f __jet_help_prefill >/dev/null 2>&1; then",
                "  __jet_help_prefill() {{ local picked=$(JET_HELP_SHELL_PREFILL=1 command jet '?' </dev/tty); [[ -n $picked ]] || return; BUFFER=$picked; CURSOR=$#BUFFER; zle redisplay; }}",
                "  zle -N __jet_help_prefill 2>/dev/null || true",
                "  bindkey '^[?' __jet_help_prefill 2>/dev/null || true",
                "  jet() {{ if [[ $# -eq 1 && $1 == '?' ]]; then local picked; picked=$(JET_HELP_SHELL_PREFILL=1 command jet '?' </dev/tty) || return; [[ -n $picked ]] || return 0; print -z -- \"$picked\"; return 0; fi; command jet \"$@\"; }}",
                "  alias jet='noglob jet'",
                "fi"
            }
            .Fish -> [String]{
                "if not functions -q __jet_help_prefill",
                "  function __jet_help_prefill; set -l picked (begin; set -lx JET_HELP_SHELL_PREFILL 1; command jet '?' </dev/tty; end); test -n \"$picked\"; or return; commandline -r -- \"$picked\"; commandline -C (string length -- \"$picked\"); end",
                "  bind \\e\\? __jet_help_prefill",
                "  function jet; if test (count $argv) -eq 1; and test \"$argv[1]\" = '?'; set -e __jet_help_pending; set -l picked (begin; set -lx JET_HELP_SHELL_PREFILL 1; command jet '?' </dev/tty; end); set -l code $status; if test -n \"$picked\"; set -g __jet_help_pending \"$picked\"; end; return $code; end; command jet $argv; end",
                "  function __jet_help_postexec --on-event fish_postexec; set -q __jet_help_pending; or return; commandline -r -- \"$__jet_help_pending\"; commandline -C (string length -- \"$__jet_help_pending\"); set -e __jet_help_pending; end",
                "end"
            }
        }
        "{lines.join("\n")}\n"
    }
}

// The branded interactive-shell command a caller with its own outer process
// appends after its own `--command` flag, so a shell entered outside
// `ShellEnv.enter` still gets the jetpack prompt. `env_vars` must be set on
// the outer command; `cleanup` runs once the caller's blocking wait returns.
pub struct BrandedShell {
    pub command_tail: [String]
    pub env_vars: [(name: String, value: String)]
    cleanup_file: String?
    cleanup_dir: String?

    fn cleanup(self) -[FS]> {
        if self.cleanup_file == {
            .Val(path) -> env_shell_remove_file(path)
            .None -> {}
        }
        if self.cleanup_dir == {
            .Val(path) -> env_shell_remove_tree(path)
            .None -> {}
        }
    }

    // Build a branded shell for `kind`, labeling the prompt with `label`.
    fn for_shell(kind: ShellKind, label: String) -[FS, Env, Time]> BrandedShell Never! {
        path :: PromptPathMode.Short
        strip :: PromptStripMode.Off
        if kind == {
            .Bash -> {
                rc :: env_shell_write_temp("jetpack-bashrc", env_shell_bash_rc(label, path, strip))
                BrandedShell{
                    command_tail: [String]{"bash", "--rcfile", rc, "-i"},
                    env_vars: [(name: String, value: String)]{(name: ENV_SHELL_PROMPT_LABEL_ENV, value: label)},
                    cleanup_file: Val(rc),
                    cleanup_dir: None
                }
            }
            .Zsh -> {
                dir :: env_shell_write_temp_dir("jetpack-zdotdir")
                env_shell_write_best_effort(files.join(dir, ".zshrc"), env_shell_zsh_rc(label, path, strip))
                BrandedShell{
                    command_tail: [String]{"zsh", "-i"},
                    env_vars: [(name: String, value: String)]{
                        (name: "ZDOTDIR", value: dir),
                        (name: ENV_SHELL_PROMPT_LABEL_ENV, value: label)
                    },
                    cleanup_file: None,
                    cleanup_dir: Val(dir)
                }
            }
            .Fish -> BrandedShell{
                command_tail: [String]{"fish", "-C", env_shell_fish_init(label, path, strip), "-i"},
                env_vars: [(name: String, value: String)]{(name: ENV_SHELL_PROMPT_LABEL_ENV, value: label)},
                cleanup_file: None,
                cleanup_dir: None
            }
        }
    }
}

// ── prompt / rc generation ──

// Source the user's real bashrc first, then override the prompt so the
// jetpack label is unmistakable: bold cyan label, blue path, green ❯.
//
// The zero-width color runs are wrapped in raw 0x01/0x02 bytes (readline's
// invisible-marker pair) rather than `\[`/`\]`: bash 5.3 stopped rewriting
// `\[`/`\]` on this path, so they printed literally inside `nix develop`-
// wrapped shells. The raw markers work on every bash and are invisible
// control bytes when readline isn't displaying at all.
fn env_shell_bash_rc(label: String, path: PromptPathMode, strip: PromptStripMode) -> String Never! {
    _ :: label
    soh :: env_shell_control(1)
    stx :: env_shell_control(2)
    esc :: env_shell_control(27)
    path_escape :: if path == {
        .Short -> "\\W"
        .Full -> "\\w"
    }
    status_prefix :: if strip == PromptStripMode.On -> "$(__jetpack_status_words)\\n" else -> ""
    accent :: ACCENT_SGR
    border :: BORDER_SGR
    success :: SUCCESS_SGR
    warn :: WARN_SGR
    error :: ERROR_SGR
    lines :: [String]{
        "[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc",
        "[ -f \"$HOME/.bashrc\" ] && . \"$HOME/.bashrc\"",
        "__jetpack_build_status='never run'",
        "__jetpack_test_status='never run'",
        "__jetpack_active=0",
        "__jetpack_spinner_pid=''",
        "__jetpack_git_status() {{",
        "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then",
        "local branch dirty",
        "branch=$(git branch --show-current 2>/dev/null); [ -n \"$branch\" ] || branch='detached'",
        "git diff --quiet --ignore-submodules -- 2>/dev/null && git diff --cached --quiet --ignore-submodules -- 2>/dev/null && dirty='clean' || dirty='changed'",
        "printf '%s %s' \"$branch\" \"$dirty\"",
        "else printf 'not a git worktree'; fi",
        "}}",
        "__jetpack_status_words() {{ printf 'build %s · test %s · git %s' \"$__jetpack_build_status\" \"$__jetpack_test_status\" \"$(__jetpack_git_status)\"; }}",
        "__jetpack_status_glance() {{ printf '\\n%s\\n' \"$(__jetpack_status_words)\"; }}",
        "bind -x '\"\\C-g\":__jetpack_status_glance' 2>/dev/null || true",
        "__jetpack_spinner() {{ local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0; while :; do if [ \"${{NO_COLOR+x}}\" = x ]; then printf '\\r%s running %s · %ss' \"${{frames:i++%10:1}}\" \"$1\" \"$(( $(date +%s) - $2 ))\" >&2; else printf '\\r\\033[{accent}m%s\\033[0m running %s · %ss' \"${{frames:i++%10:1}}\" \"$1\" \"$(( $(date +%s) - $2 ))\" >&2; fi; sleep .1; done; }}",
        "__jetpack_preexec() {{",
        "[ \"$__jetpack_active\" = 0 ] || return",
        "case \"$1\" in jet\\ build*) __jetpack_kind=build;; jet\\ test*) __jetpack_kind=test;; *) return;; esac",
        "__jetpack_active=1; __jetpack_command=$1; __jetpack_started=$(date +%s)",
        "if [ -t 2 ]; then __jetpack_spinner \"$__jetpack_kind\" \"$__jetpack_started\" & __jetpack_spinner_pid=$!; fi",
        "}}",
        "__jetpack_precmd() {{",
        "local code=$?",
        "if [ \"$__jetpack_active\" = 1 ]; then",
        "[ -z \"$__jetpack_spinner_pid\" ] || {{ kill \"$__jetpack_spinner_pid\" 2>/dev/null; wait \"$__jetpack_spinner_pid\" 2>/dev/null; if [ \"${{NO_COLOR+x}}\" = x ]; then printf '\\r                                        \\r' >&2; else printf '\\r\\033[2K' >&2; fi; }}",
        "local elapsed=$(( $(date +%s) - __jetpack_started )) result",
        "if [ \"$code\" = 0 ]; then result=ok; else result=\"failed ($code)\"; fi",
        "if [ \"$__jetpack_kind\" = build ]; then __jetpack_build_status=\"$result · ${{elapsed}}s\"; else __jetpack_test_status=\"$result · ${{elapsed}}s\"; fi",
        "if [ \"${{NO_COLOR+x}}\" = x ]; then printf '%s %s · %ss\\n' \"$__jetpack_kind\" \"$result\" \"$elapsed\"; else [ \"$code\" = 0 ] && printf '\\033[{success}m✓\\033[0m %s ok · %ss\\n' \"$__jetpack_kind\" \"$elapsed\" || printf '\\033[{error}m✗\\033[0m %s failed (%s) · %ss\\n' \"$__jetpack_kind\" \"$code\" \"$elapsed\"; fi",
        "[ \"$code\" = 0 ] || {{ [ \"${{NO_COLOR+x}}\" = x ] && printf '%s\\n' \"-> $__jetpack_kind failed. Rerun: $__jetpack_command\" || printf '\\033[{warn}m→\\033[0m %s\\n' \"$__jetpack_kind failed. Rerun: $__jetpack_command\"; }}",
        "__jetpack_active=0; __jetpack_spinner_pid=''",
        "fi",
        "return \"$code\"",
        "}}",
        "trap '__jetpack_preexec \"$BASH_COMMAND\"' DEBUG",
        "PROMPT_COMMAND=\"__jetpack_precmd${{PROMPT_COMMAND:+;$PROMPT_COMMAND}}\"",
        "if [ \"${{NO_COLOR+x}}\" = x ]; then",
        "PS1='{status_prefix}$(printf \"%s\" \"$JETPACK_PROMPT_LABEL\") {path_escape} > '",
        "else",
        "PS1='{status_prefix}{soh}{esc}[{accent}m{stx}$(printf \"%s\" \"$JETPACK_PROMPT_LABEL\"){soh}{esc}[0m{stx} {soh}{esc}[{border}m{stx}{path_escape}{soh}{esc}[0m{stx} {soh}{esc}[{success}m{stx}❯{soh}{esc}[0m{stx} '",
        "fi"
    }
    rc :: lines.join("\n")
    "{rc}\n{ShellKind.Bash.help_prefill_widgets()}"
}

fn env_shell_zsh_rc(label: String, path: PromptPathMode, strip: PromptStripMode) -> String Never! {
    _ :: label
    path_escape :: if path == {
        .Short -> "%1~"
        .Full -> "%~"
    }
    status_prefix :: if strip == PromptStripMode.On -> "$(__jetpack_status_words)\n" else -> ""
    accent :: ACCENT_SGR
    border :: BORDER_SGR
    success :: SUCCESS_SGR
    warn :: WARN_SGR
    error :: ERROR_SGR
    lines :: [String]{
        "[ -f \"$HOME/.zshrc\" ] && source \"$HOME/.zshrc\"",
        "setopt prompt_subst",
        "setopt NO_NOMATCH",
        "zmodload zsh/datetime",
        "typeset -g __jetpack_build_status='never run' __jetpack_test_status='never run' __jetpack_kind='' __jetpack_command='' __jetpack_started=0 __jetpack_spinner_pid=''",
        "__jetpack_git_status() {{ if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then local branch=$(git branch --show-current 2>/dev/null); [[ -n $branch ]] || branch=detached; if git diff --quiet --ignore-submodules -- 2>/dev/null && git diff --cached --quiet --ignore-submodules -- 2>/dev/null; then print -n -- \"$branch clean\"; else print -n -- \"$branch changed\"; fi; else print -n -- 'not a git worktree'; fi; }}",
        "__jetpack_status_words() {{ printf 'build %s · test %s · git %s' \"$__jetpack_build_status\" \"$__jetpack_test_status\" \"$(__jetpack_git_status)\"; }}",
        "__jetpack_status_glance() {{ printf '\\n%s\\n' \"$(__jetpack_status_words)\"; zle reset-prompt; }}",
        "zle -N __jetpack_status_glance 2>/dev/null || true",
        "bindkey '^G' __jetpack_status_glance 2>/dev/null || true",
        "__jetpack_spinner() {{ local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏); local i=1; while true; do if [[ ${{+NO_COLOR}} = 1 ]]; then printf '\\r%s running %s · %ss' $frames[$i] $1 $(( $EPOCHSECONDS - $2 )) >&2; else printf '\\r\\033[{accent}m%s\\033[0m running %s · %ss' $frames[$i] $1 $(( $EPOCHSECONDS - $2 )) >&2; fi; (( i = i % 10 + 1 )); sleep .1; done; }}",
        "__jetpack_preexec() {{ case $1 in 'jet build'*) __jetpack_kind=build;; 'jet test'*) __jetpack_kind=test;; *) __jetpack_kind=''; return;; esac; __jetpack_command=$1; __jetpack_started=$EPOCHSECONDS; if [[ -t 2 ]]; then __jetpack_spinner $__jetpack_kind $__jetpack_started &!; __jetpack_spinner_pid=$!; fi; }}",
        "__jetpack_precmd() {{ local code=$?; [[ -n $__jetpack_kind ]] || return; if [[ -n $__jetpack_spinner_pid ]]; then kill $__jetpack_spinner_pid 2>/dev/null; wait $__jetpack_spinner_pid 2>/dev/null; if [[ ${{+NO_COLOR}} = 1 ]]; then printf '\\r                                        \\r' >&2; else printf '\\r\\033[2K' >&2; fi; fi; local elapsed=$(( EPOCHSECONDS - __jetpack_started )) result; [[ $code = 0 ]] && result=ok || result=\"failed ($code)\"; [[ $__jetpack_kind = build ]] && __jetpack_build_status=\"$result · ${{elapsed}}s\" || __jetpack_test_status=\"$result · ${{elapsed}}s\"; if [[ ${{+NO_COLOR}} = 1 ]]; then printf '%s %s · %ss\\n' $__jetpack_kind \"$result\" $elapsed; else [[ $code = 0 ]] && printf '\\033[{success}m✓\\033[0m %s ok · %ss\\n' $__jetpack_kind $elapsed || printf '\\033[{error}m✗\\033[0m %s failed (%s) · %ss\\n' $__jetpack_kind $code $elapsed; fi; if [[ $code != 0 ]]; then [[ ${{+NO_COLOR}} = 1 ]] && printf '%s\\n' \"-> $__jetpack_kind failed. Rerun: $__jetpack_command\" || printf '\\033[{warn}m→\\033[0m %s\\n' \"$__jetpack_kind failed. Rerun: $__jetpack_command\"; fi; __jetpack_kind=''; __jetpack_spinner_pid=''; }}",
        "autoload -Uz add-zsh-hook; add-zsh-hook preexec __jetpack_preexec; add-zsh-hook precmd __jetpack_precmd",
        "if [[ ${{+NO_COLOR}} = 1 ]]; then",
        "PROMPT=$'{status_prefix}$(print -r -- \"$JETPACK_PROMPT_LABEL\") {path_escape} > '",
        "else",
        "PROMPT=$'{status_prefix}%{{\\033[{accent}m%}}$(print -r -- \"$JETPACK_PROMPT_LABEL\")%{{\\033[0m%}} %{{\\033[{border}m%}}{path_escape}%{{\\033[0m%}} %{{\\033[{success}m%}}❯%{{\\033[0m%}} '",
        "fi"
    }
    rc :: lines.join("\n")
    "{rc}\n{ShellKind.Zsh.help_prefill_widgets()}"
}

fn env_shell_fish_init(label: String, path: PromptPathMode, strip: PromptStripMode) -> String Never! {
    _ :: label
    path_expr :: if path == {
        .Short -> "prompt_pwd"
        .Full -> "pwd"
    }
    strip_line :: if strip == PromptStripMode.On -> "__jetpack_status_words; echo; " else -> ""
    accent :: ACCENT_SGR
    border :: BORDER_SGR
    success :: SUCCESS_SGR
    warn :: WARN_SGR
    error :: ERROR_SGR
    parts :: [String]{
        "set -g __jetpack_build_status 'never run'; set -g __jetpack_test_status 'never run'; set -g __jetpack_kind ''; set -g __jetpack_command ''; set -g __jetpack_started 0; set -g __jetpack_spinner_pid ''; ",
        "function __jetpack_git_status; if git rev-parse --is-inside-work-tree >/dev/null 2>&1; set -l branch (git branch --show-current 2>/dev/null); test -n \"$branch\"; or set branch detached; if git diff --quiet --ignore-submodules -- 2>/dev/null; and git diff --cached --quiet --ignore-submodules -- 2>/dev/null; echo -n \"$branch clean\"; else; echo -n \"$branch changed\"; end; else; echo -n 'not a git worktree'; end; end; ",
        "function __jetpack_status_words; printf 'build %s · test %s · git %s' \"$__jetpack_build_status\" \"$__jetpack_test_status\" (__jetpack_git_status); end; ",
        "function __jetpack_status_glance; echo; __jetpack_status_words; echo; commandline -f repaint; end; ",
        "bind \\cg __jetpack_status_glance; ",
        "function __jetpack_spinner; set -l frames ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏; set -l i 1; while true; if set -q NO_COLOR; printf '\\r%s running %s · %ss' $frames[$i] $argv[1] (math (date +%s) - $argv[2]) >&2; else; printf '\\r\\033[{accent}m%s\\033[0m running %s · %ss' $frames[$i] $argv[1] (math (date +%s) - $argv[2]) >&2; end; set i (math $i % 10 + 1); sleep .1; end; end; ",
        "function __jetpack_preexec --on-event fish_preexec; switch $argv[1]; case \"jet build*\"; set -g __jetpack_kind build; case \"jet test*\"; set -g __jetpack_kind test; case '*'; set -g __jetpack_kind ''; return; end; set -g __jetpack_command $argv[1]; set -g __jetpack_started (date +%s); if isatty stderr; command sh -c 'while :; do if [ \"${{NO_COLOR+x}}\" = x ]; then printf \"\\r⠹ running %s · %ss\" \"$0\" \"$(( $(date +%s) - $1 ))\" >&2; else printf \"\\r\\033[{accent}m⠹\\033[0m running %s · %ss\" \"$0\" \"$(( $(date +%s) - $1 ))\" >&2; fi; sleep .1; done' $__jetpack_kind $__jetpack_started &\nset -g __jetpack_spinner_pid $last_pid; end; end; ",
        "function __jetpack_postexec --on-event fish_postexec; set -l code $status; test -n \"$__jetpack_kind\"; or return; if test -n \"$__jetpack_spinner_pid\"; kill $__jetpack_spinner_pid 2>/dev/null; wait $__jetpack_spinner_pid 2>/dev/null; if set -q NO_COLOR; printf '\\r                                        \\r' >&2; else; printf '\\r\\033[2K' >&2; end; end; set -l elapsed (math (date +%s) - $__jetpack_started); set -l result ok; test $code -eq 0; or set result \"failed ($code)\"; if test $__jetpack_kind = build; set -g __jetpack_build_status \"$result · \"$elapsed\"s\"; else; set -g __jetpack_test_status \"$result · \"$elapsed\"s\"; end; if set -q NO_COLOR; printf '%s %s · %ss\\n' $__jetpack_kind \"$result\" $elapsed; else if test $code -eq 0; printf '\\033[{success}m✓\\033[0m %s ok · %ss\\n' $__jetpack_kind $elapsed; else; printf '\\033[{error}m✗\\033[0m %s failed (%s) · %ss\\n' $__jetpack_kind $code $elapsed; end; if test $code -ne 0; if set -q NO_COLOR; echo \"-> $__jetpack_kind failed. Rerun: $__jetpack_command\"; else; printf '\\033[{warn}m→\\033[0m %s\\n' \"$__jetpack_kind failed. Rerun: $__jetpack_command\"; end; end; set -g __jetpack_kind ''; set -g __jetpack_spinner_pid ''; end; ",
        "function fish_prompt; {strip_line}",
        "if set -q NO_COLOR; printf '%s ' \"$JETPACK_PROMPT_LABEL\"; echo -n ({path_expr}); echo -n ' > '; ",
        "else; printf '\\033[{accent}m%s\\033[0m ' \"$JETPACK_PROMPT_LABEL\"; ",
        "printf '\\033[{border}m%s\\033[0m' ({path_expr}); ",
        "printf ' \\033[{success}m❯\\033[0m '; end; end\n"
    }
    init :: parts.join("")
    "{init}{ShellKind.Fish.help_prefill_widgets()}"
}

// ── scratch files for generated shell init ──

// The scratch files and directories one shell entry owns; closing removes
// them, so a temporary shell leaves nothing behind.
struct ShellScratch {
    scratch_files: [String]
    scratch_dirs: [String]

    fn empty() -> ShellScratch Never! {
        ShellScratch{scratch_files: [String]{}, scratch_dirs: [String]{}}
    }
}

impl ShellScratch.Close {
    fn close(^self) -[FS]> {
        loop path in self.scratch_files -> env_shell_remove_file(path)
        loop path in self.scratch_dirs -> env_shell_remove_tree(path)
    }
}

// Best-effort scratch cleanup: a scratch path that is already gone or cannot
// be removed never turns a finished shell session into a failure.
fn env_shell_remove_file(path: String) -[FS]> {
    files.remove(path) ?? return
}

fn env_shell_remove_tree(path: String) -[FS]> {
    files.remove_all(path) ?? return
}

// Best-effort generated-init write; a failed write surfaces when the shell
// starts without its rc, exactly as the Rust helpers ignored it.
fn env_shell_write_best_effort(path: String, contents: String) -[FS]> {
    files.write(path, contents) ?? return
}

fn env_shell_unique_tmp(prefix: String) -[Env, Time]> String Never! {
    files.join(sys.temp_dir(), "{prefix}-{sys.pid()}-{time.instant().unix_ns}")
}

fn env_shell_write_temp(prefix: String, contents: String) -[FS, Env, Time]> String Never! {
    path :: env_shell_unique_tmp(prefix)
    env_shell_write_best_effort(path, contents)
    path
}

fn env_shell_write_temp_dir(prefix: String) -[FS, Env, Time]> String Never! {
    path :: env_shell_unique_tmp(prefix)
    files.create_dir_all(path) ?? return path
    path
}
