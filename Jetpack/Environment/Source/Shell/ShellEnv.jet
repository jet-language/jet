// Env composition and command execution (D-JPK14). Jetpack composes the
// environment itself (PATH plus markers) and runs commands or the user's own
// shell as a child with that environment; the parent shell's environment is
// never mutated. A verified executable can instead take over the process
// (D-CORE-PROCREPLACE1) so the tool owns the terminal and process number.

// Rust Platform::clean_path: the minimal host-independent PATH available to
// clean child processes. Declared Jet bins are prepended by the caller.
pub fn env_shell_clean_path() -[Env]> String Never! {
    if sys.is_windows() -> return "C:\\Windows\\System32;C:\\Windows"
    "/usr/bin:/bin"
}

// Rust Platform::path_separator for the running host.
fn env_shell_path_separator() -[Env]> String Never! {
    pkg_path_separator_for_os(sys.name())
}

// Append `dir` once, preserving first-seen order.
fn env_shell_push_unique(seen: &[String: Bool], parts: &[String], dir: String) Never! {
    if seen.has_key(dir) -> return
    seen[dir] = true
    &parts.push(dir)
}

// How one command run treats the host environment, stdout, and the process.
struct ShellRunOptions {
    // Start from an empty environment: only declared facts enter the child.
    clean: Bool
    // Keep the child's stdout out of a generated shell script.
    silent: Bool
    // Replace this process with a lease-resolved executable.
    replace_process: Bool
}

// A composed environment: what to expose and how to label the prompt.
pub struct ShellEnv {
    pub bin_dirs: [String]
    // Provider-owned runtime search paths projected into child processes.
    pub vars: [String: String]
    // Variables that must not leak from the parent shell into this env.
    pub unset_vars: [String]
    pub refs: [String]
    pub label: String
    pub prompt_path: PromptPathMode
    pub prompt_strip: PromptStripMode
    // Cache verification leases stay live through child process handoff.
    pub cache_leases: [CacheLease]

    // Prepend our bin dirs to `base_path`, deduping while preserving order.
    fn composed_path(self, base_path: String) -[Env]> String Never! {
        separator :: env_shell_path_separator()
        seen := [String: Bool]{}
        parts := [String]{}
        loop lease in self.cache_leases {
            wrapper :: lease.wrapper_dir() ?? next
            env_shell_push_unique(&seen, &parts, wrapper)
        }
        loop dir in self.bin_dirs -> env_shell_push_unique(&seen, &parts, dir)
        loop dir in base_path.split(separator) {
            if dir == "" -> next
            env_shell_push_unique(&seen, &parts, dir)
        }
        parts.join(separator)
    }

    // Compose a PATH a parent shell can evaluate after this process exits.
    // Lease descriptors and private wrappers are process-local, so they are
    // replaced by sealed canonical Hangar bin directories; a lease without
    // one makes the whole PATH unavailable.
    fn composed_path_for_parent(self, base_path: String) -[Env]> String? Never! {
        seen := [String: Bool]{}
        lease_paths := [String: Bool]{}
        lease_bin_dirs := [String]{}
        loop lease in self.cache_leases {
            if lease.projected_bin_dir() == .Val(path) {
                lease_paths[path] = true
                parent_bin :: lease.parent_shell_bin_dir() ?? return None
                &lease_bin_dirs.push(parent_bin)
            }
            if lease.wrapper_dir() == .Val(wrapper) -> lease_paths[wrapper] = true
        }
        parts := [String]{}
        loop dir in lease_bin_dirs -> env_shell_push_unique(&seen, &parts, dir)
        loop dir in self.bin_dirs {
            if !lease_paths.has_key(dir) -> env_shell_push_unique(&seen, &parts, dir)
        }
        separator :: env_shell_path_separator()
        loop dir in base_path.split(separator) {
            if dir == "" -> next
            env_shell_push_unique(&seen, &parts, dir)
        }
        Val(parts.join(separator))
    }

    // The composed environment over the caller's inherited PATH.
    fn apply_to(&self, spec: ProcessSpec) -[Env]> ProcessSpec Never! {
        base :: sys.get("PATH") ?? ""
        &self.apply_to_base(spec, base)
    }

    // Only the declared environment and realized PATH. Callers clear the
    // child environment first for clean-shell checks and task probes.
    fn apply_clean_to(&self, spec: ProcessSpec) -[Env]> ProcessSpec Never! {
        &self.apply_to_base(spec, env_shell_clean_path())
    }

    // Lease handles travel into the child at their pinned slots
    // (D-CORE-PROCINHERIT1), which also records the process handoff.
    fn apply_to_base(&self, spec: ProcessSpec, base_path: String) -[Env]> ProcessSpec Never! {
        out := spec
        loop index in 0..<self.cache_leases.len() {
            out = &self.cache_leases[index].keep_open_for(out)
        }
        out = out.env("PATH", self.composed_path(base_path))
        loop name in envmodel_sorted_keys(self.vars) -> out = out.env(name, self.vars[name])
        loop name in self.unset_vars -> out = out.env_remove(name)
        out = out.env(JETPACK_ENV_MARKER, "1").env(JETPACK_REF_VAR, self.refs.join(" "))
        if self.vars.get("JET_ROOT") == .Val(root) -> out = out.env(ENV_HOOK_ACTIVE_DIR_VAR, root)
        out
    }

    // False after reporting the first lease whose verified bytes changed.
    fn validate_cache(self, theme: Theme) -[IO, Time.Wait]> Bool Never! {
        loop lease in self.cache_leases {
            failure :: lease.integrity_failure() ?? next
            store_report_integrity(theme, failure)
            return false
        }
        true
    }

    // Run `cmd_args` inside the composed env and return its exit code. The
    // Jetpack process stays the parent so callers can do post-command work.
    fn run_command(&self, cmd_args: [String]) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, None, ShellRunOptions{clean: false, silent: false, replace_process: false})
    }

    // Replace the Jetpack process with a verified environment command. Only
    // a lease-resolved executable replaces the process; Nix namespace
    // projections and ordinary host commands keep the waiting parent.
    fn exec_command(&self, cmd_args: [String]) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, None, ShellRunOptions{clean: false, silent: false, replace_process: true})
    }

    // Run with an explicit working directory; it belongs to the child only.
    fn run_command_in(&self, cmd_args: [String], cwd: String?) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, cwd, ShellRunOptions{clean: false, silent: false, replace_process: false})
    }

    // Run while keeping stdout out of a generated shell script; stderr stays
    // visible so a failed task still explains itself.
    fn run_command_in_silent(&self, cmd_args: [String], cwd: String?) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, cwd, ShellRunOptions{clean: false, silent: true, replace_process: false})
    }

    // Run with no inherited host variables: only the composed PATH, declared
    // variables, Jet markers, and declared unsets enter the child.
    fn run_clean_command(&self, cmd_args: [String]) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, None, ShellRunOptions{clean: true, silent: false, replace_process: false})
    }

    fn run_clean_command_in(&self, cmd_args: [String], cwd: String?) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, cwd, ShellRunOptions{clean: true, silent: false, replace_process: false})
    }

    fn run_clean_command_in_silent(&self, cmd_args: [String], cwd: String?) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.run_command_in_mode(cmd_args, cwd, ShellRunOptions{clean: true, silent: true, replace_process: false})
    }

    fn run_command_in_mode(&self, cmd_args: [String], cwd: String?, options: ShellRunOptions) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        if !self.validate_cache(Theme.resolve_choice(ColorChoice.Never)) -> return 126
        if cmd_args.len() == 0 -> return 0
        program :: cmd_args[0]
        rest :: cmd_args[1..<cmd_args.len()]
        caller_dir :: env_shell_command_lookup_directory(cwd)
        stable_program := String?{None}
        loop lease in self.cache_leases {
            if lease.executable_for_command_at(program, caller_dir) == {
                .Ok(found) -> {
                    if stable_program == None -> stable_program = found
                }
                .Err(error) -> {
                    Theme.resolve_choice(ColorChoice.Auto).error_coded("E1340", "could not run `{program}`", "{error}", "use a recorded executable member or a caller-approved system path")
                    return 126
                }
            }
        }
        direct_exec :: options.replace_process && stable_program != None
        launch :: if stable_program == {
            .Val(path) -> ShellLaunch.plain(process.cmd([String]{path}).args_extend(rest))
            .None -> {
                if env_shell_nix_projection_command(self, program, rest) == {
                    .Ok(projected) -> projected ?? ShellLaunch.plain(process.cmd([String]{program}).args_extend(rest))
                    .Err(error) -> {
                        env_shell_report_nix_projection_error(Theme.resolve_choice(ColorChoice.Auto), program, error)
                        return 126
                    }
                }
            }
        }
        scratch :: launch.scratch
        defer close(^scratch)
        spec := launch.spec
        if cwd == .Val(directory) -> spec = spec.cwd(directory)
        spec = if options.clean -> &self.apply_clean_to(spec.env_clear()) else -> &self.apply_to(spec)
        spec = spec.stdin(.Inherit).stderr(.Inherit)
        // Rust discards a silent child's stdout; Core has no null stream, so
        // the bytes are captured and dropped with the receipt.
        spec = if options.silent -> spec.stdout(.Capture) else -> spec.stdout(.Inherit)
        suffix :: if options.clean -> " in a clean env" else -> ""
        if direct_exec {
            if spec.replace_process() == {
                .Err(error) -> Theme.resolve_choice(ColorChoice.Auto).error("could not run `{program}`{suffix}", "{error}", "check that the command exists in this environment and can start")
                else -> {}
            }
            return EXIT_USER_ERROR
        }
        if spec.run() == {
            .Ok(receipt) -> env_shell_exit_code(receipt, 1)
            .Err(error) -> {
                Theme.resolve_choice(ColorChoice.Auto).error("could not run `{program}`{suffix}", "{error}", "check that the command exists in this environment and can start")
                EXIT_USER_ERROR
            }
        }
    }

    // Enter an interactive temporary shell. Returns the child's exit code.
    fn enter(&self, theme: Theme, kind: ShellKind) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.enter_with_mode(theme, kind, false)
    }

    // Enter an interactive temporary shell with only the composed
    // environment: the explicit `--pure` foreign-environment path. Ordinary
    // Jetpack shells keep the host variables users expect.
    fn enter_clean(&self, theme: Theme, kind: ShellKind) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        &self.enter_with_mode(theme, kind, true)
    }

    fn enter_with_mode(&self, theme: Theme, kind: ShellKind, clean: Bool) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
        if !self.validate_cache(theme) -> return 126
        // The threshold rule, the signature moment of `jet env`: one quiet
        // line in and one mirrored line out, so the temporary shell reads as
        // a room walked into and back out of.
        count :: if self.refs.len() == {
            0 -> "temporary shell"
            1 -> "1 package"
            else -> "{self.refs.len()} packages"
        }
        theme.rule([String]{self.label, count, "exit to leave", "nothing is installed"})
        launch :: if env_shell_nix_projection_command(self, kind.binary(), [String]{}) == {
            .Ok(projected) -> projected ?? ShellLaunch.plain(process.cmd([String]{kind.binary()}))
            .Err(error) -> {
                env_shell_report_nix_projection_error(theme, kind.binary(), error)
                return 126
            }
        }
        scratch := launch.scratch
        spec := launch.spec
        spec = if clean -> &self.apply_clean_to(spec.env_clear()) else -> &self.apply_to(spec)
        // Keep the user-controlled label out of shell source: the generated
        // prompt reads this value through a fixed, quoted print.
        spec = spec.env(ENV_SHELL_PROMPT_LABEL_ENV, self.label)
        spec = if theme.color -> spec.env_remove("NO_COLOR") else -> spec.env("NO_COLOR", "")
        // Per-shell prompt and init wiring; scratch files end with the shell.
        if kind == {
            .Bash -> {
                rc :: env_shell_write_temp("jetpack-bashrc", env_shell_bash_rc(self.label, self.prompt_path, self.prompt_strip))
                spec = spec.args_extend([String]{"--rcfile", rc, "-i"})
                &scratch.scratch_files.push(rc)
            }
            .Zsh -> {
                // zsh reads `.zshrc` from ZDOTDIR; point it at a scratch dir.
                dir :: env_shell_write_temp_dir("jetpack-zdotdir")
                env_shell_write_best_effort(files.join(dir, ".zshrc"), env_shell_zsh_rc(self.label, self.prompt_path, self.prompt_strip))
                spec = spec.env("ZDOTDIR", dir).arg("-i")
                &scratch.scratch_dirs.push(dir)
            }
            .Fish -> {
                spec = spec.args_extend([String]{"-C", env_shell_fish_init(self.label, self.prompt_path, self.prompt_strip), "-i"})
            }
        }
        defer close(^scratch)
        spec = spec.stdin(.Inherit).stdout(.Inherit).stderr(.Inherit)
        code :: if spec.run() == {
            .Ok(receipt) -> env_shell_exit_code(receipt, 0)
            .Err(error) -> {
                theme.error("could not start `{kind.binary()}`", "{error}", "install the shell or select a supported shell with `SHELL`")
                EXIT_USER_ERROR
            }
        }
        theme.rule([String]{"left {self.label}", "your machine is unchanged"})
        code
    }
}

// A prepared child command and the scratch files it needs while it runs.
struct ShellLaunch {
    spec: ProcessSpec
    scratch: ShellScratch

    fn plain(spec: ProcessSpec) -> ShellLaunch Never! {
        ShellLaunch{spec: spec, scratch: ShellScratch.empty()}
    }
}

// Rust `status.code().unwrap_or(...)`: a signal-terminated child has no exit
// code, so the caller's fallback stands in for it.
fn env_shell_exit_code(receipt: ProcessReceipt, signaled: Int) -> Int Never! {
    if receipt.signal != None -> return signaled
    receipt.code
}

// The directory a relative command name resolves against: the child's
// working directory, made absolute against this process's directory.
fn env_shell_command_lookup_directory(cwd: String?) -[FS, Env]> String Never! {
    process_dir :: sys.current_dir() ?? "."
    directory :: cwd ?? return process_dir
    if files.is_absolute(directory) -> return directory
    files.join(process_dir, directory)
}
