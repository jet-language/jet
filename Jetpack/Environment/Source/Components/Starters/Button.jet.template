// Ownable Button component. Its output is the canonical core.ui UINode used by
// every backend; copied projects do not inherit a private view-tree runtime.
use ui :: core.ui

struct Button {
    label: String
    clicks: Int

    fn to_view(self) -> UINode { ui.button("[{self.label}] clicks={self.clicks}") }
}

fn button(label: String) -> Button { return Button{label: label.copy(), clicks: 0} }

fn press(b: Button) -> Button { return Button{label: b.label.copy(), clicks: b.clicks + 1} }
