// Ownable Button component. Its output is the canonical core.ui UINode used by
// every backend; copied projects do not inherit a private view-tree runtime.
use ui: core.ui

Button: struct {
    label: String
    clicks: Int

    to_view: fn(self) -> UINode { ui.button("[{self.label}] clicks={self.clicks}") }
}

button: fn(label: String) -> Button { return Button{label: label.copy(), clicks: 0} }

press: fn(b: Button) -> Button { return Button{label: b.label.copy(), clicks: b.clicks + 1} }
