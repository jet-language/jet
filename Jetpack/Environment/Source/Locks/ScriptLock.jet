// U11 (D-JPK-SCRIPTDEP1=A): the `<script>.lock` sidecar `jet store lock
// <script>` writes for a manifest-less script's inline `use pkg#version;`
// deps. Ported from jetpack ScriptLock.rs. The shape is TOML-like, in the
// style of `.jet/lock`:
//
//     version = 1
//     script_hash = "sha256-…"
//
//     [[dep]]
//     name = "textkit"
//     selector = "1.4"
//     resolved = "1.4.2"
//     content_hash = "sha256-…"
//
// `script_hash` is the file-content hash the lock is keyed by (editing the
// script makes the lock stale); `content_hash` is each dep's realized-source
// tree hash.

SCRIPT_LOCK_VERSION :: prep { 1 }
SCRIPT_LOCK_DEP_HEADER :: prep { "[[dep]]" }
SCRIPT_LOCK_U32_MAX :: prep { 4294967295 }

pub struct LockedInlineDep {
    pub name: String
    pub selector: String
    pub resolved: String
    pub content_hash: String

    fn empty() -> LockedInlineDep Never! {
        LockedInlineDep{name: "", selector: "", resolved: "", content_hash: ""}
    }
}

pub struct ScriptLockFile {
    pub version: Int
    pub script_hash: String
    pub deps: [LockedInlineDep]
}

// `stats.jet` -> `stats.jet.lock`, right next to the script and never inside
// a `.jet/` folder, since a bare script may not have one yet.
pub fn env_script_lock_sidecar_path(script_path: String) -> String Never! {
    "{script_path}.lock"
}

pub fn env_script_lock_write(script_path: String, lock: ScriptLockFile) IOError! -[FS]> {
    files.write(env_script_lock_sidecar_path(script_path), env_script_lock_render(lock))
}

pub fn env_script_lock_render(lock: ScriptLockFile) -> String Never! {
    out := [String]{"version = {lock.version}\n", "script_hash = \"{lock.script_hash}\"\n"}
    loop dep in lock.deps {
        &out.push("\n{SCRIPT_LOCK_DEP_HEADER}\n")
        &out.push("name = \"{dep.name}\"\n")
        &out.push("selector = \"{dep.selector}\"\n")
        &out.push("resolved = \"{dep.resolved}\"\n")
        &out.push("content_hash = \"{dep.content_hash}\"\n")
    }
    out.join("")
}

// The sidecar next to `script_path`, if present and well formed.
pub fn env_script_lock_load(script_path: String) -[FS]> ScriptLockFile? Never! {
    raw :: files.read(env_script_lock_sidecar_path(script_path)) ?? return None
    Val(env_script_lock_parse(raw) ?? return None)
}

pub fn env_script_lock_parse(raw: String) -> ScriptLockFile EnvironmentError! {
    version := SCRIPT_LOCK_VERSION
    script_hash := ""
    deps := [LockedInlineDep]{}
    // The `[[dep]]` block under construction; `in_dep` once one has opened.
    in_dep := false
    current := LockedInlineDep.empty()
    loop raw_line in raw.split("\n") {
        line :: raw_line.trim()
        if line == "" || line.starts_with("#") -> next
        if line == SCRIPT_LOCK_DEP_HEADER {
            if in_dep -> &deps.push(current)
            current = LockedInlineDep.empty()
            in_dep = true
            next
        }
        pair :: line.split_once("=") ?? return Err(EnvironmentError.InvalidData("malformed line in script lock: `{line}`"))
        key :: pair.before.trim()
        value :: pkg_binder_trim_matches(pair.after.trim(), "\"")
        if in_dep {
            if key == {
                "name" -> current.name = value
                "selector" -> current.selector = value
                "resolved" -> current.resolved = value
                "content_hash" -> current.content_hash = value
                else -> return Err(EnvironmentError.InvalidData("unknown dep field `{key}`"))
            }
        } else {
            if key == {
                "version" -> version = env_script_lock_parse_version(value) ?? return Err(EnvironmentError.InvalidData("bad version field"))
                "script_hash" -> script_hash = value
                else -> return Err(EnvironmentError.InvalidData("unknown field `{key}`"))
            }
        }
    }
    if in_dep -> &deps.push(current)
    Ok(ScriptLockFile{version, script_hash, deps})
}

// Rust `str::parse::<u32>`: an optional `+`, then decimal digits in range.
fn env_script_lock_parse_version(text: String) -> Int? Never! {
    digits :: text.removeprefix("+")
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if byte < 48 || byte > 57 -> return None
    }
    value :: Int.parse(digits) ?? return None
    if value > SCRIPT_LOCK_U32_MAX -> return None
    Val(value)
}
