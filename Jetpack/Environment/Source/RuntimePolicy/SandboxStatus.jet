// U28 (D-JPK-NODAEMON1=A): honest native child-sandbox reporting. Ported from
// RuntimePolicy.rs `SandboxLevel`, `SandboxStatus`, `detect_sandbox`,
// `enforce_sandbox_policy`, `warn_sandbox_fallback`, `sandbox_json` and
// `sandbox_receipt_is_truthful`. Executable actions use a substitute-first,
// fail-closed boundary: non-executing reuse may proceed, but an unavailable
// native backend never becomes an unsandboxed launch. The persisted policy
// (`SandboxPolicy`) lives in Foundation/SandboxPolicy.jet.

// Test override: `available` or `unavailable` replaces the native probe.
@SANDBOX_FAKE_ENV :: "JETPACK_FAKE_SANDBOX"
@SANDBOX_NOT_ENFORCED :: "not-enforced"
@SANDBOX_REQUIRED_MESSAGE :: "build sandboxing is required but unavailable"
@SANDBOX_REQUIRED_FIX :: "provide a trusted substitute or approved remote builder, or enable the native sandbox, then retry"
@SANDBOX_FALLBACK_MESSAGE :: "build sandboxing unavailable; local executable actions will be refused after substitution/remote resolution"
@SANDBOX_FALLBACK_WARNING :: "build sandboxing is unavailable; local executable actions will be refused after substitution/remote resolution"
@SANDBOX_FALLBACK_FIX :: "provide a trusted substitute or approved remote builder, or enable the native sandbox"

pub enum SandboxLevel {
    Strong
    Fallback
}

pub struct SandboxStatus {
    pub level: SandboxLevel
    pub mechanism: String
    pub policy: String
    pub reason: String

    fn fallback(mechanism: String, reason: String) -> SandboxStatus Never! {
        SandboxStatus{level: SandboxLevel.Fallback, mechanism, policy: @SANDBOX_NOT_ENFORCED, reason}
    }
}

// Which native backend this host can actually enforce right now.
pub fn env_detect_sandbox() -[FS, Env, Exec, Time.Wait]> SandboxStatus Never! {
    override :: sys.get(@SANDBOX_FAKE_ENV) ?? ""
    if override == {
        "available" -> return SandboxStatus.fallback("fake-userns-available", "test override reports sandbox support, but the build child has not entered a jail")
        "unavailable" -> return SandboxStatus.fallback("unsandboxed", "test override reports no sandbox support")
        else -> {}
    }
    if !(sys.is_linux() || sys.is_macos() || sys.is_windows()) {
        return SandboxStatus.fallback("unsandboxed", "this platform has no Jetpack-native unprivileged build sandbox yet")
    }
    native :: foundation_native_sandbox_status()
    level :: if native.available -> SandboxLevel.Strong else -> SandboxLevel.Fallback
    SandboxStatus{level, mechanism: native.mechanism, policy: native.policy, reason: native.reason}
}

// Refuse under `Require` when no strong backend exists (E1275, exit 2);
// under `AllowFallback` warn (L0205) and continue. Returns the exit code of a
// refusal, or None to proceed.
pub fn env_enforce_sandbox_policy(theme: Theme, json_output: Bool) -[FS, Env, Exec, Time.Wait]> Int? Never! {
    status :: env_detect_sandbox()
    if status.level == SandboxLevel.Strong -> return None
    if env_read_sandbox_policy() == {
        .Require -> {
            if json_output {
                eprint(env_sandbox_json("E1275", "error", status))
            } else {
                theme.error_coded("E1275", @SANDBOX_REQUIRED_MESSAGE, status.reason, "{@SANDBOX_REQUIRED_FIX}.")
            }
            Val(2)
        }
        .AllowFallback -> {
            env_warn_sandbox_fallback(theme)
            None
        }
    }
}

// The allow-mode capability loss at an executable-action boundary. A lint
// only: the Store may still satisfy the action from a verified substitute, but
// a local child must fail with E1275 when no substitute is available.
pub fn env_warn_sandbox_fallback(theme: Theme) Never! -[FS, Env, Exec, Time.Wait]> {
    status :: env_detect_sandbox()
    if status.level == SandboxLevel.Fallback && env_read_sandbox_policy() == SandboxPolicy.AllowFallback {
        theme.warning_coded("L0205", @SANDBOX_FALLBACK_WARNING, status.reason, @SANDBOX_FALLBACK_FIX)
    }
}

// The machine report for a sandbox refusal or warning.
fn env_sandbox_json(code: String, severity: String, status: SandboxStatus) -> String Never! {
    refusal :: code == "E1275"
    fields := [String: DataTree]{}
    fields["schema_version"] = DataTree.Text("1")
    fields["code"] = DataTree.Text(code)
    fields["severity"] = DataTree.Text(severity)
    fields["message"] = DataTree.Text(if refusal -> @SANDBOX_REQUIRED_MESSAGE else -> @SANDBOX_FALLBACK_MESSAGE)
    fields["why"] = DataTree.Text(status.reason)
    fields["policy"] = DataTree.Text(status.policy)
    fields["fix"] = DataTree.Text(if refusal -> @SANDBOX_REQUIRED_FIX else -> @SANDBOX_FALLBACK_FIX)
    fields["mechanism"] = DataTree.Text(status.mechanism)
    json.to_string_pretty(DataTree.Object(fields))
}

// Validate a persisted child-boundary receipt before presenting it as an
// isolation claim. The producer checksum proves record integrity; this proves
// the recorded class and policy describe a native backend this release can
// actually enforce.
pub fn env_sandbox_receipt_is_truthful(class: String, policy: String) -> Bool Never! {
    if class == "non-executing" {
        return policy == "no child launched" || policy.starts_with("no child launched (") || policy.starts_with("trusted substitution (")
    }
    fields := [String: String]{}
    loop field in policy.split(";") {
        pair :: field.split_once("=") ?? return false
        if pair.before == "" || pair.after == "" || fields.has_key(pair.before) -> return false
        fields[pair.before] = pair.after
    }
    if class == {
        "linux-bwrap" -> fields.len() == 7
            && env_sandbox_field_is(fields, "filesystem", [String]{"source-readonly,output-private-copy", "private-workspace-readwrite"})
            && env_sandbox_field_is(fields, "process", [String]{"private-pid,parent-death"})
            && env_sandbox_field_is(fields, "network", [String]{"isolated", "declared-shared"})
            && env_sandbox_field_is(fields, "environment", [String]{"clear"})
            && env_sandbox_field_is(fields, "devices", [String]{"private-dev"})
            && env_sandbox_field_is(fields, "privilege", [String]{"no-new-privs+cap-drop-all"})
            && env_sandbox_field_is(fields, "resources", [String]{"tmpfs-64MiB"})
        "macos-seatbelt" -> fields.len() == 6
            && env_sandbox_field_is(fields, "filesystem", [String]{"source-readonly,output-readwrite", "private-workspace-readwrite"})
            && env_sandbox_field_is(fields, "process", [String]{"declared-tool-and-fork"})
            && env_sandbox_field_is(fields, "network", [String]{"denied", "declared-shared"})
            && env_sandbox_field_is(fields, "environment", [String]{"clear"})
            && env_sandbox_field_is(fields, "devices", [String]{"denied"})
            && env_sandbox_field_is(fields, "resources", [String]{"none-declared"})
        "windows-appcontainer" -> fields.len() == 6
            && env_sandbox_field_is(fields, "filesystem", [String]{"private-workspace-readwrite", "source-readonly,output-readwrite", "source-readonly", "filesystem-none", "filesystem-write-only"})
            && env_sandbox_field_is(fields, "process", [String]{"appcontainer+job-kill-on-close+active-process=256"})
            && env_sandbox_field_is(fields, "network", [String]{"denied", "declared-internet-client"})
            && env_sandbox_field_is(fields, "environment", [String]{"clear+declared"})
            && env_sandbox_field_is(fields, "devices", [String]{"appcontainer-default-deny"})
            && env_sandbox_field_is(fields, "resources", [String]{"memory-2GiB+active-process-256"})
        else -> false
    }
}

fn env_sandbox_field_is(fields: [String: String], name: String, allowed: [String]) -> Bool Never! {
    value :: fields.get(name) ?? return false
    allowed.contains(value)
}
