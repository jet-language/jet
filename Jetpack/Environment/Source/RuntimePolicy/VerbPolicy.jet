// U28 Jetpack is a user-owned, one-shot process: no
// resident daemon and no root requirement for any verb. Ported from
// RuntimePolicy.rs `VerbPolicy`/`verb_policy`/`all_verb_policies`. The only
// privileged exception in the reference is JetOS activation, which is outside
// this port, so every verb here carries the same unprivileged policy.

struct VerbPolicy {
    // The known verb spelling, or "unknown".
    verb: String
    resident_daemon: Bool
    requires_root: Bool
}

// The policy of `verb`; an unlisted verb reports as "unknown".
fn env_verb_policy(verb: String) -> VerbPolicy Never! {
    known :: if JETPACK_VERBS.contains(verb) -> verb else -> "unknown"
    VerbPolicy{verb: known, resident_daemon: false, requires_root: false}
}

// One policy per Jetpack verb, in dispatch order.
fn env_all_verb_policies() -> [VerbPolicy] Never! {
    policies := [VerbPolicy]{}
    verbs :: JETPACK_VERBS
    loop verb in verbs -> &policies.push(env_verb_policy(verb))
    policies
}
