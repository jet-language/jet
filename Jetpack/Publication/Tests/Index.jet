// JP-PUB-INDEX: Index.rs and NamePolicy.rs embedded tests, plus Tier.rs's
// carrier/review tests. Native publication retains real Registry dependencies:
// JP-PUB-REG-VERIFY, JP-PUB-REG-REFERRERS; authority operations owe Core #3593.
// Rust InvalidData-kind acceptance is retained pending Core owner ballot #4409.
// The pure name/wire proof is NOT proof of the native publication acceptance.
fn publication_index_test_entry(name: String, version: String, yanked: Bool) -> PublicationIndexEntry Never! {
    PublicationIndexEntry{name: name, version: version, content_hash: "sha256-tree", fingerprint: "sha256-fp", yanked: yanked, tier: .Core, gate_status: publication_core_reviewed(), public_key: "", signature: ""}
}
fn publication_index_test_root(label: String) -[FS, Env]> String Never! {
    root :: files.join(sys.get("HOME") ?? panic("HOME"), ".cache/jet-dev/scratch/publication-index-{label}-{sys.pid()}")
    files.remove_all(root).drop("stale fixture may be absent")
    files.create_dir_all(root) ?? panic("create index fixture")
    root
}

#Test("publication index pin_is_first_nonempty_public_key") {
    a := publication_index_test_entry("textkit", "1.0.0", false)
    a.public_key = " aa "
    b :: publication_index_test_entry("textkit", "1.1.0", false)
    c := publication_index_test_entry("textkit", "1.2.0", false)
    c.public_key = "bb"
    assert_eq(publication_pinned_public_key([PublicationIndexEntry]{a, b, c}), Val("aa"))
    assert_eq(publication_pinned_public_key([PublicationIndexEntry]{publication_index_test_entry("x", "1.0.0", false)}), None)
    assert(publication_is_takeover([PublicationIndexEntry]{a, b}, c))
    c.public_key = "aa"
    assert(!publication_is_takeover([PublicationIndexEntry]{a}, c))
    c.public_key = "   "
    assert(!publication_is_takeover([PublicationIndexEntry]{a}, c))
    assert(!publication_is_takeover([PublicationIndexEntry]{}, a))
}
#Test("publication index jsonl_roundtrips") {
    entry :: publication_index_test_entry("textkit", "1.2.0", false)
    line :: publication_index_to_jsonl(entry)
    assert_eq(line, "{{\"name\":\"textkit\",\"version\":\"1.2.0\",\"content_hash\":\"sha256-tree\",\"fingerprint\":\"sha256-fp\",\"yanked\":false,\"tier\":\"core\",\"gate_status\":\"signature=not-required;audit=not-required;name=not-required;liveness=not-required;review=passed\",\"public_key\":\"\",\"signature\":\"\"}}")
    assert_eq(publication_index_parse_line(line), Val(entry))
}

#Test("publication index fixed nine field wire order") {
    entry :: publication_index_test_entry("textkit", "1.2.0", false)
    assert_eq(publication_index_to_jsonl(entry), "{{\"name\":\"textkit\",\"version\":\"1.2.0\",\"content_hash\":\"sha256-tree\",\"fingerprint\":\"sha256-fp\",\"yanked\":false,\"tier\":\"core\",\"gate_status\":\"signature=not-required;audit=not-required;name=not-required;liveness=not-required;review=passed\",\"public_key\":\"\",\"signature\":\"\"}}")
}

#Test("publication index protocol quote is byte exact, not CanonicalJSON") {
    controls :: String.from_bytes([U8]{13, 9, 8, 12, 127, 194, 128}) ?? panic("control fixture")
    entry := publication_index_test_entry("é\"\\\n{controls}", "1.2.0", true)
    entry.public_key = "aa"
    entry.signature = "x=y"
    line :: publication_index_to_jsonl(entry)
    assert(line.starts_with("{{\"name\":\"é\\\"\\\\\\n\\r\\t\\u0008\\u000c\\u007f\\u0080\""))
    assert(!line.ends_with("\n"))
}

#Test("publication index escaped unicode roundtrip") {
    controls :: String.from_bytes([U8]{13, 9, 8, 12, 127, 194, 128}) ?? panic("control fixture")
    entry :: publication_index_test_entry("é\"\\\n{controls}", "1.2.0", true)
    assert_eq(publication_index_parse_line(publication_index_to_jsonl(entry)), Val(entry))
}

#Test("publication index defaults only optional fields") {
    line :: "{{\"name\":\"x\",\"version\":\"1\",\"tier\":\" CORE \",\"gate_status\":\"review=passed;liveness=not-required;name=not-required;audit=not-required;signature=not-required\"}}"
    entry :: publication_index_parse_line(line) ?? panic("optional omissions allowed")
    assert_eq(entry.content_hash, "")
    assert_eq(entry.fingerprint, "")
    assert_eq(entry.public_key, "")
    assert_eq(entry.signature, "")
    assert(!entry.yanked)
    assert_eq(entry.tier, PublicationRegistryTier.Core)
    assert_eq(entry.version, "1") // Index does NOT validate SemVer; resolver does.
    loop key in ([String]{"name", "version", "tier", "gate_status"}) {
        valid :: publication_index_to_jsonl(publication_index_test_entry("x", "1.0.0", false))
        assert_eq(publication_index_parse_line(valid.replace("\"{key}\":", "\"unknown\":")), None)
    }
}
#Test("publication index hostile_jsonl_is_rejected") {
    loop line in ([String]{
        "{{\"outer\":{{\"name\":\"fake\"}},\"version\":\"1.0.0\"}}",
        "{{\"name\":\"x\",\"name\":\"y\",\"version\":\"1.0.0\"}}",
        "{{\"name\":\"x\",\"version\":1,\"yanked\":false}}",
        "{{\"name\":\"x\",\"version\":\"1.0.0\",\"yanked\":\"false\"}}",
        "{{\"name\":\"x\",\"version\":\"1.0.0\",\"signature\":\"\\q\"}}",
        "{{\"name\":\"x\",\"version\":\"1.0.0\",\"future_field\":true}}"
    }) -> assert_eq(publication_index_parse_line(line), None)
    valid :: publication_index_to_jsonl(publication_index_test_entry("x", "1.0.0", false))
    loop key in ([String]{"content_hash", "fingerprint", "public_key", "signature"}) {
        text :: if {
            key == "content_hash" -> "sha256-tree"
            key == "fingerprint" -> "sha256-fp"
            else -> ""
        }
        assert_eq(publication_index_parse_line(valid.replace("\"{key}\":{foundation_json_quote(text)}", "\"{key}\":null")), None)
        assert_eq(publication_index_parse_line(valid.replace("\"{key}\":", "\"{key}\":true,\"{key}\":")), None)
    }
    assert_eq(publication_index_parse_line(valid.replace("\"version\":\"1.0.0\"", "\"version\":1")), None)
    assert_eq(publication_index_parse_line(valid.replace("\"yanked\":false", "\"yanked\":\"false\"")), None)
    assert_eq(publication_index_parse_line(valid.replace("\"signature\":\"\"", "\"signature\":\"\\q\"")), None)
    assert_eq(publication_index_parse_line(valid.replace("\"name\":\"x\"", "\"name\":\"x\",\"name\":\"y\"")), None)
    assert_eq(publication_index_parse_line(valid.replace("\"tier\":\"core\"", "\"tier\":\"unknown\"")), None)
    assert_eq(publication_index_parse_line("{valid} trailing"), None)
    assert_eq(publication_index_parse_line(valid.replace("\"name\":\"x\"", "\"name\":\"\"")), None)
    assert_eq(publication_index_parse_line(valid.replace("\"yanked\":false", "\"yanked\":null")), None)
}

#Test("publication index one MiB protocol limit is exact") {
    entry := publication_index_test_entry("x", "1.0.0", false)
    overhead :: publication_index_to_jsonl(entry).bytes().len() - 1
    name_bytes := [U8]{}
    loop index in 0..<(1048576 - overhead) -> &name_bytes.push(U8{97})
    entry.name = String.from_bytes(name_bytes) ?? panic("ASCII fixture")
    at_limit :: publication_index_to_jsonl(entry)
    assert_eq(at_limit.bytes().len(), 1048576)
    assert(publication_index_parse_line(at_limit) != None)
    entry.name = "{entry.name}a"
    assert_eq(publication_index_parse_line(publication_index_to_jsonl(entry)), None)
}


#Test("publication name skeleton_collapses_common_homoglyphs") {
    assert_eq(publication_confusable_skeleton("раypal"), "paypal")
    assert_eq(publication_confusable_skeleton("librewоlf"), "librewolf")
    assert_eq(publication_confusable_skeleton("ÀBCÉÖ́ı1"), "abceoii")
    assert_eq(publication_confusable_skeleton("ΟΣ"), "oσ") // no contextual final-sigma casing
}
#Test("publication name edit_distance_is_levenshtein") {
    assert_eq(publication_edit_distance("kitten", "sitting"), 3)
    assert_eq(publication_edit_distance("cargo", "cagro"), 2)
    assert_eq(publication_edit_distance("", "é"), 1)
    assert_eq(publication_edit_distance("αβ", "α"), 1)
    assert_eq(publication_edit_distance_at_most("kitten", "sitting", 2), None)
    assert_eq(publication_edit_distance_at_most("kitten", "sitting", 3), Val(3))
    assert_eq(publication_edit_distance_at_most("", "", 0), Val(0))
}
#Test("publication name exact_confusable_match_blocks") {
    decision :: publication_assess_name("librewоlf", [String]{"librewolf"})
    assert_eq(decision, PublicationNamePolicyDecision.Block(PublicationNamePolicyFinding.Confusable{existing: "librewolf"}))
}
#Test("publication name distance_two_warns_and_distance_one_blocks") {
    assert_eq(publication_assess_name("cagro", [String]{"cargo"}), PublicationNamePolicyDecision.Warn(PublicationNamePolicyFinding.EditDistance{existing: "cargo", distance: 2}))
    assert_eq(publication_assess_name("cargx", [String]{"cargo"}), PublicationNamePolicyDecision.Block(PublicationNamePolicyFinding.EditDistance{existing: "cargo", distance: 1}))
}
#Test("publication name reserved_suffix_blocks_without_existing_name") {
    loop suffix in PUBLICATION_RESERVED_SUFFIXES -> assert_eq(publication_assess_name("trusted{suffix}", [String]{}), PublicationNamePolicyDecision.Block(PublicationNamePolicyFinding.ReservedSuffix(suffix)))
    assert(publication_name_is_blocked(publication_assess_name("TRUSTED-FİXED", [String]{})))
}
#Test("publication name unrelated_name_is_allowed") {
    assert_eq(publication_assess_name("textkit", [String]{"cargo", "jetpack"}), PublicationNamePolicyDecision.Allow)
    assert_eq(publication_assess_name("cargo", [String]{"cargo"}), PublicationNamePolicyDecision.Allow)
}
#Test("publication name thresholds clamp and ties sort") {
    decision :: publication_assess_name_with_thresholds("cab", [String]{"cad", "caa"}, PublicationNamePolicyThresholds{warn_distance: 1, block_distance: 4})
    assert_eq(decision, PublicationNamePolicyDecision.Block(PublicationNamePolicyFinding.EditDistance{existing: "caa", distance: 1}))
    assert_eq(publication_assess_name_with_thresholds("cab", [String]{"caa"}, PublicationNamePolicyThresholds{warn_distance: 0, block_distance: 4}), PublicationNamePolicyDecision.Allow)
    assert_eq(publication_assess_name("librewоlf", [String]{"librewоlx", "librewolf"}), PublicationNamePolicyDecision.Block(PublicationNamePolicyFinding.Confusable{existing: "librewolf"}))
}

#Test("publication name usize max threshold retains mathematical distance") {
    // Rust NamePolicy.rs:216 overflows row+limit+1 for usize::MAX. Preserve
    // the bounded Levenshtein contract, not that debug panic/release wrap.
    maximum :: 18446744073709551615
    assert_eq(publication_edit_distance_at_most("kitten", "sitting", maximum), Val(3))
    assert_eq(publication_edit_distance_at_most("", "é", maximum), Val(1))
    assert_eq(publication_assess_name_with_thresholds("cagro", [String]{"cargo"}, PublicationNamePolicyThresholds{warn_distance: maximum, block_distance: 0}), PublicationNamePolicyDecision.Warn(PublicationNamePolicyFinding.EditDistance{existing: "cargo", distance: 2}))
}

#Test("publication name warning_diagnostic_matches_ui_snapshot") {
    diagnostic :: publication_name_diagnostic(publication_assess_name("cagro", [String]{"cargo"}), "cagro") ?? panic("warning diagnostic")
    expected :: "Warning [L2608] (registry_name_lookalike): registry package name `cagro` is suspicious: it is edit distance 2 from existing package `cargo`\n Why: A name in the warning band is close enough to an existing registry name to confuse package selection, but this publish remains non-blocking while the owner policy allows it.\n Fix: choose a distinct package name instead of `cargo` before publishing; the closer block band and reserved suffix rules reject stronger matches.\nMore: jet-lang.dev/e/L2608\n"
    assert_eq(diagnostic_render(diagnostic, "", "", false), expected)
    assert_eq(publication_name_diagnostic(PublicationNamePolicyDecision.Allow, "cargo"), None)
}
#Test("publication tier gate_status_roundtrips_and_names_closed_gates") {
    status :: publication_community_with_name(.Blocked, .Blocked, .Blocked)
    assert_eq(publication_parse_gate_status(publication_gate_summary(status)), Val(status))
    assert_eq(publication_blocked_reasons(status), [String]{"#935 live signature chain", "#431 advisory audit", "#1912 name policy", "#1913 maintainer liveness"})
    assert(!publication_community_open(status))
    assert_eq(publication_parse_gate_status("signature=passed;signature=passed"), None)
    assert_eq(publication_parse_gate_status(publication_gate_summary(status).replace("review=not-required", "review=unknown")), None)
    assert_eq(publication_parse_tier(" COMMUNITY "), Val(PublicationRegistryTier.Community))
    assert_eq(publication_parse_tier("untrusted"), None)
    assert_eq(publication_parse_gate_status("{publication_gate_summary(status)};review=passed"), None)
    assert_eq(publication_parse_gate_status("{publication_gate_summary(status)};unknown=passed"), None)
    assert_eq(publication_parse_gate_status(publication_gate_summary(status).replace("review=not-required", "review")), None)
}

#Test("publication index write_appends_one_line_per_version") {
    repo :: publication_index_test_root("append")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) ?? panic("first write")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.1.0", false)) ?? panic("append")
    all :: publication_read_entries(repo, "textkit") ?? panic("read entries")
    assert_eq(all.len(), 2)
    assert_eq(all[0].version, "1.0.0")
    assert_eq(all[1].version, "1.1.0")
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index find_entry_matches_exact_version") {
    repo :: publication_index_test_root("find")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) ?? panic("write")
    assert((publication_find_entry(repo, "textkit", "1.0.0") ?? panic("find")) != None)
    assert_eq(publication_find_entry(repo, "textkit", "9.9.9") ?? panic("find absent"), None)
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index mark_yanked_flips_in_place_never_deletes") {
    repo :: publication_index_test_root("yank")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) ?? panic("first write")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.1.0", false)) ?? panic("second write")
    assert(publication_mark_yanked(repo, "textkit", "1.0.0") ?? panic("yank"))
    all :: publication_read_entries(repo, "textkit") ?? panic("read")
    assert_eq(all.len(), 2)
    assert(all[0].yanked)
    assert(!all[1].yanked)
    live :: publication_non_yanked_entries(repo, "textkit") ?? panic("live")
    assert_eq(live.len(), 1)
    assert_eq(live[0].version, "1.1.0")
    assert(!(publication_mark_yanked(repo, "textkit", "1.0.0") ?? panic("repeat yank")))
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index mark_yanked_missing_version_is_false") {
    repo :: publication_index_test_root("missing")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) ?? panic("write")
    assert(!(publication_mark_yanked(repo, "textkit", "2.0.0") ?? panic("missing version")))
    assert(!(publication_mark_yanked(repo, "absent", "1.0.0") ?? panic("missing package")))
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index hostile_jsonl_never_treated_as_absent") {
    repo :: publication_index_test_root("malformed")
    path :: publication_index_entry_path(repo, "textkit") ?? panic("path")
    files.create_dir_all(files.dirname(path)) ?? panic("directory")
    files.write(path, "{malformed}\n") ?? panic("fixture")
    if publication_read_entries(repo, "textkit") == {
        .Err(error) -> assert(error == .InvalidData(_))
        .Ok(_) -> panic("malformed read accepted")
    }
    if publication_mark_yanked(repo, "textkit", "1.0.0") == {
        .Err(error) -> assert(error == .InvalidData(_))
        .Ok(_) -> panic("malformed yank accepted")
    }
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index names and immutable releases") {
    repo :: publication_index_test_root("immutable")
    assert_eq(publication_package_names(repo) ?? panic("missing names"), [String]{})
    entry :: publication_index_test_entry("textkit", "1.0.0", false)
    publication_write_index_entry(repo, entry) ?? panic("write")
    publication_write_index_entry(repo, entry) ?? panic("identical retry")
    assert_eq((publication_read_entries(repo, "textkit") ?? panic("read")).len(), 1)
    changed := ~entry
    changed.fingerprint = "different"
    if publication_write_index_entry(repo, changed) == {
        .Err(error) -> assert(error == .AlreadyExists(_))
        .Ok(_) -> panic("immutable version rewritten")
    }
    // Rust with_index_lock releases the lock on every action result: the
    // refused rewrite must not leave `.textkit.lock` to time out the next writer.
    assert(!files.lexists(files.join(files.join(repo, "index"), ".textkit.lock")))
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.1.0", false)) ?? panic("write after refused rewrite")
    assert_eq((publication_read_entries(repo, "textkit") ?? panic("read after refusal")).len(), 2)
    assert_eq(publication_package_names(repo) ?? panic("names"), [String]{"textkit"})
    files.remove_all(repo) ?? panic("cleanup")
}
// Rust with_index_lock (Index.rs:346-404): a lock older than 300s is removed
// and the create is retried; the reclaimed lock is released after the action.
#Test("publication index lock reclaims a stale lock and releases it") {
    repo :: publication_index_test_root("stale-lock")
    lock :: files.join(files.join(repo, "index"), ".textkit.lock")
    files.create_dir_all(files.dirname(lock)) ?? panic("index root")
    files.write(lock, "") ?? panic("plant stale lock")
    sys.utime(lock, 1, 1) ?? panic("age stale lock")
    publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) ?? panic("stale lock reclaimed")
    assert(!files.lexists(lock))
    assert_eq((publication_read_entries(repo, "textkit") ?? panic("read")).len(), 1)
    files.remove_all(repo) ?? panic("cleanup")
}
// A fresh lock is never stolen: 100 attempts with 50ms waits end TimedOut,
// the holder's lock is untouched and nothing is written.
#Test("publication index lock times out on a live holder without stealing it") {
    repo :: publication_index_test_root("busy-lock")
    lock :: files.join(files.join(repo, "index"), ".textkit.lock")
    files.create_dir_all(files.dirname(lock)) ?? panic("index root")
    files.write(lock, "held") ?? panic("plant live lock")
    if publication_write_index_entry(repo, publication_index_test_entry("textkit", "1.0.0", false)) == {
        .Err(error) -> {
            assert(error == .TimedOut(_))
            assert("{error}".contains("registry index update for `textkit` is busy"))
        }
        .Ok(_) -> panic("live lock bypassed")
    }
    assert_eq(files.read(lock) ?? panic("held lock untouched"), "held")
    assert_eq(publication_package_names(repo) ?? panic("names"), [String]{})
    files.remove_all(repo) ?? panic("cleanup")
}

#Test("publication index package_names refuses symlinks and skips absent records") {
    repo :: publication_index_test_root("names-links")
    root :: files.join(repo, "index")
    outside :: files.join(repo, "outside")
    files.create_dir_all(root) ?? panic("index")
    files.create_dir_all(outside) ?? panic("outside")
    link :: files.join(root, "textkit")
    files.symlink(outside, link) ?? panic("directory symlink")
    if publication_package_names(repo) == {
        .Err(error) -> assert(error == .InvalidData(_))
        .Ok(_) -> panic("package directory symlink accepted")
    }
    files.remove(link) ?? panic("remove directory link")
    files.create_dir_all(link) ?? panic("real package directory")
    files.write(files.join(root, "unrelated-file"), "ignored") ?? panic("non-directory")
    assert_eq(publication_package_names(repo) ?? panic("missing record"), [String]{})
    target :: files.join(outside, "textkit.jsonl")
    files.write(target, publication_index_to_jsonl(publication_index_test_entry("textkit", "1.0.0", false))) ?? panic("outside record")
    files.symlink(target, files.join(link, "textkit.jsonl")) ?? panic("record symlink")
    if publication_package_names(repo) == {
        .Err(error) -> assert(error == .InvalidData(_))
        .Ok(_) -> panic("record symlink accepted")
    }
    files.remove_all(repo) ?? panic("cleanup")
}

#Test("publication index safe path components") {
    del :: String.from_bytes([U8]{127}) ?? panic("DEL fixture")
    loop value in ([String]{"", ".", "..", "a/b", "a\\b", "x\n", "x{del}"}) {
        if publication_validate_index_component(value, "package name") == {
            .Err(error) -> assert(error == .InvalidInput(_))
            .Ok(_) -> panic("unsafe path accepted")
        }
    }
    c1 :: String.from_bytes([U8]{194, 128}) ?? panic("C1 fixture")
    publication_validate_index_component("é{c1}", "package name") ?? panic("only ASCII controls refused by Rust")
}
#Test("publication tier core_review_receipt_must_name_published_package") {
    repo :: publication_index_test_root("review")
    path :: files.join(repo, "reviews/textkit/1.0.0.review")
    files.create_dir_all(files.dirname(path)) ?? panic("review directory")
    assert(publication_require_core_review(repo, "textkit", "1.0.0") == .Err(_))
    text :: "jet-registry-core-review-v1\npackage=textkit\nversion=1.0.0\nreviewer=owner\ndecision=approved\n"
    files.write(path, text) ?? panic("review")
    publication_require_core_review(repo, "textkit", "1.0.0") ?? panic("approved review")
    publication_require_takeover_review(repo, "textkit", "1.0.0") ?? panic("approved takeover review")
    assert(publication_require_core_review(repo, "textkit", "2.0.0") == .Err(_))
    loop bad in ([String]{text.replace("package=textkit", "package=other"), "{text}decision=approved\n", text.replace("reviewer=owner", "reviewer= "), text.replace("decision=approved", "decision=refused")}) {
        files.write(path, bad) ?? panic("bad review")
        assert(publication_require_takeover_review(repo, "textkit", "1.0.0") == .Err(_))
    }
    files.remove_all(repo) ?? panic("cleanup")
}
#Test("publication index takeover requires receipt and re-signing") {
    repo :: publication_index_test_root("takeover")
    original := publication_index_test_entry("textkit", "1.0.0", false)
    original.public_key = "aa"
    candidate := publication_index_test_entry("textkit", "1.1.0", false)
    candidate.public_key = "bb"
    entries :: [PublicationIndexEntry]{original}
    assert(publication_validate_takeover(repo, entries, candidate) == .Err(_))
    path :: files.join(repo, "reviews/textkit/1.1.0.review")
    files.create_dir_all(files.dirname(path)) ?? panic("review directory")
    files.write(path, "jet-registry-core-review-v1\npackage=textkit\nversion=1.1.0\nreviewer=owner\ndecision=approved\n") ?? panic("review")
    if publication_validate_takeover(repo, entries, candidate) == {
        .Err(error) -> assert_eq(error.diagnostic.code, "E1247") // review alone cannot authorize unsigned takeover
        .Ok(_) -> panic("unsigned takeover accepted")
    }
    files.remove_all(repo) ?? panic("cleanup")
}

// Source/Publish/mod.rs:662-753: retain evidence ordering and digest refusal.
#Test("publication registry_publish_writes_and_rejects_tampered_oci_referrers") {
    root :: publication_index_test_root("referrers")
    repo :: files.join(root, "registry")
    source :: files.join(root, "source")
    files.create_dir_all(repo) ?? panic("repo")
    files.create_dir_all(files.join(source, ".jet")) ?? panic("source")
    files.write(files.join(source, "package.jet"), "package bytes\n") ?? panic("package")
    lock := LockFile.empty()
    &lock.packages.push(LockedPackage{name: "helpers", version: "1.0.0", fingerprint: "sha256-abcd1234", source: LockSource.Path("/tmp/placeholder")})
    files.write(files.join(source, ".jet/lock"), pkg_lock_write(lock)) ?? panic("lock")
    content_hash :: foundation_tree_hash(source)
    _ :: publication_publish_artifact(repo, source, "ref-kit", "1.0.0", content_hash) ?? panic("artifact")
    entry := publication_index_test_entry("ref-kit", "1.0.0", false)
    entry.content_hash = content_hash
    entry.fingerprint = "sha256-fingerprint"
    publication_write_index_entry(repo, entry) ?? panic("index")
    publication_verify_oci_referrers(repo, entry) ?? panic("verify")
    blobs :: files.list_dir(files.join(repo, "referrers/{content_hash}/blobs")) ?? panic("blobs")
    bytes := files.read_bytes(blobs[0].path) ?? panic("blob")
    &bytes.push(U8{10})
    files.write_bytes(blobs[0].path, bytes) ?? panic("tamper")
    if publication_verify_oci_referrers(repo, entry) == {
        .Err(error) -> assert("{error}".contains("digest") || "{error}".contains("size"))
        .Ok(_) -> panic("tampered referrer accepted")
    }
    files.remove_all(root) ?? panic("cleanup")
}
#Test("publication registry_publish_rejects_missing_sbom_before_index_exposure") {
    root :: publication_index_test_root("missing-sbom")
    repo :: files.join(root, "registry")
    source :: files.join(root, "source")
    files.create_dir_all(repo) ?? panic("repo")
    files.create_dir_all(source) ?? panic("source")
    files.write(files.join(source, "package.jet"), "package bytes\n") ?? panic("package")
    content_hash :: foundation_tree_hash(source)
    _ :: publication_publish_artifact(repo, source, "ref-kit", "1.0.0", content_hash) ?? panic("artifact")
    files.remove(files.join(repo, "referrers/{content_hash}/.sbom.pending")) ?? panic("remove staged SBOM")
    entry := publication_index_test_entry("ref-kit", "1.0.0", false)
    entry.content_hash = content_hash
    entry.fingerprint = "sha256-fingerprint"
    if publication_write_index_entry(repo, entry) == {
        .Err(error) -> assert("{error}".contains("SBOM evidence was not staged"))
        .Ok(_) -> panic("index exposed without SBOM")
    }
    assert_eq(publication_find_entry(repo, "ref-kit", "1.0.0") ?? panic("find"), None)
    files.remove_all(root) ?? panic("cleanup")
}
