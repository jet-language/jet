// SETUP-PORT of tests/pkg.rs:6436-6475,8486-8521,8556-8637,8647-8718.
// Only declared public Publication/PackageModel functions. All CLI assertions
// stay in the .case; this helper creates real signed inputs, never fake bytes.
// Each claim names its paths through the env when a .case drives it
// (`S6_HAND_*`) and otherwise works in its own scratch root, then proves what
// it wrote, so it is a whole claim on every tier.
use {
    jet_pkg_model.[LockFile, LockSource, LockedPackage, pkg_lock_write]
    jetpack_publication.[
        PublicationAdvisory, PublicationAdvisoryException, PublicationAdvisoryFeed,
        PublicationAdvisoryRelease, PublicationSourceClass, publication_advisory_feed_digest,
        publication_advisory_feed_text, publication_advisory_key_id, publication_index_parse_line,
        publication_keygen, publication_parse_advisory_feed, publication_parse_semver,
        publication_sign_advisory_feed,
    ]
    s6_hand_advisory_files: core.files
    s6_hand_advisory_sys: core.sys
}

s6_hand_advisory_save: fn(root: String, name: String, feed: PublicationAdvisoryFeed) {
    s6_hand_advisory_files.write("{root}/{name}.db", publication_advisory_feed_text(feed)) ?? panic("write signed feed {name}")
}

// A claim's own scratch root when no .case names one.
s6_hand_scratch: fn(name: String) -> String {
    root: s6_hand_advisory_files.join(s6_hand_advisory_sys.temp_dir(), "jet-s6-hand-{name}-{s6_hand_advisory_sys.pid()}")
    s6_hand_advisory_files.remove_all(root).drop("stale fixture may be absent")
    s6_hand_advisory_files.create_dir_all(root) ?? panic("scratch root {root}")
    root
}

s6_hand_advisory_setup: fn(root: String) {
    generated: publication_keygen("advisory", false) ?? panic("real advisory keygen")
    public: generated.public_key_hex
    feed := PublicationAdvisoryFeed{
        sequence: 1, issued_at: 100, expires_at: 10000, maturity_seconds: 86400,
        key_id: publication_advisory_key_id(public) ?? panic("advisory key id"),
        public_key: public, signature: "", releases: [PublicationAdvisoryRelease]{},
        advisories: [PublicationAdvisory]{}, exceptions: [PublicationAdvisoryException]{}
    }
    feed.signature = publication_sign_advisory_feed(feed, generated.seed_path) ?? panic("sign clean feed")
    s6_hand_advisory_save(root, "clean", feed)
    s6_hand_advisory_files.write("{root}/public-key.txt", public) ?? panic("public key")
    s6_hand_advisory_files.write("{root}/accepted-digest.txt", publication_advisory_feed_digest(feed)) ?? panic("accepted digest")
    weakened := feed.copy()
    weakened.maturity_seconds = 1
    weakened.signature = publication_sign_advisory_feed(weakened, generated.seed_path) ?? panic("sign weakened feed")
    s6_hand_advisory_save(root, "weakened", weakened)
    fork := feed.copy()
    fork.maturity_seconds = 86401
    fork.signature = publication_sign_advisory_feed(fork, generated.seed_path) ?? panic("sign fork feed")
    s6_hand_advisory_save(root, "fork", fork)
    stale := feed.copy()
    stale.expires_at = 150
    stale.signature = publication_sign_advisory_feed(stale, generated.seed_path) ?? panic("sign stale feed")
    s6_hand_advisory_save(root, "stale", stale)
    immature := feed.copy()
    immature.releases.push(PublicationAdvisoryRelease{package: "mylib", version: publication_parse_semver("1.0.0") ?? panic("version"), first_seen: 100, source_class: PublicationSourceClass.ThirdParty})
    immature.signature = publication_sign_advisory_feed(immature, generated.seed_path) ?? panic("sign immature feed")
    s6_hand_advisory_save(root, "immature", immature)
    excepted := immature.copy()
    excepted.exceptions.push(PublicationAdvisoryException{package: "mylib", version: publication_parse_semver("1.0.0") ?? panic("version"), reason: "urgent security fix", reviewer: "security-team", expires_at: 1000})
    excepted.signature = publication_sign_advisory_feed(excepted, generated.seed_path) ?? panic("sign exception feed")
    s6_hand_advisory_save(root, "excepted", excepted)
    tampered := feed.copy()
    tampered.maturity_seconds = 86401
    // Deliberately retain the clean signature, exactly the original tamper.
    s6_hand_advisory_save(root, "tampered", tampered)
    lock := LockFile.empty()
    lock.version = 1
    lock.packages.push(LockedPackage{name: "mylib", version: "1.0.0", fingerprint: "sha256-locked", source: LockSource.Path("/tmp/placeholder")})
    lock.root_dependencies.push("mylib")
    s6_hand_advisory_files.write("{root}/lock.txt", pkg_lock_write(lock)) ?? panic("write lock fixture")
}

#Test("S6 hand signed advisory setup") {
    driven: s6_hand_advisory_sys.get("S6_HAND_ROOT")
    if driven == .Val(case_root) {
        s6_hand_advisory_setup(case_root)
        return
    }
    root: s6_hand_scratch("advisory")
    previous_keys: s6_hand_advisory_sys.get("JET_KEYS_DIR")
    s6_hand_advisory_sys.set("JET_KEYS_DIR", "{root}/keys")
    s6_hand_advisory_setup(root)
    accepted: s6_hand_advisory_files.read("{root}/accepted-digest.txt") ?? panic("accepted digest")
    clean: if publication_parse_advisory_feed(s6_hand_advisory_files.read("{root}/clean.db") ?? panic("clean feed")) == {
        .Ok(feed) -> feed
        .Err(error) -> panic("clean feed parses")
    }
    assert_eq(publication_advisory_feed_digest(clean), accepted)
    tampered: if publication_parse_advisory_feed(s6_hand_advisory_files.read("{root}/tampered.db") ?? panic("tampered feed")) == {
        .Ok(feed) -> feed
        .Err(error) -> panic("tampered feed parses")
    }
    assert_eq(tampered.signature, clean.signature)
    assert(publication_advisory_feed_digest(tampered) != accepted)
    if previous_keys == {
        .Val(value) -> s6_hand_advisory_sys.set("JET_KEYS_DIR", value)
        .None -> { _: s6_hand_advisory_sys.unset("JET_KEYS_DIR") ?? panic("restore env") }
    }
    s6_hand_advisory_files.remove_all(root) ?? panic("remove scratch root")
}

// tests/pkg.rs:6831-6835: find_map(IndexEntry::parse_line), not JSON-only parsing.
s6_hand_index_first_parseable: fn(index: String, target: String) {
    text: s6_hand_advisory_files.read(index) ?? panic("published index")
    loop line in text.lines() {
        if publication_index_parse_line(line) == .Val(entry) {
            s6_hand_advisory_files.write(target, entry.content_hash) ?? panic("parsed content hash")
            return
        }
    }
    panic("published index line must parse")
}

#Test("S6 hand published index first parseable") {
    driven: s6_hand_advisory_sys.get("S6_HAND_INDEX")
    if driven == .Val(case_index) {
        s6_hand_index_first_parseable(case_index, s6_hand_advisory_sys.get("S6_HAND_HASH_OUT") ?? panic("hash output"))
        return
    }
    root: s6_hand_scratch("index")
    index: "{root}/published-index.txt"
    entry: "{{\"name\":\"mylib\",\"version\":\"1.0.0\",\"content_hash\":\"sha256-first\",\"tier\":\"core\",\"gate_status\":\"signature=not-required;audit=not-required;name=not-required;liveness=not-required;review=passed\"}}"
    second: entry.replace("sha256-first", "sha256-second")
    s6_hand_advisory_files.write(index, "not an index line\n{entry}\n{second}\n") ?? panic("write index")
    s6_hand_index_first_parseable(index, "{root}/content-hash.txt")
    assert_eq(s6_hand_advisory_files.read("{root}/content-hash.txt") ?? panic("hash written"), "sha256-first")
    s6_hand_advisory_files.remove_all(root) ?? panic("remove scratch root")
}
