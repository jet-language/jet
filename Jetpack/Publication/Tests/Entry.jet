#Test("api_diff_detects_removed_fn") {
    old :: [ApiItem{kind: "fn", name: "parse", signature: "fn parse(raw: String) -> Int"}]
    changes :: diff_public_api(old, [])
    assert(!changes.is_empty())
    assert(changes[0].description.contains("removed"))
}
// Rust: Source/Publish/mod.rs:779
#Test("api_diff_detects_changed_signature") {
    old :: [ApiItem{kind: "fn", name: "parse", signature: "fn parse(raw: String) -> Int"}]
    new :: [ApiItem{kind: "fn", name: "parse", signature: "fn parse(raw: String) -> Float"}]
    changes :: diff_public_api(old, new)
    assert(!changes.is_empty())
    assert(changes[0].description.contains("changed"))
}
