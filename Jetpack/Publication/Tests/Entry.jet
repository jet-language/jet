// Rust: Source/Publish/mod.rs:662
#Test("registry_publish_writes_and_rejects_tampered_oci_referrers") {
    root :: env.temp_dir().join("jet_registry_referrers_{time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()}")
    repo :: root.join("registry")
    source :: root.join("source")
    fs.create_dir_all(repo).unwrap()
    fs.create_dir_all(source.join(".jet")).unwrap()
    fs.write(source.join("package.jet"), "package bytes\n").unwrap()
    lock :: make_lock([make_lock_pkg("helpers", "1.0.0", "sha256-abcd1234")])
    fs.write(source.join(".jet").join("lock"), Lock.write(lock)).unwrap()
    content_hash :: SHA256.tree_hash(source)
    Registry.publish_artifact(repo, source, "ref-kit", "1.0.0", content_hash).unwrap()
    entry :: IndexEntry{name: "ref-kit", version: "1.0.0", content_hash: content_hash.clone(), fingerprint: "sha256-fingerprint", yanked: false, tier: RegistryTier.Core, gate_status: GateStatus.core_reviewed(), public_key: String.new(), signature: String.new()}
    Index.write_index_entry(repo, entry).unwrap()
    Registry.verify_oci_referrers(repo, entry).unwrap()
    blobs :: repo.join("referrers").join(content_hash).join("blobs")
    blob :: fs.read_dir(blobs).unwrap().next().unwrap().unwrap().path()
    bytes := fs.read(blob).unwrap()
    &bytes.push(10 as U8)
    fs.write(blob, bytes).unwrap()
    error :: Registry.verify_oci_referrers(repo, entry).expect_err("a tampered OCI referrer must fail closed")
    assert(error.to_string().contains("digest") || error.to_string().contains("size"), "tampering must fail on a bound OCI blob: {error}")
    fs.remove_dir_all(root).unwrap()
}
// Rust: Source/Publish/mod.rs:714
#Test("registry_publish_rejects_missing_sbom_before_index_exposure") {
    root :: env.temp_dir().join("jet_registry_missing_sbom_{time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()}")
    repo :: root.join("registry")
    source :: root.join("source")
    fs.create_dir_all(repo).unwrap()
    fs.create_dir_all(source).unwrap()
    fs.write(source.join("package.jet"), "package bytes\n").unwrap()
    content_hash :: SHA256.tree_hash(source)
    Registry.publish_artifact(repo, source, "ref-kit", "1.0.0", content_hash).unwrap()
    pending :: repo.join("referrers").join(content_hash).join(".sbom.pending")
    fs.remove_file(pending).unwrap()
    entry :: IndexEntry{name: "ref-kit", version: "1.0.0", content_hash: content_hash, fingerprint: "sha256-fingerprint", yanked: false, tier: RegistryTier.Core, gate_status: GateStatus.core_reviewed(), public_key: String.new(), signature: String.new()}
    error :: Index.write_index_entry(repo, entry).expect_err("a publication without its staged SBOM must fail closed")
    assert(error.to_string().contains("SBOM evidence was not staged"))
    assert(Index.find_entry(repo, "ref-kit", "1.0.0").unwrap().is_none())
    fs.remove_dir_all(root).unwrap()
}
