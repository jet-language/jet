    assert_eq(classify_bump(sv("1.0.0"), sv("1.1.0")), BumpKind.Minor)
    assert_eq(classify_bump(sv("1.0.0"), sv("1.0.1")), BumpKind.Patch)
    assert_eq(classify_bump(sv("1.0.0"), sv("1.0.0")), BumpKind.Same)
}
