// Rust: Source/Publish/mod.rs:161
#Test("semver_rejects_leading_zeros") {
    assert(SemVer.SemVer.parse("01.2.3").is_none())
    assert(SemVer.SemVer.parse("1.02.3").is_none())
    assert(SemVer.SemVer.parse("1.2.3-01").is_none())
    assert(SemVer.SemVer.parse("1.2").is_none())
    assert(SemVer.SemVer.parse("1.2.3.4").is_none())
    assert(SemVer.SemVer.parse("1.2.3+0010").is_some())
}
// Rust: Source/Publish/mod.rs:172
#Test("semver_hostile_numbers_and_ambiguous_ranges_never_panic_or_match") {
    huge_pre :: "1.0.0-{"9".repeat(200)}"
    parsed :: SemVer.SemVer.parse(huge_pre).expect("SemVer permits unbounded pre ids")
    assert(parsed > sv("1.0.0-2"))
    loop range in ["1 ||", "|| 1", "1 || || 2", "^18446744073709551615", "~1.18446744073709551615", "18446744073709551615.x", ">=", ">", "<", "=", "^", "~", "~>", "~>1.2"] {
        assert(VersionReq.parse(range).is_none(), "accepted hostile range: {range}")
    }
}
// Rust: Source/Publish/mod.rs:201
#Test("semver_leading_v_is_consistent_across_versions_and_ranges") {
    assert_eq(SemVer.SemVer.parse("v1.2.3"), Val(sv("1.2.3")))
    loop range in ["v1.2", "=v1.2.3", ">=v1.2.3", "^v1.2.3", "~v1.2.3"] {
        assert(VersionReq.parse(range).unwrap().matches(sv("1.2.3")), "leading v failed in {range}")
    }
    assert(VersionReq.parse("v1.2.3 - v2.0.0").unwrap().matches(sv("1.5.0")))
}
