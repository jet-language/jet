// Rust: Source/Publish/mod.rs:69
fn sv(s: String) -> SemVer.SemVer { SemVer.SemVer.parse(s).expect(s) }
// Rust: Source/Publish/mod.rs:74
#Test("semver_parse_basic") {
    v :: sv("1.2.3")
    assert_eq(v.major, 1)
    assert_eq(v.minor, 2)
    assert_eq(v.patch, 3)
}
// Rust: Source/Publish/mod.rs:82
#Test("semver_parse_with_prefix_v") { assert_eq(sv("v2.0.0").major, 2) }
