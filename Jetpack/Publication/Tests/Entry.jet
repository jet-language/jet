// Rust: Source/Publish/mod.rs:373
fn make_lock_pkg(name: String, version: String, fp: String) -> LockedPackage {
    LockedPackage{name: name, version: version, fingerprint: fp, content_hash: None,
        source: LockSource.Path(OSPath.new("/tmp/placeholder")), nix_closure: None, locked: None,
        dependencies: [], layer: None, inferred_layer: None, effects: [], effect_grants: [],
        required_effects: [], granted_effects: [], denied_effects: [], effect_authority: None,
        envelope: None, receipt: Default.default(), provenance: None}
}
// Rust: Source/Publish/mod.rs:397
fn make_lock(pkgs: [LockedPackage]) -> LockFile {
    LockFile{version: 1, packages: pkgs, root_dependencies: [], authority: None,
        workspace_members: [], workspace_source_digest: None, workspace_overlay_policy: Default.default(),
        comptime_inputs: [], toolchains: [], browsers: [], source_channels: [], build_stamp: None, build_contributions: []}
}
// Rust: Source/Publish/mod.rs:416
#Test("audit_lockfile_includes_foreign_rust_bridge_packages") {
    package := make_lock_pkg("base64", "0.22.1", "sha256-aabb")
    package.source = LockSource.Foreign{language: AST.ForeignLanguage.Rust, reference: "base64@0.22.1", output: "sha256-bridge"}
    lock :: make_lock([package])
    advisories :: [Advisory.Advisory{id: "RUSTSEC-TEST", package: "base64", affected: VersionReq.parse("^0.22").unwrap(), fixed: None, title: "bridge advisory", severity: Severity.High}]
    matches :: audit_lockfile(lock, advisories).unwrap()
    assert_eq(matches.len(), 1)
    assert_eq(matches[0].severity, Severity.High)
    assert(matches[0].diagnostic.what.contains("base64"))
}
// Rust: Source/Publish/mod.rs:439
#Test("sbom_emits_foreign_rust_bridge_packages") {
    digest :: "a".repeat(64)
    package := make_lock_pkg("base64", "0.22.1", "sha256-aabb")
    package.content_hash = Val("sha256-{digest}")
    package.source = LockSource.Foreign{language: AST.ForeignLanguage.Rust, reference: "base64@0.22.1", output: "sha256-bridge"}
    lock :: make_lock([package])
    spdx :: emit_spdx(lock, "myapp", "0.1.0")
    assert(spdx.contains("PackageName: base64"))
    assert(spdx.contains("PackageVersion: 0.22.1"))
    assert(spdx.contains("SHA256: {digest}"))
    cyclonedx :: emit_cyclonedx(lock, "myapp", "0.1.0")
    assert(cyclonedx.contains("\"name\": \"base64\""))
    assert(cyclonedx.contains("\"version\": \"0.22.1\""))
    assert(cyclonedx.contains("\"content\": \"{digest}\""))
}
// Rust: Source/Publish/mod.rs:460
#Test("maturity_window_applies_to_foreign_rust_bridge_packages") {
    package := make_lock_pkg("base64", "0.22.1", "sha256-aabb")
    package.source = LockSource.Foreign{language: AST.ForeignLanguage.Rust, reference: "base64@0.22.1", output: "sha256-bridge"}
    lock :: make_lock([package])
    feed :: (releases: [AdvisoryRelease]) -> AdvisoryFeed{sequence: 1, issued_at: 100, expires_at: 200_000,
        maturity_seconds: DEFAULT_MATURITY_SECONDS, key_id: String.new(), public_key: String.new(), signature: String.new(),
        releases: releases, advisories: [], exceptions: []}
    release :: AdvisoryRelease{package: "base64", version: sv("0.22.1"), first_seen: 100, source_class: SourceClass.ThirdParty}
    (maturity, applied) :: Advisory.lock_maturity_diagnostics(lock, feed([release.clone()]), DEFAULT_MATURITY_SECONDS, 200, []).unwrap()
    assert(applied.is_empty())
    assert_eq(maturity.len(), 1, "{maturity:?}")
    assert_eq(maturity[0].code, "E2609")
    assert(maturity[0].what.contains("base64#0.22.1"))
    (past_maturity, _) :: Advisory.lock_maturity_diagnostics(lock, feed([release]), DEFAULT_MATURITY_SECONDS, 100 + DEFAULT_MATURITY_SECONDS, []).unwrap()
    assert(past_maturity.is_empty(), "{past_maturity:?}")
    (missing_maturity, _) :: Advisory.lock_maturity_diagnostics(lock, feed([]), DEFAULT_MATURITY_SECONDS, 200, []).unwrap()
    assert_eq(missing_maturity.len(), 1, "{missing_maturity:?}")
    assert_eq(missing_maturity[0].code, "E2610")
}
