// Rust: Source/Publish/mod.rs:807
#Test("pre_publish_gate_blocked_on_minor_with_break") {
    gate :: PrePublishGate{build_ok: true, tests_ok: true, breaking: [BreakingChange{description: "fn `foo` removed", item_name: "foo"}], version: "1.1.0", bump_kind: BumpKind.Minor, next_major: 2}
    assert(gate.is_blocked())
    errs :: gate.semver_errors()
    assert(!errs.is_empty())
    assert_eq(errs[0].code, "E2601")
}
// Rust: Source/Publish/mod.rs:826
#Test("pre_publish_gate_passes_major_with_break") {
    gate :: PrePublishGate{build_ok: true, tests_ok: true, breaking: [BreakingChange{description: "fn `foo` removed", item_name: "foo"}], version: "2.0.0", bump_kind: BumpKind.Major, next_major: 3}
    assert(!gate.is_blocked())
    assert(gate.semver_errors().is_empty())
}
// Rust: Source/Publish/mod.rs:843
#Test("iso8601_format") {
    assert_eq(iso8601(0), "1970-01-01T00:00:00Z")
    assert_eq(iso8601(946684800), "2000-01-01T00:00:00Z")
    ts :: iso8601(1704067200)
    assert(ts.starts_with("2024-01-01"), "got {ts}")
}
// Rust: Source/Publish/mod.rs:854
#Test("registries_from_env") {
    environment :: ["JET_REGISTRY_PRIVATE_URL": "https://my.company/jet", "JET_REGISTRY_PRIVATE_MIRROR": "true"]
    regs :: parse_registries_from_env(environment)
    assert(!regs.is_empty())
    r :: regs[0]
    assert_eq(r.name, "private")
    assert(r.mirror)
}
