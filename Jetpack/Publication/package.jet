// Package publication: semver, signing, SBOM, advisories, the registry index,
// TUF metadata and OCI artifacts. Package fetch, which ingests into the Store,
// lives in the engine (Jetpack/Provider/Source/PackageFetch).
name: "jetpack_publication"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jetpack_foundation: ../Foundation,
    jet_pkg_model: ../PackageModel,
}
