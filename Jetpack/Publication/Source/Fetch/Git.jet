struct PackageFetchGitTransport {
    network: PublicationRegistryTransport?
    local: FoundationDirectoryAuthority?
    remote: String
}
fn pkg_fetch_git_bad(detail: String) -> PackageFetchError Never! {
    pkg_fetch_error("E1203", "git dependency URL or revision is not allowed", detail, "use a public HTTPS, SSH, or Git URL, or a local file URL inside the project root")
}
// Rust also forbids the two Unicode line separators in subprocess arguments.
fn pkg_fetch_git_has_control(text: String) -> Bool Never! {
    if pkg_text_has_control(text) -> return true
    bytes :: text.bytes()
    if bytes.len() < 3 -> return false
    loop index in 0..<(bytes.len() - 2) {
        if Int.from_u8(bytes[index]) == 226 && Int.from_u8(bytes[index + 1]) == 128 {
            last :: Int.from_u8(bytes[index + 2])
            if last == 168 || last == 169 -> return true
        }
    }
    false
}
fn pkg_fetch_git_revision(revision: String, cache: Bool) PackageFetchError! {
    if revision == "" || revision.starts_with("-") || pkg_fetch_git_has_control(revision) -> return Err(pkg_fetch_git_bad("the revision is empty or contains unsafe characters"))
    if cache -> pkg_source_store_component(revision) ?? return Err(pkg_fetch_git_bad("the revision must be one safe cache path component"))
}
fn pkg_fetch_git_transport(root: String, url: String) -[FS, Env, Net, Time.Wait]> PackageFetchGitTransport PackageFetchError! {
    if url == "" || url.starts_with("-") || pkg_fetch_git_has_control(url) -> return Err(pkg_fetch_git_bad("the URL is empty or contains unsafe characters"))
    if url.starts_with("file://") {
        path :: url.removeprefix("file://")
        if !path.starts_with("/") || path.contains("?") || path.contains("#") || path.contains("\\") -> return Err(pkg_fetch_git_bad("file URLs must name a local absolute path"))
        canonical :: files.canonicalize(path) ?? return Err(pkg_fetch_git_bad("could not resolve the local Git path: {err}"))
        project :: files.canonicalize(root) ?? return Err(pkg_fetch_git_bad("could not open project root: {err}"))
        if !(canonical == project || canonical.starts_with("{project}/")) -> return Err(pkg_fetch_git_bad("the local Git path resolves outside the project root"))
        source :: foundation_open_directory_authority(canonical) ?? return Err(pkg_fetch_git_bad("could not retain the local Git path authority: {err}"))
        source.tree_hash(true) ?? return Err(pkg_fetch_git_bad("local Git source contains unsafe files: {err}"))
        remote :: if sys.is_macos() || sys.name() == "ios" -> "/dev/fd/199" else if sys.name() == "linux" || sys.name() == "android" -> "/proc/self/fd/199" else -> { return Err(pkg_fetch_git_bad("descriptor-relative Git source access is unavailable on this platform")) }
        return Ok(PackageFetchGitTransport{network: None, local: Val(source), remote: remote})
    }
    scheme := ""
    authority := ""
    if url.split_once("://") == .Val(pair) {
        scheme = pair.before.to_ascii_lower()
        authority = pair.after
        loop marker in ([String]{"/", "?", "#"}) { if authority.split_once(marker) == .Val(parts) -> authority = parts.before }
    } else {
        parts :: url.split_once(":") ?? return Err(pkg_fetch_git_bad("local git paths must use file:// inside the project root"))
        if parts.before == "" || parts.after == "" || parts.before.contains("/") || parts.before.contains("?") || parts.before.contains("#") || parts.before.ends_with("\\") -> return Err(pkg_fetch_git_bad("local git paths must use file:// inside the project root"))
        scheme = "ssh"
        authority = parts.before
    }
    if !([String]{"git", "http", "https", "ssh"}.contains(scheme)) -> return Err(pkg_fetch_git_bad("the `{scheme}` transport is not allowed"))
    if authority.cut_last("@") == .Val(parts) {
        user :: parts.before
        if scheme != "ssh" || user == "" || user.starts_with("-") -> return Err(pkg_fetch_git_bad("SSH user-info must be a safe username"))
        loop byte in user.bytes() {
            code :: Int.from_u8(byte)
            if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 46 || code == 95 || code == 45) -> return Err(pkg_fetch_git_bad("SSH user-info must be a safe username"))
        }
        authority = parts.after
    }
    parsed :: publication_registry_host_and_port(authority) ?? return Err(pkg_fetch_git_bad(err.detail))
    if parsed.host == "" || parsed.host.starts_with("-") || parsed.host.contains("@") || parsed.host.contains("\\") -> return Err(pkg_fetch_git_bad("the URL has no valid host"))
    loop character in parsed.host.chars() { if character.is_whitespace() -> return Err(pkg_fetch_git_bad("the URL has an invalid host")) }
    port :: parsed.port ?? if scheme == "https" -> 443 else if scheme == "http" -> 80 else if scheme == "git" -> 9418 else -> 22
    answers :: publication_dns.jet_http_build_resolve(parsed.host, port) ?? return Err(pkg_fetch_git_bad("could not resolve the destination: {err}"))
    if !publication_addresses_public(answers) -> return Err(pkg_fetch_git_bad("the destination resolves to a non-public address"))
    transport :: PublicationRegistryTransport.Network(scheme, parsed.host, port, parsed.port != None, answers[0])
    Ok(PackageFetchGitTransport{network: Val(transport), local: None, remote: transport.remote(url)})
}
fn pkg_fetch_git_command(transport: PackageFetchGitTransport) -[FS, Env, Exec]> ProcessSpec PackageFetchError! {
    spec := if transport.network == .Val(network) -> network.command() else -> provider_hardened_git_command()
    if transport.local == .Val(source) -> spec = source.process_directory(spec, 199, false) ?? return Err(pkg_fetch_git_bad("could not retain local Git descriptor: {err}"))
    Ok(spec)
}
fn pkg_fetch_git_resolve_ref(transport: PackageFetchGitTransport, selector: String) -[FS, Env, Exec, Time.Wait]> String PackageFetchError! {
    pkg_fetch_git_revision(selector, false)
    receipt :: pkg_fetch_git_command(transport).args_extend([String]{"ls-remote", "--exit-code", "--", transport.remote, selector}).run() ?? return Err(pkg_fetch_git_bad("couldn't resolve Git ref: {err}"))
    if !receipt.success -> return Err(pkg_fetch_git_bad("couldn't resolve git ref `{selector}` at `{transport.remote}`"))
    fields :: receipt.output.split_whitespace().to_list()
    if fields.len() == 0 -> return Err(pkg_fetch_git_bad("git ref `{selector}` not found"))
    pkg_fetch_git_revision(fields[0], true)
    Ok(fields[0])
}
fn pkg_fetch_git_snapshot(transport: PackageFetchGitTransport, url: String, revision: String) -[FS, Env, Exec, Time, Time.Wait]> PackageSourceSnapshot PackageFetchError! {
    pkg_fetch_git_revision(revision, true)
    home :: sys.get("HOME") ?? sys.get("USERPROFILE") ?? "."
    url_hash :: pkg_sha256_hex(url.bytes())
    rev_bytes :: revision.bytes()
    prefix :: String.from_bytes(rev_bytes[0..<if rev_bytes.len() < 16 -> rev_bytes.len() else -> 16]) ?? return Err(pkg_fetch_git_bad("revision cache prefix is not UTF-8"))
    parent_path :: files.join(files.join(home, ".jet/git-cache"), String.from_bytes(url_hash.bytes()[0..<16]) ?? panic("SHA256 is ASCII"))
    parent :: foundation_open_directory_authority(parent_path, true) ?? return Err(pkg_fetch_git_bad("couldn't create git cache directory: {err}"))
    if parent.child(prefix) == {
        .Ok(existing) -> return pkg_source_snapshot_authority(existing) ?? return Err(PackageFetchError{diagnostic: err.diagnostic})
        .Err(error) -> if error != .NotFound(_) -> return Err(pkg_fetch_git_bad("couldn't open git cache: {error}"))
    }
    stage :: parent.private_child("fetch") ?? return Err(pkg_fetch_git_bad("couldn't create temporary git cache: {err}"))
    stage_name :: files.basename(stage.path())
    result :: pkg_fetch_git_populate(transport, stage, revision)
    if result == .Err(error) {
        parent.remove_tree(stage_name).drop("remove the owned failed Git staging directory")
        return Err(error)
    }
    snapshot :: pkg_source_snapshot_authority(stage) ?? {
        parent.remove_tree(stage_name).drop("remove failed Git snapshot staging directory")
        return Err(PackageFetchError{diagnostic: err.diagnostic})
    }
    if parent.rename(stage_name, prefix) == {
        .Ok(_) -> {
            parent.fsync() ?? return Err(pkg_fetch_git_bad("couldn't flush git cache: {err}"))
            Ok(snapshot)
        }
        .Err(error) -> {
            close(^snapshot)
            parent.remove_tree(stage_name).drop("remove losing owned Git staging directory")
            if error != .AlreadyExists(_) -> return Err(pkg_fetch_git_bad("couldn't publish git cache: {error}"))
            winner :: parent.child(prefix) ?? return Err(pkg_fetch_git_bad("couldn't open concurrent git cache: {err}"))
            pkg_source_snapshot_authority(winner) ?? return Err(PackageFetchError{diagnostic: err.diagnostic})
        }
    }
}
fn pkg_fetch_git_populate(transport: PackageFetchGitTransport, stage: FoundationDirectoryAuthority, revision: String) PackageFetchError! -[FS, Env, Exec, Time.Wait]> {
    clone :: stage.process_directory(pkg_fetch_git_command(transport), 198, true) ?? return Err(pkg_fetch_git_bad("couldn't retain Git cache authority: {err}"))
    receipt :: clone.args_extend([String]{"clone", "--quiet", "--", transport.remote, "."}).run() ?? return Err(pkg_fetch_git_bad("failed to clone: {err}"))
    if !receipt.success -> return Err(pkg_fetch_git_bad("failed to clone `{transport.remote}`"))
    checkout :: stage.process_directory(provider_hardened_git_command(), 198, true) ?? return Err(pkg_fetch_git_bad("couldn't retain Git checkout authority: {err}"))
    receipt :: checkout.args_extend([String]{"checkout", "--quiet", revision}).run() ?? return Err(pkg_fetch_git_bad("couldn't check out revision: {err}"))
    if !receipt.success -> return Err(pkg_fetch_git_bad("couldn't check out revision `{revision}`"))
    stage.revalidate() ?? return Err(pkg_fetch_git_bad("Git cache authority changed: {err}"))
}
fn pkg_fetch_git_node(verification: &StoreVerification, roots: HangarRoots, context: ProviderCtx, resolver: &PackageFetchResolver, name: String, url: String, selector: GitSelector, chain: [String]) -[FS, Env, Exec, Net, Time, Time.Wait]> PackageFetchNode PackageFetchError! {
    transport :: pkg_fetch_git_transport(resolver.root, url)
    if !provider_git_available() -> return Err(pkg_fetch_git_bad("git is not installed or is not on PATH"))
    revision := String?{None}
    if selector == .Rev(value) {
        pkg_fetch_git_revision(value, true)
        revision = Val(value)
    }
    if revision == None && !pkg_fetch_update_requested(resolver, name) {
        if pkg_fetch_previous_package(resolver, name) == .Val(package) {
            if package.locked == .Val(locked) {
                pkg_fetch_git_revision(locked.rev, true)
                revision = Val(locked.rev)
            }
        }
    }
    if revision == None {
        refname :: if selector == { .Rev(value) | .Branch(value) | .Tag(value) -> value }
        revision = Val(pkg_fetch_git_resolve_ref(transport, refname))
    }
    rev :: revision ?? panic("Git revision resolution is exhaustive")
    snapshot :: pkg_fetch_git_snapshot(transport, url, rev)
    locked :: LockedRevision{rev: rev, tree_hash: snapshot.content_hash, last_modified: time.unix_ns() /% 1000000000}
    result :: pkg_fetch_source_node(&verification, roots, context, &resolver, name, .Git(url, pkg_lock_git_selector_str(selector)), Val(locked), snapshot, chain)
    close(^snapshot)
    result
}
