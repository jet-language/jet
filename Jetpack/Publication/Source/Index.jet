// Git sparse-index port: Source/Publish/Index.rs. Fixed nine-field JSONL;
// parsing/quoting reuse Foundation's shared protocol JSON boundary and helpers:
// Foundation JSON::quote (not sorted/LF CanonicalJSON or RFC8785 JCS).
// Registry verification/referrer finalization are mandatory shared dependencies.
// Rust's InvalidData reports InvalidInput (CORE-GAPS 11); open/create/fsync and
// Stat.modified nanoseconds owe #3593. No Other-kind fallback.
use {
    jet_foundation.[foundation_json_quote, foundation_parse_protocol_json]
    jet_pkg_model.[
        PublicationRegistryTier, pkg_json_bool, pkg_json_object, pkg_json_text, publication_parse_tier,
        publication_tier_label,
    ]
    jetpack_foundation.[foundation_write_file_nofollow_at_root]
    files: core.files
    time: core.time
}

PublicationIndexEntry: struct {
    name: String
    version: String
    content_hash: String
    fingerprint: String
    yanked: Bool
    tier: PublicationRegistryTier
    gate_status: PublicationGateStatus
    public_key: String
    signature: String
}

publication_index_to_jsonl: fn(entry: PublicationIndexEntry) -> String Never! {
    "{{\"name\":{foundation_json_quote(entry.name)},\"version\":{foundation_json_quote(entry.version)},\"content_hash\":{foundation_json_quote(entry.content_hash)},\"fingerprint\":{foundation_json_quote(entry.fingerprint)},\"yanked\":{if entry.yanked -> "true" else -> "false"},\"tier\":{foundation_json_quote(publication_tier_label(entry.tier))},\"gate_status\":{foundation_json_quote(publication_gate_summary(entry.gate_status))},\"public_key\":{foundation_json_quote(entry.public_key)},\"signature\":{foundation_json_quote(entry.signature)}}}"
}

publication_index_parse_line: fn(line: String) -> PublicationIndexEntry? Never! {
    tree: foundation_parse_protocol_json(line) ?? return None
    fields: pkg_json_object(tree) ?? return None
    loop key in fields.keys() {
        if key != "name" && key != "version" && key != "content_hash" && key != "fingerprint" && key != "yanked" && key != "tier" && key != "gate_status" && key != "public_key" && key != "signature" -> return None
    }
    Val(PublicationIndexEntry{
        name: publication_index_required_string(fields, "name") ?? return None,
        version: publication_index_required_string(fields, "version") ?? return None,
        content_hash: publication_index_optional_string(fields, "content_hash") ?? return None,
        fingerprint: publication_index_optional_string(fields, "fingerprint") ?? return None,
        yanked: publication_index_optional_bool(fields, "yanked") ?? return None,
        tier: publication_parse_tier(publication_index_required_string(fields, "tier") ?? return None) ?? return None,
        gate_status: publication_parse_gate_status(publication_index_required_string(fields, "gate_status") ?? return None) ?? return None,
        public_key: publication_index_optional_string(fields, "public_key") ?? return None,
        signature: publication_index_optional_string(fields, "signature") ?? return None
    })
}
publication_index_required_string: fn(fields: [String: Dyn], key: String) -> String? Never! {
    text: pkg_json_text(fields.get(key) ?? return None) ?? return None
    if text == "" -> return None
    Val(text)
}
publication_index_optional_string: fn(fields: [String: Dyn], key: String) -> String? Never! {
    value: fields.get(key) ?? return Val("")
    pkg_json_text(value)
}
publication_index_optional_bool: fn(fields: [String: Dyn], key: String) -> Bool? Never! {
    value: fields.get(key) ?? return Val(false)
    pkg_json_bool(value)
}

publication_pinned_public_key: fn(entries: [PublicationIndexEntry]) -> String? Never! {
    loop entry in entries {
        key: entry.public_key.trim()
        if key != "" -> return Val(key)
    }
    None
}
publication_is_takeover: fn(entries: [PublicationIndexEntry], candidate: PublicationIndexEntry) -> Bool Never! {
    if candidate.public_key.trim() == "" -> return false
    pinned: publication_pinned_public_key(entries) ?? return false
    pinned != candidate.public_key.trim()
}
publication_validate_takeover: fn(repo: String, entries: [PublicationIndexEntry], candidate: PublicationIndexEntry) PublicationDiagnosticError! -[FS]> {
    if !publication_is_takeover(entries, candidate) -> return
    publication_require_takeover_review(repo, candidate.name, candidate.version)
    all := entries.copy()
    all.push(candidate.copy())
    _: publication_verify_index_entry(all, candidate, true, "registry")
}

// The IOError kinds Publication reports. Core keeps the IOContext and
// IOOperation annotations Core-only, so the builders below make every
// context. Rust's InvalidData reports InvalidInput: D-IO-INVALIDDATA1=A is
// ratified, but Core's IOError has no InvalidData yet (CORE-GAPS 11).
PublicationIOKind: enum {
    InvalidInput
    NotFound
    PermissionDenied
    AlreadyExists
    TimedOut
    Cancelled
    Other
}

// A registry index update refusal on `path` (operation `Write`).
publication_index_error: fn(kind: PublicationIOKind, path: String, cause: String) -> IOError Never! {
    publication_io_error(kind, true, path, cause)
}

// A registry read refusal on `path` (operation `Read`).
publication_read_error: fn(kind: PublicationIOKind, path: String, cause: String) -> IOError Never! {
    publication_io_error(kind, false, path, cause)
}

publication_io_error: fn(kind: PublicationIOKind, write: Bool, path: String, cause: String) -> IOError Never! {
    context: if write -> IOContext{operation: .Write, resource: Val(path), os_code: None, cause: Val(cause)} else -> IOContext{operation: .Read, resource: Val(path), os_code: None, cause: Val(cause)}
    if kind == {
        .InvalidInput -> IOError.InvalidInput(context)
        .NotFound -> IOError.NotFound(context)
        .PermissionDenied -> IOError.PermissionDenied(context)
        .AlreadyExists -> IOError.AlreadyExists(context)
        .TimedOut -> IOError.TimedOut(context)
        .Cancelled -> IOError.Cancelled(context)
        .Other -> IOError.Other(context)
    }
}
publication_validate_index_component: fn(value: String, label: String) IOError! {
    if value == "" || value == "." || value == ".." || value.contains("/") || value.contains("\\") -> return Err(publication_index_error(.InvalidInput, value, "registry {label} is not one safe path component"))
    loop byte in value.bytes() {
        code: Int.from_u8(byte)
        if code < 32 || code == 127 -> return Err(publication_index_error(.InvalidInput, value, "registry {label} is not one safe path component"))
    }
}
publication_index_entry_path: fn(repo: String, name: String) -> String IOError! {
    publication_validate_index_component(name, "package name")
    Ok(files.join(files.join(files.join(repo, "index"), name), "{name}.jsonl"))
}
publication_read_entries: fn(repo: String, name: String) -[FS]> [PublicationIndexEntry] IOError! {
    path: publication_index_entry_path(repo, name)
    text: publication_index_read_or_empty(path)
    out := [PublicationIndexEntry]{}
    line_number := 0
    loop raw in text.lines() {
        line_number += 1
        if raw.trim() == "" -> next
        entry: publication_index_parse_line(raw) ?? return Err(publication_index_error(.InvalidInput, path, "malformed registry index record at line {line_number}"))
        out.push(entry)
    }
    Ok(out)
}
publication_index_read_or_empty: fn(path: String) -[FS]> String IOError! {
    if files.read(path) == {
        .Ok(text) -> Ok(text)
        .Err(error) -> if error == {
            .NotFound(_) -> Ok("")
            else -> Err(error)
        }
    }
}
publication_package_names: fn(repo: String) -[FS]> [String] IOError! {
    root: files.join(repo, "index")
    directories: files.list_dir(root) ?? {
        if err == .NotFound(_) -> return Ok([String]{})
        return Err(err)
    }
    names := [String]{}
    loop directory in directories {
        metadata: files.stat(directory.path)
        if metadata.is_symlink -> return Err(publication_index_error(.InvalidInput, directory.path, "registry index package directory must not be a symlink"))
        if !metadata.is_dir -> next
        name: directory.name
        publication_validate_index_component(name, "package name")
        path: publication_index_entry_path(repo, name)
        info: files.stat(path) ?? {
            if err == {
                .NotFound(_) -> {}
                else -> return Err(err)
            }
            next
        }
        if info.is_symlink || !info.is_file -> return Err(publication_index_error(.InvalidInput, path, "registry index for `{name}` is not a regular file"))
        names.push(name)
    }
    names.sort()
    Ok(names)
}
publication_find_entry: fn(repo: String, name: String, version: String) -[FS]> PublicationIndexEntry? IOError! {
    loop entry in publication_read_entries(repo, name) {
        if entry.version == version -> return Ok(Val(entry))
    }
    Ok(None)
}
publication_non_yanked_entries: fn(repo: String, name: String) -[FS]> [PublicationIndexEntry] IOError! {
    out := [PublicationIndexEntry]{}
    loop entry in publication_read_entries(repo, name) {
        if !entry.yanked -> out.push(entry)
    }
    Ok(out)
}

// Rust with_index_lock: exclusive create, 100 attempts, stale after >300s,
// 50ms contention sleep, fsync before action, cleanup on every result.
publication_with_index_lock: fn<T>(repo: String, name: String, action: fn() -[FS, Env, Time]> T IOError!) -[FS, Env, Time]> T IOError! {
    root: files.join(repo, "index")
    files.create_dir_all(root)
    info: files.stat(root)
    if info.is_symlink || !info.is_dir -> return Err(publication_index_error(.InvalidInput, root, "registry index root is not a real directory"))
    path: files.join(root, ".{name}.lock")
    loop _ in 0..<100 {
        writer: files.create(path, if_exists: .Refuse, links: .Refuse) ?? {
            if err == {
                .AlreadyExists(_) -> {}
                else -> return Err(err)
            }
            if files.stat(path) == .Ok(metadata) {
                if time.unix_ns() - (metadata.modified.to_unix_ns() ?? panic("file times fit Unix nanoseconds")) > 300000000000 {
                    files.remove(path).drop("stale index lock reclamation is best-effort; the next attempt re-races")
                    next
                }
            }
            time.sleep(time.duration_ms(50))
            next
        }
        if writer.fsync() == .Err(error) {
            close(writer)
            files.remove(path).drop("the unsynced lock is released; the fsync error is primary")
            return Err(error)
        }
        // Rust cleans the lock up on EVERY action result; a plain call would
        // propagate an Err before the lock file is released.
        if action() == {
            .Ok(value) -> {
                close(writer)
                files.remove(path).drop("release the owned index lock; the action result is primary")
                return Ok(value)
            }
            .Err(error) -> {
                close(writer)
                files.remove(path).drop("release the owned index lock; the action error is primary")
                return Err(error)
            }
        }
    }
    Err(publication_index_error(.TimedOut, path, "registry index update for `{name}` is busy"))
}

// The canonical descriptor-relative publisher owns staging/fsync/rename and
// temporary cleanup; no second pathname publisher. Core authority debt #3593.
publication_index_atomic_replace: fn(repo: String, path: String, bytes: [U8]) IOError! -[FS, Env, Time]> {
    parent: files.dirname(path)
    if parent == "" -> return Err(publication_index_error(.InvalidInput, path, "registry index has no parent"))
    if files.stat(path) == .Ok(info) {
        if info.is_symlink || !info.is_file -> return Err(publication_index_error(.InvalidInput, path, "registry index path must be a regular file"))
    }
    info: files.stat(parent)
    if info.is_symlink || !info.is_dir -> return Err(publication_index_error(.InvalidInput, parent, "registry index parent is not a real directory"))
    relative: files.relative(path, repo)
    foundation_write_file_nofollow_at_root(repo, relative, bytes, None) ?? return Err(err.error)
}

publication_write_index_entry: fn(repo: String, entry: PublicationIndexEntry) IOError! -[FS, Env, Time]> {
    publication_validate_index_component(entry.name, "package name")
    publication_validate_index_component(entry.version, "package version")
    lock_repo: repo.copy()
    lock_name: entry.name.copy()
    // workaround #5940(h)
    _: publication_with_index_lock<Bool>(lock_repo, lock_name, () -> publication_write_index_entry_locked(repo, entry))
}

publication_write_index_entry_locked: fn(repo: String, entry: PublicationIndexEntry) -[FS, Env, Time]> Bool IOError! {
    path: publication_index_entry_path(repo, entry.name)
    parent: files.dirname(path)
    if parent != "" {
        files.create_dir_all(parent)
        info: files.stat(parent)
        if info.is_symlink || !info.is_dir -> return Err(publication_index_error(.InvalidInput, parent, "registry index package directory is not a real directory"))
    }
    text: publication_index_read_or_empty(path)
    entries := [PublicationIndexEntry]{}
    loop line in text.lines() {
        if line.trim() == "" -> next
        existing: publication_index_parse_line(line) ?? return Err(publication_index_error(.InvalidInput, path, "malformed registry index record"))
        if existing.name == entry.name && existing.version == entry.version {
            if existing == entry {
                publication_finalize_oci_referrers(repo, entry)
                return Ok(true)
            }
            return Err(publication_index_error(.AlreadyExists, path, "registry version {entry.name} {entry.version} is immutable"))
        }
        entries.push(existing)
    }
    if publication_validate_takeover(repo, entries, entry) == .Err(error) -> return Err(publication_index_error(.PermissionDenied, path, "{error.diagnostic.code}: {error.diagnostic.what}"))
    separator: if text != "" && !text.ends_with("\n") -> "\n" else -> ""
    // Evidence must finish BEFORE the new immutable version becomes visible.
    publication_finalize_oci_referrers(repo, entry)
    publication_index_atomic_replace(repo, path, "{text}{separator}{publication_index_to_jsonl(entry)}\n".bytes())
    Ok(true)
}

publication_mark_yanked: fn(repo: String, name: String, version: String) -[FS, Env, Time]> Bool IOError! {
    publication_validate_index_component(name, "package name")
    publication_validate_index_component(version, "package version")
    lock_repo: repo.copy()
    lock_name: name.copy()
    // workaround #5940(h)
    publication_with_index_lock<Bool>(lock_repo, lock_name, () -> publication_mark_yanked_locked(repo, name, version))
}

publication_mark_yanked_locked: fn(repo: String, name: String, version: String) -[FS, Env, Time]> Bool IOError! {
    path: publication_index_entry_path(repo, name)
    text: publication_index_read_or_empty(path)
    found := false
    output := [String]{}
    loop line in text.lines() {
        if line.trim() == "" -> next
        entry := publication_index_parse_line(line) ?? return Err(publication_index_error(.InvalidInput, path, "malformed registry index record"))
        if entry.name == name && entry.version == version && !entry.yanked {
            entry.yanked = true
            found = true
            output.push(publication_index_to_jsonl(entry))
        } else {
            output.push(line)
        }
    }
    if found {
        // A final empty item gives join the Rust trailing newline without another copy.
        output.push("")
        publication_index_atomic_replace(repo, path, output.join("\n").bytes())
    }
    Ok(found)
}
