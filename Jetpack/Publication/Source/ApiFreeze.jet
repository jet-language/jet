// Rust: Source/Publish/ApiFreeze.rs:1
// Driver-level API freeze: the pure snapshot owner is jet.Sema.ApiFreeze.
// Rust: Source/Publish/ApiFreeze.rs:6
// Canonical pure API imports replace the Rust wrapper's public re-exports.
use jet.Sema.ApiFreeze.[ApiSnapshot, snapshot_from_items_with_ledger, save_snapshot, api_cache_dir]
use jet.Loader
use jet.Sema
use jet.Diagnostics.Severity
use jet.ReceiptStore
// GATE #4494: native environment path ingress preserves non-UTF8 paths.
use core.sys.host.os_path_ingress.var_os

// Rust: Source/Publish/ApiFreeze.rs:20
pub fn write_api_snapshot_for_entry(project_root: OSPath, entry_file: String, package: String, version: String) -> Int? {
    bundle := Loader.load_entry_with_overlay(entry_file, None, true).ok() ?? return None
    (diagnostics, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check)
    if diagnostics.iter().any(diagnostic -> diagnostic.severity == Severity.Error) -> return None
    entry :: bundle.modules[bundle.entry]
    snap :: snapshot_from_items_with_ledger(entry.items, package, version, Val(facts.solved),
        facts.name_ledger.module_alias(bundle.entry), bundle.entry, facts.name_ledger)
    count :: snap.funcs.len()
    _ :: save_snapshot(project_root, snap).ok() ?? return None
    _ :: record_api_receipt(project_root, entry_file, package, version, snap).ok() ?? return None
    Val(count)
}
// Rust: Source/Publish/ApiFreeze.rs:51
fn record_api_receipt(project_root: OSPath, entry_file: String, package: String, version: String, snapshot: ApiSnapshot) -> Unit Err! {
    root :: var_os("JET_RECEIPT_DIR").unwrap_or_else(() -> project_root.join(".jet").join("receipts"))
    entry_path :: OSPath.from(entry_file)
    entry :: if entry_path.is_absolute() { entry_path } else { project_root.join(entry_path) }
    args :: [package.to_string(), version.to_string()]
    input_argv :: ["api", entry.display().to_string()]
    inputs := ReceiptStore.input_paths_for("api", input_argv, project_root)
    snapshot_path :: api_cache_dir(project_root).join("{package}.api")
    if snapshot_path.is_file() -> &inputs.push(snapshot_path)
    store :: ReceiptStore.ReceiptStore.new(root)
    store.record("api", args, inputs, 0, snapshot.write().as_bytes(), []).map(_ -> ())
}
