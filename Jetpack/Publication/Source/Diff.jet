// Pure SemVer consumer of the Compiler's PublicAPIItem rows: sema produces
// them (sema_public_api_items) and this module only diffs two snapshots and words
// the gate's diagnostics. It never parses or reconstructs a public API from
// source. Diagnostics use the single registry constructor and its sentence
// casing.
//
// What breaks (the spec's publish section lists the same rules): a removed or
// changed row, except a fn whose solved effect row only narrowed; a `variant`
// added to an existing enum; a `require` added to an existing trait; a
// `field` without a default added to an existing struct whose row is not
// sealed (`{ .. }`). Every other added row is compatible.
use {
    jet_foundation.[Diagnostic, PublicAPIItem, diagnostic_from_registry]
    jet_pkg_model.[PackageCapabilitySnapshot, pkg_api_snapshot_line_name]
}

PublicationBreakingChange: struct {
    description: String
    item_name: String
}

// A registry snapshot's rows; publication_read_api_snapshot has checked every
// line names its kind.
publication_api_snapshot_items: fn(snapshot: PackageCapabilitySnapshot) -> [PublicAPIItem] Never! {
    items := [PublicAPIItem]{}
    loop line in snapshot.signatures {
        if pkg_api_snapshot_line_name(line) == .Val(row) -> &items.push(PublicAPIItem{kind: row.kind, name: row.name, signature: line.copy()})
    }
    items
}

// The published entry a new release's API is compared with: the highest
// version below it, yanked or not, so a backport to 1.4.x is held to 1.4's
// API and not to a later 2.0.
publication_api_baseline: fn(entries: [PublicationIndexEntry], version: PublicationSemVer) -> PublicationIndexEntry? Never! {
    best := PublicationIndexEntry?{None}
    best_version := publication_ver(0, 0, 0)
    loop entry in entries {
        published: publication_parse_semver(entry.version) ?? next
        if publication_precedence(published, version) != Ordering.Less -> next
        if best != None && publication_precedence(published, best_version) != Ordering.Greater -> next
        best = Val(entry)
        best_version = published
    }
    best
}

// Match the first unused full triple before the first unused kind/name pair.
// Duplicate legacy names therefore retain signature-multiset semantics.
publication_diff_public_api: fn(old: [PublicAPIItem], new: [PublicAPIItem]) -> [PublicationBreakingChange] Never! {
    changes := [PublicationBreakingChange]{}
    matched := (loop _ in new -> false)
    loop old_item in old {
        exact := -1
        loop index in 0..<new.len() {
            item: new[index]
            if !matched[index] && item.kind == old_item.kind && item.name == old_item.name && item.signature == old_item.signature {
                exact = index
                break
            }
        }
        if exact >= 0 {
            matched[exact] = true
            next
        }
        replacement := -1
        loop index in 0..<new.len() {
            item: new[index]
            if !matched[index] && item.kind == old_item.kind && item.name == old_item.name {
                replacement = index
                break
            }
        }
        if replacement >= 0 {
            matched[replacement] = true
            item: new[replacement]
            if publication_api_effects_narrowed(old_item, item) -> next
            &changes.push(PublicationBreakingChange{
                description: "public {old_item.kind} `{old_item.name}` changed signature\n   | was: {old_item.signature}\n   | now: {item.signature}",
                item_name: old_item.name.copy(),
            })
        } else {
            &changes.push(PublicationBreakingChange{
                description: "public {old_item.kind} `{old_item.name}` was removed\n   | {old_item.signature}\n   | (removed)",
                item_name: old_item.name.copy(),
            })
        }
    }
    loop index in 0..<new.len() {
        item: new[index]
        if matched[index] || !publication_api_addition_breaks(old, new, item) -> next
        &changes.push(PublicationBreakingChange{
            description: "public {item.kind} `{item.name}` was added to an existing type\n   | (absent)\n   | {item.signature}",
            item_name: item.name.copy(),
        })
    }
    changes
}

// The row of kind `kind` that `member` (`Owner.member`) belongs to.
publication_api_owner: fn(items: [PublicAPIItem], kind: String, member: String) -> PublicAPIItem? Never! {
    loop item in items {
        if item.kind == kind && member.starts_with("{item.name}.") && !member.removeprefix("{item.name}.").contains(".") -> return Val(item)
    }
    None
}

// A new variant breaks every exhaustive match, a new required member every
// implementation, and a new field without a default every literal of a
// struct dependents can build. Members of a new owner are new API.
publication_api_addition_breaks: fn(old: [PublicAPIItem], new: [PublicAPIItem], item: PublicAPIItem) -> Bool Never! {
    if item.kind == {
        "variant" -> publication_api_owner(old, "enum", item.name) != None
        "require" -> publication_api_owner(old, "trait", item.name) != None
        "field" -> {
            if item.signature.ends_with(" = _") || publication_api_owner(old, "struct", item.name) == None -> return false
            owner: publication_api_owner(new, "struct", item.name) ?? return true
            !owner.signature.ends_with("{{ .. }}")
        }
        else -> false
    }
}

PublicationAPIEffects: struct {
    // The signature with its effect row cut out.
    rest: String
    effects: [String]
}

// `f: fn(x: Int) Int -[IO, Net]> = _` as `f: fn(x: Int) Int = _` and [IO, Net].
publication_api_effects: fn(signature: String) -> PublicationAPIEffects? Never! {
    parts: signature.split(" -[").to_list()
    if parts.len() < 2 -> return None
    tail: parts[parts.len() - 1].split_once("]>") ?? return None
    head: (loop index in 0..<(parts.len() - 1) -> parts[index].copy()).join(" -[")
    effects: if tail.before == "" -> [String]{} else -> (loop name in tail.before.split(", ") -> name.copy())
    Val(PublicationAPIEffects{rest: "{head}{tail.after}", effects: effects})
}

// A fn whose effect row only lost effects still runs in every caller's
// context; a widened row (or a newly maximal `*` one) does not.
publication_api_effects_narrowed: fn(old: PublicAPIItem, new: PublicAPIItem) -> Bool Never! {
    if old.kind != "fn" -> return false
    before: publication_api_effects(old.signature) ?? return false
    after: publication_api_effects(new.signature) ?? return false
    if before.rest != after.rest -> return false
    if before.effects.contains("*") -> return true
    loop name in after.effects {
        if !before.effects.contains(name) -> return false
    }
    true
}

publication_e2601: fn(version: String, bump_kind: PublicationBumpKind, change: PublicationBreakingChange, next_major: Int) -> Diagnostic Never! {
    bump: if bump_kind == {
        .Minor -> "minor"
        .Patch -> "patch"
        else -> "non-breaking"
    }
    // split('.').next() is always present, including the empty version.
    // Core find is a byte offset while slice is character-indexed, so take the
    // text prefix directly; mixing them corrupts non-ASCII text before the dot.
    major: if version.split_once(".") == .Val(parts) -> parts.before else -> version
    diagnostic_from_registry("E2601", None,
        "this release is tagged {version} but removes public API",
        "{version} is a {bump} bump, which promises no breaking changes. Callers pinned to ^{major}.0 would stop compiling.\n  {change.description}",
        "bump to {next_major}.0.0, or restore `{change.item_name}` (a deprecated shim counts). Use `jet registry publish --force` to override with a warning banner.")
}

publication_e1218: fn(old_version: String, new_version: String, bump: PublicationBumpKind, change: PublicationBreakingChange, next_major: Int) -> Diagnostic Never! {
    label: if bump == {
        .Minor -> "minor"
        .Patch -> "patch"
        .Same -> "unchanged"
        .Major -> "major"
    }
    diagnostic := diagnostic_from_registry("E1218", None,
        "publishing {new_version} after {old_version} is a {label} bump but breaks the public API item `{change.item_name}`",
        "a {label} bump promises callers no breaking changes, but the public API changed since {old_version}",
        "bump to {next_major}.0.0 (a major release), or restore `{change.item_name}` (a deprecated shim counts); `--force` publishes anyway with a warning banner.")
    diagnostic.detail = Val("  {change.description}")
    diagnostic
}

PublicationPrePublishGate: struct {
    build_ok: Bool
    tests_ok: Bool
    breaking: [PublicationBreakingChange]
    version: String
    bump_kind: PublicationBumpKind
    next_major: Int

    is_blocked: fn(self) -> Bool Never! {
        !self.build_ok || !self.tests_ok || (self.breaking.len() != 0 && self.bump_kind != .Major)
    }

    semver_errors: fn(self) -> [Diagnostic] Never! {
        if self.bump_kind == .Major -> return [Diagnostic]{}
        loop change in self.breaking -> publication_e2601(self.version, self.bump_kind, change, self.next_major)
    }
}
