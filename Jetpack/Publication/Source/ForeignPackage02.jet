fn java_type(value: JetLibScalar) -> String {
    if value == { .Int -> "long", .Float -> "double", .Bool -> "boolean", .Text -> "String" }
}
// Rust: Source/Publish/ForeignPackage.rs:1904
fn java_public_name(value: String) -> String {
    name :: normalized_component(value, false)
    if ["abstract", "assert", "boolean", "break", "byte", "case", "catch", "char", "class", "const", "continue", "default", "do", "double", "else", "enum", "extends", "final", "finally", "float", "for", "goto", "if", "implements", "import", "instanceof", "int", "interface", "long", "native", "new", "package", "private", "protected", "public", "return", "short", "static", "strictfp", "super", "switch", "synchronized", "this", "throw", "throws", "transient", "try", "void", "volatile", "while"].contains(name) { "jet_{name}" } else { name }
}
// Rust: Source/Publish/ForeignPackage.rs:1966
fn build_jni_bridge(input: LibraryInput, package: String, class_name: String, jni_name: String) -> [U8] Err! {
    // GATE #4483: selected target OS, not host OS.
    if target.selected_os() == "windows" -> return Err("JVM packaging is not supported for the Windows target yet")
    home :: java_home()?
    work :: work_dir(input, "jni")?
    result :: (() -> {
        fs.write(work.join(input.runtime_name), input.runtime).map_err(error -> "could not stage the JVM runtime: {error}")?
        fs.write(work.join("api.h"), input.header).map_err(error -> "could not stage the C ABI header: {error}")?
        source :: render_jni_bridge(input, package, class_name)
        source_path :: work.join("jni.c")
        fs.write(source_path, source.as_bytes()).map_err(error -> "could not write the JNI bridge: {error}")?
        output :: work.join(jni_name)
        command := Command.new("cc")
        &command.args(["-std=c11", "-shared", "-fPIC", "-I"]).arg(home.join("include")).arg("-I")
            .arg(home.join("include").join(jni_include_dir())).arg(source_path).arg("-I").arg(work)
        link_runtime_args(&command, work, input.runtime_name)
        &command.arg("-o").arg(output)
        run_host_tool(&command, "cc")?
        read_regular_file(output, "JNI bridge")
    })()
    cleanup_work(work)
    result
}
// Rust: Source/Publish/ForeignPackage.rs:2005
fn jni_include_dir() -> String {
    if target.selected_os() == "macos" { "darwin" } else { "linux" }
}
// Rust: Source/Publish/ForeignPackage.rs:2013
fn jni_mangle(value: String) -> String {
    output := String.new()
    loop ch in value.chars() {
        if ch == {
            'a'..='z' | 'A'..='Z' | '0'..='9' -> &output.push(ch)
            '_' -> &output.push_str("_1")
            ';' -> &output.push_str("_2")
            '[' -> &output.push_str("_3")
            else -> &output.push_str("_0{ch as U32:04x}")
        }
    }
    output
}
// Rust: Source/Publish/ForeignPackage.rs:2029
fn render_jni_bridge(input: LibraryInput, package: String, class_name: String) -> String {
    prefix :: "Java_{jni_mangle(package)}_{jni_mangle(class_name)}_"
    has_text :: input.stamp.exports.iter().any(export -> export.scalar == .Text)
    output := "#include <jni.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"api.h\"\nstatic void jet_jni_throw(JNIEnv *env, const char *message) {{\njclass type = (*env)->FindClass(env, \"java/lang/IllegalStateException\");\nif (type != NULL) {{ (*env)->ThrowNew(env, type, message); (*env)->DeleteLocalRef(env, type); }}\n}}\n"
    if !has_text -> &output.push('\n')
    loop (index, export) in input.stamp.exports.iter().enumerate() {
        result_type :: jni_type(export.scalar)
        &output.push_str("\nJNIEXPORT {result_type} JNICALL {prefix}jetCall{index}(JNIEnv *env, jclass ignored")
        loop param in 0..<export.params -> &output.push_str(", {jni_type(export.scalar)} arg{param}")
        &output.push_str(") {{\n    (void)ignored;\n")
        params :: Int.try_from(export.params).unwrap_or(0)
        if export.scalar == .Text {
            loop param in 0..<params {
                &output.push_str("    const char *raw{param} = (*env)->GetStringUTFChars(env, arg{param}, NULL); if (raw{param} == NULL) {{ jet_jni_throw(env, \"could not read UTF-8 argument\");\n")
                loop prior in 0..<param -> &output.push_str("        (*env)->ReleaseStringUTFChars(env, arg{prior}, raw{prior});\n")
                &output.push_str("        return NULL; }}\n")
                &output.push_str("    JetText value{param} = {{ (const uint8_t *)raw{param}, (size_t)(*env)->GetStringUTFLength(env, arg{param}) }};\n")
            }
            args :: (0..<params).map(param -> "value{param}").collect().join(", ")
            &output.push_str("    JetText result = {export.symbol}({args});\n")
            loop param in 0..<params -> &output.push_str("    (*env)->ReleaseStringUTFChars(env, arg{param}, raw{param});\n")
            &output.push_str("    if (result.len != 0 && result.ptr == NULL) {{ jet_jni_throw(env, \"JetText result has an invalid pointer\"); return NULL; }}\n")
            &output.push_str("    if (result.len > (size_t)-1 - 1) {{ jet_jni_throw(env, \"JetText result is too large\"); return NULL; }}\n")
            &output.push_str("    char *copy = (char *)malloc(result.len + 1); if (copy == NULL) {{ jet_jni_throw(env, \"could not allocate text result\"); return NULL; }} if (result.len != 0) memcpy(copy, result.ptr, result.len); copy[result.len] = 0; jstring value = (*env)->NewStringUTF(env, copy); free(copy); jet_text_free(result); if (value == NULL) {{ jet_jni_throw(env, \"could not create text result\"); return NULL; }} return value;\n")
        } else {
            args :: (0..<params).map(param -> "arg{param}").collect().join(", ")
            &output.push_str("    return ({result_type}){export.symbol}({args});\n")
        }
        &output.push_str("}}\n")
    }
    output
}
