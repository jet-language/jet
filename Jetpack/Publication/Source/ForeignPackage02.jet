fn render_nuspec(input: LibraryInput, package: String) -> String {
    "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<package xmlns=\"http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd\">\n  <metadata>\n    <id>{xml_string(package)}</id><version>{xml_string(input.version)}</version><authors>Jet package publisher</authors><owners>Jet</owners>\n    <description>Typed native bindings for Jet library {xml_string(input.library_name)}</description>\n    <license type=\"expression\">{xml_string(input.license)}</license>\n    <repository type=\"git\" url=\"https://jet-lang.dev/source/{xml_string(input.source_identity)}\" />\n    <tags>jet native ffi abi</tags>\n    <dependencies />\n  </metadata>\n</package>\n"
}
// Rust: Source/Publish/ForeignPackage.rs:2393
fn registry_endpoint(registry: ForeignRegistry) -> String Err! {
    specific :: if registry == { .PyPi -> "JET_PYPI_URL", .Npm -> "JET_NPM_REGISTRY", .Maven -> "JET_MAVEN_URL", .NuGet -> "JET_NUGET_SOURCE" }
    endpoint :: env.var(specific).ok().filter(value -> !value.trim().is_empty())
        .or_else(() -> env.var("JET_FOREIGN_REGISTRY_URL").ok().filter(value -> !value.trim().is_empty()))
        .ok_or_else(() -> "foreign {registry.as_str()} publication needs {specific} or JET_FOREIGN_REGISTRY_URL; use file:///absolute/path for offline publication")?
    if endpoint.chars().any(ch -> ch.is_control() || ch.is_whitespace()) -> return Err("foreign registry endpoint contains whitespace or control characters")
    if endpoint.contains('@') -> return Err("foreign registry endpoint must not contain embedded credentials; use the registry credential helper")
    if endpoint.strip_prefix("file://") is directory {
        if directory.is_empty() || !OSPath.new(directory).is_absolute() -> return Err("file registry endpoint must name an absolute path")
        return Ok(endpoint)
    }
    if endpoint.starts_with("https://") || endpoint.starts_with("http://") -> return Ok(endpoint)
    Err("foreign registry endpoint must use http(s):// or file://")
}
// Rust: Source/Publish/ForeignPackage.rs:2440
fn publish_archive(registry: ForeignRegistry, endpoint: String, report: ForeignPublishReport) -> Unit Err! {
    bytes :: read_regular_file(report.artifact, "foreign package")?
    digest :: "sha256-{jet.SHA256.sha256_hex(bytes)}"
    if digest != report.artifact_digest -> return Err("foreign package changed after validation; refusing publication")
    if endpoint.strip_prefix("file://") is directory -> return publish_to_file_registry(directory, report.artifact, bytes)
    command := if registry == {
        .PyPi -> {
            command := Command.new("twine")
            &command.args(["upload", "--repository-url", endpoint]).arg(report.artifact)
            command
        }
        .Npm -> {
            command := Command.new("npm")
            &command.args(["publish", "--registry", endpoint, "--ignore-scripts"]).arg(report.artifact)
            command
        }
        .Maven -> {
            command := Command.new("mvn")
            artifact_id :: report.artifact.file_name().and_then(value -> value.to_str()).unwrap_or("jet-library").strip_suffix(".jar").unwrap_or("jet-library")
            &command.args(["deploy:deploy-file", "-B", "-DgeneratePom=false", "-DrepositoryId=jet"])
                .arg("-Durl={endpoint}").arg("-Dfile={report.artifact.display()}").arg("-DartifactId={artifact_id}").arg("-DgroupId=dev.jet")
            command
        }
        .NuGet -> {
            command := Command.new("dotnet")
            &command.args(["nuget", "push", "--source", endpoint]).arg(report.artifact)
            command
        }
    }
    run_host_tool(&command, registry.as_str())
}
// Rust: Source/Publish/ForeignPackage.rs:2497
fn publish_to_file_registry(directory: String, artifact: OSPath, bytes: [U8]) -> Unit Err! {
    root :: OSPath.new(directory)
    if fs.symlink_metadata(root) is Ok(metadata) {
        if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("file registry '{root.display()}' is not a real directory")
    } else {
        fs.create_dir_all(root).map_err(error -> "could not create file registry '{root.display()}': {error}")?
    }
    name :: artifact.file_name().ok_or_else(() -> "foreign artifact has no file name")?
    destination :: root.join(name)
    if fs.symlink_metadata(destination).is_ok() -> return Err("foreign registry already contains version artifact '{name.to_string_lossy()}'")
    write_atomic(destination, bytes)
}
