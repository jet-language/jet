// PORT-PENDING 0828 source-publish-mod: Source/Publish/mod.rs:1-867
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! E2-M8 — packages and enterprise supply chain.
//RS //!
//RS //! Owns:
//RS //!   - SemVer parsing and comparison (no external crates, I6).
//RS //!   - Public API extraction from parsed Jet AST items.
//RS //!   - API diff → E2601 (breaking change under non-breaking version bump).
//RS //!   - PubGrub-style conflict detection → E2602.
//RS //!   - Signed advisory feed and policy check → E2603/E2609/E2610.
//RS //!   - Artifact integrity verification → E2604.
//RS //!   - Deterministic SBOM emission and OCI referrer evidence for registry
//RS //!     publication (SBOM, signature, provenance, reproducibility).
//RS //!   - `jet registry vendor` (copy resolved deps into a `vendor/` tree).
//RS //!   - Private / mirror registry configuration.
//RS 
//RS mod API;
//RS pub mod Advisory;
//RS // ApiFreeze: pure sema types from Sema::ApiFreeze; driver-level write_api_snapshot_for_entry
//RS // lives in Publish/ApiFreeze.rs which re-exports the pure items and adds the loader call.
