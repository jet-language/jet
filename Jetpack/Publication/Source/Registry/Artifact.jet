// Registry source objects use every visible regular file, including registry.json.
// SourceStore's held tree hash has exactly this path/NUL/u64be/content wire form.
fn publication_artifact_path(repo: String, name: String, version: String) -> String IOError! {
    publication_validate_index_component(name, "package name")
    publication_validate_index_component(version, "package version")
    Ok(files.join(files.join(files.join(repo, "artifacts"), name), version))
}
fn publication_ensure_real_directory(path: String, label: String) IOError! -[FS, Env]> {
    info :: files.stat(path)
    if info.is_symlink || !info.is_dir -> return Err(publication_read_error(.InvalidInput, path, "{label} is not a real directory"))
    _ :: foundation_open_directory_authority(path)
}
fn publication_load_publish_lock(source: String) -[FS, Env]> LockFile? IOError! {
    bytes :: foundation_read_file_nofollow_at_root(source, UNIFIED_LOCK_FILE, PKG_MAX_LOCK_BYTES) ?? {
        if err == .NotFound(_) -> return Ok(None)
        return Err(err)
    }
    text :: String.from_bytes(bytes) ?? return Err(publication_invalid_oci("published lock is not UTF-8"))
    parsed :: pkg_lock_parse(text) ?? return Err(publication_invalid_oci("published lock is invalid: {err.message()}"))
    Ok(Val(parsed))
}
fn publication_registry_artifact_hash(root: String) -[FS, Env]> String IOError! {
    held :: foundation_open_directory_authority(root)
    held.tree_hash()
}
struct PublicationArtifactSnapshot {
    source: PackageSourceSnapshot
    fn path(self) -> String Never! { self.source.path() }
}
impl PublicationArtifactSnapshot.Close {
    fn close(^self) -[FS]> { close(^self.source) }
}
fn publication_snapshot_verified_artifact(repo: String, entry: PublicationIndexEntry) -[FS, Env, Time]> PublicationArtifactSnapshot IOError! {
    path :: publication_artifact_path(repo, entry.name, entry.version)
    held :: foundation_open_directory_authority(repo)
    artifacts :: held.child("artifacts")
    package :: artifacts.child(entry.name)
    source :: package.child(entry.version)
    before :: source.tree_hash()
    if entry.content_hash != "" && before != entry.content_hash -> return Err(publication_invalid_oci("registry source artifact for {entry.name} {entry.version} failed its content hash"))
    publication_verify_oci_referrers(repo, entry)
    // Keep the private snapshot on the checkout's disk rather than /tmp.
    snapshot :: pkg_source_snapshot_into(source, ^held) ?? return Err(publication_invalid_oci(err.diagnostic.what))
    if entry.content_hash != "" && snapshot.content_hash != entry.content_hash {
        close(^snapshot)
        return Err(publication_invalid_oci("registry source artifact for {entry.name} {entry.version} changed while being snapshotted"))
    }
    // The machine lock is published evidence, not part of the source digest.
    if publication_load_publish_lock(path) == {
        .Val(lock) -> {
            foundation_write_file_nofollow_at_root(snapshot.path(), UNIFIED_LOCK_FILE, pkg_lock_write(lock).bytes(), None) ?? {
                close(^snapshot)
                return Err(err.error)
            }
        }
        .None -> {}
        .Err(error) -> {
            close(^snapshot)
            return Err(error)
        }
    }
    Ok(PublicationArtifactSnapshot{source: snapshot})
}

// e576819c1 (Source/Publish/Registry.rs:1447-1502,1524-1669,2241-2395) over the
// held-authority artifact store: the source is snapshotted once, its registry
// metadata and expected hash are checked on that snapshot, and the artifact is
// staged in a private sibling, re-hashed and renamed into place. An existing
// artifact must hold the same bytes. A failure removes the stage and any OCI
// referrer state this publish created.
fn publication_ensure_real_directory_if_present(path: String, label: String) IOError! -[FS, Env]> {
    if files.stat(path) == {
        .Ok(_) -> publication_ensure_real_directory(path, label)
        .Err(error) -> if error == {
            .NotFound(_) -> {}
            else -> { return Err(error) }
        }
    }
}
fn publication_publish_artifact(repo: String, source: String, name: String, version: String, expected_hash: String) -[FS, Env, Time]> String IOError! {
    destination :: publication_artifact_path(repo, name, version)
    publication_ensure_real_directory(repo, "registry checkout")
    held :: foundation_open_directory_authority(repo)
    snapshot :: pkg_source_snapshot_into(foundation_open_directory_authority(source), ^held) ?? return Err(publication_invalid_oci(err.diagnostic.what))
    result :: publication_publish_snapshot(repo, snapshot.parent, source, snapshot.directory, snapshot.content_hash, name, version, expected_hash, destination)
    close(^snapshot)
    result
}
fn publication_publish_snapshot(repo: String, held: FoundationDirectoryAuthority, source: String, snapshot: FoundationDirectoryAuthority, actual: String, name: String, version: String, expected_hash: String, destination: String) -[FS, Env, Time]> String IOError! {
    publication_validate_registry_metadata_file(snapshot.path(), name, version)
    if expected_hash != "" && actual != expected_hash -> return Err(publication_read_error(.InvalidInput, source, "registry source hash changed during publish: expected {expected_hash}, got {actual}"))
    publication_ensure_real_directory_if_present(files.join(repo, "artifacts"), "registry artifact root")
    publication_ensure_real_directory_if_present(files.dirname(destination), "registry artifact package directory")
    package :: held.child("artifacts", true).child(name, true)
    if package.child(version) == {
        .Ok(existing) -> {
            if existing.tree_hash() != actual -> return Err(publication_read_error(.AlreadyExists, destination, "registry artifact already exists with conflicting source bytes"))
            publication_stage_oci_sbom(repo, source, name, version, actual)
            publication_finalize_oci_referrers_for_package(repo, name, version)
            return Ok(destination)
        }
        .Err(error) -> if error == {
            .NotFound(_) -> {}
            else -> { return Err(error) }
        }
    }
    subject_root :: files.join(files.join(repo, "referrers"), actual)
    subject_root_existed :: files.stat(subject_root) == .Ok(_)
    pending :: files.join(subject_root, PUBLICATION_OCI_PENDING_SBOM)
    pending_existed :: files.stat(pending) == .Ok(_)
    stage :: package.private_child("artifact")
    stage_name :: files.basename(stage.path())
    published := false
    failure := IOError?{None}
    if publication_publish_stage(repo, source, name, version, actual, stage, snapshot) == .Err(stage_error) {
        failure = Val(stage_error)
    } else if package.rename(stage_name, version) == .Err(rename_error) {
        failure = Val(rename_error)
    } else {
        published = true
        if publication_finalize_oci_referrers_for_package(repo, name, version) == .Err(finalize_error) -> failure = Val(finalize_error)
    }
    if failure == .Val(error) {
        if !published -> package.remove_tree(stage_name).drop("publish rollback preserves the primary error")
        if !pending_existed -> files.remove(pending).drop("publish rollback preserves the primary error")
        if published && !subject_root_existed -> package.remove_tree(version).drop("publish rollback preserves the primary error")
        if !subject_root_existed -> files.remove_all(subject_root).drop("publish rollback preserves the primary error")
        return Err(error)
    }
    Ok(destination)
}
fn publication_publish_stage(repo: String, source: String, name: String, version: String, actual: String, stage: FoundationDirectoryAuthority, snapshot: FoundationDirectoryAuthority) IOError! -[FS, Env, Time]> {
    publication_stage_oci_sbom(repo, source, name, version, actual)
    stage.copy_tree_from(snapshot)
    if stage.tree_hash() != actual -> return Err(publication_read_error(.InvalidInput, stage.path(), "staged registry artifact does not match its source hash"))
    // The machine lock is published evidence beside, not inside, the digest.
    if publication_load_publish_lock(source) == .Val(lock) {
        foundation_write_file_nofollow_at_root(stage.path(), UNIFIED_LOCK_FILE, pkg_lock_write(lock).bytes(), None) ?? return Err(err.error)
    }
}
fn publication_verify_artifact(repo: String, entry: PublicationIndexEntry) -[FS, Env]> String IOError! {
    path :: publication_artifact_path(repo, entry.name, entry.version)
    publication_ensure_real_directory_if_present(repo, "registry checkout")
    publication_ensure_real_directory_if_present(files.join(repo, "artifacts"), "registry artifact root")
    publication_ensure_real_directory_if_present(files.dirname(path), "registry artifact package directory")
    info :: files.stat(path) ?? {
        if err == .NotFound(_) -> return Err(publication_read_error(.NotFound, path, "registry has no source artifact for {entry.name} {entry.version}"))
        return Err(err)
    }
    if info.is_symlink || !info.is_dir -> return Err(publication_read_error(.NotFound, path, "registry has no source artifact for {entry.name} {entry.version}"))
    if entry.content_hash != "" && publication_registry_artifact_hash(path) != entry.content_hash -> return Err(publication_read_error(.InvalidInput, path, "registry source artifact for {entry.name} {entry.version} failed its content hash"))
    publication_verify_oci_referrers(repo, entry)
    Ok(path)
}
