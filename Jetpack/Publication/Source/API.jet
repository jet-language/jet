//RS /// An item in a package's public API. Two `ApiItem`s are "compatible" when they
//RS /// have the same `kind`, `name`, and `signature` (a textual canonical form).
//RS /// We store the signature as a string because full AST comparison is brittle;
//RS /// the canonical form gives false-negative safety (we might miss a breaking
//RS /// change in a complex generic; that is acceptable for v1).
//RS #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
//RS pub struct ApiItem {
//RS     /// "fn", "struct", "enum", "trait", "const"
//RS     pub kind: String,
//RS     pub name: String,
//RS     /// Textual canonical form of the signature (param/field types, return type).
//RS     /// Does not include the body. Whitespace-normalised.
//RS     pub signature: String,
//RS }
