// Rust: Source/Publish/API.rs:1
// Public API surface extraction; signatures omit bodies and retain canonical types.
use jet.AST
use jet.Loader
use jet.Sema
use jet.Sema.ApiFreeze
use jet.Syntax

// Rust: Source/Publish/API.rs:11
#Derive(Debug, Clone, Eq, Ord)
pub struct ApiItem {
    pub kind: String
    pub name: String
    pub signature: String
}
// Rust: Source/Publish/API.rs:22
pub fn extract_public_api(src: String, file: String) -> [ApiItem] {
    package :: Loader.package_facts_for_entry(OSPath.from(file)).ok().flatten()
        .map(manifest -> manifest.name).unwrap_or_else(() -> "package")
    extract_public_api_for_package(src, file, package)
}
// Rust: Source/Publish/API.rs:33
pub fn extract_public_api_for_package(src: String, file: String, package: String) -> [ApiItem] {
    bundle := Loader.load_entry_with_overlay(file, None, true) ?? return []
    (_, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check)
    // src is not reparsed: the canonical loaded bundle is the source of truth.
    out := [ApiItem]{}
    entry :: bundle.modules[bundle.entry]
    dimensions := ApiFreeze.ApiUnitDimensions.new()
    ApiFreeze.collect_api_unit_dimensions(entry.items, package, &dimensions)
    collect_public_api(entry.items, bundle.entry, facts.name_ledger.module_alias(bundle.entry).unwrap_or(entry.alias),
        None, None, facts.solved, facts.name_ledger, dimensions, &out)
    &out.sort()
    out
}
// Rust: Source/Publish/API.rs:67
fn collect_public_api(items: [AST.Item], module_idx: Int, module_alias: String, semantic_module: String?,
    display_module: String?, solved: [String:Sema.EffectSet], ledger: AST.NameLedger,
    dimensions: ApiFreeze.ApiUnitDimensions, out: &[ApiItem]) -> {
    loop item in items {
        if public_api_of_item(item, module_idx, module_alias, semantic_module, display_module, solved, ledger, dimensions) == .Val(api) {
            &out.push(api)
        }
        if item == .Trait(trait_def) {
            trait_name :: semantic_module.map(module -> AST.member_name(module, trait_def.name)).unwrap_or_else(() -> trait_def.name.clone())
            if ledger.public(module_idx, trait_name) {
                loop method in trait_def.methods {
                    if !supported_public_name(method.name) -> continue
                    &out.push(ApiItem{kind: "fn", name: public_item_name(display_module, "{trait_def.name}.{method.name}"),
                        signature: ApiFreeze.qualify_api_signature(display_module,
                            ApiFreeze.trait_method_signature(trait_def.name, method, dimensions))})
                }
            }
        }
        if item == .CodeModule(module) {
            if module.body == .Val(body) {
                nested_semantic_module :: semantic_module.map(parent -> AST.member_name(parent, module.name)).unwrap_or_else(() -> module.name.clone())
                nested_display_module :: display_module.map(parent -> "{parent}.{module.name}").unwrap_or_else(() -> module.name.clone())
                collect_public_api(body, module_idx, module_alias, Val(nested_semantic_module), Val(nested_display_module), solved, ledger, dimensions, &out)
            }
        }
    }
}
// Rust: Source/Publish/API.rs:143
fn public_item_name(code_module: String?, name: String) -> String {
    code_module.map(module -> "{module}.{name}").unwrap_or_else(() -> name.to_string())
}
// Rust: Source/Publish/API.rs:150
fn public_api_of_item(item: AST.Item, module_idx: Int, module_alias: String, semantic_module: String?,
    display_module: String?, solved: [String:Sema.EffectSet], ledger: AST.NameLedger,
    dimensions: ApiFreeze.ApiUnitDimensions) -> ApiItem? {
    if item == {
        .Func(f) -> {
            if !supported_public_name(f.name) -> return None
            ledger_name :: semantic_module.map(module -> AST.member_name(module, f.name)).unwrap_or_else(() -> f.name.clone())
            if !ledger.public(module_idx, ledger_name) -> return None
            signature :: format_fn_sig(f, solved.get("{module_alias}::{ledger_name}").or_else(() -> solved.get(f.name)), dimensions)
            Val(ApiItem{kind: "fn", name: public_item_name(display_module, f.name),
                signature: ApiFreeze.qualify_api_signature(display_module, signature)})
        }
        .Struct(s) -> {
            if !supported_public_name(s.name) -> return None
            ledger_name :: semantic_module.map(module -> AST.member_name(module, s.name)).unwrap_or_else(() -> s.name.clone())
            if !ledger.public(module_idx, ledger_name) -> return None
            Val(ApiItem{kind: "struct", name: public_item_name(display_module, s.name), signature: format_struct_sig(s, dimensions)})
        }
        .Enum(e) -> {
            if !supported_public_name(e.name) -> return None
            ledger_name :: semantic_module.map(module -> AST.member_name(module, e.name)).unwrap_or_else(() -> e.name.clone())
            if !ledger.public(module_idx, ledger_name) -> return None
            Val(ApiItem{kind: "enum", name: public_item_name(display_module, e.name), signature: format_enum_sig(e)})
        }
        .Trait(t) -> {
            if !supported_public_name(t.name) -> return None
            ledger_name :: semantic_module.map(module -> AST.member_name(module, t.name)).unwrap_or_else(() -> t.name.clone())
            if !ledger.public(module_idx, ledger_name) -> return None
            Val(ApiItem{kind: "trait", name: public_item_name(display_module, t.name), signature: format_trait_sig(t, dimensions)})
        }
        // ConstDef lacks public visibility in this reference AST; sema enforces use sites.
        .Const(_) -> None
        else -> None
    }
}
// Rust: Source/Publish/API.rs:228
fn supported_public_name(name: String) -> Bool {
    Syntax.classify_identifier(name) == Syntax.IdentifierClass.Ordinary
}
// Rust: Source/Publish/API.rs:232
fn format_fn_sig(f: AST.Func, inferred: Sema.EffectSet?, dimensions: ApiFreeze.ApiUnitDimensions) -> String {
    ApiFreeze.canonical_fn_signature_with_effects(f, inferred, dimensions)
}
// Rust: Source/Publish/API.rs:240
fn format_struct_sig(s: AST.StructDef, dimensions: ApiFreeze.ApiUnitDimensions) -> String {
    is_cli :: s.derives.iter().any(pair -> pair.0 == Syntax.MARKER_CLI)
    positional_order := U16{0}
    fields := [String]{}
    loop f in s.fields {
        if !supported_public_name(f.name) -> continue
        ty :: ApiFreeze.canonical_api_type_name(f.ty, dimensions)
        if !is_cli {
            &fields.push("{f.name}: {ty}")
            continue
        }
        // Positional order, Flag opt-outs and typed-value defaults are public CLI shape.
        flag_only :: f.serde_markers.iter().any(m -> m.name == Syntax.MARKER_FLAG)
        has_default :: f.default.is_some()
        is_bool :: if f.ty == { .Bool -> true, else -> false }
        is_optional :: if f.ty == { .Option(_) -> true, else -> false }
        if !is_bool && !is_optional && !has_default && !flag_only {
            order :: positional_order
            positional_order = positional_order.saturating_add(U16{1})
            &fields.push("{f.name}: {ty} [positional {order}]")
        } else if flag_only {
            &fields.push("{f.name}: {ty} [flag]")
        } else {
            &fields.push("{f.name}: {ty}")
        }
    }
    "struct {s.name} {{ {fields.join("; ")} }}"
}
// Rust: Source/Publish/API.rs:285
fn format_enum_sig(e: AST.EnumDef) -> String {
    variants :: e.variants.iter().filter(v -> supported_public_name(v.name)).map(v -> v.name.clone()).collect()
    "enum {e.name} {{ {variants.join(", ")} }}"
}
// Rust: Source/Publish/API.rs:295
fn format_trait_sig(t: AST.TraitDef, dimensions: ApiFreeze.ApiUnitDimensions) -> String {
    methods :: t.methods.iter().filter(method -> supported_public_name(method.name))
        .map(method -> ApiFreeze.trait_method_signature(t.name, method, dimensions)).collect()
    "trait {t.name} {{ {methods.join(", ")} }}"
}
