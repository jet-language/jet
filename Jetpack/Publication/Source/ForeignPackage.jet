// Rust: Source/Publish/ForeignPackage.rs:23
#Derive(Debug, Clone, Eq, Ord)
pub enum ForeignRegistry { PyPi, Npm, Maven, NuGet }
impl ForeignRegistry {
    // Rust: Source/Publish/ForeignPackage.rs:32
    pub fn parse(value: String) -> ForeignRegistry Err! {
        trimmed := value.trim() // #4303
        if trimmed.to_ascii_lowercase() == {
            "pypi" | "python" | "python-wheel" -> Ok(.PyPi)
            "npm" | "node" -> Ok(.Npm)
            "maven" | "maven-central" | "jvm" -> Ok(.Maven)
            "nuget" | "dotnet" | ".net" -> Ok(.NuGet)
            else -> Err("unsupported foreign registry '{value}'; choose pypi, npm, maven, or nuget")
        }
    }
    // Rust: Source/Publish/ForeignPackage.rs:44
    pub fn as_str(self: ForeignRegistry) -> String {
        if self == { .PyPi -> "pypi", .Npm -> "npm", .Maven -> "maven", .NuGet -> "nuget" }
    }
}
