fn json_string(value: String) -> String {
    out := String.with_capacity(value.len() + 2)
    &out.push('"')
    loop ch in value.chars() {
        if ch == {
            '"' -> &out.push_str("\\\"")
            '\\' -> &out.push_str("\\\\")
            '\u{08}' -> &out.push_str("\\b")
            '\u{0c}' -> &out.push_str("\\f")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            '\t' -> &out.push_str("\\t")
            else -> {
                if ch.is_control() { scalar :: U32.from(ch); &out.push_str("\\u{scalar:04x}") }
                else { &out.push(ch) }
            }
        }
    }
    &out.push('"')
    out
}
