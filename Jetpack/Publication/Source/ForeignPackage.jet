fn render_abi_json(stamp: JetLibStamp) -> String {
    exports :: stamp.exports.iter().map(export -> render_export_json(export)).collect().join(",")
    "{{\"schema\":{FOREIGN_SCHEMA},\"abiVersion\":{stamp.abi_version},\"abiIdentity\":{json_string(stamp.abi_identity)},\"library\":{json_string(stamp.library_name)},\"exports\":[{exports}]}}"
}
// Rust: Source/Publish/ForeignPackage.rs:522
fn render_export_json(export: JetLibExport) -> String {
    access :: export.conventions.iter().map(value -> json_string(access_name(value))).collect().join(",")
    "{{\"name\":{json_string(export.name)},\"symbol\":{json_string(export.symbol)},\"scalar\":{json_string(scalar_name(export.scalar))},\"params\":{export.params},\"access\":[{access}]}}"
}
// Rust: Source/Publish/ForeignPackage.rs:539
fn render_common_json(package_name: String, version: String, license: String, library_name: String, stamp: JetLibStamp,
    runtime_name: String, runtime: [U8], abi_digest: String, source_identity: String, release_identity: String, registry: ForeignRegistry) -> String {
    runtime_digest :: "sha256-{SHA256.sha256_hex(runtime)}"
    "{{\"schema\":{FOREIGN_SCHEMA},\"package\":{json_string(package_name)},\"version\":{json_string(version)},\"license\":{json_string(license)},\"library\":{json_string(library_name)},\"registry\":{json_string(registry.as_str())},\"target\":{json_string(stamp.target)},\"targetTriple\":{json_string(stamp.target_triple)},\"runtime\":{{\"name\":{json_string(runtime_name)},\"digest\":{json_string(runtime_digest)}}},\"abi\":{{\"version\":{stamp.abi_version},\"identity\":{json_string(stamp.abi_identity)},\"digest\":{json_string(abi_digest)}}},\"sourceIdentity\":{json_string(source_identity)},\"compiler\":{{\"version\":{json_string(stamp.compiler_version)},\"build\":{json_string(stamp.compiler_build)},\"linker\":{json_string(stamp.linker_identity)}}},\"dependencies\":[],\"releaseIdentity\":{json_string(release_identity)}}}"
}
// Rust: Source/Publish/ForeignPackage.rs:574
fn render_provenance_json(package_name: String, version: String, library_name: String, stamp: JetLibStamp,
    runtime_name: String, runtime: [U8], abi_digest: String, source_identity: String, release_identity: String, registry: ForeignRegistry) -> String {
    runtime_digest :: "sha256-{SHA256.sha256_hex(runtime)}"
    "{{\"schema\":\"jet.provenance/v1\",\"subject\":{{\"package\":{json_string(package_name)},\"version\":{json_string(version)},\"library\":{json_string(library_name)},\"releaseIdentity\":{json_string(release_identity)}}},\"source\":{{\"identity\":{json_string(source_identity)},\"packageFile\":\"package.jet\"}},\"build\":{{\"compilerVersion\":{json_string(stamp.compiler_version)},\"compilerBuild\":{json_string(stamp.compiler_build)},\"target\":{json_string(stamp.target)},\"targetTriple\":{json_string(stamp.target_triple)},\"linker\":{json_string(stamp.linker_identity)}}},\"abi\":{{\"identity\":{json_string(stamp.abi_identity)},\"digest\":{json_string(abi_digest)}}},\"runtime\":{{\"name\":{json_string(runtime_name)},\"digest\":{json_string(runtime_digest)}}},\"registry\":{json_string(registry.as_str())},\"parameters\":{{\"dependencies\":[],\"deterministic\":true}}}}"
}
// Rust: Source/Publish/ForeignPackage.rs:606
fn render_sbom(package_name: String, version: String, license: String, runtime_name: String, runtime: [U8],
    stamp: JetLibStamp, abi_digest: String, source_identity: String) -> String {
    runtime_digest :: SHA256.sha256_hex(runtime)
    "SPDXVersion: SPDX-2.3\nDataLicense: CC0-1.0\nSPDXID: SPDXRef-DOCUMENT\nDocumentName: jet-foreign-{package_name}-{version}\nDocumentNamespace: https://jet-lang.dev/sbom/{source_identity}\nCreator: Tool: jet\nPackageName: {package_name}\nSPDXID: SPDXRef-Package\nPackageVersion: {version}\nPackageLicenseDeclared: {license}\nPackageSupplier: Organization: Jet package publisher\nPackageDownloadLocation: NOASSERTION\nExternalRef: PACKAGE-MANAGER jet-release {source_identity}\nFileName: {runtime_name}\nFileChecksum: SHA256: {runtime_digest}\nPackageComment: ABI {abi_digest}\nCompilerTarget: {stamp.target}\n"
}
// Rust: Source/Publish/ForeignPackage.rs:623
fn signature_metadata(registry: ForeignRegistry, release_identity: String, no_sign: Bool) -> String Err! {
    if no_sign -> return Ok("{{\"schema\":\"jet.signature/v1\",\"identity\":{json_string(release_identity)},\"algorithm\":\"none\",\"signature\":null,\"publicKey\":null}}")
    key_name :: "foreign-release"
    (seed, public_key) :: if Publish.Sign.key_exists(key_name) {
        (seed, _) :: Publish.Sign.key_paths(key_name)
        public_key :: Publish.Sign.read_public_key(key_name).ok_or_else(() -> "foreign registry signing key has no public key")?
        (seed, public_key)
    } else {
        (seed, _, public_key) :: Publish.Sign.keygen(key_name, false).map_err(error -> "could not create the foreign registry signing key: {error:?}")?
        (seed, public_key)
    }
    signature :: Publish.Sign.sign(seed, release_identity).map_err(error -> "could not sign the foreign release: {error:?}")?
    Ok("{{\"schema\":\"jet.signature/v1\",\"identity\":{json_string(release_identity)},\"algorithm\":\"ed25519\",\"signature\":{json_string(signature)},\"publicKey\":{json_string(public_key)}}}")
}
// Rust: Source/Publish/ForeignPackage.rs:659
fn render_archive(registry: ForeignRegistry, input: LibraryInput) -> [U8] Err! {
    entries :: if registry == { .PyPi -> python_entries(input)?, .Npm -> npm_entries(input)?,
        .Maven -> maven_entries(input)?, .NuGet -> nuget_entries(input)? }
    if registry == .Npm { tar_gz(entries) } else { zip(entries) }
}
// Rust: Source/Publish/ForeignPackage.rs:672
fn python_entries(input: LibraryInput) -> [ArchiveEntry] Err! {
    distribution :: python_distribution(input.package_name)
    module :: python_module(input.package_name)
    version :: input.version.replace('-', "_")
    dist_info :: "{distribution}-{version}.dist-info"
    entries := [
        ArchiveEntry{name: "{module}/__init__.py", bytes: render_python(input).into_bytes()},
        ArchiveEntry{name: "{module}/py.typed", bytes: []},
        ArchiveEntry{name: "{module}/lib/{input.runtime_name}", bytes: input.runtime.clone()},
        ArchiveEntry{name: "{module}/jet-abi.json", bytes: input.abi_json.as_bytes().to_vec()},
        ArchiveEntry{name: "{module}/jet-release.json", bytes: input.common_json.as_bytes().to_vec()},
        ArchiveEntry{name: "{module}/jet-provenance.json", bytes: input.provenance_json.as_bytes().to_vec()},
        ArchiveEntry{name: "{module}/jet-sbom.spdx", bytes: input.sbom.as_bytes().to_vec()},
        ArchiveEntry{name: "{module}/jet-signature.json", bytes: input.signature_json.as_bytes().to_vec()},
        ArchiveEntry{name: "{module}/{license_file_name(input.license)}", bytes: input.license_text.as_bytes().to_vec()},
        ArchiveEntry{name: "{dist_info}/METADATA", bytes: "Metadata-Version: 2.1\nName: {distribution}\nVersion: {input.version}\nSummary: Jet foreign library\nLicense: {input.license}\nRequires-Python: >=3.9\n\n{first_minute_python(module)}".into_bytes()},
        ArchiveEntry{name: "{dist_info}/WHEEL", bytes: "Wheel-Version: 1.0\nGenerator: jet\nRoot-Is-Purelib: false\nTag: py3-none-{python_platform()}\n".into_bytes()}
    ]
    record :: render_python_record(entries, dist_info)
    &entries.push(ArchiveEntry{name: "{dist_info}/RECORD", bytes: record.into_bytes()})
    Ok(entries)
}
// Rust: Source/Publish/ForeignPackage.rs:743
fn npm_entries(input: LibraryInput) -> [ArchiveEntry] Err! {
    package_name :: npm_package_name(input.package_name)
    addon :: "{library_stem(input.library_name)}.node"
    platform :: "{node_platform()}-{target.selected_arch()}"
    addon_bytes :: build_node_addon(input, addon)?
    package_json :: "{{\n  \"name\": {json_string(package_name)},\n  \"version\": {json_string(input.version)},\n  \"description\": \"Jet native library\",\n  \"main\": \"index.js\",\n  \"license\": {json_string(input.license)},\n  \"os\": [{json_string(node_platform())}],\n  \"cpu\": [{json_string(target.selected_arch())}],\n  \"engines\": {{\"node\": \">=18\"}},\n  \"jet\": {{\"releaseIdentity\": {json_string(input.release_identity)}, \"abiDigest\": {json_string(input.abi_digest)}, \"sourceIdentity\": {json_string(input.source_identity)}}}\n}}\n"
    Ok([
        ArchiveEntry{name: "package/package.json", bytes: package_json.into_bytes()},
        ArchiveEntry{name: "package/index.js", bytes: render_node_index(addon).into_bytes()},
        ArchiveEntry{name: "package/native/{platform}/{addon}", bytes: addon_bytes},
        ArchiveEntry{name: "package/native/{platform}/{input.runtime_name}", bytes: input.runtime.clone()},
        ArchiveEntry{name: "package/jet-abi.json", bytes: input.abi_json.as_bytes().to_vec()},
        ArchiveEntry{name: "package/jet-release.json", bytes: input.common_json.as_bytes().to_vec()},
        ArchiveEntry{name: "package/jet-provenance.json", bytes: input.provenance_json.as_bytes().to_vec()},
        ArchiveEntry{name: "package/jet-sbom.spdx", bytes: input.sbom.as_bytes().to_vec()},
        ArchiveEntry{name: "package/jet-signature.json", bytes: input.signature_json.as_bytes().to_vec()},
        ArchiveEntry{name: "package/{license_file_name(input.license)}", bytes: input.license_text.as_bytes().to_vec()},
        ArchiveEntry{name: "package/README.md", bytes: first_minute_node(package_name).into_bytes()}
    ])
}
// Rust: Source/Publish/ForeignPackage.rs:807
fn maven_entries(input: LibraryInput) -> [ArchiveEntry] Err! {
    package :: java_package(input.package_name)
    class_name :: java_class_name(input.library_name)
    package_dir :: package.replace('.', "/")
    class_dir :: "{package_dir}/{class_name}"
    jni_name :: "libjet_{library_stem(input.library_name)}_jni.{shared_extension()}"
    class_bytes :: build_java_classes(input, package, class_name, jni_name)?
    jni_bytes :: build_jni_bridge(input, package, class_name, jni_name)?
    artifact :: "{java_artifact(input.package_name)}-{input.version}"
    pom :: render_pom(input, artifact)
    Ok([
        ArchiveEntry{name: "META-INF/MANIFEST.MF", bytes: "Manifest-Version: 1.0\nCreated-By: jet\n\n".bytes()},
        ArchiveEntry{name: "{class_dir}.class", bytes: class_bytes},
        ArchiveEntry{name: "META-INF/native/{shared_platform()}/{jni_name}", bytes: jni_bytes},
        ArchiveEntry{name: "META-INF/native/{shared_platform()}/{input.runtime_name}", bytes: input.runtime.clone()},
        ArchiveEntry{name: "META-INF/maven/dev.jet/{artifact}/pom.xml", bytes: pom.clone().into_bytes()},
        ArchiveEntry{name: "META-INF/maven/dev.jet/{artifact}/pom.properties", bytes: "groupId=dev.jet\nartifactId={artifact}\nversion={input.version}\n".into_bytes()},
        ArchiveEntry{name: "META-INF/jet-abi.json", bytes: input.abi_json.as_bytes().to_vec()},
        ArchiveEntry{name: "META-INF/jet-release.json", bytes: input.common_json.as_bytes().to_vec()},
        ArchiveEntry{name: "META-INF/jet-provenance.json", bytes: input.provenance_json.as_bytes().to_vec()},
        ArchiveEntry{name: "META-INF/jet-sbom.spdx", bytes: input.sbom.as_bytes().to_vec()},
        ArchiveEntry{name: "META-INF/jet-signature.json", bytes: input.signature_json.as_bytes().to_vec()},
        ArchiveEntry{name: "META-INF/{license_file_name(input.license)}", bytes: input.license_text.as_bytes().to_vec()}
    ])
}
// Rust: Source/Publish/ForeignPackage.rs:880
fn nuget_entries(input: LibraryInput) -> [ArchiveEntry] Err! {
    package :: nuget_package_name(input.package_name)
    assembly :: "{package}.dll"
    assembly_bytes :: build_dotnet_assembly(input, package)?
