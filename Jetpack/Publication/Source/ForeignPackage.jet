// Rust: Source/Publish/ForeignPackage.rs:98
pub fn build_foreign_package(root: OSPath, registry: ForeignRegistry, no_sign: Bool) -> ForeignPublishReport Err! {
    input :: prepare_library(root, registry, no_sign)?
    archive :: render_archive(registry, input)?
    digest :: "sha256-{SHA256.sha256_hex(archive)}"
    output_dir :: foreign_output_dir(root)?
    artifact :: output_dir.join(artifact_file_name(registry, input))
    write_atomic(artifact, archive)?
    Ok(ForeignPublishReport{registry: registry, artifact: artifact, artifact_digest: digest,
        release_identity: input.release_identity, uploaded: false})
}
// Rust: Source/Publish/ForeignPackage.rs:121
pub fn publish_foreign_package(root: OSPath, options: ForeignPublishOptions) -> ForeignPublishReport Err! {
    report := build_foreign_package(root, options.registry, options.no_sign)?
    endpoint :: registry_endpoint(options.registry)?
    publish_archive(options.registry, endpoint, report)?
    report.uploaded = true
    Ok(report)
}
// Rust: Source/Publish/ForeignPackage.rs:134
fn prepare_library(root: OSPath, registry: ForeignRegistry, no_sign: Bool) -> LibraryInput Err! {
    facts :: Loader.package_facts_for_root(root).map_err(diagnostics ->
        diagnostics.into_iter().map(diagnostic -> "{diagnostic:?}").collect().join("; "))?
        .ok_or_else(() -> "no package source found in the publish root")?
    package_name :: facts.name.clone()
    version :: facts.version.clone().ok_or_else(() -> "package source has no package version")?
    license :: facts.license.clone().ok_or_else(() -> "package source has no SPDX license")?
    Publish.validate_published_license(package_name, version, Val(license)).map_err(error -> error.detail)?
    libraries :: facts.outputs.iter().filter(pair -> pair.1.kind == Package.PackageOutputKind.Library).collect()
    if libraries.is_empty() -> return Err("foreign publication needs one Library output")
    if libraries.len() != 1 {
        names :: libraries.iter().map(pair -> pair.0).collect().join(", ")
        return Err("foreign publication needs one Library output; found {names}")
    }
    (output_key, output) :: libraries[0]
    if !output.is_native() || !output.is_loadable() -> return Err("Library output '{output_key}' must set native: true and loadable: true for foreign publication")
    library_name :: output.name.clone()
    entry :: output.entry.clone().ok_or_else(() -> "Library output '{output_key}' has no source entry; foreign publication needs a checked entry")?
    run_library_build(root, output_key, entry)?
    stem :: library_stem(library_name)
    target_dir :: root.join(".jet").join("build")
    runtime_name :: "lib{stem}.{shared_extension()}"
    runtime_path :: target_dir.join(runtime_name)
    header_path :: target_dir.join("{stem}.h")
    jetlib_path :: target_dir.join("{stem}.jetlib")
    runtime :: read_regular_file(runtime_path, "native host runtime")?
    if runtime.is_empty() -> return Err("native host runtime '{runtime_path.display()}' is empty")
    header :: read_regular_file(header_path, "C ABI header")?
    validate_header(header, library_name, runtime_name)?
    jetlib :: read_regular_file(jetlib_path, ".jetlib ABI artifact")?
    artifact :: JetLibArtifact.decode(jetlib).map_err(error -> "could not decode '{jetlib_path.display()}': {error}")?
    JetLib.validate_load_metadata(artifact.stamp)?
    JetLib.validate_payload_digest(artifact.stamp, artifact.payload)?
    if artifact.payload != runtime -> return Err("native host runtime '{runtime_name}' does not match the sealed .jetlib payload")
    if artifact.stamp.library_name != library_name -> return Err("ABI artifact names Library '{artifact.stamp.library_name}', but the output is '{library_name}'")
    source_identity :: source_identity(root)?
    license_text :: load_license_text(root, license)?
    abi_json :: render_abi_json(artifact.stamp)
    abi_digest :: "sha256-{SHA256.sha256_hex(abi_json.as_bytes())}"
    release_identity :: release_identity(package_name, version, library_name, artifact.stamp, abi_digest, source_identity)
    signature_json :: signature_metadata(registry, release_identity, no_sign)?
    common_json :: render_common_json(package_name, version, license, library_name, artifact.stamp,
        runtime_name, runtime, abi_digest, source_identity, release_identity, registry)
    provenance_json :: render_provenance_json(package_name, version, library_name, artifact.stamp,
        runtime_name, runtime, abi_digest, source_identity, release_identity, registry)
    sbom :: render_sbom(package_name, version, license, runtime_name, runtime, artifact.stamp, abi_digest, source_identity)
    Ok(LibraryInput{root: root, package_name: package_name, version: version, license: license,
        license_text: license_text, library_name: library_name, runtime_name: runtime_name, runtime: runtime,
        header: header, stamp: artifact.stamp, abi_json: abi_json, abi_digest: abi_digest, source_identity: source_identity,
        release_identity: release_identity, common_json: common_json, provenance_json: provenance_json,
        sbom: sbom, signature_json: signature_json})
}
// Rust: Source/Publish/ForeignPackage.rs:296
fn run_library_build(root: OSPath, output: String, entry: String) -> Unit Err! {
    jet :: env.current_exe().map_err(error -> "could not locate the Jet compiler: {error}")?
    result :: Command.new(jet).current_dir(root).args(["build", "--lib", "--locked", "--output", output, entry])
        .stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null()).output()
        .map_err(error -> "could not start the Jet Library build: {error}")?
    if result.status.success() -> return Ok(())
    status :: result.status.code().map(code -> code.to_string()).unwrap_or_else(() -> "signal")
    Err("Jet Library build failed with status {status}")
}
// Rust: Source/Publish/ForeignPackage.rs:320
fn shared_extension() -> String {
    // GATE #4483: selected target, not the compiler host.
    if target.selected_os() == { "macos" -> "dylib", "windows" -> "dll", else -> "so" }
}
// Rust: Source/Publish/ForeignPackage.rs:330
fn shared_platform() -> String { "{target.selected_os()}-{target.selected_arch()}" }
// Rust: Source/Publish/ForeignPackage.rs:334
fn node_platform() -> String {
    if target.selected_os() == { "macos" -> "darwin", "windows" -> "win32", else -> target.selected_os() }
}
// Rust: Source/Publish/ForeignPackage.rs:344
fn library_stem(name: String) -> String {
    stem := name.chars().map(ch -> if ch.is_ascii_alphanumeric() || ch == '_' || ch == '-' { ch } else { '_' }).collect()
    if stem.is_empty() -> &stem.push_str("library")
    if stem.as_bytes().first().is_some_and(byte -> byte.is_ascii_digit()) -> &stem.insert(0, '_')
    stem
}
// Rust: Source/Publish/ForeignPackage.rs:364
fn read_regular_file(path: OSPath, what: String) -> [U8] Err! {
    metadata :: fs.symlink_metadata(path).map_err(error -> "missing {what} '{path.display()}': {error}")?
    if !metadata.is_file() -> return Err("{what} '{path.display()}' is not a regular file")
    fs.read(path).map_err(error -> "could not read {what} '{path.display()}': {error}")
}
// Rust: Source/Publish/ForeignPackage.rs:373
fn validate_header(header: [U8], library_name: String, runtime_name: String) -> Unit Err! {
    text :: String.from_utf8(header).map_err(_ -> "C ABI header is not UTF-8")?
    if !text.contains("jet-library-set-v1") -> return Err("C ABI header has no Jet Library set marker")
    if !text.contains("jet_text_free") && text.contains("JetText") -> return Err("C ABI header omits the JetText release function")
    runtime_stem := runtime_name.trim_start_matches("lib") // #4303
    if !text.contains(library_name) || !text.contains(runtime_stem) -> return Err("C ABI header does not identify the selected Library output")
    Ok(())
}
// Rust: Source/Publish/ForeignPackage.rs:387
fn source_identity(root: OSPath) -> String Err! {
    files := [(String, [U8])]{}
    collect_source_files(root, OSPath.from("."), &files)?
    &files.sort_by((left, right) -> left.0 <=> right.0)
    bytes := [U8]{}
    loop (relative, contents) in files {
        push_len_bytes(&bytes, relative.as_bytes())
        push_len_bytes(&bytes, contents)
    }
    Ok("sha256-{SHA256.sha256_hex(bytes)}")
}
// Rust: Source/Publish/ForeignPackage.rs:399
fn collect_source_files(root: OSPath, relative: OSPath, files: &[(String, [U8])]) -> Unit Err! {
    directory :: root.join(relative)
    entries := fs.read_dir(directory).map_err(error -> "could not read source tree '{directory.display()}': {error}")?
        .collect_result().map_err(error -> "could not enumerate source tree '{directory.display()}': {error}")?
    &entries.sort_by_key(entry -> entry.file_name())
    loop entry in entries {
        name :: entry.file_name().to_string_lossy()
        child_relative :: if relative == OSPath.from(".") { OSPath.from(name) } else { relative.join(name) }
        if child_relative.components().any(component -> if component == {
            .Normal(value) -> value == "target" || value == "vendor" || value == "build"
            else -> false
        }) -> continue
        metadata :: fs.symlink_metadata(entry.path()).map_err(error -> "could not inspect source path '{entry.path().display()}': {error}")?
        if metadata.file_type().is_symlink() -> return Err("source identity refuses symlink '{child_relative.display()}'")
        if metadata.is_dir() {
            collect_source_files(root, child_relative, &files)?
        } else if metadata.is_file() && (child_relative == OSPath.from("package.jet")
            || child_relative == OSPath.from(".jet/lock") || child_relative.extension().is_some_and(extension -> extension == "jet")) {
            slash_path :: child_relative.to_string_lossy().replace('\\', "/")
            contents :: fs.read(entry.path()).map_err(error -> "could not read source path '{entry.path().display()}': {error}")?
            &files.push((slash_path, contents))
        }
    }
    Ok(())
}
// Rust: Source/Publish/ForeignPackage.rs:473
fn release_identity(package_name: String, version: String, library_name: String, stamp: JetLibStamp, abi_digest: String, source_identity: String) -> String {
    bytes := [U8]{}
    abi_version :: stamp.abi_version.to_string()
    loop value in [package_name, version, library_name, stamp.compiler_version, stamp.compiler_build,
        stamp.target, stamp.target_triple, stamp.linker_identity, stamp.abi_identity, abi_version, abi_digest, source_identity, stamp.payload_digest] {
        push_len_bytes(&bytes, value.as_bytes())
    }
    "jet-release-v1:sha256-{SHA256.sha256_hex(bytes)}"
}
