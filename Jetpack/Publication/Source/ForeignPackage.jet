fn zip(entries: [ArchiveEntry]) -> [U8] Err! {
    files := [String:[U8]]{}
    loop entry in entries {
        validate_archive_entry(entry.name, entry.bytes.len())?
        if &files.insert(entry.name.clone(), entry.bytes).is_some() -> return Err("foreign archive repeats entry '{entry.name}'")
    }
    output := [U8]{}
    central := [U8]{}
    entry_count := 0
    loop name in files.keys().sorted() {
        bytes :: files[name]
        name_bytes :: name.as_bytes()
        name_len :: U16.try_from(name_bytes.len()).map_err(_ -> "foreign archive entry name '{name}' is too long")?
        size :: U32.try_from(bytes.len()).map_err(_ -> "foreign archive entry '{name}' is too large for ZIP")?
        offset :: U32.try_from(output.len()).map_err(_ -> "foreign ZIP is too large")?
        crc :: crc32(bytes)
        &output.extend_from_slice(U32{0x04034b50}.to_le_bytes())
        loop value in [U16{20}, U16{0}, U16{0}, U16{0}, U16{0}] -> &output.extend_from_slice(value.to_le_bytes())
        loop value in [crc, size, size] -> &output.extend_from_slice(value.to_le_bytes())
        &output.extend_from_slice(name_len.to_le_bytes())
        &output.extend_from_slice(U16{0}.to_le_bytes())
        &output.extend_from_slice(name_bytes)
        &output.extend_from_slice(bytes)
        &central.extend_from_slice(U32{0x02014b50}.to_le_bytes())
        loop value in [U16{20}, U16{20}, U16{0}, U16{0}, U16{0}, U16{0}] -> &central.extend_from_slice(value.to_le_bytes())
        loop value in [crc, size, size] -> &central.extend_from_slice(value.to_le_bytes())
        &central.extend_from_slice(name_len.to_le_bytes())
        loop _ in 0..<4 -> &central.extend_from_slice(U16{0}.to_le_bytes())
        &central.extend_from_slice(U32{0}.to_le_bytes())
        &central.extend_from_slice(offset.to_le_bytes())
        &central.extend_from_slice(name_bytes)
        entry_count += 1
    }
    central_offset :: U32.try_from(output.len()).map_err(_ -> "foreign ZIP is too large")?
    central_size :: U32.try_from(central.len()).map_err(_ -> "foreign ZIP is too large")?
    &output.extend_from_slice(central)
    count :: U16.try_from(entry_count).map_err(_ -> "foreign ZIP has too many entries")?
    &output.extend_from_slice(U32{0x06054b50}.to_le_bytes())
    loop value in [U16{0}, U16{0}, count, count] -> &output.extend_from_slice(value.to_le_bytes())
    &output.extend_from_slice(central_size.to_le_bytes())
    &output.extend_from_slice(central_offset.to_le_bytes())
    &output.extend_from_slice(U16{0}.to_le_bytes())
    Ok(output)
}
// Rust: Source/Publish/ForeignPackage.rs:1438
fn validate_archive_entry(name: String, size: Int) -> Unit Err! {
    if name.is_empty() || name.starts_with('/') || name.contains('\\') || name.split('/').any(part -> part.is_empty() || part == "." || part == "..") {
        return Err("foreign archive has unsafe entry name '{name}'")
    }
    if name.as_bytes().len() > Int.from(U16.MAX) -> return Err("foreign archive entry name '{name}' is too long")
    if size > MAX_ARCHIVE_ENTRY -> return Err("foreign archive entry '{name}' exceeds the {MAX_ARCHIVE_ENTRY / (1024 * 1024)} MiB limit")
    Ok(())
}
// Rust: Source/Publish/ForeignPackage.rs:1460
fn crc32(bytes: [U8]) -> U32 {
    crc := U32{0xffffffff}
    loop byte in bytes {
        crc ^= U32.from(byte)
        loop _ in 0..<8 {
            mask :: U32{0}.wrapping_sub(crc & U32{1})
            crc = (crc >> 1) ^ (U32{0xedb88320} & mask)
        }
    }
    !crc
}
// Rust: Source/Publish/ForeignPackage.rs:1472
fn tar_gz(entries: [ArchiveEntry]) -> [U8] Err! {
    files := [String:[U8]]{}
    loop entry in entries {
        validate_archive_entry(entry.name, entry.bytes.len())?
        if &files.insert(entry.name.clone(), entry.bytes).is_some() -> return Err("foreign archive repeats entry '{entry.name}'")
    }
    tar := [U8]{}
    loop name in files.keys().sorted() {
        bytes :: files[name]
        if name.as_bytes().len() > 100 -> return Err("NPM archive entry '{name}' is too long")
        header := [U8{0}; 512]
        &header[0..name.len()].copy_from_slice(name.as_bytes())
        write_octal(&header[100..108], if is_native_name(name) { U64{0o755} } else { U64{0o644} })
        write_octal(&header[108..116], U64{0})
        write_octal(&header[116..124], U64{0})
        write_octal(&header[124..136], U64.from(bytes.len()))
        write_octal(&header[136..148], U64{0})
        &header[148..156].fill(b' ')
        header[156] = b'0'
        &header[257..263].copy_from_slice([b'u', b's', b't', b'a', b'r', U8{0}])
        &header[263..265].copy_from_slice("00".bytes())
        checksum :: header.iter().map(byte -> U32.from(byte)).sum()
        checksum_text :: "{checksum:06o}"
        &header[148..154].copy_from_slice(checksum_text.as_bytes())
        header[154] = 0
        header[155] = b' '
        &tar.extend_from_slice(header)
        &tar.extend_from_slice(bytes)
        padding :: (512 - (bytes.len() % 512)) % 512
        &tar.resize(tar.len() + padding, U8{0})
    }
    &tar.resize(tar.len() + 1024, U8{0})
    gzip_store(tar)
}
// Rust: Source/Publish/ForeignPackage.rs:1516
fn is_native_name(name: String) -> Bool {
    name.ends_with(".so") || name.ends_with(".dylib") || name.ends_with(".dll") || name.ends_with(".node")
}
// Rust: Source/Publish/ForeignPackage.rs:1523
fn write_octal(field: &[U8], value: U64) -> {
    width :: field.len()
    digits :: width.saturating_sub(1)
    text :: "{value:0digits$o}"
    start :: width.saturating_sub(1).saturating_sub(text.len())
    &field.fill(U8{0})
    &field[start..start + text.len()].copy_from_slice(text.as_bytes())
}
// Rust: Source/Publish/ForeignPackage.rs:1531
fn gzip_store(bytes: [U8]) -> [U8] Err! {
    output := [U8]{0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 3}
    if bytes.is_empty() { &output.extend_from_slice([U8{1}, 0, 0, 255, 255]) }
    else {
        // Stream chunks without allocating a second chunk index.
        offset := 0
        loop offset < bytes.len() {
            end :: (offset + 65535).min(bytes.len())
            chunk :: bytes[offset..end]
            &output.push(if end == bytes.len() { U8{1} } else { U8{0} })
            length :: U16.try_from(chunk.len()).map_err(_ -> "internal gzip block is too large")?
            &output.extend_from_slice(length.to_le_bytes())
            &output.extend_from_slice((!length).to_le_bytes())
            &output.extend_from_slice(chunk)
            offset = end
        }
    }
    &output.extend_from_slice(crc32(bytes).to_le_bytes())
    &output.extend_from_slice(U32.truncating_from(bytes.len()).to_le_bytes())
    Ok(output)
}
// Rust: Source/Publish/ForeignPackage.rs:1552
fn run_host_tool(command: &Command, tool: String) -> Unit Err! {
    &command.stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null())
    // GATE #4409: distinguish a missing executable from other spawn failures.
    status :: &command.status().map_err(error -> if error.kind() == IOErrorKind.NotFound {
        "required host tool '{tool}' was not found"
    } else { "could not start host tool '{tool}': {error}" })?
    if status.success() -> return Ok(())
    code :: status.code().map(code -> code.to_string()).unwrap_or_else(() -> "signal")
    Err("host tool '{tool}' failed with status {code}")
}
// Rust: Source/Publish/ForeignPackage.rs:1577
fn find_tool_path(tool: String) -> OSPath Err! {
    path :: env.var_os("PATH").ok_or_else(() -> "required host tool '{tool}' was not found because PATH is empty")?
    loop directory in env.split_paths(path) {
        candidate :: directory.join(tool)
        if candidate.is_file() -> return fs.canonicalize(candidate).map_err(error -> "could not resolve host tool '{tool}': {error}")
    }
    Err("required host tool '{tool}' was not found")
}
// Rust: Source/Publish/ForeignPackage.rs:1591
fn java_home() -> OSPath Err! {
    if env.var_os("JAVA_HOME").filter(value -> !value.is_empty()) == .Val(value) {
        home :: OSPath.from(value)
        if home.join("include").join("jni.h").is_file() -> return Ok(home)
        return Err("JAVA_HOME '{home.display()}' has no include/jni.h")
    }
    javac :: find_tool_path("javac")?
    home :: javac.parent().and_then(path -> path.parent()).ok_or_else(() -> "could not determine JAVA_HOME from javac")?
    if !home.join("include").join("jni.h").is_file() -> return Err("the javac installation '{home.display()}' has no include/jni.h")
    Ok(home)
}
