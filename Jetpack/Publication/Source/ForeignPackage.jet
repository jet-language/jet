fn write_atomic(path: OSPath, bytes: [U8]) -> Unit Err! {
    parent :: path.parent().ok_or_else(() -> "artifact '{path.display()}' has no parent directory")?
    fs.create_dir_all(parent).map_err(error -> "could not create artifact directory: {error}")?
    name :: path.file_name().unwrap_or_default().to_string_lossy()
    temp :: parent.join(".{name}.partial-{std.process.id()}")
    result :: (() -> {
        file := OpenOptions.new().write(true).create_new(true).open(temp).map_err(error -> "could not stage artifact '{temp.display()}': {error}")?
        &file.write_all(bytes).and_then(_ -> file.sync_all()).map_err(error -> "could not finish artifact '{temp.display()}': {error}")?
        fs.rename(temp, path).map_err(error -> "could not install artifact '{path.display()}': {error}")
    })()
    if result.is_err() -> _ :: fs.remove_file(temp)
    result
}
// Rust: Source/Publish/ForeignPackage.rs:1338
fn foreign_output_dir(root: OSPath) -> OSPath Err! {
    target_dir :: root.join(".jet").join("build")
    if fs.symlink_metadata(target_dir) == .Ok(metadata) {
        if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("foreign artifact directory '{target_dir.display()}' is not a real build directory")
    }
    directory :: target_dir.join("foreign")
    if fs.symlink_metadata(directory) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("foreign artifact directory '{directory.display()}' is not a real directory")
        }
        .Err(_) -> fs.create_dir_all(directory).map_err(error -> "could not create '{directory.display()}': {error}")?
    }
    Ok(directory)
}
