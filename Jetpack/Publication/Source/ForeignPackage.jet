// Rust: Source/Publish/ForeignPackage.rs:1249
fn base64url(bytes: [U8]) -> String {
    TABLE :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".bytes()
    out := ""
    loop chunk in bytes.chunks(3) {
        a :: U32.from(chunk[0])
        b :: U32.from(chunk.get(1).copied().unwrap_or(U8{0}))
        c :: U32.from(chunk.get(2).copied().unwrap_or(U8{0}))
        n :: (a << 16) | (b << 8) | c
        &out.push(Char.from(TABLE[Int.from((n >> 18) & 63)]))
        &out.push(Char.from(TABLE[Int.from((n >> 12) & 63)]))
        if chunk.len() > 1 -> &out.push(Char.from(TABLE[Int.from((n >> 6) & 63)]))
        if chunk.len() > 2 -> &out.push(Char.from(TABLE[Int.from(n & 63)]))
    }
    out
}
