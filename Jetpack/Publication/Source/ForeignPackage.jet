}
// Rust: Source/Publish/ForeignPackage.rs:1637
fn runtime_rpath() -> String { if target.selected_os() == "macos" { "@loader_path" } else { "$ORIGIN" } }
// Rust: Source/Publish/ForeignPackage.rs:1645
fn build_node_addon(input: LibraryInput, addon: String) -> [U8] Err! {
    if target.selected_os() == "windows" -> return Err("N-API packaging is not supported for the Windows target yet")
    work :: work_dir(input, "node")?
    result :: (() -> {
        fs.write(work.join(input.runtime_name), input.runtime).map_err(error -> "could not stage the Node runtime: {error}")?
        fs.write(work.join("api.h"), input.header).map_err(error -> "could not stage the C ABI header: {error}")?
        source :: render_node_addon(input)
        source_path :: work.join("addon.c")
        fs.write(source_path, source.as_bytes()).map_err(error -> "could not write the N-API bridge: {error}")?
        output :: work.join(addon)
        command := Command.new("cc")
        &command.args(["-std=c11", "-shared", "-fPIC"]).arg(source_path).arg("-I").arg(work)
        if target.selected_os() == "macos" -> &command.arg("-Wl,-undefined,dynamic_lookup")
        link_runtime_args(&command, work, input.runtime_name)
        &command.arg("-o").arg(output)
        run_host_tool(&command, "cc")?
        read_regular_file(output, "N-API addon")
    })()
    cleanup_work(work)
    result
}
// Rust: Source/Publish/ForeignPackage.rs:1678
fn render_node_addon(input: LibraryInput) -> String {
    output := "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include \"api.h\"\ntypedef struct napi_env__ *napi_env;\ntypedef struct napi_value__ *napi_value;\ntypedef struct napi_callback_info__ *napi_callback_info;\ntypedef int32_t napi_status;\ntypedef napi_value (*napi_callback)(napi_env, napi_callback_info);\nenum {{ napi_ok = 0 }};\nextern napi_status napi_get_cb_info(napi_env, napi_callback_info, size_t *, napi_value *, napi_value *, void **);\nextern napi_status napi_get_value_int64(napi_env, napi_value, int64_t *);\nextern napi_status napi_get_value_double(napi_env, napi_value, double *);\nextern napi_status napi_get_value_bool(napi_env, napi_value, bool *);\nextern napi_status napi_get_value_string_utf8(napi_env, napi_value, char *, size_t, size_t *);\nextern napi_status napi_create_int64(napi_env, int64_t, napi_value *);\nextern napi_status napi_create_double(napi_env, double, napi_value *);\nextern napi_status napi_get_boolean(napi_env, bool, napi_value *);\nextern napi_status napi_create_string_utf8(napi_env, const char *, size_t, napi_value *);\nextern napi_status napi_create_function(napi_env, const char *, size_t, napi_callback, void *, napi_value *);\nextern napi_status napi_set_named_property(napi_env, napi_value, const char *, napi_value);\nextern napi_status napi_throw_error(napi_env, const char *, const char *);\nstatic napi_value jet_napi_error(napi_env env, const char *message) {{\n    napi_throw_error(env, NULL, message);\n    return NULL;\n}}\n\n"
    loop (index, export) in input.stamp.exports.iter().enumerate() {
        params :: Int.try_from(export.params).unwrap_or(0)
        &output.push_str("static napi_value jet_napi_{index}(napi_env env, napi_callback_info info) {{\n")
        &output.push_str("    napi_value argv[{params.max(1)}]; size_t argc = {params};\n")
        &output.push_str("    if (napi_get_cb_info(env, info, &argc, argv, NULL, NULL) != napi_ok || argc != {params}) return jet_napi_error(env, \"invalid argument count\");\n")
        loop param in 0..<params {
            if export.scalar == {
                .Int -> &output.push_str("    int64_t arg{param}; if (napi_get_value_int64(env, argv[{param}], &arg{param}) != napi_ok) return jet_napi_error(env, \"expected an integer\");\n")
                .Float -> &output.push_str("    double arg{param}; if (napi_get_value_double(env, argv[{param}], &arg{param}) != napi_ok) return jet_napi_error(env, \"expected a number\");\n")
                .Bool -> &output.push_str("    bool arg{param}; if (napi_get_value_bool(env, argv[{param}], &arg{param}) != napi_ok) return jet_napi_error(env, \"expected a boolean\");\n")
                .Text -> {
                    &output.push_str("    size_t len{param} = 0; char *raw{param} = NULL; if (napi_get_value_string_utf8(env, argv[{param}], NULL, 0, &len{param}) != napi_ok || len{param} > (size_t)-1 - 1) return jet_napi_error(env, \"expected UTF-8 text\");\n")
                    &output.push_str("    raw{param} = (char *)malloc(len{param} + 1); if (raw{param} == NULL) return jet_napi_error(env, \"could not allocate text argument\");\n")
                    &output.push_str("    if (napi_get_value_string_utf8(env, argv[{param}], raw{param}, len{param} + 1, &len{param}) != napi_ok) {{ free(raw{param}); return jet_napi_error(env, \"expected UTF-8 text\"); }}\n")
                    &output.push_str("    JetText arg{param} = {{ (const uint8_t *)raw{param}, len{param} }};\n")
                }
            }
        }
        args :: (0..<params).map(param -> "arg{param}").collect().join(", ")
        if export.scalar == {
            .Int -> {
                &output.push_str("    int64_t result = {export.symbol}({args});\n")
                // The original homogeneous scalar arm has no text arguments to release.
                &output.push_str("    napi_value value; if (napi_create_int64(env, result, &value) != napi_ok) return jet_napi_error(env, \"could not create result\"); return value;\n")
            }
            .Float -> {
                &output.push_str("    double result = {export.symbol}({args});\n")
                &output.push_str("    napi_value value; if (napi_create_double(env, result, &value) != napi_ok) return jet_napi_error(env, \"could not create result\"); return value;\n")
            }
            .Bool -> {
                &output.push_str("    bool result = {export.symbol}({args});\n")
                &output.push_str("    napi_value value; if (napi_get_boolean(env, result, &value) != napi_ok) return jet_napi_error(env, \"could not create result\"); return value;\n")
            }
            .Text -> {
                &output.push_str("    JetText result = {export.symbol}({args});\n")
                loop param in 0..<params -> &output.push_str("    free(raw{param});\n")
                &output.push_str("    if (result.len != 0 && result.ptr == NULL) {{ jet_text_free(result); return jet_napi_error(env, \"JetText result has an invalid pointer\"); }}\n")
                &output.push_str("    napi_value value; if (napi_create_string_utf8(env, (const char *)result.ptr, result.len, &value) != napi_ok) {{ jet_text_free(result); return jet_napi_error(env, \"could not create text result\"); }} jet_text_free(result); return value;\n")
            }
        }
        &output.push_str("}}\n\n")
    }
    &output.push_str("__attribute__((visibility(\"default\"))) napi_value napi_register_module_v1(napi_env env, napi_value exports) {{\n")
    loop (index, export) in input.stamp.exports.iter().enumerate() {
        name :: json_string(export.name)
        &output.push_str("    napi_value fn{index}; if (napi_create_function(env, {name}, {export.name.len()}, jet_napi_{index}, NULL, &fn{index}) != napi_ok || napi_set_named_property(env, exports, {name}, fn{index}) != napi_ok) return NULL;\n")
    }
    &output.push_str("    return exports;\n}}\n")
    output
}

