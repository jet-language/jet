// Rust: Source/Publish/Vendor.rs:1
use jet.Diagnostics.Diagnostic
use jet.Lock.LockFile
use jet.Store
use std.ffi.OsStr
use std.io
use std.path.Component
// GATE #4494: Store retained-directory operations and native OS strings.
// GATE #4409: preserve NotFound, InvalidData and AlreadyExists error kinds.
// Rust: Source/Publish/Vendor.rs:20
// Copy resolved dependency entries to vendor_dir and write locked integrity metadata.
pub fn vendor(project_root: OSPath, lock: LockFile, dep_dirs: [String:OSPath], vendor_dir: OSPath) -> [String] Diagnostic! {
    _ :: project_root
    destination :: Store.ensure_directory_authority(vendor_dir)
        .map_err(error -> vendor_io_error("creating vendor directory", vendor_dir, error))?
    copied := []
    loop (name, src_dir) in dep_dirs {
        if !safe_component(name) {
            return Err(Diagnostic.error("E2604", "dependency `{name}` cannot be written to the vendor tree",
                "dependency names must be one safe path component", "use a dependency name without `/`, `\\`, `:`, or `..`", None))
        }
        source :: Store.open_directory_authority(src_dir)
            .map_err(error -> vendor_io_error("inspecting dependency source", src_dir, error))?
        source_hash :: Store.hash_directory_authority(source, true)
            .map_err(error -> vendor_io_error("hashing dependency source", src_dir, error))?
        destination_name :: OsStr.new(name)
        if destination.open_child_directory(destination_name) == {
            Ok(existing) -> {
                existing_hash :: Store.hash_directory_authority(existing, false)
                    .map_err(error -> vendor_io_error("checking existing vendor copy", vendor_dir.join(name), error))?
                if existing_hash == source_hash {
                    &copied.push(name.clone())
                    continue
                }
                drop(^existing)
                destination.remove_child_tree(destination_name)
                    .map_err(error -> vendor_io_error("removing stale vendor copy", vendor_dir.join(name), error))?
            }
            Err(error) -> {
                if error.kind() != io.ErrorKind.NotFound -> return Err(vendor_io_error("checking vendor destination", vendor_dir.join(name), error))
            }
        }
        (staging_name, staging) :: destination.create_private_child("vendor")
            .map_err(error -> vendor_io_error("creating vendor staging directory", vendor_dir, error))?
        result :: (() -> {
            Store.copy_directory_authority(source, staging, true)
                .map_err(error -> vendor_io_error("copying dependency into vendor tree", src_dir, error))?
            staging_hash :: Store.hash_directory_authority(staging, false)
                .map_err(error -> vendor_io_error("checking staged vendor copy", vendor_dir.join(name), error))?
            if staging_hash != source_hash {
                return Err(vendor_io_error("checking staged vendor copy", vendor_dir.join(name),
                    io.Error.new(.InvalidData, "staged vendor copy does not match the source tree")))
            }
            if Store.publish_directory(destination, staging_name, destination, destination_name) == {
                Ok(()) -> Ok(())
                Err(error) -> {
                    if error.kind() == .AlreadyExists {
                        winner :: destination.open_child_directory(destination_name)
                            .map_err(error -> vendor_io_error("opening concurrent vendor copy", vendor_dir.join(name), error))?
                        winner_hash :: Store.hash_directory_authority(winner, false)
                            .map_err(error -> vendor_io_error("checking concurrent vendor copy", vendor_dir.join(name), error))?
                        if winner_hash == source_hash { Ok(()) } else {
                            Err(vendor_io_error("publishing vendor copy", vendor_dir.join(name),
                                io.Error.new(.AlreadyExists, "concurrent vendor copy has different contents")))
                        }
                    } else { Err(vendor_io_error("publishing vendor copy", vendor_dir.join(name), error)) }
                }
            }
        })()
        _ :: destination.remove_child_tree(staging_name)
        result?
        &copied.push(name.clone())
    }
    &copied.sort()
    manifest :: vendor_manifest_json(lock, copied)
    destination.write_child_file(OsStr.new("manifest.json"), manifest.as_bytes())
        .map_err(error -> vendor_io_error("writing vendor manifest", vendor_dir.join("manifest.json"), error))?
    Ok(copied)
}
// Rust: Source/Publish/Vendor.rs:163
fn vendor_manifest_json(lock: LockFile, copied: [String]) -> String {
    entries := []
    loop name in copied {
        if lock.packages.iter().find(package -> package.name == name) is package {
            &entries.push("    {{ \"name\": {json_str(package.name)}, \"version\": {json_str(package.version)}, \"fingerprint\": {json_str(package.fingerprint)} }}")
        }
    }
    "{{\n  \"vendor_format\": 1,\n  \"packages\": [\n{entries.join(",\n")}\n  ]\n}}\n"
}
// Rust: Source/Publish/Vendor.rs:181
fn json_str(s: String) -> String {
    out := "\""
    loop c in s.chars() {
        if c == {
            '"' -> &out.push_str("\\\"")
            '\\' -> &out.push_str("\\\\")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            else -> &out.push(c)
        }
    }
    &out.push('"')
    out
}
// Rust: Source/Publish/Vendor.rs:196
fn vendor_io_error(action: String, path: OSPath, error: io.Error) -> Diagnostic {
    Diagnostic.error("E2604", "couldn't {action} `{path.display()}`: {error}",
        "vendored dependency trees must contain real files and directories.",
        "check the dependency source and vendor directory permissions.", None)
}
// Rust: Source/Publish/Vendor.rs:206
fn safe_component(value: String) -> Bool {
    !value.is_empty() && value != "." && value != ".." && !value.contains(['/', '\\', ':'])
        && !value.chars().any(ch -> ch.is_control())
        && OSPath.new(value).components().next().is_some_and(component -> component is Component.Normal(_))
        && OSPath.new(value).components().nth(1).is_none()
}
