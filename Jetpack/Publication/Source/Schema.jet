// Rust: Source/Publish/Schema.rs:1
// Driver-level snapshot writer; schema types stay at Sema.Schema.
use jet.[Loader, AST]
use jet.Sema.Schema.[save_snapshot, snapshot_from_struct]
// Rust: Source/Publish/Schema.rs:8
// Write snapshots for all #PublishedSchema structs in the entry bundle.
// Called during registry publication; returns the count successfully written.
pub fn write_schema_snapshots_for_entry(project_root: OSPath, entry_file: String, version: String) -> Int {
    bundle :: if Loader.load_entry_with_overlay(entry_file, None, true) == {
        Ok(bundle) -> bundle
        Err(_) -> return 0
    }
    count := 0
    loop module in bundle.modules {
        loop item in module.items {
            if item is AST.Item.Struct(schema) {
                if schema.is_published_schema {
                    snap :: snapshot_from_struct(schema, version)
                    if save_snapshot(project_root, snap).is_ok() -> count += 1
                }
            }
        }
    }
    count
}
