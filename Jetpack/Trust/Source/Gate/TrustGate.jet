// U19 trust gates shared by `jetpack env`, `jet dev`, jobs, services, and
// build hooks. A gate returns None to proceed or the exit code to return:
// not trust-sensitive, already trusted, or `--trust` bypassed proceeds
// silently; a non-terminal stdin gets a clean E1255 (never a hung prompt);
// a terminal gets a summary and a y/N prompt whose "yes" persists a grant.
// `--trust` never persists anything.

TRUST_GATE_REFUSED :: prep { 2 }

// Rust `gate`: a declared env keyed by `trust_env_definition_hash`.
pub fn trust_gate(theme: Theme, store: String, project_dir: String, refs: [RefSpec], table: SourceTable, secrets: [SecretSpec], bypass: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    trust_gate_with_hash(theme, store, project_dir, refs, secrets, bypass, trust_env_definition_hash(refs, table, secrets), false, false)
}

// A plan whose typed lifecycle facts are part of its executable identity.
pub fn trust_gate_with_environment(theme: Theme, store: String, project_dir: String, refs: [RefSpec], table: SourceTable, secrets: [SecretSpec], facts: EnvironmentFacts, bypass: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    trust_gate_with_environment_and_snapshot(theme, store, project_dir, refs, table, secrets, facts, None, bypass)
}

// The environment gate bound to a managed-file source snapshot.
pub fn trust_gate_with_environment_and_snapshot(theme: Theme, store: String, project_dir: String, refs: [RefSpec], table: SourceTable, secrets: [SecretSpec], facts: EnvironmentFacts, source_snapshot: String?, bypass: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    if trust_missing_integration_grant(store, facts) == .Val(subject) {
        theme.error_coded("E1335", "environment integration authority is not granted", "the environment requests integration authority `{subject}`, but no persisted grant authorizes it", "review the integration, then run `jet trust grant integration:{subject} --scope user`")
        return Val(TRUST_GATE_REFUSED)
    }
    hash :: trust_environment_definition_hash_with_snapshot(refs, table, secrets, facts, source_snapshot)
    lifecycle :: facts.lifecycle
    lifecycle_hooks :: lifecycle.on_enter.len() > 0 || lifecycle.checks.len() > 0 || lifecycle.git_hooks_path != None
    trust_gate_with_hash(theme, store, project_dir, refs, secrets, bypass, hash, trust_is_typed_environment(facts), lifecycle_hooks)
}

// Gate a finite build hook on its exact resolved identity (staged source,
// recipe, platform, and declared capabilities). A package or environment
// grant cannot authorize a different build graph; CI accepts only an exact
// repository-scoped build grant and cannot bypass.
pub fn trust_gate_build_identity(theme: Theme, store: String, identity: String, bypass: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    ci :: sys.get("CI") != None
    if ci && bypass {
        theme.error_coded("E1255", "CI cannot bypass build-hook approval", "a build hook must use its exact package, provider/source, staged source, platform, recipe, and ability identity", "add the exact repository grant: `jet trust grant build:{identity} --scope repo`.")
        return Val(TRUST_GATE_REFUSED)
    }
    loop record in trust_list_records(store) {
        grant :: trust_record_grant(record) ?? next
        exact :: grant.subject == identity || grant.subject == trust_record_line_text(TRUST_HASH_PREFIX, identity)
        if grant.is(TrustAuthority.Build) && (!ci || grant.scope == TRUST_SCOPE_REPO) && exact -> return None
    }
    if bypass -> return None
    if ci {
        theme.error_coded("E1255", "this build hook is not approved for CI", "CI accepts only an exact repository-scoped grant for the complete package, provider/source, staged source, platform, recipe, and ability identity", "add the exact repository grant: `jet trust grant build:{identity} --scope repo`.")
        return Val(TRUST_GATE_REFUSED)
    }
    if !term.stdin().is_terminal() {
        theme.error_coded("E1255", "this build hook is not trusted yet", "the build action graph has a new source, recipe, platform, or ability identity and stdin is not a terminal to ask interactively", "pass `--trust` for this build, or pre-authorize the exact build identity with `jet trust grant`.")
        return Val(TRUST_GATE_REFUSED)
    }
    theme.note("first build for this exact action graph:")
    theme.detail("build identity: {identity}")
    trust_gate_prompt("  Trust this build? [y/N] ")
    answer :: term.readline() ?? return Val(TRUST_GATE_REFUSED)
    if !trust_gate_is_yes(answer) {
        theme.status("not trusted — exiting.")
        return Val(TRUST_GATE_REFUSED)
    }
    trust_add_grant(store, TrustGrant{authority: TrustAuthority.Build.label(), subject: identity, scope: TRUST_SCOPE_USER})
    None
}

fn trust_gate_with_hash(theme: Theme, store: String, project_dir: String, refs: [RefSpec], secrets: [SecretSpec], bypass: Bool, hash: String, typed: Bool, lifecycle_hooks: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    if !typed && !trust_is_trust_sensitive_ext(refs, secrets.len() > 0) && !lifecycle_hooks -> return None
    trusted :: if typed -> trust_is_typed_environment_trusted(store, project_dir, hash) else -> trust_is_env_trusted(store, project_dir, hash, refs, secrets)
    if bypass || trusted -> return None
    // The project supplies this policy, so its allow decision cannot be the
    // external approval that authorizes the same project.
    if trust_project_policy_decision(project_dir) == .Val(decision) {
        if decision == TrustDecision.Deny {
            theme.error_coded("E1255", "this project's trust policy denies the environment grant", "`authority.trust` is source-reviewed and told Jet not to prompt for this authority", "change `authority.trust` to `prompt`/`allow`, pass `--trust` for this one run, or remove the trust-sensitive env facts.")
            return Val(TRUST_GATE_REFUSED)
        }
    }
    if !term.stdin().is_terminal() {
        theme.error_coded("E1255", "this project's environment isn't trusted yet", "entering this project realizes {refs.len()} package(s) it declares; a first entry needs a trust decision, and stdin isn't a terminal to ask interactively", "pass `--trust` for this one run, or pre-authorize with `jetpack config trust add <pattern>`.")
        return Val(TRUST_GATE_REFUSED)
    }
    theme.note("first entry to this project — it declares {refs.len()} package(s) and {secrets.len()} secret(s):")
    // One aligned row per ref: bold package, gray source. The supply-chain
    // decision is which sources run code here.
    name_width := 8
    loop spec in refs {
        width :: spec.package.bytes().len()
        if width > name_width -> name_width = width
    }
    loop spec in refs {
        source :: if spec.raw.ends_with(spec.package) -> trust_trim_trailing_colons(spec.raw.removesuffix(spec.package)) else -> spec.raw
        theme.detail("{theme.bold(trust_pad_right(spec.package, name_width))}  {theme.gray(source)}")
    }
    loop secret in secrets -> theme.detail("secret:{secret.name}")
    trust_gate_prompt("\n  {theme.gray("a yes is remembered for this exact env; any change asks again.")}\n")
    trust_gate_prompt("  Trust this environment? [y/N] ")
    answer :: term.readline() ?? return Val(TRUST_GATE_REFUSED)
    if !trust_gate_is_yes(answer) {
        theme.status("not trusted — exiting.")
        return Val(TRUST_GATE_REFUSED)
    }
    trust_grant_hash(store, hash)
    None
}

// The project's `authority.trust` decision for this run: the CI prompt
// decision under CI when set, else the default. An unreadable package
// manifest has no policy.
fn trust_project_policy_decision(project_dir: String) -[FS, Env]> TrustDecision? {
    loaded :: PackageFacts.load(project_dir) ?? return None
    facts :: loaded ?? return None
    policy :: facts.authority.trust ?? return None
    if sys.get("CI") != None && policy.ci_prompt != None -> return policy.ci_prompt
    policy.default
}

// The trust gate for a foreign flake/devenv file (U16), keyed on the file's
// content. Ad-hoc `-p` packages are ordinary refs in the normal gate.
pub fn trust_gate_flake(theme: Theme, store: String, project_dir: String, flake_path: String, bypass: Bool) -[IO, FS, Env, Time.Wait]> Int? {
    content :: files.read(flake_path) ?? ""
    hash :: trust_flake_definition_hash(content)
    if bypass || trust_is_trusted(store, project_dir, hash) -> return None
    if !term.stdin().is_terminal() {
        theme.error_coded("E1255", "this project's environment isn't trusted yet", "entering `{flake_path}` evaluates a foreign flake this project didn't declare through `env.*`; a first entry needs a trust decision, and stdin isn't a terminal to ask interactively", "pass `--trust` for this one run, or pre-authorize with `jetpack config trust add <pattern>`.")
        return Val(TRUST_GATE_REFUSED)
    }
    theme.note("first entry to this project's foreign flake: {flake_path}")
    trust_gate_prompt("  Trust this flake? [y/N] ")
    answer :: term.readline() ?? return Val(TRUST_GATE_REFUSED)
    if !trust_gate_is_yes(answer) {
        theme.status("not trusted — exiting.")
        return Val(TRUST_GATE_REFUSED)
    }
    trust_grant_hash(store, hash)
    None
}

// Prompt text on stderr without a newline.
fn trust_gate_prompt(text: String) Never! -[IO, Time.Wait]> {
    err_stream :: term.stderr()
    err_stream.write(text).drop("the trust prompt is best-effort output")
    err_stream.flush().drop("the trust prompt is best-effort output")
}

// `y`/`yes` in any case is yes.
fn trust_gate_is_yes(answer: String) -> Bool Never! {
    if answer.trim().to_lower() == {
        "y" | "yes" -> true
        else -> false
    }
}

fn trust_trim_trailing_colons(text: String) -> String Never! {
    trimmed := ~text
    loop trimmed.ends_with(":") -> trimmed = trimmed.removesuffix(":")
    trimmed
}

// Rust `{:<width$}`: pad with spaces to `width` scalars.
fn trust_pad_right(text: String, width: Int) -> String Never! {
    count := 0
    loop _ in text.chars() -> count += 1
    padded := ~text
    loop count < width {
        padded = "{padded} "
        count += 1
    }
    padded
}
