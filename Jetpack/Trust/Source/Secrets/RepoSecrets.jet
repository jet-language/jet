// U13 encrypted repository secrets (D-JPK-SECRETCRYPTO1=A), ported from
// jetpack Secrets.rs as a thin command layer over `core.crypto.vault`.
//
// DEPENDS ON D-CORE-SECRETSTORE1 option A, which is still OPEN. Option A makes
// the vault the one owner of the repository store: `.jet/secrets.age` (age
// v1, committed ciphertext), `.jet/secrets-recipients` (committed plaintext,
// one `age1...` key per line), and the local identity
// `$JET_KEYS_DIR/secrets.identity` or `~/.jet/keys/secrets.identity`
// (mode 0600, never committed). The calls this file makes are the ones that
// option spells: `vault.create_identity(if_exists:)`,
// `vault.Recipient.from_text`, `recipient.text()`, `vault.add_recipient`,
// `vault.recipients`, `vault.add`, `vault.remove`, `vault.names`, and the
// existing `vault.get`, all `-[Secret]>` and failing with `VaultError`. The
// pairs codec, recipient-file parsing, age helper subprocess, store locking,
// and atomic store writes of Secrets.rs move into the vault with it (#3668),
// so they are not repeated here.
//
// The vault opens the repository store of the process working directory
// (the provider reads `./.jet`), so every store call first requires the
// project to be that directory.
//
// Jetpack keeps what is not store ownership: the secret-free validation
// identity, the runtime composition plan, the store age, `.env` import
// parsing, and the Jetpack `secrets` lock scope that serializes its own
// read-modify-write commands.

@SECRETS_STORE_FILE :: "secrets.age"
@SECRETS_RECIPIENTS_FILE :: "secrets-recipients"
@SECRETS_IDENTITY_FILE :: "secrets.identity"
@SECRETS_RUNTIME_PLAN_FILE :: "secrets-plan"
@SECRETS_RUNTIME_PLAN_MAGIC :: "JSEC1"
@SECRETS_LOCK_SCOPE :: "secrets"
@SECRETS_VALIDATION_DOMAIN :: "jetpack-secret-validation-v1"

// `.jet/secrets.age`: the encrypted store, project-relative and committed.
pub fn trust_secrets_store_path(project: String) -> String Never! {
    files.join(files.join(project, @CONFIG_DEFAULT_DIR), @SECRETS_STORE_FILE)
}

// `.jet/secrets-recipients`: one `age1...` public key per line.
pub fn trust_secrets_recipients_path(project: String) -> String Never! {
    files.join(files.join(project, @CONFIG_DEFAULT_DIR), @SECRETS_RECIPIENTS_FILE)
}

// The non-secret runtime composition plan: output names, sorted input names,
// and the declared template. Composed values are never written here.
pub fn trust_secrets_runtime_plan_path(project: String) -> String Never! {
    files.join(files.join(project, @CONFIG_DEFAULT_DIR), @SECRETS_RUNTIME_PLAN_FILE)
}

// The local decrypt identity: `$JET_KEYS_DIR/secrets.identity` when set and
// non-empty, else `~/.jet/keys/secrets.identity`. Never project-relative.
pub fn trust_secrets_identity_path() -[Env]> String {
    override :: sys.get("JET_KEYS_DIR") ?? ""
    dir :: if override != "" -> override else -> trust_secrets_default_keys_dir()
    files.join(dir, @SECRETS_IDENTITY_FILE)
}

fn trust_secrets_default_keys_dir() -[Env]> String {
    home :: sys.get("HOME") ?? sys.get("USERPROFILE") ?? "."
    files.join(files.join(home, ".jet"), "keys")
}

pub fn trust_secrets_write_runtime_plan(project: String, specs: [SecretSpec]) TrustError! -[FS]> {
    lines := [String]{"{@SECRETS_RUNTIME_PLAN_MAGIC}\n"}
    loop spec in specs {
        if spec.declaration == {
            .Compose(template, from) -> {
                inputs :: trust_secrets_sorted_unique(from)
                controlled := trust_secrets_has_plan_control(spec.name) || trust_secrets_has_plan_control(template)
                loop input in inputs {
                    if trust_secrets_has_plan_control(input) -> controlled = true
                }
                if controlled -> return Err(TrustError.Secret("secret composition plan for {spec.name} contains a control character"))
                &lines.push("{spec.name}\t{inputs.join(",")}\t{template}\n")
            }
            .Stored -> {}
        }
    }
    body :: lines.join("").bytes()
    path :: trust_secrets_runtime_plan_path(project)
    if files.read_bytes(path) == .Ok(existing) {
        if existing == body -> return Ok()
    }
    parent :: files.dirname(path)
    files.create_dir_all(parent) ?? return Err(TrustError.Secret("couldn't create `{parent}`: {err}"))
    files.write_atomic(path, body) ?? return Err(TrustError.Secret("couldn't finalize `{path}`: {err}"))
}

// A `\n`, `\r`, or `\t` would break the tab-separated plan line.
fn trust_secrets_has_plan_control(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        code :: Int.from_u8(byte)
        if code == @TRUST_NEWLINE || code == @TRUST_CARRIAGE_RETURN || code == @TRUST_TAB -> return true
    }
    false
}

// A secret-free identity for validation inputs: the declaration shape, the
// active environment, the ciphertext, the recipient file, and the local
// identity. It never decrypts, so activation can reuse a successful
// validation when none of those changed. None when there is no local
// identity to validate with.
pub fn trust_secrets_validation_identity(project: String, specs: [SecretSpec], active_environment: String?) -[FS, Env]> String? TrustError! {
    canonical := [U8]{}
    &canonical.extend(@SECRETS_VALIDATION_DOMAIN.bytes())
    &canonical.push(U8{0})
    trust_secrets_append_field(&canonical, active_environment ?? "dynamic")
    fingerprints := [String]{}
    loop spec in specs {
        template :: if spec.declaration == {
            .Compose(text, _) -> pkg_sha256_hex(text.bytes())
            .Stored -> ""
        }
        &fingerprints.push("{spec.trust_fingerprint()}|{template}")
    }
    unique :: trust_secrets_sorted_unique(fingerprints)
    loop fingerprint in unique -> trust_secrets_append_field(&canonical, fingerprint)

    store :: trust_secrets_store_path(project)
    store_info :: if files.stat(store) == {
        .Ok(info) -> info
        .Err(error) -> {
            if error == {
                .NotFound(_) -> {
                    trust_secrets_append_field(&canonical, "store-absent")
                    return Ok(Val(pkg_sha256_hex(canonical)))
                }
                else -> return Err(TrustError.Secret("couldn't inspect `{store}`: {error}"))
            }
        }
    }
    if !store_info.is_file || store_info.is_symlink -> return Err(TrustError.Secret("secrets store `{store}` is not a regular file"))
    ciphertext :: files.read_bytes(store) ?? return Err(TrustError.Secret("couldn't read `{store}`: {err}"))
    trust_secrets_append_field(&canonical, "store-present")
    trust_secrets_append_field(&canonical, "{store_info.size}")
    trust_secrets_append_field(&canonical, pkg_sha256_hex(ciphertext))

    identity :: trust_secrets_identity_path()
    identity_bytes :: if files.read_bytes(identity) == {
        .Ok(bytes) -> bytes
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok(None)
                else -> return Err(TrustError.Secret("couldn't read secrets identity `{identity}`: {error}"))
            }
        }
    }
    trust_secrets_append_field(&canonical, pkg_sha256_hex(identity_bytes))
    recipients :: trust_secrets_recipients_path(project)
    if files.read_bytes(recipients) == {
        .Ok(bytes) -> trust_secrets_append_field(&canonical, pkg_sha256_hex(bytes))
        .Err(error) -> {
            if error == {
                .NotFound(_) -> trust_secrets_append_field(&canonical, "recipients-absent")
                else -> return Err(TrustError.Secret("couldn't read `{recipients}`: {error}"))
            }
        }
    }
    Ok(Val(pkg_sha256_hex(canonical)))
}

// One length-prefixed field: the byte length as a little-endian u64, then
// the bytes.
fn trust_secrets_append_field(canonical: &[U8], field: String) {
    raw :: field.bytes()
    length := raw.len()
    loop _ in 0..<8 {
        &canonical.push(U8.from_int(length % 256) ?? U8{0})
        length = length / 256
    }
    &canonical.extend(raw)
}

// Rust `sort` then `dedup`.
fn trust_secrets_sorted_unique(values: [String]) -> [String] Never! {
    sorted := values
    &sorted.sort()
    unique := [String]{}
    loop value in sorted {
        if unique.len() > 0 && unique[unique.len() - 1] == value -> next
        &unique.push(value)
    }
    unique
}

// How long ago the store was last written; None when there is no store.
pub fn trust_secrets_store_age(project: String) -[FS, Time]> Duration? TrustError! {
    path :: trust_secrets_store_path(project)
    info :: if files.stat(path) == {
        .Ok(found) -> found
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok(None)
                else -> return Err(TrustError.Secret("couldn't inspect `{path}`: {error}"))
            }
        }
    }
    now_ms :: time.instant().unix_ns / 1000000
    age_ms :: if now_ms > info.modified_ms -> now_ms - info.modified_ms else -> 0
    Ok(Val(time.duration_ms(age_ms)))
}

// Generate a fresh identity/recipient pair: where the identity was written
// and the public recipient teammates add. Refuses to overwrite an existing
// identity unless `force`: that would orphan everything encrypted to it.
pub fn trust_secrets_keygen(force: Bool) -[FS, Env, Secret]> (path: String, recipient: String) TrustError! {
    path :: trust_secrets_identity_path()
    if files.is_file(path) && !force {
        return Err(TrustError.Secret("a secrets identity already exists at `{path}` — pass `--force` if you're sure (this orphans anything encrypted to the old key)"))
    }
    if_exists :: if force -> CreateIfExists.Replace else -> CreateIfExists.Refuse
    recipient :: vault.create_identity(if_exists: if_exists) ?? return Err(TrustError.Secret("couldn't write identity: {err}"))
    Ok((path: path, recipient: recipient.text()))
}

// `jetpack secrets recipients add <age1...>`: false when already present;
// lock and store failures stay errors.
pub fn trust_secrets_add_recipient(project: String, recipient: String) -[FS, Env, Secret]> Bool TrustError! {
    _guard :: env_runtime_project_lock(project, @SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets recipients: {err}"))
    trust_secrets_require_vault_root(project)
    parsed :: vault.Recipient.from_text(recipient.trim()) ?? return Err(TrustError.Secret("`{recipient.trim()}` is not an age recipient: {err}"))
    added :: vault.add_recipient(parsed) ?? return Err(TrustError.Secret("{err}"))
    Ok(added)
}

// `jetpack secrets recipients list`: every recipient.
pub fn trust_secrets_list_recipients(project: String) -[FS, Env, Secret]> [String] TrustError! {
    trust_secrets_require_vault_root(project)
    recipients :: vault.recipients() ?? return Err(TrustError.Secret("{err}"))
    lines := [String]{}
    loop recipient in recipients -> &lines.push(recipient.text())
    Ok(lines)
}

// `jetpack secrets set <name> <value>`: upsert one entry; the vault
// re-encrypts the store to every recipient.
pub fn trust_secrets_set(project: String, name: String, value: String) TrustError! -[FS, Env, Secret]> {
    _guard :: env_runtime_project_lock(project, @SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    trust_secrets_require_vault_root(project)
    vault.add(name, Secret{bytes: value.bytes()}) ?? return Err(TrustError.Secret("{err}"))
}

// `jetpack secrets unset <name>`: false is "no such entry" (E1263 at the CLI).
pub fn trust_secrets_unset(project: String, name: String) -[FS, Env, Secret]> Bool TrustError! {
    _guard :: env_runtime_project_lock(project, @SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    trust_secrets_require_vault_root(project)
    removed :: vault.remove(name) ?? return Err(TrustError.Secret("{err}"))
    Ok(removed)
}

// `jetpack secrets list`: declared names, never values. An absent store is
// an empty one.
pub fn trust_secrets_list(project: String) -[FS, Env, Secret]> [String] TrustError! {
    trust_secrets_require_vault_root(project)
    names :: vault.names() ?? return Err(TrustError.Secret("{err}"))
    Ok(names)
}

// `jetpack secrets get <name>`: None is "no such entry" (E1263 at the CLI).
pub fn trust_secrets_get(project: String, name: String) -[FS, Env, Secret]> String? TrustError! {
    trust_secrets_require_vault_root(project)
    Ok(vault.get(name))
}

// `jetpack secrets import <.env>`: upsert every assignment of a dotenv file
// under one Jetpack lock. The source is only read; the caller prints the
// cleanup advice after the encrypted writes succeed. Returns the imported
// names in byte order.
pub fn trust_secrets_import_dotenv(project: String, source: String) -[FS, Env, Secret]> [String] TrustError! {
    values :: trust_secrets_parse_dotenv(source)
    names :: envmodel_sorted_keys(values)
    if names.len() == 0 -> return Ok(names)
    _guard :: env_runtime_project_lock(project, @SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    trust_secrets_require_vault_root(project)
    loop name in names {
        vault.add(name, Secret{bytes: values[name].bytes()}) ?? return Err(TrustError.Secret("{err}"))
    }
    Ok(names)
}

// Dotenv assignments: blank and `#` lines skipped, an `export ` prefix
// accepted, one matching pair of surrounding quotes removed. A later
// assignment of the same name wins.
pub fn trust_secrets_parse_dotenv(path: String) -[FS]> [String: String] TrustError! {
    text :: files.read(path) ?? return Err(TrustError.Secret("{err}"))
    values := [String: String]{}
    number := 0
    loop raw_line in trust_text_lines(text) {
        number += 1
        trimmed :: raw_line.trim()
        if trimmed == "" || trimmed.starts_with("#") -> next
        line :: if trimmed.starts_with("export ") -> trimmed.removeprefix("export ") else -> trimmed
        parts :: trust_text_split_first(line, @TRUST_EQUALS) ?? return Err(TrustError.Secret("line {number} has no '='"))
        name :: parts.before.trim()
        if !trust_secrets_is_variable_name(name) -> return Err(TrustError.Secret("line {number} has an invalid variable name"))
        value := parts.after.trim()
        raw :: value.bytes()
        if raw.len() >= 2 {
            first :: Int.from_u8(raw[0])
            last :: Int.from_u8(raw[raw.len() - 1])
            if first == last && (first == @TRUST_QUOTE || first == @TRUST_APOSTROPHE) -> value = pkg_bytes_text(raw, 1, raw.len() - 1)
        }
        values[name] = value
    }
    Ok(values)
}

// `[A-Za-z_][A-Za-z0-9_]*`.
fn trust_secrets_is_variable_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    first :: Int.from_u8(raw[0])
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == @TRUST_UNDERSCORE) -> return false
    loop byte in raw {
        code :: Int.from_u8(byte)
        if !(trust_text_is_alphanumeric(code) || code == @TRUST_UNDERSCORE) -> return false
    }
    true
}

// D-CORE-SECRETSTORE1 option A: the vault calls carry no root and open the
// working directory's store, so a project elsewhere must not reach them.
fn trust_secrets_require_vault_root(project: String) TrustError! -[FS, Env]> {
    here :: files.cwd() ?? return Err(TrustError.Secret("couldn't read the working directory: {err}"))
    here_path :: files.canonicalize(here) ?? here
    project_path :: files.canonicalize(project) ?? project
    if here_path != project_path -> return Err(TrustError.Secret("the secrets store of `{project}` is only reachable from that directory; the vault opens `{here}`"))
}
