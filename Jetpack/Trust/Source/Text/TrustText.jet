// Byte-offset text helpers for the Trust area's lock and flake scanners.
//
// Scanners cut only at ASCII delimiters, so every slice is whole UTF-8
// scalars. Unicode whitespace (Rust `trim`, `split_whitespace`) goes through
// PackageModel's `pkg_bytes_*` helpers; ASCII whitespace is Rust's
// `u8::is_ascii_whitespace` set.

TRUST_TAB :: prep { 9 }
TRUST_NEWLINE :: prep { 10 }
TRUST_FORM_FEED :: prep { 12 }
TRUST_CARRIAGE_RETURN :: prep { 13 }
TRUST_SPACE :: prep { 32 }
TRUST_QUOTE :: prep { 34 }
TRUST_HASH :: prep { 35 }
TRUST_AMPERSAND :: prep { 38 }
TRUST_APOSTROPHE :: prep { 39 }
TRUST_OPEN_PAREN :: prep { 40 }
TRUST_CLOSE_PAREN :: prep { 41 }
TRUST_COMMA :: prep { 44 }
TRUST_DASH :: prep { 45 }
TRUST_DOT :: prep { 46 }
TRUST_SLASH :: prep { 47 }
TRUST_COLON :: prep { 58 }
TRUST_SEMICOLON :: prep { 59 }
TRUST_EQUALS :: prep { 61 }
TRUST_QUESTION :: prep { 63 }
TRUST_OPEN_SQUARE :: prep { 91 }
TRUST_BACKSLASH :: prep { 92 }
TRUST_CLOSE_SQUARE :: prep { 93 }
TRUST_UNDERSCORE :: prep { 95 }
TRUST_OPEN_BRACE :: prep { 123 }
TRUST_CLOSE_BRACE :: prep { 125 }

// The two halves around one separator byte.
struct TrustTextSplit {
    before: String
    after: String
}

// Offset of the first `needle` at or after `from`, or -1.
fn trust_text_find(raw: [U8], needle: [U8], from: Int) -> Int Never! {
    start := from
    loop start + needle.len() <= raw.len() {
        if pkg_bytes_starts_with(raw, start, needle) -> return start
        start += 1
    }
    -1
}

// Offset of the first byte equal to `code` at or after `from`, or -1.
fn trust_text_find_byte(raw: [U8], code: Int, from: Int) -> Int Never! {
    index := from
    loop index < raw.len() {
        if Int.from_u8(raw[index]) == code -> return index
        index += 1
    }
    -1
}

// Offset of the last byte equal to `code`, or -1.
fn trust_text_rfind_byte(raw: [U8], code: Int) -> Int Never! {
    index := raw.len() - 1
    loop index >= 0 {
        if Int.from_u8(raw[index]) == code -> return index
        index -= 1
    }
    -1
}

// Rust `split_once(byte)`.
fn trust_text_split_first(text: String, code: Int) -> TrustTextSplit? Never! {
    raw :: text.bytes()
    at :: trust_text_find_byte(raw, code, 0)
    if at < 0 -> return None
    Val(TrustTextSplit{before: pkg_bytes_text(raw, 0, at), after: pkg_bytes_text(raw, at + 1, raw.len())})
}

// Rust `rsplit_once(byte)`.
fn trust_text_split_last(text: String, code: Int) -> TrustTextSplit? Never! {
    raw :: text.bytes()
    at :: trust_text_rfind_byte(raw, code)
    if at < 0 -> return None
    Val(TrustTextSplit{before: pkg_bytes_text(raw, 0, at), after: pkg_bytes_text(raw, at + 1, raw.len())})
}

// Rust `rsplit_once(needle)` for a text needle.
fn trust_text_split_last_text(text: String, needle: String) -> TrustTextSplit? Never! {
    raw :: text.bytes()
    pattern :: needle.bytes()
    at := raw.len() - pattern.len()
    loop at >= 0 {
        if pkg_bytes_starts_with(raw, at, pattern) -> return Val(TrustTextSplit{before: pkg_bytes_text(raw, 0, at), after: pkg_bytes_text(raw, at + pattern.len(), raw.len())})
        at -= 1
    }
    None
}

// Rust `split(byte)`: every piece, including empty ones.
fn trust_text_split(text: String, code: Int) -> [String] Never! {
    raw :: text.bytes()
    pieces := [String]{}
    start := 0
    loop {
        at :: trust_text_find_byte(raw, code, start)
        if at < 0 -> break
        &pieces.push(pkg_bytes_text(raw, start, at))
        start = at + 1
    }
    &pieces.push(pkg_bytes_text(raw, start, raw.len()))
    pieces
}

// Rust `trim_matches(byte)`: strip every leading and trailing `code`.
fn trust_text_trim_byte(text: String, code: Int) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end && Int.from_u8(raw[start]) == code -> start += 1
    loop end > start && Int.from_u8(raw[end - 1]) == code -> end -= 1
    pkg_bytes_text(raw, start, end)
}

// Rust `trim_matches([..])` over a set of ASCII bytes.
fn trust_text_trim_bytes(text: String, codes: [Int]) -> String Never! {
    raw :: text.bytes()
    start := 0
    end := raw.len()
    loop start < end && codes.contains(Int.from_u8(raw[start])) -> start += 1
    loop end > start && codes.contains(Int.from_u8(raw[end - 1])) -> end -= 1
    pkg_bytes_text(raw, start, end)
}

// Rust `str::lines`: split at `\n`, drop the `\r` of a `\r\n` ending, and
// yield no final empty line after a trailing newline.
fn trust_text_lines(text: String) -> [String] Never! {
    raw :: text.bytes()
    lines := [String]{}
    start := 0
    loop start < raw.len() {
        newline :: trust_text_find_byte(raw, TRUST_NEWLINE, start)
        end :: if newline < 0 -> raw.len() else -> newline
        content_end := end
        if newline >= 0 && content_end > start && Int.from_u8(raw[content_end - 1]) == TRUST_CARRIAGE_RETURN -> content_end -= 1
        &lines.push(pkg_bytes_text(raw, start, content_end))
        start = end + 1
    }
    lines
}

// Rust `split_whitespace` (Unicode White_Space separators, no empty words).
fn trust_text_words(text: String) -> [String] Never! {
    raw :: text.bytes()
    words := [String]{}
    index := 0
    loop index < raw.len() {
        index = pkg_bytes_skip_space(raw, index)
        if index >= raw.len() -> break
        start :: ~index
        loop index < raw.len() && pkg_bytes_space_width(raw, index) == 0 -> index += 1
        &words.push(pkg_bytes_text(raw, start, index))
    }
    words
}

// Rust `str::replace`: every non-overlapping occurrence of `needle`.
fn trust_text_replace_all(text: String, needle: String, replacement: String) -> String Never! {
    raw :: text.bytes()
    pattern :: needle.bytes()
    if pattern.len() == 0 -> return ~text
    out := [U8]{}
    index := 0
    loop index < raw.len() {
        if pkg_bytes_starts_with(raw, index, pattern) {
            loop byte in replacement.bytes() -> &out.push(byte)
            index += pattern.len()
            next
        }
        &out.push(raw[index])
        index += 1
    }
    String.from_bytes(out) ?? ~text
}

// Rust `u8::is_ascii_whitespace`.
fn trust_text_is_ascii_space(code: Int) -> Bool Never! {
    code == TRUST_SPACE || code == TRUST_TAB || code == TRUST_NEWLINE || code == TRUST_FORM_FEED || code == TRUST_CARRIAGE_RETURN
}

// The first offset at or after `at` that is not ASCII whitespace.
fn trust_text_skip_ascii_space(raw: [U8], at: Int) -> Int Never! {
    index := at
    loop index < raw.len() && trust_text_is_ascii_space(Int.from_u8(raw[index])) -> index += 1
    index
}

// Rust `u8::is_ascii_hexdigit`.
fn trust_text_is_hex(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 70) || (code >= 97 && code <= 102)
}

// Rust `u8::is_ascii_alphanumeric`.
fn trust_text_is_alphanumeric(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

// Byte-order comparison of two string lists (Rust `Vec<String>` `Ord`):
// -1, 0, or 1.
fn trust_text_compare_lists(left: [String], right: [String]) -> Int Never! {
    shared :: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<(shared) {
        if left[index] == right[index] -> next
        if left[index] < right[index] -> return -1
        return 1
    }
    if left.len() == right.len() -> return 0
    if left.len() < right.len() -> return -1
    1
}

// SHA-256 hex of `parts` joined by NUL bytes (Rust `format!("{a}\0{b}")`).
fn trust_sha256_nul_joined(parts: [String]) -> String Never! {
    bytes := [U8]{}
    loop index in 0..<parts.len() {
        if index > 0 -> &bytes.push(U8{0})
        loop byte in parts[index].bytes() -> &bytes.push(byte)
    }
    pkg_sha256_hex(bytes)
}
