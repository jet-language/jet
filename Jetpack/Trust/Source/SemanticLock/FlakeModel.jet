// The typed foreign-flake projection (E4-JP13). This is deliberately a
// projection of `flake.nix`, not a second resolver: source URLs and follows
// edges become `LockInput`s, while exact revisions and output provenance
// become semantic records in the same `.jet/lock` file.

FlakeInput: struct {
    name: String
    url: String
    revision: String
    follows: String
    provenance: String
}

// One input edge of a native `flake.lock` node. `target` stays canonical
// JSON so every Nix field is lossless.
FlakeLockEdge: struct {
    name: String
    target: String
}

// One node of the native `flake.lock` graph; `original` and `locked` are
// canonical JSON objects rather than a second resolver model.
FlakeLockNode: struct {
    name: String
    original: String
    locked: String
    inputs: [FlakeLockEdge]
}

// An indirect flake reference resolved by the locked node. Ambient user or
// system registries are never consulted; the lock is the authority.
FlakeRegistryEntry: struct {
    alias: String
    node: String
    original: String
    locked: String
}

FlakeOutputKind: enum {
    Package
    DevShell
    App
    Check
    Formatter
    Other(String)

    label: fn(self) -> String Never! {
        if self == {
            .Package -> "packages"
            .DevShell -> "devShells"
            .App -> "apps"
            .Check -> "checks"
            .Formatter -> "formatter"
            .Other(value) -> value
        }
    }

    // The kind an output assignment prefix declares (`legacyPackages` and
    // `devShell` are the older spellings).
    from_prefix: fn(prefix: String) -> FlakeOutputKind Never! {
        if prefix == {
            "packages" | "legacyPackages" -> FlakeOutputKind.Package
            "devShells" | "devShell" -> FlakeOutputKind.DevShell
            "apps" -> FlakeOutputKind.App
            "checks" -> FlakeOutputKind.Check
            "formatter" -> FlakeOutputKind.Formatter
            else -> FlakeOutputKind.Other(prefix)
        }
    }

    // The kind a lock record's `kind:system:attribute` names; an empty
    // label names none.
    from_label: fn(label: String) -> FlakeOutputKind? Never! {
        if label == {
            "packages" -> Val(FlakeOutputKind.Package)
            "devShells" -> Val(FlakeOutputKind.DevShell)
            "apps" -> Val(FlakeOutputKind.App)
            "checks" -> Val(FlakeOutputKind.Check)
            "formatter" -> Val(FlakeOutputKind.Formatter)
            "" -> None
            else -> Val(FlakeOutputKind.Other(label))
        }
    }

    // Position in declaration order, the order Rust's derived `Ord` uses.
    rank: fn(self) -> Int Never! {
        if self == {
            .Package -> 0
            .DevShell -> 1
            .App -> 2
            .Check -> 3
            .Formatter -> 4
            .Other(_) -> 5
        }
    }

    // The payload that orders two `Other` kinds.
    other_text: fn(self) -> String Never! {
        if self == {
            .Other(value) -> value
            .Package | .DevShell | .App | .Check | .Formatter -> ""
        }
    }
}

FlakeOutput: struct {
    name: String
    kind: FlakeOutputKind
    system: String
    attribute: String
    provenance: String

    // `kind:system:attribute`, or the bare attribute of a system-less output.
    declared: fn(kind: FlakeOutputKind, system: String, attribute: String, provenance: String) -> FlakeOutput Never! {
        name: if system == "" -> attribute.copy() else -> "{kind.label()}:{system}:{attribute}"
        FlakeOutput{name, kind, system, attribute, provenance}
    }

    // The facts a lock must agree with; provenance is not part of them.
    same_shape: fn(self, other: FlakeOutput) -> Bool Never! {
        self.name == other.name && self.kind == other.kind && self.system == other.system && self.attribute == other.attribute
    }
}

// The declarative part of a flake-parts composition that has a direct Jet
// graph meaning. Arbitrary evaluator functions stay behind the native Nix
// boundary; module paths, systems, and the per-system projection marker are
// ordinary graph facts and round-trip through `.jet/lock`. Loaded graphs also
// keep a content fingerprint per imported module so a module edit cannot
// reuse a stale lock.
FlakeComposition: struct {
    framework: String
    modules: [String]
    module_sources: [String]
    systems: [String]
    per_system: Bool
}

// One `key=value` field of a flake URL query.
FlakeQueryField: struct {
    key: String
    value: String
}

// The source a flake URL names, for matching against a lock node's
// `original` metadata.
FlakeSourceIdentity: enum {
    Direct(kind: String, owner: String, repo: String, pin: FlakeSourcePin, query: [FlakeQueryField])
    Indirect(alias: String, pin: FlakeSourcePin, query: [FlakeQueryField])
}

// The ref and revision a flake URL pins through its path or query.
FlakeSourcePin: struct {
    reference: String?
    revision: String?

    // This pin with `ref=`/`rev=` query fields applied; None when a query
    // field disagrees with the path.
    with_query: fn(self, query: [FlakeQueryField]) -> FlakeSourcePin? Never! {
        pinned := self
        if trust_flake_query_value(query, "ref") == {
            .Val(value) -> {
                if self.reference != None && self.reference != Val(value) -> return None
                pinned.reference = Val(value)
            }
            .None -> {}
        }
        if trust_flake_query_value(query, "rev") == {
            .Val(value) -> {
                if self.revision != None && self.revision != Val(value) -> return None
                pinned.revision = Val(value)
            }
            .None -> {}
        }
        Val(pinned)
    }
}

// Outputs in Rust's derived `Ord` order: name, kind, system, attribute,
// provenance.
trust_flake_sorted_outputs: fn(outputs: [FlakeOutput]) -> [FlakeOutput] Never! {
    sorted := outputs
    // Stable passes from the least significant field.
    sorted.sort_by(fn(output) { output.provenance })
    sorted.sort_by(fn(output) { output.attribute })
    sorted.sort_by(fn(output) { output.system })
    sorted.sort_by(fn(output) { output.kind.other_text() })
    sorted.sort_by(fn(output) { output.kind.rank() })
    sorted.sort_by(fn(output) { output.name })
    sorted
}

// Sorted outputs with exact duplicates removed, as a `BTreeSet` holds them.
trust_flake_output_set: fn(outputs: [FlakeOutput]) -> [FlakeOutput] Never! {
    unique := [FlakeOutput]{}
    loop output in trust_flake_sorted_outputs(outputs) {
        if unique.len() > 0 && unique[unique.len() - 1] == output -> next
        unique.push(output)
    }
    unique
}

// Rust `is_flake_revision`: at least seven ASCII hex digits.
trust_flake_is_revision: fn(value: String) -> Bool Never! {
    raw: value.bytes()
    if raw.len() < 7 -> return false
    loop byte in raw {
        if !trust_text_is_hex(Int{byte}) -> return false
    }
    true
}

// The fields of a URL query, sorted by key; None when a field has no `=`,
// an empty key, or a repeated key.
trust_flake_query_fields: fn(query: String) -> [FlakeQueryField]? Never! {
    fields := [FlakeQueryField]{}
    if query == "" -> return Val(fields)
    loop field in trust_text_split(query, TRUST_AMPERSAND) {
        parts: trust_text_split_first(field, TRUST_EQUALS) ?? return None
        if parts.before == "" || trust_flake_query_value(fields, parts.before) != None -> return None
        fields.push(FlakeQueryField{key: parts.before, value: parts.after})
    }
    fields.sort_by(fn(field) { field.key })
    Val(fields)
}

trust_flake_query_value: fn(fields: [FlakeQueryField], key: String) -> String? Never! {
    loop field in fields {
        if field.key == key -> return Val(field.value)
    }
    None
}

// The exact revision a flake URL pins: a `rev=` query field, else a
// hex-looking last path segment, else "".
trust_flake_revision: fn(url: String) -> String Never! {
    base := url.copy()
    if trust_text_split_first(url, TRUST_QUESTION) == {
        .Val(parts) -> {
            if trust_flake_query_fields(parts.after) == {
                .Val(fields) -> {
                    if trust_flake_query_value(fields, "rev") == {
                        .Val(revision) -> return revision
                        .None -> {}
                    }
                }
                .None -> {}
            }
            base = parts.before
        }
        .None -> {}
    }
    candidate: if trust_text_split_last(base, TRUST_SLASH) == {
        .Val(parts) -> parts.after
        .None -> base
    }
    if trust_flake_is_revision(candidate) -> return candidate
    ""
}

// Rust `flake_source_identity`: the typed source a flake URL names, or None
// for URL forms that only compare textually.
trust_flake_source_identity: fn(url: String) -> FlakeSourceIdentity? Never! {
    base := url.copy()
    query_text := ""
    if trust_text_split_first(url, TRUST_QUESTION) == {
        .Val(parts) -> {
            base = parts.before
            query_text = parts.after
        }
        .None -> {}
    }
    query: trust_flake_query_fields(query_text) ?? return None
    direct: trust_flake_direct_source(base) ?? return trust_flake_indirect_identity(base, query)
    segments := [String]{}
    loop part in trust_text_split(direct.after, TRUST_SLASH) {
        if part != "" -> segments.push(part)
    }
    if segments.len() < 2 -> return None
    tail := [String]{}
    loop index in 2..<segments.len() -> tail.push(segments[index])
    pin := FlakeSourcePin{reference: None, revision: None}
    if tail.len() > 0 {
        last: tail[tail.len() - 1]
        if {
            trust_flake_is_revision(last) -> {
                head := [String]{}
                loop index in 0..<(tail.len() - 1) -> head.push(tail[index])
                if head.len() > 0 -> pin.reference = Val(head.join("/"))
                pin.revision = Val(last)
            }
            else -> pin.reference = Val(tail.join("/"))
        }
    }
    queried: pin.with_query(query) ?? return None
    Val(FlakeSourceIdentity.Direct{kind: direct.before, owner: segments[0], repo: segments[1], pin: queried, query})
}

// `kind` and the path after a direct source prefix, or None for an
// indirect (registry) reference.
trust_flake_direct_source: fn(base: String) -> TrustTextSplit? Never! {
    prefixes: [TrustTextSplit]{
        {before: "github", after: "github:"},
        {before: "gitlab", after: "gitlab:"},
        {before: "sourcehut", after: "sourcehut:"},
        {before: "github", after: "https://github.com/"},
        {before: "gitlab", after: "https://gitlab.com/"}
    }
    loop prefix in prefixes {
        if base.starts_with(prefix.after) -> return Val(TrustTextSplit{before: prefix.before, after: base.removeprefix(prefix.after)})
    }
    None
}

// An indirect `[flake:]alias[/ref][/rev]` reference.
trust_flake_indirect_identity: fn(base: String, query: [FlakeQueryField]) -> FlakeSourceIdentity? Never! {
    path: if base.starts_with("flake:") -> base.removeprefix("flake:") else -> base.copy()
    if path == "" || path.starts_with(".") || path.starts_with("/") || path.contains(":") -> return None
    parts: trust_text_split(path, TRUST_SLASH)
    alias: parts[0]
    if alias == "" -> return None
    tail := [String]{}
    loop index in 1..<parts.len() {
        if parts[index] == "" -> return None
        tail.push(parts[index])
    }
    pin := FlakeSourcePin{reference: None, revision: None}
    if tail.len() == {
        0 -> {}
        1 -> {
            if {
                trust_flake_is_revision(tail[0]) -> pin.revision = Val(tail[0])
                else -> pin.reference = Val(tail[0])
            }
        }
        2 -> {
            if !trust_flake_is_revision(tail[1]) -> return None
            pin.reference = Val(tail[0])
            pin.revision = Val(tail[1])
        }
        else -> return None
    }
    queried: pin.with_query(query) ?? return None
    Val(FlakeSourceIdentity.Indirect{alias, pin: queried, query})
}
