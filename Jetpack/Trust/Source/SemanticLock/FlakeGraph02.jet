// Private continuation of the canonical SemanticLock owner.
// Rust: crates/jetpack/src/SemanticLock.rs:3606
// Replace OverlayInvalidation.trust_overlay_invalidations and its linear
// lookup helper on integration. Exact composite keys retain map semantics.
pub fn overlay_invalidations(before_fingerprints: [(overlay: String, package: String): String], after_fingerprints: [(overlay: String, package: String): String], actions_by_package: [String: [String]]) -> [OverlayInvalidation] Never! {
    // GATE #4499: tuple key equality/hash and lexicographic ordering.
    union := [(overlay: String, package: String): Bool]{}
    loop key in before_fingerprints.keys().to_list() -> union[key] = true
    loop key in after_fingerprints.keys().to_list() -> union[key] = true
    keys := union.keys().to_list()
    &keys.sort_by((left, right) -> (left.overlay <=> right.overlay).then(left.package <=> right.package))
    out := [OverlayInvalidation]{}
    loop key in keys {
        before :: before_fingerprints.get(key) ?? ""
        after :: after_fingerprints.get(key) ?? ""
        if before == after -> next
        affected :: actions_by_package.get(key.package) ?? [String]{"action:{key.package}"}
        reason :: if {
            before == "" -> "overlay `{key.overlay}` added package `{key.package}`"
            after == "" -> "overlay `{key.overlay}` removed package `{key.package}`"
            else -> "overlay `{key.overlay}` changed package `{key.package}` policy ({before} → {after})"
        }
        &out.push(OverlayInvalidation{overlay: key.overlay, package: key.package, policy_fingerprint_before: before, policy_fingerprint_after: after, affected_action_keys: affected, reason: reason})
    }
    out
}

// Rust: crates/jetpack/src/SemanticLock.rs:3652
// apply_overlay_invalidations -> OverlayInvalidation.trust_apply_overlay_invalidations:
// removes stale overlay records before clearing exact/suffix-matching hashes.
// Rust: crates/jetpack/src/SemanticLock.rs:3674
// live_path -> LockStore.trust_semantic_lock_live_path; canonical path carrier
// must become OSPath on integration, using PackageModel.pkg_lock_path.
// Rust: crates/jetpack/src/SemanticLock.rs:3680
// load -> LockStore.trust_semantic_lock_load; unreadable is None, contentless
// readable file is Some(empty), parsed semantic content is Some(parsed).
// Rust: crates/jetpack/src/SemanticLock.rs:3698
// strip_semantic_sections -> LockCodec.trust_strip_semantic_sections: exact
// four section headers and version-key removal, retains machine line bytes.
// Rust: crates/jetpack/src/SemanticLock.rs:3728
// merge_revalidate_commit -> LockStore.trust_semantic_lock_merge_revalidate_commit
// with LockValidation.trust_merge_for_commit: DomainConflict issues before
// commit, then revalidate and return the committed merged lock.

// Rust: crates/jetpack/src/SemanticLock.rs:3754
// Replace LockStore.trust_semantic_lock_atomic_commit: every boundary failure
// becomes the I/O arm, while revalidation remains the issues arm.
pub fn atomic_commit(project: OSPath, lock: SemanticLockFile) -[FS, Env, Exec, Time, Time.Wait]> TrustError! {
    trust_revalidate_semantic_lock(lock)
    path :: pkg_lock_path(project)
    // GATE #4494: real retained project-lock guard; hold through final write.
    _guard :: if env_runtime_project_lock(project, "semantic-lock") == {
        .Ok(guard) -> guard
        .Err(error) -> return Err(TrustError.IO(error.to_string()))
    }
    existing :: files.read(path) ?? ""
    stripped :: trust_strip_semantic_sections(existing)
    machine := stripped
    if stripped.trim() == "" {
        fresh := if pkg_lock_parse("version = 1\n") == {
            .Ok(parsed) -> parsed
            .Err(error) -> return Err(TrustError.IO(error.to_string()))
        }
        pkg_lock_ensure_build_stamp(project, &fresh)
        machine = pkg_lock_write(fresh)
    } else {
        parsed := if pkg_lock_parse(stripped) == {
            .Ok(parsed) -> parsed
            .Err(error) -> return Err(TrustError.IO(error.to_string()))
        }
        if parsed.build_stamp == None {
            pkg_lock_ensure_build_stamp(project, &parsed)
            machine = pkg_lock_write(parsed)
        }
    }
    semantic :: trust_write_semantic_lock(lock)
    trimmed := machine.trim_end() // #4303
    body :: if machine.trim() == "" -> "version = 1\n\n{semantic}" else -> "{trimmed}\n\n{semantic}"
    if pkg_lock_write_atomically(project, body.bytes()) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(TrustError.IO(error.to_string()))
    }
}
