// Explainable semantic lock records (E4-JP13).
//
// One live lock path: semantic records, the transitive input graph, source
// maps, and overlay invalidation facts share `.jet/lock` with the machine
// package and toolchain sections. Human rationale never enters the machine
// identity key.
use jet_pkg_model.[WorkspaceMember, pkg_overlay_sorted_unique]
use jet_foundation.[Variant]

enum LockRecordKind {
    Package
    SourceRef
    WorkspaceMember
    AdapterOutput
    SourceBuild
    CacheObject
    Toolchain
    SecretReference
    ServicePackage
    ImageInput
    ReplacementOverlay
    PackageOverlay
    FlakeComposition
    FlakeUnsupported
    FlakeEvaluator
    // Selected typed variant domain (E4-JP15).
    Variant
    // A kind this reader does not know, kept verbatim for round trips.
    Future(String)

    fn label(self) -> String Never! {
        if self == {
            .Package -> "package"
            .SourceRef -> "source-ref"
            .WorkspaceMember -> "workspace-member"
            .AdapterOutput -> "adapter-output"
            .SourceBuild -> "source-build"
            .CacheObject -> "cache-object"
            .Toolchain -> "toolchain"
            .SecretReference -> "secret-reference"
            .ServicePackage -> "service-package"
            .ImageInput -> "image-input"
            .ReplacementOverlay -> "replacement-overlay"
            .PackageOverlay -> "package-overlay"
            .FlakeComposition -> "flake-composition"
            .FlakeUnsupported -> "flake-unsupported"
            .FlakeEvaluator -> "flake-evaluator"
            .Variant -> "variant"
            .Future(raw) -> raw
        }
    }

    fn parse(raw: String) -> LockRecordKind Never! {
        if raw == {
            "package" -> LockRecordKind.Package
            "source-ref" -> LockRecordKind.SourceRef
            "workspace-member" -> LockRecordKind.WorkspaceMember
            "adapter-output" -> LockRecordKind.AdapterOutput
            "source-build" -> LockRecordKind.SourceBuild
            "cache-object" -> LockRecordKind.CacheObject
            "toolchain" -> LockRecordKind.Toolchain
            "secret-reference" -> LockRecordKind.SecretReference
            "service-package" -> LockRecordKind.ServicePackage
            "image-input" -> LockRecordKind.ImageInput
            "replacement-overlay" -> LockRecordKind.ReplacementOverlay
            "package-overlay" -> LockRecordKind.PackageOverlay
            "flake-composition" -> LockRecordKind.FlakeComposition
            "flake-unsupported" -> LockRecordKind.FlakeUnsupported
            "flake-evaluator" -> LockRecordKind.FlakeEvaluator
            "variant" -> LockRecordKind.Variant
            else -> LockRecordKind.Future(raw)
        }
    }
}

struct LockIdentity {
    kind: LockRecordKind
    key: String
    exact: String
    hash: String
    platform: String

    // `kind:key`: the merge and explain key.
    fn semantic_key(self) -> String Never! {
        "{self.kind.label()}:{self.key}"
    }

    // Every machine fact; two records agree exactly when these agree.
    fn machine_identity(self) -> String Never! {
        "{self.kind.label()}:{self.key}:{self.exact}:{self.hash}:{self.platform}"
    }
}

// Why a record exists and who asked for it. Never part of the identity.
struct LockRationale {
    owner_package: String
    reason: String
    source_ref: String
    provider: String
    channel_input: String
    exact_output: String
    policy_fingerprint: String
    recipe_id: String
    adapter_id: String
    signature: String
    cache_provenance: String
    update_command: String

    fn empty() -> LockRationale Never! {
        LockRationale{owner_package: "", reason: "", source_ref: "", provider: "", channel_input: "", exact_output: "", policy_fingerprint: "", recipe_id: "", adapter_id: "", signature: "", cache_provenance: "", update_command: ""}
    }

    // Set one `.jet/lock` rationale field by its key; unknown keys are ignored.
    fn set_field(&self, key: String, value: String) Never! {
        if key == {
            "owner-package" -> self.owner_package = value
            "reason" -> self.reason = value
            "source-ref" -> self.source_ref = value
            "provider" -> self.provider = value
            "channel-input" -> self.channel_input = value
            "exact-output" -> self.exact_output = value
            "policy-fingerprint" -> self.policy_fingerprint = value
            "recipe-id" -> self.recipe_id = value
            "adapter-id" -> self.adapter_id = value
            "signature" -> self.signature = value
            "cache-provenance" -> self.cache_provenance = value
            "update-command" -> self.update_command = value
            else -> {}
        }
    }
}

struct SemanticRecord {
    identity: LockIdentity
    rationales: [LockRationale]
    // Fields written by a newer lock, kept by key for round trips.
    future_fields: [String: String]

    fn new(identity: LockIdentity, rationale: LockRationale) -> SemanticRecord Never! {
        SemanticRecord{identity, rationales: [LockRationale]{rationale}, future_fields: [String: String]{}}
    }
}

// One flake-style lock input with an optional `follows` edge (E4-JP13).
struct LockInput {
    name: String
    url: String
    follows: String
}

// Package pattern -> allowed source authorities (dependency-confusion guard).
struct SourceMapEntry {
    pattern: String
    sources: [String]
}

struct SemanticLockFile {
    records: [SemanticRecord]
    inputs: [LockInput]
    source_maps: [SourceMapEntry]

    fn empty() -> SemanticLockFile Never! {
        SemanticLockFile{records: [SemanticRecord]{}, inputs: [LockInput]{}, source_maps: [SourceMapEntry]{}}
    }

    fn with_records(records: [SemanticRecord]) -> SemanticLockFile Never! {
        SemanticLockFile{records, inputs: [LockInput]{}, source_maps: [SourceMapEntry]{}}
    }

    // Drop every record of `kind` whose key is `key`.
    fn remove_records(&self, kind: LockRecordKind, key: String) Never! {
        kept := [SemanticRecord]{}
        loop record in self.records {
            if record.identity.kind == kind && record.identity.key == key -> next
            &kept.push(record)
        }
        self.records = kept
    }

    // Selective update: replace one semantic key; unrelated records keep
    // their bytes. Returns the replaced record.
    fn selective_update(&self, new_record: SemanticRecord) -> SemanticRecord? Never! {
        key :: new_record.identity.semantic_key()
        found := -1
        loop index in 0..<self.records.len() {
            if self.records[index].identity.semantic_key() == key {
                found = index
                break
            }
        }
        if found < 0 {
            &self.records.push(new_record)
            return None
        }
        previous :: self.records[found].copy()
        kept := [SemanticRecord]{}
        loop index in 0..<self.records.len() {
            if index != found -> &kept.push(self.records[index])
        }
        &kept.push(new_record)
        self.records = kept
        Val(previous)
    }

    // Record a selected typed variant (E4-JP15). `platform` holds the
    // canonical `PackageVariant::identity_key()`.
    fn record_selected_variant(&self, package: String, variant_identity: String, hash: String, reason: String) Never! {
        identity :: LockIdentity{kind: LockRecordKind.Variant, key: package, exact: variant_identity, hash, platform: variant_identity}
        rationale := LockRationale.empty()
        rationale.owner_package = package
        rationale.reason = reason
        rationale.provider = "native"
        rationale.exact_output = variant_identity
        &self.remove_records(LockRecordKind.Variant, package)
        &self.records.push(SemanticRecord.new(identity, rationale))
    }

    // Identity keys of every locked variant domain, sorted and unique.
    fn locked_variant_domains(self) -> [String] Never! {
        domains := [String]{}
        loop record in self.records {
            if record.identity.kind == LockRecordKind.Variant -> &domains.push(record.identity.exact)
        }
        pkg_overlay_sorted_unique(domains)
    }

    // Record a workspace catalog selection (E4-JP13).
    fn record_catalog_selection(&self, owner: String, logical_name: String, provider_ref: String, hash: String, platform: String, rationale: String) Never! {
        identity :: LockIdentity{kind: LockRecordKind.Package, key: logical_name, exact: provider_ref, hash, platform}
        provider :: if trust_text_split_first(provider_ref, TRUST_COLON) == {
            .Val(parts) -> parts.before
            .None -> provider_ref.copy()
        }
        why := LockRationale.empty()
        why.owner_package = owner
        why.reason = rationale
        why.source_ref = "catalog:{logical_name}"
        why.provider = provider
        why.exact_output = provider_ref
        why.adapter_id = "workspace.catalog"
        why.update_command = "jet update {logical_name}"
        &self.remove_records(LockRecordKind.Package, logical_name)
        &self.records.push(SemanticRecord.new(identity, why))
    }
}
