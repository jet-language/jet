// Three-way semantic lock merge and `jet explain` facts. Records merge by
// semantic key: equal machine identities union their rationales, a side
// that kept the base identity yields to the other, and two changed sides
// conflict only when one owner package explains both.

struct LockConflict {
    semantic_key: String
    owner_package: String
    left_identity: String
    right_identity: String
    left_reason: String
    right_reason: String
}

struct MergeOutcome {
    merged: SemanticLockFile
    conflicts: [LockConflict]
}

struct ExplainFact {
    semantic_key: String
    owners: [String]
    // Every rationale that competed for this resolved record. The first
    // rationale is not a sufficient explanation when overlays merge several
    // declarations into one winner.
    contenders: [LockRationale]
    provider: String
    platform: String
    exact_artifact: String
    policy_fingerprint: String
    update_command: String
    offline_satisfied: Bool
}

// The resolution of one semantic key present on both sides.
enum LockMergeStep {
    Keep(SemanticRecord)
    Conflict(LockConflict)
}

fn trust_merge_semantic_locks(base: SemanticLockFile, left: SemanticLockFile, right: SemanticLockFile) -> MergeOutcome Never! {
    base_by_key :: trust_lock_records_by_key(base)
    left_by_key :: trust_lock_records_by_key(left)
    right_by_key :: trust_lock_records_by_key(right)
    keys := left_by_key.keys().to_list()
    loop key in right_by_key.keys() -> &keys.push(key)
    merged := [SemanticRecord]{}
    conflicts := [LockConflict]{}
    loop key in pkg_overlay_sorted_unique(keys) {
        if left_by_key.get(key) == {
            .None -> {
                if right_by_key.get(key) == {
                    .Val(right_value) -> &merged.push(right_value)
                    .None -> {}
                }
            }
            .Val(left_value) -> {
                if right_by_key.get(key) == {
                    .None -> &merged.push(left_value)
                    .Val(right_value) -> {
                        if trust_merge_record_pair(base_by_key.get(key), left_value, right_value) == {
                            .Keep(record) -> &merged.push(record)
                            .Conflict(conflict) -> &conflicts.push(conflict)
                        }
                    }
                }
            }
        }
    }
    MergeOutcome{
        merged: SemanticLockFile{records: merged, inputs: trust_merge_lock_inputs(base, left, right), source_maps: trust_merge_source_maps(base, left, right)},
        conflicts
    }
}

// Equal identities union rationales; a side still at the base identity
// yields; otherwise a shared owner package is a conflict.
fn trust_merge_record_pair(base: SemanticRecord?, left: SemanticRecord, right: SemanticRecord) -> LockMergeStep Never! {
    left_identity :: left.identity.machine_identity()
    right_identity :: right.identity.machine_identity()
    if left_identity == right_identity -> return LockMergeStep.Keep(trust_merge_rationales(left, right.rationales))
    if base == {
        .Val(base_record) -> {
            base_identity :: base_record.identity.machine_identity()
            if left_identity == base_identity -> return LockMergeStep.Keep(right)
            if right_identity == base_identity -> return LockMergeStep.Keep(left)
        }
        .None -> {}
    }
    if trust_lock_conflict(left, right) == {
        .Val(conflict) -> LockMergeStep.Conflict(conflict)
        .None -> LockMergeStep.Keep(trust_merge_rationales(left, right.rationales))
    }
}

// Records by semantic key; a later duplicate replaces an earlier one.
fn trust_lock_records_by_key(lock: SemanticLockFile) -> [String: SemanticRecord] Never! {
    by_key := [String: SemanticRecord]{}
    loop record in lock.records -> by_key[record.identity.semantic_key()] = record.copy()
    by_key
}

// Right over left over base for one input name, in name order.
fn trust_merge_lock_inputs(base: SemanticLockFile, left: SemanticLockFile, right: SemanticLockFile) -> [LockInput] Never! {
    by_name := [String: LockInput]{}
    loop input in base.inputs -> by_name[input.name] = input.copy()
    loop input in left.inputs -> by_name[input.name] = input.copy()
    loop input in right.inputs -> by_name[input.name] = input.copy()
    names := by_name.keys().to_list()
    &names.sort()
    merged := [LockInput]{}
    loop name in names -> &merged.push(by_name[name])
    merged
}

// Right over left over base for one pattern, in pattern order.
fn trust_merge_source_maps(base: SemanticLockFile, left: SemanticLockFile, right: SemanticLockFile) -> [SourceMapEntry] Never! {
    by_pattern := [String: SourceMapEntry]{}
    loop map in base.source_maps -> by_pattern[map.pattern] = map.copy()
    loop map in left.source_maps -> by_pattern[map.pattern] = map.copy()
    loop map in right.source_maps -> by_pattern[map.pattern] = map.copy()
    patterns := by_pattern.keys().to_list()
    &patterns.sort()
    merged := [SourceMapEntry]{}
    loop pattern in patterns -> &merged.push(by_pattern[pattern])
    merged
}

// `existing` plus each incoming rationale whose (owner, reason) is new.
fn trust_merge_rationales(existing: SemanticRecord, incoming: [LockRationale]) -> SemanticRecord Never! {
    merged := existing
    loop rationale in incoming {
        seen := false
        loop kept in merged.rationales {
            if kept.owner_package == rationale.owner_package && kept.reason == rationale.reason {
                seen = true
                break
            }
        }
        if !seen -> &merged.rationales.push(rationale)
    }
    merged
}

// The first owner package that explains both sides.
fn trust_lock_conflict(left: SemanticRecord, right: SemanticRecord) -> LockConflict? Never! {
    loop left_rationale in left.rationales {
        loop right_rationale in right.rationales {
            if left_rationale.owner_package == right_rationale.owner_package {
                return Val(LockConflict{
                    semantic_key: left.identity.semantic_key(),
                    owner_package: left_rationale.owner_package,
                    left_identity: left.identity.machine_identity(),
                    right_identity: right.identity.machine_identity(),
                    left_reason: left_rationale.reason,
                    right_reason: right_rationale.reason
                })
            }
        }
    }
    None
}

// Rust `SemanticLock::explain`.
fn trust_explain_semantic_lock(lock: SemanticLockFile, key: String) -> ExplainFact? Never! {
    loop record in lock.records {
        if record.identity.semantic_key() != key -> next
        owners := [String]{}
        loop rationale in record.rationales {
            if rationale.owner_package != "" -> &owners.push(rationale.owner_package)
        }
        first :: if record.rationales.len() > 0 -> record.rationales[0] else -> LockRationale.empty()
        return Val(ExplainFact{
            semantic_key: key,
            owners: pkg_overlay_sorted_unique(owners),
            contenders: record.rationales,
            provider: first.provider,
            platform: record.identity.platform,
            exact_artifact: record.identity.exact,
            policy_fingerprint: first.policy_fingerprint,
            update_command: first.update_command,
            offline_satisfied: record.identity.hash != ""
        })
    }
    None
}
