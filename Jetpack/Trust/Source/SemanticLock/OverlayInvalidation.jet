// Exact overlay/patch invalidation facts (E4-JP13): diff two overlay policy
// fingerprint sets, name exactly which action keys must rebuild, and apply
// that to the lock by dropping stale overlay records and clearing the hashes
// of affected packages so offline realize fails until they rebuild.

// One `(overlay, package)` policy fingerprint.
pub struct OverlayFingerprint {
    pub overlay: String
    pub package: String
    pub fingerprint: String
}

pub struct OverlayInvalidation {
    pub overlay: String
    pub package: String
    pub policy_fingerprint_before: String
    pub policy_fingerprint_after: String
    pub affected_action_keys: [String]
    pub reason: String
}

// Every `(overlay, package)` whose fingerprint changed, in (overlay, package)
// order. A package without declared actions invalidates `action:<package>`.
pub fn trust_overlay_invalidations(before: [OverlayFingerprint], after: [OverlayFingerprint], actions_by_package: [String: [String]]) -> [OverlayInvalidation] Never! {
    keys := [OverlayFingerprint]{}
    loop entry in before -> &keys.push(entry)
    loop entry in after -> &keys.push(entry)
    &keys.sort_by((left: OverlayFingerprint, right: OverlayFingerprint) -> (left.overlay <=> right.overlay).then(left.package <=> right.package))
    out := [OverlayInvalidation]{}
    previous_overlay := ""
    previous_package := ""
    loop index in 0..<keys.len() {
        overlay :: keys[index].overlay
        package :: keys[index].package
        if index > 0 && overlay == previous_overlay && package == previous_package -> next
        previous_overlay = ~overlay
        previous_package = ~package
        fingerprint_before :: trust_overlay_fingerprint(before, overlay, package)
        fingerprint_after :: trust_overlay_fingerprint(after, overlay, package)
        if fingerprint_before == fingerprint_after -> next
        affected :: actions_by_package.get(package) ?? [String]{"action:{package}"}
        reason :: if {
            fingerprint_before == "" -> "overlay `{overlay}` added package `{package}`"
            fingerprint_after == "" -> "overlay `{overlay}` removed package `{package}`"
            else -> "overlay `{overlay}` changed package `{package}` policy ({fingerprint_before} → {fingerprint_after})"
        }
        &out.push(OverlayInvalidation{overlay, package, policy_fingerprint_before: fingerprint_before, policy_fingerprint_after: fingerprint_after, affected_action_keys: affected, reason})
    }
    out
}

// The fingerprint recorded for `(overlay, package)`, the last one when
// repeated, or "" when absent.
fn trust_overlay_fingerprint(entries: [OverlayFingerprint], overlay: String, package: String) -> String Never! {
    found := ""
    loop entry in entries {
        if entry.overlay == overlay && entry.package == package -> found = entry.fingerprint
    }
    found
}

// Drop each invalidated `package-overlay` record and clear the hash of
// every record the invalidation names by package or action key.
pub fn trust_apply_overlay_invalidations(lock: &SemanticLockFile, invalidations: [OverlayInvalidation]) Never! {
    loop invalidation in invalidations {
        &lock.remove_records(LockRecordKind.PackageOverlay, "{invalidation.overlay}:{invalidation.package}")
        loop index in 0..<lock.records.len() {
            key :: lock.records[index].identity.key
            affected := key == invalidation.package
            loop action in invalidation.affected_action_keys {
                if action == key || action.ends_with(":{key}") -> affected = true
            }
            if affected -> lock.records[index].identity.hash = ""
        }
    }
}
