// The native `flake.lock` graph: JSON read through the Core JSON codec
// (`core.encoding.json`), node references and follow paths, root input
// identity checks, and the JSON the semantic lock records for lock nodes,
// registries, and flake-parts compositions.
//
// Where the Rust reference embeds a `jet_foundation::JSON` error, these
// messages embed the Core JSON error reason instead.

// The Rust `DataTree` accessor failures the reference embeds in its errors.
TRUST_JSON_NOT_OBJECT :: prep { "expected a DataTree object" }
TRUST_JSON_NOT_ARRAY :: prep { "expected a DataTree array" }
TRUST_JSON_NOT_STRING :: prep { "expected a DataTree string" }

// The Nix base32 alphabet of a `/nix/store/.links/<hash>` entry.
TRUST_NIX_BASE32 :: prep { "0123456789abcdfghijklmnpqrsvwxyz" }

// A JSON document, or the Core JSON error reason when it does not parse.
enum TrustJSONDocument {
    Parsed(DataTree)
    Failed(String)

    fn tree(self) -> DataTree? Never! {
        if self == {
            .Parsed(tree) -> Val(tree)
            .Failed(_) -> None
        }
    }

    fn reason(self) -> String Never! {
        if self == {
            .Parsed(_) -> ""
            .Failed(reason) -> reason
        }
    }
}

// Whether an optional text is present and equal to `expected`.
fn trust_text_is(value: String?, expected: String) -> Bool Never! {
    if value == {
        .Val(text) -> text == expected
        .None -> false
    }
}

// One field of a JSON object rendered in declaration order.
struct TrustJSONField {
    key: String
    value: DataTree
}

// One step of a `flake.lock` follow path: the node it leaves and the input
// it follows.
struct FlakeFollowStep {
    node: String
    input: String
}

// Rust `JSON::parse`.
fn trust_json_parse(text: String) -> TrustJSONDocument Never! {
    if json.parse(text) == {
        .Ok(tree) -> TrustJSONDocument.Parsed(tree)
        .Err(error) -> TrustJSONDocument.Failed(error.reason)
    }
}

// Rust `JSON::parse_lenient`: drop the known Nix provider noise lines
// before parsing; a failure lists the dropped lines after the error.
fn trust_json_parse_lenient(input: String) -> TrustJSONDocument Never! {
    raw :: input.bytes()
    kept := [U8]{}
    noise := [String]{}
    start := 0
    loop start < raw.len() {
        newline :: trust_text_find_byte(raw, TRUST_NEWLINE, start)
        end :: if newline < 0 -> raw.len() else -> newline + 1
        content_end := if newline < 0 -> raw.len() else -> newline
        if content_end > start && Int.from_u8(raw[content_end - 1]) == TRUST_CARRIAGE_RETURN -> content_end -= 1
        content :: pkg_bytes_text(raw, start, content_end)
        if {
            trust_json_is_provider_noise(content) -> &noise.push(content)
            else -> loop index in start..<end -> &kept.push(raw[index])
        }
        start = end
    }
    if trust_json_parse(String.from_bytes(kept) ?? ~input) == {
        .Parsed(tree) -> TrustJSONDocument.Parsed(tree)
        .Failed(reason) -> TrustJSONDocument.Failed(trust_json_with_noise(reason, noise))
    }
}

fn trust_json_with_noise(error: String, noise: [String]) -> String Never! {
    if noise.len() == 0 -> return ~error
    lines := [String]{"{error}\nfiltered provider noise:"}
    loop line in noise -> &lines.push("\n  {line}")
    lines.join("")
}

// Nix warnings and the store's `"<store>/.links/<hash>" has maximum number
// of links` complaint.
fn trust_json_is_provider_noise(line: String) -> Bool Never! {
    trimmed :: line.trim()
    if trimmed.starts_with("warning:") -> return true
    if !trimmed.starts_with("\"") -> return false
    quoted :: trimmed.removeprefix("\"")
    suffix :: "\" has maximum number of links"
    if !quoted.ends_with(suffix) -> return false
    path :: quoted.removesuffix(suffix)
    parts :: trust_text_split_last_text(path, "/.links/") ?? return false
    if !parts.before.starts_with("/") || !parts.before.ends_with("/store") || path.contains("\"") -> return false
    link :: parts.after.bytes()
    if link.len() != 52 -> return false
    alphabet :: TRUST_NIX_BASE32.bytes()
    loop byte in link {
        if !alphabet.contains(byte) -> return false
    }
    true
}

// Parse `text`; a failure is `Io("{context}: {reason}")`.
fn trust_json_parse_or_io(text: String, context: String) -> DataTree TrustError! {
    if trust_json_parse(text) == {
        .Parsed(tree) -> return Ok(tree)
        .Failed(reason) -> return Err(TrustError.IO("{context}: {reason}"))
    }
}

// A JSON object stored in a semantic lock record; any failure is an
// unsupported assignment.
fn trust_json_parse_record(raw: String) -> [String: DataTree] TrustError! {
    document :: trust_json_parse_lenient(raw)
    tree :: document.tree() ?? return Err(TrustError.InvalidAssignment(document.reason()))
    trust_json_object(tree) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_OBJECT))
}

fn trust_json_object(value: DataTree) -> [String: DataTree]? Never! {
    if value == {
        .Object(fields) -> Val(fields)
        else -> None
    }
}

fn trust_json_array(value: DataTree) -> [DataTree]? Never! {
    if value == {
        .Array(items) -> Val(items)
        else -> None
    }
}

fn trust_json_string(value: DataTree) -> String? Never! {
    if value == {
        .Text(text) -> Val(text)
        else -> None
    }
}

fn trust_json_bool(value: DataTree) -> Bool? Never! {
    if value == {
        .Bool(flag) -> Val(flag)
        else -> None
    }
}

// Rust `json_string_field`: the string at `key`, if it is one.
fn trust_json_string_field(object: [String: DataTree], key: String) -> String? Never! {
    value :: object.get(key) ?? return None
    trust_json_string(value)
}

// The object at `key` of an object value.
fn trust_json_object_field(value: DataTree, key: String) -> [String: DataTree]? Never! {
    fields :: trust_json_object(value) ?? return None
    field :: fields.get(key) ?? return None
    trust_json_object(field)
}

// Rust `canonical_json`: compact JSON, object keys in document order.
fn trust_json_canonical(value: DataTree) -> String Never! {
    json.to_string(value)
}

// Rust `canonical_object`: the field's JSON, or `{}` when absent.
fn trust_json_canonical_field(object: [String: DataTree], key: String) -> String Never! {
    value :: object.get(key) ?? return "{{}}"
    trust_json_canonical(value)
}

fn trust_json_quote(text: String) -> String Never! {
    trust_json_canonical(DataTree.Text(~text))
}

fn trust_json_texts(values: [String]) -> DataTree Never! {
    items := [DataTree]{}
    loop value in values -> &items.push(DataTree.Text(~value))
    DataTree.Array(items)
}

// An object rendered with its fields in the given order.
fn trust_json_object_text(fields: [TrustJSONField]) -> String Never! {
    object := [String: DataTree]{}
    loop field in fields -> object[field.key] = field.value
    trust_json_canonical(DataTree.Object(object))
}

fn trust_flake_find_node(nodes: [FlakeLockNode], name: String) -> FlakeLockNode? Never! {
    loop node in nodes {
        if node.name == name -> return Val(node)
    }
    None
}

// Nodes in Rust's derived order; names are unique by the time they sort.
fn trust_flake_sorted_lock_nodes(nodes: [FlakeLockNode]) -> [FlakeLockNode] Never! {
    sorted := nodes
    &sorted.sort_by(node -> node.locked)
    &sorted.sort_by(node -> node.original)
    &sorted.sort_by(node -> node.name)
    sorted
}

fn trust_flake_sorted_edges(edges: [FlakeLockEdge]) -> [FlakeLockEdge] Never! {
    sorted := edges
    &sorted.sort_by(edge -> edge.target)
    &sorted.sort_by(edge -> edge.name)
    sorted
}

fn trust_flake_sorted_registries(entries: [FlakeRegistryEntry]) -> [FlakeRegistryEntry] Never! {
    sorted := entries
    &sorted.sort_by(entry -> entry.locked)
    &sorted.sort_by(entry -> entry.original)
    &sorted.sort_by(entry -> entry.node)
    &sorted.sort_by(entry -> entry.alias)
    sorted
}

fn trust_sorted_keys(object: [String: DataTree]) -> [String] Never! {
    keys := object.keys().to_list()
    &keys.sort()
    keys
}

// Rust `lock_node_name`: the node a `flake.lock` input reference names.
pub fn trust_flake_lock_node_name(reference: DataTree?, nodes: [String: DataTree], start_node: String) -> String? TrustError! {
    value :: reference ?? return Ok(None)
    trust_flake_resolve_reference(value, nodes, [FlakeFollowStep]{}, start_node)
}

fn trust_flake_resolve_reference(value: DataTree, nodes: [String: DataTree], path: [FlakeFollowStep], start_node: String) -> String? TrustError! {
    if value == {
        .Text(name) -> {
            if name == "" -> return Err(TrustError.IO("flake.lock node reference is empty"))
            return Ok(Val(name))
        }
        .Array(segments) -> return trust_flake_resolve_follow_path(segments, nodes, path, start_node)
        else -> return Err(TrustError.IO("flake.lock node reference must be a node name or node list"))
    }
}

fn trust_flake_resolve_follow_path(segments: [DataTree], nodes: [String: DataTree], path: [FlakeFollowStep], start_node: String) -> String? TrustError! {
    if segments.len() == 0 -> return Ok(None)
    // Nix uses a one-element array as a direct node reference when an input
    // follows a node outside the current input map. Resolve that form before
    // treating the array as an input path; otherwise
    // `flake-utils.inputs.systems = ["systems"]` asks for `systems` twice and
    // looks like a cycle.
    if segments.len() == 1 {
        direct :: trust_json_string(segments[0]) ?? ""
        if direct != "" && nodes.has_key(direct) -> return Ok(Val(direct))
    }
    current := ~start_node
    loop value in segments {
        segment :: trust_json_string(value) ?? return Err(TrustError.IO("flake.lock node reference array must contain strings: {TRUST_JSON_NOT_STRING}"))
        if segment == "" -> return Err(TrustError.IO("flake.lock node reference array must contain non-empty strings"))
        step :: FlakeFollowStep{node: ~current, input: ~segment}
        if path.contains(step) -> return Err(TrustError.IO("flake.lock follow path cycles at `{segment}`"))
        node :: nodes.get(current) ?? return Err(TrustError.IO("flake.lock follow path starts at missing node `{current}`"))
        inputs :: trust_json_object_field(node, "inputs") ?? return Err(TrustError.IO("flake.lock follow path node `{current}` has no inputs map"))
        target :: inputs.get(segment) ?? return Err(TrustError.IO("flake.lock follow path `{segment}` is missing from node `{current}`"))
        deeper := path
        &deeper.push(step)
        resolved :: trust_flake_resolve_reference(target, nodes, deeper, current)
        current = resolved ?? return Err(TrustError.IO("flake.lock follow path `{segment}` resolves to an empty node reference"))
    }
    Ok(Val(current))
}

// Rust `flake_lock_node_values`: each node as `{"inputs": {...}}` with its
// edge targets parsed, the map a follow path walks.
fn trust_flake_lock_node_values(nodes: [FlakeLockNode]) -> [String: DataTree] TrustError! {
    values := [String: DataTree]{}
    loop node in nodes {
        inputs := [String: DataTree]{}
        loop edge in node.inputs {
            target :: trust_json_parse_or_io(edge.target, "flake.lock node `{node.name}` input `{edge.name}` is invalid")
            if inputs.get(edge.name) == None -> inputs[edge.name] = target
        }
        wrapper := [String: DataTree]{}
        wrapper["inputs"] = DataTree.Object(inputs)
        values[node.name] = DataTree.Object(wrapper)
    }
    Ok(values)
}

// Rust `indirect_registry_alias`: the registry alias an `original` object
// names when its type is `indirect`.
pub fn trust_flake_indirect_alias(original: String) -> String? TrustError! {
    tree :: trust_json_parse_or_io(original, "flake.lock original metadata is invalid")
    object :: trust_json_object(tree) ?? return Err(TrustError.IO("flake.lock original metadata is invalid: {TRUST_JSON_NOT_OBJECT}"))
    kind_value :: object.get("type") ?? return Ok(None)
    kind :: trust_json_string(kind_value) ?? return Err(TrustError.IO("flake.lock original type is invalid: {TRUST_JSON_NOT_STRING}"))
    if kind != "indirect" -> return Ok(None)
    id_value :: object.get("id") ?? return Err(TrustError.IO("flake.lock indirect input has no id"))
    alias :: trust_json_string(id_value) ?? return Err(TrustError.IO("flake.lock indirect id is invalid: {TRUST_JSON_NOT_STRING}"))
    if alias == "" -> return Err(TrustError.IO("flake.lock indirect input has an empty id"))
    Ok(Val(alias))
}

// One lock node's `original` or `locked` object.
fn trust_flake_node_object(text: String, node_name: String) -> [String: DataTree] TrustError! {
    tree :: trust_json_parse_or_io(text, "flake.lock node `{node_name}` is invalid")
    trust_json_object(tree) ?? return Err(TrustError.IO("flake.lock node `{node_name}` is invalid: {TRUST_JSON_NOT_OBJECT}"))
}

// Rust `validate_root_input_identity`: the lock node a root input maps to
// must be the source its flake.nix URL (or follows edge) names.
fn trust_flake_check_root_input(input: FlakeInput, node_name: String, node: FlakeLockNode, root_inputs: [String: DataTree], nodes: [String: DataTree], validate_revision: Bool) TrustError! {
    original :: trust_flake_node_object(node.original, node_name)
    locked :: trust_flake_node_object(node.locked, node_name)
    if input.follows != "" {
        follows_reference :: root_inputs.get(input.follows) ?? return Err(TrustError.IO("flake.lock root input `{input.name}` follows missing root input `{input.follows}`"))
        resolved :: trust_flake_lock_node_name(Val(follows_reference), nodes, "root")
        follows :: resolved ?? return Err(TrustError.IO("flake.lock root input `{input.name}` follows an empty root input `{input.follows}`"))
        if follows != node_name -> return Err(TrustError.IO("flake.lock root input `{input.name}` follows `{input.follows}` but maps to node `{node_name}`"))
        if validate_revision && input.revision != "" && !trust_text_is(trust_json_string_field(locked, "rev"), input.revision) {
            return Err(TrustError.IO("flake.lock root input `{input.name}` has a different locked revision"))
        }
        return
    }
    // Keep malformed indirect metadata fail-closed even when source identity
    // parsing falls back to the generic URL form.
    _ :: trust_flake_indirect_alias(node.original)
    if !trust_flake_source_matches(input, original, locked, validate_revision) {
        return Err(TrustError.IO("flake.lock root input `{input.name}` maps to node `{node_name}` with a different source URL or indirect alias"))
    }
}

// Whether a lock node's metadata names the source `input.url` declares.
fn trust_flake_source_matches(input: FlakeInput, original: [String: DataTree], locked: [String: DataTree], validate_revision: Bool) -> Bool Never! {
    identity :: trust_flake_source_identity(input.url) ?? return trust_flake_url_matches(input.url, original)
    if identity == {
        .Direct(kind, owner, repo, pin, query) -> {
            same_source :: trust_text_is(trust_json_string_field(original, "type"), kind) && trust_text_is(trust_json_string_field(original, "owner"), owner) && trust_text_is(trust_json_string_field(original, "repo"), repo)
            same_source && trust_json_string_field(original, "ref") == pin.reference && trust_flake_query_matches(query, original, locked, validate_revision) && trust_flake_revision_matches(pin.revision, input, locked, validate_revision)
        }
        .Indirect(alias, pin, query) -> {
            same_alias :: trust_text_is(trust_json_string_field(original, "type"), "indirect") && trust_text_is(trust_json_string_field(original, "id"), alias)
            same_alias && trust_json_string_field(original, "ref") == pin.reference && trust_flake_query_matches(query, original, locked, validate_revision) && trust_flake_revision_matches(pin.revision, input, locked, validate_revision)
        }
    }
}

// A URL without a typed identity matches the node's `original.url` by base
// and by query fields.
fn trust_flake_url_matches(url: String, original: [String: DataTree]) -> Bool Never! {
    original_url :: trust_json_string_field(original, "url") ?? return false
    source :: trust_text_split_first(url, TRUST_QUESTION) ?? TrustTextSplit{before: url, after: ""}
    recorded :: trust_text_split_first(original_url, TRUST_QUESTION) ?? TrustTextSplit{before: original_url, after: ""}
    recorded.before == source.before && trust_flake_query_fields(recorded.after) == trust_flake_query_fields(source.after)
}

// Rust `source_query_matches`: every URL query field agrees with the node's
// `original` (then `locked`) metadata; `rev` is checked against `locked`
// only when revisions are validated.
fn trust_flake_query_matches(query: [FlakeQueryField], original: [String: DataTree], locked: [String: DataTree], validate_revision: Bool) -> Bool Never! {
    loop field in query {
        if field.key == "rev" && !validate_revision -> next
        actual :: if field.key == "rev" -> trust_json_string_field(locked, "rev") else -> trust_flake_metadata_string(original, locked, field.key)
        if !trust_text_is(actual, field.value) -> return false
    }
    true
}

// The string at `key` in `original`, else in `locked`.
fn trust_flake_metadata_string(original: [String: DataTree], locked: [String: DataTree], key: String) -> String? Never! {
    if original.get(key) == {
        .Val(value) -> trust_json_string(value)
        .None -> trust_json_string_field(locked, key)
    }
}

// Rust `source_revision_matches`.
fn trust_flake_revision_matches(revision: String?, input: FlakeInput, locked: [String: DataTree], validate_revision: Bool) -> Bool Never! {
    if !validate_revision -> return true
    locked_revision :: trust_json_string_field(locked, "rev")
    if revision == {
        .Val(expected) -> {
            if !trust_text_is(locked_revision, expected) -> return false
        }
        .None -> {}
    }
    input.revision == "" || trust_text_is(locked_revision, input.revision)
}

// Rust `validate_semantic_root_inputs`: the root node recorded in a semantic
// lock must still map every declared input to its source.
fn trust_flake_check_semantic_root_inputs(graph: FlakeGraph) TrustError! {
    root :: trust_flake_find_node(graph.lock_nodes, "root") ?? return
    nodes :: trust_flake_lock_node_values(graph.lock_nodes)
    root_inputs := [String: DataTree]{}
    loop edge in root.inputs {
        if trust_json_parse(edge.target) == {
            .Parsed(target) -> root_inputs[edge.name] = target
            .Failed(reason) -> return Err(TrustError.StaleSemanticLock("root input `{edge.name}` is invalid: {reason}"))
        }
    }
    source_names := [String]{}
    loop input in graph.inputs -> &source_names.push(input.name)
    loop name in trust_sorted_keys(root_inputs) {
        if !source_names.contains(name) -> return Err(TrustError.StaleSemanticLock("root input `{name}` is not declared by flake.nix"))
    }
    loop input in graph.inputs {
        reference :: root_inputs.get(input.name) ?? return Err(TrustError.StaleSemanticLock("root input `{input.name}` is missing from the lock"))
        resolved :: trust_flake_lock_node_name(Val(reference), nodes, "root")
        node_name :: resolved ?? return Err(TrustError.StaleSemanticLock("root input `{input.name}` has no node reference"))
        node :: trust_flake_find_node(graph.lock_nodes, node_name) ?? return Err(TrustError.StaleSemanticLock("root input `{input.name}` points to missing node `{node_name}`"))
        trust_flake_check_root_input(input, node_name, node, root_inputs, nodes, true)
    }
}

// One node of a `flake.lock` `nodes` map: only `root` may omit, and must
// omit, `original`/`locked`, which are non-empty objects elsewhere.
fn trust_flake_read_lock_node(name: String, value: DataTree) -> FlakeLockNode TrustError! {
    object :: trust_json_object(value) ?? return Err(TrustError.IO("flake.lock node `{name}` is invalid: {TRUST_JSON_NOT_OBJECT}"))
    if name == "" -> return Err(TrustError.IO("flake.lock node name is empty"))
    has_original :: object.has_key("original")
    has_locked :: object.has_key("locked")
    root :: name == "root"
    if {
        root && (has_original || has_locked) -> return Err(TrustError.IO("flake.lock root node must not carry original/locked metadata"))
        !root && !has_original -> return Err(TrustError.IO("flake.lock node `{name}` is missing `original` metadata"))
        !root && !has_locked -> return Err(TrustError.IO("flake.lock node `{name}` is missing `locked` metadata"))
        else -> {}
    }
    if !root {
        original :: trust_json_object(object.get("original") ?? DataTree.Null) ?? return Err(TrustError.IO("flake.lock node `{name}` original metadata is not an object"))
        locked :: trust_json_object(object.get("locked") ?? DataTree.Null) ?? return Err(TrustError.IO("flake.lock node `{name}` locked metadata is not an object"))
        if original.len() == 0 || locked.len() == 0 -> return Err(TrustError.IO("flake.lock node `{name}` has empty original/locked metadata"))
    }
    inputs := [FlakeLockEdge]{}
    if object.get("inputs") == {
        .Val(declared) -> {
            edges :: trust_json_object(declared) ?? return Err(TrustError.IO("flake.lock node `{name}` inputs are invalid: {TRUST_JSON_NOT_OBJECT}"))
            loop edge in edges -> &inputs.push(FlakeLockEdge{name: edge.key, target: trust_json_canonical(edge.value)})
        }
        .None -> {}
    }
    Ok(FlakeLockNode{name, original: trust_json_canonical_field(object, "original"), locked: trust_json_canonical_field(object, "locked"), inputs})
}

// Rust `flake_lock_node_json`.
fn trust_flake_lock_node_json(node: FlakeLockNode) -> String Never! {
    edges := [String]{}
    loop edge in node.inputs -> &edges.push("{{\"name\":{trust_json_quote(edge.name)},\"target\":{edge.target}}}")
    "{{\"inputs\":[{edges.join(",")}],\"locked\":{node.locked},\"name\":{trust_json_quote(node.name)},\"original\":{node.original}}}"
}

// Rust `flake_registry_json`.
fn trust_flake_registry_json(entry: FlakeRegistryEntry) -> String Never! {
    "{{\"alias\":{trust_json_quote(entry.alias)},\"locked\":{entry.locked},\"node\":{trust_json_quote(entry.node)},\"original\":{entry.original}}}"
}

// Rust `composition_json`.
fn trust_flake_composition_json(composition: FlakeComposition) -> String Never! {
    trust_json_object_text([TrustJSONField]{
        TrustJSONField{key: "framework", value: DataTree.Text(~composition.framework)},
        TrustJSONField{key: "modules", value: trust_json_texts(composition.modules)},
        TrustJSONField{key: "moduleSources", value: trust_json_texts(composition.module_sources)},
        TrustJSONField{key: "perSystem", value: DataTree.Bool(composition.per_system)},
        TrustJSONField{key: "systems", value: trust_json_texts(composition.systems)}
    })
}

// Rust `parse_flake_lock_node`: a `flake-lock-node:` record's exact JSON.
fn trust_flake_parse_lock_node(raw: String) -> FlakeLockNode TrustError! {
    object :: trust_json_parse_record(raw)
    declared :: object.get("inputs") ?? return Err(TrustError.InvalidAssignment("missing lock node inputs"))
    items :: trust_json_array(declared) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_ARRAY))
    inputs := [FlakeLockEdge]{}
    loop item in items {
        edge :: trust_json_object(item) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_OBJECT))
        edge_name :: edge.get("name") ?? return Err(TrustError.InvalidAssignment("missing lock edge name"))
        name :: trust_json_string(edge_name) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
        target :: edge.get("target") ?? return Err(TrustError.InvalidAssignment("missing lock edge target"))
        &inputs.push(FlakeLockEdge{name, target: trust_json_canonical(target)})
    }
    original :: object.get("original") ?? return Err(TrustError.InvalidAssignment("missing lock node original"))
    locked :: object.get("locked") ?? return Err(TrustError.InvalidAssignment("missing lock node locked"))
    name_value :: object.get("name") ?? return Err(TrustError.InvalidAssignment("missing lock node field `name`"))
    name :: trust_json_string(name_value) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
    original_fields :: trust_json_object(original) ?? return Err(TrustError.InvalidAssignment("lock node original/locked must be objects"))
    locked_fields :: trust_json_object(locked) ?? return Err(TrustError.InvalidAssignment("lock node original/locked must be objects"))
    empty :: original_fields.len() == 0 || locked_fields.len() == 0
    if {
        name == "" -> return Err(TrustError.InvalidAssignment("lock node name is empty"))
        name == "root" && (original_fields.len() > 0 || locked_fields.len() > 0) -> return Err(TrustError.InvalidAssignment("root lock node original/locked must be empty objects"))
        name != "root" && empty -> return Err(TrustError.InvalidAssignment("non-root lock node original/locked must be non-empty objects"))
        else -> {}
    }
    Ok(FlakeLockNode{name, original: trust_json_canonical(original), locked: trust_json_canonical(locked), inputs: trust_flake_sorted_edges(inputs)})
}

// Rust `parse_flake_registry`: a `flake-registry:` record's exact JSON.
fn trust_flake_parse_registry(raw: String) -> FlakeRegistryEntry TrustError! {
    object :: trust_json_parse_record(raw)
    original :: object.get("original") ?? return Err(TrustError.InvalidAssignment("missing registry original"))
    locked :: object.get("locked") ?? return Err(TrustError.InvalidAssignment("missing registry locked"))
    original_fields :: trust_json_object(original) ?? return Err(TrustError.InvalidAssignment("registry original/locked must be objects"))
    locked_fields :: trust_json_object(locked) ?? return Err(TrustError.InvalidAssignment("registry original/locked must be objects"))
    if original_fields.len() == 0 || locked_fields.len() == 0 -> return Err(TrustError.InvalidAssignment("registry original/locked must be non-empty objects"))
    alias_value :: object.get("alias") ?? return Err(TrustError.InvalidAssignment("missing registry field `alias`"))
    alias :: trust_json_string(alias_value) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
    original_json :: trust_json_canonical(original)
    recorded :: trust_flake_indirect_alias(original_json)
    if !trust_text_is(recorded, alias) -> return Err(TrustError.InvalidAssignment("registry record original is not the recorded indirect alias"))
    node_value :: object.get("node") ?? return Err(TrustError.InvalidAssignment("missing registry field `node`"))
    node :: trust_json_string(node_value) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
    Ok(FlakeRegistryEntry{alias, node, original: original_json, locked: trust_json_canonical(locked)})
}

// Rust `parse_composition_record`: a `flake-composition:` record's JSON.
fn trust_flake_parse_composition(raw: String) -> FlakeComposition TrustError! {
    object :: trust_json_parse_record(raw)
    framework_value :: object.get("framework") ?? return Err(TrustError.InvalidAssignment("missing composition framework"))
    framework :: trust_json_string(framework_value) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
    per_system :: trust_json_bool(object.get("perSystem") ?? DataTree.Null) ?? return Err(TrustError.InvalidAssignment("composition perSystem is not boolean"))
    module_sources := [String]{}
    if object.has_key("moduleSources") -> module_sources = trust_flake_composition_strings(object, "moduleSources")
    modules :: trust_flake_composition_strings(object, "modules")
    systems :: trust_flake_composition_strings(object, "systems")
    Ok(FlakeComposition{framework, modules, module_sources, systems, per_system})
}

fn trust_flake_composition_strings(object: [String: DataTree], key: String) -> [String] TrustError! {
    declared :: object.get(key) ?? return Err(TrustError.InvalidAssignment("missing composition field `{key}`"))
    items :: trust_json_array(declared) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_ARRAY))
    values := [String]{}
    loop item in items {
        value :: trust_json_string(item) ?? return Err(TrustError.InvalidAssignment(TRUST_JSON_NOT_STRING))
        &values.push(value)
    }
    Ok(values)
}
