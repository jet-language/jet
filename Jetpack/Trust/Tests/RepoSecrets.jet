// Claims ported from crates/jetpack/src/Secrets.rs #[cfg(test)], written
// against D-CORE-SECRETSTORE1 option A (OPEN): store calls go through
// `core.crypto.vault`, which opens the working directory's store, so the
// store claims run from inside their scratch project and restore the
// working directory and `JET_KEYS_DIR` before returning. The pairs codec,
// hex, private atomic write, and concurrent-set claims of Secrets.rs belong
// to the vault once option A lands (#3668) and are not repeated here.

struct TrustSecretsTestProject {
    dir: String
    previous: String
}

fn trust_secrets_test_dir(label: String) -> String {
    scratch :: files.temp_dir("jet_secrets_{label}") ?? panic("scratch directory")
    scratch.path
}

// A scratch project entered as the working directory, with its own keys.
fn trust_secrets_test_enter(label: String) -> TrustSecretsTestProject {
    dir :: trust_secrets_test_dir(label)
    keys :: files.join(dir, "keys")
    files.create_dir_all(keys) ?? panic("keys directory")
    sys.set("JET_KEYS_DIR", keys)
    previous :: files.cwd() ?? panic("working directory")
    files.chdir(dir) ?? panic("enter scratch project")
    TrustSecretsTestProject{dir, previous}
}

fn trust_secrets_test_leave(project: TrustSecretsTestProject) {
    files.chdir(project.previous) ?? panic("leave scratch project")
    sys.unset("JET_KEYS_DIR") ?? panic("unset JET_KEYS_DIR")
}

fn trust_secrets_test_error(result: Bool TrustError!) -> String {
    if result == {
        .Ok(_) -> panic("expected a secrets error")
        .Err(error) -> error.message()
    }
}

#Test("identity path honors the keys directory override") {
    dir :: files.join(trust_secrets_test_dir("keys_override"), "jet_secrets_test_keys_dir")
    sys.set("JET_KEYS_DIR", dir)
    assert_eq(trust_secrets_identity_path(), files.join(dir, "secrets.identity"))
    sys.unset("JET_KEYS_DIR") ?? panic("unset JET_KEYS_DIR")
}

#Test("keygen writes a private identity and refuses to overwrite it") {
    project :: trust_secrets_test_enter("keygen")
    generated :: trust_secrets_keygen(false) ?? panic("keygen")
    assert(generated.recipient.starts_with("age1"), generated.recipient)
    if sys.is_unix() {
        info :: files.stat(generated.path) ?? panic("stat identity")
        assert_eq(info.mode & 0o777, 0o600, "private identity must be created with restrictive permissions")
    }
    if trust_secrets_keygen(false) == {
        .Ok(_) -> panic("a second keygen without --force must refuse")
        .Err(error) -> assert(error.message().contains("already exists"), error.message())
    }
    trust_secrets_test_leave(project)
}

#Test("recipients add is idempotent and lists") {
    project :: trust_secrets_test_enter("recipients")
    recipient :: (trust_secrets_keygen(true) ?? panic("keygen")).recipient
    assert(trust_secrets_add_recipient(project.dir, recipient) ?? panic("add"))
    assert(!(trust_secrets_add_recipient(project.dir, recipient) ?? panic("add again")), "idempotent")
    assert_eq(trust_secrets_list_recipients(project.dir) ?? panic("list"), [String]{recipient})
    trust_secrets_test_leave(project)
}

#Test("recipient lock failure is not already present") {
    project :: trust_secrets_test_enter("lock_failure")
    recipient :: (trust_secrets_keygen(true) ?? panic("keygen")).recipient
    files.create_dir_all(files.join(project.dir, ".jet")) ?? panic(".jet directory")
    files.write(files.join(project.dir, ".jet/.locks"), "not a directory") ?? panic("block the lock directory")
    error :: trust_secrets_test_error(trust_secrets_add_recipient(project.dir, recipient))
    assert(error.contains("couldn't lock"), error)
    assert(!files.exists(trust_secrets_recipients_path(project.dir)))
    trust_secrets_test_leave(project)
}

#Test("recipient write failure is not success") {
    project :: trust_secrets_test_enter("write_failure")
    recipient :: (trust_secrets_keygen(true) ?? panic("keygen")).recipient
    files.create_dir_all(trust_secrets_recipients_path(project.dir)) ?? panic("recipients directory")
    assert(trust_secrets_add_recipient(project.dir, recipient) == .Err(_))
    trust_secrets_test_leave(project)
}

#Test("non-file secret inputs are errors not absence") {
    project :: trust_secrets_test_enter("nonfile")
    files.create_dir_all(trust_secrets_recipients_path(project.dir)) ?? panic("recipients directory")
    assert(trust_secrets_list_recipients(project.dir) == .Err(_))
    files.remove_dir(trust_secrets_recipients_path(project.dir)) ?? panic("remove recipients directory")
    files.create_dir_all(trust_secrets_store_path(project.dir)) ?? panic("store directory")
    if trust_secrets_validation_identity(project.dir, [SecretSpec]{}, None) == {
        .Ok(_) -> panic("a directory store must be an error")
        .Err(error) -> assert(error.message().contains("not a regular file"), error.message())
    }
    trust_secrets_test_leave(project)
}

#Test("crypto round trip through the vault") {
    project :: trust_secrets_test_enter("round_trip")
    recipient :: (trust_secrets_keygen(true) ?? panic("keygen")).recipient
    assert(trust_secrets_add_recipient(project.dir, recipient) ?? panic("add"))
    trust_secrets_set(project.dir, "db_password", "hunter2") ?? panic("set")
    assert_eq(trust_secrets_get(project.dir, "db_password") ?? panic("get"), Val("hunter2"))
    // A missing entry is None, not an error.
    missing :: trust_secrets_get(project.dir, "no_such_key") ?? panic("get missing")
    assert(missing == None)
    assert(trust_secrets_unset(project.dir, "db_password") ?? panic("unset"))
    assert(!(trust_secrets_unset(project.dir, "db_password") ?? panic("unset again")))
    trust_secrets_test_leave(project)
}

#Test("an absent store lists empty, not an error") {
    project :: trust_secrets_test_enter("absent")
    assert_eq(trust_secrets_list(project.dir) ?? panic("list"), [String]{})
    age :: trust_secrets_store_age(project.dir) ?? panic("store age")
    assert(age == None)
    trust_secrets_test_leave(project)
}

#Test("store calls refuse a project other than the working directory") {
    project :: trust_secrets_test_enter("elsewhere")
    other :: trust_secrets_test_dir("elsewhere_other")
    assert(trust_secrets_list(other) == .Err(_))
    trust_secrets_test_leave(project)
}

#Test("validation identity binds the declarations and is secret free") {
    dir :: trust_secrets_test_dir("validation")
    sys.set("JET_KEYS_DIR", files.join(dir, "keys"))
    stored :: [SecretSpec]{SecretSpec.stored("db_password")}
    absent :: trust_secrets_validation_identity(dir, stored, Val("dev")) ?? panic("identity without a store")
    again :: trust_secrets_validation_identity(dir, stored, Val("dev")) ?? panic("identity again")
    other_environment :: trust_secrets_validation_identity(dir, stored, Val("prod")) ?? panic("identity for prod")
    assert(absent != None)
    assert_eq(absent, again)
    assert(absent != other_environment)
    // A present store without a local identity has nothing to validate with.
    files.create_dir_all(files.join(dir, ".jet")) ?? panic(".jet directory")
    files.write(trust_secrets_store_path(dir), "ciphertext") ?? panic("write store")
    keyless :: trust_secrets_validation_identity(dir, stored, Val("dev")) ?? panic("identity without a key")
    assert(keyless == None)
    sys.unset("JET_KEYS_DIR") ?? panic("unset JET_KEYS_DIR")
}

#Test("runtime plan records only compositions and rejects control characters") {
    dir :: trust_secrets_test_dir("runtime_plan")
    compose :: SecretSpec{name: "database_url", declaration: SecretDeclaration.Compose{template: "postgres://{{user}}:{{password}}@db", from: [String]{"password", "user", "password"}}}
    trust_secrets_write_runtime_plan(dir, [SecretSpec]{SecretSpec.stored("token"), compose}) ?? panic("write plan")
    text :: files.read(trust_secrets_runtime_plan_path(dir)) ?? panic("read plan")
    assert_eq(text, "JSEC1\ndatabase_url\tpassword,user\tpostgres://{{user}}:{{password}}@db\n")
    tabbed :: SecretSpec{name: "bad\tname", declaration: SecretDeclaration.Compose{template: "x", from: [String]{"a"}}}
    if trust_secrets_write_runtime_plan(dir, [SecretSpec]{tabbed}) == {
        .Ok(_) -> panic("a control character must be refused")
        .Err(error) -> assert(error.message().contains("contains a control character"), error.message())
    }
}

#Test("dotenv import parsing accepts exports and quotes and rejects bad lines") {
    dir :: trust_secrets_test_dir("dotenv")
    source :: files.join(dir, ".env")
    files.write(source, "# comment\n\nexport API_KEY=\"abc 123\"\nDB_PASSWORD='hunter2'\nPLAIN = value \n") ?? panic("write .env")
    values :: trust_secrets_parse_dotenv(source) ?? panic("parse")
    assert_eq(values["API_KEY"], "abc 123")
    assert_eq(values["DB_PASSWORD"], "hunter2")
    assert_eq(values["PLAIN"], "value")
    files.write(source, "OK=1\nnot an assignment\n") ?? panic("write bad .env")
    if trust_secrets_parse_dotenv(source) == {
        .Ok(_) -> panic("a line without = must be refused")
        .Err(error) -> assert_eq(error.message(), "line 2 has no '='")
    }
    files.write(source, "1BAD=x\n") ?? panic("write bad name")
    if trust_secrets_parse_dotenv(source) == {
        .Ok(_) -> panic("an invalid name must be refused")
        .Err(error) -> assert_eq(error.message(), "line 1 has an invalid variable name")
    }
}
