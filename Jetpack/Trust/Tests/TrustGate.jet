// Claims ported from crates/jetpack/src/Trust.rs #[cfg(test)]. Each claim
// uses its own scratch directory from `files.temp_dir`.
use jet_pkg_model.[PackageGateError, RefSource, RefSpec, SourceTable]
use jet_env_model.[SecretSpec]
use jetpack_trust.[
    TrustAuthority, TrustGrant, trust_add_grant, trust_add_pattern, trust_env_definition_hash,
    trust_flake_definition_hash, trust_gate, trust_gate_flake, trust_grant_hash,
    trust_is_env_trusted, trust_is_trust_sensitive, trust_is_trust_sensitive_ext, trust_is_trusted,
    trust_list_entries, trust_parse_grant_selector, trust_remove_pattern,
]
use jetpack_foundation.[PACKAGE_FILE, TRUST_SCOPE_REPO, TRUST_SCOPE_USER, Theme]
use core.files as files

fn trust_test_gate_dir(label: String) -> String {
    scratch :: files.temp_dir("jetpack_trust_unit_{label}") ?? panic("scratch directory")
    scratch.path
}

fn trust_test_ref(raw: String) -> RefSpec {
    package :: if raw.split_once("@") == {
        .Val(parts) -> parts.before
        .None -> raw
    }
    RefSpec{source: RefSource.Nixpkgs, package, raw}
}

fn trust_test_secret(name: String) -> SecretSpec {
    SecretSpec.stored(name)
}

#Test("canonical build identity selector uses build authority") {
    grant :: trust_parse_grant_selector("build-sha256:0123456789abcdef", TRUST_SCOPE_REPO) ?? panic("selector parses")
    assert_eq(grant.authority, (TrustAuthority.Build).label())
    assert_eq(grant.subject, "build-sha256:0123456789abcdef")
}

#Test("empty refs are never trust sensitive") {
    assert(!trust_is_trust_sensitive([RefSpec]{}))
    assert(trust_is_trust_sensitive_ext([RefSpec]{}, true))
}

#Test("nonempty refs are trust sensitive") {
    assert(trust_is_trust_sensitive([RefSpec]{trust_test_ref("fastfetch@nixpkgs")}))
}

#Test("hash is stable and order independent") {
    table :: SourceTable.empty()
    a :: trust_env_definition_hash([RefSpec]{trust_test_ref("a@nixpkgs"), trust_test_ref("b@nixpkgs")}, table, [SecretSpec]{trust_test_secret("stripe"), trust_test_secret("db")})
    b :: trust_env_definition_hash([RefSpec]{trust_test_ref("b@nixpkgs"), trust_test_ref("a@nixpkgs")}, table, [SecretSpec]{trust_test_secret("db"), trust_test_secret("stripe")})
    assert_eq(a, b)
}

#Test("hash changes when refs change") {
    table :: SourceTable.empty()
    a :: trust_env_definition_hash([RefSpec]{trust_test_ref("a@nixpkgs")}, table, [SecretSpec]{})
    b :: trust_env_definition_hash([RefSpec]{trust_test_ref("a@nixpkgs"), trust_test_ref("b@nixpkgs")}, table, [SecretSpec]{})
    assert(a != b)
}

#Test("hash changes when secrets change") {
    table :: SourceTable.empty()
    refs :: [RefSpec]{trust_test_ref("a@nixpkgs")}
    a :: trust_env_definition_hash(refs, table, [SecretSpec]{trust_test_secret("stripe")})
    b :: trust_env_definition_hash(refs, table, [SecretSpec]{trust_test_secret("db")})
    assert(a != b)
}

#Test("hash grant round trips") {
    dir :: trust_test_gate_dir("hashgrant")
    store :: files.join(dir, "trust")
    hash :: trust_env_definition_hash([RefSpec]{trust_test_ref("fastfetch@nixpkgs")}, SourceTable.empty(), [SecretSpec]{})
    assert(!trust_is_trusted(store, dir, hash))
    trust_grant_hash(store, dir, hash) ?? panic("hash grant")
    assert(trust_is_trusted(store, dir, hash))
}

#Test("typed env build and package grants authorize env gate") {
    dir :: trust_test_gate_dir("typed_grants")
    refs :: [RefSpec]{trust_test_ref("fastfetch@nixpkgs")}
    hash :: trust_env_definition_hash(refs, SourceTable.empty(), [SecretSpec]{})
    secrets :: [SecretSpec]{trust_test_secret("db_password")}

    store :: files.join(dir, "trust")
    trust_add_grant(store, dir, TrustGrant{authority: TrustAuthority.Package.label(), subject: "fastfetch", scope: TRUST_SCOPE_USER}) ?? panic("package grant")
    assert(trust_is_env_trusted(store, dir, hash, refs, [SecretSpec]{}))
    assert(!trust_is_env_trusted(store, dir, hash, refs, secrets))

    build_store :: files.join(dir, "trust-build")
    trust_add_grant(build_store, dir, TrustGrant{authority: TrustAuthority.Build.label(), subject: hash, scope: TRUST_SCOPE_USER}) ?? panic("build grant")
    assert(trust_is_env_trusted(build_store, dir, hash, refs, secrets))

    env_store :: files.join(dir, "trust-env")
    trust_add_grant(env_store, dir, TrustGrant{authority: TrustAuthority.Env.label(), subject: "{dir}*", scope: TRUST_SCOPE_REPO}) ?? panic("env grant")
    assert(trust_is_env_trusted(env_store, dir, hash, refs, secrets))
}

#Test("vault write grant keeps its exact authority and repository uuid") {
    uuid :: "00112233445566778899aabbccddeeff"
    grant :: trust_parse_grant_selector("vault.write:{uuid}", TRUST_SCOPE_USER) ?? panic("selector parses")
    assert_eq(grant.authority, (TrustAuthority.VaultWrite).label())
    assert_eq(grant.subject, uuid)
    assert_eq(grant.line(), "grant:user:vault.write:{uuid}")
}

#Test("authority trust default allow and deny feed gate") {
    allow_dir :: trust_test_gate_dir("policy_allow")
    files.write(files.join(allow_dir, PACKAGE_FILE), "name: \"app\"\nversion: \"0.1.0\"\nauthority: {{ trust: {{ default: allow }} }}\n") ?? panic("write allow manifest")
    deny_dir :: trust_test_gate_dir("policy_deny")
    files.write(files.join(deny_dir, PACKAGE_FILE), "name: \"app\"\nversion: \"0.1.0\"\nauthority: {{ trust: {{ default: deny }} }}\n") ?? panic("write deny manifest")
    refs :: [RefSpec]{trust_test_ref("fastfetch@nixpkgs")}
    table :: SourceTable.empty()
    theme :: Theme.plain()
    // A project's own allow is not the external approval that trusts it;
    // under a test harness stdin is not a terminal, so both refuse.
    assert(trust_gate(theme, files.join(allow_dir, "trust"), allow_dir, refs, table, [SecretSpec]{}, false) != None)
    assert(trust_gate(theme, files.join(deny_dir, "trust"), deny_dir, refs, table, [SecretSpec]{}, false) != None)
}

#Test("pattern add list remove") {
    dir :: trust_test_gate_dir("pattern")
    store :: files.join(dir, "trust")
    assert(trust_add_pattern(store, dir, "/home/dev/*") ?? panic("pattern grant"))
    assert(!(trust_add_pattern(store, dir, "/home/dev/*") ?? panic("pattern idempotent")), "idempotent")
    assert_eq(trust_list_entries(store), [String]{"pattern:/home/dev/*"})
    assert(trust_is_trusted(store, "/home/dev/myproj", "irrelevant-hash"))
    assert(trust_remove_pattern(store, "/home/dev/*"))
    assert(!trust_is_trusted(store, "/home/dev/myproj", "irrelevant-hash"))
}

#Test("prefix pattern without wildcard matches prefix") {
    dir :: trust_test_gate_dir("prefix")
    store :: files.join(dir, "trust")
    trust_add_pattern(store, dir, "/home/dev/") ?? panic("prefix grant")
    assert(trust_is_trusted(store, "/home/dev/anything", "h"))
    assert(!trust_is_trusted(store, "/home/other", "h"))
}

#Test("prefix pattern does not match sibling name") {
    dir :: trust_test_gate_dir("prefix_sibling")
    store :: files.join(dir, "trust")
    trust_add_pattern(store, dir, "/home/dev/app") ?? panic("prefix grant")
    assert(trust_is_trusted(store, "/home/dev/app/src", "h"))
    assert(!trust_is_trusted(store, "/home/dev/application", "h"))
}

#Test("pattern matching tolerates canonical path aliases") {
    dir :: trust_test_gate_dir("canonical_alias")
    store :: files.join(dir, "trust")
    trust_add_pattern(store, dir, "{dir}*") ?? panic("canonical grant")
    canonical :: files.canonicalize(dir) ?? panic("canonical scratch path")
    assert(trust_is_trusted(store, canonical, "h"))
}

#Test("flake hash is stable and content sensitive") {
    a :: trust_flake_definition_hash("{{ devShells.default = {{}}; }}")
    b :: trust_flake_definition_hash("{{ devShells.default = {{}}; }}")
    c :: trust_flake_definition_hash("{{ devShells.default = {{ buildInputs = [1]; }}; }}")
    assert_eq(a, b)
    assert(a != c)
}

#Test("gate flake bypass never grants") {
    dir :: trust_test_gate_dir("flake_bypass")
    store :: files.join(dir, "trust")
    flake :: files.join(dir, "flake.nix")
    files.write(flake, "{{ }}") ?? panic("write flake")
    assert(trust_gate_flake(Theme.plain(), store, dir, flake, true) == None)
    // A one-shot bypass persists nothing (mirrors the env gate's `--trust`).
    assert(!trust_is_trusted(store, dir, trust_flake_definition_hash("{{ }}")))
}

#Test("gate flake grant round trips") {
    dir :: trust_test_gate_dir("flake_grant")
    store :: files.join(dir, "trust")
    hash :: trust_flake_definition_hash("{{ devShells.default = {{}}; }}")
    assert(!trust_is_trusted(store, dir, hash))
    trust_grant_hash(store, dir, hash) ?? panic("flake grant")
    assert(trust_is_trusted(store, dir, hash))
}

// tests/gate_law.rs:65-75: every writer returns E3415 before creating the
// store or its parent; an existing store also remains byte-identical.
fn trust_test_write_refusal(error: PackageGateError, site: String, root: String) -[FS]> {
    assert_eq(error.diagnostics.len(), 1)
    diagnostic :: error.diagnostics[0]
    policy :: files.join(files.canonicalize(root) ?? panic("canonical policy root"), PACKAGE_FILE)
    assert_eq(diagnostic.code, "E3415")
    assert_eq(diagnostic.what, "The `trust_grant` gate at `{site}` is forbidden by `{policy}`.")
}

#Test("trust policy refuses all grant writers without creating or changing the store") {
    root :: trust_test_gate_dir("grant-forbidden")
    files.write(files.join(root, PACKAGE_FILE), "name: \"law\"\nversion: \"0.1.0\"\npolicy: {{ trust_grant: .Forbid }}\n") ?? panic("gate policy")
    parent :: files.join(root, "new-parent")
    store :: files.join(parent, "trust")
    grant :: trust_parse_grant_selector("build:audited", "repo") ?? panic("grant selector")
    if trust_add_grant(store, root, grant) == {
        .Ok(_) -> panic("forbidden typed grant succeeded")
        .Err(error) -> trust_test_write_refusal(error, "build:audited -> {store}", root)
    }
    if trust_grant_hash(store, root, "audited") == {
        .Ok(_) -> panic("forbidden hash grant succeeded")
        .Err(error) -> trust_test_write_refusal(error, "hash:audited -> {store}", root)
    }
    if trust_add_pattern(store, root, "/reviewed/*") == {
        .Ok(_) -> panic("forbidden pattern grant succeeded")
        .Err(error) -> trust_test_write_refusal(error, "pattern:/reviewed/* -> {store}", root)
    }
    assert(!files.exists(store))
    assert(!files.exists(parent))
    files.create_dir_all(parent) ?? panic("existing parent")
    prior :: "hash:audited\n"
    files.write(store, prior) ?? panic("existing store")
    if trust_grant_hash(store, root, "audited") == {
        .Ok(_) -> panic("idempotence must not bypass the gate")
        .Err(error) -> trust_test_write_refusal(error, "hash:audited -> {store}", root)
    }
    assert_eq(files.read(store) ?? panic("store preserved"), prior)
    files.remove_all(root).drop("test cleanup")
}

#Test("trust GateOnly permits all three writers with false only for duplicate grants") {
    root :: trust_test_gate_dir("grant-allowed")
    files.write(files.join(root, PACKAGE_FILE), "name: \"law\"\npolicy: {{ trust_grant: .GateOnly }}\n") ?? panic("gate policy")
    store :: files.join(root, "new-parent/trust")
    grant :: trust_parse_grant_selector("build:audited", "repo") ?? panic("grant selector")
    assert(trust_add_grant(store, root, grant) ?? panic("typed grant permitted"))
    assert(trust_grant_hash(store, root, "audited") ?? panic("hash permitted"))
    assert(trust_add_pattern(store, root, "/reviewed/*") ?? panic("pattern permitted"))
    assert(!(trust_add_grant(store, root, grant) ?? panic("typed duplicate permitted")))
    assert(!(trust_grant_hash(store, root, "audited") ?? panic("hash duplicate permitted")))
    assert(!(trust_add_pattern(store, root, "/reviewed/*") ?? panic("pattern duplicate permitted")))
    assert_eq(files.read(store) ?? panic("grant store"), "grant:repo:build:audited\nhash:audited\npattern:/reviewed/*\n")
    files.remove_all(root).drop("test cleanup")
}
