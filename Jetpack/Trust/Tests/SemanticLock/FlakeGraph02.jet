#Test("overlay_tuple_map_union_preserves_order_and_empty_action_override") {
    before :: [(overlay: String, package: String): String]{
        (overlay: "z", package: "same"): "same",
        (overlay: "a", package: "removed"): "old",
        (overlay: "a", package: "changed"): "before"
    }
    after :: [(overlay: String, package: String): String]{
        (overlay: "z", package: "same"): "same",
        (overlay: "a", package: "changed"): "after",
        (overlay: "b", package: "added"): "new"
    }
    actions :: [String: [String]]{"changed": [String]{}}
    result :: overlay_invalidations(before, after, actions)
    assert_eq(result.len(), 3)
    assert_eq(result[0].package, "changed")
    assert_eq(result[0].affected_action_keys, [String]{})
    assert_eq(result[0].reason, "overlay `a` changed package `changed` policy (before → after)")
    assert_eq(result[1].package, "removed")
    assert_eq(result[1].reason, "overlay `a` removed package `removed`")
    assert_eq(result[2].overlay, "b")
    assert_eq(result[2].affected_action_keys, [String]{"action:added"})
    assert_eq(result[2].reason, "overlay `b` added package `added`")
}
