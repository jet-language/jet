// Claims ported from crates/jetpack/src/JetPin.rs #[cfg(test)]. Each claim
// works in its own scratch project from `files.tmpdir`. Claims that set
// the process-global toolchain object variable restore it before return.
use {
    jetpack_foundation.[
        BINARY_NAME, PACKAGE_FILE, TOOLCHAIN_EXEC_MARKER_ENV, TOOLCHAIN_OBJECT_ENV,
    ]
    jetpack_trust.[
        TrustError, trust_pin_channel_of, trust_pin_classify_channel, trust_pin_decide,
        trust_pin_identity_preparse, trust_pin_lock_write_diagnostic, trust_pin_locked_toolchain,
        trust_pin_move, trust_pin_realize_jet_binary, trust_pin_report, trust_pin_resolve_channel,
        trust_pin_toolchain_record, trust_pin_write_init,
    ]
    jet_foundation.[diagnostic_display_name]
    jet_pkg_model.[pkg_lock_record_toolchain]
    files: core.files
    process: core.process
    sys: core.sys
}

// The project outlives this helper, so it is a `tmpdir`: a `temp_dir` would
// remove it when its `TempDir` drops at return (#6119).
trust_pin_test_root: fn(label: String) -> String {
    root: files.tmpdir("jetpin_{label}") ?? panic("scratch directory")
    files.create_dir_all(files.join(root, ".jet")) ?? panic("scratch .jet directory")
    root
}

// The project manifest is `package.jet`; the retired `pkg.jet` is not read.
trust_pin_test_manifest: fn(root: String, text: String) {
    files.write(files.join(root, PACKAGE_FILE), text) ?? panic("write manifest")
}

trust_pin_test_code: fn(result: String TrustError!) -> String {
    if result == {
        .Ok(_) -> panic("expected a pin diagnostic")
        .Err(error) -> {
            if error == {
                .Pin(diagnostic) -> diagnostic.code
                else -> panic("expected a pin diagnostic, got {error.message()}")
            }
        }
    }
}

// The text of tests/fixtures/jetpack-diagnostics/E1224.stderr. It is written here
// because an embed may not leave this package (E0957).
TRUST_PIN_E1224_SNAPSHOT: "Error [jet.PackageFileOperationFailed]: Couldn't write .jet/lock\n Why: The lock file records exact toolchain identity\n Fix: Check write permissions: permission denied\nMore: jet-lang.dev/e/E1224\n"

// ── T1 ──

#Test("identity block parses across unknown fields") {
    // Unknown top-level keys, an unknown nested block, and unknown fields
    // inside payload must not stop the identity read.
    source: "\n// leading comment\nfuture_top_key: {{ nested: {{ deep: [1, 2, 3] }}, more: \"syntax we don't know yet\" }}\npayload: {{\n    name:    \"wordstats\",\n    version: \"0.3.1\",\n    jet:     \"a0.4\",\n    someday: {{ a: 1, b: {{ c: 2 }} }},\n    license: \"MIT\",\n}}\ntomorrow: [ a, b, c ]\ndeps: {{ textkit: \"1.2.0\" }}\n"
    identity: trust_pin_identity_preparse(source)
    assert_eq(identity.payload_name, "wordstats")
    assert_eq(identity.payload_version, "0.3.1")
    assert_eq(trust_pin_classify_channel(identity.jet ?? panic("pinned")) ?? panic("a0.4"), "a0.4")
}

#Test("identity block unpinned when no jet field") {
    identity: trust_pin_identity_preparse("payload: {{ name: \"x\", version: \"1.0.0\" }}\n")
    assert_eq(identity.payload_name, "x")
    assert(identity.jet == None)
}

#Test("identity block accepts quoted pin") {
    assert_eq(trust_pin_identity_preparse("payload: {{ name: \"x\", version: \"1\", jet: \"main\" }}\n").jet, Val("main"))
}

#Test("classify channel accepts versions and named") {
    assert_eq(trust_pin_classify_channel("a0.4") ?? panic("a0.4"), "a0.4")
    assert_eq(trust_pin_classify_channel("a0.0.43") ?? panic("a0.0.43"), "a0.0.43")
    assert_eq(trust_pin_classify_channel("main") ?? panic("main"), "main")
    assert_eq(trust_pin_classify_channel("\"a0.4\"") ?? panic("quoted"), "a0.4")
}

#Test("classify channel rejects ranges and unstaged versions with E1249") {
    rejected: [String]{">=a1.0.0", "^a1.2", "1", "", "a0.", "a1.x", "Main", "0.4", "0.4.2", "A0.4", "a.4", "a0.4.2.1"}
    loop bad in rejected {
        assert(trust_pin_test_code(trust_pin_classify_channel(bad)) == "E1249", "should reject {bad}")
    }
}

// ── T2 ──

#Test("toolchain pin locks exact") {
    // Channel `a0.4` resolves to an exact `a0.4.0`, recorded in the lock;
    // re-reads take the locked version, not the channel.
    root: trust_pin_test_root("locks_exact")
    resolved: trust_pin_resolve_channel("a0.4") ?? panic("resolve a0.4")
    assert_eq(resolved, "a0.4.0")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("a0.4", resolved)) ?? panic("valid test lock record")
    toolchain: trust_pin_locked_toolchain(root) ?? panic("locked")
    assert_eq(toolchain.channel, "a0.4")
    assert_eq(toolchain.version, "a0.4.0")
    assert(toolchain.id.starts_with("jet-a0.4.0-"))
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked again")).version, "a0.4.0")
}

#Test("offline unlocked channel reports E1250") {
    root: trust_pin_test_root("offline_e1250")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.9\" }}\n")
    if trust_pin_decide(root, "a0.4.0", true) == {
        .Report(diagnostic) -> assert_eq(diagnostic.code, "E1250")
        else -> panic("expected E1250")
    }
}

// ── T3 ──

#Test("mismatched jet realizes and execs the pin") {
    // A fixture toolchain object (a `jet` script printing its version)
    // stands in for a downloaded prebuilt. A running `jet` with a different
    // version realizes it and re-execs; the child reports the pinned version
    // and honours the exec marker and env passthrough.
    root: trust_pin_test_root("reexec")
    object: trust_pin_test_root("object")
    binary_path: files.join(object, BINARY_NAME)
    files.write(binary_path, "#!/bin/sh\necho pinned-jet-a0.4.0\necho marker=${TOOLCHAIN_EXEC_MARKER_ENV}\necho passthru=$JETPIN_TEST_ENV\n") ?? panic("write fixture jet")
    files.write(files.join(object, "version"), "a0.4.0\n") ?? panic("write fixture version")
    if sys.is_unix() -> files.set_mode(binary_path, 493) ?? panic("chmod fixture jet")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.4\" }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("a0.4", "a0.4.0")) ?? panic("valid test lock record")

    sys.set(TOOLCHAIN_OBJECT_ENV, object)
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")

    if trust_pin_decide(root, "a9.9.9", false) == {
        .ReExec(binary, channel, version) -> {
            assert_eq(channel, "a0.4")
            assert_eq(version, "a0.4.0")
            assert_eq(binary, binary_path)
            if sys.is_unix() {
                // Perform the exec the dispatch shim would: marker + inherited env.
                receipt: process.cmd([String]{binary}).env(TOOLCHAIN_EXEC_MARKER_ENV, version).env("JETPIN_TEST_ENV", "carried").stdout(.Capture).stderr(.Capture).run() ?? panic("run fixture jet")
                assert(receipt.output.contains("pinned-jet-a0.4.0"), "child version: {receipt.output}")
                assert(receipt.output.contains("marker=a0.4.0"), "exec marker: {receipt.output}")
                assert(receipt.output.contains("passthru=carried"), "env passthrough: {receipt.output}")
            }
        }
        else -> panic("expected ReExec")
    }

    // Re-exec guard: with the marker set, the pinned child runs natively.
    sys.set(TOOLCHAIN_EXEC_MARKER_ENV, "a0.4.0")
    assert(trust_pin_decide(root, "a0.4.0", false) == .RunNative)
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")
    _: sys.unset(TOOLCHAIN_OBJECT_ENV) ?? panic("unset object")
}

#Test("matched version runs native") {
    root: trust_pin_test_root("native")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.4\" }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("a0.4", "a0.4.0")) ?? panic("valid test lock record")
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")
    assert(trust_pin_decide(root, "a0.4.0", false) == .RunNative)
}

#Test("platform cache miss reports E1251") {
    sys.unset(TOOLCHAIN_OBJECT_ENV) ?? panic("unset object")
    if trust_pin_realize_jet_binary("a0.4", "a0.4.0") == {
        .Err(error) -> {
            if error == {
                .Pin(diagnostic) -> {
                    assert_eq(diagnostic.code, "E1251")
                    assert(diagnostic.what.contains("a0.4.0"))
                }
                else -> panic("expected a pin diagnostic")
            }
        }
        .Ok(_) -> panic("expected E1251")
    }
}

// ── T4 ──

#Test("jet toolchain reports pin") {
    root: trust_pin_test_root("report")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.4\" }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("a0.4", "a0.4.0")) ?? panic("valid test lock record")
    report: trust_pin_report(root)
    assert(report.contains("pin:      jet a0.4"), report)
    assert(report.contains("locked:   a0.4.0"), report)
    assert(report.contains("object:   jet-a0.4.0-"), report)
}

#Test("jet toolchain reports unpinned") {
    root: trust_pin_test_root("report_unpinned")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\" }}\n")
    assert(trust_pin_report(root).contains("unpinned"))
}

#Test("jet update jet moves the lock") {
    root: trust_pin_test_root("update")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.4\" }}\n")
    // Move to an explicit new channel.
    message: trust_pin_move(root, Val("a0.7"), "a9.9.9") ?? panic("move to a0.7")
    assert(message.contains("a0.7"), message)
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).version, "a0.7.0")
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).channel, "a0.7")
    // With no argument, the manifest pin wins.
    trust_pin_move(root, None, "a9.9.9") ?? panic("move to manifest pin")
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).channel, "a0.4")
}

#Test("jet init pins the running channel") {
    root: trust_pin_test_root("init")
    // Running toolchain a0.0.43 pins channel a0.0, quoted.
    message: trust_pin_write_init(root, "myapp", "a0.0.43") ?? panic("init")
    assert(message.contains("a0.0"), message)
    text: files.read(files.join(root, PACKAGE_FILE)) ?? panic("read package manifest")
    assert(text.contains("jet: \"a0.0\"\n"), text)
    identity: trust_pin_identity_preparse(text)
    assert_eq(identity.payload_name, "myapp")
    assert_eq(trust_pin_classify_channel(identity.jet ?? panic("pinned")) ?? panic("a0.0"), "a0.0")
    // A second init refuses to clobber.
    assert_eq(trust_pin_test_code(trust_pin_write_init(root, "other", "a0.0.43")), "E1252")
}

#Test("channel of takes major and minor") {
    assert_eq(trust_pin_channel_of("a0.0.43"), "a0.0")
    assert_eq(trust_pin_channel_of("a1.10.0"), "a1.10")
}

#Test("a lock that can't be written reports E1224") {
    root: trust_pin_test_root("unwritable")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: \"a0.4\" }}\n")
    files.create_dir_all(files.join(root, ".jet/lock")) ?? panic("lock path held by a directory")
    assert_eq(trust_pin_test_code(trust_pin_move(root, Val("a0.7"), "a9.9.9")), "E1224")
    diagnostic: trust_pin_lock_write_diagnostic("permission denied")
    assert_eq(TRUST_PIN_E1224_SNAPSHOT, "Error [{diagnostic_display_name(diagnostic.code)}]: {diagnostic.what}\n Why: {diagnostic.why}\n Fix: {diagnostic.fix}\nMore: jet-lang.dev/e/{diagnostic.code}\n")
}
