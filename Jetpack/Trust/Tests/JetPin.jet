// Claims ported from crates/jetpack/src/JetPin.rs #[cfg(test)]. Each claim
// works in its own scratch project from `files.temp_dir`. Claims that set
// the process-global toolchain object variable restore it before return.

fn trust_pin_test_root(label: String) -> String {
    scratch :: files.temp_dir("jetpin_{label}") ?? panic("scratch directory")
    files.create_dir_all(files.join(scratch.path, ".jet")) ?? panic("scratch .jet directory")
    scratch.path
}

fn trust_pin_test_manifest(root: String, text: String) {
    files.write(files.join(root, PAYLOAD_FILE), text) ?? panic("write manifest")
}

fn trust_pin_test_code(result: String TrustError!) -> String {
    if result == {
        .Ok(_) -> panic("expected a pin diagnostic")
        .Err(error) -> {
            if error == {
                .Pin(diagnostic) -> diagnostic.code
                else -> panic("expected a pin diagnostic, got {error.message()}")
            }
        }
    }
}

// ── T1 ──

#Test("identity block parses across unknown fields") {
    // Unknown top-level keys, an unknown nested block, and unknown fields
    // inside payload must not stop the identity read.
    source :: "\n// leading comment\nfuture_top_key: {{ nested: {{ deep: [1, 2, 3] }}, more: \"syntax we don't know yet\" }}\npayload: {{\n    name:    \"wordstats\",\n    version: \"0.3.1\",\n    jet:     0.4,\n    someday: {{ a: 1, b: {{ c: 2 }} }},\n    license: \"MIT\",\n}}\ntomorrow: [ a, b, c ]\ndeps: {{ textkit: \"1.2.0\" }}\n"
    identity :: trust_pin_identity_preparse(source)
    assert_eq(identity.payload_name, "wordstats")
    assert_eq(identity.payload_version, "0.3.1")
    assert_eq(identity.jet, Val("0.4"))
}

#Test("identity block unpinned when no jet field") {
    identity :: trust_pin_identity_preparse("payload: {{ name: \"x\", version: \"1.0.0\" }}\n")
    assert_eq(identity.payload_name, "x")
    assert(identity.jet == None)
}

#Test("identity block accepts quoted pin") {
    assert_eq(trust_pin_identity_preparse("payload: {{ name: \"x\", version: \"1\", jet: \"main\" }}\n").jet, Val("main"))
}

#Test("classify channel accepts versions and named") {
    assert_eq(trust_pin_classify_channel("0.4") ?? panic("0.4"), "0.4")
    assert_eq(trust_pin_classify_channel("0.4.2") ?? panic("0.4.2"), "0.4.2")
    assert_eq(trust_pin_classify_channel("main") ?? panic("main"), "main")
    assert_eq(trust_pin_classify_channel("\"0.4\"") ?? panic("quoted"), "0.4")
}

#Test("classify channel rejects ranges with E1249") {
    rejected :: [String]{">=1.0.0", "^1.2", "1", "", "0.", "1.x", "Main"}
    loop bad in rejected {
        assert_eq(trust_pin_test_code(trust_pin_classify_channel(bad)), "E1249", "should reject {bad}")
    }
}

// ── T2 ──

#Test("toolchain pin locks exact") {
    // Channel `0.4` resolves to an exact `0.4.0`, recorded in the lock;
    // re-reads take the locked version, not the channel.
    root :: trust_pin_test_root("locks_exact")
    resolved :: trust_pin_resolve_channel("0.4") ?? panic("resolve 0.4")
    assert_eq(resolved, "0.4.0")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("0.4", resolved)) ?? panic("valid test lock record")
    toolchain :: trust_pin_locked_toolchain(root) ?? panic("locked")
    assert_eq(toolchain.channel, "0.4")
    assert_eq(toolchain.version, "0.4.0")
    assert(toolchain.id.starts_with("jet-0.4.0-"))
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked again")).version, "0.4.0")
}

#Test("offline unlocked channel reports E1250") {
    root :: trust_pin_test_root("offline_e1250")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: 0.9 }}\n")
    if trust_pin_decide(root, "0.4.0", true) == {
        .Report(diagnostic) -> assert_eq(diagnostic.code, "E1250")
        else -> panic("expected E1250")
    }
}

// ── T3 ──

#Test("mismatched jet realizes and execs the pin") {
    // A fixture toolchain object (a `jet` script printing its version)
    // stands in for a downloaded prebuilt. A running `jet` with a different
    // version realizes it and re-execs; the child reports the pinned version
    // and honours the exec marker and env passthrough.
    root :: trust_pin_test_root("reexec")
    object :: trust_pin_test_root("object")
    binary_path :: files.join(object, BINARY_NAME)
    files.write(binary_path, "#!/bin/sh\necho pinned-jet-0.4.0\necho marker=${TOOLCHAIN_EXEC_MARKER_ENV}\necho passthru=$JETPIN_TEST_ENV\n") ?? panic("write fixture jet")
    files.write(files.join(object, "version"), "0.4.0\n") ?? panic("write fixture version")
    if sys.is_unix() -> files.set_mode(binary_path, 493) ?? panic("chmod fixture jet")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: 0.4 }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("0.4", "0.4.0")) ?? panic("valid test lock record")

    sys.set(TOOLCHAIN_OBJECT_ENV, object)
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")

    if trust_pin_decide(root, "9.9.9", false) == {
        .ReExec(binary, channel, version) -> {
            assert_eq(channel, "0.4")
            assert_eq(version, "0.4.0")
            assert_eq(binary, binary_path)
            if sys.is_unix() {
                // Perform the exec the dispatch shim would: marker + inherited env.
                receipt :: process.cmd([String]{binary}).env(TOOLCHAIN_EXEC_MARKER_ENV, version).env("JETPIN_TEST_ENV", "carried").stdout(.Capture).stderr(.Capture).run() ?? panic("run fixture jet")
                assert(receipt.output.contains("pinned-jet-0.4.0"), "child version: {receipt.output}")
                assert(receipt.output.contains("marker=0.4.0"), "exec marker: {receipt.output}")
                assert(receipt.output.contains("passthru=carried"), "env passthrough: {receipt.output}")
            }
        }
        else -> panic("expected ReExec")
    }

    // Re-exec guard: with the marker set, the pinned child runs natively.
    sys.set(TOOLCHAIN_EXEC_MARKER_ENV, "0.4.0")
    assert(trust_pin_decide(root, "0.4.0", false) == .RunNative)
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")
    sys.unset(TOOLCHAIN_OBJECT_ENV) ?? panic("unset object")
}

#Test("matched version runs native") {
    root :: trust_pin_test_root("native")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: 0.4 }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("0.4", "0.4.0")) ?? panic("valid test lock record")
    sys.unset(TOOLCHAIN_EXEC_MARKER_ENV) ?? panic("unset marker")
    assert(trust_pin_decide(root, "0.4.0", false) == .RunNative)
}

#Test("platform cache miss reports E1251") {
    sys.unset(TOOLCHAIN_OBJECT_ENV) ?? panic("unset object")
    if trust_pin_realize_jet_binary("0.4", "0.4.0") == {
        .Err(error) -> {
            if error == {
                .Pin(diagnostic) -> {
                    assert_eq(diagnostic.code, "E1251")
                    assert(diagnostic.what.contains("0.4.0"))
                }
                else -> panic("expected a pin diagnostic")
            }
        }
        .Ok(_) -> panic("expected E1251")
    }
}

// ── T4 ──

#Test("jet toolchain reports pin") {
    root :: trust_pin_test_root("report")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: 0.4 }}\n")
    pkg_lock_record_toolchain(root, trust_pin_toolchain_record("0.4", "0.4.0")) ?? panic("valid test lock record")
    report :: trust_pin_report(root)
    assert(report.contains("pin:      jet 0.4"), report)
    assert(report.contains("locked:   0.4.0"), report)
    assert(report.contains("object:   jet-0.4.0-"), report)
}

#Test("jet toolchain reports unpinned") {
    root :: trust_pin_test_root("report_unpinned")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\" }}\n")
    assert(trust_pin_report(root).contains("unpinned"))
}

#Test("jet update jet moves the lock") {
    root :: trust_pin_test_root("update")
    trust_pin_test_manifest(root, "payload: {{ name: \"x\", version: \"1\", jet: 0.4 }}\n")
    // Move to an explicit new channel.
    message :: trust_pin_move(root, Val("0.7"), "9.9.9") ?? panic("move to 0.7")
    assert(message.contains("0.7"), message)
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).version, "0.7.0")
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).channel, "0.7")
    // With no argument, the manifest pin wins.
    trust_pin_move(root, None, "9.9.9") ?? panic("move to manifest pin")
    assert_eq((trust_pin_locked_toolchain(root) ?? panic("locked")).channel, "0.4")
}

#Test("jet init pins the running channel") {
    root :: trust_pin_test_root("init")
    // Running toolchain 0.6.1 pins channel 0.6.
    message :: trust_pin_write_init(root, "myapp", "0.6.1") ?? panic("init")
    assert(message.contains("0.6"), message)
    text :: files.read(files.join(root, PACKAGE_FILE)) ?? panic("read package manifest")
    identity :: trust_pin_identity_preparse(text)
    assert_eq(identity.payload_name, "myapp")
    assert_eq(identity.jet, Val("0.6"))
    // A second init refuses to clobber.
    assert_eq(trust_pin_test_code(trust_pin_write_init(root, "other", "0.6.1")), "E1252")
}

#Test("channel of takes major and minor") {
    assert_eq(trust_pin_channel_of("0.4.2"), "0.4")
    assert_eq(trust_pin_channel_of("1.10.0"), "1.10")
}
