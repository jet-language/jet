#!/usr/bin/env jet
// Assemble the Jetpack Jet sources into one unqualified unit. `sources.list` is
// the only implementation order and `tests.list` the only test order; nothing is
// globbed into a unit. Run it from the checkout root:
//
//   jet Jetpack/Bootstrap/Assemble.jet [check|aot|hosted]
//   jet Jetpack/Bootstrap/Assemble.jet areas closure AREA|sources AREA|populated
//   jet Jetpack/Bootstrap/Assemble.jet slice
//
// Modes:
//   check  implementation + tests as `#Test` claims, for `jet check` (tests are
//          type-checked in the fast loop, not first discovered by --tests)
//   aot    the same unit, for `jet test` (the packages suite of
//          Compiler/test.jet runs it, one row per claim)
//   hosted implementation only + Jetpack/run.jet, for the standalone native
//          `jetpack` engine binary (`jet build`)
//
// A mode writes `project/src/jetpack.jet`, `project/package.jet` and the source
// map `jetpack.map.json` into the mode's scratch directory:
// $JETPACK_BOOTSTRAP_SCRATCH/<mode>, else
// $JET_STATE_ROOT/jetpack-bootstrap/<worker>-<tag>/<mode>, where the tag
// hashes the source root and the area selection.
//
// Environment:
//   JETPACK_BOOTSTRAP_SOURCE_ROOT  the tree to assemble (default: the working directory)
//   JETPACK_BOOTSTRAP_AREAS        comma-separated `# == Area ==` sections (unset: all)
//   JETPACK_BOOTSTRAP_OWN_AREA     the area being proved: only its tests run and
//                                  only its unlisted files fail the inventory
//   JETPACK_BOOTSTRAP_TEST_AREAS   comma-separated tests.list sections whose claims run
//   JETPACK_BOOTSTRAP_DEPS_FROM_HEAD=1  dependency sections read HEAD's manifests and bytes
//   JETPACK_WORKER                 the scratch directory's writer name (default lead)
//   JET_BIN                        the jet that runs Tools/agent/CompilerPackages.jet
//                                  (default: the current seed)
//
// `areas` answers from `areas.list`, which declares each area's direct
// dependencies, after validating the graph against the `# == Area ==`
// sections of sources.list and tests.list: `closure` prints the area and its
// transitive dependencies comma-separated (bottom-up), `sources` the
// repository-relative assembly list of that closure, one per line, and
// `populated` the areas that list at least one Jetpack/ source, bottom-up.
//
// `slice` reports compiler-slice drift (every mode refuses it too): the
// Jetpack unit references a slice of the Jet compiler's sources (the
// `Compiler hash` and `Compiler front end` sections of sources.list). That
// slice must stay closed under the compiler's packages: every top-level name
// the unit uses that only an unlisted member file of a slice package declares
// is drift, and that file must be listed. A use whose only declaration lives
// in a compiler package outside the slice is drift too: Jetpack must not
// reach past the front end.
//
// Exit: 0 done; 1 refused, printed; 64 usage.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    fspath: core.files.path
    process: core.process
    term: core.term
}

// The trees of an area folder whose files the inventory holds to the manifests.
TREE_KINDS: [String]{"Source", "Tests"}

// Shared dependencies reference canonical Compiler/ sources in this checkout.
ALLOWED_PREFIXES: [String]{"Jetpack/", "Compiler/"}
COMPILER_PACKAGES: "Tools/agent/CompilerPackages.jet"

// The packages whose `use <package>.[names]` or `use <package>.name` lines the
// unit blanks: it is one namespace.
PACKAGE_NAMES: [String]{
    "jet_foundation", "jet_lexer", "jet_parser", "jet_sema", "jet_eval", "jet_repl", "jet_driver", "jet_backend",
    "jet_cli", "jet_testkit", "compiler_bootstrap", "jetpack_foundation", "jetpack_trust_root", "jet_pkg_model",
    "jet_env_model", "jetpack_trust", "jetpack_artifact_store", "jetpack_build", "jetpack_nix_eval", "jetpack_nix",
    "jetpack_store", "jetpack_publication", "jetpack_environment", "jetpack_secrets", "jetpack_integrations",
}

// Jetpack is a package/environment engine: it reads and writes the store,
// spawns builders, fetches over the network, and reads the environment.
PACKAGE_SOURCE: "name: \"jetpack_bootstrap\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{\n    \n        allow: [Env, Exec, Exec.Args, FS, FS.Read, IO, Mem.Alloc, Mem.Rc, Net, Rand, Time, Time.Wait]\n    \n}}\n"

run: fn() {
    args: process.args()
    cwd: files.cwd() ?? "."
    root: resolve_path(cwd, process.env_get("JETPACK_BOOTSTRAP_SOURCE_ROOT") ?? cwd)
    if args.len() > 0 && args[0] == "areas" {
        out: areas_command(root, args[1..<args.len()]) ?? refuse_as("jetpack-areas", err.message)
        if out != "" -> print(out)
        return
    }
    if args.len() > 0 && args[0] == "slice" {
        if args.len() != 1 -> usage()
        problems: slice_problems(root, cwd) ?? refuse_as("compiler-slice", err.message)
        loop problem in problems -> term.eprint("compiler-slice: {problem}")
        if problems.len() > 0 -> process.exit(1)
        print("compiler-slice: the Jetpack compiler slice is closed under the compiler's packages")
        return
    }
    if args.len() > 1 -> usage()
    mode: if args.len() == 1 -> args[0] else -> "check"
    config: env_config(mode, root, cwd) ?? refuse_as("jetpack-bootstrap", err.message)
    members: compiler_members(root, cwd) ?? refuse_as("jetpack-bootstrap", err.message)
    done: assemble(config, members) ?? refuse_as("jetpack-bootstrap", err.message)
    if done.skipped > 0 -> print("note: {done.skipped} unlisted file(s) in dependency areas are not part of this unit (another writer's work in progress)")
    print("assembled {done.units} Jet sources ({mode}, {done.claims} test claims) into {config.scratch}/project/src/jetpack.jet")
    print("source provenance: {config.scratch}/jetpack.map.json")
}

usage: fn() -> Never {
    term.eprint("usage: jet Jetpack/Bootstrap/Assemble.jet [check|aot|hosted]")
    term.eprint("       jet Jetpack/Bootstrap/Assemble.jet areas closure AREA|sources AREA|populated")
    term.eprint("       jet Jetpack/Bootstrap/Assemble.jet slice")
    process.exit(64)
}

// `message` after `prefix: ` on stderr, then exit 1.
refuse_as: fn(prefix: String, message: String) -> Never {
    term.eprint("{prefix}: {message}")
    process.exit(1)
}

// What one assembly reads: the mode, the source root, the area selection and
// the scratch directory of the mode.
Config: struct {
    mode: String
    root: String
    // The `# == Area ==` sections to assemble, in their given order; None: all.
    areas: [String]?
    // JETPACK_BOOTSTRAP_OWN_AREA as set (an empty value is an area no section names).
    own: String?
    // The tests.list sections whose claims run; None: every section.
    test_sections: [String]?
    deps_from_head: Bool
    scratch: String
}

// The counts an assembly reports.
Assembled: struct {
    units: Int
    claims: Int
    skipped: Int
}

env_config: fn(mode: String, root: String, cwd: String) -> Config Err! {
    if mode != "check" && mode != "aot" && mode != "hosted" -> return Err("unknown mode {mode}; expected check, aot or hosted")
    listed: comma_list(process.env_get("JETPACK_BOOTSTRAP_AREAS") ?? "")
    areas: if listed.len() > 0 -> Val(listed) else -> [String]?{None}
    if mode == "hosted" && areas != None -> return Err("hosted builds require every Jetpack area")
    worker: process.env_get("JETPACK_WORKER") ?? "lead"
    if !is_plain_name(worker) -> return Err("JETPACK_WORKER must be a plain name")
    selection: if areas == .Val(names) -> sorted(names).join(",") else -> "*"
    tag_input := [U8]{}
    tag_input.extend(root.bytes())
    tag_input.push(U8{0})
    tag_input.extend(selection.bytes())
    root_tag: crypto.sha256(tag_input).hex().slice(0, 10)
    base: if process.env_get("JETPACK_BOOTSTRAP_SCRATCH") == .Val(given) -> resolve_path(cwd, given) else -> "{state_root()}/jetpack-bootstrap/{worker}-{root_tag}"
    tests: process.env_get("JETPACK_BOOTSTRAP_TEST_AREAS") ?? ""
    test_sections: if mode == "hosted" || tests == "" -> [String]?{None} else -> Val(comma_list(tests))
    Config{
        mode: mode,
        root: root,
        areas: areas,
        own: process.env_get("JETPACK_BOOTSTRAP_OWN_AREA"),
        test_sections: test_sections,
        deps_from_head: (process.env_get("JETPACK_BOOTSTRAP_DEPS_FROM_HEAD") ?? "") == "1",
        scratch: resolve_path(base, mode),
    }
}

// The state root of Tools/agent/roots.sh.
state_root: fn() -> String {
    given: process.env_get("JET_STATE_ROOT") ?? ""
    if given != "" -> return given
    cache: process.env_get("XDG_CACHE_HOME") ?? ""
    if cache != "" -> return files.join(cache, "jet-dev")
    files.join(files.join(process.env_get("HOME") ?? "", ".cache"), "jet-dev")
}

// The jet that runs the repository's Jet tools: $JET_BIN, else the current seed.
tool_jet: fn() -> String {
    given: process.env_get("JET_BIN") ?? ""
    if given != "" -> return given
    seed: process.env_get("JET_SEED") ?? ""
    if seed != "" -> return "{seed}/jet"
    seeds: process.env_get("JET_SEEDS") ?? ""
    if seeds != "" -> return "{seeds}/current/jet"
    data: process.env_get("XDG_DATA_HOME") ?? ""
    home: process.env_get("HOME") ?? ""
    if data != "" -> "{data}/jet-seeds/current/jet" else -> "{home}/.local/share/jet-seeds/current/jet"
}

// --- assembly -------------------------------------------------------------------

// One listed source: its repository path, its bytes, its text with embeds
// rebased, its manifest line and its section.
Entry: struct {
    path: String
    bytes: [U8]
    text: String
    place: String
    section: String
}

// One file's place in the unit, for the source map.
Mapped: struct {
    path: String
    sha256: String
    original_bytes: Int
    original_lines: Int
    line_starts: [Int]
    start_byte: Int
    end_byte: Int
    start_line: Int
    end_line: Int
}

// A test claim and its tests.list section.
Claim: struct {
    name: String
    section: String
}

// The staged `embed_file` copies, in first-seen order, each with the file it copies.
Embeds: struct {
    copies: [String]
    targets: [String: String]
}

// Assemble the unit `config` names into its scratch directory. `members` are
// the compiler's library member files (Tools/agent/CompilerPackages.jet
// sources), for the compiler-slice check.
assemble: fn(config: Config, members: [String]) -> Assembled Err! {
    embeds := Embeds{copies: [String]{}, targets: [String: String]{}}
    registered: read_manifest(config, "sources.list", embeds)
    drift: slice_drift(config.root, members)
    if drift.len() > 0 {
        listed := [String]{}
        loop problem in drift -> listed.push("  {problem}")
        return Err("the Jetpack compiler slice drifted from the compiler's packages:\n{listed.join("\n")}")
    }
    tests: read_manifest(config, "tests.list", embeds)
    if config.areas == .Val(selected) {
        listing: files.read("{config.root}/Jetpack/Bootstrap/sources.list") ?? return Err("cannot read Jetpack/Bootstrap/sources.list: {err}")
        known := [String: Bool]{}
        loop line in split_lines(listing) {
            if section_header(line.trim()) == .Val(header) -> known[header.name] = true
        }
        loop area in selected {
            if !(known.get(area) ?? false) -> return Err("JETPACK_BOOTSTRAP_AREAS names unknown section {area}")
        }
    }
    seen := [String: Bool]{}
    loop entry in registered {
        if seen.get(entry.path) ?? false -> return Err("{entry.place}: duplicate source {entry.path}")
        seen[entry.path] = true
    }
    loop entry in tests {
        if seen.get(entry.path) ?? false -> return Err("{entry.place}: duplicate source {entry.path}")
        seen[entry.path] = true
    }
    loop entry in registered {
        if entry.path.contains("/Tests/") -> return Err("{entry.place}: test sources belong in tests.list")
    }
    loop entry in tests {
        if !is_test_path(entry.path) -> return Err("{entry.place}: tests.list names only Jetpack/<Area>/Tests or shared Compiler/JetFoundation/Tests sources")
    }
    // Every Jetpack source and test file must be listed; an unlisted file is
    // either dead code or an ordering decision nobody made. When one area is
    // being proved (JETPACK_BOOTSTRAP_OWN_AREA), only that area must be
    // complete: its dependency areas may hold another writer's unlisted work
    // in progress, which is left out of the unit and noted, never a reason to
    // fail this proof.
    blocking := [String]{}
    skipped := 0
    loop found in inventory(config) {
        if seen.get(found.path) ?? false -> next
        if config.own == .Val(own) && found.area != own {
            skipped += 1
            next
        }
        blocking.push(found.path.copy()) // copy: the inventory row is dropped
    }
    if blocking.len() > 0 {
        listed := [String]{}
        loop path in sorted(blocking) -> listed.push("  {path}")
        return Err("Jetpack sources are not listed in Jetpack/Bootstrap/sources.list or tests.list; add them in explicit order:\n{listed.join("\n")}")
    }
    // Proving one area runs only that area's tests; each dependency area
    // proves its own tests in its own unit. JETPACK_BOOTSTRAP_TEST_AREAS keeps
    // only those sections' claims: the packages suite runs the engine areas
    // that have no package.jet this way.
    if config.test_sections == .Val(sections) {
        loop section in sections {
            if !has_section(tests, section) -> return Err("JETPACK_BOOTSTRAP_TEST_AREAS names {section}, which has no tests.list section with claims")
        }
    }
    // The unit: the implementation files, then the selected tests.
    units := registered
    test_paths := [String: Bool]{}
    if config.mode != "hosted" {
        loop entry in tests {
            own_ok: if config.own == .Val(own) -> entry.section == own else -> true
            sections_ok: if config.test_sections == .Val(sections) -> has(sections, entry.section) else -> true
            if !own_ok || !sections_ok -> next
            test_paths[entry.path.copy()] = true // copy: the unit entry keeps it
            units.push(entry)
        }
    }
    if config.mode == "hosted" {
        path: "Jetpack/run.jet"
        bytes: files.read_bytes("{config.root}/{path}") ?? return Err("cannot read {path}: {err}")
        text: String.from_bytes(bytes) ?? return Err("{path}: source is not valid UTF-8")
        units.push(Entry{path: path, bytes: bytes, text: text, place: path, section: ""})
    }
    if units.len() == 0 -> return Err("Jetpack/Bootstrap/sources.list contains no sources")

    // The listed Compiler/ front-end files import their sibling packages with
    // `use <package>.[names]` or `use <package>.name`. This unit is one
    // namespace, so those imports are blanked to spaces of the same length
    // (every byte offset and line in the source map still matches). A
    // repeated single-line Core import after its first occurrence is blanked
    // the same way (a duplicate import name is E0105), and grouped Core member
    // imports are deduplicated per member.
    seen_imports := [String: Bool]{}
    seen_members := [String: Bool]{}
    claims := [Claim]{}
    claim_seen := [String: Bool]{}
    output := [U8]{}
    next_line := 1
    mapped := [Mapped]{}
    loop entry in units {
        append(output, "// [jet-bootstrap source: {entry.path}]\n")
        next_line += 1
        packages_blanked: blank_package_imports(unblock_uses(entry.text), PACKAGE_NAMES)
        members_kept: blank_repeated_members(packages_blanked, seen_members)
        text: blank_repeated_imports(members_kept, seen_imports)
        if test_paths.get(entry.path) ?? false -> render_tests(text, entry.path, entry.section, claims, claim_seen) ?? return Err(err.message)
        body: text.bytes()
        body_bytes: body.len()
        start_byte: output.len()
        start_line: next_line
        newlines := 0
        line_starts := [Int]{0}
        loop (index, byte) in body {
            if byte == (U8{10}) {
                newlines += 1
                line_starts.push(index + 1)
            }
        }
        closed: body_bytes > 0 && body[body_bytes - 1] == (U8{10})
        output.extend(body)
        next_line += newlines
        if !closed {
            output.push(U8{10})
            next_line += 1
        }
        line_count: if {
            body_bytes == 0 -> 0
            closed -> newlines
            else -> newlines + 1
        }
        mapped.push(Mapped{
            path: entry.path.copy(), // copy: the entry is dropped with the unit list
            sha256: crypto.sha256(entry.bytes).hex(),
            original_bytes: entry.bytes.len(),
            original_lines: line_count,
            line_starts: line_starts,
            start_byte: start_byte,
            end_byte: start_byte + body_bytes,
            start_line: start_line,
            end_line: start_line + line_count - 1,
        })
    }

    project: "{config.scratch}/project"
    source_dir: "{project}/src"
    if files.exists(project) -> files.remove_all(project) ?? return Err("cannot remove {project}: {err}")
    files.create_dir_all(source_dir) ?? return Err("cannot create {source_dir}: {err}")
    loop staged in embeds.copies {
        target: embeds.targets.get(staged) ?? ""
        destination: "{source_dir}/{staged}"
        files.create_dir_all(files.dirname(destination)) ?? return Err("cannot create {files.dirname(destination)}: {err}")
        files.copy(target, destination) ?? return Err("cannot copy embedded file {relative_to(config.root, target)}: {err}")
    }
    files.write_bytes("{source_dir}/jetpack.jet", output) ?? return Err("cannot write {source_dir}/jetpack.jet: {err}")
    files.write("{project}/package.jet", PACKAGE_SOURCE) ?? return Err("cannot write {project}/package.jet: {err}")
    map_text: json.to_string_pretty(source_map(config, mapped, embeds, claims)) ?? return Err("the source map cannot be encoded: {err}")
    files.write("{config.scratch}/jetpack.map.json", "{map_text}\n") ?? return Err("cannot write {config.scratch}/jetpack.map.json: {err}")
    Assembled{units: units.len(), claims: claims.len(), skipped: skipped}
}

append: fn(out: &[U8], text: String) {
    out.extend(text.bytes())
}

// The source map: schema jet-bootstrap-source-map/v2.
source_map: fn(config: Config, mapped: [Mapped], embeds: Embeds, claims: [Claim]) -> Dyn {
    segments := [Dyn]{}
    file_rows := [Dyn]{}
    loop row in mapped {
        starts := [Dyn]{}
        loop start in row.line_starts -> starts.push(Dyn.Int(start))
        segments.push(Dyn.Object([String: Dyn]{
            "generated": Dyn.Object([String: Dyn]{"start": Dyn.Int(row.start_byte), "end": Dyn.Int(row.end_byte)}),
            "source_file": Dyn.Text(row.path.copy()), // copy: the file row names it too
            "line_starts": Dyn.Array(starts.copy()), // copy: the file row lists them too
        }))
        file_rows.push(Dyn.Object([String: Dyn]{
            "path": Dyn.Text(row.path.copy()), // copy: the segment named it first
            "sha256": Dyn.Text(row.sha256.copy()), // copy: the row is borrowed
            "original_bytes": Dyn.Int(row.original_bytes),
            "original_lines": Dyn.Int(row.original_lines),
            "line_starts": Dyn.Array(starts),
            "generated_start_byte": Dyn.Int(row.start_byte),
            "generated_end_byte_exclusive": Dyn.Int(row.end_byte),
            "generated_start_line": Dyn.Int(row.start_line),
            "generated_end_line": Dyn.Int(row.end_line),
        }))
    }
    embedded := [Dyn]{}
    loop staged in embeds.copies {
        target: embeds.targets.get(staged) ?? ""
        embedded.push(Dyn.Object([String: Dyn]{
            "copy": Dyn.Text("src/{staged}"),
            "source_file": Dyn.Text(relative_to(config.root, target)),
        }))
    }
    names := [Dyn]{}
    sections := [Dyn]{}
    loop claim in claims {
        names.push(Dyn.Text(claim.name.copy())) // copy: the claim list is borrowed
        sections.push(Dyn.Text(claim.section.copy())) // copy: the claim list is borrowed
    }
    Dyn.Object([String: Dyn]{
        "schema": Dyn.Text("jet-bootstrap-source-map/v2"),
        "module": Dyn.Text("Jetpack"),
        "mode": Dyn.Text(config.mode.copy()), // copy: the config is borrowed
        "fallback_source_file": Dyn.Text("Jetpack"),
        "source_segments": Dyn.Array(segments),
        "files": Dyn.Array(file_rows),
        // Each staged embed_file copy and the repository file it came from.
        "embedded_files": Dyn.Array(embedded),
        "tests": Dyn.Array(names),
        // Each claim's tests.list section: the packages suite's row is `Jetpack/<section>: <claim>`.
        "test_areas": Dyn.Array(sections),
    })
}

// A Jetpack file under an area's Source or Tests tree, and its area folder.
Inventoried: struct {
    area: String
    path: String
}

// Every `.jet` file (but package.jet) under Jetpack/<Area>/Source and Tests of
// each selected area folder but Bootstrap.
inventory: fn(config: Config) -> [Inventoried] {
    out := [Inventoried]{}
    listed: files.list_dir("{config.root}/Jetpack") ?? return out
    loop area in listed {
        if !area.is_dir || area.name == "Bootstrap" -> next
        if config.areas == .Val(selected) && !has(selected, area.name) -> next
        loop kind in TREE_KINDS {
            loop path in jet_files_under(config.root, "Jetpack/{area.name}/{kind}") -> out.push(Inventoried{area: area.name.copy(), path: path}) // copy: every file of the area records it
        }
    }
    out
}

// The `.jet` files under `directory` (repository-relative), depth first in
// name order.
jet_files_under: fn(root: String, directory: String) -> [String] {
    out := [String]{}
    listed := files.list_dir("{root}/{directory}") ?? return out
    listed.sort_by((left: DirEntry, right: DirEntry) -> compare_bytes(left.name.bytes(), right.name.bytes()))
    loop entry in listed {
        path: "{directory}/{entry.name}"
        if entry.is_dir {
            out.extend(jet_files_under(root, path))
            next
        }
        if entry.name.ends_with(".jet") && entry.name != "package.jet" && files.is_file("{root}/{path}") -> out.push(path)
    }
    out
}

compare_bytes: fn(left: [U8], right: [U8]) -> Ordering {
    at := 0
    loop at < left.len() && at < right.len() {
        if left[at] != right[at] -> return if left[at] < right[at] -> Ordering.Less else -> Ordering.Greater
        at += 1
    }
    compare_ints(left.len(), right.len())
}

compare_ints: fn(left: Int, right: Int) -> Ordering {
    if {
        left < right -> Ordering.Less
        left > right -> Ordering.Greater
        else -> Ordering.Equal
    }
}

sorted: fn(items: [String]) -> [String] {
    out := items.copy()
    out.sort_by((left: String, right: String) -> compare_bytes(left.bytes(), right.bytes()))
    out
}

has: fn(items: [String], wanted: String) -> Bool {
    loop item in items {
        if item == wanted -> return true
    }
    false
}

has_section: fn(entries: [Entry], section: String) -> Bool {
    loop entry in entries {
        if entry.section == section -> return true
    }
    false
}

// `text` split at commas, each part trimmed, empty parts and repeats dropped.
comma_list: fn(text: String) -> [String] {
    out := [String]{}
    loop part in text.split(",") {
        name: part.trim()
        if name != "" && !has(out, name) -> out.push(name)
    }
    out
}

is_plain_name: fn(name: String) -> Bool {
    if name == "" -> return false
    loop byte in name.bytes() {
        if !is_ident_byte(byte) && byte != (U8{45}) -> return false
    }
    true
}

// `Jetpack/<Area>/Tests/…` or `Compiler/JetFoundation/Tests/…`.
is_test_path: fn(path: String) -> Bool {
    if path.starts_with("Compiler/JetFoundation/Tests/") -> return true
    if !path.starts_with("Jetpack/") -> return false
    area: path.removeprefix("Jetpack/").partition("/")
    area.sep != "" && area.head != "" && area.tail.starts_with("Tests/")
}

// The lines of `text`, each without its `\r\n` or `\n`.
split_lines: fn(text: String) -> [String] {
    out := [String]{}
    loop line in text.split("\n") -> out.push(line.removesuffix("\r"))
    out
}

// A manifest section header, `# == Name ==` or `# == Name (detail) ==`.
Header: struct {
    name: String
    detail: String
}

// The header `line` (trimmed) opens, None when it opens none.
section_header: fn(line: String) -> Header? {
    if !line.starts_with("#") -> return None
    rest: line.removeprefix("#").trim_start()
    if !rest.starts_with("==") -> return None
    body: rest.removeprefix("==")
    if !body.ends_with("==") || body.count_bytes() < 2 -> return None
    inner: body.removesuffix("==").trim()
    parts: inner.partition("(")
    name: parts.head.trim()
    if name == "" || name.contains("=") -> return None
    if parts.sep == "" -> return Val(Header{name: name, detail: ""})
    tail: parts.tail.trim_end()
    if !tail.ends_with(")") -> return None
    Val(Header{name: name, detail: tail.removesuffix(")")})
}

// The manifest `name` of the dependency sections from HEAD and the own area's
// lines live, when JETPACK_BOOTSTRAP_DEPS_FROM_HEAD is set.
merged_manifest: fn(config: Config, working: String, name: String) -> String Err! {
    if !config.deps_from_head -> return working.copy() // copy: the working text is the manifest
    own: config.own ?? ""
    head_bytes: head_file(config.root, "Jetpack/Bootstrap/{name}") ?? return Err(err.message)
    head_text: String.from_bytes(head_bytes) ?? ""
    head_sections := [String: [String]]{}
    current := ""
    inside := false
    loop line in split_lines(head_text) {
        if section_header(line.trim()) == .Val(header) {
            current = header.name
            inside = true
            next
        }
        if !inside -> next
        rows := head_sections.get(current) ?? [String]{}
        rows.push(line)
        head_sections[current] = rows
    }
    out := [String]{}
    current = ""
    inside = false
    owned: config.own != None
    loop line in split_lines(working) {
        if section_header(line.trim()) == .Val(header) {
            current = header.name
            inside = true
            out.push(line)
            if !owned || current != own -> out.extend(head_sections.get(current) ?? [String]{})
            next
        }
        if !inside || (owned && current == own) -> out.push(line)
    }
    Ok(out.join("\n"))
}

// HEAD's bytes of `path` in the source root.
head_file: fn(root: String, path: String) -> [U8] Err! {
    shown: process.cmd([String]{"git", "show", "HEAD:{path}"}).cwd(root).output_limit(268435456).run() ?? return Err("--deps-from-head: {path} is not in HEAD ({err})")
    if !shown.success -> return Err("--deps-from-head: {path} is not in HEAD ({shown.errors.partition("\n").head})")
    Ok(shown.output.bytes())
}

// The entries of manifest `name` in the selected sections, validated, with
// their embeds staged.
read_manifest: fn(config: Config, name: String, embeds: &Embeds) -> [Entry] Err! {
    label: "Jetpack/Bootstrap/{name}"
    working: files.read("{config.root}/{label}") ?? return Err("cannot read {label}: {err}")
    text: merged_manifest(config, working, name) ?? return Err(err.message)
    entries := [Entry]{}
    misplaced := [String]{}
    // Section headers look like `# == PackageModel ==`; the name is the text
    // before any `(`. An area that spans several Jetpack folders names them:
    // `# == Engine (folders: Store, Trust) ==`.
    section := ""
    in_section := false
    folders := [String]{}
    loop (index, raw) in split_lines(text) {
        source_path: raw.trim()
        if section_header(source_path) == .Val(header) {
            section = header.name
            in_section = true
            detail: header.detail.trim()
            folders = if detail.starts_with("folders:") -> comma_list(detail.removeprefix("folders:")) else -> [String]{header.name.copy()} // copy: the section names it too
            next
        }
        if source_path == "" || source_path.starts_with("#") -> next
        place: "{label}:{index + 1}"
        normalized: normalize_join(".", source_path)
        if source_path.starts_with("/") || normalized == "" || !source_path.ends_with(".jet") -> return Err("{place}: expected a repository-relative .jet source path")
        if source_path != normalized -> return Err("{place}: use the canonical path {normalized}")
        if !ALLOWED_PREFIXES.any(prefix -> source_path.starts_with(prefix)) -> return Err("{place}: sources must live under {ALLOWED_PREFIXES.join(" or ")}")
        area: jetpack_area(source_path)
        if area != "" && !has(folders, area) -> misplaced.push("{place}: {source_path} belongs under the `# == {area} ==` section")
        if !in_section -> return Err("{place}: every source belongs to a `# == Area ==` section")
        if config.areas == .Val(selected) && !has(selected, section) -> next
        // Dependency references have the same live/HEAD rule, never a
        // per-file fallback to a different implementation.
        owned: if config.own == .Val(own) -> section == own else -> false
        bytes: if config.deps_from_head && !owned -> head_file(config.root, source_path) ?? return Err(err.message) else -> live_source(config.root, source_path, place) ?? return Err(err.message)
        source_text: String.from_bytes(bytes) ?? return Err("{source_path}: source is not valid UTF-8")
        rebased: rebase_embeds(config.root, source_text, source_path, place, embeds) ?? return Err(err.message)
        entries.push(Entry{path: source_path, bytes: bytes, text: rebased, place: place, section: section.copy()}) // copy: every entry of the section records it
    }
    if misplaced.len() > 0 -> return Err(misplaced.join("\njetpack-bootstrap: "))
    Ok(entries)
}

// The live bytes of `path`: a regular file whose real path stays in the root.
live_source: fn(root: String, path: String, place: String) -> [U8] Err! {
    canonical: files.canonicalize("{root}/{path}") ?? return Err("{place}: missing source {path}: {err}")
    if !contained(root, canonical) -> return Err("{path}: source resolves outside the source root")
    if !files.is_file(canonical) -> return Err("{path}: source is not a regular file")
    files.read_bytes(canonical) ?? return Err("{place}: missing source {path}: {err}")
}

// The area folder of a `Jetpack/<Area>/…` path, "" for any other.
jetpack_area: fn(path: String) -> String {
    if !path.starts_with("Jetpack/") -> return ""
    parts: path.removeprefix("Jetpack/").partition("/")
    if parts.sep == "" || parts.head == "" -> "" else -> parts.head
}

// `embed_file("rel")` is written relative to its own source file, as in any
// package. The assembled unit lives elsewhere and an embed may not leave its
// project (E0957), so each embedded file is copied into the unit's project as
// `src/embedded/<repository path>.embed` and the call is rebased onto that
// copy. The suffix keeps an embedded `.jet` asset from becoming a package
// source file; the embedded file itself must stay inside the source root.
rebase_embeds: fn(root: String, text: String, source_path: String, place: String, embeds: &Embeds) -> String Err! {
    raw: text.bytes()
    out := [U8]{}
    at := 0
    loop at < raw.len() {
        if !starts_at(raw, at, "embed_file(\"") {
            out.push(raw[at])
            at += 1
            next
        }
        open: at + 12
        end := open
        loop end < raw.len() && raw[end] != (U8{34}) && raw[end] != (U8{92}) && raw[end] != (U8{123}) && raw[end] != (U8{125}) -> end += 1
        if end == open || !starts_at(raw, end, "\")") {
            out.push(raw[at])
            at += 1
            next
        }
        rel: text_of(raw, open, end)
        if rel.starts_with("/") -> return Err("{place}: {source_path}: embed_file paths are relative to their source file")
        target: normalize_join(files.dirname("{root}/{source_path}"), rel)
        if target == "" || !contained(root, target) -> return Err("{place}: {source_path}: embed_file(\"{rel}\") resolves outside the source root")
        staged: "embedded/{relative_to(root, target)}.embed"
        if embeds.targets.get(staged) == None -> embeds.copies.push(staged.copy()) // copy: the target map keys it too
        embeds.targets[staged.copy()] = target // copy: the call below names it
        out.extend("embed_file(\"{staged}\")".bytes())
        at = end + 2
    }
    Ok(String.from_bytes(out) ?? "")
}

// A column-zero `#Test("name") {` claim line, its name; None for any other line.
claim_name: fn(line: String) -> String? {
    raw: line.bytes()
    if !starts_at(raw, 0, "#Test(\"") -> return None
    end := 7
    loop end < raw.len() && raw[end] != (U8{34}) && raw[end] != (U8{92}) && raw[end] != (U8{123}) && raw[end] != (U8{125}) -> end += 1
    if end == 7 || !starts_at(raw, end, "\")") -> return None
    rest: text_of(raw, end + 2, raw.len()).trim_start()
    if !rest.starts_with("{{") || rest.removeprefix("{{").trim() != "" -> return None
    Val(text_of(raw, 7, end))
}

// Record the test claims of the unit test file `path`. A top-level test claim
// starts at column zero. Claim names are plain text (no interpolation holes or
// escapes) so the source map's claim ledger names exactly what `jet test`
// prints.
render_tests: fn(text: String, path: String, section: String, claims: &[Claim], seen: &[String: Bool]) Err! {
    count := 0
    loop (index, line) in text.split("\n").to_list() {
        if claim_name(line) == .Val(name) {
            count += 1
            if seen.get(name) ?? false -> return Err("{path}:{index + 1}: duplicate test claim \"{name}\"")
            seen[name.copy()] = true // copy: the claim records it
            claims.push(Claim{name: name, section: section.copy()}) // copy: every claim of the file records it
            next
        }
        trimmed: line.trim_start()
        if trimmed.starts_with("#Test") && !(trimmed.count_bytes() > 5 && is_ident_byte(trimmed.bytes()[5])) {
            return Err("{path}:{index + 1}: write test claims as a column-zero `#Test(\"plain name\") {{` line; names cannot contain quotes, backslashes, or braces")
        }
    }
    // Shared test helpers live in `*Support.jet` files: helpers only, never claims.
    support: path.ends_with("Support.jet")
    if support && count > 0 -> return Err("{path}: a *Support.jet test helper file must not declare #Test claims")
    if !support && count == 0 -> return Err("{path}: a tests.list entry must declare at least one #Test claim (shared helpers go in a *Support.jet file)")
    Ok(())
}

// --- paths -------------------------------------------------------------------------

// `path` against `base`: an absolute `path` stands alone; `.` and `..` resolve.
resolve_path: fn(base: String, path: String) -> String {
    joined: normalize_join(base, path)
    if joined == "" -> "/" else -> joined
}

// Whether `path` (absolute, normalized) is `root` or under it.
contained: fn(root: String, path: String) -> Bool {
    fspath.is_relative_to(fspath.of(path), fspath.of(root))
}

// `path` relative to `root`, which holds it.
relative_to: fn(root: String, path: String) -> String {
    if path == root -> return ""
    path.removeprefix("{root}/")
}

normalize_join: fn(directory: String, path: String) -> String {
    whole: if path.starts_with("/") -> path else -> "{directory}/{path}"
    parts := [String]{}
    loop part in whole.split("/") {
        if part == "" || part == "." -> next
        if part == ".." {
            if parts.len() == 0 -> return ""
            _ := parts.pop()
            next
        }
        parts.push(part)
    }
    joined: parts.join("/")
    if whole.starts_with("/") -> "/{joined}" else -> joined
}

// --- areas -------------------------------------------------------------------------

// The area graph of areas.list, checked against the manifests' sections.
AreaGraph: struct {
    order: [String]
    deps: [String: [String]]
    sources: [String: [String]]

    // The area and its transitive dependencies, bottom-up.
    closure: fn(self, area: String) -> [String] Err! {
        if self.deps.get(area) == None -> return Err("unknown area {area}")
        seen := [String: Bool]{}
        pending := [String]{area.copy()} // copy: the walk owns its queue
        loop pending.len() > 0 {
            name: pending.pop() ?? ""
            if seen.get(name) ?? false -> next
            seen[name.copy()] = true // copy: the name is walked below
            direct: self.deps.get(name) ?? [String]{}
            loop dep in direct -> pending.push(dep)
        }
        out := [String]{}
        loop name in self.order {
            if seen.get(name) ?? false -> out.push(name.copy()) // copy: the order stays the graph's
        }
        Ok(out)
    }
}

// Each section of manifest `file` with its listed paths, in section order.
Sections: struct {
    names: [String]
    paths: [String: [String]]
}

manifest_sections: fn(root: String, file: String) -> Sections Err! {
    text: files.read("{root}/Jetpack/Bootstrap/{file}") ?? return Err("cannot read Jetpack/Bootstrap/{file}: {err}")
    found := Sections{names: [String]{}, paths: [String: [String]]{}}
    current := ""
    inside := false
    loop raw in split_lines(text) {
        line: raw.trim()
        if section_header(line) == .Val(header) {
            current = header.name
            inside = true
            if found.paths.get(current) == None -> found.names.push(current.copy()) // copy: the map keys it too
            found.paths[current.copy()] = [String]{} // copy: later lines file under it
            next
        }
        if !inside || line == "" || line.starts_with("#") -> next
        rows := found.paths.get(current) ?? [String]{}
        rows.push(line)
        found.paths[current.copy()] = rows // copy: later lines file under it
    }
    Ok(found)
}

area_graph: fn(root: String) -> AreaGraph Err! {
    text: files.read("{root}/Jetpack/Bootstrap/areas.list") ?? return Err("cannot read Jetpack/Bootstrap/areas.list: {err}")
    order := [String]{}
    deps := [String: [String]]{}
    loop (index, raw) in split_lines(text) {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        parts: line.partition(":")
        if parts.sep == "" || parts.head == "" -> return Err("areas.list:{index + 1}: expected `Area: Dep, Dep`")
        area: parts.head.trim()
        if deps.get(area) != None -> return Err("areas.list:{index + 1}: duplicate area {area}")
        direct := [String]{}
        loop piece in parts.tail.split(",") {
            dep: piece.trim()
            if dep == "" -> next
            if deps.get(dep) == None -> return Err("areas.list:{index + 1}: {area} depends on {dep}, which must be declared earlier (bottom-up, no cycles)")
            direct.push(dep)
        }
        deps[area.copy()] = direct // copy: the order lists it too
        order.push(area)
    }
    source_sections: manifest_sections(root, "sources.list") ?? return Err(err.message)
    test_sections: manifest_sections(root, "tests.list") ?? return Err(err.message)
    loop area in source_sections.names {
        if deps.get(area) == None -> return Err("sources.list section {area} is missing from areas.list")
    }
    loop area in test_sections.names {
        if deps.get(area) == None -> return Err("tests.list section {area} is missing from areas.list")
    }
    loop area in order {
        if source_sections.paths.get(area) == None -> return Err("areas.list names {area}, which has no sources.list section")
    }
    Ok(AreaGraph{order: order, deps: deps, sources: source_sections.paths})
}

areas_command: fn(root: String, args: [String]) -> String Err! {
    if args.len() == 0 -> return Err("usage: Assemble.jet areas closure <Area> | sources <Area> | populated")
    graph: area_graph(root) ?? return Err(err.message)
    if args[0] == {
        "closure" -> {
            if args.len() != 2 -> return Err("closure needs an area")
            closure: graph.closure(args[1]) ?? return Err(err.message)
            Ok(closure.join(","))
        }
        "sources" -> {
            if args.len() != 2 -> return Err("sources needs an area")
            listed := [String]{}
            loop area in graph.closure(args[1]) ?? return Err(err.message) -> listed.extend(graph.sources.get(area) ?? [String]{})
            Ok(listed.join("\n"))
        }
        "populated" -> {
            if args.len() != 1 -> return Err("usage: Assemble.jet areas closure <Area> | sources <Area> | populated")
            // Only areas with Jetpack sources are checkable units; reused
            // Compiler sections are dependencies.
            populated := [String]{}
            loop area in graph.order {
                paths: graph.sources.get(area) ?? [String]{}
                if paths.any(path -> path.starts_with("Jetpack/")) -> populated.push(area.copy()) // copy: the order stays the graph's
            }
            Ok(populated.join("\n"))
        }
        else -> Err("usage: Assemble.jet areas closure <Area> | sources <Area> | populated")
    }
}

// --- compiler slice ----------------------------------------------------------------

// The compiler's library member files (a package's entry, its root run.jet,
// is not part of a slice): Tools/agent/CompilerPackages.jet sources, run by
// `tool_jet()` from the checkout `repo`.
compiler_members: fn(root: String, repo: String) -> [String] Err! {
    jet: tool_jet()
    listed: process.cmd([String]{jet, "{repo}/{COMPILER_PACKAGES}", "--root", root, "sources"}).cwd(repo).output_limit(1073741824).run() ?? return Err("couldn't run `{jet} {COMPILER_PACKAGES} sources`: {err}")
    if !listed.success -> return Err("`{COMPILER_PACKAGES} sources` exited {listed.code}: {process.combined_output(listed).trim_end()}")
    Ok(member_rows(listed.output))
}

// The member paths of `NAME<TAB>DIRECTORY<TAB>FILE` rows, without each
// package's run.jet, under Compiler/.
member_rows: fn(text: String) -> [String] {
    out := [String]{}
    loop row in text.split("\n") {
        if row == "" -> next
        fields: row.split("\t").to_list()
        if fields.len() < 3 -> next
        path: fields[2]
        if path == "{fields[1]}/run.jet" || !path.starts_with("Compiler/") -> next
        out.push(path.copy()) // copy: the row is dropped
    }
    out
}

slice_problems: fn(root: String, repo: String) -> [String] Err! {
    members: compiler_members(root, repo) ?? return Err(err.message)
    Ok(slice_drift(root, members))
}

// The non-blank, non-comment lines of `text`, trimmed.
listed_paths: fn(text: String) -> [String] {
    out := [String]{}
    loop raw in split_lines(text) {
        line: raw.trim()
        if line != "" && !line.starts_with("#") -> out.push(line)
    }
    out
}

// A top-level declaration: its name and whether it is a function.
Declaration: struct {
    name: String
    is_fn: Bool
}

// The texts the drift check reads, each read once; a file that cannot be read is
// empty (the assembly reports it).
SourceCache: struct {
    root: String
    texts: [String: String]

    code_of: fn(&self, path: String) -> String {
        if self.texts.get(path) == .Val(known) -> return known.copy() // copy: the cache keeps it
        text: code(files.read("{self.root}/{path}") ?? "")
        self.texts[path.copy()] = text.copy() // copy: the caller reads it too
        text
    }
}

// The slice's drift problems, in report order.
slice_drift: fn(root: String, members: [String]) -> [String] {
    cache := SourceCache{root: root, texts: [String: String]{}}
    sources: files.read("{root}/Jetpack/Bootstrap/sources.list") ?? ""
    tests: files.read("{root}/Jetpack/Bootstrap/tests.list") ?? ""
    jetpack_list := listed_paths(sources)
    jetpack_list.extend(listed_paths(tests))
    member_set := [String: Bool]{}
    loop path in members -> member_set[path] = true
    slice := [String]{}
    listed_set := [String: Bool]{}
    slice_packages := [String: Bool]{}
    problems := [String]{}
    loop path in jetpack_list {
        if !path.starts_with("Compiler/") -> next
        slice.push(path.copy()) // copy: the unit list keeps it
        listed_set[path.copy()] = true // copy: the unit list keeps it
        slice_packages[package_of(path)] = true
    }
    loop path in slice {
        if !(member_set.get(path) ?? false) && !path.contains("/Tests/") -> problems.push("{path} is not a member of the compiler's packages")
    }
    // Names declared by the unit itself, and the unlisted compiler files that
    // alone declare a name.
    unit_declared := [String: Bool]{}
    loop path in jetpack_list {
        loop name in declared(cache.code_of(path)) -> unit_declared[name] = true
    }
    owner_paths := [String]{}
    owner_fns := [Bool]{}
    owner_at := [String: Int]{}
    loop path in members {
        loop row in declarations(cache.code_of(path)) {
            if owner_at.get(row.name) != None {
                owner_at[row.name] = -1
                next
            }
            owner_at[row.name] = owner_paths.len()
            owner_paths.push(path.copy()) // copy: every name of the file records it
            owner_fns.push(row.is_fn)
        }
    }
    missing_order := [String]{}
    missing := [String: [String]]{}
    queue := jetpack_list.copy()
    at := 0
    loop at < queue.len() {
        path: queue[at].copy() // copy: the queue grows below
        at += 1
        uses: referenced(cache.code_of(path))
        loop name in uses.names {
            if unit_declared.get(name) ?? false -> next
            slot: owner_at.get(name) ?? -1
            if slot < 0 -> next
            owner: owner_paths[slot].copy() // copy: the owner table stays whole
            if listed_set.get(owner) ?? false -> next
            if owner_fns[slot] && !(uses.called.get(name) ?? false) -> next
            if !(slice_packages.get(package_of(owner)) ?? false) {
                problems.push("{path} uses {name}, which only {owner} declares, outside the compiler slice")
                next
            }
            if missing.get(owner) == None {
                missing_order.push(owner.copy()) // copy: the missing map keys it too
                missing[owner.copy()] = [String]{} // copy: the queue holds it too
                queue.push(owner.copy()) // copy: its declarations are read below
                loop declared_name in declared(cache.code_of(owner)) -> unit_declared[declared_name] = true
            }
            rows := missing.get(owner) ?? [String]{}
            line: "{name} (used by {path})"
            if !has(rows, line) -> rows.push(line)
            missing[owner] = rows
        }
    }
    member_index := [String: Int]{}
    loop (index, path) in members -> member_index[path] = index
    missing_order.sort_by((left: String, right: String) -> compare_ints(member_index.get(left) ?? 0, member_index.get(right) ?? 0))
    loop owner in missing_order {
        rows: missing.get(owner) ?? [String]{}
        shown := [String]{}
        loop index in 0..<rows.len() {
            if index < 3 -> shown.push(rows[index].copy()) // copy: the row list stays whole
        }
        more: if rows.len() > 3 -> ", +{rows.len() - 3}" else -> ""
        problems.push("{owner} must be listed: {shown.join(", ")}{more}")
    }
    problems
}

package_of: fn(path: String) -> String {
    parts: path.split("/").to_list()
    if parts.len() > 1 -> parts[1] else -> ""
}

// Code only: comments and the contents of string and raw string literals never
// name a dependency. A run of N backticks opens a raw string and the next run
// of exactly N closes it; a raw string's text keeps its quotes and slashes.
code: fn(text: String) -> String {
    raw: text.bytes()
    out := [U8]{}
    at := 0
    loop at < raw.len() {
        if starts_at(raw, at, "//") {
            end: find_byte(raw, at, U8{10})
            at = if end < 0 -> raw.len() else -> end
            next
        }
        if raw[at] == (U8{96}) {
            count: run_of(raw, at, U8{96})
            close := at + count
            loop close < raw.len() && (raw[close] != (U8{96}) || run_of(raw, close, U8{96}) != count) {
                close += if raw[close] == (U8{96}) -> run_of(raw, close, U8{96}) else -> 1
            }
            out.extend("\"\"".bytes())
            at = if close + count < raw.len() -> close + count else -> raw.len()
            next
        }
        if starts_at(raw, at, "\"\"\"") {
            end: find_text(raw, at + 3, "\"\"\"")
            out.extend("\"\"".bytes())
            at = if end < 0 -> raw.len() else -> end + 3
            next
        }
        if raw[at] == (U8{34}) {
            end := at + 1
            loop end < raw.len() && raw[end] != (U8{34}) && raw[end] != (U8{10}) {
                end += if raw[end] == (U8{92}) -> 2 else -> 1
            }
            out.extend("\"\"".bytes())
            at = if end < raw.len() && raw[end] == (U8{34}) -> end + 1 else -> end
            next
        }
        out.push(raw[at])
        at += 1
    }
    String.from_bytes(out) ?? ""
}

// The length of the run of `mark` bytes at `from`.
run_of: fn(raw: [U8], from: Int, mark: U8) -> Int {
    end := from
    loop end < raw.len() && raw[end] == mark -> end += 1
    end - from
}

// The offset of the first `needle` in `raw` at or after `from`, -1 when none.
find_text: fn(raw: [U8], from: Int, needle: String) -> Int {
    at := from
    loop at < raw.len() {
        if starts_at(raw, at, needle) -> return at
        at += 1
    }
    -1
}

// The top-level declarations of `source` (code only): `name: fn|struct|enum|
// trait|type` (optionally `pub`) at a line start, or an upper-case constant
// `NAME:` (not `:=`).
declarations: fn(source: String) -> [Declaration] {
    raw: source.bytes()
    out := [Declaration]{}
    resume := 0
    at := 0
    loop at < raw.len() {
        if at < resume || (at > 0 && raw[at - 1] != (U8{10})) {
            at += 1
            next
        }
        found: declaration_at(raw, at)
        if found.end > 0 {
            out.push(Declaration{name: found.name, is_fn: found.is_fn})
            resume = found.end
        }
        at += 1
    }
    out
}

// A declaration starting at line start `at`; `end` 0 when none starts there.
DeclarationAt: struct {
    name: String
    is_fn: Bool
    end: Int
}

declaration_at: fn(raw: [U8], at: Int) -> DeclarationAt {
    none: DeclarationAt{name: "", is_fn: false, end: 0}
    after_pub: pub_end(raw, at)
    if after_pub > at {
        with_pub: kind_declaration(raw, after_pub)
        if with_pub.end > 0 -> return with_pub
    }
    plain: kind_declaration(raw, at)
    if plain.end > 0 -> return plain
    // `NAME` then blanks then `:` not followed by `=`.
    if at >= raw.len() || !is_upper(raw[at]) -> return none
    end := at + 1
    loop end < raw.len() && (is_upper(raw[end]) || is_digit(raw[end]) || raw[end] == (U8{95})) -> end += 1
    colon := end
    loop colon < raw.len() && is_space(raw[colon]) -> colon += 1
    if colon >= raw.len() || raw[colon] != (U8{58}) -> return none
    if colon + 1 < raw.len() && raw[colon + 1] == (U8{61}) -> return none
    DeclarationAt{name: text_of(raw, at, end), is_fn: false, end: colon + 1}
}

// The offset after `pub` and its blanks at `at`, `at` when none.
pub_end: fn(raw: [U8], at: Int) -> Int {
    if !starts_at(raw, at, "pub") -> return at
    end := at + 3
    loop end < raw.len() && is_space(raw[end]) -> end += 1
    if end == at + 3 -> at else -> end
}

// `name` blanks `:` blanks kind at `at`, the kind a whole word.
kind_declaration: fn(raw: [U8], at: Int) -> DeclarationAt {
    none: DeclarationAt{name: "", is_fn: false, end: 0}
    name_end: ident_end(raw, at)
    if name_end == at -> return none
    colon := name_end
    loop colon < raw.len() && is_space(raw[colon]) -> colon += 1
    if colon >= raw.len() || raw[colon] != (U8{58}) -> return none
    kind_at := colon + 1
    loop kind_at < raw.len() && is_space(raw[kind_at]) -> kind_at += 1
    kinds: [String]{"fn", "struct", "enum", "trait", "type"}
    loop kind in kinds {
        if !starts_at(raw, kind_at, kind) -> next
        kind_end: kind_at + kind.count_bytes()
        if kind_end < raw.len() && is_ident_byte(raw[kind_end]) -> next
        return DeclarationAt{name: text_of(raw, at, name_end), is_fn: kind == "fn", end: kind_end}
    }
    none
}

// An enum's variants: the names that open its body's top-level entries.
variants: fn(source: String) -> [String] {
    raw: source.bytes()
    names := [String]{}
    resume := 0
    at := 0
    loop at < raw.len() {
        if at < resume || (at > 0 && raw[at - 1] != (U8{10})) {
            at += 1
            next
        }
        body: enum_body(raw, at)
        if body.end > 0 {
            variant_names(raw, body.start, body.end, names)
            resume = body.end + 1
        }
        at += 1
    }
    names
}

// The body of an enum declared at line start `at`: from after its `{` line
// to the `}` that opens a line. `end` 0 when no enum starts there.
EnumBody: struct {
    start: Int
    end: Int
}

enum_body: fn(raw: [U8], at: Int) -> EnumBody {
    after_pub: pub_end(raw, at)
    if after_pub > at {
        with_pub: enum_body_from(raw, after_pub)
        if with_pub.end > 0 -> return with_pub
    }
    enum_body_from(raw, at)
}

enum_body_from: fn(raw: [U8], at: Int) -> EnumBody {
    none: EnumBody{start: 0, end: 0}
    name_end: ident_end(raw, at)
    if name_end == at || name_end >= raw.len() || raw[name_end] != (U8{58}) -> return none
    kind := name_end + 1
    loop kind < raw.len() && is_space(raw[kind]) -> kind += 1
    if !starts_at(raw, kind, "enum") || (kind + 4 < raw.len() && is_ident_byte(raw[kind + 4])) -> return none
    open := kind + 4
    loop open < raw.len() && raw[open] != (U8{123}) && raw[open] != (U8{10}) -> open += 1
    if open + 1 >= raw.len() || raw[open] != (U8{123}) || raw[open + 1] != (U8{10}) -> return none
    start: open + 2
    close := start
    loop close < raw.len() {
        if raw[close] == (U8{125}) && (close == 0 || raw[close - 1] == (U8{10})) -> return EnumBody{start: start, end: close}
        close += 1
    }
    none
}

// The variant names of the enum body `raw[start..<end]` onto `names`.
variant_names: fn(raw: [U8], start: Int, end: Int, names: &[String]) {
    depth := 0
    entry := true
    at := start
    loop at < end {
        byte: raw[at]
        if is_ident_start(byte) {
            word_end := at + 1
            loop word_end < end && is_ident_byte(raw[word_end]) -> word_end += 1
            if entry && depth == 0 {
                if is_upper(byte) -> names.push(text_of(raw, at, word_end))
                entry = false
            }
            at = word_end
            next
        }
        if byte == (U8{40}) || byte == (U8{123}) || byte == (U8{91}) -> depth += 1
        if byte == (U8{41}) || byte == (U8{125}) || byte == (U8{93}) -> depth -= 1
        if byte == (U8{44}) || byte == (U8{10}) -> entry = entry || depth == 0
        at += 1
    }
}

// The names a unit file (code only) declares: its top-level declarations and
// its enums' variants.
declared: fn(source: String) -> [String] {
    out := [String]{}
    loop row in declarations(source) -> out.push(row.name)
    out.extend(variants(source))
    out
}

// The words a file's code names, in first-use order, and the ones it calls.
// A function is used only when called; a same-named local binding is not a use.
Referenced: struct {
    names: [String]
    called: [String: Bool]
}

referenced: fn(source: String) -> Referenced {
    raw: source.bytes()
    names := [String]{}
    seen := [String: Bool]{}
    called := [String: Bool]{}
    at := 0
    loop at < raw.len() {
        if !is_ident_byte(raw[at]) {
            at += 1
            next
        }
        end := at + 1
        loop end < raw.len() && is_ident_byte(raw[end]) -> end += 1
        if is_ident_start(raw[at]) {
            name: text_of(raw, at, end)
            if !(seen.get(name) ?? false) {
                seen[name.copy()] = true // copy: the name list keeps it
                names.push(name.copy()) // copy: the call check reads it
            }
            paren := end
            loop paren < raw.len() && is_space(raw[paren]) -> paren += 1
            if paren < raw.len() && raw[paren] == (U8{40}) -> called[name] = true
        }
        at = end
    }
    Referenced{names: names, called: called}
}

is_upper: fn(byte: U8) -> Bool {
    code: Int.from_u8(byte)
    code >= 65 && code <= 90
}

is_digit: fn(byte: U8) -> Bool {
    code: Int.from_u8(byte)
    code >= 48 && code <= 57
}

is_space: fn(b: U8) -> Bool { b == (U8{32}) || b == (U8{9}) || b == (U8{10}) || b == (U8{13}) || b == (U8{11}) || b == (U8{12}) }

is_ident_start: fn(byte: U8) -> Bool {
    code: Int.from_u8(byte)
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

is_ident_byte: fn(byte: U8) -> Bool {
    is_ident_start(byte) || is_digit(byte)
}

// --- import blanking -----------------------------------------------------------------

// The end of the identifier starting at `at` of `raw` (`at` when none does).
ident_end: fn(raw: [U8], at: Int) -> Int {
    if at >= raw.len() || !is_ident_start(raw[at]) -> return at
    end := at + 1
    loop end < raw.len() && is_ident_byte(raw[end]) -> end += 1
    end
}

text_of: fn(raw: [U8], start: Int, end: Int) -> String {
    if start >= end -> return ""
    String.from_bytes(raw.slice(start, end)) ?? ""
}

starts_at: fn(raw: [U8], at: Int, prefix: String) -> Bool {
    want: prefix.bytes()
    if at + want.len() > raw.len() -> return false
    loop k in 0..<want.len() {
        if raw[at + k] != want[k] -> return false
    }
    true
}

// The offset of the first `byte` of `raw` at or after `from`, -1 when none.
find_byte: fn(raw: [U8], from: Int, byte: U8) -> Int {
    at := from
    loop at < raw.len() {
        if raw[at] == byte -> return at
        at += 1
    }
    -1
}

// The offset after the line holding `at` (after its newline), or the end.
next_line_at: fn(raw: [U8], at: Int) -> Int {
    newline: find_byte(raw, at, U8{10})
    if newline < 0 -> raw.len() else -> newline + 1
}

// `text` with every character but a newline turned to spaces, one space per
// UTF-16 unit.
blank: fn(text: String) -> String {
    out := [U8]{}
    blank_into(out, text.bytes(), 0, text.bytes().len())
    String.from_bytes(out) ?? ""
}

blank_into: fn(out: &[U8], raw: [U8], start: Int, end: Int) {
    loop at in start..<end {
        code: Int.from_u8(raw[at])
        if {
            code == 10 -> out.push(U8{10})
            code < 128 || (code >= 192 && code < 240) -> out.push(U8{32})
            code >= 240 -> {
                out.push(U8{32})
                out.push(U8{32})
            }
        }
    }
}

copy_into: fn(out: &[U8], raw: [U8], start: Int, end: Int) {
    loop at in start..<end -> out.push(raw[at])
}

// The end of a package import starting at line start `at`: `use NAME.[…]`
// through its `]`, or `use NAME.member` with only blanks after it up to the
// end of its line. -1 when the line starts no package import.
package_import_end: fn(raw: [U8], at: Int, names: [String]) -> Int {
    if !starts_at(raw, at, "use ") -> return -1
    loop name in names {
        if !starts_at(raw, at + 4, "{name}.") -> next
        after: at + 4 + name.bytes().len() + 1
        if after < raw.len() && raw[after] == (U8{91}) {
            close: find_byte(raw, after + 1, U8{93})
            return if close < 0 -> -1 else -> close + 1
        }
        end := ident_end(raw, after)
        if end == after -> return -1
        loop end < raw.len() && (raw[end] == (U8{32}) || raw[end] == (U8{9})) -> end += 1
        if end < raw.len() && raw[end] != (U8{10}) -> return -1
        return end
    }
    -1
}

blank_package_imports: fn(text: String, names: [String]) -> String {
    raw: text.bytes()
    out := [U8]{}
    at := 0
    loop at < raw.len() {
        end: package_import_end(raw, at, names)
        start: if end >= 0 -> end else -> at
        if end >= 0 -> blank_into(out, raw, at, end)
        stop: next_line_at(raw, start)
        copy_into(out, raw, start, stop)
        at = stop
    }
    String.from_bytes(out) ?? ""
}

// A grouped Core import at line start `at`: `use core(.member)*.[…]`, with the
// offset of its `[` and the offset after its `]`; None when the line starts
// none.
CoreGroup: struct {
    module_end: Int
    open: Int
    end: Int
}

core_group: fn(raw: [U8], at: Int) -> CoreGroup? {
    if !starts_at(raw, at, "use core") -> return None
    cursor := at + 8
    loop cursor + 1 < raw.len() && raw[cursor] == (U8{46}) && is_ident_start(raw[cursor + 1]) -> cursor = ident_end(raw, cursor + 1)
    if !starts_at(raw, cursor, ".[") -> return None
    close: find_byte(raw, cursor + 2, U8{93})
    if close < 0 -> return None
    Val(CoreGroup{module_end: cursor, open: cursor + 1, end: close + 1})
}

// A repeated member of a grouped Core import is blanked, keeping every
// surviving token at its offset; forms this does not recognize stay as written.
blank_repeated_members: fn(text: String, seen: &[String: Bool]) -> String {
    raw: text.bytes()
    out := [U8]{}
    at := 0
    loop at < raw.len() {
        start := at
        if core_group(raw, at) == .Val(group) {
            path: text_of(raw, at + 4, group.module_end)
            whole: text_of(raw, at, group.end)
            members: text_of(raw, group.open + 1, group.end - 1)
            out.extend(member_imports(whole, path, members, seen).bytes())
            start = group.end
        }
        stop: next_line_at(raw, start)
        copy_into(out, raw, start, stop)
        at = stop
    }
    String.from_bytes(out) ?? ""
}

member_imports: fn(whole: String, path: String, members: String, seen: &[String: Bool]) -> String {
    parts: members.split(",").to_list()
    bindings := [String]{}
    loop part in parts {
        name: part.trim()
        if name == "" {
            bindings.push("")
            next
        }
        if ident_end(name.bytes(), 0) != name.bytes().len() -> return whole.copy() // copy: an unrecognized form stays as written
        bindings.push(name)
    }
    removed := false
    kept := [Bool]{}
    loop binding in bindings {
        if binding == "" {
            kept.push(false)
            next
        }
        key: "{path}.{binding}"
        if seen.get(key) ?? false {
            removed = true
            kept.push(false)
            next
        }
        seen[key] = true
        kept.push(true)
    }
    if !removed -> return whole.copy() // copy: nothing repeated, the import stays as written
    last := -1
    loop index in 0..<kept.len() {
        if kept[index] -> last = index
    }
    if last < 0 -> return blank(whole)
    rewritten := ""
    loop index in 0..<parts.len() {
        piece: if kept[index] -> parts[index] else -> blank(parts[index])
        separator: if {
            index == parts.len() - 1 -> ""
            kept[index] && index < last -> ","
            else -> " "
        }
        rewritten = "{rewritten}{piece}{separator}"
    }
    "{whole.partition("[").head}[{rewritten}]"
}

// A single-line Core import: `use core.x` or `use alias: core.x`, with no `[`.
is_core_import_line: fn(line: String) -> Bool {
    raw: line.bytes()
    if !starts_at(raw, 0, "use ") -> return false
    at := 4
    alias: ident_end(raw, 4)
    if alias > 4 && starts_at(raw, alias, ": ") && starts_at(raw, alias + 2, "core.") {
        at = alias + 2
    }
    if !starts_at(raw, at, "core.") -> return false
    !line.contains("[")
}

// A Core import line repeated from an earlier file (or line) is blanked.
blank_repeated_imports: fn(text: String, seen: &[String: Bool]) -> String {
    lines := [String]{}
    loop line in text.split("\n") {
        if is_core_import_line(line) {
            key: line.trim_end()
            if seen.get(key) ?? false {
                lines.push(blank(line))
                next
            }
            seen[key] = true
        }
        lines.push(line)
    }
    lines.join("\n")
}

// A `use { … }` block (#6542) rewritten as one `use` line per row, keeping
// every line and byte offset: `use {` and its `}` turn to spaces and each
// row's last four columns of indentation become `use `. Line-based import
// scans then see the single-line form. `pub use { … }` blocks stay as written.
unblock_uses: fn(text: String) -> String {
    lines := text.split("\n").to_list()
    indent := ""
    open := false
    depth := 0
    loop at in 0..<lines.len() {
        line: lines[at]
        if !open {
            trimmed: line.trim_start()
            lead: line.removesuffix(trimmed)
            if lead.bytes().all(b -> is_space(b)) && trimmed.starts_with("use {{") && trimmed.removeprefix("use {{").trim() == "" {
                indent = lead
                open = true
                lines[at] = blank(line)
            }
            next
        }
        closer: "{indent}}}"
        if depth == 0 && line.trim_end() == closer {
            open = false
            lines[at] = blank(line)
            next
        }
        row: "{indent}    "
        if depth == 0 && line.starts_with(row) {
            rest: line.removeprefix(row)
            first: if rest.count_bytes() > 0 -> rest.bytes()[0] else -> U8{0}
            if is_ident_start(first) || first == (U8{34}) -> lines[at] = "{indent}use {rest}"
        }
        code: line.partition("//").head
        loop b in code.bytes() {
            if b == (U8{91}) -> depth += 1
            if b == (U8{93}) -> depth -= 1
        }
    }
    lines.join("\n")
}

// --- tests ---------------------------------------------------------------------------

FIXTURE_MODES: [String]{"check", "aot"}

FIXTURE_MANIFEST: "# == Foundation ==\nJetpack/Foundation/Source/Fixture.jet\n# == Engine (folders: Store) ==\nJetpack/Store/Source/Fixture.jet\n# == CLI ==\nJetpack/CLI/Source/Fixture.jet\n"

put: fn(root: String, name: String, text: String) {
    path: "{root}/{name}"
    files.create_dir_all(files.dirname(path)) ?? panic("{path}: {err}")
    files.write(path, text) ?? panic("{path}: {err}")
}

// The fixture tree: three areas and one Store test. No compiler, provider or
// runtime executes.
area_fixture: fn() -> String {
    root: normalize_join("/", files.mkdtemp("jetpack-assembly") ?? panic("a temporary directory cannot be made: {err}"))
    put(root, "Jetpack/Bootstrap/areas.list", "Foundation:\nEngine: Foundation\nCLI: Foundation\n")
    put(root, "Jetpack/Bootstrap/sources.list", FIXTURE_MANIFEST)
    put(root, "Jetpack/Bootstrap/tests.list", "# == Engine (folders: Store) ==\nJetpack/Store/Tests/Fixture.jet\n")
    put(root, "Jetpack/Foundation/Source/Fixture.jet", "foundation_fixture: fn() {{}}\n")
    put(root, "Jetpack/Store/Source/Fixture.jet", "store_fixture: fn() {{}}\n")
    put(root, "Jetpack/CLI/Source/Fixture.jet", "cli_fixture: fn() {{}}\n")
    put(root, "Jetpack/Store/Tests/Fixture.jet", "#Test(\"store fixture\") {{\n    assert(true)\n}}\n")
    root
}

fixture_config: fn(root: String, mode: String, own: String?, test_sections: [String]?) -> Config {
    Config{mode: mode, root: root, areas: None, own: own, test_sections: test_sections, deps_from_head: false, scratch: "{root}/scratch/{mode}"}
}

map_field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy() // copy: the tree is borrowed
        }
    }
    Dyn.Null
}

// The texts of the array `key` of `tree`, or each element's `path` text.
map_texts: fn(tree: Dyn, key: String) -> [String] {
    out := [String]{}
    if map_field(tree, key) == .Array(items) {
        loop item in items {
            if item == .Text(text) -> out.push(text.copy()) // copy: the tree is dropped
            if map_field(item, "path") == .Text(text) -> out.push(text.copy()) // copy: the tree is dropped
        }
    }
    out
}

read_map: fn(root: String, mode: String) -> Dyn {
    text: files.read("{root}/scratch/{mode}/jetpack.map.json") ?? panic("the map: {err}")
    json.parse(text) ?? panic("the map is not JSON: {err}")
}

#Test("check and aot units hold every source and the proved area's claims") {
    root: area_fixture()
    loop mode in FIXTURE_MODES {
        done: assemble(fixture_config(root, mode, Val("Engine"), None), [String]{}) ?? panic(err.message)
        assert_eq(done.claims, 1)
        map: read_map(root, mode)
        if map_field(map, "mode") == .Text(found) -> assert_eq(found, mode) else -> panic("the map names no mode")
        assert_eq(map_texts(map, "files").join(","), "Jetpack/Foundation/Source/Fixture.jet,Jetpack/Store/Source/Fixture.jet,Jetpack/CLI/Source/Fixture.jet,Jetpack/Store/Tests/Fixture.jet")
        assert_eq(map_texts(map, "tests").join(","), "store fixture")
        assert_eq(map_texts(map, "test_areas").join(","), "Engine")
        source: files.read("{root}/scratch/{mode}/project/src/jetpack.jet") ?? panic("{err}")
        assert(source.contains("cli_fixture"))
        assert(source.contains("#Test(\"store fixture\")"))
        assert(!source.contains("run: fn()"))
    }
    _ := assemble(fixture_config(root, "aot", Val("Engine"), Val([String]{"Engine"})), [String]{}) ?? panic(err.message)
    assert_eq(map_texts(read_map(root, "aot"), "test_areas").join(","), "Engine")
    if assemble(fixture_config(root, "aot", None, Val([String]{"CLI"})), [String]{}) == {
        .Err(error) -> assert(error.message.contains("JETPACK_BOOTSTRAP_TEST_AREAS names CLI"))
        .Ok(_) -> assert(false)
    }
    files.remove_all(root) ?? ()
}

#Test("a source outside Jetpack/ and Compiler/ or in another area's section is refused") {
    root: area_fixture()
    put(root, "Tools/packaging/other.jet", "other: fn() {{}}\n")
    store: "Jetpack/Store/Source/Fixture.jet"
    cli: "Jetpack/CLI/Source/Fixture.jet"
    manifests: [String]{
        FIXTURE_MANIFEST.replace("{store}\n", "{store}\nTools/packaging/other.jet\n"),
        FIXTURE_MANIFEST.replace("{store}\n# == CLI ==\n", "{store}\n{cli}\n# == CLI ==\n"),
    }
    refusals := [String]{}
    loop manifest in manifests {
        put(root, "Jetpack/Bootstrap/sources.list", manifest)
        if assemble(fixture_config(root, "check", None, None), [String]{}) == .Err(error) -> refusals.push(error.message.copy()) // copy: the error is dropped
    }
    assert_eq(refusals.join("\n"), "Jetpack/Bootstrap/sources.list:5: sources must live under Jetpack/ or Compiler/\nJetpack/Bootstrap/sources.list:5: {cli} belongs under the `# == CLI ==` section")
    files.remove_all(root) ?? ()
}

#Test("an unlisted Jetpack file is refused unless it is in a dependency of the proved area") {
    root: area_fixture()
    put(root, "Jetpack/Foundation/Source/Extra.jet", "extra: fn() {{}}\n")
    if assemble(fixture_config(root, "check", None, None), [String]{}) == {
        .Err(error) -> assert_eq(error.message, "Jetpack sources are not listed in Jetpack/Bootstrap/sources.list or tests.list; add them in explicit order:\n  Jetpack/Foundation/Source/Extra.jet")
        .Ok(_) -> assert(false)
    }
    done: assemble(fixture_config(root, "check", Val("Engine"), None), [String]{}) ?? panic(err.message)
    assert_eq(done.skipped, 1)
    files.remove_all(root) ?? ()
}

#Test("the area graph answers closures and populated areas") {
    root: area_fixture()
    graph: area_graph(root) ?? panic(err.message)
    assert_eq((graph.closure("CLI") ?? panic(err.message)).join(","), "Foundation,CLI")
    assert_eq(areas_command(root, [String]{"populated"}) ?? panic(err.message), "Foundation\nEngine\nCLI")
    assert_eq(areas_command(root, [String]{"sources", "Engine"}) ?? panic(err.message), "Jetpack/Foundation/Source/Fixture.jet\nJetpack/Store/Source/Fixture.jet")
    assert(graph.closure("Nope") == .Err(_))
    files.remove_all(root) ?? ()
}

#Test("section headers name the area and its folders") {
    assert(section_header("# == Engine (folders: Store, Provider) ==") == .Val(Header{name: "Engine", detail: "folders: Store, Provider"}))
    assert(section_header("# == Compiler hash (referenced from Compiler/, never copied) ==") == .Val(Header{name: "Compiler hash", detail: "referenced from Compiler/, never copied"}))
    assert(section_header("#==CLI==") == .Val(Header{name: "CLI", detail: ""}))
    assert(section_header("# == CLI") == None)
    assert(section_header("# == A = B ==") == None)
    assert_eq(claim_name("#Test(\"plain name\") {{") ?? "", "plain name")
    assert(claim_name("#Test(\"a {{x}}\") {{") == None)
    assert(claim_name("    #Test(\"nested\") {{") == None)
}

#Test("embeds are rebased onto staged copies inside the project") {
    root: "/repo"
    embeds := Embeds{copies: [String]{}, targets: [String: String]{}}
    text: rebase_embeds(root, "a: embed_file(\"data/x.txt\")\nb: embed_file(\"../y.bin\")\n", "Jetpack/Env/Source/A.jet", "sources.list:1", embeds) ?? panic(err.message)
    assert_eq(text, "a: embed_file(\"embedded/Jetpack/Env/Source/data/x.txt.embed\")\nb: embed_file(\"embedded/Jetpack/Env/y.bin.embed\")\n")
    assert_eq(embeds.copies.join(","), "embedded/Jetpack/Env/Source/data/x.txt.embed,embedded/Jetpack/Env/y.bin.embed")
    assert(rebase_embeds(root, "embed_file(\"../../../../x\")", "Jetpack/Env/Source/A.jet", "sources.list:1", embeds) == .Err(_))
}

compiler_fixture: fn(items: String) -> String {
    root: normalize_join("/", files.mkdtemp("jetpack-compiler-slice") ?? panic("a temporary directory cannot be made: {err}"))
    fixture: [String]{
        "Compiler/JetCli/package.jet", "name: \"jet-cli\"\n",
        // Prelude source held in a raw string: its `Err: struct` declares nothing.
        "Compiler/JetSema/Source/Derives.jet", "PRELUDE_SOURCE: comptime {{ ```// The default error.\nErr: struct {{\n    message: String\n}}\n``` }}\n",
        "Compiler/JetWasm/Source/Module.jet", "Export: struct {{\n    name: String\n}}\nwasm_size: fn() -> Int {{\n    0\n}}\n",
        "Jetpack/Bootstrap/sources.list", "# == Compiler front end ==\nCompiler/JetFront/Source/Items.jet\n",
        "Jetpack/Bootstrap/tests.list", "",
    }
    loop at in 0..<(fixture.len() /% 2) -> put(root, fixture[2 * at], fixture[2 * at + 1])
    put(root, "Compiler/JetFront/Source/Items.jet", items)
    root
}

#Test("a raw string's text and an enum's own variants name no dependency") {
    root: compiler_fixture("Marker: enum {{\n    Plain\n    Export, Named(String)\n}}\nfront_marker: fn() -> Marker {{ Marker.Export }}\nfront_error: fn(message: String) -> Err {{ Err{{message: message}} }}\nNOTE: `calls wasm_size() with \"quotes\" and // slashes`\n")
    // The fixture's members as Tools/agent/CompilerPackages.jet sources lists them.
    members: [String]{"Compiler/JetFront/Source/Items.jet", "Compiler/JetSema/Source/Derives.jet", "Compiler/JetWasm/Source/Module.jet"}
    assert_eq(slice_drift(root, members).join("\n"), "")
    files.remove_all(root) ?? ()
}

#Test("a call past the slice is still drift") {
    root: compiler_fixture("front_size: fn() -> Int {{\n    wasm_size()\n}}\n")
    members: [String]{"Compiler/JetFront/Source/Items.jet", "Compiler/JetSema/Source/Derives.jet", "Compiler/JetWasm/Source/Module.jet"}
    assert_eq(slice_drift(root, members).join("\n"), "Compiler/JetFront/Source/Items.jet uses wasm_size, which only Compiler/JetWasm/Source/Module.jet declares, outside the compiler slice")
    files.remove_all(root) ?? ()
}

#Test("an unlisted slice member that alone declares a used name must be listed") {
    root: compiler_fixture("front_size: fn() -> Int {{\n    front_helper()\n}}\n")
    put(root, "Compiler/JetFront/Source/Helper.jet", "front_helper: fn() -> Int {{\n    0\n}}\n")
    members: [String]{"Compiler/JetFront/Source/Items.jet", "Compiler/JetFront/Source/Helper.jet", "Compiler/JetWasm/Source/Module.jet"}
    assert_eq(slice_drift(root, members).join("\n"), "Compiler/JetFront/Source/Helper.jet must be listed: front_helper (used by Compiler/JetFront/Source/Items.jet)")
    files.remove_all(root) ?? ()
}

#Test("package imports and repeated Core imports blank in place") {
    seen_imports := [String: Bool]{}
    seen_members := [String: Bool]{}
    first: blank_repeated_imports(blank_repeated_members(blank_package_imports(unblock_uses("use files: core.files\nuse core.text.[Text, Rune]\n"), PACKAGE_NAMES), seen_members), seen_imports)
    second: blank_repeated_imports(blank_repeated_members(blank_package_imports(unblock_uses("use jet_foundation.[found]\nuse jetpack_nix_eval.Row  \nuse {{\n    core.text.[Rune, Glyph]\n    files: core.files\n}}\n"), PACKAGE_NAMES), seen_members), seen_imports)
    assert_eq(first, "use files: core.files\nuse core.text.[Text, Rune]\n")
    assert_eq(second, "                          \n                          \n     \nuse core.text.[      Glyph]\n                     \n \n")
}
