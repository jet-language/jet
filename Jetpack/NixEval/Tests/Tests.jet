// The original seam tests use the canonical evaluator and JSON arena directly.
fn test_object(json: NixEvalJSON, node: Int) -> [String: Int] Never! {
    json.object(node) ?? panic("fixture object")
}
fn test_array(json: NixEvalJSON, node: Int) -> [Int] Never! {
    json.array(node) ?? panic("fixture array")
}
fn test_field(fields: [String: Int], name: String) -> Int Never! {
    fields.get(name) ?? panic("missing fixture field `{name}`")
}
fn test_text(json: NixEvalJSON, fields: [String: Int], name: String) -> String Never! {
    json.string(test_field(fields, name)) ?? panic("fixture string `{name}`")
}
fn test_number(json: NixEvalJSON, node: Int) -> Int Never! {
    number :: json.number(node) ?? panic("fixture number")
    number.integer() ?? panic("fixture integer")
}
fn test_devshell_error(source: String, system: String) -> NixEvalError Never! {
    if nixeval_evaluate_devshell(source, system) == {
        .Ok(_) -> panic("devShell must fail closed")
        .Err(error) -> error
    }
}
fn test_derivation_error(source: String, system: String) -> NixEvalError Never! {
    if nixeval_evaluate_derivation(source, system) == {
        .Ok(_) -> panic("derivation must fail closed")
        .Err(error) -> error
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:19
#Test("partial_stage_authority_is_minted_inside_seam_tests") {
    harness :: NixEvalInternalHarness{}
    loop stage in [NixEvalInternalStage]{.Syntax, .Values, .Evaluation, .Authority, .Derivation, .Flakes} {
        assert_eq(harness.authorize(stage).stage, stage)
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:56
#Test("embedded_pin_is_exact_and_missing_build_identity_blocks") {
    manifest :: NixEvalOracleManifest.embedded() ?? panic("embedded manifest must validate")
    assert_eq(manifest.nix_version, NIXEVAL_NIX_VERSION)
    assert_eq(manifest.nix_tag_object, NIXEVAL_NIX_TAG_OBJECT)
    assert_eq(manifest.nix_source_commit, NIXEVAL_NIX_SOURCE_COMMIT)
    assert_eq(manifest.nixpkgs_revision, NIXEVAL_NIXPKGS_REVISION)
    assert_eq(manifest.nixpkgs_last_modified, NIXEVAL_NIXPKGS_LAST_MODIFIED)
    assert_eq(manifest.nixpkgs_nar_hash, NIXEVAL_NIXPKGS_NAR_HASH)
    assert_eq(manifest.systems(), nixeval_required_systems())
    assert(manifest.product_ready())
    loop system in nixeval_required_systems() {
        observed :: NixEvalOracleIdentity.new(system, NIXEVAL_NIXPKGS_NAR_HASH, ZERO_SRI) ?? panic("canonical identity")
        assert(if manifest.verify_oracle(observed) == {
            .Err(.OracleIdentityMismatch(_, _, _, _)) -> true
            else -> false
        })
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:77
#Test("exact_ready_identity_verifies") {
    manifest :: ready_manifest()
    verified :: manifest.verify_oracle(identity(X86_64_LINUX_BUILD, X86_64_LINUX_EXECUTABLE)) ?? panic("exact ready identity must verify")
    assert_eq(verified.system, "x86_64-linux")
    assert(manifest.product_ready())
}

// Rust: crates/jet-nix-eval/src/tests.rs:87
#Test("build_and_executable_mismatches_fail_closed") {
    manifest :: ready_manifest()
    assert(if manifest.verify_oracle(identity(ZERO_SRI, ZERO_SRI)) == {
        .Err(.OracleIdentityMismatch(_, field, _, _)) -> field == "build_nar_hash"
        else -> false
    })
    assert(if manifest.verify_oracle(identity(X86_64_LINUX_BUILD, NIXEVAL_NIXPKGS_NAR_HASH)) == {
        .Err(.OracleIdentityMismatch(_, field, _, _)) -> field == "executable_nar_hash"
        else -> false
    })
}

// Rust: crates/jet-nix-eval/src/tests.rs:106
#Test("matching_identity_remains_blocked_when_build_status_is_blocked") {
    manifest :: NixEvalOracleManifest.parse_and_validate(manifest_with_identities("blocked", "bit_exact")) ?? panic("blocked manifest with identities must validate")
    assert(if manifest.verify_oracle(identity(X86_64_LINUX_BUILD, X86_64_LINUX_EXECUTABLE)) == {
        .Err(.OracleBuildBlocked(_, _)) -> true
        else -> false
    })
}

// Rust: crates/jet-nix-eval/src/tests.rs:119
#Test("every_fixed_pin_field_is_validated") {
    mutations :: [(String, String)]{
        (NIXEVAL_NIX_VERSION, "2.34.7"),
        (NIXEVAL_NIX_TAG_OBJECT, "a6769c588f60b3e762f73d3a8cf60294df078ccd"),
        (NIXEVAL_NIX_SOURCE_COMMIT, "a3f1c3c5b8ad91850e0f7c590cf177f7ab022024"),
        (NIXEVAL_NIXPKGS_REVISION, "a5aa0fbd538984f6e3d201be0005b4463d8b09f8"),
        ("1782723713", "1782723712"), (NIXEVAL_NIXPKGS_NAR_HASH, ZERO_SRI)
    }
    loop (exact_pin, mutation) in mutations {
        changed :: NIXEVAL_ORACLE_JSON.replacen(exact_pin, mutation, 1)
        assert_ne(changed, NIXEVAL_ORACLE_JSON)
        assert(NixEvalOracleManifest.parse_and_validate(changed).is_err())
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:139
#Test("duplicate_keys_are_rejected_at_every_depth") {
    root_duplicate :: NIXEVAL_ORACLE_JSON.replacen("\"schema\": 1,", "\"schema\": 1, \"schema\": 1,", 1)
    assert(if NixEvalOracleManifest.parse_and_validate(root_duplicate) == {
        .Err(.Manifest(reason)) -> reason.contains("duplicate object key `schema`")
        else -> false
    })
    build_duplicate :: NIXEVAL_ORACLE_JSON.replacen("\"status\": \"ready\"", "\"status\": \"ready\", \"status\": \"blocked\"", 1)
    assert(if NixEvalOracleManifest.parse_and_validate(build_duplicate) == {
        .Err(.Manifest(reason)) -> reason.contains("duplicate object key `status`")
        else -> false
    })
}

// Rust: crates/jet-nix-eval/src/tests.rs:158
#Test("malformed_or_noncanonical_sha256_sri_is_rejected") {
    loop malformed in [String]{"sha256-build", "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==", "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/=", "sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="} {
        assert(if NixEvalOracleIdentity.new("x86_64-linux", malformed, ZERO_SRI) == {
            .Err(.MalformedSRI(field)) -> field == "build_nar_hash"
            else -> false
        })
        changed :: NIXEVAL_ORACLE_JSON.replacen("\"build_nar_hash\": \"sha256-CM7sAhHMOi6XW7Ly1Z3ASuPzMWyz828sLRpLyt7r47Y=\"", "\"build_nar_hash\": \"{malformed}\"", 1)
        assert(NixEvalOracleManifest.parse_and_validate(changed).is_err())
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:182
