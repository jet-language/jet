// Rust: crates/jet-nix-eval/src/tests.rs:192
#Test("native_devshell_projects_literal_packages_and_loss_facts") {
    evaluated :: nixeval_evaluate_devshell(``{
        outputs = { devShells.x86_64-linux.default = pkgs.mkShell {
            packages = [ pkgs.ripgrep pkgs.fd ];
            buildInputs = with pkgs; [ nodejs ];
            shellHook = "export FOO=1";
        }; };
    }``, "x86_64-linux") ?? panic("literal devShell must evaluate")
    assert_eq(evaluated.system, "x86_64-linux")
    assert_eq(evaluated.packages, [String]{"fd", "nodejs", "ripgrep"})
    assert_eq(evaluated.unsupported, [String]{"shellHook"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:219
#Test("native_devshell_rejects_dynamic_package_expressions") {
    error :: test_devshell_error("{ devShells.x86_64-linux.default = pkgs.mkShell { packages = pkgs.lib.optionals true [ pkgs.fd ]; }; }", "x86_64-linux")
    assert(if error == { .Unsupported(reason) -> reason.contains("literal package list") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:231
#Test("native_devshell_keeps_unused_thunks_lazy_and_reports_forced_cycles") {
    evaluated :: nixeval_evaluate_devshell("let unused = unused; in { devShells.x86_64-linux.default = pkgs.mkShell { packages = [ pkgs.fd ]; }; }", "x86_64-linux") ?? panic("unused recursive thunks must remain lazy")
    assert_eq(evaluated.packages, [String]{"fd"})
    error :: test_devshell_error("let cycle = cycle; in { devShells.x86_64-linux.default = pkgs.mkShell { packages = [ cycle ]; }; }", "x86_64-linux")
    assert(if error == { .Invalid(reason) -> reason.contains("cyclic foreign flake evaluation") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:250
#Test("native_devshell_bounds_lazy_thunk_chains") {
    source := "let "
    loop index in 0..300 { source += "v{index} = v{index + 1}; " }
    source += "v300 = pkgs.fd; in { devShells.x86_64-linux.default = pkgs.mkShell { packages = [ v0 ]; }; }"
    error :: test_devshell_error(source, "x86_64-linux")
    assert(if error == { .ResourceLimit(reason) -> reason.contains("expression steps") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:266
#Test("native_evaluator_rejects_deeply_nested_syntax_before_stack_overflow") {
    opening :: "(".repeat(NIXEVAL_EXPRESSION_LIMIT * 2)
    closing :: ")".repeat(NIXEVAL_EXPRESSION_LIMIT * 2)
    error :: test_devshell_error("{opening}true{closing}", "x86_64-linux")
    assert(if error == { .ResourceLimit(reason) -> reason.contains("parser") && reason.contains("nested expressions") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:281
#Test("native_evaluator_applies_memory_budget_before_parser_growth") {
    padding :: " ".repeat(800000)
    tokens :: "a ".repeat(NIXEVAL_TOKEN_LIMIT)
    error :: test_devshell_error("{padding}{tokens}", "x86_64-linux")
    assert(if error == { .ResourceLimit(reason) -> reason.contains("memory budget") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:297
#Test("native_evaluator_applies_json_depth_budget_before_recursive_conversion") {
    nesting :: NIXEVAL_EXPRESSION_LIMIT + 1
    opening :: "[".repeat(nesting)
    closing :: "]".repeat(nesting)
    json :: "{opening}true{closing}"
    source :: "{{ devShells.x86_64-linux.default = pkgs.mkShell {{ packages = builtins.fromJSON \"{json}\"; }}; }}"
    error :: test_devshell_error(source, "x86_64-linux")
    assert(if error == { .ResourceLimit(reason) -> reason.contains("JSON value is too deeply nested") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:313
#Test("native_devshell_releases_lazy_scopes_after_each_evaluation") {
    source :: "let make = packages: pkgs.mkShell { packages = packages; }; in { outputs = { devShells.x86_64-linux.default = make [ pkgs.fd ]; }; }"
    loop _ in 0..256 {
        evaluated :: nixeval_evaluate_devshell(source, "x86_64-linux") ?? panic("repeated bounded evaluations must remain valid")
