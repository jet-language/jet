}

// Rust: crates/jet-nix-eval/src/tests.rs:377
#Test("native_devshell_rejects_path_and_import_without_authority") {
    path_error :: test_devshell_error("{ devShells.x86_64-linux.default = pkgs.mkShell { packages = [ /tmp/package ]; }; }", "x86_64-linux")
    assert(if path_error == { .Unsupported(reason) -> reason.contains("absolute paths") else -> false })
    import_error :: test_devshell_error("{ devShells.x86_64-linux.default = import ./shell.nix; }", "x86_64-linux")
    assert(if import_error == { .Unsupported(reason) -> reason.contains("explicit project-root authority") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:398
#Test("native_devshell_imports_bounded_relative_sources") {
    files :: [String: String]{
        "sub/shell.nix": ``{ pkgs }: pkgs.mkShell { packages = [ "${pkgs.fd}" ]; buildInputs = import ../inputs.nix pkgs; }``,
        "inputs.nix": "pkgs: [ (builtins.toString pkgs.ripgrep) ]"
    }
    authority :: NixEvalAuthority{answer: fn(path: String) -> String NixEvalError! {
        files.get(path) ?? return Err(NixEvalError.Denied("missing test import `{path}`"))
    }}
    evaluated :: nixeval_evaluate_devshell_with_import_authority("{ outputs = { devShells.x86_64-linux.default = (import ./sub/shell.nix) { pkgs = pkgs; }; }; }", "x86_64-linux", Val(^authority)) ?? panic("authorized relative imports must evaluate")
    assert_eq(evaluated.packages, [String]{"fd", "ripgrep"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:427
#Test("native_devshell_does_not_coerce_path_contexts_into_packages") {
    authority :: NixEvalAuthority{answer: fn(_: String) -> String NixEvalError! { "pkgs.fd" }}
    error :: if nixeval_evaluate_devshell_with_import_authority(``{ devShells.x86_64-linux.default = pkgs.mkShell { packages = [ "${./package}" ]; }; }``, "x86_64-linux", Val(^authority)) == {
        .Ok(_) -> panic("path string contexts must not become package names")
        .Err(error) -> error
    }
    assert(if error == { .Unsupported(reason) -> reason.contains("path string contexts") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:441
#Test("native_devshell_import_authority_rejects_escape_and_cycles") {
    escape_authority :: NixEvalAuthority{answer: fn(path: String) -> String NixEvalError! { "{path}: not used" }}
    escape :: if nixeval_evaluate_devshell_with_import_authority("{ devShells.x86_64-linux.default = import ../outside.nix; }", "x86_64-linux", Val(^escape_authority)) == {
        .Ok(_) -> panic("parent imports must not escape the project root")
        .Err(error) -> error
    }
    assert(if escape == { .Unsupported(reason) -> reason.contains("escapes") else -> false })
    cycle_authority :: NixEvalAuthority{answer: fn(path: String) -> String NixEvalError! {
        if path == "a.nix" -> "import ./a.nix" else -> "pkgs.fd"
    }}
    cycle :: if nixeval_evaluate_devshell_with_import_authority("{ devShells.x86_64-linux.default = import ./a.nix; }", "x86_64-linux", Val(^cycle_authority)) == {
        .Ok(_) -> panic("cyclic imports must fail closed")
        .Err(error) -> error
    }
    assert(if cycle == { .Invalid(reason) -> reason.contains("cyclic") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:467
#Test("stage_a_authority_fixture_matches_native_projection") {
    fixture :: NixEvalJSON.parse(STAGE_A_AUTHORITY_FIXTURE) ?? panic("authority fixture must parse")
    root :: test_object(fixture, fixture.root)
    loop value_node in test_array(fixture, test_field(root, "values")) {
        value :: test_object(fixture, value_node)
        source :: test_text(fixture, value, "source")
        system :: test_text(fixture, value, "system")
        files :: test_object(fixture, test_field(value, "files"))
        imports := [String: String]{}
        loop path in nixeval_sorted(files.keys().to_list()) {
            &imports.insert(path, fixture.string(test_field(files, path)) ?? panic("fixture import source"))
        }
        authority :: NixEvalAuthority{answer: fn(path: String) -> String NixEvalError! {
            imports.get(path) ?? return Err(NixEvalError.Denied("fixture has no `{path}`"))
        }}
        evaluated :: nixeval_evaluate_devshell_with_import_authority(source, system, Val(^authority)) ?? panic("authority fixture source must evaluate")
        assert_eq(evaluated.packages, fixture_strings(fixture, test_field(value, "jet_packages")))
        assert_eq(evaluated.unsupported, fixture_strings(fixture, test_field(value, "jet_unsupported")))
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:504
#Test("stage_a_differential_fixture_matches_native_projection") {
    fixture :: NixEvalJSON.parse(STAGE_A_FIXTURE) ?? panic("Stage A fixture must parse")
    root :: test_object(fixture, fixture.root)
    values :: test_array(fixture, test_field(root, "values"))
    loop value_node in values {
        value :: test_object(fixture, value_node)
        source :: test_text(fixture, value, "source")
        system :: test_text(fixture, value, "system")
        output :: if value.get("output") == {
            .Val(node) -> fixture.string(node) ?? "default"
            else -> "default"
        }
        evaluated :: nixeval_evaluate_devshell_output(source, system, output) ?? panic("pinned Stage A devShell value must evaluate")
        assert_eq(evaluated.packages, fixture_strings(fixture, test_field(value, "jet_packages")))
        assert_eq(evaluated.unsupported, fixture_strings(fixture, test_field(value, "jet_unsupported")))
    }
    value_case :: test_object(fixture, values[0])
    nix_value :: test_object(fixture, test_field(value_case, "nix_value"))
    assert_eq(fixture_strings(fixture, test_field(nix_value, "packages")), [String]{"ripgrep", "fd"})
    assert_eq(fixture_strings(fixture, test_field(nix_value, "buildInputs")), [String]{"nodejs"})
    errors :: test_array(fixture, test_field(root, "errors"))
    error_case :: test_object(fixture, errors[0])
    error :: test_devshell_error(test_text(fixture, error_case, "source"), "x86_64-linux")
    assert_eq(error.message(), test_text(fixture, error_case, "jet_error"))
    error_value :: test_object(fixture, test_field(error_case, "nix_value"))
    assert_eq(fixture_strings(fixture, test_field(error_value, "packages")), [String]{"fd"})
    locks :: test_array(fixture, test_field(root, "locks"))
    lock_case :: test_object(fixture, locks[0])
    lock :: test_object(fixture, test_field(lock_case, "nix_value"))
    assert_eq(test_number(fixture, test_field(lock, "version")), 7)
    nodes :: test_object(fixture, test_field(lock, "nodes"))
    nixpkgs :: test_object(fixture, test_field(nodes, "nixpkgs"))
    locked :: test_object(fixture, test_field(nixpkgs, "locked"))
    assert_eq(test_text(fixture, locked, "rev"), NIXEVAL_NIXPKGS_REVISION)
    assert_eq(test_text(fixture, locked, "narHash"), NIXEVAL_NIXPKGS_NAR_HASH)
    identities :: test_object(fixture, test_field(root, "output_identities"))
    manifest :: NixEvalOracleManifest.embedded() ?? panic("embedded manifest")
    loop system in nixeval_required_systems() {
        fixture_identity :: test_object(fixture, test_field(identities, system))
        manifest_identity :: manifest.builds.get(system) ?? panic("required manifest system")
        assert_eq(test_text(fixture, fixture_identity, "build_nar_hash"), manifest_identity.build_nar_hash ?? panic("build hash"))
        assert_eq(test_text(fixture, fixture_identity, "executable_nar_hash"), manifest_identity.executable_nar_hash ?? panic("executable hash"))
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:665
#Test("breadth_fixture_matches_native_projection_for_every_seed") {
    fixture :: NixEvalJSON.parse(BREADTH_FIXTURE) ?? panic("breadth fixture must parse")
    root :: test_object(fixture, fixture.root)
    seeds := [Int]{}
    loop seed in test_array(fixture, test_field(root, "fuzz_seeds")) { &seeds.push(test_number(fixture, seed)) }
    loop node in test_array(fixture, test_field(root, "values")) {
        value :: test_object(fixture, node)
        source :: test_text(fixture, value, "source")
        system :: test_text(fixture, value, "system")
        packages :: fixture_strings(fixture, test_field(value, "jet_packages"))
        unsupported :: fixture_strings(fixture, test_field(value, "jet_unsupported"))
        nix_value :: test_object(fixture, test_field(value, "nix_value"))
        assert_eq(fixture_strings(fixture, test_field(nix_value, "packages")), packages)
        output :: if value.get("output") == { .Val(node) -> fixture.string(node) ?? "default" else -> "default" }
        loop seed in seeds {
            evaluated :: nixeval_evaluate_devshell_output(breadth_variant(source, seed), system, output) ?? panic("seeded breadth value must evaluate")
            assert_eq(evaluated.packages, packages)
            assert_eq(evaluated.unsupported, unsupported)
        }
    }
    loop node in test_array(fixture, test_field(root, "errors")) {
        error_case :: test_object(fixture, node)
        source :: test_text(fixture, error_case, "source")
        system :: test_text(fixture, error_case, "system")
        expected :: test_text(fixture, error_case, "jet_error")
        loop seed in seeds {
            error :: test_devshell_error(breadth_variant(source, seed), system)
            assert_eq(error.message(), expected)
        }
    }
    budgets :: test_object(fixture, test_field(root, "budgets"))
    budget :: nixeval_budget()
    assert_eq(test_number(fixture, test_field(budgets, "input_bytes")), budget.input_bytes)
    assert_eq(test_number(fixture, test_field(budgets, "tokens")), budget.tokens)
    assert_eq(test_number(fixture, test_field(budgets, "expression_steps")), budget.expression_steps)
    assert_eq(test_number(fixture, test_field(budgets, "imports")), budget.imports)
    assert_eq(test_number(fixture, test_field(budgets, "string_bytes")), budget.string_bytes)
    assert_eq(test_number(fixture, test_field(budgets, "memory_bytes")), NIXEVAL_MEMORY_BYTES)
    assert_eq(test_number(fixture, test_field(budgets, "latency_micros")), NIXEVAL_LATENCY_MICROS)
    // Latency is a declared budget, not a loaded-machine wall-clock test.
    // Deterministic cost is pinned above; measured latency belongs in benchmarks.
}

// Rust: crates/jet-nix-eval/src/tests.rs:758
#Test("breadth_fixture_pins_lock_and_output_identity_corpus") {
    breadth :: NixEvalJSON.parse(BREADTH_FIXTURE) ?? panic("breadth fixture must parse")
    root :: test_object(breadth, breadth.root)
    stage_a :: NixEvalJSON.parse(STAGE_A_FIXTURE) ?? panic("Stage A fixture must parse")
    stage_root :: test_object(stage_a, stage_a.root)
    assert(breadth.same(test_field(root, "locks"), stage_a, test_field(stage_root, "locks")))
    assert(breadth.same(test_field(root, "output_identities"), stage_a, test_field(stage_root, "output_identities")))
    identities :: test_object(breadth, test_field(root, "output_identities"))
    manifest :: NixEvalOracleManifest.embedded() ?? panic("embedded oracle manifest")
    loop system in nixeval_sorted(identities.keys().to_list()) {
        fields :: test_object(breadth, test_field(identities, system))
        observed :: NixEvalOracleIdentity.new(system, test_text(breadth, fields, "build_nar_hash"), test_text(breadth, fields, "executable_nar_hash")) ?? panic("fixture output identity must use canonical SRI")
        _ :: manifest.verify_oracle(observed) ?? panic("fixture output identity must match pinned oracle")
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:808
#Test("native_devshell_rejects_unknown_systems_and_empty_flakes") {
    assert(if nixeval_evaluate_devshell("{ }", "x86_64-windows") == { .Err(.UnsupportedSystem(_)) -> true else -> false })
    assert(if nixeval_evaluate_devshell("{ }", "x86_64-linux") == { .Err(.Unsupported(reason)) -> reason.contains("devShell") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:820
#Test("pinned_inventory_has_no_implicit_skip_reason") {
    inventory :: nixeval_pinned_inventory()
    // The committed inventory remains the independent expected corpus.
    manifest :: NixEvalJSON.parse(prep { embed_file("../../../tests/fixtures/nix-compat/pinned-inventory.json") }) ?? panic("inventory manifest JSON")
    object :: test_object(manifest, manifest.root)
    assert_eq(test_number(manifest, test_field(object, "schema")), 1)
    assert_eq(test_text(manifest, object, "nix_version"), NIXEVAL_NIX_VERSION)
    assert_eq(test_text(manifest, object, "nixpkgs_revision"), NIXEVAL_NIXPKGS_REVISION)
    assert_eq(fixture_strings(manifest, test_field(object, "systems")), nixeval_required_systems())
    entries :: test_array(manifest, test_field(object, "entries"))
    assert_eq(entries.len(), 17)
    assert_eq(inventory.len(), entries.len())
    counts :: test_object(manifest, test_field(object, "expected_counts"))
    assert_eq(test_number(manifest, test_field(counts, "evaluable")), 10)
    assert_eq(test_number(manifest, test_field(counts, "buildable")), 5)
    assert_eq(test_number(manifest, test_field(counts, "skipped")), 2)
    covered := 0
    skipped := 0
    has_devshells := false
    loop index in 0..inventory.len() {
        entry :: inventory[index]
        if entry.status == NixEvalInventoryStatus.Covered -> covered += 1 else -> skipped += 1
        if entry.surface == "devshells" && entry.status == NixEvalInventoryStatus.Covered -> has_devshells = true
        fields :: test_object(manifest, entries[index])
        assert_eq(test_text(manifest, fields, "surface"), entry.surface)
        assert_eq(test_text(manifest, fields, "status"), entry.status.label())
        assert_eq(test_text(manifest, fields, "class"), entry.class.label())
        reason := entry.reason.trim() // #4303
        assert(!reason.is_empty())
        assert_eq(test_text(manifest, fields, "reason"), entry.reason)
    }
    assert_eq(covered, 15)
    assert_eq(skipped, 2)
    assert(has_devshells)
    budget :: nixeval_budget()
    assert_eq(budget.input_bytes, 1 << 20)
    assert_eq(budget.tokens, 65536)
    assert_eq(budget.expression_steps, 256)
    assert_eq(budget.imports, 64)
    assert_eq(budget.string_bytes, 1 << 20)
    assert(budget.expression_steps < budget.tokens)
    assert(budget.imports < budget.expression_steps)
}

// Rust: crates/jet-nix-eval/src/tests.rs:909
#Test("native_derivation_builds_a_pure_request_with_required_builtins") {
    evaluated :: nixeval_evaluate_derivation(``builtins.derivationStrict {
        name = builtins.concatStringsSep "-" [ "hello" "native" ];
        system = builtins.currentSystem;
        builder = "/bin/sh";
        args = builtins.map (value: value) [ "-c" "echo hi > $out" ];
        message = builtins.toJSON (builtins.fromJSON "{\"ok\":true,\"count\":2}");
        source = builtins.storePath "/nix/store/0123456789abcdfghijklmnpqrsvwxyz-source";
    }``, "x86_64-linux") ?? panic("required derivation builtins must evaluate")
    assert_eq(evaluated.name, "hello-native")
    assert_eq(evaluated.system, "x86_64-linux")
    assert_eq(evaluated.builder, "/bin/sh")
    assert_eq(evaluated.args, [String]{"-c", "echo hi > $out"})
    assert_eq(evaluated.env.get("message"), Val("{\"count\":2,\"ok\":true}"))
    assert_eq(evaluated.input_sources, [String]{"/nix/store/0123456789abcdfghijklmnpqrsvwxyz-source"})
    assert_eq(evaluated.outputs[0].name, "out")
    assert_eq(evaluated.outputs[0].method_algo, "")
    assert_eq(evaluated.outputs[0].hash_hex, "")
}

// Rust: crates/jet-nix-eval/src/tests.rs:945
#Test("native_derivation_keeps_lazy_fields_lazy_until_strict") {
    evaluated :: nixeval_evaluate_devshell(``
        let d = builtins.derivation {
            name = "lazy"; system = "x86_64-linux"; builder = "/bin/sh"; unused = unused;
        };
        in { devShells.x86_64-linux.default = pkgs.mkShell { packages = [ d.type ]; }; }
    ``, "x86_64-linux") ?? panic("derivation must not force unused lazy fields")
    assert_eq(evaluated.packages, [String]{"derivation"})
    error :: test_devshell_error(``
        let d = builtins.derivationStrict {
            name = "strict"; system = "x86_64-linux"; builder = "/bin/sh"; unused = unused;
        };
        in { devShells.x86_64-linux.default = pkgs.mkShell { packages = [ d.type ]; }; }
    ``, "x86_64-linux")
    assert(if error == { .Invalid(reason) -> reason.contains("missing foreign flake value `unused`") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:980
#Test("native_required_string_builtins_match_nix_edge_ordering") {
    evaluated :: nixeval_evaluate_derivation(``builtins.derivation { name = builtins.replaceStrings [ "a" "ab" ] [ "X" "Y" ] "ab"; system = "x86_64-linux"; builder = "/bin/sh"; }``, "x86_64-linux") ?? panic("replaceStrings must use Nix list order")
    assert_eq(evaluated.name, "Xb")
    substring :: nixeval_evaluate_derivation(``builtins.derivation { name = builtins.substring 1 (-1) "abc"; system = "x86_64-linux"; builder = "/bin/sh"; }``, "x86_64-linux") ?? panic("negative substring length must mean the remainder")
    assert_eq(substring.name, "bc")
    error :: test_derivation_error(``builtins.derivation { name = builtins.substring (-1) 2 "abc"; system = "x86_64-linux"; builder = "/bin/sh"; }``, "x86_64-linux")
    assert(if error == { .Invalid(reason) -> reason.contains("negative start") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:1004
#Test("native_derivation_rejects_noncanonical_inputs_and_preserves_multiple_outputs") {
    path_error :: test_derivation_error(``builtins.derivation { name = "bad"; system = "x86_64-linux"; builder = "/bin/sh"; src = "${pkgs.fd}"; }``, "x86_64-linux")
    assert(if path_error == { .Unsupported(reason) -> reason.contains("canonical store-path context") else -> false })
    evaluated :: nixeval_evaluate_derivation(``builtins.derivation { name = "many"; system = "x86_64-linux"; builder = "/bin/sh"; outputs = [ "out" "dev" ]; }``, "x86_64-linux") ?? panic("bounded evaluator must preserve non-fixed output declarations")
    names := [String]{}
    loop output in evaluated.outputs { &names.push(output.name) }
    assert_eq(names, [String]{"out", "dev"})
    assert_eq(evaluated.env.get("dev"), Val(""))
}

// Rust: crates/jet-nix-eval/src/tests.rs:1031
#Test("native_derivation_rejects_duplicate_or_invalid_outputs") {
    loop source in [String]{
        ``builtins.derivation { name = "duplicate"; system = "x86_64-linux"; builder = "/bin/sh"; outputs = [ "out" "out" ]; }``,
        ``builtins.derivation { name = "invalid"; system = "x86_64-linux"; builder = "/bin/sh"; outputs = [ "out" "bad/name" ]; }``
    } {
        error :: test_derivation_error(source, "x86_64-linux")
        assert(if error == { .Invalid(reason) -> reason.contains("output") else -> false })
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:1043
#Test("native_derivation_fixture_matches_pure_request") {
    fixture :: NixEvalJSON.parse(STAGE_A_DERIVATION_FIXTURE) ?? panic("derivation fixture must parse")
    root :: test_object(fixture, fixture.root)
    loop node in test_array(fixture, test_field(root, "values")) {
        value :: test_object(fixture, node)
        evaluated :: nixeval_evaluate_derivation(test_text(fixture, value, "source"), test_text(fixture, value, "system")) ?? panic("fixture derivation must evaluate natively")
        expected :: test_object(fixture, test_field(value, "jet_request"))
        assert_eq(evaluated.name, test_text(fixture, expected, "name"))
        assert_eq(evaluated.system, test_text(fixture, expected, "system"))
        assert_eq(evaluated.builder, test_text(fixture, expected, "builder"))
        assert_eq(evaluated.args, fixture_strings(fixture, test_field(expected, "args")))
        assert_eq(evaluated.input_sources, fixture_strings(fixture, test_field(expected, "input_sources")))
        expected_outputs :: if expected.get("outputs") == {
            .Val(outputs) -> test_array(fixture, outputs)
            else -> [Int]{test_field(expected, "output")}
        }
        assert_eq(evaluated.outputs.len(), expected_outputs.len())
        output_index := [String: Int]{}
        loop index in 0..evaluated.outputs.len() { &output_index.insert(evaluated.outputs[index].name, index) }
        loop expected_node in expected_outputs {
            expected_output :: test_object(fixture, expected_node)
            name :: test_text(fixture, expected_output, "name")
            index :: output_index.get(name) ?? panic("fixture output name")
            output :: evaluated.outputs[index]
            assert_eq(output.method_algo, test_text(fixture, expected_output, "method_algo"))
            assert_eq(output.hash_hex, test_text(fixture, expected_output, "hash_hex"))
        }
    }
}

// Rust: crates/jet-nix-eval/src/tests.rs:1113
#Test("native_devshell_treats_indented_hooks_as_unsupported_loss") {
    evaluated :: nixeval_evaluate_devshell(``{
        devShells.x86_64-linux.default = pkgs.mkShell {
            packages = [ pkgs.fd ];
            shellHook = ''
                # packages = [ pkgs.must-not-leak ];
                export FOO=1
            '';
        };
    }``, "x86_64-linux") ?? panic("indented shell hooks must not confuse package extraction")
    assert_eq(evaluated.packages, [String]{"fd"})
    assert_eq(evaluated.unsupported, [String]{"shellHook"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:1132
#Test("native_devshell_applies_bounded_package_overlays") {
    evaluated :: nixeval_evaluate_devshell(``
        let overlay = final: prev: { custom = prev.fd; };
        in {
            devShells.x86_64-linux.default =
                (import pkgs { overlays = [ overlay ]; }).mkShell {
                    packages = [ (import pkgs { overlays = [ overlay ]; }).custom ];
                };
        }
    ``, "x86_64-linux") ?? panic("bounded package overlays must project package identities")
    assert_eq(evaluated.packages, [String]{"fd"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:1150
#Test("native_devshell_overlay_final_sees_following_override_and_prev_stays_stable") {
    evaluated :: nixeval_evaluate_devshell(``
        let first = final: prev: { from_prev = prev.fd; from_final = final.future; };
        second = final: prev: { future = prev.ripgrep; second_view = final.future; };
        in {
            devShells.x86_64-linux.default =
                (import pkgs { overlays = [ first second ]; }).mkShell {
                    packages = [
                        (import pkgs { overlays = [ first second ]; }).from_prev
                        (import pkgs { overlays = [ first second ]; }).from_final
                        (import pkgs { overlays = [ first second ]; }).second_view
                    ];
                };
        }
    ``, "x86_64-linux") ?? panic("overlay final/prev projections must remain deterministic")
    assert_eq(evaluated.packages, [String]{"fd", "ripgrep"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:1179
#Test("native_devshell_merge_keeps_overlay_packages_lazy") {
    evaluated :: nixeval_evaluate_devshell(``
        let overlayPkgs = pkgs // { custom = pkgs.ripgrep; };
        in { devShells.x86_64-linux.default = overlayPkgs.mkShell { packages = [ overlayPkgs.custom ]; }; }
    ``, "x86_64-linux") ?? panic("package-set merge must preserve explicit overlay fields")
    assert_eq(evaluated.packages, [String]{"ripgrep"})
}

// Rust: crates/jet-nix-eval/src/tests.rs:1192
#Test("native_evaluator_rejects_fetchers_and_cross_system_packages_without_authority") {
    fetch_error :: test_devshell_error(``{
        devShells.x86_64-linux.default = pkgs.mkShell {
            packages = [ (builtins.fetchurl { url = "https://example.invalid/source"; }) ];
        };
    }``, "x86_64-linux")
    assert(if fetch_error == { .Unsupported(reason) -> reason.contains("explicit fetch authority") else -> false })
    cross_error :: test_devshell_error("{ devShells.x86_64-linux.default = pkgs.mkShell { packages = [ pkgs.pkgsCross.aarch64-multiplatform.foo ]; }; }", "x86_64-linux")
    assert(if cross_error == { .Unsupported(reason) -> reason.contains("explicit target") else -> false })
    external_flake_error :: test_devshell_error(``{
        devShells.x86_64-linux.default = pkgs.mkShell {
            packages = [ (builtins.getFlake "github:NixOS/nixpkgs") ];
        };
    }``, "x86_64-linux")
    assert(if external_flake_error == { .Unsupported(reason) -> reason.contains("external flakes") && reason.contains("provider authority") else -> false })
}

// Rust: crates/jet-nix-eval/src/tests.rs:1236
#Test("breadth_authority_fixture_matches_pinned_values_and_derivation_inputs") {
    fixture :: NixEvalJSON.parse(BREADTH_FIXTURE) ?? panic("breadth fixture must parse")
    root :: test_object(fixture, fixture.root)
    loop node in test_array(fixture, test_field(root, "authority_values")) {
        case :: test_object(fixture, node)
        source :: test_text(fixture, case, "source")
        system :: test_text(fixture, case, "system")
        response_fields :: test_object(fixture, test_field(case, "authority"))
        responses := [String: String]{}
        loop request in nixeval_sorted(response_fields.keys().to_list()) {
            &responses.insert(request, fixture.string(test_field(response_fields, request)) ?? panic("authority response string"))
        }
        expected_packages :: fixture_strings(fixture, test_field(case, "jet_packages"))
        expected_cross_packages :: fixture_strings(fixture, test_field(case, "jet_cross_packages"))
        expected_unsupported :: fixture_strings(fixture, test_field(case, "jet_unsupported"))
        nix_value :: test_object(fixture, test_field(case, "nix_value"))
        assert_eq(fixture_strings(fixture, test_field(nix_value, "packages")), expected_packages)
        nix_cross_packages :: if nix_value.get("cross_packages") == {
            .Val(node) -> fixture_strings(fixture, node)
            else -> [String]{}
        }
        assert_eq(nix_cross_packages, expected_cross_packages)
        loop seed_node in test_array(fixture, test_field(root, "fuzz_seeds")) {
            seed :: test_number(fixture, seed_node)
            authority :: NixEvalAuthority{answer: fn(request: String) -> String NixEvalError! {
                responses.get(request) ?? return Err(NixEvalError.Denied("unlisted authority request `{request}`"))
            }}
            evaluated :: nixeval_evaluate_devshell_with_import_authority(breadth_variant(source, seed), system, Val(^authority)) ?? panic("authorized breadth value must evaluate")
            assert_eq(evaluated.packages, expected_packages)
            assert_eq(evaluated.cross_packages, expected_cross_packages)
            assert_eq(evaluated.unsupported, expected_unsupported)
        }
    }
    loop node in test_array(fixture, test_field(root, "authority_derivations")) {
        case :: test_object(fixture, node)
        source :: test_text(fixture, case, "source")
        system :: test_text(fixture, case, "system")
        response_fields :: test_object(fixture, test_field(case, "authority"))
        responses := [String: String]{}
        loop request in nixeval_sorted(response_fields.keys().to_list()) {
            &responses.insert(request, fixture.string(test_field(response_fields, request)) ?? panic("authority response string"))
        }
        expected_inputs :: fixture_strings(fixture, test_field(case, "jet_input_sources"))
        loop seed_node in test_array(fixture, test_field(root, "fuzz_seeds")) {
            seed :: test_number(fixture, seed_node)
            authority :: NixEvalAuthority{answer: fn(request: String) -> String NixEvalError! {
                responses.get(request) ?? return Err(NixEvalError.Denied("unlisted authority request `{request}`"))
            }}
            evaluated :: nixeval_evaluate_derivation_with_import_authority(breadth_variant(source, seed), system, Val(^authority)) ?? panic("authorized fixed-output derivation must evaluate")
            assert_eq(evaluated.input_sources, expected_inputs)
        }
        nix_value :: test_object(fixture, test_field(case, "nix_value"))
        assert_eq(expected_inputs, fixture_strings(fixture, test_field(nix_value, "input_sources")))
    }
}

