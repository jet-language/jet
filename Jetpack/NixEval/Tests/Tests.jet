}

// Rust: crates/jet-nix-eval/src/tests.rs:331
#Test("native_evaluator_rejects_oversized_input_before_parsing") {
    source :: "x".repeat((1 << 20) + 1)
    assert(if nixeval_evaluate_devshell(source, "x86_64-linux") == { .Err(.InputTooLarge) -> true else -> false })
    assert(if nixeval_evaluate_derivation(source, "x86_64-linux") == { .Err(.InputTooLarge) -> true else -> false })
    assert(if nixeval_evaluate_derivation_output(source, "x86_64-linux", "out") == { .Err(.InputTooLarge) -> true else -> false })
}

