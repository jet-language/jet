// Internal staged authority. Each ordered evaluator slice is named by a stage;
// a permit for a stage is minted only through the internal test harness.

NixEvalInternalStage: enum {
    Syntax
    Values
    Evaluation
    Authority
    Derivation
    Flakes
}

NixEvalInternalHarness: struct {
    authorize: fn(self, stage: NixEvalInternalStage) -> NixEvalInternalPermit Never! {
        NixEvalInternalPermit{stage}
    }
}

NixEvalInternalPermit: struct {
    stage: NixEvalInternalStage
}
