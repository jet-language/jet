// Exact, fully validated Nix oracle authority. A raw manifest is parsed into
// a draft first; only `validate()` turns a draft into a manifest, so raw
// manifests cannot construct oracle authority.

NIXEVAL_NIX_VERSION: "2.34.8"
NIXEVAL_NIX_TAG_OBJECT: "b6769c588f60b3e762f73d3a8cf60294df078ccd"
NIXEVAL_NIX_SOURCE_COMMIT: "f3f1c3c5b8ad91850e0f7c590cf177f7ab022024"
NIXEVAL_NIXPKGS_REVISION: "b5aa0fbd538984f6e3d201be0005b4463d8b09f8"
NIXEVAL_NIXPKGS_LAST_MODIFIED: 1782723713
NIXEVAL_NIXPKGS_NAR_HASH: "sha256-oPXCU/SSUokcGaJREHibG1CBX3+s/W7orDWQOZDsEeQ="

// The committed differential oracle manifest (tests/fixtures/nix-compat/oracle.json).
NIXEVAL_ORACLE_JSON: #run { ``{
  "schema": 1,
  "nix": {
    "version": "2.34.8",
    "tag_object": "b6769c588f60b3e762f73d3a8cf60294df078ccd",
    "source_commit": "f3f1c3c5b8ad91850e0f7c590cf177f7ab022024",
    "builds": {
      "aarch64-darwin": {
        "build_nar_hash": "sha256-rMlwlpqvtf4dmQwKPvcwMuJ0Gq8v8FrvNqcPv4cyKLQ=",
        "executable_nar_hash": "sha256-OCO79DjPxsXvNMPRj2wAY+KOMT4pJdICbavTQl8Q2rE=",
        "status": "ready"
      },
      "aarch64-linux": {
        "build_nar_hash": "sha256-iaMQdHZmdYtYvkkBeu2BuCEcXJHW+VLjLYdmfS/F7Og=",
        "executable_nar_hash": "sha256-04ryjRswBDp+ymbJOeb4m9zcYHcE/6j1LR/WfOi4/Ms=",
        "status": "ready"
      },
      "x86_64-darwin": {
        "build_nar_hash": "sha256-DUQnYzmxZIMU37Aa4Zy+0XNKWpcLP5zg5YsrwsrA1Sk=",
        "executable_nar_hash": "sha256-K67J6pH92UHhlrFQUm+RofuRvo8y1KrOa/4zhkGImQU=",
        "status": "ready"
      },
      "x86_64-linux": {
        "build_nar_hash": "sha256-CM7sAhHMOi6XW7Ly1Z3ASuPzMWyz828sLRpLyt7r47Y=",
        "executable_nar_hash": "sha256-VdvAPujI/c6bKKSPQK+Q1dtICYEqzljvR19Ld+Ht3sQ=",
        "status": "ready"
      }
    }
  },
  "nixpkgs": {
    "rev": "b5aa0fbd538984f6e3d201be0005b4463d8b09f8",
    "last_modified": 1782723713,
    "nar_hash": "sha256-oPXCU/SSUokcGaJREHibG1CBX3+s/W7orDWQOZDsEeQ="
  },
  "corpus_status": "bit_exact"
}
`` }

NixEvalOracleBuildStatus: enum {
    Blocked
    Ready

    parse: fn(label: String) -> NixEvalOracleBuildStatus? Never! {
        if label == {
            "blocked" -> Val(NixEvalOracleBuildStatus.Blocked)
            "ready" -> Val(NixEvalOracleBuildStatus.Ready)
            else -> None
        }
    }

    label: fn(self) -> String Never! {
        if self == {
            .Blocked -> "blocked"
            .Ready -> "ready"
        }
    }
}

NixEvalCorpusStatus: enum {
    BlockedOnOracleBuildHashes
    BitExact

    parse: fn(label: String) -> NixEvalCorpusStatus? Never! {
        if label == {
            "blocked_on_oracle_build_hashes" -> Val(NixEvalCorpusStatus.BlockedOnOracleBuildHashes)
            "bit_exact" -> Val(NixEvalCorpusStatus.BitExact)
            else -> None
        }
    }
}

NixEvalOracleBuild: struct {
    build_nar_hash: String?
    executable_nar_hash: String?
    status: NixEvalOracleBuildStatus
}

// One oracle build as read from the manifest, before pin validation.
NixEvalOracleDraftBuild: struct {
    build_nar_hash: String?
    executable_nar_hash: String?
    status: String
}

NixEvalOracleDraft: struct {
    nix_version: String
    nix_tag_object: String
    nix_source_commit: String
    builds: [String: NixEvalOracleDraftBuild]
    nixpkgs_revision: String
    nixpkgs_last_modified: Int
    nixpkgs_nar_hash: String
    corpus_status: String

    parse: fn(text: String) -> NixEvalOracleDraft NixEvalError! {
        document: nixeval_oracle_document(text)
        root: nixeval_oracle_object(document, document.root, "root")
        nixeval_oracle_exact_keys(root, [String]{"schema", "nix", "nixpkgs", "corpus_status"}, "root")
        schema: root.get("schema") ?? return Err(nixeval_oracle_missing("root.schema"))
        number: document.number(schema) ?? return Err(NixEvalError.Manifest("`schema` must be 1"))
        if !number.is_integer(1) -> return Err(NixEvalError.Manifest("`schema` must be 1"))

        nix: nixeval_oracle_child_object(document, root, "nix")
        nixeval_oracle_exact_keys(nix, [String]{"version", "tag_object", "source_commit", "builds"}, "nix")
        builds_object: nixeval_oracle_child_object(document, nix, "builds")
        builds := [String: NixEvalOracleDraftBuild]{}
        loop system in nixeval_sorted(builds_object.keys().to_list()) {
            path: "nix.builds.{system}"
            build: nixeval_oracle_object(document, builds_object[system], path)
            nixeval_oracle_exact_keys(build, [String]{"build_nar_hash", "executable_nar_hash", "status"}, path)
            build_nar_hash: nixeval_oracle_optional_sri(document, build, "build_nar_hash")
            executable_nar_hash: nixeval_oracle_optional_sri(document, build, "executable_nar_hash")
            status: nixeval_oracle_required_string(document, build, "status")
            builds[system] = NixEvalOracleDraftBuild{build_nar_hash, executable_nar_hash, status}
        }

        nixpkgs: nixeval_oracle_child_object(document, root, "nixpkgs")
        nixeval_oracle_exact_keys(nixpkgs, [String]{"rev", "last_modified", "nar_hash"}, "nixpkgs")
        nixpkgs_nar_hash: nixeval_oracle_required_string(document, nixpkgs, "nar_hash")
        if !nixeval_is_canonical_sha256_sri(nixpkgs_nar_hash) -> return Err(NixEvalError.Manifest("`nixpkgs.nar_hash` must be canonical SHA-256 SRI"))

        nix_version: nixeval_oracle_required_string(document, nix, "version")
        nix_tag_object: nixeval_oracle_required_string(document, nix, "tag_object")
        nix_source_commit: nixeval_oracle_required_string(document, nix, "source_commit")
        nixpkgs_revision: nixeval_oracle_required_string(document, nixpkgs, "rev")
        nixpkgs_last_modified: nixeval_oracle_required_u64(document, nixpkgs, "last_modified")
        corpus_status: nixeval_oracle_required_string(document, root, "corpus_status")
        Ok(NixEvalOracleDraft{nix_version, nix_tag_object, nix_source_commit, builds, nixpkgs_revision, nixpkgs_last_modified, nixpkgs_nar_hash, corpus_status})
    }

    validate: fn(self) -> NixEvalOracleManifest NixEvalError! {
        nixeval_oracle_exact("nix.version", self.nix_version, NIXEVAL_NIX_VERSION)
        nixeval_oracle_exact("nix.tag_object", self.nix_tag_object, NIXEVAL_NIX_TAG_OBJECT)
        nixeval_oracle_exact("nix.source_commit", self.nix_source_commit, NIXEVAL_NIX_SOURCE_COMMIT)
        nixeval_oracle_exact("nixpkgs.rev", self.nixpkgs_revision, NIXEVAL_NIXPKGS_REVISION)
        if self.nixpkgs_last_modified != NIXEVAL_NIXPKGS_LAST_MODIFIED {
            return Err(NixEvalError.Manifest("`nixpkgs.last_modified` must be `{NIXEVAL_NIXPKGS_LAST_MODIFIED}`, got `{self.nixpkgs_last_modified}`"))
        }
        nixeval_oracle_exact("nixpkgs.nar_hash", self.nixpkgs_nar_hash, NIXEVAL_NIXPKGS_NAR_HASH)
        systems: nixeval_sorted(self.builds.keys().to_list())
        if systems != nixeval_required_systems() {
            return Err(NixEvalError.Manifest("oracle systems must be exactly {nixeval_debug_strings(nixeval_required_systems())}, got {nixeval_debug_strings(systems)}"))
        }
        builds := [String: NixEvalOracleBuild]{}
        loop entry in self.builds {
            status: NixEvalOracleBuildStatus.parse(entry.value.status) ?? return Err(NixEvalError.Manifest("nix.builds.{entry.key}.status must be `blocked` or `ready`"))
            builds[entry.key] = NixEvalOracleBuild{build_nar_hash: entry.value.build_nar_hash, executable_nar_hash: entry.value.executable_nar_hash, status}
        }
        corpus_status: NixEvalCorpusStatus.parse(self.corpus_status) ?? return Err(NixEvalError.Manifest("`corpus_status` must be `blocked_on_oracle_build_hashes` or `bit_exact`"))
        Ok(NixEvalOracleManifest{
            nix_version: self.nix_version,
            nix_tag_object: self.nix_tag_object,
            nix_source_commit: self.nix_source_commit,
            builds,
            nixpkgs_revision: self.nixpkgs_revision,
            nixpkgs_last_modified: self.nixpkgs_last_modified,
            nixpkgs_nar_hash: self.nixpkgs_nar_hash,
            corpus_status,
        })
    }
}

NixEvalOracleManifest: struct {
    nix_version: String
    nix_tag_object: String
    nix_source_commit: String
    priv builds: [String: NixEvalOracleBuild]
    nixpkgs_revision: String
    nixpkgs_last_modified: Int
    nixpkgs_nar_hash: String
    priv corpus_status: NixEvalCorpusStatus

    embedded: fn() -> NixEvalOracleManifest NixEvalError! {
        NixEvalOracleManifest.parse_and_validate(NIXEVAL_ORACLE_JSON)
    }

    parse_and_validate: fn(text: String) -> NixEvalOracleManifest NixEvalError! {
        draft: NixEvalOracleDraft.parse(text)
        draft.validate()
    }

    verify_oracle: fn(self, observed: NixEvalOracleIdentity) -> NixEvalVerifiedOracle NixEvalError! {
        expected: self.builds.get(observed.system) ?? return Err(NixEvalError.UnsupportedOracleSystem(observed.system))
        build_hash: expected.build_nar_hash ?? return Err(NixEvalError.MissingOracleIdentity{system: observed.system, field: "build_nar_hash"})
        executable_hash: expected.executable_nar_hash ?? return Err(NixEvalError.MissingOracleIdentity{system: observed.system, field: "executable_nar_hash"})
        nixeval_oracle_compare_identity(observed.system, "build_nar_hash", build_hash, observed.build_nar_hash)
        nixeval_oracle_compare_identity(observed.system, "executable_nar_hash", executable_hash, observed.executable_nar_hash)
        if expected.status != NixEvalOracleBuildStatus.Ready {
            return Err(NixEvalError.OracleBuildBlocked{system: observed.system, status: expected.status.label()})
        }
        Ok(NixEvalVerifiedOracle{system: observed.system})
    }

    evaluator_identity: fn(self, system: String) -> String NixEvalError! {
        if !nixeval_is_required_system(system) -> return Err(NixEvalError.UnsupportedOracleSystem(system))
        Ok("native-nix:{self.nix_version}:{self.nixpkgs_revision}:{system}")
    }

    systems: fn(self) -> [String] Never! {
        nixeval_sorted(self.builds.keys().to_list())
    }

    // The pinned oracle build for `system`, if the manifest names one.
    build: fn(self, system: String) -> NixEvalOracleBuild? Never! {
        self.builds.get(system)
    }

    product_ready: fn(self) -> Bool Never! {
        if self.corpus_status != NixEvalCorpusStatus.BitExact -> return false
        loop entry in self.builds {
            build: entry.value
            if build.status != NixEvalOracleBuildStatus.Ready || build.build_nar_hash == None || build.executable_nar_hash == None -> return false
        }
        true
    }
}

// An observed oracle build identity; both hashes are canonical SHA-256 SRI.
NixEvalOracleIdentity: struct {
    priv system: String
    priv build_nar_hash: String
    priv executable_nar_hash: String

    new: fn(system: String, build_nar_hash: String, executable_nar_hash: String) -> NixEvalOracleIdentity NixEvalError! {
        if !nixeval_is_canonical_sha256_sri(build_nar_hash) -> return Err(NixEvalError.MalformedSRI("build_nar_hash"))
        if !nixeval_is_canonical_sha256_sri(executable_nar_hash) -> return Err(NixEvalError.MalformedSRI("executable_nar_hash"))
        Ok(NixEvalOracleIdentity{system, build_nar_hash, executable_nar_hash})
    }
}

NixEvalVerifiedOracle: struct {
    system: String
}

nixeval_oracle_missing: fn(path: String) -> NixEvalError Never! {
    NixEvalError.Manifest("missing `{path}`")
}

// The manifest text as a JSON document; syntax errors are manifest errors.
nixeval_oracle_document: fn(text: String) -> NixEvalJSON NixEvalError! {
    if NixEvalJSON.parse(text) == {
        .Ok(document) -> return Ok(document)
        .Err(error) -> return Err(NixEvalError.Manifest(error.message()))
    }
}

nixeval_oracle_object: fn(document: NixEvalJSON, index: Int, path: String) -> [String: Int] NixEvalError! {
    fields: document.object(index) ?? return Err(NixEvalError.Manifest("`{path}` must be an object"))
    Ok(fields)
}

nixeval_oracle_child_object: fn(document: NixEvalJSON, parent: [String: Int], key: String) -> [String: Int] NixEvalError! {
    child: parent.get(key) ?? return Err(nixeval_oracle_missing(key))
    nixeval_oracle_object(document, child, key)
}

nixeval_oracle_required_string: fn(document: NixEvalJSON, parent: [String: Int], key: String) -> String NixEvalError! {
    child: parent.get(key) ?? return Err(nixeval_oracle_missing(key))
    text: document.string(child) ?? return Err(NixEvalError.Manifest("`{key}` must be a string"))
    Ok(text)
}

// A JSON number that is exactly a non-negative 64-bit unsigned integer; the
// reference conversion saturates 2^64 to the largest value.
nixeval_oracle_required_u64: fn(document: NixEvalJSON, parent: [String: Int], key: String) -> Int NixEvalError! {
    child: parent.get(key) ?? return Err(nixeval_oracle_missing(key))
    number: document.number(child) ?? return Err(NixEvalError.Manifest("`{key}` must be an unsigned integer"))
    value: number.integer() ?? return Err(NixEvalError.Manifest("`{key}` must be an unsigned integer"))
    limit: 18446744073709551616
    if value < 0 || value > limit -> return Err(NixEvalError.Manifest("`{key}` must be an unsigned integer"))
    if value == limit -> return Ok(limit - 1)
    Ok(value)
}

nixeval_oracle_optional_sri: fn(document: NixEvalJSON, parent: [String: Int], key: String) -> String? NixEvalError! {
    child: parent.get(key) ?? return Err(nixeval_oracle_missing(key))
    if document.node(child) == {
        .Null -> return Ok(None)
        .Str(value) -> {
            if !nixeval_is_canonical_sha256_sri(value) -> return Err(NixEvalError.Manifest("`{key}` must be canonical SHA-256 SRI"))
            return Ok(Val(value))
        }
        .Bool(_) | .Num(_) | .Array(_) | .Object(_) -> {}
    }
    Err(NixEvalError.Manifest("`{key}` must be a string or null"))
}

nixeval_oracle_exact_keys: fn(parent: [String: Int], expected: [String], path: String) NixEvalError! {
    actual: nixeval_sorted(parent.keys().to_list())
    wanted := expected.copy()
    wanted.sort()
    if actual != wanted {
        return Err(NixEvalError.Manifest("`{path}` keys must be exactly {nixeval_debug_strings(wanted)}, got {nixeval_debug_strings(actual)}"))
    }
}

nixeval_oracle_exact: fn(field: String, actual: String, expected: String) NixEvalError! {
    if actual != expected -> return Err(NixEvalError.Manifest("`{field}` must be `{expected}`, got `{actual}`"))
}

nixeval_oracle_compare_identity: fn(system: String, field: String, expected: String, actual: String) NixEvalError! {
    if expected != actual -> return Err(NixEvalError.OracleIdentityMismatch{system, field, expected, actual})
}

// `sha256-` followed by exactly 44 canonical base64 characters ending in `=`
// whose unused trailing bits are zero (a 32-byte digest).
nixeval_is_canonical_sha256_sri: fn(value: String) -> Bool Never! {
    encoded: nixeval_strip_prefix(value, "sha256-") ?? return false
    bytes: encoded.bytes()
    if bytes.len() != 44 || (Int{bytes[43]}) != 61 -> return false
    loop index in 0..<43 {
        if nixeval_base64_value(Int{bytes[index]}) < 0 -> return false
    }
    nixeval_base64_value(Int{bytes[42]}) % 4 == 0
}

nixeval_base64_value: fn(byte: Int) -> Int Never! {
    if {
        byte >= 65 && byte <= 90 -> byte - 65
        byte >= 97 && byte <= 122 -> byte - 97 + 26
        byte >= 48 && byte <= 57 -> byte - 48 + 52
        byte == 43 -> 62
        byte == 47 -> 63
        else -> -1
    }
}

// Rust `{:?}` rendering of a string list, used by manifest diagnostics.
nixeval_debug_strings: fn(values: [String]) -> String Never! {
    rendered := [String]{}
    loop value in values -> rendered.push(nixeval_debug_string(value))
    joined: rendered.join(", ")
    "[{joined}]"
}

nixeval_debug_string: fn(value: String) -> String Never! {
    out := [U8]{}
    nixeval_push_byte(out, 34)
    hex: "0123456789abcdef".bytes()
    loop byte in value.bytes() {
        code: Int{byte}
        if code == {
            34 -> nixeval_push_text(out, "\\\"")
            92 -> nixeval_push_text(out, "\\\\")
            10 -> nixeval_push_text(out, "\\n")
            13 -> nixeval_push_text(out, "\\r")
            9 -> nixeval_push_text(out, "\\t")
            0 -> nixeval_push_text(out, "\\0")
            else -> {
                if {
                    code < 32 || code == 127 -> {
                        nixeval_push_text(out, "\\u{{")
                        if code >= 16 -> out.push(hex[code /% 16])
                        out.push(hex[code % 16])
                        nixeval_push_text(out, "}}")
                    }
                    else -> out.push(byte)
                }
            }
        }
    }
    nixeval_push_byte(out, 34)
    String.from_bytes(out) ?? value
}
