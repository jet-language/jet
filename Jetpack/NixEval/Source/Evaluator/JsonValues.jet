// `builtins.toJSON` and `builtins.fromJSON` conversions. Encoding is compact
// with sorted object keys; Nix integers are written as the binary64 value the
// reference encoder produces.

// 2^63: the reference converts a JSON number at this bound to the largest
// Nix integer and rejects anything beyond it.
@NIXEVAL_JSON_INTEGER_BOUND :: 9223372036854775808

impl NixEvaluator {
    fn encode_json(&self, value: NixEvalValue, depth: Int) -> String !NixEvalError {
        if depth > @NIXEVAL_EXPRESSION_LIMIT -> return Err(NixEvalError.ResourceLimit("JSON value is too deeply nested"))
        if value == {
            .Null -> return Ok("null")
            .Bool(flag) -> return Ok(if flag -> "true" else -> "false")
            .Integer(number) -> return Ok(nixeval_json_integer_text(number))
            .Str(text) | .Path(text) | .Package(text) | .Contextual(text, _) -> return Ok(nixeval_json_quote(text))
            .List(items) -> {
                parts := [String]{}
                loop item in items {
                    forced :: self.force(item)
                    parts.push(self.encode_json(forced, depth + 1))
                }
                joined :: parts.join(",")
                return Ok("[{joined}]")
            }
            .AttrSet(fields) -> {
                parts := [String]{}
                loop name in nixeval_sorted(fields.keys().to_list()) {
                    forced :: self.force(fields[name])
                    encoded :: self.encode_json(forced, depth + 1)
                    parts.push("{nixeval_json_quote(name)}:{encoded}")
                }
                joined :: parts.join(",")
                return Ok("{{{joined}}}")
            }
            else -> {}
        }
        Err(NixEvalError.Unsupported("value of type {value.type_name()} cannot be encoded as JSON"))
    }

    fn json_to_value(&self, document: NixEvalJson, index: Int, depth: Int) -> NixEvalValue !NixEvalError {
        if depth > @NIXEVAL_EXPRESSION_LIMIT -> return Err(NixEvalError.ResourceLimit("JSON value is too deeply nested"))
        if document.node(index) == {
            .Null -> NixEvalValue.Null
            .Bool(flag) -> NixEvalValue.Bool(flag)
            .Num(number) -> NixEvalValue.Integer(nixeval_json_integer(number))
            .Str(text) -> NixEvalValue.Str(text)
            .Array(items) -> {
                values := [Int]{}
                loop item in items {
                    converted :: self.json_to_value(document, item, depth + 1)
                    values.push(self.value_thunk(converted))
                }
                NixEvalValue.List(values)
            }
            .Object(members) -> {
                fields := [String: Int]{}
                loop entry in members {
                    converted :: self.json_to_value(document, entry.value, depth + 1)
                    fields[entry.key] = self.value_thunk(converted)
                }
                NixEvalValue.AttrSet(fields)
            }
        }
    }
}

// A JSON number as a Nix integer. The reference conversion saturates 2^63 to
// the largest integer and rejects fractions and anything out of range.
fn nixeval_json_integer(number: NixEvalJsonNumber) -> Int !NixEvalError {
    integer :: number.integer() ?? return Err(NixEvalError.Unsupported("fromJSON only supports Nix integer JSON numbers"))
    if integer < -@NIXEVAL_JSON_INTEGER_BOUND || integer > @NIXEVAL_JSON_INTEGER_BOUND {
        return Err(NixEvalError.Unsupported("fromJSON only supports Nix integer JSON numbers"))
    }
    if integer == @NIXEVAL_JSON_INTEGER_BOUND -> return Ok(integer - 1)
    Ok(integer)
}

// Decimal text of the binary64 rounding of an integer.
fn nixeval_json_integer_text(value: Int) -> String !Never {
    number :: NixEvalJsonNumber.from_int(value)
    "{number.integer() ?? 0}"
}

fn nixeval_json_quote(text: String) -> String !Never {
    out := [U8]{}
    nixeval_push_byte(&out, 34)
    hex :: "0123456789abcdef".bytes()
    loop byte in text.bytes() {
        value :: Int.from_u8(byte)
        if value == {
            34 -> nixeval_push_text(&out, "\\\"")
            92 -> nixeval_push_text(&out, "\\\\")
            10 -> nixeval_push_text(&out, "\\n")
            13 -> nixeval_push_text(&out, "\\r")
            9 -> nixeval_push_text(&out, "\\t")
            8 -> nixeval_push_text(&out, "\\b")
            12 -> nixeval_push_text(&out, "\\f")
            else -> {
                if {
                    value < 32 -> {
                        nixeval_push_text(&out, "\\u00")
                        out.push(hex[value /% 16])
                        out.push(hex[value % 16])
                    }
                    else -> out.push(byte)
                }
            }
        }
    }
    nixeval_push_byte(&out, 34)
    String.from_bytes(out) ?? text
}
