// Recursive-descent parser for the supported Nix subset. Expressions live in
// one flat node table owned by the evaluator; nodes refer to children by
// index. Every grammar level charges the shared nesting budget before it
// recurses, so deeply nested input fails with a resource limit.

NixEvalBinding: struct {
    name: String
    value: Int
}

NixEvalPatternField: struct {
    name: String
    default: Int?
}

NixEvalPattern: enum {
    Name(String)
    Attrs([NixEvalPatternField])
}

NixEvalStringPart: enum {
    Literal(String)
    Expression(Int)
}

NixEvalExpr: enum {
    Str(String)
    Interpolated([NixEvalStringPart])
    Path(String)
    Integer(Int)
    Bool(Bool)
    Null
    Identifier(String)
    AttrSet([NixEvalBinding])
    List([Int])
    Lambda(pattern: NixEvalPattern, body: Int)
    Apply(function: Int, argument: Int)
    Select(value: Int, field: String)
    Let(bindings: [NixEvalBinding], body: Int)
    With(scope: Int, body: Int)
    If(condition: Int, then_branch: Int, else_branch: Int)
    Merge(left: Int, right: Int)
    Equal(left: Int, right: Int, positive: Bool)
}

// Parsed nodes numbered from `base`, the node-table length they extend.
NixEvalSyntax: struct {
    nodes: [NixEvalExpr]
    root: Int
}

NixEvalParser: struct {
    tokens: [NixEvalToken]
    position: Int
    depth: Int
    base: Int
    nodes: [NixEvalExpr]

    parse: fn(tokens: [NixEvalToken], base: Int) -> NixEvalSyntax NixEvalError! {
        parser := NixEvalParser{tokens, position: 0, depth: 0, base, nodes: [NixEvalExpr]{}}
        root: parser.expression()
        if parser.peek() != NixEvalToken.End -> return Err(NixEvalError.Syntax("trailing expression"))
        Ok(NixEvalSyntax{nodes: parser.nodes, root})
    }

    add: fn(&self, node: NixEvalExpr) -> Int Never! {
        self.nodes.push(node.copy())
        self.base + self.nodes.len() - 1
    }

    enter: fn(&self) NixEvalError! {
        if self.depth >= NIXEVAL_EXPRESSION_LIMIT {
            return Err(NixEvalError.ResourceLimit("foreign flake parser exceeded {NIXEVAL_EXPRESSION_LIMIT} nested expressions"))
        }
        self.depth += 1
    }

    leave: fn(&self, node: Int) -> Int Never! {
        self.depth -= 1
        node
    }

    expression: fn(&self) -> Int NixEvalError! {
        self.enter()
        lambda: self.try_lambda()
        node: if lambda == {
            .Val(parsed) -> parsed
            .None -> self.equality()
        }
        Ok(self.leave(node))
    }

    try_lambda: fn(&self) -> Int? NixEvalError! {
        self.enter()
        lambda: self.try_lambda_inner()
        self.depth -= 1
        Ok(lambda)
    }

    try_lambda_inner: fn(&self) -> Int? NixEvalError! {
        saved: self.position.copy()
        if self.peek() == {
            .Identifier(name) -> {
                self.position += 1
                if self.take_if_colon() {
                    body: self.expression()
                    return Ok(Val(self.add(NixEvalExpr.Lambda{pattern: NixEvalPattern.Name(name), body})))
                }
            }
            .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> {}
        }
        self.position = saved
        if self.peek() != NixEvalToken.LeftBrace -> return Ok(None)
        self.position += 1
        fields := [NixEvalPatternField]{}
        loop self.peek() != NixEvalToken.RightBrace {
            if self.bump() == {
                .Ellipsis -> {}
                .Identifier(name) -> {
                    if {
                        self.peek() == NixEvalToken.Question -> {
                            self.position += 1
                            default: self.equality()
                            fields.push(NixEvalPatternField{name, default: Val(default)})
                        }
                        else -> fields.push(NixEvalPatternField{name, default: None})
                    }
                }
                .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .End -> {
                    self.position = saved
                    return Ok(None)
                }
            }
            if self.peek() == {
                .Comma -> self.position += 1
                .RightBrace -> {}
                .Identifier(_) | .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Question | .Ellipsis | .End -> {
                    self.position = saved
                    return Ok(None)
                }
            }
        }
        self.position += 1
        if !self.take_if_colon() {
            self.position = saved
            return Ok(None)
        }
        body: self.expression()
        Ok(Val(self.add(NixEvalExpr.Lambda{pattern: NixEvalPattern.Attrs(fields), body})))
    }

    equality: fn(&self) -> Int NixEvalError! {
        self.enter()
        expression := self.merge()
        loop {
            token: self.peek()
            positive := false
            if token == {
                .EqualEqual -> positive = true
                .NotEqual -> positive = false
                .Identifier(_) | .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> return Ok(self.leave(expression))
            }
            self.position += 1
            right: self.merge()
            expression = self.add(NixEvalExpr.Equal{left: expression, right, positive})
        }
    }

    merge: fn(&self) -> Int NixEvalError! {
        self.enter()
        expression := self.application()
        loop self.peek() == NixEvalToken.Merge {
            self.position += 1
            right: self.application()
            expression = self.add(NixEvalExpr.Merge{left: expression, right})
        }
        Ok(self.leave(expression))
    }

    application: fn(&self) -> Int NixEvalError! {
        self.enter()
        expression := self.selection()
        loop self.starts_application() {
            argument: self.selection()
            expression = self.add(NixEvalExpr.Apply{function: expression, argument})
        }
        Ok(self.leave(expression))
    }

    selection: fn(&self) -> Int NixEvalError! {
        self.enter()
        expression := self.atom()
        loop self.peek() == NixEvalToken.Dot {
            self.position += 1
            token: self.bump()
            if token == {
                .Identifier(field) -> expression = self.add(NixEvalExpr.Select{value: expression, field})
                .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> return Err(NixEvalError.Syntax("field selector requires an identifier"))
            }
        }
        Ok(self.leave(expression))
    }

    atom: fn(&self) -> Int NixEvalError! {
        self.enter()
        node: self.atom_inner()
        Ok(self.leave(node))
    }

    atom_inner: fn(&self) -> Int NixEvalError! {
        token: self.bump()
        if token == {
            .Str(value) -> self.add(NixEvalExpr.Str(value))
            .Interpolated(parts) -> self.string_context(parts)
            .Path(value) -> self.add(NixEvalExpr.Path(value))
            .Integer(value) -> self.add(NixEvalExpr.Integer(value))
            .Identifier(name) -> {
                if name == {
                    "true" -> self.add(NixEvalExpr.Bool(true))
                    "false" -> self.add(NixEvalExpr.Bool(false))
                    "null" -> self.add(NixEvalExpr.Null)
                    "let" -> self.let_expression()
                    "with" -> self.with_expression()
                    "if" -> self.if_expression()
                    else -> self.add(NixEvalExpr.Identifier(name))
                }
            }
            .LeftBrace -> self.attrset()
            .LeftBracket -> self.list()
            .LeftParen -> {
                expression: self.expression()
                self.expect_right_paren()
                expression
            }
            .RightBrace | .RightBracket | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> nixeval_unexpected_token(token)
        }
    }

    // Each `${...}` body is lexed and parsed as its own complete expression at
    // the current nesting depth.
    string_context: fn(&self, parts: [NixEvalStringTokenPart]) -> Int NixEvalError! {
        expressions := [NixEvalStringPart]{}
        loop part in parts {
            if part == {
                .Literal(value) -> expressions.push(NixEvalStringPart.Literal(value))
                .Expression(source) -> {
                    tokens: NixEvalLexer.tokenize(source)
                    outer_tokens: self.tokens.copy()
                    outer_position: self.position.copy()
                    self.tokens = tokens
                    self.position = 0
                    expression: self.expression()
                    if self.peek() != NixEvalToken.End -> return Err(NixEvalError.Syntax("trailing expression"))
                    self.tokens = outer_tokens
                    self.position = outer_position
                    expressions.push(NixEvalStringPart.Expression(expression))
                }
            }
        }
        Ok(self.add(NixEvalExpr.Interpolated(expressions)))
    }

    attrset: fn(&self) -> Int NixEvalError! {
        self.enter()
        fields := [NixEvalBinding]{}
        loop self.peek() != NixEvalToken.RightBrace {
            name: self.key_path()
            self.expect_equal()
            value: self.expression()
            fields.push(NixEvalBinding{name, value})
            if self.peek() == {
                .Semicolon | .Comma -> self.position += 1
                .RightBrace -> {}
                .Identifier(_) | .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Dot | .Question | .Ellipsis | .End -> return Err(NixEvalError.Syntax("attribute values require `;`"))
            }
        }
        self.position += 1
        node: self.add(NixEvalExpr.AttrSet(fields))
        Ok(self.leave(node))
    }

    list: fn(&self) -> Int NixEvalError! {
        self.enter()
        values := [Int]{}
        loop self.peek() != NixEvalToken.RightBracket {
            values.push(self.selection())
            if self.peek() == NixEvalToken.Comma -> self.position += 1
        }
        self.position += 1
        node: self.add(NixEvalExpr.List(values))
        Ok(self.leave(node))
    }

    let_expression: fn(&self) -> Int NixEvalError! {
        self.enter()
        bindings := [NixEvalBinding]{}
        loop !self.word("in") {
            token: self.bump()
            name := ""
            if token == {
                .Identifier(identifier) -> name = identifier
                .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> return Err(NixEvalError.Syntax("let binding requires a name"))
            }
            self.expect_equal()
            value: self.expression()
            bindings.push(NixEvalBinding{name, value})
            if self.peek() != NixEvalToken.Semicolon -> return Err(NixEvalError.Syntax("let binding requires `;`"))
            self.position += 1
        }
        self.position += 1
        body: self.expression()
        node: self.add(NixEvalExpr.Let{bindings, body})
        Ok(self.leave(node))
    }

    with_expression: fn(&self) -> Int NixEvalError! {
        self.enter()
        scope: self.expression()
        if self.peek() != NixEvalToken.Semicolon -> return Err(NixEvalError.Syntax("with expression requires `;`"))
        self.position += 1
        body: self.expression()
        node: self.add(NixEvalExpr.With{scope, body})
        Ok(self.leave(node))
    }

    if_expression: fn(&self) -> Int NixEvalError! {
        self.enter()
        condition: self.expression()
        if !self.word("then") -> return Err(NixEvalError.Syntax("if expression requires `then`"))
        self.position += 1
        then_branch: self.expression()
        if !self.word("else") -> return Err(NixEvalError.Syntax("if expression requires `else`"))
        self.position += 1
        else_branch: self.expression()
        node: self.add(NixEvalExpr.If{condition, then_branch, else_branch})
        Ok(self.leave(node))
    }

    key_path: fn(&self) -> String NixEvalError! {
        first: self.bump()
        key := ""
        if first == {
            .Identifier(name) -> key = name
            .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> return Err(NixEvalError.Syntax("attribute key requires an identifier"))
        }
        loop self.peek() == NixEvalToken.Dot {
            self.position += 1
            part: self.bump()
            if part == {
                .Identifier(name) -> key = "{key}.{name}"
                .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> return Err(NixEvalError.Syntax("attribute key path requires an identifier"))
            }
        }
        Ok(key)
    }

    starts_application: fn(self) -> Bool Never! {
        if self.peek() == {
            .Identifier(name) -> !(name == "in" || name == "then" || name == "else")
            .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .LeftBracket | .LeftParen -> true
            .RightBrace | .RightBracket | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> false
        }
    }

    word: fn(self, expected: String) -> Bool Never! {
        if self.peek() == {
            .Identifier(name) -> name == expected
            .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .LeftBrace | .RightBrace | .LeftBracket | .RightBracket | .LeftParen | .RightParen | .Equal | .EqualEqual | .NotEqual | .Merge | .Colon | .Semicolon | .Dot | .Comma | .Question | .Ellipsis | .End -> false
        }
    }

    take_if_colon: fn(&self) -> Bool Never! {
        if self.peek() != NixEvalToken.Colon -> return false
        self.position += 1
        true
    }

    expect_equal: fn(&self) NixEvalError! {
        if self.peek() != NixEvalToken.Equal -> return Err(NixEvalError.Syntax("expected `=`"))
        self.position += 1
    }

    expect_right_paren: fn(&self) NixEvalError! {
        if self.peek() != NixEvalToken.RightParen -> return Err(NixEvalError.Syntax("expected `)`"))
        self.position += 1
    }

    bump: fn(&self) -> NixEvalToken Never! {
        if self.position >= self.tokens.len() -> return NixEvalToken.End
        token: self.tokens[self.position].copy()
        self.position += 1
        token
    }

    // The lexer always appends `End`, so reading past it repeats `End`.
    peek: fn(self) -> NixEvalToken Never! {
        if self.position < self.tokens.len() -> return self.tokens[self.position].copy()
        self.tokens[self.tokens.len() - 1].copy()
    }
}

nixeval_unexpected_token: fn(token: NixEvalToken) -> Int NixEvalError! {
    Err(NixEvalError.Syntax("unexpected token {token.describe()}"))
}
