// Runtime values of the bounded evaluator. Lists, attribute sets and function
// arguments hold thunk indices into the evaluator's thunk table, so values
// stay acyclic and sharing is explicit.

NIXEVAL_MAX_PATH_BYTES: 4096
NIXEVAL_MAX_PACKAGE_NAME_BYTES: 128

// A package namespace. `overlay` names a shared, mutable override table once
// the namespace has been merged or overlaid; a plain namespace has none.
NixEvalPackageSet: struct {
    prefix: String
    overlay: Int?
}

NixEvalFetcher: enum {
    Fetchurl
    FetchTarball
    FetchTree
    FetchGit

    name: fn(self) -> String Never! {
        if self == {
            .Fetchurl -> "fetchurl"
            .FetchTarball -> "fetchTarball"
            .FetchTree -> "fetchTree"
            .FetchGit -> "fetchGit"
        }
    }
}

NixEvalBuiltin: enum {
    AttrNames
    AttrValues
    GetAttr
    HasAttr
    IsAttrs
    IsBool
    IsFunction
    IsInt
    IsList
    IsNull
    IsPath
    IsString
    Length
    Head
    Tail
    ConcatLists
    ConcatStringsSep
    Map
    Filter
    ReplaceStrings
    Substring
    BaseNameOf
    DirOf
    StringLength
    ToJSON
    FromJSON
    StorePath
    Throw
}

// Curried builtins waiting for their remaining arguments.
NixEvalOperation: enum {
    GetAttr
    HasAttr
    Map
    Filter
    ConcatStringsSep
    ReplaceStrings
    Substring

    arity: fn(self) -> Int Never! {
        if self == {
            .ReplaceStrings | .Substring -> 3
            .GetAttr | .HasAttr | .Map | .Filter | .ConcatStringsSep -> 2
        }
    }
}

NixEvalNative: enum {
    MkShell
    Import
    ImportPackage(NixEvalPackageSet)
    ExtendPackage(NixEvalPackageSet)
    Fetch(NixEvalFetcher)
    GetFlake
    ToString
    HasContext
    Builtin(NixEvalBuiltin)
    Partial(operation: NixEvalOperation, arguments: [Int])
    Derivation(Bool)
}

NixEvalValue: enum {
    Null
    Bool(Bool)
    Integer(Int)
    Str(String)
    Contextual(value: String, contexts: [String])
    Path(String)
    Package(String)
    Packages(NixEvalPackageSet)
    CrossPackages(String)
    BuiltinsNamespace
    LibraryNamespace
    List([Int])
    AttrSet([String: Int])
    Derivation(fields: [String: Int], request: NixEvalDerivation?)
    Function(lambda: Int, frame: Int)
    Native(NixEvalNative)

    type_name: fn(self) -> String Never! {
        if self == {
            .Null -> "null"
            .Bool(_) -> "boolean"
            .Integer(_) -> "integer"
            .Str(_) | .Contextual(_, _) -> "string"
            .Path(_) -> "path"
            .Package(_) -> "package"
            .Packages(_) | .CrossPackages(_) -> "package namespace"
            .BuiltinsNamespace -> "builtins namespace"
            .LibraryNamespace -> "library namespace"
            .List(_) -> "list"
            .AttrSet(_) -> "attribute set"
            .Derivation(_, _) -> "derivation"
            .Function(_, _) | .Native(_) -> "function"
        }
    }

    text: fn(self) -> String? Never! {
        if self == {
            .Str(value) -> Val(value)
            .Contextual(value, _) -> Val(value)
            .Null | .Bool(_) | .Integer(_) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> None
        }
    }

    is_function: fn(self) -> Bool Never! {
        if self == {
            .Function(_, _) -> true
            .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Native(_) -> false
        }
    }

    attr_fields: fn(self) -> [String: Int]? Never! {
        if self == {
            .AttrSet(fields) -> Val(fields)
            .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> None
        }
    }

    list_items: fn(self) -> [Int]? Never! {
        if self == {
            .List(items) -> Val(items)
            .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> None
        }
    }

    // The package name a devShell package entry spells: a package, or a
    // string whose contexts name no project path.
    package_text: fn(self) -> String NixEvalError! {
        if self == {
            .Package(name) -> return Ok(name)
            .Contextual(_, contexts) -> {
                loop context in contexts {
                    if nixeval_has_prefix(context, "path:") -> return Err(NixEvalError.Unsupported("path string contexts are not devShell packages"))
                }
            }
            .Null | .Bool(_) | .Integer(_) | .Str(_) | .Path(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> {}
        }
        text: self.text() ?? return Err(NixEvalError.Unsupported("package expression has type {self.type_name()}"))
        Ok(text)
    }

    // String coercion with its string contexts.
    stringify: fn(self) -> NixEvalText NixEvalError! {
        if self == {
            .Str(value) -> return Ok(NixEvalText{value, contexts: [String]{}})
            .Contextual(value, contexts) -> return Ok(NixEvalText{value, contexts})
            .Integer(value) -> return Ok(NixEvalText{value: "{value}", contexts: [String]{}})
            .Package(name) -> return Ok(NixEvalText{value: name.copy(), contexts: [String]{"package:{name}"}})
            .Path(path) -> return Ok(NixEvalText{value: path.copy(), contexts: [String]{"path:{path}"}})
            .Null | .Bool(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> {}
        }
        Err(NixEvalError.Unsupported("value of type {self.type_name()} cannot be coerced to a string"))
    }

    plain_string: fn(self) -> String NixEvalError! {
        text: self.stringify()
        Ok(text.value)
    }

    // Nix `==` over the bounded value kinds: strings compare by text, and a
    // package equals the string naming its last attribute segment.
    equals: fn(self, other: NixEvalValue) -> Bool Never! {
        if self == {
            .Null -> other == NixEvalValue.Null
            .Bool(value) -> other == NixEvalValue.Bool(value)
            .Integer(value) -> other == NixEvalValue.Integer(value)
            .Package(package) -> {
                if other == {
                    .Package(right) -> package == right
                    .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> nixeval_package_named(package, other.text())
                }
            }
            .Str(left) | .Contextual(left, _) -> {
                if other == {
                    .Package(package) -> nixeval_package_named(package, Val(left))
                    .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> nixeval_same_text(other.text(), left)
                }
            }
            .Path(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> false
        }
    }
}

// True when `text` names the last attribute segment of `package`.
nixeval_package_named: fn(package: String, text: String?) -> Bool Never! {
    name: text ?? return false
    nixeval_last_segment(package, "./:") == name
}

nixeval_same_text: fn(text: String?, expected: String) -> Bool Never! {
    value: text ?? return false
    value == expected
}

// A coerced string and its contexts (`package:<name>` or `path:<path>`).
NixEvalText: struct {
    value: String
    contexts: [String]

    into_value: fn(self) -> NixEvalValue Never! {
        if self.contexts.len() == 0 -> return NixEvalValue.Str(self.value)
        NixEvalValue.Contextual{value: self.value, contexts: self.contexts}
    }
}

NixEvalThunk: enum {
    Pending(expression: Int, frame: Int)
    Evaluating
    Evaluated(NixEvalValue)
    Failed(String)
}

// One lexical scope. Child frames share their root's expression fuel.
NixEvalFrame: struct {
    parent: Int?
    bindings: [String: Int]
    scopes: [Int]
    fuel: Int
    base_path: String
}

nixeval_package_name: fn(raw: String) -> String NixEvalError! {
    name: nixeval_last_segment(raw, "./")
    if name == "" || name.bytes().len() > NIXEVAL_MAX_PACKAGE_NAME_BYTES {
        return Err(NixEvalError.Unsupported("invalid package name `{raw}`"))
    }
    Ok(name)
}

nixeval_cross_package_name: fn(raw: String) -> String? Never! {
    identity: nixeval_strip_prefix(raw, "cross:") ?? return None
    bytes: identity.bytes()
    colon: nixeval_first_byte(bytes, 58)
    if colon < 0 -> return None
    target: nixeval_slice(bytes, 0, colon)
    package: nixeval_last_segment(nixeval_slice(bytes, colon + 1, bytes.len()), "./:")
    if target == "" || package == "" -> return None
    Val("{target}/{package}")
}

nixeval_is_store_path: fn(path: String) -> Bool Never! {
    name: nixeval_strip_prefix(path, "/nix/store/") ?? return false
    bytes: name.bytes()
    if nixeval_first_byte(bytes, 45) != 32 || bytes.len() <= 33 -> return false
    alphabet: "0123456789abcdfghijklmnpqrsvwxyz".bytes()
    loop index in 0..<32 {
        if nixeval_first_byte(alphabet, Int.from_u8(bytes[index])) < 0 -> return false
    }
    label_marks: "+._?=-".bytes()
    loop index in 33..<bytes.len() {
        byte: Int.from_u8(bytes[index])
        if !nixeval_is_ascii_alphanumeric(byte) && nixeval_first_byte(label_marks, byte) < 0 -> return false
    }
    true
}
