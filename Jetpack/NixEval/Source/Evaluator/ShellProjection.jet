// devShell resolution and the typed, non-executing package projection.

NIXEVAL_MAX_DEV_SHELL_PACKAGES: 256

nixeval_shell_package_fields: fn() -> [String] Never! {
    [String]{"packages", "buildInputs", "nativeBuildInputs"}
}

// Output prefixes tried, in order, before the selected devShell output path.
nixeval_shell_output_prefixes: fn(system: String) -> [[String]] Never! {
    [[String]]{
        [String]{"outputs", "devShells", system},
        [String]{"devShells", system},
        [String]{"outputs", "devShells"},
        [String]{"devShells"},
    }
}

impl NixEvaluator {
    // `shell.nix` and `default.nix` conventionally evaluate directly to a
    // `mkShell` value behind a `pkgs: ...` or `{ pkgs ? ... }:` function. Project
    // that bounded direct form before trying the flake output paths; a flake root
    // still falls through because its `packages` field is not a package list.
    resolve_shell: fn(&self, root: NixEvalValue, output: String) -> NixEvalValue NixEvalError! {
        if root == {
            .Function(lambda, _) -> {
                argument: self.direct_shell_argument(lambda)
                if argument == .Val(value) {
                    thunk: self.value_thunk(value)
                    direct: self.apply(root, thunk)
                    if self.is_direct_shell(direct) -> return Ok(direct)
                }
            }
            .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Native(_) -> {
                if self.is_direct_shell(root) -> return Ok(root)
            }
        }
        output_path := [String]{}
        loop segment in output.split(".") {
            if segment == "" -> return Err(NixEvalError.Invalid("devShell output selector must be a non-empty attribute path"))
            output_path.push(segment)
        }
        loop prefix in nixeval_shell_output_prefixes(self.system) {
            path := [String]{}
            loop segment in prefix -> path.push(segment)
            loop segment in output_path -> path.push(segment)
            if self.resolve_path(root, path) == {
                .Ok(value) -> return Ok(value)
                .Err(error) -> {
                    if !error.is_missing() -> return Err(error)
                }
            }
        }
        Err(NixEvalError.Unsupported("no supported `devShell` or `mkShell` output `{output}` was found"))
    }

    // The argument a direct shell function receives: a bare `pkgs: ...` names
    // the package set itself; a `{ pkgs, ... }:` pattern receives the flake
    // arguments when every field without a default is one of them.
    direct_shell_argument: fn(&self, lambda: Int) -> NixEvalValue? Never! {
        node: self.exprs[lambda].copy()
        if node == {
            .Lambda(pattern, _) -> {
                if pattern == {
                    .Name(_) -> Val(NixEvalValue.Packages(NixEvalPackageSet{prefix: "", overlay: None}))
                    .Attrs(fields) -> {
                        loop field in fields {
                            if field.default != None -> next
                            if field.name == {
                                "legacyPackages" | "nixpkgs" | "pkgs" | "self" | "system" -> {}
                                else -> return None
                            }
                        }
                        Val(self.flake_arguments())
                    }
                }
            }
            .Str(_) | .Interpolated(_) | .Path(_) | .Integer(_) | .Bool(_) | .Null | .Identifier(_) | .AttrSet(_) | .List(_) | .Apply(_, _) | .Select(_, _) | .Let(_, _) | .With(_, _) | .If(_, _, _) | .Merge(_, _) | .Equal(_, _, _) -> None
        }
    }

    is_direct_shell: fn(&self, value: NixEvalValue) -> Bool NixEvalError! {
        fields: value.attr_fields() ?? return Ok(false)
        if fields.get("shellHook") != None -> return Ok(true)
        loop field in nixeval_shell_package_fields() {
            binding: fields.get(field) ?? next
            forced: self.force(binding)
            if forced == {
                .List(_) -> return Ok(true)
                .Null | .Bool(_) | .Integer(_) | .Str(_) | .Contextual(_, _) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> {}
            }
        }
        Ok(false)
    }

    resolve_path: fn(&self, start: NixEvalValue, path: [String]) -> NixEvalValue NixEvalError! {
        value := start
        loop field in path {
            if value.is_function() -> value = self.apply_flake_arguments(value)
            selected: self.select(value, field)
            value = self.force(selected)
        }
        Ok(value)
    }

    project_shell: fn(&self, shell: NixEvalValue) -> NixEvalDevShell NixEvalError! {
        fields: shell.attr_fields() ?? return Err(NixEvalError.Unsupported("devShell output must be an attribute set, got {shell.type_name()}"))
        shell_fields: nixeval_sorted(fields.keys().to_list())
        packages := [String]{}
        cross_packages := [String]{}
        loop field in nixeval_shell_package_fields() {
            found: self.try_select(shell, field)
            binding: found ?? next
            items: self.package_list(binding, field)
            loop item in items {
                if packages.len() + cross_packages.len() >= NIXEVAL_MAX_DEV_SHELL_PACKAGES {
                    return Err(NixEvalError.ResourceLimit("devShell has more than {NIXEVAL_MAX_DEV_SHELL_PACKAGES} packages"))
                }
                forced: self.force(item)
                raw: forced.package_text()
                if nixeval_cross_package_name(raw) == {
                    .Val(cross) -> cross_packages.push(cross)
                    .None -> packages.push(nixeval_package_name(raw))
                }
            }
        }
        unsupported := [String]{}
        loop field in shell_fields {
            head: field.split(".").to_list()[0]
            if head == {
                "packages" | "buildInputs" | "nativeBuildInputs" | "shellHook" -> {}
                else -> {
                    if !nixeval_contains_text(unsupported, head) -> unsupported.push(head)
                }
            }
        }
        hook_binding: self.try_select(shell, "shellHook")
        if hook_binding == {
            .Val(hook) -> {
                hook_value: self.force(hook)
                if hook_value == {
                    .Str(value) | .Contextual(value, _) -> {
                        if !nixeval_is_blank(value) -> unsupported.push("shellHook")
                    }
                    .Null | .Bool(_) | .Integer(_) | .Path(_) | .Package(_) | .Packages(_) | .CrossPackages(_) | .BuiltinsNamespace | .LibraryNamespace | .List(_) | .AttrSet(_) | .Derivation(_, _) | .Function(_, _) | .Native(_) -> unsupported.push("shellHook")
                }
            }
            .None -> {}
        }
        Ok(NixEvalDevShell{
            system: self.system,
            packages: nixeval_sorted_unique(packages),
            cross_packages: nixeval_sorted_unique(cross_packages),
            unsupported: nixeval_sorted_unique(unsupported),
        })
    }

    // The items of a devShell package field, which must be a literal list.
    package_list: fn(&self, binding: Int, field: String) -> [Int] NixEvalError! {
        if self.force(binding) == {
            .Ok(value) -> {
                items: value.list_items() ?? return Err(NixEvalError.Unsupported("`{field}` must be a literal package list"))
                return Ok(items)
            }
            .Err(error) -> {
                if error.is_missing() -> return Err(NixEvalError.Unsupported("`{field}` must be a literal package list"))
                return Err(error)
            }
        }
    }
}
