// The bounded `builtins` namespace: pure builtins, curried operations and the
// fixed-output fetchers that require explicit fetch authority.

impl NixEvaluator {
    fn builtins_field(&self, field: String) -> ?Int !Never {
        native := NixEvalNative.ToString
        if field == {
            "toString" -> native = NixEvalNative.ToString
            "hasContext" -> native = NixEvalNative.HasContext
            "derivation" -> native = NixEvalNative.Derivation(false)
            "derivationStrict" -> native = NixEvalNative.Derivation(true)
            "attrNames" -> native = NixEvalNative.Builtin(NixEvalBuiltin.AttrNames)
            "attrValues" -> native = NixEvalNative.Builtin(NixEvalBuiltin.AttrValues)
            "getAttr" -> native = NixEvalNative.Builtin(NixEvalBuiltin.GetAttr)
            "hasAttr" -> native = NixEvalNative.Builtin(NixEvalBuiltin.HasAttr)
            "isAttrs" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsAttrs)
            "isBool" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsBool)
            "isFunction" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsFunction)
            "isInt" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsInt)
            "isList" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsList)
            "isNull" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsNull)
            "isPath" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsPath)
            "isString" -> native = NixEvalNative.Builtin(NixEvalBuiltin.IsString)
            "length" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Length)
            "head" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Head)
            "tail" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Tail)
            "concatLists" -> native = NixEvalNative.Builtin(NixEvalBuiltin.ConcatLists)
            "concatStringsSep" -> native = NixEvalNative.Builtin(NixEvalBuiltin.ConcatStringsSep)
            "map" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Map)
            "filter" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Filter)
            "replaceStrings" -> native = NixEvalNative.Builtin(NixEvalBuiltin.ReplaceStrings)
            "substring" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Substring)
            "baseNameOf" -> native = NixEvalNative.Builtin(NixEvalBuiltin.BaseNameOf)
            "dirOf" -> native = NixEvalNative.Builtin(NixEvalBuiltin.DirOf)
            "stringLength" -> native = NixEvalNative.Builtin(NixEvalBuiltin.StringLength)
            "toJSON" -> native = NixEvalNative.Builtin(NixEvalBuiltin.ToJSON)
            "fromJSON" -> native = NixEvalNative.Builtin(NixEvalBuiltin.FromJSON)
            "storePath" -> native = NixEvalNative.Builtin(NixEvalBuiltin.StorePath)
            "throw" -> native = NixEvalNative.Builtin(NixEvalBuiltin.Throw)
            "fetchurl" -> native = NixEvalNative.Fetch(NixEvalFetcher.Fetchurl)
            "fetchTarball" -> native = NixEvalNative.Fetch(NixEvalFetcher.FetchTarball)
            "fetchTree" -> native = NixEvalNative.Fetch(NixEvalFetcher.FetchTree)
            "fetchGit" -> native = NixEvalNative.Fetch(NixEvalFetcher.FetchGit)
            "getFlake" -> native = NixEvalNative.GetFlake
            "currentSystem" -> return Val(self.value_thunk(NixEvalValue.Str(self.system)))
            "storeDir" -> return Val(self.value_thunk(NixEvalValue.Str("/nix/store")))
            else -> return None
        }
        Val(self.value_thunk(NixEvalValue.Native(native)))
    }

    fn apply_builtin(&self, builtin: NixEvalBuiltin, argument: NixEvalValue) -> NixEvalValue !NixEvalError {
        if builtin == {
            .AttrNames -> {
                if argument == {
                    .AttrSet(fields) -> {
                        names := [Int]{}
                        loop entry in fields -> names.push(self.value_thunk(NixEvalValue.Str(entry.key)))
                        return Ok(NixEvalValue.List(names))
                    }
                    else -> return Err(NixEvalError.TypeMismatch{expected: "attribute set", actual: argument.type_name()})
                }
            }
            .AttrValues -> {
                if argument == {
                    .AttrSet(fields) -> {
                        values := [Int]{}
                        loop entry in fields -> values.push(entry.value)
                        return Ok(NixEvalValue.List(values))
                    }
                    else -> return Err(NixEvalError.TypeMismatch{expected: "attribute set", actual: argument.type_name()})
                }
            }
            .GetAttr -> return Ok(self.partial(NixEvalOperation.GetAttr, argument))
            .HasAttr -> return Ok(self.partial(NixEvalOperation.HasAttr, argument))
            .IsAttrs -> {
                if argument == {
                    .AttrSet(_) | .Packages(_) | .CrossPackages(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsBool -> {
                if argument == {
                    .Bool(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsFunction -> {
                if argument == {
                    .Function(_, _) | .Native(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsInt -> {
                if argument == {
                    .Integer(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsList -> {
                if argument == {
                    .List(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsNull -> {
                if argument == {
                    .Null -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsPath -> {
                if argument == {
                    .Path(_) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .IsString -> {
                if argument == {
                    .Str(_) | .Contextual(_, _) -> return Ok(NixEvalValue.Bool(true))
                    else -> return Ok(NixEvalValue.Bool(false))
                }
            }
            .Length -> {
                if argument == {
                    .List(values) -> return Ok(NixEvalValue.Integer(values.len()))
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list", actual: argument.type_name()})
                }
            }
            .Head -> {
                if argument == {
                    .List(values) -> {
                        if values.len() == 0 -> return Err(NixEvalError.Invalid("head called on an empty list"))
                        return self.force(values[0])
                    }
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list", actual: argument.type_name()})
                }
            }
            .Tail -> {
                if argument == {
                    .List(values) -> {
                        if values.len() == 0 -> return Err(NixEvalError.Invalid("tail called on an empty list"))
                        return Ok(NixEvalValue.List(values[1..<values.len()]))
                    }
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list", actual: argument.type_name()})
                }
            }
            .ConcatLists -> {
                lists := [Int]{}
                if argument == {
                    .List(values) -> lists = values
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list of lists", actual: argument.type_name()})
                }
                flattened := [Int]{}
                loop list in lists {
                    forced :: self.force(list)
                    if forced == {
                        .List(items) -> {
                            loop item in items -> flattened.push(item)
                        }
                        else -> return Err(NixEvalError.TypeMismatch{expected: "list of lists", actual: "non-list item"})
                    }
                }
                return Ok(NixEvalValue.List(flattened))
            }
            .ConcatStringsSep -> return Ok(self.partial(NixEvalOperation.ConcatStringsSep, argument))
            .Map -> return Ok(self.partial(NixEvalOperation.Map, argument))
            .Filter -> return Ok(self.partial(NixEvalOperation.Filter, argument))
            .ReplaceStrings -> return Ok(self.partial(NixEvalOperation.ReplaceStrings, argument))
            .Substring -> return Ok(self.partial(NixEvalOperation.Substring, argument))
            .BaseNameOf -> {
                value :: argument.plain_string()
                return Ok(NixEvalValue.Str(nixeval_last_segment(value, "/")))
            }
            .DirOf -> {
                value :: argument.plain_string()
                bytes :: value.bytes()
                slash :: nixeval_last_byte(bytes, 47)
                if {
                    slash < 0 -> return Ok(NixEvalValue.Str("."))
                    slash == 0 -> return Ok(NixEvalValue.Str("/"))
                    else -> return Ok(NixEvalValue.Str(nixeval_slice(bytes, 0, slash)))
                }
            }
            .StringLength -> {
                value :: argument.plain_string()
                return Ok(NixEvalValue.Integer(nixeval_scalar_count(value)))
            }
            .ToJSON -> {
                encoded :: self.encode_json(argument, 0)
                return Ok(NixEvalValue.Str(encoded))
            }
            .FromJSON -> {
                text :: argument.plain_string()
                if NixEvalJson.parse(text) == {
                    .Ok(document) -> return self.json_to_value(document, document.root, 0)
                    .Err(error) -> {
                        reason :: error.message()
                        if reason == "JSON value is too deeply nested" -> return Err(NixEvalError.ResourceLimit(reason))
                        return Err(NixEvalError.Invalid(reason))
                    }
                }
            }
            .StorePath -> {
                path :: argument.plain_string()
                if !nixeval_is_store_path(path) -> return Err(NixEvalError.Unsupported("builtins.storePath requires a canonical /nix/store path"))
                return Ok(NixEvalValue.Contextual{value: ~path, contexts: [String]{"path:{path}"}})
            }
            .Throw -> {
                message :: argument.plain_string()
                return Err(NixEvalError.Invalid("foreign flake evaluation threw: {message}"))
            }
        }
    }

    fn partial(&self, operation: NixEvalOperation, argument: NixEvalValue) -> NixEvalValue !Never {
        NixEvalValue.Native(NixEvalNative.Partial{operation, arguments: [Int]{self.value_thunk(argument)}})
    }

    fn apply_partial(&self, operation: NixEvalOperation, arguments: [Int]) -> NixEvalValue !NixEvalError {
        if arguments.len() < operation.arity() -> return Ok(NixEvalValue.Native(NixEvalNative.Partial{operation, arguments}))
        if arguments.len() > operation.arity() -> return Err(NixEvalError.Invalid("builtin received too many arguments"))
        first :: self.force(arguments[0])
        second :: self.force(arguments[1])
        if operation == {
            .GetAttr -> {
                name :: first.plain_string()
                if second == {
                    .AttrSet(fields) -> {
                        binding :: self.attr_field(fields, name) ?? return Err(NixEvalError.Missing(name))
                        return self.force(binding)
                    }
                    else -> return Err(NixEvalError.TypeMismatch{expected: "attribute set", actual: second.type_name()})
                }
            }
            .HasAttr -> {
                name :: first.plain_string()
                if second == {
                    .AttrSet(fields) -> return Ok(NixEvalValue.Bool(self.attr_field(fields, name) != None))
                    else -> return Err(NixEvalError.TypeMismatch{expected: "attribute set", actual: second.type_name()})
                }
            }
            .Map | .Filter -> {
                values := [Int]{}
                if second == {
                    .List(items) -> values = items
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list", actual: second.type_name()})
                }
                output := [Int]{}
                keep_matches :: operation == NixEvalOperation.Filter
                loop value in values {
                    result :: self.apply(first, value)
                    if !keep_matches {
                        output.push(self.value_thunk(result))
                        next
                    }
                    if result == {
                        .Bool(keep) -> {
                            if keep -> output.push(value)
                        }
                        else -> return Err(NixEvalError.TypeMismatch{expected: "boolean predicate result", actual: result.type_name()})
                    }
                }
                return Ok(NixEvalValue.List(output))
            }
            .ConcatStringsSep -> {
                separator :: first.plain_string()
                values := [Int]{}
                if second == {
                    .List(items) -> values = items
                    else -> return Err(NixEvalError.TypeMismatch{expected: "list", actual: second.type_name()})
                }
                output := [U8]{}
                contexts := [String]{}
                loop index in 0..<values.len() {
                    if index > 0 -> nixeval_push_text(&output, separator)
                    forced :: self.force(values[index])
                    text :: forced.stringify()
                    nixeval_push_text(&output, text.value)
                    loop context in text.contexts {
                        if !nixeval_contains_text(contexts, context) -> contexts.push(context)
                    }
                }
                return Ok(NixEvalText{value: String.from_bytes(output) ?? "", contexts}.into_value())
            }
            .ReplaceStrings -> {
                from :: self.string_list(first)
                to :: self.string_list(second)
                if from.len() != to.len() -> return Err(NixEvalError.Invalid("replaceStrings requires equal search and replacement lists"))
                subject_value :: self.force(arguments[2])
                subject :: subject_value.stringify()
                bytes :: subject.value.bytes()
                output := [U8]{}
                position := 0
                loop position < bytes.len() {
                    matched := -1
                    loop index in 0..<from.len() {
                        needle :: from[index].bytes()
                        if needle.len() > 0 && nixeval_matches_at(bytes, needle, position) {
                            matched = index
                            break
                        }
                    }
                    if matched >= 0 {
                        nixeval_push_text(&output, to[matched])
                        position += from[matched].bytes().len()
                        next
                    }
                    width :: nixeval_scalar_width(bytes, position)
                    loop offset in 0..<width -> output.push(bytes[position + offset])
                    position += width
                }
                return Ok(NixEvalText{value: String.from_bytes(output) ?? "", contexts: subject.contexts}.into_value())
            }
            .Substring -> {
                start := 0
                length := 0
                if first == {
                    .Integer(value) -> start = value
                    else -> return Err(NixEvalError.TypeMismatch{expected: "integer substring start", actual: first.type_name()})
                }
                if second == {
                    .Integer(value) -> length = value
                    else -> return Err(NixEvalError.TypeMismatch{expected: "integer substring length", actual: second.type_name()})
                }
                subject_value :: self.force(arguments[2])
                subject :: subject_value.stringify()
                if start < 0 -> return Err(NixEvalError.Invalid("negative start position in substring"))
                bytes :: subject.value.bytes()
                output := [U8]{}
                position := 0
                scalar := 0
                loop position < bytes.len() {
                    width :: nixeval_scalar_width(bytes, position)
                    if scalar >= start && (length < 0 || scalar < start + length) {
                        loop offset in 0..<width -> output.push(bytes[position + offset])
                    }
                    position += width
                    scalar += 1
                }
                return Ok(NixEvalText{value: String.from_bytes(output) ?? "", contexts: subject.contexts}.into_value())
            }
        }
    }

    fn string_list(&self, value: NixEvalValue) -> [String] !NixEvalError {
        items := [Int]{}
        if value == {
            .List(values) -> items = values
            else -> return Err(NixEvalError.TypeMismatch{expected: "string list", actual: value.type_name()})
        }
        strings := [String]{}
        loop item in items {
            forced :: self.force(item)
            strings.push(forced.plain_string())
        }
        Ok(strings)
    }

    fn apply_fetch(&self, fetcher: NixEvalFetcher, argument: NixEvalValue) -> NixEvalValue !NixEvalError {
        fields := [String: Int]{}
        if argument == {
            .AttrSet(values) -> fields = values
            else -> return Err(NixEvalError.TypeMismatch{expected: "fixed-output fetcher attribute set", actual: argument.type_name()})
        }
        if self.authority == None -> return Err(NixEvalError.Unsupported("fixed-output fetchers require explicit fetch authority and verified bytes"))
        url := ""
        url_value :: self.field_value(fields, "url")
        if url_value == {
            .Val(value) -> url = value.plain_string()
            else -> {
                uri_value :: self.field_value(fields, "uri")
                uri :: uri_value ?? return Err(NixEvalError.Missing("url"))
                url = uri.plain_string()
            }
        }
        hash := ""
        found := false
        hash_fields :: [String]{"hash", "sha256", "narHash"}
        loop field in hash_fields {
            hash_value :: self.field_value(fields, field)
            if hash_value == {
                .Val(value) -> {
                    hash = value.plain_string()
                    found = true
                    break
                }
                else -> {}
            }
        }
        if !found -> return Err(NixEvalError.Unsupported("fixed-output fetchers require a declared hash"))
        name := ""
        name_value :: self.field_value(fields, "name")
        if name_value == {
            .Val(value) -> name = value.plain_string()
            else -> name = nixeval_fetch_name(url)
        }
        revision := ""
        rev_value :: self.field_value(fields, "rev")
        if rev_value == {
            .Val(value) -> revision = value.plain_string()
            else -> {
                ref_value :: self.field_value(fields, "ref")
                if ref_value == {
                    .Val(value) -> revision = value.plain_string()
                    else -> {}
                }
            }
        }
        request_fields :: [String]{~url, ~hash, ~name, ~revision}
        loop value in request_fields {
            if value.bytes().len() > @NIXEVAL_MAX_PATH_BYTES || nixeval_contains_byte(value, 0) || nixeval_contains_byte(value, 10) {
                return Err(NixEvalError.ResourceLimit("fixed-output fetcher authority request is too large"))
            }
        }
        kind :: fetcher.name()
        path := ""
        if self.ask("@fetch:{kind}\n{url}\n{hash}\n{name}\n{revision}") == {
            .Ok(answer) -> path = answer
            .Err(denial) -> return Err(NixEvalError.Unsupported("fixed-output fetcher {kind} was denied by explicit fetch authority: {denial.message()}"))
        }
        if !nixeval_is_store_path(path) -> return Err(NixEvalError.Invalid("fixed-output fetch authority returned a non-store path"))
        Ok(NixEvalValue.Contextual{value: ~path, contexts: [String]{"path:{path}"}})
    }
}

// The last non-empty path segment of a URL without query or fragment.
fn nixeval_fetch_name(url: String) -> String !Never {
    bytes :: url.bytes()
    end := bytes.len()
    query :: nixeval_first_byte(bytes, 63)
    if query >= 0 -> end = query
    fragment :: nixeval_first_byte(nixeval_slice(bytes, 0, end).bytes(), 35)
    if fragment >= 0 -> end = fragment
    stop := end
    index := end - 1
    loop index >= -1 {
        if index < 0 || Int.from_u8(bytes[index]) == 47 {
            if stop > index + 1 -> return nixeval_slice(bytes, index + 1, stop)
            stop = index
        }
        index -= 1
    }
    "source"
}
