// Rust: crates/jetpack/src/Store/Broker.rs:2137
// Replace Broker.jet161: retain saturating timestamp and conditional Unix arm.
#Test("stale_incoming_cleanup_removes_old_stages_and_rejects_symlinks") {
    root :: env.temp_dir().join("jet-shared-store-incoming-{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root.join("old-stage")) ?? panic("old stage")
    fs.create_dir_all(root.join("fresh-stage")) ?? panic("fresh stage")
    now :: store_broker_now_secs()
    old :: now.saturating_sub(STORE_BROKER_INCOMING_STALE_AFTER_SECS + 1)
    fs.write(root.join("old-stage").join(STORE_BROKER_STAGE_MARKER), old.to_string()) ?? panic("old marker")
    fs.write(root.join("fresh-stage").join(STORE_BROKER_STAGE_MARKER), now.to_string()) ?? panic("fresh marker")
    removed :: store_broker_sweep_stale_incoming_at(root, now) ?? panic("sweep")
    assert_eq(removed, 1)
    assert(!root.join("old-stage").exists())
    assert(root.join("fresh-stage").exists())
    // GATE #4483: preserve Unix-only symlink assertion on selected target.
    if core.sys.target.selected_family() == "unix" {
        std.os.unix.fs.symlink(root.join("fresh-stage"), root.join("link")) ?? panic("symlink")
        assert(store_broker_sweep_stale_incoming_at(root, store_broker_now_secs()) == .Err(_))
    }
    _ :: fs.remove_dir_all(root)
}

// Rust: crates/jetpack/src/Store/Broker.rs:2608
// Replace Broker.jet381: do not suppress all spawn errors or wait forever on
// accept when a child succeeds without connecting.
#Test("linux_peer_credentials_prove_namespace_uid_is_not_socket_mode") {
    if core.sys.target.selected_os() != "linux" -> return // GATE #4483
    socket :: env.temp_dir().join("jet-shared-store-peer-{process.id()}")
    _ :: fs.remove_file(socket)
    listener :: UnixListener.bind(socket) ?? panic("bind")
    listener.set_nonblocking(true) ?? panic("nonblocking")
    spawned :: process.Command.new("unshare")
        .args([String]{"--user", "--map-users=100000,0,1", "--map-groups=100000,0,1", "--"})
        .arg(env.current_exe() ?? panic("current executable"))
        .args([String]{"--exact", "broker_peer_probe_child", "--nocapture"})
        .env("JET_BROKER_PROBE_SOCKET", socket)
        .spawn()
    child := if spawned == {
        .Ok(child) -> child
        .Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound { // GATE #4409
                print("skipping namespace UID proof: unshare is unavailable ({error})")
                _ :: fs.remove_file(socket)
                return
            }
            panic("spawn unshare for peer proof: {error}")
        }
    }
    deadline :: time.Instant.now() + time.Duration.from_secs(5)
    accepted := UnixStream?{None}
    loop time.Instant.now() < deadline {
        if listener.accept() == {
            .Ok((stream, _)) -> {
                accepted = Val(^stream)
                break
            }
            .Err(error) -> {
                if error.kind() == io.ErrorKind.WouldBlock {
                    thread.sleep(time.Duration.from_millis(10))
                } else {
                    panic("peer proof listener failed: {error}")
                }
            }
        }
    }
    status :: &child.wait() ?? panic("wait")
    stream :: accepted ?? {
        if !status.success() {
            print("skipping namespace UID proof: unshare could not create the user namespace ({status})")
            _ :: fs.remove_file(socket)
            return
        }
        panic("native peer-credential proof did not connect")
    }
    uid :: peer_uid(&stream) ?? panic("peer uid")
    assert(status.success(), "peer probe failed: {status}")
    current :: store_broker_current_uid() ?? panic("current uid")
    if uid == current {
        print("skipping namespace UID proof: peer UID {uid} equals current UID {current}")
        ^stream.close()
        _ :: UnixStream.connect(socket)
        _ :: fs.remove_file(socket)
        return
    }
    assert(uid != current)
    ^stream.close()
    _ :: UnixStream.connect(socket)
    _ :: fs.remove_file(socket)
}

// Rust: crates/jetpack/src/Store/Broker.rs:2684
// Replace Broker.jet372: native OS path environment variable, Linux only.
#Test("broker_peer_probe_child") {
    if core.sys.target.selected_os() != "linux" -> return // GATE #4483
    socket :: env.var_os("JET_BROKER_PROBE_SOCKET") ?? return
    stream :: UnixStream.connect(OSPath.from(socket)) ?? panic("connect")
    ^stream.close()
}
