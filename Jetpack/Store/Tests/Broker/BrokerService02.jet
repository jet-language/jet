// Rust: crates/jetpack/src/Store/Broker.rs:1860
// test_binding -> Tests/Broker.jet4 store_broker_test_binding, all eight facts.
// Rust: crates/jetpack/src/Store/Broker.rs:1874
fn short_test_root(tag: String) -> OSPath {
    // GATE #4494: native PID and epoch nanoseconds; exact U128 suffix.
    nanos :: if time.SystemTime.now().duration_since(time.UNIX_EPOCH) == {
        .Ok(duration) -> duration.as_nanos()
        .Err(_) -> 0
    }
    OSPath.from("/tmp").join("jet-{tag}-{process.id()}-{nanos}")
}
// Rust: crates/jetpack/src/Store/Broker.rs:1886
// configure_test_broker -> Tests/Broker.jet10 store_broker_test_configure:
