// Rust: crates/jetpack/src/Store/Broker.rs:1927
fn accept_with_timeout(listener: &UnixListener) -> UnixStream {
    // GATE #4494: nonblocking native accept, monotonic deadline and sleep.
    deadline :: time.Instant.now() + time.Duration.from_secs(5)
    loop {
        if listener.accept() == {
            .Ok((stream, _)) -> return stream
            .Err(error) -> {
                // GATE #4409: only WouldBlock is retried, only before deadline.
                if error.kind() == io.ErrorKind.WouldBlock && time.Instant.now() < deadline {
                    thread.sleep(time.Duration.from_millis(1))
                } else {
                    panic("shared-store broker request did not arrive: {error}")
                }
            }
        }
    }
}

