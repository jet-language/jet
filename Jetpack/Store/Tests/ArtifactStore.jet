// The previous build-record schema (tests/fixtures/build-metadata-compat/build-record-v0.json).
@STORE_ARTIFACT_TEST_BUILD_RECORD_V0 :: `{"schema":"jet.build-record/v0","program":"main.jet","nodes":[{"kind":"check","key":"0e40789b60214972cb731d97fc32a472e1f054759cb0c4dcd01cdf74f8d0ea67","subject":"main.jet","duration_ms":0,"why_ran":"first-run","inputs":["main.jet"]},{"kind":"compile","key":"5f47f088c0aede64d6e43bcecdbde05830885f38d531f2c82ad91850d186a6ca","subject":"main","duration_ms":9030.391929,"why_ran":"first-run","inputs":["check:main.jet"]},{"kind":"link","key":"1ed86259bc7ec780692d7dd13bcd44758d55b8922685a706f397c46dd600b62c","subject":"main","duration_ms":0,"why_ran":"first-run","inputs":["compile:main"]}]}`

#Test("artifact store previous store and build record fixtures fail closed") {
    action :: ActionHandle.from_key("build-metadata-compat")
    if store_artifact_decode_action(action, store_artifact_test_store_v0_fixture()) == {
        .Ok(_) -> panic("previous store schema must be rejected")
        .Err(error) -> assert_eq(error.reason, "action record has an unknown version or short header")
    }
    if BuildRecord.from_json(@STORE_ARTIFACT_TEST_BUILD_RECORD_V0) == {
        .Ok(_) -> panic("previous build-record schema must be rejected")
        .Err(error) -> assert_eq(error.reason, "unsupported build record schema `jet.build-record/v0`")
    }
}
