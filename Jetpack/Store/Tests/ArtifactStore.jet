STORE_ARTIFACT_TEST_BUILD_RECORD_V0 :: prep { `{"schema":"jet.build-record/v0","program":"main.jet","nodes":[{"kind":"check","key":"0e40789b60214972cb731d97fc32a472e1f054759cb0c4dcd01cdf74f8d0ea67","subject":"main.jet","duration_ms":0,"why_ran":"first-run","inputs":["main.jet"]},{"kind":"compile","key":"5f47f088c0aede64d6e43bcecdbde05830885f38d531f2c82ad91850d186a6ca","subject":"main","duration_ms":9030.391929,"why_ran":"first-run","inputs":["check:main.jet"]},{"kind":"link","key":"1ed86259bc7ec780692d7dd13bcd44758d55b8922685a706f397c46dd600b62c","subject":"main","duration_ms":0,"why_ran":"first-run","inputs":["compile:main"]}]}` }

#Test("artifact store previous store and build record fixtures fail closed") {
    action :: ActionHandle.from_key("build-metadata-compat")
    if store_artifact_decode_action(action, store_artifact_test_store_v0_fixture()) == {
        .Ok(_) -> panic("previous store schema must be rejected")
        .Err(error) -> assert_eq(error.reason, "action record has an unknown version or short header")
    }
    if BuildRecord.from_json(STORE_ARTIFACT_TEST_BUILD_RECORD_V0) == {
        .Ok(_) -> panic("previous build-record schema must be rejected")
        .Err(error) -> assert_eq(error.reason, "unsupported build record schema `jet.build-record/v0`")
    }
}

// Backing-field migration regression: public Rust accessor APIs stay intact.
#Test("artifact store handle accessors preserve canonical identities") {
    hex :: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    digest :: ArtifactDigest.from_hex(hex) ?? panic("valid digest")
    object :: ObjectHandle.new(digest, 42)
    assert_eq(object.digest(), digest)
    assert_eq(object.length(), 42)
    assert_eq(object.key(), hex)
    assert_eq(object.text(), "{hex}:42")
    action :: ActionHandle.new(digest)
    assert_eq(action.digest(), digest)
    assert_eq(action.key(), hex)
    namespace :: LTONamespace.new("output-identity") ?? panic("valid namespace")
    assert_eq(namespace.name(), "output-identity")
}

#Test("artifact store configuration builders preserve public accessors and defaults") {
    config :: ArtifactStoreConfig.new("/store")
    assert_eq(config.root(), "/store")
    assert_eq(config.cap_bytes(), None)
    assert_eq(config.reserve_bytes(), STORE_ARTIFACT_DEFAULT_RESERVE_BYTES)
    assert_eq(config.lock_wait().ns, STORE_ARTIFACT_DEFAULT_LOCK_WAIT_MS * 1000000)
    updated :: config.with_cap_bytes(42).with_reserve_bytes(7).with_lock_wait(time.duration_ms(25))
    assert_eq(updated.root(), "/store")
    assert_eq(updated.cap_bytes(), Val(42))
    assert_eq(updated.reserve_bytes(), 7)
    assert_eq(updated.lock_wait().ns, 25000000)
    assert_eq(config.cap_bytes(), None)
    assert_eq(config.reserve_bytes(), STORE_ARTIFACT_DEFAULT_RESERVE_BYTES)
}

// #4407: the canonical Fixed formatter owns Rust's ties-to-even behavior.
// Do not restore a store-local integer half-up formatter for lock diagnostics.
#Test("artifact store lock duration uses canonical fixed ties to even") {
    error :: ArtifactStoreError.Locked{path: "/store/locks/store.lock", owner_pid: None, elapsed_ns: 62500000}
    assert_eq(error.message(), "store lock is owned by a live process (owner pid unknown) after waiting 0.062s: /store/locks/store.lock")
}

#Test("artifact store process identity accessors preserve owner wire") {
    owner :: ArtifactProcessIdentity.new(123, "start-token")
    assert_eq(owner.pid(), 123)
    assert_eq(owner.start(), "start-token")
    assert_eq(owner.owner_line("lock"), "jet.store.v1|lock|123|start-token\n")
    assert_eq(owner.owner_line("lease"), "jet.store.v1|lease|123|start-token\n")
}

#Test("artifact store build record wire preserves fixed field order and shared quoting") {
    c1 :: String.from_bytes([U8]{127, 194, 133}) ?? panic("valid C1 control scalars")
    c0 :: String.from_bytes([U8]{8, 12}) ?? panic("valid C0 control scalars")
    record :: BuildRecord.new("main\".jet", [BuildNodeRecord]{
        BuildNodeRecord{kind: "check", key: "key", subject: "main.jet", duration_ms: Float{1.5}, why_ran: "line\nnext\t", inputs: [String]{"a\\b", c1, c0}},
        BuildNodeRecord{kind: "link", key: "out", subject: "main", duration_ms: Float{-1.0}, why_ran: "first-run", inputs: [String]{}},
    })
    expected :: `{"schema":"jet.build-record/v1","program":"main\".jet","nodes":[{"kind":"check","key":"key","subject":"main.jet","duration_ms":1.5,"why_ran":"line\nnext\t","inputs":["a\\b","\u007f\u0085","\u0008\u000c"]},{"kind":"link","key":"out","subject":"main","duration_ms":0,"why_ran":"first-run","inputs":[]}]}`
    assert_eq(record.to_json(), expected)
    assert_eq(BuildRecord.new("empty", [BuildNodeRecord]{}).to_json(), `{"schema":"jet.build-record/v1","program":"empty","nodes":[]}`)
    assert_eq(record.program, "main\".jet")
    assert_eq(record.nodes[0].inputs[0], "a\\b")
}

#Test("artifact store build record parser preserves schema and failure domains") {
    record :: BuildRecord.new("main.jet", [BuildNodeRecord]{
        BuildNodeRecord{kind: "check", key: "key", subject: "main.jet", duration_ms: Float{1.5}, why_ran: "first-run", inputs: [String]{"main.jet"}},
    })
    assert_eq(BuildRecord.from_json(record.to_json()) ?? panic("build record round trip"), record)
    if BuildRecord.from_json("not JSON") == {
        .Err(error) -> assert_eq(error.reason, "build record is not valid JSON")
        .Ok(_) -> panic("invalid JSON must fail")
    }
    if BuildRecord.from_json(`{"schema":"jet.build-record/v1","program":"main.jet","nodes":[{"duration_ms":-1}]}`) == {
        .Err(error) -> assert_eq(error.reason, "build record node duration_ms is out of range")
        .Ok(_) -> panic("negative duration must fail")
    }
}

#Test("artifact store build record empty wire is byte exact") {
    assert_eq(BuildRecord.new("empty", [BuildNodeRecord]{}).to_json(), `{"schema":"jet.build-record/v1","program":"empty","nodes":[]}`)
}

#Test("artifact store build record fractional wire preserves Foundation escaping and node order") {
    controls :: String.from_bytes([U8]{8, 12, 127, 194, 133}) ?? panic("valid control scalars")
    record :: BuildRecord.new("main\".jet", [BuildNodeRecord]{
        BuildNodeRecord{kind: "check", key: "key", subject: "main.jet", duration_ms: Float{1.5}, why_ran: "line\nnext\t", inputs: [String]{"a\\b", controls}},
        BuildNodeRecord{kind: "compile", key: "out", subject: "main", duration_ms: Float{9030.391929}, why_ran: "first-run", inputs: [String]{}},
    })
    assert_eq(record.to_json(), `{"schema":"jet.build-record/v1","program":"main\".jet","nodes":[{"kind":"check","key":"key","subject":"main.jet","duration_ms":1.5,"why_ran":"line\nnext\t","inputs":["a\\b","\u0008\u000c\u007f\u0085"]},{"kind":"compile","key":"out","subject":"main","duration_ms":9030.391929,"why_ran":"first-run","inputs":[]}]}`)
}
