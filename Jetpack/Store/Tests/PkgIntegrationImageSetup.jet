// Setup for the image cases: executable ingest, with or without a platform.
// CLI assertions live in tests/cases/image. Env-gated; no public API.
// #4838: invoke THIS FILE with --filter, never the directory.
//
// JET_TEST_IMAGE_SETUP names the Hangar root. JET_TEST_IMAGE_EXECUTABLES lists
// `name reference binary [platform]` entries separated by `;`; each becomes a
// real Store ingest of one `bin/<binary>` shell script, platform defaulting to
// the host's.
store_image_ingest_executable: fn(verification: &StoreVerification, roots: HangarRoots, name: String, reference: String, binary: String, platform: String) {
    source: files.join(roots.root, "source-{name}")
    script: files.join(files.join(source, "bin"), binary)
    files.create_dir_all(files.dirname(script)) ?? panic("image executable bin")
    files.write(script, "#!/bin/sh\necho image\n") ?? panic("image executable")
    if sys.family() != "windows" -> files.chmod(script, 0o755) ?? panic("image executable mode")
    request: IngestRequest{name: name, version: "1.0.0", reference: reference, cache_identity: CacheIdentity{source_fingerprint: "sha256-source-{name}", recipe_fingerprint: "sha256-recipe-{name}", policy_fingerprint: "policy=image-test", platform: platform}, references: [String]{}, outputs: [String:String]{"out": source}, signature: "", provenance: "image-test", platform_artifact_kind: ""}
    _: store_ingest_tree(verification, roots, request) ?? panic("real image ingest")
}
store_image_setup: fn() {
    root: sys.get("JET_TEST_IMAGE_SETUP") ?? return
    entries: sys.get("JET_TEST_IMAGE_EXECUTABLES") ?? panic("image executables")
    roots: HangarRoots{root: root, dev_mode: false}
    verification := StoreVerification.new()
    loop entry in entries.split(";") {
        words: entry.trim().split(" ").to_list()
        if words.len() != 3 && words.len() != 4 -> panic("image executable entry: {entry}")
        platform: if words.len() == 4 -> words[3].copy() else -> pkg_host_platform()
        store_image_ingest_executable(verification, roots, words[0].copy(), words[1].copy(), words[2].copy(), platform)
    }
}
#Test("S3 image authentic fixture setup") {
    store_image_setup()
}
