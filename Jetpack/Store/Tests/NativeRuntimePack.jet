// Wire/provenance/store claims use small explicit fixture bytes. They do not
// claim that the E2 runtime rail, candidate, native pack or #4896 seam ran.

fn native_pack_test_roles(object: ObjectHandle) -> [NativeRuntimeRoleObject] Never! {
    [NativeRuntimeRoleObject]{NativeRuntimeRoleObject{role: "provider-é", object}}
}

fn native_pack_test_subject(object: ObjectHandle) -> NativeRuntimePackSubject Never! {
    NativeRuntimePackSubject{
        runtime_source_revision: "0000000000000000000000000000000000000000",
        runtime_source_tree: "1111111111111111111111111111111111111111",
        pack_object: object, jet_object: object, remaining_native_archive: object, remaining_raw_leaf_archive: object,
        runtime_sources: object, runtime_exports: object, runtime_imports: object, lifecycle: object,
        generators: native_pack_test_roles(object), abi: native_pack_test_roles(object),
        routes: native_pack_test_roles(object), providers: native_pack_test_roles(object),
    }
}

fn native_pack_test_refused(bytes: [U8]) -> Bool {
    if NativeRuntimePackIdentity.from_bytes(bytes) == {
        .Err(_) -> true
        .Ok(_) -> false
    }
}

#Test("native runtime identity canonical exact large length") {
    object :: ObjectHandle.new(ArtifactDigest.hash("é".bytes()), 9007199254740993)
    identity :: NativeRuntimePackIdentity{subject: object, approval: object}
    bytes :: identity.to_bytes() ?? panic("canonical identity")
    assert_eq(NativeRuntimePackIdentity.from_bytes(bytes) ?? panic("decode"), identity)
    text :: String.from_bytes(bytes) ?? panic("UTF-8")
    assert(text.contains(":9007199254740993"), "length is an exact string, never a JSON number")
    assert(native_pack_test_refused("{{ \"schema\":\"jet.native-runtime-pack-identity/v1\" }}".bytes()))
    assert(native_pack_test_refused("{{\"schema\":\"x\",\"schema\":\"x\"}}".bytes()))
}

#Test("native runtime handles refuse aliases signs and bad fields") {
    digest :: ArtifactDigest.hash("fixture".bytes()).to_hex()
    loop length in ([String]{"", "-1", "+1", "01", "1.0", "18446744073709551616"}) {
        if native_pack_handle("{digest}:{length}") == {
            .Ok(_) -> panic("noncanonical handle accepted")
            .Err(_) -> {}
        }
    }
    if native_pack_handle("{digest}:18446744073709551615") == {
        .Ok(value) -> assert_eq(value.length(), STORE_ARTIFACT_U64_MAX)
        .Err(_) -> panic("full unsigned length rejected")
    }
    tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-pack-identity/v1"), "subject": DataTree.Text("{digest}:1"), "approval": DataTree.Text("{digest}:1"), "path": DataTree.Text("native.key")})
    assert(native_pack_test_refused(native_pack_encode(tree) ?? panic("encode")))
}

#Test("native runtime subject roles are unique and byte canonical") {
    object :: ObjectHandle.from_bytes("fixture".bytes())
    subject :: native_pack_test_subject(object)
    bytes :: subject.to_bytes() ?? panic("encode subject")
    assert_eq(NativeRuntimePackSubject.from_bytes(bytes) ?? panic("decode subject"), subject)
    fields := if subject.to_tree() == {
        .Object(values) -> values
        else -> { panic("subject object") }
    }
    fields["providers"] = native_pack_roles_tree([NativeRuntimeRoleObject]{subject.providers[0], subject.providers[0]})
    if NativeRuntimePackSubject.from_tree(DataTree.Object(fields)) == {
        .Ok(_) -> panic("duplicate provider accepted")
        .Err(_) -> {}
    }
}

fn native_pack_test_receipt(store: ArtifactStore, id: String, invocation: ObjectHandle, inputs: [NativeRuntimeRoleObject], outputs: [NativeRuntimeRoleObject]) -[FS, Env, Exec, Time, Rand]> NativeRuntimeObservedStep {
    log :: store.publish_blob("small codec fixture log\n".bytes()) ?? panic("log")
    tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-step-receipt/v1"), "id": DataTree.Text(id), "rc": DataTree.Text("0"), "invocation": native_pack_handle_tree(invocation), "inputs": native_pack_roles_tree(inputs), "outputs": native_pack_roles_tree(outputs), "log": native_pack_handle_tree(log)})
    receipt :: store.publish_blob(native_pack_encode(tree) ?? panic("receipt codec")) ?? panic("receipt")
    NativeRuntimeObservedStep{id, observed_rc: "0", invocation, inputs, outputs, receipt}
}

fn native_pack_test_lifecycle_entry(symbol: String, phase: String, priority: String, section: String, provider: ObjectHandle) -> DataTree {
    DataTree.Object([String: DataTree]{"symbol": DataTree.Text(symbol), "phase": DataTree.Text(phase), "priority": DataTree.Text(priority), "section": DataTree.Text(section), "provider": native_pack_handle_tree(provider)})
}

fn native_pack_test_lifecycle(store: ArtifactStore, object: ObjectHandle) -[FS, Env, Exec, Time, Rand]> ObjectHandle {
    // Schema fixtures only; these blobs are deliberately not real ELF evidence.
    sections :: store.publish_blob("unit fixture sections, not ELF".bytes()) ?? panic("sections")
    relocations :: store.publish_blob("unit fixture relocations, not ELF".bytes()) ?? panic("relocations")
    entries :: [DataTree]{
        native_pack_test_lifecycle_entry("jet_rt_alloc_init", "init", "0", ".init_array.00000", object),
        native_pack_test_lifecycle_entry("jet_rt_host_init", "init", "1", ".init_array.00001", object),
        native_pack_test_lifecycle_entry("jet_rt_stdout_flush", "fini", "1", ".fini_array.00001", object),
    }
    tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-lifecycle-evidence/v1"), "pack": native_pack_handle_tree(object), "jet_object": native_pack_handle_tree(object), "entries": DataTree.Array(entries), "sections": native_pack_handle_tree(sections), "relocations": native_pack_handle_tree(relocations)})
    store.publish_blob(native_pack_encode(tree) ?? panic("lifecycle codec")) ?? panic("lifecycle fixture")
}

fn native_pack_test_fixture(store: ArtifactStore, payload: String) -[FS, Env, Exec, Time, Rand]> (subject: NativeRuntimePackSubject, evidence: NativeRuntimePackEvidence, compiler: ObjectHandle) {
    object :: store.publish_blob(payload.bytes()) ?? panic("object")
    compiler :: store.publish_blob("compiler object fixture".bytes()) ?? panic("compiler")
    invocation :: store.publish_blob("exact fixture invocation\n".bytes()) ?? panic("invocation")
    job :: store.publish_blob("exact fixture job\n".bytes()) ?? panic("job")
    generation :: store.publish_blob("{{\"final\":\"0000000000000000000000000000000000000000\",\"deterministic\":true}}".bytes()) ?? panic("generation")
    raw_frontend :: store.publish_blob("{{\"raw_exit\":101}}".bytes()) ?? panic("raw frontend")
    final_source_tree :: store.publish_blob("1111111111111111111111111111111111111111\n".bytes()) ?? panic("final tree")
    known :: DataTree.Object([String: DataTree]{"role": DataTree.Text("provider-é"), "source": DataTree.Object([String: DataTree]{"kind": DataTree.Text("known"), "object": native_pack_handle_tree(object)})})
    produced :: DataTree.Object([String: DataTree]{"role": DataTree.Text("pack-input"), "source": DataTree.Object([String: DataTree]{"kind": DataTree.Text("produced"), "step": DataTree.Text("build"), "output": DataTree.Text("pack")})})
    build :: DataTree.Object([String: DataTree]{"id": DataTree.Text("build"), "expected_rc": DataTree.Text("0"), "invocation": native_pack_handle_tree(invocation), "inputs": DataTree.Array([DataTree]{known}), "outputs": DataTree.Array([DataTree]{DataTree.Text("pack"), DataTree.Text("generation"), DataTree.Text("raw_frontend"), DataTree.Text("final_source_tree")})})
    consume :: DataTree.Object([String: DataTree]{"id": DataTree.Text("consume"), "expected_rc": DataTree.Text("0"), "invocation": native_pack_handle_tree(invocation), "inputs": DataTree.Array([DataTree]{produced}), "outputs": DataTree.Array([DataTree]{})})
    artifacts := [DataTree]{}
    loop role in ([String]{"pack_object", "jet_object", "remaining_native_archive", "remaining_raw_leaf_archive", "runtime_sources", "runtime_exports", "runtime_imports"}) {
        &artifacts.push(DataTree.Object([String: DataTree]{"role": DataTree.Text(role), "source": DataTree.Object([String: DataTree]{"kind": DataTree.Text("produced"), "step": DataTree.Text("build"), "output": DataTree.Text("pack")})}))
    }
    evidence_roles := [DataTree]{}
    loop role in ([String]{"generation", "raw_frontend", "final_source_tree"}) {
        &evidence_roles.push(DataTree.Object([String: DataTree]{"role": DataTree.Text(role), "source": DataTree.Object([String: DataTree]{"kind": DataTree.Text("produced"), "step": DataTree.Text("build"), "output": DataTree.Text(role)})}))
    }
    contract_tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-rail-contract/v1"), "job": native_pack_handle_tree(job), "proofq_name": DataTree.Text("unit-codec-fixture"), "steps": DataTree.Array([DataTree]{build, consume}), "artifacts": DataTree.Array(artifacts), "evidence": DataTree.Array(evidence_roles), "generators": DataTree.Array([DataTree]{known}), "abi": DataTree.Array([DataTree]{known}), "routes": DataTree.Array([DataTree]{known}), "providers": DataTree.Array([DataTree]{known})})
    rail_contract :: store.publish_blob(native_pack_encode(contract_tree) ?? panic("contract codec")) ?? panic("contract")
    admission_tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-rail-admission/v1"), "decision": DataTree.Text("approved"), "job": native_pack_handle_tree(job), "rail_contract": native_pack_handle_tree(rail_contract)})
    admission :: store.publish_blob(native_pack_encode(admission_tree) ?? panic("admission codec")) ?? panic("admission")
    proof_done :: store.publish_blob("0\n".bytes()) ?? panic("done")
    first :: native_pack_test_receipt(store, "build", invocation, [NativeRuntimeRoleObject]{NativeRuntimeRoleObject{role: "provider-é", object}}, [NativeRuntimeRoleObject]{NativeRuntimeRoleObject{role: "pack", object}, NativeRuntimeRoleObject{role: "generation", object: generation}, NativeRuntimeRoleObject{role: "raw_frontend", object: raw_frontend}, NativeRuntimeRoleObject{role: "final_source_tree", object: final_source_tree}})
    second :: native_pack_test_receipt(store, "consume", invocation, [NativeRuntimeRoleObject]{NativeRuntimeRoleObject{role: "pack-input", object}}, [NativeRuntimeRoleObject]{})
    metadata :: store.publish_blob("name=unit-codec-fixture\nrc=0\nstart=10\nend=11\nkind=test\n".bytes()) ?? panic("metadata fixture")
    terminal :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-proofq-terminal/v1"), "job": native_pack_handle_tree(job), "rail_contract": native_pack_handle_tree(rail_contract), "done": native_pack_handle_tree(proof_done), "proofq_metadata": native_pack_handle_tree(metadata), "proofq_name": DataTree.Text("unit-codec-fixture"), "runtime_source_revision": DataTree.Text("0000000000000000000000000000000000000000"), "runtime_source_tree": DataTree.Text("1111111111111111111111111111111111111111")})
    proof_terminal :: store.publish_blob(native_pack_encode(terminal) ?? panic("terminal codec")) ?? panic("terminal fixture")
    evidence :: NativeRuntimePackEvidence{admission, rail_contract, job, proof_done, proof_terminal, final_source_tree, generation, raw_frontend, steps: [NativeRuntimeObservedStep]{first, second}}
    subject := native_pack_test_subject(object)
    subject.lifecycle = native_pack_test_lifecycle(store, object)
    (subject: subject, evidence: evidence, compiler: compiler)
}

fn native_pack_test_authorize(store: ArtifactStore, subject: ObjectHandle, evidence: NativeRuntimePackEvidence) -[FS, Env, Exec, Time, Rand]> ObjectHandle {
    tree :: DataTree.Object([String: DataTree]{"schema": DataTree.Text("jet.native-runtime-publication-authorization/v1"), "decision": DataTree.Text("approved"), "subject": native_pack_handle_tree(subject), "rail_contract": native_pack_handle_tree(evidence.rail_contract), "admission": native_pack_handle_tree(evidence.admission)})
    store.publish_blob(native_pack_encode(tree) ?? panic("authorization codec")) ?? panic("fixture authorization")
}

#Test("native runtime preparation authorization publication and immutable compiler binding") {
    root :: store_artifact_test_root("native-pack")
    store :: store_artifact_test_store(root, 1024 * 1024)
    fixture :: native_pack_test_fixture(store, "small codec fixture bytes")
    prepared :: native_runtime_pack_prepare(store, fixture.subject, fixture.evidence) ?? panic("prepare")
    if store.lookup_artifact(NativeCandidateComposition.action_key(fixture.compiler)) == {
        .Missing -> {}
        else -> panic("preparation published a candidate")
    }
    authorization :: native_pack_test_authorize(store, prepared, fixture.evidence)
    approval :: fixture.evidence.approval(prepared, authorization)
    published :: native_runtime_pack_publish(store, fixture.subject, approval, fixture.compiler) ?? panic("publish")
    repeated :: native_runtime_pack_publish(store, fixture.subject, approval, fixture.compiler) ?? panic("idempotent publish")
    assert_eq(published.object, repeated.object)
    loaded :: native_runtime_pack_load(store, fixture.compiler) ?? panic("verified loader")
    assert_eq(loaded.subject, fixture.subject)
    assert_eq(loaded.pack_bytes, "small codec fixture bytes".bytes())
    assert_eq(native_pack_blob(store, fixture.evidence.raw_frontend) ?? panic("raw status"), "{{\"raw_exit\":101}}".bytes())
    changed := fixture.subject
    changed.pack_object = store.publish_blob("unadmitted unrelated pack".bytes()) ?? panic("unrelated pack")
    if native_runtime_pack_prepare(store, changed, fixture.evidence) == {
        .Ok(_) -> panic("unrelated CAS pack bypassed admitted producer")
        .Err(_) -> {}
    }
    next_fixture :: native_pack_test_fixture(store, "different approved pack")
    next :: native_runtime_pack_prepare(store, next_fixture.subject, next_fixture.evidence) ?? panic("new subject")
    next_authorization :: native_pack_test_authorize(store, next, next_fixture.evidence)
    if native_runtime_pack_publish(store, next_fixture.subject, next_fixture.evidence.approval(next, next_authorization), fixture.compiler) == {
        .Ok(_) -> panic("different runtime replaced immutable compiler binding")
        .Err(error) -> {
            if error == {
                .Store(store_error) -> assert_eq(store_artifact_test_kind(store_error), "conflict")
                else -> panic("wrong conflict error")
            }
        }
    }
    files.write_bytes(store.object_path(fixture.subject.pack_object), "corrupt".bytes()) ?? panic("corrupt")
    if native_runtime_pack_load(store, fixture.compiler) == {
        .Ok(_) -> panic("corrupt pack loaded")
        .Err(_) -> {}
    }
    store_artifact_test_cleanup(root)
}

#Test("native runtime rejects red incomplete reordered and changed producer bytes") {
    root :: store_artifact_test_root("native-pack-negative")
    store :: store_artifact_test_store(root, 1024 * 1024)
    fixture :: native_pack_test_fixture(store, "small codec fixture bytes")
    loop rc in ([String]{"1\n", "125\n", "", "0"}) {
        red := fixture.evidence
        red.proof_done = store.publish_blob(rc.bytes()) ?? panic("red done")
        if native_runtime_pack_prepare(store, fixture.subject, red) == {
            .Ok(_) -> panic("red or nonterminal done admitted")
            .Err(_) -> {}
        }
    }
    changed := fixture.evidence
    step := changed.steps[1]
    step.inputs = [NativeRuntimeRoleObject]{NativeRuntimeRoleObject{role: "pack-input", object: fixture.compiler}}
    changed.steps = [NativeRuntimeObservedStep]{changed.steps[0], step}
    if native_runtime_pack_prepare(store, fixture.subject, changed) == {
        .Ok(_) -> panic("consumer differs from actual producer")
        .Err(_) -> {}
    }
    changed.steps = [NativeRuntimeObservedStep]{fixture.evidence.steps[1], fixture.evidence.steps[0]}
    if native_runtime_pack_prepare(store, fixture.subject, changed) == {
        .Ok(_) -> panic("reordered rail admitted")
        .Err(_) -> {}
    }
    changed.steps = [NativeRuntimeObservedStep]{fixture.evidence.steps[0]}
    if native_runtime_pack_prepare(store, fixture.subject, changed) == {
        .Ok(_) -> panic("incomplete rail admitted")
        .Err(_) -> {}
    }
    wrong_generation := fixture.evidence
    wrong_generation.generation = store.publish_blob("{{\"final\":\"1111111111111111111111111111111111111111\",\"deterministic\":true}}".bytes()) ?? panic("wrong final")
    if native_runtime_pack_prepare(store, fixture.subject, wrong_generation) == {
        .Ok(_) -> panic("wrong runtime FINAL admitted")
        .Err(_) -> {}
    }
    prepared :: native_runtime_pack_prepare(store, fixture.subject, fixture.evidence) ?? panic("prepare")
    wrong_subject :: native_pack_test_authorize(store, fixture.compiler, fixture.evidence)
    if native_runtime_pack_publish(store, fixture.subject, fixture.evidence.approval(prepared, wrong_subject), fixture.compiler) == {
        .Ok(_) -> panic("authorization for another subject admitted")
        .Err(_) -> {}
    }
    wrong_lifecycle := fixture.subject
    wrong_lifecycle.lifecycle = native_pack_test_lifecycle(store, fixture.compiler)
    if native_runtime_pack_prepare(store, wrong_lifecycle, fixture.evidence) == {
        .Ok(_) -> panic("lifecycle inspection for another object admitted")
        .Err(_) -> {}
    }
    store_artifact_test_cleanup(root)
}

#Test("native runtime rail refuses future cyclic and missing outputs") {
    root :: store_artifact_test_root("native-pack-reference")
    store :: store_artifact_test_store(root, 1024 * 1024)
    fixture :: native_pack_test_fixture(store, "small codec fixture bytes")
    contract :: NativeRuntimeRailContract.from_bytes(native_pack_blob(store, fixture.evidence.rail_contract) ?? panic("contract")) ?? panic("decode")
    produced := [String: [String]]{}
    loop pair in ([String]{"future", "build"}) {
        input :: DataTree.Object([String: DataTree]{"role": DataTree.Text("x"), "source": DataTree.Object([String: DataTree]{"kind": DataTree.Text("produced"), "step": DataTree.Text(pair), "output": DataTree.Text("missing")})})
        fields :: [String: DataTree]{"inputs": DataTree.Array([DataTree]{input})}
        if native_pack_rail_inputs(fields, "inputs", produced) == {
            .Ok(_) -> panic("unresolved producer accepted")
            .Err(_) -> {}
        }
        &produced.add("build", contract.steps[0].outputs).drop("first insertion or deliberately unchanged")
    }
    store_artifact_test_cleanup(root)
}

#Test("native runtime lifecycle section refuses padding priority and suffix aliases") {
    root :: store_artifact_test_root("native-pack-lifecycle")
    store :: store_artifact_test_store(root, 1024 * 1024)
    fixture :: native_pack_test_fixture(store, "small codec fixture bytes")
    tree :: native_pack_input_tree(native_pack_blob(store, fixture.subject.lifecycle) ?? panic("lifecycle bytes")) ?? panic("lifecycle tree")
    loop spelling in ([String]{".init_array.0", ".init_array.00001", ".init_array.00000.extra", ".init_array.000000", ".init_array. 00000"}) {
        fields := native_pack_fields(tree, [String]{"schema", "pack", "jet_object", "entries", "sections", "relocations"}) ?? panic("lifecycle fields")
        entries := native_pack_array_field(fields, "entries") ?? panic("entries")
        entry := native_pack_fields(entries[0], [String]{"symbol", "phase", "priority", "provider", "section"}) ?? panic("entry")
        entry["section"] = DataTree.Text(spelling)
        entries[0] = DataTree.Object(entry)
        fields["entries"] = DataTree.Array(entries)
        changed := fixture.subject
        changed.lifecycle = store.publish_blob(native_pack_encode(DataTree.Object(fields)) ?? panic("alias codec")) ?? panic("alias fixture")
        if native_runtime_pack_prepare(store, changed, fixture.evidence) == {
            .Ok(_) -> panic("noncanonical lifecycle section accepted")
            .Err(_) -> {}
        }
    }
    store_artifact_test_cleanup(root)
}
