// Nix store projection claims.
//
// Not ported here: `nix_projection_runs_in_rootless_namespace_without_host_store`
// and `nix_projection_runs_dynamically_linked_nix_binary_without_host_store`.
// They drive `Shell::run_clean_command` (Environment area, above Store in
// Jetpack/Bootstrap/areas.list) inside the tests/support no-Nix namespace
// harness; they belong with the Environment claims.
use {
    files: core.files
    sys: core.sys
    process: core.process
    time: core.time
    crypto: core.crypto
    base64: core.encoding.base64
    core_web: core.web
}

STORE_TEST_PROJECTION_ROOT: "/nix/store/00000000000000000000000000000000-root"

STORE_TEST_PROJECTION_LEAF: "/nix/store/11111111111111111111111111111111-leaf"

// The admitted entry whose producer records `store_path`.
store_test_find_entry: fn(entries: [StoreEntry], store_path: String) -> StoreEntry Never! {
    loop entry in entries {
        producer: ProducerRecord.decode(entry.producer_record) ?? next
        if producer.facts.get("nix.store-path") == Val((store_path)) -> return entry
    }
    panic("missing admitted Nix entry for {store_path}")
}

// Re-register every admitted record with complete Nix build facts.
store_test_canonicalize_admitted_records: fn(verification: StoreVerification, roots: HangarRoots, admitted: AdmittedNixClosure) -> [StoreEntry] Never! {
    ^canonical: [StoreEntry]{}
    loop original in store_list_checked(verification, roots) ?? panic("listing") {
        ^entry: original
        ^producer: ProducerRecord.decode(entry.producer_record) ?? panic("producer")
        store_path: producer.facts.get("nix.store-path") ?? next
        if !admitted.objects.has_key(store_path) -> next
        loop fact in provider_nix_build_facts_record() -> producer.facts[fact.key] = fact.value
        producer.facts["nix.output.out"] = store_path
        entry.producer_record = producer.encode()
        entry.receipt = ""
        canonical.push(entry)
    }
    store_test_register_canonical(verification, roots, canonical)
    store_list_checked(verification, roots) ?? panic("listing")
}

store_test_register_canonical: fn(verification: StoreVerification, roots: HangarRoots, entries: ^[StoreEntry]) Never! {
    _hangar_lock: env_runtime_lock(roots.root, "hangar") ?? panic("hangar lock")
    loop index in 0..<entries.len() {
        ^entry: entries[index]
        store_prepare_entry_receipt(roots, entry) ?? panic("receipt")
        entries[index] = entry
    }
    store_register_entries_unlocked(verification, roots, entries) ?? panic("register")
}

// One signed standard narinfo for `store_path` over `nar`.
store_test_signed_narinfo: fn(store_path: String, nar_name: String, nar: [U8], references: [String], key_id: String, seed: [U8]) -> String Never! {
    hash: "sha256:{store_sha256_hex(nar)}"
    ^names: [String]{}
    loop reference in references -> names.push(files.basename(reference))
    info: NixNarInfo{
        store_path: store_path,
        url: "nar/{nar_name}",
        compression: NixCompression.Plain,
        file_hash: Val(hash),
        file_size: Val(nar.len()),
        nar_hash: hash,
        nar_size: nar.len(),
        references: names,
        deriver: None,
        ca: None,
        signatures: [NixNarInfoSignature]{},
    }
    fingerprint: info.fingerprint("/nix/store") ?? panic("fingerprint")
    signature: crypto.sign(crypto.SigningKey{bytes: seed}, fingerprint) ?? panic("sign")
    "StorePath: {store_path}\nURL: nar/{nar_name}\nCompression: none\nFileHash: {hash}\nFileSize: {nar.len()}\nNarHash: {hash}\nNarSize: {nar.len()}\nReferences: {names.join(" ")}\nSig: {key_id}:{base64.encode(signature.bytes)}\n"
}

// Serve `routes` (URL path -> body) from a directory over local HTTP; the
// caller shuts the server down with `store_test_stop_cache_server`.
StoreTestCacheServer: struct {
    server: HTTPServer,
    serving: Task<()>,
    endpoint: String,
}

store_test_start_cache_server: fn(roots: HangarRoots, routes: [String:[U8]]) -> StoreTestCacheServer Never! {
    site: files.join(roots.root, "projection-cache-site")
    loop route in routes {
        path: files.join(site, route.key.removeprefix("/"))
        files.create_dir_all(files.dirname(path)) ?? panic("route dir")
        files.write_bytes(path, route.value) ?? panic("route body")
    }
    mux: core_web.app()
    mux.static_files("/", site)
    server: mux.bind("127.0.0.1:0") ?? panic("bind cache server")
    address: server.local_addr() ?? panic("cache server address")
    serving: task {
        _: server.serve() ?? panic("serve")
    }
    time.sleep(time.duration_ms(20))
    StoreTestCacheServer{server: server, serving: serving, endpoint: "http://{address}"}
}

store_test_stop_cache_server: fn(cache: ^^StoreTestCacheServer) Never! {
    _: cache.server.shutdown(time.duration_ms(100)) ?? panic("shutdown")
    cache.serving.join() ?? panic("server task")
}

// Admit the two-object signed closure (`root` references `leaf`) through
// the standard Nix cache endpoint.
store_test_admit_signed_closure: fn(verification: StoreVerification, roots: HangarRoots) -> AdmittedNixClosure Never! {
    source: files.join(roots.root, "nix-projection-source")
    files.create_dir_all(files.join(source, "root/bin")) ?? panic("root dir")
    files.create_dir_all(files.join(source, "leaf")) ?? panic("leaf dir")
    files.write(files.join(source, "root/bin/rg"), "#!/bin/sh\ntest -f {STORE_TEST_PROJECTION_LEAF}/payload\n") ?? panic("rg")
    files.set_mode(files.join(source, "root/bin/rg"), 493) ?? panic("chmod")
    files.write(files.join(source, "leaf/payload"), "leaf") ?? panic("leaf payload")
    root_nar: (store_write_nar(files.join(source, "root")) ?? panic("root nar")).bytes
    leaf_nar: (store_write_nar(files.join(source, "leaf")) ?? panic("leaf nar")).bytes
    ^seed: [U8]{}
    loop _ in 0..<32 -> seed.push(U8{9})
    key_id: "jetpack-projection-test-1"
    routes: [String:[U8]]{
        "/nix-cache-info": "StoreDir: /nix/store\nWantMassQuery: 1\n".bytes(),
        "/00000000000000000000000000000000.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_ROOT, "root.nar", root_nar, [String]{STORE_TEST_PROJECTION_LEAF}, key_id, seed).bytes(),
        "/11111111111111111111111111111111.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_LEAF, "leaf.nar", leaf_nar, [String]{}, key_id, seed).bytes(),
        "/nar/root.nar": root_nar,
        "/nar/leaf.nar": leaf_nar,
    }
    cache: store_test_start_cache_server(roots, routes)
    files.create_dir_all(files.join(roots.root, "config")) ?? panic("config dir")
    files.create_dir_all(files.join(roots.root, "trust")) ?? panic("trust dir")
    files.write(files.join(roots.root, "config/nix-cache-v1.endpoint"), cache.endpoint) ?? panic("endpoint")
    public_key: crypto.SigningKey{bytes: seed}.public_key().bytes
    files.write(files.join(roots.root, "trust/nix-cache-v1.ed25519.pub"), "{key_id}:{base64.encode(public_key)}\n") ?? panic("trust key")
    admitted: store_admit_nix_closure(verification, roots, [NixOutputRequest]{NixOutputRequest{name: "out", store_path: STORE_TEST_PROJECTION_ROOT}}, false) ?? panic("admit closure")
    store_test_stop_cache_server(cache)
    admitted
}

#Test("store nix store projection includes every hangar closure object") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    admitted: store_test_admit_signed_closure(verification, roots)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    entry: store_test_find_entry(entries, root_path)
    lease: store_snapshot_lease(verification, roots, entry) ?? panic("lease")
    ^projected: [String:String]{}
    loop item in
        store_nix_store_projection_for_entry(verification, roots, entry, lease.snapshot_root) ?? panic("projection") {
        assert(!store_path_starts_with(item.source, "/nix/store"))
        projected[item.logical] = item.source
    }
    // The lease hands the child exactly those objects, by held descriptor.
    ^leased: [String]{}
    loop pair in lease.nix_store_projection() -> leased.push(pair.logical)
    assert_eq(store_sorted_unique(leased), store_sorted_unique(projected.keys().to_list()))
    ^expected: [String]{}
    loop object in admitted.objects -> expected.push(object.key.removeprefix("/nix/store/"))
    ^actual: [String]{}
    loop pair in projected -> actual.push(pair.key.removeprefix("/nix/store/"))
    assert_eq(store_sorted_unique(actual), store_sorted_unique(expected))
    objects: files.join(roots.hangar_dir(), STORE_OBJECTS_DIR)
    loop pair in projected {
        assert(pair.value == lease.snapshot_root || store_path_starts_with(pair.value, objects))
    }
    lease.release()
    store_test_drop_roots(roots)
}

#Test("store nix store projection rejects a missing closure object") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    admitted: store_test_admit_signed_closure(verification, roots)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    entry: store_test_find_entry(entries, root_path)
    ^leaf: ""
    loop object in admitted.objects {
        if object.value.store_path != root_path -> leaf = object.value.hangar_path
    }
    info: files.stat(leaf) ?? panic("the admitted leaf object must exist")
    assert(info.is_dir)
    store_make_tree_writable_for_removal(leaf) ?? panic("chmod leaf")
    files.remove_all(leaf) ?? panic("remove leaf")
    if store_snapshot_lease(verification, roots, entry) == {
        .Ok(_) -> { panic("missing closure object must reject the lease") }
        .Err(error) -> assert(error.message().contains("Hangar object"))
    }
    store_test_drop_roots(roots)
}

#Test("store nix store projection rejects a conflicting closure owner at registration") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    admitted: store_test_admit_signed_closure(verification, roots)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    root_entry: store_test_find_entry(entries, root_path)
    ^leaf_path: ""
    loop object in admitted.objects {
        if object.key != root_path -> leaf_path = object.key
    }
    ^conflict: store_test_find_entry(entries, leaf_path)
    conflict.name = "nix-projection-conflict"
    conflict.reference = "nix-projection-conflict@nixpkgs"
    conflict.id = store_entry_id(conflict.name, conflict.version, conflict.reference, conflict.out)
    ^producer: ProducerRecord.decode(conflict.producer_record) ?? panic("producer")
    producer.facts["nix.output.out"] = "/nix/store/conflicting-leaf"
    conflict.producer_record = producer.encode()
    conflict.receipt = ""
    // The reproducibility gate rejects a conflicting closure owner at
    // registration: the same action key may not map one canonical output
    // path to different bytes or provenance. The original root stays
    // leasable afterwards.
    if store_test_register_conflict(verification, roots, conflict) == {
        .Ok(_) -> { panic("conflicting closure owner must be rejected at registration") }
        .Err(error) -> assert(error.message().contains("conflicting bytes or provenance"))
    }
    lease: store_snapshot_lease(verification, roots, root_entry) ?? panic("the untouched root entry must still lease")
    lease.release()
    store_test_drop_roots(roots)
}

store_test_register_conflict: fn(verification: StoreVerification, roots: HangarRoots, original: StoreEntry) -> Bool StoreError! {
    _hangar_lock: env_runtime_lock(roots.root, "hangar")
    ^entry: original
    store_prepare_entry_receipt(roots, entry)
    store_register_entry_unlocked(verification, roots, entry)
}

#Test("store nix closure verification rejects an escaped leaf object") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    admitted: store_test_admit_signed_closure(verification, roots)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    entry: store_test_find_entry(entries, root_path)
    ^leaf: ""
    loop object in admitted.objects {
        if object.value.store_path != root_path -> leaf = object.value.hangar_path
    }
    // Replace the leaf with a symlink escaping the Hangar. The closure
    // verification is the gate that must reject the swapped object.
    target: files.join(roots.root, "external-object")
    files.create_dir_all(target) ?? panic("target")
    store_make_tree_writable_for_removal(leaf) ?? panic("chmod leaf")
    files.remove_all(leaf) ?? panic("remove leaf")
    files.symlink(target, leaf) ?? panic("leaf link")
    expectation: CacheExpectation{identity: entry.cache_identity, owned_output: None, allow_unsigned_local: true}
    proof: store_verify_cache_entry(verification, roots, entry, entry.reference, expectation)
    assert(!proof.closure)
    assert(!proof.trusted())
    store_test_drop_roots(roots)
}

store_test_admit_signed_closure_with_bin_symlinks: fn(verification: StoreVerification, roots: HangarRoots, leaf_tool_body: String) -> AdmittedNixClosure Never! {
    source: files.join(roots.root, "nix-projection-symlinks-source")
    files.create_dir_all(files.join(source, "root/bin")) ?? panic("root dir")
    files.create_dir_all(files.join(source, "leaf/bin")) ?? panic("leaf dir")
    files.write(files.join(source, "root/bin/rg"), "#!/bin/sh\necho rg\n") ?? panic("rg")
    files.set_mode(files.join(source, "root/bin/rg"), 493) ?? panic("chmod rg")
    files.write(files.join(source, "leaf/bin/leaf-tool"), leaf_tool_body) ?? panic("leaf tool")
    files.set_mode(files.join(source, "leaf/bin/leaf-tool"), 493) ?? panic("chmod leaf tool")
    files.symlink("{STORE_TEST_PROJECTION_LEAF}/bin/leaf-tool", files.join(source, "root/bin/projected-tool")) ?? panic("projected symlink")
    files.symlink("/nix/store/22222222222222222222222222222222-missing-tool/bin/missing-tool", files.join(source, "root/bin/dangling-nix")) ?? panic("dangling nix symlink")
    files.symlink("../libexec/missing-helper", files.join(source, "root/bin/dangling-rel")) ?? panic("dangling rel symlink")
    root_nar: (store_write_nar(files.join(source, "root")) ?? panic("root nar")).bytes
    leaf_nar: (store_write_nar(files.join(source, "leaf")) ?? panic("leaf nar")).bytes
    ^seed: [U8]{}
    loop _ in 0..<32 -> seed.push(U8{9})
    key_id: "jetpack-projection-test-1"
    routes: [String:[U8]]{
        "/nix-cache-info": "StoreDir: /nix/store\nWantMassQuery: 1\n".bytes(),
        "/00000000000000000000000000000000.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_ROOT, "root.nar", root_nar, [String]{STORE_TEST_PROJECTION_LEAF}, key_id, seed).bytes(),
        "/11111111111111111111111111111111.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_LEAF, "leaf.nar", leaf_nar, [String]{}, key_id, seed).bytes(),
        "/nar/root.nar": root_nar,
        "/nar/leaf.nar": leaf_nar,
    }
    cache: store_test_start_cache_server(roots, routes)
    files.create_dir_all(files.join(roots.root, "config")) ?? panic("config dir")
    files.create_dir_all(files.join(roots.root, "trust")) ?? panic("trust dir")
    files.write(files.join(roots.root, "config/nix-cache-v1.endpoint"), cache.endpoint) ?? panic("endpoint")
    public_key: crypto.SigningKey{bytes: seed}.public_key().bytes
    files.write(files.join(roots.root, "trust/nix-cache-v1.ed25519.pub"), "{key_id}:{base64.encode(public_key)}\n") ?? panic("trust key")
    admitted: store_admit_nix_closure(verification, roots, [NixOutputRequest]{NixOutputRequest{name: "out", store_path: STORE_TEST_PROJECTION_ROOT}}, false) ?? panic("admit closure")
    store_test_stop_cache_server(cache)
    admitted
}

#Test("store nix store projection leases bin symlinks across projections and skips dangling links") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    leaf_tool_body: "#!/bin/sh\necho leaf-tool\n"
    admitted: store_test_admit_signed_closure_with_bin_symlinks(verification, roots, leaf_tool_body)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    ^entry: store_test_find_entry(entries, root_path)
    entry.bin = files.join(entry.out, "bin")
    entry.receipt = ""
    ^with_bin: [StoreEntry]{entry}
    store_test_register_canonical(verification, roots, with_bin)
    ^lease: store_snapshot_lease(verification, roots, with_bin[0]) ?? panic("lease with bin symlinks must succeed")
    lease.validate() ?? panic("lease must validate")
    assert(lease.executable("rg") != None)
    assert(lease.executable("projected-tool") != None)
    assert(lease.executable("dangling-nix") == None)
    assert(lease.executable("dangling-rel") == None)
    digest: if lease.executable_digest_for_command("projected-tool") == {
        .Val(value) -> value
        .None -> panic("projected-tool digest missing")
        .Err(error) -> panic("projected-tool digest failed: {error}")
    }
    assert_eq(digest, store_sha256_hex(leaf_tool_body.bytes()))
    lease.release()
    store_test_drop_roots(roots)
}

store_test_open_fd_count: fn() -> Int Never! {
    if sys.name() != "linux" -> return 0
    (files.list_dir("/proc/self/fd") ?? panic("listing /proc/self/fd")).len()
}

store_test_admit_multi_leaf_closure: fn(verification: StoreVerification, roots: HangarRoots, leaf_count: Int, bin_count: Int) -> AdmittedNixClosure Never! {
    source: files.join(roots.root, "nix-projection-pool-source")
    files.create_dir_all(files.join(source, "root/bin")) ?? panic("root dir")
    ^bin_i: 0
    loop bin_i < bin_count {
        tool_path: files.join(source, "root/bin/tool-{bin_i}")
        files.write(tool_path, "#!/bin/sh\necho tool-{bin_i}\n") ?? panic("tool write")
        files.set_mode(tool_path, 493) ?? panic("tool chmod")
        bin_i += 1
    }
    ^seed: [U8]{}
    loop _ in 0..<32 -> seed.push(U8{9})
    key_id: "jetpack-projection-pool-test-1"
    ^routes: [String:[U8]]{
        "/nix-cache-info": "StoreDir: /nix/store\nWantMassQuery: 1\n".bytes(),
    }
    ^leaf_refs: [String]{}
    ^leaf_i: 0
    loop leaf_i < leaf_count {
        tag: if leaf_i < 10 -> "0{leaf_i}" else -> "{leaf_i}"
        hash_prefix: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa{tag}"
        leaf_store_path: "/nix/store/{hash_prefix}-leaf-{leaf_i}"
        leaf_dir: files.join(source, "leaf-{leaf_i}")
        files.create_dir_all(leaf_dir) ?? panic("leaf dir")
        files.write(files.join(leaf_dir, "payload"), "leaf-{leaf_i}") ?? panic("leaf payload")
        leaf_nar: (store_write_nar(leaf_dir) ?? panic("leaf nar")).bytes
        routes["/{hash_prefix}.narinfo"] = store_test_signed_narinfo(leaf_store_path, "leaf-{leaf_i}.nar", leaf_nar, [String]{}, key_id, seed).bytes()
        routes["/nar/leaf-{leaf_i}.nar"] = leaf_nar
        leaf_refs.push(leaf_store_path)
        leaf_i += 1
    }
    root_nar: (store_write_nar(files.join(source, "root")) ?? panic("root nar")).bytes
    routes["/00000000000000000000000000000000.narinfo"] = store_test_signed_narinfo(STORE_TEST_PROJECTION_ROOT, "root.nar", root_nar, leaf_refs, key_id, seed).bytes()
    routes["/nar/root.nar"] = root_nar
    cache: store_test_start_cache_server(roots, routes)
    files.create_dir_all(files.join(roots.root, "config")) ?? panic("config dir")
    files.create_dir_all(files.join(roots.root, "trust")) ?? panic("trust dir")
    files.write(files.join(roots.root, "config/nix-cache-v1.endpoint"), cache.endpoint) ?? panic("endpoint")
    public_key: crypto.SigningKey{bytes: seed}.public_key().bytes
    files.write(files.join(roots.root, "trust/nix-cache-v1.ed25519.pub"), "{key_id}:{base64.encode(public_key)}\n") ?? panic("trust key")
    admitted: store_admit_nix_closure(verification, roots, [NixOutputRequest]{NixOutputRequest{name: "out", store_path: STORE_TEST_PROJECTION_ROOT}}, false) ?? panic("admit multi-leaf closure")
    store_test_stop_cache_server(cache)
    admitted
}

#Test("store nix store projection direct CAS leases reopen executables on demand and reject swapped files") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    leaf_tool_body: "#!/bin/sh\necho leaf-tool\n"
    admitted: store_test_admit_signed_closure_with_bin_symlinks(verification, roots, leaf_tool_body)
    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    ^entry: store_test_find_entry(entries, root_path)
    entry.bin = files.join(entry.out, "bin")
    entry.receipt = ""
    ^with_bin: [StoreEntry]{entry}
    store_test_register_canonical(verification, roots, with_bin)
    ^lease: store_snapshot_lease(verification, roots, with_bin[0]) ?? panic("direct CAS lease must succeed")
    expected_rg: "#!/bin/sh\necho rg\n"
    digest: if lease.executable_digest_for_command("rg") == {
        .Val(value) -> value
        .None -> panic("rg digest missing")
        .Err(error) -> panic("rg digest failed: {error}")
    }
    assert_eq(digest, store_sha256_hex(expected_rg.bytes()))
    copied_path: files.join(roots.root, "copied-rg")
    _: lease.copy_profile_executable("rg", copied_path) ?? panic("copy_profile_executable must succeed on direct CAS")
    assert_eq(files.read(copied_path) ?? panic("read copied rg"), expected_rg)
    if sys.name() == "linux" {
        // Swap the underlying file with a new inode; on-demand re-open must reject it.
        bin_dir: files.join(lease.snapshot_root, "bin")
        rg_path: files.join(bin_dir, "rg")
        files.set_mode(bin_dir, 493) ?? panic("chmod bin writable")
        files.remove(rg_path) ?? panic("remove rg")
        files.write(rg_path, "#!/bin/sh\necho tampered\n") ?? panic("write tampered rg")
        if lease.executable_digest_for_command("rg") == {
            .Err(error) -> assert("{error}".contains("leased executable member changed"))
            .Val(_) | .None -> panic("swapped direct CAS executable must fail digest check")
        }
        copied_tampered: files.join(roots.root, "copied-rg-tampered")
        if lease.copy_profile_executable("rg", copied_tampered) == {
            .Err(error) -> { assert("{error}".contains("leased executable member changed")) }
            .Ok(_) -> panic("swapped direct CAS executable must fail profile copy")
        }
        // Replace with a symlink; links: .Refuse must also reject it.
        files.remove(rg_path) ?? panic("remove tampered rg")
        files.symlink(copied_path, rg_path) ?? panic("symlink rg")
        if lease.executable_digest_for_command("rg") == {
            .Err(_) -> {}
            .Val(_) | .None -> panic("symlinked direct CAS executable must fail digest check")
        }
    }
    lease.release()
    store_test_drop_roots(roots)
}

#Test("store nix store projection pools shared closure handles and bounds open FDs across many leases") {
    ^verification: StoreVerification.new()
    roots: store_test_temp_roots()
    admitted: store_test_admit_multi_leaf_closure(verification, roots, 10, 20)
    base_entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    root_path: (admitted.outputs.get("out") ?? panic("out output")).store_path
    template: store_test_find_entry(base_entries, root_path)
    ^many: [StoreEntry]{}
    ^pkg_i: 0
    loop pkg_i < 30 {
        ^entry: template
        entry.name = "pooled-pkg-{pkg_i}"
        entry.reference = "pooled-pkg-{pkg_i}@nixpkgs"
        entry.bin = files.join(entry.out, "bin")
        entry.id = store_entry_id(entry.name, entry.version, entry.reference, entry.out)
        entry.receipt = ""
        many.push(entry)
        pkg_i += 1
    }
    store_test_register_canonical(verification, roots, many)
    all_entries: store_list_checked(verification, roots) ?? panic("listing pooled entries")
    before_fds: store_test_open_fd_count()
    ^leases: store_snapshot_leases_with_entries_unlocked(verification, roots, many, all_entries) ?? panic("batch leasing 30 entries must succeed")
    during_fds: store_test_open_fd_count()
    assert_eq(leases.len(), 30)
    if sys.name() == "linux" {
        // Without pooling + dropping idle direct CAS executable FDs, 30 leases
        // over 11 projection objects and 20 executables hold 990+ descriptors.
        // With pooling, all 30 leases share 11 pooled projection FDs plus 30
        // snapshot dirs and 30 live locks (~71 FDs total).
        assert(during_fds - before_fds < 120)
        // Every lease's projection entries share the exact same reserved child FDs.
        first_proj: leases[0].nix_store_projection()
        assert(first_proj.len() >= 11)
        ^idx: 1
        loop idx < leases.len() {
            proj: leases[idx].nix_store_projection()
            assert_eq(proj.len(), first_proj.len())
            ^p: 0
            loop p < proj.len() {
                assert_eq(proj[p].logical, first_proj[p].logical)
                assert(proj[p].source.same(first_proj[p].source))
                p += 1
            }
            idx += 1
        }
    }
    // Handing all 30 leases into a single ProcessSpec must deduplicate shared
    // child_fd slots, launch cleanly, and render every projected path without error.
    store_test_verify_pooled_spec_handoff(leases)
    // Releasing all 30 leases must drain the refcounted pool and close FDs.
    loop lease in leases.move() -> lease.release()
    if sys.name() == "linux" {
        assert_eq(verification.state.guard_read().value.pinned_projections.len(), 0)
        after_fds: store_test_open_fd_count()
        assert(after_fds <= before_fds + 4)
    }
    store_test_drop_roots(roots)
}

store_test_verify_pooled_spec_handoff: fn(leases: ^[CacheLease]) Never! {
    ^planned: LeaseBinding.empty()
    loop lease in leases -> lease.plan_binding(planned)
    ^spec: process.cmd([String]{"true"})
    ^binding: LeaseBinding.empty()
    ^k: 0
    loop k < leases.len() {
        spec = leases[k].keep_open_for(spec, binding) ?? panic("keep_open_for must deduplicate shared projection FDs: {err.message()}")
        k += 1
    }
    assert_eq(binding.fds.len(), planned.fds.len())
    loop pair in leases[0].nix_store_projection() {
        rendered: pair.source.render(binding) ?? panic("rendered projection path failed: {err.message()}")
        assert(rendered != "")
    }
    receipt: spec.run() ?? panic("child with 30 pooled leases must launch cleanly: {err}")
    assert(receipt.success)
}

store_test_push_u16_le: fn(out: ^[U8], value: Int) Never! {
    out.push(U8{value & 255})
    out.push(U8{(value >> 8) & 255})
}

store_test_push_u32_le: fn(out: ^[U8], value: Int) Never! {
    out.push(U8{value & 255})
    out.push(U8{(value >> 8) & 255})
    out.push(U8{(value >> 16) & 255})
    out.push(U8{(value >> 24) & 255})
}

store_test_push_u64_le: fn(out: ^[U8], value: Int) Never! {
    store_test_push_u32_le(out, value)
    store_test_push_u32_le(out, value >> 32)
}

// Build a minimal static Linux x86_64 ELF executable that calls
// `openat(AT_FDCWD, target_path, O_RDONLY, 0)` and exits 0 if it opens,
// else exits 42. Has zero dynamic-linker or host `/nix/store` dependencies.
store_test_static_open_check_elf_x86_64: fn(target_path: String) -> [U8] Never! {
    vaddr: 4194304
    ehdr_size: 64
    phdr_size: 56
    code_off: ehdr_size + phdr_size
    code: [U8]{
        // mov eax, 257 (SYS_openat)
        U8{184},
        U8{1},
        U8{1},
        U8{0},
        U8{0},
        // mov rdi, -100 (AT_FDCWD)
        U8{72},
        U8{199},
        U8{199},
        U8{156},
        U8{255},
        U8{255},
        U8{255},
        // lea rsi, [rip + 26] (target_path immediately after code)
        U8{72},
        U8{141},
        U8{53},
        U8{26},
        U8{0},
        U8{0},
        U8{0},
        // xor edx, edx (O_RDONLY)
        U8{49},
        U8{210},
        // xor r10d, r10d (mode = 0)
        U8{69},
        U8{49},
        U8{210},
        // syscall
        U8{15},
        U8{5},
        // xor edi, edi (exit code 0)
        U8{49},
        U8{255},
        // test rax, rax; jns +5
        U8{72},
        U8{133},
        U8{192},
        U8{121},
        U8{5},
        // mov edi, 42
        U8{191},
        U8{42},
        U8{0},
        U8{0},
        U8{0},
        // mov eax, 231 (SYS_exit_group); syscall
        U8{184},
        U8{231},
        U8{0},
        U8{0},
        U8{0},
        U8{15},
        U8{5},
    }
    path_bytes: target_path.bytes()
    total_size: code_off + code.len() + path_bytes.len() + 1
    ^out: [U8]{
        // ELF64 little-endian magic + padding (16 bytes)
        U8{127},
        U8{69},
        U8{76},
        U8{70},
        U8{2},
        U8{1},
        U8{1},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
        U8{0},
    }
    store_test_push_u16_le(out, 2)
    store_test_push_u16_le(out, 62)
    store_test_push_u32_le(out, 1)
    store_test_push_u64_le(out, vaddr + code_off)
    store_test_push_u64_le(out, ehdr_size)
    store_test_push_u64_le(out, 0)
    store_test_push_u32_le(out, 0)
    store_test_push_u16_le(out, ehdr_size)
    store_test_push_u16_le(out, phdr_size)
    store_test_push_u16_le(out, 1)
    store_test_push_u16_le(out, 0)
    store_test_push_u16_le(out, 0)
    store_test_push_u16_le(out, 0)
    // PT_LOAD (RX)
    store_test_push_u32_le(out, 1)
    store_test_push_u32_le(out, 5)
    store_test_push_u64_le(out, 0)
    store_test_push_u64_le(out, vaddr)
    store_test_push_u64_le(out, vaddr)
    store_test_push_u64_le(out, total_size)
    store_test_push_u64_le(out, total_size)
    store_test_push_u64_le(out, 4096)
    loop byte in code -> out.push(byte)
    loop byte in path_bytes -> out.push(byte)
    out.push(U8{0})
    out
}

#Test("store nix store projection runs leased executable inside isolated rootless /nix/store namespace") {
    if !sys.is_linux() || sys.arch() != "x86_64" {
        return
    }
    unshare: env_shell_first_file(ENV_SHELL_UNSHARE_CANDIDATES) ?? return
    _: env_shell_first_file(ENV_SHELL_MOUNT_CANDIDATES) ?? return
    shell: env_shell_first_file(ENV_SHELL_SH_CANDIDATES) ?? return
    if env_shell_check_rootless_namespace(unshare, shell) == .Err(_) {
        return
    }

    roots: store_test_temp_roots()
    verification: StoreVerification.new()
    source: files.join(roots.root, "nix-projection-exec-source")
    files.create_dir_all(files.join(source, "root/bin")) ?? panic("root dir")
    files.create_dir_all(files.join(source, "leaf")) ?? panic("leaf dir")
    probe_path: files.join(source, "root/bin/probe")
    elf: store_test_static_open_check_elf_x86_64("{STORE_TEST_PROJECTION_LEAF}/payload")
    files.write_bytes(probe_path, elf) ?? panic("write probe")
    files.set_mode(probe_path, 493) ?? panic("chmod probe")
    files.write(files.join(source, "leaf/payload"), "leaf") ?? panic("leaf payload")

    // On the host (outside the projection), the logical leaf path is absent.
    host_run: process.cmd([String]{probe_path}).run() ?? panic("host probe")
    assert_eq(host_run.code, 42)

    root_nar: (store_write_nar(files.join(source, "root")) ?? panic("root nar")).bytes
    leaf_nar: (store_write_nar(files.join(source, "leaf")) ?? panic("leaf nar")).bytes
    ^seed: [U8]{}
    loop _ in 0..<32 -> seed.push(U8{13})
    key_id: "jetpack-projection-exec-1"
    routes: [String:[U8]]{
        "/nix-cache-info": "StoreDir: /nix/store\nWantMassQuery: 1\n".bytes(),
        "/00000000000000000000000000000000.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_ROOT, "root.nar", root_nar, [String]{STORE_TEST_PROJECTION_LEAF}, key_id, seed).bytes(),
        "/11111111111111111111111111111111.narinfo": store_test_signed_narinfo(STORE_TEST_PROJECTION_LEAF, "leaf.nar", leaf_nar, [String]{}, key_id, seed).bytes(),
        "/nar/root.nar": root_nar,
        "/nar/leaf.nar": leaf_nar,
    }
    cache: store_test_start_cache_server(roots, routes)
    files.create_dir_all(files.join(roots.root, "config")) ?? panic("config dir")
    files.create_dir_all(files.join(roots.root, "trust")) ?? panic("trust dir")
    files.write(files.join(roots.root, "config/nix-cache-v1.endpoint"), cache.endpoint) ?? panic("endpoint")
    public_key: crypto.SigningKey{bytes: seed}.public_key().bytes
    files.write(files.join(roots.root, "trust/nix-cache-v1.ed25519.pub"), "{key_id}:{base64.encode(public_key)}\n") ?? panic("trust key")
    admitted: store_admit_nix_closure(verification, roots, [NixOutputRequest]{NixOutputRequest{name: "out", store_path: STORE_TEST_PROJECTION_ROOT}}, false) ?? panic("admit closure")
    store_test_stop_cache_server(cache)

    entries: store_test_canonicalize_admitted_records(verification, roots, admitted)
    ^entry: store_test_find_entry(entries, STORE_TEST_PROJECTION_ROOT)
    entry.bin = files.join(entry.out, "bin")
    lease: store_snapshot_lease(verification, roots, entry) ?? panic("lease")
    assert(lease.executable_for("probe") != None)
    ^env: ShellEnv{
        bin_dirs: [String]{},
        vars: [String:String]{},
        unset_vars: [String]{},
        refs: [String]{"probe@nixpkgs"},
        label: JETPACK_PROMPT_LABEL,
        prompt_path: PromptPathMode.Short,
        prompt_strip: PromptStripMode.Off,
        cache_leases: [CacheLease]{lease},
    }
    // Through ShellEnv, `probe` runs inside the isolated rootless `/nix/store`
    // namespace where the leased leaf object is bind-mounted at its logical path.
    code: env.run_command([String]{"probe"})
    assert_eq(code, 0)
    loop held in env.cache_leases.move() -> held.release()
    store_test_drop_roots(roots)
}
