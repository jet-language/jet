// Ingest, snapshot, locked replay, and doctor claims ported from
// crates/jetpack/src/Store/Tests.rs.

fn store_test_ingest_request(name: String, reference: String, source: String, references: [String], provenance: String) -> IngestRequest Never! {
    IngestRequest{
        name: name,
        version: "1",
        reference: reference,
        cache_identity: store_test_identity(),
        references: references,
        outputs: [String: String]{"out": source},
        signature: "",
        provenance: provenance,
        platform_artifact_kind: "",
    }
}

fn store_test_assert_nothing_published(roots: HangarRoots, reference: String, source: String) Never! {
    assert_eq((store_list_checked(roots) ?? panic("listing")).len(), 0)
    assert_eq((store_closure_graph(roots) ?? panic("graph")).records.len(), 0)
    assert(store_find_by_reference(roots, reference) == None)
    assert(!store_test_verified(roots, reference, store_test_expectation(source)))
    assert(!files.exists(files.join(roots.root, "leases")))
}

#Test("store required child pipe preserves value and reports missing pipe") {
    assert_eq(store_required_child_pipe(Val(41), "unused") ?? panic("present pipe"), 41)
    messages :: [String]{"piped lease keeper stdin", "piped lease keeper stdout"}
    loop message in messages {
        if store_required_child_pipe(None, message) == {
            .Ok(_) -> panic("a missing pipe must fail")
            .Err(error) -> {
                assert(error == .Other(_))
                assert_eq(error.message(), message)
            }
        }
    }
}

#Test("store open snapshot files rejects paths outside root before inspection") {
    roots :: store_test_temp_roots()
    snapshot_root :: files.join(roots.root, "snapshot")
    outside :: files.join(roots.root, "outside/payload")
    outside_dir :: files.join(roots.root, "outside-empty-dir")
    files.create_dir_all(snapshot_root) ?? panic("snapshot root")
    files.create_dir_all(files.dirname(outside)) ?? panic("outside dir")
    files.create_dir_all(outside_dir) ?? panic("outside empty dir")
    files.write(outside, "outside") ?? panic("outside payload")
    outside_link :: files.join(roots.root, "outside-link")
    files.symlink(outside, outside_link) ?? panic("outside link")
    candidates :: [String]{outside, outside_dir, outside_link}
    loop path in candidates {
        opened := [SnapshotFile]{}
        if store_open_snapshot_files(snapshot_root, path, &opened) == {
            .Ok(_) -> panic("a path outside the snapshot root must be refused")
            .Err(error) -> {
                assert(error == .InvalidInput(_))
                assert_eq(error.message(), "snapshot path `{path}` is outside snapshot root `{snapshot_root}`")
            }
        }
        assert_eq(opened.len(), 0)
    }
    assert_eq(files.read_link(outside_link) ?? panic("read link"), outside)
    assert_eq(files.read(outside) ?? panic("read outside"), "outside")
    store_test_drop_roots(roots)
}

#Test("store ingest atomic dedupes same bytes and records referrers") {
    roots :: store_test_temp_roots()
    sources :: [String: String]{"src-a": "same-bytes", "src-b": "same-bytes", "src-c": "different"}
    loop source in sources {
        path :: files.join(roots.root, source.key)
        files.create_dir_all(path) ?? panic("fixture dir")
        files.write(files.join(path, "payload"), source.value) ?? panic("fixture payload")
    }
    first :: store_ingest_tree(roots, store_test_ingest_request("alpha", "path:a", files.join(roots.root, "src-a"), [String]{}, "test via hangar-ingest")) ?? panic("first ingest")
    assert(!first.deduplicated)
    assert(first.entry.envelope.output_hash.starts_with("sha256-"))
    second :: store_ingest_tree(roots, store_test_ingest_request("beta", "path:b", files.join(roots.root, "src-b"), [String]{}, "test via hangar-ingest")) ?? panic("second ingest")
    assert(second.deduplicated)
    assert_eq(first.entry.envelope.output_hash, second.entry.envelope.output_hash)
    third :: store_ingest_tree(roots, store_test_ingest_request("gamma", "path:c", files.join(roots.root, "src-c"), [String]{first.entry.envelope.output_hash}, "test via hangar-ingest")) ?? panic("third ingest")
    assert(!third.deduplicated)
    assert(first.entry.envelope.output_hash != third.entry.envelope.output_hash)
    assert_eq(store_referrers_of(roots, first.entry.envelope.output_hash) ?? panic("referrers"), [String]{third.entry.envelope.output_hash})
    assert_eq(store_recover_hangar_staging(roots) ?? panic("recover staging"), 0)
    store_test_drop_roots(roots)
}

#Test("store ingest missing output is typed atomic and retryable") {
    roots :: store_test_temp_roots()
    source :: files.join(roots.root, "late-ingest-output")
    request :: store_test_ingest_request("late-ingest", "path:late-ingest", source, [String]{}, "")
    if store_ingest_tree(roots, request) == {
        .Ok(_) -> panic("a missing output must fail")
        .Err(error) -> {
            assert(error == .IO(_))
            assert_eq(error.code(), "E1315")
        }
    }
    store_test_assert_nothing_published(roots, "path:late-ingest", source)
    files.create_dir_all(source) ?? panic("fixture dir")
    files.write(files.join(source, "payload"), "now-real") ?? panic("fixture payload")
    ingested :: store_ingest_tree(roots, request) ?? panic("retry ingest")
    ingested_entry :: ingested.entry
    assert(store_find_by_reference(roots, "path:late-ingest") == Val(ingested_entry))
    hit :: store_find_verified_by_reference(roots, "path:late-ingest", store_test_expectation(ingested.entry.out)) ?? panic("lookup")
    verified :: hit ?? panic("retry must publish one verified cache hit")
    assert_eq(verified.entry, ingested.entry)
    verified.lease.release()
    store_test_drop_roots(roots)
}

#Test("store ingest child replaced after copy is typed atomic and retryable") {
    roots :: store_test_temp_roots()
    source :: files.join(roots.root, "racing-tree")
    replaced :: files.join(source, "replaced-after-copy")
    replacement :: files.join(roots.root, "replacement")
    files.create_dir_all(source) ?? panic("fixture dir")
    files.write(replaced, "first") ?? panic("fixture first")
    files.write(replacement, "later") ?? panic("fixture later")
    files.write(files.join(source, "stable"), "stable") ?? panic("fixture stable")
    request :: store_test_ingest_request("child-race", "path:child-race", source, [String]{}, "")
    fired := false
    hook :: (copied: String) -> {
        if copied == replaced && !fired {
            fired = true
            files.rename(replacement, replaced) ?? panic("replace after copy")
        }
    }
    if store_ingest_tree_observed(roots, request, Val(hook)) == {
        .Ok(_) -> panic("source mutation must not return a success receipt")
        .Err(error) -> {
            assert(error == .Mutated(_))
            assert_eq(error.code(), "E1315")
        }
    }
    assert(fired)
    store_test_assert_nothing_published(roots, "path:child-race", source)
    files.write(replaced, "first") ?? panic("restore first")
    ingested :: store_ingest_tree(roots, request) ?? panic("retry ingest")
    assert_eq(store_list_checked(roots) ?? panic("listing"), [StoreEntry]{ingested.entry})
    hit :: store_find_verified_by_reference(roots, "path:child-race", store_test_expectation(ingested.entry.out)) ?? panic("lookup")
    verified :: hit ?? panic("retry must publish one verified cache hit")
    assert_eq(verified.entry, ingested.entry)
    verified.lease.release()
    store_test_drop_roots(roots)
}

#Test("store ingest retry after object publish seals before metadata") {
    roots :: store_test_temp_roots()
    first :: store_test_ingest_fixture(roots, "retry-crash", [String: String]{"out": "retry"}, [String]{})
    object :: first.entry.out
    store_make_tree_writable_for_removal(object) ?? panic("chmod")
    files.remove_all(files.join(roots.hangar_dir(), first.entry.id)) ?? panic("remove record dir")
    files.remove_all(files.join(roots.hangar_dir(), "closure-db")) ?? panic("remove closure db")
    retry :: store_test_ingest_fixture(roots, "retry-crash", [String: String]{"out": "retry"}, [String]{})
    assert(retry.deduplicated)
    assert_eq((files.stat(object) ?? panic("stat")).mode & 146, 0)
    assert_eq((files.stat(files.join(object, "payload")) ?? panic("stat")).mode & 146, 0)
    assert(files.is_file(files.join(files.join(roots.hangar_dir(), retry.entry.id), "meta.json")))
    assert((store_closure_graph(roots) ?? panic("graph")).records.has_key(retry.entry.id))
    store_test_drop_roots(roots)
}

#Test("store ingest rejects path law reserved name") {
    roots :: store_test_temp_roots()
    source :: files.join(roots.root, "src-bad")
    files.create_dir_all(source) ?? panic("fixture dir")
    files.write(files.join(source, "CON"), "nope") ?? panic("fixture reserved")
    if store_ingest_tree(roots, store_test_ingest_request("bad", "path:bad", source, [String]{}, "")) == {
        .Ok(_) -> panic("a reserved name must be refused")
        .Err(error) -> {
            assert_eq(error.code(), "E1299")
            assert(error.what().contains("store path") || error.why().contains("reserved") || error.why().contains("CON") || error.message().contains("reserved"))
        }
    }
    store_test_drop_roots(roots)
}

#Test("store ingest rejects output names that escape staging") {
    aliases :: [String]{"../escaped-output", "..\\escaped-output", ".", "out/", "out//", "out/.", "out/./", "out\\", "out\\."}
    loop alias in aliases {
        roots :: store_test_temp_roots()
        source :: files.join(roots.root, "src-output-name")
        files.create_dir_all(source) ?? panic("fixture dir")
        files.write(files.join(source, "payload"), "bytes") ?? panic("fixture payload")
        escaped :: files.join(roots.root, "escaped-output")
        request := store_test_ingest_request("bad-output-name", "path:bad-output-name", source, [String]{}, "")
        request.outputs[alias] = source
        if store_ingest_tree(roots, request) == {
            .Ok(_) -> panic("output alias `{alias}` must be refused")
            .Err(error) -> {
                assert_eq(error.code(), "E1315")
                assert(error.what().contains("one path component"))
            }
        }
        assert(!files.exists(roots.hangar_dir()))
        assert(!files.exists(escaped))
        store_test_drop_roots(roots)
    }
}

#Test("store locked nix cas replay is cold and warm stable") {
    source_roots :: store_test_temp_roots()
    source_project :: files.join(source_roots.root, "project")
    files.create_dir_all(source_project) ?? panic("project dir")
    source := store_test_ingest_fixture(source_roots, "locked-nix", [String: String]{"out": "portable"}, [String]{}).entry
    assert(store_remove_closure_record(source_roots, source.id) ?? panic("remove record"))
    revision :: store_test_repeat("a", 40)
    signed_manifest :: store_test_repeat("b", 64)
    derivation :: store_test_repeat("c", 64)
    nar_hash :: "sha256:{store_test_repeat("d", 64)}"
    upstream_proof :: "sha256-{store_test_repeat("e", 64)}"
    cache_key :: store_test_repeat("f", 64)
    system :: pkg_host_platform()
    producer := ProducerRecord.decode(source.producer_record) ?? panic("producer")
    producer.provider = "nix"
    producer.immutable_source = "nix-source-locked-nix"
    producer.source_digest = source.envelope.output_hash
    extra :: [String: String]{
        "nix.index.channel": "nixpkgs-unstable",
        "nix.index.revision": revision,
        "nix.index.system": system,
        "nix.index.manifest.sha256": signed_manifest,
        "nix.derivation.sha256": derivation,
        "nix.output.out": source.out,
        "nix.store-path": "/nix/store/locked-nix",
        "nix.proof": upstream_proof,
        "nix.nar-hash": nar_hash,
        "nix.nar-size": "1",
        "nix.compression": "none",
        "nix.cache.key": cache_key,
    }
    loop fact in extra -> producer.facts[fact.key] = fact.value
    source.producer_record = producer.encode()
    store_test_register_admitted(source_roots, source)

    bundle :: store_publish_nix_cas_bundle(source_project, source_roots, source.id) ?? panic("publish bundle")
    imported_root :: files.join(files.dirname(source_roots.root), "imported-root-{process.current_pid()}")
    files.create_dir_all(imported_root) ?? panic("imported root")
    imported_roots :: HangarRoots{root: imported_root, dev_mode: true}
    imported :: store_import_nix_cas_bundle(source_project, imported_roots, bundle) ?? panic("import bundle")
    closure :: NixClosureRecord{
        channel: "nixpkgs-unstable",
        revision: revision,
        system: system,
        index_authority: signed_manifest,
        derivation: derivation,
        output: source.envelope.output_hash,
        nar_hash: nar_hash,
        size: 1,
        compression: "none",
        references: [String]{},
        upstream_proof: upstream_proof,
        cache_key: cache_key,
        project_cas_bundle: bundle,
    }
    envelope :: LockEnvelope{output_hash: closure.output, platform: closure.system, signature: "", provenance: "locked-nix", catalog_tier: "local-unofficial", catalog_trust: "unverified"}
    first :: store_record_locked_nix(imported_roots, "locked-nix", "1", "locked-nix@nixpkgs", envelope, closure, imported.digests, "lock-digest") ?? panic("first replay")
    second :: store_record_locked_nix(imported_roots, "locked-nix", "1", "locked-nix@nixpkgs", envelope, closure, imported.digests, "lock-digest") ?? panic("second replay")
    assert_eq(first.id, second.id)
    assert_eq(first.envelope.output_hash, second.envelope.output_hash)
    count := 0
    loop entry in store_list_checked(imported_roots) ?? panic("listing") {
        if entry.reference == "locked-nix@nixpkgs" -> count += 1
    }
    assert_eq(count, 1)
    store_test_drop_roots(imported_roots)
    store_test_drop_roots(source_roots)
}

// Register admitted Nix entries under the Hangar lock.
fn store_test_register_admitted(roots: HangarRoots, entry: StoreEntry) Never! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar") ?? panic("hangar lock")
    assert(store_register_admitted_nix_entries_unlocked(roots, [StoreEntry]{entry}) ?? panic("register admitted"))
}

fn store_test_assert_unrepaired(report: HangarDoctorReport) Never! {
    assert_eq(report.findings.len(), 1)
    finding :: report.findings[0]
    assert_eq(finding.kind, "drift")
    assert_eq(finding.subject, "cas/.locks")
    assert(!finding.fixed)
}

#Test("store hangar doctor preserves malformed cas lock namespace") {
    roots :: store_test_temp_roots()
    cas :: files.join(roots.hangar_dir(), "cas")
    files.create_dir_all(cas) ?? panic("cas dir")
    locks :: files.join(cas, ".locks")
    files.write(locks, "not a directory") ?? panic("locks file")
    file_metadata :: files.stat(locks) ?? panic("stat")
    store_test_assert_unrepaired(store_hangar_doctor(roots, false, true) ?? panic("doctor"))
    store_test_assert_unrepaired(store_hangar_doctor(roots, true, true) ?? panic("doctor fix"))
    after_file :: files.stat(locks) ?? panic("stat")
    assert(after_file.is_file)
    assert(after_file.id == file_metadata.id)
    assert_eq(files.read(locks) ?? panic("read locks"), "not a directory")

    files.remove(locks) ?? panic("remove locks")
    outside_cas :: files.join(roots.root, "outside-cas")
    files.create_dir_all(outside_cas) ?? panic("outside dir")
    protected :: files.join(outside_cas, "must-retain")
    files.write(protected, "outside CAS") ?? panic("protected file")
    protected_metadata :: files.stat(protected) ?? panic("stat")
    files.symlink(outside_cas, locks) ?? panic("locks link")
    link_metadata :: files.stat(locks) ?? panic("stat")
    store_test_assert_unrepaired(store_hangar_doctor(roots, false, true) ?? panic("doctor"))
    store_test_assert_unrepaired(store_hangar_doctor(roots, true, true) ?? panic("doctor fix"))
    after_link :: files.stat(locks) ?? panic("stat")
    assert(after_link.is_symlink)
    assert(after_link.id == link_metadata.id)
    assert_eq(files.read_link(locks) ?? panic("read link"), outside_cas)
    after_protected :: files.stat(protected) ?? panic("stat")
    assert(after_protected.id == protected_metadata.id)
    assert_eq(files.read(protected) ?? panic("read protected"), "outside CAS")
    store_test_drop_roots(roots)
}
