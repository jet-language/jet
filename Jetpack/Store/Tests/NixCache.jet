    assert((files.stat(object.hangar_path) ?? panic("object")).is_file)
    file_root_bin := String?{None}
    loop entry in store_list_checked(&verification, cache.roots) ?? panic("listing") {
        if entry.name == "file-root" -> file_root_bin = Val(entry.bin)
    }
    assert_eq(file_root_bin, Val(""))
    cache.server.replace_routes(store_nix_test_only_cache_info())
    second :: store_nix_test_admit(&verification, cache.roots, "out", store_path)
    assert_eq(store_nix_test_object(second, store_path).hangar_digest, object.hangar_digest)
    assert_eq(store_list(&verification, cache.roots).len(), 1)
    ^cache.server.stop()
    store_nix_test_remove_dir(cache.root)
}

#Test("store nix cache memoizes verified digest until root replacement") {
    verification := StoreVerification.new()
    root :: store_nix_test_unique_dir("digest-memo")
    hangar :: files.join(root, "hangar")
    objects :: files.join(hangar, "objects")
    files.create_dir_all(objects) ?? panic("objects")
    object :: files.join(objects, "memo")
    nar :: store_nix_test_nar_with_directory_entries([[U8]]{"payload".bytes()})
    _ :: store_read_nar_stream(store_nix_test_byte_source(nar, 65536), object, nar.len()) ?? panic("read nar")

    first :: store_verified_output_hash(&verification, object, Val(hangar), false) ?? panic("first digest")
    before :: store_object_stamp(files.stat(object) ?? panic("stat"))
    store_make_tree_writable_for_removal(object) ?? panic("chmod")
    files.write(files.join(object, "payload"), "corrupt") ?? panic("corrupt")
    assert_eq(before, store_object_stamp(files.stat(object) ?? panic("stat")))
    assert_eq(store_verified_output_hash(&verification, object, Val(hangar), false) ?? panic("memo digest"), first)

    replacement :: files.join(objects, "memo-replacement")
    files.create_dir(replacement) ?? panic("replacement")
    files.write(files.join(replacement, "payload"), "corrupt") ?? panic("replacement payload")
    displaced :: files.join(objects, "memo-displaced")
    files.rename(object, displaced) ?? panic("displace")
    files.rename(replacement, object) ?? panic("replace")
    assert(before != store_object_stamp(files.stat(object) ?? panic("stat")))
    assert((store_verified_output_hash(&verification, object, Val(hangar), false) ?? panic("replacement digest")) != first)
    store_nix_test_remove_dir(root)
}

