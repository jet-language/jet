#Test("store nix cache admits backslash component names") {
    verification := StoreVerification.new()
    store_path :: "/nix/store/aaaaaaaabbbbbbbbccccccccdddddddd-backslash-name"
    name :: "dev-disk-by\\x2duuid-test.device"
    nar :: store_nix_test_nar_with_directory_entries([[U8]]{name.bytes()})
    seed :: store_nix_test_seed(17)
    cache :: store_nix_test_single_object_cache("backslash-name", store_path, "backslash-name.nar", nar, seed)
    assert(store_validate_nar(nar) ? stats -> false ! failed -> true)
    strict_destination :: files.join(cache.root, "strict")
    assert(store_read_nar_stream(store_nix_test_byte_source(nar, 65536), strict_destination, nar.len()) ? stats -> false ! failed -> true)

    first :: store_nix_test_admit(&verification, cache.roots, "out", store_path)
    object :: store_nix_test_object(first, store_path)
    assert(files.is_file(files.join(object.hangar_path, name)))
    cache.server.replace_routes(store_nix_test_only_cache_info())
    second :: store_nix_test_admit(&verification, cache.roots, "out", store_path)
    assert_eq(store_nix_test_object(second, store_path).hangar_digest, object.hangar_digest)
    ^cache.server.stop()
    store_nix_test_remove_dir(cache.root)

    // Under the Nix name law only `/`, NUL, and `.`/`..` stay illegal;
    // control bytes are legal Nix names.
    invalid_names :: [(label: String, name: [U8])]{
        (label: "slash", name: "bad/name".bytes()),
        (label: "nul", name: store_nix_test_bytes_with_nul("bad", "name")),
        (label: "dotdot", name: "..".bytes()),
    }
    loop invalid in invalid_names {
        invalid_nar :: store_nix_test_nar_with_directory_entries([[U8]]{invalid.name})
        invalid_path :: "/nix/store/aaaaaaaabbbbbbbbccccccccdddddddd-backslash-{invalid.label}"
        _ :: store_nix_test_single_failure(&verification, "backslash-{invalid.label}", invalid_path, store_nix_test_signed_narinfo(invalid_path, "backslash-{invalid.label}.nar", invalid_nar, [String]{}, STORE_NIX_TEST_KEY_ID, seed), invalid_nar, seed, NixCacheErrorKind.PathTraversal)
    }
}

#Test("store nix cache admits sibling store relative symlink and host escape") {
    verification := StoreVerification.new()
    seed :: store_nix_test_seed(15)
    targets :: [(label: String, store_path: String, target: String)]{
        (label: "sibling-link", store_path: "/nix/store/66666666666666666666666666666666-sibling-link", target: "../../77777777777777777777777777777777-sibling/bin/tool"),
        // Escaped relative targets are inert link data in Nix admission
        // (systemd ships `../../../../../etc/environment`).
        (label: "host-escape", store_path: "/nix/store/88888888888888888888888888888888-host-escape", target: "../../../../../etc/environment"),
        // Absolute host targets are inert link data too (`/bin/sh`).
        (label: "abs-host", store_path: "/nix/store/98888888888888888888888888888888-abs-host", target: "/etc/passwd"),
    }
    loop case in targets {
        nar :: store_nix_test_nar_with_nested_symlink(case.target.bytes())
        cache :: store_nix_test_single_object_cache(case.label, case.store_path, "{case.label}.nar", nar, seed)
        admitted :: store_nix_test_admit(&verification, cache.roots, "out", case.store_path)
        object :: store_nix_test_object(admitted, case.store_path)
        assert_eq(files.read_link(files.join(object.hangar_path, "lib/link")) ?? panic("link"), case.target)
        if case.label != "abs-host" {
            cache.server.replace_routes(store_nix_test_only_cache_info())
            readmitted :: store_nix_test_admit(&verification, cache.roots, "out", case.store_path)
            assert_eq(store_nix_test_object(readmitted, case.store_path).hangar_digest, object.hangar_digest)
        }
        ^cache.server.stop()
        store_nix_test_remove_dir(cache.root)
    }

    // A NUL byte in the target stays rejected in every mode.
    bad_store_path :: "/nix/store/97888888888888888888888888888888-nul-target"
    bad_nar :: store_nix_test_nar_with_nested_symlink(store_nix_test_bytes_with_nul("/etc/pas", "swd"))
    _ :: store_nix_test_single_failure(&verification, "nul-target", bad_store_path, store_nix_test_signed_narinfo(bad_store_path, "nul-target.nar", bad_nar, [String]{}, STORE_NIX_TEST_KEY_ID, seed), bad_nar, seed, NixCacheErrorKind.PathTraversal)
}

#Test("store nix cache admits reregisters and reuses file root") {
    verification := StoreVerification.new()
    store_path :: "/nix/store/99999999999999999999999999999999-file-root"
    nar :: store_nix_test_nar_with_regular_root("source archive bytes".bytes())
    cache :: store_nix_test_single_object_cache("file-root", store_path, "file-root.nar", nar, store_nix_test_seed(16))
