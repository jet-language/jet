#Test("store nix cache replaces a corrupt existing object") {
    verification := StoreVerification.new()
    store_path :: "/nix/store/33333333333333333333333333333333-corruptible"
    nar :: store_nix_test_nar_with_directory_entries([[U8]]{})
    cache :: store_nix_test_single_object_cache("self-heal", store_path, "corruptible.nar", nar, store_nix_test_seed(12))
    first :: store_nix_test_admit(&verification, cache.roots, "out", store_path)
    object :: store_nix_test_object(first, store_path).hangar_path
    store_make_tree_writable_for_removal(object) ?? panic("chmod")
    files.write(files.join(object, "corrupt"), "untrusted content") ?? panic("corrupt")
    second :: store_nix_test_admit(&verification, cache.roots, "out", store_path)
    digest :: store_nix_test_object(first, store_path).hangar_digest
    assert_eq(store_nix_test_object(second, store_path).hangar_digest, digest)
    assert(!files.lexists(files.join(object, "corrupt")))
    assert_eq(pkg_try_output_hash_of_in_hangar(object, cache.roots.hangar_dir(), false) ?? panic("rehash"), digest)
    ^cache.server.stop()
    store_nix_test_remove_dir(cache.root)
}

#Test("store nix cache sweeps dead stages but keeps current pid stages") {
    verification := StoreVerification.new()
    root :: store_nix_test_unique_dir("stage-sweep")
    roots :: HangarRoots.at(files.join(root, "jetpack"))
    stage_parent :: files.join(roots.hangar_dir(), "stage")
    files.create_dir_all(files.join(stage_parent, "nix-cache-999999999-1/nested")) ?? panic("stale stage")
    files.write(files.join(stage_parent, "nix-cache-999999999-1/nested/payload"), "stale") ?? panic("stale payload")
    current :: files.join(stage_parent, "nix-cache-{sys.pid()}-1")
    files.create_dir_all(current) ?? panic("current stage")
    unrelated :: files.join(stage_parent, "nix-cache-not-a-pid-1")
    files.create_dir_all(unrelated) ?? panic("unrelated stage")

    transaction := NixAdmission.new(&verification, roots, None) ?? panic("admission transaction")
    assert(!files.lexists(files.join(stage_parent, "nix-cache-999999999-1")))
    assert(files.lexists(current))
    assert(files.lexists(unrelated))
    &transaction.rollback()
    store_nix_test_remove_dir(root)
}

#Test("store nix cache reads canonical directories symlinks and executables") {
    nar := store_nix_test_nar_start()
    store_nix_test_open_directory(&nar)
    store_nix_test_open_entry(&nar, "bin".bytes())
    store_nix_test_put_regular(&nar, "tool".bytes(), true)
    store_nix_test_put_text(&nar, ")")
    store_nix_test_open_entry(&nar, "lib".bytes())
    store_nix_test_open_directory(&nar)
    store_nix_test_open_entry(&nar, "target".bytes())
    store_nix_test_put_regular(&nar, "target".bytes(), false)
    store_nix_test_put_text(&nar, ")")
    store_nix_test_put_text(&nar, ")")
    store_nix_test_put_text(&nar, ")")
    store_nix_test_open_entry(&nar, "link".bytes())
    store_nix_test_put_symlink(&nar, "lib/target".bytes())
    store_nix_test_put_text(&nar, ")")
    store_nix_test_open_entry(&nar, "nix-link".bytes())
    store_nix_test_put_symlink(&nar, "/nix/store/11111111111111111111111111111111-target/bin/tool".bytes())
    store_nix_test_put_text(&nar, ")")
    store_nix_test_put_text(&nar, ")")

    destination :: store_nix_test_unique_dir("canonical-nar")
    store_nix_test_remove_dir(destination)
    stats :: store_read_nar_stream(store_nix_test_byte_source(nar, 65536), destination, nar.len()) ?? panic("read nar")
    assert_eq(stats.nodes, 6)
    assert_eq(files.read(files.join(destination, "bin")) ?? panic("bin"), "tool")
    assert_eq(files.read(files.join(destination, "lib/target")) ?? panic("target"), "target")
    assert_eq(files.read_link(files.join(destination, "link")) ?? panic("link"), "lib/target")
    assert_eq(files.read_link(files.join(destination, "nix-link")) ?? panic("nix link"), "/nix/store/11111111111111111111111111111111-target/bin/tool")
    _ :: pkg_try_output_hash_of_in_hangar(destination, destination, false) ?? panic("canonical hash")
    assert(((files.stat(files.join(destination, "bin")) ?? panic("bin stat")).mode & 0o111) != 0)
    store_nix_test_remove_dir(destination)
}

#Test("store nix cache removes a readonly partial stream tree") {
    valid_nar :: store_nix_test_nar_with_directory_entries([[U8]]{"payload".bytes()})
    nar := valid_nar
    &nar.extend("trailing".bytes())
    destination :: store_nix_test_unique_dir("readonly-partial-stream")
    store_nix_test_remove_dir(destination)
    // Seal the partially written destination once its payload exists, then
    // keep feeding one byte at a time.
    inner :: store_nix_test_byte_source(nar, 1)
    sealed :: Cell.new(false)
    reader :: NarByteSource{read: (limit: Int) -> {
        if !sealed.get() && files.is_file(files.join(destination, "payload")) {
            files.set_mode(destination, 0o555)
            sealed.set(true)
        }
        Ok(inner.read(limit))
    }}
    error :: store_read_nar_stream(reader, destination, nar.len()) ? stats -> panic("trailing bytes must fail") ! failure -> failure
    assert(error.message().contains("trailing"))
    assert(!files.lexists(destination))
    _ :: store_read_nar_stream(store_nix_test_byte_source(valid_nar, 65536), destination, valid_nar.len()) ?? panic("valid stream")
    assert(files.is_file(files.join(destination, "payload")))
    store_nix_test_remove_dir(destination)
}

#Test("store nix cache registration reports the failed cas condition") {
    verification := StoreVerification.new()
    root :: store_nix_test_unique_dir("registration-condition")
    roots :: HangarRoots.at(files.join(root, "jetpack"))
    digest :: "sha256-{store_test_repeat("a", 64)}"
    expected :: files.join(files.join(roots.hangar_dir(), "objects"), digest)
    files.create_dir_all(expected) ?? panic("expected object")
    plan :: ProviderPlanFacts.from_facts([String: String]{}) ?? panic("plan facts")
    producer :: ProducerRecord.new("nix", "/nix/store/test.drv", "sha256-source", plan, "nix-test", "policy=test\nplatform=test", [String: String]{}) ?? panic("producer")
    out :: files.join(roots.root, "not-the-canonical-object")
    entry :: StoreEntry{
        id: "registration-condition",
        name: "registration-condition",
        version: "1",
        reference: "registration-condition@nixpkgs",
        out: out,
        bin: "",
        rlib: "",
        envelope: Envelope{output_hash: digest, platform: pkg_host_platform(), signature: "", provenance: "registration-condition via nix"},
        cache_identity: CacheIdentity{source_fingerprint: "", recipe_fingerprint: "", policy_fingerprint: "", platform: ""},
        references: [String]{},
        named_outputs: [String: String]{},
        platform_artifact_kind: "",
        producer_record: producer.encode(),
        receipt: "",
        realized_at: 0,
        last_used_at: 0,
    }
    error :: store_register_admitted_nix_entries_unlocked(&verification, roots, [StoreEntry]{entry}) ? registered -> panic("a non-canonical output must be refused") ! failure -> failure
    detail :: error.message()
    assert(detail.contains(out))
    assert(detail.contains("output path"))
    store_nix_test_remove_dir(root)
}

#Test("store nix cache negative inputs fail closed") {
    verification := StoreVerification.new()
    store_path :: "/nix/store/22222222222222222222222222222222-negative"
    seed :: store_nix_test_seed(9)
    wrong_seed :: store_nix_test_seed(10)
    key_id :: STORE_NIX_TEST_KEY_ID
    valid_nar :: store_nix_test_nar_with_directory_entries([[U8]]{})
    invalid_magic_nar := [U8]{U8{9}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}}
    &invalid_magic_nar.extend("not-a-nar".bytes())
    loop _ in 0..<7 -> &invalid_magic_nar.push(U8{0})

    _ :: store_nix_test_single_failure(&verification, "wrong-key", store_path, store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{}, key_id, seed), valid_nar, wrong_seed, NixCacheErrorKind.Signature)

    zstd_info :: store_nix_test_signed_zstd_narinfo(store_path, "negative.nar.zst", valid_nar, [String]{}, key_id, seed)
    corrupted := store_nix_test_encode_zstd(valid_nar)
    corrupted[0] = U8{Int.from_u8(corrupted[0]) ~| 1}
    _ :: store_nix_test_single_failure(&verification, "compressed-corruption", store_path, zstd_info, corrupted, seed, NixCacheErrorKind.CompressedCorruption)

    nar_error :: store_nix_test_single_failure(&verification, "nar-corruption", store_path, store_nix_test_signed_narinfo(store_path, "negative.nar", invalid_magic_nar, [String]{}, key_id, seed), invalid_magic_nar, seed, NixCacheErrorKind.NarCorruption)
    assert(nar_error.message().contains(store_path))
    assert(nar_error.message().contains("invalid magic"))

    duplicate_nar :: store_nix_test_nar_with_directory_entries([[U8]]{"A".bytes(), "A".bytes()})
    _ :: store_nix_test_single_failure(&verification, "duplicate-entry", store_path, store_nix_test_signed_narinfo(store_path, "duplicate.nar", duplicate_nar, [String]{}, key_id, seed), duplicate_nar, seed, NixCacheErrorKind.DuplicateEntry)

    traversal_nar :: store_nix_test_nar_with_directory_entries([[U8]]{"..".bytes()})
    _ :: store_nix_test_single_failure(&verification, "path-traversal", store_path, store_nix_test_signed_narinfo(store_path, "traversal.nar", traversal_nar, [String]{}, key_id, seed), traversal_nar, seed, NixCacheErrorKind.PathTraversal)

    signed :: String.from_bytes(store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{}, key_id, seed)) ?? panic("narinfo text")
    url_traversal :: signed.replace("URL: nar/negative.nar\n", "URL: ../negative.nar\n")
    _ :: store_nix_test_single_failure(&verification, "url-traversal", store_path, url_traversal.bytes(), valid_nar, seed, NixCacheErrorKind.PathTraversal)

    reference :: "/nix/store/33333333333333333333333333333333-reference"
    with_reference :: String.from_bytes(store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{reference}, key_id, seed)) ?? panic("narinfo text")
    duplicate_references :: with_reference.replace("References: 33333333333333333333333333333333-reference\n", "References: 33333333333333333333333333333333-reference 33333333333333333333333333333333-reference\n")
    _ :: store_nix_test_single_failure(&verification, "duplicate-reference", store_path, duplicate_references.bytes(), valid_nar, seed, NixCacheErrorKind.DuplicateEntry)
}

#Test("store nix cache failures are e1350 and classify nar errors") {
    kinds :: [NixCacheErrorKind]{.Metadata, .WrongKey, .Signature, .Transport, .UnsupportedCompression, .CompressedCorruption, .NarCorruption, .MissingReference, .PathTraversal, .DuplicateEntry, .Admission}
    loop kind in kinds -> assert_eq(NixCacheError.new(kind, "test").code(), "E1350")
    cases :: [(detail: String, kind: NixCacheErrorKind)]{
        (detail: "NAR stream directory contains duplicate names", kind: .DuplicateEntry),
        (detail: "NAR name is not one safe path component", kind: .PathTraversal),
        (detail: "zstd data corruption detected", kind: .CompressedCorruption),
    }
    loop case in cases {
        assert_eq(store_nix_classify_nar_error(case.detail), case.kind)
        assert_eq(NixCacheError.new(case.kind, case.detail).code(), "E1350")
    }
}
