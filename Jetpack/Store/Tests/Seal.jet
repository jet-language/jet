// Seal claims ported from crates/jetpack/src/Store/SealTests.rs.
//
// Rust set exact mtimes with `touch -m -d @s.ns`; Core's `sys.utime` takes
// whole seconds, so fixtures first pin the payload to a whole-second mtime
// and every restore is exact at that precision.

fn store_test_seal_fixture(roots: HangarRoots, name: String, platform_artifact_kind: String) -> IngestedObject Never! {
    source :: files.join(roots.root, "seal-source-{name}")
    files.create_dir_all(source) ?? panic("fixture dir")
    files.write(files.join(source, "payload"), "trusted") ?? panic("fixture payload")
    request :: IngestRequest{
        name: name,
        version: "1",
        reference: "path:{name}",
        cache_identity: CacheIdentity{source_fingerprint: "seal-source", recipe_fingerprint: "seal-recipe", policy_fingerprint: "seal-policy", platform: pkg_host_platform()},
        references: [String]{},
        outputs: [String: String]{"out": source},
        signature: "",
        provenance: "seal-test",
        platform_artifact_kind: platform_artifact_kind,
    }
    store_ingest_tree(roots, request) ?? panic("fixture ingest")
}

fn store_test_mtime_seconds(path: String) -> Int Never! {
    info :: files.stat(path) ?? panic("stat")
    info.modified.unix_ns /% 1000000000
}

fn store_test_set_mtime(path: String, seconds: Int) Never! {
    sys.utime(path, seconds, seconds) ?? panic("utime failed for {path}")
}

fn store_test_make_writable(path: String) Never! {
    info :: files.stat(path) ?? panic("stat")
    files.set_mode(path, info.mode | 128) ?? panic("chmod")
}

#Test("store native admission seals after shared cas hardlinking") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "native", "")
    object :: ingested.entry.out
    digest :: ingested.entry.envelope.output_hash
    assert(files.is_dir(files.join(roots.hangar_dir(), "cas")))
    assert(store_check_seal(object, roots.hangar_dir()) ?? panic("check") == Val(digest))
    store_reset_verified_digest_hash_count(object)
    assert_eq(store_try_entry_output_hash(roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(object), 0)
    store_test_drop_roots(roots)
}

#Test("store seal written at admission and warm verification skips content hash") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "warm", "seal-test")
    object :: ingested.entry.out
    digest :: ingested.entry.envelope.output_hash
    seal :: files.join(files.join(roots.hangar_dir(), @STORE_SEALS_DIR), digest)
    assert(files.is_file(seal))
    store_reset_verified_digest_hash_count(object)
    assert_eq(store_try_entry_output_hash(roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(object), 0)

    // Owner-ratified verify-once tradeoff: bytes can change without a tuple
    // change and remain trusted until an explicit `hangar verify` audit.
    payload :: files.join(object, "payload")
    store_test_make_writable(payload)
    seconds :: store_test_mtime_seconds(payload)
    store_test_set_mtime(payload, seconds)
    store_write_seal(object, roots.hangar_dir(), digest) ?? panic("reseal at whole-second mtime")
    before :: files.stat(payload) ?? panic("stat")
    files.write(payload, "tamper!") ?? panic("tamper")
    store_test_set_mtime(payload, seconds)
    after :: files.stat(payload) ?? panic("stat")
    assert_eq(before.size, after.size)
    assert(before.modified == after.modified)

    store_reset_verified_digest_hash_count(object)
    assert_eq((store_list_checked(roots) ?? panic("listing")).len(), 1)
    assert_eq(store_verified_digest_hash_count(object), 0)
    assert(store_check_seal(object, roots.hangar_dir()) ?? panic("check") == Val(digest))
    store_test_drop_roots(roots)
}

#Test("store seal mtime drift rehashes once and reseals") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "drift", "seal-test")
    object :: ingested.entry.out
    digest :: ingested.entry.envelope.output_hash
    seal :: files.join(files.join(roots.hangar_dir(), @STORE_SEALS_DIR), digest)
    before :: files.read_bytes(seal) ?? panic("seal")
    payload :: files.join(object, "payload")
    store_test_set_mtime(payload, store_test_mtime_seconds(payload) + 1)

    store_reset_verified_digest_hash_count(object)
    assert_eq(store_try_entry_output_hash(roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(object), 1)
    assert(before != files.read_bytes(seal) ?? panic("seal"))
    assert_eq(store_try_entry_output_hash(roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(object), 1)
    store_test_drop_roots(roots)
}

#Test("store seal digest mismatch quarantines the tampered object") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "quarantine", "seal-test")
    object :: ingested.entry.out
    payload :: files.join(object, "payload")
    store_test_make_writable(payload)
    files.write(payload, "tamper!") ?? panic("tamper")
    expectation :: CacheExpectation{identity: ingested.entry.cache_identity, owned_output: Val(object), allow_unsigned_local: true}
    store_quarantine_invalid_entry(roots, ingested.entry, expectation) ?? panic("quarantine")
    assert(!files.exists(object))
    quarantined := false
    quarantine :: files.list_dir(files.join(roots.hangar_dir(), "quarantine")) ?? panic("quarantine dir")
    loop entry in quarantine {
        if entry.name.starts_with("output-") -> quarantined = true
    }
    assert(quarantined)
    assert(!files.exists(files.join(files.join(roots.hangar_dir(), @STORE_SEALS_DIR), ingested.entry.envelope.output_hash)))
    store_test_drop_roots(roots)
}

#Test("store hangar verify rehashes despite valid seal and catches content corruption") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "audit", "seal-test")
    object :: ingested.entry.out
    digest :: ingested.entry.envelope.output_hash
    assert(store_check_seal(object, roots.hangar_dir()) ?? panic("check") == Val(digest))
    payload :: files.join(object, "payload")
    store_test_make_writable(payload)
    seconds :: store_test_mtime_seconds(payload)
    files.write(payload, "tamper!") ?? panic("tamper")
    store_test_set_mtime(payload, seconds)
    assert_eq(store_test_mtime_seconds(payload), seconds)
    store_reset_verified_digest_hash_count(object)
    assert(store_verify_hangar_object(roots, ingested.entry) == .Err(_))
    assert_eq(store_verified_digest_hash_count(object), 1)
    store_test_drop_roots(roots)
}

// Rust ran the armed window on its own thread so the thread-local memo died
// with it; the port arms, exercises, and disarms the command memo in order.
#Test("store armed command memo checks identity once and stays scoped") {
    roots :: store_test_temp_roots()
    ingested :: store_test_seal_fixture(roots, "memo", "seal-test")
    object :: ingested.entry.out
    digest :: ingested.entry.envelope.output_hash
    hangar :: roots.hangar_dir()
    store_arm_command_memo()
    assert(store_check_seal(object, hangar) ?? panic("check") == Val(digest))
    // Drift the tuple identity mid-command: one command holds one coherent
    // verified view (D-JPK-VERIFYONCE1=A), so the memoized verdict stands.
    payload :: files.join(object, "payload")
    store_test_set_mtime(payload, store_test_mtime_seconds(payload) + 7)
    assert(store_check_seal(object, hangar) ?? panic("check") == Val(digest))
    // Forgetting the seal forgets the memo too.
    store_remove_seal(object, hangar) ?? panic("remove seal")
    assert(store_check_seal(object, hangar) ?? panic("check") == None)
    store_disarm_command_memo()
    // A fresh (unarmed) command keeps strict per-use drift detection.
    assert(store_check_seal(object, hangar) ?? panic("check") == None)
    store_test_drop_roots(roots)
}
