// Native runtime rlib cache keys (Rust `jet_store::runtime` tests).

// The generated runtime block of a program whose Prelude carries a target
// dossier line naming its layer, provider, and closure.
fn store_runtime_test_dossier_source(layer: String, provider: String, closure: String) -> String {
    "{@STORE_RUNTIME_BEGIN}// jet:target-dossier layer={layer} provider={provider} closure={closure} artifact=fixture\nfn runtime_entry() {{}}\n{@STORE_RUNTIME_END}"
}

fn store_runtime_test_key(crate_name: String, crate_prefix: String, dependency_key: String?, source: String) -> String {
    store_runtime_cache_key_with_schema(@STORE_RUNTIME_CACHE_SCHEMA.bytes(), crate_name, source, "fixed-exported-runtime", crate_prefix, dependency_key, "rustc", "rustc-test", [String]{}, [NativeRuntimeEnvVar]{})
}

// One source variant and the identity field it changes.
struct StoreRuntimeTestVariant {
    field: String
    source: String
}

#Test("native runtime target dossier source invalidates runtime and core keys") {
    provider :: "target-providers-v1:sha256:provider-a"
    closure :: "prelude-hosted-v1:sha256:closure-a"
    base :: store_runtime_test_dossier_source("hosted", provider, closure)
    variants :: [StoreRuntimeTestVariant]{
        StoreRuntimeTestVariant{field: "layer", source: store_runtime_test_dossier_source("core", provider, closure)},
        StoreRuntimeTestVariant{field: "provider digest/identity", source: store_runtime_test_dossier_source("hosted", "target-providers-v1:sha256:provider-b", closure)},
        StoreRuntimeTestVariant{field: "Prelude closure", source: store_runtime_test_dossier_source("hosted", provider, "prelude-hosted-v1:sha256:closure-b")},
    }
    runtime_base :: store_runtime_test_key(@STORE_RUNTIME_CRATE_NAME, @STORE_RUNTIME_CRATE_PREFIX, None, base)
    core_base :: store_runtime_test_key(@STORE_RUNTIME_CORE_CRATE_NAME, @STORE_RUNTIME_CORE_CRATE_PREFIX, Val("runtime-key"), base)
    assert_eq(runtime_base, store_runtime_test_key(@STORE_RUNTIME_CRATE_NAME, @STORE_RUNTIME_CRATE_PREFIX, None, base))
    assert_eq(core_base, store_runtime_test_key(@STORE_RUNTIME_CORE_CRATE_NAME, @STORE_RUNTIME_CORE_CRATE_PREFIX, Val("runtime-key"), base))
    loop variant in variants {
        runtime_changed :: store_runtime_test_key(@STORE_RUNTIME_CRATE_NAME, @STORE_RUNTIME_CRATE_PREFIX, None, variant.source)
        core_changed :: store_runtime_test_key(@STORE_RUNTIME_CORE_CRATE_NAME, @STORE_RUNTIME_CORE_CRATE_PREFIX, Val("runtime-key"), variant.source)
        assert(runtime_base != runtime_changed, "{variant.field} source identity must invalidate the runtime rlib key")
        assert(core_base != core_changed, "{variant.field} source identity must invalidate the Core rlib key")
    }
}
