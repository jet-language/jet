// jetpack::BuildDebug unit tests: attempt JSON round trip with redaction,
// symlink-safe scratch preservation, and staging-only crash recovery.

fn recipe_debug_test_root(label: String) -[Env, Rand]> String {
    token :: random.token_hex(8) ?? panic("draw a build-debug test name")
    files.join(sys.temp_dir(), "jet-build-{label}-{sys.pid()}-{token}")
}

#Test("build attempt json round trips and redacts secrets") {
    attempt := BuildAttempt.new("weirdctl", "adapt:weirdctl:./vendor/weirdctl", "adapter", "rh", "sh")
    &attempt.push_step(StepLog{
        index: 1,
        total: 1,
        name: "install",
        command: "install missing bin/weirdctl",
        cwd: "/tmp/nope",
        status: "failed",
        stdout: "ok",
        stderr: "SECRET=value"
    })
    parsed :: recipe_debug_parse_attempt(attempt.to_json()) ?? panic("the attempt parses back")
    assert_eq(parsed.package, "weirdctl")
    assert_eq(parsed.failed_step, 1)
    assert(parsed.to_json().contains("<redacted>"))
}

#Test("build scratch preservation rejects a symlink without recording a path") {
    if sys.is_windows() -> return
    root :: recipe_debug_test_root("debug")
    source :: files.join(root, "source")
    outside :: files.join(root, "outside")
    files.create_dir_all(source) ?? panic("source")
    files.create_dir_all(outside) ?? panic("outside")
    files.write(files.join(outside, "live"), "must survive") ?? panic("live file")
    files.symlink(outside, files.join(source, "escape")) ?? panic("escape link")
    attempt := BuildAttempt.new("pkg", "pkg@1", "fixture", "recipe", "source")
    if attempt.preserve_scratch(root, source, files.join(root, "missing-output")) == {
        .Ok(_) -> panic("a symlinked source must stop scratch preservation")
        .Err(_) -> {}
    }
    assert_eq(attempt.scratch_dir, "")
    assert(!files.exists(files.join(files.join(root, BUILD_DEBUG_SCRATCH_ROOT), attempt.id)))
    assert_eq(files.read(files.join(outside, "live")) ?? panic("live file"), "must survive")
    recipe_debug_remove_tree(root).drop("test cleanup")
}

#Test("build scratch recovery removes only unpublished stages") {
    root :: recipe_debug_test_root("recover")
    hangar :: files.join(root, "hangar")
    stage :: files.join(files.join(hangar, BUILD_DEBUG_SCRATCH_ROOT), ".jet-build-stage-orphan")
    published :: files.join(files.join(hangar, BUILD_DEBUG_SCRATCH_ROOT), "pkg-1")
    files.create_dir_all(stage) ?? panic("stage")
    files.create_dir_all(published) ?? panic("published")
    files.write(files.join(stage, "partial"), "partial") ?? panic("partial")
    files.write(files.join(published, "source"), "published") ?? panic("published source")
    assert_eq(recipe_recover_build_scratch(hangar) ?? panic("recover"), 1)
    assert(!files.exists(stage))
    assert(files.is_dir(published))
    recipe_debug_remove_tree(root).drop("test cleanup")
}
