// jetpack::Store::Archive unit tests: portable node paths, link-safe tree
// removal, the binary wire round trip, private signer-key creation, signer
// entropy, the detached HMAC over the unsigned payload, and broker
// attestation of content-checked unsigned archives.

fn store_archive_test_root(label: String) -> String Never! {
    files.tmpdir("jet-archive-{label}-") ?? panic("claim archive test root")
}

fn store_archive_test_bytes(value: Int, count: Int) -> [U8] Never! {
    bytes := [U8]{}
    loop _ in 0..<count {
        &bytes.push(U8{value})
    }
    bytes
}

fn store_archive_test_cleanup(root: String) Never! {
    store_make_tree_writable_for_removal(root).drop("test cleanup")
    files.remove_all(root).drop("test cleanup")
}

#Test("hangar archive rejects parent and foreign separator paths") {
    assert(store_archive_validate_relative("../outside") == .Err(_))
    assert(store_archive_validate_relative("a/../../outside") == .Err(_))
    assert(store_archive_validate_relative("a\\outside") == .Err(_))
}

#Test("hangar archive tree removal drops a dangling symlink without following it") {
    if sys.is_windows() -> return
    root :: store_archive_test_root("remove-tree")
    outside :: files.join(root, "outside")
    link :: files.join(root, "link")
    files.symlink(outside, link) ?? panic("dangling link")
    store_archive_remove_tree(link) ?? panic("remove link")
    assert(files.stat(link) == .Err(_))
    assert(!files.exists(outside))
    store_archive_test_cleanup(root)
}

#Test("hangar archive round trip preserves binary nodes") {
    digest :: "sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    node :: HangarArchiveNode{path: "bin/tool", kind: HangarArchiveNodeKind.File, mode: 0o755, bytes: [U8]{U8{0}, U8{1}, U8{2}, U8{255}}}
    object :: HangarArchiveObject{id: digest, digest: digest, meta: "", root_mode: 0o755, nodes: [HangarArchiveNode]{node}}
    archive :: HangarArchive{root_id: digest, objects: [HangarArchiveObject]{object}, nix_manifest: None, signature: None}
    bytes :: archive.encode() ?? panic("encode")
    decoded :: HangarArchive.decode(bytes) ?? panic("decode")
    assert_eq(decoded.objects[0].nodes[0].bytes, [U8]{U8{0}, U8{1}, U8{2}, U8{255}})
    assert_eq(decoded.objects[0].nodes[0].mode, 0o755)
}

#Test("hangar archive generated signer key is private before publication") {
    if !sys.is_unix() -> return
    root :: store_archive_test_root("generated-key")
    roots :: HangarRoots.at(root)
    key :: store_archive_signing_key(roots, None, true) ?? panic("generate signer key")
    path :: files.join(files.join(root, "trust"), STORE_ARCHIVE_KEY)
    info :: files.stat(path) ?? panic("stat signer key")
    assert_eq(info.mode & 0o7777, 0o600)
    assert_eq(key.secret.len(), 32)
    store_archive_test_cleanup(root)
}

#Test("hangar archive signer key creation fails closed without private permissions") {
    if sys.is_unix() -> return
    root :: files.join(sys.temp_dir(), "jet-archive-generated-key-{process.current_pid()}")
    store_archive_remove_tree(root).drop("a stale fixture may be absent")
    roots :: HangarRoots.at(root)
    if store_archive_signing_key(roots, None, true) == {
        .Ok(_) -> panic("key creation must fail without private file permissions")
        .Err(error) -> assert(error.message().contains("private file permissions on this platform"))
    }
    assert(!files.exists(root))
}

#Test("hangar archive entropy is exactly key sized") {
    bytes :: store_archive_entropy() ?? panic("OS CSPRNG")
    assert_eq(bytes.len(), 32)
}

#Test("hangar archive signature covers the unsigned payload") {
    key :: TrustKey.from_secret(store_archive_test_bytes(7, 32)) ?? panic("trust key")
    digest :: "sha256-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    object :: HangarArchiveObject{id: digest, digest: digest, meta: "", root_mode: 0o755, nodes: [HangarArchiveNode]{}}
    archive :: HangarArchive{root_id: digest, objects: [HangarArchiveObject]{object}, nix_manifest: None, signature: None}
    signed :: store_archive_sign_decoded(archive, key) ?? panic("sign")
    decoded :: HangarArchive.decode(signed.encode() ?? panic("encode")) ?? panic("decode")
    root :: store_archive_test_root("signature")
    roots :: HangarRoots.at(root)
    key_path :: files.join(files.join(root, "trust"), "test.key")
    files.create_dir_all(files.dirname(key_path)) ?? panic("trust dir")
    files.write_bytes(key_path, store_archive_test_bytes(7, 32)) ?? panic("key file")
    decoded.verify_signature(roots, Val(key_path), false) ?? panic("signature must verify")
    signature :: decoded.signature ?? panic("decoded archive is signed")
    hex :: signature.sig_hex.bytes()
    replacement :: if pkg_bytes_text(hex, 0, 1) == "0" -> "1" else -> "0"
    tail :: pkg_bytes_text(hex, 1, hex.len())
    forged :: HangarArchiveSignature{key_id: signature.key_id, algorithm: signature.algorithm, sig_hex: "{replacement}{tail}"}
    tampered :: HangarArchive{root_id: decoded.root_id, objects: decoded.objects, nix_manifest: decoded.nix_manifest, signature: Val(forged)}
    assert(tampered.verify_signature(roots, Val(key_path), false) == .Err(_))
    store_archive_test_cleanup(root)
}

#Test("hangar archive broker attestation signs only a content checked unsigned archive") {
    root :: store_archive_test_root("broker-attestation")
    source :: files.join(root, "source")
    files.create_dir_all(files.join(source, "bin")) ?? panic("source dir")
    files.write(files.join(source, "bin/tool"), "verified\n") ?? panic("source tool")
    digest :: pkg_try_output_hash_of(source) ?? panic("source digest")
    root_mode :: (files.stat(source) ?? panic("stat source")).mode
    nodes :: store_archive_collect_nodes(source, false) ?? panic("collect nodes")
    object :: HangarArchiveObject{id: digest, digest: digest, meta: "", root_mode: root_mode, nodes: nodes}
    archive :: HangarArchive{root_id: digest, objects: [HangarArchiveObject]{object}, nix_manifest: None, signature: None}
    bytes :: archive.encode() ?? panic("encode")
    key_path :: files.join(files.join(root, "trust"), "broker.key")
    files.create_dir_all(files.dirname(key_path)) ?? panic("trust dir")
    files.write_bytes(key_path, store_archive_test_bytes(9, 32)) ?? panic("key file")
    roots :: HangarRoots.at(root)
    attested :: store_attest_archive(roots, bytes, key_path) ?? panic("attest")
    decoded :: HangarArchive.decode(attested) ?? panic("decode attested")
    assert(decoded.signature != None)
    decoded.verify_signature(roots, Val(key_path), false) ?? panic("attestation must verify")
    if store_attest_archive(roots, attested, key_path) == {
        .Ok(_) -> panic("a signed archive must not be attested again")
        .Err(error) -> assert(error.message().contains("must not carry a client signature"))
    }
    store_archive_test_cleanup(root)
}

#Test("hangar archive status JSON retains bytes objects root signed order") {
    report :: HangarArchiveReport{objects: 2, bytes: 12, signed: true, root: "sha256-é"}
    assert_eq(report.json("export"), "{{\"schema\":\"jet.status/v1\",\"action\":\"export\",\"ok\":true,\"reports\":[],\"bytes\":12,\"objects\":2,\"root\":\"sha256-é\",\"signed\":true}}")
}

// Rust Archive::map_member_path: empty members precede source validation,
// component prefixes (not string prefixes) determine containment.
#Test("hangar archive member remapping preserves identity and refuses escapes") {
    assert_eq(store_archive_map_member_path("", "", "/local") ?? panic("empty member"), "")
    assert_eq(store_archive_map_member_path("/old/out", "/old/out/bin/tool", "/local") ?? panic("bin"), "/local/bin/tool")
    assert_eq(store_archive_map_member_path("/old/out", "/old/out/lib/tool.rlib", "/local") ?? panic("rlib"), "/local/lib/tool.rlib")
    assert_eq(store_archive_map_member_path("/old/out", "/old/out", "/local") ?? panic("root member"), "/local/")
    assert_eq(store_archive_map_member_path("/old//out", "/old/out/./bin/tool", "/local") ?? panic("components"), "/local/bin/tool")
    unsafe_sources :: [String]{"", "/old/../out"}
    loop source in unsafe_sources {
        if store_archive_map_member_path(source, "/old/out/bin/tool", "/local") == {
            .Ok(_) -> panic("unsafe primary output must fail")
            .Err(error) -> assert_eq(error.message(), "archive package metadata has an unsafe primary output path")
        }
    }
    unsafe_members :: [String]{"/old/outside/tool", "/elsewhere/tool", "/old/out/../tool"}
    loop member in unsafe_members {
        if store_archive_map_member_path("/old/out", member, "/local") == {
            .Ok(_) -> panic("member escape must fail")
            .Err(error) -> assert_eq(error.message(), "archive package metadata points outside its primary output")
        }
    }
}

// Real metadata fixture, matching Rust portable_entry and the rekeying
// assertions in jetpack_hangar_store_v2::hangar_export_import_rekeys_...
#Test("hangar archive portable entry rekeys metadata and refuses forged identity") {
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    source :: store_test_ingest_fixture(&verification, roots, "portable", [String: String]{"out": "portable bytes\n"}, [String]{}).entry
    meta := pkg_parse_meta(source.meta_json()) ?? panic("parse admitted metadata")
    meta.bin = "{source.out}/bin/tool"
    meta.rlib = "{source.out}/lib/tool.rlib"
    destination :: HangarRoots.at(files.join(roots.root, "destination"))
    object :: HangarArchiveObject{id: source.id, digest: source.envelope.output_hash, meta: source.meta_json(), root_mode: 0, nodes: [HangarArchiveNode]{}}
    entry :: store_archive_portable_entry(destination, object, meta) ?? panic("portable entry")
    assert_eq(entry.out, files.join(files.join(destination.hangar_dir(), "objects"), object.digest))
    assert_eq(entry.id, store_entry_id(source.name, source.version, source.reference, entry.out))
    assert(entry.id != source.id)
    assert_eq(entry.bin, "{entry.out}/bin/tool")
    assert_eq(entry.rlib, "{entry.out}/lib/tool.rlib")
    assert_eq(entry.envelope, source.envelope)
    assert_eq(entry.cache_identity, source.cache_identity)
    assert_eq(entry.references, source.references)
    assert_eq(entry.named_outputs, source.named_outputs)
    assert_eq(entry.producer_record, source.producer_record)
    assert_eq(entry.receipt, source.receipt)
    assert_eq(entry.realized_at, source.realized_at)
    assert_eq(entry.last_used_at, source.last_used_at)
    forged :: HangarArchiveObject{id: "forged-identity", digest: object.digest, meta: object.meta, root_mode: 0, nodes: object.nodes}
    if store_archive_portable_entry(destination, forged, meta) == {
        .Ok(_) -> panic("forged identity must fail")
        .Err(error) -> assert_eq(error.message(), "archive package record `forged-identity` does not match its metadata identity")
    }
    meta.bin = "{source.out}/../outside"
    assert(store_archive_portable_entry(destination, object, meta) == .Err(_))
    store_test_drop_roots(roots)
}

// Preserve Rust's native rekey/idempotence/corruption assertions; the same
// invocation owner also observes the destination seal and closure proofs.
#Test("hangar archive import publishes idempotently with shared verification and rejects corruption") {
    verification := StoreVerification.new()
    store_arm_command_memo(&verification)
    roots :: store_test_temp_roots()
    source :: store_test_ingest_fixture(&verification, roots, "portable-import", [String: String]{"out": "portable bytes\n"}, [String]{}).entry
    exported :: store_export_archive(&verification, roots, source.id, true, None) ?? panic("export")
    key :: Val(files.join(files.join(roots.root, "trust"), STORE_ARCHIVE_KEY))
    destination :: HangarRoots.at(files.join(roots.root, "destination"))
    report :: store_import_archive(&verification, destination, exported.bytes, key, false) ?? panic("import")
    entry :: store_find_by_reference(&verification, destination, source.reference) ?? panic("imported entry")
    assert_eq(report.root, entry.id)
    assert_eq(entry.envelope.output_hash, source.envelope.output_hash)
    assert_eq(entry.id, store_entry_id(entry.name, entry.version, entry.reference, entry.out))
    assert(entry.id != source.id)
    assert_eq(files.read(files.join(entry.out, "payload")) ?? panic("payload"), "portable bytes\n")
    assert_eq(store_seal_memo_get(&verification, entry.out), Val(entry.envelope.output_hash))
    store_verify_hangar_object(&verification, destination, entry) ?? panic("verify imported object")
    graph :: store_closure_graph(&verification, destination) ?? panic("graph")
    assert_eq(graph.records[entry.id].primary, entry.envelope.output_hash)
    assert(entry.receipt != "")
    assert(files.is_file(files.join(files.join(destination.hangar_dir(), "receipts"), entry.receipt)))
    repeated :: store_import_archive(&verification, destination, exported.bytes, key, false) ?? panic("repeat import")
    assert_eq(repeated, report)
    assert_eq((store_list_checked(&verification, destination) ?? panic("listing")).len(), 1)
    corrupted := ~exported.bytes
    last :: corrupted.len() - 1
    corrupted[last] = corrupted[last] ^ U8{1}
    assert(store_import_archive(&verification, destination, corrupted, key, false) == .Err(_))
    after :: store_find_by_reference(&verification, destination, source.reference) ?? panic("still published")
    assert_eq(after.id, entry.id)
    assert_eq(after.envelope.output_hash, entry.envelope.output_hash)
    assert_eq(files.read(files.join(after.out, "payload")) ?? panic("unchanged payload"), "portable bytes\n")
    store_test_drop_roots(roots)
}

// Exercise the real import transaction past object publication. As in Rust
// import_archive_unlocked_with_policy, a late registration refusal must move
// every object back, remove its seal/proof from the SAME owner, and clean the
// stage. The duplicate batch deliberately calls the internal transaction:
// the public wire decoder correctly refuses duplicate records earlier.
#Test("hangar archive late registration refusal rolls back publication and shared seals") {
    verification := StoreVerification.new()
    store_arm_command_memo(&verification)
    roots :: store_test_temp_roots()
    dependency :: store_test_ingest_fixture(&verification, roots, "rollback-dependency", [String: String]{"out": "dependency\n"}, [String]{}).entry
    source :: store_test_ingest_fixture(&verification, roots, "rollback-root", [String: String]{"out": "root\n"}, [String]{dependency.envelope.output_hash}).entry
    bytes :: store_export_unsigned_archive(&verification, roots, source.id, true) ?? panic("export closure")
    archive := HangarArchive.decode(bytes) ?? panic("decode closure")
    duplicate := HangarArchiveObject?{None}
    loop object in archive.objects {
        if object.id == source.id && object.meta != "" {
            duplicate = Val(object)
            break
        }
    }
    &archive.objects.push(duplicate ?? panic("root package record"))
    destination :: HangarRoots.at(files.join(roots.root, "rollback"))
    if store_archive_import_unlocked(&verification, destination, archive, false) == {
        .Ok(_) -> panic("duplicate registration must refuse")
        .Err(error) -> assert(error.message().contains("closure batch contains duplicate record"))
    }
    digests :: [String]{dependency.envelope.output_hash, source.envelope.output_hash}
    loop digest in digests {
        path :: files.join(files.join(destination.hangar_dir(), "objects"), digest)
        assert(!files.exists(path))
        assert(!files.exists(files.join(files.join(destination.hangar_dir(), STORE_SEALS_DIR), digest)))
        assert_eq(store_seal_memo_get(&verification, path), None)
        assert(!store_proven_member_contains(&verification, store_proven_member_key(destination.hangar_dir(), digest)))
    }
    assert_eq((files.list_dir(files.join(destination.hangar_dir(), STORE_ARCHIVE_STAGE)) ?? panic("stages")).len(), 0)
    assert_eq((store_list_unlocked(destination) ?? panic("records")).len(), 0)
    store_verify_hangar_object(&verification, roots, source) ?? panic("source remains verified")
    assert_eq(files.read(files.join(source.out, "payload")) ?? panic("source payload"), "root\n")
    store_test_drop_roots(roots)
}
