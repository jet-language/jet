// tests/build_entry.rs:2095-2169, exact original concurrent builds and duplicate env override.
// PENDING-SEAM(package-tests): canonical Jetpack package test staging after gate 2.
// The two builders use their own run-cache, NOT the holder store (original lines 2129-2131).
use concurrent_process :: core.process

fn store_concurrent_build_spec(jet: String, scratch: String, store: String) -> ProcessSpec {
    concurrent_process.cmd([String]{jet, "build", "main.jet"}).cwd(scratch)
        .env("JET_STORE_DIR", store)
        .env("JET_STORE_RESERVE_BYTES", "0")
        .env("JET_STORE_DIR", files.join(scratch, "run-cache"))
        .env("NO_COLOR", "1")
}

// The claim process itself holds the shared store lock (a live owner) while
// two separate `jet build` processes run, so the holder is still a different
// process from both builders.
fn store_concurrent_original() {
    jet :: sys.get("JET_BIN") ?? panic("JET_BIN must name the admitted test jet")
    left :: files.tmpdir("concurrent-build-left-") ?? panic("left scratch")
    right :: files.tmpdir("concurrent-build-right-") ?? panic("right scratch")
    scratches :: [String]{left, right}
    loop scratch in scratches {
        files.write(files.join(scratch, "package.jet"), "name: \"concurrent-build\"\nversion: \"0.1.0\"\nauthority: {{ allow: [IO] }}\n") ?? panic("package source")
        files.write(files.join(scratch, "main.jet"), "\nfn run() {{\n    print(\"shared store\")\n}}\n") ?? panic("main source")
    }
    store :: files.join(left, "store")
    holder :: ArtifactStore.open(ArtifactStoreConfig.new(store).with_reserve_bytes(0)) ?? panic("open shared store lock holder")
    owner :: ArtifactProcessIdentity.current() ?? panic("current process identity")
    lock :: files.join(holder.root(), "locks/store.lock")
    files.write(lock, "jet.store.v1|lock|{owner.pid()}|{owner.start()}\n") ?? panic("hold shared store lock")
    left_child := store_concurrent_build_spec(jet, left, store).spawn() ?? panic("spawn left concurrent build")
    right_child := store_concurrent_build_spec(jet, right, store).spawn() ?? panic("spawn right concurrent build")
    time.sleep(time.duration_ms(3000))
    files.remove(lock) ?? panic("release shared store lock")
    left_build :: left_child.wait() ?? panic("wait left build")
    right_build :: right_child.wait() ?? panic("wait right build")
    assert(left_build.success, "left concurrent build failed: {left_build.output} {left_build.errors}")
    assert(right_build.success, "right concurrent build failed: {right_build.output} {right_build.errors}")
    loop scratch in scratches {
        result :: concurrent_process.cmd([String]{files.join(scratch, ".jet/build/main")}).cwd(scratch).stdout(.Capture).stderr(.Capture).run() ?? panic("run concurrent build binary")
        assert(result.success, "binary failed: {result.output} {result.errors}")
        assert_eq(result.output.trim(), "shared store")
    }
    files.remove_all(left).drop("left scratch cleanup")
    files.remove_all(right).drop("right scratch cleanup")
}

#Test("concurrent_jet_builds_share_store_lock_and_run") {
    store_concurrent_original()
}

// #4687 (jet-store `concurrent_processes_open_one_fresh_store`): eight jet
// processes open one EMPTY store at once, four rounds; every opener succeeds
// and the complete layout exists after each round. Each opener is
// `jet cache status`, which opens the machine-wide store named by
// JET_STORE_DIR (1 MiB cap, no reserve) and reads it, so the jet CLI store is
// what the racing processes create.
fn store_concurrent_fresh_original() {
    jet :: sys.get("JET_BIN") ?? panic("JET_BIN must name the admitted test jet")
    scratch :: files.tmpdir("concurrent-fresh-store-") ?? panic("fresh store scratch")
    root :: files.join(scratch, "store")
    loop round in 0..<4 {
        if files.exists(root) -> files.remove_all(root) ?? panic("reset fresh store")
        children := [ProcessChild]{}
        loop _ in 0..<8 {
            &children.push(concurrent_process.cmd([String]{jet, "cache", "status"})
                .env("JET_STORE_DIR", root).env("JET_STORE_CAP_BYTES", "1048576").env("JET_STORE_RESERVE_BYTES", "0").env("NO_COLOR", "1")
                .stdout(.Capture).stderr(.Capture).spawn() ?? panic("spawn fresh store opener"))
        }
        loop at in 0..<children.len() {
            opened :: children[at].wait() ?? panic("wait fresh store opener")
            assert(opened.success, "round {round}: a concurrent open of a fresh store failed: {opened.output} {opened.errors}")
        }
        loop name in ([String]{"cas", "ac", "lto", "locks", "leases", "quarantine", "build-records/records"}) {
            assert(files.is_dir(files.join(root, name)), "round {round}: missing {name}")
        }
    }
    files.remove_all(scratch).drop("fresh store scratch cleanup")
}

#Test("concurrent_jet_processes_open_one_fresh_store") {
    store_concurrent_fresh_original()
}
