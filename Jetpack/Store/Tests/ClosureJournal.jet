// Closure journal integrity claims ported from
// crates/jetpack/src/Store/Journal.rs (integrity_tests).

fn store_test_checked(body: String) -> String Never! {
    "{body}checksum\t{store_sha256_hex(body.bytes())}\n"
}

fn store_test_nix_projection_record(id: String, output_name: String, digest: String, reference: String) -> ClosureRecord Never! {
    drv :: "/nix/store/canonical-action.drv"
    output_path :: "/nix/store/{digest}"
    plan :: ProviderPlanFacts.from_facts([String: String]{"nix.drv_path": drv, "nix.reference": reference, "nix.output.{output_name}": output_path}) ?? panic("plan facts must build")
    producer :: ProducerRecord.new("nix", drv, store_sha256_hex(drv.bytes()), plan, "nix-derivation:{drv}", "policy=test\nplatform=test", [String: String]{"nix.drv_path": drv, "nix.output.{output_name}": output_path}) ?? panic("producer must build")
    ClosureRecord{
        id: id,
        primary: digest,
        action_key: "sha256-same-action",
        outputs: [String: String]{"out": digest, output_name: digest},
        references: [String]{},
        producer_record: producer.encode(),
        package_meta: "",
    }
}

#Test("store canonical action merges multi-output alias projections and rejects conflicting bytes") {
    out :: store_test_nix_projection_record("alias-out", "out", "sha256-out", "pkg@nixpkgs")
    dev :: store_test_nix_projection_record("alias-dev", "dev", "sha256-dev", "pkg.dev@stable")
    objects := [ClosureObject]{}
    digests :: [String]{"sha256-out", "sha256-dev"}
    loop digest in digests -> &objects.push(ClosureObject{digest: digest, path: "/nix/store/{digest}", external: true})
    graph := ClosureGraph.empty()
    store_apply_entry(&graph, ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: objects, records: [ClosureRecord]{out, dev}, deleted_records: [String]{}}) ?? panic("delta must apply")
    assert_eq(graph.action_outputs("sha256-same-action"), [String: String]{"dev": "sha256-dev", "out": "sha256-out"})

    conflict :: store_test_nix_projection_record("alias-dev-conflict", "dev", "sha256-other-dev", "other:pkg.dev")
    actions := [String: CanonicalActionRecord]{}
    loop record in graph.sorted_records() {
        store_merge_action_record(&actions, record) ?? panic("existing records must merge")
    }
    if store_merge_action_record(&actions, conflict) == {
        .Ok(_) -> panic("conflicting bytes must be refused")
        .Err(error) -> assert(error.message().contains("conflicting bytes"))
    }
}

#Test("store journal parser rejects duplicate record ids and output names") {
    id :: store_hex_text("record")
    primary :: store_hex_text("sha256-primary")
    action :: store_hex_text("sha256-action")
    duplicate_record :: store_test_checked("jet-closure-journal-v1\nkind\tdelta\nrecord\t{id}\t{primary}\t{action}\nrecord\t{id}\t{primary}\t{action}\n")
    if store_parse_journal_entry(duplicate_record) == {
        .Ok(_) -> panic("duplicate record must be refused")
        .Err(error) -> assert(error.message().contains("duplicate closure record"))
    }
    out :: store_hex_text("out")
    duplicate_output :: store_test_checked("jet-closure-journal-v1\nkind\tdelta\nrecord\t{id}\t{primary}\t{action}\noutput\t{id}\t{out}\t{primary}\noutput\t{id}\t{out}\t{primary}\n")
    if store_parse_journal_entry(duplicate_output) == {
        .Ok(_) -> panic("duplicate output must be refused")
        .Err(error) -> assert(error.message().contains("duplicate output"))
    }
}

#Test("store journal parser requires exact checksum framing") {
    valid :: store_test_checked("jet-closure-journal-v1\nkind\tdelta\n")
    assert(store_parse_journal_entry(valid) == .Ok(_))
    if store_parse_journal_entry(valid.trim_end()) == {
        .Ok(_) -> panic("unterminated checksum must be refused")
        .Err(error) -> assert(error.message().contains("truncated"))
    }
    if store_parse_journal_entry("{valid}\n") == {
        .Ok(_) -> panic("trailing newline must be refused")
        .Err(error) -> assert(error.message().contains("invalid checksum frame"))
    }
    halves :: store_text_split_last(valid, "checksum\t") ?? panic("valid entry has a checksum")
    if store_parse_journal_entry("{halves.before}checksum\t{halves.after.upper()}") == {
        .Ok(_) -> panic("uppercase checksum must be refused")
        .Err(error) -> assert(error.message().contains("invalid checksum frame"))
    }
}

#Test("store graph validation rejects external and relation inconsistency") {
    roots :: HangarRoots{root: files.join(sys.temp_dir(), "jet-closure-integrity-{process.current_pid()}"), dev_mode: true}
    digest :: "sha256-primary"
    object :: ClosureObject{digest: digest, path: files.join(files.join(roots.hangar_dir(), @STORE_OBJECTS_DIR), digest), external: true}
    record :: ClosureRecord{id: "record", primary: digest, action_key: "sha256-action", outputs: [String: String]{"out": digest}, references: [String]{}, producer_record: "", package_meta: ""}
    graph := ClosureGraph{objects: [String: ClosureObject]{digest: object}, records: [String: ClosureRecord]{"record": record}, deleted_records: [String]{}}
    if store_validate_graph(roots, graph) == {
        .Ok(_) -> panic("wrong external marker must be refused")
        .Err(error) -> assert(error.message().contains("invalid external marker"))
    }
    graph.objects[digest].external = false
    graph.records["record"].primary = "sha256-other"
    if store_validate_graph(roots, graph) == {
        .Ok(_) -> panic("primary outside outputs must be refused")
        .Err(error) -> assert(error.message().contains("primary is not its `out` output"))
    }
    graph.records["record"].primary = digest
    graph.records["record"].references = [String]{"sha256-missing"}
    if store_validate_graph(roots, graph) == {
        .Ok(_) -> panic("missing reference must be refused")
        .Err(error) -> assert(error.message().contains("references missing object"))
    }
}
