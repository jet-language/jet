// External consumer roots (Rust Store/Lifecycle.rs external-root section):
// manually retained Hangar closures and profile-generation roots. The
// lifecycle journal stays the source of truth; this is the typed Store view
// and the adapter that resolves a Hangar reference to its complete closure
// under the Hangar lock.

// One manually retained closure as the external-root CLI and consumers see
// it.
pub struct ExternalRootView {
    label: String
    reference: String
    etag: String
    closure_size: Int
    prepared: Bool
    expires_at: Int?
}

#Error
pub enum ExternalRootError {
    Conflict(label: String, expected: String?, current: String?)
    ReferenceNotFound(String)
    Store(StoreError)

    fn message(self) -> String Never! {
        if self == {
            .Conflict(label, expected, current) -> "external root `{label}` changed before the request applied (expected {store_external_root_debug_option(expected)}, current {store_external_root_debug_option(current)})"
            .ReferenceNotFound(reference) -> "no Hangar entry matches `{reference}`"
            .Store(error) -> error.message()
        }
    }
}

impl StoreError -> ExternalRootError { ExternalRootError.Store(self) }

// Rust `{:?}` of `Option<String>`: `Some("…")` or `None`.
fn store_external_root_debug_option(value: String?) -> String Never! {
    if value == {
        .Val(text) -> "Some({pkg_overlay_debug_text(text)})"
        .None -> "None"
    }
}

// Rust `validate_external_root_label`: one safe path component.
fn store_external_root_validate_label(label: String) StoreError! {
    raw :: label.bytes()
    unsafe_label :: raw.len() == 0 || raw.len() > 128 || label == "." || label == ".." || label.contains("/") || label.contains("\\")
    if unsafe_label -> return Err(StoreError.InvalidInput("external root label must be one safe path component"))
    loop byte in raw {
        code :: Int.from_u8(byte)
        if code < 32 || code == 127 -> return Err(StoreError.InvalidInput("external root label must be one safe path component"))
    }
}

fn store_external_root_manual_id(principal: ProducerID, label: String) -> RootID StoreError! {
    RootID.new("manual:{principal.as_str()}:{label}")
}

// Rust `manual_root_witness`: length-framed principal, label and reference,
// then the closure targets, digested.
fn store_external_root_manual_witness(principal: ProducerID, label: String, reference: String, targets: [String]) -> RootWitness StoreError! {
    canonical := [String]{"jet-manual-root-v1\n"}
    framed :: [String]{principal.as_str(), label, reference}
    loop value in framed -> &canonical.push("{value.bytes().len()}\n{value}\n")
    loop target in targets -> &canonical.push("{target}\n")
    text :: canonical.join("")
    RootWitness.new("sha256-{pkg_sha256_hex(text.bytes())}")
}

// Rust `external_root_targets_unlocked`: the sorted closure of the Hangar
// entry whose reference is `reference`.
fn store_external_root_targets_unlocked(roots: HangarRoots, reference: String, graph: ClosureGraph) -[FS, Env]> [String] StoreError! {
    entries :: store_list_unlocked(roots)
    loop entry in entries {
        if entry.reference != reference -> next
        targets :: store_lifecycle_sorted_set(graph.closure(entry.envelope.output_hash))
        if targets.len() == 0 -> return Err(StoreError.InvalidData("Hangar entry `{reference}` has no closure objects"))
        return Ok(targets)
    }
    Err(StoreError.NotFound("no Hangar entry matches `{reference}`"))
}

fn store_external_root_targets_locked(verification: &StoreVerification, roots: HangarRoots, reference: String) -[FS, Env]> [String] StoreError! {
    session :: store_lifecycle_session(&verification, roots)
    graph :: store_lifecycle_closure_graph_unlocked(&verification, roots)
    store_external_root_targets_unlocked(roots, reference, graph)
}

// Rust `external_root_targets`.
fn store_external_root_targets(verification: &StoreVerification, roots: HangarRoots, reference: String) -[FS, Env]> [String] ExternalRootError! {
    if store_external_root_targets_locked(&verification, roots, reference) == {
        .Ok(targets) -> Ok(targets)
        .Err(error) -> {
            if store_external_root_is_missing_reference(error, reference) -> return Err(ExternalRootError.ReferenceNotFound(reference))
            Err(ExternalRootError.Store(error))
        }
    }
}

// Rust `is_missing_external_reference`.
fn store_external_root_is_missing_reference(error: StoreError, reference: String) -> Bool Never! {
    if error == {
        .NotFound(message) -> message == "no Hangar entry matches `{reference}`"
        else -> false
    }
}

// Rust `external_root_closure_size`.
pub fn store_external_root_closure_size(verification: &StoreVerification, roots: HangarRoots, reference: String) -[FS, Env]> Int ExternalRootError! {
    targets :: store_external_root_targets(&verification, roots, reference)
    Ok(targets.len())
}

// Rust `external_root_view`.
fn store_external_root_view(root: LifecycleRoot) -> ExternalRootView StoreError! {
    label :: root.metadata.label ?? return Err(StoreError.InvalidData("manual lifecycle root has no label metadata"))
    reference :: root.metadata.reference ?? return Err(StoreError.InvalidData("manual lifecycle root has no reference metadata"))
    expires_at :: if root.metadata.expires_at == {
        .Val(timestamp) -> Val(timestamp.get())
        .None -> None
    }
    Ok(ExternalRootView{label, reference, etag: root.etag().render(), closure_size: root.targets.len(), prepared: root.phase == RootPhase.Prepared, expires_at})
}

// Rust `map_external_root_error`: a compare-and-swap refusal names the label.
fn store_external_root_map_error(label: String, error: StoreError) -> ExternalRootError Never! {
    if error == {
        .LifecycleConflict(expected, current) -> ExternalRootError.Conflict{label, expected, current}
        else -> ExternalRootError.Store(error)
    }
}

fn store_external_root_register_locked(verification: &StoreVerification, roots: HangarRoots, id: RootID, producer: ProducerID, label: String, reference: String, metadata: RootMetadata, expected_etag: String?, expected: RootEtag?, at: Int) -[FS, Env, Time]> LifecycleSnapshot StoreError! {
    session :: store_lifecycle_session(&verification, roots)
    graph :: store_lifecycle_closure_graph_unlocked(&verification, roots)
    targets :: store_external_root_targets_unlocked(roots, reference, graph)
    witness :: store_external_root_manual_witness(producer, label, reference, targets)
    identity :: RootIdentity.new(RootKind.Manual, id, producer, Incarnation.new(1), witness)
    update :: RootUpdate{identity, targets, metadata, expected_etag, at: LifecycleTimestamp.from_unix_seconds(at)}
    store_lifecycle_atomic_update_unlocked(roots, update, expected, session.known, session.closure_head)
}

fn store_external_root_register_snapshot(verification: &StoreVerification, roots: HangarRoots, id: RootID, producer: ProducerID, label: String, reference: String, metadata: RootMetadata, expected_etag: String?, expected: RootEtag?, at: Int) -[FS, Env, Time]> LifecycleSnapshot ExternalRootError! {
    if store_external_root_register_locked(&verification, roots, id, producer, label, reference, metadata, expected_etag, expected, at) == {
        .Ok(snapshot) -> Ok(snapshot)
        .Err(error) -> {
            if store_external_root_is_missing_reference(error, reference) -> return Err(ExternalRootError.ReferenceNotFound(reference))
            Err(store_external_root_map_error(label, error))
        }
    }
}

// Rust `register_external_root_at`: atomically create or replace one
// manually retained Hangar closure. Lifecycle owns the typed identity, the
// compare-and-swap check, expiry metadata and the prepare/commit sequence;
// this adapter resolves the reference to its complete closure.
pub fn store_register_external_root_at(verification: &StoreVerification, roots: HangarRoots, principal: String, label: String, reference: String, expires_at: Int?, expected_etag: String?, at: Int) -[FS, Env, Time]> ExternalRootView ExternalRootError! {
    store_external_root_validate_label(label)
    producer :: ProducerID.new(principal)
    expiry :: if expires_at == {
        .Val(seconds) -> Val(LifecycleTimestamp.from_unix_seconds(seconds))
        .None -> None
    }
    metadata :: RootMetadata.manual(label, reference, expiry)
    id :: store_external_root_manual_id(producer, label)
    expected := RootEtag?{None}
    if expected_etag == {
        .Val(text) -> expected = Val(RootEtag.parse(text))
        .None -> {}
    }
    snapshot :: store_external_root_register_snapshot(&verification, roots, id, producer, label, reference, metadata, expected_etag, expected, at)
    root :: snapshot.roots.get(id.as_str()) ?? return Err(ExternalRootError.Store(StoreError.InvalidData("manual lifecycle root `{label}` disappeared after update")))
    Ok(store_external_root_view(root))
}

// Rust `list_external_roots`: the principal's live manual roots.
pub fn store_list_external_roots(verification: &StoreVerification, roots: HangarRoots, principal: String) -[FS, Env, Time]> [ExternalRootView] ExternalRootError! {
    producer :: ProducerID.new(principal)
    snapshot :: store_lifecycle_snapshot(&verification, roots)
    views := [ExternalRootView]{}
    live_roots :: snapshot.root_list()
    loop root in live_roots {
        if root.identity.kind != RootKind.Manual || root.identity.producer != producer || root.phase == RootPhase.Tombstoned -> next
        &views.push(store_external_root_view(root))
    }
    Ok(views)
}

fn store_external_root_remove(verification: &StoreVerification, roots: HangarRoots, id: RootID, label: String, expected_etag: String, at: Int) -[FS, Env, Time]> LifecycleSnapshot ExternalRootError! {
    if store_lifecycle_atomic_remove(&verification, roots, id, expected_etag, LifecycleTimestamp.from_unix_seconds(at)) == {
        .Ok(snapshot) -> Ok(snapshot)
        .Err(error) -> Err(store_external_root_map_error(label, error))
    }
}

// Rust `unregister_external_root_at`.
pub fn store_unregister_external_root_at(verification: &StoreVerification, roots: HangarRoots, principal: String, label: String, expected_etag: String, at: Int) ExternalRootError! -[FS, Env, Time]> {
    store_external_root_validate_label(label)
    producer :: ProducerID.new(principal)
    id :: store_external_root_manual_id(producer, label)
    snapshot :: store_lifecycle_snapshot(&verification, roots)
    if !snapshot.roots.has_key(id.as_str()) -> return Err(ExternalRootError.Store(StoreError.NotFound("external root `{label}` was not found")))
    root :: snapshot.roots[id.as_str()]
    if root.identity.kind != RootKind.Manual || root.identity.producer != producer {
        return Err(ExternalRootError.Store(StoreError.PermissionDenied("external root `{label}` is owned by another producer")))
    }
    store_external_root_remove(&verification, roots, id, label, expected_etag, at)
}

// Rust `reconcile_profile_generation_root`: prepare the immutable root of
// one profile generation; None when it is already committed, otherwise the
// exact incarnation and witness the caller must commit.
pub fn store_reconcile_profile_generation_root(verification: &StoreVerification, roots: HangarRoots, owner: String, profile: String, generation: Int, witness: String, targets: [String], at: Int) -[FS, Env, Time]> PreparedProfileGenerationRoot? StoreError! {
    id :: RootID.new("profile-generation:{owner}:{profile}:{generation}")
    incarnation :: Incarnation.new(1)
    root_witness :: RootWitness.new(witness)
    identity :: RootIdentity.new(RootKind.ProfileGeneration, id, ProducerID.new("jetpack-profile-generation"), incarnation, root_witness)
    snapshot :: store_lifecycle_prepare_if_absent(&verification, roots, identity, store_lifecycle_sorted_set(targets), LifecycleTimestamp.from_unix_seconds(at))
    root :: snapshot.roots.get(id.as_str()) ?? return Err(StoreError.Other("generation root disappeared after prepare"))
    if root.phase == RootPhase.Committed -> return Ok(None)
    Ok(Val(PreparedProfileGenerationRoot{id, incarnation, witness: root_witness}))
}
