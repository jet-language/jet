// Rust: crates/jetpack/src/Store/Cache.rs:2503
fn bounded_stderr(bytes: [U8]) -> String {
    // GATE #4494: native UTF-8 lossy decoding; retain invalid interior bytes too.
    end :: bytes.len().min(4096)
    text :: String.from_utf8_lossy(bytes[0..<end])
    trimmed := text.trim() // #4303
    trimmed.to_string()
}

// Rust: crates/jetpack/src/Store/Cache.rs:2513
fn run_bounded_output(child: ^std.process.Child, limit: U64, label: String) -> (std.process.ExitStatus, [U8], [U8]) IOError! {
    // GATE #4494: native pipe ownership, child kill/wait and helper thread.
    owned := ^child
    stdout := &owned.stdout.take() ?? {
        _ :: &owned.kill()
        _ :: &owned.wait()
        return Err(IOError.new(.InvalidData, "{label} has no output pipe")) // #4409
    }
    stderr_thread := None
    if &owned.stderr.take() == {
        .Val(stream) -> {
            stderr_thread = Val(std.thread.spawn(() -> {
                stderr := ^stream
                bytes := [U8]{}
                buffer := [U8].repeat(U8{0}, 4096)
                loop {
                    if &stderr.read(&buffer) == {
                        .Ok(0) -> break
                        .Ok(read) -> {
                            if bytes.len() < 4096 {
                                keep :: read.min(4096 - bytes.len())
                                loop at in 0..<keep -> &bytes.push(buffer[at])
                            }
                        }
                        .Err(_) -> break
                    }
                }
                bytes
            }))
        }
        .None -> {}
    }
    // GATE #4483: checked conversion to selected target pointer width.
    maximum :: USize.try_from(limit.saturating_add(U64{1})) ?? return Err(IOError.new(.InvalidData, "{label} bound is too large"))
    bytes := [U8]{}
    &stdout.take(maximum.as_u64()).read_to_end(&bytes)
    if bytes.len() >= maximum {
        _ :: &owned.kill()
        _ :: &owned.wait()
        if stderr_thread == {
            .Val(handle) -> _ :: handle.join()
            .None -> {}
        }
        return Err(IOError.new(.InvalidData, "{label} exceeded its bound"))
    }
    status :: &owned.wait()
    stderr := [U8]{}
    if stderr_thread == {
        .Val(handle) -> stderr = handle.join() ?? [U8]{}
        .None -> {}
    }
    Ok((status, bytes, stderr))
}

// Rust: crates/jetpack/src/Store/Cache.rs:2561
fn null_device() -> String {
    // GATE #4483: selected target, not compiler-host OS.
    if target.selected_os() == .Windows -> "NUL" else -> "/dev/null"
}

