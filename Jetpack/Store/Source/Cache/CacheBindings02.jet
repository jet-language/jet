// Rust: crates/jetpack/src/Store/Cache.rs:2927
fn line(output: &String, name: String, value: String) -> StoreError! {
    store_cache_validate_text(name, "cache binding field")
    store_cache_validate_text(value, "cache binding value")
    &output.push_str(name)
    &output.push_str("=")
    &output.push_str(value)
    &output.push_str("\n")
    Ok(())
}

