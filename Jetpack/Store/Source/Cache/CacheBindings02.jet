//RS         std::thread::spawn(move || {
//RS             let mut bytes = Vec::new();
//RS             let mut buffer = [0u8; 4096];
//RS             loop {
//RS                 match stderr.read(&mut buffer) {
//RS                     Ok(0) => break,
//RS                     Ok(read) => {
//RS                         if bytes.len() < 4096 {
//RS                             let keep = read.min(4096 - bytes.len());
//RS                             bytes.extend_from_slice(&buffer[..keep]);
//RS                         }
//RS                     }
//RS                     Err(_) => break,
//RS                 }
//RS             }
//RS             bytes
//RS         })
//RS     });
//RS     let max = usize::try_from(limit.saturating_add(1))
//RS         .map_err(|_| invalid(&format!("{label} bound is too large")))?;
//RS     let mut bytes = Vec::new();
//RS     stdout.take(max as u64).read_to_end(&mut bytes)?;
