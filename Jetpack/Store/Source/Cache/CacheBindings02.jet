// Rust: crates/jetpack/src/Store/Cache.rs:2837
fn validate_path_components(value: OSPath) -> IOError! {
    // GATE #4494: native selected-platform components/lstat, never decode to text.
    if !value.is_absolute() -> return Err(IOError.new(.InvalidData, "cache path must be absolute"))
    current := OSPath.new()
    loop component in value.components() {
        if component == {
            .Prefix(prefix) -> &current.push(prefix.as_os_str())
            .RootDir -> &current.push(std.path.MAIN_SEPARATOR_STR)
            .Normal(name) -> {
                &current.push(name)
                if std.fs.symlink_metadata(current) == {
                    .Ok(metadata) -> {
                        if metadata.file_type().is_symlink() -> return Err(IOError.new(.InvalidData, "cache path cannot traverse a symlink"))
                    }
                    .Err(_) -> {}
                }
            }
            .CurDir | .ParentDir -> return Err(IOError.new(.InvalidData, "cache path contains an unsafe component"))
        }
    }
    Ok(())
}

