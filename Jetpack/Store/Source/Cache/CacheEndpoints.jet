// Binary-cache endpoint adapters (Rust `Store/Cache.rs`, endpoint half).
//
// A mirror URL parses into one typed endpoint with a fixed capability row.
// Every endpoint exchanges the same signed narinfo and canonical NAR bytes:
// local directories directly, HTTP GET through Core HTTP with a byte cap,
// and HTTP PUT, SSH, and S3 through the host `curl`, `ssh`, and `aws` tools
// with bounded output. Remote writes are staged as `<key>.partial`, read
// back, and then promoted, so a reader never sees a half-written object.
// Nix store endpoints are retired; no Nix process is ever started here.

@STORE_CACHE_HTTP_TIMEOUT_SECONDS :: 120
@STORE_CACHE_STDERR_LIMIT :: 4096

// What an endpoint can do. `credential_required` endpoints need an explicit
// typed credential provider; none may execute remote commands.
pub struct CacheEndpointCapabilities {
    pub read: Bool
    pub write: Bool
    pub promote: Bool
    pub remote_execute: Bool
    pub trust: Bool
    pub credential: Bool
    pub credential_required: Bool
}

// One parsed cache mirror.
pub enum CacheEndpoint {
    Local(String)
    Http(String)
    Ssh(target: String, root: String)
    S3(String)
    Hangar

    fn capabilities(self) -> CacheEndpointCapabilities Never! {
        if self == {
            .Local(_) -> CacheEndpointCapabilities{read: true, write: true, promote: true, remote_execute: false, trust: true, credential: false, credential_required: false}
            // Hangar is the source store, not a cache publication transport.
            // It can satisfy a read locally, but publishing a NAR/narinfo back
            // into the same object is not a cache operation and must not
            // report success without writing the cache protocol objects.
            .Hangar -> CacheEndpointCapabilities{read: true, write: false, promote: false, remote_execute: false, trust: true, credential: false, credential_required: false}
            .Ssh(_, _) | .S3(_) -> CacheEndpointCapabilities{read: true, write: true, promote: true, remote_execute: false, trust: true, credential: true, credential_required: true}
            .Http(_) -> CacheEndpointCapabilities{read: true, write: false, promote: false, remote_execute: false, trust: true, credential: true, credential_required: false}
        }
    }

    fn label(self) -> String Never! {
        if self == {
            .Local(_) -> "file"
            .Http(_) -> "http"
            .Ssh(_, _) -> "ssh"
            .S3(_) -> "s3"
            .Hangar -> "hangar"
        }
    }

    fn is_hangar(self) -> Bool Never! {
        if self == {
            .Hangar -> true
            else -> false
        }
    }
}

// Parse one mirror spelling. A bare absolute path is a local mirror.
fn store_cache_parse_endpoint(endpoint: String) -> CacheEndpoint StoreError! {
    store_cache_validate_text(endpoint, "cache endpoint")
    if endpoint == "hangar://local" || endpoint == "hangar://" -> return Ok(CacheEndpoint.Hangar)
    if endpoint.starts_with("file://") {
        path :: store_cache_absolute_endpoint_path(endpoint.removeprefix("file://"), "file cache endpoint")
        return Ok(CacheEndpoint.Local(path))
    }
    if endpoint.starts_with("http://") || endpoint.starts_with("https://") {
        store_cache_validate_http_base(endpoint)
        return Ok(CacheEndpoint.Http(store_cache_trim_trailing_slashes(endpoint)))
    }
    if endpoint.starts_with("ssh://") || endpoint.starts_with("ssh-ng://") -> return store_cache_parse_ssh_endpoint(endpoint)
    if endpoint.starts_with("s3://") {
        store_cache_validate_s3_uri(endpoint)
        return Ok(CacheEndpoint.S3(store_cache_trim_trailing_slashes(endpoint)))
    }
    if endpoint.starts_with("daemon://") || endpoint.starts_with("nix://") {
        return Err(StoreError.InvalidData("Nix store endpoints are retired; use Jetpack's native cache protocol"))
    }
    Ok(CacheEndpoint.Local(store_cache_absolute_endpoint_path(endpoint, "cache mirror")))
}

fn store_cache_trim_trailing_slashes(value: String) -> String Never! {
    trimmed := value
    loop trimmed.ends_with("/") -> trimmed = trimmed.removesuffix("/")
    trimmed
}

fn store_cache_absolute_endpoint_path(raw: String, label: String) -> String StoreError! {
    if raw == "" || !raw.starts_with("/") -> return Err(StoreError.InvalidData("{label} must contain an absolute path"))
    if raw.contains("?") || raw.contains("#") -> return Err(StoreError.InvalidData("{label} cannot contain a query or fragment"))
    store_cache_validate_path_components(raw)
    Ok(raw)
}

// `ssh://host[/root]` and `ssh-ng://host[/root]`; the root defaults to
// `/var/cache/jet`.
fn store_cache_parse_ssh_endpoint(endpoint: String) -> CacheEndpoint StoreError! {
    parts :: endpoint.split_once("://") ?? return Err(StoreError.InvalidData("SSH endpoint is missing its scheme"))
    scheme :: parts.before
    rest :: parts.after
    split :: rest.split_once("/")
    authority :: split?.before ?? rest
    path :: split?.after ?? ""
    safe := authority != "" && !authority.starts_with("-")
    loop byte in authority.bytes() {
        code :: Int.from_u8(byte)
        alphanumeric :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
        if !(alphanumeric || code == 46 || code == 95 || code == 64 || code == 58 || code == 45) -> safe = false
    }
    if !safe -> return Err(StoreError.InvalidData("SSH endpoint has an unsafe host name"))
    root :: if path == "" -> "/var/cache/jet" else -> "/{path}"
    store_cache_validate_remote_key(root)
    if scheme != "ssh" && scheme != "ssh-ng" -> return Err(StoreError.InvalidData("unknown SSH endpoint scheme"))
    Ok(CacheEndpoint.Ssh{target: authority, root: root})
}

fn store_cache_validate_http_base(endpoint: String) StoreError! {
    parts :: endpoint.split_once("://") ?? return Err(StoreError.InvalidData("HTTP endpoint is missing its scheme"))
    rest :: parts.after
    segments :: rest.split("/").to_list()
    authority :: segments[0]
    if authority == "" || authority.starts_with("-") || authority.contains("@") || authority.contains("?") || authority.contains("#") || store_cache_has_whitespace(authority) {
        return Err(StoreError.InvalidData("HTTP endpoint has an unsafe host name"))
    }
    if segments.contains("..") -> return Err(StoreError.InvalidData("HTTP endpoint contains a parent path"))
}

fn store_cache_validate_s3_uri(endpoint: String) StoreError! {
    if !endpoint.starts_with("s3://") -> return Err(StoreError.InvalidData("S3 endpoint is missing its scheme"))
    rest :: endpoint.removeprefix("s3://")
    segments :: rest.split("/").to_list()
    bucket :: segments[0]
    safe := bucket != "" && !rest.contains("?") && !rest.contains("#") && !segments.contains("..")
    loop byte in bucket.bytes() {
        code :: Int.from_u8(byte)
        alphanumeric :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
        if !(alphanumeric || code == 46 || code == 45) -> safe = false
    }
    if !safe -> return Err(StoreError.InvalidData("S3 endpoint has an unsafe bucket or prefix"))
}

// Whether `value` holds a Unicode White_Space scalar (Rust
// `char::is_whitespace`).
fn store_cache_has_whitespace(value: String) -> Bool Never! {
    raw :: value.bytes()
    loop at in 0..<raw.len() {
        if pkg_bytes_space_width(raw, at) > 0 -> return true
    }
    false
}

// A remote path handed to `ssh`: absolute, no NUL, whitespace, `..`, or
// shell metacharacter.
fn store_cache_validate_remote_key(key: String) StoreError! {
    rejected := key == "" || !key.starts_with("/") || key.bytes().contains(U8{0}) || store_cache_has_whitespace(key) || key.split("/").to_list().contains("..")
    loop byte in key.bytes() {
        if Int.from_u8(byte) == {
            39 | 34 | 96 | 36 | 59 | 38 | 124 | 60 | 62 -> rejected = true
            else -> {}
        }
    }
    if rejected -> return Err(StoreError.InvalidData("remote cache path is unsafe"))
}

// A cache object key relative to its endpoint root.
fn store_cache_validate_relative_key(key: String) StoreError! {
    rejected := key == "" || key.starts_with("/") || store_archive_path_components(key).contains("..")
    loop byte in key.bytes() {
        code :: Int.from_u8(byte)
        if code < 32 || code == 127 || code == 63 || code == 35 || code == 37 -> rejected = true
    }
    if rejected -> return Err(StoreError.InvalidData("cache object key is unsafe"))
}

// The endpoint-specific address of one cache object.
fn store_cache_endpoint_key(endpoint: CacheEndpoint, key: String) -> String StoreError! {
    store_cache_validate_relative_key(key)
    if endpoint == {
        .Http(base) -> Ok("{base}/{key}")
        .S3(base) -> Ok("{base}/{key}")
        .Ssh(_, root) -> {
            path :: "{store_cache_trim_trailing_slashes(root)}/{key}"
            store_cache_validate_remote_key(path)
            Ok(path)
        }
        .Local(root) -> {
            path :: files.join(root, key)
            store_cache_validate_path_components(path)
            Ok(path)
        }
        .Hangar -> Err(StoreError.InvalidData("this endpoint does not expose cache object keys"))
    }
}

// Read one cache object of at most `limit` bytes; None when it is absent.
fn store_cache_endpoint_get(endpoint: CacheEndpoint, key: String, limit: Int) -> [U8]? StoreError! {
    if endpoint == {
        .Local(_) -> {
            path :: store_cache_endpoint_key(endpoint, key)
            bytes :: store_cache_read_regular_bounded(path, limit) ?? {
                if err.is_not_found() -> return Ok(None)
                return Err(err)
            }
            Ok(Val(bytes))
        }
        .Http(_) -> store_cache_http_get(store_cache_endpoint_key(endpoint, key), limit)
        .Ssh(target, _) -> store_cache_ssh_get(target, store_cache_endpoint_key(endpoint, key), limit)
        .S3(_) -> store_cache_s3_get(store_cache_endpoint_key(endpoint, key), limit)
        .Hangar -> Err(StoreError.InvalidData("this endpoint has no cache object read operation"))
    }
}

// Write one cache object in place.
fn store_cache_endpoint_put(endpoint: CacheEndpoint, key: String, bytes: [U8]) StoreError! {
    remote :: store_cache_endpoint_key(endpoint, key)
    if endpoint == {
        .Local(root) -> {
            store_cache_ensure_directory(root)
            store_cache_write_resumable(remote, bytes)
        }
        .Http(_) -> store_cache_http_put(remote, bytes)
        .Ssh(target, _) -> {
            parent :: files.dirname(remote)
            if parent == "" -> return Err(StoreError.InvalidData("SSH cache object has no parent"))
            store_cache_ssh_mkdir(target, parent)
            store_cache_ssh_put(target, remote, bytes)
        }
        .S3(_) -> store_cache_s3_put(remote, bytes)
        .Hangar -> Err(StoreError.InvalidData("this endpoint has no cache object write operation"))
    }
}

// One named object of a remote publication.
struct CacheRemoteObject {
    key: String
    bytes: [U8]
}

// Stage every object as `<key>.partial`, read it back, and promote it. The
// order is the caller's: NAR, then narinfo, then trust receipt.
fn store_cache_publish_remote_atomic(endpoint: CacheEndpoint, objects: [CacheRemoteObject]) StoreError! {
    capabilities :: endpoint.capabilities()
    if !capabilities.write -> return Err(StoreError.InvalidData("{endpoint.label()} cache endpoint does not provide write access"))
    if !capabilities.promote -> return Err(StoreError.InvalidData("{endpoint.label()} cache endpoint has no atomic promotion support"))
    loop object in objects {
        partial :: "{object.key}.partial"
        store_cache_write_remote_resumable(endpoint, partial, object.bytes)
        found :: store_cache_endpoint_get(endpoint, partial, object.bytes.len() + 1)
        uploaded :: found ?? return Err(StoreError.InvalidData("cache endpoint lost its staged object"))
        if uploaded != object.bytes -> return Err(StoreError.InvalidData("cache endpoint staged bytes differ from the signed object"))
        store_cache_promote_remote(endpoint, partial, object.key, object.bytes)
    }
}

// Resume a staged upload: equal bytes are done, a prefix is appended to over
// SSH, anything else is rewritten.
fn store_cache_write_remote_resumable(endpoint: CacheEndpoint, key: String, bytes: [U8]) StoreError! {
    found :: store_cache_endpoint_get(endpoint, key, bytes.len() + 1)
    offset := 0
    if found == {
        .Val(existing) -> {
            if existing == bytes -> return Ok()
            if existing.len() <= bytes.len() && bytes[0..<existing.len()] == existing -> offset = existing.len()
        }
        .None -> {}
    }
    if offset == 0 -> return store_cache_endpoint_put(endpoint, key, bytes)
    if endpoint == {
        .Ssh(target, _) -> store_cache_ssh_append(target, store_cache_endpoint_key(endpoint, key), bytes[offset..<bytes.len()])
        else -> store_cache_endpoint_put(endpoint, key, bytes)
    }
}

// Move a verified partial to its final key without replacing different
// final bytes.
fn store_cache_promote_remote(endpoint: CacheEndpoint, partial: String, final_key: String, bytes: [U8]) StoreError! {
    found :: store_cache_endpoint_get(endpoint, final_key, bytes.len() + 1)
    if found == {
        .Val(existing) -> {
            if existing == bytes -> return Ok()
            return Err(StoreError.InvalidData("cache endpoint already has conflicting final bytes"))
        }
        .None -> {}
    }
    if endpoint == {
        .Ssh(target, _) -> {
            store_cache_ssh_mkdir_for_key(endpoint, final_key)
            store_cache_ssh_promote(target, store_cache_endpoint_key(endpoint, partial), store_cache_endpoint_key(endpoint, final_key))
        }
        .S3(_) -> store_cache_s3_promote(store_cache_endpoint_key(endpoint, partial), store_cache_endpoint_key(endpoint, final_key))
        else -> Err(StoreError.InvalidData("{endpoint.label()} cache endpoint cannot promote staged objects"))
    }
}

// HTTP GET with a caller byte cap; 404 and 410 are a miss.
fn store_cache_http_get(url: String, limit: Int) -> [U8]? StoreError! {
    response :: http.get(url) ?? return Err(StoreError.InvalidData("HTTP cache GET failed: {err.message()}"))
    status :: response.status()
    if status == 404 || status == 410 -> return Ok(None)
    if status < 200 || status >= 300 -> return Err(StoreError.InvalidData("HTTP cache GET failed with status {status}"))
    body := response.body(limit: limit + 1)
    bytes := [U8]{}
    loop {
        chunk :: body.read(65536) ?? return Err(StoreError.InvalidData("HTTP cache response could not be read: {StoreError.Io(err).message()}"))
        if chunk.len() == 0 -> break
        loop byte in chunk -> &bytes.push(byte)
        if bytes.len() > limit -> return Err(StoreError.InvalidData("HTTP cache response exceeded its bound"))
    }
    Ok(Val(bytes))
}

// HTTP PUT through `curl`; the status code is the last output line.
fn store_cache_http_put(url: String, bytes: [U8]) StoreError! {
    spec :: process.cmd([String]{"curl", "--silent", "--show-error", "--netrc-optional", "--compressed", "--max-time", "{@STORE_CACHE_HTTP_TIMEOUT_SECONDS}", "--request", "PUT", "--data-binary", "@-", "--output", store_cache_null_device(), "--write-out", "\n%{{http_code}}", url})
    output :: store_cache_run_bounded_output(spec, Val(bytes), 64, "HTTP cache response", "HTTP cache adapter")
    lines :: (String.from_bytes(output.stdout) ?? "").split("\n").to_list()
    status :: Int.parse(lines[lines.len() - 1].trim()) ?? 0
    if output.success && status >= 200 && status < 300 -> return Ok()
    Err(StoreError.InvalidData("HTTP cache PUT failed with status {status}: {output.stderr}"))
}

fn store_cache_ssh_get(target: String, path: String, limit: Int) -> [U8]? StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"ssh", target, "cat", "--", path}), None, limit, "SSH cache response", "SSH cache adapter")
    if !output.success {
        if output.stderr.contains("No such file") || output.stderr.contains("not found") -> return Ok(None)
        return Err(StoreError.InvalidData("SSH cache GET failed: {output.stderr}"))
    }
    Ok(Val(output.stdout))
}

fn store_cache_ssh_mkdir(target: String, root: String) StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"ssh", target, "mkdir", "-p", "--", root}), None, 4096, "SSH cache response", "SSH cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("SSH cache mkdir failed: {output.stderr}"))
}

fn store_cache_ssh_mkdir_for_key(endpoint: CacheEndpoint, key: String) StoreError! {
    path :: store_cache_endpoint_key(endpoint, key)
    parent :: files.dirname(path)
    if parent == "" -> return Err(StoreError.InvalidData("SSH cache object has no parent"))
    if endpoint == {
        .Ssh(target, _) -> store_cache_ssh_mkdir(target, parent)
        else -> Err(StoreError.InvalidData("SSH directory creation needs an SSH endpoint"))
    }
}

// `path` has already passed `store_cache_validate_remote_key`, so the remote
// shell redirection cannot introduce a second command. `tee`'s copy to
// stdout is suppressed so a large upload cannot trip the bounded response.
fn store_cache_ssh_put(target: String, path: String, bytes: [U8]) StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"ssh", target, "tee -- {path} >/dev/null"}), Val(bytes), 1, "SSH cache response", "SSH cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("SSH cache PUT failed: {output.stderr}"))
}

fn store_cache_ssh_append(target: String, path: String, bytes: [U8]) StoreError! {
    store_cache_validate_remote_key(path)
    output :: store_cache_run_bounded_output(process.cmd([String]{"ssh", target, "tee -a -- {path} >/dev/null"}), Val(bytes), 1, "SSH cache response", "SSH cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("SSH cache append failed: {output.stderr}"))
}

fn store_cache_ssh_promote(target: String, partial: String, final_path: String) StoreError! {
    store_cache_validate_remote_key(partial)
    store_cache_validate_remote_key(final_path)
    output :: store_cache_run_bounded_output(process.cmd([String]{"ssh", target, "mv -n -- {partial} {final_path}"}), None, 4096, "SSH cache response", "SSH cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("SSH cache promotion failed: {output.stderr}"))
}

fn store_cache_s3_get(uri: String, limit: Int) -> [U8]? StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"aws", "s3", "cp", uri, "-", "--only-show-errors"}), None, limit, "S3 cache response", "S3 cache adapter")
    if !output.success {
        if output.stderr.contains("404") || output.stderr.contains("NoSuchKey") || output.stderr.contains("Not Found") -> return Ok(None)
        return Err(StoreError.InvalidData("S3 cache GET failed: {output.stderr}"))
    }
    Ok(Val(output.stdout))
}

fn store_cache_s3_put(uri: String, bytes: [U8]) StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"aws", "s3", "cp", "-", uri, "--only-show-errors"}), Val(bytes), 4096, "S3 cache response", "S3 cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("S3 cache PUT failed: {output.stderr}"))
}

fn store_cache_s3_promote(partial: String, final_uri: String) StoreError! {
    output :: store_cache_run_bounded_output(process.cmd([String]{"aws", "s3", "mv", partial, final_uri, "--only-show-errors"}), None, 4096, "S3 cache response", "S3 cache adapter")
    if !output.success -> return Err(StoreError.InvalidData("S3 cache promotion failed: {output.stderr}"))
}

// What a bounded host transport produced: its exit, at most `limit` stdout
// bytes, and a trimmed diagnostic prefix of at most 4096 stderr bytes.
struct CacheTransportOutput {
    success: Bool
    stdout: [U8]
    stderr: String
}

// Run a host transport with a hard stdout bound. The child is killed as soon
// as the bound is crossed; stderr is captured by the process runtime so a
// noisy failed transport cannot deadlock the transfer.
fn store_cache_run_bounded_output(spec: ProcessSpec, input: [U8]?, limit: Int, label: String, adapter: String) -> CacheTransportOutput StoreError! {
    streamed :: if input == {
        .Val(_) -> spec.stdin(.Stream)
        .None -> spec
    }
    child :: streamed.stdout(.Stream).stderr(.Capture).spawn() ?? return Err(StoreError.InvalidData("{adapter} could not start: {StoreError.Io(err).message()}"))
    if input == {
        .Val(bytes) -> {
            child.stdin.write_all(bytes)
            child.stdin.close()
        }
        .None -> {}
    }
    stdout := [U8]{}
    loop chunk in child.stdout.chunks(65536) {
        loop byte in chunk -> &stdout.push(byte)
        if stdout.len() > limit {
            child.kill().drop("the transport already exceeded its bound")
            child.wait().drop("the transport already exceeded its bound")
            return Err(StoreError.InvalidData("{label} exceeded its bound"))
        }
    }
    receipt :: child.wait()
    Ok(CacheTransportOutput{success: receipt.success, stdout: stdout, stderr: store_cache_bounded_stderr(receipt.errors)})
}

// At most the first 4096 bytes of a diagnostic, lossily decoded and trimmed.
fn store_cache_bounded_stderr(text: String) -> String Never! {
    raw :: text.bytes()
    if raw.len() <= @STORE_CACHE_STDERR_LIMIT -> return text.trim()
    // The diagnostic is valid UTF-8, so only the cut can split a scalar:
    // back off to its lead byte and render the partial scalar as U+FFFD,
    // as Rust's lossy decoding does.
    end := @STORE_CACHE_STDERR_LIMIT
    loop end > 0 && (Int.from_u8(raw[end]) & 0xC0) == 0x80 -> end -= 1
    kept :: pkg_bytes_text(raw, 0, end)
    if end == @STORE_CACHE_STDERR_LIMIT -> return kept.trim()
    "{kept}�".trim()
}

fn store_cache_null_device() -> String Never! {
    if sys.is_windows() -> return "NUL"
    "/dev/null"
}
