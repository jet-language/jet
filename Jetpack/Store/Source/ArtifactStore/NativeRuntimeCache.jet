// Content-addressed native runtime rlib cache (Rust `jet_store::runtime`).
//
// Codegen keeps emitting one complete Rust program for inspection and I1/I2
// audits. Native builders extract its marked Prelude/runtime and Core blocks,
// compile that mutually dependent closure once as ONE `jet_runtime` rlib
// under a flag-keyed identity, then link the user program against it. The two
// blocks reference each other, so they cannot be two crates (Rust crates
// cannot depend on each other cyclically).
//
// Packaging prebuilds the default build-fact set: the `jet-runtime/`
// directory beside the `jet` executable holds `<key>/libjet_runtime.rlib`
// under exactly this key, so a fresh machine with an empty store links the
// shipped rlib instead of compiling the runtime. Other keys (another rustc,
// profile, CPU, or feature set) miss it and build on demand into the store.

STORE_RUNTIME_CACHE_SCHEMA :: prep { "jet-runtime-rlib-v9" }
STORE_RUNTIME_CRATE_NAME :: prep { "jet_runtime" }
STORE_RUNTIME_RLIB_FILE :: prep { "libjet_runtime.rlib" }
STORE_RUNTIME_CRATE_PREFIX :: prep { "#![allow(warnings)]\n" }
STORE_RUNTIME_BEGIN :: prep { "// jet:cached-runtime-begin\n" }
STORE_RUNTIME_END :: prep { "// jet:cached-runtime-end\n" }
STORE_RUNTIME_CORE_BEGIN :: prep { "// jet:cached-core-begin\n" }
STORE_RUNTIME_CORE_END :: prep { "// jet:cached-core-end\n" }
// Directory beside the `jet` executable holding prebuilt runtime rlibs as
// `<key>/libjet_runtime.rlib`.
STORE_RUNTIME_PREBUILT_DIR :: prep { "jet-runtime" }
// When set, every runtime rlib a process links is also written to this
// directory in the prebuilt layout. The packaging step sets it while building
// a seed program to populate the shipped prebuilt directory.
STORE_RUNTIME_PREBUILD_EXPORT_ENV :: prep { "JET_RUNTIME_PREBUILD_DIR" }
// Separates the `rustc -vV` identity from the host CPU description when the
// flags select `target-cpu=native`: the key must name the CPU the rlib was
// tuned for, or a prebuilt rlib could reach a machine lacking its features.
STORE_RUNTIME_NATIVE_CPU_IDENTITY :: prep { "jet:target-cpu=native\n" }

// Why the runtime cache could not prepare a program: the tool (rustc) failed
// to run, or the artifact store failed.
#Error
pub enum NativeRuntimeError {
    Tool(String)
    Cache(ArtifactStoreError)

    fn message(self) -> String Never! {
        if self == {
            .Tool(message) -> message
            .Cache(error) -> error.message()
        }
    }
}

impl ArtifactStoreError -> NativeRuntimeError { NativeRuntimeError.Cache(self) }

impl IOError -> NativeRuntimeError { NativeRuntimeError.Cache(ArtifactStoreError.IO(self)) }

// One environment variable passed to every rustc invocation.
pub struct NativeRuntimeEnvVar {
    pub name: String
    pub value: String
}

// The rustc identity of each rustc, environment and CPU tuning already
// queried (the Rust process-wide identity memo, carried explicitly by the
// caller).
pub struct NativeRuntimeIdentityCache {
    identities: [String: String]

    fn new() -> NativeRuntimeIdentityCache Never! {
        NativeRuntimeIdentityCache{identities: [String: String]{}}
    }

    // The `rustc -vV` output of `rustc` under `rustc_env`, followed, when the
    // flags tune for the host CPU, by the native-CPU marker and the
    // `rustc --print cfg -C target-cpu=native` description of this CPU.
    // Queried once per distinct rustc, environment and tuning.
    fn rustc_identity(&self, rustc: String, rustc_env: [NativeRuntimeEnvVar], native_cpu: Bool) -[Exec, Time]> String NativeRuntimeError! {
        framed := [U8]{}
        store_runtime_push_bytes(&framed, rustc.bytes())
        store_runtime_push_bytes(&framed, store_runtime_be64(rustc_env.len()))
        loop variable in rustc_env {
            store_runtime_push_bytes(&framed, variable.name.bytes())
            store_runtime_push_bytes(&framed, variable.value.bytes())
        }
        if native_cpu -> store_runtime_push_bytes(&framed, STORE_RUNTIME_NATIVE_CPU_IDENTITY.bytes())
        identity_key :: pkg_sha256_hex(framed)
        if self.identities.get(identity_key) == {
            .Val(identity) -> return Ok(identity)
            else -> {}
        }
        version :: store_runtime_rustc_query(rustc, rustc_env, [String]{"-vV"})
        identity := version
        if native_cpu {
            cpu :: store_runtime_rustc_query(rustc, rustc_env, [String]{"--print", "cfg", "-C", "target-cpu=native"})
            identity = "{version}{STORE_RUNTIME_NATIVE_CPU_IDENTITY}{cpu}"
        }
        self.identities[identity_key] = identity
        Ok(identity)
    }
}

// The standard output of `rustc <args>` under `rustc_env`.
fn store_runtime_rustc_query(rustc: String, rustc_env: [NativeRuntimeEnvVar], args: [String]) -[Exec, Time]> String NativeRuntimeError! {
    argv := [String]{rustc}
    loop arg in args -> &argv.push(arg)
    rendered :: args.join(" ")
    spec := process.cmd(argv).stdout(.Capture).stderr(.Capture)
    loop variable in rustc_env -> spec = spec.env(variable.name, variable.value)
    receipt :: if process.run_spec(spec) == {
        .Ok(done) -> done
        .Err(error) -> {
            return Err(NativeRuntimeError.Tool("could not run rustc {rendered}: {error}"))
        }
    }
    if !receipt.success -> return Err(NativeRuntimeError.Tool("rustc {rendered} failed: {receipt.errors}"))
    Ok(receipt.output)
}

// A per-prepare staging directory holding the restored rlibs a rustc command
// links. Closing it removes the directory.
struct NativeRuntimeMaterializedRoot {
    path: String

    fn new(store: ArtifactStore) -[FS, Env, Rand]> NativeRuntimeMaterializedRoot NativeRuntimeError! {
        path :: files.join(files.join(store.root(), "staging"), "runtime-link-{sys.pid()}-{store_artifact_unique_token()}")
        files.create_dir_all(path)
        Ok(NativeRuntimeMaterializedRoot{path})
    }

    fn path(self) -> String Never! { self.path }
}

impl NativeRuntimeMaterializedRoot.Close {
    fn close(^self) -[FS]> {
        files.remove_all(self.path).drop("the staging directory is scratch; a leftover is harmless")
    }
}

// The program to hand to the native rustc invocation and the cached runtime
// rlib it links. Keep it open until the consuming rustc command exits: it
// holds the lease that pins the rlib and its staging copy.
pub struct PreparedRuntime {
    rust: String
    runtime_rlib: String?
    cache_hit: Bool
    repaired: Bool
    prebuilt: Bool
    lease: ArtifactLease?
    materialized_root: NativeRuntimeMaterializedRoot?

    // The whole generated program, compiled without a cached runtime.
    fn inline(rust: String) -> PreparedRuntime Never! {
        PreparedRuntime{
            rust,
            runtime_rlib: None,
            cache_hit: false,
            repaired: false,
            prebuilt: false,
            lease: None,
            materialized_root: None,
        }
    }

    fn rust(self) -> String Never! { self.rust }

    fn cache_hit(self) -> Bool Never! { self.cache_hit }

    fn repaired(self) -> Bool Never! { self.repaired }

    // True when the runtime rlib came from the prebuilt directory shipped
    // beside the `jet` executable rather than from the store or rustc.
    fn prebuilt(self) -> Bool Never! { self.prebuilt }

    // True when the program crate links the cached runtime rlib instead of
    // carrying the runtime source itself.
    fn is_split(self) -> Bool Never! { self.runtime_rlib != None }

    // `spec` with an `--extern` for the cached runtime rlib.
    fn add_rustc_args(self, spec: ProcessSpec) -> ProcessSpec Never! {
        if self.runtime_rlib == {
            .Val(rlib) -> spec.arg("--extern").arg("{STORE_RUNTIME_CRATE_NAME}={rlib}")
            else -> spec
        }
    }
}

impl PreparedRuntime.Close {
    fn close(^self) -[FS]> {
        if self.lease == {
            .Val(lease) -> close(^lease)
            else -> {}
        }
        if self.materialized_root == {
            .Val(root) -> close(^root)
            else -> {}
        }
    }
}

// Prepare the generated program for one native rustc invocation. A program
// without runtime markers, with malformed markers, or whose runtime does not
// compile is returned whole.
pub fn store_runtime_prepare(store: ArtifactStore, identities: &NativeRuntimeIdentityCache, rustc: String, generated: String, rustc_flags: [String], rustc_env: [NativeRuntimeEnvVar]) -[FS, Env, Exec, Time, Rand]> PreparedRuntime NativeRuntimeError! {
    found :: store_runtime_split_generated(generated) ?? None
    split :: found ?? return Ok(PreparedRuntime.inline(generated))
    compile_flags :: store_runtime_compile_flags(rustc_flags)
    rustc_version :: identities.rustc_identity(rustc, rustc_env, store_runtime_targets_native_cpu(compile_flags))
    exported_runtime :: store_runtime_export_source(split.runtime)
    runtime_key :: store_runtime_cache_key(split.runtime, exported_runtime, rustc, rustc_version, compile_flags, rustc_env)
    if store_runtime_prebuilt_rlib(runtime_key) == {
        .Val(rlib) -> {
            store_runtime_export_prebuilt(runtime_key, rlib)
            return Ok(PreparedRuntime{
                rust: split.program,
                runtime_rlib: Val(rlib),
                cache_hit: true,
                repaired: false,
                prebuilt: true,
                lease: None,
                materialized_root: None,
            })
        }
        else -> {}
    }
    materialized_root :: NativeRuntimeMaterializedRoot.new(store)
    runtime :: store_runtime_compile_artifact(store, runtime_key, exported_runtime, rustc, compile_flags, rustc_env, materialized_root.path())
    compiled :: runtime ?? return Ok(PreparedRuntime.inline(generated))
    rlib :: compiled.artifact.path
    store_runtime_export_prebuilt(runtime_key, rlib)
    Ok(PreparedRuntime{
        rust: split.program,
        runtime_rlib: Val(rlib),
        cache_hit: compiled.cache_hit,
        repaired: compiled.repaired,
        prebuilt: false,
        lease: Val(compiled.lease),
        materialized_root: Val(materialized_root),
    })
}

// The shipped rlib for `key`: `<exe dir>/jet-runtime/<key>/libjet_runtime.rlib`.
// The key covers the runtime source, rustc identity (host CPU included for
// `target-cpu=native`), flags and environment, so a present file is exactly
// the artifact rustc would produce here.
fn store_runtime_prebuilt_rlib(key: String) -[FS, Env]> String? Never! {
    directory :: files.dirname(sys.executable())
    if directory == "" -> return None
    path :: files.join(files.join(files.join(directory, STORE_RUNTIME_PREBUILT_DIR), key), STORE_RUNTIME_RLIB_FILE)
    if files.is_file(path) -> return Val(path)
    None
}

// Packaging hook (`JET_RUNTIME_PREBUILD_DIR`): copy the linked rlib into the
// prebuilt layout under `key`, atomically, unless that entry already exists.
fn store_runtime_export_prebuilt(key: String, rlib: String) NativeRuntimeError! -[FS, Env, Rand]> {
    directory :: sys.get(STORE_RUNTIME_PREBUILD_EXPORT_ENV) ?? ""
    if directory == "" -> return
    entry :: files.join(directory, key)
    target :: files.join(entry, STORE_RUNTIME_RLIB_FILE)
    if files.is_file(target) -> return
    files.create_dir_all(entry)
    staged :: files.join(entry, ".{STORE_RUNTIME_RLIB_FILE}.{sys.pid()}-{store_artifact_unique_token()}")
    if files.copyfile(rlib, staged) == {
        .Err(error) -> {
            files.remove(staged).drop("the partial copy is scratch")
            return Err(NativeRuntimeError.Cache(ArtifactStoreError.IO(error)))
        }
        else -> {}
    }
    if files.rename(staged, target) == {
        .Err(error) -> {
            files.remove(staged).drop("the unpublished copy is scratch")
            return Err(NativeRuntimeError.Cache(ArtifactStoreError.IO(error)))
        }
        else -> {}
    }
}

// Whether the runtime compile flags tune code for the host CPU.
fn store_runtime_targets_native_cpu(flags: [String]) -> Bool Never! {
    loop flag in flags {
        if flag == "target-cpu=native" || flag == "-Ctarget-cpu=native" -> return true
    }
    false
}

// Linker selection and link arguments affect the final user crate, not the
// reusable runtime/Core closure. Keep them on the final rustc invocation.
fn store_runtime_compile_flags(flags: [String]) -> [String] Never! {
    compile_flags := [String]{}
    index := 0
    loop index < flags.len() {
        flag :: flags[index]
        // `-C <value>` drops both words; a joined `-Clinker=` drops one.
        skip :: if {
            flag == "-C" && index + 1 < flags.len() && store_runtime_is_link_only_flag(flags[index + 1]) -> 2
            flag != "-C" && store_runtime_is_link_only_flag(flag) -> 1
            else -> 0
        }
        if skip == 0 -> &compile_flags.push(flag)
        index += if skip == 0 -> 1 else -> skip
    }
    compile_flags
}

fn store_runtime_is_link_only_flag(flag: String) -> Bool Never! {
    store_runtime_starts_with_any(flag, [String]{"linker=", "link-arg=", "-Clinker=", "-Clink-arg="})
}

// One cached rlib restored for linking, with the lease that pins it.
struct NativeRuntimeCompiledArtifact {
    artifact: StoredArtifact
    cache_hit: Bool
    repaired: Bool
    lease: ArtifactLease
}

// The cached runtime rlib under `key`, compiled with rustc and published on a
// miss. None when rustc rejects the crate or the published artifact cannot be
// verified, so the caller falls back to the inline program.
fn store_runtime_compile_artifact(store: ArtifactStore, key: String, exported: String, rustc: String, rustc_flags: [String], rustc_env: [NativeRuntimeEnvVar], materialized_root: String) -[FS, Env, Exec, Time, Rand]> NativeRuntimeCompiledArtifact? NativeRuntimeError! {
    lookup :: store.lookup_artifact(key)
    repaired :: if lookup == {
        .Corrupt -> true
        else -> false
    }
    if lookup == {
        .Hit(artifact) -> {
            hit := artifact
            hit.path = store_runtime_materialize_artifact(store, key, materialized_root)
            lease :: store.acquire_artifact_lease([LeaseTarget]{LeaseTarget.Action(hit.action), LeaseTarget.Blob(hit.object)})
            return Ok(Val(NativeRuntimeCompiledArtifact{artifact: hit, cache_hit: true, repaired, lease}))
        }
        else -> {}
    }

    staging :: files.join(files.join(store.root(), "staging"), "{STORE_RUNTIME_CRATE_NAME}-{sys.pid()}-{store_artifact_unique_token()}")
    files.create_dir_all(staging)
    source :: files.join(staging, "runtime.rs")
    staged_rlib :: files.join(staging, "lib{STORE_RUNTIME_CRATE_NAME}.rlib")
    if files.write(source, "{STORE_RUNTIME_CRATE_PREFIX}{exported}") == {
        .Err(error) -> {
            files.remove_all(staging).drop("the failed write is reported; staging is scratch")
            return Err(NativeRuntimeError.Cache(ArtifactStoreError.IO(error)))
        }
        else -> {}
    }

    argv := [String]{rustc, "--edition", "2021", "--crate-name", STORE_RUNTIME_CRATE_NAME, "--crate-type", "rlib"}
    loop flag in rustc_flags -> &argv.push(flag)
    &argv.push("-C")
    &argv.push("metadata={key}")
    if files.canonicalize(staging) == {
        .Ok(prefix) -> {
            &argv.push("--remap-path-prefix")
            &argv.push("{prefix}=/jet/build")
        }
        else -> {}
    }
    &argv.push(source)
    &argv.push("-o")
    &argv.push(staged_rlib)
    spec := process.cmd(argv).stdout(.Capture).stderr(.Capture)
    loop variable in rustc_env -> spec = spec.env(variable.name, variable.value)
    receipt :: if process.run_spec(spec) == {
        .Ok(done) -> done
        .Err(error) -> {
            files.remove_all(staging).drop("rustc did not run; staging is scratch")
            return Err(NativeRuntimeError.Tool("could not run rustc for cached runtime: {error}"))
        }
    }
    files.remove(source).drop("the staged source is scratch once rustc exits")
    if !receipt.success {
        files.remove_all(staging).drop("a rejected runtime falls back to the inline program")
        return Ok(None)
    }
    if store.publish_file(key, staged_rlib) == {
        .Err(error) -> {
            if error == {
                .Conflict(_) -> {}
                else -> {
                    files.remove_all(staging).drop("the publish failure is reported; staging is scratch")
                    return Err(NativeRuntimeError.Cache(error))
                }
            }
        }
        else -> {}
    }
    files.remove_all(staging).drop("the rlib now lives in the store; staging is scratch")
    published :: store.lookup_artifact(key)
    artifact := if published == {
        .Hit(found) -> found
        else -> {
            return Ok(None)
        }
    }
    artifact.path = store_runtime_materialize_artifact(store, key, materialized_root)
    lease :: store.acquire_artifact_lease([LeaseTarget]{LeaseTarget.Action(artifact.action), LeaseTarget.Blob(artifact.object)})
    Ok(Val(NativeRuntimeCompiledArtifact{artifact, cache_hit: false, repaired, lease}))
}

// Restore the cached rlib `key` as `<root>/libjet_runtime.rlib`.
fn store_runtime_materialize_artifact(store: ArtifactStore, key: String, root: String) -[FS, Env, Exec, Time, Rand]> String NativeRuntimeError! {
    path :: files.join(root, "lib{STORE_RUNTIME_CRATE_NAME}.rlib")
    if store.restore_file(key, path) == {
        .Hit(_, _) -> Ok(path)
        else -> Err(NativeRuntimeError.Cache(ArtifactStoreError.Corrupt{path: path, reason: "published runtime artifact disappeared before linking"}))
    }
}

// The runtime crate source (the runtime block followed by the Core block) and
// the user program with both blocks replaced by one import of that crate.
struct NativeRuntimeSplit {
    runtime: String
    program: String
}

// Why the runtime markers of a generated program are malformed.
#Error
struct NativeRuntimeSplitError {
    reason: String
}

// Split the marked runtime and Core blocks out of `generated`. None when the
// program carries no runtime block.
fn store_runtime_split_generated(generated: String) -> NativeRuntimeSplit? NativeRuntimeSplitError! {
    raw :: generated.bytes()
    begin_marker :: STORE_RUNTIME_BEGIN.bytes()
    end_marker :: STORE_RUNTIME_END.bytes()
    core_begin_marker :: STORE_RUNTIME_CORE_BEGIN.bytes()
    core_end_marker :: STORE_RUNTIME_CORE_END.bytes()
    begin :: store_artifact_find(raw, begin_marker, 0)
    if begin < 0 -> return Ok(None)
    if store_runtime_count(raw, begin_marker) != 1 || store_runtime_count(raw, end_marker) != 1 {
        return Err(NativeRuntimeSplitError{reason: "generated Rust has an invalid runtime marker pair"})
    }
    runtime_start :: begin + begin_marker.len()
    runtime_end :: store_artifact_find(raw, end_marker, runtime_start)
    if runtime_end < 0 -> return Err(NativeRuntimeSplitError{reason: "generated Rust has an unterminated runtime block"})
    after_runtime :: runtime_end + end_marker.len()
    runtime :: pkg_bytes_text(raw, runtime_start, runtime_end)
    core_begin :: store_artifact_find(raw, core_begin_marker, 0)
    if core_begin < 0 && store_runtime_count(raw, core_end_marker) != 0 {
        return Err(NativeRuntimeSplitError{reason: "generated Rust has an invalid core marker pair"})
    }
    if store_runtime_count(raw, core_begin_marker) > 1 || store_runtime_count(raw, core_end_marker) > 1 {
        return Err(NativeRuntimeSplitError{reason: "generated Rust has an invalid core marker pair"})
    }
    prologue :: "{pkg_bytes_text(raw, 0, begin)}extern crate jet_runtime;\nuse jet_runtime::*;\n"
    if core_begin < 0 {
        program :: "{prologue}{pkg_bytes_text(raw, after_runtime, raw.len())}"
        return Ok(Val(NativeRuntimeSplit{runtime, program}))
    }
    if core_begin < after_runtime -> return Err(NativeRuntimeSplitError{reason: "generated Rust has nested runtime/core markers"})
    core_start :: core_begin + core_begin_marker.len()
    core_end :: store_artifact_find(raw, core_end_marker, core_start)
    if core_end < 0 -> return Err(NativeRuntimeSplitError{reason: "generated Rust has an unterminated core block"})
    core_after :: core_end + core_end_marker.len()
    program :: "{prologue}{pkg_bytes_text(raw, after_runtime, core_begin)}{pkg_bytes_text(raw, core_after, raw.len())}"
    Ok(Val(NativeRuntimeSplit{runtime: "{runtime}{pkg_bytes_text(raw, core_start, core_end)}", program}))
}

// Non-overlapping occurrences of `needle` in `haystack` (`str::matches`).
fn store_runtime_count(haystack: [U8], needle: [U8]) -> Int Never! {
    count := 0
    at := store_artifact_find(haystack, needle, 0)
    loop at >= 0 {
        count += 1
        at = store_artifact_find(haystack, needle, at + needle.len())
    }
    count
}

// SHA-256 over every length-framed input that can change the compiled rlib:
// schema, crate, source and its exported form, prologue, rustc path and
// version, flags, and environment.
fn store_runtime_cache_key(source: String, exported_source: String, rustc: String, rustc_version: String, rustc_flags: [String], rustc_env: [NativeRuntimeEnvVar]) -> String Never! {
    data := [U8]{}
    store_runtime_push_bytes(&data, STORE_RUNTIME_CACHE_SCHEMA.bytes())
    store_runtime_push_bytes(&data, STORE_RUNTIME_CRATE_NAME.bytes())
    store_runtime_push_bytes(&data, source.bytes())
    store_runtime_push_bytes(&data, STORE_RUNTIME_CRATE_PREFIX.bytes())
    store_runtime_push_bytes(&data, exported_source.bytes())
    store_runtime_push_bytes(&data, rustc.bytes())
    store_runtime_push_bytes(&data, rustc_version.bytes())
    store_runtime_push_bytes(&data, "flags".bytes())
    store_runtime_push_bytes(&data, store_runtime_be64(rustc_flags.len()))
    loop flag in rustc_flags -> store_runtime_push_bytes(&data, flag.bytes())
    store_runtime_push_bytes(&data, "env".bytes())
    store_runtime_push_bytes(&data, store_runtime_be64(rustc_env.len()))
    loop variable in rustc_env {
        store_runtime_push_bytes(&data, variable.name.bytes())
        store_runtime_push_bytes(&data, variable.value.bytes())
    }
    pkg_sha256_hex(data)
}

// `value` framed by its length as eight big-endian bytes.
fn store_runtime_push_bytes(out: &[U8], value: [U8]) Never! {
    &out.extend(store_runtime_be64(value.len()))
    &out.extend(value)
}

// `u64::to_be_bytes`.
fn store_runtime_be64(value: Int) -> [U8] Never! {
    out := [U8]{}
    shift := 56
    loop shift >= 0 {
        &out.push(U8{(value >> shift) & 255})
        shift -= 8
    }
    out
}
