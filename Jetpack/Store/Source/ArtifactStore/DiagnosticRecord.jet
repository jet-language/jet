// Typed diagnostics as record values (Rust crates/jet-store/src/diagnostic_record.rs).
// The Receipt and the per-package `jet.diags` record carry diagnostics in
// this one encoding. Every field keeps its type (code, severity, spans,
// origins, fixes, causes) so each invocation renders them for its own
// terminal mode instead of replaying bytes from an earlier terminal.
//
// Origins are stored once in an origin table. An origin whose revision is one
// of the caller's closure sources is stored by revision only; the reader
// supplies the bytes from its own closure. Any other origin source is
// embedded. The record carries exactly the Rust `Diagnostic` fields; the Jet
// driver's aggregate-source mapping (`source_path`, `source_offset`,
// `source_start`) is presentation state and decodes as absent.
use jet_foundation.[
    DIAGNOSTIC_ERROR, DIAGNOSTIC_LINT, Diagnostic, DiagnosticBuildError, DiagnosticCause,
    DiagnosticCryptoMisuseReason, DiagnosticErrorContextFrame, DiagnosticErrorConversion,
    DiagnosticErrorDetails, DiagnosticErrorField, DiagnosticErrorJourneyFrame, DiagnosticErrorSpan,
    DiagnosticFixApplicability, DiagnosticFixSafety, DiagnosticLabel, DiagnosticMoment,
    DiagnosticNoFixReason, DiagnosticNoFixReasonKind, DiagnosticOrigin, DiagnosticStructured,
    JetErrorContextFrame, JetErrorConversion, JetErrorDetails, JetErrorField, JetErrorJourneyFrame,
    JetErrorReport, JetErrorSpan, RecordField, RecordValue, Span, TextEdit, sha256_hex,
    record_value_as_list, record_value_as_optional_str, record_value_as_str, record_value_as_usize,
    record_value_field, record_value_is_null, record_value_list_of_str, record_value_optional_str,
    record_value_str_list,
]
use core.text as store_text

// A diagnostic list the codec cannot carry or a record it cannot decode (the
// Rust `String` error).
#Error
struct StoreDiagnosticRecordError {
    message: String
}

fn store_diagnostic_error(message: String) -> StoreDiagnosticRecordError Never! {
    StoreDiagnosticRecordError{message: message}
}

// The two record sections one diagnostic list encodes to
// (Rust diagnostic_record.rs:23 `DiagnosticSections`).
struct StoreDiagnosticSections {
    origins: [RecordValue]
    diagnostics: [RecordValue]
}

// Encode diagnostics. `closure_revisions` holds the source revisions the
// reader can resolve itself. A diagnostic payload the codec does not carry is
// an error; the caller then leaves the result unrecorded
// (Rust diagnostic_record.rs:31 `encode_diagnostics`).
fn store_encode_diagnostics(diagnostics: [Diagnostic], closure_revisions: [String]) -> StoreDiagnosticSections StoreDiagnosticRecordError! {
    table := [DiagnosticOrigin]{}
    encoded := [RecordValue]{}
    loop diagnostic in diagnostics -> &encoded.push(store_diagnostic_encode(diagnostic, &table))
    origins := [RecordValue]{}
    loop origin in table {
        source :: if closure_revisions.contains(origin.revision) -> RecordValue.Null else -> RecordValue.Str{value: origin.source}
        &origins.push(RecordValue.Map{fields: [RecordField]{
            {name: "display", value: RecordValue.Str{value: origin.display}},
            {name: "path", value: RecordValue.Str{value: origin.path}},
            {name: "revision", value: RecordValue.Str{value: origin.revision}},
            {name: "source", value: source},
        }})
    }
    Ok(StoreDiagnosticSections{origins: origins, diagnostics: encoded})
}

// Decode diagnostics. `source_for_revision` returns the exact source text for
// a revision in the caller's current closure; an origin it cannot resolve
// makes the whole list undecodable (a miss, never a replay against different
// bytes) (Rust diagnostic_record.rs:67 `decode_diagnostics`).
fn store_decode_diagnostics(origins: [RecordValue], diagnostics: [RecordValue], source_for_revision: fn(String) -> String?) -> [Diagnostic] StoreDiagnosticRecordError! {
    table := [DiagnosticOrigin]{}
    loop origin in origins {
        display :: store_diagnostic_text(origin, "display")
        path :: store_diagnostic_text(origin, "path")
        revision :: store_diagnostic_text(origin, "revision")
        source :: if store_diagnostic_optional_text(origin, "source") == {
            .Val(text) -> text
            .None -> source_for_revision(revision) ?? return Err(store_diagnostic_error("diagnostic origin `{path}` is not in the closure"))
        }
        decoded :: DiagnosticOrigin{display: display, path: path, source: source, revision: sha256_hex(source)}
        if decoded.revision != revision -> return Err(store_diagnostic_error("diagnostic origin `{decoded.path}` revision mismatch"))
        &table.push(decoded)
    }
    out := [Diagnostic]{}
    loop diagnostic in diagnostics -> &out.push(store_diagnostic_decode(diagnostic, table))
    Ok(out)
}

// Rust diagnostic_record.rs:100 `OriginTable::index`: one row per distinct
// origin value.
fn store_diagnostic_origin_index(origin: DiagnosticOrigin?, table: &[DiagnosticOrigin]) -> RecordValue Never! {
    value :: origin ?? return RecordValue.Null
    loop (index, existing) in table {
        if existing == value -> return RecordValue.Int{value: index}
    }
    &table.push(value)
    RecordValue.Int{value: table.len() - 1}
}

fn store_diagnostic_span(span: Span) -> RecordValue Never! {
    RecordValue.List{values: [RecordValue]{RecordValue.Int{value: span.start}, RecordValue.Int{value: span.end}}}
}

fn store_diagnostic_optional_span(span: Span?) -> RecordValue Never! {
    if span == .Val(value) -> store_diagnostic_span(value) else -> RecordValue.Null
}

fn store_diagnostic_severity_name(severity: Int) -> String Never! {
    if severity == DIAGNOSTIC_LINT -> "lint" else -> "error"
}

fn store_diagnostic_parse_severity(value: String) -> Int StoreDiagnosticRecordError! {
    if value == {
        "error" -> Ok(DIAGNOSTIC_ERROR)
        "lint" -> Ok(DIAGNOSTIC_LINT)
        else -> Err(store_diagnostic_error("unknown severity `{value}`"))
    }
}

fn store_diagnostic_moment_name(moment: DiagnosticMoment) -> String Never! {
    if moment == {
        .Compile -> "compile"
        .Run -> "run"
        .Test -> "test"
        .Tool -> "tool"
    }
}

fn store_diagnostic_parse_moment(value: String) -> DiagnosticMoment StoreDiagnosticRecordError! {
    if value == {
        "compile" -> Ok(.Compile)
        "run" -> Ok(.Run)
        "test" -> Ok(.Test)
        "tool" -> Ok(.Tool)
        else -> Err(store_diagnostic_error("unknown report moment `{value}`"))
    }
}

fn store_diagnostic_applicability_name(applicability: DiagnosticFixApplicability) -> String Never! {
    if applicability == .Safe -> "safe" else -> "suggested"
}

fn store_diagnostic_parse_applicability(value: String) -> DiagnosticFixApplicability StoreDiagnosticRecordError! {
    if value == {
        "safe" -> Ok(.Safe)
        "suggested" -> Ok(.Suggested)
        else -> Err(store_diagnostic_error("unknown fix applicability `{value}`"))
    }
}

// Rust Report.rs `FixSafety::as_str`.
fn store_diagnostic_safety_name(safety: DiagnosticFixSafety) -> String Never! {
    if safety == {
        .Formatting -> "formatting"
        .BehaviorPreserving -> "behavior-preserving"
        .APIChanging -> "api-changing"
        .TargetChanging -> "target-changing"
        .NeedsReview -> "needs-review"
    }
}

fn store_diagnostic_parse_safety(value: String) -> DiagnosticFixSafety StoreDiagnosticRecordError! {
    loop safety in ([DiagnosticFixSafety]{.Formatting, .BehaviorPreserving, .APIChanging, .TargetChanging, .NeedsReview}) {
        if store_diagnostic_safety_name(safety) == value -> return Ok(safety)
    }
    Err(store_diagnostic_error("unknown fix safety `{value}`"))
}

fn store_diagnostic_no_fix_kind_name(kind: DiagnosticNoFixReasonKind) -> String Never! {
    if kind == {
        .Behavior -> "behavior"
        .Design -> "design"
        .Ambiguous -> "ambiguous"
    }
}

// Rust Report.rs `NoFixReason::try_new` over `NoFixReasonKind::parse`.
fn store_diagnostic_parse_no_fix(kind: String, next: String) -> DiagnosticNoFixReason StoreDiagnosticRecordError! {
    parsed :: if kind == {
        "behavior" -> DiagnosticNoFixReasonKind.Behavior
        "design" -> DiagnosticNoFixReasonKind.Design
        "ambiguous" -> DiagnosticNoFixReasonKind.Ambiguous
        else -> { return Err(store_diagnostic_error("unknown no-fix reason kind `{kind}`")) }
    }
    if next.trim() == "" -> return Err(store_diagnostic_error("no-fix reason next action must not be empty"))
    if store_text.has_control(next) -> return Err(store_diagnostic_error("no-fix reason next action must not contain control characters"))
    Ok(DiagnosticNoFixReason{kind: parsed, next: next})
}

STORE_DIAGNOSTIC_CRYPTO_REASONS :: prep { [DiagnosticCryptoMisuseReason]{
    .InvalidLength, .NonceLength, .OutputLength, .SaltLength, .MemoryCost, .IterationCount,
    .LaneCount, .MemoryTimeCost, .RawNonce, .RawAlgorithm, .DeterministicEntropy,
} }

// Rust diagnostic_record.rs:176 `crypto_reason_name`.
fn store_diagnostic_crypto_name(reason: DiagnosticCryptoMisuseReason) -> String Never! {
    if reason == {
        .InvalidLength -> "invalid_length"
        .NonceLength -> "nonce_length"
        .OutputLength -> "output_length"
        .SaltLength -> "salt_length"
        .MemoryCost -> "memory_cost"
        .IterationCount -> "iteration_count"
        .LaneCount -> "lane_count"
        .MemoryTimeCost -> "memory_time_cost"
        .RawNonce -> "raw_nonce"
        .RawAlgorithm -> "raw_algorithm"
        .DeterministicEntropy -> "deterministic_entropy"
    }
}

fn store_diagnostic_parse_crypto(value: String) -> DiagnosticCryptoMisuseReason StoreDiagnosticRecordError! {
    loop reason in STORE_DIAGNOSTIC_CRYPTO_REASONS {
        if store_diagnostic_crypto_name(reason) == value -> return Ok(reason)
    }
    Err(store_diagnostic_error("unknown crypto misuse reason `{value}`"))
}

fn store_diagnostic_edit(edit: TextEdit) -> RecordValue Never! {
    RecordValue.Map{fields: [RecordField]{
        {name: "span", value: store_diagnostic_span(edit.span)},
        {name: "text", value: RecordValue.Str{value: edit.new_text}},
    }}
}

// The canonical `jet.err/v1` report of a structured build error. The Jet
// journey frame records no column, so the report's 1-based column is 0 ("not
// recorded"), as the bootstrap host codec maps it.
fn store_diagnostic_build_report(report: DiagnosticBuildError) -> JetErrorReport Never! {
    causes := [JetErrorReport]{}
    loop cause in report.causes -> &causes.push(store_diagnostic_build_report(cause))
    frames := [JetErrorContextFrame]{}
    loop frame in report.context_frames -> &frames.push(JetErrorContextFrame{text: frame.text, file: frame.file, line: frame.line})
    journey := [JetErrorJourneyFrame]{}
    loop frame in report.source_journey -> &journey.push(JetErrorJourneyFrame{fn_name: frame.fn_name, file: frame.file, line: frame.line, column: 0, note: frame.note, hops: frame.hops})
    conversions := [JetErrorConversion]{}
    loop conversion in report.conversion_history -> &conversions.push(JetErrorConversion{source: conversion.source, target: conversion.target})
    details :: if report.details == .Val(value) -> {
        fields := [JetErrorField]{}
        loop field in value.fields -> &fields.push(JetErrorField{name: field.name, value: field.value})
        span :: if value.source_span == .Val(found) -> Val(JetErrorSpan{start: found.start, end: found.end}) else -> None
        Val(JetErrorDetails{variant: value.variant, fields: fields, source_span: span})
    } else -> None
    JetErrorReport{code: report.code, message: report.message, typed_identity: report.typed_identity, causes: causes, context_frames: frames, origin: None, source_journey: journey, conversion_history: conversions, details: details}
}

fn store_diagnostic_build_error(report: JetErrorReport) -> DiagnosticBuildError Never! {
    causes := [DiagnosticBuildError]{}
    loop cause in report.causes -> &causes.push(store_diagnostic_build_error(cause))
    frames := [DiagnosticErrorContextFrame]{}
    loop frame in report.context_frames -> &frames.push(DiagnosticErrorContextFrame{text: frame.text, file: frame.file, line: frame.line})
    journey := [DiagnosticErrorJourneyFrame]{}
    loop frame in report.source_journey -> &journey.push(DiagnosticErrorJourneyFrame{fn_name: frame.fn_name, file: frame.file, line: frame.line, note: frame.note, hops: frame.hops})
    conversions := [DiagnosticErrorConversion]{}
    loop conversion in report.conversion_history -> &conversions.push(DiagnosticErrorConversion{source: conversion.source, target: conversion.target})
    details :: if report.details == .Val(value) -> {
        fields := [DiagnosticErrorField]{}
        loop field in value.fields -> &fields.push(DiagnosticErrorField{name: field.name, value: field.value})
        span :: if value.source_span == .Val(found) -> Val(DiagnosticErrorSpan{start: found.start, end: found.end}) else -> None
        Val(DiagnosticErrorDetails{variant: value.variant, fields: fields, source_span: span})
    } else -> None
    DiagnosticBuildError{code: report.code, message: report.message, typed_identity: report.typed_identity, causes: causes, context_frames: frames, source_journey: journey, conversion_history: conversions, details: details}
}

// Rust diagnostic_record.rs:218 `encode_structured`.
fn store_diagnostic_structured(structured: DiagnosticStructured) -> RecordValue Never! {
    if structured == {
        .SuggestedEdits(edits) -> {
            encoded := [RecordValue]{}
            loop edit in edits -> &encoded.push(store_diagnostic_edit(edit))
            RecordValue.Map{fields: [RecordField]{
                {name: "kind", value: RecordValue.Str{value: "suggested_edits"}},
                {name: "edits", value: RecordValue.List{values: encoded}},
            }}
        }
        .CryptoMisuse(reason, operation, expected, actual) -> {
            // The integer is kept as text, as Rust keeps its `i128`.
            actual_value :: if actual == .Val(number) -> RecordValue.Str{value: "{number}"} else -> RecordValue.Null
            RecordValue.Map{fields: [RecordField]{
                {name: "kind", value: RecordValue.Str{value: "crypto_misuse"}},
                {name: "reason", value: RecordValue.Str{value: store_diagnostic_crypto_name(reason)}},
                {name: "operation", value: RecordValue.Str{value: operation}},
                {name: "expected", value: record_value_optional_str(expected)},
                {name: "actual", value: actual_value},
            }}
        }
        .BuildError(report) -> RecordValue.Map{fields: [RecordField]{
            {name: "kind", value: RecordValue.Str{value: "build_error"}},
            {name: "report", value: RecordValue.Str{value: store_diagnostic_build_report(report).to_json()}},
        }}
        .RuntimeHostFault(stdout) -> RecordValue.Map{fields: [RecordField]{
            {name: "kind", value: RecordValue.Str{value: "runtime_host_fault"}},
            {name: "stdout", value: RecordValue.Str{value: stdout}},
        }}
    }
}

// Rust diagnostic_record.rs:250 `encode_diagnostic`.
fn store_diagnostic_encode(diagnostic: Diagnostic, origins: &[DiagnosticOrigin]) -> RecordValue StoreDiagnosticRecordError! {
    labels := [RecordValue]{}
    loop label in diagnostic.labels {
        &labels.push(RecordValue.List{values: [RecordValue]{RecordValue.Int{value: label.span.start}, RecordValue.Int{value: label.span.end}, RecordValue.Str{value: label.message}}})
    }
    causes := [RecordValue]{}
    loop cause in diagnostic.cause {
        &causes.push(RecordValue.Map{fields: [RecordField]{
            {name: "code", value: RecordValue.Str{value: cause.code}},
            {name: "span", value: store_diagnostic_optional_span(cause.span)},
            {name: "origin", value: store_diagnostic_origin_index(cause.origin, &origins)},
        }})
    }
    no_fix :: if diagnostic.no_fix_reason == .Val(reason) -> RecordValue.Map{fields: [RecordField]{
        {name: "kind", value: RecordValue.Str{value: store_diagnostic_no_fix_kind_name(reason.kind)}},
        {name: "next", value: RecordValue.Str{value: reason.next}},
    }} else -> RecordValue.Null
    edit :: if diagnostic.edit == .Val(value) -> store_diagnostic_edit(value) else -> RecordValue.Null
    applicability :: if diagnostic.applicability == .Val(value) -> RecordValue.Str{value: store_diagnostic_applicability_name(value)} else -> RecordValue.Null
    safety :: if diagnostic.safety == .Val(value) -> RecordValue.Str{value: store_diagnostic_safety_name(value)} else -> RecordValue.Null
    structured :: if diagnostic.structured == .Val(value) -> store_diagnostic_structured(value) else -> RecordValue.Null
    origin :: store_diagnostic_origin_index(diagnostic.origin, &origins)
    Ok(RecordValue.Map{fields: [RecordField]{
        {name: "moment", value: RecordValue.Str{value: store_diagnostic_moment_name(diagnostic.moment)}},
        {name: "severity", value: RecordValue.Str{value: store_diagnostic_severity_name(diagnostic.severity)}},
        {name: "code", value: RecordValue.Str{value: diagnostic.code}},
        {name: "what", value: RecordValue.Str{value: diagnostic.what}},
        {name: "why", value: RecordValue.Str{value: diagnostic.why}},
        {name: "fix", value: RecordValue.Str{value: diagnostic.fix}},
        {name: "span", value: store_diagnostic_optional_span(diagnostic.span)},
        {name: "origin", value: origin},
        {name: "labels", value: RecordValue.List{values: labels}},
        {name: "cause", value: RecordValue.List{values: causes}},
        {name: "edit", value: edit},
        {name: "applicability", value: applicability},
        {name: "safety", value: safety},
        {name: "no_fix", value: no_fix},
        {name: "detail", value: record_value_optional_str(diagnostic.detail)},
        {name: "structured", value: structured},
        {name: "denial_kind", value: record_value_optional_str(diagnostic.denial_kind)},
        {name: "call_chain", value: record_value_list_of_str(diagnostic.call_chain)},
        {name: "scope_chain", value: record_value_list_of_str(diagnostic.scope_chain)},
        {name: "nearest_granting_scope", value: record_value_optional_str(diagnostic.nearest_granting_scope)},
    }})
}

fn store_diagnostic_field(value: RecordValue, name: String) -> RecordValue StoreDiagnosticRecordError! {
    found :: record_value_field(value, name)
    Ok(found.value ?? return Err(store_diagnostic_error(found.problem ?? "record field `{name}` is missing")))
}

fn store_diagnostic_text(value: RecordValue, name: String) -> String StoreDiagnosticRecordError! {
    decoded :: record_value_as_str(store_diagnostic_field(value, name))
    Ok(decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "record field `{name}` is not a string")))
}

fn store_diagnostic_optional_text(value: RecordValue, name: String) -> String? StoreDiagnosticRecordError! {
    decoded :: record_value_as_optional_str(store_diagnostic_field(value, name))
    if decoded.problem == .Val(problem) -> return Err(store_diagnostic_error(problem))
    Ok(decoded.value)
}

fn store_diagnostic_list(value: RecordValue, name: String) -> [RecordValue] StoreDiagnosticRecordError! {
    decoded :: record_value_as_list(store_diagnostic_field(value, name))
    Ok(decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "record field `{name}` is not a list")))
}

fn store_diagnostic_offset(value: RecordValue) -> Int StoreDiagnosticRecordError! {
    decoded :: record_value_as_usize(value)
    Ok(decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "record offset is not a count")))
}

fn store_diagnostic_strings(value: RecordValue, name: String) -> [String] StoreDiagnosticRecordError! {
    decoded :: record_value_str_list(store_diagnostic_field(value, name))
    Ok(decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "record field `{name}` is not a string list")))
}

// Rust diagnostic_record.rs:356 `decode_span`.
fn store_diagnostic_decode_span(value: RecordValue) -> Span StoreDiagnosticRecordError! {
    decoded :: record_value_as_list(value)
    pair :: decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "diagnostic span must be a [start, end] pair"))
    if pair.len() != 2 -> return Err(store_diagnostic_error("diagnostic span must be a [start, end] pair"))
    Ok(Span{start: store_diagnostic_offset(pair[0]), end: store_diagnostic_offset(pair[1])})
}

fn store_diagnostic_decode_optional_span(value: RecordValue) -> Span? StoreDiagnosticRecordError! {
    if record_value_is_null(value) -> return Ok(None)
    Ok(Val(store_diagnostic_decode_span(value)))
}

// Rust diagnostic_record.rs:371 `decode_origin`.
fn store_diagnostic_decode_origin(value: RecordValue, origins: [DiagnosticOrigin]) -> DiagnosticOrigin? StoreDiagnosticRecordError! {
    if record_value_is_null(value) -> return Ok(None)
    index :: store_diagnostic_offset(value)
    if index >= origins.len() -> return Err(store_diagnostic_error("diagnostic origin index is out of range"))
    Ok(Val(origins[index]))
}

fn store_diagnostic_decode_edit(value: RecordValue) -> TextEdit StoreDiagnosticRecordError! {
    Ok(TextEdit{span: store_diagnostic_decode_span(store_diagnostic_field(value, "span")), new_text: store_diagnostic_text(value, "text")})
}

// Rust diagnostic_record.rs:392 `decode_structured`.
fn store_diagnostic_decode_structured(value: RecordValue) -> DiagnosticStructured StoreDiagnosticRecordError! {
    kind :: store_diagnostic_text(value, "kind")
    if kind == {
        "suggested_edits" -> {
            edits := [TextEdit]{}
            loop edit in store_diagnostic_list(value, "edits") -> &edits.push(store_diagnostic_decode_edit(edit))
            Ok(DiagnosticStructured.SuggestedEdits{edits: edits})
        }
        "crypto_misuse" -> {
            actual := Int?{None}
            if store_diagnostic_optional_text(value, "actual") == .Val(text) {
                actual = Val(Int.parse(text) ?? return Err(store_diagnostic_error("invalid crypto misuse value `{text}`")))
            }
            Ok(DiagnosticStructured.CryptoMisuse{
                reason: store_diagnostic_parse_crypto(store_diagnostic_text(value, "reason")),
                operation: store_diagnostic_text(value, "operation"),
                expected: store_diagnostic_optional_text(value, "expected"),
                actual: actual,
            })
        }
        "build_error" -> {
            report :: JetErrorReport.from_json(store_diagnostic_text(value, "report")) ?? return Err(store_diagnostic_error(err.message))
            Ok(DiagnosticStructured.BuildError{report: store_diagnostic_build_error(report)})
        }
        "runtime_host_fault" -> Ok(DiagnosticStructured.RuntimeHostFault{stdout: store_diagnostic_text(value, "stdout")})
        else -> Err(store_diagnostic_error("unknown structured diagnostic `{kind}`"))
    }
}

// Rust diagnostic_record.rs:422 `decode_diagnostic`.
fn store_diagnostic_decode(value: RecordValue, origins: [DiagnosticOrigin]) -> Diagnostic StoreDiagnosticRecordError! {
    labels := [DiagnosticLabel]{}
    loop label in store_diagnostic_list(value, "labels") {
        decoded :: record_value_as_list(label)
        parts :: decoded.value ?? return Err(store_diagnostic_error(decoded.problem ?? "diagnostic label must be [start, end, message]"))
        if parts.len() != 3 -> return Err(store_diagnostic_error("diagnostic label must be [start, end, message]"))
        message :: record_value_as_str(parts[2])
        &labels.push(DiagnosticLabel{
            span: Span{start: store_diagnostic_offset(parts[0]), end: store_diagnostic_offset(parts[1])},
            message: message.value ?? return Err(store_diagnostic_error(message.problem ?? "diagnostic label message is not a string")),
        })
    }
    causes := [DiagnosticCause]{}
    loop cause in store_diagnostic_list(value, "cause") {
        &causes.push(DiagnosticCause{
            code: store_diagnostic_text(cause, "code"),
            span: store_diagnostic_decode_optional_span(store_diagnostic_field(cause, "span")),
            origin: store_diagnostic_decode_origin(store_diagnostic_field(cause, "origin"), origins),
        })
    }
    edit_value :: store_diagnostic_field(value, "edit")
    edit :: if record_value_is_null(edit_value) -> None else -> Val(store_diagnostic_decode_edit(edit_value))
    no_fix_value :: store_diagnostic_field(value, "no_fix")
    no_fix :: if record_value_is_null(no_fix_value) -> None else -> Val(store_diagnostic_parse_no_fix(store_diagnostic_text(no_fix_value, "kind"), store_diagnostic_text(no_fix_value, "next")))
    structured_value :: store_diagnostic_field(value, "structured")
    structured :: if record_value_is_null(structured_value) -> None else -> Val(store_diagnostic_decode_structured(structured_value))
    applicability :: if store_diagnostic_optional_text(value, "applicability") == .Val(text) -> Val(store_diagnostic_parse_applicability(text)) else -> None
    safety :: if store_diagnostic_optional_text(value, "safety") == .Val(text) -> Val(store_diagnostic_parse_safety(text)) else -> None
    Ok(Diagnostic{
        moment: store_diagnostic_parse_moment(store_diagnostic_text(value, "moment")),
        severity: store_diagnostic_parse_severity(store_diagnostic_text(value, "severity")),
        code: store_diagnostic_text(value, "code"),
        what: store_diagnostic_text(value, "what"),
        why: store_diagnostic_text(value, "why"),
        fix: store_diagnostic_text(value, "fix"),
        span: store_diagnostic_decode_optional_span(store_diagnostic_field(value, "span")),
        origin: store_diagnostic_decode_origin(store_diagnostic_field(value, "origin"), origins),
        labels: labels,
        cause: causes,
        edit: edit,
        applicability: applicability,
        safety: safety,
        no_fix_reason: no_fix,
        detail: store_diagnostic_optional_text(value, "detail"),
        structured: structured,
        denial_kind: store_diagnostic_optional_text(value, "denial_kind"),
        call_chain: store_diagnostic_strings(value, "call_chain"),
        scope_chain: store_diagnostic_strings(value, "scope_chain"),
        nearest_granting_scope: store_diagnostic_optional_text(value, "nearest_granting_scope"),
    })
}
