// Identities of the machine-wide verified artifact store (Rust `jet_store`):
// the SHA-256 digest every local namespace keys on, the blob, action and LTO
// handles, the lease targets that pin them, and the store's one failure
// carrier. The compiler build cache consumes this store; nothing here touches
// the filesystem.
use {
    jet_foundation.[sha256_hex_bytes]
    jet_pkg_model.[pkg_bytes_is_word, pkg_bytes_starts_with, pkg_bytes_text]
    time: core.time
    crypto: core.crypto
}

// The artifact store's one failure carrier. `message` keeps the exact text of
// the Rust `StoreError` Display implementation.
#Error
ArtifactStoreError: enum {
    IO(IOError)
    Config(String)
    InvalidDigest(String)
    InvalidKey(String)
    Corrupt(path: String, reason: String)
    Conflict(path: String)
    Locked(path: String, owner_pid: Int?, elapsed_ns: Int)
    Capacity(path: String, needed_bytes: Int, available_bytes: Int?, limit_bytes: Int)

    message: fn(self) -> String Never! {
        if self == {
            .IO(error) -> "{error}"
            .Config(message) -> message
            .InvalidDigest(value) -> "invalid SHA-256 digest `{value}`"
            .InvalidKey(value) -> "invalid store key `{value}`"
            .Corrupt(path, reason) -> "corrupt store entry {path}: {reason}"
            .Conflict(path) -> "immutable store entry already differs: {path}"
            .Locked(path, owner_pid, elapsed_ns) -> {
                owner: if owner_pid == {
                    .Val(pid) -> "{pid}"
                    .None -> "unknown"
                }
                seconds: time.duration_ns(elapsed_ns).total_in("seconds")
                "store lock is owned by a live process (owner pid {owner}) after waiting {seconds:Fixed(3)}s: {path}"
            }
            .Capacity(path, needed_bytes, available_bytes, limit_bytes) -> {
                available: if available_bytes == {
                    .Val(bytes) -> "Some({bytes})"
                    .None -> "None"
                }
                "store cannot admit {needed_bytes} bytes for {path} (available {available}, limit {limit_bytes})"
            }
        }
    }
}

impl IOError -> ArtifactStoreError { ArtifactStoreError.IO(self) }

// A canonical SHA-256 digest used by every local artifact namespace.
ArtifactDigest: struct {
    priv bytes: [U8]

    hash: fn(bytes: [U8]) -> ArtifactDigest Never! {
        ArtifactDigest{bytes: store_artifact_sha256(bytes)}
    }

    from_hex: fn(value: String) -> ArtifactDigest ArtifactStoreError! {
        raw: value.bytes()
        if raw.len() != 64 -> return Err(ArtifactStoreError.InvalidDigest(value))
        digest := [U8]{}
        loop index in 0..<32 {
            high: store_artifact_hex_value(raw[index * 2]) ?? return Err(ArtifactStoreError.InvalidDigest(value))
            low: store_artifact_hex_value(raw[index * 2 + 1]) ?? return Err(ArtifactStoreError.InvalidDigest(value))
            digest.push(U8{((high << 4)).bit_or(low)})
        }
        Ok(ArtifactDigest{bytes: digest})
    }

    as_bytes: fn(self) -> [U8] Never! { self.bytes }

    // Lowercase hex, the Display form.
    to_hex: fn(self) -> String Never! {
        sha256_hex_bytes(self.bytes)
    }
}

// SHA-256 of `bytes` through Core's public canonical SHA-256 implementation.
store_artifact_sha256: fn(bytes: [U8]) -> [U8] Never! {
    crypto.sha256(bytes).as_bytes()
}

store_artifact_hex_value: fn(byte: U8) -> Int? Never! {
    code: Int.from_u8(byte)
    if {
        code >= 48 && code <= 57 -> Val(code - 48)
        code >= 97 && code <= 102 -> Val(code - 87)
        code >= 65 && code <= 70 -> Val(code - 55)
        else -> None
    }
}

// A verified immutable blob reference. The length is part of the handle so a
// caller cannot accidentally consume a digest with a different payload size.
ObjectHandle: struct {
    priv digest_value: ArtifactDigest
    priv length_value: Int

    new: fn(digest: ArtifactDigest, length: Int) -> ObjectHandle Never! {
        ObjectHandle{digest_value: digest, length_value: length}
    }

    from_bytes: fn(bytes: [U8]) -> ObjectHandle Never! {
        ObjectHandle.new(ArtifactDigest.hash(bytes), bytes.len())
    }

    digest: fn(self) -> ArtifactDigest Never! { self.digest_value }

    length: fn(self) -> Int Never! { self.length_value }

    key: fn(self) -> String Never! { self.digest_value.to_hex() }

    // Display form `<hex>:<length>`, also the build-record pointer payload.
    text: fn(self) -> String Never! { "{self.digest_value.to_hex()}:{self.length_value}" }
}

// A typed action-cache key. Action records are immutable per key and carry a
// second digest in their envelope so replacement with another valid record is
// still detected as corruption.
ActionHandle: struct {
    priv key_value: ArtifactDigest

    new: fn(key: ArtifactDigest) -> ActionHandle Never! { ActionHandle{key_value: key} }

    from_key: fn(key: String) -> ActionHandle Never! { ActionHandle.from_bytes(key.bytes()) }

    from_bytes: fn(key: [U8]) -> ActionHandle Never! { ActionHandle.new(ArtifactDigest.hash(key)) }

    digest: fn(self) -> ArtifactDigest Never! { self.key_value }

    key: fn(self) -> String Never! { self.key_value.to_hex() }
}

// A validated `lto/<namespace>/` directory name.
LTONamespace: struct {
    priv name_value: String

    new: fn(value: String) -> LTONamespace ArtifactStoreError! {
        store_artifact_validate_component(value, "LTO namespace")
        Ok(LTONamespace{name_value: value})
    }

    name: fn(self) -> String Never! { self.name_value }
}

// An artifact that a live build lease pins from pruning.
LeaseTarget: enum {
    Blob(ObjectHandle)
    Action(ActionHandle)
    LTO(namespace: LTONamespace, object: ObjectHandle)

    blob: fn(object: ObjectHandle) -> LeaseTarget Never! { LeaseTarget.Blob(object) }

    action: fn(action: ActionHandle) -> LeaseTarget Never! { LeaseTarget.Action(action) }

    lto: fn(namespace: String, object: ObjectHandle) -> LeaseTarget ArtifactStoreError! {
        Ok(LeaseTarget.LTO{namespace: LTONamespace.new(namespace), object})
    }

    entry_key: fn(self) -> ArtifactEntryKey Never! {
        if self == {
            .Blob(object) -> ArtifactEntryKey.Blob(object.key())
            .Action(action) -> ArtifactEntryKey.Action(action.key())
            .LTO(namespace, object) -> ArtifactEntryKey.LTO{namespace: namespace.name(), key: object.key()}
        }
    }
}

// The kind of one stored entry, in listing order.
ArtifactEntryKind: enum {
    Blob
    Action
    LTO

    rank: fn(self) -> Int Never! {
        if self == {
            .Blob -> 0
            .Action -> 1
            .LTO -> 2
        }
    }
}

// The storage identity of one entry: its namespace and hex key. Ordered by
// kind, then namespace, then key (the Rust derived `Ord`).
ArtifactEntryKey: enum {
    Blob(String)
    Action(String)
    LTO(namespace: String, key: String)

    kind: fn(self) -> ArtifactEntryKind Never! {
        if self == {
            .Blob(_) -> ArtifactEntryKind.Blob
            .Action(_) -> ArtifactEntryKind.Action
            .LTO(_, _) -> ArtifactEntryKind.LTO
        }
    }

    kind_name: fn(self) -> String Never! {
        if self == {
            .Blob(_) -> "blob"
            .Action(_) -> "action"
            .LTO(_, _) -> "lto"
        }
    }

    // The hex key, or `<namespace>-<key>` for LTO entries (quarantine names).
    storage_key: fn(self) -> String Never! {
        if self == {
            .Blob(key) | .Action(key) -> key
            .LTO(namespace, key) -> "{namespace}-{key}"
        }
    }

    // The journal and lease value field; LTO entries join with `~`.
    wire_value: fn(self) -> String Never! {
        if self == {
            .Blob(key) | .Action(key) -> key
            .LTO(namespace, key) -> "{namespace}~{key}"
        }
    }

    // One text per distinct key, used for key-indexed maps and sets.
    identity: fn(self) -> String Never! { "{self.kind_name()}|{self.wire_value()}" }

    primary: fn(self) -> String Never! {
        if self == {
            .Blob(key) | .Action(key) -> key
            .LTO(namespace, _) -> namespace
        }
    }

    secondary: fn(self) -> String Never! {
        if self == {
            .LTO(_, key) -> key
            .Blob(_) | .Action(_) -> ""
        }
    }

    // Parse a journal or lease `kind|value` pair; None for an unknown kind or
    // an invalid digest or namespace.
    // #4415: native lowering of the original `?? return None` paths is gated.
    parse_wire: fn(kind: String, value: String) -> ArtifactEntryKey? Never! {
        if kind == {
            "blob" -> {
                ArtifactDigest.from_hex(value) ?? return None
                Val(ArtifactEntryKey.Blob(value))
            }
            "action" -> {
                ArtifactDigest.from_hex(value) ?? return None
                Val(ArtifactEntryKey.Action(value))
            }
            "lto" -> {
                parts: store_artifact_split_once(value, "~") ?? return None
                LTONamespace.new(parts.before) ?? return None
                ArtifactDigest.from_hex(parts.after) ?? return None
                Val(ArtifactEntryKey.LTO{namespace: parts.before, key: parts.after})
            }
            else -> None
        }
    }
}

// Keys in their derived order.
store_artifact_sort_keys: fn(keys: [ArtifactEntryKey]) -> [ArtifactEntryKey] Never! {
    out := keys
    out = loop fresh_item in out -> fresh_item
    out.sort_by(fn(left: ArtifactEntryKey, right: ArtifactEntryKey) { (left.kind().rank() <=> right.kind().rank()).then(left.primary() <=> right.primary()).then(left.secondary() <=> right.secondary()) })
    out
}

// Keys in their derived order without duplicates (a Rust `BTreeSet`).
store_artifact_unique_keys: fn(keys: [ArtifactEntryKey]) -> [ArtifactEntryKey] Never! {
    out := [ArtifactEntryKey]{}
    seen := [String: Bool]{}
    loop key in store_artifact_sort_keys(keys) {
        identity: key.identity()
        if seen.has_key(identity) -> next
        seen[identity] = true
        out.push(key)
    }
    out
}

// `str::split_once`: the text around the first `separator`.
store_artifact_split_once: fn(value: String, separator: String) -> (before: String, after: String)? Never! {
    raw: value.bytes()
    at: store_artifact_find(raw, separator.bytes(), 0)
    if at < 0 -> return None
    Val((after: pkg_bytes_text(raw, at + separator.bytes().len(), raw.len()), before: pkg_bytes_text(raw, 0, at)))
}

// The first byte offset at or after `from` where `needle` occurs, or -1.
store_artifact_find: fn(haystack: [U8], needle: [U8], from: Int) -> Int Never! {
    if needle.len() == 0 -> return from
    last: haystack.len() - needle.len()
    at := from
    loop at <= last {
        if pkg_bytes_starts_with(haystack, at, needle) -> return at
        at += 1
    }
    -1
}

// A store path component: 1..=128 ASCII letters, digits, `.`, `_` or `-`,
// never `.` or `..`.
store_artifact_validate_component: fn(value: String, label: String) ArtifactStoreError! {
    raw: value.bytes()
    if raw.len() == 0 || value == "." || value == ".." || raw.len() > 128 {
        return Err(ArtifactStoreError.InvalidKey("invalid {label} `{value}`"))
    }
    loop byte in raw {
        code: Int.from_u8(byte)
        if !pkg_bytes_is_word(code) && code != 46 && code != 45 {
            return Err(ArtifactStoreError.InvalidKey("invalid {label} `{value}`"))
        }
    }
}
