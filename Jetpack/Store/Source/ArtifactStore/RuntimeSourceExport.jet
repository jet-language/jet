// Visibility export of the generated native runtime (Rust
// `jet_store::runtime::export_runtime_source` and `rust_code_mask`). The
// cached runtime and Core rlibs must expose their items to the dependent
// user crate; Prelude files stay canonical and unchanged, so the `pub`
// rewrite exists only in the cached build artifact. Rust comments, strings and
// character literals are masked to spaces first, so only real code is read.

// The Rust item context one line sits in.
enum NativeRuntimeScope {
    Module
    Struct
    Enum
    Trait
    InherentImpl
    TraitImpl
    Function
    Other
}

// One open brace and the item it belongs to.
struct NativeRuntimeScopeLevel {
    scope: NativeRuntimeScope
    level: Int
}

// Make the generated runtime boundary callable from its dependent user crate.
fn store_runtime_export_source(source: String) -> String !Never {
    mask :: store_runtime_code_mask(source)
    source_lines :: store_runtime_split_inclusive(source)
    mask_lines :: store_runtime_split_inclusive(mask)
    out := [String]{}
    scopes := [NativeRuntimeScopeLevel]{NativeRuntimeScopeLevel{scope: .Module, level: 0}}
    depth := 0
    pending := ""
    count :: if source_lines.len() < mask_lines.len() -> source_lines.len() else -> mask_lines.len()
    loop index in 0..<count {
        line :: source_lines[index]
        masked :: mask_lines[index]
        loop scopes.len() > 0 && scopes[scopes.len() - 1].level > depth -> _ := scopes.pop()
        scope :: if scopes.len() > 0 -> scopes[scopes.len() - 1].scope else -> NativeRuntimeScope.Other
        direct :: scopes.len() > 0 && scopes[scopes.len() - 1].level == depth
        // `pending` is non-empty only while an item header is still open: a
        // multi-line generic parameter list or `where` clause. Those rows are
        // continuations, not items: `pub fn jet_fixed_list_concat<` followed
        // by `const LEFT: usize,` would otherwise become `pub const LEFT` inside
        // the angle brackets and the runtime crate would not even parse.
        out.push(if direct && pending == "" -> store_runtime_export_line(line, masked, scope) else -> line)
        code :: masked.trim()
        if {
            direct && pending == "" && store_runtime_starts_item_header(code, scope) -> pending = "{code} "
            direct && pending != "" -> pending = "{pending}{code} "
            else -> {}
        }
        loop byte in masked.bytes() {
            if Int.from_u8(byte) == {
                123 -> {
                    kind :: if direct && pending != "" -> store_runtime_scope_for_header(pending) else -> NativeRuntimeScope.Other
                    depth += 1
                    scopes.push(NativeRuntimeScopeLevel{scope: kind, level: depth})
                    pending = ""
                }
                125 -> {
                    if depth > 0 -> depth -= 1
                    loop scopes.len() > 0 && scopes[scopes.len() - 1].level > depth -> _ := scopes.pop()
                    pending = ""
                }
                59 -> {
                    if direct -> pending = ""
                }
                else -> {}
            }
        }
    }
    out.join("")
}

// `str::split_inclusive('\n')`: every line keeps its newline; a final line
// without one is kept; an empty text has no lines.
fn store_runtime_split_inclusive(text: String) -> [String] !Never {
    raw :: text.bytes()
    lines := [String]{}
    start := 0
    loop index in 0..<raw.len() {
        if Int.from_u8(raw[index]) == 10 {
            lines.push(pkg_bytes_text(raw, start, index + 1))
            start = index + 1
        }
    }
    if start < raw.len() -> lines.push(pkg_bytes_text(raw, start, raw.len()))
    lines
}

// `line` with its item made `pub` when it is exportable in `scope`.
fn store_runtime_export_line(line: String, masked: String, scope: NativeRuntimeScope) -> String !Never {
    code :: masked.trim_start()
    if code == "" || code.starts_with("#") -> return line
    should_export :: if scope == {
        .Module -> store_runtime_starts_exportable_item(code) || store_runtime_starts_restricted_reexport(code)
        .Struct -> store_runtime_looks_like_struct_field(code)
        .InherentImpl -> store_runtime_starts_impl_member(code)
        else -> false
    }
    if !should_export -> return line
    raw :: line.bytes()
    indent :: raw.len() - line.trim_start().bytes().len()
    lead :: pkg_bytes_text(raw, 0, indent)
    body :: pkg_bytes_text(raw, indent, raw.len())
    exported :: if store_runtime_restricted_visibility_rest(body) == {
        .Val(rest) -> "{lead}pub {rest}"
        else -> if body.starts_with("pub ") -> line else -> "{lead}pub {body}"
    }
    if scope == NativeRuntimeScope.Module && store_runtime_is_tuple_struct(code) -> return store_runtime_export_tuple_field(exported)
    exported
}

fn store_runtime_is_tuple_struct(code: String) -> Bool !Never {
    item :: store_runtime_strip_visibility(code)
    item.starts_with("struct ") && item.contains("(") && !item.contains("{{")
}

// Make the first field of a one-line tuple struct `pub`.
fn store_runtime_export_tuple_field(line: String) -> String !Never {
    raw :: line.bytes()
    keyword :: "struct ".bytes()
    struct_at :: store_artifact_find(raw, keyword, 0)
    if struct_at < 0 -> return line
    open :: store_artifact_find(raw, "(".bytes(), struct_at + keyword.len())
    if open < 0 -> return line
    if pkg_bytes_starts_with(raw, open + 1, "pub ".bytes()) -> return line
    "{pkg_bytes_text(raw, 0, open + 1)}pub {pkg_bytes_text(raw, open + 1, raw.len())}"
}

// The text after `pub(<scope>) `, or None.
fn store_runtime_restricted_visibility_rest(value: String) -> ?String !Never {
    if !value.starts_with("pub(") -> return None
    raw :: value.bytes()
    close_at :: store_artifact_find(raw, ")".bytes(), 4)
    if close_at < 0 -> return None
    if !pkg_bytes_starts_with(raw, close_at + 1, " ".bytes()) -> return None
    Val(pkg_bytes_text(raw, close_at + 2, raw.len()))
}

// A `pub(crate) use …;` at module scope IS part of the runtime boundary: it is
// how the Core prelude publishes a fragment it keeps inside a private module
// (`mod jet_sync { … } pub(crate) use jet_sync::*;`). Left alone, the split
// runtime rlib kept those names crate-private and the user crate could not
// see them. A bare `use` is a private import, not a boundary, and stays
// private so no `std` path leaks into the program's glob namespace.
fn store_runtime_starts_restricted_reexport(code: String) -> Bool !Never {
    if store_runtime_restricted_visibility_rest(code) == {
        .Val(rest) -> rest.starts_with("use ")
        else -> false
    }
}

fn store_runtime_strip_visibility(code: String) -> String !Never {
    raw :: code.bytes()
    if code.starts_with("pub ") -> return pkg_bytes_text(raw, 4, raw.len())
    if code.starts_with("pub(") {
        close_at :: store_artifact_find(raw, ")".bytes(), 4)
        if close_at >= 0 -> return pkg_bytes_text(raw, close_at + 1, raw.len()).trim_start()
    }
    code
}

fn store_runtime_starts_with_any(code: String, prefixes: [String]) -> Bool !Never {
    loop prefix in prefixes {
        if code.starts_with(prefix) -> return true
    }
    false
}

fn store_runtime_starts_exportable_item(code: String) -> Bool !Never {
    item :: store_runtime_strip_visibility(code)
    store_runtime_starts_with_any(item, [String]{"fn ", "struct ", "enum ", "union ", "trait ", "type ", "const ", "static ", "mod "})
        || store_runtime_starts_with_any(item, [String]{"unsafe fn ", "async fn ", "const fn ", "async unsafe fn "})
        || ((item.starts_with("unsafe extern ") || item.starts_with("extern ")) && item.contains(" fn "))
}

fn store_runtime_starts_impl_member(code: String) -> Bool !Never {
    item :: store_runtime_strip_visibility(code)
    store_runtime_starts_with_any(item, [String]{"fn ", "const ", "type ", "unsafe fn ", "async fn ", "const fn "})
}

// `name: Type` with a plain identifier name (not a `::` path).
fn store_runtime_looks_like_struct_field(code: String) -> Bool !Never {
    item :: store_runtime_strip_visibility(code)
    raw :: item.bytes()
    colon :: store_artifact_find(raw, ":".bytes(), 0)
    if colon < 0 -> return false
    if pkg_bytes_text(raw, 0, colon).ends_with(":") || pkg_bytes_code(raw, colon + 1) == 58 -> return false
    name :: pkg_bytes_text(raw, 0, colon).trim()
    if name == "" -> return false
    loop byte in name.bytes() {
        if !pkg_bytes_is_word(Int.from_u8(byte)) -> return false
    }
    true
}

fn store_runtime_starts_item_header(code: String, scope: NativeRuntimeScope) -> Bool !Never {
    if scope == {
        .Module -> {
            item :: store_runtime_strip_visibility(code)
            store_runtime_starts_exportable_item(item) || item.starts_with("impl") || item.starts_with("unsafe impl") || item.starts_with("extern ")
        }
        .InherentImpl | .TraitImpl | .Trait -> store_runtime_starts_impl_member(code)
        else -> false
    }
}

fn store_runtime_scope_for_header(header: String) -> NativeRuntimeScope !Never {
    item :: store_runtime_strip_visibility(header.trim_start())
    if {
        item.starts_with("struct ") || item.starts_with("union ") -> NativeRuntimeScope.Struct
        item.starts_with("enum ") -> NativeRuntimeScope.Enum
        item.starts_with("trait ") -> NativeRuntimeScope.Trait
        item.starts_with("impl") || item.starts_with("unsafe impl") -> if item.contains(" for ") -> NativeRuntimeScope.TraitImpl else -> NativeRuntimeScope.InherentImpl
        item.starts_with("mod ") -> NativeRuntimeScope.Module
        item.contains("fn ") -> NativeRuntimeScope.Function
        else -> NativeRuntimeScope.Other
    }
}

// Where the Rust lexer is while masking.
enum NativeRuntimeMaskState {
    Code
    LineComment
    BlockComment(Int)
    Str(Bool)
    RawStr(Int)
    Char(Bool)
}

// `source` with comments, strings and character literals replaced by spaces,
// byte for byte; newlines inside them are kept so lines stay aligned.
fn store_runtime_code_mask(source: String) -> String !Never {
    bytes :: source.bytes()
    out := [U8]{}
    state := NativeRuntimeMaskState.Code
    index := 0
    loop index < bytes.len() {
        byte :: bytes[index]
        code :: Int.from_u8(byte)
        blank :: if code == 10 -> byte else -> U8{32}
        if state == {
            .Code -> {
                raw_start :: store_runtime_raw_string_start(bytes, index)
                if {
                    code == 47 && pkg_bytes_code(bytes, index + 1) == 47 -> {
                        store_runtime_push_spaces(&out, 2)
                        index += 2
                        state = NativeRuntimeMaskState.LineComment
                    }
                    code == 47 && pkg_bytes_code(bytes, index + 1) == 42 -> {
                        store_runtime_push_spaces(&out, 2)
                        index += 2
                        state = NativeRuntimeMaskState.BlockComment(1)
                    }
                    raw_start != None -> {
                        found :: raw_start ?? panic("raw string start was just found")
                        store_runtime_push_spaces(&out, found.prefix_len)
                        index += found.prefix_len
                        state = NativeRuntimeMaskState.RawStr(found.hashes)
                    }
                    code == 34 || (code == 98 && pkg_bytes_code(bytes, index + 1) == 34) -> {
                        width :: if code == 98 -> 2 else -> 1
                        store_runtime_push_spaces(&out, width)
                        index += width
                        state = NativeRuntimeMaskState.Str(false)
                    }
                    code == 39 && store_runtime_char_literal_end(bytes, index) != None -> {
                        out.push(U8{32})
                        index += 1
                        state = NativeRuntimeMaskState.Char(false)
                    }
                    else -> {
                        out.push(byte)
                        index += 1
                    }
                }
            }
            .LineComment -> {
                out.push(blank)
                if code == 10 -> state = NativeRuntimeMaskState.Code
                index += 1
            }
            .BlockComment(nesting) -> {
                if {
                    code == 47 && pkg_bytes_code(bytes, index + 1) == 42 -> {
                        store_runtime_push_spaces(&out, 2)
                        index += 2
                        state = NativeRuntimeMaskState.BlockComment(nesting + 1)
                    }
                    code == 42 && pkg_bytes_code(bytes, index + 1) == 47 -> {
                        store_runtime_push_spaces(&out, 2)
                        index += 2
                        state = if nesting == 1 -> NativeRuntimeMaskState.Code else -> NativeRuntimeMaskState.BlockComment(nesting - 1)
                    }
                    else -> {
                        out.push(blank)
                        index += 1
                    }
                }
            }
            .Str(escaped) -> {
                out.push(blank)
                index += 1
                if {
                    escaped -> state = NativeRuntimeMaskState.Str(false)
                    code == 92 -> state = NativeRuntimeMaskState.Str(true)
                    code == 34 -> state = NativeRuntimeMaskState.Code
                    else -> {}
                }
            }
            .RawStr(hashes) -> {
                closes :: code == 34 && store_runtime_all_hashes(bytes, index + 1, hashes)
                out.push(blank)
                index += 1
                if closes {
                    store_runtime_push_spaces(&out, hashes)
                    index += hashes
                    state = NativeRuntimeMaskState.Code
                }
            }
            .Char(escaped) -> {
                out.push(U8{32})
                index += 1
                if {
                    escaped -> state = NativeRuntimeMaskState.Char(false)
                    code == 92 -> state = NativeRuntimeMaskState.Char(true)
                    code == 39 -> state = NativeRuntimeMaskState.Code
                    else -> {}
                }
            }
        }
    }
    String.from_bytes(out) ?? panic("Rust source mask preserves UTF-8 bytes")
}

fn store_runtime_push_spaces(out: &[U8], count: Int) !Never {
    loop _ in 0..<count -> out.push(U8{32})
}

// Whether `bytes[start..<start + count]` exists and is all `#`.
fn store_runtime_all_hashes(bytes: [U8], start: Int, count: Int) -> Bool !Never {
    if start + count > bytes.len() -> return false
    loop offset in 0..<count {
        if Int.from_u8(bytes[start + offset]) != 35 -> return false
    }
    true
}

// A raw string opener at `at` (`r"`, `r#"`, `br##"`, ...): the opener's byte
// length and its hash count.
fn store_runtime_raw_string_start(bytes: [U8], at: Int) -> ?(prefix_len: Int, hashes: Int) !Never {
    first :: pkg_bytes_code(bytes, at)
    byte_string :: first == 98 && pkg_bytes_code(bytes, at + 1) == 114
    if first != 114 && !byte_string -> return None
    start :: if byte_string -> 2 else -> 1
    index := start
    loop pkg_bytes_code(bytes, at + index) == 35 -> index += 1
    if pkg_bytes_code(bytes, at + index) != 34 -> return None
    Val((prefix_len: index + 1, hashes: index - start))
}

// The offset (from `at`) of the closing quote of a character literal opening
// at `at`, or None when the quote is a lifetime or label.
fn store_runtime_char_literal_end(bytes: [U8], at: Int) -> ?Int !Never {
    if pkg_bytes_code(bytes, at) != 39 -> return None
    second :: pkg_bytes_code(bytes, at + 1)
    if second != 92 {
        if second < 0 -> return None
        width :: if {
            second < 0x80 -> 1
            second < 0xE0 -> 2
            second < 0xF0 -> 3
            else -> 4
        }
        end :: 1 + width
        if pkg_bytes_code(bytes, at + end) == 39 -> return Val(end)
        return None
    }
    escaped := false
    offset := 1
    loop at + offset < bytes.len() {
        code :: Int.from_u8(bytes[at + offset])
        if {
            escaped -> escaped = false
            code == 92 -> escaped = true
            code == 39 -> return Val(offset)
            code == 10 -> return None
            else -> {}
        }
        offset += 1
    }
    None
}
