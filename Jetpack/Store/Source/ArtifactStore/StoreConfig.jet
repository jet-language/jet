// Machine-wide artifact store configuration (Rust `jet_store::StoreConfig`):
// the store root, an optional explicit capacity cap, the free-disk reserve
// kept for the host, and the bound on waiting for a live lock owner.

STORE_ARTIFACT_VERSION :: prep { "jet.store.v1" }
STORE_ARTIFACT_ENV :: prep { "JET_STORE_DIR" }
STORE_ARTIFACT_DEFAULT_CAP_BYTES :: prep { 21474836480 }
STORE_ARTIFACT_DEFAULT_RESERVE_BYTES :: prep { 2147483648 }
// Maximum time a store operation waits for a live lock owner by default.
STORE_ARTIFACT_DEFAULT_LOCK_WAIT_MS :: prep { 120000 }
STORE_ARTIFACT_LOCK_RETRY_MS :: prep { 10 }
STORE_ARTIFACT_LOCK_RETRY_MAX_MS :: prep { 250 }
STORE_ARTIFACT_MAX_JOURNAL_BYTES :: prep { 67108864 }
STORE_ARTIFACT_U64_MAX :: prep { 18446744073709551615 }

// The machine-wide store configuration. The optional cap is an explicit host
// override; without it the effective limit is adaptive. Lock acquisition
// waits up to the default lock wait unless overridden.
pub struct ArtifactStoreConfig {
    root_value: String
    cap_bytes_value: Int?
    reserve_bytes_value: Int
    lock_wait_value: Duration

    fn new(root: String) -> ArtifactStoreConfig Never! {
        ArtifactStoreConfig{
            root_value: root,
            cap_bytes_value: None,
            reserve_bytes_value: STORE_ARTIFACT_DEFAULT_RESERVE_BYTES,
            lock_wait_value: time.duration_ms(STORE_ARTIFACT_DEFAULT_LOCK_WAIT_MS),
        }
    }

    // `JET_STORE_DIR` (never empty), else `$HOME/.cache/jet/store`, with the
    // optional `JET_STORE_CAP_BYTES` and `JET_STORE_RESERVE_BYTES` sizes.
    fn from_env() -[Env]> ArtifactStoreConfig ArtifactStoreError! {
        root :: if sys.get(STORE_ARTIFACT_ENV) == {
            .Val(value) -> {
                if value == "" -> return Err(ArtifactStoreError.Config("{STORE_ARTIFACT_ENV} cannot be empty"))
                value
            }
            else -> store_artifact_default_root()
        }
        cap_bytes :: store_artifact_optional_size("JET_STORE_CAP_BYTES")
        reserve :: store_artifact_optional_size("JET_STORE_RESERVE_BYTES")
        reserve_bytes :: reserve ?? STORE_ARTIFACT_DEFAULT_RESERVE_BYTES
        Ok(ArtifactStoreConfig{
            root_value: root,
            cap_bytes_value: cap_bytes,
            reserve_bytes_value: reserve_bytes,
            lock_wait_value: time.duration_ms(STORE_ARTIFACT_DEFAULT_LOCK_WAIT_MS),
        })
    }

    // Rust `Default`: the environment configuration, else `.cache/jet/store`.
    fn default() -[Env]> ArtifactStoreConfig Never! {
        ArtifactStoreConfig.from_env() ?? ArtifactStoreConfig.new(files.join(".cache", "jet/store"))
    }

    fn with_cap_bytes(self, cap_bytes: Int) -> ArtifactStoreConfig Never! {
        updated := self
        updated.cap_bytes_value = Val(cap_bytes)
        updated
    }

    fn with_reserve_bytes(self, reserve_bytes: Int) -> ArtifactStoreConfig Never! {
        updated := self
        updated.reserve_bytes_value = reserve_bytes
        updated
    }

    // Set the maximum time to wait for a live lock owner.
    fn with_lock_wait(self, lock_wait: Duration) -> ArtifactStoreConfig Never! {
        updated := self
        updated.lock_wait_value = lock_wait
        updated
    }

    fn root(self) -> String Never! { self.root_value }

    fn cap_bytes(self) -> Int? Never! { self.cap_bytes_value }

    fn reserve_bytes(self) -> Int Never! { self.reserve_bytes_value }

    fn lock_wait(self) -> Duration Never! { self.lock_wait_value }
}

// The size in environment variable `name`, prefixed with `name` on a parse
// failure; None when unset.
fn store_artifact_optional_size(name: String) -[Env]> Int? ArtifactStoreError! {
    value :: sys.get(name) ?? return Ok(None)
    if store_artifact_parse_size(value) == {
        .Ok(size) -> Ok(Val(size))
        .Err(error) -> {
            if error == {
                .Config(message) -> Err(ArtifactStoreError.Config("{name}: {message}"))
                else -> Err(error)
            }
        }
    }
}

fn store_artifact_default_root() -[Env]> String ArtifactStoreError! {
    home :: sys.home_dir() ?? return Err(ArtifactStoreError.Config("cannot determine home directory"))
    Ok(files.join(files.join(files.join(home, ".cache"), "jet"), "store"))
}

// One size suffix and its multiplier; longer spellings are tried first.
struct StoreArtifactSizeUnit {
    suffix: String
    multiplier: Int
}

fn store_artifact_size_units() -> [StoreArtifactSizeUnit] Never! {
    kib :: 1024
    mib :: kib * 1024
    gib :: mib * 1024
    tib :: gib * 1024
    [StoreArtifactSizeUnit]{
        StoreArtifactSizeUnit{suffix: "TIB", multiplier: tib},
        StoreArtifactSizeUnit{suffix: "TB", multiplier: tib},
        StoreArtifactSizeUnit{suffix: "GIB", multiplier: gib},
        StoreArtifactSizeUnit{suffix: "GB", multiplier: gib},
        StoreArtifactSizeUnit{suffix: "MIB", multiplier: mib},
        StoreArtifactSizeUnit{suffix: "MB", multiplier: mib},
        StoreArtifactSizeUnit{suffix: "KIB", multiplier: kib},
        StoreArtifactSizeUnit{suffix: "KB", multiplier: kib},
        StoreArtifactSizeUnit{suffix: "T", multiplier: tib},
        StoreArtifactSizeUnit{suffix: "G", multiplier: gib},
        StoreArtifactSizeUnit{suffix: "M", multiplier: mib},
        StoreArtifactSizeUnit{suffix: "K", multiplier: kib},
        StoreArtifactSizeUnit{suffix: "B", multiplier: 1},
    }
}

// Parse a byte size such as `4G`, `512MiB`, or a bare byte count.
pub fn store_artifact_parse_size(value: String) -> Int ArtifactStoreError! {
    // #4303: Main-approved host-emitter binding workaround; restore :: with the emitter fix.
    trimmed := value.trim()
    if trimmed == "" -> return Err(ArtifactStoreError.Config("size cannot be empty"))
    upper :: store_artifact_ascii_upper(trimmed)
    number := upper
    multiplier := 1
    loop unit in store_artifact_size_units() {
        if upper.ends_with(unit.suffix) {
            raw :: upper.bytes()
            number = pkg_bytes_text(raw, 0, raw.len() - unit.suffix.bytes().len())
            multiplier = unit.multiplier
            break
        }
    }
    // #4303: Main-approved host-emitter binding workaround; restore :: with the emitter fix.
    digits := number.trim()
    if digits == "" || !store_artifact_all_digits(digits) -> return Err(ArtifactStoreError.Config("invalid byte size `{trimmed}`"))
    count :: Int.parse(digits) ?? return Err(ArtifactStoreError.Config("invalid byte size `{trimmed}`"))
    if count > STORE_ARTIFACT_U64_MAX -> return Err(ArtifactStoreError.Config("invalid byte size `{trimmed}`"))
    if count > STORE_ARTIFACT_U64_MAX /% multiplier -> return Err(ArtifactStoreError.Config("byte size `{trimmed}` is too large"))
    Ok(count * multiplier)
}

// `u64::from_str` accepts one optional `+` and ASCII digits only.
fn store_artifact_all_digits(value: String) -> Bool Never! {
    raw :: value.bytes()
    start :: if raw.len() > 1 && Int.from_u8(raw[0]) == 43 -> 1 else -> 0
    loop index in start..<raw.len() {
        code :: Int.from_u8(raw[index])
        if code < 48 || code > 57 -> return false
    }
    true
}

// ASCII-only uppercase (`str::to_ascii_uppercase`); other scalars unchanged.
fn store_artifact_ascii_upper(value: String) -> String Never! {
    raw :: value.bytes()
    out := [U8]{}
    loop byte in raw {
        code :: Int.from_u8(byte)
        &out.push(if code >= 97 && code <= 122 -> U8{code - 32} else -> byte)
    }
    pkg_bytes_text(out, 0, out.len())
}

// Addition clamped at the Rust u64 size ceiling, not Jet Int's range.
fn store_artifact_saturating_add(left: Int, right: Int) -> Int Never! {
    if right > 0 && left > STORE_ARTIFACT_U64_MAX - right -> return STORE_ARTIFACT_U64_MAX
    left + right
}

// Subtraction clamped at zero (Rust `saturating_sub` on u64 sizes).
fn store_artifact_saturating_sub(left: Int, right: Int) -> Int Never! {
    if right >= left -> return 0
    left - right
}
