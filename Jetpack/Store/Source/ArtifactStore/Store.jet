// The local content-addressed artifact store (Rust `jet_store::Store`): a
// verified blob CAS (`cas/`), an immutable action cache (`ac/`), per-namespace
// LTO objects (`lto/<namespace>/`), build-record pointers, one machine-wide
// lock, owner-checked leases, a checksummed access journal, capacity
// admission against a cap and a free-disk reserve, and deterministic LRU
// pruning. Corrupt entries are moved to `quarantine/` before a miss is
// reported, so a later publish repairs them.
use {
    files: core.files
    time: core.time
}

// One action record of a batch publication (Rust `(ActionHandle, Vec<u8>)`).
ArtifactActionPublication: struct {
    action: ActionHandle
    bytes: [U8]
}

// One journal line to append (Rust `(&str, &EntryKey, u64)`).
ArtifactJournalAppend: struct {
    operation: String
    key: ArtifactEntryKey
    length: Int
}

// One encoded action record a batch writes (Rust `(PathBuf, EntryKey, Vec<u8>)`).
ArtifactPendingWrite: struct {
    path: String
    key: ArtifactEntryKey
    encoded: [U8]
}

// A deterministic store listing entry.
ArtifactEntryStatus: struct {
    kind: ArtifactEntryKind
    key: String
    namespace: String?
    size_bytes: Int
    last_use: Int
    pinned: Bool
    path: String
}

// Store state suitable for status UIs and deterministic tests.
ArtifactStoreStatus: struct {
    root: String
    footprint_bytes: Int
    limit_bytes: Int
    reserve_bytes: Int
    available_bytes: Int?
    live_leases: Int
    host_limit_bytes: Int?
    entries: [ArtifactEntryStatus]
    tiers: [String]
}

// The result of one deterministic prune operation.
ArtifactPruneReport: struct {
    target_bytes: Int
    before_bytes: Int
    after_bytes: Int
    removed: [ArtifactEntryStatus]
    pinned_bytes: Int
    blocked: Bool
}

// A verified action record that points at one immutable CAS object.
StoredArtifact: struct {
    action: ActionHandle
    object: ObjectHandle
    path: String
    executable: Bool
}

// Result of looking up a named artifact. Corrupt records and objects are
// quarantined before `Corrupt` is returned.
ArtifactLookup: enum {
    Missing
    Corrupt
    Hit(StoredArtifact)
}

// Result of restoring a named artifact to a display path.
ArtifactRestore: enum {
    Missing
    Corrupt
    Hit(object: ObjectHandle, executable: Bool)
}

// One scanned entry with its journal and lease facts.
ArtifactStoredEntry: struct {
    key: ArtifactEntryKey
    path: String
    size_bytes: Int
    last_use: Int
    pinned: Bool

    status: fn(self) -> ArtifactEntryStatus Never! {
        namespace: if self.key == {
            .LTO(namespace, _) -> Val(namespace)
            .Blob(_) | .Action(_) -> None
        }
        key: if self.key == {
            .Blob(key) | .Action(key) -> key
            .LTO(_, key) -> key
        }
        ArtifactEntryStatus{
            kind: self.key.kind(),
            key,
            namespace,
            size_bytes: self.size_bytes,
            last_use: self.last_use,
            pinned: self.pinned,
            path: self.path,
        }
    }
}

store_artifact_sort_entries: fn(entries: [ArtifactStoredEntry]) -> [ArtifactStoredEntry] Never! {
    out := entries
    out = loop fresh_item in out -> fresh_item
    out.sort_by(fn(left: ArtifactStoredEntry, right: ArtifactStoredEntry) { store_artifact_entry_order(left, right) })
    out
}

// The derived Rust `EntryKey` order: kind, then namespace or key, then key.
store_artifact_entry_order: fn(left: ArtifactStoredEntry, right: ArtifactStoredEntry) -> Ordering Never! {
    (left.key.kind().rank() <=> right.key.kind().rank()).then(left.key.primary() <=> right.key.primary()).then(left.key.secondary() <=> right.key.secondary())
}

store_artifact_footprint: fn(entries: [ArtifactStoredEntry]) -> Int Never! {
    total := 0
    loop entry in entries -> total = store_artifact_saturating_add(total, entry.size_bytes)
    total
}

// The footprint tally (`footprint` in the store root):
// `jet.store.v1|footprint|<journal bytes>|<entry bytes>|<checksum>`, the bytes
// of the store's entries once the journal's first `<journal bytes>` are
// applied, and the checksum field of the journal line ending there (`-` for
// none). A capacity check replays only the journal lines after it (a put
// adds its length, a remove subtracts it) instead of statting every entry.
// A missing or malformed tally, a journal that no longer holds that line at
// that offset (compaction rewrote it), or a later line that does not verify
// costs one scan, which rewrites the tally.
STORE_ARTIFACT_FOOTPRINT_FILE: "footprint"

// What a replay of the tally learned: the entry bytes and the checksum field
// of the journal's final line, as of `journal_bytes`.
ArtifactFootprintTally: struct {
    journal_bytes: Int
    entry_bytes: Int
    checksum: String
}

store_artifact_footprint_tally_text: fn(tally: ArtifactFootprintTally) -> String Never! {
    "{STORE_ARTIFACT_VERSION}|footprint|{tally.journal_bytes}|{tally.entry_bytes}|{tally.checksum}\n"
}

// The checksum field of the journal line ending just before `end` in
// `window`, a slice of the journal whose byte `end - 1` is that line's
// newline; None when the window holds no whole line ending there. `whole`
// when the window starts at the journal's first byte.
store_artifact_journal_checksum_before: fn(window: [U8], end: Int, whole: Bool) -> String? Never! {
    if end <= 0 || end > window.len() || Int.from_u8(window[end - 1]) != 10 -> return None
    start := end - 1
    loop start > 0 && Int.from_u8(window[start - 1]) != 10 {
        start -= 1
    }
    if start == 0 && !whole -> return None
    field := end - 1
    loop field > start && Int.from_u8(window[field - 1]) != 124 {
        field -= 1
    }
    if field == start -> return None
    text: String.from_bytes(store_artifact_slice(window, field, end - 1)) ?? return None
    Val(text.trim())
}

// The checksum field of the final line of a journal of `journal_bytes`.
store_artifact_journal_final_checksum: fn(journal_path: String, journal_bytes: Int) -[FS]> String? Never! {
    if journal_bytes == 0 -> return Val("-")
    window: if journal_bytes < STORE_ARTIFACT_JOURNAL_TAIL_WINDOW -> journal_bytes else -> STORE_ARTIFACT_JOURNAL_TAIL_WINDOW
    tail: files.read_at(journal_path, journal_bytes - window, window) ?? return None
    if tail.len() != window -> return None
    store_artifact_journal_checksum_before(tail, tail.len(), window == journal_bytes)
}

// The tally at `tally_path` brought up to the journal's `journal_bytes`; None
// when it has to be rebuilt by a scan.
store_artifact_footprint_replay: fn(tally_path: String, journal_path: String, journal_bytes: Int) -[FS]> ArtifactFootprintTally? Never! {
    text: files.read(tally_path) ?? return None
    fields: text.trim().split("|").to_list()
    if fields.len() != 5 || fields[0] != STORE_ARTIFACT_VERSION || fields[1] != "footprint" -> return None
    offset: store_artifact_parse_count(fields[2]) ?? return None
    total := store_artifact_parse_count(fields[3]) ?? return None
    if offset > journal_bytes -> return None
    // A tally from before the journal's first line holds only while the
    // journal is empty: a compaction rewrites the journal from its first byte.
    if offset == 0 {
        if fields[4] != "-" || journal_bytes > 0 -> return None
        return Val(ArtifactFootprintTally{journal_bytes, entry_bytes: total, checksum: "-"})
    }
    // The window holds the line the tally ends at, then every line after it.
    before: if offset < STORE_ARTIFACT_JOURNAL_TAIL_WINDOW -> offset else -> STORE_ARTIFACT_JOURNAL_TAIL_WINDOW
    length: before + journal_bytes - offset
    window: files.read_at(journal_path, offset - before, length) ?? return None
    if window.len() != length -> return None
    found: store_artifact_journal_checksum_before(window, before, offset == before) ?? return None
    if found != fields[4] -> return None
    start := before
    loop index in before..<window.len() {
        if Int.from_u8(window[index]) != 10 -> next
        record: store_artifact_parse_journal_line(store_artifact_slice(window, start, index)) ?? return None
        if record.operation == "put" -> total = store_artifact_saturating_add(total, record.length)
        if record.operation == "remove" -> total = store_artifact_saturating_sub(total, record.length)
        start = index + 1
    }
    if start != window.len() -> return None
    checksum: if journal_bytes == offset -> Val(fields[4]) else -> store_artifact_journal_checksum_before(window, window.len(), offset == before)
    last: checksum ?? return None
    Val(ArtifactFootprintTally{journal_bytes, entry_bytes: total, checksum: last})
}

// Multiplication clamped at the largest Int (Rust `saturating_mul` on u64).
store_artifact_saturating_mul: fn(left: Int, right: Int) -> Int Never! {
    if left != 0 && right > STORE_ARTIFACT_U64_MAX /% left -> return STORE_ARTIFACT_U64_MAX
    left * right
}

// The local content-addressed artifact store. `owner` is this process's
// identity, drawn once when the store opens and written into its lock and
// lease files.
ArtifactStore: struct {
    priv config_value: ArtifactStoreConfig
    priv owner_value: ArtifactProcessIdentity

    open: fn(config: ArtifactStoreConfig) -[FS, Env, Rand]> ArtifactStore ArtifactStoreError! {
        if config.root() == "" -> return Err(ArtifactStoreError.Config("store root cannot be empty"))
        store: ArtifactStore{config_value: config, owner_value: ArtifactProcessIdentity.current()}
        store.ensure_layout()
        Ok(store)
    }

    new: fn(root: String) -[FS, Env, Rand]> ArtifactStore ArtifactStoreError! {
        ArtifactStore.open(ArtifactStoreConfig.new(root))
    }

    from_env: fn() -[FS, Env, Rand]> ArtifactStore ArtifactStoreError! {
        ArtifactStore.open(ArtifactStoreConfig.from_env())
    }

    config: fn(self) -> ArtifactStoreConfig Never! { self.config_value }

    root: fn(self) -> String Never! { self.config_value.root() }

    owner: fn(self) -> ArtifactProcessIdentity Never! { self.owner_value }

    // The effective capacity: the explicit cap, else a tenth of the volume
    // capped at 20 GiB, never above the persisted host limit.
    limit: fn(self) -[FS, Exec, Time]> Int Never! {
        total: if store_artifact_filesystem_stats(self.root()) == {
            .Val(stats) -> Val(stats.total_bytes)
            .None -> None
        }
        self.limit_with_disk(total)
    }

    effective_limit: fn(self) -[FS, Exec, Time]> Int Never! { self.limit() }

    object_path: fn(self, object: ObjectHandle) -> String Never! {
        files.join(files.join(self.root(), "cas"), object.key())
    }

    action_path: fn(self, action: ActionHandle) -> String Never! {
        files.join(files.join(self.root(), "ac"), action.key())
    }

    lto_path: fn(self, namespace: String, object: ObjectHandle) -> String Never! {
        files.join(files.join(files.join(self.root(), "lto"), namespace), object.key())
    }

    publish_blob: fn(self, bytes: [U8]) -[FS, Env, Exec, Time, Rand]> ObjectHandle ArtifactStoreError! {
        self.publish_blob_entry(bytes, durable: true)
    }

    // `publish_blob`, written with its disk syncs when `durable`.
    publish_blob_entry: fn(self, bytes: [U8], durable: Bool) -[FS, Env, Exec, Time, Rand]> ObjectHandle ArtifactStoreError! {
        object: ObjectHandle.from_bytes(bytes)
        self.publish_data(ArtifactEntryKey.Blob(object.key()), self.object_path(object), bytes, durable)
        Ok(object)
    }

    publish_object: fn(self, object: ObjectHandle, bytes: [U8]) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        actual: ObjectHandle.from_bytes(bytes)
        if actual != object {
            return Err(ArtifactStoreError.Corrupt{path: self.object_path(object), reason: "published bytes are {actual.text()}, expected {object.text()}"})
        }
        self.publish_data(ArtifactEntryKey.Blob(object.key()), self.object_path(object), bytes, durable: true)
    }

    get_blob: fn(self, object: ObjectHandle) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        key: ArtifactEntryKey.Blob(object.key())
        path: self.object_path(object)
        if store_artifact_read_file(path) == {
            .Missing -> Ok(None)
            .Corrupt(reason) -> {
                self.quarantine_after_read(key, path, reason)
                Ok(None)
            }
            .Bytes(bytes) -> {
                if bytes.len() != object.length() || ArtifactDigest.hash(bytes) != object.digest() {
                    self.quarantine_after_read(key, path, "digest or length mismatch")
                    return Ok(None)
                }
                self.touch_after_read(key, bytes.len())
                Ok(Val(bytes))
            }
        }
    }

    // Read a blob when only its digest is available. This is the lookup used
    // by build-record pointers; the bytes remain verified before returning.
    blob_by_digest: fn(self, digest: ArtifactDigest) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        key: ArtifactEntryKey.Blob(digest.to_hex())
        path: files.join(files.join(self.root(), "cas"), digest.to_hex())
        if store_artifact_read_file(path) == {
            .Missing -> Ok(None)
            .Corrupt(reason) -> {
                self.quarantine_after_read(key, path, reason)
                Ok(None)
            }
            .Bytes(bytes) -> {
                if ArtifactDigest.hash(bytes) != digest {
                    self.quarantine_after_read(key, path, "digest mismatch")
                    return Ok(None)
                }
                self.touch_after_read(key, bytes.len())
                Ok(Val(bytes))
            }
        }
    }

    // Publish one immutable build record through the ordinary blob CAS.
    // `key` is the caller's content key. The per-program last-run pointer is
    // workspace state (Rust project_state, JP-STORE-STATE-RECEIPT), never a
    // machine-wide store pointer.
    publish_build_record: fn(self, key: String, record: BuildRecord) -[FS, Env, Exec, Time, Rand]> ObjectHandle ArtifactStoreError! {
        object: self.publish_blob(record.to_json().bytes())
        self.ensure_layout()
        pointer: self.build_record_pointer_path(key)
        if self.read_build_pointer(pointer) == {
            .Val(existing) -> {
                if existing != object {
                    if self.build_record(key) != Val(record) -> return Err(ArtifactStoreError.Conflict{path: pointer})
                }
            }
            .None -> {}
        }
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        store_artifact_atomic_write(pointer, object.text().bytes())
        Ok(object)
    }

    // The last-run pointer belongs to the selected workspace, not the cache.
    publish_last_build_record: fn(self, workspace_root: String, key: String, record: BuildRecord) -[FS, Env, Exec, Time, Rand, Time.Wait]> ObjectHandle ArtifactStoreError! {
        object: self.publish_build_record(key, record)
        store_build_write_last_run(workspace_root, record.program, key)
        Ok(object)
    }

    last_build_record: fn(self, workspace_root: String, program: String) -[FS, Env, Exec, Time, Rand, Time.Wait]> BuildRecord? ArtifactStoreError! {
        key: store_build_last_run(workspace_root, program) ?? return Ok(None)
        self.build_record(key)
    }

    // Load an immutable build record addressed by its content key.
    build_record: fn(self, key: String) -[FS, Env, Exec, Time, Rand]> BuildRecord? ArtifactStoreError! {
        pointer: self.build_record_pointer_path(key)
        object: self.read_build_pointer(pointer) ?? return Ok(None)
        bytes: self.get_blob(object) ?? return Ok(None)
        payload: String.from_bytes(bytes) ?? return Err(ArtifactStoreError.Corrupt{path: pointer, reason: "build record blob is not UTF-8"})
        if BuildRecord.from_json(payload) == {
            .Ok(record) -> Ok(Val(record))
            .Err(error) -> Err(ArtifactStoreError.Corrupt{path: self.build_record_pointer_path(key), reason: error.reason})
        }
    }

    build_record_pointer_path: fn(self, key: String) -> String Never! {
        files.join(files.join(files.join(self.root(), "build-records"), "records"), ArtifactDigest.hash(key.bytes()).to_hex())
    }

    read_build_pointer: fn(self, path: String) -[FS]> ObjectHandle? ArtifactStoreError! {
        bytes: if store_artifact_read_file(path) == {
            .Missing -> {
                return Ok(None)
            }
            .Corrupt(reason) -> {
                return Err(ArtifactStoreError.Corrupt{path: path, reason: reason})
            }
            .Bytes(read) -> read
        }
        text: String.from_bytes(bytes) ?? return Err(ArtifactStoreError.Corrupt{path: path, reason: "build record pointer is not UTF-8"})
        parts: store_artifact_split_once(text.trim(), ":") ?? return Err(ArtifactStoreError.Corrupt{path: path, reason: "build record pointer has invalid handle"})
        digest: ArtifactDigest.from_hex(parts.before)
        length: store_artifact_parse_count(parts.after) ?? return Err(ArtifactStoreError.Corrupt{path: path, reason: "build record pointer has invalid length"})
        Ok(Val(ObjectHandle.new(digest, length)))
    }

    get_object: fn(self, object: ObjectHandle) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        self.get_blob(object)
    }

    contains: fn(self, object: ObjectHandle) -[FS, Env, Exec, Time, Rand]> Bool ArtifactStoreError! {
        found: self.get_blob(object)
        Ok(found != None)
    }

    publish_action: fn(self, action: ActionHandle, record: [U8]) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        self.publish_action_entry(action, record, durable: true)
    }

    // `publish_action`, written with its disk syncs when `durable`.
    publish_action_entry: fn(self, action: ActionHandle, record: [U8], durable: Bool) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        path: self.action_path(action)
        key: ArtifactEntryKey.Action(action.key())
        encoded: store_artifact_encode_action(action, record)
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        if store_artifact_read_file(path) == {
            .Missing -> {}
            .Corrupt(reason) -> self.quarantine_locked(key, path, reason)
            .Bytes(existing) -> {
                if store_artifact_decode_action(action, existing) == {
                    .Ok(value) -> {
                        if value != record -> return Err(ArtifactStoreError.Conflict{path: path})
                        return self.append_journal_locked("touch", key, existing.len(), durable: false)
                    }
                    .Err(error) -> self.quarantine_locked(key, path, error.reason)
                }
            }
        }
        self.ensure_capacity_locked(encoded.len(), path)
        store_artifact_replace_file(path, encoded, durable)
        self.append_journal_locked("put", key, encoded.len(), durable)
    }

    get_action: fn(self, action: ActionHandle) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        record: self.get_action_untouched(action)
        if record != None -> self.touch_actions([ActionHandle]{action})
        Ok(record)
    }

    // Read one action record without recording the use in the journal. A caller
    // that reads many records in one run records the uses together with
    // `touch_actions`.
    get_action_untouched: fn(self, action: ActionHandle) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        key: ArtifactEntryKey.Action(action.key())
        path: self.action_path(action)
        if store_artifact_read_file(path) == {
            .Missing -> Ok(None)
            .Corrupt(reason) -> {
                self.quarantine_after_read(key, path, reason)
                Ok(None)
            }
            .Bytes(bytes) -> {
                if store_artifact_decode_action(action, bytes) == {
                    .Ok(record) -> Ok(Val(record))
                    .Err(error) -> {
                        if store_artifact_is_unsupported_version(bytes) -> return Ok(None)
                        self.quarantine_after_read(key, path, error.reason)
                        Ok(None)
                    }
                }
            }
        }
    }

    // Record one use of each stored action record under one lock and one
    // journal write. A failure only costs eviction order.
    touch_actions: fn(self, actions: [ActionHandle]) Never! -[FS, Env, Time, Rand]> {
        if actions.len() == 0 -> return
        lock: self.acquire_lock() ?? return
        defer close(lock)
        entries := [ArtifactJournalAppend]{}
        loop action in actions {
            info: files.stat(self.action_path(action)) ?? next
            entries.push(ArtifactJournalAppend{operation: "touch", key: ArtifactEntryKey.Action(action.key()), length: info.size})
        }
        self.append_journal_entries_locked(entries, durable: false).drop("recency is advisory; a failed touch only costs eviction order")
    }

    // Publish many action records under one lock, one capacity check and one
    // journal write. A key that already holds different bytes is left as it
    // is (the `Conflict` of `publish_action`); the others still land.
    publish_actions: fn(self, records: [ArtifactActionPublication]) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        self.publish_action_batch(records, true)
    }

    // `publish_actions` for records that only cache recomputable results: each
    // record is written without its own disk syncs. A read verifies every
    // record against its digest, so a record a crash lost or tore reads as
    // missing and its result is recomputed.
    publish_cache_actions: fn(self, records: [ArtifactActionPublication]) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        self.publish_action_batch(records, false)
    }

    publish_action_batch: fn(self, records: [ArtifactActionPublication], durable: Bool) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        if records.len() == 0 -> return
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        journal := [ArtifactJournalAppend]{}
        pending := [ArtifactPendingWrite]{}
        loop record in records {
            path: self.action_path(record.action)
            key: ArtifactEntryKey.Action(record.action.key())
            if store_artifact_read_file(path) == {
                .Missing -> {}
                .Corrupt(reason) -> self.quarantine_locked(key, path, reason)
                .Bytes(existing) -> {
                    if store_artifact_decode_action(record.action, existing) == {
                        .Ok(value) -> {
                            if value == record.bytes -> journal.push(ArtifactJournalAppend{operation: "touch", key: key, length: existing.len()})
                            next
                        }
                        .Err(error) -> self.quarantine_locked(key, path, error.reason)
                    }
                }
            }
            pending.push(ArtifactPendingWrite{path: path, key: key, encoded: store_artifact_encode_action(record.action, record.bytes)})
        }
        if pending.len() > 0 {
            incoming := 0
            loop write in pending -> incoming = store_artifact_saturating_add(incoming, write.encoded.len())
            self.ensure_capacity_locked(incoming, pending[0].path)
        }
        loop write in pending {
            if durable -> store_artifact_atomic_write(write.path, write.encoded) else -> store_artifact_replace_unsynced(write.path, write.encoded)
            journal.push(ArtifactJournalAppend{operation: "put", key: write.key, length: write.encoded.len()})
        }
        self.append_journal_entries_locked(journal, durable)
    }

    action: fn(self, key: String) -> ActionHandle Never! { ActionHandle.from_key(key) }

    publish_lto: fn(self, namespace: String, bytes: [U8]) -[FS, Env, Exec, Time, Rand]> ObjectHandle ArtifactStoreError! {
        valid: LTONamespace.new(namespace)
        object: ObjectHandle.from_bytes(bytes)
        key: ArtifactEntryKey.LTO{namespace: valid.name(), key: object.key()}
        self.publish_data(key, self.lto_path(valid.name(), object), bytes, durable: true)
        Ok(object)
    }

    get_lto: fn(self, namespace: String, object: ObjectHandle) -[FS, Env, Exec, Time, Rand]> [U8]? ArtifactStoreError! {
        valid: LTONamespace.new(namespace)
        key: ArtifactEntryKey.LTO{namespace: valid.name(), key: object.key()}
        path: self.lto_path(valid.name(), object)
        if store_artifact_read_file(path) == {
            .Missing -> Ok(None)
            .Corrupt(reason) -> {
                self.quarantine_after_read(key, path, reason)
                Ok(None)
            }
            .Bytes(bytes) -> {
                if bytes.len() != object.length() || ArtifactDigest.hash(bytes) != object.digest() {
                    self.quarantine_after_read(key, path, "digest or length mismatch")
                    return Ok(None)
                }
                self.touch_after_read(key, bytes.len())
                Ok(Val(bytes))
            }
        }
    }

    lto_namespace: fn(self, namespace: String) -> LTONamespace ArtifactStoreError! {
        LTONamespace.new(namespace)
    }

    acquire_lease: fn(self, objects: [ObjectHandle]) -[FS, Env, Time, Rand]> ArtifactLease ArtifactStoreError! {
        targets := [LeaseTarget]{}
        loop object in objects -> targets.push(LeaseTarget.Blob(object))
        self.acquire_artifact_lease(targets)
    }

    lease: fn(self, objects: [ObjectHandle]) -[FS, Env, Time, Rand]> ArtifactLease ArtifactStoreError! {
        self.acquire_lease(objects)
    }

    // Pin `targets` from pruning until the returned lease is closed.
    acquire_artifact_lease: fn(self, targets: [LeaseTarget]) -[FS, Env, Time, Rand]> ArtifactLease ArtifactStoreError! {
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        directory: files.join(self.root(), "leases")
        path: files.join(directory, "lease-{self.owner_value.pid()}-{store_artifact_unique_token()}")
        keys := [ArtifactEntryKey]{}
        loop target in targets -> keys.push(target.entry_key())
        text := self.owner_value.owner_line("lease")
        loop key in store_artifact_unique_keys(keys) -> text = "{text}{key.kind_name()}|{key.wire_value()}\n"
        store_artifact_create_new(path, text.bytes())
        Ok(ArtifactLease{path_value: path, owner_value: self.owner_value})
    }

    status: fn(self) -[FS, Env, Exec, Time, Rand]> ArtifactStoreStatus ArtifactStoreError! {
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        self.status_locked()
    }

    // The persisted machine-level cap, if one was configured.
    host_limit: fn(self) -[FS]> Int? ArtifactStoreError! {
        path: self.host_limit_path()
        bytes: if files.read_bytes(path) == {
            .Ok(read) -> read
            .Err(error) -> {
                if store_artifact_io_missing(error) -> return Ok(None)
                return Err(ArtifactStoreError.IO(error))
            }
        }
        text: String.from_bytes(bytes) ?? return Err(ArtifactStoreError.Config("host limit is not valid UTF-8: {path}"))
        value: text.trim()
        if value == "" -> return Err(ArtifactStoreError.Config("host limit is empty: {path}"))
        Ok(Val(store_artifact_parse_size(value)))
    }

    // Persist or clear the stricter machine-level cap.
    set_host_limit: fn(self, limit_bytes: Int?) ArtifactStoreError! -[FS, Env, Time, Rand]> {
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        path: self.host_limit_path()
        if limit_bytes == {
            .Val(limit) -> store_artifact_atomic_write(path, "{limit}\n".bytes())
            .None -> {
                if files.remove(path) == {
                    .Ok(_) -> store_artifact_sync_dir(self.root())
                    .Err(error) -> {
                        if store_artifact_io_missing(error) -> return
                        return Err(ArtifactStoreError.IO(error))
                    }
                }
            }
        }
    }

    prune: fn(self, target_bytes: Int?) -[FS, Env, Exec, Time, Rand]> ArtifactPruneReport ArtifactStoreError! {
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        target: if target_bytes == {
            .Val(bytes) -> bytes
            .None -> self.limit()
        }
        self.prune_locked(target)
    }

    prune_to: fn(self, target_bytes: Int) -[FS, Env, Exec, Time, Rand]> ArtifactPruneReport ArtifactStoreError! {
        self.prune(Val(target_bytes))
    }

    // Publish a file as one CAS blob and an immutable action record keyed by
    // the caller's already-computed lower-case SHA-256 build key, with their
    // disk syncs when `durable`. An artifact a build recomputes is published
    // without them: a read verifies its digest, so one a crash lost or tore
    // reads as missing and is built again.
    // Rust order: the source is checked and read before the key is decoded.
    publish_file: fn(self, key: String, source: String, durable: Bool) -[FS, Env, Exec, Time, Rand]> StoredArtifact ArtifactStoreError! {
        metadata: files.stat(source)
        if metadata.is_symlink || !metadata.is_file {
            return Err(ArtifactStoreError.Corrupt{path: source, reason: "published artifact is not a regular file"})
        }
        bytes: files.read_bytes(source)
        self.publish_bytes(key, bytes, store_artifact_is_executable(metadata), durable)
    }

    // Publish in-memory bytes as one CAS blob and an immutable action record
    // keyed by the caller's already-computed lower-case SHA-256 build key,
    // durable as `publish_file`. The bytes are hashed once; the blob is
    // written atomically under that digest, so the returned handle names
    // exactly these bytes.
    publish_bytes: fn(self, key: String, bytes: [U8], executable: Bool, durable: Bool) -[FS, Env, Exec, Time, Rand]> StoredArtifact ArtifactStoreError! {
        action: store_artifact_action_for_key(key)
        object: ObjectHandle.from_bytes(bytes)
        path: self.object_path(object)
        self.publish_data(ArtifactEntryKey.Blob(object.key()), path, bytes, durable)
        self.publish_action_entry(action, store_artifact_encode_record(object, executable), durable)
        Ok(StoredArtifact{action, object, path, executable})
    }

    // Verify and locate a named artifact without copying it.
    lookup_artifact: fn(self, key: String) -[FS, Env, Exec, Time, Rand]> ArtifactLookup ArtifactStoreError! {
        action: store_artifact_action_for_key(key)
        action_key: ArtifactEntryKey.Action(action.key())
        action_path: self.action_path(action)
        record: if store_artifact_read_file(action_path) == {
            .Missing -> {
                return Ok(ArtifactLookup.Missing)
            }
            .Corrupt(reason) -> {
                self.quarantine_after_read(action_key, action_path, reason)
                return Ok(ArtifactLookup.Corrupt)
            }
            .Bytes(bytes) -> {
                if store_artifact_decode_action(action, bytes) == {
                    .Ok(decoded) -> decoded
                    .Err(error) -> {
                        if store_artifact_is_unsupported_version(bytes) -> return Ok(ArtifactLookup.Missing)
                        self.quarantine_after_read(action_key, action_path, error.reason)
                        return Ok(ArtifactLookup.Corrupt)
                    }
                }
            }
        }
        decoded: if store_artifact_decode_record(record) == {
            .Val(found) -> found
            .None -> {
                self.quarantine_after_read(action_key, action_path, "artifact record has an unknown version or short header")
                return Ok(ArtifactLookup.Corrupt)
            }
        }
        object: decoded.object
        object_key: ArtifactEntryKey.Blob(object.key())
        object_path: self.object_path(object)
        if store_artifact_read_file(object_path) == {
            .Missing -> {
                self.quarantine_after_read(action_key, action_path, "artifact record references a missing object")
                Ok(ArtifactLookup.Corrupt)
            }
            .Corrupt(reason) -> {
                self.quarantine_after_read(object_key, object_path, reason)
                self.quarantine_after_read(action_key, action_path, "artifact record references a corrupt object")
                Ok(ArtifactLookup.Corrupt)
            }
            .Bytes(bytes) -> {
                if bytes.len() != object.length() || ArtifactDigest.hash(bytes) != object.digest() {
                    self.quarantine_after_read(object_key, object_path, "digest or length mismatch")
                    self.quarantine_after_read(action_key, action_path, "artifact record references a corrupt object")
                    return Ok(ArtifactLookup.Corrupt)
                }
                self.touch_after_read(object_key, bytes.len())
                self.touch_after_read(action_key, record.len())
                Ok(ArtifactLookup.Hit(StoredArtifact{action, object, path: object_path, executable: decoded.executable}))
            }
        }
    }

    // Verify and copy a named artifact to `destination`, preserving its
    // executable bit. The copy is a build output its caller can restore
    // again, so it is written without disk syncs. Corrupt entries are removed
    // from the active namespace.
    restore_file: fn(self, key: String, destination: String) -[FS, Env, Exec, Time, Rand]> ArtifactRestore ArtifactStoreError! {
        if self.lookup_artifact(key) == {
            .Missing -> Ok(ArtifactRestore.Missing)
            .Corrupt -> Ok(ArtifactRestore.Corrupt)
            .Hit(artifact) -> {
                lease: self.acquire_artifact_lease([LeaseTarget]{LeaseTarget.Action(artifact.action), LeaseTarget.Blob(artifact.object)}) ?? return Err(err)
                defer close(lease)
                bytes: files.read_bytes(artifact.path)
                store_artifact_replace_unsynced(destination, bytes)
                store_artifact_set_executable(destination, artifact.executable)
                Ok(ArtifactRestore.Hit{object: artifact.object, executable: artifact.executable})
            }
        }
    }

    // Publish one entry's bytes at `path`, with their disk syncs when
    // `durable`.
    publish_data: fn(self, key: ArtifactEntryKey, path: String, bytes: [U8], durable: Bool) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        self.ensure_layout()
        lock: self.acquire_lock() ?? return Err(err)
        defer close(lock)
        if store_artifact_read_file(path) == {
            .Missing -> {}
            .Corrupt(reason) -> self.quarantine_locked(key, path, reason)
            .Bytes(existing) -> {
                if existing == bytes -> return self.append_journal_locked("touch", key, existing.len(), durable: false)
                self.quarantine_locked(key, path, "existing bytes do not match their key")
            }
        }
        self.ensure_capacity_locked(bytes.len(), path)
        store_artifact_replace_file(path, bytes, durable)
        self.append_journal_locked("put", key, bytes.len(), durable)
    }

    // Scanned entries with their last use and whether a live lease pins them.
    // `pinned` is keyed by entry identity (the Rust BTreeSet lookup).
    annotated_entries: fn(self, journal: ArtifactJournalState, pinned: [String: Bool]) -[FS]> [ArtifactStoredEntry] ArtifactStoreError! {
        entries := self.scan_entries()
        loop index in 0..<entries.len() {
            entries[index].last_use = journal.last_use_of(entries[index].key)
            entries[index].pinned = pinned.has_key(entries[index].key.identity())
        }
        Ok(entries)
    }

    pinned_identities: fn(self, leases: [ArtifactLeaseRecord]) -> [String: Bool] Never! {
        pinned := [String: Bool]{}
        loop lease in leases {
            loop target in lease.targets -> pinned[target.identity()] = true
        }
        pinned
    }

    status_locked: fn(self) -[FS, Env, Exec, Time, Rand]> ArtifactStoreStatus ArtifactStoreError! {
        journal_path: files.join(self.root(), "journal")
        journal := store_artifact_read_journal(journal_path)
        if !journal.valid {
            self.compact_journal_locked()
            journal = store_artifact_read_journal(journal_path)
        }
        leases: self.read_leases_locked(true)
        entries: store_artifact_sort_entries(self.annotated_entries(journal, self.pinned_identities(leases)))
        footprint: store_artifact_footprint(entries)
        disk: store_artifact_filesystem_stats(self.root())
        total: if disk == {
            .Val(stats) -> Val(stats.total_bytes)
            .None -> None
        }
        available: if disk == {
            .Val(stats) -> Val(stats.available_bytes)
            .None -> None
        }
        statuses := [ArtifactEntryStatus]{}
        loop entry in entries -> statuses.push(entry.status())
        Ok(ArtifactStoreStatus{
            root: self.root(),
            footprint_bytes: footprint,
            limit_bytes: self.limit_with_disk(total),
            reserve_bytes: self.config_value.reserve_bytes(),
            available_bytes: available,
            live_leases: leases.len(),
            host_limit_bytes: self.host_limit(),
            entries: statuses,
            tiers: [String]{"local"},
        })
    }

    // Remove unpinned entries, least recently used first (ties by key), until
    // the footprint fits `target_bytes`.
    prune_locked: fn(self, target_bytes: Int) -[FS, Env, Rand]> ArtifactPruneReport ArtifactStoreError! {
        journal: store_artifact_read_journal(files.join(self.root(), "journal"))
        leases: self.read_leases_locked(true)
        entries: self.annotated_entries(journal, self.pinned_identities(leases))
        before: store_artifact_footprint(entries)
        pinned_bytes := 0
        loop entry in entries {
            if entry.pinned -> pinned_bytes = store_artifact_saturating_add(pinned_bytes, entry.size_bytes)
        }
        // Rust orders by (pinned, last_use, key) in one comparator; no reliance
        // on sort stability across two passes.
        order := entries.copy()
        order = loop fresh_item in order -> fresh_item
        order.sort_by(fn(left: ArtifactStoredEntry, right: ArtifactStoredEntry) { ((if left.pinned -> 1 else -> 0) <=> (if right.pinned -> 1 else -> 0)).then(left.last_use <=> right.last_use).then(store_artifact_entry_order(left, right)) })
        after := before
        removed := [ArtifactEntryStatus]{}
        loop entry in order {
            if after <= target_bytes -> break
            if entry.pinned -> next
            if files.remove(entry.path) == {
                .Ok(_) -> {
                    store_artifact_sync_dir(files.dirname(entry.path))
                    after = store_artifact_saturating_sub(after, entry.size_bytes)
                    self.append_journal_locked("remove", entry.key, entry.size_bytes, durable: true)
                    removed.push(entry.status())
                }
                .Err(error) -> {
                    if !store_artifact_io_missing(error) -> return Err(ArtifactStoreError.IO(error))
                }
            }
        }
        if removed.len() > 0 || journal.bytes > STORE_ARTIFACT_MAX_JOURNAL_BYTES -> self.compact_journal_locked()
        Ok(ArtifactPruneReport{
            target_bytes,
            before_bytes: before,
            after_bytes: after,
            removed,
            pinned_bytes,
            blocked: after > target_bytes,
        })
    }

    // Admit `incoming` bytes for `path`: within the limit after pruning, and
    // leaving twice the payload plus the reserve free on disk.
    ensure_capacity_locked: fn(self, incoming: Int, path: String) ArtifactStoreError! -[FS, Env, Exec, Time, Rand]> {
        disk: store_artifact_filesystem_stats(self.root())
        total: if disk == {
            .Val(stats) -> Val(stats.total_bytes)
            .None -> None
        }
        available: if disk == {
            .Val(stats) -> Val(stats.available_bytes)
            .None -> None
        }
        limit: self.limit_with_disk(total)
        if incoming > limit {
            return Err(ArtifactStoreError.Capacity{path: path, needed_bytes: incoming, available_bytes: available, limit_bytes: limit})
        }
        footprint: self.footprint_locked()
        after := footprint
        if store_artifact_saturating_add(footprint, incoming) > limit {
            // Rust `let _ = self.prune_locked(..)?`: discard the report, never a prune failure.
            _: self.prune_locked(store_artifact_saturating_sub(limit, incoming))
            after = self.footprint_locked()
        }
        disk_needed: store_artifact_saturating_add(store_artifact_saturating_mul(incoming, 2), self.config_value.reserve_bytes())
        disk_ok: if available == {
            .Val(free) -> free >= disk_needed
            .None -> true
        }
        if store_artifact_saturating_add(after, incoming) > limit || !disk_ok {
            return Err(ArtifactStoreError.Capacity{path: path, needed_bytes: incoming, available_bytes: available, limit_bytes: limit})
        }
    }

    // The bytes of the store's entries, from the footprint tally
    // (STORE_ARTIFACT_FOOTPRINT_FILE) and the journal lines after it, else
    // from a scan of every entry; either way the tally moves to the journal's
    // current end. The tally only caches what a scan recomputes, so it is
    // written without disk syncs and a failed write only costs a later scan.
    footprint_locked: fn(self) -[FS, Env, Rand]> Int ArtifactStoreError! {
        journal_path: files.join(self.root(), "journal")
        journal_bytes: if files.stat(journal_path) == {
            .Ok(info) -> info.size
            .Err(error) -> {
                if !store_artifact_io_missing(error) -> return Err(ArtifactStoreError.IO(error))
                0
            }
        }
        tally_path: files.join(self.root(), STORE_ARTIFACT_FOOTPRINT_FILE)
        if store_artifact_footprint_replay(tally_path, journal_path, journal_bytes) == .Val(tally) {
            store_artifact_replace_unsynced(tally_path, store_artifact_footprint_tally_text(tally).bytes()).drop("a lost tally only costs a later scan")
            return Ok(tally.entry_bytes)
        }
        total: store_artifact_footprint(self.scan_entries())
        if store_artifact_journal_final_checksum(journal_path, journal_bytes) == .Val(checksum) {
            store_artifact_replace_unsynced(tally_path, store_artifact_footprint_tally_text(ArtifactFootprintTally{journal_bytes, entry_bytes: total, checksum}).bytes()).drop("a lost tally only costs a later scan")
        }
        Ok(total)
    }

    limit_with_disk: fn(self, total_bytes: Int?) -[FS]> Int Never! {
        adaptive: if total_bytes == {
            .Val(total) -> {
                tenth: total /% 10
                capped: if tenth < STORE_ARTIFACT_DEFAULT_CAP_BYTES -> tenth else -> STORE_ARTIFACT_DEFAULT_CAP_BYTES
                if capped < 1 -> 1 else -> capped
            }
            .None -> STORE_ARTIFACT_DEFAULT_CAP_BYTES
        }
        configured: self.config_value.cap_bytes() ?? adaptive
        host: if self.host_limit() == {
            .Ok(value) -> value
            .Err(_) -> None
        }
        if host == {
            .Val(limit) -> if limit < configured -> limit else -> configured
            .None -> configured
        }
    }

    host_limit_path: fn(self) -> String Never! { files.join(self.root(), "host-limit") }

    // The layout directories, created without syncs: a crash may lose a new
    // one with what it held, which the store reads as misses, and any later
    // run recreates it.
    ensure_layout: fn(self) ArtifactStoreError! -[FS]> {
        files.create_dir_all(self.root())
        layout: [String]{"cas", "ac", "lto", "locks", "leases", "quarantine", "build-records"}
        loop name in layout {
            store_artifact_ensure_dir(files.join(self.root(), name), durable: false)
        }
        records: files.join(self.root(), "build-records")
        store_artifact_ensure_dir(files.join(records, "records"), durable: false)
    }

    // Best-effort quarantine after a failed verification: a lock or rename
    // failure leaves the entry for the next reader.
    quarantine_after_read: fn(self, key: ArtifactEntryKey, path: String, reason: String) Never! -[FS, Env, Time, Rand]> {
        lock: self.acquire_lock() ?? return
        defer close(lock)
        self.quarantine_locked(key, path, reason).drop("a reader reports the miss whether or not the quarantine lands")
    }

    // Best-effort journal touch after a verified read.
    touch_after_read: fn(self, key: ArtifactEntryKey, length: Int) Never! -[FS, Env, Time, Rand]> {
        lock: self.acquire_lock() ?? return
        defer close(lock)
        self.append_journal_locked("touch", key, length, durable: false).drop("recency is advisory; the verified bytes are returned regardless")
    }

    quarantine_locked: fn(self, key: ArtifactEntryKey, path: String, reason: String) ArtifactStoreError! -[FS, Env, Rand]> {
        if !files.lexists(path) -> return
        quarantine: files.join(self.root(), "quarantine")
        store_artifact_ensure_dir(quarantine, durable: false)
        destination: files.join(quarantine, "{key.kind_name()}-{key.storage_key()}-{store_artifact_unique_token()}")
        if files.rename(path, destination) == {
            .Ok(_) -> {
                store_artifact_sync_dir(files.dirname(path))
                store_artifact_sync_dir(quarantine)
                length: if files.stat(destination) == {
                    .Ok(info) -> info.size
                    .Err(_) -> 0
                }
                self.append_journal_locked("remove", key, length, durable: true)
            }
            .Err(error) -> {
                if store_artifact_io_missing(error) -> return
                return Err(ArtifactStoreError.IO(error))
            }
        }
    }

    append_journal_locked: fn(self, operation: String, key: ArtifactEntryKey, length: Int, durable: Bool) ArtifactStoreError! -[FS, Env, Rand]> {
        self.append_journal_entries_locked([ArtifactJournalAppend]{ArtifactJournalAppend{operation: operation, key: key, length: length}}, durable)
    }

    // One journal line per entry after one read of the journal's final line and
    // one write, synced when `durable`: touches and cache entries are not. Only
    // a torn or corrupt tail compacts; full readers (status, prune, compaction)
    // verify every line.
    append_journal_entries_locked: fn(self, entries: [ArtifactJournalAppend], durable: Bool) ArtifactStoreError! -[FS, Env, Rand]> {
        if entries.len() == 0 -> return
        journal_path: files.join(self.root(), "journal")
        last_sequence := store_artifact_journal_tail_sequence(journal_path)
        if last_sequence == None {
            self.compact_journal_locked()
            compacted: store_artifact_read_journal(journal_path)
            last_sequence = Val(compacted.last_sequence)
        }
        base: last_sequence ?? 0
        lines := [String]{}
        loop (index, entry) in entries {
            lines.push(store_artifact_journal_line(entry.operation, entry.key, entry.length, store_artifact_saturating_add(base, index + 1)))
        }
        store_artifact_append(journal_path, lines.join("").bytes(), durable)
    }

    // Rewrite the journal as one `put` per present entry, oldest use first
    // (ties by key, the Rust `(last_use, key)` order).
    compact_journal_locked: fn(self) ArtifactStoreError! -[FS, Env, Rand]> {
        journal_path: files.join(self.root(), "journal")
        journal: store_artifact_read_journal(journal_path)
        entries := self.annotated_entries(journal, [String: Bool]{})
        entries = loop fresh_item in entries -> fresh_item
        entries.sort_by(fn(left: ArtifactStoredEntry, right: ArtifactStoredEntry) { (left.last_use <=> right.last_use).then(store_artifact_entry_order(left, right)) })
        lines := [String]{}
        loop index in 0..<entries.len() {
            lines.push(store_artifact_journal_line("put", entries[index].key, entries[index].size_bytes, index + 1))
        }
        store_artifact_atomic_write(journal_path, lines.join("").bytes())
    }

    // The parsed leases whose owners may still be running. Leases of dead
    // owners are removed when `clean_stale` is set.
    read_leases_locked: fn(self, clean_stale: Bool) -[FS, Env]> [ArtifactLeaseRecord] ArtifactStoreError! {
        directory: files.join(self.root(), "leases")
        live := [ArtifactLeaseRecord]{}
        loop path in store_artifact_sorted_children(directory) {
            if !files.basename(path).starts_with("lease-") -> next
            bytes: if files.read_bytes(path) == {
                .Ok(read) -> read
                .Err(error) -> {
                    if store_artifact_io_missing(error) -> next
                    return Err(ArtifactStoreError.IO(error))
                }
            }
            record: store_artifact_parse_lease(bytes) ?? next
            if store_artifact_owner_liveness(record.owner, self.owner_value) == {
                .Val(alive) -> {
                    if alive -> live.push(record)
                    if !alive && clean_stale -> store_artifact_try_remove(path)
                }
                .None -> live.push(record)
            }
        }
        Ok(live)
    }

    scan_entries: fn(self) -[FS]> [ArtifactStoredEntry] ArtifactStoreError! {
        entries := [ArtifactStoredEntry]{}
        store_artifact_scan_flat_namespace(files.join(self.root(), "cas"), .Blob, None, entries)
        store_artifact_scan_flat_namespace(files.join(self.root(), "ac"), .Action, None, entries)
        lto_root: files.join(self.root(), "lto")
        loop namespace_path in store_artifact_sorted_children(lto_root) {
            metadata: if files.stat(namespace_path) == {
                .Ok(info) -> info
                .Err(error) -> {
                    if store_artifact_io_missing(error) -> next
                    return Err(ArtifactStoreError.IO(error))
                }
            }
            if !metadata.is_dir || metadata.is_symlink -> next
            namespace: files.basename(namespace_path)
            LTONamespace.new(namespace) ?? next
            store_artifact_scan_flat_namespace(namespace_path, .LTO, Val(namespace), entries)
        }
        Ok(store_artifact_sort_entries(entries))
    }

    // Take the machine-wide store lock, reclaiming it from a dead owner and
    // waiting for a live one with capped exponential backoff up to the
    // configured bound.
    acquire_lock: fn(self) -[FS, Env, Time]> ArtifactStoreLock ArtifactStoreError! {
        locks: files.join(self.root(), "locks")
        path: files.join(locks, "store.lock")
        owner_line: self.owner_value.owner_line("lock")
        started: time.instant()
        deadline: started + self.config_value.lock_wait()
        retry_ms := STORE_ARTIFACT_LOCK_RETRY_MS
        loop {
            if files.create(path, if_exists: .Refuse) == {
                .Ok(created) -> {
                    writer := created
                    writer.write_all(owner_line.bytes())
                    close(writer)
                    return Ok(ArtifactStoreLock{path, owner_line: owner_line.bytes()})
                }
                .Err(error) -> {
                    // #3593: only AlreadyExists is lock contention, not any IO error.
                    if error == {
                        .AlreadyExists(_) -> {}
                        .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .Unsupported(_) -> return Err(ArtifactStoreError.IO(error))
                    }
                }
            }
            existing_owner: if files.read_bytes(path) == {
                .Ok(bytes) -> store_artifact_parse_owner_line(bytes)
                .Err(_) -> None
            }
            owner_pid: if existing_owner == {
                .Val(identity) -> Val(identity.pid())
                .None -> None
            }
            is_live: if existing_owner == {
                .Val(identity) -> store_artifact_owner_liveness(identity, self.owner_value) ?? true
                .None -> true
            }
            if !is_live && store_artifact_try_remove(path) {
                retry_ms = STORE_ARTIFACT_LOCK_RETRY_MS
                next
            }
            now: time.instant()
            if now >= deadline {
                return Err(ArtifactStoreError.Locked{path: path, owner_pid: owner_pid, elapsed_ns: (now - started).ns})
            }
            remaining_ns: (deadline - now).ns
            wait_ns: if retry_ms * 1000000 < remaining_ns -> retry_ms * 1000000 else -> remaining_ns
            time.sleep(time.duration_ns(wait_ns))
            retry_ms = if retry_ms * 2 < STORE_ARTIFACT_LOCK_RETRY_MAX_MS -> retry_ms * 2 else -> STORE_ARTIFACT_LOCK_RETRY_MAX_MS
        }
    }
}

// Append the regular, digest-named files of one namespace directory.
store_artifact_scan_flat_namespace: fn(directory: String, kind: ArtifactEntryKind, namespace: String?, output: &[ArtifactStoredEntry]) ArtifactStoreError! -[FS]> {
    loop path in store_artifact_sorted_children(directory) {
        metadata: if files.stat(path) == {
            .Ok(info) -> info
            .Err(error) -> {
                if store_artifact_io_missing(error) -> next
                return Err(ArtifactStoreError.IO(error))
            }
        }
        if metadata.is_symlink || !metadata.is_file -> next
        name: files.basename(path)
        ArtifactDigest.from_hex(name) ?? next
        key: if kind == {
            .Blob -> ArtifactEntryKey.Blob(name)
            .Action -> ArtifactEntryKey.Action(name)
            .LTO -> ArtifactEntryKey.LTO{namespace: namespace ?? panic("an LTO scan always names its namespace"), key: name}
        }
        output.push(ArtifactStoredEntry{key, path, size_bytes: metadata.size, last_use: 0, pinned: false})
    }
}

// Remove one file; whether it was removed.
store_artifact_try_remove: fn(path: String) -[FS]> Bool Never! {
    if files.remove(path) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}
