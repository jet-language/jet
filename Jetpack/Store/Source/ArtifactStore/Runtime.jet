// Rust: crates/jet-store/src/runtime.rs:546
// Rust: crates/jet-store/src/runtime.rs:552
// Rust: crates/jet-store/src/runtime.rs:561
fn os_bytes(value: OSPath) -> [U8] {
    // GATE #4483: cfg family selection; #4494: native OsStr codec.
    family :: target.selected_family()
    if family == "unix" -> return value.encoded
    if family == "windows" {
        out := [U8]{}
        loop word in std.os.windows.ffi.OsStrExt.encode_wide(value) { // GATE #4494
            &out.push(U8{word & U16{255}})
            &out.push(U8{word >> 8})
        }
        return out
    }
    std.ffi.OsStr.to_string_lossy(value).bytes() // GATE #4494
}

// Rust: crates/jet-store/src/runtime.rs:568
// rustc_identity: NativeRuntimeIdentityCache.rustc_identity, NativeRuntimeCache.jet:71;
// spawn/finish phases below preserve the source's concurrent CPU/version queries.

// Rust: crates/jet-store/src/runtime.rs:601
struct RustcQuery {
    rendered: String
    child: std.process.Child IOError! // GATE #4494
}

// Rust: crates/jet-store/src/runtime.rs:606
fn spawn_rustc_query(rustc: OSPath, rustc_env: [(OSPath, OSPath)], args: [String]) -> RustcQuery {
    command := std.process.Command.new(rustc) // GATE #4494
    &command.args(args)
    &command.stdin(std.process.Stdio.null())
    &command.stdout(std.process.Stdio.piped())
    &command.stderr(std.process.Stdio.piped())
    loop (name, value) in rustc_env -> &command.env(name, value)
    RustcQuery{rendered: args.join(" "), child: command.spawn()}
}

// Rust: crates/jet-store/src/runtime.rs:622
fn finish_rustc_query(query: RustcQuery) -> String Err! {
    rendered :: query.rendered
    child :: query.child ?? return Err("could not run rustc {rendered}: {err}")
    output :: child.wait_with_output() ?? return Err("could not run rustc {rendered}: {err}") // GATE #4494
    if !output.status.success() {
        return Err("rustc {rendered} failed: {String.from_utf8_lossy(output.stderr)}")
    }
    Ok(String.from_utf8_lossy(output.stdout))
}

