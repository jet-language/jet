//RS /// A `pub(crate) use …;` at module scope IS part of the runtime boundary: it is
//RS /// how the Core prelude publishes a fragment it keeps inside a private module
//RS /// (`mod jet_sync { … } pub(crate) use jet_sync::*;` — `core.sync` CRDTs, the
//RS /// `core.db` row policy, `app.sync`; `mod jet_crypto_entropy` likewise). Left
//RS /// alone, the split runtime rlib kept those names crate-private and the user
//RS /// crate could not see a single one, so rustc rejected generated code that the
//RS /// monolith accepts. A *bare* `use` is a private import, not a boundary, and
//RS /// stays private so no `std` path leaks into the program's glob namespace.
//RS fn starts_restricted_reexport(code: &str) -> bool {
//RS     restricted_visibility_rest(code).is_some_and(|rest| rest.starts_with("use "))
//RS }
