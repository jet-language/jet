// PORT-PENDING 2118 crates-jet-store-src-runtime: crates/jet-store/src/runtime.rs:1-1034
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Content-addressed native runtime rlib cache.
//RS //!
//RS //! Codegen keeps emitting one complete Rust program for inspection and I1/I2
//RS //! audits. Native builders extract its marked Prelude/runtime and Core blocks,
//RS //! compile that mutually dependent closure once as ONE `jet_runtime` rlib, then
//RS //! link the user program against it. The two blocks reference each other
//RS //! (the fixed runtime reaches `jet_std`, the scheduler world, SIMD kernels and
//RS //! `DataTree` in the Core block, and Core reaches the runtime traits), so they
//RS //! cannot be two crates: Rust crates cannot depend on each other cyclically.
//RS //! The Core block is selected only by build facts (edition, OS, test harness,
//RS //! runtime parts, devtools policy), never by user source, so the key is the
//RS //! (runtime source, rustc identity, flags) tuple and many programs share it.
//RS //!
//RS //! Packaging prebuilds the default build-fact set: the `jet-runtime/`
//RS //! directory beside the `jet` executable holds `<key>/libjet_runtime.rlib`
//RS //! under exactly this key, so a fresh machine with an empty store links the
//RS //! shipped rlib instead of compiling the runtime. Other keys (another rustc,
//RS //! profile, CPU, or feature set) miss it and build on demand into the store.
//RS 
//RS use crate::{ArtifactLookup, ArtifactRestore, Lease, LeaseTarget, Store, StoreError, StoredArtifact};
//RS use jet_foundation::RustSource::rust_code_mask;
//RS use jet_foundation::SHA256::sha256_hex;
//RS use std::collections::HashMap;
//RS use std::ffi::{OsStr, OsString};
//RS use std::fs;
//RS use std::path::{Path, PathBuf};
//RS use std::process::{Command, Stdio};
//RS use std::sync::atomic::{AtomicU64, Ordering};
//RS use std::sync::{LazyLock, Mutex};
//RS 
//RS const CACHE_SCHEMA: &[u8] = b"jet-runtime-rlib-v9";
//RS const RUNTIME_CRATE_NAME: &str = "jet_runtime";
//RS const RUNTIME_RLIB_FILE: &str = "libjet_runtime.rlib";
//RS const RUNTIME_CRATE_PREFIX: &str = "#![allow(warnings)]\n";
//RS const BEGIN: &str = "// jet:cached-runtime-begin\n";
//RS const END: &str = "// jet:cached-runtime-end\n";
//RS const CORE_BEGIN: &str = "// jet:cached-core-begin\n";
//RS const CORE_END: &str = "// jet:cached-core-end\n";
//RS /// Directory beside the `jet` executable holding prebuilt runtime rlibs as
//RS /// `<key>/libjet_runtime.rlib`.
//RS pub const PREBUILT_DIR_NAME: &str = "jet-runtime";
//RS /// When set, every runtime rlib a process links is also written to this
//RS /// directory in the `PREBUILT_DIR_NAME` layout. The packaging step sets it
//RS /// while building a seed program to populate the shipped prebuilt directory.
//RS pub const PREBUILD_EXPORT_ENV: &str = "JET_RUNTIME_PREBUILD_DIR";
//RS /// Separates the `rustc -vV` identity from the host CPU description when the
//RS /// flags select `target-cpu=native`: the key must name the CPU the rlib was
//RS /// tuned for, or a prebuilt rlib could reach a machine lacking its features.
//RS const NATIVE_CPU_IDENTITY: &str = "jet:target-cpu=native\n";
