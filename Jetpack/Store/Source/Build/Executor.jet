// The sandboxed build executor (front end complete, no remote binding, no
// compiler runner: the entry `jet cc` / `jet c++` use).
// Every action and probe runs through the one native child boundary
// (Foundation NativeSandbox: Linux Bubblewrap, macOS Seatbelt); there is no
// unsandboxed fallback. The actions of one batch run at once, each in its
// own child; every member still runs and the batch reports its first error
// in action order.

use {
    jet_foundation.[DiagnosticBuildError, DiagnosticErrorDetails, DiagnosticErrorField, foundation_json_quote]
    jet_pkg_model.[pkg_json_text]
    jetpack_foundation.[
        BuildEffect, NATIVE_SANDBOX_DEFAULT_ACTION_TIMEOUT_MS, NativeSandboxCommand, NativeSandboxError, NativeSandboxMount,
        foundation_find_folder, foundation_library_folders, foundation_native_sandbox_command, foundation_native_sandbox_finish,
        foundation_run_native_sandboxed_with_timeout_and_mounts, foundation_sandbox_program_argument,
    ]
    jetpack_artifact_store.[StampTable]
    files: core.files
    process: core.process
    random: core.crypto.random
    json: core.encoding.json
    sys: core.sys
    time: core.time
}

BuildProbeFact: struct {
    name: String
    success: Bool
    detail: String
    reproducibility: ReproducibilityClass
    toolchain: ToolchainHandle
    toolchain_provenance: ContentDigest
}

BuildExecutionResult: struct {
    report: BuildExecutionReport
    probes: [BuildProbeFact]
}

#Error
BuildExecutionError: enum {
    MissingGrant(action: String, capability: BuildEffect)
    // No native sandbox can run the action here; `reason` says why.
    SandboxUnavailable(reason: String)
    IO(action: String, detail: String)
    // The action ran past its wall-clock limit, in milliseconds, and was
    // killed. Where the host can read a process tree's CPU time, that limit
    // is only the hang guard (BUILD_WALL_GUARD times the step's limit).
    TimedOut(action: String, limit_ms: Int)
    // The action's process tree used more CPU time than its limit allows,
    // `limit_ms` on each of the host's `cores`, and was killed; `used_ms` is
    // the CPU time it had used.
    OverCPU(action: String, limit_ms: Int, cores: Int, used_ms: Int)
    ProbeFailed(probe: String, detail: String)
    // The find_folder probe `probe` found no folder holding a `file` that
    // fits; `searched` is each folder it looked in, with why it passed it.
    FolderNotFound(probe: String, file: String, searched: [String])
    // The one structured action-failure route, retained whether the action
    // ran now or its failure was restored from the cache.
    Reported(report: DiagnosticBuildError)
    InvalidGraph(HermeticBuildError)
    // The action's kept output `path` holds bytes no build wrote, so the
    // action published none of its outputs.
    HandEdited(action: String, path: String)

    report: fn(self) -> DiagnosticBuildError? Never! {
        if self == {
            .Reported(report) -> Val(report)
            .MissingGrant(_, _) | .SandboxUnavailable(_) | .IO(_, _) | .TimedOut(_, _) | .OverCPU(_, _, _, _) | .ProbeFailed(_, _) | .FolderNotFound(_, _, _) | .InvalidGraph(_) | .HandEdited(_, _) -> None
        }
    }

    is_reported_action_failure: fn(self) -> Bool Never! {
        self.report() != None
    }
}

// Rust `action_failure_report`: E3505 with the `BuildActionFailure` details.
build_action_failure_report: fn(action: String, exit_code: Int, stderr: String) -> DiagnosticBuildError Never! {
    DiagnosticBuildError{
        code: Val("E3505"),
        message: "build action `{action}` exited with status {exit_code}",
        typed_identity: Val("BuildAction.Failed"),
        details: Val(DiagnosticErrorDetails{
            variant: "BuildActionFailure",
            fields: [DiagnosticErrorField]{
                {name: "action", value: foundation_json_quote(action)},
                {name: "exit_code", value: "{exit_code}"},
                {name: "stderr", value: foundation_json_quote(stderr)},
            },
            source_span: None,
        }),
    }
}

// The failed action's stderr as it wrote it, read back from the report
// build_action_failure_report keeps it quoted in.
build_action_failure_stderr: fn(report: DiagnosticBuildError) -> String? Never! {
    details: report.details ?? return None
    loop field in details.fields {
        if field.name != "stderr" -> next
        tree: json.parse(field.value) ?? return None
        return pkg_json_text(tree)
    }
    None
}

// Execute the canonical action graph through the platform-native child
// boundary. Every selected action's declared abilities must be granted
// before anything runs; probes need the Exec grant. With `artifact_store`,
// an action with no ambient effect is restored from its stored record and a
// run one is stored; without it every action runs and nothing is stored.
// Callers give a store only while saved work is reused
// (BUILD_REUSE_SAVED_WORK, off), so a default build opens none.
build_execute_build_plan: fn(plan: HermeticBuildPlan, project_root: String, artifact_store: BuildArtifactStoreHandle?, grants: [BuildEffect]) -[FS, Env, Exec, Time, Time.Wait, Rand]> BuildExecutionResult BuildExecutionError! {
    selected_actions: plan.selected_action_ids() ?? return Err(BuildExecutionError.InvalidGraph(err))
    loop action in plan.actions {
        if !selected_actions.contains(action.id) -> next
        loop cap in action.caps {
            if !grants.contains(cap) -> return Err(BuildExecutionError.MissingGrant{action: action.name, capability: cap})
        }
    }
    selected_probes: plan.selected_probe_ids() ?? return Err(BuildExecutionError.InvalidGraph(err))
    if selected_probes.len() > 0 && !grants.contains(BuildEffect.Exec) {
        probe: plan.probes[selected_probes[0]]
        return Err(BuildExecutionError.MissingGrant{action: "probe {probe.name}", capability: BuildEffect.Exec})
    }
    probes: build_execute_probes(plan, selected_probes)
    model: plan.execution_model() ?? return Err(BuildExecutionError.InvalidGraph(err))
    outcomes := [BuildActionOutcomeRow]{}
    loop stage in model.stages {
        loop batch in build_execution_batches(plan, stage.actions) {
            results: build_execute_actions(plan, batch, project_root, artifact_store, grants, probes, batch.len(), None)
            completed := [BuildActionOutcomeRow]{}
            loop index in 0..<batch.len() {
                if results[index] == {
                    .Ok(outcome) -> completed.push(BuildActionOutcomeRow{action: HermeticActionHandle{id: batch[index], context: plan.context}, outcome})
                    .Err(error) -> return Err(error)
                }
            }
            completed.sort_by(fn(left: BuildActionOutcomeRow, right: BuildActionOutcomeRow) { left.action.id <=> right.action.id })
            loop row in completed -> outcomes.push(row)
        }
    }
    report: plan.execution_report(outcomes) ?? return Err(BuildExecutionError.InvalidGraph(err))
    Ok(BuildExecutionResult{report, probes})
}

// Rust `execution_batches`: deterministic resource-pool packing. CPU and
// memory have automatic capacity; linker, console, GPU and custom pools
// serialize by name.
build_execution_batches: fn(plan: HermeticBuildPlan, actions: [Int]) -> [[Int]] Never! {
    batches := [[Int]]{}
    limits := [String: Int]{}
    loop spec in plan.resource_pools() -> limits[spec.pool.as_str()] = spec.slots
    held := [[String: Int]]{}
    loop action_id in actions {
        pools := [String]{}
        loop pool in build_action_pools(plan.actions[action_id]) -> build_insert_sorted_text(pools, pool.as_str())
        slot := -1
        loop index in 0..<held.len() {
            used: held[index]
            fits := true
            loop pool in pools {
                limit: limits.get(pool) ?? 1
                if !(limit == 0 || (used.get(pool) ?? 0) < limit) -> fits = false
            }
            if fits {
                slot = index
                break
            }
        }
        if slot < 0 {
            batches.push([Int]{})
            held.push([String: Int]{})
            slot = batches.len() - 1
        }
        counts := held[slot]
        loop pool in pools -> counts[pool] = (counts.get(pool) ?? 0) + 1
        held[slot] = counts
        batch := batches[slot]
        batch.push(action_id)
        batches[slot] = batch
    }
    batches
}

build_io_action: fn(action: HermeticBuildAction, error: BuildIOError) -> BuildExecutionError Never! {
    BuildExecutionError.IO{action: action.name, detail: error.message}
}

build_native_sandbox_error: fn(action: HermeticBuildAction, error: NativeSandboxError) -> BuildExecutionError Never! {
    if error == {
        .Unsupported(reason) -> BuildExecutionError.SandboxUnavailable{reason}
        .IO(detail) -> BuildExecutionError.IO{action: action.name, detail}
        .TimedOut(limit_ms) -> BuildExecutionError.TimedOut{action: action.name, limit_ms}
    }
}

build_rebuild_status_reason: fn(status: ActionCacheStatus) -> CacheMissReason Never! {
    if status == {
        .Miss(reason) -> reason
        .Hit(_) -> CacheMissReason.NoLocalActionRecord
    }
}

// The environment an action child receives: only its declared variables,
// filtered to the allowlist when one is declared. Nothing ambient enters.
build_action_environment: fn(action: HermeticBuildAction) -> [String: String] Never! {
    env := [String: String]{}
    loop name in action.env.keys() {
        if action.env_allowlist.len() == 0 || action.env_allowlist.contains(name) -> env[name] = action.env[name]
    }
    env
}

// Network is shared only when the root grants Net and the action declares it.
build_action_shares_network: fn(grants: [BuildEffect], caps: [BuildEffect]) -> Bool Never! {
    grants.contains(BuildEffect.Net) && caps.contains(BuildEffect.Net)
}

// One action keyed, looked up and staged in its fresh private work tree,
// ready to run under the native sandbox.
BuildActionRun: struct {
    action: HermeticBuildAction
    key: String
    sandbox: String
    rebuild_status: ActionCacheStatus
    command: NativeSandboxCommand
    // The store the run is published to: set only for a reused action.
    reuse: BuildArtifactStoreHandle?
    // The CPU time, in ms on each of the host's cores, the action's process
    // tree may use; 0 where the host cannot read a tree's CPU time, and the
    // command's wall-clock timeout is the step's limit.
    cpu_limit_ms: Int
}

// The wall-clock guard on an action with a CPU limit is this many times the
// step's limit: a hang guard only, so a loaded host that slows a working
// action never reaches it.
BUILD_WALL_GUARD: 10

// How often a running action's process tree has its CPU time sampled, in ns.
BUILD_CPU_SAMPLE_NS: 100000000

// The CPU watch on one running action child: the run it is, when it samples
// next (ns on the batch's clock), its tree's CPU limit and the CPU time at
// the last sample (ns), whether the watch killed it, and whether it still
// runs.
BuildActionWatch: struct {
    run: Int
    due_ns: Int
    limit_ns: Int
    used_ns: Int
    stopped: Bool
    live: Bool
}

BuildActionStart: enum {
    // A cached record restored the action's outputs.
    Restored
    Ready(run: BuildActionRun)
}

// Where a step's made tool runs from: the read-only mount of its folder in
// the work tree, which itself is mounted only at the child's working folder.
BUILD_MADE_TOOL_MOUNT: "/jet/tool"

// Where the Linux sandbox binds an action's work tree, its working folder
// (foundation_linux_sandbox_argv without a separate output folder).
BUILD_WORK_MOUNT: "/work"

// Where a folder the action reads whole is bound: its path in the work tree.
build_folder_mount: fn(path: String) -> String Never! {
    if path == "." -> BUILD_WORK_MOUNT else -> "{BUILD_WORK_MOUNT}/{path}"
}

// The folder of a traced action's work tree (build_execute_actions `traces`)
// its jet processes write their traces in, one file per process: the
// `JET_TRACE_FILE` it is given names `%p.json` there, which each jet makes
// its own process id.
BUILD_STEP_TRACE_FOLDER: ".jet-trace"

// Rust `execute_one_action` on the local path, for many actions at once:
// each of `ids` (their prerequisites already done) is keyed and, with
// `artifact_store`, restored from a cached record, else staged in a fresh
// private work tree; the staged ones run together under the native sandbox,
// at most `jobs` at a time, and each publishes only its declared outputs. One
// slot per action, in `ids` order: one action's failure never stops the
// others. With `traces`, a host folder, each staged child also runs with
// `JET_TRACE_FILE` in its work tree's BUILD_STEP_TRACE_FOLDER (outside its
// key: a trace changes no output), and every trace file a process of it wrote
// there is moved to `traces` as `<action id>-<file>` once it exits, whether it
// succeeded or not.
build_execute_actions: fn(plan: HermeticBuildPlan, ids: [Int], project_root: String, artifact_store: BuildArtifactStoreHandle?, grants: [BuildEffect], probe_facts: [BuildProbeFact], jobs: Int, traces: String?) -[FS, Env, Exec, Time, Time.Wait, Rand]> [Result<ActionOutcome, BuildExecutionError>] Never! {
    results := [Result<ActionOutcome, BuildExecutionError>]{}
    runs := [BuildActionRun]{}
    slots := [Int]{}
    stamps := StampTable.load(project_root)
    loop action_id in ids {
        if build_start_action(plan, plan.actions[action_id], project_root, artifact_store, grants, probe_facts, stamps, traces) == {
            .Ok(start) -> if start == {
                .Restored -> results.push(Ok(ActionOutcome.RestoredFromCache))
                .Ready(run) -> {
                    slots.push(results.len())
                    results.push(Ok(ActionOutcome.RestoredFromCache))
                    runs.push(run)
                }
            }
            .Err(error) -> results.push(Err(error))
        }
    }
    stamps.save(project_root).drop("the stamp table only saves rehashing; a lost one costs speed, never a wrong key")
    if runs.len() == 0 -> return results
    outcomes := build_run_actions(runs, if jobs < 1 -> 1 else -> jobs)
    loop index in 0..<runs.len() {
        slot: slots[index]
        if traces == .Val(folder) -> build_keep_step_traces(runs[index], folder)
        if outcomes[index] == {
            .Ok(receipt) -> if build_finish_action(runs[index], receipt, project_root) == {
                .Ok(outcome) -> results[slot] = Ok(outcome)
                .Err(error) -> results[slot] = Err(error)
            }
            .Err(error) -> results[slot] = Err(error)
        }
    }
    results
}

// Moves each trace file the processes of a traced action wrote in its work
// tree (BUILD_STEP_TRACE_FOLDER) to `traces` as `<action id>-<file>`. A
// trace is only a record of the run: one that can't be moved is left out of
// the build's trace, and the build goes on.
build_keep_step_traces: fn(run: BuildActionRun, traces: String) Never! -[FS]> {
    folder: files.join(run.sandbox, BUILD_STEP_TRACE_FOLDER)
    entries: files.list_dir(folder) ?? return
    loop entry in entries {
        files.rename(files.join(folder, entry.name), files.join(traces, "{run.action.id}-{entry.name}")).drop("a step's trace that can't be kept is left out of the build's trace")
    }
}

// Runs the staged actions' children, at most `jobs` at once: one receipt or
// error per run, in order. Each child's process tree may use its CPU limit on
// each of the host's cores (core.sys.tree_cpu_time, sampled every 100 ms),
// which other load on the host does not raise, so a loaded host slows an
// action without failing it. A tree past its limit is stopped by killing the
// child: the Linux sandbox runs the tree in a pid namespace that dies with
// it. The command's wall-clock timeout is only the hang guard. With no CPU
// limit on any run (a host whose process tree's CPU time cannot be read),
// run_all runs them under their wall-clock limits.
build_run_actions: fn(runs: [BuildActionRun], jobs: Int) -[FS, Env, Exec, Time, Time.Wait]> [Result<ProcessReceipt, BuildExecutionError>] Never! {
    results := [Result<ProcessReceipt, BuildExecutionError>]{}
    if !runs.any(fn(run) { run.cpu_limit_ms > 0 }) {
        specs: loop run in runs -> run.command.spec
        if process.run_all(specs, jobs) == {
            .Ok(receipts) -> loop index in 0..<runs.len() {
                if receipts[index] == {
                    .Ok(receipt) -> results.push(Ok(receipt))
                    .Err(error) -> results.push(Err(build_abandon_action(runs[index], NativeSandboxError.IO("{error}"))))
                }
            }
            .Err(error) -> loop index in 0..<runs.len() -> results.push(Err(build_abandon_action(runs[index], NativeSandboxError.IO("{error}"))))
        }
        return results
    }
    cores: sys.cpu_count()
    finished := [Result<ProcessReceipt, BuildExecutionError>?]{}
    loop _ in 0..<runs.len() -> finished.push(None)
    children := [ProcessChild]{}
    watches := [BuildActionWatch]{}
    clock: time.instant()
    started := 0
    running := 0
    pause := 1
    loop started < runs.len() || running > 0 {
        loop started < runs.len() && running < jobs {
            if runs[started].command.spec.spawn() == {
                .Ok(child) -> {
                    children.push(child)
                    watches.push(BuildActionWatch{run: started, due_ns: clock.elapsed().ns, limit_ns: runs[started].cpu_limit_ms * 1000000 * cores, used_ns: 0, stopped: false, live: true})
                    running += 1
                }
                .Err(error) -> finished[started] = Val(Err(build_abandon_action(runs[started], NativeSandboxError.IO("{error}"))))
            }
            started += 1
        }
        loop at in 0..<children.len() {
            if !watches[at].live -> next
            run: watches[at].run
            if children[at].exited() ?? true {
                watches[at].live = false
                running -= 1
                finished[run] = Val(build_wait_action(runs[run], children[at], watches[at], cores))
                pause = 1
                next
            }
            now: clock.elapsed().ns
            if watches[at].stopped || watches[at].limit_ns <= 0 || now < watches[at].due_ns -> next
            watches[at].due_ns = now + BUILD_CPU_SAMPLE_NS
            used: sys.tree_cpu_time(children[at].id()) ?? next
            watches[at].used_ns = used.ns
            if used.ns > watches[at].limit_ns && children[at].kill() == .Ok(_) -> watches[at].stopped = true
        }
        if running > 0 {
            time.sleep(time.duration_ms(pause))
            if pause < 10 -> pause = if pause * 2 > 10 -> 10 else -> pause * 2
        }
    }
    loop outcome in finished -> results.push(outcome ?? panic("every staged action ends with a receipt or an error"))
    results
}

// The receipt of a child that exited, or, when its watch killed it past its
// CPU limit, the action's OverCPU failure with its work tree removed. The
// receipt counts the children the child waited for; the last sample also
// counts descendants that were live then.
build_wait_action: fn(run: BuildActionRun, child: ProcessChild, watch: BuildActionWatch, cores: Int) -[FS, Exec, Time.Wait]> ProcessReceipt BuildExecutionError! {
    receipt: child.wait() ?? return Err(build_abandon_action(run, NativeSandboxError.IO("{err}")))
    if !watch.stopped -> return Ok(receipt)
    files.remove_all(run.sandbox).drop("the action sandbox is removed best-effort; the CPU limit is reported")
    waited: (receipt.user_cpu_ns ?? 0) + (receipt.system_cpu_ns ?? 0)
    used: if watch.used_ns > waited -> watch.used_ns else -> waited
    // copy: the error names the action the run still owns.
    Err(BuildExecutionError.OverCPU{action: run.action.name.copy(), limit_ms: run.cpu_limit_ms, cores, used_ms: used /% 1000000})
}

// Snapshot the action's inputs and the files of the folders it reads whole
// (`stamps` their last digests; a found folder is the one its probe chose),
// key it and, with `artifact_store`, restore a cached record, else stage it
// in a fresh private work tree that receives exactly the input bytes the key
// hashed, runnable where the input is, with each folder bound read-only at
// its path and each found program it is passed named by the path it runs at
// there; with `traces` (build_execute_actions) it also gets its trace folder
// and `JET_TRACE_FILE`.
build_start_action: fn(plan: HermeticBuildPlan, declared: HermeticBuildAction, project_root: String, artifact_store: BuildArtifactStoreHandle?, grants: [BuildEffect], probe_facts: [BuildProbeFact], stamps: &StampTable, traces: String?) -[FS, Env, Exec, Time, Time.Wait, Rand]> BuildActionStart BuildExecutionError! {
    loop cap in declared.caps {
        if !grants.contains(cap) -> return Err(BuildExecutionError.MissingGrant{action: declared.name, capability: cap})
    }
    action: build_found_folders(plan, declared, probe_facts) ?? return Err(err)
    handle: HermeticActionHandle{id: action.id, context: plan.context}
    if plan.action(handle) == None -> return Err(BuildExecutionError.InvalidGraph(HermeticBuildError.UnknownAction(handle.id)))
    inputs: build_snapshot_declared_inputs(project_root, action) ?? return Err(build_io_action(action, err))
    snapshots := loop input in inputs -> input.snapshot
    snapshots.extend(build_snapshot_folders(stamps, project_root, action) ?? return Err(build_io_action(action, err)))
    // A tool another step makes is a declared input, run from the work
    // tree; any other tool is looked up through the action's toolchain.
    made_tool: action.inputs.contains(action.argv[0])
    executable := if made_tool -> files.join(project_root, action.argv[0]) else -> build_resolve_program_path(plan, action.toolchain, action.argv[0]) ?? return Err(BuildExecutionError.IO{action: action.name, detail: "tool {action.argv[0]} was not found"})
    executable_bytes: if files.is_file(executable) -> (files.read_bytes(executable) ?? return Err(build_io_action(action, BuildIOError.from(err)))) else -> action.argv[0].bytes()
    executable_digest: ContentDigest.from_bytes(executable_bytes)
    action_probe_names := [String]{}
    loop probe in action.probes -> action_probe_names.push(plan.probes[probe.id].name)
    effective_probe_facts := [BuildProbeFact]{}
    loop fact in probe_facts {
        if action_probe_names.contains(fact.name) -> effective_probe_facts.push(fact.copy())
    }
    programs: build_found_programs(plan, action, probe_facts) ?? return Err(err)
    program_digests := [ContentDigest]{}
    loop program in programs {
        bytes: files.read_bytes(program) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        program_digests.push(ContentDigest.from_bytes(bytes))
    }
    key: build_canonical_effective_action_key(plan, action, snapshots, grants, executable_digest, program_digests, effective_probe_facts)
    restore_failure := CacheMissReason?{None}
    // Only an action with no ambient effect is reused (build_effects_reusable),
    // and only from a given store.
    reuse: if action.reusable() -> artifact_store else -> None
    if reuse == .Val(store) {
        if build_read_action_record(store, key) == {
            .Val(record) -> {
                if record.failure_report == .Val(report) {
                    build_record_cache_event(action.name, key, ActionCacheStatus.Hit(.LocalActionRecordMatched), "terminal", Val(record.outcome))
                    return Err(BuildExecutionError.Reported{report})
                }
                if build_restore_action_outputs(store, project_root, action, record) == {
                    .Ok(edited) -> {
                        if edited == .Val(path) -> return Err(BuildExecutionError.HandEdited{action: action.name, path})
                        build_record_cache_event(action.name, key, ActionCacheStatus.Hit(.LocalActionRecordMatched), "restore", Val(ActionOutcome.RestoredFromCache))
                        return Ok(BuildActionStart.Restored)
                    }
                    .Err(error) -> restore_failure = Val(build_cache_restore_miss_reason(error))
                }
            }
            .None -> {}
            .Err(error) -> restore_failure = Val(build_cache_restore_miss_reason(error))
        }
    }
    rebuild_status := ActionCacheStatus.Miss(restore_failure ?? .NoLocalActionRecord)
    if reuse == None -> rebuild_status = ActionCacheStatus.Miss(.ReuseOff)
    if !action.reusable() -> rebuild_status = ActionCacheStatus.Miss(.AmbientEffect)
    build_record_cache_event(action.name, key, rebuild_status, "lookup", None)

    sandbox: files.join(files.join(project_root, ".jet/build-sandbox"), "{sys.pid()}-{action.id}-{key.removeprefix("act-sha256:")}")
    build_ensure_real_directory(files.dirname(sandbox)) ?? return Err(build_io_action(action, err))
    if files.stat(sandbox) == {
        .Ok(info) -> {
            if info.is_symlink || !info.is_dir -> return Err(build_io_action(action, BuildIOError.new(.PermissionDenied, "action sandbox is not a real directory")))
            files.remove_all(sandbox) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        }
        .Err(_) -> {}
    }
    build_ensure_real_directory(sandbox) ?? return Err(build_io_action(action, err))
    loop input in inputs {
        to: build_resolve_under(sandbox, input.snapshot.path) ?? return Err(build_io_action(action, err))
        parent: files.dirname(to)
        if parent != "" -> files.create_dir_all(parent) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        files.write_bytes(to, input.bytes) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        if input.snapshot.executable -> files.set_mode(to, 493) ?? return Err(build_io_action(action, BuildIOError.from(err)))
    }
    loop output in action.outputs {
        path: build_resolve_under(sandbox, output) ?? return Err(build_io_action(action, err))
        parent: files.dirname(path)
        if parent != "" -> files.create_dir_all(parent) ?? return Err(build_io_action(action, BuildIOError.from(err)))
    }

    runtime_args := build_runtime_toolchain_arguments(plan, action.toolchain, action.argv.slice(1, action.argv.len()))
    runtime_env := build_runtime_toolchain_environment(plan, action.toolchain, build_action_environment(action))
    if traces != None {
        files.create_dir_all(files.join(sandbox, BUILD_STEP_TRACE_FOLDER)) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        // The child's own path to its work tree: the Linux sandbox binds it
        // at BUILD_WORK_MOUNT; Seatbelt runs it where it is.
        work: if sys.is_linux() -> BUILD_WORK_MOUNT else -> sandbox
        runtime_env["JET_TRACE_FILE"] = "{work}/{BUILD_STEP_TRACE_FOLDER}/%p.json"
    }
    mounts := [NativeSandboxMount]{}
    if plan.toolchain(action.toolchain) == .Val(toolchain) {
        loop mount in toolchain.mounts -> mounts.push(NativeSandboxMount{source: mount.source, destination: mount.destination})
    }
    loop folder in action.folders {
        source: build_folder_source(project_root, folder) ?? return Err(build_io_action(action, err))
        if sys.is_linux() -> mounts.push(NativeSandboxMount{source, destination: build_folder_mount(folder.path)})
        else {
            // Seatbelt has no mount namespace: the work tree links the
            // folder's host path, which the profile lets the child read.
            link: build_resolve_under(sandbox, folder.path) ?? return Err(build_io_action(action, err))
            parent: files.dirname(link)
            if parent != "" -> files.create_dir_all(parent) ?? return Err(build_io_action(action, BuildIOError.from(err)))
            real: files.realpath(source) ?? return Err(build_io_action(action, BuildIOError.from(err)))
            files.symlink(real, link) ?? return Err(build_io_action(action, BuildIOError.from(err)))
            mounts.push(NativeSandboxMount{source: real, destination: real.copy()})
        }
    }
    if made_tool {
        executable = build_resolve_under(sandbox, action.argv[0]) ?? return Err(build_io_action(action, err))
        files.set_mode(executable, 493) ?? return Err(build_io_action(action, BuildIOError.from(err)))
        mounts.push(NativeSandboxMount{source: files.dirname(executable), destination: BUILD_MADE_TOOL_MOUNT})
    }
    loop index in 0..<programs.len() {
        passed: action.programs[index]
        runtime_args[passed.at - 1] = "{passed.flag}{foundation_sandbox_program_argument(programs[index], mounts)}"
    }
    share_network: build_action_shares_network(grants, action.caps)
    limit_ms: action.timeout_ms ?? NATIVE_SANDBOX_DEFAULT_ACTION_TIMEOUT_MS
    // Where the host can read a process tree's CPU time, the step's limit is
    // CPU time and the wall clock only a far-out hang guard; elsewhere the
    // limit stays wall-clock time.
    cpu_limit_ms: if sys.is_linux() -> limit_ms else -> 0
    timeout: time.duration_ms(if cpu_limit_ms > 0 -> limit_ms * BUILD_WALL_GUARD else -> limit_ms)
    command: foundation_native_sandbox_command(executable, runtime_args, sandbox, None, runtime_env, share_network, mounts, programs, Val(timeout)) ?? {
        files.remove_all(sandbox).drop("the action sandbox is removed best-effort; the sandbox error is reported")
        return Err(build_native_sandbox_error(action, err))
    }
    Ok(BuildActionStart.Ready{run: BuildActionRun{action, key, sandbox, rebuild_status, command, reuse, cpu_limit_ms}})
}

// `action` with each found folder bound from the folder its find_folder
// probe chose, which the probe's fact names.
build_found_folders: fn(plan: HermeticBuildPlan, action: HermeticBuildAction, probe_facts: [BuildProbeFact]) -> HermeticBuildAction BuildExecutionError! {
    resolved := action
    folders := [ActionFolder]{}
    loop folder in action.folders {
        probe: folder.found ?? {
            folders.push(folder.copy())
            next
        }
        name: plan.probes[probe.id].name
        chosen: loop fact in probe_facts {
            if fact.name == name && fact.success -> break fact.detail.copy()
        } ?? return Err(BuildExecutionError.IO{action: action.name, detail: "the folder `{folder.path}` is the one the probe `{name}` finds, and that probe did not run"})
        folders.push(ActionFolder{path: folder.path.copy(), source: Val(chosen), found: folder.found})
    }
    resolved.folders = folders
    Ok(resolved)
}

// The canonical host path of each found program `action` is passed, in
// argument order: the program its find_program probe found, which the
// probe's fact names.
build_found_programs: fn(plan: HermeticBuildPlan, action: HermeticBuildAction, probe_facts: [BuildProbeFact]) -[FS, Env]> [String] BuildExecutionError! {
    programs := [String]{}
    loop program in action.programs {
        name: plan.probes[program.probe.id].name
        found: loop fact in probe_facts {
            if fact.name == name && fact.success -> break fact.detail.copy()
        } ?? return Err(BuildExecutionError.IO{action: action.name, detail: "argument {program.at} is the program the probe `{name}` finds, and that probe found none"})
        programs.push(files.canonicalize(found) ?? return Err(build_io_action(action, BuildIOError.from(err))))
    }
    Ok(programs)
}

// A staged action whose child never ran to a receipt: its work tree goes.
build_abandon_action: fn(run: BuildActionRun, error: NativeSandboxError) -[FS]> BuildExecutionError Never! {
    files.remove_all(run.sandbox).drop("the action sandbox is removed best-effort; the sandbox error is reported")
    build_native_sandbox_error(run.action, error)
}

// Read the receipt of a staged action's child: record a failure as the
// action's cached terminal report, else publish its declared outputs (both
// to the run's store, when it has one).
build_finish_action: fn(run: BuildActionRun, receipt: ProcessReceipt, project_root: String) -[FS, Env, Exec, Time, Rand]> ActionOutcome BuildExecutionError! {
    action: run.action
    key: run.key
    sandbox: run.sandbox
    ran: foundation_native_sandbox_finish(run.command, receipt) ?? return Err(build_abandon_action(run, err))
    code: if ran.receipt.signal != None -> 1 else -> ran.receipt.code
    if !ran.receipt.success {
        files.remove_all(sandbox).drop("the action sandbox is removed best-effort; the action failure is reported")
        report: build_action_failure_report(action.name, code, ran.receipt.errors.trim())
        if run.reuse == .Val(store) {
            record: ActionResultRecord{key, outcome: ActionOutcome.Failed{exit_code: code}, outputs: [ActionOutputRecord]{}, failure_report: Val(report), status: ActionCacheStatus.Miss(build_rebuild_status_reason(run.rebuild_status))}
            build_write_action_record(store, key, record) ?? return Err(build_io_action(action, err))
            build_record_cache_event(action.name, key, run.rebuild_status, "terminal", Val(ActionOutcome.Failed{exit_code: code}))
        }
        return Err(BuildExecutionError.Reported{report})
    }
    edited: if build_publish_sandbox_outputs(sandbox, project_root, action) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(build_io_action(action, error)) }
    }
    if edited == .Val(path) {
        files.remove_all(sandbox).drop("the action sandbox is removed best-effort; the hand edit is reported")
        return Err(BuildExecutionError.HandEdited{action: action.name, path})
    }
    outcome: ActionOutcome.Succeeded{exit_code: code}
    if run.reuse == .Val(store) {
        record: build_capture_declared_outputs(store, project_root, action, key, outcome, ActionCacheStatus.Miss(.NoLocalActionRecord)) ?? return Err(build_io_action(action, err))
        build_write_action_record(store, key, record) ?? return Err(build_io_action(action, err))
        build_record_cache_event(action.name, key, ActionCacheStatus.Miss(.NoLocalActionRecord), "publish", Val(outcome))
    }
    files.remove_all(sandbox) ?? return Err(build_io_action(action, BuildIOError.from(err)))
    Ok(outcome)
}

// Rust `execute_one_action` output publication: every declared output is
// read from the work tree through the bounded no-follow reader (a FIFO or
// other special file is refused before any blocking open; the per-file and
// per-action limits are checked against the opened file's size before a byte
// is read). Only when all of them are read are they restored atomically
// under the project root, so a refused output publishes nothing; one the
// action left runnable by its owner is published runnable. A kept
// output that already holds its bytes is left as it is; when one holds bytes
// no build wrote (build_output_write), nothing is published and its path is
// returned.
build_publish_sandbox_outputs: fn(sandbox: String, project_root: String, action: HermeticBuildAction) -[FS, Rand]> String? BuildIOError! {
    contents := [[U8]]{}
    writes := [BuildOutputWrite]{}
    runnable := [Bool]{}
    total := 0
    loop declared in action.outputs {
        from: build_resolve_under(sandbox, declared)
        bytes: build_secure_read_file(sandbox, from, build_read_budget(total))
        total += bytes.len()
        runnable.push(build_owner_executable(from) ?? return Err(err))
        write := BuildOutputWrite.Write
        if build_kept_output(action, declared) == .Val(kept) -> write = build_output_write(project_root, kept, ContentDigest.from_bytes(bytes))
        if write == .HandEdited -> return Ok(Val(declared.copy()))
        writes.push(write)
        contents.push(bytes)
    }
    loop index in 0..<action.outputs.len() {
        if writes[index] == .Unchanged -> next
        to: build_resolve_under(project_root, action.outputs[index])
        build_prepare_output_destination(project_root, to)
        build_atomic_restore_file(project_root, to, contents[index], executable: runnable[index])
    }
    Ok(None)
}

// Rust `execute_probes`: each selected probe resolves through its toolchain
// and runs inside the sandbox; the first failure stops the build.
build_execute_probes: fn(plan: HermeticBuildPlan, selected: [Int]) -[FS, Env, Exec, Time.Wait, Rand]> [BuildProbeFact] BuildExecutionError! {
    facts := [BuildProbeFact]{}
    loop probe in plan.probes {
        if !selected.contains(probe.id) -> next
        result: if probe.kind == {
            .FindProgram(program) -> if build_resolve_program_path(plan, probe.toolchain, program) == {
                .Val(path) -> (success: true, detail: path)
                .None -> (success: false, detail: "program `{program}` not found")
            }
            .FindFolder(file) -> {
                search: foundation_find_folder(file, foundation_library_folders())
                found: search.found ?? return Err(BuildExecutionError.FolderNotFound{probe: probe.name, file, searched: loop miss in search.misses -> "{miss.folder}: {miss.reason}"})
                (success: true, detail: found.folder)
            }
            .PkgConfig(package, min_version) -> {
                pkg_config: build_resolve_program_path(plan, probe.toolchain, "pkg-config") ?? return Err(BuildExecutionError.ProbeFailed{probe: probe.name, detail: "pkg-config not found"})
                requirement: if min_version == {
                    .Val(version) -> "{package} >= {version}"
                    .None -> package
                }
                receipt: build_run_probe_sandboxed(pkg_config, [String]{"--exists", requirement}, None, time.duration_ms(NATIVE_SANDBOX_DEFAULT_ACTION_TIMEOUT_MS))
                (success: receipt.success, detail: "pkg-config exit {build_receipt_code(receipt)}")
            }
            .HeaderCheck(header) -> build_run_compile_probe(plan, probe.toolchain, "#include <{header}>\nint main(void) {{ return 0; }}\n")
            .CompileCheck(_, includes, code) -> {
                source := ""
                loop header in includes -> source = "{source}#include <{header}>\n"
                source = "{source}int main(void) {{\n{code}\nreturn 0;\n}}\n"
                build_run_compile_probe(plan, probe.toolchain, source)
            }
        }
        facts.push(BuildProbeFact{name: probe.name, success: result.success, detail: result.detail, reproducibility: probe.reproducibility, toolchain: probe.toolchain, toolchain_provenance: build_toolchain_provenance_digest(plan, probe.toolchain)})
        if !result.success -> return Err(BuildExecutionError.ProbeFailed{probe: probe.name, detail: result.detail})
    }
    Ok(facts)
}

// Whether a probe in `selected` runs a program, which it does only inside the
// native sandbox (build_run_probe_sandboxed); finding a program or a folder
// only reads the host.
build_probes_run_sandboxed: fn(plan: HermeticBuildPlan, selected: [Int]) -> Bool Never! {
    loop probe in plan.probes {
        if !selected.contains(probe.id) -> next
        runs: if probe.kind == {
            .FindProgram(_) | .FindFolder(_) -> false
            .PkgConfig(_, _) | .HeaderCheck(_) | .CompileCheck(_, _, _) -> true
        }
        if runs -> return true
    }
    false
}

build_receipt_code: fn(receipt: ProcessReceipt) -> Int Never! {
    if receipt.signal != None -> 1 else -> receipt.code
}

// Rust `run_probe_sandboxed`: a private temporary root, the optional probe
// source written into it, one sandboxed run with an empty environment and
// no network, then the root removed. Unlike Rust, the run has the same
// finite wall-clock budget as an action: a probe past `timeout` is killed and
// fails the build.
build_run_probe_sandboxed: fn(executable: String, args: [String], source: (path: String, contents: String)?, timeout: Duration) -[FS, Env, Exec, Time.Wait, Rand]> ProcessReceipt BuildExecutionError! {
    nonce: random.bytes(8) ?? return Err(BuildExecutionError.IO{action: "build probe sandbox", detail: "{err}"})
    root: files.join(sys.temp_dir(), "jet-build-probe-{sys.pid()}-{build_hex_encode(nonce)}")
    if files.create_dir_all(root) == .Err(error) {
        files.remove_all(root).drop("the probe root is removed best-effort; the create error is reported")
        return Err(BuildExecutionError.IO{action: "build probe sandbox", detail: "{error}"})
    }
    if source == .Val(probe_source) {
        if files.write(files.join(root, probe_source.path), probe_source.contents) == .Err(error) {
            files.remove_all(root).drop("the probe root is removed best-effort; the write error is reported")
            return Err(BuildExecutionError.IO{action: "build probe input", detail: "{error}"})
        }
    }
    if foundation_run_native_sandboxed_with_timeout_and_mounts(executable, args, root, None, [String: String]{}, false, [NativeSandboxMount]{}, Val(timeout)) == {
        .Ok(output) -> {
            files.remove_all(root).drop("the probe root is removed best-effort after the run")
            Ok(output.receipt)
        }
        .Err(error) -> {
            files.remove_all(root).drop("the probe root is removed best-effort after the run")
            Err(if error == {
                .Unsupported(reason) -> BuildExecutionError.SandboxUnavailable{reason}
                .IO(detail) -> BuildExecutionError.IO{action: "build probe sandbox", detail}
                .TimedOut(_) -> BuildExecutionError.IO{action: "build probe sandbox", detail: error.message()}
            })
        }
    }
}

// Rust `run_compile_probe`: the first declared `cc`, `clang` or `gcc` checks
// the probe source's syntax inside the sandbox.
build_run_compile_probe: fn(plan: HermeticBuildPlan, toolchain: ToolchainHandle, source: String) -[FS, Env, Exec, Time.Wait, Rand]> (success: Bool, detail: String) BuildExecutionError! {
    compiler := String?{None}
    names: [String]{"cc", "clang", "gcc"}
    loop name in names {
        if compiler == None -> compiler = build_resolve_program_path(plan, toolchain, name)
    }
    found: compiler ?? return Ok((success: false, detail: "no C compiler (`cc`, `clang`, or `gcc`) was found"))
    receipt: build_run_probe_sandboxed(found, [String]{"-x", "c", "-fsyntax-only", "probe.c"}, Val((path: "probe.c", contents: source)), time.duration_ms(NATIVE_SANDBOX_DEFAULT_ACTION_TIMEOUT_MS))
    if receipt.success -> return Ok((success: true, detail: "{found} accepted the syntax probe"))
    detail: receipt.errors.trim()
    Ok((success: false, detail: if detail == "" -> "{found} rejected the syntax probe" else -> "{found}: {detail}"))
}

// Rust `Path::components().count()`.
build_path_component_count: fn(path: String) -> Int Never! {
    count := if path.starts_with("/") -> 1 else -> 0
    parts: path.split("/").to_list()
    loop index in 0..<parts.len() {
        part: parts[index]
        if part == "" -> next
        if part == "." && !(index == 0 && !path.starts_with("/")) -> next
        count += 1
    }
    count
}

build_canonical_executable_path: fn(program: String) -[FS, Env]> String? Never! {
    if !files.is_file(program) -> return None
    resolved: files.canonicalize(program) ?? return None
    Val(resolved)
}

// Rust `find_program_path`: a path with several components directly, else
// the first regular file of that name in an absolute PATH directory,
// canonicalized. Unlike Rust, an empty or relative PATH entry is skipped,
// so the working directory never supplies a tool, and the result must be
// absolute.
build_find_program_path: fn(program: String) -[FS, Env]> String? Never! {
    if build_path_component_count(program) > 1 && files.is_file(program) {
        resolved: files.canonicalize(program) ?? return None
        return Val(resolved)
    }
    paths: sys.get("PATH") ?? return None
    loop directory in paths.split(":") {
        if !directory.starts_with("/") -> next
        candidate: files.join(directory, program)
        if files.is_file(candidate) {
            resolved: files.canonicalize(candidate) ?? return None
            return if resolved.starts_with("/") -> Val(resolved) else -> None
        }
    }
    None
}

// Rust `resolve_program_path`: the toolchain's declared tool (by name, then
// basename) through its mounts; a declared-only toolchain stops there. Only
// the host toolchain, or a target that is the running host, may fall back to
// an explicit path or PATH.
build_resolve_program_path: fn(plan: HermeticBuildPlan, toolchain_handle: ToolchainHandle, program: String) -[FS, Env]> String? Never! {
    toolchain: plan.toolchain(toolchain_handle) ?? return None
    if toolchain.tools.get(program) == .Val(declared) -> return build_canonical_tool_path(toolchain, declared)
    basename: files.basename(program)
    if basename != "" {
        if toolchain.tools.get(basename) == .Val(declared) -> return build_canonical_tool_path(toolchain, declared)
    }
    if toolchain.resolution == ToolchainResolution.DeclaredOnly -> return None
    if build_path_component_count(program) > 1 {
        if build_canonical_executable_path(program) == .Val(path) -> return Val(path)
    }
    if toolchain.role == ToolchainRole.Host -> return build_find_program_path(program)
    if build_target_matches_running_host(toolchain.target_triple) -> return build_find_program_path(program)
    None
}

// Rust `target_matches_running_host`.
build_target_matches_running_host: fn(triple: String) -[Env]> Bool Never! {
    arch: sys.arch()
    candidates: if {
        sys.is_linux() -> [String]{"{arch}-linux", "{arch}-linux-gnu", "{arch}-unknown-linux-gnu"}
        sys.is_macos() -> [String]{"{arch}-macos", "{arch}-apple-darwin"}
        sys.is_windows() -> [String]{"{arch}-windows", "{arch}-pc-windows-msvc", "{arch}-pc-windows-gnu"}
        else -> [String]{}
    }
    candidates.contains(triple)
}

// Rust `canonical_tool_path`: a declared tool under a mount destination maps
// to the mount source (a `..` component refuses it); otherwise the declared
// path itself. Matching and joining use path components, so `//` or `.`
// after a destination stays under its source.
build_canonical_tool_path: fn(toolchain: HermeticBuildToolchain, declared: String) -[FS, Env]> String? Never! {
    loop mount in toolchain.mounts {
        relative: build_strip_path_prefix(declared, mount.destination) ?? next
        if relative.contains("..") -> return None
        source := mount.source
        loop part in relative -> source = files.join(source, part)
        return build_canonical_executable_path(source)
    }
    build_canonical_executable_path(declared)
}

// Rust `Path::components` of a `/`-separated path: empty and `.` parts
// dropped, `..` kept for the caller to refuse.
build_path_parts: fn(path: String) -> [String] Never! {
    parts := [String]{}
    loop part in path.split("/") {
        if part == "" || part == "." -> next
        parts.push(part)
    }
    parts
}

// Rust `Path::strip_prefix` over whole components: the components of
// `path` after `prefix`, or None when `prefix`'s components do not lead
// `path` (an absolute and a relative path never match).
build_strip_path_prefix: fn(path: String, prefix: String) -> [String]? Never! {
    if path.starts_with("/") != prefix.starts_with("/") -> return None
    path_parts: build_path_parts(path)
    prefix_parts: build_path_parts(prefix)
    if prefix_parts.len() > path_parts.len() -> return None
    loop index in 0..<prefix_parts.len() {
        if path_parts[index] != prefix_parts[index] -> return None
    }
    Val(path_parts.slice(prefix_parts.len(), path_parts.len()))
}

// Rust `runtime_toolchain_arguments`: Linux keeps declared virtual paths
// (the sandbox projects the mounts); macOS and Windows translate only the
// declared mount paths at the adapter boundary.
build_runtime_toolchain_arguments: fn(plan: HermeticBuildPlan, handle: ToolchainHandle, args: [String]) -[Env]> [String] Never! {
    if sys.is_linux() -> return args.copy()
    toolchain: plan.toolchain(handle) ?? return args
    loop argument in args -> build_runtime_toolchain_argument(toolchain, argument)
}

build_runtime_toolchain_environment: fn(plan: HermeticBuildPlan, handle: ToolchainHandle, env: [String: String]) -[Env]> [String: String] Never! {
    if sys.is_linux() -> return env.copy()
    toolchain: plan.toolchain(handle) ?? return env
    out := [String: String]{}
    loop key in env.keys() -> out[key] = build_runtime_toolchain_argument(toolchain, env[key])
    out
}

build_runtime_toolchain_argument: fn(toolchain: HermeticBuildToolchain, argument: String) -> String Never! {
    if build_runtime_mount_path(toolchain, argument) == .Val(path) -> return path
    prefixes: [String]{"--sysroot=", "-isysroot=", "-I", "-L", "-include", "-isystem", "-iquote", "-idirafter", "-imacros"}
    loop prefix in prefixes {
        if !argument.starts_with(prefix) -> next
        if build_runtime_mount_path(toolchain, argument.removeprefix(prefix)) == .Val(path) -> return "{prefix}{path}"
    }
    argument.copy()
}

build_runtime_mount_path: fn(toolchain: HermeticBuildToolchain, value: String) -> String? Never! {
    loop mount in toolchain.mounts {
        destination := mount.destination
        loop destination.ends_with("/") || destination.ends_with("\\") -> destination = destination.slice(0, destination.len() - 1)
        if value == destination -> return Val(mount.source)
        if !value.starts_with(destination) -> next
        suffix: value.removeprefix(destination)
        if !suffix.starts_with("/") && !suffix.starts_with("\\") -> next
        relative: suffix.removeprefix(if suffix.starts_with("/") -> "/" else -> "\\")
        return Val(files.join(mount.source, relative))
    }
    None
}

// Rust `toolchain_provenance_digest`: SHA-256 of the toolchain's derived
// `Debug` text.
build_toolchain_provenance_digest: fn(plan: HermeticBuildPlan, handle: ToolchainHandle) -> ContentDigest Never! {
    identity: if plan.toolchain(handle) == {
        .Val(toolchain) -> build_debug_toolchain(toolchain)
        .None -> "missing-toolchain"
    }
    ContentDigest.from_bytes(identity.bytes())
}

// Rust derived `Debug` of `BuildToolchain` and the types inside it.
build_debug_toolchain: fn(t: HermeticBuildToolchain) -> String Never! {
    role: if t.role == ToolchainRole.Host -> "Host" else -> "Target"
    sdk: if t.sdk == {
        .Val(value) -> "Some(SdkIdentity {{ name: {build_debug_quote(value.name)}, version: {build_debug_quote(value.version)}, provenance: {build_debug_provenance(value.provenance)} }})"
        .None -> "None"
    }
    linker: if t.linker == {
        .Val(value) -> "Some(LinkerIdentity {{ name: {build_debug_quote(value.name)}, provenance: {build_debug_provenance(value.provenance)} }})"
        .None -> "None"
    }
    sysroot: if t.sysroot == {
        .Val(value) -> "Some(SysrootIdentity {{ name: {build_debug_quote(value.name)}, path_digest: {build_debug_quote(value.path_digest)}, provenance: {build_debug_provenance(value.provenance)} }})"
        .None -> "None"
    }
    tool_keys := t.tools.keys().to_list()
    tool_keys.sort()
    tools: loop key in tool_keys -> "{build_debug_quote(key)}: {build_debug_quote(t.tools[key])}"
    resolution: if t.resolution == ToolchainResolution.Ambient -> "Ambient" else -> "DeclaredOnly"
    mounts: loop mount in t.mounts -> "BuildMount {{ source: {build_debug_quote(mount.source)}, destination: {build_debug_quote(mount.destination)}, identity: {build_debug_quote(mount.identity)} }}"
    "BuildToolchain {{ id: ToolchainId({t.id}), name: {build_debug_quote(t.name)}, role: {role}, host_triple: {build_debug_quote(t.host_triple)}, target_triple: {build_debug_quote(t.target_triple)}, sdk: {sdk}, linker: {linker}, sysroot: {sysroot}, tools: {{{tools.join(", ")}}}, resolution: {resolution}, mounts: [{mounts.join(", ")}], provenance: {build_debug_provenance(t.provenance)} }}"
}

build_debug_provenance: fn(provenance: BuildProvenance) -> String Never! {
    source: if provenance.source == {
        .InferredHost -> "InferredHost"
        .JetpackDependency(dep) -> "JetpackDependency({build_debug_quote(dep)})"
        .AmbientRecord(record) -> "AmbientRecord({build_debug_quote(record)})"
        .UserDeclared(value) -> "UserDeclared({build_debug_quote(value)})"
    }
    lock: if provenance.lock == {
        .Val(record) -> "Some(LockRecord {{ key: {build_debug_quote(record.key)}, digest: {build_debug_quote(record.digest)} }})"
        .None -> "None"
    }
    "BuildProvenance {{ source: {source}, lock: {lock} }}"
}
