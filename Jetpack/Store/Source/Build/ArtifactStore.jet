// The machine-wide artifact store as the build executor's CAS.

use {
    jetpack_artifact_store.[ArtifactDigest, ArtifactStore, ArtifactStoreError]
}

BuildArtifactStoreHandle: struct {
    store: ArtifactStore

    // The store named by `JET_STORE_DIR` (else the default store root). Rust
    // reports the open refusal as its display string; `{err}` is that text.
    open: fn() -[FS, Env, Rand]> BuildArtifactStoreHandle ArtifactStoreError! {
        Ok(BuildArtifactStoreHandle{store: ArtifactStore.from_env()})
    }

    at: fn(root: String) -[FS, Env, Rand]> BuildArtifactStoreHandle ArtifactStoreError! {
        Ok(BuildArtifactStoreHandle{store: ArtifactStore.new(root)})
    }

    // An entry the executor writes is a cache entry: one lost to a crash
    // reads as a miss (Cache.jet), so it is written without disk syncs.
    put_blob: fn(self, bytes: [U8]) -[FS, Env, Exec, Time, Rand]> ContentDigest BuildIOError! {
        object: self.store.publish_blob_entry(bytes, durable: false) ?? return Err(build_store_io_error(err))
        ContentDigest.parse("sha256:{object.digest().to_hex()}") ?? return Err(BuildIOError.new(.InvalidData, err.message))
    }

    get_blob: fn(self, digest: ContentDigest) -[FS, Env, Exec, Time, Rand]> [U8]? BuildIOError! {
        if !digest.as_str().starts_with("sha256:") -> return Err(BuildIOError.new(.InvalidInput, "artifact digest has no sha256 prefix"))
        parsed: ArtifactDigest.from_hex(digest.as_str().removeprefix("sha256:")) ?? return Err(build_store_io_error(err))
        found: if self.store.blob_by_digest(parsed) == {
            .Val(bytes) -> Val(bytes)
            .None -> None
            .Err(error) -> { return Err(build_store_io_error(error)) }
        }
        Ok(found)
    }

    put_record: fn(self, key: String, bytes: [U8]) BuildIOError! -[FS, Env, Exec, Time, Rand]> {
        self.store.publish_action_entry(self.store.action(key), bytes, durable: false) ?? return Err(build_store_io_error(err))
    }

    get_record: fn(self, key: String) -[FS, Env, Exec, Time, Rand]> [U8]? BuildIOError! {
        found: if self.store.get_action(self.store.action(key)) == {
            .Val(bytes) -> Val(bytes)
            .None -> None
            .Err(error) -> { return Err(build_store_io_error(error)) }
        }
        Ok(found)
    }
}

// Rust `store_io_error`: every store refusal is an `Other` I/O error.
build_store_io_error: fn(error: ArtifactStoreError) -> BuildIOError Never! {
    BuildIOError.new(.Other, "{error}")
}
