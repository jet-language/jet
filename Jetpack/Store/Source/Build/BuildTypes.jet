// Build-graph value types shared by the build executor and the build-plugin
// host. (Jet uses Foundation `BuildEffect` directly.)
use crypto: core.crypto

// A content address: `sha256:` and 64 lowercase hex digits.
ContentDigest: struct {
    value: String,

    from_bytes: fn(bytes: [U8]) -> ContentDigest Never! {
        ContentDigest{value: "sha256:{crypto.sha256(bytes).hex()}"}
    }

    as_str: fn(self) -> String Never! { self.value }

    // The `sha256:` prefix and exactly 64 hex digits, normalized to lowercase.
    parse: fn(value: String) -> ContentDigest ContentDigestError! {
        if !value.starts_with("sha256:") {
            return Err(ContentDigestError{message: "digest must start with `sha256:`"})
        }
        hex: value.removeprefix("sha256:")
        raw: hex.bytes()
        valid := raw.len() == 64
        loop byte in raw {
            code: Int{byte}
            if !((code >= 48 && code <= 57) || (code >= 65 && code <= 70) || (code >= 97 && code <= 102)) {
                valid = false
            }
        }
        if !valid {
            return Err(ContentDigestError{message: "sha256 digest must contain exactly 64 hexadecimal digits"})
        }
        Ok(ContentDigest{value: "sha256:{hex.to_ascii_lower()}"})
    }
}

// The InvalidData message of a content digest that does not parse.
#Error
ContentDigestError: struct {
    message: String,
}
