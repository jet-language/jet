// The typed build-graph model behind `jet cc` / `jet c++`, ported 1:1 from
// crates/jet-comptime Build/{handles,targets,actions_policy,
// provenance_toolchains,errors_keys}.rs. Rust `BuildCapability` is
// Foundation `BuildEffect`.
//
// Jet reserves `Build`, `BuildPlan`, `BuildAction`, `BuildTarget`,
// `BuildToolchain`, `BuildProbe`, `BuildSigningIdentity` and `BuildError`
// for the `build: fn` surface (SEMA_RESERVED_TYPES), and the Jetpack unit
// already owns `ActionHandle` (the artifact store's action record handle).
// These executor types carry the `Hermetic` prefix the Rust sandbox tests
// alias them to (`Build as HermeticBuildContext`).
//
// Ported surface: the graph `jet cc` builds (toolchains, probes, signing
// identities, actions, targets, plans) and its executor. Not ported here:
// WebAssembly build plugins, generated modules, legacy-wrapper imports,
// computed fact contributions, compiler-owned package actions and the remote
// builder; they belong to the `build: fn` driver path, and the action key
// encodes each one in its empty form exactly as Rust does for a plan that has
// none.

use {
    jet_foundation.[foundation_debug_quoted]
    jetpack_foundation.[BuildEffect]
}

BUILD_MAX_ACTIONS: 100000

// A target within one context (Rust `TargetRef`; the typed `ExecutableTarget`
// family converts into it, so every `add_*` returns this reference).
TargetRef: struct {
    id: Int
    context: Int
}

HermeticActionHandle: struct {
    id: Int
    context: Int
}

ToolchainHandle: struct {
    id: Int
    context: Int
}

SigningIdentityHandle: struct {
    id: Int
    context: Int
}

ProbeHandle: struct {
    id: Int
    context: Int
}

TargetKind: enum {
    Executable
    Library
    Test
    AssetBundle
    Doc
    Install
    Package
    Publish

    // Rust derived `Debug`.
    debug_name: fn(self) -> String Never! {
        if self == {
            .Executable -> "Executable"
            .Library -> "Library"
            .Test -> "Test"
            .AssetBundle -> "AssetBundle"
            .Doc -> "Doc"
            .Install -> "Install"
            .Package -> "Package"
            .Publish -> "Publish"
        }
    }
}

// Rust `BuildPath::new`: non-blank, relative, with no `..`, root or prefix.
build_path_new: fn(path: String) -> String HermeticBuildError! {
    if path.trim() == "" -> return Err(HermeticBuildError.EmptyPath)
    if !build_path_is_relative_normal(path) -> return Err(HermeticBuildError.InvalidPath(path))
    Ok(path)
}

// Rust `Path` component rules for a declared build path: not absolute and no
// `..` component (`.` and empty components are dropped by `components()`).
build_path_is_relative_normal: fn(path: String) -> Bool Never! {
    if path.starts_with("/") -> return false
    loop part in path.split("/") {
        if part == ".." -> return false
    }
    true
}

TargetSpec: struct {
    sources: [String]
    inputs: [String]
    outputs: [String]
    deps: [TargetRef]
    actions: [HermeticActionHandle]
    probes: [ProbeHandle]
    toolchain: ToolchainHandle?
    signing_identity: SigningIdentityHandle?
    metadata: [String: String]

    new: fn() -> TargetSpec Never! {
        TargetSpec{
            sources: [String]{}, inputs: [String]{}, outputs: [String]{}, deps: [TargetRef]{},
            actions: [HermeticActionHandle]{}, probes: [ProbeHandle]{}, toolchain: None,
            signing_identity: None, metadata: [String: String]{},
        }
    }

    with_source: fn(self, path: String) -> TargetSpec Never! {
        updated := self
        updated.sources.push(path.copy())
        updated
    }

    with_input: fn(self, path: String) -> TargetSpec Never! {
        updated := self
        updated.inputs.push(path.copy())
        updated
    }

    with_output: fn(self, path: String) -> TargetSpec Never! {
        updated := self
        updated.outputs.push(path.copy())
        updated
    }

    with_dep: fn(self, target: TargetRef) -> TargetSpec Never! {
        updated := self
        updated.deps.push(target.copy())
        updated
    }

    with_action: fn(self, action: HermeticActionHandle) -> TargetSpec Never! {
        updated := self
        updated.actions.push(action.copy())
        updated
    }

    with_probe: fn(self, probe: ProbeHandle) -> TargetSpec Never! {
        updated := self
        updated.probes.push(probe.copy())
        updated
    }

    with_toolchain: fn(self, toolchain: ToolchainHandle) -> TargetSpec Never! {
        updated := self
        updated.toolchain = Val(toolchain)
        updated
    }

    with_signing_identity: fn(self, identity: SigningIdentityHandle) -> TargetSpec Never! {
        updated := self
        updated.signing_identity = Val(identity)
        updated
    }

    with_metadata: fn(self, key: String, value: String) -> TargetSpec Never! {
        updated := self
        updated.metadata[key] = value
        updated
    }
}

HermeticBuildTarget: struct {
    id: Int
    name: String
    kind: TargetKind
    sources: [String]
    inputs: [String]
    outputs: [String]
    deps: [TargetRef]
    actions: [HermeticActionHandle]
    probes: [ProbeHandle]
    toolchain: ToolchainHandle
    signing_identity: SigningIdentityHandle?
    metadata: [String: String]
}

BuildResourcePool: enum {
    CPU
    Memory
    Linker
    Console
    GPU
    Custom(String)

    as_str: fn(self) -> String Never! {
        if self == {
            .CPU -> "cpu"
            .Memory -> "memory"
            .Linker -> "linker"
            .Console -> "console"
            .GPU -> "gpu"
            .Custom(name) -> name
        }
    }

    // Rust derived `Ord`: variant order, then the custom name.
    rank: fn(self) -> Int Never! {
        if self == {
            .CPU -> 0
            .Memory -> 1
            .Linker -> 2
            .Console -> 3
            .GPU -> 4
            .Custom(_) -> 5
        }
    }
}

BuildResourcePoolSpec: struct {
    pool: BuildResourcePool
    slots: Int
}

// Distinct executable identities under one plan (E4-JP2 / #419).
ActionKind: enum {
    Compile
    Docs
    Debug
    SourceArchive
    Generic

    as_str: fn(self) -> String Never! {
        if self == {
            .Compile -> "compile"
            .Docs -> "docs"
            .Debug -> "debug"
            .SourceArchive -> "source-archive"
            .Generic -> "generic"
        }
    }

    // Exact source bytes remain identity inputs when these surfaces can
    // observe them.
    observes_exact_source: fn(self) -> Bool Never! {
        self != ActionKind.Generic
    }
}

// An output kept in git (`.output(path, kept: true)`): publishing rewrites it
// only when its bytes differ and refuses a hand edit of it. `written` is the
// digest of the bytes the last build left there, from that build's receipt;
// None before any build has.
KeptOutput: struct {
    path: String
    written: String?
}

// A folder an action reads whole (`.file(b.folder(path))`): bound read-only
// at `path` in its work tree, from `source`, a host folder (a dependency's),
// else from the folder the find_folder probe `found` chose, else from `path`
// under the project root. The action key hashes every file in it.
ActionFolder: struct {
    path: String
    source: String?
    found: ProbeHandle?
}

// A found program an action is passed (`.file(b.found(probe))`): argument
// `at` of its argv is `flag` followed by the path the find_program `probe`
// finds as the action starts, the path the program has inside the sandbox.
// The action key hashes the program's bytes.
ActionProgram: struct {
    at: Int
    flag: String
    probe: ProbeHandle
}

ActionSpec: struct {
    inputs: [String]
    outputs: [String]
    // The outputs that stay in git; no action key names them.
    kept: [KeptOutput]
    // The folders it reads whole.
    folders: [ActionFolder]
    // The found programs it is passed.
    programs: [ActionProgram]
    argv: [String]
    env: [String: String]
    // Only allowlisted env keys enter the action identity. Empty means the
    // declared `env` map itself is the allowlist. Kept sorted and unique
    // (Rust `BTreeSet`).
    env_allowlist: [String]
    // Sorted by canonical effect rank and unique (Rust `BTreeSet`). The
    // action is reused exactly when none of them is ambient
    // (build_effects_reusable).
    caps: [BuildEffect]
    kind: ActionKind
    toolchain: ToolchainHandle?
    probes: [ProbeHandle]
    signing_identity: SigningIdentityHandle?
    labels: [String: String]
    helper_versions: [String: String]
    // Sorted by rank, then custom name, and unique (Rust `BTreeSet`).
    resource_pools: [BuildResourcePool]
    variant_identity: String?
    // How long the action may run, in milliseconds; None takes the
    // sandbox's default.
    timeout_ms: Int?

    new: fn(argv: [String]) -> ActionSpec Never! {
        ActionSpec{
            inputs: [String]{}, outputs: [String]{}, kept: [KeptOutput]{}, folders: [ActionFolder]{}, programs: [ActionProgram]{}, argv: argv, env: [String: String]{},
            env_allowlist: [String]{}, caps: [BuildEffect]{},
            kind: ActionKind.Generic, toolchain: None, probes: [ProbeHandle]{}, signing_identity: None,
            labels: [String: String]{}, helper_versions: [String: String]{},
            resource_pools: [BuildResourcePool]{}, variant_identity: None, timeout_ms: None,
        }
    }

    with_inputs: fn(self, paths: [String]) -> ActionSpec Never! {
        updated := self
        loop path in paths -> updated.inputs.push(path.copy())
        updated
    }

    with_outputs: fn(self, paths: [String]) -> ActionSpec Never! {
        updated := self
        loop path in paths -> updated.outputs.push(path.copy())
        updated
    }

    // `path`, one of the outputs, kept in git; `written` as KeptOutput says.
    with_kept: fn(self, path: String, written: String?) -> ActionSpec Never! {
        updated := self
        updated.kept.push(KeptOutput{path: path.copy(), written: written.copy()})
        updated
    }

    // The folder at `path` in the work tree, read whole; `source` as
    // ActionFolder says.
    with_folder: fn(self, path: String, source: String?) -> ActionSpec Never! {
        updated := self
        updated.folders.push(ActionFolder{path: path.copy(), source: source.copy(), found: None})
        updated
    }

    // The folder the find_folder `probe` chooses when the build runs, read
    // whole at `path` in the work tree. The action must also use the probe
    // (with_probe), whose fact names the folder.
    with_found_folder: fn(self, path: String, probe: ProbeHandle) -> ActionSpec Never! {
        updated := self
        updated.folders.push(ActionFolder{path: path.copy(), source: None, found: Val(probe)})
        updated
    }

    // Argument `at`, `flag` followed by the path of the program the
    // find_program `probe` finds when the build runs. The action must also
    // use the probe (with_probe).
    with_found_program: fn(self, at: Int, flag: String, probe: ProbeHandle) -> ActionSpec Never! {
        updated := self
        updated.programs.push(ActionProgram{at, flag: flag.copy(), probe})
        updated
    }

    with_env: fn(self, key: String, value: String) -> ActionSpec Never! {
        updated := self
        updated.env[key] = value
        updated
    }

    with_env_allowlist: fn(self, keys: [String]) -> ActionSpec Never! {
        updated := self
        loop key in keys -> build_insert_sorted_text(updated.env_allowlist, key)
        updated
    }

    with_kind: fn(self, kind: ActionKind) -> ActionSpec Never! {
        updated := self
        updated.kind = kind
        updated
    }

    with_helper_version: fn(self, helper: String, version: String) -> ActionSpec Never! {
        updated := self
        updated.helper_versions[helper] = version
        updated
    }

    with_cap: fn(self, cap: BuildEffect) -> ActionSpec Never! {
        updated := self
        build_insert_effect(updated.caps, cap)
        updated
    }

    with_toolchain: fn(self, toolchain: ToolchainHandle) -> ActionSpec Never! {
        updated := self
        updated.toolchain = Val(toolchain)
        updated
    }

    with_probe: fn(self, probe: ProbeHandle) -> ActionSpec Never! {
        updated := self
        updated.probes.push(probe.copy())
        updated
    }

    with_signing_identity: fn(self, identity: SigningIdentityHandle) -> ActionSpec Never! {
        updated := self
        updated.signing_identity = Val(identity)
        updated
    }

    with_label: fn(self, key: String, value: String) -> ActionSpec Never! {
        updated := self
        updated.labels[key] = value
        updated
    }

    with_pool: fn(self, pool: BuildResourcePool) -> ActionSpec Never! {
        updated := self
        build_insert_pool(updated.resource_pools, pool)
        updated
    }

    with_variant_identity: fn(self, identity: String) -> ActionSpec Never! {
        updated := self
        updated.variant_identity = Val(identity)
        updated
    }

    with_timeout_ms: fn(self, limit: Int) -> ActionSpec Never! {
        updated := self
        updated.timeout_ms = Val(limit)
        updated
    }
}

HermeticBuildAction: struct {
    id: Int
    name: String
    inputs: [String]
    outputs: [String]
    kept: [KeptOutput]
    folders: [ActionFolder]
    programs: [ActionProgram]
    argv: [String]
    env: [String: String]
    env_allowlist: [String]
    caps: [BuildEffect]
    kind: ActionKind
    toolchain: ToolchainHandle
    probes: [ProbeHandle]
    signing_identity: SigningIdentityHandle?
    labels: [String: String]
    helper_versions: [String: String]
    resource_pools: [BuildResourcePool]
    variant_identity: String?
    timeout_ms: Int?

    reusable: fn(self) -> Bool Never! { build_effects_reusable(self.caps) }
}

// An action whose effects are all non-ambient (BuildEffect.ambient) has a
// result fixed by its key, so a stored record of it is reused; one with an
// ambient effect always runs. The native sandbox makes the non-ambient
// readings hold: no action runs outside it.
build_effects_reusable: fn(caps: [BuildEffect]) -> Bool Never! {
    loop cap in caps {
        if cap.ambient() -> return false
    }
    true
}

// Rust `BTreeSet<String>::insert`.
build_insert_sorted_text: fn(values: &[String], value: String) Never! {
    if values.contains(value) -> return
    values.push(value.copy())
    values.sort()
}

// Rust `BTreeSet<BuildCapability>::insert`.
build_insert_effect: fn(values: &[BuildEffect], ability: BuildEffect) Never! {
    if values.contains(ability) -> return
    values.push(ability.copy())
    values.sort_by(fn(written) { written.rank() })
}

// Rust `BTreeSet<BuildResourcePool>::insert`.
build_insert_pool: fn(values: &[BuildResourcePool], pool: BuildResourcePool) Never! {
    loop existing in values {
        if existing == pool -> return
    }
    values.push(pool.copy())
    values.sort_by(fn(left: BuildResourcePool, right: BuildResourcePool) { if left.rank() == right.rank() -> left.as_str() <=> right.as_str() else -> left.rank() <=> right.rank() })
}

LockRecord: struct {
    key: String
    digest: String

    new: fn(key: String, digest: String) -> LockRecord Never! {
        LockRecord{key, digest}
    }
}

ProvenanceSource: enum {
    InferredHost
    JetpackDependency(String)
    AmbientRecord(String)
    UserDeclared(String)
}

BuildProvenance: struct {
    source: ProvenanceSource
    lock: LockRecord?

    inferred_host: fn() -> BuildProvenance Never! {
        BuildProvenance{source: ProvenanceSource.InferredHost, lock: None}
    }

    jetpack_dependency: fn(dep: String, lock: LockRecord) -> BuildProvenance Never! {
        BuildProvenance{source: ProvenanceSource.JetpackDependency(dep), lock: Val(lock)}
    }

    ambient_record: fn(record: String) -> BuildProvenance Never! {
        BuildProvenance{source: ProvenanceSource.AmbientRecord(record), lock: None}
    }

    user_declared: fn(source: String, lock: LockRecord?) -> BuildProvenance Never! {
        BuildProvenance{source: ProvenanceSource.UserDeclared(source), lock}
    }
}

SDKIdentity: struct {
    name: String
    version: String
    provenance: BuildProvenance

    new: fn(name: String, version: String, provenance: BuildProvenance) -> SDKIdentity Never! {
        SDKIdentity{name, version, provenance}
    }
}

LinkerIdentity: struct {
    name: String
    provenance: BuildProvenance

    new: fn(name: String, provenance: BuildProvenance) -> LinkerIdentity Never! {
        LinkerIdentity{name, provenance}
    }
}

// Sysroot identity for cross compilation (E4-JP15).
SysrootIdentity: struct {
    name: String
    path_digest: String
    provenance: BuildProvenance

    new: fn(name: String, path_digest: String, provenance: BuildProvenance) -> SysrootIdentity Never! {
        SysrootIdentity{name, path_digest, provenance}
    }
}

SigningIdentitySpec: struct {
    label: String
    provenance: BuildProvenance

    new: fn(label: String, provenance: BuildProvenance) -> SigningIdentitySpec Never! {
        SigningIdentitySpec{label, provenance}
    }
}

HermeticBuildSigningIdentity: struct {
    id: Int
    name: String
    label: String
    provenance: BuildProvenance
}

ToolchainRole: enum {
    Host
    Target
}

// How an action resolves its executable. Declared-only is the hermetic path
// of provisioned toolchains: no executable may come from PATH or an
// undeclared filesystem spelling.
ToolchainResolution: enum {
    Ambient
    DeclaredOnly
}

// A read-only host directory made visible to a sandboxed action. `identity`
// empty means the source path itself is the identity.
BuildMount: struct {
    source: String
    destination: String
    identity: String
}

ToolchainSpec: struct {
    role: ToolchainRole
    host_triple: String
    target_triple: String
    sdk: SDKIdentity?
    linker: LinkerIdentity?
    sysroot: SysrootIdentity?
    tools: [String: String]
    resolution: ToolchainResolution
    mounts: [BuildMount]
    provenance: BuildProvenance

    target: fn(target_triple: String, provenance: BuildProvenance) -> ToolchainSpec Never! {
        ToolchainSpec{
            role: ToolchainRole.Target, host_triple: "host", target_triple: target_triple,
            sdk: None, linker: None, sysroot: None, tools: [String: String]{},
            resolution: ToolchainResolution.Ambient, mounts: [BuildMount]{}, provenance: provenance,
        }
    }

    host: fn(host_triple: String, provenance: BuildProvenance) -> ToolchainSpec Never! {
        ToolchainSpec{
            role: ToolchainRole.Host, host_triple: host_triple, target_triple: host_triple,
            sdk: None, linker: None, sysroot: None, tools: [String: String]{},
            resolution: ToolchainResolution.Ambient, mounts: [BuildMount]{}, provenance: provenance,
        }
    }

    with_host_triple: fn(self, host_triple: String) -> ToolchainSpec Never! {
        updated := self
        updated.host_triple = host_triple
        updated
    }

    with_sdk: fn(self, sdk: SDKIdentity) -> ToolchainSpec Never! {
        updated := self
        updated.sdk = Val(sdk)
        updated
    }

    with_linker: fn(self, linker: LinkerIdentity) -> ToolchainSpec Never! {
        updated := self
        updated.linker = Val(linker)
        updated
    }

    with_sysroot: fn(self, sysroot: SysrootIdentity) -> ToolchainSpec Never! {
        updated := self
        updated.sysroot = Val(sysroot)
        updated
    }

    with_tool: fn(self, name: String, path: String) -> ToolchainSpec Never! {
        updated := self
        updated.tools[name] = path
        updated
    }

    // Require every action executable to be named by this toolchain.
    declared_only: fn(self) -> ToolchainSpec Never! {
        updated := self
        updated.resolution = ToolchainResolution.DeclaredOnly
        updated
    }

    with_read_only_mount_identity: fn(self, source: String, destination: String, identity: String) -> ToolchainSpec Never! {
        updated := self
        updated.mounts.push(BuildMount{source, destination, identity})
        updated
    }
}

HermeticBuildToolchain: struct {
    id: Int
    name: String
    role: ToolchainRole
    host_triple: String
    target_triple: String
    sdk: SDKIdentity?
    linker: LinkerIdentity?
    sysroot: SysrootIdentity?
    tools: [String: String]
    resolution: ToolchainResolution
    mounts: [BuildMount]
    provenance: BuildProvenance
}

ReproducibilityClass: enum {
    Reproducible
    Ambient

    // Rust derived `Debug`.
    debug_name: fn(self) -> String Never! {
        if self == {
            .Reproducible -> "Reproducible"
            .Ambient -> "Ambient"
        }
    }
}

ProbeKind: enum {
    FindProgram(program: String)
    // A folder on the machine holding `file` (jetpack_foundation
    // foundation_find_folder).
    FindFolder(file: String)
    PkgConfig(package: String, min_version: String?)
    HeaderCheck(header: String)
    CompileCheck(name: String, includes: [String], code: String)
}

ProbeSpec: struct {
    kind: ProbeKind
    reproducibility: ReproducibilityClass
    provenance: BuildProvenance
    toolchain: ToolchainHandle?

    find_program: fn(program: String) -> ProbeSpec Never! {
        ProbeSpec{kind: ProbeKind.FindProgram{program}, reproducibility: ReproducibilityClass.Ambient, provenance: BuildProvenance.ambient_record("find_program"), toolchain: None}
    }

    find_folder: fn(file: String) -> ProbeSpec Never! {
        ProbeSpec{kind: ProbeKind.FindFolder{file}, reproducibility: ReproducibilityClass.Ambient, provenance: BuildProvenance.ambient_record("find_folder"), toolchain: None}
    }

    pkg_config: fn(package: String) -> ProbeSpec Never! {
        ProbeSpec{kind: ProbeKind.PkgConfig{package, min_version: None}, reproducibility: ReproducibilityClass.Ambient, provenance: BuildProvenance.ambient_record("pkg_config"), toolchain: None}
    }

    header_check: fn(header: String) -> ProbeSpec Never! {
        ProbeSpec{kind: ProbeKind.HeaderCheck{header}, reproducibility: ReproducibilityClass.Ambient, provenance: BuildProvenance.ambient_record("header_check"), toolchain: None}
    }

    compile_check: fn(name: String, includes: [String], code: String) -> ProbeSpec Never! {
        ProbeSpec{kind: ProbeKind.CompileCheck{name, includes, code}, reproducibility: ReproducibilityClass.Ambient, provenance: BuildProvenance.ambient_record("compile_check"), toolchain: None}
    }

    with_min_version: fn(self, version: String) -> ProbeSpec Never! {
        updated := self
        if self.kind == {
            .PkgConfig(package, _) -> updated.kind = ProbeKind.PkgConfig{package, min_version: Val(version)}
            .FindProgram(_) | .FindFolder(_) | .HeaderCheck(_) | .CompileCheck(_, _, _) -> {}
        }
        updated
    }

    with_toolchain: fn(self, toolchain: ToolchainHandle) -> ProbeSpec Never! {
        updated := self
        updated.toolchain = Val(toolchain)
        updated
    }

    with_reproducibility: fn(self, reproducibility: ReproducibilityClass) -> ProbeSpec Never! {
        updated := self
        updated.reproducibility = reproducibility
        updated
    }

    with_provenance: fn(self, provenance: BuildProvenance) -> ProbeSpec Never! {
        updated := self
        updated.provenance = provenance
        updated
    }
}

HermeticBuildProbe: struct {
    id: Int
    name: String
    kind: ProbeKind
    reproducibility: ReproducibilityClass
    provenance: BuildProvenance
    toolchain: ToolchainHandle
}

BuildNameKind: enum {
    Target
    Action
    Toolchain
    SigningIdentity
    Probe
}

// One dependency cycle in traversal order; the first name repeats last.
DependencyCycle: struct {
    nodes: [String]

    // The rendered loop: `` `a` -> `b` -> `a` ``. Rust `Debug` prints it too.
    chain: fn(self) -> String Never! {
        rendered: loop node in self.nodes -> "`{node}`"
        rendered.join(" -> ")
    }
}

// The graph refusals reachable from the ported surface, with their Rust
// variant names (`PackagedPlugin` carries the action-budget refusal).
#Error
HermeticBuildError: enum {
    EmptyTargetName
    EmptyActionName
    EmptyToolchainName
    EmptySigningIdentityName
    EmptyProbeName
    DuplicateTargetName(String)
    DuplicateActionName(String)
    DuplicateToolchainName(String)
    DuplicateSigningIdentityName(String)
    DuplicateProbeName(String)
    EmptyPath
    InvalidPath(String)
    EmptyToolchainTriple(String)
    EmptyIdentityField(String)
    MissingLockedProvenance(String)
    EmptyProbeField(String)
    EmptyActionArgv(String)
    EmptyEnvName(String)
    UndeclaredEnvName(action: String, key: String)
    // An action with no ambient effect, whose record would restore nothing.
    ReusableActionWithoutOutputs(String)
    DuplicateActionOutput(action: String, output: String)
    // A kept output the action doesn't declare as one of its outputs.
    UndeclaredKeptOutput(action: String, output: String)
    // An output inside a folder the action reads whole, whose read-only
    // mount would hide it.
    OutputInFolder(action: String, output: String, folder: String)
    DuplicateBuildOutput(output: String, first_action: String, second_action: String)
    UnknownTarget(Int)
    UnknownAction(Int)
    UnknownToolchain(Int)
    UnknownSigningIdentity(Int)
    UnknownProbe(Int)
    PackagedPlugin(String)
    TargetDependencyCycle(DependencyCycle)
    ActionDependencyCycle(DependencyCycle)

    // Rust derived `Debug` (`{error:?}`), the text graph reports print.
    debug_text: fn(self) -> String Never! {
        if self == {
            .EmptyTargetName -> "EmptyTargetName"
            .EmptyActionName -> "EmptyActionName"
            .EmptyToolchainName -> "EmptyToolchainName"
            .EmptySigningIdentityName -> "EmptySigningIdentityName"
            .EmptyProbeName -> "EmptyProbeName"
            .DuplicateTargetName(name) -> "DuplicateTargetName({build_debug_quote(name)})"
            .DuplicateActionName(name) -> "DuplicateActionName({build_debug_quote(name)})"
            .DuplicateToolchainName(name) -> "DuplicateToolchainName({build_debug_quote(name)})"
            .DuplicateSigningIdentityName(name) -> "DuplicateSigningIdentityName({build_debug_quote(name)})"
            .DuplicateProbeName(name) -> "DuplicateProbeName({build_debug_quote(name)})"
            .EmptyPath -> "EmptyPath"
            .InvalidPath(path) -> "InvalidPath({build_debug_quote(path)})"
            .EmptyToolchainTriple(name) -> "EmptyToolchainTriple({build_debug_quote(name)})"
            .EmptyIdentityField(name) -> "EmptyIdentityField({build_debug_quote(name)})"
            .MissingLockedProvenance(name) -> "MissingLockedProvenance({build_debug_quote(name)})"
            .EmptyProbeField(name) -> "EmptyProbeField({build_debug_quote(name)})"
            .EmptyActionArgv(name) -> "EmptyActionArgv({build_debug_quote(name)})"
            .EmptyEnvName(name) -> "EmptyEnvName({build_debug_quote(name)})"
            .UndeclaredEnvName(action, key) -> "UndeclaredEnvName {{ action: {build_debug_quote(action)}, key: {build_debug_quote(key)} }}"
            .ReusableActionWithoutOutputs(name) -> "ReusableActionWithoutOutputs({build_debug_quote(name)})"
            .DuplicateActionOutput(action, output) -> "DuplicateActionOutput {{ action: {build_debug_quote(action)}, output: {build_debug_quote(output)} }}"
            .UndeclaredKeptOutput(action, output) -> "UndeclaredKeptOutput {{ action: {build_debug_quote(action)}, output: {build_debug_quote(output)} }}"
            .OutputInFolder(action, output, folder) -> "OutputInFolder {{ action: {build_debug_quote(action)}, output: {build_debug_quote(output)}, folder: {build_debug_quote(folder)} }}"
            .DuplicateBuildOutput(output, first_action, second_action) -> "DuplicateBuildOutput {{ output: {build_debug_quote(output)}, first_action: {build_debug_quote(first_action)}, second_action: {build_debug_quote(second_action)} }}"
            .UnknownTarget(id) -> "UnknownTarget(TargetId({id}))"
            .UnknownAction(id) -> "UnknownAction(ActionId({id}))"
            .UnknownToolchain(id) -> "UnknownToolchain(ToolchainId({id}))"
            .UnknownSigningIdentity(id) -> "UnknownSigningIdentity(SigningIdentityId({id}))"
            .UnknownProbe(id) -> "UnknownProbe(ProbeId({id}))"
            .PackagedPlugin(detail) -> "PackagedPlugin({build_debug_quote(detail)})"
            .TargetDependencyCycle(cycle) -> "TargetDependencyCycle({cycle.chain()})"
            .ActionDependencyCycle(cycle) -> "ActionDependencyCycle({cycle.chain()})"
        }
    }
}

// Rust `{:?}` of a `String`.
build_debug_quote: fn(text: String) -> String Never! {
    foundation_debug_quoted(text, 34)
}

// Rust `dependency_cycle_text`: the whole loop, why it cannot build, the fix.
build_dependency_cycle_text: fn(kind: String, cycle: DependencyCycle) -> String Never! {
    "{kind} dependency graph contains a cycle: {cycle.chain()}; a cycle has no build order, so no {kind} in it can ever start; remove one dependency from that chain"
}
