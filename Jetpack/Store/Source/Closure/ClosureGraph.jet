// The closure graph of Hangar objects and canonical action records (Rust
// `jetpack::Store::Closure`): universe isolation, reference queries, the
// canonical action key, legacy migration, and the one registration boundary
// that appends a durable closure transaction.

STORE_RECEIPTS_DIR :: prep { "receipts" }

// Closure members already proven against their seals in this process, as
// `hangar\tdigest\n` lines. A 28-package env shares one toolchain closure;
// without this each package re-stat-walks every shared member. Entry-level
// verification never consults this memo, so the sealed drift law for package
// outputs is unchanged; member drift is caught by the next command (the
// trust window D-JPK-VERIFYONCE1=A ratified for stat-identical content).
store_proven_members := ""

pub struct ClosureObject {
    pub digest: String
    pub path: String
    pub external: Bool
}

pub struct ClosureRecord {
    pub id: String
    pub primary: String
    pub action_key: String
    pub outputs: [String: String]
    // Sorted and unique (Rust `BTreeSet`).
    pub references: [String]
    // Canonical versioned producer replay record.
    pub producer_record: String
    // Exact package metadata projection recoverable from committed WAL.
    pub package_meta: String
}

pub struct CanonicalActionRecord {
    pub outputs: [String: String]
    pub references: [String]
}

pub struct CleanReport {
    pub removed_objects: Int
    pub removed_bytes: Int
    pub quarantined_objects: Int
    pub removed_receipts: Int
    pub removed_receipt_bytes: Int
    pub swept_tmp: Int
    pub swept_tmp_bytes: Int
    pub optimized_files: Int
    pub optimized_bytes: Int

    fn empty() -> CleanReport Never! {
        CleanReport{removed_objects: 0, removed_bytes: 0, quarantined_objects: 0, removed_receipts: 0, removed_receipt_bytes: 0, swept_tmp: 0, swept_tmp_bytes: 0, optimized_files: 0, optimized_bytes: 0}
    }

    fn is_empty(self) -> Bool Never! {
        self.removed_objects == 0 && self.removed_bytes == 0 && self.quarantined_objects == 0 && self.removed_receipts == 0 && self.removed_receipt_bytes == 0 && self.swept_tmp == 0 && self.swept_tmp_bytes == 0 && self.optimized_files == 0 && self.optimized_bytes == 0
    }
}

// How a registration proves its outputs: native ingest shares payloads with
// the machine CAS; admitted Nix objects stay root-local.
pub enum RegistrationMode {
    Native
    AdmittedNix
}

pub struct ClosureGraph {
    pub objects: [String: ClosureObject]
    pub records: [String: ClosureRecord]
    // Sorted and unique (Rust `BTreeSet`).
    pub deleted_records: [String]

    fn empty() -> ClosureGraph Never! {
        ClosureGraph{objects: [String: ClosureObject]{}, records: [String: ClosureRecord]{}, deleted_records: [String]{}}
    }

    // Records in Rust `BTreeMap` order.
    fn sorted_records(self) -> [ClosureRecord] Never! {
        ids := self.records.keys().to_list()
        &ids.sort()
        out := [ClosureRecord]{}
        loop id in ids -> &out.push(self.records[id])
        out
    }

    fn direct_references(self, digest: String) -> [String] Never! {
        self.reference_index().get(digest) ?? [String]{}
    }

    fn transitive_references(self, digest: String) -> [String] Never! {
        store_closure_walk(self.reference_index(), digest)
    }

    fn closure(self, digest: String) -> [String] Never! {
        members := self.transitive_references(digest)
        &members.push(digest)
        store_sorted_unique(members)
    }

    fn referrers(self, digest: String) -> [String] Never! {
        self.referrer_index().get(digest) ?? [String]{}
    }

    fn transitive_referrers(self, digest: String) -> [String] Never! {
        store_closure_walk(self.referrer_index(), digest)
    }

    fn reverse_closure(self, digest: String) -> [String] Never! {
        members := self.transitive_referrers(digest)
        &members.push(digest)
        store_sorted_unique(members)
    }

    fn action_outputs(self, action_key: String) -> [String: String] Never! {
        out := [String: String]{}
        loop record in self.sorted_records() {
            if record.action_key != action_key -> next
            projection :: store_canonical_action_projection(record) ?? next
            loop output in projection.outputs -> out[output.key] = output.value
        }
        out
    }

    fn actions_for_output(self, digest: String) -> [String] Never! {
        actions := [String]{}
        loop record in self.sorted_records() {
            if store_record_outputs_contain(record, digest) -> &actions.push(record.action_key)
        }
        store_sorted_unique(actions)
    }

    // Output digest -> sorted unique referenced digests.
    fn reference_index(self) -> [String: [String]] Never! {
        index := [String: [String]]{}
        loop record in self.sorted_records() {
            loop output in record.outputs {
                current := index.get(output.value) ?? [String]{}
                loop reference in record.references -> &current.push(reference)
                index[output.value] = store_sorted_unique(current)
            }
        }
        index
    }

    // Referenced digest -> sorted unique referring output digests.
    fn referrer_index(self) -> [String: [String]] Never! {
        index := [String: [String]]{}
        loop record in self.sorted_records() {
            loop reference in record.references {
                current := index.get(reference) ?? [String]{}
                loop output in record.outputs -> &current.push(output.value)
                index[reference] = store_sorted_unique(current)
            }
        }
        index
    }
}

// Every digest reachable from `start` through `index`, excluding `start`,
// sorted (Rust depth-first walk into a `BTreeSet`).
fn store_closure_walk(index: [String: [String]], start: String) -> [String] Never! {
    seen := [String: Bool]{}
    pending := index.get(start) ?? [String]{}
    loop pending.len() > 0 {
        next_digest :: pending[pending.len() - 1]
        pending = pending[0..<(pending.len() - 1)]
        if next_digest == start || seen.has_key(next_digest) -> next
        seen[next_digest] = true
        referenced :: index.get(next_digest) ?? [String]{}
        loop reference in referenced {
            &pending.push(reference)
        }
    }
    found := seen.keys().to_list()
    &found.sort()
    found
}

fn store_record_outputs_contain(record: ClosureRecord, digest: String) -> Bool Never! {
    loop output in record.outputs {
        if output.value == digest -> return true
    }
    false
}

// Validate that a provider's closure edges stay inside its artifact
// universe. `nix` is the compatibility universe; every other provider is
// native. The path check catches a native edge to an external compatibility
// object, while the owner check catches a compat-root object that happens to
// live under Hangar.
pub fn store_validate_universe_references(provider: String, references: [String], graph: ClosureGraph) StoreError! {
    provider_is_compat :: provider == "nix"
    loop digest in references {
        // The graph validator reports missing objects. This helper stays
        // focused on the universe boundary for pre-registration checks, where
        // the candidate has not entered the graph yet.
        object :: graph.objects.get(digest) ?? next
        if !provider_is_compat && object.external {
            return Err(StoreError.Other("native provider `{provider}` crosses the ABI universe via external compatibility object `{digest}` at `{object.path}`"))
        }
        loop owner in graph.sorted_records() {
            if !store_record_outputs_contain(owner, digest) -> next
            owner_provider :: if ProducerRecord.decode(owner.producer_record) == {
                .Ok(producer) -> producer.provider
                .Err(error) -> {
                    if owner.producer_record == "" -> next
                    return Err(StoreError.Other("closure record `{owner.id}` has invalid producer record: {error.message()}"))
                }
            }
            if (owner_provider == "nix") != provider_is_compat {
                return Err(StoreError.Other("provider `{provider}` crosses the ABI universe at object `{digest}` owned by `{owner_provider}`"))
            }
        }
    }
}

pub fn store_validate_universe_isolation(graph: ClosureGraph, allow_legacy: Bool) StoreError! {
    loop record in graph.sorted_records() {
        if allow_legacy && record.producer_record == "" -> next
        producer :: ProducerRecord.decode(record.producer_record) ?? return Err(StoreError.Other("closure record `{record.id}` has invalid producer record: {err.message()}"))
        store_validate_universe_references(producer.provider, record.references, graph)
    }
}

pub fn store_closure_graph(verification: &StoreVerification, roots: HangarRoots) -> ClosureGraph StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    migrated :: store_migrate_closure_graph_unlocked(&verification, roots)
    store_validate_graph_store_proofs(&verification, roots, migrated.graph, false)
    Ok(migrated.graph)
}

pub fn store_closure_graph_structure(verification: &StoreVerification, roots: HangarRoots) -> ClosureGraph StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    store_closure_graph_structure_unlocked(&verification, roots)
}

// The migration + graph read is a pure function of committed journal state.
// Rust memoized it per process on the WAL state stamp; every call here reads
// the committed state, which the stamp would have proven equal.
pub fn store_closure_graph_structure_unlocked(verification: &StoreVerification, roots: HangarRoots) -> ClosureGraph StoreError! {
    migrated :: store_migrate_closure_graph_unlocked(&verification, roots)
    Ok(migrated.graph)
}

pub fn store_lifecycle_closure_graph_unlocked(verification: &StoreVerification, roots: HangarRoots) -> ClosureGraph StoreError! {
    migrated :: store_migrate_closure_graph_unlocked(&verification, roots)
    store_validate_graph_store_proofs(&verification, roots, migrated.graph, false)
    Ok(migrated.graph)
}

// GC plan variant: skip package projections already identified as
// malformed. The plan must inspect valid legacy records without letting one
// bad projection block the whole store, but it must not repair the bad
// projection before the plan can name it for quarantine.
pub fn store_lifecycle_closure_graph_unlocked_ignoring(verification: &StoreVerification, roots: HangarRoots, ignored: [String]) -> ClosureGraph StoreError! {
    migrated :: store_migrate_closure_graph_unlocked_ignoring(&verification, roots, ignored)
    store_validate_graph_store_proofs(&verification, roots, migrated.graph, false)
    Ok(migrated.graph)
}

// Verify the original WAL-bound record independently of missing object
// bytes. This witness permits authenticated repair, never incomplete
// consumption.
pub fn store_entry_record_store_proof(graph: ClosureGraph, entry: StoreEntry) -> Bool Never! {
    record :: graph.records.get(entry.id) ?? return false
    outputs := ~entry.named_outputs
    outputs["out"] = entry.envelope.output_hash
    record.primary == entry.envelope.output_hash && record.producer_record == entry.producer_record && record.action_key == store_entry_action_key(entry) && record.outputs == outputs && record.references == store_sorted_unique(entry.references)
}

// Object-byte leg only; the caller must also require
// `store_entry_record_store_proof`.
pub fn store_entry_closure_objects_rehash(verification: &StoreVerification, roots: HangarRoots, graph: ClosureGraph, entry: StoreEntry) -> Bool Never! {
    loop digest in graph.transitive_references(entry.envelope.output_hash) {
        if !store_closure_object_rehashes(&verification, roots, graph, digest) -> return false
    }
    true
}

pub fn store_invalidate_proven_member(hangar: String, digest: String) Never! {
    line :: "{hangar}\t{digest}"
    kept := ""
    loop existing in store_text_lines(store_proven_members) {
        if existing == line -> next
        kept = "{kept}{existing}\n"
    }
    store_proven_members = kept
}

fn store_closure_object_rehashes(verification: &StoreVerification, roots: HangarRoots, graph: ClosureGraph, digest: String) -> Bool Never! {
    line :: "{roots.hangar_dir()}\t{digest}"
    if store_text_lines(store_proven_members).contains(line) -> return true
    ok :: store_closure_object_rehashes_uncached(&verification, roots, graph, digest)
    if ok -> store_proven_members = "{store_proven_members}{line}\n"
    ok
}

fn store_closure_object_rehashes_uncached(verification: &StoreVerification, roots: HangarRoots, graph: ClosureGraph, digest: String) -> Bool Never! {
    object :: graph.objects.get(digest) ?? return false
    hangar :: roots.hangar_dir()
    found_owner := false
    loop record in graph.sorted_records() {
        if !store_record_outputs_contain(record, digest) -> next
        found_owner = true
        meta :: pkg_parse_meta(record.package_meta) ?? return false
        // Hash the owned object itself, not the owner's primary output: a
        // multi-output record owns members whose digests are not its
        // primary hash.
        owner_entry :: store_entry_from_meta(record.id, meta)
        actual :: store_verified_output_hash_persistent(&verification, object.path, Val(hangar), owner_entry.platform_artifact_kind != "") ?? return false
        if actual != digest -> return false
    }
    if found_owner -> return true
    // Every admitted object (directory, regular-file, or symlink root) is
    // named by its canonical output hash and sealed at admission.
    actual :: store_verified_output_hash_persistent(&verification, object.path, Val(hangar), false) ?? return false
    actual == digest
}

pub fn store_direct_references_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).direct_references(digest))
}

pub fn store_transitive_references_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).transitive_references(digest))
}

pub fn store_closure_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).closure(digest))
}

pub fn store_referrers_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).referrers(digest))
}

pub fn store_transitive_referrers_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).transitive_referrers(digest))
}

pub fn store_reverse_closure_of(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).reverse_closure(digest))
}

pub fn store_action_outputs_of(verification: &StoreVerification, roots: HangarRoots, action_key: String) -> [String: String] StoreError! {
    Ok(store_closure_graph(&verification, roots).action_outputs(action_key))
}

pub fn store_actions_for_output(verification: &StoreVerification, roots: HangarRoots, digest: String) -> [String] StoreError! {
    Ok(store_closure_graph(&verification, roots).actions_for_output(digest))
}

// The canonical action key of a package record.
pub fn store_entry_action_key(entry: StoreEntry) -> String Never! {
    identity :: entry.cache_identity
    decoded :: ProducerRecord.decode(entry.producer_record)
    canonical := "jet.action-store.v5".bytes()
    &canonical.push(U8{0})
    if decoded == {
        .Ok(producer) -> {
            nix :: producer.provider == "nix"
            // A Nix derivation path is the canonical input/action identity.
            // Output paths and output-derived cache fingerprints are
            // consequences; using them here would let the same action
            // silently map to different bytes.
            if {
                nix -> store_action_key_nix_frames(&canonical, producer, identity)
                else -> store_action_key_identity_frames(&canonical, entry)
            }
            store_push_frame(&canonical, producer.provider.bytes())
            store_push_frame(&canonical, producer.toolchain_facts.bytes())
            store_push_frame(&canonical, producer.policy_facts.bytes())
            plan_facts :: producer.plan.facts()
            loop key in store_sorted_keys(plan_facts) {
                if !store_action_replay_fact(key) || (nix && key == "nix.reference") -> next
                store_push_frame(&canonical, key.bytes())
                store_push_frame(&canonical, plan_facts[key].bytes())
            }
        }
        .Err(_) -> {
            store_action_key_identity_frames(&canonical, entry)
            // Validation rejects malformed producer records. Keep the key
            // stable until that fail-closed boundary instead of panicking.
            store_push_frame(&canonical, "invalid-producer-record".bytes())
        }
    }
    references :: store_sorted_unique(entry.references)
    store_push_u64_be(&canonical, references.len())
    loop digest in references -> store_push_frame(&canonical, digest.bytes())
    "sha256-{store_sha256_hex(canonical)}"
}

fn store_action_key_nix_frames(canonical: &[U8], producer: ProducerRecord, identity: CacheIdentity) Never! {
    store_push_frame(&canonical, producer.immutable_source.bytes())
    store_push_frame(&canonical, identity.recipe_fingerprint.bytes())
    store_push_frame(&canonical, identity.policy_fingerprint.bytes())
    store_push_frame(&canonical, identity.platform.bytes())
}

fn store_action_key_identity_frames(canonical: &[U8], entry: StoreEntry) Never! {
    identity :: entry.cache_identity
    store_push_frame(&canonical, entry.reference.bytes())
    store_push_frame(&canonical, identity.source_fingerprint.bytes())
    store_push_frame(&canonical, identity.recipe_fingerprint.bytes())
    store_push_frame(&canonical, identity.policy_fingerprint.bytes())
    store_push_frame(&canonical, identity.platform.bytes())
}

fn store_action_replay_fact(key: String) -> Bool Never! {
    !key.starts_with("nix.output.") && !key.starts_with("output.") && key != "cache.reproducibility"
}

pub fn store_migrate_closure_graph(verification: &StoreVerification, roots: HangarRoots) -> Int StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    migrated :: store_migrate_closure_graph_unlocked(&verification, roots)
    Ok(migrated.migrated)
}

// One `(name, size, mtime, kind)` stat tuple of the WAL identity table.
fn store_push_stat(table: &[U8], name: String, metadata: Stat) Never! {
    raw :: name.bytes()
    store_push_u64_le(&table, raw.len())
    store_push_bytes(&table, raw)
    store_push_u64_le(&table, metadata.size)
    store_push_i128_le(&table, metadata.modified.unix_ns)
    kind :: if {
        metadata.is_symlink -> "symlink"
        metadata.is_dir -> "directory"
        metadata.is_file -> "file"
        else -> "other"
    }
    store_push_u64_le(&table, kind.bytes().len())
    store_push_bytes(&table, kind.bytes())
}

fn store_push_dir_stats(table: &[U8], dir: String) StoreError! {
    directory :: if files.stat(dir) == {
        .Ok(metadata) -> metadata
        .Err(error) -> {
            if !StoreError.IO(error).is_not_found() -> return Err(StoreError.IO(error))
            store_push_bytes(&table, "directory-missing".bytes())
            &table.push(U8{0})
            return
        }
    }
    store_push_bytes(&table, "directory-present".bytes())
    &table.push(U8{0})
    if !directory.is_dir {
        store_push_stat(&table, dir, directory)
        return
    }
    entries := files.list_dir(dir)
    &entries.sort_by(entry -> entry.name)
    loop entry in entries -> store_push_stat(&table, entry.name, files.stat(entry.path))
}

// The complete on-disk WAL identity: every journal, receipt, seal and object
// stat tuple plus the entry-name set. A mutation from this process or any
// concurrent jetpack instance changes the stamp.
pub fn store_wal_state_stamp(roots: HangarRoots) -> String StoreError! {
    table := [U8]{}
    hangar :: roots.hangar_dir()
    store_push_dir_stats(&table, store_journal_dir(roots))
    store_push_dir_stats(&table, files.join(hangar, STORE_RECEIPTS_DIR))
    store_push_dir_stats(&table, files.join(hangar, STORE_SEALS_DIR))
    store_push_dir_stats(&table, files.join(hangar, STORE_OBJECTS_DIR))
    // Entry set: a new or deleted entry must invalidate, but the entry NAME
    // alone is enough; meta content is authenticated against its immutable
    // receipt on every load, and warm runs bump `last_used_at` (meta mtime)
    // on every cached use.
    if files.list_dir(hangar) == {
        .Ok(entries) -> {
            names := [String]{}
            loop entry in entries {
                if files.lexists(files.join(entry.path, "meta.json")) {
                    &names.push(entry.name)
                }
            }
            &names.sort()
            loop name in names {
                store_push_u64_le(&table, name.bytes().len())
                store_push_bytes(&table, name.bytes())
            }
        }
        .Err(error) -> if !StoreError.IO(error).is_not_found() -> return Err(StoreError.IO(error))
    }
    Ok(store_sha256_hex(table))
}

pub fn store_migrate_closure_graph_unlocked(verification: &StoreVerification, roots: HangarRoots) -> (migrated: Int, graph: ClosureGraph) StoreError! {
    recovered :: store_recover_closure_journal_graph_unlocked(&verification, roots)
    entries := store_list_unlocked(roots)
    &entries.sort_by(entry -> entry.id)
    store_migrate_closure_graph_from_entries(&verification, roots, recovered.graph, entries)
}

fn store_migrate_closure_graph_unlocked_ignoring(verification: &StoreVerification, roots: HangarRoots, ignored: [String]) -> (migrated: Int, graph: ClosureGraph) StoreError! {
    graph := store_closure_graph_structure_read_only(&verification, roots)
    deleted := ~graph.deleted_records
    loop id in ignored {
        graph.records.remove(id).drop("an ignored id may have no record")
        &deleted.push(id)
    }
    graph.deleted_records = store_sorted_unique(deleted)
    entries := [StoreEntry]{}
    loop entry in store_list_read_only(roots) {
        if ignored.contains(entry.id) -> next
        &entries.push(entry)
    }
    &entries.sort_by(entry -> entry.id)
    store_migrate_closure_graph_from_entries(&verification, roots, graph, entries)
}

fn store_migrate_closure_graph_from_entries(verification: &StoreVerification, roots: HangarRoots, graph: ClosureGraph, entries: [StoreEntry]) -> (migrated: Int, graph: ClosureGraph) StoreError! {
    seen_records := [String: Bool]{}
    objects := [String: ClosureObject]{}
    records := [ClosureRecord]{}
    loop legacy in entries {
        entry :: store_normalize_legacy_entry(legacy)
        if graph.deleted_records.contains(entry.id) -> next
        descriptor :: store_descriptor_for_entry(&verification, roots, entry)
        record :: descriptor.record
        if seen_records.has_key(record.id) -> return Err(StoreError.Other("legacy migration contains duplicate record `{record.id}`"))
        seen_records[record.id] = true
        loop object in descriptor.objects {
            if graph.objects.get(object.digest) == {
                .Val(existing) -> {
                    if existing != object -> return Err(StoreError.Other("immutable closure object `{object.digest}` changed descriptor"))
                }
                .None -> {
                    if objects.get(object.digest) == {
                        .Val(existing) -> {
                            if existing != object -> return Err(StoreError.Other("legacy migration gives object `{object.digest}` conflicting descriptors"))
                        }
                        .None -> {}
                    }
                    objects[object.digest] = object
                }
            }
        }
        if graph.records.get(record.id) != Val(record) -> &records.push(record)
    }
    if objects.len() == 0 && records.len() == 0 {
        // Steady state is exactly where an overgrown journal must fold into
        // one snapshot; skipping here meant a warm store never compacted.
        store_compact_if_needed(&verification, roots)
        return Ok((migrated: 0, graph: graph))
    }
    migrated :: records.len()
    object_list := [ClosureObject]{}
    loop digest in store_sorted_object_keys(objects) -> &object_list.push(objects[digest])
    transaction :: ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: object_list, records: records, deleted_records: [String]{}}
    updated := graph
    store_apply_entry(&updated, transaction)
    store_validate_graph_structure_mode(roots, updated, false)
    loop record in transaction.records -> store_validate_record_store_proof(&verification, roots, record, false)
    _ :: store_append_entry(roots, transaction)
    loop record in transaction.records {
        _ :: store_materialize_package_record(roots, record)
    }
    store_compact_if_needed(&verification, roots)
    Ok((migrated: migrated, graph: updated))
}

fn store_sorted_object_keys(objects: [String: ClosureObject]) -> [String] Never! {
    keys := objects.keys().to_list()
    &keys.sort()
    keys
}

// Single-entry registration seam for tests and the `test-seam` backdater,
// which deliberately re-runs the full validation path for one entry.
pub fn store_register_entry_unlocked(verification: &StoreVerification, roots: HangarRoots, entry: StoreEntry) -> Bool StoreError! {
    store_register_entries_unlocked_with_mode(&verification, roots, [StoreEntry]{entry}, RegistrationMode.Native, None)
}

// Register a batch of already-quarantined entries as one closure
// transaction. The caller owns the surrounding Hangar lock and must have
// made every output path live before calling this function. All graph
// conflicts and store proofs are checked before the single durable journal
// append, so a failed batch cannot leave an earlier entry committed.
pub fn store_register_entries_unlocked(verification: &StoreVerification, roots: HangarRoots, entries: [StoreEntry]) -> Bool StoreError! {
    store_register_entries_unlocked_with_mode(&verification, roots, entries, RegistrationMode.Native, None)
}

pub fn store_register_admitted_nix_entries_unlocked(verification: &StoreVerification, roots: HangarRoots, entries: [StoreEntry]) -> Bool StoreError! {
    store_register_entries_unlocked_with_mode(&verification, roots, entries, RegistrationMode.AdmittedNix, None)
}

// Shared closure-registration half of the Hangar admission transaction.
// Format adapters choose only the output-proof law; certification, conflict
// checks, journal append, and recoverable projection stay one mechanism.
pub fn store_register_entries_unlocked_with_mode(verification: &StoreVerification, roots: HangarRoots, entries: [StoreEntry], mode: RegistrationMode, fresh_action_key: String?) -> Bool StoreError! {
    if entries.len() == 0 -> return Ok(false)
    hangar :: roots.hangar_dir()
    loop entry in entries {
        if mode == {
            .Native -> store_share_tree_files(roots, entry.out, entry.platform_artifact_kind != "")
            // Nix admission keeps objects root-local. Optional shared-CAS
            // pooling is skipped, including for regular-file roots.
            .AdmittedNix -> store_verify_admitted_nix_output(roots, entry)
        }
        // Native registration may replace payload files with shared-CAS
        // hardlinks. Refresh only the stat manifest: the transaction already
        // checked the canonical digest before publication.
        digest :: entry.envelope.output_hash
        if digest != "" && store_object_digest_for_path(entry.out, hangar) == Val(digest) {
            store_write_seal(&verification, entry.out, hangar, digest)
        }
        store_verify_registration_output(&verification, roots, entry)
    }
    graph :: store_migrate_closure_graph_unlocked(&verification, roots).graph
    if fresh_action_key == {
        .Val(action_key) -> {
            loop entry in entries -> store_certify_registration_unlocked_with_fresh_agreement(&verification, roots, entry, entries, action_key)
        }
        .None -> store_certify_registrations_unlocked(&verification, roots, entries)
    }
    object_map := [String: ClosureObject]{}
    records := [ClosureRecord]{}
    seen_records := [String: Bool]{}
    loop entry in entries {
        descriptor :: store_descriptor_for_entry(&verification, roots, entry)
        record :: descriptor.record
        if seen_records.has_key(record.id) -> return Err(StoreError.InvalidData("closure batch contains duplicate record `{record.id}`"))
        seen_records[record.id] = true
        loop object in descriptor.objects {
            if graph.objects.get(object.digest) == {
                .Val(existing) -> {
                    if existing != object -> return Err(StoreError.InvalidData("immutable closure object `{object.digest}` changed descriptor"))
                }
                .None -> {
                    if object_map.get(object.digest) == {
                        .Val(existing) -> {
                            if existing != object -> return Err(StoreError.InvalidData("closure batch gives object `{object.digest}` conflicting descriptors"))
                        }
                        .None -> {}
                    }
                    object_map[object.digest] = object
                }
            }
        }
        if graph.records.get(record.id) != Val(record) -> &records.push(record)
    }
    if records.len() == 0 && object_map.len() == 0 -> return Ok(false)
    &records.sort_by(record -> record.id)
    object_list := [ClosureObject]{}
    loop digest in store_sorted_object_keys(object_map) -> &object_list.push(object_map[digest])
    transaction :: ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: object_list, records: records, deleted_records: [String]{}}
    candidate := graph
    store_apply_entry(&candidate, transaction)
    store_validate_graph_structure_mode(roots, candidate, false)
    loop record in transaction.records -> store_validate_record_store_proof(&verification, roots, record, false)
    _ :: store_append_entry(roots, transaction)
    // The durable journal append is the commit point. Projection and
    // compaction are recoverable maintenance.
    loop record in transaction.records {
        store_materialize_package_record(roots, record).drop("a missing projection is recovered from the committed journal")
    }
    store_compact_if_needed(&verification, roots).drop("compaction is recoverable maintenance after the commit point")
    Ok(true)
}

fn store_verify_admitted_nix_output(roots: HangarRoots, entry: StoreEntry) StoreError! {
    producer :: ProducerRecord.decode(entry.producer_record)
    expected :: files.join(files.join(roots.hangar_dir(), STORE_OBJECTS_DIR), entry.envelope.output_hash)
    metadata :: files.stat(expected) ?? return Err(StoreError.Other("admitted Nix entry `{entry.out}` is not its verified canonical CAS object: canonical CAS path `{expected}` could not be inspected: {StoreError.IO(err).message()}"))
    reason :: if {
        producer.provider != "nix" -> Val("producer provider is not `nix`")
        entry.out != expected -> Val("entry output path does not equal its output-hash CAS path")
        entry.envelope.output_hash == "" -> Val("output hash is empty")
        // Admitted Nix NARs may have a regular file as their root. Native
        // registration keeps its existing output-shape law elsewhere.
        !metadata.is_symlink && !metadata.is_dir && !metadata.is_file -> Val("canonical CAS path is not a directory, regular file, or symlink")
        else -> None
    }
    if reason == {
        .Val(text) -> return Err(StoreError.Other("admitted Nix entry `{entry.out}` is not its verified canonical CAS object: {text}"))
        .None -> {}
    }
}

// Test seam: register one entry and run `after_append` right after the
// durable journal append, before the post-commit content proof.
pub fn store_register_entry_unlocked_with_hook(verification: &StoreVerification, roots: HangarRoots, entry: StoreEntry, after_append: fn()) -> Bool StoreError! {
    store_register_entry_unlocked_mode(&verification, roots, entry, Val(after_append), None)
}

fn store_register_entry_unlocked_mode(verification: &StoreVerification, roots: HangarRoots, entry: StoreEntry, after_append: (fn())?, fresh_action_key: String?) -> Bool StoreError! {
    hangar :: roots.hangar_dir()
    store_share_tree_files(roots, entry.out, entry.platform_artifact_kind != "")
    output_hash :: entry.envelope.output_hash
    if store_object_digest_for_path(entry.out, hangar) == Val(output_hash) {
        store_write_seal(&verification, entry.out, hangar, entry.envelope.output_hash)
    }
    store_verify_registration_output(&verification, roots, entry)
    graph :: store_migrate_closure_graph_unlocked(&verification, roots).graph
    if fresh_action_key == {
        .Val(action_key) -> store_certify_registration_unlocked_with_fresh_agreement(&verification, roots, entry, [StoreEntry]{}, action_key)
        .None -> store_certify_registrations_unlocked(&verification, roots, [StoreEntry]{entry})
    }
    descriptor :: store_descriptor_for_entry(&verification, roots, entry)
    described :: descriptor.record
    unchanged := graph.records.get(described.id) == Val(described)
    loop object in descriptor.objects {
        if graph.objects.get(object.digest) != Val(object) -> unchanged = false
    }
    if unchanged -> return Ok(false)
    transaction :: ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: descriptor.objects, records: [ClosureRecord]{descriptor.record}, deleted_records: [String]{}}
    candidate := graph
    store_apply_entry(&candidate, transaction)
    store_validate_graph_structure_mode(roots, candidate, false)
    store_validate_record_store_proof(&verification, roots, transaction.records[0], false)
    committed :: store_append_entry(roots, transaction)
    if after_append == {
        .Val(hook) -> hook()
        .None -> {}
    }
    store_verify_registration_output(&verification, roots, entry) ?? {
        failure :: err
        files.remove(committed)
        store_sync_store_directory(store_journal_dir(roots))
        return Err(failure)
    }
    // The durable journal append plus post-commit content proof is the
    // commit point. Projection and compaction are recoverable maintenance;
    // they must not turn a committed registration into a reported failure.
    store_materialize_package_record(roots, transaction.records[0]).drop("a missing projection is recovered from the committed journal")
    store_compact_if_needed(&verification, roots).drop("compaction is recoverable maintenance after the commit point")
    Ok(true)
}

fn store_verify_registration_output(verification: &StoreVerification, roots: HangarRoots, entry: StoreEntry) StoreError! {
    actual :: store_try_entry_output_hash(&verification, roots, entry) ?? return Err(StoreError.InvalidData("cannot register output `{entry.out}`: {err.message()}"))
    if entry.envelope.output_hash == "" {
        return Err(StoreError.InvalidData("cannot register output `{entry.out}` without a content digest"))
    }
    if actual != entry.envelope.output_hash {
        return Err(StoreError.InvalidData("cannot register output `{entry.out}`: expected `{entry.envelope.output_hash}`, got `{actual}`"))
    }
}

// Test seam: undo a failed registration directory.
pub fn store_rollback_registration_dir(dir: String, created_dir: Bool, had_gc_root: Bool) StoreError! {
    gc_root :: files.join(dir, STORE_NIX_GC_ROOT)
    if !had_gc_root && files.lexists(gc_root) -> files.remove(gc_root)
    if created_dir -> files.remove_all(dir)
}

// Test seam (card #650): backdate a Hangar entry's `last_used_at` in the
// closure journal, not just `meta.json`, so a staleness/GC claim can
// simulate an old entry without waiting real time. It re-registers the same
// entry through the full validation path; only the timestamp changes.
pub fn store_test_backdate_last_used_at(verification: &StoreVerification, roots: HangarRoots, id: String, last_used_at: Int) StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    _ :: store_recover_closure_journal_unlocked(&verification, roots)
    found :: store_list_unlocked(roots)
    entry := StoreEntry.empty()
    matched := false
    loop candidate in found {
        if candidate.id == id {
            entry = candidate
            matched = true
            break
        }
    }
    if !matched -> return Err(StoreError.Other("no hangar entry `{id}`"))
    entry.last_used_at = last_used_at
    _ :: store_register_entry_unlocked(&verification, roots, entry)
}

pub fn store_remove_closure_record(verification: &StoreVerification, roots: HangarRoots, id: String) -> Bool StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    _ :: store_recover_closure_journal_unlocked(&verification, roots)
    if !store_load_graph(&verification, roots).records.has_key(id) -> return Ok(false)
    _ :: store_append_entry(roots, ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: [ClosureObject]{}, records: [ClosureRecord]{}, deleted_records: [String]{id}})
    _ :: store_remove_package_record(roots, id)
    store_compact_if_needed(&verification, roots)
    Ok(true)
}

pub fn store_tombstone_closure_record_unlocked(verification: &StoreVerification, roots: HangarRoots, id: String) -> Bool StoreError! {
    graph :: store_load_graph_structure_mode(&verification, roots, true)
    if !graph.records.has_key(id) -> return Ok(false)
    _ :: store_append_entry(roots, ClosureJournalEntry{kind: ClosureJournalKind.Delta, objects: [ClosureObject]{}, records: [ClosureRecord]{}, deleted_records: [String]{id}})
    store_compact_if_needed(&verification, roots)
    Ok(true)
}

pub fn store_recover_closure_journal(verification: &StoreVerification, roots: HangarRoots) -> Int StoreError! {
    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    store_recover_closure_journal_unlocked(&verification, roots)
}

pub fn store_recover_closure_journal_unlocked(verification: &StoreVerification, roots: HangarRoots) -> Int StoreError! {
    Ok(store_recover_closure_journal_graph_unlocked(&verification, roots).recovered)
}

fn store_recover_closure_journal_graph_unlocked(verification: &StoreVerification, roots: HangarRoots) -> (recovered: Int, graph: ClosureGraph) StoreError! {
    recovered := store_recover_receipt_staging(roots)
    journal :: store_journal_dir(roots)
    entries :: files.list_dir(journal) ?? return Ok((recovered: recovered, graph: ClosureGraph.empty()))
    loop entry in entries {
        if {
            entry.name.ends_with(STORE_JOURNAL_PARTIAL_SUFFIX) -> {
                if {
                    entry.is_dir -> files.remove_all(entry.path)
                    else -> files.remove(entry.path)
                }
                recovered += 1
            }
            entry.name.ends_with(STORE_JOURNAL_TXN_SUFFIX) -> {
                _ :: store_parse_journal_entry(files.read(entry.path)) ?? return Err(StoreError.InvalidData("closure journal `{entry.path}`: {err.message()}"))
            }
            else -> {}
        }
    }
    graph :: store_load_graph_structure_mode(&verification, roots, true)
    loop record in graph.sorted_records() {
        if record.package_meta == "" -> next
        meta :: pkg_parse_meta(record.package_meta) ?? return Err(StoreError.InvalidData("closure record `{record.id}` has invalid package metadata"))
        if store_materialize_receipt(roots, store_entry_from_meta(record.id, meta)).wrote -> recovered += 1
        if store_materialize_package_record(roots, record) -> recovered += 1
    }
    loop id in graph.deleted_records {
        if store_remove_package_record(roots, id) -> recovered += 1
    }
    Ok((recovered: recovered, graph: graph))
}

fn store_descriptor_for_entry(verification: &StoreVerification, roots: HangarRoots, original: StoreEntry) -> (objects: [ClosureObject], record: ClosureRecord) StoreError! {
    entry := ~original
    // The package projection is a cache of the canonical receipt. Rebuild it
    // from the current facts at migration/registration boundaries; stale
    // projections must not prevent safe repair of the live output.
    entry.receipt = ""
    store_prepare_entry_receipt(roots, &entry)
    primary :: entry.envelope.output_hash
    if primary == "" -> return Err(StoreError.Other("closure record `{entry.id}` has no output digest"))
    hangar :: roots.hangar_dir()
    object_root :: files.join(hangar, STORE_OBJECTS_DIR)
    if entry.named_outputs.get("out") == {
        .Val(named_primary) -> {
            if named_primary != primary -> return Err(StoreError.Other("closure record `{entry.id}` names `out` as `{named_primary}`, not primary `{primary}`"))
        }
        .None -> {}
    }
    outputs := ~entry.named_outputs
    outputs["out"] = primary
    decoded :: ProducerRecord.decode(entry.producer_record)
    objects := [ClosureObject]{}
    loop name in store_sorted_keys(outputs) {
        digest :: outputs[name]
        path :: if decoded == {
            .Ok(producer) -> {
                if {
                    producer.provider == "nix" -> files.join(object_root, digest)
                    name == "out" -> entry.out
                    else -> producer.facts.get("nix.output.{name}") ?? producer.facts.get("output.path.{name}") ?? files.join(object_root, digest)
                }
            }
            .Err(_) -> if name == "out" -> entry.out else -> files.join(object_root, digest)
        }
        &objects.push(ClosureObject{digest: digest, path: path, external: !store_path_starts_with(path, hangar)})
    }
    if decoded == {
        .Ok(producer) -> {
            loop digest in entry.references {
                relative :: producer.facts.get("dependency.object.{digest}") ?? next
                if !store_path_is_normal_relative(relative) {
                    return Err(StoreError.Other("closure record `{entry.id}` has invalid dependency object path `{relative}`"))
                }
                path :: files.join(entry.out, relative)
                actual :: store_verified_file_hash(&verification, path) ?? return Err(err.with_message("reading dependency object `{path}`: {err.message()}"))
                if actual != digest {
                    return Err(StoreError.Other("dependency object `{path}` records `{digest}`, re-hash produced `{actual}`"))
                }
                &objects.push(ClosureObject{digest: digest, path: path, external: !store_path_starts_with(path, hangar)})
            }
        }
        .Err(_) -> {}
    }
    &objects.sort_by(object -> object.digest)
    unique := [ClosureObject]{}
    loop object in objects {
        if unique.len() > 0 && unique[unique.len() - 1].digest == object.digest -> next
        &unique.push(object)
    }
    package_entry := ~entry
    package_entry.named_outputs = outputs
    record :: ClosureRecord{
        id: entry.id,
        primary: primary,
        action_key: store_entry_action_key(entry),
        outputs: outputs,
        references: store_sorted_unique(entry.references),
        producer_record: entry.producer_record,
        package_meta: package_entry.meta_json(),
    }
    Ok((objects: unique, record: record))
}

fn store_normalize_legacy_entry(original: StoreEntry) -> StoreEntry StoreError! {
    if original.producer_record != "" {
        _ :: ProducerRecord.decode(original.producer_record)
        return Ok(original)
    }
    entry := ~original
    identity :: entry.cache_identity
    if identity.source_fingerprint == "" || identity.recipe_fingerprint == "" || identity.policy_fingerprint == "" || identity.platform == "" || entry.envelope.output_hash == "" {
        return Err(StoreError.Other("legacy package `{entry.id}` lacks immutable producer facts"))
    }
    if entry.out.starts_with("/nix/store/") {
        return Err(StoreError.Other("legacy Nix package `{entry.id}` lacks exact derivation facts"))
    }
    producer := ProducerRecord.decode(store_canonical_producer("legacy-migration", "cas:{identity.source_fingerprint}", identity.source_fingerprint, identity, [String: String]{"legacy.reference": entry.reference}))
    &producer.bind_cache_provenance(entry.reference, entry.envelope.output_hash, identity, entry.references)
    provider_refresh_provider_facts(&producer, entry.reference) ?? return Err(StoreError.Other("{err}"))
    entry.producer_record = producer.encode()
    Ok(entry)
}
