// Native Nix binary-cache closure admission (Rust Store/NixCache.rs).
//
// One transaction verifies each narinfo, streams its (zstd-compressed) NAR
// through a byte-capped hashing reader into a private stage, follows
// references until the closure is complete, and publishes the whole closure
// as one Hangar batch pinned by a closure receipt. Discovery and repair use
// the same transaction: a repair pins the original complete receipt before any
// object or package is published, so a valid replacement signature is not
// replacement authority.

STORE_NIX_RECIPE_DOMAIN :: prep { "nix-binary-cache-substitution-v1" }
STORE_NIX_STAGE_PREFIX :: prep { "nix-cache-" }
STORE_NIX_U128_MAX :: prep { "340282366920938463463374607431768211455" }

pub struct NixOutputRequest {
    pub name: String
    pub store_path: String
}

pub struct AdmittedNixObject {
    pub store_path: String
    pub hangar_path: String
    pub hangar_digest: String
    pub direct_reference_digests: [String]
    pub upstream_proof_sha256: String
    pub nar_hash: String
    pub size: Int
    pub compression: String
}

pub struct AdmittedNixClosure {
    pub outputs: [String: AdmittedNixObject]
    pub objects: [String: AdmittedNixObject]
    pub closure_receipt_sha256: String
}

// One closure member, either freshly staged (`stage`) or already verified in
// the Hangar (`stage == None`).
pub struct FetchedObject {
    pub store_path: String
    pub stage: String?
    pub hangar_path: String
    pub hangar_digest: String
    pub references: [String]
    pub direct_reference_digests: [String]
    pub download_bytes: Int
    pub unpacked_bytes: Int
    pub proof: String
    pub nar_hash: String
    pub compression: String
}

// The closure receipt digest and the exact bytes it names.
pub struct NixClosureReceipt {
    pub digest: String
    pub bytes: [U8]
}

pub fn store_admit_nix_closure(verification: &StoreVerification, roots: HangarRoots, outputs: [NixOutputRequest], offline: Bool) -[IO, FS, Net, Env, Time, Time.Wait]> AdmittedNixClosure NixCacheError! {
    store_admit_nix_closure_with_progress(&verification, roots, outputs, offline, None, None)
}

// Use the same signature/NAR admission transaction for discovery and repair.
pub fn store_admit_nix_closure_with_progress(verification: &StoreVerification, roots: HangarRoots, outputs: [NixOutputRequest], offline: Bool, expected_closure_receipt: String?, progress: ProgressHandle?) -[IO, FS, Net, Env, Time, Time.Wait]> AdmittedNixClosure NixCacheError! {
    transaction := NixAdmission.new(&verification, roots, expected_closure_receipt)
    admitted :: &transaction.admit(outputs, offline, progress) ? value -> value ! error -> {
        &transaction.rollback()
        return Err(error)
    }
    Ok(admitted)
}

pub struct NixAdmission {
    verification: StoreVerification
    roots: HangarRoots
    expected_closure_receipt: String?
    pub stage: String
    committed: Bool

    fn new(verification: &StoreVerification, roots: HangarRoots, expected_closure_receipt: String?) -[FS, Env, Time]> NixAdmission NixCacheError! {
        hangar :: roots.hangar_dir()
        store_nix_ensure_dir(hangar, .Admission)
        stage_parent :: files.join(hangar, "stage")
        store_nix_ensure_dir(stage_parent, .Admission)
        stage :: files.join(stage_parent, "{STORE_NIX_STAGE_PREFIX}{store_nix_unique_suffix()}")
        files.create_dir(stage) ?? return Err(store_nix_io_error(.Admission, err))
        store_nix_sweep_dead_admission_stages(stage_parent)
        Ok(NixAdmission{verification: ~verification, roots, expected_closure_receipt, stage, committed: false})
    }

    fn admit(&self, requested: [NixOutputRequest], offline: Bool, progress: ProgressHandle?) -[IO, FS, Net, Env, Time, Time.Wait]> AdmittedNixClosure NixCacheError! {
        verification :: self.verification
        download_started :: time.start()
        requests :: store_nix_validate_requests(requested)
        endpoint :: CacheEndpoint.from_roots(self.roots)
        store_dir := "/nix/store"
        if !offline -> store_dir = endpoint.cache_info().store_dir
        existing_entries :: store_nix_entries_by_store_path(store_list_checked(&verification, self.roots))
        queue := Rank<String>.new()
        loop request in requests.values() -> &queue.add(request.store_path)
        scheduled := queue.copy()
        planned_infos :: store_nix_planned_narinfos_for(self.roots, endpoint)
        store_nix_expand_planned_closure(&queue, &scheduled, planned_infos, store_dir)
        fetched := [String: FetchedObject]{}
        store_nix_progress_phase(progress, "Downloading")
        store_nix_progress_objects(progress, 0, scheduled.len())

        loop queue.len() > 0 {
            wave :: store_nix_take_wave(&queue, STORE_NIX_MAX_PARALLEL_FETCHES)
            pending := [String]{}
            loop store_path in wave {
                if fetched.has_key(store_path) -> next
                found :: store_nix_existing_object(&verification, self.roots, existing_entries, store_path, store_dir) ?? {
                    &pending.push(store_path)
                    next
                }
                loop reference in found.references {
                    if !scheduled.has(reference) {
                        &scheduled.add(reference)
                        &queue.add(reference)
                    }
                }
                fetched[store_path] = found
                store_nix_progress_objects(progress, fetched.len(), scheduled.len())
            }
            if pending.len() == 0 -> next
            if offline -> return Err(NixCacheError.new(.MissingReference, "offline admission found no complete verified Hangar object"))

            store_nix_progress_phase(progress, "Downloading")
            // Successful fetches are merged in path order before the first
            // failure is returned, as Rust sorts joined worker results.
            objects := [String: FetchedObject]{}
            first_error := NixCacheError?{None}
            loop store_path in pending {
                object :: self.fetch_pending(endpoint, planned_infos, store_path, store_dir, progress) ? value -> value ! error -> {
                    if first_error == None -> first_error = Val(error)
                    next
                }
                objects[store_path] = object
            }
            names := objects.keys().to_list()
            &names.sort()
            loop store_path in names {
                object :: objects[store_path]
                loop reference in object.references {
                    if !scheduled.has(reference) {
                        &scheduled.add(reference)
                        &queue.add(reference)
                    }
                }
                fetched[store_path] = object
                store_nix_progress_objects(progress, fetched.len(), scheduled.len())
            }
            if first_error == .Val(error) -> return Err(error)
        }

        store_nix_progress_phase(progress, "Installing")
        store_nix_progress_objects(progress, 0, fetched.len())
        downloaded_bytes := 0
        loop object in fetched.values() {
            if object.download_bytes > 0 && downloaded_bytes > STORE_NIX_INT_MAX - object.download_bytes {
                return Err(NixCacheError.new(.Admission, "Nix downloaded byte count overflowed"))
            }
            downloaded_bytes += object.download_bytes
        }
        closure_receipt :: &self.publish(&fetched, requests, store_dir, progress)
        objects := [String: AdmittedNixObject]{}
        loop store_path in fetched.keys() {
            object :: fetched[store_path]
            objects[store_path] = AdmittedNixObject{
                store_path: store_path,
                hangar_path: object.hangar_path,
                hangar_digest: object.hangar_digest,
                direct_reference_digests: object.direct_reference_digests,
                upstream_proof_sha256: object.proof,
                nar_hash: object.nar_hash,
                size: object.unpacked_bytes,
                compression: object.compression,
            }
        }
        selected := [String: AdmittedNixObject]{}
        loop name in requests.keys() {
            request :: requests[name]
            object :: objects.get(request.store_path) ?? return Err(NixCacheError.new(.Admission, "selected output is missing from the admitted closure"))
            selected[name] = object
        }
        self.committed = true
        store_nix_remember_throughput(self.roots, downloaded_bytes, time.elapsed(download_started))
        Ok(AdmittedNixClosure{outputs: selected, objects, closure_receipt_sha256: closure_receipt})
    }

    // Planned signed metadata first, else a fresh narinfo lookup, then fetch.
    fn fetch_pending(self, endpoint: CacheEndpoint, planned_infos: [String: FetchedInfo], store_path: String, store_dir: String, progress: ProgressHandle?) -[IO, FS, Net, Env, Time.Wait]> FetchedObject NixCacheError! {
        info :: planned_infos.get(store_path) ?? {
            looked :: endpoint.narinfo(store_path, store_dir)
            looked ?? return Err(NixCacheError.new(.MissingReference, "a requested Nix reference returned no narinfo"))
        }
        self.fetch_object(endpoint, info, store_dir, progress)
    }

    fn fetch_object(self, endpoint: CacheEndpoint, info: FetchedInfo, store_dir: String, progress: ProgressHandle?) -[IO, FS, Net, Env, Time.Wait]> FetchedObject NixCacheError! {
        verification :: self.verification
        compression :: info.info.compression
        if compression == .Xz || compression == .Bzip2 {
            return Err(NixCacheError.new(.UnsupportedCompression, "Nix cache compression is not enabled for this admission path"))
        }
        store_path :: info.info.store_path
        url :: endpoint.object_url(info.info.url)
        response :: endpoint.open(url) ?? return Err(NixCacheError.new(.MissingReference, "Nix cache object is absent"))
        if response.status() != 200 {
            return Err(NixCacheError.new(.Transport, "Nix cache object returned a non-success status"))
        }
        content_length := Int?{None}
        if response.header("content-length") == .Val(text) -> content_length = Int.parse(text.trim()) ? value -> Val(value) ! failed -> None
        signed_size :: info.info.file_size
        if signed_size == .Val(expected) && content_length == .Val(actual) && actual != expected {
            return Err(NixCacheError.new(.CompressedCorruption, "Nix cache Content-Length disagrees with signed FileSize"))
        }
        compressed_limit :: signed_size ?? (content_length ?? return Err(NixCacheError.new(.CompressedCorruption, "Nix cache object has neither FileSize nor Content-Length")))
        store_nix_progress_discovered(progress, compressed_limit)
        trees :: files.join(self.stage, "trees")
        tree :: files.join(trees, store_nix_store_basename(store_path))
        store_nix_ensure_dir(trees, .Admission)
        body := HashingReader.new(response.body(limit: compressed_limit + 1), compressed_limit, progress)
        stats :: store_nix_read_nar(&body, compression, tree, info.info.nar_size, store_path)
        if body.count != compressed_limit {
            return Err(NixCacheError.new(.CompressedCorruption, "Nix cache compressed byte count disagrees with its signed size"))
        }
        compressed_hash :: body.digest()
        if info.info.file_hash == .Val(file_hash) {
            expected :: store_normalize_nar_hash(file_hash) ?? return Err(NixCacheError.new(.CompressedCorruption, "Nix cache FileHash is invalid for {store_path}: {err.message()}"))
            actual :: store_normalize_nar_hash(compressed_hash) ?? return Err(NixCacheError.new(.CompressedCorruption, "Nix cache compressed hash is invalid for {store_path}: {err.message()}"))
            if expected != actual {
                return Err(NixCacheError.new(.CompressedCorruption, "Nix cache compressed bytes do not match signed FileHash"))
            }
        }
        actual_nar_hash :: store_normalize_nar_hash(stats.digest) ?? return Err(NixCacheError.new(.NarCorruption, "Nix NAR hash is invalid for {store_path}: {err.message()}"))
        expected_nar_hash :: store_normalize_nar_hash(info.info.nar_hash) ?? return Err(NixCacheError.new(.NarCorruption, "Nix NarHash is invalid for {store_path}: {err.message()}"))
        if actual_nar_hash != expected_nar_hash {
            return Err(NixCacheError.new(.NarCorruption, "Nix NAR bytes do not match signed NarHash"))
        }
        store_seal_node(tree)
        hangar_digest :: store_verified_output_hash(&verification, tree, Val(self.roots.hangar_dir()), false) ?? return Err(NixCacheError.new(.NarCorruption, "Nix staged object {store_path} could not be hashed: {err.message()}"))
        references := [String]{}
        loop name in info.info.references -> &references.push("{store_dir}/{name}")
        &references.sort()
        proof :: store_nix_proof_digest(endpoint.endpoint, info.info, info.fingerprint, info.key_id, info.signature, references)
        Ok(FetchedObject{
            store_path: store_path,
            stage: Val(tree),
            hangar_path: "",
            hangar_digest: hangar_digest,
            references: references,
            direct_reference_digests: [String]{},
            download_bytes: body.count,
            unpacked_bytes: info.info.nar_size,
            proof: proof,
            nar_hash: expected_nar_hash,
            compression: compression.as_str(),
        })
    }

    // Rust runs the locked publication under the Hangar lock and reports any
    // of its failures as an atomic-admission failure with the same detail.
    fn publish(&self, fetched: &[String: FetchedObject], requests: [String: NixOutputRequest], store_dir: String, progress: ProgressHandle?) -[IO, FS, Env, Time, Time.Wait]> String NixCacheError! {
        hangar_lock :: env_runtime_lock(self.roots.root, "hangar")
        receipt :: &self.publish_locked(&fetched, requests, store_dir, progress) ? value -> value ! error -> return Err(NixCacheError.new(.Admission, error.detail))
        Ok(receipt)
    }

    fn publish_locked(&self, fetched: &[String: FetchedObject], requests: [String: NixOutputRequest], store_dir: String, progress: ProgressHandle?) -[IO, FS, Env, Time, Time.Wait]> String NixCacheError! {
        verification :: self.verification
        hangar :: self.roots.hangar_dir()
        objects_dir :: files.join(hangar, "objects")
        store_nix_ensure_dir(objects_dir, .Admission)
        hangar_digests := [String: String]{}
        loop store_path in fetched.keys() -> hangar_digests[store_path] = fetched[store_path].hangar_digest
        names := fetched.keys().to_list()
        &names.sort()
        total_objects :: names.len()
        admitted_objects := 0
        loop store_path in names {
            refs := [String]{}
            loop reference in fetched[store_path].references {
                target :: hangar_digests.get(reference) ?? return Err(NixCacheError.new(.MissingReference, "Nix closure edge has no fetched target"))
                &refs.push(target)
            }
            &refs.sort()
            fetched[store_path].direct_reference_digests = refs
            admitted_objects += 1
            store_nix_progress_objects(progress, admitted_objects, total_objects)
        }

        closure_receipt :: store_nix_closure_receipt_digest(fetched, requests)
        if self.expected_closure_receipt == .Val(expected) && expected != closure_receipt.digest {
            return Err(NixCacheError.new(.Admission, "repaired Nix cache closure disagrees with its original admission receipt"))
        }

        _ :: AdmissionTransaction.recover_unlocked(self.roots)
        transaction := AdmissionTransaction.new(&verification, self.roots)
        loop store_path in names {
            object :: fetched[store_path]
            source :: object.stage ?? files.join(objects_dir, object.hangar_digest)
            fetched[store_path].hangar_path = &transaction.stage_object(AdmissionObject{
                source: source,
                digest: object.hangar_digest,
                bytes: object.unpacked_bytes,
                allow_semantic_xattrs: false,
                repair_corrupt: object.stage != None,
            })
        }

        entries := [StoreEntry]{}
        now :: store_now_secs()
        loop store_path in names {
            object :: fetched[store_path]
            name :: store_nix_store_name(object.store_path)
            reference :: "{name}@nixpkgs"
            identity :: CacheIdentity{
                source_fingerprint: object.proof,
                recipe_fingerprint: crypto.sha256(STORE_NIX_RECIPE_DOMAIN.bytes()).hex(),
                policy_fingerprint: env_cache_policy_fingerprint(false),
                platform: pkg_host_platform(),
            }
            facts :: [String: String]{
                "nix.store-path": object.store_path,
                "nix.references": object.references.join(","),
                "nix.closure.receipt": closure_receipt.digest,
                "nix.proof": object.proof,
                "nix.nar-hash": object.nar_hash,
                "nix.nar-size": "{object.unpacked_bytes}",
                "nix.compression": object.compression,
                "nix.output.out": object.store_path,
            }
            producer_bytes :: store_canonical_producer("nix", object.store_path, object.proof, identity, facts)
            producer := ProducerRecord.decode(producer_bytes)
            &producer.bind_cache_provenance(reference, object.hangar_digest, identity, object.direct_reference_digests)
            // File-root and symlink-root NARs have no executable `bin` projection.
            candidate :: files.join(object.hangar_path, "bin")
            root_is_dir :: files.stat(object.hangar_path) ? info -> info.is_dir && !info.is_symlink ! failed -> false
            bin :: if root_is_dir && files.is_dir(candidate) -> candidate else -> ""
            &entries.push(StoreEntry{
                id: store_content_addressed_entry_id(name, "", reference, object.hangar_digest),
                name: name,
                version: "",
                reference: reference,
                out: object.hangar_path,
                bin: bin,
                rlib: "",
                envelope: Envelope{
                    output_hash: object.hangar_digest,
                    platform: identity.platform,
                    signature: "",
                    provenance: "{object.store_path} via nix-cache",
                },
                cache_identity: identity,
                references: object.direct_reference_digests,
                named_outputs: [String: String]{"out": object.hangar_digest},
                platform_artifact_kind: "",
                producer_record: producer.encode(),
                receipt: "",
                realized_at: now,
                last_used_at: now,
            })
        }
        _ :: &transaction.commit(&entries, [AdmissionReceipt]{AdmissionReceipt{digest: closure_receipt.digest, bytes: closure_receipt.bytes}}, Val(self.stage), RegistrationMode.AdmittedNix, None)
        Ok(closure_receipt.digest)
    }

    // Remove the private stage unless the closure was committed. Rust runs
    // this on `Drop`; Jet callers run it on every exit that did not commit.
    fn rollback(&self) Never! -[FS]> {
        if self.committed -> return
        store_nix_remove_tree(self.stage).drop("an uncommitted stage is scratch")
    }
}

// Decode the NAR stream from the counted body: directly for `none`, through
// the Core zstd reader (D-CORE-CODECSTREAM1) for `zstd`, whose stream must end
// exactly at the canonical NAR.
fn store_nix_read_nar(body: &HashingReader, compression: NixCompression, tree: String, nar_size: Int, store_path: String) -[IO, FS, Net, Env, Time.Wait]> NarStats NixCacheError! {
    if compression == .Plain {
        plain :: store_read_nar_stream_with_mode(NarByteSource{read: (limit: Int) -> &body.read(limit)}, tree, nar_size, true) ?? return Err(store_nix_nar_stream_error(store_path, err.message()))
        return Ok(plain)
    }
    decoder := zstd.reader(&body)
    stats :: store_read_nar_stream_with_mode(NarByteSource{read: (limit: Int) -> &decoder.read(limit)}, tree, nar_size, true) ?? return Err(store_nix_nar_stream_error(store_path, err.message()))
    trailing :: &decoder.read(65536) ?? return Err(NixCacheError.new(.CompressedCorruption, "could not finish zstd decoder: {err}"))
    if trailing.len() != 0 {
        return Err(NixCacheError.new(.CompressedCorruption, "zstd stream contains bytes after the canonical NAR"))
    }
    Ok(stats)
}


fn store_nix_nar_stream_error(store_path: String, detail: String) -> NixCacheError Never! {
    NixCacheError.new(store_nix_classify_nar_error(detail), "Nix cache object {store_path} is not a valid canonical NAR: {detail}")
}

fn store_nix_validate_requests(requested: [NixOutputRequest]) -> [String: NixOutputRequest] NixCacheError! {
    if requested.len() == 0 -> return Err(NixCacheError.new(.DuplicateEntry, "Nix closure admission has no outputs"))
    result := [String: NixOutputRequest]{}
    loop request in requested {
        if request.name == "" || request.name.contains("/") || request.name == "." || request.name == ".." {
            return Err(NixCacheError.new(.PathTraversal, "Nix output name is not one safe component"))
        }
        store_nix_validate_store_path(request.store_path, "/nix/store")
        if result.has_key(request.name) -> return Err(NixCacheError.new(.DuplicateEntry, "Nix closure admission repeats an output name"))
        result[request.name] = ~request
    }
    Ok(result)
}

// The first listed Hangar entry for each recorded `nix.store-path`.
fn store_nix_entries_by_store_path(entries: [StoreEntry]) -> [String: StoreEntry] Never! {
    by_store_path := [String: StoreEntry]{}
    loop entry in entries {
        producer :: ProducerRecord.decode(entry.producer_record) ?? next
        store_path :: producer.facts.get("nix.store-path") ?? next
        if !by_store_path.has_key(store_path) -> by_store_path[store_path] = ~entry
    }
    by_store_path
}

// An already admitted, still verified Hangar object for `store_path`, or
// `None` when it must be (re)fetched.
fn store_nix_existing_object(verification: &StoreVerification, roots: HangarRoots, entries: [String: StoreEntry], store_path: String, store_dir: String) -[FS, Env]> FetchedObject? NixCacheError! {
    entry :: entries.get(store_path) ?? return Ok(None)
    output :: entry.out
    info :: files.stat(output) ?? return Ok(None)
    if !info.is_symlink && !info.is_dir && !info.is_file -> return Ok(None)
    if !store_path_starts_with(output, roots.hangar_dir()) -> return Ok(None)
    digest :: store_verified_output_hash_persistent(&verification, output, Val(roots.hangar_dir()), false) ?? return Err(NixCacheError.new(.Admission, "existing Nix object {store_path} failed re-hash: {err.message()}"))
    if digest != entry.envelope.output_hash -> return Ok(None)
    producer :: ProducerRecord.decode(entry.producer_record) ?? return Err(NixCacheError.new(.Admission, err.message()))
    references := [String]{}
    recorded :: producer.facts.get("nix.references") ?? ""
    loop reference in recorded.split(",") {
        if reference != "" -> &references.push(reference)
    }
    nar_hash :: producer.facts.get("nix.nar-hash") ?? return Ok(None)
    if nar_hash == "" -> return Ok(None)
    compression :: producer.facts.get("nix.compression") ?? return Ok(None)
    if compression == "" -> return Ok(None)
    size_text :: producer.facts.get("nix.nar-size") ?? return Ok(None)
    unpacked_bytes :: Int.parse(size_text) ?? return Ok(None)
    if unpacked_bytes < 0 -> return Ok(None)
    proof :: producer.facts.get("nix.proof") ?? ""
    if proof == "" || references.len() != entry.references.len() -> return Ok(None)
    loop reference in references {
        valid :: store_nix_validate_store_path(reference, store_dir) ? _ok -> true ! failed -> false
        if !valid -> return Ok(None)
    }
    Ok(Val(FetchedObject{
        store_path: store_path,
        stage: None,
        hangar_path: output,
        hangar_digest: digest,
        references: references,
        direct_reference_digests: entry.references,
        download_bytes: 0,
        unpacked_bytes: unpacked_bytes,
        proof: proof,
        nar_hash: nar_hash,
        compression: compression,
    }))
}

// `nix-cache-closure-v1`: requested outputs, objects with their proofs, and
// every edge with its resolved target digest, in store-path order.
fn store_nix_closure_receipt_digest(objects: [String: FetchedObject], outputs: [String: NixOutputRequest]) -> NixClosureReceipt Never! {
    bytes := "nix-cache-closure-v1\n".bytes()
    output_names := outputs.keys().to_list()
    &output_names.sort()
    store_nix_push_u64(&bytes, output_names.len())
    loop name in output_names {
        request :: outputs[name]
        store_nix_push_field(&bytes, name)
        store_nix_push_field(&bytes, request.store_path)
        store_nix_push_field(&bytes, objects[request.store_path].hangar_digest)
    }
    store_paths := objects.keys().to_list()
    &store_paths.sort()
    store_nix_push_u64(&bytes, store_paths.len())
    edge_count := 0
    loop store_path in store_paths {
        object :: objects[store_path]
        store_nix_push_field(&bytes, store_path)
        store_nix_push_field(&bytes, object.hangar_digest)
        store_nix_push_field(&bytes, object.proof)
        edge_count += object.references.len()
    }
    store_nix_push_u64(&bytes, edge_count)
    loop store_path in store_paths {
        object :: objects[store_path]
        loop index in 0..<object.references.len() {
            store_nix_push_field(&bytes, store_path)
            store_nix_push_field(&bytes, object.references[index])
            store_nix_push_field(&bytes, object.direct_reference_digests[index])
        }
    }
    digest :: "sha256-{crypto.sha256(bytes).hex()}"
    NixClosureReceipt{digest, bytes}
}

// `nix-narinfo-proof-v1`: the signed upstream facts one object was admitted on.
fn store_nix_proof_digest(endpoint: String, info: NixNarInfo, fingerprint: [U8], key_id: String, signature: [U8], references: [String]) -> String Never! {
    bytes := "nix-narinfo-proof-v1\n".bytes()
    store_nix_push_bytes(&bytes, endpoint.bytes())
    store_nix_push_bytes(&bytes, info.store_path.bytes())
    store_nix_push_bytes(&bytes, fingerprint)
    store_nix_push_bytes(&bytes, key_id.bytes())
    store_nix_push_bytes(&bytes, signature)
    store_nix_push_bytes(&bytes, info.url.bytes())
    store_nix_push_bytes(&bytes, info.compression.as_str().bytes())
    if info.file_hash == {
        .Val(value) -> {
            &bytes.push(U8{1})
            store_nix_push_field(&bytes, value)
        }
        else -> &bytes.push(U8{0})
    }
    if info.file_size == {
        .Val(value) -> {
            &bytes.push(U8{1})
            store_nix_push_u64(&bytes, value)
        }
        else -> &bytes.push(U8{0})
    }
    store_nix_push_field(&bytes, info.nar_hash)
    store_nix_push_u64(&bytes, info.nar_size)
    loop reference in references -> store_nix_push_field(&bytes, reference)
    "sha256-{crypto.sha256(bytes).hex()}"
}

fn store_nix_push_field(output: &[U8], value: String) Never! {
    store_nix_push_bytes(output, value.bytes())
}

fn store_nix_push_bytes(output: &[U8], value: [U8]) Never! {
    store_nix_push_u64(output, value.len())
    loop byte in value -> &output.push(byte)
}

// Big-endian u64, as Rust `u64::to_be_bytes`.
fn store_nix_push_u64(output: &[U8], value: Int) Never! {
    loop index in 0..<8 {
        shift :: (7 - index) * 8
        &output.push(U8{(value >> shift) & 255})
    }
}

fn store_nix_ensure_dir(path: String, kind: NixCacheErrorKind) NixCacheError! -[FS]> {
    info :: files.stat(path) ? found -> found ! error -> {
        if !store_io_is_not_found(error) -> return Err(store_nix_io_error(kind, error))
        files.create_dir_all(path) ?? return Err(store_nix_io_error(kind, err))
        return
    }
    if info.is_symlink || !info.is_dir -> return Err(NixCacheError.new(kind, "Nix cache directory is not a real directory"))
}

// Remove a staged file, symlink, or (read-only) directory tree.
fn store_nix_remove_tree(path: String) StoreError! -[FS]> {
    info :: files.stat(path) ? found -> found ! error -> {
        if store_io_is_not_found(error) -> return
        return Err(StoreError.IO(error))
    }
    if info.is_symlink || info.is_file -> return Ok(files.remove(path))
    if info.is_dir {
        store_make_tree_writable_for_removal(path)
        files.remove_all(path)
        return
    }
    Err(StoreError.InvalidData("Nix cache staging path is not removable"))
}

// Sweep stages left by admission processes that no longer exist.
fn store_nix_sweep_dead_admission_stages(stage_parent: String) Never! -[FS, Env]> {
    entries :: files.list_dir(stage_parent) ?? return
    current_pid :: sys.pid()
    loop entry in entries {
        if !store_nix_admission_stage_is_dead(entry.name, current_pid) -> next
        store_nix_remove_tree(entry.path).drop("a dead admission stage is swept best-effort")
    }
}

pub fn store_nix_admission_stage_is_dead(name: String, current_pid: Int) -[FS]> Bool Never! {
    pid :: store_nix_admission_stage_pid(name) ?? return false
    pid != current_pid && !store_nix_admission_process_alive(pid)
}

// `nix-cache-<pid>-<nonce>` with a nonzero u32 pid and a u128 nonce.
fn store_nix_admission_stage_pid(name: String) -> Int? Never! {
    if !name.starts_with(STORE_NIX_STAGE_PREFIX) -> return None
    parts :: name.removeprefix(STORE_NIX_STAGE_PREFIX).split_once("-") ?? return None
    nonce :: parts.after
    if nonce == "" || nonce.contains("-") -> return None
    if !store_nix_decimal_fits(nonce, STORE_NIX_U128_MAX) || !store_nix_decimal_fits(parts.before, "4294967295") -> return None
    pid :: Int.parse(store_nix_decimal_digits(parts.before)) ?? return None
    if pid == 0 -> return None
    Val(pid)
}

// Rust unsigned `parse`: an optional `+`, then at least one ASCII digit.
// The significant digits, without the sign and leading zeros ("0" for zero).
fn store_nix_decimal_digits(text: String) -> String Never! {
    digits := text.removeprefix("+")
    loop digits.bytes().len() > 1 && digits.starts_with("0") -> digits = digits.removeprefix("0")
    digits
}

// Whether `text` parses as an unsigned integer no larger than `max`.
fn store_nix_decimal_fits(text: String, max: String) -> Bool Never! {
    body :: text.removeprefix("+")
    if body == "" -> return false
    loop byte in body.bytes() {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return false
    }
    digits :: store_nix_decimal_digits(text)
    if digits.bytes().len() != max.bytes().len() -> return digits.bytes().len() < max.bytes().len()
    digits <= max
}

// Linux liveness probe: the process has a `/proc` entry.
fn store_nix_admission_process_alive(pid: Int) -[FS]> Bool Never! {
    files.exists("/proc/{pid}")
}

fn store_nix_unique_suffix() -[Env, Time]> String Never! {
    "{sys.pid()}-{time.instant().unix_ns}"
}
