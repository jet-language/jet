// Private continuation of Store.Broker.BrokerService. Integrate the fidelity
// bodies into their canonical owners, replacing the signed/stat variants.
use std.[fs, io, time]

// Rust: crates/jetpack/src/Store/Broker.rs:1795
fn stage_created_at(path: OSPath, metadata: fs.Metadata) -> U64 io.Error! {
    // GATE #4494: native symlink metadata and epoch timestamp.
    if metadata.is_dir() {
        marker :: path.join(STORE_BROKER_STAGE_MARKER)
        if fs.symlink_metadata(marker) == {
            .Ok(marker_metadata) -> {
                if marker_metadata.file_type().is_symlink() || !marker_metadata.is_file() {
                    return Err(invalid("shared-store incoming stage marker is not a regular file"))
                }
                text :: bounded_text_file(marker, 64, "shared-store incoming stage marker")
                trimmed := text.trim() // #4303
                return if trimmed.parse<U64>() == {
                    .Ok(created) -> Ok(created)
                    .Err(_) -> Err(invalid("shared-store incoming stage marker is invalid"))
                }
            }
            .Err(_) -> {}
        }
    }
    if metadata.modified() == {
        .Ok(modified) -> {
            if modified.duration_since(time.UNIX_EPOCH) == {
                .Ok(duration) -> return Ok(duration.as_secs())
                .Err(_) -> {}
            }
        }
        .Err(_) -> {}
    }
    Ok(0)
}

// Rust: crates/jetpack/src/Store/Broker.rs:1819
fn remove_incoming_entry(path: OSPath) -> io.Error! {
    // GATE #4494: lstat semantics, never follow an incoming symlink.
    metadata :: fs.symlink_metadata(path)
    if metadata.file_type().is_symlink() -> return Err(invalid("shared-store incoming staging contains a symlink"))
    if metadata.is_dir() {
        store_make_tree_writable_for_removal(path)
        fs.remove_dir_all(path)
    } else if metadata.is_file() {
        fs.remove_file(path)
    } else {
        Err(invalid("shared-store incoming staging has an unsupported entry"))
    }
}

// Rust: crates/jetpack/src/Store/Broker.rs:1836
fn bounded_file(path: OSPath, limit: USize, label: String) -> [U8] io.Error! {
    // GATE #4494: native File/Read take adapter; descriptor closes on scope exit.
    // GATE #4483: limit is selected-target usize, converted to exact U64.
    file :: fs.File.open(path)
    bytes := [U8]{}
    reader := file.take(U64.from_usize(limit) + 1)
    &reader.read_to_end(&bytes)
    if bytes.len() > limit -> return Err(invalid("{label} is too large"))
    Ok(bytes)
}

// Rust: crates/jetpack/src/Store/Broker.rs:1846
fn bounded_text_file(path: OSPath, limit: USize, label: String) -> String io.Error! {
    bytes :: bounded_file(path, limit, label)
    if String.from_bytes(^bytes) == {
        .Val(text) -> Ok(text)
        .None -> Err(invalid("{label} is not UTF-8"))
    }
}

// Rust: crates/jetpack/src/Store/Broker.rs:1851
fn invalid(message: String) -> io.Error Never! {
    // GATE #4409: preserve InvalidData exactly, not InvalidInput or Other.
    io.Error.new(io.ErrorKind.InvalidData, message)
}
