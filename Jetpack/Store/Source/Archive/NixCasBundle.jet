// Portable Nix CAS bundles (Rust `Store/Archive.rs`, Nix CAS half).
//
// A bundle is an unsigned canonical Hangar archive holding only
// content-addressed object bytes and relative node names, plus a typed Nix
// closure manifest. It omits package metadata so no machine-local Hangar or
// Nix store path can enter the project artifact. Import checks the declared
// digest, the manifest, and (when locked) the lock's closure identity before
// any Hangar staging or publication.

STORE_PROJECT_NIX_CAS_DIR :: prep { "nix-cas" }

// Export the selected Hangar closure as a portable, unsigned CAS bundle and
// its `sha256-<hex>` digest.
pub fn store_export_nix_cas_bundle(verification: &StoreVerification, roots: HangarRoots, target: String) -> (bytes: [U8], digest: String) StoreError! {
    _lock :: env_runtime_lock(roots.root, "hangar")
    archive :: store_nix_cas_build_unlocked(&verification, roots, target)
    bytes :: archive.encode()
    digest :: "sha256-{pkg_sha256_hex(bytes)}"
    Ok((bytes: bytes, digest: digest))
}

// Persist a portable Nix CAS bundle below the project's managed directory.
// An identical existing bundle is reused; different bytes under the same
// digest fail closed.
pub fn store_publish_nix_cas_bundle(verification: &StoreVerification, project: String, roots: HangarRoots, target: String) -> String StoreError! {
    exported :: store_export_nix_cas_bundle(&verification, roots, target)
    bytes :: exported.bytes
    digest :: exported.digest
    directory :: files.join(pkg_managed_dir(project), STORE_PROJECT_NIX_CAS_DIR)
    store_ensure_real_directory(directory, "project Nix CAS directory")
    path :: files.join(directory, digest)
    if files.read_bytes(path) == {
        .Ok(existing) -> {
            if existing == bytes -> return Ok(digest)
            return Err(StoreError.InvalidData("project Nix CAS bundle digest collides"))
        }
        .Err(error) -> {
            if error == {
                .NotFound(_) -> {}
                else -> return Err(StoreError.IO(error))
            }
        }
    }
    temporary :: files.join(directory, ".{digest}.partial-{store_archive_unique_suffix()}")
    files.write_bytes(temporary, bytes)
    if files.rename(temporary, path) == {
        .Err(error) -> {
            files.remove(temporary).drop("the partial bundle is disposable")
            if error == {
                .AlreadyExists(_) -> {}
                else -> return Err(StoreError.IO(error))
            }
            if files.read_bytes(path) != bytes -> return Err(StoreError.InvalidData("project Nix CAS bundle digest collides"))
        }
        else -> {}
    }
    Ok(digest)
}

// Import a project Nix CAS bundle only after checking its declared digest.
// Returns the import report and the manifest's member keys.
pub fn store_import_nix_cas_bundle(verification: &StoreVerification, project: String, roots: HangarRoots, digest: String) -> (report: HangarArchiveReport, digests: [String]) StoreError! {
    store_nix_cas_import_with_expectation(&verification, project, roots, digest, None)
}

// Import a Nix CAS bundle against the lock's complete closure identity. The
// manifest is decoded and checked before any Hangar staging or publication,
// so the lock identity is an admission precondition, not a post-import
// observation.
pub fn store_import_nix_cas_bundle_checked(verification: &StoreVerification, project: String, roots: HangarRoots, digest: String, closure: NixClosureRecord, envelope: LockEnvelope) -> (report: HangarArchiveReport, digests: [String]) StoreError! {
    closure.validate() ?? return Err(StoreError.Other(err.message()))
    if envelope.output_hash != closure.output || envelope.platform != closure.system {
        return Err(StoreError.InvalidData("locked Nix envelope identity disagrees with its closure record"))
    }
    expectation :: NixReplayExpectation{
        output: closure.output,
        platform: envelope.platform,
        revision: closure.revision,
        cache_key: closure.cache_key,
        references: closure.references,
    }
    store_nix_cas_import_with_expectation(&verification, project, roots, digest, Val(expectation))
}

fn store_nix_cas_import_with_expectation(verification: &StoreVerification, project: String, roots: HangarRoots, digest: String, expectation: NixReplayExpectation?) -> (report: HangarArchiveReport, digests: [String]) StoreError! {
    store_archive_validate_digest(digest)
    path :: files.join(files.join(pkg_managed_dir(project), STORE_PROJECT_NIX_CAS_DIR), digest)
    bytes :: files.read_bytes(path)
    if "sha256-{pkg_sha256_hex(bytes)}" != digest -> return Err(StoreError.InvalidData("project Nix CAS bundle digest mismatch"))
    if bytes.len() > STORE_MAX_ARCHIVE_BYTES -> return Err(StoreError.InvalidData("archive exceeds the 1 GiB limit"))
    archive :: HangarArchive.decode(bytes)
    archive.verify_signature(roots, None, true)
    store_nix_cas_validate_bundle(archive, expectation)
    manifest :: archive.nix_manifest ?? return Err(StoreError.InvalidData("project Nix CAS bundle has no closure manifest"))
    digests := [String]{}
    loop member in manifest.members -> &digests.push(member.key)
    report :: store_archive_import_verified(&verification, roots, archive, true)
    Ok((report: report, digests: digests))
}

// The lock identity a replayed Nix closure must match.
struct NixReplayExpectation {
    output: String
    platform: String
    revision: String
    cache_key: String
    references: [String]
}

// A bundle is admissible only when its manifest is canonical, names exactly
// the archived metadata-free objects, hashes each canonical object, forms an
// acyclic graph with no dangling or unreachable member, and (when locked)
// matches the locked identity.
fn store_nix_cas_validate_bundle(archive: HangarArchive, expectation: NixReplayExpectation?) StoreError! {
    manifest :: archive.nix_manifest ?? return Err(StoreError.InvalidData("project Nix CAS bundle has no closure manifest"))
    store_nix_cas_validate_cas(manifest.output, "manifest output")
    store_nix_cas_validate_platform(manifest.platform)
    store_nix_cas_validate_hex(manifest.revision, 40, "manifest revision")
    store_nix_cas_validate_hex(manifest.cache_key, 64, "manifest cache key")
    if archive.root_id != manifest.output -> return Err(StoreError.InvalidData("Nix closure manifest output disagrees with archive root"))
    if manifest.members.len() == 0 || manifest.members.len() > STORE_ARCHIVE_MAX_OBJECTS {
        return Err(StoreError.InvalidData("Nix closure manifest has an invalid member count"))
    }

    object_keys := [String]{}
    objects := [String: HangarArchiveObject]{}
    loop object in archive.objects {
        if object.meta != "" -> return Err(StoreError.InvalidData("project Nix CAS bundle contains package metadata"))
        if object.id != object.digest -> return Err(StoreError.InvalidData("Nix CAS bundle object id disagrees with its digest"))
        store_nix_cas_validate_cas(object.digest, "Nix CAS member")
        &object_keys.push(object.digest)
        if objects.get(object.digest) != None -> return Err(StoreError.InvalidData("Nix CAS bundle contains duplicate members"))
        objects[object.digest] = object
    }
    member_keys := [String]{}
    loop member in manifest.members -> &member_keys.push(member.key)
    if !store_nix_cas_is_sorted_unique(object_keys) || !store_nix_cas_is_sorted_unique(member_keys) {
        return Err(StoreError.InvalidData("Nix closure manifest members must be sorted and unique"))
    }
    if object_keys != member_keys -> return Err(StoreError.InvalidData("Nix closure manifest member set disagrees with archive objects"))

    edges := [String: [String]]{}
    loop member in manifest.members {
        store_nix_cas_validate_cas(member.key, "Nix closure member key")
        store_nix_cas_validate_cas(member.hash, "Nix closure member hash")
        if member.size == 0 -> return Err(StoreError.InvalidData("Nix closure manifest member has zero size"))
        object :: objects.get(member.key) ?? return Err(StoreError.InvalidData("Nix closure manifest names a missing member"))
        canonical :: store_nix_cas_canonical_object_bytes(object)
        if member.hash != "sha256-{pkg_sha256_hex(canonical)}" || member.size != canonical.len() {
            return Err(StoreError.InvalidData("Nix closure manifest member `{member.key}` has incorrect key/hash/size"))
        }
        if !store_nix_cas_is_sorted_unique(member.references) {
            return Err(StoreError.InvalidData("Nix closure manifest references must be sorted and unique"))
        }
        loop reference in member.references {
            store_nix_cas_validate_cas(reference, "Nix closure reference")
            if reference == member.key -> return Err(StoreError.InvalidData("Nix closure manifest contains a self-reference"))
            if objects.get(reference) == None -> return Err(StoreError.InvalidData("Nix closure manifest reference is outside the member set"))
        }
        edges[member.key] = member.references
    }

    if expectation == {
        .Val(expected) -> {
            if manifest.output != expected.output || manifest.platform != expected.platform || manifest.revision != expected.revision || manifest.cache_key != expected.cache_key {
                return Err(StoreError.InvalidData("Nix closure manifest disagrees with the locked target identity"))
            }
            root_references :: edges.get(manifest.output) ?? return Err(StoreError.InvalidData("Nix closure manifest has no output member"))
            if root_references != expected.references {
                return Err(StoreError.InvalidData("Nix closure manifest root references disagree with the locked closure"))
            }
        }
        .None -> {}
    }

    visiting := [String: Bool]{}
    reachable := [String: Bool]{}
    store_nix_cas_visit(manifest.output, edges, &visiting, &reachable)
    unreachable := reachable.len() != member_keys.len()
    loop key in member_keys {
        if reachable.get(key) == None -> unreachable = true
    }
    if unreachable -> return Err(StoreError.InvalidData("Nix closure manifest contains unreachable extra members"))
}

// Depth-first reachability from `key`, refusing reference cycles.
fn store_nix_cas_visit(key: String, edges: [String: [String]], visiting: &[String: Bool], reachable: &[String: Bool]) StoreError! {
    if reachable.get(key) != None -> return
    if visiting.get(key) != None -> return Err(StoreError.InvalidData("Nix closure manifest contains a reference cycle"))
    visiting[key] = true
    references :: edges.get(key) ?? return Err(StoreError.InvalidData("Nix closure manifest has a missing graph node"))
    loop reference in references -> store_nix_cas_visit(reference, edges, &visiting, &reachable)
    visiting.remove(key)
    reachable[key] = true
}

fn store_nix_cas_is_sorted_unique(values: [String]) -> Bool Never! {
    loop index in 1..<values.len() {
        if !(values[index - 1] < values[index]) -> return false
    }
    true
}

fn store_nix_cas_is_lower_hex(raw: [U8], start: Int) -> Bool Never! {
    loop index in start..<raw.len() {
        code :: Int.from_u8(raw[index])
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// `sha256-` and 64 lowercase hex digits.
fn store_nix_cas_validate_cas(value: String, label: String) StoreError! {
    raw :: value.bytes()
    if !value.starts_with("sha256-") || raw.len() != 71 || !store_nix_cas_is_lower_hex(raw, 7) {
        return Err(StoreError.InvalidData("{label} is not a canonical CAS digest"))
    }
}

fn store_nix_cas_validate_hex(value: String, digits: Int, label: String) StoreError! {
    raw :: value.bytes()
    if raw.len() != digits || !store_nix_cas_is_lower_hex(raw, 0) {
        return Err(StoreError.InvalidData("{label} is not canonical lowercase hex"))
    }
}

fn store_nix_cas_validate_platform(value: String) StoreError! {
    raw :: value.bytes()
    ascii := true
    loop byte in raw {
        if Int.from_u8(byte) >= 128 -> ascii = false
    }
    if raw.len() == 0 || raw.len() > 128 || !ascii || store_archive_has_ascii_control(raw) || value.contains("/") || value.contains("\\") {
        return Err(StoreError.InvalidData("Nix closure manifest has an unsafe target platform"))
    }
}

// Build the bundle for a Nix-produced entry: its metadata-free closure
// objects, rooted at the output digest, with a manifest built from the
// closure graph and the producer's locked index facts.
fn store_nix_cas_build_unlocked(verification: &StoreVerification, roots: HangarRoots, target: String) -> HangarArchive StoreError! {
    entry :: store_archive_select_entry_unlocked(&verification, roots, target)
    producer :: ProducerRecord.decode(entry.producer_record) ?? return Err(StoreError.InvalidData("Nix CAS export has invalid producer record: {err.message()}"))
    if producer.provider != "nix" {
        return Err(StoreError.InvalidData("Nix CAS export requires a Nix producer record; generic Hangar entries use generic archives"))
    }
    platform :: entry.envelope.platform
    if platform == "" -> return Err(StoreError.InvalidData("Nix CAS export has no target platform"))
    revision :: producer.facts.get("nix.index.revision") ?? return Err(StoreError.InvalidData("Nix CAS export has no locked index revision"))
    cache_key :: producer.facts.get("nix.cache.key") ?? return Err(StoreError.InvalidData("Nix CAS export has no cache identity key"))
    if producer.facts.get("nix.index.system") == {
        .Val(system) -> {
            if system != platform -> return Err(StoreError.InvalidData("Nix CAS export producer system disagrees with its target platform"))
        }
        .None -> {}
    }
    graph :: store_closure_graph_structure_unlocked(&verification, roots)
    root_digest :: entry.envelope.output_hash
    full :: store_archive_build_unlocked(&verification, roots, target, true, true)
    objects := [HangarArchiveObject]{}
    has_output := false
    loop object in full.objects {
        if object.meta != "" -> next
        if object.digest == root_digest -> has_output = true
        &objects.push(object)
    }
    if !has_output -> return Err(StoreError.InvalidData("Nix CAS bundle is missing its output object"))
    manifest :: store_nix_cas_build_manifest(objects, graph, root_digest, platform, revision, cache_key)
    archive :: HangarArchive{root_id: root_digest, objects, nix_manifest: Val(manifest), signature: None}
    store_nix_cas_validate_bundle(archive, None)
    Ok(archive)
}

fn store_nix_cas_build_manifest(objects: [HangarArchiveObject], graph: ClosureGraph, output: String, platform: String, revision: String, cache_key: String) -> NixClosureManifest StoreError! {
    object_keys := [String]{}
    loop object in objects -> &object_keys.push(object.digest)
    members := [NixClosureMember]{}
    loop object in objects {
        bytes :: store_nix_cas_canonical_object_bytes(object)
        references :: graph.direct_references(object.digest)
        loop reference in references {
            if !object_keys.contains(reference) {
                return Err(StoreError.InvalidData("Nix closure graph references an object outside the exported member set"))
            }
        }
        &members.push(NixClosureMember{
            key: object.digest,
            hash: "sha256-{pkg_sha256_hex(bytes)}",
            size: bytes.len(),
            references: store_archive_sorted_unique(references),
        })
    }
    &members.sort_by(member -> member.key)
    Ok(NixClosureManifest{output, platform, revision, cache_key, members})
}

// The canonical bytes a manifest member hashes: the root mode and every
// node in archive encoding, without identity or metadata.
fn store_nix_cas_canonical_object_bytes(object: HangarArchiveObject) -> [U8] StoreError! {
    bytes := [U8]{}
    store_archive_put_raw_u32(&bytes, object.root_mode)
    loop node in object.nodes -> node.encode_into(&bytes)
    Ok(bytes)
}
