// Nix output projection and locked replay (Rust `jetpack::Store`): every
// Nix output is projected into the Hangar CAS before Store registration, a
// lock-declared closure is recreated from its portable CAS objects, and a
// locked Nix package reuses or repairs only its original admission.

// Reject a raw `/nix/store` registration that bypassed the native
// projection. Jetpack never asks `nix-store` to create a root; projected Nix
// outputs use the normal Hangar closure proof.
pub fn store_pin_nix_gc_root(entry_dir: String, out: String) StoreError! {
    if store_path_starts_with(out, "/nix/store") {
        return Err(StoreError.Other("Nix compatibility output `{out}` needs a verified native store authority"))
    }
}

// The logical `/nix/store` name of a locked CAS digest.
fn store_locked_nix_logical_path(digest: String, output: String) -> String Never! {
    bare :: digest.removeprefix("sha256-").bytes()
    short :: pkg_bytes_text(bare, 0, if bare.len() < 32 -> bare.len() else -> 32)
    "/nix/store/jet-{short}-{output}"
}

// The canonical digest of `source` when it is exactly a graph object under
// this Hangar's object pool.
fn store_canonical_graph_digest(roots: HangarRoots, graph: ClosureGraph, source: String) -> String? Never! {
    digest :: store_path_strip_prefix(source, files.join(roots.hangar_dir(), STORE_OBJECTS_DIR)) ?? return None
    if digest == "" || digest.contains("/") -> return None
    object :: graph.objects.get(digest) ?? return None
    if object.external || object.path != source -> return None
    Val(digest)
}

// Recreate an explicitly unverified local Nix record from lock-declared CAS
// objects. The logical `/nix/store` names are deterministic projections
// derived from the locked object digest. They are not host store paths and
// are never copied into the project lock.
pub fn store_record_locked_nix(verification: &StoreVerification, roots: HangarRoots, name: String, version: String, reference: String, lock_envelope: LockEnvelope, closure: NixClosureRecord, object_digests: [String], lock_digest: String) -> StoreEntry StoreError! {
    closure.validate() ?? return Err(StoreError.Other(err.message()))
    lock_envelope.validate_nix_catalog() ?? return Err(StoreError.Other(err.message()))
    if lock_envelope.catalog_tier != "local-unofficial" -> return Err(StoreError.Other("cold Nix bytes cannot establish signed index authority"))
    if lock_envelope.output_hash != closure.output -> return Err(StoreError.Other("locked Nix envelope output disagrees with its closure record"))
    if lock_envelope.platform == "" || lock_envelope.platform != closure.system || lock_digest == "" {
        return Err(StoreError.Other("locked Nix replay has incomplete or mismatched target identity"))
    }
    hangar :: roots.hangar_dir()
    object_root :: files.join(hangar, STORE_OBJECTS_DIR)
    digests := [String]{}
    loop digest in object_digests {
        if digest == "" || digest.contains("/") || digest.contains("\\") -> return Err(StoreError.Other("locked Nix replay contains an unsafe CAS digest"))
        if digests.contains(digest) -> next
        &digests.push(digest)
        actual :: pkg_try_output_hash_of_in_hangar(files.join(object_root, digest), hangar, false) ?? return Err(StoreError.Other(err.message()))
        if actual != digest -> return Err(StoreError.Other("locked Nix CAS object `{digest}` re-hashed as `{actual}`"))
    }
    digests = store_sorted_unique(digests)
    complete := digests.contains(closure.output)
    loop member in closure.references {
        if !digests.contains(member) -> complete = false
    }
    if !complete -> return Err(StoreError.Other("locked Nix CAS bundle omits a declared closure reference"))

    cache_identity :: CacheIdentity{
        source_fingerprint: closure.output,
        recipe_fingerprint: store_sha256_hex(PROVIDER_NIX_RECIPE_ID.bytes()),
        policy_fingerprint: closure.cache_key,
        platform: lock_envelope.platform,
    }

    hangar_lock :: env_runtime_lock(roots.root, "hangar")
    _ :: AdmissionTransaction.recover_unlocked(roots)
    entries := [StoreEntry]{}
    loop digest in digests {
        producer :: store_locked_nix_producer(reference, lock_envelope, closure, lock_digest, cache_identity, digest, [String]{})
        identity := cache_identity
        identity.source_fingerprint = digest
        &entries.push(StoreEntry{
            id: store_content_addressed_entry_id("__nix_cas", digest, "nix-cas:{digest}", digest),
            name: "__nix_cas",
            version: digest,
            reference: "nix-cas:{digest}",
            out: files.join(object_root, digest),
            bin: "",
            rlib: "",
            envelope: Envelope{output_hash: digest, platform: lock_envelope.platform, signature: lock_envelope.signature, provenance: lock_envelope.provenance},
            cache_identity: identity,
            references: [String]{},
            named_outputs: [String: String]{"out": digest},
            platform_artifact_kind: "",
            producer_record: producer.encode(),
            receipt: "",
            realized_at: 0,
            last_used_at: 0,
        })
    }

    output :: files.join(object_root, closure.output)
    output_bin :: files.join(output, "bin")
    primary_producer :: store_locked_nix_producer(reference, lock_envelope, closure, lock_digest, cache_identity, closure.output, closure.references)
    &entries.push(StoreEntry{
        id: store_content_addressed_entry_id(name, version, reference, closure.output),
        name: name,
        version: version,
        reference: reference,
        out: output,
        bin: if files.lexists(output_bin) -> output_bin else -> "",
        rlib: "",
        envelope: Envelope{output_hash: closure.output, platform: lock_envelope.platform, signature: lock_envelope.signature, provenance: lock_envelope.provenance},
        cache_identity: cache_identity,
        references: closure.references,
        named_outputs: [String: String]{"out": closure.output},
        platform_artifact_kind: "",
        producer_record: primary_producer.encode(),
        receipt: "",
        realized_at: 0,
        last_used_at: 0,
    })
    primary_index :: entries.len() - 1
    transaction := AdmissionTransaction.new(&verification, roots)
    _ :: &transaction.commit(&entries, [AdmissionReceipt]{}, None, RegistrationMode.AdmittedNix, None)
    Ok(entries[primary_index])
}

// The producer record of one locked Nix CAS object.
fn store_locked_nix_producer(reference: String, lock_envelope: LockEnvelope, closure: NixClosureRecord, lock_digest: String, cache_identity: CacheIdentity, output: String, refs: [String]) -> ProducerRecord StoreError! {
    logical :: store_locked_nix_logical_path(output, "out")
    logical_refs := [String]{}
    loop member in refs -> &logical_refs.push(store_locked_nix_logical_path(member, "out"))
    facts := provider_nix_build_facts_record()
    facts["nix.drv_path"] = "locked-derivation:{closure.derivation}"
    facts["nix.reference"] = reference
    facts["nix.store-path"] = logical
    facts["nix.output.out"] = logical
    facts["nix.output.out.digest"] = output
    facts["nix.references"] = logical_refs.join(",")
    facts["nix.nar-hash"] = closure.nar_hash
    facts["nix.nar-size"] = "{closure.size}"
    facts["nix.compression"] = closure.compression
    facts["nix.index.channel"] = closure.channel
    facts["nix.index.revision"] = closure.revision
    facts["nix.index.system"] = closure.system
    facts["nix.index.tier"] = lock_envelope.catalog_tier
    facts["nix.index.trust"] = lock_envelope.catalog_trust
    facts["nix.index.target.sha256"] = closure.index_authority
    facts["nix.proof"] = closure.upstream_proof
    facts["nix.project-cas-bundle"] = closure.project_cas_bundle
    facts["nix.derivation.sha256"] = closure.derivation
    facts["nix.cache.key"] = closure.cache_key
    facts["nix.lock.digest"] = lock_digest
    facts["nix.closure.receipt"] = closure.project_cas_bundle
    facts["nix.cache.closure.receipt.sha256"] = closure.project_cas_bundle
    facts["nix.cache.source_fingerprint"] = output
    facts["nix.cache.recipe_fingerprint"] = cache_identity.recipe_fingerprint
    facts["nix.cache.policy_fingerprint"] = closure.cache_key
    facts["nix.cache.platform"] = lock_envelope.platform
    plan :: ProviderPlanFacts.from_facts(facts)
    drv_path :: facts.get("nix.drv_path") ?? return Err(StoreError.Other("locked Nix producer lost derivation identity"))
    producer := ProducerRecord.new("nix", "locked-nix:{closure.derivation}", closure.derivation, plan, "nix-derivation:{drv_path}", "policy={closure.cache_key}\nplatform={lock_envelope.platform}", facts)
    identity := cache_identity
    identity.source_fingerprint = output
    &producer.bind_cache_provenance(reference, output, identity, refs)
    Ok(producer)
}

// Project every Nix output into the Hangar CAS before Store registration.
// The original `/nix/store` spelling is retained in the producer facts for
// runtime namespace projection; it is never the durable output root.
pub fn store_project_nix_outputs_unlocked(roots: HangarRoots, realized: Realized, graph: ClosureGraph, transaction: &AdmissionTransaction) -> (out: String, bin: String, rlib: String) StoreError! {
    projected := [String: String]{}
    seen_sources := [String: String]{}
    loop name in store_sorted_keys(realized.named_outputs) {
        source :: realized.named_outputs[name]
        trusted_digest :: store_canonical_graph_digest(roots, graph, source)
        digest :: trusted_digest ?? pkg_try_output_hash_of(source) ?? return Err(StoreError.Other(err.message()))
        if name == "out" && digest != realized.envelope.output_hash {
            return Err(StoreError.Other("Nix primary output changed during Store projection: expected {realized.envelope.output_hash}, got {digest}"))
        }
        canonical := source
        if trusted_digest == None {
            if seen_sources.get(source) == {
                .Val(existing) -> canonical = existing
                .None -> {
                    canonical = store_project_nix_output_unlocked(roots, source, digest, &transaction)
                    seen_sources[source] = canonical
                }
            }
        }
        projected[name] = canonical
    }
    primary_name :: if projected.has_key("out") -> "out" else -> "bin"
    primary :: projected.get(primary_name) ?? return Err(StoreError.InvalidData("Nix provider returned no projected primary output"))
    Ok((out: primary, bin: store_remap_nix_member(realized, projected, realized.bin), rlib: store_remap_nix_member(realized, projected, realized.rlib)))
}

// Remap a member path from its source output onto the projected output.
fn store_remap_nix_member(realized: Realized, projected: [String: String], member: String) -> String Never! {
    if member == "" -> return ""
    loop name in store_sorted_keys(realized.named_outputs) {
        relative :: store_path_strip_prefix(member, realized.named_outputs[name]) ?? next
        destination :: projected.get(name) ?? next
        return files.join(destination, relative)
    }
    member
}

fn store_project_nix_output_unlocked(roots: HangarRoots, source: String, digest: String, transaction: &AdmissionTransaction) -> String StoreError! {
    if digest == "" -> return Err(StoreError.InvalidData("Nix output projection has an empty content digest"))
    objects :: files.join(roots.hangar_dir(), STORE_OBJECTS_DIR)
    destination :: files.join(objects, digest)
    if store_path_starts_with(source, objects) && source != destination {
        return Err(StoreError.Other("canonical object path `{source}` disagrees with digest `{digest}`"))
    }
    bytes :: store_admission_size(source)
    &transaction.stage_object(AdmissionObject{source: source, digest: digest, bytes: bytes, allow_semantic_xattrs: false, repair_corrupt: false})
}

// Test/support projection entry point. Durable publication is delegated to
// the same Hangar transaction used by realized registration.
pub fn store_project_external_output_unlocked(verification: &StoreVerification, roots: HangarRoots, source: String, digest: String) -> String StoreError! {
    _ :: AdmissionTransaction.recover_unlocked(roots)
    transaction := AdmissionTransaction.new(&verification, roots)
    bytes :: store_admission_size(source)
    destination :: &transaction.stage_object(AdmissionObject{source: source, digest: digest, bytes: bytes, allow_semantic_xattrs: false, repair_corrupt: false})
    _ :: &transaction.commit_objects(None)
    Ok(destination)
}

pub fn store_stage_local_output_unlocked(roots: HangarRoots, out: String, bin: String, rlib: String, digest: String, transaction: &AdmissionTransaction) -> (out: String, bin: String, rlib: String) StoreError! {
    if digest == "" || store_path_starts_with(out, "/nix/store") -> return Ok((out: out, bin: bin, rlib: rlib))
    hangar :: roots.hangar_dir()
    if !store_path_starts_with(out, hangar) {
        actual :: pkg_try_output_hash_of(out) ?? return Err(StoreError.Other(err.message()))
        if actual != digest -> return Err(StoreError.Other("provider output `{out}` re-hashed as `{actual}`, expected `{digest}`"))
        return Err(StoreError.Other("provider output `{out}` is outside Hangar and `/nix/store`"))
    }
    objects :: files.join(hangar, STORE_OBJECTS_DIR)
    destination :: files.join(objects, digest)
    store_ensure_real_directory(objects, "Hangar object pool") ?? return Err(err.with_message("creating canonical object directory: {err.message()}"))
    if store_path_starts_with(out, objects) && out != destination {
        return Err(StoreError.Other("canonical object path `{out}` disagrees with digest `{digest}`"))
    }
    bytes :: store_admission_size(out)
    _ :: &transaction.stage_object(AdmissionObject{source: out, digest: digest, bytes: bytes, allow_semantic_xattrs: false, repair_corrupt: false})
    Ok((out: destination, bin: store_remap_local_member(out, destination, bin), rlib: store_remap_local_member(out, destination, rlib)))
}

fn store_remap_local_member(source: String, destination: String, member: String) -> String Never! {
    if member == "" -> return ""
    relative :: store_path_strip_prefix(member, source) ?? return member
    files.join(destination, relative)
}

// Test seam: canonicalize a local output into the Hangar object pool.
pub fn store_canonicalize_local_output_unlocked(verification: &StoreVerification, roots: HangarRoots, out: String, bin: String, rlib: String, digest: String) -> (out: String, bin: String, rlib: String) StoreError! {
    if digest == "" || out.starts_with("/nix/store") -> return Ok((out: out, bin: bin, rlib: rlib))
    _ :: AdmissionTransaction.recover_unlocked(roots)
    transaction := AdmissionTransaction.new(&verification, roots)
    projected :: store_stage_local_output_unlocked(roots, out, bin, rlib, digest, &transaction)
    _ :: &transaction.commit_objects(Val(out))
    Ok(projected)
}

// Reuse original Nix admission, repair its exact signed-cache closure
// online, or import explicitly unverified local bytes. Portable bytes alone
// cannot establish signed index authority.
pub fn store_replay_locked_nix_package(verification: &StoreVerification, roots: HangarRoots, ctx: ProviderCtx, spec: RefSpec) -> VerifiedRealization? RealizeError! {
    project :: ctx.project_dir ?? return Ok(None)
    if !files.is_dir(project) -> return Ok(None)
    locked :: pkg_lock_locked_nix_package_strict(project, spec.raw) ?? return Err(RealizeError.LockedNix(StoreError.Other(err.message())))
    found :: locked ?? return Ok(None)
    lock_digest :: provider_project_lock_digest(ctx.project_dir) ?? return Err(RealizeError.Provider(err))
    // A lock is editable intent, not evidence of index signing. Reuse the
    // original self-verified admission and its canonical Nix paths before
    // considering portable byte replay.
    if store_find_by_reference_read_only(roots, spec.raw) == {
        .Val(candidate) -> return store_replay_recorded_nix(&verification, roots, ctx, spec, project, found, candidate, lock_digest)
        .None -> {}
    }
    if found.envelope.catalog_tier == "official-signed" {
        return Err(RealizeError.LockedNix(StoreError.Other("locked Nix signed authority is unavailable; cold bytes cannot establish index signing")))
    }
    store_require_catalog_permission(Val(found.envelope.catalog_tier), ctx.allow_local_nix_catalog) ?? return Err(RealizeError.LockedNix(err))
    imported :: store_import_nix_cas_bundle_checked(project, roots, found.closure.project_cas_bundle, found.closure, found.envelope) ?? return Err(RealizeError.LockedNix(err))
    entry :: store_record_locked_nix(&verification, roots, found.name, found.version, spec.raw, found.envelope, found.closure, imported.digests, lock_digest) ?? return Err(RealizeError.LockedNix(err))
    store_authorize_and_project_realization(ctx, entry)
    lease :: store_snapshot_lease(&verification, roots, entry) ?? return Err(RealizeError.Store(err))
    Ok(Val(VerifiedRealization{entry: entry, source_state_value: SourceState.Cached, lease: lease}))
}

fn store_locked_nix_error(text: String) -> RealizeError Never! {
    RealizeError.LockedNix(StoreError.Other(text))
}

// The recorded-admission leg of locked Nix replay.
fn store_replay_recorded_nix(verification: &StoreVerification, roots: HangarRoots, ctx: ProviderCtx, spec: RefSpec, project: String, found: (name: String, version: String, closure: NixClosureRecord, envelope: LockEnvelope), candidate: StoreEntry, lock_digest: String) -> VerifiedRealization? RealizeError! {
    producer :: ProducerRecord.decode(candidate.producer_record) ?? return Err(RealizeError.LockedNix(err))
    bundle :: producer.facts.get("nix.project-cas-bundle") ?? return Err(store_locked_nix_error("locked Nix admission lacks its original portable identity"))
    admitted :: provider_nix_closure_record(candidate, producer, bundle) ?? return Err(RealizeError.Provider(err))
    admitted_envelope :: LockEnvelope{
        output_hash: candidate.envelope.output_hash,
        platform: candidate.envelope.platform,
        signature: candidate.envelope.signature,
        provenance: candidate.envelope.provenance,
        catalog_tier: producer.facts.get("nix.index.tier") ?? "",
        catalog_trust: producer.facts.get("nix.index.trust") ?? "",
    }
    admitted_envelope.validate_nix_catalog() ?? return Err(store_locked_nix_error(err.message()))
    if producer.provider != "nix" || candidate.name != found.name || candidate.version != found.version || candidate.reference != spec.raw || candidate.cache_identity.source_fingerprint != found.closure.output || candidate.cache_identity.policy_fingerprint != found.closure.cache_key || admitted != found.closure || admitted_envelope != found.envelope {
        return Err(store_locked_nix_error("locked Nix identity or catalog trust disagrees with recorded Hangar admission"))
    }
    checked := store_find_verified_user_profile_by_reference(&verification, roots, spec.raw) ?? return Err(RealizeError.Store(err))
    if checked == None && !ctx.offline {
        expectation :: CacheExpectation{identity: candidate.cache_identity, owned_output: None, allow_unsigned_local: true}
        // Only closure damage is repairable here. Neither an editable lock
        // nor a failed producer/output proof authorizes cache acquisition.
        if store_verify_cache_entry(&verification, roots, candidate, spec.raw, expectation).admission_trusted() {
            store_require_catalog_permission(producer.facts.get("nix.index.tier"), ctx.allow_local_nix_catalog) ?? return Err(RealizeError.LockedNix(err))
            receipt :: producer.facts.get("nix.cache.closure.receipt.sha256") ?? ""
            if receipt == "" -> return Err(store_locked_nix_error("locked Nix admission lacks its original signed-cache closure receipt"))
            requests := [NixOutputRequest]{}
            loop name in store_sorted_keys(candidate.named_outputs) {
                digest :: candidate.named_outputs[name]
                store_path :: producer.facts.get("nix.output.{name}") ?? return Err(store_locked_nix_error("locked Nix named output disagrees with its original admission"))
                if producer.facts.get("nix.output.{name}.digest") != Val(digest) -> return Err(store_locked_nix_error("locked Nix named output disagrees with its original admission"))
                &requests.push(NixOutputRequest{name: name, store_path: store_path})
            }
            // The canonical admission transaction checks this original
            // receipt before publishing any repaired object or proof.
            store_admit_nix_closure_with_progress(&verification, roots, requests, false, Val(receipt), ctx.progress) ?? return Err(store_locked_nix_error(err.message()))
            checked = store_find_verified_user_profile_by_reference(&verification, roots, spec.raw) ?? return Err(RealizeError.Store(err))
        }
    }
    hit := checked ?? return Err(store_locked_nix_error("locked Nix Hangar admission failed integrity or complete closure verification"))
    if hit.entry != candidate -> return Err(store_locked_nix_error("locked Nix admission changed during verified reuse or repair"))
    store_require_catalog_permission(producer.facts.get("nix.index.tier"), ctx.allow_local_nix_catalog) ?? return Err(RealizeError.LockedNix(err))
    hit.entry = store_refresh_locked_entry(&verification, roots, ctx, spec, project, found, hit.entry, lock_digest) ?? return Err(RealizeError.Store(err))
    store_authorize_and_project_realization(ctx, hit.entry)
    Ok(Val(hit))
}

// Refresh the producer's lock digest only while the project lock still
// names the same identity.
fn store_refresh_locked_entry(verification: &StoreVerification, roots: HangarRoots, ctx: ProviderCtx, spec: RefSpec, project: String, found: (name: String, version: String, closure: NixClosureRecord, envelope: LockEnvelope), entry: StoreEntry, lock_digest: String) -> StoreEntry StoreError! {
    project_lock :: env_runtime_project_lock(project, "nix-verified-reuse")
    current :: provider_project_lock_digest(Val(project)) ?? return Err(StoreError.Other("{err}"))
    current_package :: pkg_lock_locked_nix_package_strict(project, spec.raw) ?? return Err(StoreError.Other(err.message()))
    identity_unchanged :: if current_package == {
        .Val(package) -> package.name == found.name && package.version == found.version && package.closure == found.closure && package.envelope == found.envelope
        .None -> false
    }
    if current != lock_digest || !identity_unchanged -> return Err(StoreError.Other("locked Nix identity changed during verified reuse"))
    store_refresh_lock_digest(&verification, roots, entry, lock_digest)
}
