// The Hangar engine's domain error carrier. Each error kind that callers
// branch on keeps its own variant, with its exact message text. `Io` carries a
// Core boundary failure unchanged, so a `NotFound` from the filesystem stays
// distinguishable from a Hangar fact. Native CacheLease consumer APIs return
// IOError! directly; Hangar callers lift those failures through the canonical
// IO conversion.

#Error
StoreError: enum {
    IO(IOError),
    NotFound(String),
    InvalidData(String),
    InvalidInput(String),
    AlreadyExists(String),
    PermissionDenied(String),
    Unsupported(String),
    Interrupted(String),
    LifecycleConflict(expected: String?, current: String?),
    Other(String),

    // A lifecycle compare-and-swap conflict (io kind AlreadyExists), which
    // external-root callers recognize.

    message: fn(self) -> String Never! {
        if self == {
            .IO(error) -> "{error}"
            .NotFound(text) -> text
            .InvalidData(text) -> text
            .InvalidInput(text) -> text
            .AlreadyExists(text) -> text
            .PermissionDenied(text) -> text
            .Unsupported(text) -> text
            .Interrupted(text) -> text
            .LifecycleConflict(_, _) -> "lifecycle root compare-and-swap conflict"
            .Other(text) -> text
        }
    }

    is_not_found: fn(self) -> Bool Never! {
        if self == {
            .NotFound(_) -> true
            .IO(error) -> if error == {
                .NotFound(_) -> true
                .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Canceled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
            }
            .InvalidData(_) | .InvalidInput(_) | .AlreadyExists(_) | .PermissionDenied(_) | .Unsupported(_) | .Interrupted(_) | .LifecycleConflict(_, _) | .Other(_) -> false
        }
    }

    is_already_exists: fn(self) -> Bool Never! {
        if self == {
            .AlreadyExists(_) -> true
            .LifecycleConflict(_, _) -> true
            .IO(error) -> if error == {
                .AlreadyExists(_) -> true
                .InvalidInput(_) | .NotFound(_) | .PermissionDenied(_) | .TimedOut(_) | .Canceled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .Unsupported(_) -> false
            }
            .NotFound(_) | .InvalidData(_) | .InvalidInput(_) | .PermissionDenied(_) | .Unsupported(_) | .Interrupted(_) | .Other(_) -> false
        }
    }

    // Keep the kind, replace the message.
    with_message: fn(self, text: String) -> StoreError Never! {
        if self == {
            .NotFound(_) -> StoreError.NotFound(text)
            .InvalidData(_) -> StoreError.InvalidData(text)
            .InvalidInput(_) -> StoreError.InvalidInput(text)
            .AlreadyExists(_) -> StoreError.AlreadyExists(text)
            .PermissionDenied(_) -> StoreError.PermissionDenied(text)
            .Unsupported(_) -> StoreError.Unsupported(text)
            .Interrupted(_) -> StoreError.Interrupted(text)
            .IO(error) -> if error == {
                .NotFound(_) -> StoreError.NotFound(text)
                .PermissionDenied(_) -> StoreError.PermissionDenied(text)
                .InvalidInput(_) -> StoreError.InvalidInput(text)
                .AlreadyExists(_) -> StoreError.AlreadyExists(text)
                .Unsupported(_) -> StoreError.Unsupported(text)
                .TimedOut(_) | .Canceled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) -> StoreError.Other(text)
            }
            .LifecycleConflict(_, _) | .Other(_) -> StoreError.Other(text)
        }
    }
}

impl IOError -> StoreError { StoreError.IO(self) }

// The checked store listing's I/O error; its InvalidData facts keep their
// kind.
impl HangarReadError -> StoreError {
    if self == {
        .IO(error) -> StoreError.IO(error)
        .InvalidData(text) -> StoreError.InvalidData(text)
    }
}

// An envelope hashing failure, as an other-kind I/O error.
impl EnvelopeError -> StoreError { StoreError.Other(self.message()) }

// A producer-plan failure, as an other-kind I/O error.
impl ProviderPlanFactsError -> StoreError { StoreError.Other(self.message()) }
