// Durable Hangar publication: flush one file or directory node so an
// earlier write or rename inside it survives a crash. Core's path-level
// `files.fsync` accepts a regular file or a folder on every system
// (D-CORE-FILERENAME1), including the Windows backup-semantics handle Rust
// opened by hand.

// `directory` names the node kind the caller published; Core's path-level
// flush handles both kinds with one call.
pub fn store_sync_store_node(path: String, directory: Bool) StoreError! {
    files.fsync(path)
}

pub fn store_sync_store_directory(path: String) StoreError! {
    store_sync_store_node(path, true)
}
