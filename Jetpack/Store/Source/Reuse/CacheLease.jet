// The lease on a verified cache output (Rust `CacheLease`,
// crates/jetpack/src/Store/Reuse.rs). A lease pins the exact bytes a
// consumer may use: a private sealed snapshot (or, on Linux, the canonical
// sealed CAS object held by directory handle), its executables, and the
// Hangar objects of a Nix closure.
//
// This process reads leased bytes only through the held handles. A child
// reaches them through the held directories: each is reserved a child
// descriptor when it is opened, and `keep_open_for` passes it into the
// child's ProcessSpec at exactly that descriptor (`/proc/self/fd/<fd>` on
// Linux, `/dev/fd/<fd>` elsewhere), so a path swap after verification cannot
// redirect the child. Child-visible text is a `LeaseText`: it names each
// leased directory by a token that only `render` resolves, and only for a
// descriptor the same spec bound.

// The first descriptor a leased directory is reserved at in a child; below
// it are the standard streams and the descriptors Core hands to children.
STORE_LEASE_CHILD_FD: shared ProcessSequence{next: 64}

// Rust `SEQ`: the per-process lease sequence used in lease names.
STORE_LEASE_SEQUENCE: shared ProcessSequence{next: 0}

// Reserve the next process-unique child descriptor.
store_lease_reserve_child_fd: fn() -> Int Never! {
    process_sequence_take(STORE_LEASE_CHILD_FD)
}

// The path a child sees for the directory passed at `fd`.
store_lease_child_fd_path: fn(fd: Int) -> String Never! {
    prefix: if sys.name() == "linux" -> "/proc/self/fd" else -> "/dev/fd"
    "{prefix}/{fd}"
}

// NUL cannot occur in a path, argument, or environment value, so a token
// that `render` did not resolve can never name a file.
store_lease_token_mark: fn() -> String Never! {
    String.from_bytes([U8]{U8{0}}) ?? panic("NUL is one UTF-8 byte")
}

// The token standing for the directory reserved at `fd` inside LeaseText.
store_lease_fd_token: fn(fd: Int) -> String Never! {
    mark: store_lease_token_mark()
    "{mark}jet-lease-fd:{fd}{mark}"
}

// Child text naming the directory reserved at `fd`.
store_lease_fd_text: fn(fd: Int) -> LeaseText Never! {
    LeaseText{text: store_lease_fd_token(fd)}
}

#Error
LeaseHandoffError: enum {
    // A leased directory no longer holds the handle its descriptor passes.
    HandleLost(String)
    // Child text names a leased directory its process was not given.
    Unbound(String)
    // Core refused to pass a held directory into the child.
    Pass(IOError)

    message: fn(self) -> String Never! {
        if self == {
            .HandleLost(path) -> "leased directory `{path}` lost its handle before it reached the child"
            .Unbound(text) -> "child text `{text}` names a leased directory its process was not given"
            .Pass(error) -> "could not pass a leased directory to the child: {error}"
        }
    }
}

impl LeaseHandoffError -> StoreError { StoreError.Other(self.message()) }

// The leased directories one ProcessSpec carries, by reserved descriptor.
// Only `CacheLease.keep_open_for` adds to it, after passing the directory.
LeaseBinding: struct {
    priv fds: [Int]

    empty: fn() -> LeaseBinding Never! {
        LeaseBinding{fds: [Int]{}}
    }
}

// Text a child receives that may name paths inside leased directories.
// The only way out is `render` against the binding of the child's own
// spec; this process never reads leased bytes through it.
LeaseText: struct {
    priv text: String

    plain: fn(text: String) -> LeaseText Never! {
        LeaseText{text: text}
    }

    join: fn(parts: [LeaseText], separator: String) -> LeaseText Never! {
        texts := [String]{}
        loop part in parts -> texts.push(part.text)
        LeaseText{text: texts.join(separator)}
    }

    // `join` keeping only the first of equal parts.
    join_unique: fn(parts: [LeaseText], separator: String) -> LeaseText Never! {
        seen := [String: Bool]{}
        texts := [String]{}
        loop part in parts {
            if seen.has_key(part.text) -> next
            seen[part.text] = true
            texts.push(part.text)
        }
        LeaseText{text: texts.join(separator)}
    }

    // `relative` below this text; an empty relative is the text itself.
    child: fn(self, relative: String) -> LeaseText Never! {
        if relative == "" -> return LeaseText{text: self.text}
        if self.text.ends_with("/") -> return LeaseText{text: "{self.text}{relative}"}
        LeaseText{text: "{self.text}/{relative}"}
    }

    append: fn(self, suffix: String) -> LeaseText Never! {
        LeaseText{text: "{self.text}{suffix}"}
    }

    same: fn(self, other: LeaseText) -> Bool Never! {
        self.text == other.text
    }

    // The child-visible text, or `Unbound` when it names a leased directory
    // that `binding` did not pass.
    render: fn(self, binding: LeaseBinding) -> String LeaseHandoffError! {
        out := self.text
        loop fd in binding.fds -> out = out.replace(store_lease_fd_token(fd), store_lease_child_fd_path(fd))
        mark: store_lease_token_mark()
        if out.contains(mark) -> return Err(LeaseHandoffError.Unbound(out.replace(mark, "")))
        Ok(out)
    }

    // The text for a parent shell, each token replaced by the durable root
    // `roots` names for its descriptor; None when one has no durable root.
    render_durable: fn(self, roots: [Int: String]) -> String? Never! {
        out := self.text
        loop fd in roots.keys().to_list() -> out = out.replace(store_lease_fd_token(fd), roots[fd])
        if out.contains(store_lease_token_mark()) -> return None
        Val(out)
    }
}

// One opened executable of a lease; `relative` is its file name and `id`
// the identity recorded when it was opened.
SnapshotFile: struct {
    relative: String
    file: FileReader?
    id: FileID
}

// One held directory of a lease and the child descriptor reserved for it.
LeasedDirectory: struct {
    path: String
    priv directory: Directory?
    id: FileID
    child_fd: Int

    holds_handle: fn(self) -> Bool Never! {
        self.directory != None
    }

    // The child's text for `relative` below this directory.
    child_text: fn(self, relative: String) -> LeaseText Never! {
        store_lease_fd_text(self.child_fd).child(relative)
    }

    // Pass the held directory into `spec` at its reserved descriptor.
    pass_into: fn(self, spec: ProcessSpec, binding: &LeaseBinding) -> ProcessSpec LeaseHandoffError! {
        // The handle is used where it is held: a copy out of the borrowed
        // receiver would own, and close, the lease's descriptor.
        if self.directory == {
            .Val(directory) -> {
                passed: directory.pass_to(spec, self.child_fd) ?? return Err(LeaseHandoffError.Pass(err))
                binding.fds.push(self.child_fd)
                Ok(passed)
            }
            .None -> Err(LeaseHandoffError.HandleLost(self.path))
        }
    }

    // Open the regular file `relative` through the held handle.
    open_file: fn(self, relative: String) -> FileReader IOError! {
        if self.directory == {
            .Val(directory) -> directory.open(relative)
            .None -> Err(store_lease_handle_lost(self.path))
        }
    }

    // Describe `relative` without following a final link; "" is the
    // directory itself.
    stat_entry: fn(self, relative: String) -> Stat IOError! {
        if self.directory == {
            .Val(directory) -> if relative == "" -> directory.stat() else -> directory.entry_stat(relative)
            .None -> Err(store_lease_handle_lost(self.path))
        }
    }

    read_link: fn(self, relative: String) -> String IOError! {
        if self.directory == {
            .Val(directory) -> directory.read_link(relative)
            .None -> Err(store_lease_handle_lost(self.path))
        }
    }

    // The entries of `relative` below this directory; "" lists it.
    list: fn(self, relative: String) -> [DirectoryEntry] IOError! {
        if self.directory == {
            .Val(directory) -> {
                if relative == "" -> return directory.list()
                nested: directory.open_directory(relative)
                nested.list()
            }
            .None -> Err(store_lease_handle_lost(self.path))
        }
    }

    // Each entry as `name\ttarget`, read through the held handle. The path
    // can die first: a wrapper's is the mount keeper's /proc root.
    link_entries: fn(self) -> [String] IOError! {
        out := [String]{}
        loop entry in self.list("") -> out.push("{entry.name}\t{self.read_link(entry.name)}")
        Ok(out)
    }
}

store_lease_handle_lost: fn(path: String) -> IOError Never! {
    IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased directory `{path}` lost its handle")})
}

// A held Nix projection source: its directory or regular file.
ProjectionHandle: enum {
    Directory(LeasedDirectory)
    File(FileReader)
}

// The stability witness of one projected Nix object: a pinned handle, or
// for a symlink root the exact link target (a link cannot be opened
// no-follow, so its target is re-read instead).
NixProjectionBinding: struct {
    logical: String
    digest: String
    primary: Bool
    source: String
    handle: ProjectionHandle?
    pinned_id: FileID?
    pinned_dir: Bool
    symlink_target: String?

    // The descriptor reserved for a held directory source.
    child_fd: fn(self) -> Int? Never! {
        if self.handle == {
            .Val(handle) -> if handle == {
                .Directory(held) -> Val(held.child_fd)
                .File(_) -> None
            }
            .None -> None
        }
    }

    // Pass a held directory source into `spec`; other sources reach the
    // child by their canonical path.
    pass_into: fn(self, spec: ProcessSpec, binding: &LeaseBinding) -> ProcessSpec LeaseHandoffError! {
        if self.handle == {
            .Val(handle) -> if handle == {
                .Directory(held) -> held.pass_into(spec, binding)
                .File(_) -> Ok(spec)
            }
            .None -> Ok(spec)
        }
    }
}

// A logical `/nix/store/<name>` path and the source a rootless namespace
// binds there.
NixProjectionPath: struct {
    logical: String
    source: LeaseText
}

// A leased output root, how a child names it, and the descriptor reserved
// for its held directory (None when the child gets the canonical source).
LeasedOutputRoot: struct {
    output_root: String
    child_root: LeaseText
    child_fd: Int?
}

ConsumptionStatus: enum {
    Consumable
    NonConsumable(String)
}

CacheLease: struct {
    priv verification: StoreVerification
    priv executables: [SnapshotFile]
    priv out: String
    priv lease_root: String
    priv lease_lock_path: String
    priv live_lock: RuntimeLock?
    // The child descriptor every child of this lease keeps the live lock at.
    priv live_lock_child_fd: Int
    priv handed_off: Bool
    priv protocol_lease_id: String
    priv protocol_generation: Int
    priv protocol_owner_scope: String
    priv protocol_owner_lock: RuntimeLock?
    snapshot_root: String
    priv snapshot_dir: LeasedDirectory?
    priv bin_relative: String?
    // The sealed private snapshot's digest, which `validate` re-proves.
    priv expected_digest: String
    // The realization's canonical output digest, which names it in the Store
    // and in profile receipts.
    priv output_hash: String
    priv direct_cas: Bool
    priv package: String
    priv version: String
    priv reference: String
    priv store_root: String
    priv consumption_status_value: ConsumptionStatus
    // Logical `/nix/store/<name>` paths and the source a rootless namespace
    // binds there.
    priv nix_store_projection_paths: [NixProjectionPath]
    // Verified output roots a consumer path may name.
    priv leased_output_roots: [LeasedOutputRoot]
    priv bin_output_root: String?
    // The `leased_output_roots` entry the bin directory lies in.
    priv bin_output_index: Int?
    priv projected_bin_root: String?
    priv nix_projection_bindings: [NixProjectionBinding]
    priv wrapper_directory_handle: LeasedDirectory?

    // Record that a launched process tree may now hold the lease handles.
    mark_process_handoff: fn(&self) Never! {
        self.handed_off = true
    }

    // Pass every held directory into `spec` at its reserved descriptor and
    // record it in `binding`, so this lease's child text renders for that
    // child. The child also keeps a copy of the live lease lock at a reserved
    // descriptor: a descendant that outlives this process holds the container
    // lock, so `release` and recovery leave the container intact until the
    // whole process tree is gone.
    keep_open_for: fn(&self, spec: ProcessSpec, binding: &LeaseBinding) -> ProcessSpec LeaseHandoffError! {
        out := spec
        if sys.family() != "windows" {
            if self.snapshot_dir == {
                .Val(held) -> out = held.pass_into(out, binding)
                .None -> {}
            }
            if self.wrapper_directory_handle == {
                .Val(held) -> out = held.pass_into(out, binding)
                .None -> {}
            }
            loop index in 0..<self.nix_projection_bindings.len() -> out = self.nix_projection_bindings[index].pass_into(out, binding)
            // The lock is lent: the spec duplicates its descriptor and the
            // lease keeps its own.
            if self.live_lock == {
                .Val(live) -> out = out.keep_open(live.owner, at: self.live_lock_child_fd)
                .None -> {}
            }
        }
        self.mark_process_handoff()
        Ok(out)
    }

    // The descriptors `keep_open_for` passes, so a program path can be
    // rendered before its spec exists; the spec still binds them itself.
    plan_binding: fn(self, binding: &LeaseBinding) Never! {
        if sys.family() == "windows" -> return
        if self.snapshot_dir == {
            .Val(held) -> binding.fds.push(held.child_fd)
            .None -> {}
        }
        if self.wrapper_directory_handle == {
            .Val(held) -> binding.fds.push(held.child_fd)
            .None -> {}
        }
        loop index in 0..<self.nix_projection_bindings.len() {
            if self.nix_projection_bindings[index].child_fd() == .Val(fd) -> binding.fds.push(fd)
        }
    }

    status: fn(self) -> ConsumptionStatus Never! {
        self.consumption_status_value
    }

    // The leased bin directory a child puts on PATH: the protected wrapper
    // directory on Linux, else the bin directory below its leased root.
    child_bin_dir: fn(self) -> LeaseText? Never! {
        bin: self.bin_relative ?? return None
        if self.wrapper_directory_handle == {
            .Val(wrapper) -> return Val(wrapper.child_text(""))
            .None -> {}
        }
        index: self.bin_output_index ?? return None
        Val(self.leased_output_roots[index].child_root.child(bin))
    }

    // The verified, durable package bin directory for a parent shell. Child
    // commands use descriptor paths or private wrapper snapshots; a prompt
    // hook cannot keep process-local leases alive after `jet env export`
    // exits, so it may use the canonical Hangar object only while its sealed
    // object and bin directory are still immutable.
    parent_shell_bin_dir: fn(self) -> String? Never! {
        bin: self.bin_relative ?? return None
        if files.is_abs(bin) || store_path_components(bin).contains("..") -> return None
        expected: self.parent_shell_root() ?? return None
        bin_path: files.join(expected, bin)
        bin_info: files.stat(bin_path) ?? return None
        if bin_info.is_symlink || !bin_info.is_dir -> return None
        if sys.family() != "windows" && (bin_info.mode).bit_and(0o222) != 0 -> return None
        Val(bin_path)
    }

    // The canonical Hangar object of the primary output while it is sealed
    // and immutable: the only root a parent shell may name once this
    // process, and its leases, are gone.
    parent_shell_root: fn(self) -> String? Never! {
        verification := self.verification
        if self.consumption_status_value != ConsumptionStatus.Consumable || self.expected_digest == "" || self.expected_digest.contains("/") || self.expected_digest.contains("\\") -> return None
        hangar: files.join(self.store_root, "hangar")
        expected: files.join(files.join(hangar, STORE_OBJECTS_DIR), self.expected_digest)
        if !store_reuse_same_path(self.out, expected) -> return None
        object_info: files.stat(expected) ?? return None
        if object_info.is_symlink || !object_info.is_dir -> return None
        if sys.family() != "windows" && (object_info.mode).bit_and(0o222) != 0 -> return None
        seal: files.join(files.join(hangar, STORE_SEALS_DIR), self.expected_digest)
        sealed: store_check_seal(verification, expected, hangar) ?? return None
        if sealed != self.expected_digest -> return None
        seal_info: files.stat(seal) ?? return None
        if !seal_info.is_file -> return None
        Val(expected)
    }

    // Each reserved descriptor mapped to the durable root a parent shell
    // names instead; None when the primary output has no such root.
    durable_roots: fn(self) -> [Int: String]? Never! {
        roots := [Int: String]{}
        if self.snapshot_dir == {
            .Val(held) -> roots[held.child_fd] = self.parent_shell_root() ?? return None
            .None -> {}
        }
        loop index in 0..<self.nix_projection_bindings.len() {
            if self.nix_projection_bindings[index].child_fd() == .Val(fd) -> roots[fd] = self.nix_projection_bindings[index].source
        }
        Val(roots)
    }

    nix_store_projection: fn(self) -> [NixProjectionPath] Never! {
        self.nix_store_projection_paths
    }

    original_output: fn(self) -> String Never! {
        self.out
    }

    original_reference: fn(self) -> String Never! {
        self.reference
    }

    profile_install_receipt: fn(self) -> ProfileInstallReceipt IOError! {
        self.validate()
        members := [String]{}
        loop executable in self.executables -> members.push(executable.relative)
        members.sort()
        if members.len() == 0 -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("verified tool lease has no executables")}))
        Ok(ProfileInstallReceipt{store_root: self.store_root, package: self.package, version: self.version, reference: self.reference, output_hash: self.output_hash, executable_members: members})
    }

    // The copy streams the very file handle the lease holds.
    copy_profile_executable: fn(&self, member: String, destination: String) -> ProfileExecutableProof IOError! {
        self.validate()
        index: store_lease_member_index(self.executables, member) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("verified receipt lost executable member")}))
        expected_id: self.executables[index].id
        if &self.executables[index].file == {
            .Val(input) -> {
                if input.stat().id != expected_id -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased executable member changed")}))
                store_reuse_copy_open_profile_file(input, destination)
            }
            .None -> Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("verified receipt lost executable member")}))
        }
    }

    require_consumable: fn(self) IOError! {
        if self.consumption_status_value == {
            .Consumable -> {}
            .NonConsumable(reason) -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val(reason)}))
        }
    }

    executable: fn(self, name: String) -> LeaseText? Never! {
        if self.require_consumable() == {
            .Err(_) -> return None
            else -> {}
        }
        index: self.executable_index(name) ?? return None
        self.executable_child_text(index)
    }

    // Resolve a caller-supplied executable only when it is an exact lease
    // member or the exact raw/projected path of that member. A path that
    // merely shares an output prefix never becomes a trusted handle.
    executable_for: fn(self, requested: String) -> LeaseText? Never! {
        self.executable(requested)
    }

    executable_for_command: fn(self, requested: String) -> LeaseText? IOError! {
        caller_dir: sys.current_dir() ?? "."
        self.executable_for_command_at(requested, caller_dir)
    }

    executable_for_command_at: fn(self, requested: String, caller_dir: String) -> LeaseText? IOError! {
        self.require_consumable()
        resolved: if files.is_abs(requested) -> requested else -> files.join(caller_dir, requested)
        if self.executable_index_at(requested, resolved) == {
            .Val(index) -> return Ok(self.executable_child_text(index))
            .None -> {}
        }
        resolved_paths: store_reuse_path_variants(resolved)
        roots := [String]{self.out, self.lease_root}
        optional_roots: [String?]{self.bin_output_root, self.projected_bin_root}
        loop root in optional_roots {
            if root == {
                .Val(path) -> {
                    roots.push(path)
                }
                .None -> {}
            }
        }
        loop leased in self.leased_output_roots -> roots.push(leased.output_root)
        loop root in roots {
            loop root_variant in store_reuse_path_variants(root) {
                loop resolved_variant in resolved_paths {
                    if store_path_starts_with(resolved_variant, root_variant) {
                        return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("caller requested a path inside an executable lease that is not a recorded member")}))
                    }
                }
            }
        }
        Ok(None)
    }

    // The hex SHA-256 of the member `requested` names, read through the
    // handle the lease holds; None when it names no member of this lease.
    executable_digest_for_command: fn(&self, requested: String) -> String? IOError! {
        if self.executable_for_command(requested) == None -> return Ok(None)
        self.validate()
        caller_dir: sys.current_dir() ?? "."
        resolved: if files.is_abs(requested) -> requested else -> files.join(caller_dir, requested)
        index: self.executable_index_at(requested, resolved) ?? return Ok(None)
        expected_id: self.executables[index].id
        if &self.executables[index].file == {
            .Val(input) -> {
                if input.stat().id != expected_id -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased executable member changed")}))
                input.seek(0)
                hasher := StreamingSHA256.new()
                loop {
                    chunk: input.read(65536)
                    if chunk.len() == 0 -> break
                    hasher.update(chunk)
                }
                Ok(Val(hasher.finalize_hex()))
            }
            .None -> Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("verified receipt lost executable member")}))
        }
    }

    executable_index: fn(self, requested: String) -> Int? Never! {
        self.executable_index_at(requested, requested)
    }

    executable_index_at: fn(self, requested: String, requested_path: String) -> Int? Never! {
        if requested == "" || requested.contains("/") || requested.contains("\\") {
            member: store_reuse_file_name(requested_path) ?? return None
            bin: self.bin_relative ?? return None
            matches_bin_output: store_lease_member_path_matches(self.bin_output_root, bin, member, requested_path)
            matches_projected: store_lease_member_path_matches(self.projected_bin_root, bin, member, requested_path)
            if !matches_bin_output && !matches_projected -> return None
            return store_lease_member_index(self.executables, member)
        }
        store_lease_member_index(self.executables, requested)
    }

    // How a child names executable member `index`: below its leased bin
    // root, which the child holds at that root's reserved descriptor.
    executable_child_text: fn(self, index: Int) -> LeaseText? Never! {
        bin: self.bin_relative ?? return None
        at: self.bin_output_index ?? return None
        Val(self.leased_output_roots[at].child_root.child(bin).child(self.executables[index].relative))
    }

    // How a child names a consumer path inside a leased output, after
    // revalidation: below the held directory of that output, or below the
    // canonical source of a root no directory handle holds. Anything outside
    // every leased output is refused.
    child_path: fn(self, path: String) -> LeaseText IOError! {
        self.validate()
        leased: store_lease_output_for(self.leased_output_roots, path) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("consumer path `{path}` escapes leased output `{self.out}`")}))
        if store_path_components(leased.relative).contains("..") -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased consumer path contains parent traversal")}))
        Ok(leased.child_root.child(leased.relative))
    }

    // `path` relative to the primary output, refused outside it.
    output_relative: fn(self, path: String) -> String IOError! {
        relative: store_path_strip_prefix(path, self.out) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("consumer path `{path}` escapes leased output `{self.out}`")}))
        if store_path_components(relative).contains("..") -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased consumer path contains parent traversal")}))
        Ok(relative)
    }

    // A fresh read handle on the regular file `relative` in the primary
    // output, opened through the held output directory.
    open_output: fn(self, relative: String) -> FileReader IOError! {
        self.require_consumable()
        if self.snapshot_dir == {
            .Val(held) -> held.open_file(relative)
            .None -> Err(store_lease_handle_lost(self.snapshot_root))
        }
    }

    // The text of the regular file `relative` in the primary output.
    read_output: fn(self, relative: String) -> String IOError! {
        input := self.open_output(relative)
        bytes := [U8]{}
        loop {
            chunk: input.read(65536)
            if chunk.len() == 0 -> break
            bytes.extend(chunk)
        }
        text: String.from_bytes(bytes) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased output member `{relative}` is not UTF-8")}))
        Ok(text)
    }

    // Describe `relative` in the primary output without following a final
    // link; "" is the output root.
    output_entry: fn(self, relative: String) -> Stat IOError! {
        self.require_consumable()
        if self.snapshot_dir == {
            .Val(held) -> held.stat_entry(relative)
            .None -> Err(store_lease_handle_lost(self.snapshot_root))
        }
    }

    // The entries of `relative` in the primary output; "" lists the root.
    list_output: fn(self, relative: String) -> [DirectoryEntry] IOError! {
        self.require_consumable()
        if self.snapshot_dir == {
            .Val(held) -> held.list(relative)
            .None -> Err(store_lease_handle_lost(self.snapshot_root))
        }
    }

    read_output_link: fn(self, relative: String) -> String IOError! {
        self.require_consumable()
        if self.snapshot_dir == {
            .Val(held) -> held.read_link(relative)
            .None -> Err(store_lease_handle_lost(self.snapshot_root))
        }
    }

    // Revalidate immediately before handing paths to a child consumer. The
    // archive reader uses no-follow handles and rejects concurrent mutation.
    validate: fn(self) IOError! {
        self.require_consumable()
        if self.direct_cas {
            expected: files.join(files.join(files.join(self.store_root, "hangar"), STORE_OBJECTS_DIR), self.expected_digest)
            if !store_reuse_same_path(self.snapshot_root, expected) -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("direct CAS lease does not name its digest path")}))
            info: files.stat(self.snapshot_root)
            if info.is_symlink || !info.is_dir -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("direct CAS lease root is not a real directory")}))
            if self.snapshot_dir == {
                .Val(held) -> { if sys.family() != "windows" && info.id != held.id -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("direct CAS lease root changed while leased")})) }
                .None -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("direct CAS lease lost its directory handle")}))
            }
        } else {
            if self.protocol_lease_id != "" {
                protocol: ExecutableLeaseProtocol.open(self.store_root)
                protocol.validate_snapshot(self.protocol_lease_id, self.protocol_generation, self.protocol_owner_scope, self.snapshot_root, self.expected_digest)
            }
            actual: pkg_try_output_hash_of(self.snapshot_root) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val(err.message())}))
            if actual != self.expected_digest -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("leased output changed: expected {self.expected_digest}, got {actual}")}))
        }
        if sys.name() == "linux" {
            loop binding in self.nix_projection_bindings -> self.validate_binding(binding)
            if self.wrapper_directory_handle == {
                .Val(wrapper) -> {
                    bin: self.bin_relative ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("lease executable wrappers have no bin directory")}))
                    at: self.bin_output_index ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("lease executable wrappers have no bin root")}))
                    root_fd: self.leased_output_roots[at].child_fd ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("lease executable wrappers have no held bin root")}))
                    store_lease_validate_wrappers(wrapper.link_entries(), root_fd, bin, self.executables)
                }
                .None -> {}
            }
        }
    }

    validate_binding: fn(self, binding: NixProjectionBinding) IOError! {
        verification := self.verification
        info: files.stat(binding.source)
        if !info.is_symlink && !info.is_dir && !info.is_file -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` is not a regular node")}))
        if binding.pinned_id == {
            .Val(pinned) -> {
                if info.is_symlink -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` changed type")}))
                if info.id != pinned -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` changed while leased")}))
                if info.is_dir != binding.pinned_dir || info.is_file == binding.pinned_dir -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` changed type")}))
            }
            .None -> {
                target: binding.symlink_target ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` has no stability witness")}))
                if !info.is_symlink -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` changed while leased")}))
                current: files.read_link(binding.source)
                if current != target -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection source `{binding.source}` changed while leased")}))
            }
        }
        if binding.primary {
            if binding.digest != self.expected_digest -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix primary projection `{binding.logical}` has the wrong digest")}))
            if !store_reuse_same_path(binding.source, self.snapshot_root) -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix primary projection `{binding.logical}` is not the private lease snapshot")}))
            return
        }
        hangar: files.join(self.store_root, "hangar")
        expected: files.join(files.join(hangar, STORE_OBJECTS_DIR), binding.digest)
        if !store_reuse_same_path(binding.source, expected) -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection `{binding.logical}` does not use its canonical Hangar object")}))
        if !self.direct_cas {
            actual: store_verified_output_hash_persistent(verification, binding.source, Val(hangar), false) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val(err.message())}))
            if actual != binding.digest -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("Nix projection `{binding.logical}` changed: expected {binding.digest}, got {actual}")}))
        }
    }

    integrity_failure: fn(self) -> IntegrityFailure? Never! {
        if self.validate() == {
            .Err(error) -> Val(self.consumption_failure(error))
            else -> None
        }
    }

    consumption_failure: fn(self, error: IOError) -> IntegrityFailure Never! {
        IntegrityFailure{
            package: self.package,
            version: self.version,
            expected: self.expected_digest,
            actual: "{error}",
            reason: "race-safe pre-consumer revalidation",
            disposition: "Jetpack rejected it before handing any path to the consumer.",
            fix_text: "Re-run `jet store fetch` after `jet clean`. If the problem persists, audit the source before rebuilding."
        }
    }

    // Rust `Drop`. The local lock copy closes before probing: a launched
    // descendant may still hold the inherited lease lock, in which case
    // recovery owns cleanup and the whole container stays intact.
    release: fn(&&self) Never! {
        lease := self.move()
        lease.live_lock = None
        // The owner lock authenticates publication but cannot prove a
        // descendant exists; only the inherited container lock is the
        // process-tree lifetime fact.
        keep_for_descendant: lease.handed_off && store_lease_lock_held(lease.lease_lock_path)
        if keep_for_descendant -> return
        removed: if store_remove_snapshot_node(lease.lease_root) == {
            .Ok(_) -> true
            else -> false
        }
        if !removed || lease.protocol_lease_id == "" || lease.protocol_owner_lock == None -> return
        protocol: ExecutableLeaseProtocol.open(lease.store_root) ?? return
        released: if protocol.release(lease.protocol_lease_id, lease.protocol_generation, lease.protocol_owner_scope) == {
            .Ok(_) -> true
            else -> false
        }
        if released {
            lease.protocol_owner_lock = None
            if protocol.reap_empty_record(lease.protocol_lease_id) == {
                .Err(_) -> {}
                else -> {}
            }
        }
    }
}

// A held lease lock is live; an idle or absent one is not, and a failed
// probe is treated as live.
store_lease_lock_held: fn(path: String) -> Bool Never! {
    if env_lock_state(path) == {
        .Ok(state) -> state == RuntimeLockState.Held
        .Err(_) -> true
    }
}

store_lease_member_index: fn(members: [SnapshotFile], name: String) -> Int? Never! {
    loop index in 0..<members.len() {
        if members[index].relative == name -> return Val(index)
    }
    None
}

// Whether `requested` is exactly `<root>/<bin>/<member>`.
store_lease_member_path_matches: fn(root: String?, bin: String, member: String, requested: String) -> Bool Never! {
    if root == {
        .Val(path) -> store_reuse_same_path(files.join(files.join(path, bin), member), requested)
        .None -> false
    }
}

// The leased output root containing `path`, how a child names that root,
// and the path below it.
LeasedOutputMatch: struct {
    output_root: String
    child_root: LeaseText
    relative: String
}

store_lease_output_for: fn(roots: [LeasedOutputRoot], path: String) -> LeasedOutputMatch? Never! {
    loop leased in roots {
        if store_path_strip_prefix(path, leased.output_root) == {
            .Val(relative) -> return Val(LeasedOutputMatch{output_root: leased.output_root, child_root: leased.child_root, relative: relative})
            .None -> {}
        }
    }
    None
}

// The link target of the wrapper for executable `name`: the member below
// its bin root, through the descriptor the child holds that root at.
store_lease_wrapper_target: fn(root_fd: Int, bin: String, name: String) -> String Never! {
    files.join(files.join(store_lease_child_fd_path(root_fd), bin), name)
}

// The protected wrapper directory still holds exactly one link per
// executable, each naming that member through its bin root's descriptor.
// `actual` is read through the held handle: the keeper that exposed its
// path has exited.
store_lease_validate_wrappers: fn(actual: [String], root_fd: Int, bin: String, executables: [SnapshotFile]) IOError! {
    found := actual
    found.sort()
    expected := [String]{}
    loop executable in executables -> expected.push("{executable.relative}\t{store_lease_wrapper_target(root_fd, bin, executable.relative)}")
    expected.sort()
    if found != expected -> return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("lease executable wrappers changed")}))
}

// Rust `file_name`: the last normal component, or None for an empty path,
// the root, or a path ending in `..`.
store_reuse_file_name: fn(path: String) -> String? Never! {
    components: store_path_components(path)
    if components.len() == 0 -> return None
    last: components[components.len() - 1]
    if last == ".." -> return None
    Val(last)
}

// Path spellings that can identify the same caller target. The lexical form
// catches missing nodes and `..` traversal; the canonical form catches
// caller-created symlink aliases into a protected lease.
store_reuse_path_variants: fn(path: String) -> [String] Never! {
    lexical: store_reuse_lexical_normalize(path)
    variants := [String]{lexical}
    if files.canonicalize(path) == {
        .Ok(canonical) -> {
            // A detached `/proc/self/fd/<n>` directory can resolve to `/`
            // after its private mount keeper exits; that broad fallback
            // would reject every absolute caller path.
            if canonical != "/" && !store_reuse_same_path(canonical, lexical) -> variants.push(canonical)
        }
        else -> {}
    }
    variants
}

// Rust `lexical_normalize`: drop `.`, pop `..` over a normal component, and
// keep a leading `..` only on a relative path.
store_reuse_lexical_normalize: fn(path: String) -> String Never! {
    absolute: path.starts_with("/")
    parts := [String]{}
    normal := 0
    loop part in path.split("/") {
        if part == {
            "" | "." -> {}
            ".." -> {
                if normal > 0 {
                    _: parts.pop()
                    normal -= 1
                } else {
                    if !absolute {
                        parts.push("..")
                    }
                }
            }
            else -> {
                parts.push(part)
                normal += 1
            }
        }
    }
    joined: parts.join("/")
    if absolute -> return "/{joined}"
    joined
}
