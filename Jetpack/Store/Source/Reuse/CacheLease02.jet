use std.fs as fs
use std.io as io
use std.process.[Command, Child, Stdio]
use std.ffi.[OsString]
use core.sys.target.[selected_os, selected_family]
use jetpack.Envelope.[nofollow_open_flag]
use jetpack.RuntimePolicy.[LeaseMember]
use jet_foundation.SHA256.[StreamingSha256]
use std.collections.[BTreeSet]
// GATE #4483: OS/family dispatch must use the selected target.
// GATE #4409: retain Other, NotFound, Unsupported, InvalidInput and raw errno.
// GATE #4494: native retained descriptors, metadata, child pipes and filesystem operations.
// Native paths remain OSPath; Main publishes this continuation with canonical Reuse types.

// Rust: crates/jetpack/src/Store/Reuse.rs:1867
fn open_nix_projection_sources(projections: [NixStoreProjection]) -> ([(String, OSPath)], [NixProjectionBinding]) io.Error! {
    stable := [(String, OSPath)]{}
    bindings := [NixProjectionBinding]{}
    loop projection in projections {
        metadata :: fs.symlink_metadata(projection.source) ?? return Err(io.Error.other("Nix output `{projection.logical}` Hangar object `{projection.digest}` is unavailable: {err}"))
        if !metadata.file_type().is_symlink() && !metadata.is_dir() && !metadata.is_file() {
            return Err(io.Error.other("Nix projection source `{projection.source.display()}` is not a regular node"))
        }
        if metadata.file_type().is_symlink() {
            target :: fs.read_link(projection.source) ?? return Err(io.Error.other("Nix output `{projection.logical}` Hangar object `{projection.digest}` is unavailable: {err}"))
            &stable.push((projection.logical, projection.source))
            &bindings.push(NixProjectionBinding{logical: projection.logical, digest: projection.digest, primary: projection.primary, source: projection.source, handle: None, symlink_target: Val(target)})
            next
        }
        options := fs.OpenOptions.new()
        &options.read(true).custom_flags(nofollow_open_flag() ?? return Err(io.Error.other(err)))
        handle :: options.open(projection.source) ?? return Err(io.Error.other("Nix output `{projection.logical}` Hangar object `{projection.digest}` is unavailable: {err}"))
        opened :: handle.metadata()
        if metadata.dev() != opened.dev() || metadata.ino() != opened.ino() {
            return Err(io.Error.other("Nix projection source `{projection.source.display()}` changed while opening"))
        }
        clear_close_on_exec(handle)
        &stable.push((projection.logical, OSPath.from("/proc/self/fd/{handle.as_raw_fd()}")))
        &bindings.push(NixProjectionBinding{logical: projection.logical, digest: projection.digest, primary: projection.primary, source: projection.source, handle: Val(handle), symlink_target: None})
    }
    Ok((^stable, ^bindings))
}

// Rust: crates/jetpack/src/Store/Reuse.rs:1951
// A missing index edge is a warm miss, not a graph rebuild per package.
fn nix_store_projection_for_entry_index(roots: Roots, entry: StoreEntry, snapshot_root: OSPath, index: NixProjectionIndex) -> [NixStoreProjection] io.Error! {
    if entry.producer_record.is_empty() -> return Ok([NixStoreProjection]{})
    producer :: ProducerRecord.decode(entry.producer_record) ?? return Err(io.Error.other("cache entry `{entry.id}` has an invalid producer record: {err}"))
    if producer.provider != "nix" -> return Ok([NixStoreProjection]{})
    pending := BTreeSet<String>.new()
    &pending.insert(entry.envelope.output_hash)
    loop digest in entry.named_outputs.values() -> &pending.insert(digest)
    visited := [String: Bool]{}
    logical_digests := [String: String]{}
    loop {
        digest :: &pending.pop_first() ?? break
        if visited.has_key(digest) -> next
        visited[digest] = true
        candidates :: if digest == entry.envelope.output_hash -> [StoreEntry]{entry} else -> index.by_digest.get(digest) ?? return Err(io.Error.other("Nix closure object `{digest}` is missing from the warm reuse index"))
        loop candidate in candidates {
            facts :: ProducerRecord.decode(candidate.producer_record) ?? return Err(io.Error.other("Nix closure entry `{candidate.id}` has invalid producer facts: {err}"))
            if facts.provider != "nix" -> return Err(io.Error.other("Nix closure object `{digest}` is owned by `{facts.provider}`"))
            output_fact := false
            keys := facts.facts.keys().to_list()
            &keys.sort()
            loop key in keys {
                name :: key.strip_prefix("nix.output.") ?? next
                if name.contains(".") -> next
                output_digest :: if name == "out" -> candidate.envelope.output_hash else -> candidate.named_outputs.get(name) ?? return Err(io.Error.other("Nix output `{name}` has no verified named-output digest"))
                path :: store_reuse_canonical_nix_output_path(facts, name)
                if output_digest == digest -> output_fact = true
                add_nix_projection_path(&logical_digests, path, output_digest)
            }
            if !output_fact {
                if store_reuse_canonical_nix_output_path(facts, "out") == {
                    .Ok(path) -> add_nix_projection_path(&logical_digests, path, candidate.envelope.output_hash)
                    .Err(_) -> {}
                }
            }
            loop reference in candidate.references -> &pending.insert(reference)
        }
    }
    if logical_digests.is_empty() -> return Err(io.Error.other("Nix cache entry `{entry.id}` has no canonical output path for projection"))
    primary_logical := String?{None}
    loop name in [String]{"out", "bin"} {
        if store_reuse_canonical_nix_output_path(producer, name) == {
            .Ok(path) -> { primary_logical = Val(path); break }
            .Err(_) -> {}
        }
    }
    projection := [NixStoreProjection]{}
    logicals := logical_digests.keys().to_list()
    &logicals.sort()
    loop logical in logicals {
        digest :: logical_digests[logical]
        primary :: primary_logical == Val(logical)
        source :: if primary -> snapshot_root else -> hangar_projection_object(roots, digest, logical)
        &projection.push(NixStoreProjection{logical, digest, primary, source})
    }
    Ok(^projection)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2086
pub fn nix_store_projection_for_entry(roots: Roots, entry: StoreEntry, snapshot_root: OSPath) -> [NixStoreProjection] io.Error! {
    if entry.producer_record.is_empty() -> return Ok([NixStoreProjection]{})
    producer :: ProducerRecord.decode(entry.producer_record) ?? return Err(io.Error.other("cache entry `{entry.id}` has an invalid producer record: {err}"))
    if producer.provider != "nix" -> return Ok([NixStoreProjection]{})
    logical_digests := [String: String]{}
    fact_keys := producer.facts.keys().to_list()
    &fact_keys.sort()
    loop key in fact_keys {
        name :: key.strip_prefix("nix.output.") ?? next
        if name.contains(".") -> next
        digest :: if name == "out" -> entry.envelope.output_hash else -> entry.named_outputs.get(name) ?? return Err(io.Error.other("Nix output `{name}` has no verified named-output digest"))
        add_nix_projection_path(&logical_digests, store_reuse_canonical_nix_output_path(producer, name), digest)
    }
    if logical_digests.is_empty() -> return Err(io.Error.other("Nix cache entry `{entry.id}` has no canonical output path for projection"))
    graph :: Closure.closure_graph_structure_unlocked(roots) ?? return Err(io.Error.other("Nix cache entry `{entry.id}`: a Hangar object in its recorded closure is unavailable: {err}"))
    closure_digests := [String: Bool]{}
    if graph.records.get(entry.id) == {
        .Val(record) -> {
            expected_outputs := entry.named_outputs
            expected_outputs["out"] = entry.envelope.output_hash
            references := BTreeSet<String>.new()
            loop digest in entry.references -> &references.insert(digest)
            if record.primary != entry.envelope.output_hash || record.outputs != expected_outputs || record.references != references {
                return Err(io.Error.other("Nix closure record `{entry.id}` disagrees with the verified entry"))
            }
            loop digest in expected_outputs.values() {
                loop member in graph.closure(digest) -> closure_digests[member] = true
            }
            digests := closure_digests.keys().to_list()
            &digests.sort()
            owner_ids := graph.records.keys().to_list()
            &owner_ids.sort()
            loop digest in digests {
                object :: graph.objects.get(digest) ?? return Err(io.Error.other("Nix closure object `{digest}` is missing from the Hangar graph"))
                expected_path :: roots.hangar_dir().join(OBJECTS_DIR).join(digest)
                if object.external || OSPath.from(object.path) != expected_path -> return Err(io.Error.other("Nix closure object `{digest}` is not a canonical Hangar object"))
                metadata :: fs.symlink_metadata(expected_path)
                if !metadata.file_type().is_symlink() && !metadata.is_dir() && !metadata.is_file() -> return Err(io.Error.other("Nix closure object `{digest}` is not a regular Hangar node"))
                paths := [String: Bool]{}
                loop owner_id in owner_ids {
                    owner :: graph.records[owner_id]
                    names := owner.outputs.keys().to_list()
                    &names.sort()
                    loop name in names {
                        if owner.outputs[name] != digest -> next
                        owner_producer :: ProducerRecord.decode(owner.producer_record) ?? return Err(io.Error.other("Nix closure record `{owner.id}` has invalid producer facts: {err}"))
                        if owner_producer.provider != "nix" -> return Err(io.Error.other("Nix closure object `{digest}` is owned by `{owner_producer.provider}`"))
                        path :: store_reuse_canonical_nix_output_path(owner_producer, name) ?? return Err(io.Error.other("Nix closure object `{digest}` has no canonical `{name}` output fact: {err}"))
                        paths[path] = true
                    }
                }
                if paths.len() != 1 -> return Err(io.Error.other("Nix closure object `{digest}` has {paths.len()} canonical store paths"))
                add_nix_projection_path(&logical_digests, paths.keys().next() ?? panic("one path checked above"), digest)
            }
        }
        .None -> {
            if !entry.references.is_empty() || producer.facts.has_key("nix.closure.receipt") || producer.facts.has_key("nix.cache.closure.receipt.sha256") {
                return Err(io.Error.other("Nix closure record `{entry.id}` is missing from the Hangar graph"))
            }
        }
    }
    primary_logical := String?{None}
    loop name in [String]{"out", "bin"} {
        if store_reuse_canonical_nix_output_path(producer, name) == {
            .Ok(path) -> { primary_logical = Val(path); break }
            .Err(_) -> {}
        }
    }
    projection := [NixStoreProjection]{}
    logicals := logical_digests.keys().to_list()
    &logicals.sort()
    loop logical in logicals {
        digest :: logical_digests[logical]
        primary :: primary_logical == Val(logical)
        source :: if primary -> snapshot_root else -> hangar_projection_object(roots, digest, logical)
        &projection.push(NixStoreProjection{logical, digest, primary, source})
    }
    Ok(^projection)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2251
// canonical_nix_output_path -> NixStoreProjection.jet:200 store_reuse_canonical_nix_output_path.
// Rust: crates/jetpack/src/Store/Reuse.rs:2277
fn add_nix_projection_path(logical_digests: &[String: String], logical: String, digest: String) -> io.Error! {
    name :: logical.strip_prefix("/nix/store/") ?? return Err(io.Error.other("invalid canonical Nix output path `{logical}`"))
    if name.is_empty() || name.contains("/") || name == "." || name == ".." -> return Err(io.Error.other("invalid canonical Nix output path `{logical}`"))
    components := OSPath.from(digest).components()
    first :: &components.next()
    if digest.is_empty() || !(first == .Val(.Normal(_))) || (&components.next()).is_some() -> return Err(io.Error.other("invalid Hangar digest `{digest}` for `{logical}`"))
    existing :: logical_digests.insert(logical, digest)
    if existing == {
        .Val(value) -> { if value != digest -> return Err(io.Error.other("conflicting canonical Nix output path `{logical}`")) }
        .None -> {}
    }
    Ok(())
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2312
fn hangar_projection_object(roots: Roots, digest: String, logical: String) -> OSPath io.Error! {
    object :: roots.hangar_dir().join(OBJECTS_DIR).join(digest)
    metadata :: fs.symlink_metadata(object) ?? return Err(io.Error.other("Nix output `{logical}` Hangar object `{digest}` is unavailable: {err}"))
    if !metadata.file_type().is_symlink() && !metadata.is_dir() && !metadata.is_file() -> return Err(io.Error.other("Nix output `{logical}` Hangar object `{digest}` is not a regular node"))
    Ok(object)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2333
fn sealed_hangar_projection_object(roots: Roots, digest: String, logical: String) -> OSPath io.Error! {
    object :: hangar_projection_object(roots, digest, logical)
    if selected_os() == "linux" && check_seal(object, roots.hangar_dir()) != Val(digest) {
        return Err(io.Error.other("Nix output `{logical}` Hangar object `{digest}` has no valid seal witness"))
    }
    Ok(object)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2348
fn validate_direct_projection_seals(roots: Roots, projections: [NixStoreProjection]) -> io.Error! {
    if selected_os() == "linux" {
        loop projection in projections {
            if projection.primary -> next
            if check_seal(projection.source, roots.hangar_dir()) != Val(projection.digest) {
                return Err(io.Error.other("Nix output `{projection.logical}` Hangar object `{projection.digest}` has no valid seal witness"))
            }
        }
    }
    Ok(())
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2371
// ExecWrappers stays at LeaseSnapshot.jet:9; migrate its root/directory to OSPath/fs.File.
// Rust: crates/jetpack/src/Store/Reuse.rs:2376
pub fn required_child_pipe<T>(pipe: T?, message: String) -> T io.Error! {
    Ok(pipe ?? return Err(io.Error.other(message)))
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2380
fn open_snapshot_executables(snapshot_root: OSPath, bin: OSPath?) -> [(OsString, fs.File)] io.Error! {
    relative :: bin ?? return Ok([(OsString, fs.File)]{})
    path :: snapshot_root.join(relative)
    out := [(OsString, fs.File)]{}
    if !path.is_dir() -> return Ok(^out)
    entries := [fs.DirEntry]{}
    loop entry in fs.read_dir(path) -> &entries.push(entry)
    &entries.sort_by_key(fn(entry) -> entry.file_name())
    loop entry in entries {
        file :: fs.File.open(entry.path())
        if !(file.metadata()).is_file() -> next
        clear_close_on_exec(file)
        &out.push((entry.file_name(), ^file))
    }
    Ok(^out)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2405
fn executable_lease_members(executables: [(OsString, fs.File)]) -> [LeaseMember] io.Error! {
    members := [LeaseMember]{}
    loop (name, file) in executables {
        text :: name.to_str() ?? return Err(io.Error.other("lease executable name is not UTF-8"))
        input := file.try_clone()
        &input.seek(io.SeekFrom.Start(0))
        hasher := StreamingSha256.new()
        buffer := [U8; 65536]{0}
        loop {
            count :: &input.read(&buffer)
            if count == 0 -> break
            &hasher.update(buffer[0..<count])
        }
        digest :: hasher.finalize().iter().map(fn(byte) -> "{byte:02x}").collect::<String>()
        &members.push(LeaseMember{name: text.to_string(), digest: "sha256-{digest}"})
    }
    Ok(^members)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2440
fn create_exec_wrappers(snapshot_root: OSPath, executables: [(OsString, fs.File)]) -> ExecWrappers? io.Error! {
    if executables.is_empty() -> return Ok(None)
    // Rust: crates/jetpack/src/Store/Reuse.rs:2548
    if selected_os() != "linux" -> return Err(io.Error.new(io.ErrorKind.Unsupported, "protected executable lease service is unavailable"))
    mountpoint :: snapshot_root.with_extension("exec-mount")
    fs.create_dir_all(mountpoint)
    unshare :: find_system_tool("unshare")
    mount :: find_system_tool("mount")
    shell :: find_system_tool("sh")
    script :: "set -eu\n\"$1\" -t tmpfs -o size=1m,mode=0755 jetpack-exec \"$2\"\nprintf 'ready\\n'\nIFS= read -r _\n\"$1\" -o remount,bind,ro \"$2\"\nprintf 'sealed\\n'\nIFS= read -r _ || true\n"
    child := Command.new(unshare).args([String]{"--user", "--map-root-user", "--mount", "--propagation", "private"})
        .arg(shell).args([String]{"-c", script, "jetpack-lease-keeper"}).arg(mount).arg(mountpoint)
        .stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn()
    input := required_child_pipe(&child.stdin.take(), "piped lease keeper stdin")
    output := io.BufReader.new(required_child_pipe(&child.stdout.take(), "piped lease keeper stdout"))
    line := ""
    &output.read_line(&line)
    if line.trim() != "ready" -> return Err(wrapper_keeper_error(^child, "creating private executable mount"))
    root :: OSPath.from("/proc/{child.id()}/root{mountpoint.display()}")
    loop (name, file) in executables -> fs.symlink(OSPath.from("/proc/self/fd/{file.as_raw_fd()}"), root.join(name))
    &input.write_all("seal\n".bytes())
    &input.flush()
    &line.clear()
    &output.read_line(&line)
    if line.trim() != "sealed" -> return Err(wrapper_keeper_error(^child, "sealing private executable mount"))
    directory :: fs.File.open(root)
    clear_close_on_exec(directory)
    descriptor_root :: OSPath.from("/proc/self/fd/{directory.as_raw_fd()}")
    drop(^input)
    status :: &child.wait()
    if !status.success() -> return Err(io.Error.other("private executable mount keeper failed"))
    fs.remove_dir(mountpoint)
    Ok(Val(ExecWrappers{root: descriptor_root, directory: ^directory}))
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2522
fn find_system_tool(name: String) -> OSPath io.Error! {
    loop directory in [String]{"/run/current-system/sw/bin", "/usr/bin", "/bin"} {
        path :: OSPath.from(directory).join(name)
        if path.is_file() -> return Ok(path)
    }
    Err(io.Error.new(io.ErrorKind.NotFound, "required system tool `{name}` not found"))
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2537
fn wrapper_keeper_error(child: ^Child, action: String) -> io.Error {
    stderr := ""
    if &child.stderr.take() == {
        .Val(pipe) -> { _ :: &pipe.read_to_string(&stderr) }
        .None -> {}
    }
    _ :: &child.wait()
    io.Error.other("{action} failed: {stderr.trim()}")
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2565
// GATE #4499: exact (U64 device,U64 inode) hardlink keys, never string-encoded.
pub fn copy_snapshot_node(src: OSPath, dst: OSPath, hardlinks: &[(U64, U64): OSPath]) -> io.Error! {
    meta :: fs.symlink_metadata(src)
    if meta.is_dir() {
        fs.create_dir_all(dst)
        entries := [fs.DirEntry]{}
        loop entry in fs.read_dir(src) -> &entries.push(entry)
        &entries.sort_by_key(fn(entry) -> entry.file_name())
        loop entry in entries -> copy_snapshot_node(entry.path(), dst.join(entry.file_name()), &hardlinks)
        fs.set_permissions(dst, meta.permissions())
    } else if meta.is_file() {
        if snapshot_file_identity(meta) == {
            .Val(key) -> {
                if hardlinks.get(key) == {
                    .Val(first) -> fs.hard_link(first, dst)
                    .None -> { _ :: fs.copy(src, dst); hardlinks[key] = dst }
                }
            }
            .None -> { _ :: fs.copy(src, dst) }
        }
        fs.set_permissions(dst, meta.permissions())
    } else if meta.file_type().is_symlink() {
        target :: fs.read_link(src)
        if selected_family() == "unix" -> fs.symlink(target, dst)
        else -> return Err(io.Error.other("cache symlink snapshots need platform support"))
    } else {
        return Err(io.Error.other("special file in cache snapshot"))
    }
    Ok(())
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2608
fn remove_snapshot_node(path: OSPath) -> io.Error! {
    metadata :: fs.symlink_metadata(path)
    make_tree_writable_for_removal(path)
    if metadata.is_dir() -> fs.remove_dir_all(path)
    else -> fs.remove_file(path)
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2619
fn snapshot_file_identity(meta: fs.Metadata) -> (U64, U64)? {
    if selected_family() == "unix" && meta.nlink() > 1 -> return Val((meta.dev(), meta.ino()))
    // Rust: crates/jetpack/src/Store/Reuse.rs:2625
    None
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2629
pub fn open_snapshot_files(root: OSPath, path: OSPath, opened: &[(OSPath, fs.File)]) -> io.Error! {
    relative :: path.strip_prefix(root) ?? return Err(io.Error.new(io.ErrorKind.InvalidInput, "snapshot path `{path.display()}` is outside snapshot root `{root.display()}`"))
    meta :: fs.symlink_metadata(path)
    if meta.file_type().is_symlink() -> return Ok(())
    if meta.is_dir() {
        loop entry in fs.read_dir(path) -> open_snapshot_files(root, entry.path(), &opened)
        return Ok(())
    }
    file :: fs.File.open(path)
    clear_close_on_exec(file)
    &opened.push((relative, ^file))
    Ok(())
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2661
fn clear_close_on_exec(file: fs.File) -> io.Error! {
    if selected_family() == "unix" {
        F_SETFD :: 2
        // GATE #4494: audited canonical variadic C fcntl; preserve errno.
        #Unsafe("clear FD_CLOEXEC on a live retained file descriptor") {
            if fcntl(file.as_raw_fd(), F_SETFD, 0) == -1 -> return Err(io.Error.last_os_error())
        }
    }
    // Rust: crates/jetpack/src/Store/Reuse.rs:2675 (non-Unix)
    Ok(())
}

// Rust: crates/jetpack/src/Store/Reuse.rs:2666
// GATE #4494: canonical C variadic fcntl ABI shared with studio_transactions.
use std.os.c.[fcntl]
// Rust: crates/jetpack/src/Store/Reuse.rs:2251
use jetpack_store.[store_reuse_canonical_nix_output_path]
