// Shared-CAS hardlink deduplication (Rust Store/Ingest.rs shared pool).
//
// Regular files in one immutable Hangar object are hardlinked with the
// machine-wide shared payload pool. Directory entries and metadata stay
// root-local; file bytes have one physical copy across independent agent
// roots. A file the pool lacks becomes the pool entry itself; a file the pool
// already holds is replaced with a hardlink to that entry. Both names carry
// the sealed mode, so neither path can write the shared inode. A filesystem
// that refuses the link gets a durable copy instead. Only the first equal file
// in each output is shared, because linking two equal files within one output
// changes its canonical archive identity.

STORE_SHARED_CAS_SEQUENCE: Shared{ProcessSequence{next: 0}}

SharedCASReport: struct {
    optimized_files: Int
    optimized_bytes: Int
}

// Hold the shared-CAS lock for the returned guard's lifetime.
store_with_shared_cas_lock: fn(roots: HangarRoots) -[FS, Env, Time]> RuntimeLock StoreError! {
    shared: roots.shared_cas_dir()
    store_ensure_real_directory(shared, "shared CAS pool")
    env_runtime_lock(shared, "shared-cas")
}

// The one key format used by every shared-CAS writer and reader:
// `<sha256 hex>-<mode without write bits, 8 hex digits>`.
store_shared_cas_key: fn(digest_hex: String, mode: Int) -> String Never! {
    "{digest_hex}-{store_hex8(store_clear_write_bits(mode))}"
}

// `mode & !0o222`.
store_clear_write_bits: fn(mode: Int) -> Int Never! { mode - ((mode).bit_and(0o222)) }

store_hex8: fn(value: Int) -> String Never! {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop index in 0..<8 {
        shift: (7 - index) * 4
        out.push(digits[((value >> shift)).bit_and(15)])
    }
    String.from_bytes(out) ?? panic("hex digits are ASCII")
}

store_share_tree_files: fn(verification: &StoreVerification, roots: HangarRoots, root: String, allow_semantic_xattrs: Bool) StoreError! -[FS, Env, Time]> {
    if allow_semantic_xattrs -> return
    shared_lock: store_with_shared_cas_lock(roots)
    store_share_tree_files_unlocked(verification, roots, root, allow_semantic_xattrs)
}

store_share_tree_files_unlocked: fn(verification: &StoreVerification, roots: HangarRoots, root: String, allow_semantic_xattrs: Bool) StoreError! -[FS, Env, Time]> {
    store_share_tree_files_unlocked_with_report(verification, roots, root, allow_semantic_xattrs)
}

store_share_tree_files_unlocked_with_report: fn(verification: &StoreVerification, roots: HangarRoots, root: String, allow_semantic_xattrs: Bool) -[FS, Env, Time]> SharedCASReport StoreError! {
    empty: SharedCASReport{optimized_files: 0, optimized_bytes: 0}
    if allow_semantic_xattrs -> return Ok(empty)
    if files.stat(root).is_symlink -> return Ok(empty)
    hangar: roots.hangar_dir()
    canonical_hangar: files.canonicalize(hangar) ?? hangar
    canonical_root: files.canonicalize(root)
    if !store_path_starts_with(canonical_root, canonical_hangar) -> return Ok(empty)
    shared: roots.shared_cas_dir()
    if store_path_starts_with(shared, canonical_root) {
        return Err(StoreError.InvalidInput("shared CAS must not be inside a Hangar output"))
    }
    store_ensure_real_directory(shared, "shared CAS pool")
    paths := [String]{}
    infos := [files.Stat]{}
    store_collect_share_candidates(canonical_root, paths, infos)
    // Digests the producer already took from these bytes are reused; the
    // rest are hashed on all workers at once.
    digests: store_content_digests(verification, paths, infos)
    used := Set<String>.new()
    report := SharedCASReport{optimized_files: 0, optimized_bytes: 0}
    touched := false
    loop index in 0..<paths.len() -> store_share_file(paths[index], infos[index], digests[index], shared, used, report, touched)
    // Linking a file into the pool leaves the object tree as it was. A swap
    // to an existing pool entry renames inside the tree, and a retried
    // publish can meet an object left writable; either needs the tree
    // resealed and made durable again. Sealing a sealed tree only reads it.
    if store_seal_tree_changed(canonical_root) -> touched = true
    if touched -> store_fsync_tree(canonical_root)
    Ok(report)
}

// Every regular file below `path`, in sorted walk order.
store_collect_share_candidates: fn(path: String, paths: &[String], infos: &[files.Stat]) StoreError! -[FS]> {
    info: files.stat(path)
    if info.is_symlink -> return
    if info.is_dir {
        entries := files.list_dir(path)
        entries.sort_by((entry: files.DirEntry) -> entry.name)
        loop entry in entries -> store_collect_share_candidates(entry.path, paths, infos)
        return
    }
    if !info.is_file -> return
    paths.push(path.copy())
    infos.push(info)
}

store_share_file: fn(path: String, info: files.Stat, digest_hex: String, shared: String, used: &Set<String>, report: &SharedCASReport, touched: &Bool) StoreError! -[FS, Env, Time]> {
    source_len: info.size
    mode: store_clear_write_bits(store_permission_identity(info))
    key: store_shared_cas_key(digest_hex, mode)
    // Preserve an existing hardlink topology. A second pass must still mark
    // the first shared occurrence as used; otherwise its equal, unshared
    // sibling could be linked in-tree.
    if info.links > 1 {
        used.add(key)
        return
    }
    if used.has(key) -> return
    used.add(key.copy())
    // The pool entry carries the key's mode, so a file still holding write
    // bits is sealed before it can become one.
    if store_permission_identity(info) != mode {
        files.set_mode(path, mode)
        touched = true
    }
    ensured: store_ensure_shared_file(shared, key, path, info, mode)
    pooled: ensured ?? return
    if !store_same_file_inode(path, pooled) {
        parent: files.dirname(path)
        parent_info: files.stat(parent)
        files.set_mode(parent, (parent_info.mode).bit_or(STORE_MODE_WRITE_BITS))
        touched = true
        replaced := true
        store_replace_with_shared_link(path, pooled) ?? {
            replaced = false
            ()
        }
        if !replaced -> return
    }
    report.optimized_files += 1
    report.optimized_bytes += source_len
}

// The pool entry for `key`: an existing equal entry, or `source_path` itself
// linked into the pool. A published object's bytes are already durable, so
// pooling by link copies and syncs nothing. A filesystem that refuses the
// link (EXDEV, EPERM) gets a durable copy instead. None when the pool can
// hold neither; the file then stays unshared.
store_ensure_shared_file: fn(shared: String, key: String, source_path: String, source: files.Stat, mode: Int) -[FS, Env, Time]> String? StoreError! {
    destination: files.join(shared, key)
    existing: files.stat(destination) ? found -> Val(found) ! error -> {
        if !store_io_is_not_found(error) -> return Err(StoreError.IO(error))
        None
    }
    if existing == .Val(pooled) {
        if pooled.is_symlink || !pooled.is_file {
            return Err(StoreError.InvalidData("shared CAS entry is not a regular file: {destination}"))
        }
        if pooled.size == source.size && store_permission_identity(pooled) == mode && store_files_equal(destination, source_path) {
            return Ok(Val(destination))
        }
        // Self-healing default: a drifted pool entry (for example one
        // rewritten through a peer hardlink) is swept aside and replaced
        // by the verified source file. Objects still hardlinked to the bad
        // inode fail their own verification.
        corrupt: files.join(shared, ".{key}.corrupt-{sys.pid()}-{store_next_shared_cas_sequence()}")
        files.rename(destination, corrupt)
        files.remove(corrupt).drop("the swept-aside pool entry is garbage")
    }
    files.hard_link(source_path, destination) ?? {
        if store_io_is_already_exists(err) -> return store_ensure_shared_file(shared, key, source_path, source, mode)
        if !store_io_link_refused(err) -> return Ok(None)
        return store_copy_shared_file(shared, key, source_path, source, mode)
    }
    Ok(Val(destination))
}

// EPERM or EXDEV: this filesystem pair cannot hardlink the object file into
// the pool, but a copy may still land there.
store_io_link_refused: fn(error: IOError) -> Bool Never! {
    if error == {
        .PermissionDenied(_) -> true
        .Other(context) -> context.os_code == Val(18)
        .InvalidInput(_) | .NotFound(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
    }
}

// Publish a durable sealed copy of `source_path` as the pool entry `key`.
store_copy_shared_file: fn(shared: String, key: String, source_path: String, source: files.Stat, mode: Int) -[FS, Env, Time]> String? StoreError! {
    destination: files.join(shared, key)
    partial: files.join(shared, ".{key}.partial-{sys.pid()}-{store_next_shared_cas_sequence()}")
    output := files.create(partial, if_exists: .Refuse)
    input := files.open(source_path)
    loop {
        chunk: input.read(65536)
        if chunk.len() == 0 -> break
        output.write_all(chunk)
    }
    output.fsync()
    files.set_mode(partial, mode)
    files.rename(partial, destination) ?? {
        failure: err
        files.remove(partial).drop("the unpublished partial is scratch")
        if store_io_is_already_exists(failure) -> return store_ensure_shared_file(shared, key, source_path, source, mode)
        return Err(StoreError.IO(failure))
    }
    Ok(Val(destination))
}

store_next_shared_cas_sequence: fn() -> Int Never! {
    process_sequence_take(STORE_SHARED_CAS_SEQUENCE)
}

store_files_equal: fn(left: String, right: String) -[FS]> Bool StoreError! {
    if files.stat(left).size != files.stat(right).size -> return Ok(false)
    left_reader := files.open(left)
    right_reader := files.open(right)
    loop {
        left_chunk: left_reader.read(65536)
        right_chunk: right_reader.read(65536)
        if left_chunk.len() != right_chunk.len() -> return Ok(false)
        if left_chunk.len() == 0 -> return Ok(true)
        if left_chunk != right_chunk -> return Ok(false)
    }
}

// Swap `path` for a hardlink to the pooled file, restoring it on failure.
store_replace_with_shared_link: fn(path: String, shared: String) StoreError! -[FS, Env]> {
    parent: files.dirname(path)
    if parent == "" -> return Err(StoreError.Other("shared CAS output has no parent"))
    name: files.basename(path)
    label: if name == "" -> "file" else -> name
    temporary: files.join(parent, ".{label}.shared-{sys.pid()}-{store_next_shared_cas_sequence()}")
    files.rename(path, temporary)
    files.hard_link(shared, path) ?? {
        failure: err
        files.rename(temporary, path).drop("restoring the original name is best-effort")
        return Err(StoreError.IO(failure))
    }
    files.remove(temporary).drop("the displaced original is scratch")
}

store_same_file_inode: fn(left: String, right: String) -[FS]> Bool Never! {
    left_info: files.stat(left) ?? return false
    right_info: files.stat(right) ?? return false
    left_info.id == right_info.id
}

store_permission_identity: fn(info: files.Stat) -> Int Never! { (info.mode).bit_and(0o7777) }

// Lowercase hex SHA-256 of one regular file, streamed through a no-follow
// handle.
store_sha256_file_hex: fn(path: String) -[FS]> String StoreError! {
    Ok(foundation_sha256_file_hex(path) ?? return Err(StoreError.IO(err)))
}
