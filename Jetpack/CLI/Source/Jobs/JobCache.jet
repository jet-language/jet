// Strict `#Job` result caching, ported from jetpack::CLI::run_enter_dev
// (D-TASK-META1=A, D-DX-JOBGRAPH1=A). A cached job's key covers the job, its
// arguments, the compiler build, the host platform, the entry and project
// inputs, the declared inputs and outputs, the environment definition and
// values, and a fingerprint of every other project file. Secret-bearing or
// Jet-state paths and variables are never cache inputs.

// Rust `{:?}` of a `Vec<String>`.
fn cli_debug_str_list(values: [String]) -> String Never! {
    quoted := [String]{}
    loop value in values -> &quoted.push(pkg_debug_str(value))
    "[{quoted.join(", ")}]"
}

// Rust `{:?}` of an `Option<JobSkip>`.
fn cli_debug_job_skip(skip: JobSkip?) -> String Never! {
    rule :: skip ?? return "None"
    if rule == {
        .Always(reason) -> "Some(Always({pkg_debug_str(reason)}))"
        .UnlessPlatform(platform) -> "Some(UnlessPlatform {{ platform: {pkg_debug_str(platform)} }})"
    }
}

// Rust `{:?}` of a `JobCachePolicy`.
fn cli_debug_job_cache(policy: JobCachePolicy) -> String Never! {
    if policy == {
        .Uncached -> "Uncached"
        .Local -> "Local"
        .Shared -> "Shared"
    }
}

fn cli_sha256_hex(bytes: [U8]) -> String Never! {
    crypto.sha256(bytes).hex()
}

// The strict job cache key (`jet-job-cache-v2`).
fn cli_task_cache_key(project_dir: String, entry: String, job: String, compiler_path: String, metadata: JobMetadata, task_args: [String], refs: [RefSpec], table: SourceTable, environment_hash: String) -[FS, Env]> String CliError! {
    identity := "jet-job-cache-v2\n{job}\n"
    identity = "{identity}compiler={@COMPILER_VERSION}\n"
    compiler_build :: foundation_sha256_file_hex(compiler_path) ?? return Err(CliError.Other("couldn't hash compiler `{compiler_path}`: {err}"))
    identity = "{identity}compiler-build={compiler_build}\n"
    identity = "{identity}platform={pkg_host_platform()}\n"
    entry_hash :: foundation_sha256_file_hex(entry) ?? return Err(CliError.Other("couldn't hash job entry: {err}"))
    identity = "{identity}{entry_hash}\n"
    identity = "{identity}args={cli_debug_str_list(task_args)}\n"
    identity = "{identity}environment={environment_hash}\n"
    identity = "{identity}packages={cli_debug_str_list(metadata.packages)}\n"
    identity = "{identity}inputs={cli_debug_str_list(metadata.inputs)}\n"
    identity = "{identity}outputs={cli_debug_str_list(metadata.outputs)}\n"
    identity = "{identity}skip={cli_debug_job_skip(metadata.skip)}\n"
    identity = "{identity}cwd={pkg_debug_opt_str(metadata.cwd)}\n"
    identity = "{identity}cache={cli_debug_job_cache(metadata.cache)}\n"
    loop limit in cli_sorted_limits(metadata.limits) -> identity = "{identity}limit={limit.key}:{limit.value}\n"
    loop reference in refs -> identity = "{identity}ref={reference.raw}\n"
    loop decl in table.declarations() -> identity = "{identity}source={decl.name}:{decl.upstream}:{decl.via.label()}\n"
    project_inputs :: [String]{@ENV_FILE, @UNIFIED_LOCK_FILE}
    loop relative in project_inputs {
        path :: files.join(project_dir, relative)
        if files.is_file(path) {
            digest :: foundation_sha256_file_hex(path) ?? return Err(CliError.Other("couldn't hash `{relative}`: {err}"))
            identity = "{identity}project-input={relative}:{digest}\n"
        }
    }
    if metadata.inputs.len() == 0 -> identity = "{identity}inputs=<none>\n"
    loop input in metadata.inputs {
        path :: cli_job_path(project_dir, Val(input), "input", false)
        info :: files.stat(path) ?? return Err(CliError.Other("couldn't inspect job input `{input}`: {err}"))
        if info.is_symlink -> return Err(CliError.Other("job input `{input}` may not be a symlink"))
        if !info.is_dir && !info.is_file -> return Err(CliError.Other("job input `{input}` is not a regular file or directory"))
        digest := ""
        if info.is_dir {
            digest = foundation_tree_hash(path)
        } else {
            digest = foundation_sha256_file_hex(path) ?? return Err(CliError.Other("couldn't hash job input `{input}`: {err}"))
        }
        identity = "{identity}input={input}:{digest}\n"
    }
    loop output in metadata.outputs {
        path :: cli_job_path(project_dir, Val(output), "output", true)
        identity = "{identity}output={output}:{path}\n"
    }
    if metadata.cache != JobCachePolicy.Uncached {
        identity = "{identity}project-scope={cli_task_project_scope_fingerprint(project_dir, metadata)}\n"
    }
    Ok(cli_sha256_hex(identity.bytes()))
}

// Job limits in key order (the Rust `BTreeMap` iteration).
fn cli_sorted_limits(limits: [StringMapEntry]) -> [StringMapEntry] Never! {
    sorted := limits
    &sorted.sort_by((left: StringMapEntry, right: StringMapEntry) -> left.key <=> right.key)
    sorted
}

fn cli_task_environment_hash_with_env(refs: [RefSpec], table: SourceTable, secrets: [SecretSpec], facts: EnvironmentFacts, env: ShellEnv) -> String Never! {
    cli_task_environment_hash_with_vars(refs, table, secrets, facts, env.vars)
}

// The job's environment identity: the trust definition hash plus the active
// environment, its provenance and source files, and a digest of every
// composed variable value in name order.
fn cli_task_environment_hash_with_vars(refs: [RefSpec], table: SourceTable, secrets: [SecretSpec], facts: EnvironmentFacts, vars: [String: String]) -> String Never! {
    identity := trust_environment_definition_hash(refs, table, secrets, facts)
    identity = "{identity}\njob-active-environment\n{facts.active_environment ?? "<none>"}\n"
    loop contributor in facts.active_environment_provenance -> identity = "{identity}provenance={contributor}\n"
    identity = "{identity}job-source-files\n"
    loop source in facts.source_files -> identity = "{identity}{source}\n"
    identity = "{identity}job-environment-values\n"
    names := vars.keys().to_list()
    &names.sort()
    loop name in names -> identity = "{identity}{name}={cli_sha256_hex((vars.get(name) ?? "").bytes())}\n"
    cli_sha256_hex(identity.bytes())
}

// A strict cached job declares at least one input, keeps inputs and outputs
// out of secret-bearing or Jet state, and never overlaps an input with an
// output.
fn cli_validate_cached_job_metadata(project_dir: String, metadata: JobMetadata) CliError! -[FS, Env]> {
    if metadata.cache == JobCachePolicy.Uncached -> return Ok()
    if metadata.inputs.len() == 0 {
        return Err(CliError.Other("strict cached jobs must declare at least one project input; undeclared reads cannot be proven safe"))
    }
    outputs := [(name: String, path: String)]{}
    loop output in metadata.outputs {
        cli_reject_cache_sensitive_path(output, "output")
        path :: cli_job_path(project_dir, Val(output), "output", true)
        cli_reject_cache_sensitive_resolved_path(project_dir, path, output, "output")
        &outputs.push((name: output, path: path))
    }
    inputs := [(name: String, path: String)]{}
    loop input in metadata.inputs {
        cli_reject_cache_sensitive_path(input, "input")
        path :: cli_job_path(project_dir, Val(input), "input", true)
        cli_reject_cache_sensitive_resolved_path(project_dir, path, input, "input")
        cli_reject_cache_sensitive_descendants(path, input, "input")
        &inputs.push((name: input, path: path))
    }
    loop output in outputs {
        loop input in inputs {
            if input.path == output.path || cli_path_starts_with(input.path, output.path) || cli_path_starts_with(output.path, input.path) {
                return Err(CliError.Other("cached job input `{input.name}` overlaps output `{output.name}`"))
            }
        }
    }
    loop input in inputs {
        if !files.exists(input.path) -> return Err(CliError.Other("job input `{input.name}` does not exist"))
    }
    Ok()
}

// Secret values are never cache inputs.
fn cli_validate_cached_job_environment(plan: RunPlan, env: ShellEnv) CliError! {
    if plan.secrets.len() > 0 {
        return Err(CliError.Other("strict cached jobs cannot use declared secrets; secret values are never cache inputs"))
    }
    loop dotenv in plan.environment.lifecycle.dotenv {
        if dotenv.secrets.len() > 0 -> return Err(CliError.Other("strict cached jobs cannot use secret dotenv variables from `{dotenv.file}`"))
    }
    names := env.vars.keys().to_list()
    &names.sort()
    loop name in names {
        if cli_is_sensitive_environment_name(name) -> return Err(CliError.Other("strict cached jobs cannot use secret-bearing environment variable `{name}`"))
    }
    Ok()
}

fn cli_reject_cache_sensitive_path(relative: String, field: String) CliError! {
    if cli_is_cache_sensitive_path(relative) -> return Err(CliError.Other("cached job {field} `{relative}` is secret-bearing or Jet state"))
    Ok()
}

fn cli_reject_cache_sensitive_resolved_path(project_dir: String, path: String, declared: String, field: String) CliError! -[FS, Env]> {
    root :: files.canonicalize(project_dir) ?? return Err(CliError.Other("couldn't resolve cached job project root: {err}"))
    if !cli_path_starts_with(path, root) -> return Err(CliError.Other("cached job {field} `{declared}` escapes the project"))
    relative :: path.removeprefix(root).removeprefix("/")
    if cli_is_cache_sensitive_path(relative) {
        return Err(CliError.Other("cached job {field} `{declared}` resolves into secret-bearing or Jet state `{relative}`"))
    }
    Ok()
}

fn cli_reject_cache_sensitive_descendants(root: String, relative: String, field: String) CliError! -[FS]> {
    if !files.is_dir(root) -> return Ok()
    entries :: files.list_dir(root) ?? return Err(CliError.Other("couldn't inspect cached job {field} `{relative}`: {err}"))
    loop item in entries {
        child :: files.join(relative, item.name)
        if cli_is_cache_sensitive_path(child) {
            return Err(CliError.Other("cached job {field} `{relative}` contains secret-bearing or Jet state `{child}`"))
        }
        info :: files.stat(item.path) ?? return Err(CliError.Other("{err}"))
        if info.is_symlink -> return Err(CliError.Other("strict cached job {field} `{relative}` contains unsupported symlink `{child}`"))
        if info.is_dir -> cli_reject_cache_sensitive_descendants(item.path, child, field)
    }
    Ok()
}

// A digest of every project file outside declared outputs, `.git`,
// `target`, and secret-bearing or Jet state, so an unlisted file change
// invalidates the strict key (`jet-job-project-scope-v1`).
fn cli_task_project_scope_fingerprint(project_dir: String, metadata: JobMetadata) -[FS]> String CliError! {
    found := [(path: String, digest: String)]{}
    cli_collect_job_scope_files(project_dir, project_dir, metadata, &found)
    &found.sort_by((left: (path: String, digest: String), right: (path: String, digest: String)) -> left.path <=> right.path)
    identity := "jet-job-project-scope-v1\n"
    loop file in found -> identity = "{identity}{file.path}={file.digest}\n"
    Ok(cli_sha256_hex(identity.bytes()))
}

fn cli_collect_job_scope_files(root: String, directory: String, metadata: JobMetadata, found: &[(path: String, digest: String)]) CliError! -[FS]> {
    entries :: files.list_dir(directory) ?? return Err(CliError.Other("couldn't read job cache scope `{directory}`: {err}"))
    loop item in entries {
        relative :: item.path.removeprefix(root).removeprefix("/")
        first :: relative.split("/").to_list()[0]
        if cli_is_cache_sensitive_path(relative) || first == ".git" || first == "target" -> next
        if cli_path_covered(relative, metadata.outputs) -> next
        info :: files.stat(item.path) ?? return Err(CliError.Other("{err}"))
        if {
            info.is_symlink -> return Err(CliError.Other("strict cached job scope contains unsupported symlink `{relative}`"))
            info.is_dir -> cli_collect_job_scope_files(root, item.path, metadata, found)
            info.is_file -> {
                digest :: foundation_sha256_file_hex(item.path) ?? return Err(CliError.Other("couldn't hash job scope `{relative}`: {err}"))
                &found.push((path: relative.replace("\\", "/"), digest: digest))
            }
            else -> {}
        }
    }
    Ok()
}

fn cli_is_cache_sensitive_path(relative: String) -> Bool Never! {
    loop component in relative.split("/") {
        if component == "" || component == "." || component == ".." -> next
        if cli_is_cache_sensitive_component(component) -> return true
    }
    false
}

// `.jet`, `.env`, `.env.*`, and any name mentioning a secret, credential,
// token, or password.
fn cli_is_cache_sensitive_component(name: String) -> Bool Never! {
    lowered :: name.to_ascii_lower()
    if lowered == ".jet" || lowered == ".env" || lowered.starts_with(".env.") -> return true
    words :: [String]{"secret", "credential", "token", "password"}
    loop word in words {
        if lowered.contains(word) -> return true
    }
    false
}

// A variable whose `_`/`-`/`.` separated words include a secret-bearing word.
fn cli_is_sensitive_environment_name(name: String) -> Bool Never! {
    lowered :: name.to_ascii_lower().replace("-", "_").replace(".", "_")
    loop part in lowered.split("_") {
        if cli_is_secret_word(part) -> return true
    }
    false
}

fn cli_is_secret_word(word: String) -> Bool Never! {
    if word == {
        "secret" | "secrets" | "credential" | "credentials" | "token" | "tokens" | "password" | "passwords" | "key" | "keys" -> true
        else -> false
    }
}

// `<project>/.jet/jobs/<key>.done` for `.Local`, `<root>/jobs/<key>.done`
// for `.Shared`.
fn cli_job_cache_path(project_dir: String, roots: HangarRoots, metadata: JobMetadata, key: String) -> String Never! {
    if metadata.cache == {
        .Local -> files.join(files.join(files.join(project_dir, @SOURCE_ROOT_DIR), "jobs"), "{key}.done")
        .Shared -> files.join(files.join(roots.root, "jobs"), "{key}.done")
        .Uncached -> ""
    }
}

fn cli_job_outputs_exist(project_dir: String, metadata: JobMetadata) -[FS, Env]> Bool Never! {
    loop output in metadata.outputs {
        if cli_job_path(project_dir, Val(output), "output", false) == {
            .Ok(_) -> {}
            .Err(_) -> return false
        }
    }
    true
}

fn cli_task_cache_hit(project_dir: String, roots: HangarRoots, metadata: JobMetadata, key: String) -[FS, Env]> Bool Never! {
    if metadata.cache == JobCachePolicy.Uncached || !cli_job_outputs_exist(project_dir, metadata) -> return false
    recorded :: files.read(cli_job_cache_path(project_dir, roots, metadata, key)) ?? return false
    recorded.trim() == key
}

// Record a finished strict job: write a temporary, then rename it over the
// record.
fn cli_write_job_cache(project_dir: String, roots: HangarRoots, metadata: JobMetadata, key: String) CliError! -[FS, Env]> {
    path :: cli_job_cache_path(project_dir, roots, metadata, key)
    parent :: files.dirname(path)
    if parent == "" -> return Err(CliError.Other("job cache has no parent directory"))
    files.create_dir_all(parent) ?? return Err(CliError.Other("{err}"))
    temporary :: files.join(parent, ".{key}.{sys.pid()}.tmp")
    files.write(temporary, "{key}\n") ?? return Err(CliError.Other("{err}"))
    files.rename(temporary, path) ?? return Err(CliError.Other("{err}"))
    Ok()
}
