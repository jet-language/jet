// Rust crates/jetpack/src/CLI/bridge_os_studio.rs cmd_os: `jet os <verb>
// <target>` hands the first positional as the jetos verb and the rest as its
// arguments to the JetOS dispatcher.
cli_cmd_os: fn(theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Time.Wait]> Int Never! {
    flags: JetOSFlags{
        fixtures: parsed.flags.fixtures,
        offline: parsed.flags.offline,
        name: parsed.flags.name,
        manual_disk: None,
        disk: None,
        json: parsed.flags.json,
        assume_yes: parsed.flags.assume_yes,
        trust: parsed.flags.trust,
        host: None,
        real_tier: false,
    }
    jetos_main(theme, parsed.positional.get(0), cli_tail(parsed.positional, 1), flags)
}
