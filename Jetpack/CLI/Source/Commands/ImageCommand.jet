// `jetpack image <name> [--push <ref>]` (Rust
// jetpack::CLI::add_remove_push_image::cmd_image, D-JPK-IMAGE1=A /
// D-ENV-IMAGE1): build a declared `.Oci` image into a native OCI layout from
// the project build output or verified Hangar package outputs, with a
// service supervisor and an explicit projection report, then optionally copy
// or publish it.

// Where `--push` sends the built layout.
pub enum ImagePushDestination {
    Local(String)
    Registry(String)
}

// The projection record of an integration whose secret-bearing facts stay
// out of the image.
fn cli_record_omitted_secret_integration_projection(projection: &ProjectionReport, integration: EnvironmentIntegration) Never! {
    prefix :: "integration:{integration.kind.as_str()}"
    &projection.omitted.push("{prefix}:activation")
    loop task_name in integration.tasks -> &projection.omitted.push("{prefix}:task:{task_name}")
    loop provider in integration.providers -> &projection.omitted.push("{prefix}:provider:{provider}")
    loop grant in integration.grants -> &projection.omitted.push("{prefix}:grant:{grant}")
    loop host_check in integration.host_checks -> &projection.omitted.push("{prefix}:host-check:{host_check}")
    if integration.options.len() > 0 {
        keys := integration.options.keys().to_list()
        &keys.sort()
        &projection.omitted.push("{prefix}:option-keys={keys.join(",")}")
    }
    if integration.secrets.len() > 0 -> &projection.omitted.push("{prefix}:secret-refs={integration.secrets.len()}")
}

// The declared images, for a refusal's Why text.
fn cli_declared_images(plan: EnvPlan) -> String Never! {
    if plan.images.len() == 0 -> return "no `image.<name>` is declared in {ENV_FILE}."
    names := [String]{}
    loop image in plan.images -> &names.push(image.name)
    "declared images: {names.join(", ")}."
}

fn cli_render_env_diagnostic(src: String, error: EnvModelEvalError) Never! -[IO, Time.Wait]> {
    terminal_write_output(diagnostics_render_all(ENV_FILE, src, [Diagnostic]{error.diagnostic}))
}

pub fn cli_cmd_image(verification: &StoreVerification, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    dir :: cli_current_dir()
    src :: files.read(EnvFile.path_in(dir)) ?? {
        theme.error("no image here", "there is no {ENV_FILE} declaring any `image.<name>`.", "declare `module image.<name> {{ kind: .Oci, from: packages.<name> }}`, then `jet image <name>`.")
        return EXIT_USAGE
    }
    declared_plan :: envmodel_evaluate_env(src, dir) ?? {
        cli_render_env_diagnostic(src, err)
        return EXIT_USAGE
    }
    name :: parsed.positional.get(0) ?? {
        theme.error("build which image?", cli_declared_images(declared_plan), "name an image: `jet image <name>`.")
        return EXIT_USAGE
    }
    found := ImagePlan?{None}
    loop candidate in declared_plan.images {
        if candidate.name == name && found == None -> found = Val(candidate)
    }
    image :: found ?? {
        theme.error("no image `{name}`", cli_declared_images(declared_plan), "declare `module image.<name> {{ … }}`, or build an existing image.")
        return EXIT_USAGE
    }
    // An image names its environment explicitly; never silently project the
    // beginner-default `dev` environment when the record says `env.full`.
    plan := declared_plan
    if image.from_environment {
        plan = envmodel_evaluate_env_with_environment(src, dir, Val(image.from)) ?? {
            cli_render_env_diagnostic(src, err)
            return EXIT_USAGE
        }
    }
    push_destination :: cli_image_push_destination(theme, name, parsed.flags.push) ?? return EXIT_USAGE
    base_directory :: cli_image_base_directory(theme, dir, image.base) ?? return EXIT_USAGE
    // Non-environment package images consume the project-local
    // `.jet/build/<name>` output; environment images consume verified
    // Hangar package outputs instead.
    project_root :: driver_selected_project_root(dir) ?? {
        theme.error("couldn't resolve the image project root", "{err.what}: {err.why}", "repair the package/workspace authority and retry the image build")
        return EXIT_USAGE
    }
    roots :: pkg_resolve_roots()
    out_dir :: files.join(files.join(files.join(project_root, ".jet"), "images"), name)
    projection := ProjectionReport.empty()
    if !image.from_environment && image.services.len() > 0 {
        &projection.rejected.push("services")
        cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
        theme.error_coded("E1336", "package image {name} cannot project services", "services is an environment projection field, not a package-image input", "use `from: env.<name>` for a supervised environment image, or remove `services:`")
        return EXIT_USAGE
    }
    if image.from_environment && image.services.len() == 0 && plan.dev_services.len() > 0 {
        &projection.rejected.push("services")
        if cli_write_rejected_projection(out_dir, projection) == {
            .Err(error) -> theme.error("couldn't write image {name} rejection projection", error.message(), "check that the image output directory is writable.")
            .Ok(_) -> {}
        }
        quoted := [String]{}
        loop service in plan.dev_services -> &quoted.push("\"{service.name}\"")
        theme.error_coded("E1336", "environment image {name} cannot project services", "the environment declares services but the image does not select them; Jet will not silently omit supervised service facts", "add `services: [{quoted.join(", ")}]` to the image, or remove the service from the environment")
        return EXIT_USAGE
    }
    image_platform :: image.target ?? "linux.x64"
    if image.from_environment {
        loop integration in plan.integrations {
            if integration.validate_target(image_platform) == {
                .Err(error) -> {
                    &projection.rejected.push("integration:{integration.kind.as_str()}:host")
                    cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
                    theme.error_coded("E1333", "environment image {name} cannot project this integration", error.message, "choose a matching image target or remove the integration from the environment")
                    return EXIT_USAGE
                }
                .Ok(_) -> {}
            }
        }
        loop language in plan.language_projections {
            if !language.selection.enable -> next
            unsupported :: if {
                language.license.trim() == "" -> Val("language pack `{language.pack.name}` has no license fact")
                language.missing_tools.len() > 0 -> Val("language pack `{language.pack.name}` is missing required tools: {language.missing_tools.join(", ")}")
                !cli_hangar_platform_matches(image_platform, language.platform) -> Val("language pack `{language.pack.name}` targets `{language.platform}`, but the image targets `{image_platform}`")
                else -> None
            }
            if unsupported == .Val(error) {
                &projection.rejected.push("language:{language.pack.name}:facts")
                cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
                theme.error_coded("E1333", "environment image {name} cannot project this language pack", error, "choose a supported language pack and image target with an admitted license and complete tool mapping")
                return EXIT_USAGE
            }
        }
    }
    layer_files := [LayerFile]{}
    if image.from_environment {
        layer_files = cli_environment_image_files(&verification, theme, roots, plan, name, image_platform, &projection)
    } else {
        build_dir :: files.join(files.join(project_root, ".jet"), "build")
        bin_data :: cli_read_project_image_file(build_dir, image.from) ?? {
            theme.error("{image.from} isn't built yet", "jet image {name} needs {image.from} already built at {files.join(build_dir, image.from)}.", "run jet build first, then jet image {name}")
            return EXIT_USAGE
        }
        &layer_files.push(LayerFile{path: "usr/local/bin/{image.from}", data: bin_data, mode: 493})
    }
    if image.from_environment {
        cli_record_environment_projection(&projection, plan)
    } else {
        &projection.included.push("package:{image.from}")
    }
    loop env_var in image.env_vars -> &projection.changed.push("env:{env_var.key}")
    if image.expose.len() > 0 -> &projection.changed.push("expose")
    if image.target == .Val(target) -> &projection.changed.push("platform:{target}")
    if image.base != None -> &projection.changed.push("base")
    if image.user != None -> &projection.changed.push("user")
    if image.health != None -> &projection.changed.push("health")
    if image.entrypoint != None -> &projection.changed.push("entrypoint")
    if layer_files.len() == 0 {
        &projection.rejected.push("environment.package-output")
        if cli_write_rejected_projection(out_dir, projection) == {
            .Err(error) -> theme.error("couldn't write image {name} rejection projection", error.message(), "check that the image output directory is writable.")
            .Ok(_) -> {}
        }
        return EXIT_USAGE
    }
    loop relative in image.files {
        extra :: cli_image_extra_file(theme, name, dir, plan, image.from_environment, relative, layer_files, &projection, out_dir) ?? return EXIT_USAGE
        &layer_files.push(extra)
    }
    services := ImageServiceProjection{commands: [[String]]{}, names: [String]{}}
    if image.from_environment {
        services = cli_image_service_commands(plan, image, layer_files) ?? {
            &projection.rejected.push("services")
            cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
            theme.error_coded("E1336", "environment image {name} cannot supervise its services", err.message(), "give each selected service a projected executable and a supported foreground run command")
            return EXIT_USAGE
        }
    }
    if services.commands.len() > 0 {
        if image.from_environment && cli_image_layer_path_conflicts(layer_files, "jet/supervise") {
            conflicting_path := "jet/supervise"
            loop file in layer_files {
                if cli_image_layer_path_conflicts([LayerFile]{file}, "jet/supervise") {
                    conflicting_path = file.path
                    break
                }
            }
            kept := [String]{}
            loop fact in projection.included {
                if fact != "file:{conflicting_path}" -> &kept.push(fact)
            }
            projection.included = kept
            &projection.rejected.push("file:{conflicting_path}")
            cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
            theme.error_coded("E1336", "environment image {name} cannot project extra file `{conflicting_path}`", "the extra file conflicts with the generated service supervisor", "choose an extra file path that does not replace a service projection")
            return EXIT_USAGE
        }
        &layer_files.push(LayerFile{path: "jet/supervise", data: cli_supervisor_script(services.commands).bytes(), mode: 493})
        &projection.included.push("services:jet/supervise")
        &projection.changed.push("services:{services.names.join(",")}")
        loop service in plan.dev_services {
            if !services.names.contains(service.name) {
                &projection.omitted.push("service:{service.name}")
                next
            }
            &projection.included.push("service:{service.name}")
            if service.after.len() > 0 -> &projection.changed.push("service:{service.name}:after={services_dependency_names(service).join(",")}")
            if service.ports.len() == 0 {
                &projection.omitted.push("service:{service.name}:ports-default")
            } else {
                &projection.changed.push("service:{service.name}:ports")
            }
        }
    }
    entrypoint :: image.entrypoint ?? cli_image_default_entrypoint(image, services.commands.len() > 0)
    spec :: OCIBuildSpec{
        files: layer_files,
        platform: image_platform,
        entrypoint: [String]{entrypoint},
        env: image.env_vars,
        expose: image.expose,
        user: image.user ?? 10001,
        healthcheck: image.health,
    }
    layer_paths := [String]{}
    loop file in spec.files -> &layer_paths.push(file.path)
    env_keys := [String]{}
    loop env_var in image.env_vars -> &env_keys.push(env_var.key)
    projection_plan :: ProjectionPlan{
        source: if image.from_environment -> "env:{image.from}" else -> "package:{image.from}",
        platform: spec.platform,
        entrypoint: spec.entrypoint,
        user: spec.user,
        expose: spec.expose,
        healthcheck: spec.healthcheck != None,
        env_keys: env_keys,
        layer_paths: layer_paths,
        services: services.names,
        base: image.base != None,
        lock: if pkg_lock_load(dir) != None -> "present" else -> "absent",
    }
    built :: image_build_with_base(spec, out_dir, name, base_directory.path) ?? {
        theme.error("couldn't build image `{name}`", err.message(), "check that the output directory is writable.")
        return EXIT_USAGE
    }
    artifacts :: if image.from_environment -> image_write_projection_artifacts(out_dir, built.manifest_digest, projection_plan, projection) else -> image_write_projection_report(out_dir, built.manifest_digest, projection)
    if artifacts == .Err(error) {
        theme.error("couldn't write image {name} projection", error.message(), "check that the image output directory is writable.")
        return EXIT_USAGE
    }
    if push_destination.destination == {
        .Val(destination) -> {
            if destination == {
                .Local(path) -> {
                    if image_copy_layout(out_dir, path) == .Err(error) {
                        theme.error("couldn't copy image {name} to {path}", error.message(), "choose an empty or byte-identical local OCI layout destination.")
                        return EXIT_USAGE
                    }
                }
                .Registry(reference) -> {
                    report :: image_push_registry(out_dir, reference) ?? {
                        theme.error("couldn't publish image {name}", err.message(), "check the registry URL and its host-configured credentials.")
                        return EXIT_USAGE
                    }
                    theme.detail("published {report.reference} ({report.blobs_uploaded} new blobs, {report.bytes_uploaded} bytes)")
                }
            }
        }
        .None -> {}
    }
    theme.ok("built image `{name}` -> {out_dir} ({built.manifest_digest})")
    EXIT_OK
}

// The resolved `--push` destination (None without `--push`); a refused
// reference is rendered and returns None from the outer optional.
pub struct ImagePushChoice {
    pub destination: ImagePushDestination?
}

fn cli_image_push_destination(theme: Theme, name: String, push: String?) -[IO, Time.Wait]> ImagePushChoice? Never! {
    reference :: push ?? return Val(ImagePushChoice{destination: None})
    if reference.starts_with("https://") || reference.starts_with("http://") -> return Val(ImagePushChoice{destination: Val(ImagePushDestination.Registry(reference))})
    if reference.starts_with("oci://") {
        theme.error_coded("E1268", "OCI reference {reference} needs an HTTP registry URL", "the native registry transport accepts an explicit http:// or https:// registry reference.", "use --push https://registry.example/repository:tag, or use file:///... for a local layout.")
        return None
    }
    if cli_looks_like_registry_reference(reference) {
        theme.error_coded("E1268", "`jet image {name}` cannot push remote OCI reference `{reference}`", "remote registry TLS/transport requires an explicit verified HTTP(S) endpoint; Jet never treats a registry name as a local path.", "use `--push https://registry.example/repository:tag` for the configured transport, or `--push file:///path/to/layout` for a local copy.")
        return None
    }
    path :: if reference.starts_with("file://") -> reference.removeprefix("file://") else -> reference
    Val(ImagePushChoice{destination: Val(ImagePushDestination.Local(path))})
}

// The verified local base layout directory (None path without `base:`); a
// refused base is rendered and returns None from the outer optional.
pub struct ImageBaseChoice {
    pub path: String?
}

fn cli_image_base_directory(theme: Theme, dir: String, base: String?) -[IO, FS, Time.Wait]> ImageBaseChoice? Never! {
    reference :: base ?? return Val(ImageBaseChoice{path: None})
    if reference.starts_with("https://") || reference.starts_with("http://") {
        theme.error_coded("E1268", "base OCI reference `{reference}` needs a verified local copy", "remote base pulls require registry transport and digest admission before their layers can become image input.", "copy the base into a local OCI layout and use `base: oci(\"file:///path/to/layout\")`.")
        return None
    }
    path := ""
    if reference.starts_with("file://") {
        path = reference.removeprefix("file://")
    } else {
        escapes := files.is_absolute(reference)
        loop part in reference.split("/") {
            if part == ".." -> escapes = true
        }
        if escapes {
            theme.error("base OCI layout `{reference}` escapes the project", "a project-relative base must stay inside the project root.", "use a safe relative layout path or an explicit file:/// absolute path.")
            return None
        }
        path = files.join(dir, reference)
    }
    if !files.is_dir(path) {
        theme.error("base OCI layout `{path}` does not exist", "a base image must be a verified local OCI image layout.", "use `file:///...` or a project-relative OCI layout directory.")
        return None
    }
    Val(ImageBaseChoice{path: Val(path)})
}

// The projection facts of an environment image: what the image includes,
// changes, and omits relative to the environment.
fn cli_record_environment_projection(projection: &ProjectionReport, plan: EnvPlan) Never! {
    loop value in plan.package_refs -> &projection.included.push("package:{value}")
    &projection.included.push("environment:shell")
    &projection.changed.push("from:environment")
    if plan.secrets.len() > 0 -> &projection.omitted.push("environment.secrets")
    if plan.source_files.len() > 0 -> &projection.omitted.push("environment.source-files")
    if plan.environment_reads.len() > 0 -> &projection.omitted.push("environment.reads")
    if plan.adapters.len() > 0 -> &projection.omitted.push("environment.adapters")
    if plan.prompt != None -> &projection.omitted.push("environment.prompt")
    if plan.package_profiles.len() > 0 -> &projection.omitted.push("environment.package-profiles")
    lifecycle :: plan.lifecycle
    if lifecycle.dotenv.len() > 0 || lifecycle.unset.len() > 0 || lifecycle.on_enter.len() > 0 || lifecycle.checks.len() > 0 || lifecycle.git_hooks_path != None || lifecycle.reload_explicit {
        &projection.omitted.push("environment.lifecycle")
    }
    if plan.files.len() > 0 -> &projection.omitted.push("environment.managed-files")
    if plan.integrations.len() > 0 -> &projection.omitted.push("environment.integrations")
    loop integration in plan.integrations {
        if integration.kind == IntegrationKind.CloudCredentials || integration.kind == IntegrationKind.Vault {
            cli_record_omitted_secret_integration_projection(&projection, integration)
        }
    }
    loop language in plan.language_projections {
        prefix :: "language:{language.selection.name}"
        &projection.changed.push("{prefix}:pack={language.pack.fingerprint()}")
        loop fact in language.included -> &projection.included.push("{prefix}:included:{fact}")
        loop fact in language.changed -> &projection.changed.push("{prefix}:changed:{fact}")
        loop fact in language.omitted -> &projection.omitted.push("{prefix}:omitted:{fact}")
    }
    if plan.presets.len() > 0 -> &projection.omitted.push("environment.presets")
}

// One extra `files:` entry as a layer file; a refusal is recorded, rendered,
// and returns None.
fn cli_image_extra_file(theme: Theme, name: String, dir: String, plan: EnvPlan, from_environment: Bool, relative: String, layer_files: [LayerFile], projection: &ProjectionReport, out_dir: String) -[IO, FS, Env, Time.Wait, Rand]> LayerFile? Never! {
    if from_environment {
        if cli_environment_image_file_rejection(plan, relative) == .Val(error) {
            &projection.rejected.push("file:{relative}")
            cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
            theme.error_coded("E1336", "environment image {name} cannot project extra file `{relative}`", error, "choose a regular, project-relative, non-secret file that is not an environment input")
            return None
        }
    }
    layer_path :: cli_normalize_project_relative_image_path(relative) ?? {
        cli_reject_image_file(theme, name, from_environment, relative, err.message(), &projection, out_dir, "use a regular, project-relative, non-secret file that stays inside the project root", "use a regular project-relative file that stays inside the project root.")
        return None
    }
    data :: cli_read_project_image_file(dir, layer_path) ?? {
        cli_reject_image_file(theme, name, from_environment, relative, err.message(), &projection, out_dir, "use a regular project-relative, non-secret file that stays inside the project root", "use a regular project-relative file that stays inside the project root.")
        return None
    }
    if from_environment && cli_image_layer_path_conflicts(layer_files, layer_path) {
        &projection.rejected.push("file:{layer_path}")
        cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
        theme.error_coded("E1336", "environment image {name} cannot project extra file `{relative}`", "the extra file conflicts with another projected image path", "choose an extra file path that does not replace a package, shell, or service projection")
        return None
    }
    &projection.included.push("file:{layer_path}")
    Val(LayerFile{path: layer_path, data: data, mode: 420})
}

fn cli_reject_image_file(theme: Theme, name: String, from_environment: Bool, relative: String, error: String, projection: &ProjectionReport, out_dir: String, environment_fix: String, package_fix: String) Never! -[IO, FS, Env, Time.Wait, Rand]> {
    &projection.rejected.push("file:{relative}")
    cli_write_rejected_projection(out_dir, projection).drop("the rejection projection is best-effort")
    if from_environment {
        theme.error_coded("E1336", "environment image {name} cannot project extra file `{relative}`", error, environment_fix)
    } else {
        theme.error("image file {relative} cannot be projected", error, package_fix)
    }
}

fn cli_image_default_entrypoint(image: ImagePlan, supervised: Bool) -> String Never! {
    if supervised -> return "/jet/supervise"
    if image.from_environment -> return "/bin/sh"
    "/usr/local/bin/{image.from}"
}

// A registry-looking reference (`localhost/...` or a dotted authority).
fn cli_looks_like_registry_reference(reference: String) -> Bool Never! {
    authority :: reference.split("/").to_list().get(0) ?? ""
    authority == "localhost" || authority.contains(".")
}

// A safe project-relative image path, normalized to `a/b/c`.
fn cli_normalize_project_relative_image_path(relative: String) -> String CLIError! {
    unsafe_path :: CLIError.InvalidData("image files must be safe project-relative paths")
    if relative == "" || relative.contains("\\") || pkg_text_has_control(relative) || files.is_absolute(relative) -> return Err(unsafe_path)
    components := [String]{}
    loop part in relative.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(unsafe_path)
        &components.push(part)
    }
    if components.len() == 0 -> return Err(CLIError.InvalidData("image files must name a regular project file"))
    normalized :: components.join("/")
    if normalized.len() > 100 -> return Err(CLIError.InvalidData("image file path exceeds the OCI tar path limit"))
    Ok(normalized)
}

fn cli_image_layer_path_conflicts(layer_files: [LayerFile], candidate: String) -> Bool Never! {
    loop file in layer_files {
        if file.path == candidate || candidate.starts_with("{file.path}/") || file.path.starts_with("{candidate}/") -> return true
    }
    false
}

// The bytes of a regular project file read without following links.
fn cli_read_project_image_file(root: String, relative: String) -[FS]> [U8] CLIError! {
    normalized :: cli_normalize_project_relative_image_path(relative)
    if foundation_read_file_nofollow_at_root(root, normalized, MAX_TREE_FILE_BYTES) == {
        .Ok(bytes) -> Ok(bytes)
        .Err(error) -> {
            detail :: "{error}"
            if detail.contains("hard link") -> return Err(CLIError.InvalidData("image file must not be a hard link to another project path"))
            if detail.contains("symlink") || detail.contains("regular file") || detail.contains("not a directory") -> return Err(CLIError.InvalidData("image file must be a regular file, not a symlink or directory"))
            Err(CLIError.InvalidData(detail))
        }
    }
}

// The supervised services of an environment image in dependency order, as
// their foreground run commands and names.
pub struct ImageServiceProjection {
    pub commands: [[String]]
    pub names: [String]
}

fn cli_image_service_commands(plan: EnvPlan, image: ImagePlan, layer_files: [LayerFile]) -> ImageServiceProjection CLIError! {
    selected := [DevServicePlan]{}
    names := [String]{}
    visiting := [String]{}
    loop service_name in image.services -> cli_collect_image_service(service_name, plan.dev_services, &selected, &names, &visiting)
    order :: services_dependency_order(selected) ?? return Err(CLIError.InvalidData(err.message))
    commands := [[String]]{}
    loop index in order {
        service :: selected[index]
        if service.ready != None || service.ready_probe != None || service.restart != None || service.shutdown != None || service.data_dir != None || service.watch.len() > 0 || service.before_start.len() > 0 || service.sockets.len() > 0 || services_unknown_field(service) != None {
            return Err(CLIError.InvalidData("service {service.name} declares runtime policy that the OCI supervisor cannot carry"))
        }
        command := services_image_run_command(service) ?? return Err(CLIError.InvalidData(err.message))
        loop argument in command {
            if pkg_text_has_control(argument) -> return Err(CLIError.InvalidData("service {service.name} has a command argument with a control character"))
        }
        executable :: command.get(0) ?? return Err(CLIError.InvalidData("service {service.name} has an empty run command"))
        path :: cli_image_service_executable(service.name, executable)
        layer_path :: path.removeprefix("/")
        present := false
        loop file in layer_files {
            if file.path == layer_path -> present = true
        }
        if !present -> return Err(CLIError.InvalidData("service {service.name} executable {executable} is not a projected package"))
        command[0] = path
        &commands.push(command)
    }
    if commands.len() > 0 {
        has_sleep := false
        loop file in layer_files {
            if file.path == "usr/local/bin/sleep" -> has_sleep = true
        }
        if !has_sleep -> return Err(CLIError.InvalidData("the OCI supervisor requires a projected `sleep` executable to monitor services"))
    }
    Ok(ImageServiceProjection{commands, names})
}

// The in-image path of a service executable: `sh` is `/bin/sh`, an absolute
// path must stay under `/usr/local/bin`, and a bare name resolves there.
fn cli_image_service_executable(service: String, executable: String) -> String CLIError! {
    if executable == "sh" || executable == "/bin/sh" -> return Ok("/bin/sh")
    if executable.starts_with("/") {
        loop part in executable.split("/") {
            if part == ".." -> return Err(CLIError.InvalidData("service {service} has an unsafe executable path"))
        }
        if executable != "/usr/local/bin" && !executable.starts_with("/usr/local/bin/") -> return Err(CLIError.InvalidData("service {service} has an unsafe executable path"))
        return Ok(executable)
    }
    if executable == "" || executable.contains("/") || executable.contains("\\") -> return Err(CLIError.InvalidData("service {service} has an unsafe executable name"))
    Ok("/usr/local/bin/{executable}")
}

fn cli_collect_image_service(name: String, plans: [DevServicePlan], selected: &[DevServicePlan], names: &[String], visiting: &[String]) CLIError! {
    if names.contains(name) -> return
    if visiting.contains(name) -> return Err(CLIError.InvalidData("service dependency cycle includes `{name}`"))
    &visiting.push(name)
    found := DevServicePlan?{None}
    loop candidate in plans {
        if candidate.name == name && found == None -> found = Val(candidate)
    }
    service :: found ?? return Err(CLIError.InvalidData("service {name} is not declared by the environment"))
    if !service.enable -> return Err(CLIError.InvalidData("service {name} is disabled"))
    loop dependency in services_dependency_names(service) -> cli_collect_image_service(dependency, plans, &selected, &names, &visiting)
    // Depth-first: every dependency finished, so `name` is the newest visit.
    _ := &visiting.pop()
    &selected.push(service)
    &names.push(name)
}

// The `/jet/supervise` script: start every service, stop them all when one
// exits, and poll with the projected `sleep`.
fn cli_supervisor_script(commands: [[String]]) -> String Never! {
    lines := [String]{
        "#!/bin/sh",
        "set -eu",
        "pids=\"\"",
        "cleanup() {{",
        "  code=$?",
        "  for pid in $pids; do kill \"$pid\" 2>/dev/null || true; done",
        "  for pid in $pids; do wait \"$pid\" 2>/dev/null || true; done",
        "  exit \"$code\"",
        "}}",
        "trap cleanup EXIT INT TERM",
        "start() {{",
        "  \"$@\" &",
        "  pids=\"$pids $!\"",
        "}}"
    }
    loop command in commands {
        quoted := [String]{"start"}
        loop argument in command -> &quoted.push(cli_shell_quote(argument))
        &lines.push(quoted.join(" "))
    }
    &lines.push("while :; do")
    &lines.push("  for pid in $pids; do")
    &lines.push("    kill -0 \"$pid\" 2>/dev/null || exit 1")
    &lines.push("  done")
    &lines.push("  /usr/local/bin/sleep 1")
    &lines.push("done")
    "{lines.join("\n")}\n"
}

fn cli_shell_quote(value: String) -> String Never! {
    "'{value.replace("'", "'\"'\"'")}'"
}

// Environment image layers: each package's verified Hangar binaries plus
// the one shell they provide as `/bin/sh`. An empty result means a refusal
// was already rendered.
fn cli_environment_image_files(verification: &StoreVerification, theme: Theme, roots: HangarRoots, plan: EnvPlan, name: String, target: String, projection: &ProjectionReport) -[IO, FS, Env, Time, Time.Wait]> [LayerFile] Never! {
    package_refs := [String]{}
    loop reference in plan.package_refs {
        if !package_refs.contains(reference) -> &package_refs.push(reference)
    }
    &package_refs.sort()
    layer_files := [LayerFile]{}
    shell_source := [U8]?{None}
    loop reference in package_refs {
        entry :: store_find_by_reference(&verification, roots, reference) ?? {
            theme.error_coded("E1336", "environment package `{reference}` is not realized", "environment images consume the verified Hangar package output; they do not read a project build scratch file", "run `jetpack use {reference} --prep`, then `jet image {name}`")
            return [LayerFile]{}
        }
        if cli_verify_realized_hangar_package(&verification, roots, entry) == .Err(error) {
            theme.error_coded("E1336", "environment package `{reference}` failed Hangar verification", error.message(), "realize a verified executable package for `{reference}`, then run `jet image {name}`")
            return [LayerFile]{}
        }
        &projection.included.push("hangar:content:{entry.envelope.output_hash}")
        if entry.envelope.platform != "" -> &projection.included.push("hangar:platform:{entry.envelope.platform}")
        if !cli_hangar_platform_matches(target, entry.envelope.platform) {
            &projection.rejected.push("package:{reference}:platform")
            realized_platform :: if entry.envelope.platform == "" -> "no declared platform" else -> entry.envelope.platform
            theme.error_coded("E1336", "environment image `{name}` cannot project package `{reference}`", "the verified Hangar output platform is `{realized_platform}`, but the image platform is `{target}`", "realize the environment package for the image target, or choose a matching `target`")
            return [LayerFile]{}
        }
        &projection.included.push("hangar:provenance")
        &projection.changed.push("hangar:cache")
        &projection.changed.push("hangar:signing:{if entry.envelope.signature == "" -> "unsigned" else -> "signed"}")
        binaries :: cli_read_realized_package_binaries(entry) ?? {
            theme.error_coded("E1336", "environment package `{reference}` has no usable binary output", err.message(), "realize an executable package for `{reference}`, then run `jet image {name}`")
            return [LayerFile]{}
        }
        loop binary in binaries {
            if shell_source == None && (binary.name == "bash" || binary.name == "busybox" || binary.name == "dash" || binary.name == "sh") -> shell_source = Val(binary.data)
            layer_path :: "usr/local/bin/{binary.name}"
            existing := LayerFile?{None}
            loop file in layer_files {
                if file.path == layer_path -> existing = Val(file)
            }
            if existing == .Val(present) {
                if present.data != binary.data {
                    theme.error_coded("E1336", "environment image `{name}` has conflicting binary `{binary.name}`", "two realized package outputs would write different bytes to one image path", "remove the duplicate executable or select package outputs with one stable binary")
                    return [LayerFile]{}
                }
                next
            }
            &layer_files.push(LayerFile{path: layer_path, data: binary.data, mode: 493})
        }
    }
    shell :: shell_source ?? {
        theme.error_coded("E1336", "environment image `{name}` has no shell", "D-ENV-IMAGE1's beginner image is a runnable shell image and cannot copy a host shell or invent one", "add `bash`, `busybox`, `dash`, or `sh` to the environment packages and build it first")
        return [LayerFile]{}
    }
    &layer_files.push(LayerFile{path: "bin/sh", data: shell, mode: 493})
    layer_files
}

fn cli_hangar_platform_matches(target: String, realized: String) -> Bool Never! {
    if target == {
        "linux.x64" -> realized == "linux.x64" || realized == "x86_64-linux"
        "linux.arm64" -> realized == "linux.arm64" || realized == "aarch64-linux"
        else -> false
    }
}

// Why an extra image file cannot come from the environment: secret-bearing
// or Jet state, a dotenv input, or a managed environment file.
fn cli_environment_image_file_rejection(plan: EnvPlan, relative: String) -> String? Never! {
    normalized :: if cli_normalize_project_relative_image_path(relative) == {
        .Ok(path) -> path
        .Err(error) -> {
            return Val(error.message())
        }
    }
    loop component in normalized.split("/") {
        lowered :: component.to_lower()
        secret_word :: lowered.contains("secret") || lowered.contains("credential") || lowered.contains("token") || lowered.contains("password")
        if lowered == ".jet" || lowered == ".env" || lowered.starts_with(".env.") || secret_word -> return Val("the selected path is secret-bearing or Jet state")
    }
    loop dotenv in plan.lifecycle.dotenv {
        if cli_normalized_project_path_matches(dotenv.file, normalized) -> return Val("dotenv files are environment inputs and never image-layer inputs")
    }
    managed :: "managed environment files are environment inputs and never image-layer inputs"
    loop file in plan.files {
        if cli_managed_file_matches(file, normalized) -> return Val(managed)
    }
    loop integration in plan.integrations {
        loop file in integration.files {
            if cli_managed_file_matches(file, normalized) -> return Val(managed)
        }
    }
    None
}

fn cli_managed_file_matches(file: ManagedFile, normalized: String) -> Bool Never! {
    if cli_normalized_project_path_matches(file.destination, normalized) -> return true
    source :: file.source ?? return false
    cli_normalized_project_path_matches(source, normalized)
}

fn cli_normalized_project_path_matches(candidate: String, normalized: String) -> Bool Never! {
    if cli_normalize_project_relative_image_path(candidate) == {
        .Ok(path) -> path == normalized
        .Err(_) -> false
    }
}

fn cli_write_rejected_projection(out_dir: String, projection: ProjectionReport) CLIError! -[FS, Env, Rand]> {
    files.create_dir_all(out_dir) ?? return Err(CLIError.IO(err))
    if image_write_projection_report(out_dir, "", projection) == .Err(error) -> return Err(CLIError.Other(error.message()))
}

// The Hangar entry's output must be its verified content-addressed object,
// with a real bin projection inside it.
fn cli_verify_realized_hangar_package(verification: &StoreVerification, roots: HangarRoots, entry: StoreEntry) CLIError! -[FS, Env, Time]> {
    store_verify_hangar_object(&verification, roots, entry) ?? return Err(CLIError.Other("{err}"))
    if entry.envelope.output_hash == "" -> return Err(CLIError.Other("the Hangar entry has no canonical output digest"))
    expected :: files.canonicalize(files.join(files.join(roots.hangar_dir(), "objects"), entry.envelope.output_hash)) ?? return Err(CLIError.Other("the Hangar object cannot be opened: {err}"))
    output_info :: files.stat(entry.out) ?? return Err(CLIError.Other("the Hangar output cannot be opened: {err}"))
    if output_info.is_symlink -> return Err(CLIError.Other("the Hangar output is a symlink"))
    output :: files.canonicalize(entry.out) ?? return Err(CLIError.Other("the Hangar output cannot be resolved: {err}"))
    if output != expected -> return Err(CLIError.Other("the Hangar entry output is not its verified content-addressed object"))
    bin_info :: files.stat(entry.bin) ?? return Err(CLIError.Other("the Hangar bin projection cannot be opened: {err}"))
    if bin_info.is_symlink -> return Err(CLIError.Other("the Hangar bin projection is a symlink"))
    bin :: files.canonicalize(entry.bin) ?? return Err(CLIError.Other("the Hangar bin projection cannot be resolved: {err}"))
    if bin != output && !bin.starts_with("{output}/") -> return Err(CLIError.Other("the Hangar bin projection escapes its verified output"))
}

// One realized executable: its name and bytes.
pub struct RealizedBinary {
    pub name: String
    pub data: [U8]
}

// The regular files of the entry's real bin directory, by name.
fn cli_read_realized_package_binaries(entry: StoreEntry) -[FS, Env]> [RealizedBinary] CLIError! {
    if entry.bin == "" -> return Err(CLIError.Other("the Hangar entry has no executable bin directory"))
    info :: files.stat(entry.bin) ?? return Err(CLIError.Other("{err}"))
    if info.is_symlink || !info.is_dir -> return Err(CLIError.Other("the Hangar bin projection is not a real directory"))
    root :: files.canonicalize(entry.bin) ?? return Err(CLIError.Other("{err}"))
    names := [String]{}
    listed :: files.list_dir(root) ?? return Err(CLIError.Other("{err}"))
    loop item in listed -> &names.push(item.name)
    &names.sort()
    binaries := [RealizedBinary]{}
    loop item_name in names {
        item_path :: files.join(root, item_name)
        metadata :: files.stat(item_path) ?? return Err(CLIError.Other("{err}"))
        if metadata.is_symlink || !metadata.is_file -> return Err(CLIError.Other("the Hangar bin projection contains a non-regular entry"))
        resolved :: files.canonicalize(item_path) ?? return Err(CLIError.Other("{err}"))
        if !resolved.starts_with("{root}/") -> return Err(CLIError.Other("the Hangar bin projection escapes its package output"))
        if metadata.size > 536870912 -> return Err(CLIError.Other("a realized package binary exceeds the 512 MiB layer limit"))
        if item_name == "" || pkg_text_has_control(item_name) -> return Err(CLIError.Other("a realized package binary has an unsafe name"))
        data :: files.read_bytes(resolved) ?? return Err(CLIError.Other("{err}"))
        &binaries.push(RealizedBinary{name: item_name, data: data})
    }
    if binaries.len() == 0 -> return Err(CLIError.Other("the Hangar bin projection is empty"))
    Ok(binaries)
}
