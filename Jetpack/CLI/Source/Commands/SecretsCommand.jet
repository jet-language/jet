// `jetpack secrets keygen|set|get|unset|list|import|recipients` (U13,
// D-JPK-SECRET1/D-JPK-SECRETCRYPTO1, SecretSpec 0.18 parity), ported from
// jetpack::CLI::services_secrets_config.

enum SecretsVerb {
    Keygen
    Recipients
    Set
    Get
    Unset
    List
    Import

    fn parse(word: String) -> SecretsVerb? Never! {
        if word == {
            @SECRETS_VERB_KEYGEN -> Val(SecretsVerb.Keygen)
            @SECRETS_VERB_RECIPIENTS -> Val(SecretsVerb.Recipients)
            @SECRETS_VERB_SET -> Val(SecretsVerb.Set)
            @SECRETS_VERB_GET -> Val(SecretsVerb.Get)
            @SECRETS_VERB_UNSET -> Val(SecretsVerb.Unset)
            @SECRETS_VERB_LIST -> Val(SecretsVerb.List)
            @SECRETS_VERB_IMPORT -> Val(SecretsVerb.Import)
            else -> None
        }
    }
}

pub fn cli_cmd_secrets(theme: Theme, parsed: CliParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    word :: parsed.positional.get(0) ?? {
        theme.error("`jetpack secrets` needs a verb", "known verbs: {@SECRETS_VERBS.join(", ")}.", "try `jetpack secrets keygen`.")
        return @EXIT_USAGE
    }
    verb :: SecretsVerb.parse(word) ?? {
        theme.error("`{word}` is not a `jetpack secrets` verb", "known verbs: {@SECRETS_VERBS.join(", ")}.", "try `jetpack secrets keygen`.")
        return @EXIT_USAGE
    }
    project_dir :: cli_current_dir()
    if verb == {
        .Keygen -> cli_secrets_keygen(theme, parsed)
        .Recipients -> cli_secrets_recipients(theme, parsed, project_dir)
        .Set -> cli_secrets_set(theme, parsed, project_dir)
        .Get -> cli_secrets_get(theme, parsed, project_dir)
        .Unset -> cli_secrets_unset(theme, parsed, project_dir)
        .List -> cli_secrets_list(theme, project_dir)
        .Import -> cli_secrets_import(theme, parsed, project_dir)
    }
}

fn cli_secrets_keygen(theme: Theme, parsed: CliParsed) -[IO, FS, Env, Rand]> Int Never! {
    force :: parsed.positional.contains(@SECRETS_FLAG_FORCE)
    generated :: trust_secrets_keygen(force) ?? {
        theme.error("couldn't generate a secrets identity", err.message(), "")
        return @EXIT_USAGE
    }
    theme.ok("wrote identity to `{generated.path}`")
    theme.detail("recipient: {generated.recipient}")
    theme.detail("add it with `jetpack secrets recipients add <recipient>`")
    @EXIT_OK
}

fn cli_secrets_recipients(theme: Theme, parsed: CliParsed, project_dir: String) -[IO, FS, Env, Time, Time.Wait]> Int Never! {
    sub :: parsed.positional.get(1) ?? {
        theme.error("`jetpack secrets recipients` needs a verb", "known verbs: {@SECRETS_RECIPIENTS_VERBS.join(", ")}.", "try `jetpack secrets recipients list`.")
        return @EXIT_USAGE
    }
    if sub == {
        @SECRETS_RECIPIENTS_VERB_ADD -> {
            recipient :: parsed.positional.get(2) ?? {
                theme.error("`jetpack secrets recipients add` needs a recipient", "an `age1...` public key.", "try `jetpack secrets recipients add age1...`.")
                return @EXIT_USAGE
            }
            added :: trust_secrets_add_recipient(project_dir, recipient) ?? {
                theme.error("couldn't add secrets recipient", err.message(), "")
                return @EXIT_USAGE
            }
            if added {
                theme.ok("added recipient `{recipient}`")
            } else {
                theme.detail("recipient `{recipient}` already present")
            }
            @EXIT_OK
        }
        @SECRETS_RECIPIENTS_VERB_LIST -> {
            recipients :: trust_secrets_list_recipients(project_dir) ?? {
                theme.error("couldn't list secrets recipients", err.message(), "")
                return @EXIT_USAGE
            }
            loop recipient in recipients -> print(recipient)
            @EXIT_OK
        }
        else -> {
            theme.error("`{sub}` is not a `jetpack secrets recipients` verb", "known verbs: {@SECRETS_RECIPIENTS_VERBS.join(", ")}.", "try `jetpack secrets recipients list`.")
            @EXIT_USAGE
        }
    }
}

fn cli_secrets_set(theme: Theme, parsed: CliParsed, project_dir: String) -[IO, FS, Env, Time, Time.Wait, Rand]> Int Never! {
    if parsed.positional.len() < 3 {
        theme.error("`jetpack secrets set` needs a name and a value", "", "try `jetpack secrets set db_password hunter2`.")
        return @EXIT_USAGE
    }
    name :: parsed.positional[1]
    trust_secrets_set(project_dir, name, parsed.positional[2]) ?? {
        theme.error("couldn't set `{name}`", err.message(), "")
        return @EXIT_USAGE
    }
    theme.ok("set `{name}`")
    @EXIT_OK
}

fn cli_secrets_missing(theme: Theme, name: String) -[IO]> Int Never! {
    theme.error_coded("E1263", "no secret named `{name}`", "the encrypted store doesn't have an entry with this name.", "set it first with `jetpack secrets set {name} <value>`, or check the spelling.")
    @EXIT_USAGE
}

fn cli_secrets_get(theme: Theme, parsed: CliParsed, project_dir: String) -[IO, FS, Env]> Int Never! {
    name :: parsed.positional.get(1) ?? {
        theme.error("`jetpack secrets get` needs a name", "", "try `jetpack secrets get db_password`.")
        return @EXIT_USAGE
    }
    stored :: trust_secrets_get(project_dir, name) ?? {
        theme.error("couldn't read `{name}`", err.message(), "")
        return @EXIT_USAGE
    }
    value :: stored ?? return cli_secrets_missing(theme, name)
    print(value)
    @EXIT_OK
}

fn cli_secrets_unset(theme: Theme, parsed: CliParsed, project_dir: String) -[IO, FS, Env, Time, Time.Wait, Rand]> Int Never! {
    name :: parsed.positional.get(1) ?? {
        theme.error("`jetpack secrets unset` needs a name", "", "try `jetpack secrets unset db_password`.")
        return @EXIT_USAGE
    }
    removed :: trust_secrets_unset(project_dir, name) ?? {
        theme.error("couldn't unset `{name}`", err.message(), "")
        return @EXIT_USAGE
    }
    if !removed -> return cli_secrets_missing(theme, name)
    theme.ok("unset `{name}`")
    @EXIT_OK
}

fn cli_secrets_list(theme: Theme, project_dir: String) -[IO, FS, Env]> Int Never! {
    names :: trust_secrets_list(project_dir) ?? {
        theme.error("couldn't list secrets", err.message(), "")
        return @EXIT_USAGE
    }
    loop name in names -> print(name)
    @EXIT_OK
}

fn cli_secrets_import(theme: Theme, parsed: CliParsed, project_dir: String) -[IO, FS, Env, Time, Time.Wait, Rand]> Int Never! {
    source :: parsed.positional.get(1) ?? @SECRETS_DEFAULT_IMPORT_FILE
    names :: trust_secrets_import_dotenv(project_dir, source) ?? {
        theme.error("couldn't import secrets from `{source}`", err.message(), "fix the .env file and retry; the source file was not changed.")
        return @EXIT_USAGE
    }
    theme.ok("imported {names.len()} secret name(s) from `{source}`")
    loop name in names -> theme.detail("imported `{name}`")
    theme.detail("left `{source}` untouched; remove it after verifying the vault import")
    @EXIT_OK
}
